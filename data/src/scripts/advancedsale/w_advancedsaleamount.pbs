// window w_advancedsaleamount (advancedsale)  ancestor: window

// w_advancedsaleamount.ue_close(integer ai_status) returns 0 [event]
	if this.id_dw.object.creditamt1[1] <> 0 and (long(this.id_dw.object.credit1acccode[1]) = 0 or isnull(this.id_dw.object.credit1acccode[1])) then
		messagebox("Account1 selection validation", "Please select some valid Account for Credit Card/Voucher")
		this.id_dw.setcolumn("credit1acccode")
		this.id_dw.setfocus()
		return
	end if
	if this.id_dw.object.creditamt2[1] <> 0 and (long(this.id_dw.object.credit2acccode[1]) = 0 or isnull(this.id_dw.object.credit2acccode[1])) then
		messagebox("Account2 selection validation", "Please select some valid Account for Credit Card/Voucher")
		this.id_dw.setcolumn("credit2acccode")
		this.id_dw.setfocus()
		return
	end if
	if this.id_dw.object.creditamt3[1] <> 0 and (long(this.id_dw.object.credit3acccode[1]) = 0 or isnull(this.id_dw.object.credit3acccode[1])) then
		messagebox("Account3 selection validation", "Please select some valid Account for Credit Card/Voucher")
		this.id_dw.setcolumn("credit3acccode")
		this.id_dw.setfocus()
		return
	end if
	if ai_status = -1 then
		this.istr_amountoninvoice.d_cashtendered = this.istr_oldamountoninvoice.d_cashtendered
		this.istr_amountoninvoice.d_cashamt = this.istr_oldamountoninvoice.d_cashamt
		this.istr_amountoninvoice.d_creditamt1 = this.istr_oldamountoninvoice.d_creditamt1
		this.istr_amountoninvoice.d_creditamt2 = this.istr_oldamountoninvoice.d_creditamt2
		this.istr_amountoninvoice.d_creditamt3 = this.istr_oldamountoninvoice.d_creditamt3
		this.istr_amountoninvoice.l_credit1acccode = this.istr_oldamountoninvoice.l_credit1acccode
		this.istr_amountoninvoice.l_credit2acccode = this.istr_oldamountoninvoice.l_credit2acccode
		this.istr_amountoninvoice.l_credit3acccode = this.istr_oldamountoninvoice.l_credit3acccode
		this.istr_amountoninvoice.d_balance = this.istr_oldamountoninvoice.d_balance
		this.istr_amountoninvoice.i_status = this.istr_oldamountoninvoice.i_status
	end if
	closewithreturn(this, this.istr_amountoninvoice)

// w_advancedsaleamount.wf_paymentmodesetting(char ac_pm) returns 0
	if ac_pm = "C" then
		this.idc_account.retrieve(wf_getglobalcode("GT_CashSub"))
		return
	end if
	this.idc_account.retrieve(wf_getglobalcode("GT_BankSub"))

// w_advancedsaleamount.wf_getglobalcode(string as_str) returns integer
	integer ll_code
	SQL SELECT Code INTO :ll_code FROM Global WHERE Name =:as_str USING sqlca;
	if sqlca.sqlcode <> 0 then
		ll_code = 0
	end if
	return ll_code

// w_advancedsaleamount.wf_setbalance(string as_col, double ad_amt) returns 0
	if as_col = "cashtendered" then
		if ad_amt > this.id_dw.getitemdecimal(1, "netamt") then
			this.id_dw.setitem(1, "cashamt", this.id_dw.getitemdecimal(1, "netamt"))
		else
			this.id_dw.setitem(1, "cashamt", ad_amt)
		end if
		this.id_dw.setitem(1, "balance", this.id_dw.getitemdecimal(1, "netamt") - this.id_dw.getitemdecimal(1, "cashamt") - this.id_dw.getitemdecimal(1, "creditamt1") - this.id_dw.getitemdecimal(1, "creditamt2") - this.id_dw.getitemdecimal(1, "creditamt3"))
		return
	end if
	if as_col = "cashamt" then
		this.id_dw.setitem(1, "balance", this.id_dw.getitemdecimal(1, "netamt") - ad_amt - this.id_dw.getitemdecimal(1, "creditamt1") - this.id_dw.getitemdecimal(1, "creditamt2") - this.id_dw.getitemdecimal(1, "creditamt3"))
		return
	end if
	if as_col = "creditamt1" then
		this.id_dw.setitem(1, "balance", this.id_dw.getitemdecimal(1, "netamt") - ad_amt - this.id_dw.getitemdecimal(1, "cashamt") - this.id_dw.getitemdecimal(1, "creditamt2") - this.id_dw.getitemdecimal(1, "creditamt3"))
		return
	end if
	if as_col = "creditamt2" then
		this.id_dw.setitem(1, "balance", this.id_dw.getitemdecimal(1, "netamt") - ad_amt - this.id_dw.getitemdecimal(1, "cashamt") - this.id_dw.getitemdecimal(1, "creditamt1") - this.id_dw.getitemdecimal(1, "creditamt3"))
		return
	end if
	if as_col = "creditamt3" then
		this.id_dw.setitem(1, "balance", this.id_dw.getitemdecimal(1, "netamt") - ad_amt - this.id_dw.getitemdecimal(1, "cashamt") - this.id_dw.getitemdecimal(1, "creditamt1") - this.id_dw.getitemdecimal(1, "creditamt2"))
	end if

// w_advancedsaleamount.create() returns 0 [event]
	this.dw_amountoninvoice = create dw_amountoninvoice
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.control = {this.dw_amountoninvoice, this.cb_cancel, this.cb_ok}

// w_advancedsaleamount.destroy() returns 0 [event]
	destroy this.dw_amountoninvoice
	destroy this.cb_cancel
	destroy this.cb_ok

// w_advancedsaleamount.open() returns long [event]
	string ls_invcode
	long ll_rtcode
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	this.istr_amountoninvoice = message.powerobjectparm
	this.istr_oldamountoninvoice = this.istr_amountoninvoice
	this.id_dw = this.dw_amountoninvoice
	this.id_dw.settransobject(sqlca)
	this.id_dw.insertrow(0)
	this.id_dw.scrolltorow(0)
	if this.istr_amountoninvoice.d_netamt <> 0 then
		if this.istr_amountoninvoice.d_cashtendered >= this.istr_amountoninvoice.d_netamt then
			this.istr_amountoninvoice.d_cashamt = this.istr_amountoninvoice.d_cashtendered - this.istr_amountoninvoice.d_netamt
		else
			this.istr_amountoninvoice.d_cashamt = this.istr_amountoninvoice.d_cashtendered
		end if
	end if
	if isnull(this.istr_amountoninvoice.d_cashamt) then
		this.istr_amountoninvoice.d_cashamt = 0.00
	end if
	this.id_dw.setitem(1, "invcode", this.istr_amountoninvoice.l_invcode)
	this.id_dw.setitem(1, "netamt", this.istr_amountoninvoice.d_netamt)
	this.id_dw.setitem(1, "cashtendered", this.istr_amountoninvoice.d_cashtendered)
	this.id_dw.setitem(1, "cashamt", this.istr_amountoninvoice.d_cashamt)
	this.id_dw.setitem(1, "creditamt1", this.istr_amountoninvoice.d_creditamt1)
	this.id_dw.setitem(1, "creditamt2", this.istr_amountoninvoice.d_creditamt2)
	this.id_dw.setitem(1, "creditamt3", this.istr_amountoninvoice.d_creditamt3)
	this.id_dw.setitem(1, "credit1acccode", this.istr_amountoninvoice.l_credit1acccode)
	this.id_dw.setitem(1, "credit2acccode", this.istr_amountoninvoice.l_credit2acccode)
	this.id_dw.setitem(1, "credit3acccode", this.istr_amountoninvoice.l_credit3acccode)
	this.id_dw.setitem(1, "balance", this.istr_amountoninvoice.d_balance)
	wf_paymentmodesetting(this.istr_amountoninvoice.c_paymentmode)
	this.id_dw.setcolumn("cashtendered")
	this.id_dw.setfocus()
	this.id_dw.selecttext(1, len(this.id_dw.gettext()))
	wf_setbalance("cashtendered", this.istr_amountoninvoice.d_cashtendered)
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_amountoninvoice.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_amountoninvoice.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "cashtendered", "cashamt", "creditamt1", "creditamt2", "creditamt3"
		if double(data) < 0.0 or data = "" or isnull(data) then
			messagebox("Amount Validation!", "Please Enter Valid Amount")
		end if
	end choose
	return ::message.returnvalue

// dw_amountoninvoice.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_null
	integer li_errcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	choose case dwo.name
	case "cashtendered", "cashamt", "creditamt1", "creditamt2", "creditamt3"
		parent.wf_setbalance(dwo.name, double(data))
	case "credit1acccode"
		if this.object.creditamt1[row] <> 0 and (long(data) = 0 or isnull(data) or data = "") then
			messagebox("Account1 selection validation", "Please select some valid Account for Credit Card/Voucher")
			return 1
		end if
	case "credit2acccode"
		if this.object.creditamt2[row] <> 0 and (long(data) = 0 or isnull(data) or data = "") then
			messagebox("Account2 selection validation", "Please select some valid Account for Credit Card/Voucher")
			return 1
		end if
	case else
		if "credit3acccode" = dwo.name and this.object.creditamt3[row] <> 0 and (long(data) = 0 or isnull(data) or data = "") then
			messagebox("Account3 selection validation", "Please select some valid Account for Credit Card/Voucher")
			return 1
		end if
	end choose
	return li_errcode

// dw_amountoninvoice.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	return ::message.returnvalue

// cb_cancel.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.istr_amountoninvoice.i_status = -1
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	if parent.id_dw.accepttext() = 1 then
		if parent.id_dw.getitemnumber(1, "balance") <> 0.0 then
			messagebox("Invoice Balance", "In order to proceed futher, Sale Invoice Balance Must be Zero~r~nAny Non-Zero Balance is not Acceptable", stopsign!)
			return ::message.returnvalue
		end if
		parent.istr_amountoninvoice.d_cashtendered = parent.id_dw.getitemdecimal(1, "cashtendered")
		parent.istr_amountoninvoice.d_cashamt = parent.id_dw.getitemdecimal(1, "cashamt")
		parent.istr_amountoninvoice.d_creditamt1 = parent.id_dw.getitemdecimal(1, "creditamt1")
		parent.istr_amountoninvoice.d_creditamt2 = parent.id_dw.getitemdecimal(1, "creditamt2")
		parent.istr_amountoninvoice.d_creditamt3 = parent.id_dw.getitemdecimal(1, "creditamt3")
		parent.istr_amountoninvoice.l_credit1acccode = parent.id_dw.getitemnumber(1, "credit1acccode")
		parent.istr_amountoninvoice.l_credit2acccode = parent.id_dw.getitemnumber(1, "credit2acccode")
		parent.istr_amountoninvoice.l_credit3acccode = parent.id_dw.getitemnumber(1, "credit3acccode")
		parent.istr_amountoninvoice.d_balance = parent.id_dw.getitemnumber(1, "balance")
		parent.istr_amountoninvoice.i_status = 1
		parent.post event ue_close(1)
	end if
	return ::message.returnvalue
