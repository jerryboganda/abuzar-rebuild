				if sqlca.sqlcode <> 0 then
					li_errcode = -1
				end if
				if this.ii_type = 2 then
					sqlca.postsaleledger_wrt_patient(lstr_arginfo.l_code1, lstr_arginfo.l_code2, 1, ll_salesmancode, lstr_arginfo.l_code3, this.ic_impactinventory)
					if sqlca.sqlcode <> 0 then
						li_errcode = -1
					end if
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again")
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_saleinvcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return li_errcode

// w_advancedsale.wf_patient_retrieve() returns long
	long ll_prow
	long ll_pcode
	this.idc_patient.retrieve(this.ii_salemodule)
	ll_prow = this.idc_patient.insertrow(0)
	setnull(ll_pcode)
	this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
	this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
	this.idc_patient.setitem(ll_prow, "name", "<NONE>")
	this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
	this.idc_patient.setitem(ll_prow, "city", "<NONE>")
	this.idc_patient.scrolltorow(ll_prow)
	return 0

// w_advancedsale.wf_new_patientregistration() returns long
	string ls_regno
	long ll_patientcode
	long ll_found
	long ll_row
	dwobject dwo
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 581", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		open(w_patientregistration)
		ls_regno = message.stringparm
		if not (ls_regno = "" or isnull(ls_regno)) then
			wf_patient_retrieve()
			ll_found = 0
			ll_found = this.idc_patient.find("regno = '" + ls_regno + "'", 1, this.idc_patient.rowcount())
			if ll_found > 0 then
				this.id_master.setitem(1, "patientregno", this.idc_patient.getitemstring(ll_found, "regno"))
				ll_patientcode = this.idc_patient.getitemnumber(ll_found, "patientcode")
				this.id_master.setitem(1, "patientcode", ll_patientcode)
				dwo = this.id_master.object.patientcode
				this.id_master.post event itemchanged(1, dwo, string(ll_patientcode))
			end if
		end if
	end if
	return 0

// w_advancedsale.wf_populate_prescription() returns long
	datastore lds_prescdetail
	datastore lds_prescheader
	dwobject dwo
	s_arguements lstr_arg
	integer li_retcode
	integer li_errcode
	long ll_found
	long ll_innercounter
	long ll_prescode
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrow
	long ll_counter
	long ll_patientcode
	long ll_null
	long ll_masterrow
	double ld_qty
	double ld_satisfiedqty
	double ld_newqty
	double ld_looseqty
	double ld_holdqty
	double ld_holdbonusqty
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	if wf_iseditable() = false then
		return 0
	end if
	open(w_copyprescription)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 0 then
		ll_prescode = lstr_arg.l_code1
		lds_prescdetail = create datastore
		lds_prescheader = create datastore
		lds_prescheader.dataobject = "d_prescription_header"
		lds_prescheader.settransobject(this.it_transobject)
		ll_masterrow = lds_prescheader.retrieve(ll_prescode)
		if ll_masterrow < 0 then
			return -1
		end if
		lds_prescdetail.dataobject = "d_prescription_detail"
		lds_prescdetail.settransobject(this.it_transobject)
		ll_totalrows = lds_prescdetail.retrieve(ll_prescode)
		if ll_totalrows < 0 then
			return -1
		end if
		ll_totalrows = lds_prescdetail.rowcount()
		ll_patientcode = wf_get_patient(ll_prescode)
		dwo = this.id_master.object.patientcode
		this.id_master.setcolumn("patientcode")
		this.id_master.setitem(this.id_master.getrow(), "patientcode", ll_patientcode)
		this.id_master.setitem(this.id_master.getrow(), "prescode", ll_prescode)
		this.id_master.setitem(1, "patientregno", this.idc_patient.getitemstring(this.idc_patient.getrow(), "regno"))
		this.id_master.event itemchanged(1, dwo, string(ll_patientcode))
		if this.ii_saletype = 2 and long(this.id_master.object.patientcode.visible) = 0 then
			this.id_master.object.custcode.protect = 0
			this.id_master.object.aliasname.protect = 0
		end if
		this.id_master.object.remarks[this.id_master.rowcount()] = lds_prescheader.object.remarks[ll_masterrow]
		this.id_master.object.doctcode[this.id_master.rowcount()] = lds_prescheader.object.doctcode[ll_masterrow]
		this.id_master.object.custrefno[this.id_master.rowcount()] = lds_prescheader.object.refno[ll_masterrow]
		ll_rowcount = this.id_detail.rowcount()
		for ll_counter = 1 to ll_rowcount
			event ue_deleteitem()
		next
		for ll_counter = 1 to ll_totalrows
			ld_qty = lds_prescdetail.getitemnumber(ll_counter, "noofunits") * lds_prescdetail.getitemnumber(ll_counter, "dosefactor")
			ll_icode = lds_prescdetail.getitemnumber(ll_counter, "icode")
			sqlca.getsatisfiedqty_for_prescription(ll_prescode, ll_icode, ld_satisfiedqty)
			if sqlca.sqlcode = 0 then
				ld_newqty = ld_qty - ld_satisfiedqty
				if ld_newqty > 0.0 then
					ll_insertedrow = this.id_detail.insertrow(0)
					wf_inititeminfo(ll_icode, ll_insertedrow, li_errcode, ls_errortext)
					this.id_detail.setitem(ll_insertedrow, "looseqty", ld_newqty)
					lb_enablesave = true
				end if
			else
				messagebox("Fetch Error", "Unable to fetch already issued qty against this prescription for item Code = " + string(ll_icode))
			end if
		next
		if lb_enablesave then
			this.im_menu.m_file.m_save.enabled = true
			this.im_menu.m_file.m_print.enabled = true
			wf_grandtotal()
		else
			setnull(ll_null)
			this.id_master.setitem(this.id_master.getrow(), "prescode", ll_null)
			messagebox("Items Validation", "No items left to populate for this prescription.")
		end if
		destroy lds_prescdetail
	end if
	return 0

// w_advancedsale.wf_search_customer() returns 0
	long ll_code
	long ll_oldcode
	s_popup_selection lstr_selection
	if wf_iseditable() = false then
		return
	end if
	if this.ii_saletype = 3 then
		return
	end if
	ll_oldcode = this.id_master.getitemnumber(1, "custcode")
	this.id_master.setcolumn("custcode")
	this.id_master.setfocus()
	openwithparm(w_popup_partialsearch_selection, "d_customer_list")
	lstr_selection = message.powerobjectparm
	if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
		this.id_master.setitem(1, "custcode", lstr_selection.l_code2)
		if wf_setcustomerinfo(1, 1, string(lstr_selection.l_code2)) <> 0 then
			this.id_master.setitem(1, "custcode", ll_oldcode)
		end if
	end if

// w_advancedsale.wf_set_godown_item_stock(long ai_gcode, long al_icode, long al_detailrow, ref string as_errortext) returns long
	double ld_godownstock
	boolean retflag = true
	this.it_transobject.getitemstocktotal(ai_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.id_detail.setitem(al_detailrow, "stock", ld_godownstock)
	this.id_footer.setitem(this.id_footer.getrow(), "stock", ld_godownstock)
	if retflag then
		return 0
	end if
	return -1

// w_advancedsale.wf_setcomments() returns integer
	s_quotationremarks ls_quotationremarks
	ls_quotationremarks.remarks2 = this.id_master.getitemstring(1, "salecomments1")
	ls_quotationremarks.remarks3 = this.id_master.getitemstring(1, "salecomments2")
	openwithparm(w_salecomments, ls_quotationremarks)
	ls_quotationremarks = message.powerobjectparm
	this.id_master.setitem(1, "salecomments1", ls_quotationremarks.remarks2)
	this.id_master.setitem(1, "salecomments2", ls_quotationremarks.remarks3)
	return 1

// w_advancedsale.wf_copyinvoice() returns integer
	datastore lds_saletemplatedetail
	s_saletemplate lstr_template
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	boolean lb_bonus
	boolean lb_salepricefromtemplate
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrows
	integer li_retcode = 1
	integer li_errcode
	integer li_counter
	integer ll_found
	integer ll_innercounter
	integer li_holdqty
	integer li_addbonusinqty
	double ld_looseqty
	double ld_holdbonusqty
	datawindowchild ldc_godown
	if wf_iseditable() = false then
		return 0
	end if
	lds_saletemplatedetail = create datastore
	open(w_copysaleinvoicefrom)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		destroy lds_saletemplatedetail
		return -1
	end if
	if f_stringpreferences("BonusInSale") = "Y" then
		lb_bonus = true
	end if
	if lstr_template.c_copyinvfrom = "T" then
		if messagebox("Sale Price Confirmation", "Do you want to apply SalePrice from saletemplate?", stopsign!, yesno!, 2) = 1 then
			lb_salepricefromtemplate = true
		end if
		lds_saletemplatedetail.dataobject = "d_saletemplate_detail"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "qty"))
			if lb_salepricefromtemplate = true then
				this.id_detail.setitem(ll_rowcount, "saleprice", lds_saletemplatedetail.getitemnumber(ll_rowcount, "saleprice"))
			end if
		next
	elseif lstr_template.c_copyinvfrom = "A" then
		lds_saletemplatedetail.dataobject = "d_IssueReqdetail_temp"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "qty"))
		next
	elseif lstr_template.c_copyinvfrom = "I" then
		lds_saletemplatedetail.dataobject = this.id_detail.dataobject
		lds_saletemplatedetail.settransobject(this.it_transobject)
		li_retcode = lds_saletemplatedetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "looseqty"))
			if lb_bonus then
				this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "bonusqty"))
			end if
		next
	elseif lstr_template.c_copyinvfrom = "P" then
		li_addbonusinqty = messagebox("Bonus In Sale Qty", "Do you want to add Bonus In Sale Qty?", question!, yesno!, 2)
		if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
			lds_saletemplatedetail.dataobject = "d_normalpurchasedetail"
		else
			lds_saletemplatedetail.dataobject = "d_loosepurchasedetail"
		end if
		lds_saletemplatedetail.settransobject(this.it_transobject)
		li_retcode = lds_saletemplatedetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_detailrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for li_counter = 1 to ll_detailrows
			li_holdqty = 0
			ld_holdbonusqty = 0
			ll_icode = lds_saletemplatedetail.object.icode[li_counter]
			ll_found = lds_saletemplatedetail.find("icode=" + string(ll_icode), 1, li_counter - 1)
			if ll_found > 0 then
				if ll_detailrows = 1 then
					lb_isitemexists = false
				elseif li_counter = 1 then
					lb_isitemexists = false
				else
					lb_isitemexists = true
				end if
			else
				lb_isitemexists = false
			end if
			if lb_isitemexists = false then
				if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
					li_holdqty = lds_saletemplatedetail.object.packqty[li_counter]
					ld_holdbonusqty = lds_saletemplatedetail.object.bonusqty[li_counter]
				else
					li_holdqty = lds_saletemplatedetail.object.looseqty[li_counter]
					ld_holdbonusqty = lds_saletemplatedetail.object.bonusqty[li_counter]
				end if
				if li_counter <> ll_detailrows then
					ll_found = lds_saletemplatedetail.find("icode=" + string(ll_icode), li_counter + 1, ll_detailrows)
					ll_innercounter = ll_found
					do while ll_found > 0 and ll_innercounter <= ll_detailrows
						if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
							li_holdqty = li_holdqty + lds_saletemplatedetail.object.packqty[ll_found]
							ld_holdbonusqty = ld_holdbonusqty + lds_saletemplatedetail.object.bonusqty[ll_found]
						else
							li_holdqty = li_holdqty + lds_saletemplatedetail.object.looseqty[ll_found]
							ld_holdbonusqty = ld_holdbonusqty + lds_saletemplatedetail.object.bonusqty[ll_found]
						end if
						ll_innercounter = ll_found + 1
						ll_found = lds_saletemplatedetail.find("icode=" + string(ll_icode), ll_innercounter, ll_detailrows)
					loop
				end if
				ll_insertedrows = this.id_detail.insertrow(0)
				wf_inititeminfo(lds_saletemplatedetail.getitemnumber(li_counter, "icode"), ll_insertedrows, li_errcode, ls_errortext)
				if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
					li_holdqty = li_holdqty * lds_saletemplatedetail.getitemnumber(li_counter, "packunits")
					ld_holdbonusqty = ld_holdbonusqty * lds_saletemplatedetail.getitemnumber(li_counter, "packunits")
				end if
				this.id_detail.setitem(ll_insertedrows, "looseqty", li_holdqty)
				if li_addbonusinqty = 1 then
					this.id_detail.setitem(ll_insertedrows, "looseqty", li_holdqty + ld_holdbonusqty)
				elseif lb_bonus then
					this.id_detail.setitem(ll_insertedrows, "bonusqty", ld_holdbonusqty)
				end if
			end if
		next
	elseif lstr_template.c_copyinvfrom = "R" then
		lds_saletemplatedetail.dataobject = "d_OpenWholeSaleReturnDetail"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		li_retcode = lds_saletemplatedetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "looseqty"))
			if lb_bonus then
				this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "bonusqty"))
			end if
		next
	elseif lstr_template.c_copyinvfrom = "N" then
		lds_saletemplatedetail.dataobject = "d_transfer_detail"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "gcode", lds_saletemplatedetail.getitemnumber(ll_rowcount, "dgcode"))
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "qty"))
			this.id_detail.setitem(ll_rowcount, "bonusqty", 0)
		next
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	destroy lds_saletemplatedetail
	return li_retcode

// w_advancedsale.wf_setimgonprint(integer ai_writeorclear) returns integer
	integer li_retcode = 1
	blob lblob_sigonsaleinv
	if f_stringpreferences("sigonsaleinv") = "Y" then
		if ai_writeorclear = 1 then
			SQL rollback USING sqlca;
			SQL SelectBlob sigonsaleinvimg INTO :lblob_sigonsaleinv From Preferences Where userid =1 USING sqlca;
			if sqlca.sqlcode = 0 then
				li_retcode = 1
			else
				li_retcode = -1
			end if
			SQL rollback USING sqlca;
			f_writeimgtofile("c:\winim.jpg", lblob_sigonsaleinv)
			this.id_print.modify("p_sig.FileName='c:\winim.jpg'")
		elseif ai_writeorclear = 0 then
			lblob_sigonsaleinv = blob("0xoeqpxakvabl")
			f_writeimgtofile("c:\winim.jpg", lblob_sigonsaleinv)
		end if
	end if
	return li_retcode

// w_advancedsale.wf_dueitem() returns 0
	s_dueinfo ls_due
	long ll_row
	long li_null
	long ll_code
	long ll_counter
	long ll_icode
	long ll_gcode
	long ll_rowgroup
	string ls_null
	boolean lb_duefound
	double ld_qty
	double ld_dueqty
	double ld_godownstock
	double ld_givenqty
	double ld_stock
	this.id_detail.accepttext()
	if this.id_detail = getfocus() and this.id_detail.getcolumnname() = "looseqty" or this.id_detail.getcolumnname() = "gcode" then
		ll_row = this.id_detail.getrow()
		ll_code = this.id_master.getitemnumber(this.id_master.getrow(), "code")
		if not isnull(ll_code) then
			this.ids_invoiceinfo.retrieve(ll_code)
			ll_icode = this.id_detail.getitemnumber(ll_row, "icode")
			ll_gcode = this.id_detail.getitemnumber(ll_row, "gcode")
			ld_givenqty = this.id_detail.getitemnumber(ll_row, "looseqty")
			ll_rowgroup = this.id_detail.getitemnumber(ll_row, "rowgroup")
			this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Stock Validation", "Database Error: Item information can not be retrieved")
			end if
			for ll_counter = 1 to this.ids_invoiceinfo.rowcount()
				if ll_icode = this.ids_invoiceinfo.getitemnumber(ll_counter, "icode") and this.ids_invoiceinfo.getitemnumber(ll_counter, "rowgroup") = ll_rowgroup then
					if isnull(this.ids_invoiceinfo.getitemstring(ll_counter, "due")) then
						ld_qty = ld_qty + this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty")
					else
						ld_dueqty = ld_dueqty + this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty")
						lb_duefound = true
					end if
				end if
			next
			if lb_duefound = true then
				ls_due.qty = ld_qty
				ls_due.dueqty = ld_dueqty
				ls_due.stock = ld_godownstock + ld_qty
			else
				ld_stock = ld_godownstock + ld_qty
				ls_due.stock = ld_stock
				if ld_givenqty <= ld_stock then
					ls_due.qty = ld_givenqty
					ls_due.dueqty = ld_stock - ld_givenqty
				else
					ls_due.qty = ld_stock
					ls_due.dueqty = ld_givenqty - ld_stock
				end if
			end if
		else
			ld_givenqty = this.id_detail.getitemnumber(ll_row, "looseqty")
			ld_stock = this.id_detail.getitemnumber(ll_row, "stock")
			if ld_givenqty <= ld_stock then
				ls_due.qty = ld_givenqty
				ls_due.dueqty = ld_stock - ld_givenqty
			else
				ls_due.qty = ld_stock
				ls_due.dueqty = ld_givenqty - ld_stock
			end if
			ls_due.stock = ld_stock
		end if
		ls_due.itemname = this.id_detail.getitemstring(ll_row, "itemname")
		openwithparm(w_dueinfo, ls_due)
		ls_due = message.powerobjectparm
		ld_qty = ls_due.qty
		ld_dueqty = ls_due.dueqty
		setnull(ls_null)
		setnull(li_null)
		if ls_due.properclose then
			if ld_qty >= 0.0 then
				this.id_detail.setitem(ll_row, "looseqty", ld_qty)
				this.id_detail.setitem(ll_row, "dueqty", ld_dueqty)
			end if
			if ld_dueqty > 0.0 then
				this.id_detail.setitem(ll_row, "due", "D")
			else
				this.id_detail.setitem(ll_row, "due", ls_null)
			end if
		end if
		return
	end if
	ll_row = this.id_detail.getrow()

// w_advancedsale.wf_edit_saleorder() returns integer
	datastore lds_saleorderdetail
	datastore lds_saleorderheader
	s_saletemplate lstr_template
	boolean lb_enablesave
	boolean lb_insertrow
	integer li_retcode
	integer li_errcode
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_counter
	long ll_tmprowid
	long ll_tmpcode
	long ll_icode
	double ld_tmpqty
	double ld_tmpbonus
	string ls_errortext
	if wf_iseditable() = false then
		return 0
	end if
	lds_saleorderdetail = create datastore
	lds_saleorderheader = create datastore
	open(w_editsaleorder_finalized_form)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_saleorderdetail.dataobject = "d_SaleOrderdetail_retrieve"
		lds_saleorderdetail.settransobject(this.it_transobject)
		lds_saleorderheader.dataobject = "d_SaleOrderheader"
		lds_saleorderheader.settransobject(this.it_transobject)
		ll_row = lds_saleorderheader.retrieve(lstr_template.l_invtemplate)
		if ll_row <= 0 then
			li_retcode = -1
		else
			ll_mrow = this.id_master.getrow()
			this.id_master.setitem(ll_mrow, "SaleOrdercode", lstr_template.l_invtemplate)
			if this.ii_saletype = 2 then
				this.id_master.setitem(ll_mrow, "custcode", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "custcode"))
			end if
			this.id_master.setitem(ll_mrow, "sprice", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "sprice"))
			this.id_master.setitem(ll_mrow, "remarks", lds_saleorderheader.getitemstring(lds_saleorderheader.getrow(), "remarks"))
			this.id_master.setitem(ll_mrow, "headerno", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "headerno"))
			this.id_footer.setitem(ll_mrow, "misccharges", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "misccharges"))
			this.id_footer.setitem(ll_mrow, "flatdisc", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "flatdisc"))
			this.id_footer.setitem(ll_mrow, "invdiscperc", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "discperc"))
			this.id_master.setitem(ll_mrow, "smancode", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "smancode"))
			lds_saleorderdetail.retrieve(lstr_template.l_invtemplate, lstr_template.i_invtype)
		end if
		ll_totalrows = lds_saleorderdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		if lb_enablesave then
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
			this.id_detail.reset()
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				lb_insertrow = false
				ld_tmpqty = 0
				ld_tmpbonus = 0
				if lstr_template.i_invtype = 0 then
					lb_insertrow = true
				else
					if this.ib_modify and this.id_master.getitemnumber(1, "code") > 0.0 then
						ll_tmprowid = lds_saleorderdetail.getitemnumber(ll_counter, "rowid")
						ll_tmpcode = this.id_master.getitemnumber(1, "code")
						SQL SELECT sum ( looseqty ) , sum ( bonusqty ) INTO :ld_tmpqty, :ld_tmpbonus FROM SaleDetail WHERE SaleOrderRowID =:ll_tmprowid AND SaleInvCode =:ll_tmpcode USING sqlca;
						if sqlca.sqlcode <> 0 then
							lb_insertrow = false
						end if
					end if
					if isnull(ld_tmpqty) then
						ld_tmpqty = 0
					end if
					if isnull(ld_tmpbonus) then
						ld_tmpbonus = 0
					end if
					if lds_saleorderdetail.getitemnumber(ll_counter, "looseqty") - lds_saleorderdetail.getitemnumber(ll_counter, "saleqty") + ld_tmpqty > 0.0 or lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty") - lds_saleorderdetail.getitemnumber(ll_counter, "salebonus") + ld_tmpbonus > 0.0 then
						lb_insertrow = true
					end if
				end if
				if lb_insertrow = true then
					ll_rowcount = this.id_detail.insertrow(0)
					ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_saleorderdetail.getitemnumber(ll_counter, "gcode")), 1, this.idc_godown.rowcount())
					ll_icode = lds_saleorderdetail.getitemnumber(ll_counter, "icode")
					if wf_inititeminfo(ll_icode, ll_rowcount, li_errcode, ls_errortext) then
						ll_gcode = lds_saleorderdetail.getitemnumber(ll_counter, "gcode")
						this.id_detail.setitem(ll_rowcount, "gcode", ll_gcode)
						if wf_set_godown_item_stock(ll_gcode, ll_icode, ll_rowcount, ls_errortext) = 0 then
							this.id_detail.setitem(ll_rowcount, "SaleOrderrowid", lds_saleorderdetail.getitemnumber(ll_counter, "rowid"))
							this.id_detail.setitem(ll_rowcount, "packunits", lds_saleorderdetail.getitemnumber(ll_counter, "packunits"))
							this.id_detail.setitem(ll_rowcount, "discperc", lds_saleorderdetail.getitemnumber(ll_counter, "discperc"))
							this.id_detail.setitem(ll_rowcount, "itemflatdisc", lds_saleorderdetail.getitemnumber(ll_counter, "itemflatdisc"))
							this.id_detail.setitem(ll_rowcount, "saleprice", lds_saleorderdetail.getitemnumber(ll_counter, "saleprice"))
							if lstr_template.i_invtype = 0 then
								this.id_detail.setitem(ll_rowcount, "looseqty", lds_saleorderdetail.getitemnumber(ll_counter, "looseqty"))
								this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty"))
							else
								ld_tmpqty = lds_saleorderdetail.getitemnumber(ll_counter, "looseqty") - lds_saleorderdetail.getitemnumber(ll_counter, "saleqty") + ld_tmpqty
								ld_tmpbonus = lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty") - lds_saleorderdetail.getitemnumber(ll_counter, "salebonus") + ld_tmpbonus
								if ld_tmpqty > 0.0 then
									this.id_detail.setitem(ll_rowcount, "looseqty", ld_tmpqty)
								end if
								if ld_tmpbonus > 0.0 then
									this.id_detail.setitem(ll_rowcount, "bonusqty", ld_tmpbonus)
								end if
							end if
						end if
					end if
				end if
			next
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return li_retcode

// w_advancedsale.wf_inititeminfo_quotation(long al_icode, long al_row, ref integer ai_rtcode, ref string as_errortext, long al_gcode) returns boolean
	boolean retflag = true
	integer li_gcode
	integer li_defaultgcode
	integer li_defaultgst
	integer li_custcode
	integer li_flatdiscstatus
	integer li_itemdiscpercno
	long ll_packunits
	long ll_saleinvcode
	long ll_reorderqty
	long ll_null
	long li_discstatus
	long ll_qtysale
	long ll_bonus
	long ll_itemdesc_status
	double ld_rpp
	double ld_purprice
	double ld_flatdisc
	double ld_invdiscperc
	double ld_discperc2
	double ld_discperc3
	double ld_discperc4
	double ld_saleprice
	double ld_discperc
	double ld_purdiscperc
	double ld_avgprice
	double ld_unitsalestax
	double ld_gstperc1
	double ld_gstperc2
	double ld_packsalestax
	double ld_saleprice2
	double ld_saleprice3
	double ld_saleprice4
	double ld_saleprice5
	double ld_discperc5
	double ld_godownstock
	double ld_saleqty
	double ld_totalstock
	double ld_holdlooseqty
	double ld_desiredbonus
	double ld_purunitrate
	double ld_rppunitrate
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_antinorcotix
	string ls_itemtotalval
	string ls_locksaleprice
	string ls_lockdiscperc
	string ls_remarks
	setnull(ls_null)
	setnull(ll_null)
	SQL SELECT item.customicode , item.name , item.saleprice , item.packunits , item.salediscperc , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.avgprice , item.PurDiscPerc , item.antinorcotix , item.reorderqty , item.purprice , item.recentpurprice , round ( item.Packsalestax / item.packunits , 2 ) , item.gstperc1 , item.gstperc2 , qtysale =item.saleqty , bonus =item.bonusqty , item.Packsalestax , item.flatdisc , item.locksaleprice , item.lockdiscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 , item.remarks , round ( item.purprice / item.packunits , 2 ) , round ( item.recentpurprice / item.packunits , 2 ) INTO :ls_fullcode, :ls_name, :ld_saleprice, :ll_packunits, :ld_discperc, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :ld_avgprice, :ld_purdiscperc, :ls_antinorcotix, :ll_reorderqty, :ld_purprice, :ld_rpp, :ld_unitsalestax, :ld_gstperc1, :ld_gstperc2, :ll_qtysale, :ll_bonus, :ld_packsalestax, :ld_flatdisc, :ls_locksaleprice, :ls_lockdiscperc, :ld_discperc2, :ld_discperc3, :ld_discperc4, :ld_discperc5, :ls_remarks, :ld_purunitrate, :ld_rppunitrate FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
	li_custcode = this.id_master.getitemnumber(1, "custcode")
	if isnull(li_custcode) then
		retflag = false
		as_errortext = "Validation Error: Select Customer "
	end if
	li_defaultgst = this.id_master.getitemnumber(1, "dd_gstperc")
	SQL SELECT InvDiscPerc INTO :ld_invdiscperc FROM customer WHERE customer.custcode =:li_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	li_gcode = al_gcode
	this.it_transobject.getitemstockall(al_icode, ld_totalstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.ib_modify and retflag then
		ll_saleinvcode = this.id_master.getitemnumber(1, "code")
		if wf_getsalesstockinfo(ll_saleinvcode, li_gcode, al_icode, ld_saleqty) <> 0 then
			retflag = false
			as_errortext = "Database Error: Item information can not be retrieved"
		end if
		ld_godownstock = ld_godownstock + ld_saleqty
	end if
	if retflag then
		this.id_detail.setitem(al_row, "gcode", li_gcode)
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		li_discstatus = long(this.id_detail.object.discperc.visible)
		ll_itemdesc_status = long(this.id_detail.object.saleitemdescription.visible)
		li_flatdiscstatus = long(this.id_detail.object.itemflatdisc.visible)
		if li_discstatus = 1 and this.id_detail.getitemstatus(al_row, "discperc", primary!) = notmodified! then
			li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
			if long(this.id_detail.object.discperc.visible) = 1 then
				choose case li_itemdiscpercno
				case 1
					this.id_detail.setitem(al_row, "discperc", ld_discperc)
				case 2
					this.id_detail.setitem(al_row, "discperc", ld_discperc2)
				case 3
					this.id_detail.setitem(al_row, "discperc", ld_discperc3)
				case 4
					this.id_detail.setitem(al_row, "discperc", ld_discperc4)
				case 5
					this.id_detail.setitem(al_row, "discperc", ld_discperc5)
				end choose
			else
				this.id_detail.setitem(al_row, "discperc", 0)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") and li_discstatus = 1 then
			li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
			choose case li_itemdiscpercno
			case 1
				this.id_detail.setitem(al_row, "discperc", ld_discperc)
			case 2
				this.id_detail.setitem(al_row, "discperc", ld_discperc2)
			case 3
				this.id_detail.setitem(al_row, "discperc", ld_discperc3)
			case 4
				this.id_detail.setitem(al_row, "discperc", ld_discperc4)
			case 5
				this.id_detail.setitem(al_row, "discperc", ld_discperc5)
			end choose
		end if
		if this.id_detail.getitemstatus(al_row, "saleprice", primary!) = notmodified! then
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
			case 2.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				this.id_detail.setitem(al_row, "packprice", ld_purprice)
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				this.id_detail.setitem(al_row, "packprice", ld_rpp)
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
			case else
				this.id_detail.setitem(al_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
			end choose
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
			case 2.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				this.id_detail.setitem(al_row, "packprice", ld_purprice)
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				this.id_detail.setitem(al_row, "packprice", ld_rpp)
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
			case else
				this.id_detail.setitem(al_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
			end choose
		end if
		this.id_detail.setitem(al_row, "icode", al_icode)
		this.id_detail.setitem(al_row, "packunits", ll_packunits)
		this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
		this.id_detail.setitem(al_row, "stock", ld_godownstock)
		this.id_detail.setitem(al_row, "totalstock", ld_totalstock)
		if li_flatdiscstatus = 1 then
			if this.id_detail.getitemstatus(al_row, "itemflatdisc", primary!) = notmodified! then
				this.id_detail.setitem(al_row, "itemflatdisc", ld_flatdisc)
			end if
		else
			this.id_detail.setitem(al_row, "itemflatdisc", 0)
		end if
		if f_stringpreferences("SaleCopyItemRemarks") = "Y" and this.id_detail.getitemstatus(al_row, "saleitemdescription", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "saleitemdescription", ls_remarks)
		end if
		this.id_detail.setitem(al_row, "recentpurprice", ld_rpp)
		this.id_detail.setitem(al_row, "purprice", ld_purprice)
		this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
		this.id_detail.setitem(al_row, "purunitrate", ld_purunitrate)
		this.id_detail.setitem(al_row, "rppunitrate", ld_rppunitrate)
		this.id_detail.setitem(al_row, "itemtotalval", ls_itemtotalval)
		if f_stringpreferences("bonusinsale") = "Y" then
			this.id_detail.setitem(al_row, "qtysale", ll_qtysale)
			this.id_detail.setitem(al_row, "bonus", ll_bonus)
		end if
		if this.id_detail.getitemstatus(al_row, "Unitsalestax", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
		end if
		if this.id_detail.getitemstatus(al_row, "gstperc", primary!) = notmodified! then
			if li_defaultgst = 2 then
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
			if li_defaultgst = 2 then
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
			end if
			if f_stringpreferences("SaleCopyItemRemarks") = "Y" then
				this.id_detail.setitem(al_row, "saleitemdescription", ls_remarks)
			end if
		end if
		this.id_detail.setitem(al_row, "locksaleprice", ls_locksaleprice)
		this.id_detail.setitem(al_row, "lockdiscperc", ls_lockdiscperc)
	else
		retflag = false
		as_errortext = "Item can not be sold, its Stock is Zero"
	end if
	if f_stringpreferences("salepromptforreorder") = "Y" and ll_reorderqty > round(ld_godownstock / ll_packunits, 0) then
		messagebox("Stock", "Stock for this item become~r~n less than ReorderQty")
	end if
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_totalstock)
	this.id_footer.setitem(1, "rpp", ld_rpp)
	this.id_footer.setitem(1, "purprice", ld_purprice)
	this.id_footer.setitem(1, "avgprice", ld_avgprice)
	this.id_footer.setitem(1, "itemtotalval", ls_itemtotalval)
	if this.id_footer.getitemstatus(1, "invdiscperc", primary!) = notmodified! and this.ib_modify = false then
		this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
	end if
	if f_stringpreferences("bonusinsale") = "Y" then
		this.id_footer.setitem(1, "bonusratio", trim(string(ll_qtysale)) + ":" + trim(string(ll_bonus)))
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			ld_holdlooseqty = this.id_detail.getitemnumber(al_row, "looseqty")
			if this.id_detail.getitemnumber(al_row, "qtysale") = 0.0 then
				ld_desiredbonus = 0
			else
				ld_desiredbonus = int(ld_holdlooseqty / double(this.id_detail.getitemnumber(al_row, "qtysale")) * double(this.id_detail.getitemnumber(al_row, "Bonus")))
			end if
			if ld_holdlooseqty + ld_desiredbonus <= ld_godownstock then
				this.id_detail.setitem(al_row, "bonusqty", ld_desiredbonus)
			elseif ld_holdlooseqty > ld_godownstock then
				messagebox("Quantity Validation", "Quantity " + string(ld_holdlooseqty) + " exceeds stock " + string(ld_godownstock) + ".")
				this.id_detail.setitem(al_row, "looseqty", 1)
				this.id_detail.setitem(al_row, "bonusqty", 0)
			else
				ld_desiredbonus = messagebox("Problem allocating bonus", "Sale Qty = " + string(ld_holdlooseqty) + " ~r" + "Required Bonus = " + trim(string(ld_desiredbonus)) + " ~r" + "Stock available = " + trim(string(ld_godownstock)) + " ~r" + "Allocate possible bonus?", question!, yesno!, 2)
				if ld_desiredbonus = 1.0 then
					this.id_detail.setitem(al_row, "bonusqty", ld_godownstock - ld_holdlooseqty)
				else
					retflag = false
					this.id_detail.setitem(al_row, "bonusqty", 0)
				end if
			end if
		end if
	end if
	this.id_footer.object.t_purdiscper.text = string(ld_purdiscperc)
	this.id_detail.setitem(al_row, "itemcode", al_icode)
	if ls_antinorcotix = "Y" and retflag = true and not (this.il_norcotixcode = al_icode) then
		messagebox("Item Validation", "This is Narcotics item ~r~n please type Doctor name in remarks")
		this.il_norcotixcode = al_icode
	end if
	return retflag

// w_advancedsale.wf_getitemsaleprice(long al_icode, ref double ad_saleprice) returns long
	long ll_retcode
	SQL SELECT saleprice =Round ( saleprice / CASE PackUnits WHEN 0 THEN 1 ELSE PackUnits END , 2 ) INTO :ad_saleprice FROM item WHERE ICode =:al_icode USING sqlca;
	if sqlca.sqlcode = 0 then
		ll_retcode = 0
	else
		ll_retcode = -1
	end if
	return ll_retcode

// w_advancedsale.wf_showsummaryaccountbalance() returns 0
	long ll_acccode
	if wf_iseditable() = false then
		return
	end if
	if this.tab_retrieve.selectedtab = 1 then
		ll_acccode = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		if not isnull(ll_acccode) and this.id_master.rowcount() > 0 then
			openwithparm(w_summaccount_balance, ll_acccode)
		end if
	end if

// w_advancedsale.wf_showaccountledger() returns 0
	long ll_acccode
	if wf_iseditable() = false then
		return
	end if
	if this.tab_retrieve.selectedtab = 1 then
		ll_acccode = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		if not isnull(ll_acccode) and this.id_master.rowcount() > 0 then
			openwithparm(w_account_ledger, ll_acccode)
		end if
	end if

// w_advancedsale.wf_populatesaledetail(long al_invid, ref datawindow ad_saledetail, ref string as_errortext, ref long al_errorrow) returns boolean
	long ll_detailrows
	long ll_gcode
	long ll_icode
	long ll_saleorderrowid
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode = 1
	long li_counter
	long li_innercounter
	long ll_insertedrows
	long ll_itemsdetailrowcount
	long ll_row
	long ll_descicode
	long ll_remainingdays
	long ll_expirydays
	long ll_rowgroup
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	double ld_stock
	double ld_newstock
	double ld_salelooseqty
	double ld_dueqty
	double ld_looseqty
	double ld_bonusqty
	double ld_totalstock
	double ld_packqtyforsale
	double ld_bonuspackqtyforsale
	double ld_rate
	double ld_itemflatdisc
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_packprice
	double ld_claimablediscperc
	double ld_gstperc
	double ld_unitsalestax
	double ld_purunitrate
	double ld_rppunitrate
	integer li_rtmesscode
	boolean lb_commitflag = true
	string ls_batch
	string ls_updatesaleprice
	string ls_updsaleprice
	string ls_saleitemdescription
	string ls_claimable
	datetime ld_expiry
	dwitemstatus ldws_column
	wf_isolatebonusqty(this.id_detail)
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	ll_itemsdetailrowcount = 0
	ls_updatesaleprice = f_stringpreferences("updatesaleprice")
	as_errortext = "    Some database problem ocuurs         "
	ll_rowgroup = 0
	do while li_counter <= ll_detailrows and lb_commitflag
		ll_rowgroup = ll_rowgroup + 1
		ll_gcode = this.id_detail.getitemnumber(li_counter, "gcode")
		ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
		ld_salelooseqty = this.id_detail.getitemnumber(li_counter, "looseqty")
		ld_dueqty = this.id_detail.getitemnumber(li_counter, "dueqty")
		ll_packunits = this.id_detail.getitemnumber(li_counter, "packunits")
		ld_saleprice = this.id_detail.getitemnumber(li_counter, "saleprice")
		ld_packprice = this.id_detail.getitemnumber(li_counter, "packprice")
		ld_purunitrate = this.id_detail.getitemnumber(li_counter, "purunitrate")
		ld_rppunitrate = this.id_detail.getitemnumber(li_counter, "rppunitrate")
		ld_packqtyforsale = this.id_detail.getitemnumber(li_counter, "packqtyforsale")
		ld_bonuspackqtyforsale = this.id_detail.getitemnumber(li_counter, "bonuspackqtyforsale")
		ld_claimablediscperc = this.id_detail.getitemdecimal(li_counter, "claimablediscperc")
		ld_discperc = this.id_detail.getitemnumber(li_counter, "discperc")
		ld_rate = this.id_detail.getitemnumber(li_counter, "rate")
		ld_itemflatdisc = this.id_detail.getitemnumber(li_counter, "itemflatdisc")
		ls_saleitemdescription = this.id_detail.getitemstring(li_counter, "saleitemdescription")
		ld_unitsalestax = this.id_detail.getitemnumber(li_counter, "unitsalestax")
		ld_bonusqty = this.id_detail.getitemnumber(li_counter, "bonusqty")
		ld_gstperc = this.id_detail.getitemnumber(li_counter, "gstperc")
		ls_claimable = this.id_detail.getitemstring(li_counter, "claimable")
		ll_descicode = this.id_detail.getitemnumber(li_counter, "DescICode")
		ldws_column = this.id_detail.getitemstatus(li_counter, "saleprice", primary!)
		ls_updsaleprice = this.id_detail.getitemstring(li_counter, "updatesaleprice")
		ld_salelooseqty = ld_salelooseqty - ld_dueqty
		this.it_transobject.getitemavgpriceforsale(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			if ld_salelooseqty + ld_bonusqty <> 0.0 and lb_commitflag and wf_selectitembatches(ll_gcode, ll_icode, ld_salelooseqty, ld_bonusqty, ad_saledetail, ll_insertedrows, as_errortext) = 0 then
				ll_row = ll_row + 1
				ad_saledetail.setitem(ll_row, "code", al_invid)
				ad_saledetail.setitem(ll_row, "rowgroup", ll_rowgroup)
				ad_saledetail.setitem(ll_row, "packunits", ll_packunits)
				ad_saledetail.setitem(ll_row, "saleprice", ld_saleprice)
				ad_saledetail.setitem(ll_row, "packprice", ld_packprice)
				ad_saledetail.setitem(ll_row, "purunitrate", ld_purunitrate)
				ad_saledetail.setitem(ll_row, "rppunitrate", ld_rppunitrate)
				ad_saledetail.setitem(ll_row, "discperc", ld_discperc)
				ad_saledetail.setitem(ll_row, "claimablediscperc", ld_claimablediscperc)
				ad_saledetail.setitem(ll_row, "rate", ld_rate)
				ad_saledetail.setitem(ll_row, "avgprice", ld_avgprice)
				ad_saledetail.setitem(ll_row, "itemflatdisc", ld_itemflatdisc)
				ad_saledetail.setitem(ll_row, "saleitemdescription", ls_saleitemdescription)
				ad_saledetail.setitem(ll_row, "packqtyforsale", ld_packqtyforsale)
				ad_saledetail.setitem(ll_row, "bonuspackqtyforsale", ld_bonuspackqtyforsale)
				ad_saledetail.setitem(ll_row, "unitsalestax", ld_unitsalestax)
				ad_saledetail.setitem(ll_row, "gstperc", ld_gstperc)
				ad_saledetail.setitem(ll_row, "claimable", ls_claimable)
				ad_saledetail.setitem(ll_row, "descicode", ll_descicode)
				ld_totalstock = ad_saledetail.getitemnumber(ll_row, "totalstock")
				ad_saledetail.setitem(ll_row, "balancestock", ld_totalstock - ld_salelooseqty - ld_bonusqty)
				ls_batch = ad_saledetail.getitemstring(ll_row, "batch")
				ld_expiry = ad_saledetail.getitemdatetime(ll_row, "expiry")
				ld_looseqty = ad_saledetail.getitemnumber(ll_row, "looseqty")
				ld_bonusqty = ad_saledetail.getitemnumber(ll_row, "bonusqty")
				ld_stock = ad_saledetail.getitemnumber(ll_row, "stock")
			end if
		else
			lb_commitflag = false
		end if
		li_counter = li_counter + 1
	loop
	if not lb_commitflag then
		al_errorrow = li_counter - 1
		messagebox("Database Error", as_errortext)
	end if
	SQL rollback USING sqlca;
	ul_rowcount = ad_saledetail.rowcount()
	sqlca.getmaxutn(ul_rowcount, ul_maxutn)
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
	else
		SQL rollback USING sqlca;
		messagebox("SAVING", " Error in generating Utn ")
		return false
	end if
	for li_counter = 1 to ad_saledetail.rowcount()
		ad_saledetail.setitem(li_counter, "SaleUtn", ul_maxutn)
		ul_maxutn = ul_maxutn + 1
	next
	wf_grandtotal()
	this.id_footer.accepttext()
	this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
	return lb_commitflag

// w_advancedsale.wf_show_refusedsale_form() returns 0
	s_datawindow lstr_dw
	if this.tab_retrieve.selectedtab = 1 then
		lstr_dw.dw = this.dw_refusedsaleheader
		lstr_dw.dw2 = this.dw_refusedsaledetail
		lstr_dw.i_protect = integer(this.dw_refusedsaledetail.object.itemname.protect)
		openwithparm(w_refusedsale_form, lstr_dw)
		lstr_dw.dw.sharedata(this.dw_refusedsaleheader)
		lstr_dw.dw2.sharedata(this.dw_refusedsaledetail)
	end if

// w_advancedsale.wf_get_refusedsaleinvcode(long al_saleinvcode, ref long al_refinvcode) returns long
	long ll_retcode = 2
	long ll_invcode
	setnull(al_refinvcode)
	SQL SELECT MAX ( RefusedSaleInvCode ) INTO :al_refinvcode FROM RefusedSaleHeader WHERE SaleInvCode =:al_saleinvcode GROUP BY SaleInvCode USING sqlca;
	if sqlca.sqlcode = 0 then
		ll_retcode = 0
	else
		ll_retcode = 1
	end if
	return ll_retcode

// w_advancedsale.wf_save_refusedsale(boolean ab_flag, long al_saleinvcode, integer ai_usercode, datetime adt_date) returns long
	long ll_icode
	long ll_pk
	long ll_maxretcode
	long ll_counter
	long ll_null
	long ll_refsaleinvcode
	long ll_headerrows
	long ll_detailrows
	long ll_retcode
	double ld_totalstock
	boolean lb_saveit
	setnull(ll_null)
	ll_headerrows = this.dw_refusedsaleheader.rowcount()
	ll_detailrows = this.dw_refusedsaledetail.rowcount()
	if this.ib_modify then
		if ll_headerrows > 0 and ll_detailrows > 0 then
			lb_saveit = true
		elseif ll_headerrows > 0 and ll_detailrows = 0 and wf_get_refusedsaleinvcode(al_saleinvcode, ll_refsaleinvcode) = 0 then
			if ll_refsaleinvcode > 0 then
				lb_saveit = true
			else
				lb_saveit = false
			end if
		else
			lb_saveit = false
		end if
	elseif ll_headerrows > 0 and ll_detailrows > 0 then
		lb_saveit = true
	else
		lb_saveit = false
	end if
	if lb_saveit then
		this.dw_refusedsaleheader.setitem(ll_headerrows, "usercode", ai_usercode)
		this.dw_refusedsaleheader.setitem(ll_headerrows, "date", adt_date)
		this.dw_refusedsaleheader.setitem(ll_headerrows, "saleinvcode", al_saleinvcode)
		ll_pk = this.dw_refusedsaleheader.getitemnumber(ll_headerrows, "code")
		if isnull(ll_pk) then
			ll_maxretcode = wf_tabnewid("refusedsaleheader", ll_pk)
			if ll_maxretcode < 0 then
				SQL rollback USING this.it_transobject;
				ll_retcode = 0
				return ll_retcode
			end if
			return
		end if
		if not isnull(ll_pk) then
			this.dw_refusedsaleheader.setitem(ll_headerrows, "code", ll_pk)
			for ll_counter = 1 to ll_detailrows
				this.dw_refusedsaledetail.setitem(ll_counter, "code", ll_pk)
				if this.dw_refusedsaledetail.getitemnumber(ll_counter, "reasoncode") = 2.0 then
					this.dw_refusedsaledetail.setitem(ll_counter, "unknownitemname", this.dw_refusedsaledetail.getitemstring(ll_counter, "itemname"))
					this.dw_refusedsaledetail.setitem(ll_counter, "icode", ll_null)
					this.dw_refusedsaledetail.setitem(ll_counter, "totalstock", 0)
				else
					ll_icode = this.dw_refusedsaledetail.getitemnumber(ll_counter, "icode")
					this.it_transobject.getitemstockall(ll_icode, ld_totalstock)
					this.dw_refusedsaledetail.setitem(ll_counter, "totalstock", ld_totalstock)
				end if
			next
			if this.dw_refusedsaleheader.update(true, false) < 0 then
				SQL rollback USING this.it_transobject;
				ll_retcode = 0
				return ll_retcode
			elseif this.dw_refusedsaledetail.update() > 0 then
				ll_retcode = 1
				SQL commit USING this.it_transobject;
				this.dw_refusedsaleheader.reset()
				this.dw_refusedsaledetail.reset()
				return ll_retcode
			else
				SQL rollback USING this.it_transobject;
				ll_retcode = 0
				return ll_retcode
			end if
		else
			SQL rollback USING this.it_transobject;
			ll_retcode = 0
			return ll_retcode
		end if
		return
	end if
	return ll_retcode

// w_advancedsale.wf_inititeminfo(long al_icode, long al_row, ref integer ai_rtcode, ref string as_errortext) returns boolean
	boolean retflag = true
	integer li_gcode
	integer li_defaultgcode
	integer li_defaultgst
	integer li_custcode
	integer li_flatdiscstatus
	integer li_itemdiscpercno
	integer li_icatcode
	long ll_packunits
	long ll_saleinvcode
	long ll_reorderqty
	long li_discstatus
	long ll_qtysale
	long ll_bonus
	long ll_itemdesc_status
	long ll_null
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_antinorcotix
	string ls_itemtotalval
	string ls_locksaleprice
	string ls_lockdiscperc
	string ls_remarks
	string ls_packingdesc
	string ls_temp
	double ld_rpp
	double ld_purprice
	double ld_flatdisc
	double ld_invdiscperc
	double ld_discperc2
	double ld_discperc3
	double ld_discperc4
	double ld_saleprice
	double ld_discperc
	double ld_purdiscperc
	double ld_avgprice
	double ld_unitsalestax
	double ld_gstperc1
	double ld_gstperc2
	double ld_packsalestax
	double ld_saleprice2
	double ld_saleprice3
	double ld_saleprice4
	double ld_saleprice5
	double ld_discperc5
	double ld_retailprice
	double ld_custitemcatdiscperc
	double ld_itemflatdisc
	double ld_godownstock
	double ld_totalstock
	double ld_holdlooseqty
	double ld_desiredbonus
	double ld_saleqty
	double ld_purunitrate
	double ld_rppunitrate
	setnull(ls_null)
	setnull(ll_null)
	SQL SELECT item.customicode , item.name , item.saleprice , item.packunits , item.salediscperc , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.avgprice , item.PurDiscPerc , item.antinorcotix , item.reorderqty , item.purprice , item.recentpurprice , round ( item.Packsalestax / item.packunits , 2 ) , item.gstperc1 , item.gstperc2 , qtysale =item.saleqty , bonus =item.bonusqty , item.Packsalestax , item.flatdisc , item.locksaleprice , item.lockdiscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 , item.remarks , item.retailprice , item.icatcode , item.packingdesc , round ( item.purprice / item.packunits , 2 ) , round ( item.recentpurprice / item.packunits , 2 ) INTO :ls_fullcode, :ls_name, :ld_saleprice, :ll_packunits, :ld_discperc, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :ld_avgprice, :ld_purdiscperc, :ls_antinorcotix, :ll_reorderqty, :ld_purprice, :ld_rpp, :ld_unitsalestax, :ld_gstperc1, :ld_gstperc2, :ll_qtysale, :ll_bonus, :ld_packsalestax, :ld_flatdisc, :ls_locksaleprice, :ls_lockdiscperc, :ld_discperc2, :ld_discperc3, :ld_discperc4, :ld_discperc5, :ls_remarks, :ld_retailprice, :li_icatcode, :ls_packingdesc, :ld_purunitrate, :ld_rppunitrate FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
	li_custcode = this.id_master.getitemnumber(1, "custcode")
	if isnull(li_custcode) then
		retflag = false
		as_errortext = "Validation Error: Select Customer "
	end if
	li_defaultgst = this.id_master.getitemnumber(1, "dd_gstperc")
	SQL SELECT InvDiscPerc INTO :ld_invdiscperc FROM customer WHERE customer.custcode =:li_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
	else
		if this.il_strategy = 2 then
			li_gcode = wf_getitemassociategcode(al_icode)
		end if
		if this.il_strategy = 1 then
			li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
		end if
	end if
	this.it_transobject.getitemstockall(al_icode, ld_totalstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if retflag then
		this.id_detail.setitem(al_row, "gcode", li_gcode)
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		li_discstatus = long(this.id_detail.object.discperc.visible)
		ll_itemdesc_status = long(this.id_detail.object.saleitemdescription.visible)
		li_flatdiscstatus = long(this.id_detail.object.itemflatdisc.visible)
		if li_discstatus = 1 and this.id_detail.getitemstatus(al_row, "discperc", primary!) = notmodified! then
			li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
			if wf_getcustitemcatwisesalesdiscount(al_icode, li_custcode, ld_custitemcatdiscperc, ld_itemflatdisc) = true then
				this.id_detail.setitem(al_row, "discperc", ld_custitemcatdiscperc)
				this.id_detail.setitem(al_row, "itemflatdisc", ld_itemflatdisc)
			elseif long(this.id_detail.object.discperc.visible) = 1 then
				choose case li_itemdiscpercno
				case 1
					this.id_detail.setitem(al_row, "discperc", ld_discperc)
				case 2
					this.id_detail.setitem(al_row, "discperc", ld_discperc2)
				case 3
					this.id_detail.setitem(al_row, "discperc", ld_discperc3)
				case 4
					this.id_detail.setitem(al_row, "discperc", ld_discperc4)
				case 5
					this.id_detail.setitem(al_row, "discperc", ld_discperc5)
				end choose
			else
				this.id_detail.setitem(al_row, "discperc", 0)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") and li_discstatus = 1 then
			li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
			if wf_getcustitemcatwisesalesdiscount(al_icode, li_custcode, ld_custitemcatdiscperc, ld_itemflatdisc) = true then
				this.id_detail.setitem(al_row, "discperc", ld_custitemcatdiscperc)
				this.id_detail.setitem(al_row, "itemflatdisc", ld_itemflatdisc)
			else
				choose case li_itemdiscpercno
				case 1
					this.id_detail.setitem(al_row, "discperc", ld_discperc)
				case 2
					this.id_detail.setitem(al_row, "discperc", ld_discperc2)
				case 3
					this.id_detail.setitem(al_row, "discperc", ld_discperc3)
				case 4
					this.id_detail.setitem(al_row, "discperc", ld_discperc4)
				case 5
					this.id_detail.setitem(al_row, "discperc", ld_discperc5)
				end choose
			end if
		end if
		if this.id_detail.getitemstatus(al_row, "saleprice", primary!) = notmodified! then
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
			case 2.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				this.id_detail.setitem(al_row, "packprice", ld_purprice)
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				this.id_detail.setitem(al_row, "packprice", ld_rpp)
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
			case else
				this.id_detail.setitem(al_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
			end choose
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
			case 2.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				this.id_detail.setitem(al_row, "packprice", ld_purprice)
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				this.id_detail.setitem(al_row, "packprice", ld_rpp)
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
			case else
				this.id_detail.setitem(al_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
			end choose
		end if
		this.id_detail.setitem(al_row, "icode", al_icode)
		this.id_detail.setitem(al_row, "packunits", ll_packunits)
		this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
		this.id_detail.setitem(al_row, "stock", ld_godownstock)
		this.id_detail.setitem(al_row, "packingdesc", ls_packingdesc)
		this.id_detail.setitem(al_row, "totalstock", ld_totalstock)
		this.id_detail.setitem(al_row, "retailprice", ld_retailprice / ll_packunits)
		if li_flatdiscstatus = 1 then
			if this.id_detail.getitemstatus(al_row, "itemflatdisc", primary!) = notmodified! then
				this.id_detail.setitem(al_row, "itemflatdisc", ld_flatdisc)
			end if
		else
			this.id_detail.setitem(al_row, "itemflatdisc", 0)
		end if
		if f_stringpreferences("SaleCopyItemRemarks") = "Y" and this.id_detail.getitemstatus(al_row, "saleitemdescription", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "saleitemdescription", ls_remarks)
		end if
		this.id_detail.setitem(al_row, "recentpurprice", ld_rpp)
		this.id_detail.setitem(al_row, "purprice", ld_purprice)
		this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
		if this.id_detail.getitemstatus(al_row, "purunitrate", primary!) = new! or this.id_detail.getitemstatus(al_row, "purunitrate", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "purunitrate", ld_purunitrate)
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			this.id_detail.setitem(al_row, "purunitrate", ld_purunitrate)
		end if
		this.id_detail.setitem(al_row, "rppunitrate", ld_rppunitrate)
		this.id_detail.setitem(al_row, "itemtotalval", ls_itemtotalval)
		if f_stringpreferences("bonusinsale") = "Y" then
			this.id_detail.setitem(al_row, "qtysale", ll_qtysale)
			this.id_detail.setitem(al_row, "bonus", ll_bonus)
			this.id_footer.setitem(1, "bonusratio", trim(string(ll_qtysale)) + ":" + trim(string(ll_bonus)))
			if ll_qtysale = ll_bonus and ll_qtysale = this.id_detail.object.looseqty[al_row] then
				this.id_detail.object.bonusqty[al_row] = ll_bonus
			end if
		end if
		if this.id_detail.getitemstatus(al_row, "Unitsalestax", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
		end if
		if this.id_detail.getitemstatus(al_row, "gstperc", primary!) = notmodified! then
			if li_defaultgst = 2 then
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
			if li_defaultgst = 2 then
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
			end if
			if f_stringpreferences("SaleCopyItemRemarks") = "Y" then
				this.id_detail.setitem(al_row, "saleitemdescription", ls_remarks)
			end if
		end if
		this.id_detail.setitem(al_row, "locksaleprice", ls_locksaleprice)
		this.id_detail.setitem(al_row, "lockdiscperc", ls_lockdiscperc)
	else
		retflag = false
		as_errortext = "Item can not be sold, its Stock is Zero"
	end if
	if f_stringpreferences("salepromptforreorder") = "Y" and ll_reorderqty > ld_godownstock then
		messagebox("Stock", "Stock for this item become~r~n less than ReorderQty")
	end if
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_totalstock)
	this.id_footer.setitem(1, "retailprice", ld_retailprice / ll_packunits)
	this.id_footer.setitem(1, "rpp", ld_rpp)
	this.id_footer.setitem(1, "purprice", ld_purprice)
	this.id_footer.setitem(1, "avgprice", ld_avgprice)
	this.id_footer.setitem(1, "itemtotalval", ls_itemtotalval)
	if this.id_footer.getitemstatus(1, "invdiscperc", primary!) = notmodified! and this.ib_modify = false then
		this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
	end if
	if f_stringpreferences("bonusinsale") = "Y" then
		this.id_footer.setitem(1, "bonusratio", trim(string(ll_qtysale)) + ":" + trim(string(ll_bonus)))
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			ld_holdlooseqty = this.id_detail.getitemnumber(al_row, "looseqty")
			if this.id_detail.getitemnumber(al_row, "qtysale") = 0.0 then
				ld_desiredbonus = 0
			else
				ld_desiredbonus = int(ld_holdlooseqty / double(this.id_detail.getitemnumber(al_row, "qtysale")) * double(this.id_detail.getitemnumber(al_row, "Bonus")))
			end if
			if ld_holdlooseqty + ld_desiredbonus <= ld_godownstock then
				this.id_detail.setitem(al_row, "bonusqty", ld_desiredbonus)
			elseif ld_holdlooseqty > ld_godownstock then
				if this.id_detail.object.due[this.id_detail.rowcount()] <> "D" then
					messagebox("Quantity Validation", "Quantity " + string(ld_holdlooseqty) + " exceeds stock " + string(ld_godownstock) + ".")
					this.id_detail.setitem(al_row, "looseqty", 1)
					this.id_detail.setitem(al_row, "bonusqty", 0)
				end if
			else
				ld_desiredbonus = messagebox("Problem allocating bonus", "Sale Qty = " + string(ld_holdlooseqty) + " ~r" + "Required Bonus = " + trim(string(ld_desiredbonus)) + " ~r" + "Stock available = " + trim(string(ld_godownstock)) + " ~r" + "Allocate possible bonus?", question!, yesno!, 2)
				if ld_desiredbonus = 1.0 then
					this.id_detail.setitem(al_row, "bonusqty", ld_godownstock - ld_holdlooseqty)
				else
					retflag = false
					this.id_detail.setitem(al_row, "bonusqty", 0)
				end if
			end if
		end if
	end if
	this.id_footer.object.t_purdiscper.text = string(ld_purdiscperc)
	this.id_detail.setitem(al_row, "itemcode", al_icode)
	if ls_antinorcotix = "Y" and retflag = true and not (this.il_norcotixcode = al_icode) and isnull(trim(this.id_master.getitemstring(1, "remarks"))) then
		messagebox("Item Validation", "This is Narcotics item ~r~n please type Doctor name in remarks")
		this.il_norcotixcode = al_icode
		retflag = false
		this.il_norcotixcode = al_icode
		if f_stringpreferences("doctnamefornorcotix") = "Y" then
			this.id_master.setfocus()
			this.id_master.setcolumn("remarks")
		end if
	end if
	return retflag

// w_advancedsale.wf_savastemplate() returns integer
	s_saletemplateheader lstr_templateheader
	long ll_invid
	integer li_retcode = 1
	long ll_code
	long ll_qty
	long ll_icode
	long ll_totalrows
	long ll_rowcount
	open(w_savesaleastemplate)
	lstr_templateheader = message.powerobjectparm
	f_newtableid("SaleTemplateHeader", ll_invid)
	SQL INSERT INTO SaleTemplateHeader ( saletemplatecode , date , modified , name ) values ( :ll_invid , :lstr_templateheader.dt_templatedate , :lstr_templateheader.dt_templatedate , :lstr_templateheader.s_template ) USING this.it_transobject;
	ll_totalrows = this.id_detail.rowcount()
	for ll_rowcount = 1 to ll_totalrows
		ll_code = ll_invid
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ll_qty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		SQL insert into saletemplatedetail ( saletemplatecode , icode , looseqty ) values ( :ll_code , :ll_icode , :ll_qty ) USING this.it_transobject;
	next
	setpointer(hourglass!)
	if this.it_transobject.sqlcode < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return li_retcode
	else
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Template saved", exclamation!, ok!, 1)
	end if
	return li_retcode

// w_advancedsale.wf_editquotation() returns integer
	datastore lds_quotationdetail
	datastore lds_quotationheader
	datastore lds_items
	s_saletemplate lstr_template
	boolean lb_enablesave
	boolean lb_editsaleprice
	boolean lb_insertrow
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_option
	long ll_currrow
	long ll_packunits
	long ll_found
	long ll_populatecount
	long ll_drow
	long ll_ds_row
	long ll_custcode
	long ll_usesaleinv
	long ll_loosepack
	integer li_retcode = 1
	integer li_errcode
	string ls_errortext
	string ls_itemname
	string ls_loosepack
	string ls_customer
	double ld_price
	double ld_tmpprice
	double ld_qty
	double ld_bonusqty
	double ld_stock
	if wf_iseditable() = false then
		return 0
	end if
	lds_quotationdetail = create datastore
	lds_quotationheader = create datastore
	lds_items = create datastore
	open(w_editquotationform_using_preferences)
	lstr_template = message.powerobjectparm
	if f_stringpreferences("AllowDupQuotInSale") = "N" and wf_quotationinuse(lstr_template.l_invtemplate, ll_usesaleinv) <> 0 then
		setredraw(true)
		messagebox("Quotation Validation", "Quotation already used in Invoice No: " + string(ll_usesaleinv), stopsign!)
		return -1
	end if
	if lstr_template.c_copyinvfrom = "T" then
		lds_quotationdetail.dataobject = "d_quotationdetail_retrieve_sale"
		lds_quotationdetail.settransobject(this.it_transobject)
		lds_quotationheader.dataobject = "d_quotationheader"
		lds_quotationheader.settransobject(this.it_transobject)
		lds_items.dataobject = "d_quotation_salepopulation_rejected"
		lds_items.settransobject(this.it_transobject)
		ll_row = lds_quotationheader.retrieve(lstr_template.l_invtemplate)
		lds_quotationdetail.retrieve(lstr_template.l_invtemplate)
		ll_totalrows = lds_quotationheader.retrieve(lstr_template.l_invtemplate)
		if ll_row < 0 then
			li_retcode = -1
		end if
		setredraw(false)
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 511", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			lb_editsaleprice = true
		end if
		ll_mrow = this.id_master.getrow()
		this.id_master.setitem(ll_mrow, "quotationno", lstr_template.l_invtemplate)
		ll_custcode = lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "custcode")
		SQL Select Name INTO :ls_customer From Accounts Where AccCode =:ll_custcode USING this.it_transobject;
		if this.ii_saletype = 2 then
			this.id_master.setitem(ll_mrow, "custcode", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "custcode"))
		end if
		this.id_master.setitem(ll_mrow, "sprice", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "sprice"))
		this.id_master.setitem(ll_mrow, "remarks", lds_quotationheader.getitemstring(lds_quotationheader.getrow(), "remarks"))
		this.id_master.setitem(ll_mrow, "headerno", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "headerno"))
		this.id_footer.setitem(ll_mrow, "misccharges", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "misccharges"))
		ll_loosepack = lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "loosepack")
		this.id_footer.setitem(ll_mrow, "flatdisc", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "flatdisc"))
		ll_totalrows = lds_quotationdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for ll_rowcount = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		this.id_detail.reset()
		for ll_rowcount = 1 to ll_totalrows
			lb_insertrow = false
			if lb_editsaleprice = false then
				if wf_getitemsaleprice(lds_quotationdetail.getitemnumber(ll_rowcount, "icode"), ld_tmpprice) = 0 then
					if ll_loosepack = 1 then
						ld_price = lds_quotationdetail.getitemnumber(ll_rowcount, "saleprice")
					else
						ld_price = round(lds_quotationdetail.getitemnumber(ll_rowcount, "saleprice") / ll_packunits, 2)
					end if
					if ld_price = ld_tmpprice then
						lb_insertrow = true
					else
						ll_option = messagebox("Problem in Quotation Population!", "System Pricing Policy does not permit the quoted price~r~nPopulate Item with fresh price(s)?", question!, yesno!)
					end if
					if ll_option = 1 then
						lb_insertrow = true
					end if
				else
					lb_insertrow = false
				end if
			else
				lb_insertrow = true
			end if
			if lb_insertrow = true then
				ll_populatecount = ll_populatecount + 1
				ll_drow = this.id_detail.insertrow(0)
				li_errcode = 0
				ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_quotationdetail.getitemnumber(ll_rowcount, "gcode")), 1, this.idc_godown.rowcount())
				ls_itemname = lds_quotationdetail.getitemstring(ll_rowcount, "itemname")
				if ll_validgodowncode = 0 or this.il_strategy = 2 or this.il_godowncount = 1 then
					wf_inititeminfo(lds_quotationdetail.getitemnumber(ll_rowcount, "icode"), ll_drow, li_errcode, ls_errortext)
				else
					ll_gcode = lds_quotationdetail.getitemnumber(ll_rowcount, "gcode")
					this.id_detail.setitem(ll_drow, "gcode", ll_gcode)
					wf_inititeminfo_quotation(lds_quotationdetail.getitemnumber(ll_rowcount, "icode"), ll_drow, li_errcode, ls_errortext, ll_gcode)
				end if
				ll_packunits = lds_quotationdetail.getitemnumber(ll_rowcount, "packunits")
				if ll_packunits = 0 then
					ll_packunits = 1
				end if
				this.id_detail.setitem(ll_drow, "packunits", ll_packunits)
				if ll_loosepack = 1 then
					ld_qty = lds_quotationdetail.getitemnumber(ll_rowcount, "looseqty")
					ld_bonusqty = lds_quotationdetail.getitemnumber(ll_rowcount, "bonusqty")
					if lb_editsaleprice = false and ld_price <> ld_tmpprice then
						ld_price = ld_tmpprice
					else
						ld_price = lds_quotationdetail.getitemnumber(ll_rowcount, "saleprice")
					end if
				else
					ld_qty = lds_quotationdetail.getitemnumber(ll_rowcount, "looseqty") * ll_packunits
					ld_bonusqty = lds_quotationdetail.getitemnumber(ll_rowcount, "bonusqty") * ll_packunits
					if lb_editsaleprice = false and ld_price <> ld_tmpprice then
						ld_price = ld_tmpprice
					else
						ld_price = round(lds_quotationdetail.getitemnumber(ll_rowcount, "saleprice") / ll_packunits, 2)
					end if
				end if
				this.id_detail.setitem(ll_drow, "looseqty", ld_qty)
				this.id_detail.setitem(ll_drow, "bonusqty", ld_bonusqty)
				this.id_detail.setitem(ll_drow, "saleprice", ld_price)
				this.id_detail.setitem(ll_drow, "discperc", lds_quotationdetail.getitemnumber(ll_rowcount, "discperc"))
				this.id_detail.setitem(ll_drow, "itemflatdisc", lds_quotationdetail.getitemnumber(ll_rowcount, "itemflatdisc"))
				ld_stock = this.id_detail.getitemnumber(ll_drow, "stock")
				if ld_qty + ld_bonusqty > ld_stock then
					ll_ds_row = lds_items.insertrow(0)
					lds_items.setitem(ll_ds_row, "customer", ls_customer)
					lds_items.setitem(ll_ds_row, "code", lds_quotationdetail.getitemnumber(ll_rowcount, "code"))
					lds_items.setitem(ll_ds_row, "icode", lds_quotationdetail.getitemnumber(ll_rowcount, "icode"))
					if lds_quotationheader.getitemnumber(1, "loosepack") = 1.0 then
						ls_loosepack = "Loose"
						lds_items.setitem(ll_ds_row, "stock", this.id_detail.getitemnumber(ll_drow, "stock"))
						lds_items.setitem(ll_ds_row, "balance", lds_quotationdetail.getitemnumber(ll_rowcount, "looseqty") - ld_stock)
					else
						ls_loosepack = "Pack"
						if long(ld_stock) mod ll_packunits = 0 then
							lds_items.setitem(ll_ds_row, "stock", ld_stock / ll_packunits)
						else
							lds_items.setitem(ll_ds_row, "stock", ld_stock)
							lds_items.setitem(ll_ds_row, "stockloosepack", "L")
						end if
						if (ld_qty - ld_stock) mod ll_packunits = 0.0 then
							lds_items.setitem(ll_ds_row, "balance", (ld_qty - ld_stock) / ll_packunits)
						else
							lds_items.setitem(ll_ds_row, "balance", ld_qty - ld_stock)
							lds_items.setitem(ll_ds_row, "balanceloosepack", "L")
						end if
					end if
					lds_items.setitem(ll_ds_row, "type", ls_loosepack)
					lds_items.setitem(ll_ds_row, "customer", ls_customer)
					lds_items.setitem(ll_ds_row, "aliasname", this.id_detail.getitemstring(ll_drow, "fullcode"))
					lds_items.setitem(ll_ds_row, "itemname", lds_quotationdetail.getitemstring(ll_rowcount, "itemname"))
					lds_items.setitem(ll_ds_row, "qty", lds_quotationdetail.getitemnumber(ll_rowcount, "looseqty"))
					if ld_stock > ld_qty and ld_stock > 0.0 then
						this.id_detail.setitem(ll_drow, "looseqty", ld_qty)
						if ld_stock - ld_qty > ld_bonusqty then
							this.id_detail.setitem(ll_drow, "bonusqty", ld_stock - ld_qty)
						else
							this.id_detail.setitem(ll_drow, "bonusqty", ld_stock - ld_qty)
						end if
					elseif ld_stock <= 0.0 then
						this.id_detail.setitem(ll_drow, "looseqty", 1)
					else
						this.id_detail.setitem(ll_drow, "looseqty", ld_stock)
					end if
					if ld_stock <= 0.0 then
						this.id_detail.setrow(ll_drow)
						this.id_detail.scrolltorow(ll_drow)
						event ue_deleteitem()
					end if
				end if
			end if
		next
		this.id_footer.setitem(ll_mrow, "invdiscperc", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "discperc"))
		setredraw(true)
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	if lds_items.rowcount() > 0 then
		openwithparm(w_quotation_salepopulation_rejected, lds_items)
	end if
	wf_grandtotal()
	return li_retcode

// w_advancedsale.wf_allowinvoice(long al_custcode, ref long al_lastinvcode) returns long
	long ll_retcode
	long ll_code
	if this.ib_modify then
		ll_code = this.id_master.getitemnumber(this.id_master.rowcount(), "code")
		SQL SELECT COUNT ( CustCode ) , max ( AdvSaleInvCode ) INTO :ll_retcode, :al_lastinvcode FROM AdvSaleLedger WHERE CustCode =:al_custcode and AdvSaleInvCode <> :ll_code and Posted ='N' AND Deleted ='N' USING sqlca;
	else
		SQL SELECT COUNT ( CustCode ) , max ( AdvSaleInvCode ) INTO :ll_retcode, :al_lastinvcode FROM AdvSaleLedger WHERE CustCode =:al_custcode and Posted ='N' AND Deleted ='N' USING sqlca;
	end if
	return ll_retcode

// w_advancedsale.wf_selectprintreport(string as_invoicesize) returns string
	string ls_pagesize
	string ls_report
	long ll_currrow
	boolean lb_listtab
	integer li_headerno
	ls_pagesize = as_invoicesize
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab then
		li_headerno = this.id_list.getitemnumber(this.id_list.getrow(), "headerno")
	else
		li_headerno = this.id_master.getitemnumber(1, "headerno")
	end if
	if ls_pagesize = "Q" and this.ib_printout then
		if gs_company = "AGHASUPERMARK" then
			ls_report = "d_aghas_thermal_advsaleinvreport"
		elseif gs_company = "DWSMALL" then
			ls_report = "d_dws_advsaleinvreportwh"
		elseif gs_company = "ZMART" or gs_company = "CITYMARTSWL" or gs_company = "MEDCINSUPERSTOR" then
			ls_report = "d_zmart_advsaleinvrepwh"
		else
			ls_report = "d_advsaleinvreportwh"
		end if
	elseif ls_pagesize = "Q" and this.ib_printout = false then
		if gs_company = "AGHASUPERMARK" then
			ls_report = "d_aghas_thermal_advsaleinvreport"
		elseif gs_company = "DWSMALL" then
			ls_report = "d_dws_advsaleinvreportwh"
		elseif gs_company = "ZMART" or gs_company = "CITYMARTSWL" or gs_company = "MEDCINSUPERSTOR" then
			ls_report = "d_zmart_advsaleinvrepwh"
		else
			ls_report = "d_advsaleinvreportwh"
		end if
	elseif ls_pagesize = "F" and this.ib_printout then
		ls_report = "d_aghas_thermal_advsaleinvreport"
	elseif ls_pagesize = "F" and this.ib_printout = false then
		ls_report = "d_aghas_thermal_advsaleinvreport"
	elseif ls_pagesize = "H" and this.ib_printout then
		ls_report = "d_aghas_thermal_advsaleinvreport"
	elseif ls_pagesize = "H" and this.ib_printout = false then
		ls_report = "d_aghas_thermal_advsaleinvreport"
	elseif ls_pagesize = "T" and this.ib_printout then
		if gs_company = "FARIDS" then
			ls_report = "d_farids_advsaleinvreport_3inches"
		else
			ls_report = "d_thermal_advsaleinvrepwh_3inches"
		end if
	elseif ls_pagesize = "T" and this.ib_printout = false then
		if gs_company = "FARIDS" then
			ls_report = "d_farids_advsaleinvreport_3inches"
		else
			ls_report = "d_thermal_advsaleinvrepwh_3inches"
		end if
	else
		ls_report = "d_aghas_thermal_advsaleinvreport"
	end if
	this.id_print.dataobject = ls_report
	this.id_print.settransobject(this.it_transobject)
	this.ib_printout = true
	return ls_report

// w_advancedsale.wf_allow_sale_to_customer_below_avgprice(long al_custcode) returns long
	char ls_allow = "N"
	SQL SELECT AllowSaleBelowAvgPrice INTO :ls_allow FROM CUSTOMER WHERE CustCode =:al_custcode USING sqlca;
	if sqlca.sqlcode = 0 then
		if ls_allow = "Y" then
			return 1
		else
			return 0
		end if
		return
	end if
	return -1

// w_advancedsale.wf_printbarcode() returns 0
	s_datawindow lstr_arg
	if this.tab_retrieve.selectedtab = 1 then
		lstr_arg.dw = this.id_detail
		lstr_arg.l_code = 3
		openwithparm(w_barcodelabels_popup, lstr_arg)
	end if

// w_advancedsale.wf_show_receivableadjustment_form() returns 0
	s_datawindow lstr_dw
	wf_grandtotal()
	if f_stringpreferences("AskForRecAdjInCreditSale") = "Y" and this.tab_retrieve.selectedtab = 1 then
		lstr_dw.dw = this.dw_receivable_adjdetail
		lstr_dw.i_protect = integer(this.dw_receivable_adjdetail.object.accountname.protect)
		lstr_dw.l_code = this.id_master.getitemnumber(this.id_master.rowcount(), "code")
		lstr_dw.l_code2 = this.id_master.getitemnumber(this.id_master.rowcount(), "custcode")
		lstr_dw.s_name1 = this.id_master.getitemstring(this.id_master.rowcount(), "aliasname")
		lstr_dw.d_amt = this.id_footer.getitemnumber(this.id_footer.rowcount(), "total")
		lstr_dw.d_amt2 = this.id_master.getitemnumber(this.id_master.rowcount(), "amt")
		openwithparm(w_sale_receivable_adj, lstr_dw)
		lstr_dw = message.powerobjectparm
		if lstr_dw.i_status = 1 then
			this.id_master.setitem(this.id_master.rowcount(), "outstandingamt", lstr_dw.d_amt3)
			lstr_dw.dw.sharedata(this.dw_receivable_adjdetail)
			return
		end if
	end if

// w_advancedsale.wf_populate_receivable_adjustment(long al_saleinvcode) returns long
	long ll_counter
	long ll_null
	long ll_detailrows
	long ll_retcode = 2
	boolean lb_saveit
	setnull(ll_null)
	ll_detailrows = this.dw_receivable_adjdetail.rowcount()
	if ll_detailrows > 0 then
		for ll_counter = 1 to ll_detailrows
			this.dw_receivable_adjdetail.setitem(ll_counter, "code", al_saleinvcode)
			if this.dw_receivable_adjdetail.getitemstring(ll_counter, "treatment") = "I" then
				this.dw_receivable_adjdetail.setitem(ll_counter, "debit", 0)
				this.dw_receivable_adjdetail.setitem(ll_counter, "credit", this.dw_receivable_adjdetail.getitemdecimal(ll_counter, "amount"))
			else
				this.dw_receivable_adjdetail.setitem(ll_counter, "debit", this.dw_receivable_adjdetail.getitemdecimal(ll_counter, "amount"))
				this.dw_receivable_adjdetail.setitem(ll_counter, "credit", 0)
			end if
		next
		ll_retcode = 0
	else
		ll_retcode = 0
	end if
	return ll_retcode

// w_advancedsale.wf_setoutstandingamount() returns long
	double ld_invtotal
	double ld_amt
	double ld_outstandingamt
	double ld_balance
	double ld_adjamt
	long ll_masterrow
	long ll_footerrow
	ll_masterrow = this.id_master.rowcount()
	ll_footerrow = this.id_footer.rowcount()
	wf_grandtotal()
	ld_invtotal = this.id_footer.getitemnumber(ll_footerrow, "total")
	ld_amt = this.id_master.getitemnumber(ll_masterrow, "amt")
	ld_balance = ld_invtotal - ld_amt
	if ld_balance > 0.0 then
		ld_outstandingamt = ld_balance
	else
		ld_outstandingamt = 0.00
	end if
	if this.dw_receivable_adjdetail.rowcount() > 0 then
		ld_adjamt = this.dw_receivable_adjdetail.getitemnumber(1, "c_totalamt")
		if ld_outstandingamt + ld_adjamt <= 0.0 then
			ld_outstandingamt = 0.00
		else
			ld_outstandingamt = ld_outstandingamt + ld_adjamt
		end if
	end if
	this.id_master.setitem(ll_masterrow, "outstandingamt", ld_outstandingamt)
	return 0

// w_advancedsale.wf_checklicenceexpiry(long al_custcode) returns integer
	integer lic_licexpirycussion = 30
	integer li_option = 1
	string ls_licenceno
	datetime ldt_licence_expiry
	long ll_daysremaining = 999
	SQL Select licenceexpiry , licenceno INTO :ldt_licence_expiry, :ls_licenceno From Customer Where custcode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 and f_stringpreferences("ValidateCustLicExpiryInSale") = "Y" then
		if isnull(ls_licenceno) then
			ls_licenceno = ""
		end if
		if not isnull(ldt_licence_expiry) then
			ll_daysremaining = daysafter(today(), date(string(ldt_licence_expiry, "m-d-yy")))
			if ll_daysremaining < 0 then
				li_option = messagebox("Licence Expiry Problem!", "Customer Licence # = " + ls_licenceno + "~r~n" + "Licence Expiry Date = " + string(ldt_licence_expiry, "mmm dd, yyyy") + "~r~n" + "Customer Licence has been expired~r~n" + "Do you still proceed with invoicing?", question!, yesno!, 1)
			elseif ll_daysremaining <= 30 then
				messagebox("Licence Expiry Notification!", "Customer Licence # = " + ls_licenceno + "~r~n" + "Licence Expiry Date = " + string(ldt_licence_expiry, "mmm dd, yyyy") + "~r~n" + "Customer Licence is about to expire in " + trim(string(ll_daysremaining)) + " days", information!)
			end if
		end if
	end if
	return li_option

// w_advancedsale.wf_checkunpostedcustomersale(long al_custcode) returns integer
	integer li_option = 1
	long ll_lastinvcode
	if f_stringpreferences("UnpostedCustSaleInvAlert") = "Y" and wf_allowinvoice(al_custcode, ll_lastinvcode) > 0 then
		li_option = messagebox("Customer Validation!", "Un-Posted Invoice(s) Exist for this Customer~r~n" + "Last Invoice # " + trim(string(ll_lastinvcode)), question!, yesno!, 2)
	end if
	return li_option

// w_advancedsale.wf_setcustomerinfo(long row, integer i, string data) returns integer
	long ll_code
	long ll_custcode
	long ll_counter
	long ll_icode
	long ll_customerbalance
	long ll_lastinvcode
	double ld_custgst
	double ld_gstperc1
	double ld_gstperc2
	double ld_itemdiscperc
	double ld_itemdiscperc2
	double ld_itemdiscperc3
	double ld_itemdiscperc4
	double ld_saleprice1
	double ld_saleprice2
	double ld_saleprice3
	double ld_invdiscperc
	double ld_saleprice4
	double ld_saleprice5
	double ld_itemdiscperc5
	double ld_custitemcatdiscperc
	double ld_itemflatdisc
	integer li_salepriceno
	integer li_itemdiscpercno
	integer li_packunits
	integer li_smancode
	integer li_null
	integer li_option
	integer li_saletypecode
	boolean lb_setiteminfo
	string ls_null
	string ls_aliasname
	setnull(li_null)
	setnull(ls_null)
	this.ib_validcustomer = false
	ll_code = long(data)
	if not isnull(data) then
		this.il_custcode = ll_code
		setredraw(false)
		if wf_customerinfo(ll_code) <> 0 then
			messagebox("Database Error", "Customer information can not be retrieved")
			setredraw(true)
			return 1
		end if
		setredraw(true)
	elseif data = "0" then
		messagebox("Database Error", "Customer information can not be retrieved")
		return 1
	end if
	if this.id_master.accepttext() = -1 then
		return 1
	end if
	setredraw(false)
	ll_custcode = this.id_master.getitemnumber(row, "custcode")
	if this.id_detail.getrow() > 0 and isnull(this.id_detail.getitemnumber(this.id_detail.getrow(), "itemcode")) then
		if this.id_detail.getrow() = 1 or this.id_detail.rowcount() = 1 then
			this.id_detail.object.fullcode[this.id_detail.getrow()] = ls_null
			this.id_detail.object.icode[this.id_detail.getrow()] = li_null
			this.id_detail.object.itemname[this.id_detail.getrow()] = ls_null
			this.id_detail.object.bonusqty[this.id_detail.getrow()] = 0
			this.id_detail.object.saleprice[this.id_detail.getrow()] = li_null
		else
			event ue_deleteitem()
		end if
	end if
	if this.ii_saletype = 2 and f_stringpreferences("InSaleCustomerBalance") = "Y" then
		for ll_counter = 1 to this.ids_customersbalance.rowcount()
			if this.ids_customersbalance.getitemnumber(ll_counter, "code1") = this.id_master.getitemnumber(row, "custcode") then
				this.ii_focuscustomer = 3
				ll_customerbalance = this.ids_customersbalance.getitemnumber(ll_counter, "value1")
				this.id_master.setitem(row, "customerbalance", ll_customerbalance)
				if ll_customerbalance > 0 then
					this.id_master.setitem(row, "debitorcredit", "Dr")
				else
					this.id_master.setitem(row, "debitorcredit", "Cr")
				end if
				exit
			else
				this.ii_focuscustomer = 3
				this.id_master.setitem(row, "debitorcredit", "Cr")
				this.id_master.setitem(row, "customerbalance", 0)
			end if
		next
	end if
	SQL Select invdiscperc , salesmancode INTO :ld_invdiscperc, :li_smancode From Customer Where custcode =:ll_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if f_stringpreferences("SalesManInSale") = "Y" then
			this.id_master.setitem(1, "smancode", li_smancode)
		end if
		if f_stringpreferences("setcustwiseiteminfo") = "Y" then
			lb_setiteminfo = true
		end if
	end if
	if lb_setiteminfo = true then
		this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
		SQL SELECT cust.defaultgst , cust.defaultsaleprice , cust.defaultitemdiscperc , acc.aliasname , cust.saletypecode INTO :ld_custgst, :li_salepriceno, :li_itemdiscpercno, :ls_aliasname, :li_saletypecode FROM customer cust , accounts acc WHERE cust.custcode =:ll_custcode AND cust.custcode =acc.acccode USING this.it_transobject;
		if this.it_transobject.sqlcode = -1 then
			messagebox("Database Error", "Customer information can not be retrieved")
			return 1
		end if
		if not (this.it_transobject.sqlcode = 100) then
			if ld_custgst = 2.0 then
				this.id_master.setitem(1, "dd_gstperc", 2)
			else
				this.id_master.setitem(1, "dd_gstperc", 1)
			end if
		end if
		this.id_master.setitem(1, "saletypecode", li_saletypecode)
		this.id_master.setitem(1, "itemdiscpercno", li_itemdiscpercno)
		this.id_master.setitem(1, "sprice", li_salepriceno)
		this.id_master.setitem(1, "aliasname", ls_aliasname)
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
			if not isnull(ll_icode) then
				SQL SELECT item.gstperc1 , item.gstperc2 , item.salediscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 , item.saleprice , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.packunits INTO :ld_gstperc1, :ld_gstperc2, :ld_itemdiscperc, :ld_itemdiscperc2, :ld_itemdiscperc3, :ld_itemdiscperc4, :ld_itemdiscperc5, :ld_saleprice1, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :li_packunits FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
				if this.it_transobject.sqlcode = -1 then
					messagebox("Database Error", "Item information can not be retrieved")
					return 1
				end if
				if not (this.it_transobject.sqlcode = 100) then
					if ld_custgst = 2.0 then
						this.id_detail.setitem(ll_counter, "gstperc", ld_gstperc2)
					else
						this.id_detail.setitem(ll_counter, "gstperc", ld_gstperc1)
					end if
				end if
				choose case li_salepriceno
				case 1
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice1 / li_packunits)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice1)
				case 2
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice2 / li_packunits)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice2)
				case 3
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice3 / li_packunits)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice3)
				case 4
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice4 / li_packunits)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice4)
				case 5
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice5 / li_packunits)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice5)
				end choose
				if long(this.id_detail.object.discperc.visible) = 1 then
					if wf_getcustitemcatwisesalesdiscount(ll_icode, ll_custcode, ld_custitemcatdiscperc, ld_itemflatdisc) = true then
						this.id_detail.setitem(ll_counter, "discperc", ld_custitemcatdiscperc)
						this.id_detail.setitem(ll_counter, "itemflatdisc", ld_itemflatdisc)
					else
						choose case li_itemdiscpercno
						case 1
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc)
						case 2
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc2)
						case 3
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc3)
						case 4
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc4)
						case 5
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc5)
						end choose
					end if
				else
					this.id_detail.setitem(ll_counter, "discperc", 0)
				end if
			end if
		next
	end if
	if this.id_detail.rowcount() <= 0 then
		event ue_newitem()
		this.id_master.setfocus()
	end if
	setredraw(true)
	return 0

// w_advancedsale.wf_get_associatedquotationcode(long al_custcode) returns long
	long ll_retcode = -1
	long ll_quotationcode = -1
	if al_custcode = 0 or isnull(al_custcode) then
		ll_retcode = -1
		return ll_retcode
	else
		SQL SELECT AssociatedQuotationCode INTO :ll_quotationcode FROM DBO.Customer WHERE CustCode =:al_custcode USING sqlca;
		if sqlca.sqlcode = 0 then
			if ll_quotationcode = 0 or isnull(ll_quotationcode) then
				ll_retcode = 0
			else
				ll_retcode = ll_quotationcode
			end if
		else
			ll_retcode = -2
		end if
	end if
	return ll_retcode

// w_advancedsale.wf_apply_associatedquotation(integer ai_mode) returns long
	long ll_custcode
	long ll_masterrow
	long ll_quotationcode
	long ll_detailrows
	long ll_qheaderrow
	long ll_quotationrows
	long ll_found
	long ll_loosepack
	long ll_rowcount
	long ll_quotpackunits
	long ll_icode
	long ll_notfound_itemcount
	double ld_quotprice
	double ld_quotdiscperc
	double ld_quotitemflatdisc
	double ld_quotqty
	double ld_quotbonusqty
	double ld_qty
	double ld_bonusqty
	double ld_bonusfactor
	string ls_msgtitle = "Customer Associated Quotation"
	string ls_itemname
	string ls_msgdetail
	boolean lb_editsaleprice
	boolean lb_editsalediscperc
	boolean lb_editbonusqty
	boolean lb_edititewflatdisc
	datastore lds_quotationdetail
	datastore lds_quotationheader
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_custcode = this.id_master.getitemnumber(ll_masterrow, "custcode")
	if ll_custcode = 0 or isnull(ll_custcode) then
		messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Items before applying Customers' Associated Quotation", stopsign!)
		return 0
	end if
	ll_quotationcode = wf_get_associatedquotationcode(ll_custcode)
	if ll_quotationcode < 0 then
		if ll_quotationcode = -1 then
			messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
			return 0
		else
			messagebox(ls_msgtitle, "Problem in retrieving Associated Quotation of Customer", stopsign!)
			return 0
		end if
	elseif ll_quotationcode = 0 then
		if ai_mode = 0 then
			messagebox(ls_msgtitle, "No Associated Quotation found for this Customer", stopsign!)
			return 0
		else
			return 1
		end if
		return
	end if
	lds_quotationdetail = create datastore
	lds_quotationheader = create datastore
	lds_quotationdetail.dataobject = "d_quotationdetail_retrieve"
	lds_quotationdetail.settransobject(this.it_transobject)
	lds_quotationheader.dataobject = "d_quotationheader"
	lds_quotationheader.settransobject(this.it_transobject)
	ll_qheaderrow = lds_quotationheader.retrieve(ll_quotationcode)
	if ll_qheaderrow < 0 then
		messagebox(ls_msgtitle, "Associated Quotation Header Retrieval Problem", stopsign!)
		return 0
	else
		ll_qheaderrow = lds_quotationheader.rowcount()
		if ll_qheaderrow = 0 then
			messagebox(ls_msgtitle, "Associated Quotation Does not Exist", stopsign!)
			return 0
		end if
	end if
	ll_quotationrows = lds_quotationdetail.retrieve(ll_quotationcode)
	if ll_quotationrows < 0 then
		messagebox(ls_msgtitle, "Associated Quotation Detail Retrieval Problem", stopsign!)
		return 0
	else
		ll_quotationrows = lds_quotationdetail.rowcount()
		if ll_quotationrows = 0 then
			if ai_mode = 0 then
				messagebox(ls_msgtitle, "Associated Quotation contain no rows", stopsign!)
				return 0
			else
				return 1
			end if
			return
		end if
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 511", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editsaleprice = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 516", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editsalediscperc = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 596", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editbonusqty = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 517", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_edititewflatdisc = true
	end if
	ll_loosepack = lds_quotationheader.getitemnumber(ll_qheaderrow, "loosepack")
	setredraw(false)
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ll_found = 0
		ll_found = lds_quotationdetail.find("icode = " + trim(string(ll_icode)), 1, ll_quotationrows)
		if ll_found > 0 then
			ll_quotpackunits = lds_quotationdetail.getitemnumber(ll_found, "packunits")
			ld_quotdiscperc = lds_quotationdetail.getitemnumber(ll_found, "discperc")
			ld_quotitemflatdisc = lds_quotationdetail.getitemnumber(ll_found, "itemflatdisc")
			if ll_quotpackunits = 0 then
				ll_quotpackunits = 1
			end if
			if ll_loosepack = 1 then
				ld_quotqty = lds_quotationdetail.getitemnumber(ll_found, "looseqty")
				ld_quotbonusqty = lds_quotationdetail.getitemnumber(ll_found, "bonusqty")
				ld_quotprice = lds_quotationdetail.getitemnumber(ll_found, "saleprice")
			else
				ld_quotqty = lds_quotationdetail.getitemnumber(ll_found, "looseqty") * ll_quotpackunits
				ld_quotbonusqty = lds_quotationdetail.getitemnumber(ll_found, "bonusqty") * ll_quotpackunits
				ld_quotprice = round(lds_quotationdetail.getitemnumber(ll_found, "saleprice") / ll_quotpackunits, 2)
			end if
			if ld_quotqty <= 0.0 then
				ld_quotqty = 1
			end if
			ld_qty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
			ld_bonusqty = this.id_detail.getitemnumber(ll_rowcount, "bonusqty")
			ld_bonusfactor = round(ld_qty / ld_quotqty, 4)
			if lb_editbonusqty then
				this.id_detail.setitem(ll_rowcount, "bonusqty", round(ld_bonusfactor * ld_quotbonusqty, 4))
			end if
			if lb_editsaleprice and this.id_detail.getitemstring(ll_rowcount, "locksaleprice") = "N" then
				this.id_detail.setitem(ll_rowcount, "saleprice", ld_quotprice)
			end if
			if lb_editsalediscperc and this.id_detail.getitemstring(ll_rowcount, "lockdiscperc") = "N" then
				this.id_detail.setitem(ll_rowcount, "discperc", ld_quotdiscperc)
			end if
			if lb_edititewflatdisc then
				this.id_detail.setitem(ll_rowcount, "itemflatdisc", ld_quotitemflatdisc)
			end if
		else
			ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname
			ll_notfound_itemcount = ll_notfound_itemcount + 1
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_notfound_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Guidelines Exist for Following " + trim(string(ll_notfound_itemcount)) + " item(s) in Associated Quotation/Pricing Contract~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_advancedsale.wf_save_saleinv_as_text(string as_filename) returns long
	integer li_filehandle
	long ll_counter
	long ll_innercounter
	long ll_rowcount
	string ls_writetofile
	string ls_temp
	li_filehandle = fileopen(as_filename, linemode!, write!, lockwrite!, replace!)
	if li_filehandle > -1 then
		ll_rowcount = this.id_print.rowcount()
		if ll_rowcount > 0 then
			for ll_counter = 1 to 11
				ls_temp = "c_line" + trim(string(ll_counter))
				ls_writetofile = ""
				ls_writetofile = ls_writetofile + this.id_print.getitemstring(1, ls_temp)
				filewrite(li_filehandle, ls_writetofile)
			next
			ll_counter = 0
			for ll_counter = 1 to ll_rowcount
				ls_writetofile = ""
				ls_temp = "rowdetail"
				ls_writetofile = ls_writetofile + this.id_print.getitemstring(ll_counter, ls_temp)
				filewrite(li_filehandle, ls_writetofile)
			next
			for ll_counter = 1 to 16
				ls_writetofile = ""
				ls_temp = "footerrow" + trim(string(ll_counter))
				ls_writetofile = ls_writetofile + this.id_print.getitemstring(1, ls_temp)
				filewrite(li_filehandle, ls_writetofile)
			next
		end if
		fileclose(li_filehandle)
		return 1
	end if
	return 0

// w_advancedsale.wf_select_draft_printout(long al_invcode) returns long
	string ls_report
	string ls_filename
	long ll_row
	long ll_retcode
	return ll_retcode

// w_advancedsale.wf_custominfo_view() returns 0
	long ll_custcode
	if this.id_master.rowcount() > 0 then
		ll_custcode = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		if ll_custcode > 0 and not isnull(ll_custcode) then
			openwithparm(w_customerinfo_view, ll_custcode)
		end if
	end if

// w_advancedsale.wf_check_creditlimit(long al_custcode, long al_usercode, integer ai_mode) returns long
	double ld_grandtotal
	double ld_crlimit
	double ld_balance
	double ld_unpostedbal
	long ll_retcode
	long ll_option = 2
	long ll_groupcode
	long ll_rightallowed
	string ls_msg
	string ls_msgtitle = "Customer Credit Limit Validation!"
	if this.ii_saletype = 2 then
		ll_groupcode = f_getgroupcode(al_usercode)
		if f_stringpreferences("CheckCrLimitInCrSales") = "Y" and this.ii_saletype = 2 then
			ld_grandtotal = wf_grandtotal()
			SQL SELECT RightAllowed =ISNULL ( ( SELECT MAX ( 1 ) FROM GroupRights WHERE GroupCode =:ll_groupcode AND RightCode =611 ) , 0 ) , CrLimit =ISNULL ( CrLimit , 0 ) , Balance =ISNULL ( ( SELECT SUM ( Debit - Credit ) FROM VirtualGL WHERE AccCode =:al_custcode ) , 0 ) , UnpostedBal =ISNULL ( ( SELECT SUM ( S.InvTotal ) FROM AdvSaleLedger S WHERE S.CustCode =:al_custcode AND S.SaleCatCode =:this.ii_saletype AND S.Posted ='N' GROUP BY S.CustCode ) , 0 ) INTO :ll_rightallowed, :ld_crlimit, :ld_balance, :ld_unpostedbal FROM Customer WHERE CustCode =:al_custcode USING sqlca;
			if sqlca.sqlcode = 0 then
				if ld_balance + ld_unpostedbal + ld_grandtotal > ld_crlimit then
					ls_msg = "Total Recivable From Customer Exceeds Credit Limit~r~n~r~n" + "Previous Balance    : ~t~t" + string(ld_balance, "###,###,###0.00") + "~r~n" + "Un-Posted Invoices Value: ~t~t" + string(ld_unpostedbal, "###,###,###0.00") + "~r~n" + "This Invoice Amount: ~t~t" + string(ld_grandtotal, "###,###,###0.00") + "~r~n" + "Total Receivable: ~t~t~t" + string(ld_balance + ld_grandtotal + ld_unpostedbal, "###,###,###0.00") + "~r~n" + "Credit Limit: ~t~t~t" + string(ld_crlimit, "###,###,###0.00") + "~r~n"
					if ai_mode = 0 then
						messagebox(ls_msgtitle, ls_msg, information!, ok!)
						ll_option = 1
					elseif ll_rightallowed = 1 then
						ls_msg = ls_msg + "~r~nContinue Anyway?"
						ll_option = messagebox(ls_msgtitle, ls_msg, question!, yesno!, 2)
					else
						messagebox(ls_msgtitle, ls_msg, stopsign!, ok!)
						ll_option = 2
					end if
					if ll_option = 1 then
						ll_retcode = 0
					else
						ll_retcode = 1
					end if
				else
					ll_retcode = 0
				end if
			else
				messagebox("Customer Validation!", "Can not fetch customer credit limit.", stopsign!)
				ll_retcode = 2
			end if
		else
			ll_retcode = 0
		end if
	else
		ll_retcode = 0
	end if
	return ll_retcode

// w_advancedsale.wf_enable_customer_in_cashsale() returns 0
	if this.ii_saletype = 3 then
		if f_stringpreferences("AllowCustomerInCashSale") = "Y" then
			this.id_master.object.custcode.protect = 0
			this.id_master.object.aliasname.protect = 0
			return
		end if
		this.id_master.object.custcode.protect = 1
		this.id_master.object.aliasname.protect = 1
	end if

// w_advancedsale.wf_searchitem_quicksearch(string as_str) returns long
	long ll_found
	long ll_code
	long ll_listcurrrow
	long rt_code = 1
	long ll_row
	long ll_icode
	integer li_errcode
	string ls_errtext
	if as_str = "" or isnull(as_str) then
		rt_code = 0
	else
		ll_code = f_searchitem_quicksearch(as_str, this.it_transobject)
		if ll_code > 0 then
			ll_found = this.id_itemslist.find("icode = " + string(ll_code), 1, this.id_itemslist.rowcount())
			if ll_found > 0 then
				ll_listcurrrow = ll_found
				this.id_itemslist.selectrow(0, false)
				ll_row = this.id_detail.getrow()
				ll_icode = ll_code
				wf_inititeminfo(ll_icode, ll_row, li_errcode, ls_errtext)
				if this.il_currrow > 0 then
					this.id_itemslist.selectrow(this.il_currrow, false)
				end if
				this.id_itemslist.selectrow(ll_listcurrrow, true)
				this.id_detail.setitem(this.id_detail.getrow(), this.is_columnitemname, this.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				this.id_detail.setitem(this.id_detail.getrow(), "icode", this.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				this.id_detail.setitem(this.id_detail.getrow(), "fullcode", this.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
				this.ib_itemvalidated = false
				this.il_currrow = this.id_detail.getrow()
				this.id_detail.setitem(this.id_detail.getrow(), "CurrListRow", ll_listcurrrow)
				rt_code = 0
			end if
		end if
	end if
	return rt_code

// w_advancedsale.wf_print_balance_slip() returns 0
	long ll_invcode
	if this.tab_retrieve.selectedtab = 2 then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(this.id_master.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			return
		end if
	end if
	openwithparm(w_salebalanceqty_slip, ll_invcode)

// w_advancedsale.wf_quotationinuse(long al_quotationcode, ref long al_saleinvno) returns long
	long ll_saleinvcode
	ll_saleinvcode = this.id_master.object.code[this.id_master.getrow()]
	SQL Select AdvSaleInvCode INTO :al_saleinvno From AdvSaleLedger Where QuotationNo =:al_quotationcode And AdvSaleInvCode Not In ( :ll_saleinvcode ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 100 then
		return 0
	end if
	return -1

// w_advancedsale.wf_check_customer(long al_code) returns boolean
	boolean lb_check1 = true
	boolean lb_check2 = true
	if wf_checkunpostedcustomersale(al_code) > 1 then
		lb_check1 = false
	end if
	if lb_check1 = true and wf_checklicenceexpiry(al_code) > 1 then
		lb_check2 = false
	end if
	if lb_check1 = false or lb_check2 = false then
		this.ib_validcustomer = false
	else
		this.ib_validcustomer = true
	end if
	return this.ib_validcustomer

// w_advancedsale.wf_getcustitemcatwisesalesdiscount(long al_icode, long al_custcode, ref double ad_discperc, ref double ad_itemflatdisc) returns boolean
	double ld_null
	setnull(ld_null)
	ad_discperc = ld_null
	SQL SELECT discperc , itemflatdisc INTO :ad_discperc, :ad_itemflatdisc FROM DBO.CustItemCatWiseSaleDiscount WHERE CustCatCode =ISNULL ( ( SELECT Customer.custcatcode FROM dbo.customer Where Customer.custcode =:al_custcode ) , 0 ) AND ICatCode =ISNULL ( ( SELECT Item.icatcode FROM dbo.Item Where Item.Icode =:al_icode ) , 0 ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ad_discperc) or isnull(ad_itemflatdisc) then
			return false
		else
			return true
		end if
		return
	end if
	return false

// w_advancedsale.wf_show_associated_master() returns 0
	long ll_row
	long ll_icode
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ll_row = this.id_detail.getrow()
		if ll_row > 0 then
			ll_icode = this.id_detail.getitemnumber(ll_row, "icode")
			if ll_icode > 0 then
				openwithparm(w_view_associated_itempart, ll_icode)
			end if
		end if
	end if

// w_advancedsale.wf_show_godownwisestock() returns long
	long ll_found
	long ll_retcode
	long ll_icode
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 615", 1, gds_securitywindow.rowcount())
	if ll_found > 0 and this.id_detail.getrow() > 0 and not isnull(this.id_detail.object.icode[this.id_detail.getrow()]) then
		ll_icode = this.id_detail.object.icode[this.id_detail.getrow()]
		openwithparm(w_view_godownwiseitemstock, ll_icode)
	end if
	return ll_retcode

// w_advancedsale.wf_populate_manfcatwise_items() returns long
	long ll_totalrows
	long ll_rowcount
	integer li_counter
	integer li_retcode = 1
	integer li_errcode
	string ls_errortext
	boolean lb_enablesave
	datastore lds_manfcatwise_items
	s_arguements lstr_arg
	if wf_iseditable() = false then
		return 0
	end if
	open(w_arg_manufacturercategory_v2)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		openwithparm(w_arg_manufacturers_manfcatfilter, lstr_arg)
		lstr_arg = message.powerobjectparm
		setredraw(false)
		lds_manfcatwise_items = create datastore
		lds_manfcatwise_items.dataobject = "d_manfcatwise_items"
		lds_manfcatwise_items.settransobject(this.it_transobject)
		ll_totalrows = lds_manfcatwise_items.retrieve(lstr_arg.ia_integerlist)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_manfcatwise_items.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_manfcatwise_items.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_manfcatwise_items.getitemnumber(ll_rowcount, "stock"))
		next
		setredraw(true)
		if lb_enablesave then
			this.im_menu.m_file.m_save.enabled = true
			this.im_menu.m_file.m_print.enabled = true
		end if
	end if
	return 0

// w_advancedsale.wf_populate_postedsaleinv_headerwise() returns long
	datastore lds_saledetail
	s_arguements lstr_arg
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_custcode
	long ll_counter
	long ll_headerno
	integer li_retcode = 1
	integer li_errcode
	string ls_errortext
	boolean lb_enablesave
	boolean lb_bonus
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	if isnull(ll_custcode) or ll_custcode = 0 then
		messagebox("Customer Validation", "Can not populate sale invoices~r~nPlease Select Valid Customer")
		this.id_master.setcolumn("custcode")
		this.id_master.setfocus()
		return -1
	end if
	open(w_arg_header)
	lstr_arg = message.powerobjectparm
	ll_headerno = lstr_arg.l_code1
	lstr_arg.l_code2 = ll_custcode
	if f_stringpreferences("BonusInSale") = "Y" then
		lb_bonus = true
	end if
	if wf_iseditable() = false then
		return 0
	end if
	lds_saledetail = create datastore
	lds_saledetail.dataobject = "d_postedsale_for_population"
	lds_saledetail.settransobject(this.it_transobject)
	openwithparm(w_populate_saleinvoices_header, lstr_arg)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		if lstr_arg.i_supress then
			this.id_master.setitem(this.id_master.rowcount(), "remarks", lstr_arg.s_name2)
		end if
		ll_totalrows = lds_saledetail.retrieve(lstr_arg.ia_integerlist, lstr_arg.s_name1)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saledetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		ll_counter = 0
		ll_detailrows = this.id_detail.rowcount()
		for ll_counter = 1 to ll_detailrows
			event ue_deleteitem()
		next
		ll_counter = 0
		for ll_rowcount = 1 to ll_totalrows
			ll_counter = this.id_detail.insertrow(0)
			if wf_inititeminfo(lds_saledetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext) then
				this.id_detail.setitem(ll_counter, "icode", lds_saledetail.getitemnumber(ll_rowcount, "icode"))
				this.id_detail.setitem(ll_counter, "gcode", lds_saledetail.getitemnumber(ll_rowcount, "gcode"))
				this.id_detail.setitem(ll_counter, "looseqty", lds_saledetail.getitemnumber(ll_rowcount, "looseqty"))
				this.id_detail.setitem(ll_counter, "packunits", lds_saledetail.getitemnumber(ll_rowcount, "packunits"))
				this.id_detail.setitem(ll_counter, "saleprice", lds_saledetail.getitemnumber(ll_rowcount, "saleprice"))
				this.id_detail.setitem(ll_counter, "avgprice", lds_saledetail.getitemnumber(ll_rowcount, "avgprice"))
				this.id_detail.setitem(ll_counter, "rate", lds_saledetail.getitemnumber(ll_rowcount, "rate"))
				this.id_detail.setitem(ll_counter, "discperc", lds_saledetail.getitemnumber(ll_rowcount, "discperc"))
				this.id_detail.setitem(ll_counter, "itemflatdisc", lds_saledetail.getitemnumber(ll_rowcount, "itemflatdisc"))
				this.id_detail.setitem(ll_counter, "saleitemdescription", lds_saledetail.getitemstring(ll_rowcount, "saleitemdescription"))
				this.id_detail.setitem(ll_counter, "packprice", lds_saledetail.getitemnumber(ll_rowcount, "packprice"))
				this.id_detail.setitem(ll_counter, "unitsalestax", lds_saledetail.getitemnumber(ll_rowcount, "unitsalestax"))
				this.id_detail.setitem(ll_counter, "gstperc", lds_saledetail.getitemnumber(ll_rowcount, "gstperc"))
				this.id_detail.setitem(ll_counter, "packqtyforsale", lds_saledetail.getitemnumber(ll_rowcount, "packqtyforsale"))
				this.id_detail.setitem(ll_counter, "sourcesaleinvcode", lds_saledetail.getitemnumber(ll_rowcount, "sourcesaleinvcode"))
				this.id_detail.setitem(ll_counter, "salerowid", lds_saledetail.getitemnumber(ll_rowcount, "salerowid"))
				if lb_bonus = true then
					this.id_detail.setitem(ll_counter, "bonusqty", lds_saledetail.getitemnumber(ll_rowcount, "bonusqty"))
					this.id_detail.setitem(ll_counter, "bonuspackqtyforsale", lds_saledetail.getitemnumber(ll_rowcount, "bonuspackqtyforsale"))
				else
					this.id_detail.setitem(ll_counter, "bonusqty", 0)
					this.id_detail.setitem(ll_counter, "bonuspackqtyforsale", 0)
				end if
			else
				event ue_deleteitem()
			end if
		next
	else
		li_retcode = -1
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	destroy lds_saledetail
	return li_retcode

// w_advancedsale.wf_edit_issue() returns long
	datastore lds_issuedetail
	datastore lds_issueheader
	s_saletemplate lstr_template
	string ls_errortext
	string ls_itemdesc
	boolean lb_enablesave
	boolean lb_insertrow
	integer li_retcode = 1
	integer li_errcode
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_counter
	long ll_tmprowid
	long ll_tmpcode
	long ll_found
	long ll_packunits
	double ld_issueprice
	double ld_tmpqty
	double ld_issueqty
	if wf_iseditable() = false then
		return 0
	end if
	if this.ib_modify and this.id_master.getitemnumber(1, "code") > 0.0 and this.id_master.getitemstring(1, "Posted") = "Y" then
		return 0
	end if
	lds_issuedetail = create datastore
	lds_issueheader = create datastore
	open(w_edit_customer_issue_posted)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_issuedetail.dataobject = "d_populate_issue"
		lds_issuedetail.settransobject(this.it_transobject)
		lds_issueheader.dataobject = "d_issueheader"
		lds_issueheader.settransobject(this.it_transobject)
		ll_row = lds_issueheader.retrieve(lstr_template.l_invtemplate)
		lds_issuedetail.retrieve(lstr_template.l_invtemplate)
		ll_totalrows = lds_issueheader.retrieve(lstr_template.l_invtemplate)
		if ll_row <= 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_issuedetail.rowcount()
		if ll_totalrows > 0 and li_retcode > 0 then
			lb_enablesave = true
		end if
		if lb_enablesave then
			ll_mrow = this.id_master.getrow()
			this.id_master.setitem(ll_mrow, "custcode", lds_issueheader.getitemnumber(lds_issueheader.getrow(), "acccode"))
			this.id_master.setitem(ll_mrow, "sprice", lds_issueheader.getitemnumber(lds_issueheader.getrow(), "pricetypecode"))
			this.id_master.setitem(ll_mrow, "remarks", lds_issueheader.getitemstring(lds_issueheader.getrow(), "remarks"))
			wf_deleteallemptydetailrows()
			if lstr_template.b_userinput = true then
				for ll_rowcount = 1 to this.id_detail.rowcount()
					event ue_deleteitem()
				next
				this.id_detail.reset()
			end if
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				lb_insertrow = false
				ld_tmpqty = 0
				ll_packunits = lds_issuedetail.getitemnumber(ll_counter, "packunits")
				if ll_packunits = 0 then
					ll_packunits = 1
				end if
				ll_found = 0
				if lstr_template.b_userinput = false then
					ll_found = this.id_detail.find("Issuerowid=" + string(lds_issuedetail.getitemnumber(ll_counter, "issuerowid")) + " AND icode=" + string(lds_issuedetail.getitemnumber(ll_counter, "icode")), 1, this.id_detail.rowcount())
				end if
				if ll_found <= 0 then
					ld_issueqty = lds_issuedetail.getitemnumber(ll_counter, "qty")
					ld_issueprice = lds_issuedetail.getitemnumber(ll_counter, "price")
					ll_tmprowid = lds_issuedetail.getitemnumber(ll_counter, "issuerowid")
					ls_itemdesc = lds_issuedetail.getitemstring(ll_counter, "itemdescription")
					if lstr_template.i_invtype = 0 then
						lb_insertrow = true
					else
						if this.ib_modify and this.id_master.getitemnumber(1, "code") > 0.0 then
							ll_tmpcode = this.id_master.getitemnumber(1, "code")
							SQL SELECT sum ( looseqty ) INTO :ld_tmpqty FROM SaleInvDetail WHERE IssueRowID =:ll_tmprowid AND SaleInvCode =:ll_tmpcode USING sqlca;
							if sqlca.sqlcode <> 0 then
								lb_insertrow = false
							end if
						end if
						if isnull(ld_tmpqty) then
							ld_tmpqty = 0
						end if
						if ld_issueqty - lds_issuedetail.getitemnumber(ll_counter, "saleqty") + ld_tmpqty > 0.0 then
							lb_insertrow = true
						else
							lb_insertrow = false
						end if
					end if
					if lb_insertrow = true then
						ll_rowcount = this.id_detail.insertrow(0)
						ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_issuedetail.getitemnumber(ll_counter, "gcode")), 1, this.idc_godown.rowcount())
						if ll_validgodowncode = 0 or this.il_strategy = 2 or this.il_godowncount = 1 then
							wf_inititeminfo(lds_issuedetail.getitemnumber(ll_counter, "icode"), ll_rowcount, li_errcode, ls_errortext)
						else
							ll_gcode = lds_issuedetail.getitemnumber(ll_counter, "gcode")
							this.id_detail.setitem(ll_rowcount, "gcode", ll_gcode)
							wf_inititeminfo_quotation(lds_issuedetail.getitemnumber(ll_counter, "icode"), ll_rowcount, li_errcode, ls_errortext, ll_gcode)
						end if
						this.id_detail.setitem(ll_rowcount, "Issuerowid", ll_tmprowid)
						this.id_detail.setitem(ll_rowcount, "packunits", ll_packunits)
						this.id_detail.setitem(ll_rowcount, "saleprice", ld_issueprice)
						this.id_detail.setitem(ll_rowcount, "saleitemdescription", ls_itemdesc)
						if lstr_template.i_invtype = 0 then
							this.id_detail.setitem(ll_rowcount, "looseqty", ld_issueqty)
						else
							ld_tmpqty = ld_issueqty - lds_issuedetail.getitemnumber(ll_counter, "saleqty") + ld_tmpqty
							if ld_tmpqty > 0.0 then
								this.id_detail.setitem(ll_rowcount, "looseqty", ld_tmpqty)
							end if
						end if
					end if
				end if
			next
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return li_retcode

// w_advancedsale.wf_setiteminfo(long al_icode, long al_row, double ad_saleprice, double ad_discperc, double ad_stock, double ad_avgprice, double ad_totalstock, double ad_purdiscperc) returns 0
	this.id_detail.setitem(al_row, "saleprice", ad_saleprice)
	if this.ii_saletype = 2 then
		this.id_detail.setitem(al_row, "discperc", ad_discperc)
	else
		this.id_detail.setitem(al_row, "discperc", 0.0)
	end if
	this.id_detail.setitem(al_row, "rate", ad_saleprice)
	this.id_detail.setitem(al_row, "avgprice", ad_avgprice)
	this.id_footer.object.icode[this.id_footer.getrow()] = al_icode
	this.id_footer.object.stock[this.id_footer.getrow()] = ad_stock

// w_advancedsale.wf_selectitembatches(long al_gcode, long al_icode, double ad_qty, double ad_bonus, ref datawindow ad_itemsdetail, ref long al_rowscount, ref string al_errortext) returns integer
	datastore lds_itemstockinfo
	long ll_counter
	long ll_detailrowcount
	double ld_saleqty
	double ld_reqqty
	double ld_totalstock
	double ld_batchqty
	double ld_bonusqty
	integer li_errcode
	datetime ldt_null
	lds_itemstockinfo = create datastore
	lds_itemstockinfo.dataobject = "d_itemstockinfo"
	lds_itemstockinfo.settransobject(this.it_transobject)
	setnull(ldt_null)
	if lds_itemstockinfo.retrieve(al_gcode, al_icode) > 0 then
		ld_totalstock = lds_itemstockinfo.getitemnumber(1, "c_totalstock")
	else
		ld_totalstock = 0
	end if
	ll_detailrowcount = ad_itemsdetail.insertrow(0)
	ad_itemsdetail.setitem(ll_detailrowcount, "gcode", al_gcode)
	ad_itemsdetail.setitem(ll_detailrowcount, "icode", al_icode)
	ad_itemsdetail.setitem(ll_detailrowcount, "batch", ".")
	ad_itemsdetail.setitem(ll_detailrowcount, "expiry", relativedate(today(), 365))
	ad_itemsdetail.setitem(ll_detailrowcount, "manfdate", ldt_null)
	ad_itemsdetail.setitem(ll_detailrowcount, "stock", ld_totalstock)
	ad_itemsdetail.setitem(ll_detailrowcount, "totalstock", ld_totalstock)
	ad_itemsdetail.setitem(ll_detailrowcount, "looseqty", ad_qty)
	ad_itemsdetail.setitem(ll_detailrowcount, "bonusqty", ad_bonus)
	al_rowscount = ll_detailrowcount
	destroy lds_itemstockinfo
	return li_errcode

// w_advancedsale.wf_customer_top_sellingitems() returns long
	s_itemsalehistory ls_itemsalehistory
	if this.id_master.rowcount() > 0 and this.id_master.getitemnumber(this.id_master.getrow(), "custcode") > 0.0 then
		ls_itemsalehistory.ar_icode = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		openwithparm(w_customer_top_sellingitems, ls_itemsalehistory)
	end if
	return 0

// w_advancedsale.wf_print_storesummary(long al_invcode) returns long
	long ll_retcode
	datastore lds_storesummary
	if f_stringpreferences("PrintStoreSummWithSInv") = "N" then
		return 0
	end if
	lds_storesummary = create datastore
	lds_storesummary.dataobject = "d_storekeepersummary_withsales"
	lds_storesummary.settransobject(this.it_transobject)
	ll_retcode = lds_storesummary.retrieve(al_invcode, this.il_groupcode)
	if ll_retcode > 0 then
		lds_storesummary.print()
	end if
	return 0

// w_advancedsale.wf_view_iteminfo() returns 0
	long ll_code
	if this.tab_retrieve.selectedtab = 2 then
		return
	end if
	if this.id_detail.rowcount() > 0 and this.id_detail.getrow() > 0 then
		ll_code = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		if ll_code > 0 and not isnull(ll_code) then
			openwithparm(w_iteminfo, ll_code)
		end if
	end if

// w_advancedsale.wf_isolatebonusqty(ref datawindow adw_itemdetail) returns long
	long ll_tmpcounter
	long ll_tmpcount
	long ll_detailrows
	long ll_row
	double ld_bonusqty
	double ll_looseqty
	datastore lds_itemdetail
	ll_row = 0
	if f_stringpreferences("IsolateBonusInSale") = "Y" and f_stringpreferences("AllowDupItemsInSale") = "Y" then
		lds_itemdetail = create datastore
		lds_itemdetail.dataobject = this.id_detail.dataobject
		lds_itemdetail.settransobject(this.it_transobject)
		ll_detailrows = adw_itemdetail.rowcount()
		adw_itemdetail.rowsmove(1, ll_detailrows, primary!, lds_itemdetail, 1, primary!)
		ll_tmpcount = lds_itemdetail.rowcount()
		for ll_tmpcounter = 1 to ll_tmpcount
			ll_row = ll_row + 1
			lds_itemdetail.rowscopy(ll_tmpcounter, ll_tmpcounter, primary!, adw_itemdetail, ll_row, primary!)
			ll_looseqty = lds_itemdetail.object.looseqty[ll_tmpcounter]
			ld_bonusqty = lds_itemdetail.object.bonusqty[ll_tmpcounter]
			if ld_bonusqty > 0.0 and ll_looseqty > 0.0 then
				adw_itemdetail.object.bonusqty[adw_itemdetail.rowcount()] = 0
				ll_row = ll_row + 1
				lds_itemdetail.rowscopy(ll_tmpcounter, ll_tmpcounter, primary!, adw_itemdetail, ll_row, primary!)
				adw_itemdetail.object.looseqty[adw_itemdetail.rowcount()] = 0
				adw_itemdetail.object.unitsalestax[adw_itemdetail.rowcount()] = 0
				adw_itemdetail.object.gstperc[adw_itemdetail.rowcount()] = 0
			end if
		next
		destroy lds_itemdetail
	end if
	return 0

// w_advancedsale.wf_set_itemtotal_formatmask() returns long
	string ls_modify
	string ls_format
	ls_format = trim(f_stringpreferences("FormatForAmtInSale"))
	ls_modify = "c_itemtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_detaildwtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_finalitemval.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_sumfinalitemval.Format='" + ls_format + "'  "
	this.id_detail.modify(ls_modify)
	return 0

// w_advancedsale.wf_setpatientinfo(long al_patientcode) returns long
	long ll_recurringperiod
	SQL SELECT RecurringPeriod INTO :ll_recurringperiod FROM Patient WHERE PatientCode =:al_patientcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		return 1
	end if
	return 0

// w_advancedsale.wf_populate_patient_recurring_invoices() returns long
	datastore lds_saledetail
	s_saletemplate lstr_template
	integer li_retcode = 1
	integer li_errcode
	integer li_counter
	integer ll_found
	integer ll_innercounter
	integer li_holdqty
	integer li_addbonusinqty
	integer ll_patientcode
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrows
	long ll_masterrow
	double ld_looseqty
	double ld_holdbonusqty
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	boolean lb_bonus
	boolean lb_salepricefromtemplate
	datawindowchild ldc_godown
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	if ll_masterrow <= 0 then
		return 0
	end if
	ll_patientcode = this.id_master.object.patientcode[ll_masterrow]
	if ll_patientcode <= 0 or isnull(ll_patientcode) then
		messagebox("Patient Validation!", "Please Select a valid Patient")
		return 0
	end if
	lds_saledetail = create datastore
	openwithparm(w_populate_patient_recurring_invoices, ll_patientcode)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		destroy lds_saledetail
		return -1
	end if
	if f_stringpreferences("BonusInSale") = "Y" then
		lb_bonus = true
	end if
	if lstr_template.c_copyinvfrom = "I" then
		lds_saledetail.dataobject = this.id_detail.dataobject
		lds_saledetail.settransobject(this.it_transobject)
		li_retcode = lds_saledetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		ll_totalrows = lds_saledetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saledetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		this.id_master.setitem(ll_masterrow, "recurringagainst", lstr_template.l_invtemplate)
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saledetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saledetail.getitemnumber(ll_rowcount, "looseqty"))
			if lb_bonus then
				this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saledetail.getitemnumber(ll_rowcount, "bonusqty"))
			end if
		next
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	destroy lds_saledetail
	return li_retcode

// w_advancedsale.wf_populate_visit_prescription() returns long
	datastore lds_visitprescriptdetail
	s_saletemplate lstr_template
	boolean lb_enablesave
	boolean lb_insertrow
	integer li_retcode
	integer li_errcode
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_counter
	long ll_tmprowid
	long ll_tmpcode
	long ll_icode
	double ld_tmpqty
	double ld_tmpbonus
	string ls_errortext
	if wf_iseditable() = false then
		return 0
	end if
	if this.ii_saletype <> 3 then
		return 0
	end if
	lds_visitprescriptdetail = create datastore
	open(w_edit_visitprescription)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_visitprescriptdetail.dataobject = "d_visit_prescription"
		lds_visitprescriptdetail.settransobject(this.it_transobject)
		ll_row = lds_visitprescriptdetail.retrieve(lstr_template.l_invtemplate)
		if ll_row <= 0 then
			li_retcode = -1
		else
			ll_mrow = this.id_master.getrow()
			this.id_master.setitem(ll_mrow, "VisitCode", lstr_template.l_invtemplate)
			if this.ii_saletype = 3 then
				this.id_master.setitem(ll_mrow, "custcode", 19)
			end if
		end if
		ll_totalrows = lds_visitprescriptdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		if lb_enablesave then
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
			this.id_detail.reset()
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				lb_insertrow = false
				ld_tmpqty = 0
				ld_tmpbonus = 0
				ll_rowcount = this.id_detail.insertrow(0)
				ll_icode = lds_visitprescriptdetail.getitemnumber(ll_counter, "icode")
				if wf_inititeminfo(ll_icode, ll_rowcount, li_errcode, ls_errortext) then
					ll_gcode = this.id_detail.object.gcode[ll_rowcount]
					if wf_set_godown_item_stock(ll_gcode, ll_icode, ll_rowcount, ls_errortext) = 0 then
						this.id_detail.setitem(ll_rowcount, "looseqty", lds_visitprescriptdetail.getitemnumber(ll_counter, "totalqty"))
					end if
				end if
			next
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return li_retcode

// w_advancedsale.wf_getitemdiscounts(long al_icode, long al_custcode, ref double ad_salediscperc, ref double ad_maxsalediscperc) returns long
	long ll_retcode
	SQL SELECT SaleDiscPerc =CASE ( SELECT DefaultItemDiscPerc FROM DBO.Customer WHERE CustCode =:al_custcode ) WHEN 1 THEN SaleDiscPerc WHEN 2 THEN SaleDiscPerc2 WHEN 3 THEN SaleDiscPerc3 WHEN 4 THEN SaleDiscPerc4 WHEN 5 THEN SaleDiscPerc5 ELSE 0 END , MaxSaleDiscPerc INTO :ad_salediscperc, :ad_maxsalediscperc FROM item WHERE ICode =:al_icode USING sqlca;
	if sqlca.sqlcode = 0 then
		ll_retcode = 0
	else
		ll_retcode = -1
	end if
	return ll_retcode

// w_advancedsale.wf_deletesaleinvoice(long al_advsaleinvcode) returns integer
	SQL Delete advsaledetail Where advsaledetail.AdvSaleInvCode =:al_advsaleinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_advancedsale.wf_getsalesstockinfo(long al_advsaleinvcode, long al_gcode, long al_icode, ref double ad_saleqty) returns integer
	SQL Select IsNull ( Sum ( advsaledetail.looseqty + advsaledetail.bonusqty ) , 0 ) INTO :ad_saleqty from advsaledetail where advsaledetail.advsaleinvcode =:al_advsaleinvcode and advsaledetail.gcode =:al_gcode and advsaledetail.icode =:al_icode USING this.it_transobject;
	if isnull(ad_saleqty) then
		ad_saleqty = 0
	end if
	return this.it_transobject.sqlcode

// w_advancedsale.wf_getassocsaleinvlisttotal(ref double ad_invamount) returns long
	long ll_counter
	long ll_saleinvcode
	double ld_invamount
	for ll_counter = 1 to this.id_assocsaleinvlist.rowcount()
		ll_saleinvcode = this.id_assocsaleinvlist.object.saleinvcode[ll_counter]
		ld_invamount = this.it_transobject.getsaleinvtotal(ll_saleinvcode)
		ad_invamount = ad_invamount + ld_invamount
	next
	return 0

// w_advancedsale.wf_set_post_assocsaleinv() returns boolean
	long ll_saleinvcode
	long ll_custcode
	long ll_salecatcode
	long ll_assocsaleinvcode
	long ll_totalrows
	long ll_counter
	long ll_salesmancode = 1
	if this.ib_assocsaleinvlist then
		ll_saleinvcode = this.id_master.object.code[1]
		ll_custcode = this.id_master.object.custcode[1]
		ll_salecatcode = this.id_master.object.salecatcode[1]
		ll_salesmancode = this.id_master.object.salesmancode[1]
		ll_totalrows = this.id_assocsaleinvlist.rowcount()
		for ll_counter = 1 to ll_totalrows
			ll_assocsaleinvcode = this.id_assocsaleinvlist.object.saleinvcode[ll_counter]
			SQL update SaleLedger Set CustCode =:ll_custcode , salecatcode =:ll_salecatcode Where SaleInvCode =:ll_assocsaleinvcode And POSTED ='N' USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Associated SaleInv Updation Error", "Unable to update customer information in Associated SaleInvNo.: " + string(ll_assocsaleinvcode))
				return false
			else
				this.it_transobject.postsaleledger(ll_assocsaleinvcode, ll_assocsaleinvcode, ll_salecatcode, ll_salesmancode, ll_custcode, 0, "Y")
				if this.it_transobject.sqlcode <> 0 then
					messagebox("Associated SaleInv Posting Error", "Posting Error in Associated SaleInvNo.: " + string(ll_assocsaleinvcode) + "~r~nReasons are: " + this.it_transobject.sqlerrtext)
					return false
				end if
			end if
		next
		this.it_transobject.postadvsaleledger(ll_saleinvcode, ll_saleinvcode, ll_salesmancode, ll_custcode, 0)
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Advanced Sale Inv Posting Error", "Posting Error in Advanced Sale Inv No.: " + string(ll_saleinvcode) + "~r~nReasons are: " + this.it_transobject.sqlerrtext)
			return false
		end if
		return
	end if
	return true

// w_advancedsale.wf_setamountoninvoice(double ad_amt) returns long
	long ll_null
	long ll_rightfound
	double ld_netamt
	double ld_null
	string ls_null
	s_advancedsaleamount lstr_amountoninvoice
	setnull(ld_null)
	setnull(ls_null)
	setnull(ll_null)
	if ad_amt = 0.0 or isnull(ad_amt) then
		ld_netamt = wf_grandtotal()
	else
		ld_netamt = ad_amt
	end if
	if f_stringpreferences("CashierWindowOnPOS") = "Y" then
		lstr_amountoninvoice.l_invcode = this.id_master.getitemnumber(1, "code")
		lstr_amountoninvoice.d_netamt = ld_netamt
		lstr_amountoninvoice.d_cashtendered = this.id_master.getitemnumber(1, "cashtendered")
		lstr_amountoninvoice.d_cashamt = this.id_master.getitemdecimal(1, "cashamt")
		lstr_amountoninvoice.d_creditamt1 = this.id_master.getitemdecimal(1, "creditamt1")
		lstr_amountoninvoice.d_creditamt2 = this.id_master.getitemdecimal(1, "creditamt2")
		lstr_amountoninvoice.d_creditamt3 = this.id_master.getitemdecimal(1, "creditamt3")
		lstr_amountoninvoice.l_credit1acccode = this.id_master.getitemnumber(1, "credit1acccode")
		lstr_amountoninvoice.l_credit2acccode = this.id_master.getitemnumber(1, "credit2acccode")
		lstr_amountoninvoice.l_credit3acccode = this.id_master.getitemnumber(1, "credit3acccode")
		if lstr_amountoninvoice.d_cashtendered > ld_netamt then
			lstr_amountoninvoice.d_cashamt = ld_netamt
		else
			lstr_amountoninvoice.d_cashamt = lstr_amountoninvoice.d_cashtendered
		end if
		if isnull(lstr_amountoninvoice.d_cashamt) or lstr_amountoninvoice.d_cashamt = 0 then
			lstr_amountoninvoice.d_balance = ld_netamt
		else
			lstr_amountoninvoice.d_balance = ld_netamt - lstr_amountoninvoice.d_cashamt - lstr_amountoninvoice.d_creditamt1 - lstr_amountoninvoice.d_creditamt2 - lstr_amountoninvoice.d_creditamt3
		end if
		lstr_amountoninvoice.s_module = "sales"
		openwithparm(w_advancedsaleamount, lstr_amountoninvoice)
		lstr_amountoninvoice = message.powerobjectparm
		if lstr_amountoninvoice.i_status = 1 then
			this.id_master.setitem(1, "cashtendered", lstr_amountoninvoice.d_cashtendered)
			this.id_master.setitem(1, "cashamt", lstr_amountoninvoice.d_cashamt)
			this.id_master.setitem(1, "creditamt1", lstr_amountoninvoice.d_creditamt1)
			this.id_master.setitem(1, "creditamt2", lstr_amountoninvoice.d_creditamt2)
			this.id_master.setitem(1, "creditamt3", lstr_amountoninvoice.d_creditamt3)
			this.id_master.setitem(1, "credit1acccode", lstr_amountoninvoice.l_credit1acccode)
			this.id_master.setitem(1, "credit2acccode", lstr_amountoninvoice.l_credit2acccode)
			this.id_master.setitem(1, "credit3acccode", lstr_amountoninvoice.l_credit3acccode)
		end if
	else
		lstr_amountoninvoice.i_status = 0
		this.id_master.setitem(1, "cashtendered", 0)
		this.id_master.setitem(1, "cashamt", 0)
		this.id_master.setitem(1, "creditamt1", 0)
		this.id_master.setitem(1, "creditamt2", 0)
		this.id_master.setitem(1, "creditamt3", 0)
		this.id_master.setitem(1, "credit1acccode", 0)
		this.id_master.setitem(1, "credit2acccode", 0)
		this.id_master.setitem(1, "credit3acccode", 0)
	end if
	return lstr_amountoninvoice.i_status

// w_advancedsale.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_advsalemenu" then
		this.menuid = create m_advsalemenu
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	this.dw_saleinvdetail = create dw_saleinvdetail
	this.dw_refusedsaleheader = create dw_refusedsaleheader
	this.dw_refusedsaledetail = create dw_refusedsaledetail
	this.dw_itemassociation = create dw_itemassociation
	this.dw_receivable_adjdetail = create dw_receivable_adjdetail
	this.ic_comport = create ic_comport
	this.ic_drawerport = create ic_drawerport
	this.ic_cashdrawerprinter = create ic_cashdrawerprinter
	this.dw_assocsaleinvlist = create dw_assocsaleinvlist
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.dw_saleinvdetail
	this.control[icurrent + 3] = this.dw_refusedsaleheader
	this.control[icurrent + 4] = this.dw_refusedsaledetail
	this.control[icurrent + 5] = this.dw_itemassociation
	this.control[icurrent + 6] = this.dw_receivable_adjdetail
	this.control[icurrent + 7] = this.ic_comport
	this.control[icurrent + 8] = this.ic_drawerport
	this.control[icurrent + 9] = this.ic_cashdrawerprinter
	this.control[icurrent + 10] = this.dw_assocsaleinvlist

// w_advancedsale.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.dw_saleinvdetail
	destroy this.dw_refusedsaleheader
	destroy this.dw_refusedsaledetail
	destroy this.dw_itemassociation
	destroy this.dw_receivable_adjdetail
	destroy this.ic_comport
	destroy this.ic_drawerport
	destroy this.ic_cashdrawerprinter
	destroy this.dw_assocsaleinvlist

// w_advancedsale.ue_save() returns 0 [event]
	datastore lds_groupdiscinfo
	double ld_itemflatdisc
	double ld_unitsalestax
	double ld_itemgstperc
	double ld_invdisc
	double ld_invgstperc
	double ld_itemamount
	double ld_amountdiff
	double ld_itemsalediscperc
	double ld_maxitemsalediscperc
	double ld_clonesaleprice
	boolean lb_validdisc
	long ll_detailrows
	long ll_counter2
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode
	long ll_gcode
	long ll_headerno
	long ll_headerinvno
	long ll_counter
	long ll_count
	long ll_null
	long ll_modifycount
	long ll_lastinvcode
	long ll_customerallowed
	long ll_found
	long ll_rightfound
	long ll_rowgroup
	long ll_refusedsaleresult
	long ll_saveresult = -1
	boolean lb_commitflag = true
	boolean lb_continue = true
	integer li_counter
	integer li_filehandle
	integer li_maxretcode
	string ls_errtext
	string ls_holdstring
	string ls_drawermessage
	string ls_askuserpwd
	string ls_reccurringmsg
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_invamount
	double ld_cashtended
	double ld_cashbalance
	double ld_invgstperc1
	double ld_price
	double ld_refundamt
	double ld_balance
	long ll_custcode
	long ll_allowsalebelowavgprice
	s_salesman lstr_salesman
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	datetime ldt_server_datetime
	string ls_date_errtext
	datawindowchild ldc_headerno
	string ls_lockdiscperc
	string ls_itemname
	string ls_messagetext
	string ls_isnorcotixitem
	string ls_altersaleinvcounter
	string ls_refno
	long ll_dummyinvcode
	s_dw_header lstr_header
	string ls_env_name
	string ls_env_val
	long ll_env_len
	if this.tab_retrieve.selectedtab = 2 then
		return
	end if
	if wf_iseditable() = false then
		return
	end if
	this.ib_lcdshow = false
	if this.id_detail.rowcount() > 0 then
		if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
			this.id_detail.setfocus()
			return
		end if
		if this.ib_godownvalidated = false and wf_validategodown() = -1 then
			return
		end if
		return
	end if
	wf_deleteemptydetailrow()
	if this.ii_saletype = 2 then
		if f_stringpreferences("CreditSaleAllowNullPatient") = "N" then
			this.id_master.object.patientcode.dddw.required = "YES"
		else
			this.id_master.object.patientcode.dddw.required = "NO"
		end if
	end if
	if this.ii_saletype = 3 then
		if f_stringpreferences("CashSaleAllowNullPatient") = "N" then
			this.id_master.object.patientcode.dddw.required = "YES"
		else
			this.id_master.object.patientcode.dddw.required = "NO"
		end if
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("doctnamefornorcotix") = "Y" then
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT antinorcotix , name INTO :ls_isnorcotixitem, :ls_itemname FROM Item WHERE item.icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode < 0 then
				messagebox("Connection Error", "Unable to get item information " + this.it_transobject.sqlerrtext)
				return
			end if
			if ls_isnorcotixitem = "Y" and isnull(this.id_master.getitemstring(1, "remarks")) then
				messagebox("Item Validation", ls_itemname + " " + "is a norcotics item ~r~n please type doctor name in remarks")
				this.id_master.setcolumn("remarks")
				this.id_master.setfocus()
				return
			end if
		next
		setnull(ls_itemname)
	end if
	ll_custcode = this.id_master.getitemnumber(this.id_master.rowcount(), "custcode")
	this.il_custcode = ll_custcode
	this.il_allowedcustomer = ll_custcode
	ll_allowsalebelowavgprice = wf_allow_sale_to_customer_below_avgprice(ll_custcode)
	if ll_allowsalebelowavgprice < 0 then
		messagebox("DataBase Problem", "Reasons: Cannot fecth customer information regarding sale/average price.")
		return
	end if
	if ll_custcode > 0 and this.ib_validcustomer = false and wf_check_customer(ll_custcode) = false and this.ib_validcustomer = false then
		this.id_master.setcolumn("custcode")
		this.id_master.setfocus()
		return
	end if
	if this.ii_saletype = 2 then
		if this.ib_saveasnormalsale = false then
			if f_stringpreferences("UpdSaleUsingCustLatestSale") = "Y" and this.ib_modify = false then
				if wf_setitemdataoncustlatestsale() < 1 then
					messagebox("Item Validation", "Some problem occur while updating the item data using Customer latest sale information for the item.")
					return
				end if
			elseif f_stringpreferences("ModSaleUsingCustLatestSale") = "Y" and this.ib_modify = true and wf_setitemdataoncustlatestsale() < 1 then
				messagebox("Item Validation", "Some problem occur while updating the item data using Customer latest sale information for the item.")
				return
			end if
		else
			this.ib_saveasnormalsale = false
		end if
	end if
	if f_stringpreferences("applycustomerquotationonsaving") = "Y" and wf_apply_associatedquotation(1) <= 0 then
		messagebox("Customer Associated Quotation", "Problem in using associated quotation")
		return
	end if
	if f_stringpreferences("UniqueRefNoInSale") = "Y" then
		ls_refno = this.id_master.getitemstring(1, "custrefno")
		if trim(ls_refno) <> "" and not isnull(ls_refno) and this.ii_saletype = 2 then
			ll_custcode = this.id_master.getitemnumber(1, "custcode")
			ll_counter = 0
			ll_invid = 0
			ll_invid = this.id_master.getitemnumber(1, "code")
			SQL SELECT COUNT ( *) INTO :ll_counter FROM saleledger WHERE custcode =:ll_custcode AND saleledger.saleinvcode <> :ll_invid AND RTrim ( LTrim ( custrefno ) ) =RTrim ( LTrim ( :ls_refno ) ) USING this.it_transobject;
			if ll_counter > 0 then
				messagebox("Ref. validation", "Ref. No " + ls_refno + " already exist for selected customer ~r~nplease type a unique Ref.No. ")
				this.id_master.setcolumn("custrefno")
				this.id_master.setfocus()
				return
			end if
			return
		end if
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	if f_stringpreferences("SaleOnZeroPrice") = "N" then
		ll_found = this.id_detail.find("saleprice = 0 OR ISNull(saleprice)", 1, this.id_detail.rowcount())
		if ll_found > 0 then
			messagebox("Price Validation", "SalePrice is Zero in Row " + string(ll_found))
			this.id_detail.setfocus()
			this.id_detail.scrolltorow(ll_found)
			this.id_detail.setcolumn("SalePrice")
			return
		end if
		return
	end if
	ll_found = this.id_detail.find("looseqty + bonusqty = 0 ", 1, this.id_detail.rowcount())
	if ll_found > 0 then
		messagebox("Sale Qty Validation", "Please Enter Valid Sale Qty in Row " + string(ll_found))
		this.id_detail.setfocus()
		this.id_detail.scrolltorow(ll_found)
		this.id_detail.setcolumn("looseqty")
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if this.ib_assocsaleinvlist then
		if this.ib_modify then
			this.id_assocsaleinvlist.retrieve(this.id_master.object.code[1])
			lstr_header.l_code = this.id_master.object.code[1]
		end if
		lstr_header.dw_header = this.id_assocsaleinvlist
		lstr_header.t_transobject = this.it_transobject
		lstr_header.b_modifystatus = this.ib_modify
		openwithparm(w_assocadvsaleinvlist_form, lstr_header)
		lstr_header = message.powerobjectparm
		if lstr_header.i_closemode = -1 then
			return
		end if
		return
	end if
	wf_grandtotal()
	this.id_footer.accepttext()
	this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
	ld_invamount = this.id_footer.getitemnumber(1, "total")
	wf_getassocsaleinvlisttotal(ld_invamount)
	if this.id_detail.rowcount() = 0 and this.id_assocsaleinvlist.rowcount() = 0 then
		messagebox("Sale Invoice", "Nothing to save on this invoice.~r~nSaving Process Abort", stopsign!)
		return
	end if
	this.is_lcditem = "Total = " + string(wf_grandtotal(), "########0.00")
	this.is_lcditem = this.is_lcditem + space(39 - len(this.is_lcditem))
	this.is_lcditem = left(this.is_lcditem, 39)
	if f_stringpreferences("DisplayPool") = "Y" then
		this.ic_comport.triggerevent("ue_show")
	end if
	ld_invdiscperc = this.id_footer.getitemnumber(1, "invdiscperc")
	ld_flatdisc = this.id_footer.getitemnumber(1, "flatdisc")
	ls_messagetext = ""
	if ld_invdiscperc > 0.0 or ld_flatdisc > 0.0 then
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT lockdiscperc , name INTO :ls_lockdiscperc, :ls_itemname FROM Item WHERE item.icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode < 0 then
				messagebox("Connection Error", "Unable to get item information " + this.it_transobject.sqlerrtext)
				return
			end if
			if ls_lockdiscperc = "Y" then
				ls_messagetext = ls_messagetext + "Row NO=" + string(ll_counter) + " , itemname=" + ls_itemname + "~r~n"
			end if
		next
	end if
	if ls_messagetext <> "" then
		messagebox("Item Validation", "Due to item LockSaleDisc% setting Please remove following items~r~n" + ls_messagetext + "~r~nOR~r~nSet invoice level discount to zero")
		return
	end if
	if wf_setamountoninvoice(ld_invamount) <> 1 then
		return
	end if
	if this.ii_saletype = 2 then
		ls_askuserpwd = "CreditSaleAskUserPassword"
	else
		ls_askuserpwd = "Salesalesmanwindow"
	end if
	if f_stringpreferences(ls_askuserpwd) = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if wf_check_creditlimit(ll_custcode, ll_salesmancode, 1) > 0 then
			return
		end if
		lds_groupdiscinfo = create datastore
		lds_groupdiscinfo.dataobject = "d_groups_discount"
		lds_groupdiscinfo.settransobject(this.it_transobject)
		lds_groupdiscinfo.retrieve(ll_salesmancode)
		ld_invdiscperc = this.id_footer.getitemnumber(1, "invdiscperc")
		ld_flatdisc = this.id_footer.getitemnumber(1, "flatdisc")
		lb_validdisc = false
		for ll_counter = 1 to lds_groupdiscinfo.rowcount()
			if ld_flatdisc <= lds_groupdiscinfo.getitemnumber(ll_counter, "saleinvflatdisc") then
				lb_validdisc = true
			end if
		next
		if lb_validdisc = false then
			messagebox("Flat Discount Validation", "Flat Discount is greater than your permission~r~n Please consult Administrator")
			this.id_footer.setfocus()
			this.id_footer.setcolumn("flatdisc")
			destroy lds_groupdiscinfo
			return
		end if
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
			ld_saleprice = this.id_detail.getitemnumber(ll_counter, "saleprice")
			ld_discperc = this.id_detail.getitemnumber(ll_counter, "discperc")
			ld_itemflatdisc = this.id_detail.getitemnumber(ll_counter, "itemflatdisc")
			ld_unitsalestax = this.id_detail.getitemnumber(ll_counter, "unitsalestax")
			ld_itemgstperc = this.id_detail.getitemnumber(ll_counter, "gstperc")
			ld_invdisc = this.id_footer.getitemnumber(1, "invdiscperc")
			ld_invgstperc = this.id_footer.getitemnumber(1, "invgstperc1")
			ld_avgprice = this.id_detail.getitemnumber(ll_counter, "avgprice")
			ld_itemamount = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2) - round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2) * ld_invdiscperc * 0.01
			ld_amountdiff = ld_saleprice - ld_itemamount
			ld_clonesaleprice = ld_saleprice
			if ld_clonesaleprice = 0.0 or isnull(ld_clonesaleprice) then
				ld_clonesaleprice = 1
			end if
			wf_getitemdiscounts(ll_icode, ll_custcode, ld_itemsalediscperc, ld_maxitemsalediscperc)
			lb_validdisc = false
			if f_stringpreferences("FroceMaxSaleDiscPerc") = "Y" and ld_amountdiff * 100.0 / ld_clonesaleprice > 0.0 then
				if ld_amountdiff * 100.0 / ld_clonesaleprice <= ld_maxitemsalediscperc then
					lb_validdisc = true
				end if
				if lb_validdisc = false then
					messagebox("Disc% Validation", "Disc% is greater than maximum sale discount (%) for this item i.e. " + trim(string(ld_maxitemsalediscperc)) + "%~r~n Please consult Administrator")
					this.id_detail.setfocus()
					this.id_detail.setrow(ll_counter)
					this.id_detail.setcolumn("itemname")
					destroy lds_groupdiscinfo
					return
				end if
				return
			end if
			if f_stringpreferences("saleavgpricecheck") = "N" and ll_allowsalebelowavgprice = 0 and ld_avgprice > ld_itemamount then
				messagebox("Price Validation", "Sale Price become less than AvgPrice~r~nPlease change Sale Price or Setting In Preferences")
				this.id_detail.setrow(ll_counter)
				destroy lds_groupdiscinfo
				return
			end if
			if ld_amountdiff * 100.0 / ld_clonesaleprice > 0.0 then
				lb_validdisc = false
				for ll_counter2 = 1 to lds_groupdiscinfo.rowcount()
					if ld_amountdiff * 100.0 / ld_clonesaleprice <= lds_groupdiscinfo.getitemnumber(ll_counter2, "saleitemdiscperc") then
						lb_validdisc = true
					elseif ld_amountdiff * 100.0 / ld_clonesaleprice <= ld_itemsalediscperc then
						lb_validdisc = true
					else
						lb_validdisc = false
					end if
				next
				if lb_validdisc = false then
					messagebox("Disc% Validation ..", "Disc% is greater than your group permission and~r~nItem Basicdata setting for Sale Discount i.e. " + trim(string(ld_itemsalediscperc)) + "%~r~nPlease consult Administrator")
					this.id_detail.setfocus()
					this.id_detail.setrow(ll_counter)
					this.id_detail.setcolumn("itemname")
					destroy lds_groupdiscinfo
					return
				end if
				return
			end if
		next
		destroy lds_groupdiscinfo
		if this.ii_saletype = 3 and f_stringpreferences("SaleCashWindow") = "Y" then
			ld_invamount = this.id_footer.getitemnumber(1, "total")
			openwithparm(w_salesmanpassword_invtype, ld_invamount)
			setfocus()
			lstr_salesman = message.powerobjectparm
			if lstr_salesman.l_salesmancode < 1 then
				return
			end if
			if lstr_salesman.b_lcd_flag then
				ld_cashtended = lstr_salesman.d_cashtended
				ld_cashbalance = lstr_salesman.d_cashbalance
				this.id_footer.object.t_balance.text = string(ld_cashbalance, "########0.00")
				this.is_lcditem = "Cash   ="
				ls_holdstring = string(ld_cashtended, "########0.00")
				if len(ls_holdstring) < 12 then
					ls_holdstring = ls_holdstring + space(12 - len(ls_holdstring))
				else
					ls_holdstring = left(ls_holdstring, 12)
				end if
				this.is_lcditem = this.is_lcditem + ls_holdstring
				ls_holdstring = string(ld_cashbalance, "########0.00")
				if len(ls_holdstring) < 12 then
					ls_holdstring = ls_holdstring + space(12 - len(ls_holdstring))
				else
					ls_holdstring = left(ls_holdstring, 12)
				end if
				this.is_lcditem = this.is_lcditem + "Balance=" + ls_holdstring
				this.is_lcditem = this.is_lcditem + space(39 - len(this.is_lcditem))
				this.is_lcditem = left(this.is_lcditem, 39)
				if f_stringpreferences("DisplayPool") = "Y" then
					this.ic_comport.triggerevent("ue_show")
				end if
				if f_stringpreferences("CashDrawer") = "Y" then
					this.ic_drawerport.object.portopen = true
					this.ic_drawerport.object.output = "A"
					this.ic_drawerport.object.portopen = false
				end if
			else
				this.id_footer.object.t_balance.text = "0.00"
				this.ib_lcdshow = true
			end if
		end if
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_custcode = this.id_master.getitemnumber(ll_mastercurrrow, "custcode")
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if isnull(ll_invid) then
			li_maxretcode = wf_tabnewid("advsaleledger", ll_invid)
			if li_maxretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~n ~t~t~t~t~t~t~t~t~t~t~t~t~tgenerating InvCode")
				return
			end if
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
		end if
		if this.ib_assocsaleinvlist then
			for ll_counter = 1 to this.id_assocsaleinvlist.rowcount()
				this.id_assocsaleinvlist.object.code[ll_counter] = ll_invid
			next
		end if
		this.id_master.getchild("headerno", ldc_headerno)
		this.id_master.setitem(ll_mastercurrrow, "Headerno", ldc_headerno.getitemnumber(ll_mastercurrrow, "code"))
		ll_headerno = ldc_headerno.getitemnumber(ll_mastercurrrow, "code")
		ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
		if isnull(ll_headerinvno) then
			f_generateheaderinvcode(ll_headerno, this.ii_advancesalemodule, ll_headerinvno)
			if ll_headerinvno > 0 then
				this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
			end if
		end if
		ld_misccharges = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges")
		ld_invdiscperc = this.id_footer.getitemnumber(ll_footercurrrow, "invdiscperc")
		ld_flatdisc = this.id_footer.getitemnumber(ll_footercurrrow, "flatdisc")
		ld_salestax = 0
		ld_invgstperc1 = this.id_footer.getitemnumber(ll_footercurrrow, "InvGSTPerc1")
		ld_refundamt = this.id_footer.getitemnumber(ll_footercurrrow, "refundamt")
		this.id_master.setitem(ll_mastercurrrow, "discperc", ld_invdiscperc)
		this.id_master.setitem(ll_mastercurrrow, "flatdisc", ld_flatdisc)
		this.id_master.setitem(ll_mastercurrrow, "misccharges", ld_misccharges)
		this.id_master.setitem(ll_mastercurrrow, "InvGSTPerc1", ld_invgstperc1)
		this.id_master.setitem(ll_mastercurrrow, "refundamt", ld_refundamt)
		ls_env_name = "COMPUTERNAME"
		ls_env_val = space(20)
		ll_env_len = 20
		ll_env_len = getenvironmentvariablea(ls_env_name, ls_env_val, ll_env_len)
		this.id_master.setitem(ll_mastercurrrow, "machinename", ls_env_val)
		if f_stringpreferences("CreditSalePosting") = "N" then
			this.id_master.setitem(ll_mastercurrrow, "Posted", "N")
		end if
		if this.ib_modify then
			ll_modifycount = this.id_master.getitemdecimal(ll_mastercurrrow, "modifycounter")
			if isnull(ll_modifycount) then
				ll_modifycount = 0
			end if
			this.id_master.setitem(ll_mastercurrrow, "modifycounter", ll_modifycount + 1)
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.idt_server_datetime = ldt_server_datetime
			if lb_continue then
				lb_continue = wf_returnsaleinvoice(ll_invid, ls_errtext)
			end if
		else
			this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.idt_server_datetime = ldt_server_datetime
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
		end if
		if lb_continue then
			this.id_saleinvdetail.reset()
			if not wf_populatesaledetail(ll_invid, this.id_saleinvdetail, ls_errtext, ll_errrowid) then
				lb_continue = false
				this.id_detail.scrolltorow(ll_errrowid)
				this.id_detail.setfocus()
			else
				this.id_detail = this.id_saleinvdetail
				setpointer(hourglass!)
				f_holdon(7)
				ll_saveresult = event ue_save_withnocommit()
				if ll_saveresult = 0 then
					SQL commit USING this.it_transobject;
					messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
					this.ib_commitok = true
					this.id_master.resetupdate()
					this.im_menu.m_file.m_new.enabled = true
					this.editflag = false
					if gd_recenttransdate < this.id_systemdate then
						gd_recenttransdate = this.id_systemdate
					end if
				elseif ll_saveresult = -2 or ll_saveresult = -1 then
					messagebox("Saving Problem", "Changes Not Saved in database due to problem in associated sale invoice.~r~nReasons are:-" + this.it_transobject.sqlerrtext, stopsign!, ok!, 1)
				else
					messagebox("Saving Problem", "Changes Not Saved in database~r~nReasons are:-" + this.it_transobject.sqlerrtext, stopsign!, ok!, 1)
				end if
				this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
				this.id_saleinvdetail.reset()
				if this.ib_commitok then
					this.ib_modify = false
				elseif this.ib_modify = false then
					setnull(ll_null)
					this.id_master.setitem(1, "Code", ll_null)
					this.id_master.accepttext()
				end if
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			if this.ib_modify = false then
				setnull(ll_null)
				this.id_master.setitem(1, "Code", ll_null)
				this.id_master.accepttext()
			end if
			messagebox("Updation Error", ls_errtext + " in current row~r~n" + ls_reccurringmsg, stopsign!)
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_advancedsale.ue_newform() returns 0 [event]
	integer rtncode
	integer li_defaultgcode
	integer li_ismodifysaleprice
	integer li_ismodifyitemdiscperc
	integer li_ismodifyitemflatdisc
	integer li_modifysalestax
	integer li_modifybonusqty
	integer li_viewstock
	integer li_viewtotalstock
	long li_fetched_code
	long row
	long ll_manfcode
	long ll_counter
	long ll_custcode
	double ld_invdiscperc
	datetime ldt_server_datetime
	string ls_date_errtext
	m_advsalemenu lm_menu
	call super::ue_newform
	lm_menu = this.menuid
	this.id_assocsaleinvlist.reset()
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.dw_refusedsaleheader.reset()
	this.dw_refusedsaledetail.reset()
	this.dw_receivable_adjdetail.reset()
	this.il_norcotixcode = -1
	this.im_menu.m_file.m_print.enabled = true
	lm_menu.m_file.m_deletesaleinvoice.enabled = false
	wf_protectdw(this.id_master, 0)
	this.id_detail.setredraw(false)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.id_detail.setredraw(true)
	this.ib_modify = false
	wf_enable_customer_in_cashsale()
	wf_setgodownoption()
	li_ismodifysaleprice = 1
	li_ismodifyitemdiscperc = 1
	li_ismodifyitemflatdisc = 1
	li_modifysalestax = 1
	li_modifybonusqty = 1
	li_viewstock = 0
	li_viewtotalstock = 0
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 511 then
			li_ismodifysaleprice = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 516 then
			li_ismodifyitemdiscperc = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 517 then
			li_ismodifyitemflatdisc = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 520 then
			li_modifysalestax = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 596 then
			li_modifybonusqty = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 535 then
			li_viewstock = 1
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 536 then
			li_viewtotalstock = 1
		end if
	next
	this.id_footer.object.t_stock.visible = li_viewstock
	this.id_footer.object.stock.visible = li_viewstock
	this.id_footer.object.t_totalstock.visible = li_viewtotalstock
	this.id_footer.object.totalstock.visible = li_viewtotalstock
	this.id_detail.object.bonusqty.protect = li_modifybonusqty
	this.id_detail.object.bonuspackqtyforsale.protect = li_modifybonusqty
	this.id_detail.object.saleprice.protect = li_ismodifysaleprice
	this.id_master.object.headerno.protect = 0
	this.id_detail.object.discperc.protect = li_ismodifyitemdiscperc
	this.id_detail.object.itemflatdisc.protect = li_ismodifyitemflatdisc
	this.id_detail.object.unitsalestax.protect = li_modifysalestax
	this.id_detail.object.gstperc.protect = li_modifysalestax
	this.id_footer.setitem(1, "invdiscperc", f_numberpreferences("invdiscperc"))
	if not wf_validatedate() then
		close(this)
	else
		this.id_master.setfocus()
		post event ue_enforcedefaultfocussettings()
		wf_visible(true)
	end if
	if f_stringpreferences("DisplayPool") = "Y" then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
			setnull(this.is_lcditem)
			this.ic_comport.triggerevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
			setnull(this.is_lcditem)
			this.ic_comport.triggerevent("ue_show")
		end if
	end if
	this.ib_lcdshow = true
	this.ii_focuscustomer = 2
	if this.ib_modifydate then
		if this.ib_fetchserverdate then
			wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
			this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
		else
			this.id_master.setitem(this.id_master.getrow(), "date", today())
		end if
	end if
	this.il_custcode = 0
	this.il_allowedcustomer = 0
	this.id_master.setitem(1, "SaleComments1", f_stringpreferences("SaleComments1"))
	this.id_master.setitem(1, "SaleComments2", f_stringpreferences("SaleComments2"))
	this.id_master.setitem(1, "custcode", 19)

// w_advancedsale.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect = 1
	integer li_ismodifysaleprice
	integer li_ismodifyitemdiscperc
	integer li_ismodifyitemflatdisc
	integer li_modifysalestax
	integer li_modifyheaderno
	integer li_modifybonusqty
	long ll_row
	long ll_code
	long ll_counter
	long ll_admissioncode
	long ll_allowed
	long ll_custcode
	long ll_refinvcode
	boolean lb_flag
	boolean lb_modify
	m_advsalemenu lm_menu
	long ll_rowcount
	long ll_validinv
	double ld_code
	lm_menu = this.menuid
	this.tab_retrieve.tabpage_list.em_invno.getdata(ld_code)
	if ld_code = 0.0 then
		ld_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	else
		SQL select count ( *) INTO :ll_validinv from AdvSaleledger where advsaleinvcode =:ld_code USING this.it_transobject;
		if ll_validinv <> 1 then
			this.id_detail.reset()
			messagebox("Invoice Validation", "Invoice does not exist, or ~r~n it does not belong to current sale type")
			this.tab_retrieve.selecttab(2)
			return
		end if
	end if
	if wf_isdeleted(ld_code) = true then
		messagebox("Invoice Validation", "Can not Modify Deleted Sales Invoice")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if wf_isinvoiceinuse(ld_code) = true then
		messagebox("Invoice Validation", "Sale Invoice already in use by some other user.~r~nKindly try again after sometime or open some other invoice.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if wf_allowsalemodification(ld_code, this.il_groupcode, this.il_strategy) <> 0 then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "You Can not modify this Invoice,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	this.dw_refusedsaleheader.reset()
	this.dw_refusedsaledetail.reset()
	if this.ib_askrefusedsale = true and wf_get_refusedsaleinvcode(ld_code, ll_refinvcode) = 0 and ll_refinvcode > 0 then
		this.dw_refusedsaleheader.retrieve(ll_refinvcode)
		this.dw_refusedsaledetail.retrieve(ll_refinvcode)
	end if
	this.dw_receivable_adjdetail.reset()
	this.dw_receivable_adjdetail.retrieve(ld_code)
	if f_stringpreferences("GroupCustomerCategory") = "Y" and this.ii_saletype = 2 then
		SQL Select custcode INTO :ll_custcode From SaleLedger Where saleinvcode =:ld_code USING sqlca;
		ll_allowed = 0
		this.it_transobject.isallowedcustomergroupcategory(this.il_groupcode, ll_custcode, ll_allowed)
		if this.it_transobject.sqlcode = 0 then
			if ll_allowed < 1 then
				this.id_detail.reset()
				messagebox("Group Customer Category Validation", "Current user group does not have enough permissions w.r.t customers~r~n" + "to open the selected invoice.~r~nPossible reasons are selected invoice customer has customer cateogry ~r~n which is not allowed to this user group.")
				wf_selectunselectrow(1)
				this.tab_retrieve.selecttab(2)
				return
			end if
		end if
	end if
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.im_menu.m_file.m_print.enabled = true
	this.i_editmode = 2
	this.i_retrievemode = 2
	this.id_dwcontrol = this.id_master
	ll_rowcount = wf_retrieve(ld_code)
	this.id_master.setrow(1)
	this.id_master.scrolltorow(1)
	this.id_dwcontrol = this.id_footer
	wf_retrieve(ld_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	this.id_dwcontrol = this.id_detail
	wf_retrieve(ld_code)
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	this.id_dwcontrol = this.id_list
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" and (this.ii_saletype = 2 and this.ib_creditmodify) then
		lb_modify = true
	end if
	if not lb_modify then
		this.im_menu.m_file.m_save.enabled = true
		this.editflag = false
	else
		li_protect = 0
		wf_initmodify(li_protect)
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	wf_protectdw(this.dw_refusedsaleheader, li_protect)
	wf_protectdw(this.dw_refusedsaledetail, li_protect)
	if li_protect = 0 then
		wf_enable_customer_in_cashsale()
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_salegodown
	end if
	if li_protect = 0 and this.ii_saletype = 2 and this.id_master.getitemnumber(this.id_master.getrow(), "custcode") = 19.0 then
		this.id_master.setitem(this.id_master.getrow(), "salecatcode", 2)
	end if
	wf_setgodownoption()
	this.il_custcode = this.id_master.getitemnumber(1, "custcode")
	if li_protect = 0 then
		li_ismodifysaleprice = 1
		li_ismodifyitemdiscperc = 1
		li_ismodifyitemflatdisc = 1
		li_modifysalestax = 1
		li_modifyheaderno = 1
		li_modifybonusqty = 1
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 511 then
				li_ismodifysaleprice = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 516 then
				li_ismodifyitemdiscperc = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 517 then
				li_ismodifyitemflatdisc = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 520 then
				li_modifysalestax = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 557 then
				li_modifyheaderno = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 596 then
				li_modifybonusqty = 0
			end if
		next
		this.id_detail.object.saleprice.protect = li_ismodifysaleprice
		this.id_detail.object.discperc.protect = li_ismodifyitemdiscperc
		this.id_detail.object.itemflatdisc.protect = li_ismodifyitemflatdisc
		this.id_detail.object.unitsalestax.protect = li_modifysalestax
		this.id_detail.object.gstperc.protect = li_modifysalestax
		this.id_master.object.headerno.protect = li_modifyheaderno
		this.id_detail.object.bonusqty.protect = li_modifybonusqty
		this.id_detail.object.bonuspackqtyforsale.protect = li_modifybonusqty
	end if
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	wf_grandtotal()
	lm_menu.m_file.m_deletesaleinvoice.enabled = false
	setredraw(true)

// w_advancedsale.ue_newitem() returns 0 [event]
	integer li_defaultgcode
	long ll_rowcount
	setnull(this.is_aliasname)
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("enablequickprefferedsearch") = "Y" then
		this.id_detail.setcolumn("quicksearch")
	elseif f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	if f_stringpreferences("AutoSelectLastGodownInSale") = "Y" and this.id_detail.rowcount() > 1 then
		this.id_detail.object.gcode.initial = string(this.id_detail.object.gcode[this.id_detail.rowcount()])
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true
	this.ii_defaultgcode = this.ii_salegodown

// w_advancedsale.ue_deleteitem() returns 0 [event]
	long ll_currow
	long ll_detailrows
	long ll_row
	long ll_footerrow
	this.ib_itemvalidated = true
	this.id_detail.deleterow(0)
	ll_detailrows = this.id_detail.rowcount()
	this.im_menu.m_file.m_save.enabled = true
	wf_grandtotal()
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() > 0 then
		this.id_footer.setitem(ll_footerrow, "icode", this.id_detail.getitemnumber(ll_row, "icode"))
		this.id_footer.setitem(ll_footerrow, "stock", this.id_detail.getitemnumber(ll_row, "stock"))
		return
	end if
	this.id_footer.setitem(ll_footerrow, "icode", 0)
	this.id_footer.setitem(ll_footerrow, "stock", 0)
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_save.enabled = true

// w_advancedsale.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	if f_stringpreferences("DisplayPool") = "Y" then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
			this.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
			postevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
			this.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
			this.ic_comport.triggerevent("ue_show")
		else
			this.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
			this.ic_comport.triggerevent("ue_show")
		end if
	end if
	return 1

// w_advancedsale.ue_list() returns 0 [event]
	long ll_row
	m_advsalemenu lm_menu
	call super::ue_list
	lm_menu = this.menuid
	SQL rollback USING this.it_transobject;
	if this.ib_creditsaleposting and this.ii_saletype = 2 then
		this.im_menu.m_file.m_post.enabled = true
	else
		this.im_menu.m_file.m_post.enabled = false
	end if
	this.im_menu.m_file.m_print.enabled = false
	lm_menu.m_file.m_deletesaleinvoice.enabled = true
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	this.tab_retrieve.tabpage_list.em_invno.selecttext(1, 7)
	this.tab_retrieve.tabpage_list.em_invno.clear()
	this.il_norcotixcode = -1
	ll_row = wf_retrievelist()
	wf_disabledetailtab(ll_row)
	post event ue_enableprint()

// w_advancedsale.ue_print() returns 0 [event]
	long ll_custcode
	long ll_row
	long ll_invcode
	long ll_counter
	long ll_draftprint
	string ls_custname
	string ls_posted
	string ls_invoicesize
	integer li_option
	integer li_reprintingcounter
	integer li_printretcode
	double ld_balance
	boolean lb_listtab
	s_datastore lstr
	string ls_printer
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
			else
				event ue_newitem()
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
		if wf_isdeleted(ll_invcode) = true then
			messagebox("Selection Validation", "Can not print deleted sales invoice~r~nPlease select a valid sales invoice")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	SQL SELECT ISNULL ( reprintingcounter , 0 ) , invoicesize INTO :li_reprintingcounter, :ls_invoicesize FROM advsaleledger WHERE advsaleinvcode =:ll_invcode USING this.it_transobject;
	if not lb_listtab then
		li_reprintingcounter = li_reprintingcounter + 1
		SQL update AdvSaleLedger SET ReprintingCounter =:li_reprintingcounter WHERE Advsaleinvcode =:ll_invcode USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Database Error", "Some database problem has occur")
			SQL rollback USING this.it_transobject;
			return
		else
			SQL commit USING this.it_transobject;
		end if
	end if
	if this.ii_saletype = 2 then
		this.ib_printout = false
	end if
	if gs_company = "TOUHEED" and lb_listtab = false then
		this.id_print.dataobject = "d_gar_retailsaleinvreport_quarter"
		this.id_print.settransobject(this.it_transobject)
		this.id_print.retrieve(this.id_master.getitemnumber(1, "code"))
		this.id_print.print()
	end if
	ll_draftprint = wf_select_draft_printout(ll_invcode)
	if ll_draftprint = 0 then
		wf_selectprintreport(ls_invoicesize)
		this.id_print.retrieve(ll_invcode)
		if gs_company = "DWSMALLCREDIT" and ls_invoicesize = "F" then
			for ll_counter = 2 to this.id_print.rowcount()
				this.id_print.setitem(ll_counter + 1, "cumulativesum", this.id_print.getitemnumber(ll_counter, "c_pagesum"))
				this.id_print.setitem(ll_counter, "cumulativesumfoot", this.id_print.getitemnumber(ll_counter, "c_pagesum"))
			next
		end if
		if f_stringpreferences("CustBalanceOnPrintOut") = "Y" and (this.id_master.getitemstring(1, "invoicesize") = "F" or this.id_master.getitemstring(1, "invoicesize") = "H" or this.id_master.getitemstring(1, "invoicesize") = "Q") and this.ii_saletype = 2 and gs_company <> "SA" and this.id_print.getitemstring(1, "Posted") = "N" then
			ll_custcode = this.id_print.getitemnumber(1, "CustCode")
			SQL rollback USING sqlca;
			ld_balance = 0
			sqlca.absoluteopeningbalance(ll_custcode, ld_balance)
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
				messagebox("Balance Problem", "Unable to fetch balance on sales printing.")
				return
			end if
			this.id_print.setitem(this.id_print.rowcount(), "balance", ld_balance)
		end if
		if lb_listtab then
			lstr.dw = this.id_print
			lstr.s_name1 = this.id_print.dataobject
			openwithparm(w_preview_invoices, lstr)
			lstr = message.powerobjectparm
			if lstr.i_closemode = -1 then
				return
			else
				li_reprintingcounter = li_reprintingcounter + 1
				SQL update AdvSaleLedger SET ReprintingCounter =:li_reprintingcounter WHERE advsaleinvcode =:ll_invcode USING this.it_transobject;
				if this.it_transobject.sqlcode <> 0 then
					messagebox("Database Error", "Some database problem has occur during updation of reprinting counter.")
					SQL rollback USING this.it_transobject;
					return
				else
					SQL commit USING this.it_transobject;
				end if
			end if
		end if
		if f_stringpreferences("saleaskforcopies") = "Y" then
			open(w_printer_copies)
			this.id_print.object.datawindow.print.copies = string(message.doubleparm)
		end if
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		if this.id_print.rowcount() > 0 then
			wf_setimgonprint(1)
			li_printretcode = this.id_print.print()
			wf_setimgonprint(0)
			if li_printretcode < 0 then
				messagebox("Printing", "Can not Print Invoice", information!)
			else
				wf_print_storesummary(ll_invcode)
				if f_stringpreferences("CashDrawerWithPrinter") = "Y" and lb_listtab = false then
					ls_printer = f_stringpreferences("CashDrawerPrinter")
					if ls_printer = "" or isnull(ls_printer) then
						messagebox("Cash Drawer Printer", "Cash Drawer Printer name not found.~r~nSuggested Option is check Cash Drawer Printer name in Preferences.")
					else
						this.ic_cashdrawerprinter.object.__invoke_method("opendrawer", 4, {ls_printer, 10, "Control", 65}, true)
					end if
				end if
			end if
			if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
				postevent("ue_new")
			end if
		else
			messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
		end if
		return
	end if
	if this.im_menu.m_file.m_save.enabled = true then
		postevent("ue_new")
	end if

// w_advancedsale.ue_refreshddw() returns 0 [event]
	long ll_prow
	long ll_pcode
	call super::ue_refreshddw
	setpointer(hourglass!)
	this.idc_customers.setredraw(false)
	this.idc_customers.settransobject(this.it_transobject)
	this.idc_customers.retrieve()
	this.idc_customers.setredraw(true)
	this.idc_doctors.setredraw(false)
	this.idc_doctors.settransobject(this.it_transobject)
	this.idc_doctors.retrieve()
	this.idc_doctors.setredraw(true)
	this.idc_patient.setredraw(false)
	this.idc_patient.settransobject(this.it_transobject)
	this.idc_patient.retrieve(this.ii_salemodule)
	ll_prow = this.idc_patient.insertrow(0)
	setnull(ll_pcode)
	this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
	this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
	this.idc_patient.setitem(ll_prow, "name", "<NONE>")
	this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
	this.idc_patient.setitem(ll_prow, "city", "<NONE>")
	this.idc_patient.scrolltorow(ll_prow)
	this.idc_patient.setredraw(true)
	setpointer(arrow!)

// w_advancedsale.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_advancedsale.ue_postopen() returns 0 [event]
	datawindowchild ldc_headerno
	m_advsalemenu lm_menu
	integer li_rtncode
	integer li_defaultgodown
	integer i
	long ll_counter
	long ll_pos
	long ll_prow
	long ll_pcode
	long ll_found
	integer li_defaultsaleprice
	integer li_defaultitemdiscperc
	string ls_custfilterstring
	datastore lds_headers
	datastore lds_listsetting
	call super::ue_postopen
	this.id_assocsaleinvlist = this.dw_assocsaleinvlist
	this.id_assocsaleinvlist.settransobject(this.it_transobject)
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	this.ids_invoiceinfo = create datastore
	this.ids_invoiceinfo.dataobject = "d_saleinvinfo"
	this.ids_invoiceinfo.settransobject(this.it_transobject)
	this.dw_refusedsaleheader.settransobject(this.it_transobject)
	this.dw_refusedsaledetail.settransobject(this.it_transobject)
	this.dw_receivable_adjdetail.settransobject(this.it_transobject)
	lm_menu = this.menuid
	setredraw(false)
	wf_setsaletype(integer(message.doubleparm))
	if this.ii_saletype = 2 then
		this.ii_salemodule = 11
	else
		this.ii_salemodule = 10
	end if
	this.id_print = this.dw_saleinvrep
	this.id_saleinvdetail = this.dw_saleinvdetail
	this.id_saleinvdetail.settransobject(this.it_transobject)
	if gs_company = "CMH" or gs_company = "NM" or gs_company = "FZGUL" then
		this.id_master.object.custrefno.editmask.mask = "########0"
		this.id_master.object.custrefno.editmask.required = true
	end if
	if gs_company = "PIC" then
		this.id_master.object.salecatcode.visible = false
		this.id_master.object.t_1.visible = false
	end if
	if gs_company = "SHE" or gs_company = "RIZWAN" or gs_company = "REHMAT" then
		this.id_master.object.salecatcode.initial = "1"
	end if
	if f_stringpreferences("InSaleCustomerBalance") = "Y" then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		this.ids_customersbalance = create datastore
		this.ids_customersbalance.dataobject = "d_customerbalances_in_sales"
		this.ids_customersbalance.settransobject(sqlca)
		this.ids_customersbalance.retrieve()
	else
		this.id_master.object.debitorcredit.visible = false
		this.id_master.object.customerbalance.visible = false
		this.id_master.object.t_balance.visible = false
	end if
	li_rtncode = this.id_master.getchild("custcode", this.idc_customers)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_customers.settransobject(this.it_transobject)
	this.idc_customers.retrieve()
	if f_stringpreferences("GroupCustomerCategory") = "Y" then
		this.il_groupcode = f_getgroupcode(gl_usercode)
		ls_custfilterstring = "0                                                                                                                                                                                                             "
		this.it_transobject.getallowedgroupcustomercategory(this.il_groupcode, ls_custfilterstring)
		if ls_custfilterstring = " " or ls_custfilterstring = "" or isnull(ls_custfilterstring) then
			ls_custfilterstring = "0"
			messagebox("Group Customer Category Validation", "Current user group does not have enough permissions w.r.t customer to make sale.~r~nIn order to make sale kindly assign customer categories to this user group ~r~n using Group Customer Category module.~r~nOR~r~nDisable Group Customer Category from Preferences.")
			close(this)
			return
		end if
		this.idc_customers.setfilter("custcatcode In (" + ls_custfilterstring + ")")
		this.idc_customers.filter()
	end if
	this.id_master.object.custcode.initial = "19"
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 501 then
			this.ib_creditsaleposting = true
			this.im_menu.m_file.m_post.visible = true
			this.im_menu.m_file.m_post.toolbaritemvisible = true
			this.im_menu.m_file.m_post.enabled = false
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 503 then
			this.ib_creditmodify = true
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 551 then
			lm_menu.m_file.m_normalsave.enabled = true
		end if
	next
	if not this.ib_creditsaleposting then
		this.im_menu.m_file.m_post.visible = false
		this.im_menu.m_file.m_post.toolbaritemvisible = false
		this.im_menu.m_file.m_post.enabled = false
	end if
	li_rtncode = this.id_master.getchild("patientcode", this.idc_patient)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_patient.settransobject(this.it_transobject)
	wf_patient_retrieve()
	if f_stringpreferences("patientOnCreditSale") = "N" then
		this.id_master.object.patientcode.visible = false
		this.id_master.object.t_regno.visible = false
		this.id_master.object.patientcode_t.visible = false
		this.id_master.object.patientregno.visible = false
	end if
	if f_stringpreferences("visiblesalecategory") = "N" then
		this.id_master.object.salecatcode.visible = false
		this.id_master.object.t_1.visible = false
	end if
	f_setcolumnstyle(this.id_detail, "Qty")
	li_rtncode = this.id_master.getchild("doctcode", this.idc_doctors)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_doctors.settransobject(this.it_transobject)
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit to Make Sales")
		close(this)
		return
	end if
	li_rtncode = this.id_detail.getchild("gcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to sale")
		close(this)
		return
	end if
	this.ii_salegodown = this.idc_godown.getitemnumber(1, "gcode")
	this.id_detail.object.gcode.initial = string(this.ii_salegodown)
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = true
	this.id_itemslist.object.sstock.visible = true
	this.id_itemslist.object.t_pstock.visible = false
	this.id_itemslist.object.pstock.visible = false
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 513 and f_stringpreferences("CaSPNo") = "Y" then
			this.id_master.object.sprice.visible = true
			this.id_master.object.t_sprice.visible = true
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 522 then
			this.id_master.object.dd_gstperc.visible = true
			this.id_master.object.gstperc_t.visible = true
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 523 then
			this.id_footer.object.rpp.visible = true
			this.id_footer.object.t_rpp.visible = true
			this.id_footer.object.avgprice.visible = true
			this.id_footer.object.purprice.visible = true
			this.id_footer.object.retailprice.visible = true
		end if
	next
	if f_stringpreferences("Itemflatdisc") = "N" then
		this.id_detail.object.itemflatdisc.visible = false
	end if
	if f_stringpreferences("ShowPurUnitRateInSale") = "N" then
		this.id_detail.object.purunitrate.visible = false
	end if
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_advancesalemodule)
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Sales")
		close(this)
		return
	end if
	if f_stringpreferences("headeronsaleinv") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.t_headerno.visible = false
	end if
	this.id_master.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to lds_headers.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
		ldc_headerno.setitem(ll_counter, "name", "")
		ll_found = 0
		ll_found = gds_reoprtheaderinfo.find("headerno=" + string(lds_headers.getitemnumber(ll_counter, "headercode")), 1, gds_reoprtheaderinfo.rowcount())
		if ll_found > 0 then
			if isnull(gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks")) then
				ldc_headerno.setitem(ll_counter, "headeralias", trim(string(gds_reoprtheaderinfo.getitemnumber(ll_found, "headerno"))))
			else
				ldc_headerno.setitem(ll_counter, "headeralias", trim(gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks")) + " (" + trim(string(gds_reoprtheaderinfo.getitemnumber(ll_found, "headerno"))) + ")")
			end if
		end if
	next
	this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
	this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.t_gcode.visible = true
		this.id_master.object.gcode.visible = true
		this.id_master.object.gcode.initial = string(this.ii_salegodown)
		this.id_detail.object.gcode.visible = false
		this.id_footer.object.t_totalstock.visible = false
		this.id_footer.object.totalstock.visible = false
	end if
	if f_stringpreferences("enablequickprefferedsearch") = "Y" then
		this.id_detail.object.quicksearch.visible = true
	else
		this.id_detail.object.quicksearch.visible = false
	end if
	if f_stringpreferences("SaleItemdescription") = "N" then
		this.id_detail.object.saleitemdescription.visible = false
	end if
	if f_stringpreferences("packingdescinsale") = "N" then
		this.id_detail.object.packingdesc.visible = false
	end if
	if f_stringpreferences("Saleclaimable") = "N" then
		this.id_detail.object.claimable.visible = false
	end if
	if f_stringpreferences("ShowClaimableDiscPercInSale") = "N" then
		this.id_detail.object.claimablediscperc.visible = false
	end if
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
