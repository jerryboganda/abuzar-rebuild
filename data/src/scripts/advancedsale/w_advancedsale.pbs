// window w_advancedsale (advancedsale)  ancestor: w_multi_entry

// w_advancedsale.ue_printdo() returns 0 [event]
	long ll_custcode
	long ll_row
	string ls_custname
	string ls_pagesize
	integer li_option
	if this.im_menu.m_file.m_save.enabled = true then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	ls_pagesize = this.id_master.getitemstring(1, "invoicesize")
	if ls_pagesize = "F" then
		if gs_company = "MARSHAL" then
			this.id_print.dataobject = "d_marshal_deliveryorder_full"
		elseif gs_company = "SEICOSCIENTIF" or gs_company = "SEICOLHR" or gs_company = "SEICOKHI" then
			this.id_print.dataobject = "d_seico_deliveryorder_full"
		elseif gs_company = "CARENCUREKHI" then
			this.id_print.dataobject = "d_carencurekhi_deliveryorder_full"
		elseif gs_company = "MEDLABSERVICE" then
			this.id_print.dataobject = "d_medlab_deliveryorder_full"
		elseif left(gs_company, 12) = "MASOODHOMOEO" then
			this.id_print.dataobject = "d_deliveryorder_batch_expiry_full"
		elseif gs_company = "AMEERDININST" then
			this.id_print.dataobject = "d_ameerdininst_deliveryorder_full"
		elseif gs_company = "IGB" then
			this.id_print.dataobject = "d_igb_deliverychallan_full"
		else
			this.id_print.dataobject = "d_deliveryorder_full"
		end if
	elseif gs_company = "MARSHAL" then
		this.id_print.dataobject = "d_marshal_deliveryorder_half"
	elseif gs_company = "EP" then
		this.id_print.dataobject = "d_ep_deliveryorder_half"
	elseif left(gs_company, 12) = "MASOODHOMOEO" then
		this.id_print.dataobject = "d_deliveryorder_batch_expiry_full"
	elseif gs_company = "AMEERDININST" then
		this.id_print.dataobject = "d_ameerdininst_deliveryorder_half"
	else
		this.id_print.dataobject = "d_deliveryorder_half"
	end if
	if gs_company = "SAH" then
		this.id_print.dataobject = "d_sah_deliveryorder_full"
	elseif gs_company = "CSE" then
		this.id_print.dataobject = "d_cse_deliveryorder_full"
	elseif gs_company = "SA" then
		this.id_print.dataobject = "d_sa_deliveryorder_half"
	elseif gs_company = "PRX" or gs_company = "PRXF" or gs_company = "MEDONE" then
		this.id_print.dataobject = "d_deliveryorder_full_batch"
	elseif gs_company = "CARDIACCARE" then
		this.id_print.dataobject = "d_cardiaccare_deliveryorder_full"
	elseif gs_company = "CRYSTALTRADERS" or gs_company = "CRYSTALTRADERS2" then
		this.id_print.dataobject = "d_crystaltraders_deliveryorder_full"
	end if
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(this.id_master.getitemnumber(1, "code"))
	if f_stringpreferences("saleaskforcopies") = "Y" then
		open(w_printer_copies)
		this.id_print.object.datawindow.print.copies = string(message.doubleparm)
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_advancedsale.ue_setitemfocus() returns 0 [event]
	string ls_null
	setnull(ls_null)
	if f_stringpreferences("itemcode") = "Y" then
		this.id_detail.setcolumn("fullcode")
		this.id_detail.setfocus()
		return
	end if
	this.id_detail.setitem(this.id_detail.getrow(), "itemname", " ")
	this.id_detail.setcolumn("itemname")
	this.id_detail.setfocus()
	this.id_detail.setitem(this.id_detail.getrow(), "itemname", ls_null)

// w_advancedsale.ue_enableprint() returns 0 [event]
	this.im_menu.m_file.m_print.enabled = true

// w_advancedsale.ue_deleteinvoice() returns 0 [event]
	long ll_invcode
	long ll_counter
	long ll_usercode
	long ll_found
	long ll_deleteoption
	long ll_groupcode
	datetime ldt_server_datetime
	string ls_errtext
	string ls_msgtitle
	string ls_msg
	string ls_date_errtext
	string ls_askuserpwd
	boolean lb_deletionallowed
	boolean lb_listtab
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab = true then
		ls_msgtitle = "Delete Sales Invoice(s)"
		ls_msg = "Delete Operation Terminated Unsuccessfuly~r~n"
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 573", 1, gds_securitywindow.rowcount())
		if ll_found <= 0 then
			messagebox(ls_msgtitle, ls_msg + "Reason: Not enough rights to delete Sales Invoice", stopsign!)
			return
		end if
		ls_askuserpwd = "CreditSaleAskUserPassword"
		if f_stringpreferences(ls_askuserpwd) = "Y" then
			open(w_salesmanpassword)
			ll_usercode = long(message.doubleparm)
			setfocus()
		else
			ll_usercode = gl_usercode
		end if
		if ll_usercode > 0 then
			ll_groupcode = f_getgroupcode(ll_usercode)
			if ll_groupcode > 0 then
				SQL SELECT Rightcode INTO :ll_found FROM DBO.GroupRights WHERE GroupCode =:ll_groupcode AND RightCode =573 USING this.it_transobject;
				if this.it_transobject.sqlcode = 0 then
					if ll_found <= 0 or isnull(ll_found) then
						messagebox(ls_msgtitle, ls_msg + "Reason: Not enough rights to delete Sales Invoice", stopsign!)
						return
					end if
				else
					messagebox(ls_msgtitle, ls_msg + "Reason: Net work problem or You do Not have enough rights to delete Sales Invoice", stopsign!)
					return
				end if
				ll_deleteoption = messagebox(ls_msgtitle, "Delete Invoice(s) permanently from Database?", question!, yesnocancel!, 2)
				if ll_deleteoption <> 1 then
					return
				end if
				SQL rollback USING this.it_transobject;
				this.it_transobject.deleteadvsaleledger()
				if this.it_transobject.sqlcode = 0 then
					SQL commit USING this.it_transobject;
					messagebox(ls_msgtitle, "Sale Invoice Successfully Deleted")
				else
					SQL rollback USING this.it_transobject;
					messagebox(ls_msgtitle, ls_msg + "Reason: " + this.it_transobject.sqlerrtext, stopsign!)
				end if
			else
				messagebox(ls_msgtitle, ls_msg + "Reason: Not a valid user", stopsign!)
				return
			end if
			return
		end if
		return
	end if

// w_advancedsale.ue_viewinvmargin() returns 0 [event]
	long ll_count
	long ll_invcode
	long ll_masterrow
	datastore lds_invitemlist
	boolean lb_listtab
	boolean lb_editable = true
	s_datastore lstr
	if wf_iseditable() = false then
		lb_editable = false
	end if
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if not lb_listtab then
		lds_invitemlist = create datastore
		lds_invitemlist.dataobject = "d_marginpreview_report"
		lds_invitemlist.settransobject(sqlca)
		if lb_editable then
			this.id_detail.accepttext()
			this.id_footer.accepttext()
			for ll_count = 1 to this.id_detail.rowcount()
				lds_invitemlist.insertrow(0)
				lds_invitemlist.setitem(ll_count, "fullcode", this.id_detail.getitemstring(ll_count, "fullcode"))
				lds_invitemlist.setitem(ll_count, "itemname", this.id_detail.getitemstring(ll_count, "itemname"))
				lds_invitemlist.setitem(ll_count, "saleprice", this.id_detail.getitemnumber(ll_count, "saleprice"))
				lds_invitemlist.setitem(ll_count, "avgprice", this.id_detail.getitemnumber(ll_count, "avgprice"))
				lds_invitemlist.setitem(ll_count, "looseqty", this.id_detail.getitemnumber(ll_count, "looseqty"))
				lds_invitemlist.setitem(ll_count, "discperc", this.id_detail.getitemnumber(ll_count, "discperc"))
				lds_invitemlist.setitem(ll_count, "itemflatdisc", this.id_detail.getitemnumber(ll_count, "itemflatdisc"))
				lds_invitemlist.setitem(ll_count, "invdiscperc", this.id_footer.getitemnumber(1, "invdiscperc"))
			next
		else
			ll_masterrow = this.id_master.rowcount()
			ll_invcode = this.id_master.object.code[ll_masterrow]
			lds_invitemlist.retrieve(ll_invcode)
		end if
		lstr.ds = lds_invitemlist
		lstr.s_name1 = "d_marginpreview_report"
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		destroy lds_invitemlist
	end if

// w_advancedsale.ue_enforcedefaultfocussettings() returns 0 [event]
	string ls_focuscolsetting
	string ls_setting
	ls_focuscolsetting = f_stringpreferences("creditsaledefaultfocussetting")
	if ls_focuscolsetting = "detailwindow" then
		if f_stringpreferences("enablequickprefferedsearch") = "Y" then
			this.id_detail.setcolumn("quicksearch")
			this.id_detail.setfocus()
		else
			post event ue_setitemfocus()
		end if
		return
	end if
	ls_setting = this.id_master.describe(trim(ls_focuscolsetting) + ".visible")
	if trim(ls_setting) = "1" then
		this.id_master.setcolumn(ls_focuscolsetting)
		this.id_master.setfocus()
		return
	end if
	this.id_master.setfocus()

// w_advancedsale.ue_view_itemassociations() returns 0 [event]
	s_dw_header lstr_header
	long ll_row
	long ll_icode
	dwruntimeerror exdw
	nullobjecterror exobj
	try
		if this.tab_retrieve.selectedtab = 1 then
			ll_row = this.id_detail.getrow()
			if ll_row > 0 then
				ll_icode = this.id_detail.object.icode[ll_row]
				if ll_icode > 0 then
					this.id_itemassociation.retrieve(ll_icode)
					lstr_header.l_code = ll_icode
					lstr_header.dw_header = this.id_itemassociation
					openwithparm(w_itemassociation_form, lstr_header)
				end if
			end if
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exobj)
		messagebox("Exception Occur", "Details are:~r~n" + exobj.getmessage())
		goto L468
	end try

// w_advancedsale.ue_view_itemnotes() returns 0 [event]
	s_arguements lstr_arg
	long ll_row
	long ll_icode
	dwruntimeerror exdw
	nullobjecterror exobj
	try
		if this.tab_retrieve.selectedtab = 1 then
			ll_row = this.id_detail.getrow()
			if ll_row > 0 then
				ll_icode = this.id_detail.object.icode[ll_row]
				if ll_icode > 0 then
					lstr_arg.l_code1 = ll_icode
					lstr_arg.l_code2 = 0
					openwithparm(w_item_form_notes, lstr_arg)
				end if
			end if
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exobj)
		messagebox("Exception Occur", "Details are:~r~n" + exobj.getmessage())
		goto L430
	end try

// w_advancedsale.ue_save_withnocommit() returns long [event]
	setpointer(hourglass!)
	if f_validatedw(this.id_master) < 0 then
		return -1
	end if
	if f_validatedw(this.id_detail) < 0 then
		return -2
	end if
	if this.id_master.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -3
	end if
	if this.id_detail.update() < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -4
	elseif this.id_assocsaleinvlist.update() > 0 then
		if not wf_set_post_assocsaleinv() then
			SQL rollback USING this.it_transobject;
			setpointer(arrow!)
			return -2
		end if
	else
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -1
	end if
	setpointer(arrow!)
	return 0

// w_advancedsale.wf_set_post_assocsaleinv() returns boolean [event]
	long ll_saleinvcode
	long ll_custcode
	long ll_salecatcode
	long ll_assocsaleinvcode
	long ll_totalrows
	long ll_counter
	long ll_salesmancode
	if this.ib_assocsaleinvlist then
		ll_saleinvcode = this.id_master.object.code[1]
		ll_custcode = this.id_master.object.custcode[1]
		ll_salecatcode = this.id_master.object.salecatcode[1]
		ll_salesmancode = this.id_master.object.salesmancode[1]
		ll_totalrows = this.id_assocsaleinvlist.rowcount()
		for ll_counter = 1 to ll_totalrows
			ll_assocsaleinvcode = this.id_assocsaleinvlist.object.saleinvcode[ll_counter]
			SQL update SaleLedger Set CustCode =:ll_custcode , salecatcode =:ll_salecatcode Where SaleInvCode =:ll_assocsaleinvcode And POSTED ='N' USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Associated SaleInv Updation Error", "Unable to update customer information in Associated SaleInvNo.: " + string(ll_assocsaleinvcode))
				return false
			else
				this.it_transobject.postsaleledger(ll_assocsaleinvcode, ll_assocsaleinvcode, ll_salecatcode, ll_salesmancode, ll_custcode, 0, "Y")
				if this.it_transobject.sqlcode <> 0 then
					messagebox("Associated SaleInv Posting Error", "Posting Error in Associated SaleInvNo.: " + string(ll_assocsaleinvcode) + "~r~nReasons are: " + this.it_transobject.sqlerrtext)
					return false
				end if
			end if
		next
		this.it_transobject.postadvsaleledger(ll_saleinvcode, ll_saleinvcode, ll_salesmancode, ll_custcode, 0)
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Advanced Sale Inv. Posting Error", "Posting Error in Advanced Sale Inv No.: " + string(ll_saleinvcode) + "~r~nReasons are: " + this.it_transobject.sqlerrtext)
			return false
		end if
		return
	end if
	return true

// w_advancedsale.wf_getmaxdate(ref datetime ad_date) returns integer
	SQL Select Max ( Date ) INTO :ad_date From advsaleledger USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_advancedsale.wf_getitemassociategcode(long la_icode) returns integer
	integer li_gcode
	SQL Select Gcode INTO :li_gcode From item Where icode =:la_icode USING this.it_transobject;
	return li_gcode

// w_advancedsale.wf_locksaleinvoice(long al_saleinvcode) returns integer
	integer li_count
	this.it_transobject.dbparm = " Async =1, DBGetTime = 20"
	this.it_transobject.lockadvsaleinvoice(al_saleinvcode)
	this.it_transobject.dbparm = "Async =0, DBGetTime = 0"
	return this.it_transobject.sqlcode

// w_advancedsale.wf_preinvinfo() returns 0
	s_previnvinfo ls_previnvinfo
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_previnvinfo.ar_customer = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		ls_previnvinfo.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_previnvinfo.ar_invdate = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_previnvinfo, ls_previnvinfo)
	end if

// w_advancedsale.wf_setsuppinfo(long al_suppcode, datawindow ad_master) returns 0
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	SQL SELECT supplier.address1 , supplier.city , supplier.phone INTO :ls_address, :ls_city, :ls_phone FROM supplier WHERE supplier.suppcode =:al_suppcode USING this.it_transobject;
	ll_currow = ad_master.getrow()
	ad_master.object.supplier_address[ll_currow] = ls_address
	ad_master.object.supplier_city[ll_currow] = ls_city
	ad_master.object.supplier_phone[ll_currow] = ls_phone

// w_advancedsale.wf_updatesaleprice(long al_icode, double ad_saleprice) returns integer
	SQL update Item SET saleprice =:ad_saleprice WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_advancedsale.wf_validateitemnew() returns integer
	long ll_icode
	double ld_stock
	double ld_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
		messagebox(ls_titleerrtext, ls_errtext)
	elseif not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		ls_titleerrtext = "Item Validation"
		li_errcode = -2
	end if
	this.ib_itemvalidated = true
	return li_errcode

// w_advancedsale.wf_genfullcode(long al_icode, ref string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	long iccode
	long icatcode
	long packcode
	long manfcode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_advancedsale.wf_setsaletype(integer ai_saletype) returns 0
	this.ii_saletype = ai_saletype

// w_advancedsale.wf_visibleinvisiblediscount() returns integer
	this.id_detail.object.discperc.visible = 0
	this.id_detail.object.discperc.initial = "0"
	return 1

// w_advancedsale.wf_customermessagevalidation(long al_custcode, long al_messagecode) returns integer
	integer li_messagecode
	long ll_currrow
	SQL SELECT customer.messagecode INTO :li_messagecode FROM customer WHERE customer.custcode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currrow = this.id_master.getrow()
		if isnull(li_messagecode) then
			ll_currrow = 0
		else
			ll_currrow = 1
		end if
	end if
	return ll_currrow

// w_advancedsale.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	long ll_icode
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	integer li_option
	boolean lb_rtflag = true
	boolean ib_due
	integer li_null
	string ls_null
	ls_titleerrtext = "Item Validation"
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), al_currrow) = true then
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
	elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			li_option = messagebox("Item Validation", "Item stock does not exist~n~rDo You want to due this item", information!, yesno!, 2)
			if li_option = 1 then
				this.id_detail.setitem(this.il_currrow, "looseqty", 1)
				this.id_detail.setitem(this.il_currrow, "dueqty", 1)
				ib_due = true
			else
				li_errcode = -1
			end if
		end if
	else
		li_errcode = -1
		ls_titleerrtext = "Item Validation"
	end if
	if li_errcode = -1 and not ib_due then
		lb_rtflag = false
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setitem(al_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(al_currrow, "icode", li_null)
		this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	end if
	return lb_rtflag

// w_advancedsale.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_advancedsale.wf_visible(boolean ab_flag) returns 0

// w_advancedsale.wf_populate_ddlb(datawindow dwcontrol) returns 0
	integer li_column_count
	integer li_counter
	string ls_column_name
	string ls_columntype
	this.tab_retrieve.tabpage_list.ddlb_filter_column.reset()
	this.tab_retrieve.tabpage_list.ddlb_sort.reset()
	li_column_count = integer(dwcontrol.object.datawindow.column.count)
	for li_counter = li_column_count to 1 step -1
		ls_column_name = dwcontrol.describe("#" + string(li_counter) + ".Name")
		this.tab_retrieve.tabpage_list.ddlb_sort.additem(ls_column_name)
		this.tab_retrieve.tabpage_list.ddlb_filter_column.additem(ls_column_name)
	next
	this.tab_retrieve.tabpage_list.ddlb_sort.text = ls_column_name
	ls_columntype = this.id_dwcontrol.describe("#1.ColType")
	if left(ls_columntype, 4) = "char" then
		this.ii_type = 1
	elseif left(ls_columntype, 4) = "date" then
		this.ii_type = 3
	else
		this.ii_type = 2
	end if
	this.ii_colindex = 1
	this.tab_retrieve.tabpage_list.rb_descending.checked = true
	wf_sortdw(this.tab_retrieve.tabpage_list.ddlb_sort.text, this.is_sortsequence)
	if this.ii_saletype = 3 then
		this.id_detail.setfocus()
		return
	end if
	this.id_master.setfocus()

// w_advancedsale.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_discountvalue
	double ld_invtaxperc1val
	double ld_intaxperc1
	double ld_totaltax
	double ld_totalitemleveltax
	double ld_refundamt
	real lr_discperc
	real lr_flatdisc
	real lr_misccharges
	real lr_salestax
	real lr_itemstotal
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		lr_discperc = this.id_footer.object.invdiscperc[1]
		lr_flatdisc = this.id_footer.object.flatdisc[1]
		lr_misccharges = this.id_footer.object.misccharges[1]
		lr_salestax = 0
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
		ld_intaxperc1 = this.id_footer.object.invgstperc1[1]
		ld_refundamt = this.id_footer.object.refundamt[1]
		ld_totalitemleveltax = this.id_detail.getitemnumber(1, "c_sumtaxval") + this.id_detail.getitemnumber(1, "c_sumgstval")
		this.id_footer.object.t_discountvalue.text = string(ld_detaildwtotal * lr_discperc * 0.01, "########0.00")
		ld_discountvalue = ld_detaildwtotal * lr_discperc * 0.01
		ld_grandtotal = ld_detaildwtotal - ld_discountvalue - lr_flatdisc + lr_misccharges + lr_salestax - ld_refundamt
		ld_invtaxperc1val = round((ld_detaildwtotal - ld_discountvalue - lr_flatdisc) * ld_intaxperc1 * 0.01, 2)
		ld_totaltax = round(ld_invtaxperc1val + ld_totalitemleveltax, 0)
		ld_grandtotal = round(ld_grandtotal, 0) + ld_totaltax
		this.id_footer.setitem(1, "total", ld_grandtotal)
	end if
	return ld_grandtotal

// w_advancedsale.wf_initmodify(ref integer ai_protect) returns 0
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_counter = 1
	long ll_count
	double ld_saleprice
	double ld_packsalestax
	double ld_avgprice
	double ld_recentpurprice
	double ld_purprice
	string ls_itemtotalval
	double ld_looseqty
	double ld_bonusqty
	double ld_stock
	double ld_purdiscperc
	long ll_disc_icode
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_saleinvcode = this.id_detail.getitemnumber(1, "code")
		if wf_locksaleinvoice(ll_saleinvcode) = 0 then
			this.id_master.retrieve(ll_saleinvcode)
			this.id_detail.retrieve(ll_saleinvcode)
			this.ids_invoiceinfo.retrieve(ll_saleinvcode)
			for ll_count = 1 to this.id_detail.rowcount()
				ll_icode = this.id_detail.getitemnumber(ll_count, "icode")
				ll_gcode = this.id_detail.getitemnumber(ll_count, "gcode")
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				if this.it_transobject.sqlcode <> 0 then
					ai_protect = 0
				end if
				ld_looseqty = 0
				ld_bonusqty = 0
				for ll_counter = 1 to this.ids_invoiceinfo.rowcount()
					if ll_icode = this.ids_invoiceinfo.getitemnumber(ll_counter, "icode") then
						if isnull(this.ids_invoiceinfo.getitemstring(ll_counter, "due")) then
							ld_looseqty = ld_looseqty + this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty")
							ld_bonusqty = ld_bonusqty + this.ids_invoiceinfo.getitemnumber(ll_counter, "bonusqty")
						end if
						this.id_detail.setitem(ll_count, "stock", ld_stock + ld_looseqty + ld_bonusqty)
						SQL SELECT item.saleprice , item.packsalestax , item.purprice , item.avgprice , item.recentpurprice INTO :ld_saleprice, :ld_packsalestax, :ld_purprice, :ld_avgprice, :ld_recentpurprice FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
						if this.it_transobject.sqlcode = 0 then
							ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
							this.id_detail.setitem(ll_count, "itemtotalval", ls_itemtotalval)
							this.id_detail.setitem(ll_count, "recentpurprice", ld_recentpurprice)
							this.id_detail.setitem(ll_count, "purprice", ld_purprice)
							this.id_detail.setitem(ll_count, "avgprice", ld_avgprice)
						end if
					end if
				next
			next
			if ai_protect = 0 then
				this.ib_modify = true
				this.id_footer.setitem(1, "stock", this.id_detail.getitemnumber(1, "stock"))
				if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
					ll_disc_icode = this.id_detail.getitemnumber(1, "icode")
					SQL Select item.purdiscperc INTO :ld_purdiscperc From Item Where item.icode =:ll_disc_icode USING this.it_transobject;
					this.id_footer.object.t_purdiscper.text = string(ld_purdiscperc)
				end if
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
			return
		end if
		messagebox("Cannot Modify", "Sale invoice is already in use")
	end if

// w_advancedsale.wf_itemsalehistory() returns 0
	s_itemsalehistory ls_itemsalehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itemsalehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itemsalehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itemsalehistory, ls_itemsalehistory)
	end if

// w_advancedsale.wf_getcustomerinfo() returns 0
	long ll_custcode
	if this.id_master = getfocus() and this.id_master.rowcount() > 0 then
		ll_custcode = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		openwithparm(w_customerinfo, ll_custcode)
	end if

// w_advancedsale.wf_setnormalsale() returns 0
	this.ib_saveasnormalsale = true

// w_advancedsale.wf_customerinfo(long al_custcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	string ls_aliasname
	string ls_refno
	string ls_considerinpo
	integer li_messagecode
	long ll_currow
	double ld_currbalance
	SQL SELECT customer.address1 , customer.city , customer.phone , customer.messagecode , accounts.aliasname , customer.refno , customer.considerinpo INTO :ls_address, :ls_city, :ls_phone, :li_messagecode, :ls_aliasname, :ls_refno, :ls_considerinpo FROM customer , accounts WHERE customer.custcode =:al_custcode and customer.custcode =accounts.acccode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
		this.id_master.object.address[ll_currow] = ls_address
		this.id_master.object.aliasname[ll_currow] = ls_aliasname
		this.id_master.object.city[ll_currow] = ls_city
		this.id_master.object.phone[ll_currow] = ls_phone
		if f_stringpreferences("FetchRefNoFromCustomer") = "Y" then
			this.id_master.object.custrefno[ll_currow] = ls_refno
		end if
		if isnull(li_messagecode) then
			this.id_master.object.messagecode[ll_currow] = 1
		else
			this.id_master.object.messagecode[ll_currow] = li_messagecode
		end if
	end if
	return this.it_transobject.sqlcode

// w_advancedsale.wf_deleteallemptydetailrows() returns integer
	long ll_count
	long ll_deletecount
	ll_deletecount = 0
	for ll_count = 1 to this.id_detail.rowcount()
		if isnull(this.id_detail.getitemnumber(ll_count, "icode")) then
			ll_deletecount = ll_deletecount + 1
			this.id_detail.deleterow(ll_count)
		end if
	next
	return ll_deletecount

// w_advancedsale.wf_setgodownoption() returns 0
	if this.id_detail.rowcount() > 0 then
		this.ii_salegodown = this.id_detail.getitemnumber(1, "gcode")
	end if
	if this.il_strategy = 2 or this.il_strategy = 1 and this.il_godowncount = 1 then
		this.id_detail.modify("gcode" + ".Protect=1")
		this.id_detail.object.gcode.background.color = this.backcolor
	end if

// w_advancedsale.wf_setfocuswithscroll(string as_colname, long al_row) returns integer
	this.id_detail.scrolltorow(al_row)
	this.id_detail.setcolumn(as_colname)
	this.id_detail.setfocus()
	this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	return 1

// w_advancedsale.wf_setitemdataoncustlatestsale() returns integer
	integer li_rowsaffected
	long ll_counter
	long ll_custcode
	long ll_icode
	double ld_looseqty
	double ld_prevbonusqty
	double ld_desiredbonus
	double ld_prevsaleqty
	double ld_saleprice
	double ld_discperc
	double ld_itemflatdisc
	string ls_bonusqty
	string ls_discperc
	string ls_itemflatdisc
	ls_bonusqty = this.id_detail.object.bonusqty.visible
	ls_discperc = this.id_detail.object.discperc.visible
	ls_itemflatdisc = this.id_detail.object.itemflatdisc.visible
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	for ll_counter = 1 to this.id_detail.rowcount()
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		ld_looseqty = this.id_detail.getitemnumber(ll_counter, "looseqty")
		li_rowsaffected = 0
		this.it_transobject.getcustwiselatestitemsale(ll_custcode, ll_icode, ld_saleprice, ld_prevsaleqty, ld_prevbonusqty, ld_discperc, ld_itemflatdisc, li_rowsaffected)
		if this.it_transobject.sqlcode = 0 then
			if li_rowsaffected > 0 then
				if f_stringpreferences("UpdSPriceUsingCustLatestSale") = "Y" then
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice)
				end if
				if ls_bonusqty = "1" and f_stringpreferences("UpdBonusQtyUsingCustLatestSale") = "Y" then
					if ld_prevsaleqty <> 0.0 then
						ld_desiredbonus = round(ld_looseqty / ld_prevsaleqty * ld_prevbonusqty, 4)
						this.id_detail.setitem(ll_counter, "bonusqty", ld_desiredbonus)
					end if
				end if
				if ls_discperc = "1" and f_stringpreferences("UpdDiscPercUsingCustLatestSale") = "Y" then
					this.id_detail.setitem(ll_counter, "discperc", ld_discperc)
				end if
				if ls_itemflatdisc = "1" and f_stringpreferences("UpdFlatDiscUsingCustLatestSale") = "Y" then
					this.id_detail.setitem(ll_counter, "itemflatdisc", ld_itemflatdisc)
				end if
			end if
		else
			return -1
		end if
	next
	return 1

// w_advancedsale.wf_setcustomer() returns integer
	if f_validatedw(this.id_master) < 0 then
		return -1
	end if

// w_advancedsale.wf_setcustomername(string as_data) returns 0
	long ll_rowno
	ll_rowno = this.idc_customers.find("customer_name >='" + as_data + "'", 1, this.idc_customers.rowcount())
	if ll_rowno > 0 then
		this.idc_customers.selectrow(0, false)
		this.idc_customers.setrow(ll_rowno)
		this.idc_customers.scrolltorow(ll_rowno)
		this.idc_customers.selectrow(ll_rowno, true)
	end if

// w_advancedsale.wf_selectcustomerareawise() returns integer
	s_popup_selection ls_popup_selection
	if this.ii_saletype = 2 and this.editflag = true and f_stringpreferences("patientOnCreditSale") = "N" then
		open(w_popup_areaselection)
		ls_popup_selection = message.powerobjectparm
		if ls_popup_selection.l_code > 0 then
			openwithparm(w_popup_customerselectionareawise_forsal, ls_popup_selection)
			ls_popup_selection = message.powerobjectparm
			if ls_popup_selection.l_code > 0 then
				this.id_master.setitem(this.id_master.getrow(), "custcode", ls_popup_selection.l_code)
				wf_setcustomername(ls_popup_selection.s_name)
				wf_setcustomerinfo(this.id_master.getrow(), 1, string(ls_popup_selection.l_code))
			end if
		end if
	end if
	return 1

// w_advancedsale.wf_retrievelistall() returns long
	string[] ls_posted
	string ls_showrows = "N"
	integer[] li_salecategory
	long ll_counter
	datetime ld_invdate
	ld_invdate = datetime(date("12/12/1998"), time("00:00:00"))
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 538 then
			ls_showrows = "Y"
		end if
	next
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		if f_stringpreferences("ShowAllInvInCreditSaleList") = "Y" then
			li_salecategory[1] = 1
			li_salecategory[2] = 2
			li_salecategory[3] = 3
		else
			li_salecategory[1] = 1
			li_salecategory[2] = 2
		end if
	else
		li_salecategory[1] = this.ii_saletype
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, ls_showrows, this.il_groupcode, this.ii_module)

// w_advancedsale.wf_locksaleinvoices(long al_sinvcode, long al_linvcode, ref long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From advsaleledger WITH ( UPDLOCK HOLDLOCK ) Where advsaleledger.advsaleinvcode Between :al_sinvcode AND :al_linvcode AND advsaleledger.Posted ='N' USING sqlca;
	return sqlca.sqlcode

// w_advancedsale.wf_findpatientcode(string as_regno, ref integer ai_patientcode) returns integer
	integer li_patientcode
	integer ll_retflag
	string ls_itemname
	char lc_active
	ll_retflag = 0
	SQL SELECT patient.patientcode , patient.active INTO :li_patientcode, :lc_active FROM patient WHERE patient.regno =:as_regno and patientcatcode in ( select distinct patientcatcode from patientcatallowedmodule where moduleid =:this.ii_salemodule ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_patientcode = li_patientcode
		if isnull(ai_patientcode) then
			ll_retflag = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
		else
			ll_retflag = -2
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_advancedsale.wf_validategodown() returns integer
	long ll_icode
	long ll_gcode
	long ll_counter
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	string ls_null
	integer li_errcode = 1
	integer li_null
	integer li_option
	integer li_duperr
	boolean ib_due
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	this.ii_defaultgcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	if wf_checkgodownstock(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			if isnull(this.id_detail.getitemstring(this.il_currrow, "due")) then
				li_errcode = -1
			end if
		elseif f_stringpreferences("AllowDupItemsInSale") = "N" then
			for ll_counter = 1 to this.id_detail.rowcount()
				if this.il_currrow <> ll_counter and (ll_icode = this.id_detail.getitemnumber(ll_counter, "icode") and this.ii_defaultgcode = this.id_detail.getitemnumber(ll_counter, "gcode")) then
					li_duperr = -2
				end if
			next
		end if
	end if
	this.ib_godownvalidated = true
	if li_errcode = -1 and not ib_due then
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		this.id_detail.setfocus()
		this.id_detail.setcolumn("gcode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
	end if
	if li_duperr = -2 and not ib_due then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate Item, please select some other item"
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
		this.ib_itemslistopen = true
		this.id_itemslist.show()
		li_errcode = -1
	end if
	return li_errcode

// w_advancedsale.wf_findfullcode(string as_fullcode, ref long al_icode, ref string al_itemname) returns integer
	integer ll_retflag
	long ll_icode
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND ( item.Restricted ='N' OR ( Item.Restricted ='Y' AND Exists ( select *from grouprights where rightcode =515 and groupcode =:this.il_groupcode ) ) ) AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND ( item.Restricted ='N' OR ( Item.Restricted ='Y' AND Exists ( select *from grouprights where rightcode =515 and groupcode =:this.il_groupcode ) ) ) USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_advancedsale.wf_searchgodown() returns long
	s_popup_selection lstr_selection
	long ll_icode
	ll_icode = this.id_detail.object.icode[this.id_detail.getrow()]
	lstr_selection.l_longarray[1] = ll_icode
	lstr_selection.l_longarray[2] = this.il_strategy
	lstr_selection.l_longarray[3] = this.il_groupcode
	lstr_selection.l_longarray[4] = this.ii_module
	openwithparm(w_popup_godownselection, lstr_selection)
	lstr_selection = message.powerobjectparm
	if lstr_selection.l_code > 0 then
		this.id_detail.setitem(this.id_detail.getrow(), "gcode", lstr_selection.l_code)
	end if
	return 0

// w_advancedsale.wf_validateitem(boolean ab_flag) returns integer
	long ll_icode
	long ll_count
	long ll_duprow
	double ld_stock
	double ld_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	integer li_option
	integer n
	boolean ib_due
	boolean lb_dupitem
	boolean lb_zerostock
	boolean lb_invalidrow
	integer li_null
	string ls_null
	if isnull(this.il_currrow) or this.il_currrow <= 0 then
		lb_invalidrow = true
		setnull(ll_icode)
	else
		ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	end if
	if this.id_detail.rowcount() = 0 and isnull(ll_icode) then
		return li_errcode
	end if
	if not isnull(ll_icode) then
		if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true and f_stringpreferences("AllowDupItemsInSale") = "N" then
			ls_titleerrtext = "Item Validation"
			ls_errtext = "Duplicate item, please select some other item"
			lb_dupitem = true
			li_errcode = -1
		elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
			if li_errcode = -2 then
				lb_zerostock = true
				if ab_flag and isnull(this.id_detail.getitemstring(this.il_currrow, "due")) then
					li_errcode = -1
				end if
			end if
		else
			ls_titleerrtext = "Item Validation"
		end if
	end if
	if ab_flag then
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		if this.il_strategy = 1 and this.il_godowncount > 1 and lb_zerostock then
			messagebox(ls_titleerrtext, "Stock is zero, please select some other godown")
			this.ib_itemslistopen = false
			this.id_itemslist.hide()
			this.id_detail.setcolumn("gcode")
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.gcode[this.il_currrow] = li_null
		elseif lb_dupitem = true then
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.icode[this.il_currrow] = li_null
			this.id_detail.object.fullcode[this.il_currrow] = ls_null
			this.id_detail.object.itemname[this.il_currrow] = ls_null
			post event ue_deleteitem_row(this.il_currrow)
			for ll_count = 1 to this.id_detail.rowcount()
				if this.id_detail.getitemnumber(ll_count, "icode") = ll_icode then
					post event ue_scrolltorow(ll_count, "looseqty")
					exit
				end if
			next
			messagebox("Item", "Duplicate Item, please select some other item")
		elseif lb_invalidrow = true then
			li_errcode = -1
		else
			ls_titleerrtext = "Item Validation"
			messagebox(ls_titleerrtext, ls_errtext)
			if f_stringpreferences("itemcode") = "N" then
				this.id_detail.setcolumn(this.is_columnitemname)
				this.ib_itemslistopen = true
				this.id_itemslist.show()
			else
				this.id_detail.setcolumn("fullcode")
				this.id_detail.object.fullcode[this.il_currrow] = ls_null
			end if
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.icode[this.il_currrow] = li_null
			this.id_detail.object.itemname[this.il_currrow] = ls_null
			this.id_detail.object.looseqty[this.il_currrow] = 1
			this.id_detail.object.bonusqty[this.il_currrow] = 0
			this.id_detail.object.saleprice[this.il_currrow] = li_null
			if long(this.id_detail.object.discperc.visible) = 1 then
				this.id_detail.object.discperc[this.il_currrow] = li_null
			else
				this.id_detail.object.discperc[this.il_currrow] = 0
			end if
			if long(this.id_detail.object.itemflatdisc.visible) = 1 then
				this.id_detail.object.itemflatdisc[this.il_currrow] = li_null
			else
				this.id_detail.object.itemflatdisc[this.il_currrow] = 0
			end if
			this.id_detail.object.unitsalestax[this.il_currrow] = li_null
			this.id_detail.object.gstperc[this.il_currrow] = li_null
		end if
	end if
	return li_errcode

// w_advancedsale.wf_returnsaleinvoice(long al_invid, ref string as_errortext) returns boolean
	boolean lb_commitflag = true
	if lb_commitflag and wf_deletesaleinvoice(al_invid) <> 0 then
		lb_commitflag = false
		as_errortext = "Some database problem occur during modification of this sale invoice"
	end if
	return lb_commitflag

// w_advancedsale.wf_retrievelist() returns long
	string[] ls_posted
	string ls_showrows = "N"
	integer[] li_salecategory
	integer li_invforlastdays = -3
	integer li_listrows
	datetime ld_invdate
	long ll_counter
	boolean lb_netamount
	ld_invdate = datetime(relativedate(today(), li_invforlastdays))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		if f_stringpreferences("ShowAllInvInCreditSaleList") = "Y" then
			li_salecategory[1] = 1
			li_salecategory[2] = 2
			li_salecategory[3] = 3
		else
			li_salecategory[1] = 1
			li_salecategory[2] = 2
		end if
	else
		li_salecategory[1] = this.ii_saletype
	end if
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 538 then
			ls_showrows = "Y"
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 539 then
			lb_netamount = true
			if integer(this.id_list.object.netamount.visible) = 0 then
				this.id_list.object.netamount.visible = true
				this.id_list.object.netamount_t.visible = true
			end if
		end if
	next
	if lb_netamount = false then
		this.id_list.object.netamount.visible = false
		this.id_list.object.netamount_t.visible = false
	end if
	if ls_showrows = "N" then
		this.tab_retrieve.tabpage_list.cb_retrieve.enabled = false
		this.tab_retrieve.tabpage_list.em_invno.enabled = false
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, ls_showrows, this.il_groupcode, this.ii_module)

// w_advancedsale.wf_fetchserverdate(boolean ab_checked) returns long
	if ab_checked then
		this.ib_fetchserverdate = true
	else
		this.ib_fetchserverdate = false
	end if
	return 0

// w_advancedsale.wf_findcustcode(string as_aliasname, ref integer ai_custcode) returns integer
	integer li_custcode
	integer ll_retflag
	string ls_itemname
	SQL SELECT accounts.acccode INTO :li_custcode FROM accounts , customer WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =customer.custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_custcode = li_custcode
		if isnull(ai_custcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_advancedsale.wf_setsaleitemdesc() returns long
	long ll_row
	long ll_icode
	long ll_packunits
	long ll_custcode
	long ll_rtcode
	long li_discstatus
	long li_itemdesc_status
	long li_flatdiscstatus
	double ld_saleprice
	double ld_flatdisc
	double ld_saleprice2
	double ld_saleprice3
	double ld_saleprice4
	double ld_saleprice5
	double ld_packsalestax
	double ld_unitsalestax
	double ld_gstperc1
	double ld_gstperc2
	double ld_discperc
	double ld_discperc2
	double ld_discperc3
	double ld_discperc4
	double ld_discperc5
	double ld_purprice
	double ld_rpp
	double ld_avgprice
	double ld_retailprice
	double ld_custitemcatdiscperc
	double ld_itemflatdisc
	integer li_discpercno
	integer li_itemdiscpercno
	integer li_defaultgst
	string ls_itemname
	s_arguements lstr_arg
	ll_row = this.id_detail.getrow()
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	li_defaultgst = this.id_master.getitemnumber(1, "dd_gstperc")
	open(w_arg_item)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		ll_icode = lstr_arg.l_code1
		SQL Select name , packunits , avgprice , purprice , recentpurprice , retailprice , saleprice , flatdisc , salediscperc , salediscperc2 , salediscperc3 , salediscperc4 , salediscperc5 , packsalestax , gstperc1 , gstperc2 INTO :ls_itemname, :ll_packunits, :ld_avgprice, :ld_purprice, :ld_rpp, :ld_retailprice, :ld_saleprice, :ld_flatdisc, :ld_discperc, :ld_discperc2, :ld_discperc3, :ld_discperc4, :ld_discperc5, :ld_packsalestax, :ld_gstperc1, :ld_gstperc2 From Item Where icode =:ll_icode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if f_stringpreferences("ChangeSPForItemDescInSale") = "Y" then
				if isnull(ll_packunits) or ll_packunits = 0 then
					ll_packunits = 1
				end if
				ld_unitsalestax = round(ld_packsalestax / ll_packunits, 2)
				li_discstatus = long(this.id_detail.object.discperc.visible)
				li_flatdiscstatus = long(this.id_detail.object.itemflatdisc.visible)
				if li_discstatus = 1 then
					li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
					if wf_getcustitemcatwisesalesdiscount(ll_icode, ll_custcode, ld_custitemcatdiscperc, ld_itemflatdisc) = true then
						this.id_detail.setitem(ll_row, "discperc", ld_custitemcatdiscperc)
						this.id_detail.setitem(ll_row, "itemflatdisc", ld_itemflatdisc)
					else
						choose case li_itemdiscpercno
						case 1
							this.id_detail.setitem(ll_row, "discperc", ld_discperc)
						case 2
							this.id_detail.setitem(ll_row, "discperc", ld_discperc2)
						case 3
							this.id_detail.setitem(ll_row, "discperc", ld_discperc3)
						case 4
							this.id_detail.setitem(ll_row, "discperc", ld_discperc4)
						case 5
							this.id_detail.setitem(ll_row, "discperc", ld_discperc5)
						end choose
					end if
				else
					this.id_detail.setitem(ll_row, "discperc", 0)
				end if
				choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
				case 1.0
					this.id_detail.setitem(ll_row, "packprice", ld_saleprice)
					this.id_detail.setitem(ll_row, "saleprice", ld_saleprice / ll_packunits)
				case 2.0
					this.id_detail.setitem(ll_row, "packprice", ld_saleprice2)
					this.id_detail.setitem(ll_row, "saleprice", ld_saleprice2 / ll_packunits)
				case 3.0
					this.id_detail.setitem(ll_row, "packprice", ld_saleprice3)
					this.id_detail.setitem(ll_row, "saleprice", ld_saleprice3 / ll_packunits)
				case 7.0
					this.id_detail.setitem(ll_row, "packprice", ld_saleprice4)
					this.id_detail.setitem(ll_row, "saleprice", ld_saleprice4 / ll_packunits)
				case 8.0
					this.id_detail.setitem(ll_row, "packprice", ld_saleprice5)
					this.id_detail.setitem(ll_row, "saleprice", ld_saleprice5 / ll_packunits)
				case 4.0
					this.id_detail.setitem(ll_row, "packprice", ld_purprice)
					this.id_detail.setitem(ll_row, "saleprice", ld_purprice / ll_packunits)
				case 5.0
					this.id_detail.setitem(ll_row, "packprice", ld_rpp)
					this.id_detail.setitem(ll_row, "saleprice", ld_rpp / ll_packunits)
				case else
					this.id_detail.setitem(ll_row, "packprice", ld_avgprice * ll_packunits)
					this.id_detail.setitem(ll_row, "saleprice", ld_avgprice)
				end choose
				this.id_detail.setitem(ll_row, "rate", ld_saleprice / ll_packunits)
				this.id_detail.setitem(ll_row, "retailprice", ld_retailprice / ll_packunits)
				if li_flatdiscstatus = 1 then
					this.id_detail.setitem(ll_row, "itemflatdisc", ld_flatdisc)
				else
					this.id_detail.setitem(ll_row, "itemflatdisc", 0)
				end if
				this.id_detail.setitem(ll_row, "unitsalestax", ld_unitsalestax)
				if li_defaultgst = 2 then
					this.id_detail.setitem(ll_row, "gstperc", ld_gstperc2)
				else
					this.id_detail.setitem(ll_row, "gstperc", ld_gstperc1)
				end if
			end if
			this.id_detail.setitem(ll_row, "saleitemdescription", ls_itemname)
			this.id_detail.setitem(ll_row, "DescICode", ll_icode)
		else
			messagebox("Item Validation", "Unable to get item information.")
		end if
	end if
	return 0

// w_advancedsale.wf_viewheader() returns integer
	s_dw_header ls_dw_header
	string[] ls_values
	string ls_posted
	long ll_row
	long ll_currrow
	integer li_protectdw
	datetime ldt_datetime
	if this.tab_retrieve.selectedtab <> 1 then
		return -1
	end if
	ls_posted = this.id_master.getitemstring(this.id_master.getrow(), "Posted")
	ls_dw_header.dw_header = this.id_master
	ls_dw_header.s_saletype = "Credit"
	ls_dw_header.l_code2 = this.ii_advancesalemodule
	if this.editflag = false and ls_posted = "Y" then
		ls_dw_header.i_protectdw = 1
	else
		ls_dw_header.i_protectdw = 0
	end if
	openwithparm(w_view_advsaleheader, ls_dw_header)
	ls_dw_header = message.powerobjectparm
	if ls_dw_header.i_closemode = -1 then
		return -1
	end if
	ll_row = this.id_master.getrow()
	ls_values = ls_dw_header.values
	if this.editflag = true then
		this.id_master.setitem(ll_row, "patientregno", ls_values[1])
		this.id_master.setitem(ll_row, "patientcode", long(ls_values[2]))
		this.id_master.setitem(ll_row, "doctcode", long(ls_values[3]))
		this.id_master.setitem(ll_row, "relationcode", long(ls_values[4]))
		this.id_master.setitem(ll_row, "wardcode", long(ls_values[5]))
		this.id_master.setitem(ll_row, "diseasecode", long(ls_values[6]))
		this.id_master.setitem(ll_row, "printwaranty", ls_values[7])
		this.id_master.setitem(ll_row, "printbatch", ls_values[8])
		this.id_master.setitem(ll_row, "invoicesize", ls_values[9])
		this.id_master.setitem(ll_row, "smancode", long(ls_values[10]))
		this.id_master.setitem(ll_row, "custrefno2", ls_values[11])
		this.id_master.setitem(ll_row, "custrefno3", ls_values[12])
		this.id_master.setitem(ll_row, "custrefno4", ls_values[13])
		this.id_master.setitem(ll_row, "printbalance", ls_values[14])
		this.id_master.setitem(ll_row, "billingdate", datetime(date(ls_values[15]), time(ls_values[16])))
		this.id_master.setitem(ll_row, "saletypecode", long(ls_values[17]))
	end if
	return 1

// w_advancedsale.wf_print() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_count
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			for ll_count = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
				this.id_print.retrieve(ll_count)
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			next
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	return li_errcode

// w_advancedsale.wf_get_patient(long al_prescode) returns long
	long ll_patientcode
	SQL Select patientcode INTO :ll_patientcode From PrescriptionHeader Where PresCode =:al_prescode USING sqlca;
	if sqlca.sqlcode = 0 then
		return ll_patientcode
	end if
	return -1

// w_advancedsale.wf_allowsalemodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM AdvSaleDetail WHERE AdvSaleInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_advancedsale.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_advancedsale.wf_checkgodownstock(long al_icode, long al_row, ref integer ai_rtcode, ref string as_errortext) returns boolean
	boolean retflag = true
	long ll_custcode
	long ll_packunits
	long ll_saleinvcode
	double ld_totalstock
	double ld_godownstock
	double ld_saleqty
	double ld_holdlooseqty
	double ld_desiredbonus
	integer li_gcode
	long ll_reorderqty
	long ll_qtysale
	long ll_bonus
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	if isnull(ll_custcode) then
		retflag = false
		as_errortext = "Validation Error: Select Customer "
	end if
	SQL Select packunits INTO :ll_packunits From item Where icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
	else
		if this.il_strategy = 2 then
			li_gcode = wf_getitemassociategcode(al_icode)
		end if
		if this.il_strategy = 1 then
			li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
		end if
	end if
	this.it_transobject.getitemstockall(al_icode, ld_totalstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item stock information can not be retrieved"
	end if
	this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if retflag then
		this.id_detail.setitem(al_row, "gcode", li_gcode)
		this.id_detail.setitem(al_row, "stock", ld_godownstock)
		this.id_detail.setitem(al_row, "totalstock", ld_totalstock)
	else
		retflag = false
		as_errortext = "Item can not be sold, its Stock is Zero"
	end if
	if f_stringpreferences("salepromptforreorder") = "Y" and ll_reorderqty > round(ld_godownstock / double(ll_packunits), 0) then
		messagebox("reorderqty", ll_reorderqty)
		messagebox("stock", ld_godownstock / double(ll_packunits))
		messagebox("Stock", "Stock for this item become~r~n less than ReorderQty")
	end if
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_totalstock)
	if f_stringpreferences("bonusinsale") = "Y" then
		this.id_footer.setitem(1, "bonusratio", trim(string(ll_qtysale)) + ":" + trim(string(ll_bonus)))
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			ld_holdlooseqty = this.id_detail.getitemnumber(al_row, "looseqty")
			if this.id_detail.getitemnumber(al_row, "qtysale") = 0.0 then
				ld_desiredbonus = 0
			else
				ld_desiredbonus = round(ld_holdlooseqty / double(this.id_detail.getitemnumber(al_row, "qtysale")) * double(this.id_detail.getitemnumber(al_row, "Bonus")), 4)
			end if
			if ld_holdlooseqty + ld_desiredbonus <= ld_godownstock then
				this.id_detail.setitem(al_row, "bonusqty", ld_desiredbonus)
			elseif ld_holdlooseqty > ld_godownstock then
				messagebox("Quantity Validation", "Quantity " + string(ld_holdlooseqty) + " exceeds stock " + string(ld_godownstock) + ".")
				this.id_detail.setitem(al_row, "looseqty", 1)
				this.id_detail.setitem(al_row, "bonusqty", 0)
			else
				ld_desiredbonus = messagebox("Problem allocating bonus", "Sale Qty = " + string(ld_holdlooseqty) + " ~r" + "Required Bonus = " + trim(string(ld_desiredbonus)) + " ~r" + "Stock available = " + trim(string(ld_godownstock)) + " ~r" + "Allocate possible bonus?", question!, yesno!, 2)
				if ld_desiredbonus = 1.0 then
					this.id_detail.setitem(al_row, "bonusqty", ld_godownstock - ld_holdlooseqty)
				else
					retflag = false
					this.id_detail.setitem(al_row, "bonusqty", 0)
				end if
			end if
		end if
	end if
	return retflag

// w_advancedsale.wf_closelist() returns 0
	this.ib_itemslistopen = false
	this.id_itemslist.hide()

// w_advancedsale.wf_isposted(long al_invcode) returns boolean
	long ll_count
	SQL SELECT Count ( AdvSaleInvCode ) INTO :ll_count FROM AdvSaleLedger WHERE AdvSaleInvCode =:al_invcode AND Posted ='Y' USING sqlca;
	if sqlca.sqlcode = 0 then
		if ll_count > 0 then
			return true
		else
			return false
		end if
		return
	end if
	return false

// w_advancedsale.wf_isdeleted(long al_invcode) returns boolean
	long ll_count
	SQL SELECT Count ( AdvSaleInvCode ) INTO :ll_count FROM AdvSaleLedger WHERE AdvSaleInvCode =:al_invcode and Deleted ='Y' USING sqlca;
	if sqlca.sqlcode = 0 then
		if ll_count > 0 then
			return true
		else
			return false
		end if
		return
	end if
	return false

// w_advancedsale.wf_isinvoiceinuse(long al_invoiceno) returns boolean
	long ll_found
	SQL Select count ( *) INTO :ll_found From AdvSaleLedger Where AdvSaleInvCode =:al_invoiceno and Posted ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_found = 0 or isnull(ll_found) then
			ll_found = 0
			SQL Select count ( *) INTO :ll_found From AdvSaleLedger With ( ReadPast , RowLock , UpdLock ) Where AdvSaleInvCode =:al_invoiceno USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ll_found = 0 then
					return true
				else
					return false
				end if
			else
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_advancedsale.wf_itemnetprice(double al_saleprice, double al_discperc, double al_itemflatdisc, long al_icode) returns integer
	double ld_saleprice
	double ld_recentpurprice
	double ld_discperc
	double ld_itemflatdisc
	double ld_itemnetprice
	double ld_salepricechangemargin
	double ld_lower_saleprice
	double ld_upper_saleprice
	integer li_packunits
	integer li_retmsgcode
	integer li_retcode = 1
	SQL Select item.RecentPurPrice , item.packunits , item.salepricechangemargin , item.saleprice INTO :ld_recentpurprice, :li_packunits, :ld_salepricechangemargin, :ld_saleprice From Item Where item.icode =:al_icode USING this.it_transobject;
	if li_packunits < 1 or isnull(li_packunits) then
		li_packunits = 1
	end if
	ld_itemnetprice = (al_saleprice - al_itemflatdisc) * (1.0 - al_discperc / 100.0)
	if ld_itemnetprice < ld_recentpurprice / li_packunits then
		li_retmsgcode = messagebox("Sale Validation", "Net Price " + string(ld_itemnetprice) + " is less than Recent Purchase Price~r~n Do you want to continue", question!, yesno!)
		if li_retmsgcode = 1 then
			li_retcode = 0
		else
			li_retcode = 1
		end if
	end if
	if li_retcode = 0 and f_stringpreferences("ApplySalePriceChangeMargin") = "Y" then
		ld_upper_saleprice = round(ld_saleprice / li_packunits * (1.0 + ld_salepricechangemargin * 0.01), 2)
		if ld_itemnetprice <= ld_upper_saleprice then
			li_retcode = 0
		else
			messagebox("Sale Price Validation", "Net Sale Price is violating Sale Price Change Margin~r~n~r~n" + "Net Sale Price         = " + string(ld_itemnetprice, "##,###,###0.00") + "~r~n~r~n" + "Actual Sale Price = " + string(round(ld_saleprice / li_packunits, 2), "##,###,###0.00") + "~r~n" + "Sale Price Change Margin = " + string(ld_salepricechangemargin, "###0.00") + "%~r~n" + "Sale Price Upper Limit = " + string(ld_upper_saleprice, "##,###,###0.00"), stopsign!)
			li_retcode = 1
		end if
	end if
	return li_retcode

// w_advancedsale.wf_post() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		openwithparm(w_arg_cust_sinvcode_linvcode2, this.ii_saletype)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			li_errcode = wf_locksaleinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_saleinvcount)
			if li_errcode = 0 then
				sqlca.postadvsaleledger(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode, lstr_arginfo.l_code3, lstr_arginfo.l_code4)
				if sqlca.sqlcode <> 0 then
					li_errcode = -1
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again")
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_saleinvcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return li_errcode

// w_advancedsale.wf_postsaleheaderwise() returns integer
	integer li_errcode
	integer li_count
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_postsaleheaderwise)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			SQL Select count ( *) INTO :ll_saleinvcount From saleledger WITH ( UPDLOCK HOLDLOCK ) Where saleledger.headerinvno Between :lstr_arginfo.l_code1 AND :lstr_arginfo.l_code2 AND saleledger.Posted ='N' AND ImpactInventory ='Y' USING sqlca;
			li_errcode = sqlca.sqlcode
			if li_errcode = 0 then
				sqlca.postsaleledgerheaderwise(lstr_arginfo.l_code1, lstr_arginfo.l_code2, 2, ll_salesmancode, lstr_arginfo.l_code3, this.ic_impactinventory)
				if sqlca.sqlcode <> 0 then
					li_errcode = -1
				end if
				if this.ii_type = 2 then
					sqlca.postsaleledgerheaderwise(lstr_arginfo.l_code1, lstr_arginfo.l_code2, 1, ll_salesmancode, lstr_arginfo.l_code3, this.ic_impactinventory)
					if sqlca.sqlcode <> 0 then
						li_errcode = -1
					end if
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again")
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_saleinvcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return li_errcode

// w_advancedsale.wf_post_wrt_patient() returns integer
