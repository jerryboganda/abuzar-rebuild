// window w_selection_reprioritize_item_stock (reportformat)  ancestor: window

// w_selection_reprioritize_item_stock.create() returns 0
	this.rb_grouping = create rb_grouping
	this.rb_all = create rb_all
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.gb_stockreporttype = create gb_stockreporttype
	this.control = {this.rb_grouping, this.rb_all, this.cb_cancel, this.cb_ok, this.gb_stockreporttype}

// w_selection_reprioritize_item_stock.destroy() returns 0
	destroy this.rb_grouping
	destroy this.rb_all
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.gb_stockreporttype

// w_selection_reprioritize_item_stock.open() returns long
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// w_selection_reprioritize_item_stock.close() returns long
	closewithreturn(this, this.is_selectedreport)
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	close(parent)
	return ::message.returnvalue

// cb_ok.clicked() returns long
	if parent.rb_all.checked = true then
		parent.is_selectedreport = "A"
	elseif parent.rb_grouping.checked = true then
		parent.is_selectedreport = "G"
	end if
	close(parent)
	return ::message.returnvalue
