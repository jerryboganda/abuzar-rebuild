// window w_select_supp_manf (reportformat)  ancestor: window

// w_select_supp_manf.ue_close(integer ai_status) returns 0
	if this.rb_supp.checked = true then
		closewithreturn(this, 1)
		return
	end if
	closewithreturn(this, 2)

// w_select_supp_manf.create() returns 0
	this.cb_ok = create cb_ok
	this.rb_manf = create rb_manf
	this.rb_supp = create rb_supp
	this.gb_format = create gb_format
	this.control = {this.cb_ok, this.rb_manf, this.rb_supp, this.gb_format}

// w_select_supp_manf.destroy() returns 0
	destroy this.cb_ok
	destroy this.rb_manf
	destroy this.rb_supp
	destroy this.gb_format

// w_select_supp_manf.open() returns long
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// cb_ok.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	parent.post event ue_close(1)
	return ::message.returnvalue
