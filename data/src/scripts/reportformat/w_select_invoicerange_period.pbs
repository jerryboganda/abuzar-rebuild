// window w_select_invoicerange_period (reportformat)  ancestor: window

// w_select_invoicerange_period.ue_close(integer ai_status) returns 0
	if this.rb_range.checked = true then
		closewithreturn(this, 1)
		return
	end if
	if this.rb_period.checked = true then
		closewithreturn(this, 2)
	end if

// w_select_invoicerange_period.create() returns 0
	this.cb_ok = create cb_ok
	this.rb_period = create rb_period
	this.rb_range = create rb_range
	this.gb_format = create gb_format
	this.control = {this.cb_ok, this.rb_period, this.rb_range, this.gb_format}

// w_select_invoicerange_period.destroy() returns 0
	destroy this.cb_ok
	destroy this.rb_period
	destroy this.rb_range
	destroy this.gb_format

// w_select_invoicerange_period.open() returns long
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// cb_ok.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	parent.post event ue_close(1)
	return ::message.returnvalue
