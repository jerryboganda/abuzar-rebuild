// window w_selectformat_supplierledger_portrait (reportformat)  ancestor: window

// w_selectformat_supplierledger_portrait.ue_close(integer ai_status) returns 0
	if this.rb_standard.checked = true then
		closewithreturn(this, 1)
		return
	end if
	if this.rb_format2.checked = true then
		closewithreturn(this, 2)
		return
	end if
	if this.rb_standardwithgridlines.checked = true then
		closewithreturn(this, 3)
		return
	end if
	if this.rb_standard_unpostedtrans.checked = true then
		closewithreturn(this, 4)
	end if

// w_selectformat_supplierledger_portrait.create() returns 0
	this.rb_standard_unpostedtrans = create rb_standard_unpostedtrans
	this.rb_standardwithgridlines = create rb_standardwithgridlines
	this.cb_ok = create cb_ok
	this.rb_format2 = create rb_format2
	this.rb_standard = create rb_standard
	this.gb_format = create gb_format
	this.control = {this.rb_standard_unpostedtrans, this.rb_standardwithgridlines, this.cb_ok, this.rb_format2, this.rb_standard, this.gb_format}

// w_selectformat_supplierledger_portrait.destroy() returns 0
	destroy this.rb_standard_unpostedtrans
	destroy this.rb_standardwithgridlines
	destroy this.cb_ok
	destroy this.rb_format2
	destroy this.rb_standard
	destroy this.gb_format

// w_selectformat_supplierledger_portrait.open() returns long
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// cb_ok.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	parent.post event ue_close(1)
	return ::message.returnvalue
