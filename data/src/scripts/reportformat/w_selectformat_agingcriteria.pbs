// window w_selectformat_agingcriteria (reportformat)  ancestor: window

// w_selectformat_agingcriteria.ue_close(integer ai_status) returns 0
	if this.rb_general.checked = true then
		closewithreturn(this, 1)
		return
	end if
	if this.rb_salesman.checked = true then
		closewithreturn(this, 2)
		return
	end if
	if this.rb_subarea.checked = true then
		closewithreturn(this, 3)
	end if

// w_selectformat_agingcriteria.create() returns 0
	this.rb_subarea = create rb_subarea
	this.cb_ok = create cb_ok
	this.rb_salesman = create rb_salesman
	this.rb_general = create rb_general
	this.gb_format = create gb_format
	this.control = {this.rb_subarea, this.cb_ok, this.rb_salesman, this.rb_general, this.gb_format}

// w_selectformat_agingcriteria.destroy() returns 0
	destroy this.rb_subarea
	destroy this.cb_ok
	destroy this.rb_salesman
	destroy this.rb_general
	destroy this.gb_format

// w_selectformat_agingcriteria.open() returns long
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// cb_ok.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	parent.post event ue_close(1)
	return ::message.returnvalue
