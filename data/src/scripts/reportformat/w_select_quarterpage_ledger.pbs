// window w_select_quarterpage_ledger (reportformat)  ancestor: window

// w_select_quarterpage_ledger.ue_close(integer ai_status) returns 0 [event]
	if this.rb_cust.checked = true then
		closewithreturn(this, 1)
		return
	end if
	if this.rb_cust_summary.checked = true then
		closewithreturn(this, 2)
		return
	end if
	if this.rb_custcat.checked = true then
		closewithreturn(this, 3)
		return
	end if
	if this.rb_custcat_summary.checked = true then
		closewithreturn(this, 4)
		return
	end if
	if this.rb_custcat_half.checked = true then
		closewithreturn(this, 5)
	end if

// w_select_quarterpage_ledger.create() returns 0 [event]
	this.rb_custcat_half = create rb_custcat_half
	this.rb_custcat_summary = create rb_custcat_summary
	this.rb_custcat = create rb_custcat
	this.cb_ok = create cb_ok
	this.rb_cust_summary = create rb_cust_summary
	this.rb_cust = create rb_cust
	this.gb_format = create gb_format
	this.control = {this.rb_custcat_half, this.rb_custcat_summary, this.rb_custcat, this.cb_ok, this.rb_cust_summary, this.rb_cust, this.gb_format}

// w_select_quarterpage_ledger.destroy() returns 0 [event]
	destroy this.rb_custcat_half
	destroy this.rb_custcat_summary
	destroy this.rb_custcat
	destroy this.cb_ok
	destroy this.rb_cust_summary
	destroy this.rb_cust
	destroy this.gb_format

// w_select_quarterpage_ledger.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// cb_ok.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	parent.post event ue_close(1)
	return ::message.returnvalue
