// window w_selectaccountsfromvoucher (reportformat)  ancestor: window

// w_selectaccountsfromvoucher.ue_close(integer ai_status) returns 0 [event]
	closewithreturn(this, this.istr_arg)

// w_selectaccountsfromvoucher.create() returns 0 [event]
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.cb_retrieve = create cb_retrieve
	this.dw_control2 = create dw_control2
	this.dw_control1 = create dw_control1
	this.gb_1 = create gb_1
	this.gb_2 = create gb_2
	this.control = {this.cb_cancel, this.cb_ok, this.cb_retrieve, this.dw_control2, this.dw_control1, this.gb_1, this.gb_2}

// w_selectaccountsfromvoucher.destroy() returns 0 [event]
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.cb_retrieve
	destroy this.dw_control2
	destroy this.dw_control1
	destroy this.gb_1
	destroy this.gb_2

// w_selectaccountsfromvoucher.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	this.dw_control1.settransobject(sqlca)
	this.dw_control1.insertrow(0)
	this.dw_control2.settransobject(sqlca)
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ll_totrows
	long ll_loopcounter
	long ll_arraycount
	ll_arraycount = 1
	ll_totrows = parent.dw_control2.rowcount()
	if ll_totrows > 0 then
		for ll_loopcounter = 1 to ll_totrows
			if parent.dw_control2.getitemnumber(ll_loopcounter, "selected") = 1.0 then
				parent.istr_arg.la_longlist[ll_arraycount] = parent.dw_control2.getitemnumber(ll_loopcounter, "rowid")
				ll_arraycount = ll_arraycount + 1
			end if
		next
	end if
	parent.istr_arg.l_code1 = parent.dw_control1.getitemnumber(1, "type")
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// cb_retrieve.clicked() returns long [event]
	long ll_rtncode
	if parent.dw_control1.accepttext() = 1 then
		parent.dw_control1.setfocus()
	else
		return ::message.returnvalue
	end if
	if parent.dw_control1.getitemnumber(1, "svouchcode") <= 0.0 then
		parent.dw_control1.scrolltorow(1)
		parent.dw_control1.setcolumn("svouchcode")
		parent.dw_control1.setfocus()
		return ::message.returnvalue
	end if
	if parent.dw_control1.getitemnumber(1, "lvouchcode") <= 0.0 then
		parent.dw_control1.scrolltorow(1)
		parent.dw_control1.setcolumn("lvouchcode")
		parent.dw_control1.setfocus()
		return ::message.returnvalue
	end if
	if parent.dw_control1.getitemnumber(1, "svouchcode") <= parent.dw_control1.getitemnumber(1, "lvouchcode") then
		ll_rtncode = parent.dw_control2.retrieve(parent.dw_control1.getitemnumber(1, "type"), parent.dw_control1.getitemnumber(1, "svouchcode"), parent.dw_control1.getitemnumber(1, "lvouchcode"))
		if ll_rtncode < 0 then
			messagebox("Problem", "Can not retrieve datawindow")
			return ::message.returnvalue
		end if
	else
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_control2.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// dw_control1.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1
