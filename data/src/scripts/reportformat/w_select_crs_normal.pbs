// window w_select_crs_normal (reportformat)  ancestor: window

// w_select_crs_normal.ue_close(integer ai_status) returns 0 [event]
	if this.rb_standard.checked = true then
		closewithreturn(this, "N")
		return
	end if
	closewithreturn(this, "Y")

// w_select_crs_normal.create() returns 0 [event]
	this.cb_ok = create cb_ok
	this.rb_crs = create rb_crs
	this.rb_standard = create rb_standard
	this.gb_format = create gb_format
	this.control = {this.cb_ok, this.rb_crs, this.rb_standard, this.gb_format}

// w_select_crs_normal.destroy() returns 0 [event]
	destroy this.cb_ok
	destroy this.rb_crs
	destroy this.rb_standard
	destroy this.gb_format

// w_select_crs_normal.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// cb_ok.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	parent.post event ue_close(1)
	return ::message.returnvalue
