// window w_select_postedsaleordercategory (reportformat)  ancestor: w_arguements

// w_select_postedsaleordercategory.create() returns 0 [event]
	call super::create

// w_select_postedsaleordercategory.destroy() returns 0 [event]
	call super::destroy

// w_select_postedsaleordercategory.open() returns long [event]
	long ancestorreturnvalue
	integer li_rtncode
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	ancestorreturnvalue = super::open()
	li_rtncode = this.dw_control.getchild("socatcode", this.idc_child)
	if li_rtncode = -1 then
		messagebox("Error", "Problem is Retrieving Sale Order Categories")
		post event ue_close(-1)
		return ::message.returnvalue
	end if
	this.idc_child.settransobject(sqlca)
	li_rtncode = this.idc_child.retrieve()
	if this.idc_child.rowcount() <= 0 then
		messagebox("Error", "No Sale Order Category Selected~r~nPlease assign some sale order Category and try again.")
		post event ue_close(-1)
	else
		this.dw_control.settransobject(sqlca)
		this.dw_control.insertrow(0)
		this.dw_control.scrolltorow(0)
	end if
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// w_select_postedsaleordercategory.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "socatcode")
	if parent.idc_child.getrow() > 0 then
		parent.istr_arg.s_name1 = parent.idc_child.getitemstring(parent.idc_child.getrow(), "name")
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
