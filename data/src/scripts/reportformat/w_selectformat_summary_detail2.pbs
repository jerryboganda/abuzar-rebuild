// window w_selectformat_summary_detail2 (reportformat)  ancestor: window

// w_selectformat_summary_detail2.ue_close(integer ai_status) returns 0 [event]
	if this.rb_summary.checked = true then
		closewithreturn(this, 1)
		return
	end if
	if this.rb_detail.checked = true then
		closewithreturn(this, 2)
		return
	end if
	if this.rb_detail2.checked = true then
		closewithreturn(this, 3)
		return
	end if
	if this.rb_detail3.checked = true then
		closewithreturn(this, 4)
		return
	end if
	if this.rb_purchasesummarized.checked = true then
		closewithreturn(this, 5)
		return
	end if
	if this.rb_detail3_patient.checked = true then
		closewithreturn(this, 6)
		return
	end if
	if this.rb_summary2.checked = true then
		closewithreturn(this, 7)
	end if

// w_selectformat_summary_detail2.create() returns 0 [event]
	this.rb_summary2 = create rb_summary2
	this.rb_detail3_patient = create rb_detail3_patient
	this.rb_purchasesummarized = create rb_purchasesummarized
	this.rb_detail3 = create rb_detail3
	this.rb_detail2 = create rb_detail2
	this.cb_ok = create cb_ok
	this.rb_detail = create rb_detail
	this.rb_summary = create rb_summary
	this.gb_format = create gb_format
	this.control = {this.rb_summary2, this.rb_detail3_patient, this.rb_purchasesummarized, this.rb_detail3, this.rb_detail2, this.cb_ok, this.rb_detail, this.rb_summary, this.gb_format}

// w_selectformat_summary_detail2.destroy() returns 0 [event]
	destroy this.rb_summary2
	destroy this.rb_detail3_patient
	destroy this.rb_purchasesummarized
	destroy this.rb_detail3
	destroy this.rb_detail2
	destroy this.cb_ok
	destroy this.rb_detail
	destroy this.rb_summary
	destroy this.gb_format

// w_selectformat_summary_detail2.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// cb_ok.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	parent.post event ue_close(1)
	return ::message.returnvalue
