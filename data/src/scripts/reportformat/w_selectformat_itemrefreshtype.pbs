// window w_selectformat_itemrefreshtype (reportformat)  ancestor: window

// w_selectformat_itemrefreshtype.ue_close(integer ai_status) returns 0
	long ll_retcode
	ll_retcode = this.dw_control.object.itemrefreshtype[1]
	closewithreturn(this, ll_retcode)

// w_selectformat_itemrefreshtype.create() returns 0
	this.dw_control = create dw_control
	this.cb_ok = create cb_ok
	this.gb_format = create gb_format
	this.control = {this.dw_control, this.cb_ok, this.gb_format}

// w_selectformat_itemrefreshtype.destroy() returns 0
	destroy this.dw_control
	destroy this.cb_ok
	destroy this.gb_format

// w_selectformat_itemrefreshtype.open() returns long
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	this.dw_control.settransobject(sqlca)
	this.dw_control.retrieve()
	this.dw_control.setrow(1)
	this.dw_control.scrolltorow(1)
	return ::message.returnvalue

// cb_ok.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	parent.post event ue_close(1)
	return ::message.returnvalue
