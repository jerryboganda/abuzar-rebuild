// window w_select_populate_customer (reportformat)  ancestor: window

// w_select_populate_customer.ue_close(integer ai_status) returns 0 [event]
	if this.rb_area.checked = true then
		closewithreturn(this, "A")
		return
	end if
	if this.rb_subarea.checked = true then
		closewithreturn(this, "S")
		return
	end if
	if this.rb_county.checked = true then
		closewithreturn(this, "C")
		return
	end if
	if this.rb_custcat.checked = true then
		closewithreturn(this, "T")
		return
	end if
	if this.rb_sman.checked = true then
		closewithreturn(this, "P")
		return
	end if
	if this.rb_opendate.checked = true then
		closewithreturn(this, "O")
	end if

// w_select_populate_customer.create() returns 0 [event]
	this.rb_opendate = create rb_opendate
	this.rb_sman = create rb_sman
	this.rb_custcat = create rb_custcat
	this.rb_county = create rb_county
	this.cb_ok = create cb_ok
	this.rb_subarea = create rb_subarea
	this.rb_area = create rb_area
	this.gb_format = create gb_format
	this.control = {this.rb_opendate, this.rb_sman, this.rb_custcat, this.rb_county, this.cb_ok, this.rb_subarea, this.rb_area, this.gb_format}

// w_select_populate_customer.destroy() returns 0 [event]
	destroy this.rb_opendate
	destroy this.rb_sman
	destroy this.rb_custcat
	destroy this.rb_county
	destroy this.cb_ok
	destroy this.rb_subarea
	destroy this.rb_area
	destroy this.gb_format

// w_select_populate_customer.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// cb_ok.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	parent.post event ue_close(1)
	return ::message.returnvalue
