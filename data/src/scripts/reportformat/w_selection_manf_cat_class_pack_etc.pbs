// window w_selection_manf_cat_class_pack_etc (reportformat)  ancestor: window

// w_selection_manf_cat_class_pack_etc.create() returns 0
	this.rb_uppersaleqtylimit = create rb_uppersaleqtylimit
	this.rb_salepricechangemargin = create rb_salepricechangemargin
	this.rb_taxable = create rb_taxable
	this.rb_pct = create rb_pct
	this.rb_stax = create rb_stax
	this.rb_stax2 = create rb_stax2
	this.rb_stax1 = create rb_stax1
	this.rb_maxsalediscperc = create rb_maxsalediscperc
	this.rb_packingwise = create rb_packingwise
	this.rb_classwise = create rb_classwise
	this.rb_categorywise = create rb_categorywise
	this.rb_manufacturerwise = create rb_manufacturerwise
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.gb_stockreporttype = create gb_stockreporttype
	this.control = {this.rb_uppersaleqtylimit, this.rb_salepricechangemargin, this.rb_taxable, this.rb_pct, this.rb_stax, this.rb_stax2, this.rb_stax1, this.rb_maxsalediscperc, this.rb_packingwise, this.rb_classwise, this.rb_categorywise, this.rb_manufacturerwise, this.cb_cancel, this.cb_ok, this.gb_stockreporttype}

// w_selection_manf_cat_class_pack_etc.destroy() returns 0
	destroy this.rb_uppersaleqtylimit
	destroy this.rb_salepricechangemargin
	destroy this.rb_taxable
	destroy this.rb_pct
	destroy this.rb_stax
	destroy this.rb_stax2
	destroy this.rb_stax1
	destroy this.rb_maxsalediscperc
	destroy this.rb_packingwise
	destroy this.rb_classwise
	destroy this.rb_categorywise
	destroy this.rb_manufacturerwise
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.gb_stockreporttype

// w_selection_manf_cat_class_pack_etc.open() returns long
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// w_selection_manf_cat_class_pack_etc.close() returns long
	closewithreturn(this, this.is_selectedreport)
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	close(parent)
	return ::message.returnvalue

// cb_ok.clicked() returns long
	if parent.rb_manufacturerwise.checked = true then
		parent.is_selectedreport = "M"
	elseif parent.rb_categorywise.checked = true then
		parent.is_selectedreport = "C"
	elseif parent.rb_classwise.checked = true then
		parent.is_selectedreport = "L"
	elseif parent.rb_packingwise.checked = true then
		parent.is_selectedreport = "P"
	elseif parent.rb_pct.checked = true then
		parent.is_selectedreport = "T"
	elseif parent.rb_stax.checked = true then
		parent.is_selectedreport = "S"
	elseif parent.rb_maxsalediscperc.checked = true then
		parent.is_selectedreport = "item_maxsalediscperc"
	elseif parent.rb_stax1.checked = true then
		parent.is_selectedreport = "item_gstperc1"
	elseif parent.rb_stax2.checked = true then
		parent.is_selectedreport = "item_gstperc2"
	elseif parent.rb_salepricechangemargin.checked = true then
		parent.is_selectedreport = "item_salepricechangemargin"
	elseif parent.rb_uppersaleqtylimit.checked = true then
		parent.is_selectedreport = "item_uppersaleqtylimit"
	elseif parent.rb_taxable.checked = true then
		parent.is_selectedreport = "item_taxable"
	end if
	close(parent)
	return ::message.returnvalue
