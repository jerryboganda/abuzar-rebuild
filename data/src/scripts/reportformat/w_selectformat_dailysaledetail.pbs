// window w_selectformat_dailysaledetail (reportformat)  ancestor: window

// w_selectformat_dailysaledetail.ue_close(integer ai_status) returns 0 [event]
	if this.rb_format1.checked = true then
		closewithreturn(this, 1)
		return
	end if
	if this.rb_format2.checked = true then
		closewithreturn(this, 2)
		return
	end if
	if this.rb_format3.checked = true then
		closewithreturn(this, 3)
		return
	end if
	if this.rb_format4.checked = true then
		closewithreturn(this, 4)
		return
	end if
	if this.rb_format5.checked = true then
		closewithreturn(this, 5)
		return
	end if
	if this.rb_format6.checked = true then
		closewithreturn(this, 6)
		return
	end if
	if this.rb_format7.checked = true then
		closewithreturn(this, 7)
		return
	end if
	if this.rb_format8.checked = true then
		closewithreturn(this, 8)
		return
	end if
	if this.rb_format9.checked = true then
		closewithreturn(this, 9)
		return
	end if
	closewithreturn(this, 10)

// w_selectformat_dailysaledetail.create() returns 0 [event]
	this.rb_format10 = create rb_format10
	this.rb_format9 = create rb_format9
	this.rb_format8 = create rb_format8
	this.rb_format7 = create rb_format7
	this.rb_format6 = create rb_format6
	this.rb_format5 = create rb_format5
	this.rb_format4 = create rb_format4
	this.rb_format3 = create rb_format3
	this.cb_ok = create cb_ok
	this.rb_format2 = create rb_format2
	this.rb_format1 = create rb_format1
	this.gb_format = create gb_format
	this.control = {this.rb_format10, this.rb_format9, this.rb_format8, this.rb_format7, this.rb_format6, this.rb_format5, this.rb_format4, this.rb_format3, this.cb_ok, this.rb_format2, this.rb_format1, this.gb_format}

// w_selectformat_dailysaledetail.destroy() returns 0 [event]
	destroy this.rb_format10
	destroy this.rb_format9
	destroy this.rb_format8
	destroy this.rb_format7
	destroy this.rb_format6
	destroy this.rb_format5
	destroy this.rb_format4
	destroy this.rb_format3
	destroy this.cb_ok
	destroy this.rb_format2
	destroy this.rb_format1
	destroy this.gb_format

// w_selectformat_dailysaledetail.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// cb_ok.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	parent.post event ue_close(1)
	return ::message.returnvalue
