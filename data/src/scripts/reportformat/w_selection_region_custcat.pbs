// window w_selection_region_custcat (reportformat)  ancestor: window

// w_selection_region_custcat.create() returns 0
	this.rb_custcatwise = create rb_custcatwise
	this.rb_regionwise = create rb_regionwise
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.gb_commandgroupbox = create gb_commandgroupbox
	this.gb_stockreporttype = create gb_stockreporttype
	this.control = {this.rb_custcatwise, this.rb_regionwise, this.cb_cancel, this.cb_ok, this.gb_commandgroupbox, this.gb_stockreporttype}

// w_selection_region_custcat.destroy() returns 0
	destroy this.rb_custcatwise
	destroy this.rb_regionwise
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.gb_commandgroupbox
	destroy this.gb_stockreporttype

// w_selection_region_custcat.open() returns long
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// w_selection_region_custcat.close() returns long
	closewithreturn(this, this.is_selectedreport)
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	close(parent)
	return ::message.returnvalue

// cb_ok.clicked() returns long
	if parent.rb_regionwise.checked = true then
		parent.is_selectedreport = "R"
	elseif parent.rb_custcatwise.checked = true then
		parent.is_selectedreport = "Z"
	end if
	close(parent)
	return ::message.returnvalue
