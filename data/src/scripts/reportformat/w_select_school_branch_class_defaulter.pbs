// window w_select_school_branch_class_defaulter (reportformat)  ancestor: window

// w_select_school_branch_class_defaulter.ue_close(integer ai_status) returns 0 [event]
	if this.rb_format1.checked = true then
		closewithreturn(this, 1)
		return
	end if
	if this.rb_format2.checked = true then
		closewithreturn(this, 2)
		return
	end if
	if this.rb_format3.checked = true then
		closewithreturn(this, 3)
		return
	end if
	if this.rb_format4.checked = true then
		closewithreturn(this, 4)
	end if

// w_select_school_branch_class_defaulter.create() returns 0 [event]
	this.rb_format4 = create rb_format4
	this.rb_format3 = create rb_format3
	this.cb_ok = create cb_ok
	this.rb_format2 = create rb_format2
	this.rb_format1 = create rb_format1
	this.gb_format = create gb_format
	this.control = {this.rb_format4, this.rb_format3, this.cb_ok, this.rb_format2, this.rb_format1, this.gb_format}

// w_select_school_branch_class_defaulter.destroy() returns 0 [event]
	destroy this.rb_format4
	destroy this.rb_format3
	destroy this.cb_ok
	destroy this.rb_format2
	destroy this.rb_format1
	destroy this.gb_format

// w_select_school_branch_class_defaulter.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// cb_ok.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	parent.post event ue_close(1)
	return ::message.returnvalue
