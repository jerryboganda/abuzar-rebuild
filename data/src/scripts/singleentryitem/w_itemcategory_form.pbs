// window w_itemcategory_form (singleentryitem)  ancestor: w_single_entry

// w_itemcategory_form.wf_duplicatecode(string as_manfcode) returns boolean
	integer li_manfcode
	integer li_dupmanfcode
	li_manfcode = integer(as_manfcode)
	SQL SELECT manufacturer.manfcode INTO :li_dupmanfcode FROM manufacturer WHERE manufacturer.manfcode =:li_manfcode USING sqlca;
	if li_dupmanfcode = li_manfcode then
		return true
	end if
	return false

// w_itemcategory_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM ItemCategory WHERE ItemCategory.name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_itemcategory_form.create() returns 0
	call super::create

// w_itemcategory_form.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_itemcategory_form.activate() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_itemcategory_form.ue_detail() returns 0
	call super::ue_detail

// w_itemcategory_form.ue_newform() returns 0
	call super::ue_newform

// w_itemcategory_form.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "ItemCategory"
	return ::message.returnvalue
