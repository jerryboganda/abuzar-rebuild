// window w_itemcategory_form (singleentryitem)  ancestor: w_single_entry

// w_itemcategory_form.wf_duplicatecode(string as_manfcode) returns boolean
	integer li_manfcode
	integer li_dupmanfcode
	li_manfcode = integer(as_manfcode)
	SQL SELECT manufacturer.manfcode INTO :li_dupmanfcode FROM manufacturer WHERE manufacturer.manfcode =:li_manfcode USING sqlca;
	if li_dupmanfcode = li_manfcode then
		return true
	end if
	return false

// w_itemcategory_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM ItemCategory WHERE ItemCategory.name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_itemcategory_form.create() returns 0 [event]
	call super::create

// w_itemcategory_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_itemcategory_form.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_itemcategory_form.ue_detail() returns 0 [event]
	call super::ue_detail

// w_itemcategory_form.ue_newform() returns 0 [event]
	call super::ue_newform

// w_itemcategory_form.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "ItemCategory"
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	integer li_icatcode
	integer li_dupicatcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "icatcode"
		li_icatcode = integer(data)
		SQL SELECT ItemCategory.icatcode INTO :li_dupicatcode FROM ItemCategory WHERE ItemCategory.icatcode =:li_icatcode USING sqlca;
		if sqlca.sqlcode = 0 and li_dupicatcode = li_icatcode then
			rt_code = 1
			messagebox("Class Code Validation", "Duplicate Power Code, Enter some other class code")
		end if
	case "name"
		if parent.parent.parent.wf_duplicatename(data) then
			messagebox("Name Validation", "Duplication Name Error~n~rPlease Choose Some Other Name")
			return 1
		end if
	case "numericalfactor"
		if data = "" or isnull(data) then
			return 1
		end if
	end choose
	return rt_code

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "code"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	case "numericalfactor"
		if data = "" or isnull(data) then
			messagebox("Numerical Factor Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	end choose
	return 1
