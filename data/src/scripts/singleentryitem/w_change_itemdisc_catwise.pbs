// window w_change_itemdisc_catwise (singleentryitem)  ancestor: w_single_entry

// w_change_itemdisc_catwise.wf_changedisc() returns integer
	long ll_code
	long ll_salesmancode
	long ll_rtncode
	long ll_salediscno
	double ld_saledisc
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_msg_text
	integer li_yesno
	if f_validatedw(this.id_detail) < 0 then
		return 0
	end if
	ls_msg_text = "Sale Discount of all those Items~r~nwhich belong to selected "
	if this.il_changeoption = 1 then
		ls_msg_text = ls_msg_text + "Manufacturer"
	elseif this.il_changeoption = 2 then
		ls_msg_text = ls_msg_text + "Item Category"
	elseif this.il_changeoption = 3 then
		ls_msg_text = ls_msg_text + "Item Class"
	elseif this.il_changeoption = 4 then
		ls_msg_text = ls_msg_text + "Item Packing"
	end if
	ls_msg_text = ls_msg_text + " will be Changed.~r~nAre You Sure you want to do this?"
	li_yesno = messagebox("Sale Discount Change", ls_msg_text, exclamation!, yesno!, 2)
	if li_yesno = 2 then
		return 0
	end if
	ld_saledisc = this.id_detail.getitemdecimal(1, "saledisc")
	ll_salediscno = this.id_detail.getitemnumber(1, "salediscno")
	if this.il_changeoption = 1 then
		ll_code = this.id_detail.getitemnumber(1, "manfcode")
	elseif this.il_changeoption = 2 then
		ll_code = this.id_detail.getitemnumber(1, "icatcode")
	elseif this.il_changeoption = 3 then
		ll_code = this.id_detail.getitemnumber(1, "iccode")
	elseif this.il_changeoption = 4 then
		ll_code = this.id_detail.getitemnumber(1, "packcode")
	end if
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		ll_rtncode = -1
		return ll_rtncode
	end if
	ll_salesmancode = gl_usercode
	SQL rollback USING this.it_transobject;
	setpointer(hourglass!)
	if this.il_changeoption = 1 then
		ll_rtncode = f_generateitemlog(this.id_detail, "item_changedisc_manfwise", this.it_transobject, ldt_server_datetime)
	elseif this.il_changeoption = 2 then
		ll_rtncode = f_generateitemlog(this.id_detail, "item_changedisc", this.it_transobject, ldt_server_datetime)
	elseif this.il_changeoption = 3 then
		ll_rtncode = f_generateitemlog(this.id_detail, "item_changedisc_classwise", this.it_transobject, ldt_server_datetime)
	elseif this.il_changeoption = 4 then
		ll_rtncode = f_generateitemlog(this.id_detail, "item_changedisc_packwise", this.it_transobject, ldt_server_datetime)
	end if
	if ll_rtncode >= 0 then
		ll_rtncode = this.it_transobject.changeitemdisc(this.il_changeoption, ll_code, ll_salediscno, ld_saledisc, gl_usercode, ldt_server_datetime)
		if this.it_transobject.sqlcode = 0 and ll_rtncode = 0 then
			SQL commit USING this.it_transobject;
			messagebox("Save Changes", "Discount has been changed")
		else
			SQL rollback USING this.it_transobject;
			messagebox("Save Changes", "Some database problem occurs,~n~rSale Discount can not be changed.~r~n" + this.it_transobject.sqlerrtext)
		end if
	else
		SQL rollback USING this.it_transobject;
		messagebox("Save Changes", "Some database problem occur in generating itemlog,~n~rSale Discount can not be changed.~r~n" + this.it_transobject.sqlerrtext)
	end if
	setpointer(arrow!)
	return ll_rtncode

// w_change_itemdisc_catwise.create() returns 0
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_changeitemsdisc_catwise" then
		this.menuid = create m_changeitemsdisc_catwise
	end if

// w_change_itemdisc_catwise.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_change_itemdisc_catwise.activate() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_change_itemdisc_catwise.closequery() returns long
	return ::message.returnvalue

// w_change_itemdisc_catwise.open() returns long
	long ancestorreturnvalue
	integer li_counter
	string ls_stringparam
	ancestorreturnvalue = super::open()
	this.it_transobject = create u_transaction
	SQL start USING this.it_transobject;
	return ::message.returnvalue

// w_change_itemdisc_catwise.close() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	SQL stop USING this.it_transobject;
	destroy this.it_transobject
	return ::message.returnvalue

// w_change_itemdisc_catwise.ue_postopen() returns 0
	string ls_stringparam
	integer li_null
	call super::ue_postopen
	ls_stringparam = message.stringparm
	setredraw(false)
	if ls_stringparam = "M" then
		this.id_detail.dataobject = "d_changeitemdisc_manfwise"
		this.il_changeoption = 1
	elseif ls_stringparam = "C" then
		this.id_detail.dataobject = "d_changeitemdisc_catwise"
		this.il_changeoption = 2
	elseif ls_stringparam = "L" then
		this.id_detail.dataobject = "d_changeitemdisc_classwise"
		this.il_changeoption = 3
	elseif ls_stringparam = "P" then
		this.id_detail.dataobject = "d_changeitemdisc_packwise"
		this.il_changeoption = 4
	end if
	this.id_detail.settransobject(this.it_transobject)
	this.id_detail.retrieve()
	setnull(li_null)
	if this.il_changeoption = 1 then
		this.id_detail.setitem(this.id_detail.getrow(), "manfcode", li_null)
	elseif this.il_changeoption = 2 then
		this.id_detail.setitem(this.id_detail.getrow(), "icatcode", li_null)
	elseif this.il_changeoption = 3 then
		this.id_detail.setitem(this.id_detail.getrow(), "iccode", li_null)
	elseif this.il_changeoption = 4 then
		this.id_detail.setitem(this.id_detail.getrow(), "packcode", li_null)
	end if
	setredraw(true)
