// window w_change_item_prices (singleentryitem)  ancestor: w_single_entry

// w_change_item_prices.wf_changeprices() returns integer
	long ll_salesmancode
	long ll_rowcount
	long ll_counter = 1
	long ll_retcode
	datetime ldt_server_datetime
	string ls_date_errtext
	double ld_saleretail
	dwitemstatus lds_rowstatus
	dwitemstatus lds_columnstatus
	if f_validatedw(this.id_detail) < 0 then
		return ll_retcode
	end if
	if f_validatedw(this.id_detail2) < 0 then
		return ll_retcode
	end if
	ll_rowcount = this.id_detail2.rowcount()
	if ll_rowcount > 0 then
		if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			return ll_retcode
		end if
		ll_salesmancode = gl_usercode
		do while ll_counter <= ll_rowcount
			lds_rowstatus = this.id_detail2.getitemstatus(ll_counter, 0, primary!)
			lds_columnstatus = this.id_detail2.getitemstatus(ll_counter, "saleretail", primary!)
			if lds_columnstatus = datamodified! then
				ld_saleretail = this.id_detail2.object.saleretail[ll_counter]
				this.id_detail2.setitem(ll_counter, "item_saleprice", ld_saleretail)
				this.id_detail2.setitem(ll_counter, "item_retailprice", ld_saleretail)
				this.id_detail2.setitem(ll_counter, "ChangeReason", "Sale/Retail Price")
				this.id_detail2.setitem(ll_counter, "Module", this.title)
			end if
			if lds_rowstatus = datamodified! then
				this.id_detail2.setitem(ll_counter, "item_usercode", ll_salesmancode)
				this.id_detail2.setitem(ll_counter, "item_lastupdate", ldt_server_datetime)
				this.id_detail2.setitem(ll_counter, "ChangeReason", "Multiple Changes")
				this.id_detail2.setitem(ll_counter, "Module", this.title)
			end if
			ll_counter = ll_counter + 1
		loop
		SQL rollback USING this.it_transobject;
		if f_generateitemlog(this.id_detail2, "item_changeprice", this.it_transobject, ldt_server_datetime) >= 0 then
			if this.id_detail2.update(true, true) > 0 then
				SQL commit USING this.it_transobject;
				messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
				this.ib_commitok = true
				this.im_menu.m_file.m_new.enabled = true
				this.editflag = false
				this.id_detail2.reset()
			else
				SQL rollback USING this.it_transobject;
				setpointer(arrow!)
				messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs", exclamation!, ok!, 1)
				return ll_retcode
			end if
			setpointer(arrow!)
		else
			SQL rollback USING this.it_transobject;
			messagebox("Database Problem", "Some Database problem occured generating Item Log!", stopsign!)
			return ll_retcode
		end if
	else
		messagebox("Updataion Problem", "No rows to Update!", stopsign!)
		return ll_retcode
	end if
	return ll_retcode

// w_change_item_prices.wf_fetch_price(string as_col, string as_data) returns long
	return 0

// w_change_item_prices.wf_set_columnvalue() returns long
	long ll_rows
	long ll_counter
	double ld_value
	string ls_column
	s_item_filter_criteria s_price
	ll_rows = this.id_detail2.rowcount()
	if ll_rows > 0 then
		open(w_set_columnvalue)
		s_price = message.powerobjectparm
		if s_price.i_status = 1 then
			ls_column = s_price.s_name1
			ld_value = round(s_price.d_value1, 2)
			for ll_counter = 1 to ll_rows
				this.id_detail2.setitem(ll_counter, ls_column, ld_value)
			next
		end if
	end if
	return 0

// w_change_item_prices.wf_retrieve_detail(string as_col, long al_code) returns long
	long ll_counter
	this.id_detail.accepttext()
	if isnull(this.id_detail.getitemnumber(1, as_col)) then
		messagebox("Validation", "Please Select a Valid Value")
		this.id_detail.setfocus()
		this.id_detail.setcolumn(as_col)
		return 0
	end if
	if lower(as_col) = "icatcode" then
		this.id_detail2.retrieve(al_code, this.id_detail.object.packcode[1], this.id_detail.object.manfcode[1])
	elseif lower(as_col) = "packcode" then
		this.id_detail2.retrieve(this.id_detail.object.icatcode[1], al_code, this.id_detail.object.manfcode[1])
	elseif lower(as_col) = "manfode" then
		this.id_detail2.retrieve(this.id_detail.object.icatcode[1], this.id_detail.object.packcode[1], al_code)
	else
		this.id_detail2.retrieve(this.id_detail.object.icatcode[1], this.id_detail.object.packcode[1], this.id_detail.object.manfcode[1])
	end if
	this.editflag = true
	return 1

// w_change_item_prices.wf_updatesaleprice_purprice() returns long
	long ll_rows
	long ll_counter
	double ld_value
	ll_rows = this.id_detail2.rowcount()
	if ll_rows > 0 then
		openwithparm(w_set_saleprice_purchase_formula, ld_value)
		ld_value = message.doubleparm
		if ld_value > 0.0 then
			for ll_counter = 1 to ll_rows
				this.id_detail2.object.item_saleprice[ll_counter] = round(this.id_detail2.object.item_purprice[ll_counter] + this.id_detail2.object.item_purprice[ll_counter] * ld_value * 0.01, 2)
			next
		end if
	end if
	return 0

// w_change_item_prices.wf_copy_source_target_column() returns long
	long ll_rows
	long ll_counter
	s_item_filter_criteria s_price
	ll_rows = this.id_detail2.rowcount()
	if ll_rows > 0 then
		open(w_set_price_from_another_price)
		s_price = message.powerobjectparm
		if s_price.i_status = 1 then
			for ll_counter = 1 to ll_rows
				this.id_detail2.setitem(ll_counter, s_price.s_name2, this.id_detail2.getitemnumber(ll_counter, s_price.s_name1))
			next
		end if
	end if
	return 0

// w_change_item_prices.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_changeitemsprice" then
		this.menuid = create m_changeitemsprice
	end if

// w_change_item_prices.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_change_item_prices.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_change_item_prices.closequery() returns long [event]
	return ::message.returnvalue

// w_change_item_prices.ue_save() returns 0 [event]
	wf_changeprices()

// w_change_item_prices.open() returns long [event]
	long ancestorreturnvalue
	environment env
	long ll_width
	long ll_height
	long li_visiblecolumns
	long li_counter
	long li_taborder
	boolean lb_zerotabordercol
	datastore lds_itemsetting
	ancestorreturnvalue = super::open()
	if getenvironment(env) <> 1 then
		return ::message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.tab_retrieve.width = ll_width * 0.99
	this.tab_retrieve.height = ll_height * 0.83
	this.tab_retrieve.tabpage_detail.dw_detail.width = ll_width * 0.98
	this.tab_retrieve.tabpage_detail.dw_detail.height = this.tab_retrieve.tabpage_detail.dw_detail.height
	this.tab_retrieve.tabpage_detail.dw_detail2.width = ll_width * 0.96
	this.tab_retrieve.tabpage_detail.dw_detail2.height = ll_height * 0.55
	this.id_detail2 = this.tab_retrieve.tabpage_detail.dw_detail2
	this.id_detail2.settransobject(this.it_transobject)
	lds_itemsetting = create datastore
	lds_itemsetting.dataobject = "d_interfacesettingcols"
	lds_itemsetting.settransobject(this.it_transobject)
	lds_itemsetting.retrieve(53, 3, 1)
	li_visiblecolumns = lds_itemsetting.rowcount()
	for li_counter = 1 to lds_itemsetting.rowcount()
		this.colname[li_counter, 1] = lds_itemsetting.getitemstring(li_counter, "colname") + "_t"
		this.colname[li_counter, 2] = lds_itemsetting.getitemstring(li_counter, "colname")
		this.colwidth[li_counter, 1] = integer(this.id_detail2.describe(this.colname[li_counter, 1] + ".Width"))
		this.colwidth[li_counter, 2] = integer(this.id_detail2.describe(this.colname[li_counter, 2] + ".Width"))
	next
	li_counter = 1
	li_taborder = 1
	do while li_counter <= li_visiblecolumns
		if this.colname[li_counter, 2] = "item_avgprice" or this.colname[li_counter, 2] = "item_packunits" or this.colname[li_counter, 2] = "item_margin" then
			lb_zerotabordercol = true
		else
			lb_zerotabordercol = false
		end if
		this.id_detail2.modify(this.colname[li_counter, 2] + ".Visible=1")
		if lb_zerotabordercol then
			this.id_detail2.modify(this.colname[li_counter, 2] + ".protect=1")
		else
			this.id_detail2.settaborder(this.colname[li_counter, 2], li_taborder)
		end if
		li_taborder = li_taborder + 1
		li_counter = li_counter + 1
	loop
	return ::message.returnvalue

// w_change_item_prices.ue_detail() returns 0 [event]
	call super::ue_detail
	wf_retrieve_detail("icatcode", this.id_detail.object.icatcode[1])

// tabpage_detail.create() returns 0 [event]
	integer icurrent
	this.dw_detail2 = create dw_detail2
	call super::create
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_detail2

// tabpage_detail.destroy() returns 0 [event]
	call super::destroy
	destroy this.dw_detail2

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "icatcode"
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item Category")
		end if
	case "packcode"
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item Packing")
		end if
	case "manfcode"
		if real(data) < 1.0 then
			messagebox("Item Qty Validation", "Value required for Company")
		end if
	end choose
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "icatcode", "packcode", "iccode", "manfcode"
		if data = "" or isnull(data) then
			return 1
		else
			parent.parent.parent.wf_retrieve_detail(dwo.name, long(data))
			return 0
		end if
	case "saleprice"
		if double(data) < 0.0 then
			return 1
		end if
	case "purprice"
		if double(data) < 0.0 then
			return 1
		end if
	case "changepurprice"
		if data = "Y" then
			parent.parent.parent.id_detail.object.purprice.visible = true
			parent.parent.parent.id_detail.object.t_purprice.visible = true
		else
			parent.parent.parent.id_detail.object.purprice.visible = false
			parent.parent.parent.id_detail.object.t_purprice.visible = false
		end if
	end choose
	return ::message.returnvalue

// dw_detail2.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "icatcode", "packcode", "iccode", "manfcode"
		if data = "" or isnull(data) then
			return 1
		else
			parent.parent.parent.wf_fetch_price(dwo.name, data)
			return 0
		end if
	case "saleprice"
		if double(data) < 0.0 then
			return 1
		end if
	case "purprice"
		if double(data) < 0.0 then
			return 1
		end if
	case "changepurprice"
		if data = "Y" then
			parent.parent.parent.id_detail.object.purprice.visible = true
			parent.parent.parent.id_detail.object.t_purprice.visible = true
		else
			parent.parent.parent.id_detail.object.purprice.visible = false
			parent.parent.parent.id_detail.object.t_purprice.visible = false
		end if
	end choose
	return ::message.returnvalue

// dw_detail2.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "iccode"
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for Item Class")
		end if
	case "icatcode"
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for Item Category")
		end if
	case "packcode"
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for Item Packing")
		end if
	case "manfcode"
		if real(data) < 1.0 then
			messagebox("Item Qty Validation", "Value required for Item Manufacturer")
		end if
	case "purprice"
		if real(data) < 1.0 then
			messagebox("Purchase Price Validation!", "Please Enter Valid Purchase Price")
		end if
	case "price"
		if real(data) < 1.0 then
			messagebox("Purchase Price Validation!", "Please Enter Valid Purchase Price")
		end if
	end choose
	return 1

// dw_detail2.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf5! then
		parent.parent.parent.wf_updatesaleprice_purprice()
	elseif key = keyf6! then
		parent.parent.parent.wf_copy_source_target_column()
	elseif key = keyf7! then
		parent.parent.parent.wf_set_columnvalue()
	end if
	return ::message.returnvalue
