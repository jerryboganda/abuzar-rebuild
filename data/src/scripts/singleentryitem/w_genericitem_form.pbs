// window w_genericitem_form (singleentryitem)  ancestor: w_single_entry

// w_genericitem_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM Service WHERE Service.name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_genericitem_form.create() returns 0 [event]
	call super::create

// w_genericitem_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_genericitem_form.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "GenericItem"
	this.id_printlist.dataobject = "d_genericitem_list_report"
	this.id_printlist.settransobject(sqlca)
	this.im_menu.m_file.m_printlist.visible = true
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "name"
		if parent.parent.parent.wf_duplicatename(data) then
			messagebox("Name Validation", "Duplication Name Error~n~rPlease Choose Some Other Name")
			return 1
		end if
	end choose
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "name"
		messagebox("Name Validation", "Please enter valid value for Service Name")
	case "price"
		messagebox("Price Validation", "Please enter valid value for Service Charges")
	end choose
	return 1
