// window w_genericitem_form (singleentryitem)  ancestor: w_single_entry

// w_genericitem_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM Service WHERE Service.name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_genericitem_form.create() returns 0
	call super::create

// w_genericitem_form.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_genericitem_form.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "GenericItem"
	this.id_printlist.dataobject = "d_genericitem_list_report"
	this.id_printlist.settransobject(sqlca)
	this.im_menu.m_file.m_printlist.visible = true
	return ::message.returnvalue
