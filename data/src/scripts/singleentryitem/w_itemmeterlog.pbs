// window w_itemmeterlog (singleentryitem)  ancestor: w_single_entry

// w_itemmeterlog.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM ItemMeter WHERE ItemMeter.name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_itemmeterlog.wf_validate_itemmeter(long al_code) returns long
	double ld_meterreading
	SQL SELECT CurrentReading INTO :ld_meterreading FROM ItemMeter WHERE ItemMeterCode =:al_code USING sqlca;
	if sqlca.sqlcode = 0 then
		if isnull(ld_meterreading) then
			ld_meterreading = 0
		end if
		this.id_detail.object.meterreading[1] = ld_meterreading
	else
		return 1
	end if
	return 0

// w_itemmeterlog.create() returns 0 [event]
	call super::create

// w_itemmeterlog.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_itemmeterlog.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_itemmeterlog.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "ItemMeterLog"
	return ::message.returnvalue

// w_itemmeterlog.ue_save() returns 0 [event]
	long ll_primarykey
	long ll_row
	long ll_metercode
	long ll_null
	double ld_newreading
	double ld_meterreading
	datetime ldt_serverdatetime
	string ls_errtext
	setpointer(hourglass!)
	setnull(ll_null)
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	ll_row = this.id_detail.getrow()
	ll_primarykey = this.id_detail.object.code[this.id_detail.getrow()]
	ll_metercode = this.id_detail.object.itemmetercode[this.id_detail.getrow()]
	ld_newreading = this.id_detail.object.newreading[this.id_detail.getrow()]
	ld_meterreading = this.id_detail.object.meterreading[this.id_detail.getrow()]
	if not wf_getserverdatetime(ldt_serverdatetime, ls_errtext) then
		messagebox("Server Date/Time Validation", ls_errtext, stopsign!)
	else
		this.id_detail.object.date[1] = ldt_serverdatetime
		this.id_detail.object.usercode[1] = gl_usercode
	end if
	if isnull(ll_primarykey) then
		ll_primarykey = 0
		f_newtableid(this.is_tablename, ll_primarykey)
		this.id_detail.setitem(ll_row, "code", ll_primarykey)
	end if
	if this.id_detail.update() > 0 then
		SQL update DBO.ItemMeter SET CurrentReading =:ld_newreading WHERE ItemMeterCode =:ll_metercode AND CurrentReading =:ld_meterreading USING sqlca;
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
			messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
			this.ib_commitok = true
			this.im_menu.m_file.m_new.enabled = true
			this.editflag = false
		else
			SQL rollback USING sqlca;
			setpointer(arrow!)
			messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs", exclamation!, ok!, 1)
			this.id_detail.object.code[1] = ll_null
		end if
	else
		SQL rollback USING sqlca;
		setpointer(arrow!)
		messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs", exclamation!, ok!, 1)
		return
	end if
	setpointer(arrow!)

// w_itemmeterlog.ue_detail() returns 0 [event]
	long ll_code
	long ll_found
	this.im_menu.m_file.m_save.enabled = false
	ll_found = 0
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.i_editmode = 2
	this.i_retrievemode = 2
	if this.tab_retrieve.tabpage_list.dw_list.rowcount() > 0 and this.il_selectedrow > 0 then
		ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
		this.id_dwcontrol = this.id_detail
		wf_retrieve(ll_code)
		this.id_dwcontrol = this.id_list
		this.tab_retrieve.tabpage_detail.dw_detail.setfocus()
	end if
	wf_protectdw(this.id_detail, 1)

// w_itemmeterlog.ue_newform() returns 0 [event]
	call super::ue_newform
	wf_protectdw(this.id_detail, 0)

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "itemmetercode"
		if parent.parent.parent.wf_validate_itemmeter(long(data)) <> 0 then
			messagebox("Item Meter Validation", "Item Meter Validation Error~n~rPlease Choose Some Other Item Meter")
			return 1
		end if
	end choose
	return ll_retcode
