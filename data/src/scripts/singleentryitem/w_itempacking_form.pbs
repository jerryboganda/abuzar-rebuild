// window w_itempacking_form (singleentryitem)  ancestor: w_single_entry

// w_itempacking_form.wf_duplicatecode(string as_packcode) returns boolean
	integer li_packcode
	integer li_duppackcode
	li_packcode = integer(as_packcode)
	SQL SELECT ItemPacking.Packcode INTO :li_duppackcode FROM ItemPacking WHERE ItemPacking.Packcode =:li_packcode USING sqlca;
	if li_duppackcode = li_packcode then
		return true
	end if
	return false

// w_itempacking_form.wf_duplicateitempackingname(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM ItemPacking WHERE Itempacking.name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_itempacking_form.create() returns 0
	call super::create

// w_itempacking_form.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_itempacking_form.activate() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_itempacking_form.ue_detail() returns 0
	call super::ue_detail

// w_itempacking_form.ue_newform() returns 0
	call super::ue_newform

// w_itempacking_form.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "ItemPacking"
	return ::message.returnvalue
