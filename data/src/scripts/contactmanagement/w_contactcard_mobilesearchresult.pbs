// window w_contactcard_mobilesearchresult (contactmanagement)  ancestor: window

// w_contactcard_mobilesearchresult.wf_select_unselect_row() returns long
	long ll_oldrow
	ll_oldrow = this.ii_currow
	if this.dw_control.getrow() > 0 then
		this.dw_control.selectrow(ll_oldrow, false)
		this.ii_currow = this.dw_control.getrow()
		this.dw_control.selectrow(this.ii_currow, true)
		this.dw_control.setrow(this.ii_currow)
		this.dw_control.scrolltorow(this.ii_currow)
	end if
	return this.ii_currow

// w_contactcard_mobilesearchresult.create() returns 0
	this.cb_cancel = create cb_cancel
	this.cb_select = create cb_select
	this.dw_control = create dw_control
	this.control = {this.cb_cancel, this.cb_select, this.dw_control}

// w_contactcard_mobilesearchresult.destroy() returns 0
	destroy this.cb_cancel
	destroy this.cb_select
	destroy this.dw_control

// w_contactcard_mobilesearchresult.open() returns long
	long ll_width
	long ll_height
	long ll_code
	environment env
	this.is_arguements = message.powerobjectparm
	if getenvironment(env) <> 1 then
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.width = ll_width * 0.98
	this.height = ll_height * 0.90
	this.y = int((ll_height - this.height) / 2.0)
	this.dw_control.width = this.width * 0.98
	this.dw_control.height = this.height * 0.85
	this.cb_select.y = this.dw_control.y + this.dw_control.height + 10
	this.cb_cancel.y = this.dw_control.y + this.dw_control.height + 10
	this.cb_select.x = this.width / 2.0 - (this.cb_select.width + 20)
	this.cb_cancel.x = this.cb_select.x + this.cb_select.width + 20
	this.dw_control.settransobject(sqlca)
	this.dw_control.retrieve(this.is_arguements.s_name1)
	if this.dw_control.rowcount() > 0 then
		this.ii_currow = 1
		wf_select_unselect_row()
	else
		this.ii_currow = 0
	end if
	setredraw(true)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_contactcard_mobilesearchresult.close() returns long
	closewithreturn(this, this.is_arguements)
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.is_arguements.i_status = -1
	parent.postevent(close!)
	return ::message.returnvalue

// cb_select.clicked() returns long
	parent.is_arguements.i_status = 1
	if parent.dw_control.getrow() > 0 then
		parent.is_arguements.l_code1 = parent.dw_control.object.code[parent.dw_control.getrow()]
		parent.is_arguements.s_name1 = parent.dw_control.object.mobile[parent.dw_control.getrow()]
		parent.is_arguements.l_code2 = parent.dw_control.object.acccode[parent.dw_control.getrow()]
	end if
	parent.postevent(close!)
	return ::message.returnvalue

// dw_control.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long
	long ancestorreturnvalue
	long ll_row
	long ll_retcode
	ancestorreturnvalue = super::doubleclicked(xpos, ypos, row, dwo)
	ll_row = getrow()
	if getrow() > 0 then
		parent.is_arguements.i_status = 1
		parent.is_arguements.s_name1 = this.object.mobile[getrow()]
		parent.is_arguements.l_code1 = this.object.code[getrow()]
		parent.is_arguements.l_code2 = this.object.acccode[getrow()]
		parent.postevent(close!)
	end if
	return ll_retcode

// dw_control.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	long ancestorreturnvalue
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_rowm
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	ll_rowm = getrow()
	if key = keydownarrow! then
		selectrow(0, false)
		scrollnextrow()
		ll_listcurrrow = getrow()
		rt_code = 1
	elseif key = keyuparrow! then
		selectrow(0, false)
		scrollpriorrow()
		ll_listcurrrow = getrow()
		rt_code = 1
	elseif key = keypagedown! then
		selectrow(0, false)
		scrollnextpage()
		ll_listcurrrow = getrow()
		rt_code = 1
	elseif key = keypageup! then
		selectrow(0, false)
		scrollpriorpage()
		ll_listcurrrow = getrow()
		rt_code = 1
	elseif key = keyend! then
		selectrow(0, false)
		scrolltorow(99999)
		ll_listcurrrow = getrow()
		rt_code = 1
	elseif key = keyenter! then
		ll_listcurrrow = getrow()
		rt_code = 1
		if getrow() > 0 then
			parent.is_arguements.i_status = 1
			parent.is_arguements.s_name1 = this.object.mobile[getrow()]
			parent.is_arguements.l_code1 = this.object.code[getrow()]
			parent.is_arguements.l_code2 = this.object.acccode[getrow()]
		end if
		parent.postevent(close!)
	elseif key = keyhome! then
		selectrow(0, false)
		scrolltorow(1)
		ll_listcurrrow = getrow()
		rt_code = 1
	end if
	if rt_code = 1 then
		parent.wf_select_unselect_row()
	end if
	return rt_code

// dw_control.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	if row > 0 then
		selectrow(0, false)
		scrolltorow(row)
		setrow(row)
		parent.wf_select_unselect_row()
	end if
	return ::message.returnvalue
