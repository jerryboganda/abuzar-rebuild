// window w_contactgroup (contactmanagement)  ancestor: w_multi_entry

// w_contactgroup.wf_duplicatename(string as_name) returns boolean
	long ll_count
	long ll_code
	boolean b_flag
	ll_code = this.id_master.object.code[1]
	as_name = trim(as_name)
	if isnull(ll_code) or ll_code = 0 then
		SQL SELECT count ( *) INTO :ll_count FROM ContactGroup WHERE ContactGroup.name =:as_name USING this.it_transobject;
	else
		SQL SELECT count ( *) INTO :ll_count FROM ContactGroup WHERE ContactGroup.name =:as_name AND ContactGroup.ContactGroupCode <> :ll_code USING this.it_transobject;
	end if
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_contactgroup.wf_validateitem() returns long
	long ll_icode
	long ll_found
	integer li_errcode
	integer li_null
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "contactcardcode")
	if vf_dwdupcode1(this.id_detail, "contactcardcode", string(ll_icode), this.il_currrow) = true then
		messagebox("Duplication Error", "Current row is duplicate")
		li_errcode = -1
	else
		li_errcode = 0
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		setnull(li_null)
		this.id_detail.setcolumn("contactcardcode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.contactcardcode[this.il_currrow] = li_null
	else
		ll_found = this.idc_contacts.find("code = " + string(ll_icode), 1, this.idc_contacts.rowcount())
		if ll_found > 0 and ll_found <= this.idc_contacts.rowcount() then
			this.id_detail.setitem(this.il_currrow, "acccode", this.idc_contacts.getitemnumber(ll_found, "acccode"))
			this.id_detail.setitem(this.il_currrow, "title", this.idc_contacts.getitemstring(ll_found, "title"))
			this.id_detail.setitem(this.il_currrow, "name", this.idc_contacts.getitemstring(ll_found, "name"))
			this.id_detail.setitem(this.il_currrow, "address", this.idc_contacts.getitemstring(ll_found, "address"))
			this.id_detail.setitem(this.il_currrow, "phone", this.idc_contacts.getitemstring(ll_found, "phone"))
			this.id_detail.setitem(this.il_currrow, "fax", this.idc_contacts.getitemstring(ll_found, "fax"))
			this.id_detail.setitem(this.il_currrow, "email", this.idc_contacts.getitemstring(ll_found, "email"))
			this.id_detail.setitem(this.il_currrow, "mobile", this.idc_contacts.getitemstring(ll_found, "mobile"))
			this.id_detail.setitem(this.il_currrow, "useforsms", this.idc_contacts.getitemstring(ll_found, "useforsms"))
			this.id_detail.setitem(this.il_currrow, "web", this.idc_contacts.getitemstring(ll_found, "web"))
			this.idc_contacts.setrow(1)
			this.idc_contacts.scrolltorow(1)
		end if
	end if
	return li_errcode

// w_contactgroup.wf_populatecontacts() returns long
	long ll_totrows
	long ll_counter
	long ll_insrow
	long ll_contactcardcode
	s_arguements lstr_arg
	ll_totrows = this.id_detail.rowcount()
	for ll_counter = 1 to ll_totrows
		event ue_deleteitem()
	next
	open(w_arg_contactselection)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		ll_counter = 0
		ll_totrows = upperbound(lstr_arg.ia_integerlist)
		for ll_counter = 1 to ll_totrows
			ll_insrow = this.id_detail.insertrow(0)
			ll_contactcardcode = lstr_arg.ia_integerlist[ll_counter]
			this.id_detail.object.contactcardcode[ll_insrow] = ll_contactcardcode
			wf_setcontactdetails(ll_contactcardcode, ll_insrow)
		next
	end if
	this.editflag = true
	return 0

// w_contactgroup.wf_setcontactdetails(long al_code, long al_row) returns integer
	long ll_found
	integer li_errcode
	ll_found = this.idc_contacts.find("code = " + string(al_code), 1, this.idc_contacts.rowcount())
	if ll_found > 0 and ll_found <= this.idc_contacts.rowcount() then
		this.id_detail.setitem(al_row, "acccode", this.idc_contacts.getitemnumber(ll_found, "acccode"))
		this.id_detail.setitem(al_row, "title", this.idc_contacts.getitemstring(ll_found, "title"))
		this.id_detail.setitem(al_row, "name", this.idc_contacts.getitemstring(ll_found, "name"))
		this.id_detail.setitem(al_row, "address", this.idc_contacts.getitemstring(ll_found, "address"))
		this.id_detail.setitem(al_row, "phone", this.idc_contacts.getitemstring(ll_found, "phone"))
		this.id_detail.setitem(al_row, "fax", this.idc_contacts.getitemstring(ll_found, "fax"))
		this.id_detail.setitem(al_row, "email", this.idc_contacts.getitemstring(ll_found, "email"))
		this.id_detail.setitem(al_row, "mobile", this.idc_contacts.getitemstring(ll_found, "mobile"))
		this.id_detail.setitem(al_row, "useforsms", this.idc_contacts.getitemstring(ll_found, "useforsms"))
		this.id_detail.setitem(al_row, "web", this.idc_contacts.getitemstring(ll_found, "web"))
		return 0
	end if
	return 1

// w_contactgroup.create() returns 0 [event]
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_contactgroupmenu" then
		this.menuid = create m_contactgroupmenu
	end if

// w_contactgroup.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_contactgroup.ue_save() returns 0 [event]
	long ll_mastercurrrow
	long ll_invid
	long ll_detailrows
	integer li_counter
	integer ll_salesmancode
	boolean lb_commitflag = true
	dwitemstatus lds_rowstatus
	if this.ib_itemvalidated = false then
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	setpointer(hourglass!)
	ll_mastercurrrow = this.id_master.getrow()
	ll_invid = this.id_master.object.code[ll_mastercurrrow]
	if isnull(ll_invid) then
		f_newtableid("contactgroup", ll_invid)
		this.id_master.object.code[ll_mastercurrrow] = ll_invid
	end if
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	do while li_counter <= ll_detailrows and lb_commitflag = true
		lds_rowstatus = this.id_detail.getitemstatus(li_counter, 0, primary!)
		if lds_rowstatus = newmodified! then
			this.id_detail.setitem(li_counter, "code", ll_invid)
		end if
		li_counter = li_counter + 1
	loop
	call super::ue_save
	setpointer(arrow!)

// w_contactgroup.ue_newform() returns 0 [event]
	call super::ue_newform
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true
	this.id_master.setfocus()

// w_contactgroup.ue_detail() returns 0 [event]
	long ll_code
	long ll_rowcount
	call super::ue_detail
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.im_menu.m_file.m_print.enabled = true
	this.i_editmode = 2
	this.i_retrievemode = 2
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	this.id_dwcontrol = this.id_master
	ll_rowcount = wf_retrieve(ll_code)
	this.id_dwcontrol = this.id_detail
	wf_retrieve(ll_code)
	this.id_detail.setrow(1)
	this.id_detail.scrolltorow(1)
	this.id_detail.setcolumn("contactcardcode")
	this.id_detail.setfocus()
	this.id_dwcontrol = this.id_list
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_new.visible = false
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true

// w_contactgroup.ue_postopen() returns 0 [event]
	call super::ue_postopen
	this.id_detail.getchild("contactcardcode", this.idc_contacts)
	this.idc_contacts.settransobject(this.it_transobject)

// w_contactgroup.ue_newitem() returns 0 [event]
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	call super::ue_newitem

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "name"
		if parent.parent.parent.wf_duplicatename(data) then
			messagebox("Name Validation", "Duplication Name Error~n~rPlease Choose Some Other Name")
			return 1
		end if
	end choose
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "name"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	end choose
	return 1

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "contactcardcode"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_itemvalidated = false
		li_errcode = 0
	case else
		parent.parent.parent.ib_itemvalidated = true
	end choose
	return li_errcode

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "contactcardcode"
		if data = "" or isnull(data) then
			messagebox("Contact Validation", "Value required for Contact in current row")
		end if
	end choose
	return 1

// dw_itemsdetail.getfocus() returns long [event]
	return ::message.returnvalue

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue
