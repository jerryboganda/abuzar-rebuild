// menu m_graphviewer (graphcomponents)  ancestor: m_entry

// m_graphviewer.create() returns 0 [event]
	m_graphviewer = this
	call super::create
	this.text = "m_graphviewer"

// m_graphviewer.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_saveas = create m_saveas
	this.m_print = create m_print
	this.m_graphtype = create m_graphtype
	this.m_graphseries = create m_graphseries
	this.m_graphcolor = create m_graphcolor
	this.m_graphtitle = create m_graphtitle
	this.m_setgraphspacing = create m_setgraphspacing
	this.m_graphrotation = create m_graphrotation
	this.m_valueaxisdivision = create m_valueaxisdivision
	this.m_copytoclipboard = create m_copytoclipboard
	this.m_viewclipboard = create m_viewclipboard
	this.item[upperbound(this.item) + 1] = this.m_saveas
	this.item[upperbound(this.item) + 1] = this.m_print
	this.item[upperbound(this.item) + 1] = this.m_graphtype
	this.item[upperbound(this.item) + 1] = this.m_graphseries
	this.item[upperbound(this.item) + 1] = this.m_graphcolor
	this.item[upperbound(this.item) + 1] = this.m_graphtitle
	this.item[upperbound(this.item) + 1] = this.m_setgraphspacing
	this.item[upperbound(this.item) + 1] = this.m_graphrotation
	this.item[upperbound(this.item) + 1] = this.m_valueaxisdivision
	this.item[upperbound(this.item) + 1] = this.m_copytoclipboard
	this.item[upperbound(this.item) + 1] = this.m_viewclipboard

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_saveas
	destroy this.m_print
	destroy this.m_graphtype
	destroy this.m_graphseries
	destroy this.m_graphcolor
	destroy this.m_graphtitle
	destroy this.m_setgraphspacing
	destroy this.m_graphrotation
	destroy this.m_valueaxisdivision
	destroy this.m_copytoclipboard
	destroy this.m_viewclipboard

// m_saveas.create() returns 0 [event]
	call super::create
	this.visible = false
	this.text = "SaveAs~tCtrl+A"
	this.enabled = false
	this.shortcut = 321
	this.toolbaritemvisible = false
	this.toolbaritemname = "SaveAs!"

// m_saveas.destroy() returns 0 [event]
	call super::destroy

// m_saveas.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_saveas()

// m_print.create() returns 0 [event]
	call super::create
	this.text = "&Print"
	this.microhelp = "Print Report"
	this.toolbaritemname = "Print!"
	this.toolbaritemdownname = "Print"
	this.toolbaritemtext = "Print"

// m_print.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_print()

// m_print.destroy() returns 0 [event]
	call super::destroy

// m_graphtype.clicked() returns 0 [event]
	this.parentwindow.getactivesheet().triggerevent("ue_graph_type")

// m_graphtype.create() returns 0 [event]
	call super::create
	this.text = "Graph Type"
	this.microhelp = "Select Graph Type from a avaliable graph types"
	this.toolbaritemname = "Graph!"
	this.toolbaritemtext = "Set Graph Type"

// m_graphtype.destroy() returns 0 [event]
	call super::destroy

// m_graphseries.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_plotgraph()

// m_graphseries.create() returns 0 [event]
	call super::create
	this.text = "Graph Series"
	this.toolbaritemname = "PlaceColumn!"
	this.toolbaritemtext = "Graph Series"

// m_graphseries.destroy() returns 0 [event]
	call super::destroy

// m_graphcolor.clicked() returns 0 [event]
	this.parentwindow.getactivesheet().triggerevent("ue_graph_color")

// m_graphcolor.create() returns 0 [event]
	call super::create
	this.text = "Graph Color"
	this.toolbaritemname = "CreateRuntime!"
	this.toolbaritemtext = "Set Graph Color"

// m_graphcolor.destroy() returns 0 [event]
	call super::destroy

// m_graphtitle.clicked() returns 0 [event]
	this.parentwindow.getactivesheet().triggerevent("ue_graph_title")

// m_graphtitle.create() returns 0 [event]
	call super::create
	this.text = "Graph Title"
	this.toolbaritemname = "StaticText!"
	this.toolbaritemtext = "Set Graph Title"

// m_graphtitle.destroy() returns 0 [event]
	call super::destroy

// m_setgraphspacing.clicked() returns 0 [event]
	this.parentwindow.getactivesheet().triggerevent("ue_graph_spacing")

// m_setgraphspacing.create() returns 0 [event]
	call super::create
	this.text = "Graph Spacing"
	this.toolbaritemname = "SpaceHorizontal!"
	this.toolbaritemtext = "Set Graph Spacing"

// m_setgraphspacing.destroy() returns 0 [event]
	call super::destroy

// m_graphrotation.clicked() returns 0 [event]
	this.parentwindow.getactivesheet().triggerevent("ue_graph_rotation")

// m_graphrotation.create() returns 0 [event]
	call super::create
	this.text = "Graph Rotation"
	this.microhelp = "Rotate 3 dimentional graphs from 0 to 360 degrees"
	this.toolbaritemname = "Regenerate5!"
	this.toolbaritemtext = "Rotate Graph"

// m_graphrotation.destroy() returns 0 [event]
	call super::destroy

// m_valueaxisdivision.clicked() returns 0 [event]
	this.parentwindow.getactivesheet().triggerevent("ue_graph_division")

// m_valueaxisdivision.create() returns 0 [event]
	call super::create
	this.text = "Value Axis Division"
	this.microhelp = "Value Axis Division wrt readabliity"
	this.toolbaritemname = "CreateTable5!"
	this.toolbaritemtext = "Value Axis Division"

// m_valueaxisdivision.destroy() returns 0 [event]
	call super::destroy

// m_copytoclipboard.clicked() returns 0 [event]
	this.parentwindow.getactivesheet().triggerevent("ue_Copy_To_Clipboard")

// m_copytoclipboard.create() returns 0 [event]
	call super::create
	this.text = "Copy To Clip Board~tCtrl+C"
	this.shortcut = 323
	this.toolbaritemname = "PasteWindow!"
	this.toolbaritemtext = "Copy To Clip Board"

// m_copytoclipboard.destroy() returns 0 [event]
	call super::destroy

// m_viewclipboard.clicked() returns 0 [event]
	run("clipbrd.exe")

// m_viewclipboard.create() returns 0 [event]
	call super::create
	this.text = "View Clip Board"
	this.toolbaritemname = "SelectTable5!"
	this.toolbaritemtext = "View Clip Board"

// m_viewclipboard.destroy() returns 0 [event]
	call super::destroy
