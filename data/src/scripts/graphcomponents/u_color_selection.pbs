// userobject u_color_selection (graphcomponents)  ancestor: userobject

// u_color_selection.uf_set_rgb(long al_rgb) returns 0
	this.ii_r = al_rgb mod 256
	al_rgb = al_rgb / 256.0
	this.ii_g = al_rgb mod 256
	al_rgb = al_rgb / 256.0
	this.ii_b = al_rgb mod 256
	this.rr_1.fillcolor = rgb(this.ii_r, this.ii_g, this.ii_b)
	this.hsb_red.position = this.ii_r
	this.hsb_green.position = this.ii_g
	this.hsb_blue.position = this.ii_b
	this.sle_red.text = string(this.ii_r)
	this.sle_green.text = string(this.ii_g)
	this.sle_blue.text = string(this.ii_b)

// u_color_selection.uf_get_rgb() returns long
	return rgb(this.ii_r, this.ii_g, this.ii_b)

// u_color_selection.uf_get_red() returns integer
	return this.ii_r

// u_color_selection.uf_get_green() returns integer
	return this.ii_g

// u_color_selection.uf_get_blue() returns integer
	return this.ii_b

// u_color_selection.create() returns 0 [event]
	this.st_3 = create st_3
	this.st_2 = create st_2
	this.st_1 = create st_1
	this.hsb_green = create hsb_green
	this.hsb_red = create hsb_red
	this.sle_blue = create sle_blue
	this.sle_green = create sle_green
	this.sle_red = create sle_red
	this.hsb_blue = create hsb_blue
	this.rr_1 = create rr_1
	this.control = {this.st_3, this.st_2, this.st_1, this.hsb_green, this.hsb_red, this.sle_blue, this.sle_green, this.sle_red, this.hsb_blue, this.rr_1}

// u_color_selection.destroy() returns 0 [event]
	destroy this.st_3
	destroy this.st_2
	destroy this.st_1
	destroy this.hsb_green
	destroy this.hsb_red
	destroy this.sle_blue
	destroy this.sle_green
	destroy this.sle_red
	destroy this.hsb_blue
	destroy this.rr_1

// hsb_green.pageright() returns long [event]
	if parent.ii_g > 205 then
		parent.ii_g = 255
	else
		parent.ii_g = parent.ii_g + 50
	end if
	parent.sle_green.text = string(parent.ii_g)
	this.position = parent.ii_g
	parent.rr_1.fillcolor = rgb(parent.ii_r, parent.ii_g, parent.ii_b)
	parent.triggerevent("color_changed")
	return ::message.returnvalue

// hsb_green.lineleft() returns long [event]
	if parent.ii_g < 10 then
		parent.ii_g = 0
	else
		parent.ii_g = parent.ii_g - 10
	end if
	parent.sle_green.text = string(parent.ii_g)
	this.position = parent.ii_g
	parent.rr_1.fillcolor = rgb(parent.ii_r, parent.ii_g, parent.ii_b)
	parent.triggerevent("color_changed")
	return ::message.returnvalue

// hsb_green.lineright() returns long [event]
