// window w_graph_type (graphcomponents)  ancestor: w_center

// w_graph_type.open() returns long [event]
	long ancestorreturnvalue
	graphicobject lgro_hold
	ancestorreturnvalue = super::open()
	lgro_hold = message.powerobjectparm
	if lgro_hold.typeof() = graph! then
		this.io_passed = graph!
		this.igr_parm = message.powerobjectparm
	elseif lgro_hold.typeof() = datawindow! then
		this.io_passed = datawindow!
		this.idw_parm = message.powerobjectparm
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_graph_type.create() returns 0 [event]
	integer icurrent
	call super::create
	this.uo_1 = create uo_1
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.uo_1

// w_graph_type.destroy() returns 0 [event]
	call super::destroy
	destroy this.uo_1

// uo_1.gallery_ok(unsignedlong wparam, long lparam) returns long [event]
	long ancestorreturnvalue
	integer li_col
	integer li_row
	integer li_ret
	string ls_graph_type
	ancestorreturnvalue = super::gallery_ok(wparam, lparam)
	li_ret = uf_query_gallery(li_row, li_col, ls_graph_type)
	if li_ret = 0 then
		messagebox("Sorry!", "Clicked on invalid type")
		return ::message.returnvalue
	end if
	if parent.io_passed = graph! then
		choose case ls_graph_type
		case "area3d"
			parent.igr_parm.graphtype = area3d!
		case "areagraph"
			parent.igr_parm.graphtype = areagraph!
		case "bar3dobjgraph"
			parent.igr_parm.graphtype = bar3dobjgraph!
		case "barstack3dobjgraph"
			parent.igr_parm.graphtype = barstack3dobjgraph!
		case "bargraph"
			parent.igr_parm.graphtype = bargraph!
		case "bar3dgraph"
			parent.igr_parm.graphtype = bar3dgraph!
		case "barstackgraph"
			parent.igr_parm.graphtype = barstackgraph!
		case "col3dgraph"
			parent.igr_parm.graphtype = col3dgraph!
		case "col3dobjgraph"
			parent.igr_parm.graphtype = col3dobjgraph!
		case "colgraph"
			parent.igr_parm.graphtype = colgraph!
		case "colstack3dobjgraph"
			parent.igr_parm.graphtype = colstack3dobjgraph!
		case "colstackgraph"
			parent.igr_parm.graphtype = colstackgraph!
		case "line3d"
			parent.igr_parm.graphtype = line3d!
		case "linegraph"
			parent.igr_parm.graphtype = linegraph!
		case "pie3d"
			parent.igr_parm.graphtype = pie3d!
		case "piegraph"
			parent.igr_parm.graphtype = piegraph!
		case "scattergraph"
			parent.igr_parm.graphtype = scattergraph!
		case else
			messagebox("Error!", "Invalid Graph Type")
		end choose
	elseif parent.io_passed = datawindow! then
		choose case ls_graph_type
		case "area3d"
			parent.idw_parm.object.gr_1.graphtype = 15
		case "areagraph"
			parent.idw_parm.object.gr_1.graphtype = 1
		case "bar3dobjgraph"
			parent.idw_parm.object.gr_1.graphtype = 4
		case "barstack3dobjgraph"
			parent.idw_parm.object.gr_1.graphtype = 6
		case "bargraph"
			parent.idw_parm.object.gr_1.graphtype = 2
		case "bar3dgraph"
			parent.idw_parm.object.gr_1.graphtype = 3
		case "barstackgraph"
			parent.idw_parm.object.gr_1.graphtype = 5
		case "col3dgraph"
			parent.idw_parm.object.gr_1.graphtype = 8
		case "col3dobjgraph"
			parent.idw_parm.object.gr_1.graphtype = 9
		case "colgraph"
			parent.idw_parm.object.gr_1.graphtype = 7
		case "colstack3dobjgraph"
			parent.idw_parm.object.gr_1.graphtype = 11
		case "colstackgraph"
			parent.idw_parm.object.gr_1.graphtype = 10
		case "line3d"
			parent.idw_parm.object.gr_1.graphtype = 16
		case "linegraph"
			parent.idw_parm.object.gr_1.graphtype = 12
		case "pie3d"
			parent.idw_parm.object.gr_1.graphtype = 17
		case "piegraph"
			parent.idw_parm.object.gr_1.graphtype = 13
		case "scattergraph"
			parent.idw_parm.object.gr_1.graphtype = 14
		case else
			messagebox("Error!", "Invalid Graph Type")
		end choose
	end if
	close(parent)
	return ::message.returnvalue

// uo_1.gallery_cancel(unsignedlong +wparam, long +lparam) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::gallery_cancel(+wparam, +lparam)
	close(parent)
	return ::message.returnvalue

// uo_1.destroy() returns 0 [event]
	call super::destroy

// p_gallery.இ() returns long
	integer icolwidth = 287
	integer irowheight = 308
	integer li_x
	integer li_y
	integer li_textx
	integer li_texty
	string ls_title
	string[] ls_titles1
	string[] ls_titles3
	string[] ls_graphtype
	li_x = pointerx()
	li_y = pointery()
	if li_x < 25 or li_x > 1747 or li_y < 30 or li_y > 954 then
		parent.st_1.hide()
		beep(1)
		if not isvalid(::message) then
			return 0
		end if
		return ::message.field6
	end if
	parent.ii_col = (li_x - 25) / 287.0 + 1.0
	parent.ii_row = (li_y - 30) / irowheight + 1.0
	if parent.ii_row = 3 then
		ls_title = ls_titles3[parent.ii_col]
	else
		ls_title = ls_titles1[parent.ii_col]
	end if
	li_texty = parent.ii_row * irowheight + (parent.ii_row - 1) * 10
	parent.st_1.text = ls_title
	li_textx = this.x + (parent.ii_col - 1) * 287 + 75
	li_texty = li_texty - this.y
	parent.st_1.hide()
	if parent.ii_row = 2 and parent.ii_col = 6 then
		beep(1)
	else
		parent.st_1.move(li_textx, li_texty)
		parent.st_1.show()
	end if
	parent.is_graphtype = ls_graphtype[parent.ii_col, parent.ii_row]
	if not isvalid(::message) then
		return 0
	end if
	return ::message.field6

// p_gallery.↴இ℄இ܀ကᠬஇ       () returns long
	parent.cb_ok.triggerevent(clicked!)
	if not isvalid(::message) then
		return 0
	end if
	return ::message.field6

// cb_ok.இ() returns long
	parent.triggerevent("gallery_ok")
	if not isvalid(::message) then
		return 0
	end if
	return ::message.field6

// cb_cancel.இ() returns long
	parent.triggerevent("gallery_cancel")
	if not isvalid(::message) then
		return 0
	end if
	return ::message.field6
