// window w_graphviewer (graphcomponents)  ancestor: window

// w_graphviewer.ue_startdisplay() returns 0
	wf_plotgraph()

// w_graphviewer.ue_graph_type() returns 0
	setpointer(hourglass!)
	openwithparm(w_graph_type, this.gr_mygraph)

// w_graphviewer.ue_graph_color() returns 0
	setpointer(hourglass!)
	openwithparm(w_graph_color, this.gr_mygraph)

// w_graphviewer.ue_graph_title() returns 0
	setpointer(hourglass!)
	openwithparm(w_graph_title, this.gr_mygraph)
	this.istr_gop.title = this.gr_mygraph.title

// w_graphviewer.ue_graph_spacing() returns 0
	setpointer(hourglass!)
	openwithparm(w_graph_spacing, this.gr_mygraph)

// w_graphviewer.ue_graph_division() returns 0
	setpointer(hourglass!)
	openwithparm(w_graph_division, this.gr_mygraph)

// w_graphviewer.ue_graph_rotation() returns 0
	setpointer(hourglass!)
	openwithparm(w_graph_rotation, this.gr_mygraph)

// w_graphviewer.ue_copy_to_clipboard(unsignedlong wparam, long lparam) returns long
	this.gr_mygraph.clipboard()
	return ::message.returnvalue

// w_graphviewer.wf_print() returns 0
	long ll_printjob
	ll_printjob = printopen("Graph Printing")
	if printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		printcancel(ll_printjob)
	end if
	this.gr_mygraph.print(ll_printjob, 1000, printy(ll_printjob) + 500, 6000, 4500)
	printclose(ll_printjob)

// w_graphviewer.wf_saveas() returns 0
	this.gr_mygraph.saveas()

// w_graphviewer.wf_plotgraph() returns long
	long ll_index
	long ll_rowcount
	long ll_series_num
	long ll_counter
	long ll_innercounter
	s_arguements lstr_arg
	this.istr_gop.graphicobject = this.gr_mygraph
	openwithparm(w_graph_series, this.istr_gop)
	lstr_arg = message.powerobjectparm
	setredraw(false)
	if lstr_arg.i_status = 1 then
		setpointer(hourglass!)
		this.gr_mygraph.reset(all!)
		this.gr_mygraph.title = this.istr_gop.title
		this.istr_gop.categorycolumn = lstr_arg.s_name1
		this.gr_mygraph.category.label = lstr_arg.s_name2
		this.gr_mygraph.values.label = lstr_arg.s_name3
		if lstr_arg.s_name4 = "U" then
			this.gr_mygraph.categorysort = unsorted!
		elseif lstr_arg.s_name4 = "A" then
			this.gr_mygraph.categorysort = ascending!
		elseif lstr_arg.s_name4 = "D" then
			this.gr_mygraph.categorysort = descending!
		end if
		ll_rowcount = this.istr_gop.dw_dw1.rowcount()
		if upperbound(lstr_arg.sa_stringlist) > 0 then
			for ll_counter = 1 to upperbound(lstr_arg.sa_stringlist)
				ll_series_num = this.gr_mygraph.addseries(lstr_arg.sa_stringlist[ll_counter])
				if ll_series_num > 0 then
					for ll_innercounter = 1 to ll_rowcount
						this.gr_mygraph.adddata(ll_series_num, this.istr_gop.dw_dw1.getitemnumber(ll_innercounter, lstr_arg.sa_stringlist[ll_counter]), this.istr_gop.dw_dw1.getitemstring(ll_innercounter, lstr_arg.s_name1))
					next
				end if
			next
		else
			ll_series_num = this.gr_mygraph.addseries("count")
			if ll_series_num > 0 then
				for ll_innercounter = 1 to ll_rowcount
					this.gr_mygraph.adddata(ll_series_num, 1, this.istr_gop.dw_dw1.getitemstring(ll_innercounter, lstr_arg.s_name1))
				next
			end if
		end if
		setpointer(arrow!)
	end if
	setredraw(true)
	return 0

// w_graphviewer.create() returns 0
	if this.menuname = "m_graphviewer" then
		this.menuid = create m_graphviewer
	end if
	this.st_tooltip = create st_tooltip
	this.dw_hidden = create dw_hidden
	this.gr_mygraph = create gr_mygraph
	this.control = {this.st_tooltip, this.dw_hidden, this.gr_mygraph}

// w_graphviewer.destroy() returns 0
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.st_tooltip
	destroy this.dw_hidden
	destroy this.gr_mygraph

// w_graphviewer.open() returns long
	m_graphviewer lm_menu
	long ll_width
	long ll_height
	long ll_found
	environment env
	this.istr_gop = message.powerobjectparm
	if not isvalid(this.istr_gop.dw_dw1) then
		messagebox("Message", "Datawindow is not valid")
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	lm_menu = this.menuid
	this.menuid.dynamic mf_initsecurityapp(lm_menu)
	this.im_reportmenu = this.menuid
	if getenvironment(env) <> 1 then
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.gr_mygraph.width = ll_width * 0.985
	this.gr_mygraph.height = ll_height * 0.80
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 637", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_saveas.visible = true
		lm_menu.m_file.m_saveas.enabled = true
		lm_menu.m_file.m_saveas.toolbaritemvisible = true
	end if
	setredraw(true)
	postevent("ue_startdisplay")
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_graphviewer.activate() returns long
	this.windowstate = maximized!
	return ::message.returnvalue

