// gr_mygraph.ue_rbuttonup(unsignedlong flags, integer xpos, integer ypos) returns long
	parent.st_tooltip.visible = false
	return ::message.returnvalue

// gr_mygraph.rbuttondown(unsignedlong flags, integer xpos, integer ypos) returns long
	grobjecttype clickedobject
	integer li_series
	integer li_category
	clickedobject = objectatpointer(li_series, li_category)
	if clickedobject = typedata! then
		parent.st_tooltip.text = string(getdata(li_series, li_category), "###,###,##0.00")
		parent.st_tooltip.x = parent.pointerx()
		parent.st_tooltip.y = parent.pointery() - 65
		parent.st_tooltip.visible = true
	end if
	return ::message.returnvalue
