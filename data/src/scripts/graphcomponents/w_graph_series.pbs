// window w_graph_series (graphcomponents)  ancestor: w_center

// w_graph_series.open() returns long [event]
	long ancestorreturnvalue
	string ls_column_name
	string ls_names
	string[] ls_colnames
	string ls_coltype
	string ls_datatype
	string ls_temp
	string ls_seriesname
	long li_column_count
	long li_counter
	long ll_len
	long ll_lastpos
	long ll_arrcount
	long ll_count
	long ll_cat_row
	long ll_counter
	long ll_index
	integer rtncode
	datawindowchild ldc_categories
	graph lgr_1
	ancestorreturnvalue = super::open()
	this.dw_category.settransobject(sqlca)
	this.dw_category.retrieve()
	this.dw_category.scrolltorow(0)
	rtncode = this.dw_category.getchild("selectedcolumn", ldc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ldc_categories.settransobject(sqlca)
	this.istr_gop = message.powerobjectparm
	ls_names = this.istr_gop.dw_dw1.object.datawindow.objects
	ll_len = len(ls_names)
	ll_lastpos = 1
	ll_arrcount = 1
	for li_counter = 1 to ll_len
		if mid(ls_names, li_counter, 1) = "~t" then
			ls_colnames[ll_arrcount] = mid(ls_names, ll_lastpos, li_counter - ll_lastpos)
			ll_arrcount = ll_arrcount + 1
			ll_lastpos = li_counter + 1
		end if
	next
	ll_count = 0
	li_column_count = upperbound(ls_colnames)
	for li_counter = 1 to li_column_count
		ls_column_name = trim(ls_colnames[li_counter])
		ls_coltype = this.istr_gop.dw_dw1.describe(trim(ls_colnames[li_counter]) + ".type")
		if ls_coltype = "column" or ls_coltype = "compute" then
			ls_datatype = this.istr_gop.dw_dw1.describe(ls_column_name + ".coltype")
			if left(ls_datatype, 4) = "char" then
				ll_cat_row = ldc_categories.insertrow(0)
				ldc_categories.setitem(ll_cat_row, "colname", wordcap(ls_column_name))
			end if
			if ls_datatype = "number" or left(ls_datatype, 7) = "decimal" or left(ls_datatype, 4) = "long" then
				this.lb_valuecolumns.additem(wordcap(ls_column_name))
			end if
		end if
	next
	this.dw_sort.settransobject(sqlca)
	this.dw_sort.retrieve()
	this.dw_sort.scrolltorow(0)
	if this.istr_gop.graphicobject.typeof() = graph! then
		lgr_1 = this.istr_gop.graphicobject
		this.sle_category_label.text = lgr_1.category.label
		this.sle_value_label.text = lgr_1.values.label
		if lgr_1.categorysort = unsorted! then
			this.dw_sort.setitem(this.dw_sort.rowcount(), "sortorder", "U")
		elseif lgr_1.categorysort = ascending! then
			this.dw_sort.setitem(this.dw_sort.rowcount(), "sortorder", "A")
		elseif lgr_1.categorysort = descending! then
			this.dw_sort.setitem(this.dw_sort.rowcount(), "sortorder", "D")
		end if
		this.dw_category.object.selectedcolumn[this.dw_category.rowcount()] = lower(this.istr_gop.categorycolumn)
		if lgr_1.seriescount() > 0 then
			this.lb_valuecolumns.selectitem(0)
			for ll_counter = 1 to ll_counter
				ls_seriesname = wordcap(lgr_1.seriesname(ll_counter))
				ll_index = this.lb_valuecolumns.finditem(ls_seriesname, 0)
				this.lb_valuecolumns.selectitem(ll_index)
				this.lb_valuecolumns.setstate(ll_index, true)
			next
		end if
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_graph_series.create() returns 0 [event]
	integer icurrent
	call super::create
	this.dw_sort = create dw_sort
	this.lb_valuecolumns = create lb_valuecolumns
	this.sle_value_label = create sle_value_label
	this.st_5 = create st_5
	this.st_4 = create st_4
	this.st_3 = create st_3
	this.st_2 = create st_2
	this.st_1 = create st_1
	this.dw_category = create dw_category
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.sle_category_label = create sle_category_label
	this.gb_1 = create gb_1
	this.gb_2 = create gb_2
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_sort
	this.control[icurrent + 2] = this.lb_valuecolumns
	this.control[icurrent + 3] = this.sle_value_label
	this.control[icurrent + 4] = this.st_5
	this.control[icurrent + 5] = this.st_4
	this.control[icurrent + 6] = this.st_3
	this.control[icurrent + 7] = this.st_2
	this.control[icurrent + 8] = this.st_1
	this.control[icurrent + 9] = this.dw_category
	this.control[icurrent + 10] = this.cb_cancel
	this.control[icurrent + 11] = this.cb_ok
	this.control[icurrent + 12] = this.sle_category_label
	this.control[icurrent + 13] = this.gb_1
	this.control[icurrent + 14] = this.gb_2

// w_graph_series.destroy() returns 0 [event]
	call super::destroy
	destroy this.dw_sort
	destroy this.lb_valuecolumns
	destroy this.sle_value_label
	destroy this.st_5
	destroy this.st_4
	destroy this.st_3
	destroy this.st_2
	destroy this.st_1
	destroy this.dw_category
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.sle_category_label
	destroy this.gb_1
	destroy this.gb_2

// sle_value_label.modified() returns long [event]
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	s_arguements lstr_arg
	lstr_arg.i_status = -1
	parent.istr_arg = lstr_arg
	closewithreturn(parent, parent.istr_arg)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ll_counter
	long ll_rowcount
	long ll_innercounter
	long ll_series_num
	string[] ls_colname
	string ls_category
	string ls_temp
	if isnull(parent.dw_category.object.selectedcolumn[1]) or trim(parent.dw_category.object.selectedcolumn[1]) = "" then
		messagebox("Category Axis Validation", "Please Select a valid column for category axis")
		return ::message.returnvalue
	else
		ls_category = parent.dw_category.object.selectedcolumn[1]
	end if
	for ll_counter = 1 to ll_counter
		if parent.lb_valuecolumns.state(ll_counter) = 1 then
			ll_innercounter = ll_innercounter + 1
			ls_colname[ll_innercounter] = parent.lb_valuecolumns.text(ll_counter)
		end if
	next
	parent.istr_arg.s_name1 = ls_category
	parent.istr_arg.s_name2 = parent.sle_category_label.text
	parent.istr_arg.s_name3 = parent.sle_value_label.text
	parent.istr_arg.s_name4 = parent.dw_sort.object.sortorder[1]
	parent.istr_arg.sa_stringlist = ls_colname
	parent.istr_arg.l_code1 = long(ls_temp)
	parent.istr_arg.i_status = 1
	closewithreturn(parent, parent.istr_arg)
	return ::message.returnvalue

// sle_category_label.modified() returns long [event]
	return ::message.returnvalue
