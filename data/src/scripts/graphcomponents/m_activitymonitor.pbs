// m_clearactivitymonitorhistory.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_clearactivitymonitorhistory()

// m_clearactivitymonitorhistory.create() returns 0 [event]
	call super::create
	this.visible = false
