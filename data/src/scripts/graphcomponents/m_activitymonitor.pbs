// menu m_activitymonitor (graphcomponents)  ancestor: menu

// m_activitymonitor.create() returns 0 [event]
	m_activitymonitor = this
	call super::create
	this.text = "m_activitymonitor"
	this.m_activitylist = create m_activitylist
	this.item[upperbound(this.item) + 1] = this.m_activitylist

// m_activitymonitor.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_activitylist

// m_activitylist.create() returns 0 [event]
	call super::create
	this.text = "Activity &List"
	this.m_refresh = create m_refresh
	this.m_filter = create m_filter
	this.m_sort = create m_sort
	this.m_print = create m_print
	this.m_preview = create m_preview
	this.m_clearactivitymonitorhistory = create m_clearactivitymonitorhistory
	this.m_exit = create m_exit
	this.item[upperbound(this.item) + 1] = this.m_refresh
	this.item[upperbound(this.item) + 1] = this.m_filter
	this.item[upperbound(this.item) + 1] = this.m_sort
	this.item[upperbound(this.item) + 1] = this.m_print
	this.item[upperbound(this.item) + 1] = this.m_preview
	this.item[upperbound(this.item) + 1] = this.m_clearactivitymonitorhistory
	this.item[upperbound(this.item) + 1] = this.m_exit

// m_activitylist.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_refresh
	destroy this.m_filter
	destroy this.m_sort
	destroy this.m_print
	destroy this.m_preview
	destroy this.m_clearactivitymonitorhistory
	destroy this.m_exit

// m_refresh.create() returns 0 [event]
	call super::create
	this.text = "&Refresh~tF5"
	this.shortcut = 116
	this.toolbaritemname = "Regenerate5!"
	this.toolbaritemtext = "Refresh List"

// m_refresh.destroy() returns 0 [event]
	call super::destroy

// m_refresh.clicked() returns 0 [event]
