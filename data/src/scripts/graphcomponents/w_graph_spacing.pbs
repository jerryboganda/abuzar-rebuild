// window w_graph_spacing (graphcomponents)  ancestor: w_center

// w_graph_spacing.open() returns long
	long ancestorreturnvalue
	graphicobject lgro_hold
	ancestorreturnvalue = super::open()
	lgro_hold = message.powerobjectparm
	if lgro_hold.typeof() = graph! then
		this.io_passed = graph!
		this.igr_parm = message.powerobjectparm
		this.em_spacing.text = string(this.igr_parm.spacing)
		this.ii_original_spacing = this.igr_parm.spacing
	elseif lgro_hold.typeof() = datawindow! then
		this.io_passed = datawindow!
		this.idw_parm = message.powerobjectparm
		this.em_spacing.text = this.idw_parm.object.gr_1.spacing
		this.ii_original_spacing = integer(this.em_spacing.text)
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_graph_spacing.create() returns 0
	integer icurrent
	call super::create
	this.em_spacing = create em_spacing
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.em_spacing
	this.control[icurrent + 2] = this.cb_cancel
	this.control[icurrent + 3] = this.cb_ok

// w_graph_spacing.destroy() returns 0
	call super::destroy
	destroy this.em_spacing
	destroy this.cb_cancel
	destroy this.cb_ok

// em_spacing.ue_enchange() returns long
	if parent.io_passed = graph! then
		parent.igr_parm.spacing = integer(parent.em_spacing.text)
	elseif parent.io_passed = datawindow! then
		parent.idw_parm.object.gr_1.spacing = parent.em_spacing.text
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	if parent.io_passed = graph! then
		parent.igr_parm.spacing = parent.ii_original_spacing
	elseif parent.io_passed = datawindow! then
		parent.idw_parm.object.gr_1.spacing = string(parent.ii_original_spacing)
	end if
	close(parent)
	return ::message.returnvalue

// cb_ok.clicked() returns long
	close(parent)
	return ::message.returnvalue
