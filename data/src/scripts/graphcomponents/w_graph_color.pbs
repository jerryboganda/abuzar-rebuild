// sle_blue.() returns long
	selecttext(1, len(this.text))
	if not isvalid(::message) then
		return 0
	end if
	return ::message.field6

// sle_blue.() returns long
	integer li_new_value
	if isnumber(this.text) then
		li_new_value = integer(this.text)
		if li_new_value < 0 or li_new_value > 255 then
			beep(1)
			this.text = string(parent.ii_b)
		else
			parent.ii_b = li_new_value
			parent.rr_1.fillcolor = rgb(parent.ii_r, parent.ii_g, parent.ii_b)
			parent.hsb_blue.position = parent.ii_b
			parent.triggerevent("color_changed")
		end if
	else
		beep(1)
		this.text = string(parent.ii_b)
	end if
	if not isvalid(::message) then
		return 0
	end if
	return ::message.field6

