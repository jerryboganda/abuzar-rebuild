// window w_pick_color (graphcomponents)  ancestor: w_center

// w_pick_color.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.istr_color = message.powerobjectparm
	this.uo_color_select.uf_set_rgb(this.istr_color.l_colorvalue)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_pick_color.create() returns 0 [event]
	integer icurrent
	call super::create
	this.cb_cancel = create cb_cancel
	this.uo_color_select = create uo_color_select
	this.cb_ok = create cb_ok
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cb_cancel
	this.control[icurrent + 2] = this.uo_color_select
	this.control[icurrent + 3] = this.cb_ok

// w_pick_color.destroy() returns 0 [event]
	call super::destroy
	destroy this.cb_cancel
	destroy this.uo_color_select
	destroy this.cb_ok

// cb_cancel.clicked() returns long [event]
	parent.istr_color.i_status = 0
	closewithreturn(parent, parent.istr_color)
	return ::message.returnvalue

// uo_color_select.destroy() returns 0 [event]
	call super::destroy

// hsb_green.() returns long
	if parent.ii_g > 205 then
		parent.ii_g = 255
	else
		parent.ii_g = parent.ii_g + 50
	end if
	parent.sle_green.text = string(parent.ii_g)
	this.position = parent.ii_g
	parent.rr_1.fillcolor = rgb(parent.ii_r, parent.ii_g, parent.ii_b)
	parent.triggerevent("color_changed")
	if not isvalid(::message) then
		return 0
	end if
	return ::message.fillcolor

// hsb_green.() returns long
	if parent.ii_g < 10 then
		parent.ii_g = 0
	else
		parent.ii_g = parent.ii_g - 10
	end if
	parent.sle_green.text = string(parent.ii_g)
	this.position = parent.ii_g
	parent.rr_1.fillcolor = rgb(parent.ii_r, parent.ii_g, parent.ii_b)
	parent.triggerevent("color_changed")
	if not isvalid(::message) then
		return 0
	end if
	return ::message.fillcolor

// hsb_green.       () returns long
	if parent.ii_g > 245 then
		parent.ii_g = 255
	else
		parent.ii_g = parent.ii_g + 10
	end if
	parent.sle_green.text = string(parent.ii_g)
	this.position = parent.ii_g
	parent.rr_1.fillcolor = rgb(parent.ii_r, parent.ii_g, parent.ii_b)
	parent.triggerevent("color_changed")
	if not isvalid(::message) then
		return 0
	end if
	return ::message.fillcolor

// hsb_green.ter(integer +scrollpos) returns long
	parent.ii_g = this.position
	parent.sle_green.text = string(parent.ii_g)
	parent.rr_1.fillcolor = rgb(parent.ii_r, parent.ii_g, parent.ii_b)
	parent.triggerevent("color_changed")
	if not isvalid(::message) then
		return 0
	end if
	return ::message.fillcolor

// hsb_green.ick_color() returns long
	if parent.ii_g < 50 then
