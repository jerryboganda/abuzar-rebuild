	else
		parent.ii_g = parent.ii_g - 50
	end if
	parent.sle_green.text = string(parent.ii_g)
	this.position = parent.ii_g
	parent.rr_1.fillcolor = rgb(parent.ii_r, parent.ii_g, parent.ii_b)
