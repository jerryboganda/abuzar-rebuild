// cb_ok.clicked() returns long [event]
	parent.istr_color.i_status = 1
	parent.istr_color.l_colorvalue = parent.uo_color_select.uf_get_rgb()
	parent.istr_color.i_red = parent.uo_color_select.uf_get_red()
	parent.istr_color.i_green = parent.uo_color_select.uf_get_green()
	parent.istr_color.i_blue = parent.uo_color_select.uf_get_blue()
	closewithreturn(parent, parent.istr_color)
	return ::message.returnvalue
