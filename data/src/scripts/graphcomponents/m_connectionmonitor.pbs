	this.shortcut = 118
	this.toolbaritemname = "Sort!"
	this.toolbaritemtext = "Sort List"

// m_sort.destroy() returns 0
	call super::destroy

// m_sort.clicked() returns 0
	this.parentwindow.dynamic wf_sort()

// m_exit.create() returns 0
	call super::create
	this.text = "&Exit"

// m_exit.destroy() returns 0
	call super::destroy

// m_exit.clicked() returns 0
	close(this.parentwindow)
