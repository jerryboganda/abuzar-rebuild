// menu m_connectionmonitor (graphcomponents)  ancestor: menu

// m_connectionmonitor.create() returns 0
	m_connectionmonitor = this
	call super::create
	this.text = "m_connectionmonitor"
	this.m_session = create m_session
	this.item[upperbound(this.item) + 1] = this.m_session

// m_connectionmonitor.destroy() returns 0
	call super::destroy
	destroy this.m_session

// m_session.create() returns 0
	call super::create
	this.text = "&Session"
	this.m_refresh = create m_refresh
	this.m_filter = create m_filter
	this.m_sort = create m_sort
	this.m_exit = create m_exit
	this.item[upperbound(this.item) + 1] = this.m_refresh
	this.item[upperbound(this.item) + 1] = this.m_filter
	this.item[upperbound(this.item) + 1] = this.m_sort
	this.item[upperbound(this.item) + 1] = this.m_exit

// m_session.destroy() returns 0
	call super::destroy
	destroy this.m_refresh
	destroy this.m_filter
	destroy this.m_sort
	destroy this.m_exit

// m_refresh.create() returns 0
	call super::create
	this.text = "&Refresh~tF5"
	this.shortcut = 116
	this.toolbaritemname = "Regenerate5!"
	this.toolbaritemtext = "Refresh List"

// m_refresh.destroy() returns 0
	call super::destroy

// m_refresh.clicked() returns 0
	this.parentwindow.dynamic wf_refresh()

// m_filter.create() returns 0
	call super::create
	this.text = "&Filter~tF6"
	this.shortcut = 117
	this.toolbaritemname = "Having!"
	this.toolbaritemtext = "Filter List"

// m_filter.destroy() returns 0
	call super::destroy

// m_filter.clicked() returns 0
