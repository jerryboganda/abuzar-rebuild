// window w_activitymonitor (graphcomponents)  ancestor: window

// w_activitymonitor.wf_refresh() returns long
	long ll_index
	long ll_rowcount
	long ll_series_num
	long ll_counter
	long ll_innercounter
	long ll_groupcode
	long ll_prints_left
	long[] ll_docrowid
	long ll_printable_count
	long ll_min_refresh
	boolean lb_continue
	datetime ldt_startdate
	if this.id_button.rowcount() = 0 then
		return 0
	end if
	ll_min_refresh = this.id_button.object.activityperiod[1]
	setpointer(hourglass!)
	setredraw(false)
	ll_groupcode = f_getgroupcode(gl_usercode)
	ll_min_refresh = f_numberpreferences("ActMonPeriod")
	if this.ib_editrefresh = false then
		this.id_button.retrieve()
		ldt_startdate = this.id_button.object.startdate[1]
	else
		ll_min_refresh = -1
		ldt_startdate = this.id_button.object.startdate[1]
	end if
	this.id_summary.retrieve()
	this.id_list.retrieve(ll_min_refresh, ldt_startdate, ll_groupcode, this.is_doctype)
	ll_rowcount = this.id_list.rowcount()
	wf_plotgraph_and_summary()
	if this.ib_autoprint then
		wf_print(1)
	end if
	setpointer(arrow!)
	setredraw(true)
	return 0

