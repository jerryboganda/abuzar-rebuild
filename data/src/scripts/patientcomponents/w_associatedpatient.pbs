// window w_associatedpatient (patientcomponents)  ancestor: window

// w_associatedpatient.create() returns 0 [event]
	this.dw_previnv = create dw_previnv
	this.control = {this.dw_previnv}

// w_associatedpatient.destroy() returns 0 [event]
	destroy this.dw_previnv

// w_associatedpatient.open() returns long [event]
	long ll_width
	long ll_height
	long ll_patientcode
	long ll_counter
	long ll_rowcount
	environment env
	ll_patientcode = message.doubleparm
	if getenvironment(env) <> 1 then
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.width = ll_width * 0.98
	this.height = ll_height * 0.80
	this.y = int((ll_height - this.height) / 2.0)
	this.dw_previnv.width = this.width - this.width * 0.02
	this.dw_previnv.height = this.height - this.width * 0.05
	this.dw_previnv.settransobject(sqlca)
	ll_rowcount = this.dw_previnv.retrieve(ll_patientcode)
	this.dw_previnv.modify("DataWindow.Print.Preview=yes")
	this.dw_previnv.object.datawindow.print.buttons = "yes"
	setredraw(true)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_associatedpatient.close() returns long [event]
	close(this)
	return ::message.returnvalue

// w_associatedpatient.key(keycode key, unsignedlong keyflags) returns long [event]
	if keydown(keyescape!) then
		close(this)
	end if
	return ::message.returnvalue
