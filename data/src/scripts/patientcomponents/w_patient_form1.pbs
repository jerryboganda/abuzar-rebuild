// window w_patient_form1 (patientcomponents)  ancestor: w_single_entry

// w_patient_form1.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM ItemClass WHERE ItemClass.name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_patient_form1.wf_duplicateregno(string as_name) returns boolean
	long ll_count
	long ll_patientcode
	boolean b_flag
	as_name = trim(as_name)
	ll_patientcode = this.id_detail.object.code[this.id_detail.rowcount()]
	if isnull(ll_patientcode) then
		SQL SELECT count ( *) INTO :ll_count FROM Patient WHERE patient.regno =:as_name USING sqlca;
	else
		SQL SELECT count ( *) INTO :ll_count FROM Patient WHERE patient.regno =:as_name AND Patient.PatientCode <> :ll_patientcode USING sqlca;
	end if
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_patient_form1.wf_admitted(long al_patientcode) returns long
	long ll_count
	SQL SELECT Count ( *) INTO :ll_count FROM PatientAdmission WHERE PatientAdmission.PatientCode =:al_patientcode AND PatientAdmission.Discharged ='N' USING sqlca;
	return ll_count

// w_patient_form1.wf_locationoccupied(long al_locationcode) returns long
	long ll_retcode
	SQL SELECT COUNT ( *) INTO :ll_retcode FROM ( SELECT LocationCode FROM PatientAdmission WHERE Discharged ='N' AND AdmissionCode NOT IN ( SELECT DISTINCT AdmissionCode FROM PatientTransfer ) UNION ALL SELECT LocationCode =TargetLocation FROM PatientTransfer WHERE TransferCode IN ( SELECT TransferCode =Max ( TransferCode ) FROM PatientTransfer WHERE AdmissionCode IN ( SELECT DISTINCT AdmissionCode FROM PatientAdmission WHERE Discharged ='N' ) GROUP BY AdmissionCode ) ) A WHERE LocationCode =:al_locationcode USING sqlca;
	return ll_retcode

// w_patient_form1.wf_assign_master_cash_win_object() returns 0
	this.ids_cashwin = create u_ds_standard
	this.ids_cashwin.dataobject = "d_mastercashierwindow_detail"
	this.ids_cashwin.settransobject(sqlca)

// w_patient_form1.wf_set_cashaccount() returns long
	long ll_cashacccode
	long ll_module
	long ll_code
	ll_module = 14
	ll_code = this.id_detail.object.code[this.id_detail.rowcount()]
	ll_cashacccode = f_is_group_module_cashaccount_allowed(this.il_groupcode, ll_module)
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		ll_cashacccode = 0
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
	elseif isnull(ll_code) or this.id_detail.object.code[1] <= 0 then
		this.id_detail.object.cashacccode[this.id_detail.rowcount()] = ll_cashacccode
	else
		ll_cashacccode = this.id_detail.object.cashacccode[this.id_detail.rowcount()]
	end if
	return ll_cashacccode

// w_patient_form1.wf_show_mastercashierwindow() returns long
	long ll_counter
	long ll_code
	long ll_row
	long ll_insrow
	long ll_module
	long ll_cashacccode
	double ld_tot_acc_amt
	s_mastercashwin_all lstr_values
	lstr_values.i_interfacecode = 16
	if f_stringpreferences("askmastercashwin_in_patientreg") = "N" then
		return 1
	end if
	ll_module = 14
	ll_code = this.id_detail.object.code[this.id_detail.rowcount()]
	ll_cashacccode = this.id_detail.object.cashacccode[this.id_detail.rowcount()]
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
		return 0
	end if
	lstr_values.l_doccode = ll_code
	lstr_values.s_doctype = this.is_doctype
	lstr_values.l_cashacccode = ll_cashacccode
	lstr_values.l_groupcode = this.il_groupcode
	lstr_values.l_module = ll_module
	lstr_values.d_netamt = wf_grandtotal()
	lstr_values.d_cashtendered = this.id_detail.object.cashtendered[this.id_detail.rowcount()]
	lstr_values.d_cashcharged = this.id_detail.object.cashcharged[this.id_detail.rowcount()]
	lstr_values.d_cashback = this.id_detail.object.cashback[this.id_detail.rowcount()]
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		lstr_values.l_acccode[ll_counter] = this.ids_cashwin.object.acccode[ll_counter]
		lstr_values.s_remarks[ll_counter] = this.ids_cashwin.object.remarks[ll_counter]
		lstr_values.d_amount[ll_counter] = this.ids_cashwin.object.amount[ll_counter]
		lstr_values.l_rowid[ll_counter] = this.ids_cashwin.object.rowid[ll_counter]
		ld_tot_acc_amt = ld_tot_acc_amt + this.ids_cashwin.object.amount[ll_counter]
	next
	if lstr_values.d_netamt >= lstr_values.d_cashcharged then
		lstr_values.d_docbalance = lstr_values.d_netamt - lstr_values.d_cashcharged - ld_tot_acc_amt
	else
		lstr_values.d_docbalance = 0
	end if
	for ll_counter = 1 to 100
		if lstr_values.l_rowid[ll_counter] <= 0 then
			lstr_values.l_rowid[ll_counter] = -1
		end if
	next
	openwithparm(w_mastercashierwindow, lstr_values)
	lstr_values = message.powerobjectparm
	if lstr_values.i_status = 1 then
		this.ids_cashwin.reset()
		ld_tot_acc_amt = 0
		for ll_counter = 1 to 100
			if lstr_values.l_acccode[ll_counter] > 0 and lstr_values.d_amount[ll_counter] > 0 and lstr_values.l_rowid[ll_counter] > 0 then
				ll_insrow = this.ids_cashwin.insertrow(0)
				this.ids_cashwin.object.documentcode[ll_insrow] = ll_code
				this.ids_cashwin.object.documenttype[ll_insrow] = this.is_doctype
				this.ids_cashwin.object.acccode[ll_insrow] = lstr_values.l_acccode[ll_counter]
				this.ids_cashwin.object.remarks[ll_insrow] = lstr_values.s_remarks[ll_counter]
				this.ids_cashwin.object.amount[ll_insrow] = lstr_values.d_amount[ll_counter]
				this.ids_cashwin.object.rowid[ll_insrow] = lstr_values.l_rowid[ll_counter]
			end if
		next
		this.id_detail.object.cashacccode[this.id_detail.rowcount()] = lstr_values.l_cashacccode
		this.id_detail.object.cashtendered[this.id_detail.rowcount()] = lstr_values.d_cashtendered
		this.id_detail.object.cashcharged[this.id_detail.rowcount()] = lstr_values.d_cashcharged
		this.id_detail.object.cashback[this.id_detail.rowcount()] = lstr_values.d_cashback
		return 1
	end if
	return 0

// w_patient_form1.wf_update_mastercashierwindow(long al_code, string as_type, long al_new_pat_reg) returns long
	long ll_counter
	if al_new_pat_reg = 1 then
		for ll_counter = 1 to this.ids_cashwin.rowcount()
			this.ids_cashwin.object.documentcode[ll_counter] = al_code
			this.ids_cashwin.object.documenttype[ll_counter] = as_type
			this.ids_cashwin.object.date[ll_counter] = this.id_detail.object.date[1]
		next
		SQL DELETE DBO.MasterCashWin WHERE DocumentCode =:al_code AND DocumentType =:as_type USING sqlca;
		if sqlca.sqlcode = 0 then
			if this.ids_cashwin.update() > 0 then
				return 0
			else
				return -1
			end if
		else
			return -1
		end if
		return
	end if
	return 0

// w_patient_form1.wf_setprintout() returns long
	long ll_retcode
	string ls_printout
	m_patientmenu lm_menu
	lm_menu = this.menuid
	if lm_menu.m_file.m_printgeneralpatientform.checked = true then
		ls_printout = ""
	else
		ls_printout = f_set_patientprintout()
	end if
	if ls_printout = "" then
		ls_printout = "d_patientregisteration_print"
	end if
	this.id_print.dataobject = ls_printout
	return ll_retcode

// w_patient_form1.wf_setimage() returns long
	long ll_counter
	long ll_code
	long ll_row
	s_itemimage lstr_image
	for ll_counter = 1 to this.id_image.rowcount()
		lstr_image.ls_value[ll_counter, 1] = trim(string(this.id_image.object.rowid[ll_counter]))
		lstr_image.ls_value[ll_counter, 2] = this.id_image.object.imagedescription[ll_counter]
		lstr_image.ls_value[ll_counter, 3] = this.id_image.object.imagetype[ll_counter]
		lstr_image.blob[ll_counter] = this.istr_image.blob[ll_counter]
	next
	openwithparm(w_patientimage, lstr_image)
	lstr_image = message.powerobjectparm
	if lstr_image.i_closemode = 1 then
		this.istr_image = lstr_image
		this.id_image.reset()
		ll_code = this.id_detail.object.code[this.id_detail.rowcount()]
		for ll_counter = 1 to 200
			if long(lstr_image.ls_value[ll_counter, 1]) > 0 then
				ll_row = this.id_image.insertrow(0)
				this.id_image.object.code[ll_row] = ll_code
				this.id_image.object.rowid[ll_row] = long(lstr_image.ls_value[ll_counter, 1])
				this.id_image.object.imagedescription[ll_row] = lstr_image.ls_value[ll_counter, 2]
				this.id_image.object.imagetype[ll_row] = lstr_image.ls_value[ll_counter, 3]
			end if
		next
	end if
	return 0

// w_patient_form1.wf_populate_image() returns long
	long ll_counter
	long ll_rowcount
	long ll_code
	ll_rowcount = this.id_image.rowcount()
	if ll_rowcount <= 0 then
		return 0
	end if
	ll_code = this.id_image.object.code[1]
	for ll_counter = 1 to ll_rowcount
		this.istr_image.ls_value[ll_counter, 1] = trim(string(this.id_image.object.rowid[ll_counter]))
		this.istr_image.ls_value[ll_counter, 2] = this.id_image.object.imagedescription[ll_counter]
		this.istr_image.ls_value[ll_counter, 3] = this.id_image.object.imagetype[ll_counter]
		wf_get_image(ll_code, ll_counter)
	next
	return 0

// w_patient_form1.wf_get_image(long al_code, long al_row) returns long
	blob lbl_image
	u_transaction lt_transobject
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server")
		destroy lt_transobject
		return -1
	end if
	SQL SelectBlob PatientImage INTO :lbl_image From PatientImage Where Patientcode =:al_code AND RowID =:al_row USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Patient Image/Picture ", "Unable to fetch patient Image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	this.istr_image.blob[al_row] = lbl_image
	return 0

// w_patient_form1.wf_update_image(long al_code) returns long
	long ll_counter
	long ll_code
	long ll_rowid
	string ls_desc
	string ls_imgtype
	u_transaction lt_transobject
	ll_code = al_code
	if al_code > 0 and this.id_image.rowcount() = 0 then
		return 0
	end if
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server for updating/inserting in Patient Document Table")
		destroy lt_transobject
		return -1
	end if
	SQL DELETE PatientImage WHERE PatientCode =:ll_code USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to Delete Previous Patient Document Record from database")
		destroy lt_transobject
		return -1
	end if
	for ll_counter = 1 to this.id_image.rowcount()
		ll_rowid = this.id_image.object.rowid[ll_counter]
		ls_desc = this.id_image.object.imagedescription[ll_counter]
		ls_imgtype = this.id_image.object.imagetype[ll_counter]
		SQL INSERT INTO PatientImage ( Patientcode , ImageDescription , RowID , ImageType ) VALUES ( :ll_code , :ls_desc , :ll_rowid , :ls_imgtype ) USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Insert Error", "Unable to Insert Patient Documents Into Patient Documents Table.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
			SQL stop USING lt_transobject;
			destroy lt_transobject
			return -1
		end if
		SQL UpdateBlob PatientImage Set PatientImage =:this.istr_image.blob[ll_counter] Where Patientcode =:ll_code and ROWID =:ll_rowid USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Patient Document", "Unable to update Patient Document.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		end if
	next
	SQL stop USING lt_transobject;
	destroy lt_transobject
	return 0

// w_patient_form1.wf_show_associated_patient() returns long
	long ll_patientcode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_detail.rowcount() > 0 and this.id_detail.getrow() > 0 then
			ll_patientcode = this.id_detail.object.code[this.id_detail.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_patientcode = this.id_list.object.code[this.id_list.getrow()]
	end if
	if not isnull(ll_patientcode) and ll_patientcode <> 0 then
		openwithparm(w_associatedpatient, ll_patientcode)
	end if
	return 0

// w_patient_form1.wf_show_patientledger() returns long
	long ll_patientcode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_detail.rowcount() > 0 and this.id_detail.getrow() > 0 then
			ll_patientcode = this.id_detail.object.code[this.id_detail.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_patientcode = this.id_list.object.code[this.id_list.getrow()]
	end if
	if not isnull(ll_patientcode) and ll_patientcode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_patient_ledger, ll_patientcode)
	end if
	return 0

// w_patient_form1.wf_printmedicalrecord() returns 0
	long ll_code
	long ll_row
	long li_printretcode
	string ls_printsize
	boolean lb_listtab
	s_datastore lstr
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_code) or ll_code <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_code = this.id_detail.getitemnumber(1, "code")
	end if
	this.dw_pmr.settransobject(this.it_transobject)
	this.dw_pmr.retrieve(ll_code)
	if lb_listtab then
		lstr.dw = this.dw_pmr
		lstr.s_name1 = this.dw_pmr.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.dw_pmr.rowcount() > 0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.dw_pmr.printcancel()
		end if
		li_printretcode = this.dw_pmr.print()
		if li_printretcode < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print,~r~nNo rows are retrieved", information!)

// w_patient_form1.wf_show_vaccineschedule(long al_patientcode) returns long
	openwithparm(w_vaccineschedule_info, al_patientcode)
	return 0

// w_patient_form1.wf_retrieve() returns long
	long rtcode
	rtcode = this.id_dwcontrol.retrieve(14)
	return rtcode

// w_patient_form1.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_patientmenu" then
		this.menuid = create m_patientmenu
	end if
	this.dw_image = create dw_image
	this.dw_pmr = create dw_pmr
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_image
	this.control[icurrent + 2] = this.dw_pmr

// w_patient_form1.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_image
	destroy this.dw_pmr

// w_patient_form1.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_patient_form1.open() returns long [event]
	long ancestorreturnvalue
	m_patientmenu lm_menu
	integer li_rtncode
	ancestorreturnvalue = super::open()
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	li_rtncode = this.id_detail.getchild("patientcatcode", this.idc_patientcat)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return ::message.returnvalue
	end if
	this.idc_patientcat.settransobject(sqlca)
	li_rtncode = this.idc_patientcat.retrieve(14)
	if li_rtncode <= 0 then
		messagebox("Patient Registration", "Not Enough Patient Categories Allowed, Please contact your system administrator")
		close(this)
		return ::message.returnvalue
	else
		this.id_detail.object.patientcatcode.initial = string(this.idc_patientcat.getitemnumber(1, "patientcatcode"))
	end if
	this.is_tablename = "patient"
	this.id_print.dataobject = "d_patientregisteration_print"
	this.id_print.settransobject(sqlca)
	this.id_image = this.dw_image
	this.id_image.settransobject(this.it_transobject)
	if f_stringpreferences("ApplyDoctorDutyRosterInPatientReg") = "Y" then
		this.id_detail.object.doctcode.initial = trim(string(f_get_duty_doctor()))
	end if
	if f_stringpreferences("LockDoctorInPatientReg") = "Y" then
		this.id_detail.object.doctcode.protect = "1"
	end if
	return ::message.returnvalue

// w_patient_form1.ue_save() returns 0 [event]
	long ll_primarykey
	long ll_row
	long ll_primarykey2
	long ll_totrows
	long ll_rowcounter
	long ll_usercode
	long ll_found
	long ll_null
	long ll_primarycode_old
	long ll_new_pat_reg
	long ll_counter
	integer li_patientcatcode
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_regno
	string ls_patientcode
	string ls_errtext
	boolean lb_commit
	dwitemstatus ldw_active
	setnull(ll_null)
	setpointer(hourglass!)
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if wf_set_cashaccount() = 0 then
		return
	end if
	ll_row = this.id_detail.getrow()
	ll_primarykey = this.id_detail.object.code[this.id_detail.getrow()]
	if isnull(ll_primarykey) and not f_rightexists(5024) then
		messagebox("Problem Saving", "You do not have the Right to enter New Patient~r~nPlease ask system administrator to do the needfull.")
		this.id_detail.setfocus()
		this.id_detail.setcolumn("regno")
		return
	end if
	if ll_primarykey > 0 and not f_rightexists(5025) then
		messagebox("Problem Saving", "You do not have the Right to modify Patient Record~r~nPlease ask system administrator to do the needfull.")
		this.id_detail.setfocus()
		this.id_detail.setcolumn("regno")
		return
	end if
	ll_primarycode_old = ll_primarykey
	ls_regno = this.id_detail.object.regno[ll_row]
	if f_stringpreferences("AutoGeneratePatientRegNo") <> "N" then
		if len(ls_regno) > 0 and wf_duplicateregno(ls_regno) then
			messagebox("Problem Saving", "Duplicate Patient Reg. No.~r~nPlease give some other Reg. No.")
			this.id_detail.setfocus()
			this.id_detail.setcolumn("regno")
			return
		end if
	elseif f_stringpreferences("AutoGeneratePatientRegNo") = "N" and wf_duplicateregno(ls_regno) then
		messagebox("Problem Saving", "Duplicate Patient Reg. No.~r~nPlease give some other Reg. No.")
		this.id_detail.setfocus()
		this.id_detail.setcolumn("regno")
		return
	end if
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	this.id_detail.object.date[ll_row] = ldt_server_datetime
	ldw_active = this.id_detail.getitemstatus(ll_row, "active", primary!)
	if not isnull(ll_primarykey) and this.id_detail.object.active[ll_row] = "Y" and ldw_active = datamodified! then
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 608", 1, gds_securitywindow.rowcount())
		if ll_found <= 0 then
			messagebox("Patient Registration!", "You do not have sufficient rights mark patient as active~r~nPlease contact your system administrator to do the needfull", stopsign!)
			return
		end if
		return
	end if
	if f_stringpreferences("askuserpwdinpatientreg") = "Y" then
		open(w_salesmanpassword)
		ll_usercode = long(message.doubleparm)
		setfocus()
	else
		ll_usercode = gl_usercode
	end if
	if ll_usercode > 0 then
		if isnull(ll_primarykey) then
			ll_new_pat_reg = 1
			if wf_show_mastercashierwindow() = 0 then
				return
			end if
			ll_primarykey = 0
			SQL rollback USING sqlca;
			sqlca.gettabmaxkey(this.is_tablename, ll_primarykey)
			if sqlca.sqlcode = 0 then
				this.id_detail.setitem(ll_row, "code", ll_primarykey)
				this.id_detail.object.originaldate[ll_row] = ldt_server_datetime
				this.id_detail.object.createdby[ll_row] = ll_usercode
				if isnull(this.id_detail.getitemstring(1, "membershipid")) then
					this.id_detail.setitem(this.id_detail.getrow(), "membershipid", string(ll_primarykey))
				end if
				li_patientcatcode = this.id_detail.object.patientcatcode[ll_row]
				for ll_counter = 1 to this.id_image.rowcount()
					this.id_image.setitem(ll_counter, "code", ll_primarykey)
				next
				if f_stringpreferences("AutoGeneratePatientRegNo") = "Y" then
					if isnull(this.id_detail.object.regno[ll_row]) or len(ls_regno) = 0 or this.id_detail.object.regno[ll_row] = "" then
						this.id_detail.object.regno[ll_row] = trim(string(ll_primarykey))
					end if
				elseif f_stringpreferences("AutoGeneratePatientRegNo") = "C" and (isnull(this.id_detail.object.regno[ll_row]) or len(ls_regno) = 0 or this.id_detail.object.regno[ll_row] = "") then
					ls_regno = "                             "
					if sqlca.autogeneratepatientregno(li_patientcatcode, ls_regno) = 0 then
						this.id_detail.object.regno[ll_row] = ls_regno
					else
						SQL rollback USING sqlca;
						lb_commit = false
						messagebox("Patient Registration Problem", "Problem in Auto Generation of Patient Reg. No.~r~n Possibe Reason: " + sqlca.sqlerrtext)
					end if
				end if
			else
				SQL rollback USING sqlca;
				lb_commit = false
				this.id_detail.setitem(ll_row, "code", ll_null)
				messagebox("Patient Registration Problem", "Problem in Generation of Patient Code~r~n Possibe Reason: " + sqlca.sqlerrtext)
			end if
		end if
		if lb_commit then
			if this.id_detail.object.active[ll_row] = "N" and (ldw_active = datamodified! or ldw_active = newmodified!) then
				this.id_detail.object.inactivedate[ll_row] = ldt_server_datetime
				this.id_detail.object.inactivedby[ll_row] = ll_usercode
			end if
			this.id_detail.setitem(ll_row, "usercode", ll_usercode)
			if f_stringpreferences("askmastercashwin_in_patientreg") = "N" then
				this.id_detail.object.cashtendered[1] = 0
				this.id_detail.object.cashcharged[1] = 0
				this.id_detail.object.cashback[1] = 0
				this.id_detail.accepttext()
			end if
			if this.id_detail.update() > 0 then
				if wf_update_mastercashierwindow(ll_primarykey, this.is_doctype, ll_new_pat_reg) = 0 then
					SQL commit USING sqlca;
					messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
					this.ib_commitok = true
					this.il_codevalue = ll_primarykey
					this.im_menu.m_file.m_new.enabled = true
					this.editflag = false
					if wf_update_image(ll_primarykey) = 0 then
						this.id_image.reset()
						this.istr_image = this.istr_blank_image
					end if
					if ll_new_pat_reg = 1 then
						ls_patientcode = trim(string(ll_primarykey))
						this.it_transobject.createautotriggersms(ls_patientcode, 14, "Saving")
						if this.it_transobject.sqlcode <> 0 then
							ls_errtext = "Problem in Generating Auto Triggered SMS.~r~nReasons are:- " + this.it_transobject.sqlerrtext
							SQL rollback USING this.it_transobject;
							messagebox("Auto Triggered SMS", ls_errtext)
						else
							SQL commit USING this.it_transobject;
						end if
					end if
				else
					SQL rollback USING sqlca;
					setpointer(arrow!)
					messagebox("Saving Problem", "Changes Not Saved in database for Master Cashier Window transactions.", stopsign!, ok!, 1)
				end if
			else
				SQL rollback USING sqlca;
				setpointer(arrow!)
				messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs", exclamation!, ok!, 1)
			end if
		end if
	end if
	if isnull(ll_primarycode_old) then
		this.id_detail.setitem(ll_row, "code", ll_null)
	end if
	setpointer(arrow!)

// w_patient_form1.ue_detail() returns 0 [event]
	call super::ue_detail
	this.id_detail.object.active.protect = 0
	this.im_menu.m_file.m_print.enabled = true
	if this.id_detail.object.code[this.id_detail.rowcount()] > 0 then
		this.ids_cashwin.retrieve(this.id_detail.object.code[1], this.is_doctype)
		this.id_image.retrieve(this.id_detail.object.code[this.id_detail.rowcount()])
		wf_populate_image()
		return
	end if
	wf_assign_master_cash_win_object()

// w_patient_form1.ue_newform() returns 0 [event]
	string ls_custcode
	long ll_custcode
	call super::ue_newform
	this.id_detail.object.regno.protect = 0
	this.id_detail.object.active.protect = 1
	this.id_detail.object.regno.edit.required = "no"
	if this.id_detail.rowcount() > 0 then
		ls_custcode = f_stringpreferences("defaultcustomerinpatientreg")
		if ls_custcode = "-1" then
			ll_custcode = 22
		else
			ll_custcode = long(ls_custcode)
		end if
		this.id_detail.object.custcode[1] = ll_custcode
	end if
	this.im_menu.m_file.m_print.enabled = true
	wf_assign_master_cash_win_object()
	this.id_image.reset()

// w_patient_form1.ue_postopen() returns 0 [event]
	integer li_xpos
	integer li_ypos
	integer li_xendpos
	integer li_counter
	integer li_taborder
	integer li_visiblecolumns
	integer li_zerotaborder
	long ll_counter
	long li_retcode
	boolean lb_active
	boolean lb_restricted
	boolean lb_customicode
	boolean lb_zerotabordercol
	boolean lb_wardcode_enabled
	string ls_setting
	datawindowchild ldc_itemcategory
	datastore lds_itemsetting
	call super::ue_postopen
	lds_itemsetting = create datastore
	wf_assign_master_cash_win_object()
	this.il_groupcode = f_getgroupcode(gl_usercode)
	lds_itemsetting.dataobject = "d_interfacesettingcols"
	lds_itemsetting.settransobject(this.it_transobject)
	lds_itemsetting.retrieve(14, 3, 1)
	li_visiblecolumns = lds_itemsetting.rowcount()
	for li_counter = 1 to li_counter
		this.colname[li_counter, 1] = lds_itemsetting.getitemstring(li_counter, "colname") + "_t"
		this.colname[li_counter, 2] = lds_itemsetting.getitemstring(li_counter, "colname")
		this.colwidth[li_counter, 1] = integer(this.id_detail.describe(this.colname[li_counter, 1] + ".Width"))
		this.colwidth[li_counter, 2] = integer(this.id_detail.describe(this.colname[li_counter, 2] + ".Width"))
	next
	li_taborder = 100
	li_counter = 1
	li_ypos = 100
	li_xendpos = 2650
	do while li_counter <= li_visiblecolumns and li_ypos <= 200000
		if this.colname[li_counter, 2] = "date" or this.colname[li_counter, 2] = "usercode" or this.colname[li_counter, 2] = "inactivedate" or this.colname[li_counter, 2] = "inactivedby" or this.colname[li_counter, 2] = "code" or this.colname[li_counter, 2] = "active" or this.colname[li_counter, 2] = "originaldate" or this.colname[li_counter, 2] = "createdby" then
			lb_zerotabordercol = true
		else
			lb_zerotabordercol = false
		end if
		if lower(this.colname[li_counter, 2]) = "wardcode" then
			lb_wardcode_enabled = true
		end if
		li_xpos = 32
		this.id_detail.modify(this.colname[li_counter, 1] + ".X=" + string(li_xpos))
		this.id_detail.modify(this.colname[li_counter, 1] + ".Y=" + string(li_ypos))
		this.id_detail.modify(this.colname[li_counter, 1] + ".Visible=1")
		li_xpos = 750
		this.id_detail.modify(this.colname[li_counter, 2] + ".X=" + string(li_xpos))
		this.id_detail.modify(this.colname[li_counter, 2] + ".Y=" + string(li_ypos))
		this.id_detail.modify(this.colname[li_counter, 2] + ".Visible=1")
		if lb_zerotabordercol then
			this.id_detail.modify(this.colname[li_counter, 2] + ".protect=1")
		elseif lower(this.colname[li_counter, 2]) = "fname" then
			this.id_detail.settaborder(this.colname[li_counter, 2] + "_t", li_taborder)
			li_taborder = li_taborder + 1
			this.id_detail.settaborder(this.colname[li_counter, 2], li_taborder)
		else
			this.id_detail.settaborder(this.colname[li_counter, 2], li_taborder)
		end if
		li_taborder = li_taborder + 1
		li_ypos = li_ypos + integer(this.id_detail.describe(this.colname[li_counter, 2] + ".Height")) + 25
		li_counter = li_counter + 1
	loop
	if lb_wardcode_enabled then
		this.id_detail.object.wardcode.dddw.required = "yes"
	else
		this.id_detail.object.wardcode.dddw.required = "no"
	end if
	ls_setting = this.id_detail.describe("mobileno1.visible")
	if ls_setting = "1" and f_stringpreferences("MobileNo1CompulsionInPatientReg") = "Y" then
		this.id_detail.object.mobileno1.edit.required = "yes"
	end if
	this.title = f_stringpreferences("patientcaptioninsale") + " Registration"

// w_patient_form1.ue_print() returns 0 [event]
	long ll_code
	long ll_row
	long li_printretcode
	string ls_printsize
	boolean lb_listtab
	s_datastore lstr
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_code) or ll_code <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_code = this.id_detail.getitemnumber(1, "code")
		if ll_code = 0 or isnull(ll_code) then
			ll_code = this.il_codevalue
		end if
	end if
	wf_setprintout()
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(ll_code)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.id_print.rowcount() > 0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		li_printretcode = this.id_print.print()
		if li_printretcode < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print,~r~nNo rows are retrieved", information!)

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_null
	long ll_totdays
	long ll_years
	long ll_months
	long ll_days
	datetime ldt_date_null
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ldt_date_null)
	setnull(li_null)
	choose case dwo.name
	case "gender"
		if upper(data) = "M" then
			this.object.fname_t.protect = "1"
			this.object.fname_t[row] = "F"
		else
			this.object.fname_t.protect = "0"
			this.object.fname_t[row] = "F"
		end if
	case "active"
		if upper(data) = "Y" then
			this.object.inactivedate[row] = ldt_date_null
			this.object.inactivedby[row] = li_null
		end if
	case "regno"
		if parent.parent.parent.wf_duplicateregno(data) then
			return 1
		end if
	case "dob"
		if isdate(string(date(left(data, 10)))) then
			ll_totdays = daysafter(date(string(date(left(data, 10)))), today())
			ll_years = ll_totdays / 365.0
			ll_months = ll_totdays mod 365 / 30.0
			ll_days = ll_totdays mod 365 mod 30
			setitem(row, "ageyears", ll_years)
			setitem(row, "agemonths", ll_months)
			setitem(row, "agedays", ll_days)
		else
			return 1
		end if
	case "ageyears"
		ll_years = long(data)
		if isnull(ll_years) then
			ll_years = 0
		end if
		ll_months = this.object.agemonths[row]
		if isnull(ll_months) then
			ll_months = 0
		end if
		ll_days = this.object.agedays[row]
		if isnull(ll_days) then
			ll_days = 0
		end if
		ll_totdays = ll_years * 365 + ll_months * 30 + ll_days
		if ll_totdays >= 0 then
			setitem(row, "dob", relativedate(today(), -ll_totdays))
		else
			return 1
		end if
	case "agemonths"
		ll_years = this.object.ageyears[row]
		if isnull(ll_years) then
			ll_years = 0
		end if
		ll_months = long(data)
		if isnull(ll_months) then
			ll_months = 0
		end if
		ll_days = this.object.agedays[row]
		if isnull(ll_days) then
			ll_days = 0
		end if
		ll_totdays = ll_years * 365 + ll_months * 30 + ll_days
		if ll_totdays >= 0 then
			setitem(row, "dob", relativedate(today(), -ll_totdays))
		else
			return 1
		end if
	case "agedays"
		ll_years = this.object.ageyears[row]
		if isnull(ll_years) then
			ll_years = 0
		end if
		ll_months = this.object.agemonths[row]
		if isnull(ll_months) then
			ll_months = 0
		end if
		ll_days = long(data)
		if isnull(ll_days) then
			ll_days = 0
		end if
		ll_totdays = ll_years * 365 + ll_months * 30 + ll_days
		if ll_totdays >= 0 then
			setitem(row, "dob", relativedate(today(), -ll_totdays))
		else
			return 1
		end if
	case "recurringperiod"
		if long(data) < 0 then
			return 1
		end if
	case "admit"
		if long(data) = 1 then
			this.object.admissioncode_t.visible = true
			this.object.admissioncode.visible = true
			this.object.locationcode_t.visible = true
			this.object.locationcode.visible = true
			this.object.doctorcode_t.visible = true
			this.object.doctorcode.visible = true
			this.object.diseasecode_t.visible = true
			this.object.diseasecode.visible = true
			this.object.diagnosis_t.visible = true
			this.object.diagnosis.visible = true
		else
			this.object.admissioncode_t.visible = false
			this.object.admissioncode.visible = false
			this.object.locationcode_t.visible = false
			this.object.locationcode.visible = false
			this.object.doctorcode_t.visible = false
			this.object.doctorcode.visible = false
			this.object.diseasecode_t.visible = false
			this.object.diseasecode.visible = false
			this.object.diagnosis_t.visible = false
			this.object.diagnosis.visible = false
		end if
	end choose
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "regno"
		messagebox("ItemNo Validation", "Item Duplication Error~r~nPlease enter some other Reg No")
	case "dob"
		messagebox("Birth Date Validation", "Please enter some valid date")
	case "age"
		messagebox("Age Validation", "Please enter some valid age in years")
	end choose
	return 1

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf7! then
		parent.parent.parent.wf_printmedicalrecord()
	end if
	if key = keyf9! then
		parent.parent.parent.wf_setimage()
	end if
	return ::message.returnvalue

// dw_find.keypressed(keycode key, unsignedlong keyflags) returns long [event]
	integer li_movement
	long ll_row
	long ll_temp
	long ll_code
	string sl_columnname
	string ls_filterexp
	s_popup_selection lstr_selection
	if key = keyf8! then
		openwithparm(w_popup_partialsearch_selection, "d_patient_list")
		lstr_selection = message.powerobjectparm
		if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
			ll_temp = parent.parent.parent.id_list.find("code = " + string(lstr_selection.l_code2), 1, parent.parent.parent.id_list.rowcount())
			if ll_temp > 0 then
				ll_row = ll_temp
				parent.parent.parent.id_list.scrolltorow(ll_row)
			end if
		end if
	elseif key = keyf6! then
		openwithparm(w_popup_comprehensicesearch_selection, "d_patient_comprehensive_list")
		lstr_selection = message.powerobjectparm
		if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
			ll_temp = parent.parent.parent.id_list.find("code = " + string(lstr_selection.l_code2), 1, parent.parent.parent.id_list.rowcount())
			if ll_temp > 0 then
				ll_row = ll_temp
				parent.parent.parent.id_list.scrolltorow(ll_row)
			end if
		end if
	elseif key = keyf9! then
		if parent.parent.parent.id_list.rowcount() > 0 and parent.parent.parent.id_list.getrow() > 0 then
			parent.parent.parent.wf_show_vaccineschedule(parent.parent.parent.id_list.object.code[parent.parent.parent.id_list.getrow()])
		end if
	elseif key = keyuparrow! then
		ll_row = parent.parent.parent.id_list.getrow() - 1
		parent.parent.parent.id_list.scrollpriorrow()
	elseif key = keydownarrow! then
		ll_row = parent.parent.parent.id_list.getrow() + 1
		parent.parent.parent.id_list.scrollnextrow()
	elseif key = keypagedown! then
		parent.parent.parent.id_list.scrollnextpage()
		ll_row = parent.parent.parent.id_dwcontrol.getrow()
	elseif key = keypageup! then
		parent.parent.parent.id_list.scrollpriorpage()
		ll_row = parent.parent.parent.id_dwcontrol.getrow()
	elseif key = keyhome! then
		scrolltorow(1)
		ll_row = 1
	elseif key = keyend! then
		ll_row = parent.parent.parent.id_list.rowcount()
		scrolltorow(ll_row)
	elseif key = keyenter! and parent.parent.parent.id_dwcontrol.getselectedrow(0) > 0 then
		parent.parent.parent.i_editmode = 2
		parent.parent.parent.tab_retrieve.selectedtab = 1
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	if ll_row > 0 and ll_row <= parent.parent.parent.id_dwcontrol.rowcount() then
		parent.parent.parent.id_list.setredraw(false)
		parent.parent.parent.tab_retrieve.tabpage_detail.enabled = true
		parent.parent.parent.im_menu.m_file.m_retrieve.enabled = true
		parent.parent.parent.id_list.selectrow(0, false)
		parent.parent.parent.id_list.selectrow(ll_row, true)
		if parent.parent.parent.ii_type = 1 then
			setitem(1, "find", parent.parent.parent.id_list.getitemstring(ll_row, parent.parent.parent.ii_colindex))
		elseif parent.parent.parent.ii_type = 3 then
			setitem(1, "find", trim(string(parent.parent.parent.id_list.getitemdatetime(ll_row, parent.parent.parent.ii_colindex))))
		else
			setitem(1, "find", trim(string(parent.parent.parent.id_list.getitemnumber(ll_row, parent.parent.parent.ii_colindex))))
		end if
		parent.parent.parent.il_selectedrow = ll_row
		selecttext(1, len(gettext()))
		parent.parent.parent.id_list.setredraw(true)
	end if
	if key = keyf7! then
		parent.parent.parent.wf_printmedicalrecord()
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue
