// function f_set_patientprintout (patientcomponents)  ancestor: function_object

// f_set_patientprintout.f_set_patientprintout() returns string
	string ls_printout
	if gs_company = "ISBINTHSP" then
		ls_printout = "d_isbinthsp_patientregisteration_print"
	elseif gs_company = "IHSCHILDRENHSP" then
		ls_printout = "d_ihs_patientregisteration_print"
	elseif gs_company = "BEGUMJANHSP" then
		ls_printout = "d_begumjanhsp_patientregisteration_print"
	elseif gs_company = "SURGICALCENTRE" then
		ls_printout = "d_surgicalcentre_patientregisteration"
	elseif gs_company = "PHARMACONS" then
		ls_printout = "d_pharmacons_patientregisteration_print"
	elseif gs_company = "PIC2014" then
		ls_printout = "d_pic2014_patientregisteration_print"
	elseif gs_company = "AMANCHILDCARE" then
		ls_printout = "d_amanchildcare_patientregisteration_p"
	end if
	if ls_printout = "" then
		ls_printout = "d_patientregisteration_print"
	end if
	return ls_printout
