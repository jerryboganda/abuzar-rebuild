// dw_pod.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidatedpod = false and parent.parent.parent.wf_validateitem_pod(row) = -1 then
		parent.parent.parent.ib_itemvalidatedpod = false
		parent.parent.parent.ib_rowvalidatedpod = false
		return ::message.returnvalue
	end if
	choose case dwo.name
	case "itemname"
		if isnull(getitemnumber(row, "icode")) then
			parent.parent.parent.id_selectionlistpod.show()
		else
			parent.parent.parent.wf_inititeminfo(getitemnumber(row, "icode"), row)
		end if
	case "qty"
		parent.parent.parent.id_selectionlistpod.hide()
		parent.parent.parent.wf_inititeminfo(getitemnumber(row, "icode"), row)
	case "remarks"
		parent.parent.parent.wf_inititeminfo(getitemnumber(row, "icode"), row)
	case else
		parent.parent.parent.id_selectionlistpod.hide()
	end choose
	if len(gettext()) > 0 then
		selecttext(1, len(gettext()))
	end if
	return ::message.returnvalue

// dw_pod.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.id_selectionlistpod.hide()
	return ::message.returnvalue

// dw_pod.rowfocuschanging(long currentrow, long newrow) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::rowfocuschanging(currentrow, newrow)
	if parent.parent.parent.ib_itemvalidatedpod = false and parent.parent.parent.wf_validateitem_pod(getrow()) = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_pod.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_rowm
	long ll_rowcount
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if parent.parent.parent.il_protect = 0 then
		if key = keyinsert! then
			if parent.parent.parent.ib_rowvalidatedpod = false and parent.parent.parent.wf_validateitem_pod(getrow()) = -1 then
				return ::message.returnvalue
			end if
			if rowcount() > 0 and f_validatedw(parent.parent.parent.id_pod) < 0 then
				return ::message.returnvalue
			end if
			ll_rowcount = insertrow(0)
			parent.parent.parent.il_currrowpod = ll_rowcount
			if ll_rowcount > 0 then
				this.object.usercode[ll_rowcount] = gl_usercode
				this.object.attendingdoctcode[ll_rowcount] = parent.parent.parent.il_attendingdoctcode
				scrolltorow(ll_rowcount)
				setcolumn("itemname")
				setfocus()
				parent.parent.parent.il_currrowpod = ll_rowcount
			end if
		end if
		if keyflags = 2 and key = keyd! then
			parent.parent.parent.ib_rowvalidatedpod = true
			if rowcount() > 0 then
				deleterow(0)
			end if
			ll_rowcount = rowcount()
			parent.parent.parent.il_currrowpod = ll_rowcount
			if ll_rowcount > 1 then
				scrolltorow(ll_rowcount)
				setcolumn("itemname")
				setfocus()
				parent.parent.parent.id_selectionlistpod.hide()
			end if
			parent.parent.parent.ib_rowvalidatedpod = true
		end if
	end if
	if getcolumnname() = "itemname" then
		ll_rowm = getrow()
		setredraw(false)
		if key = keydownarrow! then
			parent.parent.parent.id_selectionlistpod.selectrow(0, false)
			parent.parent.parent.id_selectionlistpod.scrollnextrow()
			ll_listcurrrow = parent.parent.parent.id_selectionlistpod.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.parent.parent.id_selectionlistpod.selectrow(0, false)
			parent.parent.parent.id_selectionlistpod.scrollpriorrow()
			ll_listcurrrow = parent.parent.parent.id_selectionlistpod.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.parent.parent.id_selectionlistpod.selectrow(0, false)
			parent.parent.parent.id_selectionlistpod.scrollnextpage()
			ll_listcurrrow = parent.parent.parent.id_selectionlistpod.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.parent.parent.id_selectionlistpod.selectrow(0, false)
			parent.parent.parent.id_selectionlistpod.scrollpriorpage()
			ll_listcurrrow = parent.parent.parent.id_selectionlistpod.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.parent.parent.id_selectionlistpod.selectrow(0, false)
			parent.parent.parent.id_selectionlistpod.scrolltorow(99999)
			ll_listcurrrow = parent.parent.parent.id_selectionlistpod.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.parent.parent.id_selectionlistpod.selectrow(0, false)
			parent.parent.parent.id_selectionlistpod.scrolltorow(1)
			ll_listcurrrow = parent.parent.parent.id_selectionlistpod.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.parent.parent.ib_bkspacepod = true
			setredraw(true)
		elseif key = keyescape! then
			if parent.parent.parent.id_selectionlistpod.visible = false then
				return ::message.returnvalue
			end if
			parent.parent.parent.id_selectionlistpod.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf4! then
			parent.parent.parent.id_selectionlistpod.show()
			parent.parent.parent.id_selectionlistpod.selectrow(0, false)
			parent.parent.parent.id_selectionlistpod.scrolltorow(parent.parent.parent.id_selectionlistpod.getrow())
			parent.parent.parent.id_selectionlistpod.selectrow(parent.parent.parent.id_selectionlistpod.getrow(), true)
			setredraw(true)
		elseif isnull(getitemnumber(parent.parent.parent.id_pod.getrow(), "icode")) and key = keyenter! then
			parent.parent.parent.id_selectionlistpod.hide()
			parent.parent.parent.id_selectionlistpod.selectrow(0, false)
			parent.parent.parent.id_selectionlistpod.scrolltorow(parent.parent.parent.id_selectionlistpod.getrow())
			parent.parent.parent.id_selectionlistpod.selectrow(parent.parent.parent.id_selectionlistpod.getrow(), true)
			ll_listcurrrow = parent.parent.parent.id_selectionlistpod.getrow()
			setitem(ll_rowm, "icode", parent.parent.parent.id_selectionlistpod.getitemnumber(ll_listcurrrow, "code"))
			setitem(ll_rowm, "itemname", parent.parent.parent.id_selectionlistpod.getitemstring(ll_listcurrrow, "name"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidatedpod = false
			parent.parent.parent.ib_rowvalidatedpod = false
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_selectionlistpod.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, "icode", parent.parent.parent.id_selectionlistpod.getitemnumber(ll_listcurrrow, "code"))
			setitem(ll_rowm, "itemname", parent.parent.parent.id_selectionlistpod.getitemstring(ll_listcurrrow, "name"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidatedpod = false
			parent.parent.parent.ib_rowvalidatedpod = false
			setredraw(true)
		end if
	end if
	if key = keyf8! and parent.parent.parent.ib_viewimage then
		parent.parent.parent.wf_show_patient_gallery()
	end if
	if key = keyf9! and parent.parent.parent.ib_uploadimage then
		parent.parent.parent.wf_setimage("ECG")
	end if
	return rt_code

// dw_pod.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	long ll_rowcount
	ancestorreturnvalue = super::ue_enterkey()
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		if parent.parent.parent.id_pod.rowcount() > 0 and f_validatedw(parent.parent.parent.id_pod) < 0 then
			return ::message.returnvalue
		end if
		if parent.parent.parent.ib_rowvalidatedpod = false and parent.parent.parent.wf_validateitem_pod(getrow()) = -1 then
			return 1
		end if
		ll_rowcount = parent.parent.parent.id_pod.insertrow(0)
		parent.parent.parent.il_currrowpod = ll_rowcount
		if ll_rowcount > 1 then
			parent.parent.parent.id_pod.object.usercode[ll_rowcount] = gl_usercode
			parent.parent.parent.id_pod.object.attendingdoctcode[ll_rowcount] = parent.parent.parent.il_attendingdoctcode
			parent.parent.parent.id_pod.setrow(ll_rowcount)
			parent.parent.parent.id_pod.scrolltorow(ll_rowcount)
			parent.parent.parent.id_pod.setcolumn("itemname")
			parent.parent.parent.id_pod.setfocus()
		end if
		return 1
	end if
	if getcolumnname() = "itemname" then
		parent.parent.parent.id_selectionlistpod.show()
		if parent.parent.parent.ib_itemvalidatedpod = false and parent.parent.parent.wf_validateitem_pod(getrow()) = -1 then
			return 1
		end if
		return
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// tabpage_patientdischarge.create() returns 0 [event]
	this.dw_patientdischarge = create dw_patientdischarge
	this.control = {this.dw_patientdischarge}

// tabpage_patientdischarge.destroy() returns 0 [event]
	destroy this.dw_patientdischarge

// dw_patientdischarge.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	setfocus()
	selecttext(1, len(gettext()))
	parent.parent.parent.cb_discharge.visible = true
	return ::message.returnvalue

// dw_patientdischarge.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if len(gettext()) > 0 then
		selecttext(1, len(gettext()))
	end if
	return ::message.returnvalue

// dw_patientdischarge.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf8! and parent.parent.parent.ib_viewimage then
		parent.parent.parent.wf_show_patient_gallery()
	end if
	if key = keyf9! and parent.parent.parent.ib_uploadimage then
		parent.parent.parent.wf_setimage("ECG")
	end if
	return ::message.returnvalue

// dw_patientdischarge.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	if getcolumnname() <> "dischargenotes" then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue
