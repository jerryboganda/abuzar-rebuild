// w_mr_form.wf_validateitem(long al_row) returns integer
	long ll_icode
	long ll_null
	integer li_errcode
	setnull(ll_null)
	ll_icode = this.id_tg.getitemnumber(al_row, "icode")
	if isnull(ll_icode) then
		this.ib_rowvalidated = false
		this.ib_itemvalidated = false
		messagebox("Validation Error!", "Please Enter Valid Item")
		li_errcode = -1
	else
		li_errcode = 0
		this.ib_rowvalidated = true
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		this.id_tg.setcolumn("icode")
		this.id_tg.scrolltorow(al_row)
		this.id_tg.object.icode[al_row] = ll_null
	end if
	return li_errcode

// w_mr_form.wf_inititeminfo(long al_icode, long al_row) returns long
	long ll_retcode
	double ld_saleprice
	SQL SELECT saleprice =Round ( saleprice / CASE PackUnits WHEN 0 THEN 1 ELSE PackUnits END , 2 ) INTO :ld_saleprice FROM item WHERE ICode =:al_icode USING this.it_transobject;
	if sqlca.sqlcode = 0 then
		ll_retcode = 0
	else
		ll_retcode = -1
	end if
	return ll_retcode

// w_mr_form.wf_get_dosefactor(long al_dosagecode) returns long
	long ll_dosefactor
	SQL Select dosefactor INTO :ll_dosefactor From Dosage Where dosagecode =:al_dosagecode USING this.it_transobject;
	if sqlca.sqlcode = 0 then
		return ll_dosefactor
	end if
	return -1

// w_mr_form.wf_validate_treatment_given() returns long
	long ll_currrow
	long ll_counter
	long ll_null
	ll_currrow = this.id_tg.getrow()
	setnull(ll_null)
	if this.id_tg.rowcount() > 0 then
		if isnull(this.id_tg.getitemnumber(ll_currrow, "icode")) then
			if isnull(this.id_tg.getitemstring(ll_currrow, "itemname")) then
				this.id_tg.deleterow(ll_currrow)
			elseif this.ib_itemvalidated = false then
				messagebox("Item Validation", "Please Select Some Valid Item")
				this.id_tg.setcolumn("itemname")
				this.id_tg.scrolltorow(ll_currrow)
				this.id_tg.setfocus()
				return 1
			end if
		elseif this.ib_itemvalidated = false then
			messagebox("Item Validation", "Please Select Some Valid Item")
			this.id_tg.setcolumn("itemname")
			this.id_tg.scrolltorow(ll_currrow)
			this.id_tg.setfocus()
			return 1
		end if
		if f_validatedw(this.id_tg) < 0 then
			return 1
		end if
		this.il_currrow = this.id_tg.rowcount()
		if this.ib_itemvalidated = false and wf_validateitem(ll_currrow) = -1 then
			return 1
		end if
		return
	end if
	for ll_counter = 1 to this.id_tg.rowcount()
		this.id_tg.object.patientcode[ll_counter] = this.il_code
		this.id_tg.object.admissioncode[ll_counter] = this.il_admission
	next
	return 0

