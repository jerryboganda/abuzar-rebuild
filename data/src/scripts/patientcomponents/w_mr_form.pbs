// tab_main.selectionchanged(integer oldindex, integer newindex) returns long [event]
	if parent.il_protect = 0 then
		parent.cb_discharge.visible = false
		parent.cb_printlab.visible = false
		if newindex = 1 then
			parent.id_pc.setfocus()
			if parent.id_pc.rowcount() = 0 then
				parent.wf_insert_row(parent.id_pc, 0)
			end if
		elseif newindex = 2 then
			parent.id_hpc.setfocus()
			if parent.id_hpc.rowcount() = 0 then
				parent.wf_insert_row(parent.id_hpc, 0)
			end if
		elseif newindex = 3 then
