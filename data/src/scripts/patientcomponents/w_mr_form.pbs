		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_cabg) < 0 then
		parent.tab_main.selecttab(15)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_provdiag) < 0 then
		parent.tab_main.selecttab(16)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_tg) < 0 then
		parent.tab_main.selecttab(17)
		return ::message.returnvalue
	end if
	if parent.wf_validate_treatment_given() = 1 then
		parent.tab_main.selecttab(17)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_pod) < 0 then
		parent.tab_main.selecttab(18)
		return ::message.returnvalue
	end if
	if parent.wf_validate_pod() = 1 then
		parent.tab_main.selecttab(18)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_patient_discharge) < 0 then
		parent.tab_main.selecttab(19)
		return ::message.returnvalue
	end if
	if parent.id_pc.update() = 1 then
		if parent.id_hpc.update() = 1 then
			if parent.id_gpe.update() = 1 then
				if parent.id_se.update() = 1 then
					if parent.id_pal.update() = 1 then
						if parent.id_lir.update() = 1 then
							if parent.id_elir.update() = 1 then
								if parent.id_ecg.update() = 1 then
									if parent.id_xray.update() = 1 then
										if parent.id_echo.update() = 1 then
											if parent.id_tscan.update() = 1 then
												if parent.id_cang.update() = 1 then
													if parent.id_ctang.update() = 1 then
														if parent.id_pci.update() = 1 then
															if parent.id_cabg.update() = 1 then
																if parent.id_provdiag.update() = 1 then
																	if parent.id_tg.update() = 1 then
																		if parent.id_pod.update() = 1 then
																			if parent.id_patient_discharge.update() = 1 then
																				SQL commit USING parent.it_transobject;
																				if parent.wf_update_image() = 0 then
																					parent.id_image.reset()
																					parent.istr_image = parent.istr_blank_image
																				end if
																				lb_commitok = true
																				if parent.ib_printlab then
																					parent.wf_printlab()
																				end if
																				if parent.ib_dischargenow then
																					parent.wf_print_dischargeslip()
																				end if
																				parent.event ue_close()
																				return ::message.returnvalue
																			else
																				messagebox("Saving Discharge Record Problem", "Unable to update Discharge Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
																				SQL rollback USING parent.it_transobject;
																			end if
																		else
																			messagebox("Saving Prescription on Discharge Record Problem", "Unable to update Prescription on Discharge Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
																			SQL rollback USING parent.it_transobject;
																		end if
																	else
																		messagebox("Treatment Given Record Problem", "Unable to update Treatment Given Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
																		SQL rollback USING parent.it_transobject;
																	end if
																else
																	messagebox("Provisional Diagnosis Record Problem", "Unable to update Provisional Diagnosis Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
																	SQL rollback USING parent.it_transobject;
																end if
															else
																messagebox("CABG Record Problem", "Unable to update CABG Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
																SQL rollback USING parent.it_transobject;
															end if
														else
															messagebox("Coronory Angioplasty Record Problem", "Unable to update Coronory Angioplasty Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
															SQL rollback USING parent.it_transobject;
														end if
													else
														messagebox("CT Angiogram Record Problem", "Unable to update CT Angiogram Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
														SQL rollback USING parent.it_transobject;
													end if
												else
													messagebox("Coronory Angiogram Record Problem", "Unable to update Coronory Angiogram Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
													SQL rollback USING parent.it_transobject;
												end if
											else
												messagebox("Thalium Scan Record Problem", "Unable to update Thalium Scan Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
												SQL rollback USING parent.it_transobject;
											end if
										else
											messagebox("Echo Record Problem", "Unable to update Echo Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
											SQL rollback USING parent.it_transobject;
										end if
									else
										messagebox("X-Ray Problem", "Unable to update X-Ray Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
										SQL rollback USING parent.it_transobject;
									end if
								else
									messagebox("ECG Problem", "Unable to update ECG Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
									SQL rollback USING parent.it_transobject;
								end if
							else
								messagebox("Emergency Lab Investigations Recommended (ELIR) Problem", "Unable to update Emergency Lab Investigations Recommended (ELIR) Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
								SQL rollback USING parent.it_transobject;
							end if
						else
							messagebox("Lab Investigations Recommended (LIR) Problem", "Unable to update Lab Investigations Recommended (LIR) Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
							SQL rollback USING parent.it_transobject;
						end if
					else
						messagebox("Previous Abnormal Labs (PAL) Problem", "Unable to update Previous Abnormal Labs (PAL) Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
						SQL rollback USING parent.it_transobject;
					end if
				else
					messagebox("Systemic Examination (S/E) Problem", "Unable to update Systemic Examination (S/E) Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
					SQL rollback USING parent.it_transobject;
				end if
			else
				messagebox("General Physical Examination (GPE) Problem", "Unable to update General Physical Examination (GPE) Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
				SQL rollback USING parent.it_transobject;
			end if
		else
			messagebox("History of Presenting Complaints (HPC) Problem", "Unable to update History of Presenting Complaints (HPC) Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
			SQL rollback USING parent.it_transobject;
		end if
	else
		messagebox("Presenting Complaints (PC) Problem", "Unable to update Presenting Complaints (PC) Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
		SQL rollback USING parent.it_transobject;
	end if
	return ::message.returnvalue

