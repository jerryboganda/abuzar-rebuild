// w_mr_form.wf_connect() returns long
	SQL start USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_mr_form.wf_tabnewid(string as_tablename, long al_newid) returns long
	long ll_rtcode
	SQL SELECT TABMAXKEY INTO :al_newid FROM _TABMAXKEY WITH ( UPDLOCK HOLDLOCK ) WHERE _TABMAXKEY.TABName =:as_tablename USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_newid = al_newid + 1
		SQL update dbo._tabmaxkey SET TABMAXKEY =:al_newid WHERE _TABMAXKEY.TABName =:as_tablename USING this.it_transobject;
		if this.it_transobject.sqlcode < 0 then
			ll_rtcode = this.it_transobject.sqlcode
			al_newid = 0
		end if
	else
		ll_rtcode = this.it_transobject.sqlcode
		al_newid = 0
	end if
	return ll_rtcode

// w_mr_form.wf_get_patient_info(long al_code) returns long
	long ll_patientcode
	long ll_admissioncode
	string ls_regno
	string ls_patientname
	string ls_fname
	string ls_age
	string ls_gender
	SQL SELECT PatientCode , RegNo , Name , FName , Age =LTRIM ( RTRIM ( STR ( AgeYears ) ) ) + ' yrs ' + LTRIM ( RTRIM ( STR ( AgeMonths ) ) ) + ' month ' + LTRIM ( RTRIM ( STR ( AgeDays ) ) ) + ' days' , Gender , AdmissionCode =ISNULL ( ( SELECT MAX ( PA.AdmissionCode ) FROM PatientAdmission PA WHERE PA.PatientCode =:al_code AND Discharged ='N' ) , ( SELECT MAX ( PA.AdmissionCode ) FROM PatientAdmission PA WHERE PA.PatientCode =:al_code ) ) INTO :ll_patientcode, :ls_regno, :ls_patientname, :ls_fname, :ls_age, :ls_gender, :ll_admissioncode FROM Patient WHERE PatientCode =:al_code USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.il_code = ll_patientcode
		this.is_regno = ls_regno
		this.il_admission = ll_admissioncode
		this.is_patientname = ls_patientname
		this.is_fhname = ls_fname
		this.is_age = ls_age
		this.is_gender = ls_gender
		return 0
	end if
	return -1

