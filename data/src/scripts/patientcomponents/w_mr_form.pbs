	this.cb_printlab = create cb_printlab
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.tab_main = create tab_main
	this.dw_image = create dw_image
	this.dw_labprint = create dw_labprint
	this.dw_dischargeslip = create dw_dischargeslip
	this.control = {this.cb_discharge, this.cb_printlab, this.cb_cancel, this.cb_ok, this.tab_main, this.dw_image, this.dw_labprint, this.dw_dischargeslip}

