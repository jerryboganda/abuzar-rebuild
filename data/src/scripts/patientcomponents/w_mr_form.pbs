// dw_elir.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	setfocus()
	selecttext(1, len(gettext()))
	parent.parent.parent.cb_printlab.visible = true
	return ::message.returnvalue

// dw_elir.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	if getcolumnname() <> "other" then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// dw_elir.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "seta"
		if data = "Y" then
			this.object.seta_cbc[row] = "Y"
			this.object.seta_ureacreatinine[row] = "Y"
			this.object.seta_serumna[row] = "Y"
			this.object.seta_k[row] = "Y"
			this.object.seta_randombloodsugar[row] = "Y"
			this.object.seta_cpk[row] = "Y"
			this.object.seta_ckmb[row] = "Y"
		else
			this.object.seta_cbc[row] = "N"
			this.object.seta_ureacreatinine[row] = "N"
			this.object.seta_serumna[row] = "N"
			this.object.seta_k[row] = "N"
			this.object.seta_randombloodsugar[row] = "N"
			this.object.seta_cpk[row] = "N"
			this.object.seta_ckmb[row] = "N"
		end if
	case "setb"
		if data <> "Y" then
			this.object.setb_tropti[row] = "N"
			this.object.setb_ce[row] = "N"
			this.object.setb_ptinr[row] = "N"
			this.object.setb_aptt[row] = "N"
		end if
	case "setc"
		if data <> "Y" then
			this.object.setc_serummagnesium[row] = "N"
			this.object.setc_serumcalcium[row] = "N"
			this.object.setc_bnp[row] = "N"
			this.object.setc_ddimmer[row] = "N"
			this.object.setc_asotitre[row] = "N"
			this.object.setc_crp[row] = "N"
			this.object.setc_crphighsensitive[row] = "N"
			this.object.setc_urinece[row] = "N"
		end if
	end choose
	return 0

