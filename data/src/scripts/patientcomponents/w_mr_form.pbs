// w_mr_form.wf_get_image(long al_row) returns long
	blob lbl_image
	u_transaction lt_transobject
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server")
		destroy lt_transobject
		return -1
	end if
	SQL SelectBlob PatientImage INTO :lbl_image From PatientImage Where Patientcode =:this.il_code AND RowID =:al_row USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Patient Image/Picture ", "Unable to fetch patient Image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	this.istr_image.blob[al_row] = lbl_image
	return 0

// w_mr_form.wf_populate_image() returns long
	long ll_counter
	long ll_rowcount
	long ll_code
	ll_rowcount = this.id_image.rowcount()
	if ll_rowcount <= 0 then
		return 0
	end if
	ll_code = this.id_image.object.code[1]
	for ll_counter = 1 to ll_rowcount
		this.istr_image.ls_value[ll_counter, 1] = trim(string(this.id_image.object.rowid[ll_counter]))
		this.istr_image.ls_value[ll_counter, 2] = this.id_image.object.imagedescription[ll_counter]
		this.istr_image.ls_value[ll_counter, 3] = this.id_image.object.imagetype[ll_counter]
		wf_get_image(ll_counter)
	next
	return 0

// w_mr_form.wf_update_image() returns long
	long ll_counter
	long ll_code
	long ll_rowid
	string ls_desc
	string ls_imgtype
	u_transaction lt_transobject
	ll_code = this.il_code
	if ll_code > 0 and this.id_image.rowcount() = 0 then
		return 0
	end if
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server for updating/inserting in PatientImage Table")
		destroy lt_transobject
		return -1
	end if
	SQL DELETE PatientImage WHERE PatientCode =:this.il_code USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to Delete Previous Patient Image Record from database")
		destroy lt_transobject
		return -1
	end if
	for ll_counter = 1 to this.id_image.rowcount()
		ll_rowid = this.id_image.object.rowid[ll_counter]
		ls_desc = this.id_image.object.imagedescription[ll_counter]
		ls_imgtype = this.id_image.object.imagetype[ll_counter]
		SQL INSERT INTO PatientImage ( Patientcode , ImageDescription , RowID , ImageType , AdmissionCode ) VALUES ( :ll_code , :ls_desc , :ll_rowid , :ls_imgtype , :this.il_admission ) USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Insert Error", "Unable to Insert Patient Images Into Patient Image Table.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
			SQL stop USING lt_transobject;
			destroy lt_transobject
			return -1
		end if
		SQL UpdateBlob PatientImage Set PatientImage =:this.istr_image.blob[ll_counter] Where Patientcode =:ll_code and ROWID =:ll_rowid USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Patient Image ", "Unable to update Patient image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		end if
	next
	SQL stop USING lt_transobject;
	destroy lt_transobject
	return 0

// w_mr_form.wf_itemlist_initialization() returns 0
	long li_counter
	long ll_startrow
