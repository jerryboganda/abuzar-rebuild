// w_mr_form.open() returns long [event]
	integer li_xpos
	integer li_ypos
	integer li_xendpos
	integer li_counter
	integer li_taborder
	integer li_visiblecolumns
	integer li_zerotaborder
	long ll_counter
	long li_retcode
	long li_rtncode
	boolean lb_active
	boolean lb_restricted
	boolean lb_customicode
	boolean lb_zerotabordercol
	date ld_date
	long ll_retcode
	ld_date = today()
	this.istr_datatype = message.powerobjectparm
	this.il_protect = this.istr_datatype.ai_int
	this.il_code = this.istr_datatype.al_long
	this.it_transobject = create u_transaction
	if wf_connect() <> 0 then
		messagebox("Connection Failure", "Unable to connect to the database", stopsign!)
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	if f_rightexists(5122) then
		this.ib_uploadimage = true
	else
		this.ib_uploadimage = false
	end if
	if f_rightexists(5123) then
		this.ib_viewimage = true
	else
		this.ib_viewimage = false
	end if
	this.il_attendingdoctcode = f_get_user_doctor(gl_usercode)
	wf_get_patient_info(this.il_code)
	wf_retrieve_tabs()
	wf_apply_protect_setting()
	wf_set_interface_adjustments()
	wf_set_tab_visibility()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_mr_form.key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyf8! and this.ib_viewimage then
		wf_show_patient_gallery()
	end if
	if key = keyf9! and this.ib_uploadimage then
		wf_setimage("ECG")
	end if
	return ::message.returnvalue

// cb_discharge.clicked() returns long [event]
	datetime ldt_server_datetime
	string ls_date_errtext
	long ll_retcode
	long ll_null
	setnull(ll_null)
	if parent.id_patient_discharge.accepttext() = 1 then
		if not parent.wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			return ::message.returnvalue
		end if
		parent.id_patient_discharge.object.discharged1[1] = "Y"
		parent.id_patient_discharge.object.discharged1by[1] = gl_usercode
		parent.id_patient_discharge.object.discharged1on[1] = ldt_server_datetime
		parent.id_patient_discharge.object.discharged[1] = "Y"
		parent.id_patient_discharge.object.dischargedby[1] = gl_usercode
		parent.id_patient_discharge.object.dischargedon[1] = ldt_server_datetime
		parent.it_transobject.getpatientdischargeability(parent.il_admission, ll_retcode)
		if sqlca.sqlcode <> 0 then
			messagebox("Patient Discharge Problem!", "Some Database Problem Occured.~r~nTry Later.")
			return ::message.returnvalue
		elseif ll_retcode <> 0 then
			messagebox("Patient Discharge Problem!", "Some Invoice(s) are Unposted for this Patient.~r~nDischarge Process Abort.")
			return ::message.returnvalue
		else
			parent.ib_dischargenow = true
			parent.wf_save()
		end if
	end if
	return ::message.returnvalue

// cb_printlab.clicked() returns long [event]
	parent.ib_printlab = true
	parent.wf_save()
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.postevent("ue_close")
	return ::message.returnvalue

// cb_ok.ue_enterkry(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return 1

// cb_ok.clicked() returns long [event]
	string ls_aliasname
	long ll_newid
	long ll_row
	long ll_counter
	long ll_liccode
	long li_rc
	boolean lb_commitok
	if parent.il_protect = 1 then
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_pc) < 0 then
		parent.tab_main.selecttab(1)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_hpc) < 0 then
		parent.tab_main.selecttab(2)
		return ::message.returnvalue
