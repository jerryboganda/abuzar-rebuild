// dw_pc.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyf8! and parent.parent.parent.ib_viewimage then
		parent.parent.parent.wf_show_patient_gallery()
	end if
	if key = keyf9! and parent.parent.parent.ib_uploadimage then
		parent.parent.parent.wf_setimage("ECG")
	end if
	return ::message.returnvalue

// dw_pc.ue_enterkey() returns long [event]
	if not (getcolumnname() = "prescriptionadviced" or getcolumnname() = "treatmentgiven" or getcolumnname() = "labinvestigationsdone" or getcolumnname() = "othertests" or getcolumnname() = "vitalnotes" or getcolumnname() = "previousabnormallabs") then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// dw_pc.getfocus() returns long [event]
	setfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_pc.itemfocuschanged(long row, dwobject dwo) returns long [event]
	if len(gettext()) > 0 then
		selecttext(1, len(gettext()))
	end if
	return ::message.returnvalue

