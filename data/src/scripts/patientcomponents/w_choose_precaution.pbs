// window w_choose_precaution (patientcomponents)  ancestor: window

// w_choose_precaution.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// w_choose_precaution.create() returns 0 [event]
	this.cbx_selectall = create cbx_selectall
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.dw_selection = create dw_selection
	this.gb_1 = create gb_1
	this.control = {this.cbx_selectall, this.cb_cancel, this.cb_ok, this.dw_selection, this.gb_1}

// w_choose_precaution.destroy() returns 0 [event]
	destroy this.cbx_selectall
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.dw_selection
	destroy this.gb_1

// w_choose_precaution.open() returns long [event]
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_found
	long ll_limit
	long ll_counter
	environment env
	s_arguements lstr_arg
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	lstr_arg = message.powerobjectparm
	this.dw_selection.settransobject(sqlca)
	this.dw_selection.retrieve()
	if lstr_arg.i_status = 1 then
		ll_limit = upperbound(lstr_arg.ia_integerlist)
		if ll_limit > 0 then
			for ll_counter = 1 to ll_limit
				ll_found = this.dw_selection.find("code = " + string(lstr_arg.ia_integerlist[ll_counter]), 1, this.dw_selection.rowcount())
				if ll_found > 0 and ll_found <= this.dw_selection.rowcount() then
					this.dw_selection.object.selected[ll_found] = "Y"
				end if
			next
		end if
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cbx_selectall.clicked() returns long [event]
	long ll_counter
	boolean lb_checked
	lb_checked = this.checked
	for ll_counter = 1 to parent.dw_selection.rowcount()
		if lb_checked then
			parent.dw_selection.setitem(ll_counter, "status", "Y")
		else
			parent.dw_selection.setitem(ll_counter, "status", "N")
		end if
	next
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.istr_arg.i_status = -1
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ll_counter
	long ll_row = 1
	integer[] ia_list
	for ll_counter = 1 to parent.dw_selection.rowcount()
		if parent.dw_selection.getitemstring(ll_counter, "selected") = "Y" then
			ia_list[ll_row] = parent.dw_selection.getitemnumber(ll_counter, "code")
			ll_row = ll_row + 1
		end if
	next
	if upperbound(ia_list) <= 0 then
		messagebox("Selection Validation", "Kindly select some precaution from the list.")
		return ::message.returnvalue
	end if
	parent.istr_arg.i_status = 1
	parent.istr_arg.ia_integerlist = ia_list
	parent.post event ue_close()
	return ::message.returnvalue

// dw_selection.rowfocuschanged(long currentrow) returns long [event]
	selectrow(0, false)
	selectrow(currentrow, true)
	return ::message.returnvalue
