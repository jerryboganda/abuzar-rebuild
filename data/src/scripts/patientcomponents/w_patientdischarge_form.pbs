// window w_patientdischarge_form (patientcomponents)  ancestor: w_single_entry

// w_patientdischarge_form.wf_findregno(long al_patientcode) returns string
	string ls_regno
	SQL SELECT Patient.RegNo INTO :ls_regno FROM Patient WHERE Patient.PatientCode =:al_patientcode USING sqlca;
	return ls_regno

// w_patientdischarge_form.wf_getwardcode(long al_locationcode) returns long
	long ll_wardcode
	SQL SELECT patientlocation.wardcode INTO :ll_wardcode FROM patientlocation WHERE patientlocation.locationcode =:al_locationcode USING sqlca;
	return ll_wardcode

// w_patientdischarge_form.wf_locationoccupied(long al_locationcode) returns long
	long ll_retcode
	SQL SELECT COUNT ( *) INTO :ll_retcode FROM ( select distinct locationcode from patientadmission where discharged ='N' AND admissioncode not in ( select distinct admissioncode from patienttransfer where transfercode in ( select max ( transfercode ) from patienttransfer group by admissioncode ) ) union select distinct locationcode =targetlocation from patienttransfer where admissioncode in ( select admissioncode from patientadmission where discharged ='N' and admissioncode in ( select distinct admissioncode from patienttransfer where transfercode in ( select max ( transfercode ) from patienttransfer group by admissioncode ) ) ) ) L WHERE LocationCode =:al_locationcode USING sqlca;
	return ll_retcode

// w_patientdischarge_form.wf_admitted(long al_admissioncode) returns long
	long ll_count
	SQL SELECT Count ( *) INTO :ll_count FROM PatientAdmission WHERE PatientAdmission.AdmissionCode =:al_admissioncode AND PatientAdmission.Discharged ='N' USING sqlca;
	return ll_count

// w_patientdischarge_form.wf_transferhistory() returns 0
	long ll_admissioncode
	ll_admissioncode = this.id_detail.object.admissioncode[this.id_detail.rowcount()]
	openwithparm(w_patienttransferhistory, ll_admissioncode)

// w_patientdischarge_form.wf_findpatientcode(string as_regno) returns long
	long ll_patientcode
	SQL SELECT PatientCode INTO :ll_patientcode FROM Patient WHERE Patient.RegNo =:as_regno USING sqlca;
	return ll_patientcode

// w_patientdischarge_form.wf_set_patientactive(long al_patientcode) returns long
	SQL update Patient Set Active ='N' Where patientcode =:al_patientcode USING sqlca;
	return sqlca.sqlcode

// w_patientdischarge_form.wf_setprintout() returns long
	if gs_company = "PIC2014" then
		this.id_print.dataobject = "d_pic2014_dischargeslip"
	elseif gs_company = "REALDOCTORPVT" then
		this.id_print.dataobject = "d_realdoctorpvt_patientdischarge_prnt"
	elseif gs_company = "MEHARHSP" then
		this.id_print.dataobject = "d_meharhsp_patientdischarge_print"
	elseif gs_company = "NAZEERHSP" then
		this.id_print.dataobject = "d_nazeerhsp_patientdischarge_print"
	elseif gs_company = "AMANCHILDCARE" then
		this.id_print.dataobject = "d_amanchildcare_patientdischarge_p"
	end if
	return 0

// w_patientdischarge_form.wf_show_inpatientbill() returns long
	long ll_admissioncode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_detail.rowcount() > 0 and this.id_detail.getrow() > 0 then
			ll_admissioncode = this.id_detail.object.code[this.id_detail.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_admissioncode = this.id_list.object.code[this.id_list.getrow()]
	end if
	if not isnull(ll_admissioncode) and ll_admissioncode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_inpatient_bill, ll_admissioncode)
	end if
	return 0

// w_patientdischarge_form.create() returns 0
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_discchargepatient" then
		this.menuid = create m_discchargepatient
	end if

// w_patientdischarge_form.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_patientdischarge_form.activate() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_patientdischarge_form.open() returns long
	long ancestorreturnvalue
	long ll_found
	ancestorreturnvalue = super::open()
	this.is_tablename = "PatientTransfer"
	this.id_print.dataobject = "d_patientdischarge_print"
	this.id_print.settransobject(sqlca)
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5022", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_initialdischarge = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5023", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_finaldischarge = true
	end if
	if this.ib_initialdischarge = false and this.ib_finaldischarge = false then
		messagebox("Rights Limitations", "You do not have sufficient rights to make effective use of this module.~r~nYou should atleast have Initial or Final discharge right.~r~nPlease consult your administrator to do the needfull.", stopsign!)
		close(this)
		return ::message.returnvalue
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 1782", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_initialdischarge_modifydate = true
	end if
	return ::message.returnvalue

// w_patientdischarge_form.ue_save() returns 0
	long ll_primarykey
	long ll_row
	long ll_retcode
	long ll_totrows
	long ll_rowcounter
	long ll_option
	datetime ldt_server_datetime
	double ld_balance
	string ls_date_errtext
	string ls_enforcepatientbalanceclearance
	string ls_discharged1
	string ls_discharged
	string ls_invlist
	string ls_errtext
	dwitemstatus lds_rowstatus
	ls_enforcepatientbalanceclearance = upper(f_stringpreferences("enforcepatientbillclearanceondischarge"))
	setpointer(hourglass!)
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	ll_row = this.id_detail.getrow()
	ll_primarykey = this.id_detail.object.code[ll_row]
	if isnull(ll_primarykey) then
		messagebox("Problem Saving", "Not a Valid Patient To Discharge.~r~nDischarge Process Aborted.", stopsign!)
		this.id_detail.setfocus()
		this.id_detail.setcolumn("discharged1")
		return
	end if
	if this.id_detail.object.discharged1[ll_row] = "N" and this.id_detail.object.discharged[ll_row] = "Y" then
		messagebox("Patient Discharge Problem", "Initial Discharge Must be done before final discharge.~r~nDischarge Process Aborted.", stopsign!)
		this.id_detail.setfocus()
		this.id_detail.setcolumn("discharged1")
		return
	end if
	if wf_admitted(this.id_detail.object.code[ll_row]) <= 0 then
		messagebox("Patient Discharge Problem", "Patient No more Admitted.~r~nDischarge Process Aborted.", stopsign!)
		this.id_detail.setfocus()
		this.id_detail.setcolumn("discharged1")
		return
	end if
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	ls_discharged1 = this.id_detail.object.discharged1[ll_row]
	ls_discharged = this.id_detail.object.discharged[ll_row]
	if this.ib_discharged1 then
		if this.id_detail.object.discharged1[ll_row] = "Y" then
		end if
	elseif this.id_detail.object.discharged1[ll_row] = "Y" then
		this.id_detail.object.discharged1by[ll_row] = gl_usercode
		this.id_detail.object.discharged1on[ll_row] = ldt_server_datetime
	end if
	if this.id_detail.object.discharged1[ll_row] = "Y" then
		if this.id_detail.object.discharged[ll_row] = "Y" then
			this.id_detail.object.dischargedby[ll_row] = gl_usercode
			this.id_detail.object.dischargedon[ll_row] = ldt_server_datetime
		end if
	else
		setnull(ll_retcode)
		setnull(ldt_server_datetime)
		this.id_detail.object.discharged1by[ll_row] = ll_retcode
		this.id_detail.object.discharged1on[ll_row] = ldt_server_datetime
		this.id_detail.object.dischargedby[ll_row] = ll_retcode
		this.id_detail.object.dischargedon[ll_row] = ldt_server_datetime
	end if
	if this.id_detail.object.discharged1[ll_row] = "Y" and this.id_detail.object.discharged[ll_row] = "Y" then
		sqlca.getpatientdischargeability(ll_primarykey, ll_retcode)
		if sqlca.sqlcode <> 0 then
			messagebox("Patient Discharge Problem!", "Some Database Problem Occured.~r~nTry Later.")
			return
		elseif ll_retcode <> 0 then
			messagebox("Patient Discharge Problem!", "Some Invoice(s) are Unposted for this Patient.~r~nDischarge Process Abort.")
			return
		else
			sqlca.inpatientbalance(ll_primarykey, ld_balance)
			if sqlca.sqlcode = 0 then
				if ld_balance <> 0.0 then
					if ls_enforcepatientbalanceclearance = "Y" then
						SQL rollback USING sqlca;
						messagebox("Patient Discharge Alert!", "Patient Balance Not Zero~r~n" + "Patient Balance : " + string(ld_balance, "###,###,###0.00") + "~r~nIt must be Zero.~r~nDischarge Process Aborted.", stopsign!)
						return
					else
						ll_option = 2
						ll_option = messagebox("Patient Discharge Alert!", "Patient Balance Not Zero~r~n" + "Patient Balance : " + string(ld_balance, "###,###,###0.00") + "~r~nIt is Highly recommended that It must be Zero before discharge.~r~n~r~nDischarge Patient Anyway?", question!, yesnocancel!, 2)
						if ll_option > 1 then
							SQL rollback USING sqlca;
							return
						end if
					end if
					return
				end if
			else
				messagebox("Patient Discharge Problem!", "Unable To Fetch Patient Balance.~r~nDischarge Process Aborted.", stopsign!)
				SQL rollback USING sqlca;
				return
			end if
		end if
		if upper(f_stringpreferences("setpatientinactiveondischarge")) = "Y" and wf_set_patientactive(this.id_detail.getitemnumber(ll_row, "patientcode")) <> 0 then
			messagebox("Patient Discharge Problem!", "Unable to update Patient Active Status.~r~nDischarge Process Abort.")
			SQL rollback USING sqlca;
			return
		end if
		return
	end if
	if this.id_detail.update() > 0 then
		SQL commit USING sqlca;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		this.ib_commitok = true
		this.editflag = false
		if gs_allowsmsfunctions = "Y" and ls_discharged1 = "Y" and ls_discharged = "Y" then
			ls_invlist = trim(string(ll_primarykey))
			this.it_transobject.createautotriggersms(ls_invlist, 36, "Discharge")
			if this.it_transobject.sqlcode <> 0 then
				ls_errtext = "Problem in Generating Auto Triggered SMS.~r~nReasons are:- " + this.it_transobject.sqlerrtext
				SQL rollback USING this.it_transobject;
				messagebox("Auto Triggered SMS", ls_errtext)
			else
				SQL commit USING this.it_transobject;
			end if
		end if
	else
		SQL rollback USING sqlca;
		setpointer(arrow!)
		messagebox("Patient Discharge Problem!", "Changes Rollback in database, ~n~rSome database problem occurs", exclamation!, ok!, 1)
		return
	end if
	setpointer(arrow!)

// w_patientdischarge_form.ue_detail() returns 0
	long ll_code
	integer li_protect
	this.im_menu.m_file.m_new.enabled = false
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_delete.enabled = true
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.i_editmode = 2
	this.i_retrievemode = 2
	if this.tab_retrieve.tabpage_list.dw_list.rowcount() > 0 then
		if this.il_selectedrow > 0 then
			ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
			this.id_dwcontrol = this.id_detail
			wf_retrieve(ll_code)
			if this.id_dwcontrol.borderstyle.discharged1[this.id_dwcontrol.rowcount()] = "Y" and this.id_dwcontrol.borderstyle.discharged[this.id_dwcontrol.rowcount()] = "Y" then
				messagebox("Problem", "Patient Already Discharged.")
				this.im_menu.m_file.m_save.enabled = false
				li_protect = 1
				wf_protectdw(this.id_detail, li_protect)
			else
				if this.ib_initialdischarge_modifydate then
					this.id_detail.object.discharged1on.protect = "0"
					this.id_detail.settaborder("discharged1on", 11)
					this.id_detail.object.discharged1on.background.color = rgb(255, 255, 255)
				else
					this.id_detail.object.discharged1on.protect = "1"
					this.id_detail.settaborder("discharged1on", 0)
					this.id_detail.object.discharged1on.background.color = this.backcolor
				end if
				li_protect = 0
				wf_protectdw(this.id_detail, li_protect)
				if this.ib_initialdischarge then
					this.id_detail.object.discharged1.protect = "0"
				else
					this.id_detail.object.discharged1.protect = "1"
				end if
				if this.ib_finaldischarge then
					this.id_detail.object.discharged.protect = "0"
				else
					this.id_detail.object.discharged.protect = "1"
				end if
			end if
			if this.id_dwcontrol.borderstyle.discharged1[this.id_dwcontrol.rowcount()] = "N" then
				this.ib_discharged1 = false
			else
				this.ib_discharged1 = true
			end if
			this.id_dwcontrol = this.id_list
			this.tab_retrieve.tabpage_detail.dw_detail.setfocus()
		end if
		return
	end if
	this.ib_discharged1 = false

// w_patientdischarge_form.ue_newform() returns 0
	integer li_protect
	call super::ue_newform
	wf_protectdw(this.id_detail, li_protect)

// w_patientdischarge_form.ue_list() returns 0
	call super::ue_list
	this.ib_discharged1 = false
	this.im_menu.m_file.m_new.enabled = false

// w_patientdischarge_form.ue_print() returns 0
	long ll_code
	long ll_patientcode
	boolean lb_listtab
	s_datastore lstr
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_code) or ll_code <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_patientcode = this.id_list.getitemnumber(this.id_list.getrow(), "patientcode")
	else
		if isnull(this.id_detail.getrow()) or this.id_detail.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_detail.getitemnumber(this.id_detail.getrow(), "code")
		if isnull(ll_code) or ll_code <= 0 then
			messagebox("Selection Validation", "Kindly select any row for detail view.")
			return
		end if
		ll_patientcode = this.id_detail.getitemnumber(this.id_detail.getrow(), "patientcode")
	end if
	wf_setprintout()
	this.id_print.settransobject(sqlca)
	this.id_print.retrieve(ll_code)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print discharge slip", information!)
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Data,~r~nNo rows are retrieved", information!)
