// w_prescription_form.wf_patient_retrieve() returns long
	long ll_prow
	long ll_pcode
	this.idc_patient.retrieve(this.ii_module)
	ll_prow = this.idc_patient.insertrow(0)
	setnull(ll_pcode)
	this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
	this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
	this.idc_patient.setitem(ll_prow, "name", "<NONE>")
	this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
	this.idc_patient.setitem(ll_prow, "city", "<NONE>")
	this.idc_patient.scrolltorow(ll_prow)
	return 0

// w_prescription_form.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_prescriptionmenu" then
		this.menuid = create m_prescriptionmenu
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	this.dw_saleinvdetail = create dw_saleinvdetail
	this.dw_preview = create dw_preview
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.dw_saleinvdetail
	this.control[icurrent + 3] = this.dw_preview

// w_prescription_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.dw_saleinvdetail
	destroy this.dw_preview

// w_prescription_form.ue_save() returns 0 [event]
	long ll_detailrows
	long ll_counter
	long ll_count
	long ll_salesmancode
	long ll_mastercurrrow
	long ll_invid
	long ll_modifycounter
	long ll_null
	long ll_discontinueditem
	string ls_errtext
	datetime ldt_server_datetime
	string ls_date_errtext
	integer li_maxretcode
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	ll_discontinueditem = wf_checkdiscontinueditems()
	if ll_discontinueditem > 0 and this.ib_modify = false then
		messagebox("Discontinued Items Validation", "Can not discontinue item(s) while creating new prescriptions")
		this.id_detail.setrow(ll_discontinueditem)
		this.id_detail.scrolltorow(ll_discontinueditem)
		this.id_detail.setcolumn("discontinued")
		return
	end if
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		setpointer(hourglass!)
		ll_mastercurrrow = this.id_master.getrow()
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			li_maxretcode = wf_tabnewid("PrescriptionHeader", ll_invid)
			if li_maxretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~n ~t~t~t~t~t~t~t~t~t~t~t~t~tgenerating Prescription Code")
				return
			end if
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
		end if
		ll_detailrows = this.id_detail.rowcount()
		for ll_counter = 1 to ll_detailrows
			this.id_detail.setitem(ll_counter, "code", ll_invid)
		next
		this.id_saleinvdetail.reset()
		if this.ib_modify then
			ll_modifycounter = this.id_master.getitemnumber(ll_mastercurrrow, "modifycounter")
			if isnull(ll_modifycounter) then
				ll_modifycounter = 0
			end if
			ll_modifycounter = ll_modifycounter + 1
			this.id_master.setitem(ll_mastercurrrow, "modifycounter", ll_modifycounter)
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "modifieddate", ldt_server_datetime)
			if f_generateprescriptionlog(ll_invid, ldt_server_datetime, this.it_transobject) <> 0 then
				messagebox("Prescription History!", "Failure in Saving Prescription History!.")
				SQL rollback USING this.it_transobject;
				return
			end if
			if ll_discontinueditem > 0 and wf_populate_discontinued_items(ldt_server_datetime) > 0 then
				if this.id_saleinvdetail.update(true, true) <= 0 then
					messagebox("Discontinued Items!", "Failure in Saving Discontinued Items!.")
					SQL rollback USING this.it_transobject;
					return
				end if
				return
			end if
		else
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "originaldate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "modifieddate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "postdate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "createdby", ll_salesmancode)
		end if
		call super::ue_save
		if this.ib_commitok then
			this.ib_modify = false
		elseif this.ib_modify = false then
			setnull(ll_null)
			this.id_master.setitem(1, "Code", ll_null)
			this.id_master.accepttext()
		end if
	end if
	setpointer(arrow!)

// w_prescription_form.ue_newform() returns 0 [event]
	integer rtncode
	long li_fetched_code
	long row
	long ll_manfcode
	setredraw(false)
	call super::ue_newform
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_post.enabled = false
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.ib_modify = false
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	wf_visible(true)
	setredraw(true)

// w_prescription_form.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect
	long ll_row
	long ll_code
	long ll_deptcode
	long ll_rowcount
	boolean lb_flag
	boolean lb_modify
	call super::ue_detail
	setredraw(false)
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_post.enabled = false
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	if wf_isinvoiceinuse(ll_code) then
		messagebox("Prescription Validation", "Prescription already in use by some other user.~r~nKindly try again after sometime or open some other Prescription.")
		this.tab_retrieve.selecttab(2)
		setredraw(true)
		return
	end if
	li_protect = 0
	if this.id_master.getitemstring(1, "Posted") = "Y" then
		li_protect = 1
	end if
	wf_initmodify(li_protect)
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	wf_grandtotal()
	setredraw(true)

// w_prescription_form.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.ib_validatefullcode = true
	this.ii_defaultgcode = this.ii_salegodown

// w_prescription_form.ue_deleteitem() returns 0 [event]
	long ll_row
	long ll_footerrow
	call super::ue_deleteitem
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() <= 0 then
		this.im_menu.m_file.m_print.enabled = false
		this.im_menu.m_file.m_save.enabled = false
	end if

// w_prescription_form.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	return ::message.returnvalue

// w_prescription_form.ue_list() returns 0 [event]
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_print.enabled = false
	this.ib_modify = false
	if this.ib_posting then
		this.im_menu.m_file.m_post.visible = true
		this.im_menu.m_file.m_post.enabled = true
	else
		this.im_menu.m_file.m_post.visible = false
		this.im_menu.m_file.m_post.enabled = false
	end if
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	wf_retrievelist()

// w_prescription_form.ue_print() returns 0 [event]
	long ll_custcode
	long ll_row
	string ls_custname
	integer li_option
	long job
	call super::ue_print
	if this.im_menu.m_file.m_save.enabled = true then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save Prescription", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	this.id_print.dataobject = ""
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(this.id_master.getitemnumber(1, "code"))
	if this.id_print.rowcount() <= 0 then
		messagebox("Printing", "no rows retrieve")
		return
	end if
	job = printopen()
	if printdatawindow(job, this.id_print) > 0 then
		messagebox("Printing", "Print Invoice Completed")
	else
		messagebox("Printing", "Print Invoice Not Completed")
	end if
	printclose(job)

// w_prescription_form.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	setpointer(hourglass!)
	if this.ii_saletype <> 3 then
		this.idc_customers.setredraw(false)
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.retrieve()
		this.idc_customers.setredraw(true)
	end if
	this.idc_patient.setredraw(false)
	this.idc_patient.settransobject(this.it_transobject)
	wf_patient_retrieve()
	this.idc_patient.setredraw(true)
	setpointer(arrow!)

// w_prescription_form.ue_postopen() returns 0 [event]
	integer li_rtncode
	long ll_counter
	long ll_pos
	long ll_found
	m_prescriptionmenu lm_menu
	call super::ue_postopen
	lm_menu = this.menuid
	setredraw(false)
	this.id_saleinvdetail = this.dw_saleinvdetail
	this.id_saleinvdetail.settransobject(this.it_transobject)
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = true
	this.id_itemslist.object.sstock.visible = true
	this.id_itemslist.object.t_pstock.visible = false
	this.id_itemslist.object.pstock.visible = false
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.sstock.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	li_rtncode = this.id_master.getchild("patientcode", this.idc_patient)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_patient.settransobject(this.it_transobject)
	wf_patient_retrieve()
	gd_itemsinfo.sharedata(this.id_itemslist)
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 586", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_posting = true
	else
		this.ib_posting = false
	end if
	setredraw(true)

// w_prescription_form.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	return ::message.returnvalue

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	return ::message.returnvalue

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
	case "flatdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	end choose
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	long ll_admissioncode
	long ll_patientcode
	long ll_res
	long ll_pres_duration
	long ll_duration
	integer rt_code
	datetime ldt_pres_datetime
	datetime ldt_datetime
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "regno"
		if not isnull(data) and data <> "" then
			ll_res = parent.parent.parent.wf_findpatientcode(data, ll_patientcode)
			if ll_res > 0 then
				setitem(row, "patientcode", ll_patientcode)
				ll_admissioncode = parent.parent.parent.wf_set_admission(long(data))
				if ll_admissioncode > 0 then
					setitem(row, "admissioncode", ll_admissioncode)
				end if
				rt_code = 0
			else
				messagebox("Patient Validation", "Patient with  RegNo  " + data + " does not exist.")
				rt_code = 1
			end if
		end if
	case "patientcode"
		ll_admissioncode = parent.parent.parent.wf_set_admission(long(data))
		if ll_admissioncode > 0 then
			setitem(row, "admissioncode", ll_admissioncode)
		end if
	end choose
	return rt_code

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "patientcode"
		messagebox("Patient Validation", "Kindly select patient from drop down.")
	case "startdate"
		messagebox("Start Date Validation", "Kindly enter valid Start Date.~r~nPlease make sure Start Date is less than End Date.")
	case "enddate"
		messagebox("End Date Validation", "Kindly enter valid End Date.~r~nPlease make sure Start Date is less than End Date.")
	end choose
	return 1

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	long ll_newqty
	long ll_storedqty
	long ll_stock
	long ll_null
	long ll_icode
	long ll_gcode
	long ll_duration
	string ls_null
	string ls_itemname
	datetime ldt_datetime
	dwitemstatus ldw_itemstatus
	integer li_res
	long ll_dosefactor
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case "discontinued"
		if data = "Y" then
			ldw_itemstatus = parent.parent.parent.id_detail.getitemstatus(row, 0, primary!)
			if ldw_itemstatus = new! or ldw_itemstatus = newmodified! then
				li_errcode = 1
			end if
		end if
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
		parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		li_errcode = 0
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname)
			if li_res > 0 then
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
			else
				messagebox("ItemNumber Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_errcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_errcode = 2
		end if
	case "dosagecode"
		ll_dosefactor = parent.parent.parent.wf_get_dosefactor(long(data))
		if ll_dosefactor > 0 then
			setitem(row, "dosefactor", ll_dosefactor)
		end if
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ll_icode
	long ll_gcode
	long ll_godownstock
	long ancestorreturnvalue
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(false) = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "itemname" then
		parent.parent.parent.ib_focusdetail = true
	end if
	if dwo.name = "reorderqty" and parent.parent.parent.ib_itemslistopen then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
	end if
	parent.parent.parent.wf_grandtotal()
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return 0

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(true) = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "discontinued"
		if data = "Y" then
			messagebox("Discontinued Item Validation", "A new Item Can not be discontinued.")
		end if
	case "fullcode"
		if data = "" or isnull(data) then
		end if
	case parent.parent.parent.is_columnitemname
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row.")
		end if
	case "noofunits"
		messagebox("No. Of Units Validation", "No. of units ~"" + data + "~" should be greater than zero")
	case "dosagecode"
		messagebox("Dose Validation", "Kindly select dosage from drop down.")
	case "routecode"
		messagebox("Route Validation", "Kindly select route from drop down.")
	case "duration"
		messagebox("Duration Validation", "Kindly enter valid duration.")
	end choose
	return 1

// dw_itemsdetail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	long ancestorreturnvalue
	if f_stringpreferences("itemcode") = "N" and getcolumnname() = "itemname" then
		ancestorreturnvalue = super::getfocus()
	end if
	return ::message.returnvalue
