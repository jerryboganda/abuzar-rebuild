// window w_prescription_form (patientcomponents)  ancestor: w_multi_entry

// w_prescription_form.ue_printdo() returns 0 [event]
	long ll_custcode
	long ll_row
	string ls_custname
	if this.im_menu.m_file.m_save.enabled = true then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	this.id_print.dataobject = "d_deliveryorder_half"
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(this.id_master.getitemnumber(1, "code"))
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_prescription_form.wf_visible(boolean ab_flag) returns 0
	this.id_footer.object.stock.visible = ab_flag
	this.id_footer.object.t_stock.visible = ab_flag

// w_prescription_form.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	long iccode
	long icatcode
	long packcode
	long manfcode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_prescription_form.wf_getmaxdate(datetime ad_date) returns integer
	SQL Select Max ( Date ) INTO :ad_date From saleledger USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_prescription_form.wf_getsalesstockinfo(long al_saleinvcode, long al_gcode, long al_icode, long al_saleqty) returns integer
	SQL Select IsNull ( Sum ( saledetail.looseqty ) , 0 ) INTO :al_saleqty from saledetail where saledetail.saleinvcode =:al_saleinvcode and saledetail.gcode =:al_gcode and saledetail.icode =:al_icode USING this.it_transobject;
	if isnull(al_saleqty) then
		al_saleqty = 0
	end if
	return this.it_transobject.sqlcode

// w_prescription_form.wf_validateitemnew() returns integer
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
		messagebox(ls_titleerrtext, ls_errtext)
	elseif not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		ls_titleerrtext = "Item Validation"
		li_errcode = -2
	end if
	this.ib_itemvalidated = true
	return li_errcode

// w_prescription_form.wf_selectprintreport() returns string
	string ls_pagesize
	string ls_report
	ls_pagesize = f_stringpreferences("pagesize")
	if ls_pagesize = "Q" and this.ii_saletype = 3 then
		if gs_company = "ZA" or gs_company = "CLINIX" then
			ls_report = "d_retailsaleinvreportwh"
		else
			ls_report = "d_retailsaleinvreport"
		end if
	elseif ls_pagesize = "Q" and this.ii_saletype = 2 then
		if gs_company = "ZA" or gs_company = "CLINIX" then
			ls_report = "d_wholesaleinvreportwh"
		else
			ls_report = "d_wholesaleinvreport"
		end if
	elseif ls_pagesize = "F" and this.ii_saletype = 3 then
		if gs_company = "SA" then
			ls_report = "d_sa_retailsaleinvreport_full"
		else
			ls_report = "d_retailsaleinvreport_full"
		end if
	elseif ls_pagesize = "F" and this.ii_saletype = 2 then
		if gs_company = "SA" then
			ls_report = "d_sa_wholesaleinvreport_full"
		else
			ls_report = "d_wholesaleinvreport_full"
		end if
	else
		ls_report = "d_retailsaleinvreport_full"
	end if
	this.id_print.dataobject = ls_report
	this.id_print.settransobject(this.it_transobject)
	return ls_report

// w_prescription_form.wf_getitemassociategcode(long la_icode) returns integer
	integer li_gcode
	SQL Select Gcode INTO :li_gcode From item Where icode =:la_icode USING this.it_transobject;
	return li_gcode

// w_prescription_form.wf_preinvinfo() returns 0
	s_previnvinfo ls_previnvinfo
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_previnvinfo.ar_customer = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		ls_previnvinfo.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		openwithparm(w_previnvinfo, ls_previnvinfo)
	end if

// w_prescription_form.wf_print() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_count
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			for ll_count = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
				this.id_print.retrieve(ll_count)
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			next
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	return li_errcode

// w_prescription_form.wf_setsaletype(integer ai_saletype) returns 0
	this.ii_saletype = ai_saletype

// w_prescription_form.wf_updatesaleprice(long al_icode, double ad_saleprice) returns integer
	SQL update Item SET saleprice =:ad_saleprice WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_prescription_form.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean lb_rtflag
	boolean ib_due
	integer li_null
	string ls_null
	ls_titleerrtext = "Item Validation"
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), al_currrow) = true then
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
	elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			li_option = messagebox("Item Validation", "Item stock does not exist~n~rDo You want to due this item", information!, yesno!, 2)
			if li_option = 1 then
				this.id_detail.setitem(this.il_currrow, "looseqty", 1)
				this.id_detail.setitem(this.il_currrow, "dueqty", 1)
				ib_due = true
			else
				li_errcode = -1
			end if
		end if
	else
		li_errcode = -1
		ls_titleerrtext = "Item Validation"
	end if
	if li_errcode = -1 and not ib_due then
		lb_rtflag = false
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setitem(al_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(al_currrow, "icode", li_null)
		this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	end if
	return lb_rtflag

// w_prescription_form.wf_validategodown() returns integer
	long ll_icode
	long ll_gcode
	long ll_stock
	long ll_counter
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	string ls_null
	integer li_errcode
	integer li_null
	integer li_option
	integer li_duperr
	boolean ib_due
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	this.ii_defaultgcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	if wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode <> -2 then
			for ll_counter = 1 to this.id_detail.rowcount()
				if this.il_currrow <> ll_counter and (ll_icode = this.id_detail.getitemnumber(ll_counter, "icode") and this.ii_defaultgcode = this.id_detail.getitemnumber(ll_counter, "gcode")) then
					li_duperr = -2
				end if
			next
		end if
	end if
	this.ib_godownvalidated = true
	if li_errcode = -1 and not ib_due then
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		this.id_detail.setfocus()
		this.id_detail.setcolumn("gcode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
	end if
	if li_duperr = -2 and not ib_due then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate Item, please select some other item"
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
		this.ib_itemslistopen = true
		this.id_itemslist.show()
		li_errcode = -1
	end if
	return li_errcode

// w_prescription_form.wf_retrievelist() returns long
	string[] ls_posted
	integer li_salecategory
	integer li_invforlastdays
	datetime ld_invdate
	ld_invdate = datetime(relativedate(today(), li_invforlastdays))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		li_salecategory = this.ii_salecategory
	else
		li_salecategory = this.ii_saletype
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, this.il_groupcode, this.ii_module)

// w_prescription_form.wf_retrievelistall() returns long
	string[] ls_posted
	integer li_salecategory
	datetime ld_invdate
	ld_invdate = datetime(date("12/12/1998"), time("00:00:00"))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		li_salecategory = this.ii_salecategory
	else
		li_salecategory = this.ii_saletype
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, this.il_groupcode, this.ii_module)

// w_prescription_form.wf_selectitembatches(long al_gcode, long al_icode, long al_qty, datawindow ad_itemsdetail, long al_rowscount, string al_errortext) returns integer
	datastore lds_itemstockinfo
	long ll_counter
	long ll_saleqty
	long ll_reqqty
	long ll_totalstock
	long ll_batchqty
	long ll_detailrowcount
	boolean lb_flag
	integer li_errcode
	lds_itemstockinfo = create datastore
	lds_itemstockinfo.dataobject = "d_itemstockinfo"
	lds_itemstockinfo.settransobject(this.it_transobject)
	if lds_itemstockinfo.retrieve(al_gcode, al_icode) > 0 then
		ll_totalstock = lds_itemstockinfo.getitemnumber(1, "c_totalstock")
		if ll_totalstock >= al_qty then
			ll_reqqty = al_qty
			ll_detailrowcount = ad_itemsdetail.rowcount()
			ll_counter = 1
			do while ll_counter <= lds_itemstockinfo.rowcount() and not lb_flag
				ll_batchqty = lds_itemstockinfo.getitemnumber(ll_counter, "currqty")
				if ll_batchqty >= ll_reqqty then
					ll_saleqty = ll_reqqty
					lb_flag = true
				else
					ll_saleqty = ll_batchqty
					ll_reqqty = ll_reqqty - ll_batchqty
				end if
				ad_itemsdetail.insertrow(0)
				ll_detailrowcount = ll_detailrowcount + 1
				ad_itemsdetail.setitem(ll_detailrowcount, "gcode", al_gcode)
				ad_itemsdetail.setitem(ll_detailrowcount, "icode", al_icode)
				ad_itemsdetail.setitem(ll_detailrowcount, "batch", lds_itemstockinfo.getitemstring(ll_counter, "batch"))
				ad_itemsdetail.setitem(ll_detailrowcount, "expiry", lds_itemstockinfo.getitemdatetime(ll_counter, "expiry"))
				ad_itemsdetail.setitem(ll_detailrowcount, "stock", ll_batchqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "totalstock", ll_totalstock)
				ad_itemsdetail.setitem(ll_detailrowcount, "qty", ll_saleqty)
				ll_counter = ll_counter + 1
			loop
			al_rowscount = ll_counter - 1
		else
			li_errcode = 1
			al_rowscount = ll_totalstock
			al_errortext = "Stock has been decreased for this item   "
		end if
	else
		li_errcode = 1
		al_rowscount = ll_totalstock
		al_errortext = "Stock does not exist for this item   "
	end if
	destroy lds_itemstockinfo
	return li_errcode

// w_prescription_form.wf_setgodownoption() returns 0
	this.ii_salegodown = this.id_detail.getitemnumber(1, "gcode")
	if this.il_strategy = 2 or this.il_strategy = 1 and this.il_godowncount = 1 then
		this.id_detail.modify("gcode" + ".Protect=1")
		this.id_detail.object.gcode.background.color = this.backcolor
	end if

// w_prescription_form.wf_grandtotal() returns double
	double ld_grandtotal
	ld_grandtotal = 0
	return ld_grandtotal

// w_prescription_form.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_prescription_form.wf_validateitem(boolean ab_flag) returns integer
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean ib_due
	integer li_null
	string ls_null
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if not isnull(ll_icode) then
		if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
			ls_titleerrtext = "Item Validation"
			ls_errtext = "Duplicate item, please select some other item"
			li_errcode = -1
		elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
			if li_errcode = -2 then
				li_errcode = -1
			end if
		else
			ls_titleerrtext = "Item Validation"
		end if
	end if
	if ab_flag then
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		ls_titleerrtext = "Item Validation"
		messagebox(ls_titleerrtext, ls_errtext)
		if f_stringpreferences("itemcode") = "N" then
			this.id_detail.setcolumn(this.is_columnitemname)
			this.ib_itemslistopen = true
			this.id_itemslist.show()
		else
			this.id_detail.setcolumn("fullcode")
			this.id_detail.object.fullcode[this.il_currrow] = ls_null
		end if
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
	end if
	return li_errcode

// w_prescription_form.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	integer ll_icode
	integer ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_prescription_form.wf_inititeminfo(long al_icode, long al_row, integer ai_rtcode, string as_errortext) returns boolean
	boolean retflag
	double ld_saleprice
	long ll_packunits
	long ll_godownstock
	long ll_saleqty
	long ll_saleinvcode
	long ll_totalstock
	double ld_saleprice2
	double ld_saleprice3
	double ld_avgprice
	double ld_mrpp
	double ld_purprice
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_null
	setnull(ls_null)
	SQL SELECT item.customicode , item.name INTO :ls_fullcode, :ls_name FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	li_gcode = this.id_master.object.code[1]
	if retflag then
		this.id_detail.setitem(al_row, "code", li_gcode)
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		this.id_detail.setitem(al_row, "icode", al_icode)
	else
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	return retflag

// w_prescription_form.wf_findpatientcode(string as_regno, long al_patientcode) returns long
	long ll_patientcode
	long ll_retflag
	string ls_itemname
	SQL SELECT patient.patientcode INTO :ll_patientcode FROM patient WHERE patient.regno =:as_regno AND patient.active ='Y' AND patientcatcode in ( SELECT DISTINCT patientcatcode FROM patientcatallowedmodule WHERE moduleid =:this.ii_module ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_patientcode = ll_patientcode
		if isnull(al_patientcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_prescription_form.wf_closelist() returns 0
	this.ib_itemslistopen = false
	this.id_itemslist.hide()

// w_prescription_form.wf_validate_date_duration(datetime adt_pres_datetime, long al_duration) returns integer
	long ll_rowcount
	long ll_counter
	datetime ldt_pres_datetime
	datetime ldt_datetime
	long ll_pres_duration
	long ll_duration
	ldt_pres_datetime = adt_pres_datetime
	ll_duration = al_duration
	ll_rowcount = this.id_detail.rowcount()
	for ll_counter = 1 to ll_rowcount
		ldt_datetime = this.id_detail.getitemdatetime(ll_counter, "startdate")
		ll_duration = this.id_detail.getitemnumber(ll_counter, "duration")
		if ldt_datetime < ldt_pres_datetime then
			messagebox("Start Date Validation", "System is setting a valid Start Date for Item on S.NO. : " + string(ll_counter) + "Reasons are: Prescription Start Date should be less than Item Start Date.")
			this.id_detail.setitem(ll_counter, "startdate", ldt_pres_datetime)
		end if
		if relativedate(date(ldt_pres_datetime), ll_pres_duration) < relativedate(date(ldt_datetime), ll_duration) then
			messagebox("Duration Validation", "System is setting a valid Duration for Item on S.NO. : " + string(ll_counter) + "Reasons are: Item Duration should be less than Prescription Duration.")
			this.id_detail.setitem(ll_counter, "startdate", ldt_pres_datetime)
		end if
	next
	return 0

// w_prescription_form.wf_validateitem_date_duration(datetime adt_datetime, long al_duration) returns integer
	long ll_rowcount
	long ll_counter
	datetime ldt_pres_datetime
	datetime ldt_datetime
	long ll_pres_duration
	long ll_duration
	ldt_pres_datetime = this.id_master.getitemdatetime(this.id_master.getrow(), "StartDate")
	ll_duration = this.id_master.getitemnumber(this.id_master.getrow(), "Duration")
	ldt_datetime = adt_datetime
	ll_duration = al_duration
	if ldt_datetime < ldt_pres_datetime then
		messagebox("Start Date Validation", "System is setting a valid Start Date for Item on S.NO. : " + string(ll_counter) + "Reasons are: Prescription Start Date should be less than Item Start Date.")
		this.id_detail.setitem(ll_counter, "startdate", ldt_pres_datetime)
	end if
	if relativedate(date(ldt_pres_datetime), ll_pres_duration) < relativedate(date(ldt_datetime), ll_duration) then
		messagebox("Duration Validation", "System is setting a valid Duration for Item on S.NO. : " + string(ll_counter) + "Reasons are: Item Duration should be less than Prescription Duration.")
		this.id_detail.setitem(ll_counter, "startdate", ldt_pres_datetime)
	end if
	return 0

// w_prescription_form.wf_set_admission(long al_patientcode) returns long
	long ll_admissioncode
	SQL Select Max ( AdmissionCode ) INTO :ll_admissioncode From PatientAdmission Where patientcode =:al_patientcode And discharged1 ='N' USING sqlca;
	if sqlca.sqlcode = 0 then
		return ll_admissioncode
	end if
	return -1

// w_prescription_form.wf_get_dosefactor(long al_dosagecode) returns long
	long ll_dosefactor
	SQL Select dosefactor INTO :ll_dosefactor From Dosage Where dosagecode =:al_dosagecode USING sqlca;
	if sqlca.sqlcode = 0 then
		return ll_dosefactor
	end if
	return -1

// w_prescription_form.wf_locksaleinvoices(long al_sinvcode, long al_linvcode, long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From PrescriptionHeader WITH ( UPDLOCK HOLDLOCK ) Where PrescriptionHeader.Prescode Between :al_sinvcode AND :al_linvcode AND PrescriptionHeader.Posted ='N' USING sqlca;
	return sqlca.sqlcode

// w_prescription_form.wf_locksaleinvoice(long al_saleinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From PrescriptionHeader WITH ( UPDLOCK HOLDLOCK ) Where PrescriptionHeader.Prescode =:al_saleinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_prescription_form.wf_isinvoiceinuse(long al_invoiceno) returns boolean
	long ll_found
	SQL Select count ( *) INTO :ll_found From PrescriptionHeader Where PresCode =:al_invoiceno and Posted ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_found = 0 or isnull(ll_found) then
			ll_found = 0
			SQL Select count ( *) INTO :ll_found From PrescriptionHeader With ( ReadPast , RowLock , UpdLock ) Where PresCode =:al_invoiceno USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ll_found = 0 then
					return true
				else
					return false
				end if
			else
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_prescription_form.wf_initmodify(integer ai_protect) returns 0
	long ll_code
	long ll_gcode
	long ll_icode
	long ll_looseqty
	long ll_stock
	long ll_counter
	long ll_count
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_code = this.id_master.getitemnumber(1, "code")
		if wf_locksaleinvoice(ll_code) = 0 then
			this.id_master.retrieve(ll_code)
			this.id_detail.retrieve(ll_code)
			if ai_protect = 0 then
				this.ib_modify = true
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
			return
		end if
		messagebox("Cannot Modify", "Prescription is already in use")
	end if

// w_prescription_form.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_prescription_form.wf_post() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	s_arguements lstr_arginfo
	datetime ldt_server_datetime
	string ls_date_errtext
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return -1
			end if
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			li_errcode = wf_locksaleinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_saleinvcount)
			if li_errcode = 0 then
				sqlca.postpresheader(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode)
				if sqlca.sqlcode <> 0 then
					li_errcode = -1
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if li_errcode <> 0 then
		messagebox("Posting Fails", "Some database request fails, Please try again")
	else
		messagebox("Posting Successfull", "All rows have been posted successfully")
	end if
	return li_errcode

// w_prescription_form.wf_checkdiscontinueditems() returns long
	long ll_found
	long ll_detail_rowcount
	ll_detail_rowcount = this.id_detail.rowcount()
	if ll_detail_rowcount > 0 then
		ll_found = this.id_detail.find("discontinued='Y'", 1, this.id_detail.rowcount())
		if ll_found <= 0 then
			ll_found = 0
		end if
	end if
	return ll_found

// w_prescription_form.wf_populate_discontinued_items(datetime adt_server_datetime) returns long
	long ll_found
	long ll_insrow
	long ll_counter
	long ll_detail_rowcount
	long ll_discontinued_count
	ll_detail_rowcount = this.id_detail.rowcount()
	for ll_counter = 1 to ll_detail_rowcount
		if this.id_detail.object.discontinued[ll_counter] = "Y" then
			ll_insrow = this.id_saleinvdetail.insertrow(0)
			this.id_saleinvdetail.object.code[ll_insrow] = this.id_detail.object.code[ll_counter]
			this.id_saleinvdetail.object.icode[ll_insrow] = this.id_detail.object.icode[ll_counter]
			this.id_saleinvdetail.object.rowid[ll_insrow] = this.id_detail.object.rowid[ll_counter]
			this.id_saleinvdetail.object.noofunits[ll_insrow] = this.id_detail.object.noofunits[ll_counter]
			this.id_saleinvdetail.object.dosagecode[ll_insrow] = this.id_detail.object.dosagecode[ll_counter]
			this.id_saleinvdetail.object.dosefactor[ll_insrow] = this.id_detail.object.dosefactor[ll_counter]
			this.id_saleinvdetail.object.routecode[ll_insrow] = this.id_detail.object.routecode[ll_counter]
			this.id_saleinvdetail.object.date[ll_insrow] = this.id_detail.object.date[ll_counter]
			this.id_saleinvdetail.object.duration[ll_insrow] = this.id_detail.object.duration[ll_counter]
			this.id_saleinvdetail.object.inscode[ll_insrow] = this.id_detail.object.inscode[ll_counter]
			this.id_saleinvdetail.object.deletedate[ll_insrow] = adt_server_datetime
			ll_discontinued_count = ll_discontinued_count + 1
		end if
	next
	do
		ll_found = this.id_detail.find("discontinued='Y'", 0, this.id_detail.rowcount())
		if ll_found > 0 then
			this.id_detail.deleterow(ll_found)
		end if
	loop while ll_found > 0
	return ll_discontinued_count

// w_prescription_form.wf_view_prescription_profile() returns long
	long ll_code
	boolean lb_listtab
	s_datastore lstr
	if this.tab_retrieve.selectedtab = 2 then
		return 0
	end if
	if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
		messagebox("Rows Validation", "Kindly select any row from the list view.")
		return 0
	end if
	ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
	if isnull(ll_code) or ll_code <= 0 then
		messagebox("Selection Validation", "Kindly select any row from the list view.")
		return 0
	end if
	this.dw_preview.dataobject = "d_view_prescription_profile"
	this.dw_preview.settransobject(sqlca)
	this.dw_preview.retrieve(ll_code)
	lstr.dw = this.dw_preview
	lstr.s_name1 = "d_view_prescription_profile"
	openwithparm(w_preview_invoices, lstr)
	return 1

// w_prescription_form.wf_view_discontinued_items() returns long
	long ll_code
	boolean lb_listtab
	s_datastore lstr
	if this.tab_retrieve.selectedtab = 2 then
		return 0
	end if
	if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
		messagebox("Rows Validation", "Kindly select any row from the list view.")
		return 0
	end if
	ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
	if isnull(ll_code) or ll_code <= 0 then
		messagebox("Selection Validation", "Kindly select any row from the list view.")
		return 0
	end if
	this.dw_preview.dataobject = "d_view_prescription_discontinueditems"
	this.dw_preview.settransobject(sqlca)
