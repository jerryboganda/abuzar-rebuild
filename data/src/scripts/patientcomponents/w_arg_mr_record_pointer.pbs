// window w_arg_mr_record_pointer (patientcomponents)  ancestor: w_arguements

// w_arg_mr_record_pointer.create() returns 0 [event]
	call super::create

// w_arg_mr_record_pointer.destroy() returns 0 [event]
	call super::destroy

// w_arg_mr_record_pointer.open() returns long [event]
	long ancestorreturnvalue
	integer li_rtcode
	ancestorreturnvalue = super::open()
	this.ids_ds = create datastore
	this.ids_ds.dataobject = "d_mr_recordpointer"
	this.ids_ds.settransobject(sqlca)
	this.ids_ds = message.powerobjectparm
	li_rtcode = this.dw_control.getchild("rowid", this.id_dwc)
	if li_rtcode = -1 then
		messagebox("Error", "Not a DataWindowChild")
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	this.id_dwc.settransobject(sqlca)
	this.ids_ds.sharedata(this.id_dwc)
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_arg_mr_record_pointer.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "rowid")
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
