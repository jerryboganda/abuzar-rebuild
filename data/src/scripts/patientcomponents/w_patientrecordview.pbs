// window w_patientrecordview (patientcomponents)  ancestor: w_popup_forselection_walias

// w_patientrecordview.create() returns 0 [event]
	integer icurrent
	call super::create
	this.gb_2 = create gb_2
	this.st_1 = create st_1
	this.st_2 = create st_2
	this.em_startdate = create em_startdate
	this.em_enddate = create em_enddate
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_2
	this.control[icurrent + 2] = this.st_1
	this.control[icurrent + 3] = this.st_2
	this.control[icurrent + 4] = this.em_startdate
	this.control[icurrent + 5] = this.em_enddate

// w_patientrecordview.destroy() returns 0 [event]
	call super::destroy
	destroy this.gb_2
	destroy this.st_1
	destroy this.st_2
	destroy this.em_startdate
	destroy this.em_enddate

// w_patientrecordview.open() returns long [event]
	long ancestorreturnvalue
	date ld_currdate
	string ls_text
	ancestorreturnvalue = super::open()
	ld_currdate = today()
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 00:00:00"
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.em_enddate.text = ls_text
	return ::message.returnvalue

// w_patientrecordview.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// dw_selected.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_temp
	long ll_rowm
	s_popup_selection lstr_selection
	if getcolumnname() = "name" then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrollnextrow()
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrollpriorrow()
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrollnextpage()
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrollpriorpage()
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrolltorow(parent.id_selectionlist.rowcount())
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrolltorow(1)
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.id_selectionlist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf4! then
			parent.id_selectionlist.show()
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrolltorow(parent.id_selectionlist.getrow())
			parent.id_selectionlist.selectrow(parent.id_selectionlist.getrow(), true)
			setredraw(true)
		elseif key = keyf6! then
			openwithparm(w_popup_comprehensicesearch_selection, "d_patient_comprehensive_list")
			lstr_selection = message.powerobjectparm
			if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
				ll_temp = parent.id_selectionlist.find("code = " + string(lstr_selection.l_code2), 1, parent.id_selectionlist.rowcount())
				if ll_temp > 0 then
					ll_listcurrrow = ll_temp
					parent.id_selectionlist.selectrow(0, false)
					parent.id_selectionlist.scrolltorow(ll_listcurrrow)
					rt_code = 1
				end if
			end if
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.id_selectionlist.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, "code", parent.id_selectionlist.getitemnumber(ll_listcurrrow, "code"))
			setitem(ll_rowm, "aliasname", parent.id_selectionlist.getitemstring(ll_listcurrrow, "aliasname"))
			setitem(ll_rowm, "name", parent.id_selectionlist.getitemstring(ll_listcurrrow, "name"))
			selecttext(1, len(gettext()))
			setredraw(true)
		end if
	end if
	return rt_code

// cb_cancel.clicked() returns long [event]
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ll_code
	if parent.id_selected.accepttext() = -1 then
		parent.id_selected.setfocus()
		return ::message.returnvalue
	elseif isnull(parent.id_selected.getitemstring(parent.id_selected.getrow(), "name")) then
		messagebox("Name Validation", "Please enter valid value for Name.")
		parent.id_selected.setcolumn(1)
		parent.id_selected.setfocus()
		return ::message.returnvalue
	end if
	parent.is_popup_selection.l_code = parent.id_selected.getitemnumber(parent.id_selected.getrow(), "code")
	parent.is_popup_selection.s_name = parent.id_selected.getitemstring(parent.id_selected.getrow(), "name")
	parent.istr_arg.l_code1 = parent.id_selected.getitemnumber(1, "code")
	if isnull(parent.istr_arg.l_code1) then
		parent.istr_arg.l_code1 = 0
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_status = 1
	ll_code = parent.istr_arg.l_code1
	if ll_code > 0 and ll_code > 0 then
		f_show_patient_gallary(ll_code)
	end if
	parent.id_selected.setfocus()
	parent.id_selected.setcolumn("code")
	return ::message.returnvalue

// em_startdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_enddate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
