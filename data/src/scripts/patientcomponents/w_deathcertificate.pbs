// window w_deathcertificate (patientcomponents)  ancestor: w_multi_entry

// w_deathcertificate.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_temp
	string ls_colname
	string ls_rtnstring
	if not isnull(ad_dwcontrol.dataobject) then
		li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
		for li_counter = li_colcount to 1 step -1
			ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
			if ai_doundo = 1 then
				ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
			else
				ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
			end if
		next
	end if

// w_deathcertificate.wf_pickselectedmodule(ref datawindow ad_sourcedw, ref datawindow ad_targetdw) returns long
	long ll_totrows
	long ll_row
	long ll_newrow
	ll_totrows = ad_sourcedw.rowcount()
	ll_row = 1
	do while ll_totrows <> 0 and ll_row <= ll_totrows
		if ad_sourcedw.object.selected[ll_row] = 1 then
			ll_newrow = ad_targetdw.insertrow(0)
			ad_targetdw.object.code[ll_newrow] = ad_sourcedw.object.code[ll_row]
			ad_targetdw.object.moduleid[ll_newrow] = ad_sourcedw.object.moduleid[ll_row]
		end if
		ll_row = ll_row + 1
	loop
	return 1

// w_deathcertificate.wf_findpatientcode(string as_regno, ref long al_patientcode) returns long
	long ll_patientcode
	long ll_retflag
	string ls_itemname
	char lc_active
	ll_retflag = 0
	SQL SELECT patient.patientcode , patient.active INTO :ll_patientcode, :lc_active FROM patient WHERE patient.regno =:as_regno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_patientcode = ll_patientcode
		if isnull(al_patientcode) then
			ll_retflag = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
		else
			ll_retflag = -2
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_deathcertificate.wf_get_patient_info(long al_code) returns long
	long ll_patientcode
	long ll_admissioncode
	long ll_visitcode
	long ll_diseasecode
	long ll_doctcode
	string ls_regno
	string ls_patientname
	string ls_fname
	string ls_age
	string ls_gender
	string ls_nic
	string ls_doctorname
	datetime ldt_dob
	SQL SELECT PatientCode , RegNo , Name , FName , DOB , Age =LTRIM ( RTRIM ( STR ( AgeYears ) ) ) + ' yrs ' + LTRIM ( RTRIM ( STR ( AgeMonths ) ) ) + ' month ' + LTRIM ( RTRIM ( STR ( AgeDays ) ) ) + ' days' , Gender , VisitCode =( SELECT MAX ( V.VisitCode ) FROM Visit V WHERE V.PatientCode =Patient.PatientCode ) , AdmissionCode =( SELECT MAX ( PA.AdmissionCode ) FROM PatientAdmission PA WHERE PA.PatientCode =Patient.PatientCode ) , DiseaseCode , NationalIDCard , Doctor =( SELECT D.Name FROM Doctors D WHERE D.DoctCode =Patient.DoctCode ) INTO :ll_patientcode, :ls_regno, :ls_patientname, :ls_fname, :ldt_dob, :ls_age, :ls_gender, :ll_visitcode, :ll_admissioncode, :ll_diseasecode, :ls_nic, :ls_doctorname FROM Patient WHERE PatientCode =:al_code USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.object.patientcode[1] = al_code
		this.id_master.object.admissioncode[1] = ll_admissioncode
		this.id_master.object.visitcode[1] = ll_visitcode
		this.id_master.object.regno[1] = ls_regno
		this.id_master.object.diseasecode[1] = ll_diseasecode
		this.id_master.object.fullname[1] = ls_patientname
		this.id_master.object.dob[1] = ldt_dob
		this.id_master.object.cnic[1] = ls_nic
		this.id_master.object.doctorname[1] = ls_doctorname
		this.id_master.object.hospitalname[1] = f_reportheaderinfo("clientname")
		return 0
	end if
	return -1

// w_deathcertificate.wf_patientsearch() returns long
	string ls_regno
	long ll_res
	long ll_null
	s_arguements ls_arguements
	setnull(ll_null)
	open(w_patientsearch)
	ls_arguements = message.powerobjectparm
	if ls_arguements.i_status = 1 then
		openwithparm(w_patientsearchresult, ls_arguements)
		ls_arguements = message.powerobjectparm
		if ls_arguements.i_status = 1 and ls_arguements.l_code1 > 0 then
			wf_get_patient_info(ls_arguements.l_code1)
		end if
	end if
	return 0

// w_deathcertificate.create() returns 0 [event]
	integer icurrent
	call super::create
	this.dw_print = create dw_print
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print

// w_deathcertificate.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_print

// w_deathcertificate.ue_newform() returns 0 [event]
	setredraw(false)
	this.i_editmode = 1
	this.i_retrievemode = 2
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_new.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_item.m_newitem.enabled = false
	this.im_menu.m_item.m_deleteitem.enabled = false
	this.im_menu.m_file.m_first.enabled = false
	this.im_menu.m_file.m_next.enabled = false
	this.im_menu.m_file.m_previous.enabled = false
	this.im_menu.m_file.m_last.enabled = false
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_retrieve.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.tab_retrieve.tabpage_detail.enabled = true
	if this.id_master.rowcount() > 0 then
		this.id_master.reset()
	end if
	this.ib_focusdetail = false
	this.id_master.insertrow(0)
	this.id_detail.reset()
	this.id_detail.retrieve(-1)
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	setredraw(true)

// w_deathcertificate.ue_detail() returns 0 [event]
	integer li_protect
	call super::ue_detail
	this.im_menu.m_file.m_save.enabled = true
	li_protect = 0

// w_deathcertificate.ue_save() returns 0 [event]
	long ll_invid
	long ll_mastercurrrow
	long ll_counter
	long ll_rows
	long ll_null
	long ll_usercode
	boolean lb_commit = true
	boolean lb_flag
	string ls_null
	setnull(ls_null)
	setnull(ll_null)
	setpointer(hourglass!)
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	ll_mastercurrrow = this.id_master.getrow()
	ll_usercode = gl_usercode
	ll_invid = this.id_master.object.code[ll_mastercurrrow]
	if isnull(ll_invid) then
		wf_tabnewid("DeathCertificate", ll_invid)
		this.id_master.object.code[ll_mastercurrrow] = ll_invid
	end if
	this.id_master.object.usercode[ll_mastercurrrow] = ll_usercode
	if this.id_master.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		messagebox("Problem Saving..", "Changes do not take effect in database", stopsign!, ok!, 1)
		setpointer(arrow!)
		return
	else
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		this.ib_commitok = true
		this.id_master.resetupdate()
		this.im_menu.m_file.m_new.enabled = true
		this.editflag = false
		if gd_recenttransdate < this.id_systemdate then
			gd_recenttransdate = this.id_systemdate
		end if
	end if
	this.id_master.reset()
	this.id_detail.reset()
	setpointer(arrow!)

// w_deathcertificate.open() returns long [event]
	m_entry lm_menu
	long ll_width
	long ll_height
	environment env
	postevent("ue_postopen")
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	lm_menu.dynamic mf_initsecurityapp(lm_menu)
	if getenvironment(env) <> 1 then
		return ::message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.tab_retrieve.width = ll_width * 0.99
	this.tab_retrieve.height = ll_height * 0.83
	this.tab_retrieve.tabpage_detail.dw_detail.width = ll_width * 0.98
	this.tab_retrieve.tabpage_detail.dw_detail.height = ll_height * 0.80
	this.tab_retrieve.tabpage_list.gb_fliter.width = ll_width * 0.97 - this.tab_retrieve.tabpage_list.gb_sort.width
	this.tab_retrieve.tabpage_list.r_1.width = ll_width * 0.99
	this.tab_retrieve.tabpage_list.r_1.height = ll_height * 0.765 - this.tab_retrieve.tabpage_list.gb_sort.height
	this.tab_retrieve.tabpage_list.dw_list.width = ll_width * 0.98
	this.tab_retrieve.tabpage_list.dw_list.height = ll_height * 0.75 - this.tab_retrieve.tabpage_list.dw_list.y
	this.tab_retrieve.tabpage_detail.dw_itemslist.height = ll_height * 0.6
	this.tab_retrieve.tabpage_detail.dw_itemslist.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width * 0.73
	setredraw(true)
	return ::message.returnvalue

// w_deathcertificate.ue_postopen() returns 0 [event]
	call super::ue_postopen
	this.dw_print.settransobject(this.it_transobject)
	this.id_print = this.dw_print
	this.id_print.settransobject(this.it_transobject)

// w_deathcertificate.ue_print() returns 0 [event]
	long ll_code
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_code) or ll_code <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
		this.dw_print.settransobject(this.it_transobject)
		this.dw_print.retrieve(ll_code)
		if left(gs_company, 9) = "MUBARAKMC" then
			this.id_print.dataobject = "d_mubarakmc_deathcertificate_print"
		else
			this.id_print.dataobject = this.dw_print.dataobject
		end if
		this.id_print.settransobject(this.it_transobject)
		this.id_print.retrieve(ll_code)
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		if this.id_print.rowcount() > 0 then
			if this.id_print.print() < 0 then
				messagebox("Printing", "Can not Print Invoice", information!)
			end if
			return
		end if
		messagebox("Printing Error", "Can not Print Data,~r~nNo rows are retrieved", information!)
	end if

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_patientcode
	long ll_res
	long ll_found
	long ll_count
	integer li_null
	datetime ldt_date_null
	date ld_followupdate
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ldt_date_null)
	setnull(li_null)
	choose case dwo.name
	case "regno"
		if not isnull(data) and data <> "" then
			ll_res = parent.parent.parent.wf_findpatientcode(data, ll_patientcode)
			if ll_res > 0 then
				setitem(row, "patientcode", ll_patientcode)
				parent.parent.parent.wf_get_patient_info(ll_patientcode)
			else
				if ll_res = -2 then
					messagebox("Patient Validation", "Patient with  RegNo  " + data + " is Inactive")
				else
					messagebox("Patient Validation", "Patient with  RegNo  " + data + " does not exist")
				end if
				return 1
			end if
			return
		end if
	case "patientcode"
		if long(data) > 0 then
			parent.parent.parent.wf_get_patient_info(long(data))
		else
			messagebox("Patient Validation", "Patient does not exist or Already Inactive.")
			return 1
		end if
		return
	end choose
	return ::message.returnvalue

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf5! then
		parent.parent.parent.wf_patientsearch()
	end if
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	if parent.parent.parent.im_menu.m_file.m_save.enabled = true then
		if not parent.parent.parent.ib_focusdetail then
			parent.parent.parent.ib_focusdetail = true
		end if
		if parent.parent.parent.ib_itemslistopen then
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

