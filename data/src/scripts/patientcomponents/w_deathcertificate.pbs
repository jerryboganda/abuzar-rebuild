// dw_itemslist.uevent_dberr_message(long al_errorcode, string as_errortext, long al_row, dwbuffer adwb_buffer) returns 0 [event]

// dw_itemslist.uevent_dberr_reqmissing(dwbuffer adwb_buffer, long al_row) returns 0 [event]
