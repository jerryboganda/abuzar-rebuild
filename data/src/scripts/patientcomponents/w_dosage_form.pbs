// window w_dosage_form (patientcomponents)  ancestor: w_single_entry

// w_dosage_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM Dosage WHERE Dosage.name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_dosage_form.create() returns 0 [event]
	call super::create

// w_dosage_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_dosage_form.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_dosage_form.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "Dosage"
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "name"
		if parent.parent.parent.wf_duplicatename(data) then
			messagebox("Name Validation", "Duplication Name Error~n~rPlease Choose Some Other Name")
			return 1
		end if
	end choose
	return ::message.returnvalue

// dw_detail.sqlpreview(sqlpreviewfunction request, sqlpreviewtype sqltype, string sqlsyntax, dwbuffer buffer, long row) returns long [event]
	long ancestorreturnvalue
	string ls_sql
	string ls_newsql
	string ls_sql_part
	long ll_pos
	long ll_commacount
	long ll_commapos
	ancestorreturnvalue = super::sqlpreview(request, sqltype, sqlsyntax, buffer, row)
	if sqltype = previewupdate! then
		ls_sql = sqlsyntax
		ll_pos = pos(lower(ls_sql), "localdosage = ", 1)
		if ll_pos > 0 then
			ls_newsql = mid(ls_sql, 1, ll_pos - 1) + "localdosage = N" + mid(ls_sql, ll_pos + 14)
		else
			ls_newsql = ls_sql
		end if
		setsqlpreview(ls_newsql)
	elseif sqltype = previewinsert! then
		ls_sql = sqlsyntax
		ls_sql_part = "'" + getitemstring(getrow(), "localdosage") + "'"
		ll_pos = pos(lower(ls_sql), ls_sql_part, 1)
		if ll_pos > 0 then
			ls_newsql = replace(ls_sql, ll_pos, len(ls_sql_part), "N" + ls_sql_part)
		else
			ls_newsql = ls_sql
		end if
		setsqlpreview(ls_newsql)
	end if
	return 0

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	choose case dwo.name
	case "localdosage"
		f_set_keyboard_local()
	case else
		f_set_keyboard_english()
	end choose
	return ::message.returnvalue
