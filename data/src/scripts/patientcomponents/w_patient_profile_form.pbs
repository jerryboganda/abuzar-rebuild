// window w_patient_profile_form (patientcomponents)  ancestor: w_single_entry

// w_patient_profile_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM ItemClass WHERE ItemClass.name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_patient_profile_form.wf_duplicateregno(string as_name) returns boolean
	long ll_count
	long ll_patientcode
	boolean b_flag
	as_name = trim(as_name)
	ll_patientcode = this.id_detail.object.code[this.id_detail.rowcount()]
	if isnull(ll_patientcode) then
		SQL SELECT count ( *) INTO :ll_count FROM Patient WHERE patient.regno =:as_name USING sqlca;
	else
		SQL SELECT count ( *) INTO :ll_count FROM Patient WHERE patient.regno =:as_name AND Patient.PatientCode <> :ll_patientcode USING sqlca;
	end if
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_patient_profile_form.wf_admitted(long al_patientcode) returns long
	long ll_count
	SQL SELECT Count ( *) INTO :ll_count FROM PatientAdmission WHERE PatientAdmission.PatientCode =:al_patientcode AND PatientAdmission.Discharged ='N' USING sqlca;
	return ll_count

// w_patient_profile_form.wf_locationoccupied(long al_locationcode) returns long
	long ll_retcode
	SQL SELECT COUNT ( *) INTO :ll_retcode FROM ( SELECT LocationCode FROM PatientAdmission WHERE Discharged ='N' AND AdmissionCode NOT IN ( SELECT DISTINCT AdmissionCode FROM PatientTransfer ) UNION ALL SELECT LocationCode =TargetLocation FROM PatientTransfer WHERE TransferCode IN ( SELECT TransferCode =Max ( TransferCode ) FROM PatientTransfer WHERE AdmissionCode IN ( SELECT DISTINCT AdmissionCode FROM PatientAdmission WHERE Discharged ='N' ) GROUP BY AdmissionCode ) ) A WHERE LocationCode =:al_locationcode USING sqlca;
	return ll_retcode

// w_patient_profile_form.wf_retrieve() returns long
	long rtcode
	rtcode = this.id_dwcontrol.retrieve(18)
	return rtcode

// w_patient_profile_form.create() returns 0 [event]
	call super::create

// w_patient_profile_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_patient_profile_form.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_patient_profile_form.open() returns long [event]
	long ancestorreturnvalue
	integer li_rtncode
	ancestorreturnvalue = super::open()
	li_rtncode = this.id_detail.getchild("patientcatcode", this.idc_patientcat)
	if li_rtncode = -1 then
		messagebox("Patient Profile Error", "Problem in Retrieving Patient Category List")
		close(this)
		return ::message.returnvalue
	end if
	this.idc_patientcat.settransobject(sqlca)
	li_rtncode = this.idc_patientcat.retrieve(18)
	if li_rtncode <= 0 then
		messagebox("Patient Profile", "Not Enough Patient Categories Allowed, Please contact your system administrator")
		close(this)
		return ::message.returnvalue
	else
		this.id_detail.object.patientcatcode.initial = string(this.idc_patientcat.getitemnumber(1, "patientcatcode"))
	end if
	this.is_tablename = "patient"
	this.id_print.dataobject = "d_patientregisteration_print"
	this.id_print.settransobject(sqlca)
	return ::message.returnvalue

// w_patient_profile_form.ue_save() returns 0 [event]
	long ll_primarykey
	long ll_row
	long ll_primarykey2
	long ll_totrows
	long ll_rowcounter
	long ll_usercode
	long ll_found
	long ll_null
	long ll_primarycode_old
	long ll_new_pat_reg
	integer li_patientcatcode
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_regno
	string ls_patientcode
	string ls_errtext
	boolean lb_commit
	dwitemstatus ldw_active
	setnull(ll_null)
	setpointer(hourglass!)
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	ll_row = this.id_detail.getrow()
	ll_primarykey = this.id_detail.object.code[this.id_detail.getrow()]
	ll_primarycode_old = ll_primarykey
	if isnull(ll_primarykey) and not f_rightexists(5024) then
		messagebox("Problem Saving", "You do not have the Right to enter New Patient~r~nPlease ask system administrator to do the needfull.")
		this.id_detail.setfocus()
		this.id_detail.setcolumn("regno")
		return
	end if
	if ll_primarykey > 0 and not f_rightexists(5025) then
		messagebox("Problem Saving", "You do not have the Right to modify Patient Record~r~nPlease ask system administrator to do the needfull.")
		this.id_detail.setfocus()
		this.id_detail.setcolumn("regno")
		return
	end if
	if f_stringpreferences("AutoGeneratePatientRegNo") = "N" and wf_duplicateregno(this.id_detail.object.regno[ll_row]) then
		messagebox("Patient Profile Problem Saving", "Duplicate Patient Reg. No.~r~nPlease give some other Reg. No.")
		this.id_detail.setfocus()
		this.id_detail.setcolumn("regno")
		return
	end if
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	this.id_detail.object.date[ll_row] = ldt_server_datetime
	ldw_active = this.id_detail.getitemstatus(ll_row, "active", primary!)
	if not isnull(ll_primarykey) and this.id_detail.object.active[ll_row] = "Y" and ldw_active = datamodified! then
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 608", 1, gds_securitywindow.rowcount())
		if ll_found <= 0 then
			messagebox("Patient Profile", "You do not have sufficient rights mark patient as active~r~nPlease contact your system administrator to do the needfull", stopsign!)
			return
		end if
		return
	end if
	if isnull(ll_primarykey) then
		ll_new_pat_reg = 1
	else
		ll_new_pat_reg = 0
	end if
	if f_stringpreferences("askuserpwdinpatientreg") = "Y" then
		open(w_salesmanpassword)
		ll_usercode = long(message.doubleparm)
		setfocus()
	else
		ll_usercode = gl_usercode
	end if
	if ll_usercode > 0 then
		if isnull(ll_primarykey) then
			ll_primarykey = 0
			SQL rollback USING sqlca;
			sqlca.gettabmaxkey(this.is_tablename, ll_primarykey)
			if sqlca.sqlcode = 0 then
				this.id_detail.setitem(ll_row, "code", ll_primarykey)
				this.id_detail.object.originaldate[ll_row] = ldt_server_datetime
				this.id_detail.object.createdby[ll_row] = ll_usercode
				li_patientcatcode = this.id_detail.object.patientcatcode[ll_row]
				if isnull(this.id_detail.getitemstring(1, "membershipid")) then
					this.id_detail.setitem(this.id_detail.getrow(), "membershipid", string(ll_primarykey))
				end if
				if f_stringpreferences("AutoGeneratePatientRegNo") = "Y" then
					if sqlca.autogeneratepatientregno(li_patientcatcode, ls_regno) = 0 then
						this.id_detail.object.regno[ll_row] = ls_regno
					else
						SQL rollback USING sqlca;
						lb_commit = false
						this.id_detail.setitem(ll_row, "code", ll_null)
						messagebox("Patient Profile Problem", "Problem in Auto Generation of Patient Reg. No.~r~n Possibe Reason: " + sqlca.sqlerrtext)
					end if
				end if
			else
				SQL rollback USING sqlca;
				lb_commit = false
				this.id_detail.setitem(ll_row, "code", ll_null)
				messagebox("Patient Profile Problem", "Problem in Auto Generation of Patient Reg. No.~r~n Possibe Reason: " + sqlca.sqlerrtext)
			end if
		end if
		if lb_commit then
			if this.id_detail.object.active[ll_row] = "N" and (ldw_active = datamodified! or ldw_active = newmodified!) then
				this.id_detail.object.inactivedate[ll_row] = ldt_server_datetime
				this.id_detail.object.inactivedby[ll_row] = ll_usercode
			end if
			this.id_detail.setitem(ll_row, "usercode", ll_usercode)
			if this.id_detail.update() > 0 then
				SQL commit USING sqlca;
				messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
				this.ib_commitok = true
				this.im_menu.m_file.m_new.enabled = true
				this.editflag = false
				if ll_new_pat_reg = 1 then
					ls_patientcode = trim(string(ll_primarykey))
					this.it_transobject.createautotriggersms(ls_patientcode, 14, "Saving")
					if this.it_transobject.sqlcode <> 0 then
						ls_errtext = "Problem in Generating Auto Triggered SMS.~r~nReasons are:- " + this.it_transobject.sqlerrtext
						SQL rollback USING this.it_transobject;
						messagebox("Auto Triggered SMS", ls_errtext)
					else
						SQL commit USING this.it_transobject;
					end if
				end if
			else
				SQL rollback USING sqlca;
				setpointer(arrow!)
				messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs", exclamation!, ok!, 1)
			end if
		end if
	end if
	if isnull(ll_primarycode_old) then
		this.id_detail.setitem(ll_row, "code", ll_null)
	end if
	setpointer(arrow!)

// w_patient_profile_form.ue_detail() returns 0 [event]
	call super::ue_detail
	this.id_detail.object.active.protect = 0
	this.im_menu.m_file.m_print.enabled = true

// w_patient_profile_form.ue_newform() returns 0 [event]
	call super::ue_newform
	this.id_detail.object.regno.protect = 0
	this.id_detail.object.active.protect = 1
	if f_stringpreferences("AutoGeneratePatientRegNo") = "Y" then
		this.id_detail.object.regno.edit.displayonly = "yes"
		this.id_detail.object.regno.edit.required = "no"
		this.id_detail.setcolumn("name")
	end if

// w_patient_profile_form.ue_print() returns 0 [event]
	long ll_code
	long ll_row
	long li_printretcode
	string ls_printsize
	boolean lb_listtab
	s_datastore lstr
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_code) or ll_code <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_code = this.id_detail.getitemnumber(1, "code")
	end if
	this.id_print.retrieve(ll_code)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.id_print.rowcount() > 0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		li_printretcode = this.id_print.print()
		if li_printretcode < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print,~r~nNo rows are retrieved", information!)

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_null
	long ll_totdays
	long ll_years
	long ll_months
	long ll_days
	datetime ldt_date_null
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ldt_date_null)
	setnull(li_null)
	choose case dwo.name
	case "active"
		if upper(data) = "Y" then
			this.object.inactivedate[row] = ldt_date_null
			this.object.inactivedby[row] = li_null
		end if
	case "regno"
		if parent.parent.parent.wf_duplicateregno(data) then
			return 1
		end if
	case "dob"
		if isdate(string(date(left(data, 10)))) then
			ll_totdays = daysafter(date(string(date(left(data, 10)))), today())
			ll_years = ll_totdays / 365.0
			ll_months = ll_totdays mod 365 / 30.0
			ll_days = ll_totdays mod 365 mod 30
			setitem(row, "ageyears", ll_years)
			setitem(row, "agemonths", ll_months)
			setitem(row, "agedays", ll_days)
		else
			return 1
		end if
	case "ageyears"
		ll_years = long(data)
		if isnull(ll_years) then
			ll_years = 0
		end if
		ll_months = this.object.agemonths[row]
		if isnull(ll_months) then
			ll_months = 0
		end if
		ll_days = this.object.agedays[row]
		if isnull(ll_days) then
			ll_days = 0
		end if
		ll_totdays = ll_years * 365 + ll_months * 30 + ll_days
		if ll_totdays >= 0 then
			setitem(row, "dob", relativedate(today(), -ll_totdays))
		else
			return 1
		end if
	case "agemonths"
		ll_years = this.object.ageyears[row]
		if isnull(ll_years) then
			ll_years = 0
		end if
		ll_months = long(data)
		if isnull(ll_months) then
			ll_months = 0
		end if
		ll_days = this.object.agedays[row]
		if isnull(ll_days) then
			ll_days = 0
		end if
		ll_totdays = ll_years * 365 + ll_months * 30 + ll_days
		if ll_totdays >= 0 then
			setitem(row, "dob", relativedate(today(), -ll_totdays))
		else
			return 1
		end if
	case "agedays"
		ll_years = this.object.ageyears[row]
		if isnull(ll_years) then
			ll_years = 0
		end if
		ll_months = this.object.agemonths[row]
		if isnull(ll_months) then
			ll_months = 0
		end if
		ll_days = long(data)
		if isnull(ll_days) then
			ll_days = 0
		end if
		ll_totdays = ll_years * 365 + ll_months * 30 + ll_days
		if ll_totdays >= 0 then
			setitem(row, "dob", relativedate(today(), -ll_totdays))
		else
			return 1
		end if
	case "recurringperiod"
		if long(data) < 0 then
			return 1
		end if
	case "admit"
		if long(data) = 1 then
			this.object.admissioncode_t.visible = true
			this.object.admissioncode.visible = true
			this.object.locationcode_t.visible = true
			this.object.locationcode.visible = true
			this.object.doctorcode_t.visible = true
			this.object.doctorcode.visible = true
			this.object.diseasecode_t.visible = true
			this.object.diseasecode.visible = true
			this.object.diagnosis_t.visible = true
			this.object.diagnosis.visible = true
		else
			this.object.admissioncode_t.visible = false
			this.object.admissioncode.visible = false
			this.object.locationcode_t.visible = false
			this.object.locationcode.visible = false
			this.object.doctorcode_t.visible = false
			this.object.doctorcode.visible = false
			this.object.diseasecode_t.visible = false
			this.object.diseasecode.visible = false
			this.object.diagnosis_t.visible = false
			this.object.diagnosis.visible = false
		end if
	end choose
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "regno"
		messagebox("ItemNo Validation", "Item Duplication Error~r~nPlease enter some other Reg No")
	case "dob"
		messagebox("Birth Date Validation", "Please enter some valid date")
	case "age"
		messagebox("Age Validation", "Please enter some valid age in years")
	end choose
	return 1
