// window w_gestation_form (patientcomponents)  ancestor: w_single_entry

// w_gestation_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM Gestation WHERE Gestation.name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_gestation_form.create() returns 0 [event]
	call super::create

// w_gestation_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_gestation_form.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_gestation_form.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "Gestation"
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "name"
		if parent.parent.parent.wf_duplicatename(data) then
			messagebox("Name Validation", "Duplication Name Error~n~rPlease Choose Some Other Name")
			return 1
		end if
	end choose
	return ::message.returnvalue
