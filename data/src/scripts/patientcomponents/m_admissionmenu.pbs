// menu m_admissionmenu (patientcomponents)  ancestor: m_multi_entry

// m_admissionmenu.create() returns 0 [event]
	m_admissionmenu = this
	call super::create
	this.text = "m_admissionmenu"

// m_admissionmenu.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_registerpatient = create m_registerpatient
	this.m_populateservicetemplate = create m_populateservicetemplate
	this.m_populateaservicetemplate = create m_populateaservicetemplate
	this.m_showinpatientbill = create m_showinpatientbill
	this.m_diseasetypefilter = create m_diseasetypefilter
	this.m_showpatientinfo = create m_showpatientinfo
	this.m_patientsearch = create m_patientsearch
	this.item[upperbound(this.item) + 1] = this.m_registerpatient
	this.item[upperbound(this.item) + 1] = this.m_populateservicetemplate
	this.item[upperbound(this.item) + 1] = this.m_populateaservicetemplate
	this.item[upperbound(this.item) + 1] = this.m_showinpatientbill
	this.item[upperbound(this.item) + 1] = this.m_diseasetypefilter
	this.item[upperbound(this.item) + 1] = this.m_showpatientinfo
	this.item[upperbound(this.item) + 1] = this.m_patientsearch

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_registerpatient
	destroy this.m_populateservicetemplate
	destroy this.m_populateaservicetemplate
	destroy this.m_showinpatientbill
	destroy this.m_diseasetypefilter
	destroy this.m_showpatientinfo
	destroy this.m_patientsearch

