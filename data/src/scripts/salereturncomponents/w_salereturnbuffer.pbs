// window w_salereturnbuffer (salereturncomponents)  ancestor: w_multi_entry

// w_salereturnbuffer.ue_accepttext() returns 0 [event]
	if this.id_detail.accepttext() = -1 then
		this.id_detail.setfocus()
	end if

// w_salereturnbuffer.ue_save_withnocommit() returns long [event]
	setpointer(hourglass!)
	if f_validatedw(this.id_master) < 0 then
		return -1
	end if
	if f_validatedw(this.id_detail) < 0 then
		return -2
	end if
	if this.id_master.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -3
	end if
	if this.id_detail.update() < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -4
	end if
	setpointer(arrow!)
	return 0

// w_salereturnbuffer.ue_populate_purreturn_from_datacarrydb() returns 0 [event]
	long ll_icode
	long ll_row
	long ll_prinvcode
	long ll_counter
	long ll_datacarrycustcode
	long ll_lastsrinvcode
	boolean retflag = true
	double ld_srprice
	double ld_prprice
	double ld_discperc
	double ld_itemflatdisc
	double ld_saleprice
	double ld_avgprice
	double ld_packsalestax
	double ld_gstperc
	double ld_rpp
	double ld_unitsalestax
	double ld_itempurprice
	double ld_rate
	double ld_rpp2
	double ld_rpp3
	double ld_rpp4
	double ld_rpp5
	double ld_invdiscperc
	double ld_invflatdisc
	double ld_invmisccharges
	double ld_invgstperc1
	double ld_packcapacity
	double ld_areavolume
	long ll_packunits
	long ll_gcode
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_batch
	string ls_itemtotalval
	string ls_packingdesc
	string ls_errortext
	string ls_error_syntax
	string ls_connsetting = "Set ANSI_NULLS ON Set ANSI_WARNINGS ON"
	string ls_prledgerquery
	string ls_prdetailquery
	string ls_newsyntax
	string ls_aliasname
	datetime ldt_expiry
	datastore lds_prledger
	datastore lds_prdetail
	s_arguements lstr_arguments
	u_transaction lt_transobject
	double ld_godownstock
	double ld_allgodownstock
	double ld_qty
	double ld_bonusqty
	if wf_iseditable() = false then
		return
	end if
	if this.id_master.object.saleinvcode[1] > 0 then
		return
	end if
	open(w_populate_purreturn_from_datacarrydb)
	lstr_arguments = message.powerobjectparm
	if lstr_arguments.i_status <= 0 then
		return
	end if
	ll_prinvcode = lstr_arguments.l_code1
	lt_transobject = create u_transaction
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Problem", "Unable to connect to database.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		return
	end if
	SQL EXECUTE IMMEDIATE :ls_connsetting USING lt_transobject;
	if lstr_arguments.i_supress = true and f_datatransfer_in_dest(lt_transobject) <= 0 then
		SQL stop USING lt_transobject;
		return
	end if
	if ll_prinvcode > 0 then
		setpointer(hourglass!)
		lds_prledger = create datastore
		lds_prdetail = create datastore
		ls_prledgerquery = "Select ~tPRInvCode, Date, Remarks, DiscPerc, FlatDisc, MiscCharges, Posted, PostDate, InvGSTPerc1, InvTotal, CustCode, DataCarryCustCode " + "From ~t" + gs_inlinkserver + "." + gs_inlinkserverdb + "." + gs_inlinkserverowner + "." + "PRLedger " + "Where   PRInvcode = " + string(ll_prinvcode)
		ls_prdetailquery = "Select  PRInvCode, ICode, Batch, Expiry, LooseQty, BonusQty, PackUnits, PRPrice, DiscPerc, PackSalePrice, UnitSalesTax, GSTPerc, PrUtn " + "From ~t" + gs_inlinkserver + "." + gs_inlinkserverdb + "." + gs_inlinkserverowner + "." + "PRDetail " + "Where ~tPRInvCode = " + string(ll_prinvcode) + " Order By PrUtn "
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_prledgerquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For Purchase Return Ledger DataStore")
			return
		else
			ls_error_syntax = ""
			lds_prledger.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For Purchase Return Ledger DataStore")
				return
			end if
		end if
		lds_prledger.settransobject(lt_transobject)
		if lds_prledger.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source Purchase Return Ledger.")
			return
		end if
		ll_datacarrycustcode = lds_prledger.getitemnumber(lds_prledger.getrow(), "DataCarryCustCode")
		ll_prinvcode = lds_prledger.getitemnumber(lds_prledger.getrow(), "PRInvCode")
		if ll_datacarrycustcode > 0 and ll_prinvcode > 0 then
			SQL SELECT ISNULL ( Max ( SRInvCode ) , 0 ) INTO :ll_lastsrinvcode FROM SRLedger WHERE CustRefNo IN ( SELECT AliasName + '-' + LTRIM ( RTRIM ( STR ( :ll_prinvcode , 10 ) ) ) AS RefNo FROM Accounts WHERE AccCode =:ll_datacarrycustcode ) USING lt_transobject;
			if lt_transobject.sqlcode = 0 then
				if isnull(ll_lastsrinvcode) or ll_lastsrinvcode < 0 then
					ll_lastsrinvcode = 0
				end if
				if ll_lastsrinvcode > 0 then
					SQL stop USING lt_transobject;
					messagebox("Population Restriction", "Purchase Return Already Populated as Sales Return Invoice No. : " + trim(string(ll_lastsrinvcode)), stopsign!)
					return
				end if
			else
				SQL stop USING lt_transobject;
				messagebox("Fetch Error", "Unable to fetch any data from source Purchase Return Ledger DataCarryDB.")
				return
			end if
			return
		end if
		ls_newsyntax = ""
		ls_error_syntax = ""
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_prdetailquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For Purchase Return Detail DataStore")
			return
		else
			ls_error_syntax = ""
			lds_prdetail.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For Purchase Return Detail DataStore")
				return
			end if
		end if
		lds_prdetail.settransobject(lt_transobject)
		if lds_prdetail.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source Purchase Return Detail.")
			return
		end if
		ld_invdiscperc = lds_prledger.getitemnumber(lds_prledger.getrow(), "discperc")
		ld_invflatdisc = lds_prledger.getitemnumber(lds_prledger.getrow(), "flatdisc")
		ld_invmisccharges = lds_prledger.getitemnumber(lds_prledger.getrow(), "misccharges")
		ld_invgstperc1 = lds_prledger.getitemnumber(lds_prledger.getrow(), "invgstperc1")
		if ll_datacarrycustcode > 0 then
			this.id_master.setitem(1, "custcode", ll_datacarrycustcode)
			wf_customerinfo(ll_datacarrycustcode)
			ls_aliasname = this.id_master.object.aliasname[1]
			if isnull(ls_aliasname) then
				ls_aliasname = ""
			end if
			this.id_master.setitem(1, "custrefno", ls_aliasname + "-" + trim(string(ll_prinvcode)))
		end if
		this.id_footer.setitem(1, "discperc", ld_invdiscperc)
		this.id_footer.setitem(1, "flatdisc", ld_invflatdisc)
		this.id_footer.setitem(1, "misccharges", ld_invmisccharges)
		this.id_footer.setitem(1, "invgstperc1", ld_invgstperc1)
		for ll_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		ll_gcode = this.ii_salegodown
		for ll_counter = 1 to lds_prdetail.rowcount()
			ll_row = this.id_detail.insertrow(0)
			ll_packunits = lds_prdetail.getitemnumber(ll_counter, "packunits")
			if ll_packunits < 1 or isnull(ll_packunits) then
				ll_packunits = 1
			end if
			ll_icode = lds_prdetail.getitemnumber(ll_counter, "icode")
			wf_inititeminfo(ll_icode, ll_row, ls_errortext)
			ld_qty = lds_prdetail.getitemnumber(ll_counter, "looseqty")
			ld_bonusqty = lds_prdetail.getitemnumber(ll_counter, "bonusqty")
			ld_srprice = lds_prdetail.getitemnumber(ll_counter, "PRPrice")
			ld_discperc = lds_prdetail.getitemnumber(ll_counter, "discperc")
			ld_itemflatdisc = 0
			ld_unitsalestax = lds_prdetail.getitemnumber(ll_counter, "unitsalestax")
			ld_gstperc = lds_prdetail.getitemnumber(ll_counter, "gstperc")
			ls_batch = lds_prdetail.getitemstring(ll_counter, "batch")
			ldt_expiry = lds_prdetail.getitemdatetime(ll_counter, "expiry")
			SQL SELECT item.customicode , item.name , item.gcode , item.purprice , item.packsalestax , item.saleprice , item.avgprice INTO :ls_fullcode, :ls_name, :li_gcode, :ld_itempurprice, :ld_packsalestax, :ld_saleprice, :ld_avgprice FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = -1 then
				retflag = false
				ls_errortext = "Database Error: Item information can not be retrieved.~r~nReasons:" + this.it_transobject.sqlerrtext
				messagebox("Item Validation", ls_errortext)
			end if
			if ll_packunits < 1 or isnull(ll_packunits) then
				ll_packunits = 1
			end if
			this.it_transobject.getitemstocktotal(this.ii_salegodown, ll_icode, ld_godownstock)
			this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
			if this.it_transobject.sqlcode = -1 then
				retflag = false
				ls_errortext = "Database Error: Item Stock information can not be retrieved"
			end if
			this.id_detail.setitem(ll_row, "gcode", ll_gcode)
			this.id_detail.setitem(ll_row, "icode", ll_icode)
			this.id_detail.setitem(ll_row, this.is_columnitemname, ls_name)
			this.id_detail.setitem(ll_row, "fullcode", ls_fullcode)
			this.id_detail.setitem(ll_row, "packunits", ll_packunits)
			this.id_detail.setitem(ll_row, "looseqty", ld_qty)
			this.id_detail.setitem(ll_row, "discperc", ld_discperc)
			this.id_detail.setitem(ll_row, "srprice", ld_srprice)
			this.id_detail.setitem(ll_row, "avgprice", ld_avgprice)
			this.id_detail.setitem(ll_row, "saleprice", ld_saleprice / ll_packunits)
			this.id_detail.setitem(ll_row, "stock", ld_godownstock)
			this.id_detail.setitem(ll_row, "totalstock", ld_allgodownstock)
			this.id_detail.setitem(ll_row, "batch", ls_batch)
			this.id_detail.setitem(ll_row, "expiry", ldt_expiry)
			this.id_detail.setitem(ll_row, "bonusqty", ld_bonusqty)
			this.id_detail.setitem(ll_row, "unitsalestax", ld_unitsalestax)
			this.id_detail.setitem(ll_row, "gstperc", ld_gstperc)
			ld_packcapacity = this.id_detail.object.packcapacity[ll_row]
			ld_areavolume = this.id_detail.object.areavolume[ll_row]
			if ld_areavolume > 0.0 then
				this.id_detail.setitem(ll_row, "pcs", round(this.id_detail.object.looseqty[ll_row] / this.id_detail.object.areavolume[ll_row], 6))
			else
				this.id_detail.setitem(ll_row, "pcs", round(this.id_detail.object.looseqty[ll_row] / 1, 6))
			end if
			if ld_packcapacity > 0.0 then
				this.id_detail.setitem(ll_row, "cartons", trim(string(long(this.id_detail.object.pcs[ll_row] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[ll_row] mod ld_packcapacity, 2))))))
			else
				this.id_detail.setitem(ll_row, "cartons", trim(string(long(this.id_detail.object.pcs[ll_row] / 1))) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[ll_row] mod ld_packcapacity, 2))))))
			end if
			this.id_footer.setitem(1, "stock", ld_godownstock)
		next
		if this.id_detail.rowcount() > 0 then
			this.im_menu.m_file.m_save.enabled = true
			wf_grandtotal()
		else
			this.im_menu.m_file.m_save.enabled = false
		end if
	end if
	SQL stop USING lt_transobject;

// w_salereturnbuffer.wf_visibleinvisiblediscount() returns integer
	this.id_detail.object.discperc.visible = 0
	return 1

// w_salereturnbuffer.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	long iccode
	long icatcode
	long packcode
	long manfcode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_salereturnbuffer.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to 1 step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_salereturnbuffer.wf_setfooterinfo(long al_saleinvcode) returns 0
	double ld_discperc
	double ld_flatdisc
	double ld_misccharges
	double ld_invgstperc1
	double ld_fbrposfee
	long ll_returncount
	SQL SELECT saleledger.discperc , saleledger.flatdisc , saleledger.misccharges , saleledger.InvGSTperc1 , saleledger.FBRPOSFee , ReturnCount =ISNULL ( ( SELECT COUNT ( SaleInvCode ) FROM SRLedger WHERE SaleInvCode =:al_saleinvcode ) , 0 ) INTO :ld_discperc, :ld_flatdisc, :ld_misccharges, :ld_invgstperc1, :ld_fbrposfee, :ll_returncount FROM saleledger WHERE saleledger.saleinvcode =:al_saleinvcode USING sqlca;
	if ll_returncount = 0 then
		this.id_footer.setitem(1, "discperc", ld_discperc)
		this.id_footer.setitem(1, "flatdisc", ld_flatdisc)
		this.id_footer.setitem(1, "InvGSTperc1", ld_invgstperc1)
		if f_stringpreferences("FetchFBRPosFeeForRefSR") = "Y" then
			this.id_footer.setitem(1, "misccharges", ld_misccharges)
			this.id_footer.setitem(1, "FBRPOSFee", ld_fbrposfee)
			return
		end if
		if ld_misccharges >= 1.0 and ld_fbrposfee > 0.0 then
			ld_misccharges = ld_misccharges - 1.0
			this.id_footer.setitem(1, "misccharges", ld_misccharges)
		else
			this.id_footer.setitem(1, "misccharges", ld_misccharges)
		end if
		if ld_fbrposfee > 0.0 then
			ld_fbrposfee = 0
			this.id_footer.setitem(1, "FBRPOSFee", ld_fbrposfee)
		end if
	end if

// w_salereturnbuffer.wf_visible(boolean ab_flag) returns 0
	if not this.ib_opensalereturn then
		this.id_footer.object.retableqty.visible = ab_flag
		this.id_footer.object.t_retableqty.visible = ab_flag
		this.id_footer.object.saleqty.visible = ab_flag
		this.id_footer.object.t_saleqty.visible = ab_flag
		this.id_footer.object.retablebonusqty.visible = ab_flag
		this.id_footer.object.t_retablebonusqty.visible = ab_flag
		this.id_footer.object.salebonusqty.visible = ab_flag
		this.id_footer.object.t_salebonusqty.visible = ab_flag
	end if

// w_salereturnbuffer.wf_retrievelistall() returns long
	string[] ls_posted
	integer li_saleretcategory
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_salerettype = 1 then
		li_saleretcategory = this.ii_saleretcategory
	else
		li_saleretcategory = this.ii_salerettype
	end if
	return this.id_list.retrieve(li_saleretcategory, ls_posted, this.il_groupcode, this.ii_module)

// w_salereturnbuffer.wf_duplicaterow(long al_currrow) returns boolean
	boolean lb_duplicate
	string ls_batch
	datetime ld_expiry
	long ll_gcode
	long ll_icode
	ls_batch = this.id_detail.getitemstring(al_currrow, "batch")
	ld_expiry = this.id_detail.getitemdatetime(al_currrow, "expiry")
	ll_gcode = this.id_detail.getitemnumber(al_currrow, "gcode")
	ll_icode = this.id_detail.getitemnumber(al_currrow, "icode")
	if not isnull(ll_gcode) and not isnull(ll_icode) and not isnull(ls_batch) and not isnull(ld_expiry) and vf_dwdupcodebatch(this.id_detail, "gcode", ll_gcode, "icode", ll_icode, "batch", ls_batch, "expiry", ld_expiry, al_currrow) then
		lb_duplicate = true
	end if
	return lb_duplicate

// w_salereturnbuffer.wf_findcustcode(string as_aliasname, integer ai_custcode) returns integer
	integer li_custcode
	integer ll_retflag
	string ls_itemname
	SQL SELECT accounts.acccode INTO :li_custcode FROM accounts , customer WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =customer.custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_custcode = li_custcode
		if isnull(ai_custcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_salereturnbuffer.wf_findregno(long al_patientcode) returns string
	string ls_regno
	SQL SELECT regno INTO :ls_regno FROM Patient WHERE PatientCode =:al_patientcode USING this.it_transobject;
	return ls_regno

// w_salereturnbuffer.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_invtaxpercval
	double ld_totaltax
	double ld_itemleveltax
	double ld_invtaxperc1
	double lr_discperc
	double lr_flatdisc
	double ld_misccharges
	double lr_salestax
	double lr_itemstotal
	double ld_advincometax
	integer li_roundupto
	li_roundupto = f_numberpreferences("roundsalereturninvon")
	if isnull(li_roundupto) or li_roundupto < 0 then
		li_roundupto = 0
	end if
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		lr_discperc = this.id_footer.object.discperc[1]
		lr_flatdisc = this.id_footer.object.flatdisc[1]
		ld_misccharges = this.id_footer.object.misccharges[1]
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
		ld_invtaxperc1 = this.id_footer.object.invgstperc1[1]
		ld_invtaxpercval = round(ld_detaildwtotal * ld_invtaxperc1 * 0.01, 2)
		ld_itemleveltax = this.id_detail.getitemnumber(1, "c_sumgstval") + this.id_detail.getitemnumber(1, "c_sumtaxval")
		ld_totaltax = round(ld_invtaxpercval + ld_itemleveltax, li_roundupto)
		ld_advincometax = this.id_detail.getitemnumber(1, "c_totadvancetax")
		if this.ic_advancetaxonsale = "Y" then
			this.id_footer.object.misccharges[1] = ld_advincometax
			this.id_footer.object.advancetaxamt[1] = ld_advincometax
		else
			ld_misccharges = this.id_footer.object.misccharges[1]
			this.id_footer.object.advancetaxamt[1] = 0.00
		end if
		if this.ic_autofiscalize = "Y" and this.ic_fbrposfee = "Y" then
			if this.id_footer.object.misccharges[1] = this.id_footer.object.advancetaxamt[1] + this.id_footer.object.fbrposfee[1] then
				this.id_footer.object.misccharges[1] = this.id_footer.object.advancetaxamt[1] + this.id_footer.object.fbrposfee[1]
			elseif this.id_footer.object.misccharges[1] > this.id_footer.object.advancetaxamt[1] + this.id_footer.object.fbrposfee[1] then
				this.id_footer.object.misccharges[1] = this.id_footer.object.advancetaxamt[1] + this.id_footer.object.fbrposfee[1] + (this.id_footer.object.misccharges[1] - this.id_footer.object.advancetaxamt[1] - this.id_footer.object.fbrposfee[1])
			else
				this.id_footer.object.misccharges[1] = this.id_footer.object.misccharges[1]
			end if
		else
			ld_misccharges = this.id_footer.object.misccharges[1]
		end if
		ld_misccharges = this.id_footer.object.misccharges[1]
		ld_grandtotal = ld_detaildwtotal * (1.0 - lr_discperc * 0.01) - lr_flatdisc + ld_misccharges + lr_salestax
		ld_grandtotal = round(ld_grandtotal, li_roundupto) + ld_totaltax
		this.id_footer.setitem(1, "total", ld_grandtotal)
	end if
	return ld_grandtotal

// w_salereturnbuffer.wf_locksaleinvoice(long al_saleinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From saleledger WITH ( UPDLOCK HOLDLOCK ) Where saleledger.saleinvcode =:al_saleinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_salereturnbuffer.wf_returnsaleretinvoice() returns integer
	return 1

// w_salereturnbuffer.wf_setsalereturntype(integer ai_salerettype, boolean ab_opensaleret) returns 0
	this.ii_salerettype = ai_salerettype
	this.ib_opensalereturn = ab_opensaleret

// w_salereturnbuffer.wf_updatesalereturnitemsstock(long al_saleretinvcode, string as_errtext, long al_errrow) returns integer
	long ll_detailrows
	long ll_gcode
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode = 1
	long li_counter
	long li_innercounter
	long ll_row
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	string ls_batch
	datetime ld_expiry
	integer li_errcode
	double ld_stock
	double ld_newstock
	double ld_saleretqty
	double ld_saleretbonusqty
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	as_errtext = "    Some database problem ocuurs         "
	do while li_counter <= ll_detailrows and li_errcode = 0
		ll_gcode = this.id_detail.getitemnumber(li_counter, "gcode")
		ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
		ld_saleretqty = this.id_detail.getitemnumber(li_counter, "looseqty")
		ll_packunits = this.id_detail.getitemnumber(li_counter, "packunits")
		ld_saleprice = this.id_detail.getitemnumber(li_counter, "saleprice")
		ld_discperc = this.id_detail.getitemnumber(li_counter, "discperc")
		ls_batch = this.id_detail.getitemstring(li_counter, "batch")
		ld_expiry = this.id_detail.getitemdatetime(li_counter, "expiry")
		ld_stock = this.id_detail.getitemnumber(li_counter, "stock")
		ld_saleretbonusqty = this.id_detail.getitemnumber(li_counter, "bonusqty")
		this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
			if this.it_transobject.sqlcode = 0 then
				ld_newstock = ld_stock + ld_saleretqty + ld_saleretbonusqty
				this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
				if this.it_transobject.sqlcode <> 0 then
					li_errcode = -1
				end if
			else
				li_errcode = -1
			end if
		else
			li_errcode = -1
		end if
		li_counter = li_counter + 1
	loop
	al_errrow = li_counter - 1
	return li_errcode

// w_salereturnbuffer.wf_validatefullcode(string as_fullcode, long al_currrow) returns integer
	return 0

// w_salereturnbuffer.wf_itemsalehistory() returns 0
	s_itemsalehistory ls_itemsalehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itemsalehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itemsalehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itemsalehistory, ls_itemsalehistory)
	end if

// w_salereturnbuffer.wf_prevsaleinvinfo() returns 0
	s_previnvinfo ls_previnvinfo
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_previnvinfo.ar_customer = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		if this.id_master.getitemnumber(this.id_master.getrow(), "patientcode") > 0.0 then
			ls_previnvinfo.ar_patientcode = this.id_master.getitemnumber(this.id_master.getrow(), "patientcode")
		else
			setnull(ls_previnvinfo.ar_patientcode)
		end if
		ls_previnvinfo.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_previnvinfo.ar_invdate = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_previnvinfo, ls_previnvinfo)
	end if

// w_salereturnbuffer.wf_allowsalereturn(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns integer
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM SaleDetail WHERE SaleInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_salereturnbuffer.wf_findretailsaleinvoice(long al_saleinvcode, datetime ad_date, string as_errtext) returns integer
	integer li_rtcode
	string ls_posted
	SQL SELECT SaleLedger.date , posted INTO :ad_date, :ls_posted FROM SaleLedger WHERE SaleLedger.Saleinvcode =:al_saleinvcode AND SaleLedger.SaleCatCode =3 USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ls_posted) then
			as_errtext = "You must select some valid Retail Sale Invoice"
			li_rtcode = 1
		elseif ls_posted = "Y" then
			li_rtcode = 0
		else
			li_rtcode = 1
			as_errtext = "Sale invoice " + string(al_saleinvcode) + " is unposted~n~rOnly Posted invoices can be returned"
		end if
		if li_rtcode = 0 and wf_allowsalereturn(al_saleinvcode, f_getgroupcode(gl_usercode), this.il_strategy) <> 0 then
			li_rtcode = 1
			as_errtext = "Sale invoice " + string(al_saleinvcode) + " contains items of non allowed godown(s)~n~rYou Can not Make Return"
		end if
	else
		li_rtcode = 1
		as_errtext = "Database Error, Some database request fails"
	end if
	return li_rtcode

// w_salereturnbuffer.wf_retrievelist() returns long
	long ll_rtcode
	string[] ls_posted
	integer li_saleretcategory
	ls_posted[1] = "N"
	if this.ii_salerettype = 1 then
		li_saleretcategory = this.ii_saleretcategory
	else
		li_saleretcategory = this.ii_salerettype
	end if
	if this.ib_showinvoicelist then
		ll_rtcode = this.id_list.retrieve(li_saleretcategory, ls_posted, this.il_groupcode, this.ii_module)
	else
		ll_rtcode = -1
	end if
	return ll_rtcode

// w_salereturnbuffer.wf_setamountoninvoice() returns 0
	long ll_null
	long ll_rightfound
	double ld_netamt
	double ld_null
	string ls_null
	s_amountoninvoice lstr_amountoninvoice
	setnull(ld_null)
	setnull(ls_null)
	setnull(ll_null)
	if this.ii_salerettype <> 8 then
		if f_stringpreferences("askmastercashwin_in_buffersr") = "Y" then
			return
		end if
		if this.id_master.getitemstring(1, "accountfor") = "Y" then
			ld_netamt = wf_grandtotal()
			if f_stringpreferences("AskAmtOnCreditSaleReturn") = "Y" then
				ll_rightfound = 0
				ll_rightfound = gds_securitywindow.find("rightcode = 583", 1, gds_securitywindow.rowcount())
				lstr_amountoninvoice.l_invcode = this.id_master.getitemnumber(1, "code")
				lstr_amountoninvoice.d_netamt = ld_netamt
				lstr_amountoninvoice.d_amt = this.id_master.getitemdecimal(1, "amt")
				if isnull(lstr_amountoninvoice.d_amt) then
					lstr_amountoninvoice.d_balance = ld_netamt
				else
					lstr_amountoninvoice.d_balance = ld_netamt - lstr_amountoninvoice.d_amt
				end if
				if isnull(this.id_master.getitemstring(1, "paymentmode")) then
					this.id_master.setitem(1, "paymentmode", f_stringpreferences("SaleReturnPaymentMode"))
					this.id_master.setitem(1, "paymentacccode", f_numberpreferences("SaleReturnPaymentAcccode"))
				end if
				lstr_amountoninvoice.c_paymentmode = this.id_master.getitemstring(1, "paymentmode")
				lstr_amountoninvoice.i_acccode = this.id_master.getitemnumber(1, "paymentacccode")
				lstr_amountoninvoice.s_reference = this.id_master.getitemstring(1, "amtreference")
				lstr_amountoninvoice.s_module = "salereturn"
				if ll_rightfound > 0 then
					openwithparm(w_amountoninvoice, lstr_amountoninvoice)
					lstr_amountoninvoice = message.powerobjectparm
					this.id_master.setitem(1, "amt", lstr_amountoninvoice.d_amt)
					this.id_master.setitem(1, "paymentmode", lstr_amountoninvoice.c_paymentmode)
					this.id_master.setitem(1, "paymentacccode", lstr_amountoninvoice.i_acccode)
					this.id_master.setitem(1, "amtreference", lstr_amountoninvoice.s_reference)
				end if
				if ld_netamt - lstr_amountoninvoice.d_amt >= 0.0 then
					this.id_master.setitem(1, "outstandingamt", ld_netamt - lstr_amountoninvoice.d_amt)
				else
					this.id_master.setitem(1, "outstandingamt", 0)
				end if
			else
				this.id_master.setitem(1, "outstandingamt", ld_netamt)
				this.id_master.setitem(1, "paymentmode", ls_null)
				this.id_master.setitem(1, "paymentacccode", ll_null)
				this.id_master.setitem(1, "amtreference", ls_null)
				this.id_master.setitem(1, "amt", 0)
			end if
		else
			this.id_master.setitem(1, "outstandingamt", 0)
			this.id_master.setitem(1, "paymentmode", ls_null)
			this.id_master.setitem(1, "paymentacccode", ll_null)
			this.id_master.setitem(1, "amtreference", ls_null)
			this.id_master.setitem(1, "amt", 0)
		end if
		return
	end if
	this.id_master.setitem(1, "amt", 0)
	this.id_master.setitem(1, "paymentmode", ls_null)
	this.id_master.setitem(1, "paymentacccode", ll_null)
	this.id_master.setitem(1, "amtreference", ls_null)
	this.id_master.setitem(1, "outstandingamt", 0)

// w_salereturnbuffer.wf_find_header_no(long al_saleinvcode) returns integer
	integer li_header_no
	SQL SELECT SaleLedger.headerno INTO :li_header_no FROM SaleLedger WHERE SaleLedger.Saleinvcode =:al_saleinvcode USING this.it_transobject;
	return li_header_no

// w_salereturnbuffer.wf_validateheader(long al_headercode) returns boolean
	long ll_headerno
	boolean lb_ok
	SQL SELECT HeaderCode INTO :ll_headerno FROM GroupAllowedHeader WHERE HeaderCode =:al_headercode AND GroupCode =:this.il_groupcode AND Module =:this.ii_module USING sqlca;
	if sqlca.sqlcode = 0 then
		if ll_headerno > 0 then
			lb_ok = true
		else
			lb_ok = false
		end if
	else
		lb_ok = false
	end if
	return lb_ok

// w_salereturnbuffer.wf_isinvoiceinuse(long al_invoiceno) returns boolean
	long ll_found
	SQL Select count ( *) INTO :ll_found From SRBufferLedger Where SRBufferInvCode =:al_invoiceno and Posted ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_found = 0 or isnull(ll_found) then
			SQL Select count ( *) INTO :ll_found From SRBufferLedger With ( ReadPast , RowLock , UpdLock ) Where SRBufferInvCode =:al_invoiceno USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ll_found = 0 then
					return true
				else
					return false
				end if
			else
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_salereturnbuffer.wf_allowreturnmodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM SRBufferDetail WHERE SRBufferInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_salereturnbuffer.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	long ll_icode
	long ll_retflag
	long ll_rowid
	string ls_itemname
	if not this.ib_opensalereturn then
		ll_rowid = this.id_itemslist.find("fullcode = '" + as_fullcode + "'", 1, this.id_itemslist.rowcount())
		if ll_rowid > 0 then
			al_icode = this.id_itemslist.getitemnumber(ll_rowid, "icode")
			al_itemname = this.id_itemslist.getitemstring(ll_rowid, "itemname")
			this.id_itemslist.setrow(ll_rowid)
			ll_retflag = 1
		else
			ll_retflag = 0
		end if
	else
		if f_stringpreferences("GroupCategoryRights") = "Y" then
			SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
		else
			SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
		end if
		if this.it_transobject.sqlcode = 0 then
			al_icode = ll_icode
			al_itemname = ls_itemname
			if isnull(al_icode) then
				ll_retflag = 0
			else
				ll_retflag = 1
			end if
		else
			ll_retflag = -1
		end if
	end if
	return ll_retflag

// w_salereturnbuffer.wf_initmodify(integer ai_protect) returns 0
	long ll_saleretinvcode
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_counter = 1
	long ll_dddwrowcount
	long ll_dddwrow
	long ll_totalpieces
	long ll_piecesinhand
	string ls_batch
	datetime ld_expiry
	double ld_stock
	double ld_itemsaleretqty
	double ld_saleqty
	double ld_prevretqty
	double ld_retableqty
	double ld_itemsaleqty
	double ld_salebonusqty
	double ld_prevretbonusqty
	double ld_retablebonusqty
	double ld_itemsaleretbonusqty
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_saleretinvcode = this.id_detail.getitemnumber(1, "code")
		if wf_locksaleretinvoice(ll_saleretinvcode) = 0 then
			this.id_master.retrieve(ll_saleretinvcode)
			this.id_detail.retrieve(ll_saleretinvcode)
			ll_saleinvcode = this.id_master.getitemnumber(1, "saleinvcode")
			for ll_counter = 1 to this.id_detail.rowcount()
				ll_gcode = this.id_detail.getitemnumber(ll_counter, "gcode")
				ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
				ll_totalpieces = this.id_detail.getitemnumber(ll_counter, "totalpieces")
				ll_piecesinhand = this.id_detail.getitemnumber(ll_counter, "piecesinhand")
				ld_itemsaleretqty = this.id_detail.getitemnumber(ll_counter, "looseqty")
				ld_itemsaleretbonusqty = this.id_detail.getitemnumber(ll_counter, "Bonusqty")
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					ai_protect = 0
					if ll_saleinvcode > 0 then
						ld_saleqty = this.id_itemslist.getitemnumber(ll_counter, "looseqty")
						ld_prevretqty = this.id_itemslist.getitemnumber(ll_counter, "returnqty")
						ld_salebonusqty = this.id_itemslist.getitemnumber(ll_counter, "Bonusqty")
						ld_prevretbonusqty = this.id_itemslist.getitemnumber(ll_counter, "returnbonusqty")
						ld_retableqty = ld_saleqty - ld_prevretqty
						ld_retablebonusqty = ld_salebonusqty - ld_prevretbonusqty
					else
						ld_retableqty = 0
						ld_saleqty = 0
						ld_retablebonusqty = 0
						ld_salebonusqty = 0
					end if
					this.id_detail.setitem(ll_counter, "stock", ld_stock)
					this.id_detail.setitem(ll_counter, "retableqty", ld_retableqty)
					this.id_detail.setitem(ll_counter, "saleqty", ld_saleqty)
					this.id_detail.setitem(ll_counter, "retableBonusqty", ld_retablebonusqty)
					this.id_detail.setitem(ll_counter, "saleBonusqty", ld_salebonusqty)
					this.id_footer.setitem(1, "retableQty", ld_retableqty)
					this.id_footer.setitem(1, "stock", ld_stock)
					this.id_footer.setitem(1, "saleqty", ld_saleqty)
					this.id_footer.setitem(1, "retableBonusQty", ld_retablebonusqty)
					this.id_footer.setitem(1, "saleBonusqty", ld_salebonusqty)
				end if
				this.it_transobject.getitemtotalpiecesinhand(ll_icode, ll_piecesinhand)
				if this.it_transobject.sqlcode = 0 then
					this.id_detail.setitem(ll_counter, "piecesinhand", ll_piecesinhand + ll_totalpieces)
					this.id_footer.setitem(1, "piecesinhand", ll_piecesinhand + ll_totalpieces)
				end if
			next
			if ai_protect = 0 then
				this.ib_modify = true
				this.id_footer.setitem(1, "stock", this.id_detail.getitemnumber(1, "stock"))
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
		end if
	end if

// w_salereturnbuffer.wf_protectcolumns(integer ai_protect) returns long
	if (this.is_callermodule = "w_sale" or this.is_callermodule = "w_postsale") and ai_protect = 0 then
		return 0
	else
		this.id_master.object.aliasname.protect = ai_protect
		this.id_master.object.custcode.protect = ai_protect
		this.id_master.object.patientcode.protect = ai_protect
		this.id_master.object.patientregno.protect = ai_protect
		this.id_master.object.guestcode.protect = ai_protect
		this.id_master.object.guestregno.protect = ai_protect
		this.id_master.object.studentcode.protect = ai_protect
		this.id_master.object.studentregno.protect = ai_protect
		this.id_detail.object.expiry.protect = ai_protect
		this.id_detail.object.batch.protect = ai_protect
		this.id_footer.object.t_salebonusqty.visible = ai_protect
		this.id_footer.object.salebonusqty.visible = ai_protect
		this.id_footer.object.t_retablebonusqty.visible = ai_protect
		this.id_footer.object.retablebonusqty.visible = ai_protect
	end if
	return 0

// w_salereturnbuffer.wf_findsaleinvoice(long al_saleinvcode, datetime ad_date, string as_errtext) returns integer
	integer li_rtcode
	long ll_admissioncode
	string ls_posted
	setnull(ll_admissioncode)
	SQL SELECT SaleLedger.date , Posted , admissioncode INTO :ad_date, :ls_posted, :ll_admissioncode FROM SaleLedger WHERE SaleLedger.Saleinvcode =:al_saleinvcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ls_posted) then
			as_errtext = "You must select some valid Sale Invoice"
			li_rtcode = 1
		elseif ls_posted = "Y" then
			li_rtcode = 0
		else
			li_rtcode = 1
			as_errtext = "Sale invoice " + string(al_saleinvcode) + " is unposted~n~rOnly Posted invoices can be returned"
		end if
		if li_rtcode = 0 and wf_allowsalereturn(al_saleinvcode, f_getgroupcode(gl_usercode), this.il_strategy) <> 0 then
			li_rtcode = 1
			as_errtext = "Sale invoice " + string(al_saleinvcode) + " contains items of non allowed godown(s)~n~rYou Can not Make Return"
		end if
		if li_rtcode = 0 and not isnull(ll_admissioncode) then
			as_errtext = "Can not Return this invoice,~r~nPlease Use In-Patient Sale Return"
			li_rtcode = 1
		end if
	else
		li_rtcode = 1
		as_errtext = "Database Error, Some database request fails"
	end if
	return li_rtcode

// w_salereturnbuffer.wf_setsaleinvinfo(long al_saleinvcode, long al_custcode) returns 0
	long ll_salecatcode
	long ll_row
	long ll_smancode
	long ll_patientcode
	long ll_guestcode
	long ll_studentcode
	long ll_admissioncode
	double ld_invdiscperc
	double ld_invgstperc1
	double ld_flatdisc
	double ld_misccharges
	datetime ld_date
	string ls_regno
	string ls_remarks
	string ls_refno
	SQL SELECT saleledger.custcode , saleledger.date , saleledger.salecatcode , saleledger.smancode , saleledger.patientcode , saleledger.admissioncode , saleledger.discperc , saleledger.remarks , saleledger.custrefno , saleledger.invgstperc1 , saleledger.flatdisc , saleledger.misccharges , saleledger.guestcode , saleledger.studentcode INTO :al_custcode, :ld_date, :ll_salecatcode, :ll_smancode, :ll_patientcode, :ll_admissioncode, :ld_invdiscperc, :ls_remarks, :ls_refno, :ld_invgstperc1, :ld_flatdisc, :ld_misccharges, :ll_guestcode, :ll_studentcode FROM saleledger WHERE saleledger.saleinvcode =:al_saleinvcode USING this.it_transobject;
	if ll_salecatcode = 3 then
		this.ii_salerettype = 8
	else
		this.ii_salerettype = 1
	end if
	ll_row = this.id_master.getrow()
	this.id_master.object.saleinvdate[ll_row] = ld_date
	this.id_master.object.smancode[ll_row] = ll_smancode
	this.id_master.object.custcode[ll_row] = al_custcode
	this.id_master.object.patientcode[ll_row] = ll_patientcode
	this.id_master.object.remarks[ll_row] = ls_remarks
	this.id_master.object.custrefno[ll_row] = ls_refno
	this.id_master.object.guestcode[ll_row] = ll_guestcode
	this.id_master.object.studentcode[ll_row] = ll_studentcode
	this.id_footer.object.discperc[ll_row] = ld_invdiscperc
	this.id_footer.object.invgstperc1[ll_row] = ld_invgstperc1
	this.id_footer.object.flatdisc[ll_row] = ld_flatdisc
	wf_setfooterinfo(al_saleinvcode)
	if not isnull(ll_patientcode) then
		SQL SELECT regno INTO :ls_regno FROM Patient WHERE patientcode =:ll_patientcode USING this.it_transobject;
		this.id_master.object.patientregno[ll_row] = ls_regno
	end if
	if not isnull(ll_guestcode) then
		SQL SELECT regno INTO :ls_regno FROM guest WHERE guestcode =:ll_guestcode USING this.it_transobject;
		this.id_master.object.guestregno[ll_row] = ls_regno
	end if
	if not isnull(ll_studentcode) then
		SQL SELECT regno INTO :ls_regno FROM student WHERE studentcode =:ll_studentcode USING this.it_transobject;
		this.id_master.object.studentregno[ll_row] = ls_regno
	end if

// w_salereturnbuffer.wf_customerinfo(long al_custcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	string ls_aliasname
	double ld_taxperc
	long ll_currow
	long ll_smancode
	long ll_counter
	long ll_icode
	char lc_taxable = "N"
	SQL SELECT customer.address1 , customer.city , customer.phone , accounts.aliasname , customer.salesmancode , taxperc =( SELECT TC.taxperc FROM TaxCategory TC WHERE TC.TaxCategoryCode =customer.taxcategorycode ) INTO :ls_address, :ls_city, :ls_phone, :ls_aliasname, :ll_smancode, :ld_taxperc FROM customer , accounts WHERE customer.custcode =:al_custcode and customer.custcode =accounts.acccode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
		this.id_master.object.custcode[ll_currow] = al_custcode
		if this.id_master.object.saleinvcode[ll_currow] <= 0 then
			if al_custcode = 19 then
				this.ii_salerettype = 8
			else
				this.ii_salerettype = 1
			end if
			this.id_master.object.smancode[ll_currow] = ll_smancode
		end if
		this.id_master.object.aliasname[ll_currow] = ls_aliasname
		this.id_master.object.address[ll_currow] = ls_address
		this.id_master.object.city[ll_currow] = ls_city
		this.id_master.object.phone[ll_currow] = ls_phone
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.object.icode[ll_counter]
			if ll_icode > 0 then
				if this.ic_advancetaxonsale = "Y" and this.id_detail.object.taxable[ll_counter] = "Y" then
					this.id_detail.object.itemadvancetaxperc[ll_counter] = ld_taxperc
				else
					this.id_detail.object.itemadvancetaxperc[ll_counter] = 0.00
				end if
			end if
		next
	end if
	return this.it_transobject.sqlcode

// w_salereturnbuffer.wf_customername(long al_custcode) returns integer
	string ls_custname
	SQL SELECT accounts.name INTO :ls_custname FROM accounts WHERE accounts.acccode =:al_custcode USING this.it_transobject;
	this.id_master.object.custname[this.id_master.getrow()] = ls_custname
	return this.it_transobject.sqlcode

// w_salereturnbuffer.wf_findunpostedsalereturns(long al_saleinvcode, string as_errtext) returns integer
	integer li_rtcode
	long ll_count
	long ll_code
	if this.ib_modify then
		ll_code = this.id_master.object.code[1]
		SQL SELECT count ( *) INTO :ll_count FROM srbufferledger WHERE srbufferledger.saleinvcode =:al_saleinvcode AND srbufferledger.srbufferinvcode <> :ll_code AND srbufferledger.posted ='N' USING this.it_transobject;
	else
		SQL SELECT count ( *) INTO :ll_count FROM srbufferledger WHERE srbufferledger.saleinvcode =:al_saleinvcode AND srbufferledger.posted ='N' USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		if ll_count > 0 then
			li_rtcode = 1
			as_errtext = "Some Unposted Sale Return invoice already exist,~n~rModify that invoice"
		end if
	else
		li_rtcode = 1
		as_errtext = "Database Error, Some database request fails"
	end if
	return li_rtcode

// w_salereturnbuffer.wf_validatesaleinvcode(long al_row, long al_saleinvcode) returns integer
	long ll_detailrows
	long ll_custcode
	long ll_smancode
	long ll_counter
	integer li_rtcode
	integer li_result
	integer li_header_no
	datetime ld_datetime
	boolean lb_rtflag
	string ls_errtext
	string ls_batch
	dwitemstatus lrs_status
	if not isnull(al_saleinvcode) and al_saleinvcode > 0 then
		li_rtcode = wf_findsaleinvoice(al_saleinvcode, ld_datetime, ls_errtext)
		if li_rtcode = 0 then
			li_rtcode = wf_findunpostedsalereturns(al_saleinvcode, ls_errtext)
			if li_rtcode = 0 then
				li_rtcode = wf_locksaleinvoice(al_saleinvcode)
				if li_rtcode = 0 then
					li_header_no = wf_find_header_no(al_saleinvcode)
					if wf_validateheader(li_header_no) = true then
						this.id_master.setitem(al_row, "headerno", li_header_no)
					else
						ls_errtext = "Your Header Settings Do not Allow this return~r~nContact Your Systems Administrator for help"
						li_rtcode = 1
					end if
					if li_rtcode = 0 then
						this.im_menu.m_file.m_options.enabled = true
						ll_detailrows = this.id_detail.rowcount()
						if ll_detailrows > 0 then
							lrs_status = this.id_detail.getitemstatus(1, 0, primary!)
							if lrs_status <> new! and not isnull(this.id_detail.getitemnumber(1, "icode")) then
								li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
								if li_result = 2 then
									li_rtcode = 2
								else
									this.id_detail.setredraw(false)
									for ll_counter = ll_detailrows to 1 step -1
										this.id_detail.deleterow(ll_counter)
									next
									wf_setitemslist(0)
									this.id_detail.insertrow(0)
									this.id_detail.setredraw(true)
								end if
							end if
						end if
						if li_rtcode = 0 then
							wf_setsaleinvinfo(al_saleinvcode, ll_custcode)
							wf_setfooterinfo(al_saleinvcode)
							if this.is_callermodule <> "" and ll_custcode <> this.istr_buffer.l_code3 then
								messagebox("Sale Invoice Validation", "This invoice doest not belong to Customer Selected in sales")
								return 1
							end if
							wf_customerinfo(ll_custcode)
							wf_customername(ll_custcode)
							this.id_master.setitem(1, "saleinvdate", ld_datetime)
						end if
					end if
				else
					li_rtcode = 1
				end if
			else
				li_rtcode = 1
			end if
		else
			li_rtcode = 1
		end if
		if li_rtcode = 0 then
		end if
	else
		li_rtcode = 1
	end if
	if li_rtcode = 1 then
		messagebox("Sale Invoice validation", ls_errtext)
	end if
	return li_rtcode

// w_salereturnbuffer.wf_locksrinvoices(long al_sinvcode, long al_linvcode) returns integer
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM srbufferledger WITH ( UPDLOCK HOLDLOCK ) WHERE srbufferledger.srbufferinvcode Between :al_sinvcode and :al_linvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_salereturnbuffer.wf_locksaleretinvoice(long al_saleretinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From srbufferledger WITH ( UPDLOCK HOLDLOCK ) Where srbufferledger.srbufferinvcode =:al_saleretinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_salereturnbuffer.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_salereturnbuffer.wf_isposted(long al_code, transaction at_object) returns long
	string ls_posted
	SQL Select IsNull ( Posted , 'N' ) INTO :ls_posted From SrBufferLedger Where Srbufferinvcode =:al_code USING at_object;
	if at_object.sqlcode = 0 then
		if ls_posted = "Y" then
			return 0
		else
			return 1
		end if
		return
	end if
	return -1

// w_salereturnbuffer.wf_getpossiblebatchexpiry() returns 0
	long ll_saleinvcode
	s_possiblebatchexpiry lstr_possiblebatchexpiry
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 and not isnull(this.id_master.getitemnumber(this.id_master.getrow(), "custcode")) then
		ll_saleinvcode = this.id_master.getitemnumber(this.id_master.getrow(), "saleinvcode")
		lstr_possiblebatchexpiry.l_custcode = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		lstr_possiblebatchexpiry.l_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		openwithparm(w_possiblebatchexpiry, lstr_possiblebatchexpiry)
		lstr_possiblebatchexpiry = message.powerobjectparm
		if lstr_possiblebatchexpiry.i_status = 1 and isnull(ll_saleinvcode) and this.editflag = true then
			this.id_detail.setitem(this.id_detail.getrow(), "batch", lstr_possiblebatchexpiry.s_batch)
			this.id_detail.setitem(this.id_detail.getrow(), "expiry", lstr_possiblebatchexpiry.d_expiry)
		end if
	end if

// w_salereturnbuffer.wf_editsaleinvoice() returns integer
	long ll_rowcount
	long ll_counter
	long ll_saleinvcode
	long ll_rowscopy
	long ll_returneditems
	long ll_erroritems
	string ls_errtext
	integer li_errcode
	if this.editflag = false or this.tab_retrieve.selectedtab <> 1 then
		return -1
	end if
	if this.id_master.accepttext() <> 1 then
		return -1
	end if
	this.id_detail.setredraw(false)
	this.id_detail.reset()
	ll_saleinvcode = this.id_master.getitemnumber(this.id_master.getrow(), "saleinvcode")
	this.ib_itemvalidated = true
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_itemslist.rowcount()
	ll_rowscopy = 1
	for ll_counter = 1 to ll_rowcount
		li_errcode = wf_inititeminfo(this.idc_itemdddw, ll_saleinvcode, ll_counter, ll_rowscopy, ls_errtext)
		if li_errcode = 1 then
			ll_returneditems = ll_returneditems + 1
		elseif li_errcode = -1 then
			ll_erroritems = ll_erroritems + 1
		else
			ll_rowscopy = ll_rowscopy + 1
			this.id_detail.insertrow(0)
		end if
	next
	this.id_detail.deleterow(ll_rowscopy)
	messagebox("Edit Sale Invoice Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowscopy - 1) + " records were retrieved successfully~n~r" + string(ll_returneditems) + " records has already been returned~n~r" + string(ll_erroritems) + " record's database info. cannot be retrieved")
	if ll_rowscopy - 1 > 0 then
		wf_setfooterinfo(ll_saleinvcode)
		this.id_footer.setitem(1, "stock", this.id_detail.getitemnumber(1, "stock"))
		this.id_footer.setitem(1, "saleqty", this.id_detail.getitemnumber(1, "saleqty"))
		this.id_footer.setitem(1, "retableqty", this.id_detail.getitemnumber(1, "retableqty"))
		if f_stringpreferences("BonusinSale") = "Y" then
			this.id_footer.setitem(1, "salebonusqty", this.id_detail.getitemnumber(1, "salebonusqty"))
			this.id_footer.setitem(1, "retablebonusqty", this.id_detail.getitemnumber(1, "retablebonusqty"))
		end if
		this.im_menu.m_file.m_save.enabled = true
		this.id_detail.scrolltorow(0)
		this.id_detail.setcolumn(1)
		this.id_detail.setfocus()
		wf_grandtotal()
	end if
	this.id_detail.setredraw(true)
	return ll_rowscopy

// w_salereturnbuffer.wf_post() returns integer
	integer li_postingmode = 1
	long ll_sinvcode
	long ll_linvcode
	setnull(ll_sinvcode)
	setnull(ll_linvcode)
	return wf_post_salereturn(li_postingmode, ll_sinvcode, ll_linvcode)

// w_salereturnbuffer.wf_itemslistcolvisibility() returns integer
	long ll_found
	this.id_itemslist.setredraw(false)
	if f_stringpreferences("itemcode") = "N" then
		this.id_itemslist.object.fullcode.visible = false
	end if
	if f_stringpreferences("localitemname") = "N" then
		this.id_itemslist.object.localitemname.visible = false
	end if
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("itempackingdesc") = "N" then
		this.id_itemslist.object.packingdesc.visible = false
	end if
	if f_stringpreferences("itemlocation") = "N" then
		this.id_itemslist.object.location.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = true
	this.id_itemslist.object.sstock.visible = true
	this.id_itemslist.object.t_pstock.visible = false
	this.id_itemslist.object.pstock.visible = false
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.sstock.visible = false
	end if
	this.id_itemslist.setredraw(true)
	return 0

// w_salereturnbuffer.wf_setitemslist(long al_saleinvcode) returns integer
	long ll_found
	if al_saleinvcode > 0 then
		this.id_itemslist.dataobject = "ddd_saleinvitems"
		this.id_itemslist.settransobject(sqlca)
		this.ids_saleinv.retrieve(al_saleinvcode)
		if this.ids_saleinv.rowcount() = 0 then
			this.ids_saleinv.insertrow(0)
			this.ids_saleinv.setrow(1)
		end if
		this.ids_saleinv.sharedata(this.id_itemslist)
	else
		this.id_itemslist.dataobject = gd_itemsinfo.dataobject
		this.id_itemslist.settransobject(sqlca)
		gd_itemsinfo.sharedata(this.id_itemslist)
		wf_itemslistcolvisibility()
	end if
	return 0

// w_salereturnbuffer.wf_inititeminfo(datawindowchild adc_itemdddw, long al_saleinvcode, long al_dsrow, long al_detaildwrow, string as_errtext) returns integer
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_salerowid
	long ll_totalpieces
	long ll_piecesinhand
	double ld_saleprice
	double ld_discperc
	double ld_unitsalestax
	double ld_gstperc
	double ld_basicdatasaleprice
	double ld_packcapacity
	double ld_areavolume
	double ld_itemadvancetaxperc
	string ls_fullcode
	string ls_batch
	string ls_itemname
	string ls_remarks
	string ls_alternatecustomicode
	string ls_null
	datetime ld_expiry
	integer li_errcode = 1
	char lc_taxable
	long ll_currentrowinlist
	double ld_retableqty
	double ld_itemprevqty
	double ld_itemsaleqty
	double ld_stock
	double ld_alternatepurprice
	double ld_itemsalebonusqty
	double ld_retablebonusqty
	double ld_itemprevbonusqty
	double ld_avgprice
	setnull(ls_null)
	ll_currentrowinlist = al_dsrow
	ll_icode = this.id_itemslist.getitemnumber(ll_currentrowinlist, "icode")
	SQL SELECT saleprice , packunits , totalpieces , remarks , alternatepurprice , item.packcapacity , item.areavolume , item.taxable INTO :ld_basicdatasaleprice, :ll_packunits, :ll_piecesinhand, :ls_remarks, :ld_alternatepurprice, :ld_packcapacity, :ld_areavolume, :lc_taxable FROM Item WHERE icode =:ll_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_gcode = this.id_itemslist.getitemnumber(ll_currentrowinlist, "gcode")
		ll_icode = this.id_itemslist.getitemnumber(ll_currentrowinlist, "icode")
		ls_fullcode = this.id_itemslist.getitemstring(ll_currentrowinlist, "fullcode")
		ls_alternatecustomicode = this.id_itemslist.getitemstring(ll_currentrowinlist, "alternatecustomicode")
		ls_batch = this.id_itemslist.getitemstring(ll_currentrowinlist, "batch")
		ld_expiry = this.id_itemslist.getitemdatetime(ll_currentrowinlist, "Expiry")
		ld_saleprice = this.id_itemslist.getitemnumber(ll_currentrowinlist, "saleprice")
		ld_discperc = this.id_itemslist.getitemnumber(ll_currentrowinlist, "discperc")
		ld_itemsaleqty = this.id_itemslist.getitemnumber(ll_currentrowinlist, "looseqty")
		ld_itemsalebonusqty = this.id_itemslist.getitemnumber(ll_currentrowinlist, "bonusqty")
		ll_salerowid = this.id_itemslist.getitemnumber(ll_currentrowinlist, "salerowid")
		ll_totalpieces = this.id_itemslist.getitemnumber(ll_currentrowinlist, "totalpieces")
		ld_avgprice = this.id_itemslist.getitemnumber(ll_currentrowinlist, "avgprice")
		lc_taxable = this.id_itemslist.getitemstring(ll_currentrowinlist, "taxable")
		ld_itemadvancetaxperc = this.id_itemslist.getitemnumber(ll_currentrowinlist, "ItemAdvanceTaxPerc")
		ll_piecesinhand = ll_totalpieces
		ld_unitsalestax = this.id_itemslist.getitemnumber(ll_currentrowinlist, "unitsalestax")
		ld_gstperc = this.id_itemslist.getitemnumber(ll_currentrowinlist, "gstperc")
		ls_itemname = this.id_itemslist.getitemstring(ll_currentrowinlist, "itemname")
		if wf_itemprevretqty(al_saleinvcode, ll_salerowid, ll_icode, ld_itemprevqty, ld_itemprevbonusqty) = 0 then
			ld_retableqty = ld_itemsaleqty - ld_itemprevqty
			ld_retablebonusqty = ld_itemsalebonusqty - ld_itemprevbonusqty
			if ld_retableqty > 0.0 or ld_retablebonusqty > 0.0 then
				if this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock) = 0 then
					if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
						ll_gcode = this.id_detail.getitemnumber(al_detaildwrow, "gcode")
					end if
					this.id_detail.setitem(al_detaildwrow, "gcode", ll_gcode)
					this.id_detail.setitem(al_detaildwrow, "salerowid", ll_salerowid)
					this.id_detail.setitem(al_detaildwrow, "icode", ll_icode)
					this.id_detail.setitem(al_detaildwrow, "fullcode", ls_fullcode)
					this.id_detail.setitem(al_detaildwrow, "alternatecustomicode", ls_alternatecustomicode)
					this.id_detail.setitem(al_detaildwrow, "batch", ls_batch)
					this.id_detail.setitem(al_detaildwrow, "expiry", ld_expiry)
					this.id_detail.setitem(al_detaildwrow, "srprice", ld_saleprice)
					this.id_detail.setitem(al_detaildwrow, "discperc", ld_discperc)
					this.id_detail.setitem(al_detaildwrow, "Bonusqty", ld_retablebonusqty)
					this.id_detail.setitem(al_detaildwrow, "looseqty", ld_retableqty)
					this.id_detail.setitem(al_detaildwrow, "stock", ld_stock)
					this.id_detail.setitem(al_detaildwrow, "saleqty", ld_itemsaleqty)
					this.id_detail.setitem(al_detaildwrow, "retableqty", ld_retableqty)
					this.id_detail.setitem(al_detaildwrow, "salebonusqty", ld_itemsalebonusqty)
					this.id_detail.setitem(al_detaildwrow, "retablebonusqty", ld_retablebonusqty)
					this.id_detail.setitem(al_detaildwrow, "packunits", ll_packunits)
					this.id_detail.setitem(al_detaildwrow, "totalpieces", ll_totalpieces)
					this.id_detail.setitem(al_detaildwrow, "piecesinhand", ll_piecesinhand)
					this.id_detail.setitem(al_detaildwrow, "avgprice", ld_avgprice)
					if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
						ld_areavolume = 1
					end if
					if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
						ld_packcapacity = 1
					end if
					this.id_detail.setitem(al_detaildwrow, "packcapacity", ld_packcapacity)
					this.id_detail.setitem(al_detaildwrow, "areavolume", ld_areavolume)
					this.id_detail.setitem(al_detaildwrow, "pcs", round(this.id_detail.object.looseqty[al_detaildwrow] / ld_areavolume, 6))
					this.id_detail.setitem(al_detaildwrow, "cartons", trim(string(long(this.id_detail.object.pcs[al_detaildwrow] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[al_detaildwrow] mod ld_packcapacity, 2))))))
					this.id_detail.setitem(al_detaildwrow, "taxable", lc_taxable)
					this.id_detail.setitem(al_detaildwrow, "ItemAdvanceTaxPerc", ld_itemadvancetaxperc)
					this.id_detail.setitem(al_detaildwrow, "alternatepurprice", ld_alternatepurprice)
					if f_stringpreferences("sr_copyremarksinitemdesc") = "Y" and this.id_detail.getitemstatus(al_detaildwrow, "returnitemdescription", primary!) = notmodified! then
						this.id_detail.setitem(al_detaildwrow, "returnitemdescription", ls_remarks)
					end if
					this.id_detail.setitem(al_detaildwrow, "itemname", ls_itemname)
					this.id_detail.setitem(al_detaildwrow, "unitsalestax", ld_unitsalestax)
					this.id_detail.setitem(al_detaildwrow, "gstperc", ld_gstperc)
					this.id_detail.setitem(al_detaildwrow, "saleprice", ld_basicdatasaleprice / ll_packunits)
					this.id_footer.setitem(1, "stock", ld_stock)
					this.id_footer.setitem(1, "saleqty", ld_itemsaleqty)
					this.id_footer.setitem(1, "retableqty", ld_retableqty)
					this.id_footer.setitem(1, "saleBonusqty", ld_itemsalebonusqty)
					this.id_footer.setitem(1, "retableBonusqty", ld_retablebonusqty)
					wf_setfooterinfo(al_saleinvcode)
				else
					as_errtext = "Can not retrieve item stock information"
					li_errcode = 1
				end if
			else
				as_errtext = "Item Qty and Bonus has already been returned"
				li_errcode = 1
			end if
		else
			li_errcode = -1
			as_errtext = "Sale invoice information can not retrieve"
		end if
	else
		li_errcode = -1
		as_errtext = "Unable To Retrieve SalePrice from Item Basic Data"
	end if
	return li_errcode

// w_salereturnbuffer.wf_validateitem() returns integer
	long ll_icode
	long ll_dddwrow
	long ll_saleinvcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_null
	string ls_null
	ll_saleinvcode = this.id_master.getitemnumber(this.id_master.getrow(), "saleinvcode")
	if ll_saleinvcode > 0 and not isnull(ll_saleinvcode) then
		ll_dddwrow = this.id_itemslist.getrow()
		if wf_inititeminfo(this.idc_itemdddw, this.il_currrow, ll_dddwrow, ls_errtext) <> 0 then
			ls_titleerrtext = "Item Validation"
			li_errcode = -1
		end if
	else
		ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
		if wf_inititeminfo(ll_icode, this.il_currrow, ls_errtext) <> 0 then
			ls_titleerrtext = "Item Validation"
			li_errcode = -1
		end if
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		if f_stringpreferences("ItemCode") = "N" then
			this.id_detail.setcolumn(this.is_columnitemname)
		else
			this.id_detail.setcolumn("fullCode")
		end if
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.setitem(this.il_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(this.il_currrow, "fullcode", ls_null)
		messagebox(ls_titleerrtext, ls_errtext)
	end if
	return li_errcode

// w_salereturnbuffer.wf_allocatesalereturn(long al_srinvcode, long al_saleinvcode, datetime adt_date, long al_usercode) returns long
	long ll_retcode
	long ll_srallocationcode
	long ll_code
	long ll_unpostedtrans
	long ll_null
	double ld_sale_balance
	double ld_sr_balance
	double ld_amt
	double ld_new_sale_balance
	double ld_new_sr_balance
	char ac_posted = "N"
	string ls_msg
	string ls_title
	setnull(ll_null)
	ac_posted = upper(f_stringpreferences("AutoPostSaleReturnAllocation"))
	ls_msg = "000                                                                                                                                 "
	ls_title = "Sale Return Allocation"
	ll_retcode = 1
	if this.ib_opensalereturn = false and this.ii_salerettype = 1 and f_stringpreferences("AutoSaleReturnAllocation") = "Y" then
		ll_retcode = -1
		SQL rollback USING this.it_transobject;
		this.it_transobject.locksrinvoice(al_srinvcode)
		if this.it_transobject.sqlcode = 0 then
			this.it_transobject.locksaleinvoice(al_saleinvcode)
			if this.it_transobject.sqlcode = 0 then
				this.it_transobject.checkunpostedsaleinvintransactions(al_saleinvcode, ll_null, "SR", ll_unpostedtrans, ls_msg)
				if this.it_transobject.sqlcode = 0 and ll_unpostedtrans <= 0 then
					this.it_transobject.getsrinvbalance(al_srinvcode, ld_sr_balance)
					if this.it_transobject.sqlcode = 0 and ld_sr_balance > 0.0 then
						this.it_transobject.getsaleinvbalance(al_saleinvcode, ld_sale_balance)
						if this.it_transobject.sqlcode = 0 and ld_sale_balance > 0.0 then
							if ld_sale_balance <= ld_sr_balance then
								ld_amt = ld_sale_balance
							else
								ld_amt = ld_sr_balance
							end if
							ld_new_sale_balance = ld_sale_balance - ld_amt
							ld_new_sr_balance = ld_sr_balance - ld_amt
							this.it_transobject.updatesrinvbalance(al_srinvcode, ld_new_sr_balance)
							if this.it_transobject.sqlcode = 0 then
								this.it_transobject.updatesaleinvbalance(al_saleinvcode, ld_new_sale_balance)
								if this.it_transobject.sqlcode = 0 then
									this.it_transobject.createsrallocation(al_srinvcode, al_saleinvcode, adt_date, al_usercode, ac_posted, adt_date, ld_sale_balance, ld_amt, ll_code)
									if ll_code > 0 then
										ll_retcode = 1
										SQL commit USING this.it_transobject;
										ls_msg = "Sale Return Successfully Allocated, Code : " + trim(string(ll_code))
										messagebox(ls_title, ls_msg)
									end if
								end if
							end if
						end if
					end if
				end if
			end if
		end if
	end if
	if ll_retcode = -1 then
		SQL rollback USING this.it_transobject;
		if ll_unpostedtrans > 0 then
			ls_msg = "Unposted Transaction(s) Exist for this Sale Invoice~r~n~r~n" + ls_msg
		else
			ls_msg = "Problem In Sale Return Allocation"
		end if
		messagebox(ls_title, ls_msg)
	end if
	return ll_retcode

// w_salereturnbuffer.wf_inititeminfo(datawindowchild adc_itemdddw, long al_row, long al_dddwrow, string as_errtext) returns integer
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_saleinvcode
	long ll_salerowid
	long ll_totalpieces
	long ll_piecesinhand
	double ld_saleprice
	double ld_discperc
	double ld_unitsalestax
	double ld_gstperc
	double ld_basicdatasaleprice
	double ld_avgprice
	string ls_fullcode
	string ls_batch
	string ls_itemname
	string ls_remarks
	string ls_alternatecustomicode
	datetime ld_expiry
	integer li_errcode
	double ld_retableqty
	double ld_stock
	double ld_itemprevqty
	double ld_itemsaleqty
	double ld_itemsalebonusqty
	double ld_retablebonusqty
	double ld_itemprevbonusqty
	double ld_itemprevqty_oncurrentinv
	double ld_itemprevbonusqty_oncurrentinv
	double ld_alternatepurprice
	double ld_packcapacity
	double ld_areavolume
	double ld_itemadvancetaxperc
	char lc_taxable
	ll_saleinvcode = this.id_master.getitemnumber(this.id_master.getrow(), "saleinvcode")
	if ll_saleinvcode > 0 then
		ll_icode = this.id_itemslist.getitemnumber(al_dddwrow, "icode")
		SQL SELECT saleprice , packunits , totalpieces , remarks , alternatepurprice , item.packcapacity , item.areavolume , item.taxable INTO :ld_basicdatasaleprice, :ll_packunits, :ll_piecesinhand, :ls_remarks, :ld_alternatepurprice, :ld_packcapacity, :ld_areavolume, :lc_taxable FROM Item WHERE icode =:ll_icode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			ll_gcode = this.id_itemslist.getitemnumber(al_dddwrow, "gcode")
			ll_icode = this.id_itemslist.getitemnumber(al_dddwrow, "icode")
			ls_fullcode = this.id_itemslist.getitemstring(al_dddwrow, "fullcode")
			ls_alternatecustomicode = this.id_itemslist.getitemstring(al_dddwrow, "alternatecustomicode")
			ls_batch = this.id_itemslist.getitemstring(al_dddwrow, "batch")
			ld_expiry = this.id_itemslist.getitemdatetime(al_dddwrow, "Expiry")
			ld_saleprice = this.id_itemslist.getitemnumber(al_dddwrow, "saleprice")
			ld_discperc = this.id_itemslist.getitemnumber(al_dddwrow, "discperc")
			ll_salerowid = this.id_itemslist.getitemnumber(al_dddwrow, "salerowid")
			ld_unitsalestax = this.id_itemslist.getitemnumber(al_dddwrow, "unitsalestax")
			ld_gstperc = this.id_itemslist.getitemnumber(al_dddwrow, "gstperc")
			ll_totalpieces = this.id_itemslist.getitemnumber(al_dddwrow, "totalpieces")
			ls_itemname = this.id_itemslist.getitemstring(al_dddwrow, "itemname")
			ld_avgprice = this.id_itemslist.getitemnumber(al_dddwrow, "avgprice")
			lc_taxable = this.id_itemslist.getitemstring(al_dddwrow, "taxable")
			ld_itemadvancetaxperc = this.id_itemslist.getitemnumber(al_dddwrow, "ItemAdvanceTaxPerc")
			if wf_itemprevretqty(ll_saleinvcode, ll_salerowid, ll_icode, ld_itemprevqty, ld_itemprevbonusqty) = 0 then
				wf_oninvoiceitemprevqty(al_row, ll_icode, ll_salerowid, ld_itemprevqty_oncurrentinv, ld_itemprevbonusqty_oncurrentinv, ls_batch, ld_expiry)
				ld_itemsaleqty = this.id_itemslist.getitemnumber(al_dddwrow, "looseqty")
				ld_retableqty = ld_itemsaleqty - ld_itemprevqty - ld_itemprevqty_oncurrentinv
				if f_stringpreferences("BonusinSale") = "Y" then
					ld_itemsalebonusqty = this.id_itemslist.getitemnumber(al_dddwrow, "Bonusqty")
					ld_retablebonusqty = ld_itemsalebonusqty - ld_itemprevbonusqty - ld_itemprevbonusqty_oncurrentinv
				end if
				if ld_retableqty > 0.0 or ld_retablebonusqty > 0.0 then
					if this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock) = 0 then
						if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
							ll_gcode = this.id_detail.getitemnumber(al_row, "gcode")
						end if
						this.id_detail.setitem(al_row, "gcode", ll_gcode)
						this.id_detail.setitem(al_row, "icode", ll_icode)
						this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
						this.id_detail.setitem(al_row, "alternatecustomicode", ls_alternatecustomicode)
						this.id_detail.setitem(al_row, "batch", ls_batch)
						this.id_detail.setitem(al_row, "expiry", ld_expiry)
						this.id_detail.setitem(al_row, "srprice", ld_saleprice)
						this.id_detail.setitem(al_row, "discperc", ld_discperc)
						this.id_detail.setitem(al_row, "Bonusqty", ld_retablebonusqty)
						this.id_detail.setitem(al_row, "looseqty", ld_retableqty)
						this.id_detail.setitem(al_row, "retableqty", ld_retableqty)
						this.id_detail.setitem(al_row, "saleqty", ld_itemsaleqty)
						this.id_detail.setitem(al_row, "saleBonusqty", ld_itemsalebonusqty)
						this.id_detail.setitem(al_row, "retableBonusqty", ld_retablebonusqty)
						this.id_detail.setitem(al_row, "stock", ld_stock)
						this.id_detail.setitem(al_row, "packunits", ll_packunits)
						this.id_detail.setitem(al_row, "piecesinhand", ll_piecesinhand)
						this.id_detail.setitem(al_row, "alternatepurprice", ld_alternatepurprice)
						this.id_detail.setitem(al_row, "totalpieces", ll_totalpieces)
						this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
						this.id_detail.setitem(al_row, "taxable", lc_taxable)
						this.id_detail.setitem(al_row, "ItemAdvanceTaxPerc", ld_itemadvancetaxperc)
						this.id_detail.setitem(al_row, "itemname", ls_itemname)
						this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
						this.id_detail.setitem(al_row, "gstperc", ld_gstperc)
						this.id_detail.setitem(al_row, "salerowid", ll_salerowid)
						this.id_detail.setitem(al_row, "saleprice", ld_basicdatasaleprice / ll_packunits)
						this.id_detail.setitem(al_row, "returnitemdescription", this.id_itemslist.object.saleitemdesc[al_dddwrow])
						if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
							ld_areavolume = 1
						end if
						if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
							ld_packcapacity = 1
						end if
						this.id_detail.setitem(al_row, "packcapacity", ld_packcapacity)
						this.id_detail.setitem(al_row, "areavolume", ld_areavolume)
						this.id_detail.setitem(al_row, "pcs", round(this.id_detail.object.looseqty[al_row] / ld_areavolume, 6))
						this.id_detail.setitem(al_row, "cartons", trim(string(this.id_detail.object.pcs[al_row] / ld_packcapacity)) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[al_row] mod ld_packcapacity, 2))))))
						if f_stringpreferences("sr_copyremarksinitemdesc") = "Y" and this.id_detail.getitemstatus(al_row, "returnitemdescription", primary!) = notmodified! then
							this.id_detail.setitem(al_row, "returnitemdescription", ls_remarks)
						end if
						this.id_footer.setitem(1, "retableqty", ld_retableqty)
						this.id_footer.setitem(1, "saleqty", ld_itemsaleqty)
						this.id_footer.setitem(1, "retablebonusqty", ld_retablebonusqty)
						this.id_footer.setitem(1, "salebonusqty", ld_itemsalebonusqty)
						this.id_footer.setitem(1, "stock", ld_stock)
						if ll_saleinvcode > 0 then
							wf_setfooterinfo(ll_saleinvcode)
						end if
					else
						as_errtext = "Can not retrieve item stock information"
						li_errcode = -1
					end if
				else
					as_errtext = "item qty has already been returned"
					li_errcode = 1
				end if
			else
				li_errcode = -1
				as_errtext = "Sale invoice information can not retrieve"
			end if
		else
			li_errcode = -1
			as_errtext = "Unable To Get Item's Information"
		end if
	else
		li_errcode = -1
		as_errtext = "Please Select Valid Sale Invoice First, Unable To Get Item's Information"
	end if
	return li_errcode

// w_salereturnbuffer.wf_inititeminfo(long al_icode, long al_row, string as_errortext) returns integer
	double ld_saleprice
	double ld_discperc
	double ld_unitsalestax
	double ld_gstperc2
	double ld_gstperc1
	double ld_avgprice
	long ll_packunits
	long ll_saleinvcode
	long ll_totalpieces
	long ll_piecesinhand
	integer li_gcode
	integer retflag
	integer li_custcode
	integer li_defaultgst
	string ls_fullcode
	string ls_name
	string ls_packingdesc
	string ls_remarks
	string ls_alternatecustomicode
	string ls_null
	double ld_godownstock
	double ld_saleqty
	double ld_alternatepurprice
	double ld_packcapacity
	double ld_areavolume
	double ld_taxperc
	char lc_taxable
	setnull(ls_null)
	li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
	SQL SELECT item.customicode , item.name , item.saleprice , item.packunits , item.gcode , item.salediscperc , item.gstperc1 , item.gstperc2 , Round ( item.packsalestax / item.packunits , 2 ) , item.packingdesc , item.totalpieces , item.Remarks , item.alternatepurprice , item.avgprice , item.packcapacity , item.areavolume , item.taxable INTO :ls_fullcode, :ls_name, :ld_saleprice, :ll_packunits, :li_gcode, :ld_discperc, :ld_gstperc1, :ld_gstperc2, :ld_unitsalestax, :ls_packingdesc, :ll_piecesinhand, :ls_remarks, :ld_alternatepurprice, :ld_avgprice, :ld_packcapacity, :ld_areavolume, :lc_taxable FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = 0 then
		if this.il_godowncount = 1 and this.il_strategy = 1 then
			li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
		else
			if this.il_strategy = 2 then
				li_gcode = li_gcode
			end if
			if this.il_strategy = 1 then
				li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
			end if
		end if
		li_custcode = this.id_master.getitemnumber(1, "custcode")
		if isnull(li_custcode) then
			retflag = -1
			as_errortext = "Validation Error: Select Customer "
		end if
		SQL SELECT defaultGST , TaxPerc =( SELECT TC.TaxPerc FROM TaxCategory TC WHERE TC.TaxCategoryCode =Customer.TaxCategoryCode ) INTO :li_defaultgst, :ld_taxperc FROM customer WHERE customer.custcode =:li_custcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
			if this.it_transobject.sqlcode = 0 then
				ls_alternatecustomicode = this.id_detail.object.alternatecustomicode[al_row]
				if isnull(ls_alternatecustomicode) then
					ls_alternatecustomicode = ""
				end if
				if lower(ls_fullcode) = lower(ls_alternatecustomicode) then
					ls_alternatecustomicode = ls_null
					this.id_detail.object.alternatecustomicode[al_row] = ls_null
				end if
				this.id_detail.setitem(al_row, "gcode", li_gcode)
				this.id_detail.setitem(al_row, "icode", al_icode)
				this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
				this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
				this.id_detail.setitem(al_row, "packunits", ll_packunits)
				if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) then
					this.id_detail.setitem(al_row, "srprice", ld_saleprice / ll_packunits)
					this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "discperc", ld_discperc)
				this.id_detail.setitem(al_row, "packingdesc", ls_packingdesc)
				this.id_detail.setitem(al_row, "stock", ld_godownstock)
				this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
				this.id_detail.setitem(al_row, "piecesinhand", ll_piecesinhand)
				this.id_detail.setitem(al_row, "alternatepurprice", ld_alternatepurprice)
				this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
				this.id_detail.setitem(al_row, "taxable", lc_taxable)
				if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
					ld_areavolume = 1
				end if
				if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
					ld_packcapacity = 1
				end if
				this.id_detail.setitem(al_row, "packcapacity", ld_packcapacity)
				this.id_detail.setitem(al_row, "areavolume", ld_areavolume)
				this.id_detail.setitem(al_row, "pcs", round(this.id_detail.object.looseqty[al_row] / ld_areavolume, 6))
				this.id_detail.setitem(al_row, "cartons", trim(string(long(this.id_detail.object.pcs[al_row] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[al_row] mod ld_packcapacity, 2))))))
				if f_stringpreferences("sr_copyremarksinitemdesc") = "Y" and this.id_detail.getitemstatus(al_row, "returnitemdescription", primary!) = notmodified! then
					this.id_detail.setitem(al_row, "returnitemdescription", ls_remarks)
				end if
				if li_defaultgst = 2 then
					this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
				else
					this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
				end if
				this.id_footer.setitem(1, "stock", ld_godownstock)
				this.id_footer.setitem(1, "piecesinhand", ll_piecesinhand)
				if this.ic_advancetaxonsale = "Y" and lc_taxable = "Y" then
					this.id_detail.object.itemadvancetaxperc[al_row] = ld_taxperc
				else
					this.id_detail.object.itemadvancetaxperc[al_row] = 0.00
				end if
				if f_stringpreferences("FetchLatestItemSalesInfo") = "Y" then
					wf_fetch_latest_itemsalesinfo(al_row, al_icode)
				end if
			else
				retflag = -1
				as_errortext = "Database Error: Item Stock information can not be retrieved"
			end if
		else
			retflag = -1
			as_errortext = "Database Error: Item information can not be retrieved"
		end if
	else
		retflag = -1
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	return retflag

// w_salereturnbuffer.wf_checkitemactiveness(long al_icode, string as_errtext, long al_count, long[] al_activeitemslist) returns long
	long ll_activestatus
	long ll_setactive
	ll_activestatus = this.it_transobject.isactiveitem(al_icode)
	if this.it_transobject.sqlcode = 0 then
		if ll_activestatus = -1 then
			as_errtext = "Problem in Fetching Item Active Status:~r~n" + sqlca.sqlerrtext
			return -1
		elseif ll_activestatus = 0 then
			this.it_transobject.setitemactivestatus(al_icode, 1)
			if this.it_transobject.sqlcode <> 0 then
				as_errtext = "Problem in Fetching Item Active Status:~r~n" + sqlca.sqlerrtext
				return -1
			else
				al_count = al_count + 1
				al_activeitemslist[al_count] = al_icode
			end if
		end if
	else
		as_errtext = "Problem in Fetching Item Active Status:~r~n" + sqlca.sqlerrtext
		return -1
	end if
	return 0

// w_salereturnbuffer.wf_itemprevretqty(long al_saleinvcode, long al_gcode, long al_icode, string as_batch, datetime ad_expiry, double al_itemprevqty, double al_itemprevbonusqty) returns integer
	SQL SELECT IsNull ( Sum ( srdetail.looseqty ) , 0 ) , IsNull ( Sum ( srdetail.Bonusqty ) , 0 ) INTO :al_itemprevqty, :al_itemprevbonusqty FROM srledger , srdetail WHERE srledger.saleinvcode =:al_saleinvcode and srledger.posted ='Y' and srledger.srinvcode =srdetail.SRInvCode and srdetail.icode =:al_icode and srdetail.batch =:as_batch and srdetail.expiry =:ad_expiry USING this.it_transobject;
	if isnull(al_itemprevqty) then
		al_itemprevqty = 0
	end if
	if isnull(al_itemprevbonusqty) then
		al_itemprevbonusqty = 0
	end if
	return this.it_transobject.sqlcode

// w_salereturnbuffer.wf_itemprevretqty(long al_saleinvcode, long al_salerowid, long al_icode, double al_itemprevqty, double al_itemprevbonusqty) returns integer
	SQL SELECT IsNull ( Sum ( looseqty ) , 0 ) , IsNull ( Sum ( bonusqty ) , 0 ) INTO :al_itemprevqty, :al_itemprevbonusqty FROM SRLedger , SRDetail WHERE SRLedger.SaleInvCode =:al_saleinvcode And SRLedger.posted ='Y' And SRLedger.SRInvcode =SRDetail.SRInvCode And SRDetail.ICode =:al_icode And SRDetail.SaleRowId =:al_salerowid USING this.it_transobject;
	if isnull(al_itemprevqty) then
		al_itemprevqty = 0
	end if
	if isnull(al_itemprevbonusqty) then
		al_itemprevbonusqty = 0
	end if
	return this.it_transobject.sqlcode

// w_salereturnbuffer.wf_oninvoiceitemprevqty(long al_row, long al_icode, long al_salerowid, double al_itemprevqty, double al_itemprevbonusqty, string as_batch, datetime ad_expiry) returns integer
	long ll_counter
	long ll_rowcount
	long ll_icode
	long ll_salerowid
	double ld_holdqty
	double ld_holdbonusqty
	string ls_batch
	datetime ld_expiry
	ll_rowcount = this.id_detail.rowcount()
	for ll_counter = 1 to al_row - 1
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		ll_salerowid = this.id_detail.getitemnumber(ll_counter, "salerowid")
		ls_batch = this.id_detail.getitemstring(ll_counter, "batch")
		ld_expiry = this.id_detail.getitemdatetime(ll_counter, "expiry")
		if ll_icode = al_icode and ll_salerowid = al_salerowid and ls_batch = as_batch and ld_expiry = ad_expiry then
			ld_holdqty = ld_holdqty + this.id_detail.getitemnumber(ll_counter, "looseqty")
			ld_holdbonusqty = ld_holdbonusqty + this.id_detail.getitemnumber(ll_counter, "bonusqty")
		end if
	next
	for ll_counter = al_row + 1 to ll_rowcount
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		ll_salerowid = this.id_detail.getitemnumber(ll_counter, "salerowid")
		ls_batch = this.id_detail.getitemstring(ll_counter, "batch")
		ld_expiry = this.id_detail.getitemdatetime(ll_counter, "expiry")
		if ll_icode = al_icode and ll_salerowid = al_salerowid and ls_batch = as_batch and ld_expiry = ad_expiry then
			ld_holdqty = ld_holdqty + this.id_detail.getitemnumber(ll_counter, "looseqty")
			ld_holdbonusqty = ld_holdbonusqty + this.id_detail.getitemnumber(ll_counter, "bonusqty")
		end if
	next
	al_itemprevqty = ld_holdqty
	al_itemprevbonusqty = ld_holdbonusqty
	return 0

// w_salereturnbuffer.wf_validateqty(long al_row, double al_qty) returns integer
	integer li_rtcode
	double ld_retableqty
	double ld_itemprevqty
	double ld_itemprevbonusqty
	double ld_areavolume
	double ld_packcapacity
	long ll_icode
	long ll_salerowid
	datetime ld_expiry
	string ls_batch
	ld_retableqty = this.id_detail.getitemnumber(al_row, "retableqty")
	if this.id_master.getitemnumber(1, "saleinvcode") > 0.0 then
		ll_icode = this.id_detail.getitemnumber(al_row, "icode")
		ll_salerowid = this.id_detail.getitemnumber(al_row, "salerowid")
		ld_expiry = this.id_detail.getitemdatetime(al_row, "expiry")
		ls_batch = this.id_detail.getitemstring(al_row, "batch")
		wf_oninvoiceitemprevqty(al_row, ll_icode, ll_salerowid, ld_itemprevqty, ld_itemprevbonusqty, ls_batch, ld_expiry)
		if al_qty + ld_itemprevqty > ld_retableqty then
			li_rtcode = 1
			messagebox("Quantity Validation", "    Qty Should be less than " + string(ld_retableqty))
		end if
	end if
	if li_rtcode = 0 then
		ld_areavolume = this.id_detail.object.areavolume[al_row]
		if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
			ld_areavolume = 1
		end if
		ld_packcapacity = this.id_detail.object.packcapacity[al_row]
		if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
			ld_packcapacity = 1
		end if
		this.id_detail.setitem(al_row, "pcs", round(al_qty / ld_areavolume, 6))
		this.id_detail.setitem(al_row, "cartons", trim(string(long(this.id_detail.object.pcs[al_row] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[al_row] mod ld_packcapacity, 2))))))
	end if
	return li_rtcode

// w_salereturnbuffer.wf_validatebonusqty(long al_row, double al_bonusqty) returns integer
	integer li_rtcode
	long ll_icode
	long ll_salerowid
	string ls_batch
	datetime ld_expiry
	double ld_itemprevqty
	double ld_itemprevbonusqty
	double ld_retablebonusqty
	ld_retablebonusqty = this.id_detail.getitemnumber(al_row, "retablebonusqty")
	if this.id_master.getitemnumber(1, "saleinvcode") > 0.0 then
		ll_icode = this.id_detail.getitemnumber(al_row, "icode")
		ll_salerowid = this.id_detail.getitemnumber(al_row, "salerowid")
		ls_batch = this.id_detail.getitemstring(al_row, "batch")
		ld_expiry = this.id_detail.getitemdatetime(al_row, "expiry")
		wf_oninvoiceitemprevqty(al_row, ll_icode, ll_salerowid, ld_itemprevqty, ld_itemprevbonusqty, ls_batch, ld_expiry)
		if al_bonusqty + ld_itemprevbonusqty > ld_retablebonusqty then
			li_rtcode = 1
			messagebox("Bonus Qty Validation", "    Bonus Qty Should Not Exceed From " + string(ld_retablebonusqty))
		end if
	end if
	return li_rtcode

// w_salereturnbuffer.wf_post_salereturn(integer ai_postingmode, long al_startinginvcode, long al_endinginvcode) returns integer
	integer li_errcode
	long ll_detailrows
	long ll_masterrows
	long ll_gcode
	long ll_icode
	long ll_errrowid
	long ll_salesmancode
	long ll_outercounter
	long ll_innercounter
	long ll_masterinvcode
	long ll_detailinvcode
	long ll_saleinvcode
	long ll_totalpieces
	long ll_piecesinhand
	long ll_lastinvoice
	long ll_mastercurrrow
	long ll_activestatus
	long ll_setasactive_count
	long[] ll_activeitemslist
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	string ls_batch
	string ls_errtext
	string ls_date_errtext
	datetime ld_expiry
	datetime ldt_server_datetime
	datawindowchild ldc_godown
	datawindowchild ldc_patient
	datastore lds_master
	datastore lds_detail
	s_arguements lstr_arginfo
	double ld_stock
	double ld_newstock
	double ld_qty
	double ld_bonusqty
	double ld_avgprice
	double ld_holdavgprice
	double ld_newavgprice
	double ld_netprice
	double ld_totalstock
	s_datastore lstr_arg
	datastore lds_items
	if ai_postingmode = 1 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if ai_postingmode = 1 then
			open(w_arg_sinvcode_linvcode)
			lstr_arginfo = message.powerobjectparm
		else
			lstr_arginfo.l_code1 = al_startinginvcode
			lstr_arginfo.l_code2 = al_endinginvcode
			lstr_arginfo.i_status = 1
		end if
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING this.it_transobject;
			this.dw_srmaster.settransobject(this.it_transobject)
			this.dw_srdetail.settransobject(this.it_transobject)
			ls_errtext = "Some database request fails        "
			ll_outercounter = lstr_arginfo.l_code1
			ll_lastinvoice = lstr_arginfo.l_code2
			do while ll_outercounter <= ll_lastinvoice and li_errcode = 0
				li_errcode = wf_locksrinvoices(ll_outercounter, ll_outercounter)
				if li_errcode = 0 and wf_isposted(ll_outercounter, this.it_transobject) = 1 then
					if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
						messagebox("Date Violation", ls_date_errtext, stopsign!)
						li_errcode = -1
					end if
					this.dw_srmaster.modify("DataWindow.Table.UpdateTable = ~"srbufferledger~"")
					this.dw_srmaster.modify("code.dbName='srbufferinvcode'")
					if this.dw_srmaster.getchild("patientcode", ldc_patient) = -1 then
						messagebox("Error", "Can not get a DataWindowChild")
						li_errcode = -1
					end if
					ldc_patient.settransobject(this.it_transobject)
					ldc_patient.insertrow(0)
					this.dw_srmaster.retrieve(ll_outercounter)
					ll_mastercurrrow = this.dw_srmaster.getrow()
					if this.dw_srmaster.object.retviabillsummary[ll_mastercurrrow] = "N" then
						ll_saleinvcode = this.dw_srmaster.getitemnumber(ll_mastercurrrow, "saleinvcode")
						this.dw_srmaster.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
						this.dw_srmaster.setitem(ll_mastercurrrow, "PostedBy", ll_salesmancode)
						this.dw_srmaster.object.posted[ll_mastercurrrow] = "Y"
						if this.dw_srmaster.update(true, false) = 1 then
							this.dw_srmaster.modify("DataWindow.Table.UpdateTable = ~"srledger~"")
							this.dw_srmaster.modify("code.dbName='srinvcode'")
							this.dw_srmaster.setitemstatus(ll_mastercurrrow, 0, primary!, newmodified!)
							if this.dw_srmaster.update() = 1 then
								if this.dw_srdetail.getchild("gcode", ldc_godown) = -1 then
									messagebox("Error", "Can not get a DataWindowChild for Godown.")
									li_errcode = -1
								end if
								ldc_godown.settransobject(this.it_transobject)
								if ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy) = -1 then
									messagebox("Error", "Not Enough Godown Rights for making Sale Return")
									li_errcode = -1
								end if
								this.dw_srdetail.modify("DataWindow.Table.UpdateTable = ~"srbufferdetail~"")
								this.dw_srdetail.modify("code.dbName='srbufferinvcode'")
								this.dw_srdetail.retrieve(ll_outercounter)
								ll_detailrows = this.dw_srdetail.rowcount()
								ul_rowcount = ll_detailrows
								this.it_transobject.getmaxutn(ul_rowcount, ul_maxutn)
								if this.it_transobject.sqlcode = 0 then
									li_errcode = 0
								else
									li_errcode = -1
								end if
							else
								li_errcode = -1
							end if
							ll_innercounter = 1
							do while ll_innercounter <= ll_detailrows and li_errcode = 0
								this.dw_srdetail.setitem(ll_innercounter, "srutn", ul_maxutn)
								ul_maxutn = ul_maxutn + 1
								ll_gcode = this.dw_srdetail.getitemnumber(ll_innercounter, "gcode")
								ll_icode = this.dw_srdetail.getitemnumber(ll_innercounter, "icode")
								ls_batch = this.dw_srdetail.getitemstring(ll_innercounter, "batch")
								ld_expiry = this.dw_srdetail.getitemdatetime(ll_innercounter, "expiry")
								ld_qty = this.dw_srdetail.getitemnumber(ll_innercounter, "looseqty")
								ld_bonusqty = this.dw_srdetail.getitemnumber(ll_innercounter, "bonusqty")
								ll_totalpieces = this.dw_srdetail.getitemnumber(ll_innercounter, "totalpieces")
								ll_piecesinhand = this.dw_srdetail.getitemnumber(ll_innercounter, "piecesinhand")
								ld_avgprice = this.dw_srdetail.getitemnumber(ll_innercounter, "avgprice")
								ld_netprice = round(this.dw_srdetail.object.srprice[ll_innercounter] * (1 - this.dw_srdetail.object.discperc[ll_innercounter] * 0.01) * (1 - this.dw_srmaster.object.discperc[1] * 0.01), 2)
								ld_holdavgprice = ld_avgprice
								if lower(ls_batch) <> "due" then
									this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
									if this.it_transobject.sqlcode = 0 then
										if ll_saleinvcode > 0 then
											this.dw_srdetail.setitem(ll_innercounter, "avgprice", ld_holdavgprice)
											ld_netprice = ld_holdavgprice
										else
											this.dw_srdetail.setitem(ll_innercounter, "avgprice", ld_avgprice)
										end if
										this.it_transobject.getitemstockall(ll_icode, ld_totalstock)
										this.dw_srdetail.setitem(ll_innercounter, "currstock", ld_totalstock)
										if this.it_transobject.sqlcode = 0 then
											if isnull(ld_totalstock) then
												ld_totalstock = 0
											end if
											if ld_totalstock + ld_qty + ld_bonusqty > 0.0 then
												ld_newavgprice = round((ld_avgprice * ld_totalstock + ld_netprice * (ld_qty + ld_bonusqty)) / (ld_totalstock + ld_qty + ld_bonusqty), 5)
											else
												ld_newavgprice = round(ld_avgprice * ld_totalstock + ld_netprice * (ld_qty + ld_bonusqty), 5)
											end if
											this.dw_srdetail.object.newavgprice[ll_innercounter] = ld_newavgprice
										else
											li_errcode = -1
											ls_errtext = "Total Stock Fetch Error:~r~n" + this.it_transobject.sqlerrtext
										end if
										if li_errcode = 0 then
											li_errcode = wf_checkitemactiveness(ll_icode, ls_errtext, ll_setasactive_count, ll_activeitemslist)
										end if
										if li_errcode = 0 then
											this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
											if this.it_transobject.sqlcode = 0 then
												ld_newstock = ld_stock + ld_qty + ld_bonusqty
												this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
												if this.it_transobject.sqlcode <> 0 then
													li_errcode = -1
													ls_errtext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
												end if
											else
												li_errcode = -1
												ls_errtext = "Batch Wise Stock Fetch Error:~r~n" + this.it_transobject.sqlerrtext
											end if
										end if
									else
										li_errcode = -1
										ls_errtext = "Item Avg. Price Fetch Error:~r~n" + this.it_transobject.sqlerrtext
									end if
								end if
								this.it_transobject.getitemtotalpiecesinhand(ll_icode, ll_piecesinhand)
								if this.it_transobject.sqlcode <> 0 then
									li_errcode = -1
								else
									this.id_detail.setitem(ll_innercounter, "piecesinhand", ll_piecesinhand)
									this.it_transobject.updateitemtotalpiecesinhand(ll_icode, 1, ll_totalpieces)
									if this.it_transobject.sqlcode <> 0 then
										li_errcode = -1
									end if
								end if
								ll_innercounter = ll_innercounter + 1
							loop
							if ll_innercounter >= 1 and li_errcode = 0 then
								if this.dw_srdetail.update(true, false) = 1 then
									this.dw_srdetail.modify("DataWindow.Table.UpdateTable = ~"srdetail~"")
									this.dw_srdetail.modify("code.dbName='srinvcode'")
									for ll_innercounter = 1 to this.dw_srdetail.rowcount()
										this.dw_srdetail.setitemstatus(ll_innercounter, 0, primary!, newmodified!)
									next
									if this.dw_srdetail.update() = 1 then
										li_errcode = 0
									else
										li_errcode = -1
									end if
								else
									li_errcode = -1
								end if
							end if
						else
							li_errcode = -1
						end if
						if li_errcode = 0 then
							SQL update Saleledger SET returncounter =returncounter + 1 WHERE saleinvcode =:ll_saleinvcode USING this.it_transobject;
							if this.it_transobject.sqlcode <> 0 then
								li_errcode = -1
							else
								SQL commit USING this.it_transobject;
								if f_stringpreferences("AutoFiscalizeOnPosting") = "Y" then
									this.it_transobject.fiscalizesrinvoice(ll_outercounter, ll_salesmancode)
									if this.it_transobject.sqlcode <> 0 then
										ls_errtext = "Problem in Fiscalization for this invoice.~r~nReasons are:- " + this.it_transobject.sqlerrtext
										SQL rollback USING this.it_transobject;
										messagebox("Fiscalization Problem", ls_errtext)
									else
										SQL commit USING this.it_transobject;
									end if
								end if
								if f_stringpreferences("IncSRInActMonitor") = "Y" then
									this.it_transobject.updateactivitymonitor("SR", ll_outercounter)
									if this.it_transobject.sqlcode <> 0 then
										SQL rollback USING this.it_transobject;
										messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
									else
										SQL commit USING this.it_transobject;
										wf_allocatesalereturn(ll_outercounter, ll_saleinvcode, ldt_server_datetime, ll_salesmancode)
									end if
								end if
								if f_stringpreferences("ShowSRInCashierActivity") = "Y" then
									this.it_transobject.updatecashieractivity(this.ii_module, ll_outercounter)
									if this.it_transobject.sqlcode <> 0 then
										SQL rollback USING this.it_transobject;
										messagebox("Activity Monitor", "Problem in updating cashier activity.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
									else
										SQL commit USING this.it_transobject;
									end if
								end if
								if f_stringpreferences("ApplyLoyaltypolicyonsaleposting") = "Y" then
									this.it_transobject.manageloyaltypoints("SR", ll_outercounter)
									if this.it_transobject.sqlcode <> 0 then
										ls_errtext = "Problem in updating loyalty points for S/R Invoice No.:" + trim(string(ll_outercounter)) + ".~r~nReasons are:- " + this.it_transobject.sqlerrtext
										SQL rollback USING this.it_transobject;
										messagebox("Loyalty Points Updation", ls_errtext)
									else
										SQL commit USING this.it_transobject;
									end if
								end if
							end if
						else
							SQL rollback USING this.it_transobject;
							ll_errrowid = ll_outercounter
						end if
					end if
				end if
				ll_outercounter = ll_outercounter + 1
			loop
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if li_errcode <> 0 then
		messagebox("Posting Fails", ls_errtext + "~n~rIn invoice number " + string(ll_errrowid))
	else
		messagebox("Posting Successfull", "All rows have been posted successfully")
		if ll_setasactive_count > 0 then
			lds_items = create datastore
			lds_items.dataobject = "d_activemarkeditems"
			lds_items.settransobject(this.it_transobject)
			lds_items.reset()
			lds_items.retrieve(ll_activeitemslist)
			lstr_arg.ds = lds_items
			openwithparm(w_salereturn_activeitemlist, lstr_arg)
		end if
	end if
	return li_errcode

// w_salereturnbuffer.wf_saveandpost() returns 0
	integer li_postingmode = 2
	long ll_sinvcode
	long ll_linvcode
	long ll_retcode
	boolean lb_commitflag = true
	if not wf_iseditable() then
		return
	end if
	event ue_save()
	if this.ib_commitok then
		ll_sinvcode = this.id_master.getitemnumber(1, "code")
		ll_linvcode = this.id_master.getitemnumber(1, "code")
		if isnull(ll_sinvcode) or isnull(ll_linvcode) or ll_sinvcode < 0 and ll_linvcode < 0 then
			return
		else
			ll_retcode = wf_post_salereturn(li_postingmode, ll_sinvcode, ll_linvcode)
		end if
	end if
	setpointer(arrow!)

// w_salereturnbuffer.wf_set_itemtotal_formatmask() returns long
	string ls_modify
	string ls_format
	ls_format = trim(f_stringpreferences("FormatForAmtInSRet"))
	ls_modify = "c_itemtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_detaildwtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_finalitemval.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_sumfinalitemval.Format='" + ls_format + "'  "
	this.id_detail.modify(ls_modify)
	return 0

// w_salereturnbuffer.wf_getrecentexpiry(long al_icode, string as_batch, long al_row) returns long
	datetime ldt_expiry
	SQL SELECT Expiry INTO :ldt_expiry FROM DBO.PurDetail WHERE ICode =:al_icode AND Batch =:as_batch AND PurUtn IN ( SELECT PurUtn =MAX ( D.PurUtn ) FROM Dbo.PurDetail D WHERE D.ICode =:al_icode AND D.Batch =:as_batch ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ldt_expiry) then
			SQL SELECT Expiry INTO :ldt_expiry FROM DBO.ReceiptDetail WHERE ICode =:al_icode AND Batch =:as_batch AND ReceiptUtn IN ( SELECT PurUtn =MAX ( D.ReceiptUtn ) FROM Dbo.ReceiptDetail D WHERE D.ICode =:al_icode AND D.Batch =:as_batch ) USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if not isnull(ldt_expiry) then
					this.id_detail.setitem(al_row, "expiry", ldt_expiry)
				end if
			end if
		else
			this.id_detail.setitem(al_row, "expiry", ldt_expiry)
		end if
	end if
	return 0

// w_salereturnbuffer.wf_patient_retrieve() returns long
	long ll_prow
	long ll_pcode
	this.idc_patient.retrieve(this.ii_module)
	ll_prow = this.idc_patient.insertrow(0)
	setnull(ll_pcode)
	this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
	this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
	this.idc_patient.setitem(ll_prow, "name", "<NONE>")
	this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
	this.idc_patient.setitem(ll_prow, "city", "<NONE>")
	this.idc_patient.scrolltorow(ll_prow)
	return 0

// w_salereturnbuffer.wf_select_draft_printout(long al_invcode) returns long
	string ls_report
	string ls_filename
	long ll_row
	long ll_retcode
	if gs_company = "BAMBINOSTORE" then
		ls_report = "d_bambino_draftmode_sr_print_pos"
	end if
	if ls_report <> "" then
		this.id_print.dataobject = ls_report
		this.id_print.settransobject(sqlca)
		this.id_print.retrieve(al_invcode)
		ls_filename = "invoice.txt"
		ll_row = wf_save_saleinv_as_text(ls_filename)
		if ll_row > 0 then
			ll_retcode = 1
			run("invoice.bat", minimized!)
		else
			ll_retcode = 0
		end if
	else
		ll_retcode = 0
	end if
	return ll_retcode

// w_salereturnbuffer.wf_save_saleinv_as_text(string as_filename) returns long
	integer li_filehandle
	long ll_counter
	long ll_innercounter
	long ll_rowcount
	string ls_writetofile
	string ls_temp
	li_filehandle = fileopen(as_filename, linemode!, write!, lockwrite!, replace!)
	if li_filehandle > -1 then
		ll_rowcount = this.id_print.rowcount()
		if ll_rowcount > 0 then
			for ll_counter = 1 to 11
				ls_temp = "c_line" + trim(string(ll_counter))
				ls_writetofile = ""
				ls_writetofile = ls_writetofile + this.id_print.getitemstring(1, ls_temp)
				filewrite(li_filehandle, ls_writetofile)
			next
			ll_counter = 0
			for ll_counter = 1 to ll_rowcount
				ls_writetofile = ""
				ls_temp = "rowdetail"
				ls_writetofile = ls_writetofile + this.id_print.getitemstring(ll_counter, ls_temp)
				filewrite(li_filehandle, ls_writetofile)
			next
			for ll_counter = 1 to 16
				ls_writetofile = ""
				ls_temp = "footerrow" + trim(string(ll_counter))
				ls_writetofile = ls_writetofile + this.id_print.getitemstring(1, ls_temp)
				filewrite(li_filehandle, ls_writetofile)
			next
			for ll_counter = 1 to 10
				ls_writetofile = " "
				filewrite(li_filehandle, ls_writetofile)
			next
		end if
		fileclose(li_filehandle)
		return 1
	end if
	return 0

// w_salereturnbuffer.wf_selectprintreport(string as_invoicesize) returns string
	integer li_headerno
	string ls_pagesize
	string ls_report
	boolean lb_listtab
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab then
		li_headerno = this.id_list.getitemnumber(this.id_list.getrow(), "headerno")
	else
		li_headerno = this.id_master.getitemnumber(1, "headerno")
	end if
	ls_pagesize = as_invoicesize
	if ls_pagesize = "Q" then
		if gs_company = "HISKHI" then
			ls_report = "d_hiskhi_thermal_saleretinvreport"
		elseif gs_company = "COSMOSTORES" then
			ls_report = "d_cosmostores_srbufferretinvreport"
		elseif gs_company = "IHSCHILDRENHSP" then
			ls_report = "d_ihs_saleretbufferinvreport_quarter"
		else
			ls_report = "d_saleretbufferinvreport"
		end if
	elseif ls_pagesize = "F" then
		if gs_company = "CLINIXMS" or gs_company = "CLINIXSMARKET" or gs_company = "C1WAREHOUSE" then
			ls_report = "d_clinixms_saleretbufferinvreport_full"
		elseif gs_company = "SIDDIQUEDIST" or gs_company = "SIDDIQUECORPRTN" then
			ls_report = "d_siddist_srinvreport_full"
		elseif gs_company = "DFORDENUM" then
			ls_report = "d_dfordenum_saleretbufferinvreport_full"
		elseif gs_company = "SYNAPTICPHARMA" or gs_company = "AZMATBROTHERS" then
			ls_report = "d_synapticpharma_wholesaleretinvreport"
		elseif gs_company = "IHSCHILDRENHSP" then
			ls_report = "d_ihs_saleretbufferinvreport_full"
		elseif gs_company = "BISMILLAHSTORE" then
			ls_report = "d_bismillahstore_srtbufferinvreport_f"
		else
			ls_report = "d_saleretbufferinvreport_full"
		end if
	elseif ls_pagesize = "H" then
		if gs_company = "IHSCHILDRENHSP" then
			ls_report = "d_ihs_saleretbufferinvreport_half"
		else
			ls_report = "d_saleretbufferinvreport_half"
		end if
	elseif ls_pagesize = "T" then
		if gs_company = "BOMBAYCHOCNNUTS" then
			ls_report = "d_bombaychocnnuts_srbufferretinvreport"
		else
			ls_report = "d_thermal_srbufferretinvreport"
		end if
	else
		ls_report = "d_saleretbufferinvreport"
	end if
	if gs_company = "ALHARMAINLIGHTS" then
		ls_report = "d_alharmainlight_saleretbufferinvreport"
	end if
	if gs_company = "NOORTRADERS" then
		ls_report = "d_noortraders_saleretbufferinvreport"
	end if
	this.id_print.dataobject = ls_report
	f_set_headerlogo(this.id_print, li_headerno)
	this.id_print.settransobject(this.it_transobject)
	return ls_report

// w_salereturnbuffer.wf_check_save_right() returns long
	long ll_found
	if this.ib_checksaveright = true then
		ll_found = gds_securitywindow.find("rightcode = 700", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			return 1
		else
			messagebox("Problem in Saving Sale Return Invoice", "You donot have right to Save Sales Return Invoice.~r~nPress Ctrl + P  for Save and Print", information!, ok!)
			return 0
		end if
		return
	end if
	this.ib_checksaveright = true
	return 1

// w_salereturnbuffer.wf_fetchserverdate(boolean ab_checked) returns long
	if ab_checked then
		this.ib_fetchserverdate = true
	else
		this.ib_fetchserverdate = false
	end if
	return 0

// w_salereturnbuffer.wf_assign_master_cash_win_object() returns 0
	this.ids_cashwin = create u_ds_standard
	this.ids_cashwin.dataobject = "d_mastercashierwindow_detail"
	this.ids_cashwin.settransobject(this.it_transobject)

// w_salereturnbuffer.wf_set_cashaccount() returns long
	long ll_cashacccode
	long ll_module
	long ll_code
	ll_module = 33
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = f_is_group_module_cashaccount_allowed(this.il_groupcode, ll_module)
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		ll_cashacccode = 0
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
	elseif isnull(ll_code) or this.id_master.object.code[1] <= 0 then
		this.id_master.object.cashacccode[this.id_master.rowcount()] = ll_cashacccode
	else
		ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	end if
	return ll_cashacccode

// w_salereturnbuffer.wf_show_mastercashierwindow() returns long
	long ll_counter
	long ll_code
	long ll_row
	long ll_insrow
	long ll_module
	long ll_cashacccode
	double ld_tot_acc_amt
	string ls_cashtend
	string ls_invtotal
	s_mastercashwin_all lstr_values
	if this.is_callermodule <> "" then
		return 1
	end if
	lstr_values.i_interfacecode = 12
	ll_module = 33
	if f_stringpreferences("askmastercashwin_in_buffersr") = "N" then
		return 1
	end if
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
		return 0
	end if
	lstr_values.l_doccode = ll_code
	lstr_values.s_doctype = this.is_doctype
	lstr_values.l_cashacccode = ll_cashacccode
	lstr_values.l_groupcode = this.il_groupcode
	lstr_values.l_module = ll_module
	lstr_values.d_netamt = wf_grandtotal()
	lstr_values.d_cashtendered = this.id_master.object.cashtendered[this.id_master.rowcount()]
	lstr_values.d_cashcharged = this.id_master.object.cashcharged[this.id_master.rowcount()]
	lstr_values.d_cashback = this.id_master.object.cashback[this.id_master.rowcount()]
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		lstr_values.l_acccode[ll_counter] = this.ids_cashwin.object.acccode[ll_counter]
		lstr_values.s_remarks[ll_counter] = this.ids_cashwin.object.remarks[ll_counter]
		lstr_values.d_amount[ll_counter] = this.ids_cashwin.object.amount[ll_counter]
		lstr_values.l_rowid[ll_counter] = this.ids_cashwin.object.rowid[ll_counter]
		ld_tot_acc_amt = ld_tot_acc_amt + this.ids_cashwin.object.amount[ll_counter]
	next
	if lstr_values.d_netamt >= lstr_values.d_cashcharged then
		lstr_values.d_docbalance = lstr_values.d_netamt - lstr_values.d_cashcharged - ld_tot_acc_amt
	else
		lstr_values.d_docbalance = 0
	end if
	for ll_counter = 1 to 100
		if lstr_values.l_rowid[ll_counter] <= 0 then
			lstr_values.l_rowid[ll_counter] = -1
		end if
	next
	openwithparm(w_mastercashierwindow, lstr_values)
	lstr_values = message.powerobjectparm
	if lstr_values.i_status = 1 then
		this.ids_cashwin.reset()
		ld_tot_acc_amt = 0
		for ll_counter = 1 to 100
			if lstr_values.l_acccode[ll_counter] > 0 and lstr_values.d_amount[ll_counter] > 0 and lstr_values.l_rowid[ll_counter] > 0 then
				ll_insrow = this.ids_cashwin.insertrow(0)
				this.ids_cashwin.object.documentcode[ll_insrow] = ll_code
				this.ids_cashwin.object.documenttype[ll_insrow] = this.is_doctype
				this.ids_cashwin.object.acccode[ll_insrow] = lstr_values.l_acccode[ll_counter]
				this.ids_cashwin.object.remarks[ll_insrow] = lstr_values.s_remarks[ll_counter]
				this.ids_cashwin.object.amount[ll_insrow] = lstr_values.d_amount[ll_counter]
				this.ids_cashwin.object.rowid[ll_insrow] = lstr_values.l_rowid[ll_counter]
				ld_tot_acc_amt = ld_tot_acc_amt + lstr_values.d_amount[ll_counter]
			end if
		next
		this.id_master.object.cashacccode[this.id_master.rowcount()] = lstr_values.l_cashacccode
		this.id_master.object.cashtendered[this.id_master.rowcount()] = lstr_values.d_cashtendered
		this.id_master.object.cashcharged[this.id_master.rowcount()] = lstr_values.d_cashcharged
		this.id_master.object.cashback[this.id_master.rowcount()] = lstr_values.d_cashback
		this.id_master.object.outstandingamt[this.id_master.rowcount()] = wf_grandtotal() - (ld_tot_acc_amt + lstr_values.d_cashcharged)
		return 1
	end if
	return 0

// w_salereturnbuffer.wf_update_mastercashierwindow(long al_code, string as_type) returns long
	long ll_counter
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		this.ids_cashwin.object.documentcode[ll_counter] = al_code
		this.ids_cashwin.object.documenttype[ll_counter] = as_type
		this.ids_cashwin.object.date[ll_counter] = this.id_master.object.date[1]
	next
	SQL DELETE DBO.MasterCashWin WHERE DocumentCode =:al_code AND DocumentType =:as_type USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if this.ids_cashwin.update() > 0 then
			return 0
		else
			return -1
		end if
		return
	end if
	return -1

// w_salereturnbuffer.wf_validate_price_discount_matters(long al_usercode) returns long
	long ll_counter
	long ll_counter2
	long ll_icode
	long ll_custcode
	long ll_allowsalebelowavgprice
	long ll_masterrow
	double ld_invdiscperc
	double ld_flatdisc
	double ld_saleprice
	double ld_rate
	double ld_rpp
	double ld_discperc
	double ld_itemflatdisc
	double ld_unitsalestax
	double ld_itemgstperc
	double ld_invdisc
	double ld_invgstperc
	double ld_avgprice
	double ld_itemamount
	double ld_amountdiff
	double ld_clonesaleprice
	double ld_itemsalediscperc
	double ld_maxitemsalediscperc
	double ld_grossamt_rate_qty
	double ld_totaldiscount
	double ld_accumulateddiscperc
	double ld_qty
	double ld_actual_accumdiscperc
	boolean lb_validdisc
	datastore lds_groupdiscinfo
	wf_grandtotal()
	lds_groupdiscinfo = create datastore
	lds_groupdiscinfo.dataobject = "d_groups_discount"
	lds_groupdiscinfo.settransobject(this.it_transobject)
	lds_groupdiscinfo.retrieve(al_usercode)
	ld_invdiscperc = this.id_footer.getitemnumber(1, "discperc")
	ld_flatdisc = this.id_footer.getitemnumber(1, "flatdisc")
	lb_validdisc = false
	ll_masterrow = this.id_master.rowcount()
	for ll_counter = 1 to lds_groupdiscinfo.rowcount()
		ld_accumulateddiscperc = lds_groupdiscinfo.getitemnumber(ll_counter, "accumulateddiscperc")
		if ld_flatdisc <= lds_groupdiscinfo.getitemnumber(ll_counter, "saleinvflatdisc") then
			lb_validdisc = true
		end if
	next
	if lb_validdisc = false then
		messagebox("Flat Discount Validation", "Flat Discount is greater than your permission~r~n Please consult Administrator")
		this.id_footer.setfocus()
		this.id_footer.setcolumn("flatdisc")
		destroy lds_groupdiscinfo
		return -1
	end if
	ld_grossamt_rate_qty = 0
	ld_totaldiscount = 0
	for ll_counter = 1 to this.id_detail.rowcount()
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		ld_qty = this.id_detail.getitemnumber(ll_counter, "looseqty")
		ld_saleprice = this.id_detail.getitemnumber(ll_counter, "srprice")
		ld_rate = this.id_detail.getitemnumber(ll_counter, "saleprice")
		ld_discperc = this.id_detail.getitemnumber(ll_counter, "discperc")
		ld_unitsalestax = this.id_detail.getitemnumber(ll_counter, "unitsalestax")
		ld_itemgstperc = this.id_detail.getitemnumber(ll_counter, "gstperc")
		ld_invdisc = this.id_footer.getitemnumber(1, "discperc")
		ld_invgstperc = this.id_footer.getitemnumber(1, "invgstperc1")
		ld_avgprice = this.id_detail.getitemnumber(ll_counter, "avgprice")
		ld_itemamount = round(ld_saleprice * (1.0 - ld_discperc * 0.01), 2) - round(ld_saleprice * (1.0 - ld_discperc * 0.01), 2) * ld_invdiscperc * 0.01
		ld_amountdiff = ld_rate - ld_itemamount
		ld_clonesaleprice = ld_rate
		if ld_clonesaleprice = 0.0 or isnull(ld_clonesaleprice) then
			ld_clonesaleprice = 1
		end if
		ll_custcode = this.id_master.object.custcode[1]
		wf_getitemdiscounts(ll_icode, ll_custcode, ld_itemsalediscperc, ld_maxitemsalediscperc)
		lb_validdisc = false
		if f_stringpreferences("FroceMaxSaleDiscPerc") = "Y" and ld_amountdiff * 100.0 / ld_clonesaleprice > 0.0 then
			if ld_amountdiff * 100.0 / ld_clonesaleprice <= ld_maxitemsalediscperc then
				lb_validdisc = true
			end if
			if lb_validdisc = false then
				messagebox("Disc% Validation", "Disc% is greater than maximum sale discount (%) for this item i.e. " + trim(string(ld_maxitemsalediscperc)) + "%~r~n Please consult Administrator")
				this.id_detail.setfocus()
				this.id_detail.setrow(ll_counter)
				this.id_detail.setcolumn("itemname")
				destroy lds_groupdiscinfo
				return -1
			end if
			return
		end if
		if f_stringpreferences("saleavgpricecheck") = "N" and ll_allowsalebelowavgprice = 0 and ld_avgprice > ld_itemamount then
			messagebox("Price Validation", "Sale Return Price become less than AvgPrice~r~nPlease change Sale Return Price or Setting In Preferences")
			this.id_detail.setrow(ll_counter)
			destroy lds_groupdiscinfo
			return -1
		end if
		if ld_amountdiff * 100.0 / ld_clonesaleprice > 0.0 then
			lb_validdisc = false
			for ll_counter2 = 1 to lds_groupdiscinfo.rowcount()
				if ld_amountdiff * 100.0 / ld_clonesaleprice <= lds_groupdiscinfo.getitemnumber(ll_counter2, "saleitemdiscperc") then
					lb_validdisc = true
				elseif ld_amountdiff * 100.0 / ld_clonesaleprice <= ld_itemsalediscperc then
					lb_validdisc = true
				else
					lb_validdisc = false
				end if
			next
			if lb_validdisc = false then
				messagebox("Disc% Validation ..", "Disc% is greater than your group permission and~r~nItem Basicdata setting for Sale Discount i.e. " + trim(string(ld_itemsalediscperc)) + "%~r~nPlease consult Administrator")
				this.id_detail.setfocus()
				this.id_detail.setrow(ll_counter)
				this.id_detail.setcolumn("itemname")
				destroy lds_groupdiscinfo
				return -1
			end if
			return
		end if
	next
	destroy lds_groupdiscinfo
	return 0

// w_salereturnbuffer.wf_getitemdiscounts(long al_icode, long al_custcode, double ad_salediscperc, double ad_maxsalediscperc) returns long
	long ll_retcode
	SQL SELECT SaleDiscPerc =CASE ( SELECT DefaultItemDiscPerc FROM DBO.Customer WHERE CustCode =:al_custcode ) WHEN 1 THEN SaleDiscPerc WHEN 2 THEN SaleDiscPerc2 WHEN 3 THEN SaleDiscPerc3 WHEN 4 THEN SaleDiscPerc4 WHEN 5 THEN SaleDiscPerc5 ELSE 0 END , MaxSaleDiscPerc INTO :ad_salediscperc, :ad_maxsalediscperc FROM item WHERE ICode =:al_icode USING sqlca;
	if sqlca.sqlcode = 0 then
		ll_retcode = 0
	else
		ll_retcode = -1
	end if
	return ll_retcode

// w_salereturnbuffer.wf_findfullcode(string as_fullcode, long al_icode, string as_itemname, long al_itemcodetype) returns long
	long ll_retflag
	long ll_rowid
	setnull(al_icode)
	as_itemname = "                                                            "
	if this.id_master.object.saleinvcode[1] > 0 then
		ll_rowid = this.id_itemslist.find("fullcode = '" + as_fullcode + "'", 1, this.id_itemslist.rowcount())
		if ll_rowid > 0 and ll_rowid <= this.id_itemslist.rowcount() then
			al_icode = this.id_itemslist.getitemnumber(ll_rowid, "icode")
			as_itemname = this.id_itemslist.getitemstring(ll_rowid, "itemname")
			this.id_itemslist.setrow(ll_rowid)
			ll_retflag = 1
		else
			ll_retflag = 0
		end if
	else
		this.it_transobject.getaliasname(gl_usercode, as_fullcode, al_icode, as_itemname, al_itemcodetype)
		if this.it_transobject.sqlcode = 0 then
			if isnull(al_icode) then
				ll_retflag = 0
			else
				ll_retflag = 1
			end if
		else
			ll_retflag = -1
		end if
	end if
	return ll_retflag

// w_salereturnbuffer.wf_pd_initialize() returns long
	string ls_init_string
	ls_init_string = char(27) + char(73) + char(12)
	pd_writepd(ls_init_string, len(ls_init_string))
	return 0

// w_salereturnbuffer.wf_findpatientcode(string as_regno, long al_patientcode) returns integer
	long ll_patientcode
	long ll_retflag
	string ls_itemname
	SQL SELECT patient.patientcode INTO :ll_patientcode FROM patient WHERE patient.regno =:as_regno and active ='Y' and patient.patientcatcode in ( select distinct patientcatcode from patientcatallowedmodule where moduleid =:this.ii_module ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_patientcode = ll_patientcode
		if isnull(al_patientcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_salereturnbuffer.wf_findguestcode(string as_regno, long al_code) returns long
	long ll_guestcode
	long ll_retflag
	string ls_itemname
	char lc_active
	ll_retflag = 0
	SQL SELECT Guest.Guestcode , Guest.active INTO :ll_guestcode, :lc_active FROM Guest WHERE Guest.regno =:as_regno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_code = ll_guestcode
		if isnull(al_code) then
			ll_retflag = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
		else
			ll_retflag = -2
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_salereturnbuffer.wf_findstudentcode(string as_regno, long al_code) returns long
	long ll_studentcode
	long ll_retflag
	string ls_itemname
	char lc_active
	ll_retflag = 0
	SQL SELECT Student.Studentcode INTO :ll_studentcode FROM Student WHERE Student.regno =:as_regno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_code = ll_studentcode
		if isnull(al_code) then
			ll_retflag = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
		else
			ll_retflag = -2
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_salereturnbuffer.wf_guest_retrieve() returns long
	long ll_row
	long ll_code
	this.idc_guest.retrieve()
	ll_row = this.idc_guest.insertrow(0)
	setnull(ll_code)
	this.idc_guest.setitem(ll_row, "code", ll_code)
	this.idc_guest.setitem(ll_row, "regno", "<NONE>")
	this.idc_guest.setitem(ll_row, "guest", "<NONE>")
	this.idc_guest.setitem(ll_row, "customer", "<NONE>")
	this.idc_guest.scrolltorow(ll_row)
	return 0

// w_salereturnbuffer.wf_student_retireve() returns long
	long ll_row
	long ll_code
	this.idc_student.retrieve()
	ll_row = this.idc_student.insertrow(0)
	setnull(ll_code)
	this.idc_student.setitem(ll_row, "code", ll_code)
	this.idc_student.setitem(ll_row, "regno", "<NONE>")
	this.idc_student.setitem(ll_row, "student", "<NONE>")
	this.idc_student.setitem(ll_row, "customer", "<NONE>")
	this.idc_student.scrolltorow(ll_row)
	return 0

// w_salereturnbuffer.wf_setguestcheckin() returns long
	long ll_guestcode
	long ll_guestcheckincode
	long ll_found
	setnull(ll_guestcheckincode)
	ll_guestcode = this.id_master.object.guestcode[1]
	if ll_guestcode > 0 then
		SQL SELECT MAX ( GC.GuestCheckInCode ) INTO :ll_guestcheckincode FROM GuestCheckIn GC WHERE GC.GuestCode =:ll_guestcode AND GC.CheckOut ='N' USING this.it_transobject;
		if ll_guestcheckincode = 0 or isnull(ll_guestcheckincode) then
			setnull(ll_guestcheckincode)
		end if
		this.id_master.object.guestcheckincode[1] = ll_guestcheckincode
	else
		this.id_master.object.guestcheckincode[1] = ll_guestcheckincode
	end if
	return 0

// w_salereturnbuffer.wf_is_batch_already_returned(long al_icode, string as_batch, datetime adt_expiry, string as_errtext) returns long
	long ll_count
	long ll_invcode
	long ll_code
	as_errtext = ""
	ll_code = this.id_master.object.code[1]
	if ll_code > 0 then
		SQL SELECT ISNULL ( Count ( *) , 0 ) , ISNULL ( MAX ( SRBufferInvCode ) , 0 ) INTO :ll_count, :ll_invcode FROM SRBufferDetail WHERE SRBufferInvCode <> :ll_code AND ICode =:al_icode AND Batch =:as_batch AND Expiry =:adt_expiry USING this.it_transobject;
	else
		SQL SELECT ISNULL ( Count ( *) , 0 ) , ISNULL ( MAX ( SRBufferInvCode ) , 0 ) INTO :ll_count, :ll_invcode FROM SRBufferDetail WHERE ICode =:al_icode AND Batch =:as_batch AND Expiry =:adt_expiry USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		if ll_count = 0 then
			return 0
		else
			as_errtext = "Some Returns Already Exist for this Item Batch/Expiry~r~nPlease Enter Some Other Batch No.~r~nLast S/R No. " + string(ll_invcode)
			return 1
		end if
		return
	end if
	as_errtext = "Problem Checking Existing Returns for this Item Batch/Expiry.~r~nDetails are:-~r~n" + this.it_transobject.sqlerrtext
	return 1

// w_salereturnbuffer.wf_validate_qty_bonus() returns long
	long ll_counter
	long ll_round_qty
	double ld_looseqty
	double ld_bonusqty
	double ld_truncateqty
	boolean lb_commitflag = true
	ll_round_qty = f_get_colprecision("Qty")
	for ll_counter = 1 to this.id_detail.rowcount()
		ld_looseqty = round(this.id_detail.object.looseqty[ll_counter], ll_round_qty)
		ld_bonusqty = round(this.id_detail.object.bonusqty[ll_counter], ll_round_qty)
		ld_truncateqty = truncate(ld_looseqty + 0.0000001, ll_round_qty)
		if ld_looseqty <> ld_truncateqty then
			this.id_detail.setrow(ll_counter)
			this.id_detail.scrolltorow(ll_counter)
			messagebox("Qty Precision Error", "Invalid Qty as per its column setting")
			lb_commitflag = false
			exit
		end if
		ld_truncateqty = truncate(ld_bonusqty + 0.0000001, ll_round_qty)
		if ld_bonusqty <> ld_truncateqty then
			this.id_detail.setrow(ll_counter)
			this.id_detail.scrolltorow(ll_counter)
			messagebox("Bonus Precision Error", "Invalid Bonus as per its column setting")
			lb_commitflag = false
			exit
		end if
	next
	if lb_commitflag = false then
		return -1
	end if
	return 0

// w_salereturnbuffer.wf_validate_pcs(long row, string data) returns long
	long ll_errcode
	long ll_found
	long ll_icode
	long ll_salerowid
	long ll_saleinvcode
	double ld_storedpcs
	double ld_areavolume
	double ld_pcs
	double ld_packcapacity
	double ld_tmpqty
	double ld_retableqty
	double ld_itemprevqty
	double ld_itemprevbonusqty
	integer li_roundupto
	string ls_null
	string ls_batch
	datetime ldt_expiry
	setnull(ls_null)
	ld_storedpcs = this.id_detail.object.pcs[row]
	ld_packcapacity = this.id_detail.object.packcapacity[row]
	if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
		ld_packcapacity = 1
	end if
	ld_areavolume = this.id_detail.object.areavolume[row]
	if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
		ld_areavolume = 1
	end if
	ld_pcs = double(data)
	li_roundupto = f_get_colprecision("Qty")
	ld_tmpqty = round(ld_pcs * ld_areavolume, li_roundupto)
	if ld_pcs > 0.0 then
		ld_retableqty = this.id_detail.getitemnumber(row, "retableqty")
		ll_saleinvcode = this.id_master.getitemnumber(1, "saleinvcode")
		if ll_saleinvcode > 0 then
			ll_icode = this.id_detail.getitemnumber(row, "icode")
			ll_salerowid = this.id_detail.getitemnumber(row, "salerowid")
			ldt_expiry = this.id_detail.getitemdatetime(row, "expiry")
			ls_batch = this.id_detail.getitemstring(row, "batch")
			wf_oninvoiceitemprevqty(row, ll_icode, ll_salerowid, ld_itemprevqty, ld_itemprevbonusqty, ls_batch, ldt_expiry)
		else
			ld_itemprevqty = 0
			ld_itemprevbonusqty = 0
		end if
		if ld_tmpqty + ld_itemprevqty > ld_retableqty and ll_saleinvcode > 0 then
			ll_errcode = 1
			messagebox("Quantity Validation", "PCS converted into Qty resulted in over return of this item.~r~nQty Should be less than " + string(ld_retableqty))
			this.id_detail.object.pcs[row] = ld_storedpcs
		else
			this.id_detail.setitem(row, "looseqty", ld_tmpqty)
			this.id_detail.setitem(row, "cartons", trim(string(long(ld_pcs / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(ld_pcs mod ld_packcapacity, 2))))))
		end if
	else
		ll_errcode = 1
		messagebox("PCS Validation", "Only possitive PCS are allowed for this item", stopsign!)
	end if
	return ll_errcode

// w_salereturnbuffer.wf_replace_postdate_with_date() returns long
	string ls_errtext = "                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ."
	s_arguements lstr_arg
	if f_rightexists(5164) then
		open(w_arg_sinvcode_linvcode)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = 1 then
			SQL update SRBufferLedger SET PostDate =Date WHERE SRBufferInvCode BETWEEN :lstr_arg.l_code1 AND :lstr_arg.l_code2 USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				SQL update SRLedger SET PostDate =Date WHERE SRInvCode BETWEEN :lstr_arg.l_code1 AND :lstr_arg.l_code2 USING this.it_transobject;
				if this.it_transobject.sqlcode = 0 then
					SQL commit USING this.it_transobject;
				else
					ls_errtext = this.it_transobject.sqlerrtext
					SQL rollback USING this.it_transobject;
					messagebox("Sale Return Posting Date Updation Error", "Error in Updating Posting Date for Selected Sales Returns.~r~nReasons are:-~r~n" + ls_errtext, stopsign!)
				end if
			else
				ls_errtext = this.it_transobject.sqlerrtext
				SQL rollback USING this.it_transobject;
				messagebox("Sale Return Buffer Posting Date Updation Error", "Error in Updating Posting Date for Selected Sales Return Buffer.~r~nReasons are:-~r~n" + ls_errtext, stopsign!)
			end if
		end if
	end if
	return 0

// w_salereturnbuffer.wf_check_unique_refno() returns long
	long ll_custcode
	long ll_invid
	long ll_counter
	string ls_refno
	if f_stringpreferences("UniqueRefNoInSale") = "Y" then
		ls_refno = this.id_master.getitemstring(1, "custrefno")
		if trim(ls_refno) <> "" and not isnull(ls_refno) and (this.ii_salerettype = 7 or this.ii_salerettype = 1) and isnull(this.id_master.object.saleinvcode[1]) then
			ll_custcode = this.id_master.getitemnumber(1, "custcode")
			ll_counter = 0
			ll_invid = 0
			ll_invid = this.id_master.getitemnumber(1, "code")
			if ll_invid > 0 then
				SQL SELECT COUNT ( *) INTO :ll_counter FROM srledger WHERE custcode =:ll_custcode AND srledger.srinvcode <> :ll_invid AND RTrim ( LTrim ( custrefno ) ) =RTrim ( LTrim ( :ls_refno ) ) USING this.it_transobject;
			else
				SQL SELECT COUNT ( *) INTO :ll_counter FROM srledger WHERE custcode =:ll_custcode AND RTrim ( LTrim ( custrefno ) ) =RTrim ( LTrim ( :ls_refno ) ) USING this.it_transobject;
			end if
			if ll_counter > 0 then
				messagebox("Ref. validation", "Ref. No " + ls_refno + " already exist for selected customer ~r~nplease type a unique Ref.No. ")
				this.id_master.setcolumn("custrefno")
				this.id_master.setfocus()
				return 0
			end if
			return
		end if
		return
	end if
	return 1

// w_salereturnbuffer.wf_setgodownoption() returns 0
	this.ii_salegodown = this.id_detail.getitemnumber(1, "gcode")
	if this.il_strategy = 2 or this.il_strategy = 1 and this.il_godowncount = 1 then
		this.id_detail.object.gcode.protect = 1
		this.id_detail.object.gcode.background.color = this.backcolor
	end if

// w_salereturnbuffer.wf_copyinvoice() returns long
	datastore lds_saletemplatedetail
	datastore lds_saletemplateheader
	s_saletemplate lstr_template
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	boolean lb_bonus
	boolean lb_salepricefromtemplate
	long ll_row
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrows
	long ll_packunits
	long ll_found
	long ll_innercounter
	integer li_retcode = 1
	integer li_errcode
	integer li_counter
	integer li_addbonusinqty
	double ld_looseqty
	double ld_holdbonusqty
	double ld_holdqty
	datawindowchild ldc_godown
	if wf_iseditable() = false then
		return 0
	end if
	if not isnull(this.id_master.object.saleinvcode[1]) then
		return 0
	end if
	lds_saletemplatedetail = create datastore
	lds_saletemplateheader = create datastore
	open(w_copysaleinvoicefrom3)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		destroy lds_saletemplatedetail
		return -1
	end if
	if lstr_template.c_copyinvfrom = "I" then
		lds_saletemplatedetail.dataobject = "d_SaleDetail"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		lds_saletemplateheader.dataobject = "d_WholeSaleHeader"
		lds_saletemplateheader.settransobject(this.it_transobject)
		li_retcode = lds_saletemplateheader.retrieve(lstr_template.l_invtemplate)
		if li_retcode > 0 then
			ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
			if ll_totalrows < 0 then
				li_retcode = -1
			end if
			ll_totalrows = lds_saletemplatedetail.rowcount()
			if ll_totalrows > 0 then
				lb_enablesave = true
			end if
			for li_counter = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
			this.id_master.object.aliasname[1] = lds_saletemplateheader.object.aliasname[1]
			this.id_master.object.custcode[1] = lds_saletemplateheader.object.custcode[1]
			this.id_master.object.patientregno[1] = lds_saletemplateheader.object.patientregno[1]
			this.id_master.object.patientcode[1] = lds_saletemplateheader.object.patientcode[1]
			this.id_master.object.remarks[1] = lds_saletemplateheader.object.remarks[1]
			this.id_master.object.custrefno[1] = lds_saletemplateheader.object.custrefno[1]
			this.id_master.object.flatdisc[1] = lds_saletemplateheader.object.flatdisc[1]
			this.id_master.object.discperc[1] = lds_saletemplateheader.object.discperc[1]
			this.id_master.object.misccharges[1] = lds_saletemplateheader.object.misccharges[1]
			this.id_master.object.invgstperc1[1] = lds_saletemplateheader.object.invgstperc1[1]
			for ll_rowcount = 1 to ll_totalrows
				ll_row = this.id_detail.insertrow(0)
				wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_row, ls_errortext)
				this.id_detail.setitem(ll_row, "batch", lds_saletemplatedetail.getitemstring(ll_rowcount, "batch"))
				this.id_detail.setitem(ll_row, "expiry", lds_saletemplatedetail.getitemdatetime(ll_rowcount, "expiry"))
				this.id_detail.setitem(ll_row, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "looseqty"))
				this.id_detail.setitem(ll_row, "bonusqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "bonusqty"))
				this.id_detail.setitem(ll_row, "srprice", lds_saletemplatedetail.getitemnumber(ll_rowcount, "saleprice") - lds_saletemplatedetail.getitemnumber(ll_rowcount, "itemflatdisc"))
				this.id_detail.setitem(ll_row, "discperc", lds_saletemplatedetail.getitemnumber(ll_rowcount, "discperc"))
				this.id_detail.setitem(ll_row, "gstperc", lds_saletemplatedetail.getitemnumber(ll_rowcount, "gstperc"))
				this.id_detail.setitem(ll_row, "unitsalestax", lds_saletemplatedetail.getitemnumber(ll_rowcount, "unitsalestax"))
			next
		end if
	elseif lstr_template.c_copyinvfrom = "R" then
		lds_saletemplatedetail.dataobject = "d_OpenWholeSaleReturnDetail"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		lds_saletemplateheader.dataobject = "d_OpenWholeSaleReturn"
		lds_saletemplateheader.settransobject(this.it_transobject)
		li_retcode = lds_saletemplateheader.retrieve(lstr_template.l_invtemplate)
		if li_retcode > 0 then
			li_retcode = lds_saletemplatedetail.getchild("gcode", ldc_godown)
			ldc_godown.settransobject(this.it_transobject)
			li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
			ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
			if ll_totalrows < 0 then
				li_retcode = -1
			end if
			ll_totalrows = lds_saletemplatedetail.rowcount()
			if ll_totalrows > 0 then
				lb_enablesave = true
			end if
			for li_counter = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
			this.id_master.object.aliasname[1] = lds_saletemplateheader.object.aliasname[1]
			this.id_master.object.custcode[1] = lds_saletemplateheader.object.custcode[1]
			this.id_master.object.patientregno[1] = lds_saletemplateheader.object.patientregno[1]
			this.id_master.object.patientcode[1] = lds_saletemplateheader.object.patientcode[1]
			this.id_master.object.remarks[1] = lds_saletemplateheader.object.remarks[1]
			this.id_master.object.custrefno[1] = lds_saletemplateheader.object.custrefno[1]
			this.id_master.object.flatdisc[1] = lds_saletemplateheader.object.flatdisc[1]
			this.id_master.object.discperc[1] = lds_saletemplateheader.object.discperc[1]
			this.id_master.object.misccharges[1] = lds_saletemplateheader.object.misccharges[1]
			this.id_master.object.invgstperc1[1] = lds_saletemplateheader.object.invgstperc1[1]
			for ll_rowcount = 1 to ll_totalrows
				ll_row = this.id_detail.insertrow(0)
				wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_row, ls_errortext)
				this.id_detail.setitem(ll_row, "batch", lds_saletemplatedetail.getitemstring(ll_rowcount, "batch"))
				this.id_detail.setitem(ll_row, "expiry", lds_saletemplatedetail.getitemdatetime(ll_rowcount, "expiry"))
				this.id_detail.setitem(ll_row, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "looseqty"))
				this.id_detail.setitem(ll_row, "bonusqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "bonusqty"))
				this.id_detail.setitem(ll_row, "srprice", lds_saletemplatedetail.getitemnumber(ll_rowcount, "srprice"))
				this.id_detail.setitem(ll_row, "discperc", lds_saletemplatedetail.getitemnumber(ll_rowcount, "discperc"))
				this.id_detail.setitem(ll_row, "gstperc", lds_saletemplatedetail.getitemnumber(ll_rowcount, "gstperc"))
				this.id_detail.setitem(ll_row, "unitsalestax", lds_saletemplatedetail.getitemnumber(ll_rowcount, "unitsalestax"))
			next
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	destroy lds_saletemplatedetail
	destroy lds_saletemplateheader
	return li_retcode

// w_salereturnbuffer.wf_fiscalizesrinvoices() returns long
	return 0

// w_salereturnbuffer.wf_fiscalizesrinvoice() returns long
	return 0

// w_salereturnbuffer.wf_apply_pricepolicy(integer ai_mode) returns long
	long ll_custcode
	long ll_masterrow
	long ll_detailrows
	long ll_found
	long ll_counter
	long ll_retcode
	long ll_rowcount
	long ll_icode
	long ll_manualprice_itemcount
	double ld_looseqty
	double ld_bonusqty
	double ld_policy_price
	double ld_price
	string ls_msgtitle = "Price Policy Implementation"
	string ls_itemname
	string ls_msgdetail
	string ls_finditem
	boolean lb_editsaleprice
	datastore lds_itemdetail
	datawindowchild ldc_godown
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_custcode = this.id_master.getitemnumber(ll_masterrow, "custcode")
	if ll_custcode = 0 or isnull(ll_custcode) then
		messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Items before applying Price Policy to this invoice", stopsign!)
		return 0
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 511", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editsaleprice = true
	else
		messagebox(ls_msgtitle, "Not enough rights to modify item sale price.~r~nPlease contact system administrator for help", stopsign!)
		return 0
	end if
	setredraw(false)
	lds_itemdetail = create datastore
	lds_itemdetail.dataobject = this.id_detail.dataobject
	lds_itemdetail.settransobject(this.it_transobject)
	ll_retcode = lds_itemdetail.getchild("gcode", ldc_godown)
	if ll_retcode = -1 then
		messagebox("datawindow child", "can not get datawindow child for colum name= godown")
	end if
	ldc_godown.settransobject(this.it_transobject)
	ldc_godown.insertrow(0)
	for ll_counter = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		ls_finditem = "icode = " + string(ll_icode)
		ll_found = lds_itemdetail.find(ls_finditem, 1, lds_itemdetail.rowcount())
		if ll_found > 0 and ll_found <= lds_itemdetail.rowcount() then
			lds_itemdetail.object.looseqty[ll_found] = lds_itemdetail.object.looseqty[ll_found] + this.id_detail.object.looseqty[ll_counter]
			lds_itemdetail.object.bonusqty[ll_found] = lds_itemdetail.object.bonusqty[ll_found] + this.id_detail.object.bonusqty[ll_counter]
		elseif lds_itemdetail.rowcount() = 0 then
			this.id_detail.rowscopy(ll_counter, ll_counter, primary!, lds_itemdetail, 1, primary!)
		else
			this.id_detail.rowscopy(ll_counter, ll_counter, primary!, lds_itemdetail, lds_itemdetail.rowcount(), primary!)
		end if
	next
	ll_detailrows = lds_itemdetail.rowcount()
	ll_counter = 0
	for ll_counter = 1 to ll_detailrows
		ll_icode = lds_itemdetail.object.icode[ll_counter]
		ls_itemname = lds_itemdetail.object.itemname[ll_counter]
		ld_looseqty = lds_itemdetail.object.looseqty[ll_counter]
		ld_price = lds_itemdetail.object.srprice[ll_counter]
		if ld_looseqty > 0.0 and ll_icode >= 0 and not isnull(ll_icode) then
			ld_policy_price = 0
			this.it_transobject.getpricepolicybased_itemprice(gl_usercode, ll_icode, ld_looseqty, ld_policy_price)
			if this.it_transobject.sqlcode = 0 then
				if not isnull(ld_policy_price) then
					lds_itemdetail.object.saleprice[ll_counter] = round(ld_policy_price, 2)
				end if
			else
				ls_msgdetail = "Some Problem Occured while fetching item Price policy details~r~n" + this.it_transobject.sqlerrtext
				messagebox(ls_msgtitle, ls_msgdetail, stopsign!)
				return 0
			end if
			return
		end if
	next
	ll_detailrows = this.id_detail.rowcount()
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ld_looseqty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		ld_price = this.id_detail.getitemnumber(ll_rowcount, "srprice")
		if ld_looseqty > 0.0 and ll_icode >= 0 and not isnull(ll_icode) then
			ls_finditem = "icode = " + string(ll_icode)
			ll_found = lds_itemdetail.find(ls_finditem, 1, lds_itemdetail.rowcount())
			if ll_found > 0 and ll_found <= lds_itemdetail.rowcount() then
				this.id_detail.object.srprice[ll_rowcount] = lds_itemdetail.object.saleprice[ll_found]
			else
				ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname
				ll_manualprice_itemcount = ll_manualprice_itemcount + 1
			end if
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_manualprice_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Price Policy exists for Following " + trim(string(ll_manualprice_itemcount)) + " item(s)~r~nTheir Pricing should be set by user manually~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_salereturnbuffer.wf_link_to_cashiershift() returns long
	long ll_cashiershiftcode
	if f_stringpreferences("CashierShift") = "Y" then
		this.id_master.object.cashiershiftcode.visible = true
		SQL SELECT MAX ( A.CashierShiftCode ) INTO :ll_cashiershiftcode FROM ( SELECT CashierShiftCode =CashierShiftCode FROM CashierShift WHERE ShiftStatus ='O' AND ShiftOwner =:gl_usercode UNION SELECT CashierShiftCode =CashierShiftCode FROM CashierShiftUsers WHERE UserCode =:gl_usercode AND CashierShiftCode IN ( SELECT CashierShiftCode FROM CashierShift WHERE ShiftStatus ='O' ) ) A USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if ll_cashiershiftcode < 0 then
				ll_cashiershiftcode = -1
			end if
		else
			ll_cashiershiftcode = -1
		end if
	else
		ll_cashiershiftcode = -1
	end if
	if ll_cashiershiftcode = -1 then
		setnull(ll_cashiershiftcode)
	end if
	this.id_master.object.cashiershiftcode[1] = ll_cashiershiftcode
	return 0

// w_salereturnbuffer.wf_check_cashiershift_on_saving(long al_cashiershiftcode, long al_usercode) returns long
	long ll_cashiershiftcode
	long ll_cashacccode
	if f_stringpreferences("CashierShift") = "Y" then
		this.id_master.object.cashiershiftcode.visible = true
		SQL SELECT MAX ( A.CashierShiftCode ) INTO :ll_cashiershiftcode FROM ( SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND ShiftOwner =:al_usercode AND CashierShiftCode =:al_cashiershiftcode UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShiftUsers WHERE UserCode =:al_usercode AND CashierShiftCode IN ( SELECT MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND CashierShiftCode =:al_cashiershiftcode ) UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND ShiftOwner =:al_usercode UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShiftUsers WHERE UserCode =:al_usercode AND CashierShiftCode IN ( SELECT MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' ) ) A USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if ll_cashiershiftcode < 0 then
				ll_cashiershiftcode = -1
			end if
		else
			ll_cashiershiftcode = -1
		end if
	else
		ll_cashiershiftcode = -1
	end if
	if ll_cashiershiftcode = -1 then
		setnull(ll_cashiershiftcode)
	end if
	this.id_master.object.cashiershiftcode[1] = ll_cashiershiftcode
	if ll_cashiershiftcode > 0 then
		SQL SELECT CashAccCode INTO :ll_cashacccode FROM CashierShift WHERE CashierShiftCode =:ll_cashiershiftcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.id_master.object.cashacccode[1] = ll_cashacccode
		end if
	end if
	if f_stringpreferences("CashierShift") = "Y" and isnull(ll_cashiershiftcode) then
		messagebox("Cashier Shift Linkage Missing", "Cashier Shift Linkage Missing~r~nContact System Administrator and try again.", stopsign!)
		return -1
	end if
	return 0

// w_salereturnbuffer.wf_fetch_latest_itemsalesinfo(long al_row, long al_icode) returns long
	long ll_saleinvcode
	long ll_packunits
	double ld_unitsalestax
	double ld_srprice
	double ld_gstperc
	string ls_alternatecustomicode
	ls_alternatecustomicode = this.id_detail.object.alternatecustomicode[al_row]
	if len(ls_alternatecustomicode) > 0 then
		SQL SELECT SaleInvCode =MAX ( SL.SaleInvCode ) , AlternateCustomICode =MAX ( SD.AlternateCustomICode ) , Packunits =MAX ( SD.PackUnits ) , SRPrice =MAX ( ROUND ( ( SD.SalePrice - SD.ItemFlatDisc ) *( 1 - SD.DiscPerc *0.01 ) *( 1 - SL.DiscPerc *0.01 ) , 2 ) ) , UnitSalesTax =MAX ( SD.UnitSalesTax ) , GSTPerc =MAX ( SD.GSTPerc ) INTO :ll_saleinvcode, :ls_alternatecustomicode, :ll_packunits, :ld_srprice, :ld_unitsalestax, :ld_gstperc FROM SaleDetail SD , SaleLedger SL WHERE SD.SaleInvCode IN ( SELECT SaleInvCode =MAX ( D.SaleInvCode ) FROM SaleDetail D WHERE D.ICode =:al_icode AND D.AlternateCustomIcode =:ls_alternatecustomicode ) AND SD.ICode =:al_icode AND SD.SaleInvCode =SL.SaleInvCode USING this.it_transobject;
	else
		SQL SELECT SaleInvCode =MAX ( SL.SaleInvCode ) , AlternateCustomICode =MAX ( SD.AlternateCustomICode ) , Packunits =MAX ( SD.PackUnits ) , SRPrice =MAX ( ROUND ( ( SD.SalePrice - SD.ItemFlatDisc ) *( 1 - SD.DiscPerc *0.01 ) *( 1 - SL.DiscPerc *0.01 ) , 2 ) ) , UnitSalesTax =MAX ( SD.UnitSalesTax ) , GSTPerc =MAX ( SD.GSTPerc ) INTO :ll_saleinvcode, :ls_alternatecustomicode, :ll_packunits, :ld_srprice, :ld_unitsalestax, :ld_gstperc FROM SaleDetail SD , SaleLedger SL WHERE SD.SaleInvCode IN ( SELECT SaleInvCode =MAX ( D.SaleInvCode ) FROM SaleDetail D WHERE D.ICode =:al_icode ) AND SD.ICode =:al_icode AND SD.SaleInvCode =SL.SaleInvCode USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		if ll_saleinvcode <= 0 or isnull(ll_saleinvcode) then
			if len(ls_alternatecustomicode) > 0 then
				SQL SELECT SaleInvCode =MAX ( SL.SaleInvCode ) , AlternateCustomICode =MAX ( SD.AlternateCustomICode ) , Packunits =MAX ( SD.PackUnits ) , SRPrice =MAX ( ROUND ( ( SD.SalePrice - SD.ItemFlatDisc ) *( 1 - SD.DiscPerc *0.01 ) *( 1 - SL.DiscPerc *0.01 ) , 2 ) ) , UnitSalesTax =MAX ( SD.UnitSalesTax ) , GSTPerc =MAX ( SD.GSTPerc ) INTO :ll_saleinvcode, :ls_alternatecustomicode, :ll_packunits, :ld_srprice, :ld_unitsalestax, :ld_gstperc FROM SaleDetailDump SD , SaleLedgerDump SL WHERE SD.SaleInvCode IN ( SELECT SaleInvCode =MAX ( D.SaleInvCode ) FROM SaleDetailDump D WHERE D.ICode =:al_icode AND D.AlternateCustomIcode =:ls_alternatecustomicode ) AND SD.ICode =:al_icode AND SD.SaleInvCode =SL.SaleInvCode USING this.it_transobject;
			else
				SQL SELECT SaleInvCode =MAX ( SL.SaleInvCode ) , AlternateCustomICode =MAX ( SD.AlternateCustomICode ) , Packunits =MAX ( SD.PackUnits ) , SRPrice =MAX ( ROUND ( ( SD.SalePrice - SD.ItemFlatDisc ) *( 1 - SD.DiscPerc *0.01 ) *( 1 - SL.DiscPerc *0.01 ) , 2 ) ) , UnitSalesTax =MAX ( SD.UnitSalesTax ) , GSTPerc =MAX ( SD.GSTPerc ) INTO :ll_saleinvcode, :ls_alternatecustomicode, :ll_packunits, :ld_srprice, :ld_unitsalestax, :ld_gstperc FROM SaleDetailDump SD , SaleLedgerDump SL WHERE SD.SaleInvCode IN ( SELECT SaleInvCode =MAX ( D.SaleInvCode ) FROM SaleDetail D WHERE D.ICode =:al_icode ) AND SD.ICode =:al_icode AND SD.SaleInvCode =SL.SaleInvCode USING this.it_transobject;
			end if
		end if
		if ld_srprice <= 0.0 or isnull(ld_srprice) then
			ld_srprice = 0
		end if
		if ld_unitsalestax <= 0.0 or isnull(ld_unitsalestax) then
			ld_unitsalestax = 0
		end if
		if ll_packunits <= 0 or isnull(ll_packunits) then
			ll_packunits = 1
		end if
		if ld_gstperc <= 0.0 or isnull(ld_gstperc) then
			ld_gstperc = 0
		end if
		this.id_detail.object.alternatecustomicode[al_row] = ls_alternatecustomicode
		this.id_detail.object.srprice[al_row] = round(ld_srprice, 2)
		this.id_detail.object.unitsalestax[al_row] = round(ld_unitsalestax, 2)
		this.id_detail.object.gstperc[al_row] = round(ld_gstperc, 2)
		return 0
	end if
	if this.it_transobject.sqlcode = 100 then
		return -1
	end if
	return -1

// w_salereturnbuffer.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_salereturnmenu" then
		this.menuid = create m_salereturnmenu
	end if
	this.dw_print = create dw_print
	this.dw_srmaster = create dw_srmaster
	this.dw_srdetail = create dw_srdetail
	this.ic_cashdrawerprinter = create ic_cashdrawerprinter
	this.ic_cashdrawer = create ic_cashdrawer
	this.ic_comport = create ic_comport
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print
	this.control[icurrent + 2] = this.dw_srmaster
	this.control[icurrent + 3] = this.dw_srdetail
	this.control[icurrent + 4] = this.ic_cashdrawerprinter
	this.control[icurrent + 5] = this.ic_cashdrawer
	this.control[icurrent + 6] = this.ic_comport

// w_salereturnbuffer.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_print
	destroy this.dw_srmaster
	destroy this.dw_srdetail
	destroy this.ic_cashdrawerprinter
	destroy this.ic_cashdrawer
	destroy this.ic_comport

// w_salereturnbuffer.ue_save() returns 0 [event]
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_salesmancode = 1
	long ll_rowcount
	long ll_icode
	long ll_gcode
	long ll_headerno
	long ll_headerinvno
	long ll_saleinvcode
	long ll_counter = 1
	long ll_patientcode
	long ll_rightfound
	long ll_saveresult = -1
	long ll_right_to_check
	boolean lb_commitflag = true
	boolean lb_continue = true
	integer li_errcode
	integer li_pos
	datetime ld_expiry
	string ls_errtext
	string ls_batch
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_advancetaxamt
	double ld_misccharges
	double ld_avgprice
	double ld_invgstperc
	double ld_invtotal
	double ld_fbrposfee
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	datetime ldt_server_datetime
	string ls_date_errtext
	datawindowchild ldc_headerno
	double ld_qty
	double ld_bonusqty
	double ld_stock
	double ld_newstock
	string ls_env_name
	string ls_env_val
	long ll_env_len
	if wf_check_save_right() = 0 then
		return
	end if
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	ll_right_to_check = 954
	if this.id_detail.rowcount() <= 0 then
		return
	end if
	if wf_validate_qty_bonus() < 0 then
		return
	end if
	if wf_check_unique_refno() = 0 then
		return
	end if
	if f_stringpreferences("ForcePCSInInterAtSalesSaving") = "Y" then
		for ll_counter = 1 to this.id_detail.rowcount()
			if this.id_detail.object.pcs[ll_counter] <> long(this.id_detail.object.pcs[ll_counter]) then
				messagebox("PCS Validation", "Please enter some valid PCS. It Should be some valid integer value", stopsign!)
				this.id_detail.setrow(ll_counter)
				this.id_detail.setfocus()
				this.id_detail.setcolumn("PCS")
				return
			end if
		next
	end if
	ll_counter = 0
	if not isnull(this.id_master.getitemnumber(this.id_master.getrow(), "saleinvcode")) and this.id_master.getitemnumber(this.id_master.getrow(), "saleinvcode") > 0.0 then
		if this.id_master.getitemnumber(this.id_master.getrow(), "custcode") = 19.0 then
			this.id_master.setitem(this.id_master.getrow(), "srcatcode", 8)
		else
			this.id_master.setitem(this.id_master.getrow(), "srcatcode", 7)
		end if
	elseif this.id_master.getitemnumber(this.id_master.getrow(), "custcode") = 19.0 then
		this.id_master.setitem(this.id_master.getrow(), "srcatcode", 8)
	else
		this.id_master.setitem(this.id_master.getrow(), "srcatcode", 7)
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if f_stringpreferences("ForcePricePolicyOnSavingSale") = "Y" and isnull(this.id_master.getitemnumber(this.id_master.getrow(), "saleinvcode")) and wf_apply_pricepolicy(1) <= 0 then
		messagebox("Price Policy Implementation", "Problem in Applying Item Price Policy on Saving")
		return
	end if
	if wf_set_cashaccount() = 0 then
		return
	end if
	wf_setguestcheckin()
	wf_setamountoninvoice()
	wf_grandtotal()
	this.id_footer.accepttext()
	this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	if f_stringpreferences("AskUserPwdInSaleReturn") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		if ll_salesmancode > 0 and ll_right_to_check > 0 then
			if wf_check_module_rights(ll_salesmancode, ll_right_to_check) < 0 then
				setfocus()
				return
			end if
		else
			return
		end if
	else
		ll_salesmancode = gl_usercode
	end if
	setfocus()
	if ll_salesmancode > 0 then
		if wf_check_cashiershift_on_saving(this.id_master.object.cashiershiftcode[1], ll_salesmancode) < 0 then
			return
		end if
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_rowcount = this.id_detail.rowcount()
		if wf_validate_price_discount_matters(ll_salesmancode) < 0 then
			return
		end if
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if wf_show_mastercashierwindow() = 0 then
			return
		end if
		if isnull(ll_invid) then
			wf_tabnewid("srledger", ll_invid)
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
				this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
			end if
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
		else
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
		end if
		if not this.ib_modifydate then
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
		else
			ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
		end if
		if not isnull(ll_invid) then
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
		end if
		this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
		this.id_master.getchild("headerno", ldc_headerno)
		ll_headerno = this.id_master.getitemnumber(ll_mastercurrrow, "headerno")
		ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
		if isnull(ll_headerinvno) then
			f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
			if ll_headerinvno > 0 then
				this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
			end if
		end if
		wf_grandtotal()
		this.id_footer.accepttext()
		this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
		ld_invtotal = this.id_footer.getitemnumber(1, "total")
		if f_stringpreferences("DisplayPool") = "Y" then
			this.ib_lcdshow = false
			if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				this.is_lcditem = "SALES RETURN AMOUNT"
				this.is_lcditem2 = space(5) + string(ld_invtotal, "########0.00")
			elseif upper(f_stringpreferences("DisplayPoolCompany")) <> "BAYLAN VFD-860-A" then
				this.is_lcditem = "RETURN= " + string(ld_invtotal, "########0.00")
				this.is_lcditem = this.is_lcditem + space(39 - len(this.is_lcditem))
				this.is_lcditem = left(this.is_lcditem, 39)
			end if
			this.ic_comport.triggerevent("ue_show")
		end if
		ld_misccharges = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges")
		ld_invdiscperc = this.id_footer.getitemnumber(ll_footercurrrow, "discperc")
		ld_flatdisc = this.id_footer.getitemnumber(ll_footercurrrow, "flatdisc")
		ll_saleinvcode = this.id_master.getitemnumber(1, "saleinvcode")
		ld_invgstperc = this.id_footer.getitemnumber(ll_footercurrrow, "invgstperc1")
		ld_advancetaxamt = this.id_footer.getitemnumber(ll_footercurrrow, "advancetaxamt")
		ld_fbrposfee = this.id_footer.getitemnumber(ll_footercurrrow, "fbrposfee")
		this.id_master.setitem(ll_mastercurrrow, "invgstperc1", ld_invgstperc)
		ls_env_name = "COMPUTERNAME"
		ls_env_val = space(20)
		ll_env_len = 20
		ll_env_len = getenvironmentvariablea(ls_env_name, ls_env_val, ll_env_len)
		this.id_master.setitem(ll_mastercurrrow, "machinename", ls_env_val)
		this.id_master.setitem(ll_mastercurrrow, "discperc", ld_invdiscperc)
		this.id_master.setitem(ll_mastercurrrow, "flatdisc", ld_flatdisc)
		this.id_master.setitem(ll_mastercurrrow, "misccharges", ld_misccharges)
		this.id_master.setitem(ll_mastercurrrow, "advancetaxamt", ld_advancetaxamt)
		this.id_master.setitem(ll_mastercurrrow, "fbrposfee", ld_fbrposfee)
		if this.ii_salerettype = 8 then
			if f_stringpreferences("askmastercashwin_in_buffersr") <> "N" then
				if not (this.id_master.object.cashcharged[ll_mastercurrrow] = this.id_master.object.invtotal[ll_mastercurrrow] and this.ids_cashwin.rowcount() = 0) then
					this.id_master.setitem(1, "srcatcode", 7)
					this.id_master.accepttext()
				end if
			end if
		end if
		if this.ii_salerettype <> 8 and this.id_master.getitemstring(1, "accountfor") = "Y" and f_stringpreferences("AskAmtOnCreditSaleReturn") = "Y" then
			ll_rightfound = 0
			ll_rightfound = gds_securitywindow.find("rightcode = 583", 1, gds_securitywindow.rowcount())
			if ll_rightfound > 0 then
				this.id_master.setitem(ll_mastercurrrow, "amtby", ll_salesmancode)
				this.id_master.setitem(ll_mastercurrrow, "amtdate", ldt_server_datetime)
			end if
		end if
		do while ll_counter <= ll_rowcount and li_errcode = 0
			this.id_detail.setitem(ll_counter, "code", ll_invid)
			ll_counter = ll_counter + 1
		loop
		if li_errcode = -1 then
			lb_continue = false
		end if
		if lb_continue then
			if this.ii_salerettype = 8 and f_stringpreferences("CashDrawer") = "Y" then
				this.ic_cashdrawer.object.portopen = true
				this.ic_cashdrawer.object.output = "A"
				this.ic_cashdrawer.object.portopen = false
			end if
			ll_saveresult = event ue_save_withnocommit()
			if ll_saveresult = 0 then
				if wf_update_mastercashierwindow(ll_invid, this.is_doctype) = 0 then
					SQL commit USING this.it_transobject;
					messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
					this.il_codevalue = ll_invid
					this.ib_commitok = true
					this.id_master.resetupdate()
					this.im_menu.m_file.m_new.enabled = true
					this.editflag = false
					if gd_recenttransdate < this.id_systemdate then
						gd_recenttransdate = this.id_systemdate
					end if
				else
					messagebox("Saving Problem", "Changes Not Saved in database for Master Cashier Window transactions.", stopsign!, ok!, 1)
				end if
			else
				messagebox("Saving Problem", "Changes Not Saved in database while saving sales return record.", stopsign!, ok!, 1)
			end if
			if this.ib_commitok then
				this.ib_modify = false
			end if
		else
			SQL rollback USING this.it_transobject;
			messagebox("Updation Error", "Some Problem occur in saving SaleReturn Invoice.~r~nKindly try again.~r~n" + ls_errtext, stopsign!)
		end if
	else
		setfocus()
	end if
	this.ib_lcdshow = true
	setpointer(arrow!)

// w_salereturnbuffer.ue_newform() returns 0 [event]
	integer rtncode
	integer li_ismodifysaleprice
	integer li_ismodifyitemdiscperc
	integer li_ismodifysalestax
	long li_fetched_code
	long row
	long ll_manfcode
	long ll_counter
	integer li_viewstock
	datetime ldt_server_datetime
	string ls_date_errtext
	m_salereturnmenu lm_menu
	call super::ue_newform
	this.ib_lcdshow = false
	lm_menu = this.menuid
	setredraw(false)
	lm_menu.m_file.m_saveandpost.enabled = this.ib_saveandpost
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_print.enabled = true
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	wf_setgodownoption()
	this.ib_modify = false
	this.ids_saleinv.reset()
	this.id_master.object.custcode[1] = 19
	if wf_customerinfo(19) <> 0 then
		messagebox("Database Error", "Can not retrieve information from database")
	end if
	wf_assign_master_cash_win_object()
	li_ismodifysaleprice = 1
	li_ismodifyitemdiscperc = 1
	li_ismodifysalestax = 1
	li_viewstock = 0
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 519 then
			li_ismodifysaleprice = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 518 then
			li_ismodifyitemdiscperc = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 521 then
			li_ismodifysalestax = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 535 then
			li_viewstock = 1
		end if
	next
	this.id_footer.object.t_stock.visible = li_viewstock
	this.id_footer.object.stock.visible = li_viewstock
	this.id_detail.object.srprice.protect = li_ismodifysaleprice
	this.id_detail.object.discperc.protect = li_ismodifyitemdiscperc
	this.id_detail.object.unitsalestax.protect = li_ismodifysalestax
	this.id_detail.object.gstperc.protect = li_ismodifysalestax
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	wf_visible(true)
	setredraw(true)
	if not wf_validatedate() then
		close(this)
	end if
	if this.ib_modifydate then
		if this.ib_fetchserverdate then
			wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
			this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
		else
			this.id_master.setitem(this.id_master.getrow(), "date", today())
		end if
	end if
	if f_stringpreferences("DisplayPool") = "Y" then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
			setnull(this.is_lcditem)
			this.ic_comport.triggerevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
			setnull(this.is_lcditem)
			this.ic_comport.triggerevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
			this.is_lcditem = space((20 - len(trim(left(f_reportheaderinfosale("clientname", this.id_master.object.headerno[1]), 20)))) / 2.0) + upper(trim(left(f_reportheaderinfosale("clientname", this.id_master.object.headerno[1]), 20)))
			this.is_lcditem2 = "*** SALES RETURN ***"
			this.ic_comport.triggerevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) <> "BAYLAN VFD-860-A" then
			this.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
			this.ic_comport.triggerevent("ue_show")
		end if
	end if
	this.ib_lcdshow = true
	if f_stringpreferences("allow_empty_saleinvcode_in_sr") = "N" then
		this.id_master.object.saleinvcode.edit.required = "yes"
	end if
	wf_link_to_cashiershift()
	wf_setitemslist(0)

// w_salereturnbuffer.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect = 1
	long ll_row
	long ll_code
	long ll_custcode
	long ll_allowed
	long ll_saleinvcode
	long ll_found
	long ll_billsummcode
	boolean lb_flag
	m_salereturnmenu lm_menu
	call super::ue_detail
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	ll_code = this.id_master.getitemnumber(1, "code")
	lm_menu = this.menuid
	if wf_isinvoiceinuse(ll_code) = true then
		messagebox("Invoice Validation", "Sale Return Invoice already in use by some other user.~r~nKindly try again after sometime or open some other invoice.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if not isnull(this.id_master.getitemnumber(1, "admissioncode")) then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "Can not Modify In-Patient Sale Return Here,~r~nPlease use In-Patient Sale Return Module.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if this.id_master.object.retviabillsummary[1] = "Y" and this.is_callermodule = "" then
		SQL SELECT MAX ( BillSummaryCode ) INTO :ll_billsummcode FROM BillSummaryDetail WHERE SRBufferInvCode =:ll_code USING sqlca;
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "Can not Modify this Sale Return Here.~r~nReason:- This return is associated to a Bill Summary Document No.: " + trim(string(ll_billsummcode)) + "~r~nPlease use Bill Summary Module to modify.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if wf_allowreturnmodification(ll_code, this.il_groupcode, this.il_strategy) <> 0 then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "You Can not modify this Invoice,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if f_stringpreferences("GroupCustomerCategory") = "Y" then
		SQL Select custcode INTO :ll_custcode From SRBufferLedger Where srbufferinvcode =:ll_code USING sqlca;
		ll_allowed = 0
		this.it_transobject.isallowedcustomergroupcategory(this.il_groupcode, ll_custcode, ll_allowed)
		if this.it_transobject.sqlcode = 0 then
			if ll_allowed < 1 then
				this.id_detail.reset()
				wf_setitemslist(0)
				messagebox("Group Customer Category Validation", "Current user group does not have enough permissions w.r.t customers~r~n" + "to open the selected invoice.~r~nPossible reasons are selected invoice customer has customer cateogry ~r~n which is not allowed to this user group.")
				this.tab_retrieve.selecttab(2)
				return
			end if
		end if
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_salegodown
	end if
	wf_setgodownoption()
	this.id_footer.retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	ll_saleinvcode = this.id_master.getitemnumber(1, "saleinvcode")
	if ll_saleinvcode > 0 then
		wf_setitemslist(ll_saleinvcode)
	else
		wf_setitemslist(0)
	end if
	if this.id_master.getitemstring(1, "posted") = "Y" then
		li_protect = 1
	else
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 712", 1, gds_securitywindow.rowcount())
		if ll_found <= 0 then
			messagebox("Sale Return Modification", "You are not allowed to modify sale return~r~nCurrent user group does not have enough permissions w.r.t salese return modification~r~nKindly consult your system administrator to do the needful.", stopsign!)
			this.tab_retrieve.selecttab(2)
			return
		end if
		li_protect = 0
		lm_menu.m_file.m_saveandpost.enabled = this.ib_saveandpost
	end if
	wf_initmodify(li_protect)
	if this.id_master.object.code[this.id_master.rowcount()] > 0 then
		this.ids_cashwin.retrieve(this.id_master.object.code[1], this.is_doctype)
	else
		wf_assign_master_cash_win_object()
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if this.id_master.getitemstring(1, "posted") = "N" then
		if ll_saleinvcode > 0 then
			wf_protectcolumns(1)
		else
			wf_protectcolumns(0)
		end if
	end if
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	wf_grandtotal()
	setredraw(true)

// w_salereturnbuffer.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.settransobject(this.it_transobject)
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	if f_stringpreferences("AutoSelectLastGodownInSale") = "Y" and this.id_detail.rowcount() > 0 then
		this.id_detail.object.gcode.initial = string(this.id_detail.object.gcode[this.id_detail.rowcount()])
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_salereturnbuffer.close() returns long [event]
	long ancestorreturnvalue
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	ancestorreturnvalue = super::close()
	destroy this.ids_saleinv
	if f_stringpreferences("DisplayPool") = "Y" then
		try
			if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
				this.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
				postevent("ue_show")
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
				this.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
				this.ic_comport.triggerevent("ue_show")
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				this.is_lcditem = "     THANK YOU"
				this.is_lcditem2 = "   FOR YOUR VISIT"
				this.ic_comport.triggerevent("ue_show")
				pd_closeusbpd()
			elseif upper(f_stringpreferences("DisplayPoolCompany")) <> "BAYLAN VFD-860-A" then
				this.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
				this.ic_comport.triggerevent("ue_show")
			end if
		catch (throwable exdw)
			messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
		catch (throwable exnullobj)
			messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
		catch (throwable ex)
			messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
		end try
	end if
	return 1

// w_salereturnbuffer.ue_print() returns 0 [event]
	long ll_custcode
	long ll_row
	long ll_invcode
	long ll_draftprint
	integer li_option
	string ls_custname
	string ls_invoicesize
	boolean lb_listtab
	s_datastore lstr
	string ls_printer
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		this.ib_checksaveright = false
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		this.ib_checksaveright = true
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	ll_draftprint = wf_select_draft_printout(ll_invcode)
	SQL SELECT PageSize INTO :ls_invoicesize FROM SRBufferLedger WHERE SRBufferInvCode =:ll_invcode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		ls_invoicesize = "Q"
	end if
	if ll_draftprint = 0 then
		wf_selectprintreport(ls_invoicesize)
		this.id_print.settransobject(this.it_transobject)
		this.id_print.retrieve(ll_invcode)
		if lb_listtab then
			lstr.dw = this.id_print
			lstr.s_module = "S/R"
			lstr.s_name1 = this.id_print.dataobject
			openwithparm(w_preview_invoices, lstr)
			lstr = message.powerobjectparm
			if lstr.i_closemode = -1 then
				return
			end if
			return
		end if
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		if this.id_print.rowcount() > 0 then
			if this.id_print.print() < 0 then
				messagebox("Printing", "Can not Print Invoice", information!)
			elseif f_stringpreferences("CashDrawerWithPrinter") = "Y" then
				ls_printer = f_stringpreferences("CashDrawerPrinter")
				if ls_printer = "" or isnull(ls_printer) then
					messagebox("Cash Drawer Printer", "Cash Drawer Printer name not found.~r~nSuggested Option is check Cash Drawer Printer name in Preferences.")
				else
					this.ic_cashdrawerprinter.object.__invoke_method("opendrawer", 4, {ls_printer, 10, "Control", 65}, true)
				end if
			end if
			if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
				postevent("ue_new")
			end if
		else
			messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
		end if
		return
	end if
	if this.im_menu.m_file.m_save.enabled = true then
		postevent("ue_new")
	end if

// w_salereturnbuffer.ue_refreshddw() returns 0 [event]
	long ll_prow
	long ll_pcode
	call super::ue_refreshddw
	setpointer(hourglass!)
	if this.ib_opensalereturn and this.ii_salerettype = 1 then
		this.idc_customerslist.setredraw(false)
		this.idc_customerslist.settransobject(this.it_transobject)
		this.idc_customerslist.reset()
		this.idc_customerslist.retrieve()
		this.idc_customerslist.setredraw(true)
	end if
	this.idc_patient.setredraw(false)
	this.idc_patient.settransobject(this.it_transobject)
	this.idc_patient.retrieve(this.ii_module)
	ll_prow = this.idc_patient.insertrow(0)
	setnull(ll_pcode)
	this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
	this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
	this.idc_patient.setitem(ll_prow, "name", "<NONE>")
	this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
	this.idc_patient.setitem(ll_prow, "city", "<NONE>")
	this.idc_patient.scrolltorow(ll_prow)
	this.idc_patient.setredraw(true)
	this.idc_guest.setredraw(false)
	this.idc_guest.settransobject(this.it_transobject)
	this.idc_guest.retrieve()
	this.idc_guest.setredraw(false)
	this.idc_student.setredraw(false)
	this.idc_student.settransobject(this.it_transobject)
	this.idc_student.retrieve()
	this.idc_student.setredraw(false)
	setpointer(arrow!)

// w_salereturnbuffer.ue_list() returns 0 [event]
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_post.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_itemvalidated = true

// w_salereturnbuffer.ue_postopen() returns 0 [event]
	datawindowchild ldc_dddsalecategory
	datawindowchild ldc_headerno
	s_salerettype ls_salerettype
	long li_rtncode
	long ll_counter
	long ll_found
	string ls_custfilterstring
	m_salereturnmenu lm_menu
	datastore lds_headers
	call super::ue_postopen
	lm_menu = this.menuid
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	this.ids_saleinv = create datastore
	this.ids_saleinv.dataobject = "ddd_saleinvitems"
	this.ids_saleinv.settransobject(sqlca)
	this.id_print = this.dw_print
	this.ic_advancetaxonsale = f_stringpreferences("ApplyAdvanceIncomeTaxInSale")
	if this.ic_advancetaxonsale = "" or isnull(this.ic_advancetaxonsale) then
		this.ic_advancetaxonsale = "N"
	end if
	this.ic_fbrposfee = f_stringpreferences("Auto_Apply_FBR_POS_Fee_InSale")
	if this.ic_fbrposfee = "" or isnull(this.ic_fbrposfee) then
		this.ic_fbrposfee = "N"
	end if
	this.ic_autofiscalize = f_stringpreferences("AutoFiscalizeOnPosting")
	if this.ic_autofiscalize = "" or isnull(this.ic_autofiscalize) then
		this.ic_autofiscalize = "N"
	end if
	setredraw(false)
	wf_assign_master_cash_win_object()
	this.il_groupcode = f_getgroupcode(gl_usercode)
	if this.ic_advancetaxonsale = "Y" then
		this.id_footer.settaborder("misccharges", 0)
	else
		this.id_detail.object.c_advancetax.visible = false
		this.id_footer.object.advancetaxamt_t.visible = false
		this.id_footer.object.advancetaxamt.visible = false
	end if
	if f_stringpreferences("salecustrefno2") = "N" then
		this.id_master.object.custrefno2.visible = false
		this.id_master.object.t_custrefno2.visible = false
	end if
	if f_stringpreferences("salecustrefno3") = "N" then
		this.id_master.object.custrefno3.visible = false
		this.id_master.object.t_custrefno3.visible = false
	end if
	if f_stringpreferences("salecustrefno4") = "N" then
		this.id_master.object.custrefno4.visible = false
		this.id_master.object.t_custrefno4.visible = false
	end if
	if f_stringpreferences("patientOnCreditSale") <> "H" then
		this.id_master.object.patientcode.visible = false
		this.id_master.object.t_patientcode.visible = false
		this.id_master.object.t_patientregno.visible = false
		this.id_master.object.patientregno.visible = false
	end if
	if f_stringpreferences("StudentOnCreditSale") <> "H" then
		this.id_master.object.studentcode.visible = false
		this.id_master.object.studentregno.visible = false
		this.id_master.object.studentregno_t.visible = false
		this.id_master.object.studentcode_t.visible = false
	end if
	if f_stringpreferences("GuestOnCreditSale") <> "H" then
		this.id_master.object.guestcode.visible = false
		this.id_master.object.guestregno.visible = false
		this.id_master.object.guestcode_t.visible = false
		this.id_master.object.guestregno_t.visible = false
	end if
	if f_stringpreferences("ShowAccountForinSaleReturn") = "Y" then
		this.id_master.object.accountfor.visible = true
		this.id_master.object.t_accountfor.visible = true
	else
		this.id_master.object.accountfor.visible = false
		this.id_master.object.t_accountfor.visible = false
	end if
	if f_stringpreferences("SaleReturnAccountFor") = "Y" then
		this.id_master.object.accountfor.initial = "Y"
	else
		this.id_master.object.accountfor.initial = "N"
	end if
	this.ib_editing = false
	lm_menu.m_file.m_possiblebatchandexpiry.visible = true
	lm_menu.m_file.m_possiblebatchandexpiry.enabled = true
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	li_rtncode = this.id_master.getchild("custcode", this.idc_customerslist)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild for customer.")
	end if
	this.idc_customerslist.settransobject(this.it_transobject)
	if f_stringpreferences("GroupCustomerCategory") = "Y" then
		ls_custfilterstring = "0                                                                                                                                                                                                             "
		this.it_transobject.getallowedgroupcustomercategory(f_getgroupcode(gl_usercode), ls_custfilterstring)
		if ls_custfilterstring = " " or ls_custfilterstring = "" or isnull(ls_custfilterstring) then
			ls_custfilterstring = "0"
			messagebox("Group Customer Category Validation", "Current user group does not have enough permissions w.r.t customer to make sale.~r~nIn order to make open credit sale return kindly assign customer categories to this user group ~r~n using Group Customer Category module.~r~nOR~r~nDisable Group Customer Category from Preferences.")
			close(this)
			return
		end if
		this.idc_customerslist.setfilter("custcatcode In (" + ls_custfilterstring + ") ")
		this.idc_customerslist.filter()
	end if
	gd_itemsinfo.sharedata(this.id_itemslist)
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit to Make Sales Return")
		close(this)
		return
	end if
	li_rtncode = this.id_detail.getchild("gcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild for Godown.")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights for making Sale Return")
		close(this)
		return
	end if
	this.ii_salegodown = this.idc_godown.getitemnumber(1, "gcode")
	this.id_detail.object.gcode.initial = string(this.ii_salegodown)
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.t_gcode.visible = true
		this.id_master.object.gcode.visible = true
		this.id_master.object.gcode.initial = string(this.ii_salegodown)
		this.id_detail.object.gcode.visible = false
	end if
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Sales Return")
		close(this)
		return
	end if
	if f_stringpreferences("headeronsalereturninv") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.t_headerno.visible = false
	end if
	this.id_master.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to lds_headers.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
		ldc_headerno.setitem(ll_counter, "name", "")
		ll_found = 0
		ll_found = gds_reoprtheaderinfo.find("headerno=" + string(lds_headers.getitemnumber(ll_counter, "headercode")), 1, 3)
		if ll_found > 0 then
			ldc_headerno.setitem(ll_counter, "headeralias", gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks"))
		end if
	next
	li_rtncode = this.id_master.getchild("patientcode", this.idc_patient)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_patient.settransobject(this.it_transobject)
	wf_patient_retrieve()
	li_rtncode = this.id_master.getchild("guestcode", this.idc_guest)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_guest.settransobject(this.it_transobject)
	li_rtncode = this.id_master.getchild("studentcode", this.idc_student)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_student.settransobject(this.it_transobject)
	this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
	this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
	if this.ii_salerettype = 8 and (gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN") then
		wf_visibleinvisiblediscount()
	end if
	if f_stringpreferences("alternatecustomicodeinsr") = "N" then
		this.id_detail.object.alternatecustomicode.visible = false
	end if
	if f_stringpreferences("batchinsr") = "N" then
		this.id_detail.object.batch.visible = false
	end if
	if f_stringpreferences("expiryinsr") = "N" then
		this.id_detail.object.expiry.visible = false
	end if
	if f_stringpreferences("packingdescinsalereturn") = "N" then
		this.id_detail.object.packingdesc.visible = false
	end if
	if f_stringpreferences("itemunittax") = "N" then
		this.id_detail.object.unitsalestax.visible = false
		this.id_detail.object.taxperunit_t.visible = false
		this.id_detail.object.c_sumtaxval.visible = false
		this.id_detail.object.c_taxval.visible = false
		this.id_detail.object.taxval_t.visible = false
	end if
	if f_stringpreferences("itemgstperc") = "N" then
		this.id_detail.object.gstperc.visible = false
		this.id_detail.object.gstperc_t.visible = false
		this.id_detail.object.c_sumgstval.visible = false
		this.id_detail.object.c_gstval.visible = false
		this.id_detail.object.gstval_t.visible = false
	end if
	if f_stringpreferences("invgstperc") = "N" then
		this.id_footer.object.invgstperc1.visible = false
		this.id_footer.object.invgstperc1_t.visible = false
	end if
	if f_stringpreferences("BonusinSale") = "N" then
		this.id_detail.object.t_bonusqty.visible = false
		this.id_detail.object.bonusqty.visible = false
	end if
	if f_stringpreferences("SaleRetItemDescription") = "N" then
		this.id_detail.object.returnitemdescription.visible = false
	end if
	if f_stringpreferences("salesmaninsale") = "N" then
		this.id_master.object.smancode.visible = false
		this.id_master.object.t_smancode.visible = false
	end if
	if f_stringpreferences("packingdescinsalereturn") = "N" then
		this.id_detail.object.packingdesc.visible = false
	end if
	if f_stringpreferences("DisplayTotalPiecesInSaleReturn") = "N" then
		this.id_detail.object.piecesinhand.visible = false
		this.id_detail.object.totalpieces.visible = false
		this.id_detail.object.totalpieces.criteria.required = "No"
		this.id_detail.object.totalpieces.initial = "0"
		this.id_detail.object.totalpieces.validation = "Real (GetText()) >= 0"
	end if
	if f_stringpreferences("ShowPackCapacityInSale") = "N" then
		this.id_detail.object.packcapacity.visible = false
	end if
	if f_stringpreferences("ShowAreaVolumeInSale") = "N" then
		this.id_detail.object.areavolume.visible = false
	end if
	if f_stringpreferences("ShowPackCoverageInSale") = "N" then
		this.id_detail.object.c_packcoverage.visible = false
	end if
	if f_stringpreferences("ShowPCSInSale") = "N" then
		this.id_detail.object.pcs.visible = false
	end if
	if f_stringpreferences("ShowCartonsInSale") = "N" then
		this.id_detail.object.cartons.visible = false
	end if
	this.id_master.object.pagesize.initial = f_stringpreferences("SaleReturnPageSize")
	if f_stringpreferences("AskPageSizeinSR") = "N" then
		this.id_master.object.pagesize.visible = false
		this.id_master.object.t_pagesize.visible = false
	end if
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(1)
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 567", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_showinvoicelist = true
	else
		this.ib_showinvoicelist = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 590", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_footer.object.misccharges.visible = true
		this.id_footer.object.misccharges_t.visible = true
	else
		this.id_footer.object.misccharges.visible = false
		this.id_footer.object.misccharges_t.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 595", 1, gds_securitywindow.rowcount())
	if ll_found <= 0 then
		this.id_detail.settaborder("srprice", 0)
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 623", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_saveandpost = true
	end if
	if f_stringpreferences("applysalepriceforalternatealiasname") = "Y" then
		this.ib_applyalternatealiasprice = true
	end if
	if f_rightexists(5213) then
		this.id_footer.object.discperc.visible = true
		this.id_footer.object.discperc_t.visible = true
	else
		this.id_footer.object.discperc.visible = false
		this.id_footer.object.discperc_t.visible = false
	end if
	if f_rightexists(5214) then
		this.id_footer.object.flatdisc.visible = true
		this.id_footer.object.flatdisc_t.visible = true
	else
		this.id_footer.object.flatdisc.visible = false
		this.id_footer.object.flatdisc_t.visible = false
	end if
	if f_rightexists(5215) then
		this.id_footer.object.invgstperc1.visible = true
		this.id_footer.object.invgstperc1_t.visible = true
	else
		this.id_footer.object.invgstperc1.visible = false
		this.id_footer.object.invgstperc1_t.visible = false
	end if
	if f_rightexists(5216) then
		this.id_footer.object.misccharges.visible = true
		this.id_footer.object.misccharges_t.visible = true
	else
		this.id_footer.object.misccharges.visible = false
		this.id_footer.object.misccharges_t.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 612", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_populatefromdatacarrydb.visible = true
		lm_menu.m_file.m_populatefromdatacarrydb.enabled = true
	else
		lm_menu.m_file.m_populatefromdatacarrydb.visible = false
		lm_menu.m_file.m_populatefromdatacarrydb.enabled = false
	end if
	lm_menu.m_file.m_saveandpost.visible = this.ib_saveandpost
	lm_menu.m_file.m_saveandpost.toolbaritemvisible = this.ib_saveandpost
	lm_menu.m_file.m_saveandpost.enabled = this.ib_saveandpost
	this.id_detail.object.batch.initial = f_stringpreferences("defaultbatch")
	this.id_detail.object.expiry.initial = string(f_datepreferences("defaultexpiry"))
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 696", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.date.protect = 0
		this.id_master.object.date.background.color = rgb(255, 255, 255)
		this.ib_modifydate = true
		lm_menu.m_file.m_setserverdate.visible = true
		lm_menu.m_file.m_setserverdate.enabled = true
	end if
	if not this.ib_modifydate then
		this.id_master.object.date.protect = 1
		this.id_master.settaborder("date", 0)
		lm_menu.m_file.m_setserverdate.visible = false
		lm_menu.m_file.m_setserverdate.enabled = false
	end if
	f_setcolumnstyle(this.id_detail, "Qty")
	wf_set_itemtotal_formatmask()
	setredraw(true)

// w_salereturnbuffer.ue_settitle() returns 0 [event]
	datawindowchild ldc_headerno
	long ll_counter
	long ll_retcode
	string ls_title
	call super::ue_settitle
	ll_retcode = this.id_master.getchild("headerno", ldc_headerno)
	if ll_retcode = 1 then
		for ll_counter = 1 to ldc_headerno.rowcount()
			if isnull(trim(ldc_headerno.getitemstring(ll_counter, "headeralias"))) then
				ls_title = ls_title + ""
			else
				ls_title = ls_title + "," + trim(ldc_headerno.getitemstring(ll_counter, "headeralias"))
			end if
		next
	else
		ls_title = ""
	end if
	this.title = this.title + "(" + ls_title + ")"

// w_salereturnbuffer.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	return ::message.returnvalue

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
	case "flatdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	end choose
	return 1

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	if parent.parent.parent.id_detail.rowcount() > 0 and not isnull(parent.parent.parent.id_detail.object.icode[parent.parent.parent.id_detail.rowcount()]) then
		parent.parent.parent.id_detail.accepttext()
	end if
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_code
	long ll_detailrows
	long ll_custcode
	long ll_admissioncode
	long ll_patientcode
	long ll_allowed
	long ll_guestcode
	long ll_studentcode
	integer li_result
	integer li_null
	string ls_result
	string ls_null
	integer li_res
	integer li_custcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(li_null)
	setnull(ls_null)
	choose case dwo.name
	case "srcatcode"
	case "custcode"
		ll_code = long(data)
		parent.setredraw(false)
		if parent.parent.parent.wf_customerinfo(ll_code) <> 0 then
			messagebox("Database Error", "Can not retrieve information from database")
		else
			setitem(row, "patientregno", ls_null)
			setitem(row, "patientcode", li_null)
		end if
		parent.setredraw(true)
	case "aliasname"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findcustcode(data, li_custcode)
			if li_res > 0 and f_stringpreferences("GroupCustomerCategory") = "Y" then
				ll_allowed = 0
				parent.parent.parent.it_transobject.isallowedcustomergroupcategory(f_getgroupcode(gl_usercode), li_custcode, ll_allowed)
				if parent.parent.parent.it_transobject.sqlcode <> 0 then
					messagebox("Fetch Error", "Unable to fetch group customer category information.")
					return 1
				elseif ll_allowed < 1 then
					messagebox("Group Customer Category Validation", "Current group does not have enough permissions for sale return~r~n" + "against the customer whose alias name provided in alias name box.")
					return 1
				end if
				return
			end if
			if li_res > 0 then
				setitem(row, "custcode", li_custcode)
				if parent.parent.parent.wf_customerinfo(li_custcode) <> 0 then
					messagebox("Database Error", "Can not retrieve information from database")
					li_result = 1
				else
					setitem(row, "patientregno", ls_null)
					setitem(row, "patientcode", li_null)
					li_result = 0
				end if
			else
				messagebox("Customer Validation", "Customer with  Alias Name  " + data + " does not exist")
				li_result = 1
			end if
		end if
	case "patientregno"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findpatientcode(data, ll_patientcode)
			if li_res > 0 then
				setitem(row, "patientcode", ll_patientcode)
				SQL SELECT custcode INTO :ll_custcode FROM patient WHERE patientcode =:ll_patientcode USING parent.parent.parent.it_transobject;
				if parent.parent.parent.it_transobject.sqlcode = 0 then
					parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
					parent.parent.parent.id_master.object.custcode.protect = 1
					li_result = parent.parent.parent.wf_customerinfo(ll_custcode)
				end if
			else
				messagebox("Patient Validation", "Patient with  RegNo  " + data + " does not exist")
				li_result = 1
			end if
		end if
	case "patientcode"
		if isnull(data) then
			parent.parent.parent.id_master.object.custcode.protect = 0
			parent.parent.parent.id_master.setitem(1, "custcode", 0)
		else
			ll_patientcode = long(data)
			parent.parent.parent.id_master.setitem(1, "patientregno", parent.parent.parent.wf_findregno(ll_patientcode))
			SQL SELECT custcode INTO :ll_custcode FROM patient WHERE patientcode =:ll_patientcode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = 0 then
				parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
				parent.parent.parent.id_master.object.custcode.protect = 1
				li_result = parent.parent.parent.wf_customerinfo(ll_custcode)
			else
				messagebox("Patient Information", "Problem in retrieving corresponding customer")
				li_result = 1
			end if
		end if
	case "saleinvcode"
		if not isnull(data) and data <> "" then
			li_result = parent.parent.parent.wf_validatesaleinvcode(row, long(data))
			if li_result = 1 then
				parent.parent.parent.wf_protectcolumns(0)
			elseif li_result = 0 then
				parent.parent.parent.wf_setitemslist(long(data))
				parent.parent.parent.wf_protectcolumns(1)
			end if
		else
			li_result = 0
			parent.parent.parent.wf_protectcolumns(0)
		end if
	case "guestregno"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findguestcode(data, ll_guestcode)
			if li_res > 0 then
				setitem(row, "guestcode", ll_guestcode)
				SQL SELECT custcode INTO :ll_custcode FROM Guest WHERE Guestcode =:ll_guestcode USING parent.parent.parent.it_transobject;
				if parent.parent.parent.it_transobject.sqlcode = 0 then
					parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
					parent.parent.parent.id_master.object.custcode.protect = 1
					li_result = parent.parent.parent.wf_customerinfo(ll_custcode)
				end if
			else
				messagebox("Guest Validation", "Guest with  RegNo  " + data + " does not exist")
				li_result = 1
			end if
		end if
	case "guestcode"
		if isnull(data) then
			parent.parent.parent.id_master.object.custcode.protect = 0
			parent.parent.parent.id_master.setitem(1, "custcode", 0)
		else
			ll_guestcode = long(data)
			parent.parent.parent.id_master.setitem(1, "Guestregno", parent.parent.parent.wf_findregno(ll_guestcode))
			SQL SELECT custcode INTO :ll_custcode FROM Guest WHERE Guestcode =:ll_guestcode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = 0 then
				parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
				parent.parent.parent.id_master.object.custcode.protect = 1
				li_result = parent.parent.parent.wf_customerinfo(ll_custcode)
			else
				messagebox("Guest Information", "Problem in retrieving corresponding customer")
				li_result = 1
			end if
		end if
	case "studentregno"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findstudentcode(data, ll_studentcode)
			if li_res > 0 then
				setitem(row, "Studentcode", ll_studentcode)
				SQL SELECT custcode INTO :ll_custcode FROM Student WHERE Studentcode =:ll_studentcode USING parent.parent.parent.it_transobject;
				if parent.parent.parent.it_transobject.sqlcode = 0 then
					parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
					parent.parent.parent.id_master.object.custcode.protect = 1
					li_result = parent.parent.parent.wf_customerinfo(ll_custcode)
				end if
			else
				messagebox("Student Validation", "Student with  RegNo  " + data + " does not exist")
				li_result = 1
			end if
		end if
	case "studentcode"
		if isnull(data) then
			parent.parent.parent.id_master.object.custcode.protect = 0
			parent.parent.parent.id_master.setitem(1, "custcode", 0)
		else
			ll_studentcode = long(data)
			parent.parent.parent.id_master.setitem(1, "Studentregno", parent.parent.parent.wf_findregno(ll_studentcode))
			SQL SELECT custcode INTO :ll_custcode FROM Student WHERE Studentcode =:ll_studentcode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = 0 then
				parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
				parent.parent.parent.id_master.object.custcode.protect = 1
				li_result = parent.parent.parent.wf_customerinfo(ll_custcode)
			else
				messagebox("Student Information", "Problem in retrieving corresponding customer")
				li_result = 1
			end if
		end if
		return li_result
	end choose
	return li_result

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_saletype
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "saleinvcode"
		return 1
	end choose
	return 1

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	string ls_columnobject
	long ll_currow
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	ls_columnobject = dwo.name
	ll_currow = rowcount()
	if ll_currow > 0 and (ls_columnobject = "discperc" or ls_columnobject = "srprice" or ls_columnobject = "qty") and isnull(this.object.icode[ll_currow]) then
		scrolltorow(ll_currow)
		setcolumn("icode")
	end if
	return 0

// dw_detail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.getparent().dynamic postevent("ue_accepttext")
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_detail.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	parent.parent.parent.id_footer.accepttext()
	if parent.parent.parent.id_detail.rowcount() > 0 and not isnull(parent.parent.parent.id_detail.object.icode[parent.parent.parent.id_detail.rowcount()]) then
		parent.parent.parent.id_detail.accepttext()
	end if
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_null
	long ll_itemcodetype
	string ls_null
	integer li_rtcode
	string ls_batch
	string ls_itemname
	string ls_errtext
	datetime ld_expiry
	long ll_gcode
	long ll_icode
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case "icode"
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	case parent.parent.parent.is_columnitemname
		if parent.parent.parent.id_itemslist.rowcount() > 1 then
			parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
			parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		end if
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	case "looseqty"
		li_rtcode = parent.parent.parent.wf_validateqty(row, double(data))
		if li_rtcode <> 1 then
			if double(data) <= 0.0 and f_stringpreferences("BonusinSale") = "N" then
				messagebox("Sale Qty Validation!", "Please Enter Valid Sale Qty.")
				li_rtcode = 1
			elseif double(data) <= 0.0 and f_stringpreferences("BonusinSale") = "Y" and getitemnumber(row, "bonusqty") <= 0.0 then
				messagebox("Sale Qty Validation!", "Please Enter Valid Sale Qty.")
				li_rtcode = 1
			end if
		end if
	case "bonusqty"
		li_rtcode = parent.parent.parent.wf_validatebonusqty(row, double(data))
		if li_rtcode <> 1 and (double(data) <= 0.0 and getitemnumber(row, "looseqty") <= 0.0) then
			messagebox("Bonus Qty Validation!", "Both Quantity and Bonus must be valid.")
			li_rtcode = 1
		end if
	case "pcs"
		return parent.parent.parent.wf_validate_pcs(row, data)
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname, ll_itemcodetype, parent.parent.parent.idbl_packqty, parent.parent.parent.idbl_purprice, parent.parent.parent.idbl_saleprice)
			if li_res > 0 then
				if parent.parent.parent.idbl_packqty <= 0.0 or isnull(parent.parent.parent.idbl_packqty) then
					parent.parent.parent.idbl_packqty = 1
				end if
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				if ll_itemcodetype = 2 then
					setitem(row, "looseqty", parent.parent.parent.idbl_packqty)
					setitem(row, "alternatecustomicode", data)
					if parent.parent.parent.ib_applyalternatealiasprice then
						setitem(row, "srprice", parent.parent.parent.idbl_saleprice / parent.parent.parent.idbl_packqty)
						setitem(row, "saleprice", parent.parent.parent.idbl_saleprice / parent.parent.parent.idbl_packqty)
					end if
				else
					setitem(row, "alternatecustomicode", ls_null)
				end if
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_rtcode = 0
			else
				messagebox("ItemNumber Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_rtcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_rtcode = 2
		end if
	case "batch"
		ls_batch = data
		ll_icode = this.object.icode[row]
		if isnull(parent.parent.parent.id_master.object.saleinvcode[parent.parent.parent.id_master.rowcount()]) then
			parent.parent.parent.wf_getrecentexpiry(ll_icode, ls_batch, row)
		end if
		ld_expiry = getitemdatetime(row, "expiry")
		ll_gcode = getitemnumber(row, "gcode")
		ll_icode = getitemnumber(row, "icode")
		if f_stringpreferences("allowsamebatchreturnmultipletimes") = "N" and parent.parent.parent.wf_is_batch_already_returned(ll_icode, ls_batch, ld_expiry, ls_errtext) <> 0 then
			messagebox("Batch No. Validation", ls_errtext, stopsign!)
			return 1
		end if
		if not isnull(ll_gcode) and not isnull(ll_icode) and not isnull(ls_batch) and not isnull(ld_expiry) then
			if isnull(parent.parent.parent.id_master.object.saleinvcode[parent.parent.parent.id_master.rowcount()]) then
				if vf_dwdupcodebatch(this, "gcode", ll_gcode, "icode", ll_icode, "batch", ls_batch, "expiry", ld_expiry, row) then
					parent.parent.parent.is_validationerrtext = "Duplicate item, an item with same attributes already exist, ~n~rPlease enter some other"
					li_rtcode = 1
				else
					setnull(parent.parent.parent.is_validationerrtext)
				end if
			end if
		else
			setnull(parent.parent.parent.is_validationerrtext)
		end if
	case "expiry"
		ls_batch = getitemstring(row, "batch")
		ld_expiry = datetime(date(left(data, 10)), time("00:00:00:000000"))
		ll_gcode = getitemnumber(row, "gcode")
		ll_icode = getitemnumber(row, "icode")
		if not isnull(ll_gcode) and not isnull(ll_icode) and not isnull(ls_batch) and not isnull(ld_expiry) then
			if isnull(parent.parent.parent.id_master.object.saleinvcode[parent.parent.parent.id_master.rowcount()]) then
				if vf_dwdupcodebatch(this, "gcode", ll_gcode, "icode", ll_icode, "batch", ls_batch, "expiry", ld_expiry, row) then
					parent.parent.parent.is_validationerrtext = "Duplicate item, an item with same attributes already exist, ~n~rPlease enter some other"
					li_rtcode = 1
				else
					setnull(parent.parent.parent.is_validationerrtext)
				end if
			end if
		else
			setnull(parent.parent.parent.is_validationerrtext)
		end if
	end choose
	return li_rtcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ancestorreturnvalue
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "itemname" then
		parent.parent.parent.ib_focusdetail = true
	end if
	parent.parent.parent.wf_grandtotal()
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	long ll_icode
	long ll_foundrow
	dwitemstatus lrs_status
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if parent.parent.parent.id_detail.rowcount() > 0 and lrs_status <> new! then
		parent.parent.parent.id_footer.setitem(1, "stock", getitemnumber(currentrow, "stock"))
		if not parent.parent.parent.ib_opensalereturn then
			parent.parent.parent.id_footer.setitem(1, "saleqty", getitemnumber(currentrow, "saleqty"))
			parent.parent.parent.id_footer.setitem(1, "retableqty", getitemnumber(currentrow, "retableqty"))
			if f_stringpreferences("BonusinSale") = "Y" then
				parent.parent.parent.id_footer.setitem(1, "salebonusqty", getitemnumber(currentrow, "salebonusqty"))
				parent.parent.parent.id_footer.setitem(1, "retablebonusqty", getitemnumber(currentrow, "retablebonusqty"))
			end if
		else
			parent.parent.parent.id_footer.object.saleqty[1] = 0
			parent.parent.parent.id_footer.object.retableqty[1] = 0
			if f_stringpreferences("BonusinSale") = "Y" then
				parent.parent.parent.id_footer.object.salebonusqty[1] = 0
				parent.parent.parent.id_footer.object.retablebonusqty[1] = 0
			end if
		end if
	elseif parent.parent.parent.id_footer.rowcount() > 0 then
		parent.parent.parent.id_footer.setitem(1, "saleqty", 0)
		parent.parent.parent.id_footer.setitem(1, "retableqty", 0)
		parent.parent.parent.id_footer.setitem(1, "stock", 0)
		if f_stringpreferences("BonusinSale") = "Y" then
			parent.parent.parent.id_footer.setitem(1, "salebonusqty", 0)
			parent.parent.parent.id_footer.setitem(1, "retablebonusqty", 0)
			parent.parent.parent.id_footer.setitem(1, "stock", 0)
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "icode"
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case parent.parent.parent.is_columnitemname
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case "looseqty"
		if double(data) <= 0.0 and f_stringpreferences("BonusinSale") = "N" then
			messagebox("Sale Qty Validation!", "Please Enter Valid Sale Qty.")
		elseif double(data) <= 0.0 and f_stringpreferences("BonusinSale") = "Y" and getitemnumber(row, "bonusqty") <= 0.0 then
			return 2
		end if
	case "bonusqty"
		if double(data) <= 0.0 and getitemnumber(row, "LooseQty") <= 0.0 then
			messagebox("Item Bonus Qty Validation", "Item Bonus Qty ~"" + data + "~" should be greater than zero")
		end if
	case "discperc"
		messagebox("Item Discount Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	case "srprice"
		if double(data) <= 0.0 then
			messagebox("Item Price Validation", "Item price ~"" + data + "~" must be greater than zero")
		else
			messagebox("Item Price Validation", "Item price can not be changed")
		end if
	case "batch"
		if isnull(parent.parent.parent.is_validationerrtext) then
			messagebox("Item Batch Validation", "Please enter some valid batch number")
		else
			messagebox("Item Validation", parent.parent.parent.is_validationerrtext)
		end if
	case "expiry"
		if isnull(parent.parent.parent.is_validationerrtext) then
			messagebox("Item Expiry Validation", "Please enter some valid expiry date")
		else
			messagebox("Item Validation", parent.parent.parent.is_validationerrtext)
		end if
	end choose
	setnull(parent.parent.parent.is_validationerrtext)
	return 1

// dw_itemsdetail.getfocus() returns long [event]
	long ancestorreturnvalue
	if f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	long ll_currentrow
	long ll_holdrow
	long ll_holdicode
	string ls_holdstr
	string ls_rate
	string ls_qty
	string ls_total
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	if f_stringpreferences("DisplayPool") = "Y" then
		ll_currentrow = getrow()
		if ll_currentrow <> 0 and parent.parent.parent.ib_lcdshow = true then
			if parent.parent.parent.ib_opensalereturn then
				ls_holdstr = this.object.itemname[ll_currentrow]
			else
				ll_holdicode = this.object.icode[ll_currentrow]
				ll_holdrow = gd_itemsinfo.find("ICode=" + string(ll_holdicode), 1, gd_itemsinfo.rowcount())
				if ll_holdrow > 0 then
					ls_holdstr = gd_itemsinfo.getitemstring(ll_holdrow, "ItemName")
				else
					ls_holdstr = this.object.itemname[ll_currentrow]
				end if
			end if
			if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				if this.object.icode[ll_currentrow] > 0 then
					parent.parent.parent.is_lcditem = trim(left(ls_holdstr, 20)) + space(20 - len(trim(left(ls_holdstr, 20))))
					parent.parent.parent.is_lcditem2 = "Qty=" + string(this.object.looseqty[ll_currentrow], f_setcolumnformat("Qty")) + " Rs=" + string(this.object.srprice[ll_currentrow], "#######0.00")
				end if
			elseif upper(f_stringpreferences("DisplayPoolCompany")) <> "BAYLAN VFD-860-A" then
				if len(ls_holdstr) < 20 then
					parent.parent.parent.is_lcditem = ls_holdstr + space(20 - len(ls_holdstr))
				else
					parent.parent.parent.is_lcditem = left(ls_holdstr, 20)
				end if
				parent.parent.parent.is_lcditem = parent.parent.parent.is_lcditem + "Qty=" + string(this.object.looseqty[ll_currentrow])
				parent.parent.parent.is_lcditem = parent.parent.parent.is_lcditem + " Rs=" + string(this.object.srprice[ll_currentrow], "#######0.00")
			end if
			parent.parent.parent.ic_comport.triggerevent("ue_show")
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanging(long currentrow, long newrow) returns long [event]
	long ancestorreturnvalue
	string ls_holdstr
	string ls_qty
	string ls_rate
	string ls_total
	long ll_holdicode
	long ll_holdrow
	ancestorreturnvalue = super::rowfocuschanging(currentrow, newrow)
	if f_stringpreferences("DisplayPool") = "Y" and (currentrow <> 0 and parent.parent.parent.ib_lcdshow = true) and parent.parent.parent.id_detail.rowcount() > 0 then
		if parent.parent.parent.ib_opensalereturn then
			ls_holdstr = this.object.itemname[currentrow]
		else
			ll_holdicode = this.object.icode[currentrow]
			ll_holdrow = gd_itemsinfo.find("ICode=" + string(ll_holdicode), 1, gd_itemsinfo.rowcount())
			ls_holdstr = gd_itemsinfo.getitemstring(ll_holdrow, "ItemName")
		end if
		if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
			parent.parent.parent.is_lcditem = trim(left(ls_holdstr, 20)) + space(20 - len(trim(left(ls_holdstr, 20))))
			parent.parent.parent.is_lcditem2 = "Qty=" + string(this.object.looseqty[currentrow], f_setcolumnformat("Qty")) + " Rs=" + string(this.object.srprice[currentrow], "#######0.00")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) <> "BAYLAN VFD-860-A" then
			if len(ls_holdstr) < 20 then
				parent.parent.parent.is_lcditem = ls_holdstr + space(20 - len(ls_holdstr))
			else
				parent.parent.parent.is_lcditem = left(ls_holdstr, 20)
			end if
			parent.parent.parent.is_lcditem = parent.parent.parent.is_lcditem + "Qty=" + string(this.object.looseqty[currentrow])
			parent.parent.parent.is_lcditem = parent.parent.parent.is_lcditem + " Rs=" + string(this.object.srprice[currentrow], "#######0.00")
		end if
		parent.parent.parent.ic_comport.postevent("ue_show")
	end if
	return ::message.returnvalue

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ll_currrow
	long ll_startrow
	long ll_endrow
	if parent.parent.parent.editflag = false then
		parent.parent.parent.editflag = true
		parent.parent.parent.im_menu.m_file.m_save.enabled = true
	end if
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		if upper(left(data, 1)) >= "A" and upper(left(data, 1)) <= "Z" or left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
			ll_currrow = parent.parent.parent.id_itemslist.getrow()
			if len(data) > 1 then
				ll_startrow = ll_currrow
			else
				ll_startrow = 1
				parent.parent.parent.ib_bkspace = false
			end if
			if parent.parent.parent.ib_bkspace then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.find("Lower(itemname) <= '" + lower(data) + "'", ll_startrow, 0)
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.il_itemlistfoundrow + 1
				parent.parent.parent.ib_bkspace = false
			else
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.find("Lower(itemname) >= '" + lower(data) + "'", ll_startrow, parent.parent.parent.id_itemslist.rowcount())
			end if
			if parent.parent.parent.il_itemlistfoundrow = 0 then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.rowcount()
			end if
			if parent.parent.parent.il_itemlistfoundrow <> ll_currrow then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.setrow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_itemslist.scrolltorow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_itemslist.selectrow(parent.parent.parent.il_itemlistfoundrow, true)
				ll_endrow = setitem(row, "currlistrow", parent.parent.parent.il_itemlistfoundrow)
				ll_endrow = getitemnumber(row, "currlistrow")
				setfocus()
			end if
		end if
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	end choose
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	integer li_rowno
	integer i
	integer li_columnno = 1
	integer li_quicksearch_col
	boolean lb_duplicate
	if parent.parent.parent.ii_salerettype = 1 then
		if f_numberpreferences("CreditsaleDetailWindowFormat") = 1 then
			li_columnno = integer(this.object.datawindow.column.count)
		else
			li_columnno = integer(this.object.discperc.id)
		end if
	end if
	if parent.parent.parent.ii_salerettype = 8 then
		if f_numberpreferences("CashsaleDetailWindowFormat") = 1 then
			li_columnno = integer(this.object.datawindow.column.count)
		else
			li_columnno = integer(this.object.discperc.id)
		end if
	end if
	if getrow() = rowcount() then
		if getcolumn() = li_columnno then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
	elseif li_columnno = integer(this.object.datawindow.column.count) and getcolumn() = li_columnno then
		scrollnextrow()
		if f_stringpreferences("ItemCode") = "Y" then
			setcolumn(1)
		else
			setcolumn(2)
		end if
		setfocus()
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_find.keypressed(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::keypressed(key, keyflags)
	if keyflags = 2 and key = keyf12! then
		parent.parent.parent.wf_replace_postdate_with_date()
	end if
	return ::message.returnvalue

// ic_cashdrawer.constructor() returns long [event]
	integer li_defaultcomport
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	try
		if f_stringpreferences("CashDrawer") = "Y" then
			li_defaultcomport = f_numberpreferences("CashDrawerComPort")
			if isnull(li_defaultcomport) then
				li_defaultcomport = 1
			end if
			this.object.commport = li_defaultcomport
			this.object.settings = "300,N,8,1"
			this.object.inputlen = 0
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try
	return ::message.returnvalue

// ic_comport.ue_show() returns long [event]
	string ls_line
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	try
		if isnull(parent.is_lcditem) then
			if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
				parent.is_lcditem = char(26) + char(1)
				parent.ic_comport.triggerevent("ue_show")
				parent.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
				parent.ic_comport.triggerevent("ue_show")
				return 1
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
				parent.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				return 1
			elseif upper(f_stringpreferences("DisplayPoolCompany")) <> "BAYLAN VFD-860-A" then
				parent.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
			end if
		end if
		if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
			parent.wf_pd_initialize()
			pd_writepd(ls_line, len(ls_line))
			if not isnull(parent.is_lcditem) then
				pd_writepd(parent.is_lcditem, len(parent.is_lcditem))
			end if
			ls_line = char(27) + char(72) + char(20)
			pd_writepd(ls_line, len(ls_line))
			if not isnull(parent.is_lcditem2) then
				pd_writepd(parent.is_lcditem2, len(parent.is_lcditem2))
			end if
		elseif upper(f_stringpreferences("DisplayPoolCompany")) <> "BAYLAN VFD-860-A" then
			this.object.portopen = true
			if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
				this.object.output = char(26) + parent.is_lcditem
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
				this.object.output = char(12) + parent.is_lcditem
			else
				this.object.output = char(12) + parent.is_lcditem
			end if
			this.object.portopen = false
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try
	return 1

// ic_comport.constructor() returns long [event]
	integer li_defaultcomport
	integer li_status
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	try
		if f_stringpreferences("DisplayPool") = "Y" then
			if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				pd_openusbpd()
				li_status = pd_pdstate()
				if li_status = 0 then
					parent.wf_pd_initialize()
				end if
			elseif upper(f_stringpreferences("DisplayPoolCompany")) <> "BAYLAN VFD-860-A" then
				li_defaultcomport = f_numberpreferences("DefaultComPort")
				if isnull(li_defaultcomport) then
					li_defaultcomport = 1
				end if
				this.object.commport = li_defaultcomport
				this.object.settings = "9600,N,8,1"
				this.object.inputlen = 0
			end if
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try
	return ::message.returnvalue
