// window w_possiblebatchexpiry_expiryintimation (salereturncomponents)  ancestor: window

// w_possiblebatchexpiry_expiryintimation.ue_close(integer ai_status) returns 0
	this.istr_possiblebatchexpiry.i_status = ai_status
	closewithreturn(this, this.istr_possiblebatchexpiry)

// w_possiblebatchexpiry_expiryintimation.create() returns 0
	this.dw_batchexpiry = create dw_batchexpiry
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.control = {this.dw_batchexpiry, this.cb_cancel, this.cb_ok}

// w_possiblebatchexpiry_expiryintimation.destroy() returns 0
	destroy this.dw_batchexpiry
	destroy this.cb_cancel
	destroy this.cb_ok

// w_possiblebatchexpiry_expiryintimation.open() returns long
	long ll_width
	long ll_height
	long ll_rows
	datawindowchild ldc_batchexpiry
	environment env
	this.istr_possiblebatchexpiry = message.powerobjectparm
	setredraw(false)
	if this.istr_possiblebatchexpiry.i_module = 1 then
		this.dw_batchexpiry.dataobject = "d_possiblebatchexpiry_purchasebased"
	elseif this.istr_possiblebatchexpiry.i_module = 2 then
		this.dw_batchexpiry.dataobject = "d_possiblebatchexpiry_salebased"
	end if
	this.dw_batchexpiry.settransobject(sqlca)
	ll_rows = this.dw_batchexpiry.retrieve(this.istr_possiblebatchexpiry.l_acccode, this.istr_possiblebatchexpiry.l_icode)
	if getenvironment(env) <> 1 then
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	this.x = int((ll_width - this.width) / 2.0)
	this.y = int((ll_height - this.height) / 2.0)
	f_setcolumnstyle(this.dw_batchexpiry, "Qty")
	if this.dw_batchexpiry.rowcount() > 0 then
		this.dw_batchexpiry.setrow(1)
		this.dw_batchexpiry.triggerevent(clicked!)
	end if
	this.dw_batchexpiry.setfocus()
	setredraw(true)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_batchexpiry.keypressed(keycode key, unsignedlong keyflags) returns long
	long ll_row
	ll_row = getselectedrow(0)
	if key = keyuparrow! then
		if getrow() = rowcount() then
			selectrow(ll_row, false)
			scrolltorow(rowcount() - 1)
			selectrow(rowcount() - 1, true)
		else
			selectrow(ll_row, false)
			selectrow(getrow(), true)
		end if
	elseif key = keydownarrow! then
		if getrow() = 1 and ll_row = 1 then
			selectrow(ll_row, false)
			scrolltorow(2)
			selectrow(2, true)
		else
			selectrow(ll_row, false)
			selectrow(getrow(), true)
		end if
	elseif key = keypagedown! then
		selectrow(ll_row, false)
		selectrow(getrow(), true)
	elseif key = keypageup! then
		selectrow(ll_row, false)
		selectrow(getrow(), true)
	elseif key = keyhome! then
		selectrow(ll_row, false)
		selectrow(getrow(), true)
	elseif key = keyend! then
		selectrow(ll_row, false)
		selectrow(getrow(), true)
	end if
	return ::message.returnvalue

// dw_batchexpiry.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long
	selectrow(getselectedrow(0), false)
	scrolltorow(row)
	selectrow(row, true)
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.post event ue_close(0)
	return ::message.returnvalue

// cb_ok.clicked() returns long
	long ll_row
	ll_row = parent.dw_batchexpiry.getselectedrow(0)
	if ll_row > 0 then
		parent.istr_possiblebatchexpiry.d_qty = parent.dw_batchexpiry.object.qty[ll_row]
		parent.istr_possiblebatchexpiry.s_batch = parent.dw_batchexpiry.getitemstring(ll_row, "batch")
		parent.istr_possiblebatchexpiry.d_expiry = date(parent.dw_batchexpiry.object.expiry[ll_row])
		parent.istr_possiblebatchexpiry.l_invcode = parent.dw_batchexpiry.object.invcode[ll_row]
		parent.istr_possiblebatchexpiry.dt_invdate = parent.dw_batchexpiry.object.date[ll_row]
		parent.istr_possiblebatchexpiry.s_refno = parent.dw_batchexpiry.object.refno[ll_row]
		parent.istr_possiblebatchexpiry.dt_refdate = parent.dw_batchexpiry.object.refdate[ll_row]
		parent.post event ue_close(1)
	else
		parent.post event ue_close(0)
	end if
	return ::message.returnvalue
