				this.id_master.object.guestcode.visible = false
				this.id_master.object.guestregno.visible = false
				this.id_master.object.guestcode_t.visible = false
				this.id_master.object.guestregno_t.visible = false
			end if
		end choose
		this.ib_editing = false
	else
		lm_menu.m_file.m_possiblebatchandexpiry.visible = true
		lm_menu.m_file.m_possiblebatchandexpiry.enabled = true
		choose case this.ii_salerettype
		case 1
			this.title = "Open Credit Sale Return"
			wf_assigndatawindowobjects("d_OpenWholeSaleReturn", "d_OpenWholeSaleReturnDetail", "d_OpenSaleReturnFooter", "d_OpenWholeSalereturnList", "d_WholeSaleReturnInvReport")
