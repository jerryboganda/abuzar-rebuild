// w_salereturn.wf_findpatientcode(string as_regno, long al_patientcode) returns integer
	long ll_patientcode
	long ll_retflag
	string ls_itemname
	SQL SELECT patient.patientcode INTO :ll_patientcode FROM patient WHERE patient.regno =:as_regno AND patient.active ='Y' AND Patient.PatientCatCode IN ( SELECT DISTINCT PatientCatCode FROM PatientCatAllowedModule WHERE ModuleID =:this.ii_module ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_patientcode = ll_patientcode
		if isnull(al_patientcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_salereturn.wf_setpatientinfo(long al_patientcode) returns long
	long ll_wardcode
	long ll_relationcode
	long ll_doctcode
	long ll_recurringperiod
	string ls_regno
	SQL SELECT RegNo , wardcode , relationcode , doctcode , ISNULL ( RecurringPeriod , 0 ) INTO :ls_regno, :ll_wardcode, :ll_relationcode, :ll_doctcode, :ll_recurringperiod FROM Patient WHERE PatientCode =:al_patientcode AND Active ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ll_recurringperiod) then
			ll_recurringperiod = 0
		end if
		this.id_master.setitem(this.id_master.rowcount(), "patientregno", ls_regno)
		return 1
	end if
	return 0

// w_salereturn.wf_editpostedinvoice() returns 0
	long ll_code
	string ls_specialright
	s_invdetail lstr_invdetail
	ls_specialright = "2"
	if gl_usercode <> 1 then
		return
	end if
	if this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
	end if
	if ll_code > 0 and this.id_list.object.posted[this.id_list.getrow()] = "Y" then
		if f_is_specialright_enabled(ls_specialright) then
			openwithparm(w_special_rights_password, ls_specialright)
			if message.doubleparm > 0.0 then
				lstr_invdetail.i_module = this.ii_module
				lstr_invdetail.l_invcode = ll_code
				openwithparm(w_editpostedinvoice, lstr_invdetail)
			else
				return
			end if
		else
			return
		end if
		return
	end if

// w_salereturn.wf_fetchserverdate(boolean ab_checked) returns long
	if ab_checked then
		this.ib_fetchserverdate = true
	else
		this.ib_fetchserverdate = false
	end if
	return 0

// w_salereturn.wf_check_save_right() returns long
	long ll_found
	if this.ib_checksaveright = true then
		ll_found = gds_securitywindow.find("rightcode = 700", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			return 1
		else
			messagebox("Problem in Saving Sale Return Invoice", "You donot have right to Save Sales Return Invoice.~r~nPress Ctrl + P  for Save and Print", information!, ok!)
			return 0
		end if
		return
	end if
	this.ib_checksaveright = true
	return 1

// w_salereturn.wf_assign_master_cash_win_object() returns 0
	this.ids_cashwin = create u_ds_standard
	this.ids_cashwin.dataobject = "d_mastercashierwindow_detail"
	this.ids_cashwin.settransobject(this.it_transobject)

// w_salereturn.wf_set_cashaccount() returns long
	long ll_cashacccode
	long ll_module
	long ll_code
	if this.ii_salerettype = 8 then
		ll_module = 31
	else
		ll_module = 32
	end if
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = f_is_group_module_cashaccount_allowed(this.il_groupcode, ll_module)
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		ll_cashacccode = 0
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
	elseif isnull(ll_code) or this.id_master.object.code[1] <= 0 then
		this.id_master.object.cashacccode[this.id_master.rowcount()] = ll_cashacccode
	else
		ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	end if
	return ll_cashacccode

// w_salereturn.wf_show_mastercashierwindow() returns long
	long ll_counter
	long ll_code
	long ll_row
	long ll_insrow
	long ll_module
	long ll_cashacccode
	double ld_tot_acc_amt
	s_mastercashwin_all lstr_values
	if this.ii_salerettype = 8 then
		lstr_values.i_interfacecode = 9
		ll_module = 31
		if f_stringpreferences("askmastercashwin_in_cashsr") = "N" then
			return 1
		end if
	else
		lstr_values.i_interfacecode = 10
		ll_module = 32
		if f_stringpreferences("askmastercashwin_in_crsr") = "N" then
			return 1
		end if
	end if
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
		return 0
	end if
	lstr_values.l_doccode = ll_code
	lstr_values.s_doctype = this.is_doctype
	lstr_values.l_cashacccode = ll_cashacccode
	lstr_values.l_groupcode = this.il_groupcode
	lstr_values.l_module = ll_module
	lstr_values.d_netamt = wf_grandtotal()
	lstr_values.d_cashtendered = this.id_master.object.cashtendered[this.id_master.rowcount()]
	lstr_values.d_cashcharged = this.id_master.object.cashcharged[this.id_master.rowcount()]
	lstr_values.d_cashback = this.id_master.object.cashback[this.id_master.rowcount()]
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		lstr_values.l_acccode[ll_counter] = this.ids_cashwin.object.acccode[ll_counter]
		lstr_values.s_remarks[ll_counter] = this.ids_cashwin.object.remarks[ll_counter]
		lstr_values.d_amount[ll_counter] = this.ids_cashwin.object.amount[ll_counter]
		lstr_values.l_rowid[ll_counter] = this.ids_cashwin.object.rowid[ll_counter]
		ld_tot_acc_amt = ld_tot_acc_amt + this.ids_cashwin.object.amount[ll_counter]
	next
	if lstr_values.d_netamt >= lstr_values.d_cashcharged then
		lstr_values.d_docbalance = lstr_values.d_netamt - lstr_values.d_cashcharged - ld_tot_acc_amt
	else
		lstr_values.d_docbalance = 0
	end if
	for ll_counter = 1 to 100
		if lstr_values.l_rowid[ll_counter] <= 0 then
			lstr_values.l_rowid[ll_counter] = -1
		end if
	next
	openwithparm(w_mastercashierwindow, lstr_values)
	lstr_values = message.powerobjectparm
	if lstr_values.i_status = 1 then
		this.ids_cashwin.reset()
		ld_tot_acc_amt = 0
		for ll_counter = 1 to 100
			if lstr_values.l_acccode[ll_counter] > 0 and lstr_values.d_amount[ll_counter] > 0 and lstr_values.l_rowid[ll_counter] > 0 then
				ll_insrow = this.ids_cashwin.insertrow(0)
				this.ids_cashwin.object.documentcode[ll_insrow] = ll_code
				this.ids_cashwin.object.documenttype[ll_insrow] = this.is_doctype
				this.ids_cashwin.object.acccode[ll_insrow] = lstr_values.l_acccode[ll_counter]
				this.ids_cashwin.object.remarks[ll_insrow] = lstr_values.s_remarks[ll_counter]
				this.ids_cashwin.object.amount[ll_insrow] = lstr_values.d_amount[ll_counter]
				this.ids_cashwin.object.rowid[ll_insrow] = lstr_values.l_rowid[ll_counter]
			end if
		next
		this.id_master.object.cashacccode[this.id_master.rowcount()] = lstr_values.l_cashacccode
		this.id_master.object.cashtendered[this.id_master.rowcount()] = lstr_values.d_cashtendered
		this.id_master.object.cashcharged[this.id_master.rowcount()] = lstr_values.d_cashcharged
		this.id_master.object.cashback[this.id_master.rowcount()] = lstr_values.d_cashback
		if this.ii_salerettype = 7 then
			this.id_master.object.outstandingamt[this.id_master.rowcount()] = lstr_values.d_docbalance
		elseif this.id_master.object.cashcharged[this.id_master.rowcount()] = lstr_values.d_netamt and lstr_values.d_docbalance = 0 then
			this.id_master.object.outstandingamt[this.id_master.rowcount()] = 0
		else
			this.id_master.object.outstandingamt[this.id_master.rowcount()] = lstr_values.d_docbalance
		end if
		return 1
	end if
	return 0

// w_salereturn.wf_update_mastercashierwindow(long al_code, string as_type) returns long
	long ll_counter
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		this.ids_cashwin.object.documentcode[ll_counter] = al_code
		this.ids_cashwin.object.documenttype[ll_counter] = as_type
		this.ids_cashwin.object.date[ll_counter] = this.id_master.object.date[1]
	next
	SQL DELETE DBO.MasterCashWin WHERE DocumentCode =:al_code AND DocumentType =:as_type USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if this.ids_cashwin.update() > 0 then
			return 0
		else
			return -1
		end if
		return
	end if
	return -1

// w_salereturn.wf_findfullcode(string as_fullcode, long al_icode, string as_itemname, long al_itemcodetype) returns long
	long ll_retflag
	long ll_rowid
	setnull(al_icode)
	as_itemname = "                                                            "
	if not this.ib_opensalereturn then
		ll_rowid = this.id_itemslist.find("fullcode = '" + as_fullcode + "'", 1, this.id_itemslist.rowcount())
		if ll_rowid > 0 and ll_rowid <= this.id_itemslist.rowcount() then
			al_icode = this.id_itemslist.getitemnumber(ll_rowid, "icode")
			as_itemname = this.id_itemslist.getitemstring(ll_rowid, "itemname")
			this.id_itemslist.setrow(ll_rowid)
			ll_retflag = 1
		else
			ll_retflag = 0
		end if
	else
		this.it_transobject.getaliasname(gl_usercode, as_fullcode, al_icode, as_itemname, al_itemcodetype)
		if this.it_transobject.sqlcode = 0 then
			if isnull(al_icode) then
				ll_retflag = 0
			else
				ll_retflag = 1
			end if
		else
			ll_retflag = -1
		end if
	end if
	return ll_retflag

// w_salereturn.wf_pd_initialize() returns long
	string ls_init_string
	ls_init_string = char(27) + char(73) + char(12)
	pd_writepd(ls_init_string, len(ls_init_string))
	return 0

// w_salereturn.wf_guest_retrieve() returns long
	long ll_row
	long ll_code
	this.idc_guest.retrieve()
	ll_row = this.idc_guest.insertrow(0)
	setnull(ll_code)
	this.idc_guest.setitem(ll_row, "code", ll_code)
	this.idc_guest.setitem(ll_row, "regno", "<NONE>")
	this.idc_guest.setitem(ll_row, "guest", "<NONE>")
	this.idc_guest.setitem(ll_row, "customer", "<NONE>")
	this.idc_guest.scrolltorow(ll_row)
	return 0

// w_salereturn.wf_student_retrieve() returns long
	long ll_row
	long ll_code
	this.idc_student.retrieve()
	ll_row = this.idc_student.insertrow(0)
	setnull(ll_code)
	this.idc_student.setitem(ll_row, "code", ll_code)
	this.idc_student.setitem(ll_row, "regno", "<NONE>")
	this.idc_student.setitem(ll_row, "student", "<NONE>")
	this.idc_student.setitem(ll_row, "customer", "<NONE>")
	this.idc_student.scrolltorow(ll_row)
	return 0

// w_salereturn.wf_findguestcode(string as_regno, long al_code) returns long
	long ll_guestcode
	long ll_retflag
	string ls_itemname
	char lc_active
	ll_retflag = 0
	SQL SELECT Guest.Guestcode , Guest.active INTO :ll_guestcode, :lc_active FROM Guest WHERE Guest.regno =:as_regno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_code = ll_guestcode
		if isnull(al_code) then
			ll_retflag = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
		else
			ll_retflag = -2
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_salereturn.wf_findstudentcode(string as_regno, long al_code) returns long
	long ll_studentcode
	long ll_retflag
	string ls_itemname
	char lc_active
	ll_retflag = 0
	SQL SELECT Student.Studentcode INTO :ll_studentcode FROM Student WHERE Student.regno =:as_regno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_code = ll_studentcode
		if isnull(al_code) then
			ll_retflag = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
		else
			ll_retflag = -2
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_salereturn.wf_setstudentinfo(long al_code) returns long
	long ll_doctcode
	long ll_custcode
	long ll_retcode
	string ls_regno
	string ls_aliasname
	SQL SELECT Student.RegNo , Student.CustCode , Accounts.AliasName INTO :ls_regno, :ll_custcode, :ls_aliasname FROM Student , Accounts WHERE Student.StudentCode =:al_code AND Student.CustCode =Accounts.AccCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.setitem(this.id_master.rowcount(), "Studentregno", ls_regno)
		this.id_master.setitem(this.id_master.rowcount(), "custcode", ll_custcode)
		this.id_master.setitem(this.id_master.rowcount(), "aliasname", ls_aliasname)
		this.id_master.object.custcode.protect = 1
		this.id_master.object.aliasname.protect = 1
		ll_retcode = 1
	else
		messagebox("Student Information", "Problem in retrieving corresponding customer")
		ll_retcode = 0
	end if
	return ll_retcode

// w_salereturn.wf_setguestinfo(long al_code) returns long
	long ll_doctcode
	long ll_custcode
	long ll_retcode
	string ls_regno
	string ls_aliasname
	SQL SELECT Guest.RegNo , Guest.CustCode , Accounts.AliasName INTO :ls_regno, :ll_custcode, :ls_aliasname FROM Guest , Accounts WHERE Guest.GuestCode =:al_code AND Guest.Active ='Y' AND Guest.CustCode =Accounts.AccCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.setitem(this.id_master.rowcount(), "Guestregno", ls_regno)
		this.id_master.setitem(this.id_master.rowcount(), "custcode", ll_custcode)
		this.id_master.setitem(this.id_master.rowcount(), "aliasname", ls_aliasname)
		this.id_master.object.custcode.protect = 1
		this.id_master.object.aliasname.protect = 1
		ll_retcode = 1
	else
		messagebox("Guest Information", "Problem in retrieving corresponding customer")
		ll_retcode = 0
	end if
	return ll_retcode

// w_salereturn.wf_setguestcheckin() returns long
	long ll_guestcode
	long ll_guestcheckincode
	long ll_found
	setnull(ll_guestcheckincode)
	ll_guestcode = this.id_master.object.guestcode[1]
	if ll_guestcode > 0 then
		SQL SELECT MAX ( GC.GuestCheckInCode ) INTO :ll_guestcheckincode FROM GuestCheckIn GC WHERE GC.GuestCode =:ll_guestcode AND GC.CheckOut ='N' USING this.it_transobject;
		if ll_guestcheckincode = 0 or isnull(ll_guestcheckincode) then
			setnull(ll_guestcheckincode)
		end if
		this.id_master.object.guestcheckincode[1] = ll_guestcheckincode
	else
		this.id_master.object.guestcheckincode[1] = ll_guestcheckincode
	end if
	return 0

// w_salereturn.wf_findfullcode(string as_fullcode, long al_icode, string as_itemname, long al_itemcodetype, double ad_qty, double ad_purprice, double ad_saleprice) returns long
	long ll_retflag
	long ll_rowid
	setnull(al_icode)
	as_itemname = "                                                            "
	if not this.ib_opensalereturn then
		ll_rowid = this.id_itemslist.find("fullcode = '" + as_fullcode + "'", 1, this.id_itemslist.rowcount())
		if ll_rowid > 0 and ll_rowid <= this.id_itemslist.rowcount() then
			al_icode = this.id_itemslist.getitemnumber(ll_rowid, "icode")
			as_itemname = this.id_itemslist.getitemstring(ll_rowid, "itemname")
			this.id_itemslist.setrow(ll_rowid)
			ll_retflag = 1
		else
			ll_retflag = 0
		end if
	else
		this.it_transobject.getaliasname_withqtyprice(gl_usercode, as_fullcode, al_icode, as_itemname, al_itemcodetype, ad_qty, ad_purprice, ad_saleprice)
		if this.it_transobject.sqlcode = 0 then
			if isnull(al_icode) then
				ll_retflag = 0
			else
				ll_retflag = 1
			end if
		else
			ll_retflag = -1
		end if
	end if
	return ll_retflag

// w_salereturn.wf_recheck_returned_items() returns long
	long ll_rowcount
	long ll_counter
	long ll_icode
	long ll_found
	long ll_retcode
	long ll_itemlistrows
	if not this.ib_opensalereturn then
		ll_rowcount = this.id_detail.rowcount()
		ll_itemlistrows = this.id_itemslist.rowcount()
		if ll_rowcount > 0 then
			for ll_counter = 1 to ll_rowcount
				ll_icode = this.id_detail.object.icode[ll_counter]
				ll_found = this.id_itemslist.find("icode = " + trim(string(ll_icode)), 1, ll_itemlistrows)
				if not (ll_found > 0 and ll_found <= ll_itemlistrows) then
					messagebox("Sale Return Item Validation", "Can not Sale Return this Item on this invoice~r~nThis item does not exist in original sale invoice.", stopsign!)
					this.id_detail.setrow(ll_counter)
					this.id_detail.setfocus()
					ll_retcode = 1
					return ll_retcode
				end if
			next
		end if
	end if
	return ll_retcode

// w_salereturn.wf_set_discperc_onlyon_unlock_discperc() returns long
	string ls_errtext
	s_arguements lstr_arg
	if f_rightexists(5164) then
		open(w_arg_sinvcode_linvcode)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = 1 then
			SQL update SRLedger SET PostDate =Date WHERE SRInvCode BETWEEN :lstr_arg.l_code1 AND :lstr_arg.l_code2 USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				SQL commit USING this.it_transobject;
			else
				ls_errtext = this.it_transobject.sqlerrtext
				SQL rollback USING this.it_transobject;
				messagebox("Sale Return Posting Date Updation Error", "Error in Updating Posting Date for Selected Sale Returns.~r~nReasons are:-~r~n" + ls_errtext, stopsign!)
			end if
		end if
	end if
	return 0

// w_salereturn.wf_replace_postdate_with_date() returns long
	string ls_errtext
	s_arguements lstr_arg
	if f_rightexists(5164) then
		open(w_arg_sinvcode_linvcode)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = 1 then
			SQL update SRLedger SET PostDate =Date WHERE SRInvCode BETWEEN :lstr_arg.l_code1 AND :lstr_arg.l_code2 USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				SQL commit USING this.it_transobject;
			else
				ls_errtext = this.it_transobject.sqlerrtext
				SQL rollback USING this.it_transobject;
				messagebox("Sale Return Posting Date Updation Error", "Error in Updating Posting Date for Selected Sales Returns.~r~nReasons are:-~r~n" + ls_errtext, stopsign!)
			end if
		end if
	end if
	return 0

// w_salereturn.wf_apply_currency(long al_currencycode) returns boolean
	double ld_conversionrate
	SQL SELECT ConversionFactor INTO :ld_conversionrate FROM Currency WHERE CurrencyCode =:al_currencycode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ld_conversionrate) or ld_conversionrate <= 0.0 then
			ld_conversionrate = 0
		end if
		this.id_master.object.conversionrate[1] = ld_conversionrate
		this.id_footer.object.conversionrate[1] = ld_conversionrate
		this.id_footer.object.currencycode[1] = al_currencycode
		return true
	end if
	return false

// w_salereturn.wf_apply_conversionrate(double ad_rate) returns boolean
	if isnull(ad_rate) or ad_rate <= 0.0 then
		return false
	end if
	this.id_footer.object.conversionrate[1] = ad_rate
	return true

// w_salereturn.wf_check_unique_refno() returns long
	long ll_custcode
	long ll_invid
	long ll_counter
	string ls_refno
	if f_stringpreferences("UniqueRefNoInSale") = "Y" and this.ib_opensalereturn then
		ls_refno = this.id_master.getitemstring(1, "custrefno")
		if trim(ls_refno) <> "" and not isnull(ls_refno) and (this.ii_salerettype = 7 or this.ii_salerettype = 1) then
			ll_custcode = this.id_master.getitemnumber(1, "custcode")
			ll_counter = 0
			ll_invid = 0
			ll_invid = this.id_master.getitemnumber(1, "code")
			if ll_invid > 0 then
				SQL SELECT COUNT ( *) INTO :ll_counter FROM srledger WHERE custcode =:ll_custcode AND srledger.srinvcode <> :ll_invid AND RTrim ( LTrim ( custrefno ) ) =RTrim ( LTrim ( :ls_refno ) ) USING this.it_transobject;
			else
				SQL SELECT COUNT ( *) INTO :ll_counter FROM srledger WHERE custcode =:ll_custcode AND RTrim ( LTrim ( custrefno ) ) =RTrim ( LTrim ( :ls_refno ) ) USING this.it_transobject;
			end if
			if ll_counter > 0 then
				messagebox("Ref. validation", "Ref. No " + ls_refno + " already exist for selected customer ~r~nplease type a unique Ref.No. ")
				this.id_master.setcolumn("custrefno")
				this.id_master.setfocus()
				return 0
			end if
			return
		end if
		return
	end if
	return 1

// w_salereturn.wf_setgodownoption() returns 0
	this.ii_salegodown = this.id_detail.getitemnumber(1, "gcode")
	if this.il_strategy = 2 or this.il_strategy = 1 and this.il_godowncount = 1 then
		this.id_detail.object.gcode.protect = 1
		this.id_detail.object.gcode.background.color = this.backcolor
	end if

// w_salereturn.wf_fiscalizesrinvoice() returns long
	long ll_srinvcode
	string ls_fiscalized
	string ls_posted
	if this.tab_retrieve.selectedtab = 2 and this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 then
		ll_srinvcode = this.id_list.object.code[this.id_list.getrow()]
		SQL SELECT Fiscalized , Posted INTO :ls_fiscalized, :ls_posted FROM SRLedger WHERE SRInvCode =:ll_srinvcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 and (ls_posted = "Y" and ls_fiscalized = "N") then
			f_fiscalizesrinvoice(ll_srinvcode)
		end if
	end if
	return 0

// w_salereturn.wf_copyinvoice() returns long
	datastore lds_saletemplatedetail
	datastore lds_saletemplateheader
	s_saletemplate lstr_template
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	boolean lb_bonus
	boolean lb_salepricefromtemplate
	long ll_row
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrows
	long ll_packunits
	long ll_found
	long ll_innercounter
	integer li_retcode
	integer li_errcode
	integer li_counter
	integer li_addbonusinqty
	double ld_looseqty
	double ld_holdbonusqty
	double ld_holdqty
	datawindowchild ldc_godown
	if not this.ib_opensalereturn then
		return 0
	end if
	if wf_iseditable() = false then
		return 0
	end if
	lds_saletemplatedetail = create datastore
	lds_saletemplateheader = create datastore
	open(w_copysaleinvoicefrom3)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		destroy lds_saletemplatedetail
		return -1
	end if
	if lstr_template.c_copyinvfrom = "I" then
		lds_saletemplatedetail.dataobject = "d_SaleDetail"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		lds_saletemplateheader.dataobject = "d_WholeSaleHeader"
		lds_saletemplateheader.settransobject(this.it_transobject)
		li_retcode = lds_saletemplateheader.retrieve(lstr_template.l_invtemplate)
		if li_retcode > 0 then
			ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
			if ll_totalrows < 0 then
				li_retcode = -1
			end if
			ll_totalrows = lds_saletemplatedetail.rowcount()
			if ll_totalrows > 0 then
				lb_enablesave = true
			end if
			for li_counter = 1 to li_counter
				event ue_deleteitem()
			next
			this.id_master.object.aliasname[1] = lds_saletemplateheader.object.aliasname[1]
			this.id_master.object.custcode[1] = lds_saletemplateheader.object.custcode[1]
			this.id_master.object.patientregno[1] = lds_saletemplateheader.object.patientregno[1]
			this.id_master.object.patientcode[1] = lds_saletemplateheader.object.patientcode[1]
			this.id_master.object.remarks[1] = lds_saletemplateheader.object.remarks[1]
			this.id_master.object.custrefno[1] = lds_saletemplateheader.object.custrefno[1]
			this.id_master.object.flatdisc[1] = lds_saletemplateheader.object.flatdisc[1]
			this.id_master.object.discperc[1] = lds_saletemplateheader.object.discperc[1]
			this.id_master.object.misccharges[1] = lds_saletemplateheader.object.misccharges[1]
			this.id_master.object.invgstperc1[1] = lds_saletemplateheader.object.invgstperc1[1]
			for ll_rowcount = 1 to ll_totalrows
				ll_row = this.id_detail.insertrow(0)
				wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_row, ls_errortext)
				this.id_detail.setitem(ll_row, "batch", lds_saletemplatedetail.getitemstring(ll_rowcount, "batch"))
				this.id_detail.setitem(ll_row, "expiry", lds_saletemplatedetail.getitemdatetime(ll_rowcount, "expiry"))
				this.id_detail.setitem(ll_row, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "looseqty"))
				this.id_detail.setitem(ll_row, "bonusqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "bonusqty"))
				this.id_detail.setitem(ll_row, "srprice", lds_saletemplatedetail.getitemnumber(ll_rowcount, "saleprice") - lds_saletemplatedetail.getitemnumber(ll_rowcount, "itemflatdisc"))
				this.id_detail.setitem(ll_row, "discperc", lds_saletemplatedetail.getitemnumber(ll_rowcount, "discperc"))
				this.id_detail.setitem(ll_row, "gstperc", lds_saletemplatedetail.getitemnumber(ll_rowcount, "gstperc"))
				this.id_detail.setitem(ll_row, "unitsalestax", lds_saletemplatedetail.getitemnumber(ll_rowcount, "unitsalestax"))
			next
		end if
	elseif lstr_template.c_copyinvfrom = "R" then
		lds_saletemplatedetail.dataobject = "d_OpenWholeSaleReturnDetail"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		lds_saletemplateheader.dataobject = "d_OpenWholeSaleReturn"
		lds_saletemplateheader.settransobject(this.it_transobject)
		li_retcode = lds_saletemplateheader.retrieve(lstr_template.l_invtemplate)
		if li_retcode > 0 then
			li_retcode = lds_saletemplatedetail.getchild("gcode", ldc_godown)
			ldc_godown.settransobject(this.it_transobject)
			li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
			ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
			if ll_totalrows < 0 then
				li_retcode = -1
			end if
			ll_totalrows = lds_saletemplatedetail.rowcount()
			if ll_totalrows > 0 then
				lb_enablesave = true
			end if
			for li_counter = 1 to li_counter
				event ue_deleteitem()
			next
			this.id_master.object.aliasname[1] = lds_saletemplateheader.object.aliasname[1]
			this.id_master.object.custcode[1] = lds_saletemplateheader.object.custcode[1]
			this.id_master.object.patientregno[1] = lds_saletemplateheader.object.patientregno[1]
			this.id_master.object.patientcode[1] = lds_saletemplateheader.object.patientcode[1]
			this.id_master.object.remarks[1] = lds_saletemplateheader.object.remarks[1]
			this.id_master.object.custrefno[1] = lds_saletemplateheader.object.custrefno[1]
			this.id_master.object.flatdisc[1] = lds_saletemplateheader.object.flatdisc[1]
			this.id_master.object.discperc[1] = lds_saletemplateheader.object.discperc[1]
			this.id_master.object.misccharges[1] = lds_saletemplateheader.object.misccharges[1]
			this.id_master.object.invgstperc1[1] = lds_saletemplateheader.object.invgstperc1[1]
			for ll_rowcount = 1 to ll_totalrows
				ll_row = this.id_detail.insertrow(0)
				wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_row, ls_errortext)
				this.id_detail.setitem(ll_row, "batch", lds_saletemplatedetail.getitemstring(ll_rowcount, "batch"))
				this.id_detail.setitem(ll_row, "expiry", lds_saletemplatedetail.getitemdatetime(ll_rowcount, "expiry"))
				this.id_detail.setitem(ll_row, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "looseqty"))
				this.id_detail.setitem(ll_row, "bonusqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "bonusqty"))
				this.id_detail.setitem(ll_row, "srprice", lds_saletemplatedetail.getitemnumber(ll_rowcount, "srprice"))
				this.id_detail.setitem(ll_row, "discperc", lds_saletemplatedetail.getitemnumber(ll_rowcount, "discperc"))
				this.id_detail.setitem(ll_row, "gstperc", lds_saletemplatedetail.getitemnumber(ll_rowcount, "gstperc"))
				this.id_detail.setitem(ll_row, "unitsalestax", lds_saletemplatedetail.getitemnumber(ll_rowcount, "unitsalestax"))
			next
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	destroy lds_saletemplatedetail
	destroy lds_saletemplateheader
	return li_retcode

// w_salereturn.wf_fiscalizesrinvoices() returns long
	integer li_errcode
	long ll_salesmancode
	long ll_invcount
	long ll_counter
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	long ll_srinvcode
	long ll_rows
	string ls_fiscalized
	string ls_posted
	datastore lds_invoices
	if this.tab_retrieve.selectedtab = 2 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
		if ll_salesmancode > 0 then
			open(w_arg_sinvcode_linvcode)
			lstr_arginfo = message.powerobjectparm
			if lstr_arginfo.i_status = 1 and lstr_arginfo.l_code1 <= lstr_arginfo.l_code2 then
				setpointer(hourglass!)
				lds_invoices = create datastore
				lds_invoices.dataobject = "d_srinvlist_notfiscalized"
				lds_invoices.settransobject(this.it_transobject)
				ll_rows = lds_invoices.retrieve(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
				if ll_rows > 0 then
					for ll_counter = 1 to ll_rows
						ll_srinvcode = lds_invoices.object.srinvcode[ll_counter]
						if ll_srinvcode > 0 then
							SQL SELECT Fiscalized , Posted INTO :ls_fiscalized, :ls_posted FROM SRLedger WHERE SRInvCode =:ll_srinvcode USING this.it_transobject;
							if this.it_transobject.sqlcode = 0 and (ls_posted = "Y" and ls_fiscalized = "N") then
								f_fiscalizesrinvoice(ll_srinvcode)
								ll_invcount = ll_invcount + 1
							end if
						end if
					next
					if ll_invcount > 0 then
						messagebox("Fiscalization Completed", "Total S/R Invoices were : " + trim(string(ll_rows)) + "~r~nFiscalized Successfully : " + trim(string(ll_invcount)))
					end if
				end if
			end if
		else
			setfocus()
		end if
	end if
	return 0

// w_salereturn.wf_apply_pricepolicy(integer ai_mode) returns long
	long ll_custcode
	long ll_masterrow
	long ll_detailrows
	long ll_found
	long ll_counter
	long ll_retcode
	long ll_rowcount
	long ll_icode
	long ll_manualprice_itemcount
	double ld_looseqty
	double ld_bonusqty
	double ld_policy_price
	double ld_price
	string ls_msgtitle
	string ls_itemname
	string ls_msgdetail
	string ls_finditem
	boolean lb_editsaleprice
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_custcode = this.id_master.getitemnumber(ll_masterrow, "custcode")
	if ll_custcode = 0 or isnull(ll_custcode) then
		messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Items before applying Price Policy to this invoice", stopsign!)
		return 0
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 511", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editsaleprice = true
	else
		messagebox(ls_msgtitle, "Not enough rights to modify item sale price.~r~nPlease contact system administrator for help", stopsign!)
		return 0
	end if
	setredraw(false)
	ll_detailrows = this.id_detail.rowcount()
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ld_looseqty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		ld_price = this.id_detail.getitemnumber(ll_rowcount, "srprice")
		if ld_looseqty > 0.0 and ll_icode >= 0 and not isnull(ll_icode) then
			this.it_transobject.getpricepolicybased_itemprice(gl_usercode, ll_icode, ld_looseqty, ld_policy_price)
			if this.it_transobject.sqlcode = 0 then
				if isnull(ld_policy_price) or ld_policy_price = 0.0 then
					ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_counter) + "~t Item Name:  " + ls_itemname
					ll_manualprice_itemcount = ll_manualprice_itemcount + 1
				else
					this.id_detail.object.srprice[ll_rowcount] = round(ld_policy_price, 2)
				end if
			else
				ls_msgdetail = "Some Problem Occured while fetching item Price policy details~r~n" + this.it_transobject.sqlerrtext
				messagebox(ls_msgtitle, ls_msgdetail, stopsign!)
				return 0
			end if
			return
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_manualprice_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Price Policy exists for Following " + trim(string(ll_manualprice_itemcount)) + " item(s)~r~nTheir Pricing should be set by user manually~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_salereturn.wf_motorvehicle_retrieve() returns long
	long ll_row
	long ll_code
	this.idc_motorvehicle.settransobject(this.it_transobject)
	this.idc_motorvehicle.retrieve()
	ll_row = this.idc_motorvehicle.insertrow(0)
	setnull(ll_code)
	this.idc_motorvehicle.setitem(ll_row, "code", ll_code)
	this.idc_motorvehicle.setitem(ll_row, "chasisno", "<NONE>")
	this.idc_motorvehicle.setitem(ll_row, "motorvehicle", "<NONE>")
	this.idc_motorvehicle.setitem(ll_row, "customer", "<NONE>")
	this.idc_motorvehicle.scrolltorow(ll_row)
	return 0

// w_salereturn.wf_find_motorvehiclecode(string as_chasisno, long al_code) returns long
	long ll_motorvehiclecode
	long ll_retflag
	ll_retflag = 0
	SQL SELECT motorvehiclecode INTO :ll_motorvehiclecode FROM motorvehicle WHERE chasisno =:as_chasisno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_code = ll_motorvehiclecode
		if isnull(al_code) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_salereturn.wf_motorvehiclesearch() returns string
	string ls_chasisno
	long ll_res
	long ll_null
	long ll_code
	s_arguements ls_arguements
	setnull(ll_null)
	open(w_vehiclesearch)
	ls_arguements = message.powerobjectparm
	if ls_arguements.i_status = 1 then
		openwithparm(w_vehiclesearchresult, ls_arguements)
		ls_arguements = message.powerobjectparm
		if ls_arguements.i_status = 1 and ls_arguements.l_code1 > 0 then
			this.id_master.object.chasisno[1] = ls_arguements.s_name1
			this.id_master.object.motorvehiclecode[1] = ls_arguements.l_code1
			this.id_master.object.custcode[1] = ls_arguements.l_code2
			ll_code = ls_arguements.l_code1
			wf_set_motorvehicleinfo(ll_code)
			ls_chasisno = this.id_master.object.chasisno[1]
		end if
	end if
	return ls_chasisno

// w_salereturn.wf_set_motorvehicleinfo(long al_code) returns long
	long ll_custcode
	long ll_retcode
	string ls_chasisno
	string ls_aliasname
	SQL SELECT MotorVehicle.ChasisNo , MotorVehicle.CustCode , Accounts.AliasName INTO :ls_chasisno, :ll_custcode, :ls_aliasname FROM MotorVehicle , Accounts WHERE MotorVehicle.MotorVehicleCode =:al_code AND MotorVehicle.CustCode =Accounts.AccCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.setitem(this.id_master.rowcount(), "chasisno", ls_chasisno)
		this.id_master.setitem(this.id_master.rowcount(), "custcode", ll_custcode)
		this.id_master.setitem(this.id_master.rowcount(), "aliasname", ls_aliasname)
		this.id_master.object.custcode.protect = 1
		this.id_master.object.aliasname.protect = 1
		ll_retcode = 1
	else
		messagebox("Motor Vehicle Information", "Problem in retrieving corresponding customer")
		ll_retcode = 0
	end if
	return ll_retcode

// w_salereturn.wf_link_to_cashiershift() returns long
	long ll_cashiershiftcode
	if f_stringpreferences("CashierShift") = "Y" then
		this.id_master.object.cashiershiftcode.visible = true
		SQL SELECT MAX ( A.CashierShiftCode ) INTO :ll_cashiershiftcode FROM ( SELECT CashierShiftCode =CashierShiftCode FROM CashierShift WHERE ShiftStatus ='O' AND ShiftOwner =:gl_usercode UNION SELECT CashierShiftCode =CashierShiftCode FROM CashierShiftUsers WHERE UserCode =:gl_usercode AND CashierShiftCode IN ( SELECT CashierShiftCode FROM CashierShift WHERE ShiftStatus ='O' ) ) A USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if ll_cashiershiftcode < 0 then
				ll_cashiershiftcode = -1
			end if
		else
			ll_cashiershiftcode = -1
		end if
	else
		ll_cashiershiftcode = -1
	end if
	if ll_cashiershiftcode = -1 then
		setnull(ll_cashiershiftcode)
	end if
	this.id_master.object.cashiershiftcode[1] = ll_cashiershiftcode
	return 0

// w_salereturn.wf_check_cashiershift_on_saving(long al_cashiershiftcode, long al_usercode) returns long
	long ll_cashiershiftcode
	long ll_cashacccode
	if f_stringpreferences("CashierShift") = "Y" then
		this.id_master.object.cashiershiftcode.visible = true
		SQL SELECT MAX ( A.CashierShiftCode ) INTO :ll_cashiershiftcode FROM ( SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND ShiftOwner =:al_usercode AND CashierShiftCode =:al_cashiershiftcode UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShiftUsers WHERE UserCode =:al_usercode AND CashierShiftCode IN ( SELECT MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND CashierShiftCode =:al_cashiershiftcode ) UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND ShiftOwner =:al_usercode UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShiftUsers WHERE UserCode =:al_usercode AND CashierShiftCode IN ( SELECT MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' ) ) A USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if ll_cashiershiftcode < 0 then
				ll_cashiershiftcode = -1
			end if
		else
			ll_cashiershiftcode = -1
		end if
	else
		ll_cashiershiftcode = -1
	end if
	if ll_cashiershiftcode = -1 then
		setnull(ll_cashiershiftcode)
	end if
	this.id_master.object.cashiershiftcode[1] = ll_cashiershiftcode
	if ll_cashiershiftcode > 0 then
		SQL SELECT CashAccCode INTO :ll_cashacccode FROM CashierShift WHERE CashierShiftCode =:ll_cashiershiftcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.id_master.object.cashacccode[1] = ll_cashacccode
		end if
	end if
	if f_stringpreferences("CashierShift") = "Y" and isnull(ll_cashiershiftcode) then
		messagebox("Cashier Shift Linkage Missing", "Cashier Shift Linkage Missing~r~nContact System Administrator and try again.", stopsign!)
		return -1
	end if
	return 0

// w_salereturn.wf_push_sr_to_dropbox() returns long
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	if ll_salesmancode > 0 then
		open(w_arg_cust_sinvcode_linvcode2)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			li_errcode = this.it_transobject.pushsrtodropbox(lstr_arginfo.l_code1, lstr_arginfo.l_code2, lstr_arginfo.l_code3, ll_salesmancode, gs_dropbox_server, gs_dropbox_db, "DBO", ll_saleinvcount)
			if li_errcode <> 0 then
				li_errcode = this.it_transobject.sqlcode
				ls_msgtext = this.it_transobject.sqlerrtext
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				ls_msgtext = this.it_transobject.sqlerrtext
				li_errcode = this.it_transobject.sqlcode
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Push Sales To Drop Box Fails", "Some database request fails, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode), stopsign!)
		else
			messagebox("Push to Drop Box Successfull", "Total Invoices to push were " + string(ll_saleinvcount) + "~n~rAll Invoices have been pushed successfully to drop box.", information!)
		end if
	end if
	return li_errcode

// w_salereturn.wf_gen_qrcode(long al_code, string as_qrcode) returns integer
	string ls_qr_method
	string ls_setting
	long ll_rows
	ls_qr_method = f_stringpreferences("qrcodeprintingmethodinsale")
	ls_setting = this.id_print.describe("p_qrcode.filename")
	ll_rows = this.id_print.rowcount()
	if ls_setting = "!" then
		ls_setting = this.id_print.object.dw_1[ll_rows].object.p_qrcode.filename
		if ls_setting <> "!" then
			if ls_qr_method = "G" then
				this.id_print.object.dw_1[ll_rows].object.p_qrcode.filename = "qrcode.gif"
				f_get_google_qrcode(as_qrcode)
			elseif ls_qr_method = "H" then
				this.id_print.object.dw_1[ll_rows].object.p_qrcode.filename = "qrcode.gif"
				f_get_googleqrcode_for_fiscalinvno(al_code)
			elseif ls_qr_method = "I" then
				f_gen_idautomation_qrcode(as_qrcode)
			elseif ls_qr_method = "M" then
				this.id_print.object.dw_1[ll_rows].object.p_qrcode.filename = "qrcode.bmp"
				f_gen_morovia_qrcode(as_qrcode, 5, 3)
			elseif ls_qr_method = "Q" then
				this.id_print.object.dw_1[ll_rows].object.p_qrcode.filename = "qrcode.bmp"
				f_gen_pb_qrcode(as_qrcode)
			end if
		end if
	elseif ls_qr_method = "G" then
		this.id_print.object.p_qrcode.filename = "qrcode.gif"
		f_get_google_qrcode(as_qrcode)
	elseif ls_qr_method = "H" then
		this.id_print.object.p_qrcode.filename = "qrcode.gif"
		f_get_googleqrcode_for_fiscalinvno(al_code)
	elseif ls_qr_method = "I" then
		f_gen_idautomation_qrcode(as_qrcode)
	elseif ls_qr_method = "M" then
		this.id_print.object.p_qrcode.filename = "qrcode.bmp"
		f_gen_morovia_qrcode(as_qrcode, 5, 3)
	elseif ls_qr_method = "Q" then
		this.id_print.object.p_qrcode.filename = "qrcode.bmp"
		f_gen_pb_qrcode(as_qrcode)
	end if
	return 0

// w_salereturn.wf_fetch_latest_itemsalesinfo(long al_row, long al_icode) returns long
	long ll_saleinvcode
	long ll_packunits
	double ld_unitsalestax
	double ld_srprice
	double ld_gstperc
	string ls_alternatecustomicode
	ls_alternatecustomicode = this.id_detail.object.alternatecustomicode[al_row]
	if len(ls_alternatecustomicode) > 0 then
		SQL SELECT SaleInvCode =MAX ( SL.SaleInvCode ) , AlternateCustomICode =MAX ( SD.AlternateCustomICode ) , Packunits =MAX ( SD.PackUnits ) , SRPrice =MAX ( ROUND ( ( SD.SalePrice - SD.ItemFlatDisc ) *( 1 - SD.DiscPerc *0.01 ) *( 1 - SL.DiscPerc *0.01 ) , 2 ) ) , UnitSalesTax =MAX ( SD.UnitSalesTax ) , GSTPerc =MAX ( SD.GSTPerc ) INTO :ll_saleinvcode, :ls_alternatecustomicode, :ll_packunits, :ld_srprice, :ld_unitsalestax, :ld_gstperc FROM SaleDetail SD , SaleLedger SL WHERE SD.SaleInvCode IN ( SELECT SaleInvCode =MAX ( D.SaleInvCode ) FROM SaleDetail D WHERE D.ICode =:al_icode AND D.AlternateCustomIcode =:ls_alternatecustomicode ) AND SD.ICode =:al_icode AND SD.SaleInvCode =SL.SaleInvCode USING this.it_transobject;
	else
		SQL SELECT SaleInvCode =MAX ( SL.SaleInvCode ) , AlternateCustomICode =MAX ( SD.AlternateCustomICode ) , Packunits =MAX ( SD.PackUnits ) , SRPrice =MAX ( ROUND ( ( SD.SalePrice - SD.ItemFlatDisc ) *( 1 - SD.DiscPerc *0.01 ) *( 1 - SL.DiscPerc *0.01 ) , 2 ) ) , UnitSalesTax =MAX ( SD.UnitSalesTax ) , GSTPerc =MAX ( SD.GSTPerc ) INTO :ll_saleinvcode, :ls_alternatecustomicode, :ll_packunits, :ld_srprice, :ld_unitsalestax, :ld_gstperc FROM SaleDetail SD , SaleLedger SL WHERE SD.SaleInvCode IN ( SELECT SaleInvCode =MAX ( D.SaleInvCode ) FROM SaleDetail D WHERE D.ICode =:al_icode ) AND SD.ICode =:al_icode AND SD.SaleInvCode =SL.SaleInvCode USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		if ll_saleinvcode <= 0 or isnull(ll_saleinvcode) then
			if len(ls_alternatecustomicode) > 0 then
				SQL SELECT SaleInvCode =MAX ( SL.SaleInvCode ) , AlternateCustomICode =MAX ( SD.AlternateCustomICode ) , Packunits =MAX ( SD.PackUnits ) , SRPrice =MAX ( ROUND ( ( SD.SalePrice - SD.ItemFlatDisc ) *( 1 - SD.DiscPerc *0.01 ) *( 1 - SL.DiscPerc *0.01 ) , 2 ) ) , UnitSalesTax =MAX ( SD.UnitSalesTax ) , GSTPerc =MAX ( SD.GSTPerc ) INTO :ll_saleinvcode, :ls_alternatecustomicode, :ll_packunits, :ld_srprice, :ld_unitsalestax, :ld_gstperc FROM SaleDetailDump SD , SaleLedgerDump SL WHERE SD.SaleInvCode IN ( SELECT SaleInvCode =MAX ( D.SaleInvCode ) FROM SaleDetailDump D WHERE D.ICode =:al_icode AND D.AlternateCustomIcode =:ls_alternatecustomicode ) AND SD.ICode =:al_icode AND SD.SaleInvCode =SL.SaleInvCode USING this.it_transobject;
			else
				SQL SELECT SaleInvCode =MAX ( SL.SaleInvCode ) , AlternateCustomICode =MAX ( SD.AlternateCustomICode ) , Packunits =MAX ( SD.PackUnits ) , SRPrice =MAX ( ROUND ( ( SD.SalePrice - SD.ItemFlatDisc ) *( 1 - SD.DiscPerc *0.01 ) *( 1 - SL.DiscPerc *0.01 ) , 2 ) ) , UnitSalesTax =MAX ( SD.UnitSalesTax ) , GSTPerc =MAX ( SD.GSTPerc ) INTO :ll_saleinvcode, :ls_alternatecustomicode, :ll_packunits, :ld_srprice, :ld_unitsalestax, :ld_gstperc FROM SaleDetailDump SD , SaleLedgerDump SL WHERE SD.SaleInvCode IN ( SELECT SaleInvCode =MAX ( D.SaleInvCode ) FROM SaleDetail D WHERE D.ICode =:al_icode ) AND SD.ICode =:al_icode AND SD.SaleInvCode =SL.SaleInvCode USING this.it_transobject;
			end if
		end if
		if ld_srprice <= 0.0 or isnull(ld_srprice) then
			ld_srprice = 0
		end if
		if ld_unitsalestax <= 0.0 or isnull(ld_unitsalestax) then
			ld_unitsalestax = 0
		end if
		if ll_packunits <= 0 or isnull(ll_packunits) then
			ll_packunits = 1
		end if
		if ld_gstperc <= 0.0 or isnull(ld_gstperc) then
			ld_gstperc = 0
		end if
		this.id_detail.object.alternatecustomicode[al_row] = ls_alternatecustomicode
		this.id_detail.object.srprice[al_row] = round(ld_srprice, 2)
		this.id_detail.object.unitsalestax[al_row] = round(ld_unitsalestax, 2)
		this.id_detail.object.gstperc[al_row] = round(ld_gstperc, 2)
		return 0
	end if
	if this.it_transobject.sqlcode = 100 then
		return -1
	end if
	return -1

// w_salereturn.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_salereturnmenu" then
		this.menuid = create m_salereturnmenu
	end if
	this.dw_print = create dw_print
	this.ic_cashdrawerprinter = create ic_cashdrawerprinter
	this.ic_comport = create ic_comport
	this.ic_cashdrawer = create ic_cashdrawer
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print
	this.control[icurrent + 2] = this.ic_cashdrawerprinter
	this.control[icurrent + 3] = this.ic_comport
	this.control[icurrent + 4] = this.ic_cashdrawer

// w_salereturn.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_print
	destroy this.ic_cashdrawerprinter
	destroy this.ic_comport
	destroy this.ic_cashdrawer

// w_salereturn.ue_save() returns 0 [event]
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_totalpieces
	long ll_piecesinhand
	long ll_salesmancode
	long ll_rowcount
	long ll_icode
	long ll_gcode
	long ll_headerno
	long ll_headerinvno
	long ll_saleinvcode
	long ll_counter
	long ll_patientcode
	long ll_rightfound
	long ll_activestatus
	long ll_setasactive_count
	long[] ll_activeitemslist
	long ll_saveresult
	long ll_right_to_check
	long ll_itemsvalidated
	double ld_qty
	double ld_bonusqty
	double ld_stock
	double ld_newstock
	double ld_totalstock
	double ld_holdavgprice
	double ld_avgprice
	double ld_newavgprice
	double ld_netprice
	double ld_advancetaxamt
	double ld_fbrposfee
	boolean lb_commitflag
	boolean lb_continue
	integer li_errcode
	integer li_pos
	datetime ld_expiry
	string ls_errtext
	string ls_batch
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_invgstperc
	double ld_invtotal
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	datetime ldt_server_datetime
	string ls_posted
	string ls_date_errtext
	datawindowchild ldc_headerno
	string ls_env_name
	string ls_env_val
	long ll_env_len
	s_datastore lstr_arg
	datastore lds_items
	if wf_check_save_right() = 0 then
		return
	end if
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	if this.ib_opensalereturn then
		if this.ii_salerettype = 8 then
			ll_right_to_check = 15
		else
			ll_right_to_check = 16
		end if
	elseif this.ii_salerettype = 8 then
		ll_right_to_check = 13
	else
		ll_right_to_check = 14
	end if
	if this.id_detail.rowcount() <= 0 then
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if f_stringpreferences("ForcePricePolicyOnSavingSale") = "Y" and this.ib_opensalereturn and wf_apply_pricepolicy(1) <= 0 then
		messagebox("Price Policy Implementation", "Problem in Applying Item Price Policy on Saving")
		return
	end if
	if wf_set_cashaccount() = 0 then
		return
	end if
	wf_setguestcheckin()
	wf_setamountoninvoice()
	if wf_check_unique_refno() = 0 then
		return
	end if
	if wf_recheck_returned_items() > 0 then
		return
	end if
	wf_grandtotal()
	this.id_footer.accepttext()
	this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	if f_stringpreferences("AskUserPwdInSaleReturn") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		if ll_salesmancode > 0 and ll_right_to_check > 0 then
			if wf_check_module_rights(ll_salesmancode, ll_right_to_check) < 0 then
				setfocus()
				return
			end if
		else
			return
		end if
	else
		ll_salesmancode = gl_usercode
	end if
	setfocus()
	if ll_salesmancode > 0 then
		if wf_check_cashiershift_on_saving(this.id_master.object.cashiershiftcode[1], ll_salesmancode) < 0 then
			return
		end if
		SQL rollback USING sqlca;
		ul_rowcount = this.id_detail.rowcount()
		sqlca.getmaxutn(ul_rowcount, ul_maxutn)
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
			messagebox("Saving", "Error in generating Utn")
			return
		end if
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_rowcount = this.id_detail.rowcount()
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "custcode")
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if wf_show_mastercashierwindow() = 0 then
			return
		end if
		if isnull(ll_invid) then
			f_newtableid("srledger", ll_invid)
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
				this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
			end if
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
		else
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
		end if
		if not this.ib_modifydate then
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
		else
			ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
		end if
		this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
		this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
		this.id_master.getchild("headerno", ldc_headerno)
		ll_headerno = this.id_master.getitemnumber(ll_mastercurrrow, "headerno")
		ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
		if isnull(ll_headerinvno) then
			f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
			if ll_headerinvno > 0 then
				this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
			end if
		end if
		wf_grandtotal()
		this.id_footer.accepttext()
		this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
		ld_invtotal = this.id_footer.getitemnumber(1, "total")
		if f_stringpreferences("DisplayPool") = "Y" then
			this.ib_lcdshow = false
			if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				this.is_lcditem = "SALES RETURN AMOUNT"
				this.is_lcditem2 = space(5) + string(ld_invtotal, "########0.00")
			elseif upper(f_stringpreferences("DisplayPoolCompany")) <> "BAYLAN VFD-860-A" then
				this.is_lcditem = "RETURN= " + string(ld_invtotal, "########0.00")
				this.is_lcditem = this.is_lcditem + space(39 - len(this.is_lcditem))
				this.is_lcditem = left(this.is_lcditem, 39)
			end if
			this.ic_comport.triggerevent("ue_show")
		end if
		ld_misccharges = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges")
		ld_invdiscperc = this.id_footer.getitemnumber(ll_footercurrrow, "discperc")
		ld_flatdisc = this.id_footer.getitemnumber(ll_footercurrrow, "flatdisc")
		ld_fbrposfee = this.id_footer.getitemnumber(ll_footercurrrow, "fbrposfee")
		ll_saleinvcode = this.id_master.getitemnumber(1, "saleinvcode")
		ld_invgstperc = this.id_footer.getitemnumber(ll_footercurrrow, "invgstperc1")
		ld_advancetaxamt = this.id_footer.getitemnumber(ll_footercurrrow, "advancetaxamt")
		this.id_master.setitem(ll_mastercurrrow, "invgstperc1", ld_invgstperc)
		ls_env_name = "COMPUTERNAME"
		ls_env_val = space(20)
		ll_env_len = 20
		ll_env_len = getenvironmentvariablea(ls_env_name, ls_env_val, ll_env_len)
		ls_posted = this.id_master.object.posted[ll_mastercurrrow]
		this.id_master.setitem(ll_mastercurrrow, "machinename", ls_env_val)
		this.id_master.setitem(ll_mastercurrrow, "discperc", ld_invdiscperc)
		this.id_master.setitem(ll_mastercurrrow, "flatdisc", ld_flatdisc)
		this.id_master.setitem(ll_mastercurrrow, "misccharges", ld_misccharges)
		this.id_master.setitem(ll_mastercurrrow, "advancetaxamt", ld_advancetaxamt)
		this.id_master.setitem(ll_mastercurrrow, "fbrposfee", ld_fbrposfee)
		if this.ii_salerettype = 8 then
			if f_stringpreferences("askmastercashwin_in_cashsr") = "N" then
				if this.id_master.object.invtotal[ll_mastercurrrow] <= this.id_master.object.cashtendered[ll_mastercurrrow] then
					this.id_master.object.cashcharged[ll_mastercurrrow] = this.id_master.object.invtotal[ll_mastercurrrow]
				else
					this.id_master.object.cashcharged[ll_mastercurrrow] = this.id_master.object.cashtendered[ll_mastercurrrow]
				end if
				this.id_master.object.cashback[ll_mastercurrrow] = this.id_master.object.cashtendered[ll_mastercurrrow] - this.id_master.object.cashcharged[ll_mastercurrrow]
			elseif not (this.id_master.object.cashcharged[ll_mastercurrrow] = this.id_master.object.invtotal[ll_mastercurrrow] and this.ids_cashwin.rowcount() = 0) then
				this.id_master.setitem(1, "srcatcode", 7)
				this.id_master.accepttext()
			end if
		end if
		if this.ii_salerettype <> 8 and this.id_master.getitemstring(1, "accountfor") = "Y" and f_stringpreferences("AskAmtOnCreditSaleReturn") = "Y" and f_stringpreferences("askmastercashwin_in_crsr") = "N" then
			ll_rightfound = 0
			ll_rightfound = gds_securitywindow.find("rightcode = 583", 1, gds_securitywindow.rowcount())
			if ll_rightfound > 0 then
				this.id_master.setitem(ll_mastercurrrow, "amtby", ll_salesmancode)
				this.id_master.setitem(ll_mastercurrrow, "amtdate", ldt_server_datetime)
			end if
		end if
		do while ll_rowcount > 0 and ll_counter <= ll_rowcount and li_errcode = 0
			this.id_detail.setitem(ll_counter, "SrUtn", ul_maxutn)
			ul_maxutn = ul_maxutn + 1
			this.id_detail.setitem(ll_counter, "code", ll_invid)
			ll_gcode = this.id_detail.object.gcode[ll_counter]
			ll_icode = this.id_detail.object.icode[ll_counter]
			ls_batch = this.id_detail.object.batch[ll_counter]
			ld_expiry = this.id_detail.object.expiry[ll_counter]
			ld_avgprice = this.id_detail.object.avgprice[ll_counter]
			ld_netprice = round(this.id_detail.object.srprice[ll_counter] * (1 - this.id_detail.object.discperc[ll_counter] * 0.01) * (1 - this.id_master.object.discperc[1] * 0.01), 2)
			ll_totalpieces = this.id_detail.getitemnumber(ll_counter, "totalpieces")
			ll_piecesinhand = this.id_detail.getitemnumber(ll_counter, "piecesinhand")
			if this.id_detail.object.claimablediscperc[ll_counter] > 0 then
				this.id_detail.object.claimable[ll_counter] = "Y"
			end if
			ld_qty = this.id_detail.getitemnumber(ll_counter, "looseqty")
			ld_bonusqty = this.id_detail.getitemnumber(ll_counter, "bonusqty")
			if lower(ls_batch) <> "due" then
				ld_holdavgprice = ld_avgprice
				this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
				if this.it_transobject.sqlcode <> 0 then
					li_errcode = -1
				end if
				if ll_saleinvcode > 0 then
					this.id_detail.object.avgprice[ll_counter] = ld_holdavgprice
					ld_netprice = ld_holdavgprice
				else
					this.id_detail.object.avgprice[ll_counter] = ld_avgprice
				end if
				this.it_transobject.getitemstockall(ll_icode, ld_totalstock)
				if this.it_transobject.sqlcode <> 0 then
					li_errcode = -1
				end if
				if isnull(ld_totalstock) then
					ld_totalstock = 0
				end if
				this.id_detail.object.currstock[ll_counter] = ld_totalstock
				if ld_totalstock + ld_qty + ld_bonusqty > 0.0 then
					ld_newavgprice = round((ld_avgprice * ld_totalstock + ld_netprice * (ld_qty + ld_bonusqty)) / (ld_totalstock + ld_qty + ld_bonusqty), 5)
				else
					ld_newavgprice = round(ld_avgprice * ld_totalstock + ld_netprice * (ld_qty + ld_bonusqty), 5)
				end if
				this.id_detail.object.newavgprice[ll_counter] = ld_newavgprice
				if f_stringpreferences("UpdateAvgPriceInSR") = "Y" then
					this.it_transobject.updateitemavgprice(ll_icode, ld_newavgprice)
					if this.it_transobject.sqlcode <> 0 then
						li_errcode = -1
					end if
				end if
				li_errcode = wf_checkitemactiveness(ll_icode, ls_errtext, ll_setasactive_count, ll_activeitemslist)
				if li_errcode = 0 then
					this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
					if this.it_transobject.sqlcode = 0 then
						ld_newstock = ld_stock + ld_qty + ld_bonusqty
						this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
						if this.it_transobject.sqlcode <> 0 then
							li_errcode = -1
							ls_errtext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
						else
							ll_itemsvalidated = ll_itemsvalidated + 1
						end if
					else
						li_errcode = -1
						ls_errtext = "Batch Wise Stock Fetch Error:~r~n" + this.it_transobject.sqlerrtext
					end if
				end if
			end if
			this.it_transobject.getitemtotalpiecesinhand(ll_icode, ll_piecesinhand)
			if this.it_transobject.sqlcode <> 0 then
				li_errcode = -1
			else
				this.id_detail.setitem(ll_counter, "piecesinhand", ll_piecesinhand)
				this.it_transobject.updateitemtotalpiecesinhand(ll_icode, 1, ll_totalpieces)
				if this.it_transobject.sqlcode <> 0 then
					li_errcode = -1
				end if
			end if
			ll_counter = ll_counter + 1
		loop
		if li_errcode = -1 or ll_itemsvalidated <> ll_rowcount then
			lb_continue = false
		end if
		if not this.ib_opensalereturn then
			SQL update Saleledger SET returncounter =returncounter + 1 WHERE saleinvcode =:ll_saleinvcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				lb_continue = true
			else
				lb_continue = false
			end if
		end if
		if lb_continue then
			if this.ii_salerettype = 8 and f_stringpreferences("CashDrawer") = "Y" then
				this.ic_cashdrawer.object.portopen = true
				this.ic_cashdrawer.object.output = "A"
				this.ic_cashdrawer.object.portopen = false
			end if
			ll_saveresult = event ue_save_withnocommit()
			if ll_saveresult = 0 then
				if wf_update_mastercashierwindow(ll_invid, this.is_doctype) = 0 then
					SQL commit USING this.it_transobject;
					messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
					this.ib_commitok = true
					this.id_master.resetupdate()
					this.im_menu.m_file.m_new.enabled = true
					this.editflag = false
					if gd_recenttransdate < this.id_systemdate then
						gd_recenttransdate = this.id_systemdate
					end if
				else
					messagebox("Saving Problem", "Changes Not Saved in database for Master Cashier Window transactions.", stopsign!, ok!, 1)
				end if
			else
				messagebox("Saving Problem", "Changes Not Saved in database while saving sales return record.", stopsign!, ok!, 1)
			end if
			if this.ib_commitok and lb_continue then
				if f_stringpreferences("AutoFiscalizeOnPosting") = "Y" and ls_posted = "Y" then
					f_fiscalizesrinvoice(ll_invid)
				end if
				if f_stringpreferences("IncSRInActMonitor") = "Y" then
					this.it_transobject.updateactivitymonitor("SR", ll_invid)
					if this.it_transobject.sqlcode <> 0 then
						SQL rollback USING this.it_transobject;
						messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
					else
						SQL commit USING this.it_transobject;
					end if
				end if
				if f_stringpreferences("ShowSRInCashierActivity") = "Y" then
					this.it_transobject.updatecashieractivity(this.ii_module, ll_invid)
					if this.it_transobject.sqlcode <> 0 then
						SQL rollback USING this.it_transobject;
						messagebox("Activity Monitor", "Problem in updating cashier activity.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
					else
						SQL commit USING this.it_transobject;
					end if
				end if
				if f_stringpreferences("ApplyLoyaltypolicyonsaleposting") = "Y" and ls_posted = "Y" then
					this.it_transobject.manageloyaltypoints("SR", ll_invid)
					if this.it_transobject.sqlcode <> 0 then
						ls_errtext = "Problem in updating loyalty points for this account.~r~nReasons are:- " + this.it_transobject.sqlerrtext
						SQL rollback USING this.it_transobject;
						messagebox("Loyalty Points Updation", ls_errtext)
					else
						SQL commit USING this.it_transobject;
					end if
				end if
				this.ib_modify = false
			end if
			wf_allocatesalereturn(ll_invid, ll_saleinvcode, ldt_server_datetime, ll_salesmancode)
			if ll_setasactive_count > 0 then
				lds_items = create datastore
				lds_items.dataobject = "d_activemarkeditems"
				lds_items.settransobject(this.it_transobject)
				lds_items.reset()
				lds_items.retrieve(ll_activeitemslist)
				lstr_arg.ds = lds_items
				openwithparm(w_salereturn_activeitemlist, lstr_arg)
			end if
		else
			SQL rollback USING this.it_transobject;
			messagebox("Updation Error", "Some Problem occur in saving SaleReturn Invoice.~r~nKindly try again.~r~n" + ls_errtext, stopsign!)
		end if
	else
		setfocus()
	end if
	this.ib_lcdshow = false
	setpointer(arrow!)

// w_salereturn.ue_newform() returns 0 [event]
	integer rtncode
	integer li_ismodifysaleprice
	integer li_ismodifyitemdiscperc
	integer li_ismodifysalestax
	long li_fetched_code
	long row
	long ll_manfcode
	long ll_counter
	long ll_custcode
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_custcode
	integer li_viewstock
	m_salereturnmenu lm_menu
	call super::ue_newform
	this.ib_lcdshow = false
	lm_menu = this.menuid
	setredraw(false)
	lm_menu.m_file.m_saveandpost.enabled = this.ib_saveandpost
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_print.enabled = true
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	wf_setgodownoption()
	this.ib_modify = false
	if not this.ib_opensalereturn then
		this.idc_itemdddw.reset()
		this.idc_itemdddw.insertrow(0)
		this.ids_saleinv.reset()
		this.id_detail.object.expiry.protect = true
		this.id_detail.object.batch.protect = true
	elseif f_stringpreferences("AllowCustomerInCashSale") = "N" and this.ii_salerettype = 8 then
		ls_custcode = f_stringpreferences("defaultcustomerincashsale")
		if ls_custcode = "-1" then
			ll_custcode = 19
			this.il_code = 19
		else
			ll_custcode = long(ls_custcode)
			this.il_code = ll_custcode
		end if
		this.id_master.object.custcode.protect = 1
		this.id_master.object.aliasname.protect = 1
		this.id_master.object.custcode[1] = ll_custcode
		this.id_master.accepttext()
	end if
	if this.ii_salerettype = 8 then
		this.id_master.object.custcode[1] = this.il_code
	end if
	wf_assign_master_cash_win_object()
	li_ismodifysaleprice = 1
	li_ismodifyitemdiscperc = 1
	li_ismodifysalestax = 1
	li_viewstock = 0
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 519 then
			li_ismodifysaleprice = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 518 then
			li_ismodifyitemdiscperc = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 521 then
			li_ismodifysalestax = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 535 then
			li_viewstock = 1
		end if
	next
	this.id_footer.object.t_stock.visible = li_viewstock
	this.id_footer.object.stock.visible = li_viewstock
	this.id_detail.object.srprice.protect = li_ismodifysaleprice
	this.id_detail.object.discperc.protect = li_ismodifyitemdiscperc
	this.id_detail.object.unitsalestax.protect = li_ismodifysalestax
	this.id_detail.object.gstperc.protect = li_ismodifysalestax
	this.id_master.object.currencycode[1] = f_numberpreferences("defaultcurrencyinsale")
	wf_apply_currency(this.id_master.object.currencycode[1])
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	wf_visible(true)
	setredraw(true)
	if not wf_validatedate() then
		close(this)
	end if
	if this.ib_modifydate then
		if this.ib_fetchserverdate then
			wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
			this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
		else
			this.id_master.setitem(this.id_master.getrow(), "date", today())
		end if
	else
		wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
		this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
	end if
	if f_stringpreferences("DisplayPool") = "Y" then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
			setnull(this.is_lcditem)
			this.ic_comport.triggerevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
			setnull(this.is_lcditem)
			this.ic_comport.triggerevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
			this.is_lcditem = space((20 - len(trim(left(f_reportheaderinfosale("clientname", this.id_master.object.headerno[1]), 20)))) / 2.0) + upper(trim(left(f_reportheaderinfosale("clientname", this.id_master.object.headerno[1]), 20)))
			this.is_lcditem2 = "*** SALES RETURN ***"
			this.ic_comport.triggerevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) <> "BAYLAN VFD-860-A" then
			this.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
			this.ic_comport.triggerevent("ue_show")
		end if
	end if
	this.ib_lcdshow = true
	wf_link_to_cashiershift()

// w_salereturn.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect
	long ll_row
	long ll_code
	long ll_custcode
	long ll_allowed
	boolean lb_flag
	m_salereturnmenu lm_menu
	call super::ue_detail
	lm_menu = this.menuid
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	ll_code = this.id_master.getitemnumber(1, "code")
	if wf_isinvoiceinuse(ll_code) = true then
		messagebox("Invoice Validation", "Sale Return Invoice already in use by some other user.~r~nKindly try again after sometime or open some other invoice.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if not isnull(this.id_master.getitemnumber(1, "admissioncode")) then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "Can not Modify In-Patient Sale Return Here,~r~nPlease use In-Patient Sale Return Module.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if wf_allowreturnmodification(ll_code, this.il_groupcode, this.il_strategy) <> 0 then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "You Can not modify this Invoice,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if f_stringpreferences("GroupCustomerCategory") = "Y" and this.ii_salerettype = 1 and this.ib_opensalereturn then
		SQL Select custcode INTO :ll_custcode From SRLedger Where srinvcode =:ll_code USING sqlca;
		ll_allowed = 0
		this.it_transobject.isallowedcustomergroupcategory(this.il_groupcode, ll_custcode, ll_allowed)
		if this.it_transobject.sqlcode = 0 then
			if ll_allowed < 1 then
				this.id_detail.reset()
				messagebox("Group Customer Category Validation", "Current user group does not have enough permissions w.r.t customers~r~n" + "to open the selected invoice.~r~nPossible reasons are selected invoice customer has customer cateogry ~r~n which is not allowed to this user group.")
				this.tab_retrieve.selecttab(2)
				return
			end if
		end if
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_salegodown
	end if
	wf_setgodownoption()
	this.id_footer.retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	if not this.ib_opensalereturn then
		this.idc_itemdddw.settransobject(this.it_transobject)
		li_rtncode = this.idc_itemdddw.retrieve(this.id_master.getitemnumber(1, "saleinvcode"))
	end if
	if this.id_master.object.code[this.id_master.rowcount()] > 0 then
		this.ids_cashwin.retrieve(this.id_master.object.code[1], this.is_doctype)
	else
		wf_assign_master_cash_win_object()
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if not this.ib_opensalereturn then
		this.id_detail.object.expiry.protect = true
		this.id_detail.object.batch.protect = true
	end if
	if li_protect = 0 then
		lm_menu.m_file.m_saveandpost.enabled = this.ib_saveandpost
		lb_flag = true
	end if
	wf_visible(lb_flag)
	wf_grandtotal()
	setredraw(true)

// w_salereturn.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.settransobject(this.it_transobject)
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	if f_stringpreferences("AutoSelectLastGodownInSale") = "Y" and this.id_detail.rowcount() > 0 then
		this.id_detail.object.gcode.initial = string(this.id_detail.object.gcode[this.id_detail.rowcount()])
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_salereturn.close() returns long [event]
	long ancestorreturnvalue
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	ancestorreturnvalue = super::close()
	destroy this.ids_saleinv
	if f_stringpreferences("DisplayPool") = "Y" then
		try
			if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
				this.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
				postevent("ue_show")
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
				this.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
				this.ic_comport.triggerevent("ue_show")
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				this.is_lcditem = "     THANK YOU"
				this.is_lcditem2 = "   FOR YOUR VISIT"
				this.ic_comport.triggerevent("ue_show")
				pd_closeusbpd()
			elseif upper(f_stringpreferences("DisplayPoolCompany")) <> "BAYLAN VFD-860-A" then
				this.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
				this.ic_comport.triggerevent("ue_show")
			end if
		catch (throwable exdw)
			messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
		catch (throwable exnullobj)
			messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
		catch (throwable ex)
			messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
		end try
	end if
	return 1

// w_salereturn.ue_print() returns 0 [event]
	long ll_custcode
	long ll_row
	long ll_invcode
	long ll_reprintingcounter
	integer li_option
	string ls_custname
	string ls_invoicesize
	string ls_fiscalinvoiceno
	string ls_qrcode
	boolean lb_listtab
	s_datastore lstr
	runtimeerror ex
	string ls_printer
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		this.ib_checksaveright = false
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		this.ib_checksaveright = true
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	SQL SELECT PageSize INTO :ls_invoicesize FROM SRLedger WHERE SRInvCode =:ll_invcode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		ls_invoicesize = "Q"
	end if
	wf_selectprintreport(ls_invoicesize)
	if gs_company = "YSWHOLESALE" then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
	end if
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(ll_invcode)
	if this.id_print.rowcount() > 0 then
		try
			ls_fiscalinvoiceno = this.id_print.object.fiscalinvoiceno[1]
			if len(ls_fiscalinvoiceno) > 0 then
				ls_qrcode = ls_fiscalinvoiceno
				wf_gen_qrcode(ll_invcode, ls_qrcode)
			end if
		catch (throwable ex)
		end try
	end if
	if isnull(ls_fiscalinvoiceno) then
		ls_fiscalinvoiceno = ""
	end if
	if lb_listtab then
		lstr.s_module = "S/R"
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		SQL SELECT ISNULL ( reprintingcounter , 0 ) INTO :ll_reprintingcounter FROM srledger WHERE srledger.srinvcode =:ll_invcode USING this.it_transobject;
		ll_reprintingcounter = ll_reprintingcounter + 1
		SQL update SrLedger SET ReprintingCounter =:ll_reprintingcounter WHERE srinvcode =:ll_invcode USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Database Error", "Some database problem has occur ~r~n during updation of printing counter")
			SQL rollback USING this.it_transobject;
			return
		else
			SQL commit USING this.it_transobject;
		end if
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		elseif f_stringpreferences("CashDrawerWithPrinter") = "Y" then
			ls_printer = f_stringpreferences("CashDrawerPrinter")
			if ls_printer = "" or isnull(ls_printer) then
				messagebox("Cash Drawer Printer", "Cash Drawer Printer name not found.~r~nSuggested Option is check Cash Drawer Printer name in Preferences.")
			else
				this.ic_cashdrawerprinter.object.__invoke_method("opendrawer", 4, {ls_printer, 10, "Control", 65}, true)
			end if
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_salereturn.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	setpointer(hourglass!)
	if this.ib_opensalereturn and this.ii_salerettype = 1 then
		this.idc_customerslist.setredraw(false)
		this.idc_customerslist.settransobject(this.it_transobject)
		this.idc_customerslist.reset()
		this.idc_customerslist.retrieve()
		this.idc_customerslist.setredraw(true)
	end if
	this.idc_patient.setredraw(false)
	wf_patient_retrieve()
	this.idc_patient.setredraw(true)
	this.idc_guest.setredraw(false)
	this.idc_guest.settransobject(this.it_transobject)
	wf_guest_retrieve()
	this.idc_guest.setredraw(false)
	this.idc_student.setredraw(false)
	this.idc_student.settransobject(this.it_transobject)
	wf_student_retrieve()
	this.idc_student.setredraw(false)
	setpointer(arrow!)

// w_salereturn.ue_list() returns 0 [event]
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_post.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_itemvalidated = true

// w_salereturn.ue_postopen() returns 0 [event]
	datawindowchild ldc_dddsalecategory
	datawindowchild ldc_headerno
	s_salerettype ls_salerettype
	long li_rtncode
	long ll_counter
	long ll_found
	string ls_custfilterstring
	m_salereturnmenu lm_menu
	datastore lds_headers
	call super::ue_postopen
	lm_menu = this.menuid
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	f_fetch_sites()
	this.ids_saleinv = create datastore
	this.ids_saleinv.dataobject = "ddd_saleinvitems"
	this.ids_saleinv.settransobject(sqlca)
	this.id_print = this.dw_print
	this.ic_advancetaxonsale = f_stringpreferences("ApplyAdvanceIncomeTaxInSale")
	if this.ic_advancetaxonsale = "" or isnull(this.ic_advancetaxonsale) then
		this.ic_advancetaxonsale = "N"
	end if
	this.ic_fbrposfee = f_stringpreferences("Auto_Apply_FBR_POS_Fee_InSale")
	if this.ic_fbrposfee = "" or isnull(this.ic_fbrposfee) then
		this.ic_fbrposfee = "N"
	end if
	this.ic_autofiscalize = f_stringpreferences("AutoFiscalizeOnPosting")
	if this.ic_autofiscalize = "" or isnull(this.ic_autofiscalize) then
		this.ic_autofiscalize = "N"
	end if
	setredraw(false)
	ls_salerettype = message.powerobjectparm
	wf_setsalereturntype(ls_salerettype.salerettype, ls_salerettype.opensale)
	wf_assign_master_cash_win_object()
	this.il_groupcode = f_getgroupcode(gl_usercode)
	if not this.ib_opensalereturn then
		choose case this.ii_salerettype
		case 1
			this.title = "Credit Sale Return"
			wf_assigndatawindowobjects("d_WholeSaleReturn", "d_WholeSaleReturnDetail", "d_SaleReturnFooter", "d_WholeSaleReturnList", "d_WholeSaleReturnInvReport")
			if f_stringpreferences("salecustrefno2") = "N" then
				this.id_master.object.custrefno2.visible = false
				this.id_master.object.t_custrefno2.visible = false
			end if
			if f_stringpreferences("salecustrefno3") = "N" then
				this.id_master.object.custrefno3.visible = false
				this.id_master.object.t_custrefno3.visible = false
			end if
			if f_stringpreferences("salecustrefno4") = "N" then
				this.id_master.object.custrefno4.visible = false
				this.id_master.object.t_custrefno4.visible = false
			end if
			if f_stringpreferences("patientOnCreditSale") <> "H" then
				this.id_master.object.patientcode.visible = false
				this.id_master.object.t_regno.visible = false
				this.id_master.object.t_patient.visible = false
				this.id_master.object.patientregno.visible = false
			end if
			if f_stringpreferences("StudentOnCreditSale") <> "H" then
				this.id_master.object.studentcode.visible = false
				this.id_master.object.studentregno.visible = false
				this.id_master.object.studentregno_t.visible = false
				this.id_master.object.studentcode_t.visible = false
			end if
			if f_stringpreferences("GuestOnCreditSale") <> "H" then
				this.id_master.object.guestcode.visible = false
				this.id_master.object.guestregno.visible = false
				this.id_master.object.guestcode_t.visible = false
				this.id_master.object.guestregno_t.visible = false
			end if
			if f_stringpreferences("ShowAccountForinSaleReturn") = "Y" then
				this.id_master.object.accountfor.visible = true
				this.id_master.object.t_accountfor.visible = true
			else
				this.id_master.object.accountfor.visible = false
				this.id_master.object.t_accountfor.visible = false
			end if
			if f_stringpreferences("SaleReturnAccountFor") = "Y" then
				this.id_master.object.accountfor.initial = "Y"
			else
				this.id_master.object.accountfor.initial = "N"
			end if
		case 8
			wf_assigndatawindowobjects("d_RetailSaleReturn", "d_RetailSaleReturnDetail", "d_SaleReturnFooter", "d_RetailSaleReturnList", "d_RetailSaleReturnInvReport")
			this.it_transobject.getglobalcode("GT_RetailSaleCustomerACC", this.il_code)
			if f_stringpreferences("patientOnRetailSale") = "H" then
				this.id_master.object.patientcode.visible = true
				this.id_master.object.t_patient.visible = true
				this.id_master.object.patientregno.visible = true
				this.id_master.object.t_regno.visible = true
			else
				this.id_master.object.patientcode.visible = false
				this.id_master.object.t_patient.visible = false
				this.id_master.object.patientregno.visible = false
				this.id_master.object.t_regno.visible = false
			end if
			if f_stringpreferences("StudentOnCashSale") <> "H" then
				this.id_master.object.studentcode.visible = false
				this.id_master.object.studentregno.visible = false
				this.id_master.object.studentregno_t.visible = false
				this.id_master.object.studentcode_t.visible = false
