	end if
	if this.ib_opensalereturn <> true then
		li_rtncode = this.id_detail.getchild("icode", this.idc_itemdddw)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_itemdddw.settransobject(this.it_transobject)
		this.idc_itemdddw.insertrow(0)
		this.id_itemslist.dataobject = "ddd_saleinvitems"
	else
		gd_itemsinfo.sharedata(this.id_itemslist)
		if this.ii_salerettype = 1 then
			li_rtncode = this.id_master.getchild("custcode", this.idc_customerslist)
			if li_rtncode = -1 then
				messagebox("Error", "Can not get a DataWindowChild for customer.")
			end if
			this.idc_customerslist.settransobject(this.it_transobject)
			if f_stringpreferences("GroupCustomerCategory") = "Y" then
				ls_custfilterstring = "0                                                                                                                                                                                                             "
				this.it_transobject.getallowedgroupcustomercategory(f_getgroupcode(gl_usercode), ls_custfilterstring)
				if ls_custfilterstring = " " or ls_custfilterstring = "" or isnull(ls_custfilterstring) then
					ls_custfilterstring = "0"
					messagebox("Group Customer Category Validation", "Current user group does not have enough permissions w.r.t customer to make sale.~r~nIn order to make open credit sale return kindly assign customer categories to this user group ~r~n using Group Customer Category module.~r~nOR~r~nDisable Group Customer Category from Preferences.")
					close(this)
					return
				end if
				this.idc_customerslist.setfilter("custcatcode In (" + ls_custfilterstring + ") ")
				this.idc_customerslist.filter()
			end if
		end if
	end if
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit to Make Sales Return")
		close(this)
		return
	end if
	li_rtncode = this.id_detail.getchild("gcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights for making Sale Return")
		close(this)
		return
	end if
	this.ii_salegodown = this.idc_godown.getitemnumber(1, "gcode")
