	u_transaction lt_transobject
	double ld_godownstock
	double ld_allgodownstock
	double ld_qty
	double ld_bonusqty
	long ll_totrows
	f_fetch_sites()
	if wf_iseditable() = false then
		return
	end if
	if this.ib_opensalereturn = false then
		return
	end if
	open(w_pull_purreturn_from_dropbox)
	lstr_arguments = message.powerobjectparm
	if lstr_arguments.i_status <= 0 then
		return
	end if
	ll_prinvcode = lstr_arguments.l_code1
	ll_sitecode = lstr_arguments.l_code2
	lt_transobject = create u_transaction
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Problem", "Unable to connect to database.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		return
	end if
	SQL EXECUTE IMMEDIATE :ls_connsetting USING lt_transobject;
	if lstr_arguments.i_supress = true and f_datatransfer_in_dest(lt_transobject) <= 0 then
		SQL stop USING lt_transobject;
		return
	end if
	if ll_prinvcode > 0 then
		setpointer(hourglass!)
		lds_prledger = create datastore
		lds_prdetail = create datastore
		ls_prefix = ""
		if gs_dropbox_server = "" or isnull(gs_dropbox_server) then
			ls_prefix = ""
		else
			ls_prefix = gs_dropbox_server + "."
		end if
		if gs_dropbox_db = "" or isnull(gs_dropbox_db) then
			ls_prefix = ls_prefix
		else
			ls_prefix = ls_prefix + gs_dropbox_db + "."
		end if
		ls_prledgerquery = "Select ~tSiteCode, TargetSiteCode, PRInvCode, Date, Remarks, DiscPerc, FlatDisc, MiscCharges, InvGSTPerc1, InvTotal, CustCode, DataCarryCustCode " + "From ~t" + ls_prefix + "DBO" + "." + "DB_PRLedger " + "Where   PRInvcode = " + string(ll_prinvcode) + " AND Sitecode = " + string(ll_sitecode) + " AND TargetSiteCode = " + string(gl_sitecode) + " AND Pulled='N'"
		ls_prdetailquery = "Select  SiteCode, PRInvCode, ICode, Batch, Expiry, LooseQty, BonusQty, PackUnits, PRPrice, DiscPerc, PackSalePrice, UnitSalesTax, GSTPerc, PrUtn " + "From ~t" + ls_prefix + "DBO" + "." + "DB_PRDetail " + "Where ~tPRInvCode = " + string(ll_prinvcode) + " AND Sitecode = " + string(ll_sitecode) + " Order By PrUtn "
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_prledgerquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For Purchase Return Ledger DataStore.")
			return
		else
			ls_error_syntax = ""
			lds_prledger.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For Purchase Return Ledger DataStore..")
				return
			end if
		end if
		lds_prledger.settransobject(lt_transobject)
		if lds_prledger.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source Purchase Return Ledger.")
			return
		end if
		ll_datacarrycustcode = lds_prledger.getitemnumber(lds_prledger.getrow(), "DataCarryCustCode")
		ll_prinvcode = lds_prledger.getitemnumber(lds_prledger.getrow(), "PRInvCode")
		if ll_datacarrycustcode > 0 and ll_prinvcode > 0 then
			SQL SELECT ISNULL ( Max ( SRInvCode ) , 0 ) INTO :ll_lastsrinvcode FROM SRLedger WHERE CustRefNo IN ( SELECT AliasName + '-' + LTRIM ( RTRIM ( STR ( :ll_prinvcode , 10 ) ) ) AS RefNo FROM Accounts WHERE AccCode =:ll_datacarrycustcode ) USING lt_transobject;
			if lt_transobject.sqlcode = 0 then
				if isnull(ll_lastsrinvcode) or ll_lastsrinvcode < 0 then
					ll_lastsrinvcode = 0
				end if
				if ll_lastsrinvcode > 0 then
					SQL stop USING lt_transobject;
					messagebox("Population Restriction", "Purchase Return Already Populated as Sales Return Invoice No. : " + trim(string(ll_lastsrinvcode)), stopsign!)
					return
				end if
			else
				SQL stop USING lt_transobject;
				messagebox("Fetch Error", "Unable to fetch any data from source Purchase Return Ledger DataCarryDB.")
				return
			end if
			return
		end if
		ls_newsyntax = ""
		ls_error_syntax = ""
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_prdetailquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For Purchase Return Detail DataStore")
			return
		else
			ls_error_syntax = ""
			lds_prdetail.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For Purchase Return Detail DataStore")
				return
			end if
		end if
		lds_prdetail.settransobject(lt_transobject)
		if lds_prdetail.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source Purchase Return Detail.")
			return
		end if
		ld_invdiscperc = lds_prledger.getitemnumber(lds_prledger.getrow(), "discperc")
		ld_invflatdisc = lds_prledger.getitemnumber(lds_prledger.getrow(), "flatdisc")
		ld_invmisccharges = lds_prledger.getitemnumber(lds_prledger.getrow(), "misccharges")
		ld_invgstperc1 = lds_prledger.getitemnumber(lds_prledger.getrow(), "invgstperc1")
		if ll_datacarrycustcode > 0 then
			this.id_master.setitem(1, "custcode", ll_datacarrycustcode)
			wf_customerinfo(ll_datacarrycustcode)
			ls_aliasname = this.id_master.object.aliasname[1]
			if isnull(ls_aliasname) then
				ls_aliasname = ""
			end if
			this.id_master.setitem(1, "custrefno", ls_aliasname + "-" + trim(string(ll_prinvcode)))
		end if
		this.id_footer.setitem(1, "discperc", ld_invdiscperc)
		this.id_footer.setitem(1, "flatdisc", ld_invflatdisc)
		this.id_footer.setitem(1, "misccharges", ld_invmisccharges)
		this.id_footer.setitem(1, "invgstperc1", ld_invgstperc1)
		for ll_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		ll_gcode = this.ii_salegodown
		for ll_counter = 1 to lds_prdetail.rowcount()
			ll_row = this.id_detail.insertrow(0)
			ll_packunits = lds_prdetail.getitemnumber(ll_counter, "packunits")
			if ll_packunits < 1 or isnull(ll_packunits) then
				ll_packunits = 1
			end if
			ll_icode = lds_prdetail.getitemnumber(ll_counter, "icode")
			ld_qty = lds_prdetail.getitemnumber(ll_counter, "looseqty")
			ld_bonusqty = lds_prdetail.getitemnumber(ll_counter, "bonusqty")
			ld_srprice = lds_prdetail.getitemnumber(ll_counter, "PRPrice")
			ld_discperc = lds_prdetail.getitemnumber(ll_counter, "discperc")
			ld_itemflatdisc = 0
			ld_unitsalestax = lds_prdetail.getitemnumber(ll_counter, "unitsalestax")
			ld_gstperc = lds_prdetail.getitemnumber(ll_counter, "gstperc")
			ls_batch = lds_prdetail.getitemstring(ll_counter, "batch")
			ldt_expiry = lds_prdetail.getitemdatetime(ll_counter, "expiry")
			SQL SELECT item.customicode , item.name , item.gcode , item.purprice , item.packsalestax , item.saleprice , item.avgprice INTO :ls_fullcode, :ls_name, :li_gcode, :ld_itempurprice, :ld_packsalestax, :ld_saleprice, :ld_avgprice FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = -1 then
				retflag = false
				ls_errortext = "Database Error: Item information can not be retrieved.~r~nReasons:" + this.it_transobject.sqlerrtext
				messagebox("Item Validation", ls_errortext)
			end if
			if ll_packunits < 1 or isnull(ll_packunits) then
				ll_packunits = 1
			end if
			this.it_transobject.getitemstocktotal(this.ii_salegodown, ll_icode, ld_godownstock)
			this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
			if this.it_transobject.sqlcode = -1 then
				retflag = false
				ls_errortext = "Database Error: Item Stock information can not be retrieved"
			end if
			this.id_detail.setitem(ll_row, "gcode", ll_gcode)
			this.id_detail.setitem(ll_row, "icode", ll_icode)
			this.id_detail.setitem(ll_row, this.is_columnitemname, ls_name)
			this.id_detail.setitem(ll_row, "fullcode", ls_fullcode)
			this.id_detail.setitem(ll_row, "packunits", ll_packunits)
			this.id_detail.setitem(ll_row, "looseqty", ld_qty)
			this.id_detail.setitem(ll_row, "discperc", ld_discperc)
			this.id_detail.setitem(ll_row, "srprice", ld_srprice)
			this.id_detail.setitem(ll_row, "avgprice", ld_avgprice)
			this.id_detail.setitem(ll_row, "saleprice", ld_saleprice / ll_packunits)
			this.id_detail.setitem(ll_row, "stock", ld_godownstock)
			this.id_detail.setitem(ll_row, "totalstock", ld_allgodownstock)
			this.id_detail.setitem(ll_row, "batch", ls_batch)
			this.id_detail.setitem(ll_row, "expiry", ldt_expiry)
			this.id_detail.setitem(ll_row, "bonusqty", ld_bonusqty)
			this.id_detail.setitem(ll_row, "unitsalestax", ld_unitsalestax)
			this.id_detail.setitem(ll_row, "gstperc", ld_gstperc)
			this.id_footer.setitem(1, "stock", ld_godownstock)
		next
		if this.id_detail.rowcount() > 0 then
			this.im_menu.m_file.m_save.enabled = true
			wf_grandtotal()
			this.im_menu.m_file.m_save.enabled = true
			event ue_save()
			if wf_commitform() = true then
				SQL rollback USING sqlca;
				sqlca.markpraspulled(ll_sitecode, ll_prinvcode, gl_usercode, gs_dropbox_server, gs_dropbox_db, "dbo")
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
				else
					SQL rollback USING sqlca;
				end if
				postevent("ue_new")
			else
				ll_totrows = this.id_detail.rowcount()
				if ll_totrows > 0 then
					for ll_row = 1 to ll_totrows
						triggerevent("ue_deleteitem")
					next
				end if
			end if
		else
			this.im_menu.m_file.m_save.enabled = false
		end if
	end if
	SQL stop USING lt_transobject;

// w_salereturn.wf_visibleinvisiblediscount() returns integer
	this.id_detail.object.discperc.visible = 0
	return 1

// w_salereturn.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	long iccode
	long icatcode
	long packcode
	long manfcode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_salereturn.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_counter step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_salereturn.wf_setfooterinfo(long al_saleinvcode) returns 0
	double ld_discperc
	double ld_flatdisc
	double ld_misccharges
	double ld_invgstperc1
	double ld_fbrposfee
	long ll_returncount
	SQL SELECT saleledger.discperc , saleledger.flatdisc , saleledger.misccharges , saleledger.InvGSTperc1 , saleledger.FBRPOSFee , ReturnCount =ISNULL ( ( SELECT COUNT ( SaleInvCode ) FROM SRLedger WHERE SaleInvCode =:al_saleinvcode ) , 0 ) INTO :ld_discperc, :ld_flatdisc, :ld_misccharges, :ld_invgstperc1, :ld_fbrposfee, :ll_returncount FROM saleledger WHERE saleledger.saleinvcode =:al_saleinvcode USING sqlca;
	if ll_returncount = 0 then
		this.id_footer.setitem(1, "discperc", ld_discperc)
		this.id_footer.setitem(1, "flatdisc", ld_flatdisc)
		this.id_footer.setitem(1, "InvGSTperc1", ld_invgstperc1)
		if f_stringpreferences("FetchFBRPosFeeForRefSR") = "Y" then
			this.id_footer.setitem(1, "misccharges", ld_misccharges)
			this.id_footer.setitem(1, "FBRPOSFee", ld_fbrposfee)
			return
		end if
		if ld_misccharges >= 1.0 and ld_fbrposfee > 0.0 then
			ld_misccharges = ld_misccharges - 1.0
			this.id_footer.setitem(1, "misccharges", ld_misccharges)
		else
			this.id_footer.setitem(1, "misccharges", ld_misccharges)
		end if
		if ld_fbrposfee > 0.0 then
			ld_fbrposfee = 0
			this.id_footer.setitem(1, "FBRPOSFee", ld_fbrposfee)
		end if
	end if

// w_salereturn.wf_visible(boolean ab_flag) returns 0
	if not this.ib_opensalereturn then
		this.id_footer.object.retableqty.visible = ab_flag
		this.id_footer.object.t_retableqty.visible = ab_flag
		this.id_footer.object.saleqty.visible = ab_flag
		this.id_footer.object.t_saleqty.visible = ab_flag
		this.id_footer.object.retablebonusqty.visible = ab_flag
		this.id_footer.object.t_retablebonusqty.visible = ab_flag
		this.id_footer.object.salebonusqty.visible = ab_flag
		this.id_footer.object.t_salebonusqty.visible = ab_flag
	end if

// w_salereturn.wf_retrievelistall() returns long
	string[] ls_posted
	integer li_saleretcategory
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_salerettype = 1 then
		li_saleretcategory = this.ii_saleretcategory
	else
		li_saleretcategory = this.ii_salerettype
	end if
	return this.id_list.retrieve(li_saleretcategory, ls_posted, this.il_groupcode, this.ii_module)

// w_salereturn.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_salereturn.wf_customerinfo(long al_custcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	string ls_aliasname
	string ls_considerinpo
	long ll_currow
	long ll_smancode
	long ll_counter
	long ll_icode
	long ll_sitecode
	char lc_taxable
	double ld_taxperc
	SQL SELECT customer.address1 , customer.city , customer.phone , accounts.aliasname , customer.considerinpo , customer.salesmancode , taxperc =( SELECT TC.taxperc FROM TaxCategory TC WHERE TC.TaxCategoryCode =customer.taxcategorycode ) , customer.sitecode INTO :ls_address, :ls_city, :ls_phone, :ls_aliasname, :ls_considerinpo, :ll_smancode, :ld_taxperc, :ll_sitecode FROM customer , accounts WHERE customer.custcode =:al_custcode and customer.custcode =accounts.acccode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
		this.id_master.object.custcode[ll_currow] = al_custcode
		if this.ib_opensalereturn then
			this.id_master.object.smancode[ll_currow] = ll_smancode
		end if
		this.id_master.object.aliasname[ll_currow] = ls_aliasname
		this.id_master.object.address[ll_currow] = ls_address
		this.id_master.object.city[ll_currow] = ls_city
		this.id_master.object.phone[ll_currow] = ls_phone
		this.id_master.object.considerinpo[ll_currow] = ls_considerinpo
		this.id_master.object.targetsitecode[ll_currow] = ll_sitecode
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.object.icode[ll_counter]
			if ll_icode > 0 then
				if this.ic_advancetaxonsale = "Y" and this.id_detail.object.taxable[ll_counter] = "Y" then
					this.id_detail.object.itemadvancetaxperc[ll_counter] = ld_taxperc
				else
					this.id_detail.object.itemadvancetaxperc[ll_counter] = 0.00
				end if
			end if
		next
	end if
	return this.it_transobject.sqlcode

// w_salereturn.wf_customername(long al_custcode) returns integer
	string ls_custname
	SQL SELECT accounts.name INTO :ls_custname FROM accounts WHERE accounts.acccode =:al_custcode USING this.it_transobject;
	this.id_master.object.custname[this.id_master.getrow()] = ls_custname
	return this.it_transobject.sqlcode

// w_salereturn.wf_duplicaterow(long al_currrow) returns boolean
	boolean lb_duplicate
	string ls_batch
	datetime ld_expiry
	long ll_gcode
	long ll_icode
	ls_batch = this.id_detail.getitemstring(al_currrow, "batch")
	ld_expiry = this.id_detail.getitemdatetime(al_currrow, "expiry")
	ll_gcode = this.id_detail.getitemnumber(al_currrow, "gcode")
	ll_icode = this.id_detail.getitemnumber(al_currrow, "icode")
	if not isnull(ll_gcode) and not isnull(ll_icode) and not isnull(ls_batch) and not isnull(ld_expiry) and vf_dwdupcodebatch(this.id_detail, "gcode", ll_gcode, "icode", ll_icode, "batch", ls_batch, "expiry", ld_expiry, al_currrow) then
		lb_duplicate = true
	end if
	return lb_duplicate

// w_salereturn.wf_findcustcode(string as_aliasname, integer ai_custcode) returns integer
	integer li_custcode
	integer ll_retflag
	string ls_itemname
	SQL SELECT accounts.acccode INTO :li_custcode FROM accounts , customer WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =customer.custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_custcode = li_custcode
		if isnull(ai_custcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_salereturn.wf_findregno(long al_patientcode) returns string
	string ls_regno
	SQL SELECT regno INTO :ls_regno FROM Patient WHERE PatientCode =:al_patientcode AND Active ='Y' AND Patient.PatientCatCode IN ( SELECT DISTINCT PatientCatCode FROM PatientCatAllowedModule WHERE ModuleID =:this.ii_module ) USING this.it_transobject;
	return ls_regno

// w_salereturn.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_invtaxpercval
	double ld_totaltax
	double ld_itemleveltax
	double ld_invtaxperc1
	double lr_discperc
	double lr_flatdisc
	double ld_misccharges
	double lr_salestax
	double lr_itemstotal
	double ld_advincometax
	integer li_roundupto
	li_roundupto = f_numberpreferences("roundsalereturninvon")
	if isnull(li_roundupto) or li_roundupto < 0 then
		li_roundupto = 0
	end if
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		lr_discperc = this.id_footer.object.discperc[1]
		lr_flatdisc = this.id_footer.object.flatdisc[1]
		ld_misccharges = this.id_footer.object.misccharges[1]
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
		ld_invtaxperc1 = this.id_footer.object.invgstperc1[1]
		ld_invtaxpercval = round(ld_detaildwtotal * ld_invtaxperc1 * 0.01, 2)
		ld_itemleveltax = this.id_detail.getitemnumber(1, "c_sumgstval") + this.id_detail.getitemnumber(1, "c_sumtaxval")
		ld_totaltax = round(ld_invtaxpercval + ld_itemleveltax, li_roundupto)
		ld_advincometax = this.id_detail.getitemnumber(1, "c_totadvancetax")
		if this.ic_advancetaxonsale = "Y" then
			this.id_footer.object.misccharges[1] = ld_advincometax
			this.id_footer.object.advancetaxamt[1] = ld_advincometax
		else
			ld_misccharges = this.id_footer.object.misccharges[1]
			this.id_footer.object.advancetaxamt[1] = 0.00
		end if
		if this.ic_autofiscalize = "Y" and this.ic_fbrposfee = "Y" then
			if this.id_footer.object.misccharges[1] = this.id_footer.object.advancetaxamt[1] + this.id_footer.object.fbrposfee[1] then
				this.id_footer.object.misccharges[1] = this.id_footer.object.advancetaxamt[1] + this.id_footer.object.fbrposfee[1]
			elseif this.id_footer.object.misccharges[1] > this.id_footer.object.advancetaxamt[1] + this.id_footer.object.fbrposfee[1] then
				this.id_footer.object.misccharges[1] = this.id_footer.object.advancetaxamt[1] + this.id_footer.object.fbrposfee[1] + (this.id_footer.object.misccharges[1] - this.id_footer.object.advancetaxamt[1] - this.id_footer.object.fbrposfee[1])
			else
				this.id_footer.object.misccharges[1] = this.id_footer.object.misccharges[1]
			end if
		else
			ld_misccharges = this.id_footer.object.misccharges[1]
		end if
		ld_misccharges = this.id_footer.object.misccharges[1]
		ld_grandtotal = ld_detaildwtotal * (1.0 - lr_discperc * 0.01) - lr_flatdisc + ld_misccharges + lr_salestax
		ld_grandtotal = round(ld_grandtotal, li_roundupto) + ld_totaltax
		this.id_footer.setitem(1, "total", ld_grandtotal)
	end if
	return ld_grandtotal

// w_salereturn.wf_initmodify(integer ai_protect) returns 0
	long ll_saleretinvcode
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_counter
	long ll_dddwrowcount
	long ll_dddwrow
	long ll_totalpieces
	long ll_piecesinhand
	double ld_stock
	double ld_itemsaleretqty
	double ld_saleqty
	double ld_prevretqty
	double ld_retableqty
	double ld_itemsaleqty
	double ld_itemsaleretbonusqty
	double ld_salebonusqty
	double ld_prevretbonusqty
	double ld_retablebonusqty
	string ls_batch
	datetime ld_expiry
	ai_protect = 1
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_saleretinvcode = this.id_detail.getitemnumber(1, "code")
		if wf_locksaleretinvoice(ll_saleretinvcode) = 0 then
			this.id_master.retrieve(ll_saleretinvcode)
			this.id_detail.retrieve(ll_saleretinvcode)
			if not this.ib_opensalereturn then
				ll_saleinvcode = this.id_master.getitemnumber(1, "saleinvcode")
				if wf_locksaleinvoice(ll_saleinvcode) = 0 then
					ll_dddwrowcount = this.idc_itemdddw.rowcount()
				else
					ai_protect = 1
				end if
			end if
			for ll_counter = 1 to this.id_detail.rowcount()
				ll_gcode = this.id_detail.getitemnumber(ll_counter, "gcode")
				ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
				ll_totalpieces = this.id_detail.getitemnumber(ll_counter, "totalpieces")
				ll_piecesinhand = this.id_detail.getitemnumber(ll_counter, "piecesinhand")
				ld_itemsaleretqty = this.id_detail.getitemnumber(ll_counter, "looseqty")
				ld_itemsaleretbonusqty = this.id_detail.getitemnumber(ll_counter, "Bonusqty")
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					ai_protect = 0
					if not this.ib_opensalereturn then
						ls_batch = this.id_detail.getitemstring(ll_counter, "batch")
						ld_expiry = this.id_detail.getitemdatetime(ll_counter, "Expiry")
						if wf_itemprevretqty(ll_saleinvcode, ll_gcode, ll_icode, ls_batch, ld_expiry, ld_prevretqty, ld_prevretbonusqty) = 0 then
							ll_dddwrow = this.idc_itemdddw.find("icode = long('" + string(ll_icode) + "')", 1, ll_dddwrowcount)
							ld_saleqty = this.idc_itemdddw.getitemnumber(ll_dddwrow, "looseqty")
							ld_salebonusqty = this.idc_itemdddw.getitemnumber(ll_dddwrow, "Bonusqty")
							ld_retableqty = ld_saleqty - ld_prevretqty
							ld_retablebonusqty = ld_salebonusqty - ld_prevretbonusqty
						else
							ai_protect = 1
						end if
					else
						ld_retableqty = 0
						ld_saleqty = 0
						ld_retablebonusqty = 0
						ld_salebonusqty = 0
					end if
					this.id_detail.setitem(ll_counter, "stock", ld_stock)
					this.id_detail.setitem(ll_counter, "retableqty", ld_retableqty)
					this.id_detail.setitem(ll_counter, "saleqty", ld_saleqty)
					this.id_detail.setitem(ll_counter, "retableBonusqty", ld_retablebonusqty)
					this.id_detail.setitem(ll_counter, "saleBonusqty", ld_salebonusqty)
					this.id_footer.setitem(1, "retableQty", ld_retableqty)
					this.id_footer.setitem(1, "stock", ld_stock)
					this.id_footer.setitem(1, "saleqty", ld_saleqty)
					this.id_footer.setitem(1, "retableBonusQty", ld_retablebonusqty)
					this.id_footer.setitem(1, "saleBonusqty", ld_salebonusqty)
				end if
				this.it_transobject.getitemtotalpiecesinhand(ll_icode, ll_piecesinhand)
				if this.it_transobject.sqlcode = 0 then
					this.id_detail.setitem(ll_counter, "piecesinhand", ll_piecesinhand + ll_totalpieces)
					this.id_footer.setitem(1, "piecesinhand", ll_piecesinhand + ll_totalpieces)
				end if
			next
			if ai_protect = 0 then
				this.ib_modify = true
				this.id_footer.setitem(1, "stock", this.id_detail.getitemnumber(1, "stock"))
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
		end if
	end if

// w_salereturn.wf_locksaleinvoice(long al_saleinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From saleledger WITH ( UPDLOCK HOLDLOCK ) Where saleledger.saleinvcode =:al_saleinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_salereturn.wf_locksaleretinvoice(long al_saleretinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From srledger WITH ( UPDLOCK HOLDLOCK ) Where srledger.srinvcode =:al_saleretinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_salereturn.wf_locksrinvoices(long al_sinvcode, long al_linvcode) returns integer
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM srledger WITH ( UPDLOCK HOLDLOCK ) WHERE srledger.srinvcode Between :al_sinvcode and :al_linvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_salereturn.wf_returnsaleretinvoice() returns integer
	return 1

// w_salereturn.wf_setsalereturntype(integer ai_salerettype, boolean ab_opensaleret) returns 0
	this.ii_salerettype = ai_salerettype
	this.ib_opensalereturn = ab_opensaleret

// w_salereturn.wf_updatesalereturnitemsstock(long al_saleretinvcode, string as_errtext, long al_errrow) returns integer
	long ll_detailrows
	long ll_gcode
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode
	long li_counter
	long li_innercounter
	long ll_row
	long ll_totalpieces
	long ll_piecesinhand
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	string ls_batch
	datetime ld_expiry
	integer li_errcode
	double ld_stock
	double ld_newstock
	double ld_saleretqty
	double ld_saleretbonusqty
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	as_errtext = "    Some database problem ocuurs         "
	do while li_counter <= ll_detailrows and li_errcode = 0
		ll_gcode = this.id_detail.getitemnumber(li_counter, "gcode")
		ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
		ld_saleretqty = this.id_detail.getitemnumber(li_counter, "looseqty")
		ll_packunits = this.id_detail.getitemnumber(li_counter, "packunits")
		ld_saleprice = this.id_detail.getitemnumber(li_counter, "saleprice")
		ld_discperc = this.id_detail.getitemnumber(li_counter, "discperc")
		ls_batch = this.id_detail.getitemstring(li_counter, "batch")
		ld_expiry = this.id_detail.getitemdatetime(li_counter, "expiry")
		ld_stock = this.id_detail.getitemnumber(li_counter, "stock")
		ll_totalpieces = this.id_detail.getitemnumber(li_counter, "totalpieces")
		ll_piecesinhand = this.id_detail.getitemnumber(li_counter, "piecesinhand")
		ld_saleretbonusqty = this.id_detail.getitemnumber(li_counter, "bonusqty")
		this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
			if this.it_transobject.sqlcode = 0 then
				ld_newstock = ld_stock + ld_saleretqty + ld_saleretbonusqty
				this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
				if this.it_transobject.sqlcode <> 0 then
					li_errcode = -1
				end if
			else
				li_errcode = -1
			end if
		else
			li_errcode = -1
		end if
		this.it_transobject.getitemtotalpiecesinhand(ll_icode, ll_piecesinhand)
		if this.it_transobject.sqlcode <> 0 then
			li_errcode = -1
		else
			ll_piecesinhand = ll_piecesinhand + ll_totalpieces
			this.id_detail.setitem(li_counter, "piecesinhand", ll_piecesinhand)
			if ll_piecesinhand >= ll_totalpieces then
				this.it_transobject.updateitemtotalpiecesinhand(ll_icode, -1, ll_totalpieces)
				if this.it_transobject.sqlcode <> 0 then
					li_errcode = -1
				end if
			end if
		end if
		li_counter = li_counter + 1
	loop
	al_errrow = li_counter - 1
	return li_errcode

// w_salereturn.wf_validatefullcode(string as_fullcode, long al_currrow) returns integer
	return 0

// w_salereturn.wf_findunpostedsalereturns(long al_saleinvcode, string as_errtext) returns integer
	integer li_rtcode
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM srledger WHERE srledger.saleinvcode =:al_saleinvcode AND srledger.posted ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_count > 0 then
			li_rtcode = 1
			as_errtext = "Some Unposted Sale Return invoice already exist,~n~rModify that invoice"
		end if
	else
		li_rtcode = 1
		as_errtext = "Database Error, Some database request fails"
	end if
	return li_rtcode

// w_salereturn.wf_itemsalehistory() returns 0
	s_itemsalehistory ls_itemsalehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itemsalehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itemsalehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itemsalehistory, ls_itemsalehistory)
	end if

// w_salereturn.wf_prevsaleinvinfo() returns 0
	s_previnvinfo ls_previnvinfo
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_previnvinfo.ar_customer = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		if this.id_master.getitemnumber(this.id_master.getrow(), "patientcode") > 0.0 then
			ls_previnvinfo.ar_patientcode = this.id_master.getitemnumber(this.id_master.getrow(), "patientcode")
		else
			setnull(ls_previnvinfo.ar_patientcode)
		end if
		ls_previnvinfo.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_previnvinfo.ar_invdate = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_previnvinfo, ls_previnvinfo)
	end if

// w_salereturn.wf_allowsalereturn(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns integer
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM SaleDetail WHERE SaleInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_salereturn.wf_findwholesaleinvoice(long al_saleinvcode, datetime ad_date, string as_errtext) returns integer
	integer li_rtcode
	long ll_admissioncode
	string ls_posted
	setnull(ll_admissioncode)
	SQL SELECT SaleLedger.date , Posted , admissioncode INTO :ad_date, :ls_posted, :ll_admissioncode FROM SaleLedger WHERE SaleLedger.Saleinvcode =:al_saleinvcode AND ( SaleLedger.SaleCatCode =1 OR SaleLedger.SaleCatCode =2 ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ls_posted) then
			as_errtext = "You must select some valid Whole Sale Invoice"
			li_rtcode = 1
		elseif ls_posted = "Y" then
			li_rtcode = 0
		else
			li_rtcode = 1
			as_errtext = "Sale invoice " + string(al_saleinvcode) + " is unposted~n~rOnly Posted invoices can be returned"
		end if
		if li_rtcode = 0 and wf_allowsalereturn(al_saleinvcode, f_getgroupcode(gl_usercode), this.il_strategy) <> 0 then
			li_rtcode = 1
			as_errtext = "Sale invoice " + string(al_saleinvcode) + " contains items of non allowed godown(s)~n~rYou Can not Make Return"
		end if
		if li_rtcode = 0 and not isnull(ll_admissioncode) then
			as_errtext = "Can not Return this invoice,~r~nPlease Use In-Patient Sale Return"
			li_rtcode = 1
		end if
	else
		li_rtcode = 1
		as_errtext = "Database Error, Some database request fails"
	end if
	return li_rtcode

// w_salereturn.wf_findretailsaleinvoice(long al_saleinvcode, datetime ad_date, string as_errtext) returns integer
	integer li_rtcode
	string ls_posted
	SQL SELECT SaleLedger.date , posted INTO :ad_date, :ls_posted FROM SaleLedger WHERE SaleLedger.Saleinvcode =:al_saleinvcode AND SaleLedger.SaleCatCode =3 USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ls_posted) then
			as_errtext = "You must select some valid Retail Sale Invoice"
			li_rtcode = 1
		elseif ls_posted = "Y" then
			li_rtcode = 0
		else
			li_rtcode = 1
			as_errtext = "Sale invoice " + string(al_saleinvcode) + " is unposted~n~rOnly Posted invoices can be returned"
		end if
		if li_rtcode = 0 and wf_allowsalereturn(al_saleinvcode, f_getgroupcode(gl_usercode), this.il_strategy) <> 0 then
			li_rtcode = 1
			as_errtext = "Sale invoice " + string(al_saleinvcode) + " contains items of non allowed godown(s)~n~rYou Can not Make Return"
		end if
	else
		li_rtcode = 1
		as_errtext = "Database Error, Some database request fails"
	end if
	return li_rtcode

// w_salereturn.wf_getpossiblebatchexpiry() returns 0
	s_possiblebatchexpiry lstr_possiblebatchexpiry
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 and not isnull(this.id_master.getitemnumber(this.id_master.getrow(), "custcode")) then
		lstr_possiblebatchexpiry.l_custcode = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		lstr_possiblebatchexpiry.l_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		openwithparm(w_possiblebatchexpiry, lstr_possiblebatchexpiry)
		lstr_possiblebatchexpiry = message.powerobjectparm
		if lstr_possiblebatchexpiry.i_status = 1 then
			this.id_detail.setitem(this.id_detail.getrow(), "batch", lstr_possiblebatchexpiry.s_batch)
			this.id_detail.setitem(this.id_detail.getrow(), "expiry", lstr_possiblebatchexpiry.d_expiry)
		end if
	end if

// w_salereturn.wf_post() returns integer
	integer li_postingmode
	long ll_sinvcode
	long ll_linvcode
	setnull(ll_sinvcode)
	setnull(ll_linvcode)
	return wf_post_salereturn(li_postingmode, ll_sinvcode, ll_linvcode)

// w_salereturn.wf_editsaleinvoice() returns integer
	long ll_rowcount
	long ll_counter
	long ll_saleinvcode
	long ll_rowscopy
	long ll_returneditems
	long ll_erroritems
	string ls_errtext
	integer li_errcode
	this.id_detail.setredraw(false)
	this.id_detail.reset()
	ll_saleinvcode = this.id_master.getitemnumber(this.id_master.getrow(), "saleinvcode")
	this.ib_itemvalidated = true
	this.id_detail.insertrow(0)
	ll_rowcount = this.idc_itemdddw.rowcount()
	ll_rowscopy = 1
	for ll_counter = 1 to ll_rowcount
		li_errcode = wf_inititeminfo(this.idc_itemdddw, ll_saleinvcode, ll_counter, ll_rowscopy, ls_errtext)
		if li_errcode = 1 then
			ll_returneditems = ll_returneditems + 1
		elseif li_errcode = -1 then
			ll_erroritems = ll_erroritems + 1
		else
			ll_rowscopy = ll_rowscopy + 1
			this.id_detail.insertrow(0)
		end if
	next
	this.id_detail.deleterow(ll_rowscopy)
	messagebox("Edit Sale Invoice Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowscopy - 1) + " records were retrieved successfully~n~r" + string(ll_returneditems) + " records has already been returned~n~r" + string(ll_erroritems) + " record's database info. cannot be retrieved")
	if ll_rowscopy - 1 > 0 then
		wf_setfooterinfo(ll_saleinvcode)
		this.id_footer.setitem(1, "stock", this.id_detail.getitemnumber(1, "stock"))
		this.id_footer.setitem(1, "saleqty", this.id_detail.getitemnumber(1, "saleqty"))
		this.id_footer.setitem(1, "retableqty", this.id_detail.getitemnumber(1, "retableqty"))
		if f_stringpreferences("BonusinSale") = "Y" then
			this.id_footer.setitem(1, "salebonusqty", this.id_detail.getitemnumber(1, "salebonusqty"))
			this.id_footer.setitem(1, "retablebonusqty", this.id_detail.getitemnumber(1, "retablebonusqty"))
		end if
		this.im_menu.m_file.m_save.enabled = true
		this.id_detail.scrolltorow(0)
		this.id_detail.setcolumn(1)
		this.id_detail.setfocus()
		wf_grandtotal()
	end if
	this.id_detail.setredraw(true)
	return ll_rowscopy

// w_salereturn.wf_isinvoiceinuse(long al_invoiceno) returns boolean
	long ll_found
	SQL Select count ( *) INTO :ll_found From SRLedger Where SRInvCode =:al_invoiceno and Posted ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_found = 0 or isnull(ll_found) then
			SQL Select count ( *) INTO :ll_found From SRLedger With ( ReadPast , RowLock , UpdLock ) Where SRInvCode =:al_invoiceno USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ll_found = 0 then
					return true
				else
					return false
				end if
			else
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_salereturn.wf_retrievelist() returns long
	long ll_rtcode
	string[] ls_posted
	integer li_saleretcategory
	ls_posted[1] = "N"
	if this.ii_salerettype = 1 then
		li_saleretcategory = this.ii_saleretcategory
	else
		li_saleretcategory = this.ii_salerettype
	end if
	if this.ib_showinvoicelist then
		ll_rtcode = this.id_list.retrieve(li_saleretcategory, ls_posted, this.il_groupcode, this.ii_module)
	else
		ll_rtcode = -1
	end if
	return ll_rtcode

// w_salereturn.wf_inititeminfo(datawindowchild adc_itemdddw, long al_saleinvcode, long al_dsrow, long al_detaildwrow, string as_errtext) returns integer
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_salerowid
	long ll_piecesinhand
	long ll_totalpieces
	double ld_saleprice
	double ld_discperc
	double ld_unitsalestax
	double ld_gstperc
	double ld_basicdatasaleprice
	double ld_alternatepurprice
	double ld_itemadvancetaxperc
	string ls_fullcode
	string ls_batch
	string ls_itemname
	string ls_remarks
	string ls_alternatecustomicode
	string ls_null
	string ls_claimable
	datetime ld_expiry
	integer li_errcode
	char lc_taxable
	double ld_commissionperc
	double ld_avgprice
	double ld_claimablediscperc
	double ld_commissionperunit
	double ld_retableqty
	double ld_itemprevqty
	double ld_itemsaleqty
	double ld_stock
	double ld_itemsalebonusqty
	double ld_retablebonusqty
	double ld_itemprevbonusqty
	setnull(ls_null)
	ll_icode = adc_itemdddw.getitemnumber(al_dsrow, "icode")
	SQL SELECT saleprice , packunits , totalpieces , remarks , alternatepurprice , taxable INTO :ld_basicdatasaleprice, :ll_packunits, :ll_piecesinhand, :ls_remarks, :ld_alternatepurprice, :lc_taxable FROM Item WHERE icode =:ll_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_gcode = adc_itemdddw.getitemnumber(al_dsrow, "gcode")
		ll_icode = adc_itemdddw.getitemnumber(al_dsrow, "icode")
		ls_fullcode = adc_itemdddw.getitemstring(al_dsrow, "fullcode")
		ls_alternatecustomicode = this.id_itemslist.getitemstring(al_dsrow, "alternatecustomicode")
		ls_batch = adc_itemdddw.getitemstring(al_dsrow, "batch")
		ld_expiry = adc_itemdddw.getitemdatetime(al_dsrow, "Expiry")
		ld_saleprice = adc_itemdddw.getitemnumber(al_dsrow, "saleprice")
		ld_discperc = adc_itemdddw.getitemnumber(al_dsrow, "discperc")
		ld_itemsaleqty = adc_itemdddw.getitemnumber(al_dsrow, "looseqty")
		ld_itemsalebonusqty = adc_itemdddw.getitemnumber(al_dsrow, "bonusqty")
		ld_avgprice = adc_itemdddw.getitemnumber(al_dsrow, "avgprice")
		ll_salerowid = adc_itemdddw.getitemnumber(al_dsrow, "salerowid")
		ll_totalpieces = adc_itemdddw.getitemnumber(al_dsrow, "totalpieces")
		ld_commissionperc = adc_itemdddw.getitemnumber(al_dsrow, "commissionperc")
		ld_commissionperunit = adc_itemdddw.getitemnumber(al_dsrow, "commissionperunit")
		ls_claimable = adc_itemdddw.getitemstring(al_dsrow, "claimable")
		ld_claimablediscperc = adc_itemdddw.getitemnumber(al_dsrow, "claimablediscperc")
		lc_taxable = adc_itemdddw.getitemstring(al_dsrow, "taxable")
		ld_itemadvancetaxperc = adc_itemdddw.getitemnumber(al_dsrow, "ItemAdvanceTaxPerc")
		ld_unitsalestax = adc_itemdddw.getitemnumber(al_dsrow, "unitsalestax")
		ld_gstperc = adc_itemdddw.getitemnumber(al_dsrow, "gstperc")
		ls_itemname = this.id_itemslist.getitemstring(al_dsrow, "itemname")
		if wf_itemprevretqty(al_saleinvcode, ll_salerowid, ll_icode, ld_itemprevqty, ld_itemprevbonusqty) = 0 then
			ld_retableqty = ld_itemsaleqty - ld_itemprevqty
			ld_retablebonusqty = ld_itemsalebonusqty - ld_itemprevbonusqty
			if ld_retableqty > 0.0 or ld_retablebonusqty > 0.0 then
				if this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock) = 0 then
					if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
						ll_gcode = this.id_detail.getitemnumber(al_detaildwrow, "gcode")
					end if
					this.id_detail.setitem(al_detaildwrow, "gcode", ll_gcode)
					this.id_detail.setitem(al_detaildwrow, "salerowid", ll_salerowid)
					this.id_detail.setitem(al_detaildwrow, "icode", ll_icode)
					this.id_detail.setitem(al_detaildwrow, "fullcode", ls_fullcode)
					this.id_detail.setitem(al_detaildwrow, "alternatecustomicode", ls_alternatecustomicode)
					this.id_detail.setitem(al_detaildwrow, "batch", ls_batch)
					this.id_detail.setitem(al_detaildwrow, "expiry", ld_expiry)
					this.id_detail.setitem(al_detaildwrow, "srprice", ld_saleprice)
					this.id_detail.setitem(al_detaildwrow, "discperc", ld_discperc)
					this.id_detail.setitem(al_detaildwrow, "claimable", ls_claimable)
					this.id_detail.setitem(al_detaildwrow, "claimablediscperc", ld_claimablediscperc)
					this.id_detail.setitem(al_detaildwrow, "Bonusqty", ld_retablebonusqty)
					this.id_detail.setitem(al_detaildwrow, "looseqty", ld_retableqty)
					this.id_detail.setitem(al_detaildwrow, "stock", ld_stock)
					this.id_detail.setitem(al_detaildwrow, "saleqty", ld_itemsaleqty)
					this.id_detail.setitem(al_detaildwrow, "retableqty", ld_retableqty)
					this.id_detail.setitem(al_detaildwrow, "salebonusqty", ld_itemsalebonusqty)
					this.id_detail.setitem(al_detaildwrow, "retablebonusqty", ld_retablebonusqty)
					this.id_detail.setitem(al_detaildwrow, "packunits", ll_packunits)
					this.id_detail.setitem(al_detaildwrow, "totalpieces", ll_totalpieces)
					this.id_detail.setitem(al_detaildwrow, "piecesinhand", ll_piecesinhand)
					this.id_detail.setitem(al_detaildwrow, "avgprice", ld_avgprice)
					this.id_detail.setitem(al_detaildwrow, "alternatepurprice", ld_alternatepurprice)
					this.id_detail.setitem(al_detaildwrow, "commissionperunit", ld_commissionperunit)
					this.id_detail.setitem(al_detaildwrow, "commissionperc", ld_commissionperc)
					this.id_detail.setitem(al_detaildwrow, "itemname", ls_itemname)
					this.id_detail.setitem(al_detaildwrow, "unitsalestax", ld_unitsalestax)
					this.id_detail.setitem(al_detaildwrow, "gstperc", ld_gstperc)
					this.id_detail.setitem(al_detaildwrow, "saleprice", ld_basicdatasaleprice / ll_packunits)
					this.id_detail.setitem(al_detaildwrow, "taxable", lc_taxable)
					this.id_detail.setitem(al_detaildwrow, "ItemAdvanceTaxPerc", ld_itemadvancetaxperc)
					if f_stringpreferences("sr_copyremarksinitemdesc") = "Y" and this.id_detail.getitemstatus(al_detaildwrow, "returnitemdescription", primary!) = notmodified! then
						this.id_detail.setitem(al_detaildwrow, "returnitemdescription", ls_remarks)
					end if
					this.id_footer.setitem(1, "piecesinhand", ll_piecesinhand)
					this.id_footer.setitem(1, "stock", ld_stock)
					this.id_footer.setitem(1, "saleqty", ld_itemsaleqty)
					this.id_footer.setitem(1, "retableqty", ld_retableqty)
					this.id_footer.setitem(1, "saleBonusqty", ld_itemsalebonusqty)
					this.id_footer.setitem(1, "retableBonusqty", ld_retablebonusqty)
					wf_setfooterinfo(al_saleinvcode)
				else
					as_errtext = "Can not retrieve item stock information"
					li_errcode = 1
				end if
			else
				as_errtext = "Item Qty and Bonus has already been returned"
				li_errcode = 1
			end if
		else
			li_errcode = -1
			as_errtext = "Sale invoice information can not retrieve"
		end if
	else
		li_errcode = -1
		as_errtext = "Unable To Retrieve SalePrice from Item Basic Data"
	end if
	return li_errcode

// w_salereturn.wf_inititeminfo(long al_icode, long al_row, string as_errortext) returns integer
	double ld_saleprice
	double ld_defaultitemdiscperc
	double ld_discperc
	double ld_discperc2
	double ld_discperc3
	double ld_discperc4
	double ld_discperc5
	double ld_unitsalestax
	double ld_gstperc2
	double ld_gstperc1
	double ld_alternatepurprice
	long ll_packunits
	long ll_saleinvcode
	long ll_totalpieces
	long ll_piecesinhand
	integer li_gcode
	integer retflag
	integer li_custcode
	integer li_defaultgst
	string ls_fullcode
	string ls_name
	string ls_packingdesc
	string ls_remarks
	string ls_alternatecustomicode
	string ls_null
	double ld_godownstock
	double ld_saleqty
	double ld_claimablediscperc
	double ld_taxperc
	double ld_commissionperunit
	double ld_commissionperc
	double ld_avgprice
	char lc_taxable
	li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
	SQL SELECT item.customicode , item.name , item.saleprice , item.packunits , item.gcode , item.salediscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 , item.gstperc1 , item.gstperc2 , Round ( item.packsalestax / item.packunits , 2 ) , item.packingdesc , item.totalpieces , item.remarks , item.alternatepurprice , CommissionPerUnit , CommissionPerc , item.avgprice , item.claimablediscperc , item.taxable INTO :ls_fullcode, :ls_name, :ld_saleprice, :ll_packunits, :li_gcode, :ld_discperc, :ld_discperc2, :ld_discperc3, :ld_discperc4, :ld_discperc5, :ld_gstperc1, :ld_gstperc2, :ld_unitsalestax, :ls_packingdesc, :ll_piecesinhand, :ls_remarks, :ld_alternatepurprice, :ld_commissionperunit, :ld_commissionperc, :ld_avgprice, :ld_claimablediscperc, :lc_taxable FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = 0 then
		li_custcode = this.id_master.getitemnumber(1, "custcode")
		if isnull(li_custcode) then
			retflag = -1
			as_errortext = "Please Select a Valid Customer."
			return retflag
		end if
		if this.il_godowncount = 1 and this.il_strategy = 1 then
			li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
		else
			if this.il_strategy = 2 then
				li_gcode = li_gcode
			end if
			if this.il_strategy = 1 then
				li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
			end if
		end if
		SQL SELECT defaultGST , DefaultItemDiscPerc , TaxPerc =( SELECT TC.TaxPerc FROM TaxCategory TC WHERE TC.TaxCategoryCode =Customer.TaxCategoryCode ) INTO :li_defaultgst, :ld_defaultitemdiscperc, :ld_taxperc FROM customer WHERE customer.custcode =:li_custcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
			if this.it_transobject.sqlcode = 0 then
				ls_alternatecustomicode = this.id_detail.object.alternatecustomicode[al_row]
				if isnull(ls_alternatecustomicode) then
					ls_alternatecustomicode = ""
				end if
				if lower(ls_fullcode) = lower(ls_alternatecustomicode) then
					ls_alternatecustomicode = ls_null
					this.id_detail.object.alternatecustomicode[al_row] = ls_null
				end if
				this.id_detail.setitem(al_row, "gcode", li_gcode)
				this.id_detail.setitem(al_row, "icode", al_icode)
				this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
				this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
				if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) or this.ib_applyalternatealiasprice = false then
					this.id_detail.setitem(al_row, "srprice", ld_saleprice / ll_packunits)
					this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packunits", ll_packunits)
				if ld_defaultitemdiscperc = 1.0 then
					this.id_detail.setitem(al_row, "discperc", ld_discperc)
				elseif ld_defaultitemdiscperc = 2.0 then
					this.id_detail.setitem(al_row, "discperc", ld_discperc2)
				elseif ld_defaultitemdiscperc = 3.0 then
					this.id_detail.setitem(al_row, "discperc", ld_discperc3)
				elseif ld_defaultitemdiscperc = 4.0 then
					this.id_detail.setitem(al_row, "discperc", ld_discperc4)
				elseif ld_defaultitemdiscperc = 5.0 then
					this.id_detail.setitem(al_row, "discperc", ld_discperc5)
				end if
				this.id_detail.setitem(al_row, "packingdesc", ls_packingdesc)
				this.id_detail.setitem(al_row, "stock", ld_godownstock)
				this.id_detail.setitem(al_row, "piecesinhand", ll_piecesinhand)
				this.id_detail.setitem(al_row, "alternatepurprice", ld_alternatepurprice)
				this.id_detail.setitem(al_row, "commissionperunit", ld_commissionperunit)
				this.id_detail.setitem(al_row, "commissionperc", ld_commissionperc)
				this.id_detail.setitem(al_row, "claimablediscperc", ld_claimablediscperc)
				this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
				this.id_detail.setitem(al_row, "taxable", lc_taxable)
				if f_stringpreferences("sr_copyremarksinitemdesc") = "Y" and this.id_detail.getitemstatus(al_row, "returnitemdescription", primary!) = notmodified! then
					this.id_detail.setitem(al_row, "returnitemdescription", ls_remarks)
				end if
				this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
				if li_defaultgst = 2 then
					this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
				else
					this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
				end if
				this.id_footer.setitem(1, "stock", ld_godownstock)
				this.id_detail.setitem(1, "piecesinhand", ll_piecesinhand)
				if this.ic_advancetaxonsale = "Y" and lc_taxable = "Y" then
					this.id_detail.object.itemadvancetaxperc[al_row] = ld_taxperc
				else
					this.id_detail.object.itemadvancetaxperc[al_row] = 0.00
				end if
				if f_stringpreferences("FetchLatestItemSalesInfo") = "Y" then
					wf_fetch_latest_itemsalesinfo(al_row, al_icode)
				end if
			else
				retflag = -1
				as_errortext = "Database Error: Item Stock information can not be retrieved"
			end if
		else
			retflag = -1
			as_errortext = "Database Error: Item information can not be retrieved"
		end if
	else
		retflag = -1
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	return retflag

// w_salereturn.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	long ll_icode
	long ll_retflag
	long ll_rowid
	string ls_itemname
	if not this.ib_opensalereturn then
		ll_rowid = this.id_itemslist.find("fullcode = '" + as_fullcode + "'", 1, this.id_itemslist.rowcount())
		if ll_rowid > 0 and ll_rowid <= this.id_itemslist.rowcount() then
			al_icode = this.id_itemslist.getitemnumber(ll_rowid, "icode")
			al_itemname = this.id_itemslist.getitemstring(ll_rowid, "itemname")
			this.id_itemslist.setrow(ll_rowid)
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		if f_stringpreferences("GroupCategoryRights") = "Y" then
			SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
		else
			SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
		end if
		if this.it_transobject.sqlcode = 0 then
			al_icode = ll_icode
			al_itemname = ls_itemname
			if isnull(al_icode) then
				ll_retflag = 0
			else
				ll_retflag = 1
			end if
		else
			ll_retflag = -1
		end if
	end if
	return ll_retflag

// w_salereturn.wf_allowreturnmodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM SRDetail WHERE SRInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_salereturn.wf_setamountoninvoice() returns 0
	long ll_null
	long ll_rightfound
	double ld_netamt
	double ld_null
	string ls_null
	s_amountoninvoice lstr_amountoninvoice
	setnull(ld_null)
	setnull(ls_null)
	setnull(ll_null)
	if this.ii_salerettype <> 8 then
		if f_stringpreferences("askmastercashwin_in_crsr") = "Y" then
			return
		end if
		if this.id_master.getitemstring(1, "accountfor") = "Y" then
			ld_netamt = wf_grandtotal()
			if f_stringpreferences("AskAmtOnCreditSaleReturn") = "Y" then
				ll_rightfound = 0
				ll_rightfound = gds_securitywindow.find("rightcode = 583", 1, gds_securitywindow.rowcount())
				lstr_amountoninvoice.l_invcode = this.id_master.getitemnumber(1, "code")
				lstr_amountoninvoice.d_netamt = ld_netamt
				lstr_amountoninvoice.d_amt = this.id_master.getitemdecimal(1, "amt")
				if isnull(lstr_amountoninvoice.d_amt) then
					lstr_amountoninvoice.d_balance = ld_netamt
				else
					lstr_amountoninvoice.d_balance = ld_netamt - lstr_amountoninvoice.d_amt
				end if
				if isnull(this.id_master.getitemstring(1, "paymentmode")) then
					this.id_master.setitem(1, "paymentmode", f_stringpreferences("SaleReturnPaymentMode"))
					this.id_master.setitem(1, "paymentacccode", f_numberpreferences("SaleReturnPaymentAcccode"))
				end if
				lstr_amountoninvoice.c_paymentmode = this.id_master.getitemstring(1, "paymentmode")
				lstr_amountoninvoice.i_acccode = this.id_master.getitemnumber(1, "paymentacccode")
				lstr_amountoninvoice.s_reference = this.id_master.getitemstring(1, "amtreference")
				lstr_amountoninvoice.s_module = "salereturn"
				if ll_rightfound > 0 then
					openwithparm(w_amountoninvoice, lstr_amountoninvoice)
					lstr_amountoninvoice = message.powerobjectparm
					this.id_master.setitem(1, "amt", lstr_amountoninvoice.d_amt)
					this.id_master.setitem(1, "paymentmode", lstr_amountoninvoice.c_paymentmode)
					this.id_master.setitem(1, "paymentacccode", lstr_amountoninvoice.i_acccode)
					this.id_master.setitem(1, "amtreference", lstr_amountoninvoice.s_reference)
				end if
				if ld_netamt - lstr_amountoninvoice.d_amt >= 0.0 then
					this.id_master.setitem(1, "outstandingamt", ld_netamt - lstr_amountoninvoice.d_amt)
				else
					this.id_master.setitem(1, "outstandingamt", 0)
				end if
			else
				this.id_master.setitem(1, "outstandingamt", ld_netamt)
				this.id_master.setitem(1, "paymentmode", ls_null)
				this.id_master.setitem(1, "paymentacccode", ll_null)
				this.id_master.setitem(1, "amtreference", ls_null)
				this.id_master.setitem(1, "amt", 0)
			end if
		else
			this.id_master.setitem(1, "outstandingamt", 0)
			this.id_master.setitem(1, "paymentmode", ls_null)
			this.id_master.setitem(1, "paymentacccode", ll_null)
			this.id_master.setitem(1, "amtreference", ls_null)
			this.id_master.setitem(1, "amt", 0)
		end if
		return
	end if
	this.id_master.setitem(1, "amt", 0)
	this.id_master.setitem(1, "paymentmode", ls_null)
	this.id_master.setitem(1, "paymentacccode", ll_null)
	this.id_master.setitem(1, "amtreference", ls_null)
	this.id_master.setitem(1, "outstandingamt", 0)

// w_salereturn.wf_find_header_no(long al_saleinvcode) returns integer
	integer li_header_no
	SQL SELECT SaleLedger.headerno INTO :li_header_no FROM SaleLedger WHERE SaleLedger.Saleinvcode =:al_saleinvcode USING this.it_transobject;
	return li_header_no

// w_salereturn.wf_validateheader(long al_headercode) returns boolean
	long ll_headerno
	boolean lb_ok
	SQL SELECT HeaderCode INTO :ll_headerno FROM GroupAllowedHeader WHERE HeaderCode =:al_headercode AND GroupCode =:this.il_groupcode AND Module =:this.ii_module USING sqlca;
	if sqlca.sqlcode = 0 then
		if ll_headerno > 0 then
			lb_ok = true
		else
			lb_ok = false
		end if
	else
		lb_ok = false
	end if
	return lb_ok

// w_salereturn.wf_setsaleinvinfo(long al_saleinvcode, long al_custcode) returns 0
	long ll_salecatcode
	long ll_row
	long ll_smancode
	long ll_patientcode
	long ll_guestcode
	long ll_studentcode
	long ll_admissioncode
	long ll_currencycode
	long ll_motorvehiclecode
	double ld_invdiscperc
	double ld_invgstperc1
	double ld_flatdisc
	double ld_misccharges
	double ld_conversionrate
	datetime ld_date
	string ls_regno
	SQL SELECT saleledger.custcode , saleledger.date , saleledger.salecatcode , saleledger.smancode , saleledger.patientcode , admissioncode , discperc , saleledger.invgstperc1 , saleledger.flatdisc , saleledger.misccharges , saleledger.guestcode , saleledger.studentcode , saleledger.CurrencyCode , saleledger.ConversionRate , saleledger.motorvehiclecode INTO :al_custcode, :ld_date, :ll_salecatcode, :ll_smancode, :ll_patientcode, :ll_admissioncode, :ld_invdiscperc, :ld_invgstperc1, :ld_flatdisc, :ld_misccharges, :ll_guestcode, :ll_studentcode, :ll_currencycode, :ld_conversionrate, :ll_motorvehiclecode FROM saleledger WHERE saleledger.saleinvcode =:al_saleinvcode USING this.it_transobject;
	ll_row = this.id_master.getrow()
	this.id_master.object.saleinvdate[ll_row] = ld_date
	this.id_master.object.custcode[ll_row] = al_custcode
	this.id_master.object.smancode[ll_row] = ll_smancode
	this.id_master.object.patientcode[ll_row] = ll_patientcode
	this.id_master.object.guestcode[ll_row] = ll_guestcode
	this.id_master.object.studentcode[ll_row] = ll_studentcode
	this.id_master.object.motorvehiclecode[ll_row] = ll_motorvehiclecode
	this.id_master.object.currencycode[ll_row] = ll_currencycode
	this.id_master.object.conversionrate[ll_row] = ld_conversionrate
	this.id_footer.object.discperc[ll_row] = ld_invdiscperc
	this.id_footer.object.flatdisc[ll_row] = ld_flatdisc
	this.id_footer.object.invgstperc1[ll_row] = ld_invgstperc1
	this.id_footer.object.currencycode[ll_row] = ll_currencycode
	this.id_footer.object.conversionrate[ll_row] = ld_conversionrate
	if not isnull(ll_patientcode) then
		SQL SELECT regno INTO :ls_regno FROM Patient WHERE patientcode =:ll_patientcode USING this.it_transobject;
		this.id_master.object.patientregno[ll_row] = ls_regno
	end if
	if not isnull(ll_guestcode) then
		SQL SELECT regno INTO :ls_regno FROM guest WHERE guestcode =:ll_guestcode USING this.it_transobject;
		this.id_master.object.guestregno[ll_row] = ls_regno
	end if
	if not isnull(ll_studentcode) then
		SQL SELECT regno INTO :ls_regno FROM student WHERE studentcode =:ll_studentcode USING this.it_transobject;
		this.id_master.object.studentregno[ll_row] = ls_regno
	end if
	if not isnull(ll_motorvehiclecode) then
		SQL SELECT chasisno INTO :ls_regno FROM motorvehicle WHERE motorvehiclecode =:ll_motorvehiclecode USING this.it_transobject;
		this.id_master.object.chasisno[ll_row] = ls_regno
	end if

// w_salereturn.wf_validatesaleinvcode(long al_row, long al_saleinvcode) returns integer
	long ll_detailrows
	long ll_custcode
	long ll_smancode
	integer li_rtcode
	integer li_result
	integer li_header_no
	datetime ld_datetime
	boolean lb_rtflag
	string ls_errtext
	string ls_batch
	dwitemstatus lrs_status
	if not isnull(al_saleinvcode) and al_saleinvcode > 0 then
		li_header_no = wf_find_header_no(al_saleinvcode)
		if wf_validateheader(li_header_no) = true then
			this.id_master.setitem(al_row, "headerno", li_header_no)
		else
			ls_errtext = "Your Header Settings Do not Allow this return~r~nContact Your Systems Administrator for help"
			li_rtcode = 1
		end if
		if li_rtcode = 0 then
			this.im_menu.m_file.m_options.enabled = true
			ll_detailrows = this.id_detail.rowcount()
			if ll_detailrows > 0 then
				lrs_status = this.id_detail.getitemstatus(1, 0, primary!)
				if lrs_status <> new! and not isnull(this.id_detail.getitemnumber(1, "icode")) then
					li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
					if li_result = 2 then
						li_rtcode = 2
					else
						this.id_detail.setredraw(false)
						this.id_detail.reset()
						this.id_detail.insertrow(0)
						this.id_detail.setfocus()
						this.id_detail.setredraw(true)
					end if
				end if
			end if
		end if
		if li_rtcode = 0 then
			if this.ii_salerettype = 8 then
				li_rtcode = wf_findretailsaleinvoice(al_saleinvcode, ld_datetime, ls_errtext)
			else
				li_rtcode = wf_findwholesaleinvoice(al_saleinvcode, ld_datetime, ls_errtext)
			end if
			if li_rtcode = 0 then
				li_rtcode = wf_findunpostedsalereturns(al_saleinvcode, ls_errtext)
				if li_rtcode = 0 then
					li_rtcode = wf_locksaleinvoice(al_saleinvcode)
					if li_rtcode = 0 then
						this.id_detail.setredraw(false)
						wf_setsaleinvinfo(al_saleinvcode, ll_custcode)
						wf_setfooterinfo(al_saleinvcode)
						wf_customerinfo(ll_custcode)
						wf_customername(ll_custcode)
						this.id_master.setitem(1, "saleinvdate", ld_datetime)
						this.id_master.setitem(this.id_master.getrow(), "headerno", li_header_no)
						this.idc_itemdddw.retrieve(al_saleinvcode)
						this.id_detail.setredraw(true)
						this.ids_saleinv.retrieve(al_saleinvcode)
						this.ids_saleinv.sharedata(this.id_itemslist)
					else
						li_rtcode = 1
					end if
				else
					li_rtcode = 1
				end if
			else
				li_rtcode = 1
			end if
		end if
	else
		li_rtcode = 1
	end if
	if li_rtcode = 1 then
		messagebox("Sale Invoice validation", ls_errtext)
	end if
	return li_rtcode

// w_salereturn.wf_validateitem() returns integer
	long ll_icode
	long ll_dddwrow
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_null
	string ls_null
	if not this.ib_opensalereturn then
		ll_dddwrow = this.id_itemslist.getrow()
		if wf_inititeminfo(this.idc_itemdddw, this.il_currrow, ll_dddwrow, ls_errtext) <> 0 then
			ls_titleerrtext = "Item Validation"
			li_errcode = -1
		end if
	else
		ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
		if wf_inititeminfo(ll_icode, this.il_currrow, ls_errtext) <> 0 then
			ls_titleerrtext = "Item Validation"
			li_errcode = -1
		end if
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		if f_stringpreferences("ItemCode") = "N" then
			this.id_detail.setcolumn(this.is_columnitemname)
		else
			this.id_detail.setcolumn("fullCode")
		end if
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.setitem(this.il_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(this.il_currrow, "fullcode", ls_null)
		messagebox(ls_titleerrtext, ls_errtext)
	end if
	return li_errcode

// w_salereturn.wf_inititeminfo(datawindowchild adc_itemdddw, long al_row, long al_dddwrow, string as_errtext) returns integer
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_saleinvcode
	long ll_salerowid
	long ll_totalpieces
	long ll_piecesinhand
	double ld_saleprice
	double ld_discperc
	double ld_unitsalestax
	double ld_gstperc
	double ld_basicdatasaleprice
	double ld_alternatepurprice
	double ld_claimablediscperc
	double ld_itemadvancetaxperc
	string ls_fullcode
	string ls_batch
	string ls_itemname
	string ls_remarks
	string ls_alternatecustomicode
	string ls_null
	string ls_claimable
	char lc_taxable
	datetime ld_expiry
	integer li_errcode
	double ld_commissionperc
	double ld_avgprice
	double ld_commissionperunit
	double ld_stock
	double ld_retableqty
	double ld_itemprevqty
	double ld_itemsaleqty
	double ld_itemsalebonusqty
	double ld_retablebonusqty
	double ld_itemprevbonusqty
	double ld_itemprevqty_oncurrentinv
	double ld_itemprevbonusqty_oncurrentinv
	setnull(ls_null)
	ll_saleinvcode = this.id_master.getitemnumber(this.id_master.getrow(), "saleinvcode")
	if ll_saleinvcode > 0 then
		ll_icode = this.id_itemslist.getitemnumber(al_dddwrow, "icode")
		SQL SELECT saleprice , packunits , totalpieces , remarks , alternatepurprice , taxable INTO :ld_basicdatasaleprice, :ll_packunits, :ll_piecesinhand, :ls_remarks, :ld_alternatepurprice, :lc_taxable FROM Item WHERE icode =:ll_icode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			ll_gcode = this.id_itemslist.getitemnumber(al_dddwrow, "gcode")
			ll_icode = this.id_itemslist.getitemnumber(al_dddwrow, "icode")
			ls_fullcode = this.id_itemslist.getitemstring(al_dddwrow, "fullcode")
			ls_alternatecustomicode = this.id_itemslist.getitemstring(al_dddwrow, "alternatecustomicode")
			ls_batch = this.id_itemslist.getitemstring(al_dddwrow, "batch")
			ld_expiry = this.id_itemslist.getitemdatetime(al_dddwrow, "Expiry")
			ld_saleprice = this.id_itemslist.getitemnumber(al_dddwrow, "saleprice")
			ld_discperc = this.id_itemslist.getitemnumber(al_dddwrow, "discperc")
			ll_salerowid = this.id_itemslist.getitemnumber(al_dddwrow, "salerowid")
			ll_totalpieces = this.id_itemslist.getitemnumber(al_dddwrow, "totalpieces")
			ld_avgprice = this.id_itemslist.getitemnumber(al_dddwrow, "avgprice")
			ld_unitsalestax = this.id_itemslist.getitemnumber(al_dddwrow, "unitsalestax")
			ld_gstperc = this.id_itemslist.getitemnumber(al_dddwrow, "gstperc")
			ld_commissionperunit = this.id_itemslist.getitemnumber(al_dddwrow, "commissionperunit")
			ld_commissionperc = this.id_itemslist.getitemnumber(al_dddwrow, "commissionperc")
			ls_itemname = this.id_itemslist.getitemstring(al_dddwrow, "itemname")
			ls_claimable = this.id_itemslist.getitemstring(al_dddwrow, "claimable")
			ld_claimablediscperc = this.id_itemslist.getitemnumber(al_dddwrow, "claimablediscperc")
			lc_taxable = this.id_itemslist.getitemstring(al_dddwrow, "taxable")
			ld_itemadvancetaxperc = this.id_itemslist.getitemnumber(al_dddwrow, "ItemAdvanceTaxPerc")
			if wf_itemprevretqty(ll_saleinvcode, ll_salerowid, ll_icode, ld_itemprevqty, ld_itemprevbonusqty) = 0 then
				wf_oninvoiceitemprevqty(al_row, ll_icode, ll_salerowid, ld_itemprevqty_oncurrentinv, ld_itemprevbonusqty_oncurrentinv, ls_batch, ld_expiry)
				ld_itemsaleqty = this.idc_itemdddw.getitemnumber(al_dddwrow, "looseqty")
				ld_retableqty = ld_itemsaleqty - ld_itemprevqty - ld_itemprevqty_oncurrentinv
				if f_stringpreferences("BonusinSale") = "Y" then
					ld_itemsalebonusqty = this.idc_itemdddw.getitemnumber(al_dddwrow, "Bonusqty")
					ld_retablebonusqty = ld_itemsalebonusqty - ld_itemprevbonusqty - ld_itemprevbonusqty_oncurrentinv
				end if
				if ld_retableqty > 0.0 or ld_retablebonusqty > 0.0 then
					if this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock) = 0 then
						if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
							ll_gcode = this.id_detail.getitemnumber(al_row, "gcode")
						end if
						this.id_detail.setitem(al_row, "gcode", ll_gcode)
						this.id_detail.setitem(al_row, "icode", ll_icode)
						this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
						this.id_detail.setitem(al_row, "alternatecustomicode", ls_alternatecustomicode)
						this.id_detail.setitem(al_row, "batch", ls_batch)
						this.id_detail.setitem(al_row, "expiry", ld_expiry)
						this.id_detail.setitem(al_row, "srprice", ld_saleprice)
						this.id_detail.setitem(al_row, "discperc", ld_discperc)
						this.id_detail.setitem(al_row, "claimable", ls_claimable)
						this.id_detail.setitem(al_row, "claimablediscperc", ld_claimablediscperc)
						this.id_detail.setitem(al_row, "Bonusqty", ld_retablebonusqty)
						this.id_detail.setitem(al_row, "looseqty", ld_retableqty)
						this.id_detail.setitem(al_row, "retableqty", ld_retableqty)
						this.id_detail.setitem(al_row, "saleqty", ld_itemsaleqty)
						this.id_detail.setitem(al_row, "saleBonusqty", ld_itemsalebonusqty)
						this.id_detail.setitem(al_row, "retableBonusqty", ld_retablebonusqty)
						this.id_detail.setitem(al_row, "stock", ld_stock)
						this.id_detail.setitem(al_row, "packunits", ll_packunits)
						this.id_detail.setitem(al_row, "piecesinhand", ll_piecesinhand)
						this.id_detail.setitem(al_row, "alternatepurprice", ld_alternatepurprice)
						this.id_detail.setitem(al_row, "commissionperunit", ld_commissionperunit)
						this.id_detail.setitem(al_row, "commissionperc", ld_commissionperc)
						this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
						this.id_detail.setitem(al_row, "taxable", lc_taxable)
						this.id_detail.setitem(al_row, "ItemAdvanceTaxPerc", ld_itemadvancetaxperc)
						this.id_detail.setitem(al_row, "returnitemdescription", this.id_itemslist.getitemstring(al_dddwrow, "saleitemdesc"))
						if f_stringpreferences("sr_copyremarksinitemdesc") = "Y" and this.id_detail.getitemstatus(al_row, "returnitemdescription", primary!) = notmodified! then
							this.id_detail.setitem(al_row, "returnitemdescription", ls_remarks)
						end if
						this.id_detail.setitem(al_row, "itemname", ls_itemname)
						this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
						this.id_detail.setitem(al_row, "gstperc", ld_gstperc)
						this.id_detail.setitem(al_row, "salerowid", ll_salerowid)
						this.id_detail.setitem(al_row, "saleprice", ld_basicdatasaleprice / ll_packunits)
						this.id_footer.setitem(1, "retableqty", ld_retableqty)
						this.id_footer.setitem(1, "saleqty", ld_itemsaleqty)
						this.id_footer.setitem(1, "retablebonusqty", ld_retablebonusqty)
						this.id_footer.setitem(1, "salebonusqty", ld_itemsalebonusqty)
						this.id_footer.setitem(1, "stock", ld_stock)
						this.id_footer.setitem(1, "piecesinhand", ll_piecesinhand)
					else
						as_errtext = "Can not retrieve item stock information"
						li_errcode = -1
					end if
				else
					as_errtext = "item qty has already been returned"
					li_errcode = 1
				end if
			else
				li_errcode = -1
				as_errtext = "Sale invoice information can not retrieve"
			end if
		else
			li_errcode = -1
			as_errtext = "Unable To Get Item's Information"
		end if
	else
		li_errcode = -1
		as_errtext = "Please Select Valid Sale Invoice First, Unable To Get Item's Information"
	end if
	return li_errcode

// w_salereturn.wf_allocatesalereturn(long al_srinvcode, long al_saleinvcode, datetime adt_date, long al_usercode) returns long
	long ll_retcode
	long ll_srallocationcode
	long ll_code
	long ll_unpostedtrans
	long ll_null
	double ld_sale_balance
	double ld_sr_balance
	double ld_amt
	double ld_new_sale_balance
	double ld_new_sr_balance
	char ac_posted
	string ls_msg
	string ls_title
	setnull(ll_null)
	ac_posted = upper(f_stringpreferences("AutoPostSaleReturnAllocation"))
	ls_msg = "000                                                                                                                                 "
	ls_title = "Sale Return Allocation"
	ll_retcode = 1
	if this.ib_opensalereturn = false and this.ii_salerettype = 1 and f_stringpreferences("AutoSaleReturnAllocation") = "Y" then
		ll_retcode = -1
		SQL rollback USING this.it_transobject;
		this.it_transobject.locksrinvoice(al_srinvcode)
		if this.it_transobject.sqlcode = 0 then
			this.it_transobject.locksaleinvoice(al_saleinvcode)
			if this.it_transobject.sqlcode = 0 then
				this.it_transobject.checkunpostedsaleinvintransactions(al_saleinvcode, ll_null, "SR", ll_unpostedtrans, ls_msg)
				if this.it_transobject.sqlcode = 0 and ll_unpostedtrans <= 0 then
					this.it_transobject.getsrinvbalance(al_srinvcode, ld_sr_balance)
					if this.it_transobject.sqlcode = 0 and ld_sr_balance > 0.0 then
						this.it_transobject.getsaleinvbalance(al_saleinvcode, ld_sale_balance)
						if this.it_transobject.sqlcode = 0 and ld_sale_balance > 0.0 then
							if ld_sale_balance <= ld_sr_balance then
								ld_amt = ld_sale_balance
							else
								ld_amt = ld_sr_balance
							end if
							ld_new_sale_balance = ld_sale_balance - ld_amt
							ld_new_sr_balance = ld_sr_balance - ld_amt
							this.it_transobject.updatesrinvbalance(al_srinvcode, ld_new_sr_balance)
							if this.it_transobject.sqlcode = 0 then
								this.it_transobject.updatesaleinvbalance(al_saleinvcode, ld_new_sale_balance)
								if this.it_transobject.sqlcode = 0 then
									this.it_transobject.createsrallocation(al_srinvcode, al_saleinvcode, adt_date, al_usercode, ac_posted, adt_date, ld_sale_balance, ld_amt, ll_code)
									if ll_code > 0 then
										ll_retcode = 1
										SQL commit USING this.it_transobject;
										ls_msg = "Sale Return Successfully Allocated, Code : " + trim(string(ll_code))
										messagebox(ls_title, ls_msg)
									end if
								end if
							end if
						end if
					end if
				end if
			end if
		end if
	end if
	if ll_retcode = -1 then
		SQL rollback USING this.it_transobject;
		if ll_unpostedtrans > 0 then
			ls_msg = "Unposted Transaction(s) Exist for this Sale Invoice~r~n~r~n" + ls_msg
		else
			ls_msg = "Problem In Sale Return Allocation"
		end if
		messagebox(ls_title, ls_msg)
	end if
	return ll_retcode

// w_salereturn.wf_checkitemactiveness(long al_icode, string as_errtext, long al_count, long[] al_activeitemslist) returns long
	long ll_activestatus
	long ll_setactive
	ll_activestatus = this.it_transobject.isactiveitem(al_icode)
	if this.it_transobject.sqlcode = 0 then
		if ll_activestatus = -1 then
			as_errtext = "Problem in Fetching Item Active Status:~r~n" + this.it_transobject.sqlerrtext
			return -1
		elseif ll_activestatus = 0 then
			this.it_transobject.setitemactivestatus(al_icode, 1)
			if this.it_transobject.sqlcode <> 0 then
				as_errtext = "Problem in Fetching Item Active Status:~r~n" + this.it_transobject.sqlerrtext
				return -1
			else
				al_count = al_count + 1
				al_activeitemslist[al_count] = al_icode
			end if
		end if
	else
		as_errtext = "Problem in Fetching Item Active Status:~r~n" + this.it_transobject.sqlerrtext
		return -1
	end if
	return 0

// w_salereturn.wf_itemprevretqty(long al_saleinvcode, long al_gcode, long al_icode, string as_batch, datetime ad_expiry, double al_itemprevqty, double al_itemprevbonusqty) returns integer
	SQL SELECT IsNull ( Sum ( srdetail.looseqty ) , 0 ) , IsNull ( Sum ( srdetail.Bonusqty ) , 0 ) INTO :al_itemprevqty, :al_itemprevbonusqty FROM srledger , srdetail WHERE srledger.saleinvcode =:al_saleinvcode and srledger.posted ='Y' and srledger.srinvcode =srdetail.SRInvCode and srdetail.icode =:al_icode and srdetail.batch =:as_batch and srdetail.expiry =:ad_expiry USING this.it_transobject;
	if isnull(al_itemprevqty) then
		al_itemprevqty = 0
	end if
	if isnull(al_itemprevbonusqty) then
		al_itemprevbonusqty = 0
	end if
	return this.it_transobject.sqlcode

// w_salereturn.wf_itemprevretqty(long al_saleinvcode, long al_salerowid, long al_icode, double al_itemprevqty, double al_itemprevbonusqty) returns integer
	SQL SELECT IsNull ( Sum ( looseqty ) , 0 ) , IsNull ( Sum ( bonusqty ) , 0 ) INTO :al_itemprevqty, :al_itemprevbonusqty FROM SRLedger , SRDetail WHERE SRLedger.SaleInvCode =:al_saleinvcode And SRLedger.posted ='Y' And SRLedger.SRInvcode =SRDetail.SRInvCode And SRDetail.ICode =:al_icode And SRDetail.SaleRowId =:al_salerowid USING this.it_transobject;
	if isnull(al_itemprevqty) then
		al_itemprevqty = 0
	end if
	if isnull(al_itemprevbonusqty) then
		al_itemprevbonusqty = 0
	end if
	return this.it_transobject.sqlcode

// w_salereturn.wf_validatebonusqty(long al_row, double al_bonusqty) returns integer
	integer li_rtcode
	long ll_icode
	long ll_salerowid
	string ls_batch
	datetime ld_expiry
	double ld_itemprevqty
	double ld_itemprevbonusqty
	double ld_retablebonusqty
	ld_retablebonusqty = this.id_detail.getitemnumber(al_row, "retablebonusqty")
	if not this.ib_opensalereturn then
		ll_icode = this.id_detail.getitemnumber(al_row, "icode")
		ll_salerowid = this.id_detail.getitemnumber(al_row, "salerowid")
		ls_batch = this.id_detail.getitemstring(al_row, "batch")
		ld_expiry = this.id_detail.getitemdatetime(al_row, "expiry")
		wf_oninvoiceitemprevqty(al_row, ll_icode, ll_salerowid, ld_itemprevqty, ld_itemprevbonusqty, ls_batch, ld_expiry)
		if al_bonusqty + ld_itemprevbonusqty > ld_retablebonusqty then
			li_rtcode = 1
			messagebox("Bonus Qty Validation", "    Bonus Qty Should Not Exceed From " + string(ld_retablebonusqty))
		end if
	end if
	return li_rtcode

// w_salereturn.wf_oninvoiceitemprevqty(long al_row, long al_icode, long al_salerowid, double al_itemprevqty, double al_itemprevbonusqty, string as_batch, datetime ad_expiry) returns integer
	long ll_counter
	long ll_rowcount
	long ll_icode
	long ll_salerowid
	string ls_batch
	datetime ld_expiry
	double ld_holdqty
	double ld_holdbonusqty
	ll_rowcount = this.id_detail.rowcount()
	for ll_counter = 1 to al_row - 1
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		ll_salerowid = this.id_detail.getitemnumber(ll_counter, "salerowid")
		ls_batch = this.id_detail.getitemstring(ll_counter, "batch")
		ld_expiry = this.id_detail.getitemdatetime(ll_counter, "expiry")
		if ll_icode = al_icode and ll_salerowid = al_salerowid and ls_batch = as_batch and ld_expiry = ad_expiry then
			ld_holdqty = ld_holdqty + this.id_detail.getitemnumber(ll_counter, "looseqty")
			ld_holdbonusqty = ld_holdbonusqty + this.id_detail.getitemnumber(ll_counter, "bonusqty")
		end if
	next
	for ll_counter = al_row + 1 to ll_rowcount
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		ll_salerowid = this.id_detail.getitemnumber(ll_counter, "salerowid")
		ls_batch = this.id_detail.getitemstring(ll_counter, "batch")
		ld_expiry = this.id_detail.getitemdatetime(ll_counter, "expiry")
		if ll_icode = al_icode and ll_salerowid = al_salerowid and ls_batch = as_batch and ld_expiry = ad_expiry then
			ld_holdqty = ld_holdqty + this.id_detail.getitemnumber(ll_counter, "looseqty")
			ld_holdbonusqty = ld_holdbonusqty + this.id_detail.getitemnumber(ll_counter, "bonusqty")
		end if
	next
	al_itemprevqty = ld_holdqty
	al_itemprevbonusqty = ld_holdbonusqty
	return 0

// w_salereturn.wf_validateqty(long al_row, double al_qty) returns integer
	integer li_rtcode
	long ll_icode
	long ll_salerowid
	datetime ld_expiry
	string ls_batch
	double ld_retableqty
	double ld_itemprevqty
	double ld_itemprevbonusqty
	ld_retableqty = this.id_detail.getitemnumber(al_row, "retableqty")
	if not this.ib_opensalereturn then
		ll_icode = this.id_detail.getitemnumber(al_row, "icode")
		ll_salerowid = this.id_detail.getitemnumber(al_row, "salerowid")
		ld_expiry = this.id_detail.getitemdatetime(al_row, "expiry")
		ls_batch = this.id_detail.getitemstring(al_row, "batch")
		wf_oninvoiceitemprevqty(al_row, ll_icode, ll_salerowid, ld_itemprevqty, ld_itemprevbonusqty, ls_batch, ld_expiry)
		if al_qty + ld_itemprevqty > ld_retableqty then
			li_rtcode = 1
			messagebox("Quantity Validation", "    Qty Should be less than " + string(ld_retableqty))
		end if
	end if
	return li_rtcode

// w_salereturn.wf_patient_retrieve() returns long
	long ll_prow
	long ll_pcode
	if this.ib_opensalereturn then
		this.idc_patient.retrieve(this.ii_module)
	else
		this.idc_patient.retrieve()
	end if
	ll_prow = this.idc_patient.insertrow(0)
	setnull(ll_pcode)
	this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
	this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
	this.idc_patient.setitem(ll_prow, "name", "<NONE>")
	this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
	this.idc_patient.scrolltorow(ll_prow)
	return 0

// w_salereturn.wf_getrecentexpiry(long al_icode, string as_batch, long al_row) returns long
	datetime ldt_expiry
	SQL SELECT Expiry INTO :ldt_expiry FROM DBO.PurDetail WHERE ICode =:al_icode AND Batch =:as_batch AND PurUtn IN ( SELECT PurUtn =MAX ( D.PurUtn ) FROM Dbo.PurDetail D WHERE D.ICode =:al_icode AND D.Batch =:as_batch ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_detail.setitem(al_row, "expiry", ldt_expiry)
	end if
	return 0

// w_salereturn.wf_post_salereturn(integer ai_postingmode, long al_startinginvcode, long al_endinginvcode) returns integer
	integer li_errcode
	long ll_detailrows
	long ll_masterrows
	long ll_gcode
	long ll_icode
	long ll_errrowid
	long ll_salesmancode
	long ll_outercounter
	long ll_innercounter
	long ll_masterinvcode
	long ll_detailinvcode
	long ll_totalpieces
	long ll_piecesinhand
	long ll_saleinvcode
	long ll_rowid
	double ld_stock
	double ld_newstock
	double ld_qty
	double ld_bonusqty
	double ld_totalstock
	double ld_avgprice
	double ld_netprice
	double ld_newavgprice
	string ls_batch
	string ls_errtext
	datetime ld_expiry
	datastore lds_master
	datastore lds_detail
	s_arguements lstr_arginfo
	if ai_postingmode = 1 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if ai_postingmode = 1 then
			open(w_arg_sinvcode_linvcode)
			lstr_arginfo = message.powerobjectparm
		else
			lstr_arginfo.l_code1 = al_startinginvcode
			lstr_arginfo.l_code2 = al_endinginvcode
			lstr_arginfo.i_status = 1
		end if
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING this.it_transobject;
			li_errcode = wf_locksrinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
			if li_errcode = 0 then
				lds_master = create datastore
				lds_detail = create datastore
				lds_master.dataobject = "d_srpostinvheaders"
				lds_detail.dataobject = "d_srpostinvdetail"
				lds_master.settransobject(this.it_transobject)
				lds_detail.settransobject(this.it_transobject)
				lds_master.retrieve(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
				lds_detail.retrieve(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
				ls_errtext = "Some database request fails        "
				ll_masterrows = lds_master.rowcount()
				ll_detailrows = lds_detail.rowcount()
				ll_outercounter = 1
				ll_innercounter = 1
				do while ll_outercounter <= ll_masterrows and li_errcode = 0
					ll_masterinvcode = lds_master.getitemnumber(ll_outercounter, "srinvcode")
					ll_detailinvcode = lds_detail.getitemnumber(ll_innercounter, "srinvcode")
					ll_saleinvcode = lds_detail.getitemnumber(ll_innercounter, "saleinvcode")
					do while ll_innercounter <= ll_detailrows and ll_masterinvcode = ll_detailinvcode and li_errcode = 0
						ll_gcode = lds_detail.getitemnumber(ll_innercounter, "gcode")
						ll_icode = lds_detail.getitemnumber(ll_innercounter, "icode")
						ls_batch = lds_detail.getitemstring(ll_innercounter, "batch")
						ld_expiry = lds_detail.getitemdatetime(ll_innercounter, "expiry")
						ll_totalpieces = lds_detail.getitemnumber(ll_innercounter, "totalpieces")
						ll_piecesinhand = lds_detail.getitemnumber(ll_innercounter, "piecesinhand")
						ld_avgprice = lds_detail.getitemnumber(ll_innercounter, "avgprice")
						ld_netprice = lds_detail.getitemnumber(ll_innercounter, "netprice")
						ld_qty = lds_detail.getitemnumber(ll_innercounter, "looseqty")
						ld_bonusqty = lds_detail.getitemnumber(ll_innercounter, "bonusqty")
						this.it_transobject.getitemstockall(ll_icode, ld_totalstock)
						if this.it_transobject.sqlcode <> 0 then
							li_errcode = -1
						end if
						if isnull(ld_totalstock) then
							ld_totalstock = 0
						end if
						if ll_saleinvcode <= 0 then
							this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
							if this.it_transobject.sqlcode <> 0 then
								li_errcode = -1
							end if
						end if
						this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
						if this.it_transobject.sqlcode = 0 then
							ld_newstock = ld_stock + ld_qty + ld_bonusqty
							this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
							if this.it_transobject.sqlcode <> 0 then
								li_errcode = -1
							end if
						else
							li_errcode = -1
						end if
						if ld_totalstock + ld_qty + ld_bonusqty > 0.0 then
							ld_newavgprice = (ld_totalstock * ld_avgprice + ld_netprice * ld_qty) / (ld_totalstock + ld_qty + ld_bonusqty)
						else
							ld_newavgprice = ld_totalstock * ld_avgprice + ld_netprice * ld_qty
						end if
						SQL update SRDetail SET AvgPrice =:ld_avgprice , NewAvgPrice =ld_newavgprice WHERE rowid =:ll_rowid USING this.it_transobject;
						if this.it_transobject.sqlcode <> 0 then
							li_errcode = -1
						end if
						this.it_transobject.getitemtotalpiecesinhand(ll_icode, ll_piecesinhand)
						if this.it_transobject.sqlcode <> 0 then
							li_errcode = -1
						else
							this.id_detail.setitem(ll_innercounter, "piecesinhand", ll_piecesinhand)
							this.it_transobject.updateitemtotalpiecesinhand(ll_icode, 1, ll_totalpieces)
							if this.it_transobject.sqlcode <> 0 then
								li_errcode = -1
							end if
						end if
						ll_innercounter = ll_innercounter + 1
						if ll_innercounter <= ll_detailrows then
							ll_detailinvcode = lds_detail.getitemnumber(ll_innercounter, "srinvcode")
						end if
					loop
					if li_errcode = 0 then
						this.it_transobject.postsrledger(ll_masterinvcode)
						if this.it_transobject.sqlcode <> 0 then
							li_errcode = -1
							ll_errrowid = ll_outercounter
						elseif f_stringpreferences("ApplyLoyaltypolicyonsaleposting") = "Y" then
							this.it_transobject.manageloyaltypoints("SR", ll_masterinvcode)
							if this.it_transobject.sqlcode <> 0 then
								ls_errtext = "Problem in updating loyalty points for S/R Invoice No.:" + trim(string(ll_masterinvcode)) + ".~r~nReasons are:- " + this.it_transobject.sqlerrtext
								SQL rollback USING this.it_transobject;
								messagebox("Loyalty Points Updation", ls_errtext)
							end if
						end if
					else
						ll_errrowid = ll_outercounter
					end if
					ll_outercounter = ll_outercounter + 1
				loop
				destroy lds_master
				destroy lds_detail
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING this.it_transobject;
			ll_errrowid = ll_outercounter
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if li_errcode <> 0 then
		messagebox("Posting Fails", ls_errtext + "~n~rin invoice number" + string(lds_master.getitemnumber(ll_errrowid, "srinvcode")))
	else
		messagebox("Posting Successfull", "Total unposted rows were " + string(ll_masterrows) + "~n~rAll rows have been posted successfully")
	end if
	return li_errcode

// w_salereturn.wf_saveandpost() returns 0
	integer li_postingmode
	long ll_sinvcode
	long ll_linvcode
	long ll_retcode
	boolean lb_commitflag
	if not wf_iseditable() then
		return
	end if
	event ue_save()
	if this.ib_commitok then
		ll_sinvcode = this.id_master.getitemnumber(1, "code")
		ll_linvcode = this.id_master.getitemnumber(1, "code")
		if isnull(ll_sinvcode) or isnull(ll_linvcode) or ll_sinvcode < 0 and ll_linvcode < 0 then
			return
		else
			ll_retcode = wf_post_salereturn(li_postingmode, ll_sinvcode, ll_linvcode)
		end if
	end if
	setpointer(arrow!)

// w_salereturn.wf_set_itemtotal_formatmask() returns long
	string ls_modify
	string ls_format
	ls_format = trim(f_stringpreferences("FormatForAmtInSRet"))
	ls_modify = "c_itemtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_detaildwtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_finalitemval.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_sumfinalitemval.Format='" + ls_format + "'  "
	this.id_detail.modify(ls_modify)
	return 0

// w_salereturn.wf_issuebased_batchreturn() returns long
	s_arguements lstr_arg
	long ll_tobeinserted
	long ll_row
	long ll_counter
	long ll_seq
	long ll_insertcount
	long ll_custcode
	string ls_errortext
	double ld_returnableqty
	if this.ib_opensalereturn = false then
		return 0
	end if
	if this.tab_retrieve.selectedtab = 2 then
		return 0
	end if
	if wf_iseditable() = false then
		return 0
	end if
	ll_custcode = this.id_master.object.custcode[1]
	if isnull(ll_custcode) or ll_custcode <= 0 then
		messagebox("Customer Validation!", "Please select a valid customer first")
		return -1
	end if
	open(w_arg_item_batch_salereturn_issuebased)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		if this.id_detail.rowcount() > 0 and isnull(this.id_detail.object.icode[this.id_detail.rowcount()]) then
			this.id_detail.setrow(this.id_detail.rowcount())
			this.id_detail.scrolltorow(this.id_detail.rowcount())
			triggerevent("ue_deleteitem")
		end if
		if lstr_arg.l_code1 <= 0 then
			return -1
		end if
		if lstr_arg.l_code2 <= 0 then
			return -1
		end if
		ll_row = this.id_detail.insertrow(0)
		if ll_row > 0 then
			sqlca.batchwisesalereturn_issuebased(lstr_arg.l_code1, lstr_arg.s_name1, lstr_arg.d_sdate, ld_returnableqty)
			if sqlca.sqlcode = 0 then
				if ld_returnableqty > 0.0 then
					if lstr_arg.l_code2 > ld_returnableqty then
						messagebox("Returnable Qty Validation!", "Return Qty is more than allowed qty for this batch. Please enter some valid qty.")
						return -1
					end if
				else
					messagebox("Returnable Qty Validation!", "Batch is already returned. Please enter some other batch, expiry and qty.")
					return -1
				end if
			else
				messagebox("Database Error", "Some Problem Occurred at database, Possible Reasons are:-~r~n" + sqlca.sqlerrtext)
				return -1
			end if
			if wf_inititeminfo(lstr_arg.l_code1, ll_row, ls_errortext) = 0 then
				this.id_detail.object.batch[ll_row] = lstr_arg.s_name1
				this.id_detail.object.looseqty[ll_row] = lstr_arg.l_code2
				this.id_detail.object.expiry[ll_row] = date(lstr_arg.d_sdate)
				if wf_duplicaterow(ll_row) then
					this.id_detail.setrow(ll_row)
					triggerevent("ue_deleteitem")
				else
					ll_insertcount = ll_insertcount + 1
				end if
			end if
		end if
	end if
	if this.id_detail.rowcount() > 0 then
		this.im_menu.m_file.m_save.enabled = true
	end if
	if ll_insertcount > 0 then
		wf_saveandpost()
		if wf_commitform() = true then
			triggerevent("ue_new")
		end if
	end if
	return 0

