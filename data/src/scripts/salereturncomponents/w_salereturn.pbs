				this.id_master.object.studentcode.visible = false
				this.id_master.object.studentregno.visible = false
				this.id_master.object.studentregno_t.visible = false
				this.id_master.object.studentcode_t.visible = false
			end if
			if f_stringpreferences("GuestOnCashSale") <> "H" then
				this.id_master.object.guestcode.visible = false
				this.id_master.object.guestregno.visible = false
				this.id_master.object.guestcode_t.visible = false
				this.id_master.object.guestregno_t.visible = false
			end if
		end choose
		this.id_detail.object.batch.initial = f_stringpreferences("defaultbatch")
		this.id_detail.object.expiry.initial = string(f_datepreferences("defaultexpiry"))
	end if
