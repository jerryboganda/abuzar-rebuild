	this.idc_student.settransobject(this.it_transobject)
	wf_student_retrieve()
	li_rtncode = this.id_master.getchild("motorvehiclecode", this.idc_motorvehicle)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
