		lm_menu.m_file.m_pushsrtodropbox.enabled = false
		lm_menu.m_file.m_pushsrtodropbox.visible = false
		this.id_list.object.pushed.visible = false
		this.id_list.object.pushedon.visible = false
		this.id_list.object.pushedby.visible = false
		this.id_list.object.pushedfor.visible = false
	end if
	if f_stringpreferences("applysalepriceforalternatealiasname") = "Y" then
		this.ib_applyalternatealiasprice = true
	end if
	f_setcolumnstyle(this.id_detail, "Qty")
	wf_set_itemtotal_formatmask()
	setredraw(true)

// w_salereturn.ue_settitle() returns 0 [event]
	datawindowchild ldc_headerno
	long ll_counter
	long ll_retcode
	string ls_title
	call super::ue_settitle
	ll_retcode = this.id_master.getchild("headerno", ldc_headerno)
	if ll_retcode = 1 then
		for ll_counter = 1 to ldc_headerno.rowcount()
			if isnull(trim(ldc_headerno.getitemstring(ll_counter, "headeralias"))) then
				ls_title = ls_title + ""
			else
				ls_title = ls_title + "," + trim(ldc_headerno.getitemstring(ll_counter, "headeralias"))
			end if
		next
	else
		ls_title = ""
	end if
	this.title = this.title + "(" + ls_title + ")"

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	return ::message.returnvalue

// tab_retrieve.selectionchanging(integer oldindex, integer newindex) returns long [event]
	integer li_yesno
	integer li_rtcode
	if oldindex = 1 and newindex = 2 and parent.editflag = true and (parent.id_detail.rowcount() > 0 and parent.id_master.rowcount() > 0) then
		if parent.id_master.object.posted[parent.id_master.rowcount()] = "Y" and not isnull(parent.id_master.object.code[parent.id_master.rowcount()]) then
			parent.editflag = false
			return li_rtcode
		end if
		li_yesno = messagebox("Confirm Changes", "Yes to save changes that you've typed", question!, yesnocancel!, 2)
		if li_yesno = 1 then
			getparent().triggerevent("ue_save")
			if getparent().dynamic wf_commitform() = false then
				li_rtcode = 1
			end if
		elseif li_yesno = 3 then
			li_rtcode = 1
		else
			parent.editflag = false
			parent.i_editmode = 2
		end if
	end if
	return li_rtcode

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
	case "flatdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	end choose
	return 1

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_code
	long ll_detailrows
	long ll_custcode
	long ll_admissioncode
	long ll_patientcode
	long ll_guestcode
	long ll_studentcode
	long ll_allowed
	long ll_found
	long ll_res
	long ll_motorvehiclecode
	long ll_result
	long rt_code
	string ls_result
	string ls_aliasname
	integer li_res
	integer li_custcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "srcatcode"
	case "custcode"
		ll_code = long(data)
		parent.setredraw(false)
		if parent.parent.parent.wf_customerinfo(ll_code) <> 0 then
			messagebox("Database Error", "Can not retrieve information from database")
		end if
		parent.setredraw(true)
	case "aliasname"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findcustcode(data, li_custcode)
			if li_custcode = 19 and parent.parent.parent.ii_salerettype = 1 and parent.parent.parent.ib_opensalereturn then
				messagebox("Customer Validation", "Cash Sale Walk-In Customer is not allowed in Credit Sale Return")
				return 1
			end if
			if li_res > 0 and f_stringpreferences("GroupCustomerCategory") = "Y" then
				ll_allowed = 0
				parent.parent.parent.it_transobject.isallowedcustomergroupcategory(f_getgroupcode(gl_usercode), li_custcode, ll_allowed)
				if parent.parent.parent.it_transobject.sqlcode <> 0 then
					messagebox("Fetch Error", "Unable to fetch group customer category information.")
					return 1
				elseif ll_allowed < 1 then
					messagebox("Group Customer Category Validation", "Current group does not have enough permissions for sale return~r~n" + "against the customer whose alias name provided in alias name box.")
					return 1
				end if
				return
			end if
			if li_res > 0 then
				setitem(row, "custcode", li_custcode)
				parent.parent.parent.wf_customerinfo(li_custcode)
				ll_result = 0
			else
				messagebox("Customer Validation", "Customer with  Alias Name  " + data + " does not exist")
				ll_result = 1
			end if
		end if
	case "patientregno"
		if not (isnull(data) or data = "") then
			ll_result = parent.parent.parent.wf_findpatientcode(data, ll_patientcode)
			if ll_result > 0 then
				if parent.parent.parent.ii_salerettype = 1 then
					setitem(row, "patientcode", ll_patientcode)
				end if
				if parent.parent.parent.ii_salerettype = 1 then
					SQL SELECT custcode , ( SELECT A.aliasname FROM Accounts A WHERE A.AccCode =patient.custcode ) INTO :ll_custcode, :ls_aliasname FROM patient WHERE patientcode =:ll_patientcode USING parent.parent.parent.it_transobject;
					if parent.parent.parent.it_transobject.sqlcode = 0 then
						ll_allowed = 0
						if f_stringpreferences("GroupCustomerCategory") = "Y" then
							parent.parent.parent.it_transobject.isallowedcustomergroupcategory(parent.parent.parent.il_groupcode, ll_custcode, ll_allowed)
							if parent.parent.parent.it_transobject.sqlcode <> 0 then
								messagebox("Fetch Error", "Unable to fetch group customer category information.")
								return 1
							elseif ll_allowed < 1 then
								messagebox("Group Customer Category Validation", "Current group does not have enough permissions for sale ~r~n" + "against the customer.")
								return 1
							end if
							return
						end if
						setitem(row, "patientcode", ll_patientcode)
						parent.parent.parent.id_master.setitem(1, "aliasname", ls_aliasname)
						parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
						parent.parent.parent.id_master.object.custcode.protect = 1
						parent.parent.parent.id_master.object.aliasname.protect = 1
					else
						messagebox("Patient Information", "Problem in retrieving corresponding customer")
						ll_result = 1
					end if
				end if
				parent.parent.parent.wf_setpatientinfo(ll_patientcode)
			else
				if ll_result = -2 then
					messagebox("Patient Validation", "Patient with  RegNo  " + data + " is Inactive")
				else
					messagebox("Patient Validation", "Patient with  RegNo  " + data + " does not exist")
				end if
				ll_result = 1
			end if
		end if
	case "patientcode"
		if isnull(data) then
			parent.parent.parent.id_master.object.custcode.protect = 0
			parent.parent.parent.id_master.setitem(1, "custcode", 0)
		else
			ll_patientcode = long(data)
			ll_found = parent.parent.parent.idc_patient.find("patientcode=" + string(ll_patientcode), 1, parent.parent.parent.idc_patient.rowcount())
			if ll_found <= 0 then
				messagebox("Patient Validation", "Patient does not exist or Already Inactive")
				return 1
			end if
			parent.parent.parent.id_master.setitem(1, "patientregno", parent.parent.parent.wf_findregno(ll_patientcode))
			if parent.parent.parent.ii_salerettype = 1 then
				SQL SELECT custcode INTO :ll_custcode FROM patient WHERE patientcode =:ll_patientcode USING parent.parent.parent.it_transobject;
				if parent.parent.parent.it_transobject.sqlcode = 0 then
					parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
					parent.parent.parent.id_master.object.custcode.protect = 1
					parent.parent.parent.id_master.object.aliasname.protect = 1
					ll_result = parent.parent.parent.wf_customerinfo(ll_custcode)
				else
					messagebox("Patient Information", "Problem in retrieving corresponding customer")
					ll_result = 1
				end if
			end if
		end if
	case "saleinvcode"
		ll_result = parent.parent.parent.wf_validatesaleinvcode(row, long(data))
	case "guestregno"
		if not (isnull(data) or data = "") then
			ll_result = parent.parent.parent.wf_findguestcode(data, ll_guestcode)
			if ll_result > 0 then
				if parent.parent.parent.ii_salerettype = 1 then
					setitem(row, "Guestcode", ll_guestcode)
				end if
				if parent.parent.parent.ii_salerettype = 1 then
					SQL SELECT custcode , ( SELECT A.aliasname FROM Accounts A WHERE A.AccCode =Guest.custcode ) INTO :ll_custcode, :ls_aliasname FROM Guest WHERE Guestcode =:ll_guestcode USING parent.parent.parent.it_transobject;
					if parent.parent.parent.it_transobject.sqlcode = 0 then
						ll_allowed = 0
						if f_stringpreferences("GroupCustomerCategory") = "Y" then
							parent.parent.parent.it_transobject.isallowedcustomergroupcategory(parent.parent.parent.il_groupcode, ll_custcode, ll_allowed)
							if parent.parent.parent.it_transobject.sqlcode <> 0 then
								messagebox("Fetch Error", "Unable to fetch group customer category information.")
								return 1
							elseif ll_allowed < 1 then
								messagebox("Group Customer Category Validation", "Current group does not have enough permissions for sale ~r~n" + "against the customer.")
								return 1
							end if
							return
						end if
						setitem(row, "Guestcode", ll_guestcode)
						parent.parent.parent.id_master.setitem(1, "aliasname", ls_aliasname)
						parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
						parent.parent.parent.id_master.object.custcode.protect = 1
						parent.parent.parent.id_master.object.aliasname.protect = 1
					else
						messagebox("Guest Information", "Problem in retrieving corresponding customer")
						ll_result = 1
					end if
				end if
				parent.parent.parent.wf_setguestinfo(ll_guestcode)
			else
				if ll_result = -2 then
					messagebox("Guest Validation", "Guest with  RegNo  " + data + " is Inactive")
				else
					messagebox("Guest Validation", "Guest with  RegNo  " + data + " does not exist")
				end if
				ll_result = 1
			end if
		end if
	case "guestcode"
		if isnull(data) then
			parent.parent.parent.id_master.object.custcode.protect = 0
			parent.parent.parent.id_master.setitem(1, "custcode", 0)
		else
			ll_guestcode = long(data)
			ll_found = parent.parent.parent.idc_guest.find("code=" + string(ll_guestcode), 1, parent.parent.parent.idc_guest.rowcount())
			if ll_found <= 0 then
				messagebox("Guest Validation", "Guest does not exist or Already Inactive")
				return 1
			end if
			parent.parent.parent.id_master.setitem(1, "Guestregno", parent.parent.parent.idc_guest.getitemstring(ll_found, "regno"))
			if parent.parent.parent.ii_salerettype = 1 then
				SQL SELECT custcode INTO :ll_custcode FROM Guest WHERE Guestcode =:ll_guestcode USING parent.parent.parent.it_transobject;
				if parent.parent.parent.it_transobject.sqlcode = 0 then
					parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
					parent.parent.parent.id_master.object.custcode.protect = 1
					parent.parent.parent.id_master.object.aliasname.protect = 1
					ll_result = parent.parent.parent.wf_customerinfo(ll_custcode)
				else
					messagebox("Guest Information", "Problem in retrieving corresponding customer")
					ll_result = 1
				end if
			end if
		end if
	case "studentregno"
		if not (isnull(data) or data = "") then
			ll_result = parent.parent.parent.wf_findstudentcode(data, ll_studentcode)
			if ll_result > 0 then
				if parent.parent.parent.ii_salerettype = 1 then
					setitem(row, "Studentcode", ll_studentcode)
				end if
				if parent.parent.parent.ii_salerettype = 1 then
					SQL SELECT custcode , ( SELECT A.aliasname FROM Accounts A WHERE A.AccCode =Student.custcode ) INTO :ll_custcode, :ls_aliasname FROM Student WHERE Studentcode =:ll_studentcode USING parent.parent.parent.it_transobject;
					if parent.parent.parent.it_transobject.sqlcode = 0 then
						ll_allowed = 0
						if f_stringpreferences("GroupCustomerCategory") = "Y" then
							parent.parent.parent.it_transobject.isallowedcustomergroupcategory(parent.parent.parent.il_groupcode, ll_custcode, ll_allowed)
							if parent.parent.parent.it_transobject.sqlcode <> 0 then
								messagebox("Fetch Error", "Unable to fetch group customer category information.")
								return 1
							elseif ll_allowed < 1 then
								messagebox("Group Customer Category Validation", "Current group does not have enough permissions for sale ~r~n" + "against the customer.")
								return 1
							end if
							return
						end if
						setitem(row, "Studentcode", ll_studentcode)
						parent.parent.parent.id_master.setitem(1, "aliasname", ls_aliasname)
						parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
						parent.parent.parent.id_master.object.custcode.protect = 1
						parent.parent.parent.id_master.object.aliasname.protect = 1
					else
						messagebox("Student Information", "Problem in retrieving corresponding customer")
						ll_result = 1
					end if
				end if
				parent.parent.parent.wf_setstudentinfo(ll_studentcode)
			else
				if ll_result = -2 then
					messagebox("Student Validation", "Student with  RegNo  " + data + " is Inactive")
				else
					messagebox("Student Validation", "Student with  RegNo  " + data + " does not exist")
				end if
				ll_result = 1
			end if
		end if
	case "studentcode"
		if isnull(data) then
			parent.parent.parent.id_master.object.custcode.protect = 0
			parent.parent.parent.id_master.setitem(1, "custcode", 0)
		else
			ll_studentcode = long(data)
			ll_found = parent.parent.parent.idc_student.find("code=" + string(ll_studentcode), 1, parent.parent.parent.idc_student.rowcount())
			if ll_found <= 0 then
				messagebox("Student Validation", "Student does not exist or Already Inactive")
				return 1
			end if
			parent.parent.parent.id_master.setitem(1, "Studentregno", parent.parent.parent.idc_student.getitemstring(ll_found, "regno"))
			if parent.parent.parent.ii_salerettype = 1 then
				SQL SELECT custcode INTO :ll_custcode FROM Student WHERE Studentcode =:ll_studentcode USING parent.parent.parent.it_transobject;
				if parent.parent.parent.it_transobject.sqlcode = 0 then
					parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
					parent.parent.parent.id_master.object.custcode.protect = 1
					parent.parent.parent.id_master.object.aliasname.protect = 1
					ll_result = parent.parent.parent.wf_customerinfo(ll_custcode)
				else
					messagebox("Student Information", "Problem in retrieving corresponding customer")
					ll_result = 1
				end if
			end if
		end if
	case "chasisno"
		if not (isnull(data) or data = "") then
			ll_res = parent.parent.parent.wf_find_motorvehiclecode(data, ll_motorvehiclecode)
			if ll_res > 0 then
				setitem(row, "motorvehiclecode", ll_motorvehiclecode)
				rt_code = 0
				SQL SELECT custcode INTO :ll_custcode FROM motorvehicle WHERE motorvehiclecode =:ll_motorvehiclecode USING parent.parent.parent.it_transobject;
				if parent.parent.parent.it_transobject.sqlcode = 0 then
					ll_allowed = 0
					if f_stringpreferences("GroupCustomerCategory") = "Y" then
						parent.parent.parent.it_transobject.isallowedcustomergroupcategory(parent.parent.parent.il_groupcode, ll_custcode, ll_allowed)
						if parent.parent.parent.it_transobject.sqlcode <> 0 then
							messagebox("Fetch Error", "Unable to fetch group customer category information.")
							return 1
						elseif ll_allowed < 1 then
							messagebox("Group Customer Category Validation", "Current group does not have enough permissions for sale ~r~n" + "against the customer.")
							return 1
						end if
						return
					end if
					setitem(row, "motorvehiclecode", ll_motorvehiclecode)
					parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
					parent.parent.parent.id_master.object.custcode.protect = 1
					parent.parent.parent.id_master.object.aliasname.protect = 1
				else
					messagebox("Motor Vehicle Information", "Problem in retrieving corresponding customer")
					rt_code = 1
				end if
			end if
			parent.parent.parent.wf_set_motorvehicleinfo(ll_motorvehiclecode)
		end if
	case "motorvehiclecode"
		parent.parent.parent.id_master.setitem(1, "chasisno", parent.parent.parent.idc_motorvehicle.getitemstring(parent.parent.parent.idc_motorvehicle.getrow(), "chasisno"))
		if isnull(data) then
			parent.parent.parent.id_master.object.custcode.protect = 0
			parent.parent.parent.id_master.setitem(1, "custcode", 0)
			parent.parent.parent.id_master.setitem(1, "sprice", 1)
			parent.parent.parent.id_master.setitem(1, "dd_gstperc", 1)
		else
			ll_motorvehiclecode = long(data)
			if parent.parent.parent.wf_set_motorvehicleinfo(ll_motorvehiclecode) = 0 then
				messagebox("Motor Vehicle Validation", "Motor Vehicle does not exist or Already Inactive.")
				return 1
			end if
			SQL SELECT custcode INTO :ll_custcode FROM motorvehicle WHERE motorvehiclecode =:ll_motorvehiclecode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = 0 then
				ll_allowed = 0
				if f_stringpreferences("GroupCustomerCategory") = "Y" then
					parent.parent.parent.it_transobject.isallowedcustomergroupcategory(parent.parent.parent.il_groupcode, ll_custcode, ll_allowed)
					if parent.parent.parent.it_transobject.sqlcode <> 0 then
						messagebox("Fetch Error", "Unable to fetch group customer category information.")
						return 1
					elseif ll_allowed < 1 then
						messagebox("Group Customer Category Validation", "Current group does not have enough permissions for sale ~r~n" + "against the customer whose patient is selected in the list box.")
						return 1
					end if
					return
				end if
				parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
				parent.parent.parent.id_master.object.custcode.protect = 1
				parent.parent.parent.id_master.object.aliasname.protect = 1
			else
				messagebox("Motor Vehicle Information", "Problem in retrieving corresponding customer.")
				rt_code = 1
			end if
		end if
	case "currencycode"
		if long(data) > 0 then
			if parent.parent.parent.wf_apply_currency(long(data)) then
				return 0
			else
				return 1
			end if
		else
			return 1
		end if
	case "conversionrate"
		if double(data) > 0.0 then
			if parent.parent.parent.wf_apply_conversionrate(double(data)) then
				return 0
			else
				return 1
			end if
		else
			return 1
		end if
		return ll_result
	end choose
	return ll_result

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_saletype
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "saleinvcode"
		if parent.parent.parent.ii_salerettype = 8 then
			ls_saletype = "Retail Sale"
		else
			ls_saletype = "Whole Sale"
		end if
		if isnull(data) or integer(data) = 0 then
			messagebox("Sale Invoice code Validation", "You must select some " + ls_saletype + " invoice")
		else
			messagebox("Sale Invoice code Validation", "You must select some valid " + ls_saletype + " invoice")
		end if
	end choose
	return 1

// dw_detail.retrieveend(long rowcount) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::retrieveend(rowcount)
	if parent.parent.parent.ib_opensalereturn and rowcount > 0 then
		parent.parent.parent.idc_itemdddw.settransobject(parent.parent.parent.it_transobject)
		parent.parent.parent.idc_itemdddw.reset()
		parent.parent.parent.idc_itemdddw.retrieve(this.object.saleinvcode[rowcount])
	end if
	return ::message.returnvalue

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	string ls_columnobject
	long ll_currow
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	ls_columnobject = dwo.name
	ll_currow = rowcount()
	if ll_currow > 0 and (ls_columnobject = "discperc" or ls_columnobject = "srprice" or ls_columnobject = "qty") and isnull(this.object.icode[ll_currow]) then
		scrolltorow(ll_currow)
		setcolumn("icode")
	end if
	return 0

// dw_detail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.getparent().dynamic postevent("ue_accepttext")
	return ::message.returnvalue

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf6! and (getcolumnname() = "motorvehiclecode" or getcolumnname() = "chasisno") then
		parent.parent.parent.wf_motorvehiclesearch()
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_null
	long ll_itemcodetype
	string ls_null
	integer li_rtcode
	string ls_batch
	string ls_itemname
	datetime ld_expiry
	long ll_gcode
	long ll_icode
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case "icode"
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	case parent.parent.parent.is_columnitemname
		if parent.parent.parent.id_itemslist.rowcount() > 1 then
			parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
			parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		end if
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	case "looseqty"
		li_rtcode = parent.parent.parent.wf_validateqty(row, double(data))
		if li_rtcode <> 1 then
			if double(data) <= 0.0 and f_stringpreferences("BonusinSale") = "N" then
				messagebox("Sale Qty Validation!", "Please Enter Valid Sale Qty.")
				li_rtcode = 1
			elseif double(data) <= 0.0 and f_stringpreferences("BonusinSale") = "Y" and getitemnumber(row, "bonusqty") <= 0.0 then
				messagebox("Sale Qty Validation!", "Please Enter Valid Sale Qty.")
				li_rtcode = 1
			end if
		end if
	case "bonusqty"
		li_rtcode = parent.parent.parent.wf_validatebonusqty(row, double(data))
		if li_rtcode <> 1 and (double(data) <= 0.0 and getitemnumber(row, "looseqty") <= 0.0) then
			messagebox("Bonus Qty Validation!", "Both Quantity and Bonus must be valid.")
			li_rtcode = 1
		end if
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname, ll_itemcodetype, parent.parent.parent.idbl_packqty, parent.parent.parent.idbl_purprice, parent.parent.parent.idbl_saleprice)
			if li_res > 0 then
				if parent.parent.parent.idbl_packqty <= 0.0 or isnull(parent.parent.parent.idbl_packqty) then
					parent.parent.parent.idbl_packqty = 1
				end if
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				if ll_itemcodetype = 2 then
					setitem(row, "alternatecustomicode", data)
					if parent.parent.parent.ib_applyalternatealiasprice then
						setitem(row, "looseqty", parent.parent.parent.idbl_packqty)
						setitem(row, "srprice", parent.parent.parent.idbl_saleprice / parent.parent.parent.idbl_packqty)
						setitem(row, "saleprice", parent.parent.parent.idbl_saleprice / parent.parent.parent.idbl_packqty)
					end if
				else
					setitem(row, "alternatecustomicode", ls_null)
				end if
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_rtcode = 0
			else
				messagebox("ItemNumber Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_rtcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_rtcode = 2
		end if
	case "batch"
		ls_batch = data
		ld_expiry = getitemdatetime(row, "expiry")
		ll_gcode = getitemnumber(row, "gcode")
		ll_icode = getitemnumber(row, "icode")
		if parent.parent.parent.ib_opensalereturn then
			parent.parent.parent.wf_getrecentexpiry(ll_icode, ls_batch, row)
			ld_expiry = getitemdatetime(row, "expiry")
		end if
		if not isnull(ll_gcode) and not isnull(ll_icode) and not isnull(ls_batch) and not isnull(ld_expiry) then
			if not vf_dwdupcodebatch(this, "gcode", ll_gcode, "icode", ll_icode, "batch", ls_batch, "expiry", ld_expiry, row) then
				setnull(parent.parent.parent.is_validationerrtext)
			end if
		else
			setnull(parent.parent.parent.is_validationerrtext)
		end if
	case "expiry"
		ls_batch = getitemstring(row, "batch")
		ld_expiry = datetime(date(left(data, 10)), time("00:00:00:000000"))
		ll_gcode = getitemnumber(row, "gcode")
		ll_icode = getitemnumber(row, "icode")
		if not isnull(ll_gcode) and not isnull(ll_icode) and not isnull(ls_batch) and not isnull(ld_expiry) then
			if not vf_dwdupcodebatch(this, "gcode", ll_gcode, "icode", ll_icode, "batch", ls_batch, "expiry", ld_expiry, row) then
				setnull(parent.parent.parent.is_validationerrtext)
			end if
		else
			setnull(parent.parent.parent.is_validationerrtext)
		end if
	end choose
	return li_rtcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ancestorreturnvalue
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "itemname" then
		parent.parent.parent.ib_focusdetail = true
	end if
	parent.parent.parent.wf_grandtotal()
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	long ll_icode
	long ll_foundrow
	dwitemstatus lrs_status
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if parent.parent.parent.id_detail.rowcount() > 0 and lrs_status <> new! then
		parent.parent.parent.id_footer.setitem(1, "stock", getitemnumber(currentrow, "stock"))
		if not parent.parent.parent.ib_opensalereturn then
			parent.parent.parent.id_footer.setitem(1, "saleqty", getitemnumber(currentrow, "saleqty"))
			parent.parent.parent.id_footer.setitem(1, "retableqty", getitemnumber(currentrow, "retableqty"))
			if f_stringpreferences("BonusinSale") = "Y" then
				parent.parent.parent.id_footer.setitem(1, "salebonusqty", getitemnumber(currentrow, "salebonusqty"))
				parent.parent.parent.id_footer.setitem(1, "retablebonusqty", getitemnumber(currentrow, "retablebonusqty"))
			end if
		else
			parent.parent.parent.id_footer.object.saleqty[1] = 0
			parent.parent.parent.id_footer.object.retableqty[1] = 0
			if f_stringpreferences("BonusinSale") = "Y" then
				parent.parent.parent.id_footer.object.salebonusqty[1] = 0
				parent.parent.parent.id_footer.object.retablebonusqty[1] = 0
			end if
		end if
	elseif parent.parent.parent.id_footer.rowcount() > 0 then
		parent.parent.parent.id_footer.setitem(1, "saleqty", 0)
		parent.parent.parent.id_footer.setitem(1, "retableqty", 0)
		parent.parent.parent.id_footer.setitem(1, "stock", 0)
		if f_stringpreferences("BonusinSale") = "Y" then
			parent.parent.parent.id_footer.setitem(1, "salebonusqty", 0)
			parent.parent.parent.id_footer.setitem(1, "retablebonusqty", 0)
			parent.parent.parent.id_footer.setitem(1, "stock", 0)
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "icode"
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case parent.parent.parent.is_columnitemname
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case "looseqty"
		if double(data) <= 0.0 and getitemnumber(row, "BonusQty") <= 0.0 then
			messagebox("Item Qty Validation", "Item Qty ~"" + data + "~" should be greater than zero")
		end if
	case "bonusqty"
		if double(data) <= 0.0 and getitemnumber(row, "LooseQty") <= 0.0 then
			messagebox("Item Bonus Qty Validation", "Item Bonus Qty ~"" + data + "~" should be greater than zero")
		end if
	case "discperc"
		messagebox("Item Discount Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	case "srprice"
		if double(data) <= 0.0 then
			messagebox("Item Price Validation", "Item price ~"" + data + "~" must be greater than zero")
		else
			messagebox("Item Price Validation", "Item price can not be changed")
		end if
	case "batch"
		if isnull(parent.parent.parent.is_validationerrtext) then
			messagebox("Item Batch Validation", "Please enter some valid batch number")
		else
			messagebox("Item Validation", parent.parent.parent.is_validationerrtext)
		end if
	case "expiry"
		if isnull(parent.parent.parent.is_validationerrtext) then
			messagebox("Item Expiry Validation", "Please enter some valid expiry date")
		else
			messagebox("Item Validation", parent.parent.parent.is_validationerrtext)
		end if
	end choose
	setnull(parent.parent.parent.is_validationerrtext)
	return 1

// dw_itemsdetail.getfocus() returns long [event]
	long ancestorreturnvalue
	if f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	long ll_currentrow
	long ll_holdrow
	long ll_holdicode
	string ls_holdstr
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	if f_stringpreferences("DisplayPool") = "Y" then
		ll_currentrow = getrow()
		if ll_currentrow <> 0 and parent.parent.parent.ib_lcdshow = true then
			if parent.parent.parent.ib_opensalereturn then
				ls_holdstr = this.object.itemname[ll_currentrow]
			else
				ll_holdicode = this.object.icode[ll_currentrow]
				ll_holdrow = gd_itemsinfo.find("ICode=" + string(ll_holdicode), 1, gd_itemsinfo.rowcount())
				if ll_holdrow > 0 then
					ls_holdstr = gd_itemsinfo.getitemstring(ll_holdrow, "ItemName")
				else
					ls_holdstr = this.object.itemname[ll_currentrow]
				end if
			end if
			if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				if this.object.icode[ll_currentrow] > 0 then
					parent.parent.parent.is_lcditem = trim(left(ls_holdstr, 20)) + space(20 - len(trim(left(ls_holdstr, 20))))
					parent.parent.parent.is_lcditem2 = "Qty=" + string(this.object.looseqty[ll_currentrow], f_setcolumnformat("Qty")) + " Rs=" + string(this.object.srprice[ll_currentrow], "#######0.00")
				end if
			elseif upper(f_stringpreferences("DisplayPoolCompany")) <> "BAYLAN VFD-860-A" then
				if len(ls_holdstr) < 20 then
					parent.parent.parent.is_lcditem = ls_holdstr + space(20 - len(ls_holdstr))
				else
					parent.parent.parent.is_lcditem = left(ls_holdstr, 20)
				end if
				parent.parent.parent.is_lcditem = parent.parent.parent.is_lcditem + "Qty=" + string(this.object.looseqty[ll_currentrow])
				parent.parent.parent.is_lcditem = parent.parent.parent.is_lcditem + " Rs=" + string(this.object.srprice[ll_currentrow], "#######0.00")
			end if
			parent.parent.parent.ic_comport.triggerevent("ue_show")
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanging(long currentrow, long newrow) returns long [event]
	long ancestorreturnvalue
	string ls_holdstr
	long ll_holdicode
	long ll_holdrow
	ancestorreturnvalue = super::rowfocuschanging(currentrow, newrow)
	if f_stringpreferences("DisplayPool") = "Y" and (currentrow <> 0 and parent.parent.parent.ib_lcdshow = true) and parent.parent.parent.id_detail.rowcount() > 0 then
		if parent.parent.parent.ib_opensalereturn then
			ls_holdstr = this.object.itemname[currentrow]
		else
			ll_holdicode = this.object.icode[currentrow]
			ll_holdrow = gd_itemsinfo.find("ICode=" + string(ll_holdicode), 1, gd_itemsinfo.rowcount())
			ls_holdstr = gd_itemsinfo.getitemstring(ll_holdrow, "ItemName")
		end if
		if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
			parent.parent.parent.is_lcditem = trim(left(ls_holdstr, 20)) + space(20 - len(trim(left(ls_holdstr, 20))))
			parent.parent.parent.is_lcditem2 = "Qty=" + string(this.object.looseqty[currentrow], f_setcolumnformat("Qty")) + " Rs=" + string(this.object.srprice[currentrow], "#######0.00")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) <> "BAYLAN VFD-860-A" then
			if len(ls_holdstr) < 20 then
				parent.parent.parent.is_lcditem = ls_holdstr + space(20 - len(ls_holdstr))
			else
				parent.parent.parent.is_lcditem = left(ls_holdstr, 20)
			end if
			parent.parent.parent.is_lcditem = parent.parent.parent.is_lcditem + "Qty=" + string(this.object.looseqty[currentrow])
			parent.parent.parent.is_lcditem = parent.parent.parent.is_lcditem + " Rs=" + string(this.object.srprice[currentrow], "#######0.00")
		end if
		parent.parent.parent.ic_comport.postevent("ue_show")
	end if
	return ::message.returnvalue

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ll_currrow
	long ll_startrow
	long ll_endrow
	if parent.parent.parent.editflag = false then
		parent.parent.parent.editflag = true
		parent.parent.parent.im_menu.m_file.m_save.enabled = true
	end if
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		if upper(left(data, 1)) >= "A" and upper(left(data, 1)) <= "Z" or left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
			ll_currrow = parent.parent.parent.id_itemslist.getrow()
			if len(data) > 1 then
				ll_startrow = ll_currrow
			else
				ll_startrow = 1
				parent.parent.parent.ib_bkspace = false
			end if
			if parent.parent.parent.ib_bkspace then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.find("Lower(itemname) <= '" + lower(data) + "'", ll_startrow, 0)
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.il_itemlistfoundrow + 1
				parent.parent.parent.ib_bkspace = false
			else
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.find("Lower(itemname) >= '" + lower(data) + "'", ll_startrow, parent.parent.parent.id_itemslist.rowcount())
			end if
			if parent.parent.parent.il_itemlistfoundrow = 0 then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.rowcount()
			end if
			if parent.parent.parent.il_itemlistfoundrow <> ll_currrow then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.setrow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_itemslist.scrolltorow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_itemslist.selectrow(parent.parent.parent.il_itemlistfoundrow, true)
				ll_endrow = setitem(row, "currlistrow", parent.parent.parent.il_itemlistfoundrow)
				ll_endrow = getitemnumber(row, "currlistrow")
				setfocus()
			end if
		end if
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	end choose
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	integer li_rowno
	integer i
	integer li_columnno
	integer li_quicksearch_col
	boolean lb_duplicate
	if parent.parent.parent.ii_salerettype = 1 then
		if f_numberpreferences("CreditsaleDetailWindowFormat") = 1 then
			li_columnno = integer(this.object.datawindow.column.count)
		else
			li_columnno = integer(this.object.discperc.id)
		end if
	end if
	if parent.parent.parent.ii_salerettype = 8 then
		if f_numberpreferences("CashsaleDetailWindowFormat") = 1 then
			li_columnno = integer(this.object.datawindow.column.count)
		else
			li_columnno = integer(this.object.discperc.id)
		end if
	end if
	if getrow() = rowcount() then
		if getcolumn() = li_columnno then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
	elseif li_columnno = integer(this.object.datawindow.column.count) and getcolumn() = li_columnno then
		scrollnextrow()
		if f_stringpreferences("ItemCode") = "Y" then
			setcolumn(1)
		else
			setcolumn(2)
		end if
		setfocus()
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_find.keypressed(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::keypressed(key, keyflags)
	if keyflags = 2 and key = keyf12! then
		parent.parent.parent.wf_replace_postdate_with_date()
	end if
	return ::message.returnvalue

// ic_comport.ue_show() returns long [event]
	string ls_line
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	try
		if isnull(parent.is_lcditem) then
			if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
				parent.is_lcditem = char(26) + char(1)
				parent.ic_comport.triggerevent("ue_show")
				parent.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
				parent.ic_comport.triggerevent("ue_show")
				return 1
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
				parent.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				return 1
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
				return 1
			else
				parent.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
			end if
		end if
		if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
			parent.wf_pd_initialize()
			pd_writepd(ls_line, len(ls_line))
			if not isnull(parent.is_lcditem) then
				pd_writepd(parent.is_lcditem, len(parent.is_lcditem))
			end if
			ls_line = char(27) + char(72) + char(20)
			pd_writepd(ls_line, len(ls_line))
			if not isnull(parent.is_lcditem2) then
				pd_writepd(parent.is_lcditem2, len(parent.is_lcditem2))
			end if
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
			return 1
		else
			this.object.portopen = true
			if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
				this.object.output = char(26) + parent.is_lcditem
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
				this.object.output = char(12) + parent.is_lcditem
			else
				this.object.output = char(12) + parent.is_lcditem
			end if
			this.object.portopen = false
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try
	return 1

// ic_comport.constructor() returns long [event]
	integer li_defaultcomport
	integer li_status
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	try
		if f_stringpreferences("DisplayPool") = "Y" then
			if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				pd_openusbpd()
				li_status = pd_pdstate()
				if li_status = 0 then
					parent.wf_pd_initialize()
				end if
			elseif upper(f_stringpreferences("DisplayPoolCompany")) <> "BAYLAN VFD-860-A" then
				li_defaultcomport = f_numberpreferences("DefaultComPort")
				if isnull(li_defaultcomport) then
					li_defaultcomport = 1
				end if
				this.object.commport = li_defaultcomport
				this.object.settings = "9600,N,8,1"
				this.object.inputlen = 0
			end if
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try
	return ::message.returnvalue

// ic_cashdrawer.doubleclicked() returns long [event]
	integer li_defaultcomport
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	try
		if f_stringpreferences("CashDrawer") = "Y" then
			li_defaultcomport = f_numberpreferences("CashDrawerComPort")
			if isnull(li_defaultcomport) then
				li_defaultcomport = 1
			end if
			this.object.commport = li_defaultcomport
			this.object.settings = "300,N,8,1"
			this.object.inputlen = 0
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try
	return ::message.returnvalue
