// window w_inpatientsalereturn (salereturncomponents)  ancestor: w_multi_entry

// w_inpatientsalereturn.ue_accepttext() returns 0
	if this.id_detail.accepttext() = -1 then
		this.id_detail.setfocus()
	end if

// w_inpatientsalereturn.ue_save_withnocommit() returns long
	setpointer(hourglass!)
	if f_validatedw(this.id_master) < 0 then
		return -1
	end if
	if f_validatedw(this.id_detail) < 0 then
		return -2
	end if
	if this.id_master.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -3
	end if
	if this.id_detail.update() < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -4
	end if
	setpointer(arrow!)
	return 0

// w_inpatientsalereturn.wf_visibleinvisiblediscount() returns integer
	this.id_detail.object.discperc.visible = 0
	return 1

// w_inpatientsalereturn.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	long iccode
	long icatcode
	long packcode
	long manfcode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_inpatientsalereturn.wf_locksaleretinvoice(long al_saleretinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From srledger WITH ( UPDLOCK HOLDLOCK ) Where srledger.srinvcode =:al_saleretinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_inpatientsalereturn.wf_locksrinvoices(long al_sinvcode, long al_linvcode) returns integer
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM srledger WITH ( UPDLOCK HOLDLOCK ) WHERE srledger.srinvcode Between :al_sinvcode and :al_linvcode USING sqlca;
	return sqlca.sqlcode

// w_inpatientsalereturn.wf_post() returns integer
	integer li_errcode
	long ll_detailrows
	long ll_masterrows
	long ll_gcode
	long ll_icode
	long ll_errrowid
	long ll_salesmancode
	long ll_outercounter
	long ll_innercounter
	long ll_masterinvcode
	long ll_detailinvcode
	double ld_stock
	double ld_newstock
	double ld_qty
	double ld_bonusqty
	double ld_avgprice
	string ls_batch
	string ls_errtext
	datetime ld_expiry
	datastore lds_master
	datastore lds_detail
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			li_errcode = wf_locksrinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
			if li_errcode = 0 then
				lds_master = create datastore
				lds_detail = create datastore
				lds_master.dataobject = "d_srpostinvheaders"
				lds_detail.dataobject = "d_srpostinvdetail"
				lds_master.settransobject(sqlca)
				lds_detail.settransobject(sqlca)
				lds_master.retrieve(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
				lds_detail.retrieve(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
				ls_errtext = "Some database request fails        "
				ll_masterrows = lds_master.rowcount()
				ll_detailrows = lds_detail.rowcount()
				ll_outercounter = 1
				ll_innercounter = 1
				do while ll_outercounter <= ll_masterrows and li_errcode = 0
					ll_masterinvcode = lds_master.getitemnumber(ll_outercounter, "srinvcode")
					ll_detailinvcode = lds_detail.getitemnumber(ll_innercounter, "srinvcode")
					do while ll_innercounter <= ll_detailrows and ll_masterinvcode = ll_detailinvcode and li_errcode = 0
						ll_gcode = lds_detail.getitemnumber(ll_innercounter, "gcode")
						ll_icode = lds_detail.getitemnumber(ll_innercounter, "icode")
						ls_batch = lds_detail.getitemstring(ll_innercounter, "batch")
						ld_expiry = lds_detail.getitemdatetime(ll_innercounter, "expiry")
						ld_qty = lds_detail.getitemnumber(ll_innercounter, "looseqty")
						ld_bonusqty = lds_detail.getitemnumber(ll_innercounter, "bonusqty")
						sqlca.getitemavgprice(ll_icode, ld_avgprice)
						if sqlca.sqlcode = 0 then
							sqlca.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
							if sqlca.sqlcode = 0 then
								ld_newstock = ld_stock + ld_qty + ld_bonusqty
								sqlca.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
								if sqlca.sqlcode <> 0 then
									li_errcode = -1
								end if
							else
								li_errcode = -1
							end if
						else
							li_errcode = -1
						end if
						ll_innercounter = ll_innercounter + 1
						if ll_innercounter <= ll_detailrows then
							ll_detailinvcode = lds_detail.getitemnumber(ll_innercounter, "srinvcode")
						end if
					loop
					if li_errcode = 0 then
						sqlca.postsrledger(ll_masterinvcode)
						if sqlca.sqlcode <> 0 then
							li_errcode = -1
							ll_errrowid = ll_outercounter
						end if
					else
						ll_errrowid = ll_outercounter
					end if
					ll_outercounter = ll_outercounter + 1
				loop
				destroy lds_master
				destroy lds_detail
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
			ll_errrowid = ll_outercounter
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if li_errcode <> 0 then
		messagebox("Posting Fails", ls_errtext + "~n~rin invoice number" + string(lds_master.getitemnumber(ll_errrowid, "srinvcode")))
	else
		messagebox("Posting Successfull", "Total unposted rows were " + string(ll_masterrows) + "~n~rAll rows have been posted successfully")
	end if
	return li_errcode

// w_inpatientsalereturn.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_counter step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_inpatientsalereturn.wf_setfooterinfo(long al_saleinvcode) returns 0
	double ld_discperc
	double ld_flatdisc
	double ld_misccharges
	double ld_invgstperc1
	SQL SELECT saleledger.discperc , saleledger.flatdisc , saleledger.misccharges , saleledger.InvGSTperc1 INTO :ld_discperc, :ld_flatdisc, :ld_misccharges, :ld_invgstperc1 FROM saleledger WHERE saleledger.saleinvcode =:al_saleinvcode USING sqlca;
	this.id_footer.setitem(1, "discperc", ld_discperc)
	this.id_footer.setitem(1, "flatdisc", ld_flatdisc)
	this.id_footer.setitem(1, "misccharges", ld_misccharges)
	this.id_footer.setitem(1, "InvGSTperc1", ld_invgstperc1)

// w_inpatientsalereturn.wf_setsalereturntype(integer ai_salerettype, boolean ab_opensaleret) returns 0
	this.ii_salerettype = ai_salerettype
	this.ib_opensalereturn = ab_opensaleret

// w_inpatientsalereturn.wf_visible(boolean ab_flag) returns 0
	if not this.ib_opensalereturn then
		this.id_footer.object.retableqty.visible = ab_flag
		this.id_footer.object.t_retableqty.visible = ab_flag
		this.id_footer.object.saleqty.visible = ab_flag
		this.id_footer.object.t_saleqty.visible = ab_flag
		this.id_footer.object.retablebonusqty.visible = ab_flag
		this.id_footer.object.t_retablebonusqty.visible = ab_flag
		this.id_footer.object.salebonusqty.visible = ab_flag
		this.id_footer.object.t_salebonusqty.visible = ab_flag
	end if

// w_inpatientsalereturn.wf_findunpostedsalereturns(long al_saleinvcode, string as_errtext) returns integer
	integer li_rtcode
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM srledger WHERE srledger.saleinvcode =:al_saleinvcode AND srledger.posted ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_count > 0 then
			li_rtcode = 1
			as_errtext = "Some Unposted Sale Return invoice already exist,~n~rModify that invoice"
		end if
	else
		li_rtcode = 1
		as_errtext = "Database Error, Some database request fails"
	end if
	return li_rtcode

// w_inpatientsalereturn.wf_setsaleinvinfo(long al_saleinvcode, long al_custcode) returns 0
	long ll_salecatcode
	long ll_row
	long ll_smancode
	long ll_patientcode
	long ll_admissioncode
	datetime ld_date
	string ls_regno
	SQL SELECT saleledger.custcode , saleledger.date , saleledger.salecatcode , saleledger.smancode , saleledger.patientcode , admissioncode INTO :al_custcode, :ld_date, :ll_salecatcode, :ll_smancode, :ll_patientcode, :ll_admissioncode FROM saleledger WHERE saleledger.saleinvcode =:al_saleinvcode USING this.it_transobject;
	ll_row = this.id_master.getrow()
	this.id_master.object.saleinvdate[ll_row] = ld_date
	this.id_master.object.smancode[ll_row] = ll_smancode
	this.id_master.object.admissioncode[ll_row] = ll_admissioncode
	if not isnull(ll_admissioncode) then
		SQL SELECT PatientCode INTO :ll_patientcode FROM PatientAdmission WHERE admissioncode =:ll_admissioncode and discharged1 ='N' and discharged ='N' USING this.it_transobject;
	end if
	this.id_master.object.patientcode[ll_row] = ll_patientcode
	if not isnull(ll_patientcode) then
		SQL SELECT regno INTO :ls_regno FROM Patient WHERE patientcode =:ll_patientcode USING this.it_transobject;
		this.id_master.object.patientregno[ll_row] = ls_regno
	end if

// w_inpatientsalereturn.wf_retrievelist() returns long
	string[] ls_posted
	integer li_saleretcategory
	ls_posted[1] = "N"
	if this.ii_salerettype = 1 then
		li_saleretcategory = this.ii_saleretcategory
	else
		li_saleretcategory = this.ii_salerettype
	end if
	return this.id_list.retrieve(li_saleretcategory, ls_posted, this.il_groupcode, this.ii_module)

// w_inpatientsalereturn.wf_retrievelistall() returns long
	string[] ls_posted
	integer li_saleretcategory
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_salerettype = 1 then
		li_saleretcategory = this.ii_saleretcategory
	else
		li_saleretcategory = this.ii_salerettype
	end if
	return this.id_list.retrieve(li_saleretcategory, ls_posted, this.il_groupcode, this.ii_module)

// w_inpatientsalereturn.wf_customerinfo(long al_custcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	string ls_aliasname
	long ll_currow
	SQL SELECT customer.address1 , customer.city , customer.phone , accounts.aliasname INTO :ls_address, :ls_city, :ls_phone, :ls_aliasname FROM customer , accounts WHERE customer.custcode =:al_custcode and customer.custcode =accounts.acccode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
		this.id_master.object.custcode[ll_currow] = al_custcode
		this.id_master.object.aliasname[ll_currow] = ls_aliasname
		this.id_master.object.address[ll_currow] = ls_address
		this.id_master.object.city[ll_currow] = ls_city
		this.id_master.object.phone[ll_currow] = ls_phone
	end if
	return this.it_transobject.sqlcode

// w_inpatientsalereturn.wf_customername(long al_custcode) returns integer
	string ls_custname
	SQL SELECT accounts.name INTO :ls_custname FROM accounts WHERE accounts.acccode =:al_custcode USING this.it_transobject;
	this.id_master.object.custname[this.id_master.getrow()] = ls_custname
	return this.it_transobject.sqlcode

// w_inpatientsalereturn.wf_duplicaterow(long al_currrow) returns boolean
	boolean lb_duplicate
	string ls_batch
	datetime ld_expiry
	long ll_gcode
	long ll_icode
	ls_batch = this.id_detail.getitemstring(al_currrow, "batch")
	ld_expiry = this.id_detail.getitemdatetime(al_currrow, "expiry")
	ll_gcode = this.id_detail.getitemnumber(al_currrow, "gcode")
	ll_icode = this.id_detail.getitemnumber(al_currrow, "icode")
	if not isnull(ll_gcode) and not isnull(ll_icode) and not isnull(ls_batch) and not isnull(ld_expiry) and vf_dwdupcodebatch(this.id_detail, "gcode", ll_gcode, "icode", ll_icode, "batch", ls_batch, "expiry", ld_expiry, al_currrow) then
		lb_duplicate = true
	end if
	return lb_duplicate

// w_inpatientsalereturn.wf_editsaleinvoice() returns integer
	long ll_rowcount
	long ll_counter
	long ll_saleinvcode
	long ll_rowscopy
	long ll_returneditems
	long ll_erroritems
	string ls_errtext
	integer li_errcode
	this.id_detail.setredraw(false)
	this.id_detail.reset()
	ll_saleinvcode = this.id_master.getitemnumber(this.id_master.getrow(), "saleinvcode")
	this.ib_itemvalidated = true
	this.id_detail.insertrow(0)
	ll_rowcount = this.idc_itemdddw.rowcount()
	ll_rowscopy = 1
	for ll_counter = 1 to ll_rowcount
		li_errcode = wf_inititeminfo(this.idc_itemdddw, ll_saleinvcode, ll_counter, ll_rowscopy, ls_errtext)
		if li_errcode = 1 then
			ll_returneditems = ll_returneditems + 1
		elseif li_errcode = -1 then
			ll_erroritems = ll_erroritems + 1
		else
			ll_rowscopy = ll_rowscopy + 1
			this.id_detail.insertrow(0)
		end if
	next
	this.id_detail.deleterow(ll_rowscopy)
	messagebox("Edit Sale Invoice Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowscopy - 1) + " records were retrieved successfully~n~r" + string(ll_returneditems) + " records has already been returned~n~r" + string(ll_erroritems) + " record's database info. cannot be retrieved")
	if ll_rowscopy - 1 > 0 then
		wf_setfooterinfo(ll_saleinvcode)
		this.id_footer.setitem(1, "stock", this.id_detail.getitemnumber(1, "stock"))
		this.id_footer.setitem(1, "saleqty", this.id_detail.getitemnumber(1, "saleqty"))
		this.id_footer.setitem(1, "retableqty", this.id_detail.getitemnumber(1, "retableqty"))
		if f_stringpreferences("BonusinSale") = "Y" then
			this.id_footer.setitem(1, "salebonusqty", this.id_detail.getitemnumber(1, "salebonusqty"))
			this.id_footer.setitem(1, "retablebonusqty", this.id_detail.getitemnumber(1, "retablebonusqty"))
		end if
		this.im_menu.m_file.m_save.enabled = true
		this.id_detail.scrolltorow(0)
		this.id_detail.setcolumn(1)
		this.id_detail.setfocus()
		wf_grandtotal()
	end if
	this.id_detail.setredraw(true)
	return ll_rowscopy

// w_inpatientsalereturn.wf_findcustcode(string as_aliasname, integer ai_custcode) returns integer
	integer li_custcode
	integer ll_retflag
	string ls_itemname
	SQL SELECT accounts.acccode INTO :li_custcode FROM accounts , customer WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =customer.custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_custcode = li_custcode
		if isnull(ai_custcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_inpatientsalereturn.wf_findregno(long al_patientcode) returns string
	string ls_regno
	SQL SELECT regno INTO :ls_regno FROM Patient WHERE Patient.PatientCode =:al_patientcode and patientcode IN ( select distinct patientcode from patientadmission where patientcode =:al_patientcode and discharged ='N' ) USING this.it_transobject;
	return ls_regno

// w_inpatientsalereturn.wf_updatesalereturnitemsstock(long al_saleretinvcode, string as_errtext, long al_errrow) returns integer
	long ll_detailrows
	long ll_gcode
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode
	long li_counter
	long li_innercounter
	long ll_row
	double ld_stock
	double ld_newstock
	double ld_saleretqty
	double ld_saleretbonusqty
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	string ls_batch
	datetime ld_expiry
	integer li_errcode
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	as_errtext = "    Some database problem ocuurs         "
	do while li_counter <= ll_detailrows and li_errcode = 0
		ll_gcode = this.id_detail.getitemnumber(li_counter, "gcode")
		ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
		ld_saleretqty = this.id_detail.getitemnumber(li_counter, "looseqty")
		ll_packunits = this.id_detail.getitemnumber(li_counter, "packunits")
		ld_saleprice = this.id_detail.getitemnumber(li_counter, "saleprice")
		ld_discperc = this.id_detail.getitemnumber(li_counter, "discperc")
		ls_batch = this.id_detail.getitemstring(li_counter, "batch")
		ld_expiry = this.id_detail.getitemdatetime(li_counter, "expiry")
		ld_stock = this.id_detail.getitemnumber(li_counter, "stock")
		ld_saleretbonusqty = this.id_detail.getitemnumber(li_counter, "bonusqty")
		this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
			if this.it_transobject.sqlcode = 0 then
				ld_newstock = ld_stock + ld_saleretqty + ld_saleretbonusqty
				this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
				if this.it_transobject.sqlcode <> 0 then
					li_errcode = -1
				end if
			else
				li_errcode = -1
			end if
		else
			li_errcode = -1
		end if
		li_counter = li_counter + 1
	loop
	al_errrow = li_counter - 1
	return li_errcode

// w_inpatientsalereturn.wf_validatefullcode(string as_fullcode, long al_currrow) returns integer
	return 0

// w_inpatientsalereturn.wf_returnsaleretinvoice() returns integer
	return 1

// w_inpatientsalereturn.wf_allowreturnmodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM SRDetail WHERE SRInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_inpatientsalereturn.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_inpatientsalereturn.wf_find_header_no(long al_saleinvcode) returns integer
	integer li_header_no
	SQL SELECT SaleLedger.headerno INTO :li_header_no FROM SaleLedger WHERE SaleLedger.Saleinvcode =:al_saleinvcode USING this.it_transobject;
	return li_header_no

// w_inpatientsalereturn.wf_initmodify(integer ai_protect) returns 0
	long ll_saleretinvcode
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_counter
	long ll_dddwrowcount
	long ll_dddwrow
	long ll_admissioncode
	double ld_stock
	double ld_itemsaleretqty
	double ld_saleqty
	double ld_prevretqty
	double ld_retableqty
	double ld_itemsaleqty
	double ld_itemsaleretbonusqty
	double ld_salebonusqty
	double ld_prevretbonusqty
	double ld_retablebonusqty
	string ls_batch
	datetime ld_expiry
	ai_protect = 1
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_saleretinvcode = this.id_detail.getitemnumber(1, "code")
		if wf_locksaleretinvoice(ll_saleretinvcode) = 0 then
			this.id_master.retrieve(ll_saleretinvcode)
			this.id_detail.retrieve(ll_saleretinvcode)
			ll_admissioncode = this.id_master.getitemnumber(1, "admissioncode")
			if wf_lockpatientadmission(ll_admissioncode) = 0 then
				ll_dddwrowcount = this.idc_itemdddw.rowcount()
			else
				ai_protect = 1
			end if
			for ll_counter = 1 to this.id_detail.rowcount()
				ll_gcode = this.id_detail.getitemnumber(ll_counter, "gcode")
				ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
				ld_itemsaleretqty = this.id_detail.getitemnumber(ll_counter, "looseqty")
				ld_itemsaleretbonusqty = this.id_detail.getitemnumber(ll_counter, "Bonusqty")
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					ai_protect = 0
					if not this.ib_opensalereturn then
						ls_batch = this.id_detail.getitemstring(ll_counter, "batch")
						ld_expiry = this.id_detail.getitemdatetime(ll_counter, "Expiry")
						if wf_itemprevretqty(ll_saleinvcode, ll_gcode, ll_icode, ls_batch, ld_expiry, ld_prevretqty, ld_prevretbonusqty) = 0 then
							ll_dddwrow = this.idc_itemdddw.find("icode = long('" + string(ll_icode) + "')", 1, ll_dddwrowcount)
							ld_saleqty = this.idc_itemdddw.getitemnumber(ll_dddwrow, "looseqty")
							ld_salebonusqty = this.idc_itemdddw.getitemnumber(ll_dddwrow, "Bonusqty")
							ld_retableqty = ld_saleqty - ld_prevretqty
							ld_retablebonusqty = ld_salebonusqty - ld_prevretbonusqty
						else
							ai_protect = 1
						end if
					else
						ld_retableqty = 0
						ld_saleqty = 0
						ld_retablebonusqty = 0
						ld_salebonusqty = 0
					end if
					this.id_detail.setitem(ll_counter, "stock", ld_stock)
					this.id_detail.setitem(ll_counter, "retableqty", ld_retableqty)
					this.id_detail.setitem(ll_counter, "saleqty", ld_saleqty)
					this.id_detail.setitem(ll_counter, "retableBonusqty", ld_retablebonusqty)
					this.id_detail.setitem(ll_counter, "saleBonusqty", ld_salebonusqty)
					this.id_footer.setitem(1, "retableQty", ld_retableqty)
					this.id_footer.setitem(1, "stock", ld_stock)
					this.id_footer.setitem(1, "saleqty", ld_saleqty)
					this.id_footer.setitem(1, "retableBonusQty", ld_retablebonusqty)
					this.id_footer.setitem(1, "saleBonusqty", ld_salebonusqty)
				end if
			next
			if ai_protect = 0 then
				this.ib_modify = true
				this.id_footer.setitem(1, "stock", this.id_detail.getitemnumber(1, "stock"))
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
		end if
	end if

// w_inpatientsalereturn.wf_lockpatientadmission(long al_admissioncode) returns integer
	integer li_count
	SQL rollback USING this.it_transobject;
	SQL Select count ( *) INTO :li_count From PatientAdmission WITH ( UPDLOCK HOLDLOCK ) Where PatientAdmission.AdmissionCode =:al_admissioncode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_inpatientsalereturn.wf_findpatientcode(integer ai_admissioncode) returns integer
	integer li_patientcode
	SQL SELECT patientcode INTO :li_patientcode FROM patientadmission WHERE admissioncode =:ai_admissioncode USING this.it_transobject;
	return li_patientcode

// w_inpatientsalereturn.wf_fetchreturnableitems(long al_row, long al_admissioncode) returns integer
	long ll_detailrows
	long ll_custcode
	long ll_smancode
	integer li_rtcode
	integer li_result
	integer li_header_no
	datetime ld_datetime
	boolean lb_rtflag
	string ls_errtext
	string ls_batch
	dwitemstatus lrs_status
	if not isnull(al_admissioncode) and al_admissioncode > 0 then
		ll_detailrows = this.id_detail.rowcount()
		if ll_detailrows > 0 then
			lrs_status = this.id_detail.getitemstatus(1, 0, primary!)
			if lrs_status <> new! and not isnull(this.id_detail.getitemnumber(1, "icode")) then
				li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
				if li_result = 2 then
					li_rtcode = 2
				else
					this.id_detail.setredraw(false)
					this.id_detail.reset()
					this.id_detail.insertrow(0)
					this.id_detail.setfocus()
					this.id_detail.setredraw(true)
				end if
			end if
		end if
		if li_rtcode = 0 then
			li_rtcode = wf_lockpatientadmission(al_admissioncode)
			if li_rtcode = 0 then
				this.id_detail.setredraw(false)
				this.idc_itemdddw.retrieve(al_admissioncode)
				this.id_detail.setredraw(true)
				this.ids_saleinv.retrieve(al_admissioncode)
				this.ids_saleinv.sharedata(this.id_itemslist)
			else
				ls_errtext = "Some Problem occured at database,~r~nPlease try later"
				li_rtcode = 1
			end if
		end if
	else
		li_rtcode = 1
	end if
	if li_rtcode = 1 then
		messagebox("Patient Validation", ls_errtext)
	end if
	return li_rtcode

// w_inpatientsalereturn.wf_selectprintreport() returns string
	string ls_pagesize
	string ls_report
	ls_pagesize = f_stringpreferences("pagesize")
	if ls_pagesize = "Q" then
		if gs_company = "KHYBER" then
			ls_report = "d_khyber_thermal_saleretinvrep"
		else
			ls_report = "d_inpatientsaleretinvrep"
		end if
	elseif ls_pagesize = "F" then
		ls_report = "d_inpatientsaleretinvrep_full"
	elseif ls_pagesize = "H" then
		if gs_company = "KHYBER" then
			ls_report = "d_khyber_inpatientsaleretinvrep_half"
		else
			ls_report = "d_inpatientsaleretinvrep_half"
		end if
	elseif ls_pagesize = "T" then
		ls_report = "d_thermal_wholesaleretinvreport_3inches"
	end if
	this.id_print.dataobject = ls_report
	this.id_print.settransobject(this.it_transobject)
	return ls_report

// w_inpatientsalereturn.wf_itemsalehistory() returns 0
	s_itemsalehistory ls_itemsalehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itemsalehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itemsalehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itemsalehistory, ls_itemsalehistory)
	end if

// w_inpatientsalereturn.wf_prevsaleinvinfo() returns 0
	s_previnvinfo ls_previnvinfo
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_previnvinfo.ar_customer = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		ls_previnvinfo.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_previnvinfo.ar_invdate = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_previnvinfo, ls_previnvinfo)
	end if

// w_inpatientsalereturn.wf_allowsalereturn(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns integer
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM SaleDetail WHERE SaleInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_inpatientsalereturn.wf_findretailsaleinvoice(long al_saleinvcode, datetime ad_date, string as_errtext) returns integer
	integer li_rtcode
	string ls_posted
	SQL SELECT SaleLedger.date , posted INTO :ad_date, :ls_posted FROM SaleLedger WHERE SaleLedger.Saleinvcode =:al_saleinvcode AND SaleLedger.SaleCatCode =3 USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ls_posted) then
			as_errtext = "You must select some valid Retail Sale Invoice"
			li_rtcode = 1
		elseif ls_posted = "Y" then
			li_rtcode = 0
		else
			li_rtcode = 1
			as_errtext = "Sale invoice " + string(al_saleinvcode) + " is unposted~n~rOnly Posted invoices can be returned"
		end if
		if li_rtcode = 0 and wf_allowsalereturn(al_saleinvcode, f_getgroupcode(gl_usercode), this.il_strategy) <> 0 then
			li_rtcode = 1
			as_errtext = "Sale invoice " + string(al_saleinvcode) + " contains items of non allowed godown(s)~n~rYou Can not Make Return"
		end if
	else
		li_rtcode = 1
		as_errtext = "Database Error, Some database request fails"
	end if
	return li_rtcode

// w_inpatientsalereturn.wf_findwholesaleinvoice(long al_saleinvcode, datetime ad_date, string as_errtext) returns integer
	integer li_rtcode
	long ll_admissioncode
	string ls_posted
	setnull(ll_admissioncode)
	SQL SELECT SaleLedger.date , Posted , admissioncode INTO :ad_date, :ls_posted, :ll_admissioncode FROM SaleLedger WHERE SaleLedger.Saleinvcode =:al_saleinvcode AND ( SaleLedger.SaleCatCode =1 OR SaleLedger.SaleCatCode =2 ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ls_posted) then
			as_errtext = "You must select some valid Whole Sale Invoice"
			li_rtcode = 1
		elseif ls_posted = "Y" then
			li_rtcode = 0
		else
			li_rtcode = 1
			as_errtext = "Sale invoice " + string(al_saleinvcode) + " is unposted~n~rOnly Posted invoices can be returned"
		end if
		if li_rtcode = 0 and wf_allowsalereturn(al_saleinvcode, f_getgroupcode(gl_usercode), this.il_strategy) <> 0 then
			li_rtcode = 1
			as_errtext = "Sale invoice " + string(al_saleinvcode) + " contains items of non allowed godown(s)~n~rYou Can not Make Return"
		end if
		if li_rtcode = 0 and not isnull(ll_admissioncode) then
			SQL SELECT admissioncode INTO :ll_admissioncode FROM PatientAdmission WHERE admissioncode =:ll_admissioncode AND discharged1 ='N' and discharged ='N' USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				li_rtcode = 0
			else
				as_errtext = "Patient Discharged, Can not Return after discharge"
				li_rtcode = 1
			end if
		end if
	else
		li_rtcode = 1
		as_errtext = "Database Error, Some database request fails"
	end if
	return li_rtcode

// w_inpatientsalereturn.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	long ll_icode
	long ll_retflag
	long ll_rowid
	string ls_itemname
	ll_rowid = this.id_itemslist.find("fullcode = '" + as_fullcode + "'", 1, this.id_itemslist.rowcount())
	if ll_rowid > 0 then
		al_icode = this.id_itemslist.getitemnumber(ll_rowid, "icode")
		al_itemname = this.id_itemslist.getitemstring(ll_rowid, "itemname")
		this.id_itemslist.setrow(ll_rowid)
		ll_retflag = 1
	else
		ll_retflag = 0
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_inpatientsalereturn.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_invtaxpercval
	double ld_totaltax
	double ld_itemleveltax
	double ld_invtaxperc1
	double lr_discperc
	double lr_flatdisc
	double lr_misccharges
	double lr_salestax
	double lr_itemstotal
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		lr_discperc = this.id_footer.object.discperc[1]
		lr_flatdisc = this.id_footer.object.flatdisc[1]
		lr_misccharges = this.id_footer.object.misccharges[1]
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
		ld_invtaxperc1 = this.id_footer.object.invgstperc1[1]
		ld_invtaxpercval = round(ld_detaildwtotal * ld_invtaxperc1 * 0.01, 2)
		ld_itemleveltax = this.id_detail.getitemnumber(1, "c_sumgstval") + this.id_detail.getitemnumber(1, "c_sumtaxval")
		ld_totaltax = round(ld_invtaxpercval + ld_itemleveltax, 0)
		ld_grandtotal = ld_detaildwtotal * (1.0 - lr_discperc * 0.01) - lr_flatdisc + lr_misccharges + lr_salestax
		ld_grandtotal = round(ld_grandtotal, 0) + ld_totaltax
		this.id_footer.setitem(1, "total", ld_grandtotal)
	end if
	return ld_grandtotal

// w_inpatientsalereturn.wf_setadmissiondetails(long al_admissioncode) returns long
	long ll_retflag
	long ll_doctcode
	long ll_locationcode
	SQL SELECT patientadmission.doctorcode , patientadmission.locationcode INTO :ll_doctcode, :ll_locationcode FROM patientadmission WHERE patientadmission.Admissioncode =:al_admissioncode AND patientadmission.discharged1 ='N' and patientadmission.discharged ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.object.doctcode[this.id_master.getrow()] = ll_doctcode
		this.id_master.object.locationcode[this.id_master.getrow()] = ll_locationcode
		ll_retflag = 1
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_inpatientsalereturn.wf_admitted(long al_admissioncode) returns long
	long ll_count
	SQL SELECT Count ( *) INTO :ll_count FROM PatientAdmission WHERE PatientAdmission.AdmissionCode =:al_admissioncode AND PatientAdmission.Discharged ='N' USING sqlca;
	return ll_count

// w_inpatientsalereturn.wf_inititeminfo(datawindowchild adc_itemdddw, long al_saleinvcode, long al_dsrow, long al_detaildwrow, string as_errtext) returns integer
	long ll_icode
	long ll_gcode
	long ll_packunits
	double ld_saleprice
	double ld_discperc
	double ld_unitsalestax
	double ld_gstperc
	double ld_basicdatasaleprice
	string ls_fullcode
	string ls_batch
	string ls_itemname
	datetime ld_expiry
	integer li_errcode
	double ld_retableqty
	double ld_itemprevqty
	double ld_itemsaleqty
	double ld_stock
	double ld_itemsalebonusqty
	double ld_retablebonusqty
	double ld_itemprevbonusqty
	ll_icode = adc_itemdddw.getitemnumber(al_dsrow, "icode")
	SQL SELECT saleprice , packunits INTO :ld_basicdatasaleprice, :ll_packunits FROM Item WHERE icode =:ll_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_gcode = adc_itemdddw.getitemnumber(al_dsrow, "gcode")
		ll_icode = adc_itemdddw.getitemnumber(al_dsrow, "icode")
		ls_fullcode = adc_itemdddw.getitemstring(al_dsrow, "fullcode")
		ls_batch = adc_itemdddw.getitemstring(al_dsrow, "batch")
		ld_expiry = adc_itemdddw.getitemdatetime(al_dsrow, "Expiry")
		ld_saleprice = adc_itemdddw.getitemnumber(al_dsrow, "saleprice")
		ld_discperc = adc_itemdddw.getitemnumber(al_dsrow, "discperc")
		ld_itemsaleqty = adc_itemdddw.getitemnumber(al_dsrow, "looseqty")
		ld_itemsalebonusqty = adc_itemdddw.getitemnumber(al_dsrow, "bonusqty")
		ld_unitsalestax = adc_itemdddw.getitemnumber(al_dsrow, "unitsalestax")
		ld_gstperc = adc_itemdddw.getitemnumber(al_dsrow, "gstperc")
		ls_itemname = this.id_itemslist.getitemstring(al_dsrow, "itemname")
		ld_retableqty = ld_itemsaleqty - adc_itemdddw.getitemnumber(al_dsrow, "returnqty")
		ld_retablebonusqty = ld_itemsalebonusqty - adc_itemdddw.getitemnumber(al_dsrow, "returnbonusqty")
		if ld_retableqty > 0.0 or ld_retablebonusqty > 0.0 then
			if this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock) = 0 then
				if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
					ll_gcode = this.id_detail.getitemnumber(al_detaildwrow, "gcode")
				end if
				this.id_detail.setitem(al_detaildwrow, "gcode", ll_gcode)
				this.id_detail.setitem(al_detaildwrow, "icode", ll_icode)
				this.id_detail.setitem(al_detaildwrow, "fullcode", ls_fullcode)
				this.id_detail.setitem(al_detaildwrow, "batch", ls_batch)
				this.id_detail.setitem(al_detaildwrow, "expiry", ld_expiry)
				this.id_detail.setitem(al_detaildwrow, "srprice", ld_saleprice)
				this.id_detail.setitem(al_detaildwrow, "discperc", ld_discperc)
				this.id_detail.setitem(al_detaildwrow, "Bonusqty", ld_retablebonusqty)
				this.id_detail.setitem(al_detaildwrow, "looseqty", ld_retableqty)
				this.id_detail.setitem(al_detaildwrow, "stock", ld_stock)
				this.id_detail.setitem(al_detaildwrow, "saleqty", ld_itemsaleqty)
				this.id_detail.setitem(al_detaildwrow, "retableqty", ld_retableqty)
				this.id_detail.setitem(al_detaildwrow, "salebonusqty", ld_itemsalebonusqty)
				this.id_detail.setitem(al_detaildwrow, "retablebonusqty", ld_retablebonusqty)
				this.id_detail.setitem(al_detaildwrow, "packunits", ll_packunits)
				this.id_detail.setitem(al_detaildwrow, "itemname", ls_itemname)
				this.id_detail.setitem(al_detaildwrow, "unitsalestax", ld_unitsalestax)
				this.id_detail.setitem(al_detaildwrow, "gstperc", ld_gstperc)
				this.id_detail.setitem(al_detaildwrow, "saleprice", ld_basicdatasaleprice / ll_packunits)
				this.id_footer.setitem(1, "stock", ld_stock)
				this.id_footer.setitem(1, "saleqty", ld_itemsaleqty)
				this.id_footer.setitem(1, "retableqty", ld_retableqty)
				this.id_footer.setitem(1, "saleBonusqty", ld_itemsalebonusqty)
				this.id_footer.setitem(1, "retableBonusqty", ld_retablebonusqty)
			else
				as_errtext = "Can not retrieve item stock information"
				li_errcode = 1
			end if
		else
			as_errtext = "Item Qty and Bonus has already been returned"
			li_errcode = 1
		end if
	else
		li_errcode = -1
		as_errtext = "Unable To Retrieve SalePrice from Item Basic Data"
	end if
	return li_errcode

// w_inpatientsalereturn.wf_inititeminfo(long al_icode, long al_row, string as_errortext) returns integer
	double ld_saleprice
	double ld_discperc
	double ld_unitsalestax
	double ld_gstperc2
	double ld_gstperc1
	long ll_packunits
	long ll_saleinvcode
	integer li_gcode
	integer retflag
	integer li_custcode
	integer li_defaultgst
	string ls_fullcode
	string ls_name
	double ld_godownstock
	double ld_saleqty
	li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
	SQL SELECT item.customicode , item.name , item.saleprice , item.packunits , item.salediscperc , item.gstperc1 , item.gstperc2 , Round ( item.packsalestax / item.packunits , 2 ) INTO :ls_fullcode, :ls_name, :ld_saleprice, :ll_packunits, :ld_discperc, :ld_gstperc1, :ld_gstperc2, :ld_unitsalestax FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = 0 then
		li_custcode = this.id_master.getitemnumber(1, "custcode")
		if isnull(li_custcode) then
			retflag = -1
			as_errortext = "Validation Error: Select Customer "
		end if
		SQL SELECT defaultGST INTO :li_defaultgst FROM customer WHERE customer.custcode =:li_custcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
			if this.it_transobject.sqlcode = 0 then
				this.id_detail.setitem(al_row, "gcode", li_gcode)
				this.id_detail.setitem(al_row, "icode", al_icode)
				this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
				this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
				this.id_detail.setitem(al_row, "srprice", ld_saleprice / ll_packunits)
				this.id_detail.setitem(al_row, "packunits", ll_packunits)
				this.id_detail.setitem(al_row, "discperc", ld_discperc)
				this.id_detail.setitem(al_row, "stock", ld_godownstock)
				this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
				if li_defaultgst = 2 then
					this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
				else
					this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
				end if
				this.id_footer.setitem(1, "stock", ld_godownstock)
			else
				retflag = -1
				as_errortext = "Database Error: Item Stock information can not be retrieved"
			end if
		else
			retflag = -1
			as_errortext = "Database Error: Item information can not be retrieved"
		end if
	else
		retflag = -1
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	return retflag

// w_inpatientsalereturn.wf_validateitem() returns integer
	long ll_icode
	long ll_dddwrow
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_null
	string ls_null
	ll_dddwrow = this.id_itemslist.getrow()
	if wf_inititeminfo(this.idc_itemdddw, this.il_currrow, ll_dddwrow, ls_errtext) = 0 then
		if wf_duplicaterow(this.il_currrow) then
			ls_errtext = "Duplicate item, an item with same attributes already exist, ~n~rPlease enter some other"
			li_errcode = -1
		end if
	else
		ls_titleerrtext = "Item Validation"
		li_errcode = -1
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		if f_stringpreferences("ItemCode") = "N" then
			this.id_detail.setcolumn(this.is_columnitemname)
		else
			this.id_detail.setcolumn("fullCode")
		end if
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.setitem(this.il_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(this.il_currrow, "fullcode", ls_null)
		messagebox(ls_titleerrtext, ls_errtext)
	end if
	return li_errcode

// w_inpatientsalereturn.wf_inititeminfo(datawindowchild adc_itemdddw, long al_row, long al_dddwrow, string as_errtext) returns integer
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_saleinvcode
	double ld_retableqty
	double ld_stock
	double ld_itemprevqty
	double ld_itemsaleqty
	double ld_itemsalebonusqty
	double ld_retablebonusqty
	double ld_itemprevbonusqty
	double ld_saleprice
	double ld_discperc
	double ld_unitsalestax
	double ld_gstperc
	double ld_basicdatasaleprice
	string ls_fullcode
	string ls_batch
	string ls_itemname
	datetime ld_expiry
	integer li_errcode
	ll_icode = this.id_itemslist.getitemnumber(al_dddwrow, "icode")
	SQL SELECT saleprice , packunits INTO :ld_basicdatasaleprice, :ll_packunits FROM Item WHERE icode =:ll_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_gcode = this.id_detail.getitemnumber(al_row, "gcode")
		ll_icode = this.id_itemslist.getitemnumber(al_dddwrow, "icode")
		ls_fullcode = this.id_itemslist.getitemstring(al_dddwrow, "fullcode")
		ls_batch = this.id_itemslist.getitemstring(al_dddwrow, "batch")
		ld_expiry = this.id_itemslist.getitemdatetime(al_dddwrow, "Expiry")
		ld_saleprice = this.id_itemslist.getitemnumber(al_dddwrow, "saleprice")
		ld_discperc = this.id_itemslist.getitemnumber(al_dddwrow, "discperc")
		ld_unitsalestax = this.id_itemslist.getitemnumber(al_dddwrow, "unitsalestax")
		ld_gstperc = this.id_itemslist.getitemnumber(al_dddwrow, "gstperc")
		ls_itemname = this.id_itemslist.getitemstring(al_dddwrow, "itemname")
		ld_itemsaleqty = this.id_itemslist.getitemnumber(al_dddwrow, "looseqty")
		ld_retableqty = ld_itemsaleqty - this.id_itemslist.getitemnumber(al_dddwrow, "returnqty")
		if f_stringpreferences("BonusinSale") = "Y" then
			ld_itemsalebonusqty = this.id_itemslist.getitemnumber(al_dddwrow, "Bonusqty")
			ld_retablebonusqty = ld_itemsalebonusqty - this.id_itemslist.getitemnumber(al_dddwrow, "returnbonusqty")
		end if
		if ld_retableqty > 0.0 or ld_retablebonusqty > 0.0 then
			if this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock) = 0 then
				if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
					ll_gcode = this.id_detail.getitemnumber(al_row, "gcode")
				end if
				this.id_detail.setitem(al_row, "gcode", ll_gcode)
				this.id_detail.setitem(al_row, "icode", ll_icode)
				this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
				this.id_detail.setitem(al_row, "batch", ls_batch)
				this.id_detail.setitem(al_row, "expiry", ld_expiry)
				this.id_detail.setitem(al_row, "srprice", ld_saleprice)
				this.id_detail.setitem(al_row, "discperc", ld_discperc)
				this.id_detail.setitem(al_row, "Bonusqty", ld_retablebonusqty)
				this.id_detail.setitem(al_row, "looseqty", ld_retableqty)
				this.id_detail.setitem(al_row, "retableqty", ld_retableqty)
				this.id_detail.setitem(al_row, "saleqty", ld_itemsaleqty)
				this.id_detail.setitem(al_row, "saleBonusqty", ld_itemsalebonusqty)
				this.id_detail.setitem(al_row, "retableBonusqty", ld_retablebonusqty)
				this.id_detail.setitem(al_row, "stock", ld_stock)
				this.id_detail.setitem(al_row, "packunits", ll_packunits)
				this.id_detail.setitem(al_row, "itemname", ls_itemname)
				this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc)
				this.id_detail.setitem(al_row, "saleprice", ld_basicdatasaleprice / ll_packunits)
				this.id_footer.setitem(1, "retableqty", ld_retableqty)
				this.id_footer.setitem(1, "saleqty", ld_itemsaleqty)
				this.id_footer.setitem(1, "retablebonusqty", ld_retablebonusqty)
				this.id_footer.setitem(1, "salebonusqty", ld_itemsalebonusqty)
				this.id_footer.setitem(1, "stock", ld_stock)
			else
				as_errtext = "Can not retrieve item stock information"
				li_errcode = -1
			end if
		else
			as_errtext = "item qty has already been returned"
			li_errcode = 1
		end if
	else
		li_errcode = -1
		as_errtext = "Unable To Get Item's Information"
	end if
	return li_errcode

// w_inpatientsalereturn.wf_checkitemactiveness(long al_icode, string as_errtext, long al_count, long[] al_activeitemslist) returns long
	long ll_activestatus
	long ll_setactive
	ll_activestatus = this.it_transobject.isactiveitem(al_icode)
	if this.it_transobject.sqlcode = 0 then
		if ll_activestatus = -1 then
			as_errtext = "Problem in Fetching Item Active Status:~r~n" + this.it_transobject.sqlerrtext
			return -1
		elseif ll_activestatus = 0 then
			this.it_transobject.setitemactivestatus(al_icode, 1)
			if this.it_transobject.sqlcode <> 0 then
				as_errtext = "Problem in Fetching Item Active Status:~r~n" + this.it_transobject.sqlerrtext
				return -1
			else
				al_count = al_count + 1
				al_activeitemslist[al_count] = al_icode
			end if
		end if
	else
		as_errtext = "Problem in Fetching Item Active Status:~r~n" + this.it_transobject.sqlerrtext
		return -1
	end if
	return 0

// w_inpatientsalereturn.wf_itemprevretqty(long al_saleinvcode, long al_gcode, long al_icode, string as_batch, datetime ad_expiry, double ad_itemprevqty, double ad_itemprevbonusqty) returns integer
	SQL SELECT IsNull ( Sum ( srdetail.looseqty ) , 0 ) , IsNull ( Sum ( srdetail.Bonusqty ) , 0 ) INTO :ad_itemprevqty, :ad_itemprevbonusqty FROM srledger , srdetail WHERE srledger.saleinvcode =:al_saleinvcode and srledger.posted ='Y' and srledger.srinvcode =srdetail.SRInvCode and srdetail.icode =:al_icode and srdetail.batch =:as_batch and srdetail.expiry =:ad_expiry USING this.it_transobject;
	if isnull(ad_itemprevqty) then
		ad_itemprevqty = 0
	end if
	if isnull(ad_itemprevbonusqty) then
		ad_itemprevbonusqty = 0
	end if
	return this.it_transobject.sqlcode

// w_inpatientsalereturn.wf_validatebonusqty(long al_row, double ad_bonusqty) returns integer
	integer li_rtcode
	double ld_retablebonusqty
	ld_retablebonusqty = this.id_detail.getitemnumber(al_row, "retablebonusqty")
	if ad_bonusqty > ld_retablebonusqty then
		li_rtcode = 1
		messagebox("Bonus Qty Validation", "    Bonus Qty Should Not Exceed From " + string(ld_retablebonusqty))
	end if
	return li_rtcode

// w_inpatientsalereturn.wf_validateqty(long al_row, double ad_qty) returns integer
	integer li_rtcode
	double ld_retableqty
	ld_retableqty = this.id_detail.getitemnumber(al_row, "retableqty")
	if ad_qty > ld_retableqty then
		li_rtcode = 1
		messagebox("Quantity Validation", "    Qty Should be less than " + string(ld_retableqty))
	end if
	return li_rtcode

// w_inpatientsalereturn.wf_set_itemtotal_formatmask() returns long
	string ls_modify
	string ls_format
	ls_format = trim(f_stringpreferences("FormatForAmtInSRet"))
	ls_modify = "c_itemtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_detaildwtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_finalitemval.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_sumfinalitemval.Format='" + ls_format + "'  "
	this.id_detail.modify(ls_modify)
	return 0

// w_inpatientsalereturn.wf_assign_master_cash_win_object() returns 0
	this.ids_cashwin = create u_ds_standard
	this.ids_cashwin.dataobject = "d_mastercashierwindow_detail"
	this.ids_cashwin.settransobject(this.it_transobject)

// w_inpatientsalereturn.wf_set_cashaccount() returns long
	long ll_cashacccode
	long ll_module
	long ll_code
	ll_module = 34
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = f_is_group_module_cashaccount_allowed(this.il_groupcode, ll_module)
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		ll_cashacccode = 0
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
	elseif isnull(ll_code) or this.id_master.object.code[1] <= 0 then
		this.id_master.object.cashacccode[this.id_master.rowcount()] = ll_cashacccode
	else
		ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	end if
	return ll_cashacccode

// w_inpatientsalereturn.wf_show_mastercashierwindow() returns long
	long ll_counter
	long ll_code
	long ll_row
	long ll_insrow
	long ll_module
	long ll_cashacccode
	double ld_tot_acc_amt
	s_mastercashwin_all lstr_values
	lstr_values.i_interfacecode = 11
	if f_stringpreferences("askmastercashwin_in_inpatientsr") = "N" then
		return 1
	end if
	ll_module = 34
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
		return 0
	end if
	lstr_values.l_doccode = ll_code
	lstr_values.s_doctype = this.is_doctype
	lstr_values.l_cashacccode = ll_cashacccode
	lstr_values.l_groupcode = this.il_groupcode
	lstr_values.l_module = ll_module
	lstr_values.d_netamt = wf_grandtotal()
	lstr_values.d_cashtendered = this.id_master.object.cashtendered[this.id_master.rowcount()]
	lstr_values.d_cashcharged = this.id_master.object.cashcharged[this.id_master.rowcount()]
	lstr_values.d_cashback = this.id_master.object.cashback[this.id_master.rowcount()]
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		lstr_values.l_acccode[ll_counter] = this.ids_cashwin.object.acccode[ll_counter]
		lstr_values.s_remarks[ll_counter] = this.ids_cashwin.object.remarks[ll_counter]
		lstr_values.d_amount[ll_counter] = this.ids_cashwin.object.amount[ll_counter]
		lstr_values.l_rowid[ll_counter] = this.ids_cashwin.object.rowid[ll_counter]
		ld_tot_acc_amt = ld_tot_acc_amt + this.ids_cashwin.object.amount[ll_counter]
	next
	if lstr_values.d_netamt >= lstr_values.d_cashcharged then
		lstr_values.d_docbalance = lstr_values.d_netamt - lstr_values.d_cashcharged - ld_tot_acc_amt
	else
		lstr_values.d_docbalance = 0
	end if
	for ll_counter = 1 to 100
		if lstr_values.l_rowid[ll_counter] <= 0 then
			lstr_values.l_rowid[ll_counter] = -1
		end if
	next
	openwithparm(w_mastercashierwindow, lstr_values)
	lstr_values = message.powerobjectparm
	if lstr_values.i_status = 1 then
		this.ids_cashwin.reset()
		ld_tot_acc_amt = 0
		for ll_counter = 1 to 100
			if lstr_values.l_acccode[ll_counter] > 0 and lstr_values.d_amount[ll_counter] > 0 and lstr_values.l_rowid[ll_counter] > 0 then
				ll_insrow = this.ids_cashwin.insertrow(0)
				this.ids_cashwin.object.documentcode[ll_insrow] = ll_code
				this.ids_cashwin.object.documenttype[ll_insrow] = this.is_doctype
				this.ids_cashwin.object.acccode[ll_insrow] = lstr_values.l_acccode[ll_counter]
				this.ids_cashwin.object.remarks[ll_insrow] = lstr_values.s_remarks[ll_counter]
				this.ids_cashwin.object.amount[ll_insrow] = lstr_values.d_amount[ll_counter]
				this.ids_cashwin.object.rowid[ll_insrow] = lstr_values.l_rowid[ll_counter]
			end if
		next
		this.id_master.object.cashacccode[this.id_master.rowcount()] = lstr_values.l_cashacccode
		this.id_master.object.cashtendered[this.id_master.rowcount()] = lstr_values.d_cashtendered
		this.id_master.object.cashcharged[this.id_master.rowcount()] = lstr_values.d_cashcharged
		this.id_master.object.cashback[this.id_master.rowcount()] = lstr_values.d_cashback
		return 1
	end if
	return 0

// w_inpatientsalereturn.wf_update_mastercashierwindow(long al_code, string as_type) returns long
	long ll_counter
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		this.ids_cashwin.object.documentcode[ll_counter] = al_code
		this.ids_cashwin.object.documenttype[ll_counter] = as_type
		this.ids_cashwin.object.date[ll_counter] = this.id_master.object.date[1]
	next
	SQL DELETE DBO.MasterCashWin WHERE DocumentCode =:al_code AND DocumentType =:as_type USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if this.ids_cashwin.update() > 0 then
			return 0
		else
			return -1
		end if
		return
	end if
	return -1

// w_inpatientsalereturn.wf_findadmissioncode(string as_regno, long al_admissioncode) returns long
	integer ll_retflag
	SQL SELECT patientadmission.admissioncode INTO :al_admissioncode FROM patient , patientadmission WHERE patient.regno =:as_regno AND patient.patientcode =patientadmission.patientcode and patientadmission.discharged ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(al_admissioncode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_inpatientsalereturn.create() returns 0
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_inpatientsalereturnmenu" then
		this.menuid = create m_inpatientsalereturnmenu
	end if
	this.dw_print = create dw_print
	this.ic_comport = create ic_comport
	this.ic_cashdrawer = create ic_cashdrawer
	this.ic_cashdrawerprinter = create ic_cashdrawerprinter
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print
	this.control[icurrent + 2] = this.ic_comport
	this.control[icurrent + 3] = this.ic_cashdrawer
	this.control[icurrent + 4] = this.ic_cashdrawerprinter

// w_inpatientsalereturn.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_print
	destroy this.ic_comport
	destroy this.ic_cashdrawer
	destroy this.ic_cashdrawerprinter

// w_inpatientsalereturn.ue_save() returns 0
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_salesmancode
	long ll_rowcount
	long ll_icode
	long ll_gcode
	long ll_headerno
	long ll_headerinvno
	long ll_counter
	long ll_patientcode
	long ll_activestatus
	long ll_setasactive_count
	long[] ll_activeitemslist
	long ll_found
	long ll_saveresult
	boolean lb_commitflag
	boolean lb_continue
	integer li_errcode
	integer li_pos
	datetime ld_expiry
	string ls_errtext
	string ls_batch
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_avgprice
	double ld_invgstperc
	double ld_qty
	double ld_bonusqty
	double ld_stock
	double ld_newstock
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	datetime ldt_server_datetime
	string ls_date_errtext
	datawindowchild ldc_headerno
	string ls_env_name
	string ls_env_val
	long ll_env_len
	s_datastore lstr_arg
	datastore lds_items
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	if this.id_detail.rowcount() <= 0 then
		return
	end if
	ll_found = this.id_detail.find("looseqty + bonusqty <= 0 ", 1, this.id_detail.rowcount())
	if ll_found > 0 then
		messagebox("Sale Qty Validation", "Please Enter Valid Sale Qty in Row " + string(ll_found))
		this.id_detail.setfocus()
		this.id_detail.scrolltorow(ll_found)
		this.id_detail.setcolumn("looseqty")
		return
	end if
	if not isnull(this.id_master.object.admissioncode[this.id_master.getrow()]) then
		if wf_admitted(this.id_master.object.admissioncode[this.id_master.getrow()]) <= 0 then
			messagebox("Problem Saving", "Patient No more Admitted.~r~nChoose some other patient")
			this.id_master.setfocus()
			this.id_master.setcolumn("admissioncode")
			return
		end if
	else
		messagebox("Problem Saving", "Invalid Patient.~r~nChoose some other patient")
		this.id_master.setfocus()
		this.id_master.setcolumn("admissioncode")
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if wf_set_cashaccount() = 0 then
		return
	end if
	if f_stringpreferences("AskUserPwdInSaleReturn") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
	else
		ll_salesmancode = gl_usercode
	end if
	setfocus()
	if ll_salesmancode > 0 then
		SQL rollback USING sqlca;
		ul_rowcount = this.id_detail.rowcount()
		sqlca.getmaxutn(ul_rowcount, ul_maxutn)
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
			messagebox("Saving", "Error in generating Utn")
			return
		end if
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_rowcount = this.id_detail.rowcount()
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "custcode")
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if wf_show_mastercashierwindow() = 0 then
			return
		end if
		if isnull(ll_invid) then
			f_newtableid("srledger", ll_invid)
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
				this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
			end if
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
		else
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		end if
		this.id_master.getchild("headerno", ldc_headerno)
		if f_stringpreferences("Headeronsalereturninv") = "N" then
			this.id_master.setitem(ll_mastercurrrow, "Headerno", ldc_headerno.getitemnumber(ll_mastercurrrow, "code"))
		end if
		ll_headerno = this.id_master.getitemnumber(ll_mastercurrrow, "headerno")
		ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
		if isnull(ll_headerinvno) then
			f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
			if ll_headerinvno > 0 then
				this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
			end if
		end if
		ld_misccharges = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges")
		ld_invdiscperc = this.id_footer.getitemnumber(ll_footercurrrow, "discperc")
		ld_flatdisc = this.id_footer.getitemnumber(ll_footercurrrow, "flatdisc")
		ld_invgstperc = this.id_footer.getitemnumber(ll_footercurrrow, "invgstperc1")
		this.id_master.setitem(ll_mastercurrrow, "invgstperc1", ld_invgstperc)
		ls_env_name = "COMPUTERNAME"
		ls_env_val = space(20)
		ll_env_len = 20
		ll_env_len = getenvironmentvariablea(ls_env_name, ls_env_val, ll_env_len)
		this.id_master.setitem(ll_mastercurrrow, "machinename", ls_env_val)
		this.id_master.setitem(ll_mastercurrrow, "discperc", ld_invdiscperc)
		this.id_master.setitem(ll_mastercurrrow, "flatdisc", ld_flatdisc)
		this.id_master.setitem(ll_mastercurrrow, "misccharges", ld_misccharges)
		if f_stringpreferences("askmastercashwin_in_inpatientsr") = "N" then
			this.id_master.object.cashtendered[ll_mastercurrrow] = 0
			this.id_master.object.cashcharged[ll_mastercurrrow] = 0
			this.id_master.object.cashback[ll_mastercurrrow] = 0
			this.id_master.accepttext()
		end if
		do while ll_counter <= ll_rowcount and li_errcode = 0
			this.id_detail.setitem(ll_counter, "SrUtn", ul_maxutn)
			ul_maxutn = ul_maxutn + 1
			this.id_detail.setitem(ll_counter, "code", ll_invid)
			ll_gcode = this.id_detail.getitemnumber(ll_counter, "gcode")
			ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
			ls_batch = this.id_detail.getitemstring(ll_counter, "batch")
			ld_expiry = this.id_detail.getitemdatetime(ll_counter, "expiry")
			ld_qty = this.id_detail.getitemnumber(ll_counter, "looseqty")
			ld_bonusqty = this.id_detail.getitemnumber(ll_counter, "bonusqty")
			if lower(ls_batch) <> "due" then
				this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
				if this.it_transobject.sqlcode = 0 then
					this.id_detail.setitem(ll_counter, "AvgPrice", ld_avgprice)
					li_errcode = wf_checkitemactiveness(ll_icode, ls_errtext, ll_setasactive_count, ll_activeitemslist)
					if li_errcode = 0 then
						this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
						if this.it_transobject.sqlcode = 0 then
							ld_newstock = ld_stock + ld_qty + ld_bonusqty
							this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
							if this.it_transobject.sqlcode <> 0 then
								li_errcode = -1
							end if
						else
							li_errcode = -1
						end if
					end if
				else
					li_errcode = -1
				end if
			end if
			ll_counter = ll_counter + 1
		loop
		if li_errcode = -1 then
			lb_continue = false
		end if
		if lb_continue then
			ll_saveresult = event ue_save_withnocommit()
			if ll_saveresult = 0 then
				if wf_update_mastercashierwindow(ll_invid, this.is_doctype) = 0 then
					SQL commit USING this.it_transobject;
					messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
					this.ib_commitok = true
					this.id_master.resetupdate()
					this.im_menu.m_file.m_new.enabled = true
					this.editflag = false
					if gd_recenttransdate < this.id_systemdate then
						gd_recenttransdate = this.id_systemdate
					end if
				else
					messagebox("Saving Problem", "Changes Not Saved in database for Master Cashier Window transactions.", stopsign!, ok!, 1)
				end if
			else
				messagebox("Saving Problem", "Changes Not Saved in database while saving in-patient sales return record.", stopsign!, ok!, 1)
			end if
			if this.ib_commitok then
				if f_stringpreferences("IncSRInActMonitor") = "Y" then
					this.it_transobject.updateactivitymonitor(this.is_doctype, ll_invid)
					if this.it_transobject.sqlcode <> 0 then
						SQL rollback USING this.it_transobject;
						messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
					else
						SQL commit USING this.it_transobject;
					end if
				end if
				if f_stringpreferences("ShowSRInCashierActivity") = "Y" then
					this.it_transobject.updatecashieractivity(this.ii_module, ll_invid)
					if this.it_transobject.sqlcode <> 0 then
						SQL rollback USING this.it_transobject;
						messagebox("Activity Monitor", "Problem in updating cashier activity.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
					else
						SQL commit USING this.it_transobject;
					end if
				end if
				this.ib_modify = false
			end if
			if ll_setasactive_count > 0 then
				lds_items = create datastore
				lds_items.dataobject = "d_activemarkeditems"
				lds_items.settransobject(this.it_transobject)
				lds_items.reset()
				lds_items.retrieve(ll_activeitemslist)
				lstr_arg.ds = lds_items
				openwithparm(w_salereturn_activeitemlist, lstr_arg)
			end if
		else
			SQL rollback USING this.it_transobject;
			messagebox("Updation Error", "Transaction is RollBacked ~r~n Please Save Again", stopsign!)
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_inpatientsalereturn.ue_newform() returns 0
	integer rtncode
	integer li_ismodifysaleprice
	integer li_ismodifyitemdiscperc
	integer li_ismodifysalestax
	long li_fetched_code
	long row
	long ll_manfcode
	long ll_counter
	integer li_viewstock
	call super::ue_newform
	this.ib_lcdshow = false
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_print.enabled = true
	this.id_master.object.patientcode.visible = false
	this.id_master.object.admissioncode.visible = true
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	wf_assign_master_cash_win_object()
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.ib_modify = false
	this.idc_itemdddw.reset()
	this.idc_itemdddw.insertrow(0)
	this.id_detail.object.expiry.protect = true
	this.id_detail.object.batch.protect = true
	if this.ii_salerettype = 8 then
		this.id_master.object.custcode[1] = this.il_code
	end if
	li_ismodifysaleprice = 1
	li_ismodifyitemdiscperc = 1
	li_ismodifysalestax = 1
	li_viewstock = 0
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 519 then
			li_ismodifysaleprice = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 518 then
			li_ismodifyitemdiscperc = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 521 then
			li_ismodifysalestax = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 535 then
			li_viewstock = 1
		end if
	next
	this.id_footer.object.t_stock.visible = li_viewstock
	this.id_footer.object.stock.visible = li_viewstock
	this.id_detail.object.srprice.protect = li_ismodifysaleprice
	this.id_detail.object.discperc.protect = li_ismodifyitemdiscperc
	this.id_detail.object.unitsalestax.protect = li_ismodifysalestax
	this.id_detail.object.gstperc.protect = li_ismodifysalestax
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	wf_visible(true)
	setredraw(true)
	if not wf_validatedate() then
		close(this)
	end if
	if f_stringpreferences("DisplayPool") = "Y" then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
			setnull(this.is_lcditem)
			this.ic_comport.triggerevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
			setnull(this.is_lcditem)
			this.ic_comport.triggerevent("ue_show")
		else
			this.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
			this.ic_comport.triggerevent("ue_show")
		end if
	end if
	this.ib_lcdshow = true

// w_inpatientsalereturn.ue_detail() returns 0
	integer li_rtncode
	integer li_protect
	long ll_row
	long ll_code
	boolean lb_flag
	call super::ue_detail
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	ll_code = this.id_master.getitemnumber(1, "code")
	if isnull(this.id_master.getitemnumber(1, "admissioncode")) then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "Only In-Patient Sale Return is Allowed Here,~r~nYou Can not modify this Invoice.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if wf_allowreturnmodification(ll_code, this.il_groupcode, this.il_strategy) <> 0 then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "You Can not modify this Invoice,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_salegodown
	end if
	this.id_footer.retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	if wf_admitted(this.id_master.object.admissioncode[this.id_master.getrow()]) <= 0 then
		this.id_master.object.patientcode.visible = true
		this.id_master.object.admissioncode.visible = false
		this.id_master.setitem(1, "patientcode", wf_findpatientcode(this.id_master.object.admissioncode[this.id_master.getrow()]))
	else
		this.id_master.object.patientcode.visible = false
		this.id_master.object.admissioncode.visible = true
	end if
	if this.id_master.object.code[this.id_master.rowcount()] > 0 then
		this.ids_cashwin.retrieve(this.id_master.object.code[1], this.is_doctype)
	else
		wf_assign_master_cash_win_object()
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	this.id_detail.object.expiry.protect = true
	this.id_detail.object.batch.protect = true
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	wf_grandtotal()
	setredraw(true)

// w_inpatientsalereturn.ue_newitem() returns 0
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.settransobject(this.it_transobject)
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_inpatientsalereturn.close() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	destroy this.ids_saleinv
	if f_stringpreferences("DisplayPool") = "Y" then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
			this.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
			postevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
			this.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
			this.ic_comport.triggerevent("ue_show")
		else
			this.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
			this.ic_comport.triggerevent("ue_show")
		end if
	end if
	return 1

// w_inpatientsalereturn.ue_print() returns 0
	long ll_custcode
	long ll_row
	long ll_invcode
	long ll_reprintingcounter
	integer li_option
	string ls_custname
	boolean lb_listtab
	s_datastore lstr
	string ls_printer
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	wf_selectprintreport()
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		SQL SELECT ISNULL ( reprintingcounter , 0 ) INTO :ll_reprintingcounter FROM srledger WHERE srledger.srinvcode =:ll_invcode USING this.it_transobject;
		ll_reprintingcounter = ll_reprintingcounter + 1
		SQL update SrLedger SET ReprintingCounter =:ll_reprintingcounter WHERE srinvcode =:ll_invcode USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Database Error", "Some database problem has occur ~r~n during updation of printing counter")
			SQL rollback USING this.it_transobject;
			return
		else
			SQL commit USING this.it_transobject;
		end if
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		elseif f_stringpreferences("CashDrawerWithPrinter") = "Y" then
			ls_printer = f_stringpreferences("CashDrawerPrinter")
			if ls_printer = "" or isnull(ls_printer) then
				messagebox("Cash Drawer Printer", "Cash Drawer Printer name not found.~r~nSuggested Option is check Cash Drawer Printer name in Preferences.")
			else
				this.ic_cashdrawerprinter.object.__invoke_method("opendrawer", 4, {ls_printer, 10, "Control", 65}, true)
			end if
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_inpatientsalereturn.ue_refreshddw() returns 0
	call super::ue_refreshddw
	if this.ib_opensalereturn and this.ii_salerettype = 1 then
		setpointer(hourglass!)
		this.idc_customerslist.setredraw(false)
		this.idc_customerslist.settransobject(this.it_transobject)
		this.idc_customerslist.reset()
		this.idc_customerslist.retrieve()
		this.idc_customerslist.setredraw(true)
		setpointer(arrow!)
	end if

// w_inpatientsalereturn.ue_list() returns 0
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_post.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_itemvalidated = true

// w_inpatientsalereturn.ue_postopen() returns 0
	datawindowchild ldc_dddsalecategory
	datawindowchild ldc_headerno
	s_salerettype ls_salerettype
	long li_rtncode
	long ll_counter
	datastore lds_headers
	call super::ue_postopen
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	this.ids_saleinv = create datastore
	this.ids_saleinv.dataobject = "ddd_inpatientretableitems"
	this.ids_saleinv.settransobject(sqlca)
	this.id_print = this.dw_print
	setredraw(false)
	ls_salerettype = message.powerobjectparm
	wf_setsalereturntype(ls_salerettype.salerettype, ls_salerettype.opensale)
	wf_assign_master_cash_win_object()
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.title = "In-Patient Sale Return"
	wf_assigndatawindowobjects("d_InPatientSaleReturn", "d_InPatientSaleReturnDetail", "d_SaleReturnFooter", "d_InPatientSalereturnList", "d_WholeSaleReturnInvReport")
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	li_rtncode = this.id_master.getchild("admissioncode", this.idc_patient)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_patient.settransobject(this.it_transobject)
	this.idc_patient.retrieve()
	li_rtncode = this.id_detail.getchild("icode", this.idc_itemdddw)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_itemdddw.settransobject(this.it_transobject)
	this.idc_itemdddw.insertrow(0)
	this.id_itemslist.dataobject = "ddd_inpatientretableitems"
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit to Make Sales Return")
		close(this)
		return
	end if
	li_rtncode = this.id_detail.getchild("gcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights for making Sale Return")
		close(this)
		return
	end if
	this.ii_salegodown = this.idc_godown.getitemnumber(1, "gcode")
	this.id_detail.object.gcode.initial = string(this.ii_salegodown)
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode_t.visible = true
		this.id_master.object.gcode.visible = true
		this.id_master.object.gcode.initial = string(this.ii_salegodown)
		this.id_detail.object.gcode.visible = false
	end if
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Sales Return")
		close(this)
		return
	end if
	if f_stringpreferences("headeronsalereturninv") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.headerno_t.visible = false
	end if
	this.id_master.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to lds_headers.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
		ldc_headerno.setitem(ll_counter, "name", "")
	next
	this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
	this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	if this.ii_salerettype = 8 and (gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN") then
		wf_visibleinvisiblediscount()
	end if
	if f_stringpreferences("batchinsr") = "N" then
		this.id_detail.object.batch.visible = false
	end if
	if f_stringpreferences("expiryinsr") = "N" then
		this.id_detail.object.expiry.visible = false
	end if
	if f_stringpreferences("itemunittax") = "N" then
		this.id_detail.object.unitsalestax.visible = false
		this.id_detail.object.taxperunit_t.visible = false
		this.id_detail.object.c_sumtaxval.visible = false
		this.id_detail.object.c_taxval.visible = false
		this.id_detail.object.taxval_t.visible = false
	end if
	if f_stringpreferences("itemgstperc") = "N" then
		this.id_detail.object.gstperc.visible = false
		this.id_detail.object.gstperc_t.visible = false
		this.id_detail.object.c_sumgstval.visible = false
		this.id_detail.object.c_gstval.visible = false
		this.id_detail.object.gstval_t.visible = false
	end if
	if f_stringpreferences("invgstperc") = "N" then
		this.id_footer.object.invgstperc1.visible = false
		this.id_footer.object.invgstperc1_t.visible = false
	end if
	if f_stringpreferences("BonusinSale") = "N" then
		this.id_detail.object.t_bonusqty.visible = false
		this.id_detail.object.bonusqty.visible = false
		if not this.ib_opensalereturn then
			this.id_footer.object.t_salebonusqty.visible = false
			this.id_footer.object.salebonusqty.visible = false
			this.id_footer.object.t_retablebonusqty.visible = false
			this.id_footer.object.retablebonusqty.visible = false
		end if
	end if
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(1)
	f_setcolumnstyle(this.id_detail, "Qty")
	wf_set_itemtotal_formatmask()
	setredraw(true)

// ic_comport.ue_show() returns long
	if isnull(parent.is_lcditem) then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
			parent.is_lcditem = char(26) + char(1)
			parent.ic_comport.triggerevent("ue_show")
			parent.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
			parent.ic_comport.triggerevent("ue_show")
			return 1
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
			parent.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
		else
			parent.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
		end if
	end if
	this.object.portopen = true
	if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
		this.object.output = char(26) + parent.is_lcditem
	elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
		this.object.output = char(12) + parent.is_lcditem
	else
		this.object.output = char(12) + parent.is_lcditem
	end if
	this.object.portopen = false
	return 1

// ic_comport.constructor() returns long
	integer li_defaultcomport
	if f_stringpreferences("DisplayPool") = "Y" then
		li_defaultcomport = f_numberpreferences("DefaultComPort")
		if isnull(li_defaultcomport) then
			li_defaultcomport = 2
		end if
		this.object.commport = li_defaultcomport
		this.object.settings = "9600,N,8,1"
		this.object.inputlen = 0
	end if
	return ::message.returnvalue

// ic_cashdrawer.constructor() returns long
	integer li_defaultcomport
	if f_stringpreferences("CashDrawer") = "Y" then
		li_defaultcomport = f_numberpreferences("DefaultComPort")
		if li_defaultcomport = 1 then
			this.object.commport = 2
		elseif li_defaultcomport = 2 then
			this.object.commport = 1
		else
			this.object.commport = 1
		end if
		this.object.settings = "300,N,8,1"
		this.object.inputlen = 0
	end if
	return ::message.returnvalue
