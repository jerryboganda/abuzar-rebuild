	this.m_pullprfromdropbox = create m_pullprfromdropbox
	this.m_pushsrtodropbox = create m_pushsrtodropbox
	this.item[upperbound(this.item) + 1] = this.m_previoussaleinvoiceinfo
	this.item[upperbound(this.item) + 1] = this.m_itemsalehistory
	this.item[upperbound(this.item) + 1] = this.m_possiblebatchandexpiry
	this.item[upperbound(this.item) + 1] = this.m_populatefromdatacarrydb
	this.item[upperbound(this.item) + 1] = this.m_saveandpost
	this.item[upperbound(this.item) + 1] = this.m_saveandpostissuebasedbatchreturn
	this.item[upperbound(this.item) + 1] = this.m_setserverdate
	this.item[upperbound(this.item) + 1] = this.m_fiscalizesrinvoice
	this.item[upperbound(this.item) + 1] = this.m_copyinvoice
	this.item[upperbound(this.item) + 1] = this.m_fiscalizesrinvoices
	this.item[upperbound(this.item) + 1] = this.m_pullprfromdropbox
	this.item[upperbound(this.item) + 1] = this.m_pushsrtodropbox

// m_file.destroy() returns 0 [event]
