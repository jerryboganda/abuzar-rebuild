	destroy this.m_saveandpost
	destroy this.m_saveandpostissuebasedbatchreturn
	destroy this.m_setserverdate
	destroy this.m_fiscalizesrinvoice
	destroy this.m_copyinvoice
	destroy this.m_fiscalizesrinvoices
	destroy this.m_pullprfromdropbox
	destroy this.m_pushsrtodropbox

