// menu m_dataimport_reports (popupmenus)  ancestor: m_popupmenu

// m_dataimport_reports.create() returns 0
	m_dataimport_reports = this
	call super::create
	this.text = "m_dataimport_reports"
	this.m_dataimporthistory = create m_dataimporthistory
	this.item[upperbound(this.item) + 1] = this.m_dataimporthistory

// m_dataimport_reports.destroy() returns 0
	call super::destroy
	destroy this.m_dataimporthistory

// m_dataimporthistory.clicked() returns 0
	parent.mf_displayreport("Data Import History Report", "d_dataimporthistory")

// m_dataimporthistory.create() returns 0
	call super::create
	this.visible = false
	this.text = "Data Import History"
	this.menutextcolor = 134217735
	this.menubackcolor = 134217732
	this.menuhighlightcolor = 134217741
	this.textsize = 8
	this.weight = 400
	this.facename = "Tahoma"
	this.titlebackcolor = 134217730
	this.bitmapbackcolor = 12632256
	this.menubitmaps = true
	this.titlegradient = true
	this.toolbartextcolor = 134217746
	this.toolbarbackcolor = 67108864
	this.toolbarhighlightcolor = 134217741
	this.toolbargradient = true
	this.bitmapgradient = true

// m_dataimporthistory.destroy() returns 0
	call super::destroy
