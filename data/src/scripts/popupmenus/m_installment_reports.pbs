// menu m_installment_reports (popupmenus)  ancestor: m_popupmenu

// m_installment_reports.create() returns 0 [event]
	m_installment_reports = this
	call super::create
	this.text = "m_installment_reports"
	this.m_monthwiseinstallmentanalysis = create m_monthwiseinstallmentanalysis
	this.m_installmentstatusreport = create m_installmentstatusreport
	this.item[upperbound(this.item) + 1] = this.m_monthwiseinstallmentanalysis
	this.item[upperbound(this.item) + 1] = this.m_installmentstatusreport

// m_installment_reports.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_monthwiseinstallmentanalysis
	destroy this.m_installmentstatusreport

// m_monthwiseinstallmentanalysis.clicked() returns 0 [event]
	parent.mf_displayreport("Month Wise Installment Analysis", "d_monthwiseinstallmentanalysisdetail")

// m_monthwiseinstallmentanalysis.create() returns 0 [event]
	call super::create
	this.visible = false
	this.text = "Month Wise Installment Analysis"
