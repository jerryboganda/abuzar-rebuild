// menu m_passport_reports (popupmenus)  ancestor: m_popupmenu

// m_passport_reports.create() returns 0 [event]
	m_passport_reports = this
	call super::create
	this.text = "m_passport_report"
	this.m_passporttrackingreport = create m_passporttrackingreport
	this.item[upperbound(this.item) + 1] = this.m_passporttrackingreport

// m_passport_reports.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_passporttrackingreport

// m_passporttrackingreport.clicked() returns 0 [event]
	parent.mf_displayreport("Passport Tracking Report", "d_passport_tracking")

// m_passporttrackingreport.create() returns 0 [event]
	call super::create
	this.visible = false
	this.text = "Passport Tracking Report"
	this.menutextcolor = 134217735
	this.menubackcolor = 134217732
	this.menuhighlightcolor = 134217741
	this.textsize = 8
	this.weight = 400
	this.facename = "Tahoma"
	this.titlebackcolor = 134217730
	this.bitmapbackcolor = 12632256
	this.menubitmaps = true
	this.titlegradient = true
	this.toolbartextcolor = 134217746
	this.toolbarbackcolor = 67108864
	this.toolbarhighlightcolor = 134217741
	this.toolbargradient = true
	this.bitmapgradient = true

// m_passporttrackingreport.destroy() returns 0 [event]
	call super::destroy
