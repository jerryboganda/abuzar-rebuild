// menu m_guest_reports (popupmenus)  ancestor: m_popupmenu

// m_guest_reports.create() returns 0
	m_guest_reports = this
	call super::create
	this.text = "m_guest_reports"
	this.m_guestcheckinreports = create m_guestcheckinreports
	this.m_guestaccounting = create m_guestaccounting
	this.m_guestbill = create m_guestbill
	this.item[upperbound(this.item) + 1] = this.m_guestcheckinreports
	this.item[upperbound(this.item) + 1] = this.m_guestaccounting
	this.item[upperbound(this.item) + 1] = this.m_guestbill

// m_guest_reports.destroy() returns 0
	call super::destroy
	destroy this.m_guestcheckinreports
	destroy this.m_guestaccounting
	destroy this.m_guestbill

// m_guestcheckinreports.create() returns 0
	call super::create
	this.visible = false
	this.text = "Guest Check-In Reports"
