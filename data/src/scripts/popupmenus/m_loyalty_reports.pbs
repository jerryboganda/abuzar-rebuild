// menu m_loyalty_reports (popupmenus)  ancestor: m_popupmenu

// m_loyalty_reports.create() returns 0
	m_loyalty_reports = this
	call super::create
	this.text = "m_loyalty_reports"
	this.m_loyaltypointsledger = create m_loyaltypointsledger
	this.item[upperbound(this.item) + 1] = this.m_loyaltypointsledger

// m_loyalty_reports.destroy() returns 0
	call super::destroy
	destroy this.m_loyaltypointsledger

// m_loyaltypointsledger.clicked() returns 0
	parent.mf_displayreport("Loyalty Point Ledger Report", "d_loyaltypointledger")

// m_loyaltypointsledger.create() returns 0
	call super::create
	this.visible = false
	this.text = "Loyalty Points Ledger"
	this.menutextcolor = 134217735
	this.menubackcolor = 134217732
	this.menuhighlightcolor = 134217741
	this.textsize = 8
	this.weight = 400
	this.facename = "Tahoma"
	this.titlebackcolor = 134217730
	this.bitmapbackcolor = 12632256
	this.menubitmaps = true
	this.titlegradient = true
	this.toolbartextcolor = 134217746
	this.toolbarbackcolor = 67108864
	this.toolbarhighlightcolor = 134217741
	this.toolbargradient = true
	this.bitmapgradient = true

// m_loyaltypointsledger.destroy() returns 0
	call super::destroy
