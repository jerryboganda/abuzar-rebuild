// menu m_employee_reports (popupmenus)  ancestor: m_popupmenu

// m_employee_reports.create() returns 0
	m_employee_reports = this
	call super::create
	this.text = "m_employee_reports"
	this.m_employeeattendancereports = create m_employeeattendancereports
	this.m_payrollreports = create m_payrollreports
	this.item[upperbound(this.item) + 1] = this.m_employeeattendancereports
	this.item[upperbound(this.item) + 1] = this.m_payrollreports

// m_employee_reports.destroy() returns 0
	call super::destroy
	destroy this.m_employeeattendancereports
	destroy this.m_payrollreports

