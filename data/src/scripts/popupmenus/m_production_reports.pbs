// m_production_reports.create() returns 0 [event]
	m_production_reports = this
	call super::create
	this.text = "m_production_reports"
	this.m_productionnotereports = create m_productionnotereports
	this.item[upperbound(this.item) + 1] = this.m_productionnotereports

// m_production_reports.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_productionnotereports

