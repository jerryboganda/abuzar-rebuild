// window w_quotationremarks (quotation)  ancestor: window

// w_quotationremarks.create() returns 0
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.dw_quotationremarks = create dw_quotationremarks
	this.control = {this.cb_cancel, this.cb_ok, this.dw_quotationremarks}

// w_quotationremarks.destroy() returns 0
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.dw_quotationremarks

// w_quotationremarks.open() returns long
	this.is_quotationremarks = message.powerobjectparm
	this.dw_quotationremarks.settransobject(sqlca)
	this.dw_quotationremarks.insertrow(0)
	this.dw_quotationremarks.setitem(1, "remarks2", this.is_quotationremarks.remarks2)
	this.dw_quotationremarks.setitem(1, "remarks3", this.is_quotationremarks.remarks3)
	this.dw_quotationremarks.setitem(1, "remarks4", this.is_quotationremarks.remarks4)
	this.dw_quotationremarks.setitem(1, "remarks5", this.is_quotationremarks.remarks5)
	this.dw_quotationremarks.setitem(1, "remarks6", this.is_quotationremarks.remarks6)
	this.dw_quotationremarks.setitem(1, "remarks7", this.is_quotationremarks.remarks7)
	this.dw_quotationremarks.setitem(1, "remarks8", this.is_quotationremarks.remarks8)
	this.dw_quotationremarks.setitem(1, "remarks9", this.is_quotationremarks.remarks9)
	if this.is_quotationremarks.module = "PurOrder" then
		this.title = "Purchase Order Terms"
	elseif this.is_quotationremarks.module = "PR" then
		this.title = "Purchase Return Terms"
		this.dw_quotationremarks.object.t_remarks7.visible = false
		this.dw_quotationremarks.object.remarks7.visible = false
		this.dw_quotationremarks.object.t_remarks8.visible = false
		this.dw_quotationremarks.object.remarks8.visible = false
		this.dw_quotationremarks.object.t_remarks9.visible = false
		this.dw_quotationremarks.object.remarks9.visible = false
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_quotationremarks.close() returns long
	closewithreturn(this, this.is_quotationremarks)
	return ::message.returnvalue

// w_quotationremarks.key(keycode key, unsignedlong keyflags) returns long
	if keydown(keyescape!) then
		close(this)
	end if
	return ::message.returnvalue

// cb_cancel.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	closewithreturn(parent, parent.is_quotationremarks)
	return ::message.returnvalue

// cb_ok.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	parent.dw_quotationremarks.accepttext()
	parent.is_quotationremarks.remarks2 = parent.dw_quotationremarks.getitemstring(1, "remarks2")
	parent.is_quotationremarks.remarks3 = parent.dw_quotationremarks.getitemstring(1, "remarks3")
	parent.is_quotationremarks.remarks4 = parent.dw_quotationremarks.getitemstring(1, "remarks4")
	parent.is_quotationremarks.remarks5 = parent.dw_quotationremarks.getitemstring(1, "remarks5")
	parent.is_quotationremarks.remarks6 = parent.dw_quotationremarks.getitemstring(1, "remarks6")
	parent.is_quotationremarks.remarks7 = parent.dw_quotationremarks.getitemstring(1, "remarks7")
	parent.is_quotationremarks.remarks8 = parent.dw_quotationremarks.getitemstring(1, "remarks8")
	parent.is_quotationremarks.remarks9 = parent.dw_quotationremarks.getitemstring(1, "remarks9")
	closewithreturn(parent, parent.is_quotationremarks)
	return ::message.returnvalue

// dw_quotationremarks.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
