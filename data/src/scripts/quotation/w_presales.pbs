// window w_presales (quotation)  ancestor: w_multi_entry

// w_presales.ue_enableprint() returns 0 [event]
	this.im_menu.m_file.m_print.enabled = true

// w_presales.wf_print() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_count
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			for ll_count = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
				this.id_print.retrieve(ll_count)
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			next
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	return li_errcode

// w_presales.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_presales.wf_deleteinvoice(long al_invcode) returns integer
	SQL Delete presaledetail Where presaledetail.presaleinvCode =:al_invcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_presales.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_presales.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	long iccode
	long icatcode
	long packcode
	long manfcode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_presales.wf_getitemassociategcode(long la_icode) returns integer
	integer li_gcode
	SQL Select Gcode INTO :li_gcode From item Where icode =:la_icode USING this.it_transobject;
	return li_gcode

// w_presales.wf_getmaxdate(datetime ad_date) returns integer
	SQL Select Max ( Date ) INTO :ad_date From saleledger USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_presales.wf_inititeminfo(long al_icode, long al_row, integer ai_rtcode, string as_errortext) returns boolean
	boolean retflag = true
	double ld_saleprice
	double ld_saleprice1
	double ld_discperc
	double ld_saleprice2
	double ld_saleprice3
	double ld_avgprice
	double ld_unitsalestax
	double ld_gstperc1
	double ld_gstperc2
	double ld_packsalestax
	double ld_purprice
	double ld_rpp
	double ld_saleprice4
	double ld_saleprice5
	double ld_custitemcatdiscperc
	double ld_batchstock
	long ll_packunits
	long ll_saleqty
	long ll_saleinvcode
	long ll_qtysale
	long ll_bonus
	long ll_loosepack
	long ll_itemdesc_status
	long ll_custcode
	double ld_godownstock
	double ld_totalstock
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_remarks
	string ls_batch
	datetime ldt_expiry
	setnull(ls_null)
	li_gcode = this.ii_defaultgcode
	SQL SELECT item.customicode , item.name , item.saleprice , item.packunits , item.salediscperc , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.avgprice , item.purprice , item.recentpurprice , round ( item.Packsalestax / item.packunits , 2 ) , item.gstperc1 , item.gstperc2 , qtysale =item.saleqty , bonus =item.bonusqty , item.Packsalestax , item.remarks INTO :ls_fullcode, :ls_name, :ld_saleprice, :ll_packunits, :ld_discperc, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :ld_avgprice, :ld_purprice, :ld_rpp, :ld_unitsalestax, :ld_gstperc1, :ld_gstperc2, :ll_qtysale, :ll_bonus, :ld_packsalestax, :ls_remarks FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
	else
		if this.il_strategy = 2 then
			li_gcode = wf_getitemassociategcode(al_icode)
		end if
		if this.il_strategy = 1 then
			li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
		end if
	end if
	this.it_transobject.getitemstockall(al_icode, ld_totalstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if retflag then
		this.id_detail.setitem(al_row, "gcode", li_gcode)
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		this.id_detail.setitem(al_row, "icode", al_icode)
		this.id_detail.setitem(al_row, "packunits", ll_packunits)
		this.id_detail.setitem(al_row, "discperc", ld_discperc)
		this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
		if al_row > 1 then
			this.id_detail.setitem(al_row, "discperc", this.id_detail.getitemdecimal(al_row - 1, "discperc"))
		end if
		this.id_detail.setitem(al_row, "stock", ld_godownstock)
		this.id_detail.setitem(al_row, "totalstock", ld_totalstock)
		SQL SELECT MAX ( Batch ) , MAX ( Expiry ) , ISNULL ( SUM ( CurrQty ) , 0 ) INTO :ls_batch, :ldt_expiry, :ld_batchstock FROM GodownDetail WHERE GCode =:li_gcode AND ICode =:al_icode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 and isnull(ls_batch) then
			this.id_detail.setitem(al_row, "batch", ls_batch)
			this.id_detail.setitem(al_row, "expiry", ldt_expiry)
		end if
	end if
	return retflag

// w_presales.wf_initmodify(integer ai_protect) returns 0
	long ll_invcode
	long ll_gcode
	long ll_icode
	long ll_looseqty
	long ll_counter = 1
	long ll_count
	double ld_stock
	double ld_totalstock
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_invcode = this.id_detail.getitemnumber(1, "code")
		if wf_lockinvoice(ll_invcode) = 0 then
			this.id_master.retrieve(ll_invcode)
			this.id_detail.retrieve(ll_invcode)
			this.ids_invoiceinfo.retrieve(ll_invcode)
			for ll_count = 1 to this.id_detail.rowcount()
				ll_icode = this.id_detail.getitemnumber(ll_count, "icode")
				ll_gcode = this.id_detail.getitemnumber(ll_count, "gcode")
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				this.it_transobject.getitemstockall(ll_icode, ld_totalstock)
				if this.it_transobject.sqlcode <> 0 then
					ai_protect = 0
				end if
				this.id_detail.setitem(ll_count, "stock", ld_stock)
				this.id_detail.setitem(ll_count, "totalstock", ld_totalstock)
			next
			if ai_protect = 0 then
				this.ib_modify = true
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
		else
			messagebox("Cannot Modify", "Quotation is already in use")
		end if
		return
	end if
	ai_protect = 1

// w_presales.wf_search_customer() returns 0
	long ll_code
	long ll_oldcode
	s_popup_selection lstr_selection
	if wf_iseditable() = false then
		return
	end if
	ll_oldcode = this.id_master.getitemnumber(1, "custcode")
	this.id_master.setcolumn("custcode")
	this.id_master.setfocus()
	openwithparm(w_popup_partialsearch_selection, "d_customer_list")
	lstr_selection = message.powerobjectparm
	if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
		this.id_master.setitem(1, "custcode", lstr_selection.l_code2)
	end if

// w_presales.wf_setgodownoption() returns 0
	this.ii_salegodown = this.id_detail.getitemnumber(1, "gcode")
	if this.il_strategy = 2 or this.il_strategy = 1 and this.il_godowncount = 1 then
	end if

// w_presales.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	long ll_icode
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	integer li_option
	boolean lb_rtflag = true
	boolean ib_due
	integer li_null
	string ls_null
	ls_titleerrtext = "Item Validation"
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), al_currrow) = true then
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
	elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			li_option = messagebox("Item Validation", "Item stock does not exist~n~rDo You want to due this item", information!, yesno!, 2)
			if li_option = 1 then
				this.id_detail.setitem(this.il_currrow, "qty", 1)
				ib_due = true
			else
				li_errcode = -1
			end if
		end if
	else
		li_errcode = -1
		ls_titleerrtext = "Item Validation"
	end if
	if li_errcode = -1 and not ib_due then
		lb_rtflag = false
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setitem(al_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(al_currrow, "icode", li_null)
		this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	end if
	return lb_rtflag

// w_presales.wf_validategodown() returns integer
	long ll_gcode
	long ll_icode
	long ll_retcode
	double ld_totalstock
	double ld_godownstock
	string ls_errortext
	ll_retcode = 1
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	ll_gcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		ll_gcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	else
		if this.il_strategy = 2 then
			ll_gcode = wf_getitemassociategcode(ll_icode)
		end if
		if this.il_strategy = 1 then
			ll_gcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
		end if
	end if
	this.it_transobject.getitemstockall(ll_icode, ld_totalstock)
	if this.it_transobject.sqlcode <> 0 then
		ll_retcode = -1
		ls_errortext = "Database Error: Item stock information can not be retrieved"
	end if
	this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		ll_retcode = -1
		ls_errortext = "Database Error: Item Stock information can not be retrieved"
	end if
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_totalstock)
	this.id_detail.setitem(this.il_currrow, "stock", ld_godownstock)
	this.id_detail.setitem(this.il_currrow, "totalstock", ld_totalstock)
	if ll_retcode = -1 then
		messagebox("Stock Error", ls_errortext)
	end if
	this.ib_godownvalidated = true
	return ll_retcode

// w_presales.wf_validateitem(boolean ab_flag) returns integer
	long ll_icode
	long ll_count
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	integer li_option
	boolean ib_due
	boolean lb_dupitem
	boolean lb_invalidrow
	integer li_null
	string ls_null
	if isnull(this.il_currrow) or this.il_currrow <= 0 then
		lb_invalidrow = true
	else
		ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	end if
	if lb_invalidrow = false and not isnull(ll_icode) then
		if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
			ls_titleerrtext = "Item Validation"
			ls_errtext = "Duplicate item, please select some other item"
			lb_dupitem = true
			li_errcode = -1
		else
			wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext)
			li_errcode = 1
		end if
		this.ib_itemvalidated = true
		if li_errcode = -1 then
			setnull(li_null)
			setnull(ls_null)
			ls_titleerrtext = "Item Validation"
			if lb_dupitem = true then
				this.id_detail.scrolltorow(this.il_currrow)
				this.id_detail.object.icode[this.il_currrow] = li_null
				this.id_detail.object.fullcode[this.il_currrow] = ls_null
				this.id_detail.object.itemname[this.il_currrow] = ls_null
				post event ue_deleteitem_row(this.il_currrow)
				for ll_count = 1 to this.id_detail.rowcount()
					if this.id_detail.getitemnumber(ll_count, "icode") = ll_icode then
						this.id_detail.scrolltorow(ll_count)
						triggerevent("ue_focusqty")
					end if
				next
				messagebox("Item", "Duplicate Item, please select some other item")
			else
				messagebox(ls_titleerrtext, ls_errtext)
				if f_stringpreferences("itemcode") = "N" then
					this.id_detail.setcolumn(this.is_columnitemname)
					this.ib_itemslistopen = true
					this.id_itemslist.show()
				else
					this.id_detail.setcolumn("fullcode")
					this.id_detail.object.fullcode[this.il_currrow] = ls_null
				end if
				this.id_detail.scrolltorow(this.il_currrow)
				this.id_detail.object.icode[this.il_currrow] = li_null
				this.id_detail.object.itemname[this.il_currrow] = ls_null
			end if
		end if
	end if
	return li_errcode

// w_presales.wf_validateitemnew() returns integer
	long ll_icode
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
		messagebox(ls_titleerrtext, ls_errtext)
	elseif not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		ls_titleerrtext = "Item Validation"
		li_errcode = -2
	end if
	this.ib_itemvalidated = true
	return li_errcode

// w_presales.wf_visible(boolean ab_flag) returns 0

// w_presales.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_presales.wf_retrievelist() returns long
	string[] ls_posted
	integer li_invforlastdays = -10
	datetime ld_invdate
	ld_invdate = datetime(relativedate(today(), li_invforlastdays))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	return this.id_list.retrieve(ls_posted, ld_invdate)

// w_presales.wf_retrievelistall() returns long
	string[] ls_posted
	datetime ld_invdate
	ld_invdate = datetime(date("12/12/1998"), time("00:00:00"))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	return this.id_list.retrieve(ls_posted, ld_invdate)

// w_presales.wf_grandtotal() returns double
	return 0

// w_presales.wf_post() returns integer
	integer li_errcode
	long ll_usercode
	long ll_invcount = 1
	long ll_counter
	long ll_code
	long ll_saleinvcode
	boolean lb_flag
	s_arguements lstr_arginfo
	if this.id_list.getrow() > 0 and (this.id_list.object.code[this.id_list.getrow()] > 0 and this.id_list.object.posted[this.id_list.getrow()] = "N") then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
		open(w_salesmanpassword)
		ll_usercode = long(message.doubleparm)
		setfocus()
		if ll_usercode > 0 then
			setpointer(hourglass!)
			SQL rollback USING this.it_transobject;
			li_errcode = wf_lockinvoice(ll_code)
			if li_errcode = 0 then
				this.it_transobject.generatesale_from_presales(ll_code, ll_usercode, ll_saleinvcode)
				if this.it_transobject.sqlcode <> 0 then
					li_errcode = -1
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
		setpointer(arrow!)
		if li_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again")
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_invcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return li_errcode

// w_presales.wf_setiteminfo(long al_icode, long al_row, double ad_saleprice, double ad_discperc, double ad_stock, double ad_avgprice, double ad_totalstock, double ad_purdiscperc) returns 0
	this.id_detail.setitem(al_row, "saleprice", ad_saleprice)
	this.id_detail.setitem(al_row, "discperc", ad_discperc)
	this.id_detail.setitem(al_row, "rate", ad_saleprice)
	this.id_detail.setitem(al_row, "avgprice", ad_avgprice)

// w_presales.wf_markactiveinactive() returns long
	long ll_invcode
	long ll_suppcode
	long ll_row
	boolean lb_listtab
	string ls_errtext
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_row = this.id_list.getrow()
		ll_invcode = this.id_list.object.code[ll_row]
		if ll_invcode > 0 then
			SQL rollback USING this.it_transobject;
			this.it_transobject.mark_purquotation_active_inactive(ll_invcode)
			if this.it_transobject.sqlcode = 0 then
				SQL commit USING this.it_transobject;
			else
				ls_errtext = "Problem in Marking Active/In-Active Status For Purchase Quotation Code = " + string(ll_invcode) + "~r~nReasons Are:-~r~n" + this.it_transobject.sqlerrtext + "~r~nTry Again Later."
				SQL rollback USING this.it_transobject;
				messagebox("Database Problem", ls_errtext, stopsign!)
			end if
		end if
	end if
	return 0

// w_presales.wf_setcustname(string as_data) returns 0
	long ll_rowno
	ll_rowno = this.idc_customer.find("accounts_name >='" + as_data + "'", 1, this.idc_customer.rowcount())
	if ll_rowno > 0 then
		this.idc_customer.selectrow(0, false)
		this.idc_customer.setrow(ll_rowno)
		this.idc_customer.scrolltorow(ll_rowno)
		this.idc_customer.selectrow(ll_rowno, true)
	end if

// w_presales.wf_findcustcode(string as_aliasname, long al_custcode) returns long
	long ll_custcode
	long ll_retflag
	string ls_itemname
	SQL SELECT accounts.acccode INTO :ll_custcode FROM accounts , customer WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =customer.custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_custcode = ll_custcode
		if isnull(al_custcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_presales.wf_lockinvoice(long al_presaleinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From presaleheader WITH ( UPDLOCK HOLDLOCK ) Where presaleheader.presaleinvcode =:al_presaleinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_presales.wf_selectprintreport() returns string
	string ls_pagesize
	string ls_report
	long ll_currrow
	ll_currrow = this.id_master.getrow()
	this.id_print.dataobject = "d_presaleprint_full"
	this.id_print.settransobject(this.it_transobject)
	return ls_report

// w_presales.wf_customerinfo(long al_custcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	string ls_aliasname
	long ll_currow
	double ld_currbalance
	SQL SELECT customer.address1 , customer.city , customer.phone , accounts.aliasname INTO :ls_address, :ls_city, :ls_phone, :ls_aliasname FROM customer , accounts WHERE customer.custcode =:al_custcode and customer.custcode =accounts.acccode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
		this.id_master.object.aliasname[ll_currow] = ls_aliasname
	end if
	return this.it_transobject.sqlcode

// w_presales.wf_populate_purchases() returns long
	s_arguements lstr_arg
	integer li_retcode
	long ll_rowcount
	long ll_counter
	long ll_insrow
	long ll_icode
	long ll_gcode
	long ll_purinvcode
	string ls_errortext
	string ls_batch
	string ls_item
	datetime ldt_expiry
	double ld_qty
	datastore lds_pur
	open(w_purinvoices_posted_supp_sdate_ldate)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		lds_pur = create datastore
		lds_pur.dataobject = "d_purinvoices_for_presales"
		lds_pur.settransobject(this.it_transobject)
		lds_pur.retrieve(lstr_arg.ia_integerlist)
		ll_rowcount = lds_pur.rowcount()
		ll_counter = 0
		if ll_rowcount > 0 then
			wf_deleteemptydetailrow()
			for ll_counter = 1 to ll_rowcount
				if lds_pur.object.qty[ll_counter] > 0 then
					ll_purinvcode = lds_pur.object.purinvcode[ll_counter]
					ll_gcode = lds_pur.object.gcode[ll_counter]
					ll_icode = lds_pur.object.icode[ll_counter]
					ls_batch = lds_pur.object.batch[ll_counter]
					ldt_expiry = lds_pur.object.expiry[ll_counter]
					ls_item = lds_pur.object.itemname[ll_counter]
					ld_qty = lds_pur.object.qty[ll_counter]
					if wf_check_stock(ll_gcode, ll_icode, ls_batch, ldt_expiry, ld_qty, ls_errortext) = 0 then
						ll_insrow = this.id_detail.insertrow(0)
						wf_inititeminfo(ll_icode, ll_insrow, li_retcode, ls_errortext)
						this.id_detail.object.icode[ll_insrow] = ll_icode
						this.id_detail.object.gcode[ll_insrow] = lds_pur.object.gcode[ll_counter]
						this.id_detail.object.batch[ll_insrow] = lds_pur.object.batch[ll_counter]
						this.id_detail.object.expiry[ll_insrow] = lds_pur.object.expiry[ll_counter]
						this.id_detail.object.saleprice[ll_insrow] = lds_pur.object.saleprice[ll_counter]
						this.id_detail.object.qty[ll_insrow] = lds_pur.object.qty[ll_counter]
						this.id_detail.object.discperc[ll_insrow] = lds_pur.object.discperc[ll_counter]
						this.id_detail.object.purinvcode[ll_insrow] = lds_pur.object.purinvcode[ll_counter]
						this.id_detail.object.suppcode[ll_insrow] = lds_pur.object.suppcode[ll_counter]
						this.id_detail.object.purchaseamt[ll_insrow] = lds_pur.object.purchaseamt[ll_counter]
						this.id_detail.object.purrowid[ll_insrow] = lds_pur.object.purrowid[ll_counter]
						this.id_detail.object.phone[ll_insrow] = lds_pur.object.phone[ll_counter]
						this.id_detail.object.orderno[ll_insrow] = lds_pur.object.orderno[ll_counter]
						this.id_detail.object.itemdescription[ll_insrow] = lds_pur.object.itemdescription[ll_counter]
						this.id_detail.object.purremarks[ll_insrow] = lds_pur.object.purremarks[ll_counter]
					else
						messagebox("Item Population Error", "Problem population of Item~r~nPurchase Invoice Code = " + trim(string(ll_purinvcode)) + "~r~nItem Name = " + ls_item + "~r~n" + ls_errortext, stopsign!)
					end if
				end if
			next
		end if
	end if
	return 0

// w_presales.wf_check_stock(long al_gcode, long al_icode, string as_batch, datetime adt_expiry, double ad_qty, string as_errortext) returns long
	double ld_stock
	SQL SELECT ISNULL ( SUM ( CurrQty ) , 0 ) INTO :ld_stock FROM GodownDetail WHERE GCode =:al_gcode AND ICode =:al_icode AND Batch =:as_batch AND Expiry =:adt_expiry USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ld_stock >= ad_qty then
			return 0
		else
			as_errortext = "Stock for this batch is not Enogh.~r~nQty Requested=" + trim(string(ad_qty)) + "~r~nStock In Hand=" + trim(string(ld_stock))
			return -1
		end if
		return
	end if
	as_errortext = "Problem Checking Stock for this batch.~r~n" + this.it_transobject.sqlerrtext
	return -2

// w_presales.wf_show_purchase_list() returns long
	long ll_count
	long ll_invcode
	long ll_masterrow
	long ll_insrow
	long ll_found
	string ls_viewoption
	datastore lds_invitemlist
	boolean lb_listtab
	boolean lb_editable = true
	s_datastore lstr
	if wf_iseditable() = false then
		lb_editable = false
	end if
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if not lb_listtab then
		lds_invitemlist = create datastore
		lds_invitemlist.dataobject = "d_pressales_showpurchaselist"
		lds_invitemlist.settransobject(sqlca)
		if lb_editable then
			this.id_detail.accepttext()
		end if
		for ll_count = 1 to this.id_detail.rowcount()
			ll_found = lds_invitemlist.find("purinvcode = " + trim(string(this.id_detail.getitemnumber(ll_count, "purinvcode"))), 1, lds_invitemlist.rowcount())
			if ll_found = 0 or ll_found > lds_invitemlist.rowcount() then
				ll_insrow = lds_invitemlist.insertrow(0)
				lds_invitemlist.setitem(ll_insrow, "purinvcode", this.id_detail.getitemnumber(ll_count, "purinvcode"))
				lds_invitemlist.setitem(ll_insrow, "suppcode", this.id_detail.getitemnumber(ll_count, "suppcode"))
			end if
		next
		lstr.ds = lds_invitemlist
		lstr.s_name1 = "d_pressales_showpurchaselist"
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		destroy lds_invitemlist
	end if
	return 0

// w_presales.wf_check_unique_refno() returns long
	long ll_custcode
	long ll_invid
	long ll_counter
	string ls_refno
	ls_refno = this.id_master.getitemstring(1, "custrefno")
	if trim(ls_refno) <> "" and not isnull(ls_refno) then
		ll_custcode = this.id_master.getitemnumber(1, "custcode")
		ll_counter = 0
		ll_invid = 0
		ll_invid = this.id_master.getitemnumber(1, "code")
		if ll_invid > 0 then
			SQL SELECT COUNT ( *) INTO :ll_counter FROM presaleheader WHERE custcode =:ll_custcode AND presaleinvcode <> :ll_invid AND RTrim ( LTrim ( custrefno ) ) =RTrim ( LTrim ( :ls_refno ) ) USING this.it_transobject;
		else
			SQL SELECT COUNT ( *) INTO :ll_counter FROM presaleheader WHERE custcode =:ll_custcode AND RTrim ( LTrim ( custrefno ) ) =RTrim ( LTrim ( :ls_refno ) ) USING this.it_transobject;
		end if
		if ll_counter > 0 then
			messagebox("Container No. Validation", "Container No. " + ls_refno + " already exist for selected customer ~r~nplease type a unique Container No. ")
			this.id_master.setcolumn("custrefno")
			this.id_master.setfocus()
			return 0
		end if
		return
	end if
	return 1

// w_presales.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_presale" then
		this.menuid = create m_presale
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep

// w_presales.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep

// w_presales.ue_save() returns 0 [event]
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_icode
	long ll_salelooseqty
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode = 1
	long ll_gcode
	long ll_headerno
	long ll_headerinvno
	long ll_counter
	long ll_count
	boolean lb_commitflag = true
	boolean lb_continue = true
	integer li_counter
	string ls_errtext
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_invgstperc1
	datetime ldt_server_datetime
	string ls_date_errtext
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if isnull(this.id_master.object.custrefno[1]) or this.id_master.object.custrefno[1] = "" then
		messagebox("Container No. Validation", "Please enter some valid Container No.", stopsign!)
		this.id_master.setfocus()
		this.id_master.setcolumn("custrefno")
		return
	end if
	if wf_check_unique_refno() = 0 then
		return
	end if
	if f_stringpreferences("Salesalesmanwindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if isnull(ll_invid) then
			f_newtableid("presaleheader", ll_invid)
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
		end if
		if this.ib_modify then
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		else
			this.id_master.setitem(ll_mastercurrrow, "usercode", ll_salesmancode)
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "Date", ldt_server_datetime)
		end if
		if lb_continue then
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.setitem(ll_counter, "code", ll_invid)
			next
			call super::ue_save
			this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
			if this.ib_commitok then
				this.ib_modify = false
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			messagebox("Updation Error", ls_errtext + " in current row", stopsign!)
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_presales.ue_newform() returns 0 [event]
	integer rtncode
	long li_fetched_code
	long row
	long ll_manfcode
	call super::ue_newform
	setredraw(false)
	this.im_menu.m_file.m_print.enabled = true
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	this.im_menu.m_file.m_post.enabled = false
	this.ib_modify = false
	wf_setgodownoption()
	if not wf_validatedate() then
		close(this)
		return
	end if
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	wf_visible(true)
	setredraw(true)

// w_presales.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect = 1
	long ll_row
	long ll_code
	boolean lb_flag
	boolean lb_modify
	call super::ue_detail
	this.im_menu.m_file.m_print.enabled = true
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "Y" then
		this.im_menu.m_file.m_save.enabled = false
		this.editflag = false
	else
		this.editflag = true
		this.im_menu.m_file.m_save.enabled = true
	end if
	li_protect = 0
	wf_initmodify(li_protect)
	ll_code = this.id_master.getitemnumber(1, "code")
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_setgodownoption()
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	wf_grandtotal()
	setredraw(true)

// w_presales.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true
	this.ii_defaultgcode = f_numberpreferences("Defaultgcode")

// w_presales.ue_deleteitem() returns 0 [event]
	long ll_row
	long ll_footerrow
	call super::ue_deleteitem
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() > 0 then
		this.id_footer.setitem(ll_footerrow, "icode", this.id_detail.getitemnumber(ll_row, "icode"))
		this.id_footer.setitem(ll_footerrow, "stock", this.id_detail.getitemnumber(ll_row, "stock"))
		return
	end if
	this.id_footer.setitem(ll_footerrow, "icode", 0)
	this.id_footer.setitem(ll_footerrow, "stock", 0)
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_save.enabled = false

// w_presales.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	return ::message.returnvalue

// w_presales.ue_list() returns 0 [event]
	long ll_row
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_post.enabled = true
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	ll_row = wf_retrievelist()
	wf_disabledetailtab(ll_row)
	post event ue_enableprint()

// w_presales.ue_print() returns 0 [event]
	long ll_custcode
	long ll_row
	long ll_invcode
	string ls_custname
	string ls_pagesize
	integer li_option
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	wf_selectprintreport()
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Pre-Sales", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Pre-Sales,~r~nNo rows are retrieved", information!)

// w_presales.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	setpointer(hourglass!)
	this.idc_customer.setredraw(false)
	this.idc_customer.settransobject(this.it_transobject)
	this.idc_customer.retrieve()
	this.idc_customer.setredraw(true)
	setpointer(arrow!)

// w_presales.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_presales.ue_postopen() returns 0 [event]
	datawindowchild ldc_headerno
	m_presale lm_menu
	integer li_rtncode
	long ll_counter
	long ll_pos
	long ll_found
	call super::ue_postopen
	this.ids_invoiceinfo = create datastore
	this.ids_invoiceinfo.dataobject = "d_saleinvinfo"
	this.ids_invoiceinfo.settransobject(this.it_transobject)
	setredraw(false)
	this.id_print = this.dw_saleinvrep
	li_rtncode = this.id_master.getchild("custcode", this.idc_customer)
	if li_rtncode = -1 then
		messagebox("Problem!!", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_customer.settransobject(this.it_transobject)
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Problem!", "Your Godown Settings do not permit to Make Pre-Sales")
		close(this)
		return
	end if
	this.ii_salegodown = this.idc_godown.getitemnumber(1, "gcode")
	this.id_detail.object.gcode.initial = string(this.ii_salegodown)
	this.id_detail.object.batch.initial = f_stringpreferences("defaultbatch")
	this.id_detail.object.expiry.initial = string(f_datepreferences("defaultexpiry"))
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = true
	this.id_itemslist.object.sstock.visible = true
	this.id_itemslist.object.t_pstock.visible = false
	this.id_itemslist.object.pstock.visible = false
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.sstock.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	if f_stringpreferences("bonusinsale") = "N" then
		this.id_detail.object.bonusqty.visible = false
	end if
	gd_itemsinfo.sharedata(this.id_itemslist)
	f_setcolumnstyle(this.id_detail, "Qty")
	setredraw(true)

// w_presales.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	return ::message.returnvalue

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	return ::message.returnvalue

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
	case "flatdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	end choose
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_code
	long ll_detailrows
	long ll_custcode
	long ll_counter
	long ll_customerbalance
	long ll_headerinvno
	long ll_icode
	long ll_res
	integer rt_code
	integer li_packunits
	integer ll_loosepack
	string ls_result
	string ls_null
	double ld_saleprice1
	double ld_saleprice2
	double ld_saleprice3
	double ld_avgprice
	double ld_rpp
	double ld_purprice
	double ld_packsalestax
	double ld_saleprice4
	double ld_saleprice5
	datetime ld_currdate
	date ld_datepart
	time lt_timepart
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "custcode"
		if not isnull(data) then
			ll_code = long(data)
			parent.setredraw(false)
			if parent.parent.parent.wf_customerinfo(ll_code) <> 0 then
				messagebox("Database Error", "Can not retrieve information from database")
			end if
			parent.setredraw(true)
		end if
	case "aliasname"
		if not isnull(data) and data <> "" then
			ll_res = parent.parent.parent.wf_findcustcode(data, ll_custcode)
			if ll_res > 0 then
				setitem(row, "custcode", ll_custcode)
				return 0
			else
				messagebox("Customer Validation", "Customer with  AliasName " + data + " does not exist")
				return 1
			end if
			return
		end if
	case "date"
		if isdate(left(data, 10)) then
			ld_datepart = date(left(data, 10))
			if istime(mid(data, 12, 8)) then
				lt_timepart = time(mid(data, 12, 8))
				ld_currdate = datetime(ld_datepart, lt_timepart)
				if ld_currdate < parent.parent.parent.id_systemdate then
					rt_code = 1
				end if
			else
				rt_code = 1
			end if
		else
			rt_code = 1
		end if
		return rt_code
	end choose
	return rt_code

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "date"
		if data = "" or isnull(data) then
			messagebox("Date Time Validation", "Date and Time is invalid,~r~nPlease enter current date and time")
		end if
	case "suppcode"
		if data = "" or isnull(data) then
			messagebox("Supplier Name Validation", "You must select some Supplier")
		end if
	case "refno"
		if data = "" or isnull(data) then
			messagebox("Reference Validation", "Please Enter Reference")
		end if
	case "price"
		if data = "" or isnull(data) then
			messagebox("Price Validation", "Please Select Valid Price")
		end if
	end choose
	return 1

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if string(dwo.name) = "suppcode" then
		parent.parent.parent.id_master.selecttext(1, 40)
	end if
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_detail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	parent.parent.parent.post wf_setcustname(data)
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	long ll_newqty
	long ll_storedqty
	long ll_null
	long ll_icode
	long ll_gcode
	long ll_desiredbonus
	string ls_null
	string ls_itemname
	integer li_res
	integer il_saleprice
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
		parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		if f_stringpreferences("multigodown") = "N" then
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = row
			li_errcode = 0
		else
			parent.parent.parent.ib_godownvalidated = false
			parent.parent.parent.ib_itemvalidated = true
		end if
	case "qty"
		ll_newqty = long(data) + getitemnumber(row, "bonusqty")
		if ll_newqty < 1 and f_stringpreferences("BonusinSale") = "N" then
			messagebox("Quantity Validation", "Item Qty ~"" + data + "~" should be greater than zero")
			li_errcode = 1
		elseif ll_newqty < 1 and f_stringpreferences("BonusinSale") = "Y" then
			setitem(row, "bonusqty", 1)
		end if
	case "bonusqty"
		ll_newqty = long(data) + getitemnumber(row, "Qty")
		if ll_newqty < 1 and f_stringpreferences("BonusinSale") = "Y" then
			setitem(row, "qty", 1)
		end if
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname)
			if li_res > 0 then
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
			else
				messagebox("ItemNumber Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_errcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_errcode = 2
		end if
	case "purprice"
	case "gcode"
		parent.parent.parent.is_columnname = "gcode"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_godownvalidated = false
		li_errcode = 0
	case "itemflatdisc"
		il_saleprice = getitemnumber(row, "saleprice")
		if il_saleprice < long(data) then
			messagebox("FlatDisc Validation", "Itemflatdisc must be less than sale price")
			li_errcode = 1
		end if
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ll_icode
	long ll_gcode
	long ll_godownstock
	long ancestorreturnvalue
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(false) = -1 then
		return ::message.returnvalue
	end if
	if parent.parent.parent.ib_godownvalidated = false and parent.parent.parent.wf_validategodown() = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "itemname" then
		parent.parent.parent.ib_focusdetail = true
	end if
	parent.parent.parent.wf_grandtotal()
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return 0

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(true) = -1 then
		return ::message.returnvalue
	end if
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if getcolumnname() <> parent.parent.parent.is_columnitemname then
		if rowcount() > 0 and lrs_status <> new! then
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", getitemnumber(currentrow, "icode"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", getitemnumber(currentrow, "stock"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", getitemnumber(currentrow, "totalstock"))
		elseif parent.parent.parent.id_footer.getrow() > 0 then
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", 0)
			if f_stringpreferences("BonusinSale") = "Y" then
				parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "bonusratio", "")
			end if
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "fullcode"
		if data = "" or isnull(data) then
		end if
	case parent.parent.parent.is_columnitemname
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case "qty"
	case "discperc"
		if real(data) < 0.0 and real(data) > 100.0 then
			messagebox("Item Discount Validation", "Discount ~"" + data + "~" must be betweeen 0 and 100")
		end if
	case "purprice"
		if double(data) <= 0.0 then
			messagebox("Item Price Validation", "Item price ~"" + data + "~" must be greater than zero")
		else
			messagebox("Item Price Validation", "Item price can not be changed")
		end if
	end choose
	return 1

// dw_itemsdetail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	long ancestorreturnvalue
	if f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	return ::message.returnvalue
