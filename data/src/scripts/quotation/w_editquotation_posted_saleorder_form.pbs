// window w_editquotation_posted_saleorder_form (quotation)  ancestor: window

// w_editquotation_posted_saleorder_form.ue_close(integer ai_status) returns 0 [event]
	closewithreturn(this, this.istr_template)

// w_editquotation_posted_saleorder_form.create() returns 0 [event]
	this.dw_control2 = create dw_control2
	this.st_1 = create st_1
	this.rb_append = create rb_append
	this.rb_deleteinsert = create rb_deleteinsert
	this.rb_totqty = create rb_totqty
	this.rb_eqty = create rb_eqty
	this.st_template = create st_template
	this.dw_template = create dw_template
	this.cb_ok = create cb_ok
	this.gb_1 = create gb_1
	this.gb_2 = create gb_2
	this.control = {this.dw_control2, this.st_1, this.rb_append, this.rb_deleteinsert, this.rb_totqty, this.rb_eqty, this.st_template, this.dw_template, this.cb_ok, this.gb_1, this.gb_2}

// w_editquotation_posted_saleorder_form.destroy() returns 0 [event]
	destroy this.dw_control2
	destroy this.st_1
	destroy this.rb_append
	destroy this.rb_deleteinsert
	destroy this.rb_totqty
	destroy this.rb_eqty
	destroy this.st_template
	destroy this.dw_template
	destroy this.cb_ok
	destroy this.gb_1
	destroy this.gb_2

// w_editquotation_posted_saleorder_form.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	this.dw_template.settransobject(sqlca)
	this.dw_template.insertrow(0)
	this.dw_template.scrolltorow(0)
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.insertrow(0)
	this.dw_control2.scrolltorow(0)
	return ::message.returnvalue

// w_editquotation_posted_saleorder_form.key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		this.istr_template.c_copyinvfrom = "N"
		this.istr_template.l_invtemplate = -1
		post event ue_close(1)
	end if
	return ::message.returnvalue

// dw_control2.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	this.object.quotation[1] = parent.dw_template.object.quotation[1]
	return ::message.returnvalue

// dw_control2.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_template.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "quotation"
		parent.dw_control2.object.quotation[1] = long(data)
		ll_retcode = 0
	end choose
	return ll_retcode

// dw_template.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// cb_ok.clicked() returns long [event]
	if isnull(parent.dw_template.getitemnumber(1, "quotation")) then
		return ::message.returnvalue
	end if
	if isnull(parent.dw_control2.getitemnumber(1, "quotation")) then
		return ::message.returnvalue
	end if
	if parent.dw_template.getitemnumber(1, "quotation") > parent.dw_control2.getitemnumber(1, "quotation") then
		messagebox("Quotation Range Validation", "Please enter a valid quotation range.")
		return ::message.returnvalue
	end if
	parent.istr_template.c_copyinvfrom = "T"
	parent.istr_template.l_invtemplate = parent.dw_template.getitemnumber(1, "quotation")
	parent.istr_template.l_invtemplate2 = parent.dw_control2.getitemnumber(1, "quotation")
	if parent.rb_eqty.checked = true then
		parent.istr_template.i_invtype = 1
	else
		parent.istr_template.i_invtype = 0
	end if
	if parent.rb_deleteinsert.checked = true then
		parent.istr_template.b_userinput = true
	else
		parent.istr_template.b_userinput = false
	end if
	parent.post event ue_close(1)
	return ::message.returnvalue
