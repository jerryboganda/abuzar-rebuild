			this.id_print.dataobject = "d_welcomehealth_quotationinvreport_t"
		elseif gs_company = "SALMANPH2" then
			this.id_print.dataobject = "d_salmanph2_quotationinvreport_thermal"
		elseif gs_company = "GREENPLUS18" then
			this.id_print.dataobject = "d_greenplus18_quotationinvreport_t"
		elseif gs_company = "HASSANMS2" then
			this.id_print.dataobject = "d_hassanms2_quotationinvreport_t"
		elseif gs_company = "MUNAWARPH3" then
			this.id_print.dataobject = "d_munawarph3_quotationinvreport_t"
		elseif gs_company = "ELECTRICSTOREPK" then
			this.id_print.dataobject = "d_electricstorepk_quotationinvreport_t"
		elseif gs_company = "RAZADIST" then
			this.id_print.dataobject = "d_razadist_quotationinvreport_thermal"
		else
			this.id_print.dataobject = "d_quotationinvreport_thermal_3inches"
		end if
	case else
		if gs_company = "ABDLBASITTRADER" then
			this.id_print.dataobject = "d_abdlbasittrader_quotationinvreport"
		elseif gs_company = "WASEEMTRADERS" then
			this.id_print.dataobject = "d_waseemtraders_quotationinvreport"
		elseif gs_company = "BOMBAYCHOCNNUTS" or gs_company = "BOMBAYDRYFRUIT" then
			this.id_print.dataobject = "d_bombaychocnnuts_quotationinvreport"
		elseif gs_company = "AHMEDBROTHERS" then
			this.id_print.dataobject = "d_ahmedbrothers_quotationinvreport"
		elseif gs_company = "ALBARI" then
			this.id_print.dataobject = "d_albarimedicose_quotationinvreport"
		elseif gs_company = "SHE" then
			this.id_print.dataobject = "d_she_quotationinvreport"
		elseif gs_company = "MEDLINXPHARMA" then
			this.id_print.dataobject = "d_medlinxpharma_quotationinvreport_q"
		else
			this.id_print.dataobject = "d_quotationinvreport"
		end if
	end choose
	this.id_print.settransobject(this.it_transobject)
	return ls_report

// w_quotation.wf_apply_custcat_itemcat_discount() returns long
	long ll_detailrows
	long ll_rowcount
	long ll_counter
	long ll_row
	long ll_master_row
	long ll_rtcode
	long ll_icode
	long ll_retrievecount
	long ll_custcode
	double ld_itemdiscperc
	double ld_itemflatdisc
	if wf_iseditable() = false then
		return 0
	end if
	ll_master_row = this.id_master.rowcount()
	ll_rowcount = this.id_detail.rowcount()
	if ll_master_row <= 0 then
		return 0
	end if
	if ll_rowcount <= 0 then
		return 0
	end if
	if this.id_master.object.posted[ll_master_row] = "Y" then
		messagebox("Population Problem!", "Can not apply discount policy after posting!")
		return 0
	end if
	if isnull(this.id_master.object.custcode[ll_master_row]) or this.id_master.object.custcode[ll_master_row] = 0 then
		messagebox("Population Problem!", "Please Select some Customer First!")
		this.id_master.setcolumn("custcode")
		this.id_master.setfocus()
		return 0
	end if
	ll_custcode = this.id_master.object.custcode[ll_master_row]
	for ll_counter = 1 to ll_rowcount
		ll_icode = this.id_detail.object.icode[ll_counter]
		if not (isnull(ll_icode) or ll_icode <= 0) then
			if wf_getcustitemcatwisesalesdiscount(ll_icode, ll_custcode, ld_itemdiscperc, ld_itemflatdisc) = true then
				this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc)
				this.id_detail.setitem(ll_counter, "itemflatdisc", ld_itemflatdisc)
			end if
		end if
	next
	return 0

// w_quotation.wf_sortitems() returns 0
	string ls_null
	setnull(ls_null)
	this.id_detail.setsort(ls_null)
	this.id_detail.sort()

// w_quotation.wf_populatefiltereditems() returns integer
	datastore lds_itemselected
	long ll_detailrows
	long ll_count
	long ll_duplrows
	long ll_insrow
	double ld_godownstock
	double ld_totalstock
	integer li_result
	integer li_rtncode
	boolean populateflag
	s_arguements lstr_selecteditems
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_retrievecount
	long ll_lockedcount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packsalestax
	double ld_gstperc
	double ld_recentpurprice
	double ld_stock
	string ls_fullcode
	string ls_errortext
	if wf_iseditable() = false then
		return 0
	end if
	this.id_itemslist.hide()
	if this.ib_modify = true and this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate items after posting!")
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 and isnull(this.id_detail.object.icode[ll_detailrows]) then
		this.id_detail.setrow(ll_detailrows)
		this.id_detail.deleterow(0)
	end if
	if populateflag = true then
		openwithparm(w_arg_item_populate3, this.ii_module)
		lstr_selecteditems = message.powerobjectparm
		lds_itemselected = create datastore
		if lstr_selecteditems.s_name2 = "OR" then
			lds_itemselected.dataobject = "d_populateditems_active"
		else
			lds_itemselected.dataobject = "d_populateditems_active_and"
		end if
		lds_itemselected.settransobject(this.it_transobject)
		ll_rtcode = lds_itemselected.retrieve(lstr_selecteditems.ia_integerlist, lstr_selecteditems.ia_integerlist1, lstr_selecteditems.ia_integerlist2, lstr_selecteditems.la_longlist, lstr_selecteditems.l_code1, lstr_selecteditems.s_name1)
		ll_rowcount = lds_itemselected.rowcount()
		setpointer(hourglass!)
		this.id_detail.setredraw(false)
		for ll_count = 1 to ll_rowcount
			ll_icode = lds_itemselected.object.icode[ll_count]
			ll_insrow = this.id_detail.insertrow(0)
			wf_inititeminfo(ll_icode, ll_insrow, li_rtncode, ls_errortext)
			this.id_detail.setitemstatus(ll_insrow, "saleprice", primary!, notmodified!)
			ll_retrievecount = ll_retrievecount + 1
		next
		this.id_detail.setredraw(true)
		setpointer(arrow!)
		destroy lds_itemselected
		messagebox("Result", string(ll_rowcount) + " Items are populated. ")
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 and this.ib_modify = false then
		this.im_menu.m_file.m_save.enabled = true
	end if
	return ll_retrievecount

// w_quotation.wf_setdiscount_manfwise() returns long
	long ll_counter
	long ll_find
	double ld_discperc
	string ls_manufname
	string ls_msg_title
	string ls_msg_detail
	string ls_findstr
	datastore lds_ds
	s_datastore lstr_ds
	if wf_iseditable() = false then
		return 0
	end if
	lds_ds = create datastore
	lds_ds.settransobject(sqlca)
	lds_ds.dataobject = "d_setdiscount_manfwise"
	ls_msg_title = "Manufacturer Wise Discount Setting"
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		this.id_detail.setsort("manufacturer, itemname")
		this.id_detail.sort()
		for ll_counter = 1 to this.id_detail.rowcount()
			ls_manufname = this.id_detail.object.manufacturer[ll_counter]
			ld_discperc = this.id_detail.object.discperc[ll_counter]
			ls_findstr = "manufacturer = '" + ls_manufname + "'"
			ll_find = lds_ds.find(ls_findstr, 1, lds_ds.rowcount())
			if ll_find <= 0 then
				ll_find = lds_ds.insertrow(0)
			end if
			if ll_find > 0 then
				lds_ds.object.manufacturer[ll_find] = ls_manufname
				if lds_ds.object.discperc[ll_find] < ld_discperc then
					lds_ds.object.discperc[ll_find] = ld_discperc
				end if
			end if
		next
		this.id_detail.setredraw(false)
		setpointer(hourglass!)
		if lds_ds.rowcount() > 0 then
			lstr_ds.ds = lds_ds
			openwithparm(w_setdiscount_manfwise, lstr_ds)
			lstr_ds = message.powerobjectparm
			if lstr_ds.i_closemode = 0 then
				lds_ds = lstr_ds.ds
				for ll_counter = 1 to this.id_detail.rowcount()
					ls_manufname = this.id_detail.object.manufacturer[ll_counter]
					ld_discperc = this.id_detail.object.discperc[ll_counter]
					ls_findstr = "manufacturer = '" + ls_manufname + "'"
					ll_find = lds_ds.find(ls_findstr, 1, lds_ds.rowcount())
					if ll_find > 0 then
						this.id_detail.object.discperc[ll_counter] = lds_ds.object.discperc[ll_find]
					end if
				next
			end if
		else
			messagebox(ls_msg_title, "No Item Exists in this Quotation/Pricing Contract~r~nKindly select some item(s) first and try again...")
		end if
		this.id_detail.setredraw(true)
		setpointer(arrow!)
	else
		messagebox(ls_msg_title, "No Item Exists in this Quotation/Pricing Contract~r~nKindly select some item(s) first and try again")
	end if
	return 0

// w_quotation.wf_editsaleorder() returns long
	datastore lds_saleorderdetail
	datastore lds_saleorderheader
	s_saletemplate lstr_template
	boolean lb_enablesave
	boolean lb_insertrow
	integer li_retcode
	integer li_errcode
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_counter
	long ll_tmprowid
	long ll_tmpcode
	long ll_icode
	double ld_tmpqty
	double ld_tmpbonus
	string ls_errortext
	if wf_iseditable() = false then
		return 0
	end if
	lds_saleorderdetail = create datastore
	lds_saleorderheader = create datastore
	open(w_editsaleorder_form)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_saleorderdetail.dataobject = "d_SaleOrderdetail"
		lds_saleorderdetail.settransobject(this.it_transobject)
		lds_saleorderheader.dataobject = "d_SaleOrderheader"
		lds_saleorderheader.settransobject(this.it_transobject)
		ll_row = lds_saleorderheader.retrieve(lstr_template.l_invtemplate)
		if ll_row <= 0 then
			li_retcode = -1
		else
			ll_mrow = this.id_master.getrow()
			this.id_master.setitem(ll_mrow, "custcode", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "custcode"))
			this.id_master.setitem(ll_mrow, "remarks", lds_saleorderheader.getitemstring(lds_saleorderheader.getrow(), "remarks"))
			this.id_master.setitem(ll_mrow, "headerno", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "headerno"))
			this.id_footer.setitem(ll_mrow, "misccharges", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "misccharges"))
			this.id_footer.setitem(ll_mrow, "flatdisc", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "flatdisc"))
			this.id_footer.setitem(ll_mrow, "invdiscperc", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "discperc"))
			this.id_master.setitem(ll_mrow, "smancode", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "smancode"))
			this.id_master.setitem(ll_mrow, "loosepack", 1)
			lds_saleorderdetail.retrieve(lstr_template.l_invtemplate)
		end if
		ll_totalrows = lds_saleorderdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		if lb_enablesave then
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
			this.id_detail.reset()
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				lb_insertrow = false
				ld_tmpqty = 0
				ld_tmpbonus = 0
				ll_rowcount = this.id_detail.insertrow(0)
				ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_saleorderdetail.getitemnumber(ll_counter, "gcode")), 1, this.idc_godown.rowcount())
				ll_icode = lds_saleorderdetail.getitemnumber(ll_counter, "icode")
				if wf_inititeminfo(ll_icode, ll_rowcount, li_errcode, ls_errortext) then
					ll_gcode = lds_saleorderdetail.getitemnumber(ll_counter, "gcode")
					this.id_detail.setitem(ll_rowcount, "gcode", ll_gcode)
					this.id_detail.setitem(ll_rowcount, "packunits", lds_saleorderdetail.getitemnumber(ll_counter, "packunits"))
					this.id_detail.setitem(ll_rowcount, "discperc", lds_saleorderdetail.getitemnumber(ll_counter, "discperc"))
					this.id_detail.setitem(ll_rowcount, "itemflatdisc", lds_saleorderdetail.getitemnumber(ll_counter, "itemflatdisc"))
					this.id_detail.setitem(ll_rowcount, "looseqty", lds_saleorderdetail.getitemnumber(ll_counter, "looseqty"))
					this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty"))
				end if
			next
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return li_retcode

// w_quotation.wf_itemsalehistory() returns 0
	s_itemsalehistory ls_itemsalehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itemsalehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itemsalehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itemsalehistory, ls_itemsalehistory)
	end if

// w_quotation.wf_po_generate_policybased() returns 0
	boolean lb_listtab
	datastore lds_po
	datastore lds_suppitems
	long ll_counter
	long ll_endrow
	long ll_rows
	long ll_porow
	long ll_days
	long ll_projectiondays
	long ll_minqty
	long ll_suppitemrows
	long ll_insrow
	long ll_found
	long ll_packunits
	long ll_icode
	long ll_code
	integer li_allrows
	integer li_rtncode
	double ld_avgqty
	double ld_packqty
	double ld_purdiscperc
	double ld_gstperc
	double ld_packsalestax
	string ls_fullcode
	string ls_name
	string ls_po_mode
	string ls_errortxt
	boolean lb_suppitems
	boolean lb_insertrow
	boolean lb_suppitemsonly
	double ld_looseqty
	double ld_transitstock
	double ld_stock
	double ld_forecastqty
	s_arguements lstr_arg
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab = true then
		return
	end if
	if wf_iseditable() = false then
		return
	end if
	if this.id_master.getitemnumber(1, "code") > 0.0 and this.id_master.getitemstring(1, "Posted") = "Y" then
		return
	end if
	if this.id_master.accepttext() = -1 then
		return
	end if
	open(w_arg_po_generate_from_quot)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		if lstr_arg.l_code3 = 1 and not isnull(lstr_arg.l_code2) then
			lds_suppitems = create datastore
			lds_suppitems.dataobject = "d_item_suppliers"
			lds_suppitems.settransobject(sqlca)
			lb_suppitemsonly = true
			ll_suppitemrows = lds_suppitems.retrieve(lstr_arg.l_code2)
			if ll_suppitemrows > 0 then
				lb_suppitems = true
			else
				lb_suppitems = false
			end if
		else
			lb_suppitems = false
		end if
		lds_po = create datastore
		if lstr_arg.l_code1 < 3 then
			ll_counter = 1
			for ll_counter = this.id_detail.rowcount() to 1 step -1
				this.id_detail.deleterow(ll_counter)
			next
			if lstr_arg.l_code1 = 1 then
				if lstr_arg.i_status = 1 then
					lds_po.dataobject = "d_dspodetail_policybased"
					lds_po.settransobject(sqlca)
					ll_rows = lds_po.retrieve(lstr_arg.d_edate)
				end if
				if ll_rows >= 0 then
					ll_endrow = lds_po.rowcount()
					setpointer(hourglass!)
					ll_insrow = 0
					for ll_counter = 1 to ll_endrow
						ll_packunits = lds_po.object.packunits[ll_counter]
						if ll_packunits = 0 then
							ll_packunits = 1
						end if
						ld_transitstock = lds_po.object.transitstock[ll_counter]
						ld_packqty = ceiling((lds_po.object.optimumqty[ll_counter] - (lds_po.object.currqty[ll_counter] + ld_transitstock)) / ll_packunits)
						if lb_suppitems then
							ll_found = lds_suppitems.find("icode = " + trim(string(lds_po.getitemnumber(ll_counter, "icode"))), 1, ll_suppitemrows)
							if ll_found > 0 then
								lb_insertrow = true
								ll_insrow = ll_insrow + 1
							else
								lb_insertrow = false
							end if
						else
							this.id_detail.insertrow(0)
							lb_insertrow = true
							ll_insrow = ll_insrow + 1
						end if
						if lb_insertrow = true then
							ll_icode = lds_po.object.icode[ll_counter]
							SQL SELECT purdiscperc INTO :ld_purdiscperc FROM ITEM WHERE Icode =:ll_icode USING sqlca;
							if wf_inititeminfo(ll_icode, ll_insrow, li_rtncode, ls_errortxt) = true then
								this.id_detail.object.icode[ll_insrow] = ll_icode
								this.id_detail.object.looseqty[ll_insrow] = ld_packqty
								this.id_detail.object.packunits[ll_insrow] = lds_po.object.packunits[ll_counter]
								this.id_detail.object.discperc[ll_insrow] = ld_purdiscperc
								this.id_detail.object.saleprice[ll_insrow] = lds_po.object.purprice[ll_counter]
								this.id_detail.object.bonusqty[ll_insrow] = lds_po.object.bonusqty[ll_counter]
								if f_stringpreferences("ItemGSTPercInPO") = "N" then
									this.id_detail.object.gstperc[ll_insrow] = 0
								else
									this.id_detail.object.gstperc[ll_insrow] = lds_po.object.gstperc[ll_counter]
								end if
								if f_stringpreferences("ItemUnitTaxInPO") = "N" then
									this.id_detail.object.packsalestax[ll_insrow] = 0
								else
									this.id_detail.object.packsalestax[ll_insrow] = lds_po.object.packsalestax[ll_counter]
								end if
							end if
						end if
					next
					this.id_detail.scrolltorow(0)
					setpointer(arrow!)
				else
					messagebox("Retrieve Fail", "Can not Generate Purchase Order", exclamation!, ok!, 1)
				end if
			elseif lstr_arg.l_code1 = 2 then
				if lstr_arg.i_status = 1 then
					lds_po.dataobject = "d_dspodetail_baseperiod_policybased"
					lds_po.settransobject(sqlca)
					ll_rows = lds_po.retrieve(lstr_arg.d_sdate, lstr_arg.d_edate)
				end if
				if ll_rows >= 0 then
					ll_endrow = lds_po.rowcount()
					setpointer(hourglass!)
					ll_porow = 0
					for ll_counter = 1 to ll_endrow
						ll_days = lds_po.object.purorderbaseperioddays[ll_counter]
						if isnull(ll_days) or ll_days = 0 then
							ll_days = 1
						end if
						ll_projectiondays = lds_po.object.purorderprojperioddays[ll_counter]
						if isnull(ll_projectiondays) or ll_projectiondays = 0 then
							ll_projectiondays = 1
						end if
						ld_transitstock = lds_po.object.transitstock[ll_counter]
						ld_stock = lds_po.getitemnumber(ll_counter, "stock")
						ld_avgqty = (lds_po.getitemnumber(ll_counter, "soldqty") - lds_po.getitemnumber(ll_counter, "Returnqty")) / ll_days
						ld_forecastqty = ceiling(ld_avgqty * ll_projectiondays)
						ll_minqty = lds_po.getitemnumber(ll_counter, "minqty")
						if ld_forecastqty > ld_stock + ld_transitstock then
							ld_looseqty = ld_forecastqty - (ld_stock + ld_transitstock)
							if ld_forecastqty < ll_minqty then
								ld_looseqty = ll_minqty - (ld_stock + ld_transitstock)
							end if
						else
							ld_looseqty = 0
							if ld_stock + ld_transitstock < ll_minqty then
								ld_looseqty = ll_minqty - (ld_stock + ld_transitstock)
							end if
						end if
						ll_packunits = lds_po.getitemnumber(ll_counter, "packunits")
						if ll_packunits = 0 then
							ll_packunits = 1
						end if
						ld_packqty = ceiling(ld_looseqty / ll_packunits)
						if ld_packqty > 0.0 or li_allrows = 1 then
							if lb_suppitems then
								ll_found = lds_suppitems.find("icode = " + trim(string(lds_po.getitemnumber(ll_counter, "icode"))), 1, ll_suppitemrows)
								if ll_found > 0 then
									this.id_detail.insertrow(0)
									lb_insertrow = true
									ll_insrow = ll_insrow + 1
								else
									lb_insertrow = false
								end if
							else
								this.id_detail.insertrow(0)
								lb_insertrow = true
								ll_insrow = ll_insrow + 1
							end if
							if lb_insertrow = true then
								ll_icode = lds_po.object.icode[ll_counter]
								SQL SELECT purdiscperc INTO :ld_purdiscperc FROM ITEM WHERE Icode =:ll_icode USING sqlca;
								if wf_inititeminfo(ll_icode, ll_insrow, li_rtncode, ls_errortxt) = true then
									this.id_detail.object.icode[ll_insrow] = ll_icode
									this.id_detail.object.looseqty[ll_insrow] = ld_packqty
									this.id_detail.object.packunits[ll_insrow] = lds_po.object.packunits[ll_counter]
									this.id_detail.object.discperc[ll_insrow] = ld_purdiscperc
									this.id_detail.object.saleprice[ll_insrow] = lds_po.object.purprice[ll_counter]
									this.id_detail.object.bonusqty[ll_insrow] = lds_po.object.bonusqty[ll_counter]
									if f_stringpreferences("ItemGSTPercInPO") = "N" then
										this.id_detail.object.gstperc[ll_insrow] = 0
									else
										this.id_detail.object.gstperc[ll_insrow] = lds_po.object.gstperc[ll_counter]
									end if
									if f_stringpreferences("ItemUnitTaxInPO") = "N" then
										this.id_detail.object.packsalestax[ll_insrow] = 0
									else
										this.id_detail.object.packsalestax[ll_insrow] = lds_po.object.packsalestax[ll_counter]
									end if
								end if
							end if
						end if
					next
					this.id_detail.scrolltorow(0)
					setpointer(arrow!)
					this.im_menu.m_file.m_options.enabled = true
					this.im_menu.m_file.m_save.enabled = true
					this.im_menu.m_file.m_print.enabled = true
				else
					messagebox("Retrieve Fail", "Can not Generate Purchase Order", exclamation!, ok!, 1)
				end if
			end if
		end if
	end if
	wf_grandtotal()
	destroy lds_po
	destroy lds_suppitems

// w_quotation.wf_po_generate() returns 0
	boolean lb_listtab
	datastore lds_po
	datastore lds_suppitems
	long ll_counter
	long ll_endrow
	long ll_rows
	long ll_porow
	long ll_days
	long ll_projectiondays
	long ll_minqty
	long ll_suppitemrows
	long ll_insrow
	long ll_found
	long ll_packunits
	long ll_icode
	long ll_code
	long ll_orderlevel_type
	integer li_allrows
	double ld_avgqty
	double ld_packqty
	double ld_purdiscperc
	double ld_bonusqty
	double ld_packstock
	string ls_fullcode
	string ls_name
	boolean lb_suppitems
	boolean lb_insertrow
	boolean lb_suppitemsonly
	double ld_tmpqty
	double ld_tmpbonus
	double ld_transitstock
	double ld_stock
	double ld_forecastqty
	double ld_looseqty
	double ld_saleorderrequest
	s_saletemplate lstr_template
	s_arguements lstr_tmp
	m_purchaseordermenu lm_menu
	s_arguements lstr_arg
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab = true then
		return
	end if
	if wf_iseditable() = false then
		return
	end if
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	if wf_iseditable() = false then
		return
	end if
	if this.id_master.getitemnumber(1, "code") > 0.0 and this.id_master.getitemstring(1, "Posted") = "Y" then
		return
	end if
	if this.id_master.accepttext() = -1 then
		return
	end if
	if this.id_master.object.purordercatcode[1] = 2 then
		ll_days = daysafter(date(this.id_master.object.startdate[this.id_master.getrow()]), date(this.id_master.object.enddate[this.id_master.getrow()])) + 1
		ll_projectiondays = this.id_master.getitemnumber(1, "projectionperiod")
		if ll_days = 0 or ll_projectiondays = 0 or isnull(ll_days) or isnull(ll_projectiondays) then
			messagebox("Problem Generating Order", "Please Select Valid Base Period and Projection Days.")
			return
		end if
		if this.id_master.object.startdate[this.id_master.getrow()] > this.id_master.object.enddate[this.id_master.getrow()] then
			messagebox("Problem Generating Order", "Please Select Valid Base Period.")
			return
		end if
		return
	end if
	if lm_menu.m_file.m_supplieritemsonly.checked = true and not isnull(this.id_master.object.suppcode[1]) then
		lds_suppitems = create datastore
		lds_suppitems.dataobject = "d_item_suppliers"
		lds_suppitems.settransobject(sqlca)
		lb_suppitemsonly = true
		ll_suppitemrows = lds_suppitems.retrieve(this.id_master.object.suppcode[1])
		if ll_suppitemrows > 0 then
			lb_suppitems = true
		else
			lb_suppitems = false
		end if
	else
		lb_suppitems = false
	end if
	lds_po = create datastore
	open(w_arg_item_populate2)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		ll_counter = 1
		for ll_counter = this.id_detail.rowcount() to 1 step -1
			this.id_detail.deleterow(ll_counter)
		next
		if this.id_master.object.purordercatcode[1] = 1 then
			if lstr_arg.i_status = 1 then
				open(w_select_purorder_reorderlevel)
				ll_orderlevel_type = message.doubleparm
				if ll_orderlevel_type = 2 then
					open(w_arg_godown)
					lstr_tmp = message.powerobjectparm
				end if
				li_allrows = 0
				li_allrows = this.id_master.getitemnumber(this.id_master.getrow(), "zeroqty")
				if ll_orderlevel_type = 1 then
					if lstr_arg.s_name2 = "AND" then
						lds_po.dataobject = "d_dspodetail_and"
						lds_po.settransobject(sqlca)
						ll_rows = lds_po.retrieve(lstr_arg.ia_integerlist, lstr_arg.ia_integerlist1, lstr_arg.ia_integerlist2, lstr_arg.la_longlist, li_allrows)
					else
						lds_po.dataobject = "d_dspodetail"
						lds_po.settransobject(sqlca)
						ll_rows = lds_po.retrieve(lstr_arg.ia_integerlist, lstr_arg.ia_integerlist1, lstr_arg.ia_integerlist2, lstr_arg.la_longlist, lstr_arg.s_name1, li_allrows)
					end if
				elseif lstr_arg.s_name2 = "AND" then
					lds_po.dataobject = "d_dspodetail_godownwise_and"
					lds_po.settransobject(sqlca)
					ll_rows = lds_po.retrieve(lstr_arg.ia_integerlist, lstr_arg.ia_integerlist1, lstr_arg.ia_integerlist2, lstr_arg.la_longlist, lstr_tmp.l_code3, li_allrows)
				else
					lds_po.dataobject = "d_dspodetail_godownwise"
					lds_po.settransobject(sqlca)
					ll_rows = lds_po.retrieve(lstr_arg.ia_integerlist, lstr_arg.ia_integerlist1, lstr_arg.ia_integerlist2, lstr_arg.la_longlist, lstr_arg.s_name1, lstr_tmp.l_code3, li_allrows)
				end if
			end if
			if ll_rows >= 0 then
				ll_endrow = lds_po.rowcount()
				setpointer(hourglass!)
				ll_insrow = 0
				for ll_counter = 1 to ll_endrow
					ll_packunits = lds_po.object.packunits[ll_counter]
					if ll_packunits = 0 then
						ll_packunits = 1
					end if
					ld_transitstock = lds_po.object.transitstock[ll_counter]
					ld_packqty = ceiling((lds_po.object.optimumqty[ll_counter] - (lds_po.object.currqty[ll_counter] + ld_transitstock)) / ll_packunits)
					if lb_suppitems then
						ll_found = lds_suppitems.find("icode = " + trim(string(lds_po.getitemnumber(ll_counter, "icode"))), 1, ll_suppitemrows)
						if ll_found > 0 then
							lb_insertrow = true
							ll_insrow = ll_insrow + 1
						else
							lb_insertrow = false
						end if
					else
						this.id_detail.insertrow(0)
						lb_insertrow = true
						ll_insrow = ll_insrow + 1
					end if
					if lb_insertrow = true then
						ll_icode = lds_po.object.icode[ll_counter]
						SQL SELECT purdiscperc INTO :ld_purdiscperc FROM ITEM WHERE Icode =:ll_icode USING sqlca;
						this.id_detail.object.icode[ll_insrow] = ll_icode
						this.id_detail.object.looseqty[ll_insrow] = lds_po.object.optimumqty[ll_counter] - (lds_po.object.currqty[ll_counter] + ld_transitstock)
						this.id_detail.object.packunits[ll_insrow] = lds_po.object.packunits[ll_counter]
						this.id_detail.object.saleorderrequest[ll_insrow] = 0
						this.id_detail.object.qty[ll_insrow] = ld_packqty
						this.id_detail.object.allowedqty[ll_insrow] = ld_packqty
						this.id_detail.object.transitstock[ll_insrow] = ld_transitstock
						this.id_detail.object.rate[ll_insrow] = lds_po.object.rate[ll_counter]
						this.id_detail.object.minqty[ll_insrow] = lds_po.object.minqty[ll_counter]
						this.id_detail.object.reorderqty[ll_insrow] = lds_po.object.reorderqty[ll_counter]
						this.id_detail.object.optimumqty[ll_insrow] = lds_po.object.optimumqty[ll_counter]
						this.id_detail.object.stock[ll_insrow] = lds_po.object.currqty[ll_counter]
						this.id_detail.object.itemname[ll_insrow] = lds_po.object.item[ll_counter]
						this.id_detail.object.manufname[ll_insrow] = lds_po.object.manufacturer[ll_counter]
						this.id_detail.object.itemcategory[ll_insrow] = lds_po.object.itemcategory[ll_counter]
						this.id_detail.object.itemclass[ll_insrow] = lds_po.object.itemclass[ll_counter]
						this.id_detail.object.itempacking[ll_insrow] = lds_po.object.itempacking[ll_counter]
						this.id_detail.object.genericitem[ll_insrow] = lds_po.object.genericitem[ll_counter]
						this.id_detail.object.fullcode[ll_insrow] = lds_po.object.aliasname[ll_counter]
						this.id_detail.object.discperc[ll_insrow] = ld_purdiscperc
						this.id_detail.object.purprice[ll_insrow] = lds_po.object.purprice[ll_counter]
						this.id_detail.object.saleprice[ll_insrow] = lds_po.object.saleprice[ll_counter]
						this.id_detail.object.rpp[ll_insrow] = lds_po.object.rpp[ll_counter]
						this.id_detail.object.packavgprice[ll_insrow] = lds_po.object.packavgprice[ll_counter]
						this.id_detail.object.lastpurinvcode[ll_insrow] = lds_po.object.lastpurinvcode[ll_counter]
						this.id_detail.object.lastpurdate[ll_insrow] = lds_po.object.lastpurdate[ll_counter]
						if f_stringpreferences("ItemGSTPercInPO") = "N" then
							this.id_detail.object.gstperc[ll_insrow] = 0
						else
							this.id_detail.object.gstperc[ll_insrow] = lds_po.object.gstperc[ll_counter]
						end if
						if f_stringpreferences("ItemUnitTaxInPO") = "N" then
							this.id_detail.object.packsalestax[ll_insrow] = 0
						else
							this.id_detail.object.packsalestax[ll_insrow] = lds_po.object.packsalestax[ll_counter]
						end if
					end if
				next
				this.id_detail.scrolltorow(0)
				setpointer(arrow!)
			else
				messagebox("Retrieve Fail", "Can not Generate Purchase Order", exclamation!, ok!, 1)
			end if
		elseif this.id_master.object.purordercatcode[1] = 2 then
			if lstr_arg.i_status = 1 then
				if lstr_arg.s_name2 = "AND" then
					lds_po.dataobject = "d_dspodetail_baseperiod_and"
					lds_po.settransobject(sqlca)
					ll_rows = lds_po.retrieve(lstr_arg.ia_integerlist, lstr_arg.ia_integerlist1, lstr_arg.ia_integerlist2, lstr_arg.la_longlist, this.id_master.object.startdate[this.id_master.getrow()], this.id_master.object.enddate[this.id_master.getrow()])
				else
					lds_po.dataobject = "d_dspodetail_baseperiod"
					lds_po.settransobject(sqlca)
					ll_rows = lds_po.retrieve(lstr_arg.ia_integerlist, lstr_arg.ia_integerlist1, lstr_arg.ia_integerlist2, lstr_arg.la_longlist, lstr_arg.s_name1, this.id_master.object.startdate[this.id_master.getrow()], this.id_master.object.enddate[this.id_master.getrow()])
				end if
			end if
			if ll_rows >= 0 then
				ll_endrow = lds_po.rowcount()
				setpointer(hourglass!)
				ll_days = daysafter(date(this.id_master.object.startdate[this.id_master.getrow()]), date(this.id_master.object.enddate[this.id_master.getrow()]))
				ll_projectiondays = this.id_master.getitemnumber(1, "projectionperiod")
				li_allrows = this.id_master.getitemnumber(this.id_master.getrow(), "zeroqty")
				ll_porow = 0
				if ll_days = 0 then
					ll_days = 1
				end if
				for ll_counter = 1 to ll_endrow
					ld_transitstock = lds_po.object.transitstock[ll_counter]
					ld_stock = lds_po.getitemnumber(ll_counter, "stock")
					ld_avgqty = (lds_po.getitemnumber(ll_counter, "soldqty") - lds_po.getitemnumber(ll_counter, "Returnqty")) / ll_days
					ld_forecastqty = ceiling(ld_avgqty * ll_projectiondays)
					ll_minqty = lds_po.getitemnumber(ll_counter, "minqty")
					if ld_forecastqty > ld_stock + ld_transitstock then
						ld_looseqty = ld_forecastqty - (ld_stock + ld_transitstock)
						if ld_forecastqty < ll_minqty then
							ld_looseqty = ll_minqty - (ld_stock + ld_transitstock)
						end if
					else
						ld_looseqty = 0
						if ld_stock + ld_transitstock < ll_minqty then
							ld_looseqty = ll_minqty - (ld_stock + ld_transitstock)
						end if
					end if
					ll_packunits = lds_po.getitemnumber(ll_counter, "packunits")
					if ll_packunits = 0 then
						ll_packunits = 1
					end if
					ld_packqty = ceiling(ld_looseqty / ll_packunits)
					if ld_packqty > 0.0 or li_allrows = 1 then
						if lb_suppitems then
							ll_found = lds_suppitems.find("icode = " + trim(string(lds_po.getitemnumber(ll_counter, "icode"))), 1, ll_suppitemrows)
							if ll_found > 0 then
								this.id_detail.insertrow(0)
								lb_insertrow = true
								ll_insrow = ll_insrow + 1
							else
								lb_insertrow = false
							end if
						else
							this.id_detail.insertrow(0)
							lb_insertrow = true
							ll_insrow = ll_insrow + 1
						end if
						if lb_insertrow = true then
							ll_icode = lds_po.object.icode[ll_counter]
							SQL SELECT purdiscperc INTO :ld_purdiscperc FROM ITEM WHERE Icode =:ll_icode USING sqlca;
							this.id_detail.setitem(ll_insrow, "icode", lds_po.getitemnumber(ll_counter, "icode"))
							this.id_detail.setitem(ll_insrow, "rate", lds_po.getitemnumber(ll_counter, "purprice"))
							this.id_detail.setitem(ll_insrow, "stock", lds_po.getitemnumber(ll_counter, "stock"))
							this.id_detail.setitem(ll_insrow, "transitstock", lds_po.getitemnumber(ll_counter, "transitstock"))
							this.id_detail.object.saleorderrequest[ll_insrow] = 0
							this.id_detail.setitem(ll_insrow, "soldqty", lds_po.getitemnumber(ll_counter, "soldqty"))
							this.id_detail.setitem(ll_insrow, "returnqty", lds_po.getitemnumber(ll_counter, "returnqty"))
							this.id_detail.setitem(ll_insrow, "netsaleqty", lds_po.getitemnumber(ll_counter, "soldqty") - lds_po.getitemnumber(ll_counter, "returnqty"))
							this.id_detail.setitem(ll_insrow, "packunits", lds_po.getitemnumber(ll_counter, "packunits"))
							this.id_detail.setitem(ll_insrow, "minqty", lds_po.getitemnumber(ll_counter, "minqty"))
							this.id_detail.setitem(ll_insrow, "avgsaleqty", ld_avgqty)
							this.id_detail.setitem(ll_insrow, "forecastqty", ld_forecastqty)
							this.id_detail.setitem(ll_insrow, "looseqty", ld_looseqty)
							this.id_detail.setitem(ll_insrow, "qty", ld_packqty)
							this.id_detail.setitem(ll_insrow, "allowedqty", ld_packqty)
							this.id_detail.setitem(ll_insrow, "fullcode", lds_po.getitemstring(ll_counter, "aliasname"))
							this.id_detail.setitem(ll_insrow, "itemname", lds_po.getitemstring(ll_counter, "item"))
							this.id_detail.setitem(ll_insrow, "manufname", lds_po.getitemstring(ll_counter, "manufacturer"))
							this.id_detail.object.itemcategory[ll_insrow] = lds_po.object.itemcategory[ll_counter]
							this.id_detail.object.itemclass[ll_insrow] = lds_po.object.itemclass[ll_counter]
							this.id_detail.object.itempacking[ll_insrow] = lds_po.object.itempacking[ll_counter]
							this.id_detail.object.genericitem[ll_insrow] = lds_po.object.genericitem[ll_counter]
							this.id_detail.object.discperc[ll_insrow] = ld_purdiscperc
							this.id_detail.object.purprice[ll_insrow] = lds_po.object.purprice[ll_counter]
							this.id_detail.object.saleprice[ll_insrow] = lds_po.object.saleprice[ll_counter]
							this.id_detail.object.rpp[ll_insrow] = lds_po.object.rpp[ll_counter]
							this.id_detail.object.packavgprice[ll_insrow] = lds_po.object.packavgprice[ll_counter]
							this.id_detail.object.lastpurinvcode[ll_insrow] = lds_po.object.lastpurinvcode[ll_counter]
							this.id_detail.object.lastpurdate[ll_insrow] = lds_po.object.lastpurdate[ll_counter]
							if f_stringpreferences("ItemGSTPercInPO") = "N" then
								this.id_detail.object.gstperc[ll_insrow] = 0
							else
								this.id_detail.object.gstperc[ll_insrow] = lds_po.object.gstperc[ll_counter]
							end if
							if f_stringpreferences("ItemUnitTaxInPO") = "N" then
								this.id_detail.object.packsalestax[ll_insrow] = 0
							else
								this.id_detail.object.packsalestax[ll_insrow] = lds_po.object.packsalestax[ll_counter]
							end if
						end if
					end if
				next
				this.id_detail.scrolltorow(0)
				setpointer(arrow!)
				this.im_menu.m_file.m_options.enabled = true
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_print.enabled = true
			else
				messagebox("Retrieve Fail", "Can not Generate Purchase Order", exclamation!, ok!, 1)
			end if
		elseif this.id_master.object.purordercatcode[1] = 3 then
			open(w_editsaleorder_finalized_purorder_form)
			lstr_template = message.powerobjectparm
			if lstr_template.c_copyinvfrom = "T" then
				ll_counter = 1
				for ll_counter = this.id_detail.rowcount() to 1 step -1
					this.id_detail.deleterow(ll_counter)
				next
				if lstr_arg.s_name2 = "AND" then
					lds_po.dataobject = "d_dspodetail_saleorder_and"
					lds_po.settransobject(sqlca)
					ll_rows = lds_po.retrieve(lstr_template.l_invtemplate, lstr_arg.ia_integerlist, lstr_arg.ia_integerlist1, lstr_arg.ia_integerlist2, lstr_arg.la_longlist)
				else
					lds_po.dataobject = "d_dspodetail_saleorder"
					lds_po.settransobject(sqlca)
					ll_rows = lds_po.retrieve(lstr_template.l_invtemplate, lstr_arg.ia_integerlist, lstr_arg.ia_integerlist1, lstr_arg.ia_integerlist2, lstr_arg.la_longlist, lstr_arg.s_name1)
				end if
				if ll_rows >= 0 then
					ll_endrow = lds_po.rowcount()
					setpointer(hourglass!)
					ll_insrow = 0
					for ll_counter = 1 to ll_endrow
						lb_insertrow = false
						ld_tmpqty = 0
						ll_code = this.id_master.getitemnumber(this.id_master.getrow(), "code")
						ll_icode = lds_po.object.icode[ll_counter]
						ll_packunits = lds_po.object.packunits[ll_counter]
						ll_minqty = lds_po.object.minqty[ll_counter]
						if ll_packunits = 0 then
							ll_packunits = 1
						end if
						if lstr_template.i_invtype = 0 then
							lb_insertrow = true
						else
							if not isnull(ll_code) then
								SQL SELECT sum ( qty *packunits ) INTO :ld_tmpqty FROM PurOrderDetail WHERE Icode =:ll_icode AND POcode =:ll_code USING sqlca;
								if sqlca.sqlcode <> 0 then
									lb_insertrow = false
								end if
							end if
							if isnull(ld_tmpqty) then
								ld_tmpqty = 0
							end if
							if lds_po.getitemnumber(ll_counter, "looseqty") + lds_po.getitemnumber(ll_counter, "bonusqty") - lds_po.getitemnumber(ll_counter, "purchaseordered") + ld_tmpqty > 0.0 then
								lb_insertrow = true
							end if
						end if
						ld_saleorderrequest = 0
						if lb_insertrow then
							ll_icode = lds_po.object.icode[ll_counter]
							SQL SELECT purdiscperc INTO :ld_purdiscperc FROM ITEM WHERE Icode =:ll_icode USING sqlca;
							if lstr_template.i_invtype = 0 then
								ld_looseqty = lds_po.object.looseqty[ll_counter] + lds_po.object.bonusqty[ll_counter]
								ld_saleorderrequest = ld_looseqty
							else
								ld_looseqty = lds_po.object.looseqty[ll_counter] + lds_po.object.bonusqty[ll_counter] - lds_po.getitemnumber(ll_counter, "purchaseordered") + ld_tmpqty
								ld_saleorderrequest = ld_looseqty
							end if
							if lstr_template.b_userinput = true then
								ld_looseqty = ld_looseqty + ll_minqty
								if ld_looseqty >= lds_po.object.currqty[ll_counter] + lds_po.object.transitstock[ll_counter] then
									ld_looseqty = ld_looseqty - (lds_po.object.currqty[ll_counter] + lds_po.object.transitstock[ll_counter])
								else
									ld_looseqty = 0
								end if
							end if
							if ld_looseqty < 0.0 then
								ld_looseqty = 0
							end if
							ld_packqty = ceiling(ld_looseqty / ll_packunits)
							if ld_packqty > 0.0 then
								if lb_suppitemsonly = true then
									if ll_suppitemrows > 0 then
										ll_found = lds_suppitems.find("icode = " + trim(string(lds_po.getitemnumber(ll_counter, "icode"))), 1, ll_suppitemrows)
										if ll_found > 0 then
											lb_insertrow = true
											ll_insrow = ll_insrow + 1
										else
											lb_insertrow = false
										end if
									else
										lb_insertrow = false
									end if
								else
									this.id_detail.insertrow(0)
									lb_insertrow = true
									ll_insrow = ll_insrow + 1
								end if
							else
								lb_insertrow = false
							end if
							if lb_insertrow = true then
								this.id_detail.object.icode[ll_insrow] = ll_icode
								this.id_detail.object.saleorderrequest[ll_insrow] = ld_saleorderrequest
								this.id_detail.object.packunits[ll_insrow] = ll_packunits
								this.id_detail.object.minqty[ll_insrow] = ll_minqty
								this.id_detail.object.qty[ll_insrow] = long(ld_packqty)
								this.id_detail.object.allowedqty[ll_insrow] = long(ld_packqty)
								this.id_detail.object.rate[ll_insrow] = lds_po.object.rate[ll_counter]
								this.id_detail.object.reorderqty[ll_insrow] = lds_po.object.reorderqty[ll_counter]
								this.id_detail.object.optimumqty[ll_insrow] = lds_po.object.optimumqty[ll_counter]
								this.id_detail.object.stock[ll_insrow] = lds_po.object.currqty[ll_counter]
								this.id_detail.object.transitstock[ll_insrow] = lds_po.object.transitstock[ll_counter]
								this.id_detail.object.itemname[ll_insrow] = lds_po.object.item[ll_counter]
								this.id_detail.object.manufname[ll_insrow] = lds_po.object.manufacturer[ll_counter]
								this.id_detail.object.itemcategory[ll_insrow] = lds_po.object.itemcategory[ll_counter]
								this.id_detail.object.itemclass[ll_insrow] = lds_po.object.itemclass[ll_counter]
								this.id_detail.object.itempacking[ll_insrow] = lds_po.object.itempacking[ll_counter]
								this.id_detail.object.genericitem[ll_insrow] = lds_po.object.genericitem[ll_counter]
								this.id_detail.object.fullcode[ll_insrow] = lds_po.object.aliasname[ll_counter]
								this.id_detail.object.discperc[ll_insrow] = ld_purdiscperc
								this.id_detail.object.purprice[ll_insrow] = lds_po.object.purprice[ll_counter]
								this.id_detail.object.saleprice[ll_insrow] = lds_po.object.saleprice[ll_counter]
								this.id_detail.object.rpp[ll_insrow] = lds_po.object.rpp[ll_counter]
								this.id_detail.object.packavgprice[ll_insrow] = lds_po.object.packavgprice[ll_counter]
								this.id_detail.object.lastpurinvcode[ll_insrow] = lds_po.object.lastpurinvcode[ll_counter]
								this.id_detail.object.lastpurdate[ll_insrow] = lds_po.object.lastpurdate[ll_counter]
								if f_stringpreferences("ItemGSTPercInPO") = "N" then
									this.id_detail.object.gstperc[ll_insrow] = 0
								else
									this.id_detail.object.gstperc[ll_insrow] = lds_po.object.gstperc[ll_counter]
								end if
								if f_stringpreferences("ItemUnitTaxInPO") = "N" then
									this.id_detail.object.packsalestax[ll_insrow] = 0
								else
									this.id_detail.object.packsalestax[ll_insrow] = lds_po.object.packsalestax[ll_counter]
								end if
							end if
						end if
					next
					if ll_insrow > 0 then
						this.id_master.setitem(this.id_master.getrow(), "saleordercode", lstr_template.l_invtemplate)
					end if
					this.id_detail.scrolltorow(0)
					setpointer(arrow!)
					this.im_menu.m_file.m_options.enabled = true
					this.im_menu.m_file.m_save.enabled = true
					this.im_menu.m_file.m_print.enabled = true
				else
					messagebox("Retrieve Fail", "Can not Generate Purchase Order", exclamation!, ok!, 1)
				end if
			end if
		elseif this.id_master.object.purordercatcode[1] = 4 then
			open(w_editpurquot_posted_purorder_form)
			lstr_template = message.powerobjectparm
			if lstr_template.c_copyinvfrom = "T" then
				ll_counter = 1
				for ll_counter = this.id_detail.rowcount() to 1 step -1
					this.id_detail.deleterow(ll_counter)
				next
				if lstr_arg.s_name2 = "AND" then
					lds_po.dataobject = "d_dspodetail_purquot_and"
					lds_po.settransobject(sqlca)
					ll_rows = lds_po.retrieve(lstr_template.l_invtemplate, lstr_arg.ia_integerlist, lstr_arg.ia_integerlist1, lstr_arg.ia_integerlist2, lstr_arg.la_longlist)
				else
					lds_po.dataobject = "d_dspodetail_purquot"
					lds_po.settransobject(sqlca)
					ll_rows = lds_po.retrieve(lstr_template.l_invtemplate, lstr_arg.ia_integerlist, lstr_arg.ia_integerlist1, lstr_arg.ia_integerlist2, lstr_arg.la_longlist, lstr_arg.s_name1)
				end if
				if ll_rows >= 0 then
					ll_endrow = lds_po.rowcount()
					setpointer(hourglass!)
					ll_insrow = 0
					for ll_counter = 1 to ll_endrow
						lb_insertrow = false
						ld_tmpqty = 0
						ll_code = this.id_master.getitemnumber(this.id_master.getrow(), "code")
						ll_icode = lds_po.object.icode[ll_counter]
						ll_packunits = lds_po.object.packunits[ll_counter]
						ll_minqty = lds_po.object.minqty[ll_counter]
						if ll_packunits = 0 then
							ll_packunits = 1
						end if
						if lstr_template.i_invtype = 0 then
							lb_insertrow = true
						else
							if not isnull(ll_code) then
								SQL SELECT sum ( qty ) , sum ( bonusqty ) INTO :ld_tmpqty, :ld_tmpbonus FROM PurOrderDetail WHERE Icode =:ll_icode AND POcode =:ll_code USING sqlca;
								if sqlca.sqlcode <> 0 then
									lb_insertrow = false
								end if
							end if
							if isnull(ld_tmpqty) then
								ld_tmpqty = 0
							end if
							if lds_po.object.qty[ll_counter] - lds_po.object.poqty[ll_counter] + ld_tmpqty > 0 then
								lb_insertrow = true
							elseif lds_po.object.bonusqty[ll_counter] - lds_po.object.pobonus[ll_counter] + ld_tmpbonus > 0 then
								lb_insertrow = true
							end if
						end if
						if lb_insertrow then
							ll_icode = lds_po.object.icode[ll_counter]
							if lstr_template.i_invtype = 0 then
								ld_packqty = lds_po.object.qty[ll_counter]
								ld_bonusqty = lds_po.object.bonusqty[ll_counter]
							else
								if lds_po.object.qty[ll_counter] - lds_po.object.poqty[ll_counter] + ld_tmpqty > 0 then
									ld_packqty = lds_po.object.qty[ll_counter] - lds_po.object.poqty[ll_counter] + ld_tmpqty
								else
									ld_packqty = 0
								end if
								if lds_po.object.bonusqty[ll_counter] - lds_po.object.pobonus[ll_counter] + ld_tmpbonus > 0 then
									ld_bonusqty = lds_po.object.bonusqty[ll_counter] - lds_po.object.pobonus[ll_counter] + ld_tmpbonus
								else
									ld_bonusqty = 0
								end if
							end if
							if lstr_template.b_userinput = true then
								ld_packqty = ld_packqty + ll_minqty
								if ll_packunits > 0 then
									ld_packstock = (lds_po.object.currqty[ll_counter] + lds_po.object.transitstock[ll_counter]) / ll_packunits
								else
									ld_packstock = lds_po.object.currqty[ll_counter] + lds_po.object.transitstock[ll_counter]
								end if
								if ld_packqty >= ld_packstock then
									ld_packqty = ld_packqty - ld_packstock
								else
									ld_packqty = 0
								end if
							end if
							if ld_packqty < 0.0 then
								ld_packqty = 0
							end if
							ld_packqty = ceiling(ld_packqty)
							if ld_packqty > 0.0 then
								if lb_suppitemsonly = true then
									if ll_suppitemrows > 0 then
										ll_found = lds_suppitems.find("icode = " + trim(string(lds_po.getitemnumber(ll_counter, "icode"))), 1, ll_suppitemrows)
										if ll_found > 0 then
											lb_insertrow = true
											ll_insrow = ll_insrow + 1
										else
											lb_insertrow = false
										end if
									else
										lb_insertrow = false
									end if
								else
									this.id_detail.insertrow(0)
									lb_insertrow = true
									ll_insrow = ll_insrow + 1
								end if
							else
								lb_insertrow = false
							end if
							if lb_insertrow = true then
								this.id_detail.object.icode[ll_insrow] = ll_icode
								this.id_detail.object.saleorderrequest[ll_insrow] = 0
								this.id_detail.object.packunits[ll_insrow] = ll_packunits
								this.id_detail.object.minqty[ll_insrow] = ll_minqty
								this.id_detail.object.qty[ll_insrow] = long(ld_packqty)
								this.id_detail.object.allowedqty[ll_insrow] = long(ld_packqty)
								this.id_detail.object.rate[ll_insrow] = lds_po.object.rate[ll_counter]
								this.id_detail.object.reorderqty[ll_insrow] = lds_po.object.reorderqty[ll_counter]
								this.id_detail.object.optimumqty[ll_insrow] = lds_po.object.optimumqty[ll_counter]
								this.id_detail.object.stock[ll_insrow] = lds_po.object.currqty[ll_counter]
								this.id_detail.object.transitstock[ll_insrow] = lds_po.object.transitstock[ll_counter]
								this.id_detail.object.itemname[ll_insrow] = lds_po.object.item[ll_counter]
								this.id_detail.object.manufname[ll_insrow] = lds_po.object.manufacturer[ll_counter]
								this.id_detail.object.itemcategory[ll_insrow] = lds_po.object.itemcategory[ll_counter]
								this.id_detail.object.itemclass[ll_insrow] = lds_po.object.itemclass[ll_counter]
								this.id_detail.object.itempacking[ll_insrow] = lds_po.object.itempacking[ll_counter]
								this.id_detail.object.genericitem[ll_insrow] = lds_po.object.genericitem[ll_counter]
								this.id_detail.object.fullcode[ll_insrow] = lds_po.object.aliasname[ll_counter]
								this.id_detail.object.discperc[ll_insrow] = lds_po.object.discperc[ll_counter]
								this.id_detail.object.purprice[ll_insrow] = lds_po.object.purprice[ll_counter]
								this.id_detail.object.saleprice[ll_insrow] = lds_po.object.saleprice[ll_counter]
								this.id_detail.object.rpp[ll_insrow] = lds_po.object.rpp[ll_counter]
								this.id_detail.object.packavgprice[ll_insrow] = lds_po.object.packavgprice[ll_counter]
								this.id_detail.object.lastpurinvcode[ll_insrow] = lds_po.object.lastpurinvcode[ll_counter]
								this.id_detail.object.lastpurdate[ll_insrow] = lds_po.object.lastpurdate[ll_counter]
								if f_stringpreferences("ItemGSTPercInPO") = "N" then
									this.id_detail.object.gstperc[ll_insrow] = 0
								else
									this.id_detail.object.gstperc[ll_insrow] = lds_po.object.gstperc[ll_counter]
								end if
								if f_stringpreferences("ItemUnitTaxInPO") = "N" then
									this.id_detail.object.packsalestax[ll_insrow] = 0
								else
									this.id_detail.object.packsalestax[ll_insrow] = lds_po.object.packsalestax[ll_counter]
								end if
							end if
						end if
					next
					if ll_insrow > 0 then
						this.id_master.setitem(this.id_master.getrow(), "purquotationcode", lstr_template.l_invtemplate)
					end if
					this.id_detail.scrolltorow(0)
					setpointer(arrow!)
					this.im_menu.m_file.m_options.enabled = true
					this.im_menu.m_file.m_save.enabled = true
					this.im_menu.m_file.m_print.enabled = true
				else
					messagebox("Retrieve Fail", "Can not Generate Purchase Order", exclamation!, ok!, 1)
				end if
			end if
		end if
	end if
	wf_grandtotal()
	destroy lds_po
	destroy lds_suppitems

// w_quotation.wf_import_quotation_from_datacarrydb() returns long
	boolean lb_listtab
	integer li_usercode
	string ls_error
	s_arguements lstr_arg
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab and wf_iseditable() = false then
		open(w_populate_quotation_from_datacarrydb)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = 1 then
			li_usercode = gl_usercode
			this.it_transobject.import_quotation_from_datacarrydb(gs_inlinkserver, gs_inlinkserverdb, gs_inlinkserverowner, lstr_arg.l_code1, lstr_arg.l_code2, 0, li_usercode)
			if this.it_transobject.sqlcode = 0 then
				SQL commit USING this.it_transobject;
			else
				ls_error = this.it_transobject.sqlerrtext
				messagebox("Problem in Import Of Quotations", "Import Of Quotations from Data Carry Failed. Reasons are:-~r~n" + ls_error, stopsign!)
			end if
		end if
	end if
	return 0

// w_quotation.wf_activate_quotation() returns long
	long ll_errcode
	long ll_code
	long ll_format
	long ll_salesmancode
	string lc_value
	string lc_newvalue
	string ls_errtext
	s_arguements lstr_arg
	if wf_iseditable() = false then
		open(w_selectformat_single_range_period)
		ll_format = message.doubleparm
		if ll_format = 1 and this.id_list.getrow() > 0 then
			if this.id_list.object.code[this.id_list.getrow()] > 0 then
				ll_code = this.id_list.object.code[this.id_list.getrow()]
				SQL SELECT Active INTO :lc_value FROM QuotationHeader WHERE QuotationCode =:ll_code USING this.it_transobject;
				if isnull(lc_value) or lc_value = "" then
					lc_value = "N"
				end if
				open(w_salesmanpassword)
				ll_salesmancode = long(message.doubleparm)
				setfocus()
				if ll_salesmancode > 0 then
					setpointer(hourglass!)
					if lc_value = "Y" then
						lc_newvalue = "N"
					else
						lc_newvalue = "Y"
					end if
					SQL rollback USING this.it_transobject;
					SQL update QuotationHeader SET Active =:lc_newvalue WHERE QuotationCode =:ll_code AND Active =:lc_value USING this.it_transobject;
					if this.it_transobject.sqlcode = 0 then
						SQL commit USING this.it_transobject;
						if lc_newvalue = "Y" then
							messagebox("Quotation Activation", "Quotation successfully Activated", information!)
						else
							messagebox("Quotation De-Activation", "Quotation successfully De-Activated", information!)
						end if
						ll_errcode = 0
					else
						ls_errtext = this.it_transobject.sqlerrtext
						SQL rollback USING this.it_transobject;
						ll_errcode = -1
						messagebox("Quotation updation", "Some database request fails, Please try again.~r~nDetails are:-~r~n" + ls_errtext)
					end if
				end if
				setpointer(arrow!)
			else
				ll_errcode = 0
			end if
		elseif ll_format = 2 then
			open(w_select_activate_deactivate)
			lc_newvalue = message.stringparm
			if upper(lc_newvalue) = "Y" then
				lc_value = "N"
			end if
			if upper(lc_newvalue) = "N" then
				lc_value = "Y"
			end if
			open(w_quotation_range_selection)
			lstr_arg = message.powerobjectparm
			if lstr_arg.i_status = 1 then
				SQL rollback USING this.it_transobject;
				this.it_transobject.activate_deactivate_quotation(lstr_arg.s_name1, lc_newvalue, lc_value)
				if this.it_transobject.sqlcode = 0 then
					SQL commit USING this.it_transobject;
					if lc_newvalue = "Y" then
						messagebox("Quotation Activation", "Quotation(s) successfully Activated", information!)
					else
						messagebox("Quotation De-Activation", "Quotation(s) successfully De-Activated", information!)
					end if
					ll_errcode = 0
				else
					ls_errtext = this.it_transobject.sqlerrtext
					SQL rollback USING this.it_transobject;
					ll_errcode = -1
					messagebox("Quotation updation", "Some database request fails, Please try again.~r~nDetails are:-~r~n" + ls_errtext)
				end if
			end if
		elseif ll_format = 3 then
			open(w_select_activate_deactivate)
			lc_newvalue = message.stringparm
			if upper(lc_newvalue) = "Y" then
				lc_value = "N"
			end if
			if upper(lc_newvalue) = "N" then
				lc_value = "Y"
			end if
			open(w_quotation_cust_sdate_ldate)
			lstr_arg = message.powerobjectparm
			if lstr_arg.i_status = 1 then
				SQL rollback USING this.it_transobject;
				this.it_transobject.activate_deactivate_quotation(lstr_arg.s_name1, lc_newvalue, lc_value)
				if this.it_transobject.sqlcode = 0 then
					SQL commit USING this.it_transobject;
					if lc_newvalue = "Y" then
						messagebox("Quotation Activation", "Quotation(s) successfully Activated", information!)
					else
						messagebox("Quotation De-Activation", "Quotation(s) successfully De-Activated", information!)
					end if
					ll_errcode = 0
				else
					ls_errtext = this.it_transobject.sqlerrtext
					SQL rollback USING this.it_transobject;
					ll_errcode = -1
					messagebox("Quotation updation", "Some database request fails, Please try again.~r~nDetails are:-~r~n" + ls_errtext)
				end if
			end if
		end if
	else
		ll_errcode = 0
	end if
	return ll_errcode

// w_quotation.wf_lock_quotation() returns long
	long ll_errcode
	long ll_code
	long ll_salesmancode
	string ls_value
	string ls_newvalue
	string ls_errtext
	if this.id_list.getrow() > 0 and wf_iseditable() = false then
		if this.id_list.object.code[this.id_list.getrow()] > 0 then
			ll_code = this.id_list.object.code[this.id_list.getrow()]
			SQL SELECT Locked INTO :ls_value FROM QuotationHeader WHERE QuotationCode =:ll_code USING this.it_transobject;
			if isnull(ls_value) or ls_value = "" then
				ls_value = "N"
			end if
			open(w_salesmanpassword)
			ll_salesmancode = long(message.doubleparm)
			setfocus()
			if ll_salesmancode > 0 then
				setpointer(hourglass!)
				if ls_value = "Y" then
					ls_newvalue = "N"
				else
					ls_newvalue = "Y"
				end if
				SQL rollback USING this.it_transobject;
				SQL update QuotationHeader SET Locked =:ls_newvalue WHERE QuotationCode =:ll_code AND Locked =:ls_value USING this.it_transobject;
				if this.it_transobject.sqlcode = 0 then
					SQL commit USING this.it_transobject;
					if ls_newvalue = "Y" then
						messagebox("Quotation", "Quotation successfully Locked", information!)
					else
						messagebox("Quotation", "Quotation successfully Un-Locked", information!)
					end if
					ll_errcode = 0
				else
					ls_errtext = this.it_transobject.sqlerrtext
					SQL rollback USING this.it_transobject;
					ll_errcode = -1
					messagebox("Quotation", "Some database request fails, Please try again.~r~nDetails are:-~r~n" + ls_errtext)
				end if
			end if
			setpointer(arrow!)
		else
			ll_errcode = 0
		end if
	else
		ll_errcode = 0
	end if
	return ll_errcode

// w_quotation.wf_autoupdate_newitems() returns long
	long ll_errcode
	long ll_code
	long ll_salesmancode
	string ls_value
	string ls_newvalue
	string ls_errtext
	if this.id_list.getrow() > 0 and wf_iseditable() = false then
		if this.id_list.object.code[this.id_list.getrow()] > 0 then
			ll_code = this.id_list.object.code[this.id_list.getrow()]
			SQL SELECT AutoInsertNewItems INTO :ls_value FROM QuotationHeader WHERE QuotationCode =:ll_code USING this.it_transobject;
			if isnull(ls_value) or ls_value = "" then
				ls_value = "N"
			end if
			open(w_salesmanpassword)
			ll_salesmancode = long(message.doubleparm)
			setfocus()
			if ll_salesmancode > 0 then
				setpointer(hourglass!)
				if ls_value = "Y" then
					ls_newvalue = "N"
				else
					ls_newvalue = "Y"
				end if
				SQL rollback USING this.it_transobject;
				SQL update QuotationHeader SET AutoInsertNewItems =:ls_newvalue WHERE QuotationCode =:ll_code AND AutoInsertNewItems =:ls_value USING this.it_transobject;
				if this.it_transobject.sqlcode = 0 then
					SQL commit USING this.it_transobject;
					if ls_newvalue = "Y" then
						messagebox("Quotation", "Quotation successfully updated for Auto Insert New Items", information!)
					else
						messagebox("Quotation", "Quotation successfully updated for Auto Not Insert New Items", information!)
					end if
					ll_errcode = 0
				else
					ls_errtext = this.it_transobject.sqlerrtext
					SQL rollback USING this.it_transobject;
					ll_errcode = -1
					messagebox("Quotation updation", "Some database request fails, Please try again.~r~nDetails are:-~r~n" + ls_errtext)
				end if
			end if
			setpointer(arrow!)
		else
			ll_errcode = 0
		end if
	else
		ll_errcode = 0
	end if
	return ll_errcode

// w_quotation.wf_inheritquotation() returns long
	long ll_errcode
	long ll_code
	long ll_newquotationcode
	long ll_salesmancode
	integer li_custcode
	string ls_errtext
	string ls_remarks
	s_arguements lst_arg
	if wf_iseditable() = false then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
		if ll_salesmancode > 0 then
			open(w_arg_quotation_customer_remarks)
			lst_arg = message.powerobjectparm
			if lst_arg.i_status = 1 and lst_arg.l_code1 > 0 and lst_arg.l_code2 > 0 then
				ll_code = lst_arg.l_code1
				li_custcode = lst_arg.l_code2
				ls_remarks = lst_arg.s_name1
				SQL rollback USING this.it_transobject;
				if this.it_transobject.sqlcode = 0 then
					this.it_transobject.inheritquotation(ll_code, li_custcode, ls_remarks, ll_salesmancode, ll_newquotationcode)
					SQL commit USING this.it_transobject;
					messagebox("Inherit Quotation", "Quotation successfully Inherited.~r~nNew Quotation Code = " + string(ll_newquotationcode), information!)
					return 0
				else
					ls_errtext = this.it_transobject.sqlerrtext
					SQL rollback USING this.it_transobject;
					ll_errcode = -1
					messagebox("Inherit Quotation", "Inherit Quotation failed, Please try again.~r~nDetails are:-~r~n" + ls_errtext)
				end if
			end if
		end if
	end if
	return 0

// w_quotation.wf_itemquotationhistory() returns 0
	s_itemsalehistory ls_itemsalehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itemsalehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itemsalehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itemquotationhistory, ls_itemsalehistory)
	end if

// w_quotation.wf_new_customerregisteration() returns integer
	string ls_aliasname
	long ll_acccode
	long ll_found
	long ll_row
	dwobject dwo
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 694", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		open(w_customer_register)
		ls_aliasname = message.stringparm
		if not (ls_aliasname = "" or isnull(ls_aliasname)) then
			wf_customer_retrieve()
			ll_found = 0
			ll_found = this.idc_customers.find("accounts_aliasname = '" + ls_aliasname + "'", 1, this.idc_customers.rowcount())
			if ll_found > 0 then
				this.id_master.setitem(1, "custcode", this.idc_customers.getitemstring(ll_found, "accounts_aliasname"))
				ll_acccode = this.idc_customers.getitemnumber(ll_found, "accounts_acccode")
				this.id_master.setitem(1, "custcode", ll_acccode)
				dwo = this.id_master.object.custcode
				this.id_master.post event itemchanged(1, dwo, string(ll_acccode))
			end if
		end if
	end if
	return 0

// w_quotation.wf_customer_retrieve() returns long
	this.idc_customers.setredraw(false)
	this.idc_customers.settransobject(this.it_transobject)
	this.idc_customers.retrieve()
	this.idc_customers.setredraw(true)
	return 0

// w_quotation.wf_validate_price_discount_matters(integer ai_mode, long al_usercode, datawindow adw_local) returns integer
	long ll_counter
	long ll_counter2
	long ll_icode
	long ll_custcode
	long ll_allowsalebelowavgprice
	long ll_masterrow
	string ls_itemgrouperror
	double ld_invdiscperc
	double ld_flatdisc
	double ld_saleprice
	double ld_rate
	double ld_rpp
	double ld_discperc
	double ld_itemflatdisc
	double ld_unitsalestax
	double ld_itemgstperc
	double ld_invdisc
	double ld_invgstperc
	double ld_avgprice
	double ld_itemamount
	double ld_amountdiff
	double ld_clonesaleprice
	double ld_itemsalediscperc
	double ld_maxitemsalediscperc
	double ld_grossamt_rate_qty
	double ld_totaldiscount
	double ld_accumulateddiscperc
	double ld_qty
	double ld_actual_accumdiscperc
	double ld_accumdiscperccaution
	double ld_discgiven
	double ld_groupsaleitemdiscperc
	double ld_cloneflatdisc
	double ld_clonediscperc
	double ld_tempflatdisc
	double ld_tempdiscperc
	boolean lb_validdisc
	datastore lds_groupdiscinfo
	wf_grandtotal()
	lds_groupdiscinfo = create datastore
	lds_groupdiscinfo.dataobject = "d_groups_discount"
	lds_groupdiscinfo.settransobject(this.it_transobject)
	lds_groupdiscinfo.retrieve(al_usercode)
	ld_invdiscperc = this.id_footer.getitemnumber(1, "invdiscperc")
	ld_flatdisc = this.id_footer.getitemnumber(1, "flatdisc")
	lb_validdisc = false
	ll_masterrow = this.id_master.rowcount()
	for ll_counter = 1 to lds_groupdiscinfo.rowcount()
		ld_accumulateddiscperc = lds_groupdiscinfo.object.accumulateddiscperc[ll_counter]
		ld_accumdiscperccaution = lds_groupdiscinfo.object.accumdiscperccaution[ll_counter]
		ld_groupsaleitemdiscperc = lds_groupdiscinfo.object.saleitemdiscperc[ll_counter]
		if ld_flatdisc <= lds_groupdiscinfo.object.saleinvflatdisc[ll_counter] then
			lb_validdisc = true
		end if
	next
	if lb_validdisc = false then
		messagebox("Flat Discount Validation", "Flat Discount is greater than your permission~r~n Please consult Administrator")
		this.id_footer.setfocus()
		this.id_footer.setcolumn("flatdisc")
		destroy lds_groupdiscinfo
		return -1
	end if
	ld_grossamt_rate_qty = 0
	ld_totaldiscount = 0
	ll_counter = 0
	for ll_counter = 1 to adw_local.rowcount()
		ll_icode = adw_local.getitemnumber(ll_counter, "icode")
		ld_qty = adw_local.getitemnumber(ll_counter, "looseqty")
		ld_saleprice = adw_local.getitemnumber(ll_counter, "saleprice")
		ld_rpp = adw_local.getitemnumber(ll_counter, "rpp")
		ld_discperc = adw_local.getitemnumber(ll_counter, "discperc")
		ld_itemflatdisc = adw_local.getitemnumber(ll_counter, "itemflatdisc")
		ld_avgprice = adw_local.getitemnumber(ll_counter, "avgprice")
		ld_itemamount = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2) - round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2) * ld_invdiscperc * 0.01
		ld_amountdiff = ld_saleprice - ld_itemamount
		ld_clonesaleprice = ld_saleprice
		if ld_clonesaleprice = 0.0 or isnull(ld_clonesaleprice) then
			ld_clonesaleprice = 1
		end if
		if f_stringpreferences("AllowSaleBelowRPP") = "N" and round(ld_rpp, 2) > round(ld_itemamount, 2) then
			messagebox("Price Validation", "Sale Price become less than RPP" + "~r~nNet Sale Price = " + string(round(ld_itemamount, 2), "###,###,##0.00") + "~r~nRPP = " + string(round(ld_rpp, 2), "###,###,##0.00") + "~r~nPlease Change Sale Price or Setting In Preferences", stopsign!)
			this.id_detail.setfocus()
			this.id_detail.setrow(ll_counter)
			this.id_detail.setcolumn("itemname")
			this.id_detail.scrolltorow(ll_counter)
			destroy lds_groupdiscinfo
			return -1
		end if
		if f_stringpreferences("saleavgpricecheck") = "N" and ll_allowsalebelowavgprice = 0 and round(ld_avgprice, 2) > round(ld_itemamount, 2) then
			messagebox("Price Validation", ls_itemgrouperror + "~r~nSale Price become Less Than Avg. Price" + "~r~nNet Sale Price = " + string(round(ld_itemamount, 2), "###,###,##0.00") + "~r~nAvg. Price = " + string(round(ld_avgprice, 2), "###,###,##0.00") + "~r~nPlease Change Sale Price or Setting In Preferences", stopsign!)
			this.id_detail.setfocus()
			this.id_detail.setrow(ll_counter)
			this.id_detail.setcolumn("itemname")
			this.id_detail.scrolltorow(ll_counter)
			destroy lds_groupdiscinfo
			return -1
		end if
		if f_stringpreferences("AllowSalePriceGreaterThanAvgPrice") = "N" and ll_allowsalebelowavgprice = 0 and round(ld_itemamount, 2) > round(ld_avgprice, 2) then
			messagebox("Price Validation", "Sale Price become Greater Than Avg. Price" + "~r~nNet Sale Price = " + string(round(ld_itemamount, 2), "###,###,##0.00") + "~r~nAvg. Price = " + string(round(ld_avgprice, 2), "###,###,##0.00") + "~r~nPlease Change Sale Price or Setting In Preferences", stopsign!)
			this.id_detail.setfocus()
			this.id_detail.setrow(ll_counter)
			this.id_detail.setcolumn("itemname")
			this.id_detail.scrolltorow(ll_counter)
			destroy lds_groupdiscinfo
			return -1
		end if
		lb_validdisc = false
		ll_counter2 = 0
		for ll_counter2 = 1 to lds_groupdiscinfo.rowcount()
			ld_groupsaleitemdiscperc = lds_groupdiscinfo.object.saleitemdiscperc[ll_counter2]
			ld_tempflatdisc = ld_cloneflatdisc
			ld_tempdiscperc = ld_clonediscperc
			if ld_discperc > ld_clonediscperc then
				ld_tempdiscperc = ld_discperc
			end if
			if ld_itemflatdisc > ld_cloneflatdisc then
				ld_tempflatdisc = ld_itemflatdisc
			end if
			if round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2) <= ld_groupsaleitemdiscperc then
				lb_validdisc = true
			elseif round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2) <= ld_itemsalediscperc then
				lb_validdisc = true
			else
				lb_validdisc = false
			end if
		next
		if lb_validdisc = false then
			ld_discgiven = round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2)
			if isnull(ld_discgiven) then
				ld_discgiven = 0.00
			end if
			messagebox("Discount Validation ..", "Given Discount = " + trim(string(ld_discgiven, "###,##0.00")) + "%~r~n" + "Group Permission = " + trim(string(ld_groupsaleitemdiscperc, "###,##0.00")) + "%~r~n" + "Item Basic Data = " + trim(string(ld_itemsalediscperc, "###,##0.00")) + "%~r~n~r~n" + "So Given Discount Percentage is greater than your group permission and~r~n" + "Item Basicdata setting for Sale Discount~r~n~r~n" + "Please consult Administrator", stopsign!)
			this.id_detail.setfocus()
			this.id_detail.setrow(ll_counter)
			this.id_detail.setcolumn("itemname")
			destroy lds_groupdiscinfo
			return -1
		end if
	next
	destroy lds_groupdiscinfo
	return 0

// w_quotation.create() returns 0
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_quotationmenu" then
		this.menuid = create m_quotationmenu
	end if
	this.dw_saleinvdetail = create dw_saleinvdetail
	this.dw_saleinvrep = create dw_saleinvrep
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvdetail
	this.control[icurrent + 2] = this.dw_saleinvrep

// w_quotation.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvdetail
	destroy this.dw_saleinvrep

// w_quotation.ue_save() returns 0
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode
	long ll_gcode
	long ll_headerno
	long ll_headerinvno
	long ll_counter
	long ll_count
	long ll_found
	boolean lb_commitflag
	boolean lb_continue
	integer li_counter
	string ls_errtext
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_invgstperc1
	datetime ldt_server_datetime
	string ls_date_errtext
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if this.id_detail.rowcount() < 1 then
		messagebox("Row Validation", "Please insert at least one item~r~nbefore proceeding")
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	ll_found = this.id_detail.find("looseqty + bonusqty <= 0 ", 1, this.id_detail.rowcount())
	if ll_found > 0 then
		messagebox("Sale Qty Validation", "Please Enter Valid Sale Qty in Row " + string(ll_found))
		this.id_detail.setfocus()
		this.id_detail.scrolltorow(ll_found)
		this.id_detail.setcolumn("looseqty")
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if f_stringpreferences("Salesalesmanwindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if wf_validate_price_discount_matters(0, ll_salesmancode, this.id_detail) < 0 then
			return
		end if
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if isnull(ll_invid) then
			f_newtableid("quotation", ll_invid)
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
		end if
		ld_misccharges = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges")
		ld_invdiscperc = this.id_footer.getitemnumber(ll_footercurrrow, "invdiscperc")
		ld_flatdisc = this.id_footer.getitemnumber(ll_footercurrrow, "flatdisc")
		ld_salestax = this.id_footer.getitemnumber(ll_footercurrrow, "salestax")
		ld_invgstperc1 = this.id_footer.getitemnumber(ll_footercurrrow, "invGSTPerc1")
		this.id_master.setitem(ll_mastercurrrow, "discperc", ld_invdiscperc)
		this.id_master.setitem(ll_mastercurrrow, "flatdisc", ld_flatdisc)
		this.id_master.setitem(ll_mastercurrrow, "misccharges", ld_misccharges)
		this.id_master.setitem(ll_mastercurrrow, "salestax", ld_salestax)
		this.id_master.setitem(ll_mastercurrrow, "invGSTPerc1", ld_invgstperc1)
		if this.ib_modify then
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		else
			this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "PostDate", ldt_server_datetime)
		end if
		if lb_continue then
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.setitem(ll_counter, "code", ll_invid)
			next
			call super::ue_save
			this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
			this.id_saleinvdetail.reset()
			if this.ib_commitok then
				this.ib_modify = false
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			messagebox("Updation Error", ls_errtext + " in current row", stopsign!)
		elseif f_stringpreferences("IncQuotInActMonitor") = "Y" then
			this.it_transobject.updateactivitymonitor("QU", ll_invid)
			if this.it_transobject.sqlcode <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
			else
				SQL commit USING this.it_transobject;
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_quotation.ue_newform() returns 0
	integer rtncode
	long li_fetched_code
	long row
	long ll_manfcode
	call super::ue_newform
	setredraw(false)
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.im_menu.m_file.m_print.enabled = true
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.im_menu.m_file.m_post.enabled = false
	this.id_master.setitem(1, "Remarks2", f_stringpreferences("Quotationterms1"))
	this.id_master.setitem(1, "Remarks3", f_stringpreferences("Quotationterms2"))
	this.id_master.setitem(1, "Remarks4", f_stringpreferences("Quotationterms3"))
	this.id_master.setitem(1, "Remarks5", f_stringpreferences("Quotationterms4"))
	this.id_master.setitem(1, "Remarks6", f_stringpreferences("Quotationterms5"))
	this.id_master.setitem(1, "Remarks7", f_stringpreferences("Quotationterms6"))
	this.id_master.setitem(1, "Remarks8", f_stringpreferences("Quotationterms7"))
	this.id_master.setitem(1, "Remarks9", f_stringpreferences("Quotationterms8"))
	this.ib_modify = false
	wf_setgodownoption()
	if f_stringpreferences("updatesaleprice") = "N" then
		this.id_detail.object.saleprice.protect = 1
	end if
	this.id_footer.setitem(1, "invdiscperc", f_numberpreferences("invdiscperc"))
	if not wf_validatedate() then
		close(this)
	else
		this.id_master.setcolumn(1)
		this.id_master.setfocus()
		wf_visible(true)
		setredraw(true)
	end if
	this.id_master.object.custcode[1] = 19
	wf_customerinfo(19)

// w_quotation.ue_detail() returns 0
	integer li_rtncode
	integer li_protect
	long ll_row
	long ll_code
	boolean lb_flag
	boolean lb_modify
	string ls_locked
	call super::ue_detail
	this.im_menu.m_file.m_print.enabled = true
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	if wf_allowquotationmodification(ll_code, this.il_groupcode, this.il_strategy) <> 0 then
		this.id_detail.reset()
		messagebox("quotation Modification Validation", "You Can not modify this quotation,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "Y" then
		this.im_menu.m_file.m_save.enabled = false
		this.editflag = false
	elseif this.ib_quotationmodify = false then
		lb_modify = false
	else
		lb_modify = true
	end if
	if not lb_modify then
		this.im_menu.m_file.m_save.enabled = false
		this.editflag = false
		li_protect = 1
	else
		ls_locked = this.id_master.getitemstring(this.id_master.getrow(), "Locked")
		if ls_locked = "Y" and this.is_modifylockedquotation = "Y" then
			this.editflag = true
			li_protect = 0
		elseif ls_locked = "Y" and this.is_modifylockedquotation = "N" then
			this.editflag = false
			li_protect = 1
		else
			li_protect = 0
		end if
		if li_protect = 0 then
			this.im_menu.m_file.m_save.enabled = true
		else
			this.im_menu.m_file.m_save.enabled = false
		end if
		wf_initmodify(li_protect)
	end if
	ll_code = this.id_master.getitemnumber(1, "code")
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	wf_setgodownoption()
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	wf_grandtotal()
	setredraw(true)

// w_quotation.ue_newitem() returns 0
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true
	this.ii_defaultgcode = f_numberpreferences("Defaultgcode")

// w_quotation.ue_deleteitem() returns 0
	long ll_row
	long ll_footerrow
	call super::ue_deleteitem
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() > 0 then
		this.id_footer.setitem(ll_footerrow, "icode", this.id_detail.getitemnumber(ll_row, "icode"))
		this.id_footer.setitem(ll_footerrow, "stock", this.id_detail.getitemnumber(ll_row, "stock"))
		return
	end if
	this.id_footer.setitem(ll_footerrow, "icode", 0)
	this.id_footer.setitem(ll_footerrow, "stock", 0)
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_save.enabled = false

// w_quotation.close() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	return ::message.returnvalue

// w_quotation.ue_list() returns 0
	long ll_row
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_post.enabled = true
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	ll_row = wf_retrievelist()
	wf_disabledetailtab(ll_row)
	post event ue_enableprint()

// w_quotation.ue_print() returns 0
	long ll_custcode
	long ll_row
	long ll_invcode
	string ls_custname
	integer li_option
	boolean lb_listtab
	s_datastore lstr
	string ls_pagesize
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	SQL SELECT pagesize INTO :ls_pagesize FROM QuotationHeader WHERE quotationcode =:ll_invcode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Print Size Selection", "Unable to Select Page Size")
		return
	end if
	wf_selectprintreport(ls_pagesize)
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Quotation", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Quotation,~r~nNo rows are retrieved", information!)

// w_quotation.ue_refreshddw() returns 0
	call super::ue_refreshddw
	if this.ii_saletype <> 3 then
		setpointer(hourglass!)
		this.idc_customers.setredraw(false)
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.retrieve()
		this.idc_customers.setredraw(true)
		setpointer(arrow!)
	end if

// w_quotation.ue_new() returns 0
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_quotation.ue_postopen() returns 0
	datawindowchild ldc_headerno
	m_quotationmenu lm_menu
	integer li_rtncode
	long ll_counter
	long ll_pos
	long ll_found
	datastore lds_headers
	call super::ue_postopen
	f_fetch_sites()
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	this.ids_invoiceinfo = create datastore
	this.ids_invoiceinfo.dataobject = "d_saleinvinfo"
	this.ids_invoiceinfo.settransobject(this.it_transobject)
	lm_menu = this.menuid
	lm_menu.dynamic mf_initsecurityapp(lm_menu)
	setredraw(false)
	wf_setsaletype(integer(message.doubleparm))
	this.id_print = this.dw_saleinvrep
	this.id_saleinvdetail = this.dw_saleinvdetail
	this.id_saleinvdetail.settransobject(this.it_transobject)
	choose case this.ii_saletype
	case 3
		wf_assigndatawindowobjects("d_QuotationHeader", "d_QuotationDetail", "d_quotationFooter", "d_quotationlist", "d_quotationinvreport")
		this.it_transobject.getglobalcode("GT_RetailSaleCustomerACC", this.il_code)
	end choose
	li_rtncode = this.id_master.getchild("custcode", this.idc_customers)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_customers.settransobject(this.it_transobject)
	if f_stringpreferences("Itemflatdisc") = "N" then
		this.id_detail.object.itemflatdisc.visible = false
	end if
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit to Make Quotation")
		close(this)
		return
	end if
	li_rtncode = this.id_detail.getchild("gcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to sale")
		close(this)
		return
	end if
	this.ii_salegodown = this.idc_godown.getitemnumber(1, "gcode")
	this.id_detail.object.gcode.initial = string(this.ii_salegodown)
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Quotation")
		close(this)
		return
	end if
	if f_stringpreferences("ShowHeaderInQuotation") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.t_headerno.visible = false
	end if
	if f_stringpreferences("ShowDeliveryDaysInQuotation") = "N" then
		this.id_master.object.deliverydays.visible = false
		this.id_master.object.deliverydays_t.visible = false
	end if
	if f_stringpreferences("ShowValidityDaysInQuotation") = "N" then
		this.id_master.object.validitydays.visible = false
		this.id_master.object.validitydays_t.visible = false
	end if
	if f_stringpreferences("ShowPaymentToInQuotation") = "N" then
		this.id_master.object.paymentto.visible = false
		this.id_master.object.paymentto_t.visible = false
	end if
	if f_stringpreferences("showclaimablediscpercinquot") = "N" then
		this.id_detail.object.claimablediscperc.visible = false
	end if
	if f_stringpreferences("showporateinquot") = "N" then
		this.id_detail.object.porate.visible = false
	end if
	if f_stringpreferences("showpodiscpercinquot") = "N" then
		this.id_detail.object.podiscperc.visible = false
	end if
	if f_stringpreferences("showspecialrateinquot") = "N" then
		this.id_detail.object.specialrate.visible = false
	end if
	if f_stringpreferences("ShowColorInQuotation") = "N" then
		this.id_detail.object.color.visible = false
	end if
	this.id_master.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to lds_headers.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
		ldc_headerno.setitem(ll_counter, "name", "")
		ll_found = 0
		ll_found = gds_reoprtheaderinfo.find("headerno=" + string(lds_headers.getitemnumber(ll_counter, "headercode")), 1, gds_reoprtheaderinfo.rowcount())
		if ll_found > 0 then
			if isnull(gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks")) then
				ldc_headerno.setitem(ll_counter, "headeralias", trim(string(gds_reoprtheaderinfo.getitemnumber(ll_found, "headerno"))))
			else
				ldc_headerno.setitem(ll_counter, "headeralias", trim(gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks")) + " (" + trim(string(gds_reoprtheaderinfo.getitemnumber(ll_found, "headerno"))) + ")")
			end if
		end if
	next
	this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
	this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = true
	this.id_itemslist.object.sstock.visible = true
	this.id_itemslist.object.t_pstock.visible = false
	this.id_itemslist.object.pstock.visible = false
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.sstock.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 602", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_quotationmodify = true
	else
		this.ib_quotationmodify = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	if f_stringpreferences("itemunittax") = "N" then
		this.id_detail.object.unitsalestax.visible = false
		this.id_detail.object.taxperunit_t.visible = false
		this.id_detail.object.c_sumtaxval.visible = false
		this.id_detail.object.c_taxval.visible = false
		this.id_detail.object.taxval_t.visible = false
	end if
	if f_stringpreferences("itemgstperc") = "N" then
		this.id_detail.object.gstperc.visible = false
		this.id_detail.object.gstperc_t.visible = false
		this.id_detail.object.c_sumgstval.visible = false
		this.id_detail.object.c_gstval.visible = false
		this.id_detail.object.gstval_t.visible = false
	end if
	if f_stringpreferences("invgstperc") = "N" then
		this.id_footer.object.invgstperc1.visible = false
		this.id_footer.object.invgstperc1_t.visible = false
	end if
	if f_stringpreferences("bonusinsale") = "N" then
		this.id_detail.object.bonusqty.visible = false
		this.id_footer.object.t_bonus.visible = false
		this.id_footer.object.bonusratio.visible = false
	end if
	if f_stringpreferences("messageinsale") = "N" then
		this.id_master.object.messagecode.visible = false
		this.id_master.object.messagecode_t.visible = false
	end if
	if f_stringpreferences("salesmaninsale") = "N" then
		this.id_master.object.smancode.visible = false
		this.id_master.object.smancode_t.visible = false
	end if
	if f_stringpreferences("ShowRemoteSaleInQuot") = "N" then
		this.id_detail.object.remotenetsaleqty.visible = false
	end if
	if f_stringpreferences("ShowRemoteStockInQuot") = "N" then
		this.id_detail.object.remotestock.visible = false
	end if
	if f_stringpreferences("ShowManufactInQuot") = "N" then
		this.id_detail.object.manufacturer.visible = false
	end if
	if f_stringpreferences("showrefnoinquot") = "N" then
		this.id_detail.object.refno.visible = false
	end if
	if left(gs_company, 12) = "MASOODHOMOEO" then
		this.id_master.object.custrefno_t.text = "Order No.:"
		this.id_master.object.remarks_t.text = "Through:"
		this.id_master.object.messagecode_t.text = "D/Terms:"
	end if
	this.id_master.object.pagesize.initial = f_stringpreferences("pagesize")
	gd_itemsinfo.sharedata(this.id_itemslist)
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	f_setcolumnstyle(this.id_detail, "Qty")
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 604", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_editpurchaseorder.visible = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 733", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_editsaleorder.visible = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 609", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_populatepurorderfromdatacarrydb.visible = true
	end if
	if f_rightexists(5176) then
		lm_menu.m_file.m_importquotationsfromdatacarrydb.visible = true
		lm_menu.m_file.m_importquotationsfromdatacarrydb.enabled = true
	end if
	if f_rightexists(5194) then
		lm_menu.m_file.m_activatede-activatequotation.visible = true
		lm_menu.m_file.m_activatede-activatequotation.enabled = true
	end if
	if f_rightexists(5195) then
		lm_menu.m_file.m_lockquotation.visible = true
		lm_menu.m_file.m_lockquotation.enabled = true
	end if
	if f_rightexists(5196) then
		this.is_modifylockedquotation = "Y"
	end if
	if f_rightexists(5197) then
		lm_menu.m_file.m_autoupdatenewitems.visible = true
		lm_menu.m_file.m_autoupdatenewitems.enabled = true
	end if
	if f_rightexists(5198) then
		lm_menu.m_file.m_inheritquotationasnewquotation.visible = true
		lm_menu.m_file.m_inheritquotationasnewquotation.enabled = true
	end if
	if not f_rightexists(5275) then
		lm_menu.m_file.m_pullpofromdropbox.enabled = false
		lm_menu.m_file.m_pullpofromdropbox.visible = false
	end if
	this.id_master.object.loosepack.initial = string(f_numberpreferences("DefaultQtyInQuot"))
	setredraw(true)

// w_quotation.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	return ::message.returnvalue

// w_quotation.ue_deleteitem_row(long al_row) returns 0
	long ll_row
	long ll_footerrow
	super::ue_deleteitem_row(al_row)
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() > 0 then
		this.id_footer.setitem(ll_footerrow, "icode", this.id_detail.getitemnumber(ll_row, "icode"))
		this.id_footer.setitem(ll_footerrow, "stock", this.id_detail.getitemnumber(ll_row, "stock"))
		return
	end if
	this.id_footer.setitem(ll_footerrow, "icode", 0)
	this.id_footer.setitem(ll_footerrow, "stock", 0)
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_save.enabled = false
