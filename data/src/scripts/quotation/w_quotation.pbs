// window w_quotation (quotation)  ancestor: w_multi_entry

// w_quotation.ue_printdo() returns 0
	long ll_custcode
	long ll_row
	string ls_custname
	if this.im_menu.m_file.m_save.enabled = true then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	this.id_print.dataobject = "d_deliveryorder_half"
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(this.id_master.getitemnumber(1, "code"))
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_quotation.ue_enableprint() returns 0
	this.im_menu.m_file.m_print.enabled = true

// w_quotation.ue_populate_po_from_datacarrydb() returns long
	datastore lds_podetail
	long ll_detailrows
	long ll_count
	long ll_row
	long ll_master_row
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_lockedcount
	long ll_retrievecount
	integer li_result
	integer li_rtncode
	boolean populateflag
	string ls_connsetting
	string ls_podetailquery
	string ls_newsyntax
	string ls_error_syntax
	string ls_errortxt
	long ll_pocode
	s_arguements lstr_arg
	u_transaction lt_transobject
	ll_master_row = this.id_master.rowcount()
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.object.posted[ll_master_row] = "Y" then
		messagebox("Population Problem!", "Can not pouplate after posting!")
		return 0
	end if
	if isnull(this.id_master.object.custcode[ll_master_row]) or this.id_master.object.custcode[ll_master_row] = 0 then
		messagebox("Population Problem!", "Please Select some Customer First!")
		this.id_master.setcolumn("custcode")
		this.id_master.setfocus()
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 and not isnull(this.id_detail.object.icode[1]) then
		li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
		if li_result = 1 then
			for ll_count = 1 to ll_detailrows
				this.id_detail.deleterow(0)
			next
			this.id_detail.reset()
		else
			populateflag = false
		end if
	end if
	if populateflag = true then
		open(w_populate_po_from_datacarrydb)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = -1 then
			populateflag = false
		else
			populateflag = true
		end if
	end if
	if populateflag = true then
		lt_transobject = create u_transaction
		SQL start USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Connection Problem", "Unable to connect to database.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
			return -1
		end if
		SQL EXECUTE IMMEDIATE :ls_connsetting USING lt_transobject;
		ll_pocode = lstr_arg.l_code1
		lds_podetail = create datastore
		ls_podetailquery = "Select POCode, ICode, Batch, Expiry, Qty, Rate, DiscPerc, PORowId, BonusQty, Stock, ReorderQty, OptimumQty, MinQty, PackUnits, SoldQty, ReturnQty, QtySatisfied, BonusQtySatisfied, SaleOrderRequest, TransitStock, Remarks, ItemFlatDisc, PackSalesTax, GSTPerc, PurPrice, SalePrice, RPP, PackAvgPrice " + "From ~t" + gs_inlinkserver + "." + gs_inlinkserverdb + "." + gs_inlinkserverowner + "." + "PurOrderDetail " + "Where ~tpocode = " + string(ll_pocode) + "  " + "order by porowid"
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_podetailquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For Purchase Order Header DataStore")
			this.id_detail.setredraw(true)
			return -1
		else
			ls_error_syntax = ""
			lds_podetail.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For Purchase Order Header DataStore")
				this.id_detail.setredraw(true)
				return -1
			end if
		end if
		lds_podetail.settransobject(lt_transobject)
		if lds_podetail.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source SaleLedger.")
			this.id_detail.setredraw(true)
			return -1
		end if
		this.id_detail.reset()
		ll_rowcount = lds_podetail.rowcount()
		this.id_master.object.sprice[ll_master_row] = 4
		this.id_master.object.loosepack[ll_master_row] = 2
		for ll_count = 1 to ll_rowcount
			ll_icode = lds_podetail.object.icode[ll_count]
			ll_row = this.id_detail.insertrow(0)
			if wf_inititeminfo(ll_icode, ll_row, li_rtncode, ls_errortxt) = true then
				this.id_detail.object.looseqty[ll_row] = lds_podetail.object.qty[ll_count]
				this.id_detail.object.bonusqty[ll_row] = lds_podetail.object.bonusqty[ll_count]
				this.id_detail.object.remotenetsaleqty[ll_row] = lds_podetail.object.soldqty[ll_count] - lds_podetail.object.returnqty[ll_count]
				this.id_detail.object.remotestock[ll_row] = lds_podetail.object.stock[ll_count]
				if lstr_arg.l_code2 = 1 then
					this.id_detail.object.saleprice[ll_row] = lds_podetail.object.rate[ll_count]
				end if
				if lstr_arg.l_code3 = 1 then
					this.id_detail.object.discperc[ll_row] = lds_podetail.object.discperc[ll_count]
				end if
				ll_retrievecount = ll_retrievecount + 1
			else
				ll_lockedcount = ll_lockedcount + 1
			end if
		next
		if lds_podetail.rowcount() > 0 then
			this.id_master.object.remarks9[1] = trim(string(ll_pocode))
		end if
		destroy lds_podetail
		SQL stop USING lt_transobject;
		destroy lt_transobject
	end if
	if ll_retrievecount = ll_rowcount then
		messagebox("Result", "Purchase Order Successfully populated~n~r" + string(ll_rowcount) + " Items populated. ")
	else
		messagebox("Result", "Total item(s) were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_lockedcount) + " item(s) populated successfully~n~r" + string(ll_lockedcount) + " item(s) were not populated")
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_quotation.ue_pull_po_from_dropbox() returns long
	datastore lds_podetail
	long ll_detailrows
	long ll_count
	long ll_row
	long ll_master_row
	long ll_sitecode
	long ll_custcode
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_lockedcount
	long ll_retrievecount
	integer li_result
	integer li_rtncode
	boolean populateflag
	string ls_connsetting
	string ls_podetailquery
	string ls_newsyntax
	string ls_error_syntax
	string ls_errortxt
	string ls_prefix
	long ll_pocode
	s_arguements lstr_arg
	u_transaction lt_transobject
	long ll_totrows
	ll_master_row = this.id_master.rowcount()
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.object.posted[ll_master_row] = "Y" then
		messagebox("Population Problem!", "Can not pouplate after posting!")
		return 0
	end if
	if isnull(this.id_master.object.custcode[ll_master_row]) or this.id_master.object.custcode[ll_master_row] = 0 then
		messagebox("Population Problem!", "Please Select some Customer First!")
		this.id_master.setcolumn("custcode")
		this.id_master.setfocus()
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 and not isnull(this.id_detail.object.icode[1]) then
		li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
		if li_result = 1 then
			for ll_count = 1 to ll_detailrows
				this.id_detail.deleterow(0)
			next
			this.id_detail.reset()
		else
			populateflag = false
		end if
	end if
	if populateflag = true then
		open(w_pull_po_from_dropbox)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = -1 then
			populateflag = false
		else
			populateflag = true
		end if
	end if
	if populateflag = true then
		lt_transobject = create u_transaction
		SQL start USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Connection Problem", "Unable to connect to database.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
			return -1
		end if
		SQL EXECUTE IMMEDIATE :ls_connsetting USING lt_transobject;
		ll_pocode = lstr_arg.l_code1
		ll_sitecode = lstr_arg.l_code4
		ll_custcode = lstr_arg.l_code5
		ls_prefix = ""
		if gs_dropbox_server = "" or isnull(gs_dropbox_server) then
			ls_prefix = ""
		else
			ls_prefix = gs_dropbox_server + "."
		end if
		if gs_dropbox_db = "" or isnull(gs_dropbox_db) then
			ls_prefix = ls_prefix
		else
			ls_prefix = ls_prefix + gs_dropbox_db + "."
		end if
		lds_podetail = create datastore
		ls_podetailquery = "Select SiteCode, POCode, ICode, Batch, Expiry, Qty, Rate, DiscPerc, PORowId, BonusQty, Stock, ReorderQty, OptimumQty, MinQty, PackUnits, SoldQty, ReturnQty, QtySatisfied, BonusQtySatisfied, SaleOrderRequest, TransitStock, Remarks, ItemFlatDisc, PackSalesTax, GSTPerc, PurPrice, SalePrice, RPP, PackAvgPrice " + "From ~t" + ls_prefix + "DBO" + "." + "DB_PurOrderDetail " + "Where ~tpocode = " + string(ll_pocode) + " AND SiteCode = " + string(ll_sitecode) + "  order by porowid"
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_podetailquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For Purchase Order Header DataStore")
			this.id_detail.setredraw(true)
			return -1
		else
			ls_error_syntax = ""
			lds_podetail.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For Purchase Order DataStore")
				this.id_detail.setredraw(true)
				return -1
			end if
		end if
		lds_podetail.settransobject(lt_transobject)
		if lds_podetail.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source Purchase Order Details.")
			this.id_detail.setredraw(true)
			return -1
		end if
		this.id_detail.reset()
		ll_rowcount = lds_podetail.rowcount()
		if ll_custcode > 0 then
			this.id_master.object.custcode[ll_master_row] = ll_custcode
		end if
		this.id_master.object.sprice[ll_master_row] = 4
		this.id_master.object.loosepack[ll_master_row] = 2
		for ll_count = 1 to ll_rowcount
			ll_icode = lds_podetail.object.icode[ll_count]
			ll_row = this.id_detail.insertrow(0)
			if wf_inititeminfo(ll_icode, ll_row, li_rtncode, ls_errortxt) = true then
				this.id_detail.object.looseqty[ll_row] = lds_podetail.object.qty[ll_count]
				this.id_detail.object.bonusqty[ll_row] = lds_podetail.object.bonusqty[ll_count]
				this.id_detail.object.remotenetsaleqty[ll_row] = lds_podetail.object.soldqty[ll_count] - lds_podetail.object.returnqty[ll_count]
				this.id_detail.object.remotestock[ll_row] = lds_podetail.object.stock[ll_count]
				if lstr_arg.l_code2 = 1 then
					this.id_detail.object.saleprice[ll_row] = lds_podetail.object.rate[ll_count]
				end if
				if lstr_arg.l_code3 = 1 then
					this.id_detail.object.discperc[ll_row] = lds_podetail.object.discperc[ll_count]
				end if
				ll_retrievecount = ll_retrievecount + 1
			else
				ll_lockedcount = ll_lockedcount + 1
			end if
		next
		if lds_podetail.rowcount() > 0 then
			this.id_master.object.remarks9[1] = trim(string(ll_pocode))
		end if
		destroy lds_podetail
		SQL stop USING lt_transobject;
		destroy lt_transobject
	end if
	if ll_retrievecount = ll_rowcount then
		messagebox("Result", "Purchase Order Successfully populated~n~r" + string(ll_rowcount) + " Items populated. ")
	else
		messagebox("Result", "Total item(s) were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_lockedcount) + " item(s) populated successfully~n~r" + string(ll_lockedcount) + " item(s) were not populated")
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
		event ue_save()
		if wf_commitform() = true then
			SQL rollback USING sqlca;
			sqlca.markpoaspulled(ll_sitecode, ll_pocode, gl_usercode, gs_dropbox_server, gs_dropbox_db, "dbo")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
			postevent("ue_new")
		else
			ll_totrows = this.id_detail.rowcount()
			if ll_totrows > 0 then
				for ll_row = 1 to ll_totrows
					triggerevent("ue_deleteitem")
				next
			end if
		end if
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_quotation.wf_setsuppinfo(long al_suppcode, datawindow ad_master) returns 0
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	SQL SELECT supplier.address1 , supplier.city , supplier.phone INTO :ls_address, :ls_city, :ls_phone FROM supplier WHERE supplier.suppcode =:al_suppcode USING this.it_transobject;
	ll_currow = ad_master.getrow()
	ad_master.object.supplier_address[ll_currow] = ls_address
	ad_master.object.supplier_city[ll_currow] = ls_city
	ad_master.object.supplier_phone[ll_currow] = ls_phone

// w_quotation.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_quotation.wf_setsaletype(integer ai_saletype) returns 0
	this.ii_saletype = ai_saletype

// w_quotation.wf_savastemplate() returns integer
	s_saletemplateheader lstr_templateheader
	long ll_invid
	integer li_retcode
	long ll_code
	long ll_qty
	long ll_icode
	long ll_totalrows
	long ll_rowcount
	open(w_savesaleastemplate)
	lstr_templateheader = message.powerobjectparm
	f_newtableid("SaleTemplateHeader", ll_invid)
	SQL INSERT INTO SaleTemplateHeader ( saletemplatecode , date , modified , name ) values ( :ll_invid , :lstr_templateheader.dt_templatedate , :lstr_templateheader.dt_templatedate , :lstr_templateheader.s_template ) USING this.it_transobject;
	ll_totalrows = this.id_detail.rowcount()
	for ll_rowcount = 1 to ll_totalrows
		ll_code = ll_invid
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ll_qty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		SQL insert into saletemplatedetail ( saletemplatecode , icode , looseqty ) values ( :ll_code , :ll_icode , :ll_qty ) USING this.it_transobject;
	next
	setpointer(hourglass!)
	if this.it_transobject.sqlcode < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return li_retcode
	else
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Template saved", exclamation!, ok!, 1)
	end if
	return li_retcode

// w_quotation.wf_print() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_count
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			for ll_count = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
				this.id_print.retrieve(ll_count)
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			next
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	return li_errcode

// w_quotation.wf_preinvinfo() returns 0
	s_previnvinfo ls_previnvinfo
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_previnvinfo.ar_customer = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		setnull(ls_previnvinfo.ar_patientcode)
		ls_previnvinfo.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_previnvinfo.ar_invdate = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_previnvinfo, ls_previnvinfo)
	end if

// w_quotation.wf_retrievelistall() returns long
	string[] ls_posted
	integer li_salecategory
	datetime ld_invdate
	ld_invdate = datetime(date("12/12/1998"), time("00:00:00"))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		li_salecategory = this.ii_salecategory
	else
		li_salecategory = this.ii_saletype
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate)

// w_quotation.wf_retrievelist() returns long
	string[] ls_posted
	integer li_salecategory
	integer li_invforlastdays
	datetime ld_invdate
	ld_invdate = datetime(relativedate(today(), li_invforlastdays))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		li_salecategory = this.ii_salecategory
	else
		li_salecategory = this.ii_saletype
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate)

// w_quotation.wf_updatesaleprice(long al_icode, double ad_saleprice) returns integer
	SQL update Item SET saleprice =:ad_saleprice WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_quotation.wf_selectitembatches(long al_gcode, long al_icode, long al_qty, datawindow ad_itemsdetail, long al_rowscount, string al_errortext) returns integer
	datastore lds_itemstockinfo
	long ll_counter
	long ll_saleqty
	long ll_reqqty
	long ll_totalstock
	long ll_batchqty
	long ll_detailrowcount
	boolean lb_flag
	integer li_errcode
	lds_itemstockinfo = create datastore
	lds_itemstockinfo.dataobject = "d_itemstockinfo"
	lds_itemstockinfo.settransobject(this.it_transobject)
	if lds_itemstockinfo.retrieve(al_gcode, al_icode) > 0 then
		ll_totalstock = lds_itemstockinfo.getitemnumber(1, "c_totalstock")
		if ll_totalstock >= al_qty then
			ll_reqqty = al_qty
			ll_detailrowcount = ad_itemsdetail.rowcount()
			ll_counter = 1
			do while ll_counter <= lds_itemstockinfo.rowcount() and not lb_flag
				ll_batchqty = lds_itemstockinfo.getitemnumber(ll_counter, "currqty")
				if ll_batchqty >= ll_reqqty then
					ll_saleqty = ll_reqqty
					lb_flag = true
				else
					ll_saleqty = ll_batchqty
					ll_reqqty = ll_reqqty - ll_batchqty
				end if
				ad_itemsdetail.insertrow(0)
				ll_detailrowcount = ll_detailrowcount + 1
				ad_itemsdetail.setitem(ll_detailrowcount, "gcode", al_gcode)
				ad_itemsdetail.setitem(ll_detailrowcount, "icode", al_icode)
				ad_itemsdetail.setitem(ll_detailrowcount, "batch", lds_itemstockinfo.getitemstring(ll_counter, "batch"))
				ad_itemsdetail.setitem(ll_detailrowcount, "expiry", lds_itemstockinfo.getitemdatetime(ll_counter, "expiry"))
				ad_itemsdetail.setitem(ll_detailrowcount, "stock", ll_batchqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "totalstock", ll_totalstock)
				ad_itemsdetail.setitem(ll_detailrowcount, "looseqty", ll_saleqty)
				ll_counter = ll_counter + 1
			loop
			al_rowscount = ll_counter - 1
		else
			li_errcode = 1
			al_rowscount = ll_totalstock
			al_errortext = "Stock has been decreased for this item   "
		end if
	else
		li_errcode = 1
		al_rowscount = ll_totalstock
		al_errortext = "Stock does not exist for this item   "
	end if
	destroy lds_itemstockinfo
	return li_errcode

// w_quotation.wf_returnsaleinvoice(long al_invid, string as_errtext) returns boolean
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_counter
	long ll_detailrows
	double ld_looseqty
	double ld_stock
	double ld_newstock
	string ls_batch
	string ls_due
	datetime ld_expiry
	boolean lb_commitflag
	double ld_avgprice
	this.id_saleinvdetail.retrieve(al_invid)
	ll_detailrows = this.id_saleinvdetail.rowcount()
	ll_counter = 1
	do while ll_counter <= ll_detailrows and lb_commitflag
		ll_gcode = this.id_saleinvdetail.getitemnumber(ll_counter, "gcode")
		ll_icode = this.id_saleinvdetail.getitemnumber(ll_counter, "icode")
		ls_batch = this.id_saleinvdetail.getitemstring(ll_counter, "batch")
		ld_expiry = this.id_saleinvdetail.getitemdatetime(ll_counter, "expiry")
		ld_looseqty = this.id_saleinvdetail.getitemnumber(ll_counter, "looseqty")
		ls_due = this.id_saleinvdetail.getitemstring(ll_counter, "Due")
		if ls_due <> "D" or isnull(ls_due) then
			this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
			if this.it_transobject.sqlcode = 0 then
				this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					ld_newstock = ld_stock + ld_looseqty
					this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
					if this.it_transobject.sqlcode <> 0 then
						lb_commitflag = false
					end if
					if ld_stock = 0.0 then
						SQL update GodownDetail Set Priority =1 Where GodownDetail.GCode =:ll_gcode and GodownDetail.ICode =:ll_icode and GodownDetail.Batch =:ls_batch and GodownDetail.Expiry =:ld_expiry USING this.it_transobject;
					end if
				else
					lb_commitflag = false
				end if
			else
				lb_commitflag = false
			end if
		end if
		ll_counter = ll_counter + 1
	loop
	if lb_commitflag then
		if wf_deletesaleinvoice(al_invid) <> 0 then
			lb_commitflag = false
			as_errtext = "    Some database problem occur"
		end if
	else
		as_errtext = "    Some database problem occur"
	end if
	return lb_commitflag

// w_quotation.wf_customerinfo(long al_custcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	long ll_defaultsaleprice
	long ll_counter
	long ll_loosepack
	long ll_icode
	integer li_packunits
	double ld_currbalance
	double ld_saleprice1
	double ld_saleprice2
	double ld_saleprice3
	double ld_saleprice4
	double ld_saleprice5
	double ld_purprice
	double ld_avgprice
	double ld_rpp
	double ld_packsalestax
	SQL SELECT customer.address1 , customer.city , customer.phone , customer.defaultsaleprice INTO :ls_address, :ls_city, :ls_phone, :ll_defaultsaleprice FROM customer WHERE customer.custcode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
		this.id_master.object.sprice[ll_currow] = ll_defaultsaleprice
		ll_loosepack = this.id_master.getitemnumber(1, "loosepack")
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT item.saleprice , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.avgprice , item.packunits , item.purprice , item.recentpurprice , item.packsalestax INTO :ld_saleprice1, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :ld_avgprice, :li_packunits, :ld_purprice, :ld_rpp, :ld_packsalestax FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = -1 then
				messagebox("Database Error", "Item information can not be retrieved")
				return 1
			end if
			if not (this.it_transobject.sqlcode = 100) then
				choose case long(ll_defaultsaleprice)
				case 1
					if ll_loosepack = 1 then
						this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice1 / li_packunits)
						this.id_detail.setitem(ll_counter, "unitsalestax", ld_packsalestax / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice1)
						this.id_detail.setitem(ll_counter, "unitsalestax", ld_packsalestax)
					end if
				case 2
					if ll_loosepack = 1 then
						this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice2 / li_packunits)
						this.id_detail.setitem(ll_counter, "unitsalestax", ld_packsalestax / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice2)
						this.id_detail.setitem(ll_counter, "unitsalestax", ld_packsalestax)
					end if
				case 3
					if ll_loosepack = 1 then
						this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice3 / li_packunits)
						this.id_detail.setitem(ll_counter, "unitsalestax", ld_packsalestax / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice3)
						this.id_detail.setitem(ll_counter, "unitsalestax", ld_packsalestax)
					end if
				case 7
					if ll_loosepack = 1 then
						this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice4 / li_packunits)
						this.id_detail.setitem(ll_counter, "unitsalestax", ld_packsalestax / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice4)
						this.id_detail.setitem(ll_counter, "unitsalestax", ld_packsalestax)
					end if
				case 8
					if ll_loosepack = 1 then
						this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice5 / li_packunits)
						this.id_detail.setitem(ll_counter, "unitsalestax", ld_packsalestax / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice5)
						this.id_detail.setitem(ll_counter, "unitsalestax", ld_packsalestax)
					end if
				case 4
					if ll_loosepack = 1 then
						this.id_detail.setitem(ll_counter, "saleprice", ld_purprice / li_packunits)
						this.id_detail.setitem(ll_counter, "unitsalestax", ld_packsalestax / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "saleprice", ld_purprice)
						this.id_detail.setitem(ll_counter, "unitsalestax", ld_packsalestax)
					end if
				case 5
					if ll_loosepack = 1 then
						this.id_detail.setitem(ll_counter, "saleprice", ld_rpp / li_packunits)
						this.id_detail.setitem(ll_counter, "unitsalestax", ld_packsalestax / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "saleprice", ld_rpp)
						this.id_detail.setitem(ll_counter, "unitsalestax", ld_packsalestax)
					end if
				case else
					if ll_loosepack = 1 then
						this.id_detail.setitem(ll_counter, "saleprice", ld_avgprice)
						this.id_detail.setitem(ll_counter, "unitsalestax", ld_packsalestax / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "saleprice", ld_avgprice * li_packunits)
						this.id_detail.setitem(ll_counter, "unitsalestax", ld_packsalestax)
					end if
				end choose
			elseif not isnull(this.id_detail.getitemstring(1, "itemname")) then
				messagebox("DataBase Error", "Rows not retrieve")
				return 0
			end if
		next
	else
		return -1
	end if
	return 0

// w_quotation.wf_deletesaleinvoice(long al_saleinvcode) returns integer
	SQL Delete saledetail Where saledetail.SaleInvCode =:al_saleinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_quotation.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	long iccode
	long icatcode
	long packcode
	long manfcode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_quotation.wf_getitemassociategcode(long la_icode) returns integer
	integer li_gcode
	SQL Select Gcode INTO :li_gcode From item Where icode =:la_icode USING this.it_transobject;
	return li_gcode

// w_quotation.wf_getmaxdate(datetime ad_date) returns integer
	SQL Select Max ( Date ) INTO :ad_date From saleledger USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_quotation.wf_getsalesstockinfo(long al_saleinvcode, long al_gcode, long al_icode, long al_saleqty) returns integer
	SQL Select IsNull ( Sum ( saledetail.looseqty ) , 0 ) INTO :al_saleqty from saledetail where saledetail.saleinvcode =:al_saleinvcode and saledetail.gcode =:al_gcode and saledetail.icode =:al_icode USING this.it_transobject;
	if isnull(al_saleqty) then
		al_saleqty = 0
	end if
	return this.it_transobject.sqlcode

// w_quotation.wf_lockquotationinvoice(long al_quotationinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From Quotationheader WITH ( UPDLOCK HOLDLOCK ) Where Quotationheader.quotationcode =:al_quotationinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_quotation.wf_lockquotationinvoices(long al_sinvcode, long al_linvcode, long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From quotationheader WITH ( UPDLOCK HOLDLOCK ) Where quotationheader.quotationcode Between :al_sinvcode AND :al_linvcode AND quotationheader.Posted ='N' USING sqlca;
	return sqlca.sqlcode

// w_quotation.wf_locksaleinvoices(long al_sinvcode, long al_linvcode, long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From saleledger WITH ( UPDLOCK HOLDLOCK ) Where saleledger.saleinvcode Between :al_sinvcode AND :al_linvcode AND saleledger.Posted ='N' USING sqlca;
	return sqlca.sqlcode

// w_quotation.wf_setiteminfo(long al_icode, long al_row, double ad_saleprice, double ad_discperc, long al_stock, double ad_avgprice, long al_totalstock, double ad_purdiscperc) returns 0
	this.id_detail.setitem(al_row, "saleprice", ad_saleprice)
	if this.ii_saletype = 2 then
		this.id_detail.setitem(al_row, "discperc", ad_discperc)
	else
		this.id_detail.setitem(al_row, "discperc", 0.0)
	end if
	this.id_detail.setitem(al_row, "rate", ad_saleprice)
	this.id_detail.setitem(al_row, "avgprice", ad_avgprice)
	this.id_footer.object.icode[this.id_footer.getrow()] = al_icode
	this.id_footer.object.stock[this.id_footer.getrow()] = al_stock

// w_quotation.wf_validateitemnew() returns integer
	long ll_icode
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
		messagebox(ls_titleerrtext, ls_errtext)
	elseif not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		ls_titleerrtext = "Item Validation"
		li_errcode = -2
	end if
	this.ib_itemvalidated = true
	return li_errcode

// w_quotation.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	long ll_icode
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean lb_rtflag
	boolean ib_due
	integer li_null
	string ls_null
	ls_titleerrtext = "Item Validation"
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), al_currrow) = true then
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
	elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			li_option = messagebox("Item Validation", "Item stock does not exist~n~rDo You want to due this item", information!, yesno!, 2)
			if li_option = 1 then
				this.id_detail.setitem(this.il_currrow, "looseqty", 1)
				this.id_detail.setitem(this.il_currrow, "dueqty", 1)
				ib_due = true
			else
				li_errcode = -1
			end if
		end if
	else
		li_errcode = -1
		ls_titleerrtext = "Item Validation"
	end if
	if li_errcode = -1 and not ib_due then
		lb_rtflag = false
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setitem(al_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(al_currrow, "icode", li_null)
		this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	end if
	return lb_rtflag

// w_quotation.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_discountvalue
	double ld_invtaxperc1val
	double ld_intaxperc1
	double ld_totaltax
	double ld_totalitemleveltax
	real lr_discperc
	real lr_flatdisc
	real lr_misccharges
	real lr_salestax
	real lr_itemstotal
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		lr_discperc = this.id_footer.object.invdiscperc[1]
		lr_flatdisc = this.id_footer.object.flatdisc[1]
		lr_misccharges = this.id_footer.object.misccharges[1]
		lr_salestax = this.id_footer.object.salestax[1]
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
		ld_intaxperc1 = this.id_footer.object.invgstperc1[1]
		ld_totalitemleveltax = this.id_detail.getitemnumber(1, "c_sumtaxval") + this.id_detail.getitemnumber(1, "c_sumgstval")
		ld_discountvalue = ld_detaildwtotal * lr_discperc * 0.01
		ld_grandtotal = ld_detaildwtotal - ld_discountvalue - lr_flatdisc + lr_misccharges + lr_salestax
		ld_invtaxperc1val = round((ld_detaildwtotal - ld_discountvalue - lr_flatdisc) * ld_intaxperc1 * 0.01, 2)
		if isnull(ld_invtaxperc1val) then
			ld_invtaxperc1val = 0
		end if
		ld_totaltax = round(ld_invtaxperc1val + ld_totalitemleveltax, 0)
		ld_grandtotal = round(ld_grandtotal, 0) + ld_totaltax
		this.id_footer.setitem(1, "total", ld_grandtotal)
	end if
	return ld_grandtotal

// w_quotation.wf_dueitem() returns 0
	s_dueinfo ls_due
	long ll_row
	long li_null
	long ll_code
	long ll_counter
	long ll_icode
	long ll_gcode
	double ld_qty
	double ld_dueqty
	double ld_godownstock
	string ls_null
	this.id_detail.accepttext()
	if this.id_detail = getfocus() and this.id_detail.getcolumnname() = "looseqty" or this.id_detail.getcolumnname() = "gcode" then
		ll_row = this.id_detail.getrow()
		ll_code = this.id_master.getitemnumber(this.id_master.getrow(), "code")
		if not isnull(ll_code) then
			this.ids_invoiceinfo.retrieve(ll_code)
			ll_icode = this.id_detail.getitemnumber(ll_row, "icode")
			ll_gcode = this.id_detail.getitemnumber(ll_row, "gcode")
			this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Stock Validation", "Database Error: Item information can not be retrieved")
			end if
			for ll_counter = 1 to this.ids_invoiceinfo.rowcount()
				if ll_icode = this.ids_invoiceinfo.getitemnumber(ll_counter, "icode") then
					if isnull(this.ids_invoiceinfo.getitemstring(ll_counter, "due")) then
						ld_qty = ld_qty + this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty")
					else
						ld_dueqty = ld_dueqty + this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty")
					end if
				end if
			next
			ls_due.qty = ld_qty
			ls_due.dueqty = ld_dueqty
			ls_due.stock = ld_godownstock + ld_qty
		else
			ls_due.qty = this.id_detail.getitemnumber(ll_row, "looseqty")
			ls_due.dueqty = this.id_detail.getitemnumber(ll_row, "dueqty")
			ls_due.stock = this.id_detail.getitemnumber(ll_row, "stock")
		end if
		ls_due.itemname = this.id_detail.getitemstring(ll_row, "itemname")
		openwithparm(w_dueinfo, ls_due)
		ls_due = message.powerobjectparm
		ld_qty = ls_due.qty
		ld_dueqty = ls_due.dueqty
		setnull(ls_null)
		setnull(li_null)
		if ld_qty >= 0.0 then
			this.id_detail.setitem(ll_row, "looseqty", ld_qty)
			this.id_detail.setitem(ll_row, "dueqty", ld_dueqty)
		end if
		if ld_dueqty > 0.0 then
			this.id_detail.setitem(ll_row, "due", "D")
		else
			this.id_detail.object.due[ll_row] = ls_null
		end if
		return
	end if
	ll_row = this.id_detail.getrow()

// w_quotation.wf_setremarks() returns integer
	s_quotationremarks ls_quotationremarks
	ls_quotationremarks.remarks2 = this.id_master.getitemstring(1, "remarks2")
	ls_quotationremarks.remarks3 = this.id_master.getitemstring(1, "remarks3")
	ls_quotationremarks.remarks4 = this.id_master.getitemstring(1, "remarks4")
	ls_quotationremarks.remarks5 = this.id_master.getitemstring(1, "remarks5")
	ls_quotationremarks.remarks6 = this.id_master.getitemstring(1, "remarks6")
	ls_quotationremarks.remarks7 = this.id_master.getitemstring(1, "remarks7")
	ls_quotationremarks.remarks8 = this.id_master.getitemstring(1, "remarks8")
	ls_quotationremarks.remarks9 = this.id_master.getitemstring(1, "remarks9")
	openwithparm(w_quotationremarks, ls_quotationremarks)
	ls_quotationremarks = message.powerobjectparm
	this.id_master.setitem(1, "remarks2", ls_quotationremarks.remarks2)
	this.id_master.setitem(1, "remarks3", ls_quotationremarks.remarks3)
	this.id_master.setitem(1, "remarks4", ls_quotationremarks.remarks4)
	this.id_master.setitem(1, "remarks5", ls_quotationremarks.remarks5)
	this.id_master.setitem(1, "remarks6", ls_quotationremarks.remarks6)
	this.id_master.setitem(1, "remarks7", ls_quotationremarks.remarks7)
	this.id_master.setitem(1, "remarks8", ls_quotationremarks.remarks8)
	this.id_master.setitem(1, "remarks9", ls_quotationremarks.remarks9)
	return 1

// w_quotation.wf_closelist() returns 0
	this.ib_itemslistopen = false
	this.id_itemslist.hide()

// w_quotation.wf_populatesaledetail(long al_invid, datawindow ad_saledetail, string as_errortext, long al_errorrow) returns boolean
	long ll_detailrows
	long ll_gcode
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode
	long li_counter
	long li_innercounter
	long ll_insertedrows
	long ll_itemsdetailrowcount
	long ll_row
	long ll_itemflatdisc
	double ld_stock
	double ld_newstock
	double ld_salelooseqty
	double ld_dueqty
	double ld_looseqty
	double ld_bonusqty
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_gstperc
	double ld_unitsalestax
	boolean lb_commitflag
	string ls_batch
	string ls_updatesaleprice
	string ls_updsaleprice
	string ls_saleitemdescription
	datetime ld_expiry
	dwitemstatus ldws_column
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	ll_itemsdetailrowcount = 0
	ls_updatesaleprice = f_stringpreferences("updatesaleprice")
	as_errortext = "    Some database problem ocuurs         "
	do while li_counter <= ll_detailrows and lb_commitflag
		ll_gcode = this.id_detail.getitemnumber(li_counter, "gcode")
		ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
		ld_salelooseqty = this.id_detail.getitemnumber(li_counter, "looseqty")
		ld_dueqty = this.id_detail.getitemnumber(li_counter, "dueqty")
		ll_packunits = this.id_detail.getitemnumber(li_counter, "packunits")
		ld_saleprice = this.id_detail.getitemnumber(li_counter, "saleprice")
		ld_discperc = this.id_detail.getitemnumber(li_counter, "discperc")
		ld_rate = this.id_detail.getitemnumber(li_counter, "rate")
		ll_itemflatdisc = this.id_detail.getitemnumber(li_counter, "itemflatdisc")
		ls_saleitemdescription = this.id_detail.getitemstring(li_counter, "saleitemdescription")
		ldws_column = this.id_detail.getitemstatus(li_counter, "saleprice", primary!)
		ls_updsaleprice = this.id_detail.getitemstring(li_counter, "updatesaleprice")
		ld_unitsalestax = this.id_detail.getitemnumber(li_counter, "unitsalestax")
		ld_bonusqty = this.id_detail.getitemnumber(li_counter, "bonusqty")
		ld_gstperc = this.id_detail.getitemnumber(li_counter, "gstperc")
		ld_salelooseqty = ld_salelooseqty - ld_dueqty
		this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			if ld_salelooseqty > 0.0 and lb_commitflag then
				if wf_selectitembatches(ll_gcode, ll_icode, ld_salelooseqty, ad_saledetail, ll_insertedrows, as_errortext) = 0 then
					for li_innercounter = 1 to ll_insertedrows
						ll_row = ll_itemsdetailrowcount + li_innercounter
						ad_saledetail.setitem(ll_row, "code", al_invid)
						ad_saledetail.setitem(ll_row, "packunits", ll_packunits)
						ad_saledetail.setitem(ll_row, "saleprice", ld_saleprice)
						ad_saledetail.setitem(ll_row, "discperc", ld_discperc)
						ad_saledetail.setitem(ll_row, "rate", ld_rate)
						ad_saledetail.setitem(ll_row, "avgprice", ld_avgprice)
						ad_saledetail.setitem(ll_row, "itemflatdisc", ll_itemflatdisc)
						ad_saledetail.setitem(ll_row, "saleitemdescription", ls_saleitemdescription)
						ls_batch = ad_saledetail.getitemstring(ll_row, "batch")
						ld_expiry = ad_saledetail.getitemdatetime(ll_row, "expiry")
						ld_looseqty = ad_saledetail.getitemnumber(ll_row, "looseqty")
						ld_stock = ad_saledetail.getitemnumber(ll_row, "stock")
						ld_newstock = ld_stock - ld_looseqty
						if ld_newstock > 0.0 then
							this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
						else
							this.it_transobject.deleteitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
						end if
						if this.it_transobject.sqlcode <> 0 then
							lb_commitflag = false
						end if
					next
					ll_itemsdetailrowcount = ll_itemsdetailrowcount + ll_insertedrows
				else
					this.id_detail.setitem(li_counter, "stock", ll_insertedrows)
					lb_commitflag = false
				end if
			end if
			if ld_dueqty > 0.0 and lb_commitflag then
				ll_itemsdetailrowcount = ll_itemsdetailrowcount + 1
				ad_saledetail.insertrow(0)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "gcode", ll_gcode)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "icode", ll_icode)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "batch", "Due")
				ad_saledetail.setitem(ll_itemsdetailrowcount, "expiry", relativedate(today(), 365))
				ad_saledetail.setitem(ll_itemsdetailrowcount, "stock", ld_stock)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "totalstock", 0)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "looseqty", ld_dueqty)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "due", "D")
				ad_saledetail.setitem(ll_itemsdetailrowcount, "code", al_invid)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "packunits", ll_packunits)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "saleprice", ld_saleprice)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "discperc", ld_discperc)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "rate", ld_rate)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "avgprice", ld_avgprice)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "itemflatdisc", ll_itemflatdisc)
			end if
		else
			lb_commitflag = false
		end if
		li_counter = li_counter + 1
	loop
	if not lb_commitflag then
		al_errorrow = li_counter - 1
		messagebox("Database Error", as_errortext)
	end if
	return lb_commitflag

// w_quotation.wf_visible(boolean ab_flag) returns 0
	this.id_footer.object.stock.visible = ab_flag
	this.id_footer.object.t_stock.visible = ab_flag

// w_quotation.wf_validategodown() returns integer
	long ll_gcode
	long ll_icode
	long ll_retcode
	double ld_totalstock
	double ld_godownstock
	string ls_errortext
	ll_retcode = 1
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	ll_gcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		ll_gcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	else
		if this.il_strategy = 2 then
			ll_gcode = wf_getitemassociategcode(ll_icode)
		end if
		if this.il_strategy = 1 then
			ll_gcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
		end if
	end if
	this.it_transobject.getitemstockall(ll_icode, ld_totalstock)
	if this.it_transobject.sqlcode <> 0 then
		ll_retcode = -1
		ls_errortext = "Database Error: Item stock information can not be retrieved"
	end if
	this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		ll_retcode = -1
		ls_errortext = "Database Error: Item Stock information can not be retrieved"
	end if
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_totalstock)
	this.id_detail.setitem(this.il_currrow, "stock", ld_godownstock)
	this.id_detail.setitem(this.il_currrow, "totalstock", ld_totalstock)
	if ll_retcode = -1 then
		messagebox("Stock Error", ls_errortext)
	end if
	this.ib_godownvalidated = true
	return ll_retcode

// w_quotation.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_quotation.wf_setgodownoption() returns 0
	this.ii_salegodown = this.id_detail.getitemnumber(1, "gcode")
	if this.il_strategy = 2 or this.il_strategy = 1 and this.il_godowncount = 1 then
		this.id_detail.modify("gcode" + ".Protect=1")
		this.id_detail.object.gcode.background.color = this.backcolor
	end if

// w_quotation.wf_validateitem(boolean ab_flag) returns integer
	long ll_icode
	long ll_count
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean ib_due
	boolean lb_dupitem
	double ld_stock
	double ld_totalstock
	integer li_null
	string ls_null
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if not isnull(ll_icode) then
		if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true and f_stringpreferences("allowdupiteminquotation") = "N" then
			ls_titleerrtext = "Item Validation"
			ls_errtext = "Duplicate item, please select some other item"
			lb_dupitem = true
			li_errcode = -1
		else
			wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext)
			li_errcode = 1
		end if
		this.ib_itemvalidated = true
		if li_errcode = -1 then
			setnull(li_null)
			setnull(ls_null)
			ls_titleerrtext = "Item Validation"
			if lb_dupitem = true then
				this.id_detail.scrolltorow(this.il_currrow)
				this.id_detail.object.icode[this.il_currrow] = li_null
				this.id_detail.object.fullcode[this.il_currrow] = ls_null
				this.id_detail.object.itemname[this.il_currrow] = ls_null
				post event ue_deleteitem_row(this.il_currrow)
				for ll_count = 1 to this.id_detail.rowcount()
					if this.id_detail.getitemnumber(ll_count, "icode") = ll_icode then
						this.id_detail.scrolltorow(ll_count)
						triggerevent("ue_focusqty")
					end if
				next
				messagebox("Item", "Duplicate Item, please select some other item")
			else
				messagebox(ls_titleerrtext, ls_errtext)
				if f_stringpreferences("itemcode") = "N" then
					this.id_detail.setcolumn(this.is_columnitemname)
					this.ib_itemslistopen = true
					this.id_itemslist.show()
				else
					this.id_detail.setcolumn("fullcode")
					this.id_detail.object.fullcode[this.il_currrow] = ls_null
				end if
				this.id_detail.scrolltorow(this.il_currrow)
				this.id_detail.object.icode[this.il_currrow] = li_null
				this.id_detail.object.itemname[this.il_currrow] = ls_null
			end if
		end if
	end if
	return li_errcode

// w_quotation.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_quotation.wf_copyinvoice() returns integer
	datastore lds_quotationdetail
	datastore lds_quotationheader
	s_saletemplate lstr_template
	boolean lb_enablesave
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_currrow
	long ll_packunits
	long ll_found
	long ll_populatecount
	long ll_drow
	long ll_ds_row
	long ll_custcode
	integer li_retcode
	integer li_errcode
	string ls_errortext
	string ls_itemname
	string ls_loosepack
	string ls_customer
	double ld_price
	double ld_qty
	double ld_bonusqty
	double ld_stock
	if wf_iseditable() = false then
		return 0
	end if
	lds_quotationdetail = create datastore
	lds_quotationheader = create datastore
	open(w_editquotationform)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_quotationdetail.dataobject = "d_quotationdetail_retrieve"
		lds_quotationdetail.settransobject(this.it_transobject)
		lds_quotationheader.dataobject = "d_quotationheader"
		lds_quotationheader.settransobject(this.it_transobject)
		ll_row = lds_quotationheader.retrieve(lstr_template.l_invtemplate)
		lds_quotationdetail.retrieve(lstr_template.l_invtemplate, lstr_template.i_invtype)
		if ll_row < 0 then
			li_retcode = -1
		end if
		setredraw(false)
		ll_mrow = this.id_master.getrow()
		ll_custcode = lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "custcode")
		SQL Select Name INTO :ls_customer From Accounts Where AccCode =:ll_custcode USING this.it_transobject;
		this.id_master.setitem(ll_mrow, "custcode", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "custcode"))
		this.id_master.setitem(ll_mrow, "sprice", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "sprice"))
		this.id_master.setitem(ll_mrow, "remarks", lds_quotationheader.getitemstring(lds_quotationheader.getrow(), "remarks"))
		this.id_master.setitem(ll_mrow, "headerno", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "headerno"))
		this.id_master.setitem(ll_mrow, "loosepack", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "loosepack"))
		this.id_footer.setitem(ll_mrow, "misccharges", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "misccharges"))
		this.id_footer.setitem(ll_mrow, "invdiscperc", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "discperc"))
		this.id_footer.setitem(ll_mrow, "flatdisc", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "flatdisc"))
		this.id_footer.setitem(ll_mrow, "invgstperc1", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "invgstperc1"))
		ll_totalrows = lds_quotationdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for ll_rowcount = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		this.id_detail.reset()
		for ll_rowcount = 1 to ll_totalrows
			ll_packunits = lds_quotationdetail.getitemnumber(ll_rowcount, "packunits")
			if ll_packunits = 0 then
				ll_packunits = 1
			end if
			ll_populatecount = ll_populatecount + 1
			ll_drow = this.id_detail.insertrow(0)
			li_errcode = 0
			ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_quotationdetail.getitemnumber(ll_rowcount, "gcode")), 1, this.idc_godown.rowcount())
			ls_itemname = lds_quotationdetail.getitemstring(ll_rowcount, "itemname")
			wf_inititeminfo(lds_quotationdetail.getitemnumber(ll_rowcount, "icode"), ll_drow, li_errcode, ls_errortext)
			ll_packunits = lds_quotationdetail.getitemnumber(ll_rowcount, "packunits")
			if ll_packunits = 0 then
				ll_packunits = 1
			end if
			this.id_detail.setitem(ll_drow, "packunits", ll_packunits)
			ld_qty = lds_quotationdetail.getitemnumber(ll_rowcount, "looseqty")
			ld_bonusqty = lds_quotationdetail.getitemnumber(ll_rowcount, "bonusqty")
			ld_price = lds_quotationdetail.getitemnumber(ll_rowcount, "saleprice")
			if ld_qty > 0.0 or ld_bonusqty > 0.0 then
				this.id_detail.setitem(ll_drow, "looseqty", ld_qty)
				this.id_detail.setitem(ll_drow, "bonusqty", ld_bonusqty)
				this.id_detail.setitem(ll_drow, "saleprice", ld_price)
				this.id_detail.setitem(ll_drow, "discperc", lds_quotationdetail.getitemnumber(ll_rowcount, "discperc"))
				this.id_detail.setitem(ll_drow, "itemflatdisc", lds_quotationdetail.getitemnumber(ll_rowcount, "itemflatdisc"))
				this.id_detail.setitem(ll_drow, "unitsalestax", lds_quotationdetail.getitemnumber(ll_rowcount, "unitsalestax"))
				this.id_detail.setitem(ll_drow, "gstperc", lds_quotationdetail.getitemnumber(ll_rowcount, "gstperc"))
				this.id_detail.setitem(ll_drow, "itemdescription", lds_quotationdetail.getitemstring(ll_rowcount, "itemdescription"))
			end if
		next
		setredraw(true)
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return li_retcode

// w_quotation.wf_post() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			li_errcode = wf_lockquotationinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_saleinvcount)
			if li_errcode = 0 then
				SQL update QuotationHeader Set posted ='Y' , postedby =:ll_salesmancode , PostDate =GETDATE ( ) Where QuotationHeader.QuotationCode Between :lstr_arginfo.l_code1 and :lstr_arginfo.l_code2 USING sqlca;
				if sqlca.sqlcode <> 0 then
					li_errcode = -1
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if li_errcode <> 0 then
		messagebox("Posting Fails", "Some database request fails, Please try again")
	else
		messagebox("Posting Successfull", "Total unposted rows were " + string(ll_saleinvcount) + "~n~rAll rows have been posted successfully")
	end if
	return li_errcode

// w_quotation.wf_initmodify(integer ai_protect) returns 0
	long ll_quotationinvcode
	long ll_gcode
	long ll_icode
	long ll_counter
	long ll_count
	double ld_looseqty
	double ld_stock
	double ld_totalstock
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_quotationinvcode = this.id_detail.getitemnumber(1, "code")
		if wf_lockquotationinvoice(ll_quotationinvcode) = 0 then
			this.id_master.retrieve(ll_quotationinvcode)
			this.id_detail.retrieve(ll_quotationinvcode)
			this.ids_invoiceinfo.retrieve(ll_quotationinvcode)
			for ll_count = 1 to this.id_detail.rowcount()
				ll_icode = this.id_detail.getitemnumber(ll_count, "icode")
				ll_gcode = this.id_detail.getitemnumber(ll_count, "gcode")
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				this.it_transobject.getitemstockall(ll_icode, ld_totalstock)
				if this.it_transobject.sqlcode <> 0 then
					ai_protect = 0
				end if
				this.id_detail.setitem(ll_count, "stock", ld_stock)
				this.id_detail.setitem(ll_count, "totalstock", ld_totalstock)
			next
			if ai_protect = 0 then
				this.ib_modify = true
				this.id_footer.setitem(1, "stock", this.id_detail.getitemnumber(1, "stock"))
				this.id_footer.setitem(1, "totalstock", this.id_detail.getitemnumber(1, "totalstock"))
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
		else
			messagebox("Cannot Modify", "Quotation is already in use")
		end if
		return
	end if
	ai_protect = 1

// w_quotation.wf_search_customer() returns 0
	long ll_code
	long ll_oldcode
	s_popup_selection lstr_selection
	if wf_iseditable() = false then
		return
	end if
	ll_oldcode = this.id_master.getitemnumber(1, "custcode")
	this.id_master.setcolumn("custcode")
	this.id_master.setfocus()
	openwithparm(w_popup_partialsearch_selection, "d_customer_list")
	lstr_selection = message.powerobjectparm
	if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
		this.id_master.setitem(1, "custcode", lstr_selection.l_code2)
	end if

// w_quotation.wf_inititeminfo(long al_icode, long al_row, integer ai_rtcode, string as_errortext) returns boolean
	boolean retflag
	double ld_saleprice
	double ld_saleprice1
	double ld_discperc
	double ld_saleprice2
	double ld_saleprice3
	double ld_avgprice
	double ld_unitsalestax
	double ld_gstperc1
	double ld_gstperc2
	double ld_packsalestax
	double ld_purprice
	double ld_rpp
	double ld_saleprice4
	double ld_saleprice5
	double ld_custitemcatdiscperc
	double ld_itemflatdisc
	double ld_porate
	double ld_claimablediscperc
	long ll_packunits
	long ll_saleinvcode
	long ll_itemdesc_status
	long ll_custcode
	double ld_godownstock
	double ld_saleqty
	double ld_totalstock
	double ld_qtysale
	double ld_bonus
	double ld_loosepack
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_remarks
	string ls_manfname
	setnull(ls_null)
	li_gcode = this.ii_defaultgcode
	SQL SELECT item.customicode , item.name , item.saleprice , item.packunits , item.salediscperc , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.avgprice , item.purprice , item.recentpurprice , round ( item.Packsalestax / item.packunits , 2 ) , item.gstperc1 , item.gstperc2 , qtysale =item.saleqty , bonus =item.bonusqty , item.Packsalestax , item.remarks , manufacturer =( select m.name from manufacturer m where m.manfcode =item.manfcode ) , item.claimablediscperc INTO :ls_fullcode, :ls_name, :ld_saleprice, :ll_packunits, :ld_discperc, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :ld_avgprice, :ld_purprice, :ld_rpp, :ld_unitsalestax, :ld_gstperc1, :ld_gstperc2, :ld_qtysale, :ld_bonus, :ld_packsalestax, :ls_remarks, :ls_manfname, :ld_claimablediscperc FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
	else
		if this.il_strategy = 2 then
			li_gcode = wf_getitemassociategcode(al_icode)
		end if
		if this.il_strategy = 1 then
			li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
		end if
	end if
	this.it_transobject.getitemstockall(al_icode, ld_totalstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if retflag then
		this.id_detail.setitem(al_row, "gcode", li_gcode)
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		this.id_detail.setitem(al_row, "icode", al_icode)
		this.id_detail.setitem(al_row, "packunits", ll_packunits)
		this.id_detail.setitem(al_row, "manufacturer", ls_manfname)
		this.id_detail.setitem(al_row, "claimablediscperc", ld_claimablediscperc)
		this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
		ll_custcode = this.id_master.object.custcode[this.id_master.rowcount()]
		if wf_getcustitemcatwisesalesdiscount(al_icode, ll_custcode, ld_custitemcatdiscperc, ld_itemflatdisc) = true then
			this.id_detail.setitem(al_row, "discperc", ld_custitemcatdiscperc)
			this.id_detail.setitem(al_row, "itemflatdisc", ld_itemflatdisc)
			this.id_detail.setitem(al_row, "podiscperc", ld_custitemcatdiscperc)
		elseif long(this.id_detail.object.discperc.visible) = 1 then
			this.id_detail.setitem(al_row, "discperc", ld_discperc)
			this.id_detail.setitem(al_row, "podiscperc", ld_discperc)
		else
			this.id_detail.setitem(al_row, "discperc", 0)
			this.id_detail.setitem(al_row, "podiscperc", 0)
		end if
		this.id_detail.setitem(al_row, "stock", ld_godownstock)
		this.id_detail.setitem(al_row, "totalstock", ld_totalstock)
		ld_loosepack = this.id_master.getitemnumber(1, "loosepack")
		choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
		case 1.0
			if ld_loosepack = 1.0 then
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
				this.id_detail.setitem(al_row, "specialrate", ld_saleprice / ll_packunits)
				this.id_detail.setitem(al_row, "porate", ld_saleprice / ll_packunits)
			else
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
				this.id_detail.setitem(al_row, "specialrate", ld_saleprice)
				this.id_detail.setitem(al_row, "porate", ld_saleprice)
			end if
		case 2.0
			if ld_loosepack = 1.0 then
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
				this.id_detail.setitem(al_row, "specialrate", ld_saleprice2 / ll_packunits)
				this.id_detail.setitem(al_row, "porate", ld_saleprice2 / ll_packunits)
			else
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "specialrate", ld_saleprice2)
				this.id_detail.setitem(al_row, "porate", ld_saleprice2)
			end if
		case 3.0
			if ld_loosepack = 1.0 then
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
				this.id_detail.setitem(al_row, "specialrate", ld_saleprice3 / ll_packunits)
				this.id_detail.setitem(al_row, "porate", ld_saleprice3 / ll_packunits)
			else
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "specialrate", ld_saleprice3)
				this.id_detail.setitem(al_row, "porate", ld_saleprice3)
			end if
		case 7.0
			if ld_loosepack = 1.0 then
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
				this.id_detail.setitem(al_row, "specialrate", ld_saleprice4 / ll_packunits)
				this.id_detail.setitem(al_row, "porate", ld_saleprice4 / ll_packunits)
			else
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "specialrate", ld_saleprice4)
				this.id_detail.setitem(al_row, "porate", ld_saleprice4)
			end if
		case 8.0
			if ld_loosepack = 1.0 then
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
				this.id_detail.setitem(al_row, "specialrate", ld_saleprice5 / ll_packunits)
				this.id_detail.setitem(al_row, "porate", ld_saleprice5 / ll_packunits)
			else
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "specialrate", ld_saleprice5)
				this.id_detail.setitem(al_row, "porate", ld_saleprice5)
			end if
		case 4.0
			if ld_loosepack = 1.0 then
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
				this.id_detail.setitem(al_row, "specialrate", ld_purprice / ll_packunits)
				this.id_detail.setitem(al_row, "porate", ld_purprice / ll_packunits)
			else
				this.id_detail.setitem(al_row, "saleprice", ld_purprice)
				this.id_detail.setitem(al_row, "specialrate", ld_purprice)
				this.id_detail.setitem(al_row, "porate", ld_purprice)
			end if
		case 5.0
			if ld_loosepack = 1.0 then
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
				this.id_detail.setitem(al_row, "specialrate", ld_rpp / ll_packunits)
				this.id_detail.setitem(al_row, "porate", ld_rpp / ll_packunits)
			else
				this.id_detail.setitem(al_row, "saleprice", ld_rpp)
				this.id_detail.setitem(al_row, "specialrate", ld_rpp)
				this.id_detail.setitem(al_row, "porate", ld_rpp)
			end if
		case else
			if ld_loosepack = 1.0 then
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
				this.id_detail.setitem(al_row, "specialrate", ld_avgprice)
				this.id_detail.setitem(al_row, "porate", ld_avgprice)
			else
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "specialrate", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "porate", ld_avgprice * ll_packunits)
			end if
		end choose
		if f_stringpreferences("bonusinsale") = "Y" then
			this.id_detail.setitem(al_row, "qtysale", ld_qtysale)
			this.id_detail.setitem(al_row, "bonus", ld_bonus)
		end if
		if this.id_detail.getitemstatus(al_row, "Unitsalestax", primary!) = notmodified! then
			if ld_loosepack = 1.0 then
				this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
			else
				this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax * ll_packunits)
			end if
		end if
		ll_itemdesc_status = long(this.id_detail.object.itemdescription.visible)
		if f_stringpreferences("SaleCopyItemRemarks") = "Y" then
			this.id_detail.setitem(al_row, "itemdescription", ls_remarks)
		end if
	end if
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_totalstock)
	if ld_loosepack = 1.0 then
		this.id_detail.setitem(al_row, "rpp", ld_rpp / ll_packunits)
		this.id_footer.setitem(1, "rpp", ld_rpp / ll_packunits)
	else
		this.id_detail.setitem(al_row, "rpp", ld_rpp)
		this.id_footer.setitem(1, "rpp", ld_rpp)
	end if
	if f_stringpreferences("bonusinsale") = "Y" then
		this.id_footer.setitem(1, "bonusratio", trim(string(ld_qtysale)) + ":" + trim(string(ld_bonus)))
	end if
	return retflag

// w_quotation.wf_allowquotationmodification(long al_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM quotationDetail WHERE quotationCode =:al_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_quotation.wf_editpurchaseorder() returns long
	datastore lds_podetail
	long ll_detailrows
	long ll_count
	long ll_row
	long ll_master_row
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_lockedcount
	long ll_retrievecount
	integer li_result
	integer li_rtncode
	boolean populateflag
	string ls_errortxt
	s_saletemplate lstr_template
	ll_master_row = this.id_master.rowcount()
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.object.posted[ll_master_row] = "Y" then
		messagebox("Population Problem!", "Can not pouplate after posting!")
		return 0
	end if
	if isnull(this.id_master.object.custcode[ll_master_row]) or this.id_master.object.custcode[ll_master_row] = 0 then
		messagebox("Population Problem!", "Please Select some Customer First!")
		this.id_master.setcolumn("custcode")
		this.id_master.setfocus()
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 and not isnull(this.id_detail.object.icode[1]) then
		li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
		if li_result = 1 then
			for ll_count = 1 to ll_detailrows
				this.id_detail.deleterow(0)
			next
			this.id_detail.reset()
		else
			populateflag = false
		end if
	end if
	if populateflag = true then
		open(w_editpurchaseorderform)
		lstr_template = message.powerobjectparm
		if lstr_template.c_copyinvfrom = "T" then
			if isnull(lstr_template.l_invtemplate) then
				populateflag = false
			else
				populateflag = true
			end if
		else
			populateflag = false
		end if
	end if
	if populateflag = true then
		lds_podetail = create datastore
		lds_podetail.dataobject = "d_populatepurorder"
		lds_podetail.settransobject(this.it_transobject)
		this.id_detail.reset()
		ll_rtcode = lds_podetail.retrieve(lstr_template.l_invtemplate)
		ll_rowcount = lds_podetail.rowcount()
		this.id_master.object.sprice[ll_master_row] = 4
		this.id_master.object.loosepack[ll_master_row] = 2
		for ll_count = 1 to ll_rowcount
			ll_icode = lds_podetail.object.icode[ll_count]
			ll_row = this.id_detail.insertrow(0)
			if wf_inititeminfo(ll_icode, ll_row, li_rtncode, ls_errortxt) = true then
				this.id_detail.object.looseqty[ll_row] = lds_podetail.object.qty[ll_count]
				this.id_detail.object.bonusqty[ll_row] = lds_podetail.object.bonusqty[ll_count]
				this.id_detail.object.saleprice[ll_row] = lds_podetail.object.rate[ll_count]
				this.id_detail.object.discperc[ll_row] = lds_podetail.object.discperc[ll_count]
				ll_retrievecount = ll_retrievecount + 1
			else
				ll_lockedcount = ll_lockedcount + 1
			end if
		next
		destroy lds_podetail
	end if
	if ll_retrievecount = ll_rowcount then
		messagebox("Result", "Purchase Order Successfully populated~n~r" + string(ll_rowcount) + " Items populated. ")
	else
		messagebox("Result", "Total item(s) were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_lockedcount) + " item(s) populated successfully~n~r" + string(ll_lockedcount) + " item(s) were not populated")
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_quotation.wf_getcustitemcatwisesalesdiscount(long al_icode, long al_custcode, double ad_discperc, double ad_itemflatdisc) returns boolean
	double ld_null
	setnull(ld_null)
	ad_discperc = ld_null
	SQL SELECT discperc , itemflatdisc INTO :ad_discperc, :ad_itemflatdisc FROM DBO.CustItemCatWiseSaleDiscount WHERE CustCatCode =ISNULL ( ( SELECT Customer.custcatcode FROM dbo.customer Where Customer.custcode =:al_custcode ) , 0 ) AND ICatCode =ISNULL ( ( SELECT Item.icatcode FROM dbo.Item Where Item.Icode =:al_icode ) , 0 ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ad_discperc) or isnull(ad_itemflatdisc) then
			return false
		else
			return true
		end if
		return
	end if
	return false

