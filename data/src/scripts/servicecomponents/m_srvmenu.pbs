// menu m_srvmenu (servicecomponents)  ancestor: m_multi_entry

// m_srvmenu.create() returns 0 [event]
	m_srvmenu = this
	call super::create
	this.text = "m_srvmenu"

// m_srvmenu.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_showserviceticketsettings = create m_showserviceticketsettings
	this.item[upperbound(this.item) + 1] = this.m_showserviceticketsettings

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_showserviceticketsettings

// m_showserviceticketsettings.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_show_serviceticketsettings()

// m_showserviceticketsettings.create() returns 0 [event]
	call super::create
	this.text = "Show Service Ticket Settings"
	this.menutextcolor = 134217735
	this.menubackcolor = 134217732
	this.menuhighlightcolor = 134217741
	this.textsize = 8
	this.weight = 400
	this.facename = "Tahoma"
	this.titlebackcolor = 134217730
	this.bitmapbackcolor = 12632256
	this.menubitmaps = true
	this.titlegradient = true
	this.toolbartextcolor = 134217746
	this.toolbarbackcolor = 67108864
	this.toolbarhighlightcolor = 134217741
	this.toolbargradient = true
	this.bitmapgradient = true

// m_showserviceticketsettings.destroy() returns 0 [event]
	call super::destroy
