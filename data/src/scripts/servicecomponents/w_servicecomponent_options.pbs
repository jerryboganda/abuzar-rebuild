// window w_servicecomponent_options (servicecomponents)  ancestor: window

// w_servicecomponent_options.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		post event ue_close(-1)
	end if
	return ::message.returnvalue

// w_servicecomponent_options.ue_close(integer ai_closemode) returns integer [event]
	long ll_currrow
	long ll_counter
	s_values_blob lstr_values_blob
	this.id_header.accepttext()
	ll_currrow = this.id_header.getrow()
	if ai_closemode = -1 then
		this.istr_values_blob.i_closemode = -1
		closewithreturn(this, this.istr_values_blob)
		return -1
	end if
	if this.id_header.rowcount() > 0 then
		if this.istr_values_blob.s_name = "S" then
			if isnull(this.id_header.object.optionid[ll_currrow]) or isnull(this.id_header.object.optionname[ll_currrow]) then
				this.id_header.deleterow(ll_currrow)
			end if
		elseif isnull(this.id_header.object.optionid[ll_currrow]) or isnull(this.id_header.object.optionname2[ll_currrow]) or this.id_header.object.optionname2[ll_currrow] <= 0 then
			this.id_header.deleterow(ll_currrow)
		end if
		for ll_counter = 1 to this.id_header.rowcount()
			if this.istr_values_blob.s_name = "S" then
				if isnull(this.id_header.object.optionid[ll_counter]) or isnull(this.id_header.object.optionname[ll_counter]) then
					this.id_header.setrow(ll_counter)
					this.id_header.setcolumn("optionname")
					this.id_header.setfocus()
					messagebox("Option Validation", "Please enter some valid option", stopsign!)
					return 1
				end if
			elseif isnull(this.id_header.object.optionid[ll_counter]) or isnull(this.id_header.object.optionname2[ll_counter]) or this.id_header.object.optionname2[ll_counter] <= 0 then
				this.id_header.setrow(ll_counter)
				this.id_header.setcolumn("optionname2")
				this.id_header.setfocus()
				messagebox("Option Validation", "Please enter some valid option", stopsign!)
				return 1
			end if
		next
		if f_validatedw(this.id_header) < 0 then
			return 1
		end if
		this.il_currrow = this.id_header.rowcount()
		if this.ib_rowvalidated = false and wf_validateitem() = -1 then
			return 1
		end if
		for ll_counter = 1 to this.id_header.rowcount()
			this.id_header.object.optionid[ll_counter] = this.id_header.object.c_rowid[ll_counter]
			if this.id_header.object.optionid[ll_counter] > 0 then
				lstr_values_blob.ls_value[ll_counter, 1] = trim(string(this.id_header.object.optionid[ll_counter]))
				if this.istr_values_blob.s_name = "D" then
					this.id_header.object.optionname[ll_counter] = trim(string(this.id_header.object.optionname2[ll_counter]))
					lstr_values_blob.ls_value[ll_counter, 2] = this.id_header.object.optionname[ll_counter]
				elseif this.istr_values_blob.s_name = "N" then
					this.id_header.object.optionname[ll_counter] = trim(string(this.id_header.object.optionname2[ll_counter]))
					lstr_values_blob.ls_value[ll_counter, 2] = this.id_header.object.optionname[ll_counter]
				else
					lstr_values_blob.ls_value[ll_counter, 2] = this.id_header.object.optionname[ll_counter]
				end if
			end if
		next
	end if
	this.istr_values_blob.ls_value = lstr_values_blob.ls_value
	this.istr_values_blob.i_closemode = ai_closemode
	closewithreturn(this, this.istr_values_blob)
	return 0

// w_servicecomponent_options.wf_validateitem() returns integer
	string ls_optionname
	string ls_colname
	integer li_errcode
	string ls_null
	double ld_null
	ls_optionname = this.id_header.getitemstring(this.il_currrow, "optionname")
	if this.istr_values_blob.s_name = "S" then
		if vf_dwdupstring(this.id_header, "optionname", ls_optionname, this.il_currrow) = true then
			messagebox("Duplication Error", "Current row is duplicate")
			li_errcode = -1
			this.ib_rowvalidated = false
		else
			li_errcode = 0
			this.ib_rowvalidated = true
		end if
	elseif vf_dwdupcode1(this.id_header, "optionname2", ls_optionname, this.il_currrow) = true then
		messagebox("Duplication Error", "Current row is duplicate")
		li_errcode = -1
		this.ib_rowvalidated = false
	else
		li_errcode = 0
		this.ib_rowvalidated = true
	end if
	if li_errcode = -1 then
		setnull(ls_null)
		setnull(ld_null)
		if this.istr_values_blob.s_name = "S" then
			this.id_header.setcolumn("optionname")
			this.id_header.object.optionname[this.il_currrow] = ls_null
		else
			this.id_header.object.optionname2[this.il_currrow] = ld_null
		end if
		this.id_header.scrolltorow(this.il_currrow)
	end if
	return li_errcode

// w_servicecomponent_options.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_servicecomponent_options.create() returns 0 [event]
	this.cb_ok = create cb_ok
	this.cb_cancel = create cb_cancel
	this.dw_viewheader = create dw_viewheader
	this.control = {this.cb_ok, this.cb_cancel, this.dw_viewheader}

// w_servicecomponent_options.destroy() returns 0 [event]
	destroy this.cb_ok
	destroy this.cb_cancel
	destroy this.dw_viewheader

// w_servicecomponent_options.open() returns long [event]
	long ll_row
	long ll_currrow
	long ll_counter
	string ls_saletype
	integer li_protect
	integer li_view_cashorcredit
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	this.id_header = this.dw_viewheader
	this.id_header.settransobject(sqlca)
	this.istr_values_blob = message.powerobjectparm
	if this.istr_values_blob.s_name = "S" then
		this.id_header.object.optionname.edit.required = true
		this.id_header.object.optionname2.editmask.required = false
		this.id_header.object.optionname2.visible = false
	else
		this.id_header.object.optionname.edit.required = false
		this.id_header.object.optionname2.editmask.required = true
		this.id_header.object.optionname.visible = false
		this.id_header.object.optionname2.visible = true
		this.id_header.object.optionname.initial = ""
		this.id_header.object.optionname2.initial = "0"
		this.id_header.object.optionname2.editmask.mask = f_get_servicecomponentunit_editmask(this.istr_values_blob.s_name)
		this.id_header.object.optionname2.format = f_get_servicecomponentunit_editmask(this.istr_values_blob.s_name)
		this.id_header.object.optionname2.editmask.focusrectangle = "Yes"
	end if
	if long(this.istr_values_blob.ls_value[1, 1]) > 0 then
		for ll_counter = 1 to 200
			if long(this.istr_values_blob.ls_value[ll_counter, 1]) > 0 then
				ll_row = this.id_header.insertrow(0)
				this.id_header.object.optionid[ll_row] = long(this.istr_values_blob.ls_value[ll_counter, 1])
				if this.istr_values_blob.s_name = "D" then
					this.id_header.object.optionname[ll_row] = trim(string(double(this.istr_values_blob.ls_value[ll_counter, 2])))
					this.id_header.object.optionname2[ll_row] = double(this.istr_values_blob.ls_value[ll_counter, 2])
				elseif this.istr_values_blob.s_name = "N" then
					this.id_header.object.optionname[ll_row] = trim(string(long(this.istr_values_blob.ls_value[ll_counter, 2])))
					this.id_header.object.optionname2[ll_row] = long(this.istr_values_blob.ls_value[ll_counter, 2])
				else
					this.id_header.object.optionname[ll_row] = this.istr_values_blob.ls_value[ll_counter, 2]
					this.id_header.object.optionname2[ll_row] = 0
				end if
			end if
		next
	end if
	if this.id_header.rowcount() = 0 then
		this.id_header.insertrow(0)
	end if
	this.id_header.scrolltorow(this.id_header.rowcount())
	setredraw(false)
	setredraw(true)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_ok.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	parent.post event ue_close(1)
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.post event ue_close(-1)
	return ::message.returnvalue

// dw_viewheader.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ll_rowcount
	if key = keyescape! then
		parent.post event ue_close(-1)
	end if
	if keyflags = 2 then
		if key = keyi! then
			if parent.ib_rowvalidated = false and parent.wf_validateitem() = -1 then
				return ::message.returnvalue
			end if
			if parent.id_header.rowcount() > 0 and f_validatedw(parent.id_header) < 0 then
				return ::message.returnvalue
			end if
			ll_rowcount = parent.id_header.insertrow(0)
			if ll_rowcount > 1 then
				parent.id_header.scrolltorow(ll_rowcount)
				parent.id_header.setfocus()
			end if
		end if
		if key = keyd! then
			parent.ib_rowvalidated = true
			if parent.id_header.rowcount() > 0 then
				parent.id_header.deleterow(0)
			end if
			ll_rowcount = parent.id_header.rowcount()
			if ll_rowcount > 1 then
				parent.id_header.scrolltorow(ll_rowcount)
				parent.id_header.setfocus()
			end if
			parent.ib_rowvalidated = true
		end if
	end if
	return ::message.returnvalue

// dw_viewheader.ue_enterkey() returns long [event]
	long ll_rowcount
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		if parent.id_header.rowcount() > 0 and f_validatedw(parent.id_header) < 0 then
			return ::message.returnvalue
		end if
		if parent.ib_rowvalidated = false and parent.wf_validateitem() = -1 then
			return 1
		end if
		if parent.istr_values_blob.s_name = "S" then
			if parent.id_header.object.optionname[getrow()] = "" or isnull(parent.id_header.object.optionname[getrow()]) then
				return ::message.returnvalue
			else
				ll_rowcount = parent.id_header.insertrow(0)
			end if
		elseif isnull(parent.id_header.object.optionname2[getrow()]) then
			return ::message.returnvalue
		else
			ll_rowcount = parent.id_header.insertrow(0)
		end if
		if ll_rowcount > 1 then
			parent.id_header.scrolltorow(ll_rowcount)
			parent.id_header.setfocus()
		end if
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_viewheader.itemerror(long row, dwobject dwo, string data) returns long [event]
	choose case dwo.name
	case "optionname"
		if data = "" or isnull(data) then
			messagebox("Option Name Validation", "Value required Option Name in current row")
		end if
	case "optionname2"
		if data = "" or isnull(data) then
			messagebox("Option Name Validation", "Value required Option Name in current row")
		end if
	end choose
	return 1

// dw_viewheader.itemfocuschanged(long row, dwobject dwo) returns long [event]
	selecttext(1, len(gettext()))
	if parent.ib_rowvalidated = false and parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_viewheader.itemchanged(long row, dwobject dwo, string data) returns long [event]
	integer li_errcode
	choose case dwo.name
	case "optionname"
		parent.ib_rowvalidated = false
		parent.il_currrow = row
		li_errcode = 0
	case else
		parent.ib_rowvalidated = true
	end choose
	return li_errcode
