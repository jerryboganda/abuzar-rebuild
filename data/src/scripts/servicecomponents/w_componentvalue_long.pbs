// window w_componentvalue_long (servicecomponents)  ancestor: w_componentvalue_text

// w_componentvalue_long.of_getvalue() returns integer
	this.dw_value.object.value_t.text = of_get_caption(this.is_compvalue.code)
	this.dw_value.object.value[1] = long(this.is_compvalue.value)
	return 0

// w_componentvalue_long.of_setvalue() returns long
	this.dw_value.accepttext()
	this.is_compvalue.value = trim(string(this.dw_value.object.value[1]))
	return 0

// w_componentvalue_long.create() returns 0 [event]
	call super::create

// w_componentvalue_long.destroy() returns 0 [event]
	call super::destroy
