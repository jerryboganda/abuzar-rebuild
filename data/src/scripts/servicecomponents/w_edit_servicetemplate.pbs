// window w_edit_servicetemplate (servicecomponents)  ancestor: window

// w_edit_servicetemplate.ue_close(integer ai_status) returns 0 [event]
	closewithreturn(this, this.istr_template)

// w_edit_servicetemplate.create() returns 0 [event]
	this.dw_template = create dw_template
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.control = {this.dw_template, this.cb_cancel, this.cb_ok}

// w_edit_servicetemplate.destroy() returns 0 [event]
	destroy this.dw_template
	destroy this.cb_cancel
	destroy this.cb_ok

// w_edit_servicetemplate.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	this.dw_template.settransobject(sqlca)
	this.dw_template.insertrow(0)
	this.dw_template.scrolltorow(0)
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	w_edit_servicetemplate w_parent
	parent.istr_template.c_copyinvfrom = "N"
	w_parent = getparent()
	w_parent.setfocus()
	parent.post event ue_close(1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	if isnull(parent.dw_template.getitemnumber(1, "servicetemplatecode")) then
		return ::message.returnvalue
	end if
	parent.istr_template.c_copyinvfrom = "T"
	parent.istr_template.l_invtemplate = parent.dw_template.getitemnumber(1, "servicetemplatecode")
	parent.post event ue_close(1)
	return ::message.returnvalue
