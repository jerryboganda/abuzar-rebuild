// window w_servicecomponenttype_form (servicecomponents)  ancestor: w_single_entry

// w_servicecomponenttype_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	long ll_code
	boolean b_flag
	if this.id_detail.rowcount() > 0 then
		ll_code = this.id_detail.object.code[this.id_detail.rowcount()]
	end if
	as_name = trim(as_name)
	if isnull(ll_code) or ll_code = 0 then
		SQL SELECT count ( *) INTO :ll_count FROM ServiceComponentType WHERE name =:as_name USING sqlca;
	else
		SQL SELECT count ( *) INTO :ll_count FROM ServiceComponentType WHERE name =:as_name AND ServiceComponentTypeCode <> :ll_code USING sqlca;
	end if
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_servicecomponenttype_form.create() returns 0
	call super::create

// w_servicecomponenttype_form.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_servicecomponenttype_form.activate() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_servicecomponenttype_form.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "ServiceComponentType"
	return ::message.returnvalue
