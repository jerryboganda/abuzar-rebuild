// window w_service_form (servicecomponents)  ancestor: w_multi_entry

// w_service_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM Service WHERE Service.name =:as_name USING this.it_transobject;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_service_form.wf_validateitem() returns integer
	long ll_icode
	integer li_errcode
	string ls_managername
	integer li_null
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "servicecomponentcode")
	if vf_dwdupcode1(this.id_detail, "servicecomponentcode", string(ll_icode), this.il_currrow) = true then
		ls_managername = ""
		messagebox("Duplication Error", "Current row is duplicate")
		li_errcode = -1
	else
		li_errcode = 0
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		setnull(li_null)
		this.id_detail.setcolumn("servicecomponentcode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.servicecomponentcode[this.il_currrow] = li_null
	else
		li_errcode = wf_getserviceinfo(ll_icode, this.il_currrow)
	end if
	return li_errcode

// w_service_form.wf_getserviceinfo(long al_code, long al_row) returns long
	double ld_saleprice
	double ld_costprice
	string ls_printonserviceresult
	long ll_retcode
	SQL SELECT SalePrice , CostPrice , PrintOnServiceResult INTO :ld_saleprice, :ld_costprice, :ls_printonserviceresult FROM DBO.ServiceComponent WHERE ServiceComponentCode =:al_code USING sqlca;
	if sqlca.sqlcode = 0 then
		ll_retcode = 0
		this.id_detail.object.saleprice[al_row] = ld_saleprice
		this.id_detail.object.costprice[al_row] = ld_costprice
		this.id_detail.object.printonreport[al_row] = ls_printonserviceresult
	else
		messagebox("Service Info. Retrieval Error", "Problem in retrieval of Service Information.~r~nReasons are:-" + sqlca.sqlerrtext, stopsign!)
		ll_retcode = 1
	end if
	return ll_retcode

// w_service_form.wf_set_service_sample_req() returns long
	s_dw_header lstr_header
	lstr_header.dw_header = this.id_servicesample_req
	lstr_header.l_code = this.id_master.object.code[this.id_master.getrow()]
	openwithparm(w_servicesamplerequirement_form, lstr_header)
	return 0

// w_service_form.wf_validate_service_result_tempalate(long al_code) returns long
	double ld_saleprice
	double ld_costprice
	long ll_retcode
	long ll_servicecode
	long ll_servicecode_retrieve
	if this.id_detail.object.code[1] > 0 then
		ll_servicecode = this.id_detail.object.code[1]
		SQL SELECT MAX ( ServiceCode ) INTO :ll_servicecode_retrieve FROM ServiceDetail SD , ServiceResultDetail SRD WHERE SRD.ServiceResultCode =:al_code AND SRD.ServiceRowID =SD.SrvRowID AND SD.ServiceCode =:ll_servicecode USING sqlca;
		if sqlca.sqlcode = 0 then
			if ll_servicecode_retrieve > 0 and ll_servicecode_retrieve = ll_servicecode then
				ll_retcode = 0
			else
				messagebox("Service Result Validation", "The Selected Service Result Does not conatin this service.", stopsign!)
				ll_retcode = 1
			end if
		else
			messagebox("Service Result Validation", "Problem in retrieval of Service Result Information.~r~nReasons are:-" + sqlca.sqlerrtext, stopsign!)
			ll_retcode = 1
		end if
		return ll_retcode
	end if
	return 1

// w_service_form.wf_duplicatealiasname(string as_aliasname) returns boolean
	long ll_count
	boolean b_flag
	as_aliasname = trim(as_aliasname)
	SQL SELECT count ( *) INTO :ll_count FROM Service WHERE Service.aliasname =:as_aliasname USING this.it_transobject;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_service_form.wf_show_consumables() returns long
	s_dw_header lstr_header
	lstr_header.dw_header = this.id_consumables
	lstr_header.l_code = this.id_master.object.code[this.id_master.getrow()]
	openwithparm(w_serviceconsumableitem_form, lstr_header)
	return 0

// w_service_form.wf_show_serviceticketsettings() returns long
	s_serviceticketsetting ls_serviceticketsetting
	if this.tab_retrieve.selectedtab = 1 and this.id_master.rowcount() > 0 and this.id_master.object.ticketrequired[1] = "Y" then
		ls_serviceticketsetting.l_tickets = this.id_master.object.ticketstogenerate[1]
		ls_serviceticketsetting.l_interval = this.id_master.object.ticketintervalindays[1]
		ls_serviceticketsetting.l_expiry = this.id_master.object.ticketexpiryindays[1]
		openwithparm(w_serviceticketsettings, ls_serviceticketsetting)
		ls_serviceticketsetting = message.powerobjectparm
		if ls_serviceticketsetting.b_status = true then
			this.id_master.object.ticketstogenerate[1] = ls_serviceticketsetting.l_tickets
			this.id_master.object.ticketintervalindays[1] = ls_serviceticketsetting.l_interval
			this.id_master.object.ticketexpiryindays[1] = ls_serviceticketsetting.l_expiry
		end if
	end if
	return 0

// w_service_form.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_srvmenu" then
		this.menuid = create m_srvmenu
	end if
	this.dw_service_sample_req = create dw_service_sample_req
	this.dw_consumables = create dw_consumables
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_service_sample_req
	this.control[icurrent + 2] = this.dw_consumables

// w_service_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_service_sample_req
	destroy this.dw_consumables

// w_service_form.ue_save() returns 0 [event]
	long ll_mastercurrrow
	long ll_invid
	long ll_detailrows
	integer li_counter
	integer ll_servicecomponentcode
	boolean lb_commitflag
	dwitemstatus lds_rowstatus
	if this.id_detail.rowcount() > 0 and isnull(this.id_detail.object.servicecomponentcode[1]) then
		this.id_detail.setrow(1)
		this.id_detail.scrolltorow(1)
		event ue_deleteitem()
	end if
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	setpointer(hourglass!)
	ll_mastercurrrow = this.id_master.getrow()
	ll_invid = this.id_master.object.code[ll_mastercurrrow]
	if isnull(ll_invid) then
		f_newtableid("service", ll_invid)
		this.id_master.object.code[ll_mastercurrrow] = ll_invid
	end if
	if isnull(this.id_master.object.aliasname[ll_mastercurrrow]) or this.id_master.object.aliasname[ll_mastercurrrow] = "" then
		this.id_master.object.aliasname[ll_mastercurrrow] = trim(string(ll_invid))
	end if
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	do while li_counter <= ll_detailrows and lb_commitflag = true
		lds_rowstatus = this.id_detail.getitemstatus(li_counter, 0, primary!)
		if lds_rowstatus = newmodified! then
			this.id_detail.setitem(li_counter, "code", ll_invid)
		end if
		li_counter = li_counter + 1
	loop
	for li_counter = 1 to li_counter
		if lb_commitflag = true then
			this.id_servicesample_req.setitem(li_counter, "servicecode", ll_invid)
		end if
	next
	for li_counter = 1 to li_counter
		if lb_commitflag = true then
			this.id_consumables.setitem(li_counter, "servicecode", ll_invid)
		end if
	next
	if this.id_master.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return
	end if
	if this.id_detail.update() > 0 then
		if this.id_servicesample_req.update() > 0 then
			if this.id_consumables.update() > 0 then
				SQL commit USING this.it_transobject;
				messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
				this.ib_commitok = true
				this.id_master.resetupdate()
				this.im_menu.m_file.m_new.enabled = true
				this.editflag = false
				if gd_recenttransdate < this.id_systemdate then
					gd_recenttransdate = this.id_systemdate
				end if
			else
				SQL rollback USING this.it_transobject;
				messagebox("Database Problem", "Some Database Problem Occured in saving service consumables list!", stopsign!)
				setpointer(arrow!)
				return
			end if
		else
			SQL rollback USING this.it_transobject;
			messagebox("Database Problem", "Some Database Problem Occured in saving service sample requirements!", stopsign!)
			setpointer(arrow!)
			return
		end if
	else
		SQL rollback USING this.it_transobject;
		messagebox("Database Problem", "Some Database Problem Occured in saving Service Component Detail!", stopsign!)
		setpointer(arrow!)
		return
	end if
	setpointer(arrow!)

// w_service_form.ue_newform() returns 0 [event]
	m_srvmenu lm_menu
	call super::ue_newform
	lm_menu = this.menuid
	this.id_master.setfocus()
	this.id_servicesample_req.reset()
	this.id_consumables.reset()
	this.id_master.object.serviceresulttemplate_t.visible = false
	this.id_master.object.serviceresulttemplate.visible = false
	this.id_master.object.active_t.visible = false
	this.id_master.object.active.visible = false
	if f_stringpreferences("showservicecomponentsinbasicdata") = "Y" then
		return
	end if
	lm_menu.m_item.m_newitem.enabled = false
	lm_menu.m_item.m_deleteitem.enabled = false

// w_service_form.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.insertrow(0)
	this.id_detail.setcolumn("servicecomponentcode")
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.ib_validatefullcode = true
	if this.id_detail.rowcount() > 1 then
		this.id_detail.object.servicehead[ll_rowcount] = this.id_detail.object.servicehead[ll_rowcount - 1]
	end if

// w_service_form.ue_detail() returns 0 [event]
	integer li_isvisible
	call super::ue_detail
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_delete.enabled = true
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true
	if this.id_master.rowcount() > 0 then
		this.id_servicesample_req.retrieve(this.id_master.object.code[this.id_master.rowcount()])
		this.id_consumables.retrieve(this.id_master.object.code[this.id_master.rowcount()])
	end if
	SQL Select visibility INTO :li_isvisible FROM interfacesetting WHERE Moduleid =41 and colname ='serviceresulttemplate' USING sqlca;
	if li_isvisible = 1 then
		this.id_master.object.serviceresulttemplate_t.visible = true
		this.id_master.object.serviceresulttemplate.visible = true
	else
		this.id_master.object.serviceresulttemplate_t.visible = false
		this.id_master.object.serviceresulttemplate.visible = false
	end if
	SQL Select visibility INTO :li_isvisible FROM interfacesetting WHERE Moduleid =41 and colname ='active' USING sqlca;
	if li_isvisible = 1 then
		this.id_master.object.active_t.visible = true
		this.id_master.object.active.visible = true
		return
	end if
	this.id_master.object.active_t.visible = false
	this.id_master.object.active.visible = false

// w_service_form.ue_postopen() returns 0 [event]
	integer li_visiblecolumns
	integer li_counter
	integer li_taborder
	m_srvmenu lm_menu
	datastore lds_itemsetting
	call super::ue_postopen
	lm_menu = this.menuid
	this.id_detail.getchild("servicecomponentcode", this.idc_servicecomponent)
	this.idc_servicecomponent.settransobject(this.it_transobject)
	this.id_servicesample_req = this.dw_service_sample_req
	this.id_servicesample_req.settransobject(this.it_transobject)
	this.id_consumables = this.dw_consumables
	this.id_consumables.settransobject(this.it_transobject)
	lds_itemsetting = create datastore
	lds_itemsetting.dataobject = "d_interfacesettingcols"
	lds_itemsetting.settransobject(this.it_transobject)
	lds_itemsetting.retrieve(41, 1, 1)
	li_visiblecolumns = lds_itemsetting.rowcount()
	for li_counter = 1 to li_counter
		this.colname[li_counter, 1] = lds_itemsetting.getitemstring(li_counter, "colname") + "_t"
		this.colname[li_counter, 2] = lds_itemsetting.getitemstring(li_counter, "colname")
	next
	li_taborder = 10
	li_counter = 1
	do while li_counter <= li_visiblecolumns
		this.id_master.modify(this.colname[li_counter, 1] + ".Visible=1")
		this.id_master.modify(this.colname[li_counter, 2] + ".Visible=1")
		li_taborder = li_taborder + 1
		li_counter = li_counter + 1
	loop
	if this.id_master.object.processdays.visible = "1" then
		this.id_master.object.t_deadline.visible = true
	else
		this.id_master.object.t_deadline.visible = false
	end if
	if f_stringpreferences("showservicecomponentsinbasicdata") = "Y" then
		this.id_detail.visible = true
		return
	end if
	this.id_detail.visible = false
	lm_menu.m_item.m_newitem.enabled = false
	lm_menu.m_item.m_deleteitem.enabled = false

// w_service_form.ue_deleteitem() returns 0 [event]
	long ll_currow
	long ll_detailrows
	this.ib_itemvalidated = true
	this.id_detail.deleterow(0)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows < 0 then
		this.im_menu.m_file.m_save.enabled = false
	end if
	wf_grandtotal()

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "name"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	end choose
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "name"
		if parent.parent.parent.wf_duplicatename(data) then
			messagebox("Name Validation", "Duplication Name Error~n~rPlease Choose Some Other Name")
			return 1
		end if
	case "aliasname"
		if isnull(data) or data = "" then
			return 0
		elseif parent.parent.parent.wf_duplicatealiasname(data) then
			messagebox("Alias Name Validation", "Duplication Alias Name Error~n~rPlease Choose Some Other Valid Alias Name")
			return 1
		end if
	case "serviceresulttemplate"
		if isnull(data) or data = "" then
			return 0
		elseif long(data) < 0 then
			messagebox("Service Result Template Validation", "Please Choose Some Valid Service Result Template ")
			return 1
		else
			return parent.parent.parent.wf_validate_service_result_tempalate(long(data))
		end if
		return
	end choose
	return ::message.returnvalue

// dw_detail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	choose case dwo.name
	case "b_samplereq"
		parent.parent.parent.wf_set_service_sample_req()
	case "b_consumables"
		parent.parent.parent.wf_show_consumables()
	end choose
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	string ls_managername
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "servicecomponentcode"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_itemvalidated = false
		li_errcode = 0
	case else
		parent.parent.parent.ib_itemvalidated = true
	end choose
	return li_errcode

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "servicecomponent"
		if data = "" or isnull(data) then
			messagebox("Service Component Validation", "Value required Service Component in current row")
		end if
	end choose
	return 1

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		parent.parent.parent.event ue_newitem()
		setcolumn("servicecomponentcode")
		setfocus()
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1
