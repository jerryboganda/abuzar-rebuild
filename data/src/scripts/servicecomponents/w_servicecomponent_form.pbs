// window w_servicecomponent_form (servicecomponents)  ancestor: w_multi_entry

// w_servicecomponent_form.wf_find_patient_regno(long al_patientcode, string as_regno) returns long
	long ll_retflag
	char lc_active
	ll_retflag = 0
	SQL SELECT patient.regno , patient.active INTO :as_regno, :lc_active FROM patient WHERE patient.patientcode =:al_patientcode and patientcatcode in ( select distinct patientcatcode from patientcatallowedmodule where moduleid =:this.ii_module ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(as_regno) then
			ll_retflag = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
		else
			ll_retflag = -2
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_servicecomponent_form.wf_findpatientcode(string as_regno, long al_patientcode) returns long
	long ll_patientcode
	long ll_retflag
	string ls_itemname
	char lc_active
	ll_retflag = 0
	SQL SELECT patient.patientcode , patient.active INTO :ll_patientcode, :lc_active FROM patient WHERE patient.regno =:as_regno and patientcatcode in ( select distinct patientcatcode from patientcatallowedmodule where moduleid =:this.ii_module ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_patientcode = ll_patientcode
		if isnull(al_patientcode) then
			ll_retflag = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
		else
			ll_retflag = -2
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_servicecomponent_form.wf_retrieve_appointments(long al_doctcode) returns long
	long ll_rtncode
	return ll_rtncode

// w_servicecomponent_form.wf_lockvisits(long al_sinvcode, long al_linvcode, long al_totalcount) returns long
	SQL Select count ( *) INTO :al_totalcount From Visit WITH ( UPDLOCK HOLDLOCK ) Where VisitCode Between :al_sinvcode AND :al_linvcode AND Posted ='N' USING sqlca;
	return sqlca.sqlcode

// w_servicecomponent_form.wf_post() returns long
	integer ll_errcode
	long ll_usercode
	long ll_postcount
	long ll_counter
	boolean lb_flag
	s_arguements lstr_arginfo
	if this.tab_retrieve.selectedtab = 1 then
		return 0
	end if
	open(w_salesmanpassword)
	ll_usercode = long(message.doubleparm)
	setfocus()
	if ll_usercode > 0 then
		open(w_arg_sinvcode_linvcode_onedoctor)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			ll_errcode = wf_lockvisits(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_postcount)
			if ll_errcode = 0 then
				sqlca.postvisit(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_usercode, lstr_arginfo.l_code3)
				if sqlca.sqlcode <> 0 then
					ll_errcode = -1
				end if
			end if
		end if
		if ll_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				ll_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_usercode > 0 then
		if ll_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again")
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_postcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return ll_errcode

// w_servicecomponent_form.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_servicecomponent_form.wf_initmodify(integer ai_protect) returns 0
	long ll_code
	long ll_counter
	long ll_count
	ll_code = this.id_master.getitemnumber(1, "code")
	this.id_master.retrieve(ll_code)
	this.id_options.retrieve(ll_code)
	this.id_refvalue.retrieve(ll_code)
	this.id_comments.retrieve(ll_code)
	if ai_protect = 0 then
		this.ib_modify = true
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_new.enabled = false
		this.im_menu.m_file.m_delete.enabled = false
		this.im_menu.m_item.m_newitem.enabled = false
		this.im_menu.m_item.m_deleteitem.enabled = false
		this.im_menu.m_file.m_first.enabled = false
		this.im_menu.m_file.m_next.enabled = false
		this.im_menu.m_file.m_previous.enabled = false
		this.im_menu.m_file.m_last.enabled = false
		this.im_menu.m_file.m_retrieve.enabled = true
		this.im_menu.m_file.m_retrieve.text = "Lis&t"
		this.tab_retrieve.tabpage_detail.enabled = true
	end if

// w_servicecomponent_form.wf_patientsearch() returns string
	string ls_regno
	long ll_res
	long ll_null
	s_arguements ls_arguements
	setnull(ll_null)
	open(w_patientsearch)
	ls_arguements = message.powerobjectparm
	if ls_arguements.i_status = 1 then
		openwithparm(w_patientsearchresult, ls_arguements)
		ls_arguements = message.powerobjectparm
		if ls_arguements.i_status = 1 and ls_arguements.l_code1 > 0 then
			ll_res = wf_find_patient_regno(ls_arguements.l_code1, ls_regno)
			this.id_master.object.appointmentcode[this.id_master.rowcount()] = ll_null
			this.id_master.object.patientcode[this.id_master.rowcount()] = ls_arguements.l_code1
			this.id_master.object.regno[this.id_master.rowcount()] = ls_regno
		end if
	end if
	return ls_regno

// w_servicecomponent_form.wf_lockvisit(long al_visitcode) returns long
	integer li_count
	this.it_transobject.dbparm = " Async =1, DBGetTime = 20"
	this.it_transobject.lockvisit(al_visitcode)
	this.it_transobject.dbparm = "Async =0, DBGetTime = 0"
	return this.it_transobject.sqlcode

// w_servicecomponent_form.wf_show_options() returns long
	long ll_counter
	long ll_code
	long ll_row
	s_values_blob lstr_values_blob
	lstr_values_blob.s_name = this.is_valuetype
	for ll_counter = 1 to this.id_options.rowcount()
		lstr_values_blob.ls_value[ll_counter, 1] = trim(string(this.id_options.object.optionid[ll_counter]))
		if this.is_valuetype = "D" then
			lstr_values_blob.ls_value[ll_counter, 2] = trim(string(double(this.id_options.object.optionname[ll_counter])))
		elseif this.is_valuetype = "N" then
			lstr_values_blob.ls_value[ll_counter, 2] = trim(string(long(this.id_options.object.optionname[ll_counter])))
		else
			lstr_values_blob.ls_value[ll_counter, 2] = this.id_options.object.optionname[ll_counter]
		end if
	next
	for ll_counter = 1 to 200
		if long(lstr_values_blob.ls_value[ll_counter, 1]) <= 0 then
			lstr_values_blob.ls_value[ll_counter, 1] = "-1"
		end if
	next
	openwithparm(w_servicecomponent_options, lstr_values_blob)
	lstr_values_blob = message.powerobjectparm
	if lstr_values_blob.i_closemode = 1 then
		this.id_options.reset()
		ll_code = this.id_master.object.code[this.id_master.rowcount()]
		for ll_counter = 1 to 200
			if long(lstr_values_blob.ls_value[ll_counter, 1]) > 0 then
				ll_row = this.id_options.insertrow(0)
				this.id_options.object.code[ll_row] = this.id_master.object.code[this.id_master.rowcount()]
				this.id_options.object.optionid[ll_row] = long(lstr_values_blob.ls_value[ll_counter, 1])
				if this.is_valuetype = "D" then
					this.id_options.object.optionname[ll_row] = trim(string(double(lstr_values_blob.ls_value[ll_counter, 2])))
				elseif this.is_valuetype = "N" then
					this.id_options.object.optionname[ll_row] = trim(string(long(lstr_values_blob.ls_value[ll_counter, 2])))
				else
					this.id_options.object.optionname[ll_row] = lstr_values_blob.ls_value[ll_counter, 2]
				end if
			end if
		next
	end if
	return 0

// w_servicecomponent_form.wf_show_refvalue() returns long
	long ll_counter
	long ll_code
	long ll_row
	s_values_blob lstr_values_blob
	lstr_values_blob.s_name = this.is_valuetype
	for ll_counter = 1 to this.id_refvalue.rowcount()
		lstr_values_blob.ls_value[ll_counter, 1] = this.id_refvalue.object.gender[ll_counter]
		lstr_values_blob.ls_value[ll_counter, 2] = this.id_refvalue.object.ageunit[ll_counter]
		lstr_values_blob.ls_value[ll_counter, 3] = trim(string(this.id_refvalue.object.gestationcode[ll_counter]))
		lstr_values_blob.ls_value[ll_counter, 4] = trim(string(this.id_refvalue.object.testmachinecode[ll_counter]))
		lstr_values_blob.ls_value[ll_counter, 5] = trim(string(this.id_refvalue.object.loweragelimit[ll_counter]))
		lstr_values_blob.ls_value[ll_counter, 6] = trim(string(this.id_refvalue.object.upperagelimit[ll_counter]))
		if this.is_valuetype = "D" then
			lstr_values_blob.ls_value[ll_counter, 7] = trim(string(double(this.id_refvalue.object.lowerreferencevalue[ll_counter])))
			lstr_values_blob.ls_value[ll_counter, 8] = trim(string(double(this.id_refvalue.object.upperreferencevalue[ll_counter])))
		elseif this.is_valuetype = "N" then
			lstr_values_blob.ls_value[ll_counter, 7] = trim(string(long(this.id_refvalue.object.lowerreferencevalue[ll_counter])))
			lstr_values_blob.ls_value[ll_counter, 8] = trim(string(long(this.id_refvalue.object.upperreferencevalue[ll_counter])))
		else
			lstr_values_blob.ls_value[ll_counter, 7] = this.id_refvalue.object.lowerreferencevalue[ll_counter]
			lstr_values_blob.ls_value[ll_counter, 8] = this.id_refvalue.object.upperreferencevalue[ll_counter]
		end if
		lstr_values_blob.ls_value[ll_counter, 9] = trim(string(this.id_refvalue.object.rowid[ll_counter]))
	next
	for ll_counter = 1 to 200
		if long(lstr_values_blob.ls_value[ll_counter, 9]) <= 0 then
			lstr_values_blob.ls_value[ll_counter, 9] = "-1"
		end if
	next
	openwithparm(w_servicecomponent_refvalue, lstr_values_blob)
	lstr_values_blob = message.powerobjectparm
	if lstr_values_blob.i_closemode = 1 then
		this.id_refvalue.reset()
		ll_code = this.id_master.object.code[this.id_master.rowcount()]
		for ll_counter = 1 to 200
			if long(lstr_values_blob.ls_value[ll_counter, 9]) > 0 then
				ll_row = this.id_refvalue.insertrow(0)
				this.id_refvalue.object.code[ll_row] = ll_code
				this.id_refvalue.object.gender[ll_row] = lstr_values_blob.ls_value[ll_counter, 1]
				this.id_refvalue.object.ageunit[ll_row] = lstr_values_blob.ls_value[ll_counter, 2]
				this.id_refvalue.object.gestationcode[ll_row] = long(lstr_values_blob.ls_value[ll_counter, 3])
				this.id_refvalue.object.testmachinecode[ll_row] = long(lstr_values_blob.ls_value[ll_counter, 4])
				this.id_refvalue.object.loweragelimit[ll_row] = long(lstr_values_blob.ls_value[ll_counter, 5])
				this.id_refvalue.object.upperagelimit[ll_row] = long(lstr_values_blob.ls_value[ll_counter, 6])
				if this.is_valuetype = "D" then
					this.id_refvalue.object.lowerreferencevalue[ll_row] = trim(string(double(lstr_values_blob.ls_value[ll_counter, 7])))
					this.id_refvalue.object.upperreferencevalue[ll_row] = trim(string(double(lstr_values_blob.ls_value[ll_counter, 8])))
				elseif this.is_valuetype = "N" then
					this.id_refvalue.object.lowerreferencevalue[ll_row] = trim(string(long(lstr_values_blob.ls_value[ll_counter, 7])))
					this.id_refvalue.object.upperreferencevalue[ll_row] = trim(string(long(lstr_values_blob.ls_value[ll_counter, 8])))
				else
					this.id_refvalue.object.lowerreferencevalue[ll_row] = lstr_values_blob.ls_value[ll_counter, 7]
					this.id_refvalue.object.upperreferencevalue[ll_row] = lstr_values_blob.ls_value[ll_counter, 8]
				end if
				this.id_refvalue.object.rowid[ll_row] = long(lstr_values_blob.ls_value[ll_counter, 9])
			end if
		next
	end if
	return 0

// w_servicecomponent_form.wf_show_comments() returns long
	long ll_counter
	long ll_code
	long ll_row
	s_comments lstr_comments
	for ll_counter = 1 to this.id_comments.rowcount()
		lstr_comments.ls_value[ll_counter, 1] = trim(string(this.id_comments.object.rowid[ll_counter]))
		lstr_comments.ls_value[ll_counter, 2] = this.id_comments.object.description[ll_counter]
		lstr_comments.ls_value[ll_counter, 3] = this.id_comments.object.comments[ll_counter]
	next
	openwithparm(w_servicecomponent_comments, lstr_comments)
	lstr_comments = message.powerobjectparm
	if lstr_comments.i_closemode = 1 then
		this.id_comments.reset()
		ll_code = this.id_master.object.code[this.id_master.rowcount()]
		for ll_counter = 1 to 200
			if long(lstr_comments.ls_value[ll_counter, 1]) > 0 then
				ll_row = this.id_comments.insertrow(0)
				this.id_comments.object.code[ll_row] = ll_code
				this.id_comments.object.rowid[ll_row] = long(lstr_comments.ls_value[ll_counter, 1])
				this.id_comments.object.description[ll_row] = lstr_comments.ls_value[ll_counter, 2]
				this.id_comments.object.comments[ll_row] = lstr_comments.ls_value[ll_counter, 3]
			end if
		next
	end if
	return 0

// w_servicecomponent_form.wf_apply_servicecomponentunit(long al_code) returns long
	long ll_found
	long ll_null
	string ls_null
	setnull(ll_null)
	setnull(ls_null)
	ll_found = 0
	ll_found = this.idc_servicecomponentunit.find("servicecomponentunitcode = " + string(al_code) + "", 1, this.idc_servicecomponentunit.rowcount())
	if ll_found > 0 then
		if this.id_master.rowcount() > 0 then
			this.is_valuetype = this.idc_servicecomponentunit.getitemstring(ll_found, "valuetype")
		end if
	else
		this.is_valuetype = "S"
	end if
	if this.is_valuetype = "" or isnull(this.is_valuetype) then
		this.is_valuetype = "S"
	end if
	return 0

// w_servicecomponent_form.wf_apply_servicecomponenttype(long al_code) returns long
	long ll_found
	long ll_null
	string ls_null
	integer li_null
	setnull(ll_null)
	setnull(ls_null)
	setnull(li_null)
	ll_found = 0
	ll_found = this.idc_servicecomponenttype.find("servicecomponenttypecode = " + string(al_code) + "", 1, this.idc_servicecomponenttype.rowcount())
	if ll_found > 0 and this.id_master.rowcount() > 0 then
		this.is_askunit = this.idc_servicecomponenttype.getitemstring(ll_found, "askunit")
		this.is_askcomments = this.idc_servicecomponenttype.getitemstring(ll_found, "askcomments")
		this.is_askrefrange = this.idc_servicecomponenttype.getitemstring(ll_found, "askrefrange")
		this.is_askoptions = this.idc_servicecomponenttype.getitemstring(ll_found, "askoptions")
	end if
	if upper(this.is_askunit) = "Y" then
		this.id_master.object.servicecomponentunitcode.visible = true
		this.id_master.object.servicecomponentunitcode_t.visible = true
	else
		this.id_master.object.servicecomponentunitcode.visible = false
		this.id_master.object.servicecomponentunitcode_t.visible = false
		this.id_master.object.servicecomponentunitcode[1] = li_null
		this.is_valuetype = "S"
	end if
	if upper(this.is_askrefrange) = "Y" then
		this.id_footer.object.b_refvalue.visible = true
	else
		this.id_footer.object.b_refvalue.visible = false
	end if
	if upper(this.is_askoptions) = "Y" then
		this.id_footer.object.b_options.visible = true
	else
		this.id_footer.object.b_options.visible = false
	end if
	if upper(this.is_askcomments) = "Y" then
		this.id_footer.object.b_comments.visible = true
	else
		this.id_footer.object.b_comments.visible = false
	end if
	return 0

// w_servicecomponent_form.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_visitmenu" then
		this.menuid = create m_visitmenu
	end if
	this.dw_hidden_comments = create dw_hidden_comments
	this.dw_hidden_refvalue = create dw_hidden_refvalue
	this.dw_hidden_options = create dw_hidden_options
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_hidden_comments
	this.control[icurrent + 2] = this.dw_hidden_refvalue
	this.control[icurrent + 3] = this.dw_hidden_options

// w_servicecomponent_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_hidden_comments
	destroy this.dw_hidden_refvalue
	destroy this.dw_hidden_options

// w_servicecomponent_form.open() returns long [event]
	m_entry lm_menu
	long ll_width
	long ll_height
	environment env
	postevent("ue_postopen")
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	lm_menu.dynamic mf_initsecurityapp(lm_menu)
	if getenvironment(env) <> 1 then
		return ::message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.tab_retrieve.width = ll_width * 0.99
	this.tab_retrieve.height = ll_height * 0.83
	this.tab_retrieve.tabpage_detail.dw_detail.width = ll_width * 0.97
	this.tab_retrieve.tabpage_detail.dw_footer.width = ll_width * 0.97
	this.tab_retrieve.tabpage_detail.dw_footer.y = this.tab_retrieve.height * 0.90 - this.tab_retrieve.tabpage_detail.dw_footer.height
	this.tab_retrieve.tabpage_detail.dw_detail.height = this.tab_retrieve.tabpage_detail.dw_footer.y - this.tab_retrieve.tabpage_detail.dw_detail.y - 5
	this.tab_retrieve.tabpage_list.gb_fliter.width = ll_width * 0.97 - this.tab_retrieve.tabpage_list.gb_sort.width
	this.tab_retrieve.tabpage_list.r_1.width = ll_width * 0.99
	this.tab_retrieve.tabpage_list.r_1.height = ll_height * 0.765 - this.tab_retrieve.tabpage_list.gb_sort.height
	this.tab_retrieve.tabpage_list.dw_list.width = ll_width * 0.98
	this.tab_retrieve.tabpage_list.dw_list.height = ll_height * 0.75 - this.tab_retrieve.tabpage_list.dw_list.y
	this.tab_retrieve.tabpage_detail.dw_itemslist.height = ll_height * 0.6
	this.tab_retrieve.tabpage_detail.dw_itemslist.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width * 0.73
	setredraw(true)
	return ::message.returnvalue

// w_servicecomponent_form.ue_postopen() returns 0 [event]
	long ll_rtncode
	setredraw(false)
	wf_connect()
	this.id_master = this.tab_retrieve.tabpage_detail.dw_detail
	this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
	this.id_footer = this.tab_retrieve.tabpage_detail.dw_footer
	this.id_list = this.tab_retrieve.tabpage_list.dw_list
	this.id_itemslist = this.tab_retrieve.tabpage_detail.dw_itemslist
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_itemslist.settransobject(this.it_transobject)
	this.id_options = this.tab_retrieve.tabpage_detail.dw_options
	this.id_comments = this.tab_retrieve.tabpage_detail.dw_comments
	this.id_refvalue = this.tab_retrieve.tabpage_detail.dw_refvalue
	this.id_hidden_options = this.dw_hidden_options
	this.id_hidden_options.settransobject(this.it_transobject)
	this.id_hidden_refvalue = this.dw_hidden_refvalue
	this.id_hidden_refvalue.settransobject(this.it_transobject)
	this.id_hidden_comments = this.dw_hidden_comments
	this.id_hidden_comments.settransobject(this.it_transobject)
	this.id_dwcontrol = this.id_list
	post wf_populate_ddlb(this.id_dwcontrol)
	this.tab_retrieve.tabpage_list.dw_find.settransobject(this.it_transobject)
	this.id_master.setfocus()
	setredraw(true)
	ll_rtncode = this.id_master.getchild("servicecomponentunitcode", this.idc_servicecomponentunit)
	if ll_rtncode = -1 then
		messagebox("Service Component Unit", "Problem in Retrieving Service Component Unit")
		close(this)
		return
	end if
	this.idc_servicecomponentunit.settransobject(this.it_transobject)
	ll_rtncode = this.idc_servicecomponentunit.retrieve()
	if ll_rtncode < 0 then
		messagebox("Service Component Unit", "Not Enough Service Component Unit exist in database~r~nPlease contact your system administrator")
		close(this)
		return
	end if
	ll_rtncode = this.id_master.getchild("servicecomponenttypecode", this.idc_servicecomponenttype)
	if ll_rtncode = -1 then
		messagebox("Service Component Type", "Problem in Retrieving Service Component Type")
		close(this)
		return
	end if
	this.idc_servicecomponenttype.settransobject(this.it_transobject)
	ll_rtncode = this.idc_servicecomponenttype.retrieve()
	if ll_rtncode < 0 then
		messagebox("Service Component Type", "Not Enough Service Component Type exist in database~r~nPlease contact your system administrator")
		close(this)
		return
	end if
	this.id_print = this.tab_retrieve.tabpage_detail.dw_print
	this.id_print.settransobject(sqlca)
	this.id_options.dataobject = "d_servicecomponent_options"
	this.id_options.settransobject(this.it_transobject)
	this.id_refvalue.dataobject = "d_servicecomponent_refvalue"
	this.id_refvalue.settransobject(this.it_transobject)
	this.id_comments.dataobject = "d_servicecomponent_comments"
	this.id_comments.settransobject(this.it_transobject)

// w_servicecomponent_form.ue_save() returns 0 [event]
	long ll_primarykey
	long ll_row
	long ll_counter
	long ll_usercode
	long ll_null
	long ll_primarycode_old
	datetime ldt_server_datetime
	string ls_date_errtext
	boolean lb_commit
	setnull(ll_null)
	setpointer(hourglass!)
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	ll_row = this.id_master.getrow()
	ll_primarykey = this.id_master.object.code[this.id_master.getrow()]
	ll_primarycode_old = ll_primarykey
	ll_usercode = gl_usercode
	if ll_usercode > 0 then
		if isnull(ll_primarykey) then
			ll_primarykey = 0
			SQL rollback USING this.it_transobject;
			wf_tabnewid("ServiceComponent", ll_primarykey)
			if this.it_transobject.sqlcode = 0 then
				this.id_master.setitem(ll_row, "code", ll_primarykey)
			else
				SQL rollback USING this.it_transobject;
				lb_commit = false
				messagebox("Service Component Saving Problem", "Problem in Auto Generation of Service Component Code~r~n Possibe Reason: " + this.it_transobject.sqlerrtext, stopsign!)
			end if
		end if
		if lb_commit and this.id_master.update(true, false) < 0 then
			SQL rollback USING this.it_transobject;
			lb_commit = false
			messagebox("Service Component Saving Problem", "Problem in updating Service Component.", stopsign!)
		end if
		if lb_commit then
			if this.id_options.rowcount() > 0 then
				for ll_counter = 1 to this.id_options.rowcount()
					this.id_options.object.code[ll_counter] = ll_primarykey
				next
			end if
			if this.ib_modify then
				SQL DELETE DBO.ServiceComponentOption WHERE ServiceComponentCode =:ll_primarykey USING this.it_transobject;
				if this.it_transobject.sqlcode <> 0 then
					SQL rollback USING this.it_transobject;
					lb_commit = false
					messagebox("Service Component Options", "Problem in Deleting Service Component Options.~r~nReasons are:-" + this.it_transobject.sqlerrtext, stopsign!)
				end if
			end if
			if lb_commit then
				this.id_hidden_options.reset()
				if this.id_options.rowcount() > 0 then
					this.id_options.rowscopy(1, this.id_options.rowcount(), primary!, this.id_hidden_options, 1, primary!)
				end if
				if this.id_hidden_options.update(true) < 0 then
					SQL rollback USING this.it_transobject;
					lb_commit = false
					messagebox("Service Component Options", "Problem in updating Service Component Options.", stopsign!)
				end if
			end if
		end if
		if lb_commit then
			if this.id_refvalue.rowcount() > 0 then
				for ll_counter = 1 to this.id_refvalue.rowcount()
					this.id_refvalue.object.code[ll_counter] = ll_primarykey
				next
			end if
			if this.ib_modify then
				SQL DELETE DBO.ServiceComponentRefValue WHERE ServiceComponentCode =:ll_primarykey USING this.it_transobject;
				if this.it_transobject.sqlcode <> 0 then
					SQL rollback USING this.it_transobject;
					lb_commit = false
					messagebox("Service Component Ref. Value", "Problem in deleting Service Component Ref. Values.~r~nReasons are:-" + this.it_transobject.sqlerrtext, stopsign!)
				end if
			end if
			if lb_commit then
				this.id_hidden_refvalue.reset()
				if this.id_refvalue.rowcount() > 0 then
					this.id_refvalue.rowscopy(1, this.id_refvalue.rowcount(), primary!, this.id_hidden_refvalue, 1, primary!)
				end if
				if this.id_hidden_refvalue.update(true) < 0 then
					SQL rollback USING this.it_transobject;
					lb_commit = false
					messagebox("Service Component Ref. Value", "Problem in updating Service Component Ref. Values.", stopsign!)
				end if
			end if
		end if
		if lb_commit then
			if this.id_comments.rowcount() > 0 then
				for ll_counter = 1 to this.id_comments.rowcount()
					this.id_comments.object.code[ll_counter] = ll_primarykey
				next
			end if
			if this.ib_modify then
				SQL DELETE DBO.ServiceComponentComment WHERE ServiceComponentCode =:ll_primarykey USING this.it_transobject;
				if this.it_transobject.sqlcode <> 0 then
					SQL rollback USING this.it_transobject;
					lb_commit = false
					messagebox("Service Component Comments", "Problem in deleting Service Component Comments.~r~nReasons are:-" + this.it_transobject.sqlerrtext, stopsign!)
				end if
			end if
			if lb_commit then
				this.id_hidden_comments.reset()
				if this.id_comments.rowcount() > 0 then
					this.id_comments.rowscopy(1, this.id_comments.rowcount(), primary!, this.id_hidden_comments, 1, primary!)
				end if
				if this.id_hidden_comments.update(true) < 0 then
					SQL rollback USING this.it_transobject;
					lb_commit = false
					messagebox("Service Component Comments", "Problem in updating Service Component Comments.", stopsign!)
				end if
			end if
		end if
		if lb_commit then
			SQL commit USING this.it_transobject;
			messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
			this.ib_commitok = true
			this.id_master.resetupdate()
			this.im_menu.m_file.m_new.enabled = true
			this.editflag = false
			this.id_hidden_options.reset()
			this.id_hidden_comments.reset()
			this.id_hidden_refvalue.reset()
			if gd_recenttransdate < this.id_systemdate then
				gd_recenttransdate = this.id_systemdate
			end if
		end if
	end if
	if isnull(ll_primarycode_old) then
		this.id_master.setitem(ll_row, "code", ll_null)
	end if
	setpointer(arrow!)

// w_servicecomponent_form.ue_newitem() returns 0 [event]

// w_servicecomponent_form.ue_newform() returns 0 [event]
	setredraw(false)
	this.i_editmode = 1
	this.i_retrievemode = 2
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_new.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_file.m_first.enabled = false
	this.im_menu.m_file.m_next.enabled = false
	this.im_menu.m_file.m_previous.enabled = false
	this.im_menu.m_file.m_last.enabled = false
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_retrieve.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.tab_retrieve.tabpage_detail.enabled = true
	if this.id_master.rowcount() > 0 then
		this.id_master.reset()
	end if
	this.ib_focusdetail = false
	this.id_master.insertrow(0)
	this.id_footer.insertrow(0)
	this.id_options.reset()
	this.id_refvalue.reset()
	this.id_comments.reset()
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	wf_apply_servicecomponenttype(this.id_master.object.servicecomponenttypecode[1])
	wf_apply_servicecomponentunit(this.id_master.object.servicecomponentunitcode[1])
	setredraw(true)

// w_servicecomponent_form.ue_detail() returns 0 [event]
	long ll_code
	integer li_protect
	boolean lb_modify
	call super::ue_detail
	if this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_post.enabled = false
	lb_modify = true
	if not lb_modify then
		this.im_menu.m_file.m_save.enabled = false
		this.editflag = false
	else
		this.editflag = true
		li_protect = 0
	end if
	wf_initmodify(li_protect)
	wf_apply_servicecomponenttype(this.id_master.object.servicecomponenttypecode[1])
	wf_apply_servicecomponentunit(this.id_master.object.servicecomponentunitcode[1])
	setredraw(true)

// w_servicecomponent_form.ue_list() returns 0 [event]
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_post.enabled = true
	this.im_menu.m_file.m_save.enabled = false

// w_servicecomponent_form.ue_print() returns 0 [event]
	long ll_code
	long ll_row
	long li_printretcode
	string ls_printsize
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_code) or ll_code <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_code = this.id_detail.getitemnumber(1, "code")
	end if
	this.id_print.retrieve(ll_code)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.id_print.rowcount() > 0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		li_printretcode = this.id_print.print()
		if li_printretcode < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print,~r~nNo rows are retrieved", information!)

// w_servicecomponent_form.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	this.idc_servicecomponentunit.retrieve()
	this.idc_servicecomponenttype.retrieve()

// tab_retrieve.selectionchanging(integer oldindex, integer newindex) returns long [event]
	integer li_yesno
	integer li_rtcode
	if oldindex = 1 and newindex = 2 and parent.editflag = true and parent.id_master.rowcount() > 0 then
		li_yesno = messagebox("Confirm Changes", "Yes to save changes that you've typed", question!, yesnocancel!, 2)
		if li_yesno = 1 then
			getparent().triggerevent("ue_save")
			if getparent().dynamic wf_commitform() = false then
				li_rtcode = 1
			end if
		elseif li_yesno = 3 then
			li_rtcode = 1
		else
			parent.editflag = false
			parent.i_editmode = 2
		end if
	end if
	return li_rtcode

// tabpage_detail.create() returns 0 [event]
	integer icurrent
	this.dw_print = create dw_print
	this.dw_options = create dw_options
	this.dw_refvalue = create dw_refvalue
	this.dw_comments = create dw_comments
	call super::create
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print
	this.control[icurrent + 2] = this.dw_options
	this.control[icurrent + 3] = this.dw_refvalue
	this.control[icurrent + 4] = this.dw_comments

// tabpage_detail.destroy() returns 0 [event]
	call super::destroy
	destroy this.dw_print
	destroy this.dw_options
	destroy this.dw_refvalue
	destroy this.dw_comments

// dw_footer.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	choose case dwo.name
	case "b_options"
		parent.parent.parent.wf_show_options()
	case "b_refvalue"
		parent.parent.parent.wf_show_refvalue()
	case "b_comments"
		parent.parent.parent.wf_show_comments()
	end choose
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long [event]
	if getcolumnname() <> "refdescription" then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_patientcode
	long ll_res
	long ll_found
	integer li_null
	datetime ldt_date_null
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ldt_date_null)
	setnull(li_null)
	choose case dwo.name
	case "servicecomponenttypecode"
		parent.parent.parent.wf_apply_servicecomponenttype(long(data))
	case "servicecomponentunitcode"
		parent.parent.parent.wf_apply_servicecomponentunit(long(data))
	end choose
	return ::message.returnvalue
