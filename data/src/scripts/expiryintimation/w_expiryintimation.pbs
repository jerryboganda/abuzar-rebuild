// w_expiryintimation.wf_delete_expiryintimation(long al_code) returns long
	SQL Delete ExpiryIntimationDetail Where IntimationCode =:al_code USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_expiryintimation.wf_lockintimation(long al_code) returns integer
	integer li_count
	this.it_transobject.dbparm = " Async =1, DBGetTime = 20"
	this.it_transobject.dbparm = "Async =0, DBGetTime = 0"
	return this.it_transobject.sqlcode

// w_expiryintimation.wf_gen_intimation_serialno(integer ai_intimationtype, long al_serialno, transaction at_transobject) returns long
	long ll_rtcode
	SQL SELECT COUNTER INTO :al_serialno FROM dbo.IntimationType WITH ( UPDLOCK HOLDLOCK ) WHERE IntimationTypeCode =:ai_intimationtype USING at_transobject;
	if at_transobject.sqlcode = 0 then
		al_serialno = al_serialno + 1
		SQL update dbo.IntimationType SET COUNTER =:al_serialno WHERE IntimationTypeCode =:ai_intimationtype USING at_transobject;
		if at_transobject.sqlcode < 0 then
			ll_rtcode = at_transobject.sqlcode
			al_serialno = 0
		end if
	else
		ll_rtcode = at_transobject.sqlcode
		al_serialno = 0
	end if
	return ll_rtcode

// w_expiryintimation.wf_set_accountinfo(long al_acccode) returns long
	string ls_address
	string ls_city
	string ls_phone
	string ls_aliasname
	string ls_name
	long ll_currow
	long ll_sitecode
	double ld_currbalance
	if this.ii_intimationtype = 1 then
		SQL SELECT accounts.name , supplier.address1 , supplier.city , supplier.phone , accounts.aliasname , supplier.sitecode INTO :ls_name, :ls_address, :ls_city, :ls_phone, :ls_aliasname, :ll_sitecode FROM supplier , Accounts WHERE supplier.suppcode =:al_acccode AND supplier.suppcode =Accounts.AccCode USING this.it_transobject;
	else
		SQL SELECT accounts.name , customer.address1 , customer.city , customer.phone , accounts.aliasname , customer.sitecode INTO :ls_name, :ls_address, :ls_city, :ls_phone, :ls_aliasname, :ll_sitecode FROM customer , Accounts WHERE customer.custcode =:al_acccode AND customer.custcode =Accounts.AccCode USING this.it_transobject;
	end if
	ll_currow = this.id_master.getrow()
	ll_currow = 1
	this.id_master.object.aliasname[ll_currow] = ls_aliasname
	this.id_master.object.targetsitecode[ll_currow] = ll_sitecode
	return 0

// w_expiryintimation.wf_findacccode(string as_aliasname, long al_acccode) returns long
	long ll_acccode
	long ll_retflag
	if this.ii_intimationtype = 1 then
		SQL SELECT accounts.acccode INTO :ll_acccode FROM accounts , supplier WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =supplier.suppcode USING this.it_transobject;
	else
		SQL SELECT accounts.acccode INTO :ll_acccode FROM accounts , customer WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =customer.custcode USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_acccode = ll_acccode
		if isnull(al_acccode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_expiryintimation.wf_get_possible_batch_expiry() returns long
	long ll_acccode
	long ll_icode
	s_possiblebatchexpiry_expint lstr_possiblebatchexpiry
	if this.id_master.getrow() > 0 and this.id_master.rowcount() > 0 then
		ll_acccode = this.id_master.object.acccode[1]
	else
		setnull(ll_acccode)
	end if
	if this.id_detail.getrow() > 0 and this.id_detail.rowcount() > 0 then
		ll_icode = this.id_detail.object.icode[this.id_detail.getrow()]
	else
		setnull(ll_icode)
	end if
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 and not isnull(ll_acccode) and not isnull(ll_icode) then
		lstr_possiblebatchexpiry.l_acccode = ll_acccode
		lstr_possiblebatchexpiry.l_icode = ll_icode
		lstr_possiblebatchexpiry.i_module = this.ii_intimationtype
		openwithparm(w_possiblebatchexpiry_expiryintimation, lstr_possiblebatchexpiry)
		lstr_possiblebatchexpiry = message.powerobjectparm
		if lstr_possiblebatchexpiry.i_status = 1 then
			this.id_detail.setitem(this.id_detail.getrow(), "batch", lstr_possiblebatchexpiry.s_batch)
			this.id_detail.setitem(this.id_detail.getrow(), "expiry", lstr_possiblebatchexpiry.d_expiry)
			this.id_detail.setitem(this.id_detail.getrow(), "qty", lstr_possiblebatchexpiry.d_qty)
			this.id_detail.setitem(this.id_detail.getrow(), "invoicecode", lstr_possiblebatchexpiry.l_invcode)
			this.id_detail.setitem(this.id_detail.getrow(), "invoicedate", lstr_possiblebatchexpiry.dt_invdate)
			this.id_detail.setitem(this.id_detail.getrow(), "refno", lstr_possiblebatchexpiry.s_refno)
			this.id_detail.setitem(this.id_detail.getrow(), "refdate", lstr_possiblebatchexpiry.dt_refdate)
		end if
	end if
	return 0

// w_expiryintimation.wf_consolidatedexpiryintimation() returns long
	long ll_counter
	long ll_arr_rows
	long ll_intimationcode
	string ls_list
	s_arguements lstr_arg
	if wf_iseditable() = true then
		return 0
	end if
	openwithparm(w_expintimation_range_selection, this.ii_intimationtype)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		ll_arr_rows = upperbound(lstr_arg.ia_integerlist)
		ls_list = ""
		for ll_counter = 1 to ll_arr_rows
			ls_list = ls_list + trim(string(lstr_arg.ia_integerlist[ll_counter])) + ","
		next
		ls_list = left(ls_list, len(ls_list) - 1)
		if len(ls_list) > 0 then
			SQL rollback USING this.it_transobject;
			this.it_transobject.consolidatedexpiryintimation(gl_usercode, ls_list, lstr_arg.l_code3, lstr_arg.l_code4, this.ii_intimationtype, ll_intimationcode)
			if this.it_transobject.sqlcode = 0 then
				SQL commit USING this.it_transobject;
				messagebox("Expiry Intimation Consolidation", "Expiry Intimation Consolidation done successfully.~r~nExpiry Intimation Code = " + trim(string(ll_intimationcode)), information!)
			else
				messagebox("Expiry Intimation Consolidation", this.it_transobject.sqlerrtext, stopsign!)
				SQL rollback USING this.it_transobject;
			end if
		end if
	end if
	return 0

// w_expiryintimation.wf_extractexpiryintimation() returns long
	long ll_counter
	long ll_arr_rows
	long ll_intimationcode
	long ll_consolidatedintimation
	long ll_custcode
	long ll_acccode
	long ll_option
	char ac_grouptype
	string ls_list
	s_arguements lstr_arg
	s_arguements istr_temp
	if wf_iseditable() = true then
		return 0
	end if
	if this.id_list.rowcount() <= 0 or this.id_list.getrow() < 0 then
		return 0
	end if
	ll_consolidatedintimation = this.id_list.object.code[this.id_list.getrow()]
	if isnull(ll_consolidatedintimation) or ll_consolidatedintimation <= 0 then
		return 0
	end if
	open(w_arg_supp_cust)
	istr_temp = message.powerobjectparm
	if istr_temp.i_status = 1 then
		ll_acccode = istr_temp.l_code1
		ll_custcode = istr_temp.l_code2
		open(w_selectformat_suppitems_default)
		ll_option = message.doubleparm
		if ll_option = 1 then
			ac_grouptype = "S"
			ls_list = "S"
		else
			open(w_selection_manf_cat_class_packing)
			ac_grouptype = message.stringparm
			openwithparm(w_arg_grouping, ac_grouptype)
			lstr_arg = message.powerobjectparm
			if lstr_arg.i_status = 1 then
				ll_arr_rows = upperbound(lstr_arg.ia_integerlist)
				ls_list = ""
				for ll_counter = 1 to ll_arr_rows
					ls_list = ls_list + trim(string(lstr_arg.ia_integerlist[ll_counter])) + ","
				next
				ls_list = left(ls_list, len(ls_list) - 1)
			end if
		end if
		if len(ls_list) > 0 then
			SQL rollback USING this.it_transobject;
			this.it_transobject.extractexpiryintimation(gl_usercode, ll_consolidatedintimation, ac_grouptype, ls_list, ll_acccode, ll_custcode, this.ii_intimationtype, ll_intimationcode)
			if this.it_transobject.sqlcode = 0 then
				SQL commit USING this.it_transobject;
				messagebox("Expiry Intimation Extraction", "Expiry Intimation Extraction done successfully.~r~nExpiry Intimation Code = " + trim(string(ll_intimationcode)), information!)
			else
				messagebox("Expiry Intimation Extraction", this.it_transobject.sqlerrtext, stopsign!)
				SQL rollback USING this.it_transobject;
			end if
		end if
	end if
	return 0

// w_expiryintimation.wf_fetch_lasttransaction_info(long al_icode, string as_batch, datetime adt_expiry, long al_row) returns integer
	long ll_acccode
	long ll_invcode
	datetime ldt_date
	datetime ldt_refdate
	double ld_qty
	string ls_refno
	if this.ii_intimationtype = 1 then
		SQL SELECT PurInvCode , Date , SuppCode , SuppInvCode , SuppInvDate , Qty =ISNULL ( ( SELECT SUM ( D.LooseQty + D.PackQty + D.BonusQty ) FROM PurDetail D WHERE D.PurInvCode =PurLedger.PurInvCode AND D.ICode =:al_icode AND D.Batch =:as_batch AND D.Expiry =:adt_expiry ) , 0 ) INTO :ll_invcode, :ldt_date, :ll_acccode, :ls_refno, :ldt_refdate, :ld_qty FROM DBO.PurLedger WHERE PurLedger.PurInvCode IN ( SELECT MAX ( PurDetail.PurInvCode ) FROM DBO.PurDetail WHERE PurDetail.ICode =:al_icode AND PurDetail.Batch =:as_batch AND PurDetail.Expiry =:adt_expiry ) USING this.it_transobject;
	else
		SQL SELECT SaleInvCode , Date , CustCode , CustRefNo , BillingDate , Qty =ISNULL ( ( SELECT SUM ( D.LooseQty + D.BonusQty ) FROM SaleDetail D WHERE D.SaleInvCode =SaleLedger.SaleInvCode AND D.ICode =:al_icode AND D.Batch =:as_batch AND D.Expiry =:adt_expiry ) , 0 ) INTO :ll_invcode, :ldt_date, :ll_acccode, :ls_refno, :ldt_refdate, :ld_qty FROM DBO.SaleLedger WHERE SaleLedger.SaleInvCode IN ( SELECT MAX ( SaleDetail.SaleInvCode ) FROM DBO.SaleDetail WHERE SaleDetail.ICode =:al_icode AND SaleDetail.Batch =:as_batch AND SaleDetail.Expiry =:adt_expiry ) USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 and al_row > 0 then
		this.id_detail.object.invoicecode[al_row] = ll_invcode
		this.id_detail.object.invoicedate[al_row] = ldt_date
		this.id_detail.object.refno[al_row] = ls_refno
		this.id_detail.object.refdate[al_row] = ldt_refdate
		this.id_detail.object.lastacccode[al_row] = ll_acccode
		this.id_detail.object.qty[al_row] = ld_qty
	end if
	return 0

// w_expiryintimation.wf_populate_possiblebatchexpiry() returns long
	long ll_retcode
	long ll_counter
	long ll_rowcount
	long ll_insrow
	long ll_icode
	integer li_rtcode
	string ls_type
	string ls_errortext
	s_arguements ls_reparg
	datastore lds_store
	lds_store = create datastore
	lds_store.dataobject = "d_populate_possible_expiryreport"
	lds_store.settransobject(sqlca)
	open(w_selection_manf_cat_class_packing)
	ls_type = message.stringparm
	if not (ls_type = "" or isnull(ls_type)) then
		openwithparm(w_arg_manfs_cats_classes_packs_dates, ls_type)
		ls_reparg = message.powerobjectparm
	end if
	if ls_reparg.i_status = 1 then
		do while this.id_detail.rowcount() > 0
			this.id_detail.deleterow(0)
		loop
		ll_retcode = lds_store.retrieve(ls_type, ls_reparg.ia_integerlist, ls_reparg.d_sdate, ls_reparg.d_edate)
		ll_rowcount = lds_store.rowcount()
		if ll_rowcount > 0 then
			for ll_counter = 1 to ll_rowcount
				ll_insrow = this.id_detail.insertrow(0)
				if ll_insrow > 0 then
					ll_icode = lds_store.object.icode[ll_counter]
					if ll_icode > 0 and wf_inititeminfo(ll_icode, ll_insrow, li_rtcode, ls_errortext) then
						this.id_detail.object.batch[ll_insrow] = lds_store.object.batch[ll_counter]
						this.id_detail.object.expiry[ll_insrow] = lds_store.object.expiry[ll_counter]
						this.id_detail.object.qty[ll_insrow] = lds_store.object.qty[ll_counter]
						this.id_detail.object.invoicecode[ll_insrow] = lds_store.object.purinvcode[ll_counter]
						this.id_detail.object.invoicedate[ll_insrow] = lds_store.object.date[ll_counter]
						this.id_detail.object.lastacccode[ll_insrow] = lds_store.object.suppcode[ll_counter]
						this.id_detail.object.refno[ll_insrow] = lds_store.object.suppinvcode[ll_counter]
						this.id_detail.object.refdate[ll_insrow] = lds_store.object.suppinvdate[ll_counter]
					end if
				end if
			next
		end if
	end if
	return ll_retcode

// w_expiryintimation.wf_push_expiryintimation_to_dropbox() returns long
	integer li_errcode
	long ll_salesmancode
	long ll_invcount
	long ll_counter
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			li_errcode = this.it_transobject.pushexpiryintimationtodropbox(lstr_arginfo.l_code1, lstr_arginfo.l_code2, this.ii_intimationtype, ll_salesmancode, gs_dropbox_server, gs_dropbox_db, "DBO", ll_invcount)
			if li_errcode <> 0 then
				li_errcode = this.it_transobject.sqlcode
				ls_msgtext = this.it_transobject.sqlerrtext
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				ls_msgtext = this.it_transobject.sqlerrtext
				li_errcode = this.it_transobject.sqlcode
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Push Expiry Intimation To Drop Box Fails", "Some database request fails, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode), stopsign!)
		else
			messagebox("Push to Drop Box Successfull", "Total Invoices to push were " + string(ll_invcount) + "~n~rAll Invoices have been pushed successfully to drop box.", information!)
		end if
	end if
	return li_errcode

// w_expiryintimation.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_expiryintimation" then
		this.menuid = create m_expiryintimation
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	this.ic_cashdrawerprinter = create ic_cashdrawerprinter
	this.ic_comport = create ic_comport
	this.ic_drawerport = create ic_drawerport
	this.dw_saleinvdetail = create dw_saleinvdetail
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.ic_cashdrawerprinter
	this.control[icurrent + 3] = this.ic_comport
	this.control[icurrent + 4] = this.ic_drawerport
	this.control[icurrent + 5] = this.dw_saleinvdetail

// w_expiryintimation.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.ic_cashdrawerprinter
	destroy this.ic_comport
	destroy this.ic_drawerport
	destroy this.dw_saleinvdetail

// w_expiryintimation.ue_save() returns 0 [event]
	long ll_detailrows
	long ll_counter2
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_icode
	long ll_intimationretcode
	long ll_errrowid
	long ll_salesmancode
	long ll_counter
	long ll_count
	long ll_null
	long ll_modifycount
	long ll_found
	long ll_serialno
	boolean lb_commitflag
	boolean lb_continue
	integer li_counter
	integer li_filehandle
	integer li_maxretcode
	string ls_errtext
	string ls_holdstring
	string ls_drawermessage
	string ls_askuserpwd
	string ls_batch
	s_salesman lstr_salesman
	datetime ldt_expiry
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_itemname
	string ls_messagetext
	if this.tab_retrieve.selectedtab = 2 then
		return
	end if
	if wf_iseditable() = false then
		return
	end if
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if this.id_master.rowcount() > 0 and (this.id_master.object.acccode[this.id_master.rowcount()] = 0 and isnull(this.id_master.object.acccode[this.id_master.rowcount()])) then
		if this.ii_intimationtype = 1 then
			messagebox("Supplier Validation", "Please Select Some Valid Supplier")
		else
			messagebox("Customer Validation", "Please Select Some Valid Customer")
		end if
		this.id_master.setfocus()
		this.id_master.setcolumn("acccode")
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	if this.id_detail.rowcount() < 1 then
		messagebox("Rows Validation", "Please insert a row before proceeding")
		return
	end if
	ll_found = this.id_detail.find("qty <= 0 ", 1, this.id_detail.rowcount())
	if ll_found > 0 then
		messagebox("Qty Validation", "Please Enter Valid Qty in Row " + string(ll_found))
		this.id_detail.setfocus()
		this.id_detail.scrolltorow(ll_found)
		this.id_detail.setcolumn("qty")
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	wf_grandtotal()
	this.id_footer.accepttext()
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		ll_mastercurrrow = this.id_master.getrow()
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if isnull(ll_invid) then
			li_maxretcode = wf_tabnewid("expiryintimation", ll_invid)
			if li_maxretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~ngenerating Intimation Code")
				return
			end if
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
		end if
		ll_serialno = this.id_master.getitemnumber(ll_mastercurrrow, "intimationserialno")
		this.id_master.setitem(ll_mastercurrrow, "intimationtypecode", this.ii_intimationtype)
		if isnull(ll_serialno) or ll_serialno = 0 then
			ll_intimationretcode = wf_gen_intimation_serialno(this.ii_intimationtype, ll_serialno, this.it_transobject)
			if ll_intimationretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~n ~t~t~t~t~t~t~t~t~t~t~t~t~tgenerating Voucher Code")
				return
			end if
			if ll_serialno > 0 then
				this.id_master.setitem(ll_mastercurrrow, "intimationserialno", ll_serialno)
			end if
		end if
		if this.ib_modify then
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.idt_server_datetime = ldt_server_datetime
			if wf_delete_expiryintimation(ll_invid) <> 0 then
				lb_continue = false
			end if
		else
			this.id_master.setitem(ll_mastercurrrow, "usercode", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.idt_server_datetime = ldt_server_datetime
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		end if
		if lb_continue then
			this.id_saleinvdetail.reset()
			if not wf_populatedetail(ll_invid, this.id_saleinvdetail, ls_errtext, ll_errrowid) then
				lb_continue = false
				this.id_detail.scrolltorow(ll_errrowid)
				this.id_detail.setfocus()
			else
				this.id_detail = this.id_saleinvdetail
				if this.id_master.update(true, false) > 0 then
					if this.id_detail.update() > 0 then
						SQL commit USING this.it_transobject;
						messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
						this.ib_commitok = true
						this.id_master.resetupdate()
						this.im_menu.m_file.m_new.enabled = true
						this.editflag = false
						if gd_recenttransdate < this.id_systemdate then
							gd_recenttransdate = this.id_systemdate
						end if
					else
						SQL rollback USING this.it_transobject;
						messagebox("Saving Problem", "Changes do not effect in database~r~nReasons are:~r~n" + this.it_transobject.sqlerrtext, stopsign!, ok!, 1)
						lb_continue = false
						setpointer(arrow!)
					end if
				else
					SQL rollback USING this.it_transobject;
					messagebox("Saving Problem", "Changes do not effect in database~r~nReasons are:~r~n" + this.it_transobject.sqlerrtext, stopsign!, ok!, 1)
					lb_continue = false
					setpointer(arrow!)
				end if
				if this.ib_commitok then
					this.ib_modify = false
				elseif this.ib_modify = false then
					setnull(ll_null)
					this.id_master.setitem(1, "Code", ll_null)
					this.id_master.accepttext()
				end if
				this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
				this.id_saleinvdetail.reset()
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			if this.ib_modify = false then
				setnull(ll_null)
				this.id_master.setitem(1, "Code", ll_null)
				this.id_master.accepttext()
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_expiryintimation.ue_newform() returns 0 [event]
	integer rtncode
	long li_fetched_code
	long row
	long ll_manfcode
	long ll_counter
	datetime ldt_server_datetime
	string ls_date_errtext
	m_expiryintimation lm_menu
	call super::ue_newform
	lm_menu = this.menuid
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_post.enabled = false
	this.id_detail.setredraw(false)
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.id_detail.setredraw(true)
	this.ib_modify = false
	if not wf_validatedate() then
		close(this)
	end if
	if this.ib_modifydate then
		if this.ib_fetchserverdate then
			wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
			this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
		else
			this.id_master.setitem(this.id_master.getrow(), "date", today())
		end if
	end if
	this.id_master.object.intimationtypecode.initial = trim(string(this.ii_intimationtype))

// w_expiryintimation.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect
	long ll_row
	long ll_code
	long ll_counter
	boolean lb_flag
	boolean lb_modify
	m_expiryintimation lm_menu
	long ll_rowcount
	long ll_validinv
	double ld_code
	lm_menu = this.menuid
	this.tab_retrieve.tabpage_list.em_invno.getdata(ld_code)
	if ld_code = 0.0 then
		ld_code = this.id_list.object.code[this.il_selectedrow]
	else
		SQL select count ( *) INTO :ll_validinv from ExpiryIntimation where IntimationCode =:ld_code USING this.it_transobject;
		if ll_validinv <> 1 then
			this.id_detail.reset()
			messagebox("Intimation Code Validation", "Intimation Code does not exist")
			this.tab_retrieve.selecttab(2)
			return
		end if
	end if
	if wf_isinvoiceinuse(ld_code) = true then
		messagebox("Document Code Validation", "Intimation already in use by some other user.~r~nKindly try again after sometime or open some other Intimation.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.im_menu.m_file.m_print.enabled = true
	this.i_editmode = 2
	this.i_retrievemode = 2
	this.id_dwcontrol = this.id_master
	ll_rowcount = wf_retrieve(ld_code)
	this.id_master.setrow(1)
	this.id_master.scrolltorow(1)
	this.id_dwcontrol = this.id_footer
	wf_retrieve(ld_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	this.id_dwcontrol = this.id_detail
	wf_retrieve(ld_code)
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	this.id_dwcontrol = this.id_list
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		lb_modify = true
	end if
	if not lb_modify then
		this.im_menu.m_file.m_save.enabled = false
		this.editflag = false
	else
		li_protect = 0
		wf_initmodify(li_protect)
		if f_stringpreferences("itemcode") = "Y" then
			this.id_detail.setcolumn("fullcode")
		else
			this.id_detail.setcolumn("itemname")
		end if
	end if
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		wf_protectdw(this.id_master, 0)
		wf_protectdw(this.id_detail, 0)
		wf_protectdw(this.id_footer, 0)
	else
		wf_protectdw(this.id_master, li_protect)
		wf_protectdw(this.id_detail, li_protect)
		wf_protectdw(this.id_footer, li_protect)
	end if
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_grandtotal()
	this.id_master.setfocus()
	setredraw(true)

// w_expiryintimation.ue_newitem() returns 0 [event]
	long ll_rowcount
	setnull(this.is_aliasname)
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_expiryintimation.ue_deleteitem() returns 0 [event]
	long ll_currow
	long ll_detailrows
	this.ib_itemvalidated = true
	this.id_detail.deleterow(0)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows < 1 then
		this.im_menu.m_file.m_save.enabled = false
	end if
	wf_grandtotal()
	if this.id_detail.rowcount() > 0 then
		return
	end if
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_save.enabled = false

// w_expiryintimation.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	return 1

// w_expiryintimation.ue_list() returns 0 [event]
	long ll_row
	m_expiryintimation lm_menu
	call super::ue_list
	lm_menu = this.menuid
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_post.enabled = true
	this.im_menu.m_file.m_print.enabled = false
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	this.tab_retrieve.tabpage_list.em_invno.selecttext(1, 7)
	this.tab_retrieve.tabpage_list.em_invno.clear()
	ll_row = wf_retrievelist()
	wf_disabledetailtab(ll_row)
	post event ue_enableprint()
	this.editflag = false
	this.im_menu.m_file.m_save.enabled = false

// w_expiryintimation.ue_print() returns 0 [event]
	long ll_row
	long ll_invcode
	long ll_counter
	string ls_posted
	string ls_invoicesize
	integer li_option
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save Intimation", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
			else
				event ue_newitem()
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	wf_selectprintreport(ls_invoicesize)
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("saleaskforcopies") = "Y" then
		open(w_printer_copies)
		this.id_print.object.datawindow.print.copies = string(message.doubleparm)
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Intimation Document", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Intimation document,~r~nNo rows are retrieved", information!)

// w_expiryintimation.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	setpointer(hourglass!)
	this.idc_acc.setredraw(false)
	this.idc_acc.settransobject(this.it_transobject)
	this.idc_acc.retrieve()
	this.idc_acc.setredraw(true)
	setpointer(arrow!)

// w_expiryintimation.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_expiryintimation.ue_postopen() returns 0 [event]
	m_expiryintimation lm_menu
	integer li_rtncode
	long ll_counter
	long ll_found
	call super::ue_postopen
	lm_menu = this.menuid
	this.ii_intimationtype = message.doubleparm
	this.id_master.object.intimationtypecode.initial = trim(string(this.ii_intimationtype))
	setredraw(false)
	f_fetch_sites()
	this.id_print = this.dw_saleinvrep
	this.id_saleinvdetail = this.dw_saleinvdetail
	this.id_saleinvdetail.settransobject(this.it_transobject)
	if this.ii_intimationtype = 1 then
		this.title = "Expiry Intimation - Purchase Based"
		wf_assigndatawindowobjects("d_expiryintimation_header", "d_expiryintimation_detail", "d_expiryintimation_footer", "d_expiryintimation_list", "d_expiryintimation_print")
	else
		this.title = "Expiry Intimation - Sale Based"
		wf_assigndatawindowobjects("d_expiryintimation_header2", "d_expiryintimation_detail", "d_expiryintimation_footer", "d_expiryintimation_list2", "d_expiryintimation_print")
	end if
	li_rtncode = this.id_master.getchild("acccode", this.idc_acc)
	if li_rtncode = -1 then
		messagebox("Error!", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_acc.settransobject(this.it_transobject)
	this.idc_acc.retrieve()
	this.im_menu.m_file.m_post.visible = true
	this.im_menu.m_file.m_post.toolbaritemvisible = true
	this.im_menu.m_file.m_post.enabled = true
	this.il_groupcode = f_getgroupcode(gl_usercode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	this.id_itemslist.object.t_stock.visible = true
	this.id_itemslist.object.stock.visible = true
	if f_stringpreferences("packingdescinsale") = "N" then
		this.id_detail.object.packingdesc.visible = false
	end if
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.stock.visible = false
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	gd_itemsinfo.sharedata(this.id_itemslist)
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.id_master.accepttext()
	f_setcolumnstyle(this.id_detail, "Qty")
	setredraw(true)
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 563", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.date.protect = 0
		this.id_master.object.date.background.color = rgb(255, 255, 255)
		this.ib_modifydate = true
		lm_menu.m_file.m_setserverdate.visible = true
		lm_menu.m_file.m_setserverdate.enabled = true
	end if
	if not this.ib_modifydate then
		this.id_master.object.date.protect = 1
		this.id_master.settaborder("date", 0)
		lm_menu.m_file.m_setserverdate.visible = false
		lm_menu.m_file.m_setserverdate.enabled = false
	end if
	if gl_sitecode > 0 and gc_dropbox = "Y" then
		this.id_master.object.sitecode.initial = trim(string(gl_sitecode))
		this.id_master.object.targetsitecode.visible = true
		this.id_master.object.t_targetsitecode.visible = true
	else
		this.id_master.object.targetsitecode.visible = false
		this.id_master.object.t_targetsitecode.visible = false
	end if
	this.id_detail.object.batch.initial = f_stringpreferences("defaultbatch")
	this.id_detail.object.expiry.initial = string(f_datepreferences("defaultexpiry"))
	if this.ii_intimationtype = 1 then
		this.id_detail.object.lastacccode_t.text = "Supplier"
	end if
	if not f_rightexists(5280) then
		lm_menu.m_file.m_pushexpiryintimationtodropbox.enabled = false
		lm_menu.m_file.m_pushexpiryintimationtodropbox.visible = false
		this.id_list.object.pushed.visible = false
		this.id_list.object.pushedon.visible = false
		this.id_list.object.pushedby.visible = false
		this.id_list.object.pushedfor.visible = false
	end if
	if not f_rightexists(5281) then
		lm_menu.m_file.m_pullexpiryintimationfromdropbox.enabled = false
		lm_menu.m_file.m_pullexpiryintimationfromdropbox.visible = false
	end if
	if f_islicenseexpire() = -2 then
		close(this)
	end if

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	return ::message.returnvalue

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
	case "flatdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	end choose
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_code
	long ll_detailrows
	long ll_counterm
	long ll_acccode
	integer rt_code
	integer li_res
	long ll_icode
	long li_packunits
	long ll_null
	string ls_result
	string ls_null
	datetime ld_currdate
	date ld_datepart
	time lt_timepart
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "acccode"
		ll_acccode = long(data)
		if ll_acccode <= 0 or isnull(ll_acccode) then
			rt_code = 1
		else
			parent.parent.parent.wf_set_accountinfo(ll_acccode)
		end if
	case "aliasname"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findacccode(data, ll_acccode)
			if li_res > 0 then
				setitem(row, "acccode", ll_acccode)
				return 0
			else
				if parent.parent.parent.ii_intimationtype = 1 then
					messagebox("Supplier Validation", "Supplier with  AliasName " + data + " does not exist")
				else
					messagebox("Customer Validation", "Customer with  AliasName " + data + " does not exist")
				end if
				return 1
			end if
			return
		end if
	case "date"
		return rt_code
	end choose
	return rt_code

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "date"
		messagebox("Date Time Validation", "Date and Time is invalid,~r~nPlease enter current date and time")
	case "acccode"
		if parent.parent.parent.ii_intimationtype = 1 then
			messagebox("Supplier Name Validation", "You must select some Supplier")
		else
			messagebox("Customer Name Validation", "You must select some Customer")
		end if
	end choose
	return 1

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if (dwo.name <> "aliasname" or dwo.name <> "acccode") and (isnull(this.object.acccode[row]) or this.object.acccode[row] = 0) then
		if parent.parent.parent.ii_intimationtype = 1 then
			messagebox("Supplier Validation", "Please Enter Valid Supplier", stopsign!)
		else
			messagebox("Customer Validation", "Please Enter Valid Customer", stopsign!)
		end if
		setfocus()
		setcolumn("acccode")
	end if
	return 0

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_null
	string ls_itemname
	string ls_batch
	integer li_errcode
	long ll_null
	long ll_icode
	long ll_gcode
	long ll_packunits
	double ld_packqty
	double ld_bonuspackqty
	double ld_newbonusqty
	double ld_desiredbonus
	double ld_newqty
	double ld_storedqty
	double ld_stock
	double ld_invdiscperc
	datetime ldt_expiry
	date ld_expiry
	time lt_expiry
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
		parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		li_errcode = 0
	case "icode"
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	case "qty"
		ld_newqty = double(data)
		if ld_newqty <= 0.0 then
			messagebox("Quantity Validation", "Item Qty ~"" + data + "~" should be greater than zero")
			li_errcode = 1
		end if
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname)
			if li_res > 0 then
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
			else
				messagebox("ItemNumber Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_errcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_errcode = 2
		end if
	case "batch"
		parent.parent.parent.wf_fetch_lasttransaction_info(parent.parent.parent.id_detail.object.icode[row], data, parent.parent.parent.id_detail.object.expiry[row], row)
	case "expiry"
		ld_expiry = date(mid(data, 1, 10))
		lt_expiry = time("00:00:00.000000")
		ldt_expiry = datetime(ld_expiry, lt_expiry)
		parent.parent.parent.wf_fetch_lasttransaction_info(parent.parent.parent.id_detail.object.icode[row], parent.parent.parent.id_detail.object.batch[row], ldt_expiry, row)
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ll_icode
	long ll_gcode
	long ll_count
	long ll_check_dup_icode
	long ancestorreturnvalue
	ll_check_dup_icode = parent.parent.parent.id_detail.getitemnumber(row, "icode")
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(false) = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "itemname" then
		parent.parent.parent.ib_focusdetail = true
	end if
	if dwo.name = "qty" and parent.parent.parent.ib_itemslistopen then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
	end if
	parent.parent.parent.wf_grandtotal()
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return 0

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_icode
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if currentrow > 0 then
		parent.parent.parent.is_aliasname = getitemstring(currentrow, "fullcode")
	end if
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(true) = -1 then
		return ::message.returnvalue
	end if
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if getcolumnname() <> parent.parent.parent.is_columnitemname then
		if not (rowcount() > 0 and lrs_status <> new!) then
			if parent.parent.parent.id_footer.getrow() > 0 then
			end if
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	long ll_currentrow
	string ls_holdstr
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "fullcode"
		if data = "" or isnull(data) then
		end if
	case parent.parent.parent.is_columnitemname
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case "price"
		if double(data) < 0.0 then
			messagebox("Price Validation", "Item Price~"" + data + "~" must be greater than or equal to zero")
		end if
	end choose
	return 1

// dw_itemsdetail.getfocus() returns long [event]
	integer ll_row
	integer ll_custcode
	long ll_lastinvcode
	long ll_customerallowed
	long ancestorreturnvalue
	parent.parent.parent.id_detail.setredraw(true)
	if f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanging(long currentrow, long newrow) returns long [event]
	long ancestorreturnvalue
	long ll_icode
	string ls_holdstr
	string ls_batch
	datetime ldt_expiry
	ancestorreturnvalue = super::rowfocuschanging(currentrow, newrow)
	if currentrow <= rowcount() and (currentrow > 0 and parent.parent.parent.id_detail.rowcount() > 0) and parent.parent.parent.id_detail.getitemnumber(currentrow, "qty") <= 0.0 then
		messagebox("Qty Validation", "Please Enter Valid Qty")
		parent.parent.parent.id_detail.setcolumn("qty")
		parent.parent.parent.id_detail.setrow(currentrow)
		return 1
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	integer li_rowno
	integer i
	integer li_columnno
	boolean lb_duplicate
	li_columnno = integer(this.object.price.id)
	if getrow() = rowcount() then
		for i = 1 to i
			if parent.parent.parent.id_detail.getitemstring(i, "fullcode") = parent.parent.parent.is_aliasname then
				lb_duplicate = true
			end if
		next
		if getcolumn() = li_columnno then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
	elseif li_columnno = integer(this.object.datawindow.column.count) and getcolumn() = li_columnno then
		scrollnextrow()
		if f_stringpreferences("ItemCode") = "Y" then
			setcolumn(1)
		else
			setcolumn(2)
		end if
		setfocus()
		return 1
	end if
	li_rowno = gd_itemsinfo.find("fullcode='" + parent.parent.parent.is_aliasname + "'", 1, gd_itemsinfo.rowcount())
	if getcolumn() = 1 and li_rowno > 0 then
		parent.parent.parent.id_detail.setcolumn(integer(this.object.datawindow.column.count) - 1)
		setfocus()
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_icode
	long ll_row
	string ls_itemname
	string ls_aliasname
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	if getcolumn() = 1 then
		parent.parent.parent.is_aliasname = data
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_focusqty() returns 0 [event]
	setcolumn("qty")
	setfocus()

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_counter
	long ll_found
	long ll_rowm
	long ll_icode
	long ll_row
	string ls_itemname
	string ls_aliasname
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(99999)
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(1)
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf8! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("namesearch", 1)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf9! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("criteriasearch", 1)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf4! then
			parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
			setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
			setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	elseif key = keydownarrow! then
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	end if
	return rt_code

// tabpage_list.create() returns 0 [event]
	integer icurrent
	this.st_3 = create st_3
	this.em_invno = create em_invno
	call super::create
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_3
	this.control[icurrent + 2] = this.em_invno

// tabpage_list.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_3
	destroy this.em_invno

// em_invno.ue_downkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		parent.parent.parent.tab_retrieve.selecttab(1)
	end if
	return ::message.returnvalue

// ic_comport.ue_show() returns long [event]
	this.object.portopen = true
	this.object.portopen = false
	return 1

// ic_comport.constructor() returns long [event]
	integer li_defaultcomport
	if f_stringpreferences("DisplayPool") = "Y" then
		li_defaultcomport = f_numberpreferences("DefaultComPort")
		if isnull(li_defaultcomport) then
			li_defaultcomport = 1
		end if
		this.object.commport = li_defaultcomport
		this.object.settings = "9600,N,8,1"
		this.object.inputlen = 0
	end if
	return ::message.returnvalue

// ic_drawerport.constructor() returns long [event]
	integer li_defaultcomport
	if f_stringpreferences("CashDrawer") = "Y" then
		li_defaultcomport = f_numberpreferences("CashDrawerComPort")
		if isnull(li_defaultcomport) then
			li_defaultcomport = 1
		end if
		this.object.commport = li_defaultcomport
		this.object.settings = "300,N,8,1"
		this.object.inputlen = 0
	end if
	return ::message.returnvalue
