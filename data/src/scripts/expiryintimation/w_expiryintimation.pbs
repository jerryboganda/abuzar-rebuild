// window w_expiryintimation (expiryintimation)  ancestor: w_multi_entry

// w_expiryintimation.ue_setitemfocus() returns 0 [event]
	string ls_null
	setnull(ls_null)
	if f_stringpreferences("itemcode") = "Y" then
		this.id_detail.setcolumn("fullcode")
		this.id_detail.setfocus()
		return
	end if
	this.id_detail.setitem(this.id_detail.getrow(), "itemname", " ")
	this.id_detail.setcolumn("itemname")
	this.id_detail.setfocus()
	this.id_detail.setitem(this.id_detail.getrow(), "itemname", ls_null)

// w_expiryintimation.ue_enableprint() returns 0 [event]
	this.im_menu.m_file.m_print.enabled = true

// w_expiryintimation.ue_populate_expintimation_from_datacarry() returns 0 [event]
	long ll_icode
	long ll_row
	long ll_intimationcode
	long ll_counter
	long ll_qty
	long ll_bonusqty
	long ll_acccode
	long ll_check_for_basicdata_sync
	boolean retflag
	double ld_purprice
	double ld_discperc
	double ld_itemflatdisc
	double ld_saleprice
	double ld_avgprice
	double ld_packsalestax
	double ld_gstperc
	double ld_rpp
	double ld_unitsalestax
	double ld_itempurprice
	double ld_rate
	double ld_rpp2
	double ld_rpp3
	double ld_rpp4
	double ld_rpp5
	double ld_invdiscperc
	double ld_invflatdisc
	double ld_invmisccharges
	double ld_invgstperc1
	double ld_godownstock
	double ld_allgodownstock
	long ll_packunits
	long ll_itemscount
	integer li_rtcode
	string ls_fullcode
	string ls_name
	string ls_batch
	string ls_itemtotalval
	string ls_packingdesc
	string ls_errortext
	string ls_error_syntax
	string ls_connsetting
	string ls_headerquery
	string ls_detailquery
	string ls_newsyntax
	string ls_suppinvcode
	string ls_suppinvcode_tmp
	datetime ldt_expiry
	datastore lds_header
	datastore lds_detail
	s_arguements lstr_arguments
	u_transaction lt_transobject
	if wf_iseditable() = false then
		return
	end if
	ll_acccode = this.id_master.object.acccode[this.id_master.rowcount()]
	if isnull(ll_acccode) then
		if this.ii_intimationtype = 1 then
			messagebox("Supplier Validation!", "Kindly Select a Supplier first")
		else
			messagebox("Customer Validation!", "Kindly Select a Customer first")
		end if
		return
	end if
	open(w_populate_expintimation_from_datacarry)
	lstr_arguments = message.powerobjectparm
	if lstr_arguments.i_status <= 0 then
		return
	end if
	ll_intimationcode = lstr_arguments.l_code1
	if ll_intimationcode > 0 and this.id_master.object.acccode[this.id_master.rowcount()] > 0 then
		ls_suppinvcode = trim(string(ll_intimationcode))
	end if
	lt_transobject = create u_transaction
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Problem", "Unable to connect to database.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		return
	end if
	SQL EXECUTE IMMEDIATE :ls_connsetting USING lt_transobject;
	if ll_intimationcode > 0 then
		setpointer(hourglass!)
		ll_check_for_basicdata_sync = f_check_for_basicdata_sync()
		if ll_check_for_basicdata_sync < 0 then
			return
		end if
		lds_header = create datastore
		lds_detail = create datastore
		ls_headerquery = "Select ~tIntimationCode, IntimationTypeCode, IntimationSerialNo, AccCode, Date, RefNo, Remarks1, Remarks2, UserCode, Posted, PostedBy, PostDate, CustCode " + "From ~t" + gs_inlinkserver + "." + gs_inlinkserverdb + "." + gs_inlinkserverowner + "." + "ExpiryIntimation " + "Where   IntimationTypeCode = " + string(this.ii_intimationtype) + " AND intimationcode = " + string(ll_intimationcode)
		ls_detailquery = "Select ~tIntimationCode, ICode, Batch, Expiry, Qty, Packunits, PackPrice, Price, InvoiceCode, InvoiceDate, RefNo, RefDate " + "From ~t" + gs_inlinkserver + "." + gs_inlinkserverdb + "." + gs_inlinkserverowner + "." + "ExpiryIntimationDetail " + "Where ~tintimationcode = " + string(ll_intimationcode) + " AND intimationcode IN (SELECT intimationcode FROM " + gs_inlinkserver + "." + gs_inlinkserverdb + "." + gs_inlinkserverowner + "." + "ExpiryIntimation " + "Where   IntimationTypeCode = " + string(this.ii_intimationtype) + " AND intimationcode = " + string(ll_intimationcode) + ")"
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_headerquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For Expiry Intimation DataStore")
			return
		else
			ls_error_syntax = ""
			lds_header.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For Expiry Intimation  DataStore")
				return
			end if
		end if
		lds_header.settransobject(lt_transobject)
		if lds_header.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source Expiry Intimation .")
			return
		end if
		ls_newsyntax = ""
		ls_error_syntax = ""
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_detailquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For Expiry Intimation  Detail DataStore")
			return
		else
			ls_error_syntax = ""
			lds_detail.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For Expiry Intimation Detail DataStore")
				return
			end if
		end if
		lds_detail.settransobject(lt_transobject)
		if lds_detail.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source Expiry Intimation Detail.")
			return
		end if
		this.id_master.setitem(1, "refno", lds_header.object.refno[1])
		this.id_master.setitem(1, "remarks1", lds_header.object.remarks1[1])
		this.id_master.setitem(1, "remarks2", lds_header.object.remarks2[1])
		for ll_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_counter = 1 to lds_detail.rowcount()
			ll_row = this.id_detail.insertrow(0)
			ll_icode = lds_detail.getitemnumber(ll_counter, "icode")
			wf_inititeminfo(ll_icode, ll_counter, li_rtcode, ls_errortext)
			this.id_detail.object.icode[ll_row] = lds_detail.object.icode[ll_counter]
			this.id_detail.object.batch[ll_row] = lds_detail.object.batch[ll_counter]
			this.id_detail.object.expiry[ll_row] = lds_detail.object.expiry[ll_counter]
			this.id_detail.object.packunits[ll_row] = lds_detail.object.packunits[ll_counter]
			this.id_detail.object.packprice[ll_row] = lds_detail.object.packprice[ll_counter]
			this.id_detail.object.price[ll_row] = lds_detail.object.price[ll_counter]
			this.id_detail.object.qty[ll_row] = lds_detail.object.qty[ll_counter]
			this.id_detail.object.invoicecode[ll_row] = lds_detail.object.invoicecode[ll_counter]
			this.id_detail.object.invoicedate[ll_row] = lds_detail.object.invoicedate[ll_counter]
			this.id_detail.object.refno[ll_row] = lds_detail.object.refno[ll_counter]
			this.id_detail.object.refdate[ll_row] = lds_detail.object.refdate[ll_counter]
		next
		if this.id_detail.rowcount() > 0 then
			this.im_menu.m_file.m_save.enabled = true
			wf_grandtotal()
		else
			this.im_menu.m_file.m_save.enabled = false
		end if
	end if
	SQL stop USING lt_transobject;

// w_expiryintimation.ue_pull_expiryintimation_from_dropbox() returns 0 [event]
	long ll_icode
	long ll_row
	long ll_intimationcode
	long ll_counter
	long ll_qty
	long ll_bonusqty
	long ll_acccode
	long ll_check_for_basicdata_sync
	long ll_sitecode
	boolean retflag
	double ld_purprice
	double ld_discperc
	double ld_itemflatdisc
	double ld_saleprice
	double ld_avgprice
	double ld_packsalestax
	double ld_gstperc
	double ld_rpp
	double ld_unitsalestax
	double ld_itempurprice
	double ld_rate
	double ld_rpp2
	double ld_rpp3
	double ld_rpp4
	double ld_rpp5
	double ld_invdiscperc
	double ld_invflatdisc
	double ld_invmisccharges
	double ld_invgstperc1
	double ld_godownstock
	double ld_allgodownstock
	long ll_packunits
	long ll_itemscount
	integer li_rtcode
	string ls_fullcode
	string ls_name
	string ls_batch
	string ls_itemtotalval
	string ls_packingdesc
	string ls_errortext
	string ls_error_syntax
	string ls_connsetting
	string ls_headerquery
	string ls_detailquery
	string ls_newsyntax
	string ls_suppinvcode
	string ls_suppinvcode_tmp
	datetime ldt_expiry
	datastore lds_header
	datastore lds_detail
	s_arguements lstr_arguments
	u_transaction lt_transobject
	long ll_totrows
	if wf_iseditable() = false then
		return
	end if
	ll_acccode = this.id_master.object.acccode[this.id_master.rowcount()]
	if isnull(ll_acccode) then
		if this.ii_intimationtype = 1 then
			messagebox("Supplier Validation!", "Kindly Select a Supplier first")
		else
			messagebox("Customer Validation!", "Kindly Select a Customer first")
		end if
		return
	end if
	openwithparm(w_pull_expintimation_from_dropbox, this.ii_intimationtype)
	lstr_arguments = message.powerobjectparm
	if lstr_arguments.i_status <= 0 then
		return
	end if
	ll_intimationcode = lstr_arguments.l_code1
	ll_sitecode = lstr_arguments.l_code2
	if ll_intimationcode > 0 and ll_sitecode > 0 and this.id_master.object.acccode[this.id_master.rowcount()] > 0 then
		ls_suppinvcode = trim(string(ll_intimationcode))
	end if
	lt_transobject = create u_transaction
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Problem", "Unable to connect to database.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		return
	end if
	SQL EXECUTE IMMEDIATE :ls_connsetting USING lt_transobject;
	if ll_intimationcode > 0 and ll_sitecode > 0 then
		setpointer(hourglass!)
		ll_check_for_basicdata_sync = f_check_for_basicdata_sync()
		if ll_check_for_basicdata_sync < 0 then
			return
		end if
		lds_header = create datastore
		lds_detail = create datastore
		ls_headerquery = "Select ~tSiteCode, IntimationCode, IntimationTypeCode, IntimationSerialNo, AccCode, Date, RefNo, Remarks1, Remarks2, UserCode, CustCode " + "From ~t" + gs_dropbox_server + "." + gs_dropbox_db + "." + "DBO." + "DB_ExpiryIntimation " + "Where   IntimationTypeCode = " + string(this.ii_intimationtype) + " AND intimationcode = " + string(ll_intimationcode) + " AND SiteCode = " + string(ll_sitecode)
		ls_detailquery = "Select ~tIntimationCode, ICode, Batch, Expiry, Qty, Packunits, PackPrice, Price, InvoiceCode, InvoiceDate, RefNo, RefDate " + "From ~t" + gs_dropbox_server + "." + gs_dropbox_db + "." + "DBO." + "DB_ExpiryIntimationDetail " + "Where ~tintimationcode = " + string(ll_intimationcode) + " AND intimationcode IN (SELECT intimationcode FROM " + gs_dropbox_server + "." + gs_dropbox_db + "." + "DBO." + "DB_ExpiryIntimation " + "Where   IntimationTypeCode = " + string(this.ii_intimationtype) + " AND intimationcode = " + string(ll_intimationcode) + " AND SiteCode = " + string(ll_sitecode) + ")"
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_headerquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For Expiry Intimation DataStore")
			return
		else
			ls_error_syntax = ""
			lds_header.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For Expiry Intimation  DataStore")
				return
			end if
		end if
		lds_header.settransobject(lt_transobject)
		if lds_header.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source Expiry Intimation .")
			return
		end if
		ls_newsyntax = ""
		ls_error_syntax = ""
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_detailquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For Expiry Intimation  Detail DataStore")
			return
		else
			ls_error_syntax = ""
			lds_detail.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For Expiry Intimation Detail DataStore")
				return
			end if
		end if
		lds_detail.settransobject(lt_transobject)
		if lds_detail.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source Expiry Intimation Detail.")
			return
		end if
		this.id_master.setitem(1, "refno", lds_header.object.refno[1])
		this.id_master.setitem(1, "remarks1", lds_header.object.remarks1[1])
		this.id_master.setitem(1, "remarks2", lds_header.object.remarks2[1])
		for ll_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_counter = 1 to lds_detail.rowcount()
			ll_row = this.id_detail.insertrow(0)
			ll_icode = lds_detail.getitemnumber(ll_counter, "icode")
			wf_inititeminfo(ll_icode, ll_counter, li_rtcode, ls_errortext)
			this.id_detail.object.icode[ll_row] = lds_detail.object.icode[ll_counter]
			this.id_detail.object.batch[ll_row] = lds_detail.object.batch[ll_counter]
			this.id_detail.object.expiry[ll_row] = lds_detail.object.expiry[ll_counter]
			this.id_detail.object.packunits[ll_row] = lds_detail.object.packunits[ll_counter]
			this.id_detail.object.packprice[ll_row] = lds_detail.object.packprice[ll_counter]
			this.id_detail.object.price[ll_row] = lds_detail.object.price[ll_counter]
			this.id_detail.object.qty[ll_row] = lds_detail.object.qty[ll_counter]
			this.id_detail.object.invoicecode[ll_row] = lds_detail.object.invoicecode[ll_counter]
			this.id_detail.object.invoicedate[ll_row] = lds_detail.object.invoicedate[ll_counter]
			this.id_detail.object.refno[ll_row] = lds_detail.object.refno[ll_counter]
			this.id_detail.object.refdate[ll_row] = lds_detail.object.refdate[ll_counter]
		next
		if this.id_detail.rowcount() > 0 then
			this.im_menu.m_file.m_save.enabled = true
			wf_grandtotal()
			triggerevent("ue_save")
			if wf_commitform() = true then
				SQL rollback USING sqlca;
				sqlca.markexpiryintimationaspulled(ll_sitecode, ll_intimationcode, gl_usercode, gs_dropbox_server, gs_dropbox_db, "dbo")
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
				else
					SQL rollback USING sqlca;
				end if
				postevent("ue_new")
			else
				ll_totrows = this.id_detail.rowcount()
				if ll_totrows > 0 then
					for ll_row = 1 to ll_totrows
						triggerevent("ue_deleteitem")
					next
				end if
			end if
		else
			this.im_menu.m_file.m_save.enabled = false
		end if
	end if
	SQL stop USING lt_transobject;

// w_expiryintimation.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_expiryintimation.wf_closelist() returns 0
	this.ib_itemslistopen = false
	this.id_itemslist.hide()

// w_expiryintimation.wf_deleteallemptydetailrows() returns integer
	long ll_count
	long ll_deletecount
	ll_deletecount = 0
	for ll_count = 1 to this.id_detail.rowcount()
		if isnull(this.id_detail.getitemnumber(ll_count, "icode")) then
			ll_deletecount = ll_deletecount + 1
			this.id_detail.deleterow(ll_count)
		end if
	next
	return ll_deletecount

// w_expiryintimation.wf_fetchserverdate(boolean ab_checked) returns long
	if ab_checked then
		this.ib_fetchserverdate = true
	else
		this.ib_fetchserverdate = false
	end if
	return 0

// w_expiryintimation.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	integer ll_retflag
	long ll_icode
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND ( item.Restricted ='N' OR ( Item.Restricted ='Y' AND Exists ( select *from grouprights where rightcode =515 and groupcode =:this.il_groupcode ) ) ) AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND ( item.Restricted ='N' OR ( Item.Restricted ='Y' AND Exists ( select *from grouprights where rightcode =515 and groupcode =:this.il_groupcode ) ) ) USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_expiryintimation.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	long iccode
	long icatcode
	long packcode
	long manfcode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_expiryintimation.wf_getmaxdate(datetime ad_date) returns integer
	SQL Select Max ( Date ) INTO :ad_date From saleledger USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_expiryintimation.wf_isinvoiceinuse(long al_invoiceno) returns boolean
	long ll_found
	SQL Select count ( *) INTO :ll_found From ExpiryIntimation Where IntimationCode =:al_invoiceno and Posted ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_found = 0 or isnull(ll_found) then
			ll_found = 0
			SQL Select count ( *) INTO :ll_found From ExpiryIntimation With ( ReadPast , RowLock , UpdLock ) Where IntimationCode =:al_invoiceno USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ll_found = 0 then
					return true
				else
					return false
				end if
			else
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_expiryintimation.wf_isposted(long al_invcode) returns boolean
	long ll_count
	SQL SELECT Count ( IntimationCode ) INTO :ll_count FROM ExpiryIntimation WHERE IntimationCode =:al_invcode and Posted ='Y' USING sqlca;
	if sqlca.sqlcode = 0 then
		if ll_count > 0 then
			return true
		else
			return false
		end if
		return
	end if
	return false

// w_expiryintimation.wf_print() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_count
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			for ll_count = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
				this.id_print.retrieve(ll_count)
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			next
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	return li_errcode

// w_expiryintimation.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_expiryintimation.wf_setfocuswithscroll(string as_colname, long al_row) returns integer
	this.id_detail.scrolltorow(al_row)
	this.id_detail.setcolumn(as_colname)
	this.id_detail.setfocus()
	this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	return 1

// w_expiryintimation.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	long ll_icode
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean lb_rtflag
	boolean ib_due
	integer li_null
	string ls_null
	ls_titleerrtext = "Item Validation"
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), al_currrow) = true then
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
	elseif not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		li_errcode = -1
		ls_titleerrtext = "Item Validation"
	end if
	if li_errcode = -1 and not ib_due then
		lb_rtflag = false
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setitem(al_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(al_currrow, "icode", li_null)
		this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	end if
	return lb_rtflag

// w_expiryintimation.wf_validateitem(boolean ab_flag) returns integer
	long ll_icode
	long ll_count
	long ll_duprow
	long ll_null
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	string ls_null
	string ls_batch
	datetime ldt_null
	datetime ldt_expiry
	integer li_errcode
	integer li_option
	integer n
	integer li_null
	boolean lb_dupitem
	boolean lb_zerostock
	boolean lb_invalidrow
	setnull(ldt_null)
	setnull(ls_null)
	setnull(ll_null)
	if isnull(this.il_currrow) or this.il_currrow <= 0 then
		lb_invalidrow = true
		setnull(ll_icode)
	else
		ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	end if
	if not isnull(ll_icode) then
		if not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
			ls_titleerrtext = "Item Validation"
		end if
	end if
	if ab_flag then
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		if lb_invalidrow = true then
			li_errcode = -1
		else
			ls_titleerrtext = "Item Validation"
			messagebox(ls_titleerrtext, ls_errtext)
			if f_stringpreferences("itemcode") = "N" then
				this.id_detail.setcolumn(this.is_columnitemname)
				this.ib_itemslistopen = true
				this.id_itemslist.show()
			else
				this.id_detail.setcolumn("fullcode")
				this.id_detail.object.fullcode[this.il_currrow] = ls_null
			end if
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.icode[this.il_currrow] = li_null
			this.id_detail.object.itemname[this.il_currrow] = ls_null
			this.id_detail.object.qty[this.il_currrow] = 1
			this.id_detail.object.packprice[this.il_currrow] = 0
			this.id_detail.object.price[this.il_currrow] = 0
			this.id_detail.object.packunits[this.il_currrow] = 1
			this.id_detail.object.invoicecode[this.il_currrow] = ll_null
			this.id_detail.object.invoicedate[this.il_currrow] = ldt_null
			this.id_detail.object.refno[this.il_currrow] = ls_null
			this.id_detail.object.refdate[this.il_currrow] = ldt_null
		end if
	end if
	return li_errcode

// w_expiryintimation.wf_validateitemnew() returns integer
	long ll_icode
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
		messagebox(ls_titleerrtext, ls_errtext)
	elseif not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		ls_titleerrtext = "Item Validation"
		li_errcode = -2
	end if
	this.ib_itemvalidated = true
	return li_errcode

// w_expiryintimation.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	real lr_itemstotal
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
		ld_grandtotal = ld_detaildwtotal
		ld_grandtotal = round(ld_grandtotal, 0)
		this.id_footer.setitem(1, "amount", ld_grandtotal)
	end if
	return ld_grandtotal

// w_expiryintimation.wf_selectprintreport(string as_invoicesize) returns string
	string ls_report
	if gs_company = "BILAL" then
		ls_report = "d_bilal_expiryintimation_print"
	elseif gs_company = "TAJMEDICOSWH" or gs_company = "TAJMEDICOS3" or gs_company = "TAJMEDISURGICAL" or gs_company = "TAJMEDICOSSSGC" or gs_company = "TAJMEDICOSKT" then
		ls_report = "d_tajmedicoswh_expiryintimation_print"
	else
		ls_report = "d_expiryintimation_print"
	end if
	this.id_print.dataobject = ls_report
	this.id_print.settransobject(this.it_transobject)
	return ls_report

// w_expiryintimation.wf_post() returns integer
	integer li_errcode
	long ll_counter
	long ll_invcount
	long ll_invcode
	long ll_null
	long ll_glvochcode
	long ll_vochcode
	long ll_salesmancode
	long ll_vochcatcode
	long ll_acccode
	long ll_dr_acccode
	long ll_cr_acccode
	double ld_amount
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_remarks
	string ls_null
	char lc_posted
	boolean lb_flag
	s_arguements lstr_arginfo
	setnull(ll_null)
	setnull(ls_null)
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				setpointer(arrow!)
				return -1
			end if
			SQL rollback USING this.it_transobject;
			SQL update DBO.ExpiryIntimation SET Posted ='Y' , PostDate =:ldt_server_datetime , PostedBy =:ll_salesmancode WHERE Posted ='N' AND IntimationTypeCode =:this.ii_intimationtype AND IntimationCode BETWEEN :lstr_arginfo.l_code1 AND :lstr_arginfo.l_code2 USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Posting Problem!", "Problem in Posting Expiry Intimation.~r~nDetails: " + this.it_transobject.sqlerrtext, stopsign!)
				li_errcode = -1
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode = 0 then
			messagebox("Posting Successfull", "All rows have been posted successfully")
		end if
	end if
	return li_errcode

// w_expiryintimation.wf_inititeminfo(long al_icode, long al_row, integer ai_rtcode, string as_errortext) returns boolean
	boolean retflag
	long ll_null
	long ll_packunits
	long ll_manfcode
	double ld_purprice
	double ld_saleprice
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_remarks
	string ls_packingdesc
	setnull(ll_null)
	setnull(ls_null)
	SQL SELECT item.customicode , item.name , item.packunits , item.packingdesc , item.purprice , item.saleprice , item.manfcode INTO :ls_fullcode, :ls_name, :ll_packunits, :ls_packingdesc, :ld_purprice, :ld_saleprice, :ll_manfcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if retflag then
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		this.id_detail.setitem(al_row, "icode", al_icode)
		this.id_detail.setitem(al_row, "packingdesc", ls_packingdesc)
		this.id_detail.setitem(al_row, "packunits", ll_packunits)
		this.id_detail.setitem(al_row, "manfcode", ll_manfcode)
		if this.ii_intimationtype = 1 then
			this.id_detail.setitem(al_row, "packprice", ld_purprice)
			this.id_detail.setitem(al_row, "price", ld_purprice / ll_packunits)
		else
			this.id_detail.setitem(al_row, "packprice", ld_saleprice)
			this.id_detail.setitem(al_row, "price", ld_saleprice / ll_packunits)
		end if
	else
		retflag = false
		as_errortext = "Item can not be selected"
	end if
	this.id_detail.setitem(al_row, "itemcode", al_icode)
	return retflag

// w_expiryintimation.wf_initmodify(integer ai_protect) returns 0
	long ll_code
	long ll_icode
	long ll_counter
	long ll_count
	double ld_qty
	if this.id_master.getitemstring(1, "posted") = "N" then
		this.id_master.setitem(1, "sitecode", gl_sitecode)
		ll_code = this.id_detail.getitemnumber(1, "code")
		if wf_lockintimation(ll_code) = 0 then
			this.id_master.retrieve(ll_code)
			this.id_detail.retrieve(ll_code)
			if ai_protect = 0 then
				this.ib_modify = true
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
			return
		end if
		messagebox("Cannot Modify", "This Intimation Document is already in use. Document Code = " + string(ll_code))
	end if

// w_expiryintimation.wf_populatedetail(long al_invid, datawindow ad_saledetail, string as_errortext, long al_errorrow) returns boolean
	long ll_detailrows
	long ll_icode
	long ll_errrowid
	long ll_salesmancode
	long li_counter
	long li_innercounter
	long ll_itemsdetailrowcount
	long ll_rowgroup
	long ll_row
	boolean lb_commitflag
	dwitemstatus ldws_column
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	ll_itemsdetailrowcount = 0
	as_errortext = "    Some database problem ocuurs         "
	ll_rowgroup = 0
	do while li_counter <= ll_detailrows and lb_commitflag
		ll_rowgroup = ll_rowgroup + 1
		ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
		ll_row = ad_saledetail.insertrow(0)
		ad_saledetail.setitem(ll_row, "code", al_invid)
		ad_saledetail.setitem(ll_row, "icode", this.id_detail.getitemnumber(li_counter, "icode"))
		ad_saledetail.setitem(ll_row, "packingdesc", this.id_detail.object.packingdesc[li_counter])
		ad_saledetail.setitem(ll_row, "batch", this.id_detail.object.batch[li_counter])
		ad_saledetail.setitem(ll_row, "expiry", this.id_detail.object.expiry[li_counter])
		ad_saledetail.setitem(ll_row, "qty", this.id_detail.object.qty[li_counter])
		ad_saledetail.setitem(ll_row, "packprice", this.id_detail.object.packprice[li_counter])
		ad_saledetail.setitem(ll_row, "price", this.id_detail.object.price[li_counter])
		ad_saledetail.setitem(ll_row, "packunits", this.id_detail.object.packunits[li_counter])
		ad_saledetail.setitem(ll_row, "invoicecode", this.id_detail.object.invoicecode[li_counter])
		ad_saledetail.setitem(ll_row, "invoicedate", this.id_detail.object.invoicedate[li_counter])
		ad_saledetail.setitem(ll_row, "refno", this.id_detail.object.refno[li_counter])
		ad_saledetail.setitem(ll_row, "refdate", this.id_detail.object.refdate[li_counter])
		ad_saledetail.setitem(ll_row, "ManfCode", this.id_detail.object.manfcode[li_counter])
		ad_saledetail.setitem(ll_row, "LastAccCode", this.id_detail.object.lastacccode[li_counter])
		li_counter = li_counter + 1
	loop
	if not lb_commitflag then
		al_errorrow = li_counter - 1
		messagebox("Database Error", as_errortext)
	end if
	return lb_commitflag

