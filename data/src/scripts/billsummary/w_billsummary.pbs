// window w_billsummary (billsummary)  ancestor: w_multi_entry

// w_billsummary.wf_deleteallemptydetailrows() returns integer
	long ll_count
	long ll_deletecount
	long ll_code
	long ll_rowcount
	long ll_custcode
	ll_deletecount = 0
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 0 then
		for ll_count = 1 to this.id_detail.rowcount()
			ll_code = this.id_detail.getitemnumber(ll_count, "saleinvcode")
			ll_custcode = this.id_detail.getitemnumber(ll_count, "custcode")
			if ll_code <= 0 and ll_custcode <= 0 then
				ll_deletecount = ll_deletecount + 1
				this.id_detail.deleterow(ll_count)
			end if
		next
		for ll_count = 1 to this.id_detail.rowcount()
			ll_code = this.id_detail.getitemnumber(ll_count, "saleinvcode")
			ll_custcode = this.id_detail.getitemnumber(ll_count, "custcode")
			if ll_code <= 0 and ll_custcode <= 0 then
				ll_deletecount = ll_deletecount + 1
				this.id_detail.deleterow(ll_count)
			end if
		next
	end if
	return ll_deletecount

// w_billsummary.wf_deleteemptydetailrow() returns integer
	long ll_rowcount
	long ll_code
	long ll_custcode
	integer li_rtcode
	ll_rowcount = this.id_detail.rowcount()
	ll_code = this.id_detail.getitemnumber(ll_rowcount, "saleinvcode")
	ll_custcode = this.id_detail.getitemnumber(ll_rowcount, "custcode")
	if ll_rowcount > 1 and (ll_custcode <= 0 and ll_code <= 0) then
		this.id_detail.deleterow(ll_rowcount)
		li_rtcode = 1
		setfocus()
	end if
	return li_rtcode

// w_billsummary.wf_lockinvoice(long al_invcode) returns integer
	integer li_count
	this.it_transobject.dbparm = " Async =1, DBGetTime = 20"
	this.it_transobject.lockbillsummary(al_invcode, al_invcode)
	this.it_transobject.dbparm = "Async =0, DBGetTime = 0"
	return this.it_transobject.sqlcode

// w_billsummary.wf_populateinvoices() returns long
	datastore lds_bills
	long ll_detailrows
	long ll_count
	long ll_duplrows
	long ll_invcode
	long ll_row
	long ll_custcode
	long ll_oldcustcode
	long ll_newcust_row
	long ll_retcode
	long ll_billsumm
	long ll_rowcount
	long ll_rtcode
	long ll_retrievecount
	long ll_lockedcount
	long ll_format = 1
	string ls_fullcode
	double ld_cust_invtotal
	double ld_invtotal
	integer li_result
	integer li_rtncode
	boolean populateflag = true
	string ls_remarks
	string ls_oldareaname
	s_arguements lstr_billsum
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		if this.id_detail.object.saleinvcode[1] > 0 or this.id_detail.object.custcode[1] > 0 then
			li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
			if li_result = 1 then
				for ll_count = 1 to ll_detailrows
					this.id_detail.deleterow(0)
				next
				if this.id_detail.update() <> 1 then
					messagebox("DataBase Problem", "Problem in Deleting Rows")
					return 0
				end if
			else
				populateflag = false
			end if
		else
			this.id_detail.reset()
		end if
	end if
	if populateflag = true then
		lds_bills = create datastore
		open(w_select_invoicerange_period)
		ll_format = message.doubleparm
		if this.id_master.object.billsummarytypecode[1] = 1 then
			if ll_format = 1 then
				open(w_arg_billsummary_population)
				lds_bills.dataobject = "d_billsummary_population"
			else
				open(w_arg_billsummary_population_period)
				lds_bills.dataobject = "d_billsummary_population_period"
			end if
		elseif ll_format = 1 then
			open(w_arg_billsummary_population_invbased)
			lds_bills.dataobject = "d_billsummary_population_invbased"
		else
			open(w_arg_billsummary_pop_invbased_period)
			lds_bills.dataobject = "d_billsummary_population_invbased_period"
		end if
		lstr_billsum = message.powerobjectparm
		lds_bills.settransobject(this.it_transobject)
		if this.id_master.object.billsummarytypecode[1] = 1 then
			if ll_format = 1 then
				ll_rtcode = lds_bills.retrieve(lstr_billsum.ia_integerlist, lstr_billsum.l_code1, lstr_billsum.l_code2, lstr_billsum.s_name1, lstr_billsum.l_code3, lstr_billsum.l_code4)
			else
				ll_rtcode = lds_bills.retrieve(lstr_billsum.ia_integerlist, lstr_billsum.d_sdate, lstr_billsum.d_edate, lstr_billsum.s_name1, lstr_billsum.l_code3, lstr_billsum.l_code4)
			end if
		elseif ll_format = 1 then
			ll_rtcode = lds_bills.retrieve(lstr_billsum.ia_integerlist, lstr_billsum.d_sdate, lstr_billsum.d_edate)
		else
			ll_rtcode = lds_bills.retrieve(lstr_billsum.ia_integerlist, lstr_billsum.d_sdate, lstr_billsum.d_edate)
		end if
		this.id_detail.reset()
		ll_rowcount = lds_bills.rowcount()
		setnull(ll_newcust_row)
		for ll_count = 1 to ll_rowcount
			if ls_oldareaname <> lds_bills.object.areaname[ll_count] then
				ls_oldareaname = lds_bills.object.areaname[ll_count]
				ls_remarks = ls_remarks + ls_oldareaname + ", "
			end if
			ll_custcode = lds_bills.object.custcode[ll_count]
			ll_invcode = lds_bills.object.saleinvcode[ll_count]
			if ll_invcode > 0 then
				ll_row = this.id_detail.insertrow(0)
				ll_retcode = wf_validateinvcode(ll_row, ll_invcode, ll_billsumm, 1)
				if ll_retcode = 0 then
					ll_retrievecount = ll_retrievecount + 1
				else
					this.id_detail.deleterow(ll_row)
				end if
			elseif ll_custcode > 0 then
				ll_row = this.id_detail.insertrow(0)
				ll_retcode = wf_setcustomerinfo(ll_custcode, ll_row)
				if ll_retcode = 0 then
					ll_retrievecount = ll_retrievecount + 1
				else
					this.id_detail.deleterow(ll_row)
				end if
			end if
			if ll_retcode = 0 and this.id_master.object.billsummarytypecode[1] = 1 then
				ld_invtotal = this.id_detail.object.netamount[ll_row]
				if isnull(ld_invtotal) then
					ld_invtotal = 0
				end if
				if ll_oldcustcode = ll_custcode then
					ld_cust_invtotal = ld_cust_invtotal + ld_invtotal
					if ll_row > 0 then
						this.id_detail.object.accbalance[ll_row] = 0.00
					end if
				else
					if ll_newcust_row > 0 then
						this.id_detail.object.accbalance[ll_newcust_row] = this.id_detail.object.accbalance[ll_newcust_row] - ld_cust_invtotal
					end if
					ll_newcust_row = ll_row
					ld_cust_invtotal = ld_invtotal
					ll_oldcustcode = ll_custcode
				end if
			end if
		next
		if ll_oldcustcode = ll_custcode and ll_newcust_row > 0 then
			this.id_detail.object.accbalance[ll_newcust_row] = this.id_detail.object.accbalance[ll_newcust_row] - ld_cust_invtotal
		end if
		destroy lds_bills
		this.id_master.object.remarks[1] = left(ls_remarks, len(ls_remarks) - 1)
		if ll_retrievecount = ll_rowcount then
			messagebox("Result", string(ll_rowcount) + " Records are populated. ")
		else
			messagebox("Result", "Total records in the selection criteria were " + string(ll_rowcount) + "~n~r" + string(ll_retrievecount) + " records populated successfully~n~r" + string(ll_rowcount - ll_retrievecount) + " records are not populated successfully~n~r" + "beacuse they are already included in some other bill summary statements.")
		end if
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_billsummary.wf_assigndatawindowobjects(string as_detaildw, string as_hiddendw) returns 0
	this.id_detail.dataobject = as_detaildw
	this.id_detail.settransobject(this.it_transobject)
	this.dw_invdetail.dataobject = as_hiddendw
	this.id_invdetail = this.dw_invdetail
	this.id_invdetail.settransobject(this.it_transobject)

// w_billsummary.wf_setbalance(long al_custcode, long ll_row) returns long
	long ll_retcode
	double ld_balance
	SQL SELECT Balance =ISNULL ( DBO.fn_AccountBalance ( GETDATE ( ) , :al_custcode ) , 0 ) INTO :ld_balance FROM Customer WHERE CustCode =:al_custcode USING sqlca;   /* bind positions inferred */
	if sqlca.sqlcode = 0 then
		this.id_detail.object.accbalance[ll_row] = ld_balance
		ll_retcode = 0
	else
		ll_retcode = -1
	end if
	return ll_retcode

// w_billsummary.wf_findcustcode(string as_aliasname, long al_custcode) returns long
	long ll_custcode
	long ll_retflag
	string ls_aliasname
	SQL SELECT A.AliasName , A.AccCode INTO :ls_aliasname, :ll_custcode FROM Accounts A , Customer C WHERE A.AliasName =:as_aliasname AND A.AccCode =C.CustCode AND A.Active ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_custcode = ll_custcode
		ll_retflag = 0
	else
		ll_retflag = 1
	end if
	return ll_retflag

// w_billsummary.wf_setcustomerinfo(long al_custcode, long al_row) returns long
	long ll_custcode
	long ll_retflag
	long ll_null
	string ls_aliasname
	double ld_null
	setnull(ll_null)
	setnull(ld_null)
	SQL SELECT A.AliasName , A.AccCode INTO :ls_aliasname, :ll_custcode FROM Accounts A , Customer C WHERE A.AccCode =:al_custcode AND A.AccCode =C.CustCode AND A.Active ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_retflag = 0
		this.id_detail.object.aliasname[al_row] = ls_aliasname
		this.id_detail.object.custcode[al_row] = ll_custcode
		this.id_detail.object.saleinvcode[al_row] = ll_null
		this.id_detail.object.netamount[al_row] = 0.00
		this.id_detail.object.outstandingamt[al_row] = 0.00
		wf_setbalance(ll_custcode, al_row)
	else
		ll_retflag = 1
	end if
	return ll_retflag

// w_billsummary.wf_execute_virtualgl() returns integer
	sqlca.virtualgl("A")
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
	else
		SQL rollback USING sqlca;
	end if
	return 0

// w_billsummary.wf_refreshitemslist() returns 0
	wf_execute_virtualgl()

// w_billsummary.wf_savedetail(long al_code) returns boolean
	long ll_detailrows
	long ll_counter
	long ll_invcode
	long ll_rowscount
	long ll_null
	long ll_insrow
	long ll_unpostedtrans
	double ld_invbalance
	double ld_newbalance
	double ld_affectiveamt
	boolean lb_continue = true
	string ls_msg
	string ls_errortext
	setnull(ll_null)
	ll_detailrows = this.id_detail.rowcount()
	ll_counter = 1
	if ll_detailrows > 0 then
		for ll_counter = 1 to ll_detailrows
			ll_invcode = this.id_detail.object.saleinvcode[ll_counter]
			ld_affectiveamt = this.id_detail.object.debitnoteamt[ll_counter] - this.id_detail.object.creditnoteamt[ll_counter] - this.id_detail.object.cashamt[ll_counter] - this.id_detail.object.chequeamt[ll_counter]
			if ll_invcode > 0 then
				ls_msg = "000                                                                                                                                 "
				this.it_transobject.checkunpostedsaleinvintransactions(ll_invcode, al_code, "BS", ll_unpostedtrans, ls_msg)
				if ll_unpostedtrans > 0 then
					ls_errortext = "Unposted Transaction(s) Exist for this Invoice~r~n~r~n" + ls_msg
					lb_continue = false
					exit
				end if
				this.it_transobject.getsaleinvbalance(ll_invcode, ld_invbalance)
				if this.it_transobject.sqlcode <> 0 then
					goto L836
				end if
				ls_errortext = "Problem in fetching Sale Invoice Balance for sale invoice code:" + trim(string(ll_invcode)) + "~r~n~r~n" + this.it_transobject.sqlerrtext
				lb_continue = false
				exit
			end if
			ll_insrow = this.id_invdetail.insertrow(0)
			this.id_invdetail.object.code[ll_insrow] = al_code
			this.id_invdetail.object.aliasname[ll_insrow] = this.id_detail.object.aliasname[ll_counter]
			this.id_invdetail.object.custcode[ll_insrow] = this.id_detail.object.custcode[ll_counter]
			this.id_invdetail.object.accbalance[ll_insrow] = this.id_detail.object.accbalance[ll_counter]
			this.id_invdetail.object.saleinvcode[ll_insrow] = this.id_detail.object.saleinvcode[ll_counter]
			this.id_invdetail.object.netamount[ll_insrow] = this.id_detail.object.netamount[ll_counter]
			if ll_invcode > 0 then
				this.id_invdetail.object.outstandingamt[ll_insrow] = ld_invbalance
			else
				this.id_invdetail.object.outstandingamt[ll_insrow] = this.id_detail.object.outstandingamt[ll_counter]
			end if
			this.id_invdetail.object.cashamt[ll_insrow] = this.id_detail.object.cashamt[ll_counter]
			this.id_invdetail.object.cashacccode[ll_insrow] = this.id_detail.object.cashacccode[ll_counter]
			this.id_invdetail.object.chequeamt[ll_insrow] = this.id_detail.object.chequeamt[ll_counter]
			this.id_invdetail.object.bankacccode[ll_insrow] = this.id_detail.object.bankacccode[ll_counter]
			this.id_invdetail.object.debitnoteamt[ll_insrow] = this.id_detail.object.debitnoteamt[ll_counter]
			this.id_invdetail.object.debitnoteacccode[ll_insrow] = this.id_detail.object.debitnoteacccode[ll_counter]
			this.id_invdetail.object.debitnoteamt[ll_insrow] = this.id_detail.object.debitnoteamt[ll_counter]
			this.id_invdetail.object.debitnoteacccode[ll_insrow] = this.id_detail.object.debitnoteacccode[ll_counter]
			this.id_invdetail.object.creditnoteamt[ll_insrow] = this.id_detail.object.creditnoteamt[ll_counter]
			this.id_invdetail.object.creditnoteacccode[ll_insrow] = this.id_detail.object.creditnoteacccode[ll_counter]
			this.id_invdetail.object.srbufferinvcode[ll_insrow] = this.id_detail.object.srbufferinvcode[ll_counter]
			this.id_invdetail.object.salereturnamt[ll_insrow] = this.id_detail.object.salereturnamt[ll_counter]
			this.id_invdetail.object.billsonhandbreakup[ll_insrow] = this.id_detail.object.billsonhandbreakup[ll_counter]
			this.id_invdetail.object.remarks[ll_insrow] = this.id_detail.object.remarks[ll_counter]
		next
	else
		lb_continue = false
	end if
	if lb_continue = false then
		messagebox("Saving Problem", ls_errortext, stopsign!)
	end if
	return lb_continue

// w_billsummary.wf_deletebillsummarydetail(long al_code) returns integer
	SQL DELETE BillSummaryDetail WHERE BillSummaryCode =:al_code USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		return 0
	end if
	return -1

// w_billsummary.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_billsummary.wf_set_account(string as_colname, long al_row) returns long
	s_billsummary_account ls_billsum
	if lower(as_colname) = "cashamt" then
		ls_billsum.acccode = this.id_detail.object.cashacccode[al_row]
		ls_billsum.name = "Select Cash Account Title/Name"
		ls_billsum.cat = 12
	elseif lower(as_colname) = "chequeamt" then
		ls_billsum.acccode = this.id_detail.object.bankacccode[al_row]
		ls_billsum.name = "Select Bank Account Title/Name"
		ls_billsum.cat = 13
	elseif lower(as_colname) = "debitnoteamt" then
		ls_billsum.acccode = this.id_detail.object.debitnoteacccode[al_row]
		ls_billsum.name = "Select Debit Note Account Title/Name"
		ls_billsum.cat = 21
	elseif lower(as_colname) = "creditnoteamt" then
		ls_billsum.acccode = this.id_detail.object.creditnoteacccode[al_row]
		ls_billsum.name = "Select Credit Note Account Title/Name"
		ls_billsum.cat = 22
	end if
	openwithparm(w_billsummary_acccountselection, ls_billsum)
	ls_billsum = message.powerobjectparm
	if ls_billsum.status then
		if lower(as_colname) = "cashamt" then
			this.id_detail.object.cashacccode[al_row] = ls_billsum.acccode
		elseif lower(as_colname) = "chequeamt" then
			this.id_detail.object.bankacccode[al_row] = ls_billsum.acccode
		elseif lower(as_colname) = "debitnoteamt" then
			this.id_detail.object.debitnoteacccode[al_row] = ls_billsum.acccode
		elseif lower(as_colname) = "creditnoteamt" then
			this.id_detail.object.creditnoteacccode[al_row] = ls_billsum.acccode
		end if
	end if
	return 0

// w_billsummary.wf_assign_sr_dataobjects() returns long
	return 0

// w_billsummary.wf_show_salereturn(long al_row) returns 0

// w_billsummary.wf_save_salereturn(integer ai_mode, long al_usercode, long al_retinvcode) returns long
	return 0

// w_billsummary.wf_set_salereturn_amount(long al_row) returns long
	long ll_retinvcode
	long ll_saleinvcode
	double ld_returnamt
	if al_row > 0 then
		ll_retinvcode = this.id_detail.object.srbufferinvcode[al_row]
		if ll_retinvcode > 0 then
			SQL SELECT RetAmt =ISNULL ( DBO.fn_GetSRBufferInvTotal ( T.SRBufferInvCode ) , 0 ) , T.Saleinvcode INTO :ld_returnamt, :ll_saleinvcode FROM SRBufferLedger T WHERE T.SRBufferInvCode =:ll_retinvcode USING sqlca;
			if sqlca.sqlcode = 0 then
				if ld_returnamt < 0.0 then
					ld_returnamt = 0.00
				end if
			else
				ld_returnamt = 0.00
			end if
		end if
	end if
	this.id_detail.object.salereturnamt[al_row] = ld_returnamt
	this.id_detail.object.refsaleinvcode[al_row] = ll_saleinvcode
	return 0

// w_billsummary.wf_open_item_form_popup() returns 0
	openwithparm(w_salereturnbuffer_popup, this, this)

// w_billsummary.wf_request_open_salereturn() returns 0
	this.id_master.accepttext()
	this.id_detail.accepttext()
	this.istr_buffer.i_status = 1
	this.istr_buffer.l_code1 = this.id_detail.object.srbufferinvcode[this.id_detail.getrow()]
	this.istr_buffer.l_code2 = -100
	this.istr_buffer.l_code3 = this.id_detail.object.custcode[this.id_detail.getrow()]
	this.istr_buffer.l_code4 = 0
	setnull(this.istr_buffer.l_code5)

// w_billsummary.wf_request_referenced_salereturn() returns 0
	this.id_master.accepttext()
	this.id_detail.accepttext()
	this.istr_buffer.i_status = 1
	this.istr_buffer.l_code1 = this.id_detail.object.srbufferinvcode[this.id_detail.getrow()]
	this.istr_buffer.l_code2 = this.id_detail.object.saleinvcode[this.id_detail.getrow()]
	this.istr_buffer.l_code3 = this.id_detail.object.custcode[this.id_detail.getrow()]
	this.istr_buffer.l_code4 = 1

// w_billsummary.wf_finalize_billsummary() returns long
	integer li_errcode
	long ll_salesmancode
	long ll_invcount
	long ll_counter = 1
	boolean lb_flag
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			li_errcode = sqlca.lockbillsummary(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
			if li_errcode = 0 then
				sqlca.finalizebillsummary(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode)
				if sqlca.sqlcode <> 0 then
					li_errcode = -1
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Bill Summary Finalization Fails", "Some database request fails, Please try again")
		else
			messagebox("Bill Summary Finalization", "Finalization Successfull")
		end if
	end if
	return li_errcode

// w_billsummary.wf_post() returns long
	integer li_errcode
	long ll_salesmancode
	long ll_invcount
	long ll_counter
	boolean lb_flag
	string ls_errtext
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING this.it_transobject;
			this.it_transobject.postbillsummary(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode, "Y")
			if this.it_transobject.sqlcode <> 0 then
				ls_errtext = "Some database request fails, Please try again. Details are:-~r~n  " + this.it_transobject.sqlerrtext
				li_errcode = -1
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				ls_errtext = "Some database request fails, Please try again. Details are:-~r~n  " + this.it_transobject.sqlerrtext
				li_errcode = -1
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Bill Summary Posting Fails", ls_errtext)
		else
			messagebox("Bill Summary Posting Successfull", "All rows have been Posted successfully")
		end if
	end if
	return li_errcode

// w_billsummary.wf_return_billsummary(long al_invid, string as_errortext) returns boolean
	long ll_invcode
	long ll_counter
	long ll_detailrows
	long ll_masterrow
	boolean lb_commitflag = true
	double ld_amt
	double ld_oldtotalamt
	double ld_balance
	double ld_totalamt
	double ld_newbalance
	this.id_invdetail.retrieve(al_invid)
	as_errortext = "Some database problem occur"
	ll_detailrows = this.id_invdetail.rowcount()
	ll_counter = 1
	do while ll_counter <= ll_detailrows and lb_commitflag
		ll_invcode = this.id_invdetail.getitemnumber(ll_counter, "saleinvcode")
		if not isnull(ll_invcode) then
			ld_amt = this.id_invdetail.object.cashamt[ll_counter] + this.id_invdetail.object.chequeamt[ll_counter] + this.id_invdetail.object.creditnoteamt[ll_counter] - this.id_invdetail.object.debitnoteamt[ll_counter]
			this.it_transobject.getsaleinvbalance(ll_invcode, ld_balance)
			if this.it_transobject.sqlcode = 0 then
				if ld_amt <> 0.0 and lb_commitflag then
					ld_newbalance = ld_balance + ld_amt
					if ld_newbalance >= 0.0 then
						this.it_transobject.updatesaleinvbalance(ll_invcode, ld_newbalance)
						if this.it_transobject.sqlcode <> 0 then
							lb_commitflag = false
							as_errortext = "Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
							return lb_commitflag
						end if
					else
						lb_commitflag = false
						as_errortext = "Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
						return lb_commitflag
					end if
				else
					lb_commitflag = false
					as_errortext = "Not Enough Balance On Sale Invoice."
					return lb_commitflag
				end if
				goto L880
			end if
			lb_commitflag = false
			as_errortext = "Balance Retrieval Error:~r~n" + this.it_transobject.sqlerrtext
			return lb_commitflag
		end if
		ll_counter = ll_counter + 1
	loop
	return lb_commitflag

// w_billsummary.wf_set_initial_accounts(integer ai_type) returns long
	long ll_rowcount
	long ll_acccode
	datastore lds_acc
	lds_acc = create datastore
	lds_acc.dataobject = "ddd_vouchheaderaccounts"
	lds_acc.settransobject(sqlca)
	setnull(ll_acccode)
	ll_acccode = f_numberpreferences("defaultcashacc_inbillsum")
	if ll_acccode = 0 or isnull(ll_acccode) then
		if ai_type = 1 then
			lds_acc.retrieve(2)
		else
			lds_acc.retrieve(12)
		end if
		ll_rowcount = lds_acc.rowcount()
		if ll_rowcount > 0 then
			this.id_detail.object.cashacccode.initial = trim(string(lds_acc.object.acccode[1]))
		end if
	else
		this.id_detail.object.cashacccode.initial = trim(string(ll_acccode))
	end if
	setnull(ll_acccode)
	ll_acccode = f_numberpreferences("defaultbankacc_inbillsum")
	if ll_acccode = 0 or isnull(ll_acccode) then
		if ai_type = 1 then
			lds_acc.retrieve(4)
		else
			lds_acc.retrieve(13)
		end if
		ll_rowcount = lds_acc.rowcount()
		if ll_rowcount > 0 then
			this.id_detail.object.bankacccode.initial = trim(string(lds_acc.object.acccode[1]))
		end if
	else
		this.id_detail.object.bankacccode.initial = trim(string(ll_acccode))
	end if
	setnull(ll_acccode)
	ll_acccode = f_numberpreferences("defaultdrnoteacc_inbillsum")
	if ll_acccode = 0 or isnull(ll_acccode) then
		if ai_type = 1 then
			lds_acc.retrieve(19)
		else
			lds_acc.retrieve(21)
		end if
		ll_rowcount = lds_acc.rowcount()
		if ll_rowcount > 0 then
			this.id_detail.object.debitnoteacccode.initial = trim(string(lds_acc.object.acccode[1]))
		end if
	else
		this.id_detail.object.debitnoteacccode.initial = trim(string(ll_acccode))
	end if
	setnull(ll_acccode)
	ll_acccode = f_numberpreferences("defaultcrnoteacc_inbillsum")
	if ll_acccode = 0 or isnull(ll_acccode) then
		if ai_type = 1 then
			lds_acc.retrieve(20)
		else
			lds_acc.retrieve(22)
		end if
		ll_rowcount = lds_acc.rowcount()
		if ll_rowcount > 0 then
			this.id_detail.object.creditnoteacccode.initial = trim(string(lds_acc.object.acccode[1]))
		end if
	else
		this.id_detail.object.creditnoteacccode.initial = trim(string(ll_acccode))
	end if
	return 0

// w_billsummary.wf_setbillsummarytype(integer ai_type) returns long
	long ll_totrows
	long ll_row
	string ls_dataobject
	setredraw(false)
	ls_dataobject = this.id_detail.dataobject
	this.id_detail.dataobject = ls_dataobject
	this.id_detail.settransobject(this.it_transobject)
	ll_totrows = this.id_detail.rowcount()
	ll_row = 0
	do while ll_totrows > 0 and ll_row <= ll_totrows
		this.id_detail.deleterow(ll_row)
		ll_row = ll_row + 1
	loop
	wf_set_initial_accounts(ai_type)
	wf_set_column_on_off(ai_type)
	setredraw(true)
	return 0

// w_billsummary.wf_set_column_on_off(integer ai_type) returns long
	if ai_type = 1 then
		this.id_detail.object.aliasname.protect = 0
		this.id_detail.object.custcode.protect = 0
		this.id_detail.object.accbalance.visible = true
		this.id_detail.object.saleinvcode.visible = true
		this.id_detail.object.netamount.visible = true
		this.id_detail.object.outstandingamt.visible = false
		this.id_detail.object.c_totreceivable.visible = true
