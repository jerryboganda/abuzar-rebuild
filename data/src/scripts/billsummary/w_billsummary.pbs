// w_billsummary.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_billsummarymenu" then
		this.menuid = create m_billsummarymenu
	end if
	this.dw_invdetail = create dw_invdetail
	this.dw_print = create dw_print
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_invdetail
	this.control[icurrent + 2] = this.dw_print

// w_billsummary.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_invdetail
	destroy this.dw_print

// w_billsummary.ue_save() returns 0 [event]
	long ll_detailrows
	long ll_salesmancode
	long ll_errrowid
	long ll_counter
	long ll_count
	long ll_null
	long ll_maxretcode
	long ll_invid
	long ll_mastercurrrow
	long ll_code
	long ll_billsumcode
	long ll_invcode
	long ll_unpostedtrans
	boolean lb_commitflag = true
	boolean lb_continue = true
	datetime ldt_server_datetime
	string ls_errtext
	string ls_date_errtext
	string ls_msg
	ll_detailrows = this.id_detail.rowcount()
	ll_mastercurrrow = this.id_master.rowcount()
	if ll_detailrows > 0 then
		for ll_counter = 1 to ll_detailrows
			if not (this.id_detail.object.saleinvcode[ll_counter] > 0 or this.id_detail.object.custcode[ll_counter] > 0) then
				this.id_detail.deleterow(ll_counter)
			end if
		next
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	wf_deleteemptydetailrow()
	wf_deleteallemptydetailrows()
	if this.id_detail.rowcount() <= 0 then
		messagebox("Rows Validation", "Please insert a row before proceeding")
		return
	end if
	if this.id_master.object.billsummarytypecode[1] <> 1 then
		ll_detailrows = this.id_detail.rowcount()
		if ll_detailrows > 0 then
			for ll_counter = 1 to ll_detailrows
				if this.id_detail.getitemnumber(ll_counter, "c_invbalance") < 0.0 then
					messagebox("Sale Invoice Validation", "Invoice Balance Can not be -ve.~r~nEither you have entered some wrong amount / return.~r~nPlease recheck and make desired adjustments.")
					this.id_detail.setcolumn("saleinvcode")
					this.id_detail.setrow(ll_counter)
					this.id_detail.scrolltorow(ll_counter)
					this.id_detail.setfocus()
					return
				end if
			next
		end if
	end if
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	setpointer(hourglass!)
	if ll_salesmancode > 0 then
		if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			return
		end if
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		ll_code = ll_invid
		for ll_counter = 1 to this.id_detail.rowcount()
			ls_msg = "000                                                                                                                                 "
			ll_invcode = this.id_detail.object.saleinvcode[ll_counter]
			if ll_invcode > 0 then
				this.it_transobject.checkunpostedsaleinvintransactions(ll_invcode, ll_code, "BS", ll_unpostedtrans, ls_msg)
				if ll_unpostedtrans > 0 then
					ls_errtext = "Unposted Transaction(s) Exist for this Invoice~r~n~r~n" + ls_msg
					this.id_detail.setrow(ll_counter)
					this.id_detail.setfocus()
					this.id_detail.setcolumn("saleinvcode")
					return
				end if
				return
			end if
		next
		if isnull(ll_invid) then
			ll_maxretcode = wf_tabnewid("billsummary", ll_invid)
			if ll_maxretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~ngenerating Bill Summary Code")
				return
			end if
			return
		end if
		if ll_invid > 0 then
			this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
		end if
		this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		this.id_master.setitem(ll_mastercurrrow, "usercode", ll_salesmancode)
		if this.id_detail.rowcount() > 0 then
			if this.id_master.update() > 0 then
				if lb_continue then
					this.id_invdetail.reset()
					lb_continue = wf_savedetail(ll_invid)
					if lb_continue then
						if ll_code > 0 then
							wf_deletebillsummarydetail(ll_code)
						end if
						if this.id_invdetail.update() > 0 then
							lb_continue = true
							SQL commit USING this.it_transobject;
							messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
							this.ib_commitok = true
							this.id_detail.reset()
							this.id_invdetail.resetupdate()
							this.im_menu.m_file.m_new.enabled = true
							this.editflag = false
						else
							this.ib_commitok = false
							lb_continue = false
						end if
					end if
				end if
			else
				lb_continue = false
			end if
			if not lb_continue then
				SQL rollback USING this.it_transobject;
				this.id_detail.setcolumn("aliasname")
				this.id_detail.scrolltorow(ll_errrowid)
				this.id_detail.setfocus()
				if this.ib_modify = false then
					setnull(ll_null)
					this.id_master.setitem(ll_mastercurrrow, "code", ll_null)
				end if
				messagebox("Updation Error", ls_errtext, stopsign!)
			end if
		else
			SQL rollback USING this.it_transobject;
			if this.ib_modify = false then
				setnull(ll_null)
				this.id_master.setitem(ll_mastercurrrow, "code", ll_null)
			end if
			setpointer(arrow!)
			return
		end if
		return
	end if
	setpointer(arrow!)

// w_billsummary.ue_newform() returns 0 [event]
	m_billsummarymenu lm_menu
	call super::ue_newform
	lm_menu = this.menuid
	wf_execute_virtualgl()
	wf_setbillsummarytype(this.id_master.object.billsummarytypecode[1])
	this.id_detail.reset()
	this.im_menu.m_item.m_newitem.visible = true
	this.im_menu.m_item.m_deleteitem.visible = true
	this.im_menu.m_file.m_post.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_save.enabled = true
	lm_menu.m_file.m_finalizebillsummary.enabled = false
	lm_menu.m_file.m_finalizebillsummary.toolbaritemvisible = false
	lm_menu.m_file.m_populateinvoices.enabled = true
	lm_menu.m_file.m_printsaleinvoices.enabled = false
	lm_menu.m_file.m_printsaleinvoices.visible = false
	lm_menu.m_file.m_printstorekeepersummary.enabled = false
	lm_menu.m_file.m_printstorekeepersummary.visible = false
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 1)
	if this.id_master.object.billsummarytypecode[1] = 1 then
		this.id_detail.object.aliasname.protect = 0
		this.id_detail.object.custcode.protect = 0
		this.id_detail.object.saleinvcode.protect = 0
	else
		this.id_detail.object.aliasname.protect = 1
		this.id_detail.object.custcode.protect = 1
		this.id_detail.object.saleinvcode.protect = 0
		this.id_detail.object.cashamt.protect = 1
		this.id_detail.object.chequeamt.protect = 1
		this.id_detail.object.debitnoteamt.protect = 1
		this.id_detail.object.creditnoteamt.protect = 1
	end if
	postevent("ue_newitem")
	if this.id_master.object.billsummarytypecode[1] = 1 then
		this.id_detail.setcolumn("aliasname")
	else
		this.id_detail.setcolumn("saleinvcode")
	end if
	this.id_detail.scrolltorow(0)
	this.id_detail.setfocus()
	this.ib_modify = false
	setredraw(true)

// w_billsummary.ue_newitem() returns 0 [event]
	long ll_rowcount
	long ll_rtcode
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 0 then
		if this.id_master.object.finalized[1] = "Y" then
			return
		end if
		if f_validatedw(this.id_detail) < 0 then
			return
		end if
		return
	end if
	if ll_rowcount > 0 then
		if not (this.id_detail.object.saleinvcode[ll_rowcount] > 0 or this.id_detail.object.custcode[ll_rowcount] > 0) then
			return
		end if
		return
	end if
	if this.id_master.object.billsummarytypecode[1] = 1 then
		this.id_detail.setcolumn("aliasname")
	else
		this.id_detail.setcolumn("saleinvcode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = false
	this.ib_validatefullcode = true

// w_billsummary.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	return ::message.returnvalue

// w_billsummary.ue_list() returns 0 [event]
	long ll_row
	long ll_found
	m_billsummarymenu lm_menu
	call super::ue_list
	lm_menu = this.menuid
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_save.enabled = false
	this.im_menu.m_file.m_print.enabled = true
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 723", 1, gds_securitywindow.rowcount())
	if ll_found = 0 then
		this.im_menu.m_file.m_post.enabled = false
	else
		this.im_menu.m_file.m_post.enabled = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 722", 1, gds_securitywindow.rowcount())
	if ll_found = 0 then
		lm_menu.m_file.m_finalizebillsummary.enabled = false
		lm_menu.m_file.m_finalizebillsummary.toolbaritemvisible = false
	else
		lm_menu.m_file.m_finalizebillsummary.enabled = true
		lm_menu.m_file.m_finalizebillsummary.toolbaritemvisible = true
	end if
	lm_menu.m_file.m_populateinvoices.enabled = false
	lm_menu.m_file.m_printstorekeepersummary.enabled = true
	lm_menu.m_file.m_printstorekeepersummary.visible = true
	lm_menu.m_file.m_printsaleinvoices.enabled = true
	lm_menu.m_file.m_printsaleinvoices.visible = true
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	ll_row = wf_retrievelist()
	wf_disabledetailtab(ll_row)

// w_billsummary.ue_deleteitem() returns 0 [event]
	long ll_currow
	long ll_detailrows
	this.ib_itemvalidated = true
	if this.id_master.rowcount() > 0 and this.id_master.object.finalized[1] = "Y" then
		return
	end if
	this.id_detail.deleterow(0)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows < 0 then
		this.im_menu.m_file.m_save.enabled = false
	end if

// w_billsummary.ue_postopen() returns 0 [event]
	call super::ue_postopen
	if f_numberpreferences("defaultbillsummarytype") = 1 then
		wf_assigndatawindowobjects("d_billsummarydetail", "d_billsummarydetail")
	else
		wf_assigndatawindowobjects("d_billsummarydetail_invbased", "d_billsummarydetail_invbased")
	end if
	this.id_master.object.billsummarytypecode.initial = trim(string(f_numberpreferences("defaultbillsummarytype")))

// w_billsummary.ue_detail() returns 0 [event]
	integer li_protect = 1
	long ll_row
	long ll_code
	m_billsummarymenu lm_menu
	call super::ue_detail
	lm_menu = this.menuid
	setredraw(false)
	ll_code = this.id_master.getitemnumber(1, "code")
	if this.id_master.object.posted[this.id_master.rowcount()] = "Y" then
		this.ib_modify = false
	else
		this.ib_modify = true
	end if
	if this.ib_modify then
		this.im_menu.m_file.m_save.enabled = true
		li_protect = 0
	else
		this.im_menu.m_file.m_save.enabled = false
		li_protect = 1
	end if
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_print.enabled = true
	lm_menu.m_file.m_finalizebillsummary.enabled = false
	lm_menu.m_file.m_finalizebillsummary.toolbaritemvisible = false
	if this.id_master.getitemstring(this.id_master.getrow(), "Finalized") = "Y" and this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		wf_protectdw(this.id_master, 1)
		wf_protectdw(this.id_detail, 1)
		this.id_detail.object.cashamt.protect = 0
		this.id_detail.object.chequeamt.protect = 0
		this.id_detail.object.debitnoteamt.protect = 0
		this.id_detail.object.creditnoteamt.protect = 0
		this.id_detail.object.salereturnamt.protect = 0
		this.id_detail.object.billsonhandbreakup.protect = 0
		this.id_detail.object.remarks.protect = 0
	else
		wf_protectdw(this.id_master, li_protect)
		wf_protectdw(this.id_detail, li_protect)
	end if
	wf_set_initial_accounts(this.id_master.object.billsummarytypecode[1])
	wf_set_column_on_off(this.id_master.object.billsummarytypecode[1])
	if this.id_master.getitemstring(this.id_master.getrow(), "Finalized") = "N" then
		this.im_menu.m_item.m_newitem.enabled = true
		this.im_menu.m_item.m_deleteitem.enabled = true
		this.id_detail.object.cashamt.protect = 1
		this.id_detail.object.chequeamt.protect = 1
		this.id_detail.object.debitnoteamt.protect = 1
		this.id_detail.object.creditnoteamt.protect = 1
		this.id_detail.object.salereturnamt.protect = 1
		this.id_detail.object.billsonhandbreakup.protect = 1
		this.id_detail.object.remarks.protect = 1
		lm_menu.m_file.m_populateinvoices.enabled = true
	else
		this.im_menu.m_item.m_newitem.enabled = false
		this.im_menu.m_item.m_deleteitem.enabled = false
		this.im_menu.m_item.m_insertnewitem.enabled = false
		this.im_menu.m_item.m_deletecurrentitem.enabled = false
		lm_menu.m_file.m_populateinvoices.enabled = false
	end if
	lm_menu.m_file.m_printstorekeepersummary.enabled = false
	lm_menu.m_file.m_printstorekeepersummary.visible = false
	lm_menu.m_file.m_printsaleinvoices.enabled = false
	lm_menu.m_file.m_printsaleinvoices.visible = false
	if this.ib_modify then
		this.editflag = true
	else
		this.editflag = false
	end if
	setredraw(true)

// w_billsummary.ue_print() returns 0 [event]
	long ll_code
	long ll_counter
	long ll_rowcount
	long ll_billsummarytype
	integer li_option
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		li_option = messagebox("Save Changes", "Do you want to save changes", information!, yesno!, 2)
		if li_option = 1 then
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_code) or ll_code <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_code = this.id_master.getitemnumber(1, "code")
	end if
	SQL SELECT BillSummaryTypeCode INTO :ll_billsummarytype FROM Billsummary WHERE billsummarycode =:ll_code USING sqlca;
	if sqlca.sqlcode <> 0 then
		return
	end if
	wf_selectprintout(ll_billsummarytype)
	ll_rowcount = this.dw_print.retrieve(ll_code)
	if lb_listtab then
		lstr.dw = this.dw_print
		lstr.s_name1 = this.dw_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if ll_rowcount > 0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.dw_print.printcancel()
		end if
		if this.dw_print.print() < 0 then
			messagebox("Printing", "Can not Print", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print,~r~nNo rows are retrieved", information!)

// w_billsummary.ue_callback_popupwindow(any ar_object) returns 0 [event]
	long ll_code
	long ll_row
	string as_errortext
	super::ue_callback_popupwindow(ar_object)
	ll_code = long(ar_object)
	ll_row = this.id_detail.getrow()
	if ll_row > 0 and ll_code > 0 then
		this.id_detail.object.srbufferinvcode[ll_row] = ll_code
		wf_set_salereturn_amount(ll_row)
	end if

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_code
	long ll_suppcode
	long ll_res
	integer li_rtcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "billsummarytypecode"
		if long(data) <> this.object.billsummarytypecode[1] then
			li_rtcode = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
			if li_rtcode = 2 then
				li_rtcode = 2
			else
				parent.parent.parent.wf_setbillsummarytype(long(data))
				li_rtcode = 0
			end if
		end if
	end choose
	return li_rtcode

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	long ll_null
	long ll_custcode
	long ll_billsumm
	string ls_null
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case "aliasname"
		if data = "" or isnull(data) then
			return 0
		elseif parent.parent.parent.wf_findcustcode(data, ll_custcode) > 0 then
			messagebox("Customer Alias Name Validation", "Customer with this Alias Name not found")
			return 1
		elseif parent.parent.parent.wf_setcustomerinfo(ll_custcode, row) > 0 then
			messagebox("Customer Alias Name Validation", "Problem in retrieving Customer Information")
			return 1
		end if
	case "custcode"
		if data = "" or isnull(data) then
			return 0
		elseif parent.parent.parent.wf_setcustomerinfo(long(data), row) > 0 then
			messagebox("Customer Alias Name Validation", "Problem in retrieving Customer Information")
			return 1
		end if
	case "saleinvcode"
		li_errcode = parent.parent.parent.wf_validateinvcode(row, long(data), ll_billsumm, 0)
		if li_errcode = 0 then
			return li_errcode
		else
			if li_errcode = -5 then
				messagebox("Sale Invoice Validation", "Sale Invoice is not yet posted.~r~nFor a Sale Invoice to be included in Bill Summary, You must post it first.~r~nPlease enter some other sale invoice code ")
			elseif li_errcode = -6 then
				messagebox("Sale Invoice Validation", "This sale invoice does not have sufficient balance to deal on this bill summary document.~r~nPlease enter some other sale invoice code ")
			elseif li_errcode = -4 then
				messagebox("Sale Invoice Validation", "Can not find sale invoice details.~r~nPlease enter some other sale invoice code ")
			elseif li_errcode = -3 then
				messagebox("Sale Invoice Validation", "Can not find sale invoice details.~r~nThis Sale Invoice Code already used in some other Bill Summary.~r~nBill Summary Code = " + trim(string(ll_billsumm)))
			elseif li_errcode = -2 then
				messagebox("Sale Invoice Validation", "Can not find sale invoice details.~r~nSome other problem prevented it to retrieve. Please enter some other Sale Invoice Code.")
			else
				messagebox("Sale Invoice Validation", "Can not find sale invoice details due to some unknown problem.")
			end if
			return 1
		end if
		return li_errcode
	end choose
	return li_errcode

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "saleinvcode"
		if long(data) <= 0 then
			messagebox("Sale Invoice Validation", "You must select some Sale Invoice")
		end if
	end choose
	return 1

// dw_itemsdetail.getfocus() returns long [event]
	return ::message.returnvalue

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	return ::message.returnvalue

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_icode
	long ll_found
	long ll_acccode
	long ll_rowm
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(99999)
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(1)
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf4! then
			parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
			setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
			setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	elseif key = keydownarrow! then
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_focusfooter")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	end if
	if getcolumnname() = "cashamt" and key = keyf4! then
		parent.parent.parent.wf_set_account("cashamt", getrow())
	elseif getcolumnname() = "chequeamt" and key = keyf4! then
		parent.parent.parent.wf_set_account("chequeamt", getrow())
	elseif getcolumnname() = "debitnoteamt" and key = keyf4! then
		parent.parent.parent.wf_set_account("debitnoteamt", getrow())
	elseif getcolumnname() = "creditnoteamt" and key = keyf4! then
		parent.parent.parent.wf_set_account("creditnoteamt", getrow())
	elseif getcolumnname() = "salereturnamt" and key = keyf4! then
		if getrow() > 0 then
			parent.parent.parent.wf_request_open_salereturn()
			parent.parent.parent.wf_open_item_form_popup()
		end if
	elseif getcolumnname() = "salereturnamt" and key = keyf5! and getrow() > 0 then
		parent.parent.parent.wf_request_referenced_salereturn()
		parent.parent.parent.wf_open_item_form_popup()
	end if
	if key = keyf1! and rowcount() > 0 then
		ll_acccode = getitemnumber(getrow(), "custcode")
		openwithparm(w_account_ledger, ll_acccode)
	end if
	return rt_code

// dw_itemsdetail.ue_enterkey() returns long [event]
	if getrow() = rowcount() then
		if parent.parent.parent.id_master.object.billsummarytypecode[1] = 1 then
			if getcolumn() = integer(this.object.datawindow.column.count) then
				parent.parent.parent.event ue_newitem()
				return 1
			end if
		elseif lower(getcolumnname()) = "saleinvcode" then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
		return
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_itemsdetail.rowfocuschanging(long currentrow, long newrow) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::rowfocuschanging(currentrow, newrow)
	if currentrow > 0 and rowcount() > 0 and parent.parent.parent.id_master.object.billsummarytypecode[1] <> 1 and getitemnumber(currentrow, "c_invbalance") < 0.0 then
		messagebox("Sale Invoice Validation", "Invoice Balance Can not be -ve.~r~nEither you have entered some wrong amount / return.~r~nPlease recheck and make desired adjustments.")
		return 1
	end if
	return 0

// tabpage_list.create() returns 0 [event]
	integer icurrent
	this.st_3 = create st_3
	this.em_invno = create em_invno
	call super::create
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_3
	this.control[icurrent + 2] = this.em_invno

// tabpage_list.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_3
	destroy this.em_invno

// dw_find.keypressed(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	long ll_code
	long ll_row
	s_datastore lstr
	datastore lds_datastore
	ancestorreturnvalue = super::keypressed(key, keyflags)
	lds_datastore = create datastore
	if key = keyf7! then
		ll_row = parent.parent.parent.id_dwcontrol.getrow()
		if ll_row > 0 then
			ll_code = parent.parent.parent.id_list.object.code[ll_row]
			if ll_code > 0 then
				lds_datastore.dataobject = "d_storesummary_sreturn_viabillsummary"
				lds_datastore.settransobject(sqlca)
				lds_datastore.retrieve(ll_code)
				lstr.ds = lds_datastore
				lstr.s_name1 = lds_datastore.dataobject
				openwithparm(w_preview_invoices2, lstr)
				lstr = message.powerobjectparm
				if lstr.i_closemode = -1 then
					if not isvalid(message) then
						return 0
					end if
					return message.returnvalue
				end if
				return
			end if
			setfocus()
		end if
	elseif key = keyf8! then
		ll_row = parent.parent.parent.id_dwcontrol.getrow()
		if ll_row > 0 then
			ll_code = parent.parent.parent.id_list.object.code[ll_row]
			if ll_code > 0 then
				lds_datastore.dataobject = "d_custwise_sreturnsummary_viabillsummary"
				lds_datastore.settransobject(sqlca)
				lds_datastore.retrieve(ll_code)
				lstr.ds = lds_datastore
				lstr.s_name1 = lds_datastore.dataobject
				openwithparm(w_preview_invoices2, lstr)
				lstr = message.powerobjectparm
				if lstr.i_closemode = -1 then
					if not isvalid(message) then
						return 0
					end if
					return message.returnvalue
				end if
				return
			end if
			setfocus()
		end if
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue
