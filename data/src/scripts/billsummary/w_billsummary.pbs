		else
			this.id_detail.object.srbufferinvcode.visible = true
			this.id_detail.object.salereturnamt.visible = true
		end if
		this.id_detail.object.c_effectivebalance.visible = true
		if f_stringpreferences("showbillsonhand_inbillsum") = "N" then
			this.id_detail.object.billsonhandbreakup.visible = false
			this.id_detail.object.c_billsonhandtotal.visible = false
			this.id_detail.object.c_diff.visible = false
		else
			this.id_detail.object.billsonhandbreakup.visible = true
			this.id_detail.object.c_billsonhandtotal.visible = true
			this.id_detail.object.c_diff.visible = true
		end if
		this.id_detail.object.c_invbalance.visible = false
		if f_stringpreferences("showremarks_inbillsum") = "N" then
			this.id_detail.object.remarks.visible = false
		else
			this.id_detail.object.remarks.visible = true
		end if
	else
		this.id_detail.object.aliasname.protect = 1
		this.id_detail.object.custcode.protect = 1
		this.id_detail.object.accbalance.visible = false
		this.id_detail.object.saleinvcode.visible = true
		this.id_detail.object.netamount.visible = true
		this.id_detail.object.outstandingamt.visible = true
		this.id_detail.object.c_totreceivable.visible = false
		if f_stringpreferences("showcashamt_inbillsum") = "N" then
			this.id_detail.object.cashamt.visible = false
		else
			this.id_detail.object.cashamt.visible = true
		end if
		if f_stringpreferences("showbankamt_inbillsum") = "N" then
			this.id_detail.object.chequeamt.visible = false
		else
			this.id_detail.object.chequeamt.visible = true
		end if
		if f_stringpreferences("showdrnoteamt_inbillsum") = "N" then
			this.id_detail.object.debitnoteamt.visible = false
		else
			this.id_detail.object.debitnoteamt.visible = true
		end if
		if f_stringpreferences("showcrnoteamt_inbillsum") = "N" then
			this.id_detail.object.creditnoteamt.visible = false
		else
			this.id_detail.object.creditnoteamt.visible = true
		end if
		if f_stringpreferences("showsr_inbillsum") = "N" then
			this.id_detail.object.srbufferinvcode.visible = false
			this.id_detail.object.salereturnamt.visible = false
		else
			this.id_detail.object.srbufferinvcode.visible = true
			this.id_detail.object.salereturnamt.visible = true
		end if
		this.id_detail.object.c_effectivebalance.visible = false
		this.id_detail.object.billsonhandbreakup.visible = false
		this.id_detail.object.c_billsonhandtotal.visible = false
		this.id_detail.object.c_diff.visible = false
		this.id_detail.object.c_invbalance.visible = true
		if f_stringpreferences("showremarks_inbillsum") = "N" then
			this.id_detail.object.remarks.visible = false
		else
			this.id_detail.object.remarks.visible = true
		end if
	end if
	if this.id_master.object.finalized[1] = "Y" and this.id_master.object.posted[1] = "N" then
		this.id_detail.object.cashamt.protect = 0
		this.id_detail.object.chequeamt.protect = 0
		this.id_detail.object.debitnoteamt.protect = 0
		this.id_detail.object.creditnoteamt.protect = 0
		this.id_detail.object.salereturnamt.protect = 0
	else
		this.id_detail.object.cashamt.protect = 1
		this.id_detail.object.chequeamt.protect = 1
		this.id_detail.object.debitnoteamt.protect = 1
		this.id_detail.object.creditnoteamt.protect = 1
		this.id_detail.object.salereturnamt.protect = 1
	end if
	return 0

// w_billsummary.wf_setinvoicedetail(long al_invcode, long al_row, integer ai_mode) returns long
	long li_rtcode
	long ll_invcode
	long ll_acccode
	double ld_netamt
	double ld_outstandingamt
	datetime ld_date
	string ls_aliasname
	string ls_name
	string ls_posted
	SQL SELECT SaleLedger.SaleInvCode , SaleLedger.InvTotal , SaleLedger.outstandingamt , SaleLedger.Date , Accounts.AliasName , Accounts.Name , SaleLedger.CustCode , SaleLedger.Posted INTO :ll_invcode, :ld_netamt, :ld_outstandingamt, :ld_date, :ls_aliasname, :ls_name, :ll_acccode, :ls_posted FROM SaleLedger , Accounts WHERE SaleLedger.SaleInvCode =:al_invcode AND SaleLedger.AccountFor ='Y' AND SaleLedger.SaleCatCode IN ( 2 ) AND SaleLedger.CustCode =Accounts.AccCode AND Accounts.Active ='Y' USING sqlca;
	if sqlca.sqlcode = 0 then
		if this.id_master.object.billsummarytypecode[1] > 1 and ld_outstandingamt <= 0.0 then
			li_rtcode = -4
		end if
		if ll_invcode > 0 and upper(ls_posted) = "Y" then
			this.id_detail.object.saleinvcode[al_row] = ll_invcode
			this.id_detail.object.netamount[al_row] = ld_netamt
			this.id_detail.object.outstandingamt[al_row] = ld_outstandingamt
			this.id_detail.object.aliasname[al_row] = ls_aliasname
			this.id_detail.object.custcode[al_row] = ll_acccode
			wf_setbalance(ll_acccode, al_row)
			if ai_mode = 0 then
				this.id_detail.object.accbalance[al_row] = this.id_detail.object.accbalance[al_row] - ld_netamt
			end if
			li_rtcode = 0
		elseif upper(ls_posted) = "N" then
			li_rtcode = -3
		else
			li_rtcode = -1
		end if
	else
		li_rtcode = -2
	end if
	return li_rtcode

// w_billsummary.wf_validateinvcode(long al_row, long al_invcode, long al_billsummarycode, integer ai_mode) returns integer
	integer li_rtcode
	integer ll_retcode
	long ll_invcode
	long ll_acccode
	long ll_billsummarycode
	long ll_count
	long ll_billsumm
	double ld_balanceamt
	double ld_netamt
	datetime ld_date
	string ls_aliasname
	string ls_name
	if isnull(al_invcode) or trim(string(al_invcode)) = "" then
		li_rtcode = 0
		return li_rtcode
	end if
	if vf_dwdupcode1(this.id_detail, "saleinvcode", string(al_invcode), al_row) = true then
		li_rtcode = 1
		messagebox("Invoice Validation", "Duplicate Invoice, please select some other invoice")
	else
		if this.id_master.rowcount() > 0 then
			ll_billsummarycode = this.id_master.object.code[1]
		else
			setnull(ll_billsummarycode)
		end if
		if ll_billsummarycode > 0 then
			SQL SELECT Count ( D.SaleInvCode ) , Max ( B.BillSummaryCode ) INTO :ll_count, :ll_billsumm FROM BillSummaryDetail D , BillSummary B WHERE D.SaleInvCode =:al_invcode AND B.BillSummaryCode <> :ll_billsummarycode AND B.BillSummaryCode =D.BillSummaryCode AND B.Posted ='N' USING this.it_transobject;
		else
			SQL SELECT Count ( D.SaleInvCode ) , Max ( B.BillSummaryCode ) INTO :ll_count, :ll_billsumm FROM BillSummaryDetail D , BillSummary B WHERE D.SaleInvCode =:al_invcode AND B.BillSummaryCode =D.BillSummaryCode AND B.Posted ='N' USING this.it_transobject;
		end if
		if this.it_transobject.sqlcode = 0 then
			if ll_count = 0 then
				ll_retcode = wf_setinvoicedetail(al_invcode, al_row, ai_mode)
				if ll_retcode = 0 then
					li_rtcode = 0
				elseif ll_retcode = -3 then
					li_rtcode = -5
				elseif ll_retcode = -4 then
					li_rtcode = -6
				else
					li_rtcode = -4
				end if
			else
				al_billsummarycode = ll_billsumm
				li_rtcode = -3
			end if
		else
			li_rtcode = -2
		end if
	end if
	return li_rtcode

// w_billsummary.wf_selectprintout(long al_type) returns 0
	string ls_printout
	integer i_rtcode
	datawindowchild ldc_nested
	s_arguements lstr_arg
	if gs_company = "IDEALTRADERS" then
		ls_printout = "d_idealtraders_billsummaryprint"
	elseif gs_company = "UNITEDMEDICINE2" then
		ls_printout = "d_unitedmedicine2_billsummaryprint"
	elseif gs_company = "MAXPHARMADIST" or gs_company = "MAXPHARMADIST4" or gs_company = "MAXPHARMADIST9" then
		ls_printout = "d_maxpharmdist_billsummaryprint2"
	elseif gs_company = "SAARAMDIST" then
		ls_printout = "d_saaramdist_billsummaryprint"
	elseif gs_company = "GALAXYDIST2" or gs_company = "SNOORMEDICINE" or gs_company = "DRUGSERVICES" or gs_company = "DRUGSERVICES2" or gs_company = "DRUGSERVICES3" or gs_company = "DRUGSERVICES4" or gs_company = "DRUGSERVICES5" then
		ls_printout = "d_galaxydist_billsummaryprint"
	end if
	if ls_printout = "" or isnull(ls_printout) then
		if al_type = 1 then
			ls_printout = "d_billsummaryprint"
		else
			ls_printout = "d_billsummaryprint2"
		end if
	end if
	this.dw_print.dataobject = ls_printout
	this.dw_print.settransobject(this.it_transobject)

// w_billsummary.wf_print_storekeepersummary() returns long
	long ll_code
	long ll_row
	long ll_count
	long ll_insrow
	double ld_price
	s_datastore lstr
	datastore lds_print
	lds_print = create datastore
	if this.tab_retrieve.selectedtab = 1 then
		return 0
	end if
	if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
		messagebox("Rows Validation", "Kindly select any row from the list view.")
		return 0
	end if
	ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
	if isnull(ll_code) or ll_code <= 0 then
		messagebox("Selection Validation", "Kindly select any row from the list view.")
		return 0
	end if
	if gs_company = "GALAXYDIST2" or gs_company = "SNOORMEDICINE" or gs_company = "DRUGSERVICES" or gs_company = "DRUGSERVICES2" or gs_company = "DRUGSERVICES3" or gs_company = "DRUGSERVICES4" or gs_company = "DRUGSERVICES5" then
		lds_print.dataobject = "d_galaxydist_billsumm_storesummary_print"
	elseif gs_company = "AMINTRADERS" then
		lds_print.dataobject = "d_amintraders_billsummary_storesummary"
	else
		lds_print.dataobject = "d_billsummary_storesummary_print"
	end if
	lds_print.settransobject(sqlca)
	lds_print.retrieve(ll_code)
	if ll_code > 0 then
		lstr.s_module = "billsummmary_storekeepersummary"
		lstr.ds = lds_print
		lstr.s_name1 = lds_print.dataobject
		openwithparm(w_preview_invoices2, lstr)
		lstr = message.powerobjectparm
	end if
	return 0

