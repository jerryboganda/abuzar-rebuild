// window w_billsummary_acccountselection (billsummary)  ancestor: window

// w_billsummary_acccountselection.of_getvalue() returns integer
	this.dw_pref.object.acccode_t.text = this.is_billsum_acc.name
	this.dw_pref.object.acccode[1] = this.is_billsum_acc.acccode
	return 0

// w_billsummary_acccountselection.of_setvalue() returns long
	this.is_billsum_acc.acccode = this.dw_pref.object.acccode[1]
	return 0

// w_billsummary_acccountselection.create() returns 0 [event]
	this.dw_pref = create dw_pref
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.control = {this.dw_pref, this.cb_cancel, this.cb_ok}

// w_billsummary_acccountselection.destroy() returns 0 [event]
	destroy this.dw_pref
	destroy this.cb_cancel
	destroy this.cb_ok

// w_billsummary_acccountselection.close() returns long [event]
	closewithreturn(this, this.is_billsum_acc)
	return ::message.returnvalue

// w_billsummary_acccountselection.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_counter
	integer li_retcode
	string ls_temp
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	this.is_billsum_acc = message.powerobjectparm
	this.dw_pref.object.acccode.dddw.name = "ddd_vouchheaderaccounts"
	this.dw_pref.object.acccode.dddw.autoretrieve = "Yes"
	this.dw_pref.object.acccode.dddw.allowedit = "No"
	this.dw_pref.object.acccode.dddw.datacolumn = "acccode"
	this.dw_pref.object.acccode.dddw.displaycolumn = "name"
	li_retcode = this.dw_pref.getchild("acccode", this.idc_child)
	if li_retcode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	this.idc_child.settransobject(sqlca)
	this.idc_child.retrieve(this.is_billsum_acc.cat)
	this.dw_pref.settransobject(sqlca)
	this.dw_pref.insertrow(0)
	this.dw_pref.scrolltorow(0)
	of_getvalue()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_billsummary_acccountselection.key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		this.is_billsum_acc.status = false
	end if
	return ::message.returnvalue

// dw_pref.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_pref.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.is_billsum_acc.status = false
	parent.triggerevent(close!)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	if parent.dw_pref.accepttext() < 1 then
		return ::message.returnvalue
	end if
	parent.of_setvalue()
	parent.is_billsum_acc.status = true
	parent.triggerevent(close!)
	return ::message.returnvalue
