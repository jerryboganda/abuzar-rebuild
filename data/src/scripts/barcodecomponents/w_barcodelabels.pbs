// w_barcodelabels.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_barcodelabelmenu" then
		this.menuid = create m_barcodelabelmenu
	end if
	this.dw_purinvrep = create dw_purinvrep
	this.dw_labelprint = create dw_labelprint
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_purinvrep
	this.control[icurrent + 2] = this.dw_labelprint

// w_barcodelabels.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_purinvrep
	destroy this.dw_labelprint

// w_barcodelabels.ue_save() returns 0 [event]
	integer li_counter = 1
	long ll_icode
	long ll_salesmancode = 1
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_detailrows
	string ls_updatepurprice
	boolean lb_commitflag = true
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 1 and vf_dwdupcodebatch(this.id_detail, "gcode", this.id_detail.getitemnumber(this.id_detail.getrow(), "gcode"), "icode", this.id_detail.getitemnumber(this.id_detail.getrow(), "icode"), "batch", this.id_detail.getitemstring(this.id_detail.getrow(), "batch"), "expiry", this.id_detail.getitemdatetime(this.id_detail.getrow(), "expiry"), this.il_currrow) = true then
		messagebox("Item Validation", "Duplicate item, please select some other item")
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	if f_checkdate("purledger", this.id_master.getitemdatetime(this.id_master.getrow(), "date")) < 0 then
		messagebox("Invoice Date Validation", "Back date invoicing is not possible")
		return
	end if
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		setpointer(hourglass!)
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			f_newtableid("purledger", ll_invid)
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
			this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
		else
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			this.id_master.setitem(ll_mastercurrrow, "date", today())
		end if
		this.id_master.object.discperc[ll_mastercurrrow] = this.id_footer.object.discperc[ll_footercurrrow]
		this.id_master.object.flatdisc[ll_mastercurrrow] = this.id_footer.object.flatdisc[ll_footercurrrow]
		this.id_master.object.misccharges[ll_mastercurrrow] = this.id_footer.object.misccharges[ll_footercurrrow]
		do while li_counter <= ll_detailrows
			this.id_detail.setitem(li_counter, "code", ll_invid)
			ll_icode = this.id_detail.object.icode[li_counter]
			if lb_commitflag and this.id_detail.getitemstatus(li_counter, "purprice", primary!) = datamodified! and ls_updatepurprice = "Y" and wf_updateitempurprice(ll_icode, this.id_detail.getitemnumber(li_counter, "purprice")) <> 0 then
				lb_commitflag = false
			end if
			li_counter = li_counter + 1
		loop
		call super::ue_save
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_barcodelabels.ue_newform() returns 0 [event]
	integer rtncode
	long ll_found
	call super::ue_newform
	setredraw(false)
	wf_setgodownoption()
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	if this.id_master.rowcount() <= 0 then
		this.id_master.insertrow(0)
	end if
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.id_footer.object.discperc[1] = 0
	this.id_footer.object.flatdisc[1] = 0
	this.id_footer.object.misccharges[1] = 0
	if this.ii_purchasetype = 2 then
		this.id_master.object.suppcode[this.id_master.getrow()] = this.il_code
	end if
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 592", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_detail.object.saleprice.protect = 0
	else
		this.id_detail.object.saleprice.protect = 1
	end if
	setredraw(true)
	this.id_footer.object.t_saleprice.text = ""
	this.id_footer.object.t_avgprice.text = ""
	if this.id_master.rowcount() > 0 then
		this.id_master.object.barcodeprinter[1] = trim(f_stringpreferences("BarCodePrinterName"))
	end if
	if not wf_validatedate() then
		close(this)
	end if

// w_barcodelabels.ue_detail() returns 0 [event]
	long ll_code
	long ll_found
	integer li_rtncode
	integer li_protect
	call super::ue_detail
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	this.id_footer.retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	if li_protect = 0 then
		if not this.ib_normalpurmodify and this.ii_purchasetype = 1 then
			li_protect = 1
		end if
		if not this.ib_loosepurmodify and this.ii_purchasetype = 7 then
			li_protect = 1
		end if
		if not this.ib_loosepurmodify and this.ii_purchasetype <> 1 and this.ii_purchasetype = 7 then
			li_protect = 1
		end if
	end if
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_footer, li_protect)
	this.im_menu.m_file.m_save.enabled = false
	if li_protect = 0 then
		this.im_menu.m_file.m_save.enabled = true
	end if
	if li_protect = 1 then
		this.editflag = false
		this.id_footer.object.t_saleprice.text = ""
		this.id_footer.object.t_avgprice.text = ""
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 592", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_detail.object.saleprice.protect = 0
	else
		this.id_detail.object.saleprice.protect = 1
	end if
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true
	this.im_menu.m_item.m_insertnewitem.enabled = false
	this.im_menu.m_item.m_deletecurrentitem.enabled = false
	if this.id_master.rowcount() > 0 then
		this.id_master.object.barcodeprinter[1] = trim(f_stringpreferences("BarCodePrinterName"))
		this.id_master.object.labelformat[1] = trim(string(f_numberpreferences("defaultbarcodeformat")))
	end if
	setredraw(true)

// w_barcodelabels.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 1 then
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.settransobject(this.it_transobject)
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	if this.id_detail.rowcount() > 0 then
		this.id_detail.object.expiry.initial = string(this.id_detail.object.expiry[this.id_detail.rowcount()], "mm/dd/yyyy")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_barcodelabels.ue_deleteitem() returns 0 [event]
	long ll_row
	ll_row = this.id_detail.getrow()
	if this.id_detail.rowcount() > 0 then
		call super::ue_deleteitem
		return
	end if
	this.im_menu.m_file.m_print.enabled = false

// w_barcodelabels.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	destroy this.ids_itemstockinfo
	return ::message.returnvalue

// w_barcodelabels.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_barcodelabels.ue_list() returns 0 [event]
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_post.enabled = false

// w_barcodelabels.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	if this.ii_purchasetype = 1 then
		setpointer(hourglass!)
		this.idc_supplierlist.setredraw(false)
		this.idc_supplierlist.settransobject(this.it_transobject)
		this.idc_supplierlist.reset()
		this.idc_supplierlist.retrieve()
		this.idc_supplierlist.setredraw(true)
		setpointer(arrow!)
	end if

// w_barcodelabels.ue_print() returns 0 [event]
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_invcode
	long ll_inscode
	long ll_ret
	integer li_startcell
	integer li_stopcell
	integer li_temp
	string ls_clientname
	string ls_pricestartswith
	string ls_priceendswith
	string ls_price
	string ls_instruction
	string ls_prefsaleqty
	string ls_aliasname
	string ls_barcode
	string ls_err
	string ls_itemname
	string ls_format
	string ls_date
	datetime ldt_null
	long ll_headerno
	boolean lb_listtab
	boolean lb_printrow = true
	s_datastore lstr
	datastore lds_barcodes
	call super::ue_print
	setnull(ldt_null)
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
		this.id_detail.retrieve(ll_invcode)
	end if
	if f_stringpreferences("UseBarCodePrinter") = "Y" then
		event ue_print_2()
		return
	end if
	ll_headerno = this.id_master.getitemnumber(this.id_master.getrow(), "headerno")
	if gs_company = "BAMBINOSTORE" or gs_company = "ABCD2" then
		ls_clientname = "BAMBINO"
	elseif gs_company = "PP" then
		ls_clientname = "POT POURRI SUPER STORE"
	elseif gs_company = "BANOEMPORIUM" then
		ls_clientname = "B ,"
	elseif gs_company = "DWSPWD" then
		ls_clientname = "D. Watson PWD"
	else
		ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	end if
	this.tab_retrieve.tabpage_detail.dw_cells.accepttext()
	li_startcell = this.tab_retrieve.tabpage_detail.dw_cells.getitemnumber(1, "fromcell")
	li_stopcell = this.tab_retrieve.tabpage_detail.dw_cells.getitemnumber(1, "tocell")
	ls_pricestartswith = this.tab_retrieve.tabpage_detail.dw_cells.getitemstring(1, "startswith")
	if isnull(ls_pricestartswith) then
		ls_pricestartswith = ""
	end if
	ls_priceendswith = this.tab_retrieve.tabpage_detail.dw_cells.getitemstring(1, "endswith")
	if isnull(ls_priceendswith) then
		ls_priceendswith = ""
	end if
	if li_startcell > li_stopcell then
		li_stopcell = li_temp
		li_stopcell = li_startcell
		li_startcell = li_temp
	end if
	lds_barcodes = create datastore
	ls_format = this.id_master.getitemstring(1, "labelformat")
	if gs_company = "MARSHAL" then
		if ls_format = "2" then
			this.tab_retrieve.tabpage_detail.dw_barcodelist.dataobject = "d_barcodelabels_marshal_format2"
		else
			this.tab_retrieve.tabpage_detail.dw_barcodelist.dataobject = "d_barcodelabels_marshal_format1"
		end if
	elseif gs_company = "BAMBINOSTORE" or gs_company = "ABCD2" then
		if ls_format = "1" then
			this.tab_retrieve.tabpage_detail.dw_barcodelist.dataobject = "d_barcodelabels_bambinostore"
		else
			this.tab_retrieve.tabpage_detail.dw_barcodelist.dataobject = "d_barcodelabels_bambinostore2"
		end if
	elseif gs_company = "PP" or gs_company = "POTPOURRIWHOUSE" or gs_company = "PP2" or gs_company = "PP3" then
		if ls_format = "1" then
			this.tab_retrieve.tabpage_detail.dw_barcodelist.dataobject = "d_barcodelabels_pp"
		else
			this.tab_retrieve.tabpage_detail.dw_barcodelist.dataobject = "d_barcodelabels_pp2"
		end if
	elseif gs_company = "NAQSHELASANI2" then
		if ls_format = "1" then
			this.tab_retrieve.tabpage_detail.dw_barcodelist.dataobject = "d_barcodelabels_naqshelasani2"
		else
			this.tab_retrieve.tabpage_detail.dw_barcodelist.dataobject = "d_barcodelabels_naqshelasani2_2"
		end if
	elseif gs_company = "MEDCINSUPERSTOR" then
		this.tab_retrieve.tabpage_detail.dw_barcodelist.dataobject = "d_barcodelabels_medcinsuperstor"
	elseif left(gs_company, 6) = "CLINIX" then
		if ls_format = "1" then
			this.tab_retrieve.tabpage_detail.dw_barcodelist.dataobject = "d_barcodelabels_clinix"
		elseif ls_format = "2" then
			this.tab_retrieve.tabpage_detail.dw_barcodelist.dataobject = "d_barcodelabels_clinix2"
		elseif ls_format = "3" then
			this.tab_retrieve.tabpage_detail.dw_barcodelist.dataobject = "d_barcodelabels_clinix3"
		elseif ls_format = "4" then
			this.tab_retrieve.tabpage_detail.dw_barcodelist.dataobject = "d_barcodelabels_clinix4"
		end if
	end if
	lds_barcodes.dataobject = this.tab_retrieve.tabpage_detail.dw_barcodelist.dataobject
	lds_barcodes.settransobject(sqlca)
	this.tab_retrieve.tabpage_detail.dw_itemsdetail.accepttext()
	ll_totalrows = this.tab_retrieve.tabpage_detail.dw_itemsdetail.rowcount()
	lds_barcodes.reset()
	if ll_totalrows > 0 then
		if li_startcell > 1 then
			for ll_counter = 1 to li_startcell - 1
				lds_barcodes.insertrow(0)
			next
		end if
		ll_counter = 1
		for ll_counter = 1 to ll_totalrows
			ls_itemname = this.id_detail.object.itemname[ll_counter]
			ll_inscode = this.id_detail.object.inscode[ll_counter]
			if gs_company = "KMARTFSD" then
				if trim(string(this.id_detail.object.icode[ll_counter])) = trim(this.id_detail.object.fullcode[ll_counter]) then
					lb_printrow = true
				else
					lb_printrow = false
				end if
			else
				lb_printrow = true
			end if
			if this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemnumber(ll_counter, "qty") > 0.0 and lb_printrow = true then
				ll_qty = this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemnumber(ll_counter, "qty")
				if gs_company = "HCP" then
					for ll_innercounter = 1 to ll_qty
						ll_currrow = lds_barcodes.insertrow(0)
						lds_barcodes.setitem(ll_currrow, "name", trim(this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemstring(ll_counter, "itemname")))
						lds_barcodes.setitem(ll_currrow, "batch", trim(this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemstring(ll_counter, "batch")))
						lds_barcodes.setitem(ll_currrow, "packingdesc", trim(this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemstring(ll_counter, "packingdesc")))
					next
				else
					for ll_innercounter = 1 to ll_qty
						ll_currrow = lds_barcodes.insertrow(0)
						lds_barcodes.setitem(ll_currrow, "name", trim(this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemstring(ll_counter, "itemname")))
						if gs_company = "SALAMPHNCNC" then
							lds_barcodes.setitem(ll_currrow, "expiry", "Expiry:" + string(date(this.id_detail.object.expiry[ll_counter]), "dd/mm/yyyy"))
						end if
						if gs_company = "BESTBUY" then
							if len(trim(this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemstring(ll_counter, "fullcode"))) > 7 then
								lds_barcodes.setitem(ll_currrow, "custicode", "")
							else
								lds_barcodes.setitem(ll_currrow, "custicode", "*" + trim(this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemstring(ll_counter, "fullcode")) + "*")
							end if
						else
							lds_barcodes.setitem(ll_currrow, "custicode", "*" + trim(this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemstring(ll_counter, "fullcode")) + "*")
						end if
						lds_barcodes.setitem(ll_currrow, "customicode", trim(this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemstring(ll_counter, "fullcode")))
						if gs_company = "KHIESTIMATE" or gs_company = "KHIONE" or gs_company = "KHITWO" or gs_company = "KHITHREE" then
							ls_price = ls_pricestartswith + trim(string(round(this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemdecimal(ll_counter, "saleprice"), 0))) + ls_priceendswith
							lds_barcodes.setitem(ll_currrow, "price", "" + ls_price)
						elseif left(gs_company, 12) = "MASOODHOMOEO" then
							lds_barcodes.setitem(ll_currrow, "price", "MRP:" + trim(string(round(this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemdecimal(ll_counter, "saleprice"), 2))))
							lds_barcodes.setitem(ll_currrow, "batch", "Batch No.:" + this.id_detail.object.batch[ll_counter])
							if trim(string(date(this.id_detail.object.manfdate[ll_counter]), "dd/mm/yyyy")) = "" or isnull(string(date(this.id_detail.object.manfdate[ll_counter]), "dd/mm/yyyy")) then
								lds_barcodes.setitem(ll_currrow, "manfdate", ldt_null)
							else
								lds_barcodes.setitem(ll_currrow, "manfdate", "Mfg.:" + string(date(this.id_detail.object.manfdate[ll_counter]), "dd/mm/yyyy"))
							end if
							if trim(string(date(this.id_detail.object.expiry[ll_counter]), "dd/mm/yyyy")) = "" or isnull(string(date(this.id_detail.object.expiry[ll_counter]), "dd/mm/yyyy")) then
								lds_barcodes.setitem(ll_currrow, "expiry", ldt_null)
							else
								lds_barcodes.setitem(ll_currrow, "expiry", "Exp.:" + string(date(this.id_detail.object.expiry[ll_counter]), "dd/mm/yyyy"))
							end if
						elseif gs_company = "BESMARTLHR" then
							lds_barcodes.setitem(ll_currrow, "price", "  ")
						elseif gs_company = "BAMBINOSTORE" or gs_company = "ABCD2" then
							lds_barcodes.setitem(ll_currrow, "SuppAlias", this.id_master.object.aliasname[1])
							ls_date = string(today(), "dd/mm")
							lds_barcodes.setitem(ll_currrow, "name", this.id_detail.object.itemname[ll_counter])
							lds_barcodes.setitem(ll_currrow, "date", ls_date)
							lds_barcodes.setitem(ll_currrow, "price", "Rs.:" + trim(string(round(this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemdecimal(ll_counter, "saleprice"), 2), "##,###,##0")))
							lds_barcodes.setitem(ll_currrow, "manfdate", "PD: " + string(this.id_detail.object.manfdate[ll_counter], "dd/mm/yyyy"))
							lds_barcodes.setitem(ll_currrow, "expiry", "EXP:: " + string(this.id_detail.object.expiry[ll_counter], "dd/mm/yyyy"))
						elseif gs_company = "PP" or gs_company = "POTPOURRIWHOUSE" or gs_company = "PP2" or gs_company = "PP3" then
							lds_barcodes.setitem(ll_currrow, "SuppAlias", this.id_master.object.aliasname[1])
							ls_date = string(today(), "yymmdd")
							ls_date = mid(ls_date, 2, 1) + left(ls_date, 1) + right(ls_date, 4)
							lds_barcodes.setitem(ll_currrow, "name", this.id_detail.object.remarks[ll_counter])
							lds_barcodes.setitem(ll_currrow, "date", ls_date)
							lds_barcodes.setitem(ll_currrow, "price", "Rs:" + trim(string(round(this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemdecimal(ll_counter, "saleprice"), 2), "#####0")))
						elseif gs_company = "MEDCINSUPERSTOR" then
							lds_barcodes.setitem(ll_currrow, "name", this.id_detail.object.itemname[ll_counter])
							lds_barcodes.setitem(ll_currrow, "expiry", "Mfg: " + string(this.id_detail.object.manfdate[ll_counter], "dd-mm-yyyy") + ", Exp.:" + string(this.id_detail.object.expiry[ll_counter], "dd-mm-yyyy"))
							lds_barcodes.setitem(ll_currrow, "manufshortname", "Mfg. By: " + this.id_detail.object.manufshortname[ll_counter])
							lds_barcodes.setitem(ll_currrow, "manufaddress", "Address: " + this.id_detail.object.manufaddress[ll_counter])
							lds_barcodes.setitem(ll_currrow, "manufphone", "Phone No: " + this.id_detail.object.manufphone[ll_counter])
							lds_barcodes.setitem(ll_currrow, "packedby", "Packed By: " + ls_clientname)
							lds_barcodes.setitem(ll_currrow, "date", ls_date)
							lds_barcodes.setitem(ll_currrow, "price", "Rs:" + trim(string(round(this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemdecimal(ll_counter, "saleprice"), 2), "###,##0")))
						elseif left(gs_company, 6) = "CLINIX" then
							if ls_format = "4" then
								lds_barcodes.setitem(ll_currrow, "price", "Rs. " + trim(string(round(this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemdecimal(ll_counter, "saleprice"), 0), "###,##0")))
							else
								lds_barcodes.setitem(ll_currrow, "price", "Rs. " + trim(string(round(this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemdecimal(ll_counter, "saleprice"), 2), "###,##0.00")))
							end if
						else
							lds_barcodes.setitem(ll_currrow, "price", "Rs:" + trim(string(round(this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemdecimal(ll_counter, "saleprice"), 2))))
						end if
						if gs_company = "HEARTINTERNAT" and ll_innercounter = 1 then
							SQL SELECT Localinstruction INTO :ls_instruction FROM instruction WHERE inscode =:ll_inscode USING sqlca;
							lds_barcodes.object.name[ll_currrow] = ls_itemname
							lds_barcodes.object.patient[ll_currrow] = this.id_master.object.patientname[1]
							lds_barcodes.object.doctor[ll_currrow] = this.id_master.object.doctorname[1]
							lds_barcodes.object.instruction[ll_currrow] = ls_instruction
							lds_barcodes.object.date[ll_currrow] = this.id_master.object.date[1]
						end if
						if gs_company = "NAQSHELASANI2" then
							lds_barcodes.object.packingdesc[ll_currrow] = this.id_detail.object.packingdesc[ll_counter]
							lds_barcodes.object.remarks[ll_currrow] = this.id_detail.object.remarks[ll_counter]
							lds_barcodes.object.size[ll_currrow] = this.id_detail.object.size[ll_counter]
							lds_barcodes.object.sizedescription[ll_currrow] = this.id_detail.object.sizedescription[ll_counter]
							lds_barcodes.object.modeldescription[ll_currrow] = this.id_detail.object.modeldescription[ll_counter]
							lds_barcodes.object.location[ll_currrow] = this.id_detail.object.location[ll_counter]
						end if
						if gs_company = "NZTRADERS" then
							lds_barcodes.object.packingdesc[ll_currrow] = this.id_detail.object.packingdesc[ll_counter]
							lds_barcodes.object.size[ll_currrow] = this.id_detail.object.size[ll_counter]
							lds_barcodes.object.sizedescription[ll_currrow] = this.id_detail.object.sizedescription[ll_counter]
						end if
						if gs_company = "HEARTINTERNAT" and ll_innercounter > 1 then
							lds_barcodes.deleterow(ll_currrow)
							ll_currrow = ll_currrow - 1
						end if
						if gs_company = "ANGELSHINE" then
							lds_barcodes.setitem(ll_currrow, "cr", "®")
							lds_barcodes.setitem(ll_currrow, "clientname", "ANGEL. S")
							lds_barcodes.object.manufshortname[ll_currrow] = this.id_detail.object.manufshortname[ll_counter]
							lds_barcodes.object.manufaddress[ll_currrow] = this.id_detail.object.manufaddress[ll_counter]
							lds_barcodes.object.design[ll_currrow] = this.id_detail.object.design[ll_counter]
							lds_barcodes.object.mrp[ll_currrow] = this.id_detail.object.mrp[ll_counter]
							lds_barcodes.object.size[ll_currrow] = this.id_detail.object.size[ll_counter]
							lds_barcodes.object.sizedescription[ll_currrow] = this.id_detail.object.sizedescription[ll_counter]
							lds_barcodes.object.suppcode[ll_currrow] = this.id_detail.object.suppcode[ll_counter]
							ls_prefsaleqty = trim(string(this.id_detail.object.prefferedsaleqty[ll_counter], "###0"))
							if isnull(ls_prefsaleqty) then
								ls_prefsaleqty = ""
							end if
							ls_prefsaleqty = fill("0", 2 - len(ls_prefsaleqty)) + ls_prefsaleqty
							if isnull(ls_prefsaleqty) then
								ls_prefsaleqty = ""
							end if
							lds_barcodes.object.prefferedsaleqty[ll_currrow] = ls_prefsaleqty
							ls_aliasname = lds_barcodes.object.customicode[ll_currrow]
							ls_aliasname = fill("0", 8 - len(ls_aliasname)) + ls_aliasname
							ll_ret = f_getean13_barcode("98", ls_aliasname, ls_prefsaleqty, ls_barcode, ls_err)
							if ll_ret = 0 then
								lds_barcodes.object.customicode[ll_currrow] = ls_barcode
							end if
						elseif gs_company = "BLAYCONCEPT" then
							lds_barcodes.setitem(ll_currrow, "clientname", trim(this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemstring(ll_counter, "manufacturer")))
						else
							lds_barcodes.setitem(ll_currrow, "clientname", ls_clientname)
						end if
						if gs_company = "TOTALMEDICAL" then
							lds_barcodes.setitem(ll_currrow, "packingdesc", trim(this.tab_retrieve.tabpage_detail.dw_itemsdetail.getitemstring(ll_counter, "packingdesc")))
						end if
						if gs_company = "GRANDMART" then
						end if
					next
				end if
			end if
		next
	end if
	this.tab_retrieve.tabpage_detail.dw_barcodelist.setredraw(false)
	lds_barcodes.sharedata(this.tab_retrieve.tabpage_detail.dw_barcodelist)
	this.tab_retrieve.tabpage_detail.dw_barcodelist.setredraw(true)
	if lb_listtab then
		lstr.dw = this.tab_retrieve.tabpage_detail.dw_barcodelist
		lstr.s_name1 = lds_barcodes.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			destroy lds_barcodes
			return
		end if
		return
	end if
	this.tab_retrieve.tabpage_detail.dw_barcodelist.print()
	destroy lds_barcodes

// w_barcodelabels.ue_postopen() returns 0 [event]
	string ls_printer
	string ls_null
	datawindowchild ldc_dddpurcategory
	datawindowchild ldc_headerno
	datawindowchild ldc_formattype
	integer li_rtncode
	long ll_code
	long ll_counter
	long ll_found
	m_barcodelabelmenu lm_menu
	call super::ue_postopen
	lm_menu = this.menuid
	setredraw(false)
	setnull(ls_null)
	wf_setpurchasetype(integer(message.doubleparm))
	this.id_print = this.dw_purinvrep
	this.id_print.settransobject(this.it_transobject)
	ls_printer = trim(f_stringpreferences("BarCodePrinterName"))
	this.tab_retrieve.tabpage_detail.dw_barcodelist.dataobject = f_assign_labelsheet_format()
	if this.tab_retrieve.tabpage_detail.dw_barcodelist.dataobject = "" or isnull(this.tab_retrieve.tabpage_detail.dw_barcodelist.dataobject) then
		this.tab_retrieve.tabpage_detail.dw_barcodelist.dataobject = "d_barcodelabels_rahat2"
	end if
	choose case this.ii_purchasetype
	case 1
		this.title = "BarCode Label Printing"
		if gs_company = "HCP" then
			wf_assigndatawindowobjects("d_labelPurchaseHeader2", "d_labelPurchaseDetail_homoeocures", "d_labelPurchaseList")
		else
			wf_assigndatawindowobjects("d_labelPurchaseHeader2", "d_labelPurchaseDetail", "d_labelPurchaseList")
		end if
	case 7
		this.ib_loosepurmodify = true
	case else
		this.ib_openingpurmodify = true
	end choose
	gd_itemsinfo.sharedata(this.id_itemslist)
	this.id_master.object.barcodeprinter.initial = ls_printer
	if f_stringpreferences("UseBarCodePrinter") = "N" then
		this.id_master.object.barcodeprinter_t.visible = false
		this.id_master.object.barcodeprinter.visible = false
		this.id_master.object.labelformat.dddw.name = "ddd_barcodelabel_laserprinter"
		this.id_master.object.labelformat.dddw.autoretrieve = "Yes"
		this.id_master.object.labelformat.dddw.allowedit = "No"
		this.id_master.object.labelformat.dddw.datacolumn = "datavalue"
		this.id_master.object.labelformat.dddw.displaycolumn = "displayvalue"
		this.id_master.getchild("labelformat", ldc_formattype)
		ldc_formattype.settransobject(this.it_transobject)
		ldc_formattype.retrieve()
		this.id_master.object.labelformat.initial = trim(string(f_numberpreferences("defaultbarcodeformat")))
	else
		this.id_master.object.labelformat.initial = trim(string(f_numberpreferences("defaultbarcodeformat")))
	end if
	this.tab_retrieve.tabpage_detail.dw_cells.insertrow(0)
	this.tab_retrieve.tabpage_detail.dw_cells.setitem(1, "fromcell", 1)
	if gs_company = "HCP" then
		this.tab_retrieve.tabpage_detail.dw_cells.setitem(1, "tocell", 15)
	else
		this.tab_retrieve.tabpage_detail.dw_cells.setitem(1, "tocell", 70)
	end if
	this.tab_retrieve.tabpage_detail.dw_cells.setitem(1, "startswith", f_stringpreferences("barcodepricestartswith"))
	this.tab_retrieve.tabpage_detail.dw_cells.setitem(1, "endswith", f_stringpreferences("barcodepriceendswith"))
	if f_stringpreferences("ShowStartsEndsInBarCodeModule") = "Y" then
		this.tab_retrieve.tabpage_detail.dw_cells.object.startswith.visible = 1
		this.tab_retrieve.tabpage_detail.dw_cells.object.t_startswith.visible = 1
		this.tab_retrieve.tabpage_detail.dw_cells.object.endswith.visible = 1
		this.tab_retrieve.tabpage_detail.dw_cells.object.t_endswith.visible = 1
	else
		this.tab_retrieve.tabpage_detail.dw_cells.object.startswith.visible = 0
		this.tab_retrieve.tabpage_detail.dw_cells.object.t_startswith.visible = 0
		this.tab_retrieve.tabpage_detail.dw_cells.object.endswith.visible = 0
		this.tab_retrieve.tabpage_detail.dw_cells.object.t_endswith.visible = 0
	end if
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.im_menu.m_file.m_post.visible = false
	this.im_menu.m_file.m_post.toolbaritemvisible = false
	this.im_menu.m_file.m_save.visible = false
	this.im_menu.m_file.m_save.toolbaritemvisible = false
	this.id_master.getchild("headerno", ldc_headerno)
	ldc_headerno.reset()
	for ll_counter = 1 to gds_reoprtheaderinfo.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "name", gds_reoprtheaderinfo.getitemstring(ll_counter, "clientname"))
		ldc_headerno.setitem(ll_counter, "code", gds_reoprtheaderinfo.getitemnumber(ll_counter, "headerno"))
	next
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 569", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_showinvoicelist = true
	else
		this.ib_showinvoicelist = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 578", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_generate.visible = true
		lm_menu.m_file.m_generate.enabled = true
	else
		lm_menu.m_file.m_generate.visible = false
		lm_menu.m_file.m_generate.enabled = false
	end if
	if f_stringpreferences("ShowHeaderInBarCodeModule") = "Y" then
		this.id_master.object.headerno.visible = 1
		this.id_master.object.t_headerno.visible = 1
	else
		this.id_master.object.headerno.visible = 0
		this.id_master.object.t_headerno.visible = 0
	end if
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = false
	this.id_itemslist.object.sstock.visible = false
	this.id_itemslist.object.t_pstock.visible = true
	this.id_itemslist.object.pstock.visible = true
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.pstock.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	if f_stringpreferences("showbatchinbarcode") = "N" then
		this.id_detail.object.batch.visible = false
	end if
	if f_stringpreferences("showmfgdateinbarcode") = "N" then
		this.id_detail.object.manfdate.visible = false
		this.id_detail.object.manfdate.initial = ls_null
	end if
	if f_stringpreferences("showexpirydateinbarcode") = "N" then
		this.id_detail.object.expiry.visible = false
	end if
	if f_stringpreferences("showsalepriceinbarcode") = "N" then
		this.id_detail.object.saleprice.visible = false
	end if
	if f_stringpreferences("showretailpriceinbarcode") = "N" then
		this.id_detail.object.retailprice.visible = false
	end if
	if f_stringpreferences("showsalestaxinbarcode") = "N" then
		this.id_detail.object.salestax.visible = false
	end if
	if f_stringpreferences("showcustomerpriceinbarcode") = "N" then
		this.id_detail.object.c_customerprice.visible = false
	end if
	if f_stringpreferences("showremarksinbarcode") = "N" then
		this.id_detail.object.remarks.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	if gs_company = "PP" or gs_company = "POTPOURRIWHOUSE" then
		this.id_master.object.labelformat.visible = true
		this.id_master.object.labelformat_t.visible = true
	end if
	if f_stringpreferences("printpriceonbarcodelabel") = "Y" then
		lm_menu.m_file.m_printprice.checked = true
		this.ib_printprice = true
	else
		lm_menu.m_file.m_printprice.checked = false
		this.ib_printprice = false
	end if
	setredraw(true)

// w_barcodelabels.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	show()
	return ::message.returnvalue

// tab_retrieve.selectionchanging(integer oldindex, integer newindex) returns long [event]
	integer li_yesno
	integer li_rtcode
	return li_rtcode

// tabpage_detail.create() returns 0 [event]
	integer icurrent
	this.dw_cells = create dw_cells
	this.dw_barcodelist = create dw_barcodelist
	call super::create
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_cells
	this.control[icurrent + 2] = this.dw_barcodelist

// tabpage_detail.destroy() returns 0 [event]
	call super::destroy
	destroy this.dw_cells
	destroy this.dw_barcodelist

// dw_footer.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	return ::message.returnvalue

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
		return 1
	case "faltdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
		return 1
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
		return 1
	end choose
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_result
	long ll_code
	long ll_manfcode
	long ll_detailrows
	double ld_price
	string ls_null
	date ld_null
	dwitemstatus lrs_status
	integer li_res
	integer li_suppcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "loosepack"
		return parent.parent.parent.wf_set_packing_effect(long(data))
	case "suppcode"
		ll_code = long(data)
		parent.parent.parent.wf_setsuppinfo(ll_code, this)
	case "aliasname"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findsuppcode(data, li_suppcode)
			if li_res > 0 then
				setitem(row, "suppcode", li_suppcode)
				return 0
			else
				messagebox("Supplier Validation", "Supplier with  AliasName " + data + " does not exist")
				return 1
			end if
			return
		end if
	case "pocode"
		if not isnull(data) and integer(data) <> 0 then
			ll_detailrows = parent.dw_itemsdetail.rowcount()
			if ll_detailrows > 0 then
				lrs_status = parent.dw_itemsdetail.getitemstatus(1, 0, primary!)
				if lrs_status <> new! then
					li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
					if li_result = 2 then
						return 2
					else
						parent.dw_itemsdetail.setredraw(false)
						parent.dw_itemsdetail.reset()
						parent.dw_itemsdetail.insertrow(0)
						parent.dw_itemsdetail.setredraw(true)
					end if
				end if
				ll_code = long(data)
				ll_manfcode = parent.parent.parent.wf_setpurorderinfo(ll_code)
				parent.parent.parent.im_menu.m_file.m_options.enabled = true
				this.object.suppcode.protect = 1
			else
				parent.parent.parent.im_menu.m_file.m_options.enabled = false
				this.object.suppcode.protect = 0
				setnull(ll_manfcode)
				setnull(ls_null)
				setnull(ld_null)
				this.object.manfcode[row] = ll_manfcode
				this.object.manfname[row] = ls_null
				this.object.podate[row] = ld_null
			end if
		end if
	end choose
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "suppcode"
		messagebox("Supplier Name Validation", "You must select some supplier")
		return 1
	end choose
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	long ll_newqty
	long ll_storedqty
	long ll_null
	long ll_currentrow
	long ll_bonusqty
	long ll_packqty
	long ll_defaultqty = 1
	long ll_icode
	long ll_itemcodetype
	double ld_stock
	double ld_godownstock
	string ls_null
	string ls_itemname
	datetime ldt_expiry
	date ld_expiry
	time lt_expiry
	string ls_error
	datawindowchild ldc_items
	dwitemstatus lrs_status
	integer li_res
	double ld_saleprice
	integer li_packunits
	integer li_retmsgcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	ll_currentrow = getrow()
	lrs_status = getitemstatus(ll_currentrow, 0, primary!)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
		parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		li_errcode = 0
	case "icode"
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	case "bonusqty"
		ll_bonusqty = long(data)
		ll_packqty = getitemnumber(row, "packqty")
		if parent.parent.parent.ii_purchasetype = 1 and ll_packqty + ll_bonusqty <= 0 then
			setitem(row, "packqty", ll_defaultqty)
		end if
	case "packqty"
		ll_packqty = long(data)
		ll_bonusqty = getitemnumber(row, "bonusqty")
		if ll_packqty + ll_bonusqty <= 0 then
			setitem(row, "bonusqty", ll_defaultqty)
		end if
	case "gcode"
		accepttext()
		parent.parent.parent.it_transobject.getitemstocktotal(getitemnumber(row, "gcode"), getitemnumber(row, "icode"), ld_godownstock)
		parent.parent.parent.id_footer.setitem(1, "stock", ld_godownstock)
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname, ll_itemcodetype, parent.parent.parent.idbl_packqty, parent.parent.parent.idbl_purprice, parent.parent.parent.idbl_saleprice)
			if li_res > 0 then
				if parent.parent.parent.idbl_packqty = 0.0 then
					parent.parent.parent.idbl_packqty = 1
				end if
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				parent.parent.parent.wf_set_itemcodetype(row, ll_itemcodetype, "itemcodetype")
				if ll_itemcodetype = 2 then
					setitem(row, "alternatecustomicode", data)
				end if
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
			else
				messagebox("ItemNumber Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_errcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_errcode = 2
		end if
	case "purprice"
		ll_icode = parent.parent.parent.id_detail.getitemnumber(row, "icode")
		SQL Select item.saleprice , item.packunits INTO :ld_saleprice, :li_packunits From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
		choose case parent.parent.parent.ii_purchasetype
		case 1
			if double(data) > ld_saleprice then
				li_retmsgcode = messagebox("Purchase Validation", "Purchase Price " + data + " is greater than Sale Price~r~n Do you want to continue", question!, yesno!)
				if li_retmsgcode = 1 then
					li_errcode = 0
				else
					li_errcode = 1
				end if
			end if
		case 7
			if double(data) > ld_saleprice / li_packunits then
				li_retmsgcode = messagebox("Purchase Validation", "Purchase Price " + data + " is greater than Sale Price~r~n Do you want to continue", question!, yesno!)
				if li_retmsgcode = 1 then
					li_errcode = 0
				else
					li_errcode = 1
				end if
			end if
		end choose
	case "expiry"
		ld_expiry = date(mid(data, 1, 10))
		lt_expiry = time("00:00:00.000000")
		ldt_expiry = datetime(ld_expiry, lt_expiry)
		if ld_expiry <= today() then
			messagebox("Item Validation", "Expiry should be greater than today's date")
			li_errcode = 1
		elseif rowcount() > 1 and ldt_expiry <> datetime("00/00/0000, 00:00:00") and not (isnull(this.object.icode[row]) and isnull(this.object.batch[row]) and isnull(this.object.expiry[row])) and vf_dwdupcodebatch(this, "gcode", gl_defaultgcode, "icode", getitemnumber(getrow(), "icode"), "batch", getitemstring(getrow(), "batch"), "expiry", ldt_expiry, parent.parent.parent.il_currrow) = true then
			messagebox("Item Validation", "Duplicate item, please select some other item")
			li_errcode = 1
		end if
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "itemname" then
		parent.parent.parent.ib_focusdetail = true
	end if
	if dwo.name = "saleprice" then
		selecttext(1, len(gettext()) + 10)
	else
		selecttext(1, len(gettext()) + 10)
	end if
	parent.parent.parent.wf_grandtotal()
	parent.parent.parent.editflag = true
	if dwo.name = parent.parent.parent.is_columnitemname then
		if isnull(getitemnumber(row, "icode")) and parent.parent.parent.ib_focusdetail then
			parent.parent.parent.wf_showlist(getitemnumber(row, "CurrListRow"))
		end if
	else
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
	end if
	return 0

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	double ld_saleprice
	double ld_avgprice
	dwitemstatus lrs_status
	long ll_icode
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if getcolumnname() <> parent.parent.parent.is_columnitemname then
		if rowcount() > 0 and lrs_status <> new! then
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", getitemnumber(currentrow, "icode"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", getitemnumber(currentrow, "stock"))
			ll_icode = getitemnumber(getrow(), "icode")
			SQL Select item.saleprice , item.avgprice INTO :ld_saleprice, :ld_avgprice From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			parent.parent.parent.id_footer.object.t_saleprice.text = string(ld_saleprice)
			parent.parent.parent.id_footer.object.t_avgprice.text = string(ld_avgprice)
		elseif parent.parent.parent.id_footer.getrow() > 0 then
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", 0)
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_colname
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	ls_colname = dwo.name
	if ls_colname = "Qty" or ls_colname = "discperc" or ls_colname = "purprice" then
		parent.parent.parent.wf_grandtotal()
	elseif ls_colname = "saleprice" and data = "" then
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "fullcode"
		if isnull(data) or data = "" then
			messagebox("Item Code Validation", "Item Code ~"" + data + "~" does not exist")
		end if
		return 1
	case parent.parent.parent.is_columnitemname
		messagebox("Item Validation", "Value required for item in current row")
		return 1
	case "icode"
		messagebox("Item Validation", "Value required for item in current row")
		return 1
	case "qty"
		messagebox("Item Qty Validation", "Item Qty ~"" + data + "~" should be greater than or equal to zero")
		return 1
	case "looseqty"
		messagebox("Item Qty Validation", "Item Qty ~"" + data + "~" should be greater than zero")
		return 1
	case "discperc"
		messagebox("Item Discount Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
		return 1
	case "purprice"
		return 1
	case "expiry"
		return 1
	end choose
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	long ancestorreturnvalue
	if f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	integer li_rowno
	parent.parent.parent.id_detail.accepttext()
	li_rowno = gd_itemsinfo.find("fullcode='" + parent.parent.parent.id_detail.object.fullcode[parent.parent.parent.id_detail.getrow()] + "'", 1, gd_itemsinfo.rowcount())
	if getrow() = rowcount() then
		if getcolumn() = integer(this.object.datawindow.column.count) then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
		if getcolumn() = 1 and li_rowno > 0 then
			parent.parent.parent.id_detail.setcolumn(integer(this.object.datawindow.column.count))
			setfocus()
			return 1
		end if
		return
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_cells.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// dw_cells.itemchanged(long row, dwobject dwo, string data) returns long [event]
	return ::message.returnvalue
