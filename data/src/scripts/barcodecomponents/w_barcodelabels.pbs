// window w_barcodelabels (barcodecomponents)  ancestor: w_multi_entry

// w_barcodelabels.ue_print_2() returns 0 [event]
	long ll_totalrows
	long ll_retcode
	string ls_printer
	if this.id_detail.accepttext() = -1 then
		return
	end if
	if this.id_master.accepttext() = -1 then
		return
	end if
	ll_totalrows = this.id_detail.rowcount()
	if ll_totalrows <= 0 then
		return
	end if
	ls_printer = this.id_master.object.barcodeprinter[1]
	ll_retcode = wf_assign_dllbased_barcodeprinter()
	if ll_retcode = 1 then
		return
	end if
	ll_retcode = wf_assign_scriptbased_barcodeprinter()
	if ll_retcode = 1 then
		return
	end if
	if lower(ls_printer) = lower("Argox OS-214TT PPLA") then
		f_printbarcode_agrox_os_214tt_ppla(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("TSC TTP-2410 M") then
		f_printbarcode_tsc_ttp2410m(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("TEC B-443 (300 DPI)") then
		f_printbarcode_tec_b443(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Gprinter GP-1125T") then
		f_printbarcode_gprinter_gp_1125t(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Gprinter GP-3120T") then
		f_printbarcode_gprinter_gp_3120t(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Gprinter GP-1624T") then
		f_printbarcode_gprinter_gp_1624t(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif left(lower(ls_printer), 8) = lower("Gainscha") then
		f_printbarcode_gainscha(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("TSC  B-2404") then
		f_printbarcode_tsc_b_2404(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("TSC TA200") then
		f_printbarcode_tsc_ta200(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("TSC TE200") then
		f_printbarcode_tsc_te200(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("TSC TTP/TDP-243M(244ME)") then
		f_printbarcode_tsc_ttp_tdp_243m_244me(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("TSC TTP-244 PLUS") then
		f_printbarcode_tsc_ttp_244_plus(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("TSC TTP-246M Plus") then
		f_printbarcode_tsc_ttp_246m_plus(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("TSC TTP-245 Plus") then
		f_printbarcode_tsc_ttp_245_plus(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("TSC TTP-244 PRO") then
		f_printbarcode_tsc_ttp_244_pro(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("TSC ME240") then
		f_printbarcode_tsc_me_240(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("TSC TTP-2410M Pro") then
		f_printbarcode_tsc_ttp_2410m_pro(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("TSC TDP-247") then
		f_printbarcode_tsc_tdp_247(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("TSC TA210") then
		f_printbarcode_tsc_ta210(this.id_master, this.id_detail, this.ib_printprice)
		return
	end if
	if lower(ls_printer) = lower("BIXOLON SLP-T400") then
		f_printbarcode_bixolon_slp_t400(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Bixolon SAMSUNG SRP 770II") then
		f_printbarcode_bixolon_samsung_srp_770(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Monarch 9855)") then
		f_printbarcode_monarch_9855(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Zebra S4M (203dpi)") then
		f_printbarcode_zebra_s4m_203dpi(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Zebra S4M (200dpi)") then
		f_printbarcode_zebra_zs4m_200dpi(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Zebra S4M (300dpi)") then
		f_printbarcode_zebra_zs4m_300dpi(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Zebra TLP2742") then
		f_printbarcode_zebra_tlp2742(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Zebra  Z4M Plus (200dpi)") then
		f_printbarcode_zebra_z4mplus_200dpi(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Zebra TLP2824") then
		f_printbarcode_zebra_tlp_2824(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Zebra TLP 2844") then
		f_printbarcode_zebra_tlp_2844(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Zebra TLP 2844z") then
		f_printbarcode_zebra_tlp_2844z(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Zebra ZM 400 (200dpi)") then
		f_printbarcode_zebra_zm400_200dpi(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Zebra Gc 420t") then
		f_printbarcode_zebra_gc420t(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("ZDesigner LP 2844") then
		f_printbarcode_zdesigner_lp_2844(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("ZDesigner LP 2824") then
		f_printbarcode_zdesigner_lp_2824(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Zebra DA402") then
		f_printbarcode_zebra_da402(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Zebra GK420d") then
		f_printbarcode_zebra_gk420d(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Xprinter XP-360B") then
		f_printbarcode_xprinter_xp_360b(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("ZDesigner GK888t (EPL)") then
		f_printbarcode_zebra_gkk888t(this.id_master, this.id_detail, this.ib_printprice)
		return
	elseif lower(ls_printer) = lower("Zebra ZT230") then
		f_printbarcode_zebra_zt230(this.id_master, this.id_detail, this.ib_printprice)
		return
	end if

// w_barcodelabels.ue_generate() returns long [event]
	long ll_criteria = 1
	open(w_selectformat_purchase_receipt)
	ll_criteria = message.doubleparm
	if ll_criteria = 1 then
		wf_populatepurinvoices()
	else
		wf_populatereceipt()
	end if
	return 0

// w_barcodelabels.wf_setsuppinfo(long al_suppcode, datawindow ad_master) returns 0
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	double ld_currbalance
	SQL SELECT supplier.address1 , supplier.city , supplier.phone INTO :ls_address, :ls_city, :ls_phone FROM supplier WHERE supplier.suppcode =:al_suppcode USING this.it_transobject;
	ll_currow = ad_master.getrow()
	ll_currow = 1
	ad_master.object.address[ll_currow] = ls_address
	ad_master.object.city[ll_currow] = ls_city
	ad_master.object.phone[ll_currow] = ls_phone

// w_barcodelabels.wf_releaselock(long al_icode) returns boolean
	boolean retflag = true
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM godowndetail ( NOLOCK ) WHERE godowndetail.Gcode =:gl_defaultgcode AND godowndetail.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_barcodelabels.wf_setpurorderinfo(long al_purordercode) returns long
	long ll_manfcode
	long ll_suppcode
	long ll_salesmancode
	long ll_row
	integer li_rtcode
	datetime ld_podate
	string ls_podate
	string ls_manfname
	SQL SELECT purorderheader.manfcode , purorderheader.suppcode , purorderheader.date INTO :ll_manfcode, :ll_suppcode, :ld_podate FROM purorderheader WHERE purorderheader.pocode =:al_purordercode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Cannot Connect to Database", this.it_transobject.sqlerrtext)
		li_rtcode = -1
	end if
	SQL SELECT manufacturer.name INTO :ls_manfname FROM manufacturer WHERE manufacturer.manfcode =:ll_manfcode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Cannot Connect to Database", this.it_transobject.sqlerrtext)
		li_rtcode = -1
	end if
	ll_row = this.id_master.getrow()
	ll_row = 1
	this.id_master.object.suppcode[ll_row] = ll_suppcode
	this.id_master.object.podate[ll_row] = ld_podate
	this.id_master.object.manfname[ll_row] = ls_manfname
	this.id_master.object.manfcode[ll_row] = ll_manfcode
	wf_setsuppinfo(ll_suppcode, this.id_master)
	return ll_manfcode

// w_barcodelabels.wf_getpomanfcode(long al_pocode, long al_manfcode) returns 0
	al_pocode = this.id_master.object.pocode[this.id_master.getrow()]
	al_manfcode = this.id_master.object.manfcode[this.id_master.getrow()]

// w_barcodelabels.wf_lockpurchaseinvoice(long al_purinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From purledger WITH ( UPDLOCK HOLDLOCK ) Where purledger.purinvcode =:al_purinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_barcodelabels.wf_retrievelistall() returns long
	string[] ls_posted
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	return this.id_list.retrieve(ls_posted)

// w_barcodelabels.wf_setpurchasetype(integer ai_purchasetype) returns 0
	if ai_purchasetype <= 2 then
		if isnull(ai_purchasetype) then
			this.ii_purchasetype = 2
		else
			this.ii_purchasetype = ai_purchasetype
		end if
		return
	end if
	if ai_purchasetype = 7 then
		this.ii_purchasetype = 7
		return
	end if
	this.ii_purchasetype = 1

// w_barcodelabels.wf_lockloosepurinvoices(long al_sinvcode, long al_linvcode) returns integer
	integer li_count
	SQL SELECT count ( *) INTO :li_count FROM purledger WITH ( UPDLOCK HOLDLOCK ) WHERE purledger.purinvcode Between :al_sinvcode and :al_linvcode AND ( purledger.purcatcode =7 or purledger.purcatcode =8 ) USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_barcodelabels.wf_updateitemavgprice(long al_icode, double ad_newavgprice) returns boolean
	boolean retflag = true
	SQL update item SET item.avgprice =:ad_newavgprice WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_barcodelabels.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	return true

// w_barcodelabels.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to 1 step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_barcodelabels.wf_updateitempurdisc(long al_icode, double ad_disc) returns integer
	SQL update Item SET PurDiscPerc =:ad_disc WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_barcodelabels.wf_locknormalpurinvoices(long al_sinvcode, long al_linvcode) returns integer
	integer li_count
	SQL SELECT count ( *) INTO :li_count FROM purledger WITH ( UPDLOCK HOLDLOCK ) WHERE purledger.purinvcode Between :al_sinvcode and :al_linvcode AND ( purledger.purcatcode =1 or purledger.purcatcode =2 ) USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_barcodelabels.wf_getitemsaleprice(long al_icode, double ad_saleprice) returns boolean
	boolean retflag = true
	SQL SELECT item.salePrice INTO :ad_saleprice FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if isnull(ad_saleprice) then
		ad_saleprice = 0
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_barcodelabels.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_barcodelabels.wf_updateitempurprice(long al_icode, double ad_purprice) returns integer
	SQL update Item SET purprice =:ad_purprice WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_barcodelabels.wf_updaterecentpurprice(long al_icode, double ad_rpp) returns integer
	SQL update Item SET recentpurprice =:ad_rpp WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_barcodelabels.wf_lockpurinvoices(long al_sinvcode, long al_linvcode) returns integer
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM purledger WITH ( UPDLOCK HOLDLOCK ) WHERE purledger.purinvcode Between :al_sinvcode and :al_linvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_barcodelabels.wf_lockopeningpurinvoices(long al_sinvcode, long al_linvcode) returns integer
	integer li_count
	SQL SELECT count ( *) INTO :li_count FROM purledger WITH ( UPDLOCK HOLDLOCK ) WHERE purledger.purinvcode Between :al_sinvcode and :al_linvcode AND purledger.purcatcode =3 USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_barcodelabels.wf_post() returns boolean
	long ll_code1
	long ll_code2
	integer li_errcode
	long ll_supplieracc
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_icode
	long ll_gcode
	long ll_purqty
	long ll_purbonusqty
	long ll_packqty
	long ll_bonusqty
	long ll_packingunits
	long ll_looseqty
	long ll_salesmancode
	long ll_errrowid
	double ld_stock
	double ld_newstock
	string ls_batch
	datetime ld_expiry
	double ld_avgprice
	double ld_newavgprice
	double ld_purprice
	double ld_purdiscpack
	double ld_discperc
	double ld_itempurcost
	double ld_netpurcost
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_debitamt
	double ld_creditamt
	double ld_currbalance
	double ld_recentpurprice
	double ld_purpricepack
	double ld_purpriceloose
	integer li_detailcounter
	integer li_purchasecategory
	boolean lb_commitflag = true
	integer ci_normalpurchase = 1
	integer ci_openingpurchase = 3
	integer ci_loosepurchase = 7
	long ll_rowcount
	long ll_invcounter
	long ll_invcode
	s_arguements lstr_arginfo
	datastore lds_purinvforposting
	datastore lds_purheader
	datastore lds_purdetail
	lds_purinvforposting = create datastore
	lds_purinvforposting.dataobject = "d_purinvno"
	lds_purinvforposting.settransobject(this.it_transobject)
	lds_purheader = create datastore
	lds_purheader.dataobject = "d_normalpurchaseheader"
	lds_purheader.settransobject(this.it_transobject)
	lds_purdetail = create datastore
	lds_purdetail.dataobject = "d_normalpurchasedetail"
	lds_purdetail.settransobject(this.it_transobject)
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			choose case this.ii_purchasetype
			case 1
				li_errcode = wf_locknormalpurinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
				ll_code1 = lstr_arginfo.l_code1
				ll_code2 = lstr_arginfo.l_code2
				lds_purinvforposting.retrieve(1, 2, lstr_arginfo.l_code1, lstr_arginfo.l_code2)
			case ci_loosepurchase
				li_errcode = wf_lockloosepurinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
				lds_purinvforposting.retrieve(7, 8, lstr_arginfo.l_code1, lstr_arginfo.l_code2)
			case else
				li_errcode = wf_lockopeningpurinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
				lds_purinvforposting.retrieve(3, 0, lstr_arginfo.l_code1, lstr_arginfo.l_code2)
			end choose
			if li_errcode = 0 then
				ll_rowcount = lds_purinvforposting.rowcount()
				for ll_invcounter = 1 to ll_rowcount
					ll_invcode = lds_purinvforposting.object.purinvcode[ll_invcounter]
					lds_purheader.retrieve(ll_invcode)
					lds_purdetail.retrieve(ll_invcode)
					ll_mastercurrrow = lds_purheader.getrow()
					ll_detailrows = lds_purdetail.rowcount()
					lds_purheader.object.posted[ll_mastercurrrow] = "Y"
					lds_purheader.object.postdate[ll_mastercurrrow] = today()
					lds_purheader.object.postedby[ll_mastercurrrow] = ll_salesmancode
					ld_misccharges = lds_purheader.object.misccharges[ll_mastercurrrow]
					ld_invdiscperc = lds_purheader.object.discperc[ll_mastercurrrow]
					ld_flatdisc = lds_purheader.object.flatdisc[ll_mastercurrrow]
					ld_salestax = lds_purheader.object.salestax[ll_mastercurrrow]
					li_detailcounter = 1
					if ll_detailrows < 1 then
						lb_commitflag = false
					end if
					do while li_detailcounter <= ll_detailrows and lb_commitflag = true
						ll_icode = lds_purdetail.object.icode[li_detailcounter]
						ll_gcode = lds_purdetail.object.gcode[li_detailcounter]
						ls_batch = lds_purdetail.object.batch[li_detailcounter]
						ld_expiry = lds_purdetail.object.expiry[li_detailcounter]
						ll_packqty = lds_purdetail.object.packqty[li_detailcounter]
						ll_looseqty = lds_purdetail.object.looseqty[li_detailcounter]
						ll_bonusqty = lds_purdetail.object.bonusqty[li_detailcounter]
						ll_packingunits = lds_purdetail.object.packunits[li_detailcounter]
						ld_discperc = lds_purdetail.object.discperc[li_detailcounter]
						choose case this.ii_purchasetype
						case 1
							ld_purprice = lds_purdetail.object.purprice[li_detailcounter] / ll_packingunits
							ll_purqty = ll_packqty * ll_packingunits
							ll_purbonusqty = ll_bonusqty * ll_packingunits
							ld_purpricepack = lds_purdetail.object.purprice[li_detailcounter]
							ld_purdiscpack = lds_purdetail.object.discperc[li_detailcounter]
							if f_stringpreferences("UpdatePurPrice") = "Y" and wf_updateitempurprice(ll_icode, ld_purpricepack) <> 0 then
								lb_commitflag = false
							end if
							if f_stringpreferences("UpdatePurDisc") = "Y" and wf_updateitempurdisc(ll_icode, ld_purdiscpack) <> 0 then
								lb_commitflag = false
							end if
							ld_recentpurprice = round(ld_purpricepack * (1.0 - ld_discperc * 0.01) * (1.0 - ld_invdiscperc * 0.01) * ll_packqty / (ll_packqty + ll_bonusqty), 2)
							if wf_updaterecentpurprice(ll_icode, ld_recentpurprice) <> 0 then
								lb_commitflag = false
							end if
						case else
							ld_purprice = lds_purdetail.object.purprice[li_detailcounter]
							ll_purqty = ll_looseqty
							ll_purbonusqty = ll_bonusqty
							ld_recentpurprice = round(ld_purprice * (1.0 - ld_discperc * 0.01) * (1.0 - ld_invdiscperc * 0.01) * ll_purqty / (ll_purqty + ll_purbonusqty), 2)
						end choose
						ld_itempurcost = ll_purqty * ld_purprice * (1.0 - ld_discperc * 0.01) * (1.0 - ld_invdiscperc * 0.01)
						ld_netpurcost = ld_netpurcost + ld_itempurcost
						this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
						if this.it_transobject.sqlcode = 0 then
							this.it_transobject.getitemstockall(ll_icode, ld_stock)
							if this.it_transobject.sqlcode = 0 then
								lds_purdetail.object.avgprice[li_detailcounter] = ld_avgprice
								lds_purdetail.object.currstock[li_detailcounter] = ld_stock
								ld_newstock = ld_stock + ll_purqty + ll_purbonusqty
								if ld_newstock > 0.0 then
									ld_newavgprice = (ld_stock * ld_avgprice + ld_itempurcost) / ld_newstock
									lds_purdetail.object.newavgprice[li_detailcounter] = ld_newavgprice
									this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
									if this.it_transobject.sqlcode = 0 then
										ld_newstock = ld_stock + ll_purqty + ll_purbonusqty
										this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
										if this.it_transobject.sqlcode = 0 then
											this.it_transobject.updateitemavgprice(ll_icode, ld_newavgprice)
											if this.it_transobject.sqlcode <> 0 then
												lb_commitflag = false
											end if
										else
											lb_commitflag = false
										end if
									else
										lb_commitflag = false
									end if
								else
									lb_commitflag = false
								end if
							else
								lb_commitflag = false
							end if
						else
							lb_commitflag = false
						end if
						li_detailcounter = li_detailcounter + 1
					loop
					if lb_commitflag = false then
						SQL rollback USING this.it_transobject;
						messagebox("Updation Fail", string(ll_invcode) + "  invoice code" + "~n~r and greater can not be posted")
						destroy lds_purinvforposting
						destroy lds_purheader
						destroy lds_purdetail
						return lb_commitflag
					elseif lds_purheader.update(true, false) < 0 then
						SQL rollback USING this.it_transobject;
					elseif lds_purdetail.update() > 0 then
						SQL commit USING this.it_transobject;
					else
						SQL rollback USING this.it_transobject;
					end if
				next
				messagebox("Posting", "Posting Completed")
				destroy lds_purinvforposting
				destroy lds_purheader
				destroy lds_purdetail
				return lb_commitflag
			end if
			return
		end if
		return
	end if
	setpointer(arrow!)
	return lb_commitflag

// w_barcodelabels.wf_initmodify(integer ai_protect) returns 0
	long ll_purinvcode
	long ll_gcode
	long ll_icode
	long ll_looseqty
	long ll_counter = 1
	long ll_packqty
	long ll_bonusqty
	long ll_packunits
	string ls_batch
	datetime ld_expiry
	double ld_saleprice
	double ld_avgprice
	double ld_stock
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_purinvcode = this.id_detail.getitemnumber(1, "code")
		if wf_lockpurchaseinvoice(ll_purinvcode) = 0 then
			for ll_counter = 1 to this.id_detail.rowcount()
				ll_gcode = this.id_detail.getitemnumber(ll_counter, "gcode")
				ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
				ll_looseqty = this.id_detail.getitemnumber(ll_counter, "looseqty")
				ll_packqty = this.id_detail.getitemnumber(ll_counter, "packqty")
				ll_bonusqty = this.id_detail.getitemnumber(ll_counter, "bonusqty")
				ll_packunits = this.id_detail.getitemnumber(ll_counter, "packunits")
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					ai_protect = 0
					choose case this.ii_purchasetype
					case 1
						this.id_footer.setitem(ll_counter, "stock", ld_stock - ll_looseqty - ll_packqty * ll_packunits + ll_bonusqty * ll_packunits)
					case else
						this.id_footer.setitem(ll_counter, "stock", ld_stock - ll_looseqty - ll_packqty * ll_packunits + ll_bonusqty)
					end choose
				end if
			next
			if ai_protect = 0 then
				this.id_footer.setitem(1, "stock", this.id_footer.getitemnumber(1, "stock"))
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
				SQL Select item.saleprice , item.avgprice INTO :ld_saleprice, :ld_avgprice From Item Where item.icode =:ll_icode USING this.it_transobject;
				this.id_footer.object.t_saleprice.text = string(ld_saleprice)
				this.id_footer.object.t_avgprice.text = string(ld_avgprice)
			end if
		end if
		return
	end if
	ai_protect = 1

// w_barcodelabels.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	return ld_grandtotal

// w_barcodelabels.wf_setgodownoption() returns 0

// w_barcodelabels.wf_iteminfo(long al_icode, long al_gcode, double ad_purprice, double ad_discperc, double ad_avgprice, long al_packunits) returns boolean
	boolean retflag = true
	SQL SELECT 1 , item.salePrice , item.purdiscperc , item.avgprice , item.packunits INTO :al_gcode, :ad_purprice, :ad_discperc, :ad_avgprice, :al_packunits FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if isnull(ad_purprice) then
		ad_purprice = 0
	elseif isnull(ad_discperc) then
		ad_discperc = 0
	elseif isnull(ad_avgprice) then
		ad_avgprice = 0
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_barcodelabels.wf_validateitem() returns integer
	long ll_icode
	long ll_gcode
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	string ls_fullcode
	string ls_errtext
	string ls_titleerrtext
	integer il_errcode = 1
	integer li_errcode
	integer li_null
	string ls_null
	ll_icode = this.id_detail.object.icode[this.il_currrow]
	if wf_genfullcode(ll_icode, ls_fullcode) > 0 then
		if this.id_detail.object.itemcodetype[this.il_currrow] = 0 then
			this.id_detail.object.fullcode[this.il_currrow] = ls_fullcode
		end if
		if not wf_inititeminfo(ll_icode, this.il_currrow, ls_errtext) then
			ls_titleerrtext = "Item Validation"
			li_errcode = -1
		end if
	else
		il_errcode = -1
	end if
	this.ib_itemvalidated = true
	if il_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
	end if
	return il_errcode

// w_barcodelabels.wf_selectprintreport() returns string
	string ls_report
	if gs_company = "PP" then
		ls_report = "d_PP_Purchaseinvreport"
		this.id_print.dataobject = ls_report
	end if
	this.id_print.settransobject(this.it_transobject)
	return ls_report

// w_barcodelabels.wf_findsuppcode(string as_aliasname, integer ai_suppcode) returns integer
	integer li_suppcode
	integer ll_retflag
	string ls_itemname
	SQL SELECT accounts.acccode INTO :li_suppcode FROM accounts , supplier WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =supplier.suppcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_suppcode = li_suppcode
		if isnull(ai_suppcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_barcodelabels.wf_inititeminfo(long al_icode, long al_row, string as_errortext) returns boolean
	boolean retflag = true
	double ld_purprice
	double ld_discperc
	double ld_saleprice
	double ld_avgprice
	double ld_retailprice
	double ld_prefferedsaleqty
	double ld_flatdisc
	double ld_packsalestax
	double ld_salediscperc
	double ld_effectivesaleprice
	long ll_packunits
	long ll_expdays
	long ll_loosepack = 1
	integer li_gcode
	string ls_null
	string ls_fullcode
	string ls_name
	string ls_packingdesc
	string ls_manufshortname
	string ls_design
	string ls_avgprice
	string ls_remarks
	string ls_packing
	string ls_alternatecustomicode
	string ls_manf
	string ls_manufaddress
	string ls_sizedescription
	string ls_size
	string ls_suppcode
	string ls_mrp
	string ls_location
	string ls_manufphone
	string ls_modeldescription
	string ls_lessitemflatdisc = "N"
	string ls_lessitemdiscperc = "N"
	setnull(ls_null)
	ls_lessitemflatdisc = f_stringpreferences("LetItemFlatDiscEffectSalePriceOnBarcode")
	if ls_lessitemflatdisc = "" or isnull(ls_lessitemflatdisc) then
		ls_lessitemflatdisc = "N"
	end if
	ls_lessitemdiscperc = f_stringpreferences("LetItemDiscPercEffectSalePriceOnBarcode")
	if ls_lessitemdiscperc = "" or isnull(ls_lessitemdiscperc) then
		ls_lessitemdiscperc = "N"
	end if
	if this.id_master.rowcount() > 0 then
		ll_loosepack = this.id_master.object.loosepack[1]
	end if
	SQL SELECT item.customicode , item.name , item.purprice , item.packunits , item.purdiscperc , item.gcode , item.saleprice , item.avgprice , packingdesc , Item.AvgPrice , ShortName =( SELECT M.ShortName FROM Manufacturer M WHERE M.ManfCode =Item.ManfCode ) , manufaddress =( SELECT M.Address1 FROM Manufacturer M WHERE M.ManfCode =Item.ManfCode ) , manufphone =( SELECT M.Phone FROM Manufacturer M WHERE M.ManfCode =Item.ManfCode ) , Design =( SELECT D.Name FROM ItemDesign D WHERE D.ItemDesignCode =Item.ItemDesignCode ) , Item.Remarks , Packing =( SELECT P.Name FROM ItemPacking P WHERE P.PackCode =Item.PackCode ) , Retailprice , packsalestax , Item.Location , Manufacturer =( SELECT M.ShortName FROM Manufacturer M WHERE M.ManfCode =Item.ManfCode ) , ExpDays =( SELECT IC.SaleExpiryDays FROM ItemCategory IC WHERE IC.ICatCode =Item.ICatCode ) , Item.PrefferedSaleQty , Item.SizeDescription , Size =( SELECT S.Name FROM ItemSize S WHERE S.ISizeCode =Item.ISizeCode ) , SuppCode =ISNULL ( ( SELECT MIN ( A.AliasName ) FROM PurDetail D , PurLedger P , Accounts A WHERE P.SuppCode =A.AccCode AND P.PurInvCode =D.PurInvCode AND D.PurUtn IN ( SELECT MAX ( DD.PurUTN ) FROM PurDetail DD WHERE DD.ICode =Item.ICode ) ) , - 1 ) , MRP =ISNULL ( ( SELECT MAX ( D.PurinvCode ) FROM PurDetail D WHERE D.PurUtn IN ( SELECT MAX ( DD.PurUTN ) FROM PurDetail DD WHERE DD.ICode =Item.ICode ) ) , - 1 ) , FlatDisc =Item.FlatDisc , ModelDescription =Item.ModelDescription , Item.SaleDiscPerc INTO :ls_fullcode, :ls_name, :ld_purprice, :ll_packunits, :ld_discperc, :li_gcode, :ld_saleprice, :ld_avgprice, :ls_packingdesc, :ld_avgprice, :ls_manufshortname, :ls_manufaddress, :ls_manufphone, :ls_design, :ls_remarks, :ls_packing, :ld_retailprice, :ld_packsalestax, :ls_location, :ls_manf, :ll_expdays, :ld_prefferedsaleqty, :ls_sizedescription, :ls_size, :ls_suppcode, :ls_mrp, :ld_flatdisc, :ls_modeldescription, :ld_salediscperc FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	ld_effectivesaleprice = ld_saleprice
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.ii_purchasegodownoption = 2 then
		this.ii_defaultgcode = li_gcode
	end if
	ls_alternatecustomicode = this.id_detail.object.alternatecustomicode[al_row]
	if isnull(ls_alternatecustomicode) then
		ls_alternatecustomicode = ""
	end if
	if lower(ls_fullcode) = lower(ls_alternatecustomicode) then
		ls_alternatecustomicode = ls_null
		this.id_detail.object.alternatecustomicode[al_row] = ls_null
	end if
	this.id_detail.setitem(al_row, "gcode", this.ii_defaultgcode)
	this.id_detail.setitem(al_row, "icode", al_icode)
	this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
	if this.id_detail.object.itemcodetype[al_row] = 0 then
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
	end if
	this.id_detail.object.design[al_row] = ls_design
	this.id_detail.object.manufshortname[al_row] = ls_manufshortname
	this.id_detail.object.manufaddress[al_row] = ls_manufaddress
	this.id_detail.object.manufphone[al_row] = ls_manufphone
	this.id_detail.object.avgprice[al_row] = ld_avgprice
	this.id_detail.object.remarks[al_row] = ls_remarks
	this.id_detail.object.packing[al_row] = ls_packing
	this.id_detail.object.manufacturer[al_row] = ls_manf
	this.id_detail.object.prefferedsaleqty[al_row] = ld_prefferedsaleqty
	this.id_detail.object.sizedescription[al_row] = ls_sizedescription
	this.id_detail.object.modeldescription[al_row] = ls_modeldescription
	this.id_detail.object.size[al_row] = ls_size
	this.id_detail.object.suppcode[al_row] = ls_suppcode
	this.id_detail.object.mrp[al_row] = ls_mrp
	this.id_detail.object.flatdisc[al_row] = ld_flatdisc
	this.id_detail.object.location[al_row] = ls_location
	if ll_loosepack = 1 then
		this.id_detail.setitem(al_row, "retailprice", ld_retailprice / ll_packunits)
	else
		this.id_detail.setitem(al_row, "retailprice", ld_retailprice)
	end if
	if ll_loosepack = 1 then
		this.id_detail.setitem(al_row, "salestax", ld_packsalestax / ll_packunits)
	else
		this.id_detail.setitem(al_row, "salestax", ld_packsalestax)
	end if
	if ll_expdays > 0 then
		this.id_detail.object.expiry[al_row] = datetime(relativedate(today(), ll_expdays), time("00:00:00"))
	end if
	if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) or this.id_detail.object.packunits[al_row] <= 0 then
		this.id_detail.setitem(al_row, "packunits", ll_packunits)
	end if
	if this.id_detail.object.code[al_row] > 0 then
		if f_stringpreferences("printsalepricefrombasicdata") = "Y" then
			if ll_loosepack = 1 then
				this.id_detail.setitem(al_row, "purprice", ld_purprice / ll_packunits)
				this.id_detail.setitem(al_row, "salepriceforitem", ld_saleprice / ll_packunits)
				this.id_detail.setitem(al_row, "qty", this.id_detail.object.qty[al_row] * ll_packunits)
				ld_effectivesaleprice = ld_saleprice / ll_packunits
				if ls_lessitemflatdisc = "Y" then
					ld_effectivesaleprice = ld_effectivesaleprice - ld_flatdisc
				end if
				if ls_lessitemdiscperc = "Y" then
					ld_effectivesaleprice = round(ld_effectivesaleprice * (1.0 - ld_salediscperc * 0.01), 2)
				end if
				this.id_detail.setitem(al_row, "saleprice", ld_effectivesaleprice)
			else
				this.id_detail.setitem(al_row, "purprice", ld_purprice)
				this.id_detail.setitem(al_row, "salepriceforitem", ld_saleprice)
				this.id_detail.setitem(al_row, "qty", this.id_detail.object.qty[al_row] / ll_packunits)
				ld_effectivesaleprice = ld_saleprice
				if ls_lessitemflatdisc = "Y" then
					ld_effectivesaleprice = ld_effectivesaleprice - ld_flatdisc
				end if
				if ls_lessitemdiscperc = "Y" then
					ld_effectivesaleprice = round(ld_effectivesaleprice * (1.0 - ld_salediscperc * 0.01), 2)
				end if
				this.id_detail.setitem(al_row, "saleprice", ld_effectivesaleprice)
			end if
		end if
	elseif ll_loosepack = 1 then
		this.id_detail.setitem(al_row, "purprice", ld_purprice / ll_packunits)
		this.id_detail.setitem(al_row, "salepriceforitem", ld_saleprice / ll_packunits)
		this.id_detail.setitem(al_row, "qty", this.id_detail.object.qty[al_row] * ll_packunits)
		ld_effectivesaleprice = ld_saleprice / ll_packunits
		if ls_lessitemflatdisc = "Y" then
			ld_effectivesaleprice = ld_effectivesaleprice - ld_flatdisc
		end if
		if ls_lessitemdiscperc = "Y" then
			ld_effectivesaleprice = round(ld_effectivesaleprice * (1.0 - ld_salediscperc * 0.01), 2)
		end if
		this.id_detail.setitem(al_row, "saleprice", ld_effectivesaleprice)
	else
		this.id_detail.setitem(al_row, "purprice", ld_purprice)
		this.id_detail.setitem(al_row, "salepriceforitem", ld_saleprice)
		this.id_detail.setitem(al_row, "qty", this.id_detail.object.qty[al_row] / ll_packunits)
		ld_effectivesaleprice = ld_saleprice
		if ls_lessitemflatdisc = "Y" then
			ld_effectivesaleprice = ld_effectivesaleprice - ld_flatdisc
		end if
		if ls_lessitemdiscperc = "Y" then
			ld_effectivesaleprice = round(ld_effectivesaleprice * (1.0 - ld_salediscperc * 0.01), 2)
		end if
		this.id_detail.setitem(al_row, "saleprice", ld_effectivesaleprice)
	end if
	this.id_detail.setitem(al_row, "packingdesc", ls_packingdesc)
	return retflag

// w_barcodelabels.wf_populatedetaildwfrompo(long al_pocode, long al_manfcode) returns integer
	datastore lds_podetail
	datawindowchild ldc_itemdddw
	long ll_detailrows
	long ll_count
	long ll_duplrows
	integer li_result
	integer li_rtncode
	boolean populateflag = true
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_retrievecount
	long ll_lockedcount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_stock
	string ls_fullcode
	this.id_detail.reset()
	if f_validatedw(this.id_detail) < 0 then
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 and not isnull(this.id_detail.object.icode[1]) then
		li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
		if li_result = 1 then
			this.id_detail.reset()
		else
			populateflag = false
		end if
	end if
	if populateflag = true then
		lds_podetail = create datastore
		lds_podetail.dataobject = "d_purchaseorderdetail"
		lds_podetail.settransobject(this.it_transobject)
		li_rtncode = lds_podetail.getchild("icode", ldc_itemdddw)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			return 0
		end if
		ldc_itemdddw.settransobject(this.it_transobject)
		ldc_itemdddw.insertrow(0)
		ll_rtcode = lds_podetail.retrieve(al_pocode)
		ll_rowcount = lds_podetail.rowcount()
		for ll_count = 1 to ll_rowcount
			ll_icode = lds_podetail.object.icode[ll_count]
			if wf_iteminfo(ll_icode, ll_gcode, ld_purprice, ld_discperc, ld_avgprice, ll_packunits) = true then
				if wf_itemstockinfo(ll_icode, ll_gcode, ld_stock) = true then
					if wf_genfullcode(ll_icode, ls_fullcode) > 0 then
						this.id_detail.insertrow(0)
						this.id_detail.object.icode[ll_count + ll_detailrows] = ll_icode
						this.id_detail.object.gcode[ll_count + ll_detailrows] = gl_defaultgcode
						this.id_detail.object.fullcode[ll_count + ll_detailrows] = ls_fullcode
						this.id_detail.setitem(ll_count + ll_detailrows, this.is_columnitemname, this.id_itemslist.getitemstring(this.id_itemslist.find("icode" + "= integer('" + string(ll_icode) + "')", 1, 99999), this.is_columnitemname))
						this.id_detail.object.batch[ll_count + ll_detailrows] = "."
						this.id_detail.object.packqty[ll_count + ll_detailrows] = lds_podetail.object.qty[ll_count]
						this.id_detail.object.expiry[ll_count + ll_detailrows] = datetime(date("12/12/2010"))
						if f_stringpreferences("salepriceinpackpur") = "Y" then
							wf_getitemsaleprice(ll_icode, ld_saleprice)
							this.id_detail.object.purprice[ll_count + ll_detailrows] = ld_saleprice
						else
							this.id_detail.object.purprice[ll_count + ll_detailrows] = lds_podetail.object.rate[ll_count]
						end if
						this.id_detail.object.discperc[ll_count + ll_detailrows] = ld_discperc
						this.id_detail.object.avgprice[ll_count + ll_detailrows] = ld_avgprice
						this.id_detail.object.packunits[ll_count + ll_detailrows] = ll_packunits
						this.id_detail.setitemstatus(ll_count + ll_detailrows, "purprice", primary!, notmodified!)
						this.id_footer.object.stock[1] = ld_stock
						ll_retrievecount = ll_retrievecount + 1
					else
						messagebox("Database Error", "Can not generate item FullCode")
					end if
				else
					ll_lockedcount = ll_lockedcount + 1
				end if
			else
				ll_lockedcount = ll_lockedcount + 1
			end if
			ll_duplrows = ll_duplrows + 1
		next
		destroy lds_podetail
	end if
	if ll_retrievecount = ll_rowcount then
		messagebox("Result", "Purchase Order retrieval is Successfull~n~r" + string(ll_rowcount) + " Items are retrieved. ")
	else
		messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " records are retrieved successfully~n~r" + string(ll_duplrows) + " records are duplicate so are not retrieved~n~r" + string(ll_lockedcount) + " records are in error")
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_barcodelabels.wf_populatepurinvoices() returns integer
	s_arguements ls_args
	long ll_counter
	long ll_startinv
	long ll_endinv
	long ll_row
	long ll_suppcode
	integer li_purcatcode
	integer li_retcode
	datastore lds_labeldetail
	ll_counter = 1
	if this.tab_retrieve.selectedtab = 2 then
		return 1
	end if
	if gs_company = "HCP" then
		return 1
	end if
	open(w_arg_spurinv_lpurinv)
	ls_args = message.powerobjectparm
	ll_endinv = ls_args.l_code2
	if ls_args.i_status = 1 then
		lds_labeldetail = create datastore
		lds_labeldetail.dataobject = "d_labelpurchasedetail"
		lds_labeldetail.settransobject(this.it_transobject)
		this.id_detail.reset()
		for ll_startinv = ls_args.l_code1 to ll_endinv
			li_retcode = this.id_master.retrieve(ll_startinv)
			ll_suppcode = this.id_master.object.suppcode[this.id_master.getrow()]
			li_retcode = lds_labeldetail.retrieve(ll_startinv)
			if li_retcode > 0 then
				for ll_counter = 1 to lds_labeldetail.rowcount()
					ll_row = this.id_detail.insertrow(0)
					this.id_detail.setitem(ll_row, "code", lds_labeldetail.object.code[ll_counter])
					this.id_detail.setitem(ll_row, "fullcode", lds_labeldetail.object.fullcode[ll_counter])
					this.id_detail.setitem(ll_row, "itemname", lds_labeldetail.object.itemname[ll_counter])
					this.id_detail.setitem(ll_row, "saleprice", lds_labeldetail.object.saleprice[ll_counter])
					this.id_detail.setitem(ll_row, "batch", lds_labeldetail.object.batch[ll_counter])
					this.id_detail.setitem(ll_row, "expiry", lds_labeldetail.object.expiry[ll_counter])
					this.id_detail.setitem(ll_row, "qty", lds_labeldetail.object.qty[ll_counter])
					this.id_detail.setitem(ll_row, "suppcode", lds_labeldetail.object.suppcode[ll_counter])
				next
			end if
		next
		if this.id_detail.rowcount() > 0 then
			this.im_menu.m_file.m_print.enabled = true
		end if
	end if
	return 1

// w_barcodelabels.wf_retrievelist() returns long
	string[] ls_posted
	long ll_rtcode
	ls_posted[1] = "N"
	if this.ib_showinvoicelist then
		ll_rtcode = this.id_list.retrieve(ls_posted)
	else
		ll_rtcode = -1
	end if
	return ll_rtcode

// w_barcodelabels.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_barcodelabels.wf_populatefiltereditems() returns 0
	long ll_rowcount
	long ll_counter
	long ll_rtcode
	long ll_row
	datastore lds_itemselected
	s_arguements lstr_selecteditems
	long ll_icode
	long ll_gcode
	double ld_godownstock
	if this.tab_retrieve.selectedtab = 2 then
		return
	end if
	if gs_company = "HCP" then
		return
	end if
	openwithparm(w_arg_item_populate3, 3)
	lstr_selecteditems = message.powerobjectparm
	lds_itemselected = create datastore
	if lstr_selecteditems.s_name2 = "OR" then
		lds_itemselected.dataobject = "d_populateditems_active"
	else
		lds_itemselected.dataobject = "d_populateditems_active_and"
	end if
	lds_itemselected.settransobject(this.it_transobject)
	ll_rtcode = lds_itemselected.retrieve(lstr_selecteditems.ia_integerlist, lstr_selecteditems.ia_integerlist1, lstr_selecteditems.ia_integerlist2, lstr_selecteditems.la_longlist, lstr_selecteditems.l_code1, lstr_selecteditems.s_name1)
	ll_gcode = lstr_selecteditems.l_code1
	ll_rowcount = lds_itemselected.rowcount()
	if lstr_selecteditems.i_status = 1 then
		setpointer(hourglass!)
		setredraw(false)
		this.id_detail.reset()
		for ll_counter = 1 to ll_rowcount
			ll_icode = lds_itemselected.object.icode[ll_counter]
			this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
			if ld_godownstock > 0.0 then
				ll_row = this.id_detail.insertrow(0)
				this.id_detail.setitem(ll_row, "code", lds_itemselected.object.icode[ll_counter])
				this.id_detail.setitem(ll_row, "fullcode", lds_itemselected.object.aliasname[ll_counter])
				this.id_detail.setitem(ll_row, "itemname", lds_itemselected.object.name[ll_counter])
				this.id_detail.setitem(ll_row, "saleprice", lds_itemselected.object.saleprice[ll_counter] / lds_itemselected.object.packunits[ll_counter])
				this.id_detail.setitem(ll_row, "qty", ld_godownstock)
				this.id_detail.setitem(ll_row, "suppcode", 0)
			end if
		next
		setredraw(true)
		setpointer(arrow!)
	end if
	if this.id_detail.rowcount() > 0 then
		this.im_menu.m_file.m_print.enabled = true
		return
	end if
	this.im_menu.m_file.m_print.enabled = false

// w_barcodelabels.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_listdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_list.dataobject = as_listdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)

// w_barcodelabels.wf_itemstockinfo(long al_icode, long al_gcode, double ad_stock) returns boolean
	boolean retflag = true
	double ld_stock
	double ld_totalstock
	ad_stock = 100
	return retflag

// w_barcodelabels.wf_setiteminfo(long al_icode, long al_row, long ad_gcode, double ad_saleprice, double ad_discperc, double ad_stock) returns 0
	this.id_detail.setitem(al_row, "gcode", ad_gcode)
	this.id_detail.setitem(al_row, "purprice", ad_saleprice)
	this.id_detail.setitem(al_row, "discperc", ad_discperc)
	this.id_footer.object.stock[this.id_footer.getrow()] = ad_stock

// w_barcodelabels.wf_updateitemstock(long al_icode, long al_gcode, double ad_newstock) returns boolean
	boolean retflag = true
	SQL update godowndetail SET godowndetail.currqty =:ad_newstock WHERE godowndetail.gcode =:al_gcode AND godowndetail.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_barcodelabels.wf_populatereceipt() returns long
	s_arguements ls_args
	long ll_counter
	long ll_invcode
	long ll_row
	long ll_suppcode
	integer li_retcode
	datastore lds_receiptdetail
	ll_counter = 1
	if this.tab_retrieve.selectedtab = 2 then
		return 1
	end if
	if gs_company = "HCP" then
		return 1
	end if
	open(w_arg_receipt)
	ls_args = message.powerobjectparm
	ll_invcode = ls_args.l_code1
	if ls_args.i_status = 1 and ll_invcode > 0 and not isnull(ll_invcode) then
		lds_receiptdetail = create datastore
		lds_receiptdetail.dataobject = "d_receiptdetail"
		lds_receiptdetail.settransobject(this.it_transobject)
		this.id_detail.reset()
		if ll_invcode <> 0 and not isnull(ll_invcode) then
			li_retcode = lds_receiptdetail.retrieve(ll_invcode)
			if li_retcode > 0 then
				for ll_counter = 1 to lds_receiptdetail.rowcount()
					ll_row = this.id_detail.insertrow(0)
					this.id_detail.setitem(ll_row, "code", lds_receiptdetail.object.code[ll_counter])
					this.id_detail.setitem(ll_row, "fullcode", lds_receiptdetail.object.fullcode[ll_counter])
					this.id_detail.setitem(ll_row, "itemname", lds_receiptdetail.object.itemname[ll_counter])
					this.id_detail.setitem(ll_row, "saleprice", lds_receiptdetail.object.saleprice[ll_counter])
					this.id_detail.setitem(ll_row, "batch", lds_receiptdetail.object.batch[ll_counter])
					this.id_detail.setitem(ll_row, "expiry", lds_receiptdetail.object.expiry[ll_counter])
					this.id_detail.setitem(ll_row, "qty", lds_receiptdetail.object.qty[ll_counter])
					this.id_detail.setitem(ll_row, "suppcode", "")
				next
			end if
		end if
		if this.id_detail.rowcount() > 0 then
			this.im_menu.m_file.m_print.enabled = true
		end if
	end if
	return 1

// w_barcodelabels.wf_printprice(boolean ab_flag) returns long
	this.ib_printprice = ab_flag
	return 0

// w_barcodelabels.wf_set_quantity() returns long
	long ll_rows
	long ll_counter
	double ld_qty
	double[] ld_qtyarr
	ll_rows = this.id_detail.rowcount()
	if ll_rows > 0 then
		openwithparm(w_setquantity, ld_qty)
		ld_qty = message.doubleparm
		if ld_qty > 0.0 then
			for ll_counter = 1 to ll_rows
				ld_qtyarr[ll_counter] = ld_qty
			next
			this.id_detail.object.qty[1, ll_rows] = ld_qtyarr
		end if
	end if
	return 0

// w_barcodelabels.wf_populate_transfer() returns long
	long ll_rowcount
	long ll_counter
	long ll_rtcode
	long ll_row
	string ls_errortext
	datastore lds_transdetail
	s_arguements lstr_arg
	long ll_icode
	long ll_gcode
	double ld_godownstock
	if this.tab_retrieve.selectedtab = 2 then
		return 0
	end if
	open(w_arg_transfer)
	lstr_arg = message.powerobjectparm
	lds_transdetail = create datastore
	lds_transdetail.dataobject = "d_transfer_detail"
	lds_transdetail.settransobject(this.it_transobject)
	ll_rtcode = lds_transdetail.retrieve(lstr_arg.l_code1)
	ll_gcode = lstr_arg.l_code1
	ll_rowcount = lds_transdetail.rowcount()
	if lstr_arg.i_status = 1 then
		setpointer(hourglass!)
		setredraw(false)
		this.id_detail.reset()
		this.id_master.object.code[1] = lstr_arg.l_code1
		for ll_counter = 1 to ll_rowcount
			ll_icode = lds_transdetail.object.icode[ll_counter]
			ll_row = this.id_detail.insertrow(0)
			wf_inititeminfo(ll_icode, ll_row, ls_errortext)
			this.id_detail.setitem(ll_row, "code", lds_transdetail.object.code[ll_counter])
			this.id_detail.setitem(ll_row, "fullcode", lds_transdetail.object.fullcode[ll_counter])
			this.id_detail.setitem(ll_row, "itemname", lds_transdetail.object.itemname[ll_counter])
			this.id_detail.setitem(ll_row, "saleprice", lds_transdetail.object.saleprice[ll_counter] / lds_transdetail.object.packunits[ll_counter])
			this.id_detail.setitem(ll_row, "qty", lds_transdetail.object.qty[ll_counter])
		next
		setredraw(true)
		setpointer(arrow!)
	end if
	if this.id_detail.rowcount() > 0 then
		this.im_menu.m_file.m_print.enabled = true
	else
		this.im_menu.m_file.m_print.enabled = false
	end if
	return 0

// w_barcodelabels.wf_set_packing_effect(integer ai_effect) returns long
	double ld_purprice
	double ld_saleprice
	long ll_counter
	long ll_packunits
	long ll_icode
	for ll_counter = 1 to this.id_detail.rowcount()
		ll_icode = this.id_detail.object.icode[ll_counter]
		if ll_icode > 0 then
			SQL SELECT item.purprice , item.packunits , item.saleprice INTO :ld_purprice, :ll_packunits, :ld_saleprice FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
			if ll_packunits < 1 or isnull(ll_packunits) then
				ll_packunits = 1
			end if
			if this.id_detail.object.code[ll_counter] > 0 then
				if f_stringpreferences("printsalepricefrombasicdata") = "Y" then
					if ai_effect = 1 then
						this.id_detail.setitem(ll_counter, "purprice", ld_purprice / ll_packunits)
						this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice / ll_packunits)
						this.id_detail.setitem(ll_counter, "salepriceforitem", ld_saleprice / ll_packunits)
						this.id_detail.setitem(ll_counter, "qty", this.id_detail.object.qty[ll_counter] * ll_packunits)
					else
						this.id_detail.setitem(ll_counter, "purprice", ld_purprice)
						this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice)
						this.id_detail.setitem(ll_counter, "salepriceforitem", ld_saleprice)
						this.id_detail.setitem(ll_counter, "qty", this.id_detail.object.qty[ll_counter] / ll_packunits)
					end if
				end if
			elseif ai_effect = 1 then
				this.id_detail.setitem(ll_counter, "purprice", ld_purprice / ll_packunits)
				this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice / ll_packunits)
				this.id_detail.setitem(ll_counter, "salepriceforitem", ld_saleprice / ll_packunits)
				this.id_detail.setitem(ll_counter, "qty", this.id_detail.object.qty[ll_counter] * ll_packunits)
			else
				this.id_detail.setitem(ll_counter, "purprice", ld_purprice)
				this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice)
				this.id_detail.setitem(ll_counter, "salepriceforitem", ld_saleprice)
				this.id_detail.setitem(ll_counter, "qty", this.id_detail.object.qty[ll_counter] / ll_packunits)
			end if
		end if
	next
	return 0

// w_barcodelabels.wf_scaledown_qty_with_prefferedsaleqty() returns long
	long ll_rowcount
	long ll_counter
	ll_rowcount = this.id_detail.rowcount()
	for ll_counter = 1 to ll_rowcount
		if this.id_detail.object.prefferedsaleqty[ll_counter] > 0 then
			this.id_detail.object.qty[ll_counter] = round(this.id_detail.object.qty[ll_counter] / this.id_detail.object.prefferedsaleqty[ll_counter], 0)
		end if
	next
	return 0

