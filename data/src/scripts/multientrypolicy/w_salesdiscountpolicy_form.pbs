// window w_salesdiscountpolicy_form (multientrypolicy)  ancestor: w_multi_entry

// w_salesdiscountpolicy_form.wf_validateitem() returns integer
	double ld_salelimit
	integer li_errcode
	integer li_null
	setnull(li_null)
	ld_salelimit = this.id_detail.getitemnumber(this.il_currrow, "salelimit")
	if vf_dwdupcode1(this.id_detail, "salelimit", string(ld_salelimit), this.il_currrow) = true then
		messagebox("Duplication Error", "Current row is duplicate for Sale Limit")
		li_errcode = -1
	else
		li_errcode = 0
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		this.id_detail.setcolumn("salelimit")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.setitem(this.il_currrow, "salelimit", li_null)
	end if
	return li_errcode

// w_salesdiscountpolicy_form.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_listdw) returns 0
	this.id_detail.dataobject = as_detaildw
	this.id_detail.settransobject(this.it_transobject)

// w_salesdiscountpolicy_form.create() returns 0 [event]
	call super::create

// w_salesdiscountpolicy_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_salesdiscountpolicy_form.ue_save() returns 0 [event]
	long ll_mastercurrrow
	long ll_invid
	long ll_detailrows
	long ll_counter
	integer ll_salesmancode
	boolean lb_commitflag = true
	if this.id_detail.rowcount() = 0 then
		if this.id_detail.update() > 0 then
			SQL commit USING this.it_transobject;
			messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
			this.ib_commitok = true
			this.id_master.resetupdate()
			this.im_menu.m_file.m_new.enabled = true
			this.editflag = false
			if gd_recenttransdate < this.id_systemdate then
				gd_recenttransdate = this.id_systemdate
			end if
			return
		else
			SQL rollback USING this.it_transobject;
			setpointer(arrow!)
			return
		end if
		return
	end if
	if wf_validateitem() = -1 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	setpointer(hourglass!)
	ll_mastercurrrow = this.id_master.getrow()
	if this.id_detail.update() > 0 then
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		this.ib_commitok = true
		this.id_master.resetupdate()
		this.im_menu.m_file.m_new.enabled = true
		this.editflag = false
		if gd_recenttransdate < this.id_systemdate then
			gd_recenttransdate = this.id_systemdate
		end if
	else
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return
	end if
	setpointer(arrow!)

// w_salesdiscountpolicy_form.ue_newform() returns 0 [event]
	call super::ue_newform
	this.id_detail.retrieve()
	if this.id_detail.rowcount() = 0 then
		this.id_detail.insertrow(0)
	end if
	this.id_detail.setrow(this.id_detail.rowcount())
	this.id_detail.scrolltorow(this.id_detail.rowcount())
	this.id_detail.setfocus()
	this.id_detail.setcolumn(1)

// w_salesdiscountpolicy_form.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.setcolumn(1)
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.ib_validatefullcode = true

// w_salesdiscountpolicy_form.ue_detail() returns 0 [event]
	call super::ue_detail
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_delete.enabled = true
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true

// w_salesdiscountpolicy_form.ue_deleteitem() returns 0 [event]
	long ll_currow
	long ll_detailrows
	this.ib_itemvalidated = true
	this.id_detail.deleterow(0)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows < 1 then
	end if
	wf_grandtotal()

// w_salesdiscountpolicy_form.ue_list() returns 0 [event]

// w_salesdiscountpolicy_form.ue_new() returns 0 [event]
	this.i_editmode = 1
	this.ib_commitok = false
	this.tab_retrieve.selectedtab = 1
	this.id_detail.retrieve()
	if this.id_detail.rowcount() = 0 then
		this.id_detail.insertrow(0)
	end if
	this.id_detail.setrow(this.id_detail.rowcount())
	this.id_detail.scrolltorow(this.id_detail.rowcount())
	this.id_detail.setfocus()
	this.id_detail.setcolumn(1)

// tab_retrieve.key(keycode key, unsignedlong keyflags) returns long [event]
	return ::message.returnvalue

// tab_retrieve.selectionchanging(integer oldindex, integer newindex) returns long [event]
	return ::message.returnvalue

// tab_retrieve.ue_losefocus() returns 0 [event]

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	string ls_managername
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "salelimit"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_itemvalidated = false
		if real(data) < 0.0 then
			li_errcode = 1
		else
			li_errcode = 0
		end if
	case "discperc"
		if real(data) < 0.0 then
			li_errcode = 1
		end if
		parent.parent.parent.ib_itemvalidated = true
	case "itemflatdisc"
		if real(data) < 0.0 then
			li_errcode = 1
		end if
		parent.parent.parent.ib_itemvalidated = true
	case "expirydate"
		if isnull(data) then
			messagebox("Expiry Date Validation", "Policy Slab Expiry Date Error~n~rPlease enter Some valid Expiry Date")
			li_errcode = 1
		end if
	end choose
	return li_errcode

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "salelimit"
		if data = "" or isnull(data) or real(data) < 0.0 then
			messagebox("Sale Invoice Limit Validation", "Valid Value required for limit in current row")
		end if
	case "discperc"
		if data = "" or isnull(data) or real(data) < 0.0 then
			messagebox("Sale Discount Percentage Validation", "Valid value required for Sale Discount Percentage in current row")
		end if
	case "expirydate"
		if data = "" or isnull(data) then
			messagebox("Expiry Date Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	end choose
	return 1

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	return ::message.returnvalue
