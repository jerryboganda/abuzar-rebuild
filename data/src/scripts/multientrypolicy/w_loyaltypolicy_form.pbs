// window w_loyaltypolicy_form (multientrypolicy)  ancestor: w_multi_entry

// w_loyaltypolicy_form.wf_validateitem() returns integer
	double ld_salelimit
	integer li_errcode
	integer li_null
	setnull(li_null)
	ld_salelimit = this.id_detail.getitemnumber(this.il_currrow, "salelimit")
	if vf_dwdupcode1(this.id_detail, "salelimit", string(ld_salelimit), this.il_currrow) = true then
		messagebox("Duplication Error", "Current row is duplicate for Sale Limit")
		li_errcode = -1
	else
		li_errcode = 0
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		this.id_detail.setcolumn("salelimit")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.setitem(this.il_currrow, "salelimit", li_null)
	end if
	return li_errcode

// w_loyaltypolicy_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM LoyaltyPolicy WHERE LoyaltyPolicy.name =:as_name USING this.it_transobject;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_loyaltypolicy_form.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_listdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_list.dataobject = as_listdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)

// w_loyaltypolicy_form.wf_generatepolicyrows() returns long
	long ll_points
	long ll_points2
	long ll_insrow
	long ll_pointsstep
	long ll_row
	double ld_salelimit
	double ld_salelimit2
	double ld_redemptionvalue
	double ld_redemptionvalue2
	double ld_endsalelimit
	double ld_redemptionvaluestep
	double ld_limitstep
	if this.id_detail.rowcount() = 2 then
		open(w_arg_amount)
		ld_endsalelimit = message.doubleparm
		ld_salelimit = this.id_detail.object.salelimit[1]
		ll_points = this.id_detail.object.loyaltypoints[1]
		ld_redemptionvalue = this.id_detail.object.redemptionvalue[1]
		ld_salelimit2 = this.id_detail.object.salelimit[2]
		ll_points2 = this.id_detail.object.loyaltypoints[2]
		ld_redemptionvalue2 = this.id_detail.object.redemptionvalue[2]
		ld_limitstep = ld_salelimit2 - ld_salelimit
		ll_pointsstep = ll_points2 - ll_points
		ld_redemptionvaluestep = ld_redemptionvalue2 - ld_redemptionvalue
		do while ld_endsalelimit > ld_salelimit2 and this.id_detail.object.salelimit[this.id_detail.rowcount()] < ld_endsalelimit
			ll_insrow = this.id_detail.insertrow(0)
			if ll_insrow > 0 then
				this.id_detail.object.salelimit[ll_insrow] = this.id_detail.object.salelimit[ll_insrow - 1] + ld_limitstep
				this.id_detail.object.loyaltypoints[ll_insrow] = this.id_detail.object.loyaltypoints[ll_insrow - 1] + ll_pointsstep
				this.id_detail.object.redemptionvalue[ll_insrow] = this.id_detail.object.redemptionvalue[ll_insrow - 1] + ld_redemptionvaluestep
			end if
		loop
	end if
	return 0

// w_loyaltypolicy_form.create() returns 0 [event]
	call super::create

// w_loyaltypolicy_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_loyaltypolicy_form.ue_save() returns 0 [event]
	long ll_mastercurrrow
	long ll_invid
	long ll_detailrows
	long ll_counter
	integer ll_salesmancode
	boolean lb_commitflag
	if wf_validateitem() = -1 then
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	setpointer(hourglass!)
	ll_mastercurrrow = this.id_master.getrow()
	if isnull(this.id_master.object.name[ll_mastercurrrow]) then
		messagebox("Loyalty Policy Name Validation!", "Please Enter Some Valid Loyalty Policy Name")
		this.id_master.setcolumn("name")
		this.id_master.setfocus()
		return
	end if
	ll_salesmancode = gl_usercode
	if ll_salesmancode > 0 then
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			wf_tabnewid("LoyaltyPolicy", ll_invid)
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
		end if
		this.id_master.object.usercode[ll_mastercurrrow] = ll_salesmancode
		ll_detailrows = this.id_detail.rowcount()
		ll_counter = 1
		do while ll_counter <= ll_detailrows
			this.id_detail.setitem(ll_counter, "code", ll_invid)
			ll_counter = ll_counter + 1
		loop
		call super::ue_save
	end if
	setpointer(arrow!)

// w_loyaltypolicy_form.ue_newform() returns 0 [event]
	call super::ue_newform
	this.id_master.setfocus()

// w_loyaltypolicy_form.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.setcolumn(2)
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.ib_validatefullcode = true

// w_loyaltypolicy_form.ue_detail() returns 0 [event]
	call super::ue_detail
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_delete.enabled = true
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true

// w_loyaltypolicy_form.ue_deleteitem() returns 0 [event]
	long ll_currow
	long ll_detailrows
	this.ib_itemvalidated = true
	this.id_detail.deleterow(0)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows < 1 then
		this.im_menu.m_file.m_save.enabled = false
	end if
	wf_grandtotal()

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "name"
		if isnull(data) then
			messagebox("Loyalty Policy Name Validation", "Loyalty Policy Name Error~n~rPlease enter Some valid Loyalty Policy Name")
			ll_retcode = 1
		elseif parent.parent.parent.wf_duplicatename(data) then
			messagebox("Policy Name Validation", "Duplicate Policy Name Error~n~rPlease enter Some Other Policy Name")
			ll_retcode = 1
		end if
	end choose
	return ll_retcode

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	string ls_managername
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "salelimit"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_itemvalidated = false
		if real(data) < 0.0 then
			li_errcode = 1
		else
			li_errcode = 0
		end if
	case "loayltypoints"
		if real(data) < 0.0 then
			li_errcode = 1
		end if
		parent.parent.parent.ib_itemvalidated = true
	case "redemtionvalue"
		if real(data) < 0.0 then
			li_errcode = 1
		end if
		parent.parent.parent.ib_itemvalidated = true
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	return ::message.returnvalue

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf5! then
		parent.parent.parent.wf_generatepolicyrows()
	end if
	return ::message.returnvalue
