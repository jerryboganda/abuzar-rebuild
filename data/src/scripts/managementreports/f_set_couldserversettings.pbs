	gs_autoimportstockjob = gs_autoimportstockjob + ls_suffix
	gs_autoimportstockjobschedule = gs_autoimportstockjobschedule + ls_suffix
	gs_autosatisfyduejob = gs_autosatisfyduejob + ls_suffix
	gs_autosatisfyduejobschedule = gs_autosatisfyduejobschedule + ls_suffix
	gs_autopostvisitappointmentjob = gs_autopostvisitappointmentjob + ls_suffix
	gs_autopostvisitappointmentjobschedule = gs_autopostvisitappointmentjobschedule + ls_suffix
	gs_autodatamigration = gs_autodatamigration + ls_suffix
