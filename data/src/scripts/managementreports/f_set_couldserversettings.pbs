// function f_set_couldserversettings (managementreports)  ancestor: function_object

// f_set_couldserversettings.f_set_couldserversettings() returns long
	string ls_value
	string ls_suffix
	integer li_rtcode
	li_rtcode = f_get_cloud_setting(ls_value)
	if li_rtcode < 0 then
		return li_rtcode
	end if
	if ls_value = "N" or ls_value = "" or isnull(ls_value) then
		return 0
	end if
	ls_suffix = "_" + gs_regid
	gs_outlinkserver = gs_outlinkserver + ls_suffix
	gs_outlinkserverdb = " "
	gs_outlinkserverowner = " "
	gs_inlinkserver = gs_inlinkserver + ls_suffix
	gs_inlinkserverdb = " "
	gs_inlinkserverowner = " "
	gs_clientjob = gs_clientjob + ls_suffix
	gs_clientjobschedule = gs_clientjobschedule + ls_suffix
