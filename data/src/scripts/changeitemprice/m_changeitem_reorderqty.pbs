	this.m_setitemreorderqtyforall = create m_setitemreorderqtyforall
	this.m_setitemoptimumqtyforall = create m_setitemoptimumqtyforall
	this.item[upperbound(this.item) + 1] = this.m_setitemclassforall
	this.item[upperbound(this.item) + 1] = this.m_setitemminqtyforall
	this.item[upperbound(this.item) + 1] = this.m_setitemreorderqtyforall
