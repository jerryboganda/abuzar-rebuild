// window w_itemconversion_form (adjustment)  ancestor: w_multi_entry

// w_itemconversion_form.wf_validateitem() returns integer
	long ll_icode
	long ll_gcode
	long ll_count
	string ls_fullcode
	string ls_errtext
	string ls_titleerrtext
	string ls_null
	integer il_errcode
	integer li_errcode
	integer li_null
	boolean lb_dupitem
	ls_titleerrtext = "Item Validation"
	setnull(li_null)
	setnull(ls_null)
	ll_icode = this.id_detail.object.icode[this.il_currrow]
	ll_gcode = this.id_detail.object.gcode[this.il_currrow]
	if not isnull(ll_icode) then
		if vf_dwdupgodownitem(this.id_detail, "gcode", ll_gcode, "icode", ll_icode, this.il_currrow) = true then
			ls_errtext = "Duplicate item, please select some other item"
			lb_dupitem = true
			li_errcode = -1
			messagebox(ls_titleerrtext, ls_errtext)
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.icode[this.il_currrow] = li_null
			this.id_detail.object.fullcode[this.il_currrow] = ls_null
			this.id_detail.object.itemname[this.il_currrow] = ls_null
			post event ue_deleteitem_row(this.il_currrow)
			for ll_count = 1 to this.id_detail.rowcount()
				if this.id_detail.getitemnumber(ll_count, "icode") = ll_icode and this.id_detail.getitemnumber(ll_count, "gcode") = ll_gcode then
					this.id_detail.scrolltorow(ll_count)
					this.id_detail.setrow(ll_count)
					this.id_detail.setcolumn("Qty")
					this.il_currrow = ll_count
					return li_errcode
				end if
			next
			return li_errcode
		elseif wf_genfullcode(ll_icode, ls_fullcode) > 0 then
			this.id_detail.object.fullcode[this.il_currrow] = ls_fullcode
			if not wf_inititeminfo(ll_icode, this.il_currrow, ls_errtext) then
				li_errcode = -1
			end if
		else
			il_errcode = -1
		end if
	end if
	if il_errcode = -1 then
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
		this.ib_itemvalidated = false
		messagebox(ls_titleerrtext, ls_errtext)
	else
		this.ib_itemvalidated = true
	end if
	return il_errcode

// w_itemconversion_form.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_listdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_list.dataobject = as_listdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)

// w_itemconversion_form.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_itemconversion_form.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "d_detaildwtotal")
		ld_grandtotal = ld_detaildwtotal
		ld_grandtotal = round(ld_grandtotal, 0)
		this.id_footer.setitem(1, "total", ld_grandtotal)
		ld_detaildwtotal = this.id_footer.getitemnumber(1, "total")
	end if
	return ld_grandtotal

// w_itemconversion_form.wf_initmodify(integer ai_protect) returns 0
	long ll_code
	long ll_gcode
	long ll_icode
	long ll_counter
	long ll_packunits
	double ld_qty
	double ld_stock
	double ld_totalstock
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_code = this.id_detail.getitemnumber(1, "code")
		if wf_lockinvoice(ll_code) = 0 then
			wf_set_stockeffect(this.id_master.object.itemconversioneffectcode[1])
			for ll_counter = 1 to this.id_detail.rowcount()
				ll_gcode = this.id_detail.getitemnumber(ll_counter, "gcode")
				ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
				ld_qty = this.id_detail.getitemnumber(ll_counter, "qty")
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					ai_protect = 0
				end if
				this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_totalstock)
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				this.id_detail.object.stock[ll_counter] = ld_stock
				this.id_detail.object.totalstock[ll_counter] = ld_totalstock
				this.id_footer.object.stock[1] = ld_stock
				this.id_footer.object.totalstock[1] = ld_totalstock
				ai_protect = 0
			next
			if ai_protect = 0 then
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
		end if
		return
	end if
	ai_protect = 1

// w_itemconversion_form.wf_iteminfo(long al_icode, long al_gcode, double ad_purprice, double ad_discperc, double ad_avgprice, long al_packunits) returns boolean
	boolean retflag
	SQL SELECT 1 , item.salePrice , item.purdiscperc , item.avgprice , item.packunits INTO :al_gcode, :ad_purprice, :ad_discperc, :ad_avgprice, :al_packunits FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if isnull(ad_purprice) then
		ad_purprice = 0
	elseif isnull(ad_discperc) then
		ad_discperc = 0
	elseif isnull(ad_avgprice) then
		ad_avgprice = 0
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_itemconversion_form.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_counter step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_itemconversion_form.wf_selectprintreport() returns string
	string ls_report
	return ls_report

// w_itemconversion_form.wf_setgodownoption() returns 0
	this.ii_purchasegodownoption = this.id_detail.getitemnumber(1, "gcode")
	if this.il_strategy = 1 and this.il_godowncount = 1 then
		this.id_detail.object.gcode.protect = 1
		this.id_detail.object.gcode.background.color = this.backcolor
	end if

// w_itemconversion_form.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	return true

// w_itemconversion_form.wf_post() returns boolean
	integer li_postingmode
	long ll_sinvcode
	long ll_linvcode
	setnull(ll_sinvcode)
	setnull(ll_linvcode)
	return wf_post_itemconversion(li_postingmode, ll_sinvcode, ll_linvcode)

// w_itemconversion_form.wf_inititeminfo(long al_icode, long al_row, string as_errortext) returns boolean
	boolean retflag
	double ld_purprice
	double ld_discperc
	double ld_saleprice
	double ld_recentpurprice
	double ld_avgprice
	long ll_packunits
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_alternatecustomicode
	string ls_null
	double ld_godownstock
	double ld_allgodownstock
	setnull(ls_null)
	SQL SELECT item.customicode , item.name , item.purprice , item.packunits , item.purdiscperc , item.gcode , item.saleprice , item.recentpurprice , item.avgprice INTO :ls_fullcode, :ls_name, :ld_purprice, :ll_packunits, :ld_discperc, :li_gcode, :ld_saleprice, :ld_recentpurprice, :ld_avgprice FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	ls_alternatecustomicode = this.id_detail.object.alternatecustomicode[al_row]
	if isnull(ls_alternatecustomicode) then
		ls_alternatecustomicode = ""
	end if
	if lower(ls_fullcode) = lower(ls_alternatecustomicode) then
		ls_alternatecustomicode = ls_null
		this.id_detail.object.alternatecustomicode[al_row] = ls_null
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.ii_defaultgcode = this.id_detail.getitemnumber(al_row, "gcode")
	elseif this.il_strategy = 1 then
		this.ii_defaultgcode = this.id_detail.getitemnumber(al_row, "gcode")
	end if
	this.it_transobject.getitemstocktotal(this.ii_defaultgcode, al_icode, ld_godownstock)
	this.it_transobject.getitemstockinallowedgodown(al_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.id_detail.setitem(al_row, "gcode", this.ii_defaultgcode)
	this.id_detail.setitem(al_row, "icode", al_icode)
	this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
	this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
	this.id_detail.setitem(al_row, "packunits", ll_packunits)
	this.id_detail.setitem(al_row, "stock", ld_godownstock)
	this.id_detail.setitem(al_row, "totalstock", ld_allgodownstock)
	this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
	this.id_detail.setitem(al_row, "unitprice", round(ld_saleprice / ll_packunits, 2))
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_allgodownstock)
	return retflag

// w_itemconversion_form.wf_populatefiltereditems() returns integer
	datastore lds_itemselected
	long ll_detailrows
	long ll_count
	long ll_duplrows
	integer li_result
	integer li_rtncode
	boolean populateflag
	s_arguements lstr_selecteditems
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_retrievecount
	long ll_lockedcount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packsalestax
	double ld_gstperc
	double ld_godownstock
	double ld_allgodownstock
	string ls_fullcode
	if this.ib_modify = true then
		messagebox("Result", "Can not populate items after Posting!")
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		if not isnull(this.id_detail.object.icode[1]) then
			li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
			if li_result = 1 then
				for ll_count = 1 to ll_detailrows
					this.id_detail.deleterow(0)
				next
			else
				populateflag = false
			end if
		else
			this.id_detail.reset()
		end if
	end if
	if populateflag = true then
		openwithparm(w_arg_item_populate3, this.ii_module)
		lstr_selecteditems = message.powerobjectparm
		this.id_detail.reset()
		lds_itemselected = create datastore
		if lstr_selecteditems.s_name2 = "OR" then
			lds_itemselected.dataobject = "d_populateditems_active"
		else
			lds_itemselected.dataobject = "d_populateditems_active_and"
		end if
		lds_itemselected.settransobject(this.it_transobject)
		this.id_detail.reset()
		ll_rtcode = lds_itemselected.retrieve(lstr_selecteditems.ia_integerlist, lstr_selecteditems.ia_integerlist1, lstr_selecteditems.ia_integerlist2, lstr_selecteditems.la_longlist, lstr_selecteditems.l_code1, lstr_selecteditems.s_name1)
		ll_rowcount = lds_itemselected.rowcount()
		for ll_count = 1 to ll_rowcount
			ll_icode = lds_itemselected.object.icode[ll_count]
			if wf_genfullcode(ll_icode, ls_fullcode) > 0 then
				this.id_detail.insertrow(0)
				this.id_detail.object.icode[ll_count] = ll_icode
				ll_gcode = lds_itemselected.object.gcode[ll_count]
				if isnull(ll_gcode) then
					this.id_detail.object.gcode[ll_count] = this.ii_purchasegodownoption
					ll_gcode = this.ii_purchasegodownoption
				else
					this.id_detail.object.gcode[ll_count] = ll_gcode
				end if
				this.id_detail.object.fullcode[ll_count] = ls_fullcode
				this.id_detail.object.itemname[ll_count] = lds_itemselected.object.name[ll_count]
				this.id_detail.object.saleprice[ll_count] = lds_itemselected.object.saleprice[ll_count]
				this.id_detail.object.qty[ll_count] = lds_itemselected.object.qty[ll_count]
				this.id_detail.object.unitprice[ll_count] = round(lds_itemselected.object.rate[ll_count] / lds_itemselected.object.packunits[ll_count], 2)
				this.id_detail.object.packunits[ll_count] = lds_itemselected.object.packunits[ll_count]
				this.id_detail.setitemstatus(ll_count, "unitprice", primary!, notmodified!)
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
				this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
				if this.it_transobject.sqlcode = -1 then
					messagebox("Database Error", "Database Error: Item information can not be retrieved")
				else
					this.id_detail.object.stock[1] = ld_godownstock
					this.id_detail.object.totalstock[1] = ld_allgodownstock
					this.id_footer.object.stock[1] = ld_godownstock
					this.id_footer.object.totalstock[1] = ld_allgodownstock
				end if
				ll_retrievecount = ll_retrievecount + 1
			else
				messagebox("Database Error", "Can not generate item FullCode")
			end if
		next
		destroy lds_itemselected
		if ll_retrievecount = ll_rowcount then
			messagebox("Result", string(ll_rowcount) + " Items are populated. ")
		else
			messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " records are retrieved successfully~n~r" + string(ll_duplrows) + " records are duplicate so are not retrieved~n~r" + string(ll_lockedcount) + " records are in error")
		end if
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 and this.ib_modify = false then
		this.im_menu.m_file.m_save.enabled = true
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_itemconversion_form.wf_fetchserverdate(boolean ab_checked) returns long
	if ab_checked then
		this.ib_fetchserverdate = true
	else
		this.ib_fetchserverdate = false
	end if
	return 0

// w_itemconversion_form.wf_validate_sourceitem(long al_icode) returns long
	boolean retflag
	double ld_purprice
	double ld_discperc
	double ld_saleprice
	double ld_recentpurprice
	double ld_avgprice
	long ll_packunits
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_errortext
	double ld_godownstock
	double ld_allgodownstock
	li_gcode = this.id_master.getitemnumber(1, "gcode")
	SQL SELECT item.customicode , item.name , item.purprice , item.packunits , item.purdiscperc , item.gcode , item.saleprice , item.recentpurprice , item.avgprice INTO :ls_fullcode, :ls_name, :ld_purprice, :ll_packunits, :ld_discperc, :li_gcode, :ld_saleprice, :ld_recentpurprice, :ld_avgprice FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		ls_errortext = "Database Error: Item information can not be retrieved"
		messagebox("Item Validation", ls_errortext, stopsign!)
	end if
	if retflag then
		this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
		if this.it_transobject.sqlcode = -1 then
			retflag = false
			ls_errortext = "Database Error: Item godown stock can not be retrieved"
			messagebox("Item Validation", ls_errortext, stopsign!)
		end if
	end if
	if retflag then
		this.it_transobject.getitemstockinallowedgodown(al_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
		if this.it_transobject.sqlcode = -1 then
			retflag = false
			ls_errortext = "Database Error: Item Total Stock can not be retrieved"
			messagebox("Item Validation", ls_errortext, stopsign!)
		end if
	end if
	this.id_master.setitem(1, "packunits", ll_packunits)
	this.id_master.setitem(1, "godownstock", ld_godownstock)
	this.id_master.setitem(1, "totalstock", ld_allgodownstock)
	this.id_master.setitem(1, "saleprice", ld_saleprice)
	this.id_master.setitem(1, "unitprice", round(ld_saleprice / ll_packunits, 2))
	if retflag then
		this.id_master.setitem(1, "aliasname", ls_fullcode)
		return 0
	end if
	return 1

// w_itemconversion_form.wf_findfullcode(string as_fullcode, long al_icode, string as_itemname) returns integer
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		as_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_itemconversion_form.wf_set_stockeffect(long al_code) returns long
	if al_code = 1 then
		this.id_detail.object.qty_t.text = "Decrease Qty"
	else
		this.id_detail.object.qty_t.text = "Increase Qty"
	end if
	return 0

// w_itemconversion_form.wf_validategodown() returns long
	long ll_icode
	long ll_gcode
	long ll_counter
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	string ls_null
	integer li_errcode
	integer li_null
	integer li_option
	integer li_duperr
	boolean ib_due
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	this.ii_defaultgcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	for ll_counter = 1 to this.id_detail.rowcount()
		if this.il_currrow <> ll_counter and (ll_icode = this.id_detail.getitemnumber(ll_counter, "icode") and this.ii_defaultgcode = this.id_detail.getitemnumber(ll_counter, "gcode")) then
			li_duperr = -2
		end if
	next
	this.ib_godownvalidated = true
	if li_errcode = -1 and not ib_due then
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		this.id_detail.setfocus()
		this.id_detail.setcolumn("gcode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
	end if
	if li_duperr = -2 then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate Item, please select some other item"
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
		this.ib_itemslistopen = true
		this.id_itemslist.show()
		li_errcode = -1
	end if
	return li_errcode

// w_itemconversion_form.wf_validate_source_godown(long al_gcode) returns long
	long ll_icode
	double ld_godownstock
	double ld_allgodownstock
	ll_icode = this.id_master.object.icode[1]
	this.it_transobject.getitemstocktotal(al_gcode, ll_icode, ld_godownstock)
	this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
	this.id_master.object.godownstock[1] = ld_godownstock
	this.id_master.object.totalstock[1] = ld_allgodownstock
	return 0

// w_itemconversion_form.wf_allowmodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM ItemConversionDetail WHERE ItemConversionCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_itemconversion_form.wf_lockinvoice(long al_code) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From ItemConversionHeader WITH ( UPDLOCK HOLDLOCK ) Where ItemConversionCode =:al_code USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_itemconversion_form.wf_lockinvoices(long al_sinvcode, long al_linvcode) returns integer
	integer li_count
	SQL SELECT count ( *) INTO :li_count FROM ItemConversionHeader WITH ( UPDLOCK HOLDLOCK ) WHERE ItemConversionCode Between :al_sinvcode and :al_linvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_itemconversion_form.wf_post_itemconversion(integer ai_postingmode, long al_startinginvcode, long al_endinginvcode) returns boolean
	long ll_code1
	long ll_code2
	long ll_headerno
	long ll_headerinvno
	integer li_errcode
	integer li_rtncode
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_salesmancode
	long ll_errrowid
	long ll_rtcode
	integer li_detailcounter
	integer li_headerno
	boolean lb_commitflag
	long ll_rowcount
	long ll_counter
	long ll_invcode
	double ld_stock
	string ls_invnos_with_errors
	boolean lb_errflag
	datetime ldt_server_datetime
	string ls_date_errtext
	s_arguements lstr_arginfo
	datastore lds_headers
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	if lds_headers.retrieve(this.il_groupcode, this.ii_module) <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Adjustment")
		return false
	end if
	li_headerno = lds_headers.getitemnumber(1, "headercode")
	if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return false
	end if
	if ai_postingmode = 1 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
	else
		ll_salesmancode = gl_usercode
	end if
	setfocus()
	if ll_salesmancode > 0 then
		if ai_postingmode = 1 then
			open(w_arg_sinvcode_linvcode)
			lstr_arginfo = message.powerobjectparm
		else
			lstr_arginfo.l_code1 = al_startinginvcode
			lstr_arginfo.l_code2 = al_endinginvcode
			lstr_arginfo.i_status = 1
		end if
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			ll_code1 = lstr_arginfo.l_code1
			ll_code2 = lstr_arginfo.l_code2
			if ll_code1 <= ll_code2 then
				for ll_counter = ll_code1 to ll_code2
					if wf_allowmodification(ll_counter, this.il_groupcode, this.il_strategy) = 0 then
						li_errcode = wf_lockinvoice(ll_counter)
						ll_rtcode = this.it_transobject.postitemconversion(ll_counter, ll_salesmancode, li_headerno, ldt_server_datetime)
						if this.it_transobject.sqlcode = 0 and ll_rtcode = 0 then
							SQL commit USING this.it_transobject;
						else
							lb_errflag = true
							messagebox("Posting Validation", "Unable to post this Item Conversion  : " + string(ll_counter) + "~r~nReasons:~r~n" + this.it_transobject.sqlerrtext)
							SQL rollback USING this.it_transobject;
							ls_invnos_with_errors = ls_invnos_with_errors + string(ll_counter) + " , "
						end if
					end if
				next
				if lb_errflag = true then
					messagebox("Posting Confirmation", "Due to database problem some of the invoices remain unposted from given range.~r~n" + ls_invnos_with_errors)
				else
					messagebox("Posting Confirmation", "All invoices have been posted successfully.")
				end if
			else
				messagebox("Range Validation", "Starting Invoice No (" + string(ll_code1) + ") should be less than or equal to Ending Invoice No (" + string(ll_code2) + ").")
			end if
		end if
	end if
	setpointer(arrow!)
	return lb_commitflag

// w_itemconversion_form.create() returns 0
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_itemconversionmenu" then
		this.menuid = create m_itemconversionmenu
	end if
	this.dw_print = create dw_print
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print

// w_itemconversion_form.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_print

// w_itemconversion_form.ue_save() returns 0
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_icode
	long ll_gcode
	long ll_packingunits
	long ll_salesmancode
	long ll_adjcode
	long ll_count
	long ll_found
	string ls_batch
	string ls_errtext
	datetime ld_expiry
	double ld_avgprice
	double ld_prprice
	double ld_newavgprice
	double ld_stock
	double ld_newstock
	double ld_looseqty
	integer li_counter
	integer li_errorrow
	boolean lb_commitflag
	boolean lb_continue
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	datetime ldt_server_datetime
	string ls_date_errtext
	char lc_updateavgprice
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 1 and vf_dwdupgodownitem(this.id_detail, "gcode", this.id_detail.object.gcode[this.id_detail.getrow()], "icode", this.id_detail.object.icode[this.id_detail.getrow()], this.il_currrow) = true then
		messagebox("Item Validation", "Duplicate item, please select some other item")
		this.id_detail.setrow(this.id_detail.getrow())
		this.id_detail.scrolltorow(this.id_detail.getrow())
		this.id_detail.setcolumn("qty")
		return
	end if
	if ll_detailrows > 1 then
		for ll_count = 1 to ll_detailrows
			ll_found = 0
			if ll_count = ll_detailrows then
				exit
			end if
			ll_found = this.id_detail.find("gcode = long('" + string(this.id_detail.object.gcode[ll_count]) + "') and " + " icode = long('" + string(this.id_detail.object.icode[ll_count]) + "')", ll_count + 1, ll_detailrows)
			if ll_found > 0 then
				messagebox("Item Validation", "Duplicate items found at row " + string(ll_count) + " and " + string(ll_found) + ".~r~nPlease delete the row")
				this.id_detail.scrolltorow(ll_count)
				this.id_detail.setcolumn("qty")
				this.id_detail.setfocus()
				return
			end if
		next
	elseif ll_detailrows <= 0 then
		messagebox("On Save Validation", "There are no rows to save.~r~nKindly insert some item row.")
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if f_stringpreferences("AskUserPwdInAdjustment") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
	else
		ll_salesmancode = gl_usercode
	end if
	setfocus()
	if ll_salesmancode > 0 then
		setpointer(hourglass!)
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			wf_tabnewid("ItemConversionHeader", ll_invid)
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
			this.id_master.setitem(ll_mastercurrrow, "usercode", ll_salesmancode)
		end if
		li_counter = 1
		if not this.ib_modifydate then
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "Date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "PostDate", ldt_server_datetime)
		else
			ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
		end if
		if lb_continue then
			do while li_counter <= ll_detailrows
				this.id_detail.setitem(li_counter, "code", ll_invid)
				li_counter = li_counter + 1
			loop
			call super::ue_save
		end if
	else
		SQL rollback USING this.it_transobject;
		messagebox("Updation Error", ls_errtext + " ", stopsign!)
	end if
	if not lb_commitflag then
		SQL rollback USING this.it_transobject;
		messagebox("Updation Error", ls_errtext + " ", stopsign!)
		setfocus()
	end if
	setpointer(arrow!)

// w_itemconversion_form.ue_newform() returns 0
	integer rtncode
	integer li_price
	long ll_counter
	long ll_found
	datetime ldt_server_datetime
	string ls_date_errtext
	call super::ue_newform
	setredraw(false)
	this.ib_modify = false
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	wf_setgodownoption()
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	if not wf_validatedate() then
		close(this)
	end if
	li_price = 1
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 554 then
			li_price = 0
		end if
	next
	this.id_detail.object.unitprice.protect = li_price
	if this.ib_modifydate then
		if this.ib_fetchserverdate then
			wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
			this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
		else
			this.id_master.setitem(this.id_master.getrow(), "date", today())
		end if
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5146", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.unitprice.protect = 0
	else
		this.id_master.object.unitprice.protect = 1
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5145", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_detail.object.unitprice.protect = 0
	else
		this.id_detail.object.unitprice.protect = 1
	end if
	wf_set_stockeffect(this.id_master.object.itemconversioneffectcode[1])
	setredraw(true)

// w_itemconversion_form.ue_detail() returns 0
	long ll_code
	long ll_found
	integer li_rtncode
	integer li_protect
	call super::ue_detail
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_post.visible = false
	this.ib_modify = true
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	this.id_footer.retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	wf_initmodify(li_protect)
	if this.id_dwcontrol.borderstyle.posted[this.il_selectedrow] = "N" then
		if wf_allowmodification(ll_code, this.il_groupcode, this.il_strategy) <> 0 then
			this.id_detail.reset()
			messagebox("Conversion Modification Validation", "You Can not modify this Document,~r~nGodown settings do not permit this modification.")
			this.tab_retrieve.selecttab(2)
			return
		end if
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if li_protect = 0 then
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 5146", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			this.id_master.object.unitprice.protect = 0
		else
			this.id_master.object.unitprice.protect = 1
		end if
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 5145", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			this.id_detail.object.unitprice.protect = 0
		else
			this.id_detail.object.unitprice.protect = 1
		end if
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_purchasegodownoption
		this.id_detail.object.gcode.initial = trim(string(this.ii_purchasegodownoption))
	end if
	wf_setgodownoption()
	if li_protect = 0 then
		this.im_menu.m_file.m_save.enabled = true
	end if
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_post.visible = false
	wf_grandtotal()
	wf_set_stockeffect(this.id_master.object.itemconversioneffectcode[1])
	setredraw(true)

// w_itemconversion_form.ue_newitem() returns 0
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 1 and vf_dwdupgodownitem(this.id_detail, "gcode", gl_defaultgcode, "icode", this.id_detail.getitemnumber(this.id_detail.getrow(), "icode"), this.il_currrow) = true then
		messagebox("Item Validation", "Duplicate item, please select some other item")
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.settransobject(this.it_transobject)
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_itemconversion_form.ue_deleteitem() returns 0
	long ll_row
	ll_row = this.id_detail.getrow()
	if this.id_detail.rowcount() > 0 then
		call super::ue_deleteitem
		return
	end if
	this.im_menu.m_file.m_print.enabled = false

// w_itemconversion_form.close() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	destroy this.ids_itemstockinfo
	return ::message.returnvalue

// w_itemconversion_form.ue_new() returns 0
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_post.visible = false

// w_itemconversion_form.ue_list() returns 0
	call super::ue_list
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_post.enabled = true
	this.im_menu.m_file.m_post.visible = true

// w_itemconversion_form.ue_print() returns 0
	long ll_row
	long ll_invcode
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	wf_selectprintreport()
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_itemconversion_form.ue_postopen() returns 0
	integer li_rtncode
	long ll_code
	long ll_counter
	long ll_found
	datawindowchild ldc_headerno
	datastore lds_headers
	m_itemconversionmenu lm_menu
	call super::ue_postopen
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	setredraw(false)
	lm_menu = this.menuid
	this.im_menu.m_file.m_post.toolbaritemvisible = true
	this.im_menu.m_file.m_post.visible = false
	this.im_menu.m_file.m_post.enabled = false
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit to Make Adjustments")
		close(this)
		return
	end if
	li_rtncode = this.id_detail.getchild("gcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to Make Adjustment")
		close(this)
		return
	end if
	this.ii_purchasegodownoption = this.idc_godown.getitemnumber(1, "gcode")
	this.id_detail.object.gcode.initial = string(this.ii_purchasegodownoption)
	li_rtncode = this.id_master.getchild("gcode", this.idc_godown_header)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown_header.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown_header.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to Make Adjustment. (Header)")
		close(this)
		return
	end if
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = false
	this.id_itemslist.object.sstock.visible = false
	this.id_itemslist.object.t_pstock.visible = true
	this.id_itemslist.object.pstock.visible = true
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_detail.object.gcode.visible = false
		this.id_master.object.t_gcode.visible = true
		this.id_master.object.gcode.visible = true
		this.id_master.object.gcode.initial = string(this.ii_purchasegodownoption)
	end if
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Adjustment")
		close(this)
		return
	end if
	if f_stringpreferences("headeronadjustmentinv") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.t_headerno.visible = false
	end if
	this.id_master.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to lds_headers.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
		ldc_headerno.setitem(ll_counter, "name", "")
		ll_found = 0
		ll_found = gds_reoprtheaderinfo.find("headerno=" + string(lds_headers.getitemnumber(ll_counter, "headercode")), 1, gds_reoprtheaderinfo.rowcount())
		if ll_found > 0 then
			ldc_headerno.setitem(ll_counter, "headeralias", gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks"))
		end if
	next
	this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
	this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
	if f_stringpreferences("alternatecustomicodeinadj") = "N" then
		this.id_detail.object.alternatecustomicode.visible = false
	end if
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.pstock.visible = false
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	gd_itemsinfo.sharedata(this.id_itemslist)
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	f_setcolumnstyle(this.id_master, "Qty")
	f_setcolumnstyle(this.id_detail, "Qty")
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 699", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.date.protect = 0
		this.id_master.object.date.background.color = rgb(255, 255, 255)
		this.ib_modifydate = true
		lm_menu.m_file.m_setserverdate.visible = true
		lm_menu.m_file.m_setserverdate.enabled = true
	end if
	if not this.ib_modifydate then
		this.id_master.object.date.protect = 1
		this.id_master.settaborder("date", 0)
		lm_menu.m_file.m_setserverdate.visible = false
		lm_menu.m_file.m_setserverdate.enabled = false
	end if
	this.id_print = this.dw_print
	this.id_print.settransobject(this.it_transobject)
	setredraw(true)

// w_itemconversion_form.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	show()
	return ::message.returnvalue
