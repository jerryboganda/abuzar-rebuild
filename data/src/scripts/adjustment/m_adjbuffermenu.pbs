// menu m_adjbuffermenu (adjustment)  ancestor: m_multi_entry

// m_adjbuffermenu.create() returns 0
	m_adjbuffermenu = this
	call super::create
	this.text = "m_adjbuffermenu"

// m_adjbuffermenu.destroy() returns 0
	call super::destroy

// m_adjbuffermenu.clicked() returns 0
	call super::clicked
	if this.checked then
		this.checked = false
	else
		this.checked = true
	end if
	this.parentwindow.dynamic wf_fetchserverdate(this.checked)
