// window w_adjwindow (adjustment)  ancestor: w_multi_entry

// w_adjwindow.ue_accepttext() returns 0 [event]
	if this.id_detail.accepttext() = -1 then
		this.id_detail.setfocus()
	end if

// w_adjwindow.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)

// w_adjwindow.wf_deleteadjustmentinvoice(long al_adjcode) returns integer
	SQL Delete adjdetail Where adjdetail.AdjCode =:al_adjcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_adjwindow.wf_finditem(long al_icode) returns boolean
	long ll_foundrow
	boolean retflag = true
	ll_foundrow = this.idc_itemdddw.find("icode =long('" + string(al_icode) + "')", 1, this.idc_itemdddw.rowcount())
	if ll_foundrow < 0 then
		messagebox("Find", "Find Fail")
		retflag = false
	elseif ll_foundrow = 0 then
		retflag = false
	end if
	return retflag

// w_adjwindow.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_adjwindow.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	real lr_discperc
	real lr_itemstotal
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "d_detaildwtotal")
		ld_grandtotal = ld_detaildwtotal
		ld_grandtotal = round(ld_grandtotal, 0)
		this.id_footer.setitem(1, "total", ld_grandtotal)
		ld_detaildwtotal = this.id_footer.getitemnumber(1, "total")
	end if
	return ld_grandtotal

// w_adjwindow.wf_inititeminfo(long al_icode, long al_row, string as_errortext) returns boolean
	boolean retflag = true
	long ll_packunits
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_alternatecustomicode
	string ls_null
	double ld_purprice
	double ld_discperc
	double ld_saleprice
	double ld_avgprice
	double ld_recentpurprice
	double ld_price
	double ld_godownstock
	double ld_totalstock
	setnull(ls_null)
	li_gcode = gl_defaultgcode
	SQL SELECT item.customicode , item.name , ISNULL ( item.purprice , 0 ) , item.packunits , item.purdiscperc , ISNULL ( item.saleprice , 0 ) , ISNULL ( item.avgprice , 0 ) , ISNULL ( item.recentpurprice , 0 ) INTO :ls_fullcode, :ls_name, :ld_purprice, :ll_packunits, :ld_discperc, :ld_saleprice, :ld_avgprice, :ld_recentpurprice FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.it_transobject.getitemstockinallowedgodown(al_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_totalstock)
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	ls_alternatecustomicode = this.id_detail.object.alternatecustomicode[al_row]
	if isnull(ls_alternatecustomicode) then
		ls_alternatecustomicode = ""
	end if
	if lower(ls_fullcode) = lower(ls_alternatecustomicode) then
		ls_alternatecustomicode = ls_null
		this.id_detail.object.alternatecustomicode[al_row] = ls_null
	end if
	if ld_avgprice <= 0.0 or isnull(ld_avgprice) then
		ld_price = ld_purprice / ll_packunits
	else
		ld_price = ld_avgprice
	end if
	this.id_detail.setitem(al_row, "icode", al_icode)
	this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
	this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
	this.id_detail.setitem(al_row, "packunits", ll_packunits)
	if ll_packunits = 0 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	this.id_detail.setitem(al_row, "price", ld_price)
	this.id_detail.setitem(al_row, "stock", ld_godownstock)
	this.id_detail.setitem(al_row, "totalstock", ld_totalstock)
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_totalstock)
	this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
	this.id_detail.setitem(al_row, "purprice", ld_purprice)
	this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
	this.id_detail.setitem(al_row, "recentpurprice", ld_recentpurprice)
	return retflag

// w_adjwindow.wf_initmodify(integer ai_protect, string as_errtext) returns 0
	long ll_adjcode
	long ll_gcode
	long ll_icode
	long ll_counter = 1
	long ll_packunits
	long ll_dddwrowcount
	long ll_foundrow
	string ls_batch
	datetime ld_expiry
	double ld_purprice
	double ld_stock
	double ld_looseqty
	integer li_errcode
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_adjcode = this.id_detail.getitemnumber(1, "code")
		if wf_lockadjinvoice(ll_adjcode, ll_adjcode) = 0 then
			this.id_master.retrieve(ll_adjcode)
			this.id_detail.retrieve(ll_adjcode)
			for ll_counter = 1 to this.id_detail.rowcount()
				ll_gcode = this.id_detail.getitemnumber(ll_counter, "gcode")
				ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
				ls_batch = this.id_detail.getitemstring(ll_counter, "batch")
				ld_expiry = this.id_detail.getitemdatetime(ll_counter, "expiry")
				ld_looseqty = this.id_detail.getitemnumber(ll_counter, "looseqty")
				ll_packunits = this.id_detail.getitemnumber(ll_counter, "packunits")
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					ai_protect = 0
					if this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock) = 0 then
						ld_stock = ld_stock + ld_looseqty
						if ld_stock > 0.0 then
							this.id_detail.setitem(ll_counter, "stock", ld_stock)
							this.id_footer.object.stock[1] = ld_stock
						else
							as_errtext = "Adjustment is not possible, item Stock is Zero"
							li_errcode = -1
						end if
					else
						as_errtext = "Can not retrieve item stock information"
						li_errcode = -1
					end if
				else
					as_errtext = "Can not retrieve item stock information"
					li_errcode = -1
				end if
			next
			if ai_protect = 0 then
				this.ib_modify = true
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
		end if
		return
	end if
	ai_protect = 1

// w_adjwindow.wf_iteminfo(long al_icode, double ad_purprice, double ad_avgprice, double ad_saleprice, double ad_recentpurprice) returns boolean
	boolean retflag = true
	SQL SELECT item.purprice , item.avgprice , item.saleprice , item.recentpurprice INTO :ad_purprice, :ad_avgprice, :ad_saleprice, :ad_recentpurprice FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if isnull(ad_purprice) then
		ad_purprice = 0
	end if
	if isnull(ad_avgprice) then
		ad_avgprice = 0
	end if
	if isnull(ad_saleprice) then
		ad_saleprice = 0
	end if
	if isnull(ad_recentpurprice) then
		ad_recentpurprice = 0
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_adjwindow.wf_lockadjinvoice(long al_sinvcode, long al_linvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From adjheader WITH ( UPDLOCK HOLDLOCK ) Where adjheader.adjcode Between :al_sinvcode AND :al_linvcode AND ( adjheader.adjcatcode =2 ) AND adjheader.Posted ='N' USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_adjwindow.wf_populateadjinvds(long al_adjcode) returns integer
	long rtcode
	if this.ids_adjdetail.rowcount() > 0 then
		this.ids_adjdetail.reset()
	end if
	rtcode = this.ids_adjdetail.retrieve(al_adjcode)
	return rtcode

// w_adjwindow.wf_post() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_prinvcount
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			li_errcode = wf_lockadjinvoice(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
			if li_errcode = 0 then
				this.it_transobject.postadjledger(lstr_arginfo.l_code1, lstr_arginfo.l_code2, 2, ll_salesmancode)
			end if
			if this.it_transobject.sqlcode <> 0 then
				li_errcode = -1
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if li_errcode <> 0 then
		messagebox("Posting Fails", "Some database request fails, Please try again")
	else
		messagebox("Posting Successfull", "Total unposted rows were " + string(ll_prinvcount) + "~n~rAll rows have been posted successfully")
	end if
	return li_errcode

// w_adjwindow.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to 1 step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_adjwindow.wf_returnadjinvoice(long al_invcode, string as_errtext) returns boolean
	integer li_errcode
	long ll_adjcode
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_icode
	long ll_gcode
	long ll_packingunits
	long ll_salesmancode
	long ll_errrowid
	string ls_batch
	datetime ld_expiry
	double ld_looseqty
	double ld_purqty
	double ld_stock
	double ld_newstock
	double ld_avgprice
	double ld_newavgprice
	double ld_purprice
	double ld_debitamt
	double ld_creditamt
	double ld_currbalance
	integer li_detailcounter
	boolean lb_commitflag = true
	datastore lds_prdetail
	lds_prdetail = create datastore
	lds_prdetail.dataobject = "d_adjdetail1"
	lds_prdetail.settransobject(this.it_transobject)
	lds_prdetail.retrieve(al_invcode)
	ll_detailrows = lds_prdetail.rowcount()
	li_detailcounter = 1
	do while li_detailcounter <= ll_detailrows and lb_commitflag
		ll_icode = lds_prdetail.object.icode[li_detailcounter]
		ll_gcode = lds_prdetail.object.gcode[li_detailcounter]
		ls_batch = lds_prdetail.object.batch[li_detailcounter]
		ld_expiry = lds_prdetail.object.expiry[li_detailcounter]
		ld_looseqty = lds_prdetail.object.looseqty[li_detailcounter]
		ll_packingunits = lds_prdetail.object.packunits[li_detailcounter]
		ld_purprice = lds_prdetail.object.price[li_detailcounter]
		ld_purqty = ld_looseqty
		this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
			if this.it_transobject.sqlcode = 0 then
				lds_prdetail.object.avgprice[li_detailcounter] = ld_avgprice
				ld_newstock = ld_stock + ld_purqty
				if ld_newstock > 0.0 then
					this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
					if this.it_transobject.sqlcode = 0 then
						ld_newstock = ld_stock + ld_purqty
						this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
						if this.it_transobject.sqlcode <> 0 then
							lb_commitflag = false
						end if
					else
						lb_commitflag = false
					end if
				else
					lb_commitflag = false
				end if
			else
				lb_commitflag = false
			end if
		else
			lb_commitflag = false
		end if
		li_detailcounter = li_detailcounter + 1
	loop
	if not lb_commitflag then
		as_errtext = "    Some database problem occur"
	end if
	destroy lds_prdetail
	return lb_commitflag

// w_adjwindow.wf_validatefullcode(string as_fullcode, long al_currrow) returns integer
	return 0

// w_adjwindow.wf_validateitem() returns integer
	long ll_icode
	long ll_dddwrow
	long ll_gcode
	string ls_titleerrtext
	string ls_errtext
	string ls_null
	integer li_errcode = 1
	integer li_assgcode
	integer li_null
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	ll_gcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	if not wf_inititeminfo(ll_icode, this.il_currrow, ls_errtext) then
		ls_titleerrtext = "Item Validation"
		li_errcode = -1
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.setcolumn("icode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		messagebox(ls_titleerrtext, ls_errtext)
	end if
	return li_errcode

// w_adjwindow.wf_validaterow() returns integer
	long ll_gcode
	long ll_icode
	double ld_qty
	string ls_batch
	string ls_errortext
	date ld_expiry
	integer li_errcode = 1
	integer li_errorcode
	integer li_null
	string ls_null
	datetime ldt_null
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	ll_gcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	ld_qty = this.id_detail.getitemnumber(this.il_currrow, "looseqty")
	ls_batch = this.id_detail.getitemstring(this.il_currrow, "batch")
	ld_expiry = date(this.id_detail.getitemdatetime(this.il_currrow, "expiry"))
	if wf_checkitemstock(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_qty, ls_errortext, li_errorcode) = 0 then
		li_errcode = -1
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		setnull(ldt_null)
		this.id_detail.scrolltorow(this.il_currrow)
		if li_errorcode = 1 then
			this.id_detail.object.batch[this.il_currrow] = ls_null
			this.id_detail.object.expiry[this.il_currrow] = ldt_null
			this.id_detail.setcolumn(this.is_columnitemname)
		else
			this.id_detail.object.looseqty[this.il_currrow] = 1
			this.id_detail.setcolumn("looseqty")
		end if
		messagebox("Item Validation", ls_errortext)
	end if
	return li_errcode

// w_adjwindow.wf_releaselock(long al_icode) returns boolean
	boolean retflag = true
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM godowndetail WITH ( NOLOCK ) WHERE godowndetail.Gcode =:this.ii_purchasegodownoption AND godowndetail.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_adjwindow.wf_retrievelist() returns long
	string[] ls_posted
	ls_posted[1] = "N"
	return this.id_list.retrieve(ls_posted, this.il_groupcode, this.ii_module)

// w_adjwindow.wf_retrievelistall() returns long
	string[] ls_posted
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	return this.id_list.retrieve(ls_posted, this.il_groupcode, this.ii_module)

// w_adjwindow.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_adjwindow.wf_allowadjustmentmodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM AdjDetail WHERE AdjCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_adjwindow.wf_populatefiltereditems() returns integer
	datastore lds_itemselected
	long ll_detailrows
	long ll_count
	long ll_duplrows
	double ld_godownstock
	double ld_totalstock
	integer li_result
	integer li_rtncode
	boolean populateflag = true
	s_arguements lstr_selecteditems
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_retrievecount
	long ll_lockedcount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packsalestax
	double ld_gstperc
	double ld_recentpurprice
	double ld_stock
	string ls_fullcode
	if this.ib_modify = true and this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate items after posting!")
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		if not isnull(this.id_detail.object.icode[1]) then
			li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
			if li_result = 1 then
				for ll_count = 1 to ll_detailrows
					this.id_detail.deleterow(0)
				next
			else
				populateflag = false
			end if
		else
			this.id_detail.reset()
		end if
	end if
	if populateflag = true then
		openwithparm(w_arg_item_populate3, this.ii_module)
		lstr_selecteditems = message.powerobjectparm
		this.id_detail.reset()
		lds_itemselected = create datastore
		if lstr_selecteditems.s_name2 = "OR" then
			lds_itemselected.dataobject = "d_populateditems"
		else
			lds_itemselected.dataobject = "d_populateditems_and"
		end if
		lds_itemselected.settransobject(this.it_transobject)
		this.id_detail.reset()
		ll_rtcode = lds_itemselected.retrieve(lstr_selecteditems.ia_integerlist, lstr_selecteditems.ia_integerlist1, lstr_selecteditems.ia_integerlist2, lstr_selecteditems.la_longlist, lstr_selecteditems.l_code1, lstr_selecteditems.s_name1)
		ll_rowcount = lds_itemselected.rowcount()
		for ll_count = 1 to ll_rowcount
			ll_icode = lds_itemselected.object.icode[ll_count]
			if wf_genfullcode(ll_icode, ls_fullcode) > 0 then
				this.id_detail.insertrow(0)
				this.id_detail.object.icode[ll_count] = ll_icode
				ll_gcode = lds_itemselected.object.gcode[ll_count]
				if isnull(ll_gcode) then
					this.id_detail.object.gcode[ll_count] = this.ii_purchasegodownoption
					ll_gcode = this.ii_purchasegodownoption
				else
					this.id_detail.object.gcode[ll_count] = ll_gcode
				end if
				ll_packunits = lds_itemselected.object.avgprice[ll_count]
				this.id_detail.object.fullcode[ll_count] = ls_fullcode
				this.id_detail.object.itemname[ll_count] = lds_itemselected.object.name[ll_count]
				this.id_detail.object.batch[ll_count] = lds_itemselected.object.batch[ll_count]
				this.id_detail.object.saleprice[ll_count] = ld_saleprice
				this.id_detail.object.looseqty[ll_count] = lds_itemselected.object.qty[ll_count]
				this.id_detail.object.price[ll_count] = round(lds_itemselected.object.rate[ll_count] / lds_itemselected.object.packunits[ll_count], 2)
				this.id_detail.object.expiry[ll_count] = datetime(date(lds_itemselected.object.expiry[ll_count]))
				this.id_detail.object.purprice[ll_count] = lds_itemselected.object.avgprice[ll_count]
				this.id_detail.object.recentpurprice[ll_count] = lds_itemselected.object.recentpurprice[ll_count]
				this.id_detail.object.saleprice[ll_count] = lds_itemselected.object.saleprice[ll_count]
				this.id_detail.object.avgprice[ll_count] = lds_itemselected.object.avgprice[ll_count]
				this.id_detail.object.packunits[ll_count] = lds_itemselected.object.packunits[ll_count]
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
				if this.it_transobject.sqlcode = -1 then
					messagebox("Database Error", "Database Error: Item information can not be retrieved")
					return 0
				end if
				this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_totalstock)
				if this.it_transobject.sqlcode = -1 then
					messagebox("Database Error", "Database Error: Item information can not be retrieved")
					return 0
				end if
				this.id_detail.object.stock[1] = ld_godownstock
				this.id_detail.object.totalstock[1] = ld_totalstock
				this.id_footer.object.stock[1] = ld_godownstock
				this.id_footer.object.totalstock[1] = ld_totalstock
				this.id_detail.setitemstatus(ll_count, "purprice", primary!, notmodified!)
				ll_retrievecount = ll_retrievecount + 1
			else
				messagebox("Database Error", "Can not generate item FullCode")
			end if
		next
		destroy lds_itemselected
		if ll_retrievecount = ll_rowcount then
			messagebox("Result", string(ll_rowcount) + " Items are populated. ")
		else
			messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " records are retrieved successfully~n~r" + string(ll_duplrows) + " records are duplicate so are not retrieved~n~r" + string(ll_lockedcount) + " records are in error")
		end if
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 and this.ib_modify = false then
		this.im_menu.m_file.m_save.enabled = true
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_adjwindow.wf_checkitemstock(long al_gcode, long al_icode, string as_batch, date ad_expiry, double ad_qty, string as_errortext, integer ai_errorcode) returns integer
	datastore lds_itemstockinfo
	long ll_counter
	long ll_detailrowcount
	long ll_gcode
	double ld_qty
	integer li_errcode
	string ls_batch
	date ld_expiry
	lds_itemstockinfo = create datastore
	lds_itemstockinfo.dataobject = "d_itemstockinfo"
	lds_itemstockinfo.settransobject(this.it_transobject)
	lds_itemstockinfo.retrieve(al_gcode, al_icode)
	for ll_counter = 1 to lds_itemstockinfo.rowcount()
		ld_qty = lds_itemstockinfo.getitemnumber(ll_counter, "currqty")
		ls_batch = lds_itemstockinfo.getitemstring(ll_counter, "batch")
		ld_expiry = date(lds_itemstockinfo.getitemdatetime(ll_counter, "expiry"))
		if lower(trim(ls_batch)) = lower(trim(as_batch)) then
			if ld_expiry = ad_expiry then
				if ld_qty >= ad_qty then
					li_errcode = 1
					return li_errcode
				else
					as_errortext = "Quantity is greater than Stock, Stock is " + string(ld_qty)
					li_errcode = 0
					ai_errorcode = 2
					exit
				end if
			else
				as_errortext = "Stock is zero for this Batch and Expiry"
				ai_errorcode = 1
				li_errcode = 0
			end if
		else
			as_errortext = "Stock is zero for this Batch and Expiry"
			li_errcode = 0
			ai_errorcode = 1
		end if
	next
	destroy lds_itemstockinfo
	return li_errcode

// w_adjwindow.wf_itemstockinfo(long al_gcode, long al_icode, string as_batch, datetime ad_expiry, double ad_stock) returns boolean
	boolean retflag = true
	SQL SELECT godowndetail.currqty INTO :ad_stock FROM godowndetail WHERE godowndetail.Gcode =:al_gcode AND godowndetail.icode =:al_icode AND godowndetail.batch =:as_batch AND godowndetail.expiry =:ad_expiry USING this.it_transobject;
	if isnull(ad_stock) then
		ad_stock = 0
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_adjwindow.wf_setiteminfo(long al_icode, long al_row, long al_gcode, double ad_qty, double ad_purprice, double ad_discperc, double ad_purqty, double ad_prevretqty, double ad_stock) returns 0
	this.id_detail.setitem(al_row, "gcode", al_gcode)
	this.id_detail.setitem(al_row, "looseqty", ad_qty)
	this.id_detail.setitem(al_row, "prprice", ad_purprice)
	this.id_detail.setitem(al_row, "discperc", ad_discperc)
	this.id_footer.object.purqty[this.id_footer.getrow()] = ad_purqty
	this.id_footer.object.prevretqty[this.id_footer.getrow()] = ad_prevretqty
	this.id_footer.object.stock[this.id_footer.getrow()] = ad_stock

// w_adjwindow.wf_setiteminfobatch(long al_icode, long al_row, long al_gcode, double ad_looseqty, double ad_bonusqty, long al_packunits, double ad_purprice, double ad_discperc, double ad_purlooseqty, double ad_purbonusqty, double ad_prevretlooseqty, double ad_prevretbonusqty, double ad_stock, string as_batch, datetime ad_expiry) returns 0
	this.id_detail.setitem(al_row, "gcode", al_gcode)
	this.id_detail.setitem(al_row, "batch", as_batch)
	this.id_detail.setitem(al_row, "expiry", ad_expiry)
	this.id_detail.setitem(al_row, "looseqty", ad_looseqty)
	this.id_detail.setitem(al_row, "bonusqty", ad_bonusqty)
	this.id_detail.setitem(al_row, "packunits", al_packunits)
	this.id_detail.setitem(al_row, "prprice", ad_purprice)
	this.id_detail.setitem(al_row, "discperc", ad_discperc)
	this.id_footer.object.purlooseqty[this.id_footer.getrow()] = ad_purlooseqty
	this.id_footer.object.purbonusqty[this.id_footer.getrow()] = ad_purbonusqty
	this.id_footer.object.prevretlooseqty[this.id_footer.getrow()] = ad_prevretlooseqty
	this.id_footer.object.prevretbonusqty[this.id_footer.getrow()] = ad_prevretbonusqty
	this.id_footer.object.stock[this.id_footer.getrow()] = ad_stock

// w_adjwindow.wf_validatelooseqty(long al_row, double ad_looseqty, string as_errortext) returns integer
	integer li_rtcode
	if ad_looseqty <= 0.0 then
		li_rtcode = 1
		as_errortext = "Quantity can not be less than zero"
	end if
	return li_rtcode

// w_adjwindow.wf_fetchserverdate(boolean ab_checked) returns long
	if ab_checked then
		this.ib_fetchserverdate = true
	else
		this.ib_fetchserverdate = false
	end if
	return 0

// w_adjwindow.wf_show_item_adjustment_history() returns 0
	s_itempurchasehistory ls_itempurchasehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itempurchasehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itempurchasehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itemadjustmenthistory, ls_itempurchasehistory)
	end if

// w_adjwindow.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_adjustmentmenu" then
		this.menuid = create m_adjustmentmenu
	end if
	this.dw_adjreport = create dw_adjreport
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_adjreport

// w_adjwindow.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_adjreport

// w_adjwindow.ue_save() returns 0 [event]
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_icode
	long ll_gcode
	long ll_packingunits
	long ll_salesmancode = 1
	long ll_adjcode
	long ll_headerno
	long ll_headerinvno
	long ll_null
	long ll_count
	long ll_found
	string ls_batch
	string ls_errtext
	datetime ld_expiry
	double ld_avgprice
	double ld_prprice
	double ld_stock
	double ld_newstock
	double ld_looseqty
	integer li_counter
	integer li_errorrow
	integer li_maxretcode
	boolean lb_commitflag = true
	boolean lb_continue = true
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	datetime ldt_server_datetime
	string ls_date_errtext
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 1 then
		for ll_count = 1 to ll_detailrows
			ll_found = 0
			if ll_count = ll_detailrows then
				exit
			end if
			ll_found = this.id_detail.find("gcode = long('" + string(this.id_detail.getitemnumber(ll_count, "gcode")) + "') and " + " icode = long('" + string(this.id_detail.getitemnumber(ll_count, "icode")) + "') and batch = '" + this.id_detail.getitemstring(ll_count, "batch") + "' and expiry = Date('" + string(this.id_detail.getitemdatetime(ll_count, "expiry"), "yyyy-mm-dd") + "')", ll_count + 1, ll_detailrows)
			if ll_found > 0 then
				messagebox("Item Validation", "Duplicate items found at row " + string(ll_count) + " and " + string(ll_found) + "." + "~r~nSuggested options are either delete the row or ~r~n" + "change Item batch")
				this.id_detail.scrolltorow(ll_count)
				this.id_detail.setcolumn("looseqty")
				this.id_detail.setfocus()
				return
			end if
		next
	elseif ll_detailrows <= 0 then
		messagebox("On Save Validation", "There are no rows to save.~r~nKindly insert some item row.")
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if f_stringpreferences("AskUserPwdInAdjustment") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
	else
		ll_salesmancode = gl_usercode
	end if
	setfocus()
	if ll_salesmancode > 0 then
		SQL rollback USING sqlca;
		ul_rowcount = this.id_detail.rowcount()
		sqlca.getmaxutn(ul_rowcount, ul_maxutn)
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
			messagebox("Saving", "Error in generating Utn")
			return
		end if
		setpointer(hourglass!)
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_headerno = this.id_master.getitemnumber(ll_mastercurrrow, "headerno")
		ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
		if isnull(ll_headerinvno) then
			f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
			if ll_headerinvno > 0 then
				this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
			end if
		end if
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			li_maxretcode = wf_tabnewid("AdjHeader", ll_invid)
			if li_maxretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~n ~t~t~t~t~t~t~t~t~t~t~t~t~tgenerating InvCode")
				return
			end if
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
			this.id_master.setitem(ll_mastercurrrow, "usercode", ll_salesmancode)
		end if
		li_counter = 1
		if this.ib_modify then
			lb_continue = wf_returnadjinvoice(ll_invid, ls_errtext)
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "ModifiedDate", ldt_server_datetime)
			if not this.ib_modifydate then
				this.id_master.setitem(ll_mastercurrrow, "ModifiedDate", ldt_server_datetime)
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
				this.id_master.setitem(ll_mastercurrrow, "ModifiedDate", ldt_server_datetime)
			end if
		else
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
				this.id_master.setitem(ll_mastercurrrow, "Date", ldt_server_datetime)
				this.id_master.setitem(ll_mastercurrrow, "ModifiedDate", ldt_server_datetime)
				this.id_master.setitem(ll_mastercurrrow, "PostedDate", ldt_server_datetime)
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
				this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
				this.id_master.setitem(ll_mastercurrrow, "Posteddate", ldt_server_datetime)
				this.id_master.setitem(ll_mastercurrrow, "modifieddate", ldt_server_datetime)
			end if
		end if
		this.id_master.setitem(ll_mastercurrrow, "adjcatcode", 2)
		do while lb_continue and (li_counter <= ll_detailrows and lb_commitflag = true)
			this.id_detail.setitem(li_counter, "AdjUtn", ul_maxutn)
			ul_maxutn = ul_maxutn + 1
			this.id_detail.setitem(li_counter, "code", ll_invid)
			ll_icode = this.id_detail.object.icode[li_counter]
			ll_gcode = this.id_detail.object.gcode[li_counter]
			ls_batch = this.id_detail.object.batch[li_counter]
			ld_expiry = this.id_detail.object.expiry[li_counter]
			ld_looseqty = this.id_detail.object.looseqty[li_counter]
			ll_packingunits = this.id_detail.object.packunits[li_counter]
			ld_avgprice = this.id_detail.object.avgprice[li_counter]
			ld_prprice = this.id_detail.object.price[li_counter]
			this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
			if this.it_transobject.sqlcode = 0 then
				this.it_transobject.getitemstockall(ll_icode, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					this.id_detail.object.avgprice[li_counter] = ld_avgprice
					this.id_detail.object.newavgprice[li_counter] = ld_avgprice
					this.id_detail.object.currstock[li_counter] = ld_stock
				end if
				ld_stock = 0
				this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					if ld_stock > 0.0 then
						ld_newstock = ld_stock - ld_looseqty
						if ld_newstock > 0.0 then
							this.it_transobject.saleupdateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock, ld_stock)
							if this.it_transobject.sqlcode <> 0 then
								lb_commitflag = false
								li_errorrow = li_counter
								ls_errtext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
							end if
						elseif ld_newstock < 0.0 then
							lb_commitflag = false
							li_errorrow = li_counter
							ls_errtext = "Stock (" + string(ld_stock) + ") is less than required quantity (" + string(ld_looseqty) + " )at Row No. " + string(li_counter)
						else
							this.it_transobject.deleteitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
							if this.it_transobject.sqlcode <> 0 then
								lb_commitflag = false
								li_errorrow = li_counter
								ls_errtext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
							end if
						end if
					else
						lb_commitflag = false
						li_errorrow = li_counter
						ls_errtext = "Stock(" + string(ld_stock) + ")is less than required quantity (" + string(ld_looseqty) + ") at Row No. " + string(li_counter)
					end if
				else
					lb_commitflag = false
					li_errorrow = li_counter
					ls_errtext = "Batch Wise Stock Fetch Error:~r~n" + this.it_transobject.sqlerrtext
				end if
			else
				lb_commitflag = false
			end if
			li_counter = li_counter + 1
		loop
	else
		SQL rollback USING this.it_transobject;
		messagebox("Updation Error", ls_errtext + " ", stopsign!)
	end if
	if not lb_commitflag then
		SQL rollback USING this.it_transobject;
		messagebox("Updation Error", ls_errtext + " ", stopsign!)
		if this.ib_modify = false then
			setnull(ll_null)
			this.id_master.setitem(1, "Code", ll_null)
			this.id_master.accepttext()
		end if
		setfocus()
		if li_errorrow > 0 then
			this.id_detail.setrow(li_errorrow)
			this.id_detail.scrolltorow(li_errorrow)
			this.id_detail.setcolumn("looseqty")
			this.id_detail.setfocus()
			this.id_detail.selecttext(1, len(trim(string(this.id_detail.object.looseqty[li_errorrow]))))
		end if
	else
		call super::ue_save
	end if
	if lb_commitflag and f_stringpreferences("IncAdjInActMonitor") = "Y" then
		this.it_transobject.updateactivitymonitor("AD", ll_invid)
		if this.it_transobject.sqlcode = 0 then
			SQL commit USING this.it_transobject;
		else
			SQL rollback USING this.it_transobject;
			messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
		end if
	end if
	setpointer(arrow!)

// w_adjwindow.ue_newform() returns 0 [event]
	integer li_price
	long ll_counter
	datetime ldt_server_datetime
	string ls_date_errtext
	call super::ue_newform
	setredraw(false)
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.ib_modify = false
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	this.idc_itemdddw.reset()
	this.idc_itemdddw.insertrow(0)
	if not wf_validatedate() then
		close(this)
	end if
	li_price = 1
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 553 then
			li_price = 0
		end if
	next
	this.id_detail.object.price.protect = li_price
	if this.ib_modifydate then
		if this.ib_fetchserverdate then
			wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
			this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
		else
			this.id_master.setitem(this.id_master.getrow(), "date", today())
		end if
	end if
	setredraw(true)

// w_adjwindow.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect = 1
	long ll_row
	long ll_code
	long ll_adjcode
	string ls_errtext
	call super::ue_detail
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	this.ib_modify = true
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	this.id_footer.retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	if wf_allowadjustmentmodification(ll_code, this.il_groupcode, this.il_strategy) <> 0 then
		this.id_detail.reset()
		messagebox("Adjustment Modification Validation", "You Can not modify this Adjustment,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	wf_initmodify(li_protect, ls_errtext)
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_purchasegodownoption
	end if
	this.im_menu.m_file.m_print.enabled = true
	wf_grandtotal()
	setredraw(true)

// w_adjwindow.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	destroy this.ids_adjdetail
	return ::message.returnvalue

// w_adjwindow.ue_deleteitem() returns 0 [event]
	long ll_row
	ll_row = this.id_detail.getrow()
	if this.id_detail.rowcount() > 0 then
		call super::ue_deleteitem
		return
	end if
	this.im_menu.m_file.m_print.enabled = false

// w_adjwindow.ue_newitem() returns 0 [event]
	long ll_count
	long ll_rowcount
	this.idc_itemdddw.insertrow(0)
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 1 and vf_dwdupcodebatch(this.id_detail, "gcode", gl_defaultgcode, "icode", this.id_detail.getitemnumber(this.id_detail.getrow(), "icode"), "batch", this.id_detail.getitemstring(this.id_detail.getrow(), "batch"), "expiry", this.id_detail.getitemdatetime(this.id_detail.getrow(), "expiry"), this.il_currrow) = true then
		messagebox("Item Validation", "Duplicate item, please select some other item")
		return
	end if
	ll_count = this.id_detail.rowcount()
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.settransobject(this.it_transobject)
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_adjwindow.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_adjwindow.ue_list() returns 0 [event]
	call super::ue_list
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_post.enabled = true

// w_adjwindow.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	setpointer(hourglass!)
	setpointer(arrow!)

// w_adjwindow.ue_print() returns 0 [event]
	long ll_row
	long ll_invcode
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_adjwindow.ue_postopen() returns 0 [event]
	long li_rtncode
	long ll_counter
	long ll_found
	s_salerettype ls_purrettype
	datawindowchild ldc_headerno
	datastore lds_headers
	m_adjustmentmenu lm_menu
	call super::ue_postopen
	lm_menu = this.menuid
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	setredraw(false)
	ls_purrettype = message.powerobjectparm
	gd_itemsinfo.sharedata(this.id_itemslist)
	li_rtncode = this.id_detail.getchild("batch", this.idc_itemdddw)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_itemdddw.settransobject(this.it_transobject)
	this.idc_itemdddw.insertrow(0)
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit to Make Adjustments")
		close(this)
		return
	end if
	li_rtncode = this.id_detail.getchild("gcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to Make Adjustment")
		close(this)
		return
	end if
	this.ii_purchasegodownoption = this.idc_godown.getitemnumber(1, "gcode")
	this.id_detail.object.gcode.initial = string(this.ii_purchasegodownoption)
	if f_stringpreferences("alternatecustomicodeinadj") = "N" then
		this.id_detail.object.alternatecustomicode.visible = false
	end if
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = true
	this.id_itemslist.object.sstock.visible = true
	this.id_itemslist.object.t_pstock.visible = false
	this.id_itemslist.object.pstock.visible = false
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_detail.object.gcode.visible = false
		this.id_master.object.t_gcode.visible = true
		this.id_master.object.gcode.visible = true
		this.id_master.object.gcode.initial = string(this.ii_purchasegodownoption)
	end if
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Adjustment")
		close(this)
		return
	end if
	if f_stringpreferences("headeronadjustmentinv") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.t_headerno.visible = false
	end if
	this.id_master.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to lds_headers.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
		ldc_headerno.setitem(ll_counter, "name", "")
		ll_found = 0
		ll_found = gds_reoprtheaderinfo.find("headerno=" + string(lds_headers.getitemnumber(ll_counter, "headercode")), 1, gds_reoprtheaderinfo.rowcount())
		if ll_found > 0 then
			ldc_headerno.setitem(ll_counter, "headeralias", gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks"))
		end if
	next
	this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
	this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.sstock.visible = false
	end if
	this.id_detail.object.updateavgprice.initial = f_stringpreferences("UpdAvgPriceInAdjInc")
	if f_stringpreferences("ShowUpdAvgPriceInAdjInc") = "N" then
		this.id_detail.object.updateavgprice.visible = false
	end if
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	f_setcolumnstyle(this.id_detail, "Qty")
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 699", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.date.protect = 0
		this.id_master.object.date.background.color = rgb(255, 255, 255)
		this.ib_modifydate = true
		lm_menu.m_file.m_setserverdate.visible = true
		lm_menu.m_file.m_setserverdate.enabled = true
	end if
	if not this.ib_modifydate then
		this.id_master.object.date.protect = 1
		this.id_master.settaborder("date", 0)
		lm_menu.m_file.m_setserverdate.visible = false
		lm_menu.m_file.m_setserverdate.enabled = false
	end if
	this.id_print = this.dw_adjreport
	this.id_print.settransobject(this.it_transobject)
	if f_stringpreferences("showexpiryinadj") = "N" then
		this.id_detail.object.expiry.visible = false
	end if
	setredraw(true)

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	return 1

// dw_footer.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	return 1

// dw_detail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.getparent().dynamic postevent("ue_accepttext")
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	string ls_errortext
	string ls_itemname
	double ld_newqty
	double ld_storedqty
	double ld_stock
	double ld_packqty
	double ld_defaultqty = 1.0
	long ll_null
	long ll_currentrow
	long ll_icode
	long ll_itemtypecode
	string ls_null
	datetime ldt_expiry
	date ld_expiry
	time lt_expiry
	datawindowchild ldc_items
	dwitemstatus lrs_status
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	ll_currentrow = getrow()
	lrs_status = getitemstatus(ll_currentrow, 0, primary!)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case "icode"
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
		parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		li_errcode = 0
	case "gcode"
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		li_errcode = 0
	case "looseqty"
		li_errcode = parent.parent.parent.wf_validatelooseqty(row, double(data), ls_errortext)
		if li_errcode > 0 then
			messagebox("Quantity Validation", ls_errortext)
		end if
		ld_packqty = double(data)
		if ld_packqty <= 0.0 then
			messagebox("Quantity Validation", ls_errortext)
		end if
		accepttext()
		parent.parent.parent.il_currrow = row
		if parent.parent.parent.wf_validaterow() = -1 then
			li_errcode = 1
		end if
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname, ll_itemtypecode, parent.parent.parent.idbl_packqty, parent.parent.parent.idbl_purprice, parent.parent.parent.idbl_saleprice)
			if li_res > 0 then
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				if ll_itemtypecode = 2 then
					setitem(row, "alternatecustomicode", data)
				else
					setitem(row, "alternatecustomicode", ls_null)
				end if
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
			else
				messagebox("ItemNumber Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_errcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_errcode = 2
		end if
	case "expiry"
		ld_expiry = date(mid(data, 1, 10))
		lt_expiry = time("00:00:00.000000")
		ldt_expiry = datetime(ld_expiry, lt_expiry)
		if rowcount() > 1 and ldt_expiry <> datetime("00/00/0000, 00:00:00") and not (isnull(this.object.icode[row]) and isnull(this.object.batch[row]) and isnull(this.object.expiry[row])) and vf_dwdupcodebatch(this, "gcode", gl_defaultgcode, "icode", getitemnumber(getrow(), "icode"), "batch", getitemstring(getrow(), "batch"), "expiry", ldt_expiry, parent.parent.parent.il_currrow) = true then
			messagebox("Item Validation", "Duplicate item, please select some other item")
			li_errcode = 1
		end if
	case "batch"
		setitem(row, "Expiry", parent.parent.parent.idc_itemdddw.getitemdatetime(parent.parent.parent.idc_itemdddw.getrow(), "Expiry"))
		setitem(row, "looseqty", parent.parent.parent.idc_itemdddw.getitemnumber(parent.parent.parent.idc_itemdddw.getrow(), "currqty"))
		setitem(row, "itemrow", parent.parent.parent.idc_itemdddw.getrow())
		setitem(row, "Expiry", parent.parent.parent.idc_itemdddw.getitemdatetime(parent.parent.parent.idc_itemdddw.getrow(), "Expiry"))
		setitem(row, "looseqty", parent.parent.parent.idc_itemdddw.getitemnumber(parent.parent.parent.idc_itemdddw.getrow(), "currqty"))
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	string ls_columnobject
	string ls_null
	long ll_currow
	long ll_gcode
	long ll_icode
	double ld_stock
	integer li_null
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "batch" and isnull(this.object.batch[row]) then
		ll_gcode = getitemnumber(row, "gcode")
		ll_icode = getitemnumber(row, "icode")
		parent.parent.parent.idc_itemdddw.reset()
		if parent.parent.parent.idc_itemdddw.retrieve(ll_gcode, ll_icode) < 0 then
			if parent.parent.parent.il_godowncount > 1 and parent.parent.parent.il_strategy = 1 then
				setnull(li_null)
				setcolumn("gcode")
				this.object.gcode[row] = li_null
				parent.parent.parent.id_footer.object.stock[parent.parent.parent.id_footer.getrow()] = 0
				return -1
			end if
		else
			parent.parent.parent.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
			if parent.parent.parent.it_transobject.sqlcode = 0 then
				parent.parent.parent.id_footer.object.stock[parent.parent.parent.id_footer.getrow()] = ld_stock
			end if
		end if
	end if
	if dwo.name = "itemname" then
		parent.parent.parent.ib_focusdetail = true
	end if
	if dwo.name = "gcode" then
		ll_gcode = getitemnumber(row, "gcode")
		ll_icode = getitemnumber(row, "icode")
		parent.parent.parent.idc_itemdddw.reset()
		if parent.parent.parent.idc_itemdddw.retrieve(ll_gcode, ll_icode) < 0 then
			if parent.parent.parent.il_godowncount > 1 and parent.parent.parent.il_strategy = 1 then
				setnull(li_null)
				setcolumn("gcode")
				this.object.gcode[row] = li_null
				parent.parent.parent.id_footer.object.stock[parent.parent.parent.id_footer.getrow()] = 0
				return -1
			end if
		else
			parent.parent.parent.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
			if parent.parent.parent.it_transobject.sqlcode = 0 then
				parent.parent.parent.id_footer.object.stock[parent.parent.parent.id_footer.getrow()] = ld_stock
			end if
		end if
	end if
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.ib_itemdetaillosefocus = true
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	long ll_icode
	long ll_foundrow
	dwitemstatus lrs_status
	string ls_batch
	datetime ld_expiry
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if getcolumnname() <> parent.parent.parent.is_columnitemname then
		if parent.parent.parent.id_detail.rowcount() > 0 and lrs_status <> new! then
			parent.parent.parent.id_footer.object.icode[parent.parent.parent.id_footer.getrow()] = parent.parent.parent.id_detail.object.icode[currentrow]
			parent.parent.parent.id_footer.object.stock[parent.parent.parent.id_footer.getrow()] = parent.parent.parent.id_detail.object.stock[currentrow]
			parent.parent.parent.id_footer.object.totalstock[parent.parent.parent.id_footer.getrow()] = parent.parent.parent.id_detail.object.totalstock[currentrow]
		elseif parent.parent.parent.id_footer.getrow() > 0 then
			parent.parent.parent.id_footer.object.icode[parent.parent.parent.id_footer.getrow()] = 0
			parent.parent.parent.id_footer.object.stock[parent.parent.parent.id_footer.getrow()] = 0
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "icode"
		if isnull(data) or data = "" then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case "discperc"
		messagebox("Item Discount Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	case "purprice"
		messagebox("Item Price Validation", "Item price ~"" + data + "~" must be greater than zero")
	end choose
	return 1

// dw_itemsdetail.getfocus() returns long [event]
	long ancestorreturnvalue
	if f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	return ::message.returnvalue

// dw_itemsdetail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	string ls_null
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	if dwo.name = "batch" then
		setnull(ls_null)
		this.object.batch[row] = ls_null
	end if
	return ::message.returnvalue
