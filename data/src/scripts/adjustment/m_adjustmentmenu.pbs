// menu m_adjustmentmenu (adjustment)  ancestor: m_multi_entry

// m_adjustmentmenu.create() returns 0
	m_adjustmentmenu = this
	call super::create

// m_adjustmentmenu.destroy() returns 0
	call super::destroy

// m_adjustmentmenu.clicked() returns 0
	call super::clicked
	if this.checked then
		this.checked = false
	else
		this.checked = true
	end if
	this.parentwindow.dynamic wf_fetchserverdate(this.checked)
