// menu m_adjustmentmenu (adjustment)  ancestor: m_multi_entry

// m_adjustmentmenu.create() returns 0 [event]
	m_adjustmentmenu = this
	call super::create

// m_adjustmentmenu.destroy() returns 0 [event]
	call super::destroy

// m_adjustmentmenu.clicked() returns 0 [event]
	call super::clicked
	if this.checked then
		this.checked = false
	else
		this.checked = true
	end if
	this.parentwindow.dynamic wf_fetchserverdate(this.checked)

// m_file.create() returns 0 [event]
	call super::create
	this.m_populateitems = create m_populateitems
	this.m_savepost = create m_savepost
	this.m_setserverdate = create m_setserverdate
	this.m_populatestockinhandfromdatacarry = create m_populatestockinhandfromdatacarry
	this.m_showitemadjustmenthistory = create m_showitemadjustmenthistory
	this.m_populatestockauditfromdatacarry = create m_populatestockauditfromdatacarry
	this.item[upperbound(this.item) + 1] = this.m_populateitems
	this.item[upperbound(this.item) + 1] = this.m_savepost
	this.item[upperbound(this.item) + 1] = this.m_setserverdate
	this.item[upperbound(this.item) + 1] = this.m_populatestockinhandfromdatacarry
	this.item[upperbound(this.item) + 1] = this.m_showitemadjustmenthistory
	this.item[upperbound(this.item) + 1] = this.m_populatestockauditfromdatacarry

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_populateitems
	destroy this.m_savepost
	destroy this.m_setserverdate
	destroy this.m_populatestockinhandfromdatacarry
	destroy this.m_showitemadjustmenthistory
	destroy this.m_populatestockauditfromdatacarry

// m_options.clicked() returns 0 [event]
	long ll_manfcode
	long ll_pocode
	call super::clicked
	this.parentwindow.dynamic wf_getpomanfcode(ll_pocode, ll_manfcode)
	this.parentwindow.dynamic wf_populatedetaildwfrompo(ll_pocode, ll_manfcode)

