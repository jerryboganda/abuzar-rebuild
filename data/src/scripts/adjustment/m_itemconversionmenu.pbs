// menu m_itemconversionmenu (adjustment)  ancestor: m_multi_entry

// m_itemconversionmenu.create() returns 0
	m_itemconversionmenu = this
	call super::create

// m_itemconversionmenu.destroy() returns 0
	call super::destroy

// m_itemconversionmenu.clicked() returns 0
	call super::clicked
	if this.checked then
		this.checked = false
	else
		this.checked = true
	end if
	this.parentwindow.dynamic wf_fetchserverdate(this.checked)
