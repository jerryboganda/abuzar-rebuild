// window w_item_garments_wizard (multientryitemrespwin)  ancestor: window

// w_item_garments_wizard.ue_keydown(keycode key, unsignedlong keyflags) returns long
	return ::message.returnvalue

// w_item_garments_wizard.ue_close() returns 0
	wf_disconnect()
	close(this)

// w_item_garments_wizard.wf_duplicatealiasname(string as_aliasname, long al_icode) returns boolean
	long ll_count
	long ll_icode
	long ll_row
	boolean b_flag
	as_aliasname = trim(as_aliasname)
	SQL SELECT count ( *) INTO :ll_count FROM item WHERE item.customicode =:as_aliasname and item.icode <> :al_icode USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_item_garments_wizard.wf_disconnect() returns 0
	SQL stop USING this.it_transobject;
	destroy this.it_transobject

// w_item_garments_wizard.wf_connect() returns integer
	this.it_transobject = create u_transaction
	SQL start USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_item_garments_wizard.wf_duplicatename(string as_name, long al_icode) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM item WHERE item.name =:as_name and item.icode <> :al_icode USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_item_garments_wizard.wf_validateserverdatetime(datetime ar_server_datetime, string ar_errtext) returns boolean
	datetime ldt_last_transdate
	datetime ldt_current_serverdate
	long li_max_allow_days
	ar_errtext = "Invoice Date  Check violates"
	li_max_allow_days = f_numberpreferences("MaxAllowDate")
	if isnull(li_max_allow_days) then
		li_max_allow_days = 4
	end if
	SQL SELECT LastTransDate INTO :ldt_last_transdate FROM ServerDate USING sqlca;
	if sqlca.sqlcode = 0 then
		sqlca.getdatetime(ldt_current_serverdate)
		if sqlca.sqlcode = 0 then
			if ldt_current_serverdate >= ldt_last_transdate and daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) <= li_max_allow_days then
				ar_server_datetime = ldt_current_serverdate
				return true
			elseif ldt_current_serverdate < ldt_last_transdate then
				ar_errtext = "Back Date Invoice Check violates"
				return false
			elseif daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) > li_max_allow_days then
				ar_errtext = "Forward Date Invoice Check violates"
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_item_garments_wizard.wf_insert_itemnotes(long al_icode, integer al_insert_update_mode) returns long
	u_transaction lt_transobject
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server for updating/inserting in ItemNotes")
		destroy lt_transobject
		return -1
	end if
	if al_insert_update_mode = 0 then
		SQL Insert Into ItemNotes ( ICode ) Values ( :al_icode ) USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Insert Error", "Unable to Insert Item Into ItemNotes.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
			SQL stop USING lt_transobject;
			destroy lt_transobject
			return -1
		end if
		return
	end if
	if not isnull(this.iblob_notes) then
		SQL UpdateBlob ItemNotes Set Notes =:this.iblob_notes Where Icode =:al_icode USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Notes ", "Unable to update item notes.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		end if
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	return 0

// w_item_garments_wizard.wf_get_itemnotes(long al_icode) returns long
	u_transaction lt_transobject
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server")
		destroy lt_transobject
		return -1
	end if
	SQL SelectBlob notes INTO :this.iblob_notes From ItemNotes Where Icode =:al_icode USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Notes ", "Unable to fetch item notes.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	return 0

// w_item_garments_wizard.wf_setitemname(string as_col, string as_val) returns long
	integer li_counter
	string ls_itemname
	string ls_primaryname
	string ls_design
	string ls_color
	string ls_size
	string ls_sleeve
	string ls_class
	string ls_category
	string ls_packing
	string ls_manf
	string ls_style
	string ls_yarn
	string ls_fabric
	string ls_brand
	string ls_generic
	string ls_itemyear
	string ls_remarksforpurchase
	string ls_sizedescription
	string ls_modeldescription
	string ls_typedescription
	string ls_location1
	string ls_remarks1
	string ls_location
	string ls_packingdesc
	long ll_designcode
	long ll_colorcode
	long ll_sizecode
	long ll_sleevecode
	long ll_masterrow
	long ll_retcode
	long ll_iccode
	long ll_icatcode
	long ll_packcode
	long ll_manfcode
	long ll_genericcode
	long ll_istylecode
	long ll_iyarncode
	long ll_ifabriccode
	long ll_ibrandcode
	ll_masterrow = this.dw_master.rowcount()
	ls_itemname = ""
	if as_col = "remarks" then
		ls_primaryname = as_val
	elseif as_col = "itemdesigncode" then
		ll_designcode = long(as_val)
	elseif as_col = "isleevecode" then
		ll_sleevecode = long(as_val)
	elseif as_col = "icolourcode" then
		ll_colorcode = long(as_val)
	elseif as_col = "isizecode" then
		ll_sizecode = long(as_val)
	elseif as_col = "iccode" then
		ll_iccode = long(as_val)
	elseif as_col = "icatcode" then
		ll_icatcode = long(as_val)
	elseif as_col = "packcode" then
		ll_packcode = long(as_val)
	elseif as_col = "manfcode" then
		ll_manfcode = long(as_val)
	elseif as_col = "istylecode" then
		ll_istylecode = long(as_val)
	elseif as_col = "iyarncode" then
		ll_iyarncode = long(as_val)
	elseif as_col = "ifabriccode" then
		ll_ifabriccode = long(as_val)
	elseif as_col = "ibrandcode" then
		ll_ibrandcode = long(as_val)
	elseif as_col = "genericcode" then
		ll_genericcode = long(as_val)
	elseif as_col = "location1" then
		ls_location1 = as_val
	elseif as_col = "remarks1" then
		ls_remarks1 = as_val
	elseif as_col = "location" then
		ls_location = as_val
	elseif as_col = "packingdesc" then
		ls_packingdesc = as_val
	elseif as_col = "itemyear" then
		ls_itemyear = as_val
	elseif as_col = "remarksforpurchase" then
		ls_remarksforpurchase = as_val
	elseif as_col = "sizedescription" then
		ls_sizedescription = as_val
	elseif as_col = "modeldescription" then
		ls_modeldescription = as_val
	elseif as_col = "typedescription" then
		ls_typedescription = as_val
	end if
	if as_col <> "itemdesigncode" then
		ll_designcode = this.dw_master.object.itemdesigncode[ll_masterrow]
	end if
	if as_col <> "icolourcode" then
		ll_colorcode = this.dw_master.object.icolourcode[ll_masterrow]
	end if
	if as_col <> "isizecode" then
		ll_sizecode = this.dw_master.object.isizecode[ll_masterrow]
	end if
	if as_col <> "isleevecode" then
		ll_sleevecode = this.dw_master.object.isleevecode[ll_masterrow]
	end if
	if as_col <> "iccode" then
		ll_iccode = this.dw_master.object.iccode[ll_masterrow]
	end if
	if as_col <> "icatcode" then
		ll_icatcode = this.dw_master.object.icatcode[ll_masterrow]
	end if
	if as_col <> "packcode" then
		ll_packcode = this.dw_master.object.packcode[ll_masterrow]
	end if
	if as_col <> "manfcode" then
		ll_manfcode = this.dw_master.object.manfcode[ll_masterrow]
	end if
	if as_col <> "istylecode" then
		ll_istylecode = this.dw_master.object.istylecode[ll_masterrow]
	end if
	if as_col <> "iyarncode" then
		ll_iyarncode = this.dw_master.object.iyarncode[ll_masterrow]
	end if
	if as_col <> "ifabriccode" then
		ll_ifabriccode = this.dw_master.object.ifabriccode[ll_masterrow]
	end if
	if as_col <> "ibrandcode" then
		ll_ibrandcode = this.dw_master.object.ibrandcode[ll_masterrow]
	end if
	if as_col <> "genericcode" then
		ll_genericcode = this.dw_master.object.genericcode[ll_masterrow]
	end if
	if as_col <> "remarks" then
		ls_primaryname = upper(trim(this.dw_master.object.remarks[ll_masterrow]))
		if ls_primaryname = "" or isnull(ls_primaryname) then
			ls_primaryname = ""
		end if
	end if
	if as_col <> "location1" then
		ls_location1 = upper(trim(this.dw_master.object.location1[ll_masterrow]))
		if ls_location1 = "" or isnull(ls_location1) then
			ls_location1 = ""
		end if
	end if
	if as_col <> "remarks1" then
		ls_remarks1 = upper(trim(this.dw_master.object.remarks1[ll_masterrow]))
		if ls_remarks1 = "" or isnull(ls_remarks1) then
			ls_remarks1 = ""
		end if
	end if
	if as_col <> "location" then
		ls_location = upper(trim(this.dw_master.object.location[ll_masterrow]))
		if ls_location = "" or isnull(ls_location) then
			ls_location = ""
		end if
	end if
	if as_col <> "packingdesc" then
		ls_packingdesc = upper(trim(this.dw_master.object.packingdesc[ll_masterrow]))
		if ls_packingdesc = "" or isnull(ls_packingdesc) then
			ls_packingdesc = ""
		end if
	end if
	if as_col <> "itemyear" then
		ls_itemyear = upper(trim(this.dw_master.object.itemyear[ll_masterrow]))
		if ls_itemyear = "" or isnull(ls_itemyear) then
			ls_itemyear = ""
		end if
	end if
	if as_col <> "remarksforpurchase" then
		ls_remarksforpurchase = upper(trim(this.dw_master.object.remarksforpurchase[ll_masterrow]))
		if ls_remarksforpurchase = "" or isnull(ls_remarksforpurchase) then
			ls_remarksforpurchase = ""
		end if
	end if
	if as_col <> "sizedescription" then
		ls_sizedescription = upper(trim(this.dw_master.object.sizedescription[ll_masterrow]))
		if ls_sizedescription = "" or isnull(ls_sizedescription) then
			ls_sizedescription = ""
		end if
	end if
	if as_col <> "modeldescription" then
		ls_modeldescription = upper(trim(this.dw_master.object.modeldescription[ll_masterrow]))
		if ls_modeldescription = "" or isnull(ls_modeldescription) then
			ls_modeldescription = ""
		end if
	end if
	if as_col <> "typedescription" then
		ls_typedescription = upper(trim(this.dw_master.object.typedescription[ll_masterrow]))
		if ls_typedescription = "" or isnull(ls_typedescription) then
			ls_typedescription = ""
		end if
	end if
	SQL SELECT Design =ISNULL ( ( SELECT UPPER ( Name ) FROM DBO.ItemDesign WHERE ItemDesignCode =:ll_designcode ) , '' ) , Color =ISNULL ( ( SELECT UPPER ( Name ) FROM DBO.ItemColour WHERE IColourCode =:ll_colorcode ) , '' ) , Size =ISNULL ( ( SELECT UPPER ( Name ) FROM DBO.ItemSize WHERE ISizeCode =:ll_sizecode ) , '' ) , Sleeve =ISNULL ( ( SELECT UPPER ( Name ) FROM DBO.ItemSleeve WHERE ISleeveCode =:ll_sleevecode ) , '' ) , Class =ISNULL ( ( SELECT UPPER ( Name ) FROM DBO.ItemClass WHERE ICCode =:ll_iccode ) , '' ) , Category =ISNULL ( ( SELECT UPPER ( Name ) FROM DBO.ItemCategory WHERE ICatCode =:ll_icatcode ) , '' ) , Packing =ISNULL ( ( SELECT UPPER ( Name ) FROM DBO.ItemPacking WHERE PackCode =:ll_packcode ) , '' ) , Manf =ISNULL ( ( SELECT UPPER ( Name ) FROM DBO.Manufacturer WHERE ManfCode =:ll_manfcode ) , '' ) , Style =ISNULL ( ( SELECT UPPER ( Name ) FROM DBO.ItemStyle WHERE istylecode =:ll_istylecode ) , '' ) , Yarn =ISNULL ( ( SELECT UPPER ( Name ) FROM DBO.ItemYarn WHERE iyarncode =:ll_iyarncode ) , '' ) , Fabric =ISNULL ( ( SELECT UPPER ( Name ) FROM DBO.ItemFabric WHERE ifabriccode =:ll_ifabriccode ) , '' ) , Brand =ISNULL ( ( SELECT UPPER ( Name ) FROM DBO.ItemBrand WHERE ibrandcode =:ll_ibrandcode ) , '' ) , Generic =ISNULL ( ( SELECT UPPER ( Name ) FROM DBO.GenericItem WHERE genericcode =:ll_genericcode ) , '' ) INTO :ls_design, :ls_color, :ls_size, :ls_sleeve, :ls_class, :ls_category, :ls_packing, :ls_manf, :ls_style, :ls_yarn, :ls_fabric, :ls_brand, :ls_generic FROM ( SELECT date =GETDATE ( ) ) d USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ls_itemname = ""
		for li_counter = 1 to this.ii_c_count
			choose case lower(this.c_colname[li_counter, 2])
			case "remarks"
				ls_itemname = ls_itemname + ls_primaryname
			case "itemdesigncode"
				ls_itemname = ls_itemname + ls_design
			case "isleevecode"
				ls_itemname = ls_itemname + ls_sleeve
			case "icolourcode"
				ls_itemname = ls_itemname + ls_color
			case "isizecode"
				ls_itemname = ls_itemname + ls_size
			case "iccode"
				ls_itemname = ls_itemname + ls_class
			case "icatcode"
				ls_itemname = ls_itemname + ls_category
			case "packcode"
				ls_itemname = ls_itemname + ls_packing
			case "manfcode"
				ls_itemname = ls_itemname + ls_manf
			case "istylecode"
				ls_itemname = ls_itemname + ls_style
			case "iyarncode"
				ls_itemname = ls_itemname + ls_yarn
			case "ifabriccode"
				ls_itemname = ls_itemname + ls_fabric
			case "ibrandcode"
				ls_itemname = ls_itemname + ls_brand
			case "genericcode"
				ls_itemname = ls_itemname + ls_generic
			case "location1"
				ls_itemname = ls_itemname + ls_location1
			case "remarks1"
				ls_itemname = ls_itemname + ls_remarks1
			case "location"
				ls_itemname = ls_itemname + ls_location
			case "packingdesc"
				ls_itemname = ls_itemname + ls_packingdesc
			case "itemyear"
				ls_itemname = ls_itemname + ls_itemyear
			case "remarksforpurchase"
				ls_itemname = ls_itemname + ls_remarksforpurchase
			case "sizedescription"
				ls_itemname = ls_itemname + ls_sizedescription
			case "modeldescription"
				ls_itemname = ls_itemname + ls_modeldescription
			case "typedescription"
				ls_itemname = ls_itemname + ls_typedescription
			end choose
			ls_itemname = ls_itemname + " "
		next
		ls_itemname = trim(left(trim(ls_itemname), 60))
		this.dw_master.object.name[ll_masterrow] = ls_itemname
		ll_retcode = 0
	else
		messagebox("Data fetch Error", "Some Database Problem Occured while retrieving item info.", stopsign!)
		ll_retcode = 1
	end if
	return ll_retcode

// w_item_garments_wizard.wf_edititem() returns long
	s_arguements lstr_arg
	open(w_arg_item)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		this.dw_master.retrieve(lstr_arg.l_code1)
		wf_get_itemnotes(lstr_arg.l_code1)
		this.ib_editflag = true
		this.dw_master.setcolumn("remarks")
		this.dw_master.setfocus()
	end if
	return 0

// w_item_garments_wizard.wf_newform() returns long
	long li_visiblecolumns
	long li_taborder
	long li_counter
	long li_xpos
	long li_ypos
	long li_xendpos
	datastore lds_itemsetting
	datastore lds_gbdw
	this.dw_master.insertrow(0)
	lds_itemsetting = create datastore
	lds_itemsetting.dataobject = "d_gbdw_interfacesettingcols_remaining"
	lds_itemsetting.settransobject(this.it_transobject)
	lds_itemsetting.retrieve()
	lds_gbdw = create datastore
	lds_gbdw.dataobject = "d_interfacesettingcols"
	lds_gbdw.settransobject(this.it_transobject)
	lds_gbdw.retrieve(49, 2, 1)
	li_visiblecolumns = lds_gbdw.rowcount()
	this.ii_c_count = lds_gbdw.rowcount()
	for li_counter = 1 to lds_gbdw.rowcount()
		this.c_colname[li_counter, 1] = lds_gbdw.getitemstring(li_counter, "colname") + "_t"
		this.c_colname[li_counter, 2] = lds_gbdw.getitemstring(li_counter, "colname")
		this.c_colwidth[li_counter, 1] = integer(this.dw_master.describe(this.c_colname[li_counter, 1] + ".Width"))
		this.c_colwidth[li_counter, 2] = integer(this.dw_master.describe(this.c_colname[li_counter, 2] + ".Width"))
	next
	li_taborder = 100
	li_counter = 1
	li_ypos = 100
	li_xendpos = 2650
	do while li_counter <= li_visiblecolumns and li_ypos <= 200000
		li_xpos = 32
		this.dw_master.modify(this.c_colname[li_counter, 1] + ".X=" + string(li_xpos))
		this.dw_master.modify(this.c_colname[li_counter, 1] + ".Y=" + string(li_ypos))
		this.dw_master.modify(this.c_colname[li_counter, 1] + ".Visible=1")
		li_xpos = 750
		this.dw_master.modify(this.c_colname[li_counter, 2] + ".X=" + string(li_xpos))
		this.dw_master.modify(this.c_colname[li_counter, 2] + ".Y=" + string(li_ypos))
		this.dw_master.modify(this.c_colname[li_counter, 2] + ".Visible=1")
		this.dw_master.settaborder(this.c_colname[li_counter, 2], li_taborder)
		if lower(this.c_colname[li_counter, 2]) = "avgprice" then
			this.dw_master.modify("c_margin_markup.X=" + string(li_xpos + integer(this.dw_master.describe(this.c_colname[li_counter, 2] + ".Width")) + 50))
			this.dw_master.modify("c_margin_markup.Y=" + string(li_ypos))
			this.dw_master.modify("c_margin_markup.Visible=1")
		end if
		li_taborder = li_taborder + 1
		li_ypos = li_ypos + integer(this.dw_master.describe(this.c_colname[li_counter, 2] + ".Height")) + 25
		li_counter = li_counter + 1
	loop
	this.dw_master.object.l_divider.x1 = 10
	this.dw_master.object.l_divider.x2 = 3141
	this.dw_master.object.l_divider.y1 = li_ypos
	this.dw_master.object.l_divider.y2 = li_ypos
	li_ypos = li_ypos + 50
	li_counter = 1
	li_visiblecolumns = lds_itemsetting.rowcount()
	for li_counter = 1 to lds_itemsetting.rowcount()
		this.colname[li_counter, 1] = lds_itemsetting.getitemstring(li_counter, "colname") + "_t"
		this.colname[li_counter, 2] = lds_itemsetting.getitemstring(li_counter, "colname")
		this.colwidth[li_counter, 1] = integer(this.dw_master.describe(this.colname[li_counter, 1] + ".Width"))
		this.colwidth[li_counter, 2] = integer(this.dw_master.describe(this.colname[li_counter, 2] + ".Width"))
	next
	li_counter = 1
	do while li_counter <= li_visiblecolumns and li_ypos <= 2000000
		li_xpos = 32
		this.dw_master.modify(this.colname[li_counter, 1] + ".X=" + string(li_xpos))
		this.dw_master.modify(this.colname[li_counter, 1] + ".Y=" + string(li_ypos))
		this.dw_master.modify(this.colname[li_counter, 1] + ".Visible=1")
		li_xpos = 750
		this.dw_master.modify(this.colname[li_counter, 2] + ".X=" + string(li_xpos))
		this.dw_master.modify(this.colname[li_counter, 2] + ".Y=" + string(li_ypos))
		this.dw_master.modify(this.colname[li_counter, 2] + ".Visible=1")
		this.dw_master.settaborder(this.colname[li_counter, 2], li_taborder)
		if lower(this.colname[li_counter, 2]) = "avgprice" then
			this.dw_master.modify("c_margin_markup.X=" + string(li_xpos + integer(this.dw_master.describe(this.colname[li_counter, 2] + ".Width")) + 50))
			this.dw_master.modify("c_margin_markup.Y=" + string(li_ypos))
			this.dw_master.modify("c_margin_markup.Visible=1")
		end if
		li_taborder = li_taborder + 1
		li_ypos = li_ypos + integer(this.dw_master.describe(this.colname[li_counter, 2] + ".Height")) + 25
		li_counter = li_counter + 1
	loop
	setnull(this.iblob_notes)
	wf_setitemname("", "")
	this.dw_master.setcolumn("remarks")
	this.dw_master.setfocus()
	return 0

// w_item_garments_wizard.wf_duplicate_regno(string as_regno) returns long
	long ll_icode
	long ll_count
	long ll_retcode
	as_regno = trim(as_regno)
	if this.dw_master.rowcount() > 0 then
		ll_icode = this.dw_master.object.code[this.dw_master.rowcount()]
	end if
	if ll_icode > 0 then
		SQL SELECT ISNULL ( count ( *) , 0 ) INTO :ll_count FROM item WHERE item.regdno =:as_regno and icode <> :ll_icode USING sqlca;
	else
		SQL SELECT ISNULL ( count ( *) , 0 ) INTO :ll_count FROM item WHERE item.regdno =:as_regno USING sqlca;
	end if
	if sqlca.sqlcode = 0 then
		if ll_count > 0 then
			ll_retcode = 1
		else
			ll_retcode = 0
		end if
	else
		ll_retcode = 2
	end if
	return ll_retcode

// w_item_garments_wizard.wf_duplicateitemno(string as_itemno) returns boolean
	long ll_icode
	long ll_found
	boolean lb_duplicate
	as_itemno = trim(as_itemno)
	if sqlca.checkuniquealiasname(ll_icode, as_itemno) = 0 then
		lb_duplicate = false
	else
		lb_duplicate = true
	end if
	return lb_duplicate

// w_item_garments_wizard.create() returns 0
	this.cb_find = create cb_find
	this.cb_exit = create cb_exit
	this.cb_save = create cb_save
	this.dw_master = create dw_master
	this.control = {this.cb_find, this.cb_exit, this.cb_save, this.dw_master}

// w_item_garments_wizard.destroy() returns 0
	destroy this.cb_find
	destroy this.cb_exit
	destroy this.cb_save
	destroy this.dw_master

// w_item_garments_wizard.open() returns long
	long ll_rtcode
	long ll_code
	long ll_counter
	datawindowchild ldc_itemcategory
	datawindowchild ldc_headerno
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	setredraw(false)
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width
		ll_height = ll_win_height
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	wf_connect()
	this.dw_master.settransobject(this.it_transobject)
	ldc_itemcategory.settransobject(this.it_transobject)
	ll_rtcode = this.dw_master.getchild("icatcode", ldc_itemcategory)
	if ll_rtcode <> 1 then
		messagebox("DataWindow Child Validation", "Unable to get datawindow child for item category.")
		close(this)
		return ::message.returnvalue
	end if
	ldc_itemcategory.settransobject(this.it_transobject)
	ldc_itemcategory.retrieve(f_getgroupcode(gl_usercode))
	this.dw_master.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to gds_reoprtheaderinfo.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", gds_reoprtheaderinfo.object.headerno[ll_counter])
		ldc_headerno.setitem(ll_counter, "name", gds_reoprtheaderinfo.object.clientname[ll_counter])
		ldc_headerno.setitem(ll_counter, "headeralias", gds_reoprtheaderinfo.object.remarks[ll_counter])
	next
	wf_newform()
	f_setcolumnstyle(this.dw_master, "Qty")
	setredraw(true)
	return ::message.returnvalue

// cb_find.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return 1

// cb_find.clicked() returns long
	if parent.ib_editflag then
		parent.cb_save.event clicked()
	end if
	parent.wf_edititem()
	return ::message.returnvalue

// cb_exit.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return 1

// cb_exit.clicked() returns long
	long ll_option
	if parent.ib_editflag then
		ll_option = messagebox("Save Changes and Exit", "Save Changes?", question!, yesno!, 1)
		if ll_option = 1 then
			parent.cb_save.event clicked()
		end if
	end if
	parent.triggerevent("ue_close")
	return ::message.returnvalue

// cb_save.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return 1

// cb_save.clicked() returns long
	long ll_mastercurrrow
	long ll_invid
	long ll_detailrows
	long ll_found
	long ll_code
	long ll_pk
	long ll_null
	integer li_counter
	integer ll_salesmancode
	boolean lb_commitflag
	string ls_aliasname
	string ls_itemname
	datetime ldt_server_datetime
	string ls_date_errtext
	boolean lb_modify
	datastore lds_itemlist
	setnull(ll_null)
	lds_itemlist = create datastore
	lds_itemlist.dataobject = "d_itemlist"
	lds_itemlist.settransobject(parent.it_transobject)
	ll_mastercurrrow = parent.dw_master.getrow()
	if f_validatedw(parent.dw_master) < 0 then
		return ::message.returnvalue
	end if
	lds_itemlist.retrieve()
	ll_pk = parent.dw_master.object.code[ll_mastercurrrow]
	if parent.dw_master.object.code[ll_mastercurrrow] > 0 then
		lb_modify = true
	end if
	if lb_modify then
		ls_itemname = parent.dw_master.getitemstring(ll_mastercurrrow, "name")
		ll_code = parent.dw_master.getitemnumber(ll_mastercurrrow, "code")
		ll_found = lds_itemlist.find("icode <> " + string(ll_code) + " AND itemname='" + ls_itemname + "'", 1, lds_itemlist.rowcount())
		if ll_found > 0 then
			messagebox("Item Validation", "Item with the same name already exists.~r~n" + "Kindly change the Item name.~r~nAlready existing Item details are:~r~n" + "Item Name = " + lds_itemlist.getitemstring(ll_found, "itemname") + "~r~n" + "Alias Name = " + lds_itemlist.getitemstring(ll_found, "fullcode"))
			return ::message.returnvalue
		end if
	else
		ls_itemname = parent.dw_master.getitemstring(ll_mastercurrrow, "name")
		ll_found = lds_itemlist.find("itemname='" + ls_itemname + "'", 1, lds_itemlist.rowcount())
		if ll_found > 0 then
			messagebox("Item Validation...", "Item with the same name already exists.~r~n" + "Kindly change the Item name.~r~nAlready existing Item details are:~r~n" + "Item Name = " + lds_itemlist.getitemstring(ll_found, "itemname") + "~r~n" + "Alias Name = " + lds_itemlist.getitemstring(ll_found, "fullcode"))
			return 1
		end if
	end if
	setpointer(hourglass!)
	if f_stringpreferences("AskUserPasswordInItem") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(::message.doubleparm)
		parent.setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		ll_invid = parent.dw_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			f_newtableid("item", ll_invid)
			parent.dw_master.object.code[ll_mastercurrrow] = ll_invid
			parent.dw_master.object.module[ll_mastercurrrow] = "Garments Wizard"
			parent.dw_master.object.changereason[ll_mastercurrrow] = "New Item"
		end if
		ls_aliasname = parent.dw_master.getitemstring(parent.dw_master.getrow(), "CustomICode")
		if isnull(ls_aliasname) then
			if parent.wf_duplicateitemno(string(ll_invid)) then
				messagebox("Item Alias Validation", "Auto Generated Item Alias Name " + string(ll_invid) + " already exists for some other item.~r~nPlease enter some other item alias name for this item and save again.", stopsign!)
				parent.dw_master.setfocus()
				parent.dw_master.setcolumn("customicode")
				if isnull(ll_pk) then
					parent.dw_master.object.code[1] = ll_null
				end if
				SQL rollback USING parent.it_transobject;
				return ::message.returnvalue
			else
				parent.dw_master.setitem(parent.dw_master.getrow(), "CustomICode", string(ll_invid))
			end if
		end if
		if isnull(parent.dw_master.object.regdno[1]) or parent.dw_master.object.regdno[1] = "" then
			parent.dw_master.object.regdno[1] = parent.dw_master.object.customicode[1] + "."
		end if
		if parent.wf_duplicate_regno(parent.dw_master.object.regdno[1]) > 0 then
			messagebox("Item Regd. No. Validation", "Item Regd. No. " + string(parent.dw_master.object.regdno[1]) + " already exists for some other item.~r~nPlease enter some other item regd. no. for this item and save again.", stopsign!)
			parent.dw_master.setfocus()
			parent.dw_master.setcolumn("regdno")
			if isnull(ll_pk) then
				parent.dw_master.object.code[1] = ll_null
			end if
			SQL rollback USING parent.it_transobject;
			return ::message.returnvalue
		end if
		if isnull(parent.dw_master.getitemnumber(ll_mastercurrrow, "packsalestax")) then
			parent.dw_master.setitem(ll_mastercurrrow, "packsalestax", 0)
		end if
		ls_aliasname = parent.dw_master.getitemstring(ll_mastercurrrow, "CustomICode")
		if isnull(ls_aliasname) then
			parent.dw_master.setitem(parent.dw_master.getrow(), "CustomICode", string(ll_invid))
		end if
		li_counter = 1
		if not parent.wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			setpointer(arrow!)
			return ::message.returnvalue
		end if
		if lb_modify then
			SQL rollback USING parent.it_transobject;
			parent.dw_master.object.module[ll_mastercurrrow] = "Garments Wizard"
			parent.dw_master.object.changereason[ll_mastercurrrow] = "Multiple Changes"
			if f_generateitemlog(parent.dw_master, "item_basicdata", parent.it_transobject, ldt_server_datetime) < 0 then
				messagebox("Database Problem", "Some Database Problem Occured generating Item Log!.~r~nReasons are:~r~n" + parent.it_transobject.sqlerrtext, stopsign!)
				SQL rollback USING parent.it_transobject;
				setpointer(arrow!)
				return ::message.returnvalue
			end if
			return
		end if
		parent.dw_master.setitem(li_counter, "usercode", ll_salesmancode)
		parent.dw_master.setitem(li_counter, "lastupdate", ldt_server_datetime)
		if parent.dw_master.update(true, false) < 0 then
			SQL rollback USING parent.it_transobject;
			setpointer(arrow!)
			return ::message.returnvalue
		else
			SQL commit USING parent.it_transobject;
			messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
			if lb_modify then
				parent.wf_insert_itemnotes(parent.dw_master.object.code[ll_mastercurrrow], 1)
			else
				parent.wf_insert_itemnotes(parent.dw_master.object.code[ll_mastercurrrow], 0)
			end if
			parent.dw_master.resetupdate()
			parent.dw_master.reset()
			parent.wf_newform()
			parent.ib_editflag = false
		end if
	else
		parent.setfocus()
	end if
	setpointer(arrow!)
	return ::message.returnvalue

// dw_master.getfocus() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	return ::message.returnvalue

// dw_master.itemchanged(long row, dwobject dwo, string data) returns long
	long ancestorreturnvalue
	integer li_retcode
	integer li_selected
	long ll_icode
	double ld_qty
	double ld_price
	double ld_discperc
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "customicode"
		if parent.wf_duplicatealiasname(data, this.object.code[row]) then
			messagebox("AliasName Validation", "Item AliasName Duplication Error~r~nPlease enter some other Item AliasName")
			li_retcode = 1
		end if
	case "name"
		if parent.wf_duplicatename(data, this.object.code[row]) then
			messagebox("Item Name Validation", "Item Name Duplication Error~r~nPlease enter some other Item Name")
			li_retcode = 1
		end if
	case "active"
		if integer(data) = 0 then
			ll_icode = getitemnumber(row, "code")
			SQL SELECT ISNULL ( sum ( currqty ) , 0 ) INTO :ld_qty FROM godowndetail WHERE icode =:ll_icode USING sqlca;
			if sqlca.sqlcode = -1 then
				messagebox("", "Database Error: Item information can not be retrieved")
				li_retcode = 1
			end if
			if ld_qty > 0.0 and li_retcode = 0 then
				li_selected = messagebox("Active", "Stock exist for this item~r~nYou Cann't Mark it InActive", question!, yesno!, 2)
				if li_selected = 1 then
					li_retcode = 0
				else
					li_retcode = 1
				end if
			end if
		end if
	case "saleprice"
		if long(data) >= 0 and not isnull(long(data)) then
			setitem(row, "discountedsaleprice", round(double(data) * (1.0 - getitemnumber(row, "salediscperc") * 0.01), 2))
		end if
	case "salediscperc"
		if long(data) >= 0 and not isnull(long(data)) then
			setitem(row, "discountedsaleprice", round(getitemnumber(row, "saleprice") * (1.0 - double(data) * 0.01), 2))
		end if
	case "purprice"
		if long(data) >= 0 and not isnull(long(data)) then
			setitem(row, "discountedpurprice", round(double(data) * (1.0 - getitemnumber(row, "purdiscperc") * 0.01), 2))
		end if
	case "purdiscperc"
		if long(data) >= 0 and not isnull(long(data)) then
			setitem(row, "discountedpurprice", round(getitemnumber(row, "purprice") * (1.0 - double(data) * 0.01), 2))
		end if
	case "discountedsaleprice"
		ld_price = getitemnumber(row, "saleprice")
		if ld_price = 0.0 then
			ld_price = 1
		end if
		if long(data) >= 0 and not isnull(long(data)) and long(data) <= ld_price then
			ld_discperc = (ld_price - double(data)) / ld_price * 100.0
			setitem(row, "salediscperc", ld_discperc)
		elseif long(data) < 0 then
			messagebox("Discounted Sale Price Validation!", "Negative Discounted Sale Price is not acceptable")
			return 1
		else
			messagebox("Discounted Sale Price Validation!", "Discounted Sale Price should not be greater than Sale Price")
			return 1
		end if
	case "discountedpurprice"
		ld_price = getitemnumber(row, "purprice")
		if ld_price = 0.0 then
			ld_price = 1
		end if
		if long(data) >= 0 and not isnull(long(data)) and long(data) <= ld_price then
			ld_discperc = (ld_price - double(data)) / ld_price * 100.0
			setitem(row, "purdiscperc", ld_discperc)
		elseif long(data) < 0 then
			messagebox("Discounted Purchase Price Validation!", "Negative Discounted Purchase Price is not acceptable")
			return 1
		else
			messagebox("Discounted Purchase Price Validation!", "Discounted Purchase Price should not be greater than Purchase Price")
			return 1
		end if
	case "iccode", "icatcode", "packcode", "manfcode", "location1", "remarks1", "location", "remarks", "packingdesc", "isizecode", "istylecode", "icolourcode", "isleevecode", "iyarncode", "ifabriccode", "ibrandcode", "itemyear", "remarksforpurchase", "sizedescription", "modeldescription", "typedescription", "genericcode", "itemdesigncode"
		return parent.wf_setitemname(dwo.name, data)
	end choose
	if li_retcode = 0 then
		parent.ib_editflag = true
	end if
	return li_retcode

// dw_master.itemerror(long row, dwobject dwo, string data) returns long
	long ancestorreturnvalue
	string ls_errormessage
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	ls_errormessage = "Please enter valid value "
	choose case dwo.name
	case "customicode"
		ls_errormessage = ls_errormessage + " for Item Alias Name"
	case "name"
		ls_errormessage = ls_errormessage + " for Item Name"
	case "saleprice"
		ls_errormessage = ls_errormessage + " for Item SalePrice 1"
	case "saleprice2"
		ls_errormessage = ls_errormessage + " for Item SalePrice 2"
	case "saleprice3"
		ls_errormessage = ls_errormessage + " for Item SalePrice 3"
	case "purprice"
		ls_errormessage = ls_errormessage + " for Item PurchasePrice"
	case "salediscperc"
		ls_errormessage = ls_errormessage + " for Item Sale Discount Percentage"
	case "purdiscperc"
		ls_errormessage = ls_errormessage + " for Item Purchase Discount Percentage"
	case "packsalestax"
		ls_errormessage = ls_errormessage + " for Item Pack SalesTax"
	case "gstperc1"
		ls_errormessage = ls_errormessage + " for Item SalesTax 1"
	case "gstperc2"
		ls_errormessage = ls_errormessage + " for Item SalesTax 2"
	case "reorderqty"
		ls_errormessage = ls_errormessage + " for Item Reorder Quantity"
	case "optimumqty"
		ls_errormessage = ls_errormessage + " for Item Optimum Quantity"
	case "packunits"
		ls_errormessage = ls_errormessage + " for Item Packing Cost"
	case "packingcost"
		ls_errormessage = ls_errormessage + " for Item Packing Cost"
	end choose
	ls_errormessage = ls_errormessage + " in row number " + string(row)
	messagebox("Item Validation", ls_errormessage)
	return 1

// dw_master.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	long ancestorreturnvalue
	integer li_movement
	long ll_row
	long ll_temp
	string sl_columnname
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyescape! then
		return 1
	elseif key = keyenter! then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	if ll_row > 0 and ll_row <= rowcount() then
		parent.il_selectedrow = ll_row
	end if
	return ::message.returnvalue

// dw_master.itemfocuschanged(long row, dwobject dwo) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	selecttext(1, len(gettext()))
	return ::message.returnvalue
