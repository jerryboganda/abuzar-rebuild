// window w_item_form_notes (multientryitemrespwin)  ancestor: window

// w_item_form_notes.ue_postopen() returns 0
	string ls_text
	long ll_icode
	blob lblob_notes
	u_transaction lt_transobject
	this.istr_arg = message.powerobjectparm
	ll_icode = this.istr_arg.l_code1
	this.il_mode = this.istr_arg.l_code2
	if this.il_mode = 0 then
		lt_transobject = create u_transaction
		lt_transobject.autocommit = true
		SQL start USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Connection Error", "Unable to connect to DataBase Server")
			post event ue_close(-1)
			return
		end if
		SQL SelectBlob Notes INTO :lblob_notes From ItemNotes Where Icode =:ll_icode USING lt_transobject;
		ls_text = string(lblob_notes)
		this.rte_control.set_displayonly(true)
		this.rte_control.set_popmenu(false)
		this.rte_control.set_toolbar(false)
	else
		ls_text = this.istr_arg.s_name1
	end if
	this.rte_control.pastertf(ls_text)
	this.rte_control.scroll(-1 * this.rte_control.linecount())

// w_item_form_notes.ue_close(integer ar_closearg) returns 0
	if ar_closearg = -1 then
		this.istr_arg.i_status = -1
	else
		this.istr_arg.i_status = 1
	end if
	closewithreturn(this, this.istr_arg)

// w_item_form_notes.create() returns 0
	this.cb_print = create cb_print
	this.cb_ok = create cb_ok
	this.cb_cancel = create cb_cancel
	this.rte_control = create rte_control
	this.control = {this.cb_print, this.cb_ok, this.cb_cancel, this.rte_control}

// w_item_form_notes.destroy() returns 0
	destroy this.cb_print
	destroy this.cb_ok
	destroy this.cb_cancel
	destroy this.rte_control

// w_item_form_notes.open() returns long
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	post event ue_postopen()
	return ::message.returnvalue

// w_item_form_notes.key(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		post event ue_close(-1)
	end if
	return ::message.returnvalue

// cb_print.clicked() returns long
	parent.rte_control.print(1, "", false, true)
	return ::message.returnvalue

// cb_ok.clicked() returns long
	string ls_text
	ls_text = parent.rte_control.copyrtf(false, detail!)
	parent.istr_arg.s_name1 = ls_text
	parent.post event ue_close(1)
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.post event ue_close(-1)
	return ::message.returnvalue

// rte_control.key(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		parent.post event ue_close(-1)
	end if
	return ::message.returnvalue
