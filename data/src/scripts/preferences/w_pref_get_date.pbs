// window w_pref_get_date (preferences)  ancestor: w_pref_get_text

// w_pref_get_date.of_getvalue() returns integer
	this.dw_pref.object.prefvalue_t.text = this.is_preference.caption
	this.dw_pref.object.prefvalue[1] = datetime(date(left(this.is_preference.value, 10)), time(right(this.is_preference.value, 8)))
	return 0

// w_pref_get_date.of_setvalue() returns long
	this.is_preference.value = string(this.dw_pref.object.prefvalue[1], "YYYY-MM-DD HH:MM:SS")
	this.is_preference.value2 = this.is_preference.value
	return 0

// w_pref_get_date.create() returns 0
	call super::create

// w_pref_get_date.destroy() returns 0
	call super::destroy
