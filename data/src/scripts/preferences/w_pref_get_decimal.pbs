// window w_pref_get_decimal (preferences)  ancestor: w_pref_get_text

// w_pref_get_decimal.of_getvalue() returns integer
	this.dw_pref.object.prefvalue_t.text = this.is_preference.caption
	this.dw_pref.object.prefvalue[1] = double(this.is_preference.value)
	this.dw_pref.object.prefvalue.editmask.mask = fill("#", this.is_preference.colwidth - 1) + "0.00"
	return 0

// w_pref_get_decimal.of_setvalue() returns long
	this.dw_pref.accepttext()
	this.is_preference.value = trim(string(this.dw_pref.object.prefvalue[1]))
	this.is_preference.value2 = this.is_preference.value
	return 0

// w_pref_get_decimal.create() returns 0 [event]
	call super::create

// w_pref_get_decimal.destroy() returns 0 [event]
	call super::destroy
