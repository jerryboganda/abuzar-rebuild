	this.tab_preferences.tabpage_schedule.dw_autoduesatisfy.settransobject(this.it_jobtransobject)
	this.tab_preferences.tabpage_schedule.dw_autoduesatisfy.retrieve(gs_autosatisfyduejob, gs_autosatisfyduejobschedule)
	SQL Select enabled INTO :li_enabled From SysJobs Where Name =:gs_autosatisfyduejob USING this.it_jobtransobject;
	if this.it_jobtransobject.sqlcode = 0 then
		if li_enabled = 1 then
			this.tab_preferences.tabpage_schedule.cbx_autoduesatisfy.checked = true
			if this.tab_preferences.tabpage_schedule.dw_autoduesatisfy.rowcount() > 0 then
				if this.tab_preferences.tabpage_schedule.dw_autoduesatisfy.getitemnumber(1, "unit") = 1.0 then
					this.tab_preferences.tabpage_schedule.rb_autoduesatisfy_once.checked = true
					this.tab_preferences.tabpage_schedule.rb_autoduesatisfy_every.checked = false
					ls_jobstarttime = string(this.tab_preferences.tabpage_schedule.dw_autoduesatisfy.getitemnumber(1, "occurancetime"))
					li_backuphr = integer(left(ls_jobstarttime, len(ls_jobstarttime) - 4))
					ls_hold = left(right(ls_jobstarttime, 4), len(right(ls_jobstarttime, 4)) - 2)
					if isnull(ls_hold) or ls_hold = "" then
						ls_hold = "00"
					elseif len(ls_hold) = 1 then
						ls_hold = "0" + ls_hold
					end if
					this.tab_preferences.tabpage_schedule.ddlb_autoduesatisfymin.selectitem(ls_hold, 0)
					ls_hold = right(ls_jobstarttime, 2)
					if isnull(ls_hold) or ls_hold = "" then
						ls_hold = "00"
					elseif len(ls_hold) = 1 then
						ls_hold = "0" + ls_hold
					end if
					this.tab_preferences.tabpage_schedule.ddlb_autoduesatisfysec.selectitem(ls_hold, 0)
					if li_backuphr > 12 then
						this.tab_preferences.tabpage_schedule.ddlb_autoduesatisfyhr.selectitem(string(li_backuphr - 12), 0)
						this.tab_preferences.tabpage_schedule.ddlb_autoduesatisfytime.selectitem("PM", 0)
					elseif li_backuphr = 12 then
						this.tab_preferences.tabpage_schedule.ddlb_autoduesatisfyhr.selectitem("12", 0)
						this.tab_preferences.tabpage_schedule.ddlb_autoduesatisfytime.selectitem("PM", 0)
					else
						if isnull(li_backuphr) or li_backuphr = 0 then
							this.tab_preferences.tabpage_schedule.ddlb_autoduesatisfyhr.selectitem("12", 0)
						else
							this.tab_preferences.tabpage_schedule.ddlb_autoduesatisfyhr.selectitem(string(li_backuphr), 0)
						end if
						this.tab_preferences.tabpage_schedule.ddlb_autoduesatisfytime.selectitem("AM", 0)
					end if
					this.tab_preferences.tabpage_schedule.dw_autoduesatisfy.enabled = false
				else
					this.tab_preferences.tabpage_schedule.rb_autoduesatisfy_every.checked = true
					this.tab_preferences.tabpage_schedule.rb_autoduesatisfy_every.visible = true
					this.tab_preferences.tabpage_schedule.rb_autoduesatisfy_once.checked = false
					this.tab_preferences.tabpage_schedule.dw_autoduesatisfy.enabled = true
					this.tab_preferences.tabpage_schedule.ddlb_autoduesatisfyhr.enabled = false
					this.tab_preferences.tabpage_schedule.ddlb_autoduesatisfymin.enabled = false
					this.tab_preferences.tabpage_schedule.ddlb_autoduesatisfysec.enabled = false
					this.tab_preferences.tabpage_schedule.ddlb_autoduesatisfytime.enabled = false
				end if
			end if
		else
			this.tab_preferences.tabpage_schedule.cbx_inpatientrecurringservices.checked = false
			this.tab_preferences.tabpage_schedule.rb_inpatient_svc_once.enabled = false
			this.tab_preferences.tabpage_schedule.rb_inpatient_svc_every.enabled = false
			this.tab_preferences.tabpage_schedule.dw_inpatientrecurringservice.enabled = false
			this.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicehr.enabled = false
			this.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicemin.enabled = false
			this.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicesec.enabled = false
