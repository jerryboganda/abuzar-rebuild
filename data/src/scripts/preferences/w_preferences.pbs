// window w_preferences (preferences)  ancestor: window

// w_preferences.wf_assigndatawindowchild(ref datawindow adw_parent, ref datawindowchild adwc_child) returns long
	long ll_rtcode
	ll_rtcode = adw_parent.getchild("acccode", adwc_child)
	if ll_rtcode <> -1 then
		adwc_child.settransobject(sqlca)
		adwc_child.retrieve(f_getglobalcode("GT_CashSub"))
	end if
	return ll_rtcode

// w_preferences.wf_insertandscrollto(datawindow adw_dw) returns 0
	adw_dw.insertrow(0)
	adw_dw.scrolltorow(0)

// w_preferences.wf_showerrmessage(long al_rtcode) returns 0
	if al_rtcode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
	end if

// w_preferences.wf_updatesigfile() returns integer
	integer fh
	integer ll_found
	u_transaction it_transobject
	blob lblob_holdimg
	string ls_sigfile
	if this.ib_issigfilechanged then
		ll_found = this.id_sale.find("lower(name) = lower('SigOnSaleInvImg') ", 1, this.id_sale.rowcount())
		if ll_found > 0 then
			ls_sigfile = this.id_sale.object.prefvalue[ll_found]
		end if
		if trim(ls_sigfile) = "" or isnull(ls_sigfile) then
			messagebox("Image File Validation In Sales Tab", "Kindly specify the signature image file.")
			return -1
		end if
		if fileexists(ls_sigfile) then
			fh = fileopen(ls_sigfile, streammode!)
			if fh <> -1 then
				fileread(fh, lblob_holdimg)
				fileclose(fh)
				it_transobject = create u_transaction
				it_transobject.autocommit = true
				SQL start USING it_transobject;
				SQL UpdateBlob SoftwarePreferences Set PrefImage =:lblob_holdimg Where Name ='SigOnSaleInvImg' USING it_transobject;
				if it_transobject.sqlnrows > 0 then
					SQL commit USING it_transobject;
				else
					SQL rollback USING it_transobject;
					messagebox("Image File Validation In Sales Tab", "Unable to load image data into database from the specified file.")
					return -1
				end if
				SQL stop USING it_transobject;
				destroy it_transobject
			else
				messagebox("Image File Validation In Sales Tab", "Unable to load image data from the specified file.")
				return -1
			end if
		else
			messagebox("Image File Validation In Sales Tab", "File does not exist on the path you specified for SaleInv. Signature.")
			return -1
		end if
	else
		return 0
	end if
	return 1

// w_preferences.wf_assigndatawindow(ref datawindow adw_source, ref datawindow adw_target) returns 0
	adw_target = adw_source
	adw_target.settransobject(sqlca)

