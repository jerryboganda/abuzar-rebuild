// w_preferences.wf_executetask(datawindow adw_object, long al_row) returns long
	s_preference ls_pref
	adw_object.setrow(al_row)
	adw_object.scrolltorow(al_row)
	this.is_preference.id = adw_object.object.prefid[al_row]
	this.is_preference.name = adw_object.object.name[al_row]
	this.is_preference.caption = adw_object.object.caption[al_row]
	this.is_preference.datatype = adw_object.object.prefdatatype[al_row]
	this.is_preference.value = adw_object.object.prefvalue[al_row]
	this.is_preference.value2 = adw_object.object.prefvalue2[al_row]
	this.is_preference.subcatcode = adw_object.object.subcatcode[al_row]
	this.is_preference.colwidth = adw_object.object.colwidth[al_row]
	this.is_preference.decimal = adw_object.object.decimals[al_row]
	this.is_preference.userobject = adw_object.object.usedobject[al_row]
	this.is_preference.visible = adw_object.object.visible[al_row]
	this.is_preference.assocprefname = adw_object.object.assocprefname[al_row]
	this.is_preference.assocrightcode = adw_object.object.assocrightcode[al_row]
	f_get_preference_local(adw_object, this.is_preference.assocprefname, this.is_preference.assocprefvalue)
	ls_pref = this.is_preference
	if lower(left(this.is_preference.userobject, 1)) = "w" then
		choose case this.is_preference.userobject
		case "w_pref_get_text"
			openwithparm(w_pref_get_text, ls_pref)
		case "w_pref_get_text2"
			openwithparm(w_pref_get_text2, ls_pref)
		case "w_pref_get_datetime"
			openwithparm(w_pref_get_datetime, ls_pref)
		case "w_pref_get_date"
			openwithparm(w_pref_get_date, ls_pref)
		case "w_pref_get_long"
			openwithparm(w_pref_get_long, ls_pref)
		case "w_pref_get_decimal"
			openwithparm(w_pref_get_decimal, ls_pref)
		case "w_pref_get_password"
			openwithparm(w_pref_get_password, ls_pref)
		end choose
	elseif lower(left(this.is_preference.userobject, 1)) = "d" then
		openwithparm(w_pref_get_dropdown, ls_pref)
	elseif this.is_preference.userobject = "imagefiledialog" then
		wf_select_image_file()
	elseif this.is_preference.userobject = "filedirectorydialog" then
		wf_select_filedirectory()
	end if
	if lower(left(this.is_preference.userobject, 1)) = "d" or lower(left(this.is_preference.userobject, 1)) = "w" then
		ls_pref = message.powerobjectparm
		if ls_pref.status then
			this.is_preference = ls_pref
			adw_object.object.prefvalue[al_row] = this.is_preference.value
			adw_object.object.prefvalue2[al_row] = this.is_preference.value2
		end if
	else
		this.is_preference.value = adw_object.object.prefvalue[al_row]
		this.is_preference.value2 = adw_object.object.prefvalue2[al_row]
	end if
	return 0

// w_preferences.wf_select_image_file() returns long
	integer fh
	integer ret
	string ls_sigfile
	string ls_sigfilename
	string ls_defaultext = "JPEG"
	string ls_temp
	string ls_sigfilefilter = "JPEG Files (*.jpg), *.jpg"
	ls_temp = this.id_sale.object.prefvalue[this.id_sale.getrow()]
	ls_sigfile = left(ls_temp, len(ls_temp) - pos(reverse(ls_temp), "\") + 1)
	ls_sigfilename = mid(ls_temp, len(ls_temp) - pos(reverse(ls_temp), "\") + 2)
	ret = getfileopenname("Select File", ls_sigfile, ls_sigfilename, ls_defaultext, ls_sigfilefilter, ls_temp)
	if ret = 1 then
		this.id_sale.object.prefvalue[this.id_sale.getrow()] = ls_sigfile
		this.id_sale.object.prefvalue2[this.id_sale.getrow()] = ls_sigfile
		this.ib_issigfilechanged = true
	end if
	return 0

// w_preferences.wf_select_filedirectory() returns long
	string ls_docname
	string ls_named
	string ls_path
	integer li_value
	ls_path = this.id_otherpref.object.prefvalue[this.id_otherpref.getrow()]
	li_value = getfileopenname("Select File Location", ls_docname, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*", ls_path)
	if li_value = 1 then
		ls_path = left(ls_docname, len(ls_docname) - pos(reverse(ls_docname), "\") + 1)
		this.id_otherpref.object.prefvalue[this.id_otherpref.getrow()] = ls_path
		this.id_otherpref.object.prefvalue2[this.id_otherpref.getrow()] = ls_path
	end if
	return 0

// w_preferences.wf_update_preference(string as_prefname, string as_value) returns long
	long ll_found
	string ls_prefname
	ls_prefname = lower(as_prefname)
	ll_found = this.dw_hidden.find("lower(name) = '" + ls_prefname + "'", 1, this.dw_hidden.rowcount())
	if ll_found > 0 and ll_found <= this.dw_hidden.rowcount() then
		this.dw_hidden.object.prefvalue[ll_found] = trim(as_value)
		this.dw_hidden.object.prefvalue2[ll_found] = trim(as_value)
	end if
	return 0

// w_preferences.wf_set_interface_adjustments() returns 0
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width * 0.80
		ll_height = ll_win_height * 0.90
		this.width = ll_width
		this.height = ll_height
		this.cb_ok.y = ll_height - this.cb_ok.height - 120
		this.cb_cancel.y = ll_height - this.cb_cancel.height - 120
		this.tab_preferences.width = ll_width * 0.98
		this.tab_preferences.height = this.cb_ok.y - 50
