	this.it_jobtransobject.autocommit = true
	this.it_jobtransobject.dbparm = "PROVIDER='SQLOLEDB',DATASOURCE='" + gs_servername + "',CommitOnDisconnect='No',PROVIDERSTRING='DataBase=MSDB" + ";APP=" + gs_app + ";WSID=" + gs_localcomputername + "',PBTrimCharColumns='Yes',StripParmNames='Yes'"
	SQL start USING this.it_jobtransobject;
	this.tab_preferences.tabpage_schedule.dw_backupschedule.settransobject(this.it_jobtransobject)
	this.tab_preferences.tabpage_schedule.dw_backupschedule.retrieve(gs_clientjob, gs_clientjobschedule)
	SQL Select enabled INTO :li_enabled From SysJobs Where Name =:gs_clientjob USING this.it_jobtransobject;
	if this.it_jobtransobject.sqlcode = 0 then
		if li_enabled = 1 then
			this.tab_preferences.tabpage_schedule.cbx_activateautobackup.checked = true
			if this.tab_preferences.tabpage_schedule.dw_backupschedule.rowcount() > 0 then
				if this.tab_preferences.tabpage_schedule.dw_backupschedule.getitemnumber(1, "unit") = 1.0 then
					this.tab_preferences.tabpage_schedule.rb_backuponce.checked = true
					ls_jobstarttime = string(this.tab_preferences.tabpage_schedule.dw_backupschedule.getitemnumber(1, "occurancetime"))
					li_backuphr = integer(left(ls_jobstarttime, len(ls_jobstarttime) - 4))
					ls_hold = left(right(ls_jobstarttime, 4), len(right(ls_jobstarttime, 4)) - 2)
					if isnull(ls_hold) or ls_hold = "" then
						ls_hold = "00"
					elseif len(ls_hold) = 1 then
						ls_hold = "0" + ls_hold
					end if
					this.tab_preferences.tabpage_schedule.ddlb_backupmin.selectitem(ls_hold, 0)
					ls_hold = right(ls_jobstarttime, 2)
					if isnull(ls_hold) or ls_hold = "" then
						ls_hold = "00"
					elseif len(ls_hold) = 1 then
						ls_hold = "0" + ls_hold
					end if
					this.tab_preferences.tabpage_schedule.ddlb_backupsec.selectitem(ls_hold, 0)
					if li_backuphr > 12 then
						this.tab_preferences.tabpage_schedule.ddlb_backuphr.selectitem(string(li_backuphr - 12), 0)
						this.tab_preferences.tabpage_schedule.ddlb_backuptime.selectitem("PM", 0)
					elseif li_backuphr = 12 then
						this.tab_preferences.tabpage_schedule.ddlb_backuphr.selectitem("12", 0)
						this.tab_preferences.tabpage_schedule.ddlb_backuptime.selectitem("PM", 0)
					else
						if isnull(li_backuphr) or li_backuphr = 0 then
							this.tab_preferences.tabpage_schedule.ddlb_backuphr.selectitem("12", 0)
						else
							this.tab_preferences.tabpage_schedule.ddlb_backuphr.selectitem(string(li_backuphr), 0)
						end if
						this.tab_preferences.tabpage_schedule.ddlb_backuptime.selectitem("AM", 0)
					end if
					this.tab_preferences.tabpage_schedule.dw_backupschedule.enabled = false
				else
					this.tab_preferences.tabpage_schedule.rb_backupevery.checked = true
					this.tab_preferences.tabpage_schedule.ddlb_backuphr.enabled = false
					this.tab_preferences.tabpage_schedule.ddlb_backupmin.enabled = false
					this.tab_preferences.tabpage_schedule.ddlb_backupsec.enabled = false
					this.tab_preferences.tabpage_schedule.ddlb_backuptime.enabled = false
				end if
			end if
		else
			this.tab_preferences.tabpage_schedule.cbx_activateautobackup.checked = false
			this.tab_preferences.tabpage_schedule.rb_backupevery.enabled = false
			this.tab_preferences.tabpage_schedule.dw_backupschedule.enabled = false
			this.tab_preferences.tabpage_schedule.rb_backuponce.enabled = false
			this.tab_preferences.tabpage_schedule.ddlb_backuphr.enabled = false
			this.tab_preferences.tabpage_schedule.ddlb_backupmin.enabled = false
			this.tab_preferences.tabpage_schedule.ddlb_backupsec.enabled = false
			this.tab_preferences.tabpage_schedule.ddlb_backuptime.enabled = false
		end if
	else
		messagebox("Job", "Unable to fetch backup job status.")
	end if
	this.tab_preferences.tabpage_schedule.dw_autocashsalepostingschedule.settransobject(this.it_jobtransobject)
	this.tab_preferences.tabpage_schedule.dw_autocashsalepostingschedule.retrieve(gs_autocashsalepostingjob, gs_autocashsalepostingjobschedule)
	SQL Select enabled INTO :li_enabled From SysJobs Where Name =:gs_autocashsalepostingjob USING this.it_jobtransobject;
	if this.it_jobtransobject.sqlcode = 0 then
		this.tab_preferences.tabpage_schedule.em_autocashsalepostingtime.text = trim(string(f_numberpreferences("cashsaleautopostingtime")))
		if li_enabled = 1 then
			this.tab_preferences.tabpage_schedule.cbx_activateautocashsaleposting.checked = true
		else
			this.tab_preferences.tabpage_schedule.cbx_activateautocashsaleposting.checked = false
			this.tab_preferences.tabpage_schedule.em_autocashsalepostingtime.enabled = false
			this.tab_preferences.tabpage_schedule.dw_autocashsalepostingschedule.enabled = false
			this.tab_preferences.tabpage_schedule.em_autocashsalepostingtime.enabled = false
		end if
	else
		messagebox("Job", "Unable to fetch cash sale posting job status.")
	end if
	this.tab_preferences.tabpage_schedule.dw_autocreditsalepostingschedule.settransobject(this.it_jobtransobject)
	this.tab_preferences.tabpage_schedule.dw_autocreditsalepostingschedule.retrieve(gs_autocreditsalepostingjob, gs_autocreditsalepostingjobschedule)
	SQL Select enabled INTO :li_enabled From SysJobs Where Name =:gs_autocreditsalepostingjob USING this.it_jobtransobject;
	if this.it_jobtransobject.sqlcode = 0 then
		this.tab_preferences.tabpage_schedule.em_autocreditsalepostingtime.text = trim(string(f_numberpreferences("creditsaleautopostingtime")))
		if li_enabled = 1 then
			this.tab_preferences.tabpage_schedule.cbx_activateautocreditsaleposting.checked = true
		else
			this.tab_preferences.tabpage_schedule.cbx_activateautocreditsaleposting.checked = false
			this.tab_preferences.tabpage_schedule.em_autocreditsalepostingtime.enabled = false
			this.tab_preferences.tabpage_schedule.dw_autocreditsalepostingschedule.enabled = false
		end if
	else
		messagebox("Job", "Unable to fetch credit sale posting job status.")
	end if
	this.tab_preferences.tabpage_schedule.dw_inpatientrecurringservice.settransobject(this.it_jobtransobject)
	this.tab_preferences.tabpage_schedule.dw_inpatientrecurringservice.retrieve(gs_autoinpatientservicesjob, gs_autoinpatientservicesjobschedule)
	SQL Select enabled INTO :li_enabled From SysJobs Where Name =:gs_autoinpatientservicesjob USING this.it_jobtransobject;
	if this.it_jobtransobject.sqlcode = 0 then
		if li_enabled = 1 then
			this.tab_preferences.tabpage_schedule.cbx_inpatientrecurringservices.checked = true
			if this.tab_preferences.tabpage_schedule.dw_inpatientrecurringservice.rowcount() > 0 then
				if this.tab_preferences.tabpage_schedule.dw_inpatientrecurringservice.getitemnumber(1, "unit") = 1.0 then
					this.tab_preferences.tabpage_schedule.rb_inpatient_svc_once.checked = true
					this.tab_preferences.tabpage_schedule.rb_inpatient_svc_every.checked = false
					ls_jobstarttime = string(this.tab_preferences.tabpage_schedule.dw_inpatientrecurringservice.getitemnumber(1, "occurancetime"))
					li_backuphr = integer(left(ls_jobstarttime, len(ls_jobstarttime) - 4))
					ls_hold = left(right(ls_jobstarttime, 4), len(right(ls_jobstarttime, 4)) - 2)
					if isnull(ls_hold) or ls_hold = "" then
						ls_hold = "00"
					elseif len(ls_hold) = 1 then
						ls_hold = "0" + ls_hold
					end if
					this.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicemin.selectitem(ls_hold, 0)
					ls_hold = right(ls_jobstarttime, 2)
					if isnull(ls_hold) or ls_hold = "" then
						ls_hold = "00"
					elseif len(ls_hold) = 1 then
						ls_hold = "0" + ls_hold
					end if
					this.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicesec.selectitem(ls_hold, 0)
					if li_backuphr > 12 then
						this.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicehr.selectitem(string(li_backuphr - 12), 0)
						this.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicetime.selectitem("PM", 0)
					elseif li_backuphr = 12 then
						this.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicehr.selectitem("12", 0)
						this.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicetime.selectitem("PM", 0)
					else
						if isnull(li_backuphr) or li_backuphr = 0 then
							this.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicehr.selectitem("12", 0)
						else
							this.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicehr.selectitem(string(li_backuphr), 0)
						end if
						this.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicetime.selectitem("AM", 0)
					end if
