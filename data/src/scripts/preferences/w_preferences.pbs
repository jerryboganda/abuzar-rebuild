		messagebox("Job", "Unable to fetch backup job status.")
	end if
	return ::message.returnvalue

// w_preferences.systemkey(keycode key, unsignedlong keyflags) returns long [event]
	long ll_retcode = 1
	if keyflags = 1 then
		if key = keyh! then
			open(w_startuprightsmodification_key)
			if message.doubleparm = -1.0 or message.doubleparm = 0.0 then
				return -1
			end if
			this.tab_preferences.tabpage_system.visible = true
			this.tab_preferences.tabpage_system.enabled = true
			this.tab_preferences.tabpage_system.setfocus()
			this.tab_preferences.tabpage_system.dw_system.setfocus()
		end if
		if key = keyt! then
			open(w_startuprightsmodification_key)
			if message.doubleparm = -1.0 or message.doubleparm = 0.0 then
				return -1
			else
				open(w_transferabledata)
			end if
		end if
		if key = keys! and this.tab_preferences.selectedtab = 4 then
			f_startup_rightsmodification()
		end if
		if key = keyf! then
			if f_stringpreferences("MarkInitialized") = "N" then
				open(w_startuprightsmodification_key)
				if message.doubleparm = -1.0 or message.doubleparm = 0.0 then
					return -1
				elseif sqlca.initialize_tabmaxkey() = 0 then
					SQL commit USING sqlca;
					messagebox("Successful Invokation", "Application Counters successfully updated.", information!)
				else
					SQL rollback USING sqlca;
					messagebox("Un-Successful Invokation", "Application Counters failed to be successfully updated.", information!)
				end if
			else
				messagebox("Application Counters Check", "Application Counters cannot be updated because this version is already initialized.~r~nDoing so on Initialized Version might have serious outcomes", information!)
			end if
		end if
		if key = keyg! then
			open(w_startuprightsmodification_key)
			if message.doubleparm = -1.0 or message.doubleparm = 0.0 then
				return -1
			elseif sqlca.godowndetail_repairforzerodecimal() = 0 then
				SQL commit USING sqlca;
				messagebox("Successful Invokation", "Godown Stock Check successfully done.", information!)
			else
				SQL rollback USING sqlca;
				messagebox("Un-Successful Invokation", "Godown Stock Check failed to be successfully updated.", information!)
			end if
		end if
		if key = keyb! and gc_dropbox = "Y" then
			open(w_startuprightsmodification_key)
			if message.doubleparm = -1.0 or message.doubleparm = 0.0 then
				return -1
			else
				openwithparm(w_module_password, 1)
				ll_retcode = message.doubleparm
				if ll_retcode = 1 then
					open(w_site_update)
				end if
			end if
		end if
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_cancel.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return 1

// cb_cancel.clicked() returns long [event]
	close(parent)
	return ::message.returnvalue

// cb_ok.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return 1

