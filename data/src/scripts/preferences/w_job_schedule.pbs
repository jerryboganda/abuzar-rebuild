	ls_jobname = gs_stockverificationjob
	ls_schedulename = gs_stockverificationjobschedule
	if this.tab_preferences.tabpage_stock.cbx_activatestkver.checked = true then
		if this.tab_preferences.tabpage_stock.rb_oncestkver.checked = true then
			ls_hr = this.tab_preferences.tabpage_stock.ddlb_hrstkver.text
			ls_min = this.tab_preferences.tabpage_stock.ddlb_minstkver.text
			ls_sec = this.tab_preferences.tabpage_stock.ddlb_secstkver.text
			ls_ampm = this.tab_preferences.tabpage_stock.ddlb_timestkver.text
			if isnull(ls_hr) or ls_hr = "" or ls_hr = "none" then
				messagebox("Stock Ledger Time Validation", "Please select hours from dropdown box.")
				this.tab_preferences.tabpage_stock.ddlb_hrstkver.setfocus()
				return -1
			elseif isnull(ls_min) or ls_min = "" or ls_min = "none" then
				messagebox("Stock Ledger Time Validation", "Please select minutes from dropdown box.")
				this.tab_preferences.tabpage_stock.ddlb_minstkver.setfocus()
				return -1
			elseif isnull(ls_sec) or ls_sec = "" or ls_sec = "none" then
				messagebox("Stock Ledger Time Validation", "Please select seconds from dropdown box.")
				this.tab_preferences.tabpage_stock.ddlb_secstkver.setfocus()
				return -1
			elseif isnull(ls_ampm) or ls_ampm = "" or ls_ampm = "none" then
				messagebox("Stock Ledger Time Validation", "Please select AM/PM from dropdown box.")
				this.tab_preferences.tabpage_stock.ddlb_timestkver.setfocus()
				return -1
			end if
			li_hr = integer(ls_hr)
			if ls_ampm = "PM" then
				if li_hr < 12 then
					li_hr = li_hr + 12
				end if
			elseif li_hr = 12 then
				li_hr = 0
			end if
			ls_activetime = string(li_hr) + ls_min + ls_sec
			ll_activetime = long(ls_activetime)
			li_unit = 1
			li_unitvalue = 0
		else
			if this.tab_preferences.tabpage_stock.dw_stkver.accepttext() = 1 then
				li_unitvalue = this.tab_preferences.tabpage_stock.dw_stkver.getitemnumber(1, "unitvalue")
				li_unit = this.tab_preferences.tabpage_stock.dw_stkver.getitemnumber(1, "unit")
				if li_unit = 4 then
					if not (li_unitvalue >= 1 and li_unitvalue <= 1440) then
						messagebox("Stock Ledger Time Validation", "Please enter valid value for minutes between 1 and 1440.")
						this.tab_preferences.tabpage_stock.dw_stkver.setcolumn(1)
						this.tab_preferences.tabpage_stock.dw_stkver.setfocus()
						return -1
					end if
				elseif li_unit = 8 then
					if not (li_unitvalue >= 1 and li_unitvalue <= 24) then
						messagebox("Stock Ledger Time Validation", "Please enter valid value for hours between 1 and 24.")
						this.tab_preferences.tabpage_stock.dw_stkver.setcolumn(2)
						this.tab_preferences.tabpage_stock.dw_stkver.setfocus()
						return -1
					end if
				else
					messagebox("Stock Ledger Time Validation", "Please select minutes/hours from dropdown list box")
					this.tab_preferences.tabpage_stock.dw_stkver.setcolumn(2)
					this.tab_preferences.tabpage_stock.dw_stkver.setfocus()
					return -1
				end if
			else
				messagebox("Stock Ledger Time Validation", "Please enter valid value for a unit.")
				this.tab_preferences.tabpage_stock.dw_stkver.setcolumn(1)
				this.tab_preferences.tabpage_stock.dw_stkver.setfocus()
				return -1
			end if
			ll_activetime = 0
		end if
		sqlca.adjustjobschedule(ls_jobname, ls_schedulename, ll_activetime, li_unit, li_unitvalue)
		sqlca.activatejob(ls_jobname, 1)
	else
		sqlca.activatejob(ls_jobname, 0)
	end if
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
		return 0
	end if
	SQL rollback USING sqlca;
	messagebox("Job Error", "Unable to update credit sale posting job status.")
	setpointer(arrow!)
	return -1

