// w_job_schedule.wf_open_autobackupclientjob() returns long
	long ll_counter
	long ll_pos
	long ll_rtcode
	long ll_found
	string ls_jobstarttime
	string ls_hold
	string ls_clientjob
	string ls_clientjobschedule
	integer li_autopurgesaleshr
	integer li_backuphr
	integer li_enabled
	ls_clientjob = gs_clientjob
	ls_clientjobschedule = gs_clientjobschedule
	this.tab_preferences.tabpage_backup.dw_backupschedule.settransobject(this.it_jobtransobject)
	this.tab_preferences.tabpage_backup.dw_backupschedule.retrieve(ls_clientjob, ls_clientjobschedule)
	SQL Select enabled INTO :li_enabled From SysJobs Where Name =:ls_clientjob USING this.it_jobtransobject;
	if this.it_jobtransobject.sqlcode = 0 then
		if li_enabled = 1 then
			this.tab_preferences.tabpage_backup.cbx_activateautobackup.checked = true
			if this.tab_preferences.tabpage_backup.dw_backupschedule.getitemnumber(1, "unit") = 1.0 then
				this.tab_preferences.tabpage_backup.rb_backuponce.checked = true
				ls_jobstarttime = string(this.tab_preferences.tabpage_backup.dw_backupschedule.getitemnumber(1, "occurancetime"))
				li_backuphr = integer(left(ls_jobstarttime, len(ls_jobstarttime) - 4))
				ls_hold = left(right(ls_jobstarttime, 4), len(right(ls_jobstarttime, 4)) - 2)
				if isnull(ls_hold) or ls_hold = "" then
					ls_hold = "00"
				elseif len(ls_hold) = 1 then
					ls_hold = "0" + ls_hold
				end if
				this.tab_preferences.tabpage_backup.ddlb_backupmin.selectitem(ls_hold, 0)
				ls_hold = right(ls_jobstarttime, 2)
				if isnull(ls_hold) or ls_hold = "" then
					ls_hold = "00"
				elseif len(ls_hold) = 1 then
					ls_hold = "0" + ls_hold
				end if
				this.tab_preferences.tabpage_backup.ddlb_backupsec.selectitem(ls_hold, 0)
				if li_backuphr > 12 then
					this.tab_preferences.tabpage_backup.ddlb_backuphr.selectitem(string(li_backuphr - 12), 0)
					this.tab_preferences.tabpage_backup.ddlb_backuptime.selectitem("PM", 0)
				elseif li_backuphr = 12 then
					this.tab_preferences.tabpage_backup.ddlb_backuphr.selectitem("12", 0)
					this.tab_preferences.tabpage_backup.ddlb_backuptime.selectitem("PM", 0)
				else
					if isnull(li_backuphr) or li_backuphr = 0 then
						this.tab_preferences.tabpage_backup.ddlb_backuphr.selectitem("12", 0)
					else
						this.tab_preferences.tabpage_backup.ddlb_backuphr.selectitem(string(li_backuphr), 0)
					end if
					this.tab_preferences.tabpage_backup.ddlb_backuptime.selectitem("AM", 0)
				end if
				this.tab_preferences.tabpage_backup.dw_backupschedule.enabled = false
			else
				this.tab_preferences.tabpage_backup.rb_backupevery.checked = true
				this.tab_preferences.tabpage_backup.ddlb_backuphr.enabled = false
				this.tab_preferences.tabpage_backup.ddlb_backupmin.enabled = false
				this.tab_preferences.tabpage_backup.ddlb_backupsec.enabled = false
				this.tab_preferences.tabpage_backup.ddlb_backuptime.enabled = false
			end if
		else
			this.tab_preferences.tabpage_backup.cbx_activateautobackup.checked = false
			this.tab_preferences.tabpage_backup.rb_backupevery.enabled = false
			this.tab_preferences.tabpage_backup.dw_backupschedule.enabled = false
			this.tab_preferences.tabpage_backup.rb_backuponce.enabled = false
			this.tab_preferences.tabpage_backup.ddlb_backuphr.enabled = false
			this.tab_preferences.tabpage_backup.ddlb_backupmin.enabled = false
			this.tab_preferences.tabpage_backup.ddlb_backupsec.enabled = false
			this.tab_preferences.tabpage_backup.ddlb_backuptime.enabled = false
		end if
	else
		messagebox("Job", "Unable to fetch auto client backup job status.")
	end if
	return 0

