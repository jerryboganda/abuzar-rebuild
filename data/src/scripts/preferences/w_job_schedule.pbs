						messagebox("Stock Report Time Validation", "Please enter valid value for hours between 1 and 24.")
						this.tab_preferences.tabpage_stock.dw_stockreport.setcolumn(2)
						this.tab_preferences.tabpage_stock.dw_stockreport.setfocus()
						return -1
					end if
				else
					messagebox("Stock Report Time Validation", "Please select minutes/hours from dropdown list box")
					this.tab_preferences.tabpage_stock.dw_stockreport.setcolumn(2)
					this.tab_preferences.tabpage_stock.dw_stockreport.setfocus()
					return -1
