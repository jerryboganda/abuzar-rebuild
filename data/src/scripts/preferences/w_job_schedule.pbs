		elseif isnull(ls_min) or ls_min = "" or ls_min = "none" then
			messagebox("Time Validation", "Please select minutes from dropdown box.")
			this.tab_preferences.tabpage_guest.ddlb_guestcheckinservicemin.setfocus()
			return -1
