// w_job_schedule.wf_autopatientrecservicesjob() returns long
	string ls_jobname
	string ls_schedulename
	string ls_hr
	string ls_min
	string ls_sec
	string ls_ampm
	string ls_activetime
	integer li_hr
	integer li_min
	integer li_sec
	integer li_unit
	integer li_unitvalue
	long ll_activetime
	if not f_rightexists(368) then
		return 0
	end if
	ls_jobname = gs_autopatientrecservice
	ls_schedulename = gs_autopatientrecserviceschedule
	if this.tab_preferences.tabpage_patient.cbx_patientrecurringservices.checked = true then
		if this.tab_preferences.tabpage_patient.rb_patient_svc_once.checked = true then
			ls_hr = this.tab_preferences.tabpage_patient.ddlb_patientrecurringservicehr.text
			ls_min = this.tab_preferences.tabpage_patient.ddlb_patientrecurringservicemin.text
			ls_sec = this.tab_preferences.tabpage_patient.ddlb_patientrecurringservicesec.text
			ls_ampm = this.tab_preferences.tabpage_patient.ddlb_patientrecurringservicetime.text
			if isnull(ls_hr) or ls_hr = "" or ls_hr = "none" then
				messagebox("BackUp Time Validation", "Please select hours from dropdown box.")
				this.tab_preferences.tabpage_patient.ddlb_patientrecurringservicehr.setfocus()
				return -1
			elseif isnull(ls_min) or ls_min = "" or ls_min = "none" then
				messagebox("BackUp Time Validation", "Please select minutes from dropdown box.")
				this.tab_preferences.tabpage_patient.ddlb_patientrecurringservicemin.setfocus()
				return -1
			elseif isnull(ls_sec) or ls_sec = "" or ls_sec = "none" then
				messagebox("BackUp Time Validation", "Please select seconds from dropdown box.")
				this.tab_preferences.tabpage_patient.ddlb_patientrecurringservicesec.setfocus()
				return -1
			elseif isnull(ls_ampm) or ls_ampm = "" or ls_ampm = "none" then
				messagebox("BackUp Time Validation", "Please select AM/PM from dropdown box.")
				this.tab_preferences.tabpage_patient.ddlb_patientrecurringservicetime.setfocus()
				return -1
			end if
			li_hr = integer(ls_hr)
			if ls_ampm = "PM" then
				if li_hr < 12 then
					li_hr = li_hr + 12
				end if
			elseif li_hr = 12 then
				li_hr = 0
			end if
			ls_activetime = string(li_hr) + ls_min + ls_sec
			ll_activetime = long(ls_activetime)
			li_unit = 1
			li_unitvalue = 0
		else
			if this.tab_preferences.tabpage_patient.dw_patientrecurringservice.accepttext() = 1 then
				li_unitvalue = this.tab_preferences.tabpage_patient.dw_patientrecurringservice.getitemnumber(1, "unitvalue")
				li_unit = this.tab_preferences.tabpage_patient.dw_patientrecurringservice.getitemnumber(1, "unit")
				if li_unit = 4 then
					if not (li_unitvalue >= 1 and li_unitvalue <= 1440) then
						messagebox("Inpaient Recurring Services Time Validation", "Please enter valid value for minutes between 1 and 1440.")
						this.tab_preferences.tabpage_patient.dw_patientrecurringservice.setcolumn(1)
						this.tab_preferences.tabpage_patient.dw_patientrecurringservice.setfocus()
						return -1
					end if
				elseif li_unit = 8 then
					if not (li_unitvalue >= 1 and li_unitvalue <= 24) then
						messagebox("Inpaient Recurring Services Time Validation", "Please enter valid value for hours between 1 and 24.")
						this.tab_preferences.tabpage_patient.dw_patientrecurringservice.setcolumn(2)
						this.tab_preferences.tabpage_patient.dw_patientrecurringservice.setfocus()
						return -1
					end if
				else
					messagebox("Inpaient Recurring Services Time Validation", "Please select minutes/hours from dropdown list box")
					this.tab_preferences.tabpage_patient.dw_patientrecurringservice.setcolumn(2)
					this.tab_preferences.tabpage_patient.dw_patientrecurringservice.setfocus()
					return -1
				end if
			else
				messagebox("Inpaient Recurring Services Time Validation", "Please enter valid value for a unit.")
				this.tab_preferences.tabpage_patient.dw_patientrecurringservice.setcolumn(1)
				this.tab_preferences.tabpage_patient.dw_patientrecurringservice.setfocus()
				return -1
			end if
			ll_activetime = 0
		end if
		sqlca.adjustjobschedule(ls_jobname, ls_schedulename, ll_activetime, li_unit, li_unitvalue)
		sqlca.activatejob(ls_jobname, 1)
	else
		sqlca.activatejob(ls_jobname, 0)
	end if
	if this.tab_preferences.tabpage_patient.cbx_patientrecurringservices.checked = true then
		if this.tab_preferences.tabpage_patient.rb_patient_svc_every.checked = true then
		end if
		sqlca.adjustjobschedule(ls_jobname, ls_schedulename, ll_activetime, li_unit, li_unitvalue)
		sqlca.activatejob(ls_jobname, 1)
	else
		sqlca.activatejob(ls_jobname, 0)
	end if
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
		return 0
	end if
	SQL rollback USING sqlca;
	messagebox("Job Error", "Unable to update credit sale posting job status.")
	setpointer(arrow!)
	return -1

// w_job_schedule.wf_open_inpatientrecservicesjob() returns long
	long ll_counter
	long ll_pos
	long ll_rtcode
	long ll_found
	string ls_jobstarttime
	string ls_hold
	string ls_clientjob
	string ls_clientjobschedule
	integer li_autopurgesaleshr
	integer li_backuphr
	integer li_enabled
	ls_clientjob = gs_autoinpatientservicesjob
	ls_clientjobschedule = gs_autoinpatientservicesjobschedule
	this.tab_preferences.tabpage_patient.dw_inpatientrecurringservice.settransobject(this.it_jobtransobject)
	this.tab_preferences.tabpage_patient.dw_inpatientrecurringservice.retrieve(ls_clientjob, ls_clientjobschedule)
	SQL Select enabled INTO :li_enabled From SysJobs Where Name =:ls_clientjob USING this.it_jobtransobject;
	if this.it_jobtransobject.sqlcode = 0 then
		if li_enabled = 1 then
			this.tab_preferences.tabpage_patient.cbx_inpatientrecurringservices.checked = true
			if this.tab_preferences.tabpage_patient.dw_inpatientrecurringservice.getitemnumber(1, "unit") = 1.0 then
				this.tab_preferences.tabpage_patient.rb_inpatient_svc_once.checked = true
				this.tab_preferences.tabpage_patient.rb_inpatient_svc_every.checked = false
				ls_jobstarttime = string(this.tab_preferences.tabpage_patient.dw_inpatientrecurringservice.getitemnumber(1, "occurancetime"))
				li_backuphr = integer(left(ls_jobstarttime, len(ls_jobstarttime) - 4))
				ls_hold = left(right(ls_jobstarttime, 4), len(right(ls_jobstarttime, 4)) - 2)
				if isnull(ls_hold) or ls_hold = "" then
					ls_hold = "00"
				elseif len(ls_hold) = 1 then
					ls_hold = "0" + ls_hold
				end if
				this.tab_preferences.tabpage_patient.ddlb_inpatientrecurringservicemin.selectitem(ls_hold, 0)
				ls_hold = right(ls_jobstarttime, 2)
				if isnull(ls_hold) or ls_hold = "" then
					ls_hold = "00"
				elseif len(ls_hold) = 1 then
					ls_hold = "0" + ls_hold
				end if
				this.tab_preferences.tabpage_patient.ddlb_inpatientrecurringservicesec.selectitem(ls_hold, 0)
				if li_backuphr > 12 then
					this.tab_preferences.tabpage_patient.ddlb_inpatientrecurringservicehr.selectitem(string(li_backuphr - 12), 0)
					this.tab_preferences.tabpage_patient.ddlb_inpatientrecurringservicetime.selectitem("PM", 0)
				elseif li_backuphr = 12 then
					this.tab_preferences.tabpage_patient.ddlb_inpatientrecurringservicehr.selectitem("12", 0)
					this.tab_preferences.tabpage_patient.ddlb_inpatientrecurringservicetime.selectitem("PM", 0)
				else
					if isnull(li_backuphr) or li_backuphr = 0 then
						this.tab_preferences.tabpage_patient.ddlb_inpatientrecurringservicehr.selectitem("12", 0)
					else
						this.tab_preferences.tabpage_patient.ddlb_inpatientrecurringservicehr.selectitem(string(li_backuphr), 0)
					end if
					this.tab_preferences.tabpage_patient.ddlb_inpatientrecurringservicetime.selectitem("AM", 0)
				end if
				this.tab_preferences.tabpage_patient.dw_inpatientrecurringservice.enabled = false
			else
				this.tab_preferences.tabpage_patient.rb_inpatient_svc_every.visible = true
				this.tab_preferences.tabpage_patient.rb_inpatient_svc_once.checked = false
				this.tab_preferences.tabpage_patient.rb_inpatient_svc_every.checked = true
				this.tab_preferences.tabpage_patient.dw_inpatientrecurringservice.enabled = true
				this.tab_preferences.tabpage_patient.dw_inpatientrecurringservice.visible = true
				this.tab_preferences.tabpage_patient.ddlb_inpatientrecurringservicehr.enabled = false
				this.tab_preferences.tabpage_patient.ddlb_inpatientrecurringservicemin.enabled = false
				this.tab_preferences.tabpage_patient.ddlb_inpatientrecurringservicesec.enabled = false
				this.tab_preferences.tabpage_patient.ddlb_inpatientrecurringservicetime.enabled = false
			end if
		else
			this.tab_preferences.tabpage_patient.cbx_inpatientrecurringservices.checked = false
			this.tab_preferences.tabpage_patient.rb_inpatient_svc_once.enabled = false
			this.tab_preferences.tabpage_patient.rb_inpatient_svc_every.enabled = false
			this.tab_preferences.tabpage_patient.dw_inpatientrecurringservice.enabled = false
			this.tab_preferences.tabpage_patient.ddlb_inpatientrecurringservicehr.enabled = false
			this.tab_preferences.tabpage_patient.ddlb_inpatientrecurringservicemin.enabled = false
			this.tab_preferences.tabpage_patient.ddlb_inpatientrecurringservicesec.enabled = false
			this.tab_preferences.tabpage_patient.ddlb_inpatientrecurringservicetime.enabled = false
		end if
	else
		messagebox("Job", "Unable to fetch auto inpatient services job status.")
	end if
	return 0

