// w_job_schedule.wf_open_autopurgesalesjob() returns long
	long ll_counter
	long ll_pos
	long ll_rtcode
	long ll_found
	string ls_jobstarttime
	string ls_hold
	string ls_clientjob
	string ls_clientjobschedule
	integer li_autopurgesaleshr
	integer li_backuphr
	integer li_enabled
	if not f_rightexists(1480) then
		return 0
	end if
	ls_clientjob = gs_autopurgepostedsales
	ls_clientjobschedule = gs_autopurgepostedsales_schedule
	this.tab_preferences.tabpage_datamigration.dw_autopurgesalesschedule.settransobject(this.it_jobtransobject)
	this.tab_preferences.tabpage_datamigration.dw_autopurgesalesschedule.retrieve(ls_clientjob, ls_clientjobschedule)
	SQL Select enabled INTO :li_enabled From SysJobs Where Name =:ls_clientjob USING this.it_jobtransobject;
	if this.it_jobtransobject.sqlcode = 0 then
		if li_enabled = 1 then
			this.tab_preferences.tabpage_datamigration.cbx_activateautopurgesales.checked = true
			if this.tab_preferences.tabpage_datamigration.dw_autopurgesalesschedule.getitemnumber(1, "unit") = 1.0 then
				this.tab_preferences.tabpage_datamigration.rb_autopurgesalesonce.checked = true
				ls_jobstarttime = string(this.tab_preferences.tabpage_datamigration.dw_autopurgesalesschedule.getitemnumber(1, "occurancetime"))
				li_autopurgesaleshr = integer(left(ls_jobstarttime, len(ls_jobstarttime) - 4))
				ls_hold = left(right(ls_jobstarttime, 4), len(right(ls_jobstarttime, 4)) - 2)
				if isnull(ls_hold) or ls_hold = "" then
					ls_hold = "00"
				elseif len(ls_hold) = 1 then
					ls_hold = "0" + ls_hold
				end if
				this.tab_preferences.tabpage_datamigration.ddlb_autopurgesalesmin.selectitem(ls_hold, 0)
				ls_hold = right(ls_jobstarttime, 2)
				if isnull(ls_hold) or ls_hold = "" then
					ls_hold = "00"
				elseif len(ls_hold) = 1 then
					ls_hold = "0" + ls_hold
				end if
				this.tab_preferences.tabpage_datamigration.ddlb_autopurgesalessec.selectitem(ls_hold, 0)
				if li_autopurgesaleshr > 12 then
					this.tab_preferences.tabpage_datamigration.ddlb_autopurgesaleshr.selectitem(string(li_autopurgesaleshr - 12), 0)
					this.tab_preferences.tabpage_datamigration.ddlb_autopurgesalestime.selectitem("PM", 0)
				elseif li_autopurgesaleshr = 12 then
					this.tab_preferences.tabpage_datamigration.ddlb_autopurgesaleshr.selectitem("12", 0)
					this.tab_preferences.tabpage_datamigration.ddlb_autopurgesalestime.selectitem("PM", 0)
				else
					if isnull(li_autopurgesaleshr) or li_autopurgesaleshr = 0 then
						this.tab_preferences.tabpage_datamigration.ddlb_autopurgesaleshr.selectitem("12", 0)
					else
						this.tab_preferences.tabpage_datamigration.ddlb_autopurgesaleshr.selectitem(string(li_autopurgesaleshr), 0)
					end if
					this.tab_preferences.tabpage_datamigration.ddlb_autopurgesalestime.selectitem("AM", 0)
				end if
				this.tab_preferences.tabpage_datamigration.dw_autopurgesalesschedule.enabled = false
			else
				this.tab_preferences.tabpage_datamigration.rb_autopurgesalesevery.checked = true
				this.tab_preferences.tabpage_datamigration.ddlb_autopurgesaleshr.enabled = false
				this.tab_preferences.tabpage_datamigration.ddlb_autopurgesalesmin.enabled = false
				this.tab_preferences.tabpage_datamigration.ddlb_autopurgesalessec.enabled = false
				this.tab_preferences.tabpage_datamigration.ddlb_autopurgesalestime.enabled = false
			end if
		else
			this.tab_preferences.tabpage_datamigration.cbx_activateautopurgesales.checked = false
			this.tab_preferences.tabpage_datamigration.rb_autopurgesalesevery.enabled = false
			this.tab_preferences.tabpage_datamigration.dw_autopurgesalesschedule.enabled = false
			this.tab_preferences.tabpage_datamigration.rb_autopurgesalesonce.enabled = false
			this.tab_preferences.tabpage_datamigration.ddlb_autopurgesaleshr.enabled = false
			this.tab_preferences.tabpage_datamigration.ddlb_autopurgesalesmin.enabled = false
			this.tab_preferences.tabpage_datamigration.ddlb_autopurgesalessec.enabled = false
			this.tab_preferences.tabpage_datamigration.ddlb_autopurgesalestime.enabled = false
		end if
	else
		messagebox("Job", "Unable to fetch Auto Purge Posted Sales job status.")
	end if
	return 0

// w_job_schedule.wf_open_autodatamigrationjob() returns integer
	long ll_counter
	long ll_pos
	long ll_rtcode
	long ll_found
	string ls_jobstarttime
	string ls_hold
	string ls_clientjob
	string ls_clientjobschedule
	integer li_autopurgesaleshr
	integer li_backuphr
	integer li_enabled
	if not f_rightexists(1480) then
		return 0
	end if
	ls_clientjob = gs_autodatamigration
	ls_clientjobschedule = gs_autodatamigrationschedule
	this.tab_preferences.tabpage_datamigration.dw_autodatamigration.settransobject(this.it_jobtransobject)
	this.tab_preferences.tabpage_datamigration.dw_autodatamigration.retrieve(ls_clientjob, ls_clientjobschedule)
	SQL Select enabled INTO :li_enabled From SysJobs Where Name =:ls_clientjob USING this.it_jobtransobject;
	if this.it_jobtransobject.sqlcode = 0 then
		if li_enabled = 1 then
			this.tab_preferences.tabpage_datamigration.cbx_activateautodatamigration.checked = true
			if this.tab_preferences.tabpage_datamigration.dw_autodatamigration.getitemnumber(1, "unit") = 1.0 then
				this.tab_preferences.tabpage_datamigration.rb_autodatamigration_once.checked = true
				this.tab_preferences.tabpage_datamigration.rb_autodatamigration_every.checked = false
				ls_jobstarttime = string(this.tab_preferences.tabpage_datamigration.dw_autodatamigration.getitemnumber(1, "occurancetime"))
				li_autopurgesaleshr = integer(left(ls_jobstarttime, len(ls_jobstarttime) - 4))
				ls_hold = left(right(ls_jobstarttime, 4), len(right(ls_jobstarttime, 4)) - 2)
				if isnull(ls_hold) or ls_hold = "" then
					ls_hold = "00"
				elseif len(ls_hold) = 1 then
					ls_hold = "0" + ls_hold
				end if
				this.tab_preferences.tabpage_datamigration.ddlb_autodatamigrationmin.selectitem(ls_hold, 0)
				ls_hold = right(ls_jobstarttime, 2)
				if isnull(ls_hold) or ls_hold = "" then
					ls_hold = "00"
				elseif len(ls_hold) = 1 then
					ls_hold = "0" + ls_hold
				end if
				this.tab_preferences.tabpage_datamigration.ddlb_autodatamigrationsec.selectitem(ls_hold, 0)
				if li_autopurgesaleshr > 12 then
					this.tab_preferences.tabpage_datamigration.ddlb_autodatamigrationhr.selectitem(string(li_autopurgesaleshr - 12), 0)
					this.tab_preferences.tabpage_datamigration.ddlb_autodatamigrationtime.selectitem("PM", 0)
				elseif li_autopurgesaleshr = 12 then
					this.tab_preferences.tabpage_datamigration.ddlb_autodatamigrationhr.selectitem("12", 0)
					this.tab_preferences.tabpage_datamigration.ddlb_autodatamigrationtime.selectitem("PM", 0)
				else
					if isnull(li_autopurgesaleshr) or li_autopurgesaleshr = 0 then
						this.tab_preferences.tabpage_datamigration.ddlb_autodatamigrationhr.selectitem("12", 0)
					else
						this.tab_preferences.tabpage_datamigration.ddlb_autodatamigrationhr.selectitem(string(li_autopurgesaleshr), 0)
					end if
					this.tab_preferences.tabpage_datamigration.ddlb_autodatamigrationtime.selectitem("AM", 0)
				end if
				this.tab_preferences.tabpage_datamigration.dw_autodatamigration.enabled = false
			else
				this.tab_preferences.tabpage_datamigration.rb_autodatamigration_every.checked = true
				this.tab_preferences.tabpage_datamigration.rb_autodatamigration_every.visible = true
				this.tab_preferences.tabpage_datamigration.rb_autodatamigration_once.checked = false
				this.tab_preferences.tabpage_datamigration.dw_autodatamigration.enabled = true
				this.tab_preferences.tabpage_datamigration.ddlb_autodatamigrationhr.enabled = false
				this.tab_preferences.tabpage_datamigration.ddlb_autodatamigrationmin.enabled = false
				this.tab_preferences.tabpage_datamigration.ddlb_autodatamigrationsec.enabled = false
				this.tab_preferences.tabpage_datamigration.ddlb_autodatamigrationtime.enabled = false
			end if
