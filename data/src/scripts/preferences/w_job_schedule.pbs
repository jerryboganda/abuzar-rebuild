	integer li_backuphr
	integer li_enabled
	ls_clientjob = gs_autopostvisitappointmentjob
	ls_clientjobschedule = gs_autopostvisitappointmentjobschedule
	this.tab_preferences.tabpage_patient.dw_autopostvisitappointmentschedule.settransobject(this.it_jobtransobject)
	this.tab_preferences.tabpage_patient.dw_autopostvisitappointmentschedule.retrieve(ls_clientjob, ls_clientjobschedule)
	SQL Select enabled INTO :li_enabled From SysJobs Where Name =:ls_clientjob USING this.it_jobtransobject;
	if this.it_jobtransobject.sqlcode = 0 then
		this.tab_preferences.tabpage_patient.em_autopostvisitappointmenttime.text = trim(string(f_numberpreferences("VisitAppointmentAutoPostTime")))
		if li_enabled = 1 then
			this.tab_preferences.tabpage_patient.cbx_activateautopostvisitappointment.checked = true
		else
			this.tab_preferences.tabpage_patient.cbx_activateautopostvisitappointment.checked = false
			this.tab_preferences.tabpage_patient.em_autopostvisitappointmenttime.enabled = false
			this.tab_preferences.tabpage_patient.dw_autopostvisitappointmentschedule.enabled = false
			this.tab_preferences.tabpage_patient.em_autopostvisitappointmenttime.enabled = false
		end if
	else
		messagebox("Job", "Unable to fetch Auto Visit Appointment Posting job status.")
	end if
	return 0

