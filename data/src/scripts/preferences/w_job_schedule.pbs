// window w_job_schedule (preferences)  ancestor: window

// w_job_schedule.wf_assigndatawindowchild(datawindow adw_parent, datawindowchild adwc_child) returns long
	long ll_rtcode
	ll_rtcode = adw_parent.getchild("acccode", adwc_child)
	if ll_rtcode <> -1 then
		adwc_child.settransobject(sqlca)
		adwc_child.retrieve(f_getglobalcode("GT_CashSub"))
	end if
	return ll_rtcode

// w_job_schedule.wf_insertandscrollto(datawindow adw_dw) returns 0
	adw_dw.insertrow(0)
	adw_dw.scrolltorow(0)

// w_job_schedule.wf_showerrmessage(long al_rtcode) returns 0
	if al_rtcode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
	end if

// w_job_schedule.wf_assigndatawindow(datawindow adw_source, datawindow adw_target) returns 0
	adw_target = adw_source
	adw_target.settransobject(sqlca)

// w_job_schedule.wf_set_interface_adjustments() returns 0
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width * 0.80
		ll_height = ll_win_height * 0.90
		this.width = ll_width
		this.height = ll_height
		this.cb_ok.y = ll_height - this.cb_ok.height - 120
		this.cb_cancel.y = ll_height - this.cb_cancel.height - 120
		this.tab_preferences.width = ll_width * 0.98
		this.tab_preferences.height = this.cb_ok.y - 50
		this.tab_preferences.tabpage_datamigration.width = this.tab_preferences.width * 0.98
		this.tab_preferences.tabpage_datamigration.height = this.tab_preferences.height - 200
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if

// w_job_schedule.wf_set_tab_visibility() returns long
	if not (f_rightexists(369) or f_rightexists(1090) or f_rightexists(206) or f_rightexists(1218)) then
		this.tab_preferences.tabpage_patient.visible = false
	end if
	if not f_rightexists(1388) then
		this.tab_preferences.tabpage_guest.visible = false
	end if
	if not f_rightexists(1480) then
		this.tab_preferences.tabpage_datamigration.visible = false
	end if
	if not f_rightexists(1363) then
		this.tab_preferences.tabpage_sms.visible = false
	end if
	if not f_rightexists(1454) then
		this.tab_preferences.tabpage_employee.visible = false
	end if
	if not f_rightexists(158) then
		this.tab_preferences.tabpage_doctor.visible = false
	end if
	return 0

// w_job_schedule.wf_autodoctortokenreset() returns long
	string ls_jobname
	string ls_schedulename
	string ls_hr
	string ls_min
	string ls_sec
	string ls_ampm
	string ls_activetime
	integer li_hr
	integer li_min
	integer li_sec
	integer li_unit
	integer li_unitvalue
	long ll_activetime
	if not f_rightexists(158) then
		return 0
	end if
	ls_jobname = gs_autodoctortokenreset
	ls_schedulename = gs_autodoctortokenresetschedule
	if this.tab_preferences.tabpage_doctor.cbx_activatedocttoken.checked = true then
		if this.tab_preferences.tabpage_doctor.rb_oncedocttoken.checked = true then
			ls_hr = this.tab_preferences.tabpage_doctor.ddlb_hrdocttoken.text
			ls_min = this.tab_preferences.tabpage_doctor.ddlb_mindocttoken.text
			ls_sec = this.tab_preferences.tabpage_doctor.ddlb_secdocttoken.text
			ls_ampm = this.tab_preferences.tabpage_doctor.ddlb_timedocttoken.text
			if isnull(ls_hr) or ls_hr = "" or ls_hr = "none" then
				messagebox("Auto Doctor Token Reset Time Validation", "Please select hours from dropdown box.")
				this.tab_preferences.tabpage_doctor.ddlb_hrdocttoken.setfocus()
				return -1
			elseif isnull(ls_min) or ls_min = "" or ls_min = "none" then
				messagebox("Auto Doctor Token Reset Time Validation", "Please select minutes from dropdown box.")
				this.tab_preferences.tabpage_doctor.ddlb_mindocttoken.setfocus()
				return -1
			elseif isnull(ls_sec) or ls_sec = "" or ls_sec = "none" then
				messagebox("Auto Doctor Token Reset Time Validation", "Please select seconds from dropdown box.")
				this.tab_preferences.tabpage_doctor.ddlb_secdocttoken.setfocus()
				return -1
			elseif isnull(ls_ampm) or ls_ampm = "" or ls_ampm = "none" then
				messagebox("Auto Doctor Token Reset Time Validation", "Please select AM/PM from dropdown box.")
				this.tab_preferences.tabpage_doctor.ddlb_timedocttoken.setfocus()
				return -1
			end if
			li_hr = integer(ls_hr)
			if ls_ampm = "PM" then
				if li_hr < 12 then
					li_hr = li_hr + 12
				end if
			elseif li_hr = 12 then
				li_hr = 0
			end if
			ls_activetime = string(li_hr) + ls_min + ls_sec
			ll_activetime = long(ls_activetime)
			li_unit = 1
			li_unitvalue = 0
		else
			if this.tab_preferences.tabpage_doctor.dw_docttoken.accepttext() = 1 then
				li_unitvalue = this.tab_preferences.tabpage_doctor.dw_docttoken.getitemnumber(1, "unitvalue")
				li_unit = this.tab_preferences.tabpage_doctor.dw_docttoken.getitemnumber(1, "unit")
				if li_unit = 4 then
					if not (li_unitvalue >= 1 and li_unitvalue <= 1440) then
						messagebox("Auto Doctor Token Reset Time Validation", "Please enter valid value for minutes between 1 and 1440.")
						this.tab_preferences.tabpage_doctor.dw_docttoken.setcolumn(1)
						this.tab_preferences.tabpage_doctor.dw_docttoken.setfocus()
						return -1
					end if
				elseif li_unit = 8 then
					if not (li_unitvalue >= 1 and li_unitvalue <= 24) then
						messagebox("Auto Doctor Token Reset Time Validation", "Please enter valid value for hours between 1 and 24.")
						this.tab_preferences.tabpage_doctor.dw_docttoken.setcolumn(2)
						this.tab_preferences.tabpage_doctor.dw_docttoken.setfocus()
						return -1
					end if
				else
					messagebox("Auto Doctor Token Reset Time Validation", "Please select minutes/hours from dropdown list box")
					this.tab_preferences.tabpage_doctor.dw_docttoken.setcolumn(2)
					this.tab_preferences.tabpage_doctor.dw_docttoken.setfocus()
					return -1
				end if
			else
				messagebox("Auto Doctor Token Reset Time Validation", "Please enter valid value for a unit.")
				this.tab_preferences.tabpage_doctor.dw_docttoken.setcolumn(1)
				this.tab_preferences.tabpage_doctor.dw_docttoken.setfocus()
				return -1
			end if
			ll_activetime = 0
		end if
		sqlca.adjustjobschedule(ls_jobname, ls_schedulename, ll_activetime, li_unit, li_unitvalue)
		sqlca.activatejob(ls_jobname, 1)
	else
		sqlca.activatejob(ls_jobname, 0)
	end if
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
		return 0
	end if
	SQL rollback USING sqlca;
	messagebox("Job Error", "Unable to update credit sale posting job status.")
	setpointer(arrow!)
	return -1

