			if li_unit = 4 then
				if not (li_unitvalue >= 1 and li_unitvalue <= 1440) then
					messagebox("Visit Appointment Posting Time Validation", "Please enter valid value for minutes between 1 and 1440 for Auto Visit Appointment Posting.")
					this.tab_preferences.tabpage_patient.dw_autopostvisitappointmentschedule.setcolumn(1)
					this.tab_preferences.tabpage_patient.dw_autopostvisitappointmentschedule.setfocus()
					return -1
				end if
			elseif li_unit = 8 then
				if not (li_unitvalue >= 1 and li_unitvalue <= 24) then
					messagebox("Visit Appointment Posting Time Validation", "Please enter valid value for hours between 1 and 24 for Auto Visit Appointment Posting.")
					this.tab_preferences.tabpage_patient.dw_autopostvisitappointmentschedule.setcolumn(2)
					this.tab_preferences.tabpage_patient.dw_autopostvisitappointmentschedule.setfocus()
					return -1
				end if
			else
				messagebox("Visit Appointment Posting Time Validation", "Please select minutes/hours from dropdown list box of Auto Visit Appointment Posting.")
				this.tab_preferences.tabpage_patient.dw_autopostvisitappointmentschedule.setcolumn(2)
				this.tab_preferences.tabpage_patient.dw_autopostvisitappointmentschedule.setfocus()
				return -1
			end if
		else
			messagebox("Visit Appointment Posting Validation", "Please enter valid value of a unit for Auto Visit Appointment Posting.")
			this.tab_preferences.tabpage_patient.dw_autopostvisitappointmentschedule.setcolumn(1)
			this.tab_preferences.tabpage_patient.dw_autopostvisitappointmentschedule.setfocus()
			return -1
		end if
		ll_activetime = 0
		sqlca.adjustjobschedule(ls_jobname, ls_schedulename, ll_activetime, li_unit, li_unitvalue)
		sqlca.activatejob(ls_jobname, 1)
	else
		sqlca.activatejob(ls_jobname, 0)
	end if
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
		return 0
	end if
	SQL rollback USING sqlca;
	messagebox("Job Error", "Unable to update Auto Visit Appointment Posting job status.")
	setpointer(arrow!)
	return -1

// w_job_schedule.wf_open_autopostvisitappointmentjob() returns long
	long ll_counter
	long ll_pos
	long ll_rtcode
	long ll_found
	string ls_clientjob
	string ls_clientjobschedule
