						this.tab_preferences.tabpage_datamigration.dw_autodatamigration.setcolumn(1)
						this.tab_preferences.tabpage_datamigration.dw_autodatamigration.setfocus()
						return -1
					end if
				elseif li_unit = 8 then
					if not (li_unitvalue >= 1 and li_unitvalue <= 24) then
						messagebox("Auto Data Migration Time Validation", "Please enter valid value for hours between 1 and 24.")
						this.tab_preferences.tabpage_datamigration.dw_autodatamigration.setcolumn(2)
						this.tab_preferences.tabpage_datamigration.dw_autodatamigration.setfocus()
						return -1
					end if
				else
					messagebox("Auto Data Migration Time Validation", "Please select minutes/hours from dropdown list box")
					this.tab_preferences.tabpage_datamigration.dw_autodatamigration.setcolumn(2)
					this.tab_preferences.tabpage_datamigration.dw_autodatamigration.setfocus()
					return -1
				end if
			else
				messagebox("Auto Data Migration Time Validation", "Please enter valid value for a unit.")
				this.tab_preferences.tabpage_datamigration.dw_autodatamigration.setcolumn(1)
				this.tab_preferences.tabpage_datamigration.dw_autodatamigration.setfocus()
				return -1
			end if
			ll_activetime = 0
		end if
		sqlca.adjustjobschedule(ls_jobname, ls_schedulename, ll_activetime, li_unit, li_unitvalue)
		sqlca.activatejob(ls_jobname, 1)
	else
		sqlca.activatejob(ls_jobname, 0)
	end if
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
		return 0
	end if
	SQL rollback USING sqlca;
	messagebox("Job Error", "Unable to update credit sale posting job status.")
	setpointer(arrow!)
	return -1

