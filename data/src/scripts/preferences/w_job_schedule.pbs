// w_job_schedule.create() returns 0 [event]
	this.dw_hidden = create dw_hidden
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.tab_preferences = create tab_preferences
	this.control = {this.dw_hidden, this.cb_cancel, this.cb_ok, this.tab_preferences}

// w_job_schedule.destroy() returns 0 [event]
	destroy this.dw_hidden
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.tab_preferences

// w_job_schedule.open() returns long [event]
	long ll_counter
	long ll_pos
	long ll_rtcode
	long ll_found
	string ls_jobstarttime
	string ls_hold
	string ls_clientjob
	string ls_clientjobschedule
	integer li_autopurgesaleshr
	integer li_backuphr
	integer li_enabled
	boolean lb_advancedpurchase
	w_entry w_parent
	string ls_version_info = "0                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             0"
	wf_set_interface_adjustments()
	wf_set_tab_visibility()
	sqlca.dbms_version(ls_version_info)
	if match(ls_version_info, "SQL Server 2012") = true then
		this.tab_preferences.tabpage_backup.dw_backupschedule.dataobject = "d_backupschedule_2012"
		this.tab_preferences.tabpage_stock.dw_stockledger.dataobject = "d_backupschedule_2012"
		this.tab_preferences.tabpage_stock.dw_stkver.dataobject = "d_backupschedule_2012"
		this.tab_preferences.tabpage_stock.dw_stockreport.dataobject = "d_backupschedule_2012"
		this.tab_preferences.tabpage_sales.dw_autocashsalepostingschedule.dataobject = "d_backupschedule_2012"
		this.tab_preferences.tabpage_sales.dw_autocreditsalepostingschedule.dataobject = "d_backupschedule_2012"
		this.tab_preferences.tabpage_sales.dw_autoduesatisfy.dataobject = "d_backupschedule_2012"
		this.tab_preferences.tabpage_patient.dw_inpatientrecurringservice.dataobject = "d_backupschedule_2012"
		this.tab_preferences.tabpage_patient.dw_patientrecurringservice.dataobject = "d_backupschedule_2012"
		this.tab_preferences.tabpage_patient.dw_autopostvisitappointmentschedule.dataobject = "d_backupschedule_2012"
		this.tab_preferences.tabpage_patient.dw_autopostvisitschedule.dataobject = "d_backupschedule_2012"
		this.tab_preferences.tabpage_guest.dw_guestcheckinservice.dataobject = "d_backupschedule_2012"
		this.tab_preferences.tabpage_datamigration.dw_autopurgesalesschedule.dataobject = "d_backupschedule_2012"
		this.tab_preferences.tabpage_datamigration.dw_autodatamigration.dataobject = "d_backupschedule_2012"
		this.tab_preferences.tabpage_sms.dw_smsschedule.dataobject = "d_backupschedule_2012"
		this.tab_preferences.tabpage_employee.dw_emptimeout.dataobject = "d_backupschedule_2012"
		this.tab_preferences.tabpage_doctor.dw_docttoken.dataobject = "d_backupschedule_2012"
	end if
	this.dw_hidden.settransobject(sqlca)
	this.dw_hidden.retrieve()
	ll_found = 0
	setnull(ll_found)
	this.it_jobtransobject = create u_transaction
	this.it_jobtransobject.autocommit = true
	this.it_jobtransobject.dbparm = "PROVIDER='SQLOLEDB',DATASOURCE='" + gs_servername + "',CommitOnDisconnect='No',PROVIDERSTRING='DataBase=MSDB" + ";APP=" + gs_app + ";WSID=" + gs_localcomputername + "',PBTrimCharColumns='Yes',StripParmNames='Yes'"
	SQL start USING this.it_jobtransobject;
	if this.it_jobtransobject.sqlcode <> 0 then
		messagebox("Connection Problem", "Unable to connect to msdb database", stopsign!)
		close(this)
		return -1
	end if
	wf_open_autopurgesalesjob()
	wf_open_autodatamigrationjob()
	wf_open_autobackupclientjob()
	wf_open_autocashsalepostingjob()
	wf_open_autocreditsalepostingjob()
	wf_open_stockjobs()
	wf_open_autoduesatisfyjob()
	wf_open_inpatientrecservicesjob()
	wf_open_autopatientrecservericejob()
	wf_open_autoguestcheckedinjob()
	wf_open_autocreatesmsjob()
	wf_open_autoemployeetimeoutjob()
	wf_open_autodoctortokenresetjob()
	wf_open_autopostvisitappointmentjob()
	wf_open_autopostvisitjob()
	return ::message.returnvalue

// cb_cancel.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return 1

// cb_cancel.clicked() returns long [event]
	close(parent)
	return ::message.returnvalue

// cb_ok.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return 1

// cb_ok.clicked() returns long [event]
	double ld_expirydays
	integer li_cashsalepostingtime
	integer li_creditsalepostingtime
	integer li_counter
	integer li_visitappointmentpostingtime
	long ll_retcode = 1
	long ll_accepttext
	long ll_row
	boolean lb_commitok = true
	string ls_errtext
	string ls_errtitle
	string ls_errmodule
	string ls_string
	string ls_prefvalue
	w_job_schedule w_parent
	if parent.tab_preferences.tabpage_sales.cbx_activateautocashsaleposting.checked = true then
		li_cashsalepostingtime = integer(parent.tab_preferences.tabpage_sales.em_autocashsalepostingtime.text)
		if isnull(li_cashsalepostingtime) or not (li_cashsalepostingtime >= 1 and li_cashsalepostingtime <= 1440) then
			messagebox("Cash Sale Posting Time Validation", "Please enter cash sale auto posting time value between 1 and 1440 minutes.")
			return ::message.returnvalue
		end if
		f_set_preference_local(parent.dw_hidden, "cashsaleautopostingtime", string(li_cashsalepostingtime))
	end if
	if parent.tab_preferences.tabpage_sales.cbx_activateautocreditsaleposting.checked = true then
		li_creditsalepostingtime = integer(parent.tab_preferences.tabpage_sales.em_autocreditsalepostingtime.text)
		if isnull(li_creditsalepostingtime) or not (li_creditsalepostingtime >= 1 and li_creditsalepostingtime <= 1440) then
			messagebox("Credit Sale Posting Time Validation", "Please enter credit sale auto posting time value between 1 and 1440 minutes.")
			return ::message.returnvalue
		end if
		f_set_preference_local(parent.dw_hidden, "creditsaleautopostingtime", string(li_creditsalepostingtime))
	end if
	if parent.tab_preferences.tabpage_patient.cbx_activateautopostvisitappointment.checked = true then
		li_visitappointmentpostingtime = integer(parent.tab_preferences.tabpage_patient.em_autopostvisitappointmenttime.text)
		if isnull(li_visitappointmentpostingtime) or not (li_visitappointmentpostingtime >= 1 and li_visitappointmentpostingtime <= 1440) then
			messagebox("Visit Appointment Posting Time Validation", "Please enter cash sale auto Visit Appointment posting time value between 1 and 1440 minutes.")
			return ::message.returnvalue
		end if
		f_set_preference_local(parent.dw_hidden, "VisitAppointmentAutoPostTime", string(li_visitappointmentpostingtime))
	end if
	w_parent = getparent()
	ll_accepttext = parent.dw_hidden.accepttext()
	if ll_accepttext <= 0 then
		return ::message.returnvalue
	end if
	ll_retcode = parent.dw_hidden.update()
	if ll_retcode < 1 then
		lb_commitok = false
		ls_errtitle = "Datasase Error"
		ls_errtext = "Some Database problem occur while saving " + ls_errmodule + " preferences"
		return ::message.returnvalue
	end if
	if lb_commitok then
		if parent.wf_autoclientbackupjob() = -1 then
			return ::message.returnvalue
		end if
		if parent.wf_stockledgerjob() = -1 then
			return ::message.returnvalue
		end if
		if parent.wf_stockreportjob() = -1 then
			return ::message.returnvalue
		end if
		if parent.wf_stockverificationjob() = -1 then
			return ::message.returnvalue
		end if
		if parent.wf_autocashsalepostingjob() = -1 then
			return ::message.returnvalue
		end if
		if parent.wf_autocreditsalepostingjob() = -1 then
			return ::message.returnvalue
		end if
		if parent.wf_autosatisfyduejob() = -1 then
			return ::message.returnvalue
		end if
		if parent.wf_autoinpatientservicesjob() = -1 then
			return ::message.returnvalue
		end if
		if parent.wf_autopatientrecservicesjob() = -1 then
			return ::message.returnvalue
		end if
		if parent.wf_autopostvisitappointment() = -1 then
			return ::message.returnvalue
		end if
		if parent.wf_autocheckedinguestservicesjob() = -1 then
			return ::message.returnvalue
		end if
		if parent.wf_autopurgepostedsales() = -1 then
			return ::message.returnvalue
		end if
		if parent.wf_autodatamigration() = -1 then
			return ::message.returnvalue
		end if
		if parent.wf_autocreatesmsjob() = -1 then
			return ::message.returnvalue
		end if
		if parent.wf_autoemployeetimeout() = -1 then
			return ::message.returnvalue
		end if
		if parent.wf_autodoctortokenreset() = -1 then
			return ::message.returnvalue
		end if
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
			messagebox("Job Error", "Unable to update credit sale posting job status.")
			setpointer(arrow!)
		end if
	else
		SQL rollback USING sqlca;
		return ::message.returnvalue
	end if
	setpointer(arrow!)
	w_parent.setfocus()
	close(w_job_schedule)
	return ::message.returnvalue

