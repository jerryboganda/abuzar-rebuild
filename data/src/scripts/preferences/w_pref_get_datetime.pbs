// window w_pref_get_datetime (preferences)  ancestor: w_pref_get_text

// w_pref_get_datetime.of_getvalue() returns integer
	this.dw_pref.object.prefvalue_t.text = this.is_preference.caption
	this.dw_pref.object.prefvalue[1] = datetime(date(left(trim(this.is_preference.value), 10)), time(right(trim(this.is_preference.value), 8)))
	return 0

// w_pref_get_datetime.of_setvalue() returns long
	this.dw_pref.accepttext()
	this.is_preference.value = string(this.dw_pref.object.prefvalue[1], "YYYY-MM-DD HH:MM:SS")
	this.is_preference.value2 = this.is_preference.value
	return 0

// w_pref_get_datetime.create() returns 0
	call super::create

// w_pref_get_datetime.destroy() returns 0
	call super::destroy
