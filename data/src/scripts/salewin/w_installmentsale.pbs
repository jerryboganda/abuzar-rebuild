// window w_installmentsale (salewin)  ancestor: w_multi_entry

// w_installmentsale.wf_validateitem() returns integer
	datetime ldt_date
	datetime ldt_null
	integer li_errcode
	setnull(ldt_null)
	if this.il_currrow > this.id_detail.rowcount() then
		this.il_currrow = this.id_detail.rowcount()
	end if
	ldt_date = this.id_detail.object.date[this.il_currrow]
	if vf_dwdupdate(this.id_detail, "date", ldt_date, this.il_currrow) = true then
		messagebox("Duplication Error", "Current row is duplicate for Qty Limit")
		li_errcode = -1
	else
		li_errcode = 0
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		this.id_detail.setcolumn("date")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.setitem(this.il_currrow, "date", ldt_null)
	end if
	return li_errcode

// w_installmentsale.wf_duplicatename(string as_name) returns boolean
	long ll_count
	long ll_masterrow
	long ll_code
	boolean b_flag
	ll_masterrow = this.id_master.getrow()
	if ll_masterrow > 0 then
		ll_code = this.id_master.object.code[ll_masterrow]
	end if
	as_name = trim(as_name)
	if isnull(ll_code) then
		SQL SELECT count ( *) INTO :ll_count FROM PricePolicy WHERE PricePolicy.name =:as_name USING this.it_transobject;
	else
		SQL SELECT count ( *) INTO :ll_count FROM PricePolicy WHERE PricePolicy.name =:as_name AND PricePolicy.PricePolicyCode <> :ll_code USING this.it_transobject;
	end if
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_installmentsale.wf_duplicateitemname(long al_icode) returns boolean
	long ll_count
	long ll_masterrow
	long ll_code
	boolean b_flag
	ll_masterrow = this.id_master.getrow()
	if ll_masterrow > 0 then
		ll_code = this.id_master.object.code[ll_masterrow]
	end if
	if isnull(ll_code) then
		SQL SELECT count ( *) INTO :ll_count FROM PricePolicy WHERE PricePolicy.Icode =:al_icode USING this.it_transobject;
	else
		SQL SELECT count ( *) INTO :ll_count FROM PricePolicy WHERE PricePolicy.Icode =:al_icode AND PricePolicy.PricePolicyCode <> :ll_code USING this.it_transobject;
	end if
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_installmentsale.wf_inititeminfo(long al_icode, long al_row) returns long
	long ll_packunits
	double ld_price
	double ld_stock
	SQL SELECT packunits , saleprice INTO :ll_packunits, :ld_price FROM DBO.Item WHERE ICode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_packunits = 0 or isnull(ll_packunits) then
			ll_packunits = 1
		end if
		this.id_master.object.packunits[al_row] = ll_packunits
		this.id_master.object.saleprice[al_row] = round(ld_price / ll_packunits, 2)
		this.it_transobject.getitemstocktotal(this.id_master.object.gcode[1], al_icode, ld_stock)
		if this.it_transobject.sqlcode = 0 then
			this.id_master.object.godownstock[1] = ld_stock
		end if
	end if
	return 0

// w_installmentsale.wf_grandtotal() returns double
	return 0

// w_installmentsale.wf_calculate_installment(string col, string data, long row) returns long
	long ll_counter
	long ll_insrow
	long ll_freq
	long ll_installments
	double ld_balanceamt
	double ld_installment
	double ld_markupamt
	double ld_amt
	datetime ldt_firstduedate
	date ld_date
	time lt_time
	if this.id_master.getrow() > 0 and this.id_master.object.posted[row] = "N" then
		if col = "noofinstallments" then
			ll_installments = long(data)
		else
			ll_installments = this.id_master.object.noofinstallments[row]
		end if
		if col = "installmentfrequency" then
			ll_freq = long(data)
		else
			ll_freq = this.id_master.object.installmentfrequency[row]
		end if
		if col = "firstduedate" then
			ld_date = date(left(data, 10))
			lt_time = time(data)
			ldt_firstduedate = datetime(ld_date, lt_time)
		else
			ldt_firstduedate = this.id_master.object.firstduedate[row]
		end if
		ld_balanceamt = this.id_master.getitemnumber(row, "c_balanceamt")
		if ld_balanceamt >= 0.0 and ll_installments > 0 then
			if this.id_detail.rowcount() > 0 then
				this.id_detail.reset()
			end if
			ld_installment = round(ld_balanceamt / ll_installments, 2)
			for ll_counter = row to ll_installments
				ll_insrow = this.id_detail.insertrow(0)
				if ll_insrow > 0 then
					if ll_insrow = 1 then
						this.id_detail.object.date[ll_insrow] = ldt_firstduedate
					elseif ll_insrow - 1 > 0 then
						this.id_detail.object.date[ll_insrow] = relativedate(date(this.id_detail.object.date[ll_insrow - 1]), ll_freq)
					end if
					this.id_detail.object.amount[ll_insrow] = ld_installment
				end if
			next
		end if
	end if
	return 0

// w_installmentsale.wf_find_item(string as_aliasname, long al_icode) returns long
	SQL SELECT ICode INTO :al_icode FROM Item WHERE CustomICode =:as_aliasname USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.object.icode[1] = al_icode
		wf_inititeminfo(al_icode, 1)
		return 0
	end if
	return 1

// w_installmentsale.wf_find_customer(string as_aliasname, long al_custcode) returns long
	SQL SELECT Acccode INTO :al_custcode FROM Accounts WHERE AliasName =:as_aliasname USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.object.custcode[1] = al_custcode
		return 0
	end if
	return 1

// w_installmentsale.wf_set_item_alias(long al_icode, string as_aliasname) returns long
	SQL SELECT CustomICode INTO :as_aliasname FROM Item WHERE ICode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.object.customicode[1] = as_aliasname
		wf_inititeminfo(al_icode, 1)
		return 0
	end if
	return 1

// w_installmentsale.wf_set_customer_alias(long al_custcode, string as_aliasname) returns long
	SQL SELECT AliasName INTO :as_aliasname FROM Accounts WHERE Acccode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.object.aliasname[1] = as_aliasname
		return 0
	end if
	return 1

// w_installmentsale.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_installmentsale.wf_post() returns long
	integer li_errcode
	long ll_salesmancode
	long ll_code
	long ll_saleinvcode
	string ls_msgtext
	if this.id_list.getrow() > 0 and this.id_list.rowcount() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
	else
		ll_code = -1
	end if
	if ll_code > 0 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		if ll_salesmancode > 0 then
			this.it_transobject.postinstallment(ll_code, ll_salesmancode, ll_saleinvcode)
			if this.it_transobject.sqlcode <> 0 then
				li_errcode = this.it_transobject.sqlcode
				ls_msgtext = this.it_transobject.sqlerrtext
			else
				li_errcode = this.it_transobject.sqlcode
			end if
			if li_errcode = 0 then
				SQL commit USING this.it_transobject;
				if this.it_transobject.sqlcode <> 0 then
					ls_msgtext = this.it_transobject.sqlerrtext
					li_errcode = this.it_transobject.sqlcode
				end if
			else
				SQL rollback USING this.it_transobject;
			end if
		else
			setfocus()
		end if
		setpointer(arrow!)
		if ll_salesmancode > 0 then
			if li_errcode <> 0 then
				messagebox("Posting Fails", "Some database request fails, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode))
			else
				messagebox("Posting Successfull", "Installment code " + string(ll_code) + "has been posted successfully")
			end if
		end if
	end if
	return li_errcode

// w_installmentsale.wf_populate_singleamt() returns integer
	long ll_counter
	double ld_amt
	double ld_balance
	double ld_ins_tot
	open(w_arg_amount)
	ld_amt = message.doubleparm
	if ld_amt > 0.0 then
		for ll_counter = 1 to this.id_detail.rowcount()
			this.id_detail.object.amount[ll_counter] = ld_amt
		next
		ld_balance = this.id_master.getitemnumber(1, "c_balanceamt")
		ld_ins_tot = this.id_detail.getitemnumber(1, "c_installmenttotal")
		if ld_balance - ld_ins_tot > 0.0 then
			this.id_detail.object.amount[this.id_detail.rowcount()] = ld_amt + (ld_balance - ld_ins_tot)
		end if
	end if
	return 0

// w_installmentsale.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_installmentsale.wf_approve() returns long
	integer li_errcode
	long ll_salesmancode
	string ls_msgtext
	s_arguements lstr_arg
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = 1 then
			this.it_transobject.approveinstallment(lstr_arg.l_code1, lstr_arg.l_code2, ll_salesmancode)
			if this.it_transobject.sqlcode <> 0 then
				li_errcode = this.it_transobject.sqlcode
				ls_msgtext = this.it_transobject.sqlerrtext
			else
				li_errcode = this.it_transobject.sqlcode
			end if
			if li_errcode = 0 then
				SQL commit USING this.it_transobject;
				if this.it_transobject.sqlcode <> 0 then
					ls_msgtext = this.it_transobject.sqlerrtext
					li_errcode = this.it_transobject.sqlcode
				end if
			else
				SQL rollback USING this.it_transobject;
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Approval Fails", "Specified Installment Estimates have not been Approved, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode))
		else
			messagebox("Approval Successfull", "Specified Installment Estimates have been Approved successfully")
		end if
	end if
	return li_errcode

// w_installmentsale.wf_set_guarantors() returns long
	s_dw_header lstr_header
	if this.tab_retrieve.selectedtab = 2 then
		return 0
	end if
	if this.ii_modulemode = 1 then
		if this.id_master.object.posted[1] = "Y" then
			lstr_header.i_protectdw = 1
		elseif this.id_master.object.approved[1] = "Y" then
			lstr_header.i_protectdw = 1
		else
			lstr_header.i_protectdw = 0
		end if
	elseif this.id_master.object.posted[1] = "Y" then
		lstr_header.i_protectdw = 1
	else
		lstr_header.i_protectdw = 0
	end if
	lstr_header.dw_header = this.dw_guarantor
	openwithparm(w_installmentguarantor_form, lstr_header)
	return 0

// w_installmentsale.wf_reject() returns integer
