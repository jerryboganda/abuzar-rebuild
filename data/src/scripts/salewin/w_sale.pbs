				this.id_detail.object.purunitrate[ll_insertedrows] = this.id_holdsaledetail.object.purunitrate[li_counter]
				this.id_detail.object.rppunitrate[ll_insertedrows] = this.id_holdsaledetail.object.rppunitrate[li_counter]
				this.id_detail.object.alternatepurprice[ll_insertedrows] = this.id_holdsaledetail.object.alternatepurprice[li_counter]
				this.id_detail.object.itemalertcode[ll_insertedrows] = this.id_holdsaledetail.object.itemalertcode[li_counter]
				this.id_detail.object.unitweight[ll_insertedrows] = this.id_holdsaledetail.object.unitweight[li_counter]
				this.id_detail.object.packingfactor[ll_insertedrows] = this.id_holdsaledetail.object.packingfactor[li_counter]
				this.id_detail.object.packcapacity[ll_insertedrows] = this.id_holdsaledetail.object.packcapacity[li_counter]
				this.id_detail.object.areavolume[ll_insertedrows] = this.id_holdsaledetail.object.areavolume[li_counter]
				this.id_detail.object.pcs[ll_insertedrows] = this.id_holdsaledetail.object.pcs[li_counter]
				this.id_detail.object.cartons[ll_insertedrows] = this.id_holdsaledetail.object.cartons[li_counter]
				this.id_detail.object.length[ll_insertedrows] = this.id_holdsaledetail.object.length[li_counter]
				this.id_detail.object.width[ll_insertedrows] = this.id_holdsaledetail.object.width[li_counter]
				this.id_detail.object.rateperlength[ll_insertedrows] = this.id_holdsaledetail.object.rateperlength[li_counter]
				this.id_detail.object.headerno[ll_insertedrows] = this.id_holdsaledetail.object.headerno[li_counter]
				this.id_detail.object.taxflag[ll_insertedrows] = this.id_holdsaledetail.object.taxflag[li_counter]
				this.id_detail.object.unitsalestax[ll_insertedrows] = this.id_holdsaledetail.object.unitsalestax[li_counter]
				this.id_detail.object.gstperc[ll_insertedrows] = this.id_holdsaledetail.object.gstperc[li_counter]
				this.id_detail.object.packqtyforsale[ll_insertedrows] = this.id_holdsaledetail.object.packqtyforsale[li_counter]
				this.id_detail.object.bonuspackqtyforsale[ll_insertedrows] = this.id_holdsaledetail.object.bonuspackqtyforsale[li_counter]
				this.id_detail.object.packsaleprice[ll_insertedrows] = this.id_holdsaledetail.object.packsaleprice[li_counter]
				this.id_detail.object.commissionperc[ll_insertedrows] = this.id_holdsaledetail.object.commissionperc[li_counter]
				this.id_detail.object.commissionperunit[ll_insertedrows] = this.id_holdsaledetail.object.commissionperunit[li_counter]
				this.id_detail.object.totalpieces[ll_insertedrows] = this.id_holdsaledetail.object.totalpieces[li_counter]
				this.id_detail.object.piecesinhand[ll_insertedrows] = this.id_holdsaledetail.object.piecesinhand[li_counter]
				this.id_detail.object.myrowid[ll_insertedrows] = this.id_holdsaledetail.object.myrowid[li_counter]
				this.id_detail.object.yourlotno[ll_insertedrows] = this.id_holdsaledetail.object.yourlotno[li_counter]
				this.id_detail.object.yourpacking[ll_insertedrows] = this.id_holdsaledetail.object.yourpacking[li_counter]
				this.id_detail.object.yourexpiry[ll_insertedrows] = this.id_holdsaledetail.object.yourexpiry[li_counter]
				this.id_detail.object.taxable[ll_insertedrows] = this.id_holdsaledetail.object.taxable[li_counter]
				this.id_detail.object.itemadvancetaxperc[ll_insertedrows] = this.id_holdsaledetail.object.itemadvancetaxperc[li_counter]
				this.id_detail.object.bonusqty[ll_insertedrows] = this.id_holdsaledetail.object.bonusqty[li_counter]
				this.id_detail.object.looseqty[ll_insertedrows] = this.id_holdsaledetail.object.looseqty[li_counter]
				ll_rowgroup = ll_rowgroup + 1
			end if
		next
		wf_grandtotal()
		ld_newinvtotal = this.id_footer.getitemnumber(1, "total")
		if ld_newinvtotal - ld_invtotal > 0.0 then
			this.id_footer.object.flatdisc[1] = this.id_footer.object.flatdisc[1] + round(ld_newinvtotal - ld_invtotal, 2)
			this.id_master.object.flatdisc[1] = this.id_footer.object.flatdisc[1]
		elseif ld_newinvtotal - ld_invtotal < 0.0 then
			this.id_footer.object.misccharges[1] = this.id_footer.object.misccharges[1] + round(ld_invtotal - ld_newinvtotal, 2)
			this.id_master.object.misccharges[1] = this.id_footer.object.misccharges[1]
		end if
		wf_grandtotal()
		setredraw(true)
	end if
	wf_isolatebonusqty(this.id_detail)
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	ll_itemrow = 0
	ls_updatesaleprice = f_stringpreferences("updatesaleprice")
	as_errortext = "    Some database problem ocuurs         "
	ll_rowgroup = 0
	do while li_counter <= ll_detailrows and lb_commitflag
		ll_rowgroup = ll_rowgroup + 1
		ll_gcode = this.id_detail.getitemnumber(li_counter, "gcode")
		li_headerno = this.id_detail.getitemnumber(li_counter, "headerno")
		ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
		ls_itemname = this.id_detail.getitemstring(li_counter, "itemname")
		ls_fullcode = this.id_detail.getitemstring(li_counter, "fullcode")
		ls_alternatecustomicode = this.id_detail.getitemstring(li_counter, "AlternateCustomICode")
		ll_itemtypecode = this.id_detail.getitemnumber(li_counter, "ItemTypeCode")
		ls_packingdesc = this.id_detail.getitemstring(li_counter, "PackingDesc")
		li_itemmetercode = this.id_detail.getitemnumber(li_counter, "itemmetercode")
		ld_meterreading = this.id_detail.getitemnumber(li_counter, "meterreading")
		ld_salelooseqty = this.id_detail.getitemdecimal(li_counter, "looseqty")
		ld_dueqty = this.id_detail.getitemdecimal(li_counter, "dueqty")
		ll_packunits = this.id_detail.getitemnumber(li_counter, "packunits")
		ll_totalpieces = this.id_detail.getitemnumber(li_counter, "totalpieces")
		ll_piecesinhand = this.id_detail.getitemnumber(li_counter, "piecesinhand")
		ld_saleprice = this.id_detail.getitemnumber(li_counter, "saleprice")
		ld_packprice = this.id_detail.getitemnumber(li_counter, "packprice")
		ld_packsaleprice = this.id_detail.getitemnumber(li_counter, "packsaleprice")
		ld_purprice = this.id_detail.getitemnumber(li_counter, "purprice")
		ld_retailprice = this.id_detail.getitemnumber(li_counter, "retailprice")
		ld_recentpurprice = this.id_detail.getitemnumber(li_counter, "recentpurprice")
		ld_discprice = this.id_detail.getitemnumber(li_counter, "discprice")
		ld_salestax = this.id_detail.getitemnumber(li_counter, "salestax")
		ld_purunitrate = this.id_detail.getitemnumber(li_counter, "purunitrate")
		ld_rppunitrate = this.id_detail.getitemnumber(li_counter, "rppunitrate")
		ld_alternatepurprice = this.id_detail.getitemnumber(li_counter, "alternatepurprice")
		ld_packqtyforsale = this.id_detail.getitemnumber(li_counter, "packqtyforsale")
		ld_bonuspackqtyforsale = this.id_detail.getitemnumber(li_counter, "bonuspackqtyforsale")
		ld_unitweight = this.id_detail.getitemnumber(li_counter, "unitweight")
		ld_packingfactor = this.id_detail.getitemnumber(li_counter, "packingfactor")
		ld_packcapacity = this.id_detail.getitemnumber(li_counter, "packcapacity")
		ld_areavolume = this.id_detail.getitemnumber(li_counter, "areavolume")
		ld_pcs = this.id_detail.getitemnumber(li_counter, "pcs")
		ls_cartons = this.id_detail.getitemstring(li_counter, "cartons")
		ld_length = this.id_detail.getitemnumber(li_counter, "length")
		ld_width = this.id_detail.getitemnumber(li_counter, "width")
		ld_rateperlength = this.id_detail.getitemnumber(li_counter, "RatePerlength")
		ld_claimablediscperc = this.id_detail.getitemdecimal(li_counter, "claimablediscperc")
		ld_clonediscperc = this.id_detail.getitemnumber(li_counter, "clonediscperc")
		ld_discperc = this.id_detail.getitemnumber(li_counter, "discperc")
		ld_rate = this.id_detail.getitemnumber(li_counter, "rate")
		ld_itemflatdisc = this.id_detail.getitemnumber(li_counter, "itemflatdisc")
		ld_cloneitemflatdisc = this.id_detail.getitemnumber(li_counter, "cloneitemflatdisc")
		ll_saleorderrowid = this.id_detail.getitemnumber(li_counter, "saleorderrowid")
		ll_refusalsalerowid = this.id_detail.getitemnumber(li_counter, "RefusalSaleRowID")
		ls_saleitemdescription = this.id_detail.getitemstring(li_counter, "saleitemdescription")
		li_inscode = this.id_detail.getitemnumber(li_counter, "inscode")
		ll_taxflag = this.id_detail.getitemnumber(li_counter, "taxflag")
		lc_taxable = this.id_detail.getitemstring(li_counter, "taxable")
		ld_unitsalestax = this.id_detail.getitemnumber(li_counter, "unitsalestax")
		ld_bonusqty = this.id_detail.getitemnumber(li_counter, "bonusqty")
		ld_gstperc = this.id_detail.getitemnumber(li_counter, "gstperc")
		ls_claimable = this.id_detail.getitemstring(li_counter, "claimable")
		ll_descicode = this.id_detail.getitemnumber(li_counter, "DescICode")
		ld_commissionperc = this.id_detail.getitemnumber(li_counter, "CommissionPerc")
		ld_commissionperunit = this.id_detail.getitemnumber(li_counter, "CommissionPerUnit")
		ls_location = this.id_detail.getitemstring(li_counter, "location")
		ls_yourlotno = this.id_detail.object.yourlotno[li_counter]
		ls_yourpacking = this.id_detail.object.yourpacking[li_counter]
		ldt_yourexpiry = this.id_detail.object.yourexpiry[li_counter]
		ls_itempacking = this.id_detail.object.itempacking[li_counter]
		ld_itemadvancetaxperc = this.id_detail.object.itemadvancetaxperc[li_counter]
		ldws_column = this.id_detail.getitemstatus(li_counter, "saleprice", primary!)
		ls_updsaleprice = this.id_detail.getitemstring(li_counter, "updatesaleprice")
		ld_salelooseqty = ld_salelooseqty - ld_dueqty
		this.it_transobject.getitemavgpriceforsale(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			this.it_transobject.getitemtotalpiecesinhand(ll_icode, ll_piecesinhand)
			if this.it_transobject.sqlcode <> 0 then
				lb_commitflag = false
			else
				this.id_detail.setitem(li_counter, "piecesinhand", ll_piecesinhand)
				if ll_piecesinhand >= ll_totalpieces then
					this.it_transobject.updateitemtotalpiecesinhand(ll_icode, -1, ll_totalpieces)
					if this.it_transobject.sqlcode <> 0 then
						lb_commitflag = false
					end if
				end if
			end if
			this.it_transobject.getitemstockall(ll_icode, ld_total_availablestock)
			if lb_commitflag and (ld_salelooseqty + ld_bonusqty > 0.0 and lb_commitflag) then
				if wf_selectitembatches(ll_gcode, ll_icode, ld_salelooseqty, ld_bonusqty, ad_saledetail, ll_insertedrows, as_errortext) = 0 then
					for li_innercounter = 1 to ll_insertedrows
						ll_row = ll_itemrow + li_innercounter
						ad_saledetail.setitem(ll_row, "code", al_invid)
						ad_saledetail.setitem(ll_row, "rowgroup", ll_rowgroup)
						ad_saledetail.setitem(ll_row, "packunits", ll_packunits)
						ad_saledetail.setitem(ll_row, "AlternateCustomICode", ls_alternatecustomicode)
						ad_saledetail.setitem(ll_row, "saleprice", ld_saleprice)
						ad_saledetail.setitem(ll_row, "retailprice", ld_retailprice)
						ad_saledetail.setitem(ll_row, "packprice", ld_packprice)
						ad_saledetail.setitem(ll_row, "packsaleprice", ld_packsaleprice)
						ad_saledetail.setitem(ll_row, "purunitrate", ld_purunitrate)
						ad_saledetail.setitem(ll_row, "taxflag", ll_taxflag)
						ad_saledetail.setitem(ll_row, "rppunitrate", ld_rppunitrate)
						ad_saledetail.setitem(ll_row, "alternatepurprice", ld_alternatepurprice)
						ad_saledetail.setitem(ll_row, "discperc", ld_discperc)
						ad_saledetail.setitem(ll_row, "clonediscperc", ld_clonediscperc)
						ad_saledetail.setitem(ll_row, "claimablediscperc", ld_claimablediscperc)
						ad_saledetail.setitem(ll_row, "rate", ld_rate)
						if li_innercounter = 1 then
							ad_saledetail.setitem(ll_row, "totalpieces", ll_totalpieces)
						else
							ad_saledetail.setitem(ll_row, "totalpieces", 0)
						end if
						ad_saledetail.setitem(ll_row, "piecesinhand", ll_piecesinhand)
						if isnull(ld_avgprice) then
							ld_avgprice = 0
						end if
						if ld_avgprice = 0.0 then
							ad_saledetail.setitem(ll_row, "avgprice", ld_purunitrate)
						else
							ad_saledetail.setitem(ll_row, "avgprice", ld_avgprice)
						end if
						if isnull(ad_saledetail.object.batchcost[ll_row]) then
							ad_saledetail.object.batchcost[ll_row] = ad_saledetail.object.avgprice[ll_row]
						end if
						ad_saledetail.setitem(ll_row, "itemmetercode", li_itemmetercode)
						ad_saledetail.setitem(ll_row, "meterreading", ld_meterreading)
						ad_saledetail.setitem(ll_row, "itemflatdisc", ld_itemflatdisc)
						ad_saledetail.setitem(ll_row, "cloneitemflatdisc", ld_cloneitemflatdisc)
						ad_saledetail.setitem(ll_row, "saleitemdescription", ls_saleitemdescription)
						ad_saledetail.setitem(ll_row, "inscode", li_inscode)
						ad_saledetail.setitem(ll_row, "unitweight", ld_unitweight)
						ad_saledetail.setitem(ll_row, "packingfactor", ld_packingfactor)
						ad_saledetail.setitem(ll_row, "packcapacity", ld_packcapacity)
						ad_saledetail.setitem(ll_row, "areavolume", ld_areavolume)
						ad_saledetail.setitem(ll_row, "pcs", ld_pcs)
						ad_saledetail.setitem(ll_row, "cartons", ls_cartons)
						ad_saledetail.setitem(ll_row, "headerno", li_headerno)
						ad_saledetail.setitem(ll_row, "length", ld_length)
						ad_saledetail.setitem(ll_row, "width", ld_width)
						ad_saledetail.setitem(ll_row, "RatePerlength", ld_rateperlength)
						ad_saledetail.setitem(ll_row, "packqtyforsale", ld_packqtyforsale)
						ad_saledetail.setitem(ll_row, "bonuspackqtyforsale", ld_bonuspackqtyforsale)
						ad_saledetail.setitem(ll_row, "saleorderrowid", ll_saleorderrowid)
						ad_saledetail.setitem(ll_row, "refusalsalerowid", ll_refusalsalerowid)
						ad_saledetail.setitem(ll_row, "sourcesaleinvcode", this.id_detail.getitemnumber(li_counter, "sourcesaleinvcode"))
						ad_saledetail.setitem(ll_row, "salerowid", this.id_detail.getitemnumber(li_counter, "salerowid"))
						ad_saledetail.setitem(ll_row, "issuerowid", this.id_detail.getitemnumber(li_counter, "issuerowid"))
						ad_saledetail.setitem(ll_row, "unitsalestax", ld_unitsalestax)
						ad_saledetail.setitem(ll_row, "gstperc", ld_gstperc)
						ad_saledetail.setitem(ll_row, "claimable", ls_claimable)
						if ld_claimablediscperc > 0.0 then
							ad_saledetail.setitem(ll_row, "claimable", "Y")
						end if
						ad_saledetail.setitem(ll_row, "descicode", ll_descicode)
						ad_saledetail.setitem(ll_row, "commissionperunit", ld_commissionperunit)
						ad_saledetail.setitem(ll_row, "commissionperc", ld_commissionperc)
						ad_saledetail.setitem(ll_row, "yourlotno", ls_yourlotno)
						ad_saledetail.setitem(ll_row, "yourpacking", ls_yourpacking)
						ad_saledetail.setitem(ll_row, "yourexpiry", ldt_yourexpiry)
						ad_saledetail.setitem(ll_row, "taxable", lc_taxable)
						ad_saledetail.setitem(ll_row, "ItemAdvanceTaxPerc", ld_itemadvancetaxperc)
						ad_saledetail.setitem(ll_row, "itempacking", ls_itempacking)
						ad_saledetail.setitem(ll_row, "location", ls_location)
						ld_totalstock = ad_saledetail.getitemnumber(ll_row, "totalstock")
						ad_saledetail.setitem(ll_row, "GodownBalanceStock", ld_totalstock - ld_salelooseqty - ld_bonusqty)
						ls_batch = ad_saledetail.getitemstring(ll_row, "batch")
						ld_expiry = ad_saledetail.getitemdatetime(ll_row, "expiry")
						ld_looseqty = ad_saledetail.getitemnumber(ll_row, "looseqty")
						ld_bonusqty = ad_saledetail.getitemnumber(ll_row, "bonusqty")
						ld_stock = ad_saledetail.getitemnumber(ll_row, "stock")
						if f_stringpreferences("SaleCheckExpiry") = "Y" then
							ll_expirydays = 90
							SQL SELECT saleexpirydays INTO :ll_expirydays FROM ItemCategory , Item WHERE Item.icode =:ll_icode AND Item.icatcode =ItemCategory.ICatCode USING this.it_transobject;
							if this.it_transobject.sqlcode = 0 then
								ll_remainingdays = daysafter(date(this.idt_server_datetime), date(ld_expiry))
								if daysafter(date(this.idt_server_datetime), date(ld_expiry)) < ll_expirydays then
									li_rtmesscode = messagebox("Item Validation", "Current item will expire after " + string(ll_remainingdays) + " days~r~nDo you want to sale this item", information!, yesno!, 2)
									if li_rtmesscode = 2 then
										as_errortext = "  Expiry Problem has been occured      "
										lb_commitflag = false
										li_innercounter = ll_insertedrows
									end if
								end if
							else
								lb_commitflag = false
							end if
						end if
						ll_batchfetch = wf_apply_batchwise_pricing(ll_icode, ls_batch, ld_expiry, ld_batchprice)
						if ll_batchfetch >= 0 and ll_batchfetch = 0 then
							if ll_packunits = 0 or isnull(ll_packunits) then
								ll_packunits = 1
							end if
							ad_saledetail.setitem(ll_row, "saleprice", round(ld_batchprice / ll_packunits, 2))
							ll_rowgroup = ll_rowgroup + 1
							ad_saledetail.setitem(ll_row, "rowgroup", ll_rowgroup)
						end if
						ld_bonusqty = ad_saledetail.getitemnumber(ll_row, "bonusqty")
						ld_newstock = ld_stock - ld_looseqty - ld_bonusqty
						if ld_newstock > 0.0 then
							this.it_transobject.saleupdateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock, ld_stock)
							if this.it_transobject.sqlcode <> 0 then
								lb_commitflag = false
								as_errortext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
							end if
						elseif ld_newstock = 0.0 then
							this.it_transobject.deleteitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
							if this.it_transobject.sqlcode <> 0 then
								lb_commitflag = false
								as_errortext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
							end if
						else
							lb_commitflag = false
							as_errortext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
						end if
						ld_total_availablestock = ld_total_availablestock - ld_looseqty - ld_bonusqty
						ad_saledetail.setitem(ll_row, "balancestock", ld_total_availablestock)
					next
					ll_itemrow = ll_itemrow + ll_insertedrows
				else
					this.id_detail.setitem(li_counter, "stock", ll_insertedrows)
					lb_commitflag = false
				end if
			end if
			if ld_dueqty > 0.0 and lb_commitflag then
				ll_itemrow = ll_itemrow + 1
				ll_duerow = ad_saledetail.insertrow(0)
				ad_saledetail.setitem(ll_itemrow, "code", al_invid)
				ad_saledetail.setitem(ll_itemrow, "icode", ll_icode)
				ad_saledetail.setitem(ll_itemrow, "gcode", ll_gcode)
				ad_saledetail.setitem(ll_itemrow, "AlternateCustomICode", ls_alternatecustomicode)
				ad_saledetail.setitem(ll_itemrow, "batch", "Due")
				ad_saledetail.setitem(ll_itemrow, "expiry", relativedate(today(), 365))
				ad_saledetail.setitem(ll_itemrow, "stock", ld_stock)
				ad_saledetail.setitem(ll_itemrow, "totalstock", 0)
				ad_saledetail.setitem(ll_itemrow, "looseqty", ld_dueqty)
				ad_saledetail.setitem(ll_itemrow, "balancestock", ld_total_availablestock)
				ad_saledetail.setitem(ll_itemrow, "godownbalancestock", ld_totalstock)
				ad_saledetail.setitem(ll_itemrow, "due", "D")
				ad_saledetail.setitem(ll_itemrow, "packunits", ll_packunits)
				ad_saledetail.setitem(ll_itemrow, "packingfactor", ld_packingfactor)
				ad_saledetail.setitem(ll_itemrow, "packcapacity", ld_packcapacity)
				if ll_insertedrows > 0 then
					ad_saledetail.setitem(ll_itemrow, "totalpieces", ll_totalpieces)
				else
					ad_saledetail.setitem(ll_itemrow, "totalpieces", 0)
				end if
				ad_saledetail.setitem(ll_itemrow, "piecesinhand", ll_piecesinhand)
				ad_saledetail.setitem(ll_itemrow, "saleprice", ld_saleprice)
				ad_saledetail.setitem(ll_itemrow, "retailprice", ld_retailprice)
				ad_saledetail.setitem(ll_itemrow, "rate", ld_rate)
				ad_saledetail.setitem(ll_itemrow, "packsaleprice", ld_packsaleprice)
				ad_saledetail.setitem(ll_itemrow, "packprice", ld_packprice)
				ad_saledetail.setitem(ll_itemrow, "purunitrate", ld_purunitrate)
				ad_saledetail.setitem(ll_itemrow, "rppunitrate", ld_rppunitrate)
				ad_saledetail.setitem(ll_itemrow, "alternatepurprice", ld_alternatepurprice)
				ad_saledetail.setitem(ll_itemrow, "areavolume", ld_areavolume)
				ad_saledetail.setitem(ll_itemrow, "pcs", ld_pcs)
				ad_saledetail.setitem(ll_itemrow, "cartons", ls_cartons)
				ad_saledetail.setitem(ll_itemrow, "saleitemdescription", ls_saleitemdescription)
				ad_saledetail.setitem(ll_itemrow, "inscode", li_inscode)
				ad_saledetail.setitem(ll_itemrow, "discperc", ld_discperc)
				ad_saledetail.setitem(ll_itemrow, "clonediscperc", ld_clonediscperc)
				ad_saledetail.setitem(ll_itemrow, "claimable", ls_claimable)
				ad_saledetail.setitem(ll_itemrow, "claimablediscperc", ld_claimablediscperc)
				ad_saledetail.setitem(ll_itemrow, "unitweight", ld_unitweight)
				ad_saledetail.setitem(ll_itemrow, "headerno", li_headerno)
				ad_saledetail.setitem(ll_itemrow, "rowgroup", ll_rowgroup)
				ad_saledetail.setitem(ll_itemrow, "itemmetercode", li_itemmetercode)
				ad_saledetail.setitem(ll_itemrow, "meterreading", ld_meterreading)
				ad_saledetail.setitem(ll_itemrow, "saleorderrowid", ll_saleorderrowid)
				ad_saledetail.setitem(ll_itemrow, "refusalsalerowid", ll_refusalsalerowid)
				ad_saledetail.setitem(ll_itemrow, "sourcesaleinvcode", this.id_detail.getitemnumber(li_counter, "sourcesaleinvcode"))
				ad_saledetail.setitem(ll_itemrow, "salerowid", this.id_detail.getitemnumber(li_counter, "salerowid"))
				ad_saledetail.setitem(ll_itemrow, "issuerowid", this.id_detail.getitemnumber(li_counter, "issuerowid"))
				ad_saledetail.setitem(ll_itemrow, "commissionperunit", ld_commissionperunit)
				ad_saledetail.setitem(ll_itemrow, "commissionperc", ld_commissionperc)
				ad_saledetail.setitem(ll_itemrow, "length", ld_length)
				ad_saledetail.setitem(ll_itemrow, "width", ld_width)
				ad_saledetail.setitem(ll_itemrow, "RatePerlength", ld_rateperlength)
				if isnull(ld_avgprice) then
					ld_avgprice = 0
				end if
				if ld_avgprice = 0.0 then
					ad_saledetail.setitem(ll_itemrow, "avgprice", ld_purunitrate)
				else
					ad_saledetail.setitem(ll_itemrow, "avgprice", ld_avgprice)
				end if
				ad_saledetail.setitem(ll_itemrow, "batchcost", ad_saledetail.object.avgprice[ll_itemrow])
				ad_saledetail.setitem(ll_itemrow, "itemflatdisc", ld_itemflatdisc)
				ad_saledetail.setitem(ll_itemrow, "cloneitemflatdisc", ld_cloneitemflatdisc)
				ad_saledetail.setitem(ll_itemrow, "gstperc", ld_gstperc)
				ad_saledetail.setitem(ll_itemrow, "taxflag", ll_taxflag)
				ad_saledetail.setitem(ll_itemrow, "salestax", ld_salestax)
				ad_saledetail.setitem(ll_itemrow, "unitsalestax", ld_unitsalestax)
				ad_saledetail.setitem(ll_itemrow, "location", ls_location)
				ad_saledetail.setitem(ll_itemrow, "taxable", lc_taxable)
				ad_saledetail.setitem(ll_itemrow, "ItemAdvanceTaxPerc", ld_itemadvancetaxperc)
				ad_saledetail.setitem(ll_itemrow, "packqtyforsale", ld_packqtyforsale)
				ad_saledetail.setitem(ll_itemrow, "bonuspackqtyforsale", ld_bonuspackqtyforsale)
				ad_saledetail.setitem(ll_itemrow, "yourlotno", ls_yourlotno)
				ad_saledetail.setitem(ll_itemrow, "yourpacking", ls_yourpacking)
				ad_saledetail.setitem(ll_itemrow, "yourexpiry", ldt_yourexpiry)
			end if
		else
			lb_commitflag = false
		end if
		li_counter = li_counter + 1
	loop
	if not lb_commitflag then
		al_errorrow = li_counter - 1
		messagebox("Database Error", as_errortext)
	end if
	ad_saledetail.accepttext()
	SQL rollback USING sqlca;
	ul_rowcount = ad_saledetail.rowcount()
	sqlca.getmaxutn(ul_rowcount, ul_maxutn)
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
	else
		SQL rollback USING sqlca;
		messagebox("SAVING", " Error in generating Utn ")
		return false
	end if
	for li_counter = 1 to ad_saledetail.rowcount()
		ad_saledetail.setitem(li_counter, "SaleUtn", ul_maxutn)
		ul_maxutn = ul_maxutn + 1
		ld_looseqty = round(ad_saledetail.object.looseqty[li_counter], li_round_qty)
		ld_bonusqty = round(ad_saledetail.object.bonusqty[li_counter], li_round_qty)
		ld_truncateqty = truncate(ld_looseqty + 0.0000001, li_round_qty)
		if ld_looseqty <> ld_truncateqty then
			al_errorrow = li_counter
			as_errortext = "Invalid Qty as per its column setting"
			messagebox("Qty Precision Error", as_errortext)
			lb_commitflag = false
			exit
		end if
		ld_truncateqty = truncate(ld_bonusqty + 0.0000001, li_round_qty)
		if ld_bonusqty <> ld_truncateqty then
			al_errorrow = li_counter
			as_errortext = "Invalid Bonus as per its column setting"
			messagebox("Bonus Precision Error", as_errortext)
			lb_commitflag = false
			exit
		end if
	next
	ld_invtotal = wf_grandtotal()
	this.id_footer.accepttext()
	this.id_master.setitem(1, "unreceivedbalance", this.id_footer.getitemnumber(1, "total"))
	this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
	this.id_master.setitem(1, "outstandingamt", this.id_master.object.invtotal[1] - this.id_master.object.amt[1])
	return lb_commitflag

// w_sale.wf_show_refusedsale_form() returns 0
	long ll_custcode
	long ll_patientcode
	long ll_found
	string ls_patient
	string ls_custname
	s_datawindow lstr_dw
	if this.tab_retrieve.selectedtab = 1 then
		lstr_dw.dw = this.dw_refusedsaleheader
		lstr_dw.dw2 = this.dw_refusedsaledetail
		ll_custcode = this.id_master.object.custcode[1]
		if ll_custcode > 0 then
			ll_found = 0
			ll_found = this.idc_customers.find("accounts_acccode = " + string(ll_custcode), 1, this.idc_customers.rowcount())
			if ll_found > 0 and ll_found <= this.idc_customers.rowcount() then
				ls_custname = this.idc_customers.getitemstring(ll_found, "customer_name")
			else
				ls_custname = ""
			end if
		end if
		ll_patientcode = this.id_master.object.patientcode[1]
		if ll_patientcode > 0 then
			ll_found = 0
			ll_found = this.idc_patient.find("patientcode = " + string(ll_patientcode), 1, this.idc_patient.rowcount())
			if ll_found > 0 and ll_found <= this.idc_patient.rowcount() then
				ls_patient = this.idc_patient.getitemstring(ll_found, "patient")
			else
				ls_patient = ""
			end if
		end if
		if len(ls_patient) > 0 then
			lstr_dw.s_name1 = ls_custname + ", " + ls_patient
		else
			lstr_dw.s_name1 = ls_custname
		end if
		lstr_dw.i_protect = integer(this.dw_refusedsaledetail.object.itemname.protect)
		openwithparm(w_refusedsale_form, lstr_dw)
		if wf_iseditable() then
			this.lb_refusedsale_in_buffer = true
		end if
		lstr_dw.dw.sharedata(this.dw_refusedsaleheader)
		lstr_dw.dw2.sharedata(this.dw_refusedsaledetail)
	end if

// w_sale.wf_get_refusedsaleinvcode(long al_saleinvcode, ref long al_refinvcode) returns long
	long ll_retcode = 1
	long ll_invcode
	setnull(al_refinvcode)
	SQL SELECT MAX ( RefusedSaleInvCode ) INTO :al_refinvcode FROM RefusedSaleHeader WHERE SaleInvCode =:al_saleinvcode GROUP BY SaleInvCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_retcode = 0
	else
		ll_retcode = 1
	end if
	return ll_retcode

// w_sale.wf_save_refusedsale(boolean ab_flag, long al_saleinvcode, integer ai_usercode, datetime adt_date) returns long
	long ll_icode
	long ll_pk
	long ll_maxretcode
	long ll_counter
	long ll_null
	long ll_refsaleinvcode
	long ll_headerrows
	long ll_detailrows
	long ll_retcode
	double ld_totalstock
	boolean lb_saveit
	setnull(ll_null)
	ll_headerrows = this.dw_refusedsaleheader.rowcount()
	ll_detailrows = this.dw_refusedsaledetail.rowcount()
	if this.ib_modify then
		if ll_headerrows > 0 and ll_detailrows > 0 then
			lb_saveit = true
		elseif ll_headerrows > 0 and ll_detailrows = 0 and wf_get_refusedsaleinvcode(al_saleinvcode, ll_refsaleinvcode) = 0 then
			if ll_refsaleinvcode > 0 then
				lb_saveit = true
			else
				lb_saveit = false
			end if
		else
			lb_saveit = false
		end if
	elseif ll_headerrows > 0 and ll_detailrows > 0 then
		lb_saveit = true
	else
		lb_saveit = false
	end if
	if lb_saveit then
		this.dw_refusedsaleheader.setitem(ll_headerrows, "usercode", ai_usercode)
		this.dw_refusedsaleheader.setitem(ll_headerrows, "date", adt_date)
		this.dw_refusedsaleheader.setitem(ll_headerrows, "saleinvcode", al_saleinvcode)
		ll_pk = this.dw_refusedsaleheader.getitemnumber(ll_headerrows, "code")
		if isnull(ll_pk) then
			ll_maxretcode = wf_tabnewid("refusedsaleheader", ll_pk)
			if ll_maxretcode < 0 then
				SQL rollback USING this.it_transobject;
				ll_retcode = 0
				return ll_retcode
			end if
			return
		end if
		if not isnull(ll_pk) then
			this.dw_refusedsaleheader.setitem(ll_headerrows, "code", ll_pk)
			for ll_counter = 1 to ll_detailrows
				this.dw_refusedsaledetail.setitem(ll_counter, "code", ll_pk)
				if this.dw_refusedsaledetail.getitemnumber(ll_counter, "reasoncode") = 2.0 then
					this.dw_refusedsaledetail.setitem(ll_counter, "unknownitemname", this.dw_refusedsaledetail.getitemstring(ll_counter, "itemname"))
					this.dw_refusedsaledetail.setitem(ll_counter, "icode", ll_null)
					this.dw_refusedsaledetail.setitem(ll_counter, "totalstock", 0)
				else
					ll_icode = this.dw_refusedsaledetail.getitemnumber(ll_counter, "icode")
					this.it_transobject.getitemstockall(ll_icode, ld_totalstock)
					this.dw_refusedsaledetail.setitem(ll_counter, "totalstock", ld_totalstock)
				end if
			next
			if this.dw_refusedsaleheader.update(true, false) < 0 then
				SQL rollback USING this.it_transobject;
				ll_retcode = 0
				return ll_retcode
			elseif this.dw_refusedsaledetail.update() > 0 then
				ll_retcode = 1
				SQL commit USING this.it_transobject;
				this.dw_refusedsaleheader.reset()
				this.dw_refusedsaledetail.reset()
				return ll_retcode
			else
				SQL rollback USING this.it_transobject;
				ll_retcode = 0
				return ll_retcode
			end if
		else
			SQL rollback USING this.it_transobject;
			ll_retcode = 0
			return ll_retcode
		end if
		return
	end if
	return ll_retcode

// w_sale.wf_inititeminfo(long al_icode, long al_row, ref integer ai_rtcode, ref string as_errortext) returns boolean
	boolean retflag = true
	integer ll_oldrtcode
	integer li_gcode
	integer li_defaultgcode
	integer li_defaultgst
	integer ll_custcode
	integer li_flatdiscstatus
	integer li_itemdiscpercno
	integer li_icatcode
	integer li_headerno
	long ll_packunits
	long ll_saleinvcode
	long ll_reorderqty
	long ll_totalpieces
	long ll_piecesinhand
	long ll_itemalertcode
	long ll_itemtypecode
	long ll_itemmetercode
	long ll_itemcode
	long li_discstatus
	long li_prediscstatus
	long ll_qtysale
	long ll_bonus
	long ll_itemdesc_status
	long ll_null
	long ll_found
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_antinorcotix
	string ls_itemtotalval
	string ls_locksaleprice
	string ls_lockdiscperc
	string ls_remarks
	string ls_packingdesc
	string ls_temp
	string ls_alternatecustomicode
	string ls_itempacking
	string ls_location
	char lc_allowsaleindecimalqty
	char lc_taxable
	double ld_rpp
	double ld_purprice
	double ld_flatdisc
	double ld_invdiscperc
	double ld_discperc2
	double ld_discperc3
	double ld_discperc4
	double ld_claimablediscperc
	double ld_taxperc
	double ld_saleprice
	double ld_discperc
	double ld_prediscperc
	double ld_purdiscperc
	double ld_avgprice
	double ld_unitsalestax
	double ld_gstperc1
	double ld_gstperc2
	double ld_packsalestax
	double ld_saleprice2
	double ld_saleprice3
	double ld_saleprice4
	double ld_saleprice5
	double ld_discperc5
	double ld_retailprice
	double ld_custitemcatdiscperc
	double ld_itemflatdisc
	double ld_godownstock
	double ld_totalstock
	double ld_holdlooseqty
	double ld_desiredbonus
	double ld_saleqty
	double ld_packcapacity
	double ld_areavolume
	double ld_length
	double ld_width
	double ld_purunitrate
	double ld_rppunitrate
	double ld_unitweight
	double ld_packingfactor
	double ld_rppmargin
	double ld_alternatepurprice
	double ld_meterreading
	double ld_prefferedsaleqty
	setnull(ls_null)
	setnull(ll_null)
	ll_oldrtcode = ai_rtcode
	ai_rtcode = 1
	SQL SELECT item.customicode , item.name , item.saleprice , item.packunits , item.salediscperc , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.avgprice , item.PurDiscPerc , item.antinorcotix , item.reorderqty , item.purprice , item.recentpurprice , round ( item.Packsalestax / item.packunits , 2 ) , item.gstperc1 , item.gstperc2 , qtysale =item.saleqty , bonus =item.bonusqty , item.Packsalestax , item.flatdisc , item.locksaleprice , item.lockdiscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 , item.remarks , item.retailprice , item.icatcode , itempacking =( SELECT IP.Name FROM ItemPacking IP WHERE IP.Packcode =item.packcode ) , item.packingdesc , round ( item.purprice / item.packunits , 2 ) , round ( item.recentpurprice / item.packunits , 2 ) , item.unitweight , item.packingfactor , item.totalpieces , item.itemalertcode , item.alternatepurprice , item.itemtypecode , item.allowsaleindecimalqty , item.packcapacity , item.areavolume , Item.Width , Item.Length , item.prefferedsaleqty , item.headerno , item.claimablediscperc , item.location , item.taxable INTO :ls_fullcode, :ls_name, :ld_saleprice, :ll_packunits, :ld_discperc, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :ld_avgprice, :ld_purdiscperc, :ls_antinorcotix, :ll_reorderqty, :ld_purprice, :ld_rpp, :ld_unitsalestax, :ld_gstperc1, :ld_gstperc2, :ll_qtysale, :ll_bonus, :ld_packsalestax, :ld_flatdisc, :ls_locksaleprice, :ls_lockdiscperc, :ld_discperc2, :ld_discperc3, :ld_discperc4, :ld_discperc5, :ls_remarks, :ld_retailprice, :li_icatcode, :ls_itempacking, :ls_packingdesc, :ld_purunitrate, :ld_rppunitrate, :ld_unitweight, :ld_packingfactor, :ll_piecesinhand, :ll_itemalertcode, :ld_alternatepurprice, :ll_itemtypecode, :lc_allowsaleindecimalqty, :ld_packcapacity, :ld_areavolume, :ld_width, :ld_length, :ld_prefferedsaleqty, :li_headerno, :ld_claimablediscperc, :ls_location, :lc_taxable FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	if isnull(ll_custcode) then
		retflag = false
		as_errortext = "Validation Error: Select Customer "
	end if
	li_defaultgst = this.id_master.getitemnumber(1, "dd_gstperc")
	SQL SELECT DefaultItemDiscPerc , InvDiscPerc , TaxPerc =( SELECT TC.TaxPerc FROM TaxCategory TC WHERE TC.TaxCategoryCode =Customer.TaxCategoryCode ) INTO :li_itemdiscpercno, :ld_invdiscperc, :ld_taxperc FROM CUSTOMER WHERE CustCode =:ll_custcode USING this.it_transobject;
	if isnull(li_itemdiscpercno) then
		li_itemdiscpercno = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
	else
		if this.il_strategy = 2 then
			li_gcode = wf_getitemassociategcode(al_icode)
		end if
		if this.il_strategy = 1 then
			li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
		end if
	end if
	this.it_transobject.getitemstockall(al_icode, ld_totalstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	ls_alternatecustomicode = this.id_detail.object.alternatecustomicode[al_row]
	if isnull(ls_alternatecustomicode) then
		ls_alternatecustomicode = ""
	end if
	if lower(ls_fullcode) = lower(ls_alternatecustomicode) then
		ls_alternatecustomicode = ls_null
		this.id_detail.object.alternatecustomicode[al_row] = ls_null
	end if
	if retflag then
		ll_itemcode = this.id_detail.getitemnumber(al_row, "itemcode")
		this.id_detail.setitem(al_row, "gcode", li_gcode)
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		this.id_detail.setitem(al_row, "itemtypecode", ll_itemtypecode)
		this.id_detail.setitem(al_row, "headerno", li_headerno)
		this.id_detail.setitem(al_row, "location", ls_location)
		this.id_detail.setitem(al_row, "taxable", lc_taxable)
		if ld_claimablediscperc > 0.0 then
			this.id_detail.setitem(al_row, "claimable", "Y")
		end if
		if this.ib_bringprefsaleqty and (isnull(ll_itemcode) or al_icode <> ll_itemcode) then
			this.id_detail.setitem(al_row, "looseqty", ld_prefferedsaleqty)
		end if
		if this.ic_advancetaxonsale = "Y" and lc_taxable = "Y" then
			this.id_detail.object.itemadvancetaxperc[al_row] = ld_taxperc
		else
			this.id_detail.object.itemadvancetaxperc[al_row] = 0.00
		end if
		li_discstatus = long(this.id_detail.object.discperc.visible)
		li_prediscstatus = long(this.id_detail.object.prediscperc.visible)
		ll_itemdesc_status = long(this.id_detail.object.saleitemdescription.visible)
		li_flatdiscstatus = long(this.id_detail.object.itemflatdisc.visible)
		if this.id_detail.getitemstatus(al_row, "saleprice", primary!) = notmodified! then
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) or this.ib_applyalternatealiasprice = false then
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
					this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice)
					this.id_detail.setitem(al_row, "packprice", ld_saleprice)
					this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
				end if
			case 2.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice2 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice3 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice4 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice5 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_purprice / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_purprice)
				this.id_detail.setitem(al_row, "packprice", ld_purprice)
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_rpp / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_rpp)
				this.id_detail.setitem(al_row, "packprice", ld_rpp)
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
			case else
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_avgprice)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
			end choose
			this.id_detail.setitem(al_row, "discprice", this.id_detail.getitemnumber(al_row, "saleprice") * (1.0 - this.id_detail.getitemnumber(al_row, "discperc") * 0.01))
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) or this.ib_applyalternatealiasprice = false then
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
					this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice)
					this.id_detail.setitem(al_row, "packprice", ld_saleprice)
					this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
				end if
			case 2.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice2 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice3 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice4 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice5 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_purprice / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_purprice)
				this.id_detail.setitem(al_row, "packprice", ld_purprice)
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_rpp / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_rpp)
				this.id_detail.setitem(al_row, "packprice", ld_rpp)
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
			case else
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_avgprice)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
			end choose
			this.id_detail.setitem(al_row, "discprice", this.id_detail.getitemnumber(al_row, "saleprice") * (1.0 - this.id_detail.getitemnumber(al_row, "discperc") * 0.01))
		end if
		if li_discstatus = 1 and this.id_detail.getitemstatus(al_row, "discperc", primary!) = notmodified! then
			if wf_getcustitemcatwisesalesdiscount(al_icode, ll_custcode, ld_custitemcatdiscperc, ld_prediscperc, ld_itemflatdisc) = true then
				this.id_detail.setitem(al_row, "discperc", ld_custitemcatdiscperc)
				this.id_detail.setitem(al_row, "itemflatdisc", ld_itemflatdisc)
				if li_prediscstatus = 1 then
					this.id_detail.setitem(al_row, "prediscperc", ld_prediscperc)
					this.id_detail.setitem(al_row, "itemflatdisc", round(this.id_detail.object.saleprice[al_row] * ld_prediscperc * 0.01, 2))
				else
					this.id_detail.setitem(al_row, "prediscperc", 0)
				end if
				this.id_detail.setitem(al_row, "cloneitemflatdisc", this.id_detail.object.itemflatdisc[al_row])
			elseif long(this.id_detail.object.discperc.visible) = 1 then
				choose case li_itemdiscpercno
				case 1
					this.id_detail.setitem(al_row, "discperc", ld_discperc)
				case 2
					this.id_detail.setitem(al_row, "discperc", ld_discperc2)
				case 3
					this.id_detail.setitem(al_row, "discperc", ld_discperc3)
				case 4
					this.id_detail.setitem(al_row, "discperc", ld_discperc4)
				case 5
					this.id_detail.setitem(al_row, "discperc", ld_discperc5)
				end choose
			else
				this.id_detail.setitem(al_row, "discperc", 0)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") and li_discstatus = 1 then
			if wf_getcustitemcatwisesalesdiscount(al_icode, ll_custcode, ld_custitemcatdiscperc, ld_prediscperc, ld_itemflatdisc) = true then
				this.id_detail.setitem(al_row, "discperc", ld_custitemcatdiscperc)
				this.id_detail.setitem(al_row, "itemflatdisc", ld_itemflatdisc)
				if li_prediscstatus = 1 then
					this.id_detail.setitem(al_row, "prediscperc", ld_prediscperc)
					this.id_detail.setitem(al_row, "itemflatdisc", round(this.id_detail.object.saleprice[al_row] * ld_prediscperc * 0.01, 2))
				else
					this.id_detail.setitem(al_row, "prediscperc", 0)
				end if
				this.id_detail.setitem(al_row, "cloneitemflatdisc", this.id_detail.object.itemflatdisc[al_row])
			else
				choose case li_itemdiscpercno
				case 1
					this.id_detail.setitem(al_row, "discperc", ld_discperc)
				case 2
					this.id_detail.setitem(al_row, "discperc", ld_discperc2)
				case 3
					this.id_detail.setitem(al_row, "discperc", ld_discperc3)
				case 4
					this.id_detail.setitem(al_row, "discperc", ld_discperc4)
				case 5
					this.id_detail.setitem(al_row, "discperc", ld_discperc5)
				end choose
			end if
		end if
		if this.id_detail.getitemstatus(al_row, "itemalertcode", primary!) = notmodified! then
			ai_rtcode = wf_show_itemalert(ll_itemalertcode)
			if ai_rtcode < 0 then
				retflag = false
				setnull(as_errortext)
			else
				this.id_detail.setitem(al_row, "itemalertcode", ll_itemalertcode)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			ai_rtcode = wf_show_itemalert(ll_itemalertcode)
			if ai_rtcode < 0 then
				retflag = false
				setnull(as_errortext)
			else
				this.id_detail.setitem(al_row, "itemalertcode", ll_itemalertcode)
			end if
		end if
		this.id_detail.setitem(al_row, "icode", al_icode)
		this.id_detail.setitem(al_row, "packunits", ll_packunits)
		this.id_detail.setitem(al_row, "stock", ld_godownstock)
		this.id_detail.setitem(al_row, "packcapacity", ld_packcapacity)
		if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
			ld_areavolume = 1
		end if
		if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
			ld_packcapacity = 1
		end if
		this.id_detail.setitem(al_row, "areavolume", ld_areavolume)
		this.id_detail.setitem(al_row, "pcs", round(this.id_detail.object.looseqty[al_row] / ld_areavolume, 6))
		this.id_detail.setitem(al_row, "cartons", trim(string(long(this.id_detail.object.pcs[al_row] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[al_row] mod ld_packcapacity, 2))))))
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			this.id_detail.setitem(al_row, "width", ld_width)
			this.id_detail.setitem(al_row, "length", ld_length)
		end if
		if ld_length <= 0.0 then
			ld_length = 1
		end if
		this.id_detail.setitem(al_row, "rateperlength", round(this.id_detail.object.saleprice[al_row] / ld_length, 2))
		if not (len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode)) then
			wf_set_packingdescription(ls_alternatecustomicode, ls_packingdesc)
		end if
		this.id_detail.setitem(al_row, "itempacking", ls_itempacking)
		this.id_detail.setitem(al_row, "packingdesc", ls_packingdesc)
		this.id_detail.setitem(al_row, "totalstock", ld_totalstock)
		this.id_detail.setitem(al_row, "piecesinhand", ll_piecesinhand)
		if ll_piecesinhand = 0 then
			this.id_detail.setitem(al_row, "totalpieces", 0)
		end if
		this.id_detail.setitem(al_row, "retailprice", ld_retailprice / ll_packunits)
		this.id_detail.setitem(al_row, "saleorderrowid", ll_null)
		this.id_detail.setitem(al_row, "unitweight", ld_unitweight)
		this.id_detail.setitem(al_row, "packingfactor", ld_packingfactor)
		if li_flatdiscstatus = 1 then
			if this.id_detail.getitemstatus(al_row, "itemflatdisc", primary!) = notmodified! then
				this.id_detail.setitem(al_row, "itemflatdisc", ld_flatdisc)
			end if
		elseif isnull(this.id_detail.object.itemflatdisc[al_row]) then
			this.id_detail.setitem(al_row, "itemflatdisc", 0)
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			if li_flatdiscstatus = 1 then
				this.id_detail.setitem(al_row, "itemflatdisc", ld_flatdisc)
			else
				this.id_detail.setitem(al_row, "itemflatdisc", 0.00)
			end if
			this.id_detail.setitem(al_row, "claimablediscperc", ld_claimablediscperc)
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			this.id_detail.object.cloneitemflatdisc[al_row] = this.id_detail.object.itemflatdisc[al_row]
			this.id_detail.object.clonediscperc[al_row] = this.id_detail.object.discperc[al_row]
		end if
		if f_stringpreferences("SaleCopyItemRemarks") = "Y" and this.id_detail.getitemstatus(al_row, "saleitemdescription", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "saleitemdescription", ls_remarks)
		end if
		this.id_detail.setitem(al_row, "recentpurprice", ld_rpp)
		this.id_detail.setitem(al_row, "purprice", ld_purprice)
		if ld_avgprice = 0.0 then
			this.id_detail.setitem(al_row, "avgprice", ld_purunitrate)
		else
			this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
		end if
		if this.id_detail.getitemstatus(al_row, "purunitrate", primary!) = new! or this.id_detail.getitemstatus(al_row, "purunitrate", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "purunitrate", ld_purunitrate)
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			this.id_detail.setitem(al_row, "purunitrate", ld_purunitrate)
		end if
		this.id_detail.setitem(al_row, "rppunitrate", ld_rppunitrate)
		this.id_detail.setitem(al_row, "alternatepurprice", ld_alternatepurprice)
		this.id_detail.setitem(al_row, "itemtotalval", ls_itemtotalval)
		if f_stringpreferences("bonusinsale") = "Y" then
			this.id_detail.setitem(al_row, "qtysale", ll_qtysale)
			this.id_detail.setitem(al_row, "bonus", ll_bonus)
			this.id_footer.setitem(1, "bonusratio", trim(string(ll_qtysale)) + ":" + trim(string(ll_bonus)))
			if ll_qtysale = ll_bonus and ll_qtysale = this.id_detail.object.looseqty[al_row] then
				this.id_detail.object.bonusqty[al_row] = ll_bonus
			end if
		end if
		if this.id_detail.getitemstatus(al_row, "Unitsalestax", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
		end if
		if this.id_detail.getitemstatus(al_row, "gstperc", primary!) = notmodified! then
			if li_defaultgst = 2 then
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
			if li_defaultgst = 2 then
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
			end if
			if f_stringpreferences("SaleCopyItemRemarks") = "Y" then
				this.id_detail.setitem(al_row, "saleitemdescription", ls_remarks)
			end if
		end if
		this.id_detail.setitem(al_row, "allowsaleindecimalqty", lc_allowsaleindecimalqty)
		this.id_detail.setitem(al_row, "locksaleprice", ls_locksaleprice)
		this.id_detail.setitem(al_row, "lockdiscperc", ls_lockdiscperc)
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 550 ", 1, gds_securitywindow.rowcount())
		if f_stringpreferences("salesmodulemode") = "A" and ll_found > 0 then
			this.id_detail.accepttext()
			ai_rtcode = wf_autodue(al_row, string(this.id_detail.object.looseqty[al_row]))
			if ai_rtcode <> 0 then
				retflag = false
				ai_rtcode = -1
			end if
		elseif ld_godownstock = 0.0 then
			ai_rtcode = -2
			as_errortext = "Item can not be sold, its Stock is Zero"
		end if
	else
		retflag = false
		as_errortext = "Item can not be sold, its Stock is Zero"
	end if
	if f_stringpreferences("salepromptforreorder") = "Y" and ll_reorderqty > ld_godownstock then
		messagebox("Stock", "Stock for this item become~r~n less than ReorderQty")
	end if
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_totalstock)
	this.id_footer.setitem(1, "piecesinhand", ll_piecesinhand)
	this.id_footer.setitem(1, "retailprice", ld_retailprice / ll_packunits)
	ld_rppmargin = this.id_detail.object.packprice[al_row] - ld_rpp
	if this.id_detail.object.packprice[al_row] = 0 then
		ld_rppmargin = ld_rppmargin * 100.0
	else
		ld_rppmargin = ld_rppmargin / this.id_detail.object.packprice[al_row] * 100
	end if
	this.id_footer.setitem(1, "rppmargin", ld_rppmargin)
	this.id_footer.setitem(1, "rpp", ld_rpp)
	this.id_footer.setitem(1, "purprice", ld_purprice)
	this.id_footer.setitem(1, "avgprice", ld_avgprice)
	this.id_footer.setitem(1, "itemtotalval", ls_itemtotalval)
	if this.id_footer.getitemstatus(1, "invdiscperc", primary!) = notmodified! and this.ib_modify = false then
		this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
	end if
	if f_stringpreferences("bonusinsale") = "Y" then
		this.id_footer.setitem(1, "bonusratio", trim(string(ll_qtysale)) + ":" + trim(string(ll_bonus)))
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			ld_holdlooseqty = this.id_detail.getitemnumber(al_row, "looseqty")
			if this.id_detail.getitemnumber(al_row, "qtysale") = 0.0 then
				ld_desiredbonus = 0
			else
				ld_desiredbonus = int(ld_holdlooseqty / double(this.id_detail.getitemnumber(al_row, "qtysale")) * double(this.id_detail.getitemnumber(al_row, "Bonus")))
			end if
			if ld_holdlooseqty + ld_desiredbonus <= ld_godownstock then
				this.id_detail.setitem(al_row, "bonusqty", ld_desiredbonus)
			elseif ld_holdlooseqty > ld_godownstock then
				if this.id_detail.object.due[this.id_detail.rowcount()] <> "D" then
					messagebox("Quantity Validation", "Quantity " + string(ld_holdlooseqty) + " exceeds stock " + string(ld_godownstock) + ".")
					this.id_detail.setitem(al_row, "looseqty", 1)
					this.id_detail.setitem(al_row, "bonusqty", 0)
				end if
			else
				ld_desiredbonus = messagebox("Problem allocating bonus", "Sale Qty = " + string(ld_holdlooseqty) + " ~r" + "Required Bonus = " + trim(string(ld_desiredbonus)) + " ~r" + "Stock available = " + trim(string(ld_godownstock)) + " ~r" + "Allocate possible bonus?", question!, yesno!, 2)
				if ld_desiredbonus = 1.0 then
					this.id_detail.setitem(al_row, "bonusqty", ld_godownstock - ld_holdlooseqty)
				else
					retflag = false
					this.id_detail.setitem(al_row, "bonusqty", 0)
				end if
			end if
		end if
	end if
	this.id_footer.object.t_purdiscper.text = string(ld_purdiscperc)
	if al_icode > 0 and (al_icode <> this.id_detail.object.itemcode[al_row] or isnull(this.id_detail.object.itemcode[al_row])) then
		wf_setcustomerlatestnetrate(ll_custcode, al_icode, al_row)
		wf_setcustomerlatestsaleprice(ll_custcode, al_icode, al_row)
		if f_stringpreferences("AutoShowPrevInvInfo") = "Y" then
			wf_preinvinfo()
		end if
	end if
	if retflag and ai_rtcode = 0 and ll_oldrtcode = 1 then
		wf_set_salesets_data(al_row, al_icode, 1, 1)
	end if
	this.id_detail.setitem(al_row, "itemcode", al_icode)
	if ls_antinorcotix = "Y" and retflag = true and not (this.il_norcotixcode = al_icode) and isnull(trim(this.id_master.getitemstring(1, "remarks"))) then
		messagebox("Item Validation", "This is Narcotics item ~r~n please type Doctor name in remarks")
		this.il_norcotixcode = al_icode
		retflag = false
		this.il_norcotixcode = al_icode
		if f_stringpreferences("doctnamefornorcotix") = "Y" then
			this.id_master.setfocus()
			this.id_master.setcolumn("remarks")
		end if
	end if
	wf_set_itemimage(al_icode)
	return retflag

// w_sale.wf_savastemplate() returns integer
	s_saletemplateheader lstr_templateheader
	long ll_invid
	integer li_retcode = 1
	long ll_code
	long ll_qty
	long ll_icode
	long ll_totalrows
	long ll_rowcount
	open(w_savesaleastemplate)
	lstr_templateheader = message.powerobjectparm
	f_newtableid("SaleTemplateHeader", ll_invid)
	SQL INSERT INTO SaleTemplateHeader ( saletemplatecode , date , modified , name ) values ( :ll_invid , :lstr_templateheader.dt_templatedate , :lstr_templateheader.dt_templatedate , :lstr_templateheader.s_template ) USING sqlca;
	ll_totalrows = this.id_detail.rowcount()
	for ll_rowcount = 1 to ll_totalrows
		ll_code = ll_invid
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ll_qty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		SQL insert into saletemplatedetail ( saletemplatecode , icode , looseqty ) values ( :ll_code , :ll_icode , :ll_qty ) USING sqlca;
	next
	setpointer(hourglass!)
	if this.it_transobject.sqlcode < 0 then
		SQL rollback USING sqlca;
		setpointer(arrow!)
		return li_retcode
	else
		SQL commit USING sqlca;
		messagebox("Save Changes", "Template saved", exclamation!, ok!, 1)
	end if
	return li_retcode

// w_sale.wf_editquotation() returns integer
	datastore lds_quotationdetail
	datastore lds_quotationheader
	datastore lds_items
	s_saletemplate lstr_template
	integer li_quot_populate_setting
	boolean lb_enablesave
	boolean lb_editsaleprice
	boolean lb_insertrow
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_option
	long ll_currrow
	long ll_packunits
	long ll_found
	long ll_populatecount
	long ll_drow
	long ll_ds_row
	long ll_custcode
	long ll_usesaleinv
	long ll_loosepack
	integer li_retcode = 1
	integer li_errcode
	string ls_errortext
	string ls_itemname
	string ls_loosepack
	string ls_customer
	double ld_price
	double ld_tmpprice
	double ld_qty
	double ld_bonusqty
	double ld_stock
	double ld_tmpqty
	double ld_tmpbonus
	double ld_itemflatdisc
	double ld_discperc
	if wf_iseditable() = false then
		return 0
	end if
	li_quot_populate_setting = f_numberpreferences("quotationpopulationsetting")
	lds_quotationdetail = create datastore
	lds_quotationheader = create datastore
	lds_items = create datastore
	open(w_editquotationform_using_preferences)
	lstr_template = message.powerobjectparm
	if f_stringpreferences("AllowDupQuotInSale") = "N" and wf_quotationinuse(lstr_template.l_invtemplate, ll_usesaleinv) <> 0 then
		setredraw(true)
		messagebox("Quotation Validation", "Quotation already used in Invoice No: " + string(ll_usesaleinv), stopsign!)
		return -1
	end if
	if lstr_template.c_copyinvfrom = "T" then
		lds_quotationdetail.dataobject = "d_quotationdetail_retrieve_sale"
		lds_quotationdetail.settransobject(this.it_transobject)
		lds_quotationheader.dataobject = "d_quotationheader"
		lds_quotationheader.settransobject(this.it_transobject)
		lds_items.dataobject = "d_quotation_salepopulation_rejected"
		lds_items.settransobject(this.it_transobject)
		ll_row = lds_quotationheader.retrieve(lstr_template.l_invtemplate)
		lds_quotationdetail.retrieve(lstr_template.l_invtemplate, lstr_template.i_invtype)
		if ll_row < 0 then
			li_retcode = -1
		end if
		setredraw(false)
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 511", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			lb_editsaleprice = true
		end if
		ll_mrow = this.id_master.getrow()
		this.id_master.setitem(ll_mrow, "quotationno", lstr_template.l_invtemplate)
		ll_custcode = lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "custcode")
		SQL Select Name INTO :ls_customer From Accounts Where AccCode =:ll_custcode USING this.it_transobject;
		if this.ii_saletype = 2 then
			this.id_master.setitem(ll_mrow, "custcode", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "custcode"))
		end if
		this.id_master.setitem(ll_mrow, "custrefno5", lds_quotationheader.getitemstring(lds_quotationheader.getrow(), "remarks9"))
		this.id_master.setitem(ll_mrow, "sprice", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "sprice"))
		this.id_master.setitem(ll_mrow, "remarks", lds_quotationheader.getitemstring(lds_quotationheader.getrow(), "remarks"))
		this.id_master.setitem(ll_mrow, "headerno", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "headerno"))
		this.id_footer.setitem(ll_mrow, "misccharges", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "misccharges"))
		this.id_footer.setitem(ll_mrow, "flatdisc", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "flatdisc"))
		if li_quot_populate_setting = 2 then
			wf_setcustomerinfo(1, 1, string(ll_custcode))
		end if
		ll_loosepack = lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "loosepack")
		ll_totalrows = lds_quotationdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for ll_rowcount = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		this.id_detail.reset()
		for ll_rowcount = 1 to ll_totalrows
			ll_packunits = lds_quotationdetail.getitemnumber(ll_rowcount, "packunits")
			if ll_packunits = 0 then
				ll_packunits = 1
			end if
			ll_populatecount = ll_populatecount + 1
			ll_drow = this.id_detail.insertrow(0)
			li_errcode = 0
			ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_quotationdetail.getitemnumber(ll_rowcount, "gcode")), 1, this.idc_godown.rowcount())
			ls_itemname = lds_quotationdetail.getitemstring(ll_rowcount, "itemname")
			wf_inititeminfo(lds_quotationdetail.getitemnumber(ll_rowcount, "icode"), ll_drow, li_errcode, ls_errortext)
			ll_packunits = lds_quotationdetail.getitemnumber(ll_rowcount, "packunits")
			if ll_packunits = 0 then
				ll_packunits = 1
			end if
			this.id_detail.setitem(ll_drow, "packunits", ll_packunits)
			if ll_loosepack = 1 then
				ld_qty = lds_quotationdetail.getitemnumber(ll_rowcount, "looseqty")
				ld_bonusqty = lds_quotationdetail.getitemnumber(ll_rowcount, "bonusqty")
				ld_price = lds_quotationdetail.getitemnumber(ll_rowcount, "saleprice")
			else
				ld_qty = lds_quotationdetail.getitemnumber(ll_rowcount, "looseqty") * ll_packunits
				ld_bonusqty = lds_quotationdetail.getitemnumber(ll_rowcount, "bonusqty") * ll_packunits
				ld_price = round(lds_quotationdetail.getitemnumber(ll_rowcount, "saleprice") / ll_packunits, 2)
			end if
			if li_quot_populate_setting = 1 then
				ld_price = ld_price
				ld_itemflatdisc = lds_quotationdetail.getitemnumber(ll_rowcount, "itemflatdisc")
				ld_discperc = lds_quotationdetail.getitemnumber(ll_rowcount, "discperc")
			elseif li_quot_populate_setting = 2 then
				ld_price = this.id_detail.object.saleprice[ll_drow]
				ld_itemflatdisc = this.id_detail.object.itemflatdisc[ll_drow]
				ld_discperc = this.id_detail.object.discperc[ll_drow]
			else
				ld_price = this.id_detail.object.saleprice[ll_drow]
				ld_itemflatdisc = this.id_detail.object.itemflatdisc[ll_drow]
				ld_discperc = this.id_detail.object.discperc[ll_drow]
			end if
			if lstr_template.i_invtype <> 0 then
				ld_tmpqty = ld_qty - lds_quotationdetail.getitemnumber(ll_rowcount, "soldqty")
				ld_tmpbonus = ld_bonusqty - lds_quotationdetail.getitemnumber(ll_rowcount, "soldbonus")
				if ld_tmpqty > 0.0 then
					ld_qty = ld_tmpqty
				else
					ld_qty = 0
				end if
				if ld_tmpbonus > 0.0 then
					ld_bonusqty = ld_tmpbonus
				else
					ld_bonusqty = 0
				end if
			end if
			if ld_qty > 0.0 or ld_bonusqty > 0.0 then
				this.id_detail.setitem(ll_drow, "looseqty", ld_qty)
				this.id_detail.setitem(ll_drow, "bonusqty", ld_bonusqty)
				this.id_detail.setitem(ll_drow, "saleprice", ld_price)
				this.id_detail.setitem(ll_drow, "discprice", ld_price)
				this.id_detail.setitem(ll_drow, "discperc", ld_discperc)
				if lds_quotationdetail.object.claimablediscperc[ll_rowcount] > 0 then
					this.id_detail.setitem(ll_drow, "claimable", "Y")
				else
					this.id_detail.setitem(ll_drow, "claimable", "N")
				end if
				this.id_detail.setitem(ll_drow, "claimablediscperc", lds_quotationdetail.object.claimablediscperc[ll_rowcount])
				this.id_detail.setitem(ll_drow, "itemflatdisc", ld_itemflatdisc)
				this.id_detail.object.taxflag[ll_drow] = 0
				ld_stock = this.id_detail.getitemnumber(ll_drow, "stock")
				if ld_qty + ld_bonusqty > ld_stock then
					ll_ds_row = lds_items.insertrow(0)
					lds_items.setitem(ll_ds_row, "customer", ls_customer)
					lds_items.setitem(ll_ds_row, "code", lds_quotationdetail.getitemnumber(ll_rowcount, "code"))
					lds_items.setitem(ll_ds_row, "icode", lds_quotationdetail.getitemnumber(ll_rowcount, "icode"))
					if lds_quotationheader.getitemnumber(1, "loosepack") = 1.0 then
						ls_loosepack = "Loose"
						lds_items.setitem(ll_ds_row, "stock", this.id_detail.getitemnumber(ll_drow, "stock"))
						lds_items.setitem(ll_ds_row, "balance", lds_quotationdetail.getitemnumber(ll_rowcount, "looseqty") - ld_stock)
					else
						ls_loosepack = "Pack"
						if long(ld_stock) mod ll_packunits = 0 then
							lds_items.setitem(ll_ds_row, "stock", ld_stock / ll_packunits)
						else
							lds_items.setitem(ll_ds_row, "stock", ld_stock)
							lds_items.setitem(ll_ds_row, "stockloosepack", "L")
						end if
						if (ld_qty - ld_stock) mod ll_packunits = 0.0 then
							lds_items.setitem(ll_ds_row, "balance", (ld_qty - ld_stock) / ll_packunits)
						else
							lds_items.setitem(ll_ds_row, "balance", ld_qty - ld_stock)
							lds_items.setitem(ll_ds_row, "balanceloosepack", "L")
						end if
					end if
					lds_items.setitem(ll_ds_row, "type", ls_loosepack)
					lds_items.setitem(ll_ds_row, "customer", ls_customer)
					lds_items.setitem(ll_ds_row, "aliasname", this.id_detail.getitemstring(ll_drow, "fullcode"))
					lds_items.setitem(ll_ds_row, "itemname", lds_quotationdetail.getitemstring(ll_rowcount, "itemname"))
					lds_items.setitem(ll_ds_row, "qty", lds_quotationdetail.getitemnumber(ll_rowcount, "looseqty"))
					if ld_stock > ld_qty and ld_stock > 0.0 then
						this.id_detail.setitem(ll_drow, "looseqty", ld_qty)
						if ld_stock - ld_qty > ld_bonusqty then
							this.id_detail.setitem(ll_drow, "bonusqty", ld_stock - ld_qty)
						else
							this.id_detail.setitem(ll_drow, "bonusqty", ld_stock - ld_qty)
						end if
					elseif ld_stock <= 0.0 then
						this.id_detail.setitem(ll_drow, "looseqty", 1)
					else
						this.id_detail.setitem(ll_drow, "looseqty", ld_stock)
					end if
					if ld_stock <= 0.0 then
						this.id_detail.setrow(ll_drow)
						this.id_detail.scrolltorow(ll_drow)
						event ue_deleteitem()
					end if
				end if
			else
				this.id_detail.scrolltorow(ll_drow)
				this.id_detail.setrow(ll_drow)
				event ue_deleteitem()
			end if
		next
		this.id_footer.setitem(ll_mrow, "invdiscperc", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "discperc"))
		setredraw(true)
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return li_retcode

// w_sale.wf_allowinvoice(long al_custcode, ref long al_lastinvcode) returns long
	long ll_retcode
	long ll_code
	if this.ib_modify then
		ll_code = this.id_master.getitemnumber(this.id_master.rowcount(), "code")
		SQL SELECT COUNT ( CustCode ) , max ( SaleInvCode ) INTO :ll_retcode, :al_lastinvcode FROM SaleLedger WHERE CustCode =:al_custcode and SaleInvCode <> :ll_code and Posted ='N' AND Deleted ='N' AND ImpactInventory ='Y' USING this.it_transobject;
	else
		SQL SELECT COUNT ( CustCode ) , max ( SaleInvCode ) INTO :ll_retcode, :al_lastinvcode FROM SaleLedger WHERE CustCode =:al_custcode and Posted ='N' AND Deleted ='N' AND ImpactInventory ='Y' USING this.it_transobject;
	end if
	return ll_retcode

// w_sale.wf_selectprintreport(string as_invoicesize) returns string
	string ls_pagesize
	string ls_report
	long ll_currrow
	boolean lb_listtab
	integer li_headerno
	ls_pagesize = as_invoicesize
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab then
		li_headerno = this.id_list.getitemnumber(this.id_list.getrow(), "headerno")
	else
		li_headerno = this.id_master.getitemnumber(1, "headerno")
	end if
	ls_report = f_getsaleprintout(ls_pagesize, this.ib_printout, li_headerno)
	this.id_print.dataobject = ls_report
	f_set_headerlogo(this.id_print, li_headerno)
	this.id_print.settransobject(this.it_transobject)
	this.ib_printout = true
	return ls_report

// w_sale.wf_allow_sale_to_customer_below_avgprice(long al_custcode) returns long
	char ls_allow = "N"
	SQL SELECT AllowSaleBelowAvgPrice INTO :ls_allow FROM CUSTOMER WHERE CustCode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ls_allow = "Y" then
			return 1
		else
			return 0
		end if
		return
	end if
	return -1

// w_sale.wf_printbarcode() returns 0
	s_datawindow lstr_arg
	long ll_custcode
	long ll_saleinvcode
	long ll_doctcode
	long ll_patientcode
	string ls_datawindow
	string ls_name
	string ls_doctor
	string ls_patient
	datastore lds_detail
	lds_detail = create datastore
	if this.tab_retrieve.selectedtab = 1 then
		lds_detail.dataobject = this.id_detail.dataobject
		lds_detail.settransobject(this.it_transobject)
		ll_custcode = this.id_master.object.custcode[1]
		ll_patientcode = this.id_master.object.patientcode[1]
		ll_doctcode = this.id_master.object.doctcode[1]
		SQL SELECT Customer =( SELECT Name FROM Accounts WHERE AccCode =:ll_custcode ) , Patient =( SELECT Name FROM Patient WHERE PatientCode =:ll_patientcode ) , Doctor =( SELECT Name FROM Doctors WHERE DoctCode =:ll_doctcode ) INTO :ls_name, :ls_patient, :ls_doctor FROM ( SELECT A =1 ) AS P USING this.it_transobject;
		if this.id_detail.rowcount() > 0 then
			this.id_detail.rowscopy(1, this.id_detail.rowcount(), primary!, lds_detail, 1, primary!)
		end if
		lstr_arg.l_code2 = 3
		lstr_arg.s_name1 = ls_name
		lstr_arg.s_name2 = ls_patient
		lstr_arg.s_name3 = ls_doctor
		lstr_arg.dws = lds_detail
		lstr_arg.l_code = 3
		lstr_arg.l_code3 = 2
		openwithparm(w_barcodelabels_popup, lstr_arg)
		return
	end if
	if this.id_list.getrow() > 0 then
		ll_saleinvcode = this.id_list.object.code[this.id_list.getrow()]
		lds_detail.dataobject = "d_saledetail"
		lds_detail.settransobject(this.it_transobject)
		lds_detail.retrieve(ll_saleinvcode)
		ll_custcode = this.id_list.object.custcode[this.id_list.getrow()]
		ll_patientcode = this.id_list.object.patientcode[this.id_list.getrow()]
		ll_doctcode = this.id_list.object.doctcode[this.id_list.getrow()]
		SQL SELECT Customer =( SELECT Name FROM Accounts WHERE AccCode =:ll_custcode ) , Patient =( SELECT Name FROM Patient WHERE PatientCode =:ll_patientcode ) , Doctor =( SELECT Name FROM Doctors WHERE DoctCode =:ll_doctcode ) INTO :ls_name, :ls_patient, :ls_doctor FROM ( SELECT A =1 ) AS P USING this.it_transobject;
		lstr_arg.l_code2 = 3
		lstr_arg.s_name1 = ls_name
		lstr_arg.s_name2 = ls_patient
		lstr_arg.s_name3 = ls_doctor
		lstr_arg.dws = lds_detail
		lstr_arg.l_code = 3
		lstr_arg.l_code3 = 3
		openwithparm(w_barcodelabels_popup, lstr_arg)
	end if

// w_sale.wf_show_receivableadjustment_form() returns 0
	s_datawindow lstr_dw
	wf_grandtotal()
	if this.ii_saletype <> 3 then
		if f_stringpreferences("showmastercashwinincrsale") = "Y" then
			return
		end if
		if this.id_master.getitemstring(1, "accountfor") = "Y" then
			if f_stringpreferences("AskForRecAdjInCreditSale") = "Y" then
				if this.tab_retrieve.selectedtab = 1 then
					lstr_dw.dw = this.dw_receivable_adjdetail
					lstr_dw.i_protect = integer(this.dw_receivable_adjdetail.object.accountname.protect)
					lstr_dw.l_code = this.id_master.getitemnumber(this.id_master.rowcount(), "code")
					lstr_dw.l_code2 = this.id_master.getitemnumber(this.id_master.rowcount(), "custcode")
					lstr_dw.s_name1 = this.id_master.getitemstring(this.id_master.rowcount(), "aliasname")
					lstr_dw.d_amt = this.id_footer.getitemnumber(this.id_footer.rowcount(), "total")
					lstr_dw.d_amt2 = this.id_master.getitemnumber(this.id_master.rowcount(), "amt")
					openwithparm(w_sale_receivable_adj, lstr_dw)
					lstr_dw = message.powerobjectparm
					if lstr_dw.i_status = 1 then
						this.id_master.setitem(this.id_master.rowcount(), "outstandingamt", lstr_dw.d_amt3)
						lstr_dw.dw.sharedata(this.dw_receivable_adjdetail)
					end if
				end if
			end if
		end if
	elseif f_stringpreferences("showmastercashwinincashsale") = "Y" then
		return
	end if

// w_sale.wf_populate_receivable_adjustment(long al_saleinvcode) returns long
	long ll_counter
	long ll_null
	long ll_detailrows
	long ll_retcode = 2
	boolean lb_saveit
	setnull(ll_null)
	ll_detailrows = this.dw_receivable_adjdetail.rowcount()
	if ll_detailrows > 0 then
		for ll_counter = 1 to ll_detailrows
			this.dw_receivable_adjdetail.setitem(ll_counter, "code", al_saleinvcode)
			if this.dw_receivable_adjdetail.getitemstring(ll_counter, "treatment") = "I" then
				this.dw_receivable_adjdetail.setitem(ll_counter, "debit", 0)
				this.dw_receivable_adjdetail.setitem(ll_counter, "credit", this.dw_receivable_adjdetail.getitemdecimal(ll_counter, "amount"))
			else
				this.dw_receivable_adjdetail.setitem(ll_counter, "debit", this.dw_receivable_adjdetail.getitemdecimal(ll_counter, "amount"))
				this.dw_receivable_adjdetail.setitem(ll_counter, "credit", 0)
			end if
		next
		ll_retcode = 0
	else
		ll_retcode = 0
	end if
	if ll_retcode = 0 then
		ll_retcode = this.dw_receivable_adjdetail.update(true, true)
		if ll_retcode > 0 then
			ll_retcode = 0
		end if
	end if
	return ll_retcode

// w_sale.wf_setoutstandingamount() returns long
	double ld_invtotal
	double ld_amt
	double ld_outstandingamt
	double ld_balance
	double ld_adjamt
	double ld_cashcharged
	double ld_amtrecvd
	long ll_masterrow
	long ll_footerrow
	ll_masterrow = this.id_master.rowcount()
	ll_footerrow = this.id_footer.rowcount()
	this.id_master.accepttext()
	this.id_detail.accepttext()
	this.id_footer.accepttext()
	ld_invtotal = wf_grandtotal()
	ld_invtotal = this.id_footer.getitemnumber(ll_footerrow, "total")
	ld_amt = this.id_master.getitemnumber(ll_masterrow, "amt")
	ld_balance = ld_invtotal - ld_amt
	if ld_balance > 0.0 then
		ld_outstandingamt = ld_balance
	else
		ld_outstandingamt = 0.00
	end if
	if this.dw_receivable_adjdetail.rowcount() > 0 then
		ld_adjamt = this.dw_receivable_adjdetail.getitemnumber(1, "c_totalamt")
		if ld_outstandingamt + ld_adjamt <= 0.0 then
			ld_outstandingamt = 0.00
		else
			ld_outstandingamt = ld_outstandingamt + ld_adjamt
		end if
	end if
	ld_cashcharged = this.id_master.object.cashcharged[ll_masterrow]
	if ld_outstandingamt - ld_cashcharged <= 0.0 then
		ld_outstandingamt = 0.00
	else
		ld_outstandingamt = ld_outstandingamt - ld_cashcharged
	end if
	ld_amtrecvd = 0
	if this.ids_cashwin.rowcount() > 0 then
		ld_amtrecvd = this.ids_cashwin.getitemnumber(1, "c_totalamt")
		if ld_outstandingamt - ld_amtrecvd <= 0.0 then
			ld_outstandingamt = 0.00
		else
			ld_outstandingamt = ld_outstandingamt - ld_amtrecvd
		end if
	end if
	this.id_master.setitem(ll_masterrow, "outstandingamt", ld_outstandingamt)
	return 0

// w_sale.wf_checklicenceexpiry(long al_custcode) returns integer
	integer lic_licexpirycussion = 30
	integer li_option = 1
	string ls_licenceno
	datetime ldt_licence_expiry
	long ll_daysremaining = 999
	SQL Select licenceexpiry , licenceno INTO :ldt_licence_expiry, :ls_licenceno From Customer Where custcode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 and f_stringpreferences("ValidateCustLicExpiryInSale") = "Y" then
		if isnull(ls_licenceno) then
			ls_licenceno = ""
		end if
		if not isnull(ldt_licence_expiry) then
			ll_daysremaining = daysafter(today(), date(string(ldt_licence_expiry, "m-d-yy")))
			if ll_daysremaining < 0 then
				li_option = messagebox("Licence Expiry Problem!", "Customer Licence # = " + ls_licenceno + "~r~n" + "Licence Expiry Date = " + string(ldt_licence_expiry, "mmm dd, yyyy") + "~r~n" + "Customer Licence has  expired~r~n" + "Do you want to continue?", question!, yesno!, 2)
			elseif ll_daysremaining <= 30 then
				messagebox("Licence Expiry Notification!", "Customer Licence # = " + ls_licenceno + "~r~n" + "Licence Expiry Date = " + string(ldt_licence_expiry, "mmm dd, yyyy") + "~r~n" + "Customer Licence is about to expire in " + trim(string(ll_daysremaining)) + " days", information!)
			end if
		end if
	end if
	return li_option

// w_sale.wf_checkunpostedcustomersale(long al_custcode) returns integer
	integer li_option = 1
	long ll_lastinvcode
	if f_stringpreferences("UnpostedCustSaleInvAlert") = "Y" and wf_allowinvoice(al_custcode, ll_lastinvcode) > 0 then
		li_option = messagebox("Customer Validation!", "Un-Posted Invoice(s) Exist for this Customer~r~n" + "Last Invoice # " + trim(string(ll_lastinvcode)), question!, yesno!, 2)
	end if
	return li_option

// w_sale.wf_setcustomerinfo(long row, integer i, string data) returns integer
	long ll_code
	long ll_custcode
	long ll_counter
	long ll_icode
	long ll_lastinvcode
	long ll_dayslimit
	double ld_custgst
	double ld_gstperc1
	double ld_gstperc2
	double ld_itemdiscperc
	double ld_itemdiscperc2
	double ld_itemdiscperc3
	double ld_itemdiscperc4
	double ld_saleprice1
	double ld_saleprice2
	double ld_saleprice3
	double ld_invdiscperc
	double ld_saleprice4
	double ld_saleprice5
	double ld_itemdiscperc5
	double ld_custitemcatdiscperc
	double ld_itemflatdisc
	double ld_prediscperc
	double ld_customerbalance
	double ld_purunitrate
	double ld_rppunitrate
	double ld_avgprice
	double ld_purprice
	double ld_rpp
	double ld_taxperc
	integer li_salepriceno
	integer li_itemdiscpercno
	integer li_packunits
	integer li_smancode
	integer li_null
	integer li_option
	integer li_saletypecode
	boolean lb_setiteminfo
	string ls_null
	string ls_aliasname
	string ls_printwaranty
	string ls_printbalance
	char lc_taxable = "N"
	setnull(li_null)
	setnull(ls_null)
	this.ib_validcustomer = false
	ll_code = long(data)
	if not isnull(data) then
		this.il_custcode = ll_code
		setredraw(false)
		if wf_customerinfo(ll_code) <> 0 then
			messagebox("Database Error", "Customer information can not be retrieved")
			setredraw(true)
			return 1
		end if
		setredraw(true)
	elseif data = "0" then
		messagebox("Database Error", "Customer information can not be retrieved")
		return 1
	end if
	if this.id_master.accepttext() = -1 then
		return 1
	end if
	setredraw(false)
	ll_custcode = this.id_master.getitemnumber(row, "custcode")
	if row > 0 and wf_show_alert(wf_getalert(ll_custcode)) <> 0 then
		this.id_master.object.custcode[1] = 0
		this.id_master.object.aliasname[1] = ""
		return 1
	end if
	if this.id_detail.getrow() > 0 and isnull(this.id_detail.getitemnumber(this.id_detail.getrow(), "itemcode")) then
		if this.id_detail.getrow() = 1 or this.id_detail.rowcount() = 1 then
			this.id_detail.object.fullcode[this.id_detail.getrow()] = ls_null
			this.id_detail.object.icode[this.id_detail.getrow()] = li_null
			this.id_detail.object.itemname[this.id_detail.getrow()] = ls_null
			this.id_detail.object.bonusqty[this.id_detail.getrow()] = 0
			this.id_detail.object.saleprice[this.id_detail.getrow()] = li_null
		else
			event ue_deleteitem()
		end if
	end if
	if this.ii_saletype = 2 and f_stringpreferences("InSaleCustomerBalance") = "Y" then
		for ll_counter = 1 to this.ids_customersbalance.rowcount()
			if this.ids_customersbalance.getitemnumber(ll_counter, "code1") = this.id_master.getitemnumber(row, "custcode") then
				this.ii_focuscustomer = 3
				ld_customerbalance = this.ids_customersbalance.getitemnumber(ll_counter, "value1")
				this.id_master.setitem(row, "customerbalance", ld_customerbalance)
				if ld_customerbalance > 0.0 then
					this.id_master.setitem(row, "debitorcredit", "Dr")
				else
					this.id_master.setitem(row, "debitorcredit", "Cr")
				end if
				exit
			else
				this.ii_focuscustomer = 3
				this.id_master.setitem(row, "debitorcredit", "Cr")
				this.id_master.setitem(row, "customerbalance", 0)
			end if
		next
	end if
	SQL Select invdiscperc , salesmancode , printwaranty , printbalance INTO :ld_invdiscperc, :li_smancode, :ls_printwaranty, :ls_printbalance From Customer Where custcode =:ll_custcode USING this.it_transobject;
	this.id_master.setitem(1, "printbalance", ls_printbalance)
	if this.it_transobject.sqlcode = 0 then
		if f_stringpreferences("SalesManInSale") = "Y" then
			this.id_master.setitem(1, "smancode", li_smancode)
		end if
		if f_stringpreferences("setcustwiseiteminfo") = "Y" then
			lb_setiteminfo = true
		end if
	end if
	if lb_setiteminfo = true then
		this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
		SQL SELECT cust.defaultgst , cust.defaultsaleprice , cust.defaultitemdiscperc , acc.aliasname , cust.saletypecode , taxperc =( SELECT TC.taxperc FROM TaxCategory TC WHERE TC.TaxCategoryCode =cust.taxcategorycode ) INTO :ld_custgst, :li_salepriceno, :li_itemdiscpercno, :ls_aliasname, :li_saletypecode, :ld_taxperc FROM customer cust , accounts acc WHERE cust.custcode =:ll_custcode AND cust.custcode =acc.acccode USING this.it_transobject;
		if this.it_transobject.sqlcode = -1 then
			messagebox("Database Error", "Customer information can not be retrieved")
			return 1
		end if
		if not (this.it_transobject.sqlcode = 100) then
			if ld_custgst = 2.0 then
				this.id_master.setitem(1, "dd_gstperc", 2)
			else
				this.id_master.setitem(1, "dd_gstperc", 1)
			end if
		end if
		this.id_master.setitem(1, "saletypecode", li_saletypecode)
		this.id_master.setitem(1, "itemdiscpercno", li_itemdiscpercno)
		if this.idc_price.find("pricetypecode = " + trim(string(li_salepriceno)), 1, this.idc_price.rowcount()) > 0 then
			this.id_master.setitem(1, "sprice", li_salepriceno)
		else
			messagebox("Price Implementation Problem", "Your Group Wise Allowed Price Setting does not allow you to ~r~napply Default Associated Price For this customer.~r~nHowever System has decided to apply appropriate price automatcially", information!)
			this.id_master.setitem(1, "sprice", this.idc_price.getitemnumber(1, "pricetypecode"))
		end if
		this.id_master.setitem(1, "aliasname", ls_aliasname)
		this.id_master.setitem(1, "printwaranty", ls_printwaranty)
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
			if not isnull(ll_icode) then
				SQL SELECT item.gstperc1 , item.gstperc2 , item.salediscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 , item.saleprice , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.packunits , item.avgprice , PurUnitRate =round ( item.purprice / item.packunits , 2 ) , RppUnitRate =round ( item.recentpurprice / item.packunits , 2 ) , item.PurPrice , item.RecentPurPrice , item.taxable INTO :ld_gstperc1, :ld_gstperc2, :ld_itemdiscperc, :ld_itemdiscperc2, :ld_itemdiscperc3, :ld_itemdiscperc4, :ld_itemdiscperc5, :ld_saleprice1, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :li_packunits, :ld_avgprice, :ld_purunitrate, :ld_rppunitrate, :ld_purprice, :ld_rpp, :lc_taxable FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
				if this.it_transobject.sqlcode = -1 then
					messagebox("Database Error", "Item information can not be retrieved")
					return 1
				end if
				if not (this.it_transobject.sqlcode = 100) then
					if ld_custgst = 2.0 then
						this.id_detail.setitem(ll_counter, "gstperc", ld_gstperc2)
					else
						this.id_detail.setitem(ll_counter, "gstperc", ld_gstperc1)
					end if
				end if
				choose case li_salepriceno
				case 1
					this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice1 / li_packunits)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice1)
				case 2
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice2 / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice2 / li_packunits)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice2)
				case 3
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice3 / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice3 / li_packunits)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice3)
				case 4
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_purprice / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "packsaleprice", ld_purprice)
					this.id_detail.setitem(ll_counter, "packprice", ld_purprice)
					this.id_detail.setitem(ll_counter, "saleprice", ld_purprice / li_packunits)
				case 5
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_rpp / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "packsaleprice", ld_rpp)
					this.id_detail.setitem(ll_counter, "packprice", ld_rpp)
					this.id_detail.setitem(ll_counter, "saleprice", ld_rpp / li_packunits)
				case 7
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice4 / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "packsaleprice", ld_saleprice4)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice4)
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice4 / li_packunits)
				case 8
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice5 / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "packsaleprice", ld_saleprice5)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice5)
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice5 / li_packunits)
				case else
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_avgprice)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "packsaleprice", ld_avgprice * li_packunits)
					this.id_detail.setitem(ll_counter, "packprice", ld_avgprice * li_packunits)
					this.id_detail.setitem(ll_counter, "saleprice", ld_avgprice)
				end choose
				if long(this.id_detail.object.discperc.visible) = 1 then
					if wf_getcustitemcatwisesalesdiscount(ll_icode, ll_custcode, ld_custitemcatdiscperc, ld_prediscperc, ld_itemflatdisc) = true then
						this.id_detail.setitem(ll_counter, "discperc", ld_custitemcatdiscperc)
						this.id_detail.setitem(ll_counter, "itemflatdisc", ld_itemflatdisc)
						if long(this.id_detail.object.prediscperc.visible) = 1 then
							this.id_detail.setitem(ll_counter, "prediscperc", ld_prediscperc)
							this.id_detail.setitem(ll_counter, "itemflatdisc", round(this.id_detail.object.saleprice[ll_counter] * ld_prediscperc * 0.01, 2))
						else
							this.id_detail.setitem(ll_counter, "prediscperc", 0)
						end if
					else
						choose case li_itemdiscpercno
						case 1
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc)
						case 2
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc2)
						case 3
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc3)
						case 4
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc4)
						case 5
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc5)
						end choose
					end if
					if isnull(this.id_detail.getitemnumber(ll_counter, "discperc")) then
						this.id_detail.setitem(ll_counter, "discperc", 0)
					end if
				else
					this.id_detail.setitem(ll_counter, "discperc", 0)
				end if
			end if
			this.id_detail.object.taxable[ll_counter] = lc_taxable
			if this.ic_advancetaxonsale = "Y" and lc_taxable = "Y" then
				this.id_detail.object.itemadvancetaxperc[ll_counter] = ld_taxperc
			else
				this.id_detail.object.itemadvancetaxperc[ll_counter] = 0.00
			end if
			this.id_detail.object.taxflag[ll_counter] = 0
			this.id_detail.setitem(ll_counter, "discprice", this.id_detail.getitemnumber(ll_counter, "saleprice") * (1.0 - this.id_detail.getitemnumber(ll_counter, "discperc") * 0.01))
		next
	end if
	if this.id_detail.rowcount() <= 0 then
		event ue_newitem()
		this.id_master.setfocus()
	end if
	setredraw(true)
	wf_grandtotal()
	return 0

// w_sale.wf_get_associatedquotationcode(long al_custcode) returns long
	long ll_retcode = -1
	long ll_quotationcode = -1
	if al_custcode = 0 or isnull(al_custcode) then
		ll_retcode = -1
		return ll_retcode
	else
		SQL SELECT AssociatedQuotationCode INTO :ll_quotationcode FROM DBO.Customer WHERE CustCode =:al_custcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if ll_quotationcode = 0 or isnull(ll_quotationcode) then
				ll_retcode = 0
			else
				ll_retcode = ll_quotationcode
			end if
		else
			ll_retcode = -2
		end if
	end if
	return ll_retcode

// w_sale.wf_apply_associatedquotation(integer ai_mode) returns long
	long ll_custcode
	long ll_masterrow
	long ll_quotationcode
	long ll_detailrows
	long ll_qheaderrow
	long ll_quotationrows
	long ll_found
	long ll_loosepack
	long ll_rowcount
	long ll_quotpackunits
	long ll_icode
	long ll_notfound_itemcount
	double ld_quotprice
	double ld_quotdiscperc
	double ld_quotitemflatdisc
	double ld_quotclaimablediscperc
	double ld_quotgstperc
	double ld_quotqty
	double ld_quotbonusqty
	double ld_qty
	double ld_bonusqty
	double ld_bonusfactor
	double ld_quotunitsalestax
	string ls_msgtitle = "Customer Associated Quotation"
	string ls_itemname
	string ls_msgdetail
	string ls_fetchprice = "N"
	string ls_fetchitemflatdisc = "N"
	string ls_fetchitemdiscperc = "N"
	string ls_claimablediscperc = "N"
	string ls_fetchgstperc = "N"
	boolean lb_editsaleprice
	boolean lb_editsalediscperc
	boolean lb_editbonusqty
	boolean lb_edititewflatdisc
	datastore lds_quotationdetail
	datastore lds_quotationheader
	if wf_iseditable() = false then
		return 0
	end if
	ls_fetchprice = f_stringpreferences("fetchpricefromassocquot")
	ls_fetchitemflatdisc = f_stringpreferences("fetchitemflatdiscfromassocquot")
	ls_fetchitemdiscperc = f_stringpreferences("fetchdiscpercfromassocquot")
	ls_claimablediscperc = f_stringpreferences("fetchclaimablediscpercfromassocquot")
	ls_fetchgstperc = f_stringpreferences("fetchitemgstdiscpercfromassocquot")
	if ls_claimablediscperc = "" or isnull(ls_claimablediscperc) then
		ls_claimablediscperc = "N"
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_custcode = this.id_master.getitemnumber(ll_masterrow, "custcode")
	if ll_custcode = 0 or isnull(ll_custcode) then
		messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Items before applying Customers' Associated Quotation", stopsign!)
		return 0
	end if
	ll_quotationcode = wf_get_associatedquotationcode(ll_custcode)
	if ll_quotationcode < 0 then
		if ll_quotationcode = -1 then
			messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
			return 0
		else
			messagebox(ls_msgtitle, "Problem in retrieving Associated Quotation of Customer", stopsign!)
			return 0
		end if
	elseif ll_quotationcode = 0 then
		if ai_mode = 0 then
			messagebox(ls_msgtitle, "No Associated Quotation found for this Customer", stopsign!)
			return 0
		else
			return 1
		end if
		return
	end if
	lds_quotationdetail = create datastore
	lds_quotationheader = create datastore
	lds_quotationdetail.dataobject = "d_quotationdetail_retrieve"
	lds_quotationdetail.settransobject(this.it_transobject)
	lds_quotationheader.dataobject = "d_quotationheader"
	lds_quotationheader.settransobject(this.it_transobject)
	ll_qheaderrow = lds_quotationheader.retrieve(ll_quotationcode)
	if ll_qheaderrow < 0 then
		messagebox(ls_msgtitle, "Associated Quotation Header Retrieval Problem", stopsign!)
		return 0
	else
		ll_qheaderrow = lds_quotationheader.rowcount()
		if ll_qheaderrow = 0 then
			messagebox(ls_msgtitle, "Associated Quotation Does not Exist", stopsign!)
			return 0
		end if
	end if
	ll_quotationrows = lds_quotationdetail.retrieve(ll_quotationcode)
	if ll_quotationrows < 0 then
		messagebox(ls_msgtitle, "Associated Quotation Detail Retrieval Problem", stopsign!)
		return 0
	else
		ll_quotationrows = lds_quotationdetail.rowcount()
		if ll_quotationrows = 0 then
			if ai_mode = 0 then
				messagebox(ls_msgtitle, "Associated Quotation contain no rows", stopsign!)
				return 0
			else
				return 1
			end if
			return
		end if
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 511", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editsaleprice = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 516", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editsalediscperc = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 596", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editbonusqty = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 517", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_edititewflatdisc = true
	end if
	ll_loosepack = lds_quotationheader.getitemnumber(ll_qheaderrow, "loosepack")
	setredraw(false)
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ll_found = 0
		ll_found = lds_quotationdetail.find("icode = " + trim(string(ll_icode)), 1, ll_quotationrows)
		if ll_found > 0 then
			ll_quotpackunits = lds_quotationdetail.getitemnumber(ll_found, "packunits")
			ld_quotdiscperc = lds_quotationdetail.getitemnumber(ll_found, "discperc")
			ld_quotitemflatdisc = lds_quotationdetail.getitemnumber(ll_found, "itemflatdisc")
			ld_quotclaimablediscperc = lds_quotationdetail.getitemnumber(ll_found, "claimablediscperc")
			ld_quotgstperc = lds_quotationdetail.getitemnumber(ll_found, "gstperc")
			ld_quotunitsalestax = lds_quotationdetail.getitemnumber(ll_found, "gstperc")
			if ll_quotpackunits = 0 then
				ll_quotpackunits = 1
			end if
			if ll_loosepack = 1 then
				ld_quotqty = lds_quotationdetail.getitemnumber(ll_found, "looseqty")
				ld_quotbonusqty = lds_quotationdetail.getitemnumber(ll_found, "bonusqty")
				ld_quotprice = lds_quotationdetail.getitemnumber(ll_found, "saleprice")
			else
				ld_quotqty = lds_quotationdetail.getitemnumber(ll_found, "looseqty") * ll_quotpackunits
				ld_quotbonusqty = lds_quotationdetail.getitemnumber(ll_found, "bonusqty") * ll_quotpackunits
				ld_quotprice = round(lds_quotationdetail.getitemnumber(ll_found, "saleprice") / ll_quotpackunits, 2)
			end if
			if ld_quotqty <= 0.0 then
				ld_quotqty = 1
			end if
			ld_qty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
			ld_bonusqty = this.id_detail.getitemnumber(ll_rowcount, "bonusqty")
			ld_bonusfactor = round(ld_qty / ld_quotqty, 4)
			if lb_editbonusqty then
				this.id_detail.setitem(ll_rowcount, "bonusqty", round(ld_bonusfactor * ld_quotbonusqty, 4))
			end if
			if lb_editsaleprice and this.id_detail.getitemstring(ll_rowcount, "locksaleprice") = "N" and ls_fetchprice = "Y" then
				this.id_detail.setitem(ll_rowcount, "saleprice", ld_quotprice)
				this.id_detail.setitem(ll_rowcount, "rate", ld_quotprice)
			end if
			if lb_editsalediscperc and this.id_detail.getitemstring(ll_rowcount, "lockdiscperc") = "N" and ls_fetchitemdiscperc = "Y" then
				this.id_detail.setitem(ll_rowcount, "discperc", ld_quotdiscperc)
			end if
			if lb_edititewflatdisc and ls_fetchitemflatdisc = "Y" then
				this.id_detail.setitem(ll_rowcount, "itemflatdisc", ld_quotitemflatdisc)
			end if
			if ls_claimablediscperc = "Y" then
				if ld_quotclaimablediscperc > 0.0 then
					this.id_detail.setitem(ll_rowcount, "claimable", "Y")
				end if
				this.id_detail.setitem(ll_rowcount, "claimablediscperc", ld_quotclaimablediscperc)
			end if
			if ls_fetchgstperc = "Y" then
				this.id_detail.setitem(ll_rowcount, "gstperc", ld_quotgstperc)
				this.id_detail.setitem(ll_rowcount, "unitsalestax", ld_quotunitsalestax)
			end if
		else
			ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname
			ll_notfound_itemcount = ll_notfound_itemcount + 1
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_notfound_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Guidelines Exist for Following " + trim(string(ll_notfound_itemcount)) + " item(s) in Associated Quotation/Pricing Contract~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_sale.wf_save_saleinv_as_text(string as_filename) returns long
	integer li_filehandle
	long ll_counter
	long ll_innercounter
	long ll_rowcount
	string ls_writetofile
	string ls_temp
	li_filehandle = fileopen(as_filename, linemode!, write!, lockwrite!, replace!)
	if li_filehandle > -1 then
		ll_rowcount = this.id_print.rowcount()
		if ll_rowcount > 0 then
			for ll_counter = 1 to 10
				ls_temp = "c_line" + trim(string(ll_counter))
				ls_writetofile = ""
				ls_writetofile = ls_writetofile + this.id_print.getitemstring(1, ls_temp)
				filewrite(li_filehandle, ls_writetofile)
			next
			ll_counter = 0
			for ll_counter = 1 to ll_rowcount
				ls_writetofile = ""
				ls_temp = "rowdetail"
				ls_writetofile = ls_writetofile + this.id_print.getitemstring(ll_counter, ls_temp)
				filewrite(li_filehandle, ls_writetofile)
			next
			for ll_counter = 1 to 17
				ls_writetofile = ""
				ls_temp = "footerrow" + trim(string(ll_counter))
				ls_writetofile = ls_writetofile + this.id_print.getitemstring(1, ls_temp)
				filewrite(li_filehandle, ls_writetofile)
			next
			for ll_counter = 1 to 10
				ls_writetofile = " "
				filewrite(li_filehandle, ls_writetofile)
			next
		end if
		fileclose(li_filehandle)
		return 1
	end if
	return 0

// w_sale.wf_select_draft_printout(long al_invcode) returns long
	string ls_report
	string ls_filename
	long ll_row
	long ll_retcode
	if ls_report <> "" then
		this.id_print.dataobject = ls_report
		this.id_print.settransobject(sqlca)
		this.id_print.retrieve(al_invcode)
		ls_filename = "invoice.txt"
		ll_row = wf_save_saleinv_as_text(ls_filename)
		if ll_row > 0 then
			ll_retcode = 1
			run("invoice.bat", minimized!)
		else
			ll_retcode = 0
		end if
	else
		ll_retcode = 0
	end if
	return ll_retcode

// w_sale.wf_custominfo_view() returns 0
	long ll_custcode
	double ld_thisamount
	s_arguements lstr_arg
	if this.id_master.rowcount() > 0 then
		ll_custcode = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		ld_thisamount = wf_grandtotal()
		if isnull(ld_thisamount) then
			ld_thisamount = 0
		end if
		if ll_custcode > 0 and not isnull(ll_custcode) then
			lstr_arg.l_code1 = ll_custcode
			lstr_arg.db_code1 = ld_thisamount
			openwithparm(w_customerinfo_view, lstr_arg)
		end if
	end if

// w_sale.wf_check_creditlimit(long al_custcode, long al_usercode, integer ai_mode) returns long
	double ld_grandtotal
	double ld_crlimit
	double ld_balance
	double ld_unpostedbal
	long ll_retcode
	long ll_option = 2
	long ll_groupcode
	long ll_rightallowed
	string ls_msg
	string ls_msgtitle = "Customer Credit Limit Validation!"
	if this.ii_saletype = 2 then
		ll_groupcode = f_getgroupcode(al_usercode)
		if f_stringpreferences("CheckCrLimitInCrSales") = "Y" and this.ii_saletype = 2 then
			ld_grandtotal = wf_grandtotal()
			SQL SELECT RightAllowed =ISNULL ( ( SELECT MAX ( 1 ) FROM GroupRights WHERE GroupCode =:ll_groupcode AND RightCode =611 ) , 0 ) , CrLimit =ISNULL ( CrLimit , 0 ) , Balance =ISNULL ( ( SELECT SUM ( Debit - Credit ) FROM VirtualGL WHERE AccCode =:al_custcode ) , 0 ) , UnpostedBal =ISNULL ( ( SELECT SUM ( S.InvTotal ) FROM SaleLedger S WHERE S.CustCode =:al_custcode AND S.SaleCatCode =:this.ii_saletype AND S.Posted ='N' AND S.AccountFor ='Y' GROUP BY S.CustCode ) , 0 ) INTO :ll_rightallowed, :ld_crlimit, :ld_balance, :ld_unpostedbal FROM Customer WHERE CustCode =:al_custcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ld_balance + ld_unpostedbal + ld_grandtotal > ld_crlimit then
					ls_msg = "Total Recivable From Customer Exceeds Credit Limit~r~n~r~n" + "Previous Balance    : ~t~t" + string(ld_balance, "###,###,###0.00") + "~r~n" + "Un-Posted Invoices Value: ~t~t" + string(ld_unpostedbal, "###,###,###0.00") + "~r~n" + "This Invoice Amount: ~t~t" + string(ld_grandtotal, "###,###,###0.00") + "~r~n" + "Total Receivable: ~t~t~t" + string(ld_balance + ld_grandtotal + ld_unpostedbal, "###,###,###0.00") + "~r~n" + "Credit Limit: ~t~t~t" + string(ld_crlimit, "###,###,###0.00") + "~r~n"
					if ai_mode = 0 then
						messagebox(ls_msgtitle, ls_msg, information!, ok!)
						ll_option = 1
					elseif ll_rightallowed = 1 then
						ls_msg = ls_msg + "~r~nContinue Anyway?"
						ll_option = messagebox(ls_msgtitle, ls_msg, question!, yesno!, 2)
					else
						messagebox(ls_msgtitle, ls_msg, stopsign!, ok!)
						ll_option = 2
					end if
					if ll_option = 1 then
						ll_retcode = 0
					else
						ll_retcode = 1
					end if
				else
					ll_retcode = 0
				end if
			else
				messagebox("Customer Validation!", "Can not fetch customer credit limit.", stopsign!)
				ll_retcode = 2
			end if
		else
			ll_retcode = 0
		end if
	else
		ll_retcode = 0
	end if
	return ll_retcode

// w_sale.wf_enable_customer_in_cashsale() returns 0
	if this.ii_saletype = 3 then
		if f_stringpreferences("AllowCustomerInCashSale") = "Y" then
			this.id_master.object.custcode.protect = 0
			this.id_master.object.aliasname.protect = 0
			return
		end if
		this.id_master.object.custcode.protect = 1
		this.id_master.object.aliasname.protect = 1
	end if

// w_sale.wf_searchitem_quicksearch(string as_str) returns long
	long ll_found
	long ll_code
	long ll_listcurrrow
	long rt_code = 1
	long ll_row
	long ll_icode
	integer li_errcode
	string ls_errtext
	if as_str = "" or isnull(as_str) then
		rt_code = 0
	else
		ll_code = f_searchitem_quicksearch(as_str, this.it_transobject)
		if ll_code > 0 then
			ll_found = this.id_itemslist.find("icode = " + string(ll_code), 1, this.id_itemslist.rowcount())
			if ll_found > 0 then
				ll_listcurrrow = ll_found
				this.id_itemslist.selectrow(0, false)
				ll_row = this.id_detail.getrow()
				ll_icode = ll_code
				wf_inititeminfo(ll_icode, ll_row, li_errcode, ls_errtext)
				if this.il_currrow > 0 then
					this.id_itemslist.selectrow(this.il_currrow, false)
				end if
				this.id_itemslist.selectrow(ll_listcurrrow, true)
				this.id_detail.setitem(this.id_detail.getrow(), this.is_columnitemname, this.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				this.id_detail.setitem(this.id_detail.getrow(), "icode", this.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				this.id_detail.setitem(this.id_detail.getrow(), "fullcode", this.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
				this.ib_itemvalidated = false
				this.il_currrow = this.id_detail.getrow()
				this.id_detail.setitem(this.id_detail.getrow(), "CurrListRow", ll_listcurrrow)
				rt_code = 0
			end if
		end if
	end if
	return rt_code

// w_sale.wf_print_balance_slip() returns 0
	long ll_invcode
	if this.tab_retrieve.selectedtab = 2 then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(this.id_master.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			return
		end if
	end if
	openwithparm(w_salebalanceqty_slip, ll_invcode)

// w_sale.wf_quotationinuse(long al_quotationcode, ref long al_saleinvno) returns long
	long ll_saleinvcode
	ll_saleinvcode = this.id_master.object.code[this.id_master.getrow()]
	SQL Select SaleInvCode INTO :al_saleinvno From SaleLedger Where QuotationNo =:al_quotationcode And SaleInvCode Not In ( :ll_saleinvcode ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 100 then
		return 0
	end if
	return -1

// w_sale.wf_check_customer(long al_code) returns boolean
	boolean lb_check1 = true
	boolean lb_check2 = true
	// The decompiled source lost these two initialisers; without them
	// ib_validcustomer can never become true and every item click raises the
	// "Please select a Customer" modal even when a customer is set.
	lb_check1 = true
	lb_check2 = true
	if wf_checkunpostedcustomersale(al_code) > 1 then
		lb_check1 = false
	end if
	if lb_check1 = true and wf_checklicenceexpiry(al_code) > 1 then
		lb_check2 = false
	end if
	if lb_check1 = false or lb_check2 = false then
		this.ib_validcustomer = false
	else
		this.ib_validcustomer = true
	end if
	return this.ib_validcustomer

// w_sale.wf_show_associated_master() returns 0
	long ll_row
	long ll_icode
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ll_row = this.id_detail.getrow()
		if ll_row > 0 then
			ll_icode = this.id_detail.getitemnumber(ll_row, "icode")
			if ll_icode > 0 then
				openwithparm(w_view_associated_itempart, ll_icode)
			end if
		end if
	end if

// w_sale.wf_show_godownwisestock() returns long
	long ll_found
	long ll_retcode
	long ll_icode
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 615", 1, gds_securitywindow.rowcount())
	if ll_found > 0 and this.id_detail.getrow() > 0 and not isnull(this.id_detail.object.icode[this.id_detail.getrow()]) then
		ll_icode = this.id_detail.object.icode[this.id_detail.getrow()]
		openwithparm(w_view_godownwiseitemstock, ll_icode)
	end if
	return ll_retcode

// w_sale.wf_populate_manfcatwise_items() returns long
	long ll_totalrows
	long ll_rowcount
	integer li_counter
	integer li_retcode = 1
	integer li_errcode
	string ls_errortext
	boolean lb_enablesave
	datastore lds_manfcatwise_items
	s_arguements lstr_arg
	s_arguements lstr_arg2
	if wf_iseditable() = false then
		return 0
	end if
	openwithparm(w_arg_allowedgodowns, this.ii_module)
	lstr_arg2 = message.powerobjectparm
	open(w_arg_manufacturercategory_v2)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		openwithparm(w_arg_manufacturers_manfcatfilter, lstr_arg)
		lstr_arg = message.powerobjectparm
		setredraw(false)
		lds_manfcatwise_items = create datastore
		lds_manfcatwise_items.dataobject = "d_manfcatwise_items_allowedgodowns"
		lds_manfcatwise_items.settransobject(this.it_transobject)
		ll_totalrows = lds_manfcatwise_items.retrieve(lstr_arg.ia_integerlist, lstr_arg2.ia_integerlist)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_manfcatwise_items.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_manfcatwise_items.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_manfcatwise_items.getitemnumber(ll_rowcount, "stock"))
		next
		setredraw(true)
		if lb_enablesave then
			this.im_menu.m_file.m_save.enabled = true
			this.im_menu.m_file.m_print.enabled = true
		end if
	end if
	return 0

// w_sale.wf_populate_postedsaleinv_headerwise() returns long
	datastore lds_saledetail
	s_arguements lstr_arg
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_custcode
	long ll_counter
	long ll_headerno
	integer li_retcode = 1
	integer li_errcode
	string ls_errortext
	boolean lb_enablesave
	boolean lb_bonus
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	if isnull(ll_custcode) or ll_custcode = 0 then
		messagebox("Customer Validation", "Can not populate sale invoices~r~nPlease Select Valid Customer")
		this.id_master.setcolumn("custcode")
		this.id_master.setfocus()
		return -1
	end if
	open(w_arg_header)
	lstr_arg = message.powerobjectparm
	ll_headerno = lstr_arg.l_code1
	lstr_arg.l_code2 = ll_custcode
	if f_stringpreferences("BonusInSale") = "Y" then
		lb_bonus = true
	end if
	if wf_iseditable() = false then
		return 0
	end if
	lds_saledetail = create datastore
	lds_saledetail.dataobject = "d_postedsale_for_population"
	lds_saledetail.settransobject(this.it_transobject)
	openwithparm(w_populate_saleinvoices_header, lstr_arg)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		if lstr_arg.i_supress then
			this.id_master.setitem(this.id_master.rowcount(), "remarks", lstr_arg.s_name2)
		end if
		ll_totalrows = lds_saledetail.retrieve(lstr_arg.ia_integerlist, lstr_arg.s_name1)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saledetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		ll_counter = 0
		ll_detailrows = this.id_detail.rowcount()
		for ll_counter = 1 to ll_detailrows
			event ue_deleteitem()
		next
		ll_counter = 0
		for ll_rowcount = 1 to ll_totalrows
			ll_counter = this.id_detail.insertrow(0)
			if wf_inititeminfo(lds_saledetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext) then
				this.id_detail.setitem(ll_counter, "icode", lds_saledetail.getitemnumber(ll_rowcount, "icode"))
				this.id_detail.setitem(ll_counter, "gcode", lds_saledetail.getitemnumber(ll_rowcount, "gcode"))
				this.id_detail.setitem(ll_counter, "looseqty", lds_saledetail.getitemnumber(ll_rowcount, "looseqty"))
				this.id_detail.setitem(ll_counter, "packunits", lds_saledetail.getitemnumber(ll_rowcount, "packunits"))
				this.id_detail.setitem(ll_counter, "saleprice", lds_saledetail.getitemnumber(ll_rowcount, "saleprice"))
				this.id_detail.setitem(ll_counter, "avgprice", lds_saledetail.getitemnumber(ll_rowcount, "avgprice"))
				this.id_detail.setitem(ll_counter, "rate", lds_saledetail.getitemnumber(ll_rowcount, "rate"))
				this.id_detail.setitem(ll_counter, "discperc", lds_saledetail.getitemnumber(ll_rowcount, "discperc"))
				this.id_detail.setitem(ll_counter, "itemflatdisc", lds_saledetail.getitemnumber(ll_rowcount, "itemflatdisc"))
				this.id_detail.setitem(ll_counter, "saleitemdescription", lds_saledetail.getitemstring(ll_rowcount, "saleitemdescription"))
				this.id_detail.setitem(ll_counter, "packprice", lds_saledetail.getitemnumber(ll_rowcount, "packprice"))
				this.id_detail.setitem(ll_counter, "unitsalestax", lds_saledetail.getitemnumber(ll_rowcount, "unitsalestax"))
				this.id_detail.setitem(ll_counter, "gstperc", lds_saledetail.getitemnumber(ll_rowcount, "gstperc"))
				this.id_detail.setitem(ll_counter, "packqtyforsale", lds_saledetail.getitemnumber(ll_rowcount, "packqtyforsale"))
				this.id_detail.setitem(ll_counter, "sourcesaleinvcode", lds_saledetail.getitemnumber(ll_rowcount, "sourcesaleinvcode"))
				this.id_detail.setitem(ll_counter, "salerowid", lds_saledetail.getitemnumber(ll_rowcount, "salerowid"))
				if lb_bonus = true then
					this.id_detail.setitem(ll_counter, "bonusqty", lds_saledetail.getitemnumber(ll_rowcount, "bonusqty"))
					this.id_detail.setitem(ll_counter, "bonuspackqtyforsale", lds_saledetail.getitemnumber(ll_rowcount, "bonuspackqtyforsale"))
				else
					this.id_detail.setitem(ll_counter, "bonusqty", 0)
					this.id_detail.setitem(ll_counter, "bonuspackqtyforsale", 0)
				end if
			else
				event ue_deleteitem()
			end if
		next
	else
		li_retcode = -1
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	destroy lds_saledetail
	return li_retcode

// w_sale.wf_edit_issue() returns long
	datastore lds_issuedetail
	datastore lds_issueheader
	s_saletemplate lstr_template
	string ls_errortext
	string ls_itemdesc
	boolean lb_enablesave
	boolean lb_insertrow
	integer li_retcode
	integer li_errcode
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_counter
	long ll_tmprowid
	long ll_tmpcode
	long ll_found
	long ll_packunits
	double ld_issueprice
	double ld_tmpqty
	double ld_issueqty
	if wf_iseditable() = false then
		return 0
	end if
	if this.ib_modify and this.id_master.getitemnumber(1, "code") > 0.0 and this.id_master.getitemstring(1, "Posted") = "Y" then
		return 0
	end if
	lds_issuedetail = create datastore
	lds_issueheader = create datastore
	open(w_edit_customer_issue_posted)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_issuedetail.dataobject = "d_populate_issue"
		lds_issuedetail.settransobject(this.it_transobject)
		lds_issueheader.dataobject = "d_issueheader"
		lds_issueheader.settransobject(this.it_transobject)
		ll_row = lds_issueheader.retrieve(lstr_template.l_invtemplate)
		lds_issuedetail.retrieve(lstr_template.l_invtemplate)
		ll_totalrows = lds_issueheader.retrieve(lstr_template.l_invtemplate)
		if ll_row <= 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_issuedetail.rowcount()
		if ll_totalrows > 0 and li_retcode > 0 then
			lb_enablesave = true
		end if
		if lb_enablesave then
			ll_mrow = this.id_master.getrow()
			this.id_master.setitem(ll_mrow, "custcode", lds_issueheader.getitemnumber(lds_issueheader.getrow(), "acccode"))
			this.id_master.setitem(ll_mrow, "sprice", lds_issueheader.getitemnumber(lds_issueheader.getrow(), "pricetypecode"))
			this.id_master.setitem(ll_mrow, "remarks", lds_issueheader.getitemstring(lds_issueheader.getrow(), "remarks"))
			wf_deleteallemptydetailrows()
			if lstr_template.b_userinput = true then
				for ll_rowcount = 1 to this.id_detail.rowcount()
					event ue_deleteitem()
				next
				this.id_detail.reset()
			end if
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				lb_insertrow = false
				ld_tmpqty = 0
				ll_packunits = lds_issuedetail.getitemnumber(ll_counter, "packunits")
				if ll_packunits = 0 then
					ll_packunits = 1
				end if
				ll_found = 0
				if lstr_template.b_userinput = false then
					ll_found = this.id_detail.find("Issuerowid=" + string(lds_issuedetail.getitemnumber(ll_counter, "issuerowid")) + " AND icode=" + string(lds_issuedetail.getitemnumber(ll_counter, "icode")), 1, this.id_detail.rowcount())
				end if
				if ll_found <= 0 then
					ld_issueqty = lds_issuedetail.getitemnumber(ll_counter, "qty")
					ld_issueprice = lds_issuedetail.getitemnumber(ll_counter, "price")
					ll_tmprowid = lds_issuedetail.getitemnumber(ll_counter, "issuerowid")
					ls_itemdesc = lds_issuedetail.getitemstring(ll_counter, "itemdescription")
					if lstr_template.i_invtype = 0 then
						lb_insertrow = true
					else
						if this.ib_modify and this.id_master.getitemnumber(1, "code") > 0.0 then
							ll_tmpcode = this.id_master.getitemnumber(1, "code")
							SQL SELECT sum ( looseqty ) INTO :ld_tmpqty FROM SaleInvDetail WHERE IssueRowID =:ll_tmprowid AND SaleInvCode =:ll_tmpcode USING this.it_transobject;
							if this.it_transobject.sqlcode <> 0 then
								lb_insertrow = false
							end if
						end if
						if isnull(ld_tmpqty) then
							ld_tmpqty = 0
						end if
						if ld_issueqty - lds_issuedetail.getitemnumber(ll_counter, "saleqty") + ld_tmpqty > 0.0 then
							lb_insertrow = true
						else
							lb_insertrow = false
						end if
					end if
					if lb_insertrow = true then
						ll_rowcount = this.id_detail.insertrow(0)
						ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_issuedetail.getitemnumber(ll_counter, "gcode")), 1, this.idc_godown.rowcount())
						if ll_validgodowncode = 0 or this.il_strategy = 2 or this.il_godowncount = 1 then
							wf_inititeminfo(lds_issuedetail.getitemnumber(ll_counter, "icode"), ll_rowcount, li_errcode, ls_errortext)
						else
							ll_gcode = lds_issuedetail.getitemnumber(ll_counter, "gcode")
							this.id_detail.setitem(ll_rowcount, "gcode", ll_gcode)
							wf_inititeminfo_quotation(lds_issuedetail.getitemnumber(ll_counter, "icode"), ll_rowcount, li_errcode, ls_errortext, ll_gcode)
						end if
						this.id_detail.setitem(ll_rowcount, "Issuerowid", ll_tmprowid)
						this.id_detail.setitem(ll_rowcount, "packunits", ll_packunits)
						this.id_detail.setitem(ll_rowcount, "saleprice", ld_issueprice)
						this.id_detail.setitem(ll_rowcount, "saleitemdescription", ls_itemdesc)
						this.id_detail.object.taxflag[ll_rowcount] = 0
						if lstr_template.i_invtype = 0 then
							this.id_detail.setitem(ll_rowcount, "looseqty", ld_issueqty)
						else
							ld_tmpqty = ld_issueqty - lds_issuedetail.getitemnumber(ll_counter, "saleqty") + ld_tmpqty
							if ld_tmpqty > 0.0 then
								this.id_detail.setitem(ll_rowcount, "looseqty", ld_tmpqty)
							end if
						end if
					end if
				end if
			next
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return li_retcode

// w_sale.wf_setiteminfo(long al_icode, long al_row, double ad_saleprice, double ad_discperc, double ad_stock, double ad_avgprice, double ad_totalstock, double ad_purdiscperc) returns 0
	this.id_detail.setitem(al_row, "saleprice", ad_saleprice)
	if this.ii_saletype = 2 then
		this.id_detail.setitem(al_row, "discperc", ad_discperc)
	else
		this.id_detail.setitem(al_row, "discperc", 0.0)
	end if
	this.id_detail.setitem(al_row, "rate", ad_saleprice)
	this.id_detail.setitem(al_row, "avgprice", ad_avgprice)
	this.id_footer.object.icode[this.id_footer.getrow()] = al_icode
	this.id_footer.object.stock[this.id_footer.getrow()] = ad_stock

// w_sale.wf_getsalesstockinfo(long al_saleinvcode, long al_gcode, long al_icode, ref double ad_saleqty) returns integer
	SQL Select IsNull ( Sum ( saledetail.looseqty + saledetail.bonusqty ) , 0 ) INTO :ad_saleqty from saledetail where saledetail.saleinvcode =:al_saleinvcode and saledetail.gcode =:al_gcode and saledetail.icode =:al_icode USING this.it_transobject;
	if isnull(ad_saleqty) then
		ad_saleqty = 0
	end if
	return this.it_transobject.sqlcode

// w_sale.wf_selectitembatches(long al_gcode, long al_icode, double ad_qty, double ad_bonus, ref datawindow ad_itemsdetail, ref long al_rowscount, ref string al_errortext) returns integer
	datastore lds_itemstockinfo
	long ll_counter
	long ll_detailrowcount
	long ll_saleordercode
	long ll_retrieve
	long ll_found
	double ld_saleqty
	double ld_reqqty
	double ld_totalstock
	double ld_batchqty
	double ld_bonusqty
	double ld_batchcostprice
	integer li_errcode
	integer li_round_qty
	string ls_batch
	string ls_consider_only_saleorder_batches = "N"
	datetime ldt_expiry
	ls_consider_only_saleorder_batches = f_stringpreferences("ConsiderOnlySaleOrderBatchesOnSaleMod")
	ll_saleordercode = this.id_master.object.saleordercode[1]
	li_round_qty = f_get_colprecision("Qty")
	lds_itemstockinfo = create datastore
	if this.ib_modify and ll_saleordercode > 0 and ls_consider_only_saleorder_batches = "Y" then
		ll_found = this.ids_saledetail_deleted.find("icode = " + string(al_icode), 1, this.ids_saledetail_deleted.rowcount())
		if ll_found > 0 and ll_found <= this.ids_saledetail_deleted.rowcount() then
			lds_itemstockinfo.dataobject = "d_itemstockinfo_sales"
			lds_itemstockinfo.settransobject(this.it_transobject)
			ll_retrieve = lds_itemstockinfo.retrieve(al_gcode, al_icode)
		else
			lds_itemstockinfo.dataobject = "d_itemstockinfo_saleorderbatches"
			lds_itemstockinfo.settransobject(this.it_transobject)
			ll_retrieve = lds_itemstockinfo.retrieve(ll_saleordercode, al_gcode, al_icode)
			ll_found = lds_itemstockinfo.find("icode = " + string(al_icode), 1, lds_itemstockinfo.rowcount())
			if not (ll_found > 0 and ll_found <= lds_itemstockinfo.rowcount()) then
				lds_itemstockinfo.dataobject = "d_itemstockinfo_sales"
				lds_itemstockinfo.settransobject(this.it_transobject)
				ll_retrieve = lds_itemstockinfo.retrieve(al_gcode, al_icode)
			end if
		end if
	else
		lds_itemstockinfo.dataobject = "d_itemstockinfo_sales"
		lds_itemstockinfo.settransobject(this.it_transobject)
		ll_retrieve = lds_itemstockinfo.retrieve(al_gcode, al_icode)
	end if
	if ls_consider_only_saleorder_batches = "Y" and isnull(ll_saleordercode) then
		lds_itemstockinfo.setfilter("LEN(Batch) < 10")
		lds_itemstockinfo.filter()
	else
		lds_itemstockinfo.setfilter("")
		lds_itemstockinfo.filter()
	end if
	if ll_retrieve > 0 and lds_itemstockinfo.rowcount() > 0 then
		ld_totalstock = lds_itemstockinfo.getitemnumber(1, "c_totalstock")
		if ld_totalstock >= ad_qty + ad_bonus then
			ld_reqqty = ad_qty + ad_bonus
			ll_detailrowcount = ad_itemsdetail.rowcount()
			ll_counter = 1
			do while ll_counter <= lds_itemstockinfo.rowcount() and ld_reqqty > 0.0
				ld_batchqty = round(lds_itemstockinfo.getitemnumber(ll_counter, "currqty"), li_round_qty)
				if ld_batchqty >= ld_reqqty then
					ld_saleqty = ad_qty
					ld_bonusqty = ad_bonus
				elseif ld_batchqty <= ad_qty then
					ld_saleqty = ld_batchqty
					ld_bonusqty = 0
				else
					ld_saleqty = ad_qty
					ld_bonusqty = ld_batchqty - ad_qty
				end if
				ad_qty = ad_qty - ld_saleqty
				ad_bonus = ad_bonus - ld_bonusqty
				ld_reqqty = ad_qty + ad_bonus
				ad_itemsdetail.insertrow(0)
				ll_detailrowcount = ll_detailrowcount + 1
				ad_itemsdetail.setitem(ll_detailrowcount, "gcode", al_gcode)
				ad_itemsdetail.setitem(ll_detailrowcount, "icode", al_icode)
				ad_itemsdetail.setitem(ll_detailrowcount, "batch", lds_itemstockinfo.getitemstring(ll_counter, "batch"))
				ad_itemsdetail.setitem(ll_detailrowcount, "expiry", lds_itemstockinfo.getitemdatetime(ll_counter, "expiry"))
				ad_itemsdetail.setitem(ll_detailrowcount, "manfdate", lds_itemstockinfo.getitemdatetime(ll_counter, "manfdate"))
				ad_itemsdetail.setitem(ll_detailrowcount, "stock", ld_batchqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "totalstock", ld_totalstock)
				ad_itemsdetail.setitem(ll_detailrowcount, "looseqty", ld_saleqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "bonusqty", ld_bonusqty)
				if this.ic_batchcosting = "Y" then
					ls_batch = lds_itemstockinfo.getitemstring(ll_counter, "batch")
					ldt_expiry = lds_itemstockinfo.getitemdatetime(ll_counter, "expiry")
					this.it_transobject.get_itembatch_costprice(al_icode, ls_batch, ldt_expiry, ld_batchcostprice)
					if this.it_transobject.sqlcode = 0 then
						ad_itemsdetail.setitem(ll_detailrowcount, "batchcost", ld_batchcostprice)
					else
						li_errcode = 1
						al_rowscount = ld_totalstock
						al_errortext = "Error in Fetching Batch Cost Price for this item   "
					end if
				end if
				ll_counter = ll_counter + 1
			loop
			al_rowscount = ll_counter - 1
		else
			li_errcode = 1
			al_rowscount = ld_totalstock
			al_errortext = "Stock has been decreased for this item   "
		end if
	else
		li_errcode = 1
		al_rowscount = ld_totalstock
		al_errortext = "Stock does not exist for this item   "
	end if
	destroy lds_itemstockinfo
	return li_errcode

// w_sale.wf_customer_top_sellingitems() returns long
	s_itemsalehistory ls_itemsalehistory
	if not wf_iseditable() then
		return 0
	end if
	if this.id_master.rowcount() > 0 and this.id_master.getitemnumber(this.id_master.getrow(), "custcode") > 0.0 then
		ls_itemsalehistory.ar_icode = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		openwithparm(w_customer_top_sellingitems, ls_itemsalehistory)
	end if
	return 0

// w_sale.wf_print_storesummary(long al_invcode) returns long
	long ll_retcode
	string ls_report
	datastore lds_storesummary
	if f_stringpreferences("PrintStoreSummWithSInv") = "N" then
		return 0
	end if
	lds_storesummary = create datastore
	if gs_company = "SAMISPH" then
		ls_report = "d_samisph_storekeepersummary"
	elseif gs_company = "ALHAQCORP" then
		ls_report = "d_storekeepersummary_withsales"
	elseif gs_company = "SHAHZADPLYWOOD" then
		ls_report = "d_storekeepersum_withsale_shahzadplywood"
	elseif gs_company = "LEADERAUTOS" then
		ls_report = "d_storekeepersummary_withsale_leaderauto"
	elseif gs_company = "ALHARMAINLIGHTS" then
		ls_report = "d_storekeepersummary_alharmainlights"
	elseif gs_company = "PAS" then
		ls_report = "d_storekeepersummary_withsales_pas"
	elseif gs_company = "TM2" then
		ls_report = "d_storekeepersummary_withsale_tm2"
	elseif gs_company = "BISMILLAHSTORE" then
		ls_report = "d_bismillahstore_storekeepersummary"
	elseif gs_company = "ANGELSHINE" then
		ls_report = "d_angelshine_storekeepersummery_print"
	elseif gs_company = "NAVEEDYOUSAF" then
		ls_report = "d_nyg_storekeepersummery_print"
	elseif gs_company = "TOUHEED" then
		ls_report = "d_gar_storekeepersummery_print"
	elseif gs_company = "ALASEELREST" then
		ls_report = "d_alaseelrest_storekeepersummary_t"
	elseif gs_company = "AZIZNSONSKS" then
		ls_report = "d_aziznsons_storekeepersummery_f"
	elseif gs_company = "MAHMOODMAYOWH2" then
		ls_report = "d_mahmoodmayowh2_storesummary_full"
	elseif gs_company = "NAYABRESTAURANT" then
		ls_report = "d_nayabrestaurant_salestoresummry_t"
	elseif gs_company = "NOORTRADERS" then
		ls_report = "d_noortraders_sale_store_summary"
	elseif gs_company = "GREENPLUS18" then
		ls_report = "d_greenplus18_store_summary"
	elseif gs_company = "WASEEMTRADERS" then
		ls_report = "d_waseemtraders_storesummary_t"
	else
		ls_report = "d_storekeepersummary_withsales"
	end if
	lds_storesummary.dataobject = ls_report
	lds_storesummary.settransobject(this.it_transobject)
	ll_retcode = lds_storesummary.retrieve(al_invcode, this.il_groupcode)
	if ll_retcode > 0 then
		lds_storesummary.print()
	end if
	destroy lds_storesummary
	return 0

// w_sale.wf_view_iteminfo() returns 0
	long ll_code
	if this.tab_retrieve.selectedtab = 2 then
		return
	end if
	if this.id_detail.rowcount() > 0 and this.id_detail.getrow() > 0 then
		ll_code = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		if ll_code > 0 and not isnull(ll_code) then
			openwithparm(w_iteminfo, ll_code)
		end if
	end if

// w_sale.wf_isolatebonusqty(ref datawindow adw_itemdetail) returns long
	long ll_tmpcounter
	long ll_tmpcount
	long ll_detailrows
	long ll_row
	double ld_bonusqty
	double ll_looseqty
	datastore lds_itemdetail
	ll_row = 0
	if f_stringpreferences("IsolateBonusInSale") = "Y" and f_stringpreferences("AllowDupItemsInSale") = "Y" then
		lds_itemdetail = create datastore
		lds_itemdetail.dataobject = this.id_detail.dataobject
		lds_itemdetail.settransobject(this.it_transobject)
		ll_detailrows = adw_itemdetail.rowcount()
		adw_itemdetail.rowsmove(1, ll_detailrows, primary!, lds_itemdetail, 1, primary!)
		ll_tmpcount = lds_itemdetail.rowcount()
		for ll_tmpcounter = 1 to ll_tmpcount
			ll_row = ll_row + 1
			lds_itemdetail.rowscopy(ll_tmpcounter, ll_tmpcounter, primary!, adw_itemdetail, ll_row, primary!)
			ll_looseqty = lds_itemdetail.object.looseqty[ll_tmpcounter]
			ld_bonusqty = lds_itemdetail.object.bonusqty[ll_tmpcounter]
			if ld_bonusqty > 0.0 and ll_looseqty > 0.0 then
				adw_itemdetail.object.bonusqty[adw_itemdetail.rowcount()] = 0
				ll_row = ll_row + 1
				lds_itemdetail.rowscopy(ll_tmpcounter, ll_tmpcounter, primary!, adw_itemdetail, ll_row, primary!)
				adw_itemdetail.object.looseqty[adw_itemdetail.rowcount()] = 0
				adw_itemdetail.object.unitsalestax[adw_itemdetail.rowcount()] = 0
				adw_itemdetail.object.gstperc[adw_itemdetail.rowcount()] = 0
			end if
		next
		destroy lds_itemdetail
	end if
	return 0

// w_sale.wf_set_itemtotal_formatmask() returns long
	string ls_modify
	string ls_format
	ls_format = trim(f_stringpreferences("FormatForAmtInSale"))
	ls_modify = "c_itemtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_detaildwtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_finalitemval.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_sumfinalitemval.Format='" + ls_format + "'  "
	this.id_detail.modify(ls_modify)
	return 0

// w_sale.wf_setpatientinfo(long al_patientcode) returns long
	long ll_wardcode
	long ll_relationcode
	long ll_doctcode
	long ll_recurringperiod
	long ll_custcode
	string ls_regno
	string ls_aliasname
	string ls_nic
	string ls_mobileno1
	SQL SELECT Patient.RegNo , Patient.wardcode , Patient.relationcode , Patient.doctcode , ISNULL ( Patient.RecurringPeriod , 0 ) , Patient.CustCode , Accounts.AliasName , Patient.NationalIDCard , Patient.MobileNo1 INTO :ls_regno, :ll_wardcode, :ll_relationcode, :ll_doctcode, :ll_recurringperiod, :ll_custcode, :ls_aliasname, :ls_nic, :ls_mobileno1 FROM Patient , Accounts WHERE Patient.PatientCode =:al_patientcode AND Patient.Active ='Y' AND Patient.CustCode =Accounts.AccCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ll_recurringperiod) then
			ll_recurringperiod = 0
		end if
		this.id_master.setitem(this.id_master.rowcount(), "patientregno", ls_regno)
		this.id_master.setitem(this.id_master.rowcount(), "wardcode", ll_wardcode)
		this.id_master.setitem(this.id_master.rowcount(), "doctcode", ll_doctcode)
		this.id_master.setitem(this.id_master.rowcount(), "relationcode", ll_relationcode)
		this.id_master.setitem(this.id_master.rowcount(), "recurringperiod", ll_recurringperiod)
		if f_stringpreferences("FetchPatientNICInRefNo") = "Y" then
			this.id_master.setitem(this.id_master.rowcount(), "custrefno", ls_nic)
		end if
		if f_stringpreferences("FetchPatientMobileNo1InRemarks") = "Y" then
			this.id_master.setitem(this.id_master.rowcount(), "remarks", ls_mobileno1)
		end if
		if this.ii_saletype = 2 then
			this.id_master.setitem(this.id_master.rowcount(), "aliasname", ls_aliasname)
		elseif f_stringpreferences("AllowCustomerInCashSale") = "Y" then
			this.id_master.setitem(this.id_master.rowcount(), "aliasname", ls_aliasname)
		else
			ll_custcode = 19
		end if
		this.id_master.setitem(this.id_master.rowcount(), "custcode", ll_custcode)
		this.id_master.object.custcode.protect = 1
		this.id_master.object.aliasname.protect = 1
		wf_set_patientbalance(al_patientcode)
		wf_setcustomerinfo(this.id_master.rowcount(), 1, string(ll_custcode))
		this.dw_image.retrieve(al_patientcode)
		wf_populate_image(al_patientcode)
		return 1
	end if
	return 0

// w_sale.wf_populate_patient_recurring_invoices() returns long
	datastore lds_saledetail
	s_saletemplate lstr_template
	integer li_retcode = 1
	integer li_errcode
	integer li_counter
	integer ll_found
	integer ll_innercounter
	integer li_holdqty
	integer li_addbonusinqty
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrows
	long ll_masterrow
	long ll_patientcode
	double ld_looseqty
	double ld_holdbonusqty
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	boolean lb_bonus
	boolean lb_salepricefromtemplate
	datawindowchild ldc_godown
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	if ll_masterrow <= 0 then
		return 0
	end if
	ll_patientcode = this.id_master.object.patientcode[ll_masterrow]
	if ll_patientcode <= 0 or isnull(ll_patientcode) then
		messagebox("Patient Validation!", "Please Select a valid Patient")
		return 0
	end if
	lds_saledetail = create datastore
	openwithparm(w_populate_patient_recurring_invoices, ll_patientcode)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		destroy lds_saledetail
		return -1
	end if
	if f_stringpreferences("BonusInSale") = "Y" then
		lb_bonus = true
	end if
	if lstr_template.c_copyinvfrom = "I" then
		lds_saledetail.dataobject = this.id_detail.dataobject
		lds_saledetail.settransobject(this.it_transobject)
		li_retcode = lds_saledetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		ll_totalrows = lds_saledetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saledetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		this.id_master.setitem(ll_masterrow, "recurringagainst", lstr_template.l_invtemplate)
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saledetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saledetail.getitemnumber(ll_rowcount, "looseqty"))
			if lb_bonus then
				this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saledetail.getitemnumber(ll_rowcount, "bonusqty"))
			end if
		next
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	destroy lds_saledetail
	return li_retcode

// w_sale.wf_populate_visit_prescription() returns long
	datastore lds_visitprescriptdetail
	s_saletemplate lstr_template
	boolean lb_enablesave
	boolean lb_insertrow
	integer li_retcode = 1
	integer li_errcode
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_counter
	long ll_tmprowid
	long ll_tmpcode
	long ll_icode
	double ld_tmpqty
	double ld_tmpbonus
	string ls_errortext
	if wf_iseditable() = false then
		return 0
	end if
	if this.ii_saletype <> 3 then
		return 0
	end if
	lds_visitprescriptdetail = create datastore
	open(w_edit_visitprescription)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_visitprescriptdetail.dataobject = "d_visit_prescription"
		lds_visitprescriptdetail.settransobject(this.it_transobject)
		ll_row = lds_visitprescriptdetail.retrieve(lstr_template.l_invtemplate)
		if ll_row <= 0 then
			li_retcode = -1
		else
			ll_mrow = this.id_master.getrow()
			this.id_master.setitem(ll_mrow, "VisitCode", lstr_template.l_invtemplate)
			if this.ii_saletype = 3 then
				this.id_master.setitem(ll_mrow, "custcode", 19)
			end if
		end if
		ll_totalrows = lds_visitprescriptdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		if lb_enablesave then
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
			this.id_detail.reset()
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				lb_insertrow = false
				ld_tmpqty = 0
				ld_tmpbonus = 0
				ll_rowcount = this.id_detail.insertrow(0)
				ll_icode = lds_visitprescriptdetail.getitemnumber(ll_counter, "icode")
				if wf_inititeminfo(ll_icode, ll_rowcount, li_errcode, ls_errortext) then
					ll_gcode = this.id_detail.object.gcode[ll_rowcount]
					if wf_set_godown_item_stock(ll_gcode, ll_icode, ll_rowcount, ls_errortext) = 0 then
						this.id_detail.setitem(ll_rowcount, "looseqty", lds_visitprescriptdetail.getitemnumber(ll_counter, "totalqty"))
					end if
				end if
			next
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return li_retcode

// w_sale.wf_getitemdiscounts(long al_icode, long al_custcode, ref double ad_salediscperc, ref double ad_maxsalediscperc) returns long
	long ll_retcode
	SQL SELECT SaleDiscPerc =CASE ( SELECT DefaultItemDiscPerc FROM DBO.Customer WHERE CustCode =:al_custcode ) WHEN 1 THEN SaleDiscPerc WHEN 2 THEN SaleDiscPerc2 WHEN 3 THEN SaleDiscPerc3 WHEN 4 THEN SaleDiscPerc4 WHEN 5 THEN SaleDiscPerc5 ELSE 0 END , MaxSaleDiscPerc INTO :ad_salediscperc, :ad_maxsalediscperc FROM item WHERE ICode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_retcode = 0
	else
		ll_retcode = -1
	end if
	return ll_retcode

// w_sale.wf_apply_bonuspolicy(integer ai_mode) returns long
	long ll_custcode
	long ll_masterrow
	long ll_detailrows
	long ll_found
	long ll_rowcount
	long ll_icode
	long ll_newbonusqty
	long ll_manualbonus_itemcount
	double ld_looseqty
	double ld_bonusqty
	string ls_msgtitle = "Bonus Policy Implementation"
	string ls_itemname
	string ls_msgdetail
	boolean lb_editbonusqty
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_custcode = this.id_master.getitemnumber(ll_masterrow, "custcode")
	if ll_custcode = 0 or isnull(ll_custcode) then
		messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Items before applying Bonus Policy to this invoice", stopsign!)
		return 0
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 596", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editbonusqty = true
	else
		messagebox(ls_msgtitle, "Not enough rights to modify bonus qty.~r~nPlease contact system administrator for help", stopsign!)
		return 0
	end if
	setredraw(false)
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ld_looseqty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		ld_bonusqty = this.id_detail.getitemnumber(ll_rowcount, "bonusqty")
		if ld_looseqty > 0.0 and ll_icode >= 0 and not isnull(ll_icode) then
			ll_newbonusqty = 0
			this.it_transobject.getbonuspolicybased_itembonusqty(ll_icode, ld_looseqty, ll_newbonusqty)
			if this.it_transobject.sqlcode = 0 then
				if isnull(ll_newbonusqty) then
					ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname
					ll_manualbonus_itemcount = ll_manualbonus_itemcount + 1
				else
					this.id_detail.setitem(ll_rowcount, "bonusqty", ll_newbonusqty)
					this.id_detail.object.taxflag[ll_rowcount] = 0
				end if
			else
				ls_msgdetail = "Some Problem Occured while fetching item bonus policy details~r~n" + this.it_transobject.sqlerrtext
				messagebox(ls_msgtitle, ls_msgdetail, stopsign!)
				return 0
			end if
			return
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_manualbonus_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Bonus Policy exists for Following " + trim(string(ll_manualbonus_itemcount)) + " item(s)~r~nTheir Bonus should be set by user manually~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_sale.wf_apply_discountpolicy(integer ai_mode) returns long
	long ll_custcode
	long ll_masterrow
	long ll_detailrows
	long ll_found
	long ll_rowcount
	long ll_icode
	long ll_manualdiscount_itemcount
	double ld_looseqty
	double ld_policy_discperc
	double ld_discperc
	double ld_policy_itemflatdisc
	double ld_itemflatdisc
	string ls_msgtitle = "Discount Policy Implementation"
	string ls_itemname
	string ls_msgdetail
	boolean lb_editsalediscperc
	boolean lb_edititemflatdisc
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_custcode = this.id_master.getitemnumber(ll_masterrow, "custcode")
	if ll_custcode = 0 or isnull(ll_custcode) then
		messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Items before applying Discount Policy to this invoice", stopsign!)
		return 0
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 516", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editsalediscperc = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 517", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_edititemflatdisc = true
	end if
	if lb_editsalediscperc = false and lb_edititemflatdisc = false then
		messagebox(ls_msgtitle, "Not enough rights to modify item sale disc (%) or item flat discount.~r~nPlease contact system administrator for help", stopsign!)
		return 0
	end if
	setredraw(false)
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ld_looseqty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		ld_discperc = this.id_detail.getitemnumber(ll_rowcount, "DiscPerc")
		ld_itemflatdisc = this.id_detail.getitemnumber(ll_rowcount, "itemflatdisc")
		if ld_looseqty > 0.0 and ll_icode >= 0 and not isnull(ll_icode) and this.id_detail.object.taxflag[ll_rowcount] = 0 then
			ld_policy_discperc = 0
			ld_policy_itemflatdisc = 0
			this.it_transobject.getdiscountpolicybased_itemdiscount(ll_icode, ld_looseqty, ld_policy_discperc, ld_policy_itemflatdisc)
			if this.it_transobject.sqlcode = 0 then
				if isnull(ld_policy_discperc) or isnull(ld_policy_itemflatdisc) then
					ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname
					ll_manualdiscount_itemcount = ll_manualdiscount_itemcount + 1
				else
					if lb_editsalediscperc then
						this.id_detail.setitem(ll_rowcount, "DiscPerc", ld_policy_discperc)
						this.id_detail.object.taxflag[ll_rowcount] = 0
					end if
					if lb_edititemflatdisc then
						this.id_detail.setitem(ll_rowcount, "ItemFlatDisc", ld_policy_itemflatdisc)
						this.id_detail.object.taxflag[ll_rowcount] = 0
					end if
				end if
			else
				ls_msgdetail = "Some Problem Occured while fetching item Discount policy details~r~n" + this.it_transobject.sqlerrtext
				messagebox(ls_msgtitle, ls_msgdetail, stopsign!)
				return 0
			end if
			return
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_manualdiscount_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Discount Policy Exists for Following " + trim(string(ll_manualdiscount_itemcount)) + " item(s)~r~nTheir Discount should be set by user manually~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_sale.wf_apply_pricepolicy(integer ai_mode) returns long
	long ll_custcode
	long ll_masterrow
	long ll_detailrows
	long ll_found
	long ll_counter
	long ll_retcode
	long ll_rowcount
	long ll_icode
	long ll_manualprice_itemcount
	double ld_looseqty
	double ld_bonusqty
	double ld_policy_price
	double ld_price
	string ls_msgtitle = "Price Policy Implementation"
	string ls_itemname
	string ls_msgdetail
	string ls_finditem
	boolean lb_editsaleprice
	datastore lds_itemdetail
	datawindowchild ldc_godown
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_custcode = this.id_master.getitemnumber(ll_masterrow, "custcode")
	if ll_custcode = 0 or isnull(ll_custcode) then
		messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Items before applying Price Policy to this invoice", stopsign!)
		return 0
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 511", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editsaleprice = true
	else
		messagebox(ls_msgtitle, "Not enough rights to modify item sale price.~r~nPlease contact system administrator for help", stopsign!)
		return 0
	end if
	setredraw(false)
	lds_itemdetail = create datastore
	lds_itemdetail.dataobject = this.id_detail.dataobject
	lds_itemdetail.settransobject(this.it_transobject)
	ll_retcode = lds_itemdetail.getchild("gcode", ldc_godown)
	if ll_retcode = -1 then
		messagebox("datawindow child", "can not get datawindow child for colum name= godown")
	end if
	ldc_godown.settransobject(this.it_transobject)
	ldc_godown.insertrow(0)
	for ll_counter = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		ls_finditem = "icode = " + string(ll_icode)
		ll_found = lds_itemdetail.find(ls_finditem, 1, lds_itemdetail.rowcount())
		if ll_found > 0 and ll_found <= lds_itemdetail.rowcount() then
			lds_itemdetail.object.looseqty[ll_found] = lds_itemdetail.object.looseqty[ll_found] + this.id_detail.object.looseqty[ll_counter]
			lds_itemdetail.object.bonusqty[ll_found] = lds_itemdetail.object.bonusqty[ll_found] + this.id_detail.object.bonusqty[ll_counter]
		elseif lds_itemdetail.rowcount() = 0 then
			this.id_detail.rowscopy(ll_counter, ll_counter, primary!, lds_itemdetail, 1, primary!)
		else
			this.id_detail.rowscopy(ll_counter, ll_counter, primary!, lds_itemdetail, lds_itemdetail.rowcount(), primary!)
		end if
	next
	ll_detailrows = lds_itemdetail.rowcount()
	ll_counter = 0
	for ll_counter = 1 to ll_detailrows
		ll_icode = lds_itemdetail.object.icode[ll_counter]
		ls_itemname = lds_itemdetail.object.itemname[ll_counter]
		ld_looseqty = lds_itemdetail.object.looseqty[ll_counter]
		ld_price = lds_itemdetail.object.saleprice[ll_counter]
		if ld_looseqty > 0.0 and ll_icode >= 0 and not isnull(ll_icode) then
			ld_policy_price = 0
			this.it_transobject.getpricepolicybased_itemprice(gl_usercode, ll_icode, ld_looseqty, ld_policy_price)
			if this.it_transobject.sqlcode = 0 then
				if isnull(ld_policy_price) then
					lds_itemdetail.object.pricepolicyapplied[ll_counter] = 0
				else
					lds_itemdetail.object.saleprice[ll_counter] = round(ld_policy_price, 2)
					lds_itemdetail.object.pricepolicyapplied[ll_counter] = 1
				end if
			else
				ls_msgdetail = "Some Problem Occured while fetching item Price policy details~r~n" + this.it_transobject.sqlerrtext
				messagebox(ls_msgtitle, ls_msgdetail, stopsign!)
				return 0
			end if
			return
		end if
	next
	ll_detailrows = this.id_detail.rowcount()
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ld_looseqty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		ld_price = this.id_detail.getitemnumber(ll_rowcount, "saleprice")
		if ld_looseqty > 0.0 and ll_icode >= 0 and not isnull(ll_icode) and this.id_detail.object.taxflag[ll_rowcount] = 0 then
			ls_finditem = "icode = " + string(ll_icode) + " and pricepolicyapplied = 1 "
			ll_found = lds_itemdetail.find(ls_finditem, 1, lds_itemdetail.rowcount())
			if ll_found > 0 and ll_found <= lds_itemdetail.rowcount() then
				this.id_detail.object.saleprice[ll_rowcount] = lds_itemdetail.object.saleprice[ll_found]
				this.id_detail.object.taxflag[ll_rowcount] = 0
			else
				ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname
				ll_manualprice_itemcount = ll_manualprice_itemcount + 1
			end if
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_manualprice_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Price Policy exists for Following " + trim(string(ll_manualprice_itemcount)) + " item(s)~r~nTheir Pricing should be set by user manually~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_sale.wf_findpatientcode(string as_regno, ref long ai_patientcode) returns integer
	long ll_patientcode
	long ll_retflag
	long ll_found
	long ll_counter
	long ll_custcode
	string ls_itemname
	string ls_autopatientreg
	string ls_enforce_cellno_in_patientreg
	string ls_regno
	string ls_thischar
	char lc_active
	ls_autopatientreg = f_stringpreferences("AutoRegisterPatient")
	ls_enforce_cellno_in_patientreg = f_stringpreferences("EnforceCellNoInPatientReg")
	ll_retflag = 0
	SQL SELECT patient.patientcode , patient.active INTO :ll_patientcode, :lc_active FROM patient WHERE patient.regno =:as_regno and patientcatcode in ( select distinct patientcatcode from patientcatallowedmodule where moduleid =:this.ii_salemodule ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_patientcode = ll_patientcode
		if isnull(ai_patientcode) then
			ll_retflag = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
		else
			ll_retflag = -2
		end if
	elseif this.it_transobject.sqlcode = 100 then
		if isnull(ll_patientcode) or ll_patientcode = 0 then
			if ls_autopatientreg = "Y" and ls_enforce_cellno_in_patientreg = "Y" then
				for ll_counter = 1 to len(as_regno)
					ls_thischar = mid(as_regno, ll_counter, 1)
					if not (asc(ls_thischar) >= 48 and asc(ls_thischar) <= 57) then
						messagebox("Patient Reg. No. Validation", "Please enter valid cell no. as Patient Reg. No.", stopsign!)
						ll_retflag = -3
						return ll_retflag
					end if
				next
				if len(as_regno) < 11 then
					messagebox("Patient Reg. No. Validation", "Please enter valid cell no. as Patient Reg. No.", stopsign!)
					ll_retflag = -3
					return ll_retflag
				end if
				return
			end if
			if ls_autopatientreg = "Y" then
				ll_custcode = this.id_master.object.custcode[1]
				ls_regno = as_regno + "Â«" + trim(string(ll_custcode))
				openwithparm(w_simple_patientregistration, ls_regno)
				ls_regno = message.stringparm
				if not (ls_regno = "" or isnull(ls_regno)) then
					wf_patient_retrieve()
					ll_found = 0
					ll_found = this.idc_patient.find("regno = '" + ls_regno + "'", 1, this.idc_patient.rowcount())
					if ll_found > 0 then
						ll_patientcode = this.idc_patient.getitemnumber(ll_found, "patientcode")
						ai_patientcode = ll_patientcode
						this.id_master.setitem(1, "patientcode", ll_patientcode)
					end if
				end if
			else
				ll_retflag = -1
			end if
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_sale.wf_show_salereturninsale_form() returns 0
	long ll_custcode
	long ll_null
	long ll_patientcode
	if wf_iseditable() = false then
		return
	end if
	setnull(ll_null)
	if this.id_master.accepttext() < 0 then
		return
	end if
	if this.id_master.rowcount() > 0 then
		ll_custcode = this.id_master.object.custcode[1]
		ll_patientcode = this.id_master.object.patientcode[1]
		if isnull(ll_custcode) or ll_custcode = 0 then
			messagebox("Customer Validation", "Please Select a customer first")
			return
		end if
		this.istr_buffer.i_status = 1
		this.istr_buffer.l_code1 = this.id_master.object.srbufferinvcode[this.id_master.getrow()]
		this.istr_buffer.l_code2 = ll_null
		this.istr_buffer.l_code3 = ll_custcode
		this.istr_buffer.l_code4 = 0
		this.istr_buffer.l_code5 = ll_patientcode
		if this.ii_saletype = 3 then
			if f_stringpreferences("retailsaleposting") = "Y" then
				this.istr_buffer.s_name1 = "Y"
			else
				this.istr_buffer.s_name1 = "N"
			end if
		elseif f_stringpreferences("creditsaleposting") = "Y" then
			this.istr_buffer.s_name1 = "Y"
		else
			this.istr_buffer.s_name1 = "N"
		end if
		openwithparm(w_salereturnbuffer_popup, this, this)
	end if

// w_sale.wf_discperccalc(string ls_discprice) returns integer
	double ld_saleprice
	double ld_discprice
	double ld_netprice
	ld_saleprice = this.id_detail.getitemnumber(this.id_detail.getrow(), "saleprice")
	ld_discprice = double(ls_discprice)
	if ld_discprice <= ld_saleprice then
		ld_netprice = ld_saleprice - ld_discprice
		this.id_detail.setitem(this.id_detail.getrow(), "discperc", ld_netprice * 100.0 / ld_saleprice)
		this.id_detail.object.clonediscperc[this.id_detail.getrow()] = this.id_detail.object.discperc[this.id_detail.getrow()]
		this.id_detail.object.taxflag[this.id_detail.getrow()] = 0
	else
		messagebox("Disc. Validation", "Disc. Price Should be less than UnitPrice")
		return 1
	end if
	return 0

// w_sale.wf_setdiscprice() returns 0
	long ll_counter
	double ld_discprice
	double ld_discperc
	for ll_counter = 1 to this.id_detail.rowcount()
		ld_discprice = this.id_detail.getitemnumber(ll_counter, "saleprice") * (1.0 - this.id_detail.getitemnumber(ll_counter, "discperc") * 0.01)
		this.id_detail.setitem(ll_counter, "discprice", ld_discprice)
	next

// w_sale.wf_discpricecalc(double ad_discperc) returns integer
	double ld_saleprice
	ld_saleprice = this.id_detail.getitemnumber(this.id_detail.getrow(), "saleprice")
	this.id_detail.setitem(this.id_detail.getrow(), "discprice", ld_saleprice * (1.0 - 0.01 * ad_discperc))
	return 0

// w_sale.wf_get_totalpieces_allocated(long al_saleinvcode, long al_icode, ref long al_totalpieces) returns long
	SQL Select IsNull ( Sum ( saledetail.TotalPieces ) , 0 ) INTO :al_totalpieces from saledetail where saledetail.saleinvcode =:al_saleinvcode and saledetail.icode =:al_icode USING this.it_transobject;
	if isnull(al_totalpieces) then
		al_totalpieces = 0
	end if
	return this.it_transobject.sqlcode

// w_sale.wf_editpostedinvoice() returns 0
	long ll_code
	string ls_specialright
	s_invdetail lstr_invdetail
	ls_specialright = "1"
	if gl_usercode <> 1 then
		return
	end if
	if this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
	end if
	if ll_code > 0 and this.id_list.object.posted[this.id_list.getrow()] = "Y" then
		if f_is_specialright_enabled(ls_specialright) then
			openwithparm(w_special_rights_password, ls_specialright)
			if message.doubleparm > 0.0 then
				lstr_invdetail.i_module = this.ii_module
				lstr_invdetail.l_invcode = ll_code
				openwithparm(w_editpostedinvoice, lstr_invdetail)
			else
				return
			end if
		else
			return
		end if
		return
	end if

// w_sale.wf_findfullcode(string as_fullcode, ref long al_icode, ref string al_itemname) returns integer
	integer ll_retflag
	long ll_icode
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND ( item.Restricted ='N' OR ( Item.Restricted ='Y' AND Exists ( select *from grouprights where rightcode =515 and groupcode =:this.il_groupcode ) ) ) AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND ( item.Restricted ='N' OR ( Item.Restricted ='Y' AND Exists ( select *from grouprights where rightcode =515 and groupcode =:this.il_groupcode ) ) ) USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_sale.wf_new_customerregisteration() returns integer
	string ls_aliasname
	long ll_acccode
	long ll_found
	long ll_row
	dwobject dwo
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 694", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		open(w_customer_register)
		ls_aliasname = message.stringparm
		if not (ls_aliasname = "" or isnull(ls_aliasname)) then
			wf_customer_retrieve()
			ll_found = 0
			ll_found = this.idc_customers.find("accounts_aliasname = '" + ls_aliasname + "'", 1, this.idc_customers.rowcount())
			if ll_found > 0 then
				this.id_master.setitem(1, "custcode", this.idc_customers.getitemstring(ll_found, "accounts_aliasname"))
				ll_acccode = this.idc_customers.getitemnumber(ll_found, "accounts_acccode")
				this.id_master.setitem(1, "custcode", ll_acccode)
				dwo = this.id_master.object.custcode
				this.id_master.post event itemchanged(1, dwo, string(ll_acccode))
			end if
		end if
	end if
	return 0

// w_sale.wf_customer_retrieve() returns long
	this.idc_customers.setredraw(false)
	this.idc_customers.settransobject(this.it_transobject)
	this.idc_customers.retrieve()
	this.idc_customers.setredraw(true)
	return 0

// w_sale.wf_assign_master_cash_win_object() returns 0
	this.ids_cashwin = create u_ds_standard
	this.ids_cashwin.dataobject = "d_cashierwindow_detail"
	this.ids_cashwin.settransobject(this.it_transobject)

// w_sale.wf_update_cashierwindow(long al_invcode) returns long
	long ll_counter
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		this.ids_cashwin.object.saleinvcode[ll_counter] = al_invcode
	next
	SQL DELETE DBO.CashierWindow WHERE SaleInvCode =:al_invcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if this.ids_cashwin.update() > 0 then
			return 0
		else
			return -1
		end if
		return
	end if
	return -1

// w_sale.wf_validate_bonusqty(long row, string data) returns long
	double ld_newqty
	double ld_storedqty
	double ld_desiredbonus
	double ld_stock
	double ld_lockedstock
	long ll_icode
	long ll_errcode
	ld_newqty = double(data) + this.id_detail.getitemnumber(row, "looseQty")
	ld_storedqty = this.id_detail.getitemnumber(row, "looseqty") + this.id_detail.getitemnumber(row, "bonusqty")
	ll_icode = this.id_detail.object.icode[row]
	ld_stock = this.id_detail.object.stock[row]
	wf_fetch_lockedstock(ll_icode, ld_lockedstock)
	if ld_lockedstock > 0.0 and ld_newqty > ld_stock - ld_lockedstock then
		messagebox("Quantity Validation", "Item Qty =" + string(ld_newqty) + "~r~n~r~n" + "Stock available = " + string(ld_stock) + "~r~nLocked Stock=" + string(ld_lockedstock) + "~r~nStock available for sale = " + string(ld_stock - ld_lockedstock) + "~r~n~r~nPlease consult system administrator to the needfull", stopsign!)
		return 1
	end if
	if ld_newqty > ld_storedqty then
		ld_stock = this.id_detail.object.stock[row]
		if ld_newqty > ld_stock then
			messagebox("Quantity Validation", "Total Quantity " + string(ld_newqty) + " exceeds the stock")
			this.id_detail.selecttext(1, len(data))
			ll_errcode = 1
		end if
	elseif ld_newqty <= 0.0 and f_stringpreferences("BonusinSale") = "Y" and ld_newqty < 0.0 then
		messagebox("Quantity Validation", "Item Qty ~"" + data + "~" should be greater than zero")
		ll_errcode = 1
	end if
	if ll_errcode = 0 and (double(long(data)) <> double(data) and this.id_detail.object.allowsaleindecimalqty[row] = "N") then
		messagebox("Decimal Bonus Quantity Validation", "Bonus Sale Quantity In decimals is not allowed for this item", stopsign!)
		ll_errcode = 1
	end if
	if f_stringpreferences("BonusinSale") = "Y" and ll_errcode <> 1 then
		if this.id_detail.getitemnumber(row, "qtysale") = 0.0 then
			ld_desiredbonus = int(double(this.id_detail.getitemnumber(row, "looseqty") / 1.0000) * double(this.id_detail.getitemnumber(row, "Bonus")))
		else
			ld_desiredbonus = int(double(this.id_detail.getitemnumber(row, "looseqty") / double(this.id_detail.getitemnumber(row, "qtysale"))) * double(this.id_detail.getitemnumber(row, "Bonus")))
		end if
		if double(data) > ld_desiredbonus then
			ld_desiredbonus = messagebox("Bonus Quantity Alert", "Bonus Quantity Should Be = " + string(ld_desiredbonus) + "~rRequested Bonus Quantity is = " + data + "~rIs That Ok?", question!, yesno!, 2)
			if ld_desiredbonus = 1.0 then
				ll_errcode = 0
			else
				ll_errcode = 1
			end if
		end if
	end if
	return ll_errcode

// w_sale.wf_validate_packbonusqty(long row, string data) returns long
	double ld_bonuspackqty
	double ld_newbonusqty
	double ld_newqty
	double ld_stock
	long ll_icode
	long ll_errcode
	long ll_packunits
	string ls_alternatealiasname
	ld_bonuspackqty = double(data)
	if not isnull(ld_bonuspackqty) or ld_bonuspackqty >= 0.0 then
		ll_icode = this.id_detail.getitemnumber(row, "icode")
		ls_alternatealiasname = this.id_detail.getitemstring(row, "alternatecustomicode")
		if len(ls_alternatealiasname) = 0 or isnull(ls_alternatealiasname) or ls_alternatealiasname = "" then
			if not isnull(ll_icode) then
				SQL Select packunits INTO :ll_packunits From item Where icode =:ll_icode USING this.it_transobject;
			end if
		else
			SQL Select CAST ( Qty AS INT ) INTO :ll_packunits From AlternateItemAlias Where CustomICode =:ls_alternatealiasname USING this.it_transobject;
		end if
		if this.it_transobject.sqlcode = 0 then
			if isnull(ll_packunits) or ll_packunits = 0 then
				ll_packunits = 1
			end if
			ld_newbonusqty = ll_packunits * ld_bonuspackqty
			ld_newqty = ld_newbonusqty + this.id_detail.getitemnumber(row, "looseqty")
			ld_stock = this.id_detail.object.stock[row]
			if ld_newqty > ld_stock then
				messagebox("Pack Bonus Validation", "Pack Bonus " + string(ld_newbonusqty) + " exceeds stock.")
				ll_errcode = 1
			else
				this.id_detail.setitem(this.id_detail.getrow(), "bonusqty", ld_newbonusqty)
			end if
		end if
	end if
	if ll_errcode = 0 and (double(long(data)) <> double(data) and this.id_detail.object.allowsaleindecimalqty[row] = "N") then
		messagebox("Decimal Pack Bonus Quantity Validation", "Pack Bonus Sale Quantity In decimals is not allowed for this item", stopsign!)
		ll_errcode = 1
	end if
	return ll_errcode

// w_sale.wf_validate_packsaleqty(long row, string data) returns long
	string ls_null
	string ls_alternatealiasname
	double ld_stock
	double ld_newqty
	double ld_storedqty
	double ld_packqty
	long ll_errcode
	long ll_icode
	long ll_packunits
	long ll_found
	setnull(ls_null)
	if isnull(this.id_master.getitemnumber(1, "code")) and this.id_detail.getitemstring(row, "due") = "D" then
		this.id_detail.setitem(row, "dueqty", 0)
		setnull(ls_null)
		this.id_detail.setitem(row, "due", ls_null)
	end if
	if not isnull(this.id_master.getitemnumber(1, "code")) and this.id_detail.getitemstring(row, "due") = "D" then
		messagebox("Due Validation", "item " + this.id_detail.getitemstring(row, "itemname") + " has Due Qty please delete id_detail row ~r~nOR~r~npress Ctrl + U")
		this.id_detail.setitem(row, "packqtyforsale", this.id_detail.getitemnumber(row, "packqtyforsale"))
		this.id_detail.setcolumn("looseqty")
		return 1
	end if
	if isnull(this.id_master.getitemnumber(1, "code")) and this.id_detail.getitemstring(row, "due") = "D" then
		this.id_detail.setitem(row, "dueqty", 0)
		setnull(ls_null)
		this.id_detail.setitem(row, "due", ls_null)
	end if
	ld_packqty = double(data)
	if not isnull(ld_packqty) or ld_packqty >= 0.0 then
		ll_icode = this.id_detail.getitemnumber(row, "icode")
		ls_alternatealiasname = this.id_detail.getitemstring(row, "alternatecustomicode")
		if len(ls_alternatealiasname) = 0 or isnull(ls_alternatealiasname) then
			if not isnull(ll_icode) then
				SQL Select packunits INTO :ll_packunits From item Where icode =:ll_icode USING this.it_transobject;
			end if
		else
			SQL Select CAST ( Qty AS INT ) INTO :ll_packunits From AlternateItemAlias Where CustomICode =:ls_alternatealiasname USING this.it_transobject;
		end if
		if this.it_transobject.sqlcode = 0 then
			if isnull(ll_packunits) or ll_packunits = 0 then
				ll_packunits = 1
			end if
			ld_newqty = ll_packunits * ld_packqty
			if f_stringpreferences("bonusinsale") = "Y" then
				ld_newqty = ld_newqty + this.id_detail.getitemnumber(row, "bonusqty")
			end if
			ld_stock = this.id_detail.object.stock[row]
			ll_found = 0
			ll_found = gds_securitywindow.find("rightcode = 550 ", 1, gds_securitywindow.rowcount())
			if f_stringpreferences("salesmodulemode") = "A" and ll_found > 0 then
				this.id_detail.setitem(row, "looseqty", ld_newqty)
				ll_errcode = wf_autodue(row, trim(string(ld_newqty)))
				return ll_errcode
			end if
			if ld_newqty > ld_stock then
				messagebox("Pack Quantity Validation", "Pack quantity " + string(ld_newqty) + " exceeds stock.")
				ll_errcode = 1
			else
				this.id_detail.setitem(row, "looseqty", ld_newqty)
			end if
		end if
	end if
	if ll_errcode = 0 and (double(long(data)) <> double(data) and this.id_detail.object.allowsaleindecimalqty[row] = "N") then
		messagebox("Decimal Pack Quantity Validation", "Pack Sale Quantity In decimals is not allowed for this item", stopsign!)
		ll_errcode = 1
	end if
	return ll_errcode

// w_sale.wf_validate_qty(long row, string data) returns long
	long ll_errcode
	long ll_found
	long ll_icode
	double ld_storedqty
	double ld_newqty
	double ld_stock
	double ld_desiredbonus
	double ld_areavolume
	double ld_packcapacity
	double ld_lockedstock
	string ls_null
	setnull(ls_null)
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 550 ", 1, gds_securitywindow.rowcount())
	if f_stringpreferences("salesmodulemode") = "A" and ll_found > 0 then
		ll_errcode = wf_autodue(row, data)
		return ll_errcode
	end if
	if isnull(this.id_master.getitemnumber(1, "code")) and this.id_detail.getitemstring(row, "due") = "D" then
		this.id_detail.setitem(row, "dueqty", 0)
		setnull(ls_null)
		this.id_detail.setitem(row, "due", ls_null)
	end if
	if not isnull(this.id_master.getitemnumber(1, "code")) and this.id_detail.getitemstring(row, "due") = "D" then
		messagebox("Due Validation", "item " + this.id_detail.getitemstring(row, "itemname") + " has Due Qty~r~n ~t~t~t~t~tplease retype Qty information")
		wf_dueitem()
		return 1
	end if
	if isnull(this.id_master.getitemnumber(1, "code")) and this.id_detail.getitemstring(row, "due") = "D" then
		this.id_detail.setitem(row, "dueqty", 0)
		setnull(ls_null)
		this.id_detail.setitem(row, "due", ls_null)
	end if
	ld_newqty = double(data) + this.id_detail.getitemnumber(row, "bonusqty")
	ld_storedqty = this.id_detail.getitemnumber(row, "looseqty") + this.id_detail.getitemnumber(row, "bonusqty")
	ld_stock = this.id_detail.object.stock[row]
	ll_icode = this.id_detail.object.icode[row]
	wf_fetch_lockedstock(ll_icode, ld_lockedstock)
	if ld_lockedstock > 0.0 and ld_newqty > ld_stock - ld_lockedstock then
		messagebox("Quantity Validation", "Item Qty =" + string(ld_newqty) + "~r~n~r~n" + "Stock available = " + string(ld_stock) + "~r~nLocked Stock=" + string(ld_lockedstock) + "~r~nStock available for sale = " + string(ld_stock - ld_lockedstock) + "~r~n~r~nPlease consult system administrator to the needfull", stopsign!)
		return 1
	end if
	if ld_newqty > ld_storedqty then
		ld_stock = this.id_detail.object.stock[row]
		if ld_newqty > ld_stock then
			messagebox("Quantity Validation", "Quantity " + data + " exceeds the stock")
			this.id_detail.selecttext(1, len(data))
			ll_errcode = 1
		elseif f_stringpreferences("BonusinSale") = "Y" then
			if this.id_detail.getitemnumber(row, "qtysale") = 0.0 then
				ld_desiredbonus = int(int(double(data) / 1.0000) * this.id_detail.getitemnumber(row, "Bonus"))
			else
				ld_desiredbonus = int(double(data) / double(this.id_detail.getitemnumber(row, "qtysale")) * double(this.id_detail.getitemnumber(row, "Bonus")))
			end if
			if double(data) + ld_desiredbonus <= ld_stock then
				this.id_detail.setitem(row, "bonusqty", ld_desiredbonus)
			elseif double(data) > ld_stock then
				messagebox("Quantity Validation", "Quantity " + data + " exceeds the stock")
				this.id_detail.selecttext(1, len(data))
				ll_errcode = 1
			else
				ld_desiredbonus = messagebox("Problem allocating bonus", "Sale Qty = " + data + " ~r" + "Required Bonus = " + trim(string(ld_desiredbonus)) + " ~r" + "Stock available = " + trim(string(ld_stock)) + " ~r" + "Allocate possible bonus?", question!, yesno!, 2)
				if ld_desiredbonus = 1.0 then
					ll_errcode = -1
					this.id_detail.setitem(row, "bonusqty", ld_stock - double(data))
				else
					ll_errcode = 1
					this.id_detail.setitem(row, "bonusqty", 0)
					this.id_detail.selecttext(1, len(data))
				end if
			end if
		end if
	elseif ld_newqty <= 0.0 and f_stringpreferences("BonusinSale") = "N" then
		messagebox("Quantity Validation", "Item Qty ~"" + data + "~" should be greater than zero")
		ll_errcode = 1
	elseif ld_newqty <= 0.0 and f_stringpreferences("BonusinSale") = "Y" then
		if ld_newqty < 0.0 then
			messagebox("Quantity Validation", "Item Qty ~"" + data + "~" should be greater than zero")
			ll_errcode = 1
		end if
	elseif ld_newqty <= ld_storedqty then
		ld_stock = this.id_detail.object.stock[row]
		if ld_newqty > ld_stock then
			messagebox("Quantity Validation", "Quantity " + data + " exceeds the stock")
			this.id_detail.selecttext(1, len(data))
			ll_errcode = 1
		elseif f_stringpreferences("BonusinSale") = "Y" then
			if this.id_detail.getitemnumber(row, "qtysale") = 0.0 then
				ld_desiredbonus = int(double(data) / 1.0000 * this.id_detail.getitemnumber(row, "Bonus"))
			else
				ld_desiredbonus = int(double(data) / double(this.id_detail.getitemnumber(row, "qtysale")) * double(this.id_detail.getitemnumber(row, "Bonus")))
			end if
			if double(data) + ld_desiredbonus <= ld_stock then
				this.id_detail.setitem(row, "bonusqty", ld_desiredbonus)
			elseif double(data) > ld_stock then
				messagebox("Quantity Validation", "Quantity " + data + " exceeds the stock")
				this.id_detail.selecttext(1, len(data))
				ll_errcode = 1
			else
				ld_desiredbonus = messagebox("Problem allocating bonus", "Sale Qty = " + data + " ~r" + "Required Bonus = " + trim(string(ld_desiredbonus)) + " ~r" + "Stock available = " + trim(string(ld_stock)) + " ~r" + "Allocate possible bonus?", question!, yesno!, 2)
				if ld_desiredbonus = 1.0 then
					ll_errcode = -1
					this.id_detail.setitem(row, "bonusqty", ld_stock - double(data))
					this.id_detail.selecttext(1, len(data))
				else
					ll_errcode = 1
					this.id_detail.setitem(row, "bonusqty", 0)
					this.id_detail.selecttext(1, len(data))
				end if
			end if
		end if
	end if
	if ll_errcode = 0 and (double(long(data)) <> double(data) and this.id_detail.object.allowsaleindecimalqty[row] = "N") then
		messagebox("Sale Quantity Validation", "Sale Quantity In decimals is not allowed for this item", stopsign!)
		ll_errcode = 1
	end if
	if ll_errcode = 0 then
		ld_areavolume = this.id_detail.object.areavolume[row]
		if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
			ld_areavolume = 1
		end if
		ld_packcapacity = this.id_detail.object.packcapacity[row]
		if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
			ld_packcapacity = 1
		end if
		this.id_detail.setitem(row, "pcs", round(double(data) / ld_areavolume, 6))
		this.id_detail.setitem(row, "cartons", trim(string(long(this.id_detail.object.pcs[row] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[row] mod ld_packcapacity, 2))))))
	end if
	return ll_errcode

// w_sale.wf_dueitem() returns 0
	s_dueinfo ls_due
	long ll_row
	long li_null
	long ll_code
	long ll_counter
	long ll_icode
	long ll_gcode
	long ll_rowgroup
	string ls_null
	boolean lb_duefound
	double ld_qty
	double ld_dueqty
	double ld_godownstock
	double ld_givenqty
	double ld_stock
	this.id_detail.accepttext()
	if this.id_detail = getfocus() and this.id_detail.getcolumnname() = "looseqty" or this.id_detail.getcolumnname() = "gcode" then
		ll_row = this.id_detail.getrow()
		ll_code = this.id_master.getitemnumber(this.id_master.getrow(), "code")
		if not isnull(ll_code) then
			this.ids_invoiceinfo.retrieve(ll_code)
			ll_icode = this.id_detail.getitemnumber(ll_row, "icode")
			ll_gcode = this.id_detail.getitemnumber(ll_row, "gcode")
			ld_givenqty = this.id_detail.getitemnumber(ll_row, "looseqty")
			ll_rowgroup = this.id_detail.getitemnumber(ll_row, "rowgroup")
			this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Stock Validation", "Database Error: Item information can not be retrieved")
			end if
			for ll_counter = 1 to this.ids_invoiceinfo.rowcount()
				if ll_icode = this.ids_invoiceinfo.getitemnumber(ll_counter, "icode") and this.ids_invoiceinfo.getitemnumber(ll_counter, "rowgroup") = ll_rowgroup then
					if isnull(this.ids_invoiceinfo.getitemstring(ll_counter, "due")) then
						ld_qty = ld_qty + this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty")
					else
						ld_dueqty = ld_dueqty + this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty")
						lb_duefound = true
					end if
				end if
			next
			if lb_duefound = true then
				ls_due.qty = ld_qty
				ls_due.dueqty = ld_dueqty
				ls_due.stock = ld_godownstock + ld_qty
			else
				ld_stock = ld_godownstock + ld_qty
				ls_due.stock = ld_stock
				if ld_givenqty <= ld_stock then
					ls_due.qty = ld_givenqty
					ls_due.dueqty = ld_stock - ld_givenqty
				else
					ls_due.qty = ld_stock
					ls_due.dueqty = ld_givenqty - ld_stock
				end if
			end if
		else
			ld_givenqty = this.id_detail.getitemnumber(ll_row, "looseqty")
			ld_stock = this.id_detail.getitemnumber(ll_row, "stock")
			if ld_givenqty <= ld_stock then
				ls_due.qty = ld_givenqty
				ls_due.dueqty = ld_stock - ld_givenqty
			else
				ls_due.qty = ld_stock
				ls_due.dueqty = ld_givenqty - ld_stock
			end if
			ls_due.stock = ld_stock
		end if
		ls_due.itemname = this.id_detail.getitemstring(ll_row, "itemname")
		openwithparm(w_dueinfo, ls_due)
		ls_due = message.powerobjectparm
		ld_qty = ls_due.qty
		ld_dueqty = ls_due.dueqty
		setnull(ls_null)
		setnull(li_null)
		if ls_due.properclose then
			if ld_qty >= 0.0 then
				this.id_detail.setitem(ll_row, "looseqty", ld_qty)
				this.id_detail.setitem(ll_row, "dueqty", ld_dueqty)
			end if
			if ld_dueqty > 0.0 then
				this.id_detail.setitem(ll_row, "due", "D")
			else
				this.id_detail.setitem(ll_row, "due", ls_null)
			end if
		end if
		return
	end if
	ll_row = this.id_detail.getrow()

// w_sale.wf_check_patient_crlimit() returns long
	double ld_grandtotal
	double ld_crlimit
	double ld_balance
	double ld_unpostedbal
	long ll_retcode
	long ll_option = 2
	long ll_patientcode
	string ls_msg
	string ls_msgtitle = "Patient Credit Limit Validation!"
	if this.ii_saletype = 2 then
		if this.id_master.rowcount() = 0 then
			return 0
		end if
		ll_patientcode = this.id_master.object.patientcode[1]
		if ll_patientcode = 0 or isnull(ll_patientcode) then
			return 0
		end if
		if f_stringpreferences("CheckPatientCrLimitInCrSales") = "Y" and this.ii_saletype = 2 then
			ld_grandtotal = wf_grandtotal()
			SQL SELECT CrLimit =ISNULL ( CrLimit , 0 ) , Balance =ISNULL ( ( SELECT SUM ( V.Debit - V.Credit ) FROM VirtualGL V , Customer C , Patient P WHERE P.PatientCode =:ll_patientcode AND V.PatientCode =P.PatientCode AND V.AccCode =C.CustCode ) , 0 ) , UnpostedBal =ISNULL ( ( SELECT SUM ( S.InvTotal ) FROM SaleLedger S WHERE S.PatientCode =:ll_patientcode AND S.SaleCatCode =:this.ii_saletype AND S.Posted ='N' AND S.AccountFor ='Y' ) , 0 ) INTO :ld_crlimit, :ld_balance, :ld_unpostedbal FROM Patient WHERE PatientCode =:ll_patientcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ld_balance + ld_unpostedbal + ld_grandtotal > ld_crlimit then
					ls_msg = "Total Recivable From Patient Exceeds Credit Limit~r~n~r~n" + "Previous Balance    : ~t~t" + string(ld_balance, "###,###,###0.00") + "~r~n" + "Un-Posted Invoices Value: ~t~t" + string(ld_unpostedbal, "###,###,###0.00") + "~r~n" + "This Invoice Amount: ~t~t" + string(ld_grandtotal, "###,###,###0.00") + "~r~n" + "Total Receivable: ~t~t~t" + string(ld_balance + ld_grandtotal + ld_unpostedbal, "###,###,###0.00") + "~r~n" + "Credit Limit: ~t~t~t" + string(ld_crlimit, "###,###,###0.00") + "~r~n~r~nContinue Anyway?"
					messagebox(ls_msgtitle, ls_msg, stopsign!, ok!)
					ll_retcode = 1
				else
					ll_retcode = 0
				end if
			else
				messagebox(ls_msgtitle, "Can not Fetch Patient Credit Limit.", stopsign!)
				ll_retcode = 2
			end if
		else
			ll_retcode = 0
		end if
	else
		ll_retcode = 0
	end if
	return ll_retcode

// w_sale.wf_showpatientledger() returns 0
	long ll_patientcode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_patientcode = this.id_master.object.patientcode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_patientcode = this.id_list.object.patientcode[this.id_list.getrow()]
	end if
	if not isnull(ll_patientcode) and ll_patientcode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_patient_ledger, ll_patientcode)
	end if

// w_sale.wf_post_sale(integer ai_postingmode, long al_startinginvcode, long al_endinginvcode) returns long
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	if ai_postingmode = 1 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if ai_postingmode = 1 then
			openwithparm(w_arg_cust_sinvcode_linvcode2, this.ii_saletype)
			lstr_arginfo = message.powerobjectparm
		else
			lstr_arginfo.l_code1 = al_startinginvcode
			lstr_arginfo.l_code2 = al_endinginvcode
			lstr_arginfo.l_code3 = this.id_master.getitemnumber(1, "custcode")
			lstr_arginfo.l_code4 = 1
			lstr_arginfo.i_status = 1
		end if
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING this.it_transobject;
			li_errcode = wf_locksaleinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_saleinvcount)
			if li_errcode = 0 then
				this.it_transobject.postsaleledger(lstr_arginfo.l_code1, lstr_arginfo.l_code2, this.ii_saletype, ll_salesmancode, lstr_arginfo.l_code3, lstr_arginfo.l_code4, this.ic_impactinventory)
				if this.it_transobject.sqlcode <> 0 then
					li_errcode = this.it_transobject.sqlcode
					ls_msgtext = this.it_transobject.sqlerrtext
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				ls_msgtext = this.it_transobject.sqlerrtext
				li_errcode = this.it_transobject.sqlcode
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode))
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_saleinvcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return li_errcode

// w_sale.wf_saveandpost() returns 0
	integer li_postingmode = 2
	integer li_errcode
	long ll_sinvcode
	long ll_linvcode
	event ue_save()
	if this.ib_commitok then
		ll_sinvcode = this.id_master.getitemnumber(1, "code")
		ll_linvcode = this.id_master.getitemnumber(1, "code")
		if isnull(ll_sinvcode) or isnull(ll_linvcode) or ll_sinvcode < 0 and ll_linvcode < 0 then
			return
		else
			li_errcode = wf_post_sale(li_postingmode, ll_sinvcode, ll_linvcode)
		end if
	end if
	setpointer(arrow!)

// w_sale.wf_set_misccharges() returns long
	double ld_processingfee
	double ld_netamt
	double ld_misccharges
	double ld_newnetamt
	double ld_advincometax
	ld_netamt = wf_grandtotal()
	ld_misccharges = this.id_footer.object.misccharges[1]
	ld_newnetamt = ld_netamt - ld_misccharges
	if ld_newnetamt < 0.0 or isnull(ld_newnetamt) then
		ld_newnetamt = 0
	end if
	openwithparm(w_set_misccharges, ld_newnetamt)
	ld_processingfee = message.doubleparm
	if ld_processingfee >= 0.0 then
		if this.ic_advancetaxonsale = "Y" then
			ld_advincometax = this.id_footer.object.advancetaxamt[1]
		else
			ld_advincometax = 0.00
		end if
		this.id_footer.object.misccharges5[1] = ld_processingfee
		this.id_footer.object.misccharges[1] = ld_advincometax + this.id_footer.object.misccharges1[1] + this.id_footer.object.misccharges2[1] + this.id_footer.object.misccharges3[1] + this.id_footer.object.misccharges4[1] + ld_processingfee
		this.id_footer.accepttext()
		wf_grandtotal()
	end if
	return 0

// w_sale.wf_show_itemalert(long al_itemalertcode) returns long
	long ll_retcode
	long ll_alerttype
	long ll_res
	string ls_alertname
	string ls_alertdetail
	SQL SELECT Name , ItemAlertTypeCode , AlertDetail INTO :ls_alertname, :ll_alerttype, :ls_alertdetail FROM ItemAlert WHERE ItemAlertCode =:al_itemalertcode AND ItemAlertTypeCode =ItemAlertTypeCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_alerttype = 1 then
			ll_retcode = 0
		elseif ll_alerttype = 2 then
			messagebox(ls_alertname, ls_alertdetail, information!, ok!)
			ll_retcode = 0
		elseif ll_alerttype = 3 then
			ll_res = 2
			ll_res = messagebox(ls_alertname, ls_alertdetail, question!, yesno!, 2)
			if ll_res = 2 then
				ll_retcode = -1
			else
				ll_retcode = 0
			end if
		elseif ll_alerttype = 4 then
			messagebox(ls_alertname, ls_alertdetail, stopsign!, ok!)
			ll_retcode = -1
		end if
	else
		messagebox("Alert Fetching Error", "Problem in retrieving item alert information", stopsign!)
		ll_retcode = -1
	end if
	return ll_retcode

// w_sale.wf_retrievelist_datelimit() returns long
	string[] ls_posted
	string ls_showrows = "N"
	integer[] li_salecategory
	integer li_listrows
	datetime ld_invdate
	long ll_counter
	boolean lb_netamount
	s_arguements lstr_arg
	open(w_arg_sdate)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		ld_invdate = lstr_arg.d_sdate
	else
		return 0
	end if
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		if f_stringpreferences("ShowAllInvInCreditSaleList") = "Y" then
			li_salecategory[1] = 1
			li_salecategory[2] = 2
			li_salecategory[3] = 3
		else
			li_salecategory[1] = 1
			li_salecategory[2] = 2
		end if
	else
		li_salecategory[1] = this.ii_saletype
	end if
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 538 then
			ls_showrows = "Y"
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 539 then
			lb_netamount = true
			if integer(this.id_list.object.netamount.visible) = 0 then
				this.id_list.object.netamount.visible = true
				this.id_list.object.netamount_t.visible = true
			end if
		end if
	next
	if lb_netamount = false then
		this.id_list.object.netamount.visible = false
		this.id_list.object.netamount_t.visible = false
	end if
	if ls_showrows = "N" then
		this.tab_retrieve.tabpage_list.cb_retrieve.enabled = false
		this.tab_retrieve.tabpage_list.em_invno.enabled = false
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, ls_showrows, this.il_groupcode, this.ii_module)

// w_sale.wf_set_cashaccount() returns long
	long ll_cashacccode
	long ll_module
	long ll_code
	if this.ii_saletype = 3 then
		ll_module = 10
	else
		ll_module = 11
	end if
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = f_is_group_module_cashaccount_allowed(this.il_groupcode, ll_module)
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		ll_cashacccode = 0
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
	elseif isnull(ll_code) or this.id_master.object.code[1] <= 0 then
		this.id_master.object.cashacccode[this.id_master.rowcount()] = ll_cashacccode
	else
		ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	end if
	return ll_cashacccode

// w_sale.wf_print_invrange_storesummary() returns integer
	long ll_found
	s_datastore lstr
	ll_found = gds_securitywindow.find("rightcode = 717", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lstr.s_module = "rangeprint_withsummary"
		lstr.s_name1 = "d_comp_subarea_saletype_sale_storesumm"
		openwithparm(w_preview_invoices2, lstr)
		lstr = message.powerobjectparm
	end if
	return 0

// w_sale.wf_checkminsaleprice() returns integer
	double ld_minsaleprice
	long ll_counter
	long ll_icode
	string ls_messagetext
	string ls_itemname
	ls_messagetext = ""
	for ll_counter = 1 to this.id_detail.rowcount()
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		SQL SELECT MinSalePrice , name INTO :ld_minsaleprice, :ls_itemname FROM Item WHERE item.icode =:ll_icode USING this.it_transobject;
		if this.it_transobject.sqlcode < 0 then
			messagebox("Connection Error", "Unable to get item information " + this.it_transobject.sqlerrtext)
			return -1
		end if
		if this.id_detail.getitemnumber(ll_counter, "looseqty") > 0.0 then
			ld_minsaleprice = ld_minsaleprice / this.id_detail.getitemnumber(ll_counter, "packunits")
			if this.id_detail.getitemnumber(ll_counter, "c_itemtotal") / this.id_detail.getitemnumber(ll_counter, "looseqty") < ld_minsaleprice then
				ls_messagetext = ls_messagetext + "Row NO=" + string(ll_counter) + " , itemname=" + ls_itemname + " , Min. Sale Price=" + string(ld_minsaleprice) + "~r~n"
			end if
		end if
	next
	if ls_messagetext <> "" then
		messagebox("Item Validation", "Net Sale Prices are less than Min. Sale Price for items~r~n" + ls_messagetext + "~r~nPlease Change Sale Price")
		return -1
	end if
	return 0

// w_sale.wf_enforcepatientdoctorrecord() returns long
	u_ds_standard lds_patientdoct_items
	long ll_retcode
	long ll_counter
	long ll_count
	long[] ll_icode_arr
	long ll_found
	string ls_errormsg
	string ls_findexp
	lds_patientdoct_items = create u_ds_standard
	lds_patientdoct_items.dataobject = "d_patientdoctorrecordinsales"
	lds_patientdoct_items.settransobject(this.it_transobject)
	ll_count = 0
	if f_stringpreferences("ForcePatientDoctorRecordOnSaving") = "Y" then
		if isnull(this.id_master.object.patientcode[1]) or isnull(this.id_master.object.doctcode[1]) then
			if this.id_detail.rowcount() > 0 then
				for ll_counter = 1 to this.id_detail.rowcount()
					ll_icode_arr[ll_counter] = this.id_detail.object.icode[ll_counter]
				next
				lds_patientdoct_items.retrieve(ll_icode_arr)
				if lds_patientdoct_items.rowcount() > 0 then
					ls_findexp = "icode = " + trim(string(lds_patientdoct_items.getitemnumber(1, "icode")))
					ll_found = this.id_detail.find(ls_findexp, 1, this.id_detail.rowcount())
					if ll_found > 0 and ll_found < this.id_detail.rowcount() then
						ls_errormsg = "Row No. = " + trim(string(ll_found)) + "~r~nItem Name = " + this.id_detail.object.itemname[ll_found]
					end if
					if isnull(this.id_master.object.patientcode[1]) then
						messagebox("Patient/Doctor Record Validation", "Selection of Patient is Mandatory.~r~nSome of the selected items require Patient Record.~r~n" + ls_errormsg + "~r~nPlease select a patient first.", stopsign!)
						this.id_master.setcolumn("patientcode")
						this.id_master.setfocus()
						ll_retcode = 1
					end if
					if isnull(this.id_master.object.doctcode[1]) and ll_retcode = 0 then
						messagebox("Patient/Doctor Record Validation", "Selection of Doctor is Mandatory.~r~nSome of the selected items require Doctor Record.~r~n" + ls_errormsg + "~r~nPlease select a doctor first.", stopsign!)
						this.id_master.setcolumn("patientcode")
						this.id_master.setfocus()
						ll_retcode = 1
					end if
				else
					ll_retcode = 0
				end if
			else
				ll_retcode = 0
			end if
		else
			ll_retcode = 0
		end if
	else
		ll_retcode = 0
	end if
	return ll_retcode

// w_sale.wf_set_salereturn_amount() returns long
	long ll_retinvcode
	long ll_saleinvcode
	double ld_returnamt
	if this.id_master.rowcount() > 0 then
		ll_retinvcode = this.id_master.object.srbufferinvcode[1]
		if ll_retinvcode > 0 then
			SQL SELECT RetAmt =ISNULL ( DBO.fn_GetSRBufferInvTotal ( T.SRBufferInvCode ) , 0 ) , T.Saleinvcode INTO :ld_returnamt, :ll_saleinvcode FROM SRBufferLedger T WHERE T.SRBufferInvCode =:ll_retinvcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ld_returnamt < 0.0 then
					ld_returnamt = 0.00
				end if
			else
				ld_returnamt = 0.00
			end if
		end if
		this.id_footer.object.salereturnamt[1] = ld_returnamt
	end if
	return 0

// w_sale.wf_save_salereturnascredit(long al_srbufferinvcode, long al_custcode) returns boolean
	long ll_retcode
	string ls_posted
	boolean lb_retflag = true
	if al_srbufferinvcode > 0 and al_custcode > 19 then
		SQL rollback USING sqlca;
		sqlca.change_salereturn(al_srbufferinvcode, al_custcode)
		SQL commit USING sqlca;
	end if
	return lb_retflag

// w_sale.wf_show_invoicesdetail() returns long
	s_previnvinfo ls_previnvinfo
	long ll_patientcode
	long ll_custcode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_custcode = this.id_master.object.custcode[this.id_master.getrow()]
			ll_patientcode = this.id_master.object.patientcode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_custcode = this.id_list.object.custcode[this.id_list.getrow()]
		ll_patientcode = this.id_list.object.patientcode[this.id_list.getrow()]
	end if
	if isnull(ll_patientcode) then
		ll_patientcode = -1
	end if
	if isnull(ll_custcode) then
		ll_custcode = -1
	end if
	if ll_patientcode > 0 or ll_custcode > 0 then
		ls_previnvinfo.ar_customer = ll_custcode
		ls_previnvinfo.ar_patientcode = ll_patientcode
		openwithparm(w_invoicesdetail, ls_previnvinfo)
	end if
	return 0

// w_sale.wf_item_image_setting() returns long
	if f_stringpreferences("showitemimageinsale") = "N" then
		this.id_master.object.p_itemimage.visible = 0
	else
		this.it_imagetrans = create u_transaction
		this.it_imagetrans.autocommit = true
		SQL start USING this.it_imagetrans;
		if this.it_imagetrans.sqlcode <> 0 then
			return -1
		end if
		this.id_master.object.p_itemimage.visible = 1
	end if
	return 0

// w_sale.wf_set_itemimage(long al_icode) returns long
	long ll_rowid
	string ls_filename
	string ls_imagetype
	string ls_imagedesc
	blob lb_image
	this.id_master.object.p_itemimage.filename = ""
	if al_icode <= 0 or isnull(al_icode) then
		return 0
	end if
	if f_stringpreferences("showitemimageinsale") = "N" then
		return 0
	end if
	this.it_imagetrans.getfirstitemimagedetail(al_icode, ll_rowid, ls_imagetype, ls_imagedesc)
	if this.it_imagetrans.sqlcode <> 0 then
		messagebox("Item Image/Picture ", "Unable to fetch item Image Details.~r~nReasons are:~r~n" + this.it_imagetrans.sqlerrtext)
		return -1
	end if
	if ll_rowid <= 0 then
		return 0
	end if
	SQL SelectBlob ItemImage INTO :lb_image From ItemImage Where Icode =:al_icode AND RowID =:ll_rowid USING this.it_imagetrans;
	if this.it_imagetrans.sqlcode <> 0 then
		messagebox("Item Image/Picture ", "Unable to fetch item Image.~r~nReasons are:~r~n" + this.it_imagetrans.sqlerrtext)
		return -1
	end if
	ls_filename = gs_temp_img_filename
	ls_filename = left(ls_filename, len(ls_filename) - 4)
	ls_filename = trim(string(ls_filename)) + "." + ls_imagetype
	f_writeimgtofile(ls_filename, lb_image)
	this.id_master.object.p_itemimage.filename = ls_filename
	return 0

// w_sale.wf_show_patientinfo() returns long
	long ll_patientcode
	if this.id_master.rowcount() > 0 then
		ll_patientcode = this.id_master.object.patientcode[1]
		if ll_patientcode > 0 and not isnull(ll_patientcode) then
			openwithparm(w_patientinfo, ll_patientcode)
		end if
	end if
	return 0

// w_sale.wf_save_refusedsale_only() returns long
	long ll_retcode
	long ll_refusedsaleresult
	long ll_usercode
	long ll_invid
	datetime ldt_server_datetime
	string ls_askuserpwd
	string ls_date_errtext
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_detail.rowcount() > 0 then
		messagebox("Saving Problem", "Since Sale Invoice contains a few items in it, please try to save sales invoice alongwith refused sale", stopsign!)
		return 0
	end if
	if this.id_master.rowcount() > 0 then
		ll_invid = this.id_master.object.code[1]
	end if
	if this.ii_saletype = 2 then
		ls_askuserpwd = "CreditSaleAskUserPassword"
	else
		ls_askuserpwd = "Salesalesmanwindow"
	end if
	if f_stringpreferences(ls_askuserpwd) = "Y" then
		open(w_salesmanpassword)
		ll_usercode = long(message.doubleparm)
	else
		ll_usercode = gl_usercode
	end if
	if ll_usercode > 0 then
		if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Refused Sale Date Violation", ls_date_errtext, stopsign!)
			return 0
		end if
		if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Refused Sale Date Violation", ls_date_errtext, stopsign!)
			return 0
		end if
		ll_refusedsaleresult = wf_save_refusedsale(false, ll_invid, ll_usercode, ldt_server_datetime)
		if ll_refusedsaleresult = 1 then
			messagebox("Save Changes", "Changes take effect in database for Refused Sale Items", exclamation!, ok!, 1)
			ll_retcode = 1
			this.dw_refusedsaleheader.reset()
			this.dw_refusedsaledetail.reset()
			this.lb_refusedsale_in_buffer = false
		elseif ll_refusedsaleresult = 0 then
			messagebox("Saving Problem", "Changes Not Saved in database for Refused Sale Items", stopsign!, ok!, 1)
			ll_retcode = 0
		end if
	else
		ll_retcode = 0
	end if
	return ll_retcode

// w_sale.wf_populate_refusedsale() returns long
	datastore lds_refusedsaledetail
	datastore lds_refusedsaleheader
	datastore lds_items
	s_arguements lstr_arg
	boolean lb_enablesave
	boolean lb_insertrow
	integer li_retcode = 1
	integer li_errcode
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_counter
	long ll_tmprowid
	long ll_tmpcode
	long ll_icode
	long ll_custcode
	long ll_ds_row
	double ld_tmpqty
	double ld_tmpbonus
	double ld_looseqty
	double ld_bonusqty
	double ld_stock
	string ls_errortext
	string ls_customer
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.rowcount() > 0 then
		ll_custcode = this.id_master.object.custcode[1]
	end if
	if ll_custcode <= 0 then
		messagebox("Customer Validation!", "Please select a valid customer first.", stopsign!)
		this.id_master.setfocus()
		this.id_master.setcolumn("custcode")
		return 0
	end if
	lds_refusedsaledetail = create datastore
	lds_refusedsaleheader = create datastore
	lds_items = create datastore
	open(w_populate_refusedsale_form)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		this.id_detail.setredraw(false)
		lds_refusedsaledetail.dataobject = "d_populaterefusedsaledetail_sale"
		lds_refusedsaledetail.settransobject(this.it_transobject)
		lds_refusedsaleheader.dataobject = "d_RefusedSale_header"
		lds_refusedsaleheader.settransobject(this.it_transobject)
		lds_items.dataobject = "d_refusedsale_salepopulation_rejected"
		lds_items.settransobject(this.it_transobject)
		ll_row = lds_refusedsaleheader.retrieve(lstr_arg.ia_integerlist[1])
		if ll_row <= 0 then
			li_retcode = -1
		else
			SQL SELECT Name INTO :ls_customer FROM Accounts WHERE AccCode =:ll_custcode USING this.it_transobject;
			ll_mrow = this.id_master.getrow()
			this.id_master.setitem(ll_mrow, "remarks", lds_refusedsaleheader.getitemstring(lds_refusedsaleheader.getrow(), "remarks"))
			lds_refusedsaledetail.retrieve(lstr_arg.ia_integerlist, lstr_arg.l_code1)
		end if
		ll_totalrows = lds_refusedsaledetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		if lb_enablesave then
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
			this.id_detail.reset()
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				lb_insertrow = false
				ld_tmpqty = 0
				ld_tmpbonus = 0
				if lstr_arg.l_code1 = 0 then
					lb_insertrow = true
				else
					if this.ib_modify and this.id_master.getitemnumber(1, "code") > 0.0 then
						ll_tmprowid = lds_refusedsaledetail.getitemnumber(ll_counter, "rowid")
						ll_tmpcode = this.id_master.getitemnumber(1, "code")
						SQL SELECT sum ( looseqty ) , sum ( bonusqty ) INTO :ld_tmpqty, :ld_tmpbonus FROM SaleDetail WHERE RefusalSaleRowID =:ll_tmprowid AND SaleInvCode =:ll_tmpcode USING this.it_transobject;
						if this.it_transobject.sqlcode <> 0 then
							lb_insertrow = false
						end if
					end if
					if isnull(ld_tmpqty) then
						ld_tmpqty = 0
					end if
					if isnull(ld_tmpbonus) then
						ld_tmpbonus = 0
					end if
					if lds_refusedsaledetail.getitemnumber(ll_counter, "looseqty") - lds_refusedsaledetail.getitemnumber(ll_counter, "saleqty") + ld_tmpqty > 0.0 then
						lb_insertrow = true
					end if
				end if
				if lb_insertrow = true then
					ll_rowcount = this.id_detail.insertrow(0)
					ll_icode = lds_refusedsaledetail.getitemnumber(ll_counter, "icode")
					if wf_inititeminfo(ll_icode, ll_rowcount, li_errcode, ls_errortext) then
						ll_gcode = this.id_detail.getitemnumber(ll_rowcount, "gcode")
						if wf_set_godown_item_stock(ll_gcode, ll_icode, ll_rowcount, ls_errortext) = 0 then
							this.id_detail.setitem(ll_rowcount, "RefusalSaleRowID", lds_refusedsaledetail.getitemnumber(ll_counter, "rowid"))
							if lstr_arg.l_code1 = 0 then
								this.id_detail.setitem(ll_rowcount, "looseqty", lds_refusedsaledetail.getitemnumber(ll_counter, "looseqty"))
							else
								ld_tmpqty = lds_refusedsaledetail.getitemnumber(ll_counter, "looseqty") - lds_refusedsaledetail.getitemnumber(ll_counter, "saleqty") + ld_tmpqty
								if ld_tmpqty > 0.0 then
									this.id_detail.setitem(ll_rowcount, "looseqty", ld_tmpqty)
								end if
							end if
						end if
					end if
					ld_stock = this.id_detail.getitemnumber(ll_rowcount, "stock")
					ld_looseqty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
					ld_bonusqty = this.id_detail.getitemnumber(ll_rowcount, "bonusqty")
					if ld_looseqty + ld_bonusqty > ld_stock then
						ll_ds_row = lds_items.insertrow(0)
						lds_items.setitem(ll_ds_row, "customer", ls_customer)
						lds_items.setitem(ll_ds_row, "code", lds_refusedsaledetail.getitemnumber(ll_counter, "code"))
						lds_items.setitem(ll_ds_row, "icode", lds_refusedsaledetail.getitemnumber(ll_counter, "icode"))
						lds_items.setitem(ll_ds_row, "stock", this.id_detail.getitemnumber(ll_rowcount, "stock"))
						lds_items.setitem(ll_ds_row, "balance", lds_refusedsaledetail.getitemnumber(ll_counter, "looseqty") - ld_stock)
						lds_items.setitem(ll_ds_row, "customer", ls_customer)
						lds_items.setitem(ll_ds_row, "aliasname", lds_refusedsaledetail.getitemstring(ll_counter, "fullcode"))
						lds_items.setitem(ll_ds_row, "itemname", lds_refusedsaledetail.getitemstring(ll_counter, "itemname"))
						lds_items.setitem(ll_ds_row, "qty", lds_refusedsaledetail.getitemnumber(ll_counter, "looseqty"))
						if ld_stock > ld_looseqty and ld_stock > 0.0 then
							this.id_detail.setitem(ll_rowcount, "looseqty", ld_looseqty)
							if ld_stock - ld_looseqty > ld_bonusqty then
								this.id_detail.setitem(ll_rowcount, "bonusqty", ld_stock - ld_looseqty)
							else
								this.id_detail.setitem(ll_rowcount, "bonusqty", ld_stock - ld_looseqty)
							end if
						elseif ld_stock <= 0.0 then
							this.id_detail.setitem(ll_rowcount, "looseqty", 1)
						else
							this.id_detail.setitem(ll_rowcount, "looseqty", ld_stock)
						end if
						if ld_stock <= 0.0 then
							this.id_detail.setrow(ll_rowcount)
							this.id_detail.scrolltorow(ll_rowcount)
							event ue_deleteitem()
						end if
					end if
				end if
			next
		end if
		this.id_detail.setredraw(true)
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	if lds_items.rowcount() > 0 then
		openwithparm(w_refusedsale_salepopulation_rejected, lds_items)
	end if
	wf_grandtotal()
	return li_retcode

// w_sale.wf_set_flatdiscount() returns long
	double ld_disc_with_gst
	double ld_netamt
	double ld_flatdiscamt
	double ld_newnetamt
	ld_netamt = wf_grandtotal()
	ld_flatdiscamt = this.id_footer.object.flatdisc[1]
	ld_newnetamt = ld_netamt + ld_flatdiscamt
	if ld_newnetamt < 0.0 or isnull(ld_newnetamt) then
		ld_newnetamt = 0
	end if
	openwithparm(w_set_flatdiscamt, ld_newnetamt)
	ld_disc_with_gst = message.doubleparm
	if ld_disc_with_gst >= 0.0 then
		this.id_footer.object.flatdisc[1] = ld_disc_with_gst
		this.id_footer.accepttext()
		wf_grandtotal()
	end if
	return 0

// w_sale.wf_itemperiority() returns 0
	long ll_counter
	s_positem ls_itemdetail
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 545 then
			ls_itemdetail.l_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
			ls_itemdetail.i_module = 1
			if isnull(ls_itemdetail.l_icode) then
				messagebox("Item Validation", "Please select some item in the current row, than try again.")
			else
				openwithparm(w_popup_itempriority_settings, ls_itemdetail)
			end if
			return
		end if
	next

// w_sale.wf_checkcustomerwise_itemcategory() returns long
	long ll_retcode
	long ll_masterrow
	long ll_detailrows
	long ll_found
	long ll_rowcount
	long ll_icode
	long ll_baditemcount
	long ll_lastbaditem
	integer li_custcode
	string ls_msgtitle = "Customer Wise Item Category Setting Implementation"
	string ls_itemname
	string ls_msgdetail
	boolean lb_baditemfound
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	li_custcode = this.id_master.getitemnumber(ll_masterrow, "custcode")
	if li_custcode = 0 or isnull(li_custcode) then
		messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
		return -1
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Items before applying Customer Wise Item Category Setting to this invoice", stopsign!)
		return -1
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5010", 1, gds_securitywindow.rowcount())
	if not (ll_found > 0 and ll_found <= gds_securitywindow.rowcount()) then
		return 0
	end if
	setredraw(false)
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ll_retcode = this.it_transobject.checkcustomerwiseitemcategory_foranitem(li_custcode, ll_icode)
		if this.it_transobject.sqlcode = 0 then
			if ll_retcode < 0 then
				ll_retcode = -1
			end if
		else
			ll_retcode = -1
		end if
		if ll_retcode = -1 then
			lb_baditemfound = true
			ll_lastbaditem = ll_rowcount
			ls_msgdetail = ls_msgdetail + "Row #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname + "~r~n"
			ll_baditemcount = ll_baditemcount + 1
		end if
	next
	setredraw(true)
	if lb_baditemfound or ll_baditemcount > 0 then
		messagebox(ls_msgtitle, ls_msgdetail, stopsign!)
		this.id_detail.setrow(ll_lastbaditem)
		this.id_detail.scrolltorow(ll_lastbaditem)
		this.id_detail.setfocus()
		ll_retcode = -1
	else
		ll_retcode = 0
	end if
	return ll_retcode

// w_sale.wf_show_pricetypebased_markup_facility() returns long
	long ll_counter
	long ll_pricetypecode
	long ll_icode
	long ll_found
	double ld_markup
	double ld_saleprice
	double ld_saleprice1
	double ld_saleprice2
	double ld_saleprice3
	double ld_saleprice4
	double ld_saleprice5
	double ld_purprice
	double ld_avgprice
	double ld_packprice
	double ld_rpp
	integer li_packunits
	s_arguements lstr_arg
	if wf_iseditable() = false then
		return 0
	end if
	open(w_arg_pricetype_markup)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		ll_pricetypecode = lstr_arg.l_code1
		ld_markup = round(1.0 + lstr_arg.db_code1 * 0.01, 2)
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT item.saleprice , item.saleprice2 , item.saleprice3 , item.avgprice , item.packunits , item.purprice , item.recentpurprice , item.saleprice4 , item.saleprice5 INTO :ld_saleprice1, :ld_saleprice2, :ld_saleprice3, :ld_avgprice, :li_packunits, :ld_purprice, :ld_rpp, :ld_saleprice4, :ld_saleprice5 FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = -1 then
				setredraw(true)
				messagebox("Database Error", "Item information can not be retrieved")
				return 1
			end if
			if not (this.it_transobject.sqlcode = 100) then
				choose case long(ll_pricetypecode)
				case 1
					this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice1 / li_packunits * ld_markup)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice1)
				case 2
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice2 / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice2 / li_packunits * ld_markup)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice2)
				case 3
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice3 / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice3 / li_packunits * ld_markup)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice3)
				case 7
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice4 / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice4 / li_packunits * ld_markup)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice4)
				case 8
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice5 / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice5 / li_packunits * ld_markup)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice5)
				case 4
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_purprice / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "saleprice", ld_purprice / li_packunits * ld_markup)
					this.id_detail.setitem(ll_counter, "packprice", ld_purprice)
				case 5
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_rpp / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "saleprice", ld_rpp / li_packunits * ld_markup)
					this.id_detail.setitem(ll_counter, "packprice", ld_rpp)
				case else
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_avgprice / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "saleprice", ld_avgprice * ld_markup)
					this.id_detail.setitem(ll_counter, "packprice", ld_avgprice * li_packunits)
				end choose
			elseif not isnull(this.id_detail.getitemstring(1, "itemname")) then
				setredraw(true)
				messagebox("DataBase Error", "Rows not retrieve")
				return 1
			end if
			this.id_detail.setitem(ll_counter, "discprice", this.id_detail.getitemnumber(ll_counter, "saleprice") * (1.0 - this.id_detail.getitemnumber(ll_counter, "discperc") * 0.01))
		next
	end if
	wf_grandtotal()
	return 0

// w_sale.wf_set_patientvisibility() returns long
	boolean lb_visible
	if this.ii_saletype = 3 then
		if f_stringpreferences("patientOnRetailSale") = "H" then
			lb_visible = true
		end if
	elseif f_stringpreferences("patientOnCreditSale") = "H" then
		lb_visible = true
	end if
	this.id_master.object.patientcode.visible = lb_visible
	this.id_master.object.t_regno.visible = lb_visible
	this.id_master.object.patientcode_t.visible = lb_visible
	this.id_master.object.patientregno.visible = lb_visible
	this.id_master.object.patientbalance.visible = lb_visible
	this.id_master.object.t_patientbalance.visible = lb_visible
	this.id_master.object.c_patientbalancedrcr.visible = lb_visible
	return 0

// w_sale.wf_set_headersetting() returns integer
	integer li_rtncode
	long ll_counter
	long ll_found
	datastore lds_headers
	datawindowchild ldc_headerno
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		return li_rtncode
	end if
	this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
	this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
	this.id_master.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to lds_headers.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
		ldc_headerno.setitem(ll_counter, "name", "")
		ll_found = 0
		ll_found = gds_reoprtheaderinfo.find("headerno=" + string(lds_headers.getitemnumber(ll_counter, "headercode")), 1, gds_reoprtheaderinfo.rowcount())
		if ll_found > 0 then
			if isnull(gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks")) then
				ldc_headerno.setitem(ll_counter, "headeralias", trim(string(gds_reoprtheaderinfo.getitemnumber(ll_found, "headerno"))))
			else
				ldc_headerno.setitem(ll_counter, "headeralias", trim(gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks")) + " (" + trim(string(gds_reoprtheaderinfo.getitemnumber(ll_found, "headerno"))) + ")")
			end if
		end if
	next
	return 1

// w_sale.wf_apply_interfacesetting() returns integer
	long ll_counter
	datastore lds_listsetting
	lds_listsetting = create datastore
	lds_listsetting.dataobject = "d_interfacesettingcols"
	lds_listsetting.settransobject(this.it_transobject)
	if this.ii_saletype = 2 then
		lds_listsetting.retrieve(11, 4, 0)
	else
		lds_listsetting.retrieve(10, 4, 0)
	end if
	for ll_counter = 1 to lds_listsetting.rowcount()
		this.id_list.modify(lds_listsetting.getitemstring(ll_counter, "colname") + "_t" + ".Visible=0")
		this.id_list.modify(lds_listsetting.getitemstring(ll_counter, "colname") + ".Visible=0")
	next
	return 0

// w_sale.wf_retrieve_customer_balances() returns integer
	if f_stringpreferences("InSaleCustomerBalance") = "Y" then
		if this.ii_saletype = 2 then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
		end if
		this.ids_customersbalance = create datastore
		this.ids_customersbalance.dataobject = "d_customerbalances_in_sales"
		this.ids_customersbalance.settransobject(sqlca)
		this.ids_customersbalance.retrieve()
	elseif this.ii_saletype = 2 then
		this.id_master.object.debitorcredit.visible = false
		this.id_master.object.customerbalance.visible = false
		this.id_master.object.t_balance.visible = false
	end if
	return 0

// w_sale.wf_apply_groupcustomercategory() returns integer
	integer li_rtncode
	string ls_custfilterstring
	if this.ii_saletype = 2 then
		if f_stringpreferences("GroupCustomerCategory") = "Y" then
			this.il_groupcode = f_getgroupcode(gl_usercode)
			ls_custfilterstring = "0                                                                                                                                                                                                             "
			this.it_transobject.getallowedgroupcustomercategory(this.il_groupcode, ls_custfilterstring)
			if ls_custfilterstring = " " or ls_custfilterstring = "" or isnull(ls_custfilterstring) then
				ls_custfilterstring = "0"
				return -1
			end if
			if ls_custfilterstring = "" then
				ls_custfilterstring = "-1"
			end if
			this.idc_customers.setfilter("custcatcode In (" + ls_custfilterstring + ") and accounts_acccode <> 19 AND AllowInCreditSale=~"Y~"")
			this.idc_customers.filter()
		else
			this.idc_customers.setfilter("accounts_acccode <> 19 AND AllowInCreditSale='Y' ")
			this.idc_customers.filter()
		end if
	elseif f_stringpreferences("GroupCustomerCategory") = "Y" then
		this.il_groupcode = f_getgroupcode(gl_usercode)
		ls_custfilterstring = "0                                                                                                                                                                                                             "
		this.it_transobject.getallowedgroupcustomercategory(this.il_groupcode, ls_custfilterstring)
		if ls_custfilterstring = " " or ls_custfilterstring = "" or isnull(ls_custfilterstring) then
			ls_custfilterstring = "0"
			return -1
		end if
		this.idc_customers.setfilter("custcatcode In (" + ls_custfilterstring + ") and allowincashsale=~"Y~"")
		this.idc_customers.filter()
	else
		this.idc_customers.setfilter("AllowInCashSale=~"Y~"")
		this.idc_customers.filter()
	end if
	return 1

// w_sale.wf_set_patientbalance(long al_patientcode) returns long
	datetime ldt_datetime
	double ld_balance
	ldt_datetime = datetime(date(today()), time(today()))
	this.it_transobject.patientopeningbalance(al_patientcode, ldt_datetime, ld_balance)
	if this.it_transobject.sqlcode = 0 then
		this.id_master.object.patientbalance[1] = ld_balance
		return 0
	end if
	return -1

// w_sale.wf_update_virtualgl() returns integer
	if f_stringpreferences("alwaysshowupdatedprevbal") = "Y" then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
	end if
	return 0

// w_sale.wf_checkitemwise_uppersaleqtylimit() returns long
	long ll_retcode
	long ll_masterrow
	long ll_detailrows
	long ll_found
	long ll_rowcount
	long ll_icode
	long ll_baditemcount
	long ll_lastbaditem
	long ll_upperlimit
	char lc_checklimit
	string ls_msgtitle = "Item Wise Upper Sale Qty Limit Implementation"
	string ls_itemname
	string ls_msgdetail
	boolean lb_baditemfound
	double ld_qty
	if wf_iseditable() = false then
		return 0
	end if
	if f_stringpreferences("enforceitemuppersaleqtylimit") = "N" then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_detailrows = this.id_detail.rowcount()
	setredraw(false)
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ld_qty = this.id_detail.getitemnumber(ll_rowcount, "looseqty") + this.id_detail.getitemnumber(ll_rowcount, "bonusqty")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		lc_checklimit = "N"
		ll_upperlimit = 0
		ll_retcode = this.it_transobject.checkitemwiseuppersaleqty_foranitem(ll_icode, lc_checklimit, ll_upperlimit)
		if this.it_transobject.sqlcode = 0 then
			if ll_retcode < 0 then
				ls_msgdetail = ls_msgdetail + "Row #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname + "~r~n" + this.it_transobject.sqlerrtext
				ll_retcode = -1
				exit
			elseif lc_checklimit = "Y" and ld_qty > double(ll_upperlimit) then
				ls_msgdetail = ls_msgdetail + "Row #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname + "~r~n" + "Sale Qty = " + trim(string(ld_qty)) + "~r~n" + "Item Level Upper Sale Qty Limit = " + trim(string(ll_upperlimit)) + "~r~n~r~n" + "Please respect the upper limit imposed on sale of this item~r~nor~r~nConsult System Administrator to increase the upper Sale Qty Limit for this item."
				ll_retcode = -1
				exit
			end if
		else
			ls_msgdetail = ls_msgdetail + "Row #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname + "~r~n" + this.it_transobject.sqlerrtext
			ll_retcode = -1
			exit
		end if
	next
	if ll_retcode = -1 then
		messagebox(ls_msgtitle, ls_msgdetail, stopsign!)
		this.id_detail.setrow(ll_rowcount)
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	setredraw(true)
	return ll_retcode

// w_sale.wf_show_alert(long al_alertcode) returns long
	long ll_retcode
	long ll_alerttype
	long ll_res
	string ls_alertname
	string ls_alertdetail
	SQL SELECT Name , AlertTypeCode , Detail INTO :ls_alertname, :ll_alerttype, :ls_alertdetail FROM Alert WHERE AlertCode =:al_alertcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_alerttype = 1 then
			ll_retcode = 0
		elseif ll_alerttype = 2 then
			messagebox(ls_alertname, ls_alertdetail, information!, ok!)
			ll_retcode = 0
		elseif ll_alerttype = 3 then
			ll_res = 2
			ll_res = messagebox(ls_alertname, ls_alertdetail, question!, yesno!, 2)
			if ll_res = 2 then
				ll_retcode = -1
			else
				ll_retcode = 0
			end if
		elseif ll_alerttype = 4 then
			messagebox(ls_alertname, ls_alertdetail, stopsign!, ok!)
			ll_retcode = -1
		end if
	else
		messagebox("Alert Fetching Error", "Problem in retrieving Alert information", stopsign!)
		ll_retcode = -1
	end if
	return ll_retcode

// w_sale.wf_getalert(long al_acccode) returns long
	long ll_retcode
	long ll_alertcode
	if al_acccode > 0 then
		SQL SELECT A.AlertCode INTO :ll_alertcode FROM Accounts A WHERE AccCode =:al_acccode USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			ll_retcode = -1
		elseif ll_alertcode > 0 then
			ll_retcode = ll_alertcode
		else
			ll_retcode = -1
		end if
	else
		ll_retcode = -1
	end if
	return ll_retcode

// w_sale.wf_pd_initialize() returns long
	string ls_init_string
	ls_init_string = char(27) + char(73) + char(12)
	pd_writepd(ls_init_string, len(ls_init_string))
	return 0

// w_sale.wf_set_flatdiscount2() returns long
	double ld_disc_with_gst
	double ld_netamt
	double ld_flatdiscamt
	double ld_newnetamt
	if this.id_detail.rowcount() > 0 then
		ld_netamt = this.id_detail.getitemdecimal(1, "c_grossamt")
	else
		ld_netamt = 0.00
	end if
	ld_flatdiscamt = this.id_footer.object.flatdisc[1]
	ld_newnetamt = ld_netamt
	if ld_newnetamt < 0.0 or isnull(ld_newnetamt) then
		ld_newnetamt = 0
	end if
	openwithparm(w_set_flatdiscamt2, ld_newnetamt)
	ld_disc_with_gst = message.doubleparm
	if ld_disc_with_gst >= 0.0 then
		this.id_footer.object.flatdisc[1] = ld_disc_with_gst
		this.id_footer.accepttext()
		wf_grandtotal()
	end if
	return 0

// w_sale.wf_set_discperc_onlyon_unlock_discperc() returns integer
	s_arguements lstr_arg
	long ll_counter = 1
	long ll_icode
	u_transaction lt_transobject
	char ls_islock
	if wf_iseditable() = false then
		wf_replace_postdate_with_date()
		return 0
	end if
	lt_transobject = create u_transaction
	SQL start USING lt_transobject;
	open(w_arg_only_decimal_input)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
			if ll_icode > 0 and not isnull(ll_icode) then
				SQL SELECT lockdiscperc INTO :ls_islock FROM ITEM WHERE ITEM.icode =:ll_icode USING lt_transobject;
				if ls_islock = "N" then
					this.id_detail.setitem(ll_counter, "discperc", lstr_arg.db_code1)
				end if
			end if
		next
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	return 0

// w_sale.wf_get_saleinv_count_single_cust(long al_custcode) returns long
	long ll_saleinv_counter
	long ll_invcode
	ll_invcode = this.id_master.getitemnumber(1, "code")
	if isnull(ll_invcode) then
		ll_invcode = -1
	end if
	SQL SELECT Count ( saleinvcode ) INTO :ll_saleinv_counter FROM Saleledger WHERE saleledger.custcode =:al_custcode AND date >= convert ( datetime , ( convert ( varchar ( 2 ) , datepart ( mm , getdate ( ) ) ) + '/' + convert ( varchar ( 2 ) , datepart ( dd , getdate ( ) ) ) + '/' + convert ( varchar ( 4 ) , datepart ( yy , getdate ( ) ) ) ) ) and date <= convert ( datetime , ( convert ( varchar ( 2 ) , datepart ( mm , getdate ( ) ) ) + '/' + convert ( varchar ( 2 ) , datepart ( dd , getdate ( ) ) ) + '/' + convert ( varchar ( 4 ) , datepart ( yy , getdate ( ) ) ) ) + ' 23:59:59' ) and saleledger.saleinvcode not in ( :ll_invcode ) USING this.it_transobject;
	return ll_saleinv_counter

// w_sale.wf_postareawise() returns integer
	integer li_errcode
	integer li_count
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_area_singleselection_posting)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING this.it_transobject;
			if lstr_arginfo.s_name1 = "N" then
				SQL Select count ( *) INTO :ll_saleinvcount From saleledger WITH ( UPDLOCK HOLDLOCK ) Where saleledger.saleinvcode Between :lstr_arginfo.l_code2 AND :lstr_arginfo.l_code3 AND saleledger.salecatcode =:this.ii_saletype and saleledger.custcode IN ( select custcode from customer where areacode =:lstr_arginfo.l_code1 ) AND saleledger.Posted ='N' AND ImpactInventory ='Y' USING this.it_transobject;
				li_errcode = this.it_transobject.sqlcode
				if li_errcode = 0 then
					this.it_transobject.postsaleledgerareawise(lstr_arginfo.l_code2, lstr_arginfo.l_code3, this.ii_saletype, ll_salesmancode, lstr_arginfo.l_code1, this.ic_impactinventory, lstr_arginfo.s_name1)
					if this.it_transobject.sqlcode <> 0 then
						li_errcode = this.it_transobject.sqlcode
						ls_msgtext = this.it_transobject.sqlerrtext
					end if
				end if
			else
				SQL Select count ( *) INTO :ll_saleinvcount From saleledger WITH ( UPDLOCK HOLDLOCK ) Where saleledger.custcode IN ( select custcode from customer where areacode =:lstr_arginfo.l_code1 ) AND salecatcode =:this.ii_saletype AND saleledger.Posted ='N' AND ImpactInventory ='Y' USING this.it_transobject;
				li_errcode = this.it_transobject.sqlcode
				if li_errcode = 0 then
					this.it_transobject.postsaleledgerareawise(lstr_arginfo.l_code2, lstr_arginfo.l_code3, this.ii_saletype, ll_salesmancode, lstr_arginfo.l_code1, this.ic_impactinventory, lstr_arginfo.s_name1)
					if this.it_transobject.sqlcode <> 0 then
						li_errcode = this.it_transobject.sqlcode
						ls_msgtext = this.it_transobject.sqlerrtext
					end if
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				li_errcode = this.it_transobject.sqlcode
				ls_msgtext = this.it_transobject.sqlerrtext
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode))
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_saleinvcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return li_errcode

// w_sale.wf_check_unique_refno() returns long
	long ll_custcode
	long ll_invid
	long ll_counter
	string ls_refno
	if f_stringpreferences("UniqueRefNoInSale") = "Y" then
		ls_refno = this.id_master.getitemstring(1, "custrefno")
		if trim(ls_refno) <> "" and not isnull(ls_refno) and this.ii_saletype = 2 then
			ll_custcode = this.id_master.getitemnumber(1, "custcode")
			ll_counter = 0
			ll_invid = 0
			ll_invid = this.id_master.getitemnumber(1, "code")
			if ll_invid > 0 then
				SQL SELECT COUNT ( *) INTO :ll_counter FROM saleledger WHERE custcode =:ll_custcode AND saleledger.saleinvcode <> :ll_invid AND RTrim ( LTrim ( custrefno ) ) =RTrim ( LTrim ( :ls_refno ) ) USING this.it_transobject;
			else
				SQL SELECT COUNT ( *) INTO :ll_counter FROM saleledger WHERE custcode =:ll_custcode AND RTrim ( LTrim ( custrefno ) ) =RTrim ( LTrim ( :ls_refno ) ) USING this.it_transobject;
			end if
			if ll_counter > 0 then
				messagebox("Ref. validation", "Ref. No " + ls_refno + " already exist for selected customer ~r~nplease type a unique Ref.No. ")
				this.id_master.setcolumn("custrefno")
				this.id_master.setfocus()
				return 0
			end if
			return
		end if
		return
	end if
	return 1

// w_sale.wf_is_itemdue_allowed(long al_icode, ref string as_errtext) returns long
	char ls_allowdue
	string ls_itemname
	SQL SELECT itemname =Name , AllowDue =UPPER ( AllowDue ) INTO :ls_itemname, :ls_allowdue FROM Item WHERE ICode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ls_allowdue = "Y" then
			return 1
		else
			as_errtext = "Due not Allowed on this item.~r~nItem Name = " + ls_itemname
			return 0
		end if
		return
	end if
	as_errtext = "Database Problem while check Allow Due Status of item.~r~nReasons are:- " + this.it_transobject.sqlerrtext
	return -1

// w_sale.wf_check_dueitems(long al_usercode) returns long
	integer li_option = 1
	long ll_duerightfound
	long ll_counter
	long ll_currentrow
	long ll_rowfound
	long ll_icode
	long ll_dueonitem
	long ll_retcode
	double ld_looseqty
	double ld_bonusqty
	double ld_stock
	boolean lb_found
	boolean lb_due_item_exist
	string ls_errtext
	datastore lds_items
	s_datastore lstr_arg
	ll_rowfound = this.id_detail.find(" looseqty + bonusqty - stock > 0 ", 1, this.id_detail.rowcount())
	if ll_rowfound > 0 then
		lb_due_item_exist = true
	else
		ll_retcode = 1
		return ll_retcode
	end if
	if lb_due_item_exist then
		SQL SELECT COUNT ( *) INTO :ll_duerightfound FROM DBO.GroupRights WHERE RightCode =635 AND GroupCode IN ( SELECT GroupCode FROM DBO.UserGroups WHERE UserCode =:al_usercode ) USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Due Rights Problem", "Problem in varification of due rights~rcontact system administrator for help", stopsign!)
			ll_retcode = 0
			return ll_retcode
		end if
	else
		ll_retcode = 1
		return ll_retcode
	end if
	if lb_due_item_exist and ll_duerightfound = 0 then
		li_option = messagebox("Due Rights Problem", "There are some due items in this invoice.~r~nYou donot have sufficient rights to sale such item(s).~r~nKindly either remove them or call administrator for your support~rDo you need list of such items?", question!, yesno!, 1)
		if li_option = 1 then
			lds_items = create datastore
			lds_items.dataobject = "d_item_dueitemlist"
			lds_items.settransobject(sqlca)
			for ll_counter = 1 to this.id_detail.rowcount()
				ld_looseqty = this.id_detail.getitemnumber(ll_counter, "looseqty")
				ld_bonusqty = this.id_detail.getitemnumber(ll_counter, "bonusqty")
				ld_stock = this.id_detail.getitemnumber(ll_counter, "stock")
				if ld_looseqty + ld_bonusqty - ld_stock > 0.0 then
					lb_found = true
					ll_currentrow = lds_items.insertrow(0)
					lds_items.setitem(ll_currentrow, "icode", this.id_detail.getitemnumber(ll_counter, "icode"))
					lds_items.setitem(ll_currentrow, "aliasname", this.id_detail.getitemstring(ll_counter, "fullcode"))
					lds_items.setitem(ll_currentrow, "itemname", this.id_detail.getitemstring(ll_counter, "itemname"))
					lds_items.setitem(ll_currentrow, "gcode", this.id_detail.getitemnumber(ll_counter, "gcode"))
					lds_items.setitem(ll_currentrow, "stock", this.id_detail.getitemnumber(ll_counter, "stock"))
					lds_items.setitem(ll_currentrow, "saleqty", this.id_detail.getitemnumber(ll_counter, "looseqty"))
					lds_items.setitem(ll_currentrow, "dueqty", ld_looseqty + ld_bonusqty - ld_stock)
				end if
			next
			if lb_found then
				lstr_arg.ds = lds_items
				openwithparm(w_due_itemlist, lstr_arg)
				lstr_arg = message.powerobjectparm
				if lstr_arg.i_closemode < 1 then
					ll_retcode = 0
					return ll_retcode
				end if
				return
			end if
		else
			ll_retcode = 0
		end if
	elseif lb_due_item_exist and ll_duerightfound > 0 then
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
			ld_looseqty = this.id_detail.getitemnumber(ll_counter, "looseqty")
			ld_bonusqty = this.id_detail.getitemnumber(ll_counter, "bonusqty")
			ld_stock = this.id_detail.getitemnumber(ll_counter, "stock")
			if ld_looseqty + ld_bonusqty - ld_stock > 0.0 then
				ll_dueonitem = wf_is_itemdue_allowed(ll_icode, ls_errtext)
				if ll_dueonitem <= 0 then
					messagebox("Item Due Validation", ls_errtext + "~r~nRow No.: " + string(ll_counter) + "~r~nTotal Qty: " + string(ld_looseqty + ld_bonusqty) + "~r~nStock in Hand: " + string(ld_stock) + "~r~nDue Qty: " + string(ld_looseqty + ld_bonusqty - ld_stock), stopsign!)
					this.id_detail.setrow(ll_counter)
					this.id_detail.setcolumn("looseqty")
					this.id_detail.setfocus()
					ll_retcode = 0
					return ll_retcode
				else
					ll_retcode = 1
				end if
			end if
		next
	end if
	return ll_retcode

// w_sale.wf_show_customerwisesaledetailreport() returns 0
	long ll_custcode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_custcode = this.id_master.object.custcode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_custcode = this.id_list.object.custcode[this.id_list.getrow()]
	end if
	if not isnull(ll_custcode) and ll_custcode <> 0 then
		openwithparm(w_customer_saledetail_report, ll_custcode)
	end if

// w_sale.wf_apply_roundingpolicy() returns long
	long ll_roundfactor
	long ll_int
	long ll_mininvtotal
	double ld_invtotal
	double ld_half
	double ld_totdiscount
	double ld_diff
	ll_roundfactor = f_numberpreferences("roundsaleinvtonearestmultiple")
	ll_mininvtotal = f_numberpreferences("roundsaleinvtonearestmultiplelimit")
	if ll_roundfactor = 0 then
		return 0
	end if
	ld_invtotal = wf_grandtotal()
	if ll_roundfactor > 0 and ld_invtotal > ll_mininvtotal then
		this.id_footer.object.misccharges[1] = 0.00
		this.id_footer.object.flatdisc[1] = 0.00
		this.id_footer.accepttext()
		wf_grandtotal()
		ld_totdiscount = this.id_footer.object.totaldiscount[1]
		ld_invtotal = wf_get_invtotal()
		if isnull(ld_invtotal) then
			return 0
		end if
		ld_half = round(double(ll_roundfactor / 2.00), 2)
		ll_int = long(ld_invtotal / ll_roundfactor)
		if ld_invtotal <> double(ll_int * ll_roundfactor) then
			ld_diff = ld_invtotal - double(ll_int * ll_roundfactor)
			if ld_diff >= ld_half then
				if ld_totdiscount >= ll_roundfactor then
					this.id_footer.object.misccharges[1] = this.id_footer.object.misccharges[1] + (double((ll_int + 1) * ll_roundfactor) - ld_invtotal)
				end if
			else
				this.id_footer.object.flatdisc[1] = this.id_footer.object.flatdisc[1] + ld_diff
			end if
		end if
		this.id_footer.accepttext()
		ld_invtotal = wf_grandtotal()
		this.id_footer.object.total[1] = ld_invtotal
	end if
	return 0

// w_sale.wf_get_invtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_discountvalue
	double ld_invtaxperc1val
	double ld_intaxperc1
	double ld_totaltax
	double ld_totalitemleveltax
	double ld_grossamt_rate_qty
	double ld_totaldiscount
	double ld_accumulateddiscperc
	double lr_discperc
	double lr_flatdisc
	double lr_misccharges
	double lr_salestax
	double lr_itemstotal
	integer li_roundupto
	li_roundupto = f_numberpreferences("roundsaleinvon")
	if isnull(li_roundupto) or li_roundupto < 0 then
		li_roundupto = 0
	end if
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
		ld_grossamt_rate_qty = this.id_detail.getitemnumber(1, "c_grossamt_rate_qty")
		ld_totaldiscount = this.id_detail.getitemnumber(1, "c_totaldiscount")
		lr_discperc = this.id_footer.object.invdiscperc[1]
		lr_flatdisc = this.id_footer.object.flatdisc[1]
		lr_misccharges = this.id_footer.object.misccharges[1]
		lr_salestax = this.id_footer.object.salestax[1]
		ld_intaxperc1 = this.id_footer.object.invgstperc1[1]
		ld_totalitemleveltax = this.id_detail.getitemnumber(1, "c_sumtaxval") + this.id_detail.getitemnumber(1, "c_sumgstval")
		this.id_footer.object.t_discountvalue.text = string(ld_detaildwtotal * lr_discperc * 0.01, "########0.00")
		ld_discountvalue = ld_detaildwtotal * lr_discperc * 0.01
		ld_detaildwtotal = round(ld_detaildwtotal, 2)
		ld_grandtotal = round(ld_detaildwtotal - ld_discountvalue - lr_flatdisc + lr_misccharges + lr_salestax, li_roundupto)
		ld_invtaxperc1val = round((ld_detaildwtotal - ld_discountvalue - lr_flatdisc) * ld_intaxperc1 * 0.01, 2)
		ld_totaltax = round(ld_invtaxperc1val + ld_totalitemleveltax, li_roundupto)
		ld_grandtotal = ld_grandtotal + ld_totaltax
		ld_totaldiscount = ld_totaldiscount + ld_discountvalue + lr_flatdisc
		if ld_grossamt_rate_qty = 0.0 then
			ld_grossamt_rate_qty = 1
		end if
		ld_accumulateddiscperc = round(ld_totaldiscount / ld_grossamt_rate_qty * 100.0, 2)
	end if
	return ld_grandtotal

// w_sale.wf_assign_saleset_objects() returns long
	this.dw_salesetsheader.dataobject = "d_salesetheader_selection"
	this.dw_salesetsdetail.dataobject = "d_salesetsdetail"
	this.dw_salesetsorigdetail.dataobject = "d_salesetsdetail_selection"
	this.dw_salesetsheader.settransobject(this.it_transobject)
	this.dw_salesetsdetail.settransobject(this.it_transobject)
	this.dw_salesetsorigdetail.settransobject(this.it_transobject)
	return 0

// w_sale.wf_show_salesets_form() returns 0
	long ll_icode
	long ll_found
	long ll_defaultrecipe
	long ll_row
	string ls_patient
	string ls_custname
	s_datawindow lstr_dw
	if wf_iseditable() = false then
		return
	end if
	if this.tab_retrieve.selectedtab = 1 then
		this.id_detail.accepttext()
		if this.id_detail.rowcount() > 0 and this.id_detail.getrow() > 0 then
			ll_row = this.id_detail.getrow()
			ll_icode = this.id_detail.object.icode[ll_row]
			if wf_is_setitem(ll_icode, ll_defaultrecipe) = 1 then
				lstr_dw.dw = this.dw_salesetsheader
				lstr_dw.dw2 = this.dw_salesetsorigdetail
				lstr_dw.l_code = ll_icode
				lstr_dw.l_code2 = this.id_detail.object.myrowid[ll_row]
				lstr_dw.d_value = this.id_detail.object.looseqty[ll_row]
				lstr_dw.d_value2 = this.id_detail.object.saleprice[ll_row]
				lstr_dw.i_protect = integer(this.id_detail.object.itemname.protect)
				openwithparm(w_salesets_form, lstr_dw)
				if wf_iseditable() then
				end if
				lstr_dw.dw.sharedata(this.dw_salesetsheader)
				lstr_dw.dw2.sharedata(this.dw_salesetsorigdetail)
				if ll_row > 0 and this.dw_salesetsheader.rowcount() > 0 then
					ll_found = this.dw_salesetsheader.find("parentrow = " + string(this.id_detail.object.myrowid[ll_row]), 1, this.dw_salesetsheader.rowcount())
					if ll_found > 0 and ll_found <= this.dw_salesetsheader.rowcount() then
						this.id_detail.object.saleprice[ll_row] = round(this.dw_salesetsheader.object.saleprice[ll_found], 2)
					end if
				end if
			end if
		end if
	end if

// w_sale.wf_is_setitem(long al_icode, ref long al_defaultrecipe) returns long
	long ll_itemtypecode
	long ll_retcode
	SQL SELECT itemtypecode , RecipeCode =ISNULL ( ( SELECT MAX ( R.RecipeCode ) FROM Recipe R WHERE R.ResultedItem =:al_icode AND R.Priority IN ( SELECT MIN ( RR.Priority ) FROM Recipe RR WHERE RR.ResultedItem =:al_icode ) ) , 0 ) INTO :ll_itemtypecode, :al_defaultrecipe FROM Item WHERE Icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_itemtypecode = 2 and al_defaultrecipe > 0 then
			ll_retcode = 1
		else
			ll_retcode = 0
		end if
	else
		ll_retcode = -1
	end if
	return ll_retcode

// w_sale.wf_delete_salesets_data(long al_row, long al_icode) returns long
	long ll_found
	long ll_myrowid
	boolean lb_continue = true
	ll_myrowid = this.id_detail.object.myrowid[al_row]
	ll_found = this.dw_salesetsheader.find("parentrow = " + string(ll_myrowid), 1, this.dw_salesetsheader.rowcount())
	if ll_found > 0 and ll_found <= this.dw_salesetsheader.rowcount() then
		this.dw_salesetsheader.deleterow(ll_found)
	end if
	ll_found = 1
	do while lb_continue and this.dw_salesetsorigdetail.rowcount() > 0 and ll_found > 0 and ll_found <= this.dw_salesetsorigdetail.rowcount()
		ll_found = this.dw_salesetsorigdetail.find("parentrow = " + string(ll_myrowid), 1, this.dw_salesetsorigdetail.rowcount())
		if ll_found > 0 and ll_found <= this.dw_salesetsorigdetail.rowcount() then
			this.dw_salesetsorigdetail.deleterow(ll_found)
			lb_continue = true
		else
			lb_continue = false
		end if
	loop
	return 0

// w_sale.wf_insert_salesets_data(long al_row, long al_icode, long al_recipecode) returns long
	long ll_row
	long ll_insrow
	long ll_counter
	long ll_retcode
	long ll_myrowid
	datastore lds_recipedetail
	datawindowchild ldc_recipe
	lds_recipedetail = create datastore
	lds_recipedetail.dataobject = "d_recipedetail"
	lds_recipedetail.settransobject(this.it_transobject)
	lds_recipedetail.retrieve(al_recipecode)
	ll_myrowid = this.id_detail.object.myrowid[al_row]
	if lds_recipedetail.rowcount() > 0 then
		ll_retcode = this.dw_salesetsheader.getchild("recipecode", ldc_recipe)
		ldc_recipe.settransobject(this.it_transobject)
		ldc_recipe.retrieve(al_icode)
		ll_insrow = this.dw_salesetsheader.insertrow(0)
		this.dw_salesetsheader.object.seticode[ll_insrow] = al_icode
		this.dw_salesetsheader.object.recipecode[ll_insrow] = al_recipecode
		this.dw_salesetsheader.object.saleinvcode[ll_insrow] = this.id_master.object.code[1]
		this.dw_salesetsheader.object.qty[ll_insrow] = this.id_detail.object.looseqty[al_row]
		this.dw_salesetsheader.object.saleprice[ll_insrow] = this.id_detail.object.saleprice[al_row]
		this.dw_salesetsheader.object.parentrow[ll_insrow] = ll_myrowid
		for ll_counter = 1 to lds_recipedetail.rowcount()
			ll_insrow = this.dw_salesetsorigdetail.insertrow(0)
			this.dw_salesetsorigdetail.object.icode[ll_insrow] = lds_recipedetail.object.icode[ll_counter]
			this.dw_salesetsorigdetail.object.fullcode[ll_insrow] = lds_recipedetail.object.fullcode[ll_counter]
			this.dw_salesetsorigdetail.object.itemname[ll_insrow] = lds_recipedetail.object.itemname[ll_counter]
			this.dw_salesetsorigdetail.object.remarks[ll_insrow] = lds_recipedetail.object.remarks[ll_counter]
			this.dw_salesetsorigdetail.object.saleprice[ll_insrow] = lds_recipedetail.object.price[ll_counter]
			this.dw_salesetsorigdetail.object.qty[ll_insrow] = lds_recipedetail.object.qty[ll_counter]
			this.dw_salesetsorigdetail.object.packunits[ll_insrow] = lds_recipedetail.object.packunits[ll_counter]
			this.dw_salesetsorigdetail.object.discperc[ll_insrow] = lds_recipedetail.object.discperc[ll_counter]
			this.dw_salesetsorigdetail.object.itemflatdisc[ll_insrow] = lds_recipedetail.object.itemflatdisc[ll_counter]
			this.dw_salesetsorigdetail.object.processcharge[ll_insrow] = lds_recipedetail.object.processcharge[ll_counter]
			this.dw_salesetsorigdetail.object.processchargeperc[ll_insrow] = lds_recipedetail.object.processchargeperc[ll_counter]
			this.dw_salesetsorigdetail.object.parentrow[ll_insrow] = ll_myrowid
		next
	end if
	return 0

// w_sale.wf_check_set_contents_stock(ref long al_row, ref string as_errortext) returns long
	long ll_counter
	long ll_icode
	long ll_gcode
	long ll_contenticode
	long ll_myrowid
	long ll_found
	long ll_startrow
	long ll_innercounter
	long ll_retcode
	long ll_roundqty
	double ld_qty
	double ld_contentqty
	double ld_godownstock
	ll_roundqty = f_get_colprecision("Qty")
	if f_stringpreferences("salesmodulemode") <> "A" and this.ib_salesets then
		ll_counter = 1
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.object.icode[ll_counter]
			ll_gcode = this.id_detail.object.gcode[ll_counter]
			ll_myrowid = this.id_detail.object.myrowid[ll_counter]
			ld_qty = this.id_detail.object.looseqty[ll_counter]
			if this.id_detail.object.itemtypecode[ll_counter] = 2 then
				ll_startrow = 1
				for ll_innercounter = 1 to this.dw_salesetsorigdetail.rowcount()
					ll_found = this.dw_salesetsorigdetail.find("parentrow = " + string(ll_myrowid), ll_startrow, this.dw_salesetsorigdetail.rowcount())
					do while ll_found > 0 and ll_found <= this.dw_salesetsorigdetail.rowcount() and ll_startrow <= this.dw_salesetsorigdetail.rowcount()
						ld_godownstock = 0
						ll_contenticode = this.dw_salesetsorigdetail.object.icode[ll_found]
						ld_contentqty = round(this.dw_salesetsorigdetail.object.qty[ll_found] * this.id_detail.object.looseqty[ll_counter], ll_roundqty)
						this.it_transobject.getitemstocktotal(ll_gcode, ll_contenticode, ld_godownstock)
						if this.it_transobject.sqlcode <> 0 then
							ll_retcode = -1
							as_errortext = "Database Error: Content Item Stock information can not be retrieved"
							ll_found = 0
						elseif ld_godownstock < ld_contentqty then
							ll_retcode = -2
							al_row = ll_counter
							as_errortext = "Not Enough Stock available for Set/Deal Content Item~r~n~r~n" + "Row No. = " + string(ll_counter) + "~r~n" + "Item Name = " + this.id_detail.object.itemname[ll_counter] + "~r~n" + "Set/Deal Qty = " + string(this.id_detail.object.looseqty[ll_counter]) + "~r~n~r~n" + "Content Item Name = " + this.dw_salesetsorigdetail.object.itemname[ll_found] + "~r~n" + "Content Item Qty = " + string(ld_contentqty) + "~r~n" + "Content Item Stock = " + string(ld_godownstock) + "~r~n" + "Content Item Shortage = " + string(ld_contentqty - ld_godownstock)
							ll_found = 0
						else
							ll_startrow = ll_found + 1
							ll_found = this.dw_salesetsorigdetail.find("parentrow = " + string(ll_myrowid), ll_startrow, this.dw_salesetsorigdetail.rowcount())
						end if
					loop
				next
			end if
		next
	end if
	return ll_retcode

// w_sale.wf_set_salesets_data(long al_row, long al_icode, integer ai_del, integer ai_ins) returns long
	long ll_defaultrecipe
	long ll_row
	long ll_tmpcode
	long ll_retcode
	if al_row > 0 and this.ib_salesets and ai_del = 1 then
		ll_tmpcode = this.id_detail.object.itemcode[al_row]
		if isnull(ll_tmpcode) then
			ll_tmpcode = -1
		end if
		if ll_tmpcode <> al_icode then
			if ll_tmpcode = -1 then
				ll_tmpcode = al_icode
			end if
			wf_delete_salesets_data(al_row, ll_tmpcode)
			ll_retcode = 1
		end if
	end if
	if al_row > 0 and this.ib_salesets and wf_is_setitem(al_icode, ll_defaultrecipe) = 1 and ai_ins = 1 and ll_retcode = 1 then
		wf_insert_salesets_data(al_row, al_icode, ll_defaultrecipe)
	end if
	return 0

