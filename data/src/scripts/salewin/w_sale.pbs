	end if
	if f_stringpreferences("messageinsale") = "N" then
		this.id_master.object.messagecode.visible = false
		this.id_master.object.t_message.visible = false
	end if
	if f_stringpreferences("salesmaninsale") = "N" then
		this.id_master.object.smancode.visible = false
		this.id_master.object.t_salesman.visible = false
	end if
	if f_stringpreferences("SaleDisplayItemDiscPerc") = "Y" then
		this.id_master.object.itemdiscpercno.visible = true
		this.id_master.object.t_itemdiscpercno.visible = true
	end if
	if f_stringpreferences("ShowLoyaltyPointBalanceInSale") = "Y" then
		this.id_master.object.t_pointsbalance.visible = true
		this.id_master.object.pointsbalance.visible = true
	end if
	if f_stringpreferences("showmotorvehicleinsale") = "N" then
		this.id_master.object.chasisno_t.visible = false
		this.id_master.object.chasisno.visible = false
		this.id_master.object.motorvehiclecode_t.visible = false
		this.id_master.object.motorvehiclecode.visible = false
	end if
	if f_stringpreferences("showcurrencyinsale") = "N" then
		this.id_master.object.currencycode.visible = false
		this.id_master.object.currencycode_t.visible = false
		this.id_master.object.conversionrate.visible = false
		this.id_master.object.conversionrate_t.visible = false
		this.id_footer.object.gb_foreign.visible = false
		this.id_footer.object.c_foreign_sale.visible = false
		this.id_footer.object.t_foreign_sale.visible = false
		this.id_footer.object.c_foreign_sr.visible = false
		this.id_footer.object.t_foreign_sr.visible = false
		this.id_footer.object.c_foreign_net.visible = false
		this.id_footer.object.t_foreign_net.visible = false
	end if
	return 0

// w_sale.wf_show_saleinvoicereturnstatus() returns long
	long ll_invcode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_invcode = this.id_master.object.code[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_invcode = this.id_list.object.code[this.id_list.getrow()]
	end if
	if isnull(ll_invcode) then
		ll_invcode = -1
	end if
	if ll_invcode > 0 then
		openwithparm(w_saleinvoicereturnstatus, ll_invcode)
	end if
	return 0

// w_sale.wf_restrict_sale_from_single_godown() returns integer
	long ll_counter
	long ll_retcode
	integer li_gcode
	if this.id_detail.rowcount() > 0 then
		li_gcode = this.id_detail.object.gcode[1]
		for ll_counter = 1 to this.id_detail.rowcount()
			if this.id_detail.object.gcode[ll_counter] <> li_gcode then
				ll_retcode = -1
				this.id_detail.setfocus()
				this.id_detail.setcolumn("gcode")
				this.id_detail.setrow(ll_counter)
				this.id_detail.scrolltorow(ll_counter)
				return ll_retcode
			end if
		next
	end if
	return ll_retcode

// w_sale.wf_set_invdiscperc_at_threshhold() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_discountvalue
	double ld_invtaxperc1val
	double ld_intaxperc1
	double ld_totaltax
	double ld_totalitemleveltax
	double ld_grossamt_rate_qty
	double ld_totaldiscount
	double ld_accumulateddiscperc
	double lr_discperc
	double lr_flatdisc
	double lr_misccharges
	double lr_salestax
	double lr_itemstotal
	double ld_discperc_pref_val
	double ld_threshholdlimit
	lr_discperc = this.id_footer.object.invdiscperc[1]
	if lr_discperc = 0.0 then
		ld_discperc_pref_val = 0.00
		ld_threshholdlimit = 0.00
		ld_discperc_pref_val = f_doublepreferences("InvDiscPercValOnSavingInSale")
		ld_threshholdlimit = f_doublepreferences("InvDiscPercThreshHoldValOnSavingInSale")
		if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
			ld_detaildwtotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
			lr_flatdisc = this.id_footer.object.flatdisc[1]
			lr_misccharges = this.id_footer.object.misccharges[1]
			ld_detaildwtotal = round(ld_detaildwtotal, 2)
			ld_grandtotal = ld_detaildwtotal - lr_flatdisc
			if ld_grandtotal >= ld_threshholdlimit then
				this.id_footer.object.invdiscperc[1] = ld_discperc_pref_val
				this.id_footer.accepttext()
			end if
		end if
	end if
	return 0

// w_sale.wf_set_lastinv_columns() returns integer
	long ll_smancode
	long ll_deliveredby
	if this.il_codevalue > 0 and this.id_master.rowcount() > 0 and isnull(this.id_master.object.code[1]) then
		SQL SELECT SManCode , DeliveredBy INTO :ll_smancode, :ll_deliveredby FROM SaleLedger WHERE SaleInvCode =:this.il_codevalue USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.id_master.object.smancode[1] = ll_smancode
			this.id_master.object.deliveredby[1] = ll_deliveredby
		end if
	end if
	return 0

// w_sale.wf_apply_saleman_outstandinglimit() returns long
	long ll_retcode
	long ll_invcode
	integer li_saleperson
	double ld_outstandingamt
	double ld_invoutstanding
	double ld_outstandinglimit
	if f_stringpreferences("ApplySalePersonOutstandingLimitInSale") = "Y" and this.ii_saletype <> 3 then
		li_saleperson = this.id_master.object.smancode[1]
		ll_invcode = this.id_master.object.code[1]
		ld_invoutstanding = this.id_master.object.outstandingamt[1]
		if isnull(ld_invoutstanding) then
			ld_invoutstanding = 0
		end if
		if isnull(ll_invcode) then
			ll_invcode = -1
		end if
		if li_saleperson > 0 then
			SQL SELECT OutstandingAmt =SUM ( ISNULL ( S.OutstandingAmt , 0 ) ) , OutstandingLimit =( SELECT SM.OutStandingLimit FROM SalesMan SM WHERE SM.SalesManCode =:li_saleperson ) INTO :ld_outstandingamt, :ld_outstandinglimit FROM SaleLedger S WHERE S.SManCode =:li_saleperson AND S.SaleInvCode <> :ll_invcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ld_outstandingamt + ld_invoutstanding > ld_outstandinglimit then
					messagebox("Sale Person Outstanding Limit", "Sale Person Outstanding Limit Breached.~r~n~r~n" + "Sale Person Outstanding Limit = " + trim(string(ld_outstandinglimit, "###,###,##0,00")) + "~r~n" + "Outstanding Invoices Amount = " + trim(string(ld_outstandingamt, "###,###,##0,00")) + "~r~n" + "This Invoice Outstanding Amount = " + trim(string(ld_invoutstanding, "###,###,##0,00")) + "~r~n~r~n" + "Exceeding Amount = " + trim(string(ld_outstandingamt + ld_invoutstanding - ld_outstandinglimit, "###,###,##0,00")), stopsign!)
					ll_retcode = -1
				else
					ll_retcode = 0
				end if
			else
				messagebox("Sale Person Outstanding Limit", "Some Database Problem occurred while processing Sale Person Outstanding Limit.~r~nReasons are:-" + sqlca.sqlerrtext, stopsign!)
				ll_retcode = -1
			end if
		end if
	else
		ll_retcode = 0
	end if
	return ll_retcode

// w_sale.wf_find_patient_by_phone() returns integer
	long ll_null
	long ll_custcode
	string ls_null
	string ls_regno
	s_arguements lstr_arg
	long ll_totpatients
	u_ds_standard lds_patients
	setnull(ll_null)
	setnull(ls_null)
	open(w_arg_phoneno)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		lds_patients = create u_ds_standard
		lds_patients.dataobject = "ddd_patientbyphoneno"
		lds_patients.settransobject(this.it_transobject)
		lds_patients.retrieve(lstr_arg.s_name1)
		ll_totpatients = lds_patients.rowcount()
		if ll_totpatients <> 0 then
			if ll_totpatients = 1 then
				this.id_master.object.custcode[1] = lds_patients.object.custcode[1]
				lstr_arg.l_code1 = lds_patients.object.patientcode[1]
				ls_regno = lds_patients.object.regno[1]
				wf_setpatientinfo(lstr_arg.l_code1)
				wf_validate_patient_from_outside(ls_regno)
				this.id_master.object.patientregno[1] = lds_patients.object.regno[1]
				this.id_master.object.patientcode[1] = lds_patients.object.patientcode[1]
			else
				openwithparm(w_patientphonesearchresult, lstr_arg)
				lstr_arg = message.powerobjectparm
				if lstr_arg.i_status = 1 then
					this.id_master.object.custcode[1] = lstr_arg.l_code2
					ls_regno = lstr_arg.s_name1
					wf_setpatientinfo(lstr_arg.l_code1)
					wf_validate_patient_from_outside(ls_regno)
					this.id_master.object.patientregno[1] = lstr_arg.s_name1
					this.id_master.object.patientcode[1] = lstr_arg.l_code1
				end if
			end if
		end if
		if lstr_arg.l_code1 > 0 and wf_checkpatientlicexpiry(lstr_arg.l_code1) = 2 then
			this.id_master.object.patientregno[1] = ls_null
			this.id_master.object.patientcode[1] = ll_null
			this.id_master.setfocus()
			this.id_master.setcolumn("patientregno")
			this.id_master.accepttext()
		end if
	end if
	return 0

// w_sale.wf_get_patients_from_outside() returns long
	string ls_errtext = "                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        0"
	u_transaction lt_mytrans
	lt_mytrans = create u_transaction
	SQL start USING lt_mytrans;
	lt_mytrans.get_patient_from_outside()
	if lt_mytrans.sqlcode = 0 then
		SQL commit USING lt_mytrans;
	else
		ls_errtext = lt_mytrans.sqlerrtext
		SQL rollback USING lt_mytrans;
		messagebox("Patient Data Fetch Error", "Problem Fetching Patients data from other data sources.~r~nDetails Are:-~r~n" + ls_errtext, stopsign!)
	end if
	destroy lt_mytrans
	return 0

// w_sale.wf_validate_patient_from_outside(string as_regno) returns long
	u_transaction it_mytrans
	string ls_name
	string ls_regno
	string ls_city
	string ls_nic
	string ls_customer
	string ls_patient
	string ls_ref
	long ll_patientcode
	long ll_relationcode
	long ll_doctcode
	long ll_wardcode
	long ll_recperiod
	long ll_prow
	long ll_found
	long ll_pcode
	it_mytrans = create u_transaction
	SQL start USING it_mytrans;
	it_mytrans.validate_patient_from_outside(as_regno)
	if it_mytrans.sqlcode = 0 then
		SQL commit USING it_mytrans;
	else
		SQL rollback USING it_mytrans;
	end if
	if this.ic_retrievepatientlist = "N" then
		SQL SELECT Name =P.name , Regno =P.regno , patientcode =P.patientcode , City =P.city , NIC =P.NationalIDCard , relationcode =P.relationcode , doctcode =P.doctcode , wardcode =P.wardcode , customer =A.name , patient =LTRIM ( RTRIM ( P.Name ) ) + ' (' + LTRIM ( RTRIM ( P.RegNo ) ) + ')' , RecurringPeriod =ISNULL ( P.RecurringPeriod , 0 ) , Reference =P.Reference INTO :ls_name, :ls_regno, :ll_patientcode, :ls_city, :ls_nic, :ll_relationcode, :ll_doctcode, :ll_wardcode, :ls_customer, :ls_patient, :ll_recperiod, :ls_ref FROM Patient P , Accounts A WHERE P.RegNo =:as_regno AND P.CustCode =A.AccCode USING it_mytrans;
		if it_mytrans.sqlcode = 0 then
			ll_found = this.idc_patient.find("regno = '" + as_regno + "'", 1, this.idc_patient.rowcount())
			if ll_found > 0 and ll_found <= this.idc_patient.rowcount() then
				ll_prow = ll_found
			else
				ll_prow = this.idc_patient.insertrow(0)
			end if
			setnull(ll_pcode)
			this.idc_patient.setitem(ll_prow, "name", ls_name)
			this.idc_patient.setitem(ll_prow, "regno", ls_regno)
			this.idc_patient.setitem(ll_prow, "patientcode", ll_patientcode)
			this.idc_patient.setitem(ll_prow, "city", ls_city)
			this.idc_patient.setitem(ll_prow, "nic", ls_nic)
			this.idc_patient.setitem(ll_prow, "relationcode", ll_relationcode)
			this.idc_patient.setitem(ll_prow, "doctcode", ll_doctcode)
			this.idc_patient.setitem(ll_prow, "wardcode", ll_wardcode)
			this.idc_patient.setitem(ll_prow, "customer", ls_customer)
			this.idc_patient.setitem(ll_prow, "patient", ls_patient)
			this.idc_patient.setitem(ll_prow, "RecurringPeriod", ll_recperiod)
			this.idc_patient.setitem(ll_prow, "Reference", ls_ref)
			this.idc_patient.scrolltorow(ll_prow)
			this.id_master.setredraw(false)
			this.id_master.object.patientcode[1] = ll_patientcode
			this.id_master.setredraw(true)
		end if
	else
		this.idc_patient.retrieve(this.ii_salemodule)
	end if
	this.idc_patient.setredraw(true)
	destroy it_mytrans
	return 0

// w_sale.wf_update_patientnic_from_refno() returns long
	long ll_patientcode
	string ls_nic
	if f_stringpreferences("UpdatePatientNICFromRefNoOnSaving") = "Y" then
		ll_patientcode = this.id_master.object.patientcode[1]
		ls_nic = this.id_master.object.custrefno[1]
		if isnull(ls_nic) then
			ls_nic = ""
		end if
		if ll_patientcode > 0 and len(ls_nic) > 0 then
			SQL update Patient SET NationalIDCard =:ls_nic WHERE PatientCode =:ll_patientcode USING this.it_transobject;
		end if
	end if
	return 0

// w_sale.wf_check_patientnic_on_saving() returns long
	long ll_retcode
	long ll_patientcode
	string ls_nic
	if f_stringpreferences("CheckPatientNICOnSaving") = "Y" then
		ll_patientcode = this.id_master.object.patientcode[1]
		if ll_patientcode > 0 then
			SQL SELECT NationalIDCard INTO :ls_nic FROM Patient WHERE PatientCode =:ll_patientcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if isnull(ls_nic) or isnull(ls_nic) then
					messagebox("Patient NIC Validation", "Patient NIC does not exist. Please select a patient with valid nic", stopsign!)
					this.id_master.setcolumn("patientcode")
					this.id_master.setfocus()
					ll_retcode = -1
				else
					ll_retcode = 0
				end if
			else
				messagebox("Patient NIC Validation", "Problem in validation Patient NIC. Some Database problem occured. Please Try again or select a patient with valid nic", stopsign!)
				ll_retcode = -1
			end if
		else
			ll_retcode = 0
		end if
	else
		ll_retcode = 0
	end if
	return ll_retcode

// w_sale.wf_populate_patient_last_sale_inv() returns integer
	datastore lds_saletemplatedetail
	datastore lds_saletemplateheader
	s_saletemplate lstr_template
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	boolean lb_salepricefromtemplate
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrows
	long ll_packunits
	long ll_found
	long ll_innercounter
	long ll_patientcode
	long ll_max_invcode
	integer li_addbonusinqty
	integer li_retcode = 1
	integer li_errcode
	integer li_counter
	double ld_looseqty
	double ld_holdbonusqty
	double ld_holdqty
	datawindowchild ldc_godown
	if wf_iseditable() = false then
		return 0
	end if
	lds_saletemplatedetail = create datastore
	lds_saletemplatedetail.dataobject = this.id_detail.dataobject
	lds_saletemplatedetail.settransobject(this.it_transobject)
	li_retcode = lds_saletemplatedetail.getchild("gcode", ldc_godown)
	ldc_godown.settransobject(this.it_transobject)
	li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	ll_patientcode = this.id_master.object.patientcode[1]
	SQL Select max ( saleinvcode ) INTO :ll_max_invcode FROM Saleledger WHERE patientcode =:ll_patientcode USING this.it_transobject;
	ll_totalrows = lds_saletemplatedetail.retrieve(ll_max_invcode)
	if ll_totalrows < 0 then
		li_retcode = -1
	end if
	ll_totalrows = lds_saletemplatedetail.rowcount()
	if ll_totalrows > 0 then
		lb_enablesave = true
	end if
	for li_counter = 1 to this.id_detail.rowcount()
		event ue_deleteitem()
	next
	for ll_rowcount = 1 to ll_totalrows
		this.id_detail.insertrow(0)
		wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
		this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "looseqty"))
		this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "bonusqty"))
	next
	destroy lds_saletemplatedetail
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	return 0

// w_sale.wf_check_patient_inv_period() returns long
	long ll_days
	long ll_patientcode
	long ll_invcode
	long ll_msgcode
	long ll_retcode
	long ll_pref_days
	datetime ldt_invdate
	ll_retcode = 0
	ll_patientcode = this.id_master.object.patientcode[1]
	ll_days = -1
	ll_pref_days = f_numberpreferences("CheckPatientSaleInvOccuranceeNoOfDays")
	SQL select datediff ( d , date , getdate ( ) ) , date , saleinvcode INTO :ll_days, :ldt_invdate, :ll_invcode from saleledger where saleinvcode in ( select max ( saleinvcode ) from saleledger where patientcode =:ll_patientcode ) USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("patient validation", "Unable to get Patient Sale Inv. Duration")
	end if
	if ll_days >= 0 and ll_days < ll_pref_days + 1 then
		ll_msgcode = messagebox("Patient Validation", "Period for selected Patient is less than or equal to " + string(ll_pref_days) + " days~r~nPeriod(Days) Set: " + string(ll_days) + ", Last Inv.Code=" + string(ll_invcode) + "~r~nDo you want to continue", question!, yesno!, 1)
		if ll_msgcode = 2 then
			ll_retcode = -1
		end if
	end if
	return ll_retcode

// w_sale.wf_edit_due_date() returns integer
	long ll_saleinvcode
	s_mastercashwin lstr_duedate
	if this.tab_retrieve.selectedtab = 2 then
		ll_saleinvcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if wf_isinvoiceinuse(ll_saleinvcode) then
			messagebox("Invoice Validation", "Sale Invoice already in use by some other user.~r~nKindly try again after sometime or open some other invoice.")
			return 0
		else
			lstr_duedate.l_invcode = ll_saleinvcode
			lstr_duedate.t_trans = this.it_transobject
			openwithparm(w_set_due_date, lstr_duedate)
		end if
	end if
	return 0

// w_sale.wf_get_itemmeter_reading(string as_name, long row) returns long
	double ld_meterreading
	long ll_metercode
	if len(as_name) > 0 and row > 0 then
		SQL SELECT currentreading , itemmetercode INTO :ld_meterreading, :ll_metercode FROM ItemMeter WHERE Name =:as_name USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.id_detail.object.itemmetercode[row] = ll_metercode
			this.id_detail.object.meterreading[row] = ld_meterreading
			return 0
		else
			return 1
		end if
		return
	end if
	return 0

// w_sale.wf_validate_pcs(long row, string data) returns long
	long ll_errcode
	long ll_found
	double ld_storedqty
	double ld_newqty
	double ld_stock
	double ld_desiredbonus
	double ld_areavolume
	double ld_pcs
	double ld_packcapacity
	double ld_tmpqty
	integer li_roundupto
	string ls_null
	setnull(ls_null)
	ld_packcapacity = this.id_detail.object.packcapacity[row]
	if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
		ld_packcapacity = 1
	end if
	ld_areavolume = this.id_detail.object.areavolume[row]
	if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
		ld_areavolume = 1
	end if
	ld_pcs = double(data)
	li_roundupto = f_get_colprecision("Qty")
	ld_tmpqty = round(ld_pcs * ld_areavolume, li_roundupto)
	if ld_pcs > 0.0 then
		this.id_detail.setitem(row, "looseqty", ld_tmpqty)
		this.id_detail.setitem(row, "cartons", trim(string(long(ld_pcs / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(ld_pcs mod ld_packcapacity, 2))))))
	else
		ll_errcode = 1
		messagebox("PCS Validation", "Only possitive PCS are allowed for this item", stopsign!)
	end if
	return ll_errcode

// w_sale.wf_apply_currency(long al_currencycode) returns boolean
	double ld_conversionrate
	SQL SELECT ConversionFactor INTO :ld_conversionrate FROM Currency WHERE CurrencyCode =:al_currencycode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ld_conversionrate) or ld_conversionrate <= 0.0 then
			ld_conversionrate = 0
		end if
		this.id_master.object.conversionrate[1] = ld_conversionrate
		this.id_footer.object.conversionrate[1] = ld_conversionrate
		this.id_footer.object.currencycode[1] = al_currencycode
		return true
	end if
	return false

// w_sale.wf_apply_conversionrate(double ad_rate) returns boolean
	if isnull(ad_rate) or ad_rate <= 0.0 then
		return false
	end if
	this.id_footer.object.conversionrate[1] = ad_rate
	return true

// w_sale.wf_approx_selectitembatches(long al_gcode, long al_icode, double ad_qty, double ad_bonus, ref datastore ad_itemsdetail, ref long al_rowscount, ref string as_errortext) returns long
	datastore lds_itemstockinfo
	long ll_counter
	long ll_detailrowcount
	double ld_saleqty
	double ld_reqqty
	double ld_totalstock
	double ld_batchqty
	double ld_bonusqty
	double ld_batchcostprice
	integer li_errcode
	integer li_round_qty
	string ls_batch
	datetime ldt_expiry
	li_round_qty = f_get_colprecision("Qty")
	lds_itemstockinfo = create datastore
	lds_itemstockinfo.dataobject = "d_itemstockinfo"
	lds_itemstockinfo.settransobject(this.it_transobject)
	if lds_itemstockinfo.retrieve(al_gcode, al_icode) > 0 then
		ld_totalstock = round(lds_itemstockinfo.getitemnumber(1, "c_totalstock"), li_round_qty)
		if ld_totalstock >= round(ad_qty + ad_bonus, li_round_qty) then
			ld_reqqty = round(ad_qty + ad_bonus, li_round_qty)
			ll_detailrowcount = ad_itemsdetail.rowcount()
			ll_counter = 1
			do while ll_counter <= lds_itemstockinfo.rowcount() and ld_reqqty > 0.0
				ld_batchqty = round(lds_itemstockinfo.getitemnumber(ll_counter, "currqty"), li_round_qty)
				if ld_batchqty >= ld_reqqty then
					ld_saleqty = ad_qty
					ld_bonusqty = ad_bonus
				elseif ld_batchqty <= ad_qty then
					ld_saleqty = ld_batchqty
					ld_bonusqty = 0
				else
					ld_saleqty = ad_qty
					ld_bonusqty = ld_batchqty - ad_qty
				end if
				ad_qty = ad_qty - ld_saleqty
				ad_bonus = ad_bonus - ld_bonusqty
				ld_reqqty = ad_qty + ad_bonus
				ad_itemsdetail.insertrow(0)
				ll_detailrowcount = ll_detailrowcount + 1
				ad_itemsdetail.setitem(ll_detailrowcount, "gcode", al_gcode)
				ad_itemsdetail.setitem(ll_detailrowcount, "icode", al_icode)
				ad_itemsdetail.setitem(ll_detailrowcount, "batch", lds_itemstockinfo.getitemstring(ll_counter, "batch"))
				ad_itemsdetail.setitem(ll_detailrowcount, "expiry", lds_itemstockinfo.getitemdatetime(ll_counter, "expiry"))
				ad_itemsdetail.setitem(ll_detailrowcount, "manfdate", lds_itemstockinfo.getitemdatetime(ll_counter, "manfdate"))
				ad_itemsdetail.setitem(ll_detailrowcount, "stock", ld_batchqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "totalstock", ld_totalstock)
				ad_itemsdetail.setitem(ll_detailrowcount, "looseqty", ld_saleqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "bonusqty", ld_bonusqty)
				ll_counter = ll_counter + 1
			loop
			al_rowscount = ll_counter - 1
		else
			li_errcode = 1
			al_rowscount = ld_totalstock
			as_errortext = "Stock has been decreased for this item   "
		end if
	else
		li_errcode = 1
		al_rowscount = ld_totalstock
		as_errortext = "Stock does not exist for this item   "
	end if
	destroy lds_itemstockinfo
	return li_errcode

// w_sale.wf_show_approx_batch_allocation() returns long
	long ll_retcode
	long ll_detailrows
	long ll_gcode
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long li_counter
	long li_innercounter
	long ll_insertedrows
	long ll_itemsdetailrowcount
	long ll_row
	long ll_rowgroup
	long ll_innercounter
	long ll_startrow
	long ll_found
	long ll_errorrow
	double ld_stock
	double ld_newstock
	double ld_salelooseqty
	double ld_dueqty
	double ld_looseqty
	double ld_bonusqty
	double ld_totalstock
	double ld_holdqty
	integer li_round_qty
	integer li_errorcode
	boolean lb_commitflag = true
	string ls_batch
	string ls_errortext
	string ls_autodue
	string ls_alternatecustomicode
	string ls_customicode
	string ls_itemname
	datetime ld_expiry
	datetime ldt_datetime
	datawindowchild ldc_godown
	datawindowchild ldc_itemmeter
	dwitemstatus ldws_column
	datastore id_batchallocation
	double ld_truncateqty
	s_datastore lstr
	if this.tab_retrieve.selectedtab = 2 then
		return 0
	end if
	if not wf_iseditable() then
		return 0
	end if
	id_batchallocation = create datastore
	id_batchallocation.dataobject = "d_approximate_batchallocation_detail"
	id_batchallocation.settransobject(this.it_transobject)
	ls_autodue = f_stringpreferences("salesmodulemode")
	li_round_qty = f_get_colprecision("Qty")
	ll_detailrows = this.id_detail.rowcount()
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	ll_itemsdetailrowcount = 0
	ls_errortext = "    Some database problem ocuurs         "
	ll_rowgroup = 0
	do while li_counter <= ll_detailrows and lb_commitflag
		ll_rowgroup = ll_rowgroup + 1
		ll_gcode = this.id_detail.object.gcode[li_counter]
		ls_customicode = this.id_detail.object.fullcode[li_counter]
		ls_itemname = this.id_detail.object.itemname[li_counter]
		ll_icode = this.id_detail.object.icode[li_counter]
		ld_salelooseqty = this.id_detail.object.looseqty[li_counter]
		ld_dueqty = this.id_detail.object.dueqty[li_counter]
		ll_packunits = this.id_detail.object.packunits[li_counter]
		ld_bonusqty = this.id_detail.object.bonusqty[li_counter]
		ldws_column = this.id_detail.getitemstatus(li_counter, "saleprice", primary!)
		ld_salelooseqty = ld_salelooseqty - ld_dueqty
		if ld_salelooseqty + ld_bonusqty > 0.0 and lb_commitflag and wf_approx_selectitembatches(ll_gcode, ll_icode, ld_salelooseqty, ld_bonusqty, id_batchallocation, ll_insertedrows, ls_errortext) = 0 then
			for li_innercounter = 1 to ll_insertedrows
				ll_row = ll_itemsdetailrowcount + li_innercounter
				id_batchallocation.setitem(ll_row, "rowgroup", ll_rowgroup)
				id_batchallocation.setitem(ll_row, "customicode", ls_customicode)
				id_batchallocation.setitem(ll_row, "itemname", ls_itemname)
			next
			ll_itemsdetailrowcount = ll_itemsdetailrowcount + ll_insertedrows
		end if
		if ld_dueqty > 0.0 and lb_commitflag then
			ll_itemsdetailrowcount = ll_itemsdetailrowcount + 1
			id_batchallocation.insertrow(0)
			id_batchallocation.setitem(ll_itemsdetailrowcount, "gcode", ll_gcode)
			id_batchallocation.setitem(ll_itemsdetailrowcount, "rowgroup", ll_rowgroup)
			id_batchallocation.setitem(ll_itemsdetailrowcount, "icode", ll_icode)
			id_batchallocation.setitem(ll_itemsdetailrowcount, "customicode", ls_customicode)
			id_batchallocation.setitem(ll_itemsdetailrowcount, "itemname", ls_itemname)
			id_batchallocation.setitem(ll_itemsdetailrowcount, "batch", "Due")
			id_batchallocation.setitem(ll_itemsdetailrowcount, "expiry", relativedate(today(), 365))
			id_batchallocation.setitem(ll_itemsdetailrowcount, "stock", ld_stock)
			id_batchallocation.setitem(ll_itemsdetailrowcount, "totalstock", 0)
			id_batchallocation.setitem(ll_itemsdetailrowcount, "looseqty", ld_dueqty)
			id_batchallocation.setitem(ll_itemsdetailrowcount, "due", "D")
		end if
		li_counter = li_counter + 1
	loop
	for li_counter = 1 to id_batchallocation.rowcount()
		ld_looseqty = round(id_batchallocation.object.looseqty[li_counter], li_round_qty)
		ld_bonusqty = round(id_batchallocation.object.bonusqty[li_counter], li_round_qty)
		ld_truncateqty = truncate(ld_looseqty + 0.0000001, li_round_qty)
		if ld_looseqty <> ld_truncateqty then
			ll_errorrow = li_counter
			ls_errortext = "Invalid Qty as per its column setting"
			messagebox("Qty Precision Error", ls_errortext)
			exit
		end if
		ld_truncateqty = truncate(ld_bonusqty + 0.0000001, li_round_qty)
		if ld_bonusqty <> ld_truncateqty then
			ll_errorrow = li_counter
			ls_errortext = "Invalid Bonus as per its column setting"
			messagebox("Bonus Precision Error", ls_errortext)
			exit
		end if
	next
	if id_batchallocation.rowcount() > 0 then
		lstr.s_module = "batch allocation"
		lstr.ds = id_batchallocation
		lstr.s_name1 = id_batchallocation.dataobject
		openwithparm(w_preview_invoices2, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
		end if
	end if
	return 0

// w_sale.wf_replace_postdate_with_date() returns long
	string ls_errtext = "                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ."
	s_arguements lstr_arg
	if f_rightexists(5163) then
		open(w_arg_sinvcode_linvcode)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = 1 then
			SQL update SaleLedger SET PostDate =Date WHERE SaleInvCode BETWEEN :lstr_arg.l_code1 AND :lstr_arg.l_code2 USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				SQL commit USING this.it_transobject;
			else
				ls_errtext = this.it_transobject.sqlerrtext
				SQL rollback USING this.it_transobject;
				messagebox("Sale Posting Date Updation Error", "Error in Updating Posting Date for Selected Sales.~r~nReasons are:-~r~n" + ls_errtext, stopsign!)
			end if
		end if
	end if
	return 0

// w_sale.wf_postsale_on_print() returns boolean
	boolean lb_trigger_saveandpost
	if this.tab_retrieve.selectedtab = 2 then
		return lb_trigger_saveandpost
	end if
	if this.ii_saletype = 3 then
		if f_rightexists(5165) then
			lb_trigger_saveandpost = true
		end if
	elseif f_rightexists(5166) then
		lb_trigger_saveandpost = true
	end if
	if lb_trigger_saveandpost then
		wf_saveandpost()
	end if
	return lb_trigger_saveandpost

// w_sale.wf_select_shiptocustomer() returns long
	s_arguements lstr_arg
	if wf_iseditable() = false then
		return 0
	end if
	open(w_arg_cust)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 and lstr_arg.l_code1 > 0 then
		this.id_master.object.shiptocustomer[1] = lstr_arg.l_code1
	end if
	return 0

// w_sale.wf_apply_batchwise_pricing(long al_icode, string as_batch, datetime adt_expiry, ref double ad_saleprice) returns long
	if f_stringpreferences("ApplyBatchWisePricing") = "N" then
		return 1
	end if
	SQL SELECT SalePrice INTO :ad_saleprice FROM ItemBatchPricing WHERE ICode =:al_icode AND Batch =:as_batch AND Expiry =:adt_expiry USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		return 0
	end if
	return -1

// w_sale.wf_email_invoice() returns string
	long ll_custcode
	long ll_invcode
	string ls_email
	string ls_pdfpath
	string ls_invoicesize
	string ls_custname
	ls_pdfpath = f_stringpreferences("saveaspdflocation")
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_custcode = this.id_master.object.custcode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_custcode = this.id_list.object.custcode[this.id_list.getrow()]
		ll_invcode = this.id_list.object.code[this.id_list.getrow()]
	end if
	if not isnull(ll_custcode) and ll_custcode <> 0 and ll_invcode > 0 then
		SQL SELECT Accounts.Name , Customer.Email , invoicesize =( SELECT invoicesize FROM saleledger WHERE SaleInvCode =:ll_invcode ) INTO :ls_custname, :ls_email, :ls_invoicesize FROM Customer , Accounts WHERE Customer.CustCode =:ll_custcode AND Accounts.AccCode =Customer.CustCode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if isnull(ls_email) or ls_email = "" then
				messagebox("Email Error1", "Customer Email Informatin Not Updated", stopsign!)
			elseif len(ls_email) = 0 then
				messagebox("Email Error2", "Customer Email Informatin Not Updated", stopsign!)
			else
				wf_selectprintreport(ls_invoicesize)
				this.id_print.modify("DataWindow.Print.Preview=yes")
				this.id_print.retrieve(ll_invcode)
				ls_pdfpath = trim(ls_pdfpath) + "SI" + trim(string(ll_invcode)) + ".pdf"
				if fileexists(ls_pdfpath) then
					filedelete(ls_pdfpath)
				end if
				if this.id_print.saveas(ls_pdfpath, pdf!, false) = 1 then
					wf_sendmail(ls_custname, ls_email, ls_pdfpath)
				else
					messagebox("Email Error3", "Problem Saving Invoice Into PDF Format", stopsign!)
				end if
			end if
		else
			messagebox("Email Error", "Customer Email Informatin Retrieval Error", stopsign!)
		end if
	end if
	return ls_pdfpath

// w_sale.wf_replaceall(string as_oldstring, string as_findstr, string as_replace) returns string
	string ls_newstring
	long ll_findstr
	long ll_replace
	long ll_pos
	ll_findstr = len(as_findstr)
	ll_replace = len(as_replace)
	ls_newstring = as_oldstring
	ll_pos = pos(ls_newstring, as_findstr)
	do while ll_pos > 0
		ls_newstring = replace(ls_newstring, ll_pos, ll_findstr, as_replace)
		ll_pos = pos(ls_newstring, as_findstr, ll_pos + ll_replace)
	loop
	return ls_newstring

// w_sale.wf_sendmail(string as_recipient_name, string as_recipient_email, string as_filename) returns long
	string ls_body
	string ls_server
	string ls_uid
	string ls_pwd
	string ls_from
	string ls_subject
	string ls_sendername
	string ls_port
	string ls_encrypt
	string ls_errormsg
	string ls_bodymsg
	integer li_idx
	integer li_max
	boolean lb_html
	boolean lb_return
	unsignedinteger lui_port
	setpointer(hourglass!)
	ls_server = f_stringpreferences("SMTPServer")
	if ls_server = "" then
		messagebox("Mail Error", "You must specify Server in Email Preferences first!", stopsign!)
		return 0
	end if
	ls_port = f_stringpreferences("SMTPPort")
	if ls_server = "" then
		messagebox("Mail Error", "You must specify Port in Email Preferences first!", stopsign!)
		return 0
	end if
	ls_sendername = f_stringpreferences("SMTPUserName")
	if isnull(ls_sendername) then
		ls_sendername = ""
	end if
	ls_from = f_stringpreferences("SMTPUserID")
	if ls_from = "" then
		messagebox("Mail Error", "From Email is a required field!", stopsign!)
		return 0
	end if
	if as_recipient_email = "" then
		messagebox("Mail Error", "Receipient Email is a required field!", stopsign!)
		return 0
	end if
	ls_subject = "Sale Invoice Initmation"
	if ls_subject = "" then
		messagebox("Edit Error", "Subject is a required field!", stopsign!)
		return 0
	end if
	ls_bodymsg = "Dear Sir,~r~nKindly Find the attached pdf view of sale invoice as an attachment to this message.~r~nRegards,~r~n" + ls_sendername
	if ls_bodymsg = "" then
		messagebox("Edit Error", "Body is a required field!", stopsign!)
		return 0
	end if
	if not gn_smtp.of_validemail(ls_from, ls_errormsg) then
		messagebox("Mail Error", ls_errormsg, stopsign!)
		return 0
	end if
	if not gn_smtp.of_validemail(as_recipient_email, ls_errormsg) then
		messagebox("Mail Error", ls_errormsg, stopsign!)
		return 0
	end if
	ls_body = "<html><body bgcolor='#FFFFFF' topmargin=8 leftmargin=8><h2>"
	ls_body = wf_replaceall(ls_bodymsg, "~r~n", "<br>") + "</h2>" + ls_body
	ls_body = "</body></html>" + ls_body
	lb_html = true
	lui_port = long(ls_port)
	gn_smtp.of_resetall()
	gn_smtp.of_setport(lui_port)
	gn_smtp.of_setserver(ls_server)
	gn_smtp.of_setlogfile(false, "smtp_logfile8.txt")
	gn_smtp.of_setdebugviewer(false)
	gn_smtp.of_setsubject(ls_subject)
	gn_smtp.of_setbody(ls_body, lb_html)
	gn_smtp.of_setfrom(ls_from, ls_sendername)
	gn_smtp.of_addaddress(as_recipient_email, as_recipient_name)
	ls_uid = f_stringpreferences("SMTPUserID")
	ls_pwd = f_stringpreferences("SMTPPassword")
	gn_smtp.of_setlogin(ls_uid, ls_pwd)
	gn_smtp.of_addattachment(as_filename)
	ls_encrypt = f_stringpreferences("SMTPEncryptionType")
	choose case ls_encrypt
	case "SSL"
		lb_return = gn_smtp.of_sendsslmail()
	case "TLS"
		lb_return = gn_smtp.of_sendtlsmail()
	case else
		lb_return = gn_smtp.of_sendmail()
	end choose
	if lb_return then
		messagebox("SendMail", "Mail successfully sent!")
	else
		messagebox("SendMail Error", gn_smtp.of_getlasterror())
	end if
	return 0

// w_sale.wf_setcustomerlatestsaleprice(long al_custcode, long al_icode, long al_row) returns long
	integer li_rowsaffected
	double ld_saleprice
	if f_stringpreferences("FetchCustomerLatestSalePrice") = "Y" and al_icode > 0 and al_custcode > 19 and al_row > 0 then
		li_rowsaffected = 0
		this.it_transobject.fetchcustomerlatestsaleprice(al_custcode, al_icode, ld_saleprice, li_rowsaffected)
		if this.it_transobject.sqlcode = 0 then
			if li_rowsaffected > 0 then
				this.id_detail.object.saleprice[al_row] = round(ld_saleprice, 2)
			end if
		else
			messagebox("Customer Latest Sale Price Error", "Unable to Fetch Customer Latest Sale Price due to some problem.~r~nDetails Are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
			return -1
		end if
		return 1
	end if
	return 0

// w_sale.wf_view_customercomments() returns long
	long ll_custcode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_custcode = this.id_master.object.custcode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_custcode = this.id_list.object.custcode[this.id_list.getrow()]
	end if
	if not isnull(ll_custcode) and ll_custcode <> 0 then
		openwithparm(w_customercomment_view, ll_custcode)
	end if
	return 0

