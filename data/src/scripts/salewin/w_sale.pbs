		lm_menu.m_file.m_fiscalizesaleinvoices.enabled = false
		lm_menu.m_file.m_fiscalizesaleinvoices.visible = false
	end if
	if not f_rightexists(5243) then
		lm_menu.m_file.m_attachdocuments.enabled = false
		lm_menu.m_file.m_attachdocuments.visible = false
	end if
	if not f_rightexists(5244) then
		lm_menu.m_file.m_showdocumentgallery.enabled = false
		lm_menu.m_file.m_showdocumentgallery.visible = false
	end if
	if not f_rightexists(5247) then
		lm_menu.m_file.m_applycustomizedgst%inunitstax.enabled = false
		lm_menu.m_file.m_applycustomizedgst%inunitstax.visible = false
	end if
	if not f_rightexists(5253) then
		lm_menu.m_file.m_showbranchwiseitemstockposition.enabled = false
		lm_menu.m_file.m_showbranchwiseitemstockposition.visible = false
	end if
	if not f_rightexists(5269) then
		lm_menu.m_file.m_pushsalestodropbox.enabled = false
		lm_menu.m_file.m_pushsalestodropbox.visible = false
		this.id_list.object.pushed.visible = false
		this.id_list.object.pushedon.visible = false
		this.id_list.object.pushedby.visible = false
		this.id_list.object.pushedfor.visible = false
	end if
	if not f_rightexists(5282) then
		lm_menu.m_file.m_showitempurchasehistory.enabled = false
		lm_menu.m_file.m_showitempurchasehistory.visible = false
	end if
	if f_rightexists(5288) then
		this.id_detail.settaborder("looseqty", 0)
		this.id_detail.object.looseqty.protect = "1"
		this.id_detail.object.looseqty.background.color = this.backcolor
	end if
	if gl_sitecode > 0 and gc_dropbox = "Y" then
		this.id_master.object.sitecode.initial = trim(string(gl_sitecode))
		this.id_master.object.targetsitecode.visible = true
		this.id_master.object.t_targetsitecode.visible = true
	else
		this.id_master.object.targetsitecode.visible = false
		this.id_master.object.t_targetsitecode.visible = false
	end if
	wf_apply_interfacesetting()
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5021", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_postareawise.visible = true
		lm_menu.m_file.m_postsaleheaderwise.enabled = false
	end if
	if f_islicenseexpire() = -2 then
		close(this)
	end if
	this.ic_autosearchonalternatealias = f_stringpreferences("AutoResponsiveSearchWithAlternateAliasName")

// w_sale.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_child = classname()
	return ::message.returnvalue

// w_sale.ue_deleteitem_row(long al_row) returns 0 [event]
	long ll_row
	long ll_footerrow
	super::ue_deleteitem_row(al_row)
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() > 0 then
		this.id_footer.setitem(ll_footerrow, "icode", this.id_detail.getitemnumber(ll_row, "icode"))
		this.id_footer.setitem(ll_footerrow, "stock", this.id_detail.getitemnumber(ll_row, "stock"))
		this.id_footer.setitem(ll_footerrow, "piecesinhand", this.id_detail.getitemnumber(ll_row, "piecesinhand"))
		return
	end if
	this.id_footer.setitem(ll_footerrow, "icode", 0)
	this.id_footer.setitem(ll_footerrow, "stock", 0)
	this.id_footer.setitem(ll_footerrow, "piecesinhand", 0)
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_save.enabled = false

// w_sale.ue_settitle() returns 0 [event]
	datawindowchild ldc_headerno
	long ll_counter
	long ll_retcode
	string ls_title
	call super::ue_settitle
	ll_retcode = this.id_master.getchild("headerno", ldc_headerno)
	if ll_retcode = 1 then
		for ll_counter = 1 to ldc_headerno.rowcount()
			if isnull(trim(ldc_headerno.getitemstring(ll_counter, "headeralias"))) then
				ls_title = ls_title + ""
			else
				ls_title = ls_title + "," + trim(ldc_headerno.getitemstring(ll_counter, "headeralias"))
			end if
		next
	else
		ls_title = ""
	end if
	this.title = this.title + "(" + ls_title + ")"

// w_sale.ue_callback_popupwindow(any ar_object) returns 0 [event]
	long ll_code
	long ll_row
	string as_errortext
	super::ue_callback_popupwindow(ar_object)
	ll_code = long(ar_object)
	ll_row = this.id_master.getrow()
	if ll_row > 0 and ll_code > 0 then
		this.id_master.object.srbufferinvcode[ll_row] = ll_code
		setredraw(true)
		wf_set_salereturn_amount()
		if f_stringpreferences("DisplayPool") = "Y" and upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
			pd_openusbpd()
			if pd_pdstate() = 0 then
				wf_pd_initialize()
			end if
		end if
	end if

// w_sale.closequery() returns long [event]
	integer li_yesno
	integer li_rtcode
	long ll_counter
	u_deleted_saleitemlog lu_deleted_saleitemlog
	if this.editflag = true then
		li_yesno = messagebox("Invoice", "Do You want to save changes", question!, yesnocancel!, 2)
		if li_yesno = 1 then
			if f_rightexists(551) then
				triggerevent("ue_save")
			else
				triggerevent("ue_print")
			end if
			if wf_commitform() = false then
				li_rtcode = 1
			end if
		elseif li_yesno = 3 then
			li_rtcode = 1
		elseif this.id_detail.rowcount() > 0 and f_stringpreferences("PreserveDeletedSaleItemsLog") = "Y" then
			for ll_counter = 1 to this.id_detail.rowcount()
				if this.id_detail.object.icode[ll_counter] > 0 then
					lu_deleted_saleitemlog.of_generatelog(this.id_detail, ll_counter, this.id_master.object.code[1], gl_usercode)
				end if
			next
		end if
	end if
	return li_rtcode

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	if newindex = 1 then
		parent.ii_focuscustomer = 1
	end if
	return ::message.returnvalue

// tab_retrieve.selectionchanging(integer oldindex, integer newindex) returns long [event]
	integer li_yesno
	integer li_rtcode
	long ll_counter
	u_deleted_saleitemlog lu_deleted_saleitemlog
	if parent.is_callermodule <> "" then
		return 1
	end if
	if parent.lb_refusedsale_in_buffer and parent.wf_iseditable() then
		li_yesno = messagebox("Confirm Changes", "Yes to save changes that you've typed in refused sale", question!, yesnocancel!, 2)
		if li_yesno = 1 then
			if parent.wf_save_refusedsale_only() <= 0 then
				li_rtcode = 1
			end if
		elseif li_yesno = 3 then
			li_rtcode = 1
		else
			parent.editflag = false
			parent.i_editmode = 2
		end if
	elseif oldindex = 1 and newindex = 2 and parent.editflag = true and parent.id_detail.rowcount() > 0 then
		li_yesno = messagebox("Confirm Changes", "Yes to save changes that you've typed", question!, yesnocancel!, 2)
		if li_yesno = 1 then
			if f_rightexists(551) then
				getparent().triggerevent("ue_save")
			else
				getparent().triggerevent("ue_print")
			end if
			if getparent().dynamic wf_commitform() = false then
				li_rtcode = 1
			end if
		elseif li_yesno = 3 then
			li_rtcode = 1
		else
			parent.editflag = false
			parent.i_editmode = 2
			if parent.id_detail.rowcount() > 0 and f_stringpreferences("PreserveDeletedSaleItemsLog") = "Y" then
				for ll_counter = 1 to parent.id_detail.rowcount()
					if parent.id_detail.object.icode[ll_counter] > 0 then
						lu_deleted_saleitemlog.of_generatelog(parent.id_detail, ll_counter, parent.id_master.object.code[1], gl_usercode)
					end if
				next
			end if
		end if
	end if
	return li_rtcode

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
	case "flatdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	end choose
	return 1

// dw_footer.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if (getcolumnname() = "misccharges" or getcolumnname() = "invdiscperc") and key = keyf5! then
		parent.parent.parent.wf_set_misccharges()
		rt_code = 1
	end if
	if (getcolumnname() = "misccharges" or getcolumnname() = "flatdisc" or getcolumnname() = "invdiscperc") and key = keyf7! then
		parent.parent.parent.wf_show_misccharges_breakup()
		rt_code = 1
	end if
	if getcolumnname() = "flatdisc" and key = keyf5! then
		parent.parent.parent.wf_set_flatdiscount()
		rt_code = 1
	end if
	if getcolumnname() = "flatdisc" and key = keyf6! then
		parent.parent.parent.wf_set_flatdiscount2()
		rt_code = 1
	end if
	return rt_code

// dw_footer.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	string ls_result
	string ls_null
	string ls_temp
	integer li_salepriceno
	integer li_itemdiscpercno
	integer rt_code
	integer li_smancode
	datetime ld_currdate
	date ld_datepart
	time lt_timepart
	long ll_code
	long ll_detailrows
	long ll_suppcode
	long ll_custcode
	long ll_counter
	long ll_customerbalance
	long ll_headerinvno
	long ll_motorvehiclecode
	long ll_found
	long ll_icode
	long li_packunits = 1
	long ll_patientcode
	long ll_allowed
	long ll_null
	long ll_res
	long ll_guestcode
	long ll_studentcode
	long ll_doctcode
	long ll_headerno
	double ld_avgprice
	double ld_gstperc1
	double ld_gstperc2
	double ld_custgst
	double ld_invdiscperc
	double ld_itemdiscperc
	double ld_itemdiscperc2
	double ld_itemdiscperc3
	double ld_itemdiscperc4
	double ld_rpp
	double ld_purprice
	double ld_saleprice4
	double ld_saleprice5
	double ld_salediscperc5
	double ld_saleprice1
	double ld_saleprice2
	double ld_saleprice3
	double ld_salediscperc
	double ld_salediscperc2
	double ld_salediscperc3
	double ld_salediscperc4
	integer li_custcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "sprice"
		parent.setredraw(false)
		if parent.parent.parent.id_detail.getrow() > 0 and isnull(parent.parent.parent.id_detail.getitemnumber(parent.parent.parent.id_detail.getrow(), "itemcode")) then
			parent.parent.parent.event ue_deleteitem()
		end if
		for ll_counter = 1 to parent.parent.parent.id_detail.rowcount()
			ll_icode = parent.parent.parent.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT item.saleprice , item.saleprice2 , item.saleprice3 , item.avgprice , item.packunits , item.purprice , item.recentpurprice , item.saleprice4 , item.saleprice5 INTO :ld_saleprice1, :ld_saleprice2, :ld_saleprice3, :ld_avgprice, :li_packunits, :ld_purprice, :ld_rpp, :ld_saleprice4, :ld_saleprice5 FROM item WHERE item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = -1 then
				parent.setredraw(true)
				messagebox("Database Error", "Item information can not be retrieved")
				return 1
			end if
			if not (parent.parent.parent.it_transobject.sqlcode = 100) then
				choose case long(data)
				case 1
					parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice1 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice1)
				case 2
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice2 / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice2 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice2)
				case 3
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice3 / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice3 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice3)
				case 7
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice4 / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice4 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice4)
				case 8
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice5 / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice5 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice5)
				case 4
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_purprice / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_purprice / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_purprice)
				case 5
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_rpp / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_rpp / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_rpp)
				case else
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_avgprice / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_avgprice)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_avgprice * li_packunits)
				end choose
			elseif not isnull(parent.parent.parent.id_detail.getitemstring(1, "itemname")) then
				parent.setredraw(true)
				messagebox("DataBase Error", "Rows not retrieve")
				return 0
			end if
			parent.parent.parent.id_detail.setitem(ll_counter, "discprice", parent.parent.parent.id_detail.getitemnumber(ll_counter, "saleprice") * (1.0 - parent.parent.parent.id_detail.getitemnumber(ll_counter, "discperc") * 0.01))
		next
		if parent.parent.parent.id_detail.rowcount() <= 0 then
			parent.parent.parent.event ue_newitem()
			parent.parent.parent.id_master.setfocus()
		end if
		parent.setredraw(true)
	case "dd_gstperc"
		parent.setredraw(false)
		if parent.parent.parent.id_detail.getrow() > 0 and isnull(parent.parent.parent.id_detail.getitemnumber(parent.parent.parent.id_detail.getrow(), "itemcode")) then
			parent.parent.parent.event ue_deleteitem()
		end if
		for ll_counter = 1 to parent.parent.parent.id_detail.rowcount()
			ll_icode = parent.parent.parent.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT item.gstperc1 , item.gstperc2 INTO :ld_gstperc1, :ld_gstperc2 FROM item WHERE item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = -1 then
				parent.setredraw(true)
				messagebox("Database Error", "Item information can not be retrieved")
				return 1
			end if
			if not (parent.parent.parent.it_transobject.sqlcode = 100) then
				if data = "2" then
					parent.parent.parent.id_detail.setitem(ll_counter, "gstperc", ld_gstperc2)
				else
					parent.parent.parent.id_detail.setitem(ll_counter, "gstperc", ld_gstperc1)
				end if
			end if
		next
		if parent.parent.parent.id_detail.rowcount() <= 0 then
			parent.parent.parent.event ue_newitem()
			parent.parent.parent.id_master.setfocus()
		end if
		parent.setredraw(true)
	case "itemdiscpercno"
		parent.setredraw(false)
		if parent.parent.parent.id_detail.getrow() > 0 and isnull(parent.parent.parent.id_detail.getitemnumber(parent.parent.parent.id_detail.getrow(), "itemcode")) then
			parent.parent.parent.event ue_deleteitem()
		end if
		for ll_counter = 1 to parent.parent.parent.id_detail.rowcount()
			ll_icode = parent.parent.parent.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT item.salediscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 INTO :ld_salediscperc, :ld_salediscperc2, :ld_salediscperc3, :ld_salediscperc4, :ld_salediscperc5 FROM item WHERE item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = -1 then
				parent.setredraw(true)
				messagebox("Database Error", "Item information can not be retrieved")
				return 1
			end if
			if not (parent.parent.parent.it_transobject.sqlcode = 100) then
				if long(parent.parent.parent.id_detail.object.discperc.visible) = 1 then
					choose case data
					case "1"
						parent.parent.parent.id_detail.setitem(ll_counter, "discperc", ld_salediscperc)
					case "2"
						parent.parent.parent.id_detail.setitem(ll_counter, "discperc", ld_salediscperc2)
					case "3"
						parent.parent.parent.id_detail.setitem(ll_counter, "discperc", ld_salediscperc3)
					case "4"
						parent.parent.parent.id_detail.setitem(ll_counter, "discperc", ld_salediscperc4)
					case "5"
						parent.parent.parent.id_detail.setitem(ll_counter, "discperc", ld_salediscperc5)
					end choose
				else
					parent.parent.parent.id_detail.setitem(ll_counter, "discperc", 0)
				end if
			end if
			parent.parent.parent.id_detail.setitem(ll_counter, "discprice", parent.parent.parent.id_detail.getitemnumber(ll_counter, "saleprice") * (1.0 - parent.parent.parent.id_detail.getitemnumber(ll_counter, "discperc") * 0.01))
		next
		if parent.parent.parent.id_detail.rowcount() <= 0 then
			parent.parent.parent.event ue_newitem()
			parent.parent.parent.id_master.setfocus()
		end if
		parent.setredraw(true)
	case "doctcode"
		return parent.parent.parent.wf_set_doctorinfo(long(data))
	case "headerno"
		setnull(ll_headerinvno)
		setitem(row, "headerinvno", ll_headerinvno)
	case "date"
	case "aliasname"
		if not isnull(data) and data <> "" then
			ll_res = parent.parent.parent.wf_findcustcode(data, li_custcode)
			if li_custcode = 19 and parent.parent.parent.ii_saletype <> 3 then
				messagebox("Customer Validation", "Cash Sale Walk-In Customer is not allowed in Credit Sale")
				return 1
			end if
			if ll_res > 0 and f_stringpreferences("GroupCustomerCategory") = "Y" then
				ll_allowed = 0
				parent.parent.parent.it_transobject.isallowedcustomergroupcategory(parent.parent.parent.il_groupcode, li_custcode, ll_allowed)
				if parent.parent.parent.it_transobject.sqlcode <> 0 then
					messagebox("Fetch Error", "Unable to fetch group customer category information.")
					return 1
				elseif ll_allowed < 1 then
					messagebox("Group Customer Category Validation", "Current group does not have enough permissions for sale ~r~n" + "against the customer whose alias name provided in alias name box.")
					return 1
				end if
				return
			end if
			if ll_res > 0 then
				setitem(row, "custcode", li_custcode)
				rt_code = parent.parent.parent.wf_setcustomerinfo(row, 1, string(li_custcode))
			else
				messagebox("Customer Validation", "Customer with  Alias Name  " + data + " does not exist")
				return 1
			end if
		else
			return 0
		end if
	case "patientregno"
		if not (isnull(data) or data = "") then
			parent.parent.parent.wf_validate_patient_from_outside(data)
			ll_res = parent.parent.parent.wf_findpatientcode(data, ll_patientcode)
			if ll_res >= 0 then
				if parent.parent.parent.ii_saletype = 3 then
					setitem(row, "patientcode", ll_patientcode)
				end if
				rt_code = 0
				if parent.parent.parent.ii_saletype = 2 then
					SQL SELECT custcode INTO :ll_custcode FROM patient WHERE patientcode =:ll_patientcode USING parent.parent.parent.it_transobject;
					if parent.parent.parent.it_transobject.sqlcode = 0 then
						ll_allowed = 0
						if f_stringpreferences("GroupCustomerCategory") = "Y" then
							parent.parent.parent.it_transobject.isallowedcustomergroupcategory(parent.parent.parent.il_groupcode, ll_custcode, ll_allowed)
							if parent.parent.parent.it_transobject.sqlcode <> 0 then
								messagebox("Fetch Error", "Unable to fetch group customer category information.")
								return 1
							elseif ll_allowed < 1 then
								messagebox("Group Customer Category Validation", "Current group does not have enough permissions for sale ~r~n" + "against the customer.")
								return 1
							end if
							return
						end if
						setitem(row, "patientcode", ll_patientcode)
						parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
						parent.parent.parent.id_master.object.custcode.protect = 1
						parent.parent.parent.id_master.object.aliasname.protect = 1
						rt_code = parent.parent.parent.wf_setcustomerinfo(row, 1, string(ll_custcode))
					else
						messagebox("Patient Information", "Problem in retrieving corresponding customer")
						rt_code = 1
					end if
				end if
				if parent.parent.parent.wf_checkpatientlicexpiry(ll_patientcode) = 2 then
					return 1
				end if
				parent.parent.parent.wf_setpatientinfo(ll_patientcode)
			else
				if ll_res = -2 then
					messagebox("Patient Validation", "Patient with  RegNo  " + data + " is Inactive")
				elseif ll_res = -1 then
					messagebox("Patient Validation", "Patient with  RegNo  " + data + " does not exist")
				end if
				rt_code = 1
			end if
			if f_numberpreferences("PatientRegFormatInSale") = 2 then
				parent.parent.parent.wf_setpatientinfo(ll_patientcode)
			else
				parent.parent.parent.wf_setpatientinfo(ll_patientcode)
			end if
		end if
	case "custcode"
