// w_sale.wf_customerinfo(long al_custcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	string ls_aliasname
	string ls_refno
	string ls_considerinpo
	string ls_custlicno
	integer li_messagecode
	integer li_gccode
	long ll_currow
	long ll_dayslimit
	long ll_alertcode
	long ll_pointsbalance
	long ll_sitecode
	double ld_currbalance
	datetime ldt_custlicexpiry
	SQL SELECT customer.address1 , customer.city , customer.phone , customer.messagecode , accounts.aliasname , customer.refno , customer.considerinpo , customer.dayslimit , customer.licenceno , customer.licenceexpiry , customer.gccode , accounts.alertcode , pointsbalance =ISNULL ( ( SELECT SUM ( lcl.pointsdebit - lcl.pointscredit ) FROM LoyaltyCardLedger LCL WHERE LCL.AccCode =:al_custcode ) , 0 ) , customer.sitecode INTO :ls_address, :ls_city, :ls_phone, :li_messagecode, :ls_aliasname, :ls_refno, :ls_considerinpo, :ll_dayslimit, :ls_custlicno, :ldt_custlicexpiry, :li_gccode, :ll_alertcode, :ll_pointsbalance, :ll_sitecode FROM customer , accounts WHERE customer.custcode =:al_custcode and customer.custcode =accounts.acccode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
		this.id_master.object.address[ll_currow] = ls_address
		this.id_master.object.aliasname[ll_currow] = ls_aliasname
		this.id_master.object.city[ll_currow] = ls_city
		this.id_master.object.phone[ll_currow] = ls_phone
		this.id_master.object.considerinpo[ll_currow] = ls_considerinpo
		this.id_master.object.duedate[ll_currow] = relativedate(today(), ll_dayslimit)
		this.id_master.object.custlicno[ll_currow] = ls_custlicno
		this.id_master.object.custlicexpiry[ll_currow] = ldt_custlicexpiry
		this.id_master.object.gccode[ll_currow] = li_gccode
		this.id_master.object.pointsbalance[ll_currow] = ll_pointsbalance
		this.id_master.object.targetsitecode[ll_currow] = ll_sitecode
		if f_stringpreferences("FetchRefNoFromCustomer") = "Y" then
			this.id_master.object.custrefno[ll_currow] = ls_refno
		end if
		if isnull(li_messagecode) then
			this.id_master.object.messagecode[ll_currow] = 1
		else
			this.id_master.object.messagecode[ll_currow] = li_messagecode
		end if
	end if
	return this.it_transobject.sqlcode

// w_sale.wf_deleteallemptydetailrows() returns integer
	long ll_count
	long ll_deletecount
	ll_deletecount = 0
	for ll_count = 1 to this.id_detail.rowcount()
		if isnull(this.id_detail.getitemnumber(ll_count, "icode")) then
			ll_deletecount = ll_deletecount + 1
			this.id_detail.deleterow(ll_count)
		end if
	next
	return ll_deletecount

// w_sale.wf_setgodownoption() returns 0
	if this.idc_godown.rowcount() > 0 then
		this.ii_salegodown = this.idc_godown.getitemnumber(1, "gcode")
	end if
	if this.il_strategy = 2 or this.il_strategy = 1 and this.il_godowncount = 1 then
		this.id_detail.modify("gcode" + ".Protect=1")
		this.id_detail.object.gcode.background.color = this.backcolor
	end if

// w_sale.wf_setfocuswithscroll(string as_colname, long al_row) returns integer
	this.id_detail.scrolltorow(al_row)
	this.id_detail.setcolumn(as_colname)
	this.id_detail.setfocus()
	this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	return 1

// w_sale.wf_setitemdataoncustlatestsale() returns integer
	integer li_rowsaffected
	long ll_counter
	long ll_custcode
	long ll_icode
	double ld_looseqty
	double ld_prevbonusqty
	double ld_desiredbonus
	double ld_prevsaleqty
	double ld_saleprice
	double ld_discperc
	double ld_itemflatdisc
	string ls_bonusqty
	string ls_discperc
	string ls_itemflatdisc
	ls_bonusqty = this.id_detail.object.bonusqty.visible
	ls_discperc = this.id_detail.object.discperc.visible
	ls_itemflatdisc = this.id_detail.object.itemflatdisc.visible
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	for ll_counter = 1 to this.id_detail.rowcount()
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		ld_looseqty = this.id_detail.getitemnumber(ll_counter, "looseqty")
		li_rowsaffected = 0
		this.it_transobject.getcustwiselatestitemsale(ll_custcode, ll_icode, ld_saleprice, ld_prevsaleqty, ld_prevbonusqty, ld_discperc, ld_itemflatdisc, li_rowsaffected)
		if this.it_transobject.sqlcode = 0 then
			if li_rowsaffected > 0 then
				if f_stringpreferences("UpdSPriceUsingCustLatestSale") = "Y" then
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice)
				end if
				if ls_bonusqty = "1" and f_stringpreferences("UpdBonusQtyUsingCustLatestSale") = "Y" then
					if ld_prevsaleqty <> 0.0 then
						ld_desiredbonus = round(ld_looseqty / ld_prevsaleqty * ld_prevbonusqty, 0)
						this.id_detail.setitem(ll_counter, "bonusqty", ld_desiredbonus)
					end if
				end if
				if ls_discperc = "1" and f_stringpreferences("UpdDiscPercUsingCustLatestSale") = "Y" then
					this.id_detail.setitem(ll_counter, "discperc", ld_discperc)
				end if
				if ls_itemflatdisc = "1" and f_stringpreferences("UpdFlatDiscUsingCustLatestSale") = "Y" then
					this.id_detail.setitem(ll_counter, "itemflatdisc", ld_itemflatdisc)
				end if
			end if
		else
			return -1
		end if
	next
	return 1

// w_sale.wf_setcustomer() returns integer
	if f_validatedw(this.id_master) < 0 then
		return -1
	end if

// w_sale.wf_setcustomername(string as_data) returns 0
	long ll_rowno
	ll_rowno = this.idc_customers.find("customer_name >='" + as_data + "'", 1, this.idc_customers.rowcount())
	if ll_rowno > 0 then
		this.idc_customers.selectrow(0, false)
		this.idc_customers.setrow(ll_rowno)
		this.idc_customers.scrolltorow(ll_rowno)
		this.idc_customers.selectrow(ll_rowno, true)
	end if

// w_sale.wf_selectcustomerareawise() returns integer
	s_popup_selection ls_popup_selection
	if this.editflag = true and f_stringpreferences("patientOnCreditSale") <> "H" then
		open(w_popup_areaselection)
		ls_popup_selection = message.powerobjectparm
		if ls_popup_selection.l_code > 0 then
			openwithparm(w_popup_customerselectionareawise_forsal, ls_popup_selection)
			ls_popup_selection = message.powerobjectparm
			if ls_popup_selection.l_code > 0 then
				this.id_master.setitem(this.id_master.getrow(), "custcode", ls_popup_selection.l_code)
				wf_setcustomername(ls_popup_selection.s_name)
				wf_setcustomerinfo(this.id_master.getrow(), 1, string(ls_popup_selection.l_code))
			end if
		end if
	end if
	return 1

// w_sale.wf_retrievelistall() returns long
	string[] ls_posted
	string ls_showrows = "N"
	integer[] li_salecategory
	long ll_counter
	datetime ld_invdate
	ld_invdate = datetime(date("00/00/00"), time("00:00:00"))
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 538 then
			ls_showrows = "Y"
		end if
	next
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		if f_stringpreferences("ShowAllInvInCreditSaleList") = "Y" then
			li_salecategory[1] = 1
			li_salecategory[2] = 2
			li_salecategory[3] = 3
		else
			li_salecategory[1] = 1
			li_salecategory[2] = 2
		end if
	else
		li_salecategory[1] = this.ii_saletype
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, ls_showrows, this.il_groupcode, this.ii_module)

// w_sale.wf_locksaleinvoices(long al_sinvcode, long al_linvcode, ref long al_totalinvoice) returns integer
	integer li_count
	long ll_loopcount
	char lc_isopen = "N"
	for ll_loopcount = al_sinvcode to al_linvcode
		if wf_isinvoiceinuse(ll_loopcount) then
			lc_isopen = "Y"
			exit
		end if
	next
	if lc_isopen = "Y" then
		messagebox("Invoice Validation", "Sale Invoice ( " + string(ll_loopcount) + " )already in use by some other user.~r~nKindly try again after sometime or post some other invoice.")
		return -1
	end if
	SQL Select count ( *) INTO :al_totalinvoice From saleledger WITH ( UPDLOCK ) Where saleledger.saleinvcode Between :al_sinvcode AND :al_linvcode AND saleledger.Posted ='N' USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_sale.wf_validategodown() returns integer
	long ll_icode
	long ll_gcode
	long ll_counter
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	string ls_null
	integer li_errcode = 1
	integer li_null
	integer li_option
	integer li_duperr
	boolean ib_due
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	this.ii_defaultgcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	if wf_checkgodownstock(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			if isnull(this.id_detail.getitemstring(this.il_currrow, "due")) then
				li_errcode = -1
			end if
		elseif f_stringpreferences("AllowDupItemsInSale") = "N" then
			for ll_counter = 1 to this.id_detail.rowcount()
				if this.il_currrow <> ll_counter and (ll_icode = this.id_detail.getitemnumber(ll_counter, "icode") and this.ii_defaultgcode = this.id_detail.getitemnumber(ll_counter, "gcode")) then
					li_duperr = -2
				end if
			next
		end if
	end if
	this.ib_godownvalidated = true
	if li_errcode = -1 and not ib_due then
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		this.id_detail.setfocus()
		this.id_detail.setcolumn("gcode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
	end if
	if li_duperr = -2 and not ib_due then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate Item, please select some other item"
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
		if this.ic_autosearchonalternatealias = "Y" then
			wf_responsivesearch_withalternatealias()
		else
			this.ib_itemslistopen = true
			this.id_itemslist.show()
		end if
		li_errcode = -1
	end if
	return li_errcode

// w_sale.wf_searchgodown() returns long
	s_popup_selection lstr_selection
	long ll_icode
	ll_icode = this.id_detail.object.icode[this.id_detail.getrow()]
	lstr_selection.l_longarray[1] = ll_icode
	lstr_selection.l_longarray[2] = this.il_strategy
	lstr_selection.l_longarray[3] = this.il_groupcode
	lstr_selection.l_longarray[4] = this.ii_module
	openwithparm(w_popup_godownselection, lstr_selection)
	lstr_selection = message.powerobjectparm
	if lstr_selection.l_code > 0 then
		this.id_detail.setitem(this.id_detail.getrow(), "gcode", lstr_selection.l_code)
	end if
	return 0

// w_sale.wf_validateitem(boolean ab_flag) returns integer
	long ll_icode
	long ll_count
	long ll_duprow
	long ll_found
	double ld_stock
	double ld_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	integer li_option
	integer n
	boolean ib_due
	boolean lb_dupitem
	boolean lb_zerostock
	boolean lb_invalidrow
	integer li_null
	string ls_null
	if isnull(this.il_currrow) or this.il_currrow <= 0 then
		lb_invalidrow = true
		setnull(ll_icode)
	else
		ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	end if
	if not isnull(ll_icode) then
		if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true and f_stringpreferences("AllowDupItemsInSale") = "N" then
			ls_titleerrtext = "Item Validation"
			ls_errtext = "Duplicate item, please select some other item"
			lb_dupitem = true
			li_errcode = -1
		elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
			if li_errcode = -2 then
				lb_zerostock = true
				if ab_flag and isnull(this.id_detail.getitemstring(this.il_currrow, "due")) then
					li_errcode = -1
				end if
			end if
		else
			ls_titleerrtext = "Item Validation"
		end if
	end if
	if ab_flag then
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		if this.il_strategy = 1 and this.il_godowncount > 1 and lb_zerostock then
			messagebox(ls_titleerrtext, "Stock is zero, please select some other godown")
			this.ib_itemslistopen = false
			this.id_itemslist.hide()
			this.id_detail.setcolumn("gcode")
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.gcode[this.il_currrow] = li_null
		elseif lb_dupitem = true then
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.icode[this.il_currrow] = li_null
			this.id_detail.object.fullcode[this.il_currrow] = ls_null
			this.id_detail.object.alternatecustomicode[this.il_currrow] = ls_null
			this.id_detail.object.itemname[this.il_currrow] = ls_null
			post event ue_deleteitem_row(this.il_currrow)
			for ll_count = 1 to this.id_detail.rowcount()
				if this.id_detail.getitemnumber(ll_count, "icode") = ll_icode then
					post event ue_scrolltorow(ll_count, "looseqty")
					exit
				end if
			next
			messagebox("Item", "Duplicate Item, please select some other item")
		elseif lb_invalidrow = true then
			li_errcode = -1
		else
			ls_titleerrtext = "Item Validation"
			messagebox(ls_titleerrtext, ls_errtext)
			if f_stringpreferences("itemcode") = "N" then
				this.id_detail.setcolumn(this.is_columnitemname)
				if this.ic_autosearchonalternatealias = "Y" then
					wf_responsivesearch_withalternatealias()
				else
					this.ib_itemslistopen = true
					this.id_itemslist.show()
				end if
			else
				this.id_detail.setcolumn("fullcode")
				this.id_detail.object.fullcode[this.il_currrow] = ls_null
			end if
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.icode[this.il_currrow] = li_null
			this.id_detail.object.itemname[this.il_currrow] = ls_null
			this.id_detail.object.alternatecustomicode[this.il_currrow] = ls_null
			this.id_detail.object.looseqty[this.il_currrow] = 1
			this.id_detail.object.bonusqty[this.il_currrow] = 0
			this.id_detail.object.saleprice[this.il_currrow] = li_null
			if long(this.id_detail.object.discperc.visible) = 1 then
				this.id_detail.object.discperc[this.il_currrow] = li_null
			else
				this.id_detail.object.discperc[this.il_currrow] = 0
			end if
			if long(this.id_detail.object.itemflatdisc.visible) = 1 then
				this.id_detail.object.itemflatdisc[this.il_currrow] = li_null
			else
				this.id_detail.object.itemflatdisc[this.il_currrow] = 0
			end if
			this.id_detail.object.unitsalestax[this.il_currrow] = li_null
			this.id_detail.object.gstperc[this.il_currrow] = li_null
		end if
	end if
	return li_errcode

// w_sale.wf_returnsaleinvoice(long al_invid, ref string as_errortext) returns boolean
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_counter = 1
	long ll_detailrows
	long ll_totalpieces
	long ll_piecesinhand
	string ls_batch
	string ls_due
	datetime ld_expiry
	datetime ldt_manfdate
	boolean lb_commitflag = true
	double ld_avgprice
	double ld_looseqty
	double ld_bonusqty
	double ld_stock
	double ld_newstock
	this.ids_saledetail_deleted.retrieve(al_invid)
	this.id_saleinvdetail.retrieve(al_invid)
	as_errortext = "Some database problem occur"
	ll_detailrows = this.id_saleinvdetail.rowcount()
	ll_counter = 1
	do while ll_counter <= ll_detailrows and lb_commitflag
		ll_gcode = this.id_saleinvdetail.getitemnumber(ll_counter, "gcode")
		ll_icode = this.id_saleinvdetail.getitemnumber(ll_counter, "icode")
		ls_batch = this.id_saleinvdetail.getitemstring(ll_counter, "batch")
		ld_expiry = this.id_saleinvdetail.getitemdatetime(ll_counter, "expiry")
		ldt_manfdate = this.id_saleinvdetail.getitemdatetime(ll_counter, "manfdate")
		ld_looseqty = this.id_saleinvdetail.getitemnumber(ll_counter, "looseqty")
		ld_bonusqty = this.id_saleinvdetail.getitemnumber(ll_counter, "bonusqty")
		ls_due = this.id_saleinvdetail.getitemstring(ll_counter, "Due")
		ll_totalpieces = this.id_saleinvdetail.getitemnumber(ll_counter, "totalpieces")
		this.it_transobject.updateitemtotalpiecesinhand(ll_icode, 1, ll_totalpieces)
		if this.it_transobject.sqlcode <> 0 then
			lb_commitflag = false
		end if
		if lb_commitflag and (ls_due <> "D" and ls_due <> "S" or isnull(ls_due)) then
			this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
			if this.it_transobject.sqlcode = 0 then
				this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					ld_newstock = ld_stock + ld_looseqty + ld_bonusqty
					this.it_transobject.updateitemstockbatchforsaleinvmodification(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock, ldt_manfdate)
					if this.it_transobject.sqlcode <> 0 then
						lb_commitflag = false
						as_errortext = "Stock Updation Error In SaleInvoice Modification:~r~n" + this.it_transobject.sqlerrtext
					end if
					if ld_stock = 0.0 then
						SQL update GodownDetail Set Priority =1 Where GodownDetail.GCode =:ll_gcode and GodownDetail.ICode =:ll_icode and GodownDetail.Batch =:ls_batch and GodownDetail.Expiry =:ld_expiry USING this.it_transobject;
					end if
				else
					lb_commitflag = false
					as_errortext = "Unable to fetch batch wise stock for sale modification.~r~n" + this.it_transobject.sqlerrtext
				end if
			else
				lb_commitflag = false
				as_errortext = "Unable to lock item for sale modification.~r~n" + this.it_transobject.sqlerrtext
			end if
		end if
		ll_counter = ll_counter + 1
	loop
	if lb_commitflag and wf_deletesaleinvoice(al_invid) <> 0 then
		lb_commitflag = false
		as_errortext = "Some database problem occur during modification of this sale invoice"
	end if
	return lb_commitflag

// w_sale.wf_retrievelist() returns long
	string[] ls_posted
	string ls_showrows = "N"
	integer[] li_salecategory
	integer li_invforlastdays = -3
	integer li_listrows
	datetime ld_invdate
	long ll_counter
	long ll_retcode
	boolean lb_netamount
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		li_invforlastdays = f_numberpreferences("crsalelistviewretrievaldays") * -1
		if f_stringpreferences("ShowAllInvInCreditSaleList") = "Y" then
			li_salecategory[1] = 1
			li_salecategory[2] = 2
			li_salecategory[3] = 3
		else
			li_salecategory[1] = 1
			li_salecategory[2] = 2
		end if
	else
		li_invforlastdays = f_numberpreferences("cashsalelistviewretrievaldays") * -1
		li_salecategory[1] = this.ii_saletype
	end if
	ld_invdate = datetime(relativedate(today(), li_invforlastdays))
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 538 then
			ls_showrows = "Y"
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 539 then
			lb_netamount = true
			if integer(this.id_list.object.netamount.visible) = 0 then
				this.id_list.object.netamount.visible = true
				this.id_list.object.netamount_t.visible = true
			end if
		end if
	next
	if lb_netamount = false then
		this.id_list.object.netamount.visible = false
		this.id_list.object.netamount_t.visible = false
	end if
	if ls_showrows = "N" then
		this.tab_retrieve.tabpage_list.cb_retrieve.enabled = false
		this.tab_retrieve.tabpage_list.em_invno.enabled = false
	end if
	ll_retcode = this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, ls_showrows, this.il_groupcode, this.ii_module)
	if ll_retcode = 0 then
		ld_invdate = datetime(relativedate(today(), li_invforlastdays - 30))
		ll_retcode = this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, ls_showrows, this.il_groupcode, this.ii_module)
	end if
	return ll_retcode

// w_sale.wf_fetchserverdate(boolean ab_checked) returns long
	if ab_checked then
		this.ib_fetchserverdate = true
	else
		this.ib_fetchserverdate = false
	end if
	return 0

// w_sale.wf_findcustcode(string as_aliasname, ref integer ai_custcode) returns integer
	integer li_custcode
	integer ll_retflag
	long ll_rowno
	string ls_itemname
	datawindowchild ldc_customer
	if this.id_master.getchild("custCode", ldc_customer) <> 1 then
		messagebox("DataWindo Error", "Unable to get child window from customer")
		return 0
	end if
	ll_rowno = ldc_customer.find("lower(accounts_aliasname)='" + lower(as_aliasname) + "'", 1, ldc_customer.rowcount())
	if isnull(ll_rowno) or ll_rowno <= 0 then
		ll_retflag = 0
	else
		ai_custcode = ldc_customer.getitemnumber(ll_rowno, "accounts_acccode")
		ll_retflag = 1
	end if
	return ll_retflag

// w_sale.wf_setsaleitemdesc() returns long
	long ll_row
	long ll_icode
	long ll_packunits
	long ll_custcode
	long ll_rtcode
	long li_discstatus
	long li_prediscstatus
	long li_itemdesc_status
	long li_flatdiscstatus
	double ld_saleprice
	double ld_flatdisc
	double ld_saleprice2
	double ld_saleprice3
	double ld_saleprice4
	double ld_saleprice5
	double ld_packsalestax
	double ld_unitsalestax
	double ld_gstperc1
	double ld_gstperc2
	double ld_discperc
	double ld_discperc2
	double ld_discperc3
	double ld_discperc4
	double ld_discperc5
	double ld_purprice
	double ld_rpp
	double ld_avgprice
	double ld_retailprice
	double ld_custitemcatdiscperc
	double ld_itemflatdisc
	double ld_prediscperc
	integer li_discpercno
	integer li_itemdiscpercno
	integer li_defaultgst
	string ls_itemname
	s_arguements lstr_arg
	ll_row = this.id_detail.getrow()
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	li_defaultgst = this.id_master.getitemnumber(1, "dd_gstperc")
	open(w_arg_item)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		ll_icode = lstr_arg.l_code1
		SQL Select name , packunits , avgprice , purprice , recentpurprice , retailprice , saleprice , saleprice2 , saleprice3 , saleprice4 , saleprice5 , flatdisc , salediscperc , salediscperc2 , salediscperc3 , salediscperc4 , salediscperc5 , packsalestax , gstperc1 , gstperc2 INTO :ls_itemname, :ll_packunits, :ld_avgprice, :ld_purprice, :ld_rpp, :ld_retailprice, :ld_saleprice, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :ld_flatdisc, :ld_discperc, :ld_discperc2, :ld_discperc3, :ld_discperc4, :ld_discperc5, :ld_packsalestax, :ld_gstperc1, :ld_gstperc2 From Item Where icode =:ll_icode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if f_stringpreferences("ChangeSPForItemDescInSale") = "Y" then
				if isnull(ll_packunits) or ll_packunits = 0 then
					ll_packunits = 1
				end if
				ld_unitsalestax = round(ld_packsalestax / ll_packunits, 2)
				li_discstatus = long(this.id_detail.object.discperc.visible)
				li_prediscstatus = long(this.id_detail.object.prediscperc.visible)
				li_flatdiscstatus = long(this.id_detail.object.itemflatdisc.visible)
				if li_discstatus = 1 then
					li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
					if wf_getcustitemcatwisesalesdiscount(ll_icode, ll_custcode, ld_custitemcatdiscperc, ld_prediscperc, ld_itemflatdisc) = true then
						this.id_detail.setitem(ll_row, "discperc", ld_custitemcatdiscperc)
						this.id_detail.setitem(ll_row, "itemflatdisc", ld_itemflatdisc)
						if li_prediscstatus = 1 then
							this.id_detail.setitem(ll_row, "prediscperc", ld_prediscperc)
							this.id_detail.setitem(ll_row, "itemflatdisc", round(this.id_detail.object.saleprice[ll_row] * ld_prediscperc * 0.01, 2))
						else
							this.id_detail.setitem(ll_row, "prediscperc", 0)
						end if
					else
						choose case li_itemdiscpercno
						case 1
							this.id_detail.setitem(ll_row, "discperc", ld_discperc)
						case 2
							this.id_detail.setitem(ll_row, "discperc", ld_discperc2)
						case 3
							this.id_detail.setitem(ll_row, "discperc", ld_discperc3)
						case 4
							this.id_detail.setitem(ll_row, "discperc", ld_discperc4)
						case 5
							this.id_detail.setitem(ll_row, "discperc", ld_discperc5)
						end choose
					end if
				else
					this.id_detail.setitem(ll_row, "discperc", 0)
				end if
				choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
				case 1.0
					this.id_detail.setitem(ll_row, "packprice", ld_saleprice)
					this.id_detail.setitem(ll_row, "saleprice", ld_saleprice / ll_packunits)
				case 2.0
					this.id_detail.setitem(ll_row, "packprice", ld_saleprice2)
					this.id_detail.setitem(ll_row, "saleprice", ld_saleprice2 / ll_packunits)
				case 3.0
					this.id_detail.setitem(ll_row, "packprice", ld_saleprice3)
					this.id_detail.setitem(ll_row, "saleprice", ld_saleprice3 / ll_packunits)
				case 7.0
					this.id_detail.setitem(ll_row, "packprice", ld_saleprice4)
					this.id_detail.setitem(ll_row, "saleprice", ld_saleprice4 / ll_packunits)
				case 8.0
					this.id_detail.setitem(ll_row, "packprice", ld_saleprice5)
					this.id_detail.setitem(ll_row, "saleprice", ld_saleprice5 / ll_packunits)
				case 4.0
					this.id_detail.setitem(ll_row, "packprice", ld_purprice)
					this.id_detail.setitem(ll_row, "saleprice", ld_purprice / ll_packunits)
				case 5.0
					this.id_detail.setitem(ll_row, "packprice", ld_rpp)
					this.id_detail.setitem(ll_row, "saleprice", ld_rpp / ll_packunits)
				case else
					this.id_detail.setitem(ll_row, "packprice", ld_avgprice * ll_packunits)
					this.id_detail.setitem(ll_row, "saleprice", ld_avgprice)
				end choose
				this.id_detail.setitem(ll_row, "rate", ld_saleprice / ll_packunits)
				this.id_detail.setitem(ll_row, "retailprice", ld_retailprice / ll_packunits)
				if li_flatdiscstatus = 1 then
					this.id_detail.setitem(ll_row, "itemflatdisc", ld_flatdisc)
				else
					this.id_detail.setitem(ll_row, "itemflatdisc", 0)
				end if
				this.id_detail.setitem(ll_row, "unitsalestax", ld_unitsalestax)
				if li_defaultgst = 2 then
					this.id_detail.setitem(ll_row, "gstperc", ld_gstperc2)
				else
					this.id_detail.setitem(ll_row, "gstperc", ld_gstperc1)
				end if
			end if
			this.id_detail.setitem(ll_row, "saleitemdescription", ls_itemname)
			this.id_detail.setitem(ll_row, "DescICode", ll_icode)
		else
			messagebox("Item Validation", "Unable to get item information.")
		end if
	end if
	return 0

// w_sale.wf_viewheader() returns integer
	s_dw_header ls_dw_header
	string[] ls_values
	string ls_posted
	long ll_row
	long ll_currrow
	integer li_protectdw
	datetime ldt_datetime
	if this.tab_retrieve.selectedtab <> 1 then
		return -1
	end if
	ls_posted = this.id_master.getitemstring(this.id_master.getrow(), "Posted")
	ls_dw_header.dw_header = this.id_master
	if this.ii_saletype = 2 then
		ls_dw_header.s_saletype = "Credit"
	else
		ls_dw_header.s_saletype = "Cash"
	end if
	ls_dw_header.l_code2 = this.ii_salemodule
	if this.editflag = false and ls_posted = "Y" then
		ls_dw_header.i_protectdw = 1
	else
		ls_dw_header.i_protectdw = 0
	end if
	openwithparm(w_view_saleheader, ls_dw_header)
	ls_dw_header = message.powerobjectparm
	if ls_dw_header.i_closemode = -1 then
		return -1
	end if
	ll_row = this.id_master.getrow()
	ls_values = ls_dw_header.values
	if this.editflag = true then
		this.id_master.setitem(ll_row, "patientregno", ls_values[1])
		this.id_master.setitem(ll_row, "patientcode", long(ls_values[2]))
		this.id_master.setitem(ll_row, "doctcode", long(ls_values[3]))
		this.id_master.setitem(ll_row, "relationcode", long(ls_values[4]))
		this.id_master.setitem(ll_row, "wardcode", long(ls_values[5]))
		this.id_master.setitem(ll_row, "diseasecode", long(ls_values[6]))
		this.id_master.setitem(ll_row, "printwaranty", ls_values[7])
		this.id_master.setitem(ll_row, "printbatch", ls_values[8])
		this.id_master.setitem(ll_row, "invoicesize", ls_values[9])
		this.id_master.setitem(ll_row, "smancode", long(ls_values[10]))
		this.id_master.setitem(ll_row, "custrefno2", ls_values[11])
		this.id_master.setitem(ll_row, "custrefno3", ls_values[12])
		this.id_master.setitem(ll_row, "custrefno4", ls_values[13])
		this.id_master.setitem(ll_row, "custrefno5", ls_values[23])
		this.id_master.setitem(ll_row, "printbalance", ls_values[14])
		this.id_master.setitem(ll_row, "deliveredby", long(ls_values[15]))
		this.id_master.setitem(ll_row, "billingdate", datetime(date(ls_values[16]), time(ls_values[17])))
		this.id_master.setitem(ll_row, "pptcustcode", long(ls_values[18]))
		this.id_master.setitem(ll_row, "saletypecode", long(ls_values[19]))
		this.id_master.setitem(ll_row, "recurringinvoice", ls_values[20])
		this.id_master.setitem(ll_row, "recurringperiod", long(ls_values[21]))
		if this.ii_saletype = 2 then
			this.id_master.setitem(ll_row, "duedate", date(ls_values[22]))
		end if
		this.id_master.setitem(ll_row, "custsitecode", long(ls_values[24]))
		this.id_master.setitem(ll_row, "PreviousReading", long(ls_values[25]))
		this.id_master.setitem(ll_row, "CurrentReading", long(ls_values[26]))
		this.id_master.setitem(ll_row, "NextChange", long(ls_values[27]))
	end if
	return 1

// w_sale.wf_print() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_count
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			for ll_count = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
				this.id_print.retrieve(ll_count)
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			next
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	return li_errcode

// w_sale.wf_get_patient(long al_prescode) returns long
	long ll_patientcode
	SQL Select patientcode INTO :ll_patientcode From PrescriptionHeader Where PresCode =:al_prescode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		return ll_patientcode
	end if
	return -1

// w_sale.wf_allowsalemodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM SaleDetail WHERE SaleInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING this.it_transobject;
	return ll_disallowedcount

// w_sale.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_sale.wf_checkgodownstock(long al_icode, long al_row, ref integer ai_rtcode, ref string as_errortext) returns boolean
	boolean retflag = true
	long ll_custcode
	long ll_packunits
	long ll_saleinvcode
	long ll_totalpieces
	long ll_piecesinhand
	double ld_totalstock
	double ld_godownstock
	double ld_saleqty
	double ld_holdlooseqty
	double ld_desiredbonus
	integer li_gcode
	long ll_reorderqty
	long ll_qtysale
	long ll_bonus
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	if isnull(ll_custcode) then
		retflag = false
		as_errortext = "Validation Error: Select Customer "
	end if
	SQL Select packunits , totalpieces INTO :ll_packunits, :ll_piecesinhand From item Where icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
	else
		if this.il_strategy = 2 then
			li_gcode = wf_getitemassociategcode(al_icode)
		end if
		if this.il_strategy = 1 then
			li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
		end if
	end if
	this.it_transobject.getitemstockall(al_icode, ld_totalstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item stock information can not be retrieved"
	end if
	this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.it_transobject.getitemtotalpiecesinhand(al_icode, ll_piecesinhand)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
	end if
	if this.ib_modify and retflag then
		ll_saleinvcode = this.id_master.getitemnumber(1, "code")
		if wf_getsalesstockinfo(ll_saleinvcode, li_gcode, al_icode, ld_saleqty) <> 0 then
			retflag = false
			as_errortext = "Database Error: Item information can not be retrieved"
		end if
		ld_godownstock = ld_godownstock + ld_saleqty
		if wf_get_totalpieces_allocated(ll_saleinvcode, al_icode, ll_totalpieces) <> 0 then
			retflag = false
			as_errortext = "Database Error: Item information can not be retrieved"
		end if
		ll_piecesinhand = ll_piecesinhand + ll_totalpieces
	end if
	if retflag then
		this.id_detail.setitem(al_row, "gcode", li_gcode)
		this.id_detail.setitem(al_row, "stock", ld_godownstock)
		this.id_detail.setitem(al_row, "totalstock", ld_totalstock)
		this.id_detail.setitem(al_row, "piecesinhand", ll_piecesinhand)
		if ll_piecesinhand = 0 then
			this.id_detail.setitem(al_row, "totalpieces", 0)
		end if
		if ld_godownstock = 0.0 then
			ai_rtcode = -2
			as_errortext = "Item can not be sold, its Stock is Zero"
		end if
	else
		retflag = false
		as_errortext = "Item can not be sold, its Stock is Zero"
	end if
	if f_stringpreferences("salepromptforreorder") = "Y" and ll_reorderqty > round(ld_godownstock / double(ll_packunits), 0) then
		messagebox("reorderqty", ll_reorderqty)
		messagebox("stock", ld_godownstock / double(ll_packunits))
		messagebox("Stock", "Stock for this item become~r~n less than ReorderQty")
	end if
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_totalstock)
	if f_stringpreferences("bonusinsale") = "Y" then
		this.id_footer.setitem(1, "bonusratio", trim(string(ll_qtysale)) + ":" + trim(string(ll_bonus)))
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			ld_holdlooseqty = this.id_detail.getitemnumber(al_row, "looseqty")
			if this.id_detail.getitemnumber(al_row, "qtysale") = 0.0 then
				ld_desiredbonus = 0
			else
				ld_desiredbonus = round(ld_holdlooseqty / double(this.id_detail.getitemnumber(al_row, "qtysale")) * double(this.id_detail.getitemnumber(al_row, "Bonus")), 4)
			end if
			if ld_holdlooseqty + ld_desiredbonus <= ld_godownstock then
				this.id_detail.setitem(al_row, "bonusqty", ld_desiredbonus)
			elseif ld_holdlooseqty > ld_godownstock then
				messagebox("Quantity Validation", "Quantity " + string(ld_holdlooseqty) + " exceeds stock " + string(ld_godownstock) + ".")
				this.id_detail.setitem(al_row, "looseqty", 1)
				this.id_detail.setitem(al_row, "bonusqty", 0)
			else
				ld_desiredbonus = messagebox("Problem allocating bonus", "Sale Qty = " + string(ld_holdlooseqty) + " ~r" + "Required Bonus = " + trim(string(ld_desiredbonus)) + " ~r" + "Stock available = " + trim(string(ld_godownstock)) + " ~r" + "Allocate possible bonus?", question!, yesno!, 2)
				if ld_desiredbonus = 1.0 then
					this.id_detail.setitem(al_row, "bonusqty", ld_godownstock - ld_holdlooseqty)
				else
					retflag = false
					this.id_detail.setitem(al_row, "bonusqty", 0)
				end if
			end if
		end if
	end if
	return retflag

// w_sale.wf_closelist() returns 0
	this.ib_itemslistopen = false
	this.id_itemslist.hide()

// w_sale.wf_isposted(long al_invcode) returns boolean
	long ll_count
	SQL SELECT Count ( SaleInvCode ) INTO :ll_count FROM SaleLedger WHERE SaleInvCode =:al_invcode and Posted ='Y' AND ImpactInventory ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_count > 0 then
			return true
		else
			return false
		end if
		return
	end if
	return false

// w_sale.wf_isdeleted(long al_invcode) returns boolean
	long ll_count
	SQL SELECT Count ( SaleInvCode ) INTO :ll_count FROM SaleLedger WHERE SaleInvCode =:al_invcode and Deleted ='Y' AND ImpactInventory ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_count > 0 then
			return true
		else
			return false
		end if
		return
	end if
	return false

// w_sale.wf_isinvoiceinuse(long al_invoiceno) returns boolean
	long ll_found
	SQL Select count ( *) INTO :ll_found From SaleLedger Where SaleInvCode =:al_invoiceno and Posted ='Y' AND ImpactInventory ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_found = 0 or isnull(ll_found) then
			ll_found = 0
			SQL Select count ( *) INTO :ll_found From SaleLedger With ( ReadPast , RowLock , UpdLock ) Where SaleInvCode =:al_invoiceno USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ll_found = 0 then
					return true
				else
					return false
				end if
			else
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_sale.wf_itemnetprice(double al_saleprice, double al_discperc, double al_itemflatdisc, long al_icode) returns integer
	double ld_saleprice
	double ld_recentpurprice
	double ld_discperc
	double ld_itemflatdisc
	double ld_itemnetprice
	double ld_salepricechangemargin
	double ld_lower_saleprice
	double ld_upper_saleprice
	integer li_packunits
	integer li_retmsgcode
	integer li_retcode
	SQL Select item.RecentPurPrice , item.packunits , item.salepricechangemargin , item.saleprice INTO :ld_recentpurprice, :li_packunits, :ld_salepricechangemargin, :ld_saleprice From Item Where item.icode =:al_icode USING this.it_transobject;
	if li_packunits < 1 or isnull(li_packunits) then
		li_packunits = 1
	end if
	wf_discpricecalc(al_discperc)
	ld_itemnetprice = (al_saleprice - al_itemflatdisc) * (1.0 - al_discperc / 100.0)
	if ld_itemnetprice < ld_recentpurprice / li_packunits then
		li_retmsgcode = messagebox("Sale Validation", "Net Price " + string(ld_itemnetprice) + " is less than Recent Purchase Price~r~n Do you want to continue", question!, yesno!)
		if li_retmsgcode = 1 then
			li_retcode = 0
		else
			li_retcode = 1
		end if
	end if
	if li_retcode = 0 and f_stringpreferences("ApplySalePriceChangeMargin") = "Y" then
		ld_upper_saleprice = round(ld_saleprice / li_packunits * (1.0 + ld_salepricechangemargin * 0.01), 2)
		if ld_itemnetprice <= ld_upper_saleprice then
			li_retcode = 0
		else
			messagebox("Sale Price Validation", "Net Sale Price is violating Sale Price Change Margin~r~n~r~n" + "Net Sale Price         = " + string(ld_itemnetprice, "##,###,###0.00") + "~r~n~r~n" + "Actual Sale Price = " + string(round(ld_saleprice / li_packunits, 2), "##,###,###0.00") + "~r~n" + "Sale Price Change Margin = " + string(ld_salepricechangemargin, "###0.00") + "%~r~n" + "Sale Price Upper Limit = " + string(ld_upper_saleprice, "##,###,###0.00"), stopsign!)
			li_retcode = 1
		end if
	end if
	return li_retcode

// w_sale.wf_post() returns integer
	integer li_postingmode = 1
	long ll_sinvcode
	long ll_linvcode
	setnull(ll_sinvcode)
	setnull(ll_linvcode)
	return wf_post_sale(li_postingmode, ll_sinvcode, ll_linvcode)

// w_sale.wf_postsaleheaderwise() returns integer
	integer li_errcode
	integer li_count
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_postsaleheaderwise)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING this.it_transobject;
			SQL Select count ( *) INTO :ll_saleinvcount From saleledger WITH ( UPDLOCK HOLDLOCK ) Where saleledger.headerinvno Between :lstr_arginfo.l_code1 AND :lstr_arginfo.l_code2 AND saleledger.Posted ='N' AND ImpactInventory ='Y' USING this.it_transobject;
			li_errcode = this.it_transobject.sqlcode
			if li_errcode = 0 then
				this.it_transobject.postsaleledgerheaderwise(lstr_arginfo.l_code1, lstr_arginfo.l_code2, 2, ll_salesmancode, lstr_arginfo.l_code3, this.ic_impactinventory)
				if this.it_transobject.sqlcode <> 0 then
					li_errcode = this.it_transobject.sqlcode
					ls_msgtext = this.it_transobject.sqlerrtext
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				li_errcode = this.it_transobject.sqlcode
				ls_msgtext = this.it_transobject.sqlerrtext
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode))
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_saleinvcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return li_errcode

// w_sale.wf_post_wrt_patient() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		openwithparm(w_arg_patient_sinvcode_linvcode, this.ii_saletype)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			li_errcode = wf_locksaleinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_saleinvcount)
			if li_errcode = 0 then
				this.it_transobject.postsaleledger_wrt_patient(lstr_arginfo.l_code1, lstr_arginfo.l_code2, this.ii_saletype, ll_salesmancode, lstr_arginfo.l_code3, this.ic_impactinventory)
				if this.it_transobject.sqlcode <> 0 then
					li_errcode = this.it_transobject.sqlcode
					ls_msgtext = this.it_transobject.sqlerrtext
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				li_errcode = this.it_transobject.sqlcode
				ls_msgtext = this.it_transobject.sqlerrtext
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode))
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_saleinvcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return li_errcode

// w_sale.wf_patient_retrieve() returns long
	long ll_prow
	long ll_pcode
	long ll_retcode
	if this.ic_retrievepatientlist = "N" then
		ll_retcode = 0
	else
		ll_retcode = this.idc_patient.retrieve(this.ii_salemodule)
	end if
	if this.idc_patient.rowcount() <= 0 then
		ll_prow = this.idc_patient.insertrow(0)
		setnull(ll_pcode)
		this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
		this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
		this.idc_patient.setitem(ll_prow, "name", "<NONE>")
		this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
		this.idc_patient.setitem(ll_prow, "city", "<NONE>")
		this.idc_patient.scrolltorow(ll_prow)
	end if
	return 0

// w_sale.wf_new_patientregistration() returns long
	string ls_regno
	long ll_patientcode
	long ll_found
	long ll_row
	dwobject dwo
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 581", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		open(w_patientregistration)
		ls_regno = message.stringparm
		if not (ls_regno = "" or isnull(ls_regno)) then
			wf_patient_retrieve()
			wf_validate_patient_from_outside(ls_regno)
			ll_found = 0
			ll_found = this.idc_patient.find("regno = '" + ls_regno + "'", 1, this.idc_patient.rowcount())
			if ll_found > 0 then
				this.id_master.setitem(1, "patientregno", this.idc_patient.getitemstring(ll_found, "regno"))
				ll_patientcode = this.idc_patient.getitemnumber(ll_found, "patientcode")
				this.id_master.setitem(1, "patientcode", ll_patientcode)
				dwo = this.id_master.object.patientcode
				this.id_master.post event itemchanged(1, dwo, string(ll_patientcode))
			end if
		end if
	end if
	return 0

// w_sale.wf_deletesaleinvoice(long al_saleinvcode) returns integer
	SQL Delete saledetail Where saledetail.SaleInvCode =:al_saleinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_sale.wf_populate_prescription() returns long
	datastore lds_prescdetail
	datastore lds_prescheader
	dwobject dwo
	s_arguements lstr_arg
	integer li_retcode = 1
	integer li_errcode
	long ll_found
	long ll_innercounter
	long ll_prescode
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrow
	long ll_counter
	long ll_patientcode
	long ll_null
	long ll_masterrow
	double ld_qty
	double ld_satisfiedqty
	double ld_newqty
	double ld_looseqty
	double ld_holdqty
	double ld_holdbonusqty
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	if wf_iseditable() = false then
		return 0
	end if
	open(w_copyprescription)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 0 then
		ll_prescode = lstr_arg.l_code1
		lds_prescdetail = create datastore
		lds_prescheader = create datastore
		lds_prescheader.dataobject = "d_prescription_header"
		lds_prescheader.settransobject(this.it_transobject)
		ll_masterrow = lds_prescheader.retrieve(ll_prescode)
		if ll_masterrow < 0 then
			return -1
		end if
		lds_prescdetail.dataobject = "d_prescription_detail"
		lds_prescdetail.settransobject(this.it_transobject)
		ll_totalrows = lds_prescdetail.retrieve(ll_prescode)
		if ll_totalrows < 0 then
			return -1
		end if
		ll_totalrows = lds_prescdetail.rowcount()
		ll_patientcode = wf_get_patient(ll_prescode)
		dwo = this.id_master.object.patientcode
		this.id_master.setcolumn("patientcode")
		this.id_master.setitem(this.id_master.getrow(), "patientcode", ll_patientcode)
		this.id_master.setitem(this.id_master.getrow(), "prescode", ll_prescode)
		this.id_master.setitem(1, "patientregno", this.idc_patient.getitemstring(this.idc_patient.getrow(), "regno"))
		this.id_master.event itemchanged(1, dwo, string(ll_patientcode))
		if this.ii_saletype = 2 and long(this.id_master.object.patientcode.visible) = 0 then
			this.id_master.object.custcode.protect = 0
			this.id_master.object.aliasname.protect = 0
		end if
		this.id_master.object.remarks[this.id_master.rowcount()] = lds_prescheader.object.remarks[ll_masterrow]
		this.id_master.object.doctcode[this.id_master.rowcount()] = lds_prescheader.object.doctcode[ll_masterrow]
		this.id_master.object.custrefno[this.id_master.rowcount()] = lds_prescheader.object.refno[ll_masterrow]
		ll_rowcount = this.id_detail.rowcount()
		for ll_counter = 1 to ll_rowcount
			event ue_deleteitem()
		next
		for ll_counter = 1 to ll_totalrows
			ld_qty = lds_prescdetail.getitemnumber(ll_counter, "noofunits") * lds_prescdetail.getitemnumber(ll_counter, "dosefactor")
			ll_icode = lds_prescdetail.getitemnumber(ll_counter, "icode")
			sqlca.getsatisfiedqty_for_prescription(ll_prescode, ll_icode, ld_satisfiedqty)
			if sqlca.sqlcode = 0 then
				ld_newqty = ld_qty - ld_satisfiedqty
				if ld_newqty > 0.0 then
					ll_insertedrow = this.id_detail.insertrow(0)
					wf_inititeminfo(ll_icode, ll_insertedrow, li_errcode, ls_errortext)
					this.id_detail.setitem(ll_insertedrow, "looseqty", ld_newqty)
					lb_enablesave = true
				end if
			else
				messagebox("Fetch Error", "Unable to fetch already issued qty against this prescription for item Code = " + string(ll_icode))
			end if
		next
		if lb_enablesave then
			this.im_menu.m_file.m_save.enabled = true
			this.im_menu.m_file.m_print.enabled = true
			wf_grandtotal()
		else
			setnull(ll_null)
			this.id_master.setitem(this.id_master.getrow(), "prescode", ll_null)
			messagebox("Items Validation", "No items left to populate for this prescription.")
		end if
		destroy lds_prescdetail
	end if
	return 0

// w_sale.wf_search_customer() returns 0
	long ll_code
	long ll_oldcode
	s_popup_selection lstr_selection
	if wf_iseditable() = false then
		return
	end if
	if this.ii_saletype = 3 then
		return
	end if
	ll_oldcode = this.id_master.getitemnumber(1, "custcode")
	this.id_master.setcolumn("custcode")
	this.id_master.setfocus()
	openwithparm(w_popup_partialsearch_selection, "d_customer_list")
	lstr_selection = message.powerobjectparm
	if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
		this.id_master.setitem(1, "custcode", lstr_selection.l_code2)
		if wf_setcustomerinfo(1, 1, string(lstr_selection.l_code2)) <> 0 then
			this.id_master.setitem(1, "custcode", ll_oldcode)
		end if
	end if

// w_sale.wf_set_godown_item_stock(long ai_gcode, long al_icode, long al_detailrow, ref string as_errortext) returns long
	double ld_godownstock
	boolean retflag = true
	this.it_transobject.getitemstocktotal(ai_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.id_detail.setitem(al_detailrow, "stock", ld_godownstock)
	this.id_footer.setitem(this.id_footer.getrow(), "stock", ld_godownstock)
	if retflag then
		return 0
	end if
	return -1

// w_sale.wf_setcomments() returns integer
	s_quotationremarks ls_quotationremarks
	ls_quotationremarks.remarks2 = this.id_master.getitemstring(1, "salecomments1")
	ls_quotationremarks.remarks3 = this.id_master.getitemstring(1, "salecomments2")
	openwithparm(w_salecomments, ls_quotationremarks)
	ls_quotationremarks = message.powerobjectparm
	this.id_master.setitem(1, "salecomments1", ls_quotationremarks.remarks2)
	this.id_master.setitem(1, "salecomments2", ls_quotationremarks.remarks3)
	return 1

// w_sale.wf_copyinvoice() returns integer
	datastore lds_saletemplatedetail
	datastore lds_saletemplateheader
	s_saletemplate lstr_template
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	boolean lb_bonus
	boolean lb_salepricefromtemplate
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrows
	long ll_packunits
	long ll_found
	long ll_innercounter
	integer li_retcode = 1
	integer li_errcode
	integer li_counter
	integer li_addbonusinqty
	double ld_looseqty
	double ld_holdbonusqty
	double ld_holdqty
	datawindowchild ldc_godown
	if wf_iseditable() = false then
		return 0
	end if
	lds_saletemplatedetail = create datastore
	lds_saletemplateheader = create datastore
	open(w_copysaleinvoicefrom2)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		destroy lds_saletemplatedetail
		return -1
	end if
	if f_stringpreferences("BonusInSale") = "Y" then
		lb_bonus = true
	end if
	if lstr_template.c_copyinvfrom = "T" then
		if messagebox("Sale Price Confirmation", "Do you want to apply SalePrice from saletemplate?", stopsign!, yesno!, 2) = 1 then
			lb_salepricefromtemplate = true
		end if
		lds_saletemplatedetail.dataobject = "d_saletemplate_detail"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "qty"))
			if lb_salepricefromtemplate = true then
				this.id_detail.setitem(ll_rowcount, "saleprice", lds_saletemplatedetail.getitemnumber(ll_rowcount, "saleprice"))
			end if
		next
	elseif lstr_template.c_copyinvfrom = "A" then
		lds_saletemplatedetail.dataobject = "d_IssueReqdetail_temp"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "qty"))
		next
	elseif lstr_template.c_copyinvfrom = "I" then
		if f_stringpreferences("SaleShowPromptOnpopulation") = "Y" and messagebox("Sale Price Confirmation", "Do you want to apply Price from sale invoice?", stopsign!, yesno!, 2) = 1 then
			lb_salepricefromtemplate = true
		end if
		lds_saletemplatedetail.dataobject = this.id_detail.dataobject
		lds_saletemplatedetail.settransobject(this.it_transobject)
		li_retcode = lds_saletemplatedetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "looseqty"))
			if lb_bonus then
				this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "bonusqty"))
			end if
			if lb_salepricefromtemplate then
				this.id_detail.setitem(ll_rowcount, "saleprice", lds_saletemplatedetail.getitemnumber(ll_rowcount, "saleprice"))
				this.id_detail.setitem(ll_rowcount, "itemflatdisc", lds_saletemplatedetail.getitemnumber(ll_rowcount, "itemflatdisc"))
				this.id_detail.setitem(ll_rowcount, "discperc", lds_saletemplatedetail.getitemnumber(ll_rowcount, "discperc"))
				this.id_detail.setitem(ll_rowcount, "gstperc", lds_saletemplatedetail.getitemnumber(ll_rowcount, "gstperc"))
				this.id_detail.setitem(ll_rowcount, "unitsalestax", lds_saletemplatedetail.getitemnumber(ll_rowcount, "unitsalestax"))
			end if
		next
	elseif lstr_template.c_copyinvfrom = "P" then
		li_addbonusinqty = messagebox("Bonus In Sale Qty", "Do you want to add Bonus In Sale Qty?", question!, yesno!, 2)
		if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
			lds_saletemplatedetail.dataobject = "d_normalpurchasedetail"
			lds_saletemplateheader.dataobject = "d_normalpurchaseheader"
		elseif lstr_template.i_invtype = 3 then
			lds_saletemplatedetail.dataobject = "d_OpeningPurchaseDetail"
			lds_saletemplateheader.dataobject = "d_OpeningPurchaseHeader"
		else
			lds_saletemplatedetail.dataobject = "d_loosepurchasedetail"
			lds_saletemplateheader.dataobject = "d_loosepurchaseheader"
		end if
		if messagebox("Sale Price Confirmation", "Do you want to apply Price from Purchase invoice?", stopsign!, yesno!, 2) = 1 then
			lb_salepricefromtemplate = true
		end if
		lds_saletemplatedetail.settransobject(this.it_transobject)
		lds_saletemplateheader.settransobject(this.it_transobject)
		li_retcode = lds_saletemplatedetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = 0
		ll_totalrows = lds_saletemplateheader.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		else
			this.id_master.setitem(1, "suppinvcode", lds_saletemplateheader.getitemstring(1, "suppinvcode"))
			this.id_master.setitem(1, "grn", lds_saletemplateheader.getitemstring(1, "grn"))
			if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
				this.id_master.setitem(1, "gccode", lds_saletemplateheader.getitemnumber(1, "gccode"))
			end if
		end if
		ll_detailrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		li_counter = 1
		for li_counter = 1 to ll_detailrows
			ll_icode = lds_saletemplatedetail.object.icode[li_counter]
			if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
				ld_holdqty = lds_saletemplatedetail.object.packqty[li_counter]
				ld_holdbonusqty = lds_saletemplatedetail.object.bonusqty[li_counter]
			else
				ld_holdqty = lds_saletemplatedetail.object.looseqty[li_counter]
				ld_holdbonusqty = lds_saletemplatedetail.object.bonusqty[li_counter]
			end if
			ll_insertedrows = this.id_detail.insertrow(0)
			wf_inititeminfo(ll_icode, ll_insertedrows, li_errcode, ls_errortext)
			if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
				ld_holdqty = ld_holdqty * lds_saletemplatedetail.getitemnumber(li_counter, "packunits")
				ld_holdbonusqty = ld_holdbonusqty * lds_saletemplatedetail.getitemnumber(li_counter, "packunits")
			end if
			this.id_detail.setitem(ll_insertedrows, "looseqty", ld_holdqty)
			if li_addbonusinqty = 1 then
				this.id_detail.setitem(ll_insertedrows, "looseqty", ld_holdqty + ld_holdbonusqty)
			elseif lb_bonus then
				this.id_detail.setitem(ll_insertedrows, "bonusqty", ld_holdbonusqty)
			end if
			if lb_salepricefromtemplate then
				ll_packunits = this.id_detail.getitemnumber(ll_insertedrows, "packunits")
				if ll_packunits = 0 then
					ll_packunits = 1
				end if
				if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
					this.id_detail.setitem(ll_insertedrows, "saleprice", lds_saletemplatedetail.getitemnumber(li_counter, "purprice") / ll_packunits)
					this.id_detail.setitem(ll_insertedrows, "unitsalestax", lds_saletemplatedetail.getitemnumber(li_counter, "unitsalestax") / ll_packunits)
				else
					this.id_detail.setitem(ll_insertedrows, "saleprice", lds_saletemplatedetail.getitemnumber(li_counter, "purprice"))
					this.id_detail.setitem(ll_insertedrows, "unitsalestax", lds_saletemplatedetail.getitemnumber(li_counter, "unitsalestax"))
				end if
				this.id_detail.setitem(ll_insertedrows, "discperc", lds_saletemplatedetail.getitemnumber(li_counter, "discperc"))
				this.id_detail.setitem(ll_insertedrows, "gstperc", lds_saletemplatedetail.getitemnumber(li_counter, "gstperc"))
			end if
		next
	elseif lstr_template.c_copyinvfrom = "O" then
		li_addbonusinqty = messagebox("Bonus In Sale Qty", "Do you want to add Bonus In Sale Qty?", question!, yesno!, 2)
		lds_saletemplatedetail.dataobject = "d_purchaseorderdetail"
		lds_saletemplateheader.dataobject = "d_purchaseorderheader"
		if messagebox("Sale Price Confirmation", "Do you want to apply Price from Purchase Order?", stopsign!, yesno!, 2) = 1 then
			lb_salepricefromtemplate = true
		end if
		lds_saletemplatedetail.settransobject(this.it_transobject)
		lds_saletemplateheader.settransobject(this.it_transobject)
		li_retcode = lds_saletemplatedetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = 0
		ll_totalrows = lds_saletemplateheader.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		else
			this.id_master.setitem(1, "suppinvcode", lds_saletemplateheader.getitemstring(1, "supplierreference"))
		end if
		ll_detailrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for li_counter = 1 to ll_detailrows
			ld_holdqty = 0
			ld_holdbonusqty = 0
			ll_icode = lds_saletemplatedetail.object.icode[li_counter]
			ll_found = lds_saletemplatedetail.find("icode=" + string(ll_icode), 1, li_counter - 1)
			if ll_found > 0 then
				if ll_detailrows = 1 then
					lb_isitemexists = false
				elseif li_counter = 1 then
					lb_isitemexists = false
				else
					lb_isitemexists = true
				end if
			else
				lb_isitemexists = false
			end if
			if lb_isitemexists = false then
				ld_holdqty = lds_saletemplatedetail.object.qty[li_counter]
				ld_holdbonusqty = lds_saletemplatedetail.object.bonusqty[li_counter]
				if li_counter <> ll_detailrows then
					ll_found = lds_saletemplatedetail.find("icode=" + string(ll_icode), li_counter + 1, ll_detailrows)
					ll_innercounter = ll_found
					do while ll_found > 0 and ll_innercounter <= ll_detailrows
						ld_holdqty = ld_holdqty + lds_saletemplatedetail.object.qty[ll_found]
						ld_holdbonusqty = ld_holdbonusqty + lds_saletemplatedetail.object.bonusqty[ll_found]
						ll_innercounter = ll_found + 1
						ll_found = lds_saletemplatedetail.find("icode=" + string(ll_icode), ll_innercounter, ll_detailrows)
					loop
				end if
				ll_insertedrows = this.id_detail.insertrow(0)
				wf_inititeminfo(lds_saletemplatedetail.getitemnumber(li_counter, "icode"), ll_insertedrows, li_errcode, ls_errortext)
				ld_holdqty = ld_holdqty * lds_saletemplatedetail.getitemnumber(li_counter, "packunits")
				ld_holdbonusqty = ld_holdbonusqty * lds_saletemplatedetail.getitemnumber(li_counter, "packunits")
				this.id_detail.setitem(ll_insertedrows, "looseqty", ld_holdqty)
				if li_addbonusinqty = 1 then
					this.id_detail.setitem(ll_insertedrows, "looseqty", ld_holdqty + ld_holdbonusqty)
				elseif lb_bonus then
					this.id_detail.setitem(ll_insertedrows, "bonusqty", ld_holdbonusqty)
				end if
				if lb_salepricefromtemplate then
					ll_packunits = this.id_detail.getitemnumber(ll_insertedrows, "packunits")
					if ll_packunits = 0 then
						ll_packunits = 1
					end if
					this.id_detail.setitem(ll_insertedrows, "saleprice", lds_saletemplatedetail.getitemnumber(li_counter, "saleprice") / ll_packunits)
					this.id_detail.setitem(ll_insertedrows, "unitsalestax", lds_saletemplatedetail.getitemnumber(li_counter, "packsalestax") / ll_packunits)
					this.id_detail.setitem(ll_insertedrows, "discperc", lds_saletemplatedetail.getitemnumber(li_counter, "discperc"))
					this.id_detail.setitem(ll_insertedrows, "gstperc", lds_saletemplatedetail.getitemnumber(li_counter, "gstperc"))
				end if
			end if
		next
	elseif lstr_template.c_copyinvfrom = "R" then
		lds_saletemplatedetail.dataobject = "d_OpenWholeSaleReturnDetail"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		li_retcode = lds_saletemplatedetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "looseqty"))
			if lb_bonus then
				this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "bonusqty"))
			end if
		next
	elseif lstr_template.c_copyinvfrom = "N" then
		lds_saletemplatedetail.dataobject = "d_transfer_detail"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "gcode", lds_saletemplatedetail.getitemnumber(ll_rowcount, "dgcode"))
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "qty"))
			this.id_detail.setitem(ll_rowcount, "bonusqty", 0)
		next
	elseif lstr_template.c_copyinvfrom = "C" then
		lds_saletemplatedetail.dataobject = "d_receiptdetail"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		li_retcode = lds_saletemplatedetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_detailrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for li_counter = 1 to ll_detailrows
			ld_holdqty = 0
			ld_holdbonusqty = 0
			ll_icode = lds_saletemplatedetail.object.icode[li_counter]
			ll_found = lds_saletemplatedetail.find("icode=" + string(ll_icode), 1, li_counter - 1)
			if ll_found > 0 then
				if ll_detailrows = 1 then
					lb_isitemexists = false
				elseif li_counter = 1 then
					lb_isitemexists = false
				else
					lb_isitemexists = true
				end if
			else
				lb_isitemexists = false
			end if
			if lb_isitemexists = false then
				ld_holdqty = lds_saletemplatedetail.object.qty[li_counter]
				if li_counter <> ll_detailrows then
					ll_found = lds_saletemplatedetail.find("icode=" + string(ll_icode), li_counter + 1, ll_detailrows)
					ll_innercounter = ll_found
					do while ll_found > 0 and ll_innercounter <= ll_detailrows
						ld_holdqty = ld_holdqty + lds_saletemplatedetail.object.qty[ll_found]
						ll_innercounter = ll_found + 1
						ll_found = lds_saletemplatedetail.find("icode=" + string(ll_icode), ll_innercounter, ll_detailrows)
					loop
				end if
				ll_insertedrows = this.id_detail.insertrow(0)
				wf_inititeminfo(lds_saletemplatedetail.getitemnumber(li_counter, "icode"), ll_insertedrows, li_errcode, ls_errortext)
				this.id_detail.setitem(ll_insertedrows, "looseqty", ld_holdqty)
			end if
		next
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	this.id_master.setitem(1, "moduleid", lstr_template.l_moduleid)
	this.id_master.setitem(1, "doccode", lstr_template.l_doccode)
	destroy lds_saletemplatedetail
	destroy lds_saletemplateheader
	return li_retcode

// w_sale.wf_setimgonprint(integer ai_writeorclear) returns integer
	integer li_retcode = 1
	blob lblob_sigonsaleinv
	if f_stringpreferences("sigonsaleinv") = "Y" then
		if ai_writeorclear = 1 then
			SQL rollback USING sqlca;
			SQL SelectBlob PrefImage INTO :lblob_sigonsaleinv From SoftwarePreferences Where name ='sigonsaleinvimg' USING sqlca;
			if sqlca.sqlcode = 0 then
				li_retcode = 1
			else
				li_retcode = -1
			end if
			SQL rollback USING sqlca;
			f_writeimgtofile("c:\winim.jpg", lblob_sigonsaleinv)
			this.id_print.modify("p_sig.FileName='c:\winim.jpg'")
		elseif ai_writeorclear = 0 then
			lblob_sigonsaleinv = blob("0xoeqpxakvabl")
			f_writeimgtofile("c:\winim.jpg", lblob_sigonsaleinv)
		end if
	end if
	return li_retcode

// w_sale.wf_edit_saleorder() returns integer
	datastore lds_saleorderdetail
	datastore lds_saleorderheader
	datastore lds_items
	s_arguements lstr_arg
	boolean lb_enablesave
	boolean lb_insertrow
	integer li_retcode
	integer li_errcode
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_counter
	long ll_tmprowid
	long ll_tmpcode
	long ll_icode
	long ll_custcode
	long ll_ds_row
	long ll_suppcode
	double ld_tmpqty
	double ld_tmpbonus
	double ld_looseqty
	double ld_bonusqty
	double ld_stock
	double ld_totstock
	string ls_errortext
	string ls_customer
	string ls_suppname
	string ls_custrefno
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.rowcount() > 0 then
		ll_custcode = this.id_master.object.custcode[1]
	end if
	if ll_custcode <= 0 then
		messagebox("Customer Validation!", "Please select a valid customer first.", stopsign!)
		this.id_master.setfocus()
		this.id_master.setcolumn("custcode")
		return 0
	end if
	lds_saleorderdetail = create datastore
	lds_saleorderheader = create datastore
	lds_items = create datastore
	openwithparm(w_populate_finalizedsaleorder, ll_custcode)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		this.id_detail.setredraw(false)
		lds_saleorderdetail.dataobject = "d_SaleOrderdetail_sales"
		lds_saleorderdetail.settransobject(this.it_transobject)
		lds_saleorderheader.dataobject = "d_SaleOrderheader"
		lds_saleorderheader.settransobject(this.it_transobject)
		lds_items.dataobject = f_set_saleorder_rejected_list()
		lds_items.settransobject(this.it_transobject)
		ll_row = lds_saleorderheader.retrieve(lstr_arg.ia_integerlist[1])
		if ll_row <= 0 then
			li_retcode = -1
		else
			SQL SELECT Name INTO :ls_customer FROM Accounts WHERE AccCode =:ll_custcode USING this.it_transobject;
			ll_mrow = this.id_master.getrow()
			this.id_master.setitem(ll_mrow, "SaleOrdercode", lstr_arg.ia_integerlist[1])
			if this.ii_saletype = 2 then
				this.id_master.setitem(ll_mrow, "custcode", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "custcode"))
			end if
			this.id_master.setitem(ll_mrow, "sprice", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "sprice"))
			this.id_master.setitem(ll_mrow, "remarks", lds_saleorderheader.getitemstring(lds_saleorderheader.getrow(), "remarks"))
			this.id_master.setitem(ll_mrow, "headerno", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "headerno"))
			this.id_footer.setitem(ll_mrow, "misccharges", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "misccharges"))
			this.id_footer.setitem(ll_mrow, "flatdisc", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "flatdisc"))
			this.id_footer.setitem(ll_mrow, "invdiscperc", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "discperc"))
			this.id_master.setitem(ll_mrow, "smancode", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "smancode"))
			ls_custrefno = this.id_master.object.custrefno[ll_mrow]
			lds_saleorderdetail.retrieve(lstr_arg.ia_integerlist, lstr_arg.l_code1)
		end if
		ll_totalrows = lds_saleorderdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		if lb_enablesave then
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
			this.id_detail.reset()
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				lb_insertrow = false
				ld_tmpqty = 0
				ld_tmpbonus = 0
				if lstr_arg.l_code1 = 0 then
					lb_insertrow = true
				else
					if this.ib_modify and this.id_master.getitemnumber(1, "code") > 0.0 then
						ll_tmprowid = lds_saleorderdetail.getitemnumber(ll_counter, "rowid")
						ll_tmpcode = this.id_master.getitemnumber(1, "code")
						SQL SELECT sum ( looseqty ) , sum ( bonusqty ) INTO :ld_tmpqty, :ld_tmpbonus FROM SaleDetail WHERE SaleOrderRowID =:ll_tmprowid AND SaleInvCode =:ll_tmpcode USING this.it_transobject;
						if this.it_transobject.sqlcode <> 0 then
							lb_insertrow = false
						end if
					end if
					if isnull(ld_tmpqty) then
						ld_tmpqty = 0
					end if
					if isnull(ld_tmpbonus) then
						ld_tmpbonus = 0
					end if
					if lds_saleorderdetail.getitemnumber(ll_counter, "looseqty") - lds_saleorderdetail.getitemnumber(ll_counter, "saleqty") + ld_tmpqty > 0.0 or lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty") - lds_saleorderdetail.getitemnumber(ll_counter, "salebonus") + ld_tmpbonus > 0.0 then
						lb_insertrow = true
					end if
				end if
				if lb_insertrow = true then
					ll_rowcount = this.id_detail.insertrow(0)
					ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_saleorderdetail.getitemnumber(ll_counter, "gcode")), 1, this.idc_godown.rowcount())
					ll_icode = lds_saleorderdetail.getitemnumber(ll_counter, "icode")
					wf_inititeminfo(ll_icode, ll_rowcount, li_errcode, ls_errortext)
					ll_gcode = lds_saleorderdetail.getitemnumber(ll_counter, "gcode")
					this.id_detail.setitem(ll_rowcount, "gcode", ll_gcode)
					if wf_set_godown_item_stock(ll_gcode, ll_icode, ll_rowcount, ls_errortext) = 0 then
						this.id_detail.setitem(ll_rowcount, "SaleOrderrowid", lds_saleorderdetail.getitemnumber(ll_counter, "rowid"))
						if lstr_arg.l_code2 = 0 then
							this.id_detail.setitem(ll_rowcount, "packunits", lds_saleorderdetail.getitemnumber(ll_counter, "packunits"))
							this.id_detail.setitem(ll_rowcount, "discperc", lds_saleorderdetail.getitemnumber(ll_counter, "discperc"))
							this.id_detail.setitem(ll_rowcount, "itemflatdisc", lds_saleorderdetail.getitemnumber(ll_counter, "itemflatdisc"))
							this.id_detail.setitem(ll_rowcount, "saleprice", lds_saleorderdetail.getitemnumber(ll_counter, "saleprice"))
						end if
						if lstr_arg.l_code1 = 0 then
							this.id_detail.setitem(ll_rowcount, "looseqty", lds_saleorderdetail.getitemnumber(ll_counter, "looseqty"))
							this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty"))
						else
							ld_looseqty = lds_saleorderdetail.getitemnumber(ll_counter, "looseqty") - lds_saleorderdetail.getitemnumber(ll_counter, "saleqty") + ld_tmpqty
							ld_bonusqty = lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty") - lds_saleorderdetail.getitemnumber(ll_counter, "salebonus") + ld_tmpbonus
							if ld_looseqty > 0.0 then
								this.id_detail.setitem(ll_rowcount, "looseqty", ld_looseqty)
							end if
							if ld_bonusqty > 0.0 then
								this.id_detail.setitem(ll_rowcount, "bonusqty", ld_bonusqty)
							end if
						end if
						this.id_detail.object.claimable[ll_rowcount] = lds_saleorderdetail.object.claimable[ll_counter]
						this.id_detail.object.claimablediscperc[ll_rowcount] = lds_saleorderdetail.object.claimablediscperc[ll_counter]
						this.id_detail.object.taxflag[ll_rowcount] = 0
					end if
					ld_stock = this.id_detail.getitemnumber(ll_rowcount, "stock")
					ld_looseqty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
					ld_bonusqty = this.id_detail.getitemnumber(ll_rowcount, "bonusqty")
					ld_totstock = ld_stock + ld_tmpqty + ld_tmpbonus
					if ld_looseqty + ld_bonusqty > ld_totstock then
						ll_ds_row = lds_items.insertrow(0)
						lds_items.setitem(ll_ds_row, "customer", ls_customer)
						lds_items.setitem(ll_ds_row, "code", lds_saleorderdetail.getitemnumber(ll_counter, "code"))
						lds_items.setitem(ll_ds_row, "icode", lds_saleorderdetail.getitemnumber(ll_counter, "icode"))
						lds_items.setitem(ll_ds_row, "stock", ld_totstock)
						lds_items.setitem(ll_ds_row, "balance", ld_looseqty + ld_bonusqty - ld_totstock)
						SQL select suppcode , accounts.name INTO :ll_suppcode, :ls_suppname from itemsuppliers , accounts where itemsuppliers.icode =:ll_icode AND itemsuppliers.suppcode =accounts.acccode and itemsuppliers.priority IN ( select min ( priority ) from itemsuppliers where itemsuppliers.icode =:ll_icode ) USING this.it_transobject;
						lds_items.setitem(ll_ds_row, "suppcode", ll_suppcode)
						lds_items.setitem(ll_ds_row, "suppname", ls_suppname)
						lds_items.setitem(ll_ds_row, "customer", ls_customer)
						lds_items.setitem(ll_ds_row, "custrefno", ls_custrefno)
						lds_items.setitem(ll_ds_row, "aliasname", lds_saleorderdetail.getitemstring(ll_counter, "fullcode"))
						lds_items.setitem(ll_ds_row, "itemname", lds_saleorderdetail.getitemstring(ll_counter, "itemname"))
						lds_items.setitem(ll_ds_row, "qty", ld_looseqty + ld_bonusqty)
						if ld_totstock > ld_looseqty and ld_totstock > 0.0 then
							this.id_detail.setitem(ll_rowcount, "looseqty", ld_looseqty)
							if ld_totstock - ld_looseqty > ld_bonusqty then
								this.id_detail.setitem(ll_rowcount, "bonusqty", ld_bonusqty)
							else
								this.id_detail.setitem(ll_rowcount, "bonusqty", ld_totstock - ld_looseqty)
							end if
						elseif ld_totstock <= 0.0 then
							this.id_detail.setitem(ll_rowcount, "looseqty", 1)
						else
							this.id_detail.setitem(ll_rowcount, "looseqty", ld_totstock)
						end if
						if ld_totstock <= 0.0 then
							this.id_detail.setrow(ll_rowcount)
							this.id_detail.scrolltorow(ll_rowcount)
							event ue_deleteitem()
						end if
					end if
				end if
			next
		end if
		this.id_detail.setredraw(true)
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	if lds_items.rowcount() > 0 then
		openwithparm(w_saleorder_salepopulation_rejected, lds_items)
	end if
	wf_grandtotal()
	return li_retcode

// w_sale.wf_inititeminfo_quotation(long al_icode, long al_row, ref integer ai_rtcode, ref string as_errortext, long al_gcode) returns boolean
	boolean retflag = true
	integer li_gcode
	integer li_defaultgcode
	integer li_defaultgst
	integer li_custcode
	integer li_flatdiscstatus
	integer li_itemdiscpercno
	integer li_headerno
	long ll_packunits
	long ll_saleinvcode
	long ll_reorderqty
	long ll_null
	long ll_totalpieces
	long ll_piecesinhand
	long li_discstatus
	long ll_qtysale
	long ll_bonus
	long ll_itemdesc_status
	double ld_rpp
	double ld_purprice
	double ld_flatdisc
	double ld_invdiscperc
	double ld_discperc2
	double ld_discperc3
	double ld_discperc4
	double ld_saleprice
	double ld_discperc
	double ld_purdiscperc
	double ld_avgprice
	double ld_unitsalestax
	double ld_gstperc1
	double ld_gstperc2
	double ld_packsalestax
	double ld_saleprice2
