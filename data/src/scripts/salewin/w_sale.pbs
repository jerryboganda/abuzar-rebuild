// w_sale.wf_show_misccharges_breakup() returns long
	double ld_advincometax
	s_values lstr_values
	lstr_values.d_value1 = this.id_footer.object.misccharges1[1]
	lstr_values.d_value2 = this.id_footer.object.misccharges2[1]
	lstr_values.d_value3 = this.id_footer.object.misccharges3[1]
	lstr_values.d_value4 = this.id_footer.object.misccharges4[1]
	lstr_values.d_value5 = this.id_footer.object.misccharges5[1]
	lstr_values.i_status = 1
	openwithparm(w_misccharges_breakup, lstr_values)
	lstr_values = message.powerobjectparm
	if lstr_values.i_status = 1 then
		this.id_footer.object.misccharges1[1] = lstr_values.d_value1
		this.id_footer.object.misccharges2[1] = lstr_values.d_value2
		this.id_footer.object.misccharges3[1] = lstr_values.d_value3
		this.id_footer.object.misccharges4[1] = lstr_values.d_value4
		this.id_footer.object.misccharges5[1] = lstr_values.d_value5
		if this.ic_advancetaxonsale = "Y" then
			ld_advincometax = this.id_footer.object.advancetaxamt[1]
		else
			ld_advincometax = 0.00
		end if
		this.id_footer.object.misccharges[1] = ld_advincometax + lstr_values.d_value1 + lstr_values.d_value2 + lstr_values.d_value3 + lstr_values.d_value4 + lstr_values.d_value5
	end if
	return 0

// w_sale.wf_populate_image(long al_patientcode) returns long
	long ll_counter
	long ll_rowcount
	long ll_code
	ll_rowcount = this.dw_image.rowcount()
	if ll_rowcount <= 0 then
		return 0
	end if
	if isnull(al_patientcode) or al_patientcode <= 0 then
		return 0
	end if
	ll_code = this.dw_image.object.code[1]
	for ll_counter = 1 to ll_rowcount
		this.istr_image.ls_value[ll_counter, 1] = trim(string(this.dw_image.object.rowid[ll_counter]))
		this.istr_image.ls_value[ll_counter, 2] = this.dw_image.object.imagedescription[ll_counter]
		this.istr_image.ls_value[ll_counter, 3] = this.dw_image.object.imagetype[ll_counter]
		wf_get_image(ll_counter, al_patientcode)
	next
	return 0

// w_sale.wf_get_image(long al_row, long al_patientcode) returns long
	blob lbl_image
	u_transaction lt_transobject
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server")
		destroy lt_transobject
		return -1
	end if
	SQL SelectBlob PatientImage INTO :lbl_image From PatientImage Where Patientcode =:al_patientcode AND RowID =:al_row USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Patient Image/Picture ", "Unable to fetch patient Image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	this.istr_image.blob[al_row] = lbl_image
	return 0

// w_sale.wf_update_image() returns long
	long ll_counter
	long ll_code
	long ll_rowid
	long ll_patientcode
	long ll_null
	string ls_desc
	string ls_imgtype
	u_transaction lt_transobject
	setnull(ll_null)
	if this.id_master.rowcount() > 0 then
		ll_code = this.id_master.object.code[1]
		ll_patientcode = this.id_master.object.patientcode[1]
	end if
	if ll_code > 0 and this.dw_image.rowcount() = 0 then
		return 0
	end if
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server for updating/inserting in PatientImage Table")
		destroy lt_transobject
		return -1
	end if
	SQL DELETE PatientImage WHERE PatientCode =:ll_patientcode USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to Delete Previous Patient Image Record from database")
		destroy lt_transobject
		return -1
	end if
	for ll_counter = 1 to this.dw_image.rowcount()
		ll_rowid = this.dw_image.object.rowid[ll_counter]
		ls_desc = this.dw_image.object.imagedescription[ll_counter]
		ls_imgtype = this.dw_image.object.imagetype[ll_counter]
		SQL INSERT INTO PatientImage ( Patientcode , ImageDescription , RowID , ImageType , AdmissionCode , visitcode ) VALUES ( :ll_patientcode , :ls_desc , :ll_rowid , :ls_imgtype , :ll_null , :ll_null ) USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Insert Error", "Unable to Insert Patient Images Into Patient Image Table.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
			SQL stop USING lt_transobject;
			destroy lt_transobject
			return -1
		end if
		SQL UpdateBlob PatientImage Set PatientImage =:this.istr_image.blob[ll_counter] Where Patientcode =:ll_patientcode and ROWID =:ll_rowid USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Patient Image ", "Unable to update Patient image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		end if
	next
	SQL stop USING lt_transobject;
	destroy lt_transobject
	return 0

// w_sale.wf_set_patientimage(string as_caller) returns long
	long ll_counter
	long ll_code
	long ll_row
	long ll_patientcode
	long ll_null
	s_itemimage lstr_image
	lstr_image.s_caller = as_caller
	setnull(ll_null)
	if this.id_master.rowcount() > 0 then
		ll_patientcode = this.id_master.object.patientcode[1]
	end if
	if ll_patientcode > 0 then
		for ll_counter = 1 to this.dw_image.rowcount()
			lstr_image.ls_value[ll_counter, 1] = trim(string(this.dw_image.object.rowid[ll_counter]))
			lstr_image.ls_value[ll_counter, 2] = this.dw_image.object.imagedescription[ll_counter]
			lstr_image.ls_value[ll_counter, 3] = this.dw_image.object.imagetype[ll_counter]
			lstr_image.blob[ll_counter] = this.istr_image.blob[ll_counter]
		next
		openwithparm(w_patientimage, lstr_image)
		lstr_image = message.powerobjectparm
		if lstr_image.i_closemode = 1 then
			this.istr_image = lstr_image
			this.dw_image.reset()
			ll_code = ll_patientcode
			for ll_counter = 1 to 200
				if long(lstr_image.ls_value[ll_counter, 1]) > 0 then
					ll_row = this.dw_image.insertrow(0)
					this.dw_image.object.code[ll_row] = ll_code
					this.dw_image.object.admissioncode[ll_row] = ll_null
					this.dw_image.object.visitcode[ll_row] = ll_null
					this.dw_image.object.rowid[ll_row] = long(lstr_image.ls_value[ll_counter, 1])
					this.dw_image.object.imagedescription[ll_row] = lstr_image.ls_value[ll_counter, 2]
					this.dw_image.object.imagetype[ll_row] = lstr_image.ls_value[ll_counter, 3]
				end if
			next
		end if
	end if
	return 0

// w_sale.wf_populate_patient_sale() returns long
	datastore lds_saledetail
	s_arguements lstr_arg
	integer li_retcode = 1
	integer li_errcode
	integer li_counter
	integer ll_found
	integer ll_innercounter
	integer li_holdqty
	integer li_addbonusinqty
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrows
	long ll_masterrow
	long ll_patientcode
	double ld_looseqty
	double ld_holdbonusqty
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	boolean lb_bonus
	boolean lb_salepricefromtemplate
	datawindowchild ldc_godown
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	if ll_masterrow <= 0 then
		return 0
	end if
	ll_patientcode = this.id_master.object.patientcode[ll_masterrow]
	if ll_patientcode <= 0 or isnull(ll_patientcode) then
		messagebox("Patient Validation!", "Please Select a valid Patient")
		return 0
	end if
	lds_saledetail = create datastore
	openwithparm(w_patient_sale_selection, ll_patientcode)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = -1 then
		destroy lds_saledetail
		return -1
	end if
	if f_stringpreferences("BonusInSale") = "Y" then
		lb_bonus = true
	end if
	if lstr_arg.i_status = 1 then
		lds_saledetail.dataobject = "d_patientsalesinvoices"
		lds_saledetail.settransobject(this.it_transobject)
		ll_totalrows = lds_saledetail.retrieve(lstr_arg.la_longlist)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saledetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saledetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saledetail.getitemnumber(ll_rowcount, "looseqty"))
			if lb_bonus then
				this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saledetail.getitemnumber(ll_rowcount, "bonusqty"))
			end if
		next
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	destroy lds_saledetail
	return li_retcode

// w_sale.wf_apply_saleinvoice_discountpolicy() returns long
	double ld_invtotal
	double ld_invdiscperc
	string ls_msgtitle = "Sale Invoice Amount Based Discount Policy Implementation"
	string ls_msgdetail
	if wf_iseditable() = false then
		return 0
	end if
	if f_stringpreferences("ApplySaleInvoiceDiscountPolicyOnSaving") = "N" then
		return 0
	end if
	ld_invtotal = wf_grandtotal()
	this.it_transobject.apply_saleamt_based_discountpolicy(ld_invtotal, ld_invdiscperc)
	if this.it_transobject.sqlcode = 0 then
		if isnull(ld_invdiscperc) or ld_invdiscperc < 0.00 then
			ld_invdiscperc = 0
		end if
		this.id_footer.object.invdiscperc[1] = ld_invdiscperc
		this.id_footer.accepttext()
		wf_grandtotal()
		this.id_master.setitem(1, "discperc", ld_invdiscperc)
		this.id_master.accepttext()
		this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
		ld_invtotal = wf_grandtotal()
		if ld_invtotal < 0.0 then
			messagebox("Invoice Total Validation", "Sale Invoice Total can not be -ve value.", stopsign!)
			return -1
		end if
		return
	end if
	wf_setoutstandingamount()
	return 0

// w_sale.wf_splitsaleinvoice(boolean ab_newinvoice) returns long
	char ls_pref
	string ls_column = "looseqty"
	long ll_count
	long ll_counter
	long ll_insrow
	long ll_mincolvalue
	long ll_saleinvcode
	long ll_code
	long ll_headerinvcode
	long ll_detailrows
	long ll_colvalue
	long ll_found
	long ll_maxretcode
	long ll_headerno
	long ll_invoicecount
	double ld_grandtotal
	double ld_cashcharged
	double ld_cashtendered
	double ld_cashback
	double ld_misccharges
	double ld_flatdisc
	double ld_discperc
	datastore lds_split_hk
	if ab_newinvoice then
		lds_split_hk = create datastore
		lds_split_hk.dataobject = "d_splitinvoice_housekeeping"
		lds_split_hk.settransobject(this.it_transobject)
		ls_pref = f_stringpreferences("SplitSaleInvoice")
		if ls_pref = "N" then
			return 0
		else
			ll_detailrows = this.id_detail.rowcount()
			if ll_detailrows > 1 then
				ll_code = this.id_master.object.code[1]
				ll_headerinvcode = this.id_master.object.headerinvno[1]
				ll_headerno = this.id_master.object.headerno[1]
				ld_grandtotal = this.id_master.object.invtotal[1]
				ld_cashtendered = this.id_master.object.cashtendered[1]
				ld_cashcharged = this.id_master.object.cashcharged[1]
				ld_cashback = this.id_master.object.cashback[1]
				ld_discperc = this.id_master.object.discperc[1]
				ld_flatdisc = this.id_master.object.flatdisc[1]
				ld_misccharges = this.id_master.object.misccharges[1]
				if ls_pref = "H" then
					ll_count = this.id_detail.getitemnumber(1, "c_distinctheaders")
					ll_mincolvalue = this.id_detail.getitemnumber(1, "c_minheaderno")
					ls_column = "HeaderNo"
				elseif ls_pref = "G" then
					ll_count = this.id_detail.getitemnumber(1, "c_distinctgodowns")
					ll_mincolvalue = this.id_detail.getitemnumber(1, "c_mingcode")
					ls_column = "GCode"
				end if
				if ll_count = 1 then
					if ls_pref <> "H" then
						if ls_pref = "G" then
						end if
					end if
				elseif ll_count > 1 then
					ll_counter = 0
					for ll_counter = 1 to ll_detailrows
						ll_colvalue = this.id_detail.getitemnumber(ll_counter, ls_column)
						if ll_mincolvalue <> ll_colvalue then
							ll_found = lds_split_hk.find("columnvalue = " + trim(string(ll_colvalue)), 1, lds_split_hk.rowcount())
							if ll_found > 0 and ll_found <= lds_split_hk.rowcount() then
								lds_split_hk.setitem(ll_found, "columnvalue", ll_colvalue)
							else
								ll_insrow = lds_split_hk.insertrow(0)
								if ll_insrow > 0 then
									lds_split_hk.object.columnname[ll_insrow] = ls_column
									lds_split_hk.object.columnvalue[ll_insrow] = ll_colvalue
								end if
							end if
						end if
					next
					ll_counter = 0
					for ll_counter = 1 to lds_split_hk.rowcount()
						ll_maxretcode = wf_tabnewid("saleledger", ll_saleinvcode)
						if ll_maxretcode < 0 then
							SQL rollback USING this.it_transobject;
							messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in generating InvCode")
							return -1
						end if
						lds_split_hk.object.saleinvcode[ll_counter] = ll_saleinvcode
						ll_colvalue = lds_split_hk.object.columnvalue[ll_counter]
						if ls_pref = "H" then
							f_generateheaderinvcode(ll_colvalue, this.ii_module, ll_headerinvcode)
							ll_headerno = ll_colvalue
						end if
						lds_split_hk.object.headerinvcode[ll_counter] = ll_headerinvcode
						ll_maxretcode = this.id_master.rowscopy(1, 1, primary!, this.id_master, 9999, primary!)
						if ll_maxretcode = -1 then
							SQL rollback USING this.it_transobject;
							messagebox("Rows Copy Problem", "Problem in Copying Rows")
							return -1
						end if
						this.id_master.object.code[this.id_master.rowcount()] = ll_saleinvcode
						this.id_master.object.headerno[this.id_master.rowcount()] = ll_headerno
						this.id_master.object.headerinvno[this.id_master.rowcount()] = ll_headerinvcode
						this.id_master.object.sourcesaleinvcode[this.id_master.rowcount()] = ll_code
						ll_invoicecount = ll_invoicecount + 1
						this.il_saleinvlist[ll_invoicecount] = ll_saleinvcode
					next
					ll_counter = 0
					for ll_counter = 1 to ll_detailrows
						ll_found = 0
						ll_colvalue = this.id_detail.getitemnumber(ll_counter, ls_column)
						ll_found = lds_split_hk.find("columnvalue = " + trim(string(ll_colvalue)), 1, lds_split_hk.rowcount())
						if ll_found > 0 and ll_found <= lds_split_hk.rowcount() then
							this.id_detail.object.code[ll_counter] = lds_split_hk.object.saleinvcode[ll_found]
						end if
					next
					ll_counter = 0
					for ll_counter = 1 to this.id_master.rowcount()
						wf_split_totals(ll_counter, ld_grandtotal, ld_flatdisc, ld_misccharges, ld_cashcharged)
					next
				end if
			end if
		end if
	end if
	return 0

// w_sale.wf_split_totals(long al_row, double ad_grandtotal, double ad_flatdisc, double ad_misccharges, double ad_cashcharged) returns long
	long ll_code
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_discountvalue
	double ld_invtaxperc1val
	double ld_intaxperc1
	double ld_grosstotal
	double ld_totaltax
	double ld_totalitemleveltax
	double ld_grossamt_rate_qty
	double ld_totaldiscount
	double ld_accumulateddiscperc
	double ld_cashcharged
	double ld_outstandingamt
	double lr_discperc
	double lr_flatdisc
	double lr_misccharges
	double lr_salestax
	double lr_itemstotal
	integer li_roundupto
	li_roundupto = f_numberpreferences("roundsaleinvon")
	if isnull(li_roundupto) or li_roundupto < 0 then
		li_roundupto = 0
	end if
	if al_row > 0 then
		this.id_detail.groupcalc()
		ld_grosstotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
		ll_code = this.id_master.object.code[al_row]
		this.id_detail.setfilter("code = " + trim(string(ll_code)))
		this.id_detail.filter()
		this.id_detail.groupcalc()
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
		ld_grossamt_rate_qty = this.id_detail.getitemnumber(1, "c_grossamt_rate_qty")
		ld_totaldiscount = this.id_detail.getitemnumber(1, "c_totaldiscount")
		lr_discperc = this.id_master.object.discperc[al_row]
		if ld_grosstotal = 0.0 then
			ld_grosstotal = 1
		end if
		lr_flatdisc = round(ld_detaildwtotal / ld_grosstotal * ad_flatdisc, 2)
		this.id_master.object.flatdisc[al_row] = lr_flatdisc
		lr_misccharges = round(ld_detaildwtotal / ld_grosstotal * ad_misccharges, 2)
		this.id_master.object.misccharges[al_row] = lr_misccharges
		lr_salestax = this.id_master.object.salestax[al_row]
		ld_intaxperc1 = this.id_master.object.invgstperc1[al_row]
		ld_totalitemleveltax = this.id_detail.getitemnumber(1, "c_sumtaxval") + this.id_detail.getitemnumber(1, "c_sumgstval")
		ld_discountvalue = ld_detaildwtotal * lr_discperc * 0.01
		ld_detaildwtotal = round(ld_detaildwtotal, 2)
		ld_grandtotal = ld_detaildwtotal - ld_discountvalue - lr_flatdisc + lr_misccharges + lr_salestax
		ld_invtaxperc1val = round((ld_detaildwtotal - ld_discountvalue - lr_flatdisc) * ld_intaxperc1 * 0.01, 2)
		ld_totaltax = round(ld_invtaxperc1val + ld_totalitemleveltax, li_roundupto)
		ld_grandtotal = round(ld_grandtotal, li_roundupto) + ld_totaltax
		ld_totaldiscount = ld_totaldiscount + ld_discountvalue + lr_flatdisc
		this.id_master.setitem(al_row, "invtotal", ld_grandtotal)
		if ad_grandtotal = 0.0 then
			ad_grandtotal = 1
		end if
		ld_cashcharged = round(ld_grandtotal / ad_grandtotal * ad_cashcharged, 2)
		this.id_master.object.cashtendered[al_row] = ld_cashcharged
		this.id_master.object.cashcharged[al_row] = ld_cashcharged
		this.id_master.object.cashback[al_row] = 0.00
		ld_outstandingamt = ld_grandtotal - ld_cashcharged
		if ld_outstandingamt < 0.0 then
			ld_outstandingamt = 0
		end if
		this.id_master.setitem(al_row, "outstandingamt", ld_outstandingamt)
		this.id_detail.setfilter("")
		this.id_detail.filter()
	end if
	return ld_grandtotal

// w_sale.wf_refetch_price_for_salestax_extraction(long al_icode, long al_custcode, long al_row) returns long
	long ll_counter
	long ll_dayslimit
	double ld_custgst
	double ld_gstperc1
	double ld_gstperc2
	double ld_itemdiscperc
	double ld_itemdiscperc2
	double ld_itemdiscperc3
	double ld_itemdiscperc4
	double ld_saleprice1
	double ld_saleprice2
	double ld_saleprice3
	double ld_invdiscperc
	double ld_retailprice
	double ld_saleprice4
	double ld_saleprice5
	double ld_itemdiscperc5
	double ld_custitemcatdiscperc
	double ld_itemflatdisc
	double ld_customerbalance
	double ld_avgprice
	double ld_purunitrate
	double ld_rppunitrate
	double ld_purprice
	double ld_rpp
	integer li_salepriceno
	integer li_itemdiscpercno
	integer li_packunits
	integer li_smancode
	integer li_null
	integer li_option
	integer li_saletypecode
	boolean lb_setiteminfo
	string ls_null
	string ls_aliasname
	string ls_printwaranty
	string ls_printbalance
	setnull(li_null)
	setnull(ls_null)
	if this.ib_apply_stax_schedule_on_unit_stax = false then
		return 0
	end if
	if isnull(al_custcode) then
		return 0
	end if
	if isnull(al_custcode) then
		messagebox("Database Error", "Customer information can not be retrieved")
		return 1
	end if
	if this.id_master.accepttext() = -1 then
		return 1
	end if
	setredraw(false)
	if f_stringpreferences("setcustwiseiteminfo") = "Y" then
		lb_setiteminfo = true
	end if
	if lb_setiteminfo = true then
		SQL SELECT cust.defaultgst , cust.defaultsaleprice , cust.defaultitemdiscperc , acc.aliasname , cust.saletypecode INTO :ld_custgst, :li_salepriceno, :li_itemdiscpercno, :ls_aliasname, :li_saletypecode FROM customer cust , accounts acc WHERE cust.custcode =:al_custcode AND cust.custcode =acc.acccode USING this.it_transobject;
		if this.it_transobject.sqlcode = -1 then
			messagebox("Database Error", "Customer information can not be retrieved")
			return 1
		end if
		if this.idc_price.find("pricetypecode = " + trim(string(li_salepriceno)), 1, this.idc_price.rowcount()) > 0 then
			this.id_master.setitem(1, "sprice", li_salepriceno)
		else
			messagebox("Price Implementation Problem", "Your Group Wise Allowed Price Setting does not allow you to ~r~napply Default Associated Price For this customer.~r~nHowever System has decided to apply appropriate price automatcially", information!)
			this.id_master.setitem(1, "sprice", this.idc_price.getitemnumber(1, "pricetypecode"))
		end if
		SQL SELECT item.gstperc1 , item.gstperc2 , item.salediscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 , item.saleprice , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.packunits , item.avgprice , PurUnitRate =round ( item.purprice / item.packunits , 2 ) , RppUnitRate =round ( item.recentpurprice / item.packunits , 2 ) , item.PurPrice , item.RecentPurPrice INTO :ld_gstperc1, :ld_gstperc2, :ld_itemdiscperc, :ld_itemdiscperc2, :ld_itemdiscperc3, :ld_itemdiscperc4, :ld_itemdiscperc5, :ld_saleprice1, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :li_packunits, :ld_avgprice, :ld_purunitrate, :ld_rppunitrate, :ld_purprice, :ld_rpp FROM item WHERE item.icode =:al_icode USING this.it_transobject;
		if this.it_transobject.sqlcode = -1 then
			messagebox("Database Error", "Item information can not be retrieved")
			return 1
		end if
		choose case li_salepriceno
		case 1
			this.id_detail.setitem(al_row, "rate", ld_saleprice1 / li_packunits)
			this.id_detail.setitem(al_row, "saleprice", ld_saleprice1 / li_packunits)
			this.id_detail.setitem(al_row, "packprice", ld_saleprice1)
		case 2
			if this.is_reportratedeviationusing = "A" then
				this.id_detail.setitem(al_row, "rate", ld_saleprice2 / li_packunits)
			else
				this.id_detail.setitem(al_row, "rate", ld_saleprice1 / li_packunits)
			end if
			this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / li_packunits)
			this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
		case 3
			if this.is_reportratedeviationusing = "A" then
				this.id_detail.setitem(al_row, "rate", ld_saleprice3 / li_packunits)
			else
				this.id_detail.setitem(al_row, "rate", ld_saleprice1 / li_packunits)
			end if
			this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / li_packunits)
			this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
		case 4
			if this.is_reportratedeviationusing = "A" then
				this.id_detail.setitem(al_row, "rate", ld_purprice / li_packunits)
			else
				this.id_detail.setitem(al_row, "rate", ld_saleprice1 / li_packunits)
			end if
			this.id_detail.setitem(al_row, "packsaleprice", ld_purprice)
			this.id_detail.setitem(al_row, "packprice", ld_purprice)
			this.id_detail.setitem(al_row, "saleprice", ld_purprice / li_packunits)
		case 5
			if this.is_reportratedeviationusing = "A" then
				this.id_detail.setitem(al_row, "rate", ld_rpp / li_packunits)
			else
				this.id_detail.setitem(al_row, "rate", ld_saleprice1 / li_packunits)
			end if
			this.id_detail.setitem(al_row, "packsaleprice", ld_rpp)
			this.id_detail.setitem(al_row, "packprice", ld_rpp)
			this.id_detail.setitem(al_row, "saleprice", ld_rpp / li_packunits)
		case 7
			if this.is_reportratedeviationusing = "A" then
				this.id_detail.setitem(al_row, "rate", ld_saleprice4 / li_packunits)
			else
				this.id_detail.setitem(al_row, "rate", ld_saleprice1 / li_packunits)
			end if
			this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice4)
			this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
			this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / li_packunits)
		case 8
			if this.is_reportratedeviationusing = "A" then
				this.id_detail.setitem(al_row, "rate", ld_saleprice5 / li_packunits)
			else
				this.id_detail.setitem(al_row, "rate", ld_saleprice1 / li_packunits)
			end if
			this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice5)
			this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
			this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / li_packunits)
		case else
			if this.is_reportratedeviationusing = "A" then
				this.id_detail.setitem(al_row, "rate", ld_avgprice)
			else
				this.id_detail.setitem(al_row, "rate", ld_saleprice1 / li_packunits)
			end if
			this.id_detail.setitem(al_row, "retailprice", ld_retailprice / li_packunits)
			this.id_detail.setitem(al_row, "packsaleprice", ld_avgprice * li_packunits)
			this.id_detail.setitem(al_row, "packprice", ld_avgprice * li_packunits)
			this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
		end choose
	else
		SQL SELECT item.saleprice , item.packunits , item.retailprice INTO :ld_saleprice1, :li_packunits, :ld_retailprice FROM item WHERE item.icode =:al_icode USING this.it_transobject;
		if this.it_transobject.sqlcode = -1 then
			messagebox("Database Error", "Item information can not be retrieved")
			return 1
		end if
		this.id_detail.setitem(al_row, "retailprice", ld_retailprice / li_packunits)
		this.id_detail.setitem(al_row, "rate", ld_saleprice1 / li_packunits)
		if this.id_detail.object.clonesaleprice[al_row] > 0 then
			this.id_detail.setitem(al_row, "saleprice", this.id_detail.object.clonesaleprice[al_row])
		else
			this.id_detail.setitem(al_row, "saleprice", ld_saleprice1 / li_packunits)
		end if
		this.id_detail.setitem(al_row, "packprice", ld_saleprice1)
	end if
	setredraw(true)
	return 0

// w_sale.wf_enforce_saleorderdetailsonsaving() returns long
	datastore lds_saleorderdetail
	datastore lds_saleorderheader
	long ll_option
	long ll_saleordercode
	long[] ll_so
	long ll_counter
	long ll_saleorderrowid
	long ll_found
	long ll_code
	double ld_tmpqty
	double ld_tmpbonus
	double ld_looseqty
	double ld_bonusqty
	char lc_so
	string ls_column
	boolean lb_abort
	lc_so = f_stringpreferences("SaleOrderCompulsionInSales")
	if lc_so = "Y" then
		ll_saleordercode = this.id_master.object.saleordercode[1]
		if isnull(ll_saleordercode) or ll_saleordercode <= 0 then
			messagebox("Sale Order Compulsion", "Sale Invoice Can not be saved without a valid sale order Reference.~r~nPlease populate valid sale order using option [File->Edit Sale Order]", stopsign!)
			return 1
		end if
		ll_option = f_numberpreferences("EnforceSODetailsOnSaving")
		if ll_option > 1 then
			lds_saleorderdetail = create datastore
			lds_saleorderheader = create datastore
			lds_saleorderdetail.dataobject = "d_SaleOrderdetail_sales"
			lds_saleorderdetail.settransobject(this.it_transobject)
			ll_so[1] = ll_saleordercode
			lds_saleorderdetail.retrieve(ll_so, 1)
			for ll_counter = 1 to this.id_detail.rowcount()
				ll_saleorderrowid = this.id_detail.object.saleorderrowid[ll_counter]
				ll_found = 0
				if ll_saleorderrowid > 0 then
					ll_found = lds_saleorderdetail.find("rowid = " + string(ll_saleorderrowid), 1, lds_saleorderdetail.rowcount())
					if ll_found > 0 and ll_found <= lds_saleorderdetail.rowcount() then
						if ll_option = 2 or ll_option = 5 or ll_option = 6 or ll_option = 7 then
							ll_code = this.id_master.object.code[1]
							SQL SELECT ISNULL ( sum ( looseqty ) , 0 ) , ISNULL ( sum ( bonusqty ) , 0 ) INTO :ld_tmpqty, :ld_tmpbonus FROM SaleDetail WHERE SaleOrderRowID =:ll_saleorderrowid AND SaleInvCode =:ll_code USING this.it_transobject;
							if ld_tmpqty <= 0.0 or isnull(ld_tmpqty) then
								ld_tmpqty = 0
							end if
							if ld_tmpbonus <= 0.0 or isnull(ld_tmpbonus) then
								ld_tmpbonus = 0
							end if
							ld_looseqty = lds_saleorderdetail.getitemnumber(ll_found, "looseqty") - lds_saleorderdetail.getitemnumber(ll_found, "saleqty") + ld_tmpqty
							ld_bonusqty = lds_saleorderdetail.getitemnumber(ll_found, "bonusqty") - lds_saleorderdetail.getitemnumber(ll_found, "salebonus") + ld_tmpbonus
							if this.id_detail.object.looseqty[ll_counter] > ld_looseqty then
								messagebox("Sale Order Enforcement", "Row No. " + trim(string(ll_counter)) + ", item sale qty exceeds remaing sale order qty.")
								lb_abort = true
								ls_column = "looseqty"
								exit
							end if
							if this.id_detail.object.bonusqty[ll_counter] > ld_bonusqty then
								goto L1548
							end if
							messagebox("Sale Order Enforcement", "Row No. " + trim(string(ll_counter)) + ", item bonus qty exceeds remaing sale order qty.")
							lb_abort = true
							ls_column = "bonusqty"
							exit
						end if
						if (ll_option = 3 or ll_option = 5 or ll_option = 7 or ll_option = 8) and this.id_detail.object.saleprice[ll_counter] <> lds_saleorderdetail.object.saleprice[ll_found] then
							messagebox("Sale Order Enforcement", "Row No. " + trim(string(ll_counter)) + ", item sale price does not match sale order details")
							lb_abort = true
							ls_column = "saleprice"
							exit
						end if
						if ll_option = 4 or ll_option = 6 or ll_option = 7 or ll_option = 8 then
							if this.id_detail.object.itemflatdisc[ll_counter] <> lds_saleorderdetail.object.itemflatdisc[ll_found] then
								messagebox("Sale Order Enforcement", "Row No. " + trim(string(ll_counter)) + ", item flat discount does not match sale order details")
								lb_abort = true
								ls_column = "itemflatdisc"
								exit
							end if
							if this.id_detail.object.discperc[ll_counter] <> lds_saleorderdetail.object.discperc[ll_found] then
								goto L2438
							end if
							messagebox("Sale Order Enforcement", "Row No. " + trim(string(ll_counter)) + ", item discount % does not match sale order details")
							lb_abort = true
							ls_column = "discperc"
							exit
						end if
					else
						messagebox("Sale Order Enforcement", "Row No. " + trim(string(ll_counter)) + " is not valid sale order row")
						lb_abort = true
						ls_column = "looseqty"
						exit
					end if
				else
					messagebox("Sale Order Enforcement", "Row No. " + trim(string(ll_counter)) + " is not valid sale order row")
					lb_abort = true
					ls_column = "looseqty"
					exit
				end if
			next
			if lb_abort and ll_counter > 0 then
				this.id_detail.setfocus()
				this.id_detail.setcolumn(ls_column)
				this.id_detail.setrow(ll_counter)
				this.id_detail.scrolltorow(ll_counter)
				return 1
			end if
			return 0
		end if
		return
	end if
	return 0

// w_sale.wf_print_dc_taxinv_invoice() returns long
	long ll_found
	s_datastore lstr
	if this.tab_retrieve.selectedtab = 1 then
		return 0
	end if
	if this.tab_retrieve.selectedtab = 2 and this.id_list.getrow() > 0 then
		lstr.s_module = "rangeprint_withsummary"
		lstr.s_name1 = "d_comp_dc_txinv_invoice"
		lstr.d_value = this.id_list.object.code[this.id_list.getrow()]
		openwithparm(w_preview_invoices2, lstr)
		lstr = message.powerobjectparm
	end if
	return 0

// w_sale.wf_apply_special_price(long al_priceno) returns long
	long ll_row
	long ll_icode
	double ld_price
	ll_row = this.id_detail.getrow()
	if ll_row > 0 and al_priceno > 0 then
		ll_icode = this.id_detail.object.icode[ll_row]
		if ll_icode > 0 then
			SQL SELECT Price =ROUND ( ( CASE :al_priceno WHEN 2 THEN item.Saleprice2 WHEN 3 THEN item.Saleprice3 WHEN 4 THEN item.Saleprice4 WHEN 5 THEN item.Saleprice5 ELSE item.Saleprice END ) / CASE WHEN ISNULL ( Item.PackUnits , 0 ) =0 THEN 1 ELSE Item.PackUnits END , 2 ) INTO :ld_price FROM DBO.Item WHERE ICode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				this.id_detail.object.saleprice[ll_row] = round(ld_price, 2)
				this.id_detail.object.taxflag[ll_row] = 0
			end if
		end if
	end if
	return 0

// w_sale.wf_setcustomerlatestnetrate(long al_custcode, long al_icode, long al_row) returns long
	integer li_rowsaffected
	double ld_netrate
	if f_stringpreferences("ShowCustomerLatestNetRateInFooter") = "Y" and al_icode > 0 and al_custcode > 19 and al_row > 0 then
		li_rowsaffected = 0
		this.it_transobject.fetchcustomerlatestnetrate(al_custcode, al_icode, ld_netrate, li_rowsaffected)
		if this.it_transobject.sqlcode = 0 then
			if li_rowsaffected > 0 then
				this.id_footer.object.latestnetrate[1] = round(ld_netrate, 2)
				this.id_detail.object.latestnetrate[al_row] = round(ld_netrate, 2)
			end if
		else
			messagebox("Customer Latest NetRate Error", "Unable to Fetch Customer Latest Net Rate due to some problem.~r~nDetails Are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
			return -1
		end if
		return 1
	end if
	return 0

// w_sale.wf_patientsearch() returns string
	string ls_regno
	long ll_res
	long ll_null
	long ll_patientcode
	s_arguements ls_arguements
	setnull(ll_null)
	open(w_patientsearch)
	ls_arguements = message.powerobjectparm
	if ls_arguements.i_status = 1 then
		openwithparm(w_patientsearchresult, ls_arguements)
		ls_arguements = message.powerobjectparm
		if ls_arguements.i_status = 1 and ls_arguements.l_code1 > 0 then
			this.id_master.object.patientregno[1] = ls_arguements.s_name1
			this.id_master.object.patientcode[1] = ls_arguements.l_code1
			this.id_master.object.custcode[1] = ls_arguements.l_code4
			ll_patientcode = ls_arguements.l_code1
			wf_setpatientinfo(ll_patientcode)
			ls_regno = this.id_master.object.patientregno[1]
			wf_validate_patient_from_outside(ls_regno)
		end if
	end if
	return ls_regno

// w_sale.wf_show_agingdetail() returns long
	long ll_acccode
	datetime ldt_date
	s_datastore lstr_ds
	datastore lds_aging
	if wf_iseditable() = false then
		return 0
	end if
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_acccode = this.id_master.object.custcode[this.id_master.getrow()]
			ldt_date = this.id_master.object.date[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_acccode = this.id_list.object.custcode[this.id_list.getrow()]
		ldt_date = this.id_list.object.date[this.id_list.getrow()]
	end if
	if not isnull(ll_acccode) and ll_acccode <> 0 then
		SQL rollback USING sqlca;
		sqlca.agingdetail("C", ldt_date, 30, 180, ll_acccode)
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		lds_aging = create datastore
		lds_aging.dataobject = "d_agingdetail"
		lds_aging.settransobject(sqlca)
		lds_aging.retrieve(ldt_date, 30, 180, "C", ll_acccode)
		if lds_aging.rowcount() > 0 then
			lstr_ds.ds = lds_aging
			lstr_ds.s_name1 = lds_aging.dataobject
			lstr_ds.d_value = 1
			openwithparm(w_preview_invoices, lstr_ds)
		end if
	end if
	return 0

// w_sale.wf_fetch_lockedstock(long al_icode, ref double ad_lockedstock) returns integer
	double ld_lockedstock
	SQL SELECT ISNULL ( SUM ( currqty ) , 0 ) INTO :ld_lockedstock FROM GodownDetail WHERE ICode =:al_icode AND Locked ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		ad_lockedstock = 0
	else
		ad_lockedstock = ld_lockedstock
	end if
	return 0

// w_sale.wf_fiscalizesaleinvoice() returns long
	long ll_saleinvcode
	string ls_fiscalized
	string ls_posted
	if this.tab_retrieve.selectedtab = 2 and this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 then
		ll_saleinvcode = this.id_list.object.code[this.id_list.getrow()]
		SQL SELECT Fiscalized , Posted INTO :ls_fiscalized, :ls_posted FROM SaleLedger WHERE SaleInvCode =:ll_saleinvcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 and (ls_posted = "Y" and ls_fiscalized = "N") then
			f_fiscalizesaleinvoice(ll_saleinvcode)
		end if
	end if
	return 0

// w_sale.wf_fiscalizesaleinvoices() returns long
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	long ll_saleinvcode
	long ll_rows
	string ls_fiscalized
	string ls_posted
	datastore lds_invoices
	if this.tab_retrieve.selectedtab = 2 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
		if ll_salesmancode > 0 then
			open(w_arg_sinvcode_linvcode_sales)
			lstr_arginfo = message.powerobjectparm
			if lstr_arginfo.i_status = 1 and lstr_arginfo.l_code1 <= lstr_arginfo.l_code2 then
				setpointer(hourglass!)
				lds_invoices = create datastore
				lds_invoices.dataobject = "d_saleinvlist_notfiscalized"
				lds_invoices.settransobject(this.it_transobject)
				ll_rows = lds_invoices.retrieve(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
				if ll_rows > 0 then
					for ll_counter = 1 to ll_rows
						ll_saleinvcode = lds_invoices.object.saleinvcode[ll_counter]
						if ll_saleinvcode > 0 then
							SQL SELECT Fiscalized , Posted INTO :ls_fiscalized, :ls_posted FROM SaleLedger WHERE SaleInvCode =:ll_saleinvcode USING this.it_transobject;
							if this.it_transobject.sqlcode = 0 and (ls_posted = "Y" and ls_fiscalized = "N") then
								f_fiscalizesaleinvoice(ll_saleinvcode)
								ll_saleinvcount = ll_saleinvcount + 1
							end if
						end if
					next
					if ll_saleinvcount > 0 then
						messagebox("Fiscalization Completed", "Total Sales Invoices were : " + trim(string(ll_rows)) + "~r~nFiscalized Successfully : " + trim(string(ll_saleinvcount)))
					end if
				end if
			end if
		else
			setfocus()
		end if
	end if
	return 0

// w_sale.wf_populate_document(long al_code) returns long
	long ll_counter
	long ll_rowcount
	long ll_code
	ll_rowcount = this.dw_document.rowcount()
	if ll_rowcount <= 0 then
		return 0
	end if
	if isnull(al_code) or al_code <= 0 then
		return 0
	end if
	ll_code = this.dw_document.object.code[1]
	for ll_counter = 1 to ll_rowcount
		this.istr_document.ls_value[ll_counter, 1] = trim(string(this.dw_document.object.rowid[ll_counter]))
		this.istr_document.ls_value[ll_counter, 2] = this.dw_document.object.docdescription[ll_counter]
		this.istr_document.ls_value[ll_counter, 3] = this.dw_document.object.documenttype[ll_counter]
		wf_get_document(ll_counter, al_code)
	next
	return 0

// w_sale.wf_get_document(long al_row, long al_code) returns long
	blob lbl_image
	u_transaction lt_transobject
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server")
		destroy lt_transobject
		return -1
	end if
	SQL SelectBlob Document INTO :lbl_image From SaleDocument Where SaleInvCode =:al_code AND RowID =:al_row USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Sale Document/Image/Picture ", "Unable to fetch Sale Document/Image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	this.istr_document.blob[al_row] = lbl_image
	return 0

// w_sale.wf_set_saledocument() returns long
	long ll_counter
	long ll_code
	long ll_row
	long ll_null
	s_itemimage lstr_document
	lstr_document.s_caller = "SV"
	setnull(ll_null)
	if this.tab_retrieve.selectedtab = 1 then
		return 0
	elseif this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 then
		this.istr_document = this.istr_blank_document
		ll_code = this.id_list.object.code[this.id_list.getrow()]
		if ll_code > 0 then
			this.dw_document.retrieve(ll_code)
			wf_populate_document(ll_code)
			for ll_counter = 1 to this.dw_document.rowcount()
				lstr_document.ls_value[ll_counter, 1] = trim(string(this.dw_document.object.rowid[ll_counter]))
				lstr_document.ls_value[ll_counter, 2] = this.dw_document.object.docdescription[ll_counter]
				lstr_document.ls_value[ll_counter, 3] = this.dw_document.object.documenttype[ll_counter]
				lstr_document.blob[ll_counter] = this.istr_document.blob[ll_counter]
			next
			openwithparm(w_saledocument, lstr_document)
			lstr_document = message.powerobjectparm
			if lstr_document.i_closemode = 1 then
				this.istr_document = lstr_document
				this.dw_document.reset()
				for ll_counter = 1 to 200
					if long(lstr_document.ls_value[ll_counter, 1]) > 0 then
						ll_row = this.dw_document.insertrow(0)
						this.dw_document.object.code[ll_row] = ll_code
						this.dw_document.object.rowid[ll_row] = long(lstr_document.ls_value[ll_counter, 1])
						this.dw_document.object.docdescription[ll_row] = lstr_document.ls_value[ll_counter, 2]
						this.dw_document.object.documenttype[ll_row] = lstr_document.ls_value[ll_counter, 3]
					end if
				next
				if wf_update_document(ll_code) = 0 then
					this.dw_document.reset()
					this.istr_document = this.istr_blank_document
				end if
			end if
		end if
	end if
	return 0

// w_sale.wf_show_documentgallery() returns long
	long ll_code
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_code = this.id_master.object.code[this.id_master.getrow()]
		end if
	elseif this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
	end if
	if ll_code > 0 then
		openwithparm(w_saledocument_gallery, ll_code)
	end if
	return 0

// w_sale.wf_update_document(long al_code) returns long
	long ll_counter
	long ll_rowid
	long ll_null
	string ls_desc
	string ls_imgtype
	u_transaction lt_transobject
	setnull(ll_null)
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server for updating/inserting in SaleDocument Table")
		destroy lt_transobject
		return -1
	end if
	SQL DELETE SaleDocument WHERE SaleInvCode =:al_code USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to Delete Previous Sale Document Record from database")
		destroy lt_transobject
		return -1
	end if
	for ll_counter = 1 to this.dw_document.rowcount()
		ll_rowid = this.dw_document.object.rowid[ll_counter]
		ls_desc = this.dw_document.object.docdescription[ll_counter]
		ls_imgtype = this.dw_document.object.documenttype[ll_counter]
		SQL INSERT INTO SaleDocument ( SaleInvCode , docDescription , RowID , documentType ) VALUES ( :al_code , :ls_desc , :ll_rowid , :ls_imgtype ) USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Insert Error", "Unable to Insert Sale Documents Into SaleDocument Table.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
			SQL stop USING lt_transobject;
			destroy lt_transobject
			return -1
		end if
		SQL UpdateBlob SaleDocument Set Document =:this.istr_document.blob[ll_counter] Where SaleInvCode =:al_code and ROWID =:ll_rowid USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Sale Document ", "Unable to update SaleDocument.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		end if
	next
	SQL stop USING lt_transobject;
	destroy lt_transobject
	return 0

// w_sale.wf_apply_customized_gstperc() returns long
	datastore lds_saledetail
	long ll_detailrows
	long ll_icode
	long ll_custcode
	long ll_counter
	string ls_errortext
	boolean lb_enablesave
	boolean lb_bonus
	double ld_saleprice
	double ld_gstperc
	s_arguements lstr_arg
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.rowcount() > 0 and (this.id_master.object.code[1] > 0 and this.id_master.object.posted[1] = "Y") then
		return 0
	end if
	open(w_arg_gstperc)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = -1 then
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows <= 0 then
		return 0
	end if
	ld_gstperc = lstr_arg.db_code1
	if ld_gstperc < 0.0 or isnull(ld_gstperc) then
		return 0
	end if
	for ll_counter = 1 to ll_detailrows
		this.id_detail.object.unitsalestax[ll_counter] = round(this.id_detail.object.saleprice[ll_counter] * ld_gstperc * 0.01, 2)
	next
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return 0

// w_sale.wf_apply_progressive_discounts(integer ai_mode) returns long
	return 1

// w_sale.wf_settle_payment_via_api(integer ai_mode) returns long
	long ll_custcode
	long ll_saleinvcode
	long ll_retcode
	long ll_statuscode
	double ld_amount
	string ls_posted
	string ls_paymentapi
	string ls_patientregno
	string ls_transcode
	string ls_otp
	string ls_paidviaapi
	string ls_statustext
	if f_stringpreferences("UseCustomerPaymentAPI") = "Y" then
		if ai_mode = 0 then
			ll_custcode = this.id_master.object.custcode[1]
			ls_patientregno = this.id_master.object.patientregno[1]
			ll_saleinvcode = this.id_master.object.code[1]
			ld_amount = wf_grandtotal()
			ls_paidviaapi = this.id_master.object.paidviaapi[1]
		elseif this.id_list.getrow() > 0 then
			ll_custcode = this.id_list.object.custcode[this.id_list.getrow()]
			ls_patientregno = this.id_list.object.patientregno[this.id_list.getrow()]
			ll_saleinvcode = this.id_list.object.code[this.id_list.getrow()]
			ld_amount = this.id_list.object.netamount[this.id_list.getrow()]
			ls_paidviaapi = this.id_list.object.paidviaapi[this.id_list.getrow()]
			ls_posted = this.id_list.object.posted[this.id_list.getrow()]
			SQL SELECT PaidViaAPI INTO :ls_paidviaapi FROM SaleLedger WHERE SaleInvCode =:ll_saleinvcode USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				ll_retcode = -1
				ls_statustext = this.it_transobject.sqlerrtext
			end if
		else
			ll_retcode = 0
		end if
		if ls_posted = "Y" and ll_custcode > 0 and len(ls_patientregno) > 0 and ll_saleinvcode > 0 and ld_amount > 0.0 and ls_paidviaapi = "N" then
			SQL SELECT PaymentAPI INTO :ls_paymentapi FROM Customer WHERE CustCode =:ll_custcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if isnull(ls_paymentapi) then
					ll_retcode = 0
				elseif ls_paymentapi = "MEDASK" then
					ll_retcode = f_makepayment_medask(ls_patientregno, ld_amount, ls_transcode, ls_otp, ll_statuscode, ls_statustext)
					if ll_retcode = 1 and (len(ls_transcode) > 0 and len(ls_otp) > 0) then
						if ai_mode = 0 then
							this.id_master.object.paidviaapi[1] = "Y"
							this.id_master.object.paymentapi[1] = ls_paymentapi
							this.id_master.object.paymentapitranno[1] = ls_transcode
							this.id_master.object.paymentapiotp[1] = ls_otp
						else
							SQL update SaleLedger SET PaidViaAPI ='Y' , PaymentAPI =:ls_paymentapi , PaymentAPITranNo =:ls_transcode , PaymentAPIOTP =:ls_otp WHERE SaleInvCode =:ll_saleinvcode AND PaidViaAPI ='N' AND Posted ='Y' USING this.it_transobject;
							if this.it_transobject.sqlcode = 0 then
								SQL commit USING this.it_transobject;
								ll_retcode = 1
							end if
						end if
					end if
				end if
			else
				ll_retcode = 1
			end if
		else
			ll_retcode = 1
		end if
	end if
	if len(trim(ls_statustext)) > 0 then
		messagebox("Web Service Request", ls_statustext)
	end if
	return ll_retcode

// w_sale.wf_set_doctorinfo(long al_doctcode) returns long
	long ll_headerno
	if long(this.id_master.object.headerno.visible) = 0 and al_doctcode > 0 then
		SQL SELECT HeaderNo INTO :ll_headerno FROM Doctors WHERE DoctCode =:al_doctcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.id_master.object.headerno[1] = ll_headerno
		end if
	end if
	return 0

// w_sale.wf_update_patient_mobileno1_from_remarks() returns integer
	long ll_patientcode
	string ls_mobileno1
	if f_stringpreferences("UpdatePatientMobileNo1FromRemarks") = "Y" then
		ll_patientcode = this.id_master.object.patientcode[1]
		ls_mobileno1 = trim(this.id_master.object.remarks[1])
		if isnull(ls_mobileno1) then
			ls_mobileno1 = ""
		end if
		if ll_patientcode > 0 and len(ls_mobileno1) > 0 then
			SQL update Patient SET MobileNo1 =:ls_mobileno1 WHERE PatientCode =:ll_patientcode USING this.it_transobject;
		end if
	end if
	return 0

// w_sale.wf_unfiscalize() returns 0
	long ll_code
	string ls_errtext
	string ls_eventtype
	string ls_module
	string ls_detail
	ls_eventtype = "Information"
	ls_module = "Sales"
	ls_detail = "Un-Fiscalized Sale Invoice # "
	if this.tab_retrieve.selectedtab = 1 then
		return
	end if
	if wf_iseditable() then
		return
	end if
	if gl_usercode <> 1 then
		return
	end if
	if this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
	end if
	if ll_code > 0 and this.id_list.object.posted[this.id_list.getrow()] = "Y" and this.id_list.object.fiscalized[this.id_list.getrow()] = "Y" then
		SQL update SaleLedger SET Fiscalized ='N' WHERE SaleInvCode =:ll_code USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			ls_detail = ls_detail + trim(string(ll_code))
			this.it_transobject.insert_eventlog(ls_eventtype, ls_module, ls_detail, gl_usercode)
			SQL commit USING this.it_transobject;
			messagebox("Fiscalization", "Successfully Un-Fiscalized Sale Invoice No. " + trim(string(ll_code)), information!)
		else
			ls_errtext = this.it_transobject.sqlerrtext
			SQL rollback USING this.it_transobject;
			messagebox("Fiscalization Problem", "Unable to Un-Fiscalize Sale Invoice~r~nReasons are:-~r~n" + ls_errtext, stopsign!)
			return
		end if
		return
	end if

// w_sale.wf_find_motorvehiclecode(string as_chasisno, ref long al_code) returns long
	long ll_motorvehiclecode
	long ll_retflag
	ll_retflag = 0
	SQL SELECT motorvehiclecode INTO :ll_motorvehiclecode FROM motorvehicle WHERE chasisno =:as_chasisno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_code = ll_motorvehiclecode
		if isnull(al_code) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_sale.wf_set_motorvehicleinfo(long al_code) returns long
	long ll_custcode
	long ll_retcode
	string ls_chasisno
	string ls_aliasname
	SQL SELECT MotorVehicle.ChasisNo , MotorVehicle.CustCode , Accounts.AliasName INTO :ls_chasisno, :ll_custcode, :ls_aliasname FROM MotorVehicle , Accounts WHERE MotorVehicle.MotorVehicleCode =:al_code AND MotorVehicle.CustCode =Accounts.AccCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.setitem(this.id_master.rowcount(), "chasisno", ls_chasisno)
		this.id_master.setitem(this.id_master.rowcount(), "custcode", ll_custcode)
		this.id_master.setitem(this.id_master.rowcount(), "aliasname", ls_aliasname)
		this.id_master.object.custcode.protect = 1
		this.id_master.object.aliasname.protect = 1
		ll_retcode = 1
	else
		messagebox("Motor Vehicle Information", "Problem in retrieving corresponding customer")
		ll_retcode = 0
	end if
	return ll_retcode

// w_sale.wf_motorvehicle_retrieve() returns long
	long ll_row
	long ll_code
	this.idc_motorvehicle.settransobject(this.it_transobject)
	this.idc_motorvehicle.retrieve()
	ll_row = this.idc_motorvehicle.insertrow(0)
	setnull(ll_code)
	this.idc_motorvehicle.setitem(ll_row, "code", ll_code)
	this.idc_motorvehicle.setitem(ll_row, "chasisno", "<NONE>")
	this.idc_motorvehicle.setitem(ll_row, "motorvehicle", "<NONE>")
	this.idc_motorvehicle.setitem(ll_row, "customer", "<NONE>")
	this.idc_motorvehicle.scrolltorow(ll_row)
	return 0

// w_sale.wf_new_motorvehicle() returns long
	string ls_chasisno
	long ll_motorvehiclecode
	long ll_found
	long ll_row
	dwobject dwo
	open(w_motorvehicle)
	ls_chasisno = message.stringparm
	if len(ls_chasisno) > 0 then
		wf_motorvehicle_retrieve()
		ll_found = 0
		ll_found = this.idc_motorvehicle.find("chasisno = '" + ls_chasisno + "'", 1, this.idc_motorvehicle.rowcount())
		if ll_found > 0 then
			this.id_master.setitem(1, "chasisno", this.idc_motorvehicle.getitemstring(ll_found, "chasisno"))
			ll_motorvehiclecode = this.idc_motorvehicle.getitemnumber(ll_found, "code")
			this.id_master.setitem(1, "motorvehiclecode", ll_motorvehiclecode)
			dwo = this.id_master.object.motorvehiclecode
			this.id_master.post event itemchanged(1, dwo, string(ll_motorvehiclecode))
		end if
	end if
	return 0

// w_sale.wf_motorvehiclesearch() returns string
	string ls_chasisno
	long ll_res
	long ll_null
	long ll_code
	s_arguements ls_arguements
	setnull(ll_null)
	open(w_vehiclesearch)
	ls_arguements = message.powerobjectparm
	if ls_arguements.i_status = 1 then
		openwithparm(w_vehiclesearchresult, ls_arguements)
		ls_arguements = message.powerobjectparm
		if ls_arguements.i_status = 1 and ls_arguements.l_code1 > 0 then
			this.id_master.object.chasisno[1] = ls_arguements.s_name1
			this.id_master.object.motorvehiclecode[1] = ls_arguements.l_code1
			this.id_master.object.custcode[1] = ls_arguements.l_code2
			ll_code = ls_arguements.l_code1
			wf_set_motorvehicleinfo(ll_code)
			ls_chasisno = this.id_master.object.chasisno[1]
		end if
	end if
	return ls_chasisno

// w_sale.wf_show_branch_itemstockposition() returns long
	s_itemsalehistory ls_itemsalehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itemsalehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		if ls_itemsalehistory.ar_icode > 0 then
			openwithparm(w_crs_branch_itemstockposition, ls_itemsalehistory)
		end if
	end if
	return 0

// w_sale.wf_link_to_cashiershift() returns long
	long ll_cashiershiftcode
	if f_stringpreferences("CashierShift") = "Y" then
		this.id_master.object.cashiershiftcode.visible = true
		SQL SELECT MAX ( A.CashierShiftCode ) INTO :ll_cashiershiftcode FROM ( SELECT CashierShiftCode =CashierShiftCode FROM CashierShift WHERE ShiftStatus ='O' AND ShiftOwner =:gl_usercode UNION SELECT CashierShiftCode =CashierShiftCode FROM CashierShiftUsers WHERE UserCode =:gl_usercode AND CashierShiftCode IN ( SELECT CashierShiftCode FROM CashierShift WHERE ShiftStatus ='O' ) ) A USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if ll_cashiershiftcode < 0 then
				ll_cashiershiftcode = -1
			end if
		else
			ll_cashiershiftcode = -1
		end if
	else
		ll_cashiershiftcode = -1
	end if
	if ll_cashiershiftcode = -1 then
		setnull(ll_cashiershiftcode)
	end if
	this.id_master.object.cashiershiftcode[1] = ll_cashiershiftcode
	return 0

// w_sale.wf_check_cashiershift_on_saving(long al_cashiershiftcode, long al_usercode) returns long
	long ll_cashiershiftcode
	long ll_cashacccode
	if f_stringpreferences("CashierShift") = "Y" then
		this.id_master.object.cashiershiftcode.visible = true
		SQL SELECT MAX ( A.CashierShiftCode ) INTO :ll_cashiershiftcode FROM ( SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND ShiftOwner =:al_usercode AND CashierShiftCode =:al_cashiershiftcode UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShiftUsers WHERE UserCode =:al_usercode AND CashierShiftCode IN ( SELECT MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND CashierShiftCode =:al_cashiershiftcode ) UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND ShiftOwner =:al_usercode UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShiftUsers WHERE UserCode =:al_usercode AND CashierShiftCode IN ( SELECT MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' ) ) A USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if ll_cashiershiftcode < 0 then
				ll_cashiershiftcode = -1
			end if
		else
			ll_cashiershiftcode = -1
		end if
	else
		ll_cashiershiftcode = -1
	end if
	if ll_cashiershiftcode = -1 then
		setnull(ll_cashiershiftcode)
	end if
	this.id_master.object.cashiershiftcode[1] = ll_cashiershiftcode
	if ll_cashiershiftcode > 0 then
		SQL SELECT CashAccCode INTO :ll_cashacccode FROM CashierShift WHERE CashierShiftCode =:ll_cashiershiftcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.id_master.object.cashacccode[1] = ll_cashacccode
		end if
	end if
	if f_stringpreferences("CashierShift") = "Y" and isnull(ll_cashiershiftcode) then
		messagebox("Cashier Shift Linkage Missing", "Cashier Shift Linkage Missing~r~nContact System Administrator and try again.", stopsign!)
		return -1
	end if
	return 0

// w_sale.wf_apply_salestaxschedule_on_saving(integer ai_mode, long al_usercode) returns long
	string ls_errortext
	long ll_counter
	long ll_icode
	long ll_taxflag
	long ll_custcode
	char lc_tax_applicable
	char lc_tax_type
	double ld_tax_perc
	double ld_unitsaletax
	double ld_saleprice
	double ld_itemflatdisc
	double ld_discperc
	double ld_retailprice
	double ld_netsaleprice
	integer li_rtcode
	char ls_exempt = "N"
	datawindowchild ldc_godown
	datawindowchild ldc_itemmeter
	datastore lds_local
	if this.id_master.rowcount() > 0 then
		ll_custcode = this.id_master.object.custcode[1]
		if ll_custcode > 0 then
			SQL SELECT SalesTaxExemption INTO :ls_exempt FROM Customer WHERE CustCode =:ll_custcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if upper(ls_exempt) = "Y" then
					return 0
				end if
			else
				messagebox("Apply Sales Tax Schedule", "Problem in verification of Customer Sales Tax Exemption Status.~r~nDetails are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
				return -1
			end if
			return
		end if
		return
	end if
	if this.ib_apply_stax_schedule_on_unit_stax and upper(ls_exempt) = "N" then
		if ai_mode = 1 then
			lds_local = create datastore
			lds_local.dataobject = this.id_detail.dataobject
			li_rtcode = lds_local.settransobject(this.it_transobject)
			li_rtcode = this.id_detail.rowscopy(1, this.id_detail.rowcount(), primary!, lds_local, 1, primary!)
			ll_counter = 1
			for ll_counter = 1 to lds_local.rowcount()
				ll_icode = lds_local.object.icode[ll_counter]
				ld_saleprice = lds_local.object.saleprice[ll_counter]
				ld_itemflatdisc = lds_local.object.itemflatdisc[ll_counter]
				ld_discperc = lds_local.object.discperc[ll_counter]
				ld_retailprice = lds_local.object.retailprice[ll_counter]
				if this.id_detail.object.taxflag[ll_counter] = 0 then
					lds_local.object.cloneitemflatdisc[ll_counter] = lds_local.object.itemflatdisc[ll_counter]
					lds_local.object.clonediscperc[ll_counter] = lds_local.object.discperc[ll_counter]
					lds_local.object.clonesaleprice[ll_counter] = ld_saleprice
				end if
				if ld_retailprice <= 0.0 or isnull(ld_retailprice) then
					ld_retailprice = ld_saleprice
				end if
				ll_taxflag = lds_local.object.taxflag[ll_counter]
				if ll_taxflag = 0 then
					SQL SELECT tax_applicable =ISNULL ( ( SELECT STS.Applicable FROM SalesTaxSchedule STS WHERE STS.SalesTaxScheduleCode =item.SalesTaxScheduleCode ) , 'N' ) , tax_perc =ISNULL ( ( SELECT STS.TaxPerc FROM SalesTaxSchedule STS WHERE STS.SalesTaxScheduleCode =item.SalesTaxScheduleCode ) , 0 ) , tax_type =ISNULL ( ( SELECT STS.TaxType FROM SalesTaxSchedule STS WHERE STS.SalesTaxScheduleCode =item.SalesTaxScheduleCode ) , 'S' ) INTO :lc_tax_applicable, :ld_tax_perc, :lc_tax_type FROM Item WHERE Item.ICode =:ll_icode USING this.it_transobject;
					if this.it_transobject.sqlcode = 0 then
						if lc_tax_applicable = "Y" then
							if lc_tax_type = "S" then
								ld_unitsaletax = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01) * ld_tax_perc * 0.01, 2)
								lds_local.object.unitsalestax[ll_counter] = ld_unitsaletax
								this.id_detail.object.unitsalestax[ll_counter] = ld_unitsaletax
							elseif lc_tax_type = "R" then
								ld_unitsaletax = round(ld_retailprice * ld_tax_perc * 0.01, 2)
								lds_local.object.unitsalestax[ll_counter] = ld_unitsaletax
								this.id_detail.object.unitsalestax[ll_counter] = ld_unitsaletax
							elseif lc_tax_type = "D" then
								ld_unitsaletax = round(ld_retailprice * ld_tax_perc * 0.01, 2)
								ld_netsaleprice = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2)
								lds_local.object.saleprice[ll_counter] = ld_netsaleprice - ld_unitsaletax
								lds_local.object.itemflatdisc[ll_counter] = 0.00
								lds_local.object.discperc[ll_counter] = 0.00
								lds_local.object.unitsalestax[ll_counter] = ld_unitsaletax
							elseif lc_tax_type = "E" then
								ld_unitsaletax = round(ld_retailprice * ld_tax_perc / (100.0 + ld_tax_perc), 2)
								ld_netsaleprice = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2)
								lds_local.object.saleprice[ll_counter] = ld_netsaleprice - ld_unitsaletax
								lds_local.object.itemflatdisc[ll_counter] = 0.00
								lds_local.object.discperc[ll_counter] = 0.00
								lds_local.object.unitsalestax[ll_counter] = ld_unitsaletax
							elseif lc_tax_type = "I" then
								ll_custcode = this.id_master.object.custcode[1]
								ld_saleprice = lds_local.object.saleprice[ll_counter]
								lds_local.object.saleprice[ll_counter] = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01) * 100.0 / (100.0 + ld_tax_perc), 2)
								lds_local.object.unitsalestax[ll_counter] = round(lds_local.object.saleprice[ll_counter] * ld_tax_perc * 0.01, 2)
								lds_local.object.itemflatdisc[ll_counter] = 0.00
								lds_local.object.discperc[ll_counter] = 0.00
							end if
							lds_local.object.taxflag[ll_counter] = 1
						end if
					else
						messagebox("Apply Sales Tax Schedule", "Problem faced in Applying Sales Tax Schedule on Saving.~r~nDetails are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
						return -1
					end if
					return
				end if
			next
			if wf_validate_price_discount_matters(1, al_usercode, lds_local) < 0 then
				return -1
			end if
		else
			ll_counter = 1
			for ll_counter = 1 to this.id_detail.rowcount()
				ll_icode = this.id_detail.object.icode[ll_counter]
				ld_saleprice = this.id_detail.object.saleprice[ll_counter]
				ld_itemflatdisc = this.id_detail.object.itemflatdisc[ll_counter]
				ld_discperc = this.id_detail.object.discperc[ll_counter]
				ld_retailprice = this.id_detail.object.retailprice[ll_counter]
				if this.id_detail.object.taxflag[ll_counter] = 0 then
					this.id_detail.object.cloneitemflatdisc[ll_counter] = this.id_detail.object.itemflatdisc[ll_counter]
					this.id_detail.object.clonediscperc[ll_counter] = this.id_detail.object.discperc[ll_counter]
					this.id_detail.object.clonesaleprice[ll_counter] = ld_saleprice
				end if
				if ld_retailprice <= 0.0 or isnull(ld_retailprice) then
					ld_retailprice = ld_saleprice
				end if
				ll_taxflag = this.id_detail.object.taxflag[ll_counter]
				if ll_taxflag = 0 then
					SQL SELECT tax_applicable =ISNULL ( ( SELECT STS.Applicable FROM SalesTaxSchedule STS WHERE STS.SalesTaxScheduleCode =item.SalesTaxScheduleCode ) , 'N' ) , tax_perc =ISNULL ( ( SELECT STS.TaxPerc FROM SalesTaxSchedule STS WHERE STS.SalesTaxScheduleCode =item.SalesTaxScheduleCode ) , 0 ) , tax_type =ISNULL ( ( SELECT STS.TaxType FROM SalesTaxSchedule STS WHERE STS.SalesTaxScheduleCode =item.SalesTaxScheduleCode ) , 'S' ) INTO :lc_tax_applicable, :ld_tax_perc, :lc_tax_type FROM Item WHERE Item.ICode =:ll_icode USING this.it_transobject;
					if this.it_transobject.sqlcode = 0 then
						if lc_tax_applicable = "Y" then
							if lc_tax_type = "S" then
								ld_unitsaletax = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01) * ld_tax_perc * 0.01, 2)
								this.id_detail.object.unitsalestax[ll_counter] = ld_unitsaletax
							elseif lc_tax_type = "R" then
								ld_unitsaletax = round(ld_retailprice * ld_tax_perc * 0.01, 2)
								this.id_detail.object.unitsalestax[ll_counter] = ld_unitsaletax
							elseif lc_tax_type = "D" then
								ld_unitsaletax = round(ld_retailprice * ld_tax_perc * 0.01, 2)
								ld_netsaleprice = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2)
								this.id_detail.object.saleprice[ll_counter] = ld_netsaleprice - ld_unitsaletax
								this.id_detail.object.itemflatdisc[ll_counter] = 0.00
								this.id_detail.object.discperc[ll_counter] = 0.00
								this.id_detail.object.unitsalestax[ll_counter] = ld_unitsaletax
							elseif lc_tax_type = "E" then
								ld_unitsaletax = round(ld_retailprice * ld_tax_perc / (100.0 + ld_tax_perc), 2)
								ld_netsaleprice = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2)
								this.id_detail.object.saleprice[ll_counter] = ld_netsaleprice - ld_unitsaletax
								this.id_detail.object.itemflatdisc[ll_counter] = 0.00
								this.id_detail.object.discperc[ll_counter] = 0.00
								this.id_detail.object.unitsalestax[ll_counter] = ld_unitsaletax
							elseif lc_tax_type = "I" then
								ll_custcode = this.id_master.object.custcode[1]
								ld_saleprice = this.id_detail.object.saleprice[ll_counter]
								this.id_detail.object.saleprice[ll_counter] = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01) * 100.0 / (100.0 + ld_tax_perc), 2)
								this.id_detail.object.unitsalestax[ll_counter] = round(this.id_detail.object.saleprice[ll_counter] * ld_tax_perc * 0.01, 2)
								this.id_detail.object.itemflatdisc[ll_counter] = 0.00
								this.id_detail.object.discperc[ll_counter] = 0.00
							end if
							this.id_detail.object.taxflag[ll_counter] = 1
						end if
					else
						messagebox("Apply Sales Tax Schedule", "Problem faced in Applying Sales Tax Schedule on Saving.~r~nDetails are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
						return -1
					end if
					return
				end if
			next
		end if
	end if
	this.id_detail.accepttext()
	wf_grandtotal()
	return 0

// w_sale.wf_validate_price_discount_matters(integer ai_mode, long al_usercode, ref datawindow adw_dw) returns long
	long ll_counter
	long ll_counter2
	long ll_icode
	long ll_custcode
	long ll_allowsalebelowavgprice
	long ll_masterrow
	string ls_consideralldiscountsonitem = "Y"
	string ls_considerratechangeasdiscount = "N"
	string ls_itemgrouperror
	double ld_invdiscperc
	double ld_flatdisc
	double ld_saleprice
	double ld_rate
	double ld_rpp
	double ld_discperc
	double ld_itemflatdisc
	double ld_unitsalestax
	double ld_itemgstperc
	double ld_invdisc
	double ld_invgstperc
	double ld_avgprice
	double ld_itemamount
	double ld_amountdiff
	double ld_clonesaleprice
	double ld_itemsalediscperc
	double ld_maxitemsalediscperc
	double ld_grossamt_rate_qty
	double ld_totaldiscount
	double ld_accumulateddiscperc
	double ld_qty
	double ld_actual_accumdiscperc
	double ld_accumdiscperccaution
	double ld_discgiven
	double ld_groupsaleitemdiscperc
	double ld_cloneflatdisc
	double ld_clonediscperc
	double ld_tempflatdisc
	double ld_tempdiscperc
	boolean lb_validdisc
	datastore lds_groupdiscinfo
	ls_considerratechangeasdiscount = f_stringpreferences("ConsiderRateChangeAsDiscount")
	if trim(ls_considerratechangeasdiscount) = "" or isnull(ls_considerratechangeasdiscount) then
		ls_considerratechangeasdiscount = "N"
	end if
	wf_grandtotal()
	lds_groupdiscinfo = create datastore
	lds_groupdiscinfo.dataobject = "d_groups_discount"
	lds_groupdiscinfo.settransobject(this.it_transobject)
	lds_groupdiscinfo.retrieve(al_usercode)
	ld_invdiscperc = this.id_footer.getitemnumber(1, "invdiscperc")
	ld_flatdisc = this.id_footer.getitemnumber(1, "flatdisc")
	lb_validdisc = false
	ll_masterrow = this.id_master.rowcount()
	for ll_counter = 1 to lds_groupdiscinfo.rowcount()
		ld_accumulateddiscperc = lds_groupdiscinfo.object.accumulateddiscperc[ll_counter]
		ld_accumdiscperccaution = lds_groupdiscinfo.object.accumdiscperccaution[ll_counter]
		ls_consideralldiscountsonitem = lds_groupdiscinfo.object.consideralldiscountsonitem[ll_counter]
		ld_groupsaleitemdiscperc = lds_groupdiscinfo.object.saleitemdiscperc[ll_counter]
		if ld_flatdisc <= lds_groupdiscinfo.object.saleinvflatdisc[ll_counter] then
			lb_validdisc = true
		end if
	next
	if lb_validdisc = false then
		messagebox("Flat Discount Validation", "Flat Discount is greater than your permission~r~n Please consult Administrator")
		this.id_footer.setfocus()
		this.id_footer.setcolumn("flatdisc")
		destroy lds_groupdiscinfo
		return -1
	end if
	ld_grossamt_rate_qty = 0
	ld_totaldiscount = 0
	ll_counter = 0
	for ll_counter = 1 to adw_dw.rowcount()
		ll_icode = adw_dw.getitemnumber(ll_counter, "icode")
		ld_qty = adw_dw.getitemnumber(ll_counter, "looseqty")
		ld_saleprice = adw_dw.getitemnumber(ll_counter, "saleprice")
		if ls_considerratechangeasdiscount = "Y" then
			ld_rate = adw_dw.getitemnumber(ll_counter, "rate")
		else
			ld_rate = ld_saleprice
		end if
		ld_rpp = adw_dw.getitemnumber(ll_counter, "rppunitrate")
		ld_discperc = adw_dw.getitemnumber(ll_counter, "discperc")
		ld_itemflatdisc = adw_dw.getitemnumber(ll_counter, "itemflatdisc")
		ld_cloneflatdisc = adw_dw.getitemnumber(ll_counter, "cloneitemflatdisc")
		ld_clonediscperc = adw_dw.getitemnumber(ll_counter, "clonediscperc")
		if isnull(ld_cloneflatdisc) then
			ld_cloneflatdisc = 0.00
		end if
		if isnull(ld_clonediscperc) then
			ld_clonediscperc = 0.00
		end if
		ld_unitsalestax = adw_dw.getitemnumber(ll_counter, "unitsalestax")
		ld_itemgstperc = adw_dw.getitemnumber(ll_counter, "gstperc")
		ld_invdisc = this.id_footer.getitemnumber(1, "invdiscperc")
		ld_invgstperc = this.id_footer.getitemnumber(1, "invgstperc1")
		ld_avgprice = adw_dw.getitemnumber(ll_counter, "avgprice")
		ld_itemamount = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2) - round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2) * ld_invdiscperc * 0.01
		ld_amountdiff = ld_rate - ld_itemamount
		ld_clonesaleprice = ld_rate
		if ld_clonesaleprice = 0.0 or isnull(ld_clonesaleprice) then
			ld_clonesaleprice = 1
		end if
		ll_custcode = this.id_master.object.custcode[1]
		wf_getitemdiscounts(ll_icode, ll_custcode, ld_itemsalediscperc, ld_maxitemsalediscperc)
		lb_validdisc = false
		if f_stringpreferences("FroceMaxSaleDiscPerc") = "Y" and round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2) > 0 then
			if ld_amountdiff * 100.0 / ld_clonesaleprice <= ld_maxitemsalediscperc then
				lb_validdisc = true
			end if
			if lb_validdisc = false then
				ld_discgiven = round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2)
				messagebox("Discount Validation", "Given Discount = " + trim(string(ld_discgiven, "###,###.##")) + "%~r~n" + "Maximun Sale Discount = " + trim(string(ld_maxitemsalediscperc, "###,###.##")) + "%~r~n~r~n" + "Given Discount Percentage is greater than Maximum Sale Discount Percentage for this item~r~n~r~n" + "Please consult Administrator", stopsign!)
				adw_dw.setfocus()
				adw_dw.setrow(ll_counter)
				adw_dw.setcolumn("itemname")
				destroy lds_groupdiscinfo
				return -1
			end if
			return
		end if
		if f_stringpreferences("AllowSaleBelowRPP") = "N" and round(ld_rpp, 2) > round(ld_itemamount, 2) then
			messagebox("Price Validation", "Sale Price become less than RPP" + "~r~nNet Sale Price = " + string(round(ld_itemamount, 2), "###,###,##0.00") + "~r~nRPP = " + string(round(ld_rpp, 2), "###,###,##0.00") + "~r~nPlease Change Sale Price or Setting In Preferences", stopsign!)
			adw_dw.setfocus()
			adw_dw.setrow(ll_counter)
			adw_dw.setcolumn("itemname")
			adw_dw.scrolltorow(ll_counter)
			destroy lds_groupdiscinfo
			return -1
		end if
		if f_stringpreferences("saleavgpricecheck") = "N" and ll_allowsalebelowavgprice = 0 and round(ld_avgprice, 2) > round(ld_itemamount, 2) and wf_check_item_user_salebelowavgprice(ll_icode, al_usercode, ls_itemgrouperror) < 0 then
			messagebox("Price Validation", ls_itemgrouperror + "~r~nSale Price become Less Than Avg. Price" + "~r~nNet Sale Price = " + string(round(ld_itemamount, 2), "###,###,##0.00") + "~r~nAvg. Price = " + string(round(ld_avgprice, 2), "###,###,##0.00") + "~r~nPlease Change Sale Price or Setting In Preferences", stopsign!)
			adw_dw.setfocus()
			adw_dw.setrow(ll_counter)
			adw_dw.setcolumn("itemname")
			adw_dw.scrolltorow(ll_counter)
			destroy lds_groupdiscinfo
			return -1
		end if
		if f_stringpreferences("AllowSalePriceGreaterThanAvgPrice") = "N" and ll_allowsalebelowavgprice = 0 and round(ld_itemamount, 2) > round(ld_avgprice, 2) then
			messagebox("Price Validation", "Sale Price become Greater Than Avg. Price" + "~r~nNet Sale Price = " + string(round(ld_itemamount, 2), "###,###,##0.00") + "~r~nAvg. Price = " + string(round(ld_avgprice, 2), "###,###,##0.00") + "~r~nPlease Change Sale Price or Setting In Preferences", stopsign!)
			adw_dw.setfocus()
			adw_dw.setrow(ll_counter)
			adw_dw.setcolumn("itemname")
			adw_dw.scrolltorow(ll_counter)
			destroy lds_groupdiscinfo
			return -1
		end if
		lb_validdisc = false
		ll_counter2 = 0
		for ll_counter2 = 1 to lds_groupdiscinfo.rowcount()
			ls_consideralldiscountsonitem = lds_groupdiscinfo.object.consideralldiscountsonitem[ll_counter2]
			ld_groupsaleitemdiscperc = lds_groupdiscinfo.object.saleitemdiscperc[ll_counter2]
			ld_tempflatdisc = ld_cloneflatdisc
			ld_tempdiscperc = ld_clonediscperc
			if ld_discperc > ld_clonediscperc then
				ld_tempdiscperc = ld_discperc
			end if
			if ld_itemflatdisc > ld_cloneflatdisc then
				ld_tempflatdisc = ld_itemflatdisc
			end if
			if ls_consideralldiscountsonitem = "N" then
				ld_amountdiff = ld_rate - round(ld_saleprice * (1.0 - ld_discperc * 0.01) * (1.0 - ld_invdiscperc * 0.01), 2)
			else
				ld_amountdiff = ld_rate - round((ld_saleprice - ld_tempflatdisc) * (1.0 - ld_tempdiscperc * 0.01) * (1.0 - ld_invdiscperc * 0.01), 2)
			end if
			if round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2) <= ld_groupsaleitemdiscperc then
				lb_validdisc = true
			elseif round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2) <= ld_itemsalediscperc then
				lb_validdisc = true
			else
				lb_validdisc = false
			end if
		next
		if lb_validdisc = false then
			ld_discgiven = round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2)
			if isnull(ld_discgiven) then
				ld_discgiven = 0.00
			end if
			messagebox("Discount Validation ..", "Given Discount = " + trim(string(ld_discgiven, "###,##0.00")) + "%~r~n" + "Group Permission = " + trim(string(ld_groupsaleitemdiscperc, "###,##0.00")) + "%~r~n" + "Item Basic Data = " + trim(string(ld_itemsalediscperc, "###,##0.00")) + "%~r~n~r~n" + "So Given Discount Percentage is greater than your group permission and~r~n" + "Item Basicdata setting for Sale Discount~r~n~r~n" + "Please consult Administrator", stopsign!)
			adw_dw.setfocus()
			adw_dw.setrow(ll_counter)
			adw_dw.setcolumn("itemname")
			destroy lds_groupdiscinfo
			return -1
		end if
	next
	destroy lds_groupdiscinfo
	if f_stringpreferences("ApplyAccumulatedDiscPerc") = "Y" then
		ld_totaldiscount = this.id_footer.object.totaldiscount[1]
		ld_grossamt_rate_qty = this.id_footer.object.grossforaccumdisc[1]
		ld_actual_accumdiscperc = round(this.id_footer.object.accumulateddiscperc[1], 2)
		if ld_actual_accumdiscperc > ld_accumulateddiscperc then
			messagebox("Accumulated Sales Discount %age Validation", "Accumulated Sales Discount %age is more than the allowed limit~r~nKindly Adjust Sales Discounts in this invoice to acceptable limits~r~n~r~nActual Accumulated Sales Invoice Discount  =" + trim(string(ld_actual_accumdiscperc, "###0.00")) + "%~r~nAllowed Accumulated Sales Invoice Discount   = " + trim(string(ld_accumulateddiscperc, "###0.00")) + "%", stopsign!, ok!)
			return -1
		end if
		if ld_actual_accumdiscperc >= ld_accumdiscperccaution and ld_actual_accumdiscperc - ld_accumdiscperccaution <> 0.0 and (this.id_master.object.custrefno2[1] = "" or isnull(this.id_master.object.custrefno2[1])) then
			messagebox("Accumulated Sales Discount %age Validation", "Accumulated Sales Discount %age is more than the allowed cautious limit~r~nKindly write reason for exceeding cautious limit in customer reference no. 2~r~n~r~nActual Accumulated Sales Invoice Discount  =" + trim(string(ld_actual_accumdiscperc, "###0.00")) + "%~r~nAllowed Accumulated Sales Invoice Discount Cautious Limit  = " + trim(string(ld_accumdiscperccaution, "###0.00")) + "%", stopsign!, ok!)
			return -1
		end if
		return
	end if
	return 0

