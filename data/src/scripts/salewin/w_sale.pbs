		lb_validdisc = false
		ll_counter2 = 0
		for ll_counter2 = 1 to lds_groupdiscinfo.rowcount()
			ls_consideralldiscountsonitem = lds_groupdiscinfo.object.consideralldiscountsonitem[ll_counter2]
			ld_groupsaleitemdiscperc = lds_groupdiscinfo.object.saleitemdiscperc[ll_counter2]
			ld_tempflatdisc = ld_cloneflatdisc
			ld_tempdiscperc = ld_clonediscperc
			if ld_discperc > ld_clonediscperc then
				ld_tempdiscperc = ld_discperc
			end if
			if ld_itemflatdisc > ld_cloneflatdisc then
				ld_tempflatdisc = ld_itemflatdisc
			end if
			if ls_consideralldiscountsonitem = "N" then
				ld_amountdiff = ld_rate - round(ld_saleprice * (1.0 - ld_discperc * 0.01) * (1.0 - ld_invdiscperc * 0.01), 2)
			else
				ld_amountdiff = ld_rate - round((ld_saleprice - ld_tempflatdisc) * (1.0 - ld_tempdiscperc * 0.01) * (1.0 - ld_invdiscperc * 0.01), 2)
			end if
			if round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2) <= ld_groupsaleitemdiscperc then
				lb_validdisc = true
			elseif round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2) <= ld_itemsalediscperc then
				lb_validdisc = true
			else
				lb_validdisc = false
			end if
		next
		if lb_validdisc = false then
			ld_discgiven = round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2)
			if isnull(ld_discgiven) then
				ld_discgiven = 0.00
			end if
			messagebox("Discount Validation ..", "Given Discount = " + trim(string(ld_discgiven, "###,##0.00")) + "%~r~n" + "Group Permission = " + trim(string(ld_groupsaleitemdiscperc, "###,##0.00")) + "%~r~n" + "Item Basic Data = " + trim(string(ld_itemsalediscperc, "###,##0.00")) + "%~r~n~r~n" + "So Given Discount Percentage is greater than your group permission and~r~n" + "Item Basicdata setting for Sale Discount~r~n~r~n" + "Please consult Administrator", stopsign!)
			this.id_detail.setfocus()
			this.id_detail.setrow(ll_counter)
			this.id_detail.setcolumn("itemname")
			destroy lds_groupdiscinfo
			return -1
		end if
	next
	destroy lds_groupdiscinfo
	if f_stringpreferences("ApplyAccumulatedDiscPerc") = "Y" then
		ld_totaldiscount = this.id_footer.object.totaldiscount[1]
		ld_grossamt_rate_qty = this.id_footer.object.grossforaccumdisc[1]
		ld_actual_accumdiscperc = round(this.id_footer.object.accumulateddiscperc[1], 2)
		if ld_actual_accumdiscperc > ld_accumulateddiscperc then
			messagebox("Accumulated Sales Discount %age Validation", "Accumulated Sales Discount %age is more than the allowed limit~r~nKindly Adjust Sales Discounts in this invoice to acceptable limits~r~n~r~nActual Accumulated Sales Invoice Discount  =" + trim(string(ld_actual_accumdiscperc, "###0.00")) + "%~r~nAllowed Accumulated Sales Invoice Discount   = " + trim(string(ld_accumulateddiscperc, "###0.00")) + "%", stopsign!, ok!)
			return -1
		end if
		if ld_actual_accumdiscperc >= ld_accumdiscperccaution and ld_actual_accumdiscperc - ld_accumdiscperccaution <> 0.0 and (this.id_master.object.custrefno2[1] = "" or isnull(this.id_master.object.custrefno2[1])) then
			messagebox("Accumulated Sales Discount %age Validation", "Accumulated Sales Discount %age is more than the allowed cautious limit~r~nKindly write reason for exceeding cautious limit in customer reference no. 2~r~n~r~nActual Accumulated Sales Invoice Discount  =" + trim(string(ld_actual_accumdiscperc, "###0.00")) + "%~r~nAllowed Accumulated Sales Invoice Discount Cautious Limit  = " + trim(string(ld_accumdiscperccaution, "###0.00")) + "%", stopsign!, ok!)
			return -1
		end if
		return
	end if
	return 0

// w_sale.wf_check_item_user_salebelowavgprice(long al_icode, long al_usercode, ref string as_errortext) returns long
	string ls_itemright
	string ls_groupright
	SQL SELECT ItemRight =I.ItemRight , GroupRight =CASE WHEN G.GroupRight =0 THEN 'N' ELSE 'Y' END INTO :ls_itemright, :ls_groupright FROM ( SELECT ItemRight =MAX ( AllowSalePriceBelowAvgPrice ) FROM Item WHERE ICode =:al_icode ) I , ( SELECT GroupRight =ISNULL ( COUNT ( RightCode ) , 0 ) FROM GroupRights WHERE RightCode =1797 AND GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:al_usercode ) ) G USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if upper(ls_itemright) = "Y" and upper(ls_groupright) = "Y" then
			return 0
		else
			if ls_itemright = "N" then
				as_errortext = "Item Right Not Allowed To Sale Below Avg. Price"
				return -1
			end if
			if ls_groupright = "N" then
				as_errortext = "User/Group Not Allowed To Sale Below Avg. Price"
				return -1
			end if
		end if
		return
	end if
	as_errortext = "Database Error While Implementing Sale Price Below Avg. Price (Item and Group Right)"
	return -1

// w_sale.wf_push_sales_to_dropbox() returns long
	integer li_errcode
	long ll_salesmancode = 1
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	if ll_salesmancode > 0 then
		openwithparm(w_arg_cust_sinvcode_linvcode2, this.ii_saletype)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			li_errcode = this.it_transobject.pushsalestodropbox(lstr_arginfo.l_code1, lstr_arginfo.l_code2, lstr_arginfo.l_code3, ll_salesmancode, gs_dropbox_server, gs_dropbox_db, "DBO", ll_saleinvcount)
			if li_errcode <> 0 then
				li_errcode = this.it_transobject.sqlcode
				ls_msgtext = this.it_transobject.sqlerrtext
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				ls_msgtext = this.it_transobject.sqlerrtext
				li_errcode = this.it_transobject.sqlcode
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Push Sales To Drop Box Fails", "Some database request fails, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode), stopsign!)
		else
			messagebox("Push to Drop Box Successfull", "Total Invoices to push were " + string(ll_saleinvcount) + "~n~rAll Invoices have been pushed successfully to drop box.", information!)
		end if
	end if
	return li_errcode

// w_sale.wf_itempurchasehistory() returns 0
	s_itempurchasehistory ls_itempurchasehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itempurchasehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itempurchasehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itempurchasehistory, ls_itempurchasehistory)
	end if

// w_sale.wf_gen_qrcode(long al_saleinvcode, ref string as_qrcode) returns integer
	string ls_qr_method
	string ls_setting
	long ll_rows
	ls_qr_method = f_stringpreferences("qrcodeprintingmethodinsale")
	ls_setting = this.id_print.describe("p_qrcode.filename")
	ll_rows = this.id_print.rowcount()
	if ls_setting = "!" then
		ls_setting = this.id_print.object.dw_1[ll_rows].object.p_qrcode.filename
		if ls_setting <> "!" then
			if ls_qr_method = "G" then
				this.id_print.object.dw_1[ll_rows].object.p_qrcode.filename = "qrcode.gif"
				f_get_google_qrcode(as_qrcode)
			elseif ls_qr_method = "H" then
				this.id_print.object.dw_1[ll_rows].object.p_qrcode.filename = "qrcode.gif"
				f_get_googleqrcode_for_fiscalinvno(al_saleinvcode)
			elseif ls_qr_method = "I" then
				f_gen_idautomation_qrcode(as_qrcode)
			elseif ls_qr_method = "M" then
				this.id_print.object.dw_1[ll_rows].object.p_qrcode.filename = "qrcode.bmp"
				f_gen_morovia_qrcode(as_qrcode, 5, 3)
			elseif ls_qr_method = "Q" then
				this.id_print.object.dw_1[ll_rows].object.p_qrcode.filename = "qrcode.bmp"
				f_gen_pb_qrcode(as_qrcode)
			end if
		end if
	elseif ls_qr_method = "G" then
		this.id_print.object.p_qrcode.filename = "qrcode.gif"
		f_get_google_qrcode(as_qrcode)
	elseif ls_qr_method = "H" then
		this.id_print.object.p_qrcode.filename = "qrcode.gif"
		f_get_googleqrcode_for_fiscalinvno(al_saleinvcode)
	elseif ls_qr_method = "I" then
		f_gen_idautomation_qrcode(as_qrcode)
	elseif ls_qr_method = "M" then
		this.id_print.object.p_qrcode.filename = "qrcode.bmp"
		f_gen_morovia_qrcode(as_qrcode, 5, 3)
	elseif ls_qr_method = "Q" then
		this.id_print.object.p_qrcode.filename = "qrcode.bmp"
		f_gen_pb_qrcode(as_qrcode)
	end if
	return 0

// w_sale.wf_fetch_customerbalance_onremote(long al_custcode) returns long
	u_transaction lt_transobject
	long ll_retcode
	long ll_acccode
	double ld_balance
	datetime ldt_datetime
	string ls_procedure
	if al_custcode > 0 and (len(trim(gs_parentserver)) > 0 and len(trim(gs_parentlinkserver)) > 0 and len(trim(gs_parentdbname)) > 0) then
		lt_transobject = create u_transaction
		SQL start USING lt_transobject;
		if lt_transobject.sqlcode = 0 then
			ll_acccode = al_custcode
			ll_retcode = -1
			ld_balance = 0.00
			ls_procedure = " ALTER PROCEDURE DBO.SP_Fetch_AccountBalance_OnRemote @AccCode INT, @Date DATETIME, @Balance NUMERIC(15,5) OUTPUT AS BEGIN TRAN T1 DECLARE @RC int, @BalDate DATETIME SET @BalDate = @Date IF @BalDate IS NULL ~tSET @BalDate = '3050-12-12 23:59:59' EXEC @RC = " + gs_parentlinkserver + "." + gs_parentdbname + ".dbo.SP_OpeningBalance @AccCode, @BalDate, @Balance OUTPUT IF @RC = 0 COMMIT TRAN T1 ELSE ROLLBACK TRAN T1 RETURN 0"
			setnull(ldt_datetime)
			SQL EXECUTE IMMEDIATE :ls_procedure USING lt_transobject;
			if lt_transobject.sqlcode = 0 then
				SQL commit USING lt_transobject;
				ll_retcode = lt_transobject.fetch_accountbalance_onremote(ll_acccode, ldt_datetime, ld_balance)
				if lt_transobject.sqlcode = 0 then
					SQL commit USING lt_transobject;
					if isnull(ld_balance) then
						ld_balance = 0
					end if
					if ld_balance > 0.0 then
						messagebox("Account Balance", "Account Balance = " + string(abs(ld_balance), "###,###,##0.00") + " Dr.", information!)
					else
						messagebox("Account Balance", "Account Balance = " + string(abs(ld_balance), "###,###,##0.00") + " Cr.", information!)
					end if
				else
					SQL rollback USING lt_transobject;
				end if
			end if
		end if
	end if
	return 0

// w_sale.wf_getcustitemcatwisesalesdiscount(long al_icode, long al_custcode, ref double ad_discperc, ref double ad_prediscperc, ref double ad_itemflatdisc) returns boolean
	double ld_null
	setnull(ld_null)
	ad_discperc = ld_null
	SQL SELECT discperc , prediscperc , itemflatdisc INTO :ad_discperc, :ad_prediscperc, :ad_itemflatdisc FROM DBO.CustItemCatWiseSaleDiscount WHERE CustCatCode =ISNULL ( ( SELECT Customer.custcatcode FROM dbo.customer Where Customer.custcode =:al_custcode ) , 0 ) AND ICatCode =ISNULL ( ( SELECT Item.icatcode FROM dbo.Item Where Item.Icode =:al_icode ) , 0 ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ad_discperc) then
			ad_discperc = 0
		end if
		if isnull(ad_prediscperc) then
			ad_prediscperc = 0
		end if
		if isnull(ad_itemflatdisc) then
			ad_itemflatdisc = 0
		end if
		return true
	end if
	return false

// w_sale.wf_setcustomerbalance(long al_custcode) returns long
	long ll_found
	double ld_customerbalance
	if this.ii_saletype = 2 and f_stringpreferences("InSaleCustomerBalance") = "Y" then
		ll_found = this.ids_customersbalance.find("code1 = " + string(al_custcode), 1, this.ids_customersbalance.rowcount())
		if ll_found > 0 and ll_found <= this.ids_customersbalance.rowcount() then
			ld_customerbalance = this.ids_customersbalance.getitemnumber(ll_found, "value1")
			this.id_master.setitem(1, "customerbalance", ld_customerbalance)
			if ld_customerbalance > 0.0 then
				this.id_master.setitem(1, "debitorcredit", "Dr")
			else
				this.id_master.setitem(1, "debitorcredit", "Cr")
			end if
		else
			this.id_master.setitem(1, "debitorcredit", "")
			this.id_master.setitem(1, "customerbalance", 0)
		end if
	end if
	return 0

// w_sale.wf_save_with_nocommit() returns long
	setpointer(hourglass!)
	if f_validatedw(this.id_master) < 0 then
		return -1
	end if
	if f_validatedw(this.id_detail) < 0 then
		return -2
	end if
	if this.id_master.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		this.ib_commitok = false
		return -3
	end if
	if this.id_detail.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		this.ib_commitok = false
		return -4
	end if
	if this.dw_salesetsheader.update() < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		this.ib_commitok = false
		return -5
	end if
	if this.dw_salesetsdetail.update() < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		this.ib_commitok = false
		return -6
	end if
	if this.dw_salesetsorigdetail.update() < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		this.ib_commitok = false
		return -7
	end if
	setpointer(arrow!)
	return 0

// w_sale.wf_responsivesearch_withalternatealias() returns 0
	long ll_found
	long ll_listcurrrow
	long rt_code
	long ll_rowm
	long ll_itemcodetype
	long ll_icode
	long ll_null
	integer li_errcode
	integer li_res
	string ls_itemname
	string ls_null
	s_popup_selection lstr_selection
	s_datastore lstr_ds
	setnull(ls_null)
	this.ib_itemslistopen = false
	this.id_itemslist.hide()
	this.id_detail.setredraw(true)
	lstr_ds.s_name1 = gd_itemswithalternatealias.dataobject
	lstr_ds.s_name2 = "name"
	if this.id_detail.getcolumn() = 1 then
		lstr_ds.s_name3 = this.is_aliasname
	else
		lstr_ds.s_name3 = this.is_name_value
	end if
	openwithparm(w_popup_responsivesearch_selection_aa, lstr_ds)
	lstr_selection = message.powerobjectparm
	if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
		ll_found = this.id_itemslist.find("icode = " + string(lstr_selection.l_code2), 1, this.id_itemslist.rowcount())
		if ll_found > 0 and ll_found <= this.id_itemslist.rowcount() then
			ll_listcurrrow = ll_found
			this.id_itemslist.selectrow(0, false)
			if this.id_detail.getcolumn() = 1 then
				this.is_aliasname = this.id_itemslist.object.fullcode[ll_found]
			else
				this.is_name_value = this.id_itemslist.object.itemname[ll_found]
			end if
			rt_code = 1
		end if
	end if
	this.id_detail.setfocus()
	if rt_code = 1 then
		this.id_itemslist.selectrow(ll_listcurrrow, true)
		ll_rowm = this.id_detail.getrow()
		if ll_rowm > 0 then
			this.id_detail.setitem(ll_rowm, "fullcode", this.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
			this.id_detail.setitem(ll_rowm, this.is_columnitemname, this.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
			this.id_detail.setitem(ll_rowm, "icode", this.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
			this.id_detail.setitem(ll_rowm, "alternatecustomicode", lstr_selection.s_name2)
			ll_itemcodetype = lstr_selection.l_code3
			li_res = wf_findfullcode(lstr_selection.s_name2, ll_icode, ls_itemname, ll_itemcodetype, this.idbl_packqty, this.idbl_purprice, this.idbl_saleprice)
			if li_res > 0 then
				if this.idbl_packqty <= 0.0 or isnull(this.idbl_packqty) then
					this.idbl_packqty = 1
				end if
				this.id_detail.setitem(ll_rowm, "icode", ll_icode)
				this.id_detail.setitem(ll_rowm, "itemname", ls_itemname)
				this.id_detail.setitem(ll_rowm, "looseqty", this.idbl_packqty)
				if ll_itemcodetype = 2 then
					this.id_detail.setitem(ll_rowm, "alternatecustomicode", lstr_selection.s_name2)
					this.id_detail.setitem(ll_rowm, "rate", this.idbl_saleprice / this.idbl_packqty)
					this.id_detail.setitem(ll_rowm, "packsaleprice", this.idbl_saleprice)
					this.id_detail.setitem(ll_rowm, "packprice", this.idbl_saleprice)
					this.id_detail.setitem(ll_rowm, "saleprice", this.idbl_saleprice / this.idbl_packqty)
				else
					this.id_detail.setitem(ll_rowm, "alternatecustomicode", ls_null)
				end if
				this.ib_itemvalidated = false
				this.il_currrow = ll_rowm
				li_errcode = 0
				if wf_validateitem(false) = 0 then
					li_errcode = 0
				else
					li_errcode = 1
				end if
			else
				messagebox("Item Code/Alias Name Validation", "Item does not exist")
				this.id_detail.setitem(ll_rowm, "icode", ll_null)
				this.id_detail.setitem(ll_rowm, "fullcode", ls_null)
				li_errcode = 1
			end if
			this.id_detail.selecttext(1, len(this.id_detail.gettext()))
			this.ib_itemvalidated = false
			this.il_currrow = ll_rowm
		end if
		this.id_detail.setitem(this.id_detail.getrow(), "CurrListRow", ll_listcurrrow)
		this.id_detail.setredraw(true)
	end if

// w_sale.wf_showlist(long al_listcurrrow) returns 0
	if this.ic_autosearchonalternatealias = "Y" then
		if this.id_detail.rowcount() > 0 and this.id_master.rowcount() > 0 and this.id_footer.rowcount() > 0 and this.il_myrowid > 0 then
			this.is_aliasname = ""
			this.is_name_value = ""
			wf_responsivesearch_withalternatealias()
		end if
		return
	end if
	this.id_itemslist.show()
	this.id_itemslist.selectrow(0, false)
	this.id_itemslist.scrolltorow(al_listcurrrow)
	if al_listcurrrow <> 0 then
		this.id_itemslist.selectrow(al_listcurrrow, true)
	end if
	this.id_detail.setfocus()
	this.ib_itemslistopen = true

// w_sale.wf_autodue(long row, string data) returns long
	s_dueinfo ls_due
	long ll_row
	long li_null
	long ll_code
	long ll_counter
	long ll_icode
	long ll_gcode
	long ll_rowgroup
	long ll_errcode
	string ls_null
	boolean lb_duefound
	double ld_qty
	double ld_dueqty
	double ld_godownstock
	double ld_givenqty
	double ld_stock
	double ld_areavolume
	double ld_packcapacity
	ll_row = row
	ll_code = this.id_master.getitemnumber(this.id_master.getrow(), "code")
	if not isnull(ll_code) then
		this.ids_invoiceinfo.retrieve(ll_code)
		ll_icode = this.id_detail.getitemnumber(ll_row, "icode")
		ll_gcode = this.id_detail.getitemnumber(ll_row, "gcode")
		ld_givenqty = double(data)
		ll_rowgroup = this.id_detail.getitemnumber(ll_row, "rowgroup")
		this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Stock Validation", "Database Error: Item information can not be retrieved")
			ll_errcode = 1
		end if
		for ll_counter = 1 to this.ids_invoiceinfo.rowcount()
			if ll_icode = this.ids_invoiceinfo.getitemnumber(ll_counter, "icode") and this.ids_invoiceinfo.getitemnumber(ll_counter, "rowgroup") = ll_rowgroup then
				if isnull(this.ids_invoiceinfo.getitemstring(ll_counter, "due")) then
					ld_qty = ld_qty + this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty")
				else
					ld_dueqty = ld_dueqty + this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty")
					lb_duefound = true
				end if
			end if
		next
		if lb_duefound = true then
			ls_due.qty = ld_qty
			ls_due.dueqty = ld_dueqty
			ls_due.stock = ld_godownstock + ld_qty
		else
			ld_stock = ld_godownstock + ld_qty
			ls_due.stock = ld_stock
			if ld_givenqty <= ld_stock then
				ls_due.qty = ld_givenqty
				ls_due.dueqty = 0
			else
				ls_due.qty = ld_givenqty
				ls_due.dueqty = ld_givenqty - ld_stock
			end if
		end if
	else
		ld_givenqty = double(data)
		ld_stock = this.id_detail.getitemnumber(ll_row, "stock")
		if ld_givenqty <= ld_stock then
			ls_due.qty = ld_givenqty
			ls_due.dueqty = 0
		else
			ls_due.qty = ld_givenqty
			ls_due.dueqty = ld_givenqty - ld_stock
		end if
		ls_due.stock = ld_stock
	end if
	ls_due.itemname = this.id_detail.getitemstring(ll_row, "itemname")
	ld_qty = ls_due.qty
	ld_dueqty = ls_due.dueqty
	setnull(ls_null)
	setnull(li_null)
	if ld_qty > 0.0 then
		this.id_detail.setitem(ll_row, "looseqty", ld_qty)
		this.id_detail.setitem(ll_row, "dueqty", ld_dueqty)
	elseif ld_qty = 0.0 then
		this.id_detail.setitem(ll_row, "looseqty", ld_dueqty)
		this.id_detail.setitem(ll_row, "dueqty", ld_dueqty)
	end if
	if ld_dueqty > 0.0 then
		this.id_detail.setitem(ll_row, "due", "D")
	else
		this.id_detail.setitem(ll_row, "due", ls_null)
	end if
	ld_areavolume = this.id_detail.object.areavolume[row]
	if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
		ld_areavolume = 1
	end if
	ld_packcapacity = this.id_detail.object.packcapacity[row]
	if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
		ld_packcapacity = 1
	end if
	this.id_detail.setitem(row, "pcs", round(double(data) / ld_areavolume, 6))
	this.id_detail.setitem(row, "cartons", trim(string(this.id_detail.object.pcs[row] / ld_packcapacity)) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[row] mod ld_packcapacity, 2))))))
	if double(long(data)) <> double(data) and this.id_detail.object.allowsaleindecimalqty[row] = "N" then
		messagebox("Sale Quantity Validation", "Sale Quantity In decimals is not allowed for this item", stopsign!)
		ll_errcode = 1
	end if
	return ll_errcode

// w_sale.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_salemenu" then
		this.menuid = create m_salemenu
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	this.dw_saleinvdetail = create dw_saleinvdetail
	this.dw_refusedsaleheader = create dw_refusedsaleheader
	this.dw_refusedsaledetail = create dw_refusedsaledetail
	this.dw_itemassociation = create dw_itemassociation
	this.dw_receivable_adjdetail = create dw_receivable_adjdetail
	this.ic_cashdrawerprinter = create ic_cashdrawerprinter
	this.ole_lcddisplay = create ole_lcddisplay
	this.dw_salesetsheader = create dw_salesetsheader
	this.dw_salesetsdetail = create dw_salesetsdetail
	this.dw_salesetsorigdetail = create dw_salesetsorigdetail
	this.dw_holdsaledetail = create dw_holdsaledetail
	this.ic_comport = create ic_comport
	this.ic_drawerport = create ic_drawerport
	this.dw_image = create dw_image
	this.dw_document = create dw_document
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.dw_saleinvdetail
	this.control[icurrent + 3] = this.dw_refusedsaleheader
	this.control[icurrent + 4] = this.dw_refusedsaledetail
	this.control[icurrent + 5] = this.dw_itemassociation
	this.control[icurrent + 6] = this.dw_receivable_adjdetail
	this.control[icurrent + 7] = this.ic_cashdrawerprinter
	this.control[icurrent + 8] = this.ole_lcddisplay
	this.control[icurrent + 9] = this.dw_salesetsheader
	this.control[icurrent + 10] = this.dw_salesetsdetail
	this.control[icurrent + 11] = this.dw_salesetsorigdetail
	this.control[icurrent + 12] = this.dw_holdsaledetail
	this.control[icurrent + 13] = this.ic_comport
	this.control[icurrent + 14] = this.ic_drawerport
	this.control[icurrent + 15] = this.dw_image
	this.control[icurrent + 16] = this.dw_document

// w_sale.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.dw_saleinvdetail
	destroy this.dw_refusedsaleheader
	destroy this.dw_refusedsaledetail
	destroy this.dw_itemassociation
	destroy this.dw_receivable_adjdetail
	destroy this.ic_cashdrawerprinter
	destroy this.ole_lcddisplay
	destroy this.dw_salesetsheader
	destroy this.dw_salesetsdetail
	destroy this.dw_salesetsorigdetail
	destroy this.dw_holdsaledetail
	destroy this.ic_comport
	destroy this.ic_drawerport
	destroy this.dw_image
	destroy this.dw_document

// w_sale.ue_save() returns 0 [event]
	datastore lds_groupdiscinfo
	double ld_itemflatdisc
	double ld_unitsalestax
	double ld_itemgstperc
	double ld_invdisc
	double ld_invgstperc
	double ld_itemamount
	double ld_ret_total
	double ld_retailprice
	double ld_advancetaxamt
	double ld_fbrposfee
	long ll_detailrows
	long ll_counter2
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_row
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode
	long ll_gcode
	long ll_headerno
	long ll_headerinvno
	long ll_counter
	long ll_count
	long ll_null
	long ll_tabmaxkey
	long ll_modifycount
	long ll_lastinvcode
	long ll_customerallowed
	long ll_found
	long ll_res
	long ll_rightfound
	long ll_rowgroup
	long ll_refusedsaleresult
	long ll_saveresult = -1
	long ll_saletypeinvno
	long ll_mincolvalue
	long ll_contactcardcode
	boolean lb_commitflag = true
	boolean lb_continue = true
	boolean lb_new_invoice
	integer li_counter
	integer li_filehandle
	integer li_maxretcode
	integer li_saletypecode
	string ls_errtext
	string ls_holdstring
	string ls_drawermessage
	string ls_askuserpwd
	string ls_reccurringmsg
	string ls_cashtend
	string ls_invtotal
	string ls_posted = "N"
	string ls_invlist
	string ls_splitinv
	double ld_rate
	double ld_rpp
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_misccharges1
	double ld_misccharges2
	double ld_misccharges3
	double ld_misccharges4
	double ld_misccharges5
	double ld_invamount
	double ld_cashtended
	double ld_cashbalance
	double ld_invgstperc1
	double ld_price
	double ld_balance
	double ld_commissionperunit
	double ld_commissionperc
	long ll_custcode
	long ll_allowsalebelowavgprice
	s_salesman lstr_salesman
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	datetime ldt_server_datetime
	string ls_date_errtext
	datawindowchild ldc_headerno
	string ls_lockdiscperc
	string ls_itemname
	string ls_messagetext
	string ls_isnorcotixitem
	string ls_altersaleinvcounter
	long ll_dummyinvcode
	long ll_retinvcode
	char lc_printbalance
	s_cashierwindow ls_cashierwindow
	string ls_env_name
	string ls_env_val
	long ll_env_len
	this.ib_lcdshow = false
	lc_printbalance = "Y"
	setnull(ll_null)
	setnull(ll_contactcardcode)
	if this.id_master.rowcount() > 0 and (this.id_master.object.code[1] > 0 and upper(this.id_master.object.posted[1]) = "Y") then
		return
	end if
	ls_splitinv = f_stringpreferences("SplitSaleInvoice")
	if ll_retinvcode <= 0 then
		setnull(ll_retinvcode)
	end if
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		return
	end if
	wf_deleteemptydetailrow()
	if this.id_detail.rowcount() <= 0 then
		return
	end if
	ll_contactcardcode = this.id_master.object.contactcardcode[1]
	if f_stringpreferences("AskContactCardForSMS") = "Y" then
		openwithparm(w_contactcard_quick, ll_contactcardcode)
		ll_contactcardcode = message.doubleparm
		if ll_contactcardcode > 0 then
			this.id_master.object.contactcardcode[1] = ll_contactcardcode
		else
			this.id_master.object.contactcardcode[1] = ll_null
		end if
	end if
	if this.ii_saletype = 2 then
		if f_stringpreferences("CreditSaleAllowNullPatient") = "N" then
			this.id_master.object.patientcode.dddw.required = "YES"
		else
			this.id_master.object.patientcode.dddw.required = "NO"
		end if
		if f_stringpreferences("CreditSaleAllowNullGuest") = "N" then
			this.id_master.object.guestcode.dddw.required = "YES"
		else
			this.id_master.object.guestcode.dddw.required = "NO"
		end if
		if f_stringpreferences("CreditSaleAllowNullStudent") = "N" then
			this.id_master.object.studentcode.dddw.required = "YES"
		else
			this.id_master.object.studentcode.dddw.required = "NO"
		end if
	end if
	if this.ii_saletype = 3 then
		if f_stringpreferences("CashSaleAllowNullPatient") = "N" then
			this.id_master.object.patientcode.dddw.required = "YES"
		else
			this.id_master.object.patientcode.dddw.required = "NO"
		end if
		if f_stringpreferences("CashSaleAllowNullGuest") = "N" then
			this.id_master.object.guestcode.dddw.required = "YES"
		else
			this.id_master.object.guestcode.dddw.required = "NO"
		end if
		if f_stringpreferences("CashSaleAllowNullStudent") = "N" then
			this.id_master.object.studentcode.dddw.required = "YES"
		else
			this.id_master.object.studentcode.dddw.required = "NO"
		end if
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	wf_grandtotal()
	wf_apply_progressive_discounts(1)
	if ls_splitinv = "H" then
		ll_mincolvalue = this.id_detail.getitemnumber(1, "c_minheaderno")
		if ll_mincolvalue <> this.id_master.object.headerno[1] then
			this.id_master.object.headerno[1] = ll_mincolvalue
		end if
	elseif ls_splitinv = "G" then
		ll_mincolvalue = this.id_detail.getitemnumber(1, "c_mingcode")
		if ll_mincolvalue <> this.id_master.object.gcode[1] then
			this.id_master.object.gcode[1] = ll_mincolvalue
		end if
	end if
	if this.ii_saletype = 2 then
		if f_stringpreferences("MustAskRefNo1InCreditSale") = "Y" and (isnull(this.id_master.object.custrefno[1]) or this.id_master.object.custrefno[1] = "") then
			messagebox("Reference No. Validation", "Please enter some valid Reference No.", stopsign!)
			this.id_master.setfocus()
			this.id_master.setcolumn("custrefno")
			return
		end if
	elseif f_stringpreferences("MustAskRefNo1InCashSale") = "Y" and (isnull(this.id_master.object.custrefno[1]) or this.id_master.object.custrefno[1] = "") then
		messagebox("Reference No. Validation", "Please enter some valid Reference No.", stopsign!)
		this.id_master.setfocus()
		this.id_master.setcolumn("custrefno")
		return
	end if
	if f_stringpreferences("ForcePCSInInterAtSalesSaving") = "Y" then
		for ll_counter = 1 to this.id_detail.rowcount()
			if this.id_detail.object.pcs[ll_counter] <> long(this.id_detail.object.pcs[ll_counter]) then
				messagebox("PCS Validation", "Please enter some valid PCS. It Should be some valid integer value", stopsign!)
				this.id_detail.setrow(ll_counter)
				this.id_detail.setfocus()
				this.id_detail.setcolumn("PCS")
				return
			end if
		next
	end if
	if f_stringpreferences("forcedoctorinsale") = "Y" and isnull(this.id_master.object.doctcode[1]) then
		messagebox("Docor Name Validation", "Doctor is compulsory, Please select valid doctor", stopsign!)
		this.id_master.setcolumn("doctcode")
		this.id_master.setfocus()
		return
	end if
	if f_stringpreferences("forceremarksinsale") = "Y" and (isnull(this.id_master.object.remarks[1]) or this.id_master.object.remarks[1] = "") then
		messagebox("Remaks Validation", "Remaks is compulsory, Please enter valid Remaks", stopsign!)
		this.id_master.setcolumn("remarks")
		this.id_master.setfocus()
		return
	end if
	if wf_check_patientnic_on_saving() < 0 then
		return
	end if
	if this.id_master.object.code[1] > 0 and this.ib_modify = true then
		if f_stringpreferences("SplitSaleInvoice") = "H" then
			ll_headerno = this.id_master.object.headerno[1]
			ll_counter = 0
			for ll_counter = 1 to this.id_detail.rowcount()
				if this.id_detail.object.headerno[ll_counter] <> ll_headerno then
					messagebox("Split Invoice Mismatch", "Header on this invoice does not match with contents.~r~nPlease select items of specific header only.")
					this.id_detail.setrow(ll_counter)
					this.id_detail.scrolltorow(ll_counter)
					this.id_detail.setcolumn("looseqty")
					this.id_detail.setfocus()
					return
				end if
			next
			ll_counter = 0
		elseif f_stringpreferences("SplitSaleInvoice") = "G" then
			ll_gcode = this.id_detail.object.gcode[1]
			ll_counter = 0
			for ll_counter = 2 to this.id_detail.rowcount()
				if this.id_detail.object.gcode[ll_counter] <> ll_gcode then
					messagebox("Split Invoice Mismatch", "Godown on this invoice does not match with contents.~r~nPlease select items of specific godown only.")
					this.id_detail.setrow(ll_counter)
					this.id_detail.scrolltorow(ll_counter)
					this.id_detail.setcolumn("looseqty")
					this.id_detail.setfocus()
					return
				end if
			next
			ll_counter = 0
		end if
	end if
	if f_stringpreferences("doctnamefornorcotix") = "Y" then
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT antinorcotix , name INTO :ls_isnorcotixitem, :ls_itemname FROM Item WHERE item.icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode < 0 then
				messagebox("Connection Error", "Unable to get item information " + this.it_transobject.sqlerrtext)
				return
			end if
			if ls_isnorcotixitem = "Y" and isnull(this.id_master.getitemstring(1, "remarks")) then
				messagebox("Item Validation", ls_itemname + " " + "is a norcotics item ~r~n please type doctor name in remarks")
				this.id_master.setcolumn("remarks")
				this.id_master.setfocus()
				return
			end if
		next
		setnull(ls_itemname)
	end if
	for ll_counter = 1 to this.id_detail.rowcount()
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		SQL SELECT commissionperunit , commissionperc INTO :ld_commissionperunit, :ld_commissionperc FROM Item WHERE item.icode =:ll_icode USING this.it_transobject;
		if this.it_transobject.sqlcode < 0 then
			messagebox("Connection Error", "Unable to get item information " + this.it_transobject.sqlerrtext)
			return
		end if
		this.id_detail.setitem(ll_counter, "CommissionPerUnit", ld_commissionperunit)
		this.id_detail.setitem(ll_counter, "CommissionPerc", ld_commissionperc)
	next
	if wf_enforcepatientdoctorrecord() > 0 then
		return
	end if
	if this.ii_saletype = 2 and this.id_master.getitemnumber(this.id_master.getrow(), "custcode") = 19.0 then
		messagebox("Customer Validation!", "Cash Sale Walking Customer is not allowed in Credit Sales")
		this.id_master.setcolumn("custcode")
		this.id_master.setfocus()
		return
	end if
	ll_custcode = this.id_master.getitemnumber(this.id_master.rowcount(), "custcode")
	this.il_custcode = ll_custcode
	this.il_allowedcustomer = ll_custcode
	ll_allowsalebelowavgprice = wf_allow_sale_to_customer_below_avgprice(ll_custcode)
	if ll_allowsalebelowavgprice < 0 then
		messagebox("DataBase Problem", "Reasons: Cannot fecth customer information regarding sale/average price.")
		return
	end if
	if ll_custcode > 0 and this.ib_validcustomer = false and wf_check_customer(ll_custcode) = false and this.ib_validcustomer = false then
		this.id_master.setcolumn("custcode")
		this.id_master.setfocus()
		return
	end if
	if wf_checkcustomerwise_itemcategory() < 0 then
		return
	end if
	if wf_checkitemwise_uppersaleqtylimit() < 0 then
		return
	end if
	if f_stringpreferences("EnforceMaxSaleInvPerDayForSigleCust") = "Y" and wf_get_saleinv_count_single_cust(ll_custcode) >= f_numberpreferences("MaxSaleInvCountForSigleCust") then
		messagebox("Max Inv. Counter Validation", "Max Sale inv Counter Limit has achieved for Current Customer~r~nPlease increase Inv. Limit or change the customer")
		return
	end if
	if f_stringpreferences("applycustomerquotationonsaving") = "Y" and wf_apply_associatedquotation(1) <= 0 then
		messagebox("Customer Associated Quotation", "Problem in using associated quotation")
		return
	end if
	if f_stringpreferences("ForceBonusPolicyOnSavingSale") = "Y" and wf_apply_bonuspolicy(1) <= 0 then
		messagebox("Bonus Policy Implementation", "Problem in Applying Bonus Policy on Saving")
		return
	end if
	if f_stringpreferences("ForceDiscPolicyOnSavingSale") = "Y" and wf_apply_discountpolicy(1) <= 0 then
		messagebox("Discount Policy Implementation", "Problem in Applying Discount Policy on Saving")
		return
	end if
	if this.id_detail.rowcount() < 1 then
		messagebox("Rows Validation", "Please insert a row before proceeding")
		return
	end if
	if wf_check_unique_refno() = 0 then
		return
	end if
	if f_stringpreferences("restrictsalefromsinglegodown") = "Y" and wf_restrict_sale_from_single_godown() < 0 then
		messagebox("Sale Godown Restrictions", "Restriction on single sale godown already in place.~r~nHence More than one sale godwon is not allowed on an invoice.~r~nEither ask administrator to lift this restriction or make separate invoice for such items.", stopsign!)
		return
	end if
	if wf_enforce_saleorderdetailsonsaving() > 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	if wf_check_set_contents_stock(ll_row, ls_errtext) < 0 then
		this.id_detail.setrow(ll_row)
		messagebox("Sale Set/Deal Item Validation", "Stock for the Contents of some set/deal items is Not Enough for sale on this invoice.~r~nPlease Either adjust Sale Qty or select som other item.~r~nDetails Are:-~r~n" + ls_errtext)
		return
	end if
	ld_invdiscperc = this.id_footer.getitemnumber(1, "invdiscperc")
	ld_flatdisc = this.id_footer.getitemnumber(1, "flatdisc")
	ls_messagetext = ""
	if ld_invdiscperc > 0.0 or ld_flatdisc > 0.0 then
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT lockdiscperc , name INTO :ls_lockdiscperc, :ls_itemname FROM Item WHERE item.icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode < 0 then
				messagebox("Connection Error", "Unable to get item information " + this.it_transobject.sqlerrtext)
				return
			end if
			if ls_lockdiscperc = "Y" then
				ls_messagetext = ls_messagetext + "Row NO=" + string(ll_counter) + " , itemname=" + ls_itemname + "~r~n"
			end if
		next
	end if
	if ls_messagetext <> "" then
		messagebox("Item Validation", "Due to item LockSaleDisc% setting Please remove following items~r~n" + ls_messagetext + "~r~nOR~r~nSet invoice level discount to zero")
		return
	end if
	if wf_checkminsaleprice() <> 0 then
		return
	end if
	if f_stringpreferences("AllowSaleAboveRetailPriceInSale") = "N" then
		ll_found = this.id_detail.find("retailprice > 0 AND saleprice > retailprice", 1, this.id_detail.rowcount())
		if ll_found > 0 then
			ll_res = 2
			ld_saleprice = round((this.id_detail.object.saleprice[ll_found] - this.id_detail.object.itemflatdisc[ll_found]) * (1 - this.id_detail.object.discperc[ll_found] * 0.01), 2)
			ld_retailprice = this.id_detail.object.retailprice[ll_found]
			ll_res = messagebox("Price Validation", "Net Sale Price is exceeding Retail Price at Row " + string(ll_found) + "~r~nNet Sale Price = " + string(ld_saleprice, "###,###,##0.00") + "~r~nRetail Price = " + string(ld_retailprice, "###,###,##0.00") + "~r~nAllow this Sale to happen?", question!, yesnocancel!, 2)
			if ll_res <> 1 then
				this.id_detail.setfocus()
				this.id_detail.scrolltorow(ll_found)
				this.id_detail.setcolumn("SalePrice")
				return
			end if
			return
		end if
		return
	end if
	if f_stringpreferences("SaleOnZeroPrice") = "N" then
		ll_found = this.id_detail.find("saleprice = 0 OR ISNull(saleprice)", 1, this.id_detail.rowcount())
		if ll_found > 0 then
			messagebox("Price Validation", "SalePrice is Zero in Row " + string(ll_found))
			this.id_detail.setfocus()
			this.id_detail.scrolltorow(ll_found)
			this.id_detail.setcolumn("SalePrice")
			return
		end if
		return
	end if
	ll_found = this.id_detail.find("looseqty + bonusqty <= 0 ", 1, this.id_detail.rowcount())
	if ll_found > 0 then
		messagebox("Sale Qty Validation", "Please Enter Valid Sale Qty in Row " + string(ll_found))
		this.id_detail.setfocus()
		this.id_detail.scrolltorow(ll_found)
		this.id_detail.setcolumn("looseqty")
		return
	end if
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if f_stringpreferences("ForcePricePolicyOnSavingSale") = "Y" and wf_apply_pricepolicy(1) <= 0 then
		messagebox("Price Policy Implementation", "Problem in Applying Item Price Policy on Saving")
		return
	end if
	if wf_apply_saleinvoice_discountpolicy() < 0 then
		return
	end if
	if f_stringpreferences("ApplySalesTaxOnSavingBeforeUserPwd") = "Y" then
		if wf_apply_salestaxschedule_on_saving(0, gl_usercode) < 0 then
			return
		end if
		if wf_validate_price_discount_matters(0, gl_usercode, this.id_detail) < 0 then
			return
		end if
		return
	end if
	wf_grandtotal()
	if this.ii_saletype = 2 then
		ls_askuserpwd = "CreditSaleAskUserPassword"
	else
		ls_askuserpwd = "Salesalesmanwindow"
	end if
	if f_stringpreferences(ls_askuserpwd) = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if f_stringpreferences("ApplySalesTaxOnSavingBeforeUserPwd") = "N" then
			if wf_apply_salestaxschedule_on_saving(1, ll_salesmancode) < 0 then
				return
			end if
		elseif wf_validate_price_discount_matters(0, ll_salesmancode, this.id_detail) < 0 then
			return
		end if
		if wf_apply_roundingpolicy() < 0 then
			return
		end if
		if f_stringpreferences("AutoApplyInvDiscPercOnSavingInSale") = "Y" then
			wf_set_invdiscperc_at_threshhold()
		end if
		wf_grandtotal()
		if f_stringpreferences("autoapplymiscchargesperc_on_saving") = "Y" and wf_misccharges_calc() <> 0 then
			return
		end if
		this.id_footer.accepttext()
		wf_grandtotal()
		this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
		ld_ret_total = this.id_footer.getitemnumber(1, "salereturnamt")
		if isnull(ld_ret_total) then
			ld_ret_total = 0.00
		end if
		if f_stringpreferences("DisplayPool") = "Y" then
			if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				this.is_lcditem = "SALES  = " + string(wf_grandtotal(), "#######0.00")
				this.is_lcditem2 = "NET AMT= " + string(wf_grandtotal() - ld_ret_total, "#######0.00")
				this.ic_comport.triggerevent("ue_show")
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
				this.ole_lcddisplay.object.__invoke_method("showtotal", 1, {string(wf_grandtotal() - ld_ret_total, "########0.00")}, true)
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "TYSSO VFD-860-A" then
				this.is_lcditem = "NO OF ITEM=" + space(9 - len(string(this.id_detail.rowcount(), "####0"))) + string(this.id_detail.rowcount(), "####0") + "BILL TOTAL=" + space(9 - len(string(wf_grandtotal() - ld_ret_total, "#####0.00"))) + string(wf_grandtotal() - ld_ret_total, "#####0.00")
				this.is_lcditem = left(this.is_lcditem, 40)
				this.ic_comport.triggerevent("ue_show")
			else
				this.is_lcditem = "TOTAL = " + string(wf_grandtotal() - ld_ret_total, "########0.00")
				this.is_lcditem = this.is_lcditem + space(39 - len(this.is_lcditem))
				this.is_lcditem = left(this.is_lcditem, 39)
				this.ic_comport.triggerevent("ue_show")
			end if
		end if
		if wf_set_cashaccount() = 0 then
			return
		end if
		wf_setguestcheckin()
		wf_setamountoninvoice(0)
		wf_show_receivableadjustment_form()
		if wf_check_cashiershift_on_saving(this.id_master.object.cashiershiftcode[1], ll_salesmancode) < 0 then
			return
		end if
		wf_update_patientnic_from_refno()
		wf_update_patient_mobileno1_from_remarks()
		if f_stringpreferences("CheckPatientSaleInvOccurance") = "Y" and wf_check_patient_inv_period() = -1 then
			return
		end if
		if wf_check_dueitems(ll_salesmancode) = 0 then
			return
		end if
		if wf_check_patient_crlimit() <> 0 then
			return
		end if
		if wf_check_creditlimit(ll_custcode, ll_salesmancode, 1) > 0 then
			return
		end if
		if wf_show_mastercashierwindow(0) = 0 then
			return
		end if
		if this.ii_saletype = 3 and f_stringpreferences("SaleCashWindow") = "Y" and f_stringpreferences("showmastercashwinincashsale") = "N" then
			ld_ret_total = this.id_footer.getitemnumber(1, "salereturnamt")
			if isnull(ld_ret_total) then
				ld_ret_total = 0.00
			end if
			ld_invamount = this.id_footer.getitemnumber(1, "total") - ld_ret_total
			ls_cashierwindow.l_custcode = this.id_master.getitemnumber(1, "custcode")
			ls_cashierwindow.d_invamt = ld_invamount
			openwithparm(w_salesmanpassword_invtype, ls_cashierwindow)
			setfocus()
			lstr_salesman = message.powerobjectparm
			if lstr_salesman.l_salesmancode < 1 then
				return
			end if
			if lstr_salesman.b_lcd_flag then
				ld_cashtended = lstr_salesman.d_cashtended
				ld_cashbalance = lstr_salesman.d_cashbalance
				this.id_footer.object.t_balance.text = string(ld_cashbalance, "########0.00")
				if f_stringpreferences("DisplayPool") = "Y" then
					if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
						this.is_lcditem = "Cash    =" + string(ld_cashtended, "#######0.00")
						this.is_lcditem2 = "Balance =" + string(ld_cashbalance, "#######0.00")
						this.ic_comport.triggerevent("ue_show")
					elseif upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
						ls_cashtend = string(ld_cashtended, "#######0.00")
						ls_invtotal = string(ld_invamount, "########0.00")
						this.ole_lcddisplay.object.__invoke_method("showcashtender", 2, {ls_invtotal, ls_cashtend}, true)
					elseif upper(f_stringpreferences("DisplayPoolCompany")) = "TYSSO VFD-860-A" then
						ls_cashtend = string(ld_cashtended, "#####0.00")
						ls_invtotal = string(ls_invtotal, "#####0.00")
						this.is_lcditem = "CASH" + space(6) + "=" + space(9 - len(ls_cashtend)) + ls_cashtend
						ls_holdstring = "BALANCE" + space(3) + "=" + space(9 - len(string(ld_cashbalance, "#####0.00"))) + string(ld_cashbalance, "#####0.00")
						this.is_lcditem = this.is_lcditem + ls_holdstring
						this.is_lcditem = left(this.is_lcditem, 40)
						this.ic_comport.triggerevent("ue_show")
					else
						this.is_lcditem = "Cash   ="
						ls_holdstring = string(ld_cashtended, "########0.00")
						if len(ls_holdstring) < 12 then
							ls_holdstring = ls_holdstring + space(12 - len(ls_holdstring))
						else
							ls_holdstring = left(ls_holdstring, 12)
						end if
						this.is_lcditem = this.is_lcditem + ls_holdstring
						ls_holdstring = string(ld_cashbalance, "########0.00")
						if len(ls_holdstring) < 12 then
							ls_holdstring = ls_holdstring + space(12 - len(ls_holdstring))
						else
							ls_holdstring = left(ls_holdstring, 12)
						end if
						this.is_lcditem = this.is_lcditem + "Balance=" + ls_holdstring
						this.is_lcditem = this.is_lcditem + space(39 - len(this.is_lcditem))
						this.is_lcditem = left(this.is_lcditem, 39)
						this.ic_comport.triggerevent("ue_show")
					end if
				end if
				if f_stringpreferences("CashDrawer") = "Y" then
					this.ic_drawerport.object.portopen = true
					this.ic_drawerport.object.output = "A"
					this.ic_drawerport.object.portopen = false
				end if
			else
				this.id_footer.object.t_balance.text = "0.00"
				this.ib_lcdshow = true
			end if
		end if
		if wf_apply_saleman_outstandinglimit() < 0 then
			return
		end if
		if f_stringpreferences("ApplySalesTaxOnSavingBeforeUserPwd") = "N" then
			if wf_apply_salestaxschedule_on_saving(0, ll_salesmancode) < 0 then
				return
			end if
			if wf_validate_price_discount_matters(0, ll_salesmancode, this.id_detail) < 0 then
				return
			end if
			return
		end if
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_custcode = this.id_master.getitemnumber(ll_mastercurrrow, "custcode")
		ls_posted = this.id_master.object.posted[ll_mastercurrrow]
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if isnull(ll_invid) then
			li_maxretcode = wf_tabnewid("saleledger", ll_invid)
			lb_new_invoice = true
			if li_maxretcode <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~nGenerating InvCode")
				return
			end if
			if f_stringpreferences("AutoMonthSaleInvCode") = "Y" then
				if this.it_transobject.updatesaleledgerdummycounter() = -1 then
					SQL rollback USING this.it_transobject;
					messagebox("DataBase Problem", "Reasons:~r~n" + this.it_transobject.sqlerrtext)
					return
				end if
			elseif this.it_transobject.updatesaleledgerdummycounter2() = -1 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Reasons:~r~n" + this.it_transobject.sqlerrtext)
				return
			end if
			if f_stringpreferences("SepSaleInvCounterForCashCredit") = "Y" then
				if this.ii_saletype = 3 then
					ls_altersaleinvcounter = "saleledgercashdummy"
				else
					ls_altersaleinvcounter = "saleledgercreditdummy"
				end if
			else
				ls_altersaleinvcounter = "saleledgercashdummy"
			end if
			li_maxretcode = wf_tabnewid(ls_altersaleinvcounter, ll_dummyinvcode)
			if li_maxretcode <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~nGenerating alternate InvCode.")
				return
			end if
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
			if ll_dummyinvcode > 0 then
				this.id_master.setitem(ll_mastercurrrow, "altersaleinvcode", ll_dummyinvcode)
			end if
		end if
		this.id_master.getchild("headerno", ldc_headerno)
		if f_stringpreferences("Headeronsaleinv") = "N" then
			if isnull(this.id_master.object.headerno[ll_mastercurrrow]) then
				this.id_master.setitem(ll_mastercurrrow, "Headerno", ldc_headerno.getitemnumber(ll_mastercurrrow, "code"))
				ll_headerno = ldc_headerno.getitemnumber(ll_mastercurrrow, "code")
			else
				ll_headerno = this.id_master.object.headerno[ll_mastercurrrow]
			end if
			ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
			if isnull(ll_headerinvno) then
				f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
				if ll_headerinvno > 0 then
					this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
				end if
			end if
		end if
		if f_stringpreferences("Headeronsaleinv") = "Y" or gs_company = "SA" or gs_company = "EPP" then
			ll_headerno = this.id_master.getitemnumber(ll_mastercurrrow, "headerno")
			ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
			if isnull(ll_headerinvno) then
				f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
				if ll_headerinvno > 0 then
					this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
				end if
			end if
		end if
		if f_stringpreferences("generate_saletype_based_invno") <> "N" then
			if f_stringpreferences("generate_saletype_based_invno") = "G" then
				li_saletypecode = f_get_group_saletype(ll_salesmancode)
				if not isnull(li_saletypecode) then
					this.id_master.object.saletypecode[ll_mastercurrrow] = li_saletypecode
				end if
			else
				li_saletypecode = this.id_master.getitemnumber(ll_mastercurrrow, "saletypecode")
			end if
			ll_saletypeinvno = this.id_master.getitemnumber(ll_mastercurrrow, "saletypeinvno")
			if isnull(ll_saletypeinvno) then
				f_getnewsaletypeinvcode(li_saletypecode, ll_saletypeinvno, this.it_transobject)
				if ll_saletypeinvno > 0 then
					this.id_master.setitem(ll_mastercurrrow, "saletypeinvno", ll_saletypeinvno)
				end if
			end if
		end if
		ld_misccharges = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges")
		ld_misccharges1 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges1")
		ld_misccharges2 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges2")
		ld_misccharges3 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges3")
		ld_misccharges4 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges4")
		ld_misccharges5 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges5")
		ld_invdiscperc = this.id_footer.getitemnumber(ll_footercurrrow, "invdiscperc")
		ld_flatdisc = this.id_footer.getitemnumber(ll_footercurrrow, "flatdisc")
		ld_salestax = this.id_footer.getitemnumber(ll_footercurrrow, "salestax")
		ld_invgstperc1 = this.id_footer.getitemnumber(ll_footercurrrow, "InvGSTPerc1")
		ld_advancetaxamt = this.id_footer.getitemnumber(ll_footercurrrow, "advancetaxamt")
		this.id_master.setitem(ll_mastercurrrow, "discperc", ld_invdiscperc)
		this.id_master.setitem(ll_mastercurrrow, "flatdisc", ld_flatdisc)
		this.id_master.setitem(ll_mastercurrrow, "misccharges", ld_misccharges)
		this.id_master.setitem(ll_mastercurrrow, "advancetaxamt", ld_advancetaxamt)
		this.id_master.object.misccharges1[ll_mastercurrrow] = ld_misccharges1
		this.id_master.object.misccharges2[ll_mastercurrrow] = ld_misccharges2
		this.id_master.object.misccharges3[ll_mastercurrrow] = ld_misccharges3
		this.id_master.object.misccharges4[ll_mastercurrrow] = ld_misccharges4
		this.id_master.object.misccharges5[ll_mastercurrrow] = ld_misccharges5
		this.id_master.setitem(ll_mastercurrrow, "salestax", ld_salestax)
		this.id_master.setitem(ll_mastercurrrow, "InvGSTPerc1", ld_invgstperc1)
		ls_env_name = "COMPUTERNAME"
		ls_env_val = space(20)
		ll_env_len = 20
		ll_env_len = getenvironmentvariablea(ls_env_name, ls_env_val, ll_env_len)
		this.id_master.setitem(ll_mastercurrrow, "machinename", ls_env_val)
		if this.ii_saletype = 3 then
			if f_stringpreferences("showmastercashwinincashsale") = "N" then
				if lstr_salesman.l_custcode > 19 then
					this.id_master.setitem(ll_mastercurrrow, "cashreceived", 0)
					this.id_master.object.cashtendered[ll_mastercurrrow] = 0
					this.id_master.object.cashcharged[ll_mastercurrrow] = 0
					this.id_master.object.cashback[ll_mastercurrrow] = 0
					this.id_master.setitem(1, "salecatcode", 2)
					if this.id_master.object.srbufferinvcode[ll_mastercurrrow] > 0 and wf_save_salereturnascredit(this.id_master.object.srbufferinvcode[ll_mastercurrrow], lstr_salesman.l_custcode) = false then
						if lb_new_invoice then
							setnull(ll_null)
							this.id_master.setitem(1, "Code", ll_null)
							this.id_master.accepttext()
						end if
						SQL rollback USING this.it_transobject;
						return
					end if
					this.id_master.setitem(1, "custcode", lstr_salesman.l_custcode)
					SQL Select printbalance INTO :lc_printbalance FROM customer WHERE customer.custcode =:lstr_salesman.l_custcode USING this.it_transobject;
					if this.it_transobject.sqlcode <> 0 then
						if lb_new_invoice then
							setnull(ll_null)
							this.id_master.setitem(1, "Code", ll_null)
							this.id_master.accepttext()
						end if
						SQL rollback USING this.it_transobject;
						messagebox("Database problem", "Unable to get Print Balance value~r~nfor selected customer")
						return
					end if
					this.id_master.setitem(1, "printbalance", lc_printbalance)
					this.ib_printout = false
					this.id_master.accepttext()
				else
					this.id_master.setitem(ll_mastercurrrow, "cashreceived", lstr_salesman.d_cashtended)
					this.id_master.object.cashtendered[ll_mastercurrrow] = this.id_master.object.cashreceived[ll_mastercurrrow]
					if this.id_master.object.invtotal[ll_mastercurrrow] <= this.id_master.object.cashtendered[ll_mastercurrrow] then
						this.id_master.object.cashcharged[ll_mastercurrrow] = this.id_master.object.invtotal[ll_mastercurrrow]
					else
						this.id_master.object.cashcharged[ll_mastercurrrow] = this.id_master.object.cashtendered[ll_mastercurrrow]
					end if
					this.id_master.object.cashback[ll_mastercurrrow] = this.id_master.object.cashtendered[ll_mastercurrrow] - this.id_master.object.cashcharged[ll_mastercurrrow]
				end if
			else
				this.id_master.object.cashreceived[ll_mastercurrrow] = this.id_master.object.cashtendered[ll_mastercurrrow]
				if not (this.id_master.object.cashcharged[ll_mastercurrrow] = this.id_master.object.invtotal[ll_mastercurrrow] and this.ids_cashwin.rowcount() = 0) then
					this.id_master.setitem(1, "salecatcode", 2)
					this.ib_printout = false
					this.id_master.accepttext()
				end if
			end if
		end if
		choose case this.ii_saletype
		case 3
			if this.id_master.object.salecatcode[1] = 3 then
				if f_stringpreferences("RetailSalePosting") = "N" then
					this.id_master.setitem(ll_mastercurrrow, "Posted", "N")
				elseif not this.ib_modify then
					this.id_master.setitem(1, "unreceivedbalance", this.id_master.getitemdecimal(1, "invtotal"))
				end if
			elseif f_stringpreferences("CreditSalePosting") = "N" then
				this.id_master.setitem(ll_mastercurrrow, "Posted", "N")
			else
				if not this.ib_modify then
					this.id_master.setitem(1, "unreceivedbalance", this.id_master.getitemdecimal(1, "invtotal"))
				end if
				if f_stringpreferences("SaveBalanceOnSalePosting") = "Y" then
					SQL rollback USING sqlca;
					ld_balance = 0
					sqlca.openingbalance(ll_custcode, ldt_server_datetime, ld_balance)
					if sqlca.sqlcode = 0 then
						this.id_master.setitem(ll_mastercurrrow, "balance", ld_balance)
						SQL commit USING sqlca;
					else
						SQL rollback USING sqlca;
						if lb_new_invoice then
							setnull(ll_null)
							this.id_master.setitem(1, "Code", ll_null)
							this.id_master.accepttext()
						end if
						SQL rollback USING this.it_transobject;
						messagebox("Balance Saving Problem", "Unable to save balance on sales posting.")
						return
					end if
					return
				end if
			end if
		case 2
			if f_stringpreferences("CreditSalePosting") = "N" then
				this.id_master.setitem(ll_mastercurrrow, "Posted", "N")
			else
				if not this.ib_modify then
					this.id_master.setitem(1, "unreceivedbalance", this.id_master.getitemdecimal(1, "invtotal"))
				end if
				if f_stringpreferences("SaveBalanceOnSalePosting") = "Y" then
					SQL rollback USING sqlca;
					ld_balance = 0
					sqlca.openingbalance(ll_custcode, ldt_server_datetime, ld_balance)
					if sqlca.sqlcode = 0 then
						this.id_master.setitem(ll_mastercurrrow, "balance", ld_balance)
						SQL commit USING sqlca;
					else
						SQL rollback USING sqlca;
						if lb_new_invoice then
							setnull(ll_null)
							this.id_master.setitem(1, "Code", ll_null)
							this.id_master.accepttext()
						end if
						SQL rollback USING this.it_transobject;
						messagebox("Balance Saving Problem", "Unable to save balance on sales posting.")
						return
					end if
					return
				end if
			end if
			return
		end choose
		ll_counter = 0
		SQL SELECT COUNT ( *) INTO :ll_counter FROM saleledger WHERE saleledger.saleinvcode =:ll_invid USING this.it_transobject;
		if this.it_transobject.sqlcode < 0 then
			if lb_new_invoice then
				setnull(ll_null)
				this.id_master.setitem(1, "Code", ll_null)
				this.id_master.accepttext()
			end if
			ls_errtext = "DB Problem in getting existing sale invoice information.~r~nCode=" + string(this.it_transobject.sqlcode) + "~r~n" + this.it_transobject.sqlerrtext
			SQL rollback USING this.it_transobject;
			messagebox("Connection Error", ls_errtext)
			return
		end if
		if ll_counter > 0 then
			if lb_new_invoice then
				setnull(ll_null)
				this.id_master.setitem(1, "Code", ll_null)
				this.id_master.accepttext()
				ls_errtext = "Sale invoice " + string(ll_invid) + "already exists. Please Try Again.."
				SQL rollback USING this.it_transobject;
				messagebox("Saving Problem", ls_errtext)
				return
			else
				this.ib_modify = true
			end if
		end if
		if this.ib_modify then
			ll_modifycount = this.id_master.getitemdecimal(ll_mastercurrrow, "modifycounter")
			if isnull(ll_modifycount) then
				ll_modifycount = 0
			end if
			this.id_master.setitem(ll_mastercurrrow, "modifycounter", ll_modifycount + 1)
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.idt_server_datetime = ldt_server_datetime
			if f_stringpreferences("PreserveSaleInvHistory") = "Y" then
				if f_generatesaleslog(ll_invid, ldt_server_datetime, this.it_transobject) = 0 then
					lb_continue = true
				else
					if lb_new_invoice then
						setnull(ll_null)
						this.id_master.setitem(1, "Code", ll_null)
						this.id_master.accepttext()
					end if
					ls_errtext = "Failure in Saving Sales Invoice History!~r~nCode=" + string(this.it_transobject.sqlcode) + "~r~n" + this.it_transobject.sqlerrtext
					SQL rollback USING this.it_transobject;
					messagebox("Sales History!", ls_errtext)
					return
				end if
				return
			end if
			if lb_continue then
				this.ids_invoiceinfo.retrieve(ll_invid)
				for ll_count = 1 to this.id_detail.rowcount()
					ll_icode = this.id_detail.getitemnumber(ll_count, "icode")
					ll_gcode = this.id_detail.getitemnumber(ll_count, "gcode")
					ll_rowgroup = this.id_detail.getitemnumber(ll_count, "rowgroup")
					for ll_counter = 1 to this.ids_invoiceinfo.rowcount()
						if ll_icode = this.ids_invoiceinfo.getitemnumber(ll_counter, "icode") and ll_rowgroup = this.ids_invoiceinfo.getitemnumber(ll_counter, "rowgroup") and (not isnull(this.ids_invoiceinfo.getitemstring(ll_counter, "due")) and not isnull(this.id_detail.getitemstring(ll_count, "Due"))) and this.id_detail.getitemnumber(ll_count, "Dueqty") = 0.0 then
							this.id_detail.setitem(ll_count, "Due", "D")
							this.id_detail.setitem(ll_count, "Dueqty", this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty"))
						end if
					next
				next
				lb_continue = wf_returnsaleinvoice(ll_invid, ls_errtext)
			end if
		else
			this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					if lb_new_invoice then
						setnull(ll_null)
						this.id_master.setitem(1, "Code", ll_null)
						this.id_master.accepttext()
					end if
					SQL rollback USING this.it_transobject;
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.idt_server_datetime = ldt_server_datetime
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
		end if
		if this.ii_saletype = 2 then
			ll_rightfound = 0
			ll_rightfound = gds_securitywindow.find("rightcode = 582", 1, gds_securitywindow.rowcount())
			if this.id_master.getitemstring(1, "accountfor") = "Y" and f_stringpreferences("AskAmtOnCreditSale") = "Y" and f_stringpreferences("showmastercashwinincrsale") = "N" and ll_rightfound > 0 then
				this.id_master.setitem(ll_mastercurrrow, "amtby", ll_salesmancode)
				this.id_master.setitem(ll_mastercurrrow, "amtdate", ldt_server_datetime)
			end if
		end if
		if this.id_master.object.recurringagainst[ll_mastercurrrow] > 0 and lb_continue and this.it_transobject.changerecurringstatus(this.id_master.object.recurringagainst[ll_mastercurrrow], "N", ll_invid) <> 0 then
			if this.it_transobject.sqlcode = 0 then
				ls_reccurringmsg = this.it_transobject.sqlerrtext
			else
				ls_reccurringmsg = "Problem in Upation of Sale Invoice Recurring Status"
				lb_continue = false
			end if
		end if
		if lb_continue then
			this.id_saleinvdetail.reset()
			if not wf_populatesaledetail(ll_invid, this.id_saleinvdetail, ls_errtext, ll_errrowid) then
				lb_continue = false
				this.ib_commitok = false
				this.id_detail.scrolltorow(ll_errrowid)
				this.id_detail.setfocus()
			else
				this.id_detail = this.id_saleinvdetail
				setpointer(hourglass!)
				f_holdon(7)
				this.il_saleinvlist = this.il_shadowlist
				this.il_saleinvlist[1] = ll_invid
				if wf_splitsaleinvoice(lb_new_invoice) = 0 then
					ll_saveresult = wf_save_with_nocommit()
					if ll_saveresult = 0 then
						ls_posted = this.id_master.object.posted[ll_mastercurrrow]
						if ll_saveresult = 0 and f_stringpreferences("ShowItemMeterInSale") = "Y" and ls_posted = "Y" then
							this.it_transobject.updateitemmeter(trim(string(ll_invid)))
							if this.it_transobject.sqlcode <> 0 then
								ls_errtext = "Changes Not Saved in database while Updating Item Meter Reading~r~nCode=" + string(this.it_transobject.sqlcode) + "~r~n" + this.it_transobject.sqlerrtext
								messagebox("Saving Problem", ls_errtext, stopsign!, ok!, 1)
								ll_saveresult = 1
								lb_continue = false
								this.ib_commitok = false
							end if
						end if
					else
						ls_errtext = "Changes Not Saved in database due to some database problem...~r~nReturn Code=" + string(ll_saveresult) + "~r~nReason:- " + this.it_transobject.sqlerrtext
						if lb_new_invoice then
							setnull(ll_null)
							this.id_master.setitem(1, "Code", ll_null)
							this.id_master.accepttext()
						end if
						lb_continue = false
						this.ib_commitok = false
					end if
				end if
				if ll_saveresult = 0 and lb_continue = true then
					if wf_populate_receivable_adjustment(ll_invid) = 0 then
						if wf_update_cashierwindow(ll_invid) = 0 then
							ls_posted = this.id_master.object.posted[ll_mastercurrrow]
							if lb_new_invoice then
								ll_tabmaxkey = 0
								SQL SELECT TabMaxKey INTO :ll_tabmaxkey FROM _TabMaxKey WHERE TabName ='saleledger' AND TabMaxKey =:ll_invid USING this.it_transobject;
								if this.it_transobject.sqlcode = 0 then
									if ll_tabmaxkey = ll_invid then
										lb_continue = true
									else
										lb_continue = false
									end if
								else
									lb_continue = false
								end if
							end if
							if lb_continue then
								SQL commit USING this.it_transobject;
								if wf_update_image() = 0 then
									this.dw_image.reset()
									this.istr_image = this.istr_blank_image
								end if
								if upper(f_stringpreferences("showsavingmessageinsales")) = "Y" then
									messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
								end if
								if f_stringpreferences("DisplayPool") = "Y" and upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
									this.is_lcditem = "     THANK YOU"
									this.is_lcditem2 = "   FOR YOUR VISIT"
									this.ic_comport.triggerevent("ue_show")
									sleep(2)
								end if
								this.ib_commitok = true
								this.il_codevalue = ll_invid
								this.id_master.resetupdate()
								this.im_menu.m_file.m_new.enabled = true
								this.editflag = false
								if gd_recenttransdate < this.id_systemdate then
									gd_recenttransdate = this.id_systemdate
								end if
								this.dw_receivable_adjdetail.reset()
								this.dw_receivable_adjdetail.reset()
							end if
						else
							this.ib_commitok = false
							lb_continue = false
							ls_errtext = "Changes Not Saved in database for Master Cashier Window transactions."
						end if
					else
						this.ib_commitok = false
						lb_continue = false
						ls_errtext = "Changes Not Saved in database for Receivable Sale Adjustment.."
					end if
				else
					this.ib_commitok = false
					lb_continue = false
					ls_errtext = "Changes Not Saved in database due to some database problem...~r~nReturn Code=" + string(ll_saveresult)
				end if
				this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
				this.id_saleinvdetail.reset()
				if this.ib_askrefusedsale = true and ll_invid > 0 and this.ib_commitok and lb_continue then
					ll_refusedsaleresult = wf_save_refusedsale(false, ll_invid, ll_salesmancode, ldt_server_datetime)
					if ll_refusedsaleresult = 1 then
						this.lb_refusedsale_in_buffer = false
						this.dw_refusedsaleheader.reset()
						this.dw_refusedsaledetail.reset()
					else
						if lb_new_invoice then
							setnull(ll_null)
							this.id_master.setitem(1, "Code", ll_null)
							this.id_master.accepttext()
						end if
						lb_continue = false
						ls_errtext = "Changes Not Saved in database for Refused Sale Items"
						SQL rollback USING this.it_transobject;
						messagebox("Saving Problem", ls_errtext, stopsign!, ok!, 1)
					end if
				end if
				this.id_saleinvdetail.reset()
				if this.ib_commitok then
					this.ib_modify = false
				elseif lb_new_invoice then
					setnull(ll_null)
					this.id_master.setitem(1, "Code", ll_null)
					this.id_master.accepttext()
					lb_continue = false
				end if
			end if
		end if
		if not lb_continue then
			if lb_new_invoice then
				setnull(ll_null)
				this.id_master.setitem(1, "Code", ll_null)
				this.id_master.accepttext()
				lb_continue = false
			end if
			SQL rollback USING this.it_transobject;
			messagebox("Saving Problem", ls_errtext + " Error in current row", stopsign!)
			return
		else
			if f_stringpreferences("IncSaleInActMonitor") = "Y" and this.ib_commitok then
				SQL rollback USING this.it_transobject;
				ll_counter2 = 0
				for ll_counter2 = 1 to upperbound(this.il_saleinvlist)
					this.it_transobject.updateactivitymonitor("SV", this.il_saleinvlist[ll_counter2])
					if this.it_transobject.sqlcode <> 0 then
						ls_errtext = "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext
						SQL rollback USING this.it_transobject;
						messagebox("Activity Monitor", ls_errtext)
					else
						SQL commit USING this.it_transobject;
					end if
				next
			end if
			if f_stringpreferences("ShowSaleInCashierActivity") = "Y" and this.ib_commitok then
				SQL rollback USING this.it_transobject;
				ll_counter2 = 0
				for ll_counter2 = 1 to upperbound(this.il_saleinvlist)
					this.it_transobject.updatecashieractivity(this.ii_module, this.il_saleinvlist[ll_counter2])
					if this.it_transobject.sqlcode <> 0 then
						ls_errtext = "Problem in updating cashier activity.~r~nReasons are:- " + this.it_transobject.sqlerrtext
						SQL rollback USING this.it_transobject;
						messagebox("Activity Monitor", ls_errtext)
					else
						SQL commit USING this.it_transobject;
					end if
				next
			end if
			if gs_allowsmsfunctions = "Y" and ls_posted = "Y" and this.ib_commitok then
				SQL rollback USING this.it_transobject;
				ll_counter2 = 0
				ls_invlist = ""
				for ll_counter2 = 1 to upperbound(this.il_saleinvlist)
					ls_invlist = ls_invlist + trim(string(this.il_saleinvlist[ll_counter2])) + ","
				next
				ls_invlist = left(ls_invlist, len(ls_invlist) - 1)
				this.it_transobject.createautotriggersms(ls_invlist, this.ii_module, "Posting")
				if this.it_transobject.sqlcode <> 0 then
					ls_errtext = "Problem in Generating Auto Triggered SMS.~r~nReasons are:- " + this.it_transobject.sqlerrtext
					SQL rollback USING this.it_transobject;
					messagebox("Auto Triggered SMS", ls_errtext)
				else
					SQL commit USING this.it_transobject;
				end if
			end if
			if f_stringpreferences("AutoFiscalizeOnPosting") = "Y" and ls_posted = "Y" and this.ib_commitok then
				SQL rollback USING this.it_transobject;
				ll_counter2 = 0
				for ll_counter2 = 1 to upperbound(this.il_saleinvlist)
					f_fiscalizesaleinvoice(ll_invid)
				next
			end if
			if f_stringpreferences("ApplyLoyaltypolicyonsaleposting") = "Y" and ls_posted = "Y" and this.ib_commitok then
				SQL rollback USING this.it_transobject;
				ll_counter2 = 0
				for ll_counter2 = 1 to upperbound(this.il_saleinvlist)
					this.it_transobject.manageloyaltypoints("SV", this.il_saleinvlist[ll_counter2])
					if this.it_transobject.sqlcode <> 0 then
						ls_errtext = "Problem in updating loyalty points for this account.~r~nReasons are:- " + this.it_transobject.sqlerrtext
						SQL rollback USING this.it_transobject;
						messagebox("Loyalty Points Updation", ls_errtext)
					else
						SQL commit USING this.it_transobject;
					end if
				next
			end if
		end if
	else
		setfocus()
	end if
	if lb_continue = false or this.ib_commitok = false then
		if lb_new_invoice then
			setnull(ll_null)
			this.id_master.setitem(1, "Code", ll_null)
			this.id_master.accepttext()
		end if
		this.ib_commitok = false
		lb_continue = false
		SQL rollback USING this.it_transobject;
		messagebox("Last Attempt To Rollback", ls_errtext + "~r~nTransaction Rollback.")
		return
	end if
	setpointer(arrow!)

// w_sale.ue_newform() returns 0 [event]
	integer rtncode
	integer li_defaultgcode
	integer li_ismodifysaleprice_dw
	integer li_ismodifysaleprice_uw
	integer li_ismodifyitemdiscperc
	integer li_ismodifyitemflatdisc
	integer li_rtncode
	integer li_modifysalestax
	integer li_modifybonusqty
	integer li_viewstock
	integer li_viewtotalstock
	long li_fetched_code
	long row
	long ll_manfcode
	long ll_counter
	long ll_custcode
	long ll_smancode
	long ll_found
	long ll_gstperc
	long ll_doctcode
	double ld_invdiscperc
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_text1
	string ls_text2
	string ls_custcode
	string ls_doctcode
	m_salemenu lm_menu
	dwitemstatus ldw_status
	call super::ue_newform
	lm_menu = this.menuid
	if f_stringpreferences("AllowCustomerInCashSale") = "Y" and this.ii_saletype = 3 and this.idc_customers.rowcount() > 0 then
		ls_custcode = f_stringpreferences("defaultcustomerincashsale")
		if ls_custcode = "-1" then
			ll_custcode = this.idc_customers.getitemnumber(1, "accounts_acccode")
		else
			ll_custcode = long(ls_custcode)
		end if
		this.id_master.object.custcode[1] = ll_custcode
		this.id_master.accepttext()
		post wf_setcustomerinfo(1, 1, string(ll_custcode))
	end if
	ls_doctcode = f_stringpreferences("DefaultDoctorInSale")
	if ls_doctcode = "-1" then
		setnull(ll_doctcode)
	else
		ll_doctcode = long(ls_doctcode)
	end if
	this.id_master.object.doctcode[1] = ll_doctcode
	post wf_set_doctorinfo(ll_doctcode)
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.dw_image.reset()
	this.dw_document.reset()
	this.dw_refusedsaleheader.reset()
	this.dw_refusedsaledetail.reset()
	wf_assign_master_cash_win_object()
	wf_assign_saleset_objects()
	this.dw_receivable_adjdetail.reset()
	wf_update_virtualgl()
	this.il_norcotixcode = -1
	this.im_menu.m_file.m_print.enabled = true
	lm_menu.m_file.m_postwrtpatient.enabled = false
	lm_menu.m_file.m_postsaleheaderwise.enabled = false
	lm_menu.m_file.m_deletesaleinvoice.enabled = false
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 708", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_saveandpost.enabled = true
		lm_menu.m_file.m_saveandpost.visible = true
	end if
	wf_protectdw(this.id_master, 0)
	this.id_detail.setredraw(false)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.id_detail.setredraw(true)
	this.ib_modify = false
	wf_enable_customer_in_cashsale()
	wf_setgodownoption()
	li_ismodifyitemdiscperc = 1
	li_ismodifyitemflatdisc = 1
	li_modifysalestax = 1
	li_modifybonusqty = 1
	li_viewstock = 0
	li_viewtotalstock = 0
	li_ismodifysaleprice_dw = 0
	li_ismodifysaleprice_dw = gds_securitywindow.find("rightcode = 511", 1, gds_securitywindow.rowcount())
	li_ismodifysaleprice_uw = 0
	li_ismodifysaleprice_uw = gds_securitywindow.find("rightcode = 701", 1, gds_securitywindow.rowcount())
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 516 then
			li_ismodifyitemdiscperc = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 517 then
			li_ismodifyitemflatdisc = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 520 then
			li_modifysalestax = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 596 then
			li_modifybonusqty = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 535 then
			li_viewstock = 1
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 536 then
			li_viewtotalstock = 1
		end if
	next
	this.id_footer.object.t_stock.visible = li_viewstock
	this.id_footer.object.stock.visible = li_viewstock
	this.id_footer.object.t_totalstock.visible = li_viewtotalstock
	this.id_footer.object.totalstock.visible = li_viewtotalstock
	this.id_footer.object.t_balance.text = "0.00"
	this.id_detail.object.bonusqty.protect = li_modifybonusqty
	this.id_detail.object.bonuspackqtyforsale.protect = li_modifybonusqty
	if li_ismodifysaleprice_dw > 0 or li_ismodifysaleprice_uw > 0 then
		if li_ismodifysaleprice_dw > 0 and li_ismodifysaleprice_uw = 0 then
			if f_stringpreferences("SaleOnZeroPrice") = "N" then
				this.id_detail.setvalidate("Saleprice", "REAL(GetText( )) > 0  AND Real(GetText()) <= rate")
			else
				this.id_detail.setvalidate("Saleprice", "REAL(GetText( )) >= 0 AND Real(GetText()) <= rate")
			end if
		elseif li_ismodifysaleprice_dw = 0 and li_ismodifysaleprice_uw > 0 then
			if f_stringpreferences("SaleOnZeroPrice") = "N" then
				this.id_detail.setvalidate("Saleprice", "REAL(GetText( )) > 0 AND Real(GetText()) >= rate")
			else
				this.id_detail.setvalidate("Saleprice", "REAL(GetText( )) >= 0 AND Real(GetText()) >= rate")
			end if
		elseif f_stringpreferences("SaleOnZeroPrice") = "N" then
			this.id_detail.setvalidate("Saleprice", "REAL(GetText( )) > 0")
		else
			this.id_detail.setvalidate("Saleprice", "REAL(GetText( )) >= 0")
		end if
		this.id_detail.object.saleprice.protect = 0
	else
		this.id_detail.object.saleprice.protect = 1
	end if
	this.id_master.object.headerno.protect = 0
	this.id_detail.object.discperc.protect = li_ismodifyitemdiscperc
	this.id_detail.object.itemflatdisc.protect = li_ismodifyitemflatdisc
	this.id_detail.object.unitsalestax.protect = li_modifysalestax
	this.id_detail.object.gstperc.protect = li_modifysalestax
	if not wf_validatedate() then
		close(this)
	else
		if this.ii_saletype = 3 then
			ll_custcode = this.id_master.getitemnumber(1, "custcode")
			SQL Select invdiscperc , salesmancode , defaultgst INTO :ld_invdiscperc, :ll_smancode, :ll_gstperc From Customer Where custcode =:ll_custcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
			end if
			this.id_master.object.smancode[1] = ll_smancode
			this.id_master.object.dd_gstperc[1] = ll_gstperc
		else
			this.id_master.setfocus()
		end if
		wf_visible(true)
		wf_set_lastinv_columns()
	end if
	li_rtncode = this.id_master.getchild("patientcode", this.idc_patient)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_patient.settransobject(this.it_transobject)
	wf_patient_retrieve()
	li_rtncode = this.id_master.getchild("guestcode", this.idc_guest)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_guest.settransobject(this.it_transobject)
	wf_guest_retrieve()
	li_rtncode = this.id_master.getchild("studentcode", this.idc_student)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_student.settransobject(this.it_transobject)
	wf_student_retrieve()
	if f_stringpreferences("DisplayPool") = "Y" then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
			setnull(this.is_lcditem)
			this.ic_comport.triggerevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
			setnull(this.is_lcditem)
			this.ic_comport.triggerevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
			this.is_lcditem = space((20 - len(trim(left(f_reportheaderinfosale("clientname", this.id_master.object.headerno[1]), 20)))) / 2.0) + upper(trim(left(f_reportheaderinfosale("clientname", this.id_master.object.headerno[1]), 20)))
			this.is_lcditem2 = "WELCOME YOU AT SALES"
			this.ic_comport.triggerevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
			this.ole_lcddisplay.object.enablegreeting = true
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "TYSSO VFD-860-A" then
			this.is_lcditem = " WE WELCOME YOU AT  " + space((20 - len(trim(left(f_reportheaderinfosale("clientname", this.id_master.object.headerno[1]), 20)))) / 2.0) + upper(trim(left(f_reportheaderinfosale("clientname", this.id_master.object.headerno[1]), 20)))
			this.ic_comport.triggerevent("ue_show")
		else
			this.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
			this.ic_comport.triggerevent("ue_show")
		end if
	end if
	this.ib_lcdshow = true
	this.ii_focuscustomer = 2
	if this.ib_modifydate then
		if this.ib_fetchserverdate then
			wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
			this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
		else
			this.id_master.setitem(this.id_master.getrow(), "date", today())
		end if
	end if
	this.il_custcode = 0
	this.il_allowedcustomer = 0
	this.id_master.setitem(1, "SaleComments1", f_stringpreferences("SaleComments1"))
	this.id_master.setitem(1, "SaleComments2", f_stringpreferences("SaleComments2"))
	this.id_master.object.currencycode[1] = f_numberpreferences("defaultcurrencyinsale")
	wf_apply_currency(this.id_master.object.currencycode[1])
	this.id_master.object.advancetax[1] = this.ic_advancetaxonsale
	this.id_master.object.p_itemimage.filename = ""
	lm_menu.m_file.m_postareawise.enabled = false
	ldw_status = this.id_detail.getitemstatus(1, "looseqty", primary!)
	wf_link_to_cashiershift()
	post event ue_enforcedefaultfocussettings(0)
	this.il_myrowid = 1

// w_sale.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect = 1
	integer li_ismodifysaleprice
	integer li_ismodifyitemdiscperc
	integer li_ismodifyitemflatdisc
	integer li_modifysalestax
	integer li_modifyheaderno
	integer li_modifybonusqty
	long ll_row
	long ll_code
	long ll_counter = 1
	long ll_admissioncode
	long ll_allowed
	long ll_custcode
	long ll_refinvcode
	long ll_found
	long ll_icode
	boolean lb_flag
	boolean lb_modify
	m_salemenu lm_menu
	long ll_rowcount
	long ll_validinv
	double ld_code
	lm_menu = this.menuid
	this.tab_retrieve.tabpage_list.em_invno.getdata(ld_code)
	if ld_code = 0.0 then
		ld_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	else
		if this.ii_saletype = 3 then
			SQL select count ( *) , MAX ( admissioncode ) INTO :ll_validinv, :ll_admissioncode from Saleledger where saleinvcode =:ld_code and salecatcode =:this.ii_saletype and impactinventory ='Y' USING this.it_transobject;
		else
			SQL select count ( *) , MAX ( admissioncode ) INTO :ll_validinv, :ll_admissioncode from Saleledger where saleinvcode =:ld_code and impactinventory ='Y' USING this.it_transobject;
		end if
		if ll_validinv <> 1 then
			this.id_detail.reset()
			messagebox("Invoice Validation", "Invoice does not exist, or ~r~n it does not belong to current sale type")
			this.tab_retrieve.selecttab(2)
			return
		end if
		if not isnull(ll_admissioncode) then
			this.id_detail.reset()
			messagebox("Invoice Validation", "Use In-Patient Sale to Open this invoice")
			this.tab_retrieve.selecttab(2)
			return
		end if
	end if
	if wf_isdeleted(ld_code) = true then
		messagebox("Invoice Validation", "Can not Modify Deleted Sales Invoice")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if wf_isinvoiceinuse(ld_code) = true then
		messagebox("Invoice Validation", "Sale Invoice already in use by some other user.~r~nKindly try again after sometime or open some other invoice.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if wf_allowsalemodification(ld_code, this.il_groupcode, this.il_strategy) <> 0 then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "You Can not modify this Invoice,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	this.dw_refusedsaleheader.reset()
	this.dw_refusedsaledetail.reset()
	if this.ib_askrefusedsale = true and wf_get_refusedsaleinvcode(ld_code, ll_refinvcode) = 0 and ll_refinvcode > 0 then
		this.dw_refusedsaleheader.retrieve(ll_refinvcode)
		this.dw_refusedsaledetail.retrieve(ll_refinvcode)
	end if
	this.dw_receivable_adjdetail.reset()
	this.dw_receivable_adjdetail.retrieve(ld_code)
	if f_stringpreferences("GroupCustomerCategory") = "Y" and this.ii_saletype = 2 then
		SQL Select custcode INTO :ll_custcode From SaleLedger Where saleinvcode =:ld_code USING sqlca;
		ll_allowed = 0
		this.it_transobject.isallowedcustomergroupcategory(this.il_groupcode, ll_custcode, ll_allowed)
		if this.it_transobject.sqlcode = 0 then
			if ll_allowed < 1 then
				this.id_detail.reset()
				messagebox("Group Customer Category Validation", "Current user group does not have enough permissions w.r.t customers~r~n" + "to open the selected invoice.~r~nPossible reasons are selected invoice customer has customer cateogry ~r~n which is not allowed to this user group.")
				wf_selectunselectrow(1)
				this.tab_retrieve.selecttab(2)
				return
			end if
		end if
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 708", 1, gds_securitywindow.rowcount())
	if this.id_list.rowcount() > 0 and (ll_found > 0 and this.id_list.object.posted[this.id_list.getrow()] = "N") then
		lm_menu.m_file.m_saveandpost.enabled = true
		lm_menu.m_file.m_saveandpost.visible = true
	end if
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.im_menu.m_file.m_print.enabled = true
	this.i_editmode = 2
	this.i_retrievemode = 2
	this.id_dwcontrol = this.id_master
	ll_rowcount = wf_retrieve(ld_code)
	this.id_master.setrow(1)
	this.id_master.scrolltorow(1)
	this.id_dwcontrol = this.id_footer
	wf_retrieve(ld_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	this.id_dwcontrol = this.id_detail
	wf_retrieve(ld_code)
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	this.id_dwcontrol = this.id_list
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	lm_menu.m_file.m_postwrtpatient.enabled = false
	lm_menu.m_file.m_postsaleheaderwise.enabled = false
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		if this.ii_saletype = 2 and this.ib_creditmodify then
			lb_modify = true
		end if
		if this.ii_saletype = 3 and this.ib_retailmodify then
			lb_modify = true
		end if
	end if
	if not lb_modify then
		this.im_menu.m_file.m_save.enabled = false
		this.editflag = false
	else
		li_protect = 0
		wf_initmodify(li_protect)
		if this.ii_saletype = 3 then
			if f_stringpreferences("itemcode") = "Y" then
				this.id_detail.setcolumn("fullcode")
				this.id_detail.setfocus()
			else
				this.id_detail.setcolumn("itemname")
				this.id_detail.setfocus()
			end if
		end if
	end if
	if this.id_master.object.code[this.id_master.rowcount()] > 0 then
		this.ids_cashwin.retrieve(ld_code)
	else
		wf_assign_master_cash_win_object()
		wf_assign_saleset_objects()
	end if
	if this.id_master.rowcount() > 0 and this.id_master.object.patientcode[1] > 0 then
		this.dw_image.retrieve(this.id_master.object.patientcode[1])
		wf_populate_image(this.id_master.object.patientcode[1])
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	wf_protectdw(this.dw_image, li_protect)
	wf_protectdw(this.dw_refusedsaleheader, li_protect)
	wf_protectdw(this.dw_refusedsaledetail, li_protect)
	if li_protect = 0 then
		wf_enable_customer_in_cashsale()
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_salegodown
	end if
	if li_protect = 0 and this.ii_saletype = 2 and this.id_master.getitemnumber(this.id_master.getrow(), "custcode") = 19.0 then
		this.id_master.setitem(this.id_master.getrow(), "salecatcode", 2)
	end if
	wf_setgodownoption()
	this.il_custcode = this.id_master.getitemnumber(1, "custcode")
	if li_protect = 0 then
		li_ismodifysaleprice = 1
		li_ismodifyitemdiscperc = 1
		li_ismodifyitemflatdisc = 1
		li_modifysalestax = 1
		li_modifyheaderno = 1
		li_modifybonusqty = 1
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 511 then
				li_ismodifysaleprice = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 516 then
				li_ismodifyitemdiscperc = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 517 then
				li_ismodifyitemflatdisc = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 520 then
				li_modifysalestax = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 557 then
				li_modifyheaderno = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 596 then
				li_modifybonusqty = 0
			end if
		next
		this.id_detail.object.saleprice.protect = li_ismodifysaleprice
		this.id_detail.object.discperc.protect = li_ismodifyitemdiscperc
		this.id_detail.object.itemflatdisc.protect = li_ismodifyitemflatdisc
		this.id_detail.object.unitsalestax.protect = li_modifysalestax
		this.id_detail.object.gstperc.protect = li_modifysalestax
		this.id_master.object.headerno.protect = li_modifyheaderno
		this.id_detail.object.bonusqty.protect = li_modifybonusqty
		this.id_detail.object.bonuspackqtyforsale.protect = li_modifybonusqty
	end if
	if f_stringpreferences("discpriceinsale") = "Y" then
		wf_setdiscprice()
	end if
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	wf_grandtotal()
	lm_menu.m_file.m_deletesaleinvoice.enabled = false
	this.id_master.object.p_itemimage.filename = ""
	if this.id_master.object.posted[1] = "N" then
		ll_custcode = this.id_master.object.custcode[1]
		if this.id_detail.rowcount() > 0 and ll_custcode > 0 then
			ll_icode = this.id_detail.object.icode[1]
			wf_setcustomerlatestnetrate(ll_custcode, ll_icode, 1)
			wf_setcustomerlatestsaleprice(ll_custcode, ll_icode, 1)
			wf_setcustomerbalance(ll_custcode)
		end if
	end if
	post event ue_enforcedefaultfocussettings(1)
	setredraw(true)
	lm_menu.m_file.m_postareawise.enabled = false

// w_sale.ue_newitem() returns 0 [event]
	integer li_defaultgcode
	long ll_currentrow
	long ll_rowcount
	long ll_insrow
	setnull(this.is_aliasname)
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("enablequickprefferedsearch") = "Y" then
		this.id_detail.setcolumn("quicksearch")
	elseif f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	if f_stringpreferences("AutoSelectLastGodownInSale") = "Y" and this.id_detail.rowcount() > 0 then
		this.id_detail.object.gcode.initial = string(this.id_detail.object.gcode[this.id_detail.rowcount()])
	end if
	ll_currentrow = this.id_detail.getrow()
	ll_rowcount = this.id_detail.rowcount()
	if ll_currentrow = ll_rowcount then
		ll_insrow = this.id_detail.insertrow(0)
	else
		ll_insrow = this.id_detail.insertrow(ll_currentrow)
	end if
	this.id_detail.scrolltorow(ll_insrow)
	this.il_myrowid = this.il_myrowid + 1
	if ll_insrow > 0 then
		this.id_detail.object.myrowid[ll_insrow] = this.il_myrowid
	end if
	this.id_detail.setfocus()
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true
	this.ii_defaultgcode = this.ii_salegodown

// w_sale.ue_deleteitem() returns 0 [event]
	long ll_row
	long ll_footerrow
	long ll_icode
	long ll_usercode
	long ll_groupcode
	long ll_count
	long ll_currow
	long ll_detailrows
	dwruntimeerror myexc
	u_deleted_saleitemlog lu_deleted_saleitemlog
	ll_usercode = gl_usercode
	this.ib_itemvalidated = true
	if this.id_detail.getrow() > 0 then
		try
			ll_icode = this.id_detail.object.icode[this.id_detail.getrow()]
		catch (throwable myexc)
		end try
		if not isnull(ll_icode) and this.id_detail.getrow() > 0 then
			this.id_detail.rowscopy(this.id_detail.getrow(), this.id_detail.getrow(), primary!, this.ids_itemrecyclebin, this.ids_itemrecyclebin.rowcount() + 1, primary!)
			if f_stringpreferences("PreserveDeletedSaleItemsLog") = "Y" then
				lu_deleted_saleitemlog.of_generatelog(this.id_detail, this.id_detail.getrow(), this.id_master.object.code[1], ll_usercode)
			end if
		end if
		wf_set_salesets_data(this.id_detail.getrow(), ll_icode, 1, 0)
		this.id_detail.deleterow(0)
		ll_detailrows = this.id_detail.rowcount()
		if ll_detailrows < 1 then
			this.im_menu.m_file.m_save.enabled = false
		end if
		wf_grandtotal()
		ll_row = this.id_detail.getrow()
		ll_footerrow = this.id_footer.getrow()
		if this.id_detail.rowcount() > 0 and ll_row > 0 then
			this.id_footer.setitem(ll_footerrow, "icode", this.id_detail.getitemnumber(ll_row, "icode"))
			this.id_footer.setitem(ll_footerrow, "stock", this.id_detail.getitemnumber(ll_row, "stock"))
			this.id_footer.setitem(ll_footerrow, "piecesinhand", this.id_detail.getitemnumber(ll_row, "piecesinhand"))
			return
		end if
		this.id_footer.setitem(ll_footerrow, "icode", 0)
		this.id_footer.setitem(ll_footerrow, "stock", 0)
		this.id_footer.setitem(ll_footerrow, "piecesinhand", 0)
		this.im_menu.m_file.m_print.enabled = false
		this.im_menu.m_file.m_save.enabled = false
	end if

// w_sale.close() returns long [event]
	long ancestorreturnvalue
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	if f_stringpreferences("DisplayPool") = "Y" then
		try
			if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
				this.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
				postevent("ue_show")
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
				this.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
				this.ic_comport.triggerevent("ue_show")
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				this.is_lcditem = "     THANK YOU"
				this.is_lcditem2 = "   FOR YOUR VISIT"
				this.ic_comport.triggerevent("ue_show")
				pd_closeusbpd()
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
				this.ole_lcddisplay.object.enablegreeting = true
				this.ole_lcddisplay.object.__invoke_method("stopdisplay", 0, {}, true)
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "TYSSO VFD-860-A" then
				this.is_lcditem = space(5) + "THANK YOU" + space(6) + space(3) + "FOR YOUR VISIT" + space(3)
				this.ic_comport.triggerevent("ue_show")
			else
				this.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
				this.ic_comport.triggerevent("ue_show")
			end if
		catch (throwable exdw)
			messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
		catch (throwable exnullobj)
			messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
		catch (throwable ex)
			messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
		end try
	end if
	return 1

// w_sale.ue_list() returns 0 [event]
	long ll_row
	m_salemenu lm_menu
	call super::ue_list
	lm_menu = this.menuid
	SQL rollback USING this.it_transobject;
	if this.ib_cashsaleposting and this.ii_saletype = 3 then
		this.im_menu.m_file.m_post.enabled = true
	elseif this.ib_creditsaleposting and this.ii_saletype = 2 then
		this.im_menu.m_file.m_post.enabled = true
	else
		this.im_menu.m_file.m_post.enabled = false
	end if
	lm_menu.m_file.m_saveandpost.enabled = false
	lm_menu.m_file.m_saveandpost.visible = false
	this.im_menu.m_file.m_print.enabled = false
	lm_menu.m_file.m_postwrtpatient.enabled = true
	lm_menu.m_file.m_postsaleheaderwise.enabled = true
	lm_menu.m_file.m_deletesaleinvoice.enabled = true
	lm_menu.m_file.m_postareawise.enabled = true
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	this.tab_retrieve.tabpage_list.em_invno.selecttext(1, 7)
	this.tab_retrieve.tabpage_list.em_invno.clear()
	this.il_norcotixcode = -1
	ll_row = wf_retrievelist()
	wf_disabledetailtab(ll_row)
	post event ue_enableprint()

// w_sale.ue_print() returns 0 [event]
	boolean lb_postonprint
	long ll_custcode
	long ll_row
	long ll_invcode
	long ll_counter = 1
	long ll_draftprint
	string ls_defaultinfo
	string ls_currentprinter
	string ls_qrcode
	string ls_fiscalinvoiceno
	string ls_custname
	string ls_posted
	string ls_invoicesize
	integer li_option
	integer li_reprintingcounter
	integer li_printretcode
	integer li_headerno
	integer li_salecatcode
	double ld_balance
	boolean lb_listtab
	s_datastore lstr
	runtimeerror ex
	long ll_job
	string ls_printer
	lb_postonprint = wf_postsale_on_print()
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false and lb_postonprint = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
			else
				event ue_newitem()
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
		ls_fiscalinvoiceno = this.id_list.object.fiscalinvoiceno[this.id_list.getrow()]
		if wf_isdeleted(ll_invcode) = true then
			messagebox("Selection Validation", "Can not print deleted sales invoice~r~nPlease select a valid sales invoice")
			return
		end if
		ls_posted = this.id_list.object.posted[this.id_list.getrow()]
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
		ls_posted = this.id_master.object.posted[1]
		ls_fiscalinvoiceno = this.id_master.object.fiscalinvoiceno[1]
	end if
	if f_stringpreferences("allowunpostedsaleinvprint") = "N" and upper(ls_posted) = "N" then
		if lb_listtab then
			return
		else
			postevent("ue_new")
			return
		end if
		return
	end if
	if ll_invcode < 0 or isnull(ll_invcode) then
		return
	end if
	SQL SELECT ISNULL ( reprintingcounter , 0 ) , invoicesize , salecatcode INTO :li_reprintingcounter, :ls_invoicesize, :li_salecatcode FROM saleledger WHERE saleinvcode =:ll_invcode USING this.it_transobject;
	li_reprintingcounter = li_reprintingcounter + 1
	SQL update SaleLedger SET ReprintingCounter =:li_reprintingcounter WHERE saleinvcode =:ll_invcode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Database Error", "Some database problem has occur")
		SQL rollback USING this.it_transobject;
		return
	else
		SQL commit USING this.it_transobject;
	end if
	if this.ii_saletype = 2 then
		this.ib_printout = false
	end if
	ll_draftprint = wf_select_draft_printout(ll_invcode)
	if ll_draftprint = 0 then
		wf_selectprintreport(ls_invoicesize)
		if lb_listtab then
			li_headerno = this.id_list.getitemnumber(this.id_list.getrow(), "headerno")
		else
			li_headerno = this.id_master.getitemnumber(1, "headerno")
		end if
		this.id_print.retrieve(ll_invcode)
		if this.id_print.rowcount() > 0 then
			try
				ls_fiscalinvoiceno = this.id_print.object.fiscalinvoiceno[1]
				if len(ls_fiscalinvoiceno) > 0 then
					ls_qrcode = ls_fiscalinvoiceno
					wf_gen_qrcode(ll_invcode, ls_qrcode)
				end if
			catch (throwable ex)
			end try
		end if
		if isnull(ls_fiscalinvoiceno) then
			ls_fiscalinvoiceno = ""
		end if
		if this.ic_autofiscalize = "Y" and this.ic_printunfiscalizedinvoice = "N" and len(ls_fiscalinvoiceno) <= 0 then
			if lb_listtab then
				return
			else
				if this.im_menu.m_file.m_save.enabled = true then
					postevent("ue_new")
				end if
				return
			end if
			return
		end if
		if gs_company = "DWSMALLCREDIT" and ls_invoicesize = "F" then
			for ll_counter = 2 to this.id_print.rowcount()
				this.id_print.setitem(ll_counter + 1, "cumulativesum", this.id_print.getitemnumber(ll_counter, "c_pagesum"))
				this.id_print.setitem(ll_counter, "cumulativesumfoot", this.id_print.getitemnumber(ll_counter, "c_pagesum"))
			next
		end if
		if f_stringpreferences("CustBalanceOnPrintOut") = "Y" and (this.id_master.getitemstring(1, "invoicesize") = "F" or this.id_master.getitemstring(1, "invoicesize") = "H" or this.id_master.getitemstring(1, "invoicesize") = "Q" or this.id_master.getitemstring(1, "invoicesize") = "T") and li_salecatcode = 2 and gs_company <> "SA" and this.id_print.getitemstring(1, "Posted") = "N" then
			ll_custcode = this.id_print.getitemnumber(1, "CustCode")
			SQL rollback USING sqlca;
			ld_balance = 0
			sqlca.absoluteopeningbalance(ll_custcode, ld_balance)
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
				messagebox("Balance Problem", "Unable to fetch balance on sales printing.")
				return
			end if
			this.id_print.setitem(this.id_print.rowcount(), "balance", ld_balance)
		end if
		if lb_listtab then
			lstr.s_module = "sale"
			lstr.dw = this.id_print
			lstr.s_name1 = this.id_print.dataobject
			openwithparm(w_preview_invoices, lstr)
			lstr = message.powerobjectparm
			if lstr.i_closemode = -1 then
				li_reprintingcounter = li_reprintingcounter - 1
				SQL update SaleLedger SET ReprintingCounter =:li_reprintingcounter WHERE saleinvcode =:ll_invcode USING this.it_transobject;
				if this.it_transobject.sqlcode <> 0 then
					messagebox("Database Error", "Some database problem has occur during updation of reprinting counter.")
					SQL rollback USING this.it_transobject;
					return
				else
					SQL commit USING this.it_transobject;
				end if
				return
			end if
		end if
		if f_stringpreferences("saleaskforcopies") = "Y" then
			open(w_printer_copies)
			this.id_print.object.datawindow.print.copies = string(message.doubleparm)
		end if
		ls_defaultinfo = printgetprinter()
		ls_currentprinter = left(ls_defaultinfo, pos(ls_defaultinfo, "~t") - 1)
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
			if this.im_menu.m_file.m_save.enabled = true then
				postevent("ue_new")
			end if
			return
		end if
		if this.id_print.rowcount() > 0 then
			wf_setimgonprint(1)
			if ls_invoicesize = "T" then
				ll_job = printopen("waseela", false)
				if ll_job = -1 then
					messagebox("Error", "Unable to Open Print Job for Label printing")
				else
					printdatawindow(ll_job, this.id_print)
					printclose(ll_job)
					li_printretcode = 0
				end if
			else
				li_printretcode = this.id_print.print()
			end if
			wf_setimgonprint(0)
			if li_printretcode < 0 then
				messagebox("Printing", "Can not Print Invoice", information!)
			else
				wf_print_storesummary(ll_invcode)
				if f_stringpreferences("CashDrawerWithPrinter") = "Y" and lb_listtab = false then
					ls_printer = f_stringpreferences("CashDrawerPrinter")
					if ls_printer = "" or isnull(ls_printer) then
						messagebox("Cash Drawer Printer", "Cash Drawer Printer name not found.~r~nSuggested Option is check Cash Drawer Printer name in Preferences.")
					else
						this.ic_cashdrawerprinter.object.__invoke_method("opendrawer", 4, {ls_printer, 10, "Control", 65}, true)
					end if
				end if
			end if
			printsetprinter(trim(ls_currentprinter))
			if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
				postevent("ue_new")
			end if
		else
			messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
		end if
		return
	end if
	if this.im_menu.m_file.m_save.enabled = true then
		postevent("ue_new")
	end if

// w_sale.ue_refreshddw() returns 0 [event]
	long ll_prow
	long ll_pcode
	call super::ue_refreshddw
	setpointer(hourglass!)
	this.idc_customers.setredraw(false)
	this.idc_customers.settransobject(this.it_transobject)
	this.idc_customers.retrieve()
	this.idc_customers.setredraw(true)
	this.idc_price.settransobject(this.it_transobject)
	this.idc_price.retrieve(this.ii_module, this.il_groupcode)
	this.idc_doctors.setredraw(false)
	this.idc_doctors.settransobject(this.it_transobject)
	this.idc_doctors.retrieve()
	this.idc_doctors.setredraw(true)
	this.idc_patient.setredraw(false)
	this.idc_patient.settransobject(this.it_transobject)
	if this.ic_retrievepatientlist <> "N" then
		this.idc_patient.retrieve(this.ii_salemodule)
	end if
	if this.idc_patient.rowcount() = 0 then
		ll_prow = this.idc_patient.insertrow(0)
		setnull(ll_pcode)
		this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
		this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
		this.idc_patient.setitem(ll_prow, "name", "<NONE>")
		this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
		this.idc_patient.setitem(ll_prow, "city", "<NONE>")
		this.idc_patient.scrolltorow(ll_prow)
	end if
	this.idc_patient.setredraw(true)
	this.idc_guest.setredraw(false)
	this.idc_guest.settransobject(this.it_transobject)
	this.idc_guest.retrieve()
	this.idc_guest.setredraw(false)
	this.idc_student.setredraw(false)
	this.idc_student.settransobject(this.it_transobject)
	this.idc_student.retrieve()
	this.idc_student.setredraw(false)
	setpointer(arrow!)

// w_sale.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false
	wf_assign_master_cash_win_object()
	wf_assign_saleset_objects()

// w_sale.ue_postopen() returns 0 [event]
	m_salemenu lm_menu
	integer li_rtncode
	integer li_defaultgodown
	integer i
	long ll_counter
	long ll_pos
	long ll_prow
	long ll_pcode
	long ll_found
	integer li_defaultsaleprice
	integer li_defaultitemdiscperc
	string ls_custfilterstring
	datawindowchild ldc_godown
	call super::ue_postopen
	this.ids_invoiceinfo = create datastore
	this.ids_invoiceinfo.dataobject = "d_saleinvinfo"
	this.ids_invoiceinfo.settransobject(this.it_transobject)
	f_fetch_sites()
	this.ids_saledetail_deleted = create datastore
	this.ids_saledetail_deleted.dataobject = "d_saledetail"
	this.ids_saledetail_deleted.settransobject(this.it_transobject)
	wf_assign_saleset_objects()
	wf_assign_master_cash_win_object()
	this.dw_refusedsaleheader.settransobject(this.it_transobject)
	this.dw_refusedsaledetail.settransobject(this.it_transobject)
	this.dw_holdsaledetail.settransobject(this.it_transobject)
	this.dw_image.settransobject(this.it_transobject)
	this.dw_document.settransobject(this.it_transobject)
	this.dw_receivable_adjdetail.settransobject(this.it_transobject)
	lm_menu = this.menuid
	this.ic_retrievepatientlist = f_stringpreferences("RetrievePatientList")
	this.ic_advancetaxonsale = f_stringpreferences("ApplyAdvanceIncomeTaxInSale")
	if this.ic_advancetaxonsale = "" or isnull(this.ic_advancetaxonsale) then
		this.ic_advancetaxonsale = "N"
	end if
	this.ic_fbrposfee = f_stringpreferences("Auto_Apply_FBR_POS_Fee_InSale")
	if this.ic_fbrposfee = "" or isnull(this.ic_fbrposfee) then
		this.ic_fbrposfee = "N"
	end if
	this.ic_autofiscalize = f_stringpreferences("AutoFiscalizeOnPosting")
	if this.ic_autofiscalize = "" or isnull(this.ic_autofiscalize) then
		this.ic_autofiscalize = "N"
	end if
	this.ic_printunfiscalizedinvoice = f_stringpreferences("PrintUnFiscalizedInvoice")
	if this.ic_printunfiscalizedinvoice = "" or isnull(this.ic_printunfiscalizedinvoice) then
		this.ic_printunfiscalizedinvoice = "N"
	end if
	setredraw(false)
	wf_setsaletype(integer(message.doubleparm))
	if this.ii_saletype = 2 then
		this.ii_salemodule = 11
	else
		this.ii_salemodule = 10
	end if
	this.id_print = this.dw_saleinvrep
	this.id_saleinvdetail = this.dw_saleinvdetail
	this.id_saleinvdetail.settransobject(this.it_transobject)
	choose case this.ii_saletype
	case 2
		this.title = "Credit Sale"
		wf_assigndatawindowobjects("d_WholeSaleHeader", "d_WholeSaleDetail", "d_SaleFooter2", "d_WholeSaleInvlist", "d_WholeSaleInvReport")
		if f_stringpreferences("enforcenuminputincreditsalerefno") = "Y" then
			this.id_master.object.custrefno.editmask.mask = "########0"
		end if
		if f_stringpreferences("mustaskrefno1increditsale") = "Y" then
			this.id_master.object.custrefno.editmask.required = true
		else
			this.id_master.object.custrefno.editmask.required = false
		end if
		wf_retrieve_customer_balances()
		li_rtncode = this.id_master.getchild("custcode", this.idc_customers)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.retrieve()
		li_rtncode = wf_apply_groupcustomercategory()
		if li_rtncode <= 0 then
			messagebox("Group Customer Category Validation", "Current user group does not have enough permissions w.r.t customer to make sale.~r~nIn order to make sale kindly assign customer categories to this user group ~r~n using Group Customer Category module.~r~nOR~r~nDisable Group Customer Category from Preferences.")
			close(this)
			return
		end if
		this.id_master.object.custcode.initial = "0"
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 501", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			this.ib_creditsaleposting = true
			this.im_menu.m_file.m_post.visible = true
			this.im_menu.m_file.m_post.toolbaritemvisible = true
			this.im_menu.m_file.m_post.enabled = false
		end if
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 556", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			lm_menu.m_file.m_postsaleheaderwise.visible = true
			lm_menu.m_file.m_postsaleheaderwise.enabled = false
		end if
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 503", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			this.ib_creditmodify = true
			lm_menu.m_file.m_editspecificsaleinvoice.visible = true
			lm_menu.m_file.m_editspecificsaleinvoice.enabled = true
		end if
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 551", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			this.ib_creditmodify = true
			lm_menu.m_file.m_normalsave.enabled = true
		end if
		if not this.ib_creditsaleposting then
			this.im_menu.m_file.m_post.visible = false
			this.im_menu.m_file.m_post.toolbaritemvisible = false
			this.im_menu.m_file.m_post.enabled = false
		end if
		li_rtncode = this.id_master.getchild("patientcode", this.idc_patient)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
			return
		end if
		this.idc_patient.settransobject(this.it_transobject)
		wf_patient_retrieve()
		wf_set_patientvisibility()
		li_rtncode = this.id_master.getchild("guestcode", this.idc_guest)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
			return
		end if
		this.idc_guest.settransobject(this.it_transobject)
		wf_guest_retrieve()
		wf_set_guest_visibility()
		li_rtncode = this.id_master.getchild("studentcode", this.idc_student)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
			return
		end if
		this.idc_student.settransobject(this.it_transobject)
		wf_student_retrieve()
		wf_set_student_visibility()
		li_rtncode = this.id_master.getchild("motorvehiclecode", this.idc_motorvehicle)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
			return
		end if
		this.idc_motorvehicle.settransobject(this.it_transobject)
		wf_motorvehicle_retrieve()
		if f_stringpreferences("ShowAccountForinSale") = "Y" then
			this.id_master.object.accountfor.visible = true
			this.id_master.object.t_accountfor.visible = true
		else
			this.id_master.object.accountfor.visible = false
			this.id_master.object.t_accountfor.visible = false
		end if
		if f_stringpreferences("SaleAccountFor") = "Y" then
			this.id_master.object.accountfor.initial = "Y"
		else
			this.id_master.object.accountfor.initial = "N"
		end if
		if f_stringpreferences("ShowAssociatedPurInvCodeInSale") = "N" then
			this.id_master.object.associatedpurinvcode.visible = false
			this.id_master.object.associatedpurinvcode_t.visible = false
		end if
		if f_stringpreferences("ShowSuppInvCodeInSale") = "N" then
			this.id_master.object.suppinvcode.visible = false
			this.id_master.object.suppinvcode_t.visible = false
		end if
	case 3
		wf_assigndatawindowobjects("d_RetailSaleHeader", "d_RetailSaleDetail", "d_SaleFooter2", "d_RetailSaleInvlist", "d_RetailSaleInvReport")
		this.it_transobject.getglobalcode("GT_RetailSaleCustomerACC", this.il_code)
		if f_stringpreferences("enforcenuminputincashsalerefno") = "Y" then
			this.id_master.object.custrefno.editmask.mask = "########0"
		end if
		if f_stringpreferences("mustaskrefno1incashsale") = "Y" then
			this.id_master.object.custrefno.editmask.required = true
		else
			this.id_master.object.custrefno.editmask.required = false
		end if
		wf_retrieve_customer_balances()
		li_rtncode = this.id_master.getchild("custcode", this.idc_customers)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.retrieve()
		li_rtncode = wf_apply_groupcustomercategory()
		if li_rtncode <= 0 then
			messagebox("Group Customer Category Validation", "Current user group does not have enough permissions w.r.t customer to make sale.~r~nIn order to make sale kindly assign customer categories to this user group ~r~n using Group Customer Category module.~r~nOR~r~nDisable Group Customer Category from Preferences.")
			close(this)
			return
		end if
		this.id_master.object.custcode.initial = "19"
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 500", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			this.ib_cashsaleposting = true
			this.im_menu.m_file.m_post.visible = true
			this.im_menu.m_file.m_post.toolbaritemvisible = true
			this.im_menu.m_file.m_post.enabled = false
		end if
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 502", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			this.ib_retailmodify = true
			lm_menu.m_file.m_editspecificsaleinvoice.visible = true
			lm_menu.m_file.m_editspecificsaleinvoice.enabled = true
		end if
		if not this.ib_cashsaleposting then
			this.im_menu.m_file.m_post.visible = false
			this.im_menu.m_file.m_post.toolbaritemvisible = false
			this.im_menu.m_file.m_post.enabled = false
		end if
		if f_stringpreferences("SaleCashWindow") = "Y" then
			this.id_footer.object.t_balance.visible = true
			this.id_footer.object.t_bal_alias.visible = true
		end if
		li_rtncode = this.id_master.getchild("patientcode", this.idc_patient)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
			return
		end if
		this.idc_patient.settransobject(this.it_transobject)
		wf_patient_retrieve()
		wf_set_patientvisibility()
		li_rtncode = this.id_master.getchild("guestcode", this.idc_guest)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
			return
		end if
		this.idc_guest.settransobject(this.it_transobject)
		wf_guest_retrieve()
		wf_set_guest_visibility()
		li_rtncode = this.id_master.getchild("studentcode", this.idc_student)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
			return
		end if
		this.idc_student.settransobject(this.it_transobject)
		wf_student_retrieve()
		wf_set_student_visibility()
		SQL SELECT defaultsaleprice , defaultitemdiscperc INTO :li_defaultsaleprice, :li_defaultitemdiscperc FROM Customer WHERE custcode =19 USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.id_master.object.sprice.initial = string(li_defaultsaleprice)
			this.id_master.object.itemdiscpercno.initial = string(li_defaultitemdiscperc)
		else
			messagebox("Customer Information", "Error in Retrieving Customer Information")
			close(this)
		end if
	end choose
	li_rtncode = this.id_detail.getchild("itemmetername", this.idc_itemmeter)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_itemmeter.settransobject(this.it_transobject)
	li_rtncode = this.idc_itemmeter.retrieve(0)
	if this.idc_itemmeter.rowcount() <= 0 then
		this.idc_itemmeter.insertrow(0)
	end if
	if f_stringpreferences("BringPreferredSaleQty") = "Y" then
		this.ib_bringprefsaleqty = true
	end if
	if f_stringpreferences("ApplySTaxScheduleOnUnitSalesTax") = "Y" then
		this.ib_apply_stax_schedule_on_unit_stax = true
	end if
	wf_apply_header_preferences()
	wf_apply_detail_preferences()
	if wf_item_image_setting() < 0 then
		messagebox("Connection Problem", "Problem in connecting database. Kindly Try Again", stopsign!)
		close(this)
	end if
	f_setcolumnstyle(this.id_detail, "Qty")
	li_rtncode = this.id_master.getchild("doctcode", this.idc_doctors)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_doctors.settransobject(this.it_transobject)
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit to Make Sales")
		close(this)
		return
	end if
	li_rtncode = this.id_detail.getchild("gcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to sale")
		close(this)
		return
	end if
	this.ii_salegodown = this.idc_godown.getitemnumber(1, "gcode")
	this.id_detail.object.gcode.initial = string(this.ii_salegodown)
	this.id_holdsaledetail = this.dw_holdsaledetail
	this.id_holdsaledetail.settransobject(this.it_transobject)
	this.id_holdsaledetail.getchild("gcode", ldc_godown)
	ldc_godown.settransobject(this.it_transobject)
	ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	li_rtncode = this.id_master.getchild("sprice", this.idc_price)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_price.settransobject(this.it_transobject)
	li_rtncode = this.idc_price.retrieve(this.ii_module, this.il_groupcode)
	if this.ii_saletype <> 3 then
		this.id_master.object.sprice.initial = string(this.idc_price.getitemnumber(1, "pricetypecode"))
	end if
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Price Rights to sale")
		close(this)
		return
	end if
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = true
	this.id_itemslist.object.sstock.visible = true
	this.id_itemslist.object.t_pstock.visible = false
	this.id_itemslist.object.pstock.visible = false
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 513", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		if this.ii_saletype = 2 and f_stringpreferences("CrSPNo") = "Y" then
			this.id_master.object.sprice.visible = true
			this.id_master.object.t_sprice.visible = true
		elseif this.ii_saletype = 3 and f_stringpreferences("CaSPNo") = "Y" then
			this.id_master.object.sprice.visible = true
			this.id_master.object.t_sprice.visible = true
		end if
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 522", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.dd_gstperc.visible = true
		this.id_master.object.gstperc_t.visible = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 523", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_footer.object.rpp.visible = true
		this.id_footer.object.t_rpp.visible = true
		this.id_footer.object.rppmargin.visible = true
		this.id_footer.object.avgprice.visible = true
		this.id_footer.object.purprice.visible = true
		this.id_footer.object.retailprice.visible = true
	end if
	if f_stringpreferences("ShowCustomerLatestNetRateInFooter") = "N" then
		this.id_footer.object.latestnetrate.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 550", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu = this.menuid
		lm_menu.m_file.m_dueitem.enabled = true
		lm_menu.m_file.m_dueitem.visible = true
	end if
	this.ic_batchcosting = f_stringpreferences("MaintainBatchWiseItemCostOnPosting")
	li_rtncode = wf_set_headersetting()
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Sales")
		close(this)
		return
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.t_gcode.visible = true
		this.id_master.object.gcode.visible = true
