// w_sale.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	long ll_icode
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	integer li_option
	boolean lb_rtflag = true
	boolean ib_due
	integer li_null
	string ls_null
	ls_titleerrtext = "Item Validation"
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), al_currrow) = true then
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
	elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			li_option = messagebox("Item Validation", "Item stock does not exist~n~rDo You want to due this item", information!, yesno!, 2)
			if li_option = 1 then
				this.id_detail.setitem(this.il_currrow, "looseqty", 1)
				this.id_detail.setitem(this.il_currrow, "dueqty", 1)
				ib_due = true
			else
				li_errcode = -1
			end if
		end if
	else
		li_errcode = -1
		ls_titleerrtext = "Item Validation"
	end if
	if li_errcode = -1 and not ib_due then
		lb_rtflag = false
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setitem(al_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(al_currrow, "icode", li_null)
		this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	end if
	return lb_rtflag

// w_sale.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_sale.wf_visible(boolean ab_flag) returns 0

// w_sale.wf_populate_ddlb(datawindow dwcontrol) returns 0
	integer li_column_count
	integer li_counter
	string ls_column_name
	string ls_columntype
	this.tab_retrieve.tabpage_list.ddlb_filter_column.reset()
	this.tab_retrieve.tabpage_list.ddlb_sort.reset()
	li_column_count = integer(dwcontrol.object.datawindow.column.count)
	for li_counter = li_column_count to 1 step -1
		ls_column_name = dwcontrol.describe("#" + string(li_counter) + ".Name")
		this.tab_retrieve.tabpage_list.ddlb_sort.additem(ls_column_name)
		this.tab_retrieve.tabpage_list.ddlb_filter_column.additem(ls_column_name)
	next
	this.tab_retrieve.tabpage_list.ddlb_sort.text = ls_column_name
	ls_columntype = this.id_dwcontrol.describe("#1.ColType")
	if left(ls_columntype, 4) = "char" then
		this.ii_type = 1
	elseif left(ls_columntype, 4) = "date" then
		this.ii_type = 3
	else
		this.ii_type = 2
	end if
	this.ii_colindex = 1
	this.tab_retrieve.tabpage_list.rb_descending.checked = true
	wf_sortdw(this.tab_retrieve.tabpage_list.ddlb_sort.text, this.is_sortsequence)
	if this.ii_saletype = 3 then
		this.id_detail.setfocus()
		return
	end if
	this.id_master.setfocus()

// w_sale.wf_grandtotal() returns double
	long ll_saletypecode
	long[] ll_saletype
	long ll_salecatcode
	long[] ll_salecat
	long ll_counter = 1
	long ll_rowcount
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_discountvalue
	double ld_invtaxperc1val
	double ld_intaxperc1
	double ld_advincometax
	double ld_totaltax
	double ld_totalitemleveltax
	double ld_grossamt_rate_qty
	double ld_totaldiscount
	double ld_accumulateddiscperc
	double ld_sumgstval
	double ld_sumtaxval
	double lr_discperc
	double lr_flatdisc
	double lr_misccharges
	double lr_salestax
	double lr_itemstotal
	integer li_roundupto
	ll_rowcount = this.id_detail.rowcount()
	li_roundupto = f_numberpreferences("roundsaleinvon")
	if isnull(li_roundupto) or li_roundupto < 0 then
		li_roundupto = 0
	end if
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
		ld_grossamt_rate_qty = this.id_detail.getitemnumber(1, "c_grossamt_rate_qty")
		ld_totaldiscount = this.id_detail.getitemnumber(1, "c_totaldiscount")
		ld_advincometax = this.id_detail.getitemnumber(1, "c_totadvancetax")
		ld_sumgstval = this.id_detail.getitemnumber(1, "c_sumgstval")
		ld_sumtaxval = this.id_detail.getitemnumber(1, "c_sumtaxval")
		lr_discperc = this.id_footer.object.invdiscperc[1]
		lr_flatdisc = this.id_footer.object.flatdisc[1]
		if this.ic_advancetaxonsale = "Y" then
			this.id_footer.object.misccharges[1] = ld_advincometax + this.id_footer.object.misccharges1[1] + this.id_footer.object.misccharges2[1] + this.id_footer.object.misccharges3[1] + this.id_footer.object.misccharges4[1] + this.id_footer.object.misccharges5[1]
			this.id_footer.object.advancetaxamt[1] = ld_advincometax
		else
			lr_misccharges = this.id_footer.object.misccharges[1]
			this.id_footer.object.advancetaxamt[1] = 0.00
		end if
		if this.ic_autofiscalize = "Y" and this.ic_fbrposfee = "Y" then
			this.id_footer.object.misccharges[1] = this.id_footer.object.advancetaxamt[1] + this.id_footer.object.misccharges1[1] + this.id_footer.object.misccharges2[1] + this.id_footer.object.misccharges3[1] + this.id_footer.object.misccharges4[1] + this.id_footer.object.misccharges5[1] + this.id_master.object.fbrposfee[1]
		else
			lr_misccharges = this.id_footer.object.misccharges[1]
		end if
		lr_misccharges = this.id_footer.object.misccharges[1]
		lr_salestax = this.id_footer.object.salestax[1]
		ld_intaxperc1 = this.id_footer.object.invgstperc1[1]
		ld_totalitemleveltax = ld_sumgstval + ld_sumtaxval
		this.id_footer.object.t_discountvalue.text = string(ld_detaildwtotal * lr_discperc * 0.01, "########0.00")
		ld_discountvalue = ld_detaildwtotal * lr_discperc * 0.01
		ld_detaildwtotal = round(ld_detaildwtotal, 2)
		ld_grandtotal = ld_detaildwtotal - ld_discountvalue - lr_flatdisc + lr_misccharges + lr_salestax
		ld_invtaxperc1val = round((ld_detaildwtotal - ld_discountvalue - lr_flatdisc) * ld_intaxperc1 * 0.01, 2)
		ld_totaltax = round(ld_invtaxperc1val + ld_totalitemleveltax, li_roundupto)
		ld_grandtotal = round(ld_grandtotal, li_roundupto) + ld_totaltax
		ld_totaldiscount = ld_totaldiscount + ld_discountvalue + lr_flatdisc
		if ld_grossamt_rate_qty = 0.0 then
			ld_grossamt_rate_qty = 1
		end if
		ld_accumulateddiscperc = round(ld_totaldiscount / ld_grossamt_rate_qty * 100.0, 2)
		this.id_footer.setitem(1, "total", ld_grandtotal)
		this.id_footer.setitem(1, "grossforaccumdisc", ld_grossamt_rate_qty)
		this.id_footer.setitem(1, "totaldiscount", ld_totaldiscount)
		this.id_footer.setitem(1, "accumulateddiscperc", ld_accumulateddiscperc)
		this.id_master.setitem(1, "invtotal", ld_grandtotal)
	end if
	return ld_grandtotal

// w_sale.wf_initmodify(ref integer ai_protect) returns 0
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_counter
	long ll_count
	double ld_saleprice
	double ld_packsalestax
	double ld_avgprice
	double ld_recentpurprice
	double ld_purprice
	string ls_itemtotalval
	double ld_looseqty
	double ld_bonusqty
	double ld_stock
	double ld_purdiscperc
	long ll_disc_icode
	if this.id_master.getitemstring(1, "posted") = "N" then
		this.id_master.setitem(1, "sitecode", gl_sitecode)
		ll_saleinvcode = this.id_detail.getitemnumber(1, "code")
		if wf_locksaleinvoice(ll_saleinvcode) = 0 then
			this.id_master.retrieve(ll_saleinvcode)
			this.id_detail.retrieve(ll_saleinvcode)
			this.ids_invoiceinfo.retrieve(ll_saleinvcode)
			for ll_count = 1 to this.id_detail.rowcount()
				ll_icode = this.id_detail.getitemnumber(ll_count, "icode")
				ll_gcode = this.id_detail.getitemnumber(ll_count, "gcode")
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				if this.it_transobject.sqlcode <> 0 then
					ai_protect = 0
				end if
				ld_looseqty = 0
				ld_bonusqty = 0
				this.il_myrowid = 0
				for ll_counter = 1 to this.ids_invoiceinfo.rowcount()
					this.il_myrowid = this.il_myrowid + 1
					if ll_icode = this.ids_invoiceinfo.getitemnumber(ll_counter, "icode") then
						if isnull(this.ids_invoiceinfo.getitemstring(ll_counter, "due")) then
							ld_looseqty = ld_looseqty + this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty")
							ld_bonusqty = ld_bonusqty + this.ids_invoiceinfo.getitemnumber(ll_counter, "bonusqty")
						end if
						this.id_detail.setitem(ll_count, "stock", ld_stock + ld_looseqty + ld_bonusqty)
						SQL SELECT item.saleprice , item.packsalestax , item.purprice , item.avgprice , item.recentpurprice INTO :ld_saleprice, :ld_packsalestax, :ld_purprice, :ld_avgprice, :ld_recentpurprice FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
						if this.it_transobject.sqlcode = 0 then
							ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
							this.id_detail.setitem(ll_count, "itemtotalval", ls_itemtotalval)
							this.id_detail.setitem(ll_count, "recentpurprice", ld_recentpurprice)
							this.id_detail.setitem(ll_count, "purprice", ld_purprice)
							this.id_detail.setitem(ll_count, "avgprice", ld_avgprice)
							this.id_detail.setitem(ll_count, "myrowid", this.il_myrowid)
						end if
					end if
				next
			next
			if ai_protect = 0 then
				this.ib_modify = true
				this.id_footer.setitem(1, "stock", this.id_detail.getitemnumber(1, "stock"))
				if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
					ll_disc_icode = this.id_detail.getitemnumber(1, "icode")
					SQL Select item.purdiscperc INTO :ld_purdiscperc From Item Where item.icode =:ll_disc_icode USING this.it_transobject;
					this.id_footer.object.t_purdiscper.text = string(ld_purdiscperc)
				end if
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
			return
		end if
		messagebox("Cannot Modify", "Sale invoice is already in use")
	end if

// w_sale.wf_itemsalehistory() returns 0
	s_itemsalehistory ls_itemsalehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itemsalehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itemsalehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itemsalehistory, ls_itemsalehistory)
	end if

