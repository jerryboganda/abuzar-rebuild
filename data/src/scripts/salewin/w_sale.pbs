// w_sale.wf_edit_saleinvoice() returns long
	boolean lb_ok
	s_arguements lstr_arg
	integer li_yesno
	integer li_rtcode
	if this.ii_saletype = 2 then
		if this.ib_creditmodify = false then
			return 0
		end if
	elseif this.ib_retailmodify = false then
		return 0
	end if
	if wf_iseditable() then
		li_yesno = messagebox("Confirm Changes", "Yes to save changes that you've typed in refused sale", question!, yesnocancel!, 2)
		if li_yesno = 1 then
			triggerevent("ue_save")
			if wf_commitform() then
				triggerevent("ue_new")
				lb_ok = true
			end if
		else
			lb_ok = true
		end if
	else
		triggerevent("ue_new")
		lb_ok = true
	end if
	if lb_ok = true then
		open(w_arg_sale)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = 1 and lstr_arg.l_code1 > 0 then
			this.tab_retrieve.tabpage_list.em_invno.text = trim(string(lstr_arg.l_code1))
			triggerevent("ue_detail")
		end if
	end if
	return 0

// w_sale.wf_checkpatientlicexpiry(long al_code) returns integer
	integer lic_licexpirycussion = 30
	integer li_option = 1
	string ls_licenceno
	datetime ldt_licence_expiry
	long ll_daysremaining = 999
	SQL Select licenseexpiry INTO :ldt_licence_expiry From patient Where patientcode =:al_code USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 and f_stringpreferences("ValidatePatientLicExpiryInSale") = "Y" then
		if isnull(ls_licenceno) then
			ls_licenceno = ""
		end if
		if not isnull(ldt_licence_expiry) then
			ll_daysremaining = daysafter(today(), date(string(ldt_licence_expiry, "m-d-yy")))
			if ll_daysremaining < 0 then
				li_option = messagebox("Licence Expiry Problem!", "Licence Expiry Date = " + string(ldt_licence_expiry, "mmm dd, yyyy") + "~r~n" + "Patient Licence has  expired~r~n" + "Do you want to continue?", question!, yesno!, 2)
			elseif ll_daysremaining <= 30 then
				messagebox("Licence Expiry Notification!", "Licence Expiry Date = " + string(ldt_licence_expiry, "mmm dd, yyyy") + "~r~n" + "Patient Licence is about to expire in " + trim(string(ll_daysremaining)) + " days", information!)
			end if
		end if
	end if
	return li_option

