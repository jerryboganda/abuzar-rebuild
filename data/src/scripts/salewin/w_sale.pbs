// w_sale.ue_setitemfocus(integer ai_editmode) returns 0 [event]
	string ls_null
	setnull(ls_null)
	if f_stringpreferences("itemcode") = "Y" then
		this.id_detail.setcolumn("fullcode")
		this.id_detail.setfocus()
		return
	end if
	if ai_editmode = 0 then
		this.id_detail.setitem(this.id_detail.getrow(), "itemname", " ")
	end if
	this.id_detail.setcolumn("itemname")
	this.id_detail.setfocus()
	if ai_editmode = 0 then
		this.id_detail.setitem(this.id_detail.getrow(), "itemname", ls_null)
	end if

// w_sale.ue_enableprint() returns 0 [event]
	this.im_menu.m_file.m_print.enabled = true

// w_sale.ue_deleteinvoice() returns 0 [event]
	long ll_invcode
	long ll_counter
	long ll_usercode
	long ll_found
	long ll_deleteoption
	datetime ldt_server_datetime
	string ls_errtext
	string ls_msgtitle
	string ls_msg
	string ls_date_errtext
	string ls_askuserpwd
	boolean lb_deletionallowed
	ls_msgtitle = "Delete Sales Invoice"
	ls_msg = "Delete Operation Terminated Unsuccessfuly~r~n"
	ll_found = 0
	if this.ii_saletype = 3 then
		ll_found = gds_securitywindow.find("rightcode = 572", 1, gds_securitywindow.rowcount())
	else
		ll_found = gds_securitywindow.find("rightcode = 573", 1, gds_securitywindow.rowcount())
	end if
	if ll_found <= 0 then
		messagebox(ls_msgtitle, ls_msg + "Reason: Not enough rights to delete Sales Invoice", stopsign!)
		return
	end if
	if this.ii_saletype = 2 then
		ls_askuserpwd = "CreditSaleAskUserPassword"
	else
		ls_askuserpwd = "Salesalesmanwindow"
	end if
	if f_stringpreferences(ls_askuserpwd) = "Y" then
		open(w_salesmanpassword)
		ll_usercode = long(message.doubleparm)
		setfocus()
	else
		ll_usercode = gl_usercode
	end if
	if ll_usercode > 0 then
		if this.il_selectedrow <= 0 then
			messagebox(ls_msgtitle, ls_msg + "Please Select a Valid Sales Invoice to delete", stopsign!)
			return
		end if
		ll_invcode = this.id_list.object.code[this.il_selectedrow]
		if isnull(ll_invcode) or ll_invcode < 0 then
			messagebox(ls_msgtitle, ls_msg + "Please Select a Valid Sales Invoice To delete", stopsign!)
			return
		end if
		ll_deleteoption = messagebox(ls_msgtitle, "Delete this Invoice permanently from Database?", question!, yesnocancel!, 2)
		if ll_deleteoption <> 1 then
			return
		end if
		if wf_isdeleted(ll_invcode) = true then
			messagebox(ls_msgtitle, ls_msg + "Reason: Sale Invoice already deleted", stopsign!)
			return
		end if
		if wf_isposted(ll_invcode) = true then
			messagebox(ls_msgtitle, ls_msg + "Reason: Posted Sale Invoice can not be deleted", stopsign!)
			return
		end if
		if wf_isinvoiceinuse(ll_invcode) = true then
			messagebox(ls_msgtitle, ls_msg + "Reason: Sale Invoice already in use by some other user.~r~nKindly try again after sometime.", stopsign!)
			return
		end if
		if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_msg + "Reason: " + ls_date_errtext, stopsign!)
			return
		end if
		SQL rollback USING this.it_transobject;
		if f_generatesaleslog(ll_invcode, ldt_server_datetime, this.it_transobject) = 0 then
			if wf_returnsaleinvoice(ll_invcode, ls_errtext) then
				SQL update DBO.SaleLedger Set Deleted ='Y' , ModifiedBy =:ll_usercode , Date =:ldt_server_datetime WHERE SaleInvCode =:ll_invcode AND Deleted ='N' AND Posted ='N' USING this.it_transobject;
				if this.it_transobject.sqlcode = 0 then
					SQL commit USING this.it_transobject;
					messagebox(ls_msgtitle, "Sale Invoice Successfully Deleted")
					return
				else
					SQL rollback USING this.it_transobject;
					messagebox(ls_msgtitle, ls_msg + "Reason: " + this.it_transobject.sqlerrtext, stopsign!)
					return
				end if
			else
				SQL rollback USING this.it_transobject;
				messagebox(ls_msgtitle, ls_msg + "Reason: " + ls_errtext, stopsign!)
				return
			end if
		else
			SQL rollback USING this.it_transobject;
			messagebox(ls_msgtitle, ls_msg + "Reason: " + "Failure in Saving Sales Invoice History!", stopsign!)
			return
		end if
		return
	end if
	messagebox(ls_msgtitle, ls_msg + "Reason: " + "Please enter a Valid user/password", stopsign!)

// w_sale.ue_viewinvmargin() returns 0 [event]
	long ll_count
	long ll_invcode
	long ll_masterrow
	long ll_icode
	double ld_tax_perc
	double ld_saleprice
	double ld_retailprice
	double ld_itemflatdisc
	double ld_discperc
	double ld_unitsalestax
	string ls_viewoption
	char lc_tax_applicable
	char lc_tax_type
	datastore lds_invitemlist
	boolean lb_listtab
	boolean lb_editable = true
	s_datastore lstr
	if wf_iseditable() = false then
		lb_editable = false
	end if
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if not lb_listtab then
		lds_invitemlist = create datastore
		if gs_company = "ZAFARTRACTOR" then
			lds_invitemlist.dataobject = "d_zafartractor_marginpreview_report"
		else
			lds_invitemlist.dataobject = "d_marginpreview_report"
		end if
		lds_invitemlist.settransobject(sqlca)
		ls_viewoption = f_stringpreferences("viewsaleinvmarginpreview")
		if lb_editable then
			this.id_detail.accepttext()
			this.id_footer.accepttext()
			for ll_count = 1 to this.id_detail.rowcount()
				lds_invitemlist.insertrow(0)
				lds_invitemlist.setitem(ll_count, "fullcode", this.id_detail.getitemstring(ll_count, "fullcode"))
				lds_invitemlist.setitem(ll_count, "itemname", this.id_detail.getitemstring(ll_count, "itemname"))
				ll_icode = this.id_detail.object.icode[ll_count]
				ld_saleprice = this.id_detail.object.saleprice[ll_count]
				ld_retailprice = this.id_detail.object.retailprice[ll_count]
				if this.id_detail.object.cloneitemflatdisc[ll_count] > 0 then
					ld_itemflatdisc = this.id_detail.object.cloneitemflatdisc[ll_count]
				else
					ld_itemflatdisc = this.id_detail.object.itemflatdisc[ll_count]
				end if
				if this.id_detail.object.clonediscperc[ll_count] > 0 then
					ld_discperc = this.id_detail.object.clonediscperc[ll_count]
				else
					ld_discperc = this.id_detail.object.discperc[ll_count]
				end if
				if ld_retailprice <= 0.0 or isnull(ld_retailprice) then
					ld_retailprice = ld_saleprice
				end if
				SQL SELECT tax_applicable =ISNULL ( ( SELECT STS.Applicable FROM SalesTaxSchedule STS WHERE STS.SalesTaxScheduleCode =item.SalesTaxScheduleCode ) , 'N' ) , tax_perc =ISNULL ( ( SELECT STS.TaxPerc FROM SalesTaxSchedule STS WHERE STS.SalesTaxScheduleCode =item.SalesTaxScheduleCode ) , 0 ) , tax_type =ISNULL ( ( SELECT STS.TaxType FROM SalesTaxSchedule STS WHERE STS.SalesTaxScheduleCode =item.SalesTaxScheduleCode ) , 'S' ) INTO :lc_tax_applicable, :ld_tax_perc, :lc_tax_type FROM Item WHERE Item.ICode =:ll_icode USING this.it_transobject;
				if this.it_transobject.sqlcode = 0 and lc_tax_applicable = "Y" then
					if lc_tax_type = "S" then
						ld_unitsalestax = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01) * ld_tax_perc * 0.01, 2)
					elseif lc_tax_type = "R" then
						ld_unitsalestax = round(ld_retailprice * ld_tax_perc * 0.01, 2)
						ld_saleprice = ld_retailprice
					elseif lc_tax_type = "D" then
						ld_unitsalestax = round(ld_retailprice * ld_tax_perc * 0.01, 2)
						ld_saleprice = ld_retailprice
					elseif lc_tax_type = "E" then
						ld_unitsalestax = round(ld_retailprice * ld_tax_perc / (100.0 + ld_tax_perc), 2)
						ld_saleprice = ld_retailprice
					elseif lc_tax_type = "I" then
						ld_saleprice = this.id_detail.object.saleprice[ll_count]
						ld_saleprice = round(ld_saleprice * 100.0 / (100.0 + ld_tax_perc), 2)
						ld_unitsalestax = round(ld_saleprice * ld_tax_perc * 0.01, 2)
					end if
				end if
				lds_invitemlist.setitem(ll_count, "saleprice", ld_saleprice)
				lds_invitemlist.setitem(ll_count, "unitsalestax", ld_unitsalestax)
				if gs_company = "ZAFARTRACTOR" then
					lds_invitemlist.setitem(ll_count, "avgprice", this.id_detail.getitemnumber(ll_count, "purunitrate"))
				else
					lds_invitemlist.setitem(ll_count, "avgprice", this.id_detail.getitemnumber(ll_count, "avgprice"))
				end if
				lds_invitemlist.setitem(ll_count, "rppunitrate", this.id_detail.getitemnumber(ll_count, "rppunitrate"))
				lds_invitemlist.setitem(ll_count, "looseqty", this.id_detail.getitemnumber(ll_count, "looseqty"))
				lds_invitemlist.setitem(ll_count, "bonusqty", this.id_detail.getitemnumber(ll_count, "bonusqty"))
				lds_invitemlist.setitem(ll_count, "discperc", ld_discperc)
				lds_invitemlist.setitem(ll_count, "itemflatdisc", ld_itemflatdisc)
				lds_invitemlist.setitem(ll_count, "invdiscperc", this.id_footer.getitemnumber(1, "invdiscperc"))
				lds_invitemlist.setitem(ll_count, "viewsaleinvmarginpreviewon", ls_viewoption)
			next
		else
			ll_masterrow = this.id_master.rowcount()
			ll_invcode = this.id_master.object.code[ll_masterrow]
			lds_invitemlist.retrieve(ll_invcode)
		end if
		lstr.ds = lds_invitemlist
		lstr.s_name1 = "d_marginpreview_report"
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		destroy lds_invitemlist
	end if

// w_sale.ue_enforcedefaultfocussettings(integer ai_editmode) returns 0 [event]
	string ls_focuscolsetting
	string ls_setting
	choose case this.ii_saletype
	case 2
		ls_focuscolsetting = f_stringpreferences("creditsaledefaultfocussetting")
	case else
		ls_focuscolsetting = f_stringpreferences("cashsaledefaultfocussetting")
	end choose
	if ls_focuscolsetting = "detailwindow" then
		if f_stringpreferences("enablequickprefferedsearch") = "Y" then
			this.id_detail.setcolumn("quicksearch")
			this.id_detail.setfocus()
		else
			post event ue_setitemfocus(ai_editmode)
		end if
		return
	end if
	ls_setting = this.id_master.describe(trim(ls_focuscolsetting) + ".visible")
	if trim(ls_setting) = "1" then
		this.id_master.setcolumn(ls_focuscolsetting)
		this.id_master.setfocus()
		return
	end if
	choose case this.ii_saletype
	case 2
		this.id_master.setfocus()
		return
	end choose
	if f_stringpreferences("enablequickprefferedsearch") = "Y" then
		this.id_detail.setcolumn("quicksearch")
		this.id_detail.setfocus()
		return
	end if
	post event ue_setitemfocus(ai_editmode)

// w_sale.ue_view_itemassociations() returns 0 [event]
	s_dw_header lstr_header
	long ll_row
	long ll_icode
	long ll_selectedvalues
	long ll_insrow
	long ll_counter
	integer rt_code
	string ls_errortext
	dwruntimeerror exdw
	nullobjecterror exobj
	try
		if this.tab_retrieve.selectedtab = 1 and wf_iseditable() then
			ll_row = this.id_detail.getrow()
			if ll_row > 0 then
				ll_icode = this.id_detail.object.icode[ll_row]
				if ll_icode > 0 then
					this.id_itemassociation.retrieve(ll_icode)
					lstr_header.l_code = ll_icode
					lstr_header.dw_header = this.id_itemassociation
					openwithparm(w_populate_itemassociation_form, lstr_header)
					lstr_header = message.powerobjectparm
					if lstr_header.i_closemode = 1 then
						ll_selectedvalues = upperbound(lstr_header.l_values)
						if ll_selectedvalues > 0 then
							for ll_counter = 1 to ll_selectedvalues
								ll_icode = lstr_header.l_values[ll_counter]
								if ll_icode > 0 then
									ll_insrow = this.id_detail.insertrow(0)
									if not wf_inititeminfo(ll_icode, ll_insrow, rt_code, ls_errortext) then
										event ue_deleteitem()
									end if
								end if
							next
						end if
					end if
				end if
			end if
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exobj)
		messagebox("Exception Occur", "Details are:~r~n" + exobj.getmessage())
		goto L780
	end try

// w_sale.ue_view_itemnotes() returns 0 [event]
	s_arguements lstr_arg
	long ll_row
	long ll_icode
	dwruntimeerror exdw
	nullobjecterror exobj
	try
		if this.tab_retrieve.selectedtab = 1 then
			ll_row = this.id_detail.getrow()
			if ll_row > 0 then
				ll_icode = this.id_detail.object.icode[ll_row]
				if ll_icode > 0 then
					lstr_arg.l_code1 = ll_icode
					lstr_arg.l_code2 = 0
					openwithparm(w_item_form_notes, lstr_arg)
				end if
			end if
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exobj)
		messagebox("Exception Occur", "Details are:~r~n" + exobj.getmessage())
		goto L430
	end try

// w_sale.ue_save_withnocommit() returns long [event]
	setpointer(hourglass!)
	if f_validatedw(this.id_master) < 0 then
		return -1
	end if
	if f_validatedw(this.id_detail) < 0 then
		return -2
	end if
	if this.id_master.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -3
	end if
	if this.id_detail.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -4
	end if
	if this.dw_salesetsheader.update() < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -5
	end if
	if this.dw_salesetsdetail.update() < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -6
	end if
	if this.dw_salesetsorigdetail.update() < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -7
	end if
	setpointer(arrow!)
	return 0

