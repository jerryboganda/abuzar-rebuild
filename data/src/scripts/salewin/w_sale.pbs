	double ld_truncateqty
	ld_invtotal = wf_grandtotal()
	ls_autodue = f_stringpreferences("salesmodulemode")
	li_round_qty = f_get_colprecision("Qty")
	ldt_datetime = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
	ll_usercode = this.id_master.getitemnumber(this.id_master.getrow(), "salesmancode")
	ll_headerno = this.id_master.getitemnumber(this.id_master.getrow(), "headerno")
	ll_detailrows = this.id_detail.rowcount()
	if this.ib_salesets = true then
		this.id_holdsaledetail.dataobject = this.id_detail.dataobject
		this.id_holdsaledetail.settransobject(this.it_transobject)
		this.id_holdsaledetail.reset()
		this.id_holdsaledetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		this.id_holdsaledetail.getchild("itemmetername", ldc_itemmeter)
		ldc_itemmeter.settransobject(this.it_transobject)
		ldc_itemmeter.retrieve(0)
		if ldc_itemmeter.rowcount() <= 0 then
			ldc_itemmeter.insertrow(0)
		end if
		this.id_detail.rowscopy(1, this.id_detail.rowcount(), primary!, this.id_holdsaledetail, 1, primary!)
		this.dw_salesetsheader.setfilter("")
		this.dw_salesetsheader.filter()
		this.dw_salesetsorigdetail.setfilter("")
		this.dw_salesetsorigdetail.filter()
		this.dw_salesetsdetail.reset()
		wf_grandtotal()
		ld_invtotal = this.id_footer.getitemnumber(1, "total")
		setredraw(false)
		this.id_detail.reset()
		ll_rowgroup = 1
		for li_counter = 1 to this.id_holdsaledetail.rowcount()
			ll_icode = this.id_holdsaledetail.object.icode[li_counter]
			ll_myrowid = this.id_holdsaledetail.object.myrowid[li_counter]
			if this.id_holdsaledetail.object.itemtypecode[li_counter] = 2 then
				ll_found = this.dw_salesetsheader.find("parentrow = " + string(ll_myrowid), 1, this.dw_salesetsheader.rowcount())
				if ll_found > 0 and ll_found <= this.dw_salesetsheader.rowcount() then
					wf_tabnewid("SaleSetsHeader", ll_setcode)
					this.dw_salesetsheader.object.setcode[ll_found] = ll_setcode
					this.dw_salesetsheader.object.saleinvcode[ll_found] = al_invid
					this.dw_salesetsheader.object.qty[ll_found] = this.id_holdsaledetail.object.looseqty[li_counter]
					this.dw_salesetsheader.object.saleprice[ll_found] = this.id_holdsaledetail.object.saleprice[li_counter]
					ll_startrow = 1
					for ll_innercounter = 1 to this.dw_salesetsorigdetail.rowcount()
						ll_found = this.dw_salesetsorigdetail.find("parentrow = " + string(ll_myrowid), ll_startrow, this.dw_salesetsorigdetail.rowcount())
						do while ll_found > 0 and ll_found <= this.dw_salesetsorigdetail.rowcount() and ll_startrow <= this.dw_salesetsorigdetail.rowcount()
							this.dw_salesetsorigdetail.object.setcode[ll_found] = ll_setcode
							ll_insertedrows = this.id_detail.insertrow(0)
							ll_icode = this.dw_salesetsorigdetail.object.icode[ll_found]
							li_errorcode = 0
							wf_inititeminfo(ll_icode, ll_insertedrows, li_errorcode, ls_errortext)
							this.id_detail.object.looseqty[ll_insertedrows] = round(this.dw_salesetsorigdetail.object.qty[ll_found] * this.id_holdsaledetail.object.looseqty[li_counter], li_round_qty)
							if this.dw_salesetsorigdetail.object.qty[ll_found] = 0 then
								this.id_detail.object.saleprice[ll_insertedrows] = round(this.dw_salesetsorigdetail.object.c_itemtotal[ll_found], 2)
							else
								this.id_detail.object.saleprice[ll_insertedrows] = round(this.dw_salesetsorigdetail.object.c_itemtotal[ll_found] / this.dw_salesetsorigdetail.object.qty[ll_found], 2)
							end if
							this.id_detail.object.itemflatdisc[ll_insertedrows] = 0.00
							this.id_detail.object.cloneitemflatdisc[ll_insertedrows] = 0.00
							this.id_detail.object.discperc[ll_insertedrows] = 0.00
							this.id_detail.object.clonediscperc[ll_insertedrows] = 0.00
							if ls_autodue = "A" then
								wf_autodue(ll_insertedrows, string(this.id_detail.object.looseqty[ll_insertedrows]))
							end if
							ll_insertedrows = this.dw_salesetsdetail.insertrow(0)
							this.dw_salesetsdetail.object.setcode[ll_insertedrows] = ll_setcode
							this.dw_salesetsdetail.object.icode[ll_insertedrows] = ll_icode
							this.dw_salesetsdetail.object.rowgroup[ll_insertedrows] = ll_rowgroup
							ll_startrow = ll_found + 1
							ll_found = this.dw_salesetsorigdetail.find("parentrow = " + string(li_counter), ll_startrow, this.dw_salesetsorigdetail.rowcount())
							ll_rowgroup = ll_rowgroup + 1
						loop
					next
				else
					as_errortext = "set contents not found for row no. " + string(li_counter)
					al_errorrow = li_counter
				end if
			else
				ll_insertedrows = this.id_detail.insertrow(0)
				this.id_detail.object.fullcode[ll_insertedrows] = this.id_holdsaledetail.object.fullcode[li_counter]
				this.id_detail.object.alternatecustomicode[ll_insertedrows] = this.id_holdsaledetail.object.alternatecustomicode[li_counter]
				this.id_detail.object.itemname[ll_insertedrows] = this.id_holdsaledetail.object.itemname[li_counter]
				this.id_detail.object.itemtypecode[ll_insertedrows] = this.id_holdsaledetail.object.itemtypecode[li_counter]
				this.id_detail.object.locksaleprice[ll_insertedrows] = this.id_holdsaledetail.object.locksaleprice[li_counter]
				this.id_detail.object.lockdiscperc[ll_insertedrows] = this.id_holdsaledetail.object.lockdiscperc[li_counter]
				this.id_detail.object.currlistrow[ll_insertedrows] = this.id_holdsaledetail.object.currlistrow[li_counter]
				this.id_detail.object.stock[ll_insertedrows] = this.id_holdsaledetail.object.stock[li_counter]
				this.id_detail.object.quicksearch[ll_insertedrows] = this.id_holdsaledetail.object.quicksearch[li_counter]
