// w_sale.wf_setguestcheckin() returns long
	long ll_guestcode
	long ll_guestcheckincode
	long ll_found
	setnull(ll_guestcheckincode)
	ll_guestcode = this.id_master.object.guestcode[1]
	if ll_guestcode > 0 then
		SQL SELECT MAX ( GC.GuestCheckInCode ) INTO :ll_guestcheckincode FROM GuestCheckIn GC WHERE GC.GuestCode =:ll_guestcode AND GC.CheckOut ='N' USING this.it_transobject;
		if ll_guestcheckincode = 0 or isnull(ll_guestcheckincode) then
			setnull(ll_guestcheckincode)
		end if
		this.id_master.object.guestcheckincode[1] = ll_guestcheckincode
	else
		this.id_master.object.guestcheckincode[1] = ll_guestcheckincode
	end if
	return 0

// w_sale.wf_setguestinfo(long al_code) returns long
	long ll_doctcode
	long ll_custcode
	long ll_retcode
	string ls_regno
	string ls_aliasname
	SQL SELECT Guest.RegNo , Guest.CustCode , Accounts.AliasName INTO :ls_regno, :ll_custcode, :ls_aliasname FROM Guest , Accounts WHERE Guest.GuestCode =:al_code AND Guest.Active ='Y' AND Guest.CustCode =Accounts.AccCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.setitem(this.id_master.rowcount(), "Guestregno", ls_regno)
		this.id_master.setitem(this.id_master.rowcount(), "custcode", ll_custcode)
		this.id_master.setitem(this.id_master.rowcount(), "aliasname", ls_aliasname)
		this.id_master.object.custcode.protect = 1
		this.id_master.object.aliasname.protect = 1
		wf_set_guestbalance(al_code)
		ll_retcode = 1
	else
		messagebox("Guest Information", "Problem in retrieving corresponding customer")
		ll_retcode = 0
	end if
	return ll_retcode

// w_sale.wf_setstudentinfo(long al_code) returns long
	long ll_doctcode
	long ll_custcode
	long ll_retcode
	string ls_regno
	string ls_aliasname
	SQL SELECT Student.RegNo , Student.CustCode , Accounts.AliasName INTO :ls_regno, :ll_custcode, :ls_aliasname FROM Student , Accounts WHERE Student.StudentCode =:al_code AND Student.CustCode =Accounts.AccCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.setitem(this.id_master.rowcount(), "Studentregno", ls_regno)
		this.id_master.setitem(this.id_master.rowcount(), "custcode", ll_custcode)
		this.id_master.setitem(this.id_master.rowcount(), "aliasname", ls_aliasname)
		this.id_master.object.custcode.protect = 1
		this.id_master.object.aliasname.protect = 1
		wf_set_studentbalance(al_code)
		ll_retcode = 1
	else
		messagebox("Student Information", "Problem in retrieving corresponding customer")
		ll_retcode = 0
	end if
	return ll_retcode

// w_sale.wf_findguestcode(string as_regno, ref long al_code) returns long
	long ll_guestcode
	long ll_retflag
	string ls_itemname
	char lc_active
	ll_retflag = 0
	SQL SELECT Guest.Guestcode , Guest.active INTO :ll_guestcode, :lc_active FROM Guest WHERE Guest.regno =:as_regno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_code = ll_guestcode
		if isnull(al_code) then
			ll_retflag = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
		else
			ll_retflag = -2
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_sale.wf_findstudentcode(string as_regno, ref long al_code) returns long
	long ll_studentcode
	long ll_retflag
	string ls_itemname
	ll_retflag = 0
	SQL SELECT Student.Studentcode INTO :ll_studentcode FROM Student WHERE Student.regno =:as_regno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_code = ll_studentcode
		if isnull(al_code) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_sale.wf_misccharges_calc() returns integer
	double ld_misccharges
	double ld_misccharges_perc
	double ld_invtotal
	long ll_custcode
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	ld_misccharges = this.id_footer.getitemnumber(1, "misccharges")
	ld_invtotal = this.id_footer.getitemnumber(1, "total")
	ld_misccharges_perc = 0
	SQL select miscchargesperc INTO :ld_misccharges_perc FROM Customer WHERE customer.custcode =:ll_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Database Problem", "Unable to get customer Misc.Charges(%)")
		return -1
	end if
	ld_misccharges = (ld_invtotal - ld_misccharges) * 0.01 * ld_misccharges_perc
	this.id_footer.object.misccharges[1] = ld_misccharges + this.id_footer.object.misccharges1[1] + this.id_footer.object.misccharges2[1] + this.id_footer.object.misccharges3[1] + this.id_footer.object.misccharges4[1] + this.id_footer.object.misccharges5[1] + this.id_footer.object.advancetaxamt[1]
	return 0

// w_sale.wf_show_mastercashierwindow(integer ai_mode) returns long
	long ll_counter
	long ll_code
	long ll_row
	long ll_insrow
	long ll_module
	long ll_cashacccode
	double ld_tot_acc_amt
	double ld_sale
	double ld_ret
	s_mastercashwin lstr_values
	string ls_cashtend
	string ls_invtotal
	integer li_roundupto
	li_roundupto = f_numberpreferences("roundsaleinvon")
	if isnull(li_roundupto) or li_roundupto < 0 then
		li_roundupto = 0
	end if
	if this.is_callermodule <> "" then
		return 1
	end if
	if this.ii_saletype = 3 then
		lstr_values.i_interfacecode = 2
		if f_stringpreferences("showmastercashwinincashsale") = "N" then
			return 1
		end if
		ll_module = 10
	else
		lstr_values.i_interfacecode = 3
		if f_stringpreferences("showmastercashwinincrsale") = "N" then
			return 1
		end if
		ll_module = 11
	end if
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
		return 0
	end if
	lstr_values.l_invcode = ll_code
	lstr_values.l_cashacccode = ll_cashacccode
	lstr_values.l_groupcode = this.il_groupcode
	lstr_values.l_module = ll_module
	ld_sale = wf_grandtotal()
	if isnull(ld_sale) then
		ld_sale = 0
	end if
	ld_ret = this.id_footer.object.salereturnamt[1]
	if isnull(ld_ret) then
		ld_ret = 0
	end if
	lstr_values.d_netamt = round(ld_sale - ld_ret, li_roundupto)
	lstr_values.d_cashtendered = this.id_master.object.cashtendered[this.id_master.rowcount()]
	lstr_values.d_cashcharged = this.id_master.object.cashcharged[this.id_master.rowcount()]
	lstr_values.d_cashback = this.id_master.object.cashback[this.id_master.rowcount()]
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		lstr_values.l_acccode[ll_counter] = this.ids_cashwin.object.acccode[ll_counter]
		lstr_values.s_remarks[ll_counter] = this.ids_cashwin.object.remarks[ll_counter]
		lstr_values.d_amount[ll_counter] = this.ids_cashwin.object.amount[ll_counter]
		lstr_values.l_rowid[ll_counter] = this.ids_cashwin.object.rowid[ll_counter]
		ld_tot_acc_amt = ld_tot_acc_amt + this.ids_cashwin.object.amount[ll_counter]
	next
	if lstr_values.d_netamt >= lstr_values.d_cashcharged then
		lstr_values.d_invbalance = lstr_values.d_netamt - lstr_values.d_cashcharged - ld_tot_acc_amt
	else
		lstr_values.d_invbalance = 0
	end if
	for ll_counter = 1 to 100
		if lstr_values.l_rowid[ll_counter] <= 0 then
			lstr_values.l_rowid[ll_counter] = -1
		end if
	next
	lstr_values.l_mode = ai_mode
	openwithparm(w_cashierwindow, lstr_values)
	lstr_values = message.powerobjectparm
	if lstr_values.i_status = 1 then
		this.ids_cashwin.reset()
		ld_tot_acc_amt = 0
		for ll_counter = 1 to 100
			if lstr_values.l_acccode[ll_counter] > 0 and lstr_values.d_amount[ll_counter] > 0 and lstr_values.l_rowid[ll_counter] > 0 then
				ll_insrow = this.ids_cashwin.insertrow(0)
				this.ids_cashwin.object.saleinvcode[ll_insrow] = ll_code
				this.ids_cashwin.object.acccode[ll_insrow] = lstr_values.l_acccode[ll_counter]
				this.ids_cashwin.object.remarks[ll_insrow] = lstr_values.s_remarks[ll_counter]
				this.ids_cashwin.object.amount[ll_insrow] = lstr_values.d_amount[ll_counter]
				this.ids_cashwin.object.rowid[ll_insrow] = lstr_values.l_rowid[ll_counter]
			end if
		next
		this.id_master.object.cashacccode[this.id_master.rowcount()] = lstr_values.l_cashacccode
		this.id_master.object.cashtendered[this.id_master.rowcount()] = lstr_values.d_cashtendered
		this.id_master.object.cashcharged[this.id_master.rowcount()] = lstr_values.d_cashcharged
		this.id_master.object.cashback[this.id_master.rowcount()] = lstr_values.d_cashback
		this.id_master.object.cashreceived[this.id_master.rowcount()] = lstr_values.d_cashtendered
		if this.ii_saletype = 3 then
			if this.id_master.object.cashcharged[this.id_master.rowcount()] = lstr_values.d_netamt and lstr_values.d_invbalance = 0 then
				this.id_master.object.outstandingamt[this.id_master.rowcount()] = 0
			else
				this.id_master.object.outstandingamt[this.id_master.rowcount()] = lstr_values.d_invbalance
			end if
		else
			this.id_master.object.outstandingamt[this.id_master.rowcount()] = lstr_values.d_invbalance
		end if
		if f_stringpreferences("DisplayPool") = "Y" and upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
			ls_cashtend = string(this.id_master.object.cashtendered[this.id_master.rowcount()], "#######0.00")
			ls_invtotal = string(lstr_values.d_netamt, "########0.00")
			this.ole_lcddisplay.object.__invoke_method("showcashtender", 2, {ls_invtotal, ls_cashtend}, true)
		end if
		return 1
	end if
	return 0

// w_sale.wf_setamountoninvoice(integer ai_mode) returns 0
	long ll_null
	long ll_rightfound
	double ld_netamt
	double ld_null
	string ls_null
	s_amountoninvoice lstr_amountoninvoice
	setnull(ld_null)
	setnull(ls_null)
	setnull(ll_null)
	if ai_mode = 1 then
		ld_netamt = wf_grandtotal()
		lstr_amountoninvoice.l_invcode = this.id_master.getitemnumber(1, "code")
		lstr_amountoninvoice.d_netamt = ld_netamt
		lstr_amountoninvoice.d_amt = this.id_master.getitemdecimal(1, "amt")
		if isnull(lstr_amountoninvoice.d_amt) then
			lstr_amountoninvoice.d_balance = ld_netamt
		else
			lstr_amountoninvoice.d_balance = ld_netamt - lstr_amountoninvoice.d_amt
		end if
		lstr_amountoninvoice.c_paymentmode = this.id_master.getitemstring(1, "paymentmode")
		lstr_amountoninvoice.i_acccode = this.id_master.getitemnumber(1, "paymentacccode")
		lstr_amountoninvoice.s_reference = this.id_master.getitemstring(1, "amtreference")
		lstr_amountoninvoice.s_module = "sales"
		lstr_amountoninvoice.l_mode = ai_mode
		openwithparm(w_amountoninvoice, lstr_amountoninvoice)
		return
	end if
	if this.ii_saletype <> 3 then
		if f_stringpreferences("showmastercashwinincrsale") = "Y" then
			return
		end if
		if this.id_master.getitemstring(1, "accountfor") = "Y" then
			ld_netamt = wf_grandtotal()
			if f_stringpreferences("AskAmtOnCreditSale") = "Y" then
				ll_rightfound = 0
				ll_rightfound = gds_securitywindow.find("rightcode = 582", 1, gds_securitywindow.rowcount())
				lstr_amountoninvoice.l_invcode = this.id_master.getitemnumber(1, "code")
				lstr_amountoninvoice.d_netamt = ld_netamt
				lstr_amountoninvoice.d_amt = this.id_master.getitemdecimal(1, "amt")
				if isnull(lstr_amountoninvoice.d_amt) then
					lstr_amountoninvoice.d_balance = ld_netamt
				else
					lstr_amountoninvoice.d_balance = ld_netamt - lstr_amountoninvoice.d_amt
				end if
				if isnull(this.id_master.getitemstring(1, "paymentmode")) then
					this.id_master.setitem(1, "paymentmode", f_stringpreferences("SalePaymentMode"))
					this.id_master.setitem(1, "paymentacccode", f_numberpreferences("SalePaymentAcccode"))
				end if
				lstr_amountoninvoice.c_paymentmode = this.id_master.getitemstring(1, "paymentmode")
				lstr_amountoninvoice.i_acccode = this.id_master.getitemnumber(1, "paymentacccode")
				lstr_amountoninvoice.s_reference = this.id_master.getitemstring(1, "amtreference")
				lstr_amountoninvoice.s_module = "sales"
				if ll_rightfound > 0 then
					lstr_amountoninvoice.l_mode = 0
					openwithparm(w_amountoninvoice, lstr_amountoninvoice)
					lstr_amountoninvoice = message.powerobjectparm
					if lstr_amountoninvoice.l_mode <> 1 then
						this.id_master.setitem(1, "amt", lstr_amountoninvoice.d_amt)
						this.id_master.setitem(1, "paymentmode", lstr_amountoninvoice.c_paymentmode)
						this.id_master.setitem(1, "paymentacccode", lstr_amountoninvoice.i_acccode)
						this.id_master.setitem(1, "amtreference", lstr_amountoninvoice.s_reference)
					end if
				end if
				if ld_netamt - lstr_amountoninvoice.d_amt >= 0.0 then
					this.id_master.setitem(1, "outstandingamt", ld_netamt - lstr_amountoninvoice.d_amt)
				else
					this.id_master.setitem(1, "outstandingamt", 0)
				end if
			else
				this.id_master.setitem(1, "outstandingamt", ld_netamt)
				this.id_master.setitem(1, "paymentmode", ls_null)
				this.id_master.setitem(1, "paymentacccode", ll_null)
				this.id_master.setitem(1, "amtreference", ls_null)
				this.id_master.setitem(1, "amt", 0)
			end if
		else
			this.id_master.setitem(1, "outstandingamt", 0)
			this.id_master.setitem(1, "paymentmode", ls_null)
			this.id_master.setitem(1, "paymentacccode", ll_null)
			this.id_master.setitem(1, "amtreference", ls_null)
			this.id_master.setitem(1, "amt", 0)
		end if
		return
	end if
	if f_stringpreferences("showmastercashwinincashsale") = "Y" then
		return
	end if
	this.id_master.setitem(1, "amt", 0)
	this.id_master.setitem(1, "paymentmode", ls_null)
	this.id_master.setitem(1, "paymentacccode", ll_null)
	this.id_master.setitem(1, "amtreference", ls_null)
	this.id_master.setitem(1, "outstandingamt", 0)

// w_sale.wf_show_payment_info() returns long
	long ll_code
	double ld_amt
	double ld_cashreceived
	boolean lb_listtab
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
		this.id_master.retrieve(ll_code)
		if this.id_master.rowcount() > 0 then
			ld_amt = this.id_master.object.amt[this.id_master.rowcount()]
		else
			ld_amt = 0
		end if
		if ll_code > 0 and lb_listtab then
			if ld_amt > 0.0 then
				wf_setamountoninvoice(1)
			else
				wf_show_mastercashierwindow(1)
			end if
		end if
	end if
	return 0

// w_sale.wf_set_packingdescription(string as_alternatealiasname, ref string as_packingdesc) returns long
	string ls_packingdesc
	as_packingdesc = ls_packingdesc
	if isnull(as_alternatealiasname) or as_alternatealiasname = "" or len(as_alternatealiasname) = 0 then
		return 0
	end if
	SQL SELECT PackingDesc INTO :ls_packingdesc FROM DBO.AlternateItemAlias WHERE CustomICode =:as_alternatealiasname USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		as_packingdesc = ls_packingdesc
		return 0
	end if
	return -1

// w_sale.wf_show_studentledger() returns 0
	long ll_studentcode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_studentcode = this.id_master.object.studentcode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_studentcode = this.id_list.object.studentcode[this.id_list.getrow()]
	end if
	if not isnull(ll_studentcode) and ll_studentcode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_student_ledger, ll_studentcode)
	end if

// w_sale.wf_insertrow_holdsaledetail(ref datawindow ad_holdsaledetail) returns long
	long ll_detailrows
	long ll_counter
	long ll_gcode
	long ll_icode
	long ll_insertedrows
	double ld_holdqty
	datawindowchild ldc_itemmeter
	datawindowchild ldc_godown
	ad_holdsaledetail.getchild("itemmetername", ldc_itemmeter)
	ldc_itemmeter.settransobject(this.it_transobject)
	ldc_itemmeter.retrieve(0)
	if ldc_itemmeter.rowcount() <= 0 then
		ldc_itemmeter.insertrow(0)
	end if
	ad_holdsaledetail.getchild("gcode", ldc_godown)
	ldc_godown.settransobject(this.it_transobject)
	ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	ll_detailrows = this.id_detail.rowcount()
	for ll_counter = 1 to ll_detailrows
