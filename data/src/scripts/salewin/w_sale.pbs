				messagebox("Discount Validation", "Given Discount = " + trim(string(ld_discgiven, "###,###.##")) + "%~r~n" + "Maximun Sale Discount = " + trim(string(ld_maxitemsalediscperc, "###,###.##")) + "%~r~n~r~n" + "Given Discount Percentage is greater than Maximum Sale Discount Percentage for this item~r~n~r~n" + "Please consult Administrator", stopsign!)
