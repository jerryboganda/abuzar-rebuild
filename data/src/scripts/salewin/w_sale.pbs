// w_sale.wf_set_guestbalance(long al_code) returns long
	datetime ldt_datetime
	double ld_balance
	ldt_datetime = datetime(date(today()), time(today()))
	this.it_transobject.guestopeningbalance(al_code, ldt_datetime, ld_balance)
	if this.it_transobject.sqlcode = 0 then
		this.id_master.object.guestbalance[1] = ld_balance
		return 0
