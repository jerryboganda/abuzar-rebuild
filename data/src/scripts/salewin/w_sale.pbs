// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "date"
		messagebox("Date Time Validation", "Date and Time is invalid,~r~nPlease enter current date and time")
	case "custcode"
		if f_stringpreferences("ValidateCustLicExpiryInSale") = "N" then
			messagebox("Customer Name Validation", "You must select some Customer")
		end if
	case "custrefno"
		if data = "" or isnull(data) then
			messagebox("Customer Reference Validation", "Please Enter Reference")
		end if
	case "headerno"
		if data = "" or isnull(data) then
			messagebox("Header No Validation", "You must select some HeaderNo")
		end if
	case "Regno"
		if data = "" or isnull(data) then
			messagebox("Patient Validation", "RegNo Does Not Exist")
		end if
	end choose
	return 1

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	s_arguements lstr_arg
	long[] la_custcatcode
	long ll_counter
	long ll_foundcode
	long ll_custcode
	string ls_custcats
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	try
		if keyflags = 2 and key = keyf11! then
			parent.parent.parent.wf_save_refusedsale_only()
			setfocus()
		end if
		if key = keyenter! and getcolumnname() = "custcode" then
			parent.parent.parent.id_master.setitem(1, "custcode", parent.parent.parent.idc_customers.getitemnumber(parent.parent.parent.idc_customers.getrow(), "accounts_acccode"))
			if parent.parent.parent.il_custcode <> parent.parent.parent.id_master.getitemnumber(1, "custcode") and parent.parent.parent.wf_setcustomerinfo(1, 1, string(parent.parent.parent.idc_customers.getitemnumber(parent.parent.parent.idc_customers.getrow(), "accounts_acccode"))) = 1 then
				parent.parent.parent.id_master.setitem(1, "custcode", 0)
			end if
			parent.parent.parent.id_master.setcolumn("custcode")
			parent.parent.parent.id_master.setfocus()
		elseif key = keyf5! and getcolumnname() = "custcode" then
			open(w_choose_customercategory)
			lstr_arg = message.powerobjectparm
			if lstr_arg.i_status = 1 then
				la_custcatcode = lstr_arg.ia_integerlist
				ls_custcats = ""
				for ll_counter = 1 to upperbound(la_custcatcode)
					ls_custcats = ls_custcats + string(la_custcatcode[ll_counter]) + " , "
				next
				ls_custcats = ls_custcats + " 0"
				if parent.parent.parent.ii_saletype = 2 then
					parent.parent.parent.idc_customers.setfilter("custcatcode In (" + ls_custcats + ") and accounts_acccode <> 19 ")
				else
					parent.parent.parent.idc_customers.setfilter("custcatcode In (" + ls_custcats + ") ")
				end if
				parent.parent.parent.idc_customers.filter()
			end if
		elseif key = keyf6! and getcolumnname() = "custcode" then
			parent.parent.parent.wf_new_customerregisteration()
		elseif key = keyf7! and getcolumnname() = "custcode" then
			parent.parent.parent.is_comprehensive_search_dataobject = "d_customer_list"
			ll_foundcode = parent.parent.parent.wf_comprehensive_search()
			if ll_foundcode >= 0 then
				this.object.custcode[1] = ll_foundcode
				if parent.parent.parent.wf_setcustomerinfo(1, 1, string(ll_foundcode)) = 1 then
					parent.parent.parent.id_master.setitem(1, "custcode", 0)
				end if
			end if
		elseif key = keyf8! and getcolumnname() = "custcode" then
			if this.object.custcode[1] > 0 then
				parent.parent.parent.wf_fetch_customerbalance_onremote(this.object.custcode[1])
			end if
		elseif key = keyf6! and getcolumnname() = "patientregno" then
			parent.parent.parent.wf_find_patient_by_phone()
		elseif key = keyf5! and (getcolumnname() = "patientcode" or getcolumnname() = "patientregno") then
			parent.parent.parent.wf_new_patientregistration()
		elseif key = keyf6! and getcolumnname() = "patientcode" then
			if parent.parent.parent.ic_retrievepatientlist = "Y" then
				parent.parent.parent.is_comprehensive_search_dataobject = "d_patient_comprehensive_list"
				ll_foundcode = parent.parent.parent.wf_comprehensive_search()
				if ll_foundcode >= 0 then
					this.object.patientcode[1] = ll_foundcode
					parent.parent.parent.wf_setpatientinfo(ll_foundcode)
					if parent.parent.parent.ic_retrievepatientlist = "N" then
						parent.parent.parent.wf_validate_patient_from_outside(this.object.patientregno[1])
					end if
				end if
			else
				parent.parent.parent.wf_patientsearch()
			end if
		elseif key = keyf7! and getcolumnname() = "patientcode" then
			parent.parent.parent.wf_set_patientimage("SV")
		elseif key = keyf8! and getcolumnname() = "patientcode" then
			parent.parent.parent.wf_show_patientinfo()
		elseif key = keyf9! and getcolumnname() = "patientcode" then
			parent.parent.parent.wf_show_patientgallery()
		elseif key = keyf5! and (getcolumnname() = "motorvehiclecode" or getcolumnname() = "chasisno") then
			parent.parent.parent.wf_new_motorvehicle()
		elseif key = keyf6! and (getcolumnname() = "motorvehiclecode" or getcolumnname() = "chasisno") then
			parent.parent.parent.wf_motorvehiclesearch()
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
		setnull(ll_counter)
		parent.parent.parent.id_master.setitem(1, "custcode", ll_counter)
	end try
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_detail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	parent.parent.parent.post wf_setcustomername(data)
	return ::message.returnvalue

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	long ll_null
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	setnull(ll_null)
	if string(dwo.name) = "custcode" then
		parent.parent.parent.id_master.selecttext(1, 40)
		if f_stringpreferences("CreditSaleAutoPopUpWindow") = "Y" then
			parent.parent.parent.post wf_viewheader()
		end if
	end if
	if parent.parent.parent.ls_master_last_itemfocuschanged = "patientcode" then
		parent.parent.parent.ls_master_last_itemfocuschanged = ""
		if parent.parent.parent.wf_checkpatientlicexpiry(this.object.patientcode[row]) = 2 then
			setcolumn("patientcode")
			this.object.patientcode[row] = ll_null
		end if
	else
		parent.parent.parent.ls_master_last_itemfocuschanged = string(dwo.name)
	end if
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	if getcolumnname() = "remarks" and parent.parent.parent.wf_check_customer(parent.parent.parent.il_custcode) = false and parent.parent.parent.ib_validcustomer = false then
		parent.parent.parent.id_master.setcolumn("custcode")
		parent.parent.parent.id_master.setfocus()
	end if
	return ::message.returnvalue

// dw_detail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_detail.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	parent.parent.parent.id_footer.accepttext()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_itemsdetail.ue_focuscustomer() returns 0 [event]
	integer ll_row
	integer ll_custcode
	parent.parent.parent.id_master.setcolumn("custcode")
	parent.parent.parent.id_master.setfocus()
	messagebox("Customer Selection", "Please select a Customer from the Dropdown Box")

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	long ll_null
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_totalpieces
	long ll_piecesinhand
	long ll_itemcodetype
	double ld_newqty
	double ld_storedqty
	double ld_stock
	double ld_desiredbonus
	double ld_bonuspackqty
	double ld_newbonusqty
	double ld_packqty
	double ld_itemvalue
	string ls_null
	string ls_itemname
	double ld_invdiscperc
	integer li_res
	double ld_saleprice
	double ld_salediscperc
	double ld_purdiscperc
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	if row > 0 and getrow() > 0 then
		choose case dwo.name
		case "itemname", "fullcode", "saleprice", "packsaleprice", "rateperlength", "discprice", "prediscperc", "extrataxperc", "itemflatdisc", "discperc", "gstperc", "unitsalestax", "cloneitemflatdisc", "clonediscperc"
			this.object.taxflag[row] = 0
		end choose
	end if
	choose case dwo.name
	case "itemmetername"
		if len(data) > 0 then
			if parent.parent.parent.wf_get_itemmeter_reading(data, row) > 0 then
				messagebox("Item Meter Validation", "Problem in Fetching Item Meter Reading", stopsign!)
				return 1
			else
				return 0
			end if
		else
			messagebox("Item Meter Validation", "Problem in Fetching Item Meter Reading", stopsign!)
			return 1
		end if
	case "totalpieces"
		ll_totalpieces = long(data)
		ll_piecesinhand = this.object.piecesinhand[row]
		if ll_totalpieces < 0 then
			messagebox("Total Pieces Validation", "Total Pieces can not be negative", stopsign!)
			return 1
		end if
		if ll_totalpieces > ll_piecesinhand then
			messagebox("Total Pieces Validation", "Total Pieces Exceed Total No. of pieces in hand/stock", stopsign!)
			return 1
		end if
	case "quicksearch"
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		if isnull(data) or data = "" then
			return 0
		else
			li_errcode = parent.parent.parent.wf_searchitem_quicksearch(data)
			return li_errcode
		end if
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
		parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		li_errcode = 0
	case "width"
		if double(data) > 0.0 then
			this.object.looseqty[row] = double(data) * this.object.length[row]
		else
			return 1
		end if
	case "length"
		if double(data) > 0.0 then
			this.object.looseqty[row] = double(data) * this.object.width[row]
		else
			return 1
		end if
	case "packqtyforsale"
		return parent.parent.parent.wf_validate_packsaleqty(row, data)
	case "bonuspackqtyforsale"
		return parent.parent.parent.wf_validate_packbonusqty(row, data)
	case "looseqty"
		return parent.parent.parent.wf_validate_qty(row, data)
	case "bonusqty"
		li_errcode = parent.parent.parent.wf_validate_bonusqty(row, data)
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname, ll_itemcodetype, parent.parent.parent.idbl_packqty, parent.parent.parent.idbl_purprice, parent.parent.parent.idbl_saleprice)
			if li_res > 0 then
				if parent.parent.parent.idbl_packqty <= 0.0 or isnull(parent.parent.parent.idbl_packqty) then
					parent.parent.parent.idbl_packqty = 1
				end if
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				setitem(row, "looseqty", parent.parent.parent.idbl_packqty)
				if ll_itemcodetype = 2 then
					setitem(row, "alternatecustomicode", data)
					if parent.parent.parent.ib_applyalternatealiasprice then
						setitem(row, "rate", parent.parent.parent.idbl_saleprice / parent.parent.parent.idbl_packqty)
						setitem(row, "packsaleprice", parent.parent.parent.idbl_saleprice)
						setitem(row, "packprice", parent.parent.parent.idbl_saleprice)
						setitem(row, "saleprice", parent.parent.parent.idbl_saleprice / parent.parent.parent.idbl_packqty)
					end if
				else
					setitem(row, "alternatecustomicode", ls_null)
				end if
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
				if parent.parent.parent.wf_validateitem(false) = 0 then
					li_errcode = 0
				else
					li_errcode = 1
				end if
			else
				messagebox("Item Code/Alias Name Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_errcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_errcode = 2
		end if
	case "packsaleprice"
		setitem(row, "updatesaleprice", "Y")
		if getitemstring(row, "locksaleprice") = "Y" then
			messagebox("SalePrice Validation", "SalePrice is locked, you can not change it ")
			li_errcode = 2
		elseif double(data) < 0.0 then
			li_errcode = 1
		else
			if parent.parent.parent.id_detail.object.packunits[row] = 0 or isnull(parent.parent.parent.id_detail.object.packunits[row]) then
				parent.parent.parent.id_detail.object.saleprice[row] = round(double(data), 2)
			else
				parent.parent.parent.id_detail.object.saleprice[row] = round(double(data) / parent.parent.parent.id_detail.object.packunits[row], 2)
			end if
			parent.parent.parent.wf_discpricecalc(parent.parent.parent.id_detail.object.discperc[row])
			li_errcode = 0
			if parent.parent.parent.id_detail.object.saleprice[row] > 0 then
				this.object.prediscperc[row] = round(this.object.itemflatdisc[row] / parent.parent.parent.id_detail.object.saleprice[row] * 100, 2)
			elseif this.object.itemflatdisc[row] > parent.parent.parent.id_detail.object.saleprice[row] then
				this.object.prediscperc[row] = 100
			else
				this.object.prediscperc[row] = round(this.object.itemflatdisc[row], 2)
			end if
		end if
	case "saleprice"
		setitem(row, "updatesaleprice", "Y")
		if isnull(this.object.icode[row]) and double(data) <> 0.0 then
			messagebox("Sale Price Validation", "Sale Price is is not valid. Please select some valid item and then enter sale price", stopsign!)
			return 1
		end if
		if getitemstring(row, "locksaleprice") = "Y" then
			messagebox("SalePrice Validation", "SalePrice is locked, you can not change it ")
			return 2
		else
			parent.parent.parent.id_detail.object.packsaleprice[row] = round(double(data) * parent.parent.parent.id_detail.object.packunits[row], 2)
			li_errcode = parent.parent.parent.wf_itemnetprice(double(data), parent.parent.parent.id_detail.getitemnumber(row, "discperc"), parent.parent.parent.id_detail.getitemnumber(row, "Itemflatdisc"), this.object.icode[row])
		end if
		if double(data) > 0.0 then
			this.object.prediscperc[row] = round(this.object.itemflatdisc[row] / double(data) * 100, 2)
		elseif this.object.itemflatdisc[row] > double(data) then
			this.object.prediscperc[row] = 100
		else
			this.object.prediscperc[row] = round(this.object.itemflatdisc[row], 2)
		end if
		if this.object.length[row] > 0 then
			this.object.rateperlength[row] = round(double(data) / this.object.length[row], 2)
		else
			this.object.rateperlength[row] = round(double(data) / 1.0, 2)
		end if
	case "rateperlength"
		if double(data) > 0.0 then
			this.object.saleprice[row] = round(double(data) * this.object.length[row], 2)
			li_errcode = 0
		elseif double(data) = 0.0 then
			this.object.saleprice[row] = 0.00
			li_errcode = 0
		else
			messagebox("Rate/Length Validation", "Rate/Length is not valid. Please enter some possitive value")
			li_errcode = 1
		end if
	case "discprice"
		return parent.parent.parent.wf_discperccalc(data)
	case "gcode"
		parent.parent.parent.is_columnname = "gcode"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_godownvalidated = false
		li_errcode = 0
	case "prediscperc"
		if double(data) < 0.0 or isnull(data) or double(data) > 100.0 then
			messagebox("Pre-Disc. %age Validation", "Pre-Disc. %age must be a valid value [Range 0-100]")
			return 1
		else
			this.object.itemflatdisc[row] = round(this.object.saleprice[row] * double(data) * 0.01, 2)
			this.object.cloneitemflatdisc[row] = this.object.itemflatdisc[row]
			return 0
		end if
	case "extrataxperc"
		if double(data) < 0.0 or isnull(data) or double(data) > 100.0 then
			messagebox("Extra Tax %age Validation", "Extra Tax %age must be a valid value [Range 0-100]")
			return 1
		else
			ld_itemvalue = getitemnumber(row, "c_itemtotal")
			ld_newqty = this.object.looseqty[row] + this.object.bonusqty[row]
			if ld_newqty <= 0.0 or isnull(ld_newqty) then
				ld_newqty = 1
			end if
			if isnull(ld_itemvalue) or ld_itemvalue <= 0.0 then
				ld_itemvalue = 0.00
			end if
			this.object.unitsalestax[row] = round(ld_itemvalue * double(data) * 0.01 / ld_newqty, 2)
			return 0
		end if
	case "itemflatdisc"
		if isnull(this.object.icode[row]) and double(data) <> 0.0 then
			messagebox("Item Flat Discount Validation", "Item Flat Discount  is is not valid. Please select some valid item and then enter Item Flat Discount", stopsign!)
			return 1
		end if
		ld_saleprice = getitemnumber(row, "saleprice")
		if ld_saleprice < double(data) then
			messagebox("FlatDisc Validation", "Itemflatdisc must be less than sale price")
			li_errcode = 1
		end if
		if li_errcode = 0 then
			if this.object.saleprice[row] > 0 then
				this.object.prediscperc[row] = round(double(data) / this.object.saleprice[row] * 100, 2)
				this.object.cloneitemflatdisc[row] = round(double(data), 2)
			else
				this.object.prediscperc[row] = round(double(data), 2)
			end if
		end if
		li_errcode = parent.parent.parent.wf_itemnetprice(parent.parent.parent.id_detail.getitemnumber(row, "saleprice"), parent.parent.parent.id_detail.getitemnumber(row, "discperc"), double(data), this.object.icode[row])
	case "purunitrate"
		if double(data) < 0.0 then
			messagebox("Purchase Price Validation", "Purchase Price must be +ve")
			li_errcode = 1
		else
			li_errcode = 0
		end if
	case "claimablediscperc"
		if long(data) < 0 or long(data) > 100 then
			messagebox("Claimable Discount Validation", "Claimable Discount must be within the range of 0 and 100")
			li_errcode = 1
		end if
	case "discperc"
		if isnull(this.object.icode[row]) and double(data) <> 0.0 then
			messagebox("Discount % Validation", "Discount % is is not valid. Please select some valid item and then enter Discount %age.", stopsign!)
			return 1
		end if
		if getitemstring(row, "lockdiscperc") = "Y" then
			messagebox("Disc(%) Validation", "Disc(%) is locked, you can not change it")
			li_errcode = 2
		else
			if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
				ld_salediscperc = double(data)
				ll_icode = this.object.icode[row]
				SQL Select item.purdiscperc INTO :ld_purdiscperc From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
				if ld_salediscperc > ld_purdiscperc then
					messagebox("Discount Validation", "Discount(%) " + data + " exceeds the purchase discount")
					li_errcode = 1
				end if
			end if
			parent.parent.parent.id_detail.object.clonediscperc[row] = double(data)
			li_errcode = parent.parent.parent.wf_itemnetprice(parent.parent.parent.id_detail.getitemnumber(row, "saleprice"), double(data), parent.parent.parent.id_detail.getitemnumber(row, "Itemflatdisc"), this.object.icode[row])
		end if
	case "pcs"
		return parent.parent.parent.wf_validate_pcs(row, data)
	case else
		if "saleitemdescription" = dwo.name and f_stringpreferences("allowemptyitemdescinsale") = "N" and (data = "" or isnull(data)) then
			li_errcode = 1
		end if
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ll_icode
	long ll_gcode
	long ll_count
	long ll_check_dup_icode
	double ld_godownstock
	long ancestorreturnvalue
	ll_check_dup_icode = parent.parent.parent.id_detail.getitemnumber(row, "icode")
	if dwo.name = "itemmetername" and row > 0 then
		ll_icode = this.object.icode[row]
		if ll_icode > 0 then
			parent.parent.parent.idc_itemmeter.retrieve(ll_icode)
			if parent.parent.parent.idc_itemmeter.rowcount() <= 0 then
				parent.parent.parent.idc_itemmeter.insertrow(0)
			elseif isnull(this.object.itemmetername[row]) or this.object.itemmetername[row] = "" then
				this.object.itemmetername[row] = parent.parent.parent.idc_itemmeter.getitemstring(1, "name")
				this.object.itemmetercode[row] = parent.parent.parent.idc_itemmeter.getitemnumber(1, "itemmetercode")
				parent.parent.parent.wf_get_itemmeter_reading(this.object.itemmetername[row], row)
			end if
		end if
	end if
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(false) = -1 then
		return ::message.returnvalue
	end if
	if parent.parent.parent.ib_godownvalidated = false and parent.parent.parent.wf_validategodown() = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "itemname" then
		if len(getitemstring(getrow(), "quicksearch")) > 0 and getitemnumber(getrow(), "icode") > 0.0 then
			setcolumn("looseqty")
			return 0
		else
			parent.parent.parent.ib_focusdetail = true
		end if
	end if
	if dwo.name = "looseqty" then
		if parent.parent.parent.ib_itemslistopen then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
		end if
		if parent.parent.parent.is_last_itemdetail_focus_column <> "looseqty" and f_stringpreferences("AutoOpenItemPeriorityWindow") = "Y" then
			parent.parent.parent.wf_itemperiority()
		end if
	end if
	parent.parent.parent.is_last_itemdetail_focus_column = dwo.name
	parent.parent.parent.wf_grandtotal()
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return 0

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	double ld_rppmargin
	dwitemstatus lrs_status
	long ll_icode
	double ld_purdiscperc
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if currentrow > 0 and rowcount() > 0 then
		parent.parent.parent.is_aliasname = getitemstring(currentrow, "fullcode")
	end if
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(true) = -1 then
		return ::message.returnvalue
	end if
	if parent.parent.parent.ib_godownvalidated = false and parent.parent.parent.wf_validategodown() = -1 then
		return ::message.returnvalue
	end if
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if getcolumnname() <> parent.parent.parent.is_columnitemname then
		if rowcount() > 0 and lrs_status <> new! then
			parent.parent.parent.wf_set_itemimage(getitemnumber(currentrow, "icode"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", getitemnumber(currentrow, "icode"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", getitemnumber(currentrow, "stock"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "retailprice", getitemdecimal(currentrow, "retailprice"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "piecesinhand", getitemnumber(currentrow, "piecesinhand"))
			ld_rppmargin = getitemnumber(currentrow, "packprice") - getitemnumber(currentrow, "recentpurprice")
			if getitemnumber(currentrow, "packprice") = 0.0 then
				ld_rppmargin = ld_rppmargin * 100.0
			elseif getitemnumber(currentrow, "packprice") = 0.0 or isnull(getitemnumber(currentrow, "packprice")) then
				ld_rppmargin = ld_rppmargin * 100.0
			else
				ld_rppmargin = ld_rppmargin / getitemnumber(currentrow, "packprice") * 100.0
			end if
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "rppmargin", ld_rppmargin)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "rpp", getitemnumber(currentrow, "recentpurprice"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "purprice", getitemnumber(currentrow, "purprice"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "avgprice", getitemnumber(currentrow, "avgprice"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "itemtotalval", getitemstring(currentrow, "itemtotalval"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "latestnetrate", getitemnumber(currentrow, "latestnetrate"))
			if f_stringpreferences("BonusinSale") = "Y" then
				parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "bonusratio", trim(string(getitemnumber(currentrow, "qtysale"))) + ":" + trim(string(getitemnumber(currentrow, "bonus"))))
			end if
			if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
				ll_icode = this.object.icode[currentrow]
				SQL Select item.purdiscperc INTO :ld_purdiscperc From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
				parent.parent.parent.id_footer.object.t_purdiscper.text = string(ld_purdiscperc)
			end if
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", getitemnumber(currentrow, "totalstock"))
		elseif parent.parent.parent.id_footer.getrow() > 0 then
			parent.parent.parent.id_master.object.p_itemimage.filename = ""
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "piecesinhand", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "retailprice", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "latestnetrate", 0)
			if f_stringpreferences("BonusinSale") = "Y" then
				parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "bonusratio", "")
			end if
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	long ll_currentrow
	string ls_holdstr
	string ls_temp
	string ls_qty
	string ls_rate
	string ls_total
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	if f_stringpreferences("DisplayPool") = "Y" then
		ll_currentrow = getrow()
		if ll_currentrow <> 0 and parent.parent.parent.ib_lcdshow = true then
			if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				if this.object.icode[ll_currentrow] > 0 then
					parent.parent.parent.is_lcditem = trim(left(this.object.itemname[ll_currentrow], 20)) + space(20 - len(trim(left(this.object.itemname[ll_currentrow], 20))))
					parent.parent.parent.is_lcditem2 = "Qty=" + string(this.object.looseqty[ll_currentrow], f_setcolumnformat("Qty")) + " Rs=" + string(this.object.saleprice[ll_currentrow], "#######0.00")
					parent.parent.parent.ic_comport.triggerevent("ue_show")
				end if
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
				parent.parent.parent.is_lcditem = trim(left(this.object.itemname[ll_currentrow], 20)) + space(20 - len(trim(left(this.object.itemname[ll_currentrow], 20))))
				ls_qty = string(this.object.looseqty[ll_currentrow], f_setcolumnformat("Qty"))
				ls_rate = string(this.object.saleprice[ll_currentrow], "#######0.00")
				ls_total = string(this.object.looseqty[ll_currentrow] * this.object.saleprice[ll_currentrow], "#####0.00")
				if isnull(parent.parent.parent.is_lcditem) then
					parent.parent.parent.is_lcditem = ""
				end if
				if isnull(ls_qty) then
					ls_qty = ""
				end if
				if isnull(ls_rate) then
					ls_rate = ""
				end if
				if isnull(ls_total) then
					ls_total = ""
				end if
				if trim(parent.parent.parent.is_lcditem) <> "" then
					parent.parent.parent.ole_lcddisplay.object.__invoke_method("showitem", 4, {parent.parent.parent.is_lcditem, ls_rate, ls_qty, ls_total}, true)
				end if
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "TYSSO VFD-860-A" then
				ls_holdstr = left(this.object.itemname[ll_currentrow], 10)
				if len(ls_holdstr) < 10 then
					ls_holdstr = ls_holdstr + space(10 - len(ls_holdstr))
				end if
				ls_total = "=" + space(9 - len(string(this.object.looseqty[ll_currentrow] * this.object.saleprice[ll_currentrow], "#####0.00"))) + string(this.object.looseqty[ll_currentrow] * this.object.saleprice[ll_currentrow], "#####0.00")
				ls_temp = ls_holdstr + ls_total
				ls_temp = ls_temp + "TOTAL     =" + space(9 - len(string(parent.parent.parent.wf_grandtotal(), "#####0.00"))) + string(parent.parent.parent.wf_grandtotal(), "#####0.00")
				ls_temp = left(ls_temp, 40)
				if len(ls_temp) <= 40 then
					if 40 - len(ls_temp) > 0 then
						ls_temp = ls_temp + space(40 - len(ls_temp))
					else
						ls_temp = left(ls_temp, 40)
					end if
				else
					ls_temp = left(ls_temp, 40)
				end if
				if isnull(ls_temp) then
					ls_temp = ""
				else
					parent.parent.parent.is_lcditem = ls_temp
				end if
				if isnull(parent.parent.parent.is_lcditem) then
					parent.parent.parent.is_lcditem = ""
				end if
				parent.parent.parent.ic_comport.triggerevent("ue_show")
			else
				ls_holdstr = this.object.itemname[ll_currentrow]
				if len(ls_holdstr) < 19 then
					ls_temp = ls_holdstr + space(19 - len(ls_holdstr))
				else
					ls_temp = left(ls_holdstr, 19)
				end if
				ls_temp = ls_temp + "Qty=" + string(this.object.looseqty[ll_currentrow], f_setcolumnformat("Qty"))
				ls_temp = ls_temp + " Rs=" + string(this.object.saleprice[ll_currentrow], "#######0.00")
				if len(ls_temp) <= 39 then
					if 39 - len(ls_temp) > 0 then
						ls_temp = ls_temp + space(39 - len(ls_temp))
					else
						ls_temp = left(ls_temp, 39)
					end if
				else
					ls_temp = left(ls_temp, 39)
				end if
				parent.parent.parent.is_lcditem = ls_temp
				parent.parent.parent.ic_comport.triggerevent("ue_show")
			end if
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "fullcode"
		if data = "" or isnull(data) then
		end if
	case parent.parent.parent.is_columnitemname
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case "packqtyforsale"
		if double(data) < 0.0 or isnull(data) then
			messagebox("Item Pack Qty Validation", "Item Pack Qty ~"" + data + "~" should be greater than or equal to zero")
		end if
	case "bonuspackqtyforsale"
		if double(data) < 0.0 or isnull(data) then
			messagebox("Item Pack Bonus Validation", "Item Pack Bonus ~"" + data + "~" should be greater than or equal to zero")
		end if
	case "looseqty"
	case "packqty"
		if real(data) < 1.0 then
			messagebox("Item Qty Validation", "Item Qty ~"" + data + "~" should be greater than zero")
		end if
	case "discperc"
		if real(data) < 0.0 and real(data) > 100.0 then
			messagebox("Item Discount Validation", "Discount ~"" + data + "~" must be betweeen 0 and 100")
		end if
	case "gcode"
		if real(data) < 0.0 or isnull(data) then
			messagebox("Item Godown Validation", "Please select some other godown")
		end if
	case "saleprice"
		if double(data) < 0.0 then
			messagebox("Item Price Validation", "Item price ~"" + data + "~" must be greater than or equal to zero")
		end if
	case else
		if "saleitemdescription" = dwo.name and f_stringpreferences("allowemptyitemdescinsale") = "N" and (data = "" or isnull(data)) then
			messagebox("Item Description", "Please enter a valid Item Description")
		end if
	end choose
	return 1

// dw_itemsdetail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	integer ll_row
	integer ll_custcode
	long ll_lastinvcode
	long ll_customerallowed
	long ll_crlimt_checked
	long ll_counter
	long ancestorreturnvalue
	parent.parent.parent.id_footer.accepttext()
	parent.parent.parent.wf_grandtotal()
	if f_stringpreferences("enablequickprefferedsearch") = "N" and f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	ll_row = parent.parent.parent.id_master.getrow()
	ll_custcode = parent.parent.parent.id_master.object.custcode[ll_row]
	if parent.parent.parent.ii_saletype = 2 then
		if parent.parent.parent.ii_focuscustomer = 2 and ll_custcode = 0 then
			post event ue_focuscustomer()
		end if
		if parent.parent.parent.ii_focuscustomer = 3 and ll_custcode > 0 and parent.parent.parent.il_custcode <> parent.parent.parent.il_allowedcustomer then
			parent.parent.parent.wf_check_creditlimit(ll_custcode, gl_usercode, 0)
		end if
	elseif parent.parent.parent.ii_focuscustomer = 2 and ll_custcode = 0 then
		post event ue_focuscustomer()
	end if
	if ll_custcode > 0 and parent.parent.parent.ib_validcustomer = false and parent.parent.parent.wf_check_customer(ll_custcode) = false and parent.parent.parent.ib_validcustomer = false then
		post event ue_focuscustomer()
	end if
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanging(long currentrow, long newrow) returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	string ls_holdstr
	string ls_temp
	string ls_qty
	string ls_rate
	string ls_total
	ancestorreturnvalue = super::rowfocuschanging(currentrow, newrow)
	if currentrow <= rowcount() then
		if currentrow > 0 and parent.parent.parent.id_detail.rowcount() > 0 and parent.parent.parent.id_detail.getitemnumber(currentrow, "looseqty") + parent.parent.parent.id_detail.getitemnumber(currentrow, "bonusqty") <= 0.0 then
			messagebox("Sale Qty Validation", "Please Enter Valid Sale Qty")
			parent.parent.parent.id_detail.setcolumn("looseqty")
			parent.parent.parent.id_detail.setrow(currentrow)
			return 1
		end if
		if f_stringpreferences("DisplayPool") = "Y" and (currentrow <> 0 and parent.parent.parent.ib_lcdshow = true) and parent.parent.parent.id_detail.rowcount() > 0 then
			if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				parent.parent.parent.is_lcditem = trim(left(this.object.itemname[currentrow], 20)) + space(20 - len(trim(left(this.object.itemname[currentrow], 20))))
				parent.parent.parent.is_lcditem2 = "Qty=" + string(this.object.looseqty[currentrow], f_setcolumnformat("Qty")) + " Rs=" + string(this.object.saleprice[currentrow], "#######0.00")
				parent.parent.parent.ic_comport.postevent("ue_show")
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
				parent.parent.parent.ole_lcddisplay.object.enablegreeting = false
				parent.parent.parent.is_lcditem = trim(left(this.object.itemname[currentrow], 20)) + space(20 - len(trim(left(this.object.itemname[currentrow], 20))))
				ls_qty = string(this.object.looseqty[currentrow], f_setcolumnformat("Qty"))
				ls_rate = string(this.object.saleprice[currentrow], "#######0.00")
				ls_total = string(this.object.looseqty[currentrow] * this.object.saleprice[currentrow], "#####0.00")
				if isnull(parent.parent.parent.is_lcditem) then
					parent.parent.parent.is_lcditem = ""
				end if
				if isnull(ls_qty) then
					ls_qty = ""
				end if
				if isnull(ls_rate) then
					ls_rate = ""
				end if
				if isnull(ls_total) then
					ls_total = ""
				end if
				if trim(parent.parent.parent.is_lcditem) <> "" then
					parent.parent.parent.ole_lcddisplay.object.__invoke_method("showitem", 4, {parent.parent.parent.is_lcditem, ls_rate, ls_qty, ls_total}, true)
				end if
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "TYSSO VFD-860-A" then
				ls_holdstr = left(this.object.itemname[currentrow], 10)
				if len(ls_holdstr) < 10 then
					ls_holdstr = ls_holdstr + space(10 - len(ls_holdstr))
				end if
				ls_total = "=" + space(9 - len(trim(string(this.object.looseqty[currentrow] * this.object.saleprice[currentrow], "#####0.00")))) + trim(string(this.object.looseqty[currentrow] * this.object.saleprice[currentrow], "#####0.00"))
				ls_temp = ls_holdstr + ls_total
				ls_temp = ls_temp + "TOTAL     =" + space(9 - len(string(parent.parent.parent.wf_grandtotal(), "#####0.00"))) + string(parent.parent.parent.wf_grandtotal(), "#####0.00")
				ls_temp = left(ls_temp, 40)
				if len(ls_temp) <= 40 then
					if 40 - len(ls_temp) > 0 then
						ls_temp = ls_temp + space(40 - len(ls_temp))
					else
						ls_temp = left(ls_temp, 40)
					end if
				else
					ls_temp = left(ls_temp, 40)
				end if
				parent.parent.parent.is_lcditem = ls_temp
				if isnull(parent.parent.parent.is_lcditem) then
					parent.parent.parent.is_lcditem = ""
				end if
				parent.parent.parent.ic_comport.postevent("ue_show")
			else
				ls_holdstr = this.object.itemname[currentrow]
				if len(ls_holdstr) < 19 then
					ls_temp = ls_holdstr + space(19 - len(ls_holdstr))
				else
					ls_temp = left(ls_holdstr, 19)
				end if
				ls_temp = ls_temp + " Qty=" + string(this.object.looseqty[currentrow], f_setcolumnformat("Qty"))
				ls_temp = ls_temp + " Rs=" + string(this.object.saleprice[currentrow], "#######0.00")
				ls_temp = left(ls_temp, 39)
				if len(ls_temp) <= 39 then
					if 39 - len(ls_temp) > 0 then
						ls_temp = ls_temp + space(39 - len(ls_temp))
					else
						ls_temp = left(ls_temp, 39)
					end if
				else
					ls_temp = left(ls_temp, 39)
				end if
				parent.parent.parent.is_lcditem = ls_temp
				parent.parent.parent.ic_comport.postevent("ue_show")
			end if
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	integer li_rowno
	integer i
	integer li_columnno = 1
	integer li_quicksearch_col
	boolean lb_duplicate
	if parent.parent.parent.ii_saletype = 2 then
		if f_numberpreferences("CreditsaleDetailWindowFormat") = 1 then
			li_columnno = integer(this.object.datawindow.column.count)
		else
			li_columnno = integer(this.object.discperc.id)
		end if
	end if
	if parent.parent.parent.ii_saletype = 3 then
		if f_numberpreferences("CashsaleDetailWindowFormat") = 1 then
			li_columnno = integer(this.object.datawindow.column.count)
		else
			li_columnno = integer(this.object.discperc.id)
		end if
	end if
	if getrow() = rowcount() then
		for i = 1 to parent.parent.parent.id_detail.rowcount() - 1
			if parent.parent.parent.id_detail.getitemstring(i, "fullcode") = parent.parent.parent.is_aliasname then
				lb_duplicate = true
			end if
		next
		if getcolumn() = 1 and not lb_duplicate and gs_company = "KSS" then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
		if getcolumn() = li_columnno then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
	elseif li_columnno = integer(this.object.datawindow.column.count) and getcolumn() = li_columnno then
		scrollnextrow()
		if f_stringpreferences("ItemCode") = "Y" then
			setcolumn(1)
		else
			setcolumn(2)
		end if
		setfocus()
		return 1
	end if
	li_rowno = gd_itemsinfo.find("fullcode='" + parent.parent.parent.is_aliasname + "'", 1, gd_itemsinfo.rowcount())
	if getcolumn() = 1 and li_rowno > 0 then
		if parent.parent.parent.il_godowncount = 1 then
			if long(this.object.packqtyforsale.visible) > 0 then
				setcolumn("packqtyforsale")
			else
				parent.parent.parent.id_detail.setcolumn(integer(this.object.datawindow.column.count))
			end if
		else
			parent.parent.parent.id_detail.setcolumn("gcode")
		end if
		setfocus()
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ll_currrow
	long ll_startrow
	long ll_endrow
	long ll_icode
	long ll_row
	string ls_itemname
	string ls_aliasname
	string ls_null
	if parent.parent.parent.editflag = false then
		parent.parent.parent.editflag = true
		parent.parent.parent.im_menu.m_file.m_save.enabled = true
	end if
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.is_name_value = data
		if parent.parent.parent.ic_autosearchonalternatealias = "Y" then
			parent.parent.parent.wf_responsivesearch_withalternatealias()
		end if
		if upper(left(data, 1)) >= "A" and upper(left(data, 1)) <= "Z" or left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
			ll_currrow = parent.parent.parent.id_itemslist.getrow()
			if len(data) > 1 then
				ll_startrow = ll_currrow
			else
				if left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
					ll_startrow = 1
				else
					ll_startrow = ga_llookuptable[asc(upper(data))]
				end if
				parent.parent.parent.ib_bkspace = false
			end if
			if parent.parent.parent.ib_bkspace then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.find("Lower(itemname) <= '" + lower(data) + "'", ll_startrow, 0)
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.il_itemlistfoundrow + 1
				parent.parent.parent.ib_bkspace = false
			else
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.find("Lower(itemname) >= '" + lower(data) + "'", ll_startrow, parent.parent.parent.id_itemslist.rowcount())
			end if
			if parent.parent.parent.il_itemlistfoundrow = 0 then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.rowcount()
			end if
			if parent.parent.parent.il_itemlistfoundrow <> ll_currrow then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.setrow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_itemslist.scrolltorow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_itemslist.selectrow(parent.parent.parent.il_itemlistfoundrow, true)
				ll_endrow = setitem(row, "currlistrow", parent.parent.parent.il_itemlistfoundrow)
				ll_endrow = getitemnumber(row, "currlistrow")
				setfocus()
			end if
		end if
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	end choose
	if getcolumn() = 1 then
		parent.parent.parent.is_aliasname = data
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_focusqty() returns 0 [event]
	call super::ue_focusqty

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	integer li_res
	integer li_errcode
	long ll_currrow
	long ll_listcurrrow
	long ll_counter
	long ll_found
	long ll_itemcodetype
	long ll_rowm
	long ll_icode
	long ll_row
	long ll_null
	string ls_itemname
	string ls_aliasname
	string ls_null
	double ld_saleprice
	s_amountoninvoice ls_amountoninvoice
	s_ratevaluediscount ls_ratevaluediscount
	s_positem ls_itemdetail
	s_arguements lstr_arg
	s_datastore lstr_ds
	s_popup_selection lstr_selection
	setnull(ls_null)
	setnull(ll_null)
	ll_rowm = getrow()
	if keyflags = 2 and key = keyf5! then
		parent.parent.parent.wf_show_itemgallery()
		rt_code = 1
		return rt_code
	end if
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		if key = keydownarrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(parent.parent.parent.id_itemslist.rowcount())
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(1)
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf7! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			lstr_ds.s_name1 = gd_popup_itemsinfo.dataobject
			lstr_ds.s_name2 = "name"
			openwithparm(w_popup_responsivesearch_selection, lstr_ds)
			lstr_selection = message.powerobjectparm
			if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(lstr_selection.l_code2), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 and ll_found <= parent.parent.parent.id_itemslist.rowcount() then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf8! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("namesearch", parent.parent.parent.ii_module)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf9! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("criteriasearch", parent.parent.parent.ii_module)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf6! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			parent.parent.parent.wf_show_associated_master()
			setfocus()
		elseif key = keyf5! then
			if not isnull(getitemnumber(ll_rowm, "icode")) then
				ll_icode = getitemnumber(ll_rowm, "icode")
				parent.parent.parent.ib_itemslistopen = false
				parent.parent.parent.id_itemslist.hide()
				setredraw(true)
				ll_icode = f_prefered_itemsearch(ll_icode)
				if ll_icode > 0 then
					ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
					if ll_found > 0 then
						ll_listcurrrow = ll_found
						parent.parent.parent.id_itemslist.selectrow(0, false)
						rt_code = 1
					end if
				end if
			end if
			setfocus()
		elseif key = keyf4! then
			parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
			setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
			setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	elseif key = keydownarrow! then
		accepttext()
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_focusfooter")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		accepttext()
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	end if
	if (getcolumnname() = "fullcode" or getcolumnname() = "itemname") and key = keyf6! then
		parent.parent.parent.wf_responsivesearch_withalternatealias()
	end if
	if getcolumnname() = "fullcode" and key = keyf7! then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
		setredraw(true)
		lstr_ds.s_name1 = gd_popup_itemsinfo.dataobject
		lstr_ds.s_name2 = "aliasname"
		openwithparm(w_popup_responsivesearch_selection, lstr_ds)
		lstr_selection = message.powerobjectparm
		if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
			ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(lstr_selection.l_code2), 1, parent.parent.parent.id_itemslist.rowcount())
			if ll_found > 0 and ll_found <= parent.parent.parent.id_itemslist.rowcount() then
				ll_listcurrrow = ll_found
				parent.parent.parent.id_itemslist.selectrow(0, false)
