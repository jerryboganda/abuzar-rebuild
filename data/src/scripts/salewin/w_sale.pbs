		setfocus()
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
			setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
			setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	end if
	if getcolumnname() = "fullcode" and key = keyf9! then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
		setredraw(true)
		lstr_ds.s_name2 = "batch"
		openwithparm(w_responsivesearch_batch, lstr_ds)
		lstr_selection = message.powerobjectparm
		if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
			ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(lstr_selection.l_code2), 1, parent.parent.parent.id_itemslist.rowcount())
			if ll_found > 0 and ll_found <= parent.parent.parent.id_itemslist.rowcount() then
				ll_listcurrrow = ll_found
				parent.parent.parent.id_itemslist.selectrow(0, false)
				rt_code = 1
			end if
		end if
		setfocus()
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			ll_rowm = getrow()
			if ll_rowm > 0 then
				setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
				setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				this.object.gcode[ll_rowm] = lstr_selection.l_code3
				selecttext(1, len(gettext()))
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = ll_rowm
				if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 and lstr_selection.l_code3 > 0 and len(lstr_selection.s_name) > 0 then
					SQL update GodownDetail SET Priority =:lstr_selection.l_code2 WHERE Icode =:lstr_selection.l_code3 AND Gcode =:lstr_selection.s_name AND Batch =:lstr_selection.dt_date AND Expiry ={ts '2024-11-08 21:12:19.926'} USING sqlca;   /* bind positions inferred */
					if sqlca.sqlcode = 0 then
						SQL commit USING sqlca;
					else
						SQL rollback USING sqlca;
					end if
				end if
			end if
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	end if
	if getcolumnname() = "saleitemdescription" and key = keyf6! then
		parent.parent.parent.wf_setsaleitemdesc()
		rt_code = 1
	end if
	if getcolumnname() = "gcode" and key = keyf7! then
		parent.parent.parent.wf_searchgodown()
		rt_code = 1
	end if
	if getcolumnname() = "looseqty" and key = keyf4! then
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 545 then
				ls_itemdetail.l_icode = getitemnumber(getrow(), "icode")
				ls_itemdetail.i_module = 1
				if isnull(ls_itemdetail.l_icode) then
					messagebox("Item Validation", "Please select some item in the current row, than try again.")
				else
					openwithparm(w_arg_batch_selection, ls_itemdetail)
					lstr_arg = message.powerobjectparm
					if lstr_arg.i_status = 1 then
						SQL update GodownDetail SET Priority =:lstr_arg.l_code1 WHERE Icode =:lstr_arg.l_code2 AND Gcode =:lstr_arg.s_name1 AND Batch =:lstr_arg.d_sdate AND Expiry ={ts '2024-11-08 21:12:19.941'} USING sqlca;   /* bind positions inferred */
						if sqlca.sqlcode = 0 then
							SQL commit USING sqlca;
						else
							SQL rollback USING sqlca;
						end if
					end if
				end if
				exit
			end if
		next
		rt_code = 1
	elseif getcolumnname() = "looseqty" and key = keyf5! then
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 545 then
				ls_itemdetail.l_icode = getitemnumber(getrow(), "icode")
				ls_itemdetail.i_module = 1
				if isnull(ls_itemdetail.l_icode) then
					messagebox("Item Validation", "Please select some item in the current row, than try again.")
				else
					openwithparm(w_popup_itempriority_settings, ls_itemdetail)
				end if
				exit
			end if
		next
		rt_code = 1
	elseif getcolumnname() = "looseqty" and key = keyf6! then
		if f_rightexists(5259) then
			parent.parent.parent.wf_show_godownwisestock()
		end if
		rt_code = 1
	elseif getcolumnname() = "looseqty" and key = keyf7! then
		if f_rightexists(5260) and not isnull(this.object.icode[parent.parent.parent.id_detail.getrow()]) then
			ls_amountoninvoice.l_invcode = this.object.icode[parent.parent.parent.id_detail.getrow()]
			ls_amountoninvoice.d_balance = this.object.saleprice[parent.parent.parent.id_detail.getrow()]
			ls_amountoninvoice.d_netamt = this.object.saleprice[parent.parent.parent.id_detail.getrow()]
			ls_amountoninvoice.d_value = this.object.looseqty[parent.parent.parent.id_detail.getrow()]
			ls_amountoninvoice.s_module = "sales"
			openwithparm(w_unitqtycalculator, ls_amountoninvoice)
			ls_amountoninvoice = message.powerobjectparm
			if ls_amountoninvoice.i_status = 1 then
				this.object.looseqty[parent.parent.parent.id_detail.getrow()] = ls_amountoninvoice.d_value
			end if
			rt_code = 1
		end if
	elseif getcolumnname() = "looseqty" and key = keyf8! then
		if f_rightexists(5261) then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = getitemnumber(getrow(), "icode")
			ld_saleprice = f_drilldown_batchsearch("batchsearch", ll_icode)
			setitem(getrow(), "saleprice", ld_saleprice)
			rt_code = 1
			setfocus()
		end if
	elseif getcolumnname() = "looseqty" and key = keyf9! and f_rightexists(5262) and not isnull(this.object.icode[parent.parent.parent.id_detail.getrow()]) then
		ls_ratevaluediscount.l_invcode = this.object.icode[parent.parent.parent.id_detail.getrow()]
		ls_ratevaluediscount.d_balance = this.object.looseqty[parent.parent.parent.id_detail.getrow()]
		ls_ratevaluediscount.d_netamt = this.object.saleprice[parent.parent.parent.id_detail.getrow()]
		ls_ratevaluediscount.d_value = this.object.looseqty[parent.parent.parent.id_detail.getrow()] * this.object.saleprice[parent.parent.parent.id_detail.getrow()]
		ls_ratevaluediscount.s_module = "sales"
		openwithparm(w_qty_rate_value_calculator, ls_ratevaluediscount)
		ls_ratevaluediscount = message.powerobjectparm
		if ls_ratevaluediscount.i_status = 1 then
			this.object.looseqty[parent.parent.parent.id_detail.getrow()] = ls_ratevaluediscount.d_balance
			this.object.saleprice[parent.parent.parent.id_detail.getrow()] = ls_ratevaluediscount.d_netamt
		end if
		rt_code = 1
	end if
	if (getcolumnname() = "discperc" or getcolumnname() = "itemflatdisc") and key = keyf5! then
		if getcolumnname() = "discperc" and getitemstring(parent.parent.parent.id_detail.getrow(), "lockdiscperc") = "Y" then
			messagebox("Disc(%) Validation", "Disc(%) is locked, you can not change it")
			rt_code = 1
			return rt_code
		end if
		if not isnull(this.object.icode[parent.parent.parent.id_detail.getrow()]) then
			ls_amountoninvoice.l_invcode = this.object.icode[parent.parent.parent.id_detail.getrow()]
			ls_amountoninvoice.d_balance = this.object.saleprice[parent.parent.parent.id_detail.getrow()]
			ls_amountoninvoice.s_module = "sales"
			if getcolumnname() = "discperc" then
				ls_amountoninvoice.c_paymentmode = "D"
				ls_amountoninvoice.d_netamt = round(this.object.saleprice[parent.parent.parent.id_detail.getrow()] * (1 - this.object.discperc[parent.parent.parent.id_detail.getrow()] * 0.01), 2)
			elseif getcolumnname() = "itemflatdisc" then
				ls_amountoninvoice.c_paymentmode = "F"
				if this.object.itemflatdisc[parent.parent.parent.id_detail.getrow()] < this.object.saleprice[parent.parent.parent.id_detail.getrow()] then
					ls_amountoninvoice.d_netamt = this.object.saleprice[parent.parent.parent.id_detail.getrow()] - this.object.itemflatdisc[parent.parent.parent.id_detail.getrow()]
				else
					ls_amountoninvoice.d_netamt = this.object.saleprice[parent.parent.parent.id_detail.getrow()]
				end if
			else
				ls_amountoninvoice.c_paymentmode = "N"
			end if
			if ls_amountoninvoice.c_paymentmode <> "N" then
				openwithparm(w_discountcalculator, ls_amountoninvoice)
				ls_amountoninvoice = message.powerobjectparm
				if ls_amountoninvoice.i_status = 1 then
					if ls_amountoninvoice.c_paymentmode = "F" then
						this.object.itemflatdisc[parent.parent.parent.id_detail.getrow()] = ls_amountoninvoice.d_amt
						this.object.discperc[parent.parent.parent.id_detail.getrow()] = 0.00
					else
						this.object.discperc[parent.parent.parent.id_detail.getrow()] = ls_amountoninvoice.d_amt
						this.object.itemflatdisc[parent.parent.parent.id_detail.getrow()] = 0.00
					end if
					rt_code = 1
				end if
			end if
		end if
	end if
	if getcolumnname() = "itemflatdisc" and key = keyf6! and not isnull(this.object.icode[parent.parent.parent.id_detail.getrow()]) then
		ls_amountoninvoice.l_invcode = this.object.icode[parent.parent.parent.id_detail.getrow()]
		ls_amountoninvoice.d_balance = this.object.retailprice[parent.parent.parent.id_detail.getrow()]
		ls_amountoninvoice.s_module = "sales"
		ls_amountoninvoice.c_paymentmode = "F"
		ls_amountoninvoice.d_netamt = this.object.retailprice[parent.parent.parent.id_detail.getrow()]
		ls_amountoninvoice.d_amt = this.object.itemflatdisc[parent.parent.parent.id_detail.getrow()]
		openwithparm(w_discountonretailcalculator, ls_amountoninvoice)
		ls_amountoninvoice = message.powerobjectparm
		if ls_amountoninvoice.i_status = 1 then
			this.object.itemflatdisc[parent.parent.parent.id_detail.getrow()] = ls_amountoninvoice.d_amt
			if this.object.saleprice[parent.parent.parent.id_detail.getrow()] > 0 then
				this.object.prediscperc[parent.parent.parent.id_detail.getrow()] = round(this.object.itemflatdisc[parent.parent.parent.id_detail.getrow()] / this.object.saleprice[parent.parent.parent.id_detail.getrow()] * 100, 2)
			else
				this.object.prediscperc[parent.parent.parent.id_detail.getrow()] = round(this.object.itemflatdisc[parent.parent.parent.id_detail.getrow()], 2)
			end if
			rt_code = 1
		end if
	end if
	if getcolumnname() = "saleprice" and key = keyf5! and not isnull(this.object.icode[parent.parent.parent.id_detail.getrow()]) then
		ls_amountoninvoice.l_invcode = this.object.icode[parent.parent.parent.id_detail.getrow()]
		ls_amountoninvoice.d_balance = this.object.saleprice[parent.parent.parent.id_detail.getrow()]
		ls_amountoninvoice.d_netamt = this.object.saleprice[parent.parent.parent.id_detail.getrow()]
		ls_amountoninvoice.d_amt = this.object.gstperc[parent.parent.parent.id_detail.getrow()]
		ls_amountoninvoice.s_module = "sales"
		openwithparm(w_pricecalculator, ls_amountoninvoice)
		ls_amountoninvoice = message.powerobjectparm
		if ls_amountoninvoice.i_status = 1 then
			this.object.saleprice[parent.parent.parent.id_detail.getrow()] = ls_amountoninvoice.d_netamt
			this.object.gstperc[parent.parent.parent.id_detail.getrow()] = ls_amountoninvoice.d_amt
		end if
		rt_code = 1
	end if
	return rt_code

// tabpage_list.create() returns 0 [event]
	integer icurrent
	this.st_3 = create st_3
	this.em_invno = create em_invno
	call super::create
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_3
	this.control[icurrent + 2] = this.em_invno

// tabpage_list.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_3
	destroy this.em_invno

// dw_find.keypressed(keycode key, unsignedlong keyflags) returns long [event]
	integer li_movement
	long ll_row
	long ll_temp
	string sl_columnname
	string ls_rightid
	s_popup_selection lstr_selection
	s_datastore lstr_ds
	if keyflags = 2 and key = keyf8! then
		ll_row = parent.parent.parent.id_list.getrow()
		if ll_row > 0 then
			parent.parent.parent.wf_unfiscalize()
			setfocus()
		end if
	end if
	if key = keyuparrow! then
		ll_row = parent.parent.parent.id_list.getrow() - 1
		parent.parent.parent.id_list.scrollpriorrow()
	elseif key = keydownarrow! then
		ll_row = parent.parent.parent.id_list.getrow() + 1
		parent.parent.parent.id_list.scrollnextrow()
	elseif key = keypagedown! then
		parent.parent.parent.id_list.scrollnextpage()
		ll_row = parent.parent.parent.id_dwcontrol.getrow()
	elseif key = keypageup! then
		parent.parent.parent.id_list.scrollpriorpage()
		ll_row = parent.parent.parent.id_dwcontrol.getrow()
	elseif key = keyhome! then
		scrolltorow(1)
		ll_row = 1
	elseif key = keyend! then
		ll_row = parent.parent.parent.id_list.rowcount()
		scrolltorow(ll_row)
	elseif key = keyenter! then
		if parent.parent.parent.id_dwcontrol.getselectedrow(0) > 0 then
			parent.parent.parent.i_editmode = 2
			parent.parent.parent.tab_retrieve.selectedtab = 1
			return ::message.returnvalue
		end if
	elseif key = keyf5! then
		ll_row = parent.parent.parent.wf_retrievelist_datelimit()
		if ll_row > 0 then
			scrolltorow(1)
			ll_row = 1
		end if
	elseif key = keyf6! then
		lstr_ds.dw = parent.parent.parent.id_list
		lstr_ds.s_name1 = parent.parent.parent.id_list.dataobject
		lstr_ds.s_name2 = "customer"
		openwithparm(w_popup_comprehensicesearch_selection2, lstr_ds)
		lstr_selection = ::message.powerobjectparm
		if lstr_selection.l_code > 0 then
			if lstr_selection.l_code2 > 0 then
				ll_temp = parent.parent.parent.id_list.find("code = " + string(lstr_selection.l_code2), 1, parent.parent.parent.id_list.rowcount())
				if ll_temp > 0 then
					ll_row = ll_temp
					parent.parent.parent.id_list.scrolltorow(ll_row)
				end if
			end if
		else
			ll_row = 0
		end if
	elseif key = keyf7! then
		ll_row = parent.parent.parent.wf_print_invrange_storesummary()
	elseif key = keyf9! then
		ll_row = parent.parent.parent.id_dwcontrol.getrow()
		if ll_row > 0 then
			parent.parent.parent.wf_editpostedinvoice()
			setfocus()
		end if
	end if
	if ll_row > 0 and ll_row <= parent.parent.parent.id_dwcontrol.rowcount() then
		parent.parent.parent.id_list.setredraw(false)
		parent.parent.parent.tab_retrieve.tabpage_detail.enabled = true
		parent.parent.parent.im_menu.m_file.m_retrieve.enabled = true
		parent.parent.parent.id_list.selectrow(0, false)
		parent.parent.parent.id_list.selectrow(ll_row, true)
		if parent.parent.parent.ii_type = 1 then
			setitem(1, "find", parent.parent.parent.id_list.getitemstring(ll_row, parent.parent.parent.ii_colindex))
		elseif parent.parent.parent.ii_type = 3 then
			setitem(1, "find", trim(string(parent.parent.parent.id_list.getitemdatetime(ll_row, parent.parent.parent.ii_colindex))))
		else
			setitem(1, "find", trim(string(parent.parent.parent.id_list.getitemnumber(ll_row, parent.parent.parent.ii_colindex))))
		end if
		parent.parent.parent.il_selectedrow = ll_row
		selecttext(1, len(gettext()))
		parent.parent.parent.id_list.setredraw(true)
	end if
	return ::message.returnvalue

// em_invno.ue_downkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		parent.parent.parent.tab_retrieve.selecttab(1)
	end if
	return ::message.returnvalue

// ole_lcddisplay.constructor() returns long [event]
	integer li_defaultcomport
	integer li_status
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	try
		if f_stringpreferences("DisplayPool") = "Y" and upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
			li_defaultcomport = f_numberpreferences("DefaultComPort")
			if isnull(li_defaultcomport) then
				li_defaultcomport = 1
			end if
			this.object.commport = li_defaultcomport
			this.object.settings = "9600,N,8,1"
			this.object.__invoke_method("startdisplay", 0, {}, true)
			this.object.welcomemsgl1 = "WELCOME TO"
			this.object.welcomemsgl2 = left(f_reportheaderinfo("clientname"), 19)
			this.object.welcomewait = 3
			this.object.greetingmsgl1 = "THANK YOU FOR"
			this.object.greetingmsgl2 = "SHOPPING WITH US"
			this.object.greetingwait = 3
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try
	return ::message.returnvalue

// ic_comport.ue_show() returns long [event]
	string ls_line
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	try
		if isnull(parent.is_lcditem) then
			if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
				parent.is_lcditem = char(26) + char(1)
				parent.ic_comport.triggerevent("ue_show")
				parent.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
				parent.ic_comport.triggerevent("ue_show")
				return 1
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
				parent.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				return 1
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
				return 1
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "TYSSO VFD-860-A" then
				parent.is_lcditem = space(5) + "THANK YOU" + space(6) + space(3) + "FOR YOUR VISIT" + space(3)
			else
				parent.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
			end if
		end if
		if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
			parent.wf_pd_initialize()
			pd_writepd(ls_line, len(ls_line))
			if not isnull(parent.is_lcditem) then
				pd_writepd(parent.is_lcditem, len(parent.is_lcditem))
			end if
			ls_line = char(27) + char(72) + char(20)
			pd_writepd(ls_line, len(ls_line))
			if not isnull(parent.is_lcditem2) then
				pd_writepd(parent.is_lcditem2, len(parent.is_lcditem2))
			end if
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
			return 1
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "TYSSO VFD-860-A" then
			this.object.portopen = true
			if isnull(parent.is_lcditem) then
				parent.is_lcditem = space(5) + "THANK YOU" + space(6) + space(3) + "FOR YOUR VISIT" + space(3)
			end if
			this.object.output = parent.is_lcditem
			this.object.portopen = false
		else
			this.object.portopen = true
			if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
				this.object.output = char(26) + parent.is_lcditem
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
				this.object.output = char(12) + parent.is_lcditem
			else
				this.object.output = char(12) + parent.is_lcditem
			end if
			this.object.portopen = false
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try
	return 1

// ic_comport.constructor() returns long [event]
	integer li_defaultcomport
	integer li_status
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	try
		if f_stringpreferences("DisplayPool") = "Y" then
			if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				pd_openusbpd()
				li_status = pd_pdstate()
				if li_status = 0 then
					parent.wf_pd_initialize()
				end if
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "TYSSO VFD-860-A" then
				li_defaultcomport = f_numberpreferences("DefaultComPort")
				if isnull(li_defaultcomport) then
					li_defaultcomport = 1
				end if
				this.object.commport = li_defaultcomport
				this.object.settings = "9600,N,8,1"
				this.object.inputlen = 0
			elseif upper(f_stringpreferences("DisplayPoolCompany")) <> "BAYLAN VFD-860-A" then
				li_defaultcomport = f_numberpreferences("DefaultComPort")
				if isnull(li_defaultcomport) then
					li_defaultcomport = 1
				end if
				this.object.commport = li_defaultcomport
				this.object.settings = "9600,N,8,1"
				this.object.inputlen = 0
			end if
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try
	return ::message.returnvalue

