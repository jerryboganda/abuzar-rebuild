// window w_salebalanceqty_slip (salewin)  ancestor: window

// w_salebalanceqty_slip.create() returns 0
	this.cb_print = create cb_print
	this.dw_control = create dw_control
	this.control = {this.cb_print, this.dw_control}

// w_salebalanceqty_slip.destroy() returns 0
	destroy this.cb_print
	destroy this.dw_control

// w_salebalanceqty_slip.open() returns long
	long ll_width
	long ll_height
	long ll_invcode
	long ll_win_width
	long ll_win_height
	environment env
	ll_invcode = message.doubleparm
	if getenvironment(env) <> 1 then
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	setredraw(false)
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
	this.width = ll_width * 0.98
	this.height = ll_height * 0.98
	this.dw_control.width = ll_width * 0.95
	this.dw_control.height = ll_height * 0.80
	this.cb_print.x = ll_width * 0.50
	this.cb_print.y = ll_height * 0.85
	ll_width = ll_win_width - this.width
	ll_height = ll_win_height - this.height
	if ll_width > 0 and ll_height > 0 then
		this.x = ll_width / 2.0
		this.y = ll_height / 2.0
	end if
	this.dw_control.settransobject(sqlca)
	this.dw_control.retrieve(ll_invcode)
	this.dw_control.modify("DataWindow.Print.Preview=yes")
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_salebalanceqty_slip.close() returns long
	close(this)
	return ::message.returnvalue

// w_salebalanceqty_slip.key(keycode key, unsignedlong keyflags) returns long
	if keydown(keyescape!) then
		close(this)
	end if
	return ::message.returnvalue

// cb_print.clicked() returns long
	if parent.dw_control.rowcount() > 0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			parent.dw_control.printcancel()
		end if
		if parent.dw_control.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
	else
		messagebox("Printing Error", "Can not Print,~r~nNo rows are retrieved", information!)
	end if
	return ::message.returnvalue
