// window w_sale_popup (salewin)  ancestor: w_sale

// w_sale_popup.ue_fetch_buffer_value() returns 0 [event]
	if this.iw_callingwindow.istr_buffer.i_status = 1 then
		this.istr_buffer = this.iw_callingwindow.istr_buffer
		this.is_callermodule = lower(this.iw_callingwindow.classname())
	end if

// w_sale_popup.ue_set_buffer_value() returns 0 [event]
	long ll_listrow
	if this.iw_callingwindow.istr_buffer.i_status = 1 then
		if not isnull(this.iw_callingwindow.istr_buffer.l_code1) then
			ll_listrow = this.id_list.insertrow(0)
			this.il_selectedrow = ll_listrow
			this.id_list.object.code[ll_listrow] = this.iw_callingwindow.istr_buffer.l_code1
			this.id_master.retrieve(this.iw_callingwindow.istr_buffer.l_code1)
			postevent("ue_detail")
			return
		end if
		if (not isnull(this.iw_callingwindow.istr_buffer.l_code3) or not isnull(this.iw_callingwindow.istr_buffer.l_code4)) and this.id_master.rowcount() > 0 then
			this.id_master.object.custcode[this.id_master.rowcount()] = this.iw_callingwindow.istr_buffer.l_code3
			this.id_master.object.patientcode[this.id_master.rowcount()] = this.iw_callingwindow.istr_buffer.l_code4
			this.id_master.setfocus()
			this.id_master.setcolumn("custcode")
			this.id_master.accepttext()
			this.id_master.object.custcode.protect = 1
			this.id_master.object.aliasname.protect = 1
			this.id_master.object.patientcode.protect = 1
			this.id_master.object.patientregno.protect = 1
			wf_customerinfo(this.id_master.object.custcode[this.id_master.rowcount()])
			return
		end if
		return
	end if

// w_sale_popup.create() returns 0 [event]
	integer icurrent
	call super::create
	this.cb_save = create cb_save
	this.cb_cancel = create cb_cancel
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cb_save
	this.control[icurrent + 2] = this.cb_cancel

// w_sale_popup.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.cb_save
	destroy this.cb_cancel

// w_sale_popup.open() returns long [event]
	m_entry lm_menu
	long ll_width
	long ll_height
	environment env
	postevent("ue_fetch_buffer_value")
	postevent("ue_postopen")
	this.iw_callingwindow = message.powerobjectparm
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	lm_menu.dynamic mf_initsecurityapp(lm_menu)
	if getenvironment(env) <> 1 then
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.tab_retrieve.width = ll_width * 0.99
	this.tab_retrieve.height = ll_height * 0.83
	this.tab_retrieve.tabpage_detail.dw_detail.width = ll_width * 0.98
	this.tab_retrieve.tabpage_detail.dw_itemsdetail.width = ll_width * 0.98
	this.tab_retrieve.tabpage_detail.dw_footer.y = this.tab_retrieve.height * 0.90 - this.tab_retrieve.tabpage_detail.dw_footer.height
	this.tab_retrieve.tabpage_detail.dw_detail.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width
	this.tab_retrieve.tabpage_detail.dw_footer.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width
	this.tab_retrieve.tabpage_detail.dw_itemsdetail.height = this.tab_retrieve.tabpage_detail.dw_footer.y - this.tab_retrieve.tabpage_detail.dw_itemsdetail.y
	this.tab_retrieve.tabpage_list.gb_fliter.width = ll_width * 0.97 - this.tab_retrieve.tabpage_list.gb_sort.width
	this.tab_retrieve.tabpage_list.r_1.width = ll_width * 0.99
	this.tab_retrieve.tabpage_list.r_1.height = ll_height * 0.765 - this.tab_retrieve.tabpage_list.gb_sort.height
	this.tab_retrieve.tabpage_list.dw_list.width = ll_width * 0.98
	this.tab_retrieve.tabpage_list.dw_list.height = ll_height * 0.75 - this.tab_retrieve.tabpage_list.dw_list.y
	this.tab_retrieve.tabpage_detail.dw_itemslist.height = ll_height * 0.6
	this.tab_retrieve.tabpage_detail.dw_itemslist.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width * 0.73
	this.cb_save.y = ll_height * 0.85
	this.cb_cancel.y = ll_height * 0.85
	this.cb_save.x = ll_width * 0.32
	this.cb_cancel.x = ll_width * 0.52
	setredraw(true)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_sale_popup.ue_list() returns 0 [event]

// w_sale_popup.ue_new() returns 0 [event]
	integer li_postingmode = 2
	if this.ib_commitok = true and this.il_codevalue > 0 then
		if this.is_callermodule = "w_service" and this.iw_callingwindow.istr_buffer.s_name1 = "Y" then
		end if
		this.iw_callingwindow.post event ue_callback_popupwindow(this.il_codevalue)
		close(this)
		return
	end if
	this.im_menu.m_file.m_post.enabled = false
	wf_assign_master_cash_win_object()
	this.i_editmode = 1
	this.ib_commitok = false
	this.tab_retrieve.selectedtab = 1
	this.id_master.setfocus()

// w_sale_popup.ue_postopen() returns 0 [event]
	call super::ue_postopen
	postevent("ue_set_buffer_value")

// cb_save.clicked() returns long [event]
	if parent.tab_retrieve.selectedtab = 1 then
		if parent.is_callermodule = "w_service" then
			if parent.iw_callingwindow.istr_buffer.s_name1 = "Y" then
				parent.wf_saveandpost()
			else
				parent.event ue_save()
			end if
		else
			parent.event ue_save()
		end if
		if parent.ib_commitok = true then
			parent.iw_callingwindow.post event ue_callback_popupwindow(parent.il_codevalue)
			close(parent)
		end if
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	close(parent)
	return ::message.returnvalue
