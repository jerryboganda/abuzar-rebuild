// w_saleinvgroup.ue_postopen() returns 0 [event]
	m_saleinvgroup lm_menu
	call super::ue_postopen
	lm_menu = this.menuid
	this.id_print = this.dw_print
	wf_assigndatawindowobjects("d_saleinvgroup_header", "d_saleinvgroup_detail", "d_saleinvgroup_list")

// w_saleinvgroup.ue_detail() returns 0 [event]
	long ll_code
	long ll_rowcount
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_delete.enabled = true
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.im_menu.m_file.m_print.enabled = true
	this.i_editmode = 2
	this.i_retrievemode = 2
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	this.id_dwcontrol = this.id_master
	ll_rowcount = wf_retrieve(ll_code)
	this.id_master.setrow(1)
	this.id_master.scrolltorow(1)
	this.id_dwcontrol = this.id_detail
	wf_retrieve(ll_code)
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	this.id_dwcontrol = this.id_list
	this.ib_modify = true

// w_saleinvgroup.ue_print() returns 0 [event]
	long ll_row
	long ll_invcode
	long ll_option
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			ll_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if ll_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
			else
				event ue_newitem()
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	this.id_print.dataobject = "d_saleinvgroup_printout"
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("saleaskforcopies") = "Y" then
		open(w_printer_copies)
		this.id_print.object.datawindow.print.copies = string(message.doubleparm)
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	long ll_null
	string ls_null
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case "saleinvcode"
		li_errcode = parent.parent.parent.wf_validateinvcode(row, long(data))
		return li_errcode
	end choose
	return li_errcode

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "saleinvcode"
		messagebox("Sale Invoice Validation", "You must select some Sale Invoice")
	end choose
	return 1

// dw_itemsdetail.getfocus() returns long [event]
	return ::message.returnvalue

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	return ::message.returnvalue

// tabpage_list.create() returns 0 [event]
	integer icurrent
	this.st_3 = create st_3
	this.em_invno = create em_invno
	call super::create
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_3
	this.control[icurrent + 2] = this.em_invno

// tabpage_list.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_3
	destroy this.em_invno

// dw_find.keypressed(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	long ll_row
	long ll_code
	long ll_update
	long ll_option
	string ls_errortext
	s_arguements lstr_arg
	s_arguements lstr_arg2
	ancestorreturnvalue = super::keypressed(key, keyflags)
	if key = keyf7! and parent.parent.parent.id_list.getrow() > 0 then
		ll_code = parent.parent.parent.id_list.object.code[parent.parent.parent.id_list.getrow()]
		if ll_code > 0 then
			openwithparm(w_arg_item_find_and_replace_salinvgroup, lstr_arg)
			lstr_arg = message.powerobjectparm
			if lstr_arg.i_status > 0 then
				if lstr_arg.l_code1 > 0 then
					lstr_arg.l_code3 = ll_code
					openwithparm(w_review_proformasale_item_replacement, lstr_arg)
					ll_update = message.doubleparm
					if ll_update = 1 then
						ll_option = messagebox("Data Risk Alert", "This action might change data in bulk.~r~nIt has un-reversible consequences.~r~n~r~nUpdate Anyway?", question!, yesno!, 2)
						if ll_option = 1 then
							SQL rollback USING parent.parent.parent.it_transobject;
							parent.parent.parent.it_transobject.findandreplaceiteminproformasales(lstr_arg.l_code3, lstr_arg.l_code1, lstr_arg.db_code1, lstr_arg.l_code2, lstr_arg.db_code2)
							if parent.parent.parent.it_transobject.sqlcode = 0 then
								SQL commit USING parent.parent.parent.it_transobject;
								messagebox("Update Sucessfull", "Updation Successfull", information!)
							else
								SQL rollback USING parent.parent.parent.it_transobject;
								ls_errortext = parent.parent.parent.it_transobject.sqlerrtext
								messagebox("Error", "Error occured in updating Proforma Sales Invocies.~r~nDetails are:-~r~n" + ls_errortext, stopsign!)
							end if
						end if
					end if
				end if
			else
				ll_row = 0
			end if
		end if
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue
