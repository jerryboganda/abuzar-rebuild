// window w_saleinvgroup (salewin)  ancestor: w_multi_entry

// w_saleinvgroup.wf_deleteallemptydetailrows() returns integer
	long ll_count
	long ll_deletecount
	long ll_code
	long ll_rowcount
	ll_deletecount = 0
	ll_rowcount = this.id_detail.rowcount()
	for ll_count = 1 to this.id_detail.rowcount()
		ll_code = this.id_detail.getitemnumber(ll_count, "saleinvcode")
		if isnull(ll_code) then
			ll_deletecount = ll_deletecount + 1
			this.id_detail.deleterow(ll_count)
		end if
	next
	for ll_count = 1 to this.id_detail.rowcount()
		ll_code = this.id_detail.getitemnumber(ll_count, "saleinvcode")
		if isnull(ll_code) then
			ll_deletecount = ll_deletecount + 1
			this.id_detail.deleterow(ll_count)
		end if
	next
	return ll_deletecount

// w_saleinvgroup.wf_deleteemptydetailrow() returns integer
	long ll_rowcount
	long ll_code
	integer li_rtcode
	ll_rowcount = this.id_detail.rowcount()
	ll_code = this.id_detail.getitemnumber(ll_rowcount, "saleinvcode")
	if ll_rowcount > 1 and isnull(ll_code) then
		this.id_detail.deleterow(ll_rowcount)
		li_rtcode = 1
		setfocus()
	end if
	return li_rtcode

// w_saleinvgroup.wf_lockinvoice(long al_invcode) returns integer
	integer li_count
	this.it_transobject.dbparm = " Async =1, DBGetTime = 20"
	this.it_transobject.locksaleinvoice(al_invcode)
	this.it_transobject.dbparm = "Async =0, DBGetTime = 0"
	return this.it_transobject.sqlcode

// w_saleinvgroup.wf_populateinvoices() returns long
	datastore lds_invselected
	long ll_detailrows
	long ll_count
	long ll_duplrows
	long ll_invcode
	long ll_row
	long il_populatemetod
	long ll_rowcount
	long ll_rtcode
	long ll_retrievecount
	long ll_lockedcount
	integer li_result
	boolean populateflag
	s_arguements lstr_selectedinvoices
	if wf_iseditable() = false then
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		if not isnull(this.id_detail.object.saleinvcode[1]) then
			li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
			if li_result = 1 then
				for ll_count = 1 to ll_detailrows
					this.id_detail.deleterow(0)
				next
			else
				populateflag = false
			end if
		else
			this.id_detail.reset()
		end if
	end if
	if populateflag = true then
		lds_invselected = create datastore
		open(w_selectformat_populateinvoices_criteria)
		il_populatemetod = message.doubleparm
		if il_populatemetod = 1 then
			open(w_arg_areas_sinv_linv_salecriteria)
			lstr_selectedinvoices = message.powerobjectparm
			lds_invselected.dataobject = "d_populate_saleinv_for_grouping_range"
			lds_invselected.settransobject(this.it_transobject)
			ll_rtcode = lds_invselected.retrieve(lstr_selectedinvoices.ia_integerlist, lstr_selectedinvoices.l_code1, lstr_selectedinvoices.l_code2, lstr_selectedinvoices.l_code3)
		elseif il_populatemetod = 2 then
			openwithparm(w_arg_customers_sinv_linv_salecriteria, lstr_selectedinvoices)
			lstr_selectedinvoices = message.powerobjectparm
			lds_invselected.dataobject = "d_populate_saleinvoices_for_grouping"
			lds_invselected.settransobject(this.it_transobject)
			ll_rtcode = lds_invselected.retrieve(lstr_selectedinvoices.la_longlist, lstr_selectedinvoices.l_code1, lstr_selectedinvoices.l_code2, lstr_selectedinvoices.l_code3)
		elseif il_populatemetod = 3 then
			open(w_arg_areas_sdate_ldate_salecriteria)
			lstr_selectedinvoices = message.powerobjectparm
			lds_invselected.dataobject = "d_populate_saleinv_for_grouping_period"
			lds_invselected.settransobject(this.it_transobject)
			ll_rtcode = lds_invselected.retrieve(lstr_selectedinvoices.ia_integerlist, lstr_selectedinvoices.d_sdate, lstr_selectedinvoices.d_edate, lstr_selectedinvoices.l_code3)
		elseif il_populatemetod = 4 then
			openwithparm(w_arg_customers_sdate_ldate_salecriteria, lstr_selectedinvoices)
			lstr_selectedinvoices = message.powerobjectparm
			lds_invselected.dataobject = "d_populate_saleinvoices_for_grouping2"
			lds_invselected.settransobject(this.it_transobject)
			ll_rtcode = lds_invselected.retrieve(lstr_selectedinvoices.ia_integerlist, lstr_selectedinvoices.d_sdate, lstr_selectedinvoices.d_edate, lstr_selectedinvoices.l_code3)
		end if
		this.id_detail.reset()
		ll_rowcount = lds_invselected.rowcount()
		for ll_count = 1 to ll_rowcount
			ll_invcode = lds_invselected.object.invcode[ll_count]
			ll_row = this.id_detail.insertrow(0)
			if wf_validateinvcode(ll_row, ll_invcode) = 0 then
				ll_retrievecount = ll_retrievecount + 1
			else
				this.id_detail.deleterow(ll_row)
			end if
		next
		destroy lds_invselected
		if ll_retrievecount = ll_rowcount then
			messagebox("Result", string(ll_rowcount) + " Invoices are populated. ")
		else
			messagebox("Result", "Total invoices were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " invoices populated successfully~n~r" + string(ll_duplrows) + " invoices are not populated successfully~n~r" + string(ll_lockedcount) + " records are in error")
		end if
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_saleinvgroup.wf_validateinvcode(long al_row, long al_invcode) returns integer
	integer li_rtcode
	long ll_invcode
	long ll_acccode
	double ld_netamt
	datetime ld_date
	string ls_aliasname
	string ls_name
	string ls_custrefno
	string ls_custrefno2
	string ls_custrefno3
	string ls_custrefno4
	string ls_custrefno5
	string ls_remarks
	string ls_posted
	string ls_accountfor
	string ls_impactinventory
	if vf_dwdupcode1(this.id_detail, "saleinvcode", string(al_invcode), al_row) = true then
		li_rtcode = 1
		messagebox("Invoice Validation", "Duplicate Invoice, please select some other invoice")
	else
		SQL SELECT SaleLedger.SaleInvCode , SaleLedger.InvTotal , SaleLedger.Date , SaleLedger.Posted , SaleLedger.AccountFor , SaleLedger.ImpactInventory , SaleLedger.CustCode , Accounts.AliasName , Accounts.Name , SaleLedger.CustRefNo , SaleLedger.CustRefNo2 , SaleLedger.CustRefNo3 , SaleLedger.CustRefNo4 , SaleLedger.CustRefNo5 , SaleLedger.Remarks INTO :ll_invcode, :ld_netamt, :ld_date, :ls_posted, :ls_accountfor, :ls_impactinventory, :ll_acccode, :ls_aliasname, :ls_name, :ls_custrefno, :ls_custrefno2, :ls_custrefno3, :ls_custrefno4, :ls_custrefno5, :ls_remarks FROM SaleLedger , Accounts WHERE SaleLedger.SaleInvCode =:al_invcode AND SaleLedger.CustCode =Accounts.AccCode USING sqlca;
		if sqlca.sqlcode = 0 then
			if ll_invcode > 0 then
				this.id_detail.object.saleinvcode[al_row] = ll_invcode
				this.id_detail.object.invtotal[al_row] = ld_netamt
				this.id_detail.object.date[al_row] = ld_date
				this.id_detail.object.posted[al_row] = ls_posted
				this.id_detail.object.accountfor[al_row] = ls_accountfor
				this.id_detail.object.impactinventory[al_row] = ls_impactinventory
				this.id_detail.object.custcode[al_row] = ll_acccode
				this.id_detail.object.aliasname[al_row] = ls_aliasname
				this.id_detail.object.customername[al_row] = ls_name
				this.id_detail.object.saleledger_custrefno[al_row] = ls_custrefno
				this.id_detail.object.saleledger_custrefno2[al_row] = ls_custrefno2
				this.id_detail.object.saleledger_custrefno3[al_row] = ls_custrefno3
				this.id_detail.object.saleledger_custrefno4[al_row] = ls_custrefno4
				this.id_detail.object.saleledger_custrefno5[al_row] = ls_custrefno5
				this.id_detail.object.saleledger_remarks[al_row] = ls_remarks
			else
				li_rtcode = 1
			end if
		else
			li_rtcode = 1
		end if
	end if
	return li_rtcode

// w_saleinvgroup.wf_assigndatawindowobjects(string as_headerdw, string as_detaildw, string as_listdw) returns 0
	this.id_master.dataobject = as_headerdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.dataobject = as_detaildw
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.dataobject = as_listdw
	this.id_list.settransobject(this.it_transobject)

// w_saleinvgroup.wf_update_saledetail() returns long
	string ls_custrefno
	string ls_custrefno2
	string ls_custrefno3
	string ls_custrefno4
	string ls_custrefno5
	string ls_remarks
	string ls_errtext
	long ll_detailrows
	long ll_counter
	long ll_saleinvcode
	long ll_err_row
	long ll_retcode
	ll_detailrows = this.id_detail.rowcount()
	for ll_counter = 1 to ll_detailrows
		ll_saleinvcode = this.id_detail.object.saleinvcode[ll_counter]
		ls_custrefno = this.id_detail.object.saleledger_custrefno[ll_counter]
		ls_custrefno2 = this.id_detail.object.saleledger_custrefno2[ll_counter]
		ls_custrefno3 = this.id_detail.object.saleledger_custrefno3[ll_counter]
		ls_custrefno4 = this.id_detail.object.saleledger_custrefno4[ll_counter]
		ls_custrefno5 = this.id_detail.object.saleledger_custrefno5[ll_counter]
		ls_remarks = this.id_detail.object.saleledger_remarks[ll_counter]
		SQL update DBO.SaleLedger SET remarks =:ls_remarks , custrefno =:ls_custrefno , custrefno2 =:ls_custrefno2 , custrefno3 =:ls_custrefno3 , custrefno4 =:ls_custrefno4 , custrefno5 =:ls_custrefno5 WHERE SaleInvCode =:ll_saleinvcode USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			ll_err_row = ll_counter
			ls_errtext = this.it_transobject.sqlerrtext
			exit
		end if
	next
	if ll_err_row > 0 then
		ll_retcode = -1
		messagebox("Updatation Problem", "Problem in updation of sale invoice details.~r~nReasons are:-~r~n" + ls_errtext)
	else
		ll_retcode = 0
	end if
	return ll_retcode

// w_saleinvgroup.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_saleinvgroup" then
		this.menuid = create m_saleinvgroup
	end if
	this.dw_print = create dw_print
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print

// w_saleinvgroup.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_print

// w_saleinvgroup.ue_save() returns 0 [event]
	long ll_detailrows
	long ll_mastercurrrow
	long ll_invid
	long ll_errrowid
	long ll_usercode
	long ll_counter
	long ll_null
	long ll_maxretcode
	long ll_updatedetail
	boolean lb_commitflag
	boolean lb_continue
	string ls_errtext
	string ls_askuserpwd
	string ls_mod
	string ls_err
	datetime ldt_server_datetime
	string ls_date_errtext
	s_salesman lstr_salesman
	setnull(ll_null)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		for ll_counter = 1 to ll_detailrows
			if isnull(this.id_detail.getitemnumber(ll_counter, "saleinvcode")) or this.id_detail.getitemnumber(ll_counter, "saleinvcode") = 0.0 then
				this.id_detail.deleterow(ll_counter)
			end if
		next
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	wf_deleteallemptydetailrows()
	if this.id_detail.rowcount() <= 0 then
		messagebox("Rows Validation", "Please insert a row before proceeding")
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	ls_askuserpwd = "Salesalesmanwindow"
	if f_stringpreferences(ls_askuserpwd) = "Y" then
		open(w_salesmanpassword)
		ll_usercode = long(message.doubleparm)
		setfocus()
	else
		ll_usercode = gl_usercode
	end if
	if ll_usercode > 0 then
		ll_mastercurrrow = this.id_master.getrow()
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if isnull(ll_invid) then
			ll_maxretcode = wf_tabnewid("saleinvgroup", ll_invid)
			if ll_maxretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~ngenerating InvCode")
				return
			end if
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
		end if
		if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			return
		end if
		this.id_master.setitem(ll_mastercurrrow, "usercode", ll_usercode)
		this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		for ll_counter = 1 to this.id_detail.rowcount()
			this.id_detail.object.code[ll_counter] = ll_invid
		next
		if wf_update_saledetail() >= 0 then
			lb_continue = true
		else
			lb_continue = false
		end if
		if lb_continue then
			if this.id_master.update() > 0 then
				if this.id_detail.update() > 0 then
					SQL commit USING this.it_transobject;
					messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
					this.ib_commitok = true
					lb_continue = true
					this.id_master.resetupdate()
					this.im_menu.m_file.m_new.enabled = true
					this.editflag = false
					if gd_recenttransdate < this.id_systemdate then
						gd_recenttransdate = this.id_systemdate
					end if
				else
					lb_continue = false
					ls_errtext = "Changes Not Saved in database. Problem in updation of sale invoice details."
				end if
			else
				lb_continue = false
				ls_errtext = "Changes Not Saved in database. Problem in updation of sale invoice group."
			end if
		else
			lb_continue = false
			ls_errtext = "Changes Not Saved in database.~r~nError in Row No." + trim(string(ll_errrowid)) + "~r~nReasons are:-~r~n" + ls_errtext
		end if
	else
		return
	end if
	if this.ib_commitok then
		this.ib_modify = false
		this.id_detail.reset()
	elseif this.ib_modify = false then
		this.id_master.setitem(1, "Code", ll_null)
		this.id_master.accepttext()
	end if
	if not lb_continue then
		SQL rollback USING this.it_transobject;
		if this.ib_modify = false then
			setnull(ll_null)
			this.id_master.setitem(1, "Code", ll_null)
			this.id_master.accepttext()
		end if
		messagebox("Saving Problem", ls_errtext, stopsign!)
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_saleinvgroup.ue_newform() returns 0 [event]
	this.im_menu.m_file.m_print.enabled = false
	setredraw(false)
	this.i_editmode = 1
	this.i_retrievemode = 2
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_new.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true
	this.im_menu.m_file.m_first.enabled = false
	this.im_menu.m_file.m_next.enabled = false
	this.im_menu.m_file.m_previous.enabled = false
	this.im_menu.m_file.m_last.enabled = false
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_retrieve.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.tab_retrieve.tabpage_detail.enabled = true
	if this.id_master.rowcount() > 0 then
		this.id_master.reset()
	end if
	this.ib_focusdetail = false
	this.id_master.insertrow(0)
	this.id_master.scrolltorow(0)
	this.id_detail.reset()
	postevent("ue_newitem")
	this.id_detail.setcolumn("saleinvcode")
	this.id_detail.scrolltorow(0)
	this.id_detail.setfocus()
	setredraw(true)

// w_saleinvgroup.ue_newitem() returns 0 [event]
	long ll_rowcount
	long ll_rtcode
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.setcolumn("saleinvcode")
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = false
	this.ib_validatefullcode = true

// w_saleinvgroup.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	return ::message.returnvalue

// w_saleinvgroup.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_saleinvgroup.ue_deleteitem() returns 0 [event]
