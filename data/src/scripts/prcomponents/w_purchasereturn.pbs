		ls_report = "d_prinvreport_thermal"
	elseif gs_company = "GREENPLUS17" then
		ls_report = "d_greenplus17_prinvreport"
	elseif gs_company = "PEARLLUBE" then
		ls_report = "d_pearllube_prinvreport"
	elseif gs_company = "CITYCASHNCARRY" or gs_company = "CITYCASHNCARRY3" or gs_company = "CITYCASHNCARRY4" or gs_company = "MEDCITYCNC" then
		ls_report = "d_citycashncarry_prinvreport"
	elseif gs_company = "BISMILLAHSTORE" then
		ls_report = "d_bismillahstore_prinvreport"
	elseif gs_company = "DWSPWD" or gs_company = "DWSCHANDNICHOWK" or gs_company = "DWSGHOURITOWN" or gs_company = "DWSGUJARKHAN" then
		ls_report = "d_dwspwd_prinvreport"
	elseif gs_company = "SA" then
		ls_report = "d_sa_prinvreport"
	elseif gs_company = "ISHAHIZACNC" then
		ls_report = "d_ishahizacnc_prinvreport"
	elseif gs_company = "EASTERNMEDICAL" then
		ls_report = "d_easternmedical_prinvreport"
	elseif gs_company = "SAVEGALLERYCNC3" then
		ls_report = "d_savegallerycnc3_prinvreport"
	elseif gs_company = "WELCOMEHEALTH" then
		ls_report = "d_welcomehealth_prinvreport_thermal"
	elseif gs_company = "TAJMEDICOSWH" then
		ls_report = "d_tajmedicoswh_prinvreport"
	elseif gs_company = "DRUGMART2" or gs_company = "DRUGMART3" then
		ls_report = "d_drugmart2_prinvreport"
	elseif gs_company = "AZAMMEDICINE" then
		ls_report = "d_azammedicine_prinvreport_thermal"
	else
		ls_report = this.id_print.dataobject
	end if
	this.id_print.dataobject = ls_report

// w_purchasereturn.wf_validatebonusqty(long al_row, double al_bonusqty, string as_errortext) returns integer
	integer li_rtcode
	double ld_retablebonusqty
	double ld_stock
	ld_retablebonusqty = this.id_detail.getitemnumber(al_row, "retablebonusqty")
	ld_stock = this.id_detail.getitemnumber(al_row, "stock")
	if al_bonusqty < 0.0 then
		li_rtcode = 1
	elseif not this.ib_openpurreturn then
		if al_bonusqty <= ld_retablebonusqty then
			if al_bonusqty <= ld_stock then
				li_rtcode = 0
			else
				li_rtcode = 1
				as_errortext = "Quantity can not exceeds stock"
			end if
		else
			li_rtcode = 1
			as_errortext = "Quantity can not exceeds return able quantity"
		end if
	end if
	return li_rtcode

// w_purchasereturn.wf_itemprevretqty(long al_purinvcode, long al_icode, string as_batch, datetime ad_expiry, double al_prevretlooseqty, double al_prevretbonusqty) returns boolean
	boolean lb_rtflag
	SQL SELECT Sum ( prdetail.looseqty ) , Sum ( prdetail.bonusqty ) INTO :al_prevretlooseqty, :al_prevretbonusqty FROM prledger , prdetail WHERE prledger.purinvcode =:al_purinvcode AND prledger.prinvcode =prdetail.prinvcode AND prdetail.icode =:al_icode AND prdetail.batch =:as_batch AND prdetail.expiry =:ad_expiry USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		lb_rtflag = false
	end if
	if isnull(al_prevretlooseqty) then
		al_prevretlooseqty = 0
	end if
	if isnull(al_prevretbonusqty) then
		al_prevretbonusqty = 0
	end if
	return lb_rtflag

// w_purchasereturn.wf_itemprevretlbqty(long al_purinvcode, long al_icode, string as_batch, datetime ad_expiry, double al_prevretlooseqty, double al_prevretbonusqty) returns boolean
	boolean lb_rtflag
	SQL SELECT Sum ( prdetail.looseqty ) , Sum ( prdetail.bonusqty ) INTO :al_prevretlooseqty, :al_prevretbonusqty FROM prledger , prdetail WHERE prledger.purinvcode =:al_purinvcode AND prledger.prinvcode =prdetail.prinvcode AND prdetail.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		lb_rtflag = false
	end if
	if isnull(al_prevretlooseqty) then
		al_prevretlooseqty = 0
	end if
	if isnull(al_prevretbonusqty) then
		al_prevretbonusqty = 0
	end if
	return lb_rtflag

// w_purchasereturn.wf_itemstockinfo(long al_gcode, long al_icode, string as_batch, datetime ad_expiry, double al_stock) returns boolean
	boolean retflag
	SQL SELECT godowndetail.currqty INTO :al_stock FROM godowndetail WHERE godowndetail.Gcode =:al_gcode AND godowndetail.icode =:al_icode AND godowndetail.batch =:as_batch AND godowndetail.expiry =:ad_expiry USING this.it_transobject;
	if isnull(al_stock) then
		al_stock = 0
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_purchasereturn.wf_validatelooseqty(long al_row, double al_looseqty, string as_errortext) returns integer
	integer li_rtcode
	double ld_retablelooseqty
	double ld_stock
	if al_looseqty <= 0.0 then
		li_rtcode = 1
		as_errortext = "Quantity can not be less than zero"
	elseif not this.ib_openpurreturn then
		ld_retablelooseqty = this.id_detail.getitemnumber(al_row, "retablelooseqty")
		ld_stock = this.id_detail.getitemnumber(al_row, "stock")
		if al_looseqty <= ld_retablelooseqty then
			if al_looseqty <= ld_stock then
				li_rtcode = 0
			else
				li_rtcode = 1
				as_errortext = "Quantity can not exceeds stock"
			end if
		else
			li_rtcode = 1
			as_errortext = "Quantity can not exceeds return able quantity"
		end if
	end if
	return li_rtcode

// w_purchasereturn.wf_setterms() returns integer
	s_quotationremarks ls_quotationremarks
	if this.tab_retrieve.selectedtab = 2 then
		return 0
	end if
	if this.id_master.object.posted[1] = "Y" then
		return 0
	end if
	if wf_iseditable() = false then
		return 0
	end if
	ls_quotationremarks.remarks2 = this.id_master.getitemstring(1, "Terms1")
	ls_quotationremarks.remarks3 = this.id_master.getitemstring(1, "Terms2")
	ls_quotationremarks.remarks4 = this.id_master.getitemstring(1, "Terms3")
	ls_quotationremarks.remarks5 = this.id_master.getitemstring(1, "Terms4")
	ls_quotationremarks.remarks6 = this.id_master.getitemstring(1, "Terms5")
	ls_quotationremarks.module = "PR"
	openwithparm(w_quotationremarks, ls_quotationremarks)
	ls_quotationremarks = message.powerobjectparm
	this.id_master.setitem(1, "terms1", ls_quotationremarks.remarks2)
	this.id_master.setitem(1, "terms2", ls_quotationremarks.remarks3)
	this.id_master.setitem(1, "terms3", ls_quotationremarks.remarks4)
	this.id_master.setitem(1, "terms4", ls_quotationremarks.remarks5)
	this.id_master.setitem(1, "terms5", ls_quotationremarks.remarks6)
	return 1

// w_purchasereturn.wf_set_itemtotal_formatmask() returns long
	string ls_modify
	string ls_format
	ls_format = trim(f_stringpreferences("FormatForAmtInPRet"))
	ls_modify = "c_total.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "d_detaildwtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_finalitemval.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_total_finalitemval.Format='" + ls_format + "'  "
	this.id_detail.modify(ls_modify)
	return 0

// w_purchasereturn.wf_populatefiltereditems() returns integer
	datastore lds_itemselected
	long ll_detailrows
	long ll_count
	long ll_duplrows
	long ll_insrow
	double ld_godownstock
	double ld_totalstock
	integer li_result
	integer li_rtncode
	boolean populateflag
	string ls_errtext
	s_arguements lstr_selecteditems
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_retrievecount
	long ll_lockedcount
	double ld_stock
	if this.tab_retrieve.selectedtab = 2 then
		return 0
	end if
	if this.id_master.object.posted[1] = "Y" then
		return 0
	end if
	if wf_iseditable() = false then
		return 0
	end if
	if this.ib_modify = true and this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate items after posting!")
		return 0
	end if
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 and not isnull(this.id_detail.object.icode[1]) then
		li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
		if li_result = 1 then
			for ll_count = 1 to ll_detailrows
				this.id_detail.deleterow(0)
			next
		else
			populateflag = false
		end if
	end if
	if populateflag = true then
		openwithparm(w_arg_item_populate3, this.ii_module)
		lstr_selecteditems = message.powerobjectparm
		if lstr_selecteditems.i_status <> 1 then
			return 0
		end if
		lds_itemselected = create datastore
		if lstr_selecteditems.s_name2 = "OR" then
			lds_itemselected.dataobject = "d_populateditems"
		else
			lds_itemselected.dataobject = "d_populateditems_and"
		end if
		lds_itemselected.settransobject(this.it_transobject)
		ll_rtcode = lds_itemselected.retrieve(lstr_selecteditems.ia_integerlist, lstr_selecteditems.ia_integerlist1, lstr_selecteditems.ia_integerlist2, lstr_selecteditems.la_longlist, lstr_selecteditems.l_code1, lstr_selecteditems.s_name1)
		ll_rowcount = lds_itemselected.rowcount()
		if isnull(this.id_detail.object.icode[this.id_detail.rowcount()]) then
			this.id_detail.deleterow(this.id_detail.rowcount())
		end if
		for ll_count = 1 to ll_rowcount
			ll_icode = lds_itemselected.object.icode[ll_count]
			ll_insrow = this.id_detail.insertrow(0)
			if ll_insrow > 0 then
				this.il_currrow = ll_insrow
				if wf_inititeminfo(ll_icode, this.il_currrow, ls_errtext) then
					this.id_detail.object.icode[ll_count] = ll_icode
					ll_gcode = lds_itemselected.object.gcode[ll_count]
					if isnull(ll_gcode) then
						this.id_detail.object.gcode[ll_count] = this.ii_salegodown
						ll_gcode = this.ii_salegodown
					else
						this.id_detail.object.gcode[ll_count] = ll_gcode
					end if
					this.id_detail.object.batch[ll_count] = lds_itemselected.object.batch[ll_count]
					this.id_detail.object.looseqty[ll_count] = lds_itemselected.object.qty[ll_count]
					this.id_detail.object.expiry[ll_count] = datetime(date(lds_itemselected.object.expiry[ll_count]))
					this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
					if this.it_transobject.sqlcode = -1 then
						messagebox("Database Error", "Database Error: Item information can not be retrieved")
						return 0
					end if
					this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_totalstock)
					if this.it_transobject.sqlcode = -1 then
						messagebox("Database Error", "Database Error: Item information can not be retrieved")
						return 0
					end if
					this.id_detail.object.stock[ll_insrow] = ld_godownstock
					this.id_detail.object.totalstock[ll_insrow] = ld_totalstock
					this.id_footer.object.stock[1] = ld_godownstock
					this.id_footer.object.totalstock[1] = ld_totalstock
					this.id_detail.setitemstatus(ll_count, "prprice", primary!, notmodified!)
					ll_retrievecount = ll_retrievecount + 1
				end if
			end if
		next
		destroy lds_itemselected
		if ll_retrievecount = ll_rowcount then
			messagebox("Result", string(ll_rowcount) + " Items are populated. ")
		else
			messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " records are retrieved successfully~n~r" + string(ll_duplrows) + " records are duplicate so are not retrieved~n~r" + string(ll_lockedcount) + " records are in error")
		end if
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 and this.ib_modify = false then
		this.im_menu.m_file.m_save.enabled = true
	end if
	setpointer(arrow!)
	return ll_retrievecount

// w_purchasereturn.wf_editpostedinvoice() returns 0
	long ll_code
	string ls_specialright
	s_invdetail lstr_invdetail
	ls_specialright = "4"
	if gl_usercode <> 1 then
		return
	end if
	if this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
	end if
	if ll_code > 0 and this.id_list.object.posted[this.id_list.getrow()] = "Y" then
		if f_is_specialright_enabled(ls_specialright) then
			openwithparm(w_special_rights_password, ls_specialright)
			if message.doubleparm > 0.0 then
				lstr_invdetail.i_module = this.ii_module
				lstr_invdetail.l_invcode = ll_code
				openwithparm(w_editpostedinvoice, lstr_invdetail)
			else
				return
			end if
		else
			return
		end if
		return
	end if

