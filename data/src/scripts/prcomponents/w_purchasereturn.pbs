// w_purchasereturn.wf_purchase_from_customer() returns long
	s_arguements lstr_arg
	long ll_custcode
	if this.tab_retrieve.selectedtab = 2 then
		return 0
	end if
	if this.id_master.object.posted[1] = "Y" then
		return 0
	end if
	if wf_iseditable() = false then
		return 0
	end if
	ll_custcode = this.id_master.object.custcode[1]
	openwithparm(w_arg_purchasefromcustomer, ll_custcode)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		this.id_master.object.custcode[1] = lstr_arg.l_code1
		if this.id_master.object.custcode[1] > 0 then
			this.id_master.object.suppcode.protect = 1
			this.id_master.object.suppcode[1] = 18
			wf_setsuppinfo(18)
		else
			this.id_master.object.suppcode.protect = 0
			this.id_master.object.suppcode[1] = 18
			wf_setsuppinfo(18)
		end if
	end if
	return 0

// w_purchasereturn.wf_validate_pcs(long row, string data) returns long
	long ll_errcode
	long ll_found
	double ld_storedqty
	double ld_oldpcs
	double ld_stock
	double ld_desiredbonus
	double ld_areavolume
	double ld_pcs
	double ld_packcapacity
	double ld_tmpqty
	integer li_roundupto
	string ls_null
	setnull(ls_null)
	ld_storedqty = this.id_detail.object.looseqty[row]
	ld_oldpcs = this.id_detail.object.pcs[row]
	ld_packcapacity = this.id_detail.object.packcapacity[row]
	if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
		ld_packcapacity = 1
	end if
	ld_areavolume = this.id_detail.object.areavolume[row]
	if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
		ld_areavolume = 1
	end if
	ld_pcs = double(data)
	li_roundupto = f_get_colprecision("Qty")
	ld_tmpqty = round(ld_pcs * ld_areavolume, li_roundupto)
	if ld_pcs >= 0.0 then
		this.id_detail.setitem(row, "looseqty", ld_tmpqty)
		this.id_detail.setitem(row, "cartons", trim(string(long(ld_pcs / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(ld_pcs mod ld_packcapacity, 2))))))
		if wf_validaterow() = -1 then
			messagebox("Quantity Validation", "Not Enough stock for Purchase Return.", stopsign!)
			this.id_detail.object.looseqty[row] = ld_storedqty
			this.id_detail.object.pcs[row] = ld_oldpcs
			return 1
		end if
	else
		ll_errcode = 1
		messagebox("PCS Validation", "Only possitive PCS are allowed for this item", stopsign!)
	end if
	return ll_errcode

// w_purchasereturn.wf_replace_postdate_with_date() returns long
	string ls_errtext
	s_arguements lstr_arg
	if f_rightexists(5162) then
		open(w_arg_sinvcode_linvcode)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = 1 then
			SQL update PrLedger SET PostDate =Date WHERE PrInvCode BETWEEN :lstr_arg.l_code1 AND :lstr_arg.l_code2 USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				SQL commit USING this.it_transobject;
			else
				ls_errtext = this.it_transobject.sqlerrtext
				SQL rollback USING this.it_transobject;
				messagebox("Purchase Return Posting Date Updation Error", "Error in Updating Posting Date for Selected Purchase Returns.~r~nReasons are:-~r~n" + ls_errtext, stopsign!)
			end if
		end if
	end if
	return 0

// w_purchasereturn.wf_setgodownoption() returns 0
	this.ii_salegodown = this.id_detail.getitemnumber(1, "gcode")
	if this.il_strategy = 2 or this.il_strategy = 1 and this.il_godowncount = 1 then
	end if

// w_purchasereturn.wf_itemprhistory() returns long
	s_itempurchasehistory ls_itempurchasehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itempurchasehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itempurchasehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itemprhistory, ls_itempurchasehistory)
	end if
	return 0

// w_purchasereturn.wf_apply_groupsuppliercategory() returns long
	long ll_counter
	integer li_rtncode
	string ls_filterstring
	datastore lds_groupsuppcategory
	if this.ii_purrettype = 3 then
		this.idc_supplierlist.setfilter("")
		this.idc_supplierlist.filter()
	elseif f_stringpreferences("GroupSuppCatInPurAndPR") = "Y" then
		lds_groupsuppcategory = create datastore
		lds_groupsuppcategory.dataobject = "d_groupsuppcategory_detail"
		lds_groupsuppcategory.settransobject(this.it_transobject)
		this.il_groupcode = f_getgroupcode(gl_usercode)
		lds_groupsuppcategory.retrieve(this.il_groupcode)
		ls_filterstring = ""
		for ll_counter = 1 to lds_groupsuppcategory.rowcount()
			ls_filterstring = ls_filterstring + trim(string(lds_groupsuppcategory.object.suppcatcode[ll_counter])) + ","
		next
		if right(ls_filterstring, 1) = "," then
			ls_filterstring = left(ls_filterstring, len(ls_filterstring) - 1)
		end if
		if ls_filterstring = "" then
			ls_filterstring = "-1"
		end if
		this.idc_supplierlist.setfilter("suppcatcode In (" + ls_filterstring + ") ")
		this.idc_supplierlist.filter()
	end if
	return 0

// w_purchasereturn.wf_check_groupsuppliercategory() returns long
	long ll_acccode
	long ll_found
	long ll_code
	long ll_counter
	long ll_rowcount
	long ll_groupcode
	long ll_suppcatcode
	boolean lb_groupcustcat
	if f_stringpreferences("GroupSuppCatInPurAndPR") = "N" then
		return 0
	end if
	ll_groupcode = f_getgroupcode(gl_usercode)
	ll_rowcount = this.id_detail.rowcount()
	ll_acccode = this.id_master.getitemnumber(1, "suppcode")
	SQL Select MAX ( SuppCode ) , MAX ( SuppCatCode ) INTO :ll_found, :ll_suppcatcode From dbo.supplier Where suppcode =:ll_acccode USING this.it_transobject;
	if ll_found > 0 and ll_suppcatcode > 0 and this.it_transobject.sqlcode = 0 then
		ll_found = 0
		SQL SELECT count ( suppcatcode ) INTO :ll_found FROM GroupSupplierCategory WHERE SuppCatCode =:ll_suppcatcode AND GroupCode =:ll_groupcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 and ll_found < 1 then
			return -1
		end if
		return
	end if
	return 0

// w_purchasereturn.wf_fetch_pur_batch_details(long al_icode, string as_batch, datetime adt_expiry) returns long
	long ll_row
	long ll_packunits
	long ll_purcatcode
	double ld_purprice
	double ld_discperc
	double ld_unitsaletax
	double ld_gstperc
	string ls_itemdescription
	SQL SELECT PD.PurPrice , PD.Discperc , PD.UnitSalesTax , PD.GSTPerc , PD.ItemDescription , PD.packunits , Purcatcode =( SELECT P.PurCatCode FROM Purledger P WHERE P.PurInvCode =PD.PurInvCode ) INTO :ld_purprice, :ld_discperc, :ld_unitsaletax, :ld_gstperc, :ls_itemdescription, :ll_packunits, :ll_purcatcode FROM PurDetail PD WHERE PD.PurUtn IN ( SELECT MAX ( D.PURUTN ) FROM Purdetail D WHERE D.ICode =:al_icode AND D.Batch =:as_batch AND D.Expiry =:adt_expiry ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_row = this.id_detail.getrow()
		if ll_row > 0 then
			if ll_packunits <= 0 or isnull(ll_packunits) then
				ll_packunits = 1
			end if
			if ll_purcatcode >= 3 then
				this.id_detail.object.prprice[ll_row] = ld_purprice
				this.id_detail.object.discperc[ll_row] = ld_discperc
				this.id_detail.object.unitsalestax[ll_row] = ld_unitsaletax
				this.id_detail.object.gstperc[ll_row] = ld_gstperc
				this.id_detail.object.prprice[ll_row] = ld_purprice
			else
				this.id_detail.object.prprice[ll_row] = round(ld_purprice / ll_packunits, 2)
				this.id_detail.object.discperc[ll_row] = ld_discperc
				this.id_detail.object.unitsalestax[ll_row] = round(ld_unitsaletax / ll_packunits, 2)
				this.id_detail.object.gstperc[ll_row] = ld_gstperc
				this.id_detail.object.prprice[ll_row] = round(ld_purprice / ll_packunits, 2)
			end if
		end if
	end if
	return 0

// w_purchasereturn.wf_set_historical_batch_details(long al_detailrow, long al_row) returns long
	if al_detailrow > 0 and al_row > 0 then
		this.id_detail.object.prprice[al_detailrow] = this.idc_historicalbatch.getitemnumber(al_row, "purprice")
		this.id_detail.object.discperc[al_detailrow] = this.idc_historicalbatch.getitemnumber(al_row, "discperc")
		this.id_detail.object.gstperc[al_detailrow] = this.idc_historicalbatch.getitemnumber(al_row, "gstperc")
		this.id_detail.object.unitsalestax[al_detailrow] = this.idc_historicalbatch.getitemnumber(al_row, "unitsalestax")
	end if
	return 0

// w_purchasereturn.wf_showaccountledger() returns 0
	long ll_acccode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_acccode = this.id_master.object.suppcode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_acccode = this.id_list.object.suppcode[this.id_list.getrow()]
	end if
	if not isnull(ll_acccode) and ll_acccode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_account_ledger, ll_acccode)
	end if

// w_purchasereturn.wf_push_pr_to_dropbox() returns long
	integer li_errcode
	long ll_salesmancode
	long ll_invcount
	long ll_counter
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			li_errcode = this.it_transobject.pushprtodropbox(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode, gs_dropbox_server, gs_dropbox_db, "DBO", ll_invcount)
			if li_errcode <> 0 then
				li_errcode = this.it_transobject.sqlcode
				ls_msgtext = this.it_transobject.sqlerrtext
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				ls_msgtext = this.it_transobject.sqlerrtext
				li_errcode = this.it_transobject.sqlcode
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Push P/R To Drop Box Fails", "Some database request fails, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode), stopsign!)
		else
			messagebox("Push P/R to Drop Box Successfull", "Total Invoices to push were " + string(ll_invcount) + "~n~rAll Invoices have been pushed successfully to drop box.", information!)
		end if
	end if
	return li_errcode

// w_purchasereturn.wf_check_pr_below_avgprice() returns long
	long ll_icode
	long ll_detailrows
	long ll_found
	char ls_allowprbelowavgprice
	string ls_itemname
	double ld_prprice
	double ld_avgprice
	double ld_invdiscperc
	ll_detailrows = this.id_detail.rowcount()
	ls_allowprbelowavgprice = f_stringpreferences("AllowPRBelowAvgPrice")
	if ll_detailrows > 0 and upper(ls_allowprbelowavgprice) = "N" then
		ld_invdiscperc = this.id_footer.object.discperc[1]
		ll_found = this.id_detail.find("Round( (looseqty * prprice * (1 - discperc * 0.01) * (1 - " + string(ld_invdiscperc, "###0.00") + " * 0.01)) / if((looseqty + bonusqty) > 0,  (looseqty + bonusqty), 1), 2) < round(avgprice,2)", 1, ll_detailrows)
		if ll_found > 0 and ll_found <= ll_detailrows then
			ls_itemname = this.id_detail.object.itemname[ll_found]
			if this.id_detail.object.looseqty[ll_found] + this.id_detail.object.bonusqty[ll_found] > 0 then
				ld_prprice = round(this.id_detail.object.looseqty[ll_found] * this.id_detail.object.prprice[ll_found] * (1 - this.id_detail.object.discperc[ll_found] * 0.01) * (1.0 - ld_invdiscperc * 0.01) / (this.id_detail.object.looseqty[ll_found] + this.id_detail.object.bonusqty[ll_found]), 2)
			else
				ld_prprice = round(this.id_detail.object.looseqty[ll_found] * this.id_detail.object.prprice[ll_found] * (1 - this.id_detail.object.discperc[ll_found] * 0.01) * (1.0 - ld_invdiscperc * 0.01) / 1, 2)
			end if
			ld_avgprice = this.id_detail.object.avgprice[ll_found]
			messagebox("Item Validation", "P/R Price is below Avg. Price for this item.~r~n" + "Item Name = " + ls_itemname + "~r~n" + "P/R Price = " + trim(string(round(ld_prprice, 2), "###,###,##0.00")) + "~r~n" + "Avg. Price = " + trim(string(round(ld_avgprice, 2), "###,###,##0.00")) + "~r~n" + "~r~nSuggested options are either delete the row or change Item P/R Price")
			this.id_detail.scrolltorow(ll_found)
			this.id_detail.setcolumn("looseqty")
			this.id_detail.setfocus()
			return -1
		end if
		return
	end if
	return 0

// w_purchasereturn.create() returns 0
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_purreturn" then
		this.menuid = create m_purreturn
	end if
	this.dw_purretinvrep = create dw_purretinvrep
	this.dw_prinvdetail = create dw_prinvdetail
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_purretinvrep
	this.control[icurrent + 2] = this.dw_prinvdetail

// w_purchasereturn.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_purretinvrep
	destroy this.dw_prinvdetail

// w_purchasereturn.ue_save() returns 0
	long ll_counter
	long ll_supplieracc
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_icode
	long ll_gcode
	long ll_packingunits
	long ll_salesmancode
	long ld_netpurretcost
	long ld_itempurretcost
	long ll_headerno
	long ll_headerinvno
	long ll_purinvcode
	long ll_null
	long ll_count
	long ll_found
	long ll_rightfound
	long ll_maxretcode
	double ld_stock
	double ld_newstock
	double ld_prqty
	double ld_prbonusqty
	double ld_packqty
	double ld_bonusqty
	double ld_looseqty
	string ls_batch
	string ls_errtext
	datetime ld_expiry
	double ld_avgprice
	double ld_saleprice
	double ld_newavgprice
	double ld_prprice
	double ld_discperc
	double ld_itempurcost
	double ld_netpurcost
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_debitamt
	double ld_creditamt
	double ld_currbalance
	double ld_netavgpurcost
	integer li_counter
	integer li_purchasecategory
	integer li_errorrow
	boolean lb_commitflag
	boolean lb_continue
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	datetime ldt_server_datetime
	string ls_date_errtext
	datawindowchild ldc_headerno
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_stringpreferences("ForcePCSInInterAtSalesSaving") = "Y" then
		for ll_counter = 1 to this.id_detail.rowcount()
			if this.id_detail.object.pcs[ll_counter] <> long(this.id_detail.object.pcs[ll_counter]) then
				messagebox("PCS Validation", "Please enter some valid PCS. It Should be some valid integer value", stopsign!)
				this.id_detail.setrow(ll_counter)
				this.id_detail.setfocus()
				this.id_detail.setcolumn("PCS")
				return
			end if
		next
	end if
	ll_counter = 0
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 1 then
		for ll_count = 1 to ll_detailrows
			ll_found = 0
			if ll_count = ll_detailrows then
				exit
			end if
			ll_found = this.id_detail.find("gcode = long('" + string(this.id_detail.getitemnumber(ll_count, "gcode")) + "') and " + " icode = long('" + string(this.id_detail.getitemnumber(ll_count, "icode")) + "') and batch = '" + this.id_detail.getitemstring(ll_count, "batch") + "' and expiry = Date('" + string(this.id_detail.getitemdatetime(ll_count, "expiry"), "yyyy-mm-dd") + "')", ll_count + 1, ll_detailrows)
			if ll_found > 0 then
				messagebox("Item Validation", "Duplicate items found at row " + string(ll_count) + " and " + string(ll_found) + "." + "~r~nSuggested options are either delete the row or ~r~n" + "change Item batch")
				this.id_detail.scrolltorow(ll_count)
				this.id_detail.setcolumn("looseqty")
				this.id_detail.setfocus()
				return
			end if
		next
	elseif ll_detailrows <= 0 then
		messagebox("On Save Validation", "There are no rows to save.~r~nKindly insert some item row.")
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	if wf_check_pr_below_avgprice() < 0 then
		return
	end if
	if wf_check_groupsuppliercategory() <> 0 then
		messagebox("Group Wise Supplier Category Validation", "Current user group does not have enough permissions w.r.t supplier.~r~nPossible Reasons are:~r~nSupllier is not allowed to the current user group.")
		this.id_master.setcolumn("suppcode")
		this.id_master.setfocus()
		return
	end if
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	wf_setamountoninvoice()
	wf_grandtotal()
	this.id_footer.accepttext()
	this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		setpointer(hourglass!)
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			ll_maxretcode = wf_tabnewid("prledger", ll_invid)
			if ll_maxretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~n ~t~t~t~t~t~t~tgenerating InvCode")
				return
			end if
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
			this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
		end if
		this.id_master.object.discperc[ll_mastercurrrow] = this.id_footer.object.discperc[ll_footercurrrow]
		this.id_master.object.flatdisc[ll_mastercurrrow] = this.id_footer.object.flatdisc[ll_footercurrrow]
		this.id_master.object.misccharges[ll_mastercurrrow] = this.id_footer.object.misccharges[ll_footercurrrow]
		this.id_master.object.salestax[ll_mastercurrrow] = this.id_footer.object.salestax[ll_footercurrrow]
		wf_grandtotal()
		this.id_footer.accepttext()
		this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
		this.id_master.object.invgstperc1[ll_mastercurrrow] = this.id_footer.object.invgstperc1[ll_footercurrrow]
		this.ii_purretcategory = this.id_master.object.prcatcode[ll_mastercurrrow]
		ld_misccharges = this.id_master.object.misccharges[ll_mastercurrrow]
		ld_invdiscperc = this.id_master.object.discperc[ll_mastercurrrow]
		ld_flatdisc = this.id_master.object.flatdisc[ll_mastercurrrow]
		ld_salestax = this.id_master.object.salestax[ll_mastercurrrow]
		li_counter = 1
		this.id_master.getchild("headerno", ldc_headerno)
		if f_stringpreferences("Headeronpurchasereturninv") = "N" then
			this.id_master.setitem(ll_mastercurrrow, "Headerno", ldc_headerno.getitemnumber(ll_mastercurrrow, "code"))
		end if
		ll_headerno = this.id_master.getitemnumber(ll_mastercurrrow, "headerno")
		ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
		if isnull(ll_headerinvno) then
			f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
			if ll_headerinvno > 0 then
				this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
			end if
		end if
		if this.ib_modify then
			lb_continue = wf_returnprinvoice(ll_invid, ls_errtext)
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			if f_stringpreferences("PurchaseReturnPosting") = "Y" then
				this.id_master.setitem(ll_mastercurrrow, "Posted", "Y")
				this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
				this.id_master.setitem(ll_mastercurrrow, "postedby", ll_salesmancode)
			end if
		else
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			if f_stringpreferences("PurchaseReturnPosting") = "Y" then
				this.id_master.setitem(ll_mastercurrrow, "Posted", "Y")
				this.id_master.setitem(ll_mastercurrrow, "postedby", ll_salesmancode)
			end if
		end if
		if not this.ib_modifydate then
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
		else
			ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
		end if
		this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
		this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
		if this.id_master.getitemstring(1, "accountfor") = "Y" and f_stringpreferences("AskAmtOnPurchaseReturn") = "Y" then
			ll_rightfound = 0
			ll_rightfound = gds_securitywindow.find("rightcode = 585", 1, gds_securitywindow.rowcount())
			if ll_rightfound > 0 then
				this.id_master.setitem(ll_mastercurrrow, "amtby", ll_salesmancode)
				this.id_master.setitem(ll_mastercurrrow, "amtdate", ldt_server_datetime)
			end if
		end if
		if lb_continue then
			this.id_prinvdetail.reset()
			if wf_populateprdetail(ll_invid, this.id_prinvdetail, ls_errtext, li_errorrow) < 0 then
				lb_commitflag = false
			else
				this.id_detail = this.id_prinvdetail
				call super::ue_save
				this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
				this.id_prinvdetail.reset()
			end if
			if this.ib_commitok then
				this.ib_modify = false
			elseif this.ib_modify = false then
				setnull(ll_null)
				this.id_master.setitem(1, "Code", ll_null)
				this.id_master.accepttext()
			end if
		else
			lb_commitflag = false
			messagebox("Updation Error", ls_errtext + " in current row", stopsign!)
		end if
		if not lb_commitflag then
			SQL rollback USING this.it_transobject;
			messagebox("Updation Error", ls_errtext + "~r~nError occur in row " + string(li_errorrow) + ".", stopsign!)
			if li_errorrow > 0 or not isnull(li_errorrow) then
				this.id_detail.scrolltorow(li_errorrow)
				this.id_detail.setcolumn("looseqty")
				this.id_detail.setfocus()
			end if
		elseif f_stringpreferences("IncPRInActMonitor") = "Y" then
			this.it_transobject.updateactivitymonitor("PR", ll_invid)
			if this.it_transobject.sqlcode <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
			else
				SQL commit USING this.it_transobject;
			end if
		end if
	else
		messagebox("Save Fails", "Can not save Purchase Return~n~r" + ls_errtext)
		setfocus()
	end if
	setpointer(arrow!)

// w_purchasereturn.ue_newform() returns 0
	datetime ldt_server_datetime
	string ls_date_errtext
	this.idc_itemdddw.insertrow(0)
	this.idc_historicalbatch.insertrow(0)
	this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if f_stringpreferences("updateavgpricewithnetrate") = "N" then
		this.id_master.object.updateavgpricewithnetrate.initial = "N"
	else
		this.id_master.object.updateavgpricewithnetrate.initial = "Y"
	end if
	call super::ue_newform
	setredraw(false)
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.ib_modify = false
	if this.ii_purrettype = 3 and not this.ib_openpurreturn then
		this.id_master.object.suppcode[this.id_master.getrow()] = this.il_code
	end if
	wf_setgodownoption()
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	this.idc_itemdddw.reset()
	this.idc_itemdddw.insertrow(0)
	this.idc_historicalbatch.reset()
	this.idc_historicalbatch.insertrow(0)
	setredraw(true)
	if not wf_validatedate() then
		close(this)
	end if
	if this.ib_modifydate then
		if this.ib_fetchserverdate then
			wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
			this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
		else
			this.id_master.setitem(this.id_master.getrow(), "date", today())
		end if
	end if
	this.id_master.object.suppcode.protect = 0
	if f_rightexists(5192) then
		this.id_detail.object.prprice.protect = 0
	else
		this.id_detail.object.prprice.protect = 1
	end if
	if f_rightexists(5193) then
		this.id_detail.object.discperc.protect = 0
		return
	end if
	this.id_detail.object.discperc.protect = 1

// w_purchasereturn.ue_detail() returns 0
	integer li_rtncode
	integer li_protect
	long ll_row
	long ll_code
	long ll_purinvcode
	string ls_errtext
	long ll_rowcount
	this.idc_itemdddw.insertrow(0)
	this.idc_historicalbatch.insertrow(0)
	this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	call super::ue_detail
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	if wf_isinvoiceinuse(ll_code) = true then
		messagebox("Invoice Validation", "Purchase Return Invoice already in use by some other user.~r~nKindly try again after sometime or open some other invoice.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if wf_check_groupsuppliercategory() <> 0 then
		messagebox("Group Wise Supplier Category Validation", "Current user group does not have enough permissions w.r.t supplier.~r~nPossible Reasons are:~r~nSupllier is not allowed to the current user group.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if wf_allowreturnmodification(ll_code, this.il_groupcode, this.il_strategy) <> 0 then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "You Can not modify this Invoice,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	this.id_footer.retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	if not this.ib_openpurreturn then
		this.idc_itemdddw.settransobject(this.it_transobject)
		li_rtncode = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
		li_rtncode = this.idc_itemdddw.retrieve(this.id_dwcontrol.borderstyle.pur_inv_code[this.il_selectedrow])
		ll_purinvcode = this.id_master.object.purinvcode[1]
		wf_populatepurinvds(ll_purinvcode)
	end if
	if this.ib_prmodify then
		li_protect = 0
	else
		li_protect = 1
		this.editflag = false
	end if
	wf_initmodify(li_protect, ls_errtext)
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if li_protect = 0 then
		if f_rightexists(5192) then
			this.id_detail.object.prprice.protect = 0
		else
			this.id_detail.object.prprice.protect = 1
		end if
		if f_rightexists(5193) then
			this.id_detail.object.discperc.protect = 0
		else
			this.id_detail.object.discperc.protect = 1
		end if
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_godown
	end if
	wf_setgodownoption()
	if li_protect = 0 then
		if this.id_master.object.custcode[1] > 0 then
			this.id_master.object.suppcode.protect = 1
		else
			this.id_master.object.suppcode.protect = 0
		end if
	end if
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_post.enabled = false
	wf_grandtotal()
	setredraw(true)

// w_purchasereturn.close() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	if this.ib_openpurreturn = false then
		destroy this.ids_purinvdetail
	end if
	return ::message.returnvalue

// w_purchasereturn.ue_deleteitem() returns 0
	long ll_row
	ll_row = this.id_detail.getrow()
	if this.id_detail.rowcount() > 0 then
		call super::ue_deleteitem
		return
	end if
	this.im_menu.m_file.m_print.enabled = false

// w_purchasereturn.ue_newitem() returns 0
	long ll_count
	long ll_rowcount
	this.idc_itemdddw.insertrow(0)
	this.idc_historicalbatch.insertrow(0)
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 1 and vf_dwdupcodebatch(this.id_detail, "gcode", gl_defaultgcode, "icode", this.id_detail.getitemnumber(this.id_detail.getrow(), "icode"), "batch", this.id_detail.getitemstring(this.id_detail.getrow(), "batch"), "expiry", this.id_detail.getitemdatetime(this.id_detail.getrow(), "expiry"), this.il_currrow) = true then
		messagebox("Item Validation", "Duplicate item, please select some other item")
		return
	end if
	ll_count = this.id_detail.rowcount()
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.settransobject(this.it_transobject)
	if this.ib_openpurreturn then
		if f_stringpreferences("itemcode") = "N" then
			this.id_detail.setcolumn(this.is_columnitemname)
		else
			this.id_detail.setcolumn("fullcode")
		end if
	else
		this.id_detail.setcolumn(this.is_columnitemname)
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_purchasereturn.ue_new() returns 0
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_purchasereturn.ue_list() returns 0
	call super::ue_list
	SQL rollback USING this.it_transobject;
	if f_rightexists(5207) then
		this.im_menu.m_file.m_post.enabled = true
	else
		this.im_menu.m_file.m_post.enabled = false
		this.im_menu.m_file.m_post.visible = false
		this.im_menu.m_file.m_post.toolbaritemvisible = false
	end if
	this.ib_modify = false

// w_purchasereturn.ue_refreshddw() returns 0
	call super::ue_refreshddw
	if this.ib_openpurreturn then
		setpointer(hourglass!)
		this.idc_supplierlist.setredraw(false)
		this.idc_supplierlist.settransobject(this.it_transobject)
		this.idc_supplierlist.reset()
		this.idc_supplierlist.retrieve()
		wf_apply_groupsuppliercategory()
		this.idc_supplierlist.setredraw(true)
		setpointer(arrow!)
	end if

// w_purchasereturn.ue_print() returns 0
	long ll_suppcode
	long ll_row
	long ll_invcode
	string ls_suppname
	string ls_report
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	wf_selectprintreport()
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.id_print.rowcount() > 0 then
		if f_stringpreferences("saleaskforcopies") = "Y" then
			open(w_printer_copies)
			this.id_print.object.datawindow.print.copies = string(message.doubleparm)
		end if
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Purchase Return Invocie,~r~nNo rows are retrieved", information!)

// w_purchasereturn.ue_postopen() returns 0
	datawindowchild ldc_dddpurcategory
	datawindowchild ldc_headerno
	long li_rtncode
	long ll_counter
	long ll_found
	s_salerettype ls_purrettype
	m_purreturn lm_menu
	datastore lds_headers
	call super::ue_postopen
	lm_menu = this.menuid
	setredraw(false)
	f_fetch_sites()
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	ls_purrettype = message.powerobjectparm
	wf_setpurrettype(ls_purrettype.salerettype, ls_purrettype.opensale)
	this.id_print = this.dw_purretinvrep
	this.id_print.settransobject(this.it_transobject)
	this.id_prinvdetail = this.dw_prinvdetail
	this.id_prinvdetail.settransobject(this.it_transobject)
	if this.ib_openpurreturn <> true then
		choose case this.ii_purrettype
		case 1
			wf_assigndatawindowobjects("d_NormalPurchaseReturn", "d_NormalPurchaseReturnDetail", "d_NormalPurchaseReturnFooter", "d_NormalPurchaseReturnList")
		case else
			this.title = "Opening Purchase Return"
			wf_assigndatawindowobjects("d_OpeningPurchaseReturn", "d_NormalPurchaseReturnDetail", "d_NormalPurchaseReturnFooter", "d_OpeningPurchaseReturnList")
			this.it_transobject.getglobalcode("GT_OpeningSupplierACC", this.il_code)
		end choose
		this.is_columnitemname = "icode"
		this.ids_purinvdetail = create datastore
		this.ids_purinvdetail.dataobject = "d_NormalPurchaseDetail"
		this.ids_purinvdetail.settransobject(this.it_transobject)
		this.ib_editing = false
	else
		this.title = "Purchase Return"
		wf_assigndatawindowobjects("d_OpenPurchaseReturn", "d_OpenPurchaseReturnDetail", "d_OpenPurchaseReturnFooter", "d_OpenPurchaseReturnList")
		if f_stringpreferences("itemcode") = "N" then
			this.id_detail.object.fullcode.visible = false
		end if
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 552 then
				this.ib_prmodify = true
			end if
		next
	end if
	if this.ii_purrettype = 1 then
		li_rtncode = this.id_master.getchild("prcatcode", ldc_dddpurcategory)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a 'prcatcode' DataWindowChild")
			close(this)
		else
			ldc_dddpurcategory.settransobject(this.it_transobject)
			ldc_dddpurcategory.reset()
			ldc_dddpurcategory.insertrow(0)
			ldc_dddpurcategory.insertrow(0)
			ldc_dddpurcategory.setitem(1, "purcatcode", 4)
			ldc_dddpurcategory.setitem(1, "name", "Purchase Return Cash")
			ldc_dddpurcategory.setitem(2, "purcatcode", 5)
			ldc_dddpurcategory.setitem(2, "name", "Purchase Return Credit")
		end if
	end if
	if f_stringpreferences("askpurinvnoinpr") = "N" then
		this.id_master.object.purchaseinvno.visible = false
		this.id_master.object.t_purchaseinvno.visible = false
		this.id_master.object.purchaseinvno.initial = "."
		this.id_master.object.purchaseinvno.edit.required = "no"
	elseif f_stringpreferences("allowemptypurinvnoinpr") = "N" then
		this.id_master.object.purchaseinvno.edit.required = "yes"
	else
		this.id_master.object.purchaseinvno.edit.required = "no"
	end if
	if this.ib_openpurreturn <> true then
		li_rtncode = this.id_detail.getchild("icode", this.idc_itemdddw)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_itemdddw.settransobject(this.it_transobject)
		this.idc_itemdddw.insertrow(0)
	else
		gd_itemsinfo.sharedata(this.id_itemslist)
		li_rtncode = this.id_master.getchild("suppcode", this.idc_supplierlist)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
		end if
		this.idc_supplierlist.settransobject(this.it_transobject)
		li_rtncode = this.id_detail.getchild("batch", this.idc_itemdddw)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_itemdddw.settransobject(this.it_transobject)
		this.idc_itemdddw.insertrow(0)
		li_rtncode = this.id_detail.getchild("historicalbatch", this.idc_historicalbatch)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_historicalbatch.settransobject(this.it_transobject)
		this.idc_historicalbatch.insertrow(0)
	end if
	wf_apply_groupsuppliercategory()
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit to Make Purchase Return")
		close(this)
		return
	end if
	li_rtncode = this.id_detail.getchild("gcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights for making Purchase Return")
		close(this)
		return
	end if
	this.ii_godown = this.idc_godown.getitemnumber(1, "gcode")
	this.id_detail.object.gcode.initial = string(this.ii_godown)
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode_t.visible = true
		this.id_master.object.gcode.visible = true
		this.id_master.object.gcode.initial = string(this.ii_godown)
		this.id_detail.object.gcode.visible = false
	end if
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Purchase Return")
		close(this)
		return
	end if
	if f_stringpreferences("headeronpurchasereturninv") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.headerno_t.visible = false
	end if
	this.id_master.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to lds_headers.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
		ldc_headerno.setitem(ll_counter, "name", "")
		ll_found = 0
		ll_found = gds_reoprtheaderinfo.find("headerno=" + string(lds_headers.getitemnumber(ll_counter, "headercode")), 1, gds_reoprtheaderinfo.rowcount())
		if ll_found > 0 then
			ldc_headerno.setitem(ll_counter, "headeralias", gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks"))
		end if
	next
	this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
	this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
	if gl_sitecode > 0 and gc_dropbox = "Y" then
		this.id_master.object.sitecode.initial = trim(string(gl_sitecode))
		this.id_master.object.targetsitecode.visible = true
		this.id_master.object.t_targetsitecode.visible = true
	else
		this.id_master.object.targetsitecode.visible = false
		this.id_master.object.t_targetsitecode.visible = false
	end if
	if f_stringpreferences("alternatecustomicodeinpr") = "N" then
		this.id_detail.object.alternatecustomicode.visible = false
	end if
	if f_stringpreferences("purbatch") = "N" and this.ib_openpurreturn <> true then
		this.id_detail.object.batch.visible = false
	end if
	if f_stringpreferences("bonusinpurchase") = "N" then
		this.id_detail.object.bonusqty.visible = false
	end if
	if f_stringpreferences("showexpiryinpr") = "N" then
		this.id_detail.object.expiry.visible = false
	end if
	if f_stringpreferences("showpurchasebatchinpr") = "N" then
		this.id_detail.object.historicalbatch.visible = false
	end if
	if f_stringpreferences("showpackqtyinpr") = "N" then
		this.id_detail.object.temp_packqty.visible = false
	end if
	if f_stringpreferences("packingdescinpurchasereturn") = "N" then
		this.id_detail.object.packingdesc.visible = false
	end if
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = false
	this.id_itemslist.object.sstock.visible = false
	this.id_itemslist.object.t_pstock.visible = true
	this.id_itemslist.object.pstock.visible = true
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	if f_stringpreferences("PurRetItemDescription") = "N" then
		this.id_detail.object.itemdescription.visible = false
	end if
	if f_stringpreferences("DisplayTotalPiecesInPurchaseReturn") = "N" then
		this.id_detail.object.piecesinhand.visible = false
		this.id_detail.object.totalpieces.visible = false
		this.id_detail.object.totalpieces.initial = "0"
		this.id_detail.object.totalpieces.validation = "Real (GetText()) >= 0"
	end if
	if f_stringpreferences("ShowPackCapacityInSale") = "N" then
		this.id_detail.object.packcapacity.visible = false
	end if
	if f_stringpreferences("ShowAreaVolumeInSale") = "N" then
		this.id_detail.object.areavolume.visible = false
	end if
	if f_stringpreferences("ShowPackCoverageInSale") = "N" then
		this.id_detail.object.c_packcoverage.visible = false
	end if
	if f_stringpreferences("ShowPCSInSale") = "N" then
		this.id_detail.object.pcs.visible = false
	end if
	if f_stringpreferences("ShowCartonsInSale") = "N" then
		this.id_detail.object.cartons.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.pstock.visible = false
	end if
	if f_stringpreferences("showpuritemunittax") = "N" then
		this.id_detail.object.unitsalestax.visible = false
		this.id_detail.object.taxperunit_t.visible = false
		this.id_detail.object.c_sumtaxval.visible = false
		this.id_detail.object.c_taxval.visible = false
		this.id_detail.object.taxval_t.visible = false
	end if
	if f_stringpreferences("showpuritemgstperc") = "N" then
		this.id_detail.object.gstperc.visible = false
		this.id_detail.object.gstperc_t.visible = false
		this.id_detail.object.c_sumgstval.visible = false
		this.id_detail.object.c_gstval.visible = false
		this.id_detail.object.gstval_t.visible = false
	end if
	if f_stringpreferences("showpurinvgstperc") = "N" then
		this.id_footer.object.invgstperc1.visible = false
		this.id_footer.object.invgstperc1_t.visible = false
	end if
	if not f_rightexists(5283) then
		this.id_footer.object.discperc.visible = false
		this.id_footer.object.discperc_t.visible = false
	end if
	if not f_rightexists(5284) then
		this.id_footer.object.flatdisc.visible = false
		this.id_footer.object.flatdisc_t.visible = false
	end if
	if not f_rightexists(5285) then
		this.id_footer.object.misccharges.visible = false
		this.id_footer.object.misccharges_t.visible = false
	end if
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	if f_stringpreferences("ShowAccountForinPurchaseReturn") = "Y" then
		this.id_master.object.accountfor.visible = true
		this.id_master.object.t_accountfor.visible = true
	else
		this.id_master.object.accountfor.visible = false
		this.id_master.object.t_accountfor.visible = false
	end if
	if f_stringpreferences("PurchaseReturnAccountFor") = "Y" then
		this.id_master.object.accountfor.initial = "Y"
	else
		this.id_master.object.accountfor.initial = "N"
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5155", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_purchasefromcustomer.visible = true
		lm_menu.m_file.m_purchasefromcustomer.enabled = true
	else
		lm_menu.m_file.m_purchasefromcustomer.visible = false
		lm_menu.m_file.m_purchasefromcustomer.enabled = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 568", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_showinvoicelist = true
	else
		this.ib_showinvoicelist = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 697", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.date.protect = 0
		this.id_master.object.date.background.color = rgb(255, 255, 255)
		this.ib_modifydate = true
		lm_menu.m_file.m_setserverdate.visible = true
		lm_menu.m_file.m_setserverdate.enabled = true
	end if
	if not this.ib_modifydate then
		this.id_master.object.date.protect = 1
		this.id_master.settaborder("date", 0)
		lm_menu.m_file.m_setserverdate.visible = false
		lm_menu.m_file.m_setserverdate.enabled = false
	end if
	if not f_rightexists(5272) then
		lm_menu.m_file.m_pushprtodropbox.enabled = false
		lm_menu.m_file.m_pushprtodropbox.visible = false
		this.id_list.object.pushed.visible = false
		this.id_list.object.pushedon.visible = false
		this.id_list.object.pushedby.visible = false
		this.id_list.object.pushedfor.visible = false
	end if
	f_setcolumnstyle(this.id_detail, "Qty")
	wf_set_itemtotal_formatmask()
	setredraw(true)

// w_purchasereturn.ue_settitle() returns 0
	datawindowchild ldc_headerno
	long ll_counter
	long ll_retcode
	string ls_title
	call super::ue_settitle
	ll_retcode = this.id_master.getchild("headerno", ldc_headerno)
	if ll_retcode = 1 then
		for ll_counter = 1 to ldc_headerno.rowcount()
			if isnull(trim(ldc_headerno.getitemstring(ll_counter, "headeralias"))) then
				ls_title = ls_title + ""
			else
				ls_title = ls_title + "," + trim(ldc_headerno.getitemstring(ll_counter, "headeralias"))
			end if
		next
	else
		ls_title = ""
	end if
	this.title = this.title + "(" + ls_title + ")"

// dw_purretinvrep.printstart(long pagesmax) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::printstart(pagesmax)
	if gs_company = "SA" then
		parent.id_print.object.t_10.visible = 0
		parent.id_print.object.bonusqty.visible = 0
		parent.id_print.object.c_companyname.expression = "f_reportheaderinfosale('clientname',3)"
		parent.id_print.object.c_address1.expression = "f_reportheaderinfosale('address1',3)"
		parent.id_print.object.c_address2.expression = "f_reportheaderinfosale('address2',3)"
		parent.id_print.object.c_phone.expression = "f_reportheaderinfosale('phone',3)"
		parent.id_print.object.c_fax.expression = "'Fax : '+f_reportheaderinfosale('fax',3)"
	end if
	return ::message.returnvalue
