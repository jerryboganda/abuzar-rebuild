		ls_report = "d_pp_prinvreport"
	elseif gs_company = "PM" then
		ls_report = "d_pm_prinvreport"
	elseif gs_company = "PIC" then
		ls_report = "d_pic_prinvreport"
	elseif gs_company = "SIDDIQUECORPRTN" then
		ls_report = "d_siddiquecorprtn_prinvreport"
	elseif gs_company = "MUSHTAQPHARMACY" then
		ls_report = "d_mushtaqpharmacy_prinvreport"
	elseif gs_company = "HAMMASPHARMA" then
		ls_report = "d_hammaspharma_prinvreport"
	elseif gs_company = "AHMEDBROTHERS" then
		ls_report = "d_ahmedbrothers_prinvreport"
	elseif gs_company = "MUSLIMPHARMACY" then
		ls_report = "d_muslimpharmacy_prinvreport"
	elseif gs_company = "HDPHARMALITE" then
		ls_report = "d_hdpharmalite_prinvreport"
	elseif gs_company = "WELCOMEMS" then
		ls_report = "d_welcomems_prinvreport"
	elseif gs_company = "DAWNAUTOS" or gs_company = "LALAGAUTOS" then
		ls_report = "d_dawnautos_prinvreport"
