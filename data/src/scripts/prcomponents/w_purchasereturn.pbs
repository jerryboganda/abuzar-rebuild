		ll_row = this.id_master.getrow()
		this.id_master.object.purcatcode[ll_row] = ll_purcatcode
		this.id_master.object.purdate[ll_row] = ld_pidate
		this.id_master.object.suppcode[ll_row] = al_suppcode
	end if
	return this.it_transobject.sqlcode

