// window w_purchasereturn (prcomponents)  ancestor: w_multi_entry

// w_purchasereturn.ue_accepttext() returns 0
	if this.id_detail.accepttext() = -1 then
		this.id_detail.setfocus()
	end if

// w_purchasereturn.wf_validaterow() returns integer
	long ll_gcode
	long ll_icode
	string ls_batch
	string ls_errortext
	date ld_expiry
	integer li_errcode
	integer li_errorcode
	double ld_areavolume
	double ld_packcapacity
	double ld_qty
	integer li_null
	string ls_null
	datetime ldt_null
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	ll_gcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	ld_qty = this.id_detail.getitemnumber(this.il_currrow, "looseqty")
	ls_batch = this.id_detail.getitemstring(this.il_currrow, "batch")
	ld_expiry = date(this.id_detail.getitemdatetime(this.il_currrow, "expiry"))
	if wf_checkitemstock(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_qty, ls_errortext, li_errorcode) = 0 then
		li_errcode = -1
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		setnull(ldt_null)
		this.id_detail.scrolltorow(this.il_currrow)
		if li_errorcode = 1 then
			this.id_detail.object.batch[this.il_currrow] = ls_null
			this.id_detail.object.expiry[this.il_currrow] = ldt_null
			this.id_detail.setcolumn(this.is_columnitemname)
		else
			this.id_detail.object.looseqty[this.il_currrow] = 1
			this.id_detail.setcolumn("looseqty")
		end if
		messagebox("Item Validation", ls_errortext)
	end if
	if li_errcode >= 0 then
		ld_areavolume = this.id_detail.object.areavolume[this.il_currrow]
		if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
			ld_areavolume = 1
		end if
		ld_packcapacity = this.id_detail.object.packcapacity[this.il_currrow]
		if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
			ld_packcapacity = 1
		end if
		this.id_detail.setitem(this.il_currrow, "pcs", round(ld_qty / ld_areavolume, 6))
		this.id_detail.setitem(this.il_currrow, "cartons", trim(string(long(this.id_detail.object.pcs[this.il_currrow] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[this.il_currrow] mod ld_packcapacity, 2))))))
	end if
	return li_errcode

// w_purchasereturn.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)

// w_purchasereturn.wf_checkitemstock(long al_gcode, long al_icode, string as_batch, date ad_expiry, long al_qty, string as_errortext, integer ai_errorcode) returns integer
	datastore lds_itemstockinfo
	long ll_counter
	long ll_qty
	long ll_detailrowcount
	long ll_gcode
	integer li_errcode
	string ls_batch
	date ld_expiry
	lds_itemstockinfo = create datastore
	lds_itemstockinfo.dataobject = "d_itemstockinfo"
	lds_itemstockinfo.settransobject(this.it_transobject)
	lds_itemstockinfo.retrieve(al_gcode, al_icode)
	for ll_counter = 1 to lds_itemstockinfo.rowcount()
		ll_qty = lds_itemstockinfo.getitemnumber(ll_counter, "currqty")
		ls_batch = lds_itemstockinfo.getitemstring(ll_counter, "batch")
		ld_expiry = date(lds_itemstockinfo.getitemdatetime(ll_counter, "expiry"))
		if lower(trim(ls_batch)) = lower(trim(as_batch)) then
			if ld_expiry = ad_expiry then
				if ll_qty >= al_qty then
					li_errcode = 1
					return li_errcode
				else
					as_errortext = "Quantity is greater than Stock, Stock is " + string(ll_qty)
					li_errcode = 0
					ai_errorcode = 2
					exit
				end if
			else
				as_errortext = "Stock is zero for this Batch and Expiry"
				ai_errorcode = 1
				li_errcode = 0
			end if
		else
			as_errortext = "Stock is zero for this Batch and Expiry"
			li_errcode = 0
			ai_errorcode = 1
		end if
	next
	destroy lds_itemstockinfo
	return li_errcode

// w_purchasereturn.wf_deleteprinvoice(long al_prinvcode) returns integer
	SQL Delete prdetail Where prdetail.prInvCode =:al_prinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_purchasereturn.wf_editpurchaseinvoice() returns integer
	long ll_rowcount
	long ll_counter
	long ll_purinvcode
	long ll_rowscopy
	long ll_returneditems
	long ll_erroritems
	long ll_zerostockitems
	string ls_fullcode
	string ls_batch
	string ls_errtext
	integer li_errcode
	if this.tab_retrieve.selectedtab = 2 then
		return 0
	end if
	if this.id_master.object.posted[1] = "Y" then
		return 0
	end if
	if wf_iseditable() = false then
		return 0
	end if
	ll_purinvcode = this.id_master.object.purinvcode[this.id_master.getrow()]
	this.id_detail.reset()
	this.ib_itemvalidated = true
	this.id_detail.insertrow(0)
	ll_rowcount = this.idc_itemdddw.rowcount()
	ll_rowscopy = 1
	for ll_counter = 1 to ll_rowcount
		li_errcode = wf_inititeminfo(this.idc_itemdddw, ll_purinvcode, ll_counter, ll_rowscopy, ls_errtext)
		if li_errcode = 1 then
			ll_returneditems = ll_returneditems + 1
		elseif li_errcode = -1 then
			ll_erroritems = ll_erroritems + 1
		else
			ll_rowscopy = ll_rowscopy + 1
			this.id_detail.insertrow(0)
		end if
	next
	this.id_detail.deleterow(ll_rowscopy)
	messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowscopy) + " records were retrieved successfully~n~r" + string(ll_returneditems) + " records has already been returned~n~r" + string(ll_erroritems) + " records are in error")
	if ll_rowscopy > 0 then
		wf_setfooterinfo(ll_purinvcode)
		this.id_detail.scrolltorow(0)
		this.id_detail.setcolumn(1)
		this.id_detail.setfocus()
		this.im_menu.m_file.m_save.enabled = true
		wf_grandtotal()
	end if
	this.id_detail.setredraw(true)
	return ll_rowscopy

// w_purchasereturn.wf_finditem(long al_icode) returns boolean
	long ll_foundrow
	boolean retflag
	ll_foundrow = this.idc_itemdddw.find("icode =long('" + string(al_icode) + "')", 1, this.idc_itemdddw.rowcount())
	if ll_foundrow < 0 then
		messagebox("Find", "Find Fail")
		retflag = false
	elseif ll_foundrow = 0 then
		retflag = false
	end if
	return retflag

// w_purchasereturn.wf_findnormalpurinvoice(long al_purinvcode, datetime ad_date) returns boolean
	boolean lb_rtflag
	integer li_code
	SQL SELECT PurLedger.date INTO :ad_date FROM PurLedger WHERE PurLedger.Purinvcode =:al_purinvcode AND PurLedger.Posted ='Y' AND ( PurLedger.PurCatCode =1 OR PurLedger.PurCatCode =2 ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		lb_rtflag = true
	end if
	return lb_rtflag

// w_purchasereturn.wf_findopenpurinvoice(long al_purinvcode, datetime ad_date) returns boolean
	boolean lb_rtflag
	integer li_code
	SQL SELECT PurLedger.date INTO :ad_date FROM PurLedger WHERE PurLedger.Purinvcode =:al_purinvcode AND PurLedger.Posted ='Y' AND PurLedger.PurCatCode =3 USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		lb_rtflag = true
	end if
	return lb_rtflag

// w_purchasereturn.wf_findunpostedpurret(long al_purinvcode, string as_errtext) returns integer
	integer li_rtcode
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM prledger WHERE prledger.purinvcode =:al_purinvcode AND prledger.posted ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_count > 0 then
			li_rtcode = 1
			as_errtext = "Some Unposted Purchase Return invoice already exist,~n~rModify that invoice"
		end if
	else
		li_rtcode = 1
		as_errtext = "Database Error, Some database request fails"
	end if
	return li_rtcode

// w_purchasereturn.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_purchasereturn.wf_iteminfo(long al_icode, double ad_purprice, double ad_discperc, double ad_avgprice, double ad_saleprice) returns boolean
	boolean retflag
	SQL SELECT item.purprice , item.purdiscperc , item.avgprice , item.saleprice INTO :ad_purprice, :ad_discperc, :ad_avgprice, :ad_saleprice FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if isnull(ad_purprice) then
		ad_purprice = 0
	elseif isnull(ad_discperc) then
		ad_discperc = 0
	elseif isnull(ad_avgprice) then
		ad_avgprice = 0
	elseif isnull(ad_saleprice) then
		ad_saleprice = 0
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_purchasereturn.wf_lockprinvoices(long al_sinvcode, long al_linvcode, integer ai_prcatcode1, integer ai_prcatcode2) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From prledger WITH ( UPDLOCK HOLDLOCK ) Where prledger.prinvcode Between :al_sinvcode AND :al_linvcode AND ( prledger.prcatcode =:ai_prcatcode1 OR prledger.prcatcode =:ai_prcatcode2 ) AND prledger.Posted ='N' USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_purchasereturn.wf_lockpurinvoice(long al_purinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From Purledger WITH ( UPDLOCK HOLDLOCK ) Where purledger.purinvcode =:al_purinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_purchasereturn.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_counter step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_purchasereturn.wf_releaselock(long al_icode) returns boolean
	boolean retflag
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM godowndetail WITH ( NOLOCK ) WHERE godowndetail.Gcode =:this.ii_godown AND godowndetail.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_purchasereturn.wf_validatefullcode(string as_fullcode, long al_currrow) returns integer
	return 0

// w_purchasereturn.wf_setfooterinfo(long al_purinvcode) returns 0
	double ld_discperc
	double ld_flatdisc
	double ld_misccharges
	SQL SELECT purledger.discperc , purledger.flatdisc , purledger.misccharges INTO :ld_discperc, :ld_flatdisc, :ld_misccharges FROM purledger WHERE purledger.purinvcode =:al_purinvcode USING sqlca;
	this.id_footer.setitem(1, "discperc", ld_discperc)
	this.id_footer.setitem(1, "flatdisc", ld_flatdisc)
	this.id_footer.setitem(1, "misccharges", ld_misccharges)

// w_purchasereturn.wf_setiteminfo(long al_icode, long al_row, long al_gcode, long al_qty, double ad_purprice, double ad_discperc, long al_purqty, long al_prevretqty, long al_stock) returns 0
	this.id_detail.setitem(al_row, "gcode", al_gcode)
	this.id_detail.setitem(al_row, "looseqty", al_qty)
	this.id_detail.setitem(al_row, "prprice", ad_purprice)
	this.id_detail.setitem(al_row, "discperc", ad_discperc)
	this.id_footer.object.purqty[this.id_footer.getrow()] = al_purqty
	this.id_footer.object.prevretqty[this.id_footer.getrow()] = al_prevretqty
	this.id_footer.object.stock[this.id_footer.getrow()] = al_stock

// w_purchasereturn.wf_setiteminfobatch(long al_icode, long al_row, long al_gcode, long al_looseqty, long al_bonusqty, long al_packunits, double ad_purprice, double ad_discperc, long al_purlooseqty, long al_purbonusqty, long al_prevretlooseqty, long al_prevretbonusqty, long al_stock, string as_batch, datetime ad_expiry) returns 0
	this.id_detail.setitem(al_row, "gcode", al_gcode)
	this.id_detail.setitem(al_row, "batch", as_batch)
	this.id_detail.setitem(al_row, "expiry", ad_expiry)
	this.id_detail.setitem(al_row, "looseqty", al_looseqty)
	this.id_detail.setitem(al_row, "bonusqty", al_bonusqty)
	this.id_detail.setitem(al_row, "packunits", al_packunits)
	this.id_detail.setitem(al_row, "prprice", ad_purprice)
	this.id_detail.setitem(al_row, "discperc", ad_discperc)
	this.id_footer.object.purlooseqty[this.id_footer.getrow()] = al_purlooseqty
	this.id_footer.object.purbonusqty[this.id_footer.getrow()] = al_purbonusqty
	this.id_footer.object.prevretlooseqty[this.id_footer.getrow()] = al_prevretlooseqty
	this.id_footer.object.prevretbonusqty[this.id_footer.getrow()] = al_prevretbonusqty
	this.id_footer.object.stock[this.id_footer.getrow()] = al_stock

// w_purchasereturn.wf_setpurinvinfo(long al_purinvcode, long al_suppcode) returns long
	long ll_picode
	long ll_purcatcode
	long ll_row
	datetime ld_pidate
	SQL SELECT purledger.suppcode , purledger.purcatcode , purledger.date INTO :al_suppcode, :ll_purcatcode, :ld_pidate FROM purledger WHERE purledger.purinvcode =:al_purinvcode USING this.it_transobject;
