// w_purchasereturn.wf_lockprinvoice(long al_prinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From prledger WITH ( UPDLOCK HOLDLOCK ) Where prledger.prinvcode =:al_prinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_purchasereturn.wf_initmodify(integer ai_protect, string as_errtext) returns 0
	long ll_purinvcode
	long ll_piecesinhand
	long ll_totalpieces
	long ll_prinvcode
	long ll_gcode
	long ll_icode
	long ll_counter
	long ll_packunits
	long ll_dddwrowcount
	long ll_foundrow
	string ls_batch
	datetime ld_expiry
	double ld_purprice
	integer li_errcode
	double ld_looseqty
	double ld_stock
	double ld_packqty
	double ld_bonusqty
	double ld_itemprevlooseqty
	double ld_itemprevbonusqty
	double ld_itempurlooseqty
	double ld_itempurbonusqty
	double ld_itempurqty
	double ld_retablelooseqty
	double ld_retablebonusqty
	double ld_retableqty
	if this.id_master.getitemstring(1, "posted") = "N" then
		this.id_master.setitem(1, "sitecode", gl_sitecode)
		ll_prinvcode = this.id_detail.getitemnumber(1, "code")
		if wf_lockprinvoice(ll_prinvcode) = 0 then
			this.id_master.retrieve(ll_prinvcode)
			this.id_detail.retrieve(ll_prinvcode)
			if not this.ib_openpurreturn then
				ll_purinvcode = this.id_master.getitemnumber(1, "purinvcode")
				if wf_lockpurinvoice(ll_purinvcode) = 0 then
					ll_dddwrowcount = this.idc_itemdddw.rowcount()
				else
					ai_protect = 1
				end if
			end if
			for ll_counter = 1 to this.id_detail.rowcount()
				ll_gcode = this.id_detail.getitemnumber(ll_counter, "gcode")
				ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
				ls_batch = this.id_detail.getitemstring(ll_counter, "batch")
				ld_expiry = this.id_detail.getitemdatetime(ll_counter, "expiry")
				ld_looseqty = this.id_detail.getitemnumber(ll_counter, "looseqty")
				ld_packqty = this.id_detail.getitemnumber(ll_counter, "packqty")
				ld_bonusqty = this.id_detail.getitemnumber(ll_counter, "bonusqty")
				ll_packunits = this.id_detail.getitemnumber(ll_counter, "packunits")
				ll_piecesinhand = this.id_detail.getitemnumber(ll_counter, "piecesinhand")
				ll_totalpieces = this.id_detail.getitemnumber(ll_counter, "totalpieces")
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					if not this.ib_openpurreturn then
						if wf_itemprevretqty(ll_purinvcode, ll_icode, ls_batch, ld_expiry, ld_itemprevlooseqty, ld_itemprevbonusqty) then
							ll_foundrow = this.ids_purinvdetail.find("icode" + " = long('" + string(ll_icode) + "') and " + "batch" + " = '" + ls_batch + "' and " + "expiry" + " = DateTime('" + string(ld_expiry) + "')", 1, this.ids_purinvdetail.rowcount())
							choose case this.ii_purrettype
							case 1
								ld_itempurlooseqty = this.ids_purinvdetail.object.packqty[ll_foundrow] * this.ids_purinvdetail.object.packunits[ll_foundrow]
								ld_itempurbonusqty = this.ids_purinvdetail.object.bonusqty[ll_foundrow] * this.ids_purinvdetail.object.packunits[ll_foundrow]
								ld_purprice = this.ids_purinvdetail.object.purprice[ll_foundrow] / this.ids_purinvdetail.object.packunits[ll_foundrow]
							case else
								ld_itempurlooseqty = this.ids_purinvdetail.object.looseqty[ll_foundrow]
								ld_itempurbonusqty = this.ids_purinvdetail.object.bonusqty[ll_foundrow]
								ld_purprice = this.ids_purinvdetail.object.purprice[ll_foundrow]
							end choose
							ld_itempurqty = ld_itempurlooseqty + ld_itempurbonusqty
							ld_retablelooseqty = ld_itempurlooseqty - ld_itemprevlooseqty
							ld_retablebonusqty = ld_itempurbonusqty - ld_itemprevbonusqty
							ld_retableqty = ld_retablelooseqty + ld_retablebonusqty
							if this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock) = 0 then
								ld_stock = ld_stock + ld_looseqty + ld_bonusqty
								if ld_stock > 0.0 then
									this.id_detail.setitem(ll_counter, "retablelooseqty", ld_retablelooseqty)
									this.id_detail.setitem(ll_counter, "retablebonusqty", ld_retablebonusqty)
									this.id_detail.setitem(ll_counter, "prevretbonusqty", ld_itemprevbonusqty)
									this.id_detail.setitem(ll_counter, "prevretlooseqty", ld_itemprevlooseqty)
									this.id_detail.setitem(ll_counter, "stock", ld_stock)
									this.id_footer.object.piecesinhand[1] = ll_piecesinhand
									this.id_footer.object.stock[1] = ld_stock
									this.id_footer.object.purlooseqty[1] = ld_itempurlooseqty
									this.id_footer.object.purbonusqty[1] = ld_itempurbonusqty
									this.id_footer.object.prevretlooseqty[1] = ld_itemprevlooseqty
									this.id_footer.object.prevretbonusqty[1] = ld_itemprevbonusqty
								else
									as_errtext = "Item can not be returned , its Stock is Zero"
									li_errcode = -1
								end if
							else
								as_errtext = "Can not retrieve item stock information"
								li_errcode = -1
							end if
						else
							as_errtext = "item qty has already been returned"
							li_errcode = -1
						end if
					else
						this.idc_itemdddw.retrieve(ll_gcode, ll_icode)
						if this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock) = 0 then
							ld_stock = ld_stock + ld_looseqty + ld_bonusqty
							if this.it_transobject.sqlcode = 0 then
								this.id_detail.setitem(ll_counter, "stock", ld_stock)
								this.id_footer.object.stock[1] = ld_stock
							end if
						else
							as_errtext = "Can not retrieve item stock information"
							li_errcode = -1
						end if
					end if
				else
					as_errtext = "Can not retrieve item stock information"
					li_errcode = -1
				end if
			next
			if ai_protect = 0 then
				this.ib_modify = true
				this.id_footer.setitem(1, "stock", this.id_footer.getitemnumber(1, "stock"))
				this.id_footer.setitem(1, "piecesinhand", this.id_footer.getitemnumber(1, "piecesinhand"))
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
		end if
		return
	end if
	ai_protect = 1

// w_purchasereturn.wf_post() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_prinvcount
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			choose case this.ii_purrettype
			case 1
				li_errcode = wf_lockprinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2, 4, 5)
				if li_errcode = 0 then
					this.it_transobject.postprledger(lstr_arginfo.l_code1, lstr_arginfo.l_code2, 4, 5, ll_salesmancode)
				end if
			case else
				li_errcode = wf_lockprinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2, 6, 0)
				if li_errcode = 0 then
					this.it_transobject.postprledger(lstr_arginfo.l_code1, lstr_arginfo.l_code2, 6, 0, ll_salesmancode)
				end if
			end choose
			if this.it_transobject.sqlcode <> 0 then
				li_errcode = -1
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if li_errcode <> 0 then
		messagebox("Posting Fails", "Some database request fails, Please try again")
	else
		messagebox("Posting Successfull", "All rows have been posted successfully.")
	end if
	return li_errcode

// w_purchasereturn.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_invgstperc1
	double ld_itemleveltax
	double ld_totalsalestax
	double ld_invgstpercval
	real lr_discperc
	real lr_flatdisc
	real lr_misccharges
	real lr_salestax
	real lr_itemstotal
	integer li_roundupto
	li_roundupto = f_numberpreferences("roundpurinvon")
	if isnull(li_roundupto) or li_roundupto < 0 then
		li_roundupto = 0
	end if
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		lr_discperc = this.id_footer.object.discperc[1]
		lr_flatdisc = this.id_footer.object.flatdisc[1]
		lr_misccharges = this.id_footer.object.misccharges[1]
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "d_detaildwtotal")
		ld_invgstperc1 = this.id_footer.object.invgstperc1[1]
		ld_itemleveltax = round(this.id_detail.getitemnumber(1, "c_sumgstval"), 2) + round(this.id_detail.getitemnumber(1, "c_sumtaxval"), 2)
		ld_invgstpercval = round((round(ld_detaildwtotal * (1.0 - lr_discperc * 0.01), 2) - lr_flatdisc) * 0.01 * ld_invgstperc1, 2)
		ld_totalsalestax = round(ld_invgstpercval + ld_itemleveltax, li_roundupto)
		ld_grandtotal = ld_detaildwtotal * (1.0 - lr_discperc * 0.01) + lr_misccharges - lr_flatdisc + lr_salestax
		ld_grandtotal = round(ld_grandtotal, li_roundupto) + ld_totalsalestax
		this.id_footer.setitem(1, "total", ld_grandtotal)
		ld_detaildwtotal = this.id_footer.getitemnumber(1, "total")
	end if
	return ld_grandtotal

// w_purchasereturn.wf_populateprdetail(long al_invid, datawindow ad_prinvdetail, string as_errortext, integer ai_errorrow) returns integer
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	long ll_counter
	long ll_detailrows
	long ll_icode
	long ll_gcode
	long ll_purinvcode
	long ll_packingunits
	long ll_totalpieces
	long ll_piecesinhand
	boolean lb_commitflag
	string ls_batch
	string ls_cartons
	string ls_historicalbatch
	datetime ld_expiry
	double ld_discperc
	double ld_prprice
	double ld_netpurretcost
	double ld_itempurretcost
	double ld_avgprice
	double ld_totalstock
	double ld_newstocktotal
	double ld_newavgprice
	double ld_netavgpurcost
	double ld_invdiscperc
	double ld_saleprice
	double ld_packcapacity
	double ld_areavolume
	double ld_pcs
	integer li_rtncode
	double ld_packqty
	double ld_looseqty
	double ld_bonusqty
	double ld_prqty
	double ld_prbonusqty
	double ld_retableqty
	double ld_retablelooseqty
	double ld_stock
	double ld_newstock
	datawindowchild ldc_godown
	datawindowchild ldc_itemdddw
	datawindowchild ldc_historicalbatch
	ld_netpurretcost = 0.0
	li_rtncode = ad_prinvdetail.getchild("gcode", ldc_godown)
	if li_rtncode = -1 then
		messagebox("Error in wf_populateprdetail", "Can not get a DataWindowChild for godown")
		as_errortext = "Unable to fetch godown informtion in wf_populateprdetail"
		return -1
	end if
	ldc_godown.settransobject(this.it_transobject)
	li_rtncode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	li_rtncode = ad_prinvdetail.getchild("batch", ldc_itemdddw)
	if li_rtncode = -1 then
		messagebox("Error in wf_populateprdetail", "Can not get a DataWindowChild for batch")
		as_errortext = "Unable to fetch batch informtion in wf_populateprdetail"
		return -1
	end if
	ldc_itemdddw.settransobject(this.it_transobject)
	ldc_itemdddw.insertrow(0)
	li_rtncode = ad_prinvdetail.getchild("historicalbatch", ldc_historicalbatch)
	if li_rtncode = -1 then
		messagebox("Error in wf_populateprdetail", "Can not get a DataWindowChild for batch")
		as_errortext = "Unable to fetch batch informtion in wf_populateprdetail"
		return -1
	end if
	ldc_historicalbatch.settransobject(this.it_transobject)
	ldc_historicalbatch.insertrow(0)
	SQL rollback USING sqlca;
	ul_rowcount = this.id_detail.rowcount()
	sqlca.getmaxutn(ul_rowcount, ul_maxutn)
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
	else
		SQL rollback USING sqlca;
		messagebox("Saving", "Error in generating Utn")
		return -1
	end if
	ll_detailrows = this.id_detail.rowcount()
	ll_counter = 1
	do while ll_counter <= ll_detailrows and lb_commitflag = true
		ad_prinvdetail.insertrow(0)
		ad_prinvdetail.object.code[ll_counter] = al_invid
		ad_prinvdetail.object.icode[ll_counter] = this.id_detail.object.icode[ll_counter]
		ad_prinvdetail.object.fullcode[ll_counter] = this.id_detail.object.fullcode[ll_counter]
		ad_prinvdetail.object.alternatecustomicode[ll_counter] = this.id_detail.object.alternatecustomicode[ll_counter]
		ad_prinvdetail.object.itemname[ll_counter] = this.id_detail.object.itemname[ll_counter]
		ad_prinvdetail.object.gcode[ll_counter] = this.id_detail.object.gcode[ll_counter]
		ad_prinvdetail.object.batch[ll_counter] = this.id_detail.object.batch[ll_counter]
		ad_prinvdetail.object.historicalbatch[ll_counter] = this.id_detail.object.historicalbatch[ll_counter]
		ad_prinvdetail.object.expiry[ll_counter] = this.id_detail.object.expiry[ll_counter]
		ad_prinvdetail.object.looseqty[ll_counter] = this.id_detail.object.looseqty[ll_counter]
		ad_prinvdetail.object.bonusqty[ll_counter] = this.id_detail.object.bonusqty[ll_counter]
		ad_prinvdetail.object.packunits[ll_counter] = this.id_detail.object.packunits[ll_counter]
		ad_prinvdetail.object.prprice[ll_counter] = this.id_detail.object.prprice[ll_counter]
		ad_prinvdetail.object.unitsalestax[ll_counter] = this.id_detail.object.unitsalestax[ll_counter]
		ad_prinvdetail.object.gstperc[ll_counter] = this.id_detail.object.gstperc[ll_counter]
		ad_prinvdetail.object.discperc[ll_counter] = this.id_detail.object.discperc[ll_counter]
		ad_prinvdetail.object.itemdescription[ll_counter] = this.id_detail.object.itemdescription[ll_counter]
		ad_prinvdetail.object.totalpieces[ll_counter] = this.id_detail.object.totalpieces[ll_counter]
		ad_prinvdetail.object.piecesinhand[ll_counter] = this.id_detail.object.piecesinhand[ll_counter]
		ad_prinvdetail.object.packcapacity[ll_counter] = this.id_detail.object.packcapacity[ll_counter]
		ad_prinvdetail.object.areavolume[ll_counter] = this.id_detail.object.areavolume[ll_counter]
		ad_prinvdetail.object.pcs[ll_counter] = this.id_detail.object.pcs[ll_counter]
		ad_prinvdetail.object.cartons[ll_counter] = this.id_detail.object.cartons[ll_counter]
		ad_prinvdetail.setitem(ll_counter, "PrUtn", ul_maxutn)
		ul_maxutn = ul_maxutn + 1
		ll_icode = ad_prinvdetail.object.icode[ll_counter]
		ll_gcode = ad_prinvdetail.object.gcode[ll_counter]
		ls_batch = ad_prinvdetail.object.batch[ll_counter]
		ls_historicalbatch = ad_prinvdetail.object.historicalbatch[ll_counter]
		ld_expiry = ad_prinvdetail.object.expiry[ll_counter]
		ld_packqty = ad_prinvdetail.object.packqty[ll_counter]
		ld_looseqty = ad_prinvdetail.object.looseqty[ll_counter]
		ld_bonusqty = ad_prinvdetail.object.bonusqty[ll_counter]
		ll_packingunits = ad_prinvdetail.object.packunits[ll_counter]
		ld_discperc = ad_prinvdetail.object.discperc[ll_counter]
		ll_totalpieces = ad_prinvdetail.object.totalpieces[ll_counter]
		ll_piecesinhand = ad_prinvdetail.object.piecesinhand[ll_counter]
		ld_packcapacity = ad_prinvdetail.object.packcapacity[ll_counter]
		ld_areavolume = ad_prinvdetail.object.areavolume[ll_counter]
		ld_pcs = ad_prinvdetail.object.pcs[ll_counter]
		ls_cartons = ad_prinvdetail.object.cartons[ll_counter]
		ld_prprice = ad_prinvdetail.object.prprice[ll_counter]
		ld_prqty = ld_looseqty
		ld_prbonusqty = ld_bonusqty
		ld_itempurretcost = ld_prqty * ld_prprice * (1.0 - ld_discperc * 0.01) * (1.0 - ld_invdiscperc * 0.01)
		ld_netpurretcost = ld_netpurretcost + ld_itempurretcost
		this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			SQL Select saleprice INTO :ld_saleprice FROM Item WHERE Item.icode =:ll_icode USING this.it_transobject;
			ad_prinvdetail.object.packsaleprice[ll_counter] = ld_saleprice
			ad_prinvdetail.object.avgprice[ll_counter] = ld_avgprice
			ld_netavgpurcost = ld_netavgpurcost + ld_avgprice * ld_prqty
			this.it_transobject.getitemstockall(ll_icode, ld_totalstock)
			if this.it_transobject.sqlcode <> 0 then
				ld_totalstock = 0
			end if
			ad_prinvdetail.object.balancestock[ll_counter] = ld_totalstock - ld_looseqty - ld_bonusqty
			this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
			if this.it_transobject.sqlcode = 0 then
				if ld_stock = 0.0 then
					ad_prinvdetail.object.avgprice[ll_counter] = ld_prprice
				else
					ad_prinvdetail.object.avgprice[ll_counter] = ld_avgprice
				end if
				ll_purinvcode = this.id_master.object.purinvcode[1]
				if this.ib_openpurreturn then
					ld_retableqty = ld_stock
					ld_retablelooseqty = ld_stock
				end if
				ld_newstock = ld_stock - ld_prqty - ld_prbonusqty
				ld_newstocktotal = ld_totalstock - ld_prqty - ld_prbonusqty
				if f_stringpreferences("pr_updateavgprice") = "Y" then
					if ld_newstocktotal = 0.0 then
						ld_newstocktotal = 1
					end if
					ld_newavgprice = (ld_totalstock * ld_avgprice - ld_itempurretcost) / ld_newstocktotal
					ad_prinvdetail.object.avgprice[ll_counter] = ld_newavgprice
				else
					ld_newavgprice = ld_avgprice
				end if
				if this.ib_openpurreturn then
					if ld_prqty <= ld_retablelooseqty then
						this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
						if this.it_transobject.sqlcode = 0 then
							if ld_stock >= ld_prqty + ld_prbonusqty then
								ld_newstock = ld_stock - ld_prqty - ld_prbonusqty
								if ld_newstock > 0.0 then
									this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
									if this.it_transobject.sqlcode = 0 then
										this.it_transobject.updateitemavgprice(ll_icode, ld_newavgprice)
										if this.it_transobject.sqlcode <> 0 then
											lb_commitflag = false
										end if
									else
										lb_commitflag = false
										as_errortext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
										ai_errorrow = ll_counter
									end if
								else
									this.it_transobject.deleteitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
									if this.it_transobject.sqlcode <> 0 then
										lb_commitflag = false
										as_errortext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
										ai_errorrow = ll_counter
									end if
								end if
							else
								lb_commitflag = false
								ai_errorrow = ll_counter
								as_errortext = "Stock quantity (" + string(ld_stock) + ") is less than returned quantity (" + string(ld_prqty + ld_prbonusqty) + ") "
								as_errortext = as_errortext + "~r~nPossible suggestions are decrease the returned quantity"
								as_errortext = as_errortext + "~r~nOr~r~nSelect some other batch of the selected godown"
								as_errortext = as_errortext + "~r~nOr~r~nSelect some other godown in which enough stock exists."
							end if
						else
							as_errortext = "Batch Wise Stock Fetch Error:~r~n" + this.it_transobject.sqlerrtext
							ai_errorrow = ll_counter
							lb_commitflag = false
						end if
					else
						ad_prinvdetail.setitem(ll_counter, "stock", ld_retableqty)
						as_errortext = "Stock quantity (" + string(ld_retableqty) + ") is less than returned quantity (" + string(ld_prqty + ld_prbonusqty) + ") "
						as_errortext = as_errortext + "~r~nPossible suggestions are decrease the returned quantity"
						as_errortext = as_errortext + "~r~nOr~r~nSelect some other batch of the selected godown"
						as_errortext = as_errortext + "~r~nOr~r~nSelect some other godown in which enough stock exists."
						ai_errorrow = ll_counter
						lb_commitflag = false
					end if
				end if
			else
				as_errortext = "Stock does not exist for item"
				ai_errorrow = ll_counter
				lb_commitflag = false
			end if
			if lb_commitflag then
				this.it_transobject.getitemtotalpiecesinhand(ll_icode, ll_piecesinhand)
				if this.it_transobject.sqlcode <> 0 then
					lb_commitflag = false
				else
					this.id_detail.setitem(ll_counter, "piecesinhand", ll_piecesinhand)
					if ll_piecesinhand >= ll_totalpieces then
						this.it_transobject.updateitemtotalpiecesinhand(ll_icode, -1, ll_totalpieces)
						if this.it_transobject.sqlcode <> 0 then
							lb_commitflag = false
						end if
					end if
				end if
			end if
		end if
		ll_counter = ll_counter + 1
	loop
	if lb_commitflag = true then
		return 1
	end if
	return -1

// w_purchasereturn.wf_returnprinvoice(long al_invcode, string as_errtext) returns boolean
	integer li_errcode
	long ll_prinvcode
	long ll_detailrows
	long ll_invid
	long ll_icode
	long ll_gcode
	long ll_errrowid
	long ll_totalpieces
	long ll_piecesinhand
	long ll_retcode
	string ls_batch
	datetime ld_expiry
	double ld_avgprice
	double ld_newavgprice
	double ld_itempurretcost
	double ld_prprice
	double ld_prqty
	double ld_discperc
	double ld_invdiscperc
	double ld_totalstock
	double ld_totalnewstock
	integer li_detailcounter
	integer li_purchasecategory
	boolean lb_commitflag
	integer li_rtncode
	double ld_stock
	double ld_newstock
	double ld_purqty
	double ld_purbonusqty
	double ld_packqty
	double ld_bonusqty
	double ld_looseqty
	datawindowchild ldc_godown
	datawindowchild ldc_itemdddw
	as_errtext = "Some database problem occur during updation of stock on this purchase return"
	li_rtncode = this.id_prinvdetail.getchild("gcode", ldc_godown)
	if li_rtncode = -1 then
		messagebox("Error in wf_returnprinvoice", "Can not get a DataWindowChild for godown")
		as_errtext = "Unable to fetch godown informtion in wf_returnprinvoice"
		return false
	end if
	ldc_godown.settransobject(this.it_transobject)
	li_rtncode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	li_rtncode = this.id_prinvdetail.getchild("batch", ldc_itemdddw)
	if li_rtncode = -1 then
		messagebox("Error in wf_returnprinvoice", "Can not get a DataWindowChild for batch")
		as_errtext = "Unable to fetch batch informtion in wf_returnprinvoice"
		return false
	end if
	ldc_itemdddw.settransobject(this.it_transobject)
	ll_retcode = ldc_itemdddw.insertrow(0)
	ll_retcode = this.id_prinvdetail.retrieve(al_invcode)
	SQL SELECT DiscPerc INTO :ld_invdiscperc FROM PrLedger WHERE PrInvCode =:al_invcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ld_invdiscperc) or ld_invdiscperc < 0.0 then
			ld_invdiscperc = 0
		end if
	else
		ld_invdiscperc = 0
	end if
	ll_detailrows = this.id_prinvdetail.rowcount()
	li_detailcounter = 1
	do while li_detailcounter <= ll_detailrows and lb_commitflag
		ll_icode = this.id_prinvdetail.object.icode[li_detailcounter]
		ll_gcode = this.id_prinvdetail.object.gcode[li_detailcounter]
		ls_batch = this.id_prinvdetail.object.batch[li_detailcounter]
		ld_expiry = this.id_prinvdetail.object.expiry[li_detailcounter]
		ld_packqty = this.id_prinvdetail.object.packqty[li_detailcounter]
		ld_looseqty = this.id_prinvdetail.object.looseqty[li_detailcounter]
		ld_bonusqty = this.id_prinvdetail.object.bonusqty[li_detailcounter]
		ll_totalpieces = this.id_prinvdetail.object.totalpieces[li_detailcounter]
		ll_piecesinhand = this.id_prinvdetail.object.piecesinhand[li_detailcounter]
		ld_prprice = this.id_prinvdetail.object.prprice[li_detailcounter]
		ld_discperc = this.id_prinvdetail.object.discperc[li_detailcounter]
		ld_prqty = ld_packqty + ld_looseqty
		ld_itempurretcost = ld_prqty * ld_prprice * (1.0 - ld_discperc * 0.01) * (1.0 - ld_invdiscperc * 0.01)
		ld_purqty = ld_looseqty
		ld_purbonusqty = ld_bonusqty
		this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			this.it_transobject.getitemstockall(ll_icode, ld_totalstock)
			if this.it_transobject.sqlcode <> 0 then
				ld_totalstock = 0
			end if
			this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
			if this.it_transobject.sqlcode = 0 then
				ld_newstock = ld_stock + ld_prqty + ld_bonusqty
				ld_totalnewstock = ld_totalstock + ld_prqty + ld_bonusqty
				if f_stringpreferences("pr_updateavgprice") = "Y" then
					ld_newavgprice = (ld_totalstock * ld_avgprice + ld_itempurretcost) / ld_totalnewstock
					this.it_transobject.updateitemavgprice(ll_icode, ld_newavgprice)
				else
					ld_newavgprice = ld_avgprice
				end if
				this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
				if this.it_transobject.sqlcode <> 0 then
					lb_commitflag = false
					as_errtext = "Stock Updation Error In Purchase Return Modification:~r~n" + this.it_transobject.sqlerrtext
				end if
			else
				lb_commitflag = false
				as_errtext = "Batch Wise Stock Fetch Error In Purchase Return Modification:~r~n" + this.it_transobject.sqlerrtext
			end if
			if lb_commitflag then
				this.it_transobject.updateitemtotalpiecesinhand(ll_icode, 1, ll_totalpieces)
				if this.it_transobject.sqlcode <> 0 then
					lb_commitflag = false
				end if
			end if
		else
			lb_commitflag = false
			as_errtext = "Unable to lock item for purchase return modification."
		end if
		li_detailcounter = li_detailcounter + 1
	loop
	if lb_commitflag and wf_deleteprinvoice(al_invcode) <> 0 then
		lb_commitflag = false
		as_errtext = "Some database problem occur in deletion of purchase return ~r~n durig modification of purchase return invoice."
	end if
	return lb_commitflag

// w_purchasereturn.wf_copyinvoice() returns integer
	datastore lds_purreturntemplatedetail
	datastore lds_header
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrows
	integer li_retcode
	integer li_errcode
	integer li_looseqty
	integer li_counter
	integer ll_found
	integer ll_innercounter
	integer li_holdqty
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	boolean lb_packpurchase
	datawindowchild ldc_godown
	if this.tab_retrieve.selectedtab = 2 then
		return 0
	end if
	if this.id_master.object.posted[1] = "Y" then
		return 0
	end if
	if wf_iseditable() = false then
		return 0
	end if
	open(w_copypurreturninvoicefrom)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		return -1
	end if
	lds_purreturntemplatedetail = create datastore
	lds_header = create datastore
	if lstr_template.c_copyinvfrom = "P" then
		if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
			lb_packpurchase = true
			lds_header.dataobject = "d_normalpurchaseheader"
			lds_purreturntemplatedetail.dataobject = "d_normalpurchasedetail"
		else
			lds_header.dataobject = "d_loosepurchaseheader"
			lds_purreturntemplatedetail.dataobject = "d_loosepurchasedetail"
		end if
		lds_header.settransobject(this.it_transobject)
		lds_purreturntemplatedetail.settransobject(this.it_transobject)
		lds_header.retrieve(lstr_template.l_invtemplate)
		if lds_header.rowcount() > 0 then
			this.id_master.object.suppcode[1] = lds_header.object.suppcode[1]
			this.id_master.object.remarks[1] = lds_header.object.remarks[1]
			this.id_master.object.purinvcode[1] = lds_header.object.code[1]
			this.id_master.object.discperc[1] = lds_header.object.discperc[1]
			this.id_master.object.flatdisc[1] = lds_header.object.flatdisc[1]
			this.id_master.object.invgstperc1[1] = lds_header.object.invgstperc1[1]
			this.id_master.object.misccharges[1] = lds_header.object.misccharges[1]
			this.id_footer.object.discperc[1] = lds_header.object.discperc[1]
			this.id_footer.object.flatdisc[1] = lds_header.object.flatdisc[1]
			this.id_footer.object.invgstperc1[1] = lds_header.object.invgstperc1[1]
			this.id_footer.object.misccharges[1] = lds_header.object.misccharges[1]
		end if
		li_retcode = lds_purreturntemplatedetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		ll_totalrows = lds_purreturntemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_detailrows = lds_purreturntemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to li_counter
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "batch", lds_purreturntemplatedetail.getitemstring(ll_rowcount, "batch"))
			this.id_detail.setitem(ll_rowcount, "expiry", lds_purreturntemplatedetail.getitemdatetime(ll_rowcount, "expiry"))
			this.id_detail.setitem(ll_rowcount, "gcode", lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "gcode"))
			this.id_detail.setitem(ll_rowcount, "discperc", lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "discperc"))
			this.id_detail.setitem(ll_rowcount, "itemdescription", lds_purreturntemplatedetail.getitemstring(ll_rowcount, "itemdescription"))
			if lb_packpurchase then
				if lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "packunits") > 0.0 then
					this.id_detail.setitem(ll_rowcount, "prprice", round(lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "purprice") / lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "packunits"), 2))
				else
					this.id_detail.setitem(ll_rowcount, "prprice", lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "purprice"))
				end if
				this.id_detail.setitem(ll_rowcount, "bonusqty", lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "bonusqty") * lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "packunits"))
				this.id_detail.setitem(ll_rowcount, "looseqty", lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "packqty") * lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "packunits"))
				if lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "packunits") > 0.0 then
					this.id_detail.setitem(ll_rowcount, "unitsalestax", round(lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "unitsalestax") / lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "packunits"), 2))
				else
					this.id_detail.setitem(ll_rowcount, "unitsalestax", round(lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "unitsalestax"), 2))
				end if
			else
				this.id_detail.setitem(ll_rowcount, "prprice", lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "purprice"))
				this.id_detail.setitem(ll_rowcount, "looseqty", lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "looseqty"))
				this.id_detail.setitem(ll_rowcount, "bonusqty", lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "bonusqty"))
				this.id_detail.setitem(ll_rowcount, "unitsalestax", lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "unitsalestax"))
			end if
			this.id_detail.setitem(ll_rowcount, "gstperc", lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "gstperc"))
		next
	elseif lstr_template.c_copyinvfrom = "R" then
		lds_purreturntemplatedetail.dataobject = "d_OpenWholeSaleReturnDetail"
		lds_purreturntemplatedetail.settransobject(this.it_transobject)
		li_retcode = lds_purreturntemplatedetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		ll_totalrows = lds_purreturntemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_purreturntemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to li_counter
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "looseqty"))
			this.id_detail.setitem(ll_rowcount, "batch", lds_purreturntemplatedetail.getitemstring(ll_rowcount, "batch"))
			this.id_detail.setitem(ll_rowcount, "expiry", lds_purreturntemplatedetail.getitemdatetime(ll_rowcount, "expiry"))
			this.id_detail.setitem(ll_rowcount, "gcode", lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "gcode"))
			this.id_detail.setitem(ll_rowcount, "bonusqty", lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "bonusqty"))
		next
	elseif lstr_template.c_copyinvfrom = "E" then
		lds_header.dataobject = "d_expiryintimation_header"
		lds_header.settransobject(this.it_transobject)
		lds_header.retrieve(lstr_template.l_invtemplate)
		if lds_header.rowcount() > 0 then
			this.id_master.object.suppcode[1] = lds_header.object.acccode[1]
			this.id_master.object.remarks[1] = lds_header.object.remarks1[1]
		end if
		lds_purreturntemplatedetail.dataobject = "d_expiryintimation_detail"
		lds_purreturntemplatedetail.settransobject(this.it_transobject)
		ll_totalrows = lds_purreturntemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_purreturntemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to li_counter
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "qty"))
			this.id_detail.setitem(ll_rowcount, "batch", lds_purreturntemplatedetail.getitemstring(ll_rowcount, "batch"))
			this.id_detail.setitem(ll_rowcount, "expiry", lds_purreturntemplatedetail.getitemdatetime(ll_rowcount, "expiry"))
		next
	elseif lstr_template.c_copyinvfrom = "N" then
		lds_purreturntemplatedetail.dataobject = "d_transfer_detail"
		lds_purreturntemplatedetail.settransobject(this.it_transobject)
		ll_totalrows = lds_purreturntemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_purreturntemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to li_counter
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "gcode", lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "dgcode"))
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_purreturntemplatedetail.getitemnumber(ll_rowcount, "qty"))
			this.id_detail.setitem(ll_rowcount, "batch", lds_purreturntemplatedetail.getitemstring(ll_rowcount, "batch"))
			this.id_detail.setitem(ll_rowcount, "expiry", lds_purreturntemplatedetail.getitemdatetime(ll_rowcount, "expiry"))
		next
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	destroy lds_purreturntemplatedetail
	destroy lds_header
	return li_retcode

// w_purchasereturn.wf_validatebatch(long al_icode, string as_batch, integer ai_gcode, datetime adt_expiry) returns long
	string ls_batch
	SQL SELECT batch INTO :ls_batch FROM GodownDetail WHERE ICode =:al_icode AND GCode =:ai_gcode AND Batch =:as_batch AND Expiry =:adt_expiry USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_purchasereturn.wf_validateitem() returns integer
	long ll_icode
	long ll_dddwrow
	long ll_gcode
	string ls_titleerrtext
	string ls_errtext
	string ls_null
	integer li_errcode
	integer li_assgcode
	integer li_null
	if not this.ib_openpurreturn then
		ll_dddwrow = this.idc_itemdddw.getrow()
		if wf_inititeminfo(this.idc_itemdddw, this.il_currrow, ll_dddwrow, ls_errtext) <= 0 then
			ls_titleerrtext = "Item Validation"
			li_errcode = -1
		end if
	else
		ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
		ll_gcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
		if wf_inititeminfo(ll_icode, this.il_currrow, ls_errtext) then
			if this.ib_openpurreturn then
				this.idc_itemdddw.reset()
				setnull(ls_null)
				this.id_detail.object.batch[this.il_currrow] = ls_null
				if this.idc_itemdddw.retrieve(ll_gcode, ll_icode) <= 0 and (this.il_godowncount > 1 and this.il_strategy = 1) then
					setnull(li_null)
					this.id_detail.setcolumn("gcode")
					this.id_detail.object.gcode[this.il_currrow] = li_null
					this.id_footer.object.stock[this.id_footer.getrow()] = 0
					return 1
				end if
			else
				this.idc_itemdddw.reset()
			end if
		else
			ls_titleerrtext = "Item Validation"
			li_errcode = -1
		end if
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		if this.ib_openpurreturn then
			this.id_detail.setcolumn(this.is_columnitemname)
		else
			this.id_detail.setcolumn("icode")
		end if
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		messagebox(ls_titleerrtext, ls_errtext)
	end if
	return li_errcode

// w_purchasereturn.wf_isinvoiceinuse(long al_invoiceno) returns boolean
	long ll_found
	SQL Select count ( *) INTO :ll_found From PRLedger Where PRInvCode =:al_invoiceno AND Posted ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_found = 0 or isnull(ll_found) then
			SQL Select count ( *) INTO :ll_found From PRLedger With ( ReadPast , RowLock , UpdLock ) Where PRInvCode =:al_invoiceno USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ll_found = 0 then
					return true
				else
					return false
				end if
			else
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_purchasereturn.wf_retrievelist() returns long
	long ll_rtcode
	string[] ls_posted
	ls_posted[1] = "N"
	if this.ib_showinvoicelist then
		ll_rtcode = this.id_list.retrieve(ls_posted, this.il_groupcode, this.ii_module)
	else
		ll_rtcode = -1
	end if
	return ll_rtcode

// w_purchasereturn.wf_inititeminfo(datawindowchild adc_itemdddw, long al_row, long al_dddwrow, string as_errtext) returns integer
	long ll_icode
	long ll_gcode
	long ll_purinvcode
	long ll_foundrow
	long ll_itemdddwrow
	long ll_piecesinhand
	long ll_totalpieces
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packcapacity
	double ld_areavolume
	string ls_fullcode
	string ls_batch
	integer li_errcode
	datetime ld_expiry
	long ll_packunits
	double ld_itempurqty
	double ld_stock
	double ld_itemprevqty
	double ld_itempurlooseqty
	double ld_itempurbonusqty
	double ld_retableqty
	double ld_qty
	double ld_itemprevlooseqty
	double ld_itemprevbonusqty
	double ld_retablelooseqty
	double ld_retablebonusqty
	ll_purinvcode = this.id_master.getitemnumber(this.id_master.getrow(), "purinvcode")
	ll_gcode = this.idc_itemdddw.getitemnumber(al_dddwrow, "gcode")
	ll_icode = this.idc_itemdddw.getitemnumber(al_dddwrow, "icode")
	ls_fullcode = this.idc_itemdddw.getitemstring(al_dddwrow, "fullcode")
	ls_batch = this.idc_itemdddw.getitemstring(al_dddwrow, "batch")
	ld_expiry = this.idc_itemdddw.getitemdatetime(al_dddwrow, "Expiry")
	ld_purprice = this.idc_itemdddw.getitemnumber(al_dddwrow, "purprice")
	ld_discperc = this.idc_itemdddw.getitemnumber(al_dddwrow, "discperc")
	ll_packunits = this.idc_itemdddw.getitemnumber(al_dddwrow, "packunits")
	ll_piecesinhand = this.idc_itemdddw.getitemnumber(al_dddwrow, "piecesinhand")
	ll_totalpieces = this.idc_itemdddw.getitemnumber(al_dddwrow, "totalpieces")
	SQL SELECT packcapacity , areavolume INTO :ld_packcapacity, :ld_areavolume FROM Item WHERE ICode =:ll_icode USING this.it_transobject;
	if wf_itemprevretqty(ll_purinvcode, ll_icode, ls_batch, ld_expiry, ld_itemprevlooseqty, ld_itemprevbonusqty) then
		ll_foundrow = this.ids_purinvdetail.find("icode" + " = long('" + string(ll_icode) + "') and " + "batch" + " = '" + ls_batch + "' and " + "expiry" + " = DateTime('" + string(ld_expiry) + "')", 1, this.ids_purinvdetail.rowcount())
		choose case this.ii_purrettype
		case 1
			ld_itempurlooseqty = this.ids_purinvdetail.object.packqty[ll_foundrow] * this.ids_purinvdetail.object.packunits[ll_foundrow]
			ld_itempurbonusqty = this.ids_purinvdetail.object.bonusqty[ll_foundrow] * this.ids_purinvdetail.object.packunits[ll_foundrow]
			ld_purprice = this.ids_purinvdetail.object.purprice[ll_foundrow] / this.ids_purinvdetail.object.packunits[ll_foundrow]
		case else
			ld_itempurlooseqty = this.ids_purinvdetail.object.looseqty[ll_foundrow]
			ld_itempurbonusqty = this.ids_purinvdetail.object.bonusqty[ll_foundrow]
			ld_purprice = this.ids_purinvdetail.object.purprice[ll_foundrow]
		end choose
		ld_itempurqty = ld_itempurlooseqty + ld_itempurbonusqty
		ld_retablelooseqty = ld_itempurlooseqty - ld_itemprevlooseqty
		ld_retablebonusqty = ld_itempurbonusqty - ld_itemprevbonusqty
		ld_retableqty = ld_retablelooseqty + ld_retablebonusqty
		if ld_retableqty > 0.0 then
			if this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock) = 0 then
				if ld_stock > 0.0 then
					this.id_detail.setitem(al_row, "gcode", ll_gcode)
					this.id_detail.setitem(al_row, "icode", ll_icode)
					this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
					this.id_detail.setitem(al_row, "batch", ls_batch)
					this.id_detail.setitem(al_row, "expiry", ld_expiry)
					this.id_detail.setitem(al_row, "prprice", ld_purprice)
					this.id_detail.setitem(al_row, "discperc", ld_discperc)
					this.id_detail.setitem(al_row, "packunits", ll_packunits)
					this.id_detail.setitem(al_row, "looseqty", ld_retablelooseqty)
					this.id_detail.setitem(al_row, "bonusqty", ld_retablebonusqty)
					this.id_detail.setitem(al_row, "retablelooseqty", ld_retablelooseqty)
					this.id_detail.setitem(al_row, "retablebonusqty", ld_retablebonusqty)
					this.id_detail.setitem(al_row, "prevretbonusqty", ld_itemprevbonusqty)
					this.id_detail.setitem(al_row, "prevretlooseqty", ld_itemprevlooseqty)
					this.id_detail.setitem(al_row, "totalpieces", ll_totalpieces)
					this.id_detail.setitem(al_row, "piecesinhand", ll_piecesinhand)
					if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
						ld_areavolume = 1
					end if
					if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
						ld_packcapacity = 1
					end if
					this.id_detail.setitem(al_row, "packcapacity", ld_packcapacity)
					this.id_detail.setitem(al_row, "areavolume", ld_areavolume)
					this.id_detail.setitem(al_row, "pcs", round(this.id_detail.object.looseqty[al_row] / ld_areavolume, 6))
					this.id_detail.setitem(al_row, "cartons", trim(string(long(this.id_detail.object.pcs[al_row] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[al_row] mod ld_packcapacity, 2))))))
					this.id_detail.setitem(al_row, "stock", ld_stock)
					this.id_footer.object.piecesinhand[1] = ll_piecesinhand
					this.id_footer.object.stock[1] = ld_stock
					this.id_footer.object.purlooseqty[1] = ld_itempurlooseqty
					this.id_footer.object.purbonusqty[1] = ld_itempurbonusqty
					this.id_footer.object.prevretlooseqty[1] = ld_itemprevlooseqty
					this.id_footer.object.prevretbonusqty[1] = ld_itemprevbonusqty
				else
					as_errtext = "Item can not be returned , its Stock is Zero"
					li_errcode = -1
				end if
			else
				as_errtext = "Can not retrieve item stock information"
				li_errcode = -1
			end if
		else
			as_errtext = "item qty has already been returned"
			li_errcode = -1
		end if
	else
		li_errcode = -1
		as_errtext = "Purcahse invoice information can not retrieve"
	end if
	return li_errcode

// w_purchasereturn.wf_inititeminfo(datawindowchild adc_itemdddw, long al_purinvcode, long al_dsrow, long al_detaildwrow, string as_errtext) returns integer
	long ll_icode
	long ll_gcode
	long ll_purinvcode
	long ll_foundrow
	long ll_itemdddwrow
	long ll_totalpieces
	long ll_piecesinhand
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packcapacity
	double ld_areavolume
	string ls_fullcode
	string ls_batch
	integer li_errcode
	datetime ld_expiry
	long ll_packunits
	double ld_stock
	double ld_itempurqty
	double ld_itemprevqty
	double ld_itempurlooseqty
	double ld_itempurbonusqty
	double ld_retableqty
	double ld_qty
	double ld_itemprevlooseqty
	double ld_itemprevbonusqty
	double ld_retablelooseqty
	double ld_retablebonusqty
	ll_gcode = this.idc_itemdddw.getitemnumber(al_dsrow, "gcode")
	ll_icode = this.idc_itemdddw.getitemnumber(al_dsrow, "icode")
	ls_fullcode = this.idc_itemdddw.getitemstring(al_dsrow, "fullcode")
	ls_batch = this.idc_itemdddw.getitemstring(al_dsrow, "batch")
	ld_expiry = this.idc_itemdddw.getitemdatetime(al_dsrow, "Expiry")
	ld_purprice = this.idc_itemdddw.getitemnumber(al_dsrow, "purprice")
	ld_discperc = this.idc_itemdddw.getitemnumber(al_dsrow, "discperc")
	ll_packunits = this.idc_itemdddw.getitemnumber(al_dsrow, "packunits")
	ll_totalpieces = this.idc_itemdddw.getitemnumber(al_dsrow, "totalpieces")
	ll_piecesinhand = this.idc_itemdddw.getitemnumber(al_dsrow, "piecesinhand")
	SQL SELECT PackCapacity , AreaVolume INTO :ld_packcapacity, :ld_areavolume FROM Item WHERE ICode =:ll_icode USING this.it_transobject;
	if wf_itemprevretqty(ll_purinvcode, ll_icode, ls_batch, ld_expiry, ld_itemprevlooseqty, ld_itemprevbonusqty) then
		ll_foundrow = this.ids_purinvdetail.find("icode" + " = long('" + string(ll_icode) + "') and " + "batch" + " = '" + ls_batch + "' and " + "expiry" + " = DateTime('" + string(ld_expiry) + "')", 1, this.ids_purinvdetail.rowcount())
		choose case this.ii_purrettype
		case 1
			ld_itempurlooseqty = this.ids_purinvdetail.object.packqty[ll_foundrow] * this.ids_purinvdetail.object.packunits[ll_foundrow]
			ld_itempurbonusqty = this.ids_purinvdetail.object.bonusqty[ll_foundrow] * this.ids_purinvdetail.object.packunits[ll_foundrow]
			ld_purprice = this.ids_purinvdetail.object.purprice[ll_foundrow] / this.ids_purinvdetail.object.packunits[ll_foundrow]
		case else
			ld_itempurlooseqty = this.ids_purinvdetail.object.looseqty[ll_foundrow]
			ld_itempurbonusqty = this.ids_purinvdetail.object.bonusqty[ll_foundrow]
			ld_purprice = this.ids_purinvdetail.object.purprice[ll_foundrow]
		end choose
		ld_itempurqty = ld_itempurlooseqty + ld_itempurbonusqty
		ld_retablelooseqty = ld_itempurlooseqty - ld_itemprevlooseqty
		ld_retablebonusqty = ld_itempurbonusqty - ld_itemprevbonusqty
		ld_retableqty = ld_retablelooseqty + ld_retablebonusqty
		if ld_retableqty > 0.0 then
			if this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock) = 0 then
				if ld_stock > 0.0 then
					this.id_detail.setitem(al_detaildwrow, "gcode", ll_gcode)
					this.id_detail.setitem(al_detaildwrow, "icode", ll_icode)
					this.id_detail.setitem(al_detaildwrow, "fullcode", ls_fullcode)
					this.id_detail.setitem(al_detaildwrow, "batch", ls_batch)
					this.id_detail.setitem(al_detaildwrow, "expiry", ld_expiry)
					this.id_detail.setitem(al_detaildwrow, "prprice", ld_purprice)
					this.id_detail.setitem(al_detaildwrow, "discperc", ld_discperc)
					this.id_detail.setitem(al_detaildwrow, "packunits", ll_packunits)
					this.id_detail.setitem(al_detaildwrow, "totalpieces", ll_totalpieces)
					this.id_detail.setitem(al_detaildwrow, "piecesinhand", ll_piecesinhand)
					this.id_detail.setitem(al_detaildwrow, "looseqty", ld_retablelooseqty)
					this.id_detail.setitem(al_detaildwrow, "bonusqty", ld_retablebonusqty)
					this.id_detail.setitem(al_detaildwrow, "retablelooseqty", ld_retablelooseqty)
					this.id_detail.setitem(al_detaildwrow, "retablebonusqty", ld_retablebonusqty)
					this.id_detail.setitem(al_detaildwrow, "prevretbonusqty", ld_itemprevbonusqty)
					this.id_detail.setitem(al_detaildwrow, "prevretlooseqty", ld_itemprevlooseqty)
					if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
						ld_areavolume = 1
					end if
					if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
						ld_packcapacity = 1
					end if
					this.id_detail.setitem(al_detaildwrow, "packcapacity", ld_packcapacity)
					this.id_detail.setitem(al_detaildwrow, "areavolume", ld_areavolume)
					this.id_detail.setitem(al_detaildwrow, "pcs", round(this.id_detail.object.looseqty[al_detaildwrow] / ld_areavolume, 6))
					this.id_detail.setitem(al_detaildwrow, "cartons", trim(string(long(this.id_detail.object.pcs[al_detaildwrow] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[al_detaildwrow] mod ld_packcapacity, 2))))))
					this.id_detail.setitem(al_detaildwrow, "stock", ld_stock)
					this.id_footer.object.piecesinhand[1] = ll_piecesinhand
					this.id_footer.object.stock[1] = ld_stock
					this.id_footer.object.purlooseqty[1] = ld_itempurlooseqty
					this.id_footer.object.purbonusqty[1] = ld_itempurbonusqty
					this.id_footer.object.prevretlooseqty[1] = ld_itemprevlooseqty
					this.id_footer.object.prevretbonusqty[1] = ld_itemprevbonusqty
				else
					as_errtext = "Item can not be returned , its Stock is Zero"
					li_errcode = -1
				end if
			else
				as_errtext = "Can not retrieve item stock information"
				li_errcode = -1
			end if
		else
			as_errtext = "item qty has already been returned"
			li_errcode = -1
		end if
	else
		li_errcode = -1
		as_errtext = "Purcahse invoice information can not retrieve"
	end if
	return li_errcode

// w_purchasereturn.wf_inititeminfo(long al_icode, long al_row, string as_errortext) returns boolean
	boolean retflag
	double ld_purprice
	double ld_discperc
	double ld_saleprice
	double ld_gstperc1
	double ld_unitsalestax
	double ld_avgprice
	double ld_rpp
	double ld_rpp2
	double ld_rpp3
	double ld_rpp4
	double ld_rpp5
	double ld_packsalestax
	long ll_packunits
	long ll_piecesinhand
	long ll_totalpieces
	long ll_manfcode
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_itemtotalval
	string ls_packingdesc
	string ls_remarks
	string ls_alternatecustomicode
	string ls_null
	double ld_godownstock
	double ld_allgodownstock
	double ld_packcapacity
	double ld_areavolume
	setnull(ls_null)
	li_gcode = this.ii_godown
	SQL SELECT item.customicode , item.name , item.purprice , item.packunits , item.gcode , item.purdiscperc , item.saleprice , item.avgprice , item.packsalestax , round ( item.packsalestax / item.packunits , 2 ) , item.gstperc1 , item.recentpurprice , Round ( item.packsalestax / item.packunits , 2 ) , item.recentpurprice2 , recentpurprice3 , recentpurprice4 , recentpurprice5 , packingdesc , item.totalpieces , item.remarks , item.packcapacity , item.areavolume , item.manfcode INTO :ls_fullcode, :ls_name, :ld_purprice, :ll_packunits, :li_gcode, :ld_discperc, :ld_saleprice, :ld_avgprice, :ld_packsalestax, :ld_unitsalestax, :ld_gstperc1, :ld_rpp, :ld_unitsalestax, :ld_rpp2, :ld_rpp3, :ld_rpp4, :ld_rpp5, :ls_packingdesc, :ll_piecesinhand, :ls_remarks, :ld_packcapacity, :ld_areavolume, :ll_manfcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
	elseif this.il_strategy = 2 then
		li_gcode = li_gcode
	elseif this.il_strategy = 1 then
		li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
	end if
	ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
	this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	ls_alternatecustomicode = this.id_detail.object.alternatecustomicode[al_row]
	if isnull(ls_alternatecustomicode) then
		ls_alternatecustomicode = ""
	end if
	if lower(ls_fullcode) = lower(ls_alternatecustomicode) then
		ls_alternatecustomicode = ls_null
		this.id_detail.object.alternatecustomicode[al_row] = ls_null
	end if
	this.id_detail.setitem(al_row, "gcode", li_gcode)
	this.id_detail.setitem(al_row, "icode", al_icode)
	this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
	this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
	this.id_detail.setitem(al_row, "packunits", ll_packunits)
	this.id_detail.setitem(al_row, "piecesinhand", ll_piecesinhand)
	this.id_detail.setitem(al_row, "manfcode", ll_manfcode)
	if ll_piecesinhand = 0 then
		this.id_detail.setitem(al_row, "totalpieces", 0)
	end if
	this.id_detail.setitem(al_row, "discperc", ld_discperc)
	this.id_detail.setitem(al_row, "packingdesc", ls_packingdesc)
	this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
	this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
	if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) then
		if f_stringpreferences("SalePriceInPR") = "Y" then
			this.id_detail.setitem(al_row, "prprice", ld_saleprice / ll_packunits)
		else
			this.id_detail.setitem(al_row, "prprice", ld_purprice / ll_packunits)
		end if
	end if
	choose case this.ii_purrettype
	case 1
		if gs_company = "SHE" or gs_company = "RIZWAN" then
			this.id_detail.setitem(al_row, "prprice", ld_saleprice / ll_packunits)
		end if
	case else
		if gs_company = "SHE" or gs_company = "RIZWAN" then
			this.id_detail.setitem(al_row, "prprice", ld_saleprice / ll_packunits)
		end if
	end choose
	this.it_transobject.getitemstockinallowedgodown(al_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
	this.id_detail.setitem(al_row, "itemtotalval", ls_itemtotalval)
	this.id_detail.setitem(al_row, "stock", ld_godownstock)
	this.id_detail.setitem(al_row, "totalstock", ld_allgodownstock)
	this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice)
	if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
		ld_areavolume = 1
	end if
	if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
		ld_packcapacity = 1
	end if
	this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
	this.id_detail.setitem(al_row, "packcapacity", ld_packcapacity)
	this.id_detail.setitem(al_row, "areavolume", ld_areavolume)
	this.id_detail.setitem(al_row, "pcs", round(this.id_detail.object.looseqty[al_row] / ld_areavolume, 6))
	this.id_detail.setitem(al_row, "cartons", trim(string(long(this.id_detail.object.pcs[al_row] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[al_row] mod ld_packcapacity, 2))))))
	if f_stringpreferences("pr_copyremarksinitemdesc") = "Y" and this.id_detail.getitemstatus(al_row, "itemdescription", primary!) = notmodified! then
		this.id_detail.setitem(al_row, "itemdescription", ls_remarks)
	end if
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_allgodownstock)
	this.id_footer.setitem(1, "itemtotalval", ls_itemtotalval)
	this.id_footer.setitem(1, "piecesinhand", ll_piecesinhand)
	this.id_footer.object.t_rpp.text = string(ld_rpp) + " , " + string(ld_rpp2) + " , " + string(ld_rpp3) + " , " + string(ld_rpp4) + " , " + string(ld_rpp5)
	return retflag

// w_purchasereturn.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_purchasereturn.wf_setamountoninvoice() returns 0
	long ll_null
	long ll_rightfound
	double ld_netamt
	double ld_null
	string ls_null
	s_amountoninvoice lstr_amountoninvoice
	setnull(ld_null)
	setnull(ls_null)
	setnull(ll_null)
	if this.id_master.getitemstring(1, "accountfor") = "Y" then
		ld_netamt = wf_grandtotal()
		if f_stringpreferences("AskAmtOnPurchaseReturn") = "Y" then
			ll_rightfound = 0
			ll_rightfound = gds_securitywindow.find("rightcode = 585", 1, gds_securitywindow.rowcount())
			lstr_amountoninvoice.l_invcode = this.id_master.getitemnumber(1, "code")
			lstr_amountoninvoice.d_netamt = ld_netamt
			lstr_amountoninvoice.d_amt = this.id_master.getitemdecimal(1, "amt")
			if isnull(lstr_amountoninvoice.d_amt) then
				lstr_amountoninvoice.d_balance = ld_netamt
			else
				lstr_amountoninvoice.d_balance = ld_netamt - lstr_amountoninvoice.d_amt
			end if
			if isnull(this.id_master.getitemstring(1, "paymentmode")) then
				this.id_master.setitem(1, "paymentmode", f_stringpreferences("PurchaseReturnPaymentMode"))
				this.id_master.setitem(1, "paymentacccode", f_numberpreferences("PurchaseReturnPaymentAcccode"))
			end if
			lstr_amountoninvoice.c_paymentmode = this.id_master.getitemstring(1, "paymentmode")
			lstr_amountoninvoice.i_acccode = this.id_master.getitemnumber(1, "paymentacccode")
			lstr_amountoninvoice.s_reference = this.id_master.getitemstring(1, "amtreference")
			lstr_amountoninvoice.s_module = "purchasereturn"
			if ll_rightfound > 0 then
				openwithparm(w_amountoninvoice, lstr_amountoninvoice)
				lstr_amountoninvoice = message.powerobjectparm
				this.id_master.setitem(1, "amt", lstr_amountoninvoice.d_amt)
				this.id_master.setitem(1, "paymentmode", lstr_amountoninvoice.c_paymentmode)
				this.id_master.setitem(1, "paymentacccode", lstr_amountoninvoice.i_acccode)
				this.id_master.setitem(1, "amtreference", lstr_amountoninvoice.s_reference)
			end if
			if ld_netamt - lstr_amountoninvoice.d_amt >= 0.0 then
				this.id_master.setitem(1, "outstandingamt", ld_netamt - lstr_amountoninvoice.d_amt)
			else
				this.id_master.setitem(1, "outstandingamt", 0)
			end if
		else
			this.id_master.setitem(1, "outstandingamt", ld_netamt)
			this.id_master.setitem(1, "paymentmode", ls_null)
			this.id_master.setitem(1, "paymentacccode", ll_null)
			this.id_master.setitem(1, "amtreference", ls_null)
			this.id_master.setitem(1, "amt", 0)
		end if
		return
	end if
	this.id_master.setitem(1, "outstandingamt", 0)
	this.id_master.setitem(1, "paymentmode", ls_null)
	this.id_master.setitem(1, "paymentacccode", ll_null)
	this.id_master.setitem(1, "amtreference", ls_null)
	this.id_master.setitem(1, "amt", 0)

// w_purchasereturn.wf_allowreturnmodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM PRDetail WHERE PRInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_purchasereturn.wf_selectprintreport() returns 0
	string ls_report
	if gs_company = "CLINIXMS" or gs_company = "CLINIXSMARKET" or gs_company = "C1WAREHOUSE" then
		ls_report = "d_clinixms_prinvreport"
	elseif gs_company = "SHBASHIRSONSWH" or gs_company = "SHBASHIRSONSWH2" or gs_company = "MASOODPHARMACY3" or gs_company = "SHBASHIRSONSPH5" or gs_company = "SHBASHIRSONS17" or gs_company = "SHBASHIRSONS19" or gs_company = "SHBASHIRSONS14" or gs_company = "SHBASHIRSONSPH4" or gs_company = "SHBASHIRSONS13" or gs_company = "MASOODPHARMACY2" or gs_company = "SHBASHIRSONS18" or gs_company = "SHBASHIRSONSPH2" or gs_company = "SHBASHIRSONS12" or gs_company = "SHBASHIRSONS15" or gs_company = "SHBASHIRSONSPH9" or gs_company = "SHBASHIRSONSPH8" or gs_company = "WTPHBSP" or gs_company = "SHAMEENPHARMACY" or gs_company = "SHBASHIRSONSPH6" or gs_company = "SHBASHIRSONS16" or gs_company = "SHBASHIRSONS10" then
