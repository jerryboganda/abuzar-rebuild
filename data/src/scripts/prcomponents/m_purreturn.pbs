// menu m_purreturn (prcomponents)  ancestor: m_multi_entry

// m_purreturn.create() returns 0 [event]
	m_purreturn = this
	call super::create

// m_purreturn.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_open = create m_open
	this.m_itempurchasehistory = create m_itempurchasehistory
	this.m_editterms = create m_editterms
	this.m_populateitems = create m_populateitems
	this.m_setserverdate = create m_setserverdate
	this.m_purchasefromcustomer = create m_purchasefromcustomer
	this.m_showitemprhistory = create m_showitemprhistory
	this.m_showaccountledger = create m_showaccountledger
	this.m_pushprtodropbox = create m_pushprtodropbox
	this.item[upperbound(this.item) + 1] = this.m_open
	this.item[upperbound(this.item) + 1] = this.m_itempurchasehistory
	this.item[upperbound(this.item) + 1] = this.m_editterms
	this.item[upperbound(this.item) + 1] = this.m_populateitems
	this.item[upperbound(this.item) + 1] = this.m_setserverdate
	this.item[upperbound(this.item) + 1] = this.m_purchasefromcustomer
	this.item[upperbound(this.item) + 1] = this.m_showitemprhistory
	this.item[upperbound(this.item) + 1] = this.m_showaccountledger
	this.item[upperbound(this.item) + 1] = this.m_pushprtodropbox

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_open
	destroy this.m_itempurchasehistory
	destroy this.m_editterms
	destroy this.m_populateitems
	destroy this.m_setserverdate
	destroy this.m_purchasefromcustomer
	destroy this.m_showitemprhistory
	destroy this.m_showaccountledger
	destroy this.m_pushprtodropbox

