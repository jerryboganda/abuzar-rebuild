// window w_itemprhistory (prcomponents)  ancestor: window

// w_itemprhistory.create() returns 0
	this.dw_itempurchasehistory = create dw_itempurchasehistory
	this.control = {this.dw_itempurchasehistory}

// w_itemprhistory.destroy() returns 0
	destroy this.dw_itempurchasehistory

// w_itemprhistory.open() returns long
	s_itempurchasehistory ls_itempurchasehistory
	long ll_width
	long ll_height
	long ll_found
	environment env
	ls_itempurchasehistory = message.powerobjectparm
	if getenvironment(env) <> 1 then
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.width = ll_width * 0.98
	this.height = ll_height * 0.45
	this.y = int((ll_height - this.height) / 2.0)
	this.dw_itempurchasehistory.width = this.width - this.width * 0.02
	this.dw_itempurchasehistory.height = this.height - this.width * 0.05
	this.dw_itempurchasehistory.settransobject(sqlca)
	this.dw_itempurchasehistory.retrieve(ls_itempurchasehistory.ar_icode, ls_itempurchasehistory.ar_date)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_itemprhistory.close() returns long
	close(this)
	return ::message.returnvalue

// w_itemprhistory.key(keycode key, unsignedlong keyflags) returns long
	if keydown(keyescape!) then
		close(this)
	end if
	return ::message.returnvalue
