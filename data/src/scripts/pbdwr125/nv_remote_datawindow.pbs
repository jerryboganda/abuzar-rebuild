// nv_remote_datawindow.onetrip(ref string as_objectname, ref string as_browsername, ref string as_selflink, ref string as_selflinkargs, ref string as_action, ref string as_context) returns string
	string ls_result
	integer li_result
	if this.ib_trace then
		of_log_enter("OneTrip()")
	end if
	if as_objectname <> "" then
		ls_result = sethtmlobjectname(as_objectname)
	end if
	if ls_result = "" then
		ls_result = setbrowser(as_browsername)
	end if
	if ls_result = "" then
		ls_result = setselflink(as_selflink, as_selflinkargs)
	end if
	if ls_result = "" and this.ib_allowretrieve then
		li_result = retrieve()
		if li_result < 0 then
			ls_result = getlasterrorstring()
		end if
	end if
	if ls_result = "" then
		li_result = setaction(as_action, as_context)
		if li_result < 0 then
			ls_result = getlasterrorstring()
		end if
	end if
	if ls_result = "" then
		ls_result = generate()
	end if
	if this.ib_trace then
		of_log_exit("OneTrip()")
	end if
	return ls_result

