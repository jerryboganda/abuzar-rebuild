	if this.ib_trace then
		of_log_exit("GenerateXMLWeb(), length = " + string(len(ls_result)))
	end if
	of_completework()
	return ls_result

// nv_remote_datawindow.saveasex(ref string as_filename, ref string as_saveastype, ref boolean ab_colheading, ref string as_encoding) returns integer
	integer li_result
	if this.ib_trace then
		of_log_enter("SaveAsEx('" + as_filename + "', '" + as_saveastype + "', " + string(ab_colheading) + "', " + string(as_encoding) + ")")
	end if
	li_result = this.ids_datastore.saveas(as_filename, of_convertstringtosaveastype(as_saveastype), ab_colheading, of_convertstringtoencoding(as_encoding))
	if this.ib_trace then
		of_log_exit("SaveAsEx()")
	end if
	of_continuework(true)
	return li_result

// nv_remote_datawindow.of_convertstringtoencoding(ref string as_encoding) returns encoding
	encoding ret_encoding
	setnull(ret_encoding)
	choose case upper(as_encoding)
	case "ENCODINGANSI!", "ENCODINGANSI"
		ret_encoding = encodingansi!
	case "ENCODINGUTF16LE!", "ENCODINGUTF16LE"
		ret_encoding = encodingutf16le!
	case "ENCODINGUTF16BE!", "ENCODINGUTF16BE"
		ret_encoding = encodingutf16be!
	case "ENCODINGUTF8!", "ENCODINGUTF8"
		ret_encoding = encodingutf8!
	end choose
	return ret_encoding

// nv_remote_datawindow.create() returns 0 [event]
	call super::create
	triggerevent("constructor")

// nv_remote_datawindow.destroy() returns 0 [event]
	triggerevent("destructor")
	call super::destroy

// nv_remote_datawindow.constructor() returns long [event]
	contextkeyword lcx_key
	string ls_temp
	this.is_default_library_list = getlibrarylist()
	this.ids_datastore = create nv_datastore
	getcontextservice("Keyword", lcx_key)
	if isvalid(lcx_key) then
		ls_temp = of_load_property(lcx_key, this.is_prop_prefix + ".trace")
		ls_temp = upper(ls_temp)
		this.ib_trace = ls_temp = "YES" or ls_temp = "TRUE"
		ls_temp = of_load_property(lcx_key, this.is_prop_prefix + ".fixed")
		ls_temp = upper(ls_temp)
		this.ib_fixed = ls_temp = "YES" or ls_temp = "TRUE"
		ls_temp = of_load_property(lcx_key, this.is_prop_prefix + ".maintainServerSideState")
		ls_temp = upper(ls_temp)
		this.ib_serversidestate = ls_temp = "YES" or ls_temp = "TRUE"
		this.is_sourcefilename = of_load_property(lcx_key, this.is_prop_prefix + ".sourceFileName")
		this.is_dwobjectname = of_load_property(lcx_key, this.is_prop_prefix + ".dwObjectName")
		this.is_htmlobjectname = of_load_property(lcx_key, this.is_prop_prefix + ".HTMLObjectName")
		this.is_modifystring = of_load_property(lcx_key, this.is_prop_prefix + ".modifyString")
		this.is_trans_dbms = of_load_property(lcx_key, this.is_prop_prefix + ".trans.dbms")
		this.is_trans_dbparm = of_load_property(lcx_key, this.is_prop_prefix + ".trans.dbparm")
		this.is_trans_lock = of_load_property(lcx_key, this.is_prop_prefix + ".trans.lock")
		this.is_trans_logid = of_load_property(lcx_key, this.is_prop_prefix + ".trans.logid")
		this.is_trans_logpass = of_load_property(lcx_key, this.is_prop_prefix + ".trans.logpass")
		this.is_trans_database = of_load_property(lcx_key, this.is_prop_prefix + ".trans.database")
		this.is_trans_servername = of_load_property(lcx_key, this.is_prop_prefix + ".trans.servername")
		this.is_serviceclassnames = of_load_property(lcx_key, this.is_prop_prefix + ".serverServiceClasses")
	end if
	getcontextservice("ErrorLogging", this.inv_logger)
	if not isvalid(this.inv_logger) then
		this.ib_trace = false
	end if
	if this.ib_trace then
		of_log("Remote DataWindow Component logging enabled")
		of_log("Default Library List = '" + this.is_default_library_list + "'")
		of_log("Loaded component properties:")
		of_log("    sourceFileName = '" + this.is_sourcefilename + "'")
		of_log("    dwObjectName = '" + this.is_dwobjectname + "'")
		of_log("    HTMLObjectName = '" + this.is_htmlobjectname + "'")
		of_log("    modifyString = '" + this.is_modifystring + "'")
		if this.ib_fixed then
			of_log("    fixed = 'yes'")
		else
			of_log("    fixed = 'no'")
		end if
		if this.ib_serversidestate then
			of_log("    serverSideState = 'yes'")
		else
			of_log("    serverSideState = 'no'")
		end if
		of_log("    trans.dbms = '" + this.is_trans_dbms + "'")
		of_log("    trans.dbparm = '" + this.is_trans_dbparm + "'")
		of_log("    trans.lock = '" + this.is_trans_lock + "'")
		of_log("    trans.logid = '" + this.is_trans_logid + "'")
		of_log("    trans.logpass = '" + this.is_trans_logpass + "'")
		of_log("    trans.database = '" + this.is_trans_database + "'")
		of_log("    trans.servername = '" + this.is_trans_servername + "'")
		of_log("    serverServiceClasses = '" + this.is_serviceclassnames + "'")
	end if
	if this.is_sourcefilename <> "" and this.is_dwobjectname <> "" then
		setdwobject(this.is_sourcefilename, this.is_dwobjectname)
	elseif this.is_dwobjectname <> "" then
		setdwobjectex(this.is_dwobjectname)
	end if
	return ::message.returnvalue

// nv_remote_datawindow.destructor() returns long [event]
	if this.ib_trace then
		of_log("Destructor()")
	end if
	return ::message.returnvalue
