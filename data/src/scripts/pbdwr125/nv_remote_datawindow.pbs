	end if
	if not this.ib_fixed then
		ls_error = this.ids_datastore.modify(as_modifysyntax)
	else
		ls_error = "Component has been marked as fixed.  Cannot call Modify()"
	end if
	if this.ib_trace then
		of_log_exit("Modify() = '" + ls_error + "'")
	end if
	of_continuework(true)
	return ls_error

// nv_remote_datawindow.of_convertdwitemstatustostring(ref dwitemstatus adwis_status) returns string
	string ls_status
	setnull(ls_status)
	choose case adwis_status
	case notmodified!
		ls_status = "NotModified!"
	case datamodified!
		ls_status = "DataModified!"
	case new!
		ls_status = "New!"
	case newmodified!
		ls_status = "NewModified!"
	end choose
	return ls_status

// nv_remote_datawindow.of_convertstringtodwitemstatus(ref string as_status) returns dwitemstatus
	dwitemstatus ldwis_status
	setnull(ldwis_status)
	choose case upper(as_status)
	case "NOTMODIFIED!", "NOTMODIFIED"
		ldwis_status = notmodified!
	case "DATAMODIFIED!", "DATAMODIFIED"
		ldwis_status = datamodified!
	case "NEW!", "NEW"
		ldwis_status = new!
	case "NEWMODIFIED", "NEWMODIFIED"
		ldwis_status = newmodified!
	end choose
	return ldwis_status

// nv_remote_datawindow.of_convertstringtodwbuffer(ref string as_dwbuffer) returns dwbuffer
	dwbuffer ldwbuf_buffer
	setnull(ldwbuf_buffer)
	choose case upper(as_dwbuffer)
	case "PRIMARY!", "PRIMARY"
		ldwbuf_buffer = primary!
	case "DELETE!", "DELETE"
		ldwbuf_buffer = delete!
	case "FILTER!", "FILTER"
		ldwbuf_buffer = filter!
	end choose
	return ldwbuf_buffer

