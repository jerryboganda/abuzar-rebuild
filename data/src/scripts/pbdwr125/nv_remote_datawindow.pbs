// userobject nv_remote_datawindow (pbdwr125)  ancestor: nonvisualobject

// nv_remote_datawindow.activate() returns long [event]
	if this.ib_trace then
		of_log("Activate()")
	end if
	this.ib_allowretrieve = true
	this.ib_didupdate = false
	this.ib_updatefailed = false
	this.ib_dwobjectset = false
	this.ib_transactionset = false
	return ::message.returnvalue

// nv_remote_datawindow.deactivate() returns long [event]
	if this.ib_trace then
		of_log_enter("Deactivate()")
	end if
	if this.ib_trace then
		of_log("resetting state")
	end if
	this.ids_datastore.reset()
	if this.ib_trace then
		of_log_exit("Deactivate()")
	end if
	return ::message.returnvalue

// nv_remote_datawindow.of_lastpos(ref string string1, ref string string2) returns long
	long ll_lastpos
	long ll_curpos
	ll_curpos = pos(string1, string2)
	do while ll_curpos <> 0
		ll_lastpos = ll_curpos
		ll_curpos = pos(string1, string2, ll_lastpos + 1)
	loop
	return ll_lastpos

// nv_remote_datawindow.of_continuework(boolean ballowcommit) returns 0
	transactionserver servercontext
	getcontextservice("TransactionServer", servercontext)
	if isvalid(servercontext) then
		if ballowcommit then
			if this.ib_trace then
				of_log("EnableCommit()")
			end if
			servercontext.enablecommit()
			return
		end if
		if this.ib_trace then
			of_log("DisableCommit()")
		end if
		servercontext.disablecommit()
	end if

// nv_remote_datawindow.of_completework() returns 0
	transactionserver servercontext
	getcontextservice("TransactionServer", servercontext)
	if isvalid(servercontext) then
		if this.ib_updatefailed then
			if this.ib_trace then
				of_log("SetAbort()")
			end if
			servercontext.setabort()
			return
		end if
		if this.ib_serversidestate and not this.ib_didupdate then
			if this.ib_trace then
				of_log("EnableCommit()")
			end if
			servercontext.enablecommit()
			return
		end if
		of_log("SetComplete()")
		servercontext.setcomplete()
	end if

// nv_remote_datawindow.settrans(ref string dbms, ref string dbparm, ref string lock, ref string logid, ref string logpass, ref string database, ref string servername) returns integer
	integer li_result
	if this.ib_trace then
		of_log_enter("SetTrans()")
	end if
	if this.ib_allowretrieve then
		if not this.ib_fixed then
			sqlca.dbms = dbms
			sqlca.dbparm = dbparm
			sqlca.lock = lock
			sqlca.logid = logid
			sqlca.logpass = logpass
			sqlca.database = database
			sqlca.servername = servername
			if this.ids_datastore.describe("datawindow.processing") = "5" then
				SQL start USING sqlca;
				if sqlca.sqlcode <> 0 then
					of_log("SetTrans: ERROR - Could not connect to db for composite processing; DBCode = " + string(sqlca.sqldbcode) + "~r~n" + sqlca.sqlerrtext)
					li_result = -1
				else
					li_result = this.ids_datastore.settransobject(sqlca)
				end if
			else
				li_result = this.ids_datastore.settrans(sqlca)
			end if
		else
			li_result = -1
		end if
	else
		li_result = 1
	end if
	if li_result = 1 then
		this.ib_transactionset = true
	end if
	if this.ib_trace then
		of_log_exit("SetTrans() = " + string(li_result))
	end if
	of_continuework(true)
	return li_result

// nv_remote_datawindow.onetripex(ref string as_objectname, ref string as_argstring, ref string as_browsername, ref string as_selflink, ref string as_selflinkargs, ref string as_action, ref string as_context) returns string
	string ls_result
	integer li_result
	if this.ib_trace then
		of_log_enter("OnTripEx()")
	end if
	ls_result = sethtmlobjectname(as_objectname)
	if ls_result = "" then
		ls_result = setbrowser(as_browsername)
	end if
	if ls_result = "" then
		ls_result = setselflink(as_selflink, as_selflinkargs)
	end if
	if ls_result = "" then
		li_result = retrieveex(as_argstring)
		if li_result < 0 then
			ls_result = getlasterrorstring()
		end if
	end if
	if ls_result = "" then
		li_result = setaction(as_action, as_context)
		if li_result < 0 then
			ls_result = getlasterrorstring()
		end if
	end if
	ls_result = generate() + ls_result
	if this.ib_trace then
		of_log_exit("OneTripEx()")
	end if
	return ls_result

// nv_remote_datawindow.generate() returns string
	string ls_result
	if this.ib_trace then
		of_log_enter("Generate()")
	end if
	ls_result = this.ids_datastore.describe("DataWindow.Data.HTML")
	if this.ib_trace then
		of_log_exit("Generate(), length = " + string(len(ls_result)))
	end if
	of_completework()
	return ls_result

// nv_remote_datawindow.of_readfile(ref string as_filename) returns string
	string ls_data
	string ls_temp
	integer li_filenum
	long ll_filelen
	long ll_numloops
	long ll_index
	ll_filelen = filelength(as_filename)
	li_filenum = fileopen(as_filename, streammode!)
	if ll_filelen > 32765 then
		if ll_filelen mod 32765 = 0 then
			ll_numloops = ll_filelen / 32765.0
		else
			ll_numloops = ll_filelen / 32765.0 + 1.0
		end if
	else
		ll_numloops = 1
	end if
	for ll_index = 1 to ll_numloops
		fileread(li_filenum, ls_temp)
		ls_data = ls_temp + ls_data
	next
	fileclose(li_filenum)
	return ls_data

// nv_remote_datawindow.of_load_property(contextkeyword atx_key, ref string as_prop) returns string
	string ls_result
	integer li_rc
	string[] ls_values
	li_rc = atx_key.getcontextkeywords(as_prop, ls_values)
	if li_rc = 1 then
		ls_result = ls_values[1]
	end if
	return ls_result

// nv_remote_datawindow.of_escapequotes(ref string as_instring) returns string
	long ll_inpos
	long ll_outpos
	long ll_length
	string ls_output
	char[] lc_inchars
	char[] lc_outchars
	char lc_inchar
	lc_inchars = as_instring
	ll_length = upperbound(lc_inchars)
	ll_outpos = 1
	for ll_inpos = 1 to ll_length
		lc_inchar = lc_inchars[ll_inpos]
		if lc_inchar = "~~" then
			lc_outchars[ll_outpos] = "~~"
			lc_outchars[ll_outpos + 1] = "~~"
			ll_outpos = ll_outpos + 2
		elseif lc_inchar = "~"" then
			lc_outchars[ll_outpos] = "~~"
			lc_outchars[ll_outpos + 1] = "~""
			ll_outpos = ll_outpos + 2
		elseif lc_inchar = "'" then
			lc_outchars[ll_outpos] = "~~"
			lc_outchars[ll_outpos + 1] = "'"
			ll_outpos = ll_outpos + 2
		else
			lc_outchars[ll_outpos] = lc_inchar
			ll_outpos = ll_outpos + 1
		end if
	next
	return lc_outchars

// nv_remote_datawindow.setbrowser(ref string as_browsername) returns string
	string ls_modifystring
	string ls_result
	if this.ib_trace then
		of_log_enter("SetBrowser('" + as_browsername + "')")
	end if
	if not isnull(as_browsername) and as_browsername <> "" then
		ls_modifystring = "DataWindow.htmlgen.Browser='" + of_escapequotes(as_browsername) + "'"
		ls_result = this.ids_datastore.modify(ls_modifystring)
	end if
	if this.ib_trace then
		of_log_exit("SetBrowser() = '" + ls_result + "'")
	end if
	of_continuework(true)
	return ls_result

// nv_remote_datawindow.setcolumnlink(ref string as_columnname, ref string as_link, ref string as_linkargs, ref string as_linktarget) returns string
	string ls_modifystring
	string ls_result
	if this.ib_trace then
		of_log_enter("SetColumnLink('" + as_columnname + "','" + as_link + "','" + as_linkargs + "')")
	end if
	if not isnull(as_columnname) then
		if not isnull(as_link) and as_link <> "" then
			ls_modifystring = as_columnname + ".HTML.Link='" + of_escapequotes(as_link) + "'"
			ls_result = this.ids_datastore.modify(ls_modifystring)
		end if
		if not isnull(as_linktarget) and as_link <> "" then
			ls_modifystring = as_columnname + ".HTML.LinkTarget='" + of_escapequotes(as_linktarget) + "'"
			ls_result = this.ids_datastore.modify(ls_modifystring) + ls_result
		end if
		if not isnull(as_linkargs) then
			ls_modifystring = as_columnname + ".HTML.LinkArgs=~"" + of_escapequotes(as_linkargs) + "~""
			ls_result = this.ids_datastore.modify(ls_modifystring) + ls_result
		end if
	end if
	if this.ib_trace then
		of_log_exit("SetColumnLink() = '" + ls_result + "'")
	end if
	of_continuework(true)
	return ls_result

