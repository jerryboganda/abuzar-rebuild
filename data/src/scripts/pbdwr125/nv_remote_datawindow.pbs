// nv_remote_datawindow.generatexhtml() returns string
	string ls_result
	if this.ib_trace then
		of_log_enter("GenerateXHTML()")
	end if
	ls_result = this.ids_datastore.describe("DataWindow.Data.XHTML")
	if this.ib_trace then
		of_log_exit("GenerateXHTML(), length = " + string(len(ls_result)))
	end if
	of_completework()
	if this.ids_datastore.describe("datawindow.processing") = "5" then
		SQL stop USING sqlca;
	end if
	return ls_result

