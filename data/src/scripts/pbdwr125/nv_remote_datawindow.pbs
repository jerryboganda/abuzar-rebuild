// nv_remote_datawindow.of_getextension(ref string as_filename) returns string
	string ls_extension
	long ll_lastpos
	ll_lastpos = of_lastpos(as_filename, ".")
	if ll_lastpos > 0 then
		ls_extension = mid(as_filename, ll_lastpos + 1, 3)
		ls_extension = upper(ls_extension)
	end if
	return ls_extension

// nv_remote_datawindow.of_log(ref string msg) returns 0
	if this.ib_trace and isvalid(this.inv_logger) then
		this.inv_logger.log("HTMLDW: " + space(this.il_indent * 3) + msg)
	end if

// nv_remote_datawindow.of_log_enter(ref string msg) returns 0
	of_log("Entering " + msg)
	this.il_indent = this.il_indent + 1

// nv_remote_datawindow.of_log_exit(ref string msg) returns 0
	this.il_indent = this.il_indent - 1
	of_log("Exiting " + msg)

// nv_remote_datawindow.setaction(ref string as_action, ref string as_context) returns integer
	integer li_result
	if this.ib_trace then
		of_log_enter("SetAction('" + as_action + "')")
	end if
	this.ib_didupdate = as_action = "Update"
	li_result = this.ids_datastore.sethtmlaction(as_action, as_context)
	if this.ib_trace then
		of_log_exit("SetAction() = " + string(li_result))
	end if
	this.ib_updatefailed = this.ib_didupdate and li_result <> 1 and li_result <> -4
	of_continuework(not this.ib_updatefailed)
	return li_result

// nv_remote_datawindow.clearvalues(ref string as_column) returns integer
	integer li_result
	if this.ib_trace then
		of_log_enter("ClearValues('" + as_column + "')")
	end if
	li_result = this.ids_datastore.clearvalues(as_column)
	if this.ib_trace then
		of_log_exit("ClearValues()")
	end if
	of_continuework(true)
	return li_result

// nv_remote_datawindow.of_parseargs(ref string argstring, ref any[] args) returns integer
	integer li_result
	integer li_index
	integer li_maxindex
	integer li_pos
	integer li_lastpos = 1
	integer li_tabpos
	nv_retreival_arg[] argrow
	string argdesc
	string dwarg
	argdesc = this.ids_datastore.describe("datawindow.table.arguments")
	li_index = 1
	do
		li_pos = pos(argdesc, "~n", li_lastpos)
		if li_pos > 0 then
			dwarg = mid(argdesc, li_lastpos, li_pos - li_lastpos)
		else
			dwarg = mid(argdesc, li_lastpos)
		end if
		li_tabpos = pos(dwarg, "~t")
		if li_tabpos > 0 then
			argrow[li_index].is_argtype = mid(dwarg, li_tabpos + 1)
		end if
		li_lastpos = li_pos + 1
		li_index = li_index + 1
	loop while li_pos > 0
	li_index = 1
	do
		li_pos = pos(argstring, "~n", li_lastpos)
		if li_pos > 0 then
			argrow[li_index].is_passedvalue = mid(argstring, li_lastpos, li_pos - li_lastpos)
		else
			argrow[li_index].is_passedvalue = mid(argstring, li_lastpos)
		end if
		li_result = argrow[li_index].of_parse_value(args[li_index])
		li_lastpos = li_pos + 1
		li_index = li_index + 1
	loop while li_pos > 0 and li_result = 1
	return li_result

// nv_remote_datawindow.retrieve() returns integer
	long li_result
	if this.ib_trace then
		of_log_enter("Retrieve()")
	end if
	if this.ib_allowretrieve then
		li_result = this.ids_datastore.retrieve()
	else
		if this.ib_trace then
			of_log("Retrieve not allowed, returning row count")
		end if
		li_result = this.ids_datastore.rowcount()
	end if
	if this.ib_trace then
		if li_result < 0 then
			of_log("Retrieve Failed, DB message below")
			of_log(this.ids_datastore.getlasterrorstring())
		end if
		of_log_exit("Retrieve() = " + string(li_result))
	end if
	of_continuework(true)
	if li_result > 32767 then
		li_result = 32767
	end if
	return li_result

// nv_remote_datawindow.retrieveex(ref string argstring) returns integer
	long li_result
	any[] args
	if this.ib_trace then
		of_log_enter("RetrieveEx('" + argstring + "')")
	end if
	if this.ib_allowretrieve then
		if not isnull(argstring) and argstring <> "" then
			li_result = of_parseargs(argstring, args)
		end if
		if li_result = 1 then
			choose case upperbound(args)
			case 0
				li_result = this.ids_datastore.retrieve()
			case 1
				li_result = this.ids_datastore.retrieve(args[1])
			case 2
				li_result = this.ids_datastore.retrieve(args[1], args[2])
			case 3
				li_result = this.ids_datastore.retrieve(args[1], args[2], args[3])
			case 4
				li_result = this.ids_datastore.retrieve(args[1], args[2], args[3], args[4])
			case 5
				li_result = this.ids_datastore.retrieve(args[1], args[2], args[3], args[4], args[5])
			case 6
				li_result = this.ids_datastore.retrieve(args[1], args[2], args[3], args[4], args[5], args[6])
			case 7
				li_result = this.ids_datastore.retrieve(args[1], args[2], args[3], args[4], args[5], args[6], args[7])
			case 8
				li_result = this.ids_datastore.retrieve(args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8])
			case 9
				li_result = this.ids_datastore.retrieve(args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9])
			case 10
				li_result = this.ids_datastore.retrieve(args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10])
			case 11
				li_result = this.ids_datastore.retrieve(args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11])
			case 12
				li_result = this.ids_datastore.retrieve(args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11], args[12])
			case 13
				li_result = this.ids_datastore.retrieve(args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11], args[12], args[13])
			case 14
				li_result = this.ids_datastore.retrieve(args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11], args[12], args[13], args[14])
			case 15
				li_result = this.ids_datastore.retrieve(args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11], args[12], args[13], args[14], args[15])
			case 16
				li_result = this.ids_datastore.retrieve(args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11], args[12], args[13], args[14], args[15], args[16])
			case else
				li_result = -1
			end choose
		end if
	else
		li_result = 1
	end if
	if this.ib_trace then
		if li_result < 0 then
			of_log("RetrieveEX Failed, DB message below")
			of_log(this.ids_datastore.getlasterrorstring())
		end if
		of_log_exit("RetrieveEx() = " + string(li_result))
	end if
	of_continuework(true)
	if li_result > 32767 then
		li_result = 32767
	end if
	return li_result

// nv_remote_datawindow.of_convertstringtodatetime(ref string as_datetime) returns datetime
	boolean lb_datetime_found
	date ldt_date
	datetime ldtm_datetime
	long ll_length
	long ll_pos
	string ls_date
	string ls_time
	time ltm_time
	string ls_currentchar
	string ls_nextchar
	ll_length = len(as_datetime)
	setnull(ldt_date)
	setnull(ltm_time)
	for ll_pos = 4 to ll_length
		ls_date = trim(left(as_datetime, ll_pos))
		ls_time = trim(right(as_datetime, ll_length - ll_pos))
		if isdate(ls_date) and istime(ls_time) then
			if ll_pos < ll_length then
				ls_currentchar = mid(as_datetime, ll_pos, 1)
				ls_nextchar = mid(as_datetime, ll_pos + 1, 1)
				if isnumber(ls_currentchar) and isnumber(ls_nextchar) then
					goto L382
				end if
			else
				ldt_date = date(ls_date)
				ltm_time = time(ls_time)
				lb_datetime_found = true
				ll_pos = ll_length
			end if
		end if
	next
	if not lb_datetime_found then
		ls_date = trim(as_datetime)
		if isdate(ls_date) then
			ldt_date = date(ls_date)
			ltm_time = time("12:00 AM")
			ll_pos = ll_length
		end if
	end if
	ldtm_datetime = datetime(ldt_date, ltm_time)
	return ldtm_datetime

// nv_remote_datawindow.setdwobject(ref string as_sourcefilename, ref string as_dwobjectname) returns integer
	integer li_result = -1
	string ls_extension
	string liblist
	string ls_source
	string ls_result
	string ls_error
	if this.ib_trace then
		of_log_enter("SetDWObject('" + as_sourcefilename + "','" + as_dwobjectname + "')")
	end if
	if not this.ib_fixed then
		if not isnull(as_sourcefilename) then
			ls_extension = of_getextension(as_sourcefilename)
			choose case ls_extension
			case "PBD", "PBL"
				if this.ib_trace then
					of_log("Doing PBL/PBD")
				end if
				if fileexists(as_sourcefilename) then
					if pos(this.is_default_library_list, as_sourcefilename) = 0 then
						liblist = this.is_default_library_list + "," + as_sourcefilename
						li_result = addtolibrarylist(as_sourcefilename)
						if this.ib_trace then
							of_log("AddToLibraryList(" + as_sourcefilename + ") = " + string(li_result))
						end if
					else
						liblist = this.is_default_library_list
					end if
					this.ids_datastore.dataobject = as_dwobjectname
					if this.ids_datastore.describe("datawindow.units") = "" then
						of_log("SetDWObject: ERROR - Could not find datawindow '" + as_dwobjectname + "' in library list '" + liblist + "'")
						li_result = -1
					else
						li_result = 1
					end if
				else
					of_log("SetDWObject: ERROR - Could not find library '" + as_sourcefilename + "'")
				end if
			case "PSR"
				if this.ib_trace then
					of_log("Doing PSR")
				end if
				if fileexists(as_sourcefilename) then
					this.ids_datastore.dataobject = as_sourcefilename
					this.ib_allowretrieve = false
					li_result = 1
				else
					of_log("SetDWObject: ERROR - Could not find file '" + as_sourcefilename + "'")
				end if
			case "SRD"
				if this.ib_trace then
					of_log("Doing SRD")
				end if
				ls_source = of_readfile(as_sourcefilename)
				if ls_source <> "" then
					ls_result = create(ls_source)
					if ls_result = "" then
						li_result = 1
					else
						of_log("SetDWObject: ERROR - Create from SRD failed for '" + as_sourcefilename + "', Error String = '" + ls_result + "'")
					end if
				else
					of_log("SetDWObject: ERROR - Could not read source '" + as_sourcefilename + "'")
				end if
			case ""
				if as_sourcefilename = "" then
					if this.ib_trace then
						of_log("Unspecified library, assuming component specifies proper library list")
					end if
					this.ids_datastore.dataobject = as_dwobjectname
					if this.ids_datastore.describe("datawindow.units") = "" then
						of_log("SetDWObject: ERROR - Could not find datawindow '" + as_dwobjectname + "' in library list '" + this.is_default_library_list + "'")
						li_result = -1
					else
						li_result = 1
					end if
				else
					of_log("SetDWObject: ERROR - Unrecognized extension for '" + as_sourcefilename + "' Expecting one of (PBL, PBD, PSR or SRD)")
				end if
			case else
				of_log("SetDWObject: ERROR - Unrecognized extension for '" + as_sourcefilename + "' Expecting one of (PBL, PBD, PSR or SRD)")
			end choose
		end if
	else
		of_log("SetDWObject: ERROR - Component is marked as fixed.  Cannot change DW definition")
	end if
	if li_result > 0 then
		ls_error = modify("DataWindow.htmldw='yes' DataWindow.NoUserPrompt='yes'")
		this.ib_dwobjectset = true
		this.ib_transactionset = false
		of_initializefromdeclarative()
	end if
	if this.ib_trace then
		of_log_exit("SetDWObject() = " + string(li_result))
	end if
	of_continuework(true)
	return li_result

// nv_remote_datawindow.setdwobjectex(ref string as_dwobjectname) returns integer
	integer li_result = -1
	string ls_error
	if this.ib_trace then
		of_log_enter("SetDWObjectEx('" + as_dwobjectname + "')")
	end if
	if not this.ib_fixed then
		this.ids_datastore.dataobject = as_dwobjectname
		if this.ids_datastore.describe("datawindow.units") = "" then
			of_log("SetDWObjectEx: ERROR - Could not find datawindow '" + as_dwobjectname + "' in library list '" + this.is_default_library_list + "'")
			li_result = -1
		else
			li_result = 1
		end if
	else
		of_log("SetDWObjectEx: ERROR - Component is marked as fixed.  Cannot change DW definition")
	end if
	if li_result > 0 then
		ls_error = modify("DataWindow.htmldw='yes' DataWindow.NoUserPrompt='yes'")
		this.ib_dwobjectset = true
		this.ib_transactionset = false
		of_initializefromdeclarative()
	end if
	if this.ib_trace then
		of_log_exit("SetDWObjectEx() = " + string(li_result))
	end if
	of_continuework(true)
	return li_result

// nv_remote_datawindow.of_convertstringtosaveastype(ref string as_saveastype) returns saveastype
	saveastype sat_saveastype
	setnull(sat_saveastype)
	choose case upper(as_saveastype)
	case "CLIPBOARD!", "CLIPBOARD"
		sat_saveastype = clipboard!
	case "CSV!", "CSV"
		sat_saveastype = csv!
	case "DBASE2!", "DBASE2"
		sat_saveastype = dbase2!
	case "DBASE3!", "DBASE3"
		sat_saveastype = dbase3!
	case "DIF!", "DIF"
		sat_saveastype = dif!
	case "EMF!", "EMF"
		sat_saveastype = emf!
	case "EXCEL!", "EXCEL"
		sat_saveastype = excel!
	case "EXCEL5!", "EXCEL5"
		sat_saveastype = excel5!
	case "EXCEL8!", "EXCEL8"
		sat_saveastype = excel8!
	case "HTMLTABLE!", "HTMLTABLE"
		sat_saveastype = htmltable!
	case "PDF!", "PDF"
		sat_saveastype = pdf!
	case "PSREPORT!", "PSREPORT"
		sat_saveastype = psreport!
	case "SQLINSERT!", "SQLINSERT"
		sat_saveastype = sqlinsert!
	case "SYLK!", "SYLK"
		sat_saveastype = sylk!
	case "TEXT!", "TEXT"
		sat_saveastype = text!
	case "WKS!", "WKS"
		sat_saveastype = wks!
	case "WK1!", "WK1"
		sat_saveastype = wk1!
	case "WMF!", "WMF"
		sat_saveastype = wmf!
	case "XML!", "XML"
		sat_saveastype = xml!
	case "XSLFO!", "XSLFO"
		sat_saveastype = xslfo!
	end choose
	return sat_saveastype

// nv_remote_datawindow.importstringex(ref string as_saveastype, ref string as_string, ref long al_startrow, ref long al_endrow, ref long al_startcolumn, ref long al_endcolumn, ref long al_dwstartcolumn) returns long
	long ll_result
	if this.ib_trace then
		of_log_enter("ImportStringEx('" + as_saveastype + "', '" + as_string + "', " + string(al_startrow) + ", " + string(al_endrow) + ", " + string(al_startcolumn) + ", " + string(al_endcolumn) + ", " + string(al_dwstartcolumn) + ")")
	end if
	ll_result = this.ids_datastore.importstring(of_convertstringtosaveastype(as_saveastype), as_string, al_startrow, al_endrow, al_startcolumn, al_endcolumn, al_dwstartcolumn)
	if this.ib_trace then
		of_log_exit("ImportStringEx()")
	end if
	of_continuework(true)
	return ll_result

