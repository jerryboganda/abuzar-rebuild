// nv_remote_datawindow.setserverserviceclasses(ref string as_serviceclassnames) returns integer
	string ls_notfoundclasses
	integer li_ret = 1
	if this.ib_trace then
		of_log_enter("SetServerServiceClasses('" + as_serviceclassnames + "')")
	end if
	li_ret = this.ids_datastore.setserviceclasses(as_serviceclassnames, ls_notfoundclasses)
	if li_ret <> 1 and this.ib_trace then
		of_log("Could not find the following classes '" + ls_notfoundclasses + "'")
	end if
	if this.ib_trace then
		of_log_exit("SetServerServiceClasses() = " + string(li_ret) + "")
	end if
	of_continuework(true)
	return li_ret

// nv_remote_datawindow.of_initializefromdeclarative() returns integer
	integer li_rc = 1
	string ls_rc
	boolean lb_oldfixed
	if this.ib_trace then
		of_log_enter("of_initializeFromDeclarative()")
	end if
	lb_oldfixed = this.ib_fixed
	this.ib_fixed = false
	if this.ib_dwobjectset then
		if this.is_serviceclassnames <> "" then
			setserverserviceclasses(this.is_serviceclassnames)
		end if
		if this.is_htmlobjectname <> "" then
			ls_rc = sethtmlobjectname(this.is_htmlobjectname)
			if ls_rc <> "" then
				li_rc = -1
			end if
		end if
		if li_rc = 1 and this.is_modifystring <> "" then
			ls_rc = modify(this.is_modifystring)
			if ls_rc <> "" then
				li_rc = -1
			end if
		end if
		if li_rc = 1 and not this.ib_transactionset and this.is_trans_dbms <> "" then
			li_rc = settrans(this.is_trans_dbms, this.is_trans_dbparm, this.is_trans_lock, this.is_trans_logid, this.is_trans_logpass, this.is_trans_database, this.is_trans_servername)
		end if
	else
		li_rc = -1
	end if
	this.ib_fixed = lb_oldfixed
	if this.ib_trace then
		of_log_exit("of_initializeFromDeclarative() = " + string(li_rc))
	end if
	return li_rc

// nv_remote_datawindow.create(ref string as_dwsyntax) returns string
	string ls_error
	if this.ib_trace then
		of_log_enter("Create()")
	end if
	if not this.ib_fixed then
		if this.ids_datastore.create(as_dwsyntax, ls_error) = 1 then
			ls_error = modify("DataWindow.htmldw='yes' DataWindow.NoUserPrompt='yes'")
		end if
	else
		ls_error = "Component has been marked as fixed.  Cannot call Create()"
	end if
	if this.ib_trace then
		of_log_exit("Create() = '" + ls_error + "'")
	end if
	of_continuework(true)
	return ls_error

