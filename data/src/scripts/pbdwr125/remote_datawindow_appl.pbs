// application remote_datawindow_appl (pbdwr125)  ancestor: application

// remote_datawindow_appl.create() returns 0 [event]
	this.appname = "remote_datawindow_appl"
	message = create message
	sqlca = create transaction
	sqlda = create dynamicdescriptionarea
	sqlsa = create dynamicstagingarea
	error = create error

// remote_datawindow_appl.destroy() returns 0 [event]
	destroy sqlca
	destroy sqlda
	destroy sqlsa
	destroy error
	destroy message
