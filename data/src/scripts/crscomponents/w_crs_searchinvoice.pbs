// window w_crs_searchinvoice (crscomponents)  ancestor: window

// w_crs_searchinvoice.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		post event ue_close()
	end if
	return ::message.returnvalue

// w_crs_searchinvoice.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// w_crs_searchinvoice.wf_assigndwobjects(string as_masterdw, string as_detaildw, string as_footerdw) returns 0
	this.dw_master.dataobject = as_masterdw
	this.dw_detail.dataobject = as_detaildw
	this.dw_footer.dataobject = as_footerdw
	this.dw_master.settransobject(sqlca)
	this.dw_detail.settransobject(sqlca)
	this.dw_footer.settransobject(sqlca)

// w_crs_searchinvoice.create() returns 0 [event]
	this.cb_preview = create cb_preview
	this.cb_startsearch = create cb_startsearch
	this.cb_ok = create cb_ok
	this.dw_footer = create dw_footer
	this.dw_master = create dw_master
	this.dw_detail = create dw_detail
	this.control = {this.cb_preview, this.cb_startsearch, this.cb_ok, this.dw_footer, this.dw_master, this.dw_detail}

// w_crs_searchinvoice.destroy() returns 0 [event]
	destroy this.cb_preview
	destroy this.cb_startsearch
	destroy this.cb_ok
	destroy this.dw_footer
	destroy this.dw_master
	destroy this.dw_detail

// w_crs_searchinvoice.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		this.width = ll_win_width * 0.90
		this.height = ll_win_height * 0.90
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
		this.dw_detail.width = this.width * 0.95
		this.cb_ok.y = this.height - 250
		this.cb_preview.y = this.height - 250
		this.dw_detail.height = this.cb_ok.y - this.dw_detail.y - 30
	end if
	this.title = "Search Sale/Return Invoice(s)"
	wf_assigndwobjects("d_crs_searchtext", "d_crs_searchinvoice", "")
	this.dw_master.retrieve()
	this.dw_master.setfocus()
	this.dw_master.setcolumn("text")
	return ::message.returnvalue

// cb_preview.clicked() returns long [event]
	long ll_row
	s_invdetail lsrt_invdetail
	if parent.dw_detail.rowcount() > 0 and parent.dw_detail.getrow() > 0 then
		ll_row = parent.dw_detail.getrow()
		if parent.dw_detail.object.type[ll_row] = "S" then
			lsrt_invdetail.i_module = 1
		elseif parent.dw_detail.object.type[ll_row] = "R" then
			lsrt_invdetail.i_module = 2
		end if
		lsrt_invdetail.l_invcode = parent.dw_detail.object.invcode[ll_row]
		lsrt_invdetail.l_clientinstanceid = parent.dw_detail.object.clientinstanceid[ll_row]
		openwithparm(w_crs_invoicedetail, lsrt_invdetail)
	end if
	return ::message.returnvalue

// cb_startsearch.clicked() returns long [event]
	parent.dw_master.accepttext()
	if parent.dw_master.rowcount() > 0 then
		parent.dw_detail.retrieve(parent.dw_master.object.text[1])
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long[] ll_invcode
	long ll_rowcount
	long ll_counter
	long ll_arrindex
	long ll_thiscode
	long ll_clientinstanceid
	boolean lb_remarks
	boolean lb_invoiceexists
	string ls_date
	string ls_type
	SQL DELETE ReportData USING sqlca;
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
	end if
	ll_rowcount = parent.dw_detail.rowcount()
	for ll_counter = 1 to ll_rowcount
		if parent.dw_detail.getitemstring(ll_counter, "selected") = "Y" then
			lb_invoiceexists = true
			ll_arrindex = ll_arrindex + 1
			ll_clientinstanceid = parent.dw_detail.object.clientinstanceid[ll_counter]
			ll_thiscode = parent.dw_detail.object.invcode[ll_counter]
			ls_type = parent.dw_detail.object.type[ll_counter]
			parent.istr_arg.ia_integerlist[ll_arrindex] = ll_thiscode
			if ls_type = "S" then
				SQL INSERT INTO ReportData ( Code1 , Code2 , Name1 ) VALUES ( :ll_clientinstanceid , :ll_thiscode , :ls_type ) USING sqlca;
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
				end if
			end if
		end if
	next
	if lb_invoiceexists then
		parent.istr_arg.i_status = 1
	end if
	parent.post event ue_close()
	return ::message.returnvalue
