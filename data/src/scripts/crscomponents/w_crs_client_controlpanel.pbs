// window w_crs_client_controlpanel (crscomponents)  ancestor: window

// w_crs_client_controlpanel.ue_close(integer ai_status) returns 0
	SQL stop USING this.it_datatransobject;
	destroy this.it_datatransobject
	close(this)

// w_crs_client_controlpanel.wf_disconnect() returns 0
	SQL stop USING this.it_datatransobject;
	destroy this.it_datatransobject

// w_crs_client_controlpanel.wf_openreport() returns 0

// w_crs_client_controlpanel.wf_perform_task(string as_object) returns long
	setpointer(hourglass!)
	wf_starttask(as_object)
	wf_gettaskinfo(this.il_serverstatus)
	setpointer(arrow!)
	return 0

// w_crs_client_controlpanel.wf_starttask(string as_object) returns 0
	string ls_connsetting
	string ls_path
	string ls_package
	string ls_cmdline
	long ll_counter
	integer li_usercode
	integer li_rtcode
	open(w_salesmanpassword)
	li_usercode = integer(message.doubleparm)
	setfocus()
	if li_usercode <= 0 or isnull(li_usercode) then
		messagebox("User/Password Validation", "User/Password Failure~r~nPlease enter valid user name / password.", stopsign!)
		return
	end if
	ls_connsetting = "Set ANSI_NULLS ON Set ANSI_WARNINGS ON"
	SQL stop USING this.it_datatransobject;
	SQL start USING this.it_datatransobject;
	if this.it_datatransobject.sqlcode = 0 then
		SQL EXECUTE IMMEDIATE :ls_connsetting USING this.it_datatransobject;
		if this.it_datatransobject.sqlcode = 0 then
			this.st_progress.text = ""
			this.hpb_progress.position = 0
			this.gb_progress.visible = true
			this.hpb_progress.visible = true
			this.st_progress.visible = true
			if as_object = "b_senddata" then
				if this.dw_control.object.transfermethod[1] = 1 then
					this.st_progress.text = "Sending data From Local Server ~"" + upper(gs_servername) + "~" to CRS Server ~"" + gs_crs_linkserver + "~" . . ."
					this.hpb_progress.stepit()
					this.hpb_progress.stepit()
					this.hpb_progress.stepit()
					SQL rollback USING this.it_datatransobject;
					this.it_datatransobject.crs_clientdatatransfer(gs_crs_linkserver, gs_crs_dbname, gs_crs_owner, li_usercode)
					if this.it_datatransobject.sqlcode = 0 then
						SQL commit USING this.it_datatransobject;
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						messagebox("CRS Data Send Service", "CRS Data Sending Task Completed Successfully", information!)
					else
						SQL rollback USING this.it_datatransobject;
						messagebox("CRS Data Send Service", "Problem sending CRS Data~r~nCan not send CRS Data to CRS Server Properly~r~nReasons are:- " + this.it_datatransobject.sqlerrtext, stopsign!)
					end if
				else
					ls_package = "DTS_CRS_ClientDataTransfer.dts"
					ls_path = getcurrentdirectory() + "\DTS\" + ls_package
					ls_cmdline = "DTSRun /N ~"DTS_CRS_ClientDataTransfer~" /F ~"" + ls_path + "~" /W ~"-1~" "
					li_rtcode = run(ls_cmdline)
					if li_rtcode = 1 then
					end if
				end if
			end if
			this.hpb_progress.visible = false
			this.st_progress.visible = false
			this.gb_progress.visible = false
		else
			messagebox("Connection Problem", "Problem Occured While Connecting to database~r~nProblem while setting database connection options~r~nReasons are:- " + this.it_datatransobject.sqlerrtext, stopsign!)
		end if
	else
		messagebox("Connection Problem", "Problem Occured While Connecting to database~r~nPlease Try Again~r~nReasons are:- " + this.it_datatransobject.sqlerrtext, stopsign!)
	end if

// w_crs_client_controlpanel.wf_gettaskinfo(long al_serverstatus) returns long
	integer li_instanceid
	integer li_usercode
	datetime ldt_startdate
	datetime ldt_enddate
	string ls_errtext
	this.dw_control.settransobject(this.it_datatransobject)
	this.dw_control.retrieve(al_serverstatus)
	if this.dw_control.rowcount() > 0 then
		this.dw_control.object.servername[1] = gs_crs_linkserver
		this.dw_control.object.databasename[1] = gs_crs_dbname
	end if
	if al_serverstatus <> 0 then
		SQL rollback USING this.it_datatransobject;
		this.it_datatransobject.crs_getlastcrsdatasendinfo(gs_crs_linkserver, gs_crs_dbname, gs_crs_owner, li_instanceid, ldt_startdate, ldt_enddate, li_usercode)
		if this.it_datatransobject.sqlcode = 0 then
			SQL commit USING this.it_datatransobject;
			this.dw_control.object.sendstartdate[1] = ldt_startdate
			this.dw_control.object.sendenddate[1] = ldt_enddate
			this.dw_control.object.usercode[1] = li_usercode
		else
			ls_errtext = this.it_datatransobject.sqlerrtext
			SQL rollback USING this.it_datatransobject;
			messagebox("CRS Data Sending History", "CRS Data Sending History Retrieval Failed.~r~nReasons Are:- " + ls_errtext)
		end if
	end if
	return 0

// w_crs_client_controlpanel.create() returns 0
	this.dw_autosendcrsdataschedule = create dw_autosendcrsdataschedule
	this.rb_autosendcrsdataevery = create rb_autosendcrsdataevery
	this.st_importdatamin = create st_importdatamin
	this.ddlb_autosendcrsdatatime = create ddlb_autosendcrsdatatime
	this.ddlb_autosendcrsdatasec = create ddlb_autosendcrsdatasec
	this.st_importdatasec = create st_importdatasec
	this.ddlb_autosendcrsdatamin = create ddlb_autosendcrsdatamin
	this.ddlb_autosendcrsdatahr = create ddlb_autosendcrsdatahr
	this.st_importdatahr = create st_importdatahr
	this.rb_autosendcrsdataonce = create rb_autosendcrsdataonce
	this.cbx_activateautosendcrsdata = create cbx_activateautosendcrsdata
	this.dw_control = create dw_control
	this.cb_saveandclose = create cb_saveandclose
	this.gb_progress = create gb_progress
	this.hpb_progress = create hpb_progress
	this.st_progress = create st_progress
	this.gb_2 = create gb_2
	this.gb_1 = create gb_1
	this.control = {this.dw_autosendcrsdataschedule, this.rb_autosendcrsdataevery, this.st_importdatamin, this.ddlb_autosendcrsdatatime, this.ddlb_autosendcrsdatasec, this.st_importdatasec, this.ddlb_autosendcrsdatamin, this.ddlb_autosendcrsdatahr, this.st_importdatahr, this.rb_autosendcrsdataonce, this.cbx_activateautosendcrsdata, this.dw_control, this.cb_saveandclose, this.gb_progress, this.hpb_progress, this.st_progress, this.gb_2, this.gb_1}

// w_crs_client_controlpanel.destroy() returns 0
	destroy this.dw_autosendcrsdataschedule
	destroy this.rb_autosendcrsdataevery
	destroy this.st_importdatamin
	destroy this.ddlb_autosendcrsdatatime
	destroy this.ddlb_autosendcrsdatasec
	destroy this.st_importdatasec
	destroy this.ddlb_autosendcrsdatamin
	destroy this.ddlb_autosendcrsdatahr
	destroy this.st_importdatahr
	destroy this.rb_autosendcrsdataonce
	destroy this.cbx_activateautosendcrsdata
	destroy this.dw_control
	destroy this.cb_saveandclose
	destroy this.gb_progress
	destroy this.hpb_progress
	destroy this.st_progress
	destroy this.gb_2
	destroy this.gb_1

// w_crs_client_controlpanel.open() returns long
	long ll_appversion
	long ll_sequenceid
	long ll_dbstatus
	long ll_crs_appversion
	long ll_crs_sequenceid
	long ll_crs_dbstatus
	long ll_retcode
	long ll_autosendcrsdatahr
	string ls_jobstarttime
	string ls_hold
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	datastore lds_sequence
	integer li_enabled
	this.it_datatransobject = create u_transaction
	SQL start USING this.it_datatransobject;
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	lds_sequence = create datastore
	lds_sequence.dataobject = "d_sequence"
	lds_sequence.settransobject(this.it_datatransobject)
	lds_sequence.retrieve()
	ll_appversion = lds_sequence.getitemnumber(1, "AppVersion")
	ll_sequenceid = lds_sequence.getitemnumber(1, "SequenceId")
	ll_dbstatus = lds_sequence.getitemnumber(1, "DBStatus")
	f_getappversion(gs_crs_linkserver, gs_crs_dbname, gs_crs_owner, ll_crs_sequenceid, ll_crs_appversion, ll_crs_dbstatus)
	if ll_crs_sequenceid > 0 and ll_crs_appversion > 0 then
		this.il_serverstatus = 1
		if ll_crs_appversion <> ll_appversion or ll_crs_sequenceid <> ll_sequenceid or ll_crs_dbstatus <> ll_dbstatus then
			messagebox("Version Problem", "Both Source and Target Must have same Application Version")
			post event ue_close(0)
			return ::message.returnvalue
		end if
	else
		this.il_serverstatus = 0
	end if
	wf_gettaskinfo(this.il_serverstatus)
	this.it_jobtransobject = create u_transaction
	this.it_jobtransobject.dbms = "OLE DB"
	this.it_jobtransobject.autocommit = true
	this.it_jobtransobject.dbparm = "PROVIDER='SQLOLEDB',DATASOURCE='" + gs_servername + "',CommitOnDisconnect='No',PROVIDERSTRING='DataBase=MSDB" + ";APP=" + gs_app + ";WSID=" + gs_localcomputername + "',PBTrimCharColumns='Yes',StripParmNames='Yes'"
	SQL start USING this.it_jobtransobject;
	this.dw_autosendcrsdataschedule.settransobject(this.it_jobtransobject)
	this.dw_autosendcrsdataschedule.retrieve(gs_autosendcrsdatajob, gs_autosendcrsdatajobschedule)
	SQL Select enabled INTO :li_enabled From SysJobs Where Name =:gs_autosendcrsdatajob USING this.it_jobtransobject;
	if this.it_jobtransobject.sqlcode = 0 then
		if li_enabled = 1 then
			this.cbx_activateautosendcrsdata.checked = true
			if this.dw_autosendcrsdataschedule.getitemnumber(1, "unit") = 1.0 then
				this.rb_autosendcrsdataonce.checked = true
				ls_jobstarttime = string(this.dw_autosendcrsdataschedule.getitemnumber(1, "occurancetime"))
				ll_autosendcrsdatahr = integer(left(ls_jobstarttime, len(ls_jobstarttime) - 4))
				ls_hold = left(right(ls_jobstarttime, 4), len(right(ls_jobstarttime, 4)) - 2)
				if isnull(ls_hold) or ls_hold = "" then
					ls_hold = "00"
				elseif len(ls_hold) = 1 then
					ls_hold = "0" + ls_hold
				end if
				this.ddlb_autosendcrsdatamin.selectitem(ls_hold, 0)
				ls_hold = right(ls_jobstarttime, 2)
				if isnull(ls_hold) or ls_hold = "" then
					ls_hold = "00"
				elseif len(ls_hold) = 1 then
					ls_hold = "0" + ls_hold
				end if
				this.ddlb_autosendcrsdatasec.selectitem(ls_hold, 0)
				if ll_autosendcrsdatahr > 12 then
					this.ddlb_autosendcrsdatahr.selectitem(string(ll_autosendcrsdatahr - 12), 0)
					this.ddlb_autosendcrsdatatime.selectitem("PM", 0)
				elseif ll_autosendcrsdatahr = 12 then
					this.ddlb_autosendcrsdatahr.selectitem("12", 0)
					this.ddlb_autosendcrsdatatime.selectitem("PM", 0)
				else
					if isnull(ll_autosendcrsdatahr) or ll_autosendcrsdatahr = 0 then
						this.ddlb_autosendcrsdatahr.selectitem("12", 0)
					else
						this.ddlb_autosendcrsdatahr.selectitem(string(ll_autosendcrsdatahr), 0)
					end if
					this.ddlb_autosendcrsdatatime.selectitem("AM", 0)
				end if
				this.dw_autosendcrsdataschedule.enabled = false
			else
				this.rb_autosendcrsdataevery.checked = true
				this.ddlb_autosendcrsdatahr.enabled = false
				this.ddlb_autosendcrsdatamin.enabled = false
				this.ddlb_autosendcrsdatasec.enabled = false
				this.ddlb_autosendcrsdatatime.enabled = false
			end if
		else
			this.cbx_activateautosendcrsdata.checked = false
			this.rb_autosendcrsdataevery.enabled = false
			this.dw_autosendcrsdataschedule.enabled = false
			this.rb_autosendcrsdataonce.enabled = false
			this.ddlb_autosendcrsdatahr.enabled = false
			this.ddlb_autosendcrsdatamin.enabled = false
			this.ddlb_autosendcrsdatasec.enabled = false
			this.ddlb_autosendcrsdatatime.enabled = false
		end if
	else
		messagebox("Job", "Unable to fetch job status for Auto CRS Data Sending Service From CRS Client Server.")
	end if
	return ::message.returnvalue

// rb_autosendcrsdataevery.clicked() returns long
	if this.checked = true then
		parent.dw_autosendcrsdataschedule.enabled = true
		parent.ddlb_autosendcrsdatahr.enabled = false
		parent.ddlb_autosendcrsdatamin.enabled = false
		parent.ddlb_autosendcrsdatasec.enabled = false
		parent.ddlb_autosendcrsdatatime.enabled = false
	end if
	return ::message.returnvalue

// rb_autosendcrsdataonce.clicked() returns long
	if this.checked = true then
		parent.dw_autosendcrsdataschedule.enabled = true
		parent.ddlb_autosendcrsdatahr.enabled = true
		parent.ddlb_autosendcrsdatamin.enabled = true
		parent.ddlb_autosendcrsdatasec.enabled = true
		parent.ddlb_autosendcrsdatatime.enabled = true
	end if
	return ::message.returnvalue

// cbx_activateautosendcrsdata.clicked() returns long
	if this.checked = true then
		parent.rb_autosendcrsdataonce.enabled = true
		parent.rb_autosendcrsdataevery.enabled = true
		parent.dw_autosendcrsdataschedule.enabled = false
		parent.ddlb_autosendcrsdatahr.enabled = true
		parent.ddlb_autosendcrsdatamin.enabled = true
		parent.ddlb_autosendcrsdatasec.enabled = true
		parent.ddlb_autosendcrsdatatime.enabled = true
	else
		parent.rb_autosendcrsdataevery.enabled = false
		parent.rb_autosendcrsdataonce.enabled = false
		parent.dw_autosendcrsdataschedule.enabled = false
		parent.ddlb_autosendcrsdatahr.enabled = false
		parent.ddlb_autosendcrsdatamin.enabled = false
		parent.ddlb_autosendcrsdatasec.enabled = false
		parent.ddlb_autosendcrsdatatime.enabled = false
	end if
	return ::message.returnvalue

// dw_control.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	choose case dwo.name
	case "b_senddata"
		parent.wf_perform_task(dwo.name)
	end choose
	return ::message.returnvalue

// cb_saveandclose.clicked() returns long
	double ld_expirydays
	integer li_cashsalepostingtime
	integer li_creditsalepostingtime
	integer li_counter
	long ll_retcode
	boolean lb_commitok
	string ls_errtext
	string ls_errtitle
	string ls_errmodule
	string ls_string
	string ls_jobname
	string ls_schedulename
	string ls_hr
	string ls_min
	string ls_sec
	string ls_activetime
	string ls_ampm
	integer li_unitvalue
	integer li_unit
	integer li_hr
	long ll_activetime
	if lb_commitok then
		ls_jobname = gs_autosendcrsdatajob
		ls_schedulename = gs_autosendcrsdatajobschedule
		if parent.cbx_activateautosendcrsdata.checked = true then
			if parent.rb_autosendcrsdataonce.checked = true then
				ls_hr = parent.ddlb_autosendcrsdatahr.text
				ls_min = parent.ddlb_autosendcrsdatamin.text
				ls_sec = parent.ddlb_autosendcrsdatasec.text
				ls_ampm = parent.ddlb_autosendcrsdatatime.text
				if isnull(ls_hr) or ls_hr = "" or ls_hr = "none" then
					messagebox("Auto Send CRS Data Job Time Validation", "Please select hours from dropdown box.")
					parent.ddlb_autosendcrsdatahr.setfocus()
					return ::message.returnvalue
				elseif isnull(ls_min) or ls_min = "" or ls_min = "none" then
					messagebox("Auto Send CRS Data Time Validation", "Please select minutes from dropdown box.")
					parent.ddlb_autosendcrsdatamin.setfocus()
					return ::message.returnvalue
				elseif isnull(ls_sec) or ls_sec = "" or ls_sec = "none" then
					messagebox("Auto Send CRS Data Time Validation", "Please select seconds from dropdown box.")
					parent.ddlb_autosendcrsdatasec.setfocus()
					return ::message.returnvalue
				elseif isnull(ls_ampm) or ls_ampm = "" or ls_ampm = "none" then
					messagebox("Auto Send CRS Data Time Validation", "Please select AM/PM from dropdown box.")
					parent.ddlb_autosendcrsdatatime.setfocus()
					return ::message.returnvalue
				end if
				li_hr = integer(ls_hr)
				if ls_ampm = "PM" then
					if li_hr < 12 then
						li_hr = li_hr + 12
					end if
				elseif li_hr = 12 then
					li_hr = 0
				end if
				ls_activetime = string(li_hr) + ls_min + ls_sec
				ll_activetime = long(ls_activetime)
				li_unit = 1
				li_unitvalue = 0
			else
				if parent.dw_autosendcrsdataschedule.accepttext() = 1 then
					li_unitvalue = parent.dw_autosendcrsdataschedule.getitemnumber(1, "unitvalue")
					li_unit = parent.dw_autosendcrsdataschedule.getitemnumber(1, "unit")
					if li_unit = 4 then
						if not (li_unitvalue >= 1 and li_unitvalue <= 1440) then
							messagebox("Auto Send CRS Data Time Validation", "Please enter valid value for minutes between 1 and 1440.")
							parent.dw_autosendcrsdataschedule.setcolumn(1)
							parent.dw_autosendcrsdataschedule.setfocus()
							return ::message.returnvalue
						end if
					elseif li_unit = 8 then
						if not (li_unitvalue >= 1 and li_unitvalue <= 24) then
							messagebox("Auto Send CRS Data Time Validation", "Please enter valid value for hours between 1 and 24.")
							parent.dw_autosendcrsdataschedule.setcolumn(2)
							parent.dw_autosendcrsdataschedule.setfocus()
							return ::message.returnvalue
						end if
					else
						messagebox("Auto Send CRS Data Time Validation", "Please select minutes/hours from dropdown list box")
						parent.dw_autosendcrsdataschedule.setcolumn(2)
						parent.dw_autosendcrsdataschedule.setfocus()
						return ::message.returnvalue
					end if
				else
					messagebox("Auto Send CRS Data Time Validation", "Please enter valid value for a unit.")
					parent.dw_autosendcrsdataschedule.setcolumn(1)
					parent.dw_autosendcrsdataschedule.setfocus()
					return ::message.returnvalue
				end if
				ll_activetime = 0
			end if
			sqlca.adjustjobschedule(ls_jobname, ls_schedulename, ll_activetime, li_unit, li_unitvalue)
			sqlca.activatejob(ls_jobname, 1)
		else
			sqlca.activatejob(ls_jobname, 0)
		end if
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
			messagebox("Job Error", "Unable to update Auto Send CRS Data job status.")
			setpointer(arrow!)
		end if
	else
		SQL rollback USING sqlca;
	end if
	setpointer(arrow!)
	parent.post event ue_close(1)
	return ::message.returnvalue
