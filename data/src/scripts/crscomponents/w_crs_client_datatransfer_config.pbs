// window w_crs_client_datatransfer_config (crscomponents)  ancestor: w_single_entry

// w_crs_client_datatransfer_config.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM crs_clientlist WHERE crs_clientlist.name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_crs_client_datatransfer_config.create() returns 0
	call super::create

// w_crs_client_datatransfer_config.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_crs_client_datatransfer_config.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "crs_clientlist"
	return ::message.returnvalue

// w_crs_client_datatransfer_config.ue_list() returns 0
	long ll_rtcode
	if this.id_list.rowcount() <= 0 then
		ll_rtcode = wf_retrieve()
	end if
	if ll_rtcode > 0 then
		this.im_menu.m_file.m_new.enabled = false
		this.im_menu.m_file.m_new.visible = false
		this.im_menu.m_file.m_save.enabled = false
		this.im_menu.m_file.m_delete.enabled = false
		this.im_menu.m_file.m_first.enabled = true
		this.im_menu.m_file.m_next.enabled = true
		this.im_menu.m_file.m_last.enabled = true
		this.im_menu.m_file.m_print.enabled = true
		this.im_menu.m_file.m_previous.enabled = true
		this.im_menu.m_file.m_retrieve.text = "De&tail"
		this.i_retrievemode = 2
		this.i_editmode = 2
		if this.il_selectedrow = 0 then
			wf_first()
			wf_selectunselectrow(1)
		end if
		this.tab_retrieve.tabpage_list.dw_find.setfocus()
		return
	end if
	messagebox("Result", "No rows or retrieved possible empty table~r~nInsert some rows first")
	postevent("ue_new")

// w_crs_client_datatransfer_config.ue_save() returns 0
	long ll_primarykey
	long ll_row
	setpointer(hourglass!)
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	ll_row = this.id_detail.getrow()
	if this.id_detail.update() > 0 then
		SQL commit USING sqlca;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		this.ib_commitok = true
		this.im_menu.m_file.m_new.enabled = true
		this.editflag = false
	else
		SQL rollback USING sqlca;
		setpointer(arrow!)
		messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs", exclamation!, ok!, 1)
		return
	end if
	setpointer(arrow!)
