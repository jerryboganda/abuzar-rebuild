// w_serviceresult_form.wf_getserviceinfo(long al_code, ref string as_errtext, ref long al_resultcode) returns long
	datetime ldt_servicedate
	datetime ldt_dob
	datetime ldt_deliverydate
	long ll_retcode
	long ll_rowcount
	long ll_counter
	long ll_res
	long ll_row
	long ll_servicecount
	long ll_serviceinvcode
	long ll_resultcode
	long ll_pk
	char lc_posted
	char ls_resultposted
	datastore lds_services
	setnull(al_resultcode)
	SQL SELECT POSTED INTO :lc_posted FROM DBO.ServiceHeader WHERE ServiceInvCode =:al_code USING sqlca;
	if sqlca.sqlcode = 0 and upper(lc_posted) = "N" then
		as_errtext = "Service Invoice not yet posted.~r~nKindly make sure it is posted first and then try to enter service result."
		return 1
	end if
	SQL SELECT serviceinvcode , resultcode =( select max ( SRH.ServiceResultcode ) FROM ServiceResultHeader SRH WHERE ServiceInvCode =:al_code ) INTO :ll_serviceinvcode, :ll_resultcode FROM DBO.ServiceHeader WHERE ServiceInvCode =:al_code AND Posted ='Y' AND ServiceInvCode IN ( SELECT SRH.ServiceInvCode FROM ServiceResultHeader SRH WHERE SRH.ServiceInvCode =:al_code ) USING sqlca;
	if sqlca.sqlcode = 0 then
		if ll_serviceinvcode > 0 then
			if ll_resultcode > 0 then
				SQL SELECT Posted INTO :ls_resultposted FROM ServiceResultHeader WHERE ServiceResultcode =:ll_resultcode USING this.it_transobject;
				if upper(ls_resultposted) = "Y" then
					as_errtext = "Result For this Service Invoice already entered and posted.~r~nService Result Code=" + trim(string(ll_resultcode))
					return 1
				else
					al_resultcode = ll_resultcode
					this.id_master.retrieve(ll_resultcode)
					this.id_detail.retrieve(ll_resultcode)
					this.id_detail.setredraw(false)
					this.id_detail.sort()
					this.id_detail.groupcalc()
					this.id_detail.setredraw(true)
					return 0
				end if
			else
				as_errtext = "Result For this Service Invoice already entered."
				return 1
			end if
		else
			this.id_master.reset()
			this.id_detail.reset()
		end if
	end if
	lds_services = create datastore
	lds_services.dataobject = "d_serviceinv_service_result_required"
	lds_services.settransobject(sqlca)
	SQL SELECT servicecount =( SELECT COUNT ( SD.ServiceCode ) FROM ServiceDetail SD , Service SV WHERE SD.ServiceInvCode =:al_code AND SD.ServiceCode =SV.ServiceCode AND SV.ResultRequired ='Y' ) INTO :ll_servicecount FROM DBO.ServiceHeader WHERE ServiceInvCode =:al_code AND Posted ='Y' AND ServiceInvCode NOT IN ( SELECT SRH.ServiceInvCode FROM ServiceResultHeader SRH WHERE SRH.ServiceInvCode =:al_code ) USING sqlca;
	if sqlca.sqlcode = 0 then
		if isnull(ll_servicecount) or ll_servicecount = 0 then
			as_errtext = "This Service Invoice Does not contain any service for which service result is required~r~nPlease enter a valid service invoice code."
			ll_retcode = 1
		else
			if this.id_detail.rowcount() > 0 then
				ll_res = messagebox("", "Detail Rows will lost. Are you sure to populated Services?", question!, yesno!, 1)
				if ll_res = 1 then
					ll_pk = this.id_master.object.code[1]
					if ll_pk > 0 then
						this.id_master.reset()
						this.id_master.insertrow(0)
						this.id_master.object.serviceinvcode[1] = al_code
					end if
					this.id_detail.reset()
					ll_retcode = 0
				else
					ll_retcode = 1
				end if
			end if
			ll_retcode = 0
		end if
	else
		as_errtext = "Service Info. Retrieval Error.~r~nProblem in retrieval of Service Information.~r~nReasons are:-" + sqlca.sqlerrtext
		ll_retcode = 1
	end if
	if ll_retcode = 0 then
		lds_services.retrieve(al_code)
		if lds_services.rowcount() > 0 then
			if this.id_master.rowcount() <= 0 then
				this.id_master.insertrow(0)
			end if
			ll_retcode = wf_set_service_info(al_code)
			if ll_retcode = 0 then
				this.id_detail.setredraw(false)
				this.id_detail.sort()
				this.id_detail.groupcalc()
				this.id_detail.setredraw(true)
			end if
		else
			as_errtext = "No Service Selected From Service List~r~nPerhaps this Service Invoice Does not contain any service for which service result is required~r~nPlease enter a valid service invoice code"
			ll_retcode = 1
		end if
	end if
	return ll_retcode

// w_serviceresult_form.wf_edit_componentvalue(datawindow adw_object, long al_row, integer ai_mode) returns long
	long ll_servicecompcode
	long ll_options
	long ll_comptypesetting
	long ll_typecode
	long ll_servicecode
	long ll_compvalue
	long ll_ref1
	long ll_ref2
	string ls_compvalue
	string ls_ref1
	string ls_ref2
	double ld_compvalue
	double ld_ref1
	double ld_ref2
	string ls_objectname = "w_componentvalue_text"
	char lc_askunit
	char lc_askcomments
	s_compvalue lstr_value
	if upper(this.id_master.object.posted[1]) = "Y" then
		return 0
	end if
	if al_row > 0 then
		adw_object.setrow(al_row)
		adw_object.scrolltorow(al_row)
		ll_servicecode = adw_object.object.servicecode[al_row]
		ll_servicecompcode = adw_object.object.servicecomponentcode[al_row]
		ll_typecode = adw_object.object.servicecomponenttypecode[al_row]
		lstr_value.code = ll_servicecompcode
		lstr_value.id = adw_object.object.rowid[al_row]
		lstr_value.datatype = adw_object.object.valuetype[al_row]
		lstr_value.value = adw_object.object.componentvalue[al_row]
		ll_options = wf_check_options(ll_servicecompcode)
		ll_comptypesetting = wf_get_servicecomponenttype_info(ll_typecode, lc_askunit, lc_askcomments)
		lstr_value.status = true
		if upper(lc_askunit) = "Y" then
			if ai_mode = 0 then
				if ll_options > 0 then
					openwithparm(w_componentvalue_dropdown, lstr_value)
				elseif ll_options = 0 and lstr_value.datatype = "S" then
					openwithparm(w_componentvalue_text, lstr_value)
				elseif ll_options = 0 and lstr_value.datatype = "N" then
					openwithparm(w_componentvalue_long, lstr_value)
				elseif ll_options = 0 and lstr_value.datatype = "D" then
					openwithparm(w_componentvalue_decimal, lstr_value)
				else
					openwithparm(w_componentvalue_text, lstr_value)
				end if
				lstr_value = message.powerobjectparm
			end if
			if lstr_value.status then
				lstr_value = lstr_value
				adw_object.object.componentvalue[al_row] = lstr_value.value
				wf_set_remarks(al_row)
			end if
		end if
	end if
	return 0

// w_serviceresult_form.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_serviceresultmenu" then
		this.menuid = create m_serviceresultmenu
	end if

// w_serviceresult_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_serviceresult_form.ue_save() returns 0 [event]
	long ll_mastercurrrow
	long ll_invid
	long ll_detailrows
	long ll_usercode
	long ll_servicerowid
	integer li_counter
	boolean lb_commitflag = true
	datetime ldt_server_datetime
	string ls_date_errtext
	if this.id_master.rowcount() > 0 and (isnull(this.id_master.object.serviceinvcode[1]) or this.id_master.object.serviceinvcode[1] = 0) then
		this.id_master.setcolumn("serviceinvcode")
		this.id_master.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and (isnull(this.id_detail.object.servicerowid[1]) or isnull(this.id_detail.object.servicecomponentcode[1])) then
		this.id_detail.setrow(1)
		this.id_detail.scrolltorow(1)
		event ue_deleteitem()
	end if
	if this.id_detail.rowcount() = 0 then
		messagebox("Service Result Validation", "No Service Result entered~r~nPerhaps this Service Invoice Does not contain any service for which service result is required~r~nPlease enter a valid service invoice code", stopsign!)
		setpointer(arrow!)
		return
	end if
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	setpointer(hourglass!)
	ll_mastercurrrow = this.id_master.getrow()
	ll_invid = this.id_master.object.code[ll_mastercurrrow]
	ll_usercode = gl_usercode
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		setpointer(arrow!)
		return
	end if
	if isnull(ll_invid) then
		f_newtableid("serviceresultheader", ll_invid)
		this.id_master.object.code[ll_mastercurrrow] = ll_invid
		this.id_master.setitem(ll_mastercurrrow, "usercode", ll_usercode)
		this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
	end if
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	do while li_counter <= ll_detailrows and lb_commitflag = true
		this.id_detail.setitem(li_counter, "code", ll_invid)
		li_counter = li_counter + 1
	loop
	if this.id_master.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return
	end if
	if this.id_detail.update() > 0 then
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		this.ib_commitok = true
		this.id_master.resetupdate()
		this.im_menu.m_file.m_new.enabled = true
		this.editflag = false
		if gd_recenttransdate < this.id_systemdate then
			gd_recenttransdate = this.id_systemdate
		end if
	else
		SQL rollback USING this.it_transobject;
		messagebox("Database Problem", "Some Database Problem Occured in saving Service Result Detail!", stopsign!)
		setpointer(arrow!)
		return
	end if
	setpointer(arrow!)

// w_serviceresult_form.ue_newform() returns 0 [event]
	long ll_null
	call super::ue_newform
	this.id_master.setfocus()
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	setnull(ll_null)
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_print.visible = true
	this.id_master.setcolumn("serviceinvcode")
	this.id_master.setfocus()

// w_serviceresult_form.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.insertrow(0)
	this.id_detail.setcolumn("servicerowid")
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.ib_validatefullcode = true

// w_serviceresult_form.ue_detail() returns 0 [event]
	m_serviceresultmenu lm_menu
	integer li_protect
	call super::ue_detail
	lm_menu = this.menuid
	if this.id_master.rowcount() > 0 then
		this.im_menu.m_file.m_print.visible = true
		this.im_menu.m_file.m_print.enabled = true
		if this.id_master.object.posted[1] = "Y" then
			li_protect = 1
			this.im_menu.m_file.m_save.visible = false
			this.im_menu.m_file.m_save.enabled = false
		else
			this.im_menu.m_file.m_save.visible = true
			this.im_menu.m_file.m_save.enabled = true
			this.im_menu.m_file.m_post.enabled = false
			li_protect = 0
		end if
		wf_protectdw(this.id_master, li_protect)
		wf_protectdw(this.id_detail, li_protect)
	end if

// w_serviceresult_form.ue_postopen() returns 0 [event]
	long ll_null
	call super::ue_postopen
	setnull(ll_null)
	this.id_detail.object.askcomments.initial = "Y"
	this.id_detail.object.b_comments.visible = false
	if f_stringpreferences("showserviceinvnoinserviceresult") = "N" then
		this.id_detail.object.serviceinvcode.visible = false
	end if
	if f_stringpreferences("showserviceheadinserviceresult") = "N" then
		this.id_detail.object.servicehead.visible = false
	end if
	if f_stringpreferences("showmachineinserviceresult") = "N" then
		this.id_detail.object.testmachinecode.visible = false
	end if
	if f_stringpreferences("showresultvalue2") = "N" then
		this.id_detail.object.componentvalue2.visible = false
	end if
	if f_stringpreferences("showremarksinserviceresult") = "N" then
		this.id_detail.object.remarks.visible = false
	end if
	if f_stringpreferences("enforce_svccomp_data_to_validate_resultvalue") = "Y" then
		this.ib_validate_result_value = true
		this.id_detail.object.componentvalue.protect = "0"
		this.id_detail.object.componentvalue.protect = "0"
	else
		this.id_detail.object.componentvalue.protect = "1"
		this.id_detail.object.componentvalue2.protect = "1"
	end if
	this.id_detail.object.b_comments.visible = true
	if f_rightexists(5050) then
		this.ib_regen_serviceresult = true
		return
	end if
	this.ib_regen_serviceresult = false

// w_serviceresult_form.ue_deleteitem() returns 0 [event]

// w_serviceresult_form.ue_list() returns 0 [event]
	m_serviceresultmenu lm_menu
	call super::ue_list
	lm_menu = this.menuid
	lm_menu.m_file.m_save.enabled = false
	lm_menu.m_file.m_post.enabled = true

// w_serviceresult_form.ue_new() returns 0 [event]
	long ll_null
	call super::ue_new
	setnull(ll_null)

// w_serviceresult_form.ue_print() returns 0 [event]
	integer li_option
	integer li_printcode = 1
	long ll_code
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_code) or ll_code <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_code = this.id_master.getitemnumber(1, "code")
	end if
	this.id_print = this.tab_retrieve.tabpage_detail.dw_print
	wf_set_serviceresultformat(ll_code)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" then
		li_printcode = printsetup()
		if li_printcode < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
	end if
	if this.id_print.rowcount() > 0 and li_printcode > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
	else
		messagebox("Printing Error", "Can not Print Data,~r~nNo rows are retrieved", information!)
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		postevent("ue_new")
	end if

// tabpage_detail.create() returns 0 [event]
	integer icurrent
	this.dw_print = create dw_print
	call super::create
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print

// tabpage_detail.destroy() returns 0 [event]
	call super::destroy
	destroy this.dw_print

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "name"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	end choose
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_errtext
	long ll_resultcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "serviceinvcode"
		if parent.parent.parent.wf_getserviceinfo(long(data), ls_errtext, ll_resultcode) > 0 then
			messagebox("Service Invoice Code Validation", "Not a valid Service Invoice Code~r~n" + ls_errtext, stopsign!)
			return 1
		end if
	end choose
	return ::message.returnvalue

// dw_detail.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	if len(gettext()) > 0 then
		selecttext(1, len(gettext()))
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	string ls_managername
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "testmachinecode"
		if long(data) > 0 then
			if parent.parent.parent.wf_set_machine_based_ref_value(long(data), row) = 0 then
				return 0
			else
				messagebox("Machine Validation", "Please select valid machine", stopsign!)
				return 1
			end if
		else
			messagebox("Machine Validation", "Please select valid machine", stopsign!)
			return 1
		end if
	case "componentvalue"
		parent.parent.parent.wf_edit_componentvalue(this, row, 1)
		return 0
	case "srvrowid"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_itemvalidated = false
		li_errcode = 0
	case else
		parent.parent.parent.ib_itemvalidated = true
	end choose
	return li_errcode

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "srvrowid"
		if data = "" or isnull(data) then
			messagebox("Service Validation", "Value required Service in current row")
		end if
	end choose
	return 1

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	parent.parent.parent.id_itemslist.hide()
	setfocus()
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		setcolumn("componentvalue")
		setfocus()
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf5! and getrow() > 0 then
		parent.parent.parent.wf_edit_comments(this.object.servicecomponentcode[getrow()], getrow())
	end if
	return ::message.returnvalue

// dw_itemsdetail.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	string ls_controlname
	string ls_temp
	ancestorreturnvalue = super::doubleclicked(xpos, ypos, row, dwo)
	if row > 0 and parent.parent.parent.ib_validate_result_value then
		choose case dwo.name
		case "b_comments"
			parent.parent.parent.wf_edit_comments(this.object.servicecomponentcode[row], row)
		case "componentvalue"
			parent.parent.parent.wf_edit_componentvalue(this, row, 0)
		case "componentvalue2"
			parent.parent.parent.wf_edit_componentvalue2(this, row)
		end choose
	end if
	return ::message.returnvalue

// dw_find.keypressed(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	long ll_row
	long ll_code
	long ll_serviceinvcode
	long ll_usercode
	string ls_errtext
	w_transactionwindow lw_sheet
	ancestorreturnvalue = super::keypressed(key, keyflags)
	if key = keyf6! then
		ll_row = parent.parent.parent.id_list.getrow()
		if ll_row > 0 then
			ll_serviceinvcode = parent.parent.parent.id_list.object.serviceinvcode[ll_row]
			openwithparm(lw_sheet, 1)
			ll_code = message.doubleparm
			if ll_code > 0 and ll_serviceinvcode > 0 then
				parent.parent.parent.wf_set_servicebalance(ll_serviceinvcode, ll_code)
			end if
		end if
	end if
	if key = keyf7! and parent.parent.parent.ib_regen_serviceresult = true then
		ll_row = parent.parent.parent.id_list.getrow()
		if ll_row > 0 then
			ll_serviceinvcode = parent.parent.parent.id_list.object.serviceinvcode[ll_row]
			open(w_salesmanpassword)
			ll_usercode = long(message.doubleparm)
			if ll_serviceinvcode > 0 and ll_usercode > 0 then
				SQL rollback USING parent.parent.parent.it_transobject;
				parent.parent.parent.it_transobject.regenerateserviceresult(ll_serviceinvcode, ll_usercode)
				if parent.parent.parent.it_transobject.sqlcode = 0 then
					SQL commit USING parent.parent.parent.it_transobject;
					messagebox("Service Result Re-Generation", "Successfully Regenerated Desired Service Result")
				else
					ls_errtext = "Problem in Re-Generation of Service Result.~r~nReasons Are:-~r~n" + parent.parent.parent.it_transobject.sqlerrtext
					SQL rollback USING parent.parent.parent.it_transobject;
					messagebox("Service Result Re-Generation", ls_errtext)
				end if
			end if
		end if
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue
