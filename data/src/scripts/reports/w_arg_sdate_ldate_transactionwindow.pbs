// window w_arg_sdate_ldate_transactionwindow (reports)  ancestor: w_arguements

// w_arg_sdate_ldate_transactionwindow.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.gb_2 = create gb_2
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.gb_2

// w_arg_sdate_ldate_transactionwindow.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.gb_2

// w_arg_sdate_ldate_transactionwindow.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// w_arg_sdate_ldate_transactionwindow.open() returns long
	long ancestorreturnvalue
	long ll_rtcode
	ancestorreturnvalue = super::open()
	this.il_catcode = message.doubleparm
	this.dw_control.settransobject(sqlca)
	ll_rtcode = this.dw_control.getchild("documentcode", this.idc_list)
	if ll_rtcode = -1 then
		messagebox("Error", "Not a DataWindowChild")
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	this.idc_list.settransobject(sqlca)
	if this.idc_list.rowcount() <= 0 then
		this.idc_list.insertrow(0)
	end if
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.idc_list.retrieve(this.il_catcode)
	this.dw_control.setfocus()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue
