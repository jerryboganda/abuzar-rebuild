// window w_arg_sdate_ldate_margin_markup_range (reports)  ancestor: w_arguements

// w_arg_sdate_ldate_margin_markup_range.create() returns 0 [event]
	call super::create

// w_arg_sdate_ldate_margin_markup_range.destroy() returns 0 [event]
	call super::destroy

// w_arg_sdate_ldate_margin_markup_range.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// w_arg_sdate_ldate_margin_markup_range.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.insertrow(0)
	return ::message.returnvalue

// dw_control.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.dw_control.accepttext()
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if parent.dw_control.object.startperc[1] > parent.dw_control.object.endperc[1] then
		messagebox("Minmum Percentage", "Minimum Percentage is Greater than Maximum~r~nPlease Correct this parameter", stopsign!)
		parent.dw_control.setfocus()
		parent.dw_control.setcolumn("startperc")
		return ::message.returnvalue
	end if
	parent.istr_arg.s_name1 = parent.dw_control.object.criteria[1]
	parent.istr_arg.db_code1 = parent.dw_control.object.startperc[1]
	parent.istr_arg.db_code2 = parent.dw_control.object.endperc[1]
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
