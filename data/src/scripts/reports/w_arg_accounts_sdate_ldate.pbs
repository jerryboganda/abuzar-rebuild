// window w_arg_accounts_sdate_ldate (reports)  ancestor: w_listarguments

// w_arg_accounts_sdate_ldate.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8

// w_arg_accounts_sdate_ldate.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_8

// w_arg_accounts_sdate_ldate.open() returns long [event]
	long ancestorreturnvalue
	string ls_stringparam
	string ls_filter
	long ll_counter
	long ll_rowcount
	integer rtncode
	listviewitem l_lvi
	ancestorreturnvalue = super::open()
	ls_stringparam = message.stringparm
	this.dw_control.settransobject(sqlca)
	rtncode = this.dw_control.retrieve()
	if rtncode = -1 then
		messagebox("Error", "No Account(s) To Select")
	else
		ls_filter = "restricted='N' AND "
		if f_rightexists(533) then
			ls_filter = ""
		end if
		if ls_stringparam = "C" then
			ls_filter = ls_filter + "subcode=3"
		elseif ls_stringparam = "S" then
			ls_filter = ls_filter + "subcode=7"
		elseif ls_stringparam = "O" then
			ls_filter = ls_filter + "subcode<>3 AND subcode<>7"
		elseif ls_stringparam = "CSH" then
			ls_filter = ls_filter + "subcode=2"
		elseif ls_stringparam = "BNK" then
			ls_filter = ls_filter + "subcode=4"
		else
			ls_filter = ls_filter + ""
		end if
		this.dw_control.setfilter(ls_filter)
		this.dw_control.filter()
		ll_rowcount = this.dw_control.rowcount()
		ll_counter = 1
		for ll_counter = 1 to ll_rowcount
			this.lb_categories.additem(this.dw_control.getitemstring(ll_counter, "name"))
		next
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_found
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.dw_control.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.dw_control.getitemnumber(ll_counter, "acccode")
		next
	else
		for ll_counter = 1 to ll_counter
			ll_found = parent.dw_control.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.dw_control.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.dw_control.getitemnumber(ll_found, "acccode")
			end if
		next
	end if
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
