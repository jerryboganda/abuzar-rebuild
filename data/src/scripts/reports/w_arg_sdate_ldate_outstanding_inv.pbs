// window w_arg_sdate_ldate_outstanding_inv (reports)  ancestor: w_arguements

// w_arg_sdate_ldate_outstanding_inv.create() returns 0 [event]
	integer icurrent
	call super::create
	this.cbx_outstandinginv = create cbx_outstandinginv
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_outstandinginv

// w_arg_sdate_ldate_outstanding_inv.destroy() returns 0 [event]
	call super::destroy
	destroy this.cbx_outstandinginv

// w_arg_sdate_ldate_outstanding_inv.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if parent.cbx_outstandinginv.checked then
		parent.istr_arg.s_name1 = "Y"
	else
		parent.istr_arg.s_name1 = "N"
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
