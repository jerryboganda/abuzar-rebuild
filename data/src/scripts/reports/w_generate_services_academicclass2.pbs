// window w_generate_services_academicclass2 (reports)  ancestor: window

// w_generate_services_academicclass2.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		post event ue_close()
	end if
	return ::message.returnvalue

// w_generate_services_academicclass2.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// w_generate_services_academicclass2.create() returns 0 [event]
	this.dw_footer = create dw_footer
	this.dw_master = create dw_master
	this.cb_retrieve = create cb_retrieve
	this.cb_ok = create cb_ok
	this.dw_detail = create dw_detail
	this.control = {this.dw_footer, this.dw_master, this.cb_retrieve, this.cb_ok, this.dw_detail}

// w_generate_services_academicclass2.destroy() returns 0 [event]
	destroy this.dw_footer
	destroy this.dw_master
	destroy this.cb_retrieve
	destroy this.cb_ok
	destroy this.dw_detail

// w_generate_services_academicclass2.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	this.istr_arg = message.powerobjectparm
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		this.width = ll_win_width * 0.98
		this.height = ll_win_height * 0.90
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	this.dw_detail.width = this.width * 0.98
	this.dw_detail.height = this.height - this.dw_master.height - 230
	this.cb_retrieve.y = this.height - 200
	this.cb_ok.y = this.height - 200
	this.dw_master.settransobject(sqlca)
	this.dw_detail.settransobject(sqlca)
	this.dw_footer.settransobject(sqlca)
	this.dw_master.retrieve()
	this.dw_master.scrolltorow(0)
	this.dw_master.setfocus()
	this.dw_detail.retrieve(this.istr_arg.ia_integerlist)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_master.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// cb_retrieve.clicked() returns long [event]
	string ls_filter
	long ll_masterrow
	parent.dw_master.accepttext()
	ll_masterrow = parent.dw_master.getrow()
	parent.dw_detail.setredraw(false)
	parent.dw_detail.retrieve(parent.istr_arg.ia_integerlist)
	parent.dw_detail.setredraw(true)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ll_rowcount
	long ll_counter
	long ll_servicecode
	long ll_studentcode
	long ll_classcode
	long ll_serviceinvcode
	double ld_fee
	double ld_discperc
	double ld_flatdisc
	string ls_remarks
	string ls_studentname
	string ls_classname
	string ls_servicename
	boolean lb_ok
	string ls_date
	u_transaction lt_transobject
	ll_rowcount = parent.dw_detail.rowcount()
	for ll_counter = 1 to ll_rowcount
		if parent.dw_detail.getitemstring(ll_counter, "selected") = "Y" then
			ll_classcode = parent.dw_detail.object.classcode[ll_counter]
			ll_studentcode = parent.dw_detail.object.studentcode[ll_counter]
			ll_servicecode = parent.dw_detail.object.servicecode[ll_counter]
			ls_classname = parent.dw_detail.object.classname[ll_counter]
			ls_servicename = parent.dw_detail.object.servicename[ll_counter]
			ls_studentname = parent.dw_detail.object.studentname[ll_counter]
			ld_fee = parent.dw_detail.object.fee[ll_counter]
			ld_flatdisc = parent.dw_detail.object.flatdiscount[ll_counter]
			ld_discperc = parent.dw_detail.object.discperc[ll_counter]
			if (ld_fee - ld_flatdisc) * (1.0 - ld_discperc * 0.01) < 0.0 then
				goto L1100
			end if
			messagebox("Student Fee Generation Problem", "Negative Fee Generation Ordered.~r~nClass Name = " + ls_classname + "~r~nService Name = " + ls_servicename + "~r~nStudent Name = " + ls_studentname)
			lb_ok = false
			parent.dw_detail.setrow(ll_counter)
			parent.dw_detail.scrolltorow(ll_counter)
			parent.dw_detail.setcolumn("FlatDiscount")
			parent.dw_detail.setfocus()
			exit
		end if
	next
	if lb_ok then
		lt_transobject = create u_transaction
		SQL start USING lt_transobject;
		if lt_transobject.sqlcode = 0 then
			parent.istr_arg.l_code1 = parent.dw_master.getitemnumber(parent.dw_master.getrow(), "classcode")
			parent.istr_arg.l_code2 = parent.dw_master.getitemnumber(parent.dw_master.getrow(), "servicecode")
			ls_remarks = parent.dw_master.getitemstring(parent.dw_master.getrow(), "remarks")
			ll_rowcount = parent.dw_detail.rowcount()
			for ll_counter = 1 to ll_rowcount
				if parent.dw_detail.getitemstring(ll_counter, "selected") = "Y" then
					ll_classcode = parent.dw_detail.object.classcode[ll_counter]
					ll_studentcode = parent.dw_detail.object.studentcode[ll_counter]
					ll_servicecode = parent.dw_detail.object.servicecode[ll_counter]
					ls_classname = parent.dw_detail.object.classname[ll_counter]
					ls_servicename = parent.dw_detail.object.servicename[ll_counter]
					ls_studentname = parent.dw_detail.object.studentname[ll_counter]
					ld_fee = parent.dw_detail.object.fee[ll_counter]
					ld_flatdisc = parent.dw_detail.object.flatdiscount[ll_counter]
					ld_discperc = parent.dw_detail.object.discperc[ll_counter]
					lt_transobject.generate_svc_for_studentfee_template(ll_classcode, ll_studentcode, ls_remarks, ll_servicecode, ld_fee, ld_flatdisc, ld_discperc, gl_usercode, parent.istr_arg.l_code10, ll_serviceinvcode)
					if lt_transobject.sqlcode <> 0 then
						goto L2484
					end if
					messagebox("Student Fee Generation", "Some Problem Occurred while Generating Student Fee.~r~nClass Name = " + ls_classname + "~r~nService Name = " + ls_servicename + "~r~nStudent Name = " + ls_studentname + "~r~n~r~nDetails are:-~r~n" + lt_transobject.sqlerrtext)
					SQL rollback USING lt_transobject;
					lb_ok = false
					exit
				end if
			next
			if lb_ok then
				parent.istr_arg.i_status = 1
				SQL commit USING lt_transobject;
				if lt_transobject.sqlcode = 0 then
					parent.post event ue_close()
				else
					messagebox("Student Fee Generation", "Some Problem Occurred while Generating Student Fee.~r~nDetails are:-~r~n" + lt_transobject.sqlerrtext)
				end if
			end if
		else
			messagebox("Database Connection Problem", "Some Database Connection Problem Occurred~r~nDetails are:-~r~n" + lt_transobject.sqlerrtext)
			return ::message.returnvalue
		end if
		return
	end if
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_detail.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	selecttext(1, len(gettext()))
	return ::message.returnvalue
