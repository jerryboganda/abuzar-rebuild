// window w_arg_account_godowns (reports)  ancestor: w_listarguments

// w_arg_account_godowns.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8

// w_arg_account_godowns.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.st_8

// w_arg_account_godowns.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	long ll_acccode
	integer rtncode
	ancestorreturnvalue = super::open()
	ll_acccode = message.doubleparm
	if ll_acccode > 0 then
		this.dw_control.settransobject(sqlca)
		rtncode = this.dw_control.getchild("gcode", this.idc_categories)
		if rtncode = -1 then
			messagebox("Error", "Not a DataWindowChild")
		end if
		this.idc_categories.settransobject(sqlca)
		this.idc_categories.retrieve(ll_acccode)
		ll_rowcount = this.idc_categories.rowcount()
		if this.idc_categories.rowcount() > 0 then
			for ll_counter = 1 to ll_rowcount
				this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
			next
		end if
		this.dw_control.insertrow(0)
		this.dw_control.scrolltorow(0)
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue
