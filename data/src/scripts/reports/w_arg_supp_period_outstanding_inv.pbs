// window w_arg_supp_period_outstanding_inv (reports)  ancestor: w_popup_forselection_walias

// w_arg_supp_period_outstanding_inv.create() returns 0
	integer icurrent
	call super::create
	this.gb_2 = create gb_2
	this.st_1 = create st_1
	this.st_2 = create st_2
	this.em_startdate = create em_startdate
	this.em_enddate = create em_enddate
	this.cbx_all = create cbx_all
	this.dw_detail = create dw_detail
	this.cb_retrieve = create cb_retrieve
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_2
	this.control[icurrent + 2] = this.st_1
	this.control[icurrent + 3] = this.st_2
	this.control[icurrent + 4] = this.em_startdate
	this.control[icurrent + 5] = this.em_enddate
	this.control[icurrent + 6] = this.cbx_all
	this.control[icurrent + 7] = this.dw_detail
	this.control[icurrent + 8] = this.cb_retrieve

// w_arg_supp_period_outstanding_inv.destroy() returns 0
	call super::destroy
	destroy this.gb_2
	destroy this.st_1
	destroy this.st_2
	destroy this.em_startdate
	destroy this.em_enddate
	destroy this.cbx_all
	destroy this.dw_detail
	destroy this.cb_retrieve

// w_arg_supp_period_outstanding_inv.open() returns long
	long ancestorreturnvalue
	date ld_currdate
	string ls_text
	ancestorreturnvalue = super::open()
	ld_currdate = today()
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 00:00:00"
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.em_enddate.text = ls_text
	this.dw_detail.settransobject(sqlca)
	return ::message.returnvalue

// w_arg_supp_period_outstanding_inv.ue_close() returns 0
	closewithreturn(this, this.istr_arg)

// em_startdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_enddate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// cbx_all.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// cb_retrieve.clicked() returns long
	if parent.cbx_all.checked = true then
		parent.istr_arg.l_code1 = 0
	else
		if parent.id_selected.accepttext() = -1 then
			parent.id_selected.setfocus()
			return ::message.returnvalue
		elseif isnull(parent.id_selected.getitemstring(parent.id_selected.getrow(), "name")) then
			messagebox("Name Validation", "Please enter valid value for Name.")
			parent.id_selected.setcolumn(1)
			parent.id_selected.setfocus()
			return ::message.returnvalue
		end if
		parent.istr_arg.l_code1 = parent.id_selected.getitemnumber(1, "code")
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.dw_detail.retrieve(parent.istr_arg.l_code1, parent.istr_arg.d_sdate, parent.istr_arg.d_edate)
	return ::message.returnvalue
