// window w_arg_po_generate_from_quot (reports)  ancestor: w_arguements

// w_arg_po_generate_from_quot.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.dw_weekday = create dw_weekday
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.dw_weekday

// w_arg_po_generate_from_quot.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.dw_weekday

// w_arg_po_generate_from_quot.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// w_arg_po_generate_from_quot.open() returns long [event]
	long ancestorreturnvalue
	datetime ldt_date
	ancestorreturnvalue = super::open()
	this.dw_price.settransobject(sqlca)
	this.dw_price.insertrow(0)
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_weekday.settransobject(sqlca)
	this.dw_weekday.insertrow(0)
	this.em_enddate.getdata(ldt_date)
	this.dw_weekday.retrieve(ldt_date)
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_price.object.purordercatcode[1]
	if isnull(parent.istr_arg.l_code1) or parent.istr_arg.l_code1 <= 0 then
		messagebox("Purchase Order Category Validation", "Please select a valid Purchase Order Category", stopsign!)
		return ::message.returnvalue
	end if
	parent.istr_arg.l_code2 = parent.dw_control.object.suppcode[1]
	if isnull(parent.istr_arg.l_code2) or parent.istr_arg.l_code2 <= 0 then
		messagebox("Supplier Validation", "Please select a valid Supplier", stopsign!)
		return ::message.returnvalue
	end if
	if parent.cbx_supress.checked = true then
		parent.istr_arg.l_code2 = 1
	else
		parent.istr_arg.l_code2 = 0
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// cb_ok.getfocus() returns long [event]
	long ancestorreturnvalue
	datetime ldt_date
	ancestorreturnvalue = super::getfocus()
	parent.em_enddate.getdata(ldt_date)
	parent.dw_weekday.retrieve(ldt_date)
	return ::message.returnvalue

// em_enddate.losefocus() returns long [event]
	long ancestorreturnvalue
	datetime ldt_date
	ancestorreturnvalue = super::losefocus()
	getdata(ldt_date)
	parent.dw_weekday.retrieve(ldt_date)
	return ::message.returnvalue

// em_enddate.modified() returns long [event]
	long ancestorreturnvalue
	datetime ldt_date
	ancestorreturnvalue = super::modified()
	getdata(ldt_date)
	parent.dw_weekday.retrieve(ldt_date)
	return ::message.returnvalue

// em_enddate.keydown(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	datetime ldt_date
	ancestorreturnvalue = super::keydown(key, keyflags)
	getdata(ldt_date)
	parent.dw_weekday.retrieve(ldt_date)
	return ::message.returnvalue

// em_enddate.getfocus() returns long [event]
	long ancestorreturnvalue
	datetime ldt_date
	ancestorreturnvalue = super::getfocus()
	getdata(ldt_date)
	parent.dw_weekday.retrieve(ldt_date)
	return ::message.returnvalue
