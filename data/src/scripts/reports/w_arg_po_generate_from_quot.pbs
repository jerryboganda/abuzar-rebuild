// window w_arg_po_generate_from_quot (reports)  ancestor: w_arguements

// w_arg_po_generate_from_quot.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.dw_weekday = create dw_weekday
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.dw_weekday

// w_arg_po_generate_from_quot.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.dw_weekday

// w_arg_po_generate_from_quot.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// w_arg_po_generate_from_quot.open() returns long
	long ancestorreturnvalue
	datetime ldt_date
	ancestorreturnvalue = super::open()
	this.dw_price.settransobject(sqlca)
	this.dw_price.insertrow(0)
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_weekday.settransobject(sqlca)
	this.dw_weekday.insertrow(0)
	this.em_enddate.getdata(ldt_date)
	this.dw_weekday.retrieve(ldt_date)
	return ::message.returnvalue
