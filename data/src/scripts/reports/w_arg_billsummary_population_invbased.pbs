// window w_arg_billsummary_population_invbased (reports)  ancestor: w_listarguments

// w_arg_billsummary_population_invbased.create() returns 0
	integer icurrent
	call super::create
	this.cbx_usergroups = create cbx_usergroups
	this.cbx_printbalance = create cbx_printbalance
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.rb_posted = create rb_posted
	this.rb_unposted = create rb_unposted
	this.rb_both = create rb_both
	this.cbx_outstandingcust = create cbx_outstandingcust
	this.cbx_zerobalancecust = create cbx_zerobalancecust
	this.gb_5 = create gb_5
	this.gb_6 = create gb_6
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_usergroups
	this.control[icurrent + 2] = this.cbx_printbalance
	this.control[icurrent + 3] = this.st_4
	this.control[icurrent + 4] = this.st_8
	this.control[icurrent + 5] = this.rb_posted
	this.control[icurrent + 6] = this.rb_unposted
	this.control[icurrent + 7] = this.rb_both
	this.control[icurrent + 8] = this.cbx_outstandingcust
	this.control[icurrent + 9] = this.cbx_zerobalancecust
	this.control[icurrent + 10] = this.gb_5
	this.control[icurrent + 11] = this.gb_6

// w_arg_billsummary_population_invbased.destroy() returns 0
	call super::destroy
	destroy this.cbx_usergroups
	destroy this.cbx_printbalance
	destroy this.st_4
	destroy this.st_8
	destroy this.rb_posted
	destroy this.rb_unposted
	destroy this.rb_both
	destroy this.cbx_outstandingcust
	destroy this.cbx_zerobalancecust
	destroy this.gb_5
	destroy this.gb_6

// w_arg_billsummary_population_invbased.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("areacode", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	this.dw_startendinvoice.settransobject(sqlca)
	this.dw_startendinvoice.insertrow(0)
	this.dw_startendinvoice.scrolltorow(0)
	return ::message.returnvalue

// cbx_usergroups.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// cbx_printbalance.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
