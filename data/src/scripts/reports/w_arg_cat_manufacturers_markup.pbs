// window w_arg_cat_manufacturers_markup (reports)  ancestor: w_listarguments

// w_arg_cat_manufacturers_markup.create() returns 0
	integer icurrent
	call super::create
	this.dw_control2 = create dw_control2
	this.st_8 = create st_8
	this.st_9 = create st_9
	this.st_10 = create st_10
	this.dw_pricetype = create dw_pricetype
	this.em_markup = create em_markup
	this.st_11 = create st_11
	this.lb_category1 = create lb_category1
	this.lb_selectedcategory1 = create lb_selectedcategory1
	this.cbx_allcategory1 = create cbx_allcategory1
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_control2
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.st_9
	this.control[icurrent + 4] = this.st_10
	this.control[icurrent + 5] = this.dw_pricetype
	this.control[icurrent + 6] = this.em_markup
	this.control[icurrent + 7] = this.st_11
	this.control[icurrent + 8] = this.lb_category1
	this.control[icurrent + 9] = this.lb_selectedcategory1
	this.control[icurrent + 10] = this.cbx_allcategory1

// w_arg_cat_manufacturers_markup.destroy() returns 0
	call super::destroy
	destroy this.dw_control2
	destroy this.st_8
	destroy this.st_9
	destroy this.st_10
	destroy this.dw_pricetype
	destroy this.em_markup
	destroy this.st_11
	destroy this.lb_category1
	destroy this.lb_selectedcategory1
	destroy this.cbx_allcategory1

// w_arg_cat_manufacturers_markup.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.insertrow(0)
	this.dw_control2.scrolltorow(0)
	this.dw_pricetype.settransobject(sqlca)
	this.dw_pricetype.insertrow(0)
	this.dw_pricetype.scrolltorow(0)
	rtncode = this.dw_control.getchild("manufacturers", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	rtncode = this.dw_control2.getchild("icatcode", this.idc_category1)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_category1.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_category1.additem(this.idc_category1.getitemstring(ll_counter, "name"))
	next
	return ::message.returnvalue

// dw_control2.ue_enterkey() returns long
	send(handle(this), 256, 9, long(90))
	return 1

// lb_category1.doubleclicked(integer index) returns long
	string ls_item
	long ll_selectedindex
	ls_item = string(selecteditem())
	ll_selectedindex = selectedindex()
	if not isnull(ls_item) and index >= 1 then
		parent.lb_selectedcategory1.additem(ls_item)
		deleteitem(index)
		if ll_selectedindex > 1 then
			if totalitems() < ll_selectedindex then
				selectitem(totalitems())
			else
				selectitem(ll_selectedindex)
			end if
		else
			selectitem(1)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selectable listbox")
	end if
	return ::message.returnvalue

// lb_category1.getfocus() returns long
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue

// lb_selectedcategory1.doubleclicked(integer index) returns long
	string ls_item
	long ll_selectedindex
	ll_selectedindex = selectedindex()
	ls_item = string(selecteditem())
	if not isnull(ls_item) and index >= 1 then
		parent.lb_category1.additem(ls_item)
		deleteitem(index)
		if totalitems() < ll_selectedindex then
			selectitem(totalitems())
		else
			selectitem(ll_selectedindex)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selected listbox")
	end if
	return ::message.returnvalue

// lb_selectedcategory1.getfocus() returns long
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue
