// window w_arg_cat_manufacturers_markup (reports)  ancestor: w_listarguments

// w_arg_cat_manufacturers_markup.create() returns 0 [event]
	integer icurrent
	call super::create
	this.dw_control2 = create dw_control2
	this.st_8 = create st_8
	this.st_9 = create st_9
	this.st_10 = create st_10
	this.dw_pricetype = create dw_pricetype
	this.em_markup = create em_markup
	this.st_11 = create st_11
	this.lb_category1 = create lb_category1
	this.lb_selectedcategory1 = create lb_selectedcategory1
	this.cbx_allcategory1 = create cbx_allcategory1
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_control2
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.st_9
	this.control[icurrent + 4] = this.st_10
	this.control[icurrent + 5] = this.dw_pricetype
	this.control[icurrent + 6] = this.em_markup
	this.control[icurrent + 7] = this.st_11
	this.control[icurrent + 8] = this.lb_category1
	this.control[icurrent + 9] = this.lb_selectedcategory1
	this.control[icurrent + 10] = this.cbx_allcategory1

// w_arg_cat_manufacturers_markup.destroy() returns 0 [event]
	call super::destroy
	destroy this.dw_control2
	destroy this.st_8
	destroy this.st_9
	destroy this.st_10
	destroy this.dw_pricetype
	destroy this.em_markup
	destroy this.st_11
	destroy this.lb_category1
	destroy this.lb_selectedcategory1
	destroy this.cbx_allcategory1

// w_arg_cat_manufacturers_markup.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.insertrow(0)
	this.dw_control2.scrolltorow(0)
	this.dw_pricetype.settransobject(sqlca)
	this.dw_pricetype.insertrow(0)
	this.dw_pricetype.scrolltorow(0)
	rtncode = this.dw_control.getchild("manufacturers", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	rtncode = this.dw_control2.getchild("icatcode", this.idc_category1)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_category1.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_category1.additem(this.idc_category1.getitemstring(ll_counter, "name"))
	next
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "manfcode")
		next
	else
		for ll_counter = 1 to ll_counter
			ll_found = parent.idc_categories.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "manfcode")
			end if
		next
	end if
	if parent.cbx_allcategory1.checked = true then
		for ll_counter = 1 to parent.idc_category1.rowcount()
			parent.istr_arg.ia_integerlist2[ll_counter] = parent.idc_category1.getitemnumber(ll_counter, "icatcode")
		next
	else
		for ll_counter = 1 to ll_counter
			ll_found = parent.idc_category1.find("name ='" + parent.lb_selectedcategory1.text(ll_counter) + "'", 1, parent.idc_category1.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist2[ll_counter] = parent.idc_category1.getitemnumber(ll_found, "icatcode")
			end if
		next
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.l_code1 = parent.dw_control2.getitemnumber(1, "icatcode")
	parent.istr_arg.l_code2 = parent.dw_pricetype.getitemnumber(1, "pricetypecode")
	parent.em_markup.getdata(parent.istr_arg.db_code1)
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_control2.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// lb_category1.doubleclicked(integer index) returns long [event]
	string ls_item
	long ll_selectedindex
	ls_item = string(selecteditem())
	ll_selectedindex = selectedindex()
	if not isnull(ls_item) and index >= 1 then
		parent.lb_selectedcategory1.additem(ls_item)
		deleteitem(index)
		if ll_selectedindex > 1 then
			if totalitems() < ll_selectedindex then
				selectitem(totalitems())
			else
				selectitem(ll_selectedindex)
			end if
		else
			selectitem(1)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selectable listbox")
	end if
	return ::message.returnvalue

// lb_category1.getfocus() returns long [event]
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue

// lb_selectedcategory1.doubleclicked(integer index) returns long [event]
	string ls_item
	long ll_selectedindex
	ll_selectedindex = selectedindex()
	ls_item = string(selecteditem())
	if not isnull(ls_item) and index >= 1 then
		parent.lb_category1.additem(ls_item)
		deleteitem(index)
		if totalitems() < ll_selectedindex then
			selectitem(totalitems())
		else
			selectitem(ll_selectedindex)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selected listbox")
	end if
	return ::message.returnvalue

// lb_selectedcategory1.getfocus() returns long [event]
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue
