// window w_arg_categories_v2 (reports)  ancestor: w_listarguments

// w_arg_categories_v2.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.rb_allitems = create rb_allitems
	this.rb_positivestock = create rb_positivestock
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.rb_allitems
	this.control[icurrent + 4] = this.rb_positivestock

// w_arg_categories_v2.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.rb_allitems
	destroy this.rb_positivestock

// w_arg_categories_v2.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	datawindowchild ldc_categories
	listviewitem l_lvi
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("category", ldc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = ldc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(ldc_categories.getitemstring(ll_counter, "name"))
	next
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.lb_categories.totalitems()
			parent.istr_arg.sa_stringlist[ll_counter] = parent.lb_categories.text(ll_counter)
		next
	else
		for ll_counter = 1 to parent.lb_selectedcategories.totalitems()
			parent.istr_arg.sa_stringlist[ll_counter] = parent.lb_selectedcategories.text(ll_counter)
		next
	end if
	if parent.rb_allitems.checked then
		parent.istr_arg.s_name1 = "Y"
	else
		parent.istr_arg.s_name1 = "N"
	end if
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
