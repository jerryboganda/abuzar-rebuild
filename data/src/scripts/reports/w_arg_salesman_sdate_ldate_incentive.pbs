// window w_arg_salesman_sdate_ldate_incentive (reports)  ancestor: w_listarguments

// w_arg_salesman_sdate_ldate_incentive.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.st_9 = create st_9
	this.em_incentiveperc = create em_incentiveperc
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.st_9
	this.control[icurrent + 4] = this.em_incentiveperc

// w_arg_salesman_sdate_ldate_incentive.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.st_9
	destroy this.em_incentiveperc

// w_arg_salesman_sdate_ldate_incentive.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("salesman", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	this.dw_price.settransobject(sqlca)
	this.dw_price.insertrow(0)
	this.dw_price.scrolltorow(0)
	return ::message.returnvalue

// em_incentiveperc.keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_incentiveperc.getfocus() returns long
	if len(this.text) > 0 then
		selecttext(1, len(this.text))
	end if
	return ::message.returnvalue
