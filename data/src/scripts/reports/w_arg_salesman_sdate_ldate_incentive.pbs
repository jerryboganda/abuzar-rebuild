// window w_arg_salesman_sdate_ldate_incentive (reports)  ancestor: w_listarguments

// w_arg_salesman_sdate_ldate_incentive.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.st_9 = create st_9
	this.em_incentiveperc = create em_incentiveperc
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.st_9
	this.control[icurrent + 4] = this.em_incentiveperc

// w_arg_salesman_sdate_ldate_incentive.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.st_9
	destroy this.em_incentiveperc

// w_arg_salesman_sdate_ldate_incentive.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("salesman", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	this.dw_price.settransobject(sqlca)
	this.dw_price.insertrow(0)
	this.dw_price.scrolltorow(0)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "salesmancode")
		next
	else
		for ll_counter = 1 to parent.lb_selectedcategories.totalitems()
			ll_found = parent.idc_categories.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "salesmancode")
			end if
		next
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.em_incentiveperc.getdata(parent.istr_arg.db_code1)
	if parent.istr_arg.db_code1 < 0.0 then
		messagebox("Incentive Percentage Validation", "Please enter valid Incentive Percentage")
		parent.em_incentiveperc.setfocus()
		parent.em_incentiveperc.selecttext(1, len(parent.em_incentiveperc.text))
		return ::message.returnvalue
	end if
	parent.istr_arg.l_code1 = parent.dw_price.object.price[1]
	if parent.istr_arg.l_code1 = 0 or isnull(parent.istr_arg.l_code1) then
		messagebox("Price Validation", "Please enter valid Incentive Price")
		parent.dw_price.setfocus()
		return ::message.returnvalue
	end if
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// em_incentiveperc.keydown(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_incentiveperc.getfocus() returns long [event]
	if len(this.text) > 0 then
		selecttext(1, len(this.text))
	end if
	return ::message.returnvalue
