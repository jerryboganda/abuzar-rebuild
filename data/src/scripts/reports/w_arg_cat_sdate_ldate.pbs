// window w_arg_cat_sdate_ldate (reports)  ancestor: w_arguements

// w_arg_cat_sdate_ldate.create() returns 0 [event]
	integer icurrent
	call super::create
	this.cbx_cash = create cbx_cash
	this.cbx_credit = create cbx_credit
	this.lb_unselected = create lb_unselected
	this.cbx_all = create cbx_all
	this.lb_selected = create lb_selected
	this.st_4 = create st_4
	this.rb_customized = create rb_customized
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_cash
	this.control[icurrent + 2] = this.cbx_credit
	this.control[icurrent + 3] = this.lb_unselected
	this.control[icurrent + 4] = this.cbx_all
	this.control[icurrent + 5] = this.lb_selected
	this.control[icurrent + 6] = this.st_4
	this.control[icurrent + 7] = this.rb_customized

// w_arg_cat_sdate_ldate.destroy() returns 0 [event]
	call super::destroy
	destroy this.cbx_cash
	destroy this.cbx_credit
	destroy this.lb_unselected
	destroy this.cbx_all
	destroy this.lb_selected
	destroy this.st_4
	destroy this.rb_customized

// w_arg_cat_sdate_ldate.open() returns long [event]
	long ancestorreturnvalue
	integer ll_rtncode
	long ll_counter
	long ll_rowcount
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	ll_rtncode = this.dw_control.getchild("icatcode", this.idc_categories)
	if ll_rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_unselected.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	return ::message.returnvalue

// w_arg_cat_sdate_ldate.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_found
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.la_longlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "icatcode")
		next
	else
		for ll_counter = 1 to ll_counter
			ll_found = parent.idc_categories.find("name ='" + parent.lb_selected.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.la_longlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "icatcode")
			end if
		next
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if parent.cbx_cash.checked = true then
		parent.istr_arg.ia_integerlist[1] = 3
		parent.istr_arg.ia_integerlist1[1] = 8
		parent.istr_arg.s_name1 = "Y"
	end if
	if parent.cbx_credit.checked = true then
		parent.istr_arg.ia_integerlist[2] = 1
		parent.istr_arg.ia_integerlist[3] = 2
		parent.istr_arg.ia_integerlist1[2] = 6
		parent.istr_arg.ia_integerlist1[3] = 7
		parent.istr_arg.s_name2 = "Y"
	end if
	if parent.rb_saleprice.checked then
		parent.istr_arg.l_code2 = 1
	elseif parent.rb_purprice.checked then
		parent.istr_arg.l_code2 = 2
	elseif parent.rb_customized.checked then
		parent.istr_arg.l_code2 = 3
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// lb_unselected.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_unselected.doubleclicked(integer index) returns long [event]
	string ls_item
	long ll_selectedindex
	ls_item = string(selecteditem())
	ll_selectedindex = selectedindex()
	if not isnull(ls_item) and index >= 1 then
		parent.lb_selected.additem(ls_item)
		deleteitem(index)
		if ll_selectedindex > 1 then
			if totalitems() < ll_selectedindex then
				selectitem(totalitems())
			else
				selectitem(ll_selectedindex)
			end if
		else
			selectitem(1)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selectable listbox")
	end if
	return ::message.returnvalue

// lb_unselected.getfocus() returns long [event]
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue

// lb_selected.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_selected.doubleclicked(integer index) returns long [event]
	string ls_item
	long ll_selectedindex
	ls_item = string(selecteditem())
	ll_selectedindex = selectedindex()
	if not isnull(ls_item) and index >= 1 then
		parent.lb_unselected.additem(ls_item)
		deleteitem(index)
		if ll_selectedindex > 1 then
			if totalitems() < ll_selectedindex then
				selectitem(totalitems())
			else
				selectitem(ll_selectedindex)
			end if
		else
			selectitem(1)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selectable listbox")
	end if
	return ::message.returnvalue

// lb_selected.getfocus() returns long [event]
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue
