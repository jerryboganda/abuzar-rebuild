// window w_arg_cat_sdate_ldate (reports)  ancestor: w_arguements

// w_arg_cat_sdate_ldate.create() returns 0
	integer icurrent
	call super::create
	this.cbx_cash = create cbx_cash
	this.cbx_credit = create cbx_credit
	this.lb_unselected = create lb_unselected
	this.cbx_all = create cbx_all
	this.lb_selected = create lb_selected
	this.st_4 = create st_4
	this.rb_customized = create rb_customized
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_cash
	this.control[icurrent + 2] = this.cbx_credit
	this.control[icurrent + 3] = this.lb_unselected
	this.control[icurrent + 4] = this.cbx_all
	this.control[icurrent + 5] = this.lb_selected
	this.control[icurrent + 6] = this.st_4
	this.control[icurrent + 7] = this.rb_customized

// w_arg_cat_sdate_ldate.destroy() returns 0
	call super::destroy
	destroy this.cbx_cash
	destroy this.cbx_credit
	destroy this.lb_unselected
	destroy this.cbx_all
	destroy this.lb_selected
	destroy this.st_4
	destroy this.rb_customized

// w_arg_cat_sdate_ldate.open() returns long
	long ancestorreturnvalue
	integer ll_rtncode
	long ll_counter
	long ll_rowcount
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	ll_rtncode = this.dw_control.getchild("icatcode", this.idc_categories)
	if ll_rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_unselected.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	return ::message.returnvalue

// w_arg_cat_sdate_ldate.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// lb_unselected.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_unselected.doubleclicked(integer index) returns long
	string ls_item
	long ll_selectedindex
	ls_item = string(selecteditem())
	ll_selectedindex = selectedindex()
	if not isnull(ls_item) and index >= 1 then
		parent.lb_selected.additem(ls_item)
		deleteitem(index)
		if ll_selectedindex > 1 then
			if totalitems() < ll_selectedindex then
				selectitem(totalitems())
			else
				selectitem(ll_selectedindex)
			end if
		else
			selectitem(1)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selectable listbox")
	end if
	return ::message.returnvalue

// lb_unselected.getfocus() returns long
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue

// lb_selected.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_selected.doubleclicked(integer index) returns long
	string ls_item
	long ll_selectedindex
	ls_item = string(selecteditem())
	ll_selectedindex = selectedindex()
	if not isnull(ls_item) and index >= 1 then
		parent.lb_unselected.additem(ls_item)
		deleteitem(index)
		if ll_selectedindex > 1 then
			if totalitems() < ll_selectedindex then
				selectitem(totalitems())
			else
				selectitem(ll_selectedindex)
			end if
		else
			selectitem(1)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selectable listbox")
	end if
	return ::message.returnvalue

// lb_selected.getfocus() returns long
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue
