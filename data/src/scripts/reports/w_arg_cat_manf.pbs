// window w_arg_cat_manf (reports)  ancestor: w_arguements

// w_arg_cat_manf.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.dw_godown = create dw_godown
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.dw_godown

// w_arg_cat_manf.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.dw_godown

// w_arg_cat_manf.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_godown.settransobject(sqlca)
	this.dw_godown.insertrow(0)
	this.dw_godown.scrolltorow(0)
	return ::message.returnvalue

// w_arg_cat_manf.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)
