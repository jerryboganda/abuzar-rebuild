// window w_arg_sdate_ldate_transaction (reports)  ancestor: w_arguements

// w_arg_sdate_ldate_transaction.create() returns 0 [event]
	integer icurrent
	call super::create
	this.cbx_sales = create cbx_sales
	this.cbx_salesreturn = create cbx_salesreturn
	this.cbx_purchase = create cbx_purchase
	this.cbx_purchasereturn = create cbx_purchasereturn
	this.cbx_service = create cbx_service
	this.cbx_servicereturn = create cbx_servicereturn
	this.cbx_issue = create cbx_issue
	this.cbx_receipt = create cbx_receipt
	this.cbx_cp = create cbx_cp
	this.cbx_cr = create cbx_cr
	this.cbx_bp = create cbx_bp
	this.cbx_br = create cbx_br
	this.cbx_jv = create cbx_jv
	this.cbx_others = create cbx_others
	this.cbx_adjustment = create cbx_adjustment
	this.cbx_all = create cbx_all
	this.gb_2 = create gb_2
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_sales
	this.control[icurrent + 2] = this.cbx_salesreturn
	this.control[icurrent + 3] = this.cbx_purchase
	this.control[icurrent + 4] = this.cbx_purchasereturn
	this.control[icurrent + 5] = this.cbx_service
	this.control[icurrent + 6] = this.cbx_servicereturn
	this.control[icurrent + 7] = this.cbx_issue
	this.control[icurrent + 8] = this.cbx_receipt
	this.control[icurrent + 9] = this.cbx_cp
	this.control[icurrent + 10] = this.cbx_cr
	this.control[icurrent + 11] = this.cbx_bp
	this.control[icurrent + 12] = this.cbx_br
	this.control[icurrent + 13] = this.cbx_jv
	this.control[icurrent + 14] = this.cbx_others
	this.control[icurrent + 15] = this.cbx_adjustment
	this.control[icurrent + 16] = this.cbx_all
	this.control[icurrent + 17] = this.gb_2

// w_arg_sdate_ldate_transaction.destroy() returns 0 [event]
	call super::destroy
	destroy this.cbx_sales
	destroy this.cbx_salesreturn
	destroy this.cbx_purchase
	destroy this.cbx_purchasereturn
	destroy this.cbx_service
	destroy this.cbx_servicereturn
	destroy this.cbx_issue
	destroy this.cbx_receipt
	destroy this.cbx_cp
	destroy this.cbx_cr
	destroy this.cbx_bp
	destroy this.cbx_br
	destroy this.cbx_jv
	destroy this.cbx_others
	destroy this.cbx_adjustment
	destroy this.cbx_all
	destroy this.gb_2

// w_arg_sdate_ldate_transaction.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if parent.cbx_purchase.checked = true then
		parent.istr_arg.ia_integerlist[1] = 1
	end if
	if parent.cbx_purchasereturn.checked = true then
		parent.istr_arg.ia_integerlist[2] = 1
	end if
	if parent.cbx_sales.checked = true then
		parent.istr_arg.ia_integerlist[3] = 1
	end if
	if parent.cbx_salesreturn.checked = true then
		parent.istr_arg.ia_integerlist[4] = 1
	end if
	if parent.cbx_service.checked = true then
		parent.istr_arg.ia_integerlist[5] = 1
	end if
	if parent.cbx_servicereturn.checked = true then
		parent.istr_arg.ia_integerlist[6] = 1
	end if
	if parent.cbx_issue.checked = true then
		parent.istr_arg.ia_integerlist[7] = 1
	end if
	if parent.cbx_receipt.checked = true then
		parent.istr_arg.ia_integerlist[8] = 1
	end if
	if parent.cbx_adjustment.checked = true then
		parent.istr_arg.ia_integerlist[9] = 1
	end if
	if parent.cbx_cp.checked = true then
		parent.istr_arg.ia_integerlist[10] = 1
	end if
	if parent.cbx_cr.checked = true then
		parent.istr_arg.ia_integerlist[11] = 2
	end if
	if parent.cbx_bp.checked = true then
		parent.istr_arg.ia_integerlist[12] = 3
	end if
	if parent.cbx_br.checked = true then
		parent.istr_arg.ia_integerlist[13] = 4
	end if
	if parent.cbx_jv.checked = true then
		parent.istr_arg.ia_integerlist[14] = 5
	end if
	if parent.cbx_others.checked = true then
		parent.istr_arg.ia_integerlist[15] = 6
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// cbx_all.clicked() returns long [event]
	parent.cbx_purchase.checked = parent.cbx_all.checked
	parent.cbx_purchase.enabled = not parent.cbx_all.checked
	parent.cbx_purchasereturn.checked = parent.cbx_all.checked
	parent.cbx_purchasereturn.enabled = not parent.cbx_all.checked
	parent.cbx_sales.checked = parent.cbx_all.checked
	parent.cbx_sales.enabled = not parent.cbx_all.checked
	parent.cbx_salesreturn.checked = parent.cbx_all.checked
	parent.cbx_salesreturn.enabled = not parent.cbx_all.checked
	parent.cbx_service.checked = parent.cbx_all.checked
	parent.cbx_service.enabled = not parent.cbx_all.checked
	parent.cbx_servicereturn.checked = parent.cbx_all.checked
	parent.cbx_servicereturn.enabled = not parent.cbx_all.checked
	parent.cbx_issue.checked = parent.cbx_all.checked
	parent.cbx_issue.enabled = not parent.cbx_all.checked
	parent.cbx_receipt.checked = parent.cbx_all.checked
	parent.cbx_receipt.enabled = not parent.cbx_all.checked
	parent.cbx_adjustment.checked = parent.cbx_all.checked
	parent.cbx_adjustment.enabled = not parent.cbx_all.checked
	parent.cbx_cp.checked = parent.cbx_all.checked
	parent.cbx_cp.enabled = not parent.cbx_all.checked
	parent.cbx_cr.checked = parent.cbx_all.checked
	parent.cbx_cr.enabled = not parent.cbx_all.checked
	parent.cbx_bp.checked = parent.cbx_all.checked
	parent.cbx_bp.enabled = not parent.cbx_all.checked
	parent.cbx_br.checked = parent.cbx_all.checked
	parent.cbx_br.enabled = not parent.cbx_all.checked
	parent.cbx_jv.checked = parent.cbx_all.checked
	parent.cbx_jv.enabled = not parent.cbx_all.checked
	parent.cbx_others.checked = parent.cbx_all.checked
	parent.cbx_others.enabled = not parent.cbx_all.checked
	return ::message.returnvalue
