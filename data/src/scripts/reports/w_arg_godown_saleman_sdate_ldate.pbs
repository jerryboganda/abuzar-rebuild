// window w_arg_godown_saleman_sdate_ldate (reports)  ancestor: w_arguements

// w_arg_godown_saleman_sdate_ldate.create() returns 0 [event]
	integer icurrent
	call super::create
	this.dw_control2 = create dw_control2
	this.st_4 = create st_4
	this.cbx_allgodown = create cbx_allgodown
	this.cbx_allsalesman = create cbx_allsalesman
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_control2
	this.control[icurrent + 2] = this.st_4
	this.control[icurrent + 3] = this.cbx_allgodown
	this.control[icurrent + 4] = this.cbx_allsalesman

// w_arg_godown_saleman_sdate_ldate.destroy() returns 0 [event]
	call super::destroy
	destroy this.dw_control2
	destroy this.st_4
	destroy this.cbx_allgodown
	destroy this.cbx_allsalesman

// w_arg_godown_saleman_sdate_ldate.open() returns long [event]
	long ancestorreturnvalue
	integer rtcode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.insertrow(0)
	this.dw_control2.scrolltorow(0)
	return ::message.returnvalue

// w_arg_godown_saleman_sdate_ldate.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	if parent.cbx_allgodown.checked = true then
		parent.istr_arg.l_code1 = -1
	else
		parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "gcode")
		if isnull(parent.istr_arg.l_code1) or parent.istr_arg.l_code1 = 0 then
			messagebox("Godown Validation", "Please Select a valid Godown", stopsign!)
			parent.cbx_allgodown.setfocus()
		end if
	end if
	if parent.cbx_allsalesman.checked = true then
		parent.istr_arg.l_code2 = -1
	else
		parent.istr_arg.l_code2 = parent.dw_control2.getitemnumber(1, "salesman")
		if isnull(parent.istr_arg.l_code2) or parent.istr_arg.l_code2 = 0 then
			messagebox("Sales Person Validation", "Please Select a valid Sales Person", stopsign!)
			parent.cbx_allsalesman.setfocus()
		end if
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_control2.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1
