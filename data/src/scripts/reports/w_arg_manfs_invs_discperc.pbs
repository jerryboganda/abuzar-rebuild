// window w_arg_manfs_invs_discperc (reports)  ancestor: w_listarguments

// w_arg_manfs_invs_discperc.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.st_9 = create st_9
	this.em_discperc = create em_discperc
	this.em_invlist = create em_invlist
	this.gb_5 = create gb_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.st_9
	this.control[icurrent + 4] = this.em_discperc
	this.control[icurrent + 5] = this.em_invlist
	this.control[icurrent + 6] = this.gb_5

// w_arg_manfs_invs_discperc.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.st_9
	destroy this.em_discperc
	destroy this.em_invlist
	destroy this.gb_5

// w_arg_manfs_invs_discperc.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("manufacturers", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	return ::message.returnvalue

// em_discperc.ue_keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_discperc.getfocus() returns long
	selecttext(1, len(this.text))
	return ::message.returnvalue

// em_invlist.ue_keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_invlist.getfocus() returns long
	selecttext(1, len(this.text))
	return ::message.returnvalue
