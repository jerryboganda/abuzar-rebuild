// window w_arg_users_withlist_sdate_ldate_purcat (reports)  ancestor: w_listarguments

// w_arg_users_withlist_sdate_ldate_purcat.create() returns 0 [event]
	integer icurrent
	call super::create
	this.cbx_cash = create cbx_cash
	this.cbx_credit = create cbx_credit
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.cbx_pack = create cbx_pack
	this.cbx_loose = create cbx_loose
	this.cbx_opening = create cbx_opening
	this.rb_posted = create rb_posted
	this.rb_unposted = create rb_unposted
	this.rb_both = create rb_both
	this.gb_5 = create gb_5
	this.gb_6 = create gb_6
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_cash
	this.control[icurrent + 2] = this.cbx_credit
	this.control[icurrent + 3] = this.st_4
	this.control[icurrent + 4] = this.st_8
	this.control[icurrent + 5] = this.cbx_pack
	this.control[icurrent + 6] = this.cbx_loose
	this.control[icurrent + 7] = this.cbx_opening
	this.control[icurrent + 8] = this.rb_posted
	this.control[icurrent + 9] = this.rb_unposted
	this.control[icurrent + 10] = this.rb_both
	this.control[icurrent + 11] = this.gb_5
	this.control[icurrent + 12] = this.gb_6

// w_arg_users_withlist_sdate_ldate_purcat.destroy() returns 0 [event]
	call super::destroy
	destroy this.cbx_cash
	destroy this.cbx_credit
	destroy this.st_4
	destroy this.st_8
	destroy this.cbx_pack
	destroy this.cbx_loose
	destroy this.cbx_opening
	destroy this.rb_posted
	destroy this.rb_unposted
	destroy this.rb_both
	destroy this.gb_5
	destroy this.gb_6

// w_arg_users_withlist_sdate_ldate_purcat.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("usercode", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "username"))
	next
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	string ls_name
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "usercode")
		next
		parent.istr_arg.s_name1 = "All User(s)"
	else
		for ll_counter = 1 to ll_counter
			ll_found = parent.idc_categories.find("username ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "usercode")
				ls_name = parent.idc_categories.getitemstring(ll_found, "username")
				parent.istr_arg.s_name1 = parent.istr_arg.s_name1 + trim(ls_name) + ","
			end if
		next
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.s_name2 = ""
	if parent.cbx_pack.checked then
		parent.istr_arg.ia_integerlist2[1] = 1
		parent.istr_arg.ia_integerlist2[2] = 2
		parent.istr_arg.s_name2 = "Pack Purchase"
	end if
	if parent.cbx_loose.checked then
		parent.istr_arg.ia_integerlist2[3] = 7
		parent.istr_arg.ia_integerlist2[4] = 8
		parent.istr_arg.s_name2 = parent.istr_arg.s_name2 + " , " + "Loose Purchase"
	end if
	if parent.cbx_opening.checked then
		parent.istr_arg.ia_integerlist2[5] = 3
		parent.istr_arg.s_name2 = parent.istr_arg.s_name2 + " , " + "Opening Purchase"
	end if
	if parent.rb_posted.checked = true then
		parent.istr_arg.sa_stringlist[1] = "Y"
	elseif parent.rb_unposted.checked = true then
		parent.istr_arg.sa_stringlist[1] = "N"
	else
		parent.istr_arg.sa_stringlist[1] = "Y"
		parent.istr_arg.sa_stringlist[2] = "N"
	end if
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// cbx_cash.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// cbx_credit.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
