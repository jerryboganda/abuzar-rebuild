// window w_arg_manf_sdate_ldate_brooks (reports)  ancestor: w_arguements

// w_arg_manf_sdate_ldate_brooks.create() returns 0 [event]
	integer icurrent
	call super::create
	this.cbx_cust = create cbx_cust
	this.cbx_area = create cbx_area
	this.gb_2 = create gb_2
	this.cbx_trans = create cbx_trans
	this.cb_trans = create cb_trans
	this.cb_cust = create cb_cust
	this.cb_area = create cb_area
	this.hpb_hpb = create hpb_hpb
	this.cbx_prod = create cbx_prod
	this.cb_prod = create cb_prod
	this.gb_overallprogress = create gb_overallprogress
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_cust
	this.control[icurrent + 2] = this.cbx_area
	this.control[icurrent + 3] = this.gb_2
	this.control[icurrent + 4] = this.cbx_trans
	this.control[icurrent + 5] = this.cb_trans
	this.control[icurrent + 6] = this.cb_cust
	this.control[icurrent + 7] = this.cb_area
	this.control[icurrent + 8] = this.hpb_hpb
	this.control[icurrent + 9] = this.cbx_prod
	this.control[icurrent + 10] = this.cb_prod
	this.control[icurrent + 11] = this.gb_overallprogress

// w_arg_manf_sdate_ldate_brooks.destroy() returns 0 [event]
	call super::destroy
	destroy this.cbx_cust
	destroy this.cbx_area
	destroy this.gb_2
	destroy this.cbx_trans
	destroy this.cb_trans
	destroy this.cb_cust
	destroy this.cb_area
	destroy this.hpb_hpb
	destroy this.cbx_prod
	destroy this.cb_prod
	destroy this.gb_overallprogress

// w_arg_manf_sdate_ldate_brooks.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.is_trans = trim(f_stringpreferences("OutputFilePath")) + "INVOICES.XLS"
	this.is_cust = trim(f_stringpreferences("OutputFilePath")) + "CUSTOMERS.XLS"
	this.is_area = trim(f_stringpreferences("OutputFilePath")) + "AREAS.XLS"
	this.is_prod = trim(f_stringpreferences("OutputFilePath")) + "PRODUCTS.XLS"
	return ::message.returnvalue

// w_arg_manf_sdate_ldate_brooks.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	string ls_distcode
	datastore lds_temp
	ancestorreturnvalue = super::clicked()
	setpointer(hourglass!)
	parent.gb_overallprogress.visible = true
	parent.hpb_hpb.visible = true
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "manfcode")
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_status = 1
	lds_temp = create datastore
	if parent.cbx_trans.checked = true then
		lds_temp.dataobject = "d_invdata_brooks"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve(parent.istr_arg.l_code1, parent.istr_arg.d_sdate, parent.istr_arg.d_edate)
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
		if lds_temp.saveas(parent.is_trans, excel!, true) <> 1 then
			messagebox("Invoice Data Generation Problem", "Error Generating Invoice Data Text File~r~nPlease Try Later")
			destroy lds_temp
			return ::message.returnvalue
		end if
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
	end if
	if parent.cbx_cust.checked = true then
		lds_temp.dataobject = "d_custdata_brooks"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve()
		parent.hpb_hpb.stepit()
		if lds_temp.saveas(parent.is_cust, excel!, true) <> 1 then
			messagebox("Customer Data Generation Problem", "Error Generating Customer Data Text File~r~nPlease Try Later")
			destroy lds_temp
			return ::message.returnvalue
		end if
		parent.hpb_hpb.stepit()
	end if
	if parent.cbx_area.checked = true then
		lds_temp.dataobject = "d_areadata_brooks"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve()
		parent.hpb_hpb.stepit()
		if lds_temp.saveas(parent.is_area, excel!, true) <> 1 then
			messagebox("Area Data Generation Problem", "Error Generating Area Data Text File~r~nPlease Try Later")
			destroy lds_temp
			return ::message.returnvalue
		end if
		return
	end if
	if parent.cbx_prod.checked = true then
		lds_temp.dataobject = "d_proddata_brooks"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve(parent.istr_arg.l_code1)
		parent.hpb_hpb.stepit()
		if lds_temp.saveas(parent.is_prod, excel!, true) <> 1 then
			messagebox("Product Data Generation Problem", "Error Generating Product Data Text File~r~nPlease Try Later")
			destroy lds_temp
			return ::message.returnvalue
		end if
		return
	end if
	parent.hpb_hpb.stepit()
	destroy lds_temp
	parent.hpb_hpb.visible = false
	parent.hpb_hpb.position = 10
	parent.gb_overallprogress.visible = false
	setpointer(arrow!)
	parent.post event ue_close(1)
	return ::message.returnvalue

// cb_trans.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_trans, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_cust.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_cust, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_area.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_area, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_prod.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_prod, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue
