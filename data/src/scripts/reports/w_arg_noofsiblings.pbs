// window w_arg_noofsiblings (reports)  ancestor: window

// w_arg_noofsiblings.create() returns 0
	this.st_val = create st_val
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.em_val = create em_val
	this.control = {this.st_val, this.cb_cancel, this.cb_ok, this.em_val}

// w_arg_noofsiblings.destroy() returns 0
	destroy this.st_val
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.em_val

// cb_cancel.ue_keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	closewithreturn(parent, -1)
	return ::message.returnvalue

// cb_ok.ue_keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	double ld_val
	parent.em_val.getdata(ld_val)
	if ld_val < 0.0 then
		messagebox("Validation", message.stringparm + " Should not be negative")
		parent.em_val.setfocus()
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	closewithreturn(parent, ld_val)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// em_val.ue_keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_val.getfocus() returns long
	selecttext(1, len(this.text))
	return ::message.returnvalue
