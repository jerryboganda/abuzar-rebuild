// window w_arg_category_smonth (reports)  ancestor: w_listarguments

// w_arg_category_smonth.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.dw_smonth = create dw_smonth
	this.dw_syear = create dw_syear
	this.st_month = create st_month
	this.st_9 = create st_9
	this.dw_tradeprice = create dw_tradeprice
	this.st_10 = create st_10
	this.gb_5 = create gb_5
	this.gb_6 = create gb_6
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.dw_smonth
	this.control[icurrent + 4] = this.dw_syear
	this.control[icurrent + 5] = this.st_month
	this.control[icurrent + 6] = this.st_9
	this.control[icurrent + 7] = this.dw_tradeprice
	this.control[icurrent + 8] = this.st_10
	this.control[icurrent + 9] = this.gb_5
	this.control[icurrent + 10] = this.gb_6

// w_arg_category_smonth.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.dw_smonth
	destroy this.dw_syear
	destroy this.st_month
	destroy this.st_9
	destroy this.dw_tradeprice
	destroy this.st_10
	destroy this.gb_5
	destroy this.gb_6

// w_arg_category_smonth.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("category", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	this.dw_smonth.insertrow(0)
	this.dw_smonth.scrolltorow(0)
	this.dw_smonth.setitem(1, "month", month(today()))
	this.dw_syear.insertrow(0)
	this.dw_syear.scrolltorow(0)
	this.dw_syear.setitem(1, "year", year(today()))
	this.dw_tradeprice.insertrow(0)
	this.dw_tradeprice.scrolltorow(0)
	this.dw_tradeprice.setitem(1, "price", 1)
	return ::message.returnvalue

// dw_smonth.ue_enterkey() returns long
	send(handle(this), 256, 9, long(90))
	return 1

// dw_syear.ue_enterkey() returns long
	send(handle(this), 256, 9, long(90))
	return 1

// dw_tradeprice.ue_enterkey() returns long
	send(handle(this), 256, 9, long(90))
	return 1
