// window w_arg_grouping_godowns (reports)  ancestor: w_listarguments

// w_arg_grouping_godowns.create() returns 0
	integer icurrent
	call super::create
	this.dw_control2 = create dw_control2
	this.st_4 = create st_4
	this.st_selectable = create st_selectable
	this.st_selected = create st_selected
	this.lb_cust = create lb_cust
	this.lb_selectedcust = create lb_selectedcust
	this.cbx_allcust = create cbx_allcust
	this.st_10 = create st_10
	this.st_11 = create st_11
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_control2
	this.control[icurrent + 2] = this.st_4
	this.control[icurrent + 3] = this.st_selectable
	this.control[icurrent + 4] = this.st_selected
	this.control[icurrent + 5] = this.lb_cust
	this.control[icurrent + 6] = this.lb_selectedcust
	this.control[icurrent + 7] = this.cbx_allcust
	this.control[icurrent + 8] = this.st_10
	this.control[icurrent + 9] = this.st_11

// w_arg_grouping_godowns.destroy() returns 0
	call super::destroy
	destroy this.dw_control2
	destroy this.st_4
	destroy this.st_selectable
	destroy this.st_selected
	destroy this.lb_cust
	destroy this.lb_selectedcust
	destroy this.cbx_allcust
	destroy this.st_10
	destroy this.st_11

// w_arg_grouping_godowns.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.is_stringparam = message.stringparm
	if this.is_stringparam = "M" then
		this.is_dataobject = "d_manufacturers"
		this.is_colname = "manufacturers"
		this.is_childcolname = "manfcode"
		this.st_selectable.text = "Manufacturer(s)"
		this.st_selected.text = "Manufacturer(s)"
	elseif this.is_stringparam = "C" then
		this.is_dataobject = "d_itemcategories"
		this.is_colname = "categories"
		this.is_childcolname = "icatcode"
		this.st_selectable.text = "Item Categories"
		this.st_selected.text = "Item Categories"
	elseif this.is_stringparam = "L" then
		this.is_dataobject = "d_arg_class"
		this.is_colname = "iccode"
		this.is_childcolname = "iccode"
		this.st_selectable.text = "Item Class(s)"
		this.st_selected.text = "Item Class(s)"
	elseif this.is_stringparam = "P" then
		this.is_dataobject = "d_arg_packing"
		this.is_colname = "packcode"
		this.is_childcolname = "packcode"
		this.st_selectable.text = "Item Packing(s)"
		this.st_selected.text = "Item Packing(s)"
	end if
	this.dw_control.dataobject = this.is_dataobject
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild(this.is_colname, this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.insertrow(0)
	this.dw_control2.scrolltorow(0)
	rtncode = this.dw_control2.getchild("gcode", this.idc_child)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_child.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_cust.additem(this.idc_child.getitemstring(ll_counter, "name"))
	next
	this.dw_price.settransobject(sqlca)
	this.dw_price.insertrow(0)
	this.dw_price.setrow(0)
	this.dw_price.scrolltorow(0)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_control2.ue_enterkey() returns long
	send(handle(this), 256, 9, long(90))
	return 1

// lb_cust.ue_keypress(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_cust.doubleclicked(integer index) returns long
	string ls_item
	long ll_selectedindex
	ls_item = string(selecteditem())
	ll_selectedindex = selectedindex()
	if not isnull(ls_item) and index >= 1 then
		parent.lb_selectedcust.additem(ls_item)
		deleteitem(index)
		if ll_selectedindex > 1 then
			if totalitems() < ll_selectedindex then
				selectitem(totalitems())
			else
				selectitem(ll_selectedindex)
			end if
		else
			selectitem(1)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selectable listbox")
	end if
	return ::message.returnvalue

// lb_cust.getfocus() returns long
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue

// lb_selectedcust.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_selectedcust.doubleclicked(integer index) returns long
	string ls_item
	long ll_selectedindex
	ll_selectedindex = selectedindex()
	ls_item = string(selecteditem())
	if not isnull(ls_item) and index >= 1 then
		parent.lb_cust.additem(ls_item)
		deleteitem(index)
		if totalitems() < ll_selectedindex then
			selectitem(totalitems())
		else
			selectitem(ll_selectedindex)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selected listbox")
	end if
	return ::message.returnvalue

// lb_selectedcust.getfocus() returns long
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue
