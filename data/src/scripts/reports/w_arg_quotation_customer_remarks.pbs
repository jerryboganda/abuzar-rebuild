// window w_arg_quotation_customer_remarks (reports)  ancestor: window

// w_arg_quotation_customer_remarks.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// w_arg_quotation_customer_remarks.create() returns 0 [event]
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.dw_selection = create dw_selection
	this.control = {this.cb_cancel, this.cb_ok, this.dw_selection}

// w_arg_quotation_customer_remarks.destroy() returns 0 [event]
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.dw_selection

// w_arg_quotation_customer_remarks.open() returns long [event]
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	this.dw_selection.settransobject(sqlca)
	this.dw_selection.retrieve()
	if this.dw_selection.rowcount() > 0 then
		this.dw_selection.scrolltorow(1)
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.istr_arg.i_status = -1
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ll_counter
	integer[] ia_list
	if isnull(parent.dw_selection.object.quotationcode[1]) or parent.dw_selection.object.quotationcode[1] = 0 then
		messagebox("Quotation Validation", "Please select a valid Quotation", stopsign!)
		parent.dw_selection.setcolumn("quotationcode")
		parent.dw_selection.setfocus()
		return ::message.returnvalue
	end if
	if isnull(parent.dw_selection.object.custcode[1]) or parent.dw_selection.object.custcode[1] = 0 then
		messagebox("Customer Validation", "Please select a valid Customer", stopsign!)
		parent.dw_selection.setcolumn("custcode")
		parent.dw_selection.setfocus()
		return ::message.returnvalue
	end if
	parent.istr_arg.i_status = 1
	parent.istr_arg.l_code1 = parent.dw_selection.object.quotationcode[1]
	parent.istr_arg.l_code2 = parent.dw_selection.object.custcode[1]
	parent.istr_arg.s_name1 = parent.dw_selection.object.remarks[1]
	parent.post event ue_close()
	return ::message.returnvalue
