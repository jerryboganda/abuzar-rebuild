// window w_arg_cat_class_manufacturers (reports)  ancestor: w_arguements

// w_arg_cat_class_manufacturers.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.lb_categories = create lb_categories
	this.lb_selectedcategories = create lb_selectedcategories
	this.st_9 = create st_9
	this.st_10 = create st_10
	this.st_8 = create st_8
	this.cbx_all = create cbx_all
	this.dw_control2 = create dw_control2
	this.st_6 = create st_6
	this.dw_control3 = create dw_control3
	this.lb_selecteditemcategories = create lb_selecteditemcategories
	this.lb_itemcategories = create lb_itemcategories
	this.st_5 = create st_5
	this.st_7 = create st_7
	this.cbx_allitemcategories = create cbx_allitemcategories
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.lb_categories
	this.control[icurrent + 3] = this.lb_selectedcategories
	this.control[icurrent + 4] = this.st_9
	this.control[icurrent + 5] = this.st_10
	this.control[icurrent + 6] = this.st_8
	this.control[icurrent + 7] = this.cbx_all
	this.control[icurrent + 8] = this.dw_control2
	this.control[icurrent + 9] = this.st_6
	this.control[icurrent + 10] = this.dw_control3
	this.control[icurrent + 11] = this.lb_selecteditemcategories
	this.control[icurrent + 12] = this.lb_itemcategories
	this.control[icurrent + 13] = this.st_5
	this.control[icurrent + 14] = this.st_7
	this.control[icurrent + 15] = this.cbx_allitemcategories

// w_arg_cat_class_manufacturers.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.lb_categories
	destroy this.lb_selectedcategories
	destroy this.st_9
	destroy this.st_10
	destroy this.st_8
	destroy this.cbx_all
	destroy this.dw_control2
	destroy this.st_6
	destroy this.dw_control3
	destroy this.lb_selecteditemcategories
	destroy this.lb_itemcategories
	destroy this.st_5
	destroy this.st_7
	destroy this.cbx_allitemcategories

// w_arg_cat_class_manufacturers.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("manufacturers", this.idc_manufacturers)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_manufacturers.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_manufacturers.getitemstring(ll_counter, "name"))
	next
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.insertrow(0)
	this.dw_control2.scrolltorow(0)
	rtncode = this.dw_control2.getchild("category", this.idc_itemcategories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_itemcategories.rowcount()
	ll_counter = 0
	for ll_counter = 1 to ll_rowcount
		this.lb_itemcategories.additem(this.idc_itemcategories.getitemstring(ll_counter, "name"))
	next
	this.dw_control3.settransobject(sqlca)
	this.dw_control3.insertrow(0)
	this.dw_control3.scrolltorow(0)
	return ::message.returnvalue

// w_arg_cat_class_manufacturers.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_manufacturers.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_manufacturers.getitemnumber(ll_counter, "manfcode")
		next
	else
		parent.istr_arg.ia_integerlist[1] = -1000
		for ll_counter = 1 to ll_counter
			ll_found = parent.idc_manufacturers.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_manufacturers.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_manufacturers.getitemnumber(ll_found, "manfcode")
			end if
		next
	end if
	if parent.cbx_allitemcategories.checked = true then
		for ll_counter = 1 to parent.idc_itemcategories.rowcount()
			parent.istr_arg.ia_integerlist1[ll_counter] = parent.idc_itemcategories.getitemnumber(ll_counter, "icatcode")
		next
	else
		parent.istr_arg.ia_integerlist1[1] = -1000
		for ll_counter = 1 to ll_counter
			ll_found = parent.idc_itemcategories.find("name ='" + parent.lb_selecteditemcategories.text(ll_counter) + "'", 1, parent.idc_itemcategories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist1[ll_counter] = parent.idc_itemcategories.getitemnumber(ll_found, "icatcode")
			end if
		next
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.l_code1 = parent.dw_control3.getitemnumber(1, "iccode")
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// lb_categories.doubleclicked(integer index) returns long [event]
	parent.lb_selectedcategories.additem(string(parent.lb_categories.selecteditem()))
	parent.lb_categories.deleteitem(index)
	return ::message.returnvalue

// lb_selectedcategories.doubleclicked(integer index) returns long [event]
	parent.lb_categories.additem(string(parent.lb_selectedcategories.selecteditem()))
	parent.lb_selectedcategories.deleteitem(index)
	return ::message.returnvalue

// lb_selecteditemcategories.selectionchanged(integer index) returns long [event]
	parent.lb_itemcategories.additem(string(parent.lb_selecteditemcategories.selecteditem()))
	parent.lb_selecteditemcategories.deleteitem(index)
	return ::message.returnvalue

// lb_itemcategories.selectionchanged(integer index) returns long [event]
	parent.lb_selecteditemcategories.additem(string(parent.lb_itemcategories.selecteditem()))
	parent.lb_itemcategories.deleteitem(index)
	return ::message.returnvalue
