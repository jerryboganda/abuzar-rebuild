// window w_arg_emp_category_dept_period (reports)  ancestor: w_listarguments

// w_arg_emp_category_dept_period.create() returns 0 [event]
	integer icurrent
	call super::create
	this.dw_control2 = create dw_control2
	this.st_4 = create st_4
	this.st_selectable = create st_selectable
	this.st_selected = create st_selected
	this.lb_cust = create lb_cust
	this.lb_selectedcust = create lb_selectedcust
	this.cbx_allcust = create cbx_allcust
	this.st_10 = create st_10
	this.st_11 = create st_11
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_control2
	this.control[icurrent + 2] = this.st_4
	this.control[icurrent + 3] = this.st_selectable
	this.control[icurrent + 4] = this.st_selected
	this.control[icurrent + 5] = this.lb_cust
	this.control[icurrent + 6] = this.lb_selectedcust
	this.control[icurrent + 7] = this.cbx_allcust
	this.control[icurrent + 8] = this.st_10
	this.control[icurrent + 9] = this.st_11

// w_arg_emp_category_dept_period.destroy() returns 0 [event]
	call super::destroy
	destroy this.dw_control2
	destroy this.st_4
	destroy this.st_selectable
	destroy this.st_selected
	destroy this.lb_cust
	destroy this.lb_selectedcust
	destroy this.cbx_allcust
	destroy this.st_10
	destroy this.st_11

// w_arg_emp_category_dept_period.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.is_dataobject = "d_arg_emp_category"
	this.is_colname = "empcatcode"
	this.is_childcolname = "empcatcode"
	this.st_selectable.text = "Category"
	this.st_selected.text = "Category"
	this.dw_control.dataobject = this.is_dataobject
	this.dw_control.settransobject(sqlca)
	this.dw_control.retrieve()
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild(this.is_colname, this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.retrieve()
	this.dw_control2.scrolltorow(0)
	rtncode = this.dw_control2.getchild("deptcode", this.idc_child)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_child.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_cust.additem(this.idc_child.getitemstring(ll_counter, "name"))
	next
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.s_name1 = ""
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, parent.is_childcolname)
			parent.istr_arg.s_name1 = parent.istr_arg.s_name1 + trim(string(parent.istr_arg.ia_integerlist[ll_counter])) + ","
		next
	else
		parent.istr_arg.ia_integerlist[1] = -1000
		for ll_counter = 1 to ll_counter
			ll_found = parent.idc_categories.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, parent.is_childcolname)
				parent.istr_arg.s_name1 = parent.istr_arg.s_name1 + trim(string(parent.istr_arg.ia_integerlist[ll_counter])) + ","
			end if
		next
	end if
	parent.istr_arg.s_name2 = ""
	if parent.cbx_allcust.checked = true then
		for ll_counter = 1 to parent.idc_child.rowcount()
			parent.istr_arg.ia_integerlist1[ll_counter] = parent.idc_child.getitemnumber(ll_counter, "code")
			parent.istr_arg.s_name2 = parent.istr_arg.s_name2 + trim(string(parent.istr_arg.ia_integerlist1[ll_counter])) + ","
		next
	else
		parent.istr_arg.ia_integerlist1[1] = -1000
		for ll_counter = 1 to ll_counter
			ll_found = parent.idc_child.find("name ='" + parent.lb_selectedcust.text(ll_counter) + "'", 1, parent.idc_child.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist1[ll_counter] = parent.idc_child.getitemnumber(ll_found, "code")
				parent.istr_arg.s_name2 = parent.istr_arg.s_name2 + trim(string(parent.istr_arg.ia_integerlist1[ll_counter])) + ","
			end if
		next
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_control2.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// lb_cust.ue_keypress(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_cust.doubleclicked(integer index) returns long [event]
	string ls_item
	long ll_selectedindex
	ls_item = string(selecteditem())
	ll_selectedindex = selectedindex()
	if not isnull(ls_item) and index >= 1 then
		parent.lb_selectedcust.additem(ls_item)
		deleteitem(index)
		if ll_selectedindex > 1 then
			if totalitems() < ll_selectedindex then
				selectitem(totalitems())
			else
				selectitem(ll_selectedindex)
			end if
		else
			selectitem(1)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selectable listbox")
	end if
	return ::message.returnvalue

// lb_cust.getfocus() returns long [event]
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue

// lb_selectedcust.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_selectedcust.doubleclicked(integer index) returns long [event]
	string ls_item
	long ll_selectedindex
	ll_selectedindex = selectedindex()
	ls_item = string(selecteditem())
	if not isnull(ls_item) and index >= 1 then
		parent.lb_cust.additem(ls_item)
		deleteitem(index)
		if totalitems() < ll_selectedindex then
			selectitem(totalitems())
		else
			selectitem(ll_selectedindex)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selected listbox")
	end if
	return ::message.returnvalue

// lb_selectedcust.getfocus() returns long [event]
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue
