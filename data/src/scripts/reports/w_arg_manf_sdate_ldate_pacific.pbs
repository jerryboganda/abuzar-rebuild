// window w_arg_manf_sdate_ldate_pacific (reports)  ancestor: w_arguements

// w_arg_manf_sdate_ldate_pacific.create() returns 0
	integer icurrent
	call super::create
	this.cbx_cust = create cbx_cust
	this.cbx_trans = create cbx_trans
	this.cb_trans = create cb_trans
	this.cb_cust = create cb_cust
	this.cb_area = create cb_area
	this.hpb_hpb = create hpb_hpb
	this.dw_control2 = create dw_control2
	this.cbx_subarea = create cbx_subarea
	this.cb_subarea = create cb_subarea
	this.gb_overallprogress = create gb_overallprogress
	this.cbx_area = create cbx_area
	this.cb_item = create cb_item
	this.cbx_item = create cbx_item
	this.gb_2 = create gb_2
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_cust
	this.control[icurrent + 2] = this.cbx_trans
	this.control[icurrent + 3] = this.cb_trans
	this.control[icurrent + 4] = this.cb_cust
	this.control[icurrent + 5] = this.cb_area
	this.control[icurrent + 6] = this.hpb_hpb
	this.control[icurrent + 7] = this.dw_control2
	this.control[icurrent + 8] = this.cbx_subarea
	this.control[icurrent + 9] = this.cb_subarea
	this.control[icurrent + 10] = this.gb_overallprogress
	this.control[icurrent + 11] = this.cbx_area
	this.control[icurrent + 12] = this.cb_item
	this.control[icurrent + 13] = this.cbx_item
	this.control[icurrent + 14] = this.gb_2

// w_arg_manf_sdate_ldate_pacific.destroy() returns 0
	call super::destroy
	destroy this.cbx_cust
	destroy this.cbx_trans
	destroy this.cb_trans
	destroy this.cb_cust
	destroy this.cb_area
	destroy this.hpb_hpb
	destroy this.dw_control2
	destroy this.cbx_subarea
	destroy this.cb_subarea
	destroy this.gb_overallprogress
	destroy this.cbx_area
	destroy this.cb_item
	destroy this.cbx_item
	destroy this.gb_2

// w_arg_manf_sdate_ldate_pacific.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.retrieve()
	this.dw_control2.scrolltorow(0)
	this.is_trans = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "TRANS.XLS"
	this.is_cust = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "CHEMIST.XLS"
	this.is_area = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "TERRITORY.XLS"
	this.is_subarea = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "BRICK.XLS"
	this.is_item = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "ITEM.XLS"
	this.dw_control2.object.distcode[1] = f_stringpreferences("MerckDistCode")
	return ::message.returnvalue

// w_arg_manf_sdate_ldate_pacific.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_trans.clicked() returns long
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_trans, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_cust.clicked() returns long
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_cust, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_area.clicked() returns long
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_area, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// dw_control2.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_control2.itemchanged(long row, dwobject dwo, string data) returns long
	long ancestorreturnvalue
	string ls_distcode
	string ls_sys
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "distcode"
		parent.is_trans = trim(f_stringpreferences("OutputFilePath")) + data + "TRANS.XLS"
		parent.is_cust = trim(f_stringpreferences("OutputFilePath")) + data + "CHEMIST.XLS"
		parent.is_area = trim(f_stringpreferences("OutputFilePath")) + data + "TERRITORY.XLS"
		parent.is_subarea = trim(f_stringpreferences("OutputFilePath")) + data + "BRICK.XLS"
		parent.is_item = trim(f_stringpreferences("OutputFilePath")) + data + "ITEM.XLS"
	end choose
	return 0

// cb_subarea.clicked() returns long
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_subarea, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_item.clicked() returns long
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_item, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue
