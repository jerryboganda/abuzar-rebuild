// window w_arg_manf_sdate_ldate_atco (reports)  ancestor: w_arguements

// w_arg_manf_sdate_ldate_atco.create() returns 0
	integer icurrent
	call super::create
	this.cbx_cust = create cbx_cust
	this.cbx_sman = create cbx_sman
	this.gb_2 = create gb_2
	this.cbx_trans = create cbx_trans
	this.cb_trans = create cb_trans
	this.cb_cust = create cb_cust
	this.cb_sman = create cb_sman
	this.hpb_hpb = create hpb_hpb
	this.rb_txt = create rb_txt
	this.rb_excel = create rb_excel
	this.gb_overallprogress = create gb_overallprogress
	this.gb_3 = create gb_3
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_cust
	this.control[icurrent + 2] = this.cbx_sman
	this.control[icurrent + 3] = this.gb_2
	this.control[icurrent + 4] = this.cbx_trans
	this.control[icurrent + 5] = this.cb_trans
	this.control[icurrent + 6] = this.cb_cust
	this.control[icurrent + 7] = this.cb_sman
	this.control[icurrent + 8] = this.hpb_hpb
	this.control[icurrent + 9] = this.rb_txt
	this.control[icurrent + 10] = this.rb_excel
	this.control[icurrent + 11] = this.gb_overallprogress
	this.control[icurrent + 12] = this.gb_3

// w_arg_manf_sdate_ldate_atco.destroy() returns 0
	call super::destroy
	destroy this.cbx_cust
	destroy this.cbx_sman
	destroy this.gb_2
	destroy this.cbx_trans
	destroy this.cb_trans
	destroy this.cb_cust
	destroy this.cb_sman
	destroy this.hpb_hpb
	destroy this.rb_txt
	destroy this.rb_excel
	destroy this.gb_overallprogress
	destroy this.gb_3

// w_arg_manf_sdate_ldate_atco.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.is_trans = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "INV.XLS"
	this.is_cust = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "CUST.XLS"
	return ::message.returnvalue

// w_arg_manf_sdate_ldate_atco.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_trans.clicked() returns long
	string ls_named
	integer li_value
	if parent.rb_excel.checked = true then
		li_value = getfilesavename("Select File Location", parent.is_trans, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	end if
	if parent.rb_txt.checked = true then
		li_value = getfilesavename("Select File Location", parent.is_trans, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	end if
	return ::message.returnvalue

// cb_cust.clicked() returns long
	string ls_named
	integer li_value
	if parent.rb_excel.checked = true then
		li_value = getfilesavename("Select File Location", parent.is_cust, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	end if
	if parent.rb_txt.checked = true then
		li_value = getfilesavename("Select File Location", parent.is_cust, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	end if
	return ::message.returnvalue

// cb_sman.clicked() returns long
	string ls_named
	integer li_value
	if parent.rb_excel.checked = true then
		li_value = getfilesavename("Select File Location", parent.is_sman, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	end if
	if parent.rb_txt.checked = true then
		li_value = getfilesavename("Select File Location", parent.is_sman, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	end if
	return ::message.returnvalue

// rb_txt.clicked() returns long
	if this.checked = true then
		parent.is_trans = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "INV.TXT"
		parent.is_cust = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "CUST.TXT"
	else
		parent.is_trans = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "INV.XLS"
		parent.is_cust = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "CUST.XLS"
	end if
	return ::message.returnvalue

// rb_excel.clicked() returns long
	if this.checked = true then
		parent.is_trans = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "INV.XLS"
		parent.is_cust = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "CUST.XLS"
	else
		parent.is_trans = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "INV.TXT"
		parent.is_cust = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "CUST.TXT"
	end if
	return ::message.returnvalue
