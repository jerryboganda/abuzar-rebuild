// window w_arg_manufacturers_manfcatfilter (reports)  ancestor: w_listarguments

// w_arg_manufacturers_manfcatfilter.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8

// w_arg_manufacturers_manfcatfilter.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_8

// w_arg_manufacturers_manfcatfilter.open() returns long [event]
	string ls_text
	string ls_manfcat
	long ll_counter
	long ll_rowcount
	integer rtncode
	date ld_currdate
	time lt_currtime
	datetime ld_startdate
	datetime ld_enddate
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	this.istr_arg_parm = message.powerobjectparm
	for ll_counter = 1 to upperbound(this.istr_arg_parm.ia_integerlist)
		ls_manfcat = ls_manfcat + trim(string(this.istr_arg_parm.ia_integerlist[ll_counter])) + ","
	next
	if len(ls_manfcat) > 0 and right(ls_manfcat, 1) = "," then
		ls_manfcat = left(ls_manfcat, len(ls_manfcat) - 1)
	end if
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	ld_currdate = today()
	if f_stringpreferences("ApplyArgSDate") = "N" then
		ls_text = string(ld_currdate, "dd/mm/yyyy")
		ls_text = trim(ls_text) + " 00:00:00"
	else
		ls_text = string(f_datepreferences("DefaultArgSDate"), "dd/mm/yyyy hh:mm:ss")
	end if
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.em_enddate.text = ls_text
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("manufacturers", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	this.idc_categories.settransobject(sqlca)
	this.idc_categories.setfilter(" manfcatcode IN ( " + ls_manfcat + " )")
	this.idc_categories.filter()
	this.idc_categories.retrieve()
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "manfcode")
		next
	else
		for ll_counter = 1 to parent.lb_selectedcategories.totalitems()
			ll_found = parent.idc_categories.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "manfcode")
			end if
		next
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
