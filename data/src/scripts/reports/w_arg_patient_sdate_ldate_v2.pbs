// window w_arg_patient_sdate_ldate_v2 (reports)  ancestor: w_popup_forselection_walias

// w_arg_patient_sdate_ldate_v2.create() returns 0
	integer icurrent
	call super::create
	this.gb_2 = create gb_2
	this.st_1 = create st_1
	this.st_2 = create st_2
	this.em_startdate = create em_startdate
	this.em_enddate = create em_enddate
	this.st_3 = create st_3
	this.st_4 = create st_4
	this.st_5 = create st_5
	this.em_admitdate = create em_admitdate
	this.em_dischargedate = create em_dischargedate
	this.em_issuedate = create em_issuedate
	this.em_adno = create em_adno
	this.st_6 = create st_6
	this.st_7 = create st_7
	this.em_discperc = create em_discperc
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_2
	this.control[icurrent + 2] = this.st_1
	this.control[icurrent + 3] = this.st_2
	this.control[icurrent + 4] = this.em_startdate
	this.control[icurrent + 5] = this.em_enddate
	this.control[icurrent + 6] = this.st_3
	this.control[icurrent + 7] = this.st_4
	this.control[icurrent + 8] = this.st_5
	this.control[icurrent + 9] = this.em_admitdate
	this.control[icurrent + 10] = this.em_dischargedate
	this.control[icurrent + 11] = this.em_issuedate
	this.control[icurrent + 12] = this.em_adno
	this.control[icurrent + 13] = this.st_6
	this.control[icurrent + 14] = this.st_7
	this.control[icurrent + 15] = this.em_discperc

// w_arg_patient_sdate_ldate_v2.destroy() returns 0
	call super::destroy
	destroy this.gb_2
	destroy this.st_1
	destroy this.st_2
	destroy this.em_startdate
	destroy this.em_enddate
	destroy this.st_3
	destroy this.st_4
	destroy this.st_5
	destroy this.em_admitdate
	destroy this.em_dischargedate
	destroy this.em_issuedate
	destroy this.em_adno
	destroy this.st_6
	destroy this.st_7
	destroy this.em_discperc

// w_arg_patient_sdate_ldate_v2.open() returns long
	long ancestorreturnvalue
	date ld_currdate
	string ls_text
	ancestorreturnvalue = super::open()
	ld_currdate = today()
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	this.em_admitdate.text = ls_text
	this.em_dischargedate.text = ls_text
	this.em_issuedate.text = ls_text
	ls_text = trim(ls_text) + " 00:00:00"
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.em_enddate.text = ls_text
	return ::message.returnvalue

// w_arg_patient_sdate_ldate_v2.ue_close() returns 0
	closewithreturn(this, this.istr_arg)

// em_startdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_enddate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

