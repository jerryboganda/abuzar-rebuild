// window w_arg_batch_selection (reports)  ancestor: w_popup_forselection_walias

// w_arg_batch_selection.create() returns 0
	integer icurrent
	call super::create
	this.gb_2 = create gb_2
	this.st_1 = create st_1
	this.st_2 = create st_2
	this.em_startdate = create em_startdate
	this.em_enddate = create em_enddate
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_2
	this.control[icurrent + 2] = this.st_1
	this.control[icurrent + 3] = this.st_2
	this.control[icurrent + 4] = this.em_startdate
	this.control[icurrent + 5] = this.em_enddate

// w_arg_batch_selection.destroy() returns 0
	call super::destroy
	destroy this.gb_2
	destroy this.st_1
	destroy this.st_2
	destroy this.em_startdate
	destroy this.em_enddate

// w_arg_batch_selection.open() returns long
	date ld_currdate
	string ls_text
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_groupcode
	environment env
	s_positem ls_itemdetail
	ll_groupcode = f_getgroupcode(gl_usercode)
	ls_itemdetail = message.powerobjectparm
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	setredraw(false)
	this.id_selected = create datawindow
	this.id_selected.settransobject(sqlca)
	this.id_selected = this.dw_selected
	this.id_selectionlist = create datawindow
	this.id_selectionlist = this.dw_selectionlist
	this.id_selectionlist.settransobject(sqlca)
	this.id_selected.reset()
	this.id_selected.insertrow(0)
	this.id_selectionlist.retrieve(ls_itemdetail.l_icode, ll_groupcode, 1)
	if this.id_selectionlist.rowcount() <= 0 then
		messagebox("Stock Information", "No Stock Information Available.~r~nKindly selection some other item.", information!)
		this.istr_arg.i_status = -1
		closewithreturn(this, this.istr_arg)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	setredraw(true)
	post event ue_postopen()
	ld_currdate = today()
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 00:00:00"
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.em_enddate.text = ls_text
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_arg_batch_selection.ue_close() returns 0
	closewithreturn(this, this.istr_arg)

// em_startdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_enddate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
