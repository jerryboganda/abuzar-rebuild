// window w_arg_spocode_lpocode (reports)  ancestor: w_arguements

// w_arg_spocode_lpocode.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.cbx_storekeepersummary = create cbx_storekeepersummary
	this.cbx_billsummary = create cbx_billsummary
	this.cbx_invoiceprinting = create cbx_invoiceprinting
	this.ddlb_format = create ddlb_format
	this.st_5 = create st_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.cbx_storekeepersummary
	this.control[icurrent + 3] = this.cbx_billsummary
	this.control[icurrent + 4] = this.cbx_invoiceprinting
	this.control[icurrent + 5] = this.ddlb_format
	this.control[icurrent + 6] = this.st_5

// w_arg_spocode_lpocode.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.cbx_storekeepersummary
	destroy this.cbx_billsummary
	destroy this.cbx_invoiceprinting
	destroy this.ddlb_format
	destroy this.st_5

// w_arg_spocode_lpocode.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_spocode_lpocode.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// dw_control.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "sinvcode"
		if isnull(long(data)) then
			messagebox("Starting Invoice No.", "Must Select a Starting Invoice Number")
			return 1
		end if
		if isnull(parent.dw_control.getitemnumber(row, "linvcode")) then
			parent.dw_control.setitem(row, "linvcode", long(data))
		end if
	case "linvcode"
		if isnull(long(data)) then
			messagebox("Last Invoice No.", "Must Select a Last Invoice Number")
			return 1
		elseif long(data) < parent.dw_control.getitemnumber(row, "sinvcode") then
			messagebox("Last Invoice No. Validation", "Last Invoice Number Must be greater or ~requal to starting invoice no.")
			return 1
		end if
	end choose
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "sinvcode")
	parent.istr_arg.l_code2 = parent.dw_control.getitemnumber(1, "linvcode")
	if parent.ddlb_format.text = "Format-13" then
		parent.istr_arg.l_code3 = 13
	elseif parent.ddlb_format.text = "Format-12" then
		parent.istr_arg.l_code3 = 12
	elseif parent.ddlb_format.text = "Format-11" then
		parent.istr_arg.l_code3 = 11
	elseif parent.ddlb_format.text = "Format-10" then
		parent.istr_arg.l_code3 = 10
	elseif parent.ddlb_format.text = "Format -9" then
		parent.istr_arg.l_code3 = 9
	elseif parent.ddlb_format.text = "Format -8" then
		parent.istr_arg.l_code3 = 8
	elseif parent.ddlb_format.text = "Format -7" then
		parent.istr_arg.l_code3 = 7
	elseif parent.ddlb_format.text = "Format -6" then
		parent.istr_arg.l_code3 = 6
	elseif parent.ddlb_format.text = "Format -5" then
		parent.istr_arg.l_code3 = 5
	elseif parent.ddlb_format.text = "Format -4" then
		parent.istr_arg.l_code3 = 4
	elseif parent.ddlb_format.text = "Format -3" then
		parent.istr_arg.l_code3 = 3
	elseif parent.ddlb_format.text = "Format -2" then
		parent.istr_arg.l_code3 = 2
	else
		parent.istr_arg.l_code3 = 1
	end if
	if parent.istr_arg.l_code1 > parent.istr_arg.l_code2 then
		messagebox("Purcahse Order No. Validation", "Last Order Number Must be greater or ~requal to starting order no.")
		return 1
	end if
	if parent.cbx_invoiceprinting.checked = true then
		parent.istr_arg.s_name1 = "Y"
	else
		parent.istr_arg.s_name1 = "N"
	end if
	if parent.cbx_storekeepersummary.checked = true then
		parent.istr_arg.s_name2 = "Y"
	else
		parent.istr_arg.s_name2 = "N"
	end if
	if parent.cbx_billsummary.checked = true then
		parent.istr_arg.s_name3 = "Y"
	else
		parent.istr_arg.s_name3 = "N"
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// ddlb_format.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
