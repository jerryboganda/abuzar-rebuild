// window w_arg_invcode_caption (reports)  ancestor: w_arguements

// w_arg_invcode_caption.create() returns 0 [event]
	integer icurrent
	call super::create
	this.sle_remarks = create sle_remarks
	this.st_4 = create st_4
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.sle_remarks
	this.control[icurrent + 2] = this.st_4

// w_arg_invcode_caption.destroy() returns 0 [event]
	call super::destroy
	destroy this.sle_remarks
	destroy this.st_4

// w_arg_invcode_caption.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_invcode_caption.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "invcode")
	parent.istr_arg.s_name1 = parent.sle_remarks.text
	if parent.cbx_supress.checked then
		parent.istr_arg.s_name2 = "Y"
	else
		parent.istr_arg.s_name2 = "N"
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// sle_remarks.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
