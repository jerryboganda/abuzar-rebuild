// window w_arg_trialbalance (reports)  ancestor: w_arguements

// w_arg_trialbalance.create() returns 0 [event]
	integer icurrent
	call super::create
	this.rb_totaltb = create rb_totaltb
	this.rb_balancetb = create rb_balancetb
	this.rb_subacc = create rb_subacc
	this.rb_catacc = create rb_catacc
	this.rb_mainacc = create rb_mainacc
	this.rb_acc = create rb_acc
	this.rb_activity = create rb_activity
	this.rb_activity2 = create rb_activity2
	this.rb_activity3 = create rb_activity3
	this.gb_2 = create gb_2
	this.gb_3 = create gb_3
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.rb_totaltb
	this.control[icurrent + 2] = this.rb_balancetb
	this.control[icurrent + 3] = this.rb_subacc
	this.control[icurrent + 4] = this.rb_catacc
	this.control[icurrent + 5] = this.rb_mainacc
	this.control[icurrent + 6] = this.rb_acc
	this.control[icurrent + 7] = this.rb_activity
	this.control[icurrent + 8] = this.rb_activity2
	this.control[icurrent + 9] = this.rb_activity3
	this.control[icurrent + 10] = this.gb_2
	this.control[icurrent + 11] = this.gb_3

// w_arg_trialbalance.destroy() returns 0 [event]
	call super::destroy
	destroy this.rb_totaltb
	destroy this.rb_balancetb
	destroy this.rb_subacc
	destroy this.rb_catacc
	destroy this.rb_mainacc
	destroy this.rb_acc
	destroy this.rb_activity
	destroy this.rb_activity2
	destroy this.rb_activity3
	destroy this.gb_2
	destroy this.gb_3

// w_arg_trialbalance.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	if ai_stauts <> 1 then
		this.istr_arg.i_status = -1
	end if
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.i_status = -1
	parent.event ue_close(parent.istr_arg.i_status)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	string ls_enddate
	date ld_date
	ancestorreturnvalue = super::clicked()
	if parent.rb_balancetb.checked = true then
		parent.istr_arg.s_name1 = "Balance"
	elseif parent.rb_totaltb.checked = true then
		parent.istr_arg.s_name1 = "Total"
	elseif parent.rb_activity.checked = true then
		parent.istr_arg.s_name1 = "Activity"
	elseif parent.rb_activity2.checked = true then
		parent.istr_arg.s_name1 = "Activity2"
	else
		parent.istr_arg.s_name1 = "Activity3"
	end if
	if parent.rb_acc.checked = true then
		parent.istr_arg.s_name2 = "Accounts"
	elseif parent.rb_subacc.checked = true then
		parent.istr_arg.s_name2 = "SubAccounts"
	elseif parent.rb_mainacc.checked = true then
		parent.istr_arg.s_name2 = "MainAccounts"
	else
		parent.istr_arg.s_name2 = "CategoryAccounts"
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_status = 1
	if parent.istr_arg.s_name1 <> "Balance" then
		if parent.istr_arg.d_sdate <= parent.istr_arg.d_edate then
			parent.event ue_close(parent.istr_arg.i_status)
		else
			messagebox("Period Validation", "Please enter valid start date")
			parent.em_startdate.setfocus()
		end if
	else
		parent.event ue_close(parent.istr_arg.i_status)
	end if
	return ::message.returnvalue

// rb_totaltb.clicked() returns long [event]
	if this.checked = true then
		parent.st_1.visible = true
		parent.em_startdate.visible = true
	else
		parent.st_1.visible = false
		parent.em_startdate.visible = false
	end if
	return ::message.returnvalue

// rb_balancetb.clicked() returns long [event]
	if this.checked = true then
		parent.st_1.visible = false
		parent.em_startdate.visible = false
	else
		parent.st_1.visible = true
		parent.em_startdate.visible = true
	end if
	return ::message.returnvalue

// rb_activity.clicked() returns long [event]
	if this.checked = true then
		parent.st_1.visible = true
		parent.em_startdate.visible = true
	else
		parent.st_1.visible = false
		parent.em_startdate.visible = false
	end if
	return ::message.returnvalue
