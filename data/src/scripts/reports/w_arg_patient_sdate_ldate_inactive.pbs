// window w_arg_patient_sdate_ldate_inactive (reports)  ancestor: w_popup_forselection_walias

// w_arg_patient_sdate_ldate_inactive.create() returns 0
	integer icurrent
	call super::create
	this.gb_2 = create gb_2
	this.st_1 = create st_1
	this.st_2 = create st_2
	this.em_startdate = create em_startdate
	this.em_enddate = create em_enddate
	this.st_3 = create st_3
	this.dw_pagesize = create dw_pagesize
	this.st_4 = create st_4
	this.cbx_active = create cbx_active
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_2
	this.control[icurrent + 2] = this.st_1
	this.control[icurrent + 3] = this.st_2
	this.control[icurrent + 4] = this.em_startdate
	this.control[icurrent + 5] = this.em_enddate
	this.control[icurrent + 6] = this.st_3
	this.control[icurrent + 7] = this.dw_pagesize
	this.control[icurrent + 8] = this.st_4
	this.control[icurrent + 9] = this.cbx_active

// w_arg_patient_sdate_ldate_inactive.destroy() returns 0
	call super::destroy
	destroy this.gb_2
	destroy this.st_1
	destroy this.st_2
	destroy this.em_startdate
	destroy this.em_enddate
	destroy this.st_3
	destroy this.dw_pagesize
	destroy this.st_4
	destroy this.cbx_active

// w_arg_patient_sdate_ldate_inactive.open() returns long
	long ancestorreturnvalue
	date ld_currdate
	string ls_text
	ancestorreturnvalue = super::open()
	ld_currdate = today()
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 00:00:00"
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.dw_pagesize.settransobject(sqlca)
	this.dw_pagesize.insertrow(0)
	this.dw_pagesize.setitem(1, "pagesize", "Q")
	this.em_enddate.text = ls_text
	return ::message.returnvalue

// w_arg_patient_sdate_ldate_inactive.ue_close() returns 0
	closewithreturn(this, this.istr_arg)

// em_startdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_enddate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// dw_pagesize.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
