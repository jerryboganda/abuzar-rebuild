// window w_arg_header (reports)  ancestor: w_arguements

// w_arg_header.create() returns 0 [event]
	integer icurrent
	call super::create
	this.rb_detail = create rb_detail
	this.rb_summary = create rb_summary
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.rb_detail
	this.control[icurrent + 2] = this.rb_summary

// w_arg_header.destroy() returns 0 [event]
	call super::destroy
	destroy this.rb_detail
	destroy this.rb_summary

// w_arg_header.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// w_arg_header.open() returns long [event]
	long ancestorreturnvalue
	integer ll_counter
	datawindowchild ldc_headerno
	ancestorreturnvalue = super::open()
	this.dw_control.insertrow(0)
	this.dw_control.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to gds_reoprtheaderinfo.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "name", gds_reoprtheaderinfo.getitemstring(ll_counter, "clientname"))
		ldc_headerno.setitem(ll_counter, "code", gds_reoprtheaderinfo.getitemnumber(ll_counter, "headerno"))
	next
	return ::message.returnvalue

// dw_control.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.dw_control.accepttext()
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "headerno")
	if parent.rb_detail.checked = true then
		parent.istr_arg.l_code2 = 2
	else
		parent.istr_arg.l_code2 = 1
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
