// window w_arg_saleinvcode_page (reports)  ancestor: w_arguements

// w_arg_saleinvcode_page.create() returns 0 [event]
	integer icurrent
	call super::create
	this.dw_control2 = create dw_control2
	this.st_4 = create st_4
	this.st_5 = create st_5
	this.dw_pagesize = create dw_pagesize
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_control2
	this.control[icurrent + 2] = this.st_4
	this.control[icurrent + 3] = this.st_5
	this.control[icurrent + 4] = this.dw_pagesize

// w_arg_saleinvcode_page.destroy() returns 0 [event]
	call super::destroy
	destroy this.dw_control2
	destroy this.st_4
	destroy this.st_5
	destroy this.dw_pagesize

// w_arg_saleinvcode_page.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// w_arg_saleinvcode_page.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.em_startdate.text = string(today(), "dd/mm/yyyy hh:mm:ss")
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.insertrow(0)
	this.dw_control2.scrolltorow(0)
	this.dw_pagesize.insertrow(0)
	this.dw_pagesize.scrolltorow(0)
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_invcode
	long ll_retcode
	string ls_pagesize
	ancestorreturnvalue = super::clicked()
	if parent.dw_control2.accepttext() = 1 then
		ll_invcode = parent.dw_control2.getitemnumber(1, "saleinvcode")
		SQL SELECT saleinvcode INTO :ll_retcode FROM saleledger WHERE saleinvcode =:ll_invcode AND Posted ='Y' USING sqlca;
		if sqlca.sqlcode <> 0 then
			messagebox("Invoice Code Validation!", "Please Enter Valid Invoice Code.")
			parent.dw_control2.setfocus()
			parent.dw_control2.scrolltorow(1)
			parent.dw_control2.setcolumn("saleinvcode")
			return ::message.returnvalue
		end if
	else
		return ::message.returnvalue
	end if
	if parent.dw_pagesize.accepttext() = 1 then
		ls_pagesize = parent.dw_pagesize.getitemstring(1, "pagesize")
	else
		return ::message.returnvalue
	end if
	parent.istr_arg.l_code1 = ll_invcode
	parent.istr_arg.s_name2 = ls_pagesize
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_control2.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return ::message.returnvalue

// dw_pagesize.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return ::message.returnvalue
