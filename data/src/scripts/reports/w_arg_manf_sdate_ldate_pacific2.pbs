// window w_arg_manf_sdate_ldate_pacific2 (reports)  ancestor: w_arguements

// w_arg_manf_sdate_ldate_pacific2.create() returns 0 [event]
	integer icurrent
	call super::create
	this.cbx_cust = create cbx_cust
	this.cbx_trans = create cbx_trans
	this.cb_trans = create cb_trans
	this.cb_cust = create cb_cust
	this.cb_area = create cb_area
	this.hpb_hpb = create hpb_hpb
	this.dw_control2 = create dw_control2
	this.cbx_subarea = create cbx_subarea
	this.cb_subarea = create cb_subarea
	this.gb_overallprogress = create gb_overallprogress
	this.cbx_area = create cbx_area
	this.cb_item = create cb_item
	this.cbx_item = create cbx_item
	this.gb_2 = create gb_2
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_cust
	this.control[icurrent + 2] = this.cbx_trans
	this.control[icurrent + 3] = this.cb_trans
	this.control[icurrent + 4] = this.cb_cust
	this.control[icurrent + 5] = this.cb_area
	this.control[icurrent + 6] = this.hpb_hpb
	this.control[icurrent + 7] = this.dw_control2
	this.control[icurrent + 8] = this.cbx_subarea
	this.control[icurrent + 9] = this.cb_subarea
	this.control[icurrent + 10] = this.gb_overallprogress
	this.control[icurrent + 11] = this.cbx_area
	this.control[icurrent + 12] = this.cb_item
	this.control[icurrent + 13] = this.cbx_item
	this.control[icurrent + 14] = this.gb_2

// w_arg_manf_sdate_ldate_pacific2.destroy() returns 0 [event]
	call super::destroy
	destroy this.cbx_cust
	destroy this.cbx_trans
	destroy this.cb_trans
	destroy this.cb_cust
	destroy this.cb_area
	destroy this.hpb_hpb
	destroy this.dw_control2
	destroy this.cbx_subarea
	destroy this.cb_subarea
	destroy this.gb_overallprogress
	destroy this.cbx_area
	destroy this.cb_item
	destroy this.cbx_item
	destroy this.gb_2

// w_arg_manf_sdate_ldate_pacific2.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.retrieve()
	this.dw_control2.scrolltorow(0)
	this.is_trans = trim(f_stringpreferences("OutputFilePath")) + "TRANSACTION.XLS"
	this.is_cust = trim(f_stringpreferences("OutputFilePath")) + "CHEMIST.XLS"
	this.is_area = trim(f_stringpreferences("OutputFilePath")) + "STOCK.XLS"
	this.is_subarea = trim(f_stringpreferences("OutputFilePath")) + "BRICK.XLS"
	this.is_item = trim(f_stringpreferences("OutputFilePath")) + "PRODUCT.XLS"
	this.dw_control2.object.distcode[1] = f_stringpreferences("MerckDistCode")
	return ::message.returnvalue

// w_arg_manf_sdate_ldate_pacific2.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	string ls_distcode
	string ls_city
	long ll_ret
	datastore lds_excel
	ancestorreturnvalue = super::clicked()
	parent.dw_control2.accepttext()
	setpointer(hourglass!)
	parent.gb_overallprogress.visible = true
	parent.hpb_hpb.visible = true
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "manfcode")
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	ls_distcode = parent.dw_control2.object.distcode[1]
	ls_city = parent.dw_control2.object.city[1]
	if isnull(ls_distcode) or ls_distcode = "" then
		messagebox("Distributor Code Validation", "Please enter a valid Distributor Code")
		return ::message.returnvalue
	end if
	if isnull(ls_city) or ls_city = "" then
		messagebox("Distributor City Validation", "Please enter a valid Distributor City.")
		return ::message.returnvalue
	end if
	parent.istr_arg.i_status = 1
	lds_excel = create datastore
	if parent.cbx_subarea.checked = true then
		lds_excel.dataobject = "d_pacificpharma2_brick"
		lds_excel.settransobject(sqlca)
		lds_excel.retrieve(ls_distcode)
		if lds_excel.rowcount() <= 0 then
			messagebox("Brick/Area List Generation Problem", "Error Generating Brick/Area List File~r~nPlease Try Later")
			destroy lds_excel
			return ::message.returnvalue
		else
			ll_ret = uf_save_ds_as_excel(lds_excel, parent.is_subarea)
			if ll_ret <> 1 then
				messagebox("Save as Excel File", "Problem in Saving Excel File for Brick/Sub Area List")
				destroy lds_excel
				return ::message.returnvalue
			end if
		end if
		return
	end if
	parent.hpb_hpb.stepit()
	if parent.cbx_cust.checked = true then
		lds_excel.dataobject = "d_pacificpharma2_chemist"
		lds_excel.settransobject(sqlca)
		lds_excel.retrieve(ls_distcode)
		if lds_excel.rowcount() <= 0 then
			messagebox("Chemist List Generation Problem", "Error Generating Chemist List File~r~nPlease Try Later")
			destroy lds_excel
			return ::message.returnvalue
		else
			ll_ret = uf_save_ds_as_excel(lds_excel, parent.is_cust)
			if ll_ret <> 1 then
				messagebox("Save as Excel File", "Problem in Saving Excel File for Chemist List")
				destroy lds_excel
				return ::message.returnvalue
			end if
		end if
		return
	end if
	parent.hpb_hpb.stepit()
	if parent.cbx_area.checked = true then
		lds_excel.dataobject = "d_pacificpharma2_stock"
		lds_excel.settransobject(sqlca)
		lds_excel.retrieve(ls_distcode, parent.istr_arg.l_code1, parent.istr_arg.d_edate)
		if lds_excel.rowcount() <= 0 then
			messagebox("Stock File Generation Problem", "Error Generating Stock File~r~nPlease Try Later")
			destroy lds_excel
			return ::message.returnvalue
		else
			ll_ret = uf_save_ds_as_excel(lds_excel, parent.is_area)
			if ll_ret <> 1 then
				messagebox("Save as Excel File", "Problem in Saving Excel File for Territory/Area List")
				destroy lds_excel
				return ::message.returnvalue
			end if
		end if
		return
	end if
	parent.hpb_hpb.stepit()
	if parent.cbx_item.checked = true then
		lds_excel.dataobject = "d_pacificpharma2_item"
		lds_excel.settransobject(sqlca)
		lds_excel.retrieve(ls_distcode, parent.istr_arg.l_code1)
		if lds_excel.rowcount() <= 0 then
			messagebox("Product/Item List Generation Problem", "Error Generating Product/Item List File~r~nPlease Try Later")
			destroy lds_excel
			return ::message.returnvalue
		else
			ll_ret = uf_save_ds_as_excel(lds_excel, parent.is_item)
			if ll_ret <> 1 then
				messagebox("Save as Excel File", "Problem in Saving Excel File for Product/Item List")
				destroy lds_excel
				return ::message.returnvalue
			end if
		end if
		return
	end if
	parent.hpb_hpb.stepit()
	parent.hpb_hpb.stepit()
	if parent.cbx_trans.checked = true then
		lds_excel.dataobject = "d_pacificpharma2_trans"
		lds_excel.settransobject(sqlca)
		lds_excel.retrieve(ls_distcode, parent.istr_arg.l_code1, parent.istr_arg.d_sdate, parent.istr_arg.d_edate)
		parent.hpb_hpb.stepit()
		if lds_excel.rowcount() <= 0 then
			messagebox("Transaction Data File Generation Problem", "Error Generating Transaction Data File~r~nPlease Try Later")
			destroy lds_excel
			return ::message.returnvalue
		else
			parent.hpb_hpb.stepit()
			ll_ret = uf_save_ds_as_excel(lds_excel, parent.is_trans)
			parent.hpb_hpb.stepit()
			if ll_ret <> 1 then
				messagebox("Save as Excel File", "Problem in Saving Excel File for Transaction Data File")
				destroy lds_excel
				return ::message.returnvalue
			end if
		end if
		return
	end if
	parent.hpb_hpb.stepit()
	parent.hpb_hpb.stepit()
	parent.hpb_hpb.stepit()
	destroy lds_excel
	setpointer(arrow!)
	parent.post event ue_close(1)
	return ::message.returnvalue

// cb_trans.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_trans, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_cust.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_cust, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_area.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_area, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// dw_control2.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_control2.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_distcode
	string ls_sys
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "distcode"
		parent.is_trans = trim(f_stringpreferences("OutputFilePath")) + "TRANSACTION.XLS"
		parent.is_cust = trim(f_stringpreferences("OutputFilePath")) + "CHEMIST.XLS"
		parent.is_area = trim(f_stringpreferences("OutputFilePath")) + "STOCK.XLS"
		parent.is_subarea = trim(f_stringpreferences("OutputFilePath")) + "BRICK.XLS"
		parent.is_item = trim(f_stringpreferences("OutputFilePath")) + "PRODUCT.XLS"
	end choose
	return 0

// cb_subarea.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_subarea, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_item.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_item, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue
