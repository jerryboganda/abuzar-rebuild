// window w_arg_date_customerv4 (reports)  ancestor: w_listarguments

// w_arg_date_customerv4.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.cbx_suppressheader = create cbx_suppressheader
	this.rb_originaldate = create rb_originaldate
	this.rb_lastsavingdate = create rb_lastsavingdate
	this.rb_billingdate = create rb_billingdate
	this.sle_line1 = create sle_line1
	this.st_9 = create st_9
	this.gb_5 = create gb_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.cbx_suppressheader
	this.control[icurrent + 4] = this.rb_originaldate
	this.control[icurrent + 5] = this.rb_lastsavingdate
	this.control[icurrent + 6] = this.rb_billingdate
	this.control[icurrent + 7] = this.sle_line1
	this.control[icurrent + 8] = this.st_9
	this.control[icurrent + 9] = this.gb_5

// w_arg_date_customerv4.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.cbx_suppressheader
	destroy this.rb_originaldate
	destroy this.rb_lastsavingdate
	destroy this.rb_billingdate
	destroy this.sle_line1
	destroy this.st_9
	destroy this.gb_5

// w_arg_date_customerv4.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("custcode", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "customer_name"))
	next
	this.lb_categories.setfocus()
	this.lb_categories.selectitem(1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "accounts_acccode")
		next
	else
		for ll_counter = 1 to ll_counter
			ll_found = parent.idc_categories.find("customer_name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "accounts_acccode")
			end if
		next
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if parent.rb_originaldate.checked then
		parent.istr_arg.s_name3 = "originaldate"
	elseif parent.rb_billingdate.checked then
		parent.istr_arg.s_name3 = "billingdate"
	else
		parent.istr_arg.s_name3 = "lastsavingdate"
	end if
	parent.istr_arg.s_name4 = parent.sle_line1.text
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	if parent.cbx_suppressheader.checked then
		parent.istr_arg.l_code1 = 1
	else
		parent.istr_arg.l_code1 = 0
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// rb_originaldate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// rb_lastsavingdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// rb_billingdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
