// window w_arg_item_smans_sdate_ldate (reports)  ancestor: w_popup_forselection_walias

// w_arg_item_smans_sdate_ldate.create() returns 0 [event]
	integer icurrent
	call super::create
	this.gb_2 = create gb_2
	this.st_1 = create st_1
	this.st_2 = create st_2
	this.em_startdate = create em_startdate
	this.em_enddate = create em_enddate
	this.dw_control = create dw_control
	this.st_selectable = create st_selectable
	this.lb_selectable = create lb_selectable
	this.lb_selected = create lb_selected
	this.st_selected = create st_selected
	this.cbx_all = create cbx_all
	this.gb_3 = create gb_3
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_2
	this.control[icurrent + 2] = this.st_1
	this.control[icurrent + 3] = this.st_2
	this.control[icurrent + 4] = this.em_startdate
	this.control[icurrent + 5] = this.em_enddate
	this.control[icurrent + 6] = this.dw_control
	this.control[icurrent + 7] = this.st_selectable
	this.control[icurrent + 8] = this.lb_selectable
	this.control[icurrent + 9] = this.lb_selected
	this.control[icurrent + 10] = this.st_selected
	this.control[icurrent + 11] = this.cbx_all
	this.control[icurrent + 12] = this.gb_3

// w_arg_item_smans_sdate_ldate.destroy() returns 0 [event]
	call super::destroy
	destroy this.gb_2
	destroy this.st_1
	destroy this.st_2
	destroy this.em_startdate
	destroy this.em_enddate
	destroy this.dw_control
	destroy this.st_selectable
	destroy this.lb_selectable
	destroy this.lb_selected
	destroy this.st_selected
	destroy this.cbx_all
	destroy this.gb_3

// w_arg_item_smans_sdate_ldate.open() returns long [event]
	long ancestorreturnvalue
	integer rtncode
	long ll_rowcount
	long ll_counter
	date ld_currdate
	string ls_text
	ancestorreturnvalue = super::open()
	gd_itemsinfo.sharedata(this.id_selectionlist)
	ld_currdate = today()
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 00:00:00"
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.em_enddate.text = ls_text
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("salesman", this.idc_selectedvalue)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_selectedvalue.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_selectable.additem(this.idc_selectedvalue.getitemstring(ll_counter, "name"))
	next
	return ::message.returnvalue

// w_arg_item_smans_sdate_ldate.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ll_counter
	long ll_found
	if parent.id_selected.accepttext() = -1 then
		parent.id_selected.setfocus()
		return ::message.returnvalue
	elseif isnull(parent.id_selected.getitemstring(parent.id_selected.getrow(), "name")) then
		messagebox("Name Validation", "Please enter valid value for Name.")
		parent.id_selected.setcolumn(1)
		parent.id_selected.setfocus()
		return ::message.returnvalue
	end if
	parent.is_popup_selection.l_code = parent.id_selected.getitemnumber(parent.id_selected.getrow(), "code")
	parent.is_popup_selection.s_name = parent.id_selected.getitemstring(parent.id_selected.getrow(), "name")
	parent.istr_arg.l_code1 = parent.id_selected.getitemnumber(1, "code")
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_selectedvalue.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_selectedvalue.getitemnumber(ll_counter, "salesmancode")
		next
	else
		parent.istr_arg.ia_integerlist[1] = -1000
		for ll_counter = 1 to parent.lb_selected.totalitems()
			ll_found = parent.idc_selectedvalue.find("name ='" + parent.lb_selected.text(ll_counter) + "'", 1, parent.idc_selectedvalue.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_selectedvalue.getitemnumber(ll_found, "salesmancode")
			end if
		next
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_status = 1
	parent.post event ue_close()
	return ::message.returnvalue

// em_startdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_enddate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// dw_control.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// lb_selectable.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_selectable.doubleclicked(integer index) returns long [event]
	string ls_item
	long ll_selectedindex
	ls_item = string(selecteditem())
	ll_selectedindex = selectedindex()
	if not isnull(ls_item) and index >= 1 then
		parent.lb_selected.additem(ls_item)
		deleteitem(index)
		if ll_selectedindex > 1 then
			if totalitems() < ll_selectedindex then
				selectitem(totalitems())
			else
				selectitem(ll_selectedindex)
			end if
		else
			selectitem(1)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selectable listbox")
	end if
	return ::message.returnvalue

// lb_selectable.getfocus() returns long [event]
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue

// lb_selected.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_selected.getfocus() returns long [event]
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue

// lb_selected.doubleclicked(integer index) returns long [event]
	string ls_item
	long ll_selectedindex
	ll_selectedindex = selectedindex()
	ls_item = string(selecteditem())
	if not isnull(ls_item) and index >= 1 then
		parent.lb_selectable.additem(ls_item)
		deleteitem(index)
		if totalitems() < ll_selectedindex then
			selectitem(totalitems())
		else
			selectitem(ll_selectedindex)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selected listbox")
	end if
	return ::message.returnvalue

// cbx_all.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
