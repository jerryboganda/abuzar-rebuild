// window w_arg_ref (reports)  ancestor: w_arguements

// w_arg_ref.create() returns 0 [event]
	call super::create

// w_arg_ref.destroy() returns 0 [event]
	call super::destroy

// w_arg_ref.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_ref.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.s_name1 = parent.dw_control.getitemstring(1, "refno")
	if isnull(parent.istr_arg.s_name1) then
		messagebox("Reference No. Validation", "Please select a valid Reference No.")
		return ::message.returnvalue
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
