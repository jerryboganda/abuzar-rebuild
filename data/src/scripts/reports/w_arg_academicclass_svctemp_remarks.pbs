// window w_arg_academicclass_svctemp_remarks (reports)  ancestor: w_listarguments

// w_arg_academicclass_svctemp_remarks.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.dw_template = create dw_template
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.dw_template

// w_arg_academicclass_svctemp_remarks.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.dw_template

// w_arg_academicclass_svctemp_remarks.open() returns long [event]
	long ancestorreturnvalue
	string ls_stringparam
	string ls_filter
	long ll_counter
	long ll_rowcount
	integer rtncode
	listviewitem l_lvi
	ancestorreturnvalue = super::open()
	ls_stringparam = message.stringparm
	this.dw_control.settransobject(sqlca)
	rtncode = this.dw_control.retrieve()
	if rtncode = -1 then
		messagebox("Error", "No Account(s) To Select")
	else
		ll_rowcount = this.dw_control.rowcount()
		ll_counter = 1
		for ll_counter = 1 to ll_rowcount
			this.lb_categories.additem(this.dw_control.getitemstring(ll_counter, "name"))
		next
	end if
	this.dw_template.settransobject(sqlca)
	rtncode = this.dw_template.retrieve()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_found
	ancestorreturnvalue = super::clicked()
	if parent.dw_template.accepttext() < 0 then
		return ::message.returnvalue
	end if
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.dw_control.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.dw_control.getitemnumber(ll_counter, "classcode")
		next
	else
		for ll_counter = 1 to parent.lb_selectedcategories.totalitems()
			ll_found = parent.dw_control.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.dw_control.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.dw_control.getitemnumber(ll_found, "classcode")
			end if
		next
	end if
	parent.istr_arg.l_code10 = parent.dw_template.object.servicetemplatecode[1]
	parent.istr_arg.s_name1 = parent.dw_template.object.remarks[1]
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
