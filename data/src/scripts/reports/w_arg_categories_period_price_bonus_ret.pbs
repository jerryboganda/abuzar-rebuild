// window w_arg_categories_period_price_bonus_ret (reports)  ancestor: w_listarguments

// w_arg_categories_period_price_bonus_ret.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.cbx_returns = create cbx_returns
	this.cbx_bonus = create cbx_bonus
	this.gb_5 = create gb_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.cbx_returns
	this.control[icurrent + 4] = this.cbx_bonus
	this.control[icurrent + 5] = this.gb_5

// w_arg_categories_period_price_bonus_ret.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.cbx_returns
	destroy this.cbx_bonus
	destroy this.gb_5

// w_arg_categories_period_price_bonus_ret.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_price.insertrow(0)
	this.dw_price.scrolltorow(0)
	rtncode = this.dw_control.getchild("category", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	return ::message.returnvalue
