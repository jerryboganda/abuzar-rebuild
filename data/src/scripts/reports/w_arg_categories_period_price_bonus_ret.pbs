// window w_arg_categories_period_price_bonus_ret (reports)  ancestor: w_listarguments

// w_arg_categories_period_price_bonus_ret.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.cbx_returns = create cbx_returns
	this.cbx_bonus = create cbx_bonus
	this.gb_5 = create gb_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.cbx_returns
	this.control[icurrent + 4] = this.cbx_bonus
	this.control[icurrent + 5] = this.gb_5

// w_arg_categories_period_price_bonus_ret.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.cbx_returns
	destroy this.cbx_bonus
	destroy this.gb_5

// w_arg_categories_period_price_bonus_ret.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_price.insertrow(0)
	this.dw_price.scrolltorow(0)
	rtncode = this.dw_control.getchild("category", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	return ::message.returnvalue

// cbx_supress.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	datetime ldt_closingdate
	string ls_icatcode
	ancestorreturnvalue = super::clicked()
	ls_icatcode = ""
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "icatcode")
			ls_icatcode = ls_icatcode + string(parent.istr_arg.ia_integerlist[ll_counter]) + ","
		next
	else
		for ll_counter = 1 to ll_counter
			ll_found = parent.idc_categories.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "icatcode")
				ls_icatcode = ls_icatcode + string(parent.istr_arg.ia_integerlist[ll_counter]) + ","
			end if
		next
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.dw_price.accepttext()
	parent.istr_arg.l_code1 = parent.dw_price.getitemnumber(1, "price")
	ldt_closingdate = datetime(date(parent.istr_arg.d_edate), relativetime(time(parent.istr_arg.d_edate), 1))
	parent.istr_arg.d_date1 = ldt_closingdate
	parent.istr_arg.s_name1 = ls_icatcode
	if parent.cbx_returns.checked = true then
		parent.istr_arg.l_code2 = 1
	else
		parent.istr_arg.l_code2 = 0
	end if
	if parent.cbx_bonus.checked = true then
		parent.istr_arg.l_code3 = 1
	else
		parent.istr_arg.l_code3 = 0
	end if
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
