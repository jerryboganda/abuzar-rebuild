// window w_arg_manufacturers_bosch_linz (reports)  ancestor: w_listarguments

// w_arg_manufacturers_bosch_linz.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.cbx_prod = create cbx_prod
	this.cbx_cust = create cbx_cust
	this.cbx_trans = create cbx_trans
	this.cbx_summ = create cbx_summ
	this.cbx_stock = create cbx_stock
	this.cb_prod = create cb_prod
	this.cb_trans = create cb_trans
	this.cb_cust = create cb_cust
	this.cb_stock = create cb_stock
	this.cb_summ = create cb_summ
	this.hpb_hpb = create hpb_hpb
	this.em_dscode = create em_dscode
	this.st_9 = create st_9
	this.gb_txt = create gb_txt
	this.gb_overallprogress = create gb_overallprogress
	this.gb_5 = create gb_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.cbx_prod
	this.control[icurrent + 4] = this.cbx_cust
	this.control[icurrent + 5] = this.cbx_trans
	this.control[icurrent + 6] = this.cbx_summ
	this.control[icurrent + 7] = this.cbx_stock
	this.control[icurrent + 8] = this.cb_prod
	this.control[icurrent + 9] = this.cb_trans
	this.control[icurrent + 10] = this.cb_cust
	this.control[icurrent + 11] = this.cb_stock
	this.control[icurrent + 12] = this.cb_summ
	this.control[icurrent + 13] = this.hpb_hpb
	this.control[icurrent + 14] = this.em_dscode
	this.control[icurrent + 15] = this.st_9
	this.control[icurrent + 16] = this.gb_txt
	this.control[icurrent + 17] = this.gb_overallprogress
	this.control[icurrent + 18] = this.gb_5

// w_arg_manufacturers_bosch_linz.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.cbx_prod
	destroy this.cbx_cust
	destroy this.cbx_trans
	destroy this.cbx_summ
	destroy this.cbx_stock
	destroy this.cb_prod
	destroy this.cb_trans
	destroy this.cb_cust
	destroy this.cb_stock
	destroy this.cb_summ
	destroy this.hpb_hpb
	destroy this.em_dscode
	destroy this.st_9
	destroy this.gb_txt
	destroy this.gb_overallprogress
	destroy this.gb_5

// w_arg_manufacturers_bosch_linz.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("manufacturers", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	this.em_dscode.text = f_stringpreferences("MerckDistCode")
	this.is_prod = trim(f_stringpreferences("OutputFilePath")) + f_stringpreferences("MerckDistCode") + "_DC_Acknowledge" + ".CSV"
	this.is_cust = trim(f_stringpreferences("OutputFilePath")) + f_stringpreferences("MerckDistCode") + "_DailySales" + ".CSV"
	this.is_trans = trim(f_stringpreferences("OutputFilePath")) + f_stringpreferences("MerckDistCode") + "_DailyStockReturn" + ".CSV"
	this.is_stock = trim(f_stringpreferences("OutputFilePath")) + f_stringpreferences("MerckDistCode") + "_Stock" + ".CSV"
	this.is_summ = trim(f_stringpreferences("OutputFilePath")) + "DSRSumm.CSV"
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_ret
	long ll_innercounter
	long ll_found
	datastore lds_temp
	ancestorreturnvalue = super::clicked()
	lds_temp = create datastore
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "manfcode")
		next
	else
		for ll_counter = 1 to ll_counter
			ll_found = parent.idc_categories.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "manfcode")
			end if
		next
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.em_dscode.getdata(parent.istr_arg.s_name1)
	if parent.istr_arg.s_name1 = "" or isnull(parent.istr_arg.s_name1) then
		messagebox("Distributor Code Validation!", "Please enter valid Distributor Code")
		parent.em_dscode.setfocus()
		return ::message.returnvalue
	end if
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.is_prod = trim(f_stringpreferences("OutputFilePath")) + parent.istr_arg.s_name1 + "_DC_Acknowledge" + ".CSV"
	parent.is_cust = trim(f_stringpreferences("OutputFilePath")) + parent.istr_arg.s_name1 + "_DailySales" + ".CSV"
	parent.is_trans = trim(f_stringpreferences("OutputFilePath")) + parent.istr_arg.s_name1 + "_DailyStockReturn" + ".CSV"
	parent.is_stock = trim(f_stringpreferences("OutputFilePath")) + parent.istr_arg.s_name1 + "_Stock" + ".CSV"
	parent.gb_overallprogress.visible = true
	parent.hpb_hpb.visible = true
	if parent.cbx_prod.checked = true then
		lds_temp.dataobject = "d_purchasedata_bosch_linz"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve(parent.istr_arg.ia_integerlist, parent.istr_arg.s_name1, parent.istr_arg.d_sdate, parent.istr_arg.d_edate)
		parent.hpb_hpb.stepit()
		ll_ret = lds_temp.saveas(parent.is_prod, csv!, true, encodingansi!)
		if ll_ret <> 1 then
			messagebox("Purchase Data Generation Problem", "Error Generating Purchase Data CSV File~r~nPlease Try Later")
			destroy lds_temp
			parent.post event ue_close(0)
		end if
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
	end if
	if parent.cbx_cust.checked = true then
		lds_temp.dataobject = "d_salesdata_bosch_linz"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve(parent.istr_arg.ia_integerlist, parent.istr_arg.s_name1, parent.istr_arg.d_sdate, parent.istr_arg.d_edate)
		parent.hpb_hpb.stepit()
		ll_ret = lds_temp.saveas(parent.is_cust, csv!, true, encodingansi!)
		if ll_ret <> 1 then
			messagebox("Sales Data Generation Problem", "Error Generating Sales Data CSV File~r~nPlease Try Later")
			destroy lds_temp
			parent.post event ue_close(0)
		end if
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
	end if
	if parent.cbx_trans.checked = true then
		lds_temp.dataobject = "d_salesreturndata_bosch_linz"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve(parent.istr_arg.ia_integerlist, parent.istr_arg.s_name1, parent.istr_arg.d_sdate, parent.istr_arg.d_edate)
		parent.hpb_hpb.stepit()
		ll_ret = lds_temp.saveas(parent.is_trans, csv!, true, encodingansi!)
		if ll_ret <> 1 then
			messagebox("S/R Data Generation Problem", "Error Generating S/R Data CSV File~r~nPlease Try Later")
			destroy lds_temp
			return ::message.returnvalue
		end if
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
	end if
	if parent.cbx_stock.checked = true then
		lds_temp.dataobject = "d_stockdata_bosch_linz"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve(parent.istr_arg.ia_integerlist, parent.istr_arg.s_name1)
		parent.hpb_hpb.stepit()
		ll_ret = lds_temp.saveas(parent.is_stock, csv!, true, encodingansi!)
		if ll_ret <> 1 then
			messagebox("Stock Data Generation Problem", "Error Generating Stock Data in Text File~r~nPlease Try Later")
			destroy lds_temp
			return ::message.returnvalue
		end if
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
	end if
	parent.hpb_hpb.stepit()
	parent.hpb_hpb.stepit()
	parent.hpb_hpb.stepit()
	destroy lds_temp
	parent.hpb_hpb.visible = false
	parent.hpb_hpb.position = 5
	parent.gb_overallprogress.visible = false
	parent.post event ue_close(1)
	return ::message.returnvalue

// cb_prod.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_prod, ls_named, "CSV", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

