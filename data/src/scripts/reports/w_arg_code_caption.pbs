// window w_arg_code_caption (reports)  ancestor: w_arguements

// w_arg_code_caption.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_5 = create st_5
	this.st_6 = create st_6
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_5
	this.control[icurrent + 3] = this.st_6

// w_arg_code_caption.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.st_5
	destroy this.st_6

// w_arg_code_caption.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_code_caption.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)
