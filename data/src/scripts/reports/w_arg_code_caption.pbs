// window w_arg_code_caption (reports)  ancestor: w_arguements

// w_arg_code_caption.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_5 = create st_5
	this.st_6 = create st_6
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_5
	this.control[icurrent + 3] = this.st_6

// w_arg_code_caption.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_5
	destroy this.st_6

// w_arg_code_caption.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_code_caption.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "code")
	parent.istr_arg.db_code1 = parent.dw_control.getitemnumber(1, "discperc")
	parent.istr_arg.s_name1 = parent.dw_control.getitemstring(1, "caption1")
	parent.istr_arg.s_name2 = parent.dw_control.getitemstring(1, "caption2")
	parent.istr_arg.s_name3 = parent.dw_control.getitemstring(1, "terms1")
	parent.istr_arg.s_name4 = parent.dw_control.getitemstring(1, "terms2")
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
