// window w_arg_item_smonth_lmonth (reports)  ancestor: w_arguements

// w_arg_item_smonth_lmonth.create() returns 0 [event]
	integer icurrent
	call super::create
	this.dw_smonth = create dw_smonth
	this.dw_lmonth = create dw_lmonth
	this.dw_syear = create dw_syear
	this.dw_lyear = create dw_lyear
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_smonth
	this.control[icurrent + 2] = this.dw_lmonth
	this.control[icurrent + 3] = this.dw_syear
	this.control[icurrent + 4] = this.dw_lyear

// w_arg_item_smonth_lmonth.destroy() returns 0 [event]
	call super::destroy
	destroy this.dw_smonth
	destroy this.dw_lmonth
	destroy this.dw_syear
	destroy this.dw_lyear

// w_arg_item_smonth_lmonth.open() returns long [event]
	long ancestorreturnvalue
	integer rtcode
	string ls_month
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.getchild("icode", this.idc_itemdddw)
	this.idc_itemdddw.settransobject(sqlca)
	rtcode = gd_itemsinfo.sharedata(this.idc_itemdddw)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_smonth.insertrow(0)
	this.dw_smonth.scrolltorow(0)
	this.dw_smonth.setitem(1, "month", month(today()))
	this.dw_lmonth.insertrow(0)
	this.dw_lmonth.scrolltorow(0)
	this.dw_lmonth.setitem(1, "month", month(today()))
	this.dw_syear.insertrow(0)
	this.dw_syear.scrolltorow(0)
	this.dw_syear.setitem(1, "year", year(today()))
	this.dw_lyear.insertrow(0)
	this.dw_lyear.scrolltorow(0)
	this.dw_lyear.setitem(1, "year", year(today()))
	return ::message.returnvalue

// w_arg_item_smonth_lmonth.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	date ldt_date1
	date ldt_date2
	string ls_date
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "icode")
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if parent.dw_smonth.accepttext() = 1 then
		parent.dw_smonth.setfocus()
	end if
	if parent.dw_lmonth.accepttext() = 1 then
		parent.dw_lmonth.setfocus()
	end if
	if parent.dw_syear.accepttext() = 1 then
		parent.dw_syear.setfocus()
	end if
	if parent.dw_lyear.accepttext() = 1 then
		parent.dw_lyear.setfocus()
	end if
	ldt_date1 = date(trim(string(parent.dw_syear.getitemnumber(1, "year"))) + "-" + trim(string(parent.dw_smonth.getitemnumber(1, "month"))) + "-01")
	ldt_date2 = date(trim(string(parent.dw_lyear.getitemnumber(1, "year"))) + "-" + trim(string(parent.dw_lmonth.getitemnumber(1, "month"))) + "-01")
	if ldt_date1 <= ldt_date2 then
		parent.istr_arg.i_status = 1
		parent.istr_arg.d_sdate = datetime(ldt_date1)
		parent.istr_arg.d_edate = datetime(ldt_date2)
	else
		parent.istr_arg.i_status = 0
		parent.dw_smonth.setfocus()
		return ::message.returnvalue
	end if
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_smonth.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return ::message.returnvalue

// dw_lmonth.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return ::message.returnvalue

// dw_syear.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return ::message.returnvalue

// dw_lyear.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return ::message.returnvalue
