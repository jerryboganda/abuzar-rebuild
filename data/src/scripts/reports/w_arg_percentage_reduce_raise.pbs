// window w_arg_percentage_reduce_raise (reports)  ancestor: w_arguements

// w_arg_percentage_reduce_raise.create() returns 0 [event]
	call super::create

// w_arg_percentage_reduce_raise.destroy() returns 0 [event]
	call super::destroy

// w_arg_percentage_reduce_raise.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_columnname = message.stringparm
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	if this.dw_control.object.interventiontype[1] = 1 then
		this.dw_control.object.percentage_t.text = "Reduce " + this.is_columnname + " To:"
	else
		this.dw_control.object.percentage_t.text = "Raise " + this.is_columnname + " By:"
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_arg_percentage_reduce_raise.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// dw_control.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "interventiontype"
		if long(data) = 1 then
			parent.dw_control.object.percentage_t.text = "Reduce " + parent.is_columnname + " By:"
		else
			parent.dw_control.object.percentage_t.text = "Raise " + parent.is_columnname + " By:"
		end if
		return 0
	end choose
	return 0

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.i_status = -1
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "interventiontype")
	parent.istr_arg.db_code1 = parent.dw_control.getitemnumber(1, "percentage")
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
