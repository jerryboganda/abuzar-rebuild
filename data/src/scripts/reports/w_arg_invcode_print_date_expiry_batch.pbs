// window w_arg_invcode_print_date_expiry_batch (reports)  ancestor: w_arguements

// w_arg_invcode_print_date_expiry_batch.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.dw_customer = create dw_customer
	this.st_5 = create st_5
	this.cbx_printdate = create cbx_printdate
	this.dw_header = create dw_header
	this.st_6 = create st_6
	this.cbx_printexpiry = create cbx_printexpiry
	this.cbx_printheader = create cbx_printheader
	this.cbx_printbatch = create cbx_printbatch
	this.cbx_printmfgdate = create cbx_printmfgdate
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.dw_customer
	this.control[icurrent + 3] = this.st_5
	this.control[icurrent + 4] = this.cbx_printdate
	this.control[icurrent + 5] = this.dw_header
	this.control[icurrent + 6] = this.st_6
	this.control[icurrent + 7] = this.cbx_printexpiry
	this.control[icurrent + 8] = this.cbx_printheader
	this.control[icurrent + 9] = this.cbx_printbatch
	this.control[icurrent + 10] = this.cbx_printmfgdate

// w_arg_invcode_print_date_expiry_batch.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.dw_customer
	destroy this.st_5
	destroy this.cbx_printdate
	destroy this.dw_header
	destroy this.st_6
	destroy this.cbx_printexpiry
	destroy this.cbx_printheader
	destroy this.cbx_printbatch
	destroy this.cbx_printmfgdate

// w_arg_invcode_print_date_expiry_batch.open() returns long [event]
	long ancestorreturnvalue
	datawindowchild ldc_headerno
	long ll_counter
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_customer.settransobject(sqlca)
	this.dw_customer.insertrow(0)
	this.dw_customer.scrolltorow(0)
	this.dw_header.settransobject(sqlca)
	this.dw_header.insertrow(0)
	this.dw_header.scrolltorow(0)
	this.dw_header.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to gds_reoprtheaderinfo.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "name", gds_reoprtheaderinfo.getitemstring(ll_counter, "clientname"))
		ldc_headerno.setitem(ll_counter, "code", gds_reoprtheaderinfo.getitemnumber(ll_counter, "headerno"))
	next
	return ::message.returnvalue

// w_arg_invcode_print_date_expiry_batch.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	datastore lds_cust
	ancestorreturnvalue = super::clicked()
	lds_cust = create datastore
	lds_cust.dataobject = "ddd_customer"
	lds_cust.settransobject(sqlca)
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "sinvcode")
	parent.istr_arg.l_code2 = parent.dw_control.getitemnumber(1, "linvcode")
	if parent.cbx_printdate.checked then
		parent.istr_arg.l_code3 = 1
	else
		parent.istr_arg.l_code3 = 0
	end if
	if parent.cbx_printexpiry.checked then
		parent.istr_arg.l_code4 = 1
	else
		parent.istr_arg.l_code4 = 0
	end if
	if parent.rb_purprice.checked then
		parent.istr_arg.s_name1 = "Y"
	else
		parent.istr_arg.s_name1 = "N"
	end if
	if parent.cbx_printheader.checked then
		parent.istr_arg.s_name2 = "Y"
	else
		parent.istr_arg.s_name2 = "N"
	end if
	if parent.cbx_printbatch.checked then
		parent.istr_arg.s_name3 = "Y"
	else
		parent.istr_arg.s_name3 = "N"
	end if
	if parent.cbx_printmfgdate.checked then
		parent.istr_arg.s_name4 = "Y"
	else
		parent.istr_arg.s_name4 = "N"
	end if
	parent.dw_customer.accepttext()
	if isnull(parent.dw_customer.getitemnumber(parent.dw_customer.getrow(), "custcode")) then
		lds_cust.retrieve()
		for ll_counter = 1 to lds_cust.rowcount()
			parent.istr_arg.la_longlist[ll_counter] = lds_cust.getitemnumber(ll_counter, "accounts_acccode")
		next
	else
		parent.istr_arg.la_longlist[ll_counter] = parent.dw_customer.getitemnumber(1, "custcode")
	end if
	if isnull(parent.istr_arg.l_code1) then
		parent.istr_arg.l_code1 = 0
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_customer.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_customer.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_filter
	datawindowchild ldc_dddlookupstart
	datawindowchild ldc_dddlookupend
	integer li_null
	integer li_rtcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(li_null)
	li_rtcode = parent.dw_control.getchild("sinvcode", ldc_dddlookupstart)
	if li_rtcode = -1 then
		messagebox("Error", "Can not get a lookup DataWindowChild")
		close(parent)
	end if
	li_rtcode = parent.dw_control.getchild("linvcode", ldc_dddlookupend)
	if li_rtcode = -1 then
		messagebox("Error", "Can not get a lookup DataWindowChild")
		close(parent)
	end if
	if not isnull(data) then
		ls_filter = "custcode = Long('" + data + "')"
		ldc_dddlookupstart.setfilter(ls_filter)
		ldc_dddlookupstart.filter()
		ldc_dddlookupend.setfilter(ls_filter)
		ldc_dddlookupend.filter()
		parent.dw_control.setitem(1, "sinvcode", li_null)
		parent.dw_control.setitem(1, "linvcode", li_null)
	end if
	return ::message.returnvalue

// dw_header.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
