// window w_arg_godown_sinv_linv_sale_sret (reports)  ancestor: w_listarguments

// w_arg_godown_sinv_linv_sale_sret.wf_set_date_on_off(boolean ab_value) returns 0
	this.gb_2.visible = ab_value
	this.st_1.visible = ab_value
	this.st_2.visible = ab_value
	this.em_startdate.visible = ab_value
	this.em_enddate.visible = ab_value

// w_arg_godown_sinv_linv_sale_sret.wf_set_invrange_on_off(boolean ab_value) returns 0
	this.gb_3.visible = ab_value
	this.st_3.visible = ab_value
	this.st_7.visible = ab_value
	this.dw_startendinvoice.visible = ab_value
	this.gb_6.visible = ab_value
	this.st_10.visible = ab_value
	this.st_11.visible = ab_value
	this.dw_srinvoice.visible = ab_value

// w_arg_godown_sinv_linv_sale_sret.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.dw_godown = create dw_godown
	this.st_9 = create st_9
	this.rb_detailreport = create rb_detailreport
	this.rb_summaryreport = create rb_summaryreport
	this.dw_srinvoice = create dw_srinvoice
	this.st_10 = create st_10
	this.st_11 = create st_11
	this.cbx_cash = create cbx_cash
	this.cbx_credit = create cbx_credit
	this.rb_singleheader = create rb_singleheader
	this.rb_allheader = create rb_allheader
	this.dw_header = create dw_header
	this.gb_5 = create gb_5
	this.gb_6 = create gb_6
	this.gb_7 = create gb_7
	this.gb_8 = create gb_8
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.dw_godown
	this.control[icurrent + 4] = this.st_9
	this.control[icurrent + 5] = this.rb_detailreport
	this.control[icurrent + 6] = this.rb_summaryreport
	this.control[icurrent + 7] = this.dw_srinvoice
	this.control[icurrent + 8] = this.st_10
	this.control[icurrent + 9] = this.st_11
	this.control[icurrent + 10] = this.cbx_cash
	this.control[icurrent + 11] = this.cbx_credit
	this.control[icurrent + 12] = this.rb_singleheader
	this.control[icurrent + 13] = this.rb_allheader
	this.control[icurrent + 14] = this.dw_header
	this.control[icurrent + 15] = this.gb_5
	this.control[icurrent + 16] = this.gb_6
	this.control[icurrent + 17] = this.gb_7
	this.control[icurrent + 18] = this.gb_8

// w_arg_godown_sinv_linv_sale_sret.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.dw_godown
	destroy this.st_9
	destroy this.rb_detailreport
	destroy this.rb_summaryreport
	destroy this.dw_srinvoice
	destroy this.st_10
	destroy this.st_11
	destroy this.cbx_cash
	destroy this.cbx_credit
	destroy this.rb_singleheader
	destroy this.rb_allheader
	destroy this.dw_header
	destroy this.gb_5
	destroy this.gb_6
	destroy this.gb_7
	destroy this.gb_8

// w_arg_godown_sinv_linv_sale_sret.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	datawindowchild ldc_headerno
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_price.insertrow(0)
	this.dw_price.scrolltorow(0)
	this.dw_godown.settransobject(sqlca)
	this.dw_godown.insertrow(0)
	this.dw_header.settransobject(sqlca)
	this.dw_header.insertrow(0)
	this.dw_header.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to gds_reoprtheaderinfo.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "name", gds_reoprtheaderinfo.getitemstring(ll_counter, "clientname"))
		ldc_headerno.setitem(ll_counter, "code", gds_reoprtheaderinfo.getitemnumber(ll_counter, "headerno"))
	next
	rtncode = this.dw_control.getchild("gcode", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	this.dw_startendinvoice.settransobject(sqlca)
	this.dw_startendinvoice.insertrow(0)
	this.dw_srinvoice.settransobject(sqlca)
	this.dw_srinvoice.insertrow(0)
	this.dw_srinvoice.scrolltorow(0)
	wf_set_date_on_off(false)
	wf_set_invrange_on_off(true)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	ancestorreturnvalue = super::clicked()
	if parent.cbx_cash.checked = false and parent.cbx_credit.checked = false then
		messagebox("Type Validation", "Kindly select either Cash or Credit or both types.")
		return ::message.returnvalue
	end if
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.la_longlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "gcode")
		next
	else
		for ll_counter = 1 to parent.lb_selectedcategories.totalitems()
			ll_found = parent.idc_categories.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.la_longlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "gcode")
			end if
		next
	end if
	parent.dw_startendinvoice.accepttext()
	parent.istr_arg.l_code1 = parent.dw_startendinvoice.getitemnumber(1, "sinvcode")
	parent.istr_arg.l_code2 = parent.dw_startendinvoice.getitemnumber(1, "linvcode")
	parent.dw_srinvoice.accepttext()
	parent.istr_arg.l_code3 = parent.dw_srinvoice.getitemnumber(1, "sinvcode")
	parent.istr_arg.l_code4 = parent.dw_srinvoice.getitemnumber(1, "linvcode")
	for ll_counter = 1 to 6
		parent.istr_arg.ia_integerlist[ll_counter] = 0
	next
	if parent.cbx_cash.checked then
		parent.istr_arg.ia_integerlist[1] = 3
		parent.istr_arg.ia_integerlist[4] = 8
	end if
	if parent.cbx_credit.checked then
		parent.istr_arg.ia_integerlist[2] = 1
		parent.istr_arg.ia_integerlist[3] = 2
		parent.istr_arg.ia_integerlist[5] = 6
		parent.istr_arg.ia_integerlist[6] = 7
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if parent.rb_detailreport.checked = true then
		parent.istr_arg.s_name1 = "D"
	else
		parent.istr_arg.s_name1 = "I"
	end if
	parent.dw_header.accepttext()
	if parent.rb_singleheader.checked then
		parent.istr_arg.ia_integerlist2[1] = parent.dw_header.getitemnumber(1, "headerno")
	else
		for ll_counter = 1 to gds_reoprtheaderinfo.rowcount()
			parent.istr_arg.ia_integerlist2[ll_counter] = gds_reoprtheaderinfo.getitemnumber(ll_counter, "headerno")
		next
	end if
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_godown.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// rb_detailreport.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// rb_detailreport.clicked() returns long [event]
	if this.checked = true then
		parent.wf_set_date_on_off(true)
		parent.wf_set_invrange_on_off(false)
	else
		parent.wf_set_date_on_off(false)
		parent.wf_set_invrange_on_off(true)
	end if
	return ::message.returnvalue

// rb_summaryreport.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// rb_summaryreport.clicked() returns long [event]
	if this.checked = true then
		parent.wf_set_date_on_off(false)
		parent.wf_set_invrange_on_off(true)
	else
		parent.wf_set_date_on_off(true)
		parent.wf_set_invrange_on_off(false)
	end if
	return ::message.returnvalue

// cbx_cash.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// cbx_credit.ue_entekey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// rb_singleheader.clicked() returns long [event]
	parent.dw_header.visible = true
	return ::message.returnvalue

// rb_allheader.clicked() returns long [event]
	parent.dw_header.visible = false
	return ::message.returnvalue
