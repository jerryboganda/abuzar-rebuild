// window w_arg_voucherdetails (reports)  ancestor: w_listarguments

// w_arg_voucherdetails.create() returns 0 [event]
	integer icurrent
	call super::create
	this.cbx_cr = create cbx_cr
	this.cbx_cp = create cbx_cp
	this.cbx_bp = create cbx_bp
	this.cbx_jv = create cbx_jv
	this.cbx_br = create cbx_br
	this.cbx_others = create cbx_others
	this.cbx_posted = create cbx_posted
	this.cbx_unposted = create cbx_unposted
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.gb_5 = create gb_5
	this.gb_6 = create gb_6
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_cr
	this.control[icurrent + 2] = this.cbx_cp
	this.control[icurrent + 3] = this.cbx_bp
	this.control[icurrent + 4] = this.cbx_jv
	this.control[icurrent + 5] = this.cbx_br
	this.control[icurrent + 6] = this.cbx_others
	this.control[icurrent + 7] = this.cbx_posted
	this.control[icurrent + 8] = this.cbx_unposted
	this.control[icurrent + 9] = this.st_4
	this.control[icurrent + 10] = this.st_8
	this.control[icurrent + 11] = this.gb_5
	this.control[icurrent + 12] = this.gb_6

// w_arg_voucherdetails.destroy() returns 0 [event]
	call super::destroy
	destroy this.cbx_cr
	destroy this.cbx_cp
	destroy this.cbx_bp
	destroy this.cbx_jv
	destroy this.cbx_br
	destroy this.cbx_others
	destroy this.cbx_posted
	destroy this.cbx_unposted
	destroy this.st_4
	destroy this.st_8
	destroy this.gb_5
	destroy this.gb_6

// w_arg_voucherdetails.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("usercode", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "username"))
	next
	this.dw_startendinvoice.settransobject(sqlca)
	this.dw_startendinvoice.insertrow(0)
	this.dw_startendinvoice.scrolltorow(0)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	integer li_temp
	string ls_temp
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "usercode")
		next
	else
		for ll_counter = 1 to ll_counter
			ll_found = parent.idc_categories.find("username ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "usercode")
			end if
		next
	end if
	parent.dw_startendinvoice.accepttext()
	parent.istr_arg.l_code1 = parent.dw_startendinvoice.getitemnumber(1, "sinvcode")
	parent.istr_arg.l_code2 = parent.dw_startendinvoice.getitemnumber(1, "linvcode")
	if parent.istr_arg.l_code1 > parent.istr_arg.l_code2 then
		li_temp = parent.istr_arg.l_code1
		parent.istr_arg.l_code1 = parent.istr_arg.l_code2
		parent.istr_arg.l_code2 = li_temp
	end if
	if parent.cbx_posted.checked and parent.cbx_unposted.checked then
		parent.istr_arg.s_name1 = "B"
	elseif parent.cbx_posted.checked = false and parent.cbx_unposted.checked then
		parent.istr_arg.s_name1 = "N"
	elseif parent.cbx_posted.checked and parent.cbx_unposted.checked = false then
		parent.istr_arg.s_name1 = "Y"
	else
		parent.istr_arg.s_name1 = "X"
	end if
	ll_counter = 1
	if parent.cbx_cr.checked then
		parent.istr_arg.ia_integerlist1[ll_counter] = 2
		ll_counter = ll_counter + 1
	end if
	if parent.cbx_cp.checked then
		parent.istr_arg.ia_integerlist1[ll_counter] = 1
		ll_counter = ll_counter + 1
	end if
	if parent.cbx_br.checked then
		parent.istr_arg.ia_integerlist1[ll_counter] = 4
		ll_counter = ll_counter + 1
	end if
	if parent.cbx_bp.checked then
		parent.istr_arg.ia_integerlist1[ll_counter] = 3
		ll_counter = ll_counter + 1
	end if
	if parent.cbx_jv.checked then
		parent.istr_arg.ia_integerlist1[ll_counter] = 5
	end if
	if parent.cbx_others.checked then
		ll_counter = 6
		do while ll_counter <= 15
			parent.istr_arg.ia_integerlist1[ll_counter] = ll_counter
			ll_counter = ll_counter + 1
		loop
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// cbx_cr.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

