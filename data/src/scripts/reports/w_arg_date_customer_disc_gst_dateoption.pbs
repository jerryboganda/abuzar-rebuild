	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// rb_originaldate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		parent.em_discperc.setfocus()
	end if
	return ::message.returnvalue

