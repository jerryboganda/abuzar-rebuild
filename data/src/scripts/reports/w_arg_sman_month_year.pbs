// window w_arg_sman_month_year (reports)  ancestor: w_arguements

// w_arg_sman_month_year.create() returns 0 [event]
	integer icurrent
	call super::create
	this.dw_month = create dw_month
	this.st_9 = create st_9
	this.dw_year = create dw_year
	this.st_10 = create st_10
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_month
	this.control[icurrent + 2] = this.st_9
	this.control[icurrent + 3] = this.dw_year
	this.control[icurrent + 4] = this.st_10

// w_arg_sman_month_year.destroy() returns 0 [event]
	call super::destroy
	destroy this.dw_month
	destroy this.st_9
	destroy this.dw_year
	destroy this.st_10

// w_arg_sman_month_year.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_month.settransobject(sqlca)
	this.dw_month.insertrow(0)
	this.dw_month.scrolltorow(0)
	this.dw_month.setitem(1, "month", month(today()))
	this.dw_year.settransobject(sqlca)
	this.dw_year.insertrow(0)
	this.dw_year.scrolltorow(0)
	this.dw_year.setitem(1, "year", year(today()))
	return ::message.returnvalue

// w_arg_sman_month_year.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "salesman")
	if isnull(parent.istr_arg.l_code1) then
		parent.istr_arg.l_code1 = 0
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.l_code2 = parent.dw_month.getitemnumber(1, "month")
	parent.istr_arg.l_code3 = parent.dw_year.getitemnumber(1, "year")
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_month.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_year.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
