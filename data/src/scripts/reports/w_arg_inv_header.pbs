// window w_arg_inv_header (reports)  ancestor: w_arguements

// w_arg_inv_header.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.cbx_cash = create cbx_cash
	this.cbx_credit = create cbx_credit
	this.dw_headerno = create dw_headerno
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.cbx_cash
	this.control[icurrent + 3] = this.cbx_credit
	this.control[icurrent + 4] = this.dw_headerno

// w_arg_inv_header.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.cbx_cash
	destroy this.cbx_credit
	destroy this.dw_headerno

// w_arg_inv_header.open() returns long
	long ancestorreturnvalue
	datawindowchild ldc_headerno
	long ll_counter
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_headerno.settransobject(sqlca)
	this.dw_headerno.insertrow(0)
	this.dw_headerno.scrolltorow(0)
	this.dw_headerno.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to gds_reoprtheaderinfo.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", gds_reoprtheaderinfo.getitemnumber(ll_counter, "headerno"))
		ldc_headerno.setitem(ll_counter, "headeralias", gds_reoprtheaderinfo.getitemstring(ll_counter, "Remarks"))
	next
	return ::message.returnvalue

// w_arg_inv_header.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// dw_headerno.ue_enterkey() returns long
	send(handle(this), 256, 9, long(90))
	return 1
