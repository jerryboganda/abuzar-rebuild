// window w_arg_godown_sdate_ldate_v1 (reports)  ancestor: w_arguements

// w_arg_godown_sdate_ldate_v1.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.em_maxlineitems = create em_maxlineitems
	this.st_5 = create st_5
	this.em_maxitemqty = create em_maxitemqty
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.em_maxlineitems
	this.control[icurrent + 3] = this.st_5
	this.control[icurrent + 4] = this.em_maxitemqty

// w_arg_godown_sdate_ldate_v1.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.em_maxlineitems
	destroy this.st_5
	destroy this.em_maxitemqty

// w_arg_godown_sdate_ldate_v1.open() returns long [event]
	long ancestorreturnvalue
	date ld_currdate
	string ls_text
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	ld_currdate = today()
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	this.em_startdate.text = ls_text
	this.em_enddate.text = ls_text
	return ::message.returnvalue

// w_arg_godown_sdate_ldate_v1.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	double ld_hold
	long ll_hold
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "gcode")
	if isnull(parent.istr_arg.l_code1) or parent.istr_arg.l_code1 = 0 then
		messagebox("Godown Validation", "Kindly select some godown from godown selection list.")
		parent.dw_control.setfocus()
		return ::message.returnvalue
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if parent.istr_arg.d_sdate > parent.istr_arg.d_edate then
		messagebox("Date Validation", "Kindly enter valid date.~r~nStart date should be less than end date.")
		parent.em_startdate.setfocus()
		return ::message.returnvalue
	end if
	parent.em_maxlineitems.getdata(ld_hold)
	ll_hold = long(ld_hold)
	if ll_hold <= 0 then
		messagebox("Max Line Items Validation", "Kindly enter valid value for max. line items.")
		parent.em_maxlineitems.setfocus()
		return ::message.returnvalue
	end if
	parent.istr_arg.l_code2 = ll_hold
	parent.em_maxitemqty.getdata(ld_hold)
	ll_hold = long(ld_hold)
	if ll_hold <= 0 then
		messagebox("Max Item Qty Validation", "Kindly enter valid value for max. item qty.")
		parent.em_maxitemqty.setfocus()
		return ::message.returnvalue
	end if
	parent.istr_arg.l_code3 = ll_hold
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// em_maxlineitems.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_maxitemqty.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
