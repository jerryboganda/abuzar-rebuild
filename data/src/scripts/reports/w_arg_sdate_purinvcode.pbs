// window w_arg_sdate_purinvcode (reports)  ancestor: w_arguements

// w_arg_sdate_purinvcode.create() returns 0 [event]
	integer icurrent
	call super::create
	this.dw_control2 = create dw_control2
	this.st_4 = create st_4
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_control2
	this.control[icurrent + 2] = this.st_4

// w_arg_sdate_purinvcode.destroy() returns 0 [event]
	call super::destroy
	destroy this.dw_control2
	destroy this.st_4

// w_arg_sdate_purinvcode.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// w_arg_sdate_purinvcode.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.em_startdate.text = string(today(), "dd/mm/yyyy hh:mm:ss")
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.insertrow(0)
	this.dw_control2.scrolltorow(0)
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_invcode
	long ll_retcode
	datetime ldt_postdate
	ancestorreturnvalue = super::clicked()
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	if parent.dw_control2.accepttext() = 1 then
		ll_invcode = parent.dw_control2.getitemnumber(1, "purinvcode")
		SQL SELECT purinvcode , postdate INTO :ll_retcode, :ldt_postdate FROM purledger WHERE purinvcode =:ll_invcode AND Posted ='Y' USING sqlca;
		if sqlca.sqlcode = 0 then
			if ldt_postdate > parent.istr_arg.d_sdate then
				messagebox("Date Validation!", "Specified Date must be greater than Invoice Date.~r~nPlease enter valid date.")
				parent.em_startdate.setfocus()
				return ::message.returnvalue
			end if
		else
			messagebox("Invoice Code Validation!", "Please Enter Valid Invoice Code.")
			parent.dw_control2.setfocus()
			parent.dw_control2.scrolltorow(1)
			parent.dw_control2.setcolumn("purinvcode")
			return ::message.returnvalue
		end if
	else
		return ::message.returnvalue
	end if
	parent.istr_arg.l_code1 = ll_invcode
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_control2.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return ::message.returnvalue
