// window w_arg_item_batch_generation_purchase (reports)  ancestor: w_popup_forselection_walias

// w_arg_item_batch_generation_purchase.create() returns 0 [event]
	integer icurrent
	call super::create
	this.gb_2 = create gb_2
	this.st_1 = create st_1
	this.st_2 = create st_2
	this.em_startdate = create em_startdate
	this.em_enddate = create em_enddate
	this.dw_control = create dw_control
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_2
	this.control[icurrent + 2] = this.st_1
	this.control[icurrent + 3] = this.st_2
	this.control[icurrent + 4] = this.em_startdate
	this.control[icurrent + 5] = this.em_enddate
	this.control[icurrent + 6] = this.dw_control

// w_arg_item_batch_generation_purchase.destroy() returns 0 [event]
	call super::destroy
	destroy this.gb_2
	destroy this.st_1
	destroy this.st_2
	destroy this.em_startdate
	destroy this.em_enddate
	destroy this.dw_control

// w_arg_item_batch_generation_purchase.open() returns long [event]
	long ancestorreturnvalue
	date ld_currdate
	string ls_text
	ancestorreturnvalue = super::open()
	gd_itemsinfo.sharedata(this.id_selectionlist)
	ld_currdate = today()
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 00:00:00"
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.em_enddate.text = ls_text
	this.dw_control.settransobject(sqlca)
	this.dw_control.retrieve()
	this.dw_control.setrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_item_batch_generation_purchase.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	double ld_tmp
	string ls_temp
	ancestorreturnvalue = super::clicked()
	parent.dw_control.accepttext()
	parent.istr_arg.l_code1 = parent.id_selected.getitemnumber(1, "code")
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_status = 1
	parent.istr_arg.l_code2 = parent.dw_control.object.startno[1]
	parent.istr_arg.l_code3 = parent.dw_control.object.increment[1]
	parent.istr_arg.l_code4 = parent.dw_control.object.noofbatch[1]
	parent.istr_arg.l_code5 = parent.dw_control.object.batchqty[1]
	if parent.istr_arg.l_code3 > parent.istr_arg.l_code4 then
		messagebox("Range Validation!", "Please enter valid start, and increment number")
		parent.dw_control.setcolumn("startno")
		parent.dw_control.setfocus()
		return ::message.returnvalue
	end if
	parent.istr_arg.s_name1 = parent.dw_control.object.prebatch[1]
	if isnull(parent.istr_arg.s_name1) then
		parent.istr_arg.s_name1 = ""
	end if
	parent.istr_arg.s_name2 = parent.dw_control.object.postbatch[1]
	if isnull(parent.istr_arg.s_name2) then
		parent.istr_arg.s_name2 = ""
	end if
	parent.istr_arg.d_sdate = parent.dw_control.object.expirydate[1]
	return ::message.returnvalue

// em_startdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_enddate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// dw_control.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_control.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return ::message.returnvalue
