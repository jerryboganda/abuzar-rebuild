// rb_flexible.clicked() returns long
	if this.checked = true then
		parent.st_itemlike.visible = true
		parent.sle_alphabaticalfilter.visible = true
	else
		parent.st_itemlike.visible = false
		parent.sle_alphabaticalfilter.visible = false
	end if
	return ::message.returnvalue

// rb_exact.clicked() returns long
	if this.checked = true then
		parent.st_itemlike.visible = false
		parent.sle_alphabaticalfilter.visible = false
	else
		parent.st_itemlike.visible = true
		parent.sle_alphabaticalfilter.visible = true
	end if
	return ::message.returnvalue

