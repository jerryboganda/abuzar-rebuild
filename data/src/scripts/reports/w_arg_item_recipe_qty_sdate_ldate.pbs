// window w_arg_item_recipe_qty_sdate_ldate (reports)  ancestor: w_popup_forselection_walias

// w_arg_item_recipe_qty_sdate_ldate.create() returns 0 [event]
	integer icurrent
	call super::create
	this.gb_2 = create gb_2
	this.st_1 = create st_1
	this.st_2 = create st_2
	this.em_startdate = create em_startdate
	this.em_enddate = create em_enddate
	this.dw_recipe = create dw_recipe
	this.st_3 = create st_3
	this.dw_qty = create dw_qty
	this.st_4 = create st_4
	this.gb_3 = create gb_3
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_2
	this.control[icurrent + 2] = this.st_1
	this.control[icurrent + 3] = this.st_2
	this.control[icurrent + 4] = this.em_startdate
	this.control[icurrent + 5] = this.em_enddate
	this.control[icurrent + 6] = this.dw_recipe
	this.control[icurrent + 7] = this.st_3
	this.control[icurrent + 8] = this.dw_qty
	this.control[icurrent + 9] = this.st_4
	this.control[icurrent + 10] = this.gb_3

// w_arg_item_recipe_qty_sdate_ldate.destroy() returns 0 [event]
	call super::destroy
	destroy this.gb_2
	destroy this.st_1
	destroy this.st_2
	destroy this.em_startdate
	destroy this.em_enddate
	destroy this.dw_recipe
	destroy this.st_3
	destroy this.dw_qty
	destroy this.st_4
	destroy this.gb_3

// w_arg_item_recipe_qty_sdate_ldate.open() returns long [event]
	long ancestorreturnvalue
	date ld_currdate
	string ls_text
	long ll_retcode
	ancestorreturnvalue = super::open()
	this.dw_qty.settransobject(sqlca)
	this.dw_qty.insertrow(0)
	this.dw_qty.scrolltorow(0)
	this.dw_qty.setitem(this.dw_qty.rowcount(), "qty", 1)
	ll_retcode = this.dw_recipe.getchild("recipecode", this.idc_recipe)
	if ll_retcode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		this.istr_arg.i_status = 0
		post event ue_close()
	end if
	this.idc_recipe.settransobject(sqlca)
	ll_retcode = this.idc_recipe.retrieve(-1)
	this.dw_recipe.insertrow(0)
	this.dw_recipe.scrolltorow(0)
	ld_currdate = today()
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 00:00:00"
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.em_enddate.text = ls_text
	return ::message.returnvalue

// w_arg_item_recipe_qty_sdate_ldate.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// dw_selected.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	if not isnull(parent.id_selected.getitemnumber(parent.id_selected.getrow(), "code")) then
		parent.idc_recipe.retrieve(parent.id_selected.getitemnumber(parent.id_selected.getrow(), "code"))
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.istr_arg.i_status = 0
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	if parent.id_selected.accepttext() = -1 then
		parent.id_selected.setfocus()
		return ::message.returnvalue
	elseif isnull(parent.id_selected.getitemstring(parent.id_selected.getrow(), "name")) then
		messagebox("Name Validation", "Please enter valid value for Name.")
		parent.id_selected.setcolumn(1)
		parent.id_selected.setfocus()
		return ::message.returnvalue
	end if
	parent.is_popup_selection.l_code = parent.id_selected.getitemnumber(parent.id_selected.getrow(), "code")
	parent.is_popup_selection.s_name = parent.id_selected.getitemstring(parent.id_selected.getrow(), "name")
	parent.istr_arg.l_code1 = parent.dw_recipe.getitemnumber(1, "recipecode")
	parent.istr_arg.l_code2 = parent.dw_qty.getitemnumber(1, "qty")
	parent.istr_arg.l_code3 = parent.id_selected.getitemnumber(1, "code")
	if parent.istr_arg.l_code1 = 0 or isnull(parent.istr_arg.l_code1) then
		messagebox("Recipe Name Validation!", "Please Select Valid Recipe")
		parent.dw_recipe.setcolumn("recipecode")
		parent.dw_recipe.setfocus()
		return ::message.returnvalue
	end if
	if parent.istr_arg.l_code2 <= 0 or isnull(parent.istr_arg.l_code2) then
		messagebox("Qty Validation!", "Please Select Valid Qty")
		parent.dw_qty.setcolumn("qty")
		parent.dw_qty.setfocus()
		return ::message.returnvalue
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_status = 1
	parent.post event ue_close()
	return ::message.returnvalue

// em_startdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_enddate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// dw_recipe.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// dw_recipe.getfocus() returns long [event]
	if not isnull(parent.id_selected.getitemnumber(parent.id_selected.getrow(), "code")) then
		parent.idc_recipe.retrieve(parent.id_selected.getitemnumber(parent.id_selected.getrow(), "code"))
	end if
	return ::message.returnvalue

// dw_qty.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_qty.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	if not isnull(parent.id_selected.getitemnumber(parent.id_selected.getrow(), "code")) then
		parent.idc_recipe.retrieve(parent.id_selected.getitemnumber(parent.id_selected.getrow(), "code"))
	end if
	return ::message.returnvalue
