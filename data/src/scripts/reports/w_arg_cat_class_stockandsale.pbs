// window w_arg_cat_class_stockandsale (reports)  ancestor: w_listarguments

// w_arg_cat_class_stockandsale.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.lb_classes = create lb_classes
	this.st_selectableclasses = create st_selectableclasses
	this.lb_selectedclasses = create lb_selectedclasses
	this.st_9 = create st_9
	this.cbx_all_classes = create cbx_all_classes
	this.dw_classes = create dw_classes
	this.dw_price2 = create dw_price2
	this.gb_5 = create gb_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.lb_classes
	this.control[icurrent + 4] = this.st_selectableclasses
	this.control[icurrent + 5] = this.lb_selectedclasses
	this.control[icurrent + 6] = this.st_9
	this.control[icurrent + 7] = this.cbx_all_classes
	this.control[icurrent + 8] = this.dw_classes
	this.control[icurrent + 9] = this.dw_price2
	this.control[icurrent + 10] = this.gb_5

// w_arg_cat_class_stockandsale.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.lb_classes
	destroy this.st_selectableclasses
	destroy this.lb_selectedclasses
	destroy this.st_9
	destroy this.cbx_all_classes
	destroy this.dw_classes
	destroy this.dw_price2
	destroy this.gb_5

// w_arg_cat_class_stockandsale.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_price.insertrow(0)
	this.dw_price.scrolltorow(0)
	rtncode = this.dw_control.getchild("category", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	this.dw_classes.settransobject(sqlca)
	this.dw_classes.insertrow(0)
	this.dw_classes.scrolltorow(0)
	rtncode = this.dw_classes.getchild("iccode", this.idc_classes)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_classes.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_classes.additem(this.idc_classes.getitemstring(ll_counter, "name"))
	next
	this.dw_price.settransobject(sqlca)
	this.dw_price.insertrow(0)
	this.dw_price.scrolltorow(0)
	this.dw_price2.settransobject(sqlca)
	this.dw_price2.insertrow(0)
	this.dw_price2.scrolltorow(0)
	return ::message.returnvalue

// cbx_supress.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	datetime ldt_closingdate
	string ls_icatcode
	ancestorreturnvalue = super::clicked()
	ls_icatcode = ""
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "icatcode")
			ls_icatcode = ls_icatcode + string(parent.istr_arg.ia_integerlist[ll_counter]) + ","
		next
	else
		for ll_counter = 1 to parent.lb_selectedcategories.totalitems()
			ll_found = parent.idc_categories.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "icatcode")
				ls_icatcode = ls_icatcode + string(parent.istr_arg.ia_integerlist[ll_counter]) + ","
			end if
		next
	end if
	if parent.cbx_all_classes.checked = true then
		for ll_counter = 1 to parent.idc_classes.rowcount()
			parent.istr_arg.ia_integerlist1[ll_counter] = parent.idc_classes.getitemnumber(ll_counter, "iccode")
		next
	else
		for ll_counter = 1 to parent.lb_selectedclasses.totalitems()
			ll_found = parent.idc_classes.find("name ='" + parent.lb_selectedclasses.text(ll_counter) + "'", 1, parent.idc_classes.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist1[ll_counter] = parent.idc_classes.getitemnumber(ll_found, "iccode")
			end if
		next
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.dw_price.accepttext()
	parent.istr_arg.l_code1 = parent.dw_price.getitemnumber(1, "price")
	parent.dw_price2.accepttext()
	parent.istr_arg.l_code3 = parent.dw_price2.getitemnumber(1, "price")
	ldt_closingdate = datetime(date(parent.istr_arg.d_edate), relativetime(time(parent.istr_arg.d_edate), 1))
	parent.istr_arg.d_date1 = ldt_closingdate
	parent.istr_arg.s_name1 = ls_icatcode
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// lb_classes.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_classes.doubleclicked(integer index) returns long [event]
	string ls_item
	long ll_selectedindex
	ls_item = string(selecteditem())
	ll_selectedindex = selectedindex()
	if not isnull(ls_item) and index >= 1 then
		parent.lb_selectedclasses.additem(ls_item)
		deleteitem(index)
		if ll_selectedindex > 1 then
			if totalitems() < ll_selectedindex then
				selectitem(totalitems())
			else
				selectitem(ll_selectedindex)
			end if
		else
			selectitem(1)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selectable listbox")
	end if
	return ::message.returnvalue

// lb_classes.getfocus() returns long [event]
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue

// lb_selectedclasses.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_selectedclasses.doubleclicked(integer index) returns long [event]
	string ls_item
	long ll_selectedindex
	ll_selectedindex = selectedindex()
	ls_item = string(selecteditem())
	if not isnull(ls_item) and index >= 1 then
		parent.lb_classes.additem(ls_item)
		deleteitem(index)
		if totalitems() < ll_selectedindex then
			selectitem(totalitems())
		else
			selectitem(ll_selectedindex)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selected listbox")
	end if
	return ::message.returnvalue

// lb_selectedclasses.getfocus() returns long [event]
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue

// dw_price2.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
