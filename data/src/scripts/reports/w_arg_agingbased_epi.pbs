// window w_arg_agingbased_epi (reports)  ancestor: w_listarguments

// w_arg_agingbased_epi.create() returns 0 [event]
	integer icurrent
	call super::create
	this.lb_cust = create lb_cust
	this.cbx_allcust = create cbx_allcust
	this.lb_selectedcust = create lb_selectedcust
	this.st_10 = create st_10
	this.st_11 = create st_11
	this.st_4 = create st_4
	this.dw_area = create dw_area
	this.st_8 = create st_8
	this.st_9 = create st_9
	this.em_aginglimit = create em_aginglimit
	this.em_agingdate = create em_agingdate
	this.st_12 = create st_12
	this.em_epi = create em_epi
	this.gb_5 = create gb_5
	this.gb_6 = create gb_6
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.lb_cust
	this.control[icurrent + 2] = this.cbx_allcust
	this.control[icurrent + 3] = this.lb_selectedcust
	this.control[icurrent + 4] = this.st_10
	this.control[icurrent + 5] = this.st_11
	this.control[icurrent + 6] = this.st_4
	this.control[icurrent + 7] = this.dw_area
	this.control[icurrent + 8] = this.st_8
	this.control[icurrent + 9] = this.st_9
	this.control[icurrent + 10] = this.em_aginglimit
	this.control[icurrent + 11] = this.em_agingdate
	this.control[icurrent + 12] = this.st_12
	this.control[icurrent + 13] = this.em_epi
	this.control[icurrent + 14] = this.gb_5
	this.control[icurrent + 15] = this.gb_6

// w_arg_agingbased_epi.destroy() returns 0 [event]
	call super::destroy
	destroy this.lb_cust
	destroy this.cbx_allcust
	destroy this.lb_selectedcust
	destroy this.st_10
	destroy this.st_11
	destroy this.st_4
	destroy this.dw_area
	destroy this.st_8
	destroy this.st_9
	destroy this.em_aginglimit
	destroy this.em_agingdate
	destroy this.st_12
	destroy this.em_epi
	destroy this.gb_5
	destroy this.gb_6

// w_arg_agingbased_epi.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_control.setitem(1, "vochcatcode", 1)
	this.dw_area.settransobject(sqlca)
	this.dw_area.insertrow(0)
	this.dw_area.scrolltorow(0)
	this.dw_area.setitem(1, "areacode", 1)
	this.dw_startendinvoice.settransobject(sqlca)
	this.dw_startendinvoice.insertrow(0)
	this.dw_startendinvoice.scrolltorow(0)
	this.dw_startendinvoice.setitem(1, "scode", 1)
	this.dw_startendinvoice.setitem(1, "lcode", 1)
	rtncode = this.dw_control.getchild("vochcatcode", this.idc_child)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_child.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_cust.additem(this.idc_child.getitemstring(ll_counter, "name"))
	next
	this.em_agingdate.text = this.em_enddate.text
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	double ld_agelimit
	string ls_temp
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	if parent.cbx_allcust.checked = true then
		for ll_counter = 1 to parent.idc_child.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_child.getitemnumber(ll_counter, "vochcatcode")
		next
	else
		parent.istr_arg.ia_integerlist[1] = -1000
		for ll_counter = 1 to parent.lb_selectedcust.totalitems()
			ll_found = parent.idc_child.find("name ='" + parent.lb_selectedcust.text(ll_counter) + "'", 1, parent.idc_child.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_child.getitemnumber(ll_found, "vochcatcode")
			end if
		next
	end if
	if isnull(parent.dw_area.object.areacode[1]) or parent.dw_area.object.areacode[1] = 0 then
		messagebox("Area Validation", "Please Enter Valid Area Name")
		parent.dw_area.setcolumn("areacode")
		parent.dw_area.setfocus()
		return ::message.returnvalue
	end if
	parent.istr_arg.l_code1 = parent.dw_area.getitemnumber(1, "areacode")
	parent.em_agingdate.getdata(parent.istr_arg.d_date1)
	parent.em_aginglimit.getdata(ld_agelimit)
	parent.istr_arg.l_code2 = long(ld_agelimit)
	if parent.istr_arg.l_code2 < 0 then
		messagebox("Aging Limt Validation", "Please Enter Valid Aging Limit (in days)")
		parent.em_aginglimit.setfocus()
		return ::message.returnvalue
	end if
	parent.em_epi.getdata(parent.istr_arg.db_code1)
	if parent.istr_arg.db_code1 < 0.0 or parent.istr_arg.db_code1 > 100.0 then
		messagebox("EPI Validation", "Please Enter Valid EPI (Range : 0-100)")
		parent.em_epi.setfocus()
		return ::message.returnvalue
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if parent.istr_arg.d_sdate > parent.istr_arg.d_edate then
		messagebox("Date Validation Problem", "Please Enter Valid Period")
		parent.em_startdate.setfocus()
		return ::message.returnvalue
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// lb_cust.ue_keypress(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_cust.doubleclicked(integer index) returns long [event]
	string ls_item
	long ll_selectedindex
	ls_item = string(selecteditem())
	ll_selectedindex = selectedindex()
	if not isnull(ls_item) and index >= 1 then
		parent.lb_selectedcust.additem(ls_item)
		deleteitem(index)
		if ll_selectedindex > 1 then
			if totalitems() < ll_selectedindex then
				selectitem(totalitems())
			else
				selectitem(ll_selectedindex)
			end if
		else
			selectitem(1)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selectable listbox")
	end if
	return ::message.returnvalue

// lb_cust.getfocus() returns long [event]
	return ::message.returnvalue

// lb_selectedcust.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_selectedcust.doubleclicked(integer index) returns long [event]
	string ls_item
	long ll_selectedindex
	ll_selectedindex = selectedindex()
	ls_item = string(selecteditem())
	if not isnull(ls_item) and index >= 1 then
		parent.lb_cust.additem(ls_item)
		deleteitem(index)
		if totalitems() < ll_selectedindex then
			selectitem(totalitems())
		else
			selectitem(ll_selectedindex)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selected listbox")
	end if
	return ::message.returnvalue

// lb_selectedcust.getfocus() returns long [event]
	return ::message.returnvalue

// dw_area.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return ::message.returnvalue

// em_aginglimit.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_aginglimit.getfocus() returns long [event]
	selecttext(1, len(this.text))
	return ::message.returnvalue

// em_agingdate.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	string ls_date
	string ls_temp
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	if key = keyf4! then
		ls_temp = this.text
		ls_date = left(ls_temp, 10)
		openwithparm(w_calendar, ls_date)
		ls_date = message.stringparm
		if not (ls_date = "" or isnull(ls_date)) then
			ls_temp = ls_date + " " + right(ls_temp, 8)
			this.text = ls_temp
		end if
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// em_agingdate.getfocus() returns long [event]
	selecttext(1, len(this.text))
	return ::message.returnvalue

// em_epi.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_epi.getfocus() returns long [event]
	selecttext(1, len(this.text))
	return ::message.returnvalue
