// window w_arg_recipient (reports)  ancestor: window

// w_arg_recipient.ue_close(integer ai_status) returns 0
	long ll_row
	long ll_code
	ll_row = this.dw_recipient.getrow()
	ll_code = this.dw_recipient.object.recipientcode[ll_row]
	closewithreturn(this, ll_code)

// w_arg_recipient.create() returns 0
	this.st_1 = create st_1
	this.dw_recipient = create dw_recipient
	this.cb_ok = create cb_ok
	this.control = {this.st_1, this.dw_recipient, this.cb_ok}

// w_arg_recipient.destroy() returns 0
	destroy this.st_1
	destroy this.dw_recipient
	destroy this.cb_ok

// w_arg_recipient.open() returns long
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	this.dw_recipient.settransobject(sqlca)
	this.dw_recipient.insertrow(0)
	return ::message.returnvalue

// cb_ok.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	parent.post event ue_close(1)
	return ::message.returnvalue
