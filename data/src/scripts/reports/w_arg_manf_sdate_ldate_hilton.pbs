// window w_arg_manf_sdate_ldate_hilton (reports)  ancestor: w_arguements

// w_arg_manf_sdate_ldate_hilton.create() returns 0 [event]
	integer icurrent
	call super::create
	this.cbx_cust = create cbx_cust
	this.cbx_stock = create cbx_stock
	this.gb_2 = create gb_2
	this.cbx_trans = create cbx_trans
	this.cb_trans = create cb_trans
	this.cb_cust = create cb_cust
	this.cb_stock = create cb_stock
	this.hpb_hpb = create hpb_hpb
	this.dw_control2 = create dw_control2
	this.cbx_prod = create cbx_prod
	this.cb_prod = create cb_prod
	this.gb_overallprogress = create gb_overallprogress
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_cust
	this.control[icurrent + 2] = this.cbx_stock
	this.control[icurrent + 3] = this.gb_2
	this.control[icurrent + 4] = this.cbx_trans
	this.control[icurrent + 5] = this.cb_trans
	this.control[icurrent + 6] = this.cb_cust
	this.control[icurrent + 7] = this.cb_stock
	this.control[icurrent + 8] = this.hpb_hpb
	this.control[icurrent + 9] = this.dw_control2
	this.control[icurrent + 10] = this.cbx_prod
	this.control[icurrent + 11] = this.cb_prod
	this.control[icurrent + 12] = this.gb_overallprogress

// w_arg_manf_sdate_ldate_hilton.destroy() returns 0 [event]
	call super::destroy
	destroy this.cbx_cust
	destroy this.cbx_stock
	destroy this.gb_2
	destroy this.cbx_trans
	destroy this.cb_trans
	destroy this.cb_cust
	destroy this.cb_stock
	destroy this.hpb_hpb
	destroy this.dw_control2
	destroy this.cbx_prod
	destroy this.cb_prod
	destroy this.gb_overallprogress

// w_arg_manf_sdate_ldate_hilton.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.retrieve()
	this.dw_control2.scrolltorow(0)
	this.is_trans = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "INV.TXT"
	this.is_cust = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "CUST.TXT"
	this.is_stock = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "STOCK.TXT"
	this.is_prod = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "PROD.TXT"
	this.dw_control2.object.distcode[1] = f_stringpreferences("MerckDistCode")
	return ::message.returnvalue

// w_arg_manf_sdate_ldate_hilton.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	string ls_distcode
	datastore lds_temp
	ancestorreturnvalue = super::clicked()
	setpointer(hourglass!)
	parent.gb_overallprogress.visible = true
	parent.hpb_hpb.visible = true
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "manfcode")
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	ls_distcode = parent.dw_control2.object.distcode[1]
	if isnull(ls_distcode) or ls_distcode = "" then
		messagebox("Distributor Code Validation", "Please enter a valid Distributor Code")
		return ::message.returnvalue
	end if
	parent.istr_arg.i_status = 1
	lds_temp = create datastore
	if parent.dw_control2.object.targetsys[1] = "SAS" then
		if parent.cbx_trans.checked = true then
			lds_temp.dataobject = "d_invdata_hilton"
			lds_temp.settransobject(sqlca)
			lds_temp.retrieve(parent.istr_arg.l_code1, ls_distcode, parent.istr_arg.d_sdate, parent.istr_arg.d_edate)
			parent.hpb_hpb.stepit()
			parent.hpb_hpb.stepit()
			parent.hpb_hpb.stepit()
			if f_save_from_ds_to_fff(parent.is_trans, lds_temp, " ", true) = 0 then
				messagebox("Invoice Data Generation Problem", "Error Generating Invoice Data Text File~r~nPlease Try Later")
				destroy lds_temp
				return ::message.returnvalue
			end if
			parent.hpb_hpb.stepit()
			parent.hpb_hpb.stepit()
		end if
		if parent.cbx_cust.checked = true then
			lds_temp.dataobject = "d_custdata_hilton"
			lds_temp.settransobject(sqlca)
			lds_temp.retrieve(ls_distcode)
			parent.hpb_hpb.stepit()
			if f_save_from_ds_to_fff(parent.is_cust, lds_temp, " ", true) = 0 then
				messagebox("Customer Data Generation Problem", "Error Generating Customer Data Text File~r~nPlease Try Later")
				destroy lds_temp
				return ::message.returnvalue
			end if
			parent.hpb_hpb.stepit()
		end if
		if parent.cbx_stock.checked = true then
			lds_temp.dataobject = "d_stockdata_hilton"
			lds_temp.settransobject(sqlca)
			lds_temp.retrieve(parent.istr_arg.l_code1, ls_distcode)
			parent.hpb_hpb.stepit()
			if f_save_from_ds_to_fff(parent.is_stock, lds_temp, " ", true) = 0 then
				messagebox("Stock Data Generation Problem", "Error Generating Stock Data Text File~r~nPlease Try Later")
				destroy lds_temp
				return ::message.returnvalue
			end if
			return
		end if
	else
		if parent.cbx_trans.checked = true then
			lds_temp.dataobject = "d_invdata_dsr_hilton"
			lds_temp.settransobject(sqlca)
			lds_temp.retrieve(parent.istr_arg.l_code1, ls_distcode, parent.istr_arg.d_sdate, parent.istr_arg.d_edate)
			parent.hpb_hpb.stepit()
			parent.hpb_hpb.stepit()
			parent.hpb_hpb.stepit()
			if f_save_from_ds_to_fff(parent.is_trans, lds_temp, "#$#", false) = 0 then
				messagebox("Invoice Data Generation Problem", "Error Generating Invoice Data Text File~r~nPlease Try Later")
				destroy lds_temp
				return ::message.returnvalue
			end if
			parent.hpb_hpb.stepit()
			parent.hpb_hpb.stepit()
		end if
		if parent.cbx_cust.checked = true then
			lds_temp.dataobject = "d_custdata_dsr_hilton"
			lds_temp.settransobject(sqlca)
			lds_temp.retrieve(ls_distcode)
			parent.hpb_hpb.stepit()
			if f_save_from_ds_to_fff(parent.is_cust, lds_temp, "#$#", false) = 0 then
				messagebox("Customer Data Generation Problem", "Error Generating Customer Data Text File~r~nPlease Try Later")
				destroy lds_temp
				return ::message.returnvalue
			end if
			parent.hpb_hpb.stepit()
		end if
		if parent.cbx_stock.checked = true then
			lds_temp.dataobject = "d_stockdata_dsr_hilton"
			lds_temp.settransobject(sqlca)
			lds_temp.retrieve(parent.istr_arg.l_code1, ls_distcode)
			parent.hpb_hpb.stepit()
			if f_save_from_ds_to_fff(parent.is_stock, lds_temp, "#$#", false) = 0 then
				messagebox("Stock Data Generation Problem", "Error Generating Stock Data Text File~r~nPlease Try Later")
				destroy lds_temp
				return ::message.returnvalue
			end if
			return
		end if
		if parent.cbx_prod.checked = true then
			lds_temp.dataobject = "d_proddata_dsr_hilton"
			lds_temp.settransobject(sqlca)
			lds_temp.retrieve(parent.istr_arg.l_code1, ls_distcode)
			parent.hpb_hpb.stepit()
			if f_save_from_ds_to_fff(parent.is_prod, lds_temp, "#$#", false) = 0 then
				messagebox("Product Data Generation Problem", "Error Generating Product Data Text File~r~nPlease Try Later")
				destroy lds_temp
				return ::message.returnvalue
			end if
			return
		end if
	end if
	parent.hpb_hpb.stepit()
	destroy lds_temp
	parent.hpb_hpb.visible = false
	parent.hpb_hpb.position = 10
	parent.gb_overallprogress.visible = false
	setpointer(arrow!)
	parent.post event ue_close(1)
	return ::message.returnvalue

// cb_trans.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_trans, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_cust.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_cust, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_stock.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_stock, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// dw_control2.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_control2.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_distcode
	string ls_sys
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "distcode"
		ls_sys = this.object.targetsys[row]
		if ls_sys = "SAS" then
			parent.is_trans = trim(f_stringpreferences("OutputFilePath")) + data + "INV.TXT"
			parent.is_cust = trim(f_stringpreferences("OutputFilePath")) + data + "CUST.TXT"
			parent.is_stock = trim(f_stringpreferences("OutputFilePath")) + data + "STOCK.TXT"
			parent.is_prod = trim(f_stringpreferences("OutputFilePath")) + data + "PROD.TXT"
		else
			parent.is_trans = trim(f_stringpreferences("OutputFilePath")) + "DSRTRAN.TXT"
			parent.is_cust = trim(f_stringpreferences("OutputFilePath")) + "DSRCUST.TXT"
			parent.is_stock = trim(f_stringpreferences("OutputFilePath")) + "DSRSTOCK.TXT"
			parent.is_prod = trim(f_stringpreferences("OutputFilePath")) + "DSRPROD.TXT"
		end if
	case "targetsys"
		ls_distcode = this.object.distcode[row]
		if data = "SAS" then
			parent.is_trans = trim(f_stringpreferences("OutputFilePath")) + ls_distcode + "INV.TXT"
			parent.is_cust = trim(f_stringpreferences("OutputFilePath")) + ls_distcode + "CUST.TXT"
			parent.is_stock = trim(f_stringpreferences("OutputFilePath")) + ls_distcode + "STOCK.TXT"
			parent.is_prod = trim(f_stringpreferences("OutputFilePath")) + ls_distcode + "PROD.TXT"
			parent.cbx_prod.visible = false
			parent.cb_prod.visible = false
		else
			parent.is_trans = trim(f_stringpreferences("OutputFilePath")) + "DSRTRAN.TXT"
			parent.is_cust = trim(f_stringpreferences("OutputFilePath")) + "DSRCUST.TXT"
			parent.is_stock = trim(f_stringpreferences("OutputFilePath")) + "DSRSTOCK.TXT"
			parent.is_prod = trim(f_stringpreferences("OutputFilePath")) + "DSRPROD.TXT"
			parent.cbx_prod.visible = true
			parent.cb_prod.visible = true
		end if
	end choose
	return 0

// cb_prod.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_prod, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue
