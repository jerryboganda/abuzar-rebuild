// window w_arg_itemcat_period_disc1range_disc2 (reports)  ancestor: w_listarguments

// w_arg_itemcat_period_disc1range_disc2.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.em_discperc = create em_discperc
	this.st_9 = create st_9
	this.em_mindisc1 = create em_mindisc1
	this.em_maxdisc1 = create em_maxdisc1
	this.st_10 = create st_10
	this.st_11 = create st_11
	this.gb_5 = create gb_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.em_discperc
	this.control[icurrent + 4] = this.st_9
	this.control[icurrent + 5] = this.em_mindisc1
	this.control[icurrent + 6] = this.em_maxdisc1
	this.control[icurrent + 7] = this.st_10
	this.control[icurrent + 8] = this.st_11
	this.control[icurrent + 9] = this.gb_5

// w_arg_itemcat_period_disc1range_disc2.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.em_discperc
	destroy this.st_9
	destroy this.em_mindisc1
	destroy this.em_maxdisc1
	destroy this.st_10
	destroy this.st_11
	destroy this.gb_5

// w_arg_itemcat_period_disc1range_disc2.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("category", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	this.dw_price.settransobject(sqlca)
	this.dw_price.insertrow(0)
	this.dw_price.scrolltorow(0)
	return ::message.returnvalue
