// window w_arg_guest_ldate (reports)  ancestor: w_popup_forselection_walias

// w_arg_guest_ldate.create() returns 0 [event]
	integer icurrent
	call super::create
	this.gb_3 = create gb_3
	this.gb_2 = create gb_2
	this.st_1 = create st_1
	this.st_2 = create st_2
	this.em_startdate = create em_startdate
	this.em_enddate = create em_enddate
	this.lb_selected = create lb_selected
	this.cbx_all = create cbx_all
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_3
	this.control[icurrent + 2] = this.gb_2
	this.control[icurrent + 3] = this.st_1
	this.control[icurrent + 4] = this.st_2
	this.control[icurrent + 5] = this.em_startdate
	this.control[icurrent + 6] = this.em_enddate
	this.control[icurrent + 7] = this.lb_selected
	this.control[icurrent + 8] = this.cbx_all

// w_arg_guest_ldate.destroy() returns 0 [event]
	call super::destroy
	destroy this.gb_3
	destroy this.gb_2
	destroy this.st_1
	destroy this.st_2
	destroy this.em_startdate
	destroy this.em_enddate
	destroy this.lb_selected
	destroy this.cbx_all

// w_arg_guest_ldate.open() returns long [event]
	long ancestorreturnvalue
	date ld_currdate
	string ls_text
	ancestorreturnvalue = super::open()
	ld_currdate = today()
	if f_stringpreferences("ApplyArgSDate") = "N" then
		ls_text = string(ld_currdate, "dd/mm/yyyy")
		ls_text = trim(ls_text) + " 00:00:00"
	else
		ls_text = string(f_datepreferences("DefaultArgSDate"), "dd/mm/yyyy hh:mm:ss")
	end if
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.em_enddate.text = ls_text
	this.ids_hold = create datastore
	this.ids_hold.dataobject = "d_popup_guestselection"
	this.ids_hold.settransobject(sqlca)
	this.ids_allcustomers = create datastore
	this.ids_allcustomers.dataobject = "d_popup_guestselection"
	this.ids_allcustomers.settransobject(sqlca)
	this.ids_allcustomers.retrieve()
	return ::message.returnvalue

// w_arg_guest_ldate.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// dw_selected.ue_addnewitem() returns 0 [event]
	string ls_item
	string ls_null
	long ll_code
	long ll_null
	long ll_found
	long ll_currentrow
	setnull(ll_null)
	setnull(ls_null)
	ls_item = getitemstring(getrow(), "name")
	ll_code = getitemnumber(getrow(), "code")
	if not isnull(ls_item) and parent.id_selectionlist.rowcount() > 0 then
		parent.lb_selected.additem(ls_item)
		ll_found = parent.id_selectionlist.find("code=" + string(ll_code), 1, parent.id_selectionlist.rowcount())
		if ll_found > 0 then
			ll_currentrow = parent.ids_hold.insertrow(0)
			parent.ids_hold.setitem(ll_currentrow, "code", parent.id_selectionlist.object.code[ll_found])
			parent.ids_hold.setitem(ll_currentrow, "name", parent.id_selectionlist.object.name[ll_found])
			parent.ids_hold.setitem(ll_currentrow, "aliasname", parent.id_selectionlist.object.aliasname[ll_found])
			parent.ids_hold.accepttext()
			parent.id_selectionlist.deleterow(ll_found)
			parent.id_selectionlist.accepttext()
		end if
		setcolumn("aliasname")
		setfocus()
		setitem(getrow(), "aliasname", ls_null)
		setitem(getrow(), "name", ls_null)
		setitem(getrow(), "code", ll_null)
	end if

// dw_selected.ue_enterkey() returns long [event]
	if getcolumnname() = "name" then
		post event ue_addnewitem()
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_selected.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_rowm
	if parent.id_selectionlist.rowcount() <= 0 then
		messagebox("Customer Validation", "There are no rows for selection.")
		return 1
	end if
	if getcolumnname() = "name" then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrollnextrow()
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrollpriorrow()
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrollnextpage()
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrollpriorpage()
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrolltorow(99999)
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrolltorow(1)
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.id_selectionlist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf4! then
			parent.id_selectionlist.show()
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrolltorow(parent.id_selectionlist.getrow())
			parent.id_selectionlist.selectrow(parent.id_selectionlist.getrow(), true)
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.id_selectionlist.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, "code", parent.id_selectionlist.getitemnumber(ll_listcurrrow, "code"))
			setitem(ll_rowm, "aliasname", parent.id_selectionlist.getitemstring(ll_listcurrrow, "aliasname"))
			setitem(ll_rowm, "name", parent.id_selectionlist.getitemstring(ll_listcurrrow, "name"))
			selecttext(1, len(gettext()))
			setredraw(true)
		end if
	end if
	return rt_code

// cb_cancel.clicked() returns long [event]
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	integer[] li_list
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.ids_allcustomers.rowcount()
			li_list[ll_counter] = parent.ids_allcustomers.getitemnumber(ll_counter, "code")
		next
	elseif parent.lb_selected.totalitems() > 0 then
		for ll_counter = 1 to ll_counter
			ll_found = parent.ids_allcustomers.find("name ='" + parent.lb_selected.text(ll_counter) + "'", 1, parent.ids_allcustomers.rowcount())
			if ll_found > 0 then
				li_list[ll_counter] = parent.ids_allcustomers.getitemnumber(ll_found, "code")
			end if
		next
	else
		messagebox("Customer Validation", "Either select all customers from checkbox or select some customers from the selection list.")
		return ::message.returnvalue
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.ia_integerlist = li_list
	parent.istr_arg.i_status = 1
	parent.post event ue_close()
	return ::message.returnvalue

// em_startdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_enddate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// lb_selected.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_selected.doubleclicked(integer index) returns long [event]
	string ls_name
	long ll_selectedindex
	long ll_found
	long ll_currentrow
	long ll_found1
	ll_selectedindex = selectedindex()
	ls_name = string(selecteditem())
	if not isnull(ls_name) and index >= 1 then
		ll_currentrow = parent.id_selectionlist.insertrow(0)
		ll_found = parent.ids_hold.find("name='" + ls_name + "'", 1, parent.ids_hold.rowcount())
		if ll_found > 0 then
			parent.id_selectionlist.setredraw(false)
			ll_currentrow = parent.id_selectionlist.insertrow(0)
			parent.id_selectionlist.setrow(ll_currentrow)
			parent.id_selectionlist.setitem(ll_currentrow, "code", parent.ids_hold.object.code[ll_found])
			parent.id_selectionlist.setitem(ll_currentrow, "name", parent.ids_hold.object.name[ll_found])
			parent.id_selectionlist.setitem(ll_currentrow, "aliasname", parent.ids_hold.object.aliasname[ll_found])
			parent.id_selectionlist.setsort("name A")
			parent.id_selectionlist.sort()
			parent.ids_hold.deleterow(ll_found)
			parent.ids_hold.accepttext()
			parent.id_selectionlist.deleterow(0)
			parent.id_selectionlist.accepttext()
			parent.id_selectionlist.setredraw(true)
			deleteitem(index)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selected listbox")
	end if
	return ::message.returnvalue

// lb_selected.getfocus() returns long [event]
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue

// cbx_all.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
