// window w_arg_categories_transfer (reports)  ancestor: w_listarguments

// w_arg_categories_transfer.create() returns 0
	integer icurrent
	call super::create
	this.em_projection = create em_projection
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.st_9 = create st_9
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.em_projection
	this.control[icurrent + 2] = this.st_4
	this.control[icurrent + 3] = this.st_8
	this.control[icurrent + 4] = this.st_9

// w_arg_categories_transfer.destroy() returns 0
	call super::destroy
	destroy this.em_projection
	destroy this.st_4
	destroy this.st_8
	destroy this.st_9

// w_arg_categories_transfer.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("category", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	return ::message.returnvalue

// em_projection.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
