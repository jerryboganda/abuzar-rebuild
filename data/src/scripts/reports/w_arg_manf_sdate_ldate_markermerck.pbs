// window w_arg_manf_sdate_ldate_markermerck (reports)  ancestor: w_arguements

// w_arg_manf_sdate_ldate_markermerck.create() returns 0
	integer icurrent
	call super::create
	this.cbx_cust = create cbx_cust
	this.cbx_prod = create cbx_prod
	this.gb_2 = create gb_2
	this.cbx_trans = create cbx_trans
	this.cb_trans = create cb_trans
	this.cb_cust = create cb_cust
	this.cb_prod = create cb_prod
	this.hpb_hpb = create hpb_hpb
	this.gb_overallprogress = create gb_overallprogress
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_cust
	this.control[icurrent + 2] = this.cbx_prod
	this.control[icurrent + 3] = this.gb_2
	this.control[icurrent + 4] = this.cbx_trans
	this.control[icurrent + 5] = this.cb_trans
	this.control[icurrent + 6] = this.cb_cust
	this.control[icurrent + 7] = this.cb_prod
	this.control[icurrent + 8] = this.hpb_hpb
	this.control[icurrent + 9] = this.gb_overallprogress

// w_arg_manf_sdate_ldate_markermerck.destroy() returns 0
	call super::destroy
	destroy this.cbx_cust
	destroy this.cbx_prod
	destroy this.gb_2
	destroy this.cbx_trans
	destroy this.cb_trans
	destroy this.cb_cust
	destroy this.cb_prod
	destroy this.hpb_hpb
	destroy this.gb_overallprogress

// w_arg_manf_sdate_ldate_markermerck.open() returns long
	long ancestorreturnvalue
	string ls_distcode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	ls_distcode = this.dw_control.object.distcode[1]
	if ls_distcode = "" or isnull(ls_distcode) then
		ls_distcode = ""
	end if
	this.is_trans = trim(f_stringpreferences("OutputFilePath")) + trim(ls_distcode) + "INV.TXT"
	this.is_cust = trim(f_stringpreferences("OutputFilePath")) + trim(ls_distcode) + "CUST.TXT"
	this.is_prod = trim(f_stringpreferences("OutputFilePath")) + trim(ls_distcode) + "PROD.TXT"
	return ::message.returnvalue

// w_arg_manf_sdate_ldate_markermerck.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_trans.clicked() returns long
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_trans, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_cust.clicked() returns long
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_cust, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_prod.clicked() returns long
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_prod, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue
