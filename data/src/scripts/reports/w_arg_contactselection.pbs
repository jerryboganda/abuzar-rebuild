// window w_arg_contactselection (reports)  ancestor: window

// w_arg_contactselection.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		post event ue_close()
	end if
	return ::message.returnvalue

// w_arg_contactselection.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// w_arg_contactselection.wf_assigndwobjects(string as_masterdw, string as_detaildw, string as_footerdw) returns 0
	this.dw_master.dataobject = as_masterdw
	this.dw_detail.dataobject = as_detaildw
	this.dw_footer.dataobject = as_footerdw
	this.dw_master.settransobject(sqlca)
	this.dw_detail.settransobject(sqlca)
	this.dw_footer.settransobject(sqlca)

// w_arg_contactselection.create() returns 0 [event]
	this.cb_none = create cb_none
	this.cb_all = create cb_all
	this.dw_footer = create dw_footer
	this.dw_master = create dw_master
	this.cb_retrieve = create cb_retrieve
	this.cb_ok = create cb_ok
	this.dw_detail = create dw_detail
	this.control = {this.cb_none, this.cb_all, this.dw_footer, this.dw_master, this.cb_retrieve, this.cb_ok, this.dw_detail}

// w_arg_contactselection.destroy() returns 0 [event]
	destroy this.cb_none
	destroy this.cb_all
	destroy this.dw_footer
	destroy this.dw_master
	destroy this.cb_retrieve
	destroy this.cb_ok
	destroy this.dw_detail

// w_arg_contactselection.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_custcode
	string ls_date
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	wf_assigndwobjects("d_contactselection_header", "d_contactselection_detail", "")
	this.dw_master.insertrow(0)
	this.dw_master.scrolltorow(0)
	this.dw_detail.retrieve(this.dw_master.object.acccode[1])
	return ::message.returnvalue

// cb_none.clicked() returns long [event]
	string ls_filter
	long ll_totrows
	long ll_counter
	parent.dw_master.accepttext()
	ll_totrows = parent.dw_detail.rowcount()
	for ll_counter = 1 to ll_totrows
		parent.dw_detail.object.selected[ll_counter] = "N"
	next
	return ::message.returnvalue

// cb_all.clicked() returns long [event]
	string ls_filter
	long ll_totrows
	long ll_counter
	parent.dw_master.accepttext()
	ll_totrows = parent.dw_detail.rowcount()
	for ll_counter = 1 to ll_totrows
		parent.dw_detail.object.selected[ll_counter] = "Y"
	next
	return ::message.returnvalue

// dw_master.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// cb_retrieve.clicked() returns long [event]
	string ls_filter
	long ll_masterrow
	parent.dw_master.accepttext()
	ll_masterrow = parent.dw_master.getrow()
	parent.dw_detail.retrieve(parent.dw_master.getitemnumber(ll_masterrow, "acccode"))
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long[] ll_invcode
	long ll_rowcount
	long ll_counter
	long ll_arrindex
	long ll_thiscode
	boolean lb_remarks
	string ls_date
	parent.istr_arg.l_code1 = parent.dw_master.getitemnumber(parent.dw_master.getrow(), "acccode")
	ll_rowcount = parent.dw_detail.rowcount()
	for ll_counter = 1 to ll_rowcount
		if parent.dw_detail.getitemstring(ll_counter, "selected") = "Y" then
			ll_arrindex = ll_arrindex + 1
			ll_thiscode = parent.dw_detail.getitemnumber(ll_counter, "code")
			parent.istr_arg.ia_integerlist[ll_arrindex] = ll_thiscode
		end if
	next
	parent.istr_arg.i_status = 1
	parent.post event ue_close()
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
