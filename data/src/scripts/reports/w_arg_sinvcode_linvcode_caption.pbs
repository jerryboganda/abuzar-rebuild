// window w_arg_sinvcode_linvcode_caption (reports)  ancestor: w_arguements

// w_arg_sinvcode_linvcode_caption.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.sle_caption1 = create sle_caption1
	this.sle_caption2 = create sle_caption2
	this.st_caption2 = create st_caption2
	this.st_format = create st_format
	this.ddlb_format = create ddlb_format
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.sle_caption1
	this.control[icurrent + 3] = this.sle_caption2
	this.control[icurrent + 4] = this.st_caption2
	this.control[icurrent + 5] = this.st_format
	this.control[icurrent + 6] = this.ddlb_format

// w_arg_sinvcode_linvcode_caption.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.sle_caption1
	destroy this.sle_caption2
	destroy this.st_caption2
	destroy this.st_format
	destroy this.ddlb_format

// w_arg_sinvcode_linvcode_caption.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_sinvcode_linvcode_caption.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// sle_caption1.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// sle_caption2.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// ddlb_format.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
