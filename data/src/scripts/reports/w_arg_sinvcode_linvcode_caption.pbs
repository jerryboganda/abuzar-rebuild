// window w_arg_sinvcode_linvcode_caption (reports)  ancestor: w_arguements

// w_arg_sinvcode_linvcode_caption.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.sle_caption1 = create sle_caption1
	this.sle_caption2 = create sle_caption2
	this.st_caption2 = create st_caption2
	this.st_format = create st_format
	this.ddlb_format = create ddlb_format
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.sle_caption1
	this.control[icurrent + 3] = this.sle_caption2
	this.control[icurrent + 4] = this.st_caption2
	this.control[icurrent + 5] = this.st_format
	this.control[icurrent + 6] = this.ddlb_format

// w_arg_sinvcode_linvcode_caption.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.sle_caption1
	destroy this.sle_caption2
	destroy this.st_caption2
	destroy this.st_format
	destroy this.ddlb_format

// w_arg_sinvcode_linvcode_caption.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_sinvcode_linvcode_caption.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "sinvcode")
	parent.istr_arg.l_code2 = parent.dw_control.getitemnumber(1, "linvcode")
	parent.istr_arg.s_name1 = parent.sle_caption1.text
	parent.istr_arg.s_name2 = parent.sle_caption2.text
	if parent.cbx_hide.checked then
		parent.istr_arg.l_code3 = 1
	else
		parent.istr_arg.l_code3 = 0
	end if
	if lower(parent.ddlb_format.text) = "format-2" then
		parent.istr_arg.l_code4 = 2
	elseif lower(parent.ddlb_format.text) = "format-3" then
		parent.istr_arg.l_code4 = 3
	elseif lower(parent.ddlb_format.text) = "format-4" then
		parent.istr_arg.l_code4 = 4
	elseif lower(parent.ddlb_format.text) = "format-5" then
		parent.istr_arg.l_code4 = 5
	elseif lower(parent.ddlb_format.text) = "format-6" then
		parent.istr_arg.l_code4 = 6
	elseif lower(parent.ddlb_format.text) = "format-7" then
		parent.istr_arg.l_code4 = 7
	elseif lower(parent.ddlb_format.text) = "format-8" then
		parent.istr_arg.l_code4 = 8
	else
		parent.istr_arg.l_code4 = 1
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// sle_caption1.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// sle_caption2.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// ddlb_format.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
