// window w_arg_machine_sdate_ldate (reports)  ancestor: w_arguements

// w_arg_machine_sdate_ldate.create() returns 0 [event]
	call super::create

// w_arg_machine_sdate_ldate.destroy() returns 0 [event]
	call super::destroy

// w_arg_machine_sdate_ldate.open() returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	long ll_rowcount
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	ll_retcode = this.dw_control.getchild("machinename", this.idc_machine)
	if ll_retcode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	this.idc_machine.settransobject(sqlca)
	this.idc_machine.insertrow(0)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_machine_sdate_ldate.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// dw_control.getfocus() returns long [event]
	long ancestorreturnvalue
	datetime sdate
	datetime ldate
	ancestorreturnvalue = super::getfocus()
	parent.em_startdate.getdata(sdate)
	parent.em_enddate.getdata(ldate)
	parent.idc_machine.retrieve(sdate, ldate)
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.s_name1 = parent.dw_control.object.machinename[1]
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
