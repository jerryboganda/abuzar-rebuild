// window w_arg_manf_sdate_ldate_dist (reports)  ancestor: w_arguements

// w_arg_manf_sdate_ldate_dist.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.sle_distcode = create sle_distcode
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.sle_distcode

// w_arg_manf_sdate_ldate_dist.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.sle_distcode

// w_arg_manf_sdate_ldate_dist.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_manf_sdate_ldate_dist.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	string l_str
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "manfcode")
	l_str = parent.sle_distcode.text
	if isnull(l_str) or l_str = "" then
		messagebox("Distribution Code Validation!", "Please enter valid Distribution Code")
		parent.sle_distcode.setfocus()
		return ::message.returnvalue
	end if
	parent.istr_arg.s_name1 = l_str
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
