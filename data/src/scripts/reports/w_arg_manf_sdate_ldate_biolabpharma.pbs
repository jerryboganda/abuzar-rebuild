// window w_arg_manf_sdate_ldate_biolabpharma (reports)  ancestor: w_arguements

// w_arg_manf_sdate_ldate_biolabpharma.create() returns 0 [event]
	integer icurrent
	call super::create
	this.cbx_cust = create cbx_cust
	this.cbx_stock = create cbx_stock
	this.cbx_trans = create cbx_trans
	this.cb_trans = create cb_trans
	this.cb_cust = create cb_cust
	this.hpb_hpb = create hpb_hpb
	this.dw_control2 = create dw_control2
	this.cbx_prod = create cbx_prod
	this.cb_prod = create cb_prod
	this.cbx_brick = create cbx_brick
	this.cb_brick = create cb_brick
	this.gb_overallprogress = create gb_overallprogress
	this.cb_stock = create cb_stock
	this.cbx_summ = create cbx_summ
	this.cb_summ = create cb_summ
	this.gb_2 = create gb_2
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_cust
	this.control[icurrent + 2] = this.cbx_stock
	this.control[icurrent + 3] = this.cbx_trans
	this.control[icurrent + 4] = this.cb_trans
	this.control[icurrent + 5] = this.cb_cust
	this.control[icurrent + 6] = this.hpb_hpb
	this.control[icurrent + 7] = this.dw_control2
	this.control[icurrent + 8] = this.cbx_prod
	this.control[icurrent + 9] = this.cb_prod
	this.control[icurrent + 10] = this.cbx_brick
	this.control[icurrent + 11] = this.cb_brick
	this.control[icurrent + 12] = this.gb_overallprogress
	this.control[icurrent + 13] = this.cb_stock
	this.control[icurrent + 14] = this.cbx_summ
	this.control[icurrent + 15] = this.cb_summ
	this.control[icurrent + 16] = this.gb_2

// w_arg_manf_sdate_ldate_biolabpharma.destroy() returns 0 [event]
	call super::destroy
	destroy this.cbx_cust
	destroy this.cbx_stock
	destroy this.cbx_trans
	destroy this.cb_trans
	destroy this.cb_cust
	destroy this.hpb_hpb
	destroy this.dw_control2
	destroy this.cbx_prod
	destroy this.cb_prod
	destroy this.cbx_brick
	destroy this.cb_brick
	destroy this.gb_overallprogress
	destroy this.cb_stock
	destroy this.cbx_summ
	destroy this.cb_summ
	destroy this.gb_2

// w_arg_manf_sdate_ldate_biolabpharma.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.retrieve()
	this.dw_control2.scrolltorow(0)
	this.is_brick = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "DSRBrick.txt"
	this.is_trans = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "DSRTrans.txt"
	this.is_cust = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "DSRCust.txt"
	this.is_prod = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "DSRProd.txt"
	this.is_stock = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "DSRStock.txt"
	this.is_summ = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "DSRValue.txt"
	this.dw_control2.object.distcode[1] = f_stringpreferences("MerckDistCode")
	return ::message.returnvalue

// w_arg_manf_sdate_ldate_biolabpharma.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_ret
	string ls_distcode
	datastore lds_temp
	ancestorreturnvalue = super::clicked()
	setpointer(hourglass!)
	parent.gb_overallprogress.visible = true
	parent.hpb_hpb.visible = true
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "manfcode")
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	ls_distcode = parent.dw_control2.object.distcode[1]
	if isnull(ls_distcode) or ls_distcode = "" then
		messagebox("Distributor Code Validation", "Please enter a valid Distributor Code")
		return ::message.returnvalue
	end if
	parent.istr_arg.i_status = 1
	lds_temp = create datastore
	if parent.cbx_cust.checked = true then
		lds_temp.dataobject = "d_custdata_biolabpharma"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve(ls_distcode)
		parent.hpb_hpb.stepit()
		if f_save_from_ds_to_textfile(parent.is_cust, lds_temp, "#$#", false) = 0 then
			messagebox("Customer Data Generation Problem", "Error Generating Customer Data Text File~r~nPlease Try Later")
			destroy lds_temp
			return ::message.returnvalue
		end if
		parent.hpb_hpb.stepit()
	end if
	if parent.cbx_prod.checked = true then
		lds_temp.dataobject = "d_proddata_biolabpharma"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve(parent.istr_arg.l_code1, ls_distcode)
		parent.hpb_hpb.stepit()
		if f_save_from_ds_to_textfile(parent.is_prod, lds_temp, "#$#", false) = 0 then
			messagebox("Product Data Generation Problem", "Error Generating Product Data Text File~r~nPlease Try Later")
			destroy lds_temp
			return ::message.returnvalue
		end if
		parent.hpb_hpb.stepit()
	end if
	if parent.cbx_trans.checked = true then
		lds_temp.dataobject = "d_invdata_biolabpharma"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve(parent.istr_arg.l_code1, ls_distcode, parent.istr_arg.d_sdate, parent.istr_arg.d_edate)
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
		if f_save_from_ds_to_textfile(parent.is_trans, lds_temp, "#$#", false) = 0 then
			messagebox("Transactions Data Generation Problem", "Error Generating Transactions Data Text File~r~nPlease Try Later")
			destroy lds_temp
			return ::message.returnvalue
		end if
		parent.hpb_hpb.stepit()
	end if
	parent.hpb_hpb.stepit()
	destroy lds_temp
	parent.hpb_hpb.visible = false
	parent.hpb_hpb.position = 10
	parent.gb_overallprogress.visible = false
	setpointer(arrow!)
	parent.post event ue_close(1)
	return ::message.returnvalue

// cb_trans.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_trans, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_cust.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_cust, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// dw_control2.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_control2.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "distcode"
		parent.is_brick = trim(f_stringpreferences("OutputFilePath")) + data + "DSRBrick.txt"
		parent.is_trans = trim(f_stringpreferences("OutputFilePath")) + data + "DSRTrans.txt"
		parent.is_cust = trim(f_stringpreferences("OutputFilePath")) + data + "DSRCust.txt"
		parent.is_prod = trim(f_stringpreferences("OutputFilePath")) + data + "DSRProd.txt"
	end choose
	return 0

// cb_prod.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_prod, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

