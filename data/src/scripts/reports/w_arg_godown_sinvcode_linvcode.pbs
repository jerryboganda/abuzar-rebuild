// window w_arg_godown_sinvcode_linvcode (reports)  ancestor: w_listarguments

// w_arg_godown_sinvcode_linvcode.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.dw_godown = create dw_godown
	this.st_9 = create st_9
	this.rb_detailreport = create rb_detailreport
	this.rb_summaryreport = create rb_summaryreport
	this.gb_5 = create gb_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.dw_godown
	this.control[icurrent + 4] = this.st_9
	this.control[icurrent + 5] = this.rb_detailreport
	this.control[icurrent + 6] = this.rb_summaryreport
	this.control[icurrent + 7] = this.gb_5

// w_arg_godown_sinvcode_linvcode.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.dw_godown
	destroy this.st_9
	destroy this.rb_detailreport
	destroy this.rb_summaryreport
	destroy this.gb_5

// w_arg_godown_sinvcode_linvcode.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_price.insertrow(0)
	this.dw_price.scrolltorow(0)
	this.dw_godown.settransobject(sqlca)
	this.dw_godown.insertrow(0)
	rtncode = this.dw_control.getchild("gcode", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	this.dw_startendinvoice.settransobject(sqlca)
	this.dw_startendinvoice.insertrow(0)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.la_longlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "gcode")
		next
	else
		for ll_counter = 1 to ll_counter
			ll_found = parent.idc_categories.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.la_longlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "gcode")
			end if
		next
	end if
	parent.dw_startendinvoice.accepttext()
	parent.istr_arg.l_code1 = parent.dw_startendinvoice.getitemnumber(1, "sinvcode")
	parent.istr_arg.l_code2 = parent.dw_startendinvoice.getitemnumber(1, "linvcode")
	parent.dw_price.accepttext()
	parent.istr_arg.l_code3 = parent.dw_price.getitemnumber(1, "price")
	parent.dw_godown.accepttext()
	parent.istr_arg.l_code4 = parent.dw_godown.getitemnumber(1, "gcode")
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_godown.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// rb_detailreport.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// rb_summaryreport.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1
