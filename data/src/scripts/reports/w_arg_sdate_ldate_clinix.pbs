// window w_arg_sdate_ldate_clinix (reports)  ancestor: w_arguements

// w_arg_sdate_ldate_clinix.create() returns 0 [event]
	integer icurrent
	call super::create
	this.cbx_trans = create cbx_trans
	this.cb_trans = create cb_trans
	this.hpb_hpb = create hpb_hpb
	this.gb_overallprogress = create gb_overallprogress
	this.gb_2 = create gb_2
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_trans
	this.control[icurrent + 2] = this.cb_trans
	this.control[icurrent + 3] = this.hpb_hpb
	this.control[icurrent + 4] = this.gb_overallprogress
	this.control[icurrent + 5] = this.gb_2

// w_arg_sdate_ldate_clinix.destroy() returns 0 [event]
	call super::destroy
	destroy this.cbx_trans
	destroy this.cb_trans
	destroy this.hpb_hpb
	destroy this.gb_overallprogress
	destroy this.gb_2

// w_arg_sdate_ldate_clinix.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.is_trans = trim(f_stringpreferences("OutputFilePath")) + gs_regid + ".xls"
	return ::message.returnvalue

// w_arg_sdate_ldate_clinix.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_ret
	string ls_distcode
	datastore lds_temp
	ancestorreturnvalue = super::clicked()
	setpointer(hourglass!)
	parent.gb_overallprogress.visible = true
	parent.hpb_hpb.visible = true
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_status = 1
	lds_temp = create datastore
	if parent.cbx_trans.checked = true then
		lds_temp.dataobject = "d_clinix_dataexportutility"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve(parent.istr_arg.d_sdate, parent.istr_arg.d_edate)
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
		ll_ret = uf_save_ds_as_excel(lds_temp, parent.is_trans)
		if ll_ret = 1 then
			messagebox("Save as Excel File", "Successfully Saved Excel File")
		else
			messagebox("Save as Excel File", "Problem in Saving Excel File")
		end if
		parent.hpb_hpb.stepit()
	end if
	parent.hpb_hpb.stepit()
	destroy lds_temp
	parent.hpb_hpb.visible = false
	parent.hpb_hpb.position = 10
	parent.gb_overallprogress.visible = false
	setpointer(arrow!)
	parent.post event ue_close(1)
	return ::message.returnvalue

// cb_trans.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_trans, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue
