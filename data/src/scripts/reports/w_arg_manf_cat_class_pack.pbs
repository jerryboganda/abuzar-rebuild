// window w_arg_manf_cat_class_pack (reports)  ancestor: w_arguements

// w_arg_manf_cat_class_pack.create() returns 0 [event]
	call super::create

// w_arg_manf_cat_class_pack.destroy() returns 0 [event]
	call super::destroy

// w_arg_manf_cat_class_pack.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.is_stringparam = message.stringparm
	if this.is_stringparam = "M" then
		this.is_dataobject = "d_arg_manf"
		this.is_colname = "manfcode"
		this.is_childcolname = "manfcode"
		this.st_3.text = "Manufacturer(s)"
	elseif this.is_stringparam = "C" then
		this.is_dataobject = "d_arg_cat"
		this.is_colname = "icatcode"
		this.is_childcolname = "icatcode"
		this.st_3.text = "Item Categories"
	elseif this.is_stringparam = "L" then
		this.is_dataobject = "d_arg_class"
		this.is_colname = "iccode"
		this.is_childcolname = "iccode"
		this.st_3.text = "Item Class(s)"
	elseif this.is_stringparam = "P" then
		this.is_dataobject = "d_arg_packing"
		this.is_colname = "packcode"
		this.is_childcolname = "packcode"
		this.st_3.text = "Item Packing(s)"
	end if
	this.dw_control.dataobject = this.is_dataobject
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild(this.is_colname, this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_arg_manf_cat_class_pack.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	if parent.is_stringparam = "M" then
		parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "manfcode")
	elseif parent.is_stringparam = "C" then
		parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "icatcode")
	elseif parent.is_stringparam = "L" then
		parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "iccode")
	elseif parent.is_stringparam = "P" then
		parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "packcode")
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.s_name1 = parent.is_stringparam
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
