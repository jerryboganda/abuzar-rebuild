// w_arg_po_generate_sdate_ldate.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.dw_weekday = create dw_weekday
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.dw_weekday

// w_arg_po_generate_sdate_ldate.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.dw_weekday

// w_arg_po_generate_sdate_ldate.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// w_arg_po_generate_sdate_ldate.open() returns long [event]
	long ancestorreturnvalue
	datetime ldt_date
	ancestorreturnvalue = super::open()
	this.dw_weekday.settransobject(sqlca)
	this.dw_weekday.insertrow(0)
	this.em_enddate.getdata(ldt_date)
	this.dw_weekday.retrieve(ldt_date)
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	string ls_text
	date ld_currdate
	ancestorreturnvalue = super::clicked()
	ld_currdate = today()
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " " + trim(string(now()))
	parent.em_startdate.text = ls_text
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

