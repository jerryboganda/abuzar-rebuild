// window w_arg_sale_allowedcat_date_ldate (reports)  ancestor: w_listarguments

// w_arg_sale_allowedcat_date_ldate.create() returns 0 [event]
	integer icurrent
	call super::create
	this.cbx_cash = create cbx_cash
	this.cbx_credit = create cbx_credit
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.gb_5 = create gb_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_cash
	this.control[icurrent + 2] = this.cbx_credit
	this.control[icurrent + 3] = this.st_4
	this.control[icurrent + 4] = this.st_8
	this.control[icurrent + 5] = this.gb_5

// w_arg_sale_allowedcat_date_ldate.destroy() returns 0 [event]
	call super::destroy
	destroy this.cbx_cash
	destroy this.cbx_credit
	destroy this.st_4
	destroy this.st_8
	destroy this.gb_5

// w_arg_sale_allowedcat_date_ldate.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	long ll_groupcode
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	ll_groupcode = f_getgroupcode(gl_usercode)
	rtncode = this.dw_control.getchild("icatcode", this.idc_categories)
	this.idc_categories.settransobject(sqlca)
	this.idc_categories.retrieve(ll_groupcode)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	string ls_name
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "icatcode")
		next
	else
		for ll_counter = 1 to parent.lb_selectedcategories.totalitems()
			ll_found = parent.idc_categories.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "icatcode")
			end if
		next
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	if parent.cbx_cash.checked then
		parent.istr_arg.ia_integerlist1[3] = 3
	end if
	if parent.cbx_credit.checked then
		parent.istr_arg.ia_integerlist1[2] = 2
		parent.istr_arg.ia_integerlist1[1] = 1
	end if
	parent.post event ue_close(1)
	return ::message.returnvalue

// cbx_cash.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// cbx_credit.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
