// window w_arg_cat_single_sdate_ldate (reports)  ancestor: w_arguements

// w_arg_cat_single_sdate_ldate.create() returns 0
	integer icurrent
	call super::create
	this.cbx_cash = create cbx_cash
	this.cbx_credit = create cbx_credit
	this.rb_groupmanf = create rb_groupmanf
	this.rb_groupclass = create rb_groupclass
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_cash
	this.control[icurrent + 2] = this.cbx_credit
	this.control[icurrent + 3] = this.rb_groupmanf
	this.control[icurrent + 4] = this.rb_groupclass

// w_arg_cat_single_sdate_ldate.destroy() returns 0
	call super::destroy
	destroy this.cbx_cash
	destroy this.cbx_credit
	destroy this.rb_groupmanf
	destroy this.rb_groupclass

// w_arg_cat_single_sdate_ldate.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_cat_single_sdate_ldate.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)
