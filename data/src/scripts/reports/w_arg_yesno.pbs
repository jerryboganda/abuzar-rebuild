// window w_arg_yesno (reports)  ancestor: window

// w_arg_yesno.create() returns 0
	this.dw_control = create dw_control
	this.st_val = create st_val
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.control = {this.dw_control, this.st_val, this.cb_cancel, this.cb_ok}

// w_arg_yesno.destroy() returns 0
	destroy this.dw_control
	destroy this.st_val
	destroy this.cb_cancel
	destroy this.cb_ok

// w_arg_yesno.open() returns long
	this.st_val.text = message.stringparm
	this.dw_control.settransobject(sqlca)
	this.dw_control.retrieve()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_control.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// cb_cancel.clicked() returns long
	closewithreturn(parent, -1)
	return ::message.returnvalue

// cb_ok.clicked() returns long
	double ld_val
	char ls_value
	parent.dw_control.accepttext()
	if isnull(parent.dw_control.object.datavalue[1]) or parent.dw_control.object.datavalue[1] = "" then
		messagebox("Validation", message.stringparm + " Should be a valid  value")
		parent.dw_control.setfocus()
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ls_value = parent.dw_control.object.datavalue[1]
	if isnull(ls_value) or ls_value = "" then
		ls_value = "N"
	end if
	closewithreturn(parent, ls_value)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue
