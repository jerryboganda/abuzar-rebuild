// window w_arg_sinvcode_linvcode_cust_v2 (reports)  ancestor: w_arguements

// w_arg_sinvcode_linvcode_cust_v2.create() returns 0
	integer icurrent
	call super::create
	this.gb_3 = create gb_3
	this.gb_2 = create gb_2
	this.st_4 = create st_4
	this.dw_customer = create dw_customer
	this.st_5 = create st_5
	this.cbx_printheader = create cbx_printheader
	this.st_6 = create st_6
	this.dw_pagesize = create dw_pagesize
	this.rb_originaldate = create rb_originaldate
	this.rb_lastsavingdate = create rb_lastsavingdate
	this.rb_billingdate = create rb_billingdate
	this.rb_invwise = create rb_invwise
	this.rb_datewise = create rb_datewise
	this.st_startdate = create st_startdate
	this.st_enddate = create st_enddate
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_3
	this.control[icurrent + 2] = this.gb_2
	this.control[icurrent + 3] = this.st_4
	this.control[icurrent + 4] = this.dw_customer
	this.control[icurrent + 5] = this.st_5
	this.control[icurrent + 6] = this.cbx_printheader
	this.control[icurrent + 7] = this.st_6
	this.control[icurrent + 8] = this.dw_pagesize
	this.control[icurrent + 9] = this.rb_originaldate
	this.control[icurrent + 10] = this.rb_lastsavingdate
	this.control[icurrent + 11] = this.rb_billingdate
	this.control[icurrent + 12] = this.rb_invwise
	this.control[icurrent + 13] = this.rb_datewise
	this.control[icurrent + 14] = this.st_startdate
	this.control[icurrent + 15] = this.st_enddate

// w_arg_sinvcode_linvcode_cust_v2.destroy() returns 0
	call super::destroy
	destroy this.gb_3
	destroy this.gb_2
	destroy this.st_4
	destroy this.dw_customer
	destroy this.st_5
	destroy this.cbx_printheader
	destroy this.st_6
	destroy this.dw_pagesize
	destroy this.rb_originaldate
	destroy this.rb_lastsavingdate
	destroy this.rb_billingdate
	destroy this.rb_invwise
	destroy this.rb_datewise
	destroy this.st_startdate
	destroy this.st_enddate

// w_arg_sinvcode_linvcode_cust_v2.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_customer.settransobject(sqlca)
	this.dw_customer.insertrow(0)
	this.dw_customer.scrolltorow(0)
	this.dw_pagesize.settransobject(sqlca)
	this.dw_pagesize.insertrow(0)
	this.dw_pagesize.scrolltorow(0)
	this.st_2.visible = true
	this.st_3.visible = true
	this.dw_control.visible = true
	this.st_startdate.visible = false
	this.st_enddate.visible = false
	this.em_startdate.visible = false
	this.em_enddate.visible = false
	return ::message.returnvalue

// w_arg_sinvcode_linvcode_cust_v2.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// dw_customer.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_customer.itemchanged(long row, dwobject dwo, string data) returns long
	long ancestorreturnvalue
	string ls_filter
	datawindowchild ldc_dddlookupstart
	datawindowchild ldc_dddlookupend
	integer li_null
	integer li_rtcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(li_null)
	li_rtcode = parent.dw_control.getchild("sinvcode", ldc_dddlookupstart)
	if li_rtcode = -1 then
		messagebox("Error", "Can not get a lookup DataWindowChild")
		close(parent)
	end if
	li_rtcode = parent.dw_control.getchild("linvcode", ldc_dddlookupend)
	if li_rtcode = -1 then
		messagebox("Error", "Can not get a lookup DataWindowChild")
		close(parent)
	end if
	if not isnull(data) then
		ls_filter = "custcode = Long('" + data + "')"
		ldc_dddlookupstart.setfilter(ls_filter)
		ldc_dddlookupstart.filter()
		ldc_dddlookupend.setfilter(ls_filter)
		ldc_dddlookupend.filter()
		parent.dw_control.setitem(1, "sinvcode", li_null)
		parent.dw_control.setitem(1, "linvcode", li_null)
	end if
	return ::message.returnvalue

// cbx_printheader.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// dw_pagesize.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// rb_originaldate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// rb_lastsavingdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// rb_billingdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// rb_invwise.clicked() returns long
	if this.checked then
		parent.st_2.visible = true
		parent.st_3.visible = true
		parent.dw_control.visible = true
		parent.st_startdate.visible = false
		parent.st_enddate.visible = false
		parent.em_startdate.visible = false
		parent.em_enddate.visible = false
	end if
	return ::message.returnvalue

// rb_datewise.clicked() returns long
	if this.checked then
		parent.st_2.visible = false
		parent.st_3.visible = false
		parent.dw_control.visible = false
		parent.st_startdate.visible = true
		parent.st_enddate.visible = true
		parent.em_startdate.visible = true
		parent.em_enddate.visible = true
		parent.dw_control.setitem(1, "sinvcode", 1)
		parent.dw_control.setitem(1, "linvcode", -1)
	end if
	return ::message.returnvalue
