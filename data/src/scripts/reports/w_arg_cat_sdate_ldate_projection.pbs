// window w_arg_cat_sdate_ldate_projection (reports)  ancestor: w_arguements

// w_arg_cat_sdate_ldate_projection.create() returns 0 [event]
	integer icurrent
	call super::create
	this.rb_excess = create rb_excess
	this.rb_require = create rb_require
	this.rb_all = create rb_all
	this.st_4 = create st_4
	this.em_projection = create em_projection
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.rb_excess
	this.control[icurrent + 2] = this.rb_require
	this.control[icurrent + 3] = this.rb_all
	this.control[icurrent + 4] = this.st_4
	this.control[icurrent + 5] = this.em_projection

// w_arg_cat_sdate_ldate_projection.destroy() returns 0 [event]
	call super::destroy
	destroy this.rb_excess
	destroy this.rb_require
	destroy this.rb_all
	destroy this.st_4
	destroy this.em_projection

// w_arg_cat_sdate_ldate_projection.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_cat_sdate_ldate_projection.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	if not (parent.em_projection.text = "") then
		parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "manfcode")
		parent.em_startdate.getdata(parent.istr_arg.d_sdate)
		parent.em_enddate.getdata(parent.istr_arg.d_edate)
		parent.istr_arg.l_code2 = long(parent.em_projection.text)
		parent.istr_arg.i_status = 1
		parent.post event ue_close(1)
	else
		messagebox("Projection Error", "Please enter Projection Period in days")
	end if
	return ::message.returnvalue

// em_projection.keydown(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
