// window w_arg_manf_sdate_ldate_amarantpharmaold (reports)  ancestor: w_arguements

// w_arg_manf_sdate_ldate_amarantpharmaold.create() returns 0 [event]
	integer icurrent
	call super::create
	this.cbx_cust = create cbx_cust
	this.cbx_area = create cbx_area
	this.gb_2 = create gb_2
	this.cbx_trans = create cbx_trans
	this.cb_trans = create cb_trans
	this.cb_cust = create cb_cust
	this.cb_area = create cb_area
	this.hpb_hpb = create hpb_hpb
	this.cbx_prod = create cbx_prod
	this.cb_prod = create cb_prod
	this.dw_control2 = create dw_control2
	this.gb_overallprogress = create gb_overallprogress
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_cust
	this.control[icurrent + 2] = this.cbx_area
	this.control[icurrent + 3] = this.gb_2
	this.control[icurrent + 4] = this.cbx_trans
	this.control[icurrent + 5] = this.cb_trans
	this.control[icurrent + 6] = this.cb_cust
	this.control[icurrent + 7] = this.cb_area
	this.control[icurrent + 8] = this.hpb_hpb
	this.control[icurrent + 9] = this.cbx_prod
	this.control[icurrent + 10] = this.cb_prod
	this.control[icurrent + 11] = this.dw_control2
	this.control[icurrent + 12] = this.gb_overallprogress

// w_arg_manf_sdate_ldate_amarantpharmaold.destroy() returns 0 [event]
	call super::destroy
	destroy this.cbx_cust
	destroy this.cbx_area
	destroy this.gb_2
	destroy this.cbx_trans
	destroy this.cb_trans
	destroy this.cb_cust
	destroy this.cb_area
	destroy this.hpb_hpb
	destroy this.cbx_prod
	destroy this.cb_prod
	destroy this.dw_control2
	destroy this.gb_overallprogress

// w_arg_manf_sdate_ldate_amarantpharmaold.open() returns long [event]
	long ancestorreturnvalue
	string ls_distcode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.retrieve()
	this.dw_control2.scrolltorow(0)
	this.dw_control2.object.distcode[1] = f_stringpreferences("MerckDistCode")
	this.dw_control2.accepttext()
	ls_distcode = this.dw_control2.object.distcode[1]
	this.is_trans = trim(f_stringpreferences("OutputFilePath")) + ls_distcode + "_TRANS.TXT"
	this.is_cust = trim(f_stringpreferences("OutputFilePath")) + ls_distcode + "_CUST.TXT"
	this.is_area = trim(f_stringpreferences("OutputFilePath")) + ls_distcode + "_TOWNS.TXT"
	this.is_prod = trim(f_stringpreferences("OutputFilePath")) + ls_distcode + "_PROD.TXT"
	return ::message.returnvalue

// w_arg_manf_sdate_ldate_amarantpharmaold.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	string ls_distcode
	datastore lds_temp
	ancestorreturnvalue = super::clicked()
	setpointer(hourglass!)
	parent.dw_control2.accepttext()
	parent.gb_overallprogress.visible = true
	parent.hpb_hpb.visible = true
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "manfcode")
	ls_distcode = parent.dw_control2.object.distcode[1]
	if isnull(ls_distcode) or ls_distcode = "" then
		messagebox("Distributor Code Validation", "Please enter a valid Distributor Code")
		return ::message.returnvalue
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.is_trans = trim(f_stringpreferences("OutputFilePath")) + ls_distcode + "_TRANS.TXT"
	parent.is_cust = trim(f_stringpreferences("OutputFilePath")) + ls_distcode + "_CUST.TXT"
	parent.is_area = trim(f_stringpreferences("OutputFilePath")) + ls_distcode + "_TOWNS.TXT"
	parent.is_prod = trim(f_stringpreferences("OutputFilePath")) + ls_distcode + "_PROD.TXT"
	parent.istr_arg.i_status = 1
	lds_temp = create datastore
	if parent.cbx_trans.checked = true then
		lds_temp.dataobject = "d_invdata_amarantpharma"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve(parent.istr_arg.l_code1, parent.istr_arg.d_sdate, parent.istr_arg.d_edate)
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
		if f_save_from_ds_to_fff2(parent.is_trans, lds_temp, " ", true) = 0 then
			messagebox("Invoice Data Generation Problem", "Error Generating Invoice Data Text File~r~nPlease Try Later")
			destroy lds_temp
			return ::message.returnvalue
		end if
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
	end if
	if parent.cbx_cust.checked = true then
		lds_temp.dataobject = "d_custdata_amarantpharma"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve()
		parent.hpb_hpb.stepit()
		if f_save_from_ds_to_fff2(parent.is_cust, lds_temp, " ", true) = 0 then
			messagebox("Invoice Data Generation Problem", "Error Generating Customers Data Text File~r~nPlease Try Later")
			destroy lds_temp
			return ::message.returnvalue
		end if
		parent.hpb_hpb.stepit()
	end if
	if parent.cbx_area.checked = true then
		lds_temp.dataobject = "d_areadata_amarantpharma"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve()
		parent.hpb_hpb.stepit()
		if f_save_from_ds_to_fff2(parent.is_area, lds_temp, " ", true) = 0 then
			messagebox("Area/Town Data Generation Problem", "Error Generating Area/Town Data Text File~r~nPlease Try Later")
			destroy lds_temp
			return ::message.returnvalue
		end if
		return
	end if
	if parent.cbx_prod.checked = true then
		lds_temp.dataobject = "d_proddata_amarantpharma"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve(parent.istr_arg.l_code1)
		parent.hpb_hpb.stepit()
		if f_save_from_ds_to_fff2(parent.is_prod, lds_temp, " ", true) = 0 then
			messagebox("Item/Product Data Generation Problem", "Error Generating Item/Product Data Text File~r~nPlease Try Later")
			destroy lds_temp
			return ::message.returnvalue
		end if
		return
	end if
	parent.hpb_hpb.stepit()
	destroy lds_temp
	parent.hpb_hpb.visible = false
	parent.hpb_hpb.position = 10
	parent.gb_overallprogress.visible = false
	setpointer(arrow!)
	parent.post event ue_close(1)
	return ::message.returnvalue

// cb_trans.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_trans, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_cust.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_cust, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_area.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_area, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_prod.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_prod, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// dw_control2.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "distcode"
		if len(data) > 0 then
			parent.is_trans = trim(f_stringpreferences("OutputFilePath")) + data + "_TRANS.TXT"
			parent.is_cust = trim(f_stringpreferences("OutputFilePath")) + data + "_CUST.TXT"
			parent.is_area = trim(f_stringpreferences("OutputFilePath")) + data + "_TOWNS.TXT"
			parent.is_prod = trim(f_stringpreferences("OutputFilePath")) + data + "_PROD.TXT"
		end if
		rt_code = 0
		return rt_code
	end choose
	return rt_code
