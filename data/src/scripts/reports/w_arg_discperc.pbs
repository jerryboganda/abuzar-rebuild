// window w_arg_discperc (reports)  ancestor: w_arguements

// w_arg_discperc.create() returns 0 [event]
	call super::create

// w_arg_discperc.destroy() returns 0 [event]
	call super::destroy

// w_arg_discperc.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_discperc.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// dw_control.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	if parent.dw_control.rowcount() > 0 then
		parent.istr_arg.i_status = 1
		parent.istr_arg.db_code1 = parent.dw_control.object.discperc[1]
	else
		parent.istr_arg.i_status = -1
	end if
	parent.post event ue_close(1)
	return ::message.returnvalue
