// window w_arg_manufacturers_agp (reports)  ancestor: w_listarguments

// w_arg_manufacturers_agp.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.cbx_prod = create cbx_prod
	this.cbx_cust = create cbx_cust
	this.cbx_trans = create cbx_trans
	this.cbx_summ = create cbx_summ
	this.cbx_stock = create cbx_stock
	this.cb_prod = create cb_prod
	this.cb_trans = create cb_trans
	this.cb_cust = create cb_cust
	this.cb_stock = create cb_stock
	this.cb_summ = create cb_summ
	this.hpb_hpb = create hpb_hpb
	this.em_dscode = create em_dscode
	this.st_9 = create st_9
	this.gb_txt = create gb_txt
	this.gb_overallprogress = create gb_overallprogress
	this.gb_5 = create gb_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.cbx_prod
	this.control[icurrent + 4] = this.cbx_cust
	this.control[icurrent + 5] = this.cbx_trans
	this.control[icurrent + 6] = this.cbx_summ
	this.control[icurrent + 7] = this.cbx_stock
	this.control[icurrent + 8] = this.cb_prod
	this.control[icurrent + 9] = this.cb_trans
	this.control[icurrent + 10] = this.cb_cust
	this.control[icurrent + 11] = this.cb_stock
	this.control[icurrent + 12] = this.cb_summ
	this.control[icurrent + 13] = this.hpb_hpb
	this.control[icurrent + 14] = this.em_dscode
	this.control[icurrent + 15] = this.st_9
	this.control[icurrent + 16] = this.gb_txt
	this.control[icurrent + 17] = this.gb_overallprogress
	this.control[icurrent + 18] = this.gb_5

// w_arg_manufacturers_agp.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.cbx_prod
	destroy this.cbx_cust
	destroy this.cbx_trans
	destroy this.cbx_summ
	destroy this.cbx_stock
	destroy this.cb_prod
	destroy this.cb_trans
	destroy this.cb_cust
	destroy this.cb_stock
	destroy this.cb_summ
	destroy this.hpb_hpb
	destroy this.em_dscode
	destroy this.st_9
	destroy this.gb_txt
	destroy this.gb_overallprogress
	destroy this.gb_5

// w_arg_manufacturers_agp.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("manufacturers", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	this.is_prod = trim(f_stringpreferences("OutputFilePath")) + "DSRProd.Txt"
	this.is_cust = trim(f_stringpreferences("OutputFilePath")) + "DSRCust.Txt"
	this.is_trans = trim(f_stringpreferences("OutputFilePath")) + "DSRTran.Txt"
	this.is_stock = trim(f_stringpreferences("OutputFilePath")) + "DSRStock.Txt"
	this.is_summ = trim(f_stringpreferences("OutputFilePath")) + "DSRSumm.TXT"
	return ::message.returnvalue

// cb_prod.clicked() returns long
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_prod, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_trans.clicked() returns long
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_trans, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

