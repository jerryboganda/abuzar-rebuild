// window w_arg_sinv_linv_salesum_headerwise (reports)  ancestor: w_arguements

// w_arg_sinv_linv_salesum_headerwise.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.cbx_storekeepersummary = create cbx_storekeepersummary
	this.cbx_billsummary = create cbx_billsummary
	this.cbx_invoiceprinting = create cbx_invoiceprinting
	this.st_5 = create st_5
	this.dw_control2 = create dw_control2
	this.dw_control3 = create dw_control3
	this.st_6 = create st_6
	this.cbx_posted = create cbx_posted
	this.cbx_unposted = create cbx_unposted
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.cbx_storekeepersummary
	this.control[icurrent + 3] = this.cbx_billsummary
	this.control[icurrent + 4] = this.cbx_invoiceprinting
	this.control[icurrent + 5] = this.st_5
	this.control[icurrent + 6] = this.dw_control2
	this.control[icurrent + 7] = this.dw_control3
	this.control[icurrent + 8] = this.st_6
	this.control[icurrent + 9] = this.cbx_posted
	this.control[icurrent + 10] = this.cbx_unposted

// w_arg_sinv_linv_salesum_headerwise.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.cbx_storekeepersummary
	destroy this.cbx_billsummary
	destroy this.cbx_invoiceprinting
	destroy this.st_5
	destroy this.dw_control2
	destroy this.dw_control3
	destroy this.st_6
	destroy this.cbx_posted
	destroy this.cbx_unposted

// w_arg_sinv_linv_salesum_headerwise.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	datawindowchild ldc_headerno
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.insertrow(0)
	this.dw_control2.scrolltorow(0)
	this.dw_control3.settransobject(sqlca)
	this.dw_control3.insertrow(0)
	this.dw_control3.scrolltorow(0)
	this.dw_control2.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to gds_reoprtheaderinfo.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "name", gds_reoprtheaderinfo.getitemstring(ll_counter, "clientname"))
		ldc_headerno.setitem(ll_counter, "code", gds_reoprtheaderinfo.getitemnumber(ll_counter, "headerno"))
	next
	return ::message.returnvalue

// w_arg_sinv_linv_salesum_headerwise.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// dw_control.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "sinvcode"
		if isnull(long(data)) then
			messagebox("Starting Invoice No.", "Must Select a Starting Invoice Number")
			return 1
		end if
		if isnull(parent.dw_control.getitemnumber(row, "linvcode")) then
			parent.dw_control.setitem(row, "linvcode", long(data))
		end if
	case "linvcode"
		if isnull(long(data)) then
			messagebox("Last Invoice No.", "Must Select a Last Invoice Number")
			return 1
		elseif long(data) < parent.dw_control.getitemnumber(row, "sinvcode") then
			messagebox("Last Invoice No. Validation", "Last Invoice Number Must be greater or ~requal to starting invoice no.")
			return 1
		end if
	end choose
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "sinvcode")
	parent.istr_arg.l_code2 = parent.dw_control.getitemnumber(1, "linvcode")
	if parent.istr_arg.l_code1 > parent.istr_arg.l_code2 then
		messagebox("Last Invoice No. Validation", "Last Invoice Number Must be greater or ~requal to starting invoice no.")
		return 1
	end if
	parent.istr_arg.l_code3 = parent.dw_control2.getitemnumber(1, "headerno")
	if isnull(parent.istr_arg.l_code3) or parent.istr_arg.l_code3 = 0 then
		messagebox("Header Validation", "Please Select Valid Header")
		return 1
	end if
	if parent.cbx_hide.checked = true then
		parent.istr_arg.l_code5 = 1
	else
		parent.istr_arg.l_code5 = 0
	end if
	parent.istr_arg.l_code4 = parent.dw_control3.getitemnumber(1, "salesman")
	if parent.istr_arg.l_code5 = 0 and (isnull(parent.istr_arg.l_code4) or parent.istr_arg.l_code4 = 0) then
		messagebox("Sales Person Validation", "Please Select Valid Sales Person")
		return 1
	end if
	if parent.cbx_invoiceprinting.checked = true then
		parent.istr_arg.s_name1 = "Y"
	else
		parent.istr_arg.s_name1 = "N"
	end if
	if parent.cbx_storekeepersummary.checked = true then
		parent.istr_arg.s_name2 = "Y"
	else
		parent.istr_arg.s_name2 = "N"
	end if
	if parent.cbx_billsummary.checked = true then
		parent.istr_arg.s_name3 = "Y"
	else
		parent.istr_arg.s_name3 = "N"
	end if
	if parent.cbx_posted.checked = true and parent.cbx_unposted.checked = true then
		parent.istr_arg.s_name4 = "B"
	elseif parent.cbx_posted.checked = true and parent.cbx_unposted.checked = false then
		parent.istr_arg.s_name4 = "Y"
	elseif parent.cbx_posted.checked = false and parent.cbx_unposted.checked = true then
		parent.istr_arg.s_name4 = "N"
	else
		messagebox("Posted/Unposted Selection", "You Must Select Atleast One option from Posted and Un-Posted")
		return ::message.returnvalue
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_control2.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_control3.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
