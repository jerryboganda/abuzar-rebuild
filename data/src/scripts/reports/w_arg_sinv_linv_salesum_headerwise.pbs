// window w_arg_sinv_linv_salesum_headerwise (reports)  ancestor: w_arguements

// w_arg_sinv_linv_salesum_headerwise.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.cbx_storekeepersummary = create cbx_storekeepersummary
	this.cbx_billsummary = create cbx_billsummary
	this.cbx_invoiceprinting = create cbx_invoiceprinting
	this.st_5 = create st_5
	this.dw_control2 = create dw_control2
	this.dw_control3 = create dw_control3
	this.st_6 = create st_6
	this.cbx_posted = create cbx_posted
	this.cbx_unposted = create cbx_unposted
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.cbx_storekeepersummary
	this.control[icurrent + 3] = this.cbx_billsummary
	this.control[icurrent + 4] = this.cbx_invoiceprinting
	this.control[icurrent + 5] = this.st_5
	this.control[icurrent + 6] = this.dw_control2
	this.control[icurrent + 7] = this.dw_control3
	this.control[icurrent + 8] = this.st_6
	this.control[icurrent + 9] = this.cbx_posted
	this.control[icurrent + 10] = this.cbx_unposted

// w_arg_sinv_linv_salesum_headerwise.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.cbx_storekeepersummary
	destroy this.cbx_billsummary
	destroy this.cbx_invoiceprinting
	destroy this.st_5
	destroy this.dw_control2
	destroy this.dw_control3
	destroy this.st_6
	destroy this.cbx_posted
	destroy this.cbx_unposted

// w_arg_sinv_linv_salesum_headerwise.open() returns long
	long ancestorreturnvalue
	long ll_counter
	datawindowchild ldc_headerno
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.insertrow(0)
	this.dw_control2.scrolltorow(0)
	this.dw_control3.settransobject(sqlca)
	this.dw_control3.insertrow(0)
	this.dw_control3.scrolltorow(0)
	this.dw_control2.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to gds_reoprtheaderinfo.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "name", gds_reoprtheaderinfo.getitemstring(ll_counter, "clientname"))
		ldc_headerno.setitem(ll_counter, "code", gds_reoprtheaderinfo.getitemnumber(ll_counter, "headerno"))
	next
	return ::message.returnvalue

// w_arg_sinv_linv_salesum_headerwise.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// dw_control2.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_control3.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
