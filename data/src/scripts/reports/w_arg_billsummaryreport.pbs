// window w_arg_billsummaryreport (reports)  ancestor: w_listarguments

// w_arg_billsummaryreport.create() returns 0
	integer icurrent
	call super::create
	this.cbx_posted = create cbx_posted
	this.cbx_unposted = create cbx_unposted
	this.cbx_usergroups = create cbx_usergroups
	this.cbx_printbalance = create cbx_printbalance
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.gb_5 = create gb_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_posted
	this.control[icurrent + 2] = this.cbx_unposted
	this.control[icurrent + 3] = this.cbx_usergroups
	this.control[icurrent + 4] = this.cbx_printbalance
	this.control[icurrent + 5] = this.st_4
	this.control[icurrent + 6] = this.st_8
	this.control[icurrent + 7] = this.gb_5

// w_arg_billsummaryreport.destroy() returns 0
	call super::destroy
	destroy this.cbx_posted
	destroy this.cbx_unposted
	destroy this.cbx_usergroups
	destroy this.cbx_printbalance
	destroy this.st_4
	destroy this.st_8
	destroy this.gb_5

// w_arg_billsummaryreport.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("usercode", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "username"))
	next
	this.dw_startendinvoice.settransobject(sqlca)
	this.dw_startendinvoice.insertrow(0)
	this.dw_startendinvoice.scrolltorow(0)
	return ::message.returnvalue

// cbx_posted.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// cbx_unposted.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// cbx_usergroups.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// cbx_printbalance.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
