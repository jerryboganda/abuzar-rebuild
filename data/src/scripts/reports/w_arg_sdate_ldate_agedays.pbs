// window w_arg_sdate_ldate_agedays (reports)  ancestor: w_arguements

// w_arg_sdate_ldate_agedays.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_days = create st_days
	this.em_days = create em_days
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_days
	this.control[icurrent + 2] = this.em_days

// w_arg_sdate_ldate_agedays.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_days
	destroy this.em_days

// w_arg_sdate_ldate_agedays.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.em_days.getdata(parent.istr_arg.db_code1)
	if isnull(parent.istr_arg.db_code1) or parent.istr_arg.db_code1 < 0.0 then
		messagebox("Age in Days Validation!", "Please Enter Valid Age in No. of Days")
		return ::message.returnvalue
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// em_days.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
