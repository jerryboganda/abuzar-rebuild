// window w_arg_sinvcode_linvcode_adjtype (reports)  ancestor: w_arguements

// w_arg_sinvcode_linvcode_adjtype.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.cbx_increase = create cbx_increase
	this.cbx_decrease = create cbx_decrease
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.cbx_increase
	this.control[icurrent + 3] = this.cbx_decrease

// w_arg_sinvcode_linvcode_adjtype.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.cbx_increase
	destroy this.cbx_decrease

// w_arg_sinvcode_linvcode_adjtype.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_sinvcode_linvcode_adjtype.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	parent.dw_control.accepttext()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "sinvcode")
	parent.istr_arg.l_code2 = parent.dw_control.getitemnumber(1, "linvcode")
	parent.istr_arg.i_status = 1
	if parent.cbx_increase.checked then
		parent.istr_arg.ia_integerlist[1] = 1
	else
		parent.istr_arg.ia_integerlist[1] = -1
	end if
	if parent.cbx_decrease.checked then
		parent.istr_arg.ia_integerlist[2] = 2
	else
		parent.istr_arg.ia_integerlist[2] = -1
	end if
	parent.post event ue_close(1)
	return ::message.returnvalue
