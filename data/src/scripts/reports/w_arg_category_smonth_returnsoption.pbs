// window w_arg_category_smonth_returnsoption (reports)  ancestor: w_listarguments

// w_arg_category_smonth_returnsoption.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.dw_smonth = create dw_smonth
	this.dw_syear = create dw_syear
	this.st_month = create st_month
	this.st_9 = create st_9
	this.dw_tradeprice = create dw_tradeprice
	this.st_10 = create st_10
	this.rb_allreturns = create rb_allreturns
	this.rb_returnagainstsale = create rb_returnagainstsale
	this.gb_5 = create gb_5
	this.gb_6 = create gb_6
	this.gb_returns = create gb_returns
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.dw_smonth
	this.control[icurrent + 4] = this.dw_syear
	this.control[icurrent + 5] = this.st_month
	this.control[icurrent + 6] = this.st_9
	this.control[icurrent + 7] = this.dw_tradeprice
	this.control[icurrent + 8] = this.st_10
	this.control[icurrent + 9] = this.rb_allreturns
	this.control[icurrent + 10] = this.rb_returnagainstsale
	this.control[icurrent + 11] = this.gb_5
	this.control[icurrent + 12] = this.gb_6
	this.control[icurrent + 13] = this.gb_returns

// w_arg_category_smonth_returnsoption.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.dw_smonth
	destroy this.dw_syear
	destroy this.st_month
	destroy this.st_9
	destroy this.dw_tradeprice
	destroy this.st_10
	destroy this.rb_allreturns
	destroy this.rb_returnagainstsale
	destroy this.gb_5
	destroy this.gb_6
	destroy this.gb_returns

// w_arg_category_smonth_returnsoption.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("category", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	this.dw_smonth.insertrow(0)
	this.dw_smonth.scrolltorow(0)
	this.dw_smonth.setitem(1, "month", month(today()))
	this.dw_syear.insertrow(0)
	this.dw_syear.scrolltorow(0)
	this.dw_syear.setitem(1, "year", year(today()))
	this.dw_tradeprice.insertrow(0)
	this.dw_tradeprice.scrolltorow(0)
	this.dw_tradeprice.setitem(1, "price", 1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "icatcode")
		next
	else
		for ll_counter = 1 to ll_counter
			ll_found = parent.idc_categories.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "icatcode")
			end if
		next
	end if
	parent.istr_arg.l_code1 = parent.dw_smonth.getitemnumber(1, "month")
	parent.istr_arg.l_code2 = parent.dw_syear.getitemnumber(1, "year")
	parent.istr_arg.l_code3 = parent.dw_tradeprice.getitemnumber(1, "price")
	if parent.rb_allreturns.checked = true then
		parent.istr_arg.s_name1 = "A"
	else
		parent.istr_arg.s_name1 = "S"
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_smonth.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// dw_syear.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// dw_tradeprice.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1
