// window w_arg_sdate_ldate_saletype (reports)  ancestor: w_arguements

// w_arg_sdate_ldate_saletype.create() returns 0 [event]
	integer icurrent
	call super::create
	this.rb_returns = create rb_returns
	this.rb_sales = create rb_sales
	this.gb_2 = create gb_2
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.rb_returns
	this.control[icurrent + 2] = this.rb_sales
	this.control[icurrent + 3] = this.gb_2

// w_arg_sdate_ldate_saletype.destroy() returns 0 [event]
	call super::destroy
	destroy this.rb_returns
	destroy this.rb_sales
	destroy this.gb_2

// w_arg_sdate_ldate_saletype.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if parent.rb_sales.checked = true then
		parent.istr_arg.s_name1 = "S"
	else
		parent.istr_arg.s_name1 = "R"
	end if
	if (parent.istr_arg.s_name1 = "S" or parent.istr_arg.s_name1 = "R") and parent.istr_arg.d_sdate <= parent.istr_arg.d_edate then
		parent.istr_arg.i_status = 1
	else
		parent.istr_arg.i_status = 0
	end if
	parent.post event ue_close(1)
	return ::message.returnvalue
