// window w_arg_manf_sdate_ldate_otsuka (reports)  ancestor: w_arguements

// w_arg_manf_sdate_ldate_otsuka.create() returns 0 [event]
	integer icurrent
	call super::create
	this.cbx_cust = create cbx_cust
	this.cbx_stock = create cbx_stock
	this.gb_2 = create gb_2
	this.cbx_trans = create cbx_trans
	this.cb_trans = create cb_trans
	this.cb_cust = create cb_cust
	this.cb_stock = create cb_stock
	this.hpb_hpb = create hpb_hpb
	this.sle_distcode = create sle_distcode
	this.st_4 = create st_4
	this.gb_overallprogress = create gb_overallprogress
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_cust
	this.control[icurrent + 2] = this.cbx_stock
	this.control[icurrent + 3] = this.gb_2
	this.control[icurrent + 4] = this.cbx_trans
	this.control[icurrent + 5] = this.cb_trans
	this.control[icurrent + 6] = this.cb_cust
	this.control[icurrent + 7] = this.cb_stock
	this.control[icurrent + 8] = this.hpb_hpb
	this.control[icurrent + 9] = this.sle_distcode
	this.control[icurrent + 10] = this.st_4
	this.control[icurrent + 11] = this.gb_overallprogress

// w_arg_manf_sdate_ldate_otsuka.destroy() returns 0 [event]
	call super::destroy
	destroy this.cbx_cust
	destroy this.cbx_stock
	destroy this.gb_2
	destroy this.cbx_trans
	destroy this.cb_trans
	destroy this.cb_cust
	destroy this.cb_stock
	destroy this.hpb_hpb
	destroy this.sle_distcode
	destroy this.st_4
	destroy this.gb_overallprogress

// w_arg_manf_sdate_ldate_otsuka.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	if f_rightexists(1329) then
		open(w_select_general_crs)
		this.il_scope = message.doubleparm
	end if
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.sle_distcode.text = trim(f_stringpreferences("MerckDistCode"))
	this.is_trans = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "INV.TXT"
	this.is_cust = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "CUST.TXT"
	this.is_stock = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "STOCK.TXT"
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_arg_manf_sdate_ldate_otsuka.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	string ls_dstcode
	datastore lds_temp
	ancestorreturnvalue = super::clicked()
	ls_dstcode = parent.sle_distcode.text
	if len(ls_dstcode) = 0 or isnull(ls_dstcode) then
		messagebox("Distributor Code Validation!", "Please enter a valid distributor code")
		return ::message.returnvalue
	end if
	setpointer(hourglass!)
	parent.gb_overallprogress.visible = true
	parent.hpb_hpb.visible = true
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "manfcode")
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_status = 1
	lds_temp = create datastore
	if parent.cbx_trans.checked = true then
		lds_temp.dataobject = "d_invdata_otsuka"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve(ls_dstcode, parent.istr_arg.l_code1, parent.istr_arg.d_sdate, parent.istr_arg.d_edate, parent.il_scope)
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
		if f_save_from_ds_to_fff2(parent.is_trans, lds_temp, " ", true) = 0 then
			messagebox("Invoice Data Generation Problem", "Error Generating Invoice Data Text File~r~nPlease Try Later")
			destroy lds_temp
			return ::message.returnvalue
		end if
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
	end if
	if parent.cbx_cust.checked = true then
		lds_temp.dataobject = "d_custdata_otsuka"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve(ls_dstcode)
		parent.hpb_hpb.stepit()
		if f_save_from_ds_to_fff2(parent.is_cust, lds_temp, " ", true) = 0 then
			messagebox("Customer Data Generation Problem", "Error Generating Customer Data Text File~r~nPlease Try Later")
			destroy lds_temp
			return ::message.returnvalue
		end if
		parent.hpb_hpb.stepit()
	end if
	if parent.cbx_stock.checked = true then
		lds_temp.dataobject = "d_stockdata_otsuka"
		lds_temp.settransobject(sqlca)
		lds_temp.retrieve(parent.istr_arg.l_code1, ls_dstcode, parent.istr_arg.d_sdate, parent.istr_arg.d_edate, parent.il_scope)
		parent.hpb_hpb.stepit()
		if f_save_from_ds_to_fff2(parent.is_stock, lds_temp, " ", true) = 0 then
			messagebox("Stock Data Generation Problem", "Error Generating Stock Data Text File~r~nPlease Try Later")
			destroy lds_temp
			return ::message.returnvalue
		end if
		return
	end if
	parent.hpb_hpb.stepit()
	destroy lds_temp
	parent.hpb_hpb.visible = false
	parent.hpb_hpb.position = 10
	parent.gb_overallprogress.visible = false
	setpointer(arrow!)
	parent.post event ue_close(1)
	return ::message.returnvalue

// cb_trans.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_trans, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_cust.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_cust, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// cb_stock.clicked() returns long [event]
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_stock, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

// sle_distcode.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// sle_distcode.modified() returns long [event]
	if len(this.text) > 0 then
		parent.is_trans = trim(f_stringpreferences("OutputFilePath")) + this.text + "INV.TXT"
		parent.is_cust = trim(f_stringpreferences("OutputFilePath")) + this.text + "CUST.TXT"
		parent.is_stock = trim(f_stringpreferences("OutputFilePath")) + this.text + "STOCK.TXT"
	end if
	return ::message.returnvalue
