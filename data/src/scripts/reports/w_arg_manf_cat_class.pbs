// window w_arg_manf_cat_class (reports)  ancestor: w_arguements

// w_arg_manf_cat_class.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.lb_categories = create lb_categories
	this.lb_selectedcategories = create lb_selectedcategories
	this.st_9 = create st_9
	this.st_10 = create st_10
	this.st_8 = create st_8
	this.cbx_all = create cbx_all
	this.dw_control2 = create dw_control2
	this.lb_itemcategories = create lb_itemcategories
	this.lb_selecteditemcategories = create lb_selecteditemcategories
	this.cbx_itemcategoriesall = create cbx_itemcategoriesall
	this.st_5 = create st_5
	this.st_6 = create st_6
	this.cbx_itemclassesall = create cbx_itemclassesall
	this.st_11 = create st_11
	this.st_12 = create st_12
	this.dw_control3 = create dw_control3
	this.gb_3 = create gb_3
	this.gb_2 = create gb_2
	this.lb_selecteditemclasses = create lb_selecteditemclasses
	this.lb_itemclasses = create lb_itemclasses
	this.dw_control4 = create dw_control4
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.lb_categories
	this.control[icurrent + 3] = this.lb_selectedcategories
	this.control[icurrent + 4] = this.st_9
	this.control[icurrent + 5] = this.st_10
	this.control[icurrent + 6] = this.st_8
	this.control[icurrent + 7] = this.cbx_all
	this.control[icurrent + 8] = this.dw_control2
	this.control[icurrent + 9] = this.lb_itemcategories
	this.control[icurrent + 10] = this.lb_selecteditemcategories
	this.control[icurrent + 11] = this.cbx_itemcategoriesall
	this.control[icurrent + 12] = this.st_5
	this.control[icurrent + 13] = this.st_6
	this.control[icurrent + 14] = this.cbx_itemclassesall
	this.control[icurrent + 15] = this.st_11
	this.control[icurrent + 16] = this.st_12
	this.control[icurrent + 17] = this.dw_control3
	this.control[icurrent + 18] = this.gb_3
	this.control[icurrent + 19] = this.gb_2
	this.control[icurrent + 20] = this.lb_selecteditemclasses
	this.control[icurrent + 21] = this.lb_itemclasses
	this.control[icurrent + 22] = this.dw_control4

// w_arg_manf_cat_class.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.lb_categories
	destroy this.lb_selectedcategories
	destroy this.st_9
	destroy this.st_10
	destroy this.st_8
	destroy this.cbx_all
	destroy this.dw_control2
	destroy this.lb_itemcategories
	destroy this.lb_selecteditemcategories
	destroy this.cbx_itemcategoriesall
	destroy this.st_5
	destroy this.st_6
	destroy this.cbx_itemclassesall
	destroy this.st_11
	destroy this.st_12
	destroy this.dw_control3
	destroy this.gb_3
	destroy this.gb_2
	destroy this.lb_selecteditemclasses
	destroy this.lb_itemclasses
	destroy this.dw_control4

// w_arg_manf_cat_class.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer li_rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	li_rtncode = this.dw_control.getchild("manufacturers", this.idc_manufacturers)
	if li_rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_manufacturers.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_manufacturers.getitemstring(ll_counter, "name"))
	next
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.insertrow(0)
	this.dw_control2.scrolltorow(0)
	li_rtncode = this.dw_control2.getchild("categories", this.idc_itemcategories)
	if li_rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_itemcategories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_itemcategories.additem(this.idc_itemcategories.getitemstring(ll_counter, "name"))
	next
	this.dw_control3.settransobject(sqlca)
	this.dw_control3.insertrow(0)
	this.dw_control3.scrolltorow(0)
	li_rtncode = this.dw_control3.getchild("iccode", this.idc_itemclasses)
	if li_rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_itemclasses.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_itemclasses.additem(this.idc_itemclasses.getitemstring(ll_counter, "name"))
	next
	return ::message.returnvalue

// w_arg_manf_cat_class.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// lb_categories.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_categories.doubleclicked(integer index) returns long
	long ll_selectedindex
	string ls_item
	ls_item = string(selecteditem())
	ll_selectedindex = selectedindex()
	if not isnull(ls_item) and index >= 1 then
		parent.lb_selectedcategories.additem(ls_item)
		deleteitem(index)
		if ll_selectedindex > 1 then
			if totalitems() < ll_selectedindex then
				selectitem(totalitems())
			else
				selectitem(ll_selectedindex)
			end if
		else
			selectitem(1)
		end if
	else
		messagebox("Selection Validation", "Please select some value from Manufacturers selectable listbox")
	end if
	return ::message.returnvalue

// lb_categories.getfocus() returns long
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue

// lb_selectedcategories.ue_keypressed(keycode key, unsignedlong keyflags) returns long
