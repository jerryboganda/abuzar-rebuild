// window w_arg_disease_diseasetype (reports)  ancestor: w_arguements

// w_arg_disease_diseasetype.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_godown = create st_godown
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_godown

// w_arg_disease_diseasetype.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_godown

// w_arg_disease_diseasetype.open() returns long [event]
	long ancestorreturnvalue
	long ll_code
	long rtncode
	ancestorreturnvalue = super::open()
	ll_code = message.doubleparm
	if ll_code > 0 then
		this.dw_control.settransobject(sqlca)
		rtncode = this.dw_control.getchild("diseasecode", this.idwc_child)
		if rtncode = -1 then
			messagebox("Error", "Not a DataWindowChild")
			close(this)
			if not isvalid(message) then
				return 0
			end if
			return message.returnvalue
		end if
		this.idwc_child.settransobject(sqlca)
		this.idwc_child.retrieve(ll_code)
		this.dw_control.insertrow(0)
		this.dw_control.scrolltorow(0)
	else
		messagebox("Error", "Please Select a valid disease type")
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_arg_disease_diseasetype.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "diseasecode")
	if parent.rb_saleprice.checked then
		parent.istr_arg.s_name1 = "s"
	else
		parent.istr_arg.s_name1 = "p"
	end if
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
