// window w_arg_sinvcode_linvcode_saleandreturn2 (reports)  ancestor: w_arguements

// w_arg_sinvcode_linvcode_saleandreturn2.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.cbx_cash = create cbx_cash
	this.cbx_credit = create cbx_credit
	this.dw_control2 = create dw_control2
	this.st_5 = create st_5
	this.st_6 = create st_6
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.cbx_cash
	this.control[icurrent + 3] = this.cbx_credit
	this.control[icurrent + 4] = this.dw_control2
	this.control[icurrent + 5] = this.st_5
	this.control[icurrent + 6] = this.st_6

// w_arg_sinvcode_linvcode_saleandreturn2.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.cbx_cash
	destroy this.cbx_credit
	destroy this.dw_control2
	destroy this.st_5
	destroy this.st_6

// w_arg_sinvcode_linvcode_saleandreturn2.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.insertrow(0)
	this.dw_control2.scrolltorow(0)
	return ::message.returnvalue

// w_arg_sinvcode_linvcode_saleandreturn2.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ll_counter
	parent.dw_control.accepttext()
	parent.dw_control2.accepttext()
	if parent.cbx_cash.checked = false and parent.cbx_credit.checked = false then
		messagebox("Type Validation", "Kindly select either Cash or Credit or both types.")
		return ::message.returnvalue
	end if
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "sinvcode")
	parent.istr_arg.l_code2 = parent.dw_control.getitemnumber(1, "linvcode")
	parent.istr_arg.l_code3 = parent.dw_control2.getitemnumber(1, "sinvcode")
	parent.istr_arg.l_code4 = parent.dw_control2.getitemnumber(1, "linvcode")
	parent.istr_arg.i_status = 1
	for ll_counter = 1 to 6
		parent.istr_arg.ia_integerlist[ll_counter] = 0
	next
	if parent.cbx_cash.checked then
		parent.istr_arg.ia_integerlist[1] = 3
		parent.istr_arg.ia_integerlist[4] = 8
	end if
	if parent.cbx_credit.checked then
		parent.istr_arg.ia_integerlist[2] = 1
		parent.istr_arg.ia_integerlist[3] = 2
		parent.istr_arg.ia_integerlist[5] = 6
		parent.istr_arg.ia_integerlist[6] = 7
	end if
	parent.post event ue_close(1)
	return ::message.returnvalue

// cbx_cash.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// cbx_credit.ue_entekey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// dw_control2.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1
