// window w_arg_sinvcode_linvcode_saleandreturn2 (reports)  ancestor: w_arguements

// w_arg_sinvcode_linvcode_saleandreturn2.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.cbx_cash = create cbx_cash
	this.cbx_credit = create cbx_credit
	this.dw_control2 = create dw_control2
	this.st_5 = create st_5
	this.st_6 = create st_6
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.cbx_cash
	this.control[icurrent + 3] = this.cbx_credit
	this.control[icurrent + 4] = this.dw_control2
	this.control[icurrent + 5] = this.st_5
	this.control[icurrent + 6] = this.st_6

// w_arg_sinvcode_linvcode_saleandreturn2.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.cbx_cash
	destroy this.cbx_credit
	destroy this.dw_control2
	destroy this.st_5
	destroy this.st_6

// w_arg_sinvcode_linvcode_saleandreturn2.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.insertrow(0)
	this.dw_control2.scrolltorow(0)
	return ::message.returnvalue

// w_arg_sinvcode_linvcode_saleandreturn2.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cbx_cash.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// cbx_credit.ue_entekey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// dw_control2.ue_enterkey() returns long
	send(handle(this), 256, 9, long(90))
	return 1
