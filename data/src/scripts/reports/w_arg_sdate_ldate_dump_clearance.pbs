// window w_arg_sdate_ldate_dump_clearance (reports)  ancestor: w_arguements

// w_arg_sdate_ldate_dump_clearance.create() returns 0 [event]
	call super::create

// w_arg_sdate_ldate_dump_clearance.destroy() returns 0 [event]
	call super::destroy

// w_arg_sdate_ldate_dump_clearance.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// w_arg_sdate_ldate_dump_clearance.open() returns long [event]
	long ancestorreturnvalue
	long ll_groupcode
	long ll_count
	long ll_usercode
	ancestorreturnvalue = super::open()
	this.is_module = message.stringparm
	if this.is_module = "P" then
		this.title = "Clear Purchase Dump"
	else
		this.title = "Clear Sales Dump"
	end if
	open(w_salesmanpassword)
	ll_usercode = long(message.doubleparm)
	if ll_usercode < 0 or isnull(ll_usercode) then
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	else
		ll_groupcode = f_getgroupcode(ll_usercode)
		if ll_groupcode > 0 then
			if this.is_module = "P" then
				SQL SELECT ISNULL ( COUNT ( RightCode ) , 0 ) INTO :ll_count FROM GroupRights WHERE GroupCode =:ll_groupcode AND RightCode IN ( 1585 ) USING sqlca;
			else
				SQL SELECT ISNULL ( COUNT ( RightCode ) , 0 ) INTO :ll_count FROM GroupRights WHERE GroupCode =:ll_groupcode AND RightCode IN ( 1588 ) USING sqlca;
			end if
			if isnull(ll_count) then
				ll_count = 0
			end if
			if sqlca.sqlcode <> 0 then
				close(this)
				if not isvalid(message) then
					return 0
				end if
				return message.returnvalue
			elseif ll_count = 0 then
				messagebox("Rights Validation", "You do not have rights to execute this business function/process.~r~nKindly consult your system administrator.", stopsign!)
				close(this)
				if not isvalid(message) then
					return 0
				end if
				return message.returnvalue
			end if
		else
			close(this)
			if not isvalid(message) then
				return 0
			end if
			return message.returnvalue
		end if
	end if
	this.em_startdate.setfocus()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	long ll_rowsaffected
	string ls_err
	ancestorreturnvalue = super::clicked()
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_status = 1
	setpointer(hourglass!)
	if parent.istr_arg.i_status = 1 then
		if parent.is_module = "P" then
			SQL rollback USING sqlca;
			sqlca.deleteinvoicesfrompurdump(parent.istr_arg.d_sdate, parent.istr_arg.d_edate, ll_rowsaffected)
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				messagebox("Purchase Dump Clearance", "Purchase Dump Clearance Done Successfully~r~nTotal Rows Affected = " + trim(string(ll_rowsaffected)), information!)
			else
				ls_err = sqlca.sqlerrtext
				SQL rollback USING sqlca;
				messagebox("Purchase Dump Clearance Error", "Purchase Dump Clearance Error Occured. Details Are:-~r~n" + ls_err, stopsign!)
			end if
		elseif parent.is_module = "S" then
			SQL rollback USING sqlca;
			sqlca.deleteinvoicesfromsaledump(parent.istr_arg.d_sdate, parent.istr_arg.d_edate, ll_rowsaffected)
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				messagebox("Sale Dump Clearance", "Sale Dump Clearance Done Successfully~r~nTotal Rows Affected = " + trim(string(ll_rowsaffected)), information!)
			else
				ls_err = sqlca.sqlerrtext
				SQL rollback USING sqlca;
				messagebox("Sale Dump Clearance Error", "Sale Dump Clearance Error Occured. Details Are:-~r~n" + ls_err, stopsign!)
			end if
		end if
	end if
	setpointer(arrow!)
	parent.post event ue_close(1)
	return ::message.returnvalue
