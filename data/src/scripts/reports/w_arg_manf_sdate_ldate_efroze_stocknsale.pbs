// window w_arg_manf_sdate_ldate_efroze_stocknsale (reports)  ancestor: w_arguements

// w_arg_manf_sdate_ldate_efroze_stocknsale.create() returns 0
	integer icurrent
	call super::create
	this.gb_2 = create gb_2
	this.hpb_hpb = create hpb_hpb
	this.cbx_xls = create cbx_xls
	this.cb_xls = create cb_xls
	this.gb_overallprogress = create gb_overallprogress
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_2
	this.control[icurrent + 2] = this.hpb_hpb
	this.control[icurrent + 3] = this.cbx_xls
	this.control[icurrent + 4] = this.cb_xls
	this.control[icurrent + 5] = this.gb_overallprogress

// w_arg_manf_sdate_ldate_efroze_stocknsale.destroy() returns 0
	call super::destroy
	destroy this.gb_2
	destroy this.hpb_hpb
	destroy this.cbx_xls
	destroy this.cb_xls
	destroy this.gb_overallprogress

// w_arg_manf_sdate_ldate_efroze_stocknsale.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.is_trans = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "INV.TXT"
	this.is_xls = trim(f_stringpreferences("OutputFilePath")) + trim(f_stringpreferences("MerckDistCode")) + "INV.XLS"
	return ::message.returnvalue

// w_arg_manf_sdate_ldate_efroze_stocknsale.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_xls.clicked() returns long
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_xls, ls_named, "XLS", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue
