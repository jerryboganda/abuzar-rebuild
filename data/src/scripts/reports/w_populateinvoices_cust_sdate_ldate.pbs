// window w_populateinvoices_cust_sdate_ldate (reports)  ancestor: window

// w_populateinvoices_cust_sdate_ldate.ue_keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		post event ue_close()
	end if
	return ::message.returnvalue

// w_populateinvoices_cust_sdate_ldate.ue_close() returns 0
	closewithreturn(this, this.istr_arg)

// w_populateinvoices_cust_sdate_ldate.wf_assigndwobjects(string as_masterdw, string as_detaildw, string as_footerdw) returns 0
	this.dw_master.dataobject = as_masterdw
	this.dw_detail.dataobject = as_detaildw
	this.dw_footer.dataobject = as_footerdw
	this.dw_master.settransobject(sqlca)
	this.dw_detail.settransobject(sqlca)
	this.dw_footer.settransobject(sqlca)

// w_populateinvoices_cust_sdate_ldate.create() returns 0
	this.dw_footer = create dw_footer
	this.dw_master = create dw_master
	this.cb_retrieve = create cb_retrieve
	this.cb_ok = create cb_ok
	this.dw_detail = create dw_detail
	this.control = {this.dw_footer, this.dw_master, this.cb_retrieve, this.cb_ok, this.dw_detail}

// w_populateinvoices_cust_sdate_ldate.destroy() returns 0
	destroy this.dw_footer
	destroy this.dw_master
	destroy this.cb_retrieve
	destroy this.cb_ok
	destroy this.dw_detail

// w_populateinvoices_cust_sdate_ldate.open() returns long
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_custcode
	string ls_date
	ll_custcode = message.doubleparm
	if isnull(ll_custcode) or ll_custcode = 0 then
		messagebox("Customer Validation", "Can not populate sale invoices~r~nPlease Select Valid Customer")
		post event ue_close()
	end if
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	wf_assigndwobjects("d_customer_sdate_ldate", "d_salesinvoices_cust_sdate_ldate", "")
	this.dw_master.insertrow(0)
	this.dw_master.scrolltorow(0)
	this.dw_master.setitem(1, "custcode", ll_custcode)
	ls_date = string(date(this.dw_master.getitemdatetime(this.dw_master.getrow(), "startdate")), "mm/dd/yyyy")
	this.dw_master.setitem(this.dw_master.getrow(), "startdate", datetime(date(ls_date), time(" 00:00:00")))
	this.dw_master.setitem(this.dw_master.getrow(), "enddate", datetime(date(ls_date), time(" 23:59:59")))
	this.dw_master.setcolumn("startdate")
	this.dw_master.setfocus()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_master.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// cb_retrieve.clicked() returns long
	string ls_filter
	long ll_masterrow
	parent.dw_master.accepttext()
	ll_masterrow = parent.dw_master.getrow()
	if parent.dw_master.getitemnumber(ll_masterrow, "custcode") > 0.0 and parent.dw_master.getitemdatetime(ll_masterrow, "startdate") <= parent.dw_master.getitemdatetime(ll_masterrow, "enddate") then
		parent.dw_detail.retrieve(parent.dw_master.getitemnumber(ll_masterrow, "custcode"), parent.dw_master.getitemdatetime(ll_masterrow, "startdate"), parent.dw_master.getitemdatetime(ll_masterrow, "enddate"))
		parent.dw_detail.setredraw(false)
		parent.dw_detail.setredraw(true)
	else
		messagebox("Validation!", "Plese Select Valid Customer and Period.")
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	long[] ll_invcode
	long ll_rowcount
	long ll_counter
	long ll_arrindex
	long ll_thiscode
	boolean lb_remarks
	string ls_date
	parent.istr_arg.l_code1 = parent.dw_master.getitemnumber(parent.dw_master.getrow(), "custcode")
	ll_rowcount = parent.dw_detail.rowcount()
	for ll_counter = 1 to ll_rowcount
		if parent.dw_detail.getitemstring(ll_counter, "selected") = "Y" then
			ll_arrindex = ll_arrindex + 1
			ls_date = string(date(parent.dw_detail.getitemdatetime(ll_counter, "date")), "dd/mm/yyyy")
			ll_thiscode = parent.dw_detail.getitemnumber(ll_counter, "saleinvcode")
			parent.istr_arg.ia_integerlist[ll_arrindex] = ll_thiscode
		end if
	next
	parent.istr_arg.i_status = 1
	parent.post event ue_close()
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
