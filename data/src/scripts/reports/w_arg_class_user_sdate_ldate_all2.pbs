// window w_arg_class_user_sdate_ldate_all2 (reports)  ancestor: w_listarguments

// w_arg_class_user_sdate_ldate_all2.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.dw_user = create dw_user
	this.st_9 = create st_9
	this.rb_datewise = create rb_datewise
	this.rb_invwise = create rb_invwise
	this.gb_5 = create gb_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.dw_user
	this.control[icurrent + 4] = this.st_9
	this.control[icurrent + 5] = this.rb_datewise
	this.control[icurrent + 6] = this.rb_invwise
	this.control[icurrent + 7] = this.gb_5

// w_arg_class_user_sdate_ldate_all2.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.dw_user
	destroy this.st_9
	destroy this.rb_datewise
	destroy this.rb_invwise
	destroy this.gb_5

// w_arg_class_user_sdate_ldate_all2.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_startendinvoice.settransobject(sqlca)
	this.dw_startendinvoice.insertrow(0)
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_user.settransobject(sqlca)
	this.dw_user.insertrow(0)
	this.dw_user.scrolltorow(0)
	rtncode = this.dw_control.getchild("iccode", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	return ::message.returnvalue
