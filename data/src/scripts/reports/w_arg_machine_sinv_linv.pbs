// window w_arg_machine_sinv_linv (reports)  ancestor: w_arguements

// w_arg_machine_sinv_linv.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.cbx_cash = create cbx_cash
	this.cbx_credit = create cbx_credit
	this.dw_control2 = create dw_control2
	this.st_5 = create st_5
	this.st_6 = create st_6
	this.cbx_cashsr = create cbx_cashsr
	this.cbx_creditsr = create cbx_creditsr
	this.st_7 = create st_7
	this.dw_machine = create dw_machine
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.cbx_cash
	this.control[icurrent + 3] = this.cbx_credit
	this.control[icurrent + 4] = this.dw_control2
	this.control[icurrent + 5] = this.st_5
	this.control[icurrent + 6] = this.st_6
	this.control[icurrent + 7] = this.cbx_cashsr
	this.control[icurrent + 8] = this.cbx_creditsr
	this.control[icurrent + 9] = this.st_7
	this.control[icurrent + 10] = this.dw_machine

// w_arg_machine_sinv_linv.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.cbx_cash
	destroy this.cbx_credit
	destroy this.dw_control2
	destroy this.st_5
	destroy this.st_6
	destroy this.cbx_cashsr
	destroy this.cbx_creditsr
	destroy this.st_7
	destroy this.dw_machine

// w_arg_machine_sinv_linv.open() returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.insertrow(0)
	this.dw_control2.scrolltorow(0)
	this.dw_machine.settransobject(sqlca)
	ll_retcode = this.dw_machine.getchild("machinename", this.idc_machine)
	if ll_retcode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	this.idc_machine.settransobject(sqlca)
	this.idc_machine.insertrow(0)
	this.dw_machine.insertrow(0)
	this.dw_machine.scrolltorow(0)
	return ::message.returnvalue

// w_arg_machine_sinv_linv.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ll_counter
	parent.dw_control.accepttext()
	parent.dw_control2.accepttext()
	parent.dw_machine.accepttext()
	if parent.cbx_cash.checked = false and parent.cbx_credit.checked = false then
		messagebox("Type Validation", "Kindly select either Cash or Credit or both types.")
		return ::message.returnvalue
	end if
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "sinvcode")
	parent.istr_arg.l_code2 = parent.dw_control.getitemnumber(1, "linvcode")
	parent.istr_arg.l_code3 = parent.dw_control2.getitemnumber(1, "sinvcode")
	parent.istr_arg.l_code4 = parent.dw_control2.getitemnumber(1, "linvcode")
	parent.istr_arg.s_name1 = parent.dw_machine.getitemstring(1, "machinename")
	parent.istr_arg.i_status = 1
	for ll_counter = 1 to 6
		parent.istr_arg.ia_integerlist[ll_counter] = 0
	next
	if parent.cbx_cash.checked then
		parent.istr_arg.ia_integerlist[1] = 3
	end if
	if parent.cbx_cashsr.checked then
		parent.istr_arg.ia_integerlist[4] = 8
	end if
	if parent.cbx_credit.checked then
		parent.istr_arg.ia_integerlist[2] = 1
		parent.istr_arg.ia_integerlist[3] = 2
	end if
	if parent.cbx_creditsr.checked then
		parent.istr_arg.ia_integerlist[5] = 6
		parent.istr_arg.ia_integerlist[6] = 7
	end if
	parent.post event ue_close(1)
	return ::message.returnvalue

// cbx_cash.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// cbx_credit.ue_entekey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// dw_control2.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// cbx_cashsr.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// cbx_creditsr.ue_entekey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// dw_machine.getfocus() returns long [event]
	long ancestorreturnvalue
	long ll_sinvcode
	long ll_linvcode
	long ll_sinvcode_sr
	long ll_linvcode_sr
	long[] ll_catcode
	long ll_counter
	ancestorreturnvalue = super::getfocus()
	parent.dw_control.accepttext()
	parent.dw_control2.accepttext()
	parent.dw_machine.accepttext()
	if parent.cbx_cash.checked = false and parent.cbx_credit.checked = false then
		messagebox("Type Validation", "Kindly select either Cash or Credit or both types.")
		return ::message.returnvalue
	end if
	if parent.cbx_cashsr.checked = false and parent.cbx_creditsr.checked = false then
		messagebox("Type Validation", "Kindly select either Cash or Credit or both types.")
		return ::message.returnvalue
	end if
	ll_sinvcode = parent.dw_control.getitemnumber(1, "sinvcode")
	ll_linvcode = parent.dw_control.getitemnumber(1, "linvcode")
	ll_sinvcode_sr = parent.dw_control2.getitemnumber(1, "sinvcode")
	ll_linvcode_sr = parent.dw_control2.getitemnumber(1, "linvcode")
	for ll_counter = 1 to 6
		ll_catcode[ll_counter] = 0
	next
	if parent.cbx_cash.checked then
		ll_catcode[1] = 3
	end if
	if parent.cbx_cashsr.checked then
		ll_catcode[4] = 8
	end if
	if parent.cbx_credit.checked then
		ll_catcode[2] = 1
		ll_catcode[3] = 2
	end if
	if parent.cbx_creditsr.checked then
		ll_catcode[5] = 6
		ll_catcode[6] = 7
	end if
	parent.idc_machine.retrieve(ll_sinvcode, ll_linvcode, ll_sinvcode_sr, ll_linvcode_sr, ll_catcode)
	return ::message.returnvalue
