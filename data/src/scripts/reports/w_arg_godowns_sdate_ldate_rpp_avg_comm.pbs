// window w_arg_godowns_sdate_ldate_rpp_avg_comm (reports)  ancestor: w_listarguments

// w_arg_godowns_sdate_ldate_rpp_avg_comm.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.cbx_cash = create cbx_cash
	this.cbx_credit = create cbx_credit
	this.st_9 = create st_9
	this.em_comm = create em_comm
	this.gb_5 = create gb_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.cbx_cash
	this.control[icurrent + 4] = this.cbx_credit
	this.control[icurrent + 5] = this.st_9
	this.control[icurrent + 6] = this.em_comm
	this.control[icurrent + 7] = this.gb_5

// w_arg_godowns_sdate_ldate_rpp_avg_comm.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.cbx_cash
	destroy this.cbx_credit
	destroy this.st_9
	destroy this.em_comm
	destroy this.gb_5

// w_arg_godowns_sdate_ldate_rpp_avg_comm.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_price.settransobject(sqlca)
	this.dw_price.insertrow(0)
	this.dw_price.scrolltorow(0)
	rtncode = this.dw_control.getchild("gcode", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "gcode")
		next
	else
		for ll_counter = 1 to parent.lb_selectedcategories.totalitems()
			ll_found = parent.idc_categories.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "gcode")
			end if
		next
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.dw_price.accepttext()
	parent.istr_arg.l_code1 = parent.dw_price.object.price[1]
	if parent.cbx_cash.checked then
		parent.istr_arg.ia_integerlist2[3] = 3
		parent.istr_arg.ia_integerlist2[6] = 8
	end if
	if parent.cbx_credit.checked then
		parent.istr_arg.ia_integerlist2[2] = 2
		parent.istr_arg.ia_integerlist2[1] = 1
		parent.istr_arg.ia_integerlist2[4] = 6
		parent.istr_arg.ia_integerlist2[5] = 7
	end if
	parent.em_comm.getdata(parent.istr_arg.db_code1)
	if isnull(parent.istr_arg.db_code1) then
		parent.istr_arg.db_code1 = 0
	end if
	if parent.istr_arg.db_code1 < 0.0 then
		messagebox("Commission % Validation", "Please enter valid Commission %, Range[0-100]")
		return ::message.returnvalue
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.post event ue_close(1)
	return ::message.returnvalue

// em_comm.keydown(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
