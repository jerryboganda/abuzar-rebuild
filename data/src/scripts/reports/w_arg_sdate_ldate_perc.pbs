// window w_arg_sdate_ldate_perc (reports)  ancestor: w_arguements

// w_arg_sdate_ldate_perc.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_9 = create st_9
	this.em_perc = create em_perc
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_9
	this.control[icurrent + 2] = this.em_perc

// w_arg_sdate_ldate_perc.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_9
	destroy this.em_perc

// w_arg_sdate_ldate_perc.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.em_perc.getdata(parent.istr_arg.db_code1)
	if parent.istr_arg.db_code1 < 0.0 or isnull(parent.istr_arg.db_code1) or parent.istr_arg.db_code1 > 100.0 then
		messagebox("Percentage Validation!", "Please Enter Some Valid Percentage Here")
		return ::message.returnvalue
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// em_perc.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_perc.getfocus() returns long [event]
	selecttext(1, len(this.text))
	return ::message.returnvalue
