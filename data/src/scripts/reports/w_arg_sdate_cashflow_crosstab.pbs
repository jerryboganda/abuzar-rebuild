// window w_arg_sdate_cashflow_crosstab (reports)  ancestor: w_arguements

// w_arg_sdate_cashflow_crosstab.create() returns 0
	integer icurrent
	call super::create
	this.rb_bank = create rb_bank
	this.rb_cash = create rb_cash
	this.rb_both = create rb_both
	this.gb_2 = create gb_2
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.rb_bank
	this.control[icurrent + 2] = this.rb_cash
	this.control[icurrent + 3] = this.rb_both
	this.control[icurrent + 4] = this.gb_2

// w_arg_sdate_cashflow_crosstab.destroy() returns 0
	call super::destroy
	destroy this.rb_bank
	destroy this.rb_cash
	destroy this.rb_both
	destroy this.gb_2

// w_arg_sdate_cashflow_crosstab.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)
