// window w_arg_single_suppcategory_sdate_ldate (reports)  ancestor: w_arguements

// w_arg_single_suppcategory_sdate_ldate.create() returns 0 [event]
	integer icurrent
	call super::create
	this.cbx_cash = create cbx_cash
	this.cbx_credit = create cbx_credit
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_cash
	this.control[icurrent + 2] = this.cbx_credit

// w_arg_single_suppcategory_sdate_ldate.destroy() returns 0 [event]
	call super::destroy
	destroy this.cbx_cash
	destroy this.cbx_credit

// w_arg_single_suppcategory_sdate_ldate.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// w_arg_single_suppcategory_sdate_ldate.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	if isnull(parent.dw_control.object.suppcatcode[1]) or parent.dw_control.object.suppcatcode[1] = 0 then
		messagebox("Supplier Category Validation!", "Please select valid Supplier Category")
		return ::message.returnvalue
	end if
	parent.istr_arg.l_code1 = parent.dw_control.object.suppcatcode[1]
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
