// window w_arg_date_wards_cust (reports)  ancestor: w_listarguments

// w_arg_date_wards_cust.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.dw_customer = create dw_customer
	this.st_9 = create st_9
	this.st_10 = create st_10
	this.em_discperc = create em_discperc
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.dw_customer
	this.control[icurrent + 4] = this.st_9
	this.control[icurrent + 5] = this.st_10
	this.control[icurrent + 6] = this.em_discperc

// w_arg_date_wards_cust.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.dw_customer
	destroy this.st_9
	destroy this.st_10
	destroy this.em_discperc

// w_arg_date_wards_cust.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_customer.settransobject(sqlca)
	this.dw_customer.insertrow(0)
	this.dw_customer.scrolltorow(0)
	rtncode = this.dw_control.getchild("wardcode", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	this.dw_control.setitem(this.dw_control.getrow(), "wardcode", this.idc_categories.getitemnumber(this.idc_categories.getrow(), "code"))
	this.lb_categories.setfocus()
	this.lb_categories.selectitem(1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "code")
		next
	else
		for ll_counter = 1 to parent.lb_selectedcategories.totalitems()
			ll_found = parent.idc_categories.find("name = '" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "code")
			end if
		next
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.s_name1 = "lastsavingdate"
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.l_code1 = parent.dw_customer.getitemnumber(1, "custcode")
	if parent.cbx_supress.checked then
		parent.istr_arg.s_name2 = "Y"
	else
		parent.istr_arg.s_name2 = "N"
	end if
	parent.em_discperc.getdata(parent.istr_arg.db_code1)
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
