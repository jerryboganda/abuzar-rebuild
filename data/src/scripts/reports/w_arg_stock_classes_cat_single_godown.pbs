// window w_arg_stock_classes_cat_single_godown (reports)  ancestor: w_listarguments

// w_arg_stock_classes_cat_single_godown.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.dw_godown = create dw_godown
	this.cbx_allgodown = create cbx_allgodown
	this.cbx_allcategory = create cbx_allcategory
	this.dw_category = create dw_category
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.dw_godown
	this.control[icurrent + 4] = this.cbx_allgodown
	this.control[icurrent + 5] = this.cbx_allcategory
	this.control[icurrent + 6] = this.dw_category

// w_arg_stock_classes_cat_single_godown.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.dw_godown
	destroy this.cbx_allgodown
	destroy this.cbx_allcategory
	destroy this.dw_category

// w_arg_stock_classes_cat_single_godown.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_price.insertrow(0)
	this.dw_price.scrolltorow(0)
	this.dw_godown.settransobject(sqlca)
	this.dw_godown.insertrow(0)
	this.dw_godown.scrolltorow(0)
	this.dw_category.settransobject(sqlca)
	this.dw_category.insertrow(0)
	this.dw_category.scrolltorow(0)
	rtncode = this.dw_control.getchild("iccode", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "iccode")
		next
	else
		for ll_counter = 1 to ll_counter
			ll_found = parent.idc_categories.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "iccode")
			end if
		next
	end if
	parent.dw_price.accepttext()
	parent.dw_godown.accepttext()
	parent.istr_arg.l_code1 = parent.dw_price.getitemnumber(1, "price")
	parent.istr_arg.l_code3 = parent.dw_godown.getitemnumber(1, "gcode")
	if parent.cbx_allgodown.checked then
		parent.istr_arg.s_name3 = "Y"
	else
		parent.istr_arg.s_name3 = "N"
	end if
	parent.istr_arg.l_code4 = parent.dw_category.getitemnumber(1, "icatcode")
	if parent.cbx_allcategory.checked then
		parent.istr_arg.l_code4 = 0
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
