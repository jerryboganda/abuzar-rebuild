// window w_arg_godown_sinv_linv (reports)  ancestor: w_arguements

// w_arg_godown_sinv_linv.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_5 = create st_5
	this.dw_ranginvoice = create dw_ranginvoice
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_5
	this.control[icurrent + 3] = this.dw_ranginvoice

// w_arg_godown_sinv_linv.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_5
	destroy this.dw_ranginvoice

// w_arg_godown_sinv_linv.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_ranginvoice.insertrow(0)
	return ::message.returnvalue

// w_arg_godown_sinv_linv.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code3 = parent.dw_control.getitemnumber(1, "gcode")
	if isnull(parent.istr_arg.l_code3) then
		parent.istr_arg.l_code3 = 0
	end if
	if parent.cbx_hide.checked = true then
		parent.istr_arg.l_code4 = 1
	else
		parent.istr_arg.l_code4 = 0
	end if
	parent.dw_ranginvoice.accepttext()
	parent.istr_arg.l_code1 = parent.dw_ranginvoice.getitemnumber(1, "sinvcode")
	parent.istr_arg.l_code2 = parent.dw_ranginvoice.getitemnumber(1, "linvcode")
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_ranginvoice.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
