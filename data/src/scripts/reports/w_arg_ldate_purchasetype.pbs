// window w_arg_ldate_purchasetype (reports)  ancestor: w_listarguments

// w_arg_ldate_purchasetype.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8

// w_arg_ldate_purchasetype.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.st_8

// w_arg_ldate_purchasetype.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("purtypecode", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	this.dw_control.setitem(this.dw_control.getrow(), "purtypecode", this.idc_categories.getitemnumber(this.idc_categories.getrow(), "purtypecode"))
	this.lb_categories.setfocus()
	this.lb_categories.selectitem(1)
	return ::message.returnvalue
