// window w_arg_diseases_diseasetype (reports)  ancestor: w_listarguments

// w_arg_diseases_diseasetype.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8

// w_arg_diseases_diseasetype.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.st_8

// w_arg_diseases_diseasetype.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	integer ll_code
	ancestorreturnvalue = super::open()
	ll_code = message.doubleparm
	if ll_code > 0 then
		this.dw_control.settransobject(sqlca)
		this.idc_categories.settransobject(sqlca)
		rtncode = this.dw_control.getchild("diseasecode", this.idc_categories)
		if rtncode = -1 then
			messagebox("Error", "Not a DataWindowChild")
		end if
		this.idc_categories.retrieve(ll_code)
		this.dw_control.insertrow(0)
		this.dw_control.scrolltorow(0)
		ll_rowcount = this.idc_categories.rowcount()
		for ll_counter = 1 to ll_rowcount
			this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
		next
	else
		messagebox("Disease Tyoe", "Not a valid Disease Type Selected", stopsign!)
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue
