// window w_arg_customerservicetemplate_posted (reports)  ancestor: w_arguements

// w_arg_customerservicetemplate_posted.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_godown = create st_godown
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_godown

// w_arg_customerservicetemplate_posted.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_godown

// w_arg_customerservicetemplate_posted.open() returns long [event]
	long ancestorreturnvalue
	integer li_rtcode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	li_rtcode = this.dw_control.getchild("customerservicetemplatecode", this.idc_child)
	if li_rtcode = -1 then
		messagebox("Problem", "Can Not a Retrieve Possible Service Templte")
		close(this)
		return ::message.returnvalue
	end if
	this.idc_child.settransobject(sqlca)
	this.idc_child.retrieve()
	this.dw_control.insertrow(0)
	this.dw_control.setrow(0)
	this.dw_control.scrolltorow(0)
	this.idc_child.setrow(1)
	return ::message.returnvalue

// w_arg_customerservicetemplate_posted.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "customerservicetemplatecode")
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
