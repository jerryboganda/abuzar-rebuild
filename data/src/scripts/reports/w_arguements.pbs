// window w_arguements (reports)  ancestor: window

// w_arguements.create() returns 0
	this.dw_price = create dw_price
	this.rb_purprice = create rb_purprice
	this.rb_saleprice = create rb_saleprice
	this.cbx_hide = create cbx_hide
	this.cbx_supress = create cbx_supress
	this.st_3 = create st_3
	this.dw_control = create dw_control
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.st_2 = create st_2
	this.st_1 = create st_1
	this.em_enddate = create em_enddate
	this.em_startdate = create em_startdate
	this.gb_1 = create gb_1
	this.control = {this.dw_price, this.rb_purprice, this.rb_saleprice, this.cbx_hide, this.cbx_supress, this.st_3, this.dw_control, this.cb_cancel, this.cb_ok, this.st_2, this.st_1, this.em_enddate, this.em_startdate, this.gb_1}

// w_arguements.destroy() returns 0
	destroy this.dw_price
	destroy this.rb_purprice
	destroy this.rb_saleprice
	destroy this.cbx_hide
	destroy this.cbx_supress
	destroy this.st_3
	destroy this.dw_control
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.st_2
	destroy this.st_1
	destroy this.em_enddate
	destroy this.em_startdate
	destroy this.gb_1

// w_arguements.open() returns long
	string ls_text
	date ld_currdate
	time lt_currtime
	datetime ld_startdate
	datetime ld_enddate
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	ld_currdate = today()
	if f_stringpreferences("ApplyArgSDate") = "N" then
		ls_text = string(ld_currdate, "dd/mm/yyyy")
		ls_text = trim(ls_text) + " 00:00:00"
	else
		ls_text = string(f_datepreferences("DefaultArgSDate"), "dd/mm/yyyy hh:mm:ss")
	end if
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.em_enddate.text = ls_text
	return ::message.returnvalue

// cbx_hide.keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// cbx_supress.keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// dw_control.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// cb_cancel.ue_keypresed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	string ls_enddate
	date ld_date
	parent.em_enddate.getdata(ls_enddate)
	ld_date = date(ls_enddate)
	if parent.dw_control.accepttext() = 1 then
		parent.dw_control.setfocus()
	end if
	return ::message.returnvalue

// em_enddate.keydown(keycode key, unsignedlong keyflags) returns long
	string ls_date
	string ls_temp
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	if key = keyf4! then
		ls_temp = this.text
		ls_date = left(ls_temp, 10)
		openwithparm(w_calendar, ls_date)
		ls_date = message.stringparm
		if not (ls_date = "" or isnull(ls_date)) then
			ls_temp = ls_date + " " + right(ls_temp, 8)
			this.text = ls_temp
		end if
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// em_startdate.keydown(keycode key, unsignedlong keyflags) returns long
	string ls_date
	string ls_temp
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	if key = keyf4! then
		ls_temp = this.text
		ls_date = left(ls_temp, 10)
		openwithparm(w_calendar, ls_date)
		ls_date = message.stringparm
		if not (ls_date = "" or isnull(ls_date)) then
			ls_temp = ls_date + " " + right(ls_temp, 8)
			this.text = ls_temp
		end if
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue
