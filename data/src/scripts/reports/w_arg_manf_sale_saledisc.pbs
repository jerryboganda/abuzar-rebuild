// window w_arg_manf_sale_saledisc (reports)  ancestor: w_listarguments

// w_arg_manf_sale_saledisc.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.em_day = create em_day
	this.st_9 = create st_9
	this.dw_disc = create dw_disc
	this.st_10 = create st_10
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.em_day
	this.control[icurrent + 4] = this.st_9
	this.control[icurrent + 5] = this.dw_disc
	this.control[icurrent + 6] = this.st_10

// w_arg_manf_sale_saledisc.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.em_day
	destroy this.st_9
	destroy this.dw_disc
	destroy this.st_10

// w_arg_manf_sale_saledisc.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_price.settransobject(sqlca)
	this.dw_price.insertrow(0)
	this.dw_price.scrolltorow(0)
	this.dw_disc.settransobject(sqlca)
	this.dw_disc.insertrow(0)
	this.dw_disc.scrolltorow(0)
	rtncode = this.dw_control.getchild("manufacturers", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	return ::message.returnvalue
