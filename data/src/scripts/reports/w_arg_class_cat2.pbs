// window w_arg_class_cat2 (reports)  ancestor: w_arguements

// w_arg_class_cat2.create() returns 0 [event]
	call super::create

// w_arg_class_cat2.destroy() returns 0 [event]
	call super::destroy

// w_arg_class_cat2.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_class_cat2.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "icatcode")
	parent.istr_arg.l_code2 = parent.dw_control.getitemnumber(1, "iccode")
	if parent.rb_saleprice.checked then
		parent.istr_arg.s_name1 = "s"
	else
		parent.istr_arg.s_name1 = "p"
	end if
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
