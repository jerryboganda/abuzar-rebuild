// window w_arg_sdate_ldate_adj (reports)  ancestor: w_arguements

// w_arg_sdate_ldate_adj.create() returns 0 [event]
	integer icurrent
	call super::create
	this.cbx_increase = create cbx_increase
	this.cbx_decrease = create cbx_decrease
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_increase
	this.control[icurrent + 2] = this.cbx_decrease

// w_arg_sdate_ldate_adj.destroy() returns 0 [event]
	call super::destroy
	destroy this.cbx_increase
	destroy this.cbx_decrease

// w_arg_sdate_ldate_adj.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if parent.cbx_increase.checked = true then
		parent.istr_arg.ia_integerlist[1] = 1
	else
		parent.istr_arg.ia_integerlist[1] = -1
	end if
	if parent.cbx_decrease.checked = true then
		parent.istr_arg.ia_integerlist[2] = 2
	else
		parent.istr_arg.ia_integerlist[2] = -1
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
