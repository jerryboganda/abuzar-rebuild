// window w_arg_sdate_ldate_custcat (reports)  ancestor: w_arguements

// w_arg_sdate_ldate_custcat.create() returns 0 [event]
	integer icurrent
	call super::create
	this.gb_2 = create gb_2
	this.dw_customercategory = create dw_customercategory
	this.st_5 = create st_5
	this.dw_pagesize = create dw_pagesize
	this.st_4 = create st_4
	this.st_6 = create st_6
	this.st_7 = create st_7
	this.sle_terms1 = create sle_terms1
	this.sle_terms2 = create sle_terms2
	this.sle_caption = create sle_caption
	this.em_discperc = create em_discperc
	this.cbx_all = create cbx_all
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_2
	this.control[icurrent + 2] = this.dw_customercategory
	this.control[icurrent + 3] = this.st_5
	this.control[icurrent + 4] = this.dw_pagesize
	this.control[icurrent + 5] = this.st_4
	this.control[icurrent + 6] = this.st_6
	this.control[icurrent + 7] = this.st_7
	this.control[icurrent + 8] = this.sle_terms1
	this.control[icurrent + 9] = this.sle_terms2
	this.control[icurrent + 10] = this.sle_caption
	this.control[icurrent + 11] = this.em_discperc
	this.control[icurrent + 12] = this.cbx_all

// w_arg_sdate_ldate_custcat.destroy() returns 0 [event]
	call super::destroy
	destroy this.gb_2
	destroy this.dw_customercategory
	destroy this.st_5
	destroy this.dw_pagesize
	destroy this.st_4
	destroy this.st_6
	destroy this.st_7
	destroy this.sle_terms1
	destroy this.sle_terms2
	destroy this.sle_caption
	destroy this.em_discperc
	destroy this.cbx_all

// w_arg_sdate_ldate_custcat.open() returns long [event]
	long ancestorreturnvalue
	long rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_customercategory.settransobject(sqlca)
	this.dw_customercategory.insertrow(0)
	this.dw_customercategory.scrolltorow(0)
	rtncode = this.dw_customercategory.getchild("custcatcode", this.idc_custcategory)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	this.dw_pagesize.settransobject(sqlca)
	this.dw_pagesize.insertrow(0)
	this.dw_pagesize.scrolltorow(0)
	return ::message.returnvalue

// w_arg_sdate_ldate_custcat.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_counter = 1
	datastore lds_cust
	ancestorreturnvalue = super::clicked()
	lds_cust = create datastore
	lds_cust.dataobject = "ddd_customer"
	lds_cust.settransobject(sqlca)
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.dw_customercategory.accepttext()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_custcategory.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_custcategory.getitemnumber(ll_counter, "custcatcode")
		next
	else
		parent.istr_arg.ia_integerlist[1] = parent.dw_customercategory.getitemnumber(1, "custcatcode")
	end if
	parent.istr_arg.l_code1 = parent.dw_customercategory.getitemnumber(1, "custcatcode")
	parent.em_discperc.getdata(parent.istr_arg.db_code1)
	parent.istr_arg.s_name1 = parent.sle_caption.text
	parent.istr_arg.s_name2 = parent.sle_terms1.text
	parent.istr_arg.s_name3 = parent.sle_terms2.text
	if isnull(parent.istr_arg.l_code1) then
		parent.istr_arg.l_code1 = 0
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_customercategory.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_customercategory.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	return ::message.returnvalue

// dw_pagesize.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// sle_terms1.downkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// sle_terms2.keydown(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// sle_caption.downkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_discperc.downkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
