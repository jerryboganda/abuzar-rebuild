// window w_arg_invcode_percent (reports)  ancestor: w_arguements

// w_arg_invcode_percent.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.em_perc = create em_perc
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.em_perc

// w_arg_invcode_percent.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.em_perc

// w_arg_invcode_percent.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_invcode_percent.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.i_status = -1
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "invcode")
	parent.em_perc.getdata(parent.istr_arg.db_code1)
	if parent.cbx_supress.checked then
		parent.istr_arg.s_name2 = "Y"
	else
		parent.istr_arg.s_name2 = "N"
	end if
	if parent.cbx_hide.checked then
		parent.istr_arg.s_name3 = "Y"
	else
		parent.istr_arg.s_name3 = "N"
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// em_perc.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
