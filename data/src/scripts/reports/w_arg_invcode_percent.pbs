// window w_arg_invcode_percent (reports)  ancestor: w_arguements

// w_arg_invcode_percent.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.em_perc = create em_perc
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.em_perc

// w_arg_invcode_percent.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.em_perc

// w_arg_invcode_percent.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_invcode_percent.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// em_perc.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
