// window w_arg_sdate_ldate_postunpost_dateoption (reports)  ancestor: w_arguements

// w_arg_sdate_ldate_postunpost_dateoption.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.cbx_posted = create cbx_posted
	this.cbx_unposted = create cbx_unposted
	this.rb_issuedate = create rb_issuedate
	this.rb_duedate = create rb_duedate
	this.rb_postdate = create rb_postdate
	this.gb_date = create gb_date
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.cbx_posted
	this.control[icurrent + 3] = this.cbx_unposted
	this.control[icurrent + 4] = this.rb_issuedate
	this.control[icurrent + 5] = this.rb_duedate
	this.control[icurrent + 6] = this.rb_postdate
	this.control[icurrent + 7] = this.gb_date

// w_arg_sdate_ldate_postunpost_dateoption.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.cbx_posted
	destroy this.cbx_unposted
	destroy this.rb_issuedate
	destroy this.rb_duedate
	destroy this.rb_postdate
	destroy this.gb_date

// w_arg_sdate_ldate_postunpost_dateoption.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if parent.cbx_posted.checked and parent.cbx_unposted.checked then
		parent.istr_arg.s_name1 = "B"
	elseif parent.cbx_posted.checked = false and parent.cbx_unposted.checked then
		parent.istr_arg.s_name1 = "N"
	elseif parent.cbx_posted.checked and parent.cbx_unposted.checked = false then
		parent.istr_arg.s_name1 = "Y"
	else
		parent.istr_arg.s_name1 = "X"
	end if
	if parent.rb_issuedate.checked = true then
		parent.istr_arg.s_name2 = "ISSUEDATE"
	elseif parent.rb_duedate.checked = true then
		parent.istr_arg.s_name2 = "DUEDATE"
	else
		parent.istr_arg.s_name2 = "POSTDATE"
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
