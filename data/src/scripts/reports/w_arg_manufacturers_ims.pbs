// window w_arg_manufacturers_ims (reports)  ancestor: w_listarguments

// w_arg_manufacturers_ims.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.cbx_prod = create cbx_prod
	this.cbx_cust = create cbx_cust
	this.cbx_transale = create cbx_transale
	this.cbx_transr = create cbx_transr
	this.cbx_transalebns = create cbx_transalebns
	this.cbx_transrbns = create cbx_transrbns
	this.cbx_salval = create cbx_salval
	this.cbx_srval = create cbx_srval
	this.cb_prod = create cb_prod
	this.cb_transale = create cb_transale
	this.cb_cust = create cb_cust
	this.cb_transalebns = create cb_transalebns
	this.cb_transr = create cb_transr
	this.cb_transrbns = create cb_transrbns
	this.cb_salval = create cb_salval
	this.cb_srval = create cb_srval
	this.cbx_dissal = create cbx_dissal
	this.cb_dissal = create cb_dissal
	this.cbx_dissr = create cbx_dissr
	this.cb_dissr = create cb_dissr
	this.gb_txt = create gb_txt
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.cbx_prod
	this.control[icurrent + 4] = this.cbx_cust
	this.control[icurrent + 5] = this.cbx_transale
	this.control[icurrent + 6] = this.cbx_transr
	this.control[icurrent + 7] = this.cbx_transalebns
	this.control[icurrent + 8] = this.cbx_transrbns
	this.control[icurrent + 9] = this.cbx_salval
	this.control[icurrent + 10] = this.cbx_srval
	this.control[icurrent + 11] = this.cb_prod
	this.control[icurrent + 12] = this.cb_transale
	this.control[icurrent + 13] = this.cb_cust
	this.control[icurrent + 14] = this.cb_transalebns
	this.control[icurrent + 15] = this.cb_transr
	this.control[icurrent + 16] = this.cb_transrbns
	this.control[icurrent + 17] = this.cb_salval
	this.control[icurrent + 18] = this.cb_srval
	this.control[icurrent + 19] = this.cbx_dissal
	this.control[icurrent + 20] = this.cb_dissal
	this.control[icurrent + 21] = this.cbx_dissr
	this.control[icurrent + 22] = this.cb_dissr
	this.control[icurrent + 23] = this.gb_txt

// w_arg_manufacturers_ims.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.cbx_prod
	destroy this.cbx_cust
	destroy this.cbx_transale
	destroy this.cbx_transr
	destroy this.cbx_transalebns
	destroy this.cbx_transrbns
	destroy this.cbx_salval
	destroy this.cbx_srval
	destroy this.cb_prod
	destroy this.cb_transale
	destroy this.cb_cust
	destroy this.cb_transalebns
	destroy this.cb_transr
	destroy this.cb_transrbns
	destroy this.cb_salval
	destroy this.cb_srval
	destroy this.cbx_dissal
	destroy this.cb_dissal
	destroy this.cbx_dissr
	destroy this.cb_dissr
	destroy this.gb_txt

// w_arg_manufacturers_ims.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	if f_rightexists(1329) then
		open(w_select_general_crs)
		this.il_scope = message.doubleparm
	end if
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_price.settransobject(sqlca)
	this.dw_price.insertrow(0)
	this.dw_price.scrolltorow(0)
	rtncode = this.dw_control.getchild("manufacturers", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	this.is_prod = trim(f_stringpreferences("OutputFilePath")) + "PROD.TXT"
	this.is_cust = trim(f_stringpreferences("OutputFilePath")) + "CUST.TXT"
	this.is_transale = trim(f_stringpreferences("OutputFilePath")) + "TRAN.TXT"
	this.is_transalebns = trim(f_stringpreferences("OutputFilePath")) + "TRANBONUS.TXT"
	this.is_transr = trim(f_stringpreferences("OutputFilePath")) + "TRANRET.TXT"
	this.is_transrbns = trim(f_stringpreferences("OutputFilePath")) + "TRANBRET.TXT"
	this.is_salval = trim(f_stringpreferences("OutputFilePath")) + "VALUE.TXT"
	this.is_srval = trim(f_stringpreferences("OutputFilePath")) + "VALUERET.TXT"
	this.is_dissal = trim(f_stringpreferences("OutputFilePath")) + "DATES.TXT"
	this.is_dissr = trim(f_stringpreferences("OutputFilePath")) + "DATESRET.TXT"
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_prod.clicked() returns long
	string ls_named
	integer li_value
	li_value = getfilesavename("Select File Location", parent.is_prod, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
	return ::message.returnvalue

