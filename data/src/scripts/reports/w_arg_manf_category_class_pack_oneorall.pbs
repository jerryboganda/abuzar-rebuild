// window w_arg_manf_category_class_pack_oneorall (reports)  ancestor: w_arguements

// w_arg_manf_category_class_pack_oneorall.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_gcode = create st_gcode
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_gcode

// w_arg_manf_category_class_pack_oneorall.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_gcode

// w_arg_manf_category_class_pack_oneorall.open() returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.retrieve()
	this.dw_control.scrolltorow(0)
	ll_retcode = this.dw_control.getchild("manfcode", this.idc_manf)
	this.idc_manf.settransobject(sqlca)
	this.idc_manf.retrieve()
	ll_retcode = this.dw_control.getchild("icatcode", this.idc_cat)
	this.idc_cat.settransobject(sqlca)
	this.idc_cat.retrieve()
	ll_retcode = this.dw_control.getchild("iccode", this.idc_class)
	this.idc_class.settransobject(sqlca)
	this.idc_class.retrieve()
	ll_retcode = this.dw_control.getchild("packcode", this.idc_pack)
	this.idc_pack.settransobject(sqlca)
	this.idc_pack.retrieve()
	return ::message.returnvalue

// w_arg_manf_category_class_pack_oneorall.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.i_status = -1
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "manfcode")
	parent.istr_arg.l_code2 = parent.dw_control.getitemnumber(1, "icatcode")
	parent.istr_arg.l_code3 = parent.dw_control.getitemnumber(1, "iccode")
	parent.istr_arg.l_code4 = parent.dw_control.getitemnumber(1, "packcode")
	parent.istr_arg.l_code5 = parent.dw_control.getitemnumber(1, "allmanf")
	if parent.istr_arg.l_code5 = 1 then
		for ll_counter = 1 to parent.idc_manf.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_manf.getitemnumber(ll_counter, "code")
		next
	else
		parent.istr_arg.ia_integerlist[1] = parent.istr_arg.l_code1
	end if
	parent.istr_arg.l_code6 = parent.dw_control.getitemnumber(1, "allcat")
	if parent.istr_arg.l_code6 = 1 then
		for ll_counter = 1 to parent.idc_cat.rowcount()
			parent.istr_arg.ia_integerlist1[ll_counter] = parent.idc_cat.getitemnumber(ll_counter, "icatcode")
		next
	else
		parent.istr_arg.ia_integerlist1[1] = parent.istr_arg.l_code2
	end if
	parent.istr_arg.l_code7 = parent.dw_control.getitemnumber(1, "allclass")
	if parent.istr_arg.l_code7 = 1 then
		for ll_counter = 1 to parent.idc_class.rowcount()
			parent.istr_arg.ia_integerlist2[ll_counter] = parent.idc_class.getitemnumber(ll_counter, "iccode")
		next
	else
		parent.istr_arg.ia_integerlist2[1] = parent.istr_arg.l_code3
	end if
	parent.istr_arg.l_code8 = parent.dw_control.getitemnumber(1, "allpack")
	if parent.istr_arg.l_code8 = 1 then
		for ll_counter = 1 to parent.idc_pack.rowcount()
			parent.istr_arg.la_longlist[ll_counter] = parent.idc_pack.getitemnumber(ll_counter, "packcode")
		next
	else
		parent.istr_arg.la_longlist[1] = parent.istr_arg.l_code4
	end if
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
