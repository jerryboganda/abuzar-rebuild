// window w_arg_aging_customerwise (reports)  ancestor: w_listarguments

// w_arg_aging_customerwise.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.em_interval = create em_interval
	this.st_9 = create st_9
	this.st_10 = create st_10
	this.em_limit = create em_limit
	this.gb_5 = create gb_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.em_interval
	this.control[icurrent + 4] = this.st_9
	this.control[icurrent + 5] = this.st_10
	this.control[icurrent + 6] = this.em_limit
	this.control[icurrent + 7] = this.gb_5

// w_arg_aging_customerwise.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.em_interval
	destroy this.st_9
	destroy this.st_10
	destroy this.em_limit
	destroy this.gb_5

// w_arg_aging_customerwise.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	listviewitem l_lvi
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("custcode", this.idc_categories)
	this.em_startdate.text = string(today(), "dd/mm/yyyy hh:mm:ss")
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "customer_name"))
	next
	return ::message.returnvalue
