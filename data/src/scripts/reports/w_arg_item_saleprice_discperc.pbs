// window w_arg_item_saleprice_discperc (reports)  ancestor: w_popup_forselection_walias

// w_arg_item_saleprice_discperc.wf_inititem(long al_code) returns boolean
	long ll_counter
	long ll_detailrows
	double ld_saleprice
	double ld_discperc
	ll_detailrows = this.id_selectionlist.rowcount()
	for ll_counter = 1 to ll_detailrows
		if al_code = this.id_selectionlist.getitemnumber(ll_counter, "code") then
			this.id_selected.setitem(this.id_selected.getrow(), "name", this.id_selectionlist.getitemstring(ll_counter, "name"))
			SQL SELECT SalePrice / CASE WHEN PackUnits > 0 THEN Packunits ELSE 1 END , SaleDiscPerc INTO :ld_saleprice, :ld_discperc FROM Item WHERE Icode =:al_code USING sqlca;
			if sqlca.sqlcode = 0 then
				this.dw_price_disc.object.saleprice[1] = ld_saleprice
				this.dw_price_disc.object.discperc[1] = ld_discperc
			end if
			return true
		end if
	next
	return false

// w_arg_item_saleprice_discperc.wf_inititem(string as_aliasname) returns boolean
	long ll_counter
	long ll_detailrows
	long ll_found
	double ld_saleprice
	double ld_discperc
	ll_detailrows = this.id_selectionlist.rowcount()
	ll_found = this.id_selectionlist.find("lower(aliasname)='" + lower(as_aliasname) + "'", 1, ll_detailrows)
	if ll_found > 0 then
		this.id_selected.setitem(this.id_selected.getrow(), "code", this.id_selectionlist.getitemnumber(ll_found, "code"))
		this.id_selected.setitem(this.id_selected.getrow(), "aliasname", this.id_selectionlist.getitemstring(ll_found, "aliasname"))
		this.id_selected.setitem(this.id_selected.getrow(), "name", this.id_selectionlist.getitemstring(ll_found, "name"))
		SQL SELECT SalePrice / CASE WHEN PackUnits > 0 THEN Packunits ELSE 1 END , SaleDiscPerc INTO :ld_saleprice, :ld_discperc FROM Item WHERE CustomICode =:as_aliasname USING sqlca;
		if sqlca.sqlcode = 0 then
			this.dw_price_disc.object.saleprice[1] = ld_saleprice
			this.dw_price_disc.object.discperc[1] = ld_discperc
		end if
		return true
	end if
	return false

// w_arg_item_saleprice_discperc.create() returns 0 [event]
	integer icurrent
	call super::create
	this.gb_2 = create gb_2
	this.st_1 = create st_1
	this.st_2 = create st_2
	this.em_startdate = create em_startdate
	this.em_enddate = create em_enddate
	this.dw_price_disc = create dw_price_disc
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_2
	this.control[icurrent + 2] = this.st_1
	this.control[icurrent + 3] = this.st_2
	this.control[icurrent + 4] = this.em_startdate
	this.control[icurrent + 5] = this.em_enddate
	this.control[icurrent + 6] = this.dw_price_disc

// w_arg_item_saleprice_discperc.destroy() returns 0 [event]
	call super::destroy
	destroy this.gb_2
	destroy this.st_1
	destroy this.st_2
	destroy this.em_startdate
	destroy this.em_enddate
	destroy this.dw_price_disc

// w_arg_item_saleprice_discperc.open() returns long [event]
	long ancestorreturnvalue
	date ld_currdate
	string ls_text
	ancestorreturnvalue = super::open()
	gd_itemsinfo.sharedata(this.id_selectionlist)
	ld_currdate = today()
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 00:00:00"
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.em_enddate.text = ls_text
	this.dw_price_disc.settransobject(sqlca)
	this.dw_price_disc.insertrow(0)
	return ::message.returnvalue

// w_arg_item_saleprice_discperc.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// dw_selected.itemchanged(long row, dwobject dwo, string data) returns long [event]
	integer li_qty
	long ll_icode
	long ll_null
	long ll_gcode
	string ls_itemname
	string ls_null
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case "aliasname"
		if parent.wf_inititem(data) = false then
			messagebox("Validation", "AliasName does not exist.~r~nPlease try some other AliasName.")
			setitem(row, "code", ll_null)
			setitem(row, "aliasname", ls_null)
			setitem(row, "name", ls_null)
			return 1
		end if
		parent.ib_itemvalidated = false
	case "name"
		setitem(row, "code", parent.id_selectionlist.getitemnumber(parent.id_selectionlist.getrow(), "code"))
		setitem(row, "aliasname", parent.id_selectionlist.getitemstring(parent.id_selectionlist.getrow(), "aliasname"))
		setitem(row, "name", parent.id_selectionlist.getitemstring(parent.id_selectionlist.getrow(), "name"))
		parent.ib_itemvalidated = false
		if row > 0 then
			parent.wf_inititem(this.object.code[row])
		end if
		return 2
	end choose
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.id_selected.getitemnumber(1, "code")
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.dw_price_disc.accepttext()
	parent.istr_arg.db_code1 = parent.dw_price_disc.object.saleprice[1]
	parent.istr_arg.db_code2 = parent.dw_price_disc.object.discperc[1]
	parent.istr_arg.i_status = 1
	return ::message.returnvalue

// em_startdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_enddate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// dw_price_disc.getfocus() returns long [event]
	selecttext(1, len(gettext()))
	if parent.id_selected.rowcount() > 0 then
		parent.wf_inititem(parent.id_selected.object.code[parent.id_selected.rowcount()])
	end if
	return ::message.returnvalue
