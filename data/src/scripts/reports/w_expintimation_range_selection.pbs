// window w_expintimation_range_selection (reports)  ancestor: window

// w_expintimation_range_selection.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		post event ue_close()
	end if
	return ::message.returnvalue

// w_expintimation_range_selection.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// w_expintimation_range_selection.wf_assigndwobjects(string as_masterdw, string as_detaildw, string as_footerdw) returns 0
	this.dw_master.dataobject = as_masterdw
	this.dw_detail.dataobject = as_detaildw
	this.dw_footer.dataobject = as_footerdw
	this.dw_master.settransobject(sqlca)
	this.dw_detail.settransobject(sqlca)
	this.dw_footer.settransobject(sqlca)

// w_expintimation_range_selection.create() returns 0 [event]
	this.cb_cancel = create cb_cancel
	this.dw_footer = create dw_footer
	this.dw_master = create dw_master
	this.cb_retrieve = create cb_retrieve
	this.cb_ok = create cb_ok
	this.dw_detail = create dw_detail
	this.control = {this.cb_cancel, this.dw_footer, this.dw_master, this.cb_retrieve, this.cb_ok, this.dw_detail}

// w_expintimation_range_selection.destroy() returns 0 [event]
	destroy this.cb_cancel
	destroy this.dw_footer
	destroy this.dw_master
	destroy this.cb_retrieve
	destroy this.cb_ok
	destroy this.dw_detail

// w_expintimation_range_selection.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_custcode
	string ls_date
	this.il_type = message.doubleparm
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	wf_assigndwobjects("d_expintimation_range_selection", "d_expiryintimation_range_list", "")
	this.dw_master.insertrow(0)
	this.dw_master.scrolltorow(0)
	this.dw_master.setcolumn("startingno")
	this.dw_master.setfocus()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.istr_arg.i_status = -1
	parent.post event ue_close()
	return ::message.returnvalue

// dw_master.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// cb_retrieve.clicked() returns long [event]
	string ls_filter
	datetime ldt_stardate
	datetime ldt_enddate
	long ll_masterrow
	long ll_custcode
	long ll_null
	long ll_startno
	long ll_endno
	setnull(ll_null)
	parent.dw_master.accepttext()
	ll_masterrow = parent.dw_master.getrow()
	if ll_masterrow > 0 then
		ll_startno = parent.dw_master.getitemnumber(ll_masterrow, "startingno")
		ll_endno = parent.dw_master.getitemnumber(ll_masterrow, "endingno")
	end if
	if ll_startno <= ll_endno then
		parent.dw_detail.retrieve(ll_startno, ll_endno, parent.il_type)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long[] ll_invcode
	long ll_rowcount
	long ll_counter
	long ll_arrindex
	long ll_thiscode
	boolean lb_flag
	string ls_date
	parent.istr_arg.l_code1 = parent.dw_master.getitemnumber(parent.dw_master.getrow(), "custcode")
	ll_rowcount = parent.dw_detail.rowcount()
	for ll_counter = 1 to ll_rowcount
		if parent.dw_detail.getitemstring(ll_counter, "selected") = "Y" then
			lb_flag = true
			ll_arrindex = ll_arrindex + 1
			ls_date = string(date(parent.dw_detail.getitemdatetime(ll_counter, "date")), "dd/mm/yyyy")
			ll_thiscode = parent.dw_detail.getitemnumber(ll_counter, "intimationcode")
			parent.istr_arg.ia_integerlist[ll_arrindex] = ll_thiscode
		end if
	next
	if lb_flag then
		parent.istr_arg.i_status = 1
		parent.istr_arg.l_code1 = parent.dw_master.object.startingno[1]
		parent.istr_arg.l_code2 = parent.dw_master.object.endingno[1]
		parent.istr_arg.l_code3 = parent.dw_master.object.suppcode[1]
		parent.istr_arg.l_code4 = parent.dw_master.object.custcode[1]
	else
		messagebox("Expiry Intimation Selection", "Please retrieve and select some valid Expiry Intimation", stopsign!)
		return ::message.returnvalue
	end if
	parent.post event ue_close()
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
