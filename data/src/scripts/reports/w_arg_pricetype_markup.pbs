// window w_arg_pricetype_markup (reports)  ancestor: w_arguements

// w_arg_pricetype_markup.create() returns 0
	call super::create

// w_arg_pricetype_markup.destroy() returns 0
	call super::destroy

// w_arg_pricetype_markup.open() returns long
	long ancestorreturnvalue
	long ll_groupcode
	long ll_retcode
	ancestorreturnvalue = super::open()
	ll_groupcode = f_getgroupcode(gl_usercode)
	ll_retcode = this.dw_control.getchild("pricetypecode", this.idc_module)
	if ll_retcode = -1 then
		messagebox("Error", "Not a DataWindowChild")
		close(this)
		return ::message.returnvalue
	end if
	this.idc_module.settransobject(sqlca)
	this.idc_module.retrieve(1, ll_groupcode)
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	if this.idc_module.rowcount() > 0 then
		this.dw_control.object.pricetypecode[1] = this.idc_module.getitemnumber(1, "PriceTypeCode")
	end if
	return ::message.returnvalue

// w_arg_pricetype_markup.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)
