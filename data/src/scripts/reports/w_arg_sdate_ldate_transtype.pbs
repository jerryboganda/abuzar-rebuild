// window w_arg_sdate_ldate_transtype (reports)  ancestor: w_arguements

// w_arg_sdate_ldate_transtype.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.gb_2 = create gb_2
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.gb_2

// w_arg_sdate_ldate_transtype.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.gb_2

// w_arg_sdate_ldate_transtype.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// w_arg_sdate_ldate_transtype.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if parent.dw_control.getitemnumber(1, "VOCHCATCODE") > 0.0 and not isnull(parent.dw_control.getitemnumber(1, "VOCHCATCODE")) then
		parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "VOCHCATCODE")
	else
		messagebox("Voucher Category Validation!", "Please Select Valid Voucher Category", information!)
		return ::message.returnvalue
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
