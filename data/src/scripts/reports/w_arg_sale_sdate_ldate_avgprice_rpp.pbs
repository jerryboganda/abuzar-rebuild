// window w_arg_sale_sdate_ldate_avgprice_rpp (reports)  ancestor: w_arguements

// w_arg_sale_sdate_ldate_avgprice_rpp.create() returns 0 [event]
	integer icurrent
	call super::create
	this.cbx_cash = create cbx_cash
	this.cbx_credit = create cbx_credit
	this.st_4 = create st_4
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_cash
	this.control[icurrent + 2] = this.cbx_credit
	this.control[icurrent + 3] = this.st_4

// w_arg_sale_sdate_ldate_avgprice_rpp.destroy() returns 0 [event]
	call super::destroy
	destroy this.cbx_cash
	destroy this.cbx_credit
	destroy this.st_4

// w_arg_sale_sdate_ldate_avgprice_rpp.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// w_arg_sale_sdate_ldate_avgprice_rpp.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_price.settransobject(sqlca)
	this.dw_price.insertrow(0)
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if parent.cbx_cash.checked then
		parent.istr_arg.ia_integerlist[3] = 3
		parent.istr_arg.ia_integerlist[6] = 8
	end if
	if parent.cbx_credit.checked then
		parent.istr_arg.ia_integerlist[2] = 2
		parent.istr_arg.ia_integerlist[1] = 1
		parent.istr_arg.ia_integerlist[4] = 6
		parent.istr_arg.ia_integerlist[5] = 7
	end if
	parent.istr_arg.i_status = 1
	parent.istr_arg.l_code1 = parent.dw_price.object.price[1]
	parent.post event ue_close(1)
	return ::message.returnvalue
