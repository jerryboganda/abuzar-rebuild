// window w_arg_salesman_manf_active_inactive (reports)  ancestor: w_listarguments

// w_arg_salesman_manf_active_inactive.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.rb_all = create rb_all
	this.rb_active = create rb_active
	this.rb_inactive = create rb_inactive
	this.st_9 = create st_9
	this.dw_control2 = create dw_control2
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.rb_all
	this.control[icurrent + 4] = this.rb_active
	this.control[icurrent + 5] = this.rb_inactive
	this.control[icurrent + 6] = this.st_9
	this.control[icurrent + 7] = this.dw_control2

// w_arg_salesman_manf_active_inactive.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.rb_all
	destroy this.rb_active
	destroy this.rb_inactive
	destroy this.st_9
	destroy this.dw_control2

// w_arg_salesman_manf_active_inactive.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	rtncode = this.dw_control.getchild("salesman", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.insertrow(0)
	this.dw_control2.scrolltorow(0)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "salesmancode")
		next
	else
		for ll_counter = 1 to ll_counter
			ll_found = parent.idc_categories.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "salesmancode")
			end if
		next
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if parent.rb_active.checked then
		parent.istr_arg.s_name1 = "Y"
	elseif parent.rb_inactive.checked then
		parent.istr_arg.s_name1 = "N"
	else
		parent.istr_arg.s_name1 = "A"
	end if
	if isnull(parent.dw_control2.object.manfcode[1]) then
		messagebox("Manufacturer Validation", "Please Select some valid manufacturer", stopsign!)
		return ::message.returnvalue
	else
		parent.istr_arg.l_code1 = parent.dw_control2.object.manfcode[1]
	end if
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
