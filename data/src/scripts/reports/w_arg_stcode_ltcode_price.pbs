// window w_arg_stcode_ltcode_price (reports)  ancestor: w_arguements

// w_arg_stcode_ltcode_price.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_5 = create st_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_5

// w_arg_stcode_ltcode_price.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_5

// w_arg_stcode_ltcode_price.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_price.settransobject(sqlca)
	this.dw_price.insertrow(0)
	this.dw_price.scrolltorow(0)
	return ::message.returnvalue

// w_arg_stcode_ltcode_price.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// dw_price.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// dw_control.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "sinvcode"
		if isnull(long(data)) then
			messagebox("Starting Invoice No.", "Must Select a Starting Invoice Number")
			return 1
		end if
		if isnull(parent.dw_control.getitemnumber(row, "linvcode")) then
			parent.dw_control.setitem(row, "linvcode", long(data))
		end if
	case "linvcode"
		if isnull(long(data)) then
			messagebox("Last Invoice No.", "Must Select a Last Invoice Number")
			return 1
		elseif long(data) < parent.dw_control.getitemnumber(row, "sinvcode") then
			messagebox("Last Invoice No. Validation", "Last Invoice Number Must be greater or ~requal to starting invoice no.")
			return 1
		end if
	end choose
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "sinvcode")
	parent.istr_arg.l_code2 = parent.dw_control.getitemnumber(1, "linvcode")
	if parent.istr_arg.l_code1 > parent.istr_arg.l_code2 then
		messagebox("Last Invoice No. Validation", "Last Invoice Number Must be greater or ~requal to starting invoice no.")
		return 1
	end if
	parent.istr_arg.l_code3 = parent.dw_price.getitemnumber(1, "price")
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
