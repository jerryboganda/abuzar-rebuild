// window w_arg_schollbranch_sdate_ldate_age_total (reports)  ancestor: w_listarguments

// w_arg_schollbranch_sdate_ldate_age_total.create() returns 0
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.st_9 = create st_9
	this.em_age = create em_age
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.st_9
	this.control[icurrent + 4] = this.em_age

// w_arg_schollbranch_sdate_ldate_age_total.destroy() returns 0
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.st_9
	destroy this.em_age

// w_arg_schollbranch_sdate_ldate_age_total.open() returns long
	long ancestorreturnvalue
	string ls_stringparam
	string ls_filter
	long ll_counter
	long ll_rowcount
	integer rtncode
	listviewitem l_lvi
	ancestorreturnvalue = super::open()
	ls_stringparam = message.stringparm
	this.dw_control.settransobject(sqlca)
	rtncode = this.dw_control.retrieve()
	if rtncode = -1 then
		messagebox("Error", "No Scholl Branch(s) To Select")
	else
		ll_rowcount = this.dw_control.rowcount()
		ll_counter = 1
		for ll_counter = 1 to ll_rowcount
			this.lb_categories.additem(this.dw_control.getitemstring(ll_counter, "name"))
		next
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// em_age.ue_keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
