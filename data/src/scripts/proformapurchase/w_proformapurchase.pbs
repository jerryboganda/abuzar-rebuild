		lm_menu.m_file.m_populateandpostfromdatacarrydb.enabled = true
	else
		lm_menu.m_file.m_populateandpostfromdatacarrydb.visible = false
		lm_menu.m_file.m_populateandpostfromdatacarrydb.enabled = false
	end if
