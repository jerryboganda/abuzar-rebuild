	if this.id_master = getfocus() and this.id_master.rowcount() > 0 then
		ll_suppcode = this.id_master.getitemnumber(this.id_master.getrow(), "suppcode")
		openwithparm(w_supplierinfo, ll_suppcode)
	end if

// w_proformapurchase.wf_show_po_pur_disparity(integer ai_mode) returns long
	long ll_detailrows
	long ll_pocode
	long ll_masterrow
	long ll_count
	long ll_found
	long ll_retcode
	long ll_result = 1
	long ll_icode
	long[] ll_invcode
	datastore lds_po_disparity
	s_datastore lstr
	lds_po_disparity = create datastore
	lds_po_disparity.dataobject = "d_po_purchase_disparity"
	lds_po_disparity.settransobject(sqlca)
	if this.tab_retrieve.selectedtab = 2 then
		return ll_retcode
	end if
	ll_detailrows = this.id_detail.rowcount()
	ll_masterrow = this.id_master.rowcount()
	if ll_detailrows > 0 and ll_masterrow > 0 then
		ll_pocode = this.id_master.object.pocode[ll_masterrow]
		if isnull(ll_pocode) then
			return ll_retcode
		else
			ll_invcode[1] = ll_pocode
			lds_po_disparity.retrieve(ll_invcode, this.id_master.object.date[1], this.id_master.object.date[1])
			for ll_count = 1 to this.id_detail.rowcount()
				ll_icode = this.id_detail.object.icode[ll_count]
				if ll_icode > 0 then
					ll_found = lds_po_disparity.find("icode=" + trim(string(ll_icode)), 1, lds_po_disparity.rowcount())
					if ll_found = 0 then
						ll_found = lds_po_disparity.insertrow(0)
						lds_po_disparity.object.pocode[ll_found] = ll_pocode
						lds_po_disparity.object.date[ll_found] = lds_po_disparity.object.date[1]
						lds_po_disparity.object.remarks[ll_found] = lds_po_disparity.object.remarks[1]
						lds_po_disparity.object.suppcode[ll_found] = lds_po_disparity.object.suppcode[1]
						lds_po_disparity.object.supplieraliasname[ll_found] = lds_po_disparity.object.supplieraliasname[1]
						lds_po_disparity.object.suppliername[ll_found] = lds_po_disparity.object.suppliername[1]
						lds_po_disparity.object.icode[ll_found] = this.id_detail.object.icode[ll_count]
						lds_po_disparity.object.itemaliasname[ll_found] = this.id_detail.object.fullcode[ll_count]
						lds_po_disparity.object.itemname[ll_found] = this.id_detail.object.itemname[ll_count]
						lds_po_disparity.object.manufacturer[ll_found] = ""
						lds_po_disparity.object.poqty[ll_found] = 0
						lds_po_disparity.object.pobonus[ll_found] = 0
						lds_po_disparity.object.purqty[ll_found] = this.id_detail.object.packqty[ll_count]
						lds_po_disparity.object.purbonus[ll_found] = this.id_detail.object.bonusqty[ll_count]
						lds_po_disparity.object.netqty[ll_found] = -this.id_detail.object.packqty[ll_count]
						lds_po_disparity.object.netbonus[ll_found] = -this.id_detail.object.bonusqty[ll_count]
					else
						lds_po_disparity.object.purqty[ll_found] = lds_po_disparity.object.purqty[ll_found] + this.id_detail.object.packqty[ll_count]
						lds_po_disparity.object.purbonus[ll_found] = lds_po_disparity.object.purbonus[ll_found] + this.id_detail.object.bonusqty[ll_count]
						lds_po_disparity.object.netqty[ll_found] = lds_po_disparity.object.poqty[ll_found] - lds_po_disparity.object.purqty[ll_found]
						lds_po_disparity.object.netbonus[ll_found] = lds_po_disparity.object.pobonus[ll_found] - lds_po_disparity.object.purbonus[ll_found]
					end if
				end if
			next
			lds_po_disparity.setfilter("netqty <> 0 OR netbonus <> 0")
			lds_po_disparity.filter()
			lds_po_disparity.sort()
			lds_po_disparity.groupcalc()
			if lds_po_disparity.rowcount() > 0 then
				lstr.ds = lds_po_disparity
				lstr.s_name1 = "d_po_purchase_disparity"
				openwithparm(w_preview_invoices, lstr)
				lstr = message.powerobjectparm
				if ai_mode = 1 then
					ll_result = messagebox("P/O Based Purchase Disparity Checking", "P/O Based Purchase Disparity Checking Detected some Disparities~r~nContinue Saving?", question!, yesno!, 1)
					if ll_result = 1 then
						ll_retcode = 0
					else
						ll_retcode = 1
					end if
				end if
			end if
		end if
	end if
	destroy lds_po_disparity
	return ll_retcode

// w_proformapurchase.wf_populate_saleorder() returns long
	datastore lds_saleorderdetail
	datastore lds_saleorderheader
	s_saletemplate lstr_template
	boolean lb_enablesave
	boolean lb_insertrow
	integer li_retcode = 1
	integer li_errcode
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_counter
	long ll_tmprowid
	long ll_tmpcode
	long ll_icode
	long ll_packunits
	datetime ldt_date
	string ls_errortext
	string ls_batch
	string ls_class
	if wf_iseditable() = false then
		return 0
	end if
	lds_saleorderdetail = create datastore
	lds_saleorderheader = create datastore
	open(w_editsaleorder_in_purchase_form)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_saleorderdetail.dataobject = "d_SaleOrderdetail_retrieve"
		lds_saleorderdetail.settransobject(this.it_transobject)
		lds_saleorderheader.dataobject = "d_SaleOrderheader"
		lds_saleorderheader.settransobject(this.it_transobject)
		ll_row = lds_saleorderheader.retrieve(lstr_template.l_invtemplate)
		if ll_row <= 0 then
			li_retcode = -1
			return li_retcode
		else
			ll_mrow = this.id_master.getrow()
			this.id_master.setitem(ll_mrow, "remarks", lds_saleorderheader.getitemstring(lds_saleorderheader.getrow(), "remarks"))
			this.id_master.setitem(ll_mrow, "headerno", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "headerno"))
			this.id_footer.setitem(ll_mrow, "misccharges", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "misccharges"))
			this.id_footer.setitem(ll_mrow, "flatdisc", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "flatdisc"))
			this.id_footer.setitem(ll_mrow, "discperc", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "discperc"))
			ldt_date = lds_saleorderheader.getitemdatetime(lds_saleorderheader.getrow(), "date")
			lds_saleorderdetail.retrieve(lstr_template.l_invtemplate, 0)
		end if
		ll_totalrows = lds_saleorderdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		if lb_enablesave then
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
			this.id_detail.reset()
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				ll_rowcount = this.id_detail.insertrow(0)
				ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_saleorderdetail.getitemnumber(ll_counter, "gcode")), 1, this.idc_godown.rowcount())
				ll_icode = lds_saleorderdetail.getitemnumber(ll_counter, "icode")
				if wf_inititeminfo(ll_icode, ll_rowcount, ls_errortext) then
					ll_packunits = this.id_detail.object.packunits[ll_rowcount]
					if ll_packunits = 0 or isnull(ll_packunits) then
						ll_packunits = 1
					end if
					ll_gcode = lds_saleorderdetail.getitemnumber(ll_counter, "gcode")
					if lstr_template.i_invtype = 0 then
						this.id_detail.object.batch[ll_rowcount] = f_stringpreferences("defaultbatch")
					else
						SQL SELECT NAME INTO :ls_class FROM DBO.ItemClass WHERE ICCode IN ( SELECT ICCode FROM Item WHERE ICode =:ll_icode ) USING this.it_transobject;
						ll_tmpcode = lds_saleorderdetail.getitemnumber(ll_counter, "code")
						ls_batch = trim(string(ll_tmpcode)) + trim(string(ll_icode)) + ls_class
						this.id_detail.object.batch[ll_rowcount] = left(ls_batch, 10)
					end if
					this.id_detail.object.expiry[ll_rowcount] = lstr_template.d_date
					this.id_detail.setitem(ll_rowcount, "gcode", ll_gcode)
					this.id_detail.setitem(ll_rowcount, "discperc", lds_saleorderdetail.getitemnumber(ll_counter, "discperc"))
					if this.id_master.object.purcatcode[1] = 2 then
						this.id_detail.setitem(ll_rowcount, "packqty", ceiling(lds_saleorderdetail.getitemnumber(ll_counter, "looseqty") / ll_packunits))
						this.id_detail.setitem(ll_rowcount, "bonusqty", ceiling(lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty") / ll_packunits))
					else
						this.id_detail.setitem(ll_rowcount, "looseqty", lds_saleorderdetail.getitemnumber(ll_counter, "looseqty"))
						this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty"))
					end if
				end if
				wf_update_value_extax(ll_rowcount, this.id_detail.object.looseqty[ll_rowcount] + this.id_detail.object.packqty[ll_rowcount], this.id_detail.object.purprice[ll_rowcount], this.id_detail.object.discperc[ll_rowcount])
			next
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return li_retcode

// w_proformapurchase.wf_update_value_extax(long al_row, double ad_qty, double ad_price, double ad_discperc) returns long
	if al_row > 0 then
		this.id_detail.object.valueextax[al_row] = ad_qty * ad_price * (1.0 - ad_discperc * 0.01)
	end if
	return 0

// w_proformapurchase.wf_editpostedinvoice() returns 0
	long ll_code
	string ls_specialright
	s_invdetail lstr_invdetail
	ls_specialright = "3"
	if gl_usercode <> 1 then
		return
	end if
	if this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
	end if
	if ll_code > 0 and this.id_list.object.posted[this.id_list.getrow()] = "Y" then
		if f_is_specialright_enabled(ls_specialright) then
			openwithparm(w_special_rights_password, ls_specialright)
			if message.doubleparm > 0.0 then
				lstr_invdetail.i_module = this.ii_module
				lstr_invdetail.l_invcode = ll_code
				openwithparm(w_editpostedinvoice, lstr_invdetail)
			else
				return
			end if
		else
			return
		end if
		return
	end if

// w_proformapurchase.wf_setnull(string as_column, boolean as_isnewinv) returns integer
	long ll_null
	setnull(ll_null)
	this.id_master.setitem(1, as_column, ll_null)
	return 1

// w_proformapurchase.wf_populate_pendingdueitems() returns long
	datastore lds_duedetail
	s_arguements lstr_arg
	boolean lb_enablesave
	boolean lb_insertrow
	integer li_retcode = 1
	integer li_errcode
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_counter
	long ll_tmprowid
	long ll_tmpcode
	long ll_icode
	long ll_packunits
	datetime ldt_date
	string ls_errortext
	string ls_batch
	string ls_class
	if wf_iseditable() = false then
		return 0
	end if
	lds_duedetail = create datastore
	open(w_arg_sdate_ldate)
	lstr_arg = message.powerobjectparm
	if 1 = 1 then
		lds_duedetail.dataobject = "d_purchase_pendingdueitems"
		lds_duedetail.settransobject(this.it_transobject)
		lds_duedetail.retrieve(lstr_arg.d_sdate, lstr_arg.d_edate)
		ll_totalrows = lds_duedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		this.id_detail.setredraw(false)
		if lb_enablesave then
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
			this.id_detail.reset()
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				ll_rowcount = this.id_detail.insertrow(0)
				ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_duedetail.getitemnumber(ll_counter, "gcode")), 1, this.idc_godown.rowcount())
				ll_icode = lds_duedetail.getitemnumber(ll_counter, "icode")
				if wf_inititeminfo(ll_icode, ll_rowcount, ls_errortext) then
					ll_packunits = this.id_detail.object.packunits[ll_rowcount]
					if ll_packunits = 0 or isnull(ll_packunits) then
						ll_packunits = 1
					end if
					ll_gcode = lds_duedetail.getitemnumber(ll_counter, "gcode")
					this.id_detail.object.batch[ll_rowcount] = f_stringpreferences("defaultbatch")
					this.id_detail.object.gcode[ll_rowcount] = ll_gcode
					if this.id_master.object.purcatcode[1] = 2 then
						this.id_detail.object.packqty[ll_rowcount] = ceiling(lds_duedetail.object.qty[ll_counter] / ll_packunits)
						this.id_detail.object.bonusqty[ll_rowcount] = 0
					else
						this.id_detail.object.looseqty[ll_rowcount] = lds_duedetail.object.qty[ll_counter]
						this.id_detail.object.bonusqty[ll_rowcount] = 0
					end if
				end if
				wf_update_value_extax(ll_rowcount, this.id_detail.object.looseqty[ll_rowcount] + this.id_detail.object.packqty[ll_rowcount], this.id_detail.object.purprice[ll_rowcount], this.id_detail.object.discperc[ll_rowcount])
			next
		end if
		this.id_detail.setredraw(true)
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return li_retcode

// w_proformapurchase.wf_validate_purcategory(long al_purcatcode) returns long
	long ll_retcode
	long ll_rowcount
	long ll_counter
	long ll_icode
	long ll_packunits
	string ls_errortext
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 0 then
		ll_counter = 1
		do while ll_counter <= ll_rowcount and ll_retcode = 0
			ll_icode = this.id_detail.object.icode[ll_counter]
			if not wf_inititeminfo_purcategory(ll_icode, ll_counter, ls_errortext, al_purcatcode) then
				ll_retcode = 1
			end if
			ll_counter = ll_counter + 1
		loop
	else
		ll_retcode = 0
	end if
	return ll_retcode

// w_proformapurchase.wf_inititeminfo_purcategory(long al_icode, long al_row, string as_errortext, long al_purcatcode) returns boolean
	boolean retflag = true
	double ld_purprice
	double ld_discperc
	double ld_saleprice
	double ld_avgprice
	double ld_packsalestax
	double ld_gstperc
	double ld_rpp
	double ld_unitsalestax
	double ld_rpp2
	double ld_rpp3
	double ld_rpp4
	double ld_rpp5
	double ld_godownstock
	double ld_allgodownstock
	long ll_packunits
	long ll_totalpieces
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_itemtotalval
	string ls_packingdesc
	string ls_remarks
	SQL SELECT item.customicode , item.name , item.purprice , item.packunits , item.purdiscperc , item.gcode , item.saleprice , item.avgprice , item.packsalestax , item.gstperc1 , item.recentpurprice , Round ( item.packsalestax / item.packunits , 2 ) , item.recentpurprice2 , recentpurprice3 , recentpurprice4 , recentpurprice5 , item.packingdesc , item.totalpieces , item.remarks INTO :ls_fullcode, :ls_name, :ld_purprice, :ll_packunits, :ld_discperc, :li_gcode, :ld_saleprice, :ld_avgprice, :ld_packsalestax, :ld_gstperc, :ld_rpp, :ld_unitsalestax, :ld_rpp2, :ld_rpp3, :ld_rpp4, :ld_rpp5, :ls_packingdesc, :ll_totalpieces, :ls_remarks FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.ii_defaultgcode = this.id_detail.getitemnumber(al_row, "gcode")
	else
		if this.il_strategy = 2 then
			this.ii_defaultgcode = li_gcode
		end if
		if this.il_strategy = 1 then
			this.ii_defaultgcode = this.id_detail.getitemnumber(al_row, "gcode")
		end if
	end if
	ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
	this.it_transobject.getitemstocktotal(this.ii_defaultgcode, al_icode, ld_godownstock)
	this.it_transobject.getitemstockinallowedgodown(al_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.id_detail.setitem(al_row, "gcode", this.ii_defaultgcode)
	this.id_detail.setitem(al_row, "icode", al_icode)
	this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
	this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
	this.id_detail.setitem(al_row, "packunits", ll_packunits)
	this.id_detail.setitem(al_row, "piecesinhand", ll_totalpieces)
	if al_purcatcode = 2 then
		this.id_detail.setitem(al_row, "discperc", ld_discperc)
	end if
	this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
	this.id_detail.setitem(al_row, "rate", ld_purprice)
	this.id_detail.setitem(al_row, "itemtotalval", ls_itemtotalval)
	this.id_detail.setitem(al_row, "stock", ld_godownstock)
	this.id_detail.setitem(al_row, "totalstock", ld_allgodownstock)
	this.id_detail.setitem(al_row, "packingdesc", ls_packingdesc)
	this.id_footer.object.t_rpp.text = string(ld_rpp) + " , " + string(ld_rpp2) + " , " + string(ld_rpp3) + " , " + string(ld_rpp4) + " , " + string(ld_rpp5)
	this.id_footer.object.t_avgprice.text = string(ld_avgprice)
	if al_purcatcode = 2 then
		if f_stringpreferences("salepriceinpackpur") = "Y" then
			this.id_detail.setitem(al_row, "purprice", ld_saleprice)
		else
			this.id_detail.setitem(al_row, "purprice", ld_purprice)
		end if
		this.id_detail.setitem(al_row, "unitsalestax", ld_packsalestax)
		this.id_detail.setitem(al_row, "salepriceforitem", ld_saleprice)
	else
		if f_stringpreferences("priceinloosepur") = "Y" then
			this.id_detail.setitem(al_row, "purprice", ld_purprice / ll_packunits)
		else
			this.id_detail.setitem(al_row, "purprice", ld_saleprice / ll_packunits)
		end if
		this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
	end if
	if f_stringpreferences("pur_copyremarksinitemdesc") = "Y" and this.id_detail.getitemstatus(al_row, "itemdescription", primary!) = notmodified! then
		this.id_detail.setitem(al_row, "itemdescription", ls_remarks)
	end if
	this.id_detail.setitem(al_row, "gstperc", ld_gstperc)
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_allgodownstock)
	this.id_footer.setitem(1, "piecesinhand", ll_totalpieces)
	this.id_footer.setitem(1, "itemtotalval", ls_itemtotalval)
	wf_update_value_extax(al_row, this.id_detail.object.packqty[al_row] + this.id_detail.object.looseqty[al_row], ld_purprice, ld_discperc)
	return retflag

// w_proformapurchase.wf_separate_qty() returns long
	long ll_rowcount
	long ll_counter
	long ll_purcatcode
	long ll_icode
	ll_purcatcode = this.id_master.object.purcatcode[1]
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 0 then
		for ll_counter = 1 to ll_rowcount
			ll_icode = this.id_detail.object.icode[ll_counter]
			if ll_purcatcode <> 2 then
				this.id_detail.object.looseqty[ll_counter] = this.id_detail.object.packqty[ll_counter]
				this.id_detail.object.packqty[ll_counter] = 0
			end if
		next
	end if
	wf_grandtotal_with_update_netrate()
	return 0

// w_proformapurchase.wf_populate_receipt() returns long
	datastore lds_receiptdetail
	s_arguements lstr_arg
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_suppcode
	long ll_counter
	long ll_packunits
	integer li_retcode = 1
	integer li_errcode
	string ls_errortext
	boolean lb_enablesave
	if this.id_master.rowcount() <= 0 then
		return 0
	end if
	if this.id_master.object.posted[1] = "Y" then
		return 0
	end if
	if wf_iseditable() = false then
		return 0
	end if
	ll_suppcode = this.id_master.getitemnumber(1, "suppcode")
	if isnull(ll_suppcode) or ll_suppcode = 0 then
		messagebox("Supplier Validation", "Can not populate Receipt invoices~r~nPlease Select Valid Supplier")
		this.id_master.setcolumn("suppcode")
		this.id_master.setfocus()
		return -1
	end if
	lds_receiptdetail = create datastore
	lds_receiptdetail.dataobject = "d_populate_receiptdetail_proformapurinv"
	lds_receiptdetail.settransobject(this.it_transobject)
	openwithparm(w_populate_receipt_in_proformapurinv, ll_suppcode)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		if lstr_arg.i_supress then
			this.id_master.setitem(1, "remarks", lstr_arg.s_name2)
		end if
		ll_totalrows = lds_receiptdetail.retrieve(lstr_arg.ia_integerlist)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_receiptdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		ll_counter = 0
		ll_detailrows = this.id_detail.rowcount()
		for ll_counter = 1 to ll_detailrows
			event ue_deleteitem()
		next
		ll_counter = 0
		for ll_rowcount = 1 to ll_totalrows
			ll_counter = this.id_detail.insertrow(0)
			ll_icode = lds_receiptdetail.object.icode[ll_rowcount]
			if wf_inititeminfo(ll_icode, ll_rowcount, ls_errortext) then
				ll_packunits = this.id_detail.object.packunits[ll_rowcount]
				if ll_packunits = 0 or isnull(ll_packunits) then
					ll_packunits = 1
				end if
				this.id_detail.object.gcode[ll_counter] = lds_receiptdetail.object.gcode[ll_rowcount]
				this.id_detail.object.batch[ll_counter] = lds_receiptdetail.object.batch[ll_rowcount]
				this.id_detail.object.expiry[ll_counter] = lds_receiptdetail.object.expiry[ll_rowcount]
				this.id_detail.object.receiptrowid[ll_counter] = lds_receiptdetail.object.receiptutn[ll_rowcount]
				if this.id_master.object.purcatcode[1] = 2 then
					this.id_detail.object.packqty[ll_counter] = ceiling(lds_receiptdetail.object.qty[ll_rowcount] / ll_packunits)
				else
					this.id_detail.object.looseqty[ll_counter] = lds_receiptdetail.object.looseqty[ll_rowcount]
				end if
				this.id_detail.object.bonusqty[ll_counter] = 0
			end if
			wf_update_value_extax(ll_rowcount, this.id_detail.object.looseqty[ll_rowcount] + this.id_detail.object.packqty[ll_rowcount], this.id_detail.object.purprice[ll_rowcount], this.id_detail.object.discperc[ll_rowcount])
		next
	else
		li_retcode = -1
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	destroy lds_receiptdetail
	return li_retcode

// w_proformapurchase.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_proformapurmenu" then
		this.menuid = create m_proformapurmenu
	end if
	this.dw_purinvrep = create dw_purinvrep
	this.dw_changeprice_foritemlog = create dw_changeprice_foritemlog
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_purinvrep
	this.control[icurrent + 2] = this.dw_changeprice_foritemlog

// w_proformapurchase.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_purinvrep
	destroy this.dw_changeprice_foritemlog

// w_proformapurchase.ue_save() returns 0 [event]
	double ld_bonusqty
	double ld_looseqty
	double ld_packqty
	integer li_counter = 1
	integer li_option
	long ll_icode
	long ll_purinvcode
	long ll_salesmancode = 1
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_suppcode
	long ll_inv_count
	long ll_counter
	long ll_detailrows
	long ll_count
	long ll_found
	long ll_rightfound
	long ll_associatedsaleordercode
	long ll_maxretcode
	double ld_saleprice
	double ld_recentpurprice
	string ls_updatepurprice
	boolean lb_commitflag = true
	boolean lb_isnewinv
	datetime ldt_expiry
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_supp_invcode
	date ld_expiry
	string ls_expiry
	ls_expiry = f_stringpreferences("purexpiry")
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	if f_stringpreferences("ForceUniqueSuppInvNoInPur") = "Y" then
		ls_supp_invcode = this.id_master.getitemstring(1, "suppinvcode")
		ll_suppcode = this.id_master.getitemnumber(1, "suppcode")
		ll_purinvcode = this.id_master.getitemnumber(1, "code")
		SQL SELECT isNull ( count ( *) , 0 ) INTO :ll_inv_count FROM Purledger WHERE Purledger.suppcode =:ll_suppcode AND purledger.suppinvcode =:ls_supp_invcode AND purledger.purinvcode NOT IN ( :ll_purinvcode ) USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			messagebox("DataBase Error", "Unable to get Supplier Inv. no. from database ~r~n" + this.it_transobject.sqlerrtext)
			return
		end if
		if ll_inv_count > 0 then
			messagebox("Supplier Inv. Validation", "Same Supplier Inoice no. already exist~r~nfor same Supplier")
			this.id_master.setcolumn("suppinvcode")
			this.id_master.setfocus()
			return
		end if
		return
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		for ll_count = 1 to ll_detailrows
			if ls_expiry = "Y" then
				ldt_expiry = this.id_detail.object.expiry[ll_count]
				ld_expiry = date(ldt_expiry)
				if ld_expiry <= relativedate(today(), f_numberpreferences("AcceptFutureExpiryDays")) then
					li_option = messagebox("Item Validation", "Expiry should be greater than " + string(relativedate(today(), f_numberpreferences("AcceptFutureExpiryDays")), "dd/mmm/yyyy") + "~r~nLine No. " + string(ll_count) + ", Expiry Date = " + string(ld_expiry, "dd/mmm/yyyy") + "~r~nAccept this expiry date?", question!, yesno!, 2)
					if li_option <> 1 then
						if this.id_master.object.purcatcode[1] = 2 then
							this.id_detail.setcolumn("packqty")
						else
							this.id_detail.setcolumn("looseqty")
						end if
						this.id_detail.scrolltorow(ll_count)
						this.id_detail.setfocus()
						return
					end if
					return
				end if
				return
			end if
			ll_found = 0
			if ll_count = ll_detailrows then
				exit
			end if
			ll_found = this.id_detail.find("gcode = long('" + string(this.id_detail.getitemnumber(ll_count, "gcode")) + "') and " + " icode = long('" + string(this.id_detail.getitemnumber(ll_count, "icode")) + "') and batch = '" + this.id_detail.getitemstring(ll_count, "batch") + "' and expiry = Date('" + string(this.id_detail.getitemdatetime(ll_count, "expiry"), "yyyy-mm-dd") + "')", ll_count + 1, ll_detailrows)
			if ll_found > 0 then
				messagebox("Item Validation", "Duplicate items found at row " + string(ll_count) + " and " + string(ll_found) + "." + "~r~nSuggested options are either delete the row or ~r~n" + "change Item batch or expiry")
				this.id_detail.scrolltorow(ll_count)
				if this.id_master.object.purcatcode[1] = 2 then
					this.id_detail.setcolumn("packqty")
				else
					this.id_detail.setcolumn("looseqty")
				end if
				this.id_detail.setfocus()
				return
			end if
		next
	elseif ll_detailrows <= 0 then
		messagebox("On Save Validation", "There are no rows to save.~r~nKindly insert some item row.")
		return
	end if
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if wf_show_po_pur_disparity(1) > 0 then
		return
	end if
	wf_setamountoninvoice()
	if f_stringpreferences("puruserwindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	setfocus()
	if ll_salesmancode > 0 then
		setpointer(hourglass!)
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			lb_isnewinv = true
			ll_maxretcode = wf_tabnewid("purledger", ll_invid)
			if ll_maxretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~n ~t~t~t~t~t~t~tgenerating InvCode")
				return
			end if
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
			this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					if lb_isnewinv then
						wf_setnull("Code", lb_isnewinv)
						SQL rollback USING this.it_transobject;
					end if
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
		else
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		end if
		this.id_master.object.discperc[ll_mastercurrrow] = this.id_footer.object.discperc[ll_footercurrrow]
		this.id_master.object.flatdisc[ll_mastercurrrow] = this.id_footer.object.flatdisc[ll_footercurrrow]
		this.id_master.object.misccharges[ll_mastercurrrow] = this.id_footer.object.misccharges[ll_footercurrrow]
		wf_grandtotal_with_update_netrate()
		this.id_footer.accepttext()
		this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
		if this.id_master.getitemstring(1, "accountfor") = "Y" and f_stringpreferences("AskAmtOnPurchase") = "Y" then
			ll_rightfound = 0
			ll_rightfound = gds_securitywindow.find("rightcode = 584", 1, gds_securitywindow.rowcount())
			if ll_rightfound > 0 then
				this.id_master.setitem(ll_mastercurrrow, "amtby", ll_salesmancode)
				this.id_master.setitem(ll_mastercurrrow, "amtdate", ldt_server_datetime)
			end if
		end if
		this.id_master.object.invgstperc1[ll_mastercurrrow] = this.id_footer.object.invgstperc1[ll_footercurrrow]
		do while li_counter <= ll_detailrows
			this.id_detail.setitem(li_counter, "code", ll_invid)
			ll_icode = this.id_detail.object.icode[li_counter]
			SQL SELECT saleprice , RecentPurPrice INTO :ld_saleprice, :ld_recentpurprice FROM item WHERE icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = -1 then
				if lb_isnewinv then
					wf_setnull("Code", lb_isnewinv)
					SQL rollback USING this.it_transobject;
				end if
				messagebox("DataBase Error", "Problem In retrieving Item Information")
				return
			else
				this.id_detail.setitem(li_counter, "saleprice", ld_saleprice)
				this.id_detail.setitem(li_counter, "recentpurprice", ld_recentpurprice)
			end if
			ld_packqty = this.id_detail.getitemnumber(li_counter, "packqty")
			ld_looseqty = this.id_detail.getitemnumber(li_counter, "looseqty")
			ld_bonusqty = this.id_detail.getitemnumber(li_counter, "bonusqty")
			if ld_packqty + ld_looseqty + ld_bonusqty = 0.0 then
				if lb_isnewinv then
					wf_setnull("Code", lb_isnewinv)
					SQL rollback USING this.it_transobject;
				end if
				messagebox("Purchase Qty Validation", "Please enter valid qty")
				if this.id_master.object.purcatcode[1] = 2 then
					this.id_detail.setcolumn("packqty")
				else
					this.id_detail.setcolumn("looseqty")
				end if
				this.id_detail.selecttext(1, 1)
				return
			end if
			li_counter = li_counter + 1
		loop
		if lb_commitflag then
			wf_separate_qty()
			if this.id_master.update(true, false) < 0 then
				SQL rollback USING this.it_transobject;
				setpointer(arrow!)
				if lb_isnewinv then
					wf_setnull("Code", lb_isnewinv)
				end if
				return
			end if
			if this.id_detail.update() > 0 then
				if f_stringpreferences("IncPurInActMonitor") = "Y" then
					this.it_transobject.updateactivitymonitor("PV", ll_invid)
					if this.it_transobject.sqlcode <> 0 then
						SQL rollback USING this.it_transobject;
						lb_commitflag = false
						messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
						setpointer(arrow!)
						if lb_isnewinv then
							wf_setnull("Code", lb_isnewinv)
						end if
						return
					else
						lb_commitflag = true
					end if
				end if
				if lb_commitflag then
					SQL commit USING this.it_transobject;
					messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
					this.ib_commitok = true
					this.id_master.resetupdate()
					this.im_menu.m_file.m_new.enabled = true
					this.editflag = false
					if gd_recenttransdate < this.id_systemdate then
						gd_recenttransdate = this.id_systemdate
					end if
				else
					SQL rollback USING this.it_transobject;
					lb_commitflag = false
					setpointer(arrow!)
					if lb_isnewinv then
						wf_setnull("Code", lb_isnewinv)
					end if
					return
				end if
			else
				messagebox("Purchase Saving Problem!", "Problem in Purchase Detail Upation.~r~nReasons are:-~r~n" + this.it_transobject.sqlerrtext)
				lb_commitflag = false
				setpointer(arrow!)
				if lb_isnewinv then
					wf_setnull("Code", lb_isnewinv)
				end if
				SQL rollback USING this.it_transobject;
				return
			end if
			return
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_proformapurchase.ue_newform() returns 0 [event]
	integer rtncode
	integer ll_counter
	datetime ldt_server_datetime
	string ls_date_errtext
	m_proformapurmenu lm_menu
	call super::ue_newform
	lm_menu = this.menuid
	setredraw(false)
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 528 then
			lm_menu.m_file.m_savepost.enabled = true
		end if
	next
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	wf_setgodownoption()
	this.id_footer.object.discperc[1] = 0
	this.id_footer.object.flatdisc[1] = 0
	this.id_footer.object.misccharges[1] = 0
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	setredraw(true)
	this.id_footer.object.t_rpp.text = ""
	this.id_footer.object.t_avgprice.text = ""
	if this.ib_modifydate then
		if this.ib_fetchserverdate then
			wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
			this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
		else
			this.id_master.setitem(this.id_master.getrow(), "date", today())
		end if
	end if
	if not wf_validatedate() then
		close(this)
	end if

// w_proformapurchase.ue_detail() returns 0 [event]
	long ll_code
	long ll_counter
	integer li_rtncode
	integer li_protect
	m_proformapurmenu lm_menu
	call super::ue_detail
	lm_menu = this.menuid
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	if wf_isinvoiceinuse(ll_code) = true then
		messagebox("Invoice Validation", "Purchase Invoice already in use by some other user.~r~nKindly try again after sometime or open some other invoice.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	this.id_footer.retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	if wf_allowpurchasemodification(ll_code, this.il_groupcode, this.il_strategy) <> 0 then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "You Can not modify this Invoice,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	wf_initmodify(li_protect)
	if li_protect = 0 then
		if not this.ib_purmodify and this.id_master.object.purcatcode[1] = 2 then
			li_protect = 1
		end if
		if not this.ib_purmodify and this.id_master.object.purcatcode[1] = 8 then
			li_protect = 1
		end if
		if not this.ib_purmodify and this.id_master.object.purcatcode[1] <> 2 and this.id_master.object.purcatcode[1] = 8 then
			li_protect = 1
		end if
	end if
	wf_protectdw(this.id_master, li_protect)
	if not isnull(this.id_master.object.pocode[1]) then
		wf_setpurorderinfo(this.id_master.object.pocode[1])
	end if
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_purchasegodownoption
	end if
	wf_setgodownoption()
	this.im_menu.m_file.m_save.enabled = false
	if li_protect = 0 then
		this.im_menu.m_file.m_save.enabled = true
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 528 then
				lm_menu.m_file.m_savepost.enabled = true
			end if
		next
	end if
	if li_protect = 1 then
		this.editflag = false
		this.id_footer.object.t_rpp.text = ""
		this.id_footer.object.t_avgprice.text = ""
	end if
	this.im_menu.m_file.m_print.enabled = true
	wf_grandtotal()
	setredraw(true)

// w_proformapurchase.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 1 and this.il_currrow <= this.id_detail.rowcount() and vf_dwdupcodebatch(this.id_detail, "gcode", gl_defaultgcode, "icode", this.id_detail.getitemnumber(this.id_detail.getrow(), "icode"), "batch", this.id_detail.getitemstring(this.id_detail.getrow(), "batch"), "expiry", this.id_detail.getitemdatetime(this.id_detail.getrow(), "expiry"), this.il_currrow) = true then
		messagebox("Item Validation", "Duplicate item, please select some other item")
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.settransobject(this.it_transobject)
	if f_stringpreferences("enablequickprefferedsearch") = "Y" then
		this.id_detail.setcolumn("quicksearch")
	elseif f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_proformapurchase.ue_deleteitem() returns 0 [event]
	long ll_row
	ll_row = this.id_detail.getrow()
	if this.id_detail.rowcount() > 0 then
		call super::ue_deleteitem
		return
	end if
	this.im_menu.m_file.m_print.enabled = false

// w_proformapurchase.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	destroy this.ids_itemstockinfo
	return ::message.returnvalue

// w_proformapurchase.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_proformapurchase.ue_list() returns 0 [event]
	m_proformapurmenu lm_menu
	long ll_counter
	call super::ue_list
	lm_menu = this.menuid
	SQL rollback USING this.it_transobject;
	if this.ib_purposting and this.id_master.object.purcatcode[1] = 2 then
		this.im_menu.m_file.m_post.enabled = true
	else
		this.im_menu.m_file.m_post.enabled = false
	end if
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 528 then
			lm_menu.m_file.m_savepost.enabled = false
		end if
	next

// w_proformapurchase.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	setpointer(hourglass!)
	this.idc_supplierlist.setredraw(false)
	this.idc_supplierlist.settransobject(this.it_transobject)
	this.idc_supplierlist.reset()
	this.idc_supplierlist.retrieve()
	this.idc_supplierlist.setredraw(true)
	setpointer(arrow!)

// w_proformapurchase.ue_print() returns 0 [event]
	long ll_invcode
	long ll_suppcode
	long ll_row
	string ls_suppname
	string ls_printbalance
	string ls_invoicesize
	boolean lb_listtab
	integer li_printcounter
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if f_stringpreferences("PurchaseAutoPosting") = "Y" then
			wf_saveandpost()
		else
			triggerevent("ue_save")
		end if
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	SQL SELECT purinvpagesize , printcounter INTO :ls_invoicesize, :li_printcounter FROM purledger WHERE purinvcode =:ll_invcode USING this.it_transobject;
	wf_selectprintreport(ls_invoicesize)
	if lb_listtab then
		SQL Select PrintBalance INTO :ls_printbalance From PurLedger Where PurInvCode =:ll_invcode USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Fetch Problem", "Unable to fetch PrintBalance status from database")
			SQL rollback USING this.it_transobject;
			return
		else
			SQL commit USING this.it_transobject;
		end if
		if ls_printbalance = "Y" then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
		end if
	elseif this.id_master.getitemstring(1, "PrintBalance") = "Y" then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
	end if
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.id_print.rowcount() > 0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		else
			li_printcounter = li_printcounter + 1
			SQL update PurLedger SET printcounter =:li_printcounter WHERE purinvcode =:ll_invcode USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Database Error", "Some database problem has occur")
				SQL rollback USING this.it_transobject;
				return
			else
				SQL commit USING this.it_transobject;
			end if
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_proformapurchase.ue_postopen() returns 0 [event]
	datawindowchild ldc_dddpurcategory
	datawindowchild ldc_headerno
	m_proformapurmenu lm_menu
	datastore lds_headers
	integer li_rtncode
	long ll_code
	long ll_counter
	long ll_found
	call super::ue_postopen
	lm_menu = this.menuid
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	setredraw(false)
	this.id_print = this.dw_purinvrep
	this.id_print.settransobject(this.it_transobject)
	li_rtncode = this.id_master.getchild("suppcode", this.idc_supplierlist)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
	end if
	this.idc_supplierlist.settransobject(this.it_transobject)
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 504 then
			this.ib_purposting = true
			this.im_menu.m_file.m_post.visible = true
			this.im_menu.m_file.m_post.toolbaritemvisible = true
			this.im_menu.m_file.m_post.enabled = false
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 507 then
			this.ib_purmodify = true
		end if
	next
	if not this.ib_purposting then
		this.im_menu.m_file.m_post.visible = false
		this.im_menu.m_file.m_post.toolbaritemvisible = false
		this.im_menu.m_file.m_post.enabled = false
	end if
	if f_stringpreferences("showpurchaseorderinpurchase") = "N" then
		this.id_master.object.pocode.visible = false
		this.id_master.object.pocode_t.visible = false
		this.id_master.object.podate.visible = false
		this.id_master.object.podate_t.visible = false
	end if
	if f_stringpreferences("ShowGoodsCompanyInPurchase") = "N" then
		this.id_master.object.gccode.visible = false
		this.id_master.object.gccode_t.visible = false
	end if
	if f_stringpreferences("ShowVehicleInPurchase") = "N" then
		this.id_master.object.vehicle.visible = false
		this.id_master.object.vehicle_t.visible = false
	end if
	if f_stringpreferences("ShowShipToInPurchase") = "N" then
		this.id_master.object.shipto.visible = false
		this.id_master.object.shipto_t.visible = false
	end if
	if f_stringpreferences("UpdateSalePriceForItem") = "N" then
		this.id_detail.object.salepriceforitem.visible = false
		this.id_detail.object.c_margin.visible = false
	end if
	if f_stringpreferences("asknewponoinpur") = "N" then
		this.id_master.object.newpurchaseorderno.visible = false
		this.id_master.object.t_newpurchaseorderno.visible = false
		this.id_master.object.newpurchaseorderno.initial = "."
	elseif f_stringpreferences("allowemptynewponoinpur") = "N" then
		this.id_master.object.newpurchaseorderno.edit.required = "yes"
	end if
	if f_stringpreferences("asklcnoinpur") = "N" then
		this.id_master.object.lcno.visible = false
		this.id_master.object.t_lcno.visible = false
		this.id_master.object.lcno.initial = "."
	elseif f_stringpreferences("allowemptylcnoinpur") = "N" then
		this.id_master.object.lcno.edit.required = "yes"
	end if
	if f_stringpreferences("showmarkupinpur") = "N" then
		this.id_detail.object.c_markup.visible = false
	end if
	if f_stringpreferences("showmargininpur") = "N" then
		this.id_detail.object.c_margin.visible = false
	end if
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 528 then
			lm_menu.m_file.m_savepost.visible = true
			lm_menu.m_file.m_savepost.enabled = true
		end if
	next
	if f_stringpreferences("showpurchasetypeinpurchase") = "N" then
		this.id_master.object.purtypecode.visible = false
		this.id_master.object.purtypecode_t.visible = false
	elseif f_stringpreferences("allowemptypurtypeinpur") = "N" then
		this.id_master.object.purtypecode.dddw.required = "yes"
	end if
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit to Make Purchase")
		close(this)
		return
	end if
	li_rtncode = this.id_detail.getchild("gcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to Purchase")
		close(this)
		return
	end if
	this.ii_purchasegodownoption = this.idc_godown.getitemnumber(1, "gcode")
	this.id_detail.object.gcode.initial = string(this.ii_purchasegodownoption)
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = false
	this.id_itemslist.object.sstock.visible = false
	this.id_itemslist.object.t_pstock.visible = true
	this.id_itemslist.object.pstock.visible = true
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_detail.object.gcode.visible = false
		this.id_master.object.t_gcode.visible = true
		this.id_master.object.gcode.visible = true
		this.id_master.object.gcode.initial = string(this.ii_purchasegodownoption)
	end if
	if f_stringpreferences("pursuppBalance") = "Y" then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
	else
		this.id_master.object.creditordebit.visible = false
		this.id_master.object.suppbalance.visible = false
		this.id_master.object.t_balance.visible = false
	end if
	if f_stringpreferences("puritemdescription") = "N" then
		this.id_detail.object.itemdescription.visible = false
	end if
	if f_stringpreferences("purbatch") = "N" then
