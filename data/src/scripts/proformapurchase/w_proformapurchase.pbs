// window w_proformapurchase (proformapurchase)  ancestor: w_multi_entry

// w_proformapurchase.ue_populate_purchase_from_datacarrydb() returns 0 [event]
	long ll_icode
	long ll_row
	long ll_saleinvcode
	long ll_counter
	long ll_qty
	long ll_bonusqty
	long ll_suppcode
	boolean retflag = true
	double ld_purprice
	double ld_discperc
	double ld_itemflatdisc
	double ld_saleprice
	double ld_avgprice
	double ld_packsalestax
	double ld_gstperc
	double ld_rpp
	double ld_unitsalestax
	double ld_itempurprice
	double ld_rate
	double ld_rpp2
	double ld_rpp3
	double ld_rpp4
	double ld_rpp5
	double ld_invdiscperc
	double ld_invflatdisc
	double ld_invmisccharges
	double ld_invgstperc1
	double ld_godownstock
	double ld_allgodownstock
	long ll_packunits
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_batch
	string ls_itemtotalval
	string ls_packingdesc
	string ls_errortext
	string ls_error_syntax
	string ls_connsetting = "Set ANSI_NULLS ON Set ANSI_WARNINGS ON"
	string ls_saleledgerquery
	string ls_saledetailquery
	string ls_newsyntax
	string ls_suppinvcode
	string ls_suppinvcode_tmp
	datetime ldt_expiry
	datastore lds_saleledger
	datastore lds_saledetail
	s_arguements lstr_arguments
	u_transaction lt_transobject
	if wf_iseditable() = false then
		return
	end if
	ll_suppcode = this.id_master.object.suppcode[this.id_master.rowcount()]
	if isnull(ll_suppcode) then
		messagebox("Supplier Validation!", "Kindly Select a supplier first")
		return
	end if
	open(w_populate_sale_from_datacarrydb)
	lstr_arguments = message.powerobjectparm
	if lstr_arguments.i_status <= 0 then
		return
	end if
	ll_saleinvcode = lstr_arguments.l_code1
	if ll_saleinvcode > 0 and this.id_master.object.suppcode[this.id_master.rowcount()] > 0 then
		ls_suppinvcode = trim(string(ll_saleinvcode))
		if f_stringpreferences("ForceUniqueSuppInvNoInPur") = "Y" then
			SQL SELECT MAX ( SuppInvCode ) INTO :ls_suppinvcode_tmp FROM PurLedger WHERE SuppCode =:ll_suppcode AND SuppInvCode =:ls_suppinvcode USING sqlca;
			if sqlca.sqlcode = 0 then
				if not isnull(ls_suppinvcode_tmp) then
					messagebox("Supplier Inv. Code Validation!", "Supplier Inv. code already exist.~r~nProbably this invoice is already processed.~r~nKindly select some other invoice")
					return
				end if
			else
				messagebox("Connection Problem", "Unable to Fetch Supplier Invoice Code from database.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
				return
			end if
			return
		end if
		return
	end if
	lt_transobject = create u_transaction
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Problem", "Unable to connect to database.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		return
	end if
	SQL EXECUTE IMMEDIATE :ls_connsetting USING lt_transobject;
	if ll_saleinvcode > 0 then
		setpointer(hourglass!)
		lds_saleledger = create datastore
		lds_saledetail = create datastore
		ls_saleledgerquery = "Select ~tSaleInvCode, SaleCatCode, CustCode, SalesmanCode, date, DiscPerc, FlatDisc, MiscCharges, SalesTax,  Posted, PostDate, Remarks, CustRefNo, headerno, headerinvno, OriginalDate, ModifiedBy,PostedBy, InvGSTPerc1, InvTotal " + "From ~t" + gs_inlinkserver + "." + gs_inlinkserverdb + "." + gs_inlinkserverowner + "." + "SaleLedger " + "Where   Saleinvcode = " + string(ll_saleinvcode)
		ls_saledetailquery = "Select ~tSaleInvcode, ICode, GCode, Batch, Expiry, PackQty, LooseQty, PackUnits, SalePrice, AvgPrice, Rate, DiscPerc, SalesTax, RowID, itemflatdisc, SaleItemDescription, PackPrice, UnitSalesTax, GSTPerc, SaleUtn, bonusqty, RowGroup " + "From ~t" + gs_inlinkserver + "." + gs_inlinkserverdb + "." + gs_inlinkserverowner + "." + "SaleDetail " + "Where ~tSaleInvCode = " + string(ll_saleinvcode)
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_saleledgerquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For SaleLedger DataStore")
			return
		else
			ls_error_syntax = ""
			lds_saleledger.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For SaleLedger DataStore")
				return
			end if
		end if
		lds_saleledger.settransobject(lt_transobject)
		if lds_saleledger.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source SaleLedger.")
			return
		end if
		ls_newsyntax = ""
		ls_error_syntax = ""
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_saledetailquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For SaleDetail DataStore")
			return
		else
			ls_error_syntax = ""
			lds_saledetail.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For SaleDetail DataStore")
				return
			end if
		end if
		lds_saledetail.settransobject(lt_transobject)
		if lds_saledetail.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source SaleDetail.")
			return
		end if
		ld_invdiscperc = lds_saleledger.getitemnumber(lds_saleledger.getrow(), "discperc")
		ld_invflatdisc = lds_saleledger.getitemnumber(lds_saleledger.getrow(), "flatdisc")
		ld_invmisccharges = lds_saleledger.getitemnumber(lds_saleledger.getrow(), "misccharges")
		ld_invgstperc1 = lds_saleledger.getitemnumber(lds_saleledger.getrow(), "invgstperc1")
		this.id_master.setitem(1, "suppinvcode", trim(string(ll_saleinvcode)))
		this.id_master.setitem(1, "suppinvdate", lstr_arguments.d_sdate)
		this.id_footer.setitem(1, "discperc", ld_invdiscperc)
		this.id_footer.setitem(1, "flatdisc", ld_invflatdisc)
		this.id_footer.setitem(1, "misccharges", ld_invmisccharges)
		this.id_footer.setitem(1, "invgstperc1", ld_invgstperc1)
		for ll_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_counter = 1 to lds_saledetail.rowcount()
			ll_row = this.id_detail.insertrow(0)
			ll_icode = lds_saledetail.getitemnumber(ll_counter, "icode")
			ll_qty = lds_saledetail.getitemnumber(ll_counter, "looseqty")
			ll_bonusqty = lds_saledetail.getitemnumber(ll_counter, "bonusqty")
			ld_purprice = lds_saledetail.getitemnumber(ll_counter, "saleprice")
			ld_discperc = lds_saledetail.getitemnumber(ll_counter, "discperc")
			ld_itemflatdisc = lds_saledetail.getitemnumber(ll_counter, "itemflatdisc")
			ld_unitsalestax = lds_saledetail.getitemnumber(ll_counter, "unitsalestax")
			ld_gstperc = lds_saledetail.getitemnumber(ll_counter, "gstperc")
			ls_batch = lds_saledetail.getitemstring(ll_counter, "batch")
			ldt_expiry = lds_saledetail.getitemdatetime(ll_counter, "expiry")
			ld_purprice = ld_purprice - ld_itemflatdisc
			SQL SELECT item.customicode , item.name , item.gcode , item.purprice , item.packsalestax , item.saleprice , item.avgprice , item.recentpurprice , item.recentpurprice2 , recentpurprice3 , recentpurprice4 , recentpurprice5 , item.packingdesc , item.packunits INTO :ls_fullcode, :ls_name, :li_gcode, :ld_itempurprice, :ld_packsalestax, :ld_saleprice, :ld_avgprice, :ld_rpp, :ld_rpp2, :ld_rpp3, :ld_rpp4, :ld_rpp5, :ls_packingdesc, :ll_packunits FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = -1 then
				retflag = false
				ls_errortext = "Database Error: Item information can not be retrieved.~r~nReasons:" + this.it_transobject.sqlerrtext
				messagebox("Item Validation", ls_errortext)
			end if
			if ll_packunits < 1 or isnull(ll_packunits) then
				ll_packunits = 1
			end if
			if this.il_godowncount = 1 and this.il_strategy = 1 then
				this.ii_defaultgcode = this.id_detail.getitemnumber(ll_row, "gcode")
			else
				if this.il_strategy = 2 then
					this.ii_defaultgcode = li_gcode
				end if
				if this.il_strategy = 1 then
					this.ii_defaultgcode = this.id_detail.getitemnumber(ll_row, "gcode")
				end if
			end if
			ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
			this.it_transobject.getitemstocktotal(this.ii_defaultgcode, ll_icode, ld_godownstock)
			this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
			if this.it_transobject.sqlcode = -1 then
				retflag = false
				ls_errortext = "Database Error: Item Stock information can not be retrieved"
			end if
			this.id_detail.setitem(ll_row, "gcode", this.ii_defaultgcode)
			this.id_detail.setitem(ll_row, "icode", ll_icode)
			this.id_detail.setitem(ll_row, this.is_columnitemname, ls_name)
			this.id_detail.setitem(ll_row, "fullcode", ls_fullcode)
			this.id_detail.setitem(ll_row, "packunits", ll_packunits)
			this.id_detail.setitem(ll_row, "discperc", ld_discperc)
			this.id_detail.setitem(ll_row, "saleprice", ld_saleprice)
			this.id_detail.setitem(ll_row, "rate", ld_itempurprice)
			this.id_detail.setitem(ll_row, "itemtotalval", ls_itemtotalval)
			this.id_detail.setitem(ll_row, "stock", ld_godownstock)
			this.id_detail.setitem(ll_row, "totalstock", ld_allgodownstock)
			this.id_detail.setitem(ll_row, "packingdesc", ls_packingdesc)
			this.id_detail.setitem(ll_row, "batch", ls_batch)
			this.id_detail.setitem(ll_row, "expiry", ldt_expiry)
			this.id_footer.object.t_rpp.text = string(ld_rpp) + " , " + string(ld_rpp2) + " , " + string(ld_rpp3) + " , " + string(ld_rpp4) + " , " + string(ld_rpp5)
			this.id_footer.object.t_avgprice.text = string(ld_avgprice)
			if this.id_master.object.purcatcode[1] = 2 then
				this.id_detail.setitem(ll_row, "packqty", ll_qty)
				this.id_detail.setitem(ll_row, "bonusqty", ll_bonusqty)
				this.id_detail.setitem(ll_row, "purprice", ld_purprice)
				this.id_detail.setitem(ll_row, "unitsalestax", ld_unitsalestax)
				this.id_detail.setitem(ll_row, "salepriceforitem", ld_saleprice)
			else
				this.id_detail.setitem(ll_row, "looseqty", ll_qty)
				this.id_detail.setitem(ll_row, "bonusqty", ll_bonusqty)
				this.id_detail.setitem(ll_row, "purprice", ld_purprice)
				this.id_detail.setitem(ll_row, "unitsalestax", ld_unitsalestax)
			end if
			this.id_detail.setitem(ll_row, "gstperc", ld_gstperc)
			this.id_detail.setitem(ll_row, "valueextax", ll_qty * ld_purprice * (1.0 - ld_discperc * 0.01))
			this.id_footer.setitem(1, "stock", ld_godownstock)
			this.id_footer.setitem(1, "totalstock", ld_allgodownstock)
			this.id_footer.setitem(1, "itemtotalval", ls_itemtotalval)
		next
		if this.id_detail.rowcount() > 0 then
			this.im_menu.m_file.m_save.enabled = true
			wf_grandtotal()
		else
			this.im_menu.m_file.m_save.enabled = false
		end if
	end if
	SQL stop USING lt_transobject;

// w_proformapurchase.ue_populate_and_post_from_datacarrydb() returns 0 [event]
	long ll_totrows
	long ll_row
	if wf_iseditable() = false then
		return
	end if
	triggerevent("ue_populate_purchase_from_datacarrydb")
	wf_saveandpost()
	if wf_commitform() = true then
		postevent("ue_new")
	else
		ll_totrows = this.id_detail.rowcount()
		if ll_totrows > 0 then
			for ll_row = 1 to ll_totrows
				triggerevent("ue_deleteitem")
			next
		end if
	end if

// w_proformapurchase.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_listdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_list.dataobject = as_listdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)

// w_proformapurchase.wf_findsuppcode(string as_aliasname, integer ai_suppcode) returns integer
	integer li_suppcode
	integer ll_retflag
	string ls_itemname
	SQL SELECT accounts.acccode INTO :li_suppcode FROM accounts , supplier WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =supplier.suppcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_suppcode = li_suppcode
		if isnull(ai_suppcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_proformapurchase.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_proformapurchase.wf_getpomanfcode(long al_pocode, long al_manfcode) returns 0
	al_pocode = this.id_master.object.pocode[this.id_master.getrow()]
	al_manfcode = this.id_master.object.manfcode[this.id_master.getrow()]

// w_proformapurchase.wf_initmodify(integer ai_protect) returns 0
	long ll_purinvcode
	long ll_gcode
	long ll_icode
	long ll_counter = 1
	long ll_packunits
	long ll_totalpieces
	double ld_looseqty
	double ld_packqty
	double ld_bonusqty
	string ls_batch
	string ls_itemtotalval
	datetime ld_expiry
	double ld_saleprice
	double ld_avgprice
	double ld_packsalestax
	double ld_stock
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_purinvcode = this.id_master.getitemnumber(1, "code")
		if wf_lockpurchaseinvoice(ll_purinvcode) = 0 then
			for ll_counter = 1 to this.id_detail.rowcount()
				ll_gcode = this.id_detail.getitemnumber(ll_counter, "gcode")
				ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
				ld_looseqty = this.id_detail.getitemnumber(ll_counter, "looseqty")
				ld_packqty = this.id_detail.getitemnumber(ll_counter, "packqty")
				ld_bonusqty = this.id_detail.getitemnumber(ll_counter, "bonusqty")
				ll_packunits = this.id_detail.getitemnumber(ll_counter, "packunits")
				this.id_detail.object.packqty[ll_counter] = ld_packqty + ld_looseqty
				this.id_detail.object.looseqty[ll_counter] = 0
				SQL Select item.saleprice , item.avgprice , item.packsalestax INTO :ld_saleprice, :ld_avgprice, :ld_packsalestax From Item Where item.icode =:ll_icode USING this.it_transobject;
				ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
				this.id_detail.setitem(ll_counter, "itemtotalval", ls_itemtotalval)
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					ai_protect = 0
					if this.id_master.object.purcatcode[1] = 2 then
						this.id_footer.setitem(ll_counter, "stock", ld_stock - ld_looseqty - ld_packqty * ll_packunits + ld_bonusqty * ll_packunits)
					else
						this.id_footer.setitem(ll_counter, "stock", ld_stock - ld_looseqty - ld_packqty * ll_packunits + ld_bonusqty)
					end if
				end if
			next
			if ai_protect = 0 then
				this.id_footer.setitem(1, "stock", this.id_footer.getitemnumber(1, "stock"))
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
				SQL Select item.saleprice , item.avgprice , item.packsalestax , item.totalpieces INTO :ld_saleprice, :ld_avgprice, :ld_packsalestax, :ll_totalpieces From Item Where item.icode =:ll_icode USING this.it_transobject;
				this.id_footer.object.t_rpp.text = string(ld_saleprice)
				this.id_footer.object.t_avgprice.text = string(ld_avgprice)
				this.id_footer.object.piecesinhand[1] = ll_totalpieces
			end if
		end if
		return
	end if
	ai_protect = 1

// w_proformapurchase.wf_itempurchasehistory() returns 0
	s_itempurchasehistory ls_itempurchasehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itempurchasehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itempurchasehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itempurchasehistory, ls_itempurchasehistory)
	end if

// w_proformapurchase.wf_locknormalpurinvoices(long al_sinvcode, long al_linvcode) returns integer
	integer li_count
	SQL SELECT count ( *) INTO :li_count FROM purledger WITH ( UPDLOCK HOLDLOCK ) WHERE purledger.purinvcode Between :al_sinvcode and :al_linvcode AND ImpactInventory ='N' USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_proformapurchase.wf_lockpurchaseinvoice(long al_purinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From purledger WITH ( UPDLOCK HOLDLOCK ) Where purledger.purinvcode =:al_purinvcode AND purledger.ImpactInventory ='N' USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_proformapurchase.wf_lockpurinvoices(long al_sinvcode, long al_linvcode) returns integer
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM purledger WITH ( UPDLOCK HOLDLOCK ) WHERE purledger.posted ='N' AND purledger.purinvcode Between :al_sinvcode and :al_linvcode AND purledger.ImpactInventory ='N' USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_proformapurchase.wf_releaselock(long al_icode) returns boolean
	boolean retflag = true
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM godowndetail WITH ( NOLOCK ) WHERE godowndetail.Gcode =:this.ii_purchasegodownoption AND godowndetail.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_proformapurchase.wf_retrievelistall() returns long
	string[] ls_posted
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	return this.id_list.retrieve(ls_posted, this.il_groupcode, this.ii_module)

// w_proformapurchase.wf_setgodownoption() returns 0
	this.ii_purchasegodownoption = this.id_detail.getitemnumber(1, "gcode")
	if this.il_strategy = 2 or this.il_strategy = 1 and this.il_godowncount = 1 then
		this.id_detail.object.gcode.protect = 1
		this.id_detail.object.gcode.background.color = this.backcolor
	end if

// w_proformapurchase.wf_setpurchasetype(integer ai_purchasetype) returns 0

// w_proformapurchase.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	return true

// w_proformapurchase.wf_iteminfo(long al_icode, long al_gcode, double ad_purprice, double ad_discperc, double ad_avgprice, long al_packunits, double al_packsalestax, double al_gstperc, double ad_saleprice) returns boolean
	boolean retflag = true
	SQL SELECT 1 , item.salePrice , item.purdiscperc , item.avgprice , item.packunits , item.saleprice , item.packsalestax , item.gstperc1 INTO :al_gcode, :ad_purprice, :ad_discperc, :ad_avgprice, :al_packunits, :ad_saleprice, :al_packsalestax, :al_gstperc FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	al_gcode = this.ii_purchasegodownoption
	if isnull(ad_purprice) then
		ad_purprice = 0
	elseif isnull(ad_discperc) then
		ad_discperc = 0
	elseif isnull(ad_avgprice) then
		ad_avgprice = 0
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_proformapurchase.wf_setsuppinfo(long al_suppcode, datawindow ad_master) returns 0
	string ls_address
	string ls_city
	string ls_phone
	string ls_aliasname
	long ll_currow
	double ld_currbalance
	SQL SELECT supplier.address1 , supplier.city , supplier.phone , accounts.aliasname INTO :ls_address, :ls_city, :ls_phone, :ls_aliasname FROM supplier , Accounts WHERE supplier.suppcode =:al_suppcode AND supplier.suppcode =Accounts.AccCode USING this.it_transobject;
	ll_currow = ad_master.getrow()
	ll_currow = 1
	ad_master.object.aliasname[ll_currow] = ls_aliasname
	ad_master.object.address[ll_currow] = ls_address
	ad_master.object.city[ll_currow] = ls_city
	ad_master.object.phone[ll_currow] = ls_phone
	ad_master.object.suppbalance[ll_currow] = abs(this.idc_supplierlist.getitemnumber(this.idc_supplierlist.getrow(), "balance"))
	ad_master.object.creditordebit[ll_currow] = this.idc_supplierlist.getitemstring(this.idc_supplierlist.getrow(), "balancetype")

// w_proformapurchase.wf_setsuppname(string as_data) returns 0
	long ll_rowno
	ll_rowno = this.idc_supplierlist.find("accounts_name >='" + as_data + "'", 1, this.idc_supplierlist.rowcount())
	if ll_rowno > 0 then
		this.idc_supplierlist.selectrow(0, false)
		this.idc_supplierlist.setrow(ll_rowno)
		this.idc_supplierlist.scrolltorow(ll_rowno)
		this.idc_supplierlist.selectrow(ll_rowno, true)
	end if

// w_proformapurchase.wf_setquantity() returns 0
	long ll_rows
	long ll_counter
	double ld_qty
	double[] ld_qtyarr
	if this.id_master.object.posted[this.id_master.rowcount()] = "Y" then
		messagebox("Set Quantity Problem", "You can not set quantity after posting.")
		return
	end if
	ll_rows = this.id_detail.rowcount()
	if ll_rows > 0 then
		openwithparm(w_setquantity, ld_qty)
		ld_qty = message.doubleparm
		if ld_qty > 0.0 then
			for ll_counter = 1 to ll_rows
				ld_qtyarr[ll_counter] = ld_qty
				wf_update_value_extax(ll_counter, ld_qty, this.id_detail.object.purprice[ll_counter], this.id_detail.object.discperc[ll_counter])
			next
			if this.id_master.object.purcatcode[1] = 2 then
				this.id_detail.object.packqty[1, ll_rows] = ld_qtyarr
				return
			end if
			this.id_detail.object.looseqty[1, ll_rows] = ld_qtyarr
		end if
	end if

// w_proformapurchase.wf_isinvoiceinuse(long al_invoiceno) returns boolean
	long ll_found
	SQL Select count ( *) INTO :ll_found From PurLedger Where PurInvCode =:al_invoiceno and Posted ='Y' AND ImpactInventory ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_found = 0 or isnull(ll_found) then
			SQL Select count ( *) INTO :ll_found From PurLedger With ( ReadPast , RowLock , UpdLock ) Where PurInvCode =:al_invoiceno AND ImpactInventory ='N' USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ll_found = 0 then
					return true
				else
					return false
				end if
			else
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_proformapurchase.wf_retrievelist() returns long
	string[] ls_posted
	long ll_rtcode
	ls_posted[1] = "N"
	if this.ib_showinvoicelist then
		ll_rtcode = this.id_list.retrieve(ls_posted, this.il_groupcode, this.ii_module)
	else
		ll_rtcode = -1
	end if
	return ll_rtcode

// w_proformapurchase.wf_inititeminfo(long al_icode, long al_row, string as_errortext) returns boolean
	boolean retflag = true
	double ld_purprice
	double ld_discperc
	double ld_saleprice
	double ld_avgprice
	double ld_packsalestax
	double ld_gstperc
	double ld_rpp
	double ld_unitsalestax
	double ld_rpp2
	double ld_rpp3
	double ld_rpp4
	double ld_rpp5
	double ld_godownstock
	double ld_allgodownstock
	long ll_packunits
	long ll_totalpieces
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_itemtotalval
	string ls_packingdesc
	string ls_remarks
	SQL SELECT item.customicode , item.name , item.purprice , item.packunits , item.purdiscperc , item.gcode , item.saleprice , item.avgprice , item.packsalestax , item.gstperc1 , item.recentpurprice , Round ( item.packsalestax / item.packunits , 2 ) , item.recentpurprice2 , recentpurprice3 , recentpurprice4 , recentpurprice5 , item.packingdesc , item.totalpieces , item.remarks INTO :ls_fullcode, :ls_name, :ld_purprice, :ll_packunits, :ld_discperc, :li_gcode, :ld_saleprice, :ld_avgprice, :ld_packsalestax, :ld_gstperc, :ld_rpp, :ld_unitsalestax, :ld_rpp2, :ld_rpp3, :ld_rpp4, :ld_rpp5, :ls_packingdesc, :ll_totalpieces, :ls_remarks FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.ii_defaultgcode = this.id_detail.getitemnumber(al_row, "gcode")
	else
		if this.il_strategy = 2 then
			this.ii_defaultgcode = li_gcode
		end if
		if this.il_strategy = 1 then
			this.ii_defaultgcode = this.id_detail.getitemnumber(al_row, "gcode")
		end if
	end if
	ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
	this.it_transobject.getitemstocktotal(this.ii_defaultgcode, al_icode, ld_godownstock)
	this.it_transobject.getitemstockinallowedgodown(al_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.id_detail.setitem(al_row, "gcode", this.ii_defaultgcode)
	this.id_detail.setitem(al_row, "icode", al_icode)
	this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
	this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
	this.id_detail.setitem(al_row, "packunits", ll_packunits)
	this.id_detail.setitem(al_row, "piecesinhand", ll_totalpieces)
	if this.id_master.object.purcatcode[1] = 2 then
		this.id_detail.setitem(al_row, "discperc", ld_discperc)
	end if
	this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
	this.id_detail.setitem(al_row, "rate", ld_purprice)
	this.id_detail.setitem(al_row, "itemtotalval", ls_itemtotalval)
	this.id_detail.setitem(al_row, "stock", ld_godownstock)
	this.id_detail.setitem(al_row, "totalstock", ld_allgodownstock)
	this.id_detail.setitem(al_row, "packingdesc", ls_packingdesc)
	this.id_footer.object.t_rpp.text = string(ld_rpp) + " , " + string(ld_rpp2) + " , " + string(ld_rpp3) + " , " + string(ld_rpp4) + " , " + string(ld_rpp5)
	this.id_footer.object.t_avgprice.text = string(ld_avgprice)
	if this.id_master.object.purcatcode[1] = 2 then
		if f_stringpreferences("salepriceinpackpur") = "Y" then
			this.id_detail.setitem(al_row, "purprice", ld_saleprice)
		else
			this.id_detail.setitem(al_row, "purprice", ld_purprice)
		end if
		this.id_detail.setitem(al_row, "unitsalestax", ld_packsalestax)
		this.id_detail.setitem(al_row, "salepriceforitem", ld_saleprice)
	else
		if f_stringpreferences("priceinloosepur") = "Y" then
			this.id_detail.setitem(al_row, "purprice", ld_purprice / ll_packunits)
		else
			this.id_detail.setitem(al_row, "purprice", ld_saleprice / ll_packunits)
		end if
		this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
	end if
	if f_stringpreferences("pur_copyremarksinitemdesc") = "Y" and this.id_detail.getitemstatus(al_row, "itemdescription", primary!) = notmodified! then
		this.id_detail.setitem(al_row, "itemdescription", ls_remarks)
	end if
	this.id_detail.setitem(al_row, "gstperc", ld_gstperc)
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_allgodownstock)
	this.id_footer.setitem(1, "piecesinhand", ll_totalpieces)
	this.id_footer.setitem(1, "itemtotalval", ls_itemtotalval)
	wf_update_value_extax(al_row, this.id_detail.object.packqty[al_row] + this.id_detail.object.looseqty[al_row], ld_purprice, ld_discperc)
	return retflag

// w_proformapurchase.wf_fetchserverdate(boolean ab_checked) returns long
	if ab_checked then
		this.ib_fetchserverdate = true
	else
		this.ib_fetchserverdate = false
	end if
	return 0

// w_proformapurchase.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_proformapurchase.wf_setamountoninvoice() returns 0
	long ll_null
	long ll_rightfound
	double ld_netamt
	double ld_null
	string ls_null
	s_amountoninvoice lstr_amountoninvoice
	setnull(ld_null)
	setnull(ls_null)
	setnull(ll_null)
	if this.id_master.getitemstring(1, "accountfor") = "Y" then
		ld_netamt = wf_grandtotal()
		if f_stringpreferences("AskAmtOnPurchase") = "Y" then
			ll_rightfound = 0
			ll_rightfound = gds_securitywindow.find("rightcode = 584", 1, gds_securitywindow.rowcount())
			lstr_amountoninvoice.l_invcode = this.id_master.getitemnumber(1, "code")
			lstr_amountoninvoice.d_netamt = ld_netamt
			lstr_amountoninvoice.d_amt = this.id_master.getitemdecimal(1, "amt")
			if isnull(lstr_amountoninvoice.d_amt) then
				lstr_amountoninvoice.d_balance = ld_netamt
			else
				lstr_amountoninvoice.d_balance = ld_netamt - lstr_amountoninvoice.d_amt
			end if
			if isnull(this.id_master.getitemstring(1, "paymentmode")) then
				this.id_master.setitem(1, "paymentmode", f_stringpreferences("PurchasePaymentMode"))
				this.id_master.setitem(1, "paymentacccode", f_numberpreferences("PurchasePaymentAcccode"))
			end if
			lstr_amountoninvoice.c_paymentmode = this.id_master.getitemstring(1, "paymentmode")
			lstr_amountoninvoice.i_acccode = this.id_master.getitemnumber(1, "paymentacccode")
			lstr_amountoninvoice.s_reference = this.id_master.getitemstring(1, "amtreference")
			lstr_amountoninvoice.s_module = "purchase"
			if ll_rightfound > 0 then
				openwithparm(w_amountoninvoice, lstr_amountoninvoice)
				lstr_amountoninvoice = message.powerobjectparm
				this.id_master.setitem(1, "amt", lstr_amountoninvoice.d_amt)
				this.id_master.setitem(1, "paymentmode", lstr_amountoninvoice.c_paymentmode)
				this.id_master.setitem(1, "paymentacccode", lstr_amountoninvoice.i_acccode)
				this.id_master.setitem(1, "amtreference", lstr_amountoninvoice.s_reference)
			end if
			if ld_netamt - lstr_amountoninvoice.d_amt >= 0.0 then
				this.id_master.setitem(1, "outstandingamt", ld_netamt - lstr_amountoninvoice.d_amt)
			else
				this.id_master.setitem(1, "outstandingamt", 0)
			end if
		else
			this.id_master.setitem(1, "outstandingamt", ld_netamt)
			this.id_master.setitem(1, "paymentmode", ls_null)
			this.id_master.setitem(1, "paymentacccode", ll_null)
			this.id_master.setitem(1, "amtreference", ls_null)
			this.id_master.setitem(1, "amt", 0)
		end if
		return
	end if
	this.id_master.setitem(1, "outstandingamt", 0)
	this.id_master.setitem(1, "paymentmode", ls_null)
	this.id_master.setitem(1, "paymentacccode", ll_null)
	this.id_master.setitem(1, "amtreference", ls_null)
	this.id_master.setitem(1, "amt", 0)

// w_proformapurchase.wf_getitemsaleprice(long al_icode, double ad_saleprice) returns boolean
	boolean retflag = true
	SQL SELECT item.salePrice INTO :ad_saleprice FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if isnull(ad_saleprice) then
		ad_saleprice = 0
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_proformapurchase.wf_setcurrency(long al_currencycode) returns long
	long ll_currow
	long ll_retcode
	double ld_conversionfactor
	SQL SELECT ConversionFactor INTO :ld_conversionfactor FROM Currency WHERE Currency.Currencycode =:al_currencycode USING this.it_transobject;
	ll_retcode = 1
	if this.it_transobject.sqlcode = 0 then
		if ld_conversionfactor < 0.0 then
			ll_retcode = 0
		else
			ll_currow = this.id_master.getrow()
			ll_currow = 1
			this.id_master.object.conversionfactor[ll_currow] = ld_conversionfactor
			if wf_applycurrency(ld_conversionfactor) <= 0 then
				ll_retcode = 0
			end if
		end if
	else
		ll_retcode = 0
	end if
	wf_grandtotal()
	return ll_retcode

// w_proformapurchase.wf_applycurrency(double ad_conversionfactor) returns long
	long ll_detail_rowcount
	long ll_counter
	long ld_purprice
	long ll_packunits
	long ll_retcode
	long ll_icode
	integer li_retmsgcode
	double ld_saleprice
	double ld_foreignprice
	double ld_newprice
	ll_detail_rowcount = this.id_detail.rowcount()
	ll_retcode = 1
	if ll_detail_rowcount > 0 then
		wf_deleteemptydetailrow()
		for ll_counter = 1 to ll_detail_rowcount
			ll_icode = this.id_detail.object.icode[ll_counter]
			ld_purprice = this.id_detail.object.purprice[ll_counter]
			ld_foreignprice = this.id_detail.object.foreignprice[ll_counter]
			ll_packunits = this.id_detail.object.packunits[ll_counter]
			if ll_packunits = 0 or isnull(ll_packunits) then
				ll_packunits = 1
			end if
			if wf_getitemsaleprice(ll_icode, ld_saleprice) = true then
				if this.id_master.object.purcatcode[1] = 2 then
					ld_newprice = round(ld_foreignprice * ad_conversionfactor, 2)
				else
					ld_newprice = round(ld_foreignprice * ad_conversionfactor, 2)
				end if
				if ll_retcode = 1 then
					this.id_detail.object.purprice[ll_counter] = ld_newprice
				end if
			else
				ll_retcode = 0
				exit
			end if
			wf_update_value_extax(ll_counter, this.id_detail.object.looseqty[ll_counter] + this.id_detail.object.packqty[ll_counter], this.id_detail.object.purprice[ll_counter], this.id_detail.object.discperc[ll_counter])
		next
	end if
	wf_grandtotal()
	return ll_retcode

// w_proformapurchase.wf_validateitem() returns integer
	long ll_icode
	long ll_gcode
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	string ls_fullcode
	string ls_errtext
	string ls_titleerrtext
	integer il_errcode = 1
	integer li_errcode
	boolean lb_invalidrow
	integer li_null
	string ls_null
	if isnull(this.il_currrow) or this.il_currrow <= 0 then
		lb_invalidrow = true
	else
		ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	end if
	if lb_invalidrow = false and wf_genfullcode(ll_icode, ls_fullcode) > 0 then
		this.id_detail.object.fullcode[this.il_currrow] = ls_fullcode
		if not wf_inititeminfo(ll_icode, this.il_currrow, ls_errtext) then
			ls_titleerrtext = "Item Validation"
			li_errcode = -1
		end if
	else
		il_errcode = -1
	end if
	this.ib_itemvalidated = true
	if lb_invalidrow = true then
		il_errcode = -1
	elseif il_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
	end if
	return il_errcode

// w_proformapurchase.wf_populatedetaildwfrompo(long al_pocode, long al_manfcode) returns integer
	datastore lds_podetail
	datawindowchild ldc_itemdddw
	long ll_detailrows
	long ll_count
	long ll_duplrows
	integer li_result
	integer li_rtncode
	boolean populateflag = true
	double ld_godownstock
	double ld_allgodownstock
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_stock
	long ll_packunits
	long ll_retrievecount
	long ll_lockedcount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packsalestax
	double ld_gstperc
	string ls_fullcode
	if this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate Purchase order after posting!")
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 and not isnull(this.id_detail.object.icode[1]) then
		li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
		if li_result = 1 then
			for ll_count = 1 to ll_detailrows
				this.id_detail.deleterow(0)
			next
			if this.id_detail.update() <> 1 then
				messagebox("DataBase Problem", "Problem in Deleting Rows")
				return 0
			end if
			this.id_detail.reset()
		else
			populateflag = false
		end if
	end if
	if populateflag = true then
		lds_podetail = create datastore
		lds_podetail.dataobject = "d_populatepurorder"
		lds_podetail.settransobject(this.it_transobject)
		this.id_detail.reset()
		ll_rtcode = lds_podetail.retrieve(al_pocode)
		ll_rowcount = lds_podetail.rowcount()
		for ll_count = 1 to ll_rowcount
			ll_icode = lds_podetail.object.icode[ll_count]
			if wf_iteminfo(ll_icode, ll_gcode, ld_purprice, ld_discperc, ld_avgprice, ll_packunits, ld_packsalestax, ld_gstperc, ld_saleprice) = true then
				if wf_genfullcode(ll_icode, ls_fullcode) > 0 then
					this.id_detail.insertrow(0)
					this.id_detail.object.icode[ll_count] = ll_icode
					ll_gcode = this.ii_purchasegodownoption
					this.id_detail.object.gcode[ll_count] = ll_gcode
					this.id_detail.object.packingdesc[ll_count] = lds_podetail.object.packingdesc[ll_count]
					this.id_detail.object.fullcode[ll_count] = ls_fullcode
					this.id_detail.setitem(ll_count, "itemname", lds_podetail.object.itemname[ll_count])
					this.id_detail.object.batch[ll_count] = f_stringpreferences("defaultbatch")
					this.id_detail.object.expiry[ll_count] = f_datepreferences("defaultexpiry")
					this.id_detail.object.salepriceforitem[ll_count] = ld_saleprice
					this.id_detail.object.packqty[ll_count] = lds_podetail.object.reqqty[ll_count]
					if f_stringpreferences("bonusinpurchase") = "Y" then
						this.id_detail.object.bonusqty[ll_count] = lds_podetail.object.reqbonusqty[ll_count]
					end if
					this.id_detail.object.saleprice[ll_count] = ld_saleprice
					this.id_detail.object.rate[ll_count] = ld_purprice
					if f_stringpreferences("salepriceinpackpur") = "Y" then
						this.id_detail.object.purprice[ll_count] = ld_saleprice
					else
						this.id_detail.object.purprice[ll_count] = lds_podetail.object.rate[ll_count]
					end if
					this.id_detail.object.discperc[ll_count] = lds_podetail.object.discperc[ll_count]
					this.id_detail.object.unitsalestax[ll_count] = ld_packsalestax
					this.id_detail.object.gstperc[ll_count] = ld_gstperc
					this.id_detail.object.avgprice[ll_count] = ld_avgprice
					this.id_detail.object.packunits[ll_count] = ll_packunits
					this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
					this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
					this.id_detail.object.stock[ll_count] = ld_godownstock
					this.id_detail.object.totalstock[ll_count] = ld_allgodownstock
					wf_update_value_extax(ll_count, this.id_detail.object.looseqty[ll_count] + this.id_detail.object.packqty[ll_count], this.id_detail.object.purprice[ll_count], this.id_detail.object.discperc[ll_count])
					this.id_footer.object.stock[this.id_footer.getrow()] = ld_godownstock
					this.id_footer.object.totalstock[this.id_footer.getrow()] = ld_allgodownstock
					this.id_footer.object.discperc[this.id_footer.getrow()] = lds_podetail.object.invleveldiscperc[ll_count]
					this.id_detail.setitemstatus(ll_count, "purprice", primary!, notmodified!)
					ll_retrievecount = ll_retrievecount + 1
				else
					messagebox("Database Error", "Unable to generate item FullCode")
				end if
			else
				ll_lockedcount = ll_lockedcount + 1
			end if
			ll_duplrows = ll_duplrows + 1
		next
		destroy lds_podetail
	end if
	if ll_retrievecount = ll_rowcount then
		messagebox("Result", "Purchase Order retrieval is Successfull~n~r" + string(ll_rowcount) + " Items are retrieved. ")
	else
		messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " records are retrieved successfully~n~r" + string(ll_duplrows) + " records are duplicate so are not retrieved~n~r" + string(ll_lockedcount) + " records are in error")
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_proformapurchase.wf_populatefiltereditems() returns integer
	datastore lds_itemselected
	long ll_detailrows
	long ll_count
	long ll_duplrows
	double ld_godownstock
	double ld_allgodownstock
	integer li_result
	integer li_rtncode
	boolean populateflag = true
	s_arguements lstr_selecteditems
	string ls_itemtotalval
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_packunits
	double ld_stock
	long ll_retrievecount
	long ll_lockedcount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packsalestax
	double ld_gstperc
	string ls_fullcode
	if this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate items after posting!")
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		if not isnull(this.id_detail.object.icode[1]) then
			li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
			if li_result = 1 then
				for ll_count = 1 to ll_detailrows
					this.id_detail.deleterow(0)
				next
				if this.id_detail.update() <> 1 then
					messagebox("DataBase Problem", "Problem in Deleting Rows")
					return 0
				end if
			else
				populateflag = false
			end if
		else
			this.id_detail.reset()
		end if
	end if
	if populateflag = true then
		openwithparm(w_arg_item_populate3, this.ii_module)
		lstr_selecteditems = message.powerobjectparm
		this.id_detail.reset()
		lds_itemselected = create datastore
		if lstr_selecteditems.s_name2 = "OR" then
			lds_itemselected.dataobject = "d_populateditems_active"
		else
			lds_itemselected.dataobject = "d_populateditems_active_and"
		end if
		lds_itemselected.settransobject(this.it_transobject)
		this.id_detail.reset()
		ll_rtcode = lds_itemselected.retrieve(lstr_selecteditems.ia_integerlist, lstr_selecteditems.ia_integerlist1, lstr_selecteditems.ia_integerlist2, lstr_selecteditems.la_longlist, lstr_selecteditems.l_code1, lstr_selecteditems.s_name1)
		ll_rowcount = lds_itemselected.rowcount()
		for ll_count = 1 to ll_rowcount
			ll_icode = lds_itemselected.object.icode[ll_count]
			if wf_genfullcode(ll_icode, ls_fullcode) > 0 then
				this.id_detail.insertrow(0)
				this.id_detail.object.icode[ll_count] = ll_icode
				ll_gcode = lds_itemselected.object.gcode[ll_count]
				if isnull(ll_gcode) then
					this.id_detail.object.gcode[ll_count] = this.ii_purchasegodownoption
					ll_gcode = this.ii_purchasegodownoption
				else
					this.id_detail.object.gcode[ll_count] = ll_gcode
				end if
				this.id_detail.object.fullcode[ll_count] = ls_fullcode
				this.id_detail.object.itemname[ll_count] = lds_itemselected.object.name[ll_count]
				this.id_detail.object.batch[ll_count] = f_stringpreferences("defaultbatch")
				this.id_detail.object.expiry[ll_count] = f_datepreferences("defaultexpiry")
				this.id_detail.object.saleprice[ll_count] = lds_itemselected.object.saleprice[ll_count]
				this.id_detail.object.rate[ll_count] = lds_itemselected.object.rate[ll_count]
				if this.id_master.object.purcatcode[1] = 2 then
					this.id_detail.object.packqty[ll_count] = lds_itemselected.object.qty[ll_count]
					this.id_detail.object.salepriceforitem[ll_count] = lds_itemselected.object.saleprice[ll_count]
				else
					this.id_detail.object.looseqty[ll_count] = lds_itemselected.object.qty[ll_count]
				end if
				if f_stringpreferences("salepriceinpackpur") = "Y" then
					if this.id_master.object.purcatcode[1] = 2 then
						this.id_detail.object.purprice[ll_count] = lds_itemselected.object.saleprice[ll_count]
					else
						this.id_detail.object.purprice[ll_count] = lds_itemselected.object.saleprice[ll_count] / lds_itemselected.object.packunits[ll_count]
					end if
				elseif this.id_master.object.purcatcode[1] = 2 then
					this.id_detail.object.purprice[ll_count] = lds_itemselected.object.rate[ll_count]
				else
					this.id_detail.object.purprice[ll_count] = lds_itemselected.object.rate[ll_count] / lds_itemselected.object.packunits[ll_count]
				end if
				this.id_detail.object.unitsalestax[ll_count] = lds_itemselected.object.packsalestax[ll_count]
				this.id_detail.object.gstperc[ll_count] = lds_itemselected.object.gstperc[ll_count]
				this.id_detail.object.discperc[ll_count] = lds_itemselected.object.discperc[ll_count]
				this.id_detail.object.avgprice[ll_count] = lds_itemselected.object.avgprice[ll_count]
				this.id_detail.object.packunits[ll_count] = lds_itemselected.object.packunits[ll_count]
				this.id_detail.object.packingdesc[ll_count] = lds_itemselected.object.packingdesc[ll_count]
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
				this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
				ls_itemtotalval = string(lds_itemselected.object.saleprice[ll_count], "######0.00") + " + " + string(lds_itemselected.object.packsalestax[ll_count], "######0.00") + " =  " + string(lds_itemselected.object.saleprice[ll_count] + lds_itemselected.object.packsalestax[ll_count], "#####0.00")
				this.id_detail.object.stock[ll_count] = ld_godownstock
				this.id_detail.object.totalstock[ll_count] = ld_allgodownstock
				this.id_detail.object.itemtotalval[ll_count] = ls_itemtotalval
				wf_update_value_extax(ll_count, this.id_detail.object.looseqty[ll_count] + this.id_detail.object.packqty[ll_count], this.id_detail.object.purprice[ll_count], this.id_detail.object.discperc[ll_count])
				this.id_footer.object.stock[ll_count] = ld_godownstock
				this.id_footer.object.totalstock[ll_count] = ld_allgodownstock
				this.id_footer.object.itemtotalval[ll_count] = ls_itemtotalval
				if this.it_transobject.sqlcode = -1 then
					messagebox("Database Error", "Database Error: Item information can not be retrieved")
				end if
				this.id_detail.setitemstatus(ll_count, "purprice", primary!, notmodified!)
				ll_retrievecount = ll_retrievecount + 1
			else
				messagebox("Database Error", "Can not generate item FullCode")
			end if
		next
		destroy lds_itemselected
		if ll_retrievecount = ll_rowcount then
			messagebox("Result", string(ll_rowcount) + " Items are populated. ")
		else
			messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " records are retrieved successfully~n~r" + string(ll_duplrows) + " records are duplicate so are not retrieved~n~r" + string(ll_lockedcount) + " records are in error")
		end if
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_proformapurchase.wf_populatepurorder() returns integer
	datastore lds_itemselected
	long ll_detailrows
	long ll_count
	long ll_duplrows
	long ll_purordercount
	double ld_godownstock
	double ld_allgodownstock
	double ld_stock
	integer li_result
	integer li_rtncode
	boolean populateflag = true
	s_saletemplate lstr_template
	string ls_itemtotalval
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_retrievecount
	long ll_lockedcount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packsalestax
	double ld_gstperc
	double ld_unitsalestax
	string ls_fullcode
	if this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate items after posting!")
		return 0
	end if
	setpointer(hourglass!)
	this.id_detail.setredraw(false)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		if not isnull(this.id_detail.object.icode[1]) then
			li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
			if li_result = 1 then
				for ll_count = 1 to ll_detailrows
					this.id_detail.deleterow(0)
				next
				if this.id_detail.update() <> 1 then
					messagebox("DataBase Problem", "Problem in Deleting Rows")
					return 0
				end if
			else
				populateflag = false
			end if
		else
			this.id_detail.reset()
		end if
	end if
	if populateflag = true then
		open(w_copypurinvoicefrom)
		lstr_template = message.powerobjectparm
		if lstr_template.b_userinput = true then
			setpointer(hourglass!)
			lds_itemselected = create datastore
			lds_itemselected.dataobject = "d_populatepurorder"
			lds_itemselected.settransobject(this.it_transobject)
			this.id_detail.reset()
			ll_rtcode = lds_itemselected.retrieve(lstr_template.l_invtemplate)
			ll_rowcount = lds_itemselected.rowcount()
			ll_gcode = this.ii_purchasegodownoption
			if this.id_master.object.purcatcode[1] = 2 then
				this.id_master.setitem(this.id_master.getrow(), "pocode", lstr_template.l_invtemplate)
				this.id_master.setitem(this.id_master.getrow(), "podate", datetime(lstr_template.d_date))
			end if
			for ll_count = 1 to ll_rowcount
				this.id_detail.insertrow(0)
				ll_icode = lds_itemselected.object.icode[ll_count]
				this.id_detail.object.icode[ll_count] = ll_icode
				if this.ii_purchasegodownoption = 2 then
					ll_gcode = lds_itemselected.object.gcode[ll_count]
				end if
				this.id_detail.object.gcode[ll_count] = ll_gcode
				this.id_detail.object.fullcode[ll_count] = lds_itemselected.object.fullcode[ll_count]
				this.id_detail.object.itemname[ll_count] = lds_itemselected.object.itemname[ll_count]
				this.id_detail.object.batch[ll_count] = "."
				this.id_detail.object.saleprice[ll_count] = lds_itemselected.object.saleprice[ll_count]
				this.id_detail.object.rate[ll_count] = lds_itemselected.object.rate[ll_count]
				if this.id_master.object.purcatcode[1] = 2 then
					this.id_detail.object.packqty[ll_count] = lds_itemselected.object.qty[ll_count]
				else
					this.id_detail.object.looseqty[ll_count] = lds_itemselected.object.qty[ll_count] * lds_itemselected.object.packunits[ll_count]
				end if
				this.id_detail.object.expiry[ll_count] = datetime(date("12/12/2010"))
				if f_stringpreferences("salepriceinpackpur") = "Y" then
					if this.id_master.object.purcatcode[1] = 2 then
						this.id_detail.object.purprice[ll_count] = lds_itemselected.object.saleprice[ll_count]
					else
						this.id_detail.object.purprice[ll_count] = lds_itemselected.object.saleprice[ll_count] / lds_itemselected.object.packunits[ll_count]
					end if
				elseif this.id_master.object.purcatcode[1] = 2 then
					this.id_detail.object.purprice[ll_count] = lds_itemselected.object.rate[ll_count]
				else
					this.id_detail.object.purprice[ll_count] = lds_itemselected.object.rate[ll_count] / lds_itemselected.object.packunits[ll_count]
				end if
				if this.id_master.object.purcatcode[1] = 2 then
					this.id_detail.object.unitsalestax[ll_count] = lds_itemselected.object.packsalestax[ll_count]
					this.id_detail.object.discperc[ll_count] = lds_itemselected.object.discperc[ll_count]
				else
					ld_unitsalestax = round(lds_itemselected.object.packsalestax[ll_count] / lds_itemselected.object.packunits[ll_count], 2)
					this.id_detail.object.unitsalestax[ll_count] = ld_unitsalestax
				end if
				this.id_detail.object.gstperc[ll_count] = lds_itemselected.object.gstperc[ll_count]
				this.id_detail.object.avgprice[ll_count] = lds_itemselected.object.avgprice[ll_count]
				this.id_detail.object.packunits[ll_count] = lds_itemselected.object.packunits[ll_count]
				this.id_detail.object.packingdesc[ll_count] = lds_itemselected.object.packingdesc[ll_count]
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
				this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
				ls_itemtotalval = string(lds_itemselected.object.saleprice[ll_count], "######0.00") + " + " + string(lds_itemselected.object.packsalestax[ll_count], "######0.00") + " =  " + string(lds_itemselected.object.saleprice[ll_count] + lds_itemselected.object.packsalestax[ll_count], "#####0.00")
				this.id_detail.object.stock[ll_count] = ld_godownstock
				this.id_detail.object.totalstock[ll_count] = ld_allgodownstock
				this.id_detail.object.itemtotalval[ll_count] = ls_itemtotalval
				wf_update_value_extax(ll_count, this.id_detail.object.looseqty[ll_count] + this.id_detail.object.packqty[ll_count], this.id_detail.object.purprice[ll_count], this.id_detail.object.discperc[ll_count])
				this.id_footer.object.stock[this.id_footer.getrow()] = ld_godownstock
				this.id_footer.object.totalstock[this.id_footer.getrow()] = ld_allgodownstock
				if this.it_transobject.sqlcode = -1 then
					messagebox("Database Error", "Database Error: Item stock information can not be retrieved")
				end if
				this.id_detail.setitemstatus(ll_count, "purprice", primary!, notmodified!)
				ll_retrievecount = ll_retrievecount + 1
			next
			destroy lds_itemselected
		end if
		if ll_retrievecount = ll_rowcount then
			messagebox("Result", string(ll_rowcount) + " Items are populated. ")
		else
			messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " records are retrieved successfully~n~r" + string(ll_duplrows) + " records are duplicate so are not retrieved~n~r" + string(ll_lockedcount) + " records are in error")
		end if
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_proformapurchase.wf_setpurorderinfo(long al_purordercode) returns long
	long ll_suppcode
	long ll_salesmancode
	long ll_row
	long ll_manfcode = 1
	integer li_rtcode
	datetime ld_podate
	string ls_podate
	string ls_manfname
	string ls_suppref
	SQL SELECT purorderheader.manfcode , purorderheader.suppcode , purorderheader.date , supplierreference INTO :ll_manfcode, :ll_suppcode, :ld_podate, :ls_suppref FROM purorderheader WHERE purorderheader.pocode =:al_purordercode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Cannot Connect to Database", this.it_transobject.sqlerrtext)
		li_rtcode = -1
	end if
	if isnull(ll_manfcode) then
		ll_manfcode = 1
	end if
	SQL SELECT manufacturer.name INTO :ls_manfname FROM manufacturer WHERE manufacturer.manfcode =:ll_manfcode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Cannot Connect to Database", this.it_transobject.sqlerrtext)
		li_rtcode = -1
	end if
	ll_row = this.id_master.getrow()
	ll_row = 1
	this.id_master.object.podate[ll_row] = ld_podate
	this.id_master.object.manfname[ll_row] = ls_manfname
	this.id_master.object.manfcode[ll_row] = ll_manfcode
	this.id_master.object.suppcode[ll_row] = ll_suppcode
	this.id_master.object.posupplierreference[ll_row] = ls_suppref
	wf_setsuppinfo(ll_suppcode, this.id_master)
	return ll_manfcode

// w_proformapurchase.wf_showaccountledger() returns 0
	long ll_acccode
	if wf_iseditable() = false then
		return
	end if
	if this.tab_retrieve.selectedtab = 1 then
		ll_acccode = this.id_master.getitemnumber(this.id_master.getrow(), "suppcode")
		if not isnull(ll_acccode) and this.id_master.rowcount() > 0 then
			openwithparm(w_account_ledger, ll_acccode)
		end if
	end if

// w_proformapurchase.wf_showsummaryaccountbalance() returns 0
	long ll_acccode
	if wf_iseditable() = false then
		return
	end if
	if this.tab_retrieve.selectedtab = 1 then
		ll_acccode = this.id_master.getitemnumber(this.id_master.getrow(), "suppcode")
		if not isnull(ll_acccode) and this.id_master.rowcount() > 0 then
			openwithparm(w_summaccount_balance, ll_acccode)
		end if
	end if

// w_proformapurchase.wf_selectprintreport(string as_pagesize) returns string
	string ls_report
	if as_pagesize = "F" then
		ls_report = "d_proforma_purinvoice"
	elseif as_pagesize = "H" then
		ls_report = "d_proforma_purinvoice_half"
	elseif as_pagesize = "Q" then
		ls_report = "d_proforma_purinvoice_quarter"
	end if
	this.id_print.dataobject = ls_report
	this.id_print.settransobject(this.it_transobject)
	return ls_report

// w_proformapurchase.wf_purchaseslip() returns 0
	long ll_invcode
	if this.tab_retrieve.selectedtab = 2 then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
		openwithparm(w_purinv_slip, ll_invcode)
	end if

// w_proformapurchase.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to 1 step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_proformapurchase.wf_saveandpost() returns 0
	integer li_postingmode = 2
	long ll_sinvcode
	long ll_linvcode
	boolean lb_commitflag = true
	event ue_save()
	if this.ib_commitok then
		ll_sinvcode = this.id_master.getitemnumber(1, "code")
		ll_linvcode = this.id_master.getitemnumber(1, "code")
		if isnull(ll_sinvcode) or isnull(ll_linvcode) or ll_sinvcode < 0 and ll_linvcode < 0 then
			return
		else
			lb_commitflag = wf_post_purchase(li_postingmode, ll_sinvcode, ll_linvcode)
		end if
	end if
	setpointer(arrow!)

// w_proformapurchase.wf_post() returns boolean
	integer li_postingmode = 1
	long ll_sinvcode
	long ll_linvcode
	setnull(ll_sinvcode)
	setnull(ll_linvcode)
	return wf_post_purchase(li_postingmode, ll_sinvcode, ll_linvcode)

// w_proformapurchase.wf_grandtotal() returns double
	long ll_counter
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_itemleveltax
	double ld_invgstpercval
	double ld_totalsalestax
	double ld_invgstperc1
	double ld_netrate
	double ld_discperc
	double ld_flatdisc
	double ld_misccharges
	double ld_salestax
	double ld_itemstotal
	double ld_invlevelvalues
	double ld_discpercvalue
	double ld_grossvalue
	double ld_itemgrossvalue
	double ld_totqty
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		ld_discperc = round(this.id_footer.getitemnumber(1, "discperc"), 2)
		ld_flatdisc = round(this.id_footer.getitemnumber(1, "flatdisc"), 2)
		ld_misccharges = round(this.id_footer.getitemnumber(1, "misccharges"), 2)
		ld_salestax = round(this.id_footer.getitemnumber(1, "salestax"), 2)
		if isnull(ld_discperc) then
			ld_discperc = 0.00
		end if
		if isnull(ld_flatdisc) then
			ld_flatdisc = 0.00
		end if
		if isnull(ld_misccharges) then
			ld_misccharges = 0.00
		end if
		if isnull(ld_salestax) then
			ld_salestax = 0.00
		end if
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "d_detaildwtotal")
		ld_invgstperc1 = this.id_footer.getitemnumber(1, "invgstperc1")
		ld_itemleveltax = this.id_detail.object.c_sumtaxval[1] + this.id_detail.object.c_sumgstval[1]
		ld_invgstpercval = round((round(ld_detaildwtotal * (1.0 - 0.01 * ld_discperc), 2) - ld_flatdisc) * 0.01 * ld_invgstperc1, 2)
		ld_discpercvalue = round(ld_detaildwtotal * ld_discperc * 0.01, 5)
		ld_totalsalestax = round(ld_invgstpercval + ld_itemleveltax, 0)
		ld_grandtotal = ld_detaildwtotal * (1.0 - ld_discperc * 0.01) - ld_flatdisc + ld_misccharges + ld_salestax
		ld_grandtotal = round(ld_grandtotal, 0) + ld_totalsalestax
		this.id_footer.setitem(1, "total", ld_grandtotal)
		ld_detaildwtotal = this.id_footer.getitemnumber(1, "total")
		ld_invlevelvalues = ld_invgstpercval + ld_misccharges - ld_flatdisc - ld_discpercvalue
		if ld_invlevelvalues = 0.0 or isnull(ld_invlevelvalues) then
			ld_invlevelvalues = 0
		end if
		ld_grossvalue = this.id_detail.object.c_total_finalitemval[1]
		if ld_grossvalue = 0.0 or isnull(ld_grossvalue) then
			ld_grossvalue = 1
		end if
		if f_stringpreferences("ShowNetRateInPurchase") = "Y" then
			for ll_counter = 1 to this.id_detail.rowcount()
				ld_totqty = this.id_detail.object.looseqty[ll_counter] + this.id_detail.object.packqty[ll_counter] + this.id_detail.object.bonusqty[ll_counter]
				if ld_totqty = 0.0 or isnull(ld_totqty) then
					ld_totqty = 1
				end if
				ld_itemgrossvalue = this.id_detail.object.c_finalitemval[ll_counter]
				ld_netrate = (ld_itemgrossvalue / ld_grossvalue * ld_invlevelvalues + ld_itemgrossvalue) / ld_totqty
				this.id_detail.object.netrate[ll_counter] = round(ld_netrate, 5)
			next
		end if
	end if
	return ld_grandtotal

// w_proformapurchase.wf_allowpurchasemodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM ProformaPurDetail WHERE PurInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_proformapurchase.wf_post_purchase(integer ai_postingmode, long al_startinginvcode, long al_endinginvcode) returns boolean
	long ll_code1
	long ll_code2
	long ll_headerno
	long ll_headerinvno
	long ll_pocode
	long ll_duedoccode
	integer li_errcode
	integer li_rtncode
	long ll_supplieracc
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_salesmancode
	long ll_errrowid
	integer li_detailcounter
	integer li_purchasecategory
	boolean lb_commitflag = true
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_errortext
	string ls_batchprefix
	long ll_rowcount
	long ll_invcounter
	long ll_invcode
	s_arguements lstr_arginfo
	ls_batchprefix = ""
	if ai_postingmode = 1 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if ai_postingmode = 1 then
			open(w_arg_sinvcode_linvcode)
			lstr_arginfo = message.powerobjectparm
		else
			lstr_arginfo.l_code1 = al_startinginvcode
			lstr_arginfo.l_code2 = al_endinginvcode
			lstr_arginfo.i_status = 1
		end if
		if lstr_arginfo.i_status = 1 then
			if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return false
			end if
			setpointer(hourglass!)
			ll_code1 = lstr_arginfo.l_code1
			ll_code2 = lstr_arginfo.l_code2
			li_errcode = wf_lockpurinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
			if li_errcode = 0 then
				SQL rollback USING this.it_transobject;
				SQL update PurLedger SET Posted ='Y' , PostDate =:ldt_server_datetime , PostedBY =:ll_salesmancode FROM PurLedger WHERE PurLedger.PurInvCode BETWEEN :ll_code1 AND :ll_code2 AND PurLedger.Posted ='N' AND purledger.ImpactInventory ='N' USING this.it_transobject;
				if this.it_transobject.sqlcode = 0 then
					SQL commit USING this.it_transobject;
					messagebox("Posting Completed Successfully", "Posting Done Successfully.", information!)
					lb_commitflag = true
				else
					ls_errortext = this.it_transobject.sqlerrtext
					SQL rollback USING this.it_transobject;
					messagebox("Posting Problem!", "Posting Failed For Some Invoices.~r~nReason:-~r~n" + ls_errortext, stopsign!)
					lb_commitflag = false
				end if
			end if
		end if
	end if
	setpointer(arrow!)
	return lb_commitflag

// w_proformapurchase.wf_printbarcode() returns 0
	s_datawindow lstr_arg
	string ls_datawindow
	datastore lds_detail
	lds_detail = create datastore
	lds_detail.dataobject = this.id_detail.dataobject
	lds_detail.settransobject(this.it_transobject)
	this.id_detail.rowscopy(this.id_detail.getrow(), this.id_detail.rowcount(), primary!, lds_detail, 1, primary!)
	lstr_arg.l_code2 = this.id_master.getitemnumber(1, "purcatcode")
	if this.tab_retrieve.selectedtab = 1 then
		lstr_arg.dws = lds_detail
		lstr_arg.l_code = lstr_arg.l_code2
		openwithparm(w_barcodelabels_popup, lstr_arg)
	end if

// w_proformapurchase.wf_grandtotal_with_update_netrate() returns double
	long ll_counter
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_itemleveltax
	double ld_invgstpercval
	double ld_totalsalestax
	double ld_invgstperc1
	double ld_netrate
	double ld_discperc
	double ld_flatdisc
	double ld_misccharges
	double ld_salestax
	double ld_itemstotal
	double ld_invlevelvalues
	double ld_discpercvalue
	double ld_grossvalue
	double ld_itemgrossvalue
	double ld_totqty
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		ld_discperc = round(this.id_footer.getitemnumber(1, "discperc"), 2)
		ld_flatdisc = round(this.id_footer.getitemnumber(1, "flatdisc"), 2)
		ld_misccharges = round(this.id_footer.getitemnumber(1, "misccharges"), 2)
		ld_salestax = round(this.id_footer.getitemnumber(1, "salestax"), 2)
		if isnull(ld_discperc) then
			ld_discperc = 0.00
		end if
		if isnull(ld_flatdisc) then
			ld_flatdisc = 0.00
		end if
		if isnull(ld_misccharges) then
			ld_misccharges = 0.00
		end if
		if isnull(ld_salestax) then
			ld_salestax = 0.00
		end if
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "d_detaildwtotal")
		ld_invgstperc1 = this.id_footer.getitemnumber(1, "invgstperc1")
		ld_itemleveltax = this.id_detail.object.c_sumtaxval[1] + this.id_detail.object.c_sumgstval[1]
		ld_invgstpercval = round((round(ld_detaildwtotal * (1.0 - 0.01 * ld_discperc), 2) - ld_flatdisc) * 0.01 * ld_invgstperc1, 2)
		ld_discpercvalue = round(ld_detaildwtotal * ld_discperc * 0.01, 5)
		ld_totalsalestax = round(ld_invgstpercval + ld_itemleveltax, 0)
		ld_grandtotal = ld_detaildwtotal * (1.0 - ld_discperc * 0.01) - ld_flatdisc + ld_misccharges + ld_salestax
		ld_grandtotal = round(ld_grandtotal, 0) + ld_totalsalestax
		this.id_footer.setitem(1, "total", ld_grandtotal)
		ld_detaildwtotal = this.id_footer.getitemnumber(1, "total")
		ld_invlevelvalues = ld_invgstpercval + ld_misccharges - ld_flatdisc - ld_discpercvalue
		if ld_invlevelvalues = 0.0 or isnull(ld_invlevelvalues) then
			ld_invlevelvalues = 0
		end if
		ld_grossvalue = this.id_detail.object.c_total_finalitemval[1]
		if ld_grossvalue = 0.0 or isnull(ld_grossvalue) then
			ld_grossvalue = 1
		end if
		for ll_counter = 1 to this.id_detail.rowcount()
			ld_totqty = this.id_detail.object.looseqty[ll_counter] + this.id_detail.object.packqty[ll_counter] + this.id_detail.object.bonusqty[ll_counter]
			if ld_totqty = 0.0 or isnull(ld_totqty) then
				ld_totqty = 1
			end if
			ld_itemgrossvalue = this.id_detail.object.c_finalitemval[ll_counter]
			ld_netrate = (ld_itemgrossvalue / ld_grossvalue * ld_invlevelvalues + ld_itemgrossvalue) / ld_totqty
			this.id_detail.object.netrate[ll_counter] = round(ld_netrate, 5)
		next
	end if
	return ld_grandtotal

// w_proformapurchase.wf_searchitem_quicksearch(string as_str) returns long
	long ll_found
	long ll_code
	long ll_listcurrrow
	long rt_code = 1
	long ll_row
	long ll_icode
	integer li_errcode
	string ls_errtext
	if as_str = "" or isnull(as_str) then
		rt_code = 0
	else
		ll_code = f_searchitem_quicksearch(as_str, this.it_transobject)
		if ll_code > 0 then
			ll_found = this.id_itemslist.find("icode = " + string(ll_code), 1, this.id_itemslist.rowcount())
			if ll_found > 0 then
				ll_listcurrrow = ll_found
				this.id_itemslist.selectrow(0, false)
				ll_row = this.id_detail.getrow()
				ll_icode = ll_code
				wf_inititeminfo(ll_icode, ll_row, ls_errtext)
				if this.il_currrow > 0 then
					this.id_itemslist.selectrow(this.il_currrow, false)
				end if
				this.id_itemslist.selectrow(ll_listcurrrow, true)
				this.id_detail.setitem(this.id_detail.getrow(), this.is_columnitemname, this.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				this.id_detail.setitem(this.id_detail.getrow(), "icode", this.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				this.id_detail.setitem(this.id_detail.getrow(), "fullcode", this.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
				this.ib_itemvalidated = false
				this.il_currrow = this.id_detail.getrow()
				this.id_detail.setitem(this.id_detail.getrow(), "CurrListRow", ll_listcurrrow)
				rt_code = 0
			end if
		end if
	end if
	return rt_code

// w_proformapurchase.wf_itemstockinfo(long al_icode, long al_gcode, double ad_stock) returns boolean
	boolean retflag = true
	double ld_stock
	double ld_totalstock
	ad_stock = 100
	return retflag

// w_proformapurchase.wf_setiteminfo(long al_icode, long al_row, long ad_gcode, double ad_saleprice, double ad_discperc, double ad_stock) returns 0
	this.id_detail.setitem(al_row, "gcode", ad_gcode)
	this.id_detail.setitem(al_row, "purprice", ad_saleprice)
	this.id_detail.setitem(al_row, "discperc", ad_discperc)
	this.id_footer.object.stock[this.id_footer.getrow()] = ad_stock

// w_proformapurchase.wf_set_itemtotal_formatmask() returns long
	string ls_modify
	string ls_format
	ls_format = trim(f_stringpreferences("FormatForAmtInPur"))
	ls_modify = "c_total.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "d_detaildwtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_finalitemval.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_total_finalitemval.Format='" + ls_format + "'  "
	this.id_detail.modify(ls_modify)
	return 0

