		lm_menu.m_file.m_printbarcode.enabled = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 597", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_showaccountledger.visible = true
	end if
