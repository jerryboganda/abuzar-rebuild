		lm_menu.m_file.m_showpobasedpurchasedisparity.enabled = true
	else
		lm_menu.m_file.m_showpobasedpurchasedisparity.visible = false
		lm_menu.m_file.m_showpobasedpurchasedisparity.enabled = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 682", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_quicksale.visible = true
		lm_menu.m_file.m_quicksale.enabled = true
	else
		lm_menu.m_file.m_quicksale.visible = false
		lm_menu.m_file.m_quicksale.enabled = false
