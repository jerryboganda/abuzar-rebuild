// window w_cashierjobactivity_cashtendered (cashierjob)  ancestor: window

// w_cashierjobactivity_cashtendered.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	return ::message.returnvalue

// w_cashierjobactivity_cashtendered.ue_close(integer ai_closemode) returns integer
	long ll_currrow
	long ll_counter
	long ll_doccode
	long ll_invexists
	long ll_saleinvcode
	string[] ls_values
	s_dw_header ls_dw_header
	ll_currrow = this.id_header.getrow()
	if ai_closemode = -1 then
		closewithreturn(this, ai_closemode)
		return -1
	end if
	if this.id_header.rowcount() > 0 then
		if f_validatedw(this.id_header) < 0 then
			return 1
		end if
		if isnull(this.id_header.getitemnumber(ll_currrow, "doccode")) then
			this.id_header.deleterow(ll_currrow)
		end if
		this.il_currrow = this.id_header.rowcount()
		if this.ib_rowvalidated = false and wf_validateitem() = -1 then
			return 1
		end if
		for ll_counter = 1 to this.id_header.rowcount()
			if isnull(this.id_header.getitemnumber(ll_counter, "doccode")) then
				this.id_header.deleterow(ll_counter)
			end if
		next
		for ll_counter = 1 to this.id_header.rowcount()
			ll_doccode = this.id_header.getitemnumber(ll_counter, "doccode")
			ll_invexists = 0
			SQL Select Count ( *) INTO :ll_invexists From SaleLedger Where SaleInvCode =:ll_doccode USING this.it_transobject;
			if ll_invexists <= 0 then
				messagebox("Associated SaleInv Existance Error", "Given Document Code : " + string(ll_doccode) + " does not exist in SaleLedger")
				return -1
			end if
			ll_invexists = 0
			if this.ib_modifystatus then
			end if
			ll_invexists = 0
		next
	end if
	closewithreturn(this, ai_closemode)
	return 0

// w_cashierjobactivity_cashtendered.wf_validateitem() returns integer
	long ll_doccode
	long ll_module
	long ll_found
	long ll_retcode
	double ld_amount
	integer li_errcode
	integer li_null
	ll_module = this.id_header.getitemnumber(this.il_currrow, "module")
	ll_doccode = this.id_header.getitemnumber(this.il_currrow, "doccode")
	if isnull(ll_doccode) then
		li_errcode = -1
		this.ib_rowvalidated = false
	else
		ll_found = this.id_header.find("module = " + string(ll_module) + " and doccode = " + string(ll_doccode), 1, this.id_header.rowcount())
		if ll_found > 0 and ll_found <= this.id_header.rowcount() and ll_found <> this.il_currrow then
			messagebox("Duplication Error", "Current row is duplicate")
			li_errcode = -1
			this.ib_rowvalidated = false
		else
			ll_retcode = wf_get_document_info(this.il_currrow, ll_module, ll_doccode)
			if ll_retcode = 0 then
				li_errcode = 0
				this.ib_rowvalidated = true
			else
				li_errcode = -1
				this.ib_rowvalidated = false
			end if
		end if
	end if
	if li_errcode = -1 then
		setnull(li_null)
		this.id_header.setcolumn("doccode")
		this.id_header.scrolltorow(this.il_currrow)
		this.id_header.object.doccode[this.il_currrow] = li_null
	end if
	return li_errcode

// w_cashierjobactivity_cashtendered.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_cashierjobactivity_cashtendered.wf_setbalance(long al_row, string as_col, double ad_amt) returns long
	double ld_totamt
	ld_totamt = this.id_header.getitemnumber(1, "c_total")
	if ld_totamt >= 0.0 then
		if as_col = "cashtendered" then
			if ad_amt > ld_totamt then
				this.dw_cash.object.cashcharged[al_row] = ld_totamt
				this.dw_cash.object.cashback[al_row] = ad_amt - this.dw_cash.object.cashcharged[al_row]
			else
				this.dw_cash.object.cashcharged[al_row] = ad_amt
				this.dw_cash.object.cashback[al_row] = this.dw_cash.object.cashcharged[al_row] - ad_amt
			end if
		elseif as_col = "cashcharged" then
			if ad_amt > this.dw_cash.object.cashtendered[al_row] then
				this.dw_cash.object.cashback[al_row] = 0
			else
				this.dw_cash.object.cashback[al_row] = this.dw_cash.object.cashtendered[al_row] - ad_amt
			end if
		end if
	elseif as_col = "cashtendered" then
		ld_totamt = abs(ld_totamt)
		if ad_amt >= ld_totamt then
			this.dw_cash.object.cashcharged[al_row] = ld_totamt
			this.dw_cash.object.cashback[al_row] = ad_amt - this.dw_cash.object.cashcharged[al_row]
		else
			this.dw_cash.object.cashcharged[al_row] = ad_amt
			this.dw_cash.object.cashback[al_row] = this.dw_cash.object.cashcharged[al_row] - ad_amt
		end if
	elseif as_col = "cashcharged" then
		if ad_amt > this.dw_cash.object.cashtendered[al_row] then
			this.dw_cash.object.cashback[al_row] = 0
		else
			this.dw_cash.object.cashback[al_row] = this.dw_cash.object.cashtendered[al_row] - ad_amt
		end if
	end if
	return 0

// w_cashierjobactivity_cashtendered.wf_get_document_info(long al_row, long ai_module, long al_doccode) returns long
	long ll_rowid
	long ll_moduleid
	long ll_catcode
	long ll_acccode
	long ll_usercode
	long ll_headerno
	long ll_headerinvno
	long ll_cashacccode
	long ll_cashierjobcode
	long ll_glvochcode
	double ld_amount
	double ld_cashtendered
	double ld_cashcharged
	double ld_cashback
	string ls_category
	string ls_machinename
	string ls_remarks
	string ls_printed
	string ls_supervised
	string ls_errortext
	date ldt_date
	date ldt_supervisedon
	boolean lb_continue
	if ai_module = 1 then
		SQL SELECT RowID , Date , ModuleID , CatCode , Category , AccCode , UserCode , MachineName , HeaderNo , HeaderInvNo , Amount , CashAccCode , CashTendered , CashCharged , CashBack , Remarks , CashierJobCode , Printed , Supervised , SupervisedOn , GLVochCode INTO :ll_rowid, :ldt_date, :ll_moduleid, :ll_catcode, :ls_category, :ll_acccode, :ll_usercode, :ls_machinename, :ll_headerno, :ll_headerinvno, :ld_amount, :ll_cashacccode, :ld_cashtendered, :ld_cashcharged, :ld_cashback, :ls_remarks, :ll_cashierjobcode, :ls_printed, :ls_supervised, :ldt_supervisedon, :ll_glvochcode FROM CashierActivity WHERE ModuleID IN ( 10 , 11 ) AND DocCode =:al_doccode USING this.it_transobject;
	else
		SQL SELECT RowID , Date , ModuleID , CatCode , Category , AccCode , UserCode , MachineName , HeaderNo , HeaderInvNo , Amount , CashAccCode , CashTendered , CashCharged , CashBack , Remarks , CashierJobCode , Printed , Supervised , SupervisedOn , GLVochCode INTO :ll_rowid, :ldt_date, :ll_moduleid, :ll_catcode, :ls_category, :ll_acccode, :ll_usercode, :ls_machinename, :ll_headerno, :ll_headerinvno, :ld_amount, :ll_cashacccode, :ld_cashtendered, :ld_cashcharged, :ld_cashback, :ls_remarks, :ll_cashierjobcode, :ls_printed, :ls_supervised, :ldt_supervisedon, :ll_glvochcode FROM CashierActivity WHERE ModuleID IN ( 31 , 32 ) AND DocCode =:al_doccode USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		if al_row > 0 then
			if ll_cashierjobcode > 0 then
				lb_continue = false
				ls_errortext = "This Document code is Associated with some other Cashier Job Code = " + string(ll_cashierjobcode)
			end if
			if ls_supervised = "Y" then
				lb_continue = false
				ls_errortext = "This Document code is already Supervised. Associated Cashier Job Code = " + string(ll_cashierjobcode)
			end if
			if lb_continue then
				this.id_header.object.rowid[al_row] = ll_rowid
				this.id_header.object.date[al_row] = ldt_date
				this.id_header.object.moduleid[al_row] = ll_moduleid
				this.id_header.object.catcode[al_row] = ll_catcode
				this.id_header.object.category[al_row] = ls_category
				this.id_header.object.acccode[al_row] = ll_acccode
				this.id_header.object.usercode[al_row] = ll_usercode
				this.id_header.object.machinename[al_row] = ls_machinename
				this.id_header.object.headerno[al_row] = ll_headerno
				this.id_header.object.headerinvno[al_row] = ll_headerinvno
				this.id_header.object.amount[al_row] = ld_amount
				this.id_header.object.cashacccode[al_row] = ll_cashacccode
				this.id_header.object.cashtendered[al_row] = ld_cashtendered
				this.id_header.object.cashcharged[al_row] = ld_cashcharged
				this.id_header.object.cashback[al_row] = ld_cashback
				this.id_header.object.remarks[al_row] = ls_remarks
				this.id_header.object.cashierjobcode[al_row] = ll_cashierjobcode
				this.id_header.object.printed[al_row] = ls_printed
				this.id_header.object.supervised[al_row] = ls_supervised
				this.id_header.object.supervisedon[al_row] = ldt_supervisedon
				this.id_header.object.glvochcode[al_row] = ll_glvochcode
				return 0
			else
				messagebox("Sale Document Info. Validation", ls_errortext, stopsign!)
				return 1
			end if
			return
		end if
		return
	end if
	if ai_module = 1 then
		messagebox("Sale Document Info. Validation", "Databse Problem Occurred While Fetching Sale Document Code " + string(al_doccode) + "~r~nDetails are~r~n" + this.it_transobject.sqlerrtext, stopsign!)
	else
		messagebox("Sale Return Document Info. Validation", "Databse Problem Occurred While Fetching Sale Return Document Code " + string(al_doccode) + "~r~nDetails are~r~n" + this.it_transobject.sqlerrtext, stopsign!)
	end if
	return this.it_transobject.sqlcode

// w_cashierjobactivity_cashtendered.wf_supervise() returns long
	long ll_row
	long ll_doccode
	long ll_rowid
	long ll_retcode
	long ll_headerinvno
	integer li_moduleid
	integer li_usercode
	integer li_catcode
	integer li_acccode
	integer li_cashacccode
	integer li_headerno
	double ld_cashtendered
	double ld_cashcharged
	double ld_cashback
	double ld_amount
	string ls_remarks
	string ls_errtext
	string ls_category
	string ls_machinename
	char lc_printed
	ll_row = this.id_header.getrow()
	if this.id_header.getrow() > 0 then
		ll_rowid = this.id_header.object.rowid[ll_row]
		li_moduleid = this.id_header.object.moduleid[ll_row]
		ll_doccode = this.id_header.object.doccode[ll_row]
		if isnull(ll_doccode) then
			ll_doccode = 0
		end if
		li_catcode = this.id_header.object.catcode[ll_row]
		ls_category = this.id_header.object.category[ll_row]
		if li_moduleid = 101 then
			li_catcode = 1
			ls_category = "Cash Receipt"
		elseif li_moduleid = 102 then
			li_catcode = 1
			ls_category = "Cash Receipt Against Sale"
		elseif li_moduleid = 103 then
			li_catcode = 1
			ls_category = "Cash Payment"
		elseif li_moduleid = 104 then
			li_catcode = 1
			ls_category = "Cash Payment Against Purchase"
		end if
		li_acccode = this.id_header.object.acccode[ll_row]
		li_usercode = this.id_header.object.usercode[ll_row]
		if isnull(li_usercode) then
			li_usercode = gl_usercode
		end if
		ls_machinename = this.id_header.object.machinename[ll_row]
		if isnull(ls_machinename) or ls_machinename = "" then
			ls_machinename = gs_localcomputername
		end if
		li_headerno = this.id_header.object.headerno[ll_row]
		if isnull(li_headerno) or li_headerno = 0 then
			li_headerno = 1
		end if
		ll_headerinvno = this.id_header.object.headerinvno[ll_row]
		ld_amount = this.id_header.object.amount[ll_row]
		li_cashacccode = this.id_header.object.cashacccode[ll_row]
		ld_cashtendered = this.id_header.object.amount[ll_row]
		ld_cashcharged = this.id_header.object.amount[ll_row]
		ld_cashback = 0.00
		ls_remarks = this.id_header.object.remarks[ll_row]
		lc_printed = this.id_header.object.printed[ll_row]
		if li_moduleid > 100 and isnull(ll_rowid) then
			SQL rollback USING this.it_transobject;
			this.it_transobject.insert_cashieractivity(li_moduleid, ll_doccode, li_catcode, ls_category, li_acccode, li_usercode, ls_machinename, li_headerno, ll_headerinvno, ld_amount, li_cashacccode, ld_cashtendered, ld_cashcharged, ld_cashback, ls_remarks, this.il_cashierjobcode, lc_printed, "N", ll_rowid)
			if this.it_transobject.sqlcode = 0 then
				SQL commit USING this.it_transobject;
			else
				messagebox("Error", this.it_transobject.sqlerrtext)
				ll_retcode = 1
			end if
		end if
		if ll_rowid > 0 and li_moduleid > 0 and this.id_header.object.supervised[ll_row] = "N" then
			SQL rollback USING this.it_transobject;
			this.it_transobject.supervise_cashieractivity(ll_rowid, li_moduleid, ll_doccode, li_catcode, li_acccode, li_cashacccode, ld_cashtendered, ld_cashcharged, ld_cashback, ls_remarks, this.il_cashierjobcode, lc_printed)
			if this.it_transobject.sqlcode = 0 then
				SQL commit USING this.it_transobject;
				ll_retcode = 0
			else
				ls_errtext = this.it_transobject.sqlerrtext
				ll_retcode = 1
				SQL rollback USING this.it_transobject;
				if f_stringpreferences("ShowSavingSuperviseMessages") = "Y" then
					messagebox("Supervision Problem", "Some Database Problem Occured while supervision. Details are:-~r~n" + ls_errtext, stopsign!)
				end if
			end if
		end if
	end if
	this.id_header.setfocus()
	return ll_retcode

// w_cashierjobactivity_cashtendered.wf_superviseall() returns long
	long ll_counter
	long ll_retcode
	long ll_unsupervised_count
	long ll_supvised_count
	long[] ll_rowid
	double ld_cashtend
	for ll_counter = 1 to this.id_header.rowcount()
		if upper(this.id_header.object.supervised[ll_counter]) = "N" then
			ll_unsupervised_count = ll_unsupervised_count + 1
			ll_rowid[ll_unsupervised_count] = this.id_header.object.rowid[ll_counter]
			this.id_header.setrow(ll_counter)
			this.id_header.scrolltorow(ll_counter)
			ll_retcode = wf_supervise()
			if ll_retcode <> 0 then
				exit
			else
				ll_supvised_count = ll_supvised_count + 1
			end if
		end if
	next
	if ll_counter > 1 then
		if this.ib_print then
			if this.dw_cash.rowcount() > 0 then
				ld_cashtend = this.dw_cash.object.cashtendered[1]
			end if
			this.dw_print.dataobject = wf_set_printout()
			this.dw_print.settransobject(sqlca)
			this.dw_print.retrieve(ll_rowid, ld_cashtend)
			this.dw_print.modify("DataWindow.Print.Preview=yes DataWindow.Print.Preview.Rulers=yes")
			if this.dw_print.rowcount() > 0 then
				this.dw_print.print()
			end if
		end if
		if f_stringpreferences("ShowSavingSuperviseMessages") = "Y" then
			messagebox("Supervision Intimation", "Un-supervised documents = " + string(ll_unsupervised_count) + "~r~nSupervised Documents   = " + string(ll_supvised_count), information!)
		end if
	end if
	this.id_header.setfocus()
	return ll_retcode

// w_cashierjobactivity_cashtendered.wf_set_printout() returns string
	string ls_report
	if gs_company = "TM" then
		ls_report = "d_cashierjobactivity_multiinv_print_tm"
	else
		ls_report = "d_cashierjobactivity_multiinvoice_print"
	end if
	return ls_report

// w_cashierjobactivity_cashtendered.create() returns 0
	this.dw_print = create dw_print
	this.cb_print = create cb_print
	this.dw_cash = create dw_cash
	this.cb_ok = create cb_ok
	this.cb_cancel = create cb_cancel
	this.dw_header = create dw_header
	this.control = {this.dw_print, this.cb_print, this.dw_cash, this.cb_ok, this.cb_cancel, this.dw_header}

// w_cashierjobactivity_cashtendered.destroy() returns 0
	destroy this.dw_print
	destroy this.cb_print
	destroy this.dw_cash
	destroy this.cb_ok
	destroy this.cb_cancel
	destroy this.dw_header

// w_cashierjobactivity_cashtendered.open() returns long
	long ll_row
	long ll_currrow
	long ll_counter
	long ll_rowid
	long ll_groupcode
	string ls_saletype
	integer li_protect
	integer li_view_cashorcredit
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	this.it_transobject = create u_transaction
	SQL start USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Connection Failure", "Unable to connect to the database", stopsign!)
		close(this)
		return ::message.returnvalue
	end if
	SQL SELECT MAX ( CashierJobCode ) INTO :this.il_cashierjobcode FROM CashierJob WHERE Active ='Y' AND JobOwner =:gl_usercode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Connection Failure", "Unable to connect to the database", stopsign!)
		close(this)
		return ::message.returnvalue
	elseif this.il_cashierjobcode < 0 or isnull(this.il_cashierjobcode) then
		messagebox("Cashier Job", "Unable to connect to the cashier job", stopsign!)
		close(this)
		return ::message.returnvalue
	end if
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	ll_rowid = ::message.doubleparm
	this.id_header = this.dw_header
	this.id_header.settransobject(this.it_transobject)
	if f_stringpreferences("ShowEmptyDocumentCodeByDefault") = "N" then
		if ll_rowid > 0 then
			this.id_header.retrieve(ll_rowid)
		else
			this.id_header.insertrow(0)
		end if
	else
		this.id_header.insertrow(0)
	end if
	this.id_header.setrow(this.id_header.rowcount())
	this.id_header.scrolltorow(this.id_header.rowcount())
	this.id_header.setcolumn("doccode")
	this.dw_cash.settransobject(this.it_transobject)
	this.dw_cash.insertrow(0)
	return ::message.returnvalue

// cb_print.clicked() returns long
	parent.ib_print = true
	parent.cb_ok.triggerevent(clicked!)
	return ::message.returnvalue

// dw_cash.itemchanged(long row, dwobject dwo, string data) returns long
	long ancestorreturnvalue
	integer li_errcode
	long ll_null
	long ll_res
	long ll_unpostedtrans
	double ld_totamt
	string ls_null
	string ls_msg
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case "catcode"
	case "cashtendered"
		ld_totamt = parent.id_header.getitemnumber(1, "c_total")
		if ld_totamt < 0.0 then
			if double(data) < 0.0 or data = "" or isnull(data) then
				messagebox("Cash Tendered Validation!", "Please enter valid amount for Cash Tendered.", stopsign!)
				return 1
			elseif double(data) <> abs(ld_totamt) then
				messagebox("Cash Tendered Validation!", "Cash Tendered Must be Extacly Same as Total Amount", stopsign!)
				return 1
			end if
		elseif double(data) < 0.0 or data = "" or isnull(data) then
			messagebox("Cash Tendered Validation!", "Please enter valid amount for Cash Tendered.", stopsign!)
			return 1
		elseif double(data) < ld_totamt then
			messagebox("Cash Tendered Validation!", "Cash Tendered is less than invoice amount.", stopsign!)
			return 1
		end if
		parent.wf_setbalance(row, dwo.name, double(data))
		return li_errcode
	end choose
	return li_errcode

// dw_cash.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_cash.getfocus() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// cb_ok.clicked() returns long
	long ll_counter
	if parent.id_header.rowcount() > 0 and (isnull(parent.id_header.object.doccode[parent.id_header.rowcount()]) and parent.id_header.object.amount[parent.id_header.rowcount()] = 0) then
		parent.id_header.scrolltorow(parent.id_header.rowcount())
		parent.id_header.setrow(parent.id_header.rowcount())
		parent.id_header.deleterow(parent.id_header.rowcount())
	end if
	if parent.id_header.accepttext() = -1 then
		return ::message.returnvalue
	end if
	if parent.dw_cash.accepttext() = -1 then
		return ::message.returnvalue
	end if
	if parent.id_header.rowcount() > 0 then
		if parent.wf_superviseall() = 0 then
			if f_stringpreferences("KeepCashWindowAlwaysOpen") = "N" then
				parent.post event ue_close(1)
			else
				parent.id_header.reset()
				parent.id_header.insertrow(0)
				parent.id_header.setrow(parent.id_header.rowcount())
				parent.id_header.scrolltorow(parent.id_header.rowcount())
				parent.id_header.setcolumn("doccode")
				parent.dw_cash.reset()
				parent.dw_cash.settransobject(parent.it_transobject)
				parent.dw_cash.insertrow(0)
				return ::message.returnvalue
			end if
		else
			if f_stringpreferences("KeepCashWindowAlwaysOpen") = "Y" then
				parent.id_header.reset()
				parent.id_header.insertrow(0)
				parent.id_header.setrow(parent.id_header.rowcount())
				parent.id_header.scrolltorow(parent.id_header.rowcount())
				parent.id_header.setcolumn("doccode")
				parent.dw_cash.reset()
				parent.dw_cash.settransobject(parent.it_transobject)
				parent.dw_cash.insertrow(0)
			end if
			return ::message.returnvalue
		end if
		return
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.post event ue_close(-1)
	return ::message.returnvalue

// dw_header.itemchanged(long row, dwobject dwo, string data) returns long
	long ancestorreturnvalue
	integer li_errcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "doccode"
		parent.ib_rowvalidated = false
		parent.il_currrow = row
		li_errcode = 0
	case else
		parent.ib_rowvalidated = true
	end choose
	return li_errcode

// dw_header.itemerror(long row, dwobject dwo, string data) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "doccode"
		if data = "" or isnull(data) then
			messagebox("Document Code Validation", "Value required for Document Code in current row")
		end if
	end choose
	return 1

// dw_header.itemfocuschanged(long row, dwobject dwo) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.ib_rowvalidated = false and parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_header.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	long ancestorreturnvalue
	long ll_rowcount
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyescape! then
		parent.post event ue_close(-1)
	end if
	if keyflags = 2 then
		if key = keyi! then
			if parent.ib_rowvalidated = false and parent.wf_validateitem() = -1 then
				return ::message.returnvalue
			end if
			if parent.id_header.rowcount() > 0 and f_validatedw(parent.id_header) < 0 then
				return ::message.returnvalue
			end if
			ll_rowcount = parent.id_header.insertrow(0)
			if ll_rowcount > 1 then
				parent.id_header.object.module[ll_rowcount] = 1
				parent.id_header.scrolltorow(ll_rowcount)
				parent.id_header.setcolumn("module")
				parent.id_header.setfocus()
			end if
		end if
		if key = keyd! then
			parent.ib_rowvalidated = true
			if parent.id_header.rowcount() > 0 then
				parent.id_header.deleterow(0)
			end if
			ll_rowcount = parent.id_header.rowcount()
			if ll_rowcount > 1 then
				parent.id_header.scrolltorow(ll_rowcount)
				parent.id_header.setcolumn("module")
				parent.id_header.setfocus()
			end if
			parent.ib_rowvalidated = true
		end if
	end if
	return ::message.returnvalue

// dw_header.ue_enterkey() returns long
	long ancestorreturnvalue
	long ll_rowcount
	ancestorreturnvalue = super::ue_enterkey()
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		if parent.id_header.rowcount() > 0 and f_validatedw(parent.id_header) < 0 then
			return ::message.returnvalue
		end if
		if parent.ib_rowvalidated = false and parent.wf_validateitem() = -1 then
			return 1
		end if
		ll_rowcount = parent.id_header.insertrow(0)
		if ll_rowcount > 1 then
			parent.id_header.object.module[ll_rowcount] = 1
			parent.id_header.scrolltorow(ll_rowcount)
			parent.id_header.setcolumn("module")
			parent.id_header.setfocus()
			if isnull(this.object.doccode[ll_rowcount]) then
				ll_rowcount = ll_rowcount - 1
				if ll_rowcount > 0 and isnull(this.object.doccode[ll_rowcount]) then
					parent.cb_ok.triggerevent(clicked!)
				end if
			end if
		end if
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_header.rowfocuschanging(long currentrow, long newrow) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::rowfocuschanging(currentrow, newrow)
	if currentrow > 0 and rowcount() > 0 and (isnull(parent.id_header.object.doccode[currentrow]) and currentrow = parent.id_header.rowcount()) then
		return 1
	end if
	return ::message.returnvalue
