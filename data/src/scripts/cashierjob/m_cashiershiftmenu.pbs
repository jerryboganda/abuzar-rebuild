// menu m_cashiershiftmenu (cashierjob)  ancestor: m_multi_entry

// m_cashiershiftmenu.create() returns 0 [event]
	m_cashiershiftmenu = this
	call super::create
	this.text = "m_cashiershiftmenu"

// m_cashiershiftmenu.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_printcashieshiftreport = create m_printcashieshiftreport
	this.m_populateusers = create m_populateusers
	this.m_printcreditsummary = create m_printcreditsummary
	this.item[upperbound(this.item) + 1] = this.m_printcashieshiftreport
	this.item[upperbound(this.item) + 1] = this.m_populateusers
	this.item[upperbound(this.item) + 1] = this.m_printcreditsummary

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_printcashieshiftreport
	destroy this.m_populateusers
	destroy this.m_printcreditsummary

// m_post.create() returns 0 [event]
	call super::create
	this.tag = "Mark Cashier Shift as Closed"
