// menu m_cashieractivitymenu (cashierjob)  ancestor: menu

// m_cashieractivitymenu.create() returns 0 [event]
	m_cashieractivitymenu = this
	call super::create
	this.text = "m_activitymonitor"
	this.m_activitylist = create m_activitylist
	this.item[upperbound(this.item) + 1] = this.m_activitylist

// m_cashieractivitymenu.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_activitylist

// m_activitylist.create() returns 0 [event]
	call super::create
	this.text = "Activity &List"
