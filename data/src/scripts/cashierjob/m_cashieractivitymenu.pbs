	this.item[upperbound(this.item) + 1] = this.m_preview
	this.item[upperbound(this.item) + 1] = this.m_printjobactivityreport
	this.item[upperbound(this.item) + 1] = this.m_summarystatistics
	this.item[upperbound(this.item) + 1] = this.m_exit

// m_activitylist.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_refresh
	destroy this.m_showcashtenderedwindow
	destroy this.m_supervisecurrent
	destroy this.m_superviseselection
	destroy this.m_superviseall
	destroy this.m_changecategory
	destroy this.m_applyfilterun-filter
