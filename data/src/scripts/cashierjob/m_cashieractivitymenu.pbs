	this.m_printjobactivityreport = create m_printjobactivityreport
	this.m_summarystatistics = create m_summarystatistics
	this.m_exit = create m_exit
	this.item[upperbound(this.item) + 1] = this.m_refresh
	this.item[upperbound(this.item) + 1] = this.m_showcashtenderedwindow
	this.item[upperbound(this.item) + 1] = this.m_supervisecurrent
