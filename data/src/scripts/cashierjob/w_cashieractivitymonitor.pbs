// window w_cashieractivitymonitor (cashierjob)  ancestor: window

// w_cashieractivitymonitor.wf_set_autoprint() returns long
	long ll_found
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5026", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_autoprint = true
	end if
	return 0

// w_cashieractivitymonitor.wf_filter() returns 0
	string ls_null
	setnull(ls_null)
	if this.ic_filter = "N" then
		this.id_list.scrolltorow(0)
		if this.is_filterexp = "" or isnull(this.is_filterexp) then
			setnull(this.is_filterexp)
		end if
		this.id_list.setfilter(this.is_filterexp)
		this.id_list.filter()
		this.id_button.object.b_filter.text = "Un-Filter [F2]"
		this.ic_filter = "Y"
	else
		this.id_button.object.b_filter.text = "Filter [F2]"
		this.id_list.setfilter("")
		this.id_list.filter()
		this.ic_filter = "N"
	end if
	this.id_list.groupcalc()
	this.id_list.setfocus()

// w_cashieractivitymonitor.wf_preview() returns long
	long ll_rowcount
	long ll_docrowid
	long ll_doccode
	long ll_moduleid
	integer li_printretcode
	boolean lb_continue = true
	string ls_report
	s_datastore lstr
	ll_rowcount = this.id_list.rowcount()
	if ll_rowcount > 0 then
		if this.id_list.getrow() > 0 then
			ll_docrowid = this.id_list.object.rowid[this.id_list.getrow()]
			ll_moduleid = this.id_list.object.moduleid[this.id_list.getrow()]
			if ll_moduleid < 100 then
				ll_doccode = this.id_list.object.doccode[this.id_list.getrow()]
			else
				ll_doccode = this.id_list.object.glvochcode[this.id_list.getrow()]
			end if
			ls_report = wf_selectprintreport(ll_moduleid, ll_doccode)
			this.id_print.dataobject = ls_report
			this.id_print.settransobject(this.it_transobject)
			this.id_print.retrieve(ll_doccode)
			if this.id_print.rowcount() > 0 then
				if ll_moduleid <= 11 then
					lstr.s_module = "sale"
				elseif ll_moduleid <= 32 then
					lstr.s_module = "sale return"
				else
					lstr.s_module = "voucher"
				end if
				lstr.dw = this.id_print
				lstr.s_name1 = this.id_print.dataobject
				openwithparm(w_preview_invoices, lstr)
				lstr = message.powerobjectparm
				if lstr.i_closemode = -1 then
					return 0
				end if
				if f_stringpreferences("saleaskforcopies") = "Y" then
					open(w_printer_copies)
					this.id_print.object.datawindow.print.copies = string(message.doubleparm)
				end if
				if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
					messagebox("Printer", "Printing Error")
					this.id_print.printcancel()
				end if
				if this.id_print.rowcount() > 0 then
					li_printretcode = this.id_print.print()
					if li_printretcode < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			end if
		else
			messagebox("Cashier Activity Print Request", "Please Select some Valdid Item From List", stopsign!)
		end if
	end if
	return 0

// w_cashieractivitymonitor.wf_sort() returns long
	string ls_null
	setnull(ls_null)
	this.id_list.setsort(ls_null)
	this.id_list.sort()
	this.id_list.groupcalc()
	this.id_list.setfocus()
	return 0

// w_cashieractivitymonitor.wf_settimer(long ai_time) returns 0
	timer(ai_time, this)

// w_cashieractivitymonitor.wf_setbalance(long al_row, string as_col, double ad_amt) returns long
	if as_col = "cashtendered" then
		if ad_amt > this.id_list.object.amount[al_row] then
			this.id_list.object.cashcharged[al_row] = this.id_list.object.amount[al_row]
			this.id_list.object.cashback[al_row] = ad_amt - this.id_list.object.cashcharged[al_row]
		else
			this.id_list.object.cashcharged[al_row] = ad_amt
			this.id_list.object.cashback[al_row] = this.id_list.object.cashcharged[al_row] - ad_amt
		end if
	elseif as_col = "cashcharged" then
		if ad_amt > this.id_list.object.cashtendered[al_row] then
			this.id_list.object.cashback[al_row] = 0
		else
			this.id_list.object.cashback[al_row] = this.id_list.object.cashtendered[al_row] - ad_amt
		end if
	end if
	return 0

// w_cashieractivitymonitor.wf_supervise() returns long
	long ll_row
	long ll_doccode
	long ll_rowid
	long ll_retcode
	long ll_headerinvno
	integer li_moduleid
	integer li_usercode
	integer li_catcode
	integer li_acccode
	integer li_cashacccode
	integer li_headerno
	double ld_cashtendered
	double ld_cashcharged
	double ld_cashback
	double ld_amount
	string ls_remarks
	string ls_errtext
	string ls_category
	string ls_machinename
	char lc_printed
	ll_row = this.id_list.getrow()
	if this.id_list.getrow() > 0 then
		ll_rowid = this.id_list.object.rowid[ll_row]
		li_moduleid = this.id_list.object.moduleid[ll_row]
		ll_doccode = this.id_list.object.doccode[ll_row]
		if isnull(ll_doccode) then
			ll_doccode = 0
		end if
		li_catcode = this.id_list.object.catcode[ll_row]
		ls_category = this.id_list.object.category[ll_row]
		if li_moduleid = 101 then
			li_catcode = 1
			ls_category = "Cash Receipt"
		elseif li_moduleid = 102 then
			li_catcode = 1
			ls_category = "Cash Receipt Against Sale"
		elseif li_moduleid = 103 then
			li_catcode = 1
			ls_category = "Cash Payment"
		elseif li_moduleid = 104 then
			li_catcode = 1
			ls_category = "Cash Payment Against Purchase"
		end if
		li_acccode = this.id_list.object.acccode[ll_row]
		li_usercode = this.id_list.object.usercode[ll_row]
		if isnull(li_usercode) then
			li_usercode = gl_usercode
		end if
		ls_machinename = this.id_list.object.machinename[ll_row]
		if isnull(ls_machinename) or ls_machinename = "" then
			ls_machinename = gs_localcomputername
		end if
		li_headerno = this.id_list.object.headerno[ll_row]
		if isnull(li_headerno) or li_headerno = 0 then
			li_headerno = 1
		end if
		ll_headerinvno = this.id_list.object.headerinvno[ll_row]
		ld_amount = this.id_list.object.amount[ll_row]
		li_cashacccode = this.id_list.object.cashacccode[ll_row]
		ld_cashtendered = this.id_list.object.cashtendered[ll_row]
		ld_cashcharged = this.id_list.object.cashcharged[ll_row]
		ld_cashback = this.id_list.object.cashback[ll_row]
		ls_remarks = this.id_list.object.remarks[ll_row]
		lc_printed = this.id_list.object.printed[ll_row]
		if li_moduleid > 100 and isnull(ll_rowid) then
			SQL rollback USING this.it_transobject;
			this.it_transobject.insert_cashieractivity(li_moduleid, ll_doccode, li_catcode, ls_category, li_acccode, li_usercode, ls_machinename, li_headerno, ll_headerinvno, ld_amount, li_cashacccode, ld_cashtendered, ld_cashcharged, ld_cashback, ls_remarks, this.il_cashierjobcode, lc_printed, "N", ll_rowid)
			if this.it_transobject.sqlcode = 0 then
				SQL commit USING this.it_transobject;
			else
				messagebox("Error", this.it_transobject.sqlerrtext)
				ll_retcode = 1
			end if
		end if
		if ll_rowid > 0 and li_moduleid > 0 and this.id_list.object.supervised[ll_row] = "N" then
			SQL rollback USING this.it_transobject;
			this.it_transobject.supervise_cashieractivity(ll_rowid, li_moduleid, ll_doccode, li_catcode, li_acccode, li_cashacccode, ld_cashtendered, ld_cashcharged, ld_cashback, ls_remarks, this.il_cashierjobcode, lc_printed)
			if this.it_transobject.sqlcode = 0 then
				SQL commit USING this.it_transobject;
				this.ib_editflag = false
				ll_retcode = 0
				if this.ib_autoprint then
					wf_printslip(1, ll_rowid)
				end if
			else
				ls_errtext = this.it_transobject.sqlerrtext
				ll_retcode = 1
				SQL rollback USING this.it_transobject;
				messagebox("Supervision Problem", "Some Database Problem Occured while supervision. Details are:-~r~n" + ls_errtext, stopsign!)
			end if
		end if
	end if
	this.id_list.setfocus()
	return ll_retcode

// w_cashieractivitymonitor.wf_refresh(integer ai_mode) returns long
	long ll_index
	long ll_rowcount
	long ll_series_num
	long ll_counter
	long ll_innercounter
	long ll_groupcode
	long ll_prints_left
	long[] ll_docrowid
	long ll_printable_count
	long ll_min_refresh
	boolean lb_continue = true
	datetime ldt_startdate
	if this.id_button.rowcount() = 0 then
		return 0
	end if
	setpointer(hourglass!)
	setredraw(false)
	if ai_mode = 1 then
		this.id_list.retrieve(this.il_cashierjobcode)
		this.ib_editflag = false
	elseif this.ib_editflag = false then
		this.id_list.retrieve(this.il_cashierjobcode)
	end if
	ll_rowcount = this.id_list.rowcount()
	setpointer(arrow!)
	setredraw(true)
	return 0

// w_cashieractivitymonitor.wf_select_printslip() returns 0
	long ll_listrow
	long ll_module
	string ls_report
	string ls_doctype
	ll_listrow = this.id_list.getrow()
	if ll_listrow > 0 then
		ll_module = this.id_list.object.moduleid[ll_listrow]
	end if
	if ls_report = "" then
		ls_report = "d_cashieractivitymonitor_printout"
	end if
	this.ids_print.dataobject = ls_report
	this.ids_print.settransobject(this.it_transobject)

// w_cashieractivitymonitor.wf_selectprintreport(integer ai_module, long al_doccode) returns string
	string ls_pagesize
	string ls_report
	long ll_currrow
	boolean lb_printout
	integer li_headerno
	integer li_catcode
	integer li_printformat
	ll_currrow = this.id_list.getrow()
	if ll_currrow > 0 then
		li_catcode = this.id_list.object.catcode[ll_currrow]
		if li_catcode = 1 then
			lb_printout = true
		end if
		if ai_module <= 11 then
			SQL SELECT InvoiceSize , HeaderNo INTO :ls_pagesize, :li_headerno FROM SaleLedger WHERE SaleInvCode =:al_doccode USING this.it_transobject;
			ls_report = f_getsaleprintout(ls_pagesize, lb_printout, li_headerno)
			f_set_headerlogo(this.id_print, li_headerno)
		elseif ai_module <= 32 then
			SQL SELECT PageSize , HeaderNo INTO :ls_pagesize, :li_headerno FROM SRLedger WHERE SRInvCode =:al_doccode USING this.it_transobject;
			if ls_pagesize = "F" then
				ls_report = "d_wholesaleretinvreport_full"
			elseif ls_pagesize = "H" then
				ls_report = "d_wholesaleretinvreport_half"
			else
				ls_report = "d_wholesaleretinvreport"
			end if
		else
			li_printformat = f_numberpreferences("VoucherPrintingFormat")
			ls_pagesize = f_stringpreferences("VoucherPrintingPageSize")
			ls_report = "d_voucherprint"
			choose case ls_pagesize
			case "F"
				choose case li_printformat
				case 1
					ls_report = "d_voucherprint"
				case 2
					ls_report = "d_voucherprint_format2"
				case 3
					ls_report = "d_voucherprint_patient"
				case 4
					ls_report = "d_voucherprint_standard2"
				end choose
			case "H"
				choose case li_printformat
				case 1
					ls_report = "d_voucherprint_half"
				case 2
					ls_report = "d_voucherprint_half_format2"
				case 3
					ls_report = "d_voucherprint_half_patient"
				case 4
					ls_report = "d_voucherprint_half_standard2"
				end choose
			end choose
		end if
		this.id_print.dataobject = ls_report
		this.id_print.settransobject(this.it_transobject)
	end if
	return ls_report

// w_cashieractivitymonitor.wf_printslip(integer ai_mode, long al_row) returns long
	long ll_rowcount
	long ll_index
	long ll_counter
	long ll_printable_count
	long ll_docrowid
	boolean lb_continue = true
	ll_rowcount = this.id_list.rowcount()
	if ll_rowcount > 0 then
		if ai_mode = 0 then
			if this.id_list.getrow() > 0 then
				ll_docrowid = this.id_list.object.rowid[this.id_list.getrow()]
				wf_select_printslip()
				this.ids_print.retrieve(ll_docrowid)
				if this.ids_print.rowcount() > 0 then
					this.ids_print.print()
				end if
			else
				messagebox("Cashier Activity Print Request", "Please Select some Valdid Item From List", stopsign!)
			end if
		elseif this.ib_autoprint then
			ll_docrowid = al_row
			wf_select_printslip()
			if ll_docrowid > 0 then
				this.ids_print.retrieve(ll_docrowid)
				if this.ids_print.rowcount() > 0 then
					this.ids_print.print()
					SQL rollback USING this.it_transobject;
					for ll_counter = 1 to ll_printable_count
						this.it_transobject.changeprintstatus_cashieractivity(ll_docrowid)
						if this.it_transobject.sqlcode <> 0 then
							lb_continue = false
						end if
						if lb_continue = false then
							exit
						end if
					next
					if lb_continue then
						SQL commit USING this.it_transobject;
					else
						messagebox("Cashier Activity", "Problem in changing print status. Details are:-~r~n" + this.it_transobject.sqlerrtext)
						SQL rollback USING this.it_transobject;
					end if
				end if
			end if
		end if
	end if
	return 0

// w_cashieractivitymonitor.wf_insert_voucher() returns long
	long ll_row
	long ll_retcode = -1
	s_arguements lstr_arg
	this.id_list.setredraw(false)
	openwithparm(w_select_cashierjob_voucher, this.il_cashierjobcode)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 and lstr_arg.l_code1 > 100 then
		ll_row = this.id_list.insertrow(0)
		if ll_row > 0 then
			this.ib_editflag = true
			this.id_list.object.date[ll_row] = today()
			this.id_list.object.moduleid[ll_row] = lstr_arg.l_code1
			this.id_list.scrolltorow(ll_row)
			this.id_list.setrow(ll_row)
			this.id_list.setcolumn("doccode")
			ll_retcode = 0
		end if
	end if
	this.id_list.sort()
	this.id_list.setredraw(true)
	return ll_retcode

// w_cashieractivitymonitor.wf_validateinvcode(long al_row, long al_invcode) returns integer
	integer li_rtcode
	long ll_invcode
	long ll_acccode
	long ll_glvochcode
	long ll_patientcode
	long ll_unpostedrows
	long ll_moduleid
	long ll_headerno
	long ll_headerinvcode
	long ll_usercode
	double ld_outstandingamt
	double ld_netamt
	double ld_oldamt
	double ld_balance
	datetime ld_date
	string ls_aliasname
	string ls_regno
	string ls_machine
	ll_moduleid = this.id_list.object.moduleid[al_row]
	if ll_moduleid = 101 or ll_moduleid = 102 then
		SQL SELECT SaleLedger.SaleInvCode , RegNo =( SELECT Patient.RegNo FROM Patient WHERE Patient.PatientCode =SaleLedger.PatientCode ) , SaleLedger.PatientCode , SaleLedger.Date , SaleLedger.CustCode , Accounts.AliasName , SaleLedger.OutstandingAmt , SaleLedger.InvTotal , SaleLedger.Headerno , SaleLedger.HeaderinvNo , SaleLedger.SalesmanCode , SaleLedger.MachineName INTO :ll_invcode, :ls_regno, :ll_patientcode, :ld_date, :ll_acccode, :ls_aliasname, :ld_outstandingamt, :ld_netamt, :ll_headerno, :ll_headerinvcode, :ll_usercode, :ls_machine FROM SaleLedger , Accounts WHERE SaleLedger.SaleInvCode =:al_invcode AND SaleLedger.AccountFor ='Y' AND SaleLedger.Marked ='N' AND SaleLedger.Posted ='Y' AND SaleLedger.OutstandingAmt > 0 AND SaleLedger.CustCode =Accounts.AccCode AND SaleLedger.SaleCatCode IN ( 2 ) USING sqlca;
	elseif ll_moduleid = 103 or ll_moduleid = 104 then
		SQL SELECT PurLedger.PurInvCode , PurLedger.Date , PurLedger.SuppCode , Accounts.AliasName , PurLedger.OutstandingAmt , PurLedger.InvTotal , PurLedger.Headerno , PurLedger.headerinvNo , PurLedger.Salesmancode , MachineName =NUll INTO :ll_invcode, :ld_date, :ll_acccode, :ls_aliasname, :ld_outstandingamt, :ld_netamt, :ll_headerno, :ll_headerinvcode, :ll_usercode, :ls_machine FROM PurLedger , Accounts WHERE PurLedger.PurInvCode =:al_invcode AND PurLedger.AccountFor ='Y' AND PurLedger.Marked ='N' AND PurLedger.OutstandingAmt > 0 AND PurLedger.SuppCode =Accounts.AccCode AND PurLedger.Posted ='Y' USING sqlca;
	end if
	if sqlca.sqlcode = 0 then
		if ll_invcode > 0 then
			if ld_outstandingamt = 0.0 and (ll_moduleid = 102 or ll_moduleid = 104) then
				li_rtcode = 1
			else
				this.id_list.object.acccode[al_row] = ll_acccode
				this.id_list.object.doccode[al_row] = ll_invcode
				this.id_list.object.amount[al_row] = ld_outstandingamt
				this.id_list.object.headerno[al_row] = ll_headerno
				this.id_list.object.headerinvno[al_row] = ll_headerinvcode
				this.id_list.object.usercode[al_row] = ll_usercode
				this.id_list.object.machinename[al_row] = ls_machine
			end if
		else
			li_rtcode = 1
		end if
	else
		li_rtcode = 1
	end if
	return li_rtcode

