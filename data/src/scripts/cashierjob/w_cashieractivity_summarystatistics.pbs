// window w_cashieractivity_summarystatistics (cashierjob)  ancestor: window

// w_cashieractivity_summarystatistics.create() returns 0 [event]
	this.cb_close = create cb_close
	this.cb_save = create cb_save
	this.cb_print = create cb_print
	this.dw_report = create dw_report
	this.control = {this.cb_close, this.cb_save, this.cb_print, this.dw_report}

// w_cashieractivity_summarystatistics.destroy() returns 0 [event]
	destroy this.cb_close
	destroy this.cb_save
	destroy this.cb_print
	destroy this.dw_report

// w_cashieractivity_summarystatistics.open() returns long [event]
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_counter
	long ll_currentrow
	long ll_cashierjob
	environment env
	ll_cashierjob = message.doubleparm
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		this.width = ll_win_width * 0.90
		this.height = ll_win_height * 0.90
		this.dw_report.width = this.width * 0.90
		this.dw_report.height = this.height * 0.90
		this.cb_save.y = this.height - this.cb_save.height - 150
		this.cb_print.y = this.height - this.cb_print.height - 150
		this.cb_close.y = this.height - this.cb_close.height - 150
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	this.dw_report.settransobject(sqlca)
	this.dw_report.retrieve(ll_cashierjob)
	this.dw_report.modify("DataWindow.Print.Preview=yes DataWindow.Print.Preview.Rulers=yes")
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_cashieractivity_summarystatistics.key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		close(this)
	end if
	return ::message.returnvalue

// cb_close.clicked() returns long [event]
	close(parent)
	return ::message.returnvalue

// cb_save.clicked() returns long [event]
	parent.dw_report.saveas()
	return ::message.returnvalue

// cb_print.clicked() returns long [event]
	if parent.dw_report.visible then
		if printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			parent.dw_report.printcancel()
		end if
		parent.dw_report.print()
	end if
	return ::message.returnvalue
