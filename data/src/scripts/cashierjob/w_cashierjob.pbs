// window w_cashierjob (cashierjob)  ancestor: w_multi_entry

// w_cashierjob.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM Groups WHERE GroupName =:as_name USING this.it_transobject;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_cashierjob.wf_validateitem() returns integer
	long ll_module
	long rt_code
	integer li_errcode
	integer li_null
	boolean ib_yesno
	setnull(li_null)
	ll_module = this.id_detail.getitemnumber(this.il_currrow, "moduleid")
	if this.id_detail.rowcount() > 1 then
		if this.il_currrow > 1 then
			rt_code = this.id_detail.find("moduleid = " + trim(string(ll_module)), this.il_currrow - 1, 0)
		end if
		if rt_code = 0 then
			if this.il_currrow <> this.id_detail.rowcount() then
				rt_code = this.id_detail.find("moduleid = " + trim(string(ll_module)), this.il_currrow + 1, this.id_detail.rowcount())
			end if
			if rt_code <> 0 then
				ib_yesno = true
			end if
		else
			ib_yesno = true
		end if
	end if
	if ib_yesno = true then
		messagebox("Duplication Error", "Current row is duplicate")
		li_errcode = -1
	else
		li_errcode = 0
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		this.id_detail.setcolumn("moduleid")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.module[this.il_currrow] = li_null
	end if
	return li_errcode

// w_cashierjob.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_cashierjob.wf_markinactive() returns long
	long ll_row
	long ll_code
	string ls_active
	ll_row = this.id_list.getrow()
	if this.id_list.rowcount() > 0 and ll_row > 0 then
		ls_active = this.id_list.object.active[ll_row]
		ll_code = this.id_list.object.code[ll_row]
		if ls_active = "Y" and ll_code > 0 then
			SQL rollback USING this.it_transobject;
			SQL update CashierJob SET Active ='N' , InactiveDate =GetDate ( ) WHERE CashierJobCode =:ll_code USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				SQL commit USING this.it_transobject;
				messagebox("Cashier Job", "Cashier Job " + string(ll_code) + " Successfully Marked as In-Active.", information!)
			else
				messagebox("Cashier Job", "Proble in marking Cashier Job " + string(ll_code) + " as In-Active. Details are:~r~n" + this.it_transobject.sqlerrtext, stopsign!)
				SQL rollback USING this.it_transobject;
			end if
		end if
	end if
	return 0

// w_cashierjob.wf_print_cashieractivity() returns long
	long ll_cashierjob
	if this.id_list.getrow() > 0 then
		ll_cashierjob = this.id_list.object.code[this.id_list.getrow()]
		openwithparm(w_cashieractivity_for_a_job, ll_cashierjob)
	end if
	return 0

// w_cashierjob.wf_setcashierjob(long al_jobowner) returns long
	long ll_jobcode
	long ll_retcode
	long ll_counter
	long ll_rowcount
	long ll_insrow
	datastore lds_detail
	datastore lds_header
	SQL SELECT Max ( CashierJobCode ) INTO :ll_jobcode FROM CashierJob WHERE CashierJob.JobOwner =:al_jobowner USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_retcode = 0
	else
		ll_retcode = 1
		return 1
	end if
	if ll_retcode = 0 and ll_jobcode > 0 then
		lds_header = create datastore
		lds_header.dataobject = this.id_master.dataobject
		lds_header.settransobject(this.it_transobject)
		lds_detail = create datastore
		lds_detail.dataobject = this.id_detail.dataobject
		lds_detail.settransobject(this.it_transobject)
		lds_header.retrieve(ll_jobcode)
		lds_detail.retrieve(ll_jobcode)
		if lds_header.rowcount() > 0 then
			this.id_master.object.showsuperviseddocuments[1] = lds_header.object.showsuperviseddocuments[1]
			this.id_master.object.remarks[1] = lds_header.object.remarks[1]
			if lds_detail.rowcount() > 0 then
				this.id_detail.reset()
				ll_counter = 1
				for ll_counter = 1 to lds_detail.rowcount()
					ll_insrow = this.id_detail.insertrow(0)
					if ll_insrow > 0 then
						this.id_detail.object.moduleid[ll_insrow] = lds_detail.object.moduleid[ll_counter]
					end if
				next
			else
				ll_retcode = 0
			end if
		else
			ll_retcode = 0
		end if
	end if
	return ll_retcode

// w_cashierjob.wf_set_defaultfilter() returns integer
	string ls_filter
	if this.id_master.rowcount() > 0 then
		ls_filter = this.id_master.object.defaultfiltercriteria[1]
		if ls_filter = "" or isnull(ls_filter) or ls_filter = "?" then
			setnull(ls_filter)
		end if
		this.id_footer.setfilter(ls_filter)
		this.id_footer.filter()
		ls_filter = this.id_footer.object.datawindow.table.filter
		this.id_master.object.defaultfiltercriteria[1] = ls_filter
	end if
	return 0

// w_cashierjob.create() returns 0 [event]
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_cashierjobmenu" then
		this.menuid = create m_cashierjobmenu
	end if

// w_cashierjob.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_cashierjob.ue_save() returns 0 [event]
	long ll_mastercurrrow
	long ll_invid
	long ll_detailrows
	long ll_jobowner
	long ll_count
	long ll_usercode
	integer li_counter
	integer ll_salesmancode
	boolean lb_commitflag = true
	dwitemstatus lds_rowstatus
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	open(w_salesmanpassword)
	ll_usercode = long(message.doubleparm)
	setfocus()
	setpointer(hourglass!)
	if ll_usercode > 0 then
		ll_mastercurrrow = this.id_master.getrow()
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if ll_invid > 0 then
			return
		end if
		ll_jobowner = this.id_master.object.jobowner[ll_mastercurrrow]
		SQL SELECT Count ( *) INTO :ll_count FROM CashierJob WHERE JobOwner =:ll_jobowner AND Active ='Y' USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if ll_count > 0 then
				messagebox("Job Owner Validation", "The Selected Job Owner already has some Active Cashier Job.~r~nAs a rule only one active cashier job is allowed for each cashier.", stopsign!)
				return
			end if
		else
			messagebox("Job Owner Validation", "Problem while Job Owner validation.~r~nReasons are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
			return
		end if
		if isnull(ll_invid) then
			wf_tabnewid("cashierjob", ll_invid)
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
		end if
		this.id_master.object.usercode[ll_mastercurrrow] = ll_usercode
		ll_detailrows = this.id_detail.rowcount()
		li_counter = 1
		do while li_counter <= ll_detailrows and lb_commitflag = true
			lds_rowstatus = this.id_detail.getitemstatus(li_counter, 0, primary!)
			if lds_rowstatus = newmodified! then
				this.id_detail.setitem(li_counter, "code", ll_invid)
			end if
			li_counter = li_counter + 1
		loop
		call super::ue_save
	end if
	setpointer(arrow!)

// w_cashierjob.ue_newform() returns 0 [event]
	m_cashierjobmenu lm_menu
	call super::ue_newform
	lm_menu = this.menuid
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	this.id_master.setfocus()
	lm_menu.m_file.m_post.enabled = false
	if this.id_master.rowcount() > 0 then
		this.id_master.object.jobowner[1] = gl_usercode
		wf_setcashierjob(gl_usercode)
	end if

// w_cashierjob.ue_newitem() returns 0 [event]
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	call super::ue_newitem
	this.id_detail.setcolumn("moduleid")

// w_cashierjob.ue_detail() returns 0 [event]
	call super::ue_detail
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_delete.enabled = true
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true
	wf_protectdw(this.id_master, 1)
	wf_protectdw(this.id_detail, 1)

// w_cashierjob.ue_list() returns 0 [event]
	m_cashierjobmenu lm_menu
	call super::ue_list
	lm_menu = this.menuid
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	this.id_master.setfocus()
	lm_menu.m_file.m_post.enabled = true

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "name"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	case "manfname"
		if data = "" or isnull(data) then
			messagebox("ManfName Validation", "Value requiredfor " + upper(dwo.manfname) + "in current row")
		end if
	case "manager"
		if data = "" or isnull(data) then
			messagebox("Manager Validation", "Value required for Manager in current row")
		end if
	end choose
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "jobowner"
		if long(data) > 0 then
			ll_retcode = parent.parent.parent.wf_setcashierjob(long(data))
		else
			ll_retcode = 1
		end if
		return ll_retcode
	end choose
	return ll_retcode

// dw_detail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	choose case dwo.name
	case "b_filter"
		parent.parent.parent.wf_set_defaultfilter()
		return ll_retcode
	end choose
	return ll_retcode

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	string ls_managername
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "moduleid"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_itemvalidated = false
		li_errcode = 0
	case else
		parent.parent.parent.ib_itemvalidated = true
	end choose
	return li_errcode

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "moduleid"
		if data = "" or isnull(data) then
			messagebox("Module Validation", "Value required module in current row")
		end if
	end choose
	return 1

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	return ::message.returnvalue
