// window w_physicalexam_form (eprescriptionbasics)  ancestor: w_single_entry

// w_physicalexam_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM PhysicalExam WHERE PhysicalExam.name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_physicalexam_form.create() returns 0 [event]
	call super::create

// w_physicalexam_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_physicalexam_form.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_physicalexam_form.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "PhysicalExam"
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "name"
		if isnull(data) or data = "" then
			messagebox("Name Validation", "Name Error~n~rPlease Choose Some Valid Name")
			return 1
		end if
	end choose
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "name"
		messagebox("Name Validation", "Name Error~r~nPlease enter some valid name")
	end choose
	return 1

// dw_detail.ue_enterkey() returns long [event]
	if parent.parent.parent.id_detail.getcolumnname() <> "description" then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue
