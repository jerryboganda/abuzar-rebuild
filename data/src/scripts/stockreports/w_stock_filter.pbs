	closewithreturn(w_stock_filter, this.is_selectedreport)
	return ::message.returnvalue

// w_stock_filter.open() returns long [event]
	environment le_env
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_width = pixelstounits(le_env.screenwidth, xpixelstounits!) - this.width
		ll_height = pixelstounits(le_env.screenheight, ypixelstounits!) - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width * 0.5
			ll_height = ll_height * 0.5
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.triggerevent(close!)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	if parent.rb_stockwithmargin.checked then
		parent.is_selectedreport = "d_stockinhand_margin"
	elseif parent.rb_allitem.checked then
		parent.is_selectedreport = "d_stockinhand_godownwise"
	elseif parent.rb_categorywise.checked then
		parent.is_selectedreport = "d_stockinhand_godownwise_powerwise"
