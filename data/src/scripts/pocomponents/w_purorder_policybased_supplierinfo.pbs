// window w_purorder_policybased_supplierinfo (pocomponents)  ancestor: window

// w_purorder_policybased_supplierinfo.create() returns 0 [event]
	this.cb_print = create cb_print
	this.dw_control = create dw_control
	this.control = {this.cb_print, this.dw_control}

// w_purorder_policybased_supplierinfo.destroy() returns 0 [event]
	destroy this.cb_print
	destroy this.dw_control

// w_purorder_policybased_supplierinfo.open() returns long [event]
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) <> 1 then
		return ::message.returnvalue
	end if
	this.istr_arg = ::message.powerobjectparm
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.width = ll_width * 0.98
	this.height = ll_height * 0.90
	this.y = int((ll_height - this.height) / 2.0)
	this.dw_control.width = this.width - this.width * 0.02
	this.dw_control.height = this.height * 0.90
	this.cb_print.y = this.dw_control.height + 20
	this.dw_control.settransobject(sqlca)
	this.dw_control.retrieve(this.istr_arg.d_edate)
	this.dw_control.modify("DataWindow.Print.Preview=yes DataWindow.Print.Preview.Rulers=yes")
	return ::message.returnvalue

// w_purorder_policybased_supplierinfo.close() returns long [event]
	close(this)
	return ::message.returnvalue

// w_purorder_policybased_supplierinfo.key(keycode key, unsignedlong keyflags) returns long [event]
	if keydown(keyescape!) then
		close(this)
	end if
	return ::message.returnvalue

// cb_print.clicked() returns long [event]
	if parent.dw_control.visible then
		if printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			parent.dw_control.printcancel()
		end if
		parent.dw_control.print()
	end if
	return ::message.returnvalue
