		this.ib_allowchangeincalculatedpacks = true
	else
		this.ib_allowchangeincalculatedpacks = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 617", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_detail.object.rate.protect = 0
	else
		this.id_detail.object.rate.protect = 1
	end if
	ll_found = 0
