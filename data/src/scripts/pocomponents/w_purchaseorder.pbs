		this.id_detail.object.foreignprice.visible = true
		this.id_detail.object.c_foreigntotal.visible = true
	else
		this.id_master.object.currencycode.visible = false
		this.id_master.object.currencycode_t.visible = false
		this.id_master.object.conversionfactor.visible = false
		this.id_master.object.conversionfactor_t.visible = false
		this.id_detail.object.foreignprice.visible = false
		this.id_detail.object.c_foreigntotal.visible = false
