		this.id_detail.object.qty.protect = 0
	else
		this.id_detail.object.qty.protect = 1
	end if
	if f_stringpreferences("InvDiscPercInPO") = "N" then
		this.id_footer.object.discperc.visible = false
		this.id_footer.object.discperc_t.visible = false
		this.id_footer.object.invdiscvalue.visible = false
		this.id_footer.object.invdiscvalue_t.visible = false
