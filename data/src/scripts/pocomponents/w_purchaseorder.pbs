// w_purchaseorder.wf_populate_purorder() returns long
	datastore lds_itemselected
	datastore lds_poheader
	integer li_result
	integer li_rtncode
	boolean populateflag = true
	s_saletemplate lstr_template
	string ls_itemtotalval
	string ls_fullcode
	string ls_errortext
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_retrievecount
	long ll_lockedcount
	long ll_detailrows
	long ll_count
	long ll_duplrows
	long ll_purordercount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packsalestax
	double ld_gstperc
	double ld_unitsalestax
	double ld_godownstock
	double ld_allgodownstock
	double ld_stock
	if this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate items after posting!")
		return 0
	end if
	setpointer(hourglass!)
	this.id_detail.setredraw(false)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		if not isnull(this.id_detail.object.icode[1]) then
			li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
			if li_result = 1 then
				for ll_count = 1 to ll_detailrows
					this.id_detail.deleterow(0)
				next
				if this.id_detail.update() <> 1 then
					messagebox("DataBase Problem", "Problem in Deleting Rows")
					return 0
				end if
			else
				populateflag = false
			end if
		else
			this.id_detail.reset()
		end if
	end if
	if populateflag = true then
		open(w_editpurchaseorderform)
		lstr_template = message.powerobjectparm
		if lstr_template.l_invtemplate > 0 then
			setpointer(hourglass!)
			lds_poheader = create datastore
			lds_poheader.dataobject = "d_purchaseorderheader"
			lds_poheader.settransobject(this.it_transobject)
			lds_poheader.retrieve(lstr_template.l_invtemplate)
			if lds_poheader.rowcount() > 0 then
				this.id_master.object.suppcode[1] = lds_poheader.object.suppcode[1]
				this.id_master.object.requireddate[1] = lds_poheader.object.requireddate[1]
				this.id_master.object.purordercatcode[1] = lds_poheader.object.purordercatcode[1]
				this.id_master.object.remarks[1] = lds_poheader.object.remarks[1]
				this.id_master.object.remarks2[1] = lds_poheader.object.remarks2[1]
				this.id_master.object.remarks3[1] = lds_poheader.object.remarks3[1]
				this.id_master.object.supplierreference[1] = lds_poheader.object.supplierreference[1]
				this.id_master.object.startdate[1] = lds_poheader.object.startdate[1]
				this.id_master.object.enddate[1] = lds_poheader.object.enddate[1]
				this.id_master.object.usagelocation[1] = lds_poheader.object.usagelocation[1]
				this.id_master.object.deliverylocation[1] = lds_poheader.object.deliverylocation[1]
				this.id_master.object.projectionperiod[1] = lds_poheader.object.projectionperiod[1]
				this.id_master.object.zeroqty[1] = lds_poheader.object.zeroqty[1]
				this.id_master.object.currencycode[1] = lds_poheader.object.currencycode[1]
				this.id_master.object.conversionfactor[1] = lds_poheader.object.conversionfactor[1]
				this.id_master.object.manfcode[1] = lds_poheader.object.manfcode[1]
				this.id_master.object.purorderterms1[1] = lds_poheader.object.purorderterms1[1]
				this.id_master.object.purorderterms2[1] = lds_poheader.object.purorderterms2[1]
				this.id_master.object.purorderterms3[1] = lds_poheader.object.purorderterms3[1]
				this.id_master.object.purorderterms4[1] = lds_poheader.object.purorderterms4[1]
				this.id_master.object.purorderterms5[1] = lds_poheader.object.purorderterms5[1]
				this.id_master.object.purorderterms6[1] = lds_poheader.object.purorderterms6[1]
				this.id_master.object.purorderterms7[1] = lds_poheader.object.purorderterms7[1]
				this.id_master.object.purorderterms8[1] = lds_poheader.object.purorderterms8[1]
				this.id_master.object.custcode[1] = lds_poheader.object.custcode[1]
				this.id_master.object.demanddraftno[1] = lds_poheader.object.demanddraftno[1]
				this.id_master.object.dated[1] = lds_poheader.object.dated[1]
				this.id_master.object.amount[1] = lds_poheader.object.amount[1]
				this.id_master.object.discperc[1] = lds_poheader.object.discperc[1]
				this.id_master.object.invgstperc1[1] = lds_poheader.object.invgstperc1[1]
				this.id_master.object.flatdisc[1] = lds_poheader.object.flatdisc[1]
				this.id_master.object.misccharges[1] = lds_poheader.object.misccharges[1]
			end if
			lds_itemselected = create datastore
			lds_itemselected.dataobject = "d_populatepurorder"
			lds_itemselected.settransobject(this.it_transobject)
			this.id_detail.reset()
			ll_rtcode = lds_itemselected.retrieve(lstr_template.l_invtemplate)
			ll_rowcount = lds_itemselected.rowcount()
			for ll_count = 1 to ll_rowcount
				this.id_detail.insertrow(0)
				ll_icode = lds_itemselected.object.icode[ll_count]
				ll_gcode = lds_itemselected.object.gcode[ll_count]
				if wf_inititeminfo(ll_icode, ll_count) then
					this.id_detail.object.alternatecustomicode[ll_count] = lds_itemselected.object.alternatecustomicode[ll_count]
					this.id_detail.object.qty[ll_count] = lds_itemselected.object.qty[ll_count]
					this.id_detail.object.purprice[ll_count] = lds_itemselected.object.rate[ll_count]
					this.id_detail.object.discperc[ll_count] = lds_itemselected.object.discperc[ll_count]
					this.id_detail.object.bonusqty[ll_count] = lds_itemselected.object.bonusqty[ll_count]
					this.id_detail.object.foreignprice[ll_count] = lds_itemselected.object.foreignprice[ll_count]
					this.id_detail.object.saleprice[ll_count] = lds_itemselected.object.saleprice[ll_count]
					this.id_detail.object.packsalestax[ll_count] = lds_itemselected.object.packsalestax[ll_count]
					this.id_detail.object.gstperc[ll_count] = lds_itemselected.object.gstperc[ll_count]
					this.id_detail.setitemstatus(ll_count, "rate", primary!, notmodified!)
					ll_retrievecount = ll_retrievecount + 1
				end if
			next
			destroy lds_itemselected
		end if
		if ll_retrievecount = ll_rowcount then
			messagebox("Result", string(ll_rowcount) + " Items are populated. ")
		else
			messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_lockedcount) + " records are retrieved successfully~n~r" + string(ll_lockedcount) + " records are in error")
		end if
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_purchaseorder.wf_apply_interfacesetting_list() returns integer
	long ll_counter
	datastore lds_listsetting
	lds_listsetting = create datastore
	lds_listsetting.dataobject = "d_interfacesettingcols"
	lds_listsetting.settransobject(this.it_transobject)
	lds_listsetting.retrieve(16, 4, 0)
	for ll_counter = 1 to lds_listsetting.rowcount()
		this.id_list.modify(lds_listsetting.getitemstring(ll_counter, "colname") + "_t" + ".Visible=0")
		this.id_list.modify(lds_listsetting.getitemstring(ll_counter, "colname") + ".Visible=0")
	next
	return 0

// w_purchaseorder.wf_populate_purchase_po_disparity_items() returns long
	datastore lds_itemselected
	datastore lds_poheader
	integer li_result
	integer li_rtncode
	boolean populateflag = true
	s_arguements ls_arg
	string ls_itemtotalval
	string ls_fullcode
	string ls_errortext
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_retrievecount
	long ll_lockedcount
	long ll_detailrows
	long ll_count
	long ll_duplrows
	long ll_purordercount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packsalestax
	double ld_gstperc
	double ld_unitsalestax
	double ld_godownstock
	double ld_allgodownstock
	double ld_stock
	if this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate items after posting!")
		return 0
	end if
	setpointer(hourglass!)
	this.id_detail.setredraw(false)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		if not isnull(this.id_detail.object.icode[1]) then
			li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
			if li_result = 1 then
				for ll_count = 1 to ll_detailrows
					this.id_detail.deleterow(0)
				next
				if this.id_detail.update() <> 1 then
					messagebox("DataBase Problem", "Problem in Deleting Rows")
					return 0
				end if
			else
				populateflag = false
			end if
		else
			this.id_detail.reset()
		end if
	end if
	if populateflag = true then
		open(w_purinvoices_supp_sdate_ldate)
		ls_arg = message.powerobjectparm
		if ls_arg.i_status = 1 then
			setpointer(hourglass!)
			lds_itemselected = create datastore
			lds_itemselected.dataobject = "d_populate_purchase_po_disparity"
			lds_itemselected.settransobject(this.it_transobject)
			this.id_detail.reset()
			ll_rtcode = lds_itemselected.retrieve(ls_arg.ia_integerlist, ls_arg.d_sdate, ls_arg.d_edate)
			ll_rowcount = lds_itemselected.rowcount()
			for ll_count = 1 to ll_rowcount
				this.id_detail.insertrow(0)
				ll_icode = lds_itemselected.object.icode[ll_count]
				if wf_inititeminfo(ll_icode, ll_count) then
					this.id_detail.object.qty[ll_count] = lds_itemselected.object.netqty[ll_count]
					this.id_detail.object.bonusqty[ll_count] = lds_itemselected.object.netbonus[ll_count]
					this.id_detail.setitemstatus(ll_count, "rate", primary!, notmodified!)
					ll_retrievecount = ll_retrievecount + 1
				end if
			next
			destroy lds_itemselected
		end if
		if ll_retrievecount = ll_rowcount then
			messagebox("Result", string(ll_rowcount) + " Items are populated. ")
		else
			messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_lockedcount) + " records are retrieved successfully~n~r" + string(ll_lockedcount) + " records are in error")
		end if
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_purchaseorder.wf_populate_netsales_as_po() returns long
	datastore lds_po
	datastore lds_suppitems
	long ll_counter
	long ll_endrow
	long ll_rows
	long ll_porow
	long ll_days
	long ll_projectiondays
	long ll_minqty
	long ll_suppitemrows
	long ll_insrow
	long ll_found
	long ll_packunits
	long ll_icode
	long ll_code
	long ll_orderlevel_type
	integer li_allrows
	double ld_avgqty
	double ld_packqty
	double ld_purdiscperc
	double ld_bonusqty
	double ld_packstock
	string ls_fullcode
	string ls_name
	boolean lb_suppitems
	boolean lb_insertrow = true
	boolean lb_suppitemsonly
	double ld_tmpqty
	double ld_tmpbonus
	double ld_transitstock
	double ld_stock
	double ld_forecastqty
	double ld_looseqty
	double ld_saleorderrequest
	m_purchaseordermenu lm_menu
	s_arguements lstr_arg
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.getitemnumber(1, "code") > 0.0 and this.id_master.getitemstring(1, "Posted") = "Y" then
		messagebox("Problem", "Can not pouplate items after posting!")
		return 0
	end if
	if this.id_master.object.purordercatcode[1] <> 2 then
		messagebox("Problem", "This Option can only be used in Porjection Based Purchase Order as it requires sales and return qty.", information!)
		return 0
	end if
	if this.id_master.accepttext() = -1 then
		return 0
	end if
	if this.id_master.object.purordercatcode[1] = 2 then
		ll_days = daysafter(date(this.id_master.object.startdate[this.id_master.getrow()]), date(this.id_master.object.enddate[this.id_master.getrow()])) + 1
		ll_projectiondays = this.id_master.getitemnumber(1, "projectionperiod")
		if ll_days = 0 or ll_projectiondays = 0 or isnull(ll_days) or isnull(ll_projectiondays) then
			messagebox("Problem Generating Order", "Please Select Valid Base Period and Projection Days.")
			return 0
		end if
		if this.id_master.object.startdate[this.id_master.getrow()] > this.id_master.object.enddate[this.id_master.getrow()] then
			messagebox("Problem Generating Order", "Please Select Valid Base Period.")
			return 0
		end if
		return
	end if
	if lm_menu.m_file.m_supplieritemsonly.checked = true and not isnull(this.id_master.object.suppcode[1]) then
		lds_suppitems = create datastore
		lds_suppitems.dataobject = "d_item_suppliers"
		lds_suppitems.settransobject(sqlca)
		lb_suppitemsonly = true
		ll_suppitemrows = lds_suppitems.retrieve(this.id_master.object.suppcode[1])
		if ll_suppitemrows > 0 then
			lb_suppitems = true
		else
			lb_suppitems = false
		end if
	else
		lb_suppitems = false
	end if
	lds_po = create datastore
	lstr_arg.i_status = 1
	if lstr_arg.i_status = 1 then
		ll_counter = 1
		for ll_counter = this.id_detail.rowcount() to 1 step -1
			this.id_detail.deleterow(ll_counter)
		next
		if lstr_arg.i_status = 1 then
			lds_po.dataobject = "d_populate_netsaleqty_as_po"
			lds_po.settransobject(sqlca)
			ll_rows = lds_po.retrieve(this.id_master.object.startdate[this.id_master.getrow()], this.id_master.object.enddate[this.id_master.getrow()])
		end if
		if ll_rows >= 0 then
			ll_endrow = lds_po.rowcount()
			setpointer(hourglass!)
			ll_days = daysafter(date(this.id_master.object.startdate[this.id_master.getrow()]), date(this.id_master.object.enddate[this.id_master.getrow()]))
			ll_projectiondays = this.id_master.getitemnumber(1, "projectionperiod")
			li_allrows = 0
			ll_porow = 0
			if ll_days = 0 then
				ll_days = 1
			end if
			for ll_counter = 1 to ll_endrow
				ld_transitstock = lds_po.object.transitstock[ll_counter]
				ld_stock = lds_po.getitemnumber(ll_counter, "stock")
				ld_avgqty = (lds_po.getitemnumber(ll_counter, "soldqty") - lds_po.getitemnumber(ll_counter, "Returnqty")) / ll_days
				ld_forecastqty = ceiling(ld_avgqty * ll_projectiondays)
				ll_minqty = lds_po.getitemnumber(ll_counter, "minqty")
				ld_looseqty = lds_po.getitemnumber(ll_counter, "soldqty") - lds_po.getitemnumber(ll_counter, "Returnqty")
				ll_packunits = lds_po.getitemnumber(ll_counter, "packunits")
				if ll_packunits = 0 then
					ll_packunits = 1
				end if
				ld_packqty = ceiling(ld_looseqty / ll_packunits)
				if ld_packqty > 0.0 or li_allrows = 1 then
					if lb_suppitems then
						ll_found = lds_suppitems.find("icode = " + trim(string(lds_po.getitemnumber(ll_counter, "icode"))), 1, ll_suppitemrows)
						if ll_found > 0 then
							this.id_detail.insertrow(0)
							lb_insertrow = true
							ll_insrow = ll_insrow + 1
						else
							lb_insertrow = false
						end if
					else
						this.id_detail.insertrow(0)
						lb_insertrow = true
						ll_insrow = ll_insrow + 1
					end if
					if lb_insertrow = true then
						ll_icode = lds_po.object.icode[ll_counter]
						SQL SELECT purdiscperc INTO :ld_purdiscperc FROM ITEM WHERE Icode =:ll_icode USING sqlca;
						this.id_detail.setitem(ll_insrow, "icode", lds_po.getitemnumber(ll_counter, "icode"))
						this.id_detail.setitem(ll_insrow, "rate", lds_po.getitemnumber(ll_counter, "purprice"))
						this.id_detail.setitem(ll_insrow, "stock", lds_po.getitemnumber(ll_counter, "stock"))
						this.id_detail.setitem(ll_insrow, "transitstock", lds_po.getitemnumber(ll_counter, "transitstock"))
						this.id_detail.object.saleorderrequest[ll_insrow] = 0
						this.id_detail.setitem(ll_insrow, "soldqty", lds_po.getitemnumber(ll_counter, "soldqty"))
						this.id_detail.setitem(ll_insrow, "returnqty", lds_po.getitemnumber(ll_counter, "returnqty"))
						this.id_detail.setitem(ll_insrow, "netsaleqty", lds_po.getitemnumber(ll_counter, "soldqty") - lds_po.getitemnumber(ll_counter, "returnqty"))
						this.id_detail.setitem(ll_insrow, "packunits", lds_po.getitemnumber(ll_counter, "packunits"))
						this.id_detail.setitem(ll_insrow, "minqty", lds_po.getitemnumber(ll_counter, "minqty"))
						this.id_detail.setitem(ll_insrow, "avgsaleqty", ld_avgqty)
						this.id_detail.setitem(ll_insrow, "forecastqty", ld_forecastqty)
						this.id_detail.setitem(ll_insrow, "looseqty", ld_looseqty)
						this.id_detail.setitem(ll_insrow, "qty", ld_packqty)
						this.id_detail.setitem(ll_insrow, "allowedqty", ld_packqty)
						this.id_detail.setitem(ll_insrow, "fullcode", lds_po.getitemstring(ll_counter, "aliasname"))
						this.id_detail.setitem(ll_insrow, "itemname", lds_po.getitemstring(ll_counter, "item"))
						this.id_detail.setitem(ll_insrow, "manufname", lds_po.getitemstring(ll_counter, "manufacturer"))
						this.id_detail.object.itemcategory[ll_insrow] = lds_po.object.itemcategory[ll_counter]
						this.id_detail.object.itemclass[ll_insrow] = lds_po.object.itemclass[ll_counter]
						this.id_detail.object.itempacking[ll_insrow] = lds_po.object.itempacking[ll_counter]
						this.id_detail.object.genericitem[ll_insrow] = lds_po.object.genericitem[ll_counter]
						this.id_detail.object.discperc[ll_insrow] = ld_purdiscperc
						this.id_detail.object.purprice[ll_insrow] = lds_po.object.purprice[ll_counter]
						this.id_detail.object.saleprice[ll_insrow] = lds_po.object.saleprice[ll_counter]
						this.id_detail.object.rpp[ll_insrow] = lds_po.object.rpp[ll_counter]
						this.id_detail.object.packavgprice[ll_insrow] = lds_po.object.packavgprice[ll_counter]
						this.id_detail.object.lastpurinvcode[ll_insrow] = lds_po.object.lastpurinvcode[ll_counter]
						this.id_detail.object.lastpurdate[ll_insrow] = lds_po.object.lastpurdate[ll_counter]
						if f_stringpreferences("ItemGSTPercInPO") = "N" then
							this.id_detail.object.gstperc[ll_insrow] = 0
						else
							this.id_detail.object.gstperc[ll_insrow] = lds_po.object.gstperc[ll_counter]
						end if
						if f_stringpreferences("ItemUnitTaxInPO") = "N" then
							this.id_detail.object.packsalestax[ll_insrow] = 0
						else
							this.id_detail.object.packsalestax[ll_insrow] = lds_po.object.packsalestax[ll_counter]
						end if
					end if
				end if
			next
			this.id_detail.scrolltorow(0)
			setpointer(arrow!)
			this.im_menu.m_file.m_options.enabled = true
			this.im_menu.m_file.m_save.enabled = true
			this.im_menu.m_file.m_print.enabled = true
		else
			messagebox("Retrieve Fail", "Can not Generate Purchase Order", exclamation!, ok!, 1)
		end if
	end if
	wf_grandtotal()
	destroy lds_po
	destroy lds_suppitems
	return 0

// w_purchaseorder.wf_show_popolicybased_supplierlist() returns long
	boolean lb_listtab
	string ls_orderdate
	s_arguements lstr_arg
	if wf_iseditable() then
		return 0
	end if
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab = false then
		return 0
	end if
	if this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 then
		open(w_arg_po_generate_sdate_ldate)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = 1 then
			openwithparm(w_purorder_policybased_supplierinfo, lstr_arg)
		end if
	end if
	return 0

// w_purchaseorder.wf_check_groupsuppliercategory() returns long
	long ll_acccode
	long ll_found
	long ll_code
	long ll_counter
	long ll_rowcount
	long ll_groupcode
	long ll_suppcatcode
	boolean lb_groupcustcat
	if f_stringpreferences("GroupSuppCatInPurAndPR") = "N" then
		return 0
	end if
	ll_groupcode = f_getgroupcode(gl_usercode)
	ll_rowcount = this.id_detail.rowcount()
	ll_acccode = this.id_master.getitemnumber(1, "suppcode")
	SQL Select MAX ( SuppCode ) , MAX ( SuppCatCode ) INTO :ll_found, :ll_suppcatcode From dbo.supplier Where suppcode =:ll_acccode USING this.it_transobject;
	if ll_found > 0 and ll_suppcatcode > 0 and this.it_transobject.sqlcode = 0 then
		ll_found = 0
		SQL SELECT count ( suppcatcode ) INTO :ll_found FROM GroupSupplierCategory WHERE SuppCatCode =:ll_suppcatcode AND GroupCode =:ll_groupcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 and ll_found < 1 then
			return -1
		end if
		return
	end if
	return 0

// w_purchaseorder.wf_apply_groupsuppliercategory() returns long
	long ll_counter
	integer li_rtncode
	string ls_filterstring
	datastore lds_groupsuppcategory
	if f_stringpreferences("GroupSuppCatInPurAndPR") = "Y" then
		lds_groupsuppcategory = create datastore
		lds_groupsuppcategory.dataobject = "d_groupsuppcategory_detail"
		lds_groupsuppcategory.settransobject(this.it_transobject)
		this.il_groupcode = f_getgroupcode(gl_usercode)
		lds_groupsuppcategory.retrieve(this.il_groupcode)
		ls_filterstring = ""
		for ll_counter = 1 to lds_groupsuppcategory.rowcount()
			ls_filterstring = ls_filterstring + trim(string(lds_groupsuppcategory.object.suppcatcode[ll_counter])) + ","
		next
		if right(ls_filterstring, 1) = "," then
			ls_filterstring = left(ls_filterstring, len(ls_filterstring) - 1)
		end if
		if ls_filterstring = "" then
			ls_filterstring = "-1"
		end if
		this.idc_supplierlist.setfilter("suppcatcode In (" + ls_filterstring + ") ")
		this.idc_supplierlist.filter()
	end if
	return 0

// w_purchaseorder.wf_item_po_history() returns 0
	s_itempurchasehistory ls_itempurchasehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itempurchasehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itempurchasehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_item_po_history, ls_itempurchasehistory)
	end if

// w_purchaseorder.wf_consider_refusedsales() returns long
	long ll_retcode
	long ll_counter
	long ll_rowcount
	long ll_icode
	long ll_insrow
	long ll_found
	integer li_rtcode
	string ls_type
	string ls_errortext
	s_arguements ls_reparg
	datastore lds_store
	lds_store = create datastore
	lds_store.dataobject = "d_populate_refusedsales"
	lds_store.settransobject(sqlca)
	open(w_arg_sdate_ldate)
	ls_reparg = message.powerobjectparm
	if ls_reparg.i_status = 1 then
		ll_retcode = lds_store.retrieve(ls_reparg.d_sdate, ls_reparg.d_edate)
		ll_rowcount = lds_store.rowcount()
		if ll_rowcount > 0 then
			for ll_counter = 1 to ll_rowcount
				ll_icode = lds_store.object.icode[ll_counter]
				ll_found = this.id_detail.find("icode = " + trim(string(ll_icode)), 1, ll_rowcount)
				if not (ll_found > 0 and ll_found <= ll_rowcount) then
					ll_insrow = this.id_detail.insertrow(0)
					wf_inititeminfo(ll_icode, ll_insrow)
					this.id_detail.object.qty[ll_insrow] = 1
				end if
			next
		end if
	end if
	return ll_retcode

// w_purchaseorder.wf_update_itemalert(long al_icode, long al_itemalertcode) returns boolean
	boolean retflag = true
	if not isnull(al_itemalertcode) then
		SQL update item SET item.itemalertcode =:al_itemalertcode WHERE item.icode =:al_icode USING this.it_transobject;
		if this.it_transobject.sqlcode = -1 then
			retflag = false
		end if
	end if
	return retflag

// w_purchaseorder.wf_get_supp_associated_quotation(long al_suppcode) returns long
	long ll_retcode = -1
	long ll_quotationcode = -1
	if al_suppcode = 0 or isnull(al_suppcode) then
		ll_retcode = -1
		return ll_retcode
	else
		SQL SELECT PurQuotationCode INTO :ll_quotationcode FROM DBO.Supplier WHERE SuppCode =:al_suppcode USING sqlca;
		if sqlca.sqlcode = 0 then
			if ll_quotationcode = 0 or isnull(ll_quotationcode) then
				ll_retcode = 0
			else
				ll_retcode = ll_quotationcode
			end if
		else
			ll_retcode = -2
		end if
	end if
	return ll_retcode

// w_purchaseorder.wf_apply_supplier_quotation(integer ai_mode) returns integer
	long ll_suppcode
	long ll_masterrow
	long ll_quotationcode
	long ll_detailrows
	long ll_qheaderrow
	long ll_quotationrows
	long ll_found
	long ll_loosepack
	long ll_rowcount
	long ll_quotpackunits
	long ll_icode
	long ll_notfound_itemcount
	double ld_quotprice
	double ld_quotdiscperc
	double ld_quotitemflatdisc
	double ld_quotqty
	double ld_quotbonusqty
	double ld_qty
	double ld_bonusqty
	double ld_bonusfactor
	string ls_msgtitle = "Supplier Associated Quotation"
	string ls_itemname
	string ls_msgdetail
	boolean lb_editsaleprice
	boolean lb_editsalediscperc
	boolean lb_editbonusqty
	boolean lb_edititewflatdisc
	datastore lds_quotationdetail
	if wf_iseditable() = false then
		return 0
	end if
	if f_stringpreferences("applysupplierassociatedquotationinpo") = "N" then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_suppcode = this.id_master.getitemnumber(ll_masterrow, "suppcode")
	if ll_suppcode = 0 or isnull(ll_suppcode) then
		messagebox(ls_msgtitle, "Please Select Valid Supplier", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Items before applying Suppliers' Associated Quotation", stopsign!)
		return 0
	end if
	ll_quotationcode = wf_get_supp_associated_quotation(ll_suppcode)
	if ll_quotationcode < 0 then
		if ll_quotationcode = -1 then
			messagebox(ls_msgtitle, "Please Select Valid Supplier", stopsign!)
			return 0
		else
			messagebox(ls_msgtitle, "Problem in retrieving Associated Quotation of Supplier", stopsign!)
			return 0
		end if
	elseif ll_quotationcode = 0 then
		if ai_mode = 0 then
			messagebox(ls_msgtitle, "No Associated Quotation found for this Supplier", stopsign!)
			return 0
		else
			return 1
		end if
		return
	end if
	lds_quotationdetail = create datastore
	lds_quotationdetail.dataobject = "d_purquotationdetail_retrieve"
	lds_quotationdetail.settransobject(this.it_transobject)
	ll_quotationrows = lds_quotationdetail.retrieve(ll_quotationcode)
	if ll_quotationrows < 0 then
		messagebox(ls_msgtitle, "Associated Quotation Detail Retrieval Problem", stopsign!)
		return 0
	else
		ll_quotationrows = lds_quotationdetail.rowcount()
		if ll_quotationrows = 0 then
			if ai_mode = 0 then
				messagebox(ls_msgtitle, "Associated Quotation contain no rows", stopsign!)
				return 0
			else
				return 1
			end if
			return
		end if
	end if
	setredraw(false)
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ll_found = 0
		ll_found = lds_quotationdetail.find("icode = " + trim(string(ll_icode)), 1, ll_quotationrows)
		if ll_found > 0 then
			ll_quotpackunits = lds_quotationdetail.getitemnumber(ll_found, "packunits")
			ld_quotdiscperc = lds_quotationdetail.getitemnumber(ll_found, "discperc")
			if ll_quotpackunits = 0 then
				ll_quotpackunits = 1
			end if
			ld_quotqty = lds_quotationdetail.getitemnumber(ll_found, "qty")
			ld_quotbonusqty = lds_quotationdetail.getitemnumber(ll_found, "bonusqty")
			ld_quotprice = lds_quotationdetail.getitemnumber(ll_found, "purprice")
			if ld_quotqty <= 0.0 then
				ld_quotqty = 1
			end if
			this.id_detail.setitem(ll_rowcount, "rate", ld_quotprice)
			this.id_detail.setitem(ll_rowcount, "discperc", ld_quotdiscperc)
			this.id_detail.setitem(ll_rowcount, "packsalestax", lds_quotationdetail.getitemnumber(ll_found, "unitsalestax"))
			this.id_detail.setitem(ll_rowcount, "gstperc", lds_quotationdetail.getitemnumber(ll_found, "gstperc"))
		else
			ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname
			ll_notfound_itemcount = ll_notfound_itemcount + 1
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_notfound_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Guidelines Exist for Following " + trim(string(ll_notfound_itemcount)) + " item(s) in Associated Quotation/Pricing Contract~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_purchaseorder.wf_apply_supp_assoc_purquot(long al_icode, long al_row) returns long
	long ll_suppcode
	long ll_masterrow
	long ll_quotationcode
	long ll_detailrows
	long ll_quotationrows
	long ll_found
	long ll_quotpackunits
	long ll_icode
	double ld_quotprice
	double ld_quotdiscperc
	double ld_quotqty
	double ld_quotbonusqty
	double ld_qty
	double ld_bonusqty
	string ls_msgtitle = "Supplier Associated Quotation"
	string ls_itemname
	string ls_msgdetail
	boolean lb_editsaleprice
	boolean lb_editsalediscperc
	boolean lb_editbonusqty
	boolean lb_edititewflatdisc
	datastore lds_quotationdetail
	if wf_iseditable() = false then
		return 0
	end if
	if f_stringpreferences("applysupplierassociatedquotationinpo") = "N" then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_suppcode = this.id_master.getitemnumber(ll_masterrow, "suppcode")
	if ll_suppcode = 0 or isnull(ll_suppcode) then
		messagebox(ls_msgtitle, "Please Select Valid Supplier", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		return 0
	end if
	ll_quotationcode = wf_get_supp_associated_quotation(ll_suppcode)
	if ll_quotationcode < 0 then
		if ll_quotationcode = -1 then
			return 0
		else
			return 0
		end if
	elseif ll_quotationcode = 0 then
		return 0
	end if
	lds_quotationdetail = create datastore
	lds_quotationdetail.dataobject = "d_purquotationdetail_retrieve"
	lds_quotationdetail.settransobject(this.it_transobject)
	ll_quotationrows = lds_quotationdetail.retrieve(ll_quotationcode)
	if ll_quotationrows < 0 then
		return 0
	else
		ll_quotationrows = lds_quotationdetail.rowcount()
		if ll_quotationrows = 0 then
			return 0
		end if
	end if
	setredraw(false)
	if al_row > 0 and al_icode > 0 then
		ll_icode = al_icode
		ls_itemname = this.id_detail.getitemstring(al_row, "itemname")
		ll_found = 0
		ll_found = lds_quotationdetail.find("icode = " + trim(string(ll_icode)), 1, ll_quotationrows)
		if ll_found > 0 then
			ll_quotpackunits = lds_quotationdetail.getitemnumber(ll_found, "packunits")
			ld_quotdiscperc = lds_quotationdetail.getitemnumber(ll_found, "discperc")
			if ll_quotpackunits = 0 then
				ll_quotpackunits = 1
			end if
			ld_quotqty = lds_quotationdetail.getitemnumber(ll_found, "qty")
			ld_quotbonusqty = lds_quotationdetail.getitemnumber(ll_found, "bonusqty")
			ld_quotprice = lds_quotationdetail.getitemnumber(ll_found, "purprice")
			if ld_quotqty <= 0.0 then
				ld_quotqty = 1
			end if
			this.id_detail.setitem(al_row, "rate", ld_quotprice)
			this.id_detail.setitem(al_row, "discperc", ld_quotdiscperc)
			this.id_detail.setitem(al_row, "packsalestax", lds_quotationdetail.getitemnumber(ll_found, "unitsalestax"))
			this.id_detail.setitem(al_row, "gstperc", lds_quotationdetail.getitemnumber(ll_found, "gstperc"))
		end if
	end if
	setredraw(true)
	wf_grandtotal()
	return 1

// w_purchaseorder.wf_push_po_to_dropbox() returns long
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			li_errcode = this.it_transobject.pushpotodropbox(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode, gs_dropbox_server, gs_dropbox_db, "DBO", ll_saleinvcount)
			if li_errcode <> 0 then
				li_errcode = this.it_transobject.sqlcode
				ls_msgtext = this.it_transobject.sqlerrtext
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				ls_msgtext = this.it_transobject.sqlerrtext
				li_errcode = this.it_transobject.sqlcode
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Push P/O To Drop Box Fails", "Some database request fails, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode), stopsign!)
		else
			messagebox("Push to Drop Box Successfull", "Total Invoices to push were " + string(ll_saleinvcount) + "~n~rAll Invoices have been pushed successfully to drop box.", information!)
		end if
	end if
	return li_errcode

// w_purchaseorder.wf_check_manufacturertypes() returns long
	long ll_count
	SQL SELECT ISNULL ( Count ( *) , 0 ) INTO :ll_count FROM ManufacturerType USING sqlca;
	if sqlca.sqlcode = 0 then
		if ll_count > 0 then
			return ll_count
		else
			return 0
		end if
		return
	end if
	return -1

// w_purchaseorder.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_purchaseordermenu" then
		this.menuid = create m_purchaseordermenu
	end if
	this.dw_print = create dw_print
	this.dw_orderdetail = create dw_orderdetail
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print
	this.control[icurrent + 2] = this.dw_orderdetail

// w_purchaseorder.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_print
	destroy this.dw_orderdetail

// w_purchaseorder.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect
	datawindowchild ldc_itemdddw
	long ll_counter
	long ll_icode
	long ll_manfcode
	long ll_count
	long ll_code
	integer[] li_manf
	integer li_index = 1
	boolean lb_flag
	call super::ue_detail
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	if wf_isinvoiceinuse(ll_code) = true then
		messagebox("Invoice Validation", "Purchase Order already in use by some other user.~r~nKindly try again after sometime or open some other order.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if wf_check_groupsuppliercategory() <> 0 then
		messagebox("Group Wise Supplier Category Validation", "Current user group does not have enough permissions w.r.t supplier.~r~nPossible Reasons are:~r~nSupllier is not allowed to the current user group.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_new.enabled = true
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true
	this.im_menu.m_file.m_first.enabled = false
	this.im_menu.m_file.m_next.enabled = false
	this.im_menu.m_file.m_previous.enabled = false
	this.im_menu.m_file.m_last.enabled = false
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_retrieve.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.tab_retrieve.tabpage_detail.enabled = true
	this.id_footer.retrieve(this.id_master.object.code[1])
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	wf_setordersettings(this.id_master.object.purordercatcode[1])
	this.id_detail.retrieve(this.id_master.object.code[1])
	if this.id_master.object.purordercatcode[1] = 2 then
		ll_count = this.id_detail.rowcount()
		for ll_counter = 1 to ll_count
			if this.id_detail.object.forecastqty[ll_counter] > this.id_detail.object.stock[ll_counter] then
				this.id_detail.object.looseqty[ll_counter] = this.id_detail.object.forecastqty[ll_counter] - this.id_detail.object.stock[ll_counter]
				if this.id_detail.object.minqty[ll_counter] > this.id_detail.object.forecastqty[ll_counter] then
					this.id_detail.object.looseqty[ll_counter] = this.id_detail.object.minqty[ll_counter] - this.id_detail.object.stock[ll_counter]
				end if
			else
				this.id_detail.object.looseqty[ll_counter] = 0
				if this.id_detail.object.minqty[ll_counter] > this.id_detail.object.stock[ll_counter] then
					this.id_detail.object.looseqty[ll_counter] = this.id_detail.object.minqty[ll_counter] - this.id_detail.object.stock[ll_counter]
				end if
			end if
		next
	end if
	li_protect = 1
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 549 then
			li_protect = 0
		end if
	next
	if this.id_master.object.posted[1] = "Y" then
		this.im_menu.m_file.m_save.enabled = false
		this.im_menu.m_file.m_delete.enabled = false
		this.im_menu.m_item.m_newitem.enabled = false
		this.im_menu.m_item.m_deleteitem.enabled = false
		this.im_menu.m_file.m_options.enabled = false
		wf_protectdw(this.id_master, 1)
		wf_protectdw(this.id_detail, 1)
		wf_protectdw(this.id_footer, 1)
		this.editflag = false
	else
		if li_protect = 1 then
			this.im_menu.m_file.m_save.enabled = false
			this.im_menu.m_file.m_delete.enabled = false
			this.im_menu.m_item.m_newitem.enabled = false
			this.im_menu.m_item.m_deleteitem.enabled = false
			this.im_menu.m_file.m_options.enabled = false
			wf_protectdw(this.id_master, li_protect)
			wf_protectdw(this.id_detail, li_protect)
			wf_protectdw(this.id_footer, li_protect)
			this.editflag = false
		else
			this.id_master.setitem(1, "sitecode", gl_sitecode)
			this.im_menu.m_file.m_options.enabled = true
			this.im_menu.m_item.m_deleteitem.enabled = true
			this.editflag = true
		end if
		this.im_menu.m_file.m_new.enabled = false
	end if
	this.im_menu.m_file.m_post.enabled = false
	wf_grandtotal()

// w_purchaseorder.ue_newform() returns 0 [event]
	integer li_rtncode
	long ll_found
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.im_menu.item[3].item[1].enabled = true
	this.id_master.scrolltorow(1)
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	if f_stringpreferences("itemcode") = "N" then
		setredraw(false)
		this.id_detail.object.fullcode.visible = false
		setredraw(true)
	end if
	call super::ue_newform
	this.id_master.setitem(1, "PurOrderTerms1", f_stringpreferences("PurOrderTerms1"))
	this.id_master.setitem(1, "PurOrderTerms2", f_stringpreferences("PurOrderTerms2"))
	this.id_master.setitem(1, "PurOrderTerms3", f_stringpreferences("PurOrderTerms3"))
	this.id_master.setitem(1, "PurOrderTerms4", f_stringpreferences("PurOrderTerms4"))
	this.id_master.setitem(1, "PurOrderTerms5", f_stringpreferences("PurOrderTerms5"))
	this.id_master.setitem(1, "PurOrderTerms6", f_stringpreferences("PurOrderTerms6"))
	this.id_master.setitem(1, "PurOrderTerms7", f_stringpreferences("PurOrderTerms7"))
	this.id_master.setitem(1, "PurOrderTerms8", f_stringpreferences("PurOrderTerms8"))
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_options.enabled = true
	this.im_menu.m_file.m_post.enabled = false
	this.id_master.object.purordercatcode[1] = f_numberpreferences("POCategoryDefault")
	wf_setordersettings(this.id_master.object.purordercatcode[1])

// w_purchaseorder.ue_save() returns 0 [event]
	long ll_invid
	long ll_icode
	long ll_minqty
	long ll_reorderqty
	long ll_optimumqty
	long ll_counter
	long ll_detailrows
	long ll_mastercurrrow
	long ll_salesmancode
	long ll_itemalertcode
	double ld_discperc
	double ld_misccharges
	double ld_flatdisc
	double ld_invgstperc1
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_errtext
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	if wf_check_groupsuppliercategory() <> 0 then
		messagebox("Group Wise Supplier Category Validation", "Current user group does not have enough permissions w.r.t supplier.~r~nPossible Reasons are:~r~nSupllier is not allowed to the current user group.")
		this.id_master.setcolumn("suppcode")
		this.id_master.setfocus()
		return
	end if
	ll_detailrows = this.id_detail.rowcount()
	for ll_counter = 1 to ll_detailrows
		if isnull(this.id_detail.object.icode[ll_counter]) then
			return
		end if
		if this.id_detail.object.qty[ll_counter] < 0 then
			this.id_detail.setitem(ll_counter, "qty", 0)
		end if
	next
	if wf_check_supplier_items() <> 0 then
		return
	end if
	if f_stringpreferences("ApplyAssociatedQuotation_On_Save") = "Y" and wf_apply_associated_quotation(1) <= 0 then
		messagebox("Customer Associated Quotation", "Problem in using associated quotation")
		return
	end if
	if ll_detailrows >= 1 then
		for ll_counter = 1 to ll_detailrows
			if isnull(this.id_detail.object.icode[ll_counter]) then
				return
			end if
			if this.id_detail.object.qty[ll_counter] + this.id_detail.object.bonusqty[ll_counter] < 0 then
				this.id_detail.setfocus()
				this.id_detail.scrolltorow(ll_counter)
				this.id_detail.setcolumn("qty")
				messagebox("Item Validation", "Item Validation Error, please enter some valid quantity")
				return
			end if
		next
	elseif ll_detailrows <= 0 then
		messagebox("Purchase Order Validation", "There are no rows to save for this purchase order.~r~nKindly insert some rows than try again.")
		return
	end if
	ll_counter = 0
	if this.id_master.object.purordercatcode[1] = 1 then
		this.id_master.object.startdate[1] = today()
		this.id_master.object.enddate[1] = today()
		this.id_master.object.projectionperiod[1] = 0
		this.id_master.object.zeroqty[1] = 0
	end if
	wf_show_unposted_pr_reminder()
	if f_stringpreferences("puruserwindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	setfocus()
	if ll_salesmancode > 0 then
		setpointer(hourglass!)
		ll_mastercurrrow = this.id_master.getrow()
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			f_newtableid("purorderheader", ll_invid)
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
		else
			SQL Delete FROM purorderdetail where pocode =:ll_invid USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Updation Problem", "Updation Problem " + this.it_transobject.sqlerrtext)
			end if
		end if
		this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
		if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			return
		end if
		this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		ld_discperc = this.id_footer.getitemdecimal(this.id_footer.getrow(), "discperc")
		ld_invgstperc1 = this.id_footer.getitemdecimal(this.id_footer.getrow(), "invgstperc1")
		ld_flatdisc = this.id_footer.getitemdecimal(this.id_footer.getrow(), "flatdisc")
		ld_misccharges = this.id_footer.getitemdecimal(this.id_footer.getrow(), "misccharges")
		this.id_master.setitem(ll_mastercurrrow, "discperc", ld_discperc)
		this.id_master.setitem(ll_mastercurrrow, "invgstperc1", ld_invgstperc1)
		this.id_master.setitem(ll_mastercurrrow, "flatdisc", ld_flatdisc)
		this.id_master.setitem(ll_mastercurrrow, "misccharges", ld_misccharges)
		ll_detailrows = this.id_detail.rowcount()
		this.dw_orderdetail.reset()
		for ll_counter = 1 to ll_detailrows
			this.id_detail.setitem(ll_counter, "code", ll_invid)
			this.dw_orderdetail.insertrow(0)
			ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
			ll_minqty = this.id_detail.getitemnumber(ll_counter, "minqty")
			ll_reorderqty = this.id_detail.getitemnumber(ll_counter, "reorderqty")
			ll_optimumqty = this.id_detail.getitemnumber(ll_counter, "optimumqty")
			ll_itemalertcode = this.id_detail.getitemnumber(ll_counter, "itemalertcode")
			this.dw_orderdetail.setitem(ll_counter, "code", this.id_detail.getitemnumber(ll_counter, "code"))
			this.dw_orderdetail.setitem(ll_counter, "icode", this.id_detail.getitemnumber(ll_counter, "icode"))
			this.dw_orderdetail.setitem(ll_counter, "itemname", this.id_detail.getitemstring(ll_counter, "itemname"))
			this.dw_orderdetail.setitem(ll_counter, "alternatecustomicode", this.id_detail.getitemstring(ll_counter, "alternatecustomicode"))
			this.dw_orderdetail.setitem(ll_counter, "qty", this.id_detail.getitemnumber(ll_counter, "qty"))
			this.dw_orderdetail.setitem(ll_counter, "bonusqty", this.id_detail.getitemnumber(ll_counter, "bonusqty"))
			this.dw_orderdetail.setitem(ll_counter, "reorderqty", this.id_detail.getitemnumber(ll_counter, "reorderqty"))
			this.dw_orderdetail.setitem(ll_counter, "optimumqty", this.id_detail.getitemnumber(ll_counter, "optimumqty"))
			this.dw_orderdetail.setitem(ll_counter, "minqty", this.id_detail.getitemnumber(ll_counter, "minqty"))
			this.dw_orderdetail.setitem(ll_counter, "stock", this.id_detail.getitemnumber(ll_counter, "stock"))
			this.dw_orderdetail.setitem(ll_counter, "transitstock", this.id_detail.getitemnumber(ll_counter, "transitstock"))
			this.dw_orderdetail.setitem(ll_counter, "packunits", this.id_detail.getitemnumber(ll_counter, "packunits"))
			this.dw_orderdetail.setitem(ll_counter, "saleorderrequest", this.id_detail.getitemnumber(ll_counter, "saleorderrequest"))
			this.dw_orderdetail.setitem(ll_counter, "soldqty", this.id_detail.getitemnumber(ll_counter, "soldqty"))
			this.dw_orderdetail.setitem(ll_counter, "returnqty", this.id_detail.getitemnumber(ll_counter, "returnqty"))
			this.dw_orderdetail.setitem(ll_counter, "discperc", this.id_detail.getitemnumber(ll_counter, "discperc"))
			this.dw_orderdetail.setitem(ll_counter, "foreignprice", this.id_detail.getitemnumber(ll_counter, "foreignprice"))
			this.dw_orderdetail.setitem(ll_counter, "rate", this.id_detail.getitemnumber(ll_counter, "rate"))
			this.dw_orderdetail.setitem(ll_counter, "remarks", this.id_detail.getitemstring(ll_counter, "remarks"))
			this.dw_orderdetail.setitem(ll_counter, "discperc2", this.id_detail.getitemnumber(ll_counter, "discperc2"))
			this.dw_orderdetail.setitem(ll_counter, "purprice", this.id_detail.getitemnumber(ll_counter, "purprice"))
			this.dw_orderdetail.setitem(ll_counter, "saleprice", this.id_detail.getitemnumber(ll_counter, "saleprice"))
			this.dw_orderdetail.setitem(ll_counter, "rpp", this.id_detail.getitemnumber(ll_counter, "rpp"))
			this.dw_orderdetail.setitem(ll_counter, "packavgprice", this.id_detail.getitemnumber(ll_counter, "packavgprice"))
			this.dw_orderdetail.setitem(ll_counter, "itemflatdisc", this.id_detail.getitemnumber(ll_counter, "itemflatdisc"))
			this.dw_orderdetail.setitem(ll_counter, "packsalestax", this.id_detail.getitemnumber(ll_counter, "packsalestax"))
			this.dw_orderdetail.setitem(ll_counter, "gstperc", this.id_detail.getitemnumber(ll_counter, "gstperc"))
			if wf_update_itemalert(ll_icode, ll_itemalertcode) = false then
				SQL rollback USING this.it_transobject;
				messagebox("Item Alert Update Problem", "Problem while updating Item Alert in row " + string(ll_counter) + ". Reasons are:~r~n" + ls_errtext)
				this.id_detail.setfocus()
				this.id_detail.setcolumn("qty")
				this.id_detail.setrow(ll_counter)
				this.id_detail.scrolltorow(ll_counter)
				return
			end if
			if wf_update_minqty(ll_icode, ll_minqty, ls_errtext) <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("Item Minimum Qty Update Problem", "Problem while updating Minimum qty in row " + string(ll_counter) + ". Reasons are:~r~n" + ls_errtext)
				this.id_detail.setfocus()
				this.id_detail.setcolumn("qty")
				this.id_detail.setrow(ll_counter)
				this.id_detail.scrolltorow(ll_counter)
				return
			end if
			if wf_update_reorderqty(ll_icode, ll_reorderqty, ls_errtext) <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("Item Reorder Qty Update Problem", "Problem while updating Reorder qty in row " + string(ll_counter) + ". Reasons are:~r~n" + ls_errtext)
				this.id_detail.setfocus()
				this.id_detail.setcolumn("qty")
				this.id_detail.setrow(ll_counter)
				this.id_detail.scrolltorow(ll_counter)
				return
			end if
			if wf_update_optimumqty(ll_icode, ll_optimumqty, ls_errtext) <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("Item Optimum Qty Update Problem", "Problem while updating Optimum qty in row " + string(ll_counter) + ". Reasons are:~r~n" + ls_errtext)
				this.id_detail.setfocus()
				this.id_detail.setcolumn("qty")
				this.id_detail.setrow(ll_counter)
				this.id_detail.scrolltorow(ll_counter)
				return
			end if
		next
		this.id_detail = this.dw_orderdetail
		call super::ue_save
		if f_stringpreferences("IncPOInActMonitor") = "Y" then
			this.it_transobject.updateactivitymonitor("PO", ll_invid)
			if this.it_transobject.sqlcode <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
			else
				SQL commit USING this.it_transobject;
			end if
		end if
		this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
		this.id_detail.reset()
		return
	end if
	setfocus()

// w_purchaseorder.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_purchaseorder.ue_print() returns 0 [event]
	long ll_row
	long ll_invcode
	integer li_option
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		li_option = messagebox("Save Changes", "Do you want to save Purchase Order", information!, yesno!, 2)
		if li_option = 1 then
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	wf_selectprintreport()
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.id_print.rowcount() > 0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Purchase Order", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Purchase Order,~r~nNo rows are retrieved", information!)

