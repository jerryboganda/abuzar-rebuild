// window w_populate_services_from_datacarrydb (datatransfercomponents)  ancestor: window

// w_populate_services_from_datacarrydb.ue_postopen() returns 0
	string ls_connsetting
	ls_connsetting = "Set ANSI_NULLS ON Set ANSI_WARNINGS ON"
	this.it_transobject = create u_transaction
	SQL start USING this.it_transobject;
	SQL EXECUTE IMMEDIATE :ls_connsetting USING this.it_transobject;
	this.dw_control.settransobject(this.it_transobject)
	if this.dw_control.getchild("startserviceinvcode", this.idc_child) = -1 then
		messagebox("DataWindow Child", "Unable to get DataWindow Child for Start Service Inv. Code")
		return
	end if
	this.idc_child.settransobject(this.it_transobject)
	this.idc_child.retrieve(gs_inlinkserver, gs_inlinkserverdb, gs_inlinkserverowner)
	if this.dw_control.getchild("endserviceinvcode", this.idc_child2) = -1 then
		messagebox("DataWindow Child", "Unable to get DataWindow Child for End Service Inv. Code")
		return
	end if
	this.idc_child2.settransobject(this.it_transobject)
	this.idc_child2.retrieve(gs_inlinkserver, gs_inlinkserverdb, gs_inlinkserverowner)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)

// w_populate_services_from_datacarrydb.ue_close() returns 0
	closewithreturn(this, this.istr_arguments)

// w_populate_services_from_datacarrydb.create() returns 0
	this.cbx_basicdata = create cbx_basicdata
	this.dw_control = create dw_control
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.control = {this.cbx_basicdata, this.dw_control, this.cb_cancel, this.cb_ok}

// w_populate_services_from_datacarrydb.destroy() returns 0
	destroy this.cbx_basicdata
	destroy this.dw_control
	destroy this.cb_cancel
	destroy this.cb_ok

// w_populate_services_from_datacarrydb.open() returns long
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	post event ue_postopen()
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.istr_arguments.i_status = -1
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long
	long ll_scode
	long ll_lcode
	datetime ldt_datetime
	ll_scode = parent.dw_control.getitemnumber(parent.dw_control.getrow(), "startserviceinvcode")
	if not parent.cbx_basicdata.checked and isnull(ll_scode) then
		messagebox("Selection Validation", "Kindly select Valid Starting Service Invoice No. from the dropdown.")
		return -1
	end if
	ll_lcode = parent.dw_control.getitemnumber(parent.dw_control.getrow(), "endserviceinvcode")
	if not parent.cbx_basicdata.checked and isnull(ll_lcode) then
		messagebox("Selection Validation", "Kindly select Valid Ending Service Invoice No. from the dropdown.")
		return -1
	end if
	parent.istr_arguments.d_sdate = parent.idc_child.getitemdatetime(parent.idc_child.getrow(), "date")
	if parent.cbx_basicdata.checked then
		parent.istr_arguments.i_supress = true
	else
		parent.istr_arguments.i_supress = false
	end if
	parent.istr_arguments.l_code1 = ll_scode
	parent.istr_arguments.l_code2 = ll_lcode
	parent.istr_arguments.i_status = 1
	parent.post event ue_close()
	return ::message.returnvalue
