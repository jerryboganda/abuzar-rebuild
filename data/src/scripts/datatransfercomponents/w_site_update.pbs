// window w_site_update (datatransfercomponents)  ancestor: window

// w_site_update.ue_close(integer ai_status) returns 0
	SQL stop USING this.it_datatransobject;
	destroy this.it_datatransobject
	close(this)

// w_site_update.wf_disconnect() returns 0
	SQL stop USING this.it_datatransobject;
	destroy this.it_datatransobject

// w_site_update.wf_checkvisibility() returns long
	return 0

// w_site_update.wf_update() returns 0
	string ls_err_reason
	if this.dw_control.update(true, false) = 1 then
		SQL commit USING this.it_datatransobject;
		messagebox("Success", "Change Completed Successfully", information!)
	else
		ls_err_reason = this.it_datatransobject.sqlerrtext
		SQL rollback USING this.it_datatransobject;
		messagebox("Failure", "Changes Not Saved Sucessfully~r~nReasons are:- " + ls_err_reason, stopsign!)
	end if

// w_site_update.create() returns 0
	this.cb_update = create cb_update
	this.dw_control = create dw_control
	this.cb_cancel = create cb_cancel
	this.control = {this.cb_update, this.dw_control, this.cb_cancel}

// w_site_update.destroy() returns 0
	destroy this.cb_update
	destroy this.dw_control
	destroy this.cb_cancel

// w_site_update.open() returns long
	long ll_appversion
	long ll_sequenceid
	long ll_dbstatus
	long ll_parent_appversion
	long ll_parent_sequenceid
	long ll_parent_dbstatus
	long ll_retcode
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	this.it_datatransobject = create u_transaction
	SQL start USING this.it_datatransobject;
	this.dw_control.settransobject(this.it_datatransobject)
	this.dw_control.retrieve()
	return ::message.returnvalue

// cb_update.clicked() returns long
	parent.wf_update()
	parent.post event ue_close(0)
	return ::message.returnvalue

// dw_control.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_control.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	long ancestorreturnvalue
	long ll_insrow
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if keyflags = 2 then
		if key = keyi! then
			ll_insrow = insertrow(0)
			setrow(ll_insrow)
			setcolumn("SiteCode")
		end if
		if key = keyd! and getrow() > 0 then
			deleterow(getrow())
		end if
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.post event ue_close(0)
	return ::message.returnvalue
