// window w_pump_sale_datacarrydb (datatransfercomponents)  ancestor: window

// w_pump_sale_datacarrydb.ue_postopen() returns 0 [event]
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)

// w_pump_sale_datacarrydb.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arguments)

// w_pump_sale_datacarrydb.create() returns 0 [event]
	this.st_2 = create st_2
	this.st_1 = create st_1
	this.dw_control = create dw_control
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.control = {this.st_2, this.st_1, this.dw_control, this.cb_cancel, this.cb_ok}

// w_pump_sale_datacarrydb.destroy() returns 0 [event]
	destroy this.st_2
	destroy this.st_1
	destroy this.dw_control
	destroy this.cb_cancel
	destroy this.cb_ok

// w_pump_sale_datacarrydb.open() returns long [event]
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	post event ue_postopen()
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.istr_arguments.i_status = -1
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	string ls_connsetting
	long ll_sinvno
	long ll_linvno
	long li_custcode
	u_transaction lt_transobject
	ls_connsetting = "Set ANSI_NULLS ON Set ANSI_WARNINGS ON"
	lt_transobject = create u_transaction
	setnull(li_custcode)
	if parent.dw_control.accepttext() = -1 then
		return ::message.returnvalue
	end if
	setpointer(hourglass!)
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	SQL EXECUTE IMMEDIATE :ls_connsetting USING lt_transobject;
	ll_sinvno = parent.dw_control.getitemnumber(1, "sinvcode")
	ll_linvno = parent.dw_control.getitemnumber(1, "linvcode")
	if f_pumpdata_to_datacarrydb(lt_transobject, ll_sinvno, ll_linvno, li_custcode) < 0 then
		SQL stop USING lt_transobject;
		return ::message.returnvalue
	end if
	SQL stop USING lt_transobject;
	parent.post event ue_close()
	return ::message.returnvalue
