// window w_datasync (datatransfercomponents)  ancestor: window

// w_datasync.ue_close(integer ai_status) returns 0
	SQL stop USING this.it_datatransobject;
	destroy this.it_datatransobject
	close(this)

// w_datasync.wf_disconnect() returns 0
	SQL stop USING this.it_datatransobject;
	destroy this.it_datatransobject

// w_datasync.wf_connect() returns integer
	this.it_datatransobject = create u_transaction
	this.it_datatransobject.autocommit = true
	SQL start USING this.it_datatransobject;
	return this.it_datatransobject.sqlcode

// w_datasync.create() returns 0
	this.st_4_cancel = create st_4_cancel
	this.st_4_ok = create st_4_ok
	this.st_4 = create st_4
	this.hpb_basic = create hpb_basic
	this.cb_cancel = create cb_cancel
	this.cb_start = create cb_start
	this.gb_basic = create gb_basic
	this.st_2_cancel = create st_2_cancel
	this.st_1_ok = create st_1_ok
	this.st_2_ok = create st_2_ok
	this.st_1_cancel = create st_1_cancel
	this.st_1 = create st_1
	this.st_2 = create st_2
	this.st_3 = create st_3
	this.st_3_ok = create st_3_ok
	this.st_3_cancel = create st_3_cancel
	this.gb_options = create gb_options
	this.control = {this.st_4_cancel, this.st_4_ok, this.st_4, this.hpb_basic, this.cb_cancel, this.cb_start, this.gb_basic, this.st_2_cancel, this.st_1_ok, this.st_2_ok, this.st_1_cancel, this.st_1, this.st_2, this.st_3, this.st_3_ok, this.st_3_cancel, this.gb_options}

// w_datasync.destroy() returns 0
	destroy this.st_4_cancel
	destroy this.st_4_ok
	destroy this.st_4
	destroy this.hpb_basic
	destroy this.cb_cancel
	destroy this.cb_start
	destroy this.gb_basic
	destroy this.st_2_cancel
	destroy this.st_1_ok
	destroy this.st_2_ok
	destroy this.st_1_cancel
	destroy this.st_1
	destroy this.st_2
	destroy this.st_3
	destroy this.st_3_ok
	destroy this.st_3_cancel
	destroy this.gb_options

// w_datasync.open() returns long
	long ll_groupcode
	long ll_count
	long ll_usercode
	long ll_appversion
	long ll_sequenceid
	long ll_dbstatus
	long ll_parentappversion
	long ll_parentsequenceid
	long ll_parentdbstatus
	long ll_retcode
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	open(w_salesmanpassword)
	ll_usercode = long(message.doubleparm)
	if ll_usercode < 0 or isnull(ll_usercode) then
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	else
		ll_groupcode = f_getgroupcode(ll_usercode)
		if ll_groupcode <= 0 then
			close(this)
			if not isvalid(message) then
				return 0
			end if
			return message.returnvalue
		end if
	end if
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	ll_retcode = wf_connect()
	if ll_retcode <> 0 then
		messagebox("Connection Problem", "Problem Connecting Database, Details are:-~r~n" + this.it_datatransobject.sqlerrtext)
		post event ue_close(0)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_datasync.close() returns long
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.post event ue_close(0)
	return ::message.returnvalue

// cb_start.clicked() returns long
	boolean lb_ok
	string ls_errtext
	string ls_backupfile
	string ls_temp
	string ls_deletetrans
	long ll_retcode
	long ll_res
	long ll_sequenceid
	long ll_appversion
	long ll_dbstatus
	long ll_dm_sequenceid
	long ll_dm_appversion
	long ll_dm_dbstatus
	datastore lds_sequence
	ls_deletetrans = f_stringpreferences("DeleteSyncedTransactions")
	lds_sequence = create datastore
	lds_sequence.dataobject = "d_sequence"
	lds_sequence.settransobject(parent.it_datatransobject)
	lds_sequence.retrieve()
	ll_appversion = lds_sequence.getitemnumber(1, "AppVersion")
	ll_sequenceid = lds_sequence.getitemnumber(1, "SequenceId")
	ll_dbstatus = lds_sequence.getitemnumber(1, "DBStatus")
	setpointer(hourglass!)
	ll_res = messagebox("Risk Alert", "Data Synchronization is a risky process.~r~nIt Might cause data loss~r~nDo you still want to proceed with Process?", question!, yesno!, 2)
	if ll_res > 1 then
		return ::message.returnvalue
	end if
	SQL rollback USING parent.it_datatransobject;
	parent.gb_basic.visible = true
	parent.hpb_basic.visible = true
	if lb_ok then
		parent.gb_options.visible = true
		parent.st_1.visible = true
		parent.hpb_basic.stepit()
		parent.it_datatransobject.autocommit = false
		SQL start USING parent.it_datatransobject;
		parent.it_datatransobject.getversioninfo(gs_arc_linkserver, gs_arc_db, gs_arc_owner, ll_dm_sequenceid, ll_dm_appversion, ll_dm_dbstatus)
		if parent.it_datatransobject.sqlcode <> 0 then
			ls_errtext = "Error occured while enquiring for database version.~r~nDetails Are:-~r~n" + parent.it_datatransobject.sqlerrtext
			SQL rollback USING parent.it_datatransobject;
			messagebox("Data Sync. Version Error - Step # 1-1", ls_errtext)
			parent.st_1_cancel.visible = true
			lb_ok = false
		elseif not (ll_sequenceid = ll_dm_sequenceid and ll_appversion = ll_dm_appversion and ll_dbstatus = ll_dm_dbstatus) then
			ls_errtext = "Database Version does not match with current database.~r~n" + "Kindly match Application version(s) of the involved servers.~r~nDetails are:~r~n" + "Target Values are -> " + trim(string(ll_dm_appversion)) + "-" + trim(string(ll_dm_dbstatus)) + "-" + trim(string(ll_dm_sequenceid)) + "~r~nSource Values are -> " + trim(string(ll_appversion)) + "-" + trim(string(ll_dbstatus)) + "-" + trim(string(ll_sequenceid))
			SQL rollback USING parent.it_datatransobject;
			messagebox("Data Sync. Error - Step # 1-2", ls_errtext)
			lb_ok = false
		end if
		if lb_ok then
			parent.st_1.textcolor = rgb(0, 150, 0)
			parent.st_1_ok.visible = true
			parent.st_2.visible = true
			ll_retcode = parent.it_datatransobject.syncbasicdata_on_remote(gs_arc_linkserver, gs_arc_db, gs_arc_owner)
			parent.hpb_basic.stepit()
			if parent.it_datatransobject.sqlcode <> 0 then
				ls_errtext = "Error occured while Synchronization of basic data~r~nDetails Are:-~r~n" + parent.it_datatransobject.sqlerrtext
				SQL rollback USING parent.it_datatransobject;
				messagebox("Data Sync. Error - Step # 2", ls_errtext)
				lb_ok = false
				parent.st_2_cancel.visible = true
			end if
		end if
		if lb_ok then
			parent.st_2.textcolor = rgb(0, 150, 0)
			parent.st_2_ok.visible = true
			parent.st_3.visible = true
			ll_retcode = parent.it_datatransobject.synctransactiondata_onremote(gs_arc_linkserver, gs_arc_db, gs_arc_owner)
			parent.hpb_basic.stepit()
			if parent.it_datatransobject.sqlcode <> 0 then
				ls_errtext = "Error occured while Sync. of Transactions.~r~nDetails Are:-~r~n" + parent.it_datatransobject.sqlerrtext
				SQL rollback USING parent.it_datatransobject;
				messagebox("Data Sync. Error - Step # 3", ls_errtext)
				lb_ok = false
				parent.st_3_cancel.visible = true
			end if
		end if
		if lb_ok then
			parent.st_3.textcolor = rgb(0, 150, 0)
			parent.st_3_ok.visible = true
			parent.hpb_basic.stepit()
			if ls_deletetrans = "N" then
				SQL commit USING parent.it_datatransobject;
				messagebox("Data Sync.", "Data Synchronization completed.~r~nChanges Take Effect in database.", information!)
			else
				parent.st_4.visible = true
				ll_retcode = parent.it_datatransobject.deletesyncedtransactions()
				parent.hpb_basic.stepit()
				if parent.it_datatransobject.sqlcode <> 0 then
					ls_errtext = "Error occured while Deletion of Synced Transactions.~r~nDetails Are:-~r~n" + parent.it_datatransobject.sqlerrtext
					SQL rollback USING parent.it_datatransobject;
					messagebox("Data Synchronization Error - Step # 3", ls_errtext)
					lb_ok = false
					parent.st_4_cancel.visible = true
				else
					SQL commit USING parent.it_datatransobject;
					messagebox("Data Synchronization", "Data Synchronization completed.~r~nChanges Take Effect in database.", information!)
				end if
			end if
			parent.hpb_basic.stepit()
		end if
	end if
	setpointer(arrow!)
	parent.post event ue_close(1)
	return ::message.returnvalue
