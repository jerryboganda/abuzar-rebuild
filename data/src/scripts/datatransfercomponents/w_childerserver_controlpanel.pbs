// window w_childerserver_controlpanel (datatransfercomponents)  ancestor: window

// w_childerserver_controlpanel.ue_close(integer ai_status) returns 0 [event]
	SQL stop USING this.it_datatransobject;
	destroy this.it_datatransobject
	close(this)

// w_childerserver_controlpanel.wf_disconnect() returns 0
	SQL stop USING this.it_datatransobject;
	destroy this.it_datatransobject

// w_childerserver_controlpanel.wf_openreport() returns 0

// w_childerserver_controlpanel.wf_gettaskinfo(long al_parentstatus) returns long
	this.dw_control.settransobject(this.it_datatransobject)
	this.dw_control.retrieve(al_parentstatus)
	if this.dw_control.rowcount() > 0 then
		this.dw_control.object.parentserver[1] = gs_parentlinkserver
		this.dw_control.object.parentdatabase[1] = gs_parentdbname
	end if
	return 0

// w_childerserver_controlpanel.wf_perform_task(string as_object) returns long
	setpointer(hourglass!)
	wf_starttask(as_object)
	wf_gettaskinfo(this.il_parentstatus)
	setpointer(arrow!)
	return 0

// w_childerserver_controlpanel.wf_starttask(string as_object) returns 0
	string ls_connsetting
	long ll_counter
	long ll_saletype
	long ll_sale_or_return
	s_arguements lstr_arg
	ls_connsetting = "Set ANSI_NULLS ON Set ANSI_WARNINGS ON"
	SQL stop USING this.it_datatransobject;
	SQL start USING this.it_datatransobject;
	if this.it_datatransobject.sqlcode = 0 then
		SQL EXECUTE IMMEDIATE :ls_connsetting USING this.it_datatransobject;
		if this.it_datatransobject.sqlcode = 0 then
			this.st_progress.text = ""
			this.hpb_progress.position = 0
			this.gb_progress.visible = true
			this.hpb_progress.visible = true
			this.st_progress.visible = true
			if as_object = "b_import" then
				this.st_progress.text = "droping temporary tables . . ."
				for ll_counter = 1 to 100000
				next
				this.hpb_progress.stepit()
				this.hpb_progress.stepit()
				SQL rollback USING this.it_datatransobject;
				this.it_datatransobject.dropimporttables()
				if this.it_datatransobject.sqlcode = 0 then
					SQL commit USING this.it_datatransobject;
					this.hpb_progress.stepit()
					this.hpb_progress.stepit()
					this.st_progress.text = "creating temporary tables . . ."
					this.hpb_progress.stepit()
					this.hpb_progress.stepit()
					for ll_counter = 1 to 100000
					next
					this.st_progress.text = "importing basic data to temporary tables . . ."
					this.hpb_progress.stepit()
					this.hpb_progress.stepit()
					this.it_datatransobject.importdata(gs_parentlinkserver, gs_parentdbname, "dbo")
					if this.it_datatransobject.sqlcode = 0 then
						SQL commit USING this.it_datatransobject;
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						messagebox("Import Basic Data", "Basic Data Import Task Completed Successfully", information!)
					else
						messagebox("Import Basic Data", "Problem Importing Basic Data~r~nCan not import data to temporary tables~r~nReasons are:- " + this.it_datatransobject.sqlerrtext, stopsign!)
					end if
				else
					SQL rollback USING this.it_datatransobject;
					messagebox("Import Basic Data", "Problem Importing Basic Data~r~nCan not drop temporary tables~r~nReasons are:- " + this.it_datatransobject.sqlerrtext, stopsign!)
				end if
			elseif as_object = "b_sync" then
				this.hpb_progress.stepit()
				this.hpb_progress.stepit()
				this.st_progress.text = "synchronization of basic data in progress . . ."
				for ll_counter = 1 to 100000
				next
				this.hpb_progress.stepit()
				this.hpb_progress.stepit()
				this.hpb_progress.stepit()
				SQL rollback USING this.it_datatransobject;
				this.it_datatransobject.syncimporteddata()
				if this.it_datatransobject.sqlcode = 0 then
					SQL commit USING this.it_datatransobject;
					this.hpb_progress.stepit()
					this.hpb_progress.stepit()
					this.hpb_progress.stepit()
					this.hpb_progress.stepit()
					this.hpb_progress.stepit()
					messagebox("Synchronizing Basic Data", "Basic Data Synchronizing Task Completed Successfully", information!)
				else
					SQL rollback USING this.it_datatransobject;
					messagebox("Synchronizing Basic Data", "Problem Synchronizing Basic Data~r~nCan not Synchronize basic data~r~nReasons are:- " + this.it_datatransobject.sqlerrtext, stopsign!)
				end if
			elseif as_object = "b_saletrans" then
				open(w_select_sales_advsales)
				ll_saletype = message.doubleparm
				if ll_saletype = 1 then
					open(w_select_sales_salereturn)
					ll_sale_or_return = message.doubleparm
					if ll_sale_or_return = 1 then
						open(w_sales_transmit_cust_sdate_ldate)
					else
						open(w_sreturn_transmit_cust_sdate_ldate)
						ll_saletype = 3
					end if
				else
					open(w_advsales_transmit_cust_sdate_ldate)
				end if
				lstr_arg = message.powerobjectparm
				if lstr_arg.i_status = 1 then
					this.hpb_progress.stepit()
					this.hpb_progress.stepit()
					this.st_progress.text = "transmitting sales/return data in progress . . ."
					for ll_counter = 1 to 100000
					next
					this.hpb_progress.stepit()
					this.hpb_progress.stepit()
					this.hpb_progress.stepit()
					SQL rollback USING this.it_datatransobject;
					this.it_datatransobject.transmit_childserversales(lstr_arg.l_code1, lstr_arg.d_sdate, lstr_arg.d_edate, gs_servername, gs_parentlinkserver, gs_parentdbname, "dbo", ll_saletype)
					if this.it_datatransobject.sqlcode = 0 then
						SQL commit USING this.it_datatransobject;
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						messagebox("Transmitting Sales/Return Data", "Transmitting Sales/Return Data Task Completed Successfully", information!)
					else
						messagebox("Transmitting Sales/Return Data", "Problem Trasmitting Sales/Return Data~r~nCan not Trasmit sales/return data~r~nReasons are:- " + this.it_datatransobject.sqlerrtext, stopsign!)
						SQL rollback USING this.it_datatransobject;
					end if
				else
					messagebox("Trasnmitting Sales/Return Data", "No Sales/Return Data Selected To Trasmit~r~nPlease select some sales/return and try again", information!)
				end if
			end if
			this.hpb_progress.visible = false
			this.st_progress.visible = false
			this.gb_progress.visible = false
		else
			messagebox("Connection Problem", "Problem Occured While Connecting to database~r~nProblem while setting database connection options~r~nReasons are:- " + this.it_datatransobject.sqlerrtext, stopsign!)
		end if
	else
		messagebox("Connection Problem", "Problem Occured While Connecting to database~r~nPlease Try Again~r~nReasons are:- " + this.it_datatransobject.sqlerrtext, stopsign!)
	end if

// w_childerserver_controlpanel.wf_checkvisibility() returns long
	if not f_rightexists(1749) then
		this.dw_control.object.b_import.visible = false
	end if
	if not f_rightexists(1750) then
		this.dw_control.object.b_sync.visible = false
	end if
	if not f_rightexists(1751) then
		this.dw_control.object.b_saletrans.visible = false
	end if
	return 0

