	this.st_importstocksec = create st_importstocksec
	this.ddlb_importstocksec = create ddlb_importstocksec
	this.ddlb_importstocktime = create ddlb_importstocktime
	this.st_importstockmin = create st_importstockmin
	this.rb_importstockevery = create rb_importstockevery
