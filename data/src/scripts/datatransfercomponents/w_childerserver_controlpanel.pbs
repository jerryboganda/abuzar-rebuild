	this.gb_4 = create gb_4
	this.control = {this.cbx_activateautostockimport, this.rb_importstockonce, this.st_importstockhr, this.ddlb_importstockhr, this.ddlb_importstockmin, this.st_importstocksec, this.ddlb_importstocksec, this.ddlb_importstocktime, this.st_importstockmin, this.rb_importstockevery, this.dw_importstockschedule, this.dw_importdataschedule, this.rb_importdataevery, this.st_importdatamin, this.ddlb_importdatatime, this.ddlb_importdatasec, this.st_importdatasec, this.ddlb_importdatamin, this.ddlb_importdatahr, this.st_importdatahr, this.rb_importdataonce, this.cbx_activateautodataimport, this.dw_control, this.cb_saveandclose, this.gb_progress, this.hpb_progress, this.st_progress, this.gb_2, this.gb_1, this.gb_3, this.gb_4}

