// w_childerserver_controlpanel.open() returns long [event]
	long ll_appversion
	long ll_sequenceid
	long ll_dbstatus
	long ll_parent_appversion
	long ll_parent_sequenceid
	long ll_parent_dbstatus
	long ll_retcode
	long ll_importdatahr
	long ll_importstockhr
	string ls_jobstarttime
	string ls_hold
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	string ls_version_info = "0                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             0"
	datastore lds_sequence
	integer li_enabled
	sqlca.dbms_version(ls_version_info)
	if match(ls_version_info, "SQL Server 2012") = true then
		this.dw_importdataschedule.dataobject = "d_backupschedule_2012"
		this.dw_importstockschedule.dataobject = "d_backupschedule_2012"
	end if
	this.it_datatransobject = create u_transaction
	SQL start USING this.it_datatransobject;
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	lds_sequence = create datastore
	lds_sequence.dataobject = "d_sequence"
	lds_sequence.settransobject(this.it_datatransobject)
	lds_sequence.retrieve()
	ll_appversion = lds_sequence.getitemnumber(1, "AppVersion")
	ll_sequenceid = lds_sequence.getitemnumber(1, "SequenceId")
	ll_dbstatus = lds_sequence.getitemnumber(1, "DBStatus")
	f_getappversion(gs_parentlinkserver, gs_parentdbname, gs_parentowner, ll_parent_sequenceid, ll_parent_appversion, ll_parent_dbstatus)
	if ll_parent_sequenceid > 0 and ll_parent_appversion > 0 then
		this.il_parentstatus = 1
		if ll_parent_appversion <> ll_appversion or ll_parent_sequenceid <> ll_sequenceid or ll_parent_dbstatus <> ll_dbstatus then
			messagebox("Version Problem", "Both Source and Target Must have same Application Version")
			post event ue_close(0)
			return ::message.returnvalue
		end if
	else
		this.il_parentstatus = 0
	end if
	wf_gettaskinfo(this.il_parentstatus)
	wf_checkvisibility()
	this.it_jobtransobject = create u_transaction
	this.it_jobtransobject.dbms = "OLE DB"
	this.it_jobtransobject.autocommit = true
	this.it_jobtransobject.dbparm = "PROVIDER='SQLOLEDB',DATASOURCE='" + gs_servername + "',CommitOnDisconnect='No',PROVIDERSTRING='DataBase=MSDB" + ";APP=" + gs_app + ";WSID=" + gs_localcomputername + "',PBTrimCharColumns='Yes',StripParmNames='Yes'"
	SQL start USING this.it_jobtransobject;
	this.dw_importdataschedule.settransobject(this.it_jobtransobject)
	this.dw_importdataschedule.retrieve(gs_autoimportdatajob, gs_autoimportdatajobschedule)
	SQL Select enabled INTO :li_enabled From SysJobs Where Name =:gs_autoimportdatajob USING this.it_jobtransobject;
	if this.it_jobtransobject.sqlcode = 0 then
		if li_enabled = 1 then
			this.cbx_activateautodataimport.checked = true
			if this.dw_importdataschedule.getitemnumber(1, "unit") = 1.0 then
				this.rb_importdataonce.checked = true
				ls_jobstarttime = string(this.dw_importdataschedule.getitemnumber(1, "occurancetime"))
				ll_importdatahr = integer(left(ls_jobstarttime, len(ls_jobstarttime) - 4))
				ls_hold = left(right(ls_jobstarttime, 4), len(right(ls_jobstarttime, 4)) - 2)
				if isnull(ls_hold) or ls_hold = "" then
					ls_hold = "00"
				elseif len(ls_hold) = 1 then
					ls_hold = "0" + ls_hold
				end if
				this.ddlb_importdatamin.selectitem(ls_hold, 0)
				ls_hold = right(ls_jobstarttime, 2)
				if isnull(ls_hold) or ls_hold = "" then
					ls_hold = "00"
				elseif len(ls_hold) = 1 then
					ls_hold = "0" + ls_hold
				end if
				this.ddlb_importdatasec.selectitem(ls_hold, 0)
				if ll_importdatahr > 12 then
					this.ddlb_importdatahr.selectitem(string(ll_importdatahr - 12), 0)
					this.ddlb_importdatatime.selectitem("PM", 0)
				elseif ll_importdatahr = 12 then
					this.ddlb_importdatahr.selectitem("12", 0)
					this.ddlb_importdatatime.selectitem("PM", 0)
				else
					if isnull(ll_importdatahr) or ll_importdatahr = 0 then
						this.ddlb_importdatahr.selectitem("12", 0)
					else
						this.ddlb_importdatahr.selectitem(string(ll_importdatahr), 0)
					end if
					this.ddlb_importdatatime.selectitem("AM", 0)
				end if
				this.dw_importdataschedule.enabled = false
			else
				this.rb_importdataevery.checked = true
				this.ddlb_importdatahr.enabled = false
				this.ddlb_importdatamin.enabled = false
				this.ddlb_importdatasec.enabled = false
				this.ddlb_importdatatime.enabled = false
			end if
		else
			this.cbx_activateautodataimport.checked = false
			this.rb_importdataevery.enabled = false
			this.dw_importdataschedule.enabled = false
			this.rb_importdataonce.enabled = false
			this.ddlb_importdatahr.enabled = false
			this.ddlb_importdatamin.enabled = false
			this.ddlb_importdatasec.enabled = false
			this.ddlb_importdatatime.enabled = false
		end if
	else
		messagebox("Job", "Unable to fetch Auto Import Data From Parent Server job status.")
	end if
	this.dw_importstockschedule.settransobject(this.it_jobtransobject)
	this.dw_importstockschedule.retrieve(gs_autoimportstockjob, gs_autoimportstockjobschedule)
	SQL Select enabled INTO :li_enabled From SysJobs Where Name =:gs_autoimportstockjob USING this.it_jobtransobject;
	if this.it_jobtransobject.sqlcode = 0 then
		if li_enabled = 1 then
			this.cbx_activateautostockimport.checked = true
			if this.dw_importstockschedule.getitemnumber(1, "unit") = 1.0 then
				this.rb_importstockonce.checked = true
				ls_jobstarttime = string(this.dw_importstockschedule.getitemnumber(1, "occurancetime"))
				ll_importstockhr = integer(left(ls_jobstarttime, len(ls_jobstarttime) - 4))
				ls_hold = left(right(ls_jobstarttime, 4), len(right(ls_jobstarttime, 4)) - 2)
				if isnull(ls_hold) or ls_hold = "" then
					ls_hold = "00"
				elseif len(ls_hold) = 1 then
					ls_hold = "0" + ls_hold
				end if
				this.ddlb_importstockmin.selectitem(ls_hold, 0)
				ls_hold = right(ls_jobstarttime, 2)
				if isnull(ls_hold) or ls_hold = "" then
					ls_hold = "00"
				elseif len(ls_hold) = 1 then
					ls_hold = "0" + ls_hold
				end if
				this.ddlb_importstocksec.selectitem(ls_hold, 0)
				if ll_importstockhr > 12 then
					this.ddlb_importstockhr.selectitem(string(ll_importstockhr - 12), 0)
					this.ddlb_importstocktime.selectitem("PM", 0)
				elseif ll_importstockhr = 12 then
					this.ddlb_importstockhr.selectitem("12", 0)
					this.ddlb_importstocktime.selectitem("PM", 0)
				else
					if isnull(ll_importstockhr) or ll_importstockhr = 0 then
						this.ddlb_importstockhr.selectitem("12", 0)
					else
						this.ddlb_importstockhr.selectitem(string(ll_importstockhr), 0)
					end if
					this.ddlb_importstocktime.selectitem("AM", 0)
				end if
				this.dw_importstockschedule.enabled = false
			else
				this.rb_importstockevery.checked = true
				this.ddlb_importstockhr.enabled = false
				this.ddlb_importstockmin.enabled = false
				this.ddlb_importstocksec.enabled = false
				this.ddlb_importstocktime.enabled = false
			end if
		else
			this.cbx_activateautostockimport.checked = false
			this.rb_importstockevery.enabled = false
			this.dw_importstockschedule.enabled = false
			this.rb_importstockonce.enabled = false
			this.ddlb_importstockhr.enabled = false
			this.ddlb_importstockmin.enabled = false
			this.ddlb_importstocksec.enabled = false
			this.ddlb_importstocktime.enabled = false
		end if
	else
		messagebox("Job", "Unable to fetch Auto Import Stock From Parent Server job status.")
	end if
	return ::message.returnvalue

// cbx_activateautostockimport.clicked() returns long [event]
	if this.checked = true then
		parent.rb_importstockonce.enabled = true
		parent.rb_importstockevery.enabled = true
		parent.dw_importstockschedule.enabled = false
		parent.ddlb_importstockhr.enabled = true
		parent.ddlb_importstockmin.enabled = true
		parent.ddlb_importstocksec.enabled = true
		parent.ddlb_importstocktime.enabled = true
	else
		parent.rb_importstockevery.enabled = false
		parent.rb_importstockonce.enabled = false
		parent.dw_importstockschedule.enabled = false
		parent.ddlb_importstockhr.enabled = false
		parent.ddlb_importstockmin.enabled = false
		parent.ddlb_importstocksec.enabled = false
		parent.ddlb_importstocktime.enabled = false
	end if
	return ::message.returnvalue

// rb_importstockonce.clicked() returns long [event]
	if this.checked = true then
		parent.dw_importstockschedule.enabled = false
		parent.ddlb_importstockhr.enabled = true
		parent.ddlb_importstockmin.enabled = true
		parent.ddlb_importstocksec.enabled = true
		parent.ddlb_importstocktime.enabled = true
	end if
	return ::message.returnvalue

// rb_importstockevery.clicked() returns long [event]
	if this.checked = true then
		parent.dw_importstockschedule.enabled = true
		parent.ddlb_importstockhr.enabled = false
		parent.ddlb_importstockmin.enabled = false
		parent.ddlb_importstocksec.enabled = false
		parent.ddlb_importstocktime.enabled = false
	end if
	return ::message.returnvalue

// rb_importdataevery.clicked() returns long [event]
	if this.checked = true then
		parent.dw_importdataschedule.enabled = true
		parent.ddlb_importdatahr.enabled = false
		parent.ddlb_importdatamin.enabled = false
		parent.ddlb_importdatasec.enabled = false
		parent.ddlb_importdatatime.enabled = false
	end if
	return ::message.returnvalue

// rb_importdataonce.clicked() returns long [event]
	if this.checked = true then
		parent.dw_importdataschedule.enabled = false
		parent.ddlb_importdatahr.enabled = true
		parent.ddlb_importdatamin.enabled = true
		parent.ddlb_importdatasec.enabled = true
		parent.ddlb_importdatatime.enabled = true
	end if
	return ::message.returnvalue

// cbx_activateautodataimport.clicked() returns long [event]
	if this.checked = true then
		parent.rb_importdataonce.enabled = true
		parent.rb_importdataevery.enabled = true
		parent.dw_importdataschedule.enabled = false
		parent.ddlb_importdatahr.enabled = true
		parent.ddlb_importdatamin.enabled = true
		parent.ddlb_importdatasec.enabled = true
		parent.ddlb_importdatatime.enabled = true
	else
		parent.rb_importdataevery.enabled = false
		parent.rb_importdataonce.enabled = false
		parent.dw_importdataschedule.enabled = false
		parent.ddlb_importdatahr.enabled = false
		parent.ddlb_importdatamin.enabled = false
		parent.ddlb_importdatasec.enabled = false
		parent.ddlb_importdatatime.enabled = false
	end if
	return ::message.returnvalue

// dw_control.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	choose case dwo.name
	case "b_import", "b_sync", "b_saletrans"
		parent.wf_perform_task(dwo.name)
	end choose
	return ::message.returnvalue

// cb_saveandclose.clicked() returns long [event]
	double ld_expirydays
	integer li_cashsalepostingtime
	integer li_creditsalepostingtime
	integer li_counter = 1
	long ll_retcode = 1
	boolean lb_commitok = true
	string ls_errtext
	string ls_errtitle
	string ls_errmodule
	string ls_string
	string ls_jobname
	string ls_schedulename
	string ls_hr
	string ls_min
	string ls_sec
	string ls_activetime
	string ls_ampm
	integer li_unitvalue
	integer li_unit
	integer li_hr
	long ll_activetime
	if lb_commitok then
		ls_jobname = gs_autoimportdatajob
		ls_schedulename = gs_autoimportdatajobschedule
		if parent.cbx_activateautodataimport.checked = true then
			if parent.rb_importdataonce.checked = true then
				ls_hr = parent.ddlb_importdatahr.text
				ls_min = parent.ddlb_importdatamin.text
				ls_sec = parent.ddlb_importdatasec.text
				ls_ampm = parent.ddlb_importdatatime.text
				if isnull(ls_hr) or ls_hr = "" or ls_hr = "none" then
					messagebox("Auto Import Data Job Time Validation", "Please select hours from dropdown box.")
					parent.ddlb_importdatahr.setfocus()
					return ::message.returnvalue
				elseif isnull(ls_min) or ls_min = "" or ls_min = "none" then
					messagebox("Auto Import Data Time Validation", "Please select minutes from dropdown box.")
					parent.ddlb_importdatamin.setfocus()
					return ::message.returnvalue
				elseif isnull(ls_sec) or ls_sec = "" or ls_sec = "none" then
					messagebox("Auto Import Data Time Validation", "Please select seconds from dropdown box.")
					parent.ddlb_importdatasec.setfocus()
					return ::message.returnvalue
				elseif isnull(ls_ampm) or ls_ampm = "" or ls_ampm = "none" then
					messagebox("Auto Import Data Time Validation", "Please select AM/PM from dropdown box.")
					parent.ddlb_importdatatime.setfocus()
					return ::message.returnvalue
				end if
				li_hr = integer(ls_hr)
				if ls_ampm = "PM" then
					if li_hr < 12 then
						li_hr = li_hr + 12
					end if
				elseif li_hr = 12 then
					li_hr = 0
				end if
				ls_activetime = string(li_hr) + ls_min + ls_sec
				ll_activetime = long(ls_activetime)
				li_unit = 1
				li_unitvalue = 0
			else
				if parent.dw_importdataschedule.accepttext() = 1 then
					li_unitvalue = parent.dw_importdataschedule.getitemnumber(1, "unitvalue")
					li_unit = parent.dw_importdataschedule.getitemnumber(1, "unit")
					if li_unit = 4 then
						if not (li_unitvalue >= 1 and li_unitvalue <= 1440) then
							messagebox("BackUp Time Validation", "Please enter valid value for minutes between 1 and 1440.")
							parent.dw_importdataschedule.setcolumn(1)
							parent.dw_importdataschedule.setfocus()
							return ::message.returnvalue
						end if
					elseif li_unit = 8 then
						if not (li_unitvalue >= 1 and li_unitvalue <= 24) then
							messagebox("BackUp Time Validation", "Please enter valid value for hours between 1 and 24.")
							parent.dw_importdataschedule.setcolumn(2)
							parent.dw_importdataschedule.setfocus()
							return ::message.returnvalue
						end if
					else
						messagebox("BackUp Time Validation", "Please select minutes/hours from dropdown list box")
						parent.dw_importdataschedule.setcolumn(2)
						parent.dw_importdataschedule.setfocus()
						return ::message.returnvalue
					end if
				else
					messagebox("BackUp Time Validation", "Please enter valid value for a unit.")
					parent.dw_importdataschedule.setcolumn(1)
					parent.dw_importdataschedule.setfocus()
					return ::message.returnvalue
				end if
				ll_activetime = 0
			end if
			sqlca.adjustjobschedule(ls_jobname, ls_schedulename, ll_activetime, li_unit, li_unitvalue)
			sqlca.activatejob(ls_jobname, 1)
		else
			sqlca.activatejob(ls_jobname, 0)
		end if
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
			messagebox("Job Error", "Unable to update Auto Import Data job status.")
			setpointer(arrow!)
		end if
		ls_jobname = gs_autoimportstockjob
		ls_schedulename = gs_autoimportstockjobschedule
		if parent.cbx_activateautostockimport.checked = true then
			if parent.rb_importstockonce.checked = true then
				ls_hr = parent.ddlb_importstockhr.text
				ls_min = parent.ddlb_importstockmin.text
				ls_sec = parent.ddlb_importstocksec.text
				ls_ampm = parent.ddlb_importstocktime.text
				if isnull(ls_hr) or ls_hr = "" or ls_hr = "none" then
					messagebox("Auto Import Stock Job Time Validation", "Please select hours from dropdown box.")
					parent.ddlb_importstockhr.setfocus()
					return ::message.returnvalue
				elseif isnull(ls_min) or ls_min = "" or ls_min = "none" then
					messagebox("Auto Import Stock Time Validation", "Please select minutes from dropdown box.")
					parent.ddlb_importstockmin.setfocus()
					return ::message.returnvalue
				elseif isnull(ls_sec) or ls_sec = "" or ls_sec = "none" then
					messagebox("Auto Import Stock Time Validation", "Please select seconds from dropdown box.")
					parent.ddlb_importstocksec.setfocus()
					return ::message.returnvalue
				elseif isnull(ls_ampm) or ls_ampm = "" or ls_ampm = "none" then
					messagebox("Auto Import Stock Time Validation", "Please select AM/PM from dropdown box.")
					parent.ddlb_importstocktime.setfocus()
					return ::message.returnvalue
				end if
				li_hr = integer(ls_hr)
				if ls_ampm = "PM" then
					if li_hr < 12 then
						li_hr = li_hr + 12
					end if
				elseif li_hr = 12 then
					li_hr = 0
				end if
				ls_activetime = string(li_hr) + ls_min + ls_sec
				ll_activetime = long(ls_activetime)
				li_unit = 1
				li_unitvalue = 0
			else
				if parent.dw_importstockschedule.accepttext() = 1 then
					li_unitvalue = parent.dw_importstockschedule.getitemnumber(1, "unitvalue")
					li_unit = parent.dw_importstockschedule.getitemnumber(1, "unit")
					if li_unit = 4 then
						if not (li_unitvalue >= 1 and li_unitvalue <= 1440) then
							messagebox("BackUp Time Validation", "Please enter valid value for minutes between 1 and 1440.")
							parent.dw_importstockschedule.setcolumn(1)
							parent.dw_importstockschedule.setfocus()
							return ::message.returnvalue
						end if
					elseif li_unit = 8 then
						if not (li_unitvalue >= 1 and li_unitvalue <= 24) then
							messagebox("BackUp Time Validation", "Please enter valid value for hours between 1 and 24.")
							parent.dw_importstockschedule.setcolumn(2)
							parent.dw_importstockschedule.setfocus()
							return ::message.returnvalue
						end if
					else
						messagebox("BackUp Time Validation", "Please select minutes/hours from dropdown list box")
						parent.dw_importstockschedule.setcolumn(2)
						parent.dw_importstockschedule.setfocus()
						return ::message.returnvalue
					end if
				else
					messagebox("BackUp Time Validation", "Please enter valid value for a unit.")
					parent.dw_importstockschedule.setcolumn(1)
					parent.dw_importstockschedule.setfocus()
					return ::message.returnvalue
				end if
				ll_activetime = 0
			end if
			sqlca.adjustjobschedule(ls_jobname, ls_schedulename, ll_activetime, li_unit, li_unitvalue)
			sqlca.activatejob(ls_jobname, 1)
		else
			sqlca.activatejob(ls_jobname, 0)
		end if
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
			messagebox("Job Error", "Unable to update Auto Import Stock job status.")
			setpointer(arrow!)
		end if
	else
		SQL rollback USING sqlca;
	end if
	setpointer(arrow!)
	parent.post event ue_close(1)
	return ::message.returnvalue
