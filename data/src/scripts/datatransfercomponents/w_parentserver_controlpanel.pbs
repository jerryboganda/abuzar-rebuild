// window w_parentserver_controlpanel (datatransfercomponents)  ancestor: window

// w_parentserver_controlpanel.ue_close(integer ai_status) returns 0
	SQL stop USING this.it_datatransobject;
	destroy this.it_datatransobject
	close(this)

// w_parentserver_controlpanel.wf_disconnect() returns 0
	SQL stop USING this.it_datatransobject;
	destroy this.it_datatransobject

// w_parentserver_controlpanel.wf_openreport() returns 0

// w_parentserver_controlpanel.wf_perform_task(string as_object) returns long
	setpointer(hourglass!)
	wf_starttask(as_object)
	wf_gettaskinfo()
	setpointer(arrow!)
	return 0

// w_parentserver_controlpanel.wf_starttask(string as_object) returns 0
	string ls_connsetting
	string ls_err_reason
	string ls_server
	string ls_db
	string ls_owner
	long ll_counter
	long ll_type
	long ll_sale_or_return
	s_arguements lstr_arg
	ls_connsetting = "Set ANSI_NULLS ON Set ANSI_WARNINGS ON"
	SQL stop USING this.it_datatransobject;
	SQL start USING this.it_datatransobject;
	if this.it_datatransobject.sqlcode = 0 then
		SQL EXECUTE IMMEDIATE :ls_connsetting USING this.it_datatransobject;
		if this.it_datatransobject.sqlcode = 0 then
			this.st_progress.text = ""
			this.hpb_progress.position = 0
			this.gb_progress.visible = true
			this.hpb_progress.visible = true
			this.st_progress.visible = true
			if as_object = "b_fetch" then
				open(w_fetch_linkservers)
				lstr_arg = message.powerobjectparm
				if lstr_arg.i_status = 1 then
					ls_server = lstr_arg.s_name1
					ls_db = lstr_arg.s_name2
					if lower(lstr_arg.s_name3) = lower(gs_servername) then
						ls_server = ""
					end if
					ls_owner = "dbo"
					this.hpb_progress.stepit()
					this.hpb_progress.stepit()
					this.st_progress.text = "fetching child/stand by server sales/return . . ."
					for ll_counter = 1 to 100000
					next
					this.hpb_progress.stepit()
					this.hpb_progress.stepit()
					this.hpb_progress.stepit()
					SQL rollback USING this.it_datatransobject;
					this.it_datatransobject.fetch_childserversales(ls_server, ls_db, ls_owner, gl_usercode)
					if this.it_datatransobject.sqlcode = 0 then
						SQL commit USING this.it_datatransobject;
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						messagebox("Child/Stand By Server Sales Translation", "Child/Stand By Server Sales Translation Task Completed Successfully", information!)
					else
						ls_err_reason = this.it_datatransobject.sqlerrtext
						SQL rollback USING this.it_datatransobject;
						messagebox("Child/Stand By Server Sales Translation", "Child/Stand By Server Sales Translation Task Terminated Un-Sucessfully~r~nReasons are:- " + ls_err_reason, stopsign!)
					end if
				else
					messagebox("Child/Stand By Server Sales Translation", "No Sales Data Selected To Translate~r~nPlease select some sales and try again", information!)
				end if
			elseif as_object = "b_saletrans" then
				open(w_select_sales_advsales)
				ll_type = message.doubleparm
				if ll_type = 1 then
					open(w_select_sales_salereturn)
					ll_sale_or_return = message.doubleparm
					if ll_sale_or_return = 1 then
						open(w_incorporate_childserver_salesinv)
					else
						open(w_incorporate_childserver_sr)
						ll_type = 3
					end if
				else
					open(w_incorporate_childserver_sales)
				end if
				lstr_arg = message.powerobjectparm
				if lstr_arg.i_status = 1 then
					this.hpb_progress.stepit()
					this.hpb_progress.stepit()
					this.st_progress.text = "child/stand by server sales/return translation in progress . . ."
					for ll_counter = 1 to 100000
					next
					this.hpb_progress.stepit()
					this.hpb_progress.stepit()
					this.hpb_progress.stepit()
					SQL rollback USING this.it_datatransobject;
					this.it_datatransobject.childserver_sale_translation(lstr_arg.s_name1, ll_type, lstr_arg.l_code1, lstr_arg.d_sdate, lstr_arg.d_edate, gl_usercode)
					if this.it_datatransobject.sqlcode = 0 then
						SQL commit USING this.it_datatransobject;
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						this.hpb_progress.stepit()
						messagebox("Child/Stand By Server Sales Translation", "Child/Stand By Server Sales Translation Task Completed Successfully", information!)
					else
						ls_err_reason = this.it_datatransobject.sqlerrtext
						SQL rollback USING this.it_datatransobject;
						messagebox("Child/Stand By Server Sales Translation", "Child/Stand By Server Sales Translation Task Terminated Un-Sucessfully~r~nReasons are:- " + ls_err_reason, stopsign!)
					end if
				else
					messagebox("Child/Stand By Server Sales Translation", "No Sales Data Selected To Translate~r~nPlease select some sales and try again", information!)
				end if
			end if
			this.hpb_progress.visible = false
			this.st_progress.visible = false
			this.gb_progress.visible = false
		else
			messagebox("Connection Problem", "Problem Occured While Connecting to database~r~nProblem while setting database connection options~r~nReasons are:- " + this.it_datatransobject.sqlerrtext, stopsign!)
		end if
	else
		messagebox("Connection Problem", "Problem Occured While Connecting to database~r~nPlease Try Again~r~nReasons are:- " + this.it_datatransobject.sqlerrtext, stopsign!)
	end if

// w_parentserver_controlpanel.wf_gettaskinfo() returns long
	this.dw_control.settransobject(this.it_datatransobject)
	this.dw_control.retrieve()
	return 0

// w_parentserver_controlpanel.wf_checkvisibility() returns long
	if not f_rightexists(1753) then
		this.dw_control.object.b_fetch.visible = false
	end if
	if not f_rightexists(1752) then
		this.dw_control.object.b_saletrans.visible = false
	end if
	return 0

// w_parentserver_controlpanel.create() returns 0
	this.cbx_activateautodatafetch = create cbx_activateautodatafetch
	this.rb_importdataonce = create rb_importdataonce
	this.st_importdatahr = create st_importdatahr
	this.ddlb_importdatahr = create ddlb_importdatahr
	this.ddlb_importdatamin = create ddlb_importdatamin
	this.st_importdatasec = create st_importdatasec
	this.ddlb_importdatasec = create ddlb_importdatasec
	this.ddlb_importdatatime = create ddlb_importdatatime
	this.st_importdatamin = create st_importdatamin
	this.rb_importdataevery = create rb_importdataevery
	this.dw_importdataschedule = create dw_importdataschedule
	this.dw_control = create dw_control
	this.cb_save = create cb_save
	this.gb_progress = create gb_progress
	this.hpb_progress = create hpb_progress
	this.st_progress = create st_progress
	this.gb_2 = create gb_2
	this.gb_1 = create gb_1
	this.control = {this.cbx_activateautodatafetch, this.rb_importdataonce, this.st_importdatahr, this.ddlb_importdatahr, this.ddlb_importdatamin, this.st_importdatasec, this.ddlb_importdatasec, this.ddlb_importdatatime, this.st_importdatamin, this.rb_importdataevery, this.dw_importdataschedule, this.dw_control, this.cb_save, this.gb_progress, this.hpb_progress, this.st_progress, this.gb_2, this.gb_1}

// w_parentserver_controlpanel.destroy() returns 0
	destroy this.cbx_activateautodatafetch
	destroy this.rb_importdataonce
	destroy this.st_importdatahr
	destroy this.ddlb_importdatahr
	destroy this.ddlb_importdatamin
	destroy this.st_importdatasec
	destroy this.ddlb_importdatasec
	destroy this.ddlb_importdatatime
	destroy this.st_importdatamin
	destroy this.rb_importdataevery
	destroy this.dw_importdataschedule
	destroy this.dw_control
	destroy this.cb_save
	destroy this.gb_progress
	destroy this.hpb_progress
	destroy this.st_progress
	destroy this.gb_2
	destroy this.gb_1

// w_parentserver_controlpanel.open() returns long
	long ll_appversion
	long ll_sequenceid
	long ll_dbstatus
	long ll_parent_appversion
	long ll_parent_sequenceid
	long ll_parent_dbstatus
	long ll_importdatahr
	long ll_retcode
	integer li_enabled
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	string ls_version_info
	string ls_jobstarttime
	string ls_hold
	string ls_jobame
	string ls_joschedule
	this.it_datatransobject = create u_transaction
	SQL start USING this.it_datatransobject;
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	sqlca.dbms_version(ls_version_info)
	if match(ls_version_info, "SQL Server 2012") = true then
		this.dw_importdataschedule.dataobject = "d_backupschedule_2012"
	end if
	this.it_jobtransobject = create u_transaction
	this.it_jobtransobject.dbms = "OLE DB"
	this.it_jobtransobject.autocommit = true
	this.it_jobtransobject.dbparm = "PROVIDER='SQLOLEDB',DATASOURCE='" + gs_servername + "',CommitOnDisconnect='No',PROVIDERSTRING='DataBase=MSDB" + ";APP=" + gs_app + ";WSID=" + gs_localcomputername + "',PBTrimCharColumns='Yes',StripParmNames='Yes'"
	SQL start USING this.it_jobtransobject;
	this.is_jobname = gs_autodatafetchfromchildserver
	this.is_jobschedule = gs_autodatafetchfromchildserver_schedule
	this.dw_importdataschedule.settransobject(this.it_jobtransobject)
	this.dw_importdataschedule.retrieve(this.is_jobname, this.is_jobschedule)
	SQL Select enabled INTO :li_enabled From SysJobs Where Name =:this.is_jobname USING this.it_jobtransobject;
	if this.it_jobtransobject.sqlcode = 0 then
		if li_enabled = 1 then
			this.cbx_activateautodatafetch.checked = true
			if this.dw_importdataschedule.getitemnumber(1, "unit") = 1.0 then
				this.rb_importdataonce.checked = true
				ls_jobstarttime = string(this.dw_importdataschedule.getitemnumber(1, "occurancetime"))
				ll_importdatahr = integer(left(ls_jobstarttime, len(ls_jobstarttime) - 4))
				ls_hold = left(right(ls_jobstarttime, 4), len(right(ls_jobstarttime, 4)) - 2)
				if isnull(ls_hold) or ls_hold = "" then
					ls_hold = "00"
				elseif len(ls_hold) = 1 then
					ls_hold = "0" + ls_hold
				end if
				this.ddlb_importdatamin.selectitem(ls_hold, 0)
				ls_hold = right(ls_jobstarttime, 2)
				if isnull(ls_hold) or ls_hold = "" then
					ls_hold = "00"
				elseif len(ls_hold) = 1 then
					ls_hold = "0" + ls_hold
				end if
				this.ddlb_importdatasec.selectitem(ls_hold, 0)
				if ll_importdatahr > 12 then
					this.ddlb_importdatahr.selectitem(string(ll_importdatahr - 12), 0)
					this.ddlb_importdatatime.selectitem("PM", 0)
				elseif ll_importdatahr = 12 then
					this.ddlb_importdatahr.selectitem("12", 0)
					this.ddlb_importdatatime.selectitem("PM", 0)
				else
					if isnull(ll_importdatahr) or ll_importdatahr = 0 then
						this.ddlb_importdatahr.selectitem("12", 0)
					else
						this.ddlb_importdatahr.selectitem(string(ll_importdatahr), 0)
					end if
					this.ddlb_importdatatime.selectitem("AM", 0)
				end if
				this.dw_importdataschedule.enabled = false
			else
				this.rb_importdataevery.checked = true
				this.ddlb_importdatahr.enabled = false
				this.ddlb_importdatamin.enabled = false
				this.ddlb_importdatasec.enabled = false
				this.ddlb_importdatatime.enabled = false
			end if
		else
			this.cbx_activateautodatafetch.checked = false
			this.rb_importdataevery.enabled = false
			this.dw_importdataschedule.enabled = false
			this.rb_importdataonce.enabled = false
			this.ddlb_importdatahr.enabled = false
			this.ddlb_importdatamin.enabled = false
			this.ddlb_importdatasec.enabled = false
			this.ddlb_importdatatime.enabled = false
		end if
	else
		messagebox("Job", "Unable to fetch Auto Fetch Data From Child Server job status.")
	end if
	wf_gettaskinfo()
	wf_checkvisibility()
	return ::message.returnvalue

// cbx_activateautodatafetch.clicked() returns long
	if this.checked = true then
		parent.rb_importdataonce.enabled = true
		parent.rb_importdataevery.enabled = true
		parent.dw_importdataschedule.enabled = false
		parent.ddlb_importdatahr.enabled = true
		parent.ddlb_importdatamin.enabled = true
		parent.ddlb_importdatasec.enabled = true
		parent.ddlb_importdatatime.enabled = true
	else
		parent.rb_importdataevery.enabled = false
		parent.rb_importdataonce.enabled = false
		parent.dw_importdataschedule.enabled = false
		parent.ddlb_importdatahr.enabled = false
		parent.ddlb_importdatamin.enabled = false
		parent.ddlb_importdatasec.enabled = false
		parent.ddlb_importdatatime.enabled = false
	end if
	return ::message.returnvalue

// rb_importdataonce.clicked() returns long
	if this.checked = true then
		parent.dw_importdataschedule.enabled = false
		parent.ddlb_importdatahr.enabled = true
		parent.ddlb_importdatamin.enabled = true
		parent.ddlb_importdatasec.enabled = true
		parent.ddlb_importdatatime.enabled = true
	end if
	return ::message.returnvalue

// rb_importdataevery.clicked() returns long
	if this.checked = true then
		parent.dw_importdataschedule.enabled = true
		parent.ddlb_importdatahr.enabled = false
		parent.ddlb_importdatamin.enabled = false
		parent.ddlb_importdatasec.enabled = false
		parent.ddlb_importdatatime.enabled = false
	end if
	return ::message.returnvalue

// dw_control.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	choose case dwo.name
	case "b_fetch", "b_sync", "b_saletrans"
		parent.wf_perform_task(dwo.name)
	end choose
	return ::message.returnvalue

// cb_save.clicked() returns long
	double ld_expirydays
	integer li_cashsalepostingtime
	integer li_creditsalepostingtime
	integer li_counter
	long ll_retcode
	boolean lb_commitok
	string ls_errtext
	string ls_errtitle
	string ls_errmodule
	string ls_string
	string ls_hr
	string ls_min
	string ls_sec
	string ls_activetime
	string ls_ampm
	integer li_unitvalue
	integer li_unit
	integer li_hr
	long ll_activetime
	if lb_commitok then
		if parent.cbx_activateautodatafetch.checked = true then
			if parent.rb_importdataonce.checked = true then
				ls_hr = parent.ddlb_importdatahr.text
				ls_min = parent.ddlb_importdatamin.text
				ls_sec = parent.ddlb_importdatasec.text
				ls_ampm = parent.ddlb_importdatatime.text
				if isnull(ls_hr) or ls_hr = "" or ls_hr = "none" then
					messagebox("Auto Fetch Child Server Data Job Time Validation", "Please select hours from dropdown box.")
					parent.ddlb_importdatahr.setfocus()
					return ::message.returnvalue
				elseif isnull(ls_min) or ls_min = "" or ls_min = "none" then
					messagebox("Auto Fetch Child Server Data Time Validation", "Please select minutes from dropdown box.")
					parent.ddlb_importdatamin.setfocus()
					return ::message.returnvalue
				elseif isnull(ls_sec) or ls_sec = "" or ls_sec = "none" then
					messagebox("Auto Fetch Child Server Data Time Validation", "Please select seconds from dropdown box.")
					parent.ddlb_importdatasec.setfocus()
					return ::message.returnvalue
				elseif isnull(ls_ampm) or ls_ampm = "" or ls_ampm = "none" then
					messagebox("Auto Fetch Child Server Data Time Validation", "Please select AM/PM from dropdown box.")
					parent.ddlb_importdatatime.setfocus()
					return ::message.returnvalue
				end if
				li_hr = integer(ls_hr)
				if ls_ampm = "PM" then
					if li_hr < 12 then
						li_hr = li_hr + 12
					end if
				elseif li_hr = 12 then
					li_hr = 0
				end if
				ls_activetime = string(li_hr) + ls_min + ls_sec
				ll_activetime = long(ls_activetime)
				li_unit = 1
				li_unitvalue = 0
			else
				if parent.dw_importdataschedule.accepttext() = 1 then
					li_unitvalue = parent.dw_importdataschedule.getitemnumber(1, "unitvalue")
					li_unit = parent.dw_importdataschedule.getitemnumber(1, "unit")
					if li_unit = 4 then
						if not (li_unitvalue >= 1 and li_unitvalue <= 1440) then
							messagebox("BackUp Time Validation", "Please enter valid value for minutes between 1 and 1440.")
							parent.dw_importdataschedule.setcolumn(1)
							parent.dw_importdataschedule.setfocus()
							return ::message.returnvalue
						end if
					elseif li_unit = 8 then
						if not (li_unitvalue >= 1 and li_unitvalue <= 24) then
							messagebox("BackUp Time Validation", "Please enter valid value for hours between 1 and 24.")
							parent.dw_importdataschedule.setcolumn(2)
							parent.dw_importdataschedule.setfocus()
							return ::message.returnvalue
						end if
					else
						messagebox("BackUp Time Validation", "Please select minutes/hours from dropdown list box")
						parent.dw_importdataschedule.setcolumn(2)
						parent.dw_importdataschedule.setfocus()
						return ::message.returnvalue
					end if
				else
					messagebox("BackUp Time Validation", "Please enter valid value for a unit.")
					parent.dw_importdataschedule.setcolumn(1)
					parent.dw_importdataschedule.setfocus()
					return ::message.returnvalue
				end if
				ll_activetime = 0
			end if
			sqlca.adjustjobschedule(parent.is_jobname, parent.is_jobschedule, ll_activetime, li_unit, li_unitvalue)
			sqlca.activatejob(parent.is_jobname, 1)
		else
			sqlca.activatejob(parent.is_jobname, 0)
		end if
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
			messagebox("Job Error", "Unable to update Auto Import Data job status.")
			setpointer(arrow!)
		end if
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
			messagebox("Job Error", "Unable to update Auto Fetch Child Server Data job status.")
			setpointer(arrow!)
		end if
	else
		SQL rollback USING sqlca;
	end if
	setpointer(arrow!)
	parent.post event ue_close(1)
	return ::message.returnvalue
