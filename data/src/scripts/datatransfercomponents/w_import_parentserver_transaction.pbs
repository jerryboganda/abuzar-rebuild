// window w_import_parentserver_transaction (datatransfercomponents)  ancestor: window

// w_import_parentserver_transaction.ue_postopen() returns 0
	long ll_found
	this.dw_control.settransobject(sqlca)
	this.dw_control.retrieve()
	this.dw_control.scrolltorow(0)
	wf_checkrigths()
	wf_setvisibility()

// w_import_parentserver_transaction.ue_close() returns 0
	closewithreturn(this, this.istr_arguments)

// w_import_parentserver_transaction.wf_setvisibility() returns long
	return 0

// w_import_parentserver_transaction.wf_checkrigths() returns long
	long ll_found
	return 0

// w_import_parentserver_transaction.create() returns 0
	this.dw_control = create dw_control
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.control = {this.dw_control, this.cb_cancel, this.cb_ok}

// w_import_parentserver_transaction.destroy() returns 0
	destroy this.dw_control
	destroy this.cb_cancel
	destroy this.cb_ok

// w_import_parentserver_transaction.open() returns long
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	post event ue_postopen()
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.istr_arguments.i_status = -1
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long
	long ll_retcode
	string ls_errtext
	char lc_quot
	char lc_so
	char lc_po
	if parent.dw_control.accepttext() = -1 then
		return ::message.returnvalue
	end if
	setpointer(hourglass!)
	if parent.dw_control.object.quot[1] = "Y" then
		lc_quot = "Y"
	else
		lc_quot = "N"
	end if
	if parent.dw_control.object.so[1] = "Y" then
		lc_so = "Y"
	else
		lc_so = "N"
	end if
	if parent.dw_control.object.po[1] = "Y" then
		lc_po = "Y"
	else
		lc_po = "N"
	end if
	sqlca.import_quot_so_po_fromparentserver(gs_parentlinkserver, gs_parentdbname, gs_parentowner, lc_quot, lc_so, lc_po)
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
		ll_retcode = 0
		messagebox("Parent Server Transaction(s) Import", "Import of Parent Server Transaction(s) successfully completed", information!)
	else
		ls_errtext = sqlca.sqlerrtext
		SQL rollback USING sqlca;
		messagebox("Parent Server Transaction(s) Import", "Import of Parent Server Transaction(s) Terminated un-successfully~r~nDetails Are:-~r~n" + ls_errtext, stopsign!)
		ll_retcode = -1
	end if
	if ll_retcode = 0 then
		parent.post event ue_close()
	end if
	return ::message.returnvalue
