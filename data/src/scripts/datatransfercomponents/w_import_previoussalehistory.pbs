// window w_import_previoussalehistory (datatransfercomponents)  ancestor: w_arguements

// w_import_previoussalehistory.create() returns 0 [event]
	integer icurrent
	call super::create
	this.hpb_hpb = create hpb_hpb
	this.st_4 = create st_4
	this.sle_currdb = create sle_currdb
	this.gb_overallprogress = create gb_overallprogress
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.hpb_hpb
	this.control[icurrent + 2] = this.st_4
	this.control[icurrent + 3] = this.sle_currdb
	this.control[icurrent + 4] = this.gb_overallprogress

// w_import_previoussalehistory.destroy() returns 0 [event]
	call super::destroy
	destroy this.hpb_hpb
	destroy this.st_4
	destroy this.sle_currdb
	destroy this.gb_overallprogress

// w_import_previoussalehistory.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.it_mytrans = create u_transaction
	this.it_mytrans.dbparm = "PROVIDER='SQLOLEDB',DATASOURCE='" + gs_servername + "',CommitOnDisconnect='No',PROVIDERSTRING='DataBase=master" + ";APP=" + gs_app + ";WSID=" + gs_localcomputername + "',PBTrimCharColumns='Yes',StripParmNames='Yes'"
	SQL start USING this.it_mytrans;
	if this.it_mytrans.sqlcode <> 0 then
		messagebox("Connection Problem", "Problem Connecting Database", stopsign!)
		close(this)
	end if
	this.dw_control.settransobject(this.it_mytrans)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.sle_currdb.text = gs_dbname
	return ::message.returnvalue

// w_import_previoussalehistory.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	close(this)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	string ls_sourcedb
	string ls_targetdb
	ancestorreturnvalue = super::clicked()
	ls_sourcedb = parent.dw_control.getitemstring(1, "dbname")
	ls_targetdb = gs_dbname
	if len(ls_sourcedb) = 0 or isnull(ls_sourcedb) then
		messagebox("Source Database Validation!", "Please select valid database to import previous sale history")
		return ::message.returnvalue
	end if
	if lower(ls_sourcedb) = lower(ls_targetdb) then
		messagebox("Database Validation!", "Previous sales history must not be imported from same database~r~nPlease select valid database to import previous sale history", information!)
		return ::message.returnvalue
	end if
	setpointer(hourglass!)
	parent.gb_overallprogress.visible = true
	parent.hpb_hpb.visible = true
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if not isnull(ls_sourcedb) and parent.istr_arg.d_sdate <= parent.istr_arg.d_edate then
		parent.istr_arg.i_status = 1
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
		parent.hpb_hpb.stepit()
		SQL rollback USING sqlca;
		sqlca.get_previoussalehistory(ls_sourcedb, ls_targetdb, parent.istr_arg.d_sdate, parent.istr_arg.d_edate)
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
			parent.hpb_hpb.stepit()
			parent.hpb_hpb.stepit()
			parent.hpb_hpb.stepit()
		else
			messagebox("Import Problem", "Problem in importing previous sales history~r~nReasons are: -~r~n" + sqlca.sqlerrtext)
			SQL rollback USING sqlca;
			parent.hpb_hpb.visible = false
			parent.hpb_hpb.position = 10
			parent.gb_overallprogress.visible = false
			return ::message.returnvalue
		end if
		return
	end if
	parent.hpb_hpb.visible = false
	parent.hpb_hpb.position = 10
	parent.gb_overallprogress.visible = false
	setpointer(arrow!)
	parent.post event ue_close(1)
	return ::message.returnvalue
