// window w_pull_po_from_dropbox (datatransfercomponents)  ancestor: window

// w_pull_po_from_dropbox.ue_postopen() returns 0
	string ls_connsetting
	ls_connsetting = "Set ANSI_NULLS ON Set ANSI_WARNINGS ON"
	this.it_transobject = create u_transaction
	SQL start USING this.it_transobject;
	SQL EXECUTE IMMEDIATE :ls_connsetting USING this.it_transobject;
	this.dw_control.settransobject(this.it_transobject)
	if this.dw_control.getchild("pocode", this.idc_child) = -1 then
		messagebox("DataWindow Child", "Unable to get DataWindow Child for Purchase Order Code")
		return
	end if
	this.idc_child.settransobject(this.it_transobject)
	this.idc_child.retrieve(gs_dropbox_server, gs_dropbox_db, "dbo", gl_sitecode)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)

// w_pull_po_from_dropbox.ue_close() returns 0
	closewithreturn(this, this.istr_arguments)

// w_pull_po_from_dropbox.create() returns 0
	this.cbx_discount = create cbx_discount
	this.cbx_price = create cbx_price
	this.dw_control = create dw_control
	this.st_1 = create st_1
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.control = {this.cbx_discount, this.cbx_price, this.dw_control, this.st_1, this.cb_cancel, this.cb_ok}

// w_pull_po_from_dropbox.destroy() returns 0
	destroy this.cbx_discount
	destroy this.cbx_price
	destroy this.dw_control
	destroy this.st_1
	destroy this.cb_cancel
	destroy this.cb_ok

// w_pull_po_from_dropbox.open() returns long
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	post event ue_postopen()
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.istr_arguments.i_status = -1
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long
	long ll_pocode
	long ll_sitecode
	long ll_custcode
	ll_pocode = parent.dw_control.getitemnumber(parent.dw_control.getrow(), "pocode")
	ll_sitecode = parent.idc_child.getitemnumber(parent.idc_child.getrow(), "sitecode")
	ll_custcode = parent.idc_child.getitemnumber(parent.idc_child.getrow(), "custcode")
	if isnull(ll_pocode) then
		messagebox("Selection Validation", "Kindly select Purchase Order No. from the dropdown.")
		return -1
	end if
	if parent.cbx_price.checked = true then
		parent.istr_arguments.l_code2 = 1
	else
		parent.istr_arguments.l_code2 = 0
	end if
	if parent.cbx_discount.checked = true then
		parent.istr_arguments.l_code3 = 1
	else
		parent.istr_arguments.l_code3 = 0
	end if
	parent.istr_arguments.l_code1 = ll_pocode
	parent.istr_arguments.i_status = 1
	parent.istr_arguments.l_code4 = ll_sitecode
	parent.istr_arguments.l_code5 = ll_custcode
	parent.post event ue_close()
	return ::message.returnvalue
