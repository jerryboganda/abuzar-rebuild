// window w_otp_verfication (datatransfercomponents)  ancestor: window

// w_otp_verfication.ue_postopen() returns 0
	long ll_found
	this.dw_control.settransobject(sqlca)
	this.dw_control.retrieve()
	this.istr_arguments = message.powerobjectparm
	this.dw_control.object.transcode[1] = this.istr_arguments.s_name1
	this.dw_control.object.otp[1] = this.istr_arguments.s_name2

// w_otp_verfication.ue_close() returns 0
	closewithreturn(this, this.istr_arguments)

// w_otp_verfication.create() returns 0
	this.dw_control = create dw_control
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.control = {this.dw_control, this.cb_cancel, this.cb_ok}

// w_otp_verfication.destroy() returns 0
	destroy this.dw_control
	destroy this.cb_cancel
	destroy this.cb_ok

// w_otp_verfication.open() returns long
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	post event ue_postopen()
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.istr_arguments.i_status = -1
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long
	parent.istr_arguments.i_status = 1
	parent.post event ue_close()
	return ::message.returnvalue
