// window w_guesttransfer_form (guestcomponents)  ancestor: w_single_entry

// w_guesttransfer_form.wf_transferhistory() returns 0
	long ll_guestcheckincode
	ll_guestcheckincode = this.id_detail.object.guestcheckincode[this.id_detail.rowcount()]
	openwithparm(w_guesttransferhistory, ll_guestcheckincode)

// w_guesttransfer_form.wf_is_guest_checkedin(long al_guestcheckincode) returns long
	long ll_count
	SQL SELECT Count ( *) INTO :ll_count FROM GuestCheckIn WHERE GuestCheckIn.GuestCheckInCode =:al_guestcheckincode AND GuestCheckIn.CheckOut ='N' USING sqlca;
	return ll_count

// w_guesttransfer_form.wf_is_room_occupied(long al_locationcode) returns long
	long ll_retcode
	long ll_code
	long ll_roomcode
	SQL SELECT CASE Occupied WHEN 'Y' THEN 1 ELSE 0 END INTO :ll_retcode FROM GuestRoom WHERE GuestRoomCode =:al_locationcode USING this.it_transobject;
	return ll_retcode

// w_guesttransfer_form.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_guesttransfermenu" then
		this.menuid = create m_guesttransfermenu
	end if
	this.dw_transferdetail = create dw_transferdetail
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_transferdetail

// w_guesttransfer_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_transferdetail

// w_guesttransfer_form.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_guesttransfer_form.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "GuestTransfer"
	this.im_transfermenu = this.menuid
	this.id_print.dataobject = "d_guesttransfer_print"
	return ::message.returnvalue

// w_guesttransfer_form.ue_save() returns 0 [event]
	long ll_primarykey
	long ll_row
	long ll_retcode
	long ll_roomcode
	long ll_rowcounter
	long ll_guestcheckincode
	long ll_usercode
	long ll_lastroom
	datetime ldt_server_datetime
	string ls_date_errtext
	setpointer(hourglass!)
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	ll_row = this.id_detail.getrow()
	ll_primarykey = this.id_detail.object.code[ll_row]
	ll_roomcode = this.id_detail.object.newroom[ll_row]
	ll_lastroom = this.id_detail.object.lastroom[ll_row]
	if wf_is_guest_checkedin(this.id_detail.object.guestcheckincode[ll_row]) <= 0 then
		messagebox("Problem Saving", "Guest No more Admitted.~r~nTransfer Aborted.")
		this.id_detail.setfocus()
		this.id_detail.setcolumn("NewRoom")
		return
	end if
	if ll_roomcode = this.id_detail.object.lastroom[ll_row] then
		messagebox("Problem Saving", "Current Location and New Location must be different.")
		this.id_detail.setfocus()
		this.id_detail.setcolumn("NewRoom")
		return
	end if
	if wf_is_room_occupied(ll_roomcode) > 0 then
		messagebox("Problem Saving", "New Room is already occupied by some Guest.")
		this.id_detail.setfocus()
		this.id_detail.setcolumn("NewRoom")
		return
	end if
	open(w_salesmanpassword)
	ll_usercode = long(message.doubleparm)
	setfocus()
	if ll_usercode = 0 or isnull(ll_usercode) then
		messagebox("User Validation", "Please Select Valid User", stopsign!)
		return
	end if
	this.dw_transferdetail.settransobject(sqlca)
	if isnull(ll_primarykey) then
		if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			return
		end if
		this.id_detail.setitem(ll_row, "date", ldt_server_datetime)
	end if
	if isnull(ll_primarykey) then
		ll_primarykey = 0
		f_newtableid(this.is_tablename, ll_primarykey)
		this.id_detail.setitem(ll_row, "code", ll_primarykey)
	end if
	ll_rowcounter = this.dw_transferdetail.insertrow(0)
	this.dw_transferdetail.object.guesttransfercode[ll_rowcounter] = ll_primarykey
	this.dw_transferdetail.object.guestcheckincode[ll_rowcounter] = this.id_detail.object.guestcheckincode[ll_row]
	this.dw_transferdetail.object.date[ll_rowcounter] = ldt_server_datetime
	this.dw_transferdetail.object.lastroom[ll_rowcounter] = this.id_detail.object.lastroom[ll_row]
	this.dw_transferdetail.object.newroom[ll_rowcounter] = this.id_detail.object.newroom[ll_row]
	this.dw_transferdetail.object.remarks[ll_rowcounter] = this.id_detail.object.remarks[ll_row]
	this.dw_transferdetail.object.usercode[ll_rowcounter] = ll_usercode
	ll_guestcheckincode = this.id_detail.object.guestcheckincode[ll_row]
	if this.dw_transferdetail.update() > 0 then
		SQL update DBO.GuestCheckIn SET CurrentRoom =:ll_roomcode WHERE GuestCheckInCode =:ll_guestcheckincode USING sqlca;
		if sqlca.sqlcode = 0 then
			SQL update GuestRoom SET Occupied ='Y' WHERE GuestRoomCode =:ll_roomcode USING sqlca;
			if sqlca.sqlcode = 0 then
				SQL update GuestRoom SET Occupied ='N' WHERE GuestRoomCode =:ll_lastroom USING sqlca;
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
					this.ib_commitok = true
				else
					SQL rollback USING sqlca;
					setpointer(arrow!)
					messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs~n~rDetails: -" + sqlca.sqlerrtext, exclamation!, ok!, 1)
				end if
			else
				SQL rollback USING sqlca;
				setpointer(arrow!)
				messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs~n~rDetails: -" + sqlca.sqlerrtext, exclamation!, ok!, 1)
			end if
		else
			SQL rollback USING sqlca;
			setpointer(arrow!)
			messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs~n~rDetails: -" + sqlca.sqlerrtext, exclamation!, ok!, 1)
		end if
		this.editflag = false
	else
		SQL rollback USING sqlca;
		setpointer(arrow!)
		messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs~n~rDetails: -" + sqlca.sqlerrtext, exclamation!, ok!, 1)
		return
	end if
	setpointer(arrow!)

// w_guesttransfer_form.ue_detail() returns 0 [event]
	long ll_code
	this.im_menu.m_file.m_new.enabled = false
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_delete.enabled = true
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.i_editmode = 2
	this.i_retrievemode = 2
	if this.tab_retrieve.tabpage_list.dw_list.rowcount() > 0 and this.id_dwcontrol.getrow() > 0 then
		ll_code = this.id_dwcontrol.borderstyle.code[this.id_dwcontrol.getrow()]
		this.id_dwcontrol = this.id_detail
		wf_retrieve(ll_code)
		this.id_dwcontrol = this.id_list
		this.tab_retrieve.tabpage_detail.dw_detail.setfocus()
	end if

// w_guesttransfer_form.ue_newform() returns 0 [event]
	integer li_protect
	call super::ue_newform
	wf_protectdw(this.id_detail, li_protect)

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	long ll_patientcode
	string ls_regno
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "newroom"
		if isnull(data) then
			messagebox("New Guest Room Validation", "Please Choose Some Valid Guest Room")
			return 1
		end if
	end choose
	return ::message.returnvalue
