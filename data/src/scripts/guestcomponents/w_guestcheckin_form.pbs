		end if
	case "customer_nic"
		if data = "" or isnull(data) then
			messagebox("Owner CNIC No. Validation", "Value required for Owner CNIC No. in current row")
		end if
	case "accounts_name"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for Name in current row")
		end if
	case "customer_address"
		if data = "" or isnull(data) then
			messagebox("Address Validation", "Value required for Address in current row")
		end if
	case "customer_areacode"
		if data = "" or isnull(data) then
			messagebox("Area Name Validation", "Value required for Area Name in current row")
		end if
	case "customer_city"
		if data = "" or isnull(data) then
