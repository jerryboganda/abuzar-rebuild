// tabpage_checkin.create() returns 0
	this.dw_checkin = create dw_checkin
	this.dw_checkinservice = create dw_checkinservice
	this.control = {this.dw_checkin, this.dw_checkinservice}

// tabpage_checkin.destroy() returns 0
	destroy this.dw_checkin
	destroy this.dw_checkinservice

// dw_checkinservice.ue_enterkey() returns long
	long ll_rowcount
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		if rowcount() > 0 and f_validatedw(this) < 0 then
			return ::message.returnvalue
		end if
		ll_rowcount = insertrow(0)
		if ll_rowcount > 1 then
			scrolltorow(ll_rowcount)
			setcolumn("validfrom")
			setfocus()
		end if
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_checkinservice.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	long ll_rowcount
	if keyflags = 2 then
		if key = keyi! then
			if rowcount() > 0 and f_validatedw(this) < 0 then
				return ::message.returnvalue
			end if
			ll_rowcount = insertrow(0)
			if ll_rowcount > 1 then
				scrolltorow(ll_rowcount)
				setfocus()
			end if
		end if
		if key = keyd! then
			if rowcount() > 0 then
				deleterow(0)
			end if
			ll_rowcount = rowcount()
			if ll_rowcount > 1 then
				scrolltorow(ll_rowcount)
				setfocus()
			end if
		end if
	end if
	return ::message.returnvalue

// dw_checkinservice.itemchanged(long row, dwobject dwo, string data) returns long
	integer li_errcode
	choose case dwo.name
	case "servicecode"
		parent.parent.parent.ib_checkinservice_validated = false
		parent.parent.parent.il_checkinservice_row = row
		li_errcode = 0
		return li_errcode
	end choose
	return li_errcode

// dw_checkinservice.getfocus() returns long
	setcolumn("servicecode")
	setfocus()
	return ::message.returnvalue

// dw_checkinservice.itemerror(long row, dwobject dwo, string data) returns long
	choose case dwo.name
	case "servicecode"
		if data = "" or isnull(data) then
			messagebox("Service Validation", "Value required for Service in current row")
		end if
	end choose
	return 1

// dw_checkinservice.itemfocuschanged(long row, dwobject dwo) returns long
	if row > 0 and parent.parent.parent.wf_validate_checkinservice() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue
