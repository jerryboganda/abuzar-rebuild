	ls_mod = ls_mod + "customer_licenceno.Update=no "
	ls_mod = ls_mod + "customer_licenceexpiry.Update=no "
	ls_mod = ls_mod + "code.Key=no "
	ls_mod = ls_mod + "customer_SalesTaxRegNo.Update=No "
	ls_mod = ls_mod + "customer_DefaultGST.Update=No "
	ls_mod = ls_mod + "customer_InvDiscperc.Update=No "
	ls_mod = ls_mod + "customer_DefaultSalePrice.Update=No "
	ls_mod = ls_mod + "customer_DefaultItemDiscPerc.Update=No "
	ls_mod = ls_mod + "customer_subareacode.Update=No "
	ls_mod = ls_mod + "customer_BankName.Update=No "
	ls_mod = ls_mod + "customer_BankAdd.Update=No "
