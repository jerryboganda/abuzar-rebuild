	this.control = {this.tabpage_room, this.tabpage_guest, this.tabpage_checkin}

// tab_main.destroy() returns 0
	destroy this.tabpage_room
	destroy this.tabpage_guest
	destroy this.tabpage_checkin

// tab_main.selectionchanged(integer oldindex, integer newindex) returns long
	if newindex = 1 then
		parent.id_guest.setfocus()
	elseif newindex = 2 then
		parent.id_room.setfocus()
	elseif newindex = 3 then
		parent.id_roomservice.setfocus()
	elseif newindex = 4 then
		parent.id_checkin.setfocus()
	end if
	return ::message.returnvalue

// tabpage_room.create() returns 0
	this.dw_roomservice = create dw_roomservice
	this.dw_room = create dw_room
	this.control = {this.dw_roomservice, this.dw_room}

// tabpage_room.destroy() returns 0
	destroy this.dw_roomservice
	destroy this.dw_room

// dw_roomservice.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	long ll_rowcount
	if keyflags = 2 then
		if key = keyi! then
			if getrow() > 0 and rowcount() > 0 and parent.parent.parent.wf_validate_roomservice() = -1 then
				return ::message.returnvalue
			end if
			if parent.parent.parent.id_roomservice.rowcount() > 0 and f_validatedw(parent.parent.parent.id_roomservice) < 0 then
				return ::message.returnvalue
			end if
			ll_rowcount = parent.parent.parent.id_roomservice.insertrow(0)
			if ll_rowcount > 1 then
				parent.parent.parent.id_roomservice.scrolltorow(ll_rowcount)
				parent.parent.parent.id_roomservice.setfocus()
			end if
		end if
		if key = keyd! then
			if parent.parent.parent.id_roomservice.rowcount() > 0 then
				parent.parent.parent.id_roomservice.deleterow(0)
			end if
			ll_rowcount = parent.parent.parent.id_roomservice.rowcount()
			if ll_rowcount > 1 then
				parent.parent.parent.id_roomservice.scrolltorow(ll_rowcount)
				parent.parent.parent.id_roomservice.setfocus()
			end if
		end if
	end if
	return ::message.returnvalue

// dw_roomservice.ue_enterkey() returns long
	long ll_rowcount
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		if parent.parent.parent.id_roomservice.rowcount() > 0 and f_validatedw(parent.parent.parent.id_roomservice) < 0 then
			return ::message.returnvalue
		end if
		if getrow() > 0 and parent.parent.parent.wf_validate_roomservice() = -1 then
			return 1
		end if
		ll_rowcount = parent.parent.parent.id_roomservice.insertrow(0)
		if ll_rowcount > 1 then
			parent.parent.parent.id_roomservice.scrolltorow(ll_rowcount)
			parent.parent.parent.id_roomservice.setfocus()
		end if
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_roomservice.getfocus() returns long
	setcolumn("icode")
	setfocus()
	return ::message.returnvalue

// dw_roomservice.itemchanged(long row, dwobject dwo, string data) returns long
	integer li_errcode
	choose case dwo.name
	case "icode"
		parent.parent.parent.ib_roomservice_validated = false
		parent.parent.parent.il_roomservice_row = row
		li_errcode = 0
		return li_errcode
	end choose
	return li_errcode

// dw_roomservice.itemerror(long row, dwobject dwo, string data) returns long
	choose case dwo.name
	case "icode"
		if data = "" or isnull(data) then
			messagebox("Service Validation", "Value required for Service in current row")
		end if
	end choose
	return 1

// dw_roomservice.itemfocuschanged(long row, dwobject dwo) returns long
	if row > 0 and parent.parent.parent.wf_validate_roomservice() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// tabpage_guest.create() returns 0
	this.dw_guest = create dw_guest
	this.control = {this.dw_guest}

// tabpage_guest.destroy() returns 0
	destroy this.dw_guest

// dw_guest.ue_enterkey() returns long
	send(handle(this), 256, 9, long(90))
	return 1

// dw_guest.itemchanged(long row, dwobject dwo, string data) returns long
	long ll_null
	choose case dwo.name
	case "customer_fullname"
		if data = "" or isnull(data) or len(data) = 0 then
			messagebox("Full Name Validation", "Please enter fulll customer name")
			return 1
		end if
	case "customer_issuedlicenseno"
		if data = "" or isnull(data) or len(data) = 0 then
			return 1
		end if
	end choose
	return 0

// dw_guest.itemerror(long row, dwobject dwo, string data) returns long
	choose case dwo.name
	case "customer_fullname"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for Name in current row")
		end if
	case "customer_issuedlicenseno"
		if data = "" or isnull(data) then
