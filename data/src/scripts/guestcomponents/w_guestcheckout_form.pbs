// window w_guestcheckout_form (guestcomponents)  ancestor: w_single_entry

// w_guestcheckout_form.wf_findregno(long al_patientcode) returns string
	string ls_regno
	SQL SELECT Patient.RegNo INTO :ls_regno FROM Patient WHERE Patient.PatientCode =:al_patientcode USING sqlca;
	return ls_regno

// w_guestcheckout_form.wf_getwardcode(long al_locationcode) returns long
	long ll_wardcode
	SQL SELECT patientlocation.wardcode INTO :ll_wardcode FROM patientlocation WHERE patientlocation.locationcode =:al_locationcode USING sqlca;
	return ll_wardcode

// w_guestcheckout_form.wf_locationoccupied(long al_locationcode) returns long
	long ll_retcode
	SQL SELECT COUNT ( *) INTO :ll_retcode FROM ( select distinct locationcode from patientadmission where discharged ='N' AND admissioncode not in ( select distinct admissioncode from patienttransfer where transfercode in ( select max ( transfercode ) from patienttransfer group by admissioncode ) ) union select distinct locationcode =targetlocation from patienttransfer where admissioncode in ( select admissioncode from patientadmission where discharged ='N' and admissioncode in ( select distinct admissioncode from patienttransfer where transfercode in ( select max ( transfercode ) from patienttransfer group by admissioncode ) ) ) ) L WHERE LocationCode =:al_locationcode USING sqlca;
	return ll_retcode

// w_guestcheckout_form.wf_transferhistory() returns 0
	long ll_admissioncode
	ll_admissioncode = this.id_detail.object.admissioncode[this.id_detail.rowcount()]
	openwithparm(w_patienttransferhistory, ll_admissioncode)

// w_guestcheckout_form.wf_findpatientcode(string as_regno) returns long
	long ll_patientcode
	SQL SELECT PatientCode INTO :ll_patientcode FROM Patient WHERE Patient.RegNo =:as_regno USING sqlca;
	return ll_patientcode

// w_guestcheckout_form.wf_is_checkedin(long al_code) returns long
	long ll_count
	SQL SELECT Count ( *) INTO :ll_count FROM GuestCheckIn WHERE GuestCheckIn.GuestCheckInCode =:al_code AND GuestCheckIn.Checkout ='N' USING sqlca;
	return ll_count

// w_guestcheckout_form.wf_set_guest_inactive(long al_code) returns long
	SQL update Guest Set Active ='N' Where Guestcode =:al_code USING sqlca;
	return sqlca.sqlcode

// w_guestcheckout_form.create() returns 0 [event]
	call super::create

// w_guestcheckout_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_guestcheckout_form.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_guestcheckout_form.open() returns long [event]
	long ancestorreturnvalue
	long ll_found
	ancestorreturnvalue = super::open()
	this.is_tablename = "GuestCheckIn"
	this.id_print.dataobject = "d_guestcheckin_bill"
	this.id_print.settransobject(sqlca)
	return ::message.returnvalue

// w_guestcheckout_form.ue_save() returns 0 [event]
	long ll_primarykey
	long ll_row
	long ll_retcode
	long ll_option = 2
	long ll_currentroom
	datetime ldt_server_datetime
	double ld_balance
	string ls_date_errtext
	string ls_enforceguestbalanceclearance
	dwitemstatus lds_rowstatus
	setpointer(hourglass!)
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	ll_row = this.id_detail.getrow()
	ll_primarykey = this.id_detail.object.code[ll_row]
	ll_currentroom = this.id_detail.object.currentroom[ll_row]
	if isnull(ll_primarykey) then
		messagebox("Problem Saving", "Not a Valid Guest To Check Out.~r~nCheck Out Process Aborted.", stopsign!)
		this.id_detail.setfocus()
		this.id_detail.setcolumn("CheckOut")
		return
	end if
	if wf_is_checkedin(this.id_detail.object.code[ll_row]) <= 0 then
		messagebox("Guest Check Out Problem", "Guest No more Checked In.~r~nCheck Out Process Aborted.", stopsign!)
		this.id_detail.setfocus()
		this.id_detail.setcolumn("CheckOut")
		return
	end if
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if this.id_detail.object.checkout[ll_row] = "Y" then
		this.id_detail.object.checkoutby[ll_row] = gl_usercode
		this.id_detail.object.checkoutdate[ll_row] = ldt_server_datetime
		sqlca.guestcheckinbalance(ll_primarykey, ld_balance)
		if sqlca.sqlcode = 0 then
			if ld_balance <> 0.0 then
				if ls_enforceguestbalanceclearance = "Y" then
					SQL rollback USING sqlca;
					messagebox("Guest Check Out Alert!", "Guest Balance Not Zero~r~n" + "Guest Balance : " + string(ld_balance, "###,###,###0.00") + "~r~nIt must be Zero.~r~nCheck Out Process Aborted.", stopsign!)
					return
				else
					ll_option = 2
					ll_option = messagebox("Guest Check Out Alert!", "Guest Balance Not Zero~r~n" + "Guest Balance : " + string(ld_balance, "###,###,###0.00") + "~r~nIt is Highly recommended that It must be Zero before Check Out.~r~n~r~nCheck Out Guest Anyway?", question!, yesnocancel!, 2)
					if ll_option > 1 then
						SQL rollback USING sqlca;
						return
					end if
				end if
				return
			end if
		else
			messagebox("Guest Check Out Problem!", "Unable To Fetch Guest Balance.~r~nCheck Out Process Aborted.", stopsign!)
			SQL rollback USING sqlca;
			return
		end if
		if wf_set_guest_inactive(this.id_detail.getitemnumber(ll_row, "Guestcode")) <> 0 then
			messagebox("Guest Check Out Problem!", "Unable to update Guest Active Status.~r~nCheck Out Process Abort.")
			SQL rollback USING sqlca;
			return
		end if
		return
	end if
	if this.id_detail.update() > 0 then
		if ll_currentroom > 0 then
			SQL update GuestRoom SET Occupied ='N' WHERE GuestRoomCode =:ll_currentroom USING sqlca;
		end if
		SQL commit USING sqlca;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		this.ib_commitok = true
		this.editflag = false
	else
		SQL rollback USING sqlca;
		setpointer(arrow!)
		messagebox("Guest Check Out Problem!", "Changes Rollback in database, ~n~rSome database problem occurs", exclamation!, ok!, 1)
		return
	end if
	setpointer(arrow!)

// w_guestcheckout_form.ue_detail() returns 0 [event]
	long ll_code
	integer li_protect
	this.im_menu.m_file.m_new.enabled = false
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_delete.enabled = true
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.i_editmode = 2
	this.i_retrievemode = 2
	if this.tab_retrieve.tabpage_list.dw_list.rowcount() > 0 and this.il_selectedrow > 0 then
		ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
		this.id_dwcontrol = this.id_detail
		wf_retrieve(ll_code)
		if this.id_dwcontrol.borderstyle.checkout[this.id_dwcontrol.rowcount()] = "Y" then
			messagebox("Problem", "Guest Already Checked Out.")
			this.im_menu.m_file.m_save.enabled = false
			li_protect = 1
			wf_protectdw(this.id_detail, li_protect)
		else
			li_protect = 0
			wf_protectdw(this.id_detail, li_protect)
			this.id_detail.object.checkout.protect = "0"
		end if
		this.id_dwcontrol = this.id_list
		this.tab_retrieve.tabpage_detail.dw_detail.setfocus()
	end if

// w_guestcheckout_form.ue_newform() returns 0 [event]
	integer li_protect
	call super::ue_newform
	wf_protectdw(this.id_detail, li_protect)

// w_guestcheckout_form.ue_list() returns 0 [event]
	call super::ue_list
	this.im_menu.m_file.m_new.enabled = false

// w_guestcheckout_form.ue_print() returns 0 [event]
	long ll_code
	boolean lb_listtab
	s_datastore lstr
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_code) or ll_code <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_code = this.id_detail.getitemnumber(this.id_detail.getrow(), "code")
	end if
	wf_setprintout()
	this.id_print.settransobject(sqlca)
	this.id_print.retrieve(ll_code)
	lstr.dw = this.id_print
	lstr.s_name1 = this.id_print.dataobject
	openwithparm(w_preview_invoices, lstr)
	lstr = message.powerobjectparm
	if lstr.i_closemode = -1 then
		return
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Data,~r~nNo rows are retrieved", information!)
