// window w_guestcheckin (guestcomponents)  ancestor: w_multi_entry

// w_guestcheckin.ue_save_withnocommit() returns long [event]
	setpointer(hourglass!)
	if f_validatedw(this.id_master) < 0 then
		return -1
	end if
	if f_validatedw(this.id_detail) < 0 then
		return -2
	end if
	if this.id_master.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -3
	end if
	if this.id_detail.update() < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -4
	end if
	setpointer(arrow!)
	return 0

// w_guestcheckin.wf_print() returns integer
	integer li_errcode = 1
	long ll_salesmancode
	long ll_saleinvcount
	long ll_count
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			for ll_count = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
				this.id_print.retrieve(ll_count)
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			next
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	return li_errcode

// w_guestcheckin.wf_visible(boolean ab_flag) returns 0

// w_guestcheckin.wf_validateitemnew() returns integer
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
		messagebox(ls_titleerrtext, ls_errtext)
	elseif not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		ls_titleerrtext = "Item Validation"
		li_errcode = -2
	end if
	this.ib_itemvalidated = true
	return li_errcode

// w_guestcheckin.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean lb_rtflag = true
	boolean ib_due
	integer li_null
	string ls_null
	ls_titleerrtext = "Item Validation"
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), al_currrow) = true then
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
	elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			li_option = messagebox("Item Validation", "Item stock does not exist~n~rDo You want to due this item", information!, yesno!, 2)
			if li_option = 1 then
				this.id_detail.setitem(this.il_currrow, "qty", 1)
				ib_due = true
			else
				li_errcode = -1
			end if
		end if
	else
		li_errcode = -1
		ls_titleerrtext = "Item Validation"
	end if
	if li_errcode = -1 and not ib_due then
		lb_rtflag = false
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setitem(al_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(al_currrow, "icode", li_null)
		this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	end if
	return lb_rtflag

// w_guestcheckin.wf_duplicatetemplatename(string as_name) returns any
	long ll_count
	long ll_invcode
	boolean b_flag
	ll_invcode = this.id_master.getitemnumber(this.id_master.getrow(), "code")
	as_name = trim(as_name)
	if this.ib_modify then
		SQL SELECT count ( *) INTO :ll_count FROM ServiceTemplateHeader WHERE ServiceTemplateHeader.name =:as_name AND ServiceTemplateHeader.ServiceTemplateCode <> :ll_invcode USING this.it_transobject;
	else
		SQL SELECT count ( *) INTO :ll_count FROM ServiceTemplateHeader WHERE ServiceTemplateHeader.name =:as_name USING this.it_transobject;
	end if
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_guestcheckin.wf_getmaxdate(datetime ad_date) returns integer
	SQL Select Max ( Date ) INTO :ad_date From saleledger USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_guestcheckin.wf_grandtotal() returns double
	double ld_grandtotal
	return ld_grandtotal

// w_guestcheckin.wf_inititeminfo(long al_icode, long al_row, integer ai_rtcode, string as_errortext) returns boolean
	boolean retflag = true
	double ld_saleprice
	double ld_discperc
	double ld_flatdisc
	long ll_packunits
	long ll_saleinvcode
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_allowsaleindecimal
	datetime ldt_date
	setnull(ls_null)
	SQL SELECT service.name , service.price , service.serviceflatdisc , allowsaleindecimal INTO :ls_name, :ld_saleprice, :ld_flatdisc, :ls_allowsaleindecimal FROM service WHERE service.servicecode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Service information can not be retrieved"
	end if
	if retflag then
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "serviceflatdisc", ld_flatdisc)
		this.id_detail.setitem(al_row, "allowsaleindecimal", ls_allowsaleindecimal)
		if this.id_detail.getitemstatus(al_row, "saleprice", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
		end if
		this.id_detail.setitem(al_row, "itemcode", al_icode)
		this.id_detail.setitem(al_row, "icode", al_icode)
	end if
	return retflag

// w_guestcheckin.wf_initmodify(integer ai_protect) returns 0
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_looseqty
	long ll_stock
	long ll_counter = 1
	long ll_count
	if ai_protect = 0 then
		this.ib_modify = true
		this.editflag = true
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_new.enabled = false
		this.im_menu.m_file.m_delete.enabled = false
		this.im_menu.m_item.m_newitem.enabled = true
		this.im_menu.m_item.m_deleteitem.enabled = true
		this.im_menu.m_file.m_first.enabled = false
		this.im_menu.m_file.m_next.enabled = false
		this.im_menu.m_file.m_previous.enabled = false
		this.im_menu.m_file.m_last.enabled = false
		this.im_menu.m_file.m_retrieve.enabled = true
		this.im_menu.m_file.m_retrieve.text = "Lis&t"
		this.tab_retrieve.tabpage_detail.enabled = true
	end if

// w_guestcheckin.wf_lockserviceinvoices(long al_sinvcode, long al_linvcode, long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From ServiceTemplateHeader WITH ( UPDLOCK HOLDLOCK ) Where ServiceTemplateHeader.ServiceTemplatecode Between :al_sinvcode AND :al_linvcode USING sqlca;
	return sqlca.sqlcode

// w_guestcheckin.wf_validateitem(boolean ab_flag) returns integer
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	integer li_option
	boolean ib_due
	integer li_null
	string ls_null
	if this.id_detail.getrow() > 0 then
		this.il_currrow = this.id_detail.getrow()
	end if
	if this.id_detail.rowcount() <= 0 then
		return 0
	end if
	if this.id_detail.rowcount() > 0 and this.il_currrow > 0 then
		ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
		if not isnull(ll_icode) then
			if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
				ls_titleerrtext = "Item Validation"
				ls_errtext = "Duplicate item, please select some other item"
				li_errcode = -1
			else
				wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext)
			end if
		end if
		if ab_flag then
			this.ib_itemvalidated = true
		end if
		if li_errcode = -1 then
			setnull(li_null)
			setnull(ls_null)
			ls_titleerrtext = "Item Validation"
			messagebox(ls_titleerrtext, ls_errtext)
			this.id_detail.setcolumn(this.is_columnitemname)
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.icode[this.il_currrow] = li_null
			this.id_detail.object.itemname[this.il_currrow] = ls_null
		end if
	else
		return 0
	end if
	return li_errcode

// w_guestcheckin.wf_validategodown() returns integer
	long ll_icode
	long ll_gcode
	long ll_stock
	long ll_counter
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	string ls_null
	integer li_errcode = 1
	integer li_null
	integer li_option
	integer li_duperr
	boolean ib_due
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) and li_errcode = -2 then
	end if
	this.ib_godownvalidated = true
	if li_errcode = -1 and not ib_due then
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		this.id_detail.setfocus()
		this.id_detail.setcolumn("gcode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
	end if
	if li_duperr = -2 and not ib_due then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate Item, please select some other item"
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
		this.ib_itemslistopen = true
		this.id_itemslist.show()
		li_errcode = -1
	end if
	return li_errcode

// w_guestcheckin.wf_deleteemptydetailrow() returns integer
	long ll_rowcount
	integer li_rtcode
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 0 and isnull(this.id_detail.getitemnumber(ll_rowcount, "icode")) then
		this.id_detail.deleterow(ll_rowcount)
		li_rtcode = 1
		this.ib_itemslistopen = false
		this.id_itemslist.hide()
		setfocus()
	end if
	return li_rtcode

// w_guestcheckin.wf_populate_group_servicetemplate() returns 0
	long ll_groupcode
	long ll_rtcode
	long ll_rowcount
	long ll_counter
	long ll_icode
	integer li_retcode
	string ls_errortext
	datastore lds_recservices
	if wf_iseditable() = false then
		return
	end if
	lds_recservices = create datastore
	ll_groupcode = f_getgroupcode(gl_usercode)
	lds_recservices.dataobject = "d_group_servicetemplate"
	lds_recservices.settransobject(this.it_transobject)
	ll_rtcode = lds_recservices.retrieve(ll_groupcode)
	if ll_rtcode > 0 then
		for ll_counter = this.id_detail.rowcount() to 1 step -1
			event ue_deleteitem()
		next
		ll_counter = 0
		ll_rowcount = lds_recservices.rowcount()
		if ll_rowcount > 0 then
			for ll_counter = 1 to ll_rowcount
				this.id_detail.insertrow(0)
				ll_icode = lds_recservices.getitemnumber(ll_counter, "servicecode")
				wf_inititeminfo(ll_icode, ll_counter, li_retcode, ls_errortext)
				this.id_detail.setitem(ll_counter, "code", lds_recservices.getitemnumber(ll_counter, "code"))
				this.id_detail.setitem(ll_counter, "icode", lds_recservices.getitemnumber(ll_counter, "servicecode"))
				this.id_detail.setitem(ll_counter, "smancode", lds_recservices.getitemnumber(ll_counter, "smancode"))
				this.id_detail.setitem(ll_counter, "itemcode", lds_recservices.getitemnumber(ll_counter, "servicecode"))
				this.id_detail.setitem(ll_counter, "itemname", lds_recservices.getitemstring(ll_counter, "servicename"))
				this.id_detail.setitem(ll_counter, "qty", lds_recservices.getitemnumber(ll_counter, "qty"))
				this.id_detail.setitem(ll_counter, "saleprice", lds_recservices.getitemnumber(ll_counter, "saleprice"))
				this.id_detail.setitem(ll_counter, "serviceflatdisc", lds_recservices.getitemnumber(ll_counter, "serviceflatdisc"))
				this.id_detail.setitem(ll_counter, "discperc", lds_recservices.getitemnumber(ll_counter, "discperc"))
			next
			this.im_menu.m_file.m_save.enabled = true
		end if
	end if

// w_guestcheckin.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	integer li_protectspecial = 1
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	if this.id_master.getitemstring(this.id_master.rowcount(), "CheckOut") = "N" and this.ib_modify then
		li_protectspecial = 1
	else
		li_protectspecial = 0
	end if
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		elseif (ls_colname = "regno" or ls_colname = "Guestcode" or ls_colname = "CheckInRoom") and li_protectspecial = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_guestcheckin.wf_closelist() returns 0
	this.ib_itemslistopen = false
	this.id_itemslist.hide()

// w_guestcheckin.wf_assign_master_cash_win_object() returns 0
	this.ids_cashwin = create u_ds_standard
	this.ids_cashwin.dataobject = "d_mastercashierwindow_detail"
	this.ids_cashwin.settransobject(this.it_transobject)

// w_guestcheckin.wf_set_cashaccount() returns long
	long ll_cashacccode
	long ll_module
	long ll_code
	ll_module = 42
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = f_is_group_module_cashaccount_allowed(this.il_groupcode, ll_module)
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		ll_cashacccode = 0
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
	elseif isnull(ll_code) or this.id_master.object.code[1] <= 0 then
		this.id_master.object.cashacccode[this.id_master.rowcount()] = ll_cashacccode
	else
		ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	end if
	return ll_cashacccode

// w_guestcheckin.wf_show_mastercashierwindow() returns long
	long ll_counter = 1
	long ll_code
	long ll_row
	long ll_insrow
	long ll_module
	long ll_cashacccode
	double ld_tot_acc_amt
	s_mastercashwin_all lstr_values
	lstr_values.i_interfacecode = 20
	if f_stringpreferences("askmastercashwin_in_guestcheckin") = "N" then
		return 1
	end if
	ll_module = 42
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
		return 0
	end if
	lstr_values.l_doccode = ll_code
	lstr_values.s_doctype = this.is_doctype
	lstr_values.l_cashacccode = ll_cashacccode
	lstr_values.l_groupcode = this.il_groupcode
	lstr_values.l_module = ll_module
	lstr_values.d_netamt = wf_grandtotal()
	lstr_values.d_cashtendered = this.id_master.object.cashtendered[this.id_master.rowcount()]
	lstr_values.d_cashcharged = this.id_master.object.cashcharged[this.id_master.rowcount()]
	lstr_values.d_cashback = this.id_master.object.cashback[this.id_master.rowcount()]
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		lstr_values.l_acccode[ll_counter] = this.ids_cashwin.object.acccode[ll_counter]
		lstr_values.s_remarks[ll_counter] = this.ids_cashwin.object.remarks[ll_counter]
		lstr_values.d_amount[ll_counter] = this.ids_cashwin.object.amount[ll_counter]
		lstr_values.l_rowid[ll_counter] = this.ids_cashwin.object.rowid[ll_counter]
		ld_tot_acc_amt = ld_tot_acc_amt + this.ids_cashwin.object.amount[ll_counter]
	next
	if lstr_values.d_netamt >= lstr_values.d_cashcharged then
		lstr_values.d_docbalance = lstr_values.d_netamt - lstr_values.d_cashcharged - ld_tot_acc_amt
	else
		lstr_values.d_docbalance = 0
	end if
	for ll_counter = 1 to 100
		if lstr_values.l_rowid[ll_counter] <= 0 then
			lstr_values.l_rowid[ll_counter] = -1
		end if
	next
	openwithparm(w_mastercashierwindow, lstr_values)
	lstr_values = message.powerobjectparm
	if lstr_values.i_status = 1 then
		this.ids_cashwin.reset()
		ld_tot_acc_amt = 0
		for ll_counter = 1 to 100
			if lstr_values.l_acccode[ll_counter] > 0 and lstr_values.d_amount[ll_counter] > 0 and lstr_values.l_rowid[ll_counter] > 0 then
				ll_insrow = this.ids_cashwin.insertrow(0)
				this.ids_cashwin.object.documentcode[ll_insrow] = ll_code
				this.ids_cashwin.object.documenttype[ll_insrow] = this.is_doctype
				this.ids_cashwin.object.acccode[ll_insrow] = lstr_values.l_acccode[ll_counter]
				this.ids_cashwin.object.remarks[ll_insrow] = lstr_values.s_remarks[ll_counter]
				this.ids_cashwin.object.amount[ll_insrow] = lstr_values.d_amount[ll_counter]
				this.ids_cashwin.object.rowid[ll_insrow] = lstr_values.l_rowid[ll_counter]
			end if
		next
		this.id_master.object.cashacccode[this.id_master.rowcount()] = lstr_values.l_cashacccode
		this.id_master.object.cashtendered[this.id_master.rowcount()] = lstr_values.d_cashtendered
		this.id_master.object.cashcharged[this.id_master.rowcount()] = lstr_values.d_cashcharged
		this.id_master.object.cashback[this.id_master.rowcount()] = lstr_values.d_cashback
		return 1
	end if
	return 0

// w_guestcheckin.wf_update_mastercashierwindow(long al_code, string as_type, long al_new_pat_adm) returns long
	long ll_counter
	if al_new_pat_adm = 1 then
		for ll_counter = 1 to this.ids_cashwin.rowcount()
			this.ids_cashwin.object.documentcode[ll_counter] = al_code
			this.ids_cashwin.object.documenttype[ll_counter] = as_type
			this.ids_cashwin.object.date[ll_counter] = this.id_master.object.date[1]
		next
		SQL DELETE DBO.MasterCashWin WHERE DocumentCode =:al_code AND DocumentType =:as_type USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if this.ids_cashwin.update() > 0 then
				return 0
			else
				return -1
			end if
		else
			return -1
		end if
		return
	end if
	return 0

// w_guestcheckin.wf_get_guestcheckin_status(long al_guestcode) returns long
	long ll_count
	long ll_code
	string ls_regno
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	if isnull(ll_code) then
		SQL SELECT ISNULL ( Count ( *) , 0 ) INTO :ll_count FROM GuestCheckIn WHERE GuestCheckIn.GuestCode =:al_guestcode AND GuestCheckIn.CheckOut ='N' USING sqlca;
	else
		SQL SELECT ISNULL ( Count ( *) , 0 ) INTO :ll_count FROM GuestCheckIn WHERE GuestCheckIn.GuestCode =:al_guestcode AND GuestCheckIn.GuestCheckInCode <> :ll_code AND GuestCheckIn.CheckOut ='N' USING sqlca;
	end if
	return ll_count

// w_guestcheckin.wf_deleteserviceinvoice(long al_guestcheckincode) returns integer
	SQL Delete GuestCheckInService Where GuestCheckInService.GuestCheckInCode =:al_guestcheckincode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_guestcheckin.wf_findguestcode(string as_regno) returns long
	long ll_guestcode
	SQL SELECT GuestCode INTO :ll_guestcode FROM Guest WHERE Guest.RegNo =:as_regno AND Active ='Y' USING sqlca;
	return ll_guestcode

// w_guestcheckin.wf_registerguest() returns string
	string ls_regno
	if this.ib_modify then
		return ""
	end if
	open(w_guestregistration)
	ls_regno = message.stringparm
	this.id_master.object.regno[this.id_master.rowcount()] = ls_regno
	setpointer(hourglass!)
	this.idc_guest.setredraw(false)
	this.idc_guest.settransobject(this.it_transobject)
	this.idc_guest.retrieve()
	this.idc_guest.setredraw(true)
	setpointer(arrow!)
	this.id_master.object.guestcode[this.id_master.rowcount()] = wf_findguestcode(ls_regno)
	return ls_regno

// w_guestcheckin.wf_findregno(long al_guestcode) returns string
	string ls_regno
	SQL SELECT Guest.RegNo INTO :ls_regno FROM Guest WHERE Guest.GuestCode =:al_guestcode AND Active ='Y' USING sqlca;
	return ls_regno

// w_guestcheckin.wf_set_roominfo(long al_code) returns long
	long ll_floorcode
	long ll_statuscode
	long ll_typecode
	long ll_retcode
	SQL SELECT GuestRoom.GuestRoomFloorcode , GuestRoom.GuestRoomTypecode , GuestRoom.GuestRoomStatuscode INTO :ll_floorcode, :ll_typecode, :ll_statuscode FROM GuestRoom WHERE GuestRoom.GuestRoomCode =:al_code USING sqlca;
	if sqlca.sqlcode = 0 then
		ll_retcode = 0
	else
		ll_retcode = 1
	end if
	return ll_floorcode

// w_guestcheckin.wf_is_room_occupied(long al_code) returns integer
	long ll_retcode
	long ll_code
	long ll_roomcode
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	SQL SELECT CASE Occupied WHEN 'Y' THEN 1 ELSE 0 END INTO :ll_retcode FROM GuestRoom WHERE GuestRoomCode =:al_code USING this.it_transobject;
	if ll_code > 0 then
		SQL SELECT CheckinRoom INTO :ll_roomcode FROM GuestCheckIn WHERE GuestCheckInCode =:ll_code USING this.it_transobject;
		if ll_roomcode = al_code and ll_retcode > 0 then
			ll_retcode = 0
		end if
	end if
	return ll_retcode

// w_guestcheckin.wf_returnserviceinvoice(long al_invid, string as_errtext) returns boolean
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_looseqty
	long ll_stock
	long ll_newstock
	long ll_counter
	long ll_detailrows
	string ls_batch
	string ls_due
	datetime ld_expiry
	boolean lb_commitflag = true
	double ld_avgprice
	if lb_commitflag then
		if wf_deleteserviceinvoice(al_invid) <> 0 then
			lb_commitflag = false
			as_errtext = "    Some database problem occur"
		end if
	else
		as_errtext = "    Some database problem occur"
	end if
	return lb_commitflag

// w_guestcheckin.wf_retrievelist() returns long
	long rtcode
	long ll_days
	datetime ldt_invdate
	ll_days = f_numberpreferences("listviewretrievaldays_in_guestcheckin") * -1
	ldt_invdate = datetime(relativedate(today(), ll_days))
	rtcode = this.id_dwcontrol.retrieve(ldt_invdate)
	return rtcode

// w_guestcheckin.wf_retrievelist_datelimit() returns long
	long rtcode
	datetime ldt_invdate
	s_arguements lstr_arg
	open(w_arg_sdate)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		ldt_invdate = lstr_arg.d_sdate
	else
		return 0
	end if
	rtcode = this.id_dwcontrol.retrieve(ldt_invdate)
	return rtcode

// w_guestcheckin.wf_populate_roomservices(integer ai_roomcode) returns long
	long ll_counter
	long ll_row
	long ll_icode
	integer li_retcode
	string ls_errortext
	datastore lds_ds
	lds_ds = create datastore
	lds_ds.dataobject = "d_guestroomservice"
	lds_ds.settransobject(this.it_transobject)
	lds_ds.retrieve(ai_roomcode)
	for ll_counter = 1 to this.id_detail.rowcount()
		triggerevent("ue_deleteitem")
	next
	if lds_ds.rowcount() > 0 then
		for ll_counter = 1 to lds_ds.rowcount()
			ll_row = this.id_detail.insertrow(0)
			ll_icode = lds_ds.object.icode[ll_counter]
			wf_inititeminfo(ll_icode, ll_counter, li_retcode, ls_errortext)
			this.id_detail.object.icode[ll_row] = lds_ds.object.icode[ll_counter]
			this.id_detail.object.itemcode[ll_row] = lds_ds.object.itemcode[ll_counter]
			this.id_detail.object.currlistrow[ll_row] = ll_row
			this.id_detail.object.itemname[ll_row] = lds_ds.object.itemname[ll_counter]
			this.id_detail.object.saleprice[ll_row] = lds_ds.object.saleprice[ll_counter]
			this.id_detail.object.serviceflatdisc[ll_row] = lds_ds.object.serviceflatdisc[ll_counter]
			this.id_detail.object.discperc[ll_row] = lds_ds.object.discperc[ll_counter]
			this.id_detail.object.smancode[ll_row] = lds_ds.object.smancode[ll_counter]
			this.id_detail.object.qty[ll_row] = lds_ds.object.qty[ll_counter]
		next
	else
		triggerevent("ue_newitem")
	end if
	if this.id_detail.rowcount() = 0 then
		this.il_currrow = 0
	else
		this.il_currrow = 1
	end if
	return 0

// w_guestcheckin.wf_retrieve() returns long
	long rtcode
	long ll_days
	datetime ldt_invdate
	ll_days = f_numberpreferences("listviewretrievaldays_in_guestcheckin") * -1
	ldt_invdate = datetime(relativedate(today(), ll_days))
	rtcode = this.id_dwcontrol.retrieve(ldt_invdate)
	return rtcode

// w_guestcheckin.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_guestcheckinmenu" then
		this.menuid = create m_guestcheckinmenu
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	this.dw_saleinvdetail = create dw_saleinvdetail
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.dw_saleinvdetail

// w_guestcheckin.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.dw_saleinvdetail

// w_guestcheckin.ue_save() returns 0 [event]
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_stock
	long ll_newstock
	long ll_icode
	long ll_salelooseqty
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode = 1
	long ll_gcode
	long ll_headerno
	long ll_headerinvno
	long ll_counter
	long ll_count
	long ll_statusrow
	long ll_custcode
	long ll_guestcode
	long ll_saveresult
	long ll_new_pat_adm
	long ll_null
	boolean lb_commitflag = true
	boolean lb_continue = true
	integer li_counter
	string ls_errtext
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_cashreceived
	long ll_checkinroom
	datetime ldt_server_datetime
	string ls_date_errtext
	setnull(ll_guestcode)
	setnull(ll_null)
	ll_mastercurrrow = this.id_master.getrow()
	ll_checkinroom = this.id_master.object.checkinroom[ll_mastercurrrow]
	this.id_master.object.usercode[ll_mastercurrrow] = gl_usercode
	if wf_get_guestcheckin_status(this.id_master.object.guestcode[ll_mastercurrrow]) > 0 then
		messagebox("Problem Saving", "Guest Already Checked In.~r~nPlease Select some other Guest")
		this.id_master.setfocus()
		this.id_master.setcolumn("GuestCode")
		return
	end if
	if wf_is_room_occupied(ll_checkinroom) > 0 then
		messagebox("Problem Saving", "Guest Room is already occupied by some Other Guest.")
		this.id_master.setfocus()
		this.id_master.setcolumn("CheckInRoom")
		return
	end if
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("servicecomplusion_in_guestcheckin") = "Y" and this.id_detail.rowcount() <= 0 then
		messagebox("Guest Check IN", "Guest Check In Services Compulsion is ON~r~n~r~nEach Guest must contain some Check In Services.~r~nPlease specify at-least one Check In Service that this Guest will utilize.", stopsign!)
		return
	end if
	setpointer(hourglass!)
	if not this.ib_modify and not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if wf_set_cashaccount() = 0 then
		return
	end if
	ll_salesmancode = gl_usercode
	if ll_salesmancode > 0 then
		ll_mastercurrrow = this.id_master.getrow()
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if isnull(ll_invid) then
			ll_new_pat_adm = 1
			if wf_show_mastercashierwindow() = 0 then
				return
			end if
			wf_tabnewid("GuestCheckIn", ll_invid)
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
		end if
		if this.ib_modify then
			lb_continue = wf_returnserviceinvoice(ll_invid, ls_errtext)
		else
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				this.id_master.setitem(ll_mastercurrrow, "code", ll_null)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "CheckInDate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "CheckInBy", ll_salesmancode)
			this.id_master.setitem(ll_mastercurrrow, "CurrentRoom", ll_checkinroom)
		end if
		this.id_master.setitem(ll_mastercurrrow, "Date", ldt_server_datetime)
		this.id_master.setitem(ll_mastercurrrow, "usercode", ll_salesmancode)
		if f_stringpreferences("askmastercashwin_in_guestcheckin") = "N" then
			this.id_master.object.cashtendered[1] = 0
			this.id_master.object.cashcharged[1] = 0
			this.id_master.object.cashback[1] = 0
			this.id_master.accepttext()
		end if
		if lb_continue then
			this.id_saleinvdetail.reset()
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_saleinvdetail.insertrow(0)
				this.id_saleinvdetail.setitem(ll_counter, "code", ll_invid)
				this.id_saleinvdetail.setitem(ll_counter, "icode", this.id_detail.getitemnumber(ll_counter, "icode"))
				this.id_saleinvdetail.setitem(ll_counter, "qty", this.id_detail.getitemnumber(ll_counter, "qty"))
				this.id_saleinvdetail.setitem(ll_counter, "saleprice", this.id_detail.getitemnumber(ll_counter, "saleprice"))
				this.id_saleinvdetail.setitem(ll_counter, "serviceflatdisc", this.id_detail.getitemnumber(ll_counter, "serviceflatdisc"))
				this.id_saleinvdetail.setitem(ll_counter, "discperc", this.id_detail.getitemnumber(ll_counter, "discperc"))
				this.id_saleinvdetail.setitem(ll_counter, "smancode", this.id_detail.getitemnumber(ll_counter, "smancode"))
			next
			this.id_detail = this.id_saleinvdetail
			ll_saveresult = event ue_save_withnocommit()
			if ll_saveresult = 0 then
				if wf_update_mastercashierwindow(ll_invid, this.is_doctype, ll_new_pat_adm) = 0 then
					if this.ib_modify = false then
						SQL update DBO.GuestRoom SET Occupied ='Y' WHERE GuestRoomCode =:ll_checkinroom USING this.it_transobject;
					end if
					SQL commit USING this.it_transobject;
					messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
					this.ib_commitok = true
					this.id_master.resetupdate()
					this.im_menu.m_file.m_new.enabled = true
					this.editflag = false
					this.il_codevalue = ll_invid
					if gd_recenttransdate < this.id_systemdate then
						gd_recenttransdate = this.id_systemdate
					end if
				else
					messagebox("Saving Problem", "Changes Not Saved in database for Master Cashier Window transactions.", stopsign!, ok!, 1)
					this.id_master.setitem(ll_mastercurrrow, "code", ll_null)
				end if
			else
				messagebox("Saving Problem", "Changes Not Saved in database while saving service record.", stopsign!, ok!, 1)
				this.id_master.setitem(ll_mastercurrrow, "code", ll_null)
			end if
			this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
			this.id_saleinvdetail.reset()
			if this.ib_commitok then
				this.ib_modify = false
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			messagebox("Updation Error", ls_errtext + " in current row", stopsign!)
			this.id_master.setitem(ll_mastercurrrow, "code", ll_null)
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_guestcheckin.ue_newform() returns 0 [event]
	integer rtncode
	long li_fetched_code
	long row
	long ll_manfcode
	long ll_found
	call super::ue_newform
	setredraw(false)
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.idc_room.settransobject(this.it_transobject)
	this.idc_room.retrieve()
	this.idc_guest.settransobject(this.it_transobject)
	this.idc_guest.retrieve()
	this.im_menu.m_file.m_print.enabled = true
	this.im_guestcheckinmenu.m_file.m_registerguest.enabled = true
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	wf_populate_group_servicetemplate()
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5069", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_detail.object.saleprice.protect = "0"
		this.id_detail.object.discperc.protect = "0"
	else
		this.id_detail.object.saleprice.protect = "1"
		this.id_detail.object.discperc.protect = "1"
	end if
	this.ib_modify = false
	this.id_itemslist.hide()
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	wf_visible(true)
	wf_assign_master_cash_win_object()
	if this.id_master.rowcount() > 0 then
		this.id_master.object.departuredate[this.id_master.rowcount()] = datetime(relativedate(date(today()), 1), time(today()))
	end if
	setredraw(true)

// w_guestcheckin.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect = 1
	long ll_row
	long ll_code
	long ll_found
	boolean lb_flag
	boolean lb_modify
	call super::ue_detail
	setredraw(false)
	if this.id_master.getitemstring(this.id_master.getrow(), "CheckOut") = "N" then
		li_protect = 0
		wf_initmodify(li_protect)
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	if this.id_master.object.code[this.id_master.rowcount()] > 0 then
		this.ids_cashwin.retrieve(this.id_master.object.code[1], this.is_doctype)
	else
		wf_assign_master_cash_win_object()
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	if this.id_master.getitemstring(this.id_master.getrow(), "CheckOut") = "N" then
		this.id_detail.object.saleprice.protect = trim(string(li_protect))
		this.id_detail.object.discperc.protect = trim(string(li_protect))
		this.id_master.object.regno.protect = "1"
		this.id_master.object.guestcode.protect = "1"
		this.id_master.object.checkinroom.protect = "1"
	end if
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	wf_grandtotal()
	this.im_guestcheckinmenu.m_file.m_registerguest.enabled = false
	setredraw(true)

// w_guestcheckin.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.setcolumn("itemname")
	this.id_detail.insertrow(0)
	this.ib_focusdetail = true
	this.id_itemslist.show()
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.ib_validatefullcode = true

// w_guestcheckin.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	return ::message.returnvalue

// w_guestcheckin.ue_list() returns 0 [event]
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_print.enabled = true
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	wf_retrievelist()

// w_guestcheckin.ue_print() returns 0 [event]
	long ll_custcode
	long ll_row
	long ll_code
	long i
	long li_printretcode
	string ls_custname
	integer li_option
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_code) or ll_code <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_code = this.id_master.getitemnumber(1, "code")
	end if
	if gs_company = "SAWARHOTEL" then
		this.id_print.dataobject = "d_sawarhotel_guestcheckin_print"
	elseif gs_company = "SKYBLUHOTEL" then
		this.id_print.dataobject = "d_skybluhotel_guestcheckin_print"
	else
		this.id_print.dataobject = "d_guestcheckin_print"
	end if
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(ll_code)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.id_print.rowcount() > 0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		li_printretcode = this.id_print.print()
		if li_printretcode < 0 then
			messagebox("Printing", "Can not Print", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print,~r~nNo rows are retrieved", information!)

// w_guestcheckin.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	setpointer(hourglass!)
	this.idc_salesman.settransobject(this.it_transobject)
	this.idc_salesman.retrieve()
	this.idc_guest.setredraw(false)
	this.idc_guest.settransobject(this.it_transobject)
	this.idc_guest.retrieve()
	this.idc_guest.setredraw(true)
	this.idc_room.settransobject(this.it_transobject)
	this.idc_room.retrieve()
	setpointer(arrow!)

// w_guestcheckin.ue_new() returns 0 [event]
	call super::ue_new

// w_guestcheckin.ue_postopen() returns 0 [event]
	integer li_rtncode
	long ll_counter
	long ll_pos
	long ll_pcode
	long ll_prow
	long li_count
	long ll_startrow
	char lc_char
	call super::ue_postopen
	wf_setmenu(this.menuid)
	wf_assign_master_cash_win_object()
	this.il_groupcode = f_getgroupcode(gl_usercode)
	setredraw(false)
	this.id_print = this.dw_saleinvrep
	this.id_saleinvdetail = this.dw_saleinvdetail
	this.id_saleinvdetail.settransobject(this.it_transobject)
	li_rtncode = this.id_detail.getchild("smancode", this.idc_salesman)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild for SalesMan in detail datawindow")
		close(this)
	end if
	this.idc_salesman.settransobject(this.it_transobject)
	li_rtncode = this.id_master.getchild("Guestcode", this.idc_guest)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	li_rtncode = this.id_master.getchild("CheckInRoom", this.idc_room)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild for Guest Room in detail datawindow")
		close(this)
	end if
	this.idc_room.settransobject(this.it_transobject)
	this.id_itemslist.retrieve()
	this.id_detail.object.smancode.initial = trim(string(f_numberpreferences("InitialSManCodeInService")))
	if f_stringpreferences("SalesManInService") = "N" then
		this.id_detail.object.smancode.visible = false
		this.id_detail.object.smancode_t.visible = false
	end if
	this.id_itemslist.object.fullcode.visible = false
	this.id_itemslist.object.location.visible = false
	if f_stringpreferences("ShowServiceQtyInGuestCheckIn") = "N" then
		this.id_detail.object.qty.visible = false
	end if
	for li_count = 65 to 90
		lc_char = char(li_count)
		this.ia_llookuptable[li_count] = this.id_itemslist.find("Lower(itemname) >= Lower('" + char(li_count) + "')", ll_startrow, 99999)
		ll_startrow = this.ia_llookuptable[li_count]
	next
	this.ia_llookuptable[92] = 99999
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	f_setserviceqtystyle(this.id_detail, "qty")
	setredraw(true)

// w_guestcheckin.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.im_guestcheckinmenu = this.menuid
	return ::message.returnvalue

// w_guestcheckin.ue_deleteitem() returns 0 [event]
	call super::ue_deleteitem
	this.im_menu.m_file.m_save.enabled = true

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	return ::message.returnvalue

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	long ll_guestcode
	long ll_res = 1
	string ls_regno
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "regno"
		if not isnull(data) and data <> "" then
			ll_guestcode = parent.parent.parent.wf_findguestcode(data)
			if ll_guestcode = 0 then
				messagebox("Guest Registeration Validation", "Reg. No. Does not Exist.~r~nPlease Choose Some Other Reg. No.")
				return 1
			else
				setitem(row, "GuestCode", ll_guestcode)
				if parent.parent.parent.wf_get_guestcheckin_status(ll_guestcode) > 0 then
					messagebox("Guest Check IN Validation", "Guest Already Admitted~n~rPlease Choose Some Other Guest")
					return 1
				end if
			end if
			return
		end if
	case "guestcode"
		if isnull(long(data)) then
			messagebox("Guest Registeration Validation", "Please Choose Some Guest")
			return 1
		else
			if parent.parent.parent.wf_get_guestcheckin_status(long(data)) > 0 then
				messagebox("Guest Check IN Validation", "Guest Already Checked In~n~rPlease Choose Some Other Guest")
				return 1
			end if
			ls_regno = parent.parent.parent.wf_findregno(long(data))
			setitem(row, "regno", ls_regno)
		end if
	case "checkinroom"
		if isnull(data) then
			messagebox("Guest Room Validation", "Please Choose Some Valid Guest Room")
			return 1
		elseif parent.parent.parent.wf_is_room_occupied(long(data)) > 0 then
			messagebox("Guest Room Validation", "Room is already occupied by some Guest.~r~nPlease select some other Room", stopsign!)
			return 1
		else
			parent.parent.parent.wf_set_roominfo(long(data))
			this.object.currentroom[1] = long(data)
			parent.parent.parent.id_detail.reset()
			parent.parent.parent.wf_populate_roomservices(long(data))
			setfocus()
		end if
	case "stayperiod"
		if long(data) > 0 then
			parent.parent.parent.id_master.object.departuredate[row] = datetime(relativedate(date(today()), long(data)), time(today()))
		end if
	end choose
	return ::message.returnvalue

// dw_detail.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	if parent.parent.parent.id_detail.rowcount() > 0 then
		parent.parent.parent.id_detail.accepttext()
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	integer li_servicecode
	long ll_null
	long ll_icode
	long ll_gcode
	string ls_null
	string ls_itemname
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
		parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		li_errcode = 0
	case "qty"
		if double(data) > 0.0 then
			li_errcode = 0
		else
			li_errcode = 1
		end if
		if li_errcode = 0 then
			if double(long(data)) <> double(data) and parent.parent.parent.id_detail.object.allowsaleindecimal[row] = "N" then
				messagebox("Quantity Validation", "Quantity In decimals is not allowed for this service", stopsign!)
				li_errcode = 1
			else
				li_errcode = 0
			end if
		else
			messagebox("Quantity Validation", "Please enter a valid Quantity for this service", stopsign!)
			li_errcode = 1
		end if
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ll_icode
	long ll_gcode
	long ll_godownstock
	long ancestorreturnvalue
	if row <= 0 then
		return 0
	end if
	if parent.parent.parent.ib_itemvalidated = false and row > 0 and parent.parent.parent.wf_validateitem(false) = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "itemname" then
		parent.parent.parent.ib_focusdetail = true
	end if
	parent.parent.parent.wf_grandtotal()
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return 0

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(true) = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		if data = "" or isnull(data) then
			messagebox("Service Validation", "Please enter value for Service in row " + string(row))
		end if
	case "discperc"
		if real(data) < 0.0 and real(data) > 100.0 then
			messagebox("Service Discount Validation", "Discount ~"" + data + "~" must be betweeen 0 and 100")
		end if
	case "smancode"
		messagebox("SalesPerson Validation", "Please select SalesPerson from the dropdown box.")
	end choose
	return 1

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ll_currrow
	long ll_startrow
	long ll_endrow
	if parent.parent.parent.editflag = false then
		parent.parent.parent.editflag = true
		parent.parent.parent.im_menu.m_file.m_save.enabled = true
	end if
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		if upper(left(data, 1)) >= "A" and upper(left(data, 1)) <= "Z" or left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
			ll_currrow = parent.parent.parent.id_itemslist.getrow()
			if len(data) > 1 then
				ll_startrow = ll_currrow
			else
				if left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
					ll_startrow = 1
				else
					ll_startrow = parent.parent.parent.ia_llookuptable[asc(upper(data))]
				end if
				parent.parent.parent.ib_bkspace = false
			end if
			if parent.parent.parent.ib_bkspace then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.find("Lower(itemname) <= '" + lower(data) + "'", ll_startrow, 0)
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.il_itemlistfoundrow + 1
				parent.parent.parent.ib_bkspace = false
			else
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.find("Lower(itemname) >= '" + lower(data) + "'", ll_startrow, 99999)
			end if
			if parent.parent.parent.il_itemlistfoundrow = 0 then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.rowcount()
			end if
			if parent.parent.parent.il_itemlistfoundrow <> ll_currrow then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.setrow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_itemslist.scrolltorow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_itemslist.selectrow(parent.parent.parent.il_itemlistfoundrow, true)
				ll_endrow = setitem(row, "currlistrow", parent.parent.parent.il_itemlistfoundrow)
				ll_endrow = getitemnumber(row, "currlistrow")
				setfocus()
			end if
		end if
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	end choose
	return ::message.returnvalue

// dw_find.keypressed(keycode key, unsignedlong keyflags) returns long [event]
	integer li_movement
	long ll_row
	long ll_temp
	string sl_columnname
	string ls_rightid
	if key = keyuparrow! then
		ll_row = parent.parent.parent.id_list.getrow() - 1
		parent.parent.parent.id_list.scrollpriorrow()
	elseif key = keydownarrow! then
		ll_row = parent.parent.parent.id_list.getrow() + 1
		parent.parent.parent.id_list.scrollnextrow()
	elseif key = keypagedown! then
		parent.parent.parent.id_list.scrollnextpage()
		ll_row = parent.parent.parent.id_dwcontrol.getrow()
	elseif key = keypageup! then
		parent.parent.parent.id_list.scrollpriorpage()
		ll_row = parent.parent.parent.id_dwcontrol.getrow()
	elseif key = keyhome! then
		scrolltorow(1)
		ll_row = 1
	elseif key = keyend! then
		ll_row = parent.parent.parent.id_list.rowcount()
		scrolltorow(ll_row)
	elseif key = keyenter! then
		if parent.parent.parent.id_dwcontrol.getselectedrow(0) > 0 then
			parent.parent.parent.i_editmode = 2
			parent.parent.parent.tab_retrieve.selectedtab = 1
			return ::message.returnvalue
		end if
	elseif key = keyf7! then
		ll_row = parent.parent.parent.wf_retrievelist_datelimit()
		if ll_row > 0 then
			scrolltorow(1)
			ll_row = 1
		end if
	elseif key = keyf9! then
		ll_row = parent.parent.parent.id_dwcontrol.getrow()
		if ll_row > 0 then
			parent.parent.parent.wf_editpostedinvoice()
			setfocus()
		end if
	end if
	if ll_row > 0 and ll_row <= parent.parent.parent.id_dwcontrol.rowcount() then
		parent.parent.parent.id_list.setredraw(false)
		parent.parent.parent.tab_retrieve.tabpage_detail.enabled = true
		parent.parent.parent.im_menu.m_file.m_retrieve.enabled = true
		parent.parent.parent.id_list.selectrow(0, false)
		parent.parent.parent.id_list.selectrow(ll_row, true)
		if parent.parent.parent.ii_type = 1 then
			setitem(1, "find", parent.parent.parent.id_list.getitemstring(ll_row, parent.parent.parent.ii_colindex))
		elseif parent.parent.parent.ii_type = 3 then
			setitem(1, "find", trim(string(parent.parent.parent.id_list.getitemdatetime(ll_row, parent.parent.parent.ii_colindex))))
		else
			setitem(1, "find", trim(string(parent.parent.parent.id_list.getitemnumber(ll_row, parent.parent.parent.ii_colindex))))
		end if
		parent.parent.parent.il_selectedrow = ll_row
		selecttext(1, len(gettext()))
		parent.parent.parent.id_list.setredraw(true)
	end if
	return ::message.returnvalue
