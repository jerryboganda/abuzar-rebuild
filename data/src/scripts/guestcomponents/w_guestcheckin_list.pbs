// window w_guestcheckin_list (guestcomponents)  ancestor: w_listview_form

// w_guestcheckin_list.wf_openmywindow(long al_code) returns 0
	long ll_code
	if this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 and al_code > 0 then
		ll_code = al_code
	else
		setnull(ll_code)
	end if
	openwithparm(w_guestcheckin_form, ll_code)

// w_guestcheckin_list.create() returns 0 [event]
	call super::create

// w_guestcheckin_list.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_guestcheckin_list.ue_new() returns 0 [event]
	long ll_code
	call super::ue_new
	setnull(ll_code)
	wf_openmywindow(ll_code)

// dw_list.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	long ll_code
	ancestorreturnvalue = super::doubleclicked(xpos, ypos, row, dwo)
	if row > 0 then
		ll_code = this.object.code[row]
		parent.parent.parent.wf_openmywindow(ll_code)
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_find.keypressed(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	long ll_code
	ancestorreturnvalue = super::keypressed(key, keyflags)
	if key = keyenter! and parent.parent.parent.id_list.getselectedrow(0) > 0 then
		ll_code = parent.parent.parent.id_list.object.code[parent.parent.parent.id_list.getselectedrow(0)]
		parent.parent.parent.wf_openmywindow(ll_code)
		return ::message.returnvalue
	end if
	return ::message.returnvalue
