// window w_inpatientservice (ipservices)  ancestor: w_multi_entry

// w_inpatientservice.ue_printdo() returns 0 [event]
	long ll_custcode
	long ll_row
	string ls_custname
	if this.im_menu.m_file.m_save.enabled = true then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	this.id_print.dataobject = "d_deliveryorder_half"
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(this.id_master.getitemnumber(1, "code"))
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_inpatientservice.ue_save_withnocommit() returns long [event]
	setpointer(hourglass!)
	if f_validatedw(this.id_master) < 0 then
		return -1
	end if
	if f_validatedw(this.id_detail) < 0 then
		return -2
	end if
	if this.id_master.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -3
	end if
	if this.id_detail.update() < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -4
	end if
	setpointer(arrow!)
	return 0

// w_inpatientservice.wf_setsuppinfo(long al_suppcode, datawindow ad_master) returns 0
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	SQL SELECT supplier.address1 , supplier.city , supplier.phone INTO :ls_address, :ls_city, :ls_phone FROM supplier WHERE supplier.suppcode =:al_suppcode USING this.it_transobject;
	ll_currow = ad_master.getrow()
	ad_master.object.supplier_address[ll_currow] = ls_address
	ad_master.object.supplier_city[ll_currow] = ls_city
	ad_master.object.supplier_phone[ll_currow] = ls_phone

// w_inpatientservice.wf_setiteminfo(long al_icode, long al_row, double ad_saleprice, double ad_discperc, long al_stock, double ad_avgprice, long al_totalstock, double ad_purdiscperc) returns 0
	this.id_detail.setitem(al_row, "saleprice", ad_saleprice)
	if this.ii_saletype = 2 then
		this.id_detail.setitem(al_row, "discperc", ad_discperc)
	else
		this.id_detail.setitem(al_row, "discperc", 0.0)
	end if
	this.id_detail.setitem(al_row, "rate", ad_saleprice)
	this.id_detail.setitem(al_row, "avgprice", ad_avgprice)
	this.id_footer.object.icode[this.id_footer.getrow()] = al_icode
	this.id_footer.object.stock[this.id_footer.getrow()] = al_stock

// w_inpatientservice.wf_getmaxdate(ref datetime ad_date) returns integer
	SQL Select Max ( Date ) INTO :ad_date From saleledger USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_inpatientservice.wf_getsalesstockinfo(long al_saleinvcode, long al_gcode, long al_icode, ref long al_saleqty) returns integer
	SQL Select IsNull ( Sum ( saledetail.looseqty ) , 0 ) INTO :al_saleqty from saledetail where saledetail.saleinvcode =:al_saleinvcode and saledetail.gcode =:al_gcode and saledetail.icode =:al_icode USING this.it_transobject;
	if isnull(al_saleqty) then
		al_saleqty = 0
	end if
	return this.it_transobject.sqlcode

// w_inpatientservice.wf_savastemplate() returns integer
	s_saletemplateheader lstr_templateheader
	long ll_invid
	integer li_retcode = 1
	long ll_code
	long ll_qty
	long ll_icode
	long ll_totalrows
	long ll_rowcount
	open(w_savesaleastemplate)
	lstr_templateheader = message.powerobjectparm
	f_newtableid("SaleTemplateHeader", ll_invid)
	SQL INSERT INTO SaleTemplateHeader ( saletemplatecode , date , modified , name ) values ( :ll_invid , :lstr_templateheader.dt_templatedate , :lstr_templateheader.dt_templatedate , :lstr_templateheader.s_template ) USING this.it_transobject;
	ll_totalrows = this.id_detail.rowcount()
	for ll_rowcount = 1 to ll_totalrows
		ll_code = ll_invid
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ll_qty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		SQL insert into saletemplatedetail ( saletemplatecode , icode , looseqty ) values ( :ll_code , :ll_icode , :ll_qty ) USING this.it_transobject;
	next
	setpointer(hourglass!)
	if this.it_transobject.sqlcode < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return li_retcode
	else
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Template saved", exclamation!, ok!, 1)
	end if
	return li_retcode

// w_inpatientservice.wf_print() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_count
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			for ll_count = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
				this.id_print.retrieve(ll_count)
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			next
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	return li_errcode

// w_inpatientservice.wf_preinvinfo() returns 0
	s_previnvinfo ls_previnvinfo
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_previnvinfo.ar_customer = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		ls_previnvinfo.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		openwithparm(w_previnvinfo, ls_previnvinfo)
	end if

// w_inpatientservice.wf_retrievelistall() returns long
	string[] ls_posted
	integer li_salecategory
	datetime ld_invdate
	ld_invdate = datetime(date("12/12/1998"), time("00:00:00"))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		li_salecategory = this.ii_salecategory
	else
		li_salecategory = this.ii_saletype
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate)

// w_inpatientservice.wf_retrievelist() returns long
	string[] ls_posted
	integer li_salecategory
	integer li_invforlastdays = -10
	datetime ld_invdate
	ld_invdate = datetime(relativedate(today(), li_invforlastdays))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		li_salecategory = this.ii_salecategory
	else
		li_salecategory = this.ii_saletype
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate)

// w_inpatientservice.wf_updatesaleprice(long al_icode, double ad_saleprice) returns integer
	SQL update Item SET saleprice =:ad_saleprice WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_inpatientservice.wf_selectitembatches(long al_gcode, long al_icode, long al_qty, ref datawindow ad_itemsdetail, ref long al_rowscount, ref string al_errortext) returns integer
	datastore lds_itemstockinfo
	long ll_counter
	long ll_saleqty
	long ll_reqqty
	long ll_totalstock
	long ll_batchqty
	long ll_detailrowcount
	boolean lb_flag
	integer li_errcode = 1
	lds_itemstockinfo = create datastore
	lds_itemstockinfo.dataobject = "d_itemstockinfo"
	lds_itemstockinfo.settransobject(this.it_transobject)
	if lds_itemstockinfo.retrieve(al_gcode, al_icode) > 0 then
		ll_totalstock = lds_itemstockinfo.getitemnumber(1, "c_totalstock")
		if ll_totalstock >= al_qty then
			ll_reqqty = al_qty
			ll_detailrowcount = ad_itemsdetail.rowcount()
			ll_counter = 1
			do while ll_counter <= lds_itemstockinfo.rowcount() and not lb_flag
				ll_batchqty = lds_itemstockinfo.getitemnumber(ll_counter, "currqty")
				if ll_batchqty >= ll_reqqty then
					ll_saleqty = ll_reqqty
					lb_flag = true
				else
					ll_saleqty = ll_batchqty
					ll_reqqty = ll_reqqty - ll_batchqty
				end if
				ad_itemsdetail.insertrow(0)
				ll_detailrowcount = ll_detailrowcount + 1
				ad_itemsdetail.setitem(ll_detailrowcount, "gcode", al_gcode)
				ad_itemsdetail.setitem(ll_detailrowcount, "icode", al_icode)
				ad_itemsdetail.setitem(ll_detailrowcount, "batch", lds_itemstockinfo.getitemstring(ll_counter, "batch"))
				ad_itemsdetail.setitem(ll_detailrowcount, "expiry", lds_itemstockinfo.getitemdatetime(ll_counter, "expiry"))
				ad_itemsdetail.setitem(ll_detailrowcount, "stock", ll_batchqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "totalstock", ll_totalstock)
				ad_itemsdetail.setitem(ll_detailrowcount, "looseqty", ll_saleqty)
				ll_counter = ll_counter + 1
			loop
			al_rowscount = ll_counter - 1
		else
			li_errcode = 1
			al_rowscount = ll_totalstock
			al_errortext = "Stock has been decreased for this item   "
		end if
	else
		li_errcode = 1
		al_rowscount = ll_totalstock
		al_errortext = "Stock does not exist for this item   "
	end if
	destroy lds_itemstockinfo
	return li_errcode

// w_inpatientservice.wf_validateitemnew() returns integer
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
		messagebox(ls_titleerrtext, ls_errtext)
	elseif not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		ls_titleerrtext = "Item Validation"
		li_errcode = -2
	end if
	this.ib_itemvalidated = true
	return li_errcode

// w_inpatientservice.wf_validategodown() returns integer
	long ll_icode
	long ll_gcode
	long ll_stock
	long ll_counter
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	string ls_null
	integer li_errcode = 1
	integer li_null
	integer li_option
	integer li_duperr
	boolean ib_due
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	this.ii_defaultgcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	if wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			if isnull(this.id_detail.getitemstring(this.il_currrow, "due")) then
				li_errcode = -1
			end if
		else
			for ll_counter = 1 to this.id_detail.rowcount()
				if this.il_currrow <> ll_counter and (ll_icode = this.id_detail.getitemnumber(ll_counter, "icode") and this.ii_defaultgcode = this.id_detail.getitemnumber(ll_counter, "gcode")) then
					li_duperr = -2
				end if
			next
		end if
	end if
	this.ib_godownvalidated = true
	if li_errcode = -1 and not ib_due then
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		this.id_detail.setfocus()
		this.id_detail.setcolumn("gcode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
	end if
	if li_duperr = -2 and not ib_due then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate Item, please select some other item"
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
		this.ib_itemslistopen = true
		this.id_itemslist.show()
		li_errcode = -1
	end if
	return li_errcode

// w_inpatientservice.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean lb_rtflag = true
	boolean ib_due
	integer li_null
	string ls_null
	ls_titleerrtext = "Item Validation"
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), al_currrow) = true then
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
	elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			li_option = messagebox("Item Validation", "Item stock does not exist~n~rDo You want to due this item", information!, yesno!, 2)
			if li_option = 1 then
				this.id_detail.setitem(this.il_currrow, "looseqty", 1)
				this.id_detail.setitem(this.il_currrow, "dueqty", 1)
				ib_due = true
			else
				li_errcode = -1
			end if
		end if
	else
		li_errcode = -1
		ls_titleerrtext = "Item Validation"
	end if
	if li_errcode = -1 and not ib_due then
		lb_rtflag = false
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setitem(al_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(al_currrow, "icode", li_null)
		this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	end if
	return lb_rtflag

// w_inpatientservice.wf_setgodownoption() returns 0
	this.ii_defaultgcode = f_numberpreferences("defaultgcode")
	this.ii_salegodown = f_numberpreferences("salegodownoption")
	if this.ii_salegodown = 2 or this.ii_salegodown = 1 then
		this.id_detail.modify("gcode" + ".Protect=1")
		this.id_detail.object.gcode.background.color = rgb(255, 255, 255)
	end if

// w_inpatientservice.wf_visible(boolean ab_flag) returns 0

// w_inpatientservice.wf_returnsaleinvoice(long al_invid, ref string as_errtext) returns boolean
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_looseqty
	long ll_stock
	long ll_newstock
	long ll_counter = 1
	long ll_detailrows
	string ls_batch
	string ls_due
	datetime ld_expiry
	boolean lb_commitflag = true
	double ld_avgprice
	if lb_commitflag then
		if wf_deleteserviceinvoice(al_invid) <> 0 then
			lb_commitflag = false
			as_errtext = "    Some database problem occur"
		end if
	else
		as_errtext = "    Some database problem occur"
	end if
	return lb_commitflag

// w_inpatientservice.wf_findfullcode(string as_fullcode, ref long al_icode, ref string al_itemname) returns integer
	integer ll_icode
	integer ll_retflag
	string ls_itemname
	SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_inpatientservice.wf_validateitem(boolean ab_flag) returns integer
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	integer li_option
	boolean ib_due
	integer li_null
	string ls_null
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if not isnull(ll_icode) then
		wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext)
	end if
	if ab_flag then
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		ls_titleerrtext = "Service Validation"
		messagebox(ls_titleerrtext, ls_errtext)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
	end if
	return li_errcode

// w_inpatientservice.wf_newcustomer() returns integer
	s_saletemplate lstr_template
	long ll_custcode
	open(w_popup_customer)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = true and this.ii_servicetype = 11 then
		event ue_refreshddw()
		ll_custcode = lstr_template.l_invtemplate
		this.id_master.setitem(this.id_master.getrow(), "custcode", ll_custcode)
	end if
	return 1

// w_inpatientservice.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_inpatientservice.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_customerbalance
	double ld_cashreceived
	double ld_serviceflattax
	double ld_servicegstperc
	double ld_sumitemleveltaxval
	double ld_suminvleveltaxval
	double ld_totaltaxoninv
	real lr_discperc
	real lr_flatdisc
	real lr_serviceinvgstperc
	real lr_misccharges
	real lr_salestax
	real lr_itemstotal
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		lr_discperc = this.id_footer.object.invdiscperc[1]
		lr_flatdisc = this.id_footer.object.flatdisc[1]
		lr_misccharges = this.id_footer.object.misccharges[1]
		lr_serviceinvgstperc = this.id_footer.object.serviceinvgstperc[1]
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
		ld_grandtotal = ld_detaildwtotal * (1.0 - lr_discperc * 0.01) - lr_flatdisc + lr_misccharges + lr_salestax
		ld_sumitemleveltaxval = this.id_detail.getitemnumber(1, "c_sumflattaxval") + this.id_detail.getitemnumber(1, "c_sumgstval")
		ld_suminvleveltaxval = round((ld_detaildwtotal * (1.0 - lr_discperc * 0.01) - lr_flatdisc) * 0.01 * lr_serviceinvgstperc, 2)
		ld_totaltaxoninv = round(ld_sumitemleveltaxval + ld_suminvleveltaxval, 0)
		ld_grandtotal = round(ld_grandtotal, 0)
		ld_grandtotal = ld_grandtotal + ld_totaltaxoninv
		this.id_footer.setitem(1, "total", ld_grandtotal)
		if this.ii_servicetype = 10 then
			this.id_footer.setitem(1, "balance", ld_grandtotal)
		else
			ld_customerbalance = this.id_master.object.customerbalance[1]
			if isnull(ld_customerbalance) then
				ld_customerbalance = 0
			end if
			ld_cashreceived = ld_grandtotal + ld_customerbalance
			this.id_footer.setitem(1, "balance", ld_cashreceived)
		end if
	end if
	return ld_grandtotal

// w_inpatientservice.wf_closelist() returns 0
	this.ib_itemslistopen = false
	this.id_itemslist.hide()

// w_inpatientservice.wf_customerinfo(long al_custcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	double ld_currbalance
	SQL SELECT customer.address1 , customer.city , customer.phone INTO :ls_address, :ls_city, :ls_phone FROM customer WHERE customer.custcode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
		this.id_master.object.address[ll_currow] = ls_address
		this.id_master.object.city[ll_currow] = ls_city
		this.id_master.object.phone[ll_currow] = ls_phone
	end if
	return this.it_transobject.sqlcode

// w_inpatientservice.wf_deleteserviceinvoice(long al_serviceinvcode) returns integer
	SQL Delete Servicedetail Where Servicedetail.ServiceInvCode =:al_serviceinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_inpatientservice.wf_dueitem() returns 0

// w_inpatientservice.wf_editquotation() returns integer
	datastore lds_quotationdetail
	datastore lds_quotationheader
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	integer li_retcode = 1
	integer li_errcode
	string ls_errortext
	lds_quotationdetail = create datastore
	lds_quotationheader = create datastore
	open(w_editquotationform)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_quotationdetail.dataobject = "d_quotationdetail"
		lds_quotationdetail.settransobject(this.it_transobject)
		lds_quotationheader.dataobject = "d_quotationheader"
		lds_quotationheader.settransobject(this.it_transobject)
		ll_row = lds_quotationheader.retrieve(lstr_template.l_invtemplate)
		lds_quotationdetail.retrieve(lstr_template.l_invtemplate)
		ll_totalrows = lds_quotationheader.retrieve(lstr_template.l_invtemplate)
		if ll_row < 0 then
			li_retcode = -1
		end if
		ll_mrow = this.id_master.getrow()
		this.id_master.setitem(ll_mrow, "quotationno", lstr_template.l_invtemplate)
		this.id_master.setitem(ll_mrow, "custcode", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "custcode"))
		this.id_master.setitem(ll_mrow, "sprice", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "sprice"))
		this.id_master.setitem(ll_mrow, "remarks", lds_quotationheader.getitemstring(lds_quotationheader.getrow(), "remarks"))
		this.id_master.setitem(ll_mrow, "headerno", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "headerno"))
		this.id_footer.setitem(ll_mrow, "misccharges", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "misccharges"))
		this.id_footer.setitem(ll_mrow, "invdiscperc", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "discperc"))
		this.id_footer.setitem(ll_mrow, "flatdisc", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "flatdisc"))
		ll_totalrows = lds_quotationdetail.rowcount()
		this.id_detail.reset()
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_quotationdetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "packunits", lds_quotationdetail.getitemnumber(ll_rowcount, "packunits"))
			this.id_detail.setitem(ll_rowcount, "discperc", lds_quotationdetail.getitemnumber(ll_rowcount, "discperc"))
			this.id_detail.setitem(ll_rowcount, "saleprice", lds_quotationdetail.getitemnumber(ll_rowcount, "saleprice"))
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_quotationdetail.getitemnumber(ll_rowcount, "looseqty"))
		next
	end if
	return li_retcode

// w_inpatientservice.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_inpatientservice.wf_genfullcode(long al_icode, ref string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	long iccode
	long icatcode
	long packcode
	long manfcode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_inpatientservice.wf_getitemassociategcode(long la_icode) returns integer
	integer li_gcode
	SQL Select Gcode INTO :li_gcode From item Where icode =:la_icode USING this.it_transobject;
	return li_gcode

// w_inpatientservice.wf_inititeminfo(long al_icode, long al_row, ref integer ai_rtcode, ref string as_errortext) returns boolean
	boolean retflag = true
	boolean lb_continue = true
	double ld_saleprice
	double ld_discperc
	double ld_commission
	double ld_costprice
	double ld_policy_price
	double ld_flatdisc
	double ld_serviceflattax
	double ld_servicegstperc
	double ld_shareperc
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_allowsaleindecimal
	datetime ldt_date
	datetime ldt_deliverydate
	datetime ldt_dt
	datetime ldt_dt2
	datetime ldt_dt3
	datetime ldt_today
	char lc_lockprice = "N"
	char lc_lockdiscperc = "N"
	char lc_lockserviceflatdisc = "N"
	setnull(ls_null)
	SQL SELECT service.aliasname , service.name , service.price , service.commission , service.costprice , dt =DATEADD ( mi , processmin , DATEADD ( hh , processhours , DATEADD ( dd , processdays , GETDATE ( ) ) ) ) , dt2 =( SELECT CAST ( convert ( varchar ( 100 ) , getdate ( ) , 111 ) + ' ' + convert ( varchar ( 100 ) , ISNULL ( ServiceDeliveryTime , CAST ( '1900-01-01 00:00:00' AS DATETIME ) ) , 108 ) AS DATETIME ) FROM Groups WHERE GroupCode =:this.il_groupcode ) , dt3 =( SELECT CAST ( convert ( varchar ( 100 ) , getdate ( ) + 1 , 111 ) + ' ' + convert ( varchar ( 100 ) , ISNULL ( ServiceDeliveryTime , CAST ( '1900-01-01 00:00:00' AS DATETIME ) ) , 108 ) AS DATETIME ) FROM Groups WHERE GroupCode =:this.il_groupcode ) , Today =( SELECT GETDATE ( ) FROM Groups WHERE GroupCode =:this.il_groupcode ) , ServiceFlatDisc , AllowSaleInDecimal , LockPrice , LockDiscPerc , LockServiceFlatDisc , ServiceFlatTax , ServiceGSTPerc , SharePerc INTO :ls_fullcode, :ls_name, :ld_saleprice, :ld_commission, :ld_costprice, :ldt_dt, :ldt_dt2, :ldt_dt3, :ldt_today, :ld_flatdisc, :ls_allowsaleindecimal, :lc_lockprice, :lc_lockdiscperc, :lc_lockserviceflatdisc, :ld_serviceflattax, :ld_servicegstperc, :ld_shareperc FROM service WHERE service.servicecode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		ai_rtcode = -1
		retflag = false
		as_errortext = "Database Error: Service information can not be retrieved"
	end if
	if retflag then
		if f_stringpreferences("FetchServiceDeliveryDateFrom") = "S" then
			ldt_deliverydate = ldt_dt
		elseif ldt_dt2 > ldt_today then
			ldt_deliverydate = ldt_dt2
		else
			ldt_deliverydate = ldt_dt3
		end if
		if f_stringpreferences("FetchServicePriceFromPricePolicy") = "Y" then
			ld_policy_price = 0
			this.it_transobject.getpricefromservicepricepolicy(al_icode, ld_policy_price)
			if this.it_transobject.sqlcode = 0 then
				ld_saleprice = ld_policy_price
			else
				messagebox("Price Policy Implementation", "Some Problem Occured while fetching Service Price Policy details~r~n" + this.it_transobject.sqlerrtext, stopsign!)
				ai_rtcode = -1
				lb_continue = false
			end if
		end if
		if lb_continue then
			this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
			this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
			this.id_detail.setitem(al_row, "allowsaleindecimal", ls_allowsaleindecimal)
			if this.id_detail.getitemstatus(al_row, "saleprice", primary!) = new! or this.id_detail.getitemstatus(al_row, "saleprice", primary!) = notmodified! then
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
				this.id_detail.setitem(al_row, "commission", ld_commission)
				this.id_detail.setitem(al_row, "deliverydate", ldt_deliverydate)
				this.id_detail.setitem(al_row, "serviceflatdisc", ld_flatdisc)
				this.id_detail.setitem(al_row, "serviceflattax", ld_serviceflattax)
				this.id_detail.setitem(al_row, "servicegstperc", ld_servicegstperc)
				this.id_detail.setitem(al_row, "SharePerc", ld_shareperc)
			end if
			if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
				this.id_detail.setitem(al_row, "commission", ld_commission)
				this.id_detail.setitem(al_row, "deliverydate", ldt_deliverydate)
				this.id_detail.setitem(al_row, "serviceflatdisc", ld_flatdisc)
				this.id_detail.setitem(al_row, "serviceflattax", ld_serviceflattax)
				this.id_detail.setitem(al_row, "servicegstperc", ld_servicegstperc)
				this.id_detail.setitem(al_row, "SharePerc", ld_shareperc)
			end if
			this.id_detail.setitem(al_row, "itemcode", al_icode)
			this.id_detail.setitem(al_row, "costprice", ld_costprice)
			this.id_detail.setitem(al_row, "icode", al_icode)
			this.id_detail.setitem(al_row, "lockprice", lc_lockprice)
			this.id_detail.setitem(al_row, "lockdiscperc", lc_lockdiscperc)
			this.id_detail.setitem(al_row, "lockserviceflatdisc", lc_lockserviceflatdisc)
			ai_rtcode = 0
		end if
	end if
	return retflag

// w_inpatientservice.wf_initmodify(ref integer ai_protect) returns 0
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_looseqty
	long ll_stock
	long ll_counter = 1
	long ll_count
	if this.id_master.getitemstring(1, "posted") = "N" and ai_protect = 0 then
		this.ib_modify = true
		this.editflag = true
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_new.enabled = false
		this.im_menu.m_file.m_delete.enabled = false
		this.im_menu.m_item.m_newitem.enabled = true
		this.im_menu.m_item.m_deleteitem.enabled = true
		this.im_menu.m_file.m_first.enabled = false
		this.im_menu.m_file.m_next.enabled = false
		this.im_menu.m_file.m_previous.enabled = false
		this.im_menu.m_file.m_last.enabled = false
		this.im_menu.m_file.m_retrieve.enabled = true
		this.im_menu.m_file.m_retrieve.text = "Lis&t"
		this.tab_retrieve.tabpage_detail.enabled = true
	end if

// w_inpatientservice.wf_locksaleinvoice(long al_saleinvcode) returns integer
	integer li_count
	this.it_transobject.dbparm = " Async =1, DBGetTime = 20"
	this.it_transobject.locksaleinvoice(al_saleinvcode)
	this.it_transobject.dbparm = "Async =0, DBGetTime = 0"
	return this.it_transobject.sqlcode

// w_inpatientservice.wf_locksaleinvoices(long al_sinvcode, long al_linvcode, ref long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From saleledger WITH ( UPDLOCK HOLDLOCK ) Where saleledger.saleinvcode Between :al_sinvcode AND :al_linvcode AND saleledger.Posted ='N' USING sqlca;
	return sqlca.sqlcode

// w_inpatientservice.wf_lockserviceinvoices(long al_sinvcode, long al_linvcode, ref long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From ServiceHeader WITH ( UPDLOCK HOLDLOCK ) Where ServiceHeader.Serviceinvcode Between :al_sinvcode AND :al_linvcode AND ServiceHeader.Posted ='N' AND ServiceHeader.AdmissionCode IS NOT NULL USING sqlca;
	return sqlca.sqlcode

// w_inpatientservice.wf_findpatientcode(long al_admissioncode) returns long
	long ll_patientcode
	SQL SELECT PatientCode INTO :ll_patientcode FROM PatientAdmission WHERE AdmissionCode =:al_admissioncode USING this.it_transobject;
	return ll_patientcode

// w_inpatientservice.wf_selectprintreport() returns string
	string ls_pagesize
	string ls_report
	ls_pagesize = f_stringpreferences("pagesize")
	if ls_pagesize = "Q" and this.ii_saletype = 3 then
		if gs_company = "FZ" or gs_company = "CMH" or gs_company = "FZGUL" then
			ls_report = "d_retailsaleinvreport"
		elseif gs_company = "SHE" then
			ls_report = "d_shee_retailsaleinvreport"
		else
			ls_report = "d_retailsaleinvreportwh"
		end if
	elseif ls_pagesize = "Q" and this.ii_saletype = 2 then
		if gs_company = "FZ" or gs_company = "CMH" or gs_company = "FZGUL" then
			ls_report = "d_wholesaleinvreport"
		elseif gs_company = "SHE" then
			ls_report = "d_shee_wholesaleinvreport"
		else
			ls_report = "d_wholesaleinvreportwh"
		end if
	elseif ls_pagesize = "F" and this.ii_saletype = 3 then
		if gs_company = "SA" then
			ls_report = "d_sa_retailsaleinvreport_full"
		else
			ls_report = "d_retailsaleinvreport_full"
		end if
	elseif ls_pagesize = "F" and this.ii_saletype = 2 then
		if gs_company = "SA" then
			ls_report = "d_sa_wholesaleinvreport_full"
		else
			ls_report = "d_wholesaleinvreport_full"
		end if
	else
		ls_report = "d_retailsaleinvreport_full"
	end if
	this.id_print.dataobject = ls_report
	this.id_print.settransobject(this.it_transobject)
	return ls_report

// w_inpatientservice.wf_populatesaledetail(long al_invid, ref datawindow ad_saledetail, ref string as_errortext, ref long al_errorrow) returns boolean
	long ll_detailrows
	long ll_stock
	long ll_newstock
	long ll_gcode
	long ll_icode
	long ll_salelooseqty
	long ll_dueqty
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode = 1
	long li_counter
	long li_innercounter
	long ll_insertedrows
	long ll_looseqty
	long ll_itemsdetailrowcount
	long ll_row
	long ll_itemflatdisc
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	boolean lb_commitflag = true
	string ls_batch
	string ls_updatesaleprice
	string ls_updsaleprice
	string ls_saleitemdescription
	datetime ld_expiry
	dwitemstatus ldws_column
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	ll_itemsdetailrowcount = 0
	ls_updatesaleprice = f_stringpreferences("updatesaleprice")
	as_errortext = "    Some database problem ocuurs         "
	do while li_counter <= ll_detailrows and lb_commitflag
		ll_gcode = this.id_detail.getitemnumber(li_counter, "gcode")
		ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
		ll_salelooseqty = this.id_detail.getitemnumber(li_counter, "looseqty")
		ll_dueqty = this.id_detail.getitemnumber(li_counter, "dueqty")
		ll_packunits = this.id_detail.getitemnumber(li_counter, "packunits")
		ld_saleprice = this.id_detail.getitemnumber(li_counter, "saleprice")
		ld_discperc = this.id_detail.getitemnumber(li_counter, "discperc")
		ld_rate = this.id_detail.getitemnumber(li_counter, "rate")
		ll_itemflatdisc = this.id_detail.getitemnumber(li_counter, "itemflatdisc")
		ls_saleitemdescription = this.id_detail.getitemstring(li_counter, "saleitemdescription")
		ldws_column = this.id_detail.getitemstatus(li_counter, "saleprice", primary!)
		ls_updsaleprice = this.id_detail.getitemstring(li_counter, "updatesaleprice")
		ll_salelooseqty = ll_salelooseqty - ll_dueqty
		this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			if ll_salelooseqty > 0 and lb_commitflag then
				if wf_selectitembatches(ll_gcode, ll_icode, ll_salelooseqty, ad_saledetail, ll_insertedrows, as_errortext) = 0 then
					for li_innercounter = 1 to ll_insertedrows
						ll_row = ll_itemsdetailrowcount + li_innercounter
						ad_saledetail.setitem(ll_row, "code", al_invid)
						ad_saledetail.setitem(ll_row, "packunits", ll_packunits)
						ad_saledetail.setitem(ll_row, "saleprice", ld_saleprice)
						ad_saledetail.setitem(ll_row, "discperc", ld_discperc)
						ad_saledetail.setitem(ll_row, "rate", ld_rate)
						ad_saledetail.setitem(ll_row, "avgprice", ld_avgprice)
						ad_saledetail.setitem(ll_row, "itemflatdisc", ll_itemflatdisc)
						ad_saledetail.setitem(ll_row, "saleitemdescription", ls_saleitemdescription)
						ls_batch = ad_saledetail.getitemstring(ll_row, "batch")
						ld_expiry = ad_saledetail.getitemdatetime(ll_row, "expiry")
						ll_looseqty = ad_saledetail.getitemnumber(ll_row, "looseqty")
						ll_stock = ad_saledetail.getitemnumber(ll_row, "stock")
						ll_newstock = ll_stock - ll_looseqty
						if ll_newstock > 0 then
							this.it_transobject.saleupdateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ll_newstock, ll_stock)
						else
							this.it_transobject.deleteitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ll_stock)
						end if
						if this.it_transobject.sqlcode <> 0 then
							lb_commitflag = false
							as_errortext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
						end if
					next
					ll_itemsdetailrowcount = ll_itemsdetailrowcount + ll_insertedrows
				else
					this.id_detail.setitem(li_counter, "stock", ll_insertedrows)
					lb_commitflag = false
				end if
			end if
			if ll_dueqty > 0 and lb_commitflag then
				ll_itemsdetailrowcount = ll_itemsdetailrowcount + 1
				ad_saledetail.insertrow(0)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "gcode", ll_gcode)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "icode", ll_icode)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "batch", "Due")
				ad_saledetail.setitem(ll_itemsdetailrowcount, "expiry", relativedate(today(), 365))
				ad_saledetail.setitem(ll_itemsdetailrowcount, "stock", ll_stock)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "totalstock", 0)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "looseqty", ll_dueqty)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "due", "D")
				ad_saledetail.setitem(ll_itemsdetailrowcount, "code", al_invid)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "packunits", ll_packunits)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "saleprice", ld_saleprice)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "discperc", ld_discperc)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "rate", ld_rate)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "avgprice", ld_avgprice)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "itemflatdisc", ll_itemflatdisc)
			end if
		else
			lb_commitflag = false
		end if
		li_counter = li_counter + 1
	loop
	if not lb_commitflag then
		al_errorrow = li_counter - 1
		messagebox("Database Error", as_errortext)
	end if
	return lb_commitflag

// w_inpatientservice.wf_setadmissiondetails(long al_admissioncode) returns long
	long ll_retflag
	long ll_doctcode
	long ll_locationcode
	long ll_patientcode
	SQL SELECT patientadmission.doctorcode , patientadmission.locationcode , patientcode INTO :ll_doctcode, :ll_locationcode, :ll_patientcode FROM patientadmission WHERE patientadmission.Admissioncode =:al_admissioncode AND patientadmission.discharged1 ='N' and patientadmission.discharged ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.object.doctcode[this.id_master.getrow()] = ll_doctcode
		this.id_master.object.locationcode[this.id_master.getrow()] = ll_locationcode
		ll_retflag = 1
		wf_set_patientbalance(ll_patientcode)
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_inpatientservice.wf_generatecashreceipt(ref datetime adt_server_datetime, long al_custcode, double ad_totalcashreceived, integer ai_salesmancode, long al_invid, long al_patientcode) returns integer
	long ll_vochcode
	long ll_glvochcode
	long ll_null
	long ll_cashacc
	long ll_modifiedby
	long ll_postedby
	string ls_null
	string ls_remarks
	string ls_posted = "Y"
	long ll_vouchercatcode = 2
	datetime ldt_datetime
	double ld_zerovalue
	setnull(ll_null)
	setnull(ll_modifiedby)
	setnull(ls_null)
	ls_remarks = "Cash Receipt on Credit Service #: " + string(al_invid)
	ll_postedby = ai_salesmancode
	ldt_datetime = adt_server_datetime
	if ad_totalcashreceived > 0.0 then
		this.it_transobject.getglobalcode("GT_CashAcc", ll_cashacc)
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Auto CashReceipt Generation Error", "Unable to find Cash Account while generating auto cash receipt.")
			return -1
		end if
		this.it_transobject.createvoucher(ll_vouchercatcode, ll_cashacc, ldt_datetime, ai_salesmancode, "Y", ldt_datetime, ls_remarks, ldt_datetime, ll_modifiedby, ll_postedby, ls_null, ll_cashacc, al_custcode, ad_totalcashreceived, ls_null, ls_remarks, ll_null, al_patientcode, ll_null, ll_null, ld_zerovalue, ld_zerovalue, ll_glvochcode, ll_vochcode, ll_null)
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Auto CashReceipt Generation Error", "Reasons are:~r~n" + this.it_transobject.sqlerrtext)
			return -1
		end if
		return
	end if
	return 0

// w_inpatientservice.wf_post() returns integer
	integer li_postingmode = 1
	long ll_sinvcode
	long ll_linvcode
	long ll_found
	if this.tab_retrieve.selectedtab = 1 then
		return 0
	end if
	setnull(ll_sinvcode)
	setnull(ll_linvcode)
	ll_found = 0
	if this.ii_servicetype = 10 then
		ll_found = gds_securitywindow.find("rightcode = 715", 1, gds_securitywindow.rowcount())
	else
		ll_found = gds_securitywindow.find("rightcode = 716", 1, gds_securitywindow.rowcount())
	end if
	if ll_found <= 0 then
		messagebox("Service Invoice Posting", "Not Enough rights to post service invoice")
		return -1
	end if
	return wf_post_service_patientadmission(li_postingmode, ll_sinvcode, ll_linvcode)

// w_inpatientservice.wf_admitted(long al_admissioncode) returns long
	long ll_count
	SQL SELECT Count ( *) INTO :ll_count FROM PatientAdmission WHERE PatientAdmission.AdmissionCode =:al_admissioncode AND PatientAdmission.Discharged ='N' AND PatientAdmission.Discharged1 ='N' USING sqlca;
	return ll_count

// w_inpatientservice.wf_copyinvoice() returns integer
	datastore lds_servicedetail
	datastore lds_serviceheader
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrows
	long ll_srvorowid
	long ll_currentrow
	integer li_retcode = 1
	integer li_errcode
	integer li_looseqty
	integer li_counter
	integer ll_found
	integer ll_innercounter
	integer li_holdqty
	integer li_holdbonusqty
	string ls_errortext
	string ls_remarks
	boolean lb_isitemexists
	boolean lb_enablesave
	boolean lb_bonus
	long[] lla_detailrows
	long ll_custcode
	long ll_currrow
	long ll_counter
	long ll_customerbalance
	if this.id_master.rowcount() < 1 then
		return 1
	elseif this.id_master.getitemstring(1, "posted") = "Y" and not isnull(this.id_master.getitemnumber(1, "code")) then
		return 1
	end if
	lds_servicedetail = create datastore
	open(w_copyserviceinvoicefrom)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		destroy lds_servicedetail
		return -1
	end if
	if lstr_template.c_copyinvfrom = "O" then
		lds_servicedetail.dataobject = "d_copy_serviceorderdetail"
		lds_servicedetail.settransobject(this.it_transobject)
		lla_detailrows = lstr_template.l_detailrows
		for li_counter = this.id_detail.rowcount() to 1 step -1
			event ue_deleteitem()
		next
		ll_totalrows = upperbound(lstr_template.l_detailrows)
		for ll_rowcount = 1 to ll_totalrows
			ll_srvorowid = lla_detailrows[ll_rowcount]
			if ll_rowcount = 1 then
				SQL Select ServiceOHeader.custcode , ServiceOHeader.Remarks INTO :ll_custcode, :ls_remarks From ServiceOHeader , ServiceODetail Where ServiceODetail.SrvORowId =:ll_srvorowid AND ServiceOHeader.ServiceOCode =ServiceODetail.ServiceOCode USING sqlca;
				if sqlca.sqlcode = 0 then
					if this.ii_servicetype = 11 then
						this.id_master.setitem(this.id_master.getrow(), "custcode", ll_custcode)
					end if
				else
					messagebox("Customer Information", "Unable to fetch customer information")
				end if
			end if
			lds_servicedetail.retrieve(ll_srvorowid)
			ll_currentrow = lds_servicedetail.getrow()
			this.id_detail.insertrow(0)
			this.id_master.setitem(this.id_master.getrow(), "admissioncode", lds_servicedetail.getitemnumber(ll_currentrow, "admissioncode"))
			this.id_master.setitem(this.id_master.getrow(), "Remarks", ls_remarks)
			wf_setadmissiondetails(lds_servicedetail.getitemnumber(ll_currentrow, "admissioncode"))
			ll_icode = lds_servicedetail.getitemnumber(ll_currentrow, "servicecode")
			wf_inititeminfo(ll_icode, ll_rowcount, li_retcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "icode", lds_servicedetail.getitemnumber(ll_currentrow, "servicecode"))
			this.id_detail.setitem(ll_rowcount, "itemname", lds_servicedetail.getitemstring(ll_currentrow, "service"))
			this.id_detail.setitem(ll_rowcount, "smancode", lds_servicedetail.getitemnumber(ll_currentrow, "smancode"))
			this.id_detail.setitem(ll_rowcount, "qty", lds_servicedetail.getitemnumber(ll_currentrow, "qty"))
			this.id_detail.setitem(ll_rowcount, "saleprice", lds_servicedetail.getitemnumber(ll_currentrow, "price"))
			this.id_detail.setitem(ll_rowcount, "serviceflatdisc", lds_servicedetail.getitemnumber(ll_currentrow, "serviceflatdisc"))
			this.id_detail.setitem(ll_rowcount, "discperc", lds_servicedetail.getitemnumber(ll_currentrow, "discperc"))
			this.id_detail.setitem(ll_rowcount, "SrvORowId", lds_servicedetail.getitemnumber(ll_currentrow, "SrvORowId"))
			this.id_detail.setitem(ll_rowcount, "ServiceStatus", "Y")
		next
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
		if this.ii_servicetype = 11 and f_stringpreferences("InServiceCustomerBalance") = "Y" then
			ll_currrow = this.ids_customersbalance.getrow()
			for ll_counter = 1 to this.ids_customersbalance.rowcount()
				if this.ids_customersbalance.getitemnumber(ll_counter, "code1") = this.id_master.getitemnumber(ll_currrow, "custcode") then
					ll_customerbalance = this.ids_customersbalance.getitemnumber(ll_counter, "value1")
					this.id_master.setitem(ll_currrow, "customerbalance", ll_customerbalance)
					if ll_customerbalance > 0 then
						this.id_master.setitem(ll_currrow, "debitorcredit", "Dr")
					else
						this.id_master.setitem(ll_currrow, "debitorcredit", "Cr")
					end if
					exit
				else
					this.id_master.setitem(ll_currrow, "debitorcredit", "Cr")
					this.id_master.setitem(ll_currrow, "customerbalance", 0)
				end if
			next
		end if
		wf_grandtotal()
	end if
	destroy lds_servicedetail
	return li_retcode

// w_inpatientservice.wf_protect_saleprice() returns 0
	long ll_found
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 610", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_detail.object.saleprice.protect = 0
		return
	end if
	this.id_detail.object.saleprice.protect = 1

// w_inpatientservice.wf_select_service_printout() returns 0
	string ls_pagesize
	string ls_report
	boolean lb_listtab
	integer li_headerno
	if lb_listtab then
		li_headerno = this.id_list.getitemnumber(this.id_list.getrow(), "headerno")
	else
		li_headerno = this.id_master.getitemnumber(1, "headerno")
	end if
	if gs_company = "KHYBER" then
		ls_report = "d_khyber_inpatient_serviceinvrep_half"
	elseif gs_company = "FATIMAPHARMACY" then
		ls_report = "d_fatimapharmacy_inpatientserviceinvrep"
	elseif gs_company = "SURGICALCENTRE" then
		ls_report = "d_surgicalcentre_patientserviceinvrep"
	elseif gs_company = "FAISALMEMORIAL" then
		ls_report = "d_faisalmemorial_ipserviceinvrep_full"
	elseif gs_company = "HABIBMEDICAL" then
		ls_report = "d_habibmedical_ipserviceinvrep_half"
	elseif gs_company = "BRSHAFIQAHMAD" then
		ls_report = "d_brshafiqahmad_inpatientserviceprint"
	elseif gs_company = "BRSHAFIQHSP" then
		ls_report = "d_brshafiqhsp_inpatientserviceprint"
	elseif gs_company = "MEHARHSP" then
		ls_report = "d_meharhsp_inpatientserviceinvrep_f"
	end if
	if ls_report = "" then
		ls_report = this.id_print.dataobject
		if this.ii_servicetype = 11 then
			ls_pagesize = f_stringpreferences("creditservicepagesize")
			if ls_pagesize = "Q" then
				ls_report = "d_inpatientcreditserviceinvrep"
			elseif ls_pagesize = "H" then
				ls_report = "d_inpatient_serviceinvrep_half"
			elseif ls_pagesize = "F" then
				ls_report = "d_inpatient_serviceinvrep_full"
			elseif ls_pagesize = "T" then
				ls_report = "d_thermal_inpatientserviceprint"
			end if
		else
			ls_pagesize = f_stringpreferences("cashservicepagesize")
			if ls_pagesize = "Q" then
				ls_report = "d_inpatientserviceinvrep"
			elseif ls_pagesize = "H" then
				ls_report = "d_inpatient_serviceinvrep_half"
			elseif ls_pagesize = "F" then
				ls_report = "d_inpatient_serviceinvrep_full"
			elseif ls_pagesize = "T" then
				ls_report = "d_thermal_inpatientserviceprint"
			end if
		end if
	end if
	this.id_print.dataobject = ls_report
	f_set_headerlogo_service(this.id_print, li_headerno)

// w_inpatientservice.wf_editservicetemplate() returns long
	datastore lds_detail
	datastore lds_header
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	integer li_retcode = 1
	integer li_errcode
	string ls_errortext
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.rowcount() > 0 then
		if this.id_master.object.posted[1] = "Y" and this.id_master.object.code[1] > 0 then
			return 0
		end if
	else
		return 0
	end if
	lds_detail = create datastore
	lds_header = create datastore
	open(w_edit_servicetemplate)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_detail.dataobject = "d_servicetemplate_detail"
		lds_detail.settransobject(this.it_transobject)
		lds_header.dataobject = "d_servicetemplate_header"
		lds_header.settransobject(this.it_transobject)
		ll_row = lds_header.retrieve(lstr_template.l_invtemplate)
		lds_detail.retrieve(lstr_template.l_invtemplate)
		ll_totalrows = lds_header.retrieve(lstr_template.l_invtemplate)
		if ll_row < 0 or ll_totalrows < 0 then
			li_retcode = -1
			return -1
		else
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
		end if
		ll_mrow = this.id_master.getrow()
		ll_totalrows = lds_detail.rowcount()
		this.id_detail.reset()
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_detail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "qty", lds_detail.getitemnumber(ll_rowcount, "qty"))
			this.id_detail.setitem(ll_rowcount, "saleprice", lds_detail.getitemnumber(ll_rowcount, "saleprice"))
			this.id_detail.setitem(ll_rowcount, "serviceflatdisc", lds_detail.getitemnumber(ll_rowcount, "serviceflatdisc"))
			this.id_detail.setitem(ll_rowcount, "discperc", lds_detail.getitemnumber(ll_rowcount, "discperc"))
			this.id_detail.setitem(ll_rowcount, "smancode", lds_detail.getitemnumber(ll_rowcount, "smancode"))
		next
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	return li_retcode

// w_inpatientservice.wf_refreshitemslist_catwise() returns 0
	long ll_counter
	string ls_categories
	integer[] la_catcode
	s_arguements lstr_arg
	open(w_choose_servicecategory)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = -1 then
		return
	end if
	la_catcode = lstr_arg.ia_integerlist
	ls_categories = ""
	for ll_counter = 1 to upperbound(la_catcode)
		ls_categories = ls_categories + string(la_catcode[ll_counter]) + " , "
	next
	ls_categories = ls_categories + " 0 "
	f_retrieve_servicelist(this.id_itemslist, this.it_transobject)
	this.id_itemslist.setfilter("servicecatcode In (" + ls_categories + ")")
	this.id_itemslist.filter()

// w_inpatientservice.wf_refreshitemslist_itemname() returns 0
	s_popup_selection lstr_selection
	long ll_counter
	boolean lb_enablerestricted
	string ls_selection
	integer[] la_catcode
	open(w_popup_itemsearchcriteriaselection)
	lstr_selection = message.powerobjectparm
	if lstr_selection.l_code > 0 then
		ls_selection = lstr_selection.s_name2
		this.id_itemslist.reset()
		this.id_itemslist.setfilter("")
		this.id_itemslist.filter()
		f_retrieve_servicelist(this.id_itemslist, this.it_transobject)
		this.id_itemslist.setfilter("itemname LIKE '" + ls_selection + "'")
		this.id_itemslist.filter()
	end if

// w_inpatientservice.wf_assign_master_cash_win_object() returns 0
	this.ids_cashwin = create u_ds_standard
	this.ids_cashwin.dataobject = "d_mastercashierwindow_detail"
	this.ids_cashwin.settransobject(this.it_transobject)

// w_inpatientservice.wf_set_cashaccount() returns long
	long ll_cashacccode
	long ll_module
	long ll_code
	ll_module = 27
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = f_is_group_module_cashaccount_allowed(this.il_groupcode, ll_module)
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		ll_cashacccode = 0
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
	elseif isnull(ll_code) or this.id_master.object.code[1] <= 0 then
		this.id_master.object.cashacccode[this.id_master.rowcount()] = ll_cashacccode
	else
		ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	end if
	return ll_cashacccode

// w_inpatientservice.wf_show_mastercashierwindow() returns long
	long ll_counter
	long ll_code
	long ll_row
	long ll_insrow
	long ll_module
	long ll_cashacccode
	double ld_tot_acc_amt
	s_mastercashwin_all lstr_values
	lstr_values.i_interfacecode = 8
	if f_stringpreferences("askmastercashwin_in_inpatientservice") = "N" then
		return 1
	end if
	ll_module = 27
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
		return 0
	end if
	lstr_values.l_doccode = ll_code
	lstr_values.s_doctype = this.is_doctype
	lstr_values.l_cashacccode = ll_cashacccode
	lstr_values.l_groupcode = this.il_groupcode
	lstr_values.l_module = ll_module
	lstr_values.d_netamt = wf_grandtotal()
	lstr_values.d_cashtendered = this.id_master.object.cashtendered[this.id_master.rowcount()]
	lstr_values.d_cashcharged = this.id_master.object.cashcharged[this.id_master.rowcount()]
	lstr_values.d_cashback = this.id_master.object.cashback[this.id_master.rowcount()]
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		lstr_values.l_acccode[ll_counter] = this.ids_cashwin.object.acccode[ll_counter]
		lstr_values.s_remarks[ll_counter] = this.ids_cashwin.object.remarks[ll_counter]
		lstr_values.d_amount[ll_counter] = this.ids_cashwin.object.amount[ll_counter]
		lstr_values.l_rowid[ll_counter] = this.ids_cashwin.object.rowid[ll_counter]
		ld_tot_acc_amt = ld_tot_acc_amt + this.ids_cashwin.object.amount[ll_counter]
	next
	if lstr_values.d_netamt >= lstr_values.d_cashcharged then
		lstr_values.d_docbalance = lstr_values.d_netamt - lstr_values.d_cashcharged - ld_tot_acc_amt
	else
		lstr_values.d_docbalance = 0
	end if
	for ll_counter = 1 to 100
		if lstr_values.l_rowid[ll_counter] <= 0 then
			lstr_values.l_rowid[ll_counter] = -1
		end if
	next
	openwithparm(w_mastercashierwindow, lstr_values)
	lstr_values = message.powerobjectparm
	if lstr_values.i_status = 1 then
		this.ids_cashwin.reset()
		ld_tot_acc_amt = 0
		for ll_counter = 1 to 100
			if lstr_values.l_acccode[ll_counter] > 0 and lstr_values.d_amount[ll_counter] > 0 and lstr_values.l_rowid[ll_counter] > 0 then
				ll_insrow = this.ids_cashwin.insertrow(0)
				this.ids_cashwin.object.documentcode[ll_insrow] = ll_code
				this.ids_cashwin.object.documenttype[ll_insrow] = this.is_doctype
				this.ids_cashwin.object.acccode[ll_insrow] = lstr_values.l_acccode[ll_counter]
				this.ids_cashwin.object.remarks[ll_insrow] = lstr_values.s_remarks[ll_counter]
				this.ids_cashwin.object.amount[ll_insrow] = lstr_values.d_amount[ll_counter]
				this.ids_cashwin.object.rowid[ll_insrow] = lstr_values.l_rowid[ll_counter]
			end if
		next
		this.id_master.object.cashacccode[this.id_master.rowcount()] = lstr_values.l_cashacccode
		this.id_master.object.cashtendered[this.id_master.rowcount()] = lstr_values.d_cashtendered
		this.id_master.object.cashcharged[this.id_master.rowcount()] = lstr_values.d_cashcharged
		this.id_master.object.cashback[this.id_master.rowcount()] = lstr_values.d_cashback
		this.id_master.object.cashreceived[this.id_master.rowcount()] = lstr_values.d_cashtendered
		return 1
	end if
	return 0

// w_inpatientservice.wf_update_mastercashierwindow(long al_code, string as_type) returns long
	long ll_counter
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		this.ids_cashwin.object.documentcode[ll_counter] = al_code
		this.ids_cashwin.object.documenttype[ll_counter] = as_type
		this.ids_cashwin.object.date[ll_counter] = this.id_master.object.date[1]
	next
	SQL DELETE DBO.MasterCashWin WHERE DocumentCode =:al_code AND DocumentType =:as_type USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if this.ids_cashwin.update() > 0 then
			return 0
		else
			return -1
		end if
		return
	end if
	return -1

// w_inpatientservice.wf_post_service_patientadmission(integer ai_postingmode, long al_startinginvcode, long al_endinginvcode) returns long
	integer li_errcode
	long ll_salesmancode
	long ll_invcount
	long ll_counter
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	if ai_postingmode = 1 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if ai_postingmode = 1 then
			open(w_arg_patientadmission_sinv_linv)
			lstr_arginfo = message.powerobjectparm
		else
			lstr_arginfo.l_code1 = al_startinginvcode
			lstr_arginfo.l_code2 = al_endinginvcode
			lstr_arginfo.l_code3 = this.id_master.getitemnumber(1, "admissioncode")
			lstr_arginfo.l_code4 = 1
			lstr_arginfo.i_status = 1
		end if
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			li_errcode = wf_lock_serviceinvoices_patientadmission(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_invcount)
			if li_errcode = 0 then
				this.it_transobject.postservice_patientadmissionwise(lstr_arginfo.l_code1, lstr_arginfo.l_code2, this.ii_servicetype, ll_salesmancode, lstr_arginfo.l_code3, lstr_arginfo.l_code4)
				if this.it_transobject.sqlcode <> 0 then
					li_errcode = this.it_transobject.sqlcode
					ls_msgtext = this.it_transobject.sqlerrtext
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				ls_msgtext = this.it_transobject.sqlerrtext
				li_errcode = this.it_transobject.sqlcode
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode))
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_invcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return li_errcode

// w_inpatientservice.wf_show_accountledger() returns long
	long ll_acccode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_acccode = this.id_master.object.custcode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_acccode = this.id_list.object.custcode[this.id_list.getrow()]
	end if
	if not isnull(ll_acccode) and ll_acccode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_account_ledger, ll_acccode)
	end if
	return 0

// w_inpatientservice.wf_show_patientledger() returns long
	long ll_patientcode
	long ll_admissioncode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_admissioncode = this.id_master.object.admissioncode[this.id_master.getrow()]
			SQL SELECT patientcode INTO :ll_patientcode FROM PatientAdmission WHERE AdmissionCode =:ll_admissioncode USING sqlca;
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_patientcode = this.id_list.object.patientcode[this.id_list.getrow()]
	end if
	if not isnull(ll_patientcode) and ll_patientcode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_patient_ledger, ll_patientcode)
	end if
	return 0

// w_inpatientservice.wf_show_inpatientbill() returns long
	long ll_admissioncode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_admissioncode = this.id_master.object.admissioncode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_admissioncode = this.id_list.object.admissioncode[this.id_list.getrow()]
	end if
	if not isnull(ll_admissioncode) and ll_admissioncode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_inpatient_bill, ll_admissioncode)
	end if
	return 0

// w_inpatientservice.wf_open_item_form_popup() returns 0
	openwithparm(w_patientadmission_form_popup, this, this)

// w_inpatientservice.wf_validate_admissioncode(long al_admissioncode) returns long
	long rt_code
	long ll_custcode
	long li_admissioncode
	long ll_null
	long ll_counter
	double ld_customerbalance
	string ls_result
	string ls_aliasname
	setnull(ll_null)
	if this.ii_servicetype = 11 then
		this.id_master.setitem(1, "patientregno", this.idc_patient.getitemstring(this.idc_patient.getrow(), "regno"))
		if isnull(al_admissioncode) then
			this.id_master.object.custcode.protect = 0
			this.id_master.object.aliasname.protect = 0
			this.id_master.setitem(1, "patientregno", "")
			this.id_master.setitem(1, "aliasname", "")
			this.id_master.setitem(1, "custcode", 0)
		else
			li_admissioncode = al_admissioncode
			SQL SELECT patient.custcode , patient.regno , accounts.aliasname INTO :ll_custcode, :ls_result, :ls_aliasname FROM patient , patientadmission , accounts WHERE patientadmission.discharged1 ='N' and patientadmission.discharged ='N' and patientadmission.admissioncode =:li_admissioncode and patient.patientcode =patientadmission.patientcode and patient.custcode =accounts.acccode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				this.id_master.setitem(1, "patientregno", ls_result)
				this.id_master.setitem(1, "aliasname", ls_aliasname)
				this.id_master.setitem(1, "custcode", ll_custcode)
				wf_setadmissiondetails(li_admissioncode)
				this.id_master.object.custcode.protect = 1
				this.id_master.object.aliasname.protect = 1
				if f_stringpreferences("InServiceCustomerBalance") = "Y" then
					for ll_counter = 1 to this.ids_customersbalance.rowcount()
						if this.ids_customersbalance.getitemnumber(ll_counter, "code1") = this.id_master.getitemnumber(1, "custcode") then
							ld_customerbalance = this.ids_customersbalance.getitemnumber(ll_counter, "value1")
							this.id_master.setitem(1, "customerbalance", ld_customerbalance)
							if ld_customerbalance > 0.0 then
								this.id_master.setitem(1, "debitorcredit", "Dr")
							else
								this.id_master.setitem(1, "debitorcredit", "Cr")
							end if
							exit
						else
							this.id_master.setitem(1, "debitorcredit", "Cr")
							this.id_master.setitem(1, "customerbalance", 0)
						end if
					next
				end if
			else
				messagebox("Patient Information", "Problem in retrieving corresponding customer")
				rt_code = 1
			end if
		end if
	end if
	return rt_code

// w_inpatientservice.wf_findadmissioncode(string as_regno, ref long ai_admissioncode) returns long
	long li_admissioncode
	long ll_retflag
	string ls_itemname
	SQL SELECT patientadmission.admissioncode INTO :li_admissioncode FROM patient , patientadmission WHERE patient.regno =:as_regno AND patient.patientcode =patientadmission.patientcode and patientadmission.discharged1 ='N' and patientadmission.discharged ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_admissioncode = li_admissioncode
		if isnull(ai_admissioncode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_inpatientservice.wf_findcustcode(ref long ai_custcode, string as_aliasname) returns long
	long li_custcode
	long ll_retflag
	string ls_itemname
	SQL SELECT accounts.acccode INTO :li_custcode FROM accounts , customer WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =customer.custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_custcode = li_custcode
		if isnull(ai_custcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_inpatientservice.wf_validate_price_discount_matters(long al_usercode) returns long
	long ll_masterrow
	long ll_servicecode
	long ll_counter
	double ld_discperc
	double ld_servicediscperclimit
	boolean lb_validdisc
	datastore lds_groupdiscinfo
	wf_grandtotal()
	lds_groupdiscinfo = create datastore
	lds_groupdiscinfo.dataobject = "d_groups_discount"
	lds_groupdiscinfo.settransobject(this.it_transobject)
	lds_groupdiscinfo.retrieve(al_usercode)
	lb_validdisc = false
	ll_masterrow = this.id_master.rowcount()
	for ll_counter = 1 to lds_groupdiscinfo.rowcount()
		ld_servicediscperclimit = lds_groupdiscinfo.getitemnumber(ll_counter, "servicediscperclimit")
	next
	for ll_counter = 1 to this.id_detail.rowcount()
		ll_servicecode = this.id_detail.getitemnumber(ll_counter, "icode")
		ld_discperc = this.id_detail.getitemnumber(ll_counter, "discperc")
		if ld_discperc > ld_servicediscperclimit then
			lb_validdisc = false
			exit
		else
			lb_validdisc = true
		end if
	next
	destroy lds_groupdiscinfo
	if lb_validdisc = false then
		messagebox("Disc% Validation ..", "Disc% is greater than your group permission~r~nGroup Discount % limit for Services is " + trim(string(ld_servicediscperclimit)) + "%~r~nPlease consult Administrator")
		this.id_detail.setfocus()
		this.id_detail.setrow(ll_counter)
		this.id_detail.setcolumn("discperc")
		return -1
	end if
	return 0

// w_inpatientservice.wf_checkservicecharges() returns boolean
	long ll_counter
	long ll_rowcount
	double ld_servicecharges
	double ld_costprice
	boolean lb_retflag = true
	string ls_allowzero_servicecharges
	string ls_belowcost_servicecharges
	ll_rowcount = this.id_detail.rowcount()
	ls_allowzero_servicecharges = upper(f_stringpreferences("allowzeroservicecharges"))
	ls_belowcost_servicecharges = upper(f_stringpreferences("allowservicechargesbelowcost"))
	for ll_counter = 1 to ll_rowcount
		ld_costprice = this.id_detail.object.costprice[ll_counter]
		ld_servicecharges = this.id_detail.object.saleprice[ll_counter]
		if ls_allowzero_servicecharges = "N" and ld_servicecharges <= 0.0 then
			messagebox("Service Charges Validation", "Service Charges Can not be zero or -ve~r~nPlease enter valid service charges", stopsign!)
			lb_retflag = false
			this.id_detail.setfocus()
			this.id_detail.setrow(ll_counter)
			this.id_detail.setcolumn("saleprice")
			return lb_retflag
		end if
		if ls_belowcost_servicecharges = "N" and ld_servicecharges < ld_costprice then
			messagebox("Service Charges Validation", "Service Charges Can not be less than Cost Price~r~nPlease enter valid service charges", stopsign!)
			lb_retflag = false
			this.id_detail.setfocus()
			this.id_detail.setrow(ll_counter)
			this.id_detail.setcolumn("saleprice")
			return lb_retflag
		end if
	next
	return lb_retflag

// w_inpatientservice.wf_apply_associated_doctor_tempate(integer ai_mode) returns long
	long ll_doctcode
	long ll_masterrow
	long ll_templatecode
	long ll_detailrows
	long ll_templateheaderrow
	long ll_templaterows
	long ll_found
	long ll_rowcount
	long ll_templatepackunits
	long ll_icode
	long ll_notfound_itemcount
	long ll_prefsetting = 1
	double ld_templateprice
	double ld_templatediscperc
	double ld_template_flatdisc
	double ld_template_shareperc
	double ld_templateqty
	double ld_qty
	double ld_commission
	string ls_msgtitle = "Doctor Associated Service Template"
	string ls_itemname
	string ls_msgdetail
	boolean lb_editsaleprice
	boolean lb_editsalediscperc
	boolean lb_editbonusqty
	boolean lb_edititewflatdisc
	datastore lds_templatedetail
	datastore lds_templateheader
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_doctcode = this.id_master.getitemnumber(ll_masterrow, "doctcode")
	if ll_doctcode = 0 or isnull(ll_doctcode) then
		messagebox(ls_msgtitle, "Please Select Valid Doctor", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Items before applying Doctors' Associated Service Template", stopsign!)
		return 0
	end if
	ll_templatecode = wf_get_associated_templatecode(ll_doctcode)
	if ll_templatecode < 0 then
		if ll_templatecode = -1 then
			messagebox(ls_msgtitle, "Please Select Valid Doctor", stopsign!)
			return 0
		else
			messagebox(ls_msgtitle, "Problem in retrieving Associated Service Template of this Doctor", stopsign!)
			return 0
		end if
	elseif ll_templatecode = 0 then
		if ai_mode = 0 then
			messagebox(ls_msgtitle, "No Associated Service Template found for this Doctor", stopsign!)
			return 0
		else
			return 1
		end if
		return
	end if
	if f_stringpreferences("applydoctortemplatein_inpatientservice_onsaving") = "Y" then
		ll_prefsetting = 1
	elseif f_stringpreferences("applydoctortemplatein_inpatientservice_onsaving") = "P" then
		ll_prefsetting = 2
	elseif f_stringpreferences("applydoctortemplatein_inpatientservice_onsaving") = "D" then
		ll_prefsetting = 3
	elseif f_stringpreferences("applydoctortemplatein_inpatientservice_onsaving") = "C" then
		ll_prefsetting = 4
	elseif f_stringpreferences("applydoctortemplatein_inpatientservice_onsaving") = "S" then
		ll_prefsetting = 5
	elseif f_stringpreferences("applydoctortemplatein_inpatientservice_onsaving") = "T" then
		ll_prefsetting = 6
	else
		ll_prefsetting = 0
	end if
	lds_templatedetail = create datastore
	lds_templateheader = create datastore
	lds_templatedetail.dataobject = "d_servicetemplate_detail"
	lds_templatedetail.settransobject(this.it_transobject)
	lds_templateheader.dataobject = "d_servicetemplate_header"
	lds_templateheader.settransobject(this.it_transobject)
	ll_templateheaderrow = lds_templateheader.retrieve(ll_templatecode)
	if ll_templateheaderrow < 0 then
		messagebox(ls_msgtitle, "Associated Service Template Header Retrieval Problem", stopsign!)
		return 0
	else
		ll_templateheaderrow = lds_templateheader.rowcount()
		if ll_templateheaderrow = 0 then
			messagebox(ls_msgtitle, "Associated Service Template Does not Exist", stopsign!)
			return 0
		end if
	end if
	ll_templaterows = lds_templatedetail.retrieve(ll_templatecode)
	if ll_templaterows < 0 then
		messagebox(ls_msgtitle, "Associated Service Template Detail Retrieval Problem", stopsign!)
		return 0
	else
		ll_templaterows = lds_templatedetail.rowcount()
		if ll_templaterows = 0 then
			if ai_mode = 0 then
				messagebox(ls_msgtitle, "Associated Service Template contain no rows", stopsign!)
				return 0
			else
				return 1
			end if
			return
		end if
	end if
	setredraw(false)
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ll_found = 0
		ll_found = lds_templatedetail.find("icode = " + trim(string(ll_icode)), 1, ll_templaterows)
		if ll_found > 0 then
			ld_templatediscperc = lds_templatedetail.getitemnumber(ll_found, "discperc")
			ld_templateprice = lds_templatedetail.getitemnumber(ll_found, "saleprice")
			ld_template_flatdisc = lds_templatedetail.getitemnumber(ll_found, "serviceflatdisc")
			ld_template_shareperc = lds_templatedetail.getitemnumber(ll_found, "shareperc")
			ld_commission = lds_templatedetail.getitemnumber(ll_found, "commission")
			if ll_prefsetting >= 1 then
				if ll_prefsetting <= 2 or ll_prefsetting = 6 then
					this.id_detail.setitem(ll_rowcount, "saleprice", ld_templateprice)
				end if
				if ll_prefsetting = 1 or ll_prefsetting = 3 then
					this.id_detail.setitem(ll_rowcount, "discperc", ld_templatediscperc)
					this.id_detail.setitem(ll_rowcount, "serviceflatdisc", ld_template_flatdisc)
				end if
				if ll_prefsetting = 1 or ll_prefsetting = 4 or ll_prefsetting = 6 then
					this.id_detail.setitem(ll_rowcount, "commission", ld_commission)
				end if
				if ll_prefsetting = 1 or ll_prefsetting = 5 or ll_prefsetting = 6 then
					this.id_detail.setitem(ll_rowcount, "shareperc", ld_template_shareperc)
				end if
			end if
			ld_qty = this.id_detail.getitemnumber(ll_rowcount, "qty")
		else
			ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname
			ll_notfound_itemcount = ll_notfound_itemcount + 1
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_notfound_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Guidelines Exist for Following " + trim(string(ll_notfound_itemcount)) + " service(s) in Associated Template/Pricing Contract~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_inpatientservice.wf_get_associated_templatecode(long al_doctcode) returns long
	long ll_retcode = -1
	long ll_templatecode = -1
	if al_doctcode = 0 or isnull(al_doctcode) then
		ll_retcode = -1
		return ll_retcode
	else
		SQL SELECT ServiceTemplateCode INTO :ll_templatecode FROM DBO.Doctors WHERE DoctCode =:al_doctcode USING sqlca;
		if sqlca.sqlcode = 0 then
			if ll_templatecode = 0 or isnull(ll_templatecode) then
				ll_retcode = 0
			else
				ll_retcode = ll_templatecode
			end if
		else
			ll_retcode = -2
		end if
	end if
	return ll_retcode

// w_inpatientservice.wf_get_customer_associated_templatecode(long al_custcode) returns long
	long ll_retcode = -1
	long ll_templatecode = -1
	if al_custcode = 0 or isnull(al_custcode) then
		ll_retcode = -1
		return ll_retcode
	else
		SQL SELECT AssociatedServiceTemplateCode INTO :ll_templatecode FROM DBO.Customer WHERE CustCode =:al_custcode USING sqlca;
		if sqlca.sqlcode = 0 then
			if ll_templatecode = 0 or isnull(ll_templatecode) then
				ll_retcode = 0
			else
				ll_retcode = ll_templatecode
			end if
		else
			ll_retcode = -2
		end if
	end if
	return ll_retcode

// w_inpatientservice.wf_apply_associated_customer_tempate(integer ai_mode) returns long
	long ll_custcode
	long ll_masterrow
	long ll_templatecode
	long ll_detailrows
	long ll_templateheaderrow
	long ll_templaterows
	long ll_found
	long ll_rowcount
	long ll_templatepackunits
	long ll_icode
	long ll_notfound_itemcount
	long ll_prefsetting = 1
	double ld_templateprice
	double ld_templatediscperc
	double ld_templateflatdisc
	double ld_templateqty
	double ld_qty
	double ld_commission
	string ls_msgtitle = "Customer Associated Service Template"
	string ls_itemname
	string ls_msgdetail
	boolean lb_editsaleprice
	boolean lb_editsalediscperc
	boolean lb_editbonusqty
	boolean lb_edititewflatdisc
	datastore lds_templatedetail
	datastore lds_templateheader
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_custcode = this.id_master.getitemnumber(ll_masterrow, "custcode")
	if ll_custcode = 0 or isnull(ll_custcode) then
		messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Items before applying Customers' Associated Service Template", stopsign!)
		return 0
	end if
	ll_templatecode = wf_get_customer_associated_templatecode(ll_custcode)
	if ll_templatecode < 0 then
		if ll_templatecode = -1 then
			messagebox(ls_msgtitle, "Please Select Valid customer", stopsign!)
			return 0
		else
			messagebox(ls_msgtitle, "Problem in retrieving Associated Service Template of this customer", stopsign!)
			return 0
		end if
	elseif ll_templatecode = 0 then
		if ai_mode = 0 then
			messagebox(ls_msgtitle, "No Associated Service Template found for this customer", stopsign!)
			return 0
		else
			return 1
		end if
		return
	end if
	lds_templatedetail = create datastore
	lds_templateheader = create datastore
	lds_templatedetail.dataobject = "d_servicetemplate_detail"
	lds_templatedetail.settransobject(this.it_transobject)
	lds_templateheader.dataobject = "d_servicetemplate_header"
	lds_templateheader.settransobject(this.it_transobject)
	ll_templateheaderrow = lds_templateheader.retrieve(ll_templatecode)
	if ll_templateheaderrow < 0 then
		messagebox(ls_msgtitle, "Associated Service Template Header Retrieval Problem", stopsign!)
		return 0
	else
		ll_templateheaderrow = lds_templateheader.rowcount()
		if ll_templateheaderrow = 0 then
			messagebox(ls_msgtitle, "Associated Service Template Does not Exist", stopsign!)
			return 0
		end if
	end if
	ll_templaterows = lds_templatedetail.retrieve(ll_templatecode)
	if ll_templaterows < 0 then
		messagebox(ls_msgtitle, "Associated Service Template Detail Retrieval Problem", stopsign!)
		return 0
	else
		ll_templaterows = lds_templatedetail.rowcount()
		if ll_templaterows = 0 then
			if ai_mode = 0 then
				messagebox(ls_msgtitle, "Associated Service Template contain no rows", stopsign!)
				return 0
			else
				return 1
			end if
			return
		end if
	end if
	setredraw(false)
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ll_found = 0
		ll_found = lds_templatedetail.find("icode = " + trim(string(ll_icode)), 1, ll_templaterows)
		if ll_found > 0 then
			ld_templatediscperc = lds_templatedetail.getitemnumber(ll_found, "discperc")
			ld_templateprice = lds_templatedetail.getitemnumber(ll_found, "saleprice")
			ld_templateflatdisc = lds_templatedetail.getitemnumber(ll_found, "serviceflatdisc")
			this.id_detail.setitem(ll_rowcount, "saleprice", ld_templateprice)
			this.id_detail.setitem(ll_rowcount, "discperc", ld_templatediscperc)
			this.id_detail.setitem(ll_rowcount, "serviceflatdisc", ld_templateflatdisc)
			ld_commission = lds_templatedetail.getitemnumber(ll_found, "commission")
			ld_qty = this.id_detail.getitemnumber(ll_rowcount, "qty")
			this.id_detail.setitem(ll_rowcount, "commission", ld_commission)
		else
			ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname
			ll_notfound_itemcount = ll_notfound_itemcount + 1
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_notfound_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Guidelines Exist for Following " + trim(string(ll_notfound_itemcount)) + " service(s) in Associated Template/Pricing Contract~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_inpatientservice.wf_lock_serviceinvoices_patientadmission(long al_sinvcode, long al_linvcode, ref long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From ServiceHeader WITH ( UPDLOCK HOLDLOCK ) Where ServiceHeader.Serviceinvcode Between :al_sinvcode AND :al_linvcode AND ServiceHeader.Posted ='N' AND ServiceHeader.AdmissionCode IS NOT NULL USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_inpatientservice.wf_saveandpost() returns long
	boolean lb_listtab
	boolean lb_continueposting
	integer li_postingmode = 2
	integer li_errcode
	integer li_printoption = 1
	long ll_sinvcode
	long ll_linvcode
	long ll_found
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab then
		return 0
	end if
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.object.posted[1] = "Y" then
		return 0
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 716", 1, gds_securitywindow.rowcount())
	if ll_found <= 0 then
		messagebox("Service Invoice Posting", "Not Enough rights to post service invoice")
		return -1
	end if
	li_printoption = messagebox("Print Service Invoice", "Do You want to Print Service invoice As Well?", information!, yesno!, 1)
	if li_printoption = 1 then
		event ue_print()
	else
		event ue_save()
	end if
	if this.ib_commitok and this.il_codevalue > 0 then
		lb_continueposting = true
	else
		return 0
	end if
	if lb_continueposting then
		ll_sinvcode = this.il_codevalue
		ll_linvcode = this.il_codevalue
		if isnull(ll_sinvcode) or isnull(ll_linvcode) or ll_sinvcode < 0 or ll_linvcode < 0 then
			return 0
		else
			li_errcode = wf_post_service_patientadmission(li_postingmode, ll_sinvcode, ll_linvcode)
			event ue_new()
		end if
	end if
	setpointer(arrow!)
	return li_errcode

// w_inpatientservice.wf_set_patientbalance(long al_patientcode) returns integer
	datetime ldt_datetime
	double ld_balance
	ldt_datetime = datetime(date(today()), time(today()))
	sqlca.patientopeningbalance(al_patientcode, ldt_datetime, ld_balance)
	if sqlca.sqlcode = 0 then
		this.id_master.object.patientbalance[1] = ld_balance
		return 0
	end if
	return -1

// w_inpatientservice.wf_update_virtualgl() returns integer
	SQL rollback USING sqlca;
	sqlca.virtualgl("A")
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
	else
		SQL rollback USING sqlca;
	end if
	return 0

// w_inpatientservice.wf_show_patientgallery() returns long
	long ll_code
	long ll_patientcode
	if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
		ll_code = this.id_master.object.admissioncode[this.id_master.getrow()]
		ll_patientcode = wf_findpatientcode(ll_code)
		if ll_patientcode > 0 then
			f_show_patient_gallary(ll_patientcode)
		end if
	end if
	return 0

// w_inpatientservice.wf_apply_pricepolicy(integer ai_mode) returns long
	long ll_custcode
	long ll_masterrow
	long ll_detailrows
	long ll_found
	long ll_rowcount
	long ll_icode
	long ll_manualprice_itemcount
	double ld_qty
	double ld_policy_price
	double ld_price
	string ls_msgtitle = "Price Policy Implementation"
	string ls_itemname
	string ls_msgdetail
	boolean lb_editsaleprice
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_custcode = this.id_master.getitemnumber(ll_masterrow, "custcode")
	if ll_custcode = 0 or isnull(ll_custcode) then
		messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Services before applying Price Policy to this invoice", stopsign!)
		return 0
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 610", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editsaleprice = true
	else
		messagebox(ls_msgtitle, "Not enough rights to modify service price.~r~nPlease contact system administrator for help", stopsign!)
		return 0
	end if
	setredraw(false)
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ld_qty = this.id_detail.getitemnumber(ll_rowcount, "qty")
		ld_price = this.id_detail.getitemnumber(ll_rowcount, "saleprice")
		if ld_qty > 0.0 and ll_icode >= 0 and not isnull(ll_icode) then
			ld_policy_price = 0
			this.it_transobject.getpricefromservicepricepolicy(ll_icode, ld_policy_price)
			if this.it_transobject.sqlcode = 0 then
				if isnull(ld_policy_price) then
					ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_rowcount) + "~t Service Name:  " + ls_itemname
					ll_manualprice_itemcount = ll_manualprice_itemcount + 1
				else
					this.id_detail.setitem(ll_rowcount, "saleprice", ld_policy_price)
				end if
			else
				ls_msgdetail = "Some Problem Occured while fetching Service Price Policy details~r~n" + this.it_transobject.sqlerrtext
				messagebox(ls_msgtitle, ls_msgdetail, stopsign!)
				return 0
			end if
			return
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_manualprice_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Price Policy exists for Following " + trim(string(ll_manualprice_itemcount)) + " Service(s)~r~nTheir Pricing should be set by user manually~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_inpatientservice.wf_generate_serviceresult(long al_serviceinvcode, integer ai_usercode, long al_serviceresultcode) returns long
	long ll_retcode
	if al_serviceinvcode > 0 and ai_usercode > 0 then
		this.it_transobject.autogenerateserviceresult(al_serviceinvcode, ai_usercode, al_serviceresultcode)
		if this.it_transobject.sqlcode = 0 then
			ll_retcode = 0
		else
			messagebox("Auto Service Result Generation", "Problems Occured in Auto Service Result Generation.~r~nReasons Are:-" + this.it_transobject.sqlerrtext)
			ll_retcode = -1
		end if
	end if
	return ll_retcode

// w_inpatientservice.wf_generate_service_ticket(long al_serviceinvcode, integer al_usercode) returns long
	long ll_retcode
	if al_serviceinvcode > 0 and al_usercode > 0 then
		this.it_transobject.generateserviceticket(al_serviceinvcode, al_usercode)
		if this.it_transobject.sqlcode = 0 then
			ll_retcode = 0
		else
			messagebox("Service Ticket Generation", "Problems Occured in Service Ticket Generation.~r~nReasons Are:-" + this.it_transobject.sqlerrtext)
			ll_retcode = -1
		end if
	end if
	return ll_retcode

// w_inpatientservice.wf_generate_serviceinvpurtemplate(long al_serviceinvcode, integer ai_usercode) returns long
	long ll_retcode
	if al_serviceinvcode > 0 and ai_usercode > 0 then
		this.it_transobject.autogenerateserviceinvpurtemplate(al_serviceinvcode, ai_usercode)
		if this.it_transobject.sqlcode = 0 then
			ll_retcode = 0
		else
			messagebox("Auto Generation of Service Purchase Template", "Problems Occured in Auto Generation of Service Purchase Template.~r~nReasons Are:-" + this.it_transobject.sqlerrtext)
			ll_retcode = -1
		end if
	end if
	return ll_retcode

// w_inpatientservice.wf_raise_doctorbased_purofservice(long al_serviceinvcode, integer al_usercode) returns long
	long ll_retcode
	if al_serviceinvcode > 0 and al_usercode > 0 and f_stringpreferences("raisedoctorsharebasedpurofsvconposting") = "Y" then
		this.it_transobject.autogeneratepurchaseofservice_doctorsharebased(al_serviceinvcode, al_usercode)
		if this.it_transobject.sqlcode = 0 then
			ll_retcode = 0
		else
			messagebox("Auto Generation of Purchase of Service", "Problems Occured in Purchase of Service Auto Generation.~r~nReasons Are:-" + this.it_transobject.sqlerrtext)
			ll_retcode = -1
		end if
	end if
	return ll_retcode

// w_inpatientservice.wf_show_serviceinvpurtemplate() returns 0
	long ll_serviceinvcode
	long ll_custcode
	long ll_null
	long ll_patientcode
	long ll_currlistrow
	string ls_posted
	if wf_iseditable() = true then
		return
	end if
	setnull(ll_null)
	if this.id_list.rowcount() <= 0 or this.id_list.getrow() <= 0 then
		return
	end if
	ll_currlistrow = this.id_list.getrow()
	if this.id_list.rowcount() > 0 and ll_currlistrow > 0 then
		ll_serviceinvcode = this.id_list.object.code[ll_currlistrow]
		ll_custcode = this.id_list.object.custcode[ll_currlistrow]
		ll_patientcode = this.id_list.object.patientcode[ll_currlistrow]
		if isnull(ll_custcode) or ll_custcode = 0 then
			messagebox("Customer Validation", "Please Select a customer first")
			return
		end if
		if ll_serviceinvcode > 0 then
			SQL SELECT Posted INTO :ls_posted FROM ServiceInvPurTempHeader WHERE ServiceInvcode =:ll_serviceinvcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				this.istr_buffer.i_status = 1
				this.istr_buffer.l_code1 = this.id_list.object.code[this.id_list.getrow()]
				this.istr_buffer.l_code2 = ll_null
				this.istr_buffer.l_code3 = ll_custcode
				this.istr_buffer.l_code4 = 0
				this.istr_buffer.l_code5 = ll_patientcode
				this.istr_buffer.s_name1 = ls_posted
				openwithparm(w_serviceinvpurtemplate_popup, this, this)
			end if
		end if
	end if

// w_inpatientservice.wf_show_inpatientbill_procedure() returns long
	long ll_admissioncode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_admissioncode = this.id_master.object.admissioncode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_admissioncode = this.id_list.object.admissioncode[this.id_list.getrow()]
	end if
	if not isnull(ll_admissioncode) and ll_admissioncode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_inpatient_bill_procedure, ll_admissioncode)
	end if
	return 0

// w_inpatientservice.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_inpatientservicemenu" then
		this.menuid = create m_inpatientservicemenu
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	this.dw_saleinvdetail = create dw_saleinvdetail
	this.dw_servicestatus = create dw_servicestatus
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.dw_saleinvdetail
	this.control[icurrent + 3] = this.dw_servicestatus

// w_inpatientservice.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.dw_saleinvdetail
	destroy this.dw_servicestatus

// w_inpatientservice.ue_save() returns 0 [event]
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_stock
	long ll_newstock
	long ll_icode
	long ll_salelooseqty
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode = 1
	long ll_gcode
	long ll_headerno
	long ll_headerinvno
	long ll_counter
	long ll_count
	long ll_statusrow
	long ll_custcode
	long ll_patientcode
	long ll_saveresult
	long ll_null
	long ll_serviceresultcode
	long ll_doctcode
	boolean lb_commitflag = true
	boolean lb_continue = true
	integer li_counter
	string ls_errtext
	string ls_posted = "N"
	string ls_invlist
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_cashreceived
	double ld_serviceinvgstperc
	datetime ldt_server_datetime
	string ls_date_errtext
	setnull(ll_patientcode)
	setnull(ll_null)
	this.ib_commitok = false
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	wf_grandtotal()
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "cashreceived") < 0.0 then
		messagebox("Cash Received Validation", "Cash Received can not be negative")
		this.id_footer.setcolumn("cashreceived")
		this.id_footer.setfocus()
		return
	end if
	if wf_admitted(this.id_master.object.admissioncode[this.id_master.getrow()]) <= 0 then
		messagebox("Problem Saving", "Patient No more Admitted.~r~nChoose some other patient")
		this.id_master.setfocus()
		this.id_master.setcolumn("admissioncode")
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if wf_set_cashaccount() = 0 then
		return
	end if
	wf_grandtotal()
	if wf_checkservicecharges() = false then
		return
	end if
	if f_stringpreferences("applydoctortemplatein_inpatientservice_onsaving") <> "N" then
		if wf_apply_associated_doctor_tempate(1) <= 0 then
			messagebox("Doctor Associated Service Template", "Problem in using Doctor Associated Service Template")
			this.id_master.setfocus()
			this.id_master.setcolumn("doctcode")
			return
		end if
	end if
	if f_stringpreferences("applycustomertemplateonsaving") <> "N" then
		if wf_apply_associated_customer_tempate(1) <= 0 then
			messagebox("Customer Associated Service Template", "Problem in using Customer Associated Service Template")
			this.id_master.setfocus()
			this.id_master.setcolumn("custcode")
			return
		end if
	end if
	if f_stringpreferences("ForcePricePolicyOnSavingService") = "Y" and wf_apply_pricepolicy(1) <= 0 then
		messagebox("Price Policy Implementation", "Problem in Applying Service Price Policy on Saving")
		return
	end if
	if f_stringpreferences("ServiceSalesManWindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		if wf_validate_price_discount_matters(ll_salesmancode) < 0 then
			return
		end if
		ll_patientcode = wf_findpatientcode(this.id_master.object.admissioncode[ll_mastercurrrow])
		ls_posted = this.id_master.object.posted[ll_mastercurrrow]
		if wf_show_mastercashierwindow() = 0 then
			return
		end if
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if isnull(ll_invid) then
			wf_tabnewid("ServiceHeader", ll_invid)
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
		end if
		if f_stringpreferences("Headeronsaleinv") = "N" then
			this.id_master.setitem(ll_mastercurrrow, "Headerno", f_numberpreferences("headerno"))
		end if
		ld_misccharges = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges")
		ld_invdiscperc = this.id_footer.getitemnumber(ll_footercurrrow, "invdiscperc")
		ld_flatdisc = this.id_footer.getitemnumber(ll_footercurrrow, "flatdisc")
		ld_cashreceived = this.id_footer.getitemnumber(ll_footercurrrow, "cashreceived")
		ll_custcode = this.id_master.getitemnumber(ll_mastercurrrow, "custcode")
		ll_doctcode = this.id_master.getitemnumber(ll_mastercurrrow, "doctcode")
		ld_serviceinvgstperc = this.id_footer.getitemnumber(ll_mastercurrrow, "serviceinvgstperc")
		this.id_master.setitem(ll_mastercurrrow, "discperc", ld_invdiscperc)
		this.id_master.setitem(ll_mastercurrrow, "flatdisc", ld_flatdisc)
		this.id_master.setitem(ll_mastercurrrow, "serviceinvgstperc", ld_serviceinvgstperc)
		this.id_master.setitem(ll_mastercurrrow, "misccharges", ld_misccharges)
		this.id_master.setitem(ll_mastercurrrow, "invtotal", wf_grandtotal())
		if f_stringpreferences("askmastercashwin_in_inpatientservice") = "N" then
			this.id_master.setitem(ll_mastercurrrow, "cashreceived", ld_cashreceived)
		else
			this.id_master.setitem(ll_mastercurrrow, "cashreceived", 0)
		end if
		if this.ib_modify then
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			lb_continue = wf_returnsaleinvoice(ll_invid, ls_errtext)
		else
			this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "PostDate", ldt_server_datetime)
		end if
		if lb_continue then
			this.id_saleinvdetail.reset()
			this.dw_servicestatus.reset()
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_saleinvdetail.insertrow(0)
				this.id_saleinvdetail.setitem(ll_counter, "Code", ll_invid)
				this.id_saleinvdetail.setitem(ll_counter, "saleprice", this.id_detail.getitemnumber(ll_counter, "saleprice"))
				this.id_saleinvdetail.setitem(ll_counter, "serviceflatdisc", this.id_detail.getitemnumber(ll_counter, "serviceflatdisc"))
				this.id_saleinvdetail.setitem(ll_counter, "allowsaleindecimal", this.id_detail.getitemstring(ll_counter, "allowsaleindecimal"))
				this.id_saleinvdetail.setitem(ll_counter, "discperc", this.id_detail.getitemnumber(ll_counter, "discperc"))
				this.id_saleinvdetail.setitem(ll_counter, "icode", this.id_detail.getitemnumber(ll_counter, "icode"))
				this.id_saleinvdetail.setitem(ll_counter, "smancode", this.id_detail.getitemnumber(ll_counter, "smancode"))
				this.id_saleinvdetail.setitem(ll_counter, "qty", this.id_detail.getitemnumber(ll_counter, "qty"))
				this.id_saleinvdetail.setitem(ll_counter, "commission", this.id_detail.getitemnumber(ll_counter, "commission"))
				this.id_saleinvdetail.setitem(ll_counter, "costprice", this.id_detail.getitemnumber(ll_counter, "costprice"))
				this.id_saleinvdetail.setitem(ll_counter, "deliverydate", this.id_detail.getitemdatetime(ll_counter, "deliverydate"))
				this.id_saleinvdetail.setitem(ll_counter, "sampletaken", this.id_detail.getitemstring(ll_counter, "sampletaken"))
				this.id_saleinvdetail.setitem(ll_counter, "reportmade", this.id_detail.getitemstring(ll_counter, "reportmade"))
				this.id_saleinvdetail.setitem(ll_counter, "remarks", this.id_detail.getitemstring(ll_counter, "remarks"))
				this.id_saleinvdetail.setitem(ll_counter, "serviceflattax", this.id_detail.getitemnumber(ll_counter, "serviceflattax"))
				this.id_saleinvdetail.setitem(ll_counter, "servicegstperc", this.id_detail.getitemnumber(ll_counter, "servicegstperc"))
				this.id_saleinvdetail.setitem(ll_counter, "shareperc", this.id_detail.getitemnumber(ll_counter, "shareperc"))
				if this.id_detail.getitemstring(ll_counter, "ServiceStatus") = "Y" then
					this.dw_servicestatus.retrieve(this.id_detail.getitemnumber(ll_counter, "SrvORowID"))
					this.dw_servicestatus.setitem(this.dw_servicestatus.getrow(), "ServiceStatus", "Y")
					if this.dw_servicestatus.update() <> 1 then
						SQL rollback USING this.it_transobject;
						messagebox("Service Status Updation", "Unable to modify Service Status.")
						setfocus()
						setpointer(arrow!)
						return
					end if
					return
				end if
			next
			ld_cashreceived = this.id_master.getitemnumber(ll_mastercurrrow, "cashreceived")
			if ld_cashreceived > 0.0 and this.ii_servicetype = 11 and f_stringpreferences("askmastercashwin_in_inpatientservice") = "N" and wf_generatecashreceipt(ldt_server_datetime, ll_custcode, ld_cashreceived, ll_salesmancode, ll_invid, ll_patientcode) = -1 then
				SQL rollback USING this.it_transobject;
				if this.ib_modify = false then
					this.id_master.setitem(1, "Code", ll_null)
				end if
				return
			end if
			this.id_detail = this.id_saleinvdetail
			ll_saveresult = event ue_save_withnocommit()
			if ll_saveresult = 0 then
				if wf_generate_serviceresult(ll_invid, ll_salesmancode, ll_serviceresultcode) = 0 then
					if wf_generate_service_ticket(ll_invid, ll_salesmancode) = 0 then
						if wf_generate_serviceinvpurtemplate(ll_invid, ll_salesmancode) = 0 then
							if wf_raise_doctorbased_purofservice(ll_invid, ll_salesmancode) = 0 then
								if wf_update_mastercashierwindow(ll_invid, this.is_doctype) = 0 then
									SQL commit USING this.it_transobject;
									if gs_allowsmsfunctions = "Y" and ls_posted = "Y" then
										ls_invlist = trim(string(ll_invid))
										this.it_transobject.createautotriggersms(ls_invlist, this.ii_patientmodule, "Posting")
										if this.it_transobject.sqlcode <> 0 then
											ls_errtext = "Problem in Generating Auto Triggered SMS.~r~nReasons are:- " + this.it_transobject.sqlerrtext
											SQL rollback USING this.it_transobject;
											messagebox("Auto Triggered SMS", ls_errtext)
										else
											SQL commit USING this.it_transobject;
										end if
									end if
									messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
									this.ib_commitok = true
									this.il_codevalue = ll_invid
									this.id_master.resetupdate()
									this.im_menu.m_file.m_new.enabled = true
									this.editflag = false
									if gd_recenttransdate < this.id_systemdate then
										gd_recenttransdate = this.id_systemdate
									end if
								else
									messagebox("Saving Problem", "Changes Not Saved in database for Master Cashier Window transactions.", stopsign!, ok!, 1)
								end if
							else
								messagebox("Saving Problem", "Changes Not Saved in database due to problem in purchase of service generation.", stopsign!, ok!, 1)
							end if
						else
							messagebox("Saving Problem", "Changes Not Saved in database due to problem in service purchase template generation.", stopsign!, ok!, 1)
						end if
					else
						messagebox("Saving Problem", "Changes Not Saved in database due to problems in service ticket generation.", stopsign!, ok!, 1)
					end if
				else
					messagebox("Saving Problem", "Changes Not Saved in database due to problems in auto service result generation.", stopsign!, ok!, 1)
				end if
			else
				messagebox("Saving Problem", "Changes Not Saved in database while saving service record.", stopsign!, ok!, 1)
			end if
			this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
			this.id_saleinvdetail.reset()
			if this.ib_commitok then
				this.ib_modify = false
			else
				lb_continue = false
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			messagebox("Updation Error", ls_errtext + " in current row", stopsign!)
			if this.ib_modify = false then
				this.id_master.setitem(1, "Code", ll_null)
				this.id_master.accepttext()
			end if
		elseif f_stringpreferences("IncSvcSaleInActMonitor") = "Y" then
			this.it_transobject.updateactivitymonitor(this.is_doctype, ll_invid)
			if this.it_transobject.sqlcode <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
			else
				SQL commit USING this.it_transobject;
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_inpatientservice.ue_newform() returns 0 [event]
	integer rtncode
	long li_fetched_code
	long row
	long ll_manfcode
	call super::ue_newform
	setredraw(false)
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.im_menu.m_file.m_print.enabled = true
	this.id_master.object.patientcode.visible = false
	this.id_master.object.admissioncode.visible = true
	wf_assign_master_cash_win_object()
	wf_update_virtualgl()
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	wf_protect_saleprice()
	this.ib_modify = false
	if this.id_master.rowcount() > 0 then
		if isnull(this.id_master.object.date[1]) then
			this.id_master.object.duedate[1] = datetime(today(), relativetime(time(now()), this.ll_responsetime_sec))
		else
			this.id_master.object.duedate[1] = this.id_master.object.date[1]
		end if
	end if
	this.id_footer.setitem(1, "invdiscperc", f_numberpreferences("invdiscperc"))
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	wf_visible(true)
	setredraw(true)

// w_inpatientservice.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect = 1
	long ll_row
	long ll_code
	long ll_found
	boolean lb_flag
	boolean lb_modify
	m_inpatientservicemenu lm_menu
	call super::ue_detail
	lm_menu = this.menuid
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_print.enabled = true
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		ll_found = 0
		if this.ii_servicetype = 10 then
			ll_found = gds_securitywindow.find("rightcode = 713", 1, gds_securitywindow.rowcount())
		else
			ll_found = gds_securitywindow.find("rightcode = 714", 1, gds_securitywindow.rowcount())
		end if
		if ll_found > 0 then
			li_protect = 0
			wf_initmodify(li_protect)
		else
			this.id_detail.reset()
			messagebox("Service Modification", "Not Enough rights for service invoice modification~r~nPlease contact your system administrator to do the needfull", stopsign!)
			this.tab_retrieve.selecttab(2)
			return
		end if
		return
	end if
	if wf_admitted(this.id_master.object.admissioncode[this.id_master.getrow()]) <= 0 then
		this.id_master.object.patientcode.visible = true
		this.id_master.object.admissioncode.visible = false
		this.id_master.setitem(1, "patientcode", wf_findpatientcode(this.id_master.object.admissioncode[this.id_master.getrow()]))
	else
		this.id_master.object.patientcode.visible = false
		this.id_master.object.admissioncode.visible = true
	end if
	if this.id_master.object.code[this.id_master.rowcount()] > 0 then
		this.ids_cashwin.retrieve(this.id_master.object.code[1], this.is_doctype)
	else
		wf_assign_master_cash_win_object()
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		wf_protect_saleprice()
	end if
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	wf_grandtotal()
	setredraw(true)

// w_inpatientservice.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		if f_stringpreferences("itemcode") = "N" then
			this.id_detail.setcolumn("itemname")
			this.ib_focusdetail = true
			this.id_itemslist.show()
		else
			this.id_detail.setcolumn("fullcode")
			this.ib_focusdetail = true
			this.id_itemslist.hide()
		end if
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_inpatientservice.ue_deleteitem() returns 0 [event]
	long ll_row
	long ll_footerrow
	call super::ue_deleteitem
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() > 0 then
		this.id_footer.setitem(ll_footerrow, "icode", this.id_detail.getitemnumber(ll_row, "icode"))
		return
	end if
	this.id_footer.setitem(ll_footerrow, "icode", 0)
	this.im_menu.m_file.m_save.enabled = false

// w_inpatientservice.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	return ::message.returnvalue

// w_inpatientservice.ue_list() returns 0 [event]
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_post.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	wf_retrievelist()

// w_inpatientservice.ue_print() returns 0 [event]
	long ll_custcode
	long ll_row
	long ll_saleinvcode
	long i
	long ll_invcode
	string ls_custname
	integer li_option
	datastore lds_salecatinfo
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	lds_salecatinfo = create datastore
	lds_salecatinfo.dataobject = "d_salecatinfo"
	lds_salecatinfo.settransobject(this.it_transobject)
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	wf_select_service_printout()
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if lb_listtab then
			setnull(ll_saleinvcode)
		else
			ll_saleinvcode = this.id_master.getitemnumber(1, "saleinvcode")
		end if
		if isnull(ll_saleinvcode) then
			if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
				postevent("ue_new")
			end if
		else
			lds_salecatinfo.retrieve(ll_saleinvcode)
			this.ii_saletype = lds_salecatinfo.getitemnumber(lds_salecatinfo.getrow(), "salecatcode")
			wf_selectprintreport()
			this.id_print.retrieve(ll_saleinvcode)
			if this.id_print.rowcount() > 0 then
				if this.id_print.print() < 0 then
					messagebox("Printing", "Can not Print Invoice", information!)
				end if
			else
				messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
			end if
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_inpatientservice.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	f_retrieve_servicelist(this.id_itemslist, this.it_transobject)
	setpointer(hourglass!)
	this.idc_customers.setredraw(false)
	this.idc_customers.settransobject(this.it_transobject)
	this.idc_customers.retrieve()
	this.idc_customers.setredraw(true)
	this.idc_salesman.settransobject(this.it_transobject)
	this.idc_salesman.retrieve()
	if f_stringpreferences("InServiceCustomerBalance") = "Y" then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		this.ids_customersbalance.retrieve()
	end if
	this.idc_patient.settransobject(this.it_transobject)
	this.idc_patient.retrieve()
	setpointer(arrow!)

// w_inpatientservice.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_inpatientservice.ue_postopen() returns 0 [event]
	datawindowchild ldc_headerno
	integer li_rtncode
	long ll_counter
	long ll_pos
	long ll_found
	m_inpatientservicemenu lm_menu
	long li_count
	long ll_startrow
	char lc_char
	call super::ue_postopen
	lm_menu = this.menuid
	setredraw(false)
	this.ii_servicetype = integer(message.doubleparm)
	this.id_print = this.dw_saleinvrep
	this.id_saleinvdetail = this.dw_saleinvdetail
	this.id_saleinvdetail.settransobject(this.it_transobject)
	this.dw_servicestatus.settransobject(this.it_transobject)
	wf_assign_master_cash_win_object()
	this.il_groupcode = f_getgroupcode(gl_usercode)
	choose case this.ii_servicetype
	case 11
		this.title = "In-Patient Service Sales"
		if gs_company = "SHE" or gs_company = "REHMAT" then
			this.id_master.object.servicecatcode.initial = "12"
		end if
		li_rtncode = this.id_master.getchild("custcode", this.idc_customers)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_customers.settransobject(this.it_transobject)
		if f_stringpreferences("InServiceCustomerBalance") = "Y" then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
			this.ids_customersbalance = create datastore
			this.ids_customersbalance.dataobject = "d_customerbalances_in_sales"
			this.ids_customersbalance.settransobject(sqlca)
			this.ids_customersbalance.retrieve()
		else
			this.id_master.object.debitorcredit.visible = false
			this.id_master.object.customerbalance.visible = false
			this.id_master.object.t_balance.visible = false
		end if
		this.id_master.object.posted.initial = upper(f_stringpreferences("autopost_creditservice"))
	case 10
		this.title = "Cash Service"
		wf_assigndatawindowobjects("d_retailserviceHeader", "d_Creditservice_Detail", "d_serviceFooter1", "d_Retailservicelist", "d_cashserviceinvreport")
		this.id_footer.object.cashreceived.visible = false
		this.id_footer.object.t_cashreceived.visible = false
		this.id_footer.object.balance.visible = false
		this.id_footer.object.t_balance.visible = false
	end choose
	if f_stringpreferences("showflatdiscincreditservicedetail") = "N" then
		this.id_detail.object.serviceflatdisc.visible = false
	end if
	li_rtncode = this.id_master.getchild("admissioncode", this.idc_patient)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_patient.settransobject(this.it_transobject)
	this.idc_patient.retrieve()
	li_rtncode = this.id_detail.getchild("smancode", this.idc_salesman)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild for SalesMan in detail datawindow")
		close(this)
	end if
	this.idc_salesman.settransobject(this.it_transobject)
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	if f_stringpreferences("headeronsaleinv") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.t_headerno.visible = false
	else
		this.id_master.getchild("headerno", ldc_headerno)
		for ll_counter = 1 to gds_reoprtheaderinfo.rowcount()
			ldc_headerno.insertrow(0)
			ll_pos = pos(gds_reoprtheaderinfo.getitemstring(ll_counter, "clientname"), " ")
			ldc_headerno.setitem(ll_counter, "name", left(gds_reoprtheaderinfo.getitemstring(ll_counter, "clientname"), ll_pos))
			ldc_headerno.setitem(ll_counter, "code", gds_reoprtheaderinfo.getitemnumber(ll_counter, "headerno"))
		next
	end if
	f_retrieve_servicelist(this.id_itemslist, this.it_transobject)
	if f_stringpreferences("servicedoctid") = "N" then
		this.id_master.object.doctcode.visible = false
		this.id_master.object.t_doctcode.visible = false
	end if
	this.id_detail.object.smancode.initial = trim(string(f_numberpreferences("InitialSManCodeInService")))
	if f_stringpreferences("SalesManInService") = "N" then
		this.id_detail.object.smancode.visible = false
		this.id_detail.object.t_salesman.visible = false
	end if
	if f_stringpreferences("showcommissionincrditservice") = "N" then
		this.id_detail.object.commission.visible = false
	end if
	if f_stringpreferences("showdeliverydateincreditservice") = "N" then
		this.id_detail.object.deliverydate.visible = false
	end if
	if f_stringpreferences("showremarksincreditservicedetail") = "N" then
		this.id_detail.object.remarks.visible = false
	end if
	if f_stringpreferences("prediscpercincreditservicedetail") = "N" then
		this.id_detail.object.prediscperc.visible = false
	end if
	if f_stringpreferences("showflatdiscincreditservicedetail") = "N" then
		this.id_detail.object.serviceflatdisc.visible = false
	end if
	if f_stringpreferences("showflattaxincreditservice") = "N" then
		this.id_detail.object.serviceflattax.visible = false
		this.id_detail.object.c_flattaxval.visible = false
	end if
	if f_stringpreferences("showgstpercincreditservice") = "N" then
		this.id_detail.object.servicegstperc.visible = false
		this.id_detail.object.c_gstval.visible = false
	end if
	if f_stringpreferences("showsharepercincreditservice") = "N" then
		this.id_detail.object.shareperc.visible = false
	end if
	if f_stringpreferences("showcreditserviceinvgstperc") = "N" then
		this.id_footer.object.serviceinvgstperc.visible = false
		this.id_footer.object.serviceinvgstperc_t.visible = false
	end if
	if f_stringpreferences("showcustomerincreditservice") = "N" then
		this.id_master.object.custcode.visible = false
		this.id_master.object.custcode_t.visible = false
		this.id_master.object.aliasname.visible = false
		this.id_master.object.aliasname_t.visible = false
	end if
	if f_stringpreferences("showsaleinvcodeincreditservice") = "N" then
		this.id_master.object.saleinvcode.visible = false
		this.id_master.object.saleinvcode_t.visible = false
	end if
	if f_stringpreferences("showduedateincreditservice") = "N" then
		this.id_master.object.duedate.visible = false
		this.id_master.object.duedate_t.visible = false
	end if
	if f_stringpreferences("showremarksincreditservice") = "N" then
		this.id_master.object.remarks.visible = false
		this.id_master.object.remarks_t.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5014", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.date.protect = 0
		this.id_master.object.date.background.color = rgb(255, 255, 255)
		this.ib_modifydate = true
	end if
	if not this.ib_modifydate then
		this.id_master.object.date.protect = 1
		this.id_master.settaborder("date", 0)
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 690", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_applydoctorsassociatedservicetemplate.visible = true
		lm_menu.m_file.m_applydoctorsassociatedservicetemplate.enabled = true
	else
		lm_menu.m_file.m_applydoctorsassociatedservicetemplate.visible = false
		lm_menu.m_file.m_applydoctorsassociatedservicetemplate.enabled = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 730", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_applycustomersassociatedservicetemplate.visible = true
		lm_menu.m_file.m_applycustomersassociatedservicetemplate.enabled = true
	else
		lm_menu.m_file.m_applycustomersassociatedservicetemplate.visible = false
		lm_menu.m_file.m_applycustomersassociatedservicetemplate.enabled = false
	end if
	for li_count = 65 to 90
		lc_char = char(li_count)
		this.ia_llookuptable[li_count] = this.id_itemslist.find("Lower(itemname) >= Lower('" + char(li_count) + "')", ll_startrow, 99999)
		ll_startrow = this.ia_llookuptable[li_count]
	next
	this.ia_llookuptable[92] = 99999
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	f_setserviceqtystyle(this.id_detail, "qty")
	setredraw(true)

// w_inpatientservice.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	return ::message.returnvalue

// w_inpatientservice.ue_callback_popupwindow(any ar_object) returns 0 [event]
	long ll_code
	long ll_row
	string as_errortext
	super::ue_callback_popupwindow(ar_object)
	ll_code = long(ar_object)
	ll_row = this.id_detail.getrow()
	if ll_row > 0 and ll_code > 0 then
		this.idc_patient.retrieve()
		if this.id_master.rowcount() > 0 then
			this.id_master.setitem(this.id_master.rowcount(), "admissioncode", ll_code)
		end if
		this.id_master.setfocus()
		this.id_master.setcolumn("admissioncode")
		wf_validate_admissioncode(ll_code)
	end if
	this.id_master.accepttext()

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	return ::message.returnvalue

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
	case "flatdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	end choose
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_code
	long ll_detailrows
	long ll_suppcode
	long ll_custcode
	long ll_counter
	long ll_customerbalance
	long ll_headerinvno
	long rt_code
	long li_custcode
	long li_patientcode
	long li_admissioncode
	long ll_icode
	long ld_saleprice1
	long ld_saleprice2
	long ld_saleprice3
	long ld_avgprice
	long li_packunits
	long ll_patientcode
	string ls_result
	string ls_null
	string ls_aliasname
	string ls_regno
	datetime ld_currdate
	date ld_datepart
	time lt_timepart
	datetime ldt_duedate
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "duedate"
		ldt_duedate = datetime(date(mid(data, 1, 10)), time(mid(data, 12, 8)))
		if isnull(data) or data = "" then
			messagebox("Due Date Validation!", "Please Enter Valid Due Date")
			return 1
		elseif ldt_duedate < datetime(today(), now()) then
			messagebox("Due Date Validation!", "Due Date Must be a future Date~r~nPlease Enter Valid Due Date")
			return 1
		end if
	case "sprice"
		for ll_counter = 1 to parent.parent.parent.id_detail.rowcount()
			ll_icode = parent.parent.parent.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT item.saleprice , item.saleprice2 , item.saleprice2 , item.avgprice , item.packunits INTO :ld_saleprice1, :ld_saleprice2, :ld_saleprice3, :ld_avgprice, :li_packunits FROM item WHERE item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = -1 then
				messagebox("Database Error", "Item information can not be retrieved")
				return 1
			end if
			if not (parent.parent.parent.it_transobject.sqlcode = 100) then
				choose case long(data)
				case 1
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice1 / li_packunits)
				case 2
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice2 / li_packunits)
				case 3
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice3 / li_packunits)
				case else
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_avgprice / li_packunits)
				end choose
			else
				messagebox("DataBase Error", "Rows not retrieve")
				return 1
			end if
		next
	case "headerno"
	case "aliasname"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findcustcode(li_custcode, data)
			if li_res > 0 then
				setitem(row, "custcode", li_custcode)
				if f_stringpreferences("InServiceCustomerBalance") = "Y" then
					for ll_counter = 1 to parent.parent.parent.ids_customersbalance.rowcount()
						if parent.parent.parent.ids_customersbalance.getitemnumber(ll_counter, "code1") = getitemnumber(row, "custcode") then
							ll_customerbalance = parent.parent.parent.ids_customersbalance.getitemnumber(ll_counter, "value1")
							setitem(row, "customerbalance", ll_customerbalance)
							if ll_customerbalance > 0 then
								setitem(row, "debitorcredit", "Dr")
							else
								setitem(row, "debitorcredit", "Cr")
							end if
							exit
						else
							setitem(row, "debitorcredit", "Cr")
							setitem(row, "customerbalance", 0)
						end if
					next
				end if
				rt_code = 0
			else
				messagebox("Customer Validation", "Customer with  Alias Name  " + data + "   does not exist")
				rt_code = 1
			end if
		end if
	case "custcode"
		if not isnull(data) then
			ll_code = long(data)
			parent.setredraw(false)
			if parent.parent.parent.wf_customerinfo(ll_code) <> 0 then
				messagebox("Database Error", "Can not retrieve information of customer from database")
				rt_code = 1
			else
				if accepttext() = -1 then
					return 1
				end if
				ls_aliasname = parent.parent.parent.idc_customers.getitemstring(parent.parent.parent.idc_customers.getrow(), "accounts_aliasname")
				setitem(row, "aliasname", ls_aliasname)
				if f_stringpreferences("InServiceCustomerBalance") = "Y" then
					for ll_counter = 1 to parent.parent.parent.ids_customersbalance.rowcount()
						if parent.parent.parent.ids_customersbalance.getitemnumber(ll_counter, "code1") = getitemnumber(row, "custcode") then
							ll_customerbalance = parent.parent.parent.ids_customersbalance.getitemnumber(ll_counter, "value1")
							setitem(row, "customerbalance", ll_customerbalance)
							if ll_customerbalance > 0 then
								setitem(row, "debitorcredit", "Dr")
							else
								setitem(row, "debitorcredit", "Cr")
							end if
							exit
						else
							setitem(row, "debitorcredit", "Cr")
							setitem(row, "customerbalance", 0)
						end if
					next
				end if
			end if
			parent.setredraw(true)
		end if
	case "patientregno"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findadmissioncode(data, li_admissioncode)
			if li_res > 0 then
				setitem(row, "admissioncode", li_admissioncode)
				rt_code = 0
				if parent.parent.parent.ii_servicetype = 11 then
					SQL SELECT patient.custcode , accounts.aliasname INTO :ll_custcode, :ls_aliasname FROM patient , patientadmission , accounts WHERE patientadmission.discharged1 ='N' and patientadmission.discharged ='N' and patientadmission.admissioncode =:li_admissioncode and patient.patientcode =patientadmission.patientcode and patient.custcode =accounts.acccode USING parent.parent.parent.it_transobject;
					if parent.parent.parent.it_transobject.sqlcode = 0 then
						parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
						parent.parent.parent.id_master.setitem(1, "aliasname", ls_aliasname)
						parent.parent.parent.id_master.object.custcode.protect = 1
						parent.parent.parent.id_master.object.aliasname.protect = 1
						parent.parent.parent.wf_setadmissiondetails(li_admissioncode)
						if f_stringpreferences("InServiceCustomerBalance") = "Y" then
							for ll_counter = 1 to parent.parent.parent.ids_customersbalance.rowcount()
								if parent.parent.parent.ids_customersbalance.getitemnumber(ll_counter, "code1") = getitemnumber(row, "custcode") then
									ll_customerbalance = parent.parent.parent.ids_customersbalance.getitemnumber(ll_counter, "value1")
									setitem(row, "customerbalance", ll_customerbalance)
									if ll_customerbalance > 0 then
										setitem(row, "debitorcredit", "Dr")
									else
										setitem(row, "debitorcredit", "Cr")
									end if
									exit
								else
									setitem(row, "debitorcredit", "Cr")
									setitem(row, "customerbalance", 0)
								end if
							next
						end if
					else
						messagebox("Patient Information", "Problem in retrieving corresponding customer")
						rt_code = 1
					end if
				end if
			else
				messagebox("Patient Validation", "Patient with  RegNo  " + data + " does not exist")
				rt_code = 1
			end if
		end if
	case "admissioncode"
		return parent.parent.parent.wf_validate_admissioncode(long(data))
	case "salecatcode"
		if integer(data) = 1 then
			setnull(ls_null)
			setitem(row, "custcode", 22)
			parent.parent.parent.id_master.object.address[row] = ls_null
			parent.parent.parent.id_master.object.city[row] = ls_null
			parent.parent.parent.id_master.object.phone[row] = ls_null
		end if
		return rt_code
	end choose
	return rt_code

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "date"
		messagebox("Date Time Validation", "Date and Time is invalid,~r~nPlease enter current date and time")
	case "custcode"
		messagebox("Customer Name Validation", "You must select some Customer")
	case "custrefno"
		if data = "" or isnull(data) then
			messagebox("Customer Reference Validation", "Please Enter Reference")
		end if
	case "headerno"
		if data = "" or isnull(data) then
			messagebox("Header No Validation", "You must select some HeaderNo")
		end if
	case "Regno"
		if data = "" or isnull(data) then
			messagebox("Patient Validation", "RegNo Does Not Exist")
		end if
	end choose
	return 1

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	long ll_found
	long ll_admissioncode
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if getcolumnname() = "admissioncode" then
		if key = keyf5! then
			ll_found = gds_security.find("rightcode = 369 OR rightcode = 1220 ", 1, gds_security.rowcount())
			if ll_found > 0 then
				parent.parent.parent.wf_open_item_form_popup()
			end if
		elseif key = keyf6! then
			ll_admissioncode = parent.parent.parent.id_master.object.admissioncode[1]
			openwithparm(w_mr_patient_prescription_view, ll_admissioncode)
		elseif key = keyf9! then
			parent.parent.parent.wf_show_patientgallery()
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	integer li_servicecode
	long ll_newqty
	long ll_storedqty
	long ll_stock
	long ll_null
	long ll_icode
	long ll_gcode
	string ls_null
	string ls_itemname
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
		parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		li_errcode = 0
	case "fullcode"
		if isnull(data) or data = "" then
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			setitem(row, "itemname", ls_itemname)
			li_errcode = 2
		else
			li_res = parent.parent.parent.wf_find_service_fullcode(data, ll_icode, ls_itemname)
			if li_res > 0 then
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				setitem(row, "qty", 1)
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
				if parent.parent.parent.wf_validateitem(false) = 0 then
					li_errcode = 0
				else
					li_errcode = 1
				end if
			else
				messagebox("Service Code/Alias Name Validation", "Service does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				setitem(row, "itemname", ls_itemname)
				li_errcode = 1
			end if
		end if
	case "qty"
		if double(data) > 0.0 then
			if double(long(data)) <> double(data) and parent.parent.parent.id_detail.object.allowsaleindecimal[row] = "N" then
				messagebox("Quantity Validation", "Quantity In decimals is not allowed for this service", stopsign!)
				li_errcode = 1
			else
				li_errcode = 0
			end if
		else
			messagebox("Quantity Validation", "Please enter a valid Quantity for this service", stopsign!)
			li_errcode = 1
		end if
	case "saleprice"
		if upper(this.object.lockprice[row]) = "Y" then
			messagebox("Service Price Validation", "Service Price is locked for this service.~r~nIts Basic Data does not permit service price change.", stopsign!)
			li_errcode = 1
		elseif double(data) >= 0.0 then
			if double(data) > 0.0 then
				this.object.prediscperc[row] = round(this.object.serviceflatdisc[row] / double(data) * 100, 2)
			else
				this.object.prediscperc[row] = 100
			end if
			li_errcode = 0
		else
			messagebox("Service Price Validation", "Please enter a valid Service Price for this service", stopsign!)
			li_errcode = 1
		end if
	case "prediscperc"
		if double(data) < 0.0 or isnull(data) or double(data) > 100.0 then
			messagebox("Pre-Disc. %age Validation", "Pre-Disc. %age must be a valid value [Range 0-100]")
			return 1
		else
			this.object.serviceflatdisc[row] = round(this.object.saleprice[row] * double(data) * 0.01, 2)
			return 0
		end if
	case "serviceflatdisc"
		if upper(this.object.lockserviceflatdisc[row]) = "Y" then
			messagebox("Service Flat Discount Validation", "Service Flat Discount is locked for this service.~r~nIts Basic Data does not permit Service Flat Discount change.", stopsign!)
			li_errcode = 1
		elseif double(data) >= 0.0 then
			if this.object.saleprice[row] > 0 then
				this.object.prediscperc[row] = round(double(data) / this.object.saleprice[row] * 100, 2)
			else
				this.object.prediscperc[row] = round(double(data), 2)
			end if
			li_errcode = 0
		else
			messagebox("Service Flat Discount Validation", "Please enter a valid Service Flat Discount for this service", stopsign!)
			li_errcode = 1
		end if
	case "discperc"
		if upper(this.object.lockdiscperc[row]) = "Y" then
			messagebox("Service Discount % Validation", "Service Discount % is locked for this service.~r~nIts Basic Data does not permit Service Discount % change.", stopsign!)
			li_errcode = 1
		elseif double(data) >= 0.0 then
			li_errcode = 0
		else
			messagebox("Service Discount % Validation", "Please enter a valid Service Discount % for this service", stopsign!)
			li_errcode = 1
		end if
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ll_icode
	long ll_gcode
	long ll_godownstock
	long ancestorreturnvalue
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(false) = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "itemname" then
		parent.parent.parent.ib_focusdetail = true
		parent.parent.parent.id_itemslist.show()
	else
		parent.parent.parent.ib_focusdetail = true
		parent.parent.parent.id_itemslist.hide()
	end if
	parent.parent.parent.wf_grandtotal()
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return 0

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(true) = -1 then
		return ::message.returnvalue
	end if
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if getcolumnname() <> parent.parent.parent.is_columnitemname then
		if rowcount() > 0 and lrs_status <> new! then
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", getitemnumber(currentrow, "icode"))
		elseif parent.parent.parent.id_footer.getrow() > 0 then
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", 0)
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	parent.parent.parent.id_itemslist.hide()
	parent.parent.parent.ib_itemslistopen = false
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		if data = "" or isnull(data) then
			messagebox("Service Validation", "Please enter value for Service in row " + string(row))
		end if
	case "discperc"
		if real(data) < 0.0 and real(data) > 100.0 then
			messagebox("Service Discount Validation", "Discount ~"" + data + "~" must be betweeen 0 and 100")
		end if
	case "smancode"
		messagebox("SalesPerson Validation", "Please select SalesPerson from the dropdown box.")
	end choose
	return 1

// dw_itemsdetail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	return ::message.returnvalue

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ll_currrow
	long ll_startrow
	long ll_endrow
	if parent.parent.parent.editflag = false then
		parent.parent.parent.editflag = true
		parent.parent.parent.im_menu.m_file.m_save.enabled = true
	end if
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		if upper(left(data, 1)) >= "A" and upper(left(data, 1)) <= "Z" or left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
			ll_currrow = parent.parent.parent.id_itemslist.getrow()
			if len(data) > 1 then
				ll_startrow = ll_currrow
			else
				if left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
					ll_startrow = 1
				else
					ll_startrow = parent.parent.parent.ia_llookuptable[asc(upper(data))]
				end if
				parent.parent.parent.ib_bkspace = false
			end if
			if parent.parent.parent.ib_bkspace then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.find("Lower(itemname) <= '" + lower(data) + "'", ll_startrow, 0)
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.il_itemlistfoundrow + 1
				parent.parent.parent.ib_bkspace = false
			else
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.find("Lower(itemname) >= '" + lower(data) + "'", ll_startrow, 99999)
			end if
			if parent.parent.parent.il_itemlistfoundrow = 0 then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.rowcount()
			end if
			if parent.parent.parent.il_itemlistfoundrow <> ll_currrow then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.setrow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_itemslist.scrolltorow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_itemslist.selectrow(parent.parent.parent.il_itemlistfoundrow, true)
				ll_endrow = setitem(row, "currlistrow", parent.parent.parent.il_itemlistfoundrow)
				ll_endrow = getitemnumber(row, "currlistrow")
				setfocus()
			end if
		end if
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	end choose
	if getcolumn() = 1 then
		parent.parent.parent.is_aliasname = data
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_icode
	long ll_found
	long ll_rowm
	string ls_date
	string ls_temp
	date ld_dt
	datetime ldt_dt
	time lt_tm
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(parent.parent.parent.id_itemslist.rowcount())
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(1)
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf4! then
			parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
			setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
			setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	elseif key = keydownarrow! then
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_focusfooter")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	end if
	if key = keyf4! and getcolumnname() = "deliverydate" and getrow() > 0 then
		ls_temp = string(this.object.deliverydate[getrow()], "dd/mm/yyyy hh:mm:ss")
		ls_date = left(ls_temp, 10)
		openwithparm(w_calendar, ls_date)
		ls_date = message.stringparm
		if not (ls_date = "" or isnull(ls_date)) then
			ls_temp = mid(ls_date, 7, 4) + "-" + left(ls_date, 2) + "-" + mid(ls_date, 4, 2) + " " + right(ls_temp, 8)
			ld_dt = date(mid(ls_date, 7, 4) + "-" + left(ls_date, 2) + "-" + mid(ls_date, 4, 2))
			lt_tm = time(right(ls_temp, 8))
			ldt_dt = datetime(ld_dt, lt_tm)
			this.object.deliverydate[getrow()] = ldt_dt
		end if
	end if
	return rt_code

// dw_itemsdetail.ue_enterkey() returns long [event]
	integer li_rowno
	integer i
	integer li_columnno = 1
	li_columnno = integer(this.object.discperc.id)
	if getrow() = rowcount() then
		if getcolumn() = li_columnno then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
	elseif li_columnno = integer(this.object.datawindow.column.count) and getcolumn() = li_columnno then
		scrollnextrow()
		if f_stringpreferences("ItemCode") = "Y" then
			setcolumn("fullcode")
		else
			setcolumn("itemname")
		end if
		setfocus()
		return 1
	end if
	li_rowno = parent.parent.parent.id_itemslist.find("fullcode='" + parent.parent.parent.is_aliasname + "'", 1, parent.parent.parent.id_itemslist.rowcount())
	if getcolumn() = 1 and li_rowno > 0 and li_rowno <= parent.parent.parent.id_itemslist.rowcount() then
		if isnull(parent.parent.parent.is_aliasname) or parent.parent.parent.is_aliasname = "" then
			setcolumn("itemname")
		else
			setcolumn("qty")
		end if
		setfocus()
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_itemsdetail.getfocus() returns long [event]
	if f_stringpreferences("itemcode") = "N" and getrow() > 0 then
		parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
		setredraw(true)
	end if
	return ::message.returnvalue
