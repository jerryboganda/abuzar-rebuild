// window w_inpatientservicereturn (ipservices)  ancestor: w_multi_entry

// w_inpatientservicereturn.ue_accepttext() returns 0 [event]
	if this.id_detail.accepttext() = -1 then
		this.id_detail.setfocus()
	end if

// w_inpatientservicereturn.ue_save_withnocommit() returns long [event]
	setpointer(hourglass!)
	if f_validatedw(this.id_master) < 0 then
		return -1
	end if
	if f_validatedw(this.id_detail) < 0 then
		return -2
	end if
	if this.id_master.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -3
	end if
	if this.id_detail.update() < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -4
	end if
	setpointer(arrow!)
	return 0

// w_inpatientservicereturn.wf_visible(boolean ab_flag) returns 0
	this.id_footer.object.stock.visible = ab_flag
	this.id_footer.object.t_stock.visible = ab_flag
	if not this.ib_opensalereturn then
		this.id_footer.object.retableqty.visible = ab_flag
		this.id_footer.object.t_retableqty.visible = ab_flag
		this.id_footer.object.saleqty.visible = ab_flag
		this.id_footer.object.t_saleqty.visible = ab_flag
	end if

// w_inpatientservicereturn.wf_visibleinvisiblediscount() returns integer
	this.id_detail.object.discperc.visible = 0
	return 1

// w_inpatientservicereturn.wf_updatesalereturnitemsstock(long al_saleretinvcode, ref string as_errtext, ref long al_errrow) returns integer
	long ll_detailrows
	long ll_gcode
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode = 1
	long li_counter
	long li_innercounter
	long ll_row
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_stock
	double ld_newstock
	double ld_saleretqty
	string ls_batch
	datetime ld_expiry
	integer li_errcode = 1
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	as_errtext = "    Some database problem ocuurs         "
	do while li_counter <= ll_detailrows and li_errcode = 0
		ll_gcode = this.id_detail.getitemnumber(li_counter, "gcode")
		ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
		ld_saleretqty = this.id_detail.getitemnumber(li_counter, "looseqty")
		ll_packunits = this.id_detail.getitemnumber(li_counter, "packunits")
		ld_saleprice = this.id_detail.getitemnumber(li_counter, "saleprice")
		ld_discperc = this.id_detail.getitemnumber(li_counter, "discperc")
		ls_batch = this.id_detail.getitemstring(li_counter, "batch")
		ld_expiry = this.id_detail.getitemdatetime(li_counter, "expiry")
		ld_stock = this.id_detail.getitemnumber(li_counter, "stock")
		this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
			if this.it_transobject.sqlcode = 0 then
				ld_newstock = ld_stock + ld_saleretqty
				this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
				if this.it_transobject.sqlcode <> 0 then
					li_errcode = -1
				end if
			else
				li_errcode = -1
			end if
		else
			li_errcode = -1
		end if
		li_counter = li_counter + 1
	loop
	al_errrow = li_counter - 1
	return li_errcode

// w_inpatientservicereturn.wf_validatefullcode(string as_fullcode, long al_currrow) returns integer
	return 0

// w_inpatientservicereturn.wf_setsalereturntype(integer ai_salerettype, boolean ab_opensaleret) returns 0
	this.ii_servicerettype = ai_salerettype
	this.ib_openservicereturn = ab_opensaleret

// w_inpatientservicereturn.wf_showlist(long al_listcurrrow) returns 0
	this.id_itemslist.hide()
	this.id_detail.setfocus()
	this.ib_itemslistopen = false

// w_inpatientservicereturn.wf_validateitem() returns integer
	long ll_servicecode
	long ll_dddwrow
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_null
	string ls_null
	if not this.ib_openservicereturn then
		ll_servicecode = this.id_detail.object.servicecode[this.id_detail.getrow()]
		ll_dddwrow = this.idc_itemdddw.find("servicecode = " + string(ll_servicecode) + " and (qty - returnqty) > 0", 1, this.idc_itemdddw.rowcount())
		if ll_dddwrow > 0 and ll_dddwrow <= this.idc_itemdddw.rowcount() then
			if wf_inititeminfo(this.idc_itemdddw, this.id_detail.getrow(), ll_dddwrow, ls_errtext) = 0 then
				li_errcode = 0
			else
				li_errcode = -1
			end if
		else
			ls_titleerrtext = "Service Validation"
			li_errcode = -1
		end if
	else
		ll_servicecode = this.id_detail.getitemnumber(this.id_detail.getrow(), "servicecode")
		if wf_inititeminfo(ll_servicecode, this.id_detail.getrow(), ls_errtext) <> 0 then
			ls_titleerrtext = "Service Validation"
			li_errcode = -1
		end if
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		if this.ib_opensalereturn then
			this.id_detail.setcolumn(this.is_columnitemname)
		else
			this.id_detail.setcolumn("servicecode")
		end if
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.servicecode[this.il_currrow] = li_null
		this.id_detail.setitem(this.il_currrow, this.is_columnitemname, ls_null)
		messagebox(ls_titleerrtext, ls_errtext)
	end if
	return li_errcode

// w_inpatientservicereturn.wf_customername(long al_custcode) returns integer
	string ls_custname
	string ls_aliasname
	SQL SELECT accounts.name , accounts.aliasname INTO :ls_custname, :ls_aliasname FROM accounts WHERE accounts.acccode =:al_custcode USING this.it_transobject;
	this.id_master.object.custname[this.id_master.getrow()] = ls_custname
	this.id_master.object.aliasname[this.id_master.getrow()] = ls_aliasname
	return this.it_transobject.sqlcode

// w_inpatientservicereturn.wf_customerinfo(long al_custcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	SQL SELECT customer.address1 , customer.city , customer.phone INTO :ls_address, :ls_city, :ls_phone FROM customer WHERE customer.custcode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
		this.id_master.object.custcode[ll_currow] = al_custcode
		this.id_master.object.address[ll_currow] = ls_address
		this.id_master.object.city[ll_currow] = ls_city
		this.id_master.object.phone[ll_currow] = ls_phone
	end if
	return this.it_transobject.sqlcode

// w_inpatientservicereturn.wf_deleteemptydetailrow() returns integer
	long ll_rowcount
	integer li_rtcode
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 0 and isnull(this.id_detail.getitemnumber(ll_rowcount, "servicecode")) then
		this.id_detail.deleterow(ll_rowcount)
		li_rtcode = 1
		this.ib_itemslistopen = false
		this.id_itemslist.hide()
		setfocus()
	end if
	return li_rtcode

// w_inpatientservicereturn.wf_duplicaterow(long al_currrow) returns boolean
	boolean lb_duplicate
	string ls_batch
	datetime ld_expiry
	long ll_gcode
	long ll_servicecode
	ll_servicecode = this.id_detail.getitemnumber(al_currrow, "servicecode")
	if not isnull(ll_servicecode) and vf_dwdupcode1(this.id_detail, "servicecode", string(ll_servicecode), al_currrow) then
		lb_duplicate = true
	end if
	return lb_duplicate

// w_inpatientservicereturn.wf_editsaleinvoice() returns integer
	long ll_rowcount
	long ll_counter
	long ll_serviceinvcode
	long ll_rowscopy
	long ll_returneditems
	long ll_erroritems
	string ls_errtext
	integer li_errcode
	this.id_detail.setredraw(false)
	this.id_detail.reset()
	ll_serviceinvcode = this.id_master.getitemnumber(this.id_master.getrow(), "serviceinvcode")
	this.ib_itemvalidated = true
	this.id_detail.insertrow(0)
	ll_rowcount = this.idc_itemdddw.rowcount()
	ll_rowscopy = 1
	for ll_counter = 1 to ll_rowcount
		li_errcode = wf_inititeminfo(this.idc_itemdddw, ll_serviceinvcode, ll_counter, ll_rowscopy, ls_errtext)
		if li_errcode = 1 then
			ll_returneditems = ll_returneditems + 1
		elseif li_errcode = -1 then
			ll_erroritems = ll_erroritems + 1
		else
			ll_rowscopy = ll_rowscopy + 1
			this.id_detail.insertrow(0)
		end if
	next
	this.id_detail.deleterow(ll_rowscopy)
	messagebox("Edit Service Invoice Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowscopy - 1) + " records were retrieved successfully~n~r" + string(ll_returneditems) + " records has already been returned~n~r" + string(ll_erroritems) + " record's database info. cannot be retrieved")
	if ll_rowscopy - 1 > 0 then
		wf_setfooterinfo(ll_serviceinvcode)
		this.im_menu.m_file.m_save.enabled = true
		this.id_detail.scrolltorow(0)
		this.id_detail.setcolumn(1)
		this.id_detail.setfocus()
		wf_grandtotal()
	end if
	this.id_detail.setredraw(true)
	return ll_rowscopy

// w_inpatientservicereturn.wf_find_header_no(long al_saleinvcode) returns integer
	integer li_header_no
	SQL SELECT SaleLedger.headerno INTO :li_header_no FROM SaleLedger WHERE SaleLedger.Saleinvcode =:al_saleinvcode USING this.it_transobject;
	return li_header_no

// w_inpatientservicereturn.wf_findfullcode(string as_fullcode, ref long al_icode, ref string al_itemname) returns integer
	integer ll_icode
	integer ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_inpatientservicereturn.wf_findretailsaleinvoice(long al_saleinvcode, ref datetime ad_date, ref string as_errtext) returns integer
	integer li_rtcode
	long ll_admissioncode
	string ls_posted
	SQL SELECT Serviceheader.date , posted , admissioncode INTO :ad_date, :ls_posted, :ll_admissioncode FROM ServiceHeader WHERE ServiceHeader.Serviceinvcode =:al_saleinvcode AND ServiceHeader.ServiceCatCode =10 USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ls_posted) then
			as_errtext = "You must select some valid Retail Service Invoice"
			li_rtcode = 1
		elseif ls_posted = "Y" then
			li_rtcode = 0
		else
			li_rtcode = 1
			as_errtext = "Service invoice " + string(al_saleinvcode) + " is unposted~n~rOnly Posted invoices can be returned"
		end if
		if li_rtcode = 0 and not isnull(ll_admissioncode) then
			li_rtcode = 1
			as_errtext = "Can not return Service invoice " + string(al_saleinvcode) + " here~n~rPlease Use In-Patient Service Return Module"
		end if
	else
		li_rtcode = 1
		as_errtext = "Database Error, Some database request fails"
	end if
	return li_rtcode

// w_inpatientservicereturn.wf_findunpostedsalereturns(long al_saleinvcode, ref string as_errtext) returns integer
	integer li_rtcode
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM servicerheader WHERE servicerheader.serviceinvcode =:al_saleinvcode AND servicerheader.posted ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_count > 0 then
			li_rtcode = 1
			as_errtext = "Some Unposted Sale Return invoice already exist,~n~rModify that invoice"
		end if
	else
		li_rtcode = 1
		as_errtext = "Database Error, Some database request fails"
	end if
	return li_rtcode

// w_inpatientservicereturn.wf_findwholesaleinvoice(long al_saleinvcode, ref datetime ad_date, ref string as_errtext) returns integer
	integer li_rtcode
	string ls_posted
	long ll_admissioncode
	SQL SELECT ServiceHeader.date , Posted , admissioncode INTO :ad_date, :ls_posted, :ll_admissioncode FROM ServiceHeader WHERE ServiceHeader.Serviceinvcode =:al_saleinvcode AND ( ServiceHeader.ServiceCatCode =11 OR ServiceHeader.ServiceCatCode =12 ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ls_posted) then
			as_errtext = "You must select some valid Whole Sale Invoice"
			li_rtcode = 1
		elseif ls_posted = "Y" then
			li_rtcode = 0
		else
			li_rtcode = 1
			as_errtext = "Service invoice " + string(al_saleinvcode) + " is unposted~n~rOnly Posted invoices can be returned"
		end if
		if li_rtcode = 0 and not isnull(ll_admissioncode) then
			li_rtcode = 1
			as_errtext = "Can not return Service invoice " + string(al_saleinvcode) + " here~n~rPlease Use In-Patient Service Return Module"
		end if
	else
		li_rtcode = 1
		as_errtext = "Database Error, Some database request fails"
	end if
	return li_rtcode

// w_inpatientservicereturn.wf_genfullcode(long al_icode, ref string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	long iccode
	long icatcode
	long packcode
	long manfcode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_inpatientservicereturn.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	real lr_discperc
	real lr_flatdisc
	real lr_misccharges
	real lr_salestax
	real lr_itemstotal
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		lr_discperc = this.id_footer.object.discperc[1]
		lr_flatdisc = this.id_footer.object.flatdisc[1]
		lr_misccharges = this.id_footer.object.misccharges[1]
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
		ld_grandtotal = ld_detaildwtotal * (1.0 - lr_discperc * 0.01) - lr_flatdisc + lr_misccharges + lr_salestax
		ld_grandtotal = round(ld_grandtotal, 0)
		this.id_footer.setitem(1, "total", ld_grandtotal)
	end if
	return ld_grandtotal

// w_inpatientservicereturn.wf_inititeminfo(datawindowchild adc_itemdddw, long al_saleinvcode, long al_dsrow, long al_detaildwrow, ref string as_errtext) returns integer
	long ll_servicecode
	long ll_gcode
	long ll_packunits
	double ld_itemprevqty
	double ld_itemsaleqty
	double ld_retableqty
	double ld_serviceprice
	double ld_discperc
	double ld_costprice
	double ld_flatdisc
	string ls_fullcode
	string ls_batch
	string ls_allowsaleindecimal
	datetime ld_expiry
	integer li_errcode
	ll_servicecode = adc_itemdddw.getitemnumber(al_dsrow, "servicecode")
	ld_serviceprice = adc_itemdddw.getitemnumber(al_dsrow, "serviceprice")
	ld_discperc = adc_itemdddw.getitemnumber(al_dsrow, "discperc")
	ld_flatdisc = adc_itemdddw.getitemnumber(al_dsrow, "serviceflatdisc")
	ls_allowsaleindecimal = adc_itemdddw.getitemstring(al_dsrow, "allowsaleindecimal")
	ld_costprice = adc_itemdddw.getitemnumber(al_dsrow, "costprice")
	if wf_itemprevretqty(al_saleinvcode, ll_gcode, ll_servicecode, ld_itemprevqty) = 0 then
		if ld_itemprevqty = 0.0 then
			this.id_detail.setitem(al_detaildwrow, "servicecode", ll_servicecode)
			this.id_detail.setitem(al_detaildwrow, "serviceprice", ld_serviceprice)
			this.id_detail.setitem(al_detaildwrow, "discperc", ld_discperc)
			this.id_detail.setitem(al_detaildwrow, "serviceflatdisc", ld_flatdisc)
			this.id_detail.setitem(al_detaildwrow, "allowsaleindecimal", ls_allowsaleindecimal)
			this.id_detail.setitem(al_detaildwrow, "costprice", ld_costprice)
		else
			as_errtext = "Service has already been returned"
			li_errcode = 1
		end if
	else
		li_errcode = -1
		as_errtext = "Service invoice information can not retrieve"
	end if
	return li_errcode

// w_inpatientservicereturn.wf_inititeminfo(long al_icode, long al_row, ref string as_errortext) returns integer
	double ld_saleprice
	double ld_discperc
	long ll_packunits
	long ll_saleinvcode
	integer li_gcode
	integer retflag
	string ls_fullcode
	string ls_name
	double ld_godownstock
	double ld_saleqty
	li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
	SQL SELECT item.customicode , item.name , item.saleprice , item.packunits , item.salediscperc INTO :ls_fullcode, :ls_name, :ld_saleprice, :ll_packunits, :ld_discperc FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
		if this.it_transobject.sqlcode = 0 then
			this.id_detail.setitem(al_row, "gcode", li_gcode)
			this.id_detail.setitem(al_row, "icode", al_icode)
			this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
			this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
			this.id_detail.setitem(al_row, "srprice", ld_saleprice / ll_packunits)
			this.id_detail.setitem(al_row, "packunits", ll_packunits)
			this.id_detail.setitem(al_row, "discperc", ld_discperc)
			this.id_detail.setitem(al_row, "stock", ld_godownstock)
			this.id_footer.setitem(1, "stock", ld_godownstock)
		else
			retflag = -1
			as_errortext = "Database Error: Item Stock information can not be retrieved"
		end if
	else
		retflag = -1
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	return retflag

// w_inpatientservicereturn.wf_inititeminfo(ref datawindowchild adc_itemdddw, long al_row, long al_dddwrow, ref string as_errtext) returns integer
	long ll_servicecode
	long ll_gcode
	long ll_packunits
	long ll_serviceinvcode
	long ll_smancode
	long ll_srvrowid
	double ld_serviceprice
	double ld_discperc
	double ld_costprice
	double ld_flatdisc
	double ld_retableqty
	double ld_itemprevqty
	double ld_itemsaleqty
	double ld_oninvoiceitemretqty
	double ld_qty
	double ld_retqty
	double ld_shareperc
	double ld_commission
	string ls_fullcode
	string ls_batch
	string ls_allowsaleindecimal
	datetime ld_expiry
	integer li_errcode
	integer li_ret
	ll_serviceinvcode = this.id_master.getitemnumber(this.id_master.getrow(), "serviceinvcode")
	ls_fullcode = this.idc_itemdddw.getitemstring(al_dddwrow, "FullCode")
	ll_servicecode = this.idc_itemdddw.getitemnumber(al_dddwrow, "servicecode")
	ld_serviceprice = this.idc_itemdddw.getitemnumber(al_dddwrow, "serviceprice")
	ld_discperc = this.idc_itemdddw.getitemnumber(al_dddwrow, "discperc")
	ld_flatdisc = this.idc_itemdddw.getitemnumber(al_dddwrow, "serviceflatdisc")
	ls_allowsaleindecimal = this.idc_itemdddw.getitemstring(al_dddwrow, "allowsaleindecimal")
	ld_costprice = this.idc_itemdddw.getitemnumber(al_dddwrow, "costprice")
	ll_srvrowid = this.idc_itemdddw.getitemnumber(al_dddwrow, "srvrowid")
	ll_smancode = this.idc_itemdddw.getitemnumber(al_dddwrow, "smancode")
	ld_shareperc = this.idc_itemdddw.getitemnumber(al_dddwrow, "shareperc")
	ld_commission = this.idc_itemdddw.getitemnumber(al_dddwrow, "commission")
	ld_qty = this.idc_itemdddw.getitemnumber(al_dddwrow, "qty")
	li_ret = wf_itemprevretqty(ll_serviceinvcode, ll_srvrowid, ll_servicecode, ld_itemprevqty)
	if li_ret = 0 or li_ret = 100 then
		wf_oninvoiceitemprevretqty(al_row, ll_servicecode, ll_srvrowid, ld_oninvoiceitemretqty)
		ld_retqty = ld_itemprevqty + ld_oninvoiceitemretqty
		if ld_retqty < ld_qty then
			this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
			this.id_detail.setitem(al_row, "servicecode", ll_servicecode)
			this.id_detail.setitem(al_row, "serviceprice", ld_serviceprice)
			this.id_detail.setitem(al_row, "serviceflatdisc", ld_flatdisc)
			this.id_detail.setitem(al_row, "allowsaleindecimal", ls_allowsaleindecimal)
			this.id_detail.setitem(al_row, "smancode", ll_smancode)
			this.id_detail.setitem(al_row, "serviceqty", ld_qty)
			this.id_detail.setitem(al_row, "qty", ld_qty - ld_retqty)
			this.id_detail.setitem(al_row, "srvrowid", ll_srvrowid)
			this.id_detail.setitem(al_row, "discperc", ld_discperc)
			this.id_detail.setitem(al_row, "commission", ld_commission)
			this.id_detail.setitem(al_row, "shareperc", ld_shareperc)
			this.id_detail.setitem(al_row, "costprice", ld_costprice)
			this.id_detail.setitem(al_row, "retqty", ld_itemprevqty)
		else
			as_errtext = "Service has already been returned"
			li_errcode = 1
		end if
	else
		li_errcode = -1
		as_errtext = "Service invoice information can not retrieve"
	end if
	return li_errcode

// w_inpatientservicereturn.wf_initmodify(ref integer ai_protect) returns 0

// w_inpatientservicereturn.wf_locksaleinvoice(long al_saleinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From serviceheader WITH ( UPDLOCK HOLDLOCK ) Where serviceheader.serviceinvcode =:al_saleinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_inpatientservicereturn.wf_locksaleretinvoice(long al_saleretinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From srledger WITH ( UPDLOCK HOLDLOCK ) Where srledger.srinvcode =:al_saleretinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_inpatientservicereturn.wf_locksrinvoices(long al_sinvcode, long al_linvcode) returns integer
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM servicerheader WITH ( UPDLOCK HOLDLOCK ) WHERE servicerheader.servicerinvcode Between :al_sinvcode and :al_linvcode USING sqlca;
	return sqlca.sqlcode

// w_inpatientservicereturn.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to 1 step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_inpatientservicereturn.wf_retrievelist() returns long
	string[] ls_posted
	integer li_serviceretcategory
	ls_posted[1] = "N"
	if this.ii_servicerettype = 7 then
		li_serviceretcategory = this.ii_serviceretcategory
	else
		li_serviceretcategory = this.ii_servicerettype
	end if
	return this.id_list.retrieve(li_serviceretcategory, ls_posted)

// w_inpatientservicereturn.wf_retrievelistall() returns long
	string[] ls_posted
	integer li_serviceretcategory
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_servicerettype = 14 then
		li_serviceretcategory = this.ii_serviceretcategory
	else
		li_serviceretcategory = this.ii_servicerettype
	end if
	return this.id_list.retrieve(li_serviceretcategory, ls_posted)

// w_inpatientservicereturn.wf_returnsaleretinvoice() returns integer
	return 1

// w_inpatientservicereturn.wf_selectprintreport() returns string
	string ls_pagesize
	string ls_report
	boolean lb_listtab
	integer li_headerno
	if lb_listtab then
		li_headerno = this.id_list.getitemnumber(this.id_list.getrow(), "headerno")
	else
		li_headerno = this.id_master.getitemnumber(1, "headerno")
	end if
	ls_report = this.id_print.dataobject
	ls_pagesize = f_stringpreferences("creditservicepagesize")
	if ls_pagesize = "Q" then
		ls_report = "d_inpatient_serviceretinvrep"
	elseif ls_pagesize = "H" then
		if gs_company = "KHYBER" then
			ls_report = "d_khyber_inpatient_serviceretinvrep_half"
		elseif gs_company = "FATIMAPHARMACY" then
			ls_report = "d_fatimapharmacy_inpatientserviceretrep"
		elseif gs_company = "HABIBMEDICAL" then
			ls_report = "d_habibmedical_ipserviceretinvrep_half"
		else
			ls_report = "d_inpatient_serviceretinvrep_half"
		end if
	elseif ls_pagesize = "F" then
		if gs_company = "FAISALMEMORIAL" then
			ls_report = "d_faisalmemorial_ipserviceretinvrep_full"
		else
			ls_report = "d_inpatient_serviceretinvrep_full"
		end if
	end if
	this.id_print.dataobject = ls_report
	this.id_print.settransobject(this.it_transobject)
	f_set_headerlogo_service(this.id_print, li_headerno)
	return ls_report

// w_inpatientservicereturn.wf_setfooterinfo(long al_saleinvcode) returns 0
	double ld_discperc
	double ld_flatdisc
	double ld_misccharges
	SQL SELECT serviceheader.discperc , serviceheader.flatdisc , serviceheader.misccharges INTO :ld_discperc, :ld_flatdisc, :ld_misccharges FROM serviceheader WHERE serviceheader.serviceinvcode =:al_saleinvcode USING sqlca;
	this.id_footer.setitem(1, "discperc", ld_discperc)
	this.id_footer.setitem(1, "flatdisc", ld_flatdisc)
	this.id_footer.setitem(1, "misccharges", ld_misccharges)

// w_inpatientservicereturn.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_inpatientservicereturn.wf_setsaleinvinfo(long al_saleinvcode, ref long al_custcode) returns 0
	long ll_salecatcode
	long ll_row
	long ll_patientcode
	datetime ld_date
	SQL SELECT serviceheader.custcode , serviceheader.date , serviceheader.servicecatcode , patientcode INTO :al_custcode, :ld_date, :ll_salecatcode, :ll_patientcode FROM serviceheader WHERE serviceheader.serviceinvcode =:al_saleinvcode USING this.it_transobject;
	ll_row = this.id_master.getrow()
	this.id_master.object.serviceinvdate[ll_row] = ld_date
	this.id_master.object.patientcode[ll_row] = ll_patientcode

// w_inpatientservicereturn.wf_findregno(long al_patientcode) returns string
	string ls_regno
	SQL SELECT regno INTO :ls_regno FROM Patient WHERE Patient.PatientCode =:al_patientcode and patientcode IN ( select distinct patientcode from patientadmission where patientcode =:al_patientcode and discharged ='N' ) USING this.it_transobject;
	return ls_regno

// w_inpatientservicereturn.wf_validatesaleinvcode(long al_row, long al_saleinvcode) returns integer
	long ll_detailrows
	long ll_custcode
	integer li_rtcode
	integer li_result
	integer li_header_no
	datetime ld_datetime
	boolean lb_rtflag
	string ls_errtext
	string ls_batch
	dwitemstatus lrs_status
	if not isnull(al_saleinvcode) and al_saleinvcode > 0 then
		this.im_menu.m_file.m_options.enabled = true
		ll_detailrows = this.id_detail.rowcount()
		if ll_detailrows > 0 then
			lrs_status = this.id_detail.getitemstatus(1, 0, primary!)
			if lrs_status <> new! and not isnull(this.id_detail.getitemnumber(1, "servicecode")) then
				li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
				if li_result = 2 then
					li_rtcode = 2
				else
					this.id_detail.setredraw(false)
					this.id_detail.reset()
					this.id_detail.insertrow(0)
					this.id_detail.setfocus()
					this.id_detail.setredraw(true)
				end if
			end if
		end if
		if li_rtcode = 0 then
			if this.ii_servicerettype = 13 then
				li_rtcode = wf_findretailsaleinvoice(al_saleinvcode, ld_datetime, ls_errtext)
			else
				li_rtcode = wf_findwholesaleinvoice(al_saleinvcode, ld_datetime, ls_errtext)
			end if
			if li_rtcode = 0 then
				li_rtcode = wf_findunpostedsalereturns(al_saleinvcode, ls_errtext)
				if li_rtcode = 0 then
					li_rtcode = wf_locksaleinvoice(al_saleinvcode)
					if li_rtcode = 0 then
						this.id_detail.setredraw(false)
						wf_setsaleinvinfo(al_saleinvcode, ll_custcode)
						if this.ii_servicerettype = 14 then
							wf_customerinfo(ll_custcode)
							wf_customername(ll_custcode)
						else
							this.id_master.setitem(1, "serviceinvdate", ld_datetime)
						end if
						this.idc_itemdddw.retrieve(al_saleinvcode)
						this.id_detail.setredraw(true)
					else
						li_rtcode = 1
					end if
				else
					li_rtcode = 1
				end if
			else
				li_rtcode = 1
			end if
		end if
	else
		li_rtcode = 1
	end if
	if li_rtcode = 1 then
		messagebox("Service Invoice validation", ls_errtext)
	end if
	return li_rtcode

// w_inpatientservicereturn.wf_findpatientcode(long al_admissioncode) returns long
	integer ll_patientcode
	SQL SELECT patientcode INTO :ll_patientcode FROM patientadmission WHERE admissioncode =:al_admissioncode USING this.it_transobject;
	return ll_patientcode

// w_inpatientservicereturn.wf_findpatientadmission(string as_regno) returns long
	long ll_admissioncode
	SQL SELECT patientadmission.admissioncode INTO :ll_admissioncode FROM patient , patientadmission WHERE patient.regno =:as_regno AND patient.patientcode =patientadmission.patientcode and patientadmission.discharged ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ll_admissioncode) then
			ll_admissioncode = 0
		end if
	else
		ll_admissioncode = 0
	end if
	return ll_admissioncode

// w_inpatientservicereturn.wf_getadmissioncode(string as_regno, ref long al_admissioncode) returns integer
	integer li_retflag
	SQL SELECT patientadmission.admissioncode INTO :al_admissioncode FROM patient , patientadmission WHERE patient.regno =:as_regno AND patient.patientcode =patientadmission.patientcode and patientadmission.discharged ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(al_admissioncode) then
			li_retflag = 0
		else
			li_retflag = 1
		end if
	else
		li_retflag = -1
	end if
	return li_retflag

// w_inpatientservicereturn.wf_lockpatientadmission(long al_admissioncode) returns integer
	integer li_count
	SQL rollback USING this.it_transobject;
	SQL Select count ( *) INTO :li_count From PatientAdmission WITH ( UPDLOCK HOLDLOCK ) Where PatientAdmission.AdmissionCode =:al_admissioncode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_inpatientservicereturn.wf_fetchreturnableservices(long al_row, long al_admissioncode) returns integer
	long ll_detailrows
	long ll_custcode
	integer li_rtcode
	integer li_result
	integer li_header_no
	datetime ld_datetime
	boolean lb_rtflag
	string ls_errtext
	string ls_batch
	dwitemstatus lrs_status
	if not isnull(al_admissioncode) and al_admissioncode > 0 then
		this.im_menu.m_file.m_options.enabled = true
		ll_detailrows = this.id_detail.rowcount()
		if ll_detailrows > 0 then
			lrs_status = this.id_detail.getitemstatus(1, 0, primary!)
			if lrs_status <> new! and not isnull(this.id_detail.getitemnumber(1, "servicecode")) then
				li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
				if li_result = 2 then
					li_rtcode = 2
				else
					this.id_detail.setredraw(false)
					this.id_detail.reset()
					this.id_detail.insertrow(0)
					this.id_detail.setfocus()
					this.id_detail.setredraw(true)
				end if
			end if
		end if
		if li_rtcode = 0 then
			li_rtcode = wf_lockpatientadmission(al_admissioncode)
			if li_rtcode = 0 then
				this.id_detail.setredraw(false)
				this.idc_itemdddw.retrieve(al_admissioncode)
				this.id_detail.setredraw(true)
			else
				ls_errtext = "Unable to aquire lock on patient admission,~r~nPlease try later"
				li_rtcode = 1
			end if
		end if
	else
		ls_errtext = "Some Problem occured at database,~r~nPlease try later"
		li_rtcode = 1
	end if
	if li_rtcode = 1 then
		messagebox("Service Return validation", ls_errtext)
	end if
	return li_rtcode

// w_inpatientservicereturn.wf_admitted(long al_admissioncode) returns long
	long ll_count
	SQL SELECT Count ( *) INTO :ll_count FROM PatientAdmission WHERE PatientAdmission.AdmissionCode =:al_admissioncode AND PatientAdmission.Discharged ='N' USING sqlca;
	return ll_count

// w_inpatientservicereturn.wf_post() returns integer
	return 0

// w_inpatientservicereturn.wf_setadmissiondetails(long al_admissioncode) returns long
	long ll_retflag
	long ll_doctcode
	long ll_locationcode
	SQL SELECT patientadmission.doctorcode , patientadmission.locationcode INTO :ll_doctcode, :ll_locationcode FROM patientadmission WHERE patientadmission.Admissioncode =:al_admissioncode AND patientadmission.discharged1 ='N' and patientadmission.discharged ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.object.doctcode[this.id_master.getrow()] = ll_doctcode
		this.id_master.object.locationcode[this.id_master.getrow()] = ll_locationcode
		ll_retflag = 1
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_inpatientservicereturn.wf_assign_master_cash_win_object() returns 0
	this.ids_cashwin = create u_ds_standard
	this.ids_cashwin.dataobject = "d_mastercashierwindow_detail"
	this.ids_cashwin.settransobject(this.it_transobject)

// w_inpatientservicereturn.wf_set_cashaccount() returns long
	long ll_cashacccode
	long ll_module
	long ll_code
	ll_module = 30
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = f_is_group_module_cashaccount_allowed(this.il_groupcode, ll_module)
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		ll_cashacccode = 0
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
	elseif isnull(ll_code) or this.id_master.object.code[1] <= 0 then
		this.id_master.object.cashacccode[this.id_master.rowcount()] = ll_cashacccode
	else
		ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	end if
	return ll_cashacccode

// w_inpatientservicereturn.wf_show_mastercashierwindow() returns long
	long ll_counter
	long ll_code
	long ll_row
	long ll_insrow
	long ll_module
	long ll_cashacccode
	double ld_tot_acc_amt
	s_mastercashwin_all lstr_values
	lstr_values.i_interfacecode = 15
	if f_stringpreferences("askmastercashwin_in_inpatient_svcret") = "N" then
		return 1
	end if
	ll_module = 30
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
		return 0
	end if
	lstr_values.l_doccode = ll_code
	lstr_values.s_doctype = this.is_doctype
	lstr_values.l_cashacccode = ll_cashacccode
	lstr_values.l_groupcode = this.il_groupcode
	lstr_values.l_module = ll_module
	lstr_values.d_netamt = wf_grandtotal()
	lstr_values.d_cashtendered = this.id_master.object.cashtendered[this.id_master.rowcount()]
	lstr_values.d_cashcharged = this.id_master.object.cashcharged[this.id_master.rowcount()]
	lstr_values.d_cashback = this.id_master.object.cashback[this.id_master.rowcount()]
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		lstr_values.l_acccode[ll_counter] = this.ids_cashwin.object.acccode[ll_counter]
		lstr_values.s_remarks[ll_counter] = this.ids_cashwin.object.remarks[ll_counter]
		lstr_values.d_amount[ll_counter] = this.ids_cashwin.object.amount[ll_counter]
		lstr_values.l_rowid[ll_counter] = this.ids_cashwin.object.rowid[ll_counter]
		ld_tot_acc_amt = ld_tot_acc_amt + this.ids_cashwin.object.amount[ll_counter]
	next
	if lstr_values.d_netamt >= lstr_values.d_cashcharged then
		lstr_values.d_docbalance = lstr_values.d_netamt - lstr_values.d_cashcharged - ld_tot_acc_amt
	else
		lstr_values.d_docbalance = 0
	end if
	for ll_counter = 1 to 100
		if lstr_values.l_rowid[ll_counter] <= 0 then
			lstr_values.l_rowid[ll_counter] = -1
		end if
	next
	openwithparm(w_mastercashierwindow, lstr_values)
	lstr_values = message.powerobjectparm
	if lstr_values.i_status = 1 then
		this.ids_cashwin.reset()
		ld_tot_acc_amt = 0
		for ll_counter = 1 to 100
			if lstr_values.l_acccode[ll_counter] > 0 and lstr_values.d_amount[ll_counter] > 0 and lstr_values.l_rowid[ll_counter] > 0 then
				ll_insrow = this.ids_cashwin.insertrow(0)
				this.ids_cashwin.object.documentcode[ll_insrow] = ll_code
				this.ids_cashwin.object.documenttype[ll_insrow] = this.is_doctype
				this.ids_cashwin.object.acccode[ll_insrow] = lstr_values.l_acccode[ll_counter]
				this.ids_cashwin.object.remarks[ll_insrow] = lstr_values.s_remarks[ll_counter]
				this.ids_cashwin.object.amount[ll_insrow] = lstr_values.d_amount[ll_counter]
				this.ids_cashwin.object.rowid[ll_insrow] = lstr_values.l_rowid[ll_counter]
			end if
		next
		this.id_master.object.cashacccode[this.id_master.rowcount()] = lstr_values.l_cashacccode
		this.id_master.object.cashtendered[this.id_master.rowcount()] = lstr_values.d_cashtendered
		this.id_master.object.cashcharged[this.id_master.rowcount()] = lstr_values.d_cashcharged
		this.id_master.object.cashback[this.id_master.rowcount()] = lstr_values.d_cashback
		return 1
	end if
	return 0

// w_inpatientservicereturn.wf_update_mastercashierwindow(long al_code, string as_type) returns long
	long ll_counter
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		this.ids_cashwin.object.documentcode[ll_counter] = al_code
		this.ids_cashwin.object.documenttype[ll_counter] = as_type
		this.ids_cashwin.object.date[ll_counter] = this.id_master.object.date[1]
	next
	SQL DELETE DBO.MasterCashWin WHERE DocumentCode =:al_code AND DocumentType =:as_type USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if this.ids_cashwin.update() > 0 then
			return 0
		else
			return -1
		end if
		return
	end if
	return -1

// w_inpatientservicereturn.wf_validate_price_discount_matters(long al_usercode) returns long
	long ll_masterrow
	long ll_servicecode
	long ll_counter
	double ld_discperc
	double ld_servicediscperclimit
	boolean lb_validdisc
	datastore lds_groupdiscinfo
	wf_grandtotal()
	lds_groupdiscinfo = create datastore
	lds_groupdiscinfo.dataobject = "d_groups_discount"
	lds_groupdiscinfo.settransobject(this.it_transobject)
	lds_groupdiscinfo.retrieve(al_usercode)
	lb_validdisc = false
	ll_masterrow = this.id_master.rowcount()
	for ll_counter = 1 to lds_groupdiscinfo.rowcount()
		ld_servicediscperclimit = lds_groupdiscinfo.getitemnumber(ll_counter, "servicediscperclimit")
	next
	for ll_counter = 1 to this.id_detail.rowcount()
		ll_servicecode = this.id_detail.getitemnumber(ll_counter, "servicecode")
		ld_discperc = this.id_detail.getitemnumber(ll_counter, "discperc")
		if ld_discperc > ld_servicediscperclimit then
			lb_validdisc = false
			exit
		else
			lb_validdisc = true
		end if
	next
	destroy lds_groupdiscinfo
	if lb_validdisc = false then
		messagebox("Disc% Validation ..", "Disc% is greater than your group permission~r~nGroup Discount % limit for Services is " + trim(string(ld_servicediscperclimit)) + "%~r~nPlease consult Administrator")
		this.id_detail.setfocus()
		this.id_detail.setrow(ll_counter)
		this.id_detail.setcolumn("discperc")
		return -1
	end if
	return 0

// w_inpatientservicereturn.wf_itemprevretqty(long al_serviceinvcode, long al_srvrowid, long al_servicecode, ref double ad_serviceprevqty) returns integer
	SQL SELECT Sum ( qty ) INTO :ad_serviceprevqty FROM servicerheader , servicerdetail WHERE servicerheader.serviceinvcode =:al_serviceinvcode And servicerheader.posted ='Y' And servicerheader.servicerinvcode =servicerdetail.serviceRInvCode And servicerdetail.servicecode =:al_servicecode And servicerdetail.srvrowid =:al_srvrowid USING this.it_transobject;
	if isnull(ad_serviceprevqty) then
		ad_serviceprevqty = 0
	end if
	return this.it_transobject.sqlcode

// w_inpatientservicereturn.wf_oninvoiceitemprevretqty(long al_row, long al_servicecode, long al_srvrowid, ref double ad_serviceprevqty) returns integer
	long ll_counter
	long ll_rowcount
	long ll_servicecode
	long ll_srvrowid
	double ld_holdqty
	ll_rowcount = this.id_detail.rowcount()
	for ll_counter = 1 to al_row - 1
		ll_servicecode = this.id_detail.getitemnumber(ll_counter, "servicecode")
		ll_srvrowid = this.id_detail.getitemnumber(ll_counter, "srvrowid")
		if ll_servicecode = al_servicecode and ll_srvrowid = al_srvrowid then
			ld_holdqty = ld_holdqty + this.id_detail.getitemnumber(ll_counter, "qty")
		end if
	next
	for ll_counter = al_row + 1 to ll_rowcount
		ll_servicecode = this.id_detail.getitemnumber(ll_counter, "servicecode")
		ll_srvrowid = this.id_detail.getitemnumber(ll_counter, "srvrowid")
		if ll_servicecode = al_servicecode and ll_srvrowid = al_srvrowid then
			ld_holdqty = ld_holdqty + this.id_detail.getitemnumber(ll_counter, "qty")
		end if
	next
	ad_serviceprevqty = ld_holdqty
	return 0

// w_inpatientservicereturn.wf_validateqty(long al_row, double ad_qty) returns integer
	integer li_rtcode
	long ll_servicecode
	long ll_srvrowid
	double ld_qty
	double ld_returnableqty
	double ld_serviceqty
	double ld_oninvoiceitemretqty
	double ld_qtyreturned
	ll_servicecode = this.id_detail.getitemnumber(al_row, "servicecode")
	ll_srvrowid = this.id_detail.getitemnumber(al_row, "srvrowid")
	ld_serviceqty = this.id_detail.getitemnumber(al_row, "serviceqty")
	wf_oninvoiceitemprevretqty(al_row, ll_servicecode, ll_srvrowid, ld_oninvoiceitemretqty)
	ld_qtyreturned = this.id_detail.getitemnumber(al_row, "retqty")
	ld_qtyreturned = ld_qtyreturned + ld_oninvoiceitemretqty
	ld_returnableqty = ld_serviceqty - ld_qtyreturned
	if ad_qty > ld_returnableqty then
		li_rtcode = 1
		messagebox("Quantity Validation", "   Qty Should be less than or equal to " + string(ld_returnableqty))
	elseif li_rtcode = 0 then
		if double(long(ad_qty)) <> ad_qty and this.id_detail.object.allowsaleindecimal[al_row] = "N" then
			messagebox("Quantity Validation", "Quantity In decimals is not allowed for this service", stopsign!)
			li_rtcode = 1
		else
			li_rtcode = 0
		end if
	else
		messagebox("Quantity Validation", "Please enter a valid Quantity for this service", stopsign!)
		li_rtcode = 1
	end if
	return li_rtcode

// w_inpatientservicereturn.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_inpatientservretmenu" then
		this.menuid = create m_inpatientservretmenu
	end if
	this.dw_print = create dw_print
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print

// w_inpatientservicereturn.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_print

// w_inpatientservicereturn.ue_save() returns 0 [event]
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_salesmancode = 1
	long ll_rowcount
	long ll_servicecode
	long ll_gcode
	long ll_qty
	long ll_stock
	long ll_newstock
	long ll_counter = 1
	long ll_saveresult
	long ll_null
	boolean lb_commitflag = true
	boolean lb_continue = true
	integer li_errcode
	integer li_pos
	datetime ld_expiry
	string ls_errtext
	string ls_batch
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_avgprice
	datetime ldt_server_datetime
	string ls_date_errtext
	setnull(ll_null)
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	wf_grandtotal()
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	if this.id_detail.rowcount() <= 0 then
		return
	end if
	setpointer(hourglass!)
	if not isnull(this.id_master.object.admissioncode[this.id_master.getrow()]) then
		if wf_admitted(this.id_master.object.admissioncode[this.id_master.getrow()]) <= 0 then
			messagebox("Problem Saving", "Patient No more Admitted.~r~nChoose some other patient")
			this.id_master.setfocus()
			this.id_master.setcolumn("admissioncode")
			return
		end if
	else
		messagebox("Problem Saving", "Invalid Patient.~r~nChoose some other patient")
		this.id_master.setfocus()
		this.id_master.setcolumn("admissioncode")
		return
	end if
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if wf_set_cashaccount() = 0 then
		return
	end if
	if f_stringpreferences("ServiceSalesManWindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	wf_grandtotal()
	if ll_salesmancode > 0 then
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_rowcount = this.id_detail.rowcount()
		if wf_validate_price_discount_matters(ll_salesmancode) < 0 then
			return
		end if
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if wf_show_mastercashierwindow() = 0 then
			return
		end if
		if isnull(ll_invid) then
			wf_tabnewid("ServiceRHeader", ll_invid)
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
				this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
			end if
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
		else
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		end if
		if f_stringpreferences("Headeronsaleinv") = "N" then
			this.id_master.setitem(ll_mastercurrrow, "Headerno", f_numberpreferences("headerno"))
		end if
		ld_misccharges = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges")
		ld_invdiscperc = this.id_footer.getitemnumber(ll_footercurrrow, "discperc")
		ld_flatdisc = this.id_footer.getitemnumber(ll_footercurrrow, "flatdisc")
		this.id_master.setitem(ll_mastercurrrow, "discperc", ld_invdiscperc)
		this.id_master.setitem(ll_mastercurrrow, "flatdisc", ld_flatdisc)
		this.id_master.setitem(ll_mastercurrrow, "misccharges", ld_misccharges)
		this.id_master.setitem(ll_mastercurrrow, "postedby", ll_salesmancode)
		this.id_master.setitem(ll_mastercurrrow, "invtotal", wf_grandtotal())
		do while ll_counter <= ll_rowcount and li_errcode = 0
			this.id_detail.setitem(ll_counter, "code", ll_invid)
			ll_servicecode = this.id_detail.getitemnumber(ll_counter, "servicecode")
			ll_counter = ll_counter + 1
		loop
		if lb_continue then
			ll_saveresult = event ue_save_withnocommit()
			if ll_saveresult = 0 then
				if wf_update_mastercashierwindow(ll_invid, this.is_doctype) = 0 then
					SQL commit USING this.it_transobject;
					messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
					this.ib_commitok = true
					this.id_master.resetupdate()
					this.im_menu.m_file.m_new.enabled = true
					this.editflag = false
					if gd_recenttransdate < this.id_systemdate then
						gd_recenttransdate = this.id_systemdate
					end if
				else
					messagebox("Saving Problem", "Changes Not Saved in database for Master Cashier Window transactions.", stopsign!, ok!, 1)
				end if
			else
				messagebox("Saving Problem", "Changes Not Saved in database while saving service record.", stopsign!, ok!, 1)
			end if
			if this.ib_commitok then
				this.ib_modify = false
			else
				lb_continue = false
			end if
		end if
		if this.ib_modify = false then
			this.id_master.setitem(1, "Code", ll_null)
			this.id_master.accepttext()
		elseif f_stringpreferences("IncSvcSRInActMonitor") = "Y" then
			this.it_transobject.updateactivitymonitor("RR", ll_invid)
			if this.it_transobject.sqlcode <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
			else
				SQL commit USING this.it_transobject;
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_inpatientservicereturn.ue_newform() returns 0 [event]
	integer rtncode
	long li_fetched_code
	long row
	long ll_manfcode
	call super::ue_newform
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_print.enabled = true
	this.id_master.object.patientcode.visible = false
	this.id_master.object.admissioncode.visible = true
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	wf_assign_master_cash_win_object()
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.ib_modify = false
	if not this.ib_openservicereturn then
		this.idc_itemdddw.reset()
		this.idc_itemdddw.insertrow(0)
	end if
	if this.ii_servicerettype = 13 then
		this.id_master.object.custcode[1] = this.il_code
	end if
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	setredraw(true)
	if not wf_validatedate() then
		close(this)
	end if

// w_inpatientservicereturn.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect = 1
	long ll_row
	long ll_code
	boolean lb_flag
	call super::ue_detail
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	ll_code = this.id_master.getitemnumber(1, "code")
	if isnull(this.id_master.getitemnumber(1, "admissioncode")) then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "Only In-Patient Service Return is Allowed Here,~r~nYou Can not modify this Invoice.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	this.id_footer.retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	if not this.ib_openservicereturn then
		this.idc_itemdddw.settransobject(this.it_transobject)
		li_rtncode = this.idc_itemdddw.retrieve(this.id_master.getitemnumber(1, "admissioncode"))
	end if
	if wf_admitted(this.id_master.object.admissioncode[this.id_master.getrow()]) <= 0 then
		this.id_master.object.patientcode.visible = true
		this.id_master.object.admissioncode.visible = false
		this.id_master.setitem(1, "patientcode", wf_findpatientcode(this.id_master.object.admissioncode[this.id_master.getrow()]))
	else
		this.id_master.object.patientcode.visible = false
		this.id_master.object.admissioncode.visible = true
	end if
	if ll_code > 0 then
		this.ids_cashwin.retrieve(ll_code, this.is_doctype)
	else
		wf_assign_master_cash_win_object()
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_grandtotal()
	setredraw(true)

// w_inpatientservicereturn.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.settransobject(this.it_transobject)
	if not this.ib_openservicereturn then
		this.id_detail.setcolumn(this.is_columnitemname)
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		if f_stringpreferences("itemcode") = "N" then
			this.id_detail.setcolumn("servicecode")
		else
			this.id_detail.setcolumn("fullcode")
		end if
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_inpatientservicereturn.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	return ::message.returnvalue

// w_inpatientservicereturn.ue_print() returns 0 [event]
	long ll_custcode
	long ll_row
	long ll_invcode
	integer li_option
	string ls_custname
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	wf_selectprintreport()
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_inpatientservicereturn.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	if this.ib_opensalereturn and this.ii_salerettype = 1 then
		setpointer(hourglass!)
		this.idc_customerslist.setredraw(false)
		this.idc_customerslist.settransobject(this.it_transobject)
		this.idc_customerslist.reset()
		this.idc_customerslist.retrieve()
		this.idc_customerslist.setredraw(true)
		setpointer(arrow!)
	end if

// w_inpatientservicereturn.ue_list() returns 0 [event]
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_post.enabled = true
	this.im_menu.m_file.m_print.enabled = true

// w_inpatientservicereturn.ue_postopen() returns 0 [event]
	datawindowchild ldc_dddservicecategory
	s_servicerettype ls_servicerettype
	long li_rtncode
	call super::ue_postopen
	this.id_print = this.dw_print
	setredraw(false)
	ls_servicerettype = message.powerobjectparm
	wf_setsalereturntype(ls_servicerettype.servicerettype, ls_servicerettype.openservice)
	wf_assign_master_cash_win_object()
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.is_columnitemname = "servicecode"
	this.title = "In-Patient Service Return"
	wf_assigndatawindowobjects("d_inpatient_servicereturn_header", "d_inpatient_servicereturndetail", "d_Service_ReturnFooter", "d_inpatient_serviceret_list", "d_WholeSaleReturnInvReport")
	if gs_company = "SHE" or gs_company = "REHMAT" then
		this.id_master.object.servicercatcode.initial = "15"
	end if
	li_rtncode = this.id_detail.getchild("smancode", this.idc_salesman)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild for SalesMan in detail datawindow")
		close(this)
	end if
	this.idc_salesman.settransobject(this.it_transobject)
	this.ib_editing = false
	if this.ib_openservicereturn <> true then
		li_rtncode = this.id_detail.getchild("servicecode", this.idc_itemdddw)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_itemdddw.settransobject(this.it_transobject)
		this.idc_itemdddw.insertrow(0)
	else
		gd_itemsinfo.sharedata(this.id_itemslist)
		if this.ii_salerettype = 1 then
			li_rtncode = this.id_master.getchild("custcode", this.idc_customerslist)
			if li_rtncode = -1 then
				messagebox("Error", "Can not get a DataWindowChild")
			end if
			this.idc_customerslist.settransobject(this.it_transobject)
		end if
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	if f_stringpreferences("SalesManInService") = "N" then
		this.id_detail.object.smancode.visible = false
		this.id_detail.object.t_salesman.visible = false
	end if
	if f_stringpreferences("showcommissionincrditservice") = "N" then
		this.id_detail.object.commission.visible = false
	end if
	if f_stringpreferences("showsharepercincreditservice") = "N" then
		this.id_detail.object.shareperc.visible = false
	end if
	if f_stringpreferences("showflatdiscincreditservicedetail") = "N" then
		this.id_detail.object.serviceflatdisc.visible = false
	end if
	if f_stringpreferences("servicedoctid") = "N" then
		this.id_master.object.doctcode.visible = false
		this.id_master.object.doctcode_t.visible = false
	end if
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(1)
	f_setserviceqtystyle(this.id_detail, "qty")
	setredraw(true)

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
	case "flatdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	end choose
	return 1

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_code
	long ll_detailrows
	long ll_custcode
	long ll_null
	long ll_admissioncode
	integer li_result
	string ls_result
	string ls_aliasname
	string ls_regno
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "patientregno"
		if not isnull(data) and data <> "" then
			li_result = parent.parent.parent.wf_getadmissioncode(data, ll_admissioncode)
			if li_result > 0 then
				setitem(row, "admissioncode", ll_admissioncode)
				li_result = 0
				SQL SELECT patient.custcode , accounts.aliasname INTO :ll_custcode, :ls_aliasname FROM patient , patientadmission , accounts WHERE patientadmission.discharged ='N' and patientadmission.admissioncode =:ll_admissioncode and patient.patientcode =patientadmission.patientcode and patient.custcode =accounts.acccode USING parent.parent.parent.it_transobject;
				if parent.parent.parent.it_transobject.sqlcode = 0 then
					parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
					parent.parent.parent.id_master.setitem(1, "aliasname", ls_aliasname)
					li_result = parent.parent.parent.wf_customerinfo(ll_custcode)
					parent.parent.parent.wf_setadmissiondetails(ll_admissioncode)
					li_result = parent.parent.parent.wf_fetchreturnableservices(row, ll_admissioncode)
				else
					messagebox("Patient Information", "Problem in retrieving corresponding customer")
					li_result = 1
				end if
			else
				messagebox("Patient Validation", "Patient with  RegNo  " + data + " does not exist")
				li_result = 1
			end if
		end if
	case "admissioncode"
		if isnull(data) or data = "" then
			setnull(ll_null)
			parent.parent.parent.id_master.setitem(1, "patientregno", "")
			parent.parent.parent.id_master.setitem(1, "aliasname", "")
			parent.parent.parent.id_master.setitem(1, "custcode", 0)
		else
			ll_admissioncode = long(data)
			SQL SELECT patient.custcode , accounts.aliasname , patient.regno INTO :ll_custcode, :ls_aliasname, :ls_regno FROM patient , patientadmission , accounts WHERE patientadmission.discharged ='N' and patientadmission.admissioncode =:ll_admissioncode and patient.patientcode =patientadmission.patientcode and patient.custcode =accounts.acccode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = 0 then
				parent.parent.parent.id_master.setitem(1, "patientregno", ls_regno)
				parent.parent.parent.id_master.setitem(1, "aliasname", ls_aliasname)
				parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
				li_result = parent.parent.parent.wf_customerinfo(ll_custcode)
				parent.parent.parent.wf_setadmissiondetails(ll_admissioncode)
				li_result = parent.parent.parent.wf_fetchreturnableservices(row, ll_admissioncode)
			else
				messagebox("Patient Information", "Problem in retrieving corresponding customer")
				li_result = 1
			end if
		end if
	case "srcatcode"
	case "custcode"
		ll_code = long(data)
		parent.setredraw(false)
		if parent.parent.parent.wf_customerinfo(ll_code) <> 0 then
			messagebox("Database Error", "Can not retrieve information from database")
		end if
		parent.setredraw(true)
	case "serviceinvcode"
		return li_result
	end choose
	return li_result

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_saletype
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "serviceinvcode"
		if parent.parent.parent.ii_servicerettype = 13 then
			ls_saletype = "Retail Service"
		else
			ls_saletype = "Credit Service"
		end if
		if isnull(data) or integer(data) = 0 then
			messagebox("Service Invoice code Validation", "You must select some " + ls_saletype + " invoice")
		else
			messagebox("Service Invoice code Validation", "You must select some valid " + ls_saletype + " invoice")
		end if
	end choose
	return 1

// dw_detail.retrieveend(long rowcount) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::retrieveend(rowcount)
	if parent.parent.parent.ib_opensalereturn and rowcount > 0 then
		parent.parent.parent.idc_itemdddw.settransobject(parent.parent.parent.it_transobject)
		parent.parent.parent.idc_itemdddw.reset()
		parent.parent.parent.idc_itemdddw.retrieve(this.object.serviceinvcode[rowcount])
	end if
	return ::message.returnvalue

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	string ls_columnobject
	long ll_currow
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	ls_columnobject = dwo.name
	ll_currow = rowcount()
	if ll_currow > 0 and (ls_columnobject = "discperc" or ls_columnobject = "srprice" or ls_columnobject = "qty") and isnull(this.object.icode[ll_currow]) then
		scrolltorow(ll_currow)
		setcolumn("icode")
	end if
	return 0

// dw_detail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.getparent().dynamic postevent("ue_accepttext")
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_null
	long ll_rowfound
	string ls_null
	integer li_rtcode
	string ls_batch
	string ls_itemname
	datetime ld_expiry
	long ll_gcode
	long ll_icode
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case "servicecode"
		if long(data) > 0 then
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = row
		else
			return 1
		end if
	case "qty"
		li_rtcode = parent.parent.parent.wf_validateqty(row, double(data))
	case "fullcode"
		if isnull(data) or data = "" then
			setitem(row, "servicecode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_rtcode = 2
		else
			li_res = parent.parent.parent.wf_find_service_fullcode(data, ll_icode, ls_itemname)
			if li_res > 0 then
				if ll_icode > 0 then
					ll_rowfound = parent.parent.parent.idc_itemdddw.find("servicecode = " + string(ll_icode) + " and (qty - returnqty) > 0", 1, parent.parent.parent.idc_itemdddw.rowcount())
					if ll_rowfound > 0 and ll_rowfound <= parent.parent.parent.idc_itemdddw.rowcount() then
						parent.parent.parent.il_currrow = row
						setitem(row, "servicecode", ll_icode)
						setitem(row, "qty", 1)
						parent.parent.parent.ib_itemvalidated = false
						parent.parent.parent.il_currrow = row
						li_rtcode = 0
					else
						messagebox("Service Code/Alias Name Validation", "Service does not exist in service invoice list for this patient")
						setitem(row, "servicecode", ll_null)
						setitem(row, "fullcode", ls_null)
						li_rtcode = 1
					end if
				else
					messagebox("Service Code/Alias Name Validation", "Service does not exist")
					setitem(row, "servicecode", ll_null)
					setitem(row, "fullcode", ls_null)
					li_rtcode = 1
				end if
			else
				messagebox("Service Code/Alias Name Validation", "Service does not exist")
				setitem(row, "servicecode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_rtcode = 1
			end if
		end if
	end choose
	return li_rtcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ll_icode
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "servicecode" then
		parent.parent.parent.ib_focusdetail = true
	else
		parent.parent.parent.ib_focusdetail = true
	end if
	parent.parent.parent.wf_grandtotal()
	parent.parent.parent.editflag = true
	selecttext(1, len(gettext()))
	return 0

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	long ll_icode
	long ll_foundrow
	dwitemstatus lrs_status
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if parent.parent.parent.id_detail.rowcount() > 0 and lrs_status <> new! then
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "servicecode"
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case parent.parent.parent.is_columnitemname
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case "discperc"
		messagebox("Item Discount Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	case "serviceprice"
		if double(data) <= 0.0 then
			messagebox("Item Price Validation", "Item price ~"" + data + "~" must be greater than zero")
		else
			messagebox("Item Price Validation", "Item price can not be changed")
		end if
	end choose
	setnull(parent.parent.parent.is_validationerrtext)
	return 1

// dw_itemsdetail.getfocus() returns long [event]
	long ancestorreturnvalue
	if f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	return ::message.returnvalue

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	if getcolumn() = 1 then
		parent.parent.parent.is_aliasname = data
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	integer li_rowno
	integer i
	integer li_columnno = 1
	li_columnno = integer(this.object.qty.id)
	if getrow() = rowcount() then
		if getcolumn() = li_columnno then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
	elseif li_columnno = integer(this.object.datawindow.column.count) and getcolumn() = li_columnno then
		scrollnextrow()
		if f_stringpreferences("ItemCode") = "Y" then
			setcolumn("fullcode")
		else
			setcolumn("servicecode")
		end if
		setfocus()
		return 1
	end if
	li_rowno = parent.parent.parent.idc_itemdddw.find("fullcode='" + parent.parent.parent.is_aliasname + "'", 1, parent.parent.parent.idc_itemdddw.rowcount())
	if getcolumn() = 1 and li_rowno > 0 and li_rowno <= parent.parent.parent.idc_itemdddw.rowcount() then
		if isnull(parent.parent.parent.is_aliasname) or parent.parent.parent.is_aliasname = "" then
			setcolumn("servicecode")
		else
			setcolumn("qty")
		end if
		setfocus()
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_itemsdetail.rowfocuschanging(long currentrow, long newrow) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::rowfocuschanging(currentrow, newrow)
	if currentrow > 0 and currentrow <= rowcount() and isnull(this.object.servicecode[currentrow]) then
		setcolumn("servicecode")
		return 1
	end if
	return 0

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_icode
	long ll_found
	long ll_rowm
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			parent.parent.parent.idc_itemdddw.selectrow(0, false)
			parent.parent.parent.idc_itemdddw.scrollnextrow()
			ll_listcurrrow = parent.parent.parent.idc_itemdddw.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.parent.parent.idc_itemdddw.selectrow(0, false)
			parent.parent.parent.idc_itemdddw.scrollpriorrow()
			ll_listcurrrow = parent.parent.parent.idc_itemdddw.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.parent.parent.idc_itemdddw.selectrow(0, false)
			parent.parent.parent.idc_itemdddw.scrollnextpage()
			ll_listcurrrow = parent.parent.parent.idc_itemdddw.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.parent.parent.idc_itemdddw.selectrow(0, false)
			parent.parent.parent.idc_itemdddw.scrollpriorpage()
			ll_listcurrrow = parent.parent.parent.idc_itemdddw.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.parent.parent.idc_itemdddw.selectrow(0, false)
			parent.parent.parent.idc_itemdddw.scrolltorow(99999)
			ll_listcurrrow = parent.parent.parent.idc_itemdddw.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.parent.parent.idc_itemdddw.selectrow(0, false)
			parent.parent.parent.idc_itemdddw.scrolltorow(1)
			ll_listcurrrow = parent.parent.parent.idc_itemdddw.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			setfocus()
			setredraw(true)
		elseif key = keyf4! then
			parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.idc_itemdddw.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, "servicecode", parent.parent.parent.idc_itemdddw.getitemnumber(ll_listcurrrow, "servicecode"))
			setitem(ll_rowm, "fullcode", parent.parent.parent.idc_itemdddw.getitemstring(ll_listcurrrow, "fullcode"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	elseif key = keydownarrow! then
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_focusfooter")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	end if
	return rt_code
