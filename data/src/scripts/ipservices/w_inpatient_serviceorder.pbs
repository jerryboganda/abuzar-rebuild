// window w_inpatient_serviceorder (ipservices)  ancestor: w_multi_entry

// w_inpatient_serviceorder.ue_printdo() returns 0 [event]
	long ll_custcode
	long ll_row
	string ls_custname
	if this.im_menu.m_file.m_save.enabled = true then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	this.id_print.dataobject = "d_deliveryorder_half"
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(this.id_master.getitemnumber(1, "code"))
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_inpatient_serviceorder.wf_setsuppinfo(long al_suppcode, datawindow ad_master) returns 0
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	SQL SELECT supplier.address1 , supplier.city , supplier.phone INTO :ls_address, :ls_city, :ls_phone FROM supplier WHERE supplier.suppcode =:al_suppcode USING this.it_transobject;
	ll_currow = ad_master.getrow()
	ad_master.object.supplier_address[ll_currow] = ls_address
	ad_master.object.supplier_city[ll_currow] = ls_city
	ad_master.object.supplier_phone[ll_currow] = ls_phone

// w_inpatient_serviceorder.wf_customerinfo(long al_custcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	double ld_currbalance
	SQL SELECT customer.address1 , customer.city , customer.phone INTO :ls_address, :ls_city, :ls_phone FROM customer WHERE customer.custcode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
		this.id_master.object.address[ll_currow] = ls_address
		this.id_master.object.city[ll_currow] = ls_city
		this.id_master.object.phone[ll_currow] = ls_phone
	end if
	return this.it_transobject.sqlcode

// w_inpatient_serviceorder.wf_setiteminfo(long al_icode, long al_row, double ad_saleprice, double ad_discperc, long al_stock, double ad_avgprice, long al_totalstock, double ad_purdiscperc) returns 0
	this.id_detail.setitem(al_row, "saleprice", ad_saleprice)
	if this.ii_saletype = 2 then
		this.id_detail.setitem(al_row, "discperc", ad_discperc)
	else
		this.id_detail.setitem(al_row, "discperc", 0.0)
	end if
	this.id_detail.setitem(al_row, "rate", ad_saleprice)
	this.id_detail.setitem(al_row, "avgprice", ad_avgprice)
	this.id_footer.object.icode[this.id_footer.getrow()] = al_icode
	this.id_footer.object.stock[this.id_footer.getrow()] = al_stock

// w_inpatient_serviceorder.wf_getmaxdate(datetime ad_date) returns integer
	SQL Select Max ( Date ) INTO :ad_date From saleledger USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_inpatient_serviceorder.wf_locksaleinvoice(long al_saleinvcode) returns integer
	integer li_count
	this.it_transobject.dbparm = " Async =1, DBGetTime = 20"
	this.it_transobject.locksaleinvoice(al_saleinvcode)
	this.it_transobject.dbparm = "Async =0, DBGetTime = 0"
	return this.it_transobject.sqlcode

// w_inpatient_serviceorder.wf_savastemplate() returns integer
	s_saletemplateheader lstr_templateheader
	long ll_invid
	integer li_retcode = 1
	long ll_code
	long ll_qty
	long ll_icode
	long ll_totalrows
	long ll_rowcount
	open(w_savesaleastemplate)
	lstr_templateheader = message.powerobjectparm
	f_newtableid("SaleTemplateHeader", ll_invid)
	SQL INSERT INTO SaleTemplateHeader ( saletemplatecode , date , modified , name ) values ( :ll_invid , :lstr_templateheader.dt_templatedate , :lstr_templateheader.dt_templatedate , :lstr_templateheader.s_template ) USING this.it_transobject;
	ll_totalrows = this.id_detail.rowcount()
	for ll_rowcount = 1 to ll_totalrows
		ll_code = ll_invid
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ll_qty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		SQL insert into saletemplatedetail ( saletemplatecode , icode , looseqty ) values ( :ll_code , :ll_icode , :ll_qty ) USING this.it_transobject;
	next
	setpointer(hourglass!)
	if this.it_transobject.sqlcode < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return li_retcode
	else
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Template saved", exclamation!, ok!, 1)
	end if
	return li_retcode

// w_inpatient_serviceorder.wf_getitemassociategcode(long la_icode) returns integer
	integer li_gcode
	SQL Select Gcode INTO :li_gcode From item Where icode =:la_icode USING this.it_transobject;
	return li_gcode

// w_inpatient_serviceorder.wf_print() returns integer
	integer li_errcode = 1
	long ll_salesmancode
	long ll_saleinvcount
	long ll_count
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			for ll_count = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
				this.id_print.retrieve(ll_count)
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			next
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	return li_errcode

// w_inpatient_serviceorder.wf_preinvinfo() returns 0
	s_previnvinfo ls_previnvinfo
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_previnvinfo.ar_customer = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		ls_previnvinfo.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		openwithparm(w_previnvinfo, ls_previnvinfo)
	end if

// w_inpatient_serviceorder.wf_updatesaleprice(long al_icode, double ad_saleprice) returns integer
	SQL update Item SET saleprice =:ad_saleprice WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_inpatient_serviceorder.wf_selectitembatches(long al_gcode, long al_icode, long al_qty, datawindow ad_itemsdetail, long al_rowscount, string al_errortext) returns integer
	datastore lds_itemstockinfo
	long ll_counter
	long ll_saleqty
	long ll_reqqty
	long ll_totalstock
	long ll_batchqty
	long ll_detailrowcount
	boolean lb_flag
	integer li_errcode = 1
	lds_itemstockinfo = create datastore
	lds_itemstockinfo.dataobject = "d_itemstockinfo"
	lds_itemstockinfo.settransobject(this.it_transobject)
	if lds_itemstockinfo.retrieve(al_gcode, al_icode) > 0 then
		ll_totalstock = lds_itemstockinfo.getitemnumber(1, "c_totalstock")
		if ll_totalstock >= al_qty then
			ll_reqqty = al_qty
			ll_detailrowcount = ad_itemsdetail.rowcount()
			ll_counter = 1
			do while ll_counter <= lds_itemstockinfo.rowcount() and not lb_flag
				ll_batchqty = lds_itemstockinfo.getitemnumber(ll_counter, "currqty")
				if ll_batchqty >= ll_reqqty then
					ll_saleqty = ll_reqqty
					lb_flag = true
				else
					ll_saleqty = ll_batchqty
					ll_reqqty = ll_reqqty - ll_batchqty
				end if
				ad_itemsdetail.insertrow(0)
				ll_detailrowcount = ll_detailrowcount + 1
				ad_itemsdetail.setitem(ll_detailrowcount, "gcode", al_gcode)
				ad_itemsdetail.setitem(ll_detailrowcount, "icode", al_icode)
				ad_itemsdetail.setitem(ll_detailrowcount, "batch", lds_itemstockinfo.getitemstring(ll_counter, "batch"))
				ad_itemsdetail.setitem(ll_detailrowcount, "expiry", lds_itemstockinfo.getitemdatetime(ll_counter, "expiry"))
				ad_itemsdetail.setitem(ll_detailrowcount, "stock", ll_batchqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "totalstock", ll_totalstock)
				ad_itemsdetail.setitem(ll_detailrowcount, "looseqty", ll_saleqty)
				ll_counter = ll_counter + 1
			loop
			al_rowscount = ll_counter - 1
		else
			li_errcode = 1
			al_rowscount = ll_totalstock
			al_errortext = "Stock has been decreased for this item   "
		end if
	else
		li_errcode = 1
		al_rowscount = ll_totalstock
		al_errortext = "Stock does not exist for this item   "
	end if
	destroy lds_itemstockinfo
	return li_errcode

// w_inpatient_serviceorder.wf_validateitemnew() returns integer
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
		messagebox(ls_titleerrtext, ls_errtext)
	elseif not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		ls_titleerrtext = "Item Validation"
		li_errcode = -2
	end if
	this.ib_itemvalidated = true
	return li_errcode

// w_inpatient_serviceorder.wf_dueitem() returns 0

// w_inpatient_serviceorder.wf_validategodown() returns integer
	long ll_icode
	long ll_gcode
	long ll_stock
	long ll_counter
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	string ls_null
	integer li_errcode
	integer li_null
	integer li_option
	integer li_duperr
	boolean ib_due
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	this.ii_defaultgcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	if wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			if isnull(this.id_detail.getitemstring(this.il_currrow, "due")) then
				li_errcode = -1
			end if
		else
			for ll_counter = 1 to this.id_detail.rowcount()
				if this.il_currrow <> ll_counter and (ll_icode = this.id_detail.getitemnumber(ll_counter, "icode") and this.ii_defaultgcode = this.id_detail.getitemnumber(ll_counter, "gcode")) then
					li_duperr = -2
				end if
			next
		end if
	end if
	this.ib_godownvalidated = true
	if li_errcode = -1 and not ib_due then
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		this.id_detail.setfocus()
		this.id_detail.setcolumn("gcode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
	end if
	if li_duperr = -2 and not ib_due then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate Item, please select some other item"
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
		this.ib_itemslistopen = true
		this.id_itemslist.show()
		li_errcode = -1
	end if
	return li_errcode

// w_inpatient_serviceorder.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean lb_rtflag = true
	boolean ib_due
	integer li_null
	string ls_null
	ls_titleerrtext = "Item Validation"
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), al_currrow) = true then
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
	elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			li_option = messagebox("Item Validation", "Item stock does not exist~n~rDo You want to due this item", information!, yesno!, 2)
			if li_option = 1 then
				this.id_detail.setitem(this.il_currrow, "looseqty", 1)
				this.id_detail.setitem(this.il_currrow, "dueqty", 1)
				ib_due = true
			else
				li_errcode = -1
			end if
		end if
	else
		li_errcode = -1
		ls_titleerrtext = "Item Validation"
	end if
	if li_errcode = -1 and not ib_due then
		lb_rtflag = false
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setitem(al_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(al_currrow, "icode", li_null)
		this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	end if
	return lb_rtflag

// w_inpatient_serviceorder.wf_closelist() returns 0
	this.ib_itemslistopen = false
	this.id_itemslist.hide()

// w_inpatient_serviceorder.wf_copyinvoice() returns integer
	datastore lds_saletemplatedetail
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	integer li_retcode = 1
	integer li_errcode
	string ls_errortext
	lds_saletemplatedetail = create datastore
	open(w_copysaleinvoicefrom)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_saletemplatedetail.dataobject = "d_saletemplate_detail"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		this.id_detail.reset()
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "qty"))
		next
	elseif lstr_template.c_copyinvfrom = "I" then
		lds_saletemplatedetail.dataobject = this.id_detail.dataobject
		lds_saletemplatedetail.settransobject(this.it_transobject)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		this.id_detail.reset()
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "looseqty"))
		next
	end if
	return li_retcode

// w_inpatient_serviceorder.wf_editquotation() returns integer
	datastore lds_quotationdetail
	datastore lds_quotationheader
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	integer li_retcode = 1
	integer li_errcode
	string ls_errortext
	lds_quotationdetail = create datastore
	lds_quotationheader = create datastore
	open(w_editquotationform)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_quotationdetail.dataobject = "d_quotationdetail"
		lds_quotationdetail.settransobject(this.it_transobject)
		lds_quotationheader.dataobject = "d_quotationheader"
		lds_quotationheader.settransobject(this.it_transobject)
		ll_row = lds_quotationheader.retrieve(lstr_template.l_invtemplate)
		lds_quotationdetail.retrieve(lstr_template.l_invtemplate)
		ll_totalrows = lds_quotationheader.retrieve(lstr_template.l_invtemplate)
		if ll_row < 0 then
			li_retcode = -1
		end if
		ll_mrow = this.id_master.getrow()
		this.id_master.setitem(ll_mrow, "quotationno", lstr_template.l_invtemplate)
		this.id_master.setitem(ll_mrow, "custcode", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "custcode"))
		this.id_master.setitem(ll_mrow, "sprice", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "sprice"))
		this.id_master.setitem(ll_mrow, "remarks", lds_quotationheader.getitemstring(lds_quotationheader.getrow(), "remarks"))
		this.id_master.setitem(ll_mrow, "headerno", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "headerno"))
		this.id_footer.setitem(ll_mrow, "misccharges", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "misccharges"))
		this.id_footer.setitem(ll_mrow, "invdiscperc", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "discperc"))
		this.id_footer.setitem(ll_mrow, "flatdisc", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "flatdisc"))
		ll_totalrows = lds_quotationdetail.rowcount()
		this.id_detail.reset()
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_quotationdetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "packunits", lds_quotationdetail.getitemnumber(ll_rowcount, "packunits"))
			this.id_detail.setitem(ll_rowcount, "discperc", lds_quotationdetail.getitemnumber(ll_rowcount, "discperc"))
			this.id_detail.setitem(ll_rowcount, "saleprice", lds_quotationdetail.getitemnumber(ll_rowcount, "saleprice"))
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_quotationdetail.getitemnumber(ll_rowcount, "looseqty"))
		next
	end if
	return li_retcode

// w_inpatient_serviceorder.wf_setgodownoption() returns 0
	this.ii_defaultgcode = f_numberpreferences("defaultgcode")
	this.ii_salegodown = f_numberpreferences("salegodownoption")
	if this.ii_salegodown = 2 or this.ii_salegodown = 1 then
		this.id_detail.modify("gcode" + ".Protect=1")
		this.id_detail.object.gcode.background.color = rgb(255, 255, 255)
	end if

// w_inpatient_serviceorder.wf_deleteserviceinvoice(long al_serviceinvcode) returns integer
	SQL Delete Servicedetail Where Servicedetail.ServiceInvCode =:al_serviceinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_inpatient_serviceorder.wf_locksaleinvoices(long al_sinvcode, long al_linvcode, long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From saleledger WITH ( UPDLOCK HOLDLOCK ) Where saleledger.saleinvcode Between :al_sinvcode AND :al_linvcode AND saleledger.Posted ='N' USING sqlca;
	return sqlca.sqlcode

// w_inpatient_serviceorder.wf_selectprintreport() returns string
	string ls_pagesize
	string ls_report
	ls_pagesize = f_stringpreferences("pagesize")
	if ls_pagesize = "Q" and this.ii_saletype = 3 then
		if gs_company = "FZ" or gs_company = "CMH" or gs_company = "FZGUL" then
			ls_report = "d_retailsaleinvreport"
		elseif gs_company = "SHE" then
			ls_report = "d_shee_retailsaleinvreport"
		else
			ls_report = "d_retailsaleinvreportwh"
		end if
	elseif ls_pagesize = "Q" and this.ii_saletype = 2 then
		if gs_company = "FZ" or gs_company = "CMH" or gs_company = "FZGUL" then
			ls_report = "d_wholesaleinvreport"
		elseif gs_company = "SHE" then
			ls_report = "d_shee_wholesaleinvreport"
		else
			ls_report = "d_wholesaleinvreportwh"
		end if
	elseif ls_pagesize = "F" and this.ii_saletype = 3 then
		if gs_company = "SA" then
			ls_report = "d_sa_retailsaleinvreport_full"
		else
			ls_report = "d_retailsaleinvreport_full"
		end if
	elseif ls_pagesize = "F" and this.ii_saletype = 2 then
		if gs_company = "SA" then
			ls_report = "d_sa_wholesaleinvreport_full"
		else
			ls_report = "d_wholesaleinvreport_full"
		end if
	else
		ls_report = "d_retailsaleinvreport_full"
	end if
	this.id_print.dataobject = ls_report
	this.id_print.settransobject(this.it_transobject)
	return ls_report

// w_inpatient_serviceorder.wf_findcustcode(integer ai_custcode, string as_aliasname) returns integer
	integer li_custcode
	integer ll_retflag
	string ls_itemname
	SQL SELECT accounts.acccode INTO :li_custcode FROM accounts , customer WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =customer.custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_custcode = li_custcode
		if isnull(ai_custcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_inpatient_serviceorder.wf_getsalesstockinfo(long al_saleinvcode, long al_gcode, long al_icode, long al_saleqty) returns integer
	SQL Select IsNull ( Sum ( saledetail.looseqty ) , 0 ) INTO :al_saleqty from saledetail where saledetail.saleinvcode =:al_saleinvcode and saledetail.gcode =:al_gcode and saledetail.icode =:al_icode USING this.it_transobject;
	if isnull(al_saleqty) then
		al_saleqty = 0
	end if
	return this.it_transobject.sqlcode

// w_inpatient_serviceorder.wf_retrievelist() returns long
	string[] ls_posted
	integer li_salecategory
	integer li_invforlastdays = -10
	datetime ld_invdate
	ld_invdate = datetime(relativedate(today(), li_invforlastdays))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		li_salecategory = this.ii_salecategory
	else
		li_salecategory = this.ii_saletype
	end if
	return this.id_list.retrieve(ls_posted, ld_invdate)

// w_inpatient_serviceorder.wf_retrievelistall() returns long
	string[] ls_posted
	integer li_salecategory
	datetime ld_invdate
	ld_invdate = datetime(date("12/12/1998"), time("00:00:00"))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		li_salecategory = this.ii_salecategory
	else
		li_salecategory = this.ii_saletype
	end if
	return this.id_list.retrieve(ls_posted, ld_invdate)

// w_inpatient_serviceorder.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_inpatient_serviceorder.wf_visible(boolean ab_flag) returns 0

// w_inpatient_serviceorder.wf_returnsaleinvoice(long al_invid, string as_errtext) returns boolean
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_looseqty
	long ll_stock
	long ll_newstock
	long ll_counter = 1
	long ll_detailrows
	string ls_batch
	string ls_due
	datetime ld_expiry
	boolean lb_commitflag = true
	double ld_avgprice
	return lb_commitflag

// w_inpatient_serviceorder.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_serviceadvance
	double ld_invoiceadvance
	real lr_discperc
	real lr_flatdisc
	real lr_misccharges
	real lr_salestax
	real lr_itemstotal
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		lr_discperc = this.id_footer.object.invdiscperc[1]
		lr_flatdisc = this.id_footer.object.flatdisc[1]
		lr_misccharges = this.id_footer.object.misccharges[1]
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
		ld_grandtotal = ld_detaildwtotal * (1.0 - lr_discperc * 0.01) - lr_flatdisc + lr_misccharges + lr_salestax
		ld_grandtotal = round(ld_grandtotal, 0)
		ld_serviceadvance = this.id_detail.getitemnumber(1, "c_cashreceived")
		ld_invoiceadvance = this.id_footer.getitemnumber(1, "cashreceived")
		this.id_footer.setitem(1, "totaladvance", ld_serviceadvance + ld_invoiceadvance)
		this.id_footer.setitem(1, "total", ld_grandtotal)
	end if
	return ld_grandtotal

// w_inpatient_serviceorder.wf_findcustomerbyname(string as_customername) returns boolean
	long ll_customerexist
	boolean lb_retflag
	SQL SELECT count ( acccode ) INTO :ll_customerexist FROM Accounts , Customer WHERE Accounts.Name =:as_customername AND Accounts.Acccode =Customer.custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_customerexist > 0 then
			lb_retflag = true
		else
			lb_retflag = false
		end if
	else
		lb_retflag = false
	end if
	return lb_retflag

// w_inpatient_serviceorder.wf_lockserviceinvoices(long al_sinvcode, long al_linvcode, long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From ServiceHeader WITH ( UPDLOCK HOLDLOCK ) Where ServiceHeader.Serviceinvcode Between :al_sinvcode AND :al_linvcode AND ServiceHeader.Posted ='N' USING sqlca;
	return sqlca.sqlcode

// w_inpatient_serviceorder.wf_validateitem(boolean ab_flag) returns integer
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	integer li_option
	boolean ib_due
	integer li_null
	string ls_null
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if not isnull(ll_icode) then
		wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext)
	end if
	if ab_flag then
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		ls_titleerrtext = "Service Validation"
		messagebox(ls_titleerrtext, ls_errtext)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
	end if
	return li_errcode

// w_inpatient_serviceorder.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	long iccode
	long icatcode
	long packcode
	long manfcode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_inpatient_serviceorder.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	integer ll_icode
	integer ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_inpatient_serviceorder.wf_populatesaledetail(long al_invid, datawindow ad_saledetail, string as_errortext, long al_errorrow) returns boolean
	long ll_detailrows
	long ll_stock
	long ll_newstock
	long ll_gcode
	long ll_icode
	long ll_salelooseqty
	long ll_dueqty
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode = 1
	long li_counter
	long li_innercounter
	long ll_insertedrows
	long ll_looseqty
	long ll_itemsdetailrowcount
	long ll_row
	long ll_itemflatdisc
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	boolean lb_commitflag = true
	string ls_batch
	string ls_updatesaleprice
	string ls_updsaleprice
	string ls_saleitemdescription
	datetime ld_expiry
	dwitemstatus ldws_column
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	ll_itemsdetailrowcount = 0
	ls_updatesaleprice = f_stringpreferences("updatesaleprice")
	as_errortext = "    Some database problem ocuurs         "
	do while li_counter <= ll_detailrows and lb_commitflag
		ll_gcode = this.id_detail.getitemnumber(li_counter, "gcode")
		ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
		ll_salelooseqty = this.id_detail.getitemnumber(li_counter, "looseqty")
		ll_dueqty = this.id_detail.getitemnumber(li_counter, "dueqty")
		ll_packunits = this.id_detail.getitemnumber(li_counter, "packunits")
		ld_saleprice = this.id_detail.getitemnumber(li_counter, "saleprice")
		ld_discperc = this.id_detail.getitemnumber(li_counter, "discperc")
		ld_rate = this.id_detail.getitemnumber(li_counter, "rate")
		ll_itemflatdisc = this.id_detail.getitemnumber(li_counter, "itemflatdisc")
		ls_saleitemdescription = this.id_detail.getitemstring(li_counter, "saleitemdescription")
		ldws_column = this.id_detail.getitemstatus(li_counter, "saleprice", primary!)
		ls_updsaleprice = this.id_detail.getitemstring(li_counter, "updatesaleprice")
		ll_salelooseqty = ll_salelooseqty - ll_dueqty
		this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			if ll_salelooseqty > 0 and lb_commitflag then
				if wf_selectitembatches(ll_gcode, ll_icode, ll_salelooseqty, ad_saledetail, ll_insertedrows, as_errortext) = 0 then
					for li_innercounter = 1 to ll_insertedrows
						ll_row = ll_itemsdetailrowcount + li_innercounter
						ad_saledetail.setitem(ll_row, "code", al_invid)
						ad_saledetail.setitem(ll_row, "packunits", ll_packunits)
						ad_saledetail.setitem(ll_row, "saleprice", ld_saleprice)
						ad_saledetail.setitem(ll_row, "discperc", ld_discperc)
						ad_saledetail.setitem(ll_row, "rate", ld_rate)
						ad_saledetail.setitem(ll_row, "avgprice", ld_avgprice)
						ad_saledetail.setitem(ll_row, "itemflatdisc", ll_itemflatdisc)
						ad_saledetail.setitem(ll_row, "saleitemdescription", ls_saleitemdescription)
						ls_batch = ad_saledetail.getitemstring(ll_row, "batch")
						ld_expiry = ad_saledetail.getitemdatetime(ll_row, "expiry")
						ll_looseqty = ad_saledetail.getitemnumber(ll_row, "looseqty")
						ll_stock = ad_saledetail.getitemnumber(ll_row, "stock")
						ll_newstock = ll_stock - ll_looseqty
						if ll_newstock > 0 then
							this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ll_newstock)
						else
							this.it_transobject.deleteitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ll_stock)
						end if
						if this.it_transobject.sqlcode <> 0 then
							lb_commitflag = false
						end if
					next
					ll_itemsdetailrowcount = ll_itemsdetailrowcount + ll_insertedrows
				else
					this.id_detail.setitem(li_counter, "stock", ll_insertedrows)
					lb_commitflag = false
				end if
			end if
			if ll_dueqty > 0 and lb_commitflag then
				ll_itemsdetailrowcount = ll_itemsdetailrowcount + 1
				ad_saledetail.insertrow(0)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "gcode", ll_gcode)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "icode", ll_icode)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "batch", "Due")
				ad_saledetail.setitem(ll_itemsdetailrowcount, "expiry", relativedate(today(), 365))
				ad_saledetail.setitem(ll_itemsdetailrowcount, "stock", ll_stock)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "totalstock", 0)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "looseqty", ll_dueqty)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "due", "D")
				ad_saledetail.setitem(ll_itemsdetailrowcount, "code", al_invid)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "packunits", ll_packunits)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "saleprice", ld_saleprice)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "discperc", ld_discperc)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "rate", ld_rate)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "avgprice", ld_avgprice)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "itemflatdisc", ll_itemflatdisc)
			end if
		else
			lb_commitflag = false
		end if
		li_counter = li_counter + 1
	loop
	if not lb_commitflag then
		al_errorrow = li_counter - 1
		messagebox("Database Error", as_errortext)
	end if
	return lb_commitflag

// w_inpatient_serviceorder.wf_post() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter = 1
	boolean lb_flag
	s_arguements lstr_arginfo
	datetime ldt_server_datetime
	string ls_date_errtext
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return -1
			end if
			SQL rollback USING sqlca;
			li_errcode = wf_lockserviceinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_saleinvcount)
			if li_errcode = 0 then
				if wf_generatecashreceipt(ldt_server_datetime, lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode) = -1 then
					SQL rollback USING sqlca;
					setfocus()
					setpointer(arrow!)
					return -1
				end if
				sqlca.postserviceoheader(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode)
				if sqlca.sqlcode <> 0 then
					li_errcode = -1
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if li_errcode <> 0 then
		messagebox("Posting Fails", "Some database request fails, Please try again")
	else
		messagebox("Posting Successfull", "Total unposted rows were " + string(ll_saleinvcount) + "~n~rAll rows have been posted successfully")
	end if
	return li_errcode

// w_inpatient_serviceorder.wf_getalias() returns string
	string ls_alias
	datetime ldt_server_datetime
	sqlca.getdatetime(ldt_server_datetime)
	if isnull(ldt_server_datetime) then
		ldt_server_datetime = datetime(date(today()), time(today()))
	end if
	ls_alias = right(string(year(date(ldt_server_datetime))), 2) + string(month(date(ldt_server_datetime))) + string(day(date(ldt_server_datetime))) + string(hour(time(ldt_server_datetime))) + string(minute(time(ldt_server_datetime))) + string(second(time(ldt_server_datetime)))
	return ls_alias

// w_inpatient_serviceorder.wf_newcustomer() returns integer
	s_saletemplate lstr_template
	long ll_custcode
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.rowcount() < 1 then
		return 1
	elseif this.id_master.getitemstring(1, "posted") = "Y" and not isnull(this.id_master.getitemnumber(1, "code")) then
		return 1
	end if
	open(w_popup_customer)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = true then
		this.idc_customers.setredraw(false)
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.retrieve()
		this.idc_customers.setredraw(true)
		ll_custcode = lstr_template.l_invtemplate
		this.id_master.setitem(this.id_detail.getrow(), "custcode", ll_custcode)
	end if
	return 1

// w_inpatient_serviceorder.wf_searchserviceorderbyservicedate() returns long
	s_saletemplate lstr_template
	long[] lla_detailrows
	long ll_serviceocode
	long ll_listcount
	long ll_found
	if this.tab_retrieve.selectedtab = 1 then
		return -1
	end if
	open(w_searchserviceorderbyservicedate)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		return -1
	end if
	lla_detailrows = lstr_template.l_detailrows
	ll_serviceocode = lla_detailrows[1]
	if ll_serviceocode > 0 then
		ll_listcount = this.id_list.rowcount()
		ll_found = this.id_list.find("code = " + string(ll_serviceocode), 1, ll_listcount)
		if ll_found > 0 and ll_found <= ll_listcount then
			this.id_list.scrolltorow(ll_found)
			this.id_list.selectrow(0, false)
			this.id_list.selectrow(ll_found, true)
			if this.ii_type = 1 then
				this.tab_retrieve.tabpage_list.dw_find.setitem(1, "find", this.id_list.getitemstring(ll_found, this.ii_colindex))
			elseif this.ii_type = 3 then
				this.tab_retrieve.tabpage_list.dw_find.setitem(1, "find", trim(string(this.id_list.getitemdatetime(ll_found, this.ii_colindex))))
			else
				this.tab_retrieve.tabpage_list.dw_find.setitem(1, "find", trim(string(this.id_list.getitemnumber(ll_found, this.ii_colindex))))
			end if
			this.il_selectedrow = ll_found
			this.tab_retrieve.tabpage_list.dw_find.selecttext(1, len(this.tab_retrieve.tabpage_list.dw_find.gettext()))
			this.tab_retrieve.selectedtab = 1
		else
			messagebox("Service Code Validation", "Your selected Service Order is not in the list.~r~nSo Kindly use Retrieve button to retrieve all rows than use this Search.")
			return -1
		end if
		return
	end if
	return 0

// w_inpatient_serviceorder.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_inpatient_serviceorder.wf_findadmissioncode(string as_regno, long al_admissioncode) returns long
	long ll_admissioncode
	long ll_retflag
	string ls_itemname
	SQL SELECT patientadmission.admissioncode INTO :ll_admissioncode FROM patient , patientadmission WHERE patient.regno =:as_regno AND patient.patientcode =patientadmission.patientcode and patientadmission.discharged1 ='N' and patientadmission.discharged ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_admissioncode = ll_admissioncode
		if isnull(al_admissioncode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_inpatient_serviceorder.wf_findpatientcode(long al_admissioncode) returns long
	long ll_patientcode
	SQL SELECT PatientCode INTO :ll_patientcode FROM PatientAdmission WHERE AdmissionCode =:al_admissioncode USING this.it_transobject;
	return ll_patientcode

// w_inpatient_serviceorder.wf_setadmissiondetails(long al_admissioncode) returns long
	long ll_retflag
	long ll_doctcode
	long ll_locationcode
	SQL SELECT patientadmission.doctorcode , patientadmission.locationcode INTO :ll_doctcode, :ll_locationcode FROM patientadmission WHERE patientadmission.Admissioncode =:al_admissioncode AND patientadmission.discharged1 ='N' and patientadmission.discharged ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.object.doctcode[this.id_master.getrow()] = ll_doctcode
		this.id_master.object.locationcode[this.id_master.getrow()] = ll_locationcode
		ll_retflag = 1
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_inpatient_serviceorder.wf_initmodify(integer ai_protect) returns 0
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_looseqty
	long ll_stock
	long ll_counter
	long ll_count
	long ll_custcode
	string ls_address
	string ls_city
	string ls_phone
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	if this.id_master.getitemstring(1, "posted") = "N" then
		if ai_protect = 0 then
			this.ib_modify = true
			this.editflag = true
			this.im_menu.m_file.m_save.enabled = true
			this.im_menu.m_file.m_new.enabled = false
			this.im_menu.m_file.m_delete.enabled = false
			this.im_menu.m_item.m_newitem.enabled = true
			this.im_menu.m_item.m_deleteitem.enabled = true
			this.im_menu.m_file.m_first.enabled = false
			this.im_menu.m_file.m_next.enabled = false
			this.im_menu.m_file.m_previous.enabled = false
			this.im_menu.m_file.m_last.enabled = false
			this.im_menu.m_file.m_retrieve.enabled = true
			this.im_menu.m_file.m_retrieve.text = "Lis&t"
			this.tab_retrieve.tabpage_detail.enabled = true
		end if
		return
	end if
	if ai_protect = 0 then
		this.ib_modify = true
		this.editflag = true
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_new.enabled = false
		this.im_menu.m_file.m_delete.enabled = false
		this.im_menu.m_item.m_newitem.enabled = true
		this.im_menu.m_item.m_deleteitem.enabled = true
		this.im_menu.m_file.m_first.enabled = false
		this.im_menu.m_file.m_next.enabled = false
		this.im_menu.m_file.m_previous.enabled = false
		this.im_menu.m_file.m_last.enabled = false
		this.im_menu.m_file.m_retrieve.enabled = true
		this.im_menu.m_file.m_retrieve.text = "Lis&t"
		this.tab_retrieve.tabpage_detail.enabled = true
		return
	end if
	this.ib_modify = true
	this.editflag = true
	this.im_menu.m_file.m_save.enabled = false
	this.im_menu.m_file.m_new.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_item.m_newitem.enabled = false
	this.im_menu.m_item.m_deleteitem.enabled = false
	this.im_menu.m_file.m_first.enabled = false
	this.im_menu.m_file.m_next.enabled = false
	this.im_menu.m_file.m_previous.enabled = false
	this.im_menu.m_file.m_last.enabled = false
	this.im_menu.m_file.m_retrieve.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.tab_retrieve.tabpage_detail.enabled = true

// w_inpatient_serviceorder.wf_admitted(long al_admissioncode) returns long
	long ll_count
	SQL SELECT Count ( *) INTO :ll_count FROM PatientAdmission WHERE PatientAdmission.AdmissionCode =:al_admissioncode AND PatientAdmission.Discharged ='N' AND PatientAdmission.Discharged1 ='N' USING sqlca;
	return ll_count

// w_inpatient_serviceorder.wf_generatecashreceipt(datetime adt_server_datetime, long al_custcode, double ad_totalcashreceived, integer ai_salesmancode, long al_invid, long al_patientcode) returns integer
	long ll_vochcode
	long ll_glvochcode
	long ll_null
	long ll_cashacc
	long ll_modifiedby
	long ll_postedby
	string ls_null
	string ls_remarks
	string ls_posted = "Y"
	long ll_vouchercatcode = 2
	datetime ldt_datetime
	double ld_zerovalue
	setnull(ll_null)
	setnull(ll_modifiedby)
	setnull(ls_null)
	ls_remarks = "Cash Receipt on Service Order#: " + string(al_invid)
	ll_postedby = ai_salesmancode
	ldt_datetime = adt_server_datetime
	if ad_totalcashreceived > 0.0 then
		this.it_transobject.getglobalcode("GT_CashAcc", ll_cashacc)
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Auto CashReceipt Generation Error", "Unable to find Cash Account while generating auto cash receipt.")
			return -1
		end if
		this.it_transobject.createvoucher(ll_vouchercatcode, ll_cashacc, ldt_datetime, ai_salesmancode, "Y", ldt_datetime, ls_remarks, ldt_datetime, ll_modifiedby, ll_postedby, ls_null, ll_cashacc, al_custcode, ad_totalcashreceived, ls_null, ls_remarks, al_patientcode, ll_null, ll_null, ll_null, ld_zerovalue, ld_zerovalue, ll_glvochcode, ll_vochcode, ll_null)
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Auto CashReceipt Generation Error", "Reasons are:~r~n" + this.it_transobject.sqlerrtext)
			return -1
		end if
		return
	end if
	return 0

// w_inpatient_serviceorder.wf_generatecashreceipt(datetime adt_server_datetime, long al_startinginvoice, long al_endinginvoice, integer ai_salesmancode) returns integer
	long ll_counter
	long ll_custcode
	integer li_servicepoststatus
	double ld_invadvance
	double ld_totaladvance
	double ld_servicesadvance
	long ll_vochcode
	long ll_glvochcode
	long ll_null
	long ll_cashacc
	long ll_modifiedby
	long ll_postedby
	long ll_patientcode
	long ll_admissioncode
	string ls_null
	string ls_remarks
	string ls_posted = "Y"
	long ll_vouchercatcode = 2
	datetime ldt_datetime
	double ld_zerovalue
	setnull(ll_null)
	setnull(ll_modifiedby)
	setnull(ls_null)
	setnull(ll_patientcode)
	setnull(ll_admissioncode)
	ll_postedby = ai_salesmancode
	ldt_datetime = adt_server_datetime
	sqlca.getglobalcode("GT_CashAcc", ll_cashacc)
	if sqlca.sqlcode <> 0 then
		messagebox("Auto CashReceipt Generation Error", "Unable to find Cash Account while generating auto cash receipt.")
		return -1
	end if
	for ll_counter = al_startinginvoice to al_endinginvoice
		SQL Select custcode , cashreceived , admissioncode , patientcode INTO :ll_custcode, :ld_invadvance, :ll_admissioncode, :ll_patientcode From ServiceOHeader Where Posted ='N' AND ServiceOCode =:ll_counter USING sqlca;
		if not isnull(ll_admissioncode) then
			ll_patientcode = wf_findpatientcode(ll_admissioncode)
		end if
		if sqlca.sqlcode = 0 then
			SQL Select Sum ( cashreceived ) INTO :ld_servicesadvance From ServiceODetail Where ServiceOcode =:ll_counter USING sqlca;
			if sqlca.sqlcode = 0 then
				ld_totaladvance = ld_invadvance + ld_servicesadvance
				if ld_totaladvance > 0.0 then
					sqlca.getglobalcode("GT_CashAcc", ll_cashacc)
					if this.it_transobject.sqlcode <> 0 then
						messagebox("Auto CashReceipt Generation Error", "Unable to find Cash Account while generating auto cash receipt.")
						return -1
					end if
					ls_remarks = "Cash Receipt on Service Order#: " + string(ll_counter)
					sqlca.createvoucher(ll_vouchercatcode, ll_cashacc, ldt_datetime, ai_salesmancode, "Y", ldt_datetime, ls_remarks, ldt_datetime, ll_modifiedby, ll_postedby, ls_null, ll_cashacc, ll_custcode, ld_totaladvance, ls_null, ls_remarks, ll_null, ll_patientcode, ll_null, ll_null, ld_zerovalue, ld_zerovalue, ll_glvochcode, ll_vochcode, ll_null)
					if this.it_transobject.sqlcode <> 0 then
						messagebox("Auto CashReceipt Generation Error", "Reasons are:~r~n" + this.it_transobject.sqlerrtext)
						return -1
					end if
					return
				end if
			else
				messagebox("Auto CashReceipt Generation Error", "Error in fetching ServiceOrder detail rows for calculating Services advance.")
				return -1
			end if
		elseif sqlca.sqlcode <> 100 then
			messagebox("Auto CashReceipt Generation Error", "Error in fetching ServiceOrder Header posting information.")
			return -1
		end if
	next
	return 0

// w_inpatient_serviceorder.wf_editservicetemplate() returns long
	datastore lds_detail
	datastore lds_header
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	integer li_retcode = 1
	integer li_errcode
	string ls_errortext
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.rowcount() > 0 then
		if this.id_master.object.posted[1] = "Y" and this.id_master.object.code[1] > 0 then
			return 0
		end if
	else
		return 0
	end if
	lds_detail = create datastore
	lds_header = create datastore
	open(w_edit_servicetemplate)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_detail.dataobject = "d_servicetemplate_detail"
		lds_detail.settransobject(this.it_transobject)
		lds_header.dataobject = "d_servicetemplate_header"
		lds_header.settransobject(this.it_transobject)
		ll_row = lds_header.retrieve(lstr_template.l_invtemplate)
		lds_detail.retrieve(lstr_template.l_invtemplate)
		ll_totalrows = lds_header.retrieve(lstr_template.l_invtemplate)
		if ll_row < 0 or ll_totalrows < 0 then
			li_retcode = -1
			return -1
		else
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
		end if
		ll_mrow = this.id_master.getrow()
		ll_totalrows = lds_detail.rowcount()
		this.id_detail.reset()
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_detail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "qty", lds_detail.getitemnumber(ll_rowcount, "qty"))
			this.id_detail.setitem(ll_rowcount, "saleprice", lds_detail.getitemnumber(ll_rowcount, "saleprice"))
			this.id_detail.setitem(ll_rowcount, "serviceflatdisc", lds_detail.getitemnumber(ll_rowcount, "serviceflatdisc"))
			this.id_detail.setitem(ll_rowcount, "discperc", lds_detail.getitemnumber(ll_rowcount, "discperc"))
			this.id_detail.setitem(ll_rowcount, "smancode", lds_detail.getitemnumber(ll_rowcount, "smancode"))
		next
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	return li_retcode

// w_inpatient_serviceorder.wf_refreshitemslist_itemname() returns 0
	s_popup_selection lstr_selection
	long ll_counter
	boolean lb_enablerestricted
	string ls_selection
	integer[] la_catcode
	open(w_popup_itemsearchcriteriaselection)
	lstr_selection = message.powerobjectparm
	if lstr_selection.l_code > 0 then
		ls_selection = lstr_selection.s_name2
		this.id_itemslist.reset()
		this.id_itemslist.setfilter("")
		this.id_itemslist.filter()
		f_retrieve_servicelist(this.id_itemslist, this.it_transobject)
		this.id_itemslist.setfilter("itemname LIKE '" + ls_selection + "'")
		this.id_itemslist.filter()
	end if

// w_inpatient_serviceorder.wf_refreshitemslist_catwise() returns 0
	long ll_counter
	string ls_categories
	integer[] la_catcode
	s_arguements lstr_arg
	open(w_choose_servicecategory)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = -1 then
		return
	end if
	la_catcode = lstr_arg.ia_integerlist
	ls_categories = ""
	for ll_counter = 1 to upperbound(la_catcode)
		ls_categories = ls_categories + string(la_catcode[ll_counter]) + " , "
	next
	ls_categories = ls_categories + " 0 "
	f_retrieve_servicelist(this.id_itemslist, this.it_transobject)
	this.id_itemslist.setfilter("servicecatcode In (" + ls_categories + ")")
	this.id_itemslist.filter()

// w_inpatient_serviceorder.wf_validate_price_discount_matters(long al_usercode) returns long
	long ll_masterrow
	long ll_servicecode
	long ll_counter
	double ld_discperc
	double ld_servicediscperclimit
	boolean lb_validdisc
	datastore lds_groupdiscinfo
	wf_grandtotal()
	lds_groupdiscinfo = create datastore
	lds_groupdiscinfo.dataobject = "d_groups_discount"
	lds_groupdiscinfo.settransobject(this.it_transobject)
	lds_groupdiscinfo.retrieve(al_usercode)
	lb_validdisc = false
	ll_masterrow = this.id_master.rowcount()
	for ll_counter = 1 to lds_groupdiscinfo.rowcount()
		ld_servicediscperclimit = lds_groupdiscinfo.getitemnumber(ll_counter, "servicediscperclimit")
	next
	for ll_counter = 1 to this.id_detail.rowcount()
		ll_servicecode = this.id_detail.getitemnumber(ll_counter, "icode")
		ld_discperc = this.id_detail.getitemnumber(ll_counter, "discperc")
		if ld_discperc > ld_servicediscperclimit then
			lb_validdisc = false
			exit
		else
			lb_validdisc = true
		end if
	next
	destroy lds_groupdiscinfo
	if lb_validdisc = false then
		messagebox("Disc% Validation ..", "Disc% is greater than your group permission~r~nGroup Discount % limit for Services is " + trim(string(ld_servicediscperclimit)) + "%~r~nPlease consult Administrator")
		this.id_detail.setfocus()
		this.id_detail.setrow(ll_counter)
		this.id_detail.setcolumn("discperc")
		return -1
	end if
	return 0

// w_inpatient_serviceorder.wf_inititeminfo(long al_icode, long al_row, integer ai_rtcode, string as_errortext) returns boolean
	boolean retflag = true
	double ld_saleprice
	double ld_discperc
	double ld_saleprice2
	double ld_saleprice3
	double ld_avgprice
	double ld_flatdisc
	long ll_packunits
	long ll_godownstock
	long ll_saleqty
	long ll_saleinvcode
	long ll_totalstock
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_allowsaleindecimal
	datetime ldt_date
	setnull(ls_null)
	SQL SELECT service.aliasname , service.name , service.price , service.serviceflatdisc , service.allowsaleindecimal INTO :ls_fullcode, :ls_name, :ld_saleprice, :ld_flatdisc, :ls_allowsaleindecimal FROM service WHERE service.servicecode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		ai_rtcode = -1
		retflag = false
		as_errortext = "Database Error: Service information can not be retrieved"
	end if
	if retflag then
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "serviceflatdisc", ld_flatdisc)
		this.id_detail.setitem(al_row, "allowsaleindecimal", ls_allowsaleindecimal)
		if this.id_detail.getitemstatus(al_row, "saleprice", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
			if al_row > 1 then
				ldt_date = this.id_detail.getitemdatetime(al_row - 1, "date")
				this.id_detail.setitem(al_row, "date", ldt_date)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
		end if
		this.id_detail.setitem(al_row, "itemcode", al_icode)
		this.id_detail.setitem(al_row, "icode", al_icode)
		ai_rtcode = 0
	else
		ai_rtcode = -1
		retflag = false
		as_errortext = "Unable to offer Service."
	end if
	return retflag

// w_inpatient_serviceorder.wf_show_inpatientbill() returns long
	long ll_admissioncode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_admissioncode = this.id_master.object.admissioncode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_admissioncode = this.id_list.object.admissioncode[this.id_list.getrow()]
	end if
	if not isnull(ll_admissioncode) and ll_admissioncode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_inpatient_bill, ll_admissioncode)
	end if
	return 0

// w_inpatient_serviceorder.wf_open_item_form_popup() returns 0
	openwithparm(w_patientadmission_form_popup, this, this)

// w_inpatient_serviceorder.wf_validate_admissioncode(long al_admissioncode) returns long
	long rt_code
	long ll_custcode
	long li_admissioncode
	long ll_null
	long ll_counter
	double ld_customerbalance
	string ls_result
	string ls_aliasname
	setnull(ll_null)
	if this.ii_servicetype = 11 then
		this.id_master.setitem(1, "regno", this.idc_patient.getitemstring(this.idc_patient.getrow(), "regno"))
		if isnull(al_admissioncode) then
			this.id_master.object.custcode.protect = 0
			this.id_master.object.aliasname.protect = 0
			this.id_master.setitem(1, "regno", "")
			this.id_master.setitem(1, "aliasname", "")
			this.id_master.setitem(1, "custcode", 0)
		else
			li_admissioncode = al_admissioncode
			SQL SELECT patient.custcode , patient.regno , accounts.aliasname INTO :ll_custcode, :ls_result, :ls_aliasname FROM patient , patientadmission , accounts WHERE patientadmission.discharged1 ='N' and patientadmission.discharged ='N' and patientadmission.admissioncode =:li_admissioncode and patient.patientcode =patientadmission.patientcode and patient.custcode =accounts.acccode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				this.id_master.setitem(1, "regno", ls_result)
				this.id_master.setitem(1, "aliasname", ls_aliasname)
				this.id_master.setitem(1, "custcode", ll_custcode)
				wf_setadmissiondetails(li_admissioncode)
				this.id_master.object.custcode.protect = 1
				this.id_master.object.aliasname.protect = 1
				if f_stringpreferences("InServiceCustomerBalance") = "Y" then
					for ll_counter = 1 to this.ids_customersbalance.rowcount()
						if this.ids_customersbalance.getitemnumber(ll_counter, "code1") = this.id_master.getitemnumber(1, "custcode") then
							ld_customerbalance = this.ids_customersbalance.getitemnumber(ll_counter, "value1")
							this.id_master.setitem(1, "customerbalance", ld_customerbalance)
							if ld_customerbalance > 0.0 then
								this.id_master.setitem(1, "debitorcredit", "Dr")
							else
								this.id_master.setitem(1, "debitorcredit", "Cr")
							end if
							exit
						else
							this.id_master.setitem(1, "debitorcredit", "Cr")
							this.id_master.setitem(1, "customerbalance", 0)
						end if
					next
				end if
			else
				messagebox("Patient Information", "Problem in retrieving corresponding customer")
				rt_code = 1
			end if
		end if
	end if
	return rt_code

// w_inpatient_serviceorder.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_ipserviceordermenu" then
		this.menuid = create m_ipserviceordermenu
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	this.dw_saleinvdetail = create dw_saleinvdetail
	this.dw_new_account = create dw_new_account
	this.dw_new_customer = create dw_new_customer
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.dw_saleinvdetail
	this.control[icurrent + 3] = this.dw_new_account
	this.control[icurrent + 4] = this.dw_new_customer

// w_inpatient_serviceorder.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.dw_saleinvdetail
	destroy this.dw_new_account
	destroy this.dw_new_customer

// w_inpatient_serviceorder.ue_save() returns 0 [event]
	integer li_counter
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_stock
	long ll_newstock
	long ll_icode
	long ll_salelooseqty
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode = 1
	long ll_gcode
	long ll_headerno
	long ll_headerinvno
	long ll_counter
	long ll_count
	long ll_custcode
	long ll_patientcode
	long ll_null
	boolean lb_commitflag = true
	boolean lb_continue = true
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_invcashreceived
	double ld_servicescashreceived
	double ld_totaladvance
	datetime ldt_server_datetime
	string ls_errtext
	string ls_date_errtext
	setnull(ll_null)
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Service Order Validation", "Service Order total can not be negative")
		return
	end if
	if wf_admitted(this.id_master.object.admissioncode[this.id_master.getrow()]) <= 0 then
		messagebox("Problem Saving", "Patient No more Admitted.~r~nChoose some other patient")
		this.id_master.setfocus()
		this.id_master.setcolumn("admissioncode")
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if f_stringpreferences("ServiceSalesManWindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		if wf_validate_price_discount_matters(ll_salesmancode) < 0 then
			return
		end if
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if isnull(ll_invid) then
			wf_tabnewid("ServiceOHeader", ll_invid)
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
		end if
		if f_stringpreferences("Headeronsaleinv") = "N" then
			this.id_master.setitem(ll_mastercurrrow, "Headerno", f_numberpreferences("headerno"))
		end if
		ld_misccharges = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges")
		ld_invdiscperc = this.id_footer.getitemnumber(ll_footercurrrow, "invdiscperc")
		ld_flatdisc = this.id_footer.getitemnumber(ll_footercurrrow, "flatdisc")
		ld_invcashreceived = this.id_footer.getitemnumber(ll_footercurrrow, "cashreceived")
		this.id_master.setitem(ll_mastercurrrow, "discperc", ld_invdiscperc)
		this.id_master.setitem(ll_mastercurrrow, "flatdisc", ld_flatdisc)
		this.id_master.setitem(ll_mastercurrrow, "misccharges", ld_misccharges)
		this.id_master.setitem(ll_mastercurrrow, "cashreceived", ld_invcashreceived)
		if this.ib_modify then
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			this.id_master.setitem(ll_mastercurrrow, "date", today())
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		else
			this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "PostDate", ldt_server_datetime)
		end if
		if lb_continue then
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.setitem(ll_counter, "Code", ll_invid)
			next
			if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" and f_stringpreferences("ServiceOrderPosting") = "Y" then
				this.id_master.setitem(ll_mastercurrrow, "Posted", "Y")
				this.id_master.setitem(ll_mastercurrrow, "PostedBy", ll_salesmancode)
				this.id_master.setitem(ll_mastercurrrow, "PostDate", ldt_server_datetime)
				ll_custcode = this.id_master.getitemnumber(ll_mastercurrrow, "custcode")
				ld_invcashreceived = this.id_footer.getitemdecimal(this.id_footer.getrow(), "cashreceived")
				ld_servicescashreceived = this.id_detail.getitemdecimal(this.id_detail.getrow(), "c_cashreceived")
				ld_totaladvance = ld_invcashreceived + ld_servicescashreceived
				if ld_totaladvance > 0.0 then
					ll_patientcode = wf_findpatientcode(this.id_master.object.admissioncode[ll_mastercurrrow])
					if wf_generatecashreceipt(ldt_server_datetime, ll_custcode, ld_totaladvance, ll_salesmancode, ll_invid, ll_patientcode) = -1 then
						SQL rollback USING this.it_transobject;
						if this.ib_modify = false then
							this.id_master.setitem(1, "Code", ll_null)
						end if
						return
					end if
					return
				end if
				return
			end if
			call super::ue_save
			this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
			this.id_saleinvdetail.reset()
			if this.ib_commitok then
				this.ib_modify = false
			else
				lb_continue = false
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			messagebox("Updation Error", ls_errtext + " in current row", stopsign!)
			if this.ib_modify = false then
				this.id_master.setitem(1, "Code", ll_null)
			end if
		elseif f_stringpreferences("IncSvcSOInActMonitor") = "Y" then
			this.it_transobject.updateactivitymonitor("VO", ll_invid)
			if this.it_transobject.sqlcode <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
			else
				SQL commit USING this.it_transobject;
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_inpatient_serviceorder.ue_newform() returns 0 [event]
	integer rtncode
	long li_fetched_code
	long row
	long ll_manfcode
	m_ipserviceordermenu lm_menu
	call super::ue_newform
	lm_menu = this.menuid
	setredraw(false)
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.im_menu.m_file.m_print.enabled = true
	lm_menu.m_file.m_searchbyservicedate.enabled = false
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.ib_modify = false
	this.id_footer.setitem(1, "invdiscperc", f_numberpreferences("invdiscperc"))
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	wf_visible(true)
	this.id_detail.object.cancelstatus.protect = 1
	setredraw(true)

// w_inpatient_serviceorder.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect = 1
	long ll_row
	long ll_code
	boolean lb_flag
	boolean lb_modify
	m_ipserviceordermenu lm_menu
	call super::ue_detail
	lm_menu = this.menuid
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	lm_menu.m_file.m_searchbyservicedate.enabled = false
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		li_protect = 0
		wf_initmodify(li_protect)
		wf_protectdw(this.id_master, li_protect)
		wf_protectdw(this.id_detail, li_protect)
		wf_protectdw(this.id_footer, li_protect)
		this.id_detail.object.cancelstatus.protect = 1
	else
		if this.id_detail.rowcount() > 0 then
			li_protect = 0
		else
			li_protect = 1
		end if
		wf_initmodify(li_protect)
		wf_protectdw(this.id_master, 1)
		wf_protectdw(this.id_detail, li_protect)
		wf_protectdw(this.id_footer, 1)
		this.id_detail.object.cancelstatus.protect = 0
	end if
	if wf_admitted(this.id_master.object.admissioncode[this.id_master.getrow()]) <= 0 then
		this.id_master.object.admissioncode.visible = false
		this.id_master.setitem(1, "patientcode", wf_findpatientcode(this.id_master.object.admissioncode[this.id_master.getrow()]))
	else
		this.id_master.object.admissioncode.visible = true
	end if
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	wf_grandtotal()
	setredraw(true)

// w_inpatient_serviceorder.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.setcolumn("itemname")
	this.id_detail.insertrow(0)
	this.ib_focusdetail = true
	this.id_itemslist.show()
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		if f_stringpreferences("itemcode") = "N" then
			this.id_detail.setcolumn("itemname")
			this.ib_focusdetail = true
			this.id_itemslist.show()
		else
			this.id_detail.setcolumn("fullcode")
			this.ib_focusdetail = true
			this.id_itemslist.hide()
		end if
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true
	this.idc_timeslot.settransobject(this.it_transobject)
	this.idc_timeslot.insertrow(0)

// w_inpatient_serviceorder.ue_deleteitem() returns 0 [event]
	long ll_row
	long ll_footerrow
	long ll_currow
	long ll_detailrows
	if this.id_detail.rowcount() <= 0 then
		return
	end if
	this.ib_itemvalidated = true
	if isnull(this.id_detail.getitemnumber(this.id_detail.getrow(), "srvorowid")) then
		this.id_detail.deleterow(0)
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows < 1 then
		this.im_menu.m_file.m_save.enabled = false
	end if
	wf_grandtotal()
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() <= 0 then
		this.im_menu.m_file.m_save.enabled = false
	end if

// w_inpatient_serviceorder.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	return ::message.returnvalue

// w_inpatient_serviceorder.ue_list() returns 0 [event]
	m_ipserviceordermenu lm_menu
	call super::ue_list
	lm_menu = this.menuid
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_post.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	lm_menu.m_file.m_searchbyservicedate.enabled = true
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	wf_retrievelist()

// w_inpatient_serviceorder.ue_print() returns 0 [event]
	long ll_custcode
	long ll_row
	long ll_saleinvcode
	long i
	long ll_invcode
	string ls_custname
	integer li_option
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	if gs_company = "SADAFCD" then
		this.id_print.dataobject = "d_sadafcd_serviceoinvreport"
	elseif gs_company = "KHYBER" then
		this.id_print.dataobject = "d_khyber_serviceoinvreport"
	elseif gs_company = "FAISALMEMORIAL" then
		this.id_print.dataobject = "d_faisalmemorial_ipserviceoinvreport"
	else
		this.id_print.dataobject = "d_serviceoinvreport"
	end if
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_inpatient_serviceorder.ue_refreshddw() returns 0 [event]
	f_retrieve_servicelist(this.id_itemslist, this.it_transobject)
	setpointer(hourglass!)
	this.idc_customers.setredraw(false)
	this.idc_customers.settransobject(this.it_transobject)
	this.idc_customers.retrieve()
	this.idc_customers.setredraw(true)
	if f_stringpreferences("InServiceCustomerBalance") = "Y" then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		this.ids_customersbalance.retrieve()
	end if
	this.idc_shift.settransobject(this.it_transobject)
	this.idc_shift.retrieve()
	this.idc_salesman.settransobject(this.it_transobject)
	this.idc_salesman.retrieve()
	this.idc_patient.retrieve()
	setpointer(arrow!)

// w_inpatient_serviceorder.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_inpatient_serviceorder.ue_postopen() returns 0 [event]
	datawindowchild ldc_headerno
	m_ipserviceordermenu lm_menu
	integer li_rtncode
	long ll_counter
	long ll_pos
	long li_count
	long ll_startrow
	char lc_char
	call super::ue_postopen
	setredraw(false)
	this.ii_servicetype = integer(message.doubleparm)
	this.id_print = this.dw_saleinvrep
	this.id_saleinvdetail = this.dw_saleinvdetail
	this.id_saleinvdetail.settransobject(this.it_transobject)
	li_rtncode = this.id_master.getchild("custcode", this.idc_customers)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_customers.settransobject(this.it_transobject)
	if f_stringpreferences("InServiceCustomerBalance") = "Y" then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		this.ids_customersbalance = create datastore
		this.ids_customersbalance.dataobject = "d_customerbalances_in_sales"
		this.ids_customersbalance.settransobject(sqlca)
		this.ids_customersbalance.retrieve()
	end if
	li_rtncode = this.id_detail.getchild("smancode", this.idc_salesman)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild for SalesMan in detail datawindow")
		close(this)
	end if
	this.idc_salesman.settransobject(this.it_transobject)
	li_rtncode = this.id_detail.getchild("shiftcode", this.idc_shift)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild for Shift in detail datawindow")
		close(this)
	end if
	this.idc_shift.settransobject(this.it_transobject)
	li_rtncode = this.id_detail.getchild("ddtscode", this.idc_timeslot)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild for Time Slot in detail datawindow")
		close(this)
	end if
	this.idc_timeslot.settransobject(this.it_transobject)
	this.idc_timeslot.retrieve(1)
	if this.idc_timeslot.retrieve(1) <= 0 then
		this.idc_timeslot.insertrow(0)
	end if
	li_rtncode = this.id_master.getchild("admissioncode", this.idc_patient)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_patient.settransobject(this.it_transobject)
	this.idc_patient.retrieve()
	if f_stringpreferences("headeronsaleinv") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.t_headerno.visible = false
	else
		this.id_master.getchild("headerno", ldc_headerno)
		for ll_counter = 1 to gds_reoprtheaderinfo.rowcount()
			ldc_headerno.insertrow(0)
			ll_pos = pos(gds_reoprtheaderinfo.getitemstring(ll_counter, "clientname"), " ")
			ldc_headerno.setitem(ll_counter, "name", left(gds_reoprtheaderinfo.getitemstring(ll_counter, "clientname"), ll_pos))
			ldc_headerno.setitem(ll_counter, "code", gds_reoprtheaderinfo.getitemnumber(ll_counter, "headerno"))
		next
	end if
	f_retrieve_servicelist(this.id_itemslist, this.it_transobject)
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	if f_stringpreferences("servicedoctid") = "N" then
		this.id_master.object.doctcode.visible = false
		this.id_master.object.t_doctorid.visible = false
	end if
	this.id_detail.object.smancode.initial = trim(string(f_numberpreferences("InitialSManCodeInService")))
	if f_stringpreferences("showflatdiscincreditservicedetail") = "N" then
		this.id_detail.object.serviceflatdisc.visible = false
	end if
	if f_stringpreferences("SalesManInService") = "N" then
		this.id_detail.object.smancode.visible = false
		this.id_detail.object.t_salesman.visible = false
	end if
	if f_stringpreferences("ShowItemAdvanceInServiceOrder") = "N" then
		this.id_detail.object.cashreceived.visible = false
	end if
	if f_stringpreferences("ShowInvAdvanceInServiceOrder") = "N" then
		this.id_footer.object.cashreceived.visible = false
		this.id_footer.object.cashreceived_t.visible = false
	else
		this.id_footer.object.cashreceived.visible = true
		this.id_footer.object.cashreceived_t.visible = true
	end if
	if f_stringpreferences("AskDateInServiceOrder") = "N" then
		this.id_detail.object.date.visible = false
	end if
	if f_stringpreferences("AskShiftInServiceOrder") = "N" then
		this.id_detail.object.shiftcode.visible = false
	end if
	if f_stringpreferences("AskTimeSlotInServiceOrder") = "N" then
		this.id_detail.object.ddtscode.visible = false
		if this.idc_timeslot.retrieve(1) > 0 then
			this.id_detail.object.ddtscode.initial = string(this.idc_timeslot.getitemnumber(1, "tscode"))
			this.id_detail.object.tscode.initial = string(this.idc_timeslot.getitemnumber(1, "tscode"))
		else
			this.id_detail.object.tscode.initial = "1"
			this.id_detail.object.ddtscode.initial = "1"
		end if
	end if
	this.idc_timeslot.retrieve(1)
	if this.idc_timeslot.retrieve(1) <= 0 then
		this.idc_timeslot.insertrow(0)
	end if
	for li_count = 65 to 90
		lc_char = char(li_count)
		this.ia_llookuptable[li_count] = this.id_itemslist.find("Lower(itemname) >= Lower('" + char(li_count) + "')", ll_startrow, 99999)
		ll_startrow = this.ia_llookuptable[li_count]
	next
	this.ia_llookuptable[92] = 99999
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	f_setserviceqtystyle(this.id_detail, "qty")
	setredraw(true)

// w_inpatient_serviceorder.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	return ::message.returnvalue

// w_inpatient_serviceorder.ue_callback_popupwindow(any ar_object) returns 0 [event]
	long ll_code
	long ll_row
	string as_errortext
	super::ue_callback_popupwindow(ar_object)
	ll_code = long(ar_object)
	ll_row = this.id_detail.getrow()
	if ll_row > 0 and ll_code > 0 then
		this.idc_patient.retrieve()
		if this.id_master.rowcount() > 0 then
			this.id_master.setitem(this.id_master.rowcount(), "admissioncode", ll_code)
		end if
		this.id_master.setfocus()
		this.id_master.setcolumn("admissioncode")
		wf_validate_admissioncode(ll_code)
	end if
	this.id_master.accepttext()

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	return ::message.returnvalue

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
	case "flatdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	end choose
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_code
	long ll_detailrows
	long ll_suppcode
	long ll_custcode
	long ll_counter
	long ll_customerbalance
	long ll_headerinvno
	long ll_admissioncode
	integer rt_code
	integer li_custcode
	long ll_icode
	long ld_saleprice1
	long ld_saleprice2
	long ld_saleprice3
	long ld_avgprice
	long li_packunits
	string ls_result
	string ls_null
	string ls_aliasname
	datetime ld_currdate
	date ld_datepart
	time lt_timepart
	char lc_newcustomer
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "headerno"
		setnull(ll_headerinvno)
		setitem(row, "headerinvno", ll_headerinvno)
	case "newcustomer"
		lc_newcustomer = data
		if lc_newcustomer = "Y" then
			this.object.accounts_name.visible = true
			this.object.custcode.visible = false
		else
			this.object.accounts_name.visible = false
			this.object.custcode.visible = true
		end if
	case "date"
		if isdate(left(data, 10)) then
			ld_datepart = date(left(data, 10))
			if istime(mid(data, 12, 8)) then
				lt_timepart = time(mid(data, 12, 8))
				ld_currdate = datetime(ld_datepart, lt_timepart)
				if ld_currdate < parent.parent.parent.id_systemdate then
					rt_code = 1
				end if
			else
				rt_code = 1
			end if
		else
			rt_code = 1
		end if
	case "aliasname"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findcustcode(li_custcode, data)
			if li_res > 0 then
				setitem(row, "custcode", li_custcode)
				if f_stringpreferences("InServiceCustomerBalance") = "Y" then
					for ll_counter = 1 to parent.parent.parent.ids_customersbalance.rowcount()
						if parent.parent.parent.ids_customersbalance.getitemnumber(ll_counter, "code1") = getitemnumber(row, "custcode") then
							ll_customerbalance = parent.parent.parent.ids_customersbalance.getitemnumber(ll_counter, "value1")
							setitem(row, "customerbalance", ll_customerbalance)
							if ll_customerbalance > 0 then
								setitem(row, "debitorcredit", "Dr")
							else
								setitem(row, "debitorcredit", "Cr")
							end if
							exit
						else
							setitem(row, "debitorcredit", "Cr")
							setitem(row, "customerbalance", 0)
						end if
					next
				end if
				rt_code = 0
			else
				messagebox("Customer Validation", "Customer with  Alias Name  " + data + "   does not exist")
				rt_code = 1
			end if
		end if
	case "custcode"
		lc_newcustomer = this.object.newcustomer[row]
		if lc_newcustomer = "N" and not isnull(data) then
			ll_code = long(data)
			parent.setredraw(false)
			if parent.parent.parent.wf_customerinfo(ll_code) <> 0 then
				messagebox("Database Error", "Can not retrieve information of customer from database")
				rt_code = 1
			else
				if accepttext() = -1 then
					return 1
				end if
				ls_aliasname = parent.parent.parent.idc_customers.getitemstring(parent.parent.parent.idc_customers.getrow(), "accounts_aliasname")
				setitem(row, "aliasname", ls_aliasname)
				if f_stringpreferences("InServiceCustomerBalance") = "Y" then
					for ll_counter = 1 to parent.parent.parent.ids_customersbalance.rowcount()
						if parent.parent.parent.ids_customersbalance.getitemnumber(ll_counter, "code1") = getitemnumber(row, "custcode") then
							ll_customerbalance = parent.parent.parent.ids_customersbalance.getitemnumber(ll_counter, "value1")
							setitem(row, "customerbalance", ll_customerbalance)
							if ll_customerbalance > 0 then
								setitem(row, "debitorcredit", "Dr")
							else
								setitem(row, "debitorcredit", "Cr")
							end if
							exit
						else
							setitem(row, "debitorcredit", "Cr")
							setitem(row, "customerbalance", 0)
						end if
					next
				end if
			end if
			parent.setredraw(true)
		end if
	case "accounts_name"
		if parent.parent.parent.wf_findcustomerbyname(data) then
			messagebox("Customer Name Validation", "Customer with the same name already exist.~r~n" + "Kindly choose some other name.")
			rt_code = 1
		end if
	case "regno"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findadmissioncode(data, ll_admissioncode)
			if li_res > 0 then
				setitem(row, "admissioncode", ll_admissioncode)
				rt_code = 0
				if parent.parent.parent.ii_servicetype = 11 then
					SQL SELECT patient.custcode , accounts.aliasname INTO :ll_custcode, :ls_aliasname FROM patient , patientadmission , accounts WHERE patientadmission.discharged1 ='N' and patientadmission.discharged ='N' and patientadmission.admissioncode =:ll_admissioncode and patient.patientcode =patientadmission.patientcode and patient.custcode =accounts.acccode USING parent.parent.parent.it_transobject;
					if parent.parent.parent.it_transobject.sqlcode = 0 then
						parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
						parent.parent.parent.id_master.setitem(1, "aliasname", ls_aliasname)
						parent.parent.parent.id_master.object.custcode.protect = 1
						parent.parent.parent.id_master.object.aliasname.protect = 1
						parent.parent.parent.wf_setadmissiondetails(ll_admissioncode)
						if f_stringpreferences("InServiceCustomerBalance") = "Y" then
							for ll_counter = 1 to parent.parent.parent.ids_customersbalance.rowcount()
								if parent.parent.parent.ids_customersbalance.getitemnumber(ll_counter, "code1") = getitemnumber(row, "custcode") then
									ll_customerbalance = parent.parent.parent.ids_customersbalance.getitemnumber(ll_counter, "value1")
									setitem(row, "customerbalance", ll_customerbalance)
									if ll_customerbalance > 0 then
										setitem(row, "debitorcredit", "Dr")
									else
										setitem(row, "debitorcredit", "Cr")
									end if
									exit
								else
									setitem(row, "debitorcredit", "Cr")
									setitem(row, "customerbalance", 0)
								end if
							next
						end if
					else
						messagebox("Patient Information", "Problem in retrieving corresponding customer")
						rt_code = 1
					end if
				end if
			else
				messagebox("Patient Validation", "Patient with  RegNo  " + data + " does not exist")
				rt_code = 1
			end if
		end if
	case "admissioncode"
		if parent.parent.parent.ii_servicetype = 11 then
			parent.parent.parent.id_master.setitem(1, "regno", parent.parent.parent.idc_patient.getitemstring(parent.parent.parent.idc_patient.getrow(), "regno"))
			if isnull(data) then
				parent.parent.parent.id_master.object.custcode.protect = 0
				parent.parent.parent.id_master.object.aliasname.protect = 0
				parent.parent.parent.id_master.setitem(row, "regno", "")
				parent.parent.parent.id_master.setitem(row, "aliasname", "")
				parent.parent.parent.id_master.setitem(row, "custcode", 0)
			else
				ll_admissioncode = long(data)
				SQL SELECT patient.custcode , patient.regno , accounts.aliasname INTO :ll_custcode, :ls_result, :ls_aliasname FROM patient , patientadmission , accounts WHERE patientadmission.discharged1 ='N' and patientadmission.discharged ='N' and patientadmission.admissioncode =:ll_admissioncode and patient.patientcode =patientadmission.patientcode and patient.custcode =accounts.acccode USING parent.parent.parent.it_transobject;
				if parent.parent.parent.it_transobject.sqlcode = 0 then
					parent.parent.parent.id_master.setitem(row, "regno", ls_result)
					parent.parent.parent.id_master.setitem(row, "aliasname", ls_aliasname)
					parent.parent.parent.id_master.setitem(row, "custcode", ll_custcode)
					parent.parent.parent.wf_setadmissiondetails(ll_admissioncode)
					parent.parent.parent.id_master.object.custcode.protect = 1
					parent.parent.parent.id_master.object.aliasname.protect = 1
					if f_stringpreferences("InServiceCustomerBalance") = "Y" then
						for ll_counter = 1 to parent.parent.parent.ids_customersbalance.rowcount()
							if parent.parent.parent.ids_customersbalance.getitemnumber(ll_counter, "code1") = getitemnumber(row, "custcode") then
								ll_customerbalance = parent.parent.parent.ids_customersbalance.getitemnumber(ll_counter, "value1")
								setitem(row, "customerbalance", ll_customerbalance)
								if ll_customerbalance > 0 then
									setitem(row, "debitorcredit", "Dr")
								else
									setitem(row, "debitorcredit", "Cr")
								end if
								exit
							else
								setitem(row, "debitorcredit", "Cr")
								setitem(row, "customerbalance", 0)
							end if
						next
					end if
				else
					messagebox("Patient Information", "Problem in retrieving corresponding customer")
					rt_code = 1
				end if
			end if
		end if
		return rt_code
	end choose
	return rt_code

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "date"
		messagebox("Date Time Validation", "Date and Time is invalid,~r~nPlease enter current date and time")
	case "custcode"
		return 1
	case "address"
		messagebox("Customer Address Validation", "Please enter Customer Address")
	case "city"
		messagebox("Customer City Validation", "Please enter Customer City Name")
	case "phone"
		messagebox("Customer Phone Validation", "Please enter Customer Phone Number")
	case "custrefno"
		if data = "" or isnull(data) then
			messagebox("Customer Reference Validation", "Please Enter Reference")
		end if
	case "headerno"
		if data = "" or isnull(data) then
			messagebox("Header No Validation", "You must select some HeaderNo")
		end if
	case "Regno"
		if data = "" or isnull(data) then
			messagebox("Patient Validation", "RegNo Does Not Exist")
		end if
	end choose
	return 1

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	long ll_found
	long ll_admissioncode
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if getcolumnname() = "admissioncode" then
		if key = keyf5! then
			ll_found = gds_security.find("rightcode = 369 OR rightcode = 1220 ", 1, gds_security.rowcount())
			if ll_found > 0 then
				parent.parent.parent.wf_open_item_form_popup()
			end if
		elseif key = keyf9! then
			parent.parent.parent.wf_show_patientgallery()
		end if
	elseif key = keyf6! and getcolumnname() = "admissioncode" then
		ll_admissioncode = this.object.admissioncode[1]
		openwithparm(w_mr_patient_prescription_view, ll_admissioncode)
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	integer li_servicecode
	long ll_newqty
	long ll_storedqty
	long ll_stock
	long ll_null
	long ll_icode
	long ll_gcode
	string ls_null
	string ls_itemname
	date ld_date
	long ll_shift
	long ll_hold
	string ls_shift
	long ll_tscode
	string ls_timeslotname
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		if parent.parent.parent.id_master.getitemstring(parent.parent.parent.id_master.getrow(), "Posted") = "Y" and not isnull(getitemnumber(row, "srvorowid")) then
			messagebox("Posted ServiceOrder Validation", "You are not allowed to change saved Service on Posted ServiceOrder.")
			return 2
		end if
		parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
		parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		li_errcode = 0
	case "date"
		ld_date = date(mid(data, 1, 10))
		if ld_date < today() then
			messagebox("Service Date Validation", "Please enter value greater than or equal to today's date.")
			li_errcode = 1
		end if
	case "shiftcode"
		ll_shift = long(data)
		if not isnull(ll_shift) and ll_shift > 0 then
			SQL rollback USING sqlca;
			SQL Select COUNT ( ShiftCode ) INTO :ll_hold From TimeSlot Where ShiftCode =:ll_shift USING sqlca;
			if ll_hold > 0 then
				parent.parent.parent.idc_timeslot.reset()
				parent.parent.parent.idc_timeslot.retrieve(ll_shift)
			else
				parent.parent.parent.idc_timeslot.reset()
				parent.parent.parent.idc_timeslot.insertrow(0)
				setnull(ll_shift)
				setnull(ls_shift)
				setitem(row, "ddtscode", ls_shift)
				setitem(row, "tscode", ll_shift)
			end if
		else
			parent.parent.parent.idc_timeslot.reset()
			parent.parent.parent.idc_timeslot.insertrow(0)
		end if
	case "ddtscode"
		ls_timeslotname = data
		ll_tscode = parent.parent.parent.idc_timeslot.getitemnumber(parent.parent.parent.idc_timeslot.getrow(), "tscode")
		if not isnull(ls_timeslotname) then
			setitem(row, "tscode", ll_tscode)
		else
			setnull(ll_tscode)
			setitem(row, "tscode", ll_tscode)
		end if
	case "saleprice"
		if parent.parent.parent.id_master.getitemstring(parent.parent.parent.id_master.getrow(), "Posted") = "Y" and not isnull(getitemnumber(row, "srvorowid")) then
			messagebox("Posted ServiceOrder Validation", "You are not allowed to change Service Charges on Posted ServiceOrder.")
			return 2
		end if
	case "discperc"
		if parent.parent.parent.id_master.getitemstring(parent.parent.parent.id_master.getrow(), "Posted") = "Y" and not isnull(getitemnumber(row, "srvorowid")) then
			messagebox("Posted ServiceOrder Validation", "You are not allowed to change Disc% on Posted ServiceOrder.")
			return 2
		end if
	case "cashreceived"
		if parent.parent.parent.id_master.getitemstring(parent.parent.parent.id_master.getrow(), "Posted") = "Y" then
			messagebox("Posted ServiceOrder Validation", "You are not allowed to change Service Advance on Posted ServiceOrder.")
			return 2
		end if
		if real(data) > getitemnumber(row, "c_itemtotal") then
			messagebox("Service Advance Validation", "Please enter Advance value less than or equal to Amount value.")
			li_errcode = 1
		end if
	case "fullcode"
		if isnull(data) or data = "" then
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			setitem(row, "itemname", ls_itemname)
			li_errcode = 2
		else
			li_res = parent.parent.parent.wf_find_service_fullcode(data, ll_icode, ls_itemname)
			if li_res > 0 then
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				setitem(row, "qty", 1)
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
				if parent.parent.parent.wf_validateitem(false) = 0 then
					li_errcode = 0
				else
					li_errcode = 1
				end if
			else
				messagebox("Service Code/Alias Name Validation", "Service does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				setitem(row, "itemname", ls_itemname)
				li_errcode = 1
			end if
		end if
	case "qty"
		if double(data) > 0.0 then
			if double(long(data)) <> double(data) and parent.parent.parent.id_detail.object.allowsaleindecimal[row] = "N" then
				messagebox("Quantity Validation", "Quantity In decimals is not allowed for this service", stopsign!)
				li_errcode = 1
			else
				li_errcode = 0
			end if
		else
			messagebox("Quantity Validation", "Please enter a valid Quantity for this service", stopsign!)
			li_errcode = 1
		end if
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ll_icode
	long ll_gcode
	long ll_godownstock
	long ll_shift
	long ll_hold
	long ancestorreturnvalue
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(false) = -1 then
		return ::message.returnvalue
	end if
	if dwo.name <> "itemname" and parent.parent.parent.ib_itemslistopen then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
	end if
	if dwo.name = "itemname" then
		parent.parent.parent.ib_focusdetail = true
		parent.parent.parent.id_itemslist.show()
	else
		parent.parent.parent.id_itemslist.hide()
	end if
	if dwo.name = "ddtscode" then
		ll_shift = getitemnumber(row, "shiftcode")
		if not isnull(ll_shift) and ll_shift > 0 then
			SQL Select COUNT ( ShiftCode ) INTO :ll_hold From TimeSlot Where ShiftCode =:ll_shift USING sqlca;
			if ll_hold > 0 then
				parent.parent.parent.idc_timeslot.reset()
				parent.parent.parent.idc_timeslot.retrieve(ll_shift)
			else
				parent.parent.parent.idc_timeslot.reset()
				parent.parent.parent.idc_timeslot.insertrow(0)
			end if
		else
			parent.parent.parent.idc_timeslot.reset()
			parent.parent.parent.idc_timeslot.insertrow(0)
		end if
	end if
	parent.parent.parent.wf_grandtotal()
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(true) = -1 then
		return ::message.returnvalue
	end if
	lrs_status = getitemstatus(currentrow, 0, primary!)
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		if data = "" or isnull(data) then
			messagebox("Service Validation", "Please enter value for Service in row " + string(row))
		end if
	case "discperc"
		if real(data) < 0.0 and real(data) > 100.0 then
			messagebox("Service Discount Validation", "Discount ~"" + data + "~" must be betweeen 0 and 100")
		end if
	case "date"
		messagebox("Service Date Validation", "Please enter date greater than or equal to Today's date.")
	case "tscode"
		messagebox("Service TimeSlot Validation", "Please select some TimeSlot from the dropdown")
	case "ddtscode"
		messagebox("Service TimeSlot Validation", "Please select some TimeSlot from the dropdown.")
	case "shiftcode"
		messagebox("Shift Validation", "Please select some Shift from the dropdown.")
	end choose
	return 1

// dw_itemsdetail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	return ::message.returnvalue

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_rowm
	long ll_servicecode
	date ld_date
	time lt_time
	datetime ldt_startdate
	datetime ldt_enddate
	s_serviceorder ls_serviceorder
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(99999)
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(1)
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf4! then
			parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			if parent.parent.parent.id_master.getitemstring(parent.parent.parent.id_master.getrow(), "Posted") = "N" or isnull(parent.parent.parent.id_master.getitemstring(parent.parent.parent.id_master.getrow(), "Posted")) then
				setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
			elseif parent.parent.parent.id_master.getitemstring(parent.parent.parent.id_master.getrow(), "Posted") = "Y" and isnull(parent.parent.parent.id_detail.getitemnumber(parent.parent.parent.id_detail.getrow(), "srvorowid")) then
				setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
			end if
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	elseif key = keydownarrow! then
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_focusfooter")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	end if
	if getcolumnname() = "date" and key = keyf5! then
		accepttext()
		ll_servicecode = getitemnumber(getrow(), "icode")
		ld_date = date(getitemdatetime(getrow(), "date"))
		lt_time = time("00:00:00")
		ldt_startdate = datetime(ld_date, lt_time)
		lt_time = time("23:59:59")
		ldt_enddate = datetime(ld_date, lt_time)
		ls_serviceorder.ll_code = ll_servicecode
		ls_serviceorder.ldt_startdate = ldt_startdate
		ls_serviceorder.ldt_enddate = ldt_enddate
		openwithparm(w_popup_bookingdetail, ls_serviceorder)
		rt_code = 1
	elseif getcolumnname() = "date" and key = keyf6! then
		accepttext()
		ld_date = date(getitemdatetime(getrow(), "date"))
		lt_time = time("00:00:00")
		ldt_startdate = datetime(ld_date, lt_time)
		lt_time = time("23:59:59")
		ldt_enddate = datetime(ld_date, lt_time)
		ls_serviceorder.ll_code = -1
		ls_serviceorder.ldt_startdate = ldt_startdate
		ls_serviceorder.ldt_enddate = ldt_enddate
		openwithparm(w_popup_bookingdetail, ls_serviceorder)
		rt_code = 1
	end if
	return rt_code

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ll_currrow
	long ll_startrow
	long ll_endrow
	if parent.parent.parent.editflag = false then
		parent.parent.parent.editflag = true
		parent.parent.parent.im_menu.m_file.m_save.enabled = true
	end if
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		if upper(left(data, 1)) >= "A" and upper(left(data, 1)) <= "Z" or left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
			ll_currrow = parent.parent.parent.id_itemslist.getrow()
			if len(data) > 1 then
				ll_startrow = ll_currrow
			else
				if left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
					ll_startrow = 1
				else
					ll_startrow = parent.parent.parent.ia_llookuptable[asc(upper(data))]
				end if
				parent.parent.parent.ib_bkspace = false
			end if
			if parent.parent.parent.ib_bkspace then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.find("Lower(itemname) <= '" + lower(data) + "'", ll_startrow, 0)
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.il_itemlistfoundrow + 1
				parent.parent.parent.ib_bkspace = false
			else
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.find("Lower(itemname) >= '" + lower(data) + "'", ll_startrow, 99999)
			end if
			if parent.parent.parent.il_itemlistfoundrow = 0 then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.rowcount()
			end if
			if parent.parent.parent.il_itemlistfoundrow <> ll_currrow then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.setrow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_itemslist.scrolltorow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_itemslist.selectrow(parent.parent.parent.il_itemlistfoundrow, true)
				ll_endrow = setitem(row, "currlistrow", parent.parent.parent.il_itemlistfoundrow)
				ll_endrow = getitemnumber(row, "currlistrow")
				setfocus()
			end if
		end if
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	end choose
	if getcolumn() = 1 then
		parent.parent.parent.is_aliasname = data
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	integer li_rowno
	integer i
	integer li_columnno = 1
	li_columnno = integer(this.object.qty.id)
	if getrow() = rowcount() then
		if getcolumn() = li_columnno then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
	elseif li_columnno = integer(this.object.datawindow.column.count) and getcolumn() = li_columnno then
		scrollnextrow()
		if f_stringpreferences("ItemCode") = "Y" then
			setcolumn("fullcode")
		else
			setcolumn("itemname")
		end if
		setfocus()
		return 1
	end if
	li_rowno = parent.parent.parent.id_itemslist.find("fullcode='" + parent.parent.parent.is_aliasname + "'", 1, parent.parent.parent.id_itemslist.rowcount())
	if getcolumn() = 1 and li_rowno > 0 and li_rowno <= parent.parent.parent.id_itemslist.rowcount() then
		if isnull(parent.parent.parent.is_aliasname) or parent.parent.parent.is_aliasname = "" then
			setcolumn("itemname")
		else
			setcolumn("qty")
		end if
		setfocus()
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_itemsdetail.getfocus() returns long [event]
	long ancestorreturnvalue
	if f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	return ::message.returnvalue

// dw_itemslist.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ll_rowmain
	if row > 0 then
		ll_rowmain = parent.parent.parent.id_detail.getrow()
		if parent.parent.parent.id_master.getitemstring(parent.parent.parent.id_master.getrow(), "Posted") = "N" or isnull(parent.parent.parent.id_master.getitemstring(parent.parent.parent.id_master.getrow(), "Posted")) then
			parent.parent.parent.id_detail.setitem(ll_rowmain, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(row, parent.parent.parent.is_columnitemname))
			parent.parent.parent.id_detail.setitem(ll_rowmain, "icode", parent.parent.parent.id_itemslist.getitemnumber(row, "icode"))
			parent.parent.parent.id_detail.setitem(ll_rowmain, "fullcode", parent.parent.parent.id_itemslist.getitemstring(row, "fullcode"))
		elseif parent.parent.parent.id_master.getitemstring(parent.parent.parent.id_master.getrow(), "Posted") = "Y" and isnull(parent.parent.parent.id_detail.getitemnumber(parent.parent.parent.id_detail.getrow(), "srvorowid")) then
			parent.parent.parent.id_detail.setitem(ll_rowmain, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(row, parent.parent.parent.is_columnitemname))
			parent.parent.parent.id_detail.setitem(ll_rowmain, "icode", parent.parent.parent.id_itemslist.getitemnumber(row, "icode"))
			parent.parent.parent.id_detail.setitem(ll_rowmain, "fullcode", parent.parent.parent.id_itemslist.getitemstring(row, "fullcode"))
		end if
		parent.parent.parent.id_detail.selecttext(1, len(gettext()))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = ll_rowmain
		selectrow(0, false)
		selectrow(row, true)
	end if
	return ::message.returnvalue
