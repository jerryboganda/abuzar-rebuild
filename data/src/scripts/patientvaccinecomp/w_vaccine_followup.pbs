	this.values.labeldispattr.format = "[General]"
	this.values.labeldispattr.displayexpression = "valuesaxislabel"
	this.values.labeldispattr.escapement = 900
	this.series.label = "(None)"
	this.series.autoscale = true
	this.series.secondaryline = transparent!
	this.series.majorgridline = transparent!
	this.series.minorgridline = transparent!
	this.series.droplines = transparent!
	this.series.originline = transparent!
	this.series.majortic = outside!
	this.series.datatype = adttext!
	this.series.dispattr.textsize = 13
	this.series.dispattr.facename = "Arial"
	this.series.dispattr.fontcharset = defaultcharset!
	this.series.dispattr.fontfamily = swiss!
	this.series.dispattr.fontpitch = variable!
	this.series.dispattr.backcolor = 536870912
	this.series.dispattr.format = "[General]"
	this.series.dispattr.displayexpression = "series"
	this.series.labeldispattr.textsize = 16
	this.series.labeldispattr.facename = "Arial"
	this.series.labeldispattr.fontcharset = defaultcharset!
	this.series.labeldispattr.fontfamily = swiss!
	this.series.labeldispattr.fontpitch = variable!
	this.series.labeldispattr.alignment = center!
	this.series.labeldispattr.backcolor = 536870912
	this.series.labeldispattr.format = "[General]"
	this.series.labeldispattr.displayexpression = "seriesaxislabel"
	this.legenddispattr.textsize = 13
	this.legenddispattr.facename = "Arial"
	this.legenddispattr.fontcharset = defaultcharset!
	this.legenddispattr.fontfamily = swiss!
	this.legenddispattr.fontpitch = variable!
	this.legenddispattr.backcolor = 536870912
	this.legenddispattr.format = "[General]"
	this.legenddispattr.displayexpression = "series"
	this.piedispattr.weight = 400
	this.piedispattr.facename = "Arial"
	this.piedispattr.fontcharset = defaultcharset!
	this.piedispattr.fontfamily = swiss!
	this.piedispattr.fontpitch = variable!
	this.piedispattr.backcolor = 536870912
	this.piedispattr.format = "[General]"
	this.piedispattr.displayexpression = "if(seriescount > 1, series,string(percentofseries,~"0.00%~"))"
	this.piedispattr.autosize = true

// gr_graph.destroy() returns 0
	destroy this.titledispattr
	destroy this.legenddispattr
	destroy this.piedispattr
	destroy this.series.dispattr
	destroy this.series.labeldispattr
	destroy this.series
	destroy this.category.dispattr
	destroy this.category.labeldispattr
	destroy this.category
	destroy this.values.dispattr
	destroy this.values.labeldispattr
	destroy this.values

// gr_graph.ue_rbuttonup(unsignedlong flags, integer xpos, integer ypos) returns long
	parent.parent.parent.tab_main.tabpage_graph.st_tooltip.visible = false
	return ::message.returnvalue

// gr_graph.clicked() returns long
	grobjecttype clickedobject
	string ls_cat
	integer li_series
	integer li_category
	clickedobject = objectatpointer(li_series, li_category)
	if clickedobject = typedata! or clickedobject = typecategory! then
		ls_cat = categoryname(li_category)
	end if
	return ::message.returnvalue

// gr_graph.rbuttondown(unsignedlong flags, integer xpos, integer ypos) returns long
	grobjecttype clickedobject
	integer li_series
	integer li_category
	long ll_counter
	clickedobject = objectatpointer(li_series, li_category)
	if clickedobject = typedata! then
		parent.st_tooltip.text = string(getdata(li_series, li_category), "###,###,##0")
		parent.st_tooltip.x = parent.pointerx()
		parent.st_tooltip.y = parent.pointery() - 65
		parent.parent.parent.tab_main.tabpage_graph.st_tooltip.visible = true
	end if
	return ::message.returnvalue
