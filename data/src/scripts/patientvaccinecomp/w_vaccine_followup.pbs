// cb_save.clicked() returns long
	long ll_code
	string ls_errtext
	if parent.parent.parent.id_vaccine.getrow() > 0 then
		if parent.parent.parent.id_vaccine.update(true) = 1 then
			messagebox("Vaccine Followup Recod", "Vaccine Followup Recod Successfully updated")
			SQL commit USING parent.parent.parent.it_transobject;
		else
			ls_errtext = "Vaccine Followup Recod Successfully updated.~r~nDetails are:-~r~n" + parent.parent.parent.it_transobject.sqlerrtext
			SQL rollback USING parent.parent.parent.it_transobject;
			messagebox("Vaccine Followup Recod", ls_errtext, stopsign!)
		end if
	end if
	return 0

// cb_sort_outbox.clicked() returns long
	string ls_null
	setnull(ls_null)
	parent.parent.parent.id_vaccine.setsort(ls_null)
	parent.parent.parent.id_vaccine.sort()
	parent.parent.parent.id_vaccine.groupcalc()
	return ::message.returnvalue

// cb_filter_outbox.clicked() returns long
	string ls_null
	setnull(ls_null)
	parent.parent.parent.id_vaccine.scrolltorow(0)
	parent.parent.parent.id_vaccine.setfilter(ls_null)
	parent.parent.parent.id_vaccine.filter()
	parent.parent.parent.id_vaccine.groupcalc()
	return ::message.returnvalue

// cb_retrieve_outbox.clicked() returns long
	parent.parent.parent.wf_retrieve()
	return ::message.returnvalue

// dw_vaccine.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_vaccine.rowfocuschanged(long currentrow) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if currentrow > 0 then
		selectrow(0, false)
		setrow(currentrow)
		scrolltorow(currentrow)
		selectrow(currentrow, true)
	end if
	return ::message.returnvalue

// dw_vaccine.editchanged(long row, dwobject dwo, string data) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	parent.parent.parent.ib_editflag = true
	return ::message.returnvalue

// dw_vaccine.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::doubleclicked(xpos, ypos, row, dwo)
	return ::message.returnvalue

// dw_vaccine.itemchanged(long row, dwobject dwo, string data) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "vaccinestatuscode"
		if long(data) = 3 then
			this.object.lastremindedon[row] = today()
			this.object.lastremindedby[row] = gl_usercode
		elseif long(data) = 2 then
			this.object.lastpendedon[row] = today()
			this.object.lastpendedby[row] = gl_usercode
		elseif long(data) = 1 then
			this.object.vaccinatedon[row] = today()
			this.object.vaccinatedby[row] = gl_usercode
		elseif long(data) = 5 then
			this.object.stoppedon[row] = today()
			this.object.stoppedby[row] = gl_usercode
		end if
	end choose
	return ::message.returnvalue

