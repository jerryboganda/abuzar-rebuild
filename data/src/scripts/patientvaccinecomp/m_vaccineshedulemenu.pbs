// m_vaccineshedulemenu.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_populatesaletemplate = create m_populatesaletemplate
	this.m_markasstopped = create m_markasstopped
	this.m_markasun-stoppedresumed = create m_markasun-stoppedresumed
	this.item[upperbound(this.item) + 1] = this.m_populatesaletemplate
	this.item[upperbound(this.item) + 1] = this.m_markasstopped
	this.item[upperbound(this.item) + 1] = this.m_markasun-stoppedresumed

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_populatesaletemplate
	destroy this.m_markasstopped
	destroy this.m_markasun-stoppedresumed

// m_file.clicked() returns 0 [event]
	call super::clicked

// m_populatesaletemplate.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_populate_saletemplate()

// m_populatesaletemplate.create() returns 0 [event]
	call super::create
	this.text = "Populate Sale Template~tF5"
