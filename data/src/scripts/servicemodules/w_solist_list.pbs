// w_solist_list.wf_show_soreceipt() returns long
	s_arguements lstr_arg
	long ll_code
	long ll_retcode = 1
	long ll_protect
	long ll_count
	long ll_receiptcode
	char lc_cancelled
	if this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
		lc_cancelled = this.id_list.object.cancelled[this.id_list.getrow()]
		if ll_code > 0 and lc_cancelled = "N" then
			SQL SELECT COUNT ( SOReceiptCode ) INTO :ll_count FROM SOReceipt WHERE ServiceOCode =:ll_code USING sqlca;
			if sqlca.sqlcode = 0 then
				if ll_count <= 0 or isnull(ll_count) then
					setnull(ll_receiptcode)
					lstr_arg.l_code1 = ll_receiptcode
					lstr_arg.l_code2 = ll_code
					lstr_arg.l_code3 = 0
					lstr_arg.l_code4 = this.id_list.object.acccode[this.id_list.getrow()]
					lstr_arg.l_code5 = this.id_list.object.patientcode[this.id_list.getrow()]
					lstr_arg.db_code1 = this.id_list.object.estamt[this.id_list.getrow()]
					lstr_arg.i_status = 1
					ll_protect = 0
				else
					lstr_arg.l_code2 = ll_code
					lstr_arg.l_code3 = 0
					lstr_arg.l_code4 = this.id_list.object.acccode[this.id_list.getrow()]
					lstr_arg.l_code5 = this.id_list.object.patientcode[this.id_list.getrow()]
					lstr_arg.db_code1 = this.id_list.object.estamt[this.id_list.getrow()]
					lstr_arg.i_status = 1
					openwithparm(w_soreceipt_history, lstr_arg)
					lstr_arg = message.powerobjectparm
					if lstr_arg.i_status = 1 then
						ll_receiptcode = lstr_arg.l_code1
						lstr_arg.l_code2 = ll_code
						ll_protect = lstr_arg.l_code3
						lstr_arg.l_code3 = ll_protect
						lstr_arg.l_code4 = this.id_list.object.acccode[this.id_list.getrow()]
						lstr_arg.l_code5 = this.id_list.object.patientcode[this.id_list.getrow()]
						lstr_arg.db_code1 = this.id_list.object.estamt[this.id_list.getrow()]
					end if
				end if
				lstr_arg.l_code1 = ll_receiptcode
				lstr_arg.l_code2 = ll_code
				lstr_arg.l_code3 = ll_protect
				lstr_arg.l_code4 = this.id_list.object.acccode[this.id_list.getrow()]
				lstr_arg.l_code5 = this.id_list.object.patientcode[this.id_list.getrow()]
				lstr_arg.db_code1 = this.id_list.object.estamt[this.id_list.getrow()]
				if lstr_arg.i_status = 1 then
					openwithparm(w_soreceipt_form, lstr_arg)
				end if
			else
				messagebox("Database Problem", "Some Database Problem while fetching purchase payment information~r~n" + sqlca.sqlerrtext, stopsign!)
				lstr_arg.i_status = 0
			end if
		end if
	end if
	return 0

// w_solist_list.wf_cancel_serviceorder() returns long
	long ll_code
	long ll_usercode
	char lc_posted
	string ls_err
	u_transaction it_mytransobject
	if this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
		lc_posted = this.id_list.object.posted[this.id_list.getrow()]
		if ll_code > 0 and lc_posted = "N" then
			open(w_salesmanpassword)
			ll_usercode = long(message.doubleparm)
			if ll_usercode > 0 then
				it_mytransobject = create u_transaction
				SQL start USING it_mytransobject;
				if it_mytransobject.sqlcode = 0 then
					it_mytransobject.cancelserviceoheader(ll_code, ll_usercode)
					if it_mytransobject.sqlcode = 0 then
						SQL commit USING it_mytransobject;
						messagebox("Service Header Cancellation", "Successfully Cancelled Service Order Code = " + trim(string(ll_code)), information!)
					else
						ls_err = it_mytransobject.sqlerrtext
						SQL rollback USING it_mytransobject;
						messagebox("Service Header Cancellation", "Problem in Cancellation of Service Order Code = " + trim(string(ll_code)) + "~r~nDetails are:-~r~n" + ls_err, information!)
					end if
				end if
			end if
		end if
	end if
	return 0

// w_solist_list.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_serviceorder_menu" then
		this.menuid = create m_serviceorder_menu
	end if
	this.dw_jobcard = create dw_jobcard
	this.dw_combineinvoice = create dw_combineinvoice
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_jobcard
	this.control[icurrent + 2] = this.dw_combineinvoice

// w_solist_list.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_jobcard
	destroy this.dw_combineinvoice

// w_solist_list.ue_new() returns 0 [event]
	long ll_code
	call super::ue_new
	setnull(ll_code)
	wf_openmywindow(ll_code)

// w_solist_list.ue_list() returns 0 [event]
	long ll_rtcode = 1
	call super::ue_list
	if this.id_list.rowcount() <= 0 then
		ll_rtcode = wf_retrieve()
	end if
	wf_populate_ddlb(this.id_list)
	if ll_rtcode > 0 then
		this.im_menu.m_file.m_new.enabled = true
		this.im_menu.m_file.m_save.enabled = false
		this.im_menu.m_file.m_delete.enabled = false
		this.im_menu.m_file.m_first.enabled = true
		this.im_menu.m_file.m_next.enabled = true
		this.im_menu.m_file.m_last.enabled = true
		this.im_menu.m_file.m_print.enabled = true
		this.im_menu.m_file.m_previous.enabled = true
		this.im_menu.m_file.m_retrieve.text = "De&tail"
		this.i_retrievemode = 2
		this.i_editmode = 2
		if this.il_selectedrow = 0 then
			wf_first()
			wf_selectunselectrow(1)
		end if
		this.tab_retrieve.tabpage_list.dw_find.setfocus()
		return
	end if

// w_solist_list.open() returns long [event]
	long ancestorreturnvalue
	m_serviceorder_menu lm_menu
	ancestorreturnvalue = super::open()
	lm_menu = this.menuid
	if f_rightexists(5201) then
		lm_menu.m_file.m_printjobcard.visible = true
		lm_menu.m_file.m_printjobcard.enabled = true
	end if
	if f_rightexists(5202) then
		lm_menu.m_file.m_printinvoice.visible = true
		lm_menu.m_file.m_printinvoice.enabled = true
	end if
	if f_rightexists(5203) then
		lm_menu.m_file.m_getreceipts.visible = true
		lm_menu.m_file.m_getreceipts.enabled = true
	end if
	if f_rightexists(5206) then
		lm_menu.m_file.m_cancelserviceorder.visible = true
		lm_menu.m_file.m_cancelserviceorder.enabled = true
	else
		lm_menu.m_file.m_cancelserviceorder.visible = false
		lm_menu.m_file.m_cancelserviceorder.enabled = false
		lm_menu.m_file.m_cancelserviceorder.toolbaritemvisible = false
	end if
	this.tab_retrieve.tabpage_list.rb_ascending.checked = true
	this.tab_retrieve.tabpage_list.rb_descending.triggerevent(clicked!)
	return ::message.returnvalue

// tabpage_list.create() returns 0 [event]
	integer icurrent
	this.cb_image = create cb_image
	call super::create
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cb_image

// tabpage_list.destroy() returns 0 [event]
	call super::destroy
	destroy this.cb_image

// dw_list.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	long ll_code
	ancestorreturnvalue = super::doubleclicked(xpos, ypos, row, dwo)
	if row > 0 then
		ll_code = this.object.code[row]
		if ll_code > 0 then
			parent.parent.parent.wf_openmywindow(ll_code)
		end if
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_find.keypressed(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	long ll_code
	long ll_found
	string ls_regno
	ancestorreturnvalue = super::keypressed(key, keyflags)
	if key = keyenter! and parent.parent.parent.id_list.getselectedrow(0) > 0 then
		ll_code = parent.parent.parent.id_list.object.code[parent.parent.parent.id_list.getselectedrow(0)]
		parent.parent.parent.wf_openmywindow(ll_code)
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// cb_image.clicked() returns long [event]
	parent.parent.parent.wf_upload_image()
	return ::message.returnvalue
