// window w_solist_list (servicemodules)  ancestor: w_listview_form

// w_solist_list.wf_openmywindow(long al_code) returns 0
	s_datatype lstr_datatype
	long ll_code
	long ll_retcode = 1
	long ll_protect
	if this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 and al_code > 0 then
		ll_code = al_code
		if this.id_list.object.posted[this.id_list.getrow()] = "Y" then
			ll_protect = 1
		end if
	else
		setnull(ll_code)
	end if
	lstr_datatype.al_long = ll_code
	lstr_datatype.ai_int = ll_protect
	openwithparm(w_serviceorder_form, lstr_datatype)

// w_solist_list.wf_setprintout() returns long
	this.id_print.dataobject = "d_serviceorder_issuereq_printout"
	return 0

// w_solist_list.wf_new_patientregistration() returns string
	string ls_regno
	long ll_patientcode
	long ll_found
	long ll_row
	dwobject dwo
	if f_rightexists(5102) then
		open(w_patientregistration)
		ls_regno = message.stringparm
		if not (ls_regno = "" or isnull(ls_regno)) then
			this.id_list.setredraw(false)
			this.id_list.retrieve()
			this.id_list.setredraw(true)
		end if
	end if
	return ls_regno

// w_solist_list.wf_upload_image() returns long
	long ll_patientcode
	long ll_admissioncode
	long ll_rowid
	long ll_null
	string ls_imagedesc
	s_item_blob lstr_blob
	u_transaction lt_transobject
	if this.id_list.getrow() > 0 then
		ls_imagedesc = "ECG-" + string(today(), "dd/mm/yyyy hh:mm:ss")
		setnull(ll_null)
		ll_patientcode = this.id_list.object.code[this.id_list.getrow()]
		ll_admissioncode = this.id_list.object.admissioncode[this.id_list.getrow()]
		if ll_patientcode > 0 then
			setnull(lstr_blob.lb_blob)
			lstr_blob.s_name = "jpg"
			openwithparm(w_patientimage_rowid, lstr_blob)
			lstr_blob = message.powerobjectparm
			if lstr_blob.i_closemode = 1 then
				lt_transobject = create u_transaction
				lt_transobject.autocommit = true
				SQL start USING lt_transobject;
				if lt_transobject.sqlcode <> 0 then
					messagebox("Connection Error", "Unable to connect to DataBase server for updating/inserting in PatientImage Table")
					SQL stop USING lt_transobject;
					destroy lt_transobject
					return -1
				end if
				SQL SELECT MAX ( RowID ) INTO :ll_rowid FROM PatientImage WHERE PatientCode =:ll_patientcode USING lt_transobject;
				if lt_transobject.sqlcode = 0 then
					if ll_rowid = 0 or isnull(ll_rowid) then
						ll_rowid = 0
					end if
					ll_rowid = ll_rowid + 1
					SQL INSERT INTO PatientImage ( PatientCode , ImageDescription , RowID , ImageType , AdmissionCode , VisitCode ) VALUES ( :ll_patientcode , :ls_imagedesc , :ll_rowid , :lstr_blob.s_name , :ll_admissioncode , :ll_null ) USING lt_transobject;
					if lt_transobject.sqlcode = 0 then
						SQL UpdateBlob PatientImage Set PatientImage =:lstr_blob.lb_blob Where Patientcode =:ll_patientcode and ROWID =:ll_rowid USING lt_transobject;
						if lt_transobject.sqlcode <> 0 then
							messagebox("Patient Image ", "Unable to update Patient image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
							SQL stop USING lt_transobject;
							destroy lt_transobject
							return -1
						end if
					else
						messagebox("Insert Error", "Unable to Insert Patient Images Into Patient Image Table.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
						SQL stop USING lt_transobject;
						destroy lt_transobject
						return -1
					end if
				else
					messagebox("error", lt_transobject.sqlerrtext)
				end if
			end if
		end if
	end if
	return 0

// w_solist_list.wf_post() returns long
	long ll_code
	long ll_usercode
	double ld_advance
	char lc_cancelled
	string ls_err
	datetime ldt_server_datetime
	u_transaction it_mytransobject
	if this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
		ld_advance = this.id_list.object.advance[this.id_list.getrow()]
		lc_cancelled = this.id_list.object.cancelled[this.id_list.getrow()]
		if ll_code > 0 and lc_cancelled = "N" then
			open(w_salesmanpassword)
			ll_usercode = long(message.doubleparm)
			if ll_usercode > 0 then
				it_mytransobject = create u_transaction
				SQL start USING it_mytransobject;
				if it_mytransobject.sqlcode = 0 then
					SQL SELECT Date =GETDATE ( ) INTO :ldt_server_datetime FROM ( SELECT A =1 ) AS T USING it_mytransobject;
					if it_mytransobject.sqlcode = 0 then
						if ld_advance > 0.0 then
							if wf_generatecashreceipt(ldt_server_datetime, ll_code, ll_code, ll_usercode) = -1 then
								ls_err = sqlca.sqlerrtext
								messagebox("Service Order Posting", "Problem in Generating Cash Receipt Voucher. Service Order Code = " + trim(string(ll_code)) + "~r~nDetails are:-~r~n" + ls_err, information!)
								SQL rollback USING sqlca;
								setfocus()
								setpointer(arrow!)
								return -1
							else
								SQL commit USING sqlca;
							end if
						end if
					else
						ls_err = it_mytransobject.sqlerrtext
						SQL rollback USING it_mytransobject;
						messagebox("Service Order Posting", "Problem in Fetching Server Date. Service Order Code = " + trim(string(ll_code)) + "~r~nDetails are:-~r~n" + ls_err, information!)
					end if
					it_mytransobject.postserviceorder_service_sale(ll_code, ll_usercode)
					if it_mytransobject.sqlcode = 0 then
						SQL commit USING it_mytransobject;
						messagebox("Service Header Posting", "Successfully Posted Service Order Code = " + trim(string(ll_code)), information!)
					else
						ls_err = it_mytransobject.sqlerrtext
						SQL rollback USING it_mytransobject;
						messagebox("Service Header Posting", "Problem isn Posting Service Order Code = " + trim(string(ll_code)) + "~r~nDetails are:-~r~n" + ls_err, information!)
					end if
				end if
			end if
		end if
	end if
	return 0

// w_solist_list.wf_generatecashreceipt(datetime adt_server_datetime, long al_startinginvoice, long al_endinginvoice, integer ai_salesmancode) returns long
	long ll_counter
	long ll_custcode
	integer li_servicepoststatus
	double ld_invadvance
	double ld_totaladvance
	double ld_servicesadvance
	long ll_vochcode
	long ll_glvochcode
	long ll_null
	long ll_cashacc
	long ll_modifiedby
	long ll_postedby
	long ll_patientcode
	long ll_admissioncode
	string ls_null
	string ls_remarks
	string ls_posted = "Y"
	long ll_vouchercatcode = 2
	datetime ldt_datetime
	double ld_zerovalue
	setnull(ll_null)
	setnull(ll_modifiedby)
	setnull(ls_null)
	setnull(ll_patientcode)
	setnull(ll_admissioncode)
	ll_postedby = ai_salesmancode
	ldt_datetime = adt_server_datetime
	sqlca.getglobalcode("GT_CashAcc", ll_cashacc)
	if sqlca.sqlcode <> 0 then
		messagebox("Auto CashReceipt Generation Error", "Unable to find Cash Account while generating auto cash receipt.")
		return -1
	end if
	for ll_counter = al_startinginvoice to al_endinginvoice
		SQL Select custcode , cashreceived , patientcode , CASE WHEN admissioncode IS NULL THEN NULL ELSE ( SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode =ServiceOHeader.Admissioncode ) END INTO :ll_custcode, :ld_invadvance, :ll_patientcode, :ll_admissioncode From ServiceOHeader Where Posted ='N' AND ServiceOCode =:ll_counter USING sqlca;
		if not isnull(ll_admissioncode) then
			ll_patientcode = ll_admissioncode
		end if
		if sqlca.sqlcode = 0 then
			SQL Select Sum ( cashreceived ) INTO :ld_servicesadvance From ServiceODetail Where ServiceOcode =:ll_counter USING sqlca;
			if sqlca.sqlcode = 0 then
				ld_totaladvance = ld_invadvance + ld_servicesadvance
				if ld_totaladvance > 0.0 then
					sqlca.getglobalcode("GT_CashAcc", ll_cashacc)
					if this.it_transobject.sqlcode <> 0 then
						messagebox("Auto CashReceipt Generation Error", "Unable to find Cash Account while generating auto cash receipt.")
						return -1
					end if
					ls_remarks = "Cash Receipt on Service Order#: " + string(ll_counter)
					sqlca.createvoucher(ll_vouchercatcode, ll_cashacc, ldt_datetime, ai_salesmancode, "Y", ldt_datetime, ls_remarks, ldt_datetime, ll_modifiedby, ll_postedby, ls_null, ll_cashacc, ll_custcode, ld_totaladvance, ls_null, ls_remarks, ll_patientcode, ll_null, ll_null, ll_null, ld_zerovalue, ld_zerovalue, ll_glvochcode, ll_vochcode, ll_null)
					if this.it_transobject.sqlcode <> 0 then
						messagebox("Auto CashReceipt Generation Error", "Reasons are:~r~n" + this.it_transobject.sqlerrtext)
						return -1
					end if
					return
				end if
			else
				messagebox("Auto CashReceipt Generation Error", "Error in fetching ServiceOrder detail rows for calculating Services advance.")
				return -1
			end if
		elseif sqlca.sqlcode <> 100 then
			messagebox("Auto CashReceipt Generation Error", "Error in fetching ServiceOrder Header posting information.")
			return -1
		end if
	next
	return 0

// w_solist_list.wf_set_jobcard() returns 0
	string ls_reports
	ls_reports = "d_serviceorder_jobcard"
	this.dw_jobcard.dataobject = ls_reports
	this.dw_jobcard.settransobject(sqlca)

// w_solist_list.wf_print_jobcard() returns 0
	long ll_code
	boolean lb_listtab
	s_datastore lstr
	if this.tab_retrieve.selectedtab = 1 then
		lb_listtab = true
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_code) or ll_code <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
		wf_set_jobcard()
		this.dw_jobcard.settransobject(this.it_transobject)
		this.dw_jobcard.retrieve(ll_code)
		lstr.dw = this.dw_jobcard
		lstr.s_name1 = this.dw_jobcard.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		else
			if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
				messagebox("Printer", "Printing Error")
				this.dw_jobcard.printcancel()
			end if
			if this.dw_jobcard.rowcount() > 0 then
				if this.dw_jobcard.print() < 0 then
					messagebox("Printing", "Can not Print Invoice", information!)
				end if
			else
				messagebox("Printing Error", "Can not Print Data,~r~nNo rows are retrieved", information!)
			end if
		end if
	end if

// w_solist_list.wf_set_combinedprint() returns long
	this.id_print.dataobject = "d_serviceorder_combinedinvoice"
	return 0

