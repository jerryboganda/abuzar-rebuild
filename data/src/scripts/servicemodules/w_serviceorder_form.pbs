// w_serviceorder_form.wf_connect() returns long
	SQL start USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_serviceorder_form.wf_tabnewid(string as_tablename, long al_newid) returns long
	long ll_rtcode
	SQL SELECT TABMAXKEY INTO :al_newid FROM _TABMAXKEY WITH ( UPDLOCK HOLDLOCK ) WHERE _TABMAXKEY.TABName =:as_tablename USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_newid = al_newid + 1
		SQL update dbo._tabmaxkey SET TABMAXKEY =:al_newid WHERE _TABMAXKEY.TABName =:as_tablename USING this.it_transobject;
		if this.it_transobject.sqlcode < 0 then
			ll_rtcode = this.it_transobject.sqlcode
			al_newid = 0
		end if
	else
		ll_rtcode = this.it_transobject.sqlcode
		al_newid = 0
	end if
	return ll_rtcode

// w_serviceorder_form.wf_get_patient_info(long al_code) returns long
	long ll_patientcode
	long ll_admissioncode
	string ls_regno
	string ls_patientname
	string ls_fname
	string ls_age
	string ls_gender
	SQL SELECT PatientCode , RegNo , Name , FName , Age =LTRIM ( RTRIM ( STR ( AgeYears ) ) ) + ' yrs ' + LTRIM ( RTRIM ( STR ( AgeMonths ) ) ) + ' month ' + LTRIM ( RTRIM ( STR ( AgeDays ) ) ) + ' days' , Gender INTO :ll_patientcode, :ls_regno, :ls_patientname, :ls_fname, :ls_age, :ls_gender FROM Patient WHERE PatientCode =:al_code USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.il_code = ll_patientcode
		this.is_regno = ls_regno
		this.is_patientname = ls_patientname
		this.is_fhname = ls_fname
		this.is_age = ls_age
		this.is_gender = ls_gender
		return 0
	end if
	return -1

// w_serviceorder_form.wf_retrieve_tabs() returns long
	long ll_retcode
	this.tab_main.tabpage_header.dw_header.settransobject(this.it_transobject)
	this.id_image = create datawindow
	this.id_svcheader = create datawindow
	this.id_svcdetail = create datawindow
	this.id_svcfooter = create datawindow
	this.id_issue = create datawindow
	this.id_service = create datawindow
	this.id_sale = create datawindow
	this.id_itemreq = create datawindow
	this.id_selectionlist = create datawindow
	this.id_selectionlist_req = create datawindow
	this.id_checklist = create datawindow
	this.id_image = this.dw_image
	this.id_image.settransobject(this.it_transobject)
	if this.il_code > 0 then
		ll_retcode = this.id_image.retrieve(this.il_code)
		wf_populate_image()
	end if
	this.dw_netamt.settransobject(this.it_transobject)
	ll_retcode = this.dw_netamt.retrieve()
	if this.dw_netamt.rowcount() <= 0 then
		this.dw_netamt.insertrow(0)
	end if
	this.id_svcheader = this.tab_main.tabpage_header.dw_header
	this.id_svcheader.settransobject(this.it_transobject)
	if this.il_code > 0 then
		ll_retcode = this.id_svcheader.retrieve(this.il_code)
	end if
	this.id_svcfooter = this.tab_main.tabpage_detail.dw_footer
	this.id_svcfooter.settransobject(this.it_transobject)
	if this.il_code > 0 then
		ll_retcode = this.id_svcfooter.retrieve(this.il_code)
	else
		this.id_svcfooter.insertrow(0)
	end if
	this.id_checklist = this.tab_main.tabpage_checklist.dw_checklist
	this.id_checklist.settransobject(this.it_transobject)
	if this.il_code > 0 then
		ll_retcode = this.id_checklist.retrieve(this.il_code)
	end if
	this.id_svcdetail = this.tab_main.tabpage_detail.dw_detail
	this.id_svcdetail.settransobject(this.it_transobject)
	if this.il_code > 0 then
		ll_retcode = this.id_svcdetail.retrieve(this.il_code)
	end if
	this.id_selectionlist = this.tab_main.tabpage_detail.dw_selectionlist
	this.id_selectionlist.settransobject(this.it_transobject)
	wf_servicelist_initialization()
	this.ids_itemreq_header = create u_ds_standard
	this.ids_itemreq_header.dataobject = "d_issuereqheader_serviceorder"
	this.ids_itemreq_header.settransobject(this.it_transobject)
	if this.il_code > 0 then
		ll_retcode = this.ids_itemreq_header.retrieve(this.il_code)
	end if
	this.id_itemreq = this.tab_main.tabpage_itemreq.dw_itemreq
	this.id_itemreq.settransobject(this.it_transobject)
	if this.il_code > 0 then
		ll_retcode = this.id_itemreq.retrieve(this.il_code)
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_itemreq.object.fullcode.visible = false
	end if
	this.id_selectionlist_req = this.tab_main.tabpage_itemreq.dw_selection_req
	this.id_selectionlist_req.settransobject(this.it_transobject)
	gd_popup_itemsinfo.sharedata(this.id_selectionlist_req)
	wf_itemlist_initialization()
	this.id_issue = this.tab_main.tabpage_issue.dw_issue
	this.id_issue.settransobject(this.it_transobject)
	if this.il_code > 0 then
		ll_retcode = this.id_issue.retrieve(this.il_code)
	end if
	this.id_service = this.tab_main.tabpage_service.dw_service
	this.id_service.settransobject(this.it_transobject)
	if this.il_code > 0 then
		ll_retcode = this.id_service.retrieve(this.il_code)
	end if
	this.id_sale = this.tab_main.tabpage_sale.dw_sale
	this.id_sale.settransobject(this.it_transobject)
	if this.il_code > 0 then
		ll_retcode = this.id_sale.retrieve(this.il_code)
	end if
	return 0

// w_serviceorder_form.wf_insert_row(datawindow adw_dw, integer ai_askpermit) returns long
	long ll_row
	long ll_res
	if ai_askpermit = 1 then
		ll_res = messagebox("Insert New Record", "Do you want to Insert New Record?", question!, yesnocancel!, 2)
	else
		ll_res = 1
	end if
	if ll_res = 1 then
		ll_row = adw_dw.insertrow(0)
		adw_dw.setrow(ll_row)
		adw_dw.scrolltorow(ll_row)
	end if
	return 0

// w_serviceorder_form.wf_delete_row(datawindow adw_dw, integer ai_askpermit) returns long
	long ll_row
	long ll_res
	if adw_dw.rowcount() > 0 and adw_dw.getrow() > 0 then
		if ai_askpermit = 1 then
			ll_res = messagebox("Delete Record", "Do you want to delete this record?", question!, yesnocancel!, 2)
		else
			ll_res = 1
		end if
		if ll_res = 1 then
			ll_row = adw_dw.getrow()
			if adw_dw.deleterow(ll_row) = 1 and adw_dw.rowcount() > 0 then
				adw_dw.setrow(1)
				adw_dw.scrolltorow(1)
			end if
		end if
	end if
	return 0

// w_serviceorder_form.wf_goto_record(datawindow adw_dw) returns long
	long ll_current
	long ll_counter
	long ll_row
	datastore lds_ds
	s_arguements lstr_arg
	ll_current = adw_dw.getrow()
	if adw_dw.rowcount() > 0 then
		lds_ds = create datastore
		lds_ds.dataobject = "d_mr_recordpointer"
		lds_ds.settransobject(sqlca)
		for ll_counter = 1 to adw_dw.rowcount()
			ll_row = lds_ds.insertrow(0)
			if ll_row = ll_current then
				lds_ds.object.currentrow[ll_row] = 1
			else
				lds_ds.object.currentrow[ll_row] = 0
			end if
			lds_ds.object.rowid[ll_row] = adw_dw.object.rowid[ll_counter]
			lds_ds.object.rowno[ll_row] = ll_counter
			lds_ds.object.date[ll_row] = adw_dw.object.date[ll_counter]
		next
		if lds_ds.rowcount() > 0 then
			openwithparm(w_arg_mr_record_pointer, lds_ds)
			lstr_arg = message.powerobjectparm
			if lstr_arg.i_status = 1 and lstr_arg.l_code1 > 0 then
				adw_dw.setrow(lstr_arg.l_code1)
				adw_dw.scrolltorow(lstr_arg.l_code1)
			end if
		end if
	end if
	return 0

// w_serviceorder_form.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns integer
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next
	return 0

// w_serviceorder_form.wf_apply_protect_setting() returns integer
	if this.il_protect = 1 then
		wf_protectdw(this.id_svcheader, this.il_protect)
		wf_protectdw(this.id_checklist, this.il_protect)
		wf_protectdw(this.id_svcdetail, this.il_protect)
		wf_protectdw(this.id_svcfooter, this.il_protect)
		wf_protectdw(this.id_itemreq, this.il_protect)
		wf_protectdw(this.id_issue, this.il_protect)
		wf_protectdw(this.id_service, this.il_protect)
		wf_protectdw(this.id_sale, this.il_protect)
		this.cb_ok.enabled = false
	end if
	return 0

// w_serviceorder_form.wf_save() returns long
	if this.il_protect = 0 then
		this.cb_ok.triggerevent(clicked!)
	end if
	return 0

// w_serviceorder_form.wf_print() returns long
	if this.il_protect = 0 then
		wf_save()
	end if
	return 0

// w_serviceorder_form.wf_select_first_tab() returns long
	if this.tab_main.tabpage_header.visible then
		this.tab_main.selecttab(1)
		return 0
	end if
	if this.tab_main.tabpage_checklist.visible = true then
		this.tab_main.selecttab(2)
		return 0
	end if
	if this.tab_main.tabpage_detail.visible = true then
		this.tab_main.selecttab(3)
		return 0
	end if
	if this.tab_main.tabpage_itemreq.visible = true then
		this.tab_main.selecttab(4)
		return 0
	end if
	if this.tab_main.tabpage_issue.visible = true then
		this.tab_main.selecttab(5)
		return 0
	end if
	if this.tab_main.tabpage_service.visible = true then
		this.tab_main.selecttab(6)
		return 0
	end if
	if this.tab_main.tabpage_sale.visible = true then
		this.tab_main.selecttab(7)
		return 0
	end if
	return 0

// w_serviceorder_form.wf_get_image(long al_row) returns long
	blob lbl_image
	u_transaction lt_transobject
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server")
		destroy lt_transobject
		return -1
	end if
	SQL SelectBlob PatientImage INTO :lbl_image From PatientImage Where Patientcode =:this.il_code AND RowID =:al_row USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Patient Image/Picture ", "Unable to fetch patient Image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	this.istr_image.blob[al_row] = lbl_image
	return 0

// w_serviceorder_form.wf_populate_image() returns long
	long ll_counter
	long ll_rowcount
	long ll_code
	ll_rowcount = this.id_image.rowcount()
	if ll_rowcount <= 0 then
		return 0
	end if
	ll_code = this.id_image.object.code[1]
	for ll_counter = 1 to ll_rowcount
		this.istr_image.ls_value[ll_counter, 1] = trim(string(this.id_image.object.rowid[ll_counter]))
		this.istr_image.ls_value[ll_counter, 2] = this.id_image.object.imagedescription[ll_counter]
		this.istr_image.ls_value[ll_counter, 3] = this.id_image.object.imagetype[ll_counter]
		wf_get_image(ll_counter)
	next
	return 0

// w_serviceorder_form.wf_update_image() returns long
	long ll_counter
	long ll_code
	long ll_rowid
	string ls_desc
	string ls_imgtype
	u_transaction lt_transobject
	ll_code = this.il_code
	if ll_code > 0 and this.id_image.rowcount() = 0 then
		return 0
	end if
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server for updating/inserting in PatientImage Table")
		destroy lt_transobject
		return -1
	end if
	SQL DELETE PatientImage WHERE PatientCode =:this.il_code USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to Delete Previous Patient Image Record from database")
		destroy lt_transobject
		return -1
	end if
	for ll_counter = 1 to this.id_image.rowcount()
		ll_rowid = this.id_image.object.rowid[ll_counter]
		ls_desc = this.id_image.object.imagedescription[ll_counter]
		ls_imgtype = this.id_image.object.imagetype[ll_counter]
		if lt_transobject.sqlcode <> 0 then
			messagebox("Insert Error", "Unable to Insert Patient Images Into Patient Image Table.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
			SQL stop USING lt_transobject;
			destroy lt_transobject
			return -1
		end if
		SQL UpdateBlob PatientImage Set PatientImage =:this.istr_image.blob[ll_counter] Where Patientcode =:ll_code and ROWID =:ll_rowid USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Patient Image ", "Unable to update Patient image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		end if
	next
	SQL stop USING lt_transobject;
	destroy lt_transobject
	return 0

// w_serviceorder_form.wf_validateitem(long al_row) returns integer
	long ll_icode
	long ll_null
	integer li_errcode
	string ls_errortext
	setnull(ll_null)
	ll_icode = this.id_svcdetail.getitemnumber(al_row, "icode")
	if isnull(ll_icode) then
		this.ib_rowvalidated = false
		this.ib_itemvalidated = false
		messagebox("Validation Error!", "Please Enter Valid Item")
		li_errcode = -1
	elseif wf_inititeminfo(ll_icode, al_row, li_errcode, ls_errortext) then
		li_errcode = 0
		this.ib_rowvalidated = true
		this.ib_itemvalidated = true
	else
		li_errcode = -1
	end if
	if li_errcode = -1 then
		this.id_svcdetail.setcolumn("icode")
		this.id_svcdetail.scrolltorow(al_row)
		this.id_svcdetail.object.icode[al_row] = ll_null
	end if
	return li_errcode

// w_serviceorder_form.wf_setimage(string as_caller) returns long
	long ll_counter
	long ll_code
	long ll_row
	s_itemimage lstr_image
	lstr_image.s_caller = as_caller
	for ll_counter = 1 to this.id_image.rowcount()
		lstr_image.ls_value[ll_counter, 1] = trim(string(this.id_image.object.rowid[ll_counter]))
		lstr_image.ls_value[ll_counter, 2] = this.id_image.object.imagedescription[ll_counter]
		lstr_image.ls_value[ll_counter, 3] = this.id_image.object.imagetype[ll_counter]
		lstr_image.blob[ll_counter] = this.istr_image.blob[ll_counter]
	next
	openwithparm(w_patientimage, lstr_image)
	lstr_image = message.powerobjectparm
	if lstr_image.i_closemode = 1 then
		this.istr_image = lstr_image
		this.id_image.reset()
		ll_code = this.il_code
		for ll_counter = 1 to 200
			if long(lstr_image.ls_value[ll_counter, 1]) > 0 then
				ll_row = this.id_image.insertrow(0)
				this.id_image.object.code[ll_row] = ll_code
				this.id_image.object.rowid[ll_row] = long(lstr_image.ls_value[ll_counter, 1])
				this.id_image.object.imagedescription[ll_row] = lstr_image.ls_value[ll_counter, 2]
				this.id_image.object.imagetype[ll_row] = lstr_image.ls_value[ll_counter, 3]
			end if
		next
	end if
	return 0

// w_serviceorder_form.wf_show_patient_gallery() returns long
	if this.il_code > 0 then
		openwithparm(w_patientgallary, this.il_code)
	end if
	return 0

// w_serviceorder_form.wf_validateserverdatetime(datetime ar_server_datetime, string ar_errtext) returns boolean
	datetime ldt_last_transdate
	datetime ldt_current_serverdate
	long li_max_allow_days
	ar_errtext = "Invoice Date  Check violates"
	li_max_allow_days = f_numberpreferences("MaxAllowDate")
	if isnull(li_max_allow_days) then
		li_max_allow_days = 4
	end if
	SQL SELECT LastTransDate INTO :ldt_last_transdate FROM ServerDate USING sqlca;
	if sqlca.sqlcode = 0 then
		sqlca.getdatetime(ldt_current_serverdate)
		if sqlca.sqlcode = 0 then
			if ldt_current_serverdate >= ldt_last_transdate and daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) <= li_max_allow_days then
				ar_server_datetime = ldt_current_serverdate
				return true
			elseif ldt_current_serverdate < ldt_last_transdate then
				ar_errtext = "Back Date Invoice Check violates"
				return false
			elseif daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) > li_max_allow_days then
				ar_errtext = "Forward Date Invoice Check violates"
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_serviceorder_form.wf_print_dischargeslip() returns integer
	return 0

// w_serviceorder_form.wf_validate_service() returns long
	long ll_currrow
	long ll_counter
	long ll_null
	ll_currrow = this.id_svcdetail.getrow()
	setnull(ll_null)
	if this.id_svcdetail.rowcount() > 0 then
		if isnull(this.id_svcdetail.getitemnumber(ll_currrow, "icode")) then
			if isnull(this.id_svcdetail.getitemstring(ll_currrow, "itemname")) then
				this.id_svcdetail.deleterow(ll_currrow)
			elseif this.ib_itemvalidated = false then
				messagebox("Item Validation", "Please Select Some Valid Item")
				this.id_svcdetail.setcolumn("itemname")
				this.id_svcdetail.scrolltorow(ll_currrow)
				this.id_svcdetail.setfocus()
				return 1
			end if
		elseif this.ib_itemvalidated = false then
			messagebox("Item Validation", "Please Select Some Valid Item")
			this.id_svcdetail.setcolumn("itemname")
			this.id_svcdetail.scrolltorow(ll_currrow)
			this.id_svcdetail.setfocus()
			return 1
		end if
		if f_validatedw(this.id_svcdetail) < 0 then
			return 1
		end if
		this.il_currrow = this.id_svcdetail.rowcount()
		if this.ib_itemvalidated = false and wf_validateitem(ll_currrow) = -1 then
			return 1
		end if
		return
	end if
	for ll_counter = 1 to this.id_svcdetail.rowcount()
		this.id_svcdetail.object.code[ll_counter] = this.il_code
	next
	return 0

// w_serviceorder_form.wf_findcustcode(long ai_custcode, string as_aliasname) returns long
