// w_serviceorder_form.wf_new_patientregistration() returns long
	string ls_regno
	long ll_patientcode
	long ll_found
	long ll_row
	dwobject dwo
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 689", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		open(w_patientregistration)
		ls_regno = message.stringparm
		if not (ls_regno = "" or isnull(ls_regno)) then
			wf_patient_retrieve()
			ll_found = 0
			ll_found = this.idc_patient.find("regno = '" + ls_regno + "'", 1, this.idc_patient.rowcount())
			if ll_found > 0 then
				this.id_svcheader.setitem(1, "patientregno", this.idc_patient.getitemstring(ll_found, "regno"))
				ll_patientcode = this.idc_patient.getitemnumber(ll_found, "patientcode")
				this.id_svcheader.setitem(1, "patientcode", ll_patientcode)
				dwo = this.id_svcheader.object.patientcode
				this.id_svcheader.post event itemchanged(1, dwo, string(ll_patientcode))
			end if
		end if
	end if
	return 0

// w_serviceorder_form.wf_patient_retrieve() returns long
	long ll_prow
	long ll_pcode
	this.idc_patient.retrieve(this.ii_patientmodule)
	ll_prow = this.idc_patient.insertrow(0)
	setnull(ll_pcode)
	this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
	this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
	this.idc_patient.setitem(ll_prow, "name", "<NONE>")
	this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
	this.idc_patient.setitem(ll_prow, "city", "<NONE>")
	this.idc_patient.scrolltorow(ll_prow)
	return 0

// w_serviceorder_form.wf_comprehensive_search() returns long
	s_popup_selection lstr_selection
	openwithparm(w_popup_comprehensicesearch_selection, this.is_comprehensive_search_dataobject)
	lstr_selection = message.powerobjectparm
	if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
	end if
	if lstr_selection.l_code2 < 0 then
		lstr_selection.l_code2 = -1
	end if
	return lstr_selection.l_code2

// w_serviceorder_form.wf_setpatientinfo(long al_patientcode) returns long
	long ll_doctcode
	long ll_custcode
	long ll_retcode
	string ls_regno
	string ls_aliasname
	SQL SELECT Patient.RegNo , Patient.doctcode , Patient.CustCode , Accounts.AliasName INTO :ls_regno, :ll_doctcode, :ll_custcode, :ls_aliasname FROM Patient , Accounts WHERE Patient.PatientCode =:al_patientcode AND Patient.Active ='Y' AND Patient.CustCode =Accounts.AccCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_svcheader.setitem(this.id_svcheader.rowcount(), "patientregno", ls_regno)
		this.id_svcheader.setitem(this.id_svcheader.rowcount(), "doctcode", ll_doctcode)
		this.id_svcheader.setitem(this.id_svcheader.rowcount(), "patientregno", ls_regno)
		this.id_svcheader.setitem(this.id_svcheader.rowcount(), "custcode", ll_custcode)
		this.id_svcheader.setitem(this.id_svcheader.rowcount(), "aliasname", ls_aliasname)
		this.id_svcheader.object.custcode.protect = 1
		this.id_svcheader.object.aliasname.protect = 1
		ll_retcode = 1
	else
		messagebox("Patient Information", "Problem in retrieving corresponding customer")
		ll_retcode = 0
	end if
	return ll_retcode

// w_serviceorder_form.wf_show_patientgallery() returns long
	long ll_code
	if this.id_svcheader.rowcount() > 0 and this.id_svcheader.getrow() > 0 then
		ll_code = this.id_svcheader.object.patientcode[this.id_svcheader.getrow()]
		if ll_code > 0 then
			f_show_patient_gallary(ll_code)
		end if
	end if
	return 0

// w_serviceorder_form.wf_servicelist_initialization() returns 0
	long li_counter
	long ll_startrow
	long ll_rowcount
	long ll_found
	char lc_char
	this.id_selectionlist.retrieve()
	ll_rowcount = this.id_selectionlist.rowcount()
	if ll_rowcount <= 0 or isnull(ll_rowcount) then
		messagebox("Row Validation", "There are no rows to select in SelectionList.~r~nKindly try again.")
		close(this)
		return
	end if
	setredraw(false)
	this.id_selectionlist.setsort("name A")
	this.id_selectionlist.sort()
	for li_counter = 65 to 90
		lc_char = char(li_counter)
		this.ia_llookuptable[li_counter] = this.id_selectionlist.find("Lower(itemname) >= Lower('" + char(li_counter) + "')", ll_startrow, 99999)
		ll_startrow = this.ia_llookuptable[li_counter]
	next
	this.ia_llookuptable[92] = 99999
	f_setserviceqtystyle(this.id_svcdetail, "qty")
	setredraw(true)

// w_serviceorder_form.wf_itemlist_initialization() returns 0
	long li_counter
	long ll_startrow
	long ll_rowcount
	long ll_found
	char lc_char
	this.id_selectionlist_req.retrieve()
	ll_rowcount = this.id_selectionlist_req.rowcount()
	if ll_rowcount <= 0 or isnull(ll_rowcount) then
		messagebox("Row Validation", "There are no rows to select in SelectionList.~r~nKindly try again.")
		close(this)
		return
	end if
	setredraw(false)
	this.id_selectionlist_req.setsort("name A")
	this.id_selectionlist_req.sort()
	for li_counter = 65 to 90
		lc_char = char(li_counter)
		this.ia_llookuptable_req[li_counter] = this.id_selectionlist_req.find("Lower(name) >= Lower('" + char(li_counter) + "')", ll_startrow, this.id_selectionlist_req.rowcount())
		ll_startrow = this.ia_llookuptable_req[li_counter]
	next
	this.ia_llookuptable_req[92] = this.id_selectionlist_req.rowcount()
	setredraw(true)

// w_serviceorder_form.wf_validateitem_req(long al_row) returns long
	long ll_icode
	long ll_null
	integer li_errcode
	string ls_errortext
	setnull(ll_null)
	ll_icode = this.id_itemreq.getitemnumber(al_row, "icode")
	if isnull(ll_icode) then
		this.ib_rowvalidated_req = false
		this.ib_itemvalidated_req = false
		messagebox("Validation Error!", "Please Enter Valid Item")
		li_errcode = -1
	elseif vf_dwdupcode1(this.id_itemreq, "icode", string(ll_icode), al_row) = true then
		messagebox("Duplication Error", "Current row is duplicate")
		li_errcode = -1
		this.ib_rowvalidated_req = false
		this.ib_itemvalidated_req = false
	elseif wf_inititeminfo_req(ll_icode, al_row, li_errcode, ls_errortext) then
		li_errcode = 0
		this.ib_rowvalidated_req = true
		this.ib_itemvalidated_req = true
	else
		li_errcode = -1
	end if
	if li_errcode = -1 then
		this.id_itemreq.setcolumn("icode")
		this.id_itemreq.scrolltorow(al_row)
		this.id_itemreq.object.icode[al_row] = ll_null
	end if
	return li_errcode

// w_serviceorder_form.wf_inititeminfo_req(long al_icode, long al_row, integer ai_rtcode, string as_errortext) returns boolean
	boolean retflag
	double ld_saleprice
	double ld_discperc
	double ld_flatdisc
	double ld_avgprice
	long ll_packunits
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_allowsaleindecimal
	datetime ldt_date
	setnull(ls_null)
	SQL SELECT CustomICode , name , SalePrice =Round ( SalePrice / CASE WHEN PackUnits <= 0 THEN 1 ELSE PackUnits END , 2 ) , Packunits , avgprice INTO :ls_fullcode, :ls_name, :ld_saleprice, :ll_packunits, :ld_avgprice FROM Item WHERE ICode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if retflag then
		this.id_itemreq.setitem(al_row, "itemname", ls_name)
		this.id_itemreq.setitem(al_row, "fullcode", ls_fullcode)
		this.id_itemreq.setitem(al_row, "packunits", ll_packunits)
		this.id_itemreq.setitem(al_row, "avgprice", ld_avgprice)
		if this.id_itemreq.getitemstatus(al_row, "saleprice", primary!) = notmodified! then
			this.id_itemreq.setitem(al_row, "saleprice", ld_saleprice)
		end if
		if al_icode <> this.id_itemreq.getitemnumber(al_row, "itemcode") then
			this.id_itemreq.setitem(al_row, "saleprice", ld_saleprice)
		end if
		this.id_itemreq.setitem(al_row, "itemcode", al_icode)
		this.id_itemreq.setitem(al_row, "icode", al_icode)
	else
		retflag = false
		as_errortext = "Unable to Select Item."
	end if
	return retflag

// w_serviceorder_form.wf_findfullcode(string as_fullcode, long al_icode, string as_itemname) returns long
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		as_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_serviceorder_form.wf_validate_req() returns long
	long ll_currrow
	long ll_counter
	long ll_null
	ll_currrow = this.id_itemreq.getrow()
	setnull(ll_null)
	if this.id_itemreq.rowcount() > 0 then
		if isnull(this.id_itemreq.getitemnumber(ll_currrow, "icode")) then
			if isnull(this.id_itemreq.getitemstring(ll_currrow, "itemname")) then
				this.id_itemreq.deleterow(ll_currrow)
			elseif this.ib_itemvalidated_req = false then
				messagebox("Item Validation", "Please Select Some Valid Item")
				this.id_itemreq.setcolumn("itemname")
				this.id_itemreq.scrolltorow(ll_currrow)
				this.id_itemreq.setfocus()
				return 1
			end if
		elseif this.ib_itemvalidated_req = false then
			messagebox("Item Validation", "Please Select Some Valid Item")
			this.id_itemreq.setcolumn("itemname")
			this.id_itemreq.scrolltorow(ll_currrow)
			this.id_itemreq.setfocus()
			return 1
		end if
		if f_validatedw(this.id_itemreq) < 0 then
			return 1
		end if
		this.il_currrow_req = this.id_itemreq.rowcount()
		if this.ib_itemvalidated_req = false and wf_validateitem_req(ll_currrow) = -1 then
			return 1
		end if
		return
	end if
	return 0

// w_serviceorder_form.wf_show_salehistory() returns long
	s_itemsalehistory ls_itemsalehistory
	if this.id_itemreq.rowcount() > 0 then
		ls_itemsalehistory.ar_icode = this.id_itemreq.object.icode[this.id_itemreq.getrow()]
		ls_itemsalehistory.ar_date = this.id_svcheader.object.date[this.id_svcheader.getrow()]
		openwithparm(w_itemsalehistory, ls_itemsalehistory)
	end if
	return 0

// w_serviceorder_form.wf_show_servicesalehistory() returns long
	s_itemsalehistory ls_itemsalehistory
	if this.id_svcdetail.rowcount() > 0 then
		ls_itemsalehistory.ar_icode = this.id_svcdetail.object.icode[this.id_svcdetail.getrow()]
		ls_itemsalehistory.ar_date = this.id_svcheader.object.date[this.id_svcheader.getrow()]
		openwithparm(w_servicesalehistory, ls_itemsalehistory)
	end if
	return 0

// w_serviceorder_form.wf_presave() returns long
	long ll_counter
	long ll_rows
	long ll_row
	long ll_code
	ll_code = this.id_svcheader.object.code[1]
	this.ids_checklist_hidden.dataobject = this.id_checklist.dataobject
	this.ids_checklist_hidden.settransobject(this.it_transobject)
	ll_counter = 0
	for ll_counter = 1 to this.id_checklist.rowcount()
		if this.id_checklist.object.selected[ll_counter] = "Y" then
			ll_row = this.ids_checklist_hidden.insertrow(0)
			if ll_row > 0 then
				this.ids_checklist_hidden.object.code[ll_row] = ll_code
				this.ids_checklist_hidden.object.checklistitemcode[ll_row] = this.id_checklist.object.checklistitemcode[ll_counter]
				this.ids_checklist_hidden.object.qty[ll_row] = this.id_checklist.object.qty[ll_counter]
				this.ids_checklist_hidden.object.description[ll_row] = this.id_checklist.object.description[ll_counter]
			end if
		end if
	next
	SQL DELETE SOCheckListItem WHERE ServiceOCode =:ll_code USING this.it_transobject;
	return 0

// w_serviceorder_form.create() returns 0 [event]
	this.dw_netamt = create dw_netamt
	this.cb_printorder = create cb_printorder
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.tab_main = create tab_main
	this.dw_image = create dw_image
	this.dw_print = create dw_print
	this.dw_print2 = create dw_print2
	this.control = {this.dw_netamt, this.cb_printorder, this.cb_cancel, this.cb_ok, this.tab_main, this.dw_image, this.dw_print, this.dw_print2}

// w_serviceorder_form.destroy() returns 0 [event]
	destroy this.dw_netamt
	destroy this.cb_printorder
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.tab_main
	destroy this.dw_image
	destroy this.dw_print
	destroy this.dw_print2

// w_serviceorder_form.open() returns long [event]
	integer li_xpos
	integer li_ypos
	integer li_xendpos
	integer li_counter
	integer li_taborder
	integer li_visiblecolumns
	integer li_zerotaborder
	long ll_counter
	long li_retcode
	long li_rtncode
	boolean lb_active
	boolean lb_restricted
	boolean lb_customicode
	boolean lb_zerotabordercol
	date ld_date
	long ll_retcode
	ld_date = today()
	this.istr_datatype = message.powerobjectparm
	this.il_protect = this.istr_datatype.ai_int
	this.il_code = this.istr_datatype.al_long
	this.it_transobject = create u_transaction
	if wf_connect() <> 0 then
		messagebox("Connection Failure", "Unable to connect to the database", stopsign!)
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	this.ib_uploadimage = true
	this.ib_viewimage = true
	wf_retrieve_tabs()
	wf_apply_protect_setting()
	wf_set_interface_adjustments()
	wf_set_tab_visibility()
	this.ids_checklist_hidden = create u_ds_standard
	this.ids_checklist_hidden.dataobject = this.id_checklist.dataobject
	this.ids_checklist_hidden.settransobject(this.it_transobject)
	triggerevent("ue_postopen")
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_serviceorder_form.key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyf8! and this.ib_viewimage then
		wf_show_patient_gallery()
	end if
	if key = keyf9! and this.ib_uploadimage then
		wf_setimage("ECG")
	end if
	return ::message.returnvalue

// cb_printorder.clicked() returns long [event]
	parent.ib_printorder = true
	parent.wf_save()
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.postevent("ue_close")
	return ::message.returnvalue

// cb_ok.ue_enterkry(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return 1

// cb_ok.clicked() returns long [event]
	string ls_aliasname
	long ll_newid
	long ll_row
	long ll_counter
	long ll_liccode
	long li_rc
	long ll_pk
	long ll_null
	long ll_usercode
	long ll_insrow
	long ll_issuereqcode
	boolean lb_commitok
	datetime ldt_server_datetime
	string ls_date_errtext
	setnull(ll_null)
	if parent.il_protect = 1 then
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_svcheader) < 0 then
		parent.tab_main.selecttab(1)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_checklist) < 0 then
		parent.tab_main.selecttab(2)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_svcdetail) < 0 then
		parent.tab_main.selecttab(3)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_svcfooter) < 0 then
		parent.tab_main.selecttab(3)
		return ::message.returnvalue
	end if
	if parent.wf_validate_service() = 1 then
		parent.tab_main.selecttab(3)
		return ::message.returnvalue
	end if
	if parent.wf_validate_req() = 1 then
		parent.tab_main.selecttab(4)
		return ::message.returnvalue
	end if
	parent.wf_grandtotal()
	if not parent.wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return ::message.returnvalue
	end if
	ll_pk = parent.id_svcheader.object.code[1]
	if f_stringpreferences("ServiceSalesManWindow") = "Y" then
		open(w_salesmanpassword)
		ll_usercode = long(::message.doubleparm)
		setfocus()
	else
		ll_usercode = gl_usercode
	end if
	if ll_usercode > 0 then
		if not parent.wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			return ::message.returnvalue
		end if
		if isnull(ll_pk) then
			parent.wf_tabnewid("ServiceOHeader", ll_newid)
			if ll_newid > 0 then
				parent.id_svcheader.object.code[1] = ll_newid
			end if
		else
			ll_newid = parent.id_svcheader.object.code[1]
		end if
		if parent.id_svcheader.rowcount() > 0 and parent.id_svcfooter.rowcount() > 0 then
			parent.id_svcheader.object.salesmancode[1] = ll_usercode
			parent.id_svcheader.object.date[1] = ldt_server_datetime
			parent.id_svcheader.object.flatdisc[1] = parent.id_svcfooter.object.flatdisc[1]
			parent.id_svcheader.object.discperc[1] = parent.id_svcfooter.object.invdiscperc[1]
			parent.id_svcheader.object.misccharges[1] = parent.id_svcfooter.object.misccharges[1]
			parent.id_svcheader.object.cashreceived[1] = parent.id_svcfooter.object.cashreceived[1]
			parent.id_svcheader.object.serviceinvgstperc[1] = parent.id_svcfooter.object.serviceinvgstperc[1]
		end if
		for ll_counter = 1 to parent.id_svcdetail.rowcount()
			parent.id_svcdetail.object.code[ll_counter] = ll_newid
		next
		ll_counter = 0
		for ll_counter = 1 to parent.id_checklist.rowcount()
			parent.id_checklist.object.code[ll_counter] = ll_newid
		next
		parent.wf_presave()
		if parent.id_itemreq.rowcount() > 0 and not isnull(parent.id_itemreq.object.icode[1]) then
			if parent.ids_itemreq_header.rowcount() = 0 then
				ll_insrow = parent.ids_itemreq_header.insertrow(0)
				if ll_insrow > 0 then
					parent.wf_tabnewid("IssueReqHeader", ll_issuereqcode)
					if ll_issuereqcode > 0 then
						parent.ids_itemreq_header.object.code[ll_insrow] = ll_issuereqcode
						parent.ids_itemreq_header.object.originaldate[ll_insrow] = ldt_server_datetime
					end if
				end if
			else
				ll_insrow = parent.ids_itemreq_header.rowcount()
			end if
			if parent.ids_itemreq_header.rowcount() > 0 then
				ll_issuereqcode = parent.ids_itemreq_header.object.code[ll_insrow]
				parent.ids_itemreq_header.object.serviceocode[ll_insrow] = ll_newid
				parent.ids_itemreq_header.object.remarks[ll_insrow] = "Issue Request Generated via Service Order No." + trim(string(ll_newid))
				parent.ids_itemreq_header.object.date[ll_insrow] = ldt_server_datetime
				parent.ids_itemreq_header.object.acccode[ll_insrow] = parent.id_svcheader.object.custcode[1]
				parent.ids_itemreq_header.object.deptcode[ll_insrow] = 1
				parent.ids_itemreq_header.object.salesmancode[ll_insrow] = ll_usercode
				parent.ids_itemreq_header.object.posted[ll_insrow] = "N"
				parent.ids_itemreq_header.object.areacode[ll_insrow] = 1
			end if
			ll_counter = 0
			for ll_counter = 1 to parent.id_itemreq.rowcount()
				parent.id_itemreq.object.code[ll_counter] = ll_issuereqcode
			next
		end if
		if parent.id_svcheader.update() = 1 then
			if parent.id_svcdetail.update() = 1 then
				if parent.ids_itemreq_header.update() = 1 then
					if parent.id_itemreq.update() = 1 then
						if parent.ids_checklist_hidden.update() = 1 then
							SQL commit USING parent.it_transobject;
							parent.il_code = ll_newid
							lb_commitok = true
							if parent.ib_printorder then
								parent.wf_printorder()
							end if
							parent.event ue_close()
							return ::message.returnvalue
						else
							if isnull(ll_pk) then
								parent.id_svcheader.object.code[1] = ll_null
							end if
							messagebox("Service Order Saving Problem", "Unable to update Service Order Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
							SQL rollback USING parent.it_transobject;
						end if
					else
						if isnull(ll_pk) then
							parent.id_svcheader.object.code[1] = ll_null
						end if
						messagebox("Service Order Saving Problem", "Unable to update Service Order Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
						SQL rollback USING parent.it_transobject;
					end if
				else
					if isnull(ll_pk) then
						parent.id_svcheader.object.code[1] = ll_null
					end if
					messagebox("Service Order Saving Problem", "Unable to update Service Order Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
					SQL rollback USING parent.it_transobject;
				end if
			else
				if isnull(ll_pk) then
					parent.id_svcheader.object.code[1] = ll_null
				end if
				messagebox("Service Order Saving Problem", "Unable to update Service Order Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
				SQL rollback USING parent.it_transobject;
			end if
		else
			if isnull(ll_pk) then
				parent.id_svcheader.object.code[1] = ll_null
			end if
			messagebox("Service Order Saving Problem", "Unable to update Service Order Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
			SQL rollback USING parent.it_transobject;
		end if
	end if
	return ::message.returnvalue

// tab_main.create() returns 0 [event]
	this.tabpage_header = create tabpage_header
	this.tabpage_checklist = create tabpage_checklist
	this.tabpage_detail = create tabpage_detail
	this.tabpage_itemreq = create tabpage_itemreq
	this.tabpage_issue = create tabpage_issue
	this.tabpage_service = create tabpage_service
	this.tabpage_sale = create tabpage_sale
	this.control = {this.tabpage_header, this.tabpage_checklist, this.tabpage_detail, this.tabpage_itemreq, this.tabpage_issue, this.tabpage_service, this.tabpage_sale}

// tab_main.destroy() returns 0 [event]
	destroy this.tabpage_header
	destroy this.tabpage_checklist
	destroy this.tabpage_detail
	destroy this.tabpage_itemreq
	destroy this.tabpage_issue
	destroy this.tabpage_service
	destroy this.tabpage_sale

// tab_main.selectionchanged(integer oldindex, integer newindex) returns long [event]
	parent.wf_grandtotal()
	if parent.il_protect = 0 then
		if newindex = 1 then
			parent.id_svcheader.setfocus()
			if parent.id_svcheader.rowcount() = 0 then
				parent.wf_insert_row(parent.id_svcheader, 0)
			end if
		elseif newindex = 2 then
			parent.id_checklist.setfocus()
			if parent.id_checklist.rowcount() = 0 then
				parent.id_checklist.retrieve(parent.il_code)
			end if
		elseif newindex = 3 then
			parent.id_svcdetail.setfocus()
			if parent.id_svcdetail.rowcount() = 0 then
				parent.wf_insert_row(parent.id_svcdetail, 0)
			end if
		elseif newindex = 4 then
			parent.id_itemreq.setfocus()
			if parent.id_itemreq.rowcount() = 0 then
				parent.wf_insert_row(parent.id_itemreq, 0)
			end if
		elseif newindex = 5 then
			parent.id_issue.setfocus()
			parent.id_issue.retrieve(parent.il_code)
		elseif newindex = 6 then
			parent.id_service.setfocus()
			parent.id_service.retrieve(parent.il_code)
		elseif newindex = 7 then
			parent.id_sale.setfocus()
			parent.id_sale.retrieve(parent.il_code)
		end if
	end if
	return ::message.returnvalue

// tab_main.key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyf9! then
		parent.wf_setimage("ECG")
	end if
	return ::message.returnvalue

// tabpage_header.create() returns 0 [event]
	this.dw_header = create dw_header
	this.control = {this.dw_header}

// tabpage_header.destroy() returns 0 [event]
	destroy this.dw_header

// dw_header.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ll_counter
	long ll_foundcode
	s_popup_selection lstr_selection
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	try
		if getcolumnname() = "custcode" and key = keyf5! then
			parent.parent.parent.wf_new_customerregisteration()
		elseif getcolumnname() = "patientcode" and key = keyf5! then
			parent.parent.parent.wf_new_patientregistration()
		elseif getcolumnname() = "patientcode" and key = keyf6! then
			parent.parent.parent.is_comprehensive_search_dataobject = "d_patient_comprehensive_list"
			ll_foundcode = parent.parent.parent.wf_comprehensive_search()
			if ll_foundcode >= 0 then
				this.object.patientcode[1] = ll_foundcode
				parent.parent.parent.wf_setpatientinfo(ll_foundcode)
			end if
		elseif getcolumnname() = "patientcode" and key = keyf8! then
			openwithparm(w_popup_partialsearch_selection, "d_patient_list")
			lstr_selection = message.powerobjectparm
			if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
				ll_foundcode = lstr_selection.l_code2
				this.object.patientcode[1] = ll_foundcode
				parent.parent.parent.wf_setpatientinfo(ll_foundcode)
			end if
		elseif getcolumnname() = "patientcode" and key = keyf9! then
			parent.parent.parent.wf_show_patientgallery()
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
		setnull(ll_counter)
		parent.parent.parent.id_svcheader.setitem(1, "custcode", ll_counter)
	end try
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_header.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// dw_header.getfocus() returns long [event]
	setfocus()
	selecttext(1, len(gettext()))
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_header.itemfocuschanged(long row, dwobject dwo) returns long [event]
	if len(gettext()) > 0 then
		selecttext(1, len(gettext()))
	end if
	return ::message.returnvalue

// dw_header.itemchanged(long row, dwobject dwo, string data) returns long [event]
	dwitemstatus lrs_status
	long ll_code
	long ll_detailrows
	long ll_suppcode
	long ll_custcode
	long ll_counter
	long ll_customerbalance
	long ll_headerinvno
	long ll_patientcode
	integer rt_code
	long ll_icode
	long ld_saleprice1
	long ld_saleprice2
	long ld_saleprice3
	long ld_avgprice
	long li_packunits
	string ls_result
	string ls_null
	string ls_aliasname
	string ls_regno
	datetime ld_currdate
	date ld_datepart
	time lt_timepart
	char lc_newcustomer
	integer li_res
	choose case dwo.name
	case "date"
		if isdate(left(data, 10)) then
			ld_datepart = date(left(data, 10))
			if istime(mid(data, 12, 8)) then
				lt_timepart = time(mid(data, 12, 8))
				ld_currdate = datetime(ld_datepart, lt_timepart)
			else
				rt_code = 1
			end if
		else
			rt_code = 1
		end if
	case "aliasname"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findcustcode(ll_custcode, data)
			if li_res > 0 then
				setitem(row, "custcode", ll_custcode)
				rt_code = 0
			else
				messagebox("Customer Validation", "Customer with  Alias Name  " + data + "   does not exist")
				rt_code = 1
			end if
		end if
	case "custcode"
		if not isnull(data) then
			ll_code = long(data)
			parent.setredraw(false)
			if parent.parent.parent.wf_customerinfo(ll_code) <> 0 then
				messagebox("Database Error", "Can not retrieve information of customer from database")
				rt_code = 1
			else
				if accepttext() = -1 then
					return 1
				end if
				ls_aliasname = parent.parent.parent.idc_customers.getitemstring(parent.parent.parent.idc_customers.getrow(), "accounts_aliasname")
				setitem(row, "aliasname", ls_aliasname)
			end if
			parent.setredraw(true)
		end if
	case "patientregno"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findpatientcode(data, ll_patientcode)
			if li_res > 0 then
				setitem(row, "patientcode", ll_patientcode)
				rt_code = 0
				SQL SELECT acccode , aliasname INTO :ll_custcode, :ls_aliasname FROM patient , accounts WHERE patientcode =:ll_patientcode and custcode =acccode USING parent.parent.parent.it_transobject;
				if parent.parent.parent.it_transobject.sqlcode = 0 then
					setitem(row, "custcode", ll_custcode)
					setitem(row, "aliasname", ls_aliasname)
					this.object.custcode.protect = 1
					this.object.aliasname.protect = 1
				else
					messagebox("Patient Information", "Problem in retrieving corresponding customer")
					rt_code = 1
				end if
			else
				messagebox("Patient Validation", "Patient with  RegNo  " + data + " does not exist")
				rt_code = 1
			end if
		end if
	case "patientcode"
		ll_patientcode = long(data)
		if isnull(data) then
			this.object.custcode.protect = 0
			this.object.aliasname.protect = 0
			setitem(1, "custcode", 0)
			setitem(1, "aliasname", "")
		else
			setitem(1, "patientregno", parent.parent.parent.idc_patient.getitemstring(parent.parent.parent.idc_patient.getrow(), "regno"))
			SQL SELECT acccode , aliasname , regno INTO :ll_custcode, :ls_aliasname, :ls_regno FROM patient , accounts WHERE patientcode =:ll_patientcode and custcode =acccode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = 0 then
				setitem(1, "patientregno", ls_regno)
				setitem(1, "custcode", ll_custcode)
				setitem(1, "aliasname", ls_aliasname)
				this.object.custcode.protect = 1
				this.object.aliasname.protect = 1
				this.object.custcode.visible = true
			else
				messagebox("Patient Information", "Problem in retrieving corresponding customer")
				rt_code = 1
			end if
		end if
		return rt_code
	end choose
	return rt_code

// tabpage_checklist.create() returns 0 [event]
	this.dw_checklist = create dw_checklist
	this.control = {this.dw_checklist}

// tabpage_checklist.destroy() returns 0 [event]
	destroy this.dw_checklist

// dw_checklist.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// tabpage_detail.create() returns 0 [event]
	this.dw_footer = create dw_footer
	this.dw_detail = create dw_detail
	this.dw_selectionlist = create dw_selectionlist
	this.control = {this.dw_footer, this.dw_detail, this.dw_selectionlist}

// tabpage_detail.destroy() returns 0 [event]
	destroy this.dw_footer
	destroy this.dw_detail
	destroy this.dw_selectionlist

// dw_footer.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if getcolumnname() = "flatdisc" and key = keyuparrow! then
		parent.parent.parent.id_svcdetail.setrow(parent.parent.parent.id_svcdetail.rowcount())
		parent.parent.parent.id_svcdetail.scrolltorow(parent.parent.parent.id_svcdetail.rowcount())
		parent.parent.parent.id_svcdetail.setfocus()
		if f_stringpreferences("FullCode") = "N" then
			parent.parent.parent.id_svcdetail.setcolumn("itemname")
		else
			parent.parent.parent.id_svcdetail.setcolumn("fullcode")
		end if
	end if
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_footer.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	if rowcount() > 0 then
		parent.parent.parent.wf_grandtotal()
	end if
	return ::message.returnvalue

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_rowm
	long ll_rowcount
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf5! then
		parent.parent.parent.wf_show_servicesalehistory()
		return 1
	end if
	if parent.parent.parent.il_protect = 0 then
		if keyflags = 2 and key = keyi! then
			if parent.parent.parent.ib_rowvalidated = false and parent.parent.parent.wf_validateitem(getrow()) = -1 then
				return ::message.returnvalue
			end if
			if rowcount() > 0 and f_validatedw(parent.parent.parent.id_svcdetail) < 0 then
				return ::message.returnvalue
			end if
			ll_rowcount = insertrow(0)
			parent.parent.parent.il_currrow = ll_rowcount
			if ll_rowcount > 0 then
				scrolltorow(ll_rowcount)
				setcolumn("itemname")
				setfocus()
				parent.parent.parent.id_selectionlist.hide()
			end if
		end if
		if keyflags = 2 and key = keyd! then
			parent.parent.parent.ib_rowvalidated = true
			if rowcount() > 0 then
				deleterow(0)
			end if
			ll_rowcount = rowcount()
			parent.parent.parent.il_currrow = ll_rowcount
			if ll_rowcount > 1 then
				scrolltorow(ll_rowcount)
				setcolumn("itemname")
				setfocus()
				parent.parent.parent.id_selectionlist.hide()
			end if
			parent.parent.parent.ib_rowvalidated = true
		end if
	end if
	if getcolumnname() = "itemname" then
		ll_rowm = getrow()
		setredraw(false)
		if key = keydownarrow! then
			parent.parent.parent.id_selectionlist.selectrow(0, false)
			parent.parent.parent.id_selectionlist.scrollnextrow()
			ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.parent.parent.id_selectionlist.selectrow(0, false)
			parent.parent.parent.id_selectionlist.scrollpriorrow()
			ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.parent.parent.id_selectionlist.selectrow(0, false)
			parent.parent.parent.id_selectionlist.scrollnextpage()
			ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.parent.parent.id_selectionlist.selectrow(0, false)
			parent.parent.parent.id_selectionlist.scrollpriorpage()
			ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.parent.parent.id_selectionlist.selectrow(0, false)
			parent.parent.parent.id_selectionlist.scrolltorow(99999)
			ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.parent.parent.id_selectionlist.selectrow(0, false)
			parent.parent.parent.id_selectionlist.scrolltorow(1)
			ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			if parent.parent.parent.id_selectionlist.visible = false then
				return ::message.returnvalue
			end if
			parent.parent.parent.id_selectionlist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf4! then
			parent.parent.parent.id_selectionlist.show()
			parent.parent.parent.id_selectionlist.selectrow(0, false)
			parent.parent.parent.id_selectionlist.scrolltorow(parent.parent.parent.id_selectionlist.getrow())
			parent.parent.parent.id_selectionlist.selectrow(parent.parent.parent.id_selectionlist.getrow(), true)
			setredraw(true)
		elseif isnull(getitemnumber(parent.parent.parent.id_svcdetail.getrow(), "icode")) and key = keyenter! then
			parent.parent.parent.id_selectionlist.hide()
			parent.parent.parent.id_selectionlist.selectrow(0, false)
			parent.parent.parent.id_selectionlist.scrolltorow(parent.parent.parent.id_selectionlist.getrow())
			parent.parent.parent.id_selectionlist.selectrow(parent.parent.parent.id_selectionlist.getrow(), true)
			ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
			setitem(ll_rowm, "icode", parent.parent.parent.id_selectionlist.getitemnumber(ll_listcurrrow, "icode"))
			setitem(ll_rowm, "itemname", parent.parent.parent.id_selectionlist.getitemstring(ll_listcurrrow, "itemname"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.ib_rowvalidated = false
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_selectionlist.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, "icode", parent.parent.parent.id_selectionlist.getitemnumber(ll_listcurrrow, "icode"))
			setitem(ll_rowm, "itemname", parent.parent.parent.id_selectionlist.getitemstring(ll_listcurrrow, "itemname"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.ib_rowvalidated = false
			setredraw(true)
		end if
	end if
	if getcolumnname() <> "itemname" and getrow() = rowcount() and key = keydownarrow! then
		parent.parent.parent.id_svcfooter.setfocus()
		parent.parent.parent.id_svcfooter.setcolumn("FlatDisc")
	end if
	if key = keyf8! and parent.parent.parent.ib_viewimage then
		parent.parent.parent.wf_show_patient_gallery()
	end if
	if key = keyf9! and parent.parent.parent.ib_uploadimage then
		parent.parent.parent.wf_setimage("ECG")
	end if
	return rt_code

// dw_detail.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	setfocus()
	selecttext(1, len(gettext()))
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	integer li_rtcode
	string ls_errortext
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(row) = -1 then
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.ib_rowvalidated = false
		return ::message.returnvalue
	end if
	choose case dwo.name
	case "itemname"
		if row > 0 then
			parent.parent.parent.id_selectionlist.show()
		end if
	case else
		if row > 0 then
			parent.parent.parent.id_selectionlist.hide()
		end if
	end choose
	parent.parent.parent.wf_grandtotal()
	if len(gettext()) > 0 then
		selecttext(1, len(gettext()))
	end if
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	long ll_rowcount
	ancestorreturnvalue = super::ue_enterkey()
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		if parent.parent.parent.id_svcdetail.rowcount() > 0 and f_validatedw(parent.parent.parent.id_svcdetail) < 0 then
			return ::message.returnvalue
		end if
		if parent.parent.parent.ib_rowvalidated = false and parent.parent.parent.wf_validateitem(getrow()) = -1 then
			return 1
		end if
		ll_rowcount = parent.parent.parent.id_svcdetail.insertrow(0)
		if ll_rowcount > 1 then
			parent.parent.parent.id_svcdetail.setrow(ll_rowcount)
			parent.parent.parent.id_svcdetail.scrolltorow(ll_rowcount)
			if f_stringpreferences("itemcode") = "N" then
				parent.parent.parent.id_svcdetail.setcolumn("itemname")
				parent.parent.parent.id_selectionlist.show()
			else
				parent.parent.parent.id_svcdetail.setcolumn("fullcode")
				parent.parent.parent.id_selectionlist.hide()
			end if
			parent.parent.parent.id_svcdetail.setfocus()
			parent.parent.parent.il_currrow = ll_rowcount
		end if
		return 1
	end if
	if getcolumnname() = "itemname" then
		parent.parent.parent.id_selectionlist.show()
		if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(getrow()) = -1 then
			return 1
		end if
		return
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_detail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_currrow
	long ll_startrow
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	ll_startrow = 0
	choose case dwo.name
	case "itemname"
		if upper(left(data, 1)) >= "A" and upper(left(data, 1)) <= "Z" or left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
			ll_currrow = parent.parent.parent.id_selectionlist.getrow()
			if len(data) > 1 then
				ll_startrow = ll_currrow
			else
				if left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
					ll_startrow = 1
				else
					ll_startrow = parent.parent.parent.ia_llookuptable[asc(upper(data))]
				end if
				parent.parent.parent.ib_bkspace = false
			end if
			if parent.parent.parent.ib_bkspace then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_selectionlist.find("Lower(itemname) <= '" + lower(data) + "'", ll_startrow, 0)
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.il_itemlistfoundrow + 1
				parent.parent.parent.ib_bkspace = false
			else
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_selectionlist.find("Lower(itemname) >= '" + lower(data) + "'", ll_startrow, 99999)
			end if
			if parent.parent.parent.il_itemlistfoundrow = 0 then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_selectionlist.rowcount()
			end if
			if parent.parent.parent.il_itemlistfoundrow <> ll_currrow then
				parent.parent.parent.id_selectionlist.selectrow(0, false)
				parent.parent.parent.id_selectionlist.setrow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_selectionlist.scrolltorow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_selectionlist.selectrow(parent.parent.parent.il_itemlistfoundrow, true)
				setfocus()
			elseif parent.parent.parent.il_itemlistfoundrow = ll_currrow then
				parent.parent.parent.id_selectionlist.selectrow(0, false)
				parent.parent.parent.id_selectionlist.setrow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_selectionlist.scrolltorow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_selectionlist.selectrow(parent.parent.parent.il_itemlistfoundrow, true)
				setfocus()
			end if
		end if
	end choose
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_icode
	long ll_null
	long ll_gcode
	long ll_errcode
	string ls_itemname
	string ls_null
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_find_service_fullcode(data, ll_icode, ls_itemname)
			if li_res > 0 then
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				setitem(row, "qty", 1)
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.ib_rowvalidated = false
				parent.parent.parent.il_currrow = row
				ll_errcode = 0
				if parent.parent.parent.wf_validateitem(row) = 0 then
					ll_errcode = 0
				else
					ll_errcode = 1
				end if
			else
				messagebox("Service Code/Alias Name Validation", "Service does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				ll_errcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			ll_errcode = 2
		end if
	case "saleprice"
		if real(data) < 0.0 then
			return 1
		end if
	case "itemname"
		setitem(row, "icode", parent.parent.parent.id_selectionlist.getitemnumber(parent.parent.parent.id_selectionlist.getrow(), "icode"))
		setitem(row, "itemname", parent.parent.parent.id_selectionlist.getitemstring(parent.parent.parent.id_selectionlist.getrow(), "itemname"))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.ib_rowvalidated = false
		parent.parent.parent.il_currrow = row
		ll_errcode = 2
	case "qty"
		if double(data) <= 0.0 then
			messagebox("Qty Validation", "Please enter valid Qty", stopsign!)
			ll_errcode = 1
		end if
	case else
		parent.parent.parent.ib_rowvalidated = true
	end choose
	return ll_errcode

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "itemname"
		messagebox("Name Validation", "Please enter value for service Name")
	case "saleprice"
		messagebox("Price Validation", "Please enter valid value for saleprice")
	end choose
	return 1

// dw_detail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.id_selectionlist.hide()
	return ::message.returnvalue

// dw_detail.rowfocuschanging(long currentrow, long newrow) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::rowfocuschanging(currentrow, newrow)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(getrow()) = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_selectionlist.ue_setfocus() returns 0 [event]
	parent.parent.parent.id_svcdetail.setcolumn("itemname")
	parent.parent.parent.id_svcdetail.setfocus()

// dw_selectionlist.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::doubleclicked(xpos, ypos, row, dwo)
	post event ue_setfocus()
	return ::message.returnvalue

// dw_selectionlist.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	long ll_rowmain
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	if row > 0 then
		ll_rowmain = parent.parent.parent.id_svcdetail.getrow()
		parent.parent.parent.id_svcdetail.setitem(ll_rowmain, "icode", parent.parent.parent.id_selectionlist.getitemnumber(row, "icode"))
		parent.parent.parent.id_svcdetail.setitem(ll_rowmain, "itemname", parent.parent.parent.id_selectionlist.getitemstring(row, "itemname"))
		parent.parent.parent.id_svcdetail.selecttext(1, len(gettext()))
		parent.parent.parent.ib_itemvalidated = false
		selectrow(0, false)
		selectrow(row, true)
		post event ue_setfocus()
	end if
	return ::message.returnvalue

// tabpage_itemreq.create() returns 0 [event]
	this.dw_selection_req = create dw_selection_req
	this.dw_itemreq = create dw_itemreq
	this.control = {this.dw_selection_req, this.dw_itemreq}

// tabpage_itemreq.destroy() returns 0 [event]
	destroy this.dw_selection_req
	destroy this.dw_itemreq

// dw_selection_req.ue_setfocus() returns 0 [event]
	parent.parent.parent.id_itemreq.setcolumn("itemname")
	parent.parent.parent.id_itemreq.setfocus()

// dw_selection_req.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	long ll_rowmain
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	if row > 0 then
		ll_rowmain = parent.parent.parent.id_itemreq.getrow()
		parent.parent.parent.id_itemreq.setitem(ll_rowmain, "icode", parent.parent.parent.id_selectionlist_req.getitemnumber(row, "code"))
		parent.parent.parent.id_itemreq.setitem(ll_rowmain, "itemname", parent.parent.parent.id_selectionlist_req.getitemstring(row, "name"))
		parent.parent.parent.id_itemreq.selecttext(1, len(gettext()))
		parent.parent.parent.ib_itemvalidated_req = false
		selectrow(0, false)
		selectrow(row, true)
		post event ue_setfocus()
	end if
	return ::message.returnvalue

// dw_selection_req.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::doubleclicked(xpos, ypos, row, dwo)
	post event ue_setfocus()
	return ::message.returnvalue

// dw_itemreq.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_currrow
	long ll_startrow
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	ll_startrow = 0
	choose case dwo.name
	case "itemname"
		if upper(left(data, 1)) >= "A" and upper(left(data, 1)) <= "Z" or left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
			ll_currrow = parent.parent.parent.id_selectionlist_req.getrow()
			if len(data) > 1 then
				ll_startrow = ll_currrow
			else
				if left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
					ll_startrow = 1
				else
					ll_startrow = parent.parent.parent.ia_llookuptable_req[asc(upper(data))]
				end if
				parent.parent.parent.ib_bkspace_req = false
			end if
			if parent.parent.parent.ib_bkspace_req then
				parent.parent.parent.il_itemlistfoundrow_req = parent.parent.parent.id_selectionlist_req.find("Lower(name) <= '" + lower(data) + "'", ll_startrow, 0)
				parent.parent.parent.il_itemlistfoundrow_req = parent.parent.parent.il_itemlistfoundrow_req + 1
				parent.parent.parent.ib_bkspace_req = false
			else
				parent.parent.parent.il_itemlistfoundrow_req = parent.parent.parent.id_selectionlist_req.find("Lower(name) >= '" + lower(data) + "'", ll_startrow, parent.parent.parent.id_selectionlist_req.rowcount())
			end if
			if parent.parent.parent.il_itemlistfoundrow_req = 0 then
				parent.parent.parent.il_itemlistfoundrow_req = parent.parent.parent.id_selectionlist_req.rowcount()
			end if
			if parent.parent.parent.il_itemlistfoundrow_req <> ll_currrow then
				parent.parent.parent.id_selectionlist_req.selectrow(0, false)
				parent.parent.parent.id_selectionlist_req.setrow(parent.parent.parent.il_itemlistfoundrow_req)
				parent.parent.parent.id_selectionlist_req.scrolltorow(parent.parent.parent.il_itemlistfoundrow_req)
				parent.parent.parent.id_selectionlist_req.selectrow(parent.parent.parent.il_itemlistfoundrow_req, true)
				setfocus()
			elseif parent.parent.parent.il_itemlistfoundrow_req = ll_currrow then
				parent.parent.parent.id_selectionlist_req.selectrow(0, false)
				parent.parent.parent.id_selectionlist_req.setrow(parent.parent.parent.il_itemlistfoundrow_req)
				parent.parent.parent.id_selectionlist_req.scrolltorow(parent.parent.parent.il_itemlistfoundrow_req)
				parent.parent.parent.id_selectionlist_req.selectrow(parent.parent.parent.il_itemlistfoundrow_req, true)
				setfocus()
			end if
		end if
	end choose
	return ::message.returnvalue

// dw_itemreq.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	if parent.parent.parent.il_protect = 0 then
		if f_stringpreferences("itemcode") = "N" then
			parent.parent.parent.id_selectionlist_req.show()
		end if
	else
		parent.parent.parent.id_selectionlist_req.hide()
	end if
	setfocus()
	selecttext(1, len(gettext()))
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_itemreq.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_retcode
	integer li_res
	long ll_icode
	long ll_null
	long ll_gcode
	string ls_itemname
	string ls_null
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case "itemname"
		setitem(row, "icode", parent.parent.parent.id_selectionlist_req.getitemnumber(parent.parent.parent.id_selectionlist_req.getrow(), "code"))
		setitem(row, "itemname", parent.parent.parent.id_selectionlist_req.getitemstring(parent.parent.parent.id_selectionlist_req.getrow(), "name"))
		parent.parent.parent.ib_itemvalidated_req = false
		parent.parent.parent.ib_rowvalidated_req = false
		parent.parent.parent.il_currrow_req = row
		li_retcode = 1
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname)
			if li_res > 0 then
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				parent.parent.parent.ib_itemvalidated_req = false
				parent.parent.parent.ib_rowvalidated_req = false
				parent.parent.parent.il_currrow_req = row
				li_retcode = 0
			else
				messagebox("ItemNumber Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_retcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			setitem(row, "itemname", "")
			parent.parent.parent.id_selectionlist_req.show()
			li_retcode = 2
		end if
	case "qty"
		if double(data) <= 0.0 then
			messagebox("Qty Validation!", "Please enter valid Qty")
			return 1
		end if
	case else
		parent.parent.parent.ib_rowvalidated_req = true
	end choose
	return li_retcode

// dw_itemreq.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "itemname"
		messagebox("Item Validation", "Please enter valid Item Name")
	case "qty"
		messagebox("Qty Validation", "Please enter valid Qty")
	case "duration"
		messagebox("Duration Validation", "Please enter valid duration")
	end choose
	return 1

// dw_itemreq.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	string ls_itemname
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidated_req = false and parent.parent.parent.wf_validateitem_req(row) = -1 then
		parent.parent.parent.ib_itemvalidated_req = false
		parent.parent.parent.ib_rowvalidated_req = false
		return ::message.returnvalue
	end if
	if row > 0 then
		choose case dwo.name
		case "fullcode"
			if isnull(getitemnumber(row, "icode")) then
				parent.parent.parent.id_selectionlist.show()
			end if
		case "itemname"
			if isnull(getitemstring(row, "fullcode")) or getitemstring(row, "fullcode") = "" then
				parent.parent.parent.id_selectionlist.show()
			end if
			if isnull(getitemnumber(row, "icode")) then
				parent.parent.parent.id_selectionlist.show()
			else
				ls_itemname = this.object.itemname[row]
				if isnull(ls_itemname) then
					ls_itemname = ""
				end if
				parent.parent.parent.il_itemlistfoundrow_req = parent.parent.parent.id_selectionlist_req.find("name = '" + ls_itemname + "'", 1, parent.parent.parent.id_selectionlist_req.rowcount())
				if parent.parent.parent.il_itemlistfoundrow_req > parent.parent.parent.id_selectionlist_req.rowcount() then
					parent.parent.parent.il_itemlistfoundrow_req = parent.parent.parent.id_selectionlist_req.rowcount()
				elseif isnull(parent.parent.parent.il_itemlistfoundrow_req) or parent.parent.parent.il_itemlistfoundrow_req = 0 then
					parent.parent.parent.il_itemlistfoundrow_req = 1
				end if
				parent.parent.parent.id_selectionlist_req.show()
				parent.parent.parent.id_selectionlist_req.selectrow(0, false)
				parent.parent.parent.id_selectionlist_req.scrolltorow(parent.parent.parent.il_itemlistfoundrow_req)
				parent.parent.parent.id_selectionlist_req.selectrow(parent.parent.parent.il_itemlistfoundrow_req, true)
			end if
		case else
			parent.parent.parent.id_selectionlist_req.hide()
		end choose
	end if
	parent.parent.parent.wf_grandtotal()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_itemreq.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.id_selectionlist_req.hide()
	return ::message.returnvalue

// dw_itemreq.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if parent.parent.parent.ib_itemvalidated_req = false and parent.parent.parent.wf_validateitem_req(getrow()) = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_itemreq.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_rowm
	long ll_rowcount
	long ll_icode
	long ll_found
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf5! then
		parent.parent.parent.wf_show_salehistory()
		return 1
	end if
	if parent.parent.parent.il_protect = 0 then
		if keyflags = 2 then
			if key = keyi! then
				if parent.parent.parent.ib_rowvalidated_req = false and parent.parent.parent.wf_validateitem_req(getrow()) = -1 then
					return ::message.returnvalue
				end if
				if getrow() > 0 and isnull(this.object.icode[getrow()]) then
					return ::message.returnvalue
				end if
				if rowcount() > 0 and f_validatedw(this) < 0 then
					return ::message.returnvalue
				end if
				ll_rowcount = insertrow(0)
				if ll_rowcount > 0 then
					scrolltorow(ll_rowcount)
					if f_stringpreferences("ItemCode") = "Y" then
						setcolumn(1)
					else
						setcolumn(2)
						parent.parent.parent.id_selectionlist_req.show()
					end if
					setfocus()
					parent.parent.parent.il_currrow_req = ll_rowcount
				end if
			elseif key = keyd! then
				parent.parent.parent.ib_rowvalidated_req = true
				if rowcount() > 0 then
					deleterow(0)
				end if
				ll_rowcount = rowcount()
				parent.parent.parent.il_currrow_req = ll_rowcount
				if ll_rowcount > 1 then
					scrolltorow(ll_rowcount)
					setcolumn("itemname")
					setfocus()
					parent.parent.parent.id_selectionlist_req.hide()
				end if
				parent.parent.parent.ib_rowvalidated_req = true
			end if
		end if
		if getcolumnname() = "itemname" then
			ll_rowm = getrow()
			setredraw(false)
			if key = keydownarrow! then
				parent.parent.parent.id_selectionlist_req.selectrow(0, false)
				parent.parent.parent.id_selectionlist_req.scrollnextrow()
				ll_listcurrrow = parent.parent.parent.id_selectionlist_req.getrow()
				rt_code = 1
			elseif key = keyuparrow! then
				parent.parent.parent.id_selectionlist_req.selectrow(0, false)
				parent.parent.parent.id_selectionlist_req.scrollpriorrow()
				ll_listcurrrow = parent.parent.parent.id_selectionlist_req.getrow()
				rt_code = 1
			elseif key = keypagedown! then
				parent.parent.parent.id_selectionlist_req.selectrow(0, false)
				parent.parent.parent.id_selectionlist_req.scrollnextpage()
				ll_listcurrrow = parent.parent.parent.id_selectionlist_req.getrow()
				rt_code = 1
			elseif key = keypageup! then
				parent.parent.parent.id_selectionlist_req.selectrow(0, false)
				parent.parent.parent.id_selectionlist_req.scrollpriorpage()
				ll_listcurrrow = parent.parent.parent.id_selectionlist_req.getrow()
				rt_code = 1
			elseif key = keyend! then
				parent.parent.parent.id_selectionlist_req.selectrow(0, false)
				parent.parent.parent.id_selectionlist_req.scrolltorow(parent.parent.parent.id_selectionlist_req.rowcount())
				ll_listcurrrow = parent.parent.parent.id_selectionlist_req.getrow()
				rt_code = 1
			elseif key = keyhome! then
				parent.parent.parent.id_selectionlist_req.selectrow(0, false)
				parent.parent.parent.id_selectionlist_req.scrolltorow(1)
				ll_listcurrrow = parent.parent.parent.id_selectionlist_req.getrow()
				rt_code = 1
			elseif key = keyback! then
				parent.parent.parent.ib_bkspace_req = true
				setredraw(true)
			elseif key = keyescape! then
				if parent.parent.parent.id_selectionlist_req.visible = false then
					return ::message.returnvalue
				end if
				parent.parent.parent.id_selectionlist_req.hide()
				setfocus()
				setredraw(true)
			elseif key = keyf4! then
				parent.parent.parent.id_selectionlist_req.show()
				parent.parent.parent.id_selectionlist_req.selectrow(0, false)
				parent.parent.parent.id_selectionlist_req.scrolltorow(parent.parent.parent.il_itemlistfoundrow_req)
				parent.parent.parent.id_selectionlist_req.selectrow(parent.parent.parent.il_itemlistfoundrow_req, true)
				setredraw(true)
			elseif key = keyf5! then
				parent.parent.parent.id_selectionlist_req.hide()
				setredraw(true)
				ll_icode = f_drilldown_itemsearch("criteriasearch", 1)
				parent.parent.parent.id_selectionlist_req.setfilter("")
				parent.parent.parent.id_selectionlist_req.filter()
				if ll_icode > 0 then
					ll_found = parent.parent.parent.id_selectionlist_req.find("code = " + string(ll_icode), 1, parent.parent.parent.id_selectionlist_req.rowcount())
					if ll_found > 0 then
						ll_listcurrrow = ll_found
						parent.parent.parent.id_selectionlist_req.selectrow(0, false)
						parent.parent.parent.id_selectionlist_req.selectrow(ll_listcurrrow, true)
						rt_code = 1
					end if
				end if
				setfocus()
			elseif key = keyf6! then
				parent.parent.parent.id_selectionlist_req.hide()
				setredraw(true)
				ll_icode = f_drilldown_itemsearch("namesearch", 1)
				parent.parent.parent.id_selectionlist_req.setfilter("")
				parent.parent.parent.id_selectionlist_req.filter()
				if ll_icode > 0 then
					ll_found = parent.parent.parent.id_selectionlist_req.find("code = " + string(ll_icode), 1, parent.parent.parent.id_selectionlist_req.rowcount())
					if ll_found > 0 then
						ll_listcurrrow = ll_found
						parent.parent.parent.id_selectionlist_req.selectrow(0, false)
						rt_code = 1
					end if
				end if
				setfocus()
			elseif key = keyf7! then
				if not isnull(getitemnumber(ll_rowm, "icode")) then
					ll_icode = getitemnumber(ll_rowm, "icode")
					parent.parent.parent.id_selectionlist_req.hide()
					setredraw(true)
					ll_icode = f_prefered_itemsearch(ll_icode)
					parent.parent.parent.id_selectionlist_req.setfilter("")
					parent.parent.parent.id_selectionlist_req.filter()
					if ll_icode > 0 then
						ll_found = parent.parent.parent.id_selectionlist_req.find("code = " + string(ll_icode), 1, parent.parent.parent.id_selectionlist_req.rowcount())
						if ll_found > 0 then
							ll_listcurrrow = ll_found
							parent.parent.parent.id_selectionlist_req.selectrow(0, false)
							rt_code = 1
						end if
					end if
				end if
				setfocus()
			elseif isnull(getitemnumber(getrow(), "icode")) and key = keyenter! then
				parent.parent.parent.id_selectionlist_req.hide()
				parent.parent.parent.id_selectionlist_req.selectrow(0, false)
				parent.parent.parent.id_selectionlist_req.scrolltorow(parent.parent.parent.id_selectionlist_req.getrow())
				parent.parent.parent.id_selectionlist_req.selectrow(parent.parent.parent.id_selectionlist_req.getrow(), true)
				ll_listcurrrow = parent.parent.parent.id_selectionlist_req.getrow()
				setitem(ll_rowm, "icode", parent.parent.parent.id_selectionlist_req.getitemnumber(ll_listcurrrow, "code"))
				setitem(ll_rowm, "itemname", parent.parent.parent.id_selectionlist_req.getitemstring(ll_listcurrrow, "name"))
				selecttext(1, len(gettext()))
				parent.parent.parent.ib_itemvalidated_req = false
				parent.parent.parent.ib_rowvalidated_req = false
				setredraw(true)
			else
				setredraw(true)
			end if
			if rt_code = 1 then
				parent.parent.parent.id_selectionlist_req.selectrow(0, false)
				parent.parent.parent.id_selectionlist_req.selectrow(ll_listcurrrow, true)
				parent.parent.parent.il_itemlistfoundrow_req = ll_listcurrrow
				setitem(ll_rowm, "icode", parent.parent.parent.id_selectionlist_req.getitemnumber(ll_listcurrrow, "code"))
				setitem(ll_rowm, "itemname", parent.parent.parent.id_selectionlist_req.getitemstring(ll_listcurrrow, "name"))
				selecttext(1, len(gettext()))
				parent.parent.parent.ib_itemvalidated_req = false
				parent.parent.parent.ib_rowvalidated_req = false
				setredraw(true)
			end if
		end if
	end if
	setfocus()
	return rt_code

// dw_itemreq.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	long ll_rowcount
	ancestorreturnvalue = super::ue_enterkey()
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		if rowcount() > 0 and f_validatedw(this) < 0 then
			return ::message.returnvalue
		end if
		if parent.parent.parent.ib_rowvalidated_req = false and parent.parent.parent.wf_validateitem_req(getrow()) = -1 then
			return 1
		end if
		ll_rowcount = insertrow(0)
		if ll_rowcount > 1 then
			if f_stringpreferences("itemcode") = "N" then
				parent.parent.parent.id_selectionlist_req.show()
				setcolumn(2)
			else
				setcolumn(1)
			end if
			scrolltorow(ll_rowcount)
			setfocus()
		end if
		return 1
	end if
	if getcolumnname() = "itemname" or getcolumnname() = "fullcode" then
		parent.parent.parent.id_selectionlist_req.show()
		if parent.parent.parent.ib_itemvalidated_req = false and parent.parent.parent.wf_validateitem_req(getrow()) = -1 then
			return 1
		end if
		return
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// tabpage_issue.create() returns 0 [event]
	this.dw_issue = create dw_issue
	this.control = {this.dw_issue}

// tabpage_issue.destroy() returns 0 [event]
	destroy this.dw_issue

// dw_issue.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// tabpage_service.create() returns 0 [event]
	this.dw_service = create dw_service
	this.control = {this.dw_service}

// tabpage_service.destroy() returns 0 [event]
	destroy this.dw_service

// dw_service.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
