// w_serviceorder_form.ue_close() returns 0 [event]
	SQL stop USING this.it_transobject;
	close(this)

// w_serviceorder_form.ue_postopen() returns 0 [event]
	long ll_counter
	long ll_pos
	long ll_prow
	long ll_pcode
	integer li_rtncode
	datawindowchild ldc_headerno
	li_rtncode = this.id_svcheader.getchild("custcode", this.idc_customers)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_customers.settransobject(this.it_transobject)
	li_rtncode = this.id_svcheader.getchild("patientcode", this.idc_patient)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_patient.settransobject(this.it_transobject)
	this.idc_patient.retrieve()
	ll_prow = this.idc_patient.insertrow(0)
	setnull(ll_pcode)
	this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
	this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
	this.idc_patient.setitem(ll_prow, "name", "<NONE>")
	this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
	this.idc_patient.setitem(ll_prow, "city", "<NONE>")
	this.idc_patient.setitem(ll_prow, "patient", "<NONE>")
	this.idc_patient.scrolltorow(ll_prow)
	if f_stringpreferences("patientOnCreditSale") = "N" then
		this.id_svcheader.object.patientcode.visible = false
		this.id_svcheader.object.t_patientcode.visible = false
		this.id_svcheader.object.t_patientregno.visible = false
		this.id_svcheader.object.patientregno.visible = false
	end if
	if f_stringpreferences("itemcode") = "N" then
