// w_serviceorder_form.wf_set_interface_adjustments() returns 0
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width * 0.95
		ll_height = ll_win_height * 0.95
		this.width = ll_width
		this.height = ll_height
		this.cb_ok.y = ll_height - this.cb_ok.height - 200
		this.cb_cancel.y = ll_height - this.cb_cancel.height - 200
		this.cb_printorder.y = ll_height - this.cb_printorder.height - 200
		this.dw_netamt.y = ll_height - this.dw_netamt.height - 200
		this.tab_main.width = ll_width - 100
		this.tab_main.height = this.cb_ok.y - 50
		this.tab_main.tabpage_header.width = this.tab_main.width - 50
		this.tab_main.tabpage_header.height = this.tab_main.height - 100
		this.tab_main.tabpage_header.dw_header.width = this.tab_main.tabpage_header.width - 20
		this.tab_main.tabpage_header.dw_header.height = this.tab_main.tabpage_header.height - 100
		this.tab_main.tabpage_checklist.width = this.tab_main.width - 50
		this.tab_main.tabpage_checklist.height = this.tab_main.height - 100
		this.tab_main.tabpage_checklist.dw_checklist.width = this.tab_main.tabpage_checklist.width - 20
		this.tab_main.tabpage_checklist.dw_checklist.height = this.tab_main.tabpage_checklist.height - 100
		this.tab_main.tabpage_detail.width = this.tab_main.width - 50
		this.tab_main.tabpage_detail.height = this.tab_main.height - 100
		this.tab_main.tabpage_detail.dw_detail.width = this.tab_main.tabpage_detail.width - 20
		this.tab_main.tabpage_detail.dw_detail.height = this.tab_main.tabpage_detail.height - this.tab_main.tabpage_detail.dw_footer.height - 15
		this.tab_main.tabpage_detail.dw_footer.width = this.tab_main.tabpage_detail.width - 20
		this.tab_main.tabpage_detail.dw_footer.y = this.tab_main.tabpage_detail.height - this.tab_main.tabpage_detail.dw_footer.height - 10
		this.tab_main.tabpage_detail.dw_selectionlist.height = this.tab_main.tabpage_detail.dw_detail.height * 0.80
		this.tab_main.tabpage_detail.dw_selectionlist.width = this.tab_main.tabpage_detail.dw_detail.width * 0.80
		this.tab_main.tabpage_itemreq.width = this.tab_main.width - 50
		this.tab_main.tabpage_itemreq.height = this.tab_main.height - 100
		this.tab_main.tabpage_itemreq.dw_itemreq.width = this.tab_main.tabpage_itemreq.width - 20
		this.tab_main.tabpage_itemreq.dw_itemreq.height = this.tab_main.tabpage_itemreq.height - 100
		this.tab_main.tabpage_itemreq.dw_selection_req.height = this.tab_main.tabpage_itemreq.dw_itemreq.height * 0.80
		this.tab_main.tabpage_itemreq.dw_selection_req.width = this.tab_main.tabpage_itemreq.dw_itemreq.width * 0.80
		this.tab_main.tabpage_issue.width = this.tab_main.width - 50
		this.tab_main.tabpage_issue.height = this.tab_main.height - 100
		this.tab_main.tabpage_issue.dw_issue.width = this.tab_main.tabpage_issue.width - 20
		this.tab_main.tabpage_issue.dw_issue.height = this.tab_main.tabpage_issue.height - 100
		this.tab_main.tabpage_service.width = this.tab_main.width - 50
		this.tab_main.tabpage_service.height = this.tab_main.height - 100
		this.tab_main.tabpage_service.dw_service.width = this.tab_main.tabpage_service.width - 20
		this.tab_main.tabpage_service.dw_service.height = this.tab_main.tabpage_service.height - 100
		this.tab_main.tabpage_sale.width = this.tab_main.width - 50
		this.tab_main.tabpage_sale.height = this.tab_main.height - 100
		this.tab_main.tabpage_sale.dw_sale.width = this.tab_main.tabpage_sale.width - 20
		this.tab_main.tabpage_sale.dw_sale.height = this.tab_main.tabpage_sale.height - 100
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if

