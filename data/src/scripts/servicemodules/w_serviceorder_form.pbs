// w_serviceorder_form.wf_inititeminfo(long al_icode, long al_row, integer ai_rtcode, string as_errortext) returns boolean
	boolean retflag
	double ld_saleprice
	double ld_discperc
	double ld_flatdisc
	double ld_serviceflattax
	double ld_servicegstperc
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_allowsaleindecimal
	datetime ldt_date
	dwitemstatus ldw_status
	setnull(ls_null)
	SQL SELECT service.aliasname , service.name , service.price , service.serviceflatdisc , allowsaleindecimal , ServiceFlatTax , ServiceGSTPerc INTO :ls_fullcode, :ls_name, :ld_saleprice, :ld_flatdisc, :ls_allowsaleindecimal, :ld_serviceflattax, :ld_servicegstperc FROM service WHERE service.servicecode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Service information can not be retrieved"
	end if
	if retflag then
		this.id_svcdetail.setitem(al_row, "itemname", ls_name)
		this.id_svcdetail.setitem(al_row, "fullcode", ls_fullcode)
		this.id_svcdetail.setitem(al_row, "allowsaleindecimal", ls_allowsaleindecimal)
		ldw_status = this.id_svcdetail.getitemstatus(al_row, "saleprice", primary!)
		if this.id_svcdetail.getitemstatus(al_row, "saleprice", primary!) = notmodified! then
			this.id_svcdetail.setitem(al_row, "saleprice", ld_saleprice)
		end if
		ldw_status = this.id_svcdetail.getitemstatus(al_row, "serviceflatdisc", primary!)
		if this.id_svcdetail.getitemstatus(al_row, "serviceflatdisc", primary!) = notmodified! then
			this.id_svcdetail.setitem(al_row, "serviceflatdisc", ld_flatdisc)
		end if
		ldw_status = this.id_svcdetail.getitemstatus(al_row, "ServiceFlatTax", primary!)
		if this.id_svcdetail.getitemstatus(al_row, "ServiceFlatTax", primary!) = notmodified! then
			this.id_svcdetail.setitem(al_row, "ServiceFlatTax", ld_serviceflattax)
		end if
		ldw_status = this.id_svcdetail.getitemstatus(al_row, "ServiceGSTPerc", primary!)
		if this.id_svcdetail.getitemstatus(al_row, "ServiceGSTPerc", primary!) = notmodified! then
			this.id_svcdetail.setitem(al_row, "ServiceGSTPerc", ld_servicegstperc)
		end if
		if al_row > 1 then
			ldt_date = this.id_svcdetail.getitemdatetime(al_row - 1, "date")
			this.id_svcdetail.setitem(al_row, "date", ldt_date)
		end if
		if al_icode <> this.id_svcdetail.getitemnumber(al_row, "itemcode") then
			this.id_svcdetail.setitem(al_row, "saleprice", ld_saleprice)
			this.id_svcdetail.setitem(al_row, "serviceflatdisc", ld_flatdisc)
			this.id_svcdetail.setitem(al_row, "ServiceFlatTax", ld_serviceflattax)
			this.id_svcdetail.setitem(al_row, "ServiceGSTPerc", ld_servicegstperc)
		end if
		this.id_svcdetail.setitem(al_row, "itemcode", al_icode)
		this.id_svcdetail.setitem(al_row, "icode", al_icode)
	else
		retflag = false
		as_errortext = "Unable to offer Service."
	end if
	return retflag

// w_serviceorder_form.wf_find_service_fullcode(string as_aliasname, long al_servicecode, string as_servicename) returns long
	long ll_retflag
	setnull(al_servicecode)
	as_servicename = "                                                                  "
	this.it_transobject.getservice_aliasname(gl_usercode, as_aliasname, al_servicecode, as_servicename)
	if this.it_transobject.sqlcode = 0 then
		if isnull(al_servicecode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_serviceorder_form.wf_grandtotal() returns double
	long ll_retcode
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_serviceadvance
	double ld_invoiceadvance
	double ld_servicegstperc
	double ld_sumitemleveltaxval
	double ld_suminvleveltaxval
	double ld_totaltaxoninv
	double ld_item_req_total
	double ld_item_issue_total
	real lr_discperc
	real lr_flatdisc
	real lr_misccharges
	real lr_salestax
	real lr_itemstotal
	if this.id_svcdetail.rowcount() > 0 and this.id_svcfooter.rowcount() > 0 then
		this.id_svcdetail.accepttext()
		this.id_svcfooter.accepttext()
		lr_discperc = this.id_svcfooter.object.invdiscperc[1]
		lr_flatdisc = this.id_svcfooter.object.flatdisc[1]
		lr_misccharges = this.id_svcfooter.object.misccharges[1]
		ld_servicegstperc = this.id_svcfooter.object.serviceinvgstperc[1]
		ld_detaildwtotal = this.id_svcdetail.getitemnumber(1, "c_detaildwtotal")
		ld_grandtotal = round(ld_detaildwtotal * (1.0 - lr_discperc * 0.01) - lr_flatdisc + lr_misccharges + lr_salestax, 0)
		ld_sumitemleveltaxval = this.id_svcdetail.getitemnumber(1, "c_sumflattaxval") + this.id_svcdetail.getitemnumber(1, "c_sumgstval")
		ld_suminvleveltaxval = round((ld_detaildwtotal * (1.0 - lr_discperc * 0.01) - lr_flatdisc) * 0.01 * ld_servicegstperc, 2)
		ld_totaltaxoninv = round(ld_sumitemleveltaxval + ld_suminvleveltaxval, 0)
		ld_grandtotal = round(ld_grandtotal, 0)
		ld_grandtotal = ld_grandtotal + ld_totaltaxoninv
		this.id_svcfooter.setitem(1, "total", ld_grandtotal)
		ld_serviceadvance = 0.00
		ld_invoiceadvance = this.id_svcfooter.getitemnumber(1, "cashreceived")
		this.id_svcfooter.setitem(1, "totaladvance", ld_serviceadvance + ld_invoiceadvance)
		this.dw_netamt.retrieve()
		this.id_issue.settransobject(this.it_transobject)
		ll_retcode = this.id_issue.retrieve(this.il_code)
		if this.dw_netamt.rowcount() > 0 then
			if this.id_issue.rowcount() > 0 then
				ld_item_issue_total = this.id_issue.getitemnumber(1, "c_amount_summary")
				this.dw_netamt.object.estimatedamt[1] = ld_grandtotal + ld_item_issue_total
			else
				if this.id_itemreq.rowcount() > 0 then
					ld_item_req_total = this.id_itemreq.getitemnumber(1, "c_detaildwtotal")
				end if
				this.dw_netamt.object.estimatedamt[1] = ld_grandtotal + ld_item_req_total
			end if
		end if
	end if
	return ld_grandtotal

// w_serviceorder_form.wf_getserverdatetime(datetime ar_server_datetime, string ar_errtext) returns boolean
	datetime ldt_last_transdate
	datetime ldt_current_serverdate
	integer li_max_allow_days
	string ls_hold_serverdate
	date ld_datepart
	time lt_timepart
	ar_errtext = "Please verify Server DateTime"
	li_max_allow_days = f_numberpreferences("MaxAllowDate")
	if isnull(li_max_allow_days) then
		li_max_allow_days = 4
	end if
	SQL rollback USING sqlca;
	SQL SELECT LastTransDate INTO :ldt_last_transdate FROM ServerDate USING sqlca;
	if sqlca.sqlcode = 0 then
		sqlca.getdatetime(ldt_current_serverdate)
		ar_server_datetime = ldt_current_serverdate
		if sqlca.sqlcode = 0 then
			if ldt_current_serverdate >= ldt_last_transdate and daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) <= li_max_allow_days then
				ld_datepart = date(string(ldt_current_serverdate, "yyyy-mm-dd"))
				lt_timepart = time(string(ldt_current_serverdate, "hh:mm:ss"))
				ldt_current_serverdate = datetime(ld_datepart, lt_timepart)
				SQL update ServerDate SET LastTransDate =:ldt_current_serverdate USING sqlca;
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					ar_server_datetime = ldt_current_serverdate
					return true
				else
					SQL rollback USING sqlca;
					return false
				end if
			elseif ldt_current_serverdate < ldt_last_transdate then
				ar_errtext = "Back Date Invoice Check violates"
				return false
			elseif daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) > li_max_allow_days then
				ar_errtext = "Forward Date Invoice Check violates"
				return false
			end if
		else
			SQL rollback USING sqlca;
			ar_server_datetime = datetime(date(today()), time(today()))
			return false
		end if
		return
	end if
	SQL rollback USING sqlca;
	ar_server_datetime = datetime(date(today()), time(today()))
	return false

// w_serviceorder_form.wf_printorder() returns integer
	s_datastore lstr
	if this.ib_printorder = true then
		this.dw_print.settransobject(sqlca)
		this.dw_print.retrieve(this.il_code)
		lstr.dw = this.dw_print
		lstr.s_name1 = this.dw_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return 0
		else
			if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
				messagebox("Printer", "Printing Error")
				this.dw_print.printcancel()
			end if
			if this.dw_print.rowcount() > 0 then
				if this.dw_print.print() < 0 then
					messagebox("Printing", "Can not Print Invoice", information!)
				end if
			else
				messagebox("Printing Error", "Can not Print Data,~r~nNo rows are retrieved", information!)
			end if
		end if
	end if
	return 0

// w_serviceorder_form.wf_new_customerregisteration() returns long
	string ls_aliasname
	long ll_acccode
	long ll_found
	long ll_row
	dwobject dwo
	open(w_customer_register)
	ls_aliasname = message.stringparm
	if not (ls_aliasname = "" or isnull(ls_aliasname)) then
		wf_customer_retrieve()
		ll_found = 0
		ll_found = this.idc_customers.find("accounts_aliasname = '" + ls_aliasname + "'", 1, this.idc_customers.rowcount())
		if ll_found > 0 then
			this.id_svcheader.setitem(1, "custcode", this.idc_customers.getitemstring(ll_found, "accounts_aliasname"))
			ll_acccode = this.idc_customers.getitemnumber(ll_found, "accounts_acccode")
			this.id_svcheader.setitem(1, "custcode", ll_acccode)
			dwo = this.id_svcheader.object.custcode
			this.id_svcheader.post event itemchanged(1, dwo, string(ll_acccode))
		end if
	end if
	return 0

// w_serviceorder_form.wf_customer_retrieve() returns long
	this.idc_customers.setredraw(false)
	this.idc_customers.settransobject(this.it_transobject)
	this.idc_customers.retrieve()
	this.idc_customers.setredraw(true)
	return 0

