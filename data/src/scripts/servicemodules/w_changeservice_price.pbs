// window w_changeservice_price (servicemodules)  ancestor: w_multi_entry

// w_changeservice_price.wf_assigndatawindow(string as_masterdw, string as_detaildw, string as_listdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_list.dataobject = as_listdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)

// w_changeservice_price.wf_updatesaleprice_purprice() returns long
	long ll_rows
	long ll_counter
	double ld_value
	ll_rows = this.id_detail.rowcount()
	if ll_rows > 0 then
		openwithparm(w_set_saleprice_purchase_formula, ld_value)
		ld_value = message.doubleparm
		if ld_value > 0.0 then
			for ll_counter = 1 to ll_rows
				this.id_detail.object.price[ll_counter] = round(this.id_detail.object.costprice[ll_counter] + this.id_detail.object.costprice[ll_counter] * ld_value * 0.01, 2)
			next
		end if
	end if
	return 0

// w_changeservice_price.wf_filter_items() returns 0
	string ls_null
	setnull(ls_null)
	this.id_detail.scrolltorow(0)
	this.id_detail.setfilter(ls_null)
	this.id_detail.filter()
	this.id_detail.groupcalc()

// w_changeservice_price.wf_update_saleprice_with_saleprice() returns long
	long ll_rows
	long ll_counter
	double ld_value
	ll_rows = this.id_detail.rowcount()
	if ll_rows > 0 then
		openwithparm(w_set_saleprice_formula, ld_value)
		ld_value = message.doubleparm
		if ld_value > 0.0 then
			for ll_counter = 1 to ll_rows
				this.id_detail.object.price[ll_counter] = round(this.id_detail.object.price[ll_counter] + this.id_detail.object.price[ll_counter] * ld_value * 0.01, 2)
			next
		end if
	end if
	return 0

// w_changeservice_price.wf_validate_service_result_tempalate(long al_code) returns long
	double ld_saleprice
	double ld_costprice
	long ll_retcode
	long ll_servicecode
	long ll_servicecode_retrieve
	if this.id_detail.object.code[1] > 0 then
		ll_servicecode = this.id_detail.object.code[1]
		SQL SELECT MAX ( ServiceCode ) INTO :ll_servicecode_retrieve FROM ServiceDetail SD , ServiceResultDetail SRD WHERE SRD.ServiceResultCode =:al_code AND SRD.ServiceRowID =SD.SrvRowID AND SD.ServiceCode =:ll_servicecode USING sqlca;
		if sqlca.sqlcode = 0 then
			if ll_servicecode_retrieve > 0 and ll_servicecode_retrieve = ll_servicecode then
				ll_retcode = 0
			else
				messagebox("Service Result Validation", "The Selected Service Result Does not conatin this service.", stopsign!)
				ll_retcode = 1
			end if
		else
			messagebox("Service Result Validation", "Problem in retrieval of Service Result Information.~r~nReasons are:-" + sqlca.sqlerrtext, stopsign!)
			ll_retcode = 1
		end if
		return ll_retcode
	end if
	return 1

// w_changeservice_price.create() returns 0
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_changeservicepricemenu" then
		this.menuid = create m_changeservicepricemenu
	end if

// w_changeservice_price.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_changeservice_price.ue_detail() returns 0
	call super::ue_detail
	this.id_detail.setfilter("")
	this.id_detail.filter()
	this.id_detail.setfocus()
	this.im_menu.m_file.m_save.enabled = true

// w_changeservice_price.ue_postopen() returns 0
	string ls_dwtype
	string ls_columnname
	integer li_visiblecolumns
	integer li_counter
	integer li_taborder
	datastore lds_itemsetting
	call super::ue_postopen
	wf_assigndatawindow("d_chageserviceprice_header", "d_changeserviceprice_detail", "d_servicecategory_list")
	lds_itemsetting = create datastore
	lds_itemsetting.dataobject = "d_interfacesettingcols"
	lds_itemsetting.settransobject(this.it_transobject)
	lds_itemsetting.retrieve(41, 1, 1)
	li_visiblecolumns = lds_itemsetting.rowcount()
	for li_counter = 1 to li_counter
		ls_columnname = lds_itemsetting.getitemstring(li_counter, "colname")
		this.id_detail.modify(ls_columnname + ".Visible=1")
		li_taborder = li_taborder + 1
	next

// w_changeservice_price.ue_save() returns 0
	long ll_salesmancode
	long ll_rowcount
	long ll_counter
	datetime ldt_server_datetime
	string ls_date_errtext
	dwitemstatus lds_rowstatus
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 0 then
		ll_salesmancode = gl_usercode
		call super::ue_save
		return
	end if
	messagebox("Updataion Problem", "No rows to Update!", stopsign!)
