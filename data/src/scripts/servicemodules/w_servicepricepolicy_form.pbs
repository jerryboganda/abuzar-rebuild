// window w_servicepricepolicy_form (servicemodules)  ancestor: w_multi_entry

// w_servicepricepolicy_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM ServicePricePolicy WHERE ServicePricePolicy.name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_servicepricepolicy_form.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_temp
	string ls_colname
	string ls_rtnstring
	if not isnull(ad_dwcontrol.dataobject) then
		li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
		for li_counter = li_colcount to li_counter step -1
			ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
			if ai_doundo = 1 then
				ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
			else
				ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
			end if
		next
	end if

// w_servicepricepolicy_form.wf_duplicatealiasname(string as_name) returns boolean
	long ll_count
	boolean b_flag
	return b_flag

// w_servicepricepolicy_form.wf_populate() returns integer
	long ll_rows
	long ll_counter
	long ll_insrow
	datastore lds_days
	lds_days = create datastore
	lds_days.dataobject = "ddd_weekdays"
	lds_days.settransobject(this.it_transobject)
	lds_days.retrieve()
	ll_rows = lds_days.rowcount()
	for ll_counter = 1 to ll_rows
		ll_insrow = this.id_detail.insertrow(0)
		this.id_detail.object.weekdaycode[ll_insrow] = lds_days.object.weekdaycode[ll_counter]
		this.id_detail.object.price[ll_insrow] = 0.00
	next
	return 0

// w_servicepricepolicy_form.create() returns 0
	call super::create

// w_servicepricepolicy_form.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_servicepricepolicy_form.ue_newform() returns 0
	setredraw(false)
	this.i_editmode = 1
	this.i_retrievemode = 2
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_new.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_item.m_newitem.enabled = false
	this.im_menu.m_item.m_deleteitem.enabled = false
	this.im_menu.m_file.m_first.enabled = false
	this.im_menu.m_file.m_next.enabled = false
	this.im_menu.m_file.m_previous.enabled = false
	this.im_menu.m_file.m_last.enabled = false
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_retrieve.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.tab_retrieve.tabpage_detail.enabled = true
	if this.id_master.rowcount() > 0 then
		this.id_master.reset()
	end if
	this.ib_focusdetail = false
	this.id_master.insertrow(0)
	this.id_detail.reset()
	wf_populate()
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	setredraw(true)

// w_servicepricepolicy_form.ue_detail() returns 0
	integer li_protect
	call super::ue_detail
	this.im_menu.m_file.m_save.enabled = true

// w_servicepricepolicy_form.ue_save() returns 0
	long ll_invid
	long ll_mastercurrrow
	long ll_counter
	long ll_rows
	long ll_null
	long ll_innercounter
	boolean lb_updatedetail
	boolean lb_updatefooter
	boolean lb_commit
	boolean lb_flag
	string ls_null
	string ls_column
	setnull(ls_null)
	setnull(ll_null)
	setpointer(hourglass!)
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	ll_mastercurrrow = this.id_master.getrow()
	if isnull(this.id_master.object.name[ll_mastercurrrow]) then
		messagebox("Service Price Policy Name Validation!", "Please Enter Some Valid Service Price Policy Name")
		this.id_master.setcolumn("name")
		this.id_master.setfocus()
		return
	end if
	ll_invid = this.id_master.object.code[ll_mastercurrrow]
	if isnull(ll_invid) then
		wf_tabnewid("ServicePricePolicy", ll_invid)
		this.id_master.object.code[ll_mastercurrrow] = ll_invid
		ll_rows = this.id_detail.rowcount()
		for ll_counter = 1 to ll_rows
			this.id_detail.setitem(ll_counter, "code", ll_invid)
		next
	else
		SQL DELETE ContactPolicyDetail WHERE ContactPolicyCode =:ll_invid USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			lb_commit = false
		end if
	end if
	if lb_commit then
		if this.id_master.update(true, false) < 0 then
			SQL rollback USING this.it_transobject;
			setpointer(arrow!)
			return
		end if
		if this.id_detail.update() < 0 then
			SQL rollback USING this.it_transobject;
			setpointer(arrow!)
			return
		end if
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		this.ib_commitok = true
		this.id_master.resetupdate()
		this.im_menu.m_file.m_new.enabled = true
		this.editflag = false
		if gd_recenttransdate < this.id_systemdate then
			gd_recenttransdate = this.id_systemdate
		end if
	else
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return
	end if
	this.id_detail.reset()
	setpointer(arrow!)

// w_servicepricepolicy_form.ue_postopen() returns 0
	m_multi_entry lm_menu
	call super::ue_postopen
	lm_menu = this.menuid

// w_servicepricepolicy_form.ue_newitem() returns 0

// w_servicepricepolicy_form.ue_deleteitem() returns 0
