// window w_customergroup_form (custcomponents)  ancestor: w_multi_entry

// w_customergroup_form.wf_closelist() returns 0
	this.ib_itemslistopen = false
	this.id_itemslist.hide()

// w_customergroup_form.wf_grandtotal() returns double
	double ld_grandtotal
	ld_grandtotal = 0
	return ld_grandtotal

// w_customergroup_form.wf_initmodify(ref integer ai_protect) returns 0
	long ll_code
	long ll_gcode
	long ll_icode
	long ll_looseqty
	long ll_stock
	long ll_counter = 1
	long ll_count
	ll_code = this.id_master.getitemnumber(1, "code")
	this.id_master.retrieve(ll_code)
	this.id_detail.retrieve(ll_code)
	this.ib_modify = true
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_new.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true
	this.im_menu.m_file.m_first.enabled = false
	this.im_menu.m_file.m_next.enabled = false
	this.im_menu.m_file.m_previous.enabled = false
	this.im_menu.m_file.m_last.enabled = false
	this.im_menu.m_file.m_retrieve.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.tab_retrieve.tabpage_detail.enabled = true

// w_customergroup_form.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_customergroup_form.wf_validateitemnew() returns integer
	long ll_acccode
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	ll_acccode = this.id_detail.getitemnumber(this.il_currrow, "custcode")
	if vf_dwdupcode1(this.id_detail, "custcode", string(ll_acccode), this.il_currrow) = true then
		ls_titleerrtext = "Customer Validation"
		ls_errtext = "Duplicate Customer, please select some other Customer"
		li_errcode = -1
		messagebox(ls_titleerrtext, ls_errtext)
	elseif not wf_inititeminfo(ll_acccode, this.il_currrow, li_errcode, ls_errtext) then
		ls_titleerrtext = "Customer Validation"
		li_errcode = -2
	end if
	this.ib_itemvalidated = true
	return li_errcode

// w_customergroup_form.wf_genfullcode(long al_acccode, ref string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	SQL SELECT AliasName INTO :ls_fullcode FROM Accounts , Customer WHERE Accounts.Acccode =:al_acccode AND Accounts.AccCode =Customer.CustCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_customergroup_form.wf_findfullcode(string as_fullcode, ref long al_acccode, ref string al_accname) returns integer
	integer ll_acccode
	integer ll_retflag
	string ls_accname
	SQL SELECT Accounts.acccode , Accounts.name INTO :ll_acccode, :ls_accname FROM Accounts , Customer WHERE Accounts.aliasname =:as_fullcode AND Accounts.AccCode =Customer.CustCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_acccode = ll_acccode
		al_accname = ls_accname
		if isnull(al_acccode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_customergroup_form.wf_customerinfo(long al_custcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	double ld_currbalance
	SQL SELECT customer.address1 , customer.city , customer.phone INTO :ls_address, :ls_city, :ls_phone FROM customer WHERE customer.custcode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
	end if
	return this.it_transobject.sqlcode

// w_customergroup_form.wf_deleteemptydetailrow() returns integer
	long ll_rowcount
	integer li_rtcode
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 and isnull(this.id_detail.getitemnumber(ll_rowcount, "custcode")) then
		this.id_detail.deleterow(ll_rowcount)
		li_rtcode = 1
		this.ib_itemslistopen = false
		this.id_itemslist.hide()
		setfocus()
	end if
	return li_rtcode

// w_customergroup_form.wf_validatefullcode(string as_fullcode, long al_currrow) returns boolean
	long ll_acccode
	long ll_code
	long ll_validity_status
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_option
	boolean lb_rtflag = true
	integer li_null
	string ls_null
	ls_titleerrtext = "Customer Validation"
	if vf_dwdupcode1(this.id_detail, "acccode", string(ll_acccode), al_currrow) = true then
		ls_errtext = "Duplicate Customer, please select some other Customer"
		li_errcode = -1
	elseif not wf_inititeminfo(ll_acccode, this.il_currrow, li_errcode, ls_errtext) then
		li_errcode = -1
	end if
	if li_errcode <> 0 then
		ll_code = this.id_master.getitemnumber(this.id_master.rowcount(), "code")
		ll_validity_status = wf_isvalid_account(ll_code, ll_acccode)
		if ll_validity_status = -1 then
			ls_errtext = "Customer already selected in some other Customer Group"
			li_errcode = -1
		elseif ll_validity_status = -2 then
			ls_errtext = "Problem in Cheking Customer Validity for Customer Group"
			li_errcode = -1
		end if
	end if
	if li_errcode = -1 then
		lb_rtflag = false
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setitem(al_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(al_currrow, "custcode", li_null)
		this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	end if
	return lb_rtflag

// w_customergroup_form.wf_validateitem(boolean ab_flag) returns integer
	long ll_acccode
	long ll_code
	long ll_validity_status
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_option
	boolean ib_due
	integer li_null
	string ls_null
	ll_acccode = this.id_detail.getitemnumber(this.il_currrow, "custcode")
	ls_titleerrtext = "Customer Validation"
	if not isnull(ll_acccode) then
		if vf_dwdupcode1(this.id_detail, "custcode", string(ll_acccode), this.il_currrow) = true then
			ls_errtext = "Duplicate Customer, please select some other Customer"
			li_errcode = -1
		elseif wf_inititeminfo(ll_acccode, this.il_currrow, li_errcode, ls_errtext) and li_errcode = -2 then
			li_errcode = -1
		end if
	end if
	if li_errcode <> 0 then
		ll_code = this.id_master.getitemnumber(this.id_master.rowcount(), "code")
		ll_validity_status = wf_isvalid_account(ll_code, ll_acccode)
		if ll_validity_status = -1 then
			ls_errtext = "Customer already selected in some other Customer Group"
			li_errcode = -1
		elseif ll_validity_status = -2 then
			ls_errtext = "Problem in Cheking Customer Validity for Customer Group"
			li_errcode = -1
		end if
	end if
	if ab_flag then
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		messagebox(ls_titleerrtext, ls_errtext)
		if f_stringpreferences("itemcode") = "N" then
			this.id_detail.setcolumn(this.is_columnitemname)
			this.ib_itemslistopen = true
			this.id_itemslist.show()
		else
			this.id_detail.setcolumn("fullcode")
			this.id_detail.object.fullcode[this.il_currrow] = ls_null
		end if
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.custcode[this.il_currrow] = li_null
		this.id_detail.object.accountname[this.il_currrow] = ls_null
	end if
	return li_errcode

// w_customergroup_form.wf_refreshitemslist() returns 0
	long ll_counter
	boolean lb_enablerestricted
	long li_count
	long ll_startrow
	char lc_char
	gd_itemsinfo.reset()
	gd_itemsinfo.setfilter("")
	gd_itemsinfo.filter()
	this.id_itemslist.retrieve()
	for li_count = 65 to 90
		lc_char = char(li_count)
		ga_llookuptable[li_count] = gd_itemsinfo.find("Lower(accountname) >= Lower('" + char(li_count) + "')", ll_startrow, 99999)
		ll_startrow = ga_llookuptable[li_count]
	next
	ga_llookuptable[92] = 99999

// w_customergroup_form.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_customergroup_form.wf_inititeminfo(long al_acccode, long al_row, ref integer ai_rtcode, ref string as_errortext) returns boolean
	boolean retflag = true
	string ls_fullcode
	string ls_name
	string ls_null
	long ll_subcode
	long ll_tmp_acccode
	datetime ldt_opendate
	setnull(ls_null)
	SQL SELECT Accounts.AliasName , Accounts.name , Accounts.SubCode , Accounts.OpeningDate INTO :ls_fullcode, :ls_name, :ll_subcode, :ldt_opendate FROM Accounts WHERE Accounts.acccode =:al_acccode AND Accounts.acccode IN ( SELECT CustCode FROM Customer ) USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if retflag then
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		this.id_detail.setitem(al_row, "custcode", al_acccode)
		this.id_detail.setitem(al_row, "subcode", ll_subcode)
		ll_tmp_acccode = this.id_detail.object.acccode[al_row]
		if isnull(ll_tmp_acccode) or ll_tmp_acccode < 0 then
			ll_tmp_acccode = -1
		end if
		if al_acccode <> ll_tmp_acccode then
			this.id_detail.setitem(al_row, "openingdate", ldt_opendate)
			wf_set_customer_info(al_acccode, al_row)
		end if
		this.id_detail.object.acccode[al_row] = al_acccode
	else
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	return retflag

// w_customergroup_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM CustomerGroup WHERE CustomerGroup.name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_customergroup_form.wf_isvalid_account(long al_code, long al_acccode) returns long
	long ll_retcode
	long ll_acc_count
	return ll_retcode

// w_customergroup_form.wf_update_customer_info() returns long
	long ll_count
	long ll_counter
	integer li_areacode
	integer li_subareacode
	integer li_countycode
	integer li_custcode
	char lc_block
	string ls_address1
	string ls_address2
	decimal ld_charges
	datetime ldt_openingdate
	ll_count = this.id_detail.rowcount()
	if ll_count > 0 then
		for ll_counter = 1 to ll_count
			li_custcode = this.id_detail.object.custcode[ll_counter]
			ldt_openingdate = this.id_detail.object.openingdate[ll_counter]
			li_areacode = this.id_detail.object.areacode[ll_counter]
			li_subareacode = this.id_detail.object.subareacode[ll_counter]
			li_countycode = this.id_detail.object.countycode[ll_counter]
			ld_charges = this.id_detail.object.charges[ll_counter]
			lc_block = trim(this.id_detail.object.block[ll_counter])
			ls_address1 = trim(this.id_detail.object.address1[ll_counter])
			ls_address2 = trim(this.id_detail.object.address2[ll_counter])
			if isnull(ls_address1) then
				ls_address1 = ""
			end if
			if isnull(ls_address2) then
				ls_address2 = ""
			end if
			this.it_transobject.update_customer_info(li_custcode, li_areacode, li_subareacode, li_countycode, ls_address1, ls_address2, lc_block, ld_charges, ldt_openingdate)
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Customer Update Problem", "Problem in updating Customer Information~r~nDetails are:-~r~n" + this.it_transobject.sqlerrtext + "~r~nSQLDBCode = " + string(this.it_transobject.sqldbcode) + "~r~nSQLReturnData = " + string(this.it_transobject.sqlreturndata) + "~r~nSQLNRows = " + string(this.it_transobject.sqlnrows), stopsign!)
				return -1
			end if
		next
	end if
	return 0

// w_customergroup_form.wf_set_customer_info(long al_custcode, long al_row) returns long
	string ls_address1
	string ls_address2
	char lc_block
	double ld_charges
	long ll_areacode
	long ll_subareacode
	long ll_countycode
	datetime ldt_opendate
	SQL SELECT Address1 , Address2 , Block , Charges , AreaCode , SubAreaCode , CountyCode INTO :ls_address1, :ls_address2, :lc_block, :ld_charges, :ll_areacode, :ll_subareacode, :ll_countycode FROM Customer WHERE CustCode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_detail.object.address1[al_row] = ls_address1
		this.id_detail.object.address2[al_row] = ls_address2
		this.id_detail.object.block[al_row] = lc_block
		this.id_detail.object.areacode[al_row] = ll_areacode
		this.id_detail.object.subareacode[al_row] = ll_subareacode
		this.id_detail.object.countycode[al_row] = ll_countycode
		this.id_detail.object.charges[al_row] = ld_charges
		return 0
	end if
	return -1

// w_customergroup_form.wf_populatecustomer() returns integer
	long ll_rows
	long ll_counter
	long ll_popcount
	long ll_insrow
	long ll_custcode
	string ls_type
	integer li_retcode
	string ls_errortext
	s_arguements lst_arg
	datastore lds_populate
	open(w_select_populate_customer)
	ls_type = message.stringparm
	if ls_type = "A" then
		open(w_arg_areas)
	elseif ls_type = "S" then
		open(w_arg_subareas)
	elseif ls_type = "C" then
		open(w_arg_citycounty)
	elseif ls_type = "T" then
		open(w_arg_custcategories)
	elseif ls_type = "P" then
		open(w_arg_salesman)
	elseif ls_type = "O" then
		open(w_arg_sdate_ldate)
	end if
	lst_arg = message.powerobjectparm
	if lst_arg.i_status = 1 then
		if ls_type = "O" then
			lst_arg.ia_integerlist[1] = -1
		end if
		lds_populate = create datastore
		lds_populate.dataobject = "d_populatecustomers_criteria"
		lds_populate.settransobject(this.it_transobject)
		lds_populate.retrieve(ls_type, lst_arg.ia_integerlist, lst_arg.d_sdate, lst_arg.d_edate)
		ll_popcount = lds_populate.rowcount()
		if lds_populate.rowcount() > 0 then
			ll_rows = this.id_detail.rowcount()
			do while ll_rows > 0 and ll_rows > 0
				this.id_detail.setrow(0)
				triggerevent("ue_deleteitem")
				ll_rows = ll_rows - 1
			loop
			for ll_counter = 1 to ll_popcount
				ll_insrow = this.id_detail.insertrow(0)
				if ll_insrow > 0 then
					ll_custcode = lds_populate.object.custcode[ll_counter]
					if wf_inititeminfo(ll_custcode, ll_insrow, li_retcode, ls_errortext) = false then
						messagebox("Customer Population Error", "Error Occurred in Customer Population.~r~nDetails are:-~r~n" + ls_errortext)
						return 0
					end if
					return
				end if
			next
		end if
	end if
	if ll_insrow > 0 then
		this.editflag = true
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_save.visible = true
	end if
	return 0

// w_customergroup_form.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_custgroupmenu" then
		this.menuid = create m_custgroupmenu
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	this.dw_saleinvdetail = create dw_saleinvdetail
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.dw_saleinvdetail

// w_customergroup_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.dw_saleinvdetail

// w_customergroup_form.ue_save() returns 0 [event]
	long ll_detailrows
	long ll_counter
	long ll_count
	long ll_salesmancode
	long ll_mastercurrrow
	long li_maxretcode
	long ll_invid
	long ll_null
	string ls_date_errtext
	string ls_mod
	string ls_err
	datetime ldt_server_datetime
	boolean lb_commitflag = true
	boolean lb_continue = true
	integer li_counter
	string ls_errtext
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	setpointer(hourglass!)
	ll_salesmancode = gl_usercode
	if ll_salesmancode > 0 then
		setpointer(hourglass!)
		ll_mastercurrrow = this.id_master.getrow()
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		this.id_master.object.usercode[ll_mastercurrrow] = ll_salesmancode
		if isnull(ll_invid) then
			li_maxretcode = wf_tabnewid("CustomerGroup", ll_invid)
			if li_maxretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~nGenerating Customer Group Code")
				return
			end if
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
		end if
		ll_detailrows = this.id_detail.rowcount()
		for ll_counter = 1 to ll_detailrows
			this.id_detail.setitem(ll_counter, "code", ll_invid)
		next
		if this.id_master.update(true, false) < 0 then
			SQL rollback USING this.it_transobject;
			setpointer(arrow!)
			return
		end if
		if this.id_detail.update() > 0 then
			if wf_update_customer_info() = 0 then
				SQL commit USING this.it_transobject;
				messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
				this.ib_commitok = true
				this.id_master.resetupdate()
				this.im_menu.m_file.m_new.enabled = true
				this.editflag = false
				if gd_recenttransdate < this.id_systemdate then
					gd_recenttransdate = this.id_systemdate
				end if
			else
				SQL rollback USING this.it_transobject;
				setpointer(arrow!)
			end if
		else
			SQL rollback USING this.it_transobject;
			setpointer(arrow!)
			return
		end if
		if this.ib_commitok then
			this.ib_modify = false
		elseif this.ib_modify = false then
			setnull(ll_null)
			this.id_master.setitem(1, "Code", ll_null)
			this.id_master.accepttext()
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_customergroup_form.ue_newform() returns 0 [event]
	integer rtncode
	long li_fetched_code
	long row
	long ll_manfcode
	setredraw(false)
	call super::ue_newform
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_post.enabled = false
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.ib_modify = false
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	this.id_itemslist.dataobject = "ddd_allcustomerlist"
	this.id_itemslist.settransobject(sqlca)
	this.id_itemslist.retrieve()
	setredraw(true)

// w_customergroup_form.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect = 1
	long ll_row
	long ll_code
	long ll_deptcode
	long ll_rowcount
	boolean lb_flag
	boolean lb_modify
	m_custgroupmenu lm_menu
	call super::ue_detail
	lm_menu = this.menuid
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_print.enabled = false
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	li_protect = 0
	wf_initmodify(li_protect)
	wf_grandtotal()
	if this.id_detail.rowcount() > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setredraw(true)

// w_customergroup_form.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.ib_validatefullcode = true

// w_customergroup_form.ue_deleteitem() returns 0 [event]
	long ll_row
	long ll_footerrow
	call super::ue_deleteitem
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() <= 0 then
		this.im_menu.m_file.m_print.enabled = false
		this.im_menu.m_file.m_save.enabled = false
	end if

// w_customergroup_form.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	return ::message.returnvalue

// w_customergroup_form.ue_list() returns 0 [event]
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_print.enabled = false
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	wf_retrievelist()

// w_customergroup_form.ue_print() returns 0 [event]
	call super::ue_print

// w_customergroup_form.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_customergroup_form.ue_postopen() returns 0 [event]
	m_custgroupmenu lm_menu
	integer li_rtncode
	long ll_counter
	long ll_pos
	long ll_startrow
	char lc_char
	call super::ue_postopen
	setredraw(false)
	this.is_columnitemname = "accountname"
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	this.id_itemslist.dataobject = "ddd_allcustomerlist"
	this.id_itemslist.settransobject(sqlca)
	this.id_itemslist.retrieve()
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	for ll_counter = 65 to 90
		lc_char = char(ll_counter)
		this.ia_llookuptable[ll_counter] = this.id_itemslist.find("Lower(accountname) >= Lower('" + char(ll_counter) + "')", ll_startrow, 99999)
		ll_startrow = this.ia_llookuptable[ll_counter]
	next
	this.ia_llookuptable[92] = 99999
	li_rtncode = this.id_detail.getchild("subareacode", this.idc_subarea)
	if li_rtncode = -1 then
		messagebox("Datawindow child Error", "Can not get datawindow child", stopsign!)
		close(this)
		return
	end if
	this.idc_subarea.settransobject(this.it_transobject)
	this.idc_subarea.retrieve()
	this.id_detail.settransobject(this.it_transobject)
	setredraw(true)

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	return ::message.returnvalue

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
	case "flatdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	end choose
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_code
	long ll_detailrows
	long ll_suppcode
	long ll_custcode
	long ll_counter
	long ll_customerbalance
	long ll_headerinvno
	integer rt_code
	long ll_icode
	long ld_saleprice1
	long ld_saleprice2
	long ld_saleprice3
	long ld_avgprice
	long li_packunits
	long ll_null
	string ls_result
	string ls_null
	datetime ld_currdate
	date ld_datepart
	time lt_timepart
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "name"
		if parent.parent.parent.wf_duplicatename(data) then
			messagebox("Name Validation", "Duplicate Customer Name Error~n~rPlease Choose Some Other Customer Name")
			return 1
		end if
		return rt_code
	end choose
	return rt_code

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "aliasname"
		messagebox("Alias Name Validation", "Please enter valid Alias Name")
	case "name"
		messagebox("Customer Name Validation", "You must select some valid Customer")
	end choose
	return 1

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	long ll_newqty
	long ll_storedqty
	long ll_stock
	long ll_null
	long ll_icode
	long ll_gcode
	string ls_null
	string ls_customername
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.id_detail.setitem(row, "custcode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "acccode"))
		parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		li_errcode = 0
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_customername)
			if li_res > 0 then
				setitem(row, "custcode", ll_icode)
				setitem(row, "accountname", ls_customername)
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
			else
				messagebox("Customer Validation", "Customer does not exist")
				setitem(row, "custcode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_errcode = 1
			end if
		else
			setitem(row, "custcode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_errcode = 2
		end if
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(false) = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "accountname" then
		parent.parent.parent.ib_focusdetail = true
	elseif dwo.name = "subareacode" and row > 0 then
		if parent.parent.parent.id_detail.object.areacode[row] > 0 then
			parent.parent.parent.idc_subarea.setfilter("areacode = " + string(parent.parent.parent.id_detail.object.areacode[row]))
			parent.parent.parent.idc_subarea.filter()
		else
			parent.parent.parent.idc_subarea.setfilter("")
			parent.parent.parent.idc_subarea.filter()
		end if
	end if
	parent.parent.parent.wf_grandtotal()
	parent.parent.parent.editflag = true
	selecttext(1, len(gettext()))
	if dwo.name = parent.parent.parent.is_columnitemname then
		if isnull(getitemnumber(row, "custcode")) and parent.parent.parent.ib_focusdetail then
			parent.parent.parent.wf_showlist(getitemnumber(row, "CurrListRow"))
		end if
	else
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
	end if
	return 0

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(true) = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "fullcode"
		if data = "" or isnull(data) then
		end if
	case parent.parent.parent.is_columnitemname
		if data = "" or isnull(data) then
			messagebox("Customer Validation", "Value required for current row")
		end if
	end choose
	return 1

// dw_itemsdetail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	long ancestorreturnvalue
	if f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	return ::message.returnvalue

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ll_currrow
	long ll_startrow
	long ll_endrow
	if parent.parent.parent.editflag = false then
		parent.parent.parent.editflag = true
		parent.parent.parent.im_menu.m_file.m_save.enabled = true
	end if
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		if upper(left(data, 1)) >= "A" and upper(left(data, 1)) <= "Z" or left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
			ll_currrow = 1
			if len(data) > 1 then
				ll_startrow = ll_currrow
			else
				if left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
					ll_startrow = 1
				else
					ll_startrow = parent.parent.parent.ia_llookuptable[asc(upper(data))]
				end if
				parent.parent.parent.ib_bkspace = false
			end if
			if parent.parent.parent.ib_bkspace then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.find("Lower(accountname) <= '" + lower(data) + "'", ll_startrow, 0)
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.il_itemlistfoundrow + 1
				parent.parent.parent.ib_bkspace = false
			else
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.find("Lower(accountname) >= '" + lower(data) + "'", ll_startrow, 99999)
			end if
			if parent.parent.parent.il_itemlistfoundrow = 0 then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.rowcount()
			end if
			if parent.parent.parent.il_itemlistfoundrow <> ll_currrow then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.setrow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_itemslist.scrolltorow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_itemslist.selectrow(parent.parent.parent.il_itemlistfoundrow, true)
				ll_endrow = setitem(row, "currlistrow", parent.parent.parent.il_itemlistfoundrow)
				ll_endrow = getitemnumber(row, "currlistrow")
				setfocus()
			end if
		end if
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	end choose
	return ::message.returnvalue

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_icode
	long ll_found
	long ll_rowm
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(99999)
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(1)
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf4! then
			parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "accountname"))
			setitem(ll_rowm, "custcode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "acccode"))
			setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	elseif key = keydownarrow! then
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_focusfooter")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	end if
	return rt_code

// dw_itemslist.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ll_rowmain
	string s_str
	string s_t
	integer i_len
	if row > 0 then
		ll_rowmain = parent.parent.parent.id_detail.getrow()
		if ll_rowmain = 0 then
			ll_rowmain = parent.parent.parent.id_detail.rowcount()
		end if
		parent.parent.parent.id_detail.setitem(ll_rowmain, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(row, parent.parent.parent.is_columnitemname))
		parent.parent.parent.id_detail.setitem(ll_rowmain, "custcode", parent.parent.parent.id_itemslist.getitemnumber(row, "acccode"))
		parent.parent.parent.id_detail.setitem(ll_rowmain, "fullcode", parent.parent.parent.id_itemslist.getitemstring(row, "fullcode"))
		parent.parent.parent.id_detail.selecttext(1, len(gettext()))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = ll_rowmain
		selectrow(0, false)
		selectrow(row, true)
	end if
	s_str = string(dwo.name)
	s_t = right(s_str, 2)
	if s_t = "_t" then
		i_len = len(s_str)
		s_str = left(s_str, i_len - 2)
		if this.s_previous <> s_str then
			this.b_flag = true
		end if
		if this.b_flag = true then
			setsort(s_str)
			sort()
			this.b_flag = false
		else
			setsort(s_str + " D")
			sort()
			this.b_flag = true
		end if
	end if
	this.s_previous = s_str
	return ::message.returnvalue
