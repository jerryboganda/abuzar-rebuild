// window w_customer_assoc_godown_form (custcomponents)  ancestor: w_multi_entry

// w_customer_assoc_godown_form.wf_validategodown() returns integer
	long ll_gcode
	integer li_errcode
	integer li_gcode
	ll_gcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	if vf_dwdupcode1(this.id_detail, "gcode", string(ll_gcode), this.il_currrow) = true then
		messagebox("Duplicate Godown", "Godown has already been selected")
		li_errcode = -1
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		setnull(li_gcode)
		this.id_detail.setcolumn("gcode")
		this.id_detail.setitem(this.il_currrow, "gcode", li_gcode)
		this.id_detail.scrolltorow(this.il_currrow)
	end if
	return li_errcode

// w_customer_assoc_godown_form.create() returns 0 [event]
	call super::create

// w_customer_assoc_godown_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_customer_assoc_godown_form.ue_save() returns 0 [event]
	long ll_counter
	long ll_code
	long ll_gcode
	long ll_count
	string ls_name
	setpointer(hourglass!)
	if this.id_detail.rowcount() > 0 and isnull(this.id_detail.object.gcode[this.id_detail.rowcount()]) then
		this.id_detail.deleterow(this.id_detail.rowcount())
	end if
	if this.ib_itemvalidated = false and wf_validategodown() = -1 then
		return
	end if
	ll_code = this.id_master.getitemnumber(this.id_master.getrow(), "code")
	if isnull(ll_code) or ll_code = 0 then
		messagebox("Customer Validation", "Please Select a valid customer form list tab.", stopsign!)
		return
	end if
	for ll_counter = 1 to this.id_detail.rowcount()
		this.id_detail.setitem(ll_counter, "code", ll_code)
		ll_gcode = this.id_detail.object.gcode[ll_counter]
		SQL SELECT ISNULL ( Count ( *) , 0 ) INTO :ll_count FROM AccountGodown WHERE AccCode <> :ll_code AND GCode =:ll_gcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if ll_count > 0 then
				SQL SELECT ISNULL ( MAX ( A.Name ) , '' ) INTO :ls_name FROM AccountGodown AG , Accounts A WHERE AG.AccCode <> :ll_code AND AG.GCode =:ll_gcode AND AG.AccCode =A.AccCode USING this.it_transobject;
				if ls_name = "" or isnull(ls_name) then
					messagebox("Godown Validation", "Selected Godown is being used for some other customer.", stopsign!)
				else
					messagebox("Godown Validation", "Selected Godown is being used for some other customer.~r~nCustomer Name = " + ls_name, stopsign!)
				end if
				this.id_detail.scrolltorow(ll_counter)
				return
			end if
		else
			return
		end if
	next
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if this.id_detail.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		messagebox("Save Changes Fail", "Changes do not take effect in database~n~r Some database problem occur", exclamation!, ok!, 1)
		setpointer(arrow!)
	else
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		this.ib_commitok = true
		this.id_detail.resetupdate()
		this.im_menu.m_file.m_new.enabled = true
		this.editflag = false
	end if
	setpointer(arrow!)

// w_customer_assoc_godown_form.ue_newform() returns 0 [event]
	call super::ue_newform
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true
	this.id_master.setfocus()

// w_customer_assoc_godown_form.ue_newitem() returns 0 [event]
	if this.ib_itemvalidated = false and wf_validategodown() = -1 then
		return
	end if
	call super::ue_newitem

// w_customer_assoc_godown_form.ue_detail() returns 0 [event]
	long ll_code
	long ll_rowcount
	call super::ue_detail
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.im_menu.m_file.m_print.enabled = true
	this.i_editmode = 2
	this.i_retrievemode = 2
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	this.id_dwcontrol = this.id_master
	ll_rowcount = wf_retrieve(ll_code)
	this.id_dwcontrol = this.id_detail
	wf_retrieve(ll_code)
	this.id_detail.setrow(1)
	this.id_detail.scrolltorow(1)
	this.id_detail.setcolumn("gcode")
	this.id_detail.setfocus()
	this.id_dwcontrol = this.id_list
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_new.visible = false
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true

// w_customer_assoc_godown_form.ue_postopen() returns 0 [event]
	call super::ue_postopen
	this.id_detail.getchild("gcode", this.idc_cat)
	this.idc_cat.settransobject(this.it_transobject)

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	string ls_managername
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "icatcode"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_itemvalidated = false
		li_errcode = 0
	case else
		parent.parent.parent.ib_itemvalidated = true
	end choose
	return li_errcode

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "icatcode"
		if data = "" or isnull(data) then
			messagebox("Item Category Validation", "Value required for Item Category in current row")
		end if
	end choose
	return 1

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validategodown() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	return ::message.returnvalue
