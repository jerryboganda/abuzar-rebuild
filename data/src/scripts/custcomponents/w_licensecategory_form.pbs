// window w_licensecategory_form (custcomponents)  ancestor: w_single_entry

// w_licensecategory_form.ue_newform() returns 0 [event]
	call super::ue_newform

// w_licensecategory_form.create() returns 0 [event]
	call super::create

// w_licensecategory_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_licensecategory_form.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_licensecategory_form.ue_save() returns 0 [event]
	long ll_primarykey
	long ll_row
	setpointer(hourglass!)
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	ll_row = this.id_detail.getrow()
	if this.id_detail.update() > 0 then
		SQL commit USING sqlca;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		this.ib_commitok = true
		this.im_menu.m_file.m_new.enabled = true
		this.editflag = false
	else
		SQL rollback USING sqlca;
		setpointer(arrow!)
		messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs", exclamation!, ok!, 1)
		return
	end if
	setpointer(arrow!)

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	string ls_region
	string ls_name
	long ll_count
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "name"
		ls_region = lower(trim(data))
		SQL Select count ( *) INTO :ll_count From Region Where Region.name =:ls_region USING sqlca;
		if sqlca.sqlcode <> 0 then
			messagebox("Database Error", "Some database request has been fail")
			rt_code = 1
		elseif not isnull(ll_count) and ll_count > 0 then
			messagebox("Name Validation", "Name " + ls_name + " already exist~r~nEnter some differnt name")
			rt_code = 1
		end if
	end choose
	return rt_code

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "name"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	end choose
	return 1
