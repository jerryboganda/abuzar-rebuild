// window w_customer_guaranteeperson_search (custcomponents)  ancestor: window

// w_customer_guaranteeperson_search.ue_keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		post event ue_close()
	end if
	return ::message.returnvalue

// w_customer_guaranteeperson_search.ue_close() returns 0
	closewithreturn(this, this.istr_arg)

// w_customer_guaranteeperson_search.wf_assigndwobjects(string as_masterdw, string as_detaildw, string as_footerdw) returns 0
	this.dw_master.dataobject = as_masterdw
	this.dw_detail.dataobject = as_detaildw
	this.dw_footer.dataobject = as_footerdw
	this.dw_master.settransobject(sqlca)
	this.dw_detail.settransobject(sqlca)
	this.dw_footer.settransobject(sqlca)

// w_customer_guaranteeperson_search.wf_search(string as_colname, long al_code) returns long
	long ll_gcode
	long ll_custcode
	long ll_null
	long ll_found
	long ll_counter
	string ls_manflist
	string ls_filter
	this.dw_master.accepttext()
	setnull(ll_null)
	if lower(as_colname) = "custcode" then
		ll_custcode = al_code
		ll_gcode = this.dw_master.object.guaranteepersoncode[1]
	else
		ll_custcode = this.dw_master.object.custcode[1]
		ll_gcode = al_code
	end if
	if isnull(ll_custcode) or ll_custcode <= 0 then
		if isnull(ll_gcode) or ll_gcode <= 0 then
			ls_filter = ""
		else
			ls_filter = "guaranteepersoncode = " + trim(string(ll_gcode))
		end if
	elseif isnull(ll_gcode) or ll_gcode = 0 then
		ls_filter = "custcode =  " + trim(string(ll_custcode))
	else
		ls_filter = "custcode =  " + trim(string(ll_custcode)) + " and guaranteepersoncode = " + trim(string(ll_gcode))
	end if
	this.dw_detail.setfilter(ls_filter)
	this.dw_detail.filter()
	return 0

// w_customer_guaranteeperson_search.create() returns 0
	this.cb_cancel = create cb_cancel
	this.dw_footer = create dw_footer
	this.dw_master = create dw_master
	this.cb_retrieve = create cb_retrieve
	this.cb_ok = create cb_ok
	this.dw_detail = create dw_detail
	this.control = {this.cb_cancel, this.dw_footer, this.dw_master, this.cb_retrieve, this.cb_ok, this.dw_detail}

// w_customer_guaranteeperson_search.destroy() returns 0
	destroy this.cb_cancel
	destroy this.dw_footer
	destroy this.dw_master
	destroy this.cb_retrieve
	destroy this.cb_ok
	destroy this.dw_detail

// w_customer_guaranteeperson_search.open() returns long
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_custcode
	long ll_retcode
	long ll_suppcode
	long ll_btn_start
	string ls_date
	this.istr_arg = message.powerobjectparm
	setnull(ll_suppcode)
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		this.width = ll_win_width * 0.98
		this.height = ll_win_height * 0.95
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	this.dw_master.width = this.width * 0.98
	this.dw_detail.width = this.width * 0.98
	this.dw_detail.height = this.height * 0.82
	ll_btn_start = (this.width - (this.cb_ok.width + this.cb_cancel.width + this.cb_retrieve.width + 40)) / 2.0
	this.cb_ok.y = this.height * 0.90
	this.cb_cancel.y = this.height * 0.90
	this.cb_retrieve.y = this.height * 0.90
	this.cb_ok.x = ll_btn_start
	ll_btn_start = ll_btn_start + this.cb_ok.width + 20
	this.cb_cancel.x = ll_btn_start
	ll_btn_start = ll_btn_start + this.cb_cancel.width + 20
	this.cb_retrieve.x = ll_btn_start
	wf_assigndwobjects("d_cust_guaranteeperson_search", "d_instsale_cust_guaranteeperson_search", "")
	this.dw_master.insertrow(0)
	this.dw_master.scrolltorow(0)
	this.dw_detail.retrieve()
	this.dw_master.setcolumn("custcode")
	this.dw_master.setfocus()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_cancel.clicked() returns long
	parent.istr_arg.i_closemode = 1
	parent.post event ue_close()
	return ::message.returnvalue

// dw_master.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_master.itemchanged(long row, dwobject dwo, string data) returns long
	long ancestorreturnvalue
	long ll_code
	long ll_retcode
	string ls_null
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "custcode", "guaranteepersoncode"
		ll_code = long(data)
		parent.wf_search(dwo.name, ll_code)
		return 0
	end choose
	return ll_retcode

// cb_retrieve.clicked() returns long
	parent.dw_detail.retrieve()
	return ::message.returnvalue

// cb_ok.clicked() returns long
	parent.istr_arg.i_closemode = 0
	parent.post event ue_close()
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
