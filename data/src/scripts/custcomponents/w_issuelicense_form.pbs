// dw_customer.itemchanged(long row, dwobject dwo, string data) returns long
	long ll_null
	choose case dwo.name
	case "customer_fullname"
		if data = "" or isnull(data) or len(data) = 0 then
			messagebox("Full Name Validation", "Please enter fulll customer name")
			return 1
		end if
	case "customer_issuedlicenseno"
		if data = "" or isnull(data) or len(data) = 0 then
			return 1
		end if
	case "customer_areacode"
		setnull(ll_null)
		parent.parent.parent.id_customer.setitem(1, "customer_subareacode", ll_null)
		if parent.parent.parent.idc_subarea.setfilter("areacode=" + data) = 1 then
			parent.parent.parent.idc_subarea.setredraw(false)
			parent.parent.parent.idc_subarea.filter()
			parent.parent.parent.idc_subarea.setredraw(true)
		else
			messagebox("Sub Area Filter", "Unable to filter Sub Area Column")
			return 1
		end if
		return
	end choose
	return 0

