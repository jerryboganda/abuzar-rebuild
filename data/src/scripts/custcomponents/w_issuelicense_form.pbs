// tabpage_license.create() returns 0
	this.dw_lic = create dw_lic
	this.control = {this.dw_lic}

// tabpage_license.destroy() returns 0
	destroy this.dw_lic

// dw_lic.ue_enterkey() returns long
	long ll_rowcount
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		if rowcount() > 0 and f_validatedw(this) < 0 then
			return ::message.returnvalue
		end if
		ll_rowcount = insertrow(0)
		if ll_rowcount > 1 then
			scrolltorow(ll_rowcount)
			setcolumn("validfrom")
			setfocus()
		end if
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_lic.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	long ll_rowcount
	if keyflags = 2 then
		if key = keyi! then
			if rowcount() > 0 and f_validatedw(this) < 0 then
				return ::message.returnvalue
			end if
			ll_rowcount = insertrow(0)
			if ll_rowcount > 1 then
				scrolltorow(ll_rowcount)
				setfocus()
			end if
		end if
		if key = keyd! then
			if rowcount() > 0 then
				deleterow(0)
			end if
			ll_rowcount = rowcount()
			if ll_rowcount > 1 then
				scrolltorow(ll_rowcount)
				setfocus()
			end if
		end if
	end if
	return ::message.returnvalue

// dw_lic.itemerror(long row, dwobject dwo, string data) returns long
	choose case dwo.name
	case "validfrom"
		if data = "" or isnull(data) then
			messagebox("License Start Date Validation", "Value required for License Start Date in current row")
		elseif datetime(data) > this.object.validupto[row] then
			messagebox("License Start Date Validation", "License Start Date must be lesss than End Date in current row")
		end if
	case "validupto"
		if data = "" or isnull(data) then
			messagebox("License End Date Validation", "Value required for License End Date in current row")
		elseif datetime(data) < this.object.validfrom[row] then
			messagebox("License End Date Validation", "License End Date can not be lesss than Start Date in current row")
		end if
	end choose
	return 1

// dw_lic.itemchanged(long row, dwobject dwo, string data) returns long
	date ld_dt
	time lt_tm
	choose case dwo.name
	case "validfrom"
		ld_dt = date(left(data, 10))
		lt_tm = time(mid(data, 12, 20))
		if data = "" or isnull(data) then
			return 1
		elseif datetime(ld_dt, lt_tm) > this.object.validupto[row] then
			return 1
		else
			return 0
		end if
	case "validupto"
		ld_dt = date(left(data, 10))
		lt_tm = time(mid(data, 12, 20))
		if data = "" or isnull(data) then
			return 1
		elseif datetime(ld_dt, lt_tm) < this.object.validupto[row] then
			return 1
		else
			return 0
		end if
	case else
		return 0
	end choose
	return 0

// dw_lic.getfocus() returns long
	setcolumn("validfrom")
	setfocus()
	return ::message.returnvalue
