// tabpage_qp.destroy() returns 0
	destroy this.dw_qp

// dw_qp.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	long ll_rowcount
	if keyflags = 2 then
		if key = keyi! then
			if getrow() > 0 and rowcount() > 0 and parent.parent.parent.wf_validate_qp() = -1 then
				return ::message.returnvalue
			end if
			if parent.parent.parent.id_cust_qp.rowcount() > 0 and f_validatedw(parent.parent.parent.id_cust_qp) < 0 then
				return ::message.returnvalue
			end if
			ll_rowcount = parent.parent.parent.id_cust_qp.insertrow(0)
			if ll_rowcount > 1 then
				parent.parent.parent.id_cust_qp.scrolltorow(ll_rowcount)
				parent.parent.parent.id_cust_qp.setfocus()
			end if
		end if
		if key = keyd! then
			if parent.parent.parent.id_cust_qp.rowcount() > 0 then
				parent.parent.parent.id_cust_qp.deleterow(0)
			end if
			ll_rowcount = parent.parent.parent.id_cust_qp.rowcount()
			if ll_rowcount > 1 then
				parent.parent.parent.id_cust_qp.scrolltorow(ll_rowcount)
				parent.parent.parent.id_cust_qp.setfocus()
			end if
		end if
	end if
	return ::message.returnvalue

// dw_qp.ue_enterkey() returns long
	long ll_rowcount
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		if parent.parent.parent.id_cust_qp.rowcount() > 0 and f_validatedw(parent.parent.parent.id_cust_qp) < 0 then
			return ::message.returnvalue
		end if
		if getrow() > 0 and parent.parent.parent.wf_validate_qp() = -1 then
			return 1
		end if
		ll_rowcount = parent.parent.parent.id_cust_qp.insertrow(0)
		if ll_rowcount > 1 then
			parent.parent.parent.id_cust_qp.scrolltorow(ll_rowcount)
			parent.parent.parent.id_cust_qp.setfocus()
		end if
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

