// window w_loyaltyadjustment (custcomponents)  ancestor: w_single_entry

// w_loyaltyadjustment.wf_validate_loyaltycard(string as_id) returns long
	long ll_retcode
	long ll_acccode
	long ll_loyaltycardcode
	long ll_loyaltypolicycode
	string ls_loyaltycardid
	string ls_aliasname
	string ls_name
	double ld_pointsbalance
	double ld_pointsvaluebalance
	as_id = trim(as_id)
	SQL SELECT L.LoyaltyCardCode , L.LoyaltyCardID , L.AccCode , L.LoyaltyPolicyCode , AliasName =A.AliasName , Name =A.Name , PointsBalance =ISNULL ( ( SELECT SUM ( LCL.PointsDebit - LCL.PointsCredit ) FROM LoyaltyCardLedger LCL WHERE LCL.LoyaltyCardCode =L.LoyaltyCardCode ) , 0 ) , PointsValueBalance =ISNULL ( ( SELECT SUM ( LCL.Debit - LCL.Credit ) FROM LoyaltyCardLedger LCL WHERE LCL.LoyaltyCardCode =L.LoyaltyCardCode ) , 0 ) INTO :ll_loyaltycardcode, :ls_loyaltycardid, :ll_acccode, :ll_loyaltypolicycode, :ls_aliasname, :ls_name, :ld_pointsbalance, :ld_pointsvaluebalance FROM LoyaltyCard L , Accounts A WHERE L.LoyaltyCardID =:as_id AND L.ExpiryDate >= GETDATE ( ) AND L.AccCode =A.AccCode USING sqlca;
	if sqlca.sqlcode = 0 then
		this.id_detail.object.loyaltycardid[1] = ls_loyaltycardid
		this.id_detail.object.loyaltycardcode[1] = ll_loyaltycardcode
		this.id_detail.object.loyaltypolicycode[1] = ll_loyaltypolicycode
		this.id_detail.object.pointsbalance[1] = ld_pointsbalance
		this.id_detail.object.aliasname[1] = ls_aliasname
		this.id_detail.object.accountname[1] = ls_name
		ll_retcode = 0
	else
		ll_retcode = 1
	end if
	return ll_retcode

// w_loyaltyadjustment.wf_setprintout() returns long
	this.id_print.dataobject = "d_loyaltyadjustment_print_thermal"
	return 0

// w_loyaltyadjustment.wf_validate_adjustmentpoints(long al_policycode, long al_points) returns long
	double ld_pointsvalue
	long ll_retcode
	long ll_points
	ll_retcode = 0
	ld_pointsvalue = 0
	SQL SELECT LoyaltyPoints =A.LoyaltyPoints , PointsValue =A.RedemptionValue INTO :ll_points, :ld_pointsvalue FROM ( SELECT LoyaltyPoints =MAX ( D.LoyaltyPoints ) , RedemptionValue =MAX ( D.RedemptionValue ) FROM LoyaltyPolicyDetail D , ( SELECT LoyaltyPoints =MIN ( LoyaltyPoints ) FROM LoyaltyPolicyDetail WHERE LoyaltyPolicyCode =:al_policycode AND LoyaltyPoints >= :al_points UNION SELECT LoyaltyPoints =MAX ( LoyaltyPoints ) FROM LoyaltyPolicyDetail WHERE LoyaltyPolicyCode =:al_policycode AND LoyaltyPoints <= :al_points ) T WHERE D.LoyaltyPolicyCode =:al_policycode AND D.LoyaltyPoints =T.LoyaltyPoints AND T.LoyaltyPoints <= :al_points ) A USING sqlca;
	if sqlca.sqlcode = 0 then
		this.id_detail.object.adjustmentvalue[1] = round(ld_pointsvalue, 2)
		ll_retcode = 0
	else
		ll_retcode = 1
	end if
	return ll_retcode

// w_loyaltyadjustment.create() returns 0
	call super::create

// w_loyaltyadjustment.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_loyaltyadjustment.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "LoyaltyPointAdjustment"
	return ::message.returnvalue

// w_loyaltyadjustment.ue_save() returns 0
	long ll_primarykey
	long ll_row
	long ll_usercode
	string ls_errtext
	setpointer(hourglass!)
	ll_usercode = gl_usercode
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if this.id_detail.object.adjustedpoints[1] <= 0 then
		messagebox("Loyalty Points Adjustment", "Loyalty Points must be greater than zero for Adjustment")
		return
	end if
	if ll_usercode > 0 then
		ll_row = this.id_detail.getrow()
		ll_primarykey = this.id_detail.object.code[this.id_detail.getrow()]
		if isnull(ll_primarykey) then
			ll_primarykey = 0
			f_newtableid(this.is_tablename, ll_primarykey)
			this.id_detail.setitem(ll_row, "code", ll_primarykey)
		end if
		this.id_detail.object.usercode[1] = ll_usercode
		this.id_detail.object.date[1] = today()
		if this.id_detail.update() > 0 then
			sqlca.manageloyaltypoints("AD", ll_primarykey)
			if sqlca.sqlcode <> 0 then
				ls_errtext = "Problem in updating loyalty points for this account.~r~nReasons are:- " + sqlca.sqlerrtext
				SQL rollback USING sqlca;
				messagebox("Loyalty Points Updation", ls_errtext)
			else
				SQL commit USING sqlca;
			end if
			messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
			this.ib_commitok = true
			this.im_menu.m_file.m_new.enabled = true
			this.editflag = false
		else
			SQL rollback USING sqlca;
			setpointer(arrow!)
			messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs", exclamation!, ok!, 1)
			return
		end if
		return
	end if
	setpointer(arrow!)

// w_loyaltyadjustment.ue_detail() returns 0
	call super::ue_detail
	if this.id_list.getrow() > 0 and this.id_list.object.code[this.id_list.getrow()] > 0 then
		wf_protectdw(this.id_detail, 1)
		this.editflag = false
		this.im_menu.m_file.m_save.visible = false
		this.im_menu.m_file.m_save.enabled = false
	end if
	this.im_menu.m_file.m_print.visible = true
	this.im_menu.m_file.m_print.enabled = true

// w_loyaltyadjustment.ue_newform() returns 0
	call super::ue_newform
	wf_protectdw(this.id_detail, 0)
	this.editflag = true
	this.im_menu.m_file.m_save.visible = true
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.visible = true
	this.im_menu.m_file.m_print.enabled = true

// w_loyaltyadjustment.ue_print() returns 0
	long ll_code
	boolean lb_listtab
	s_datastore lstr
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	ll_code = this.id_detail.object.code[1]
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_code) or ll_code <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false and (ll_code = 0 or isnull(ll_code)) then
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
			return
		end if
		ll_code = this.id_detail.getitemnumber(this.id_detail.getrow(), "code")
	end if
	wf_setprintout()
	this.id_print.settransobject(sqlca)
	this.id_print.retrieve(ll_code)
	lstr.dw = this.id_print
	lstr.s_name1 = this.id_print.dataobject
	openwithparm(w_preview_invoices, lstr)
	lstr = message.powerobjectparm
	if lstr.i_closemode = -1 then
		return
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Data,~r~nNo rows are retrieved", information!)
