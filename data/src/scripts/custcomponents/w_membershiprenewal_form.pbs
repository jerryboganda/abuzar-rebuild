// window w_membershiprenewal_form (custcomponents)  ancestor: w_single_entry

// w_membershiprenewal_form.wf_findcustcode(string as_searchstring, string as_columnname, long al_custcode, string as_membershipid) returns long
	integer li_custcode
	integer ll_retflag
	long ll_rowno
	string ls_itemname
	datawindowchild ldc_customer
	if this.id_detail.getchild("custCode", ldc_customer) <> 1 then
		messagebox("DataWindo Error", "Unable to get child window from customer")
		return 0
	end if
	ll_rowno = ldc_customer.find("lower(" + as_columnname + ")='" + lower(as_searchstring) + "'", 1, ldc_customer.rowcount())
	if isnull(ll_rowno) or ll_rowno <= 0 then
		ll_retflag = 0
	else
		al_custcode = ldc_customer.getitemnumber(ll_rowno, "accounts_acccode")
		SQL SELECT membershipid INTO :as_membershipid FROM customer WHERE customer.custcode =:al_custcode USING sqlca;
		ll_retflag = 1
	end if
	return ll_retflag

// w_membershiprenewal_form.wf_findpatientcode(string as_searchstring, string as_columnname, long al_patientcode, string as_membershipid) returns long
	long ll_patientcode
	long ll_retflag
	long ll_custcode
	long ll_rowno
	string ls_itemname
	datawindowchild ldc_child
	if this.id_detail.getchild("PatientCode", ldc_child) <> 1 then
		messagebox("DataWindo Error", "Unable to get child window from Patient")
		return 0
	end if
	ll_rowno = ldc_child.find("lower(" + as_columnname + ")='" + lower(as_searchstring) + "'", 1, ldc_child.rowcount())
	if isnull(ll_rowno) or ll_rowno <= 0 then
		ll_retflag = 0
	else
		ll_custcode = ldc_child.getitemnumber(ll_rowno, "custcode")
		al_patientcode = ldc_child.getitemnumber(ll_rowno, "patientcode")
		SQL SELECT membershipid INTO :as_membershipid FROM patient WHERE patient.patientcode =:al_patientcode USING sqlca;
		ll_retflag = 1
	end if
	return ll_retflag

// w_membershiprenewal_form.ue_newform() returns 0 [event]
	call super::ue_newform
	wf_protectdw(this.id_detail, 0)
	this.id_detail.setcolumn("regno")

// w_membershiprenewal_form.create() returns 0 [event]
	call super::create

// w_membershiprenewal_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_membershiprenewal_form.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_membershiprenewal_form.ue_detail() returns 0 [event]
	call super::ue_detail
	wf_protectdw(this.id_detail, 1)

// w_membershiprenewal_form.open() returns long [event]
	m_entry lm_menu
	long ll_width
	long ll_height
	environment env
	this.is_tablename = "MemberShipRenewal"
	this.it_transobject = create u_transaction
	SQL start USING this.it_transobject;
	postevent("ue_postopen")
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	lm_menu.mf_initsecurityapp(lm_menu)
	this.im_menu.m_file.m_save.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_file.m_previous.enabled = false
	this.im_menu.m_file.m_retrieve.text = "De&tail"
	this.id_detail = this.tab_retrieve.tabpage_detail.dw_detail
	this.id_list = this.tab_retrieve.tabpage_list.dw_list
	this.tab_retrieve.tabpage_detail.dw_print.dataobject = this.tab_retrieve.tabpage_detail.dw_detail.dataobject
	this.id_print = this.tab_retrieve.tabpage_detail.dw_print
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)
	this.id_dwcontrol = this.id_list
	wf_populate_ddlb(this.id_dwcontrol)
	this.tab_retrieve.tabpage_list.dw_find.settransobject(this.it_transobject)
	if getenvironment(env) <> 1 then
		return ::message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.tab_retrieve.width = ll_width * 0.99
	this.tab_retrieve.height = ll_height * 0.83
	this.tab_retrieve.tabpage_list.gb_fliter.width = ll_width * 0.97 - this.tab_retrieve.tabpage_list.gb_sort.width
	this.tab_retrieve.tabpage_list.r_1.width = ll_width * 0.99
	this.tab_retrieve.tabpage_list.r_1.height = ll_height * 0.765 - this.tab_retrieve.tabpage_list.gb_sort.height
	this.tab_retrieve.tabpage_list.dw_list.width = ll_width * 0.98
	this.tab_retrieve.tabpage_list.dw_list.height = ll_height * 0.75 - this.tab_retrieve.tabpage_list.dw_list.y
	this.tab_retrieve.tabpage_detail.dw_detail.width = ll_width * 0.98
	this.tab_retrieve.tabpage_detail.dw_detail.height = ll_height * 0.70
	setredraw(true)
	return ::message.returnvalue

// w_membershiprenewal_form.ue_save() returns 0 [event]
	long ll_primarykey
	long ll_patientcode
	long ll_row
	long ll_custcode
	string ls_newaliasname
	string ls_oldaliasname
	datetime ldt_newlicexpiry
	datetime ldt_oldlicexpiry
	setpointer(hourglass!)
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	ll_patientcode = this.id_detail.getitemnumber(1, "patientcode")
	ll_custcode = this.id_detail.getitemnumber(1, "custcode")
	ls_newaliasname = this.id_detail.getitemstring(1, "newaliasname")
	ldt_newlicexpiry = this.id_detail.getitemdatetime(1, "newlicexpiry")
	ls_oldaliasname = this.id_detail.getitemstring(1, "oldaliasname")
	ldt_oldlicexpiry = this.id_detail.getitemdatetime(1, "oldlicexpiry")
	if ldt_newlicexpiry = ldt_oldlicexpiry then
		messagebox("Validatation Error", "New Lic. Expiry should be different from Old Lic. Expiry~r~n ")
		this.id_detail.setcolumn("newlicexpiry")
		return
	end if
	if ll_patientcode > 0 then
		SQL update Patient SET licenseexpiry =:ldt_newlicexpiry WHERE PatientCode =:ll_patientcode USING this.it_transobject;
	else
		SQL update Customer SET licenceexpiry =:ldt_newlicexpiry WHERE CustCode =:ll_custcode USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode <> 0 then
		SQL rollback USING this.it_transobject;
		messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs~r~n" + this.it_transobject.sqlerrtext, exclamation!, ok!, 1)
		return
	end if
	if ll_patientcode > 0 then
		SQL update Patient SET regno =:ls_newaliasname WHERE PatientCode =:ll_patientcode USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			SQL rollback USING this.it_transobject;
			messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs~r~n" + this.it_transobject.sqlerrtext, exclamation!, ok!, 1)
			return
		end if
	else
		SQL update Accounts SET aliasname =:ls_newaliasname WHERE AccCode =:ll_custcode USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			SQL rollback USING this.it_transobject;
			messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs~r~n" + this.it_transobject.sqlerrtext, exclamation!, ok!, 1)
			return
		end if
	end if
	ll_row = this.id_detail.getrow()
	ll_primarykey = this.id_detail.object.code[this.id_detail.getrow()]
	if isnull(ll_primarykey) then
		ll_primarykey = 0
		f_newtableid(this.is_tablename, ll_primarykey)
		this.id_detail.setitem(ll_row, "code", ll_primarykey)
	end if
	if this.id_detail.update() > 0 then
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		this.ib_commitok = true
		this.im_menu.m_file.m_new.enabled = true
		this.editflag = false
	else
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs", exclamation!, ok!, 1)
		return
	end if
	setpointer(arrow!)

// w_membershiprenewal_form.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	SQL stop USING this.it_transobject;
	destroy this.it_transobject
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	long ll_custcode
	long ll_patientcode
	long ll_res
	string ls_oldaliasname
	string ls_aliasname
	string ls_membershipid
	datetime ldt_oldlicexpiry
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "regno"
		ls_oldaliasname = data
		SQL SELECT licenseexpiry , membershipid , custcode , patientcode , aliasname =( select a.aliasname from accounts a where a.acccode =patient.custcode ) INTO :ldt_oldlicexpiry, :ls_membershipid, :ll_custcode, :ll_patientcode, :ls_aliasname FROM patient WHERE regno =:data USING sqlca;
		if isnull(ldt_oldlicexpiry) then
			ldt_oldlicexpiry = datetime(today())
		end if
		setitem(1, "patientcode", ll_patientcode)
		setitem(1, "accounts_aliasname", ls_aliasname)
		setitem(1, "custcode", ll_custcode)
		setitem(1, "oldaliasname", ls_oldaliasname)
		setitem(1, "oldlicexpiry", ldt_oldlicexpiry)
		setitem(1, "newaliasname", ls_oldaliasname)
		setitem(1, "newlicexpiry", ldt_oldlicexpiry)
		setitem(1, "membershipid", ls_membershipid)
		if sqlca.sqlcode <> 0 then
			messagebox("DataBase Problem", "Unable to fetch Old information")
			rt_code = 1
		end if
	case "patientcode"
		ll_patientcode = long(data)
		SQL SELECT regno , licenseexpiry , membershipid , custcode , aliasname =( select a.aliasname from accounts a where a.acccode =patient.custcode ) INTO :ls_oldaliasname, :ldt_oldlicexpiry, :ls_membershipid, :ll_custcode, :ls_aliasname FROM patient WHERE patientcode =:ll_patientcode USING sqlca;
		if isnull(ldt_oldlicexpiry) then
			ldt_oldlicexpiry = datetime(today())
		end if
		setitem(1, "regno", ls_oldaliasname)
		setitem(1, "accounts_aliasname", ls_aliasname)
		setitem(1, "custcode", ll_custcode)
		setitem(1, "oldaliasname", ls_oldaliasname)
		setitem(1, "oldlicexpiry", ldt_oldlicexpiry)
		setitem(1, "newaliasname", ls_oldaliasname)
		setitem(1, "newlicexpiry", ldt_oldlicexpiry)
		setitem(1, "membershipid", ls_membershipid)
		if sqlca.sqlcode <> 0 then
			messagebox("DataBase Problem", "Unable to fetch Old information")
			rt_code = 1
		end if
	case "custcode"
		ll_custcode = long(data)
		SQL SELECT aliasname INTO :ls_oldaliasname FROM accounts WHERE acccode =:ll_custcode USING sqlca;
		SQL SELECT licenceexpiry , membershipid INTO :ldt_oldlicexpiry, :ls_membershipid FROM customer WHERE custcode =:ll_custcode USING sqlca;
		if isnull(ldt_oldlicexpiry) then
			ldt_oldlicexpiry = datetime(today())
		end if
		setitem(1, "oldaliasname", ls_oldaliasname)
		setitem(1, "oldlicexpiry", ldt_oldlicexpiry)
		setitem(1, "newaliasname", ls_oldaliasname)
		setitem(1, "newlicexpiry", ldt_oldlicexpiry)
		setitem(1, "accounts_aliasname", ls_oldaliasname)
		setitem(1, "membershipid", ls_membershipid)
		if sqlca.sqlcode <> 0 then
			messagebox("DataBase Problem", "Unable to fetch Old information")
			rt_code = 1
		end if
	case "membershipid"
		if not isnull(data) and data <> "" then
			SQL SELECT regno , licenseexpiry , custcode , patientcode , aliasname =( select a.aliasname from accounts a where a.acccode =patient.custcode ) INTO :ls_oldaliasname, :ldt_oldlicexpiry, :ll_custcode, :ll_patientcode, :ls_aliasname FROM patient WHERE MembershipID =:data USING sqlca;
			if isnull(ldt_oldlicexpiry) then
				ldt_oldlicexpiry = datetime(today())
			end if
			setitem(1, "accounts_aliasname", ls_aliasname)
			setitem(row, "custcode", ll_custcode)
			setitem(1, "regno", ls_oldaliasname)
			setitem(1, "patientcode", ll_patientcode)
			setitem(1, "oldaliasname", ls_oldaliasname)
			setitem(1, "oldlicexpiry", ldt_oldlicexpiry)
			setitem(1, "newaliasname", ls_oldaliasname)
			setitem(1, "newlicexpiry", ldt_oldlicexpiry)
			setitem(1, "membershipid", data)
			if sqlca.sqlcode <> 0 then
				messagebox("DataBase Problem", "Unable to fetch Old information")
				rt_code = 1
			end if
		end if
	case "accounts_aliasname"
		if not isnull(data) and data <> "" then
			ll_res = parent.parent.parent.wf_findcustcode(data, dwo.name, ll_custcode, ls_membershipid)
			if ll_res > 0 then
				setitem(row, "custcode", ll_custcode)
				SQL SELECT aliasname INTO :ls_oldaliasname FROM accounts WHERE acccode =:ll_custcode USING sqlca;
				SQL SELECT licenceexpiry , membershipid INTO :ldt_oldlicexpiry, :ls_membershipid FROM customer WHERE custcode =:ll_custcode USING sqlca;
				setitem(1, "oldaliasname", ls_oldaliasname)
				setitem(1, "oldlicexpiry", ldt_oldlicexpiry)
				setitem(1, "newaliasname", ls_oldaliasname)
				setitem(1, "newlicexpiry", ldt_oldlicexpiry)
				setitem(1, "membershipid", ls_membershipid)
				setitem(1, "accounts_aliasname", ls_oldaliasname)
				if sqlca.sqlcode <> 0 then
					messagebox("DataBase Problem", "Unable to fetch Old information")
					rt_code = 1
				end if
			else
				messagebox("Customer Validation", "Customer with  Alias Name  " + data + " does not exist")
				rt_code = 1
			end if
		end if
	end choose
	return rt_code

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "iccode"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	end choose
	return 1
