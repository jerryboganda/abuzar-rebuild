// dw_4.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	long ll_rowcount
	string ls_code
	ancestorreturnvalue = super::ue_enterkey()
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		if rowcount() > 0 and f_validatedw(this) < 0 then
			return ::message.returnvalue
		end if
		ls_code = trim(string(this.object.spocode[rowcount()]))
		if isnull(ls_code) then
			return 1
		elseif vf_dwdupcode1(this, "spocode", ls_code, rowcount()) then
			messagebox("Duplicate", "Duplicate SPO. This SPO is Already Selected", stopsign!)
			return 1
		else
			ll_rowcount = insertrow(0)
			if ll_rowcount > 1 then
				scrolltorow(ll_rowcount)
				setcolumn("spocode")
				setfocus()
			end if
			return 1
		end if
		return
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// cb_ok.ue_enterkry(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return 1

// cb_ok.clicked() returns long [event]
	string ls_name
	long ll_newid
	long ll_row
	long ll_counter
	long ll_liccode
	long li_rc
	boolean lb_commitok
	if f_validatedw(parent.id_1) < 0 then
		parent.tab_main.selecttab(1)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_2) < 0 then
		parent.tab_main.selecttab(2)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_3) < 0 then
		parent.tab_main.selecttab(3)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_4) < 0 then
		parent.tab_main.selecttab(4)
		return ::message.returnvalue
	end if
	if parent.wf_prepare_for_update() < 0 then
		SQL rollback USING parent.it_transobject;
		return ::message.returnvalue
	end if
	if parent.id_1.update() = 1 then
		if parent.id_2.update() = 1 then
			if parent.id_3.update() = 1 then
				if parent.id_4.update() = 1 then
					SQL commit USING parent.it_transobject;
					lb_commitok = true
					parent.event ue_close()
					return ::message.returnvalue
				else
					messagebox("SPO Team Member Update Problem", "Unable to update SPO Team Member Information" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
					SQL rollback USING parent.it_transobject;
				end if
			else
				messagebox("SPO Team Sub Area Update Problem", "Unable to update SPO Team Sub Area Information" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
				SQL rollback USING parent.it_transobject;
			end if
		else
			messagebox("SPO Team Category Update Problem", "Unable to update SPO Team Category Information" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
			SQL rollback USING parent.it_transobject;
		end if
	else
		messagebox("SPO Team Update Problem", "Unable to update SPO Team Information" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
		SQL rollback USING parent.it_transobject;
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.postevent("ue_close")
	return ::message.returnvalue
