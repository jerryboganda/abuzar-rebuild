// window w_customer_form (custcomponents)  ancestor: w_single_entry

// w_customer_form.wf_duplicatealiasname(string as_aliasname) returns boolean
	long ll_count
	boolean b_flag
	as_aliasname = trim(as_aliasname)
	SQL SELECT count ( *) INTO :ll_count FROM Accounts WHERE Accounts.aliasname =:as_aliasname USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_customer_form.wf_duplicateaccname(string as_accname) returns boolean
	long ll_count
	boolean b_flag
	as_accname = trim(as_accname)
	SQL SELECT count ( *) INTO :ll_count FROM Accounts WHERE Accounts.name =:as_accname USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_customer_form.wf_set_itemcat_association() returns 0
	s_dw_header lstr_header
	lstr_header.dw_header = this.id_cust_itemcat_association
	openwithparm(w_custitemcatassociation_form, lstr_header)

// w_customer_form.wf_populateexistingcust() returns integer
	long ll_custcode
	long ll_null
	long ll_retcode
	string ls_null
	s_arguements lstr_arg
	datastore lds_customer
	lds_customer = create datastore
	lds_customer.dataobject = "d_customer_detail"
	lds_customer.settransobject(sqlca)
	open(w_arg_cust_v14)
	lstr_arg = message.powerobjectparm
	if lds_customer.retrieve(lstr_arg.l_code1) > 0 then
		this.id_detail.setredraw(false)
		if this.id_detail.deleterow(0) > 0 then
			if lds_customer.rowscopy(1, 1, primary!, this.id_detail, 1, primary!) > 0 then
				setnull(ll_null)
				setnull(ls_null)
				this.id_detail.setitem(1, "code", ll_null)
				this.id_detail.setitem(1, "accounts_aliasname", ls_null)
				this.id_detail.setredraw(true)
			end if
			destroy lds_customer
		else
			messagebox("Customer Information", "Problem in retrieving Customer Information")
			return 0
		end if
	else
		messagebox("Customer Information", "Problem in retrieving Customer Information")
	end if
	return 0

// w_customer_form.wf_showaccountledger() returns 0
	long ll_acccode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_detail.rowcount() > 0 and this.id_detail.getrow() > 0 then
			ll_acccode = this.id_detail.object.code[this.id_detail.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_acccode = this.id_list.object.code[this.id_list.getrow()]
	end if
	if not isnull(ll_acccode) and ll_acccode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_account_ledger, ll_acccode)
	end if

// w_customer_form.wf_setprintout() returns long
	string ls_report
	if gs_company = "TOTALMEDICAL" then
		ls_report = "d_customer_print_totalmedical"
	else
		ls_report = "d_customer_printout"
	end if
	this.id_print.dataobject = ls_report
	return 0

// w_customer_form.wf_set_guaranteeperson_association() returns 0
	s_dw_header lstr_header
	lstr_header.dw_header = this.id_cust_guranteeperson_association
	openwithparm(w_custguaranteeperson_assoc_form, lstr_header)

// w_customer_form.wf_retrieve() returns long
	long rtcode
	rtcode = this.id_dwcontrol.retrieve(f_getgroupcode(gl_usercode))
	return rtcode

// w_customer_form.wf_view_customercomments() returns long
	long ll_custcode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_detail.rowcount() > 0 and this.id_detail.getrow() > 0 then
			ll_custcode = this.id_detail.object.code[this.id_detail.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_custcode = this.id_list.object.code[this.id_list.getrow()]
	end if
	if not isnull(ll_custcode) and ll_custcode <> 0 then
		openwithparm(w_customercomment_view, ll_custcode)
	end if
	return 0

// w_customer_form.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_customer_form" then
		this.menuid = create m_customer_form
	end if
	this.dw_cust_itemcat_association = create dw_cust_itemcat_association
	this.dw_cust_guranteeperson_association = create dw_cust_guranteeperson_association
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_cust_itemcat_association
	this.control[icurrent + 2] = this.dw_cust_guranteeperson_association

// w_customer_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_cust_itemcat_association
	destroy this.dw_cust_guranteeperson_association

// w_customer_form.ue_save() returns 0 [event]
	string ls_aliasname
	long ll_newid
	long ll_row
	long ll_counter
	boolean lb_newcustomer
	boolean lb_autocreategodown
	boolean lb_continue
	string ls_errtext
	integer li_rc
	string ls_err
	string ls_mod
	datawindow ldw_detail
	ll_row = this.id_detail.getrow()
	if f_validatedw(this.tab_retrieve.tabpage_detail.dw_detail) < 0 then
		return
	end if
	if this.id_detail.object.customer_criticallimit[1] < 0 then
		messagebox("Critical Limit Validation", "Critical Limit Error~n~rCritical Limit must be greater than or equal to zero")
		return
	elseif this.id_detail.object.customer_criticallimit[1] < this.id_detail.object.customer_crlimit[1] then
		messagebox("Critical Limit Validation", "Critical Limit Error~n~rCritical Limit must be greater than or equal to credit limit")
		return
	end if
	ll_newid = this.id_detail.object.code[this.id_detail.getrow()]
	if isnull(ll_newid) then
		f_newtableid("Accounts", ll_newid)
		this.id_detail.object.code[ll_row] = ll_newid
		this.id_detail.object.accounts_acccode[ll_row] = ll_newid
		lb_newcustomer = true
		if f_rightexists(5063) then
			lb_autocreategodown = true
		end if
	end if
	ls_aliasname = this.id_detail.getitemstring(1, "accounts_aliasname")
	if isnull(ls_aliasname) then
		this.id_detail.setitem(this.id_detail.getrow(), "accounts_aliasname", string(ll_newid))
	end if
	if isnull(this.id_detail.getitemstring(1, "customer_membershipid")) then
		this.id_detail.setitem(this.id_detail.getrow(), "customer_membershipid", string(ll_newid))
	end if
	for ll_counter = 1 to this.id_cust_itemcat_association.rowcount()
		this.id_cust_itemcat_association.object.custcode[ll_counter] = ll_newid
	next
	for ll_counter = 1 to this.id_cust_guranteeperson_association.rowcount()
		this.id_cust_guranteeperson_association.object.custcode[ll_counter] = ll_newid
	next
	ldw_detail = this.tab_retrieve.tabpage_detail.dw_detail
	li_rc = ldw_detail.update(true, false)
	if li_rc = 1 then
		ls_mod = "accounts_acccode.Update=No "
		ls_mod = ls_mod + "accounts_localaccountname.Update=No "
		ls_mod = ls_mod + "accounts_name.Update=No "
		ls_mod = ls_mod + "accounts_SubCode.Update=No "
		ls_mod = ls_mod + "accounts_openingdate.Update=No "
		ls_mod = ls_mod + "accounts_aliasname.Update=No "
		ls_mod = ls_mod + "accounts_active.Update=No "
		ls_mod = ls_mod + "accounts_alertcode.Update=No "
		ls_mod = ls_mod + "accounts_acccode.Key=No "
		ls_mod = ls_mod + "DataWindow.Table.UpdateTable='customer' "
		ls_mod = ls_mod + "code.Key=Yes "
		ls_mod = ls_mod + "code.Update=Yes "
		ls_mod = ls_mod + "customer_CP.Update=Yes "
		ls_mod = ls_mod + "customer_CP2.Update=Yes "
		ls_mod = ls_mod + "customer_address1.Update=Yes "
		ls_mod = ls_mod + "customer_address2.Update=Yes "
		ls_mod = ls_mod + "customer_city.Update=Yes "
		ls_mod = ls_mod + "customer_postcode.Update=Yes "
		ls_mod = ls_mod + "customer_countycode.Update=Yes "
		ls_mod = ls_mod + "customer_country.Update=Yes "
		ls_mod = ls_mod + "customer_phone.Update=Yes "
		ls_mod = ls_mod + "customer_fax.Update=Yes "
		ls_mod = ls_mod + "customer_email.Update=Yes "
		ls_mod = ls_mod + "customer_areacode.Update=Yes "
		ls_mod = ls_mod + "customer_crlimit.Update=Yes "
		ls_mod = ls_mod + "customer_dayslimit.Update=Yes "
		ls_mod = ls_mod + "customer_custcatcode.Update=Yes "
		ls_mod = ls_mod + "customer_licenceno.Update=Yes "
		ls_mod = ls_mod + "customer_licenceexpiry.Update=Yes "
		ls_mod = ls_mod + "customer_SalesTaxRegNo.Update=Yes "
		ls_mod = ls_mod + "customer_DefaultGST.Update=Yes "
		ls_mod = ls_mod + "customer_InvDiscperc.Update=Yes "
		ls_mod = ls_mod + "customer_DefaultSalePrice.Update=Yes "
