		ls_mod = ls_mod + "customer_printwaranty.Update=Yes "
		ls_mod = ls_mod + "customer_gccode.Update=Yes "
		ls_mod = ls_mod + "customer_associatedservicetemplatecode.Update=Yes "
		ls_mod = ls_mod + "customer_printoutstandingserviceresult.Update=Yes "
		ls_mod = ls_mod + "customer_printamtonserviceinv.Update=Yes "
		ls_mod = ls_mod + "customer_printbalance.Update=Yes "
		ls_mod = ls_mod + "customer_block.Update=Yes "
		ls_mod = ls_mod + "customer_charges.Update=Yes "
		ls_mod = ls_mod + "customer_fullname.Update=Yes "
		ls_mod = ls_mod + "customer_owner.Update=Yes "
		ls_mod = ls_mod + "customer_address.Update=Yes "
		ls_mod = ls_mod + "customer_issuedlicenseno.Update=Yes "
		ls_mod = ls_mod + "customer_miscchargesperc.Update=Yes "
		ls_mod = ls_mod + "customer_ageinyears.Update=Yes "
		ls_mod = ls_mod + "customer_married.Update=Yes "
		ls_mod = ls_mod + "customer_noofdependents.Update=Yes "
		ls_mod = ls_mod + "customer_monthlyincome.Update=Yes "
		ls_mod = ls_mod + "customer_cellno.Update=Yes "
		ls_mod = ls_mod + "customer_addressstatus.Update=Yes "
		ls_mod = ls_mod + "customer_stayduration.Update=Yes "
		ls_mod = ls_mod + "customer_offaddress.Update=Yes "
		ls_mod = ls_mod + "customer_offphone.Update=Yes "
		ls_mod = ls_mod + "customer_jobduration.Update=Yes "
		ls_mod = ls_mod + "customer_pastpuroninst.Update=Yes "
		ls_mod = ls_mod + "customer_pastinstcompany.Update=Yes "
		ls_mod = ls_mod + "customer_descOfpastinstgoods.Update=Yes "
		ls_mod = ls_mod + "customer_criticallimit.Update=Yes "
		ls_mod = ls_mod + "customer_ReportDiscPerc.Update=Yes "
		ls_mod = ls_mod + "customer_customersectorcode.Update=Yes "
		ls_mod = ls_mod + "customer_taxcategorycode.Update=Yes "
		ls_mod = ls_mod + "customer_salestaxexemption.Update=Yes "
		ls_mod = ls_mod + "customer_paymentapi.Update=Yes "
		ls_mod = ls_mod + "customer_fname.Update=Yes "
		ls_mod = ls_mod + "customer_sitecode.Update=Yes "
		ls_err = ldw_detail.modify(ls_mod)
		if ls_err <> "" then
			messagebox("DataWindow Modify Error", ls_err)
		end if
		li_rc = ldw_detail.update()
		if li_rc = 1 then
			if this.id_cust_itemcat_association.update() = 1 then
				if lb_autocreategodown then
					sqlca.autocreatecustomergodown(ll_newid)
					if sqlca.sqlcode = 0 then
						lb_continue = true
					else
						ls_errtext = sqlca.sqlerrtext
						lb_continue = false
					end if
				else
					lb_continue = true
				end if
				if this.id_cust_guranteeperson_association.update() = 1 then
					lb_continue = true
				else
					lb_continue = false
				end if
				if lb_continue then
					SQL commit USING sqlca;
					messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
					this.ib_commitok = true
					this.im_menu.m_file.m_new.enabled = true
					this.editflag = false
				else
					messagebox("Error on Commit", sqlca.sqlerrtext)
					SQL rollback USING sqlca;
				end if
			else
				messagebox("Error on Commit", sqlca.sqlerrtext)
				SQL rollback USING sqlca;
			end if
		else
			messagebox("Update of Customer Table Failed", "Rolling back changes to " + "accounts  and Customer Tables")
			SQL rollback USING sqlca;
		end if
	else
		messagebox("Update of accounts Table Failed", "Rolling back changes to " + "accounts Table")
		SQL rollback USING sqlca;
		return
	end if
	ls_mod = "accounts_accCode.Update=yes "
	ls_mod = ls_mod + "accounts_localaccountname.Update=yes "
	ls_mod = ls_mod + "accounts_name.Update=yes "
	ls_mod = ls_mod + "accounts_SubCode.Update=yes "
