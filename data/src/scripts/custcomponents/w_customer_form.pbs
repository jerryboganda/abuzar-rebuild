// w_customer_form.ue_newform() returns 0 [event]
	long ll_rtncode
	call super::ue_newform
	this.tab_retrieve.tabpage_detail.dw_detail.object.accounts_aliasname.protect = 0
	this.tab_retrieve.tabpage_detail.dw_detail.object.customer_licenceexpiry.protect = 0
	ll_rtncode = this.id_detail.getchild("customer_subareacode", this.idc_subarea)
	if ll_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_subarea.settransobject(this.it_transobject)
	this.idc_subarea.retrieve()
	this.idc_subarea.setfilter("areacode=1")
	this.idc_subarea.filter()
	this.id_cust_itemcat_association.reset()
	this.dw_cust_guranteeperson_association.reset()

// w_customer_form.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "Customer"
	if f_stringpreferences("GroupCustCatInBasicData") = "Y" then
		this.id_list.dataobject = "d_customer_list_groupcat"
		this.id_list.settransobject(this.it_transobject)
	end if
	this.id_cust_itemcat_association = this.dw_cust_itemcat_association
	this.id_cust_itemcat_association.settransobject(sqlca)
	this.id_cust_guranteeperson_association = this.dw_cust_guranteeperson_association
	this.id_cust_guranteeperson_association.settransobject(sqlca)
	return ::message.returnvalue

// w_customer_form.ue_detail() returns 0 [event]
	long ll_counter
	long ll_code
	long ll_found
	call super::ue_detail
	if this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 and this.il_selectedrow > 0 then
		ll_code = this.id_list.object.code[this.il_selectedrow]
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 649", 1, gds_securitywindow.rowcount())
	if ll_found <= 0 then
		this.id_detail.reset()
		messagebox("Customer Modification!", "Your do not have enough rights for customer data modification~r~nPlease Contact system administrator for your help", stopsign!)
		this.tab_retrieve.selecttab(2)
		return
	end if
	this.tab_retrieve.tabpage_detail.dw_detail.object.customer_licenceexpiry.protect = 1
	this.tab_retrieve.tabpage_detail.dw_detail.object.accounts_aliasname.protect = 1
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 525 then
			this.tab_retrieve.tabpage_detail.dw_detail.object.accounts_aliasname.protect = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 673 then
			this.tab_retrieve.tabpage_detail.dw_detail.object.customer_licenceexpiry.protect = 0
		end if
	next
	this.idc_subarea.setredraw(false)
	this.idc_subarea.setfilter("areacode=" + string(this.id_detail.getitemnumber(1, "Customer_areacode")))
	this.idc_subarea.filter()
	this.idc_subarea.setredraw(true)
	this.id_cust_itemcat_association.retrieve(this.id_detail.object.code[this.id_detail.getrow()])
	this.dw_cust_guranteeperson_association.retrieve(this.id_detail.object.code[this.id_detail.getrow()])
	if this.id_detail.rowcount() > 0 then
		this.im_menu.m_file.m_print.enabled = true
	end if

// w_customer_form.ue_postopen() returns 0 [event]
	integer li_xpos
	integer li_ypos
	integer li_xendpos
	integer li_counter
	integer li_taborder
	integer li_visiblecolumns
	integer li_sitecol
	long ll_counter
	long li_retcode
	long ll_found
	m_customer_form lm_menu
	datastore lds_itemsetting
	call super::ue_postopen
	lm_menu = this.menuid
	f_fetch_sites()
	lds_itemsetting = create datastore
	lds_itemsetting.dataobject = "d_interfacesettingcols"
	lds_itemsetting.settransobject(this.it_transobject)
	lds_itemsetting.retrieve(24, 3, 1)
	li_visiblecolumns = lds_itemsetting.rowcount()
	for li_counter = 1 to lds_itemsetting.rowcount()
		this.colname[li_counter, 1] = lds_itemsetting.getitemstring(li_counter, "colname") + "_t"
		this.colname[li_counter, 2] = lds_itemsetting.getitemstring(li_counter, "colname")
		this.colwidth[li_counter, 1] = integer(this.id_detail.describe(this.colname[li_counter, 1] + ".Width"))
		this.colwidth[li_counter, 2] = integer(this.id_detail.describe(this.colname[li_counter, 2] + ".Width"))
		this.colheight[li_counter] = integer(this.id_detail.describe(this.colname[li_counter, 2] + ".Height"))
	next
	li_taborder = 10
	li_counter = 1
	li_ypos = 100
	li_xendpos = 30000
	do while li_counter <= li_visiblecolumns and li_ypos <= 2000000
		li_xpos = 14
		this.id_detail.modify(this.colname[li_counter, 1] + ".X=" + string(li_xpos))
		this.id_detail.modify(this.colname[li_counter, 1] + ".Y=" + string(li_ypos))
		this.id_detail.modify(this.colname[li_counter, 1] + ".Visible=1")
		li_xpos = 617
		this.id_detail.modify(this.colname[li_counter, 2] + ".X=" + string(li_xpos))
		this.id_detail.modify(this.colname[li_counter, 2] + ".Y=" + string(li_ypos))
		this.id_detail.modify(this.colname[li_counter, 2] + ".Visible=1")
		this.id_detail.settaborder(this.colname[li_counter, 2], li_taborder)
		if lower(this.colname[li_counter, 2]) = "customer_sitecode" then
			li_sitecol = 1
		end if
		li_taborder = li_taborder + 1
		li_ypos = li_ypos + this.colheight[li_counter] + 22
		li_counter = li_counter + 1
	loop
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 719", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_showaccountledger.visible = true
		lm_menu.m_file.m_showaccountledger.enabled = true
	end if
	if gl_sitecode > 0 and gc_dropbox = "Y" then
		if li_sitecol = 1 then
			this.id_detail.object.customer_sitecode.visible = true
			this.id_detail.object.customer_sitecode_t.visible = true
		end if
		return
	end if
	this.id_detail.object.customer_sitecode.visible = false
	this.id_detail.object.customer_sitecode_t.visible = false

// w_customer_form.ue_print() returns 0 [event]
	long ll_code
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_code) or ll_code <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	elseif this.id_detail.getrow() > 0 then
		ll_code = this.id_detail.getitemnumber(this.id_detail.getrow(), "code")
	end if
	if ll_code > 0 then
		wf_setprintout()
		this.id_print.settransobject(sqlca)
		this.id_print.retrieve(ll_code)
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		if this.id_print.rowcount() > 0 then
			if this.id_print.print() < 0 then
				messagebox("Printing", "Can not Print Invoice", information!)
			end if
			return
		end if
		messagebox("Printing Error", "Can not Print Data,~r~nNo rows are retrieved", information!)
	end if

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "accounts_name"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for Customer Name in current row")
		end if
	case "customer_fullname"
		if data = "" or isnull(data) then
			messagebox("Full Name Validation", "Value required for Customer's Full Name in current row")
		end if
	case "customer_owner"
		if data = "" or isnull(data) then
			messagebox("Owner Name Validation", "Value required for Owner's Full Name in current row")
		end if
	case "customer_address"
		if data = "" or isnull(data) then
			messagebox("Address Validation", "Value required for Address in current row")
		end if
	case "customer_issuedlicenseno"
		if data = "" or isnull(data) then
			messagebox("Issued License No. Validation", "Value required for Issued License No. in current row")
		end if
	case "customer_areacode"
		if data = "" or isnull(data) then
			messagebox("Area Name Validation", "Value required for Area Name in current row")
		end if
	case "customer_address1"
		if data = "" or isnull(data) then
			messagebox("Address1 Validation", "Value required for Address1 in current row")
		end if
	case "customer_address2"
		if data = "" or isnull(data) then
			messagebox("Address2 Validation", "Value required for Address2 in current row")
		end if
	case "customer_crlimit"
		messagebox("Credit Limit Validation", "Value required for Credit Limit in current row")
	case "customer_dayslimit"
		messagebox("Days Limit Validation", "Value required for Days Limit in current row")
	case "customer_city"
		if data = "" or isnull(data) then
			messagebox("City Validation", "Value required for City in current row")
		end if
	case "customer_Phone"
		if data = "" or isnull(data) then
			messagebox("Phone Validation", "Value required for Phone in current row")
		end if
	case "customer_email"
		if data = "" or isnull(data) then
			messagebox("Email Validation", "Value required for Email in current row")
		end if
	case "customer_licenceno"
		if data = "" or isnull(data) then
			messagebox("LicenceNo Validation", "Value required for LicenceNO in current row")
		end if
	case "customer_licenceexpiry"
		if data = "" or isnull(data) then
			messagebox("LicenceExpiry Validation", "Value required for LicenceExpiry in current row")
		end if
	case "customer_cp"
		if data = "" or isnull(data) then
			messagebox("Contact Person Validation", "Value required for Contact Person in current row")
		end if
	case "customer_country"
	case "customer_fax"
		if data = "" or isnull(data) then
			messagebox("Fax Validation", "Value required for Fax in current row")
		end if
	end choose
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_null
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "accounts_name"
		if parent.parent.parent.wf_duplicateaccname(data) then
			messagebox("Name Validation", "Duplication Name Error~n~rPlease Choose Some Other Name")
			return 1
		else
			this.object.customer_fullname[row] = data
		end if
	case "accounts_aliasname"
		if parent.parent.parent.wf_duplicatealiasname(data) then
			messagebox("AliasName Validation", "Duplication AliasName Error~n~rPlease Choose Some Other Name")
			return 1
		end if
	case "customer_areacode"
		parent.parent.parent.idc_subarea.setredraw(false)
		setnull(ll_null)
		parent.parent.parent.id_detail.setitem(1, "customer_subareacode", ll_null)
		if parent.parent.parent.idc_subarea.setfilter("areacode=" + data) = 1 then
			parent.parent.parent.idc_subarea.filter()
			parent.parent.parent.idc_subarea.setredraw(true)
		else
			messagebox("Sub Area Filter", "Unable to filter Sub Area Column")
			return 1
		end if
	case "customer_criticallimit"
		if double(data) < 0.0 then
			messagebox("Critical Limit Validation", "Critical Limit Error~n~rCritical Limit must be greater than or equal to zero")
			return 1
		elseif double(data) < this.object.customer_crlimit[row] then
			messagebox("Critical Limit Validation", "Critical Limit Error~n~rCritical Limit must be greater than or equal to credit limit")
			return 1
		else
			return 0
		end if
	case "customer_crlimit"
		if double(data) < 0.0 then
			messagebox("Customer Credit Limit Validation", "Customer Critical Limit Error~r~nPlease enter some possitive Customer Credit Limit")
			return 1
		else
			if double(data) > this.object.customer_criticallimit[row] then
				this.object.customer_criticallimit[row] = double(data)
			end if
			return 0
		end if
		return
	end choose
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long [event]
	if parent.parent.parent.id_detail.getcolumnname() <> "customer_specialinstructions" then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf6! then
		parent.parent.parent.wf_populateexistingcust()
	end if
	return ::message.returnvalue

// dw_detail.sqlpreview(sqlpreviewfunction request, sqlpreviewtype sqltype, string sqlsyntax, dwbuffer buffer, long row) returns long [event]
	long ancestorreturnvalue
	string ls_sql
	string ls_newsql
	string ls_sql_part
	long ll_counter
	long ll_pos
	long ll_commacount
	long ll_commapos
	long ll_newcommacount
	ancestorreturnvalue = super::sqlpreview(request, sqltype, sqlsyntax, buffer, row)
	if sqltype = previewinsert! then
		ls_sql = sqlsyntax
		ls_sql_part = "'" + getitemstring(getrow(), "accounts_localaccountname") + "'"
		ll_pos = pos(lower(ls_sql), ls_sql_part, 1)
		if ll_pos > 0 then
			ls_newsql = replace(ls_sql, ll_pos, len(ls_sql_part), "N" + ls_sql_part)
		else
			ls_newsql = ls_sql
		end if
		setsqlpreview(ls_newsql)
	elseif sqltype = previewupdate! then
		ls_sql = sqlsyntax
		ll_pos = pos(lower(ls_sql), "localaccountname = ", 1)
		if ll_pos > 0 then
			ls_newsql = mid(ls_sql, 1, ll_pos - 1) + "localaccountname = N" + mid(ls_sql, ll_pos + 19)
		else
			ls_newsql = ls_sql
		end if
		setsqlpreview(ls_newsql)
	end if
	return 0

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	choose case dwo.name
	case "accounts_localaccountname"
		f_set_keyboard_local()
	case else
		f_set_keyboard_english()
	end choose
	return ::message.returnvalue
