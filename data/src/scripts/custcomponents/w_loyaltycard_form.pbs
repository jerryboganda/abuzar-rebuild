// window w_loyaltycard_form (custcomponents)  ancestor: w_single_entry

// w_loyaltycard_form.wf_duplicatecardid(string as_id) returns boolean
	long ll_count
	boolean b_flag
	as_id = trim(as_id)
	SQL SELECT count ( *) INTO :ll_count FROM LoyaltyCard WHERE LoyaltyCardID =:as_id USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_loyaltycard_form.create() returns 0 [event]
	call super::create

// w_loyaltycard_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_loyaltycard_form.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "LoyaltyCard"
	return ::message.returnvalue

// w_loyaltycard_form.ue_save() returns 0 [event]
	long ll_primarykey
	long ll_row
	long ll_usercode
	setpointer(hourglass!)
	ll_usercode = gl_usercode
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if ll_usercode > 0 then
		ll_row = this.id_detail.getrow()
		ll_primarykey = this.id_detail.object.code[this.id_detail.getrow()]
		if isnull(ll_primarykey) then
			ll_primarykey = 0
			f_newtableid(this.is_tablename, ll_primarykey)
			this.id_detail.setitem(ll_row, "code", ll_primarykey)
		end if
		this.id_detail.object.usercode[1] = ll_usercode
		if this.id_detail.update() > 0 then
			SQL commit USING sqlca;
			messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
			this.ib_commitok = true
			this.im_menu.m_file.m_new.enabled = true
			this.editflag = false
		else
			SQL rollback USING sqlca;
			setpointer(arrow!)
			messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs", exclamation!, ok!, 1)
			return
		end if
		return
	end if
	setpointer(arrow!)

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_acccode
	string ls_aliasname
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "loyaltycardid"
		if parent.parent.parent.wf_duplicatecardid(data) then
			messagebox("Loyalty Card ID Validation", "Duplication of Loyalty Card ID~n~rPlease Choose Some Other Loyalty Card ID")
			return 1
		end if
	case "aliasname"
		if len(trim(data)) > 0 then
			ls_aliasname = trim(data)
			SQL SELECT AccCode INTO :ll_acccode FROM Accounts WHERE Active ='Y' AND SubCode =3 AND AliasName =:ls_aliasname USING sqlca;
			if sqlca.sqlcode = 0 then
				this.object.acccode[row] = ll_acccode
				return 0
			else
				return 1
			end if
		else
			messagebox("Account Alias Name Validation", "Please Select valid Account Alias Name~n~rPlease Choose Some Other Account Alias Name")
			return 1
		end if
	case "acccode"
		ll_acccode = long(data)
		if ll_acccode > 0 then
			SQL SELECT AliasName INTO :ls_aliasname FROM Accounts WHERE SubCode =3 AND AccCode =:ll_acccode USING sqlca;
			if sqlca.sqlcode = 0 then
				this.object.aliasname[row] = ls_aliasname
				return 0
			else
				return 1
			end if
		else
			messagebox("Loyalty Card Account Validation", "Please Select valid Loyalty Card Account~n~rPlease Choose Some Other Loyalty Card Account")
			return 1
		end if
		return
	end choose
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "loyaltycardid"
		if data = "" or isnull(data) then
			messagebox("Loyalty Card ID Validation", "Value required for Loyalty Card ID in current row")
		end if
	end choose
	return 1
