	ls_mod = ls_mod + "customer_customersectorcode.Update=No "
	ls_err = ldw_detail.modify(ls_mod)
	if ls_err <> "" then
		messagebox("DataWindow Modify Error", ls_err)
	end if
	parent.dw_control = ldw_detail
	parent.dw_control.setitem(ll_row, "code", ll_null)
	setpointer(arrow!)
	return ::message.returnvalue

// dw_control.ue_enterkey() returns long
	send(handle(this), 256, 9, long(90))
	return 1

// dw_control.itemchanged(long row, dwobject dwo, string data) returns long
	choose case dwo.name
	case "accounts_aliasname"
		if parent.wf_duplicatealiasname(data) then
			return 1
		end if
	end choose
	return ::message.returnvalue

// dw_control.itemerror(long row, dwobject dwo, string data) returns long
	choose case dwo.name
	case "accounts_aliasname"
		messagebox("Custmer Alias Name Validation", "Customer Alias Name Duplication Error~r~nPlease enter some other Alias Name")
	end choose
	return 1

// dw_control.itemfocuschanged(long row, dwobject dwo) returns long
	selecttext(1, len(gettext()))
	return ::message.returnvalue
