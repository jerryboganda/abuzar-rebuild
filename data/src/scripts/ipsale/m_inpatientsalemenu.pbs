// m_save.create() returns 0 [event]
	call super::create

// m_save.destroy() returns 0 [event]
	call super::destroy

// m_save.clicked() returns 0 [event]
	boolean lb_saveright
	long ll_counter
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 531 then
			lb_saveright = true
		end if
	next
	if lb_saveright = false then
		messagebox("Save", "Press Ctrl + P  for Save and Print")
		return
	end if
	this.parentwindow.triggerevent("ue_save")
	if this.parentwindow.dynamic wf_commitform() = true then
		this.parentwindow.postevent("ue_new")
	end if

// m_options.create() returns 0 [event]
	call super::create
	this.text = "Sa&ve and Print~tCtrl+F6"
	this.enabled = false

// m_options.clicked() returns 0 [event]
	call super::clicked
	this.parentwindow.triggerevent("ue_save")
	if this.parentwindow.dynamic wf_commitform() = true then
		this.parentwindow.triggerevent("ue_print")
		this.parentwindow.postevent("ue_new")
	end if

// m_options.destroy() returns 0 [event]
	call super::destroy

