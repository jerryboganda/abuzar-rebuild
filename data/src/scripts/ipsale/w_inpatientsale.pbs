// window w_inpatientsale (ipsale)  ancestor: w_multi_entry

// w_inpatientsale.ue_printdo() returns 0 [event]
	long ll_custcode
	long ll_row
	string ls_custname
	string ls_pagesize
	integer li_option
	if this.im_menu.m_file.m_save.enabled = true then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	ls_pagesize = this.id_master.getitemstring(1, "invoicesize")
	if f_stringpreferences("PurBatch") = "Y" and f_stringpreferences("PurExpiry") = "Y" then
		if gs_company = "MARSHAL" then
			if ls_pagesize = "H" then
				this.id_print.dataobject = "d_marshal_deliveryorder_half"
			else
				this.id_print.dataobject = "d_marshal_deliveryorder_full"
			end if
		else
			this.id_print.dataobject = "d_deliveryorder_batchexpiry_half"
		end if
	elseif gs_company = "MARSHAL" then
		if ls_pagesize = "H" then
			this.id_print.dataobject = "d_marshal_deliveryorder_half"
		else
			this.id_print.dataobject = "d_marshal_deliveryorder_full"
		end if
	else
		this.id_print.dataobject = "d_deliveryorder_half"
	end if
	if gs_company = "SAH" then
		this.id_print.dataobject = "d_sah_deliveryorder_full"
	end if
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(this.id_master.getitemnumber(1, "code"))
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_inpatientsale.ue_enableprint() returns 0 [event]
	this.im_menu.m_file.m_print.enabled = true

// w_inpatientsale.ue_save_withnocommit() returns long [event]
	setpointer(hourglass!)
	if f_validatedw(this.id_master) < 0 then
		return -1
	end if
	if f_validatedw(this.id_detail) < 0 then
		return -2
	end if
	if this.id_master.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -3
	end if
	if this.id_detail.update() < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -4
	end if
	setpointer(arrow!)
	return 0

// w_inpatientsale.wf_getmaxdate(datetime ad_date) returns integer
	SQL Select Max ( Date ) INTO :ad_date From saleledger USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_inpatientsale.wf_locksaleinvoices(long al_sinvcode, long al_linvcode, long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From saleledger WITH ( UPDLOCK HOLDLOCK ) Where saleledger.saleinvcode Between :al_sinvcode AND :al_linvcode AND saleledger.Posted ='N' USING sqlca;
	return sqlca.sqlcode

// w_inpatientsale.wf_getitemassociategcode(long la_icode) returns integer
	integer li_gcode
	SQL Select Gcode INTO :li_gcode From item Where icode =:la_icode USING this.it_transobject;
	return li_gcode

// w_inpatientsale.wf_deletesaleinvoice(long al_saleinvcode) returns integer
	SQL Delete saledetail Where saledetail.SaleInvCode =:al_saleinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_inpatientsale.wf_locksaleinvoice(long al_saleinvcode) returns integer
	integer li_count
	this.it_transobject.dbparm = " Async =1, DBGetTime = 20"
	this.it_transobject.locksaleinvoice(al_saleinvcode)
	this.it_transobject.dbparm = "Async =0, DBGetTime = 0"
	return this.it_transobject.sqlcode

// w_inpatientsale.wf_preinvinfo() returns 0
	s_previnvinfo ls_previnvinfo
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_previnvinfo.ar_customer = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		ls_previnvinfo.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_previnvinfo.ar_invdate = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_previnvinfo, ls_previnvinfo)
	end if

// w_inpatientsale.wf_setsuppinfo(long al_suppcode, datawindow ad_master) returns 0
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	SQL SELECT supplier.address1 , supplier.city , supplier.phone INTO :ls_address, :ls_city, :ls_phone FROM supplier WHERE supplier.suppcode =:al_suppcode USING this.it_transobject;
	ll_currow = ad_master.getrow()
	ad_master.object.supplier_address[ll_currow] = ls_address
	ad_master.object.supplier_city[ll_currow] = ls_city
	ad_master.object.supplier_phone[ll_currow] = ls_phone

// w_inpatientsale.wf_updatesaleprice(long al_icode, double ad_saleprice) returns integer
	SQL update Item SET saleprice =:ad_saleprice WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_inpatientsale.wf_validateitemnew() returns integer
	long ll_icode
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	double ld_stock
	double ld_totalstock
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
		messagebox(ls_titleerrtext, ls_errtext)
	elseif not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		ls_titleerrtext = "Item Validation"
		li_errcode = -2
	end if
	this.ib_itemvalidated = true
	return li_errcode

// w_inpatientsale.wf_closelist() returns 0
	this.ib_itemslistopen = false
	this.id_itemslist.hide()

// w_inpatientsale.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	long iccode
	long icatcode
	long packcode
	long manfcode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_inpatientsale.wf_print() returns integer
	integer li_errcode = 1
	long ll_salesmancode
	long ll_saleinvcount
	long ll_count
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			for ll_count = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
				this.id_print.retrieve(ll_count)
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			next
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	return li_errcode

// w_inpatientsale.wf_setsaletype(integer ai_saletype) returns 0
	this.ii_saletype = ai_saletype

// w_inpatientsale.wf_visibleinvisiblediscount() returns integer
	this.id_detail.object.discperc.visible = 0
	this.id_detail.object.discperc.initial = "0"
	return 1

// w_inpatientsale.wf_customermessagevalidation(long al_custcode, long al_messagecode) returns integer
	integer li_messagecode
	long ll_currrow
	SQL SELECT customer.messagecode INTO :li_messagecode FROM customer WHERE customer.custcode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currrow = this.id_master.getrow()
		if isnull(li_messagecode) then
			ll_currrow = 0
		else
			ll_currrow = 1
		end if
	end if
	return ll_currrow

// w_inpatientsale.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	long ll_icode
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean lb_rtflag = true
	boolean ib_due
	integer li_null
	string ls_null
	ls_titleerrtext = "Item Validation"
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), al_currrow) = true then
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
	elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			li_option = messagebox("Item Validation", "Item stock does not exist~n~rDo You want to due this item", information!, yesno!, 2)
			if li_option = 1 then
				this.id_detail.setitem(this.il_currrow, "looseqty", 1)
				this.id_detail.setitem(this.il_currrow, "dueqty", 1)
				ib_due = true
			else
				li_errcode = -1
			end if
		end if
	else
		li_errcode = -1
		ls_titleerrtext = "Item Validation"
	end if
	if li_errcode = -1 and not ib_due then
		lb_rtflag = false
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setitem(al_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(al_currrow, "icode", li_null)
		this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	end if
	return lb_rtflag

// w_inpatientsale.wf_returnsaleinvoice(long al_invid, string as_errtext) returns boolean
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_counter = 1
	long ll_detailrows
	string ls_batch
	string ls_due
	datetime ld_expiry
	boolean lb_commitflag = true
	double ld_avgprice
	double ld_looseqty
	double ld_bonusqty
	double ld_stock
	double ld_newstock
	this.id_saleinvdetail.retrieve(al_invid)
	ll_detailrows = this.id_saleinvdetail.rowcount()
	ll_counter = 1
	do while ll_counter <= ll_detailrows and lb_commitflag
		ll_gcode = this.id_saleinvdetail.getitemnumber(ll_counter, "gcode")
		ll_icode = this.id_saleinvdetail.getitemnumber(ll_counter, "icode")
		ls_batch = this.id_saleinvdetail.getitemstring(ll_counter, "batch")
		ld_expiry = this.id_saleinvdetail.getitemdatetime(ll_counter, "expiry")
		ld_looseqty = this.id_saleinvdetail.getitemnumber(ll_counter, "looseqty")
		ld_bonusqty = this.id_saleinvdetail.getitemnumber(ll_counter, "bonusqty")
		ls_due = this.id_saleinvdetail.getitemstring(ll_counter, "Due")
		if ls_due <> "D" and ls_due <> "S" or isnull(ls_due) then
			this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
			if this.it_transobject.sqlcode = 0 then
				this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					ld_newstock = ld_stock + ld_looseqty + ld_bonusqty
					this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
					if this.it_transobject.sqlcode <> 0 then
						lb_commitflag = false
					end if
					if ld_stock = 0.0 then
						SQL update GodownDetail Set Priority =1 Where GodownDetail.GCode =:ll_gcode and GodownDetail.ICode =:ll_icode and GodownDetail.Batch =:ls_batch and GodownDetail.Expiry =:ld_expiry USING this.it_transobject;
					end if
				else
					lb_commitflag = false
				end if
			else
				lb_commitflag = false
			end if
		end if
		ll_counter = ll_counter + 1
	loop
	if lb_commitflag then
		if wf_deletesaleinvoice(al_invid) <> 0 then
			lb_commitflag = false
			as_errtext = "    Some database problem occur"
		end if
	else
		as_errtext = "    Some database problem occur"
	end if
	return lb_commitflag

// w_inpatientsale.wf_dueitem() returns 0
	s_dueinfo ls_due
	long ll_row
	long li_null
	long ll_code
	long ll_counter
	long ll_icode
	long ll_gcode
	string ls_null
	double ld_qty
	double ld_dueqty
	double ld_godownstock
	this.id_detail.accepttext()
	if this.id_detail = getfocus() and this.id_detail.getcolumnname() = "looseqty" or this.id_detail.getcolumnname() = "gcode" then
		ll_row = this.id_detail.getrow()
		ll_code = this.id_master.getitemnumber(this.id_master.getrow(), "code")
		if not isnull(ll_code) then
			this.ids_invoiceinfo.retrieve(ll_code)
			ll_icode = this.id_detail.getitemnumber(ll_row, "icode")
			ll_gcode = this.id_detail.getitemnumber(ll_row, "gcode")
			this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Stock Validation", "Database Error: Item information can not be retrieved")
			end if
			for ll_counter = 1 to this.ids_invoiceinfo.rowcount()
				if ll_icode = this.ids_invoiceinfo.getitemnumber(ll_counter, "icode") then
					if isnull(this.ids_invoiceinfo.getitemstring(ll_counter, "due")) then
						ld_qty = ld_qty + this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty")
					else
						ld_dueqty = ld_dueqty + this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty")
					end if
				end if
			next
			ls_due.qty = ld_qty
			ls_due.dueqty = ld_dueqty
			ls_due.stock = ld_godownstock + ld_qty
		else
			ls_due.qty = 0
			ls_due.dueqty = this.id_detail.getitemnumber(ll_row, "dueqty")
			ls_due.stock = this.id_detail.getitemnumber(ll_row, "stock")
		end if
		ls_due.itemname = this.id_detail.getitemstring(ll_row, "itemname")
		openwithparm(w_dueinfo, ls_due)
		ls_due = message.powerobjectparm
		ld_qty = ls_due.qty
		ld_dueqty = ls_due.dueqty
		setnull(ls_null)
		setnull(li_null)
		if ld_qty >= 0.0 then
			this.id_detail.setitem(ll_row, "looseqty", ld_qty)
			this.id_detail.setitem(ll_row, "dueqty", ld_dueqty)
		end if
		if ld_dueqty > 0.0 then
			this.id_detail.setitem(ll_row, "due", "D")
		else
			this.id_detail.setitem(ll_row, "due", ls_null)
		end if
		return
	end if
	ll_row = this.id_detail.getrow()

// w_inpatientsale.wf_setcustomer() returns integer
	if f_validatedw(this.id_master) < 0 then
		return -1
	end if

// w_inpatientsale.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_inpatientsale.wf_itemsalehistory() returns 0
	s_itemsalehistory ls_itemsalehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itemsalehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itemsalehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itemsalehistory, ls_itemsalehistory)
	end if

// w_inpatientsale.wf_visible(boolean ab_flag) returns 0

// w_inpatientsale.wf_itemnetprice(double al_saleprice, double al_discperc, double al_itemflatdisc, long al_icode) returns integer
	double ld_saleprice
	double ld_recentpurprice
	double ld_discperc
	double ld_itemflatdisc
	double ld_itemnetprice
	integer li_packunits
	integer li_retmsgcode
	SQL Select item.RecentPurPrice , item.packunits INTO :ld_recentpurprice, :li_packunits From Item Where item.icode =:al_icode USING this.it_transobject;
	if li_packunits < 1 or isnull(li_packunits) then
		li_packunits = 1
	end if
	ld_itemnetprice = (al_saleprice - al_itemflatdisc) * (1.0 - al_discperc / 100.0)
	if ld_itemnetprice < ld_recentpurprice / li_packunits then
		li_retmsgcode = messagebox("Sale Validation", "Net Price " + string(ld_itemnetprice) + " is less than Recent Purchase Price~r~n Do you want to continue", question!, yesno!)
		if li_retmsgcode = 1 then
			return 0
		else
			return 1
		end if
		return
	end if
	return 0

// w_inpatientsale.wf_populate_ddlb(datawindow dwcontrol) returns 0
	integer li_column_count
	integer li_counter
	string ls_column_name
	string ls_columntype
	this.tab_retrieve.tabpage_list.ddlb_filter_column.reset()
	this.tab_retrieve.tabpage_list.ddlb_sort.reset()
	li_column_count = integer(dwcontrol.object.datawindow.column.count)
	for li_counter = li_column_count to 1 step -1
		ls_column_name = dwcontrol.describe("#" + string(li_counter) + ".Name")
		this.tab_retrieve.tabpage_list.ddlb_sort.additem(ls_column_name)
		this.tab_retrieve.tabpage_list.ddlb_filter_column.additem(ls_column_name)
	next
	this.tab_retrieve.tabpage_list.ddlb_sort.text = ls_column_name
	ls_columntype = this.id_dwcontrol.describe("#1.ColType")
	if left(ls_columntype, 4) = "char" then
		this.ii_type = 1
	elseif left(ls_columntype, 4) = "date" then
		this.ii_type = 3
	else
		this.ii_type = 2
	end if
	this.ii_colindex = 1
	this.tab_retrieve.tabpage_list.rb_descending.checked = true
	wf_sortdw(this.tab_retrieve.tabpage_list.ddlb_sort.text, this.is_sortsequence)
	if this.ii_saletype = 3 then
		this.id_detail.setfocus()
		return
	end if
	this.id_master.setfocus()

// w_inpatientsale.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_inpatientsale.wf_validategodown() returns integer
	long ll_icode
	long ll_gcode
	long ll_counter
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	string ls_null
	integer li_errcode = 1
	integer li_null
	integer li_option
	integer li_duperr
	boolean ib_due
	double ld_stock
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	this.ii_defaultgcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	if wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			if isnull(this.id_detail.getitemstring(this.il_currrow, "due")) then
				li_errcode = -1
			end if
		else
			for ll_counter = 1 to this.id_detail.rowcount()
				if this.il_currrow <> ll_counter and (ll_icode = this.id_detail.getitemnumber(ll_counter, "icode") and this.ii_defaultgcode = this.id_detail.getitemnumber(ll_counter, "gcode")) then
					li_duperr = -2
				end if
			next
		end if
	end if
	this.ib_godownvalidated = true
	if li_errcode = -1 and not ib_due then
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		this.id_detail.setfocus()
		this.id_detail.setcolumn("gcode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
	end if
	if li_duperr = -2 and not ib_due then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate Item, please select some other item"
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
		this.ib_itemslistopen = true
		this.id_itemslist.show()
		li_errcode = -1
	end if
	return li_errcode

// w_inpatientsale.wf_validateitem(boolean ab_flag) returns integer
	long ll_icode
	long ll_count
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	integer li_option
	integer n
	boolean ib_due
	boolean lb_dupitem
	boolean lb_zerostock
	double ld_stock
	double ld_totalstock
	integer li_null
	string ls_null
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if not isnull(ll_icode) then
		if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
			ls_titleerrtext = "Item Validation"
			ls_errtext = "Duplicate item, please select some other item"
			lb_dupitem = true
			li_errcode = -1
		elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
			if li_errcode = -2 then
				lb_zerostock = true
				if ab_flag and isnull(this.id_detail.getitemstring(this.il_currrow, "due")) then
					li_errcode = -1
				end if
			end if
		else
			ls_titleerrtext = "Item Validation"
		end if
	end if
	if ab_flag then
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		if this.il_strategy = 1 and this.il_godowncount > 1 and lb_zerostock then
			messagebox(ls_titleerrtext, "Stock is zero, please select some other godown")
			this.ib_itemslistopen = false
			this.id_itemslist.hide()
			this.id_detail.setcolumn("gcode")
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.gcode[this.il_currrow] = li_null
		elseif lb_dupitem = true then
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.icode[this.il_currrow] = li_null
			this.id_detail.object.fullcode[this.il_currrow] = ls_null
			this.id_detail.object.itemname[this.il_currrow] = ls_null
			post event ue_deleteitem_row(this.il_currrow)
			for ll_count = 1 to this.id_detail.rowcount()
				if this.id_detail.getitemnumber(ll_count, "icode") = ll_icode then
					this.id_detail.scrolltorow(ll_count)
					triggerevent("ue_focusqty")
				end if
			next
			messagebox("Item", "Duplicate Item, please select some other item")
		else
			ls_titleerrtext = "Item Validation"
			messagebox(ls_titleerrtext, ls_errtext)
			if f_stringpreferences("itemcode") = "N" then
				this.id_detail.setcolumn(this.is_columnitemname)
				this.ib_itemslistopen = true
				this.id_itemslist.show()
			else
				this.id_detail.setcolumn("fullcode")
				this.id_detail.object.fullcode[this.il_currrow] = ls_null
			end if
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.icode[this.il_currrow] = li_null
			this.id_detail.object.itemname[this.il_currrow] = ls_null
		end if
	end if
	return li_errcode

// w_inpatientsale.wf_setgodownoption() returns 0
	this.ii_salegodown = this.id_detail.getitemnumber(1, "gcode")
	if this.il_strategy = 2 or this.il_strategy = 1 and this.il_godowncount = 1 then
		this.id_detail.modify("gcode" + ".Protect=1")
		this.id_detail.object.gcode.background.color = this.backcolor
	end if

// w_inpatientsale.wf_setcustomername(string as_data) returns 0
	long ll_rowno
	ll_rowno = this.idc_customers.find("customer_name >='" + as_data + "'", 1, this.idc_customers.rowcount())
	if ll_rowno > 0 then
		this.idc_customers.selectrow(0, false)
		this.idc_customers.setrow(ll_rowno)
		this.idc_customers.scrolltorow(ll_rowno)
		this.idc_customers.selectrow(ll_rowno, true)
	end if

// w_inpatientsale.wf_findcustcode(string as_aliasname, integer ai_custcode) returns integer
	integer li_custcode
	integer ll_retflag
	string ls_itemname
	SQL SELECT accounts.acccode INTO :li_custcode FROM accounts , customer WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =customer.custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_custcode = li_custcode
		if isnull(ai_custcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_inpatientsale.wf_initmodify(integer ai_protect) returns 0
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_counter = 1
	long ll_count
	double ld_saleprice
	double ld_packsalestax
	double ld_avgprice
	double ld_recentpurprice
	double ld_purprice
	string ls_itemtotalval
	double ld_looseqty
	double ld_bonusqty
	double ld_stock
	double ld_purdiscperc
	long ll_disc_icode
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_saleinvcode = this.id_detail.getitemnumber(1, "code")
		if wf_locksaleinvoice(ll_saleinvcode) = 0 then
			this.id_master.retrieve(ll_saleinvcode)
			this.id_detail.retrieve(ll_saleinvcode)
			this.ids_invoiceinfo.retrieve(ll_saleinvcode)
			for ll_count = 1 to this.id_detail.rowcount()
				ll_icode = this.id_detail.getitemnumber(ll_count, "icode")
				ll_gcode = this.id_detail.getitemnumber(ll_count, "gcode")
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				if this.it_transobject.sqlcode <> 0 then
					ai_protect = 0
				end if
				ld_looseqty = 0
				ld_bonusqty = 0
				for ll_counter = 1 to this.ids_invoiceinfo.rowcount()
					if ll_icode = this.ids_invoiceinfo.getitemnumber(ll_counter, "icode") then
						if isnull(this.ids_invoiceinfo.getitemstring(ll_counter, "due")) then
							ld_looseqty = ld_looseqty + this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty")
							ld_bonusqty = ld_bonusqty + this.ids_invoiceinfo.getitemnumber(ll_counter, "bonusqty")
						end if
						this.id_detail.setitem(ll_count, "stock", ld_stock + ld_looseqty + ld_bonusqty)
						SQL SELECT item.saleprice , item.packsalestax , item.purprice , item.avgprice , item.recentpurprice INTO :ld_saleprice, :ld_packsalestax, :ld_purprice, :ld_avgprice, :ld_recentpurprice FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
						if this.it_transobject.sqlcode = 0 then
							ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
							this.id_detail.setitem(ll_count, "itemtotalval", ls_itemtotalval)
							this.id_detail.setitem(ll_count, "recentpurprice", ld_recentpurprice)
							this.id_detail.setitem(ll_count, "purprice", ld_purprice)
							this.id_detail.setitem(ll_count, "avgprice", ld_avgprice)
						end if
					end if
				next
			next
			if ai_protect = 0 then
				this.ib_modify = true
				this.id_footer.setitem(1, "stock", this.id_detail.getitemnumber(1, "stock"))
				if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
					ll_disc_icode = this.id_detail.getitemnumber(1, "icode")
					SQL Select item.purdiscperc INTO :ld_purdiscperc From Item Where item.icode =:ll_disc_icode USING this.it_transobject;
					this.id_footer.object.t_purdiscper.text = string(ld_purdiscperc)
				end if
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
			return
		end if
		messagebox("Cannot Modify", "Sale invoice is already in use")
	end if

// w_inpatientsale.wf_setcustomerinfo(long row, integer i, string data) returns integer
	long ll_code
	long ll_custcode
	long ll_counter
	long ll_icode
	long ll_customerbalance
	double ld_custgst
	double ld_gstperc1
	double ld_gstperc2
	double ld_itemdiscperc
	double ld_itemdiscperc2
	double ld_itemdiscperc3
	double ld_itemdiscperc4
	double ld_itemdiscperc5
	double ld_saleprice1
	double ld_saleprice2
	double ld_saleprice3
	double ld_invdiscperc
	double ld_saleprice4
	double ld_saleprice5
	double ld_avgprice
	double ld_purunitrate
	double ld_rppunitrate
	double ld_purprice
	double ld_rpp
	integer li_salepriceno
	integer li_itemdiscpercno
	integer li_packunits
	integer li_smancode
	if not isnull(data) and this.ii_saletype = 2 then
		ll_code = long(data)
		this.il_custcode = ll_code
		setredraw(false)
		if wf_customerinfo(ll_code) <> 0 then
			messagebox("Database Error", "Customer information can not be retrieved")
			setredraw(true)
			return 1
		end if
		setredraw(true)
	elseif data = "0" and this.ii_saletype = 2 then
		messagebox("Database Error", "Customer information can not be retrieved")
		return 1
	end if
	if this.id_master.accepttext() = -1 then
		return 1
	end if
	ll_custcode = this.id_master.getitemnumber(row, "custcode")
	SQL SELECT customer.defaultgst , customer.defaultsaleprice , customer.defaultitemdiscperc INTO :ld_custgst, :li_salepriceno, :li_itemdiscpercno FROM customer WHERE customer.custcode =:ll_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		messagebox("Database Error", "Customer information can not be retrieved")
		return 1
	end if
	if not (this.it_transobject.sqlcode = 100) then
		if ld_custgst = 2.0 then
			this.id_master.setitem(1, "dd_gstperc", 2)
		else
			this.id_master.setitem(1, "dd_gstperc", 1)
		end if
	end if
	this.id_master.setitem(1, "itemdiscpercno", li_itemdiscpercno)
	if this.idc_price.find("pricetypecode = " + trim(string(li_salepriceno)), 1, this.idc_price.rowcount()) > 0 then
		this.id_master.setitem(1, "sprice", li_salepriceno)
	else
		messagebox("Price Implementation Problem", "Your Group Wise Allowed Price Setting does not allow you to ~r~napply Default Associated Price For this customer.~r~nHowever System has decided to apply appropriate price automatcially", information!)
		this.id_master.setitem(1, "sprice", this.idc_price.getitemnumber(1, "pricetypecode"))
	end if
	for ll_counter = 1 to this.id_detail.rowcount()
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		if not isnull(ll_icode) then
			SQL SELECT item.gstperc1 , item.gstperc2 , item.salediscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 , item.saleprice , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.packunits , item.avgprice , PurUnitRate =round ( item.purprice / item.packunits , 2 ) , RppUnitRate =round ( item.recentpurprice / item.packunits , 2 ) , item.PurPrice , item.RecentPurPrice INTO :ld_gstperc1, :ld_gstperc2, :ld_itemdiscperc, :ld_itemdiscperc2, :ld_itemdiscperc3, :ld_itemdiscperc4, :ld_itemdiscperc5, :ld_saleprice1, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :li_packunits, :ld_avgprice, :ld_purunitrate, :ld_rppunitrate, :ld_purprice, :ld_rpp FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = -1 then
				messagebox("Database Error", "Item information can not be retrieved")
				return 1
			end if
			if not (this.it_transobject.sqlcode = 100) then
				if ld_custgst = 2.0 then
					this.id_detail.setitem(ll_counter, "gstperc", ld_gstperc2)
				else
					this.id_detail.setitem(ll_counter, "gstperc", ld_gstperc1)
				end if
			end if
			choose case li_salepriceno
			case 1
				this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
				this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice1 / li_packunits)
				this.id_detail.setitem(ll_counter, "packprice", ld_saleprice1)
			case 2
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(ll_counter, "rate", ld_saleprice2 / li_packunits)
				else
					this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
				end if
				this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice2 / li_packunits)
				this.id_detail.setitem(ll_counter, "packprice", ld_saleprice2)
			case 3
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(ll_counter, "rate", ld_saleprice3 / li_packunits)
				else
					this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
				end if
				this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice3 / li_packunits)
				this.id_detail.setitem(ll_counter, "packprice", ld_saleprice3)
			case 4
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(ll_counter, "rate", ld_purprice / li_packunits)
				else
					this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
				end if
				this.id_detail.setitem(ll_counter, "packsaleprice", ld_purprice)
				this.id_detail.setitem(ll_counter, "packprice", ld_purprice)
				this.id_detail.setitem(ll_counter, "saleprice", ld_purprice / li_packunits)
			case 5
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(ll_counter, "rate", ld_rpp / li_packunits)
				else
					this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
				end if
				this.id_detail.setitem(ll_counter, "packsaleprice", ld_rpp)
				this.id_detail.setitem(ll_counter, "packprice", ld_rpp)
				this.id_detail.setitem(ll_counter, "saleprice", ld_rpp / li_packunits)
			case 7
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(ll_counter, "rate", ld_saleprice4 / li_packunits)
				else
					this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
				end if
				this.id_detail.setitem(ll_counter, "packsaleprice", ld_saleprice4)
				this.id_detail.setitem(ll_counter, "packprice", ld_saleprice4)
				this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice4 / li_packunits)
			case 8
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(ll_counter, "rate", ld_saleprice5 / li_packunits)
				else
					this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
				end if
				this.id_detail.setitem(ll_counter, "packsaleprice", ld_saleprice5)
				this.id_detail.setitem(ll_counter, "packprice", ld_saleprice5)
				this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice5 / li_packunits)
			case else
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(ll_counter, "rate", ld_avgprice)
				else
					this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
				end if
				this.id_detail.setitem(ll_counter, "packsaleprice", ld_avgprice * li_packunits)
				this.id_detail.setitem(ll_counter, "packprice", ld_avgprice * li_packunits)
				this.id_detail.setitem(ll_counter, "saleprice", ld_avgprice)
			end choose
			if long(this.id_detail.object.discperc.visible) = 1 then
				choose case li_itemdiscpercno
				case 1
					this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc)
				case 2
					this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc2)
				case 3
					this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc3)
				case 3
					this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc4)
				end choose
			else
				this.id_detail.setitem(ll_counter, "discperc", 0)
			end if
		end if
	next
	SQL Select invdiscperc , salesmancode INTO :ld_invdiscperc, :li_smancode From Customer Where custcode =:ll_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
	end if
	if f_stringpreferences("SalesManInSale") = "Y" then
		this.id_master.setitem(1, "smancode", li_smancode)
	end if
	if f_stringpreferences("InSaleCustomerBalance") = "Y" then
		for ll_counter = 1 to this.ids_customersbalance.rowcount()
			if this.ids_customersbalance.getitemnumber(ll_counter, "code1") = this.id_master.getitemnumber(row, "custcode") then
				this.ii_focuscustomer = 3
				ll_customerbalance = this.ids_customersbalance.getitemnumber(ll_counter, "value1")
				this.id_master.setitem(row, "customerbalance", ll_customerbalance)
				if ll_customerbalance > 0 then
					this.id_master.setitem(row, "debitorcredit", "Dr")
				else
					this.id_master.setitem(row, "debitorcredit", "Cr")
				end if
				return 0
			else
				this.ii_focuscustomer = 3
				this.id_master.setitem(row, "debitorcredit", "Cr")
				this.id_master.setitem(row, "customerbalance", 0)
			end if
		next
	end if
	return 0

// w_inpatientsale.wf_viewheader() returns integer
	s_dw_header ls_dw_header
	string[] ls_values
	string ls_posted
	long ll_row
	long ll_currrow
	integer li_protectdw
	if this.tab_retrieve.selectedtab <> 1 then
		return -1
	end if
	ls_posted = this.id_master.getitemstring(this.id_master.getrow(), "Posted")
	ls_dw_header.dw_header = this.id_master
	if this.ii_saletype = 2 then
		ls_dw_header.s_saletype = "Credit"
	else
		ls_dw_header.s_saletype = "Cash"
	end if
	if this.editflag = false and ls_posted = "Y" then
		ls_dw_header.i_protectdw = 1
	else
		ls_dw_header.i_protectdw = 0
	end if
	openwithparm(w_view_inpatientsaleheader, ls_dw_header)
	ls_dw_header = message.powerobjectparm
	if ls_dw_header.i_closemode = -1 then
		return -1
	end if
	ll_row = this.id_master.getrow()
	ls_values = ls_dw_header.values
	if this.editflag = true then
		this.id_master.setitem(ll_row, "messagecode", integer(ls_values[2]))
		this.id_master.setitem(ll_row, "doctcode", integer(ls_values[3]))
		this.id_master.setitem(ll_row, "relationcode", integer(ls_values[4]))
		this.id_master.setitem(ll_row, "wardcode", integer(ls_values[5]))
		this.id_master.setitem(ll_row, "diseasecode", integer(ls_values[6]))
		this.id_master.setitem(ll_row, "printwaranty", ls_values[7])
		this.id_master.setitem(ll_row, "printbatch", ls_values[8])
		this.id_master.setitem(ll_row, "invoicesize", ls_values[9])
		this.id_master.setitem(ll_row, "smancode", integer(ls_values[10]))
		if this.ii_saletype = 2 then
			this.id_master.setitem(ll_row, "custrefno", ls_values[1])
			this.id_master.setitem(ll_row, "custrefno2", ls_values[11])
			this.id_master.setitem(ll_row, "custrefno3", ls_values[12])
			this.id_master.setitem(ll_row, "custrefno4", ls_values[13])
			this.id_master.setitem(ll_row, "custrefno4", ls_values[14])
		end if
	end if
	return 1

// w_inpatientsale.wf_customerinfo(long al_custcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	string ls_aliasname
	integer li_messagecode
	long ll_currow
	double ld_currbalance
	SQL SELECT customer.address1 , customer.city , customer.phone , customer.messagecode , accounts.aliasname INTO :ls_address, :ls_city, :ls_phone, :li_messagecode, :ls_aliasname FROM customer , accounts WHERE customer.custcode =:al_custcode and customer.custcode =accounts.acccode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
		this.id_master.object.address[ll_currow] = ls_address
		this.id_master.object.aliasname[ll_currow] = ls_aliasname
		this.id_master.object.city[ll_currow] = ls_city
		this.id_master.object.phone[ll_currow] = ls_phone
		if isnull(li_messagecode) then
			this.id_master.object.messagecode[ll_currow] = 1
		else
			this.id_master.object.messagecode[ll_currow] = li_messagecode
		end if
	end if
	return this.it_transobject.sqlcode

// w_inpatientsale.wf_allowsalemodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM SaleDetail WHERE SaleInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_inpatientsale.wf_retrievelist() returns long
	string[] ls_posted
	string ls_showrows = "N"
	integer li_salecategory
	integer li_invforlastdays = -10
	integer li_listrows
	datetime ld_invdate
	long ll_counter
	ld_invdate = datetime(relativedate(today(), li_invforlastdays))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		li_salecategory = this.ii_salecategory
	else
		li_salecategory = this.ii_saletype
	end if
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 538 then
			ls_showrows = "Y"
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 539 then
			this.id_list.object.netamount.visible = true
			this.id_list.object.t_netamount.visible = true
		end if
	next
	if ls_showrows = "N" then
		this.tab_retrieve.tabpage_list.cb_retrieve.enabled = false
		this.tab_retrieve.tabpage_list.em_invno.enabled = false
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, ls_showrows, this.il_groupcode, this.ii_module)

// w_inpatientsale.wf_retrievelistall() returns long
	string[] ls_posted
	string ls_showrows = "N"
	integer li_salecategory
	long ll_counter
	datetime ld_invdate
	ld_invdate = datetime(date("12/12/1998"), time("00:00:00"))
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 538 then
			ls_showrows = "Y"
		end if
	next
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		li_salecategory = this.ii_salecategory
	else
		li_salecategory = this.ii_saletype
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, ls_showrows, this.il_groupcode, this.ii_module)

// w_inpatientsale.wf_selectprintreport() returns string
	string ls_pagesize
	string ls_report
	long ll_currrow
	ll_currrow = this.id_master.getrow()
	ls_pagesize = this.id_master.getitemstring(ll_currrow, "invoicesize")
	if ls_pagesize = "Q" and this.ib_printout then
		if gs_company = "KHYBER" then
			ls_report = "d_khyber_thermal_saleinvrep"
		else
			ls_report = "d_inpatientsaleinvrep"
		end if
	elseif ls_pagesize = "Q" and this.ib_printout = false then
		if gs_company = "KHYBER" then
			ls_report = "d_khyber_thermal_saleinvrep"
		else
			ls_report = "d_inpatientsaleinvrep"
		end if
	elseif ls_pagesize = "F" and this.ib_printout then
		if gs_company = "IHSCHILDRENHSP" then
			ls_report = "d_ihs_inpatient_saleprint"
		elseif gs_company = "SURGICALCENTRE" then
			ls_report = "d_surgicalcentre_wholesaleinvreport_full"
		else
			ls_report = "d_inpatientsaleinvrep_full"
		end if
	elseif ls_pagesize = "F" and this.ib_printout = false then
		if gs_company = "IHSCHILDRENHSP" then
			ls_report = "d_ihs_inpatient_saleprint"
		elseif gs_company = "SURGICALCENTRE" then
			ls_report = "d_surgicalcentre_wholesaleinvreport_full"
		elseif f_stringpreferences("CustBalanceOnPrintOut") = "Y" then
			ls_report = "d_inpatientsaleinvrep_withbalance_full"
		else
			ls_report = "d_inpatientsaleinvrep_full"
		end if
	elseif ls_pagesize = "H" and this.ib_printout then
		ls_report = "d_inpatientsaleinvrep_half"
	elseif ls_pagesize = "H" and this.ib_printout = false then
		if f_stringpreferences("CustBalanceOnPrintOut") = "Y" then
			ls_report = "d_inpatientsaleinvrep_half_headerwise"
		else
			ls_report = "d_inpatientsaleinvrep_half"
		end if
	elseif ls_pagesize = "T" and this.ib_printout then
		ls_report = "d_thermal_retailsaleinvrepwh_3inches"
	elseif ls_pagesize = "T" and this.ib_printout = false then
		if f_stringpreferences("CustBalanceOnPrintOut") = "Y" then
			ls_report = "d_thermal_retailsaleinvrepwh_3inches_bal"
		else
			ls_report = "d_thermal_retailsaleinvrepwh_3inches"
		end if
	else
		ls_report = "d_inpatientsaleinvrep"
	end if
	this.id_print.dataobject = ls_report
	this.id_print.settransobject(this.it_transobject)
	this.ib_printout = true
	return ls_report

// w_inpatientsale.wf_allowinvoice(long al_custcode, long al_lastinvcode) returns long
	long ll_retcode
	long ll_code
	if this.ib_modify then
		ll_code = this.id_master.getitemnumber(this.id_master.rowcount(), "code")
		SQL SELECT COUNT ( CustCode ) , max ( SaleInvCode ) INTO :ll_retcode, :al_lastinvcode FROM SaleLedger WHERE CustCode =:al_custcode and SaleInvCode <> :ll_code and Posted ='N' USING sqlca;
	else
		SQL SELECT COUNT ( CustCode ) , max ( SaleInvCode ) INTO :ll_retcode, :al_lastinvcode FROM SaleLedger WHERE CustCode =:al_custcode and Posted ='N' USING sqlca;
	end if
	return ll_retcode

// w_inpatientsale.wf_getcustomerinfo() returns 0
	long ll_custcode
	if this.id_master = getfocus() and this.id_master.rowcount() > 0 then
		ll_custcode = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		openwithparm(w_customerinfo, ll_custcode)
	end if

// w_inpatientsale.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_inpatientsale.wf_savastemplate() returns integer
	s_saletemplateheader lstr_templateheader
	long ll_invid
	integer li_retcode = 1
	long ll_code
	long ll_qty
	long ll_icode
	long ll_totalrows
	long ll_rowcount
	open(w_savesaleastemplate)
	lstr_templateheader = message.powerobjectparm
	f_newtableid("SaleTemplateHeader", ll_invid)
	SQL INSERT INTO SaleTemplateHeader ( saletemplatecode , date , modified , name ) values ( :ll_invid , :lstr_templateheader.dt_templatedate , :lstr_templateheader.dt_templatedate , :lstr_templateheader.s_template ) USING this.it_transobject;
	ll_totalrows = this.id_detail.rowcount()
	for ll_rowcount = 1 to ll_totalrows
		ll_code = ll_invid
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ll_qty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		SQL insert into saletemplatedetail ( saletemplatecode , icode , looseqty ) values ( :ll_code , :ll_icode , :ll_qty ) USING this.it_transobject;
	next
	setpointer(hourglass!)
	if this.it_transobject.sqlcode < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return li_retcode
	else
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Template saved", exclamation!, ok!, 1)
	end if
	return li_retcode

// w_inpatientsale.wf_setamountoninvoice() returns 0
	long ll_null
	long ll_rightfound
	double ld_netamt
	double ld_null
	string ls_null
	s_amountoninvoice lstr_amountoninvoice
	setnull(ld_null)
	setnull(ls_null)
	setnull(ll_null)
	if this.ii_saletype <> 3 then
		if f_stringpreferences("askmastercashwin_in_inpatientsale") = "Y" then
			return
		end if
		if this.id_master.getitemstring(1, "accountfor") = "Y" then
			ld_netamt = wf_grandtotal()
			if f_stringpreferences("AskAmtOnCreditSale") = "Y" then
				ll_rightfound = 0
				ll_rightfound = gds_securitywindow.find("rightcode = 582", 1, gds_securitywindow.rowcount())
				lstr_amountoninvoice.l_invcode = this.id_master.getitemnumber(1, "code")
				lstr_amountoninvoice.d_netamt = ld_netamt
				lstr_amountoninvoice.d_amt = this.id_master.getitemdecimal(1, "amt")
				if isnull(lstr_amountoninvoice.d_amt) then
					lstr_amountoninvoice.d_balance = ld_netamt
				else
					lstr_amountoninvoice.d_balance = ld_netamt - lstr_amountoninvoice.d_amt
				end if
				if isnull(this.id_master.getitemstring(1, "paymentmode")) then
					this.id_master.setitem(1, "paymentmode", f_stringpreferences("SalePaymentMode"))
					this.id_master.setitem(1, "paymentacccode", f_numberpreferences("SalePaymentAcccode"))
				end if
				lstr_amountoninvoice.c_paymentmode = this.id_master.getitemstring(1, "paymentmode")
				lstr_amountoninvoice.i_acccode = this.id_master.getitemnumber(1, "paymentacccode")
				lstr_amountoninvoice.s_reference = this.id_master.getitemstring(1, "amtreference")
				lstr_amountoninvoice.s_module = "sales"
				if ll_rightfound > 0 then
					openwithparm(w_amountoninvoice, lstr_amountoninvoice)
					lstr_amountoninvoice = message.powerobjectparm
					this.id_master.setitem(1, "amt", lstr_amountoninvoice.d_amt)
					this.id_master.setitem(1, "paymentmode", lstr_amountoninvoice.c_paymentmode)
					this.id_master.setitem(1, "paymentacccode", lstr_amountoninvoice.i_acccode)
					this.id_master.setitem(1, "amtreference", lstr_amountoninvoice.s_reference)
				end if
				if ld_netamt - lstr_amountoninvoice.d_amt >= 0.0 then
					this.id_master.setitem(1, "outstandingamt", ld_netamt - lstr_amountoninvoice.d_amt)
				else
					this.id_master.setitem(1, "outstandingamt", 0)
				end if
			else
				this.id_master.setitem(1, "outstandingamt", ld_netamt)
				this.id_master.setitem(1, "paymentmode", ls_null)
				this.id_master.setitem(1, "paymentacccode", ll_null)
				this.id_master.setitem(1, "amtreference", ls_null)
				this.id_master.setitem(1, "amt", 0)
			end if
		else
			this.id_master.setitem(1, "outstandingamt", 0)
			this.id_master.setitem(1, "paymentmode", ls_null)
			this.id_master.setitem(1, "paymentacccode", ll_null)
			this.id_master.setitem(1, "amtreference", ls_null)
			this.id_master.setitem(1, "amt", 0)
		end if
		return
	end if
	this.id_master.setitem(1, "amt", 0)
	this.id_master.setitem(1, "paymentmode", ls_null)
	this.id_master.setitem(1, "paymentacccode", ll_null)
	this.id_master.setitem(1, "amtreference", ls_null)
	this.id_master.setitem(1, "outstandingamt", 0)

// w_inpatientsale.wf_getcustitemcatwisesalesdiscount(long al_icode, long al_custcode, double ad_discperc) returns boolean
	double ld_null
	setnull(ld_null)
	ad_discperc = ld_null
	SQL SELECT discperc INTO :ad_discperc FROM DBO.CustItemCatWiseSaleDiscount WHERE CustCatCode =ISNULL ( ( SELECT Customer.custcatcode FROM dbo.customer Where Customer.custcode =:al_custcode ) , 0 ) AND ICatCode =ISNULL ( ( SELECT Item.icatcode FROM dbo.Item Where Item.Icode =:al_icode ) , 0 ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ad_discperc) then
			return false
		else
			return true
		end if
		return
	end if
	return false

// w_inpatientsale.wf_getitemsaleprice(long al_icode, double ad_saleprice) returns long
	long ll_retcode
	SQL SELECT saleprice =Round ( saleprice / CASE PackUnits WHEN 0 THEN 1 ELSE PackUnits END , 2 ) INTO :ad_saleprice FROM item WHERE ICode =:al_icode USING sqlca;
	if sqlca.sqlcode = 0 then
		ll_retcode = 0
	else
		ll_retcode = -1
	end if
	return ll_retcode

// w_inpatientsale.wf_inititeminfo_quotation(long al_icode, long al_row, integer ai_rtcode, string as_errortext, long al_gcode) returns boolean
	boolean retflag = true
	double ld_rpp
	double ld_purprice
	double ld_flatdisc
	double ld_invdiscperc
	double ld_discperc2
	double ld_discperc3
	double ld_discperc4
	double ld_saleprice
	double ld_discperc
	double ld_purdiscperc
	double ld_avgprice
	double ld_unitsalestax
	double ld_gstperc1
	double ld_gstperc2
	double ld_packsalestax
	double ld_saleprice2
	double ld_saleprice3
	double ld_saleprice4
	double ld_saleprice5
	double ld_discperc5
	long ll_packunits
	long ll_saleinvcode
	long ll_reorderqty
	long ll_null
	long li_discstatus
	long ll_qtysale
	long ll_bonus
	long ll_itemdesc_status
	integer li_gcode
	integer li_defaultgcode
	integer li_defaultgst
	integer li_custcode
	integer li_flatdiscstatus
	integer li_itemdiscpercno
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_antinorcotix
	string ls_itemtotalval
	string ls_locksaleprice
	string ls_lockdiscperc
	string ls_remarks
	double ld_holdlooseqty
	double ld_desiredbonus
	double ld_godownstock
	double ld_saleqty
	double ld_totalstock
	setnull(ls_null)
	setnull(ll_null)
	SQL SELECT item.customicode , item.name , item.saleprice , item.packunits , item.salediscperc , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.avgprice , item.PurDiscPerc , item.antinorcotix , item.reorderqty , item.purprice , item.recentpurprice , round ( item.Packsalestax / item.packunits , 2 ) , item.gstperc1 , item.gstperc2 , qtysale =item.saleqty , bonus =item.bonusqty , item.Packsalestax , item.flatdisc , item.locksaleprice , item.lockdiscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 , item.remarks INTO :ls_fullcode, :ls_name, :ld_saleprice, :ll_packunits, :ld_discperc, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :ld_avgprice, :ld_purdiscperc, :ls_antinorcotix, :ll_reorderqty, :ld_purprice, :ld_rpp, :ld_unitsalestax, :ld_gstperc1, :ld_gstperc2, :ll_qtysale, :ll_bonus, :ld_packsalestax, :ld_flatdisc, :ls_locksaleprice, :ls_lockdiscperc, :ld_discperc2, :ld_discperc3, :ld_discperc4, :ld_discperc5, :ls_remarks FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
	li_custcode = this.id_master.getitemnumber(1, "custcode")
	if isnull(li_custcode) then
		retflag = false
		as_errortext = "Validation Error: Select Customer "
	end if
	li_defaultgst = this.id_master.getitemnumber(1, "dd_gstperc")
	SQL SELECT InvDiscPerc INTO :ld_invdiscperc FROM customer WHERE customer.custcode =:li_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	li_gcode = al_gcode
	this.it_transobject.getitemstockall(al_icode, ld_totalstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.ib_modify and retflag then
		ll_saleinvcode = this.id_master.getitemnumber(1, "code")
		if wf_getsalesstockinfo(ll_saleinvcode, li_gcode, al_icode, ld_saleqty) <> 0 then
			retflag = false
			as_errortext = "Database Error: Item information can not be retrieved"
		end if
		ld_godownstock = ld_godownstock + ld_saleqty
	end if
	if retflag then
		this.id_detail.setitem(al_row, "gcode", li_gcode)
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		li_discstatus = long(this.id_detail.object.discperc.visible)
		ll_itemdesc_status = long(this.id_detail.object.saleitemdescription.visible)
		li_flatdiscstatus = long(this.id_detail.object.itemflatdisc.visible)
		if li_discstatus = 1 and this.id_detail.getitemstatus(al_row, "discperc", primary!) = notmodified! then
			li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
			if long(this.id_detail.object.discperc.visible) = 1 then
				choose case li_itemdiscpercno
				case 1
					this.id_detail.setitem(al_row, "discperc", ld_discperc)
				case 2
					this.id_detail.setitem(al_row, "discperc", ld_discperc2)
				case 3
					this.id_detail.setitem(al_row, "discperc", ld_discperc3)
				case 4
					this.id_detail.setitem(al_row, "discperc", ld_discperc4)
				case 5
					this.id_detail.setitem(al_row, "discperc", ld_discperc5)
				end choose
			else
				this.id_detail.setitem(al_row, "discperc", 0)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") and li_discstatus = 1 then
			li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
			choose case li_itemdiscpercno
			case 1
				this.id_detail.setitem(al_row, "discperc", ld_discperc)
			case 2
				this.id_detail.setitem(al_row, "discperc", ld_discperc2)
			case 3
				this.id_detail.setitem(al_row, "discperc", ld_discperc3)
			case 4
				this.id_detail.setitem(al_row, "discperc", ld_discperc4)
			case 5
				this.id_detail.setitem(al_row, "discperc", ld_discperc5)
			end choose
		end if
		if this.id_detail.getitemstatus(al_row, "saleprice", primary!) = notmodified! then
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
			case 2.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice2 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice3 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice4 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice5 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_purprice / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_purprice)
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_rpp / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_rpp)
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
			case else
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_avgprice)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
			end choose
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
			case 2.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice2 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice3 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice4 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice5 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_purprice / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_purprice)
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_rpp / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_rpp)
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
			case else
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_avgprice)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
			end choose
		end if
		this.id_detail.setitem(al_row, "icode", al_icode)
		this.id_detail.setitem(al_row, "packunits", ll_packunits)
		this.id_detail.setitem(al_row, "stock", ld_godownstock)
		this.id_detail.setitem(al_row, "totalstock", ld_totalstock)
		this.id_detail.setitem(al_row, "saleorderrowid", ll_null)
		if li_flatdiscstatus = 1 then
			if this.id_detail.getitemstatus(al_row, "itemflatdisc", primary!) = notmodified! then
				this.id_detail.setitem(al_row, "itemflatdisc", ld_flatdisc)
			end if
		else
			this.id_detail.setitem(al_row, "itemflatdisc", 0)
		end if
		if f_stringpreferences("SaleCopyItemRemarks") = "Y" and this.id_detail.getitemstatus(al_row, "saleitemdescription", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "saleitemdescription", ls_remarks)
		end if
		this.id_detail.setitem(al_row, "recentpurprice", ld_rpp)
		this.id_detail.setitem(al_row, "purprice", ld_purprice)
		this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
		this.id_detail.setitem(al_row, "itemtotalval", ls_itemtotalval)
		if f_stringpreferences("bonusinsale") = "Y" then
			this.id_detail.setitem(al_row, "qtysale", ll_qtysale)
			this.id_detail.setitem(al_row, "bonus", ll_bonus)
		end if
		if this.id_detail.getitemstatus(al_row, "Unitsalestax", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
		end if
		if this.id_detail.getitemstatus(al_row, "gstperc", primary!) = notmodified! then
			if li_defaultgst = 2 then
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
			if li_defaultgst = 2 then
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
			end if
			if f_stringpreferences("SaleCopyItemRemarks") = "Y" then
				this.id_detail.setitem(al_row, "saleitemdescription", ls_remarks)
			end if
		end if
		this.id_detail.setitem(al_row, "locksaleprice", ls_locksaleprice)
		this.id_detail.setitem(al_row, "lockdiscperc", ls_lockdiscperc)
		if ld_godownstock = 0.0 then
			ai_rtcode = -2
			as_errortext = "Item can not be sold, its Stock is Zero"
		end if
	else
		retflag = false
		as_errortext = "Item can not be sold, its Stock is Zero"
	end if
	if f_stringpreferences("salepromptforreorder") = "Y" and ll_reorderqty > round(ld_godownstock / ll_packunits, 0) then
		messagebox("Stock", "Stock for this item become~r~n less than ReorderQty")
	end if
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_totalstock)
	this.id_footer.setitem(1, "rpp", ld_rpp)
	this.id_footer.setitem(1, "purprice", ld_purprice)
	this.id_footer.setitem(1, "avgprice", ld_avgprice)
	this.id_footer.setitem(1, "itemtotalval", ls_itemtotalval)
	if this.id_footer.getitemstatus(1, "invdiscperc", primary!) = notmodified! and this.ib_modify = false then
		this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
	end if
	if f_stringpreferences("bonusinsale") = "Y" then
		this.id_footer.setitem(1, "bonusratio", trim(string(ll_qtysale)) + ":" + trim(string(ll_bonus)))
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			ld_holdlooseqty = this.id_detail.getitemnumber(al_row, "looseqty")
			if this.id_detail.getitemnumber(al_row, "qtysale") = 0.0 then
				ld_desiredbonus = 0
			else
				ld_desiredbonus = ld_holdlooseqty / double(this.id_detail.getitemnumber(al_row, "qtysale")) * double(this.id_detail.getitemnumber(al_row, "Bonus"))
			end if
			if ld_holdlooseqty + ld_desiredbonus <= ld_godownstock then
				this.id_detail.setitem(al_row, "bonusqty", ld_desiredbonus)
			elseif ld_holdlooseqty > ld_godownstock then
				messagebox("Quantity Validation", "Quantity " + string(ld_holdlooseqty) + " exceeds stock " + string(ld_godownstock) + ".")
				this.id_detail.setitem(al_row, "looseqty", 1)
				this.id_detail.setitem(al_row, "bonusqty", 0)
			else
				ld_desiredbonus = messagebox("Problem allocating bonus", "Sale Qty = " + string(ld_holdlooseqty) + " ~r" + "Required Bonus = " + trim(string(ld_desiredbonus)) + " ~r" + "Stock available = " + trim(string(ld_godownstock)) + " ~r" + "Allocate possible bonus?", question!, yesno!, 2)
				if ld_desiredbonus = 1.0 then
					this.id_detail.setitem(al_row, "bonusqty", ld_godownstock - ld_holdlooseqty)
				else
					retflag = false
					this.id_detail.setitem(al_row, "bonusqty", 0)
				end if
			end if
		end if
	end if
	this.id_footer.object.t_purdiscper.text = string(ld_purdiscperc)
	this.id_detail.setitem(al_row, "itemcode", al_icode)
	if ls_antinorcotix = "Y" and retflag = true and not (this.il_norcotixcode = al_icode) then
		messagebox("Item Validation", "This is Narcotics item ~r~n please type Doctor name in remarks")
		this.il_norcotixcode = al_icode
	end if
	return retflag

// w_inpatientsale.wf_editquotation() returns integer
	datastore lds_quotationdetail
	datastore lds_quotationheader
	datastore lds_items
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_option
	long ll_currrow
	long ll_packunits
	long ll_found
	long ll_populatecount
	long ll_drow
	long ll_ds_row
	long ll_loosepack
	integer li_retcode = 1
	integer li_errcode
	string ls_errortext
	string ls_itemname
	boolean lb_enablesave
	boolean lb_editsaleprice
	boolean lb_insertrow
	double ld_price
	double ld_tmpprice
	double ld_qty
	double ld_bonusqty
	if wf_iseditable() = false then
		return 0
	end if
	lds_quotationdetail = create datastore
	lds_quotationheader = create datastore
	lds_items = create datastore
	open(w_editquotationform)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_quotationdetail.dataobject = "d_quotationdetail_retrieve"
		lds_quotationdetail.settransobject(this.it_transobject)
		lds_quotationheader.dataobject = "d_quotationheader"
		lds_quotationheader.settransobject(this.it_transobject)
		lds_items.dataobject = "d_quotation_salepopulation_rejected"
		lds_items.settransobject(this.it_transobject)
		ll_row = lds_quotationheader.retrieve(lstr_template.l_invtemplate)
		lds_quotationdetail.retrieve(lstr_template.l_invtemplate)
		ll_totalrows = lds_quotationheader.retrieve(lstr_template.l_invtemplate)
		if ll_row < 0 then
			li_retcode = -1
		end if
		setredraw(false)
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 511", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			lb_editsaleprice = true
		end if
		ll_mrow = this.id_master.getrow()
		this.id_master.setitem(ll_mrow, "quotationno", lstr_template.l_invtemplate)
		if this.ii_saletype = 2 then
			this.id_master.setitem(ll_mrow, "custcode", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "custcode"))
		end if
		this.id_master.setitem(ll_mrow, "sprice", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "sprice"))
		this.id_master.setitem(ll_mrow, "remarks", lds_quotationheader.getitemstring(lds_quotationheader.getrow(), "remarks"))
		this.id_master.setitem(ll_mrow, "headerno", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "headerno"))
		this.id_footer.setitem(ll_mrow, "misccharges", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "misccharges"))
		ll_loosepack = lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "loosepack")
		this.id_footer.setitem(ll_mrow, "flatdisc", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "flatdisc"))
		ll_totalrows = lds_quotationdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for ll_rowcount = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		this.id_detail.reset()
		for ll_rowcount = 1 to ll_totalrows
			lb_insertrow = false
			if lb_editsaleprice = false then
				if wf_getitemsaleprice(lds_quotationdetail.getitemnumber(ll_rowcount, "icode"), ld_tmpprice) = 0 then
					if ll_loosepack = 1 then
						ld_price = lds_quotationdetail.getitemnumber(ll_rowcount, "saleprice")
					else
						ld_price = round(lds_quotationdetail.getitemnumber(ll_rowcount, "saleprice") / ll_packunits, 2)
					end if
					if ld_price = ld_tmpprice then
						lb_insertrow = true
					else
						ll_option = messagebox("Problem in Quotation Population!", "System Pricing Policy does not permit the quoted price~r~nPopulate Item with fresh price(s)?", question!, yesno!)
					end if
					if ll_option = 1 then
						lb_insertrow = true
					end if
				else
					lb_insertrow = false
				end if
			else
				lb_insertrow = true
			end if
			if lb_insertrow = true then
				ll_populatecount = ll_populatecount + 1
				ll_drow = this.id_detail.insertrow(0)
				li_errcode = 0
				ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_quotationdetail.getitemnumber(ll_rowcount, "gcode")), 1, this.idc_godown.rowcount())
				ls_itemname = lds_quotationdetail.getitemstring(ll_rowcount, "itemname")
				if ll_validgodowncode = 0 or this.il_strategy = 2 or this.il_godowncount = 1 then
					wf_inititeminfo(lds_quotationdetail.getitemnumber(ll_rowcount, "icode"), ll_drow, li_errcode, ls_errortext)
				else
					ll_gcode = lds_quotationdetail.getitemnumber(ll_rowcount, "gcode")
					this.id_detail.setitem(ll_drow, "gcode", ll_gcode)
					wf_inititeminfo_quotation(lds_quotationdetail.getitemnumber(ll_rowcount, "icode"), ll_drow, li_errcode, ls_errortext, ll_gcode)
				end if
				ll_packunits = lds_quotationdetail.getitemnumber(ll_rowcount, "packunits")
				if ll_packunits = 0 then
					ll_packunits = 1
				end if
				this.id_detail.setitem(ll_drow, "packunits", ll_packunits)
				if ll_loosepack = 1 then
					ld_qty = lds_quotationdetail.getitemnumber(ll_rowcount, "looseqty")
					ld_bonusqty = lds_quotationdetail.getitemnumber(ll_rowcount, "bonusqty")
					if lb_editsaleprice = false and ld_price <> ld_tmpprice then
						ld_price = ld_tmpprice
					else
						ld_price = lds_quotationdetail.getitemnumber(ll_rowcount, "saleprice")
					end if
				else
					ld_qty = lds_quotationdetail.getitemnumber(ll_rowcount, "looseqty") * ll_packunits
					ld_bonusqty = lds_quotationdetail.getitemnumber(ll_rowcount, "bonusqty") * ll_packunits
					if lb_editsaleprice = false and ld_price <> ld_tmpprice then
						ld_price = ld_tmpprice
					else
						ld_price = round(lds_quotationdetail.getitemnumber(ll_rowcount, "saleprice") / ll_packunits, 2)
					end if
				end if
				this.id_detail.setitem(ll_drow, "looseqty", ld_qty)
				this.id_detail.setitem(ll_drow, "bonusqty", ld_bonusqty)
				this.id_detail.setitem(ll_drow, "saleprice", ld_price)
				this.id_detail.setitem(ll_drow, "discperc", lds_quotationdetail.getitemnumber(ll_rowcount, "discperc"))
				this.id_detail.setitem(ll_drow, "itemflatdisc", lds_quotationdetail.getitemnumber(ll_rowcount, "itemflatdisc"))
				if ld_qty + ld_bonusqty > this.id_detail.getitemnumber(ll_drow, "stock") then
					ll_ds_row = lds_items.insertrow(0)
					lds_items.setitem(ll_ds_row, "icode", lds_quotationdetail.getitemnumber(ll_rowcount, "icode"))
					lds_items.setitem(ll_ds_row, "aliasname", this.id_detail.getitemstring(ll_drow, "fullcode"))
					lds_items.setitem(ll_ds_row, "itemname", lds_quotationdetail.getitemstring(ll_rowcount, "itemname"))
					lds_items.setitem(ll_ds_row, "qty", ld_qty)
					lds_items.setitem(ll_ds_row, "stock", this.id_detail.getitemnumber(ll_drow, "stock"))
					this.id_detail.setrow(ll_drow)
					this.id_detail.scrolltorow(ll_drow)
					event ue_deleteitem()
				end if
			end if
		next
		this.id_footer.setitem(ll_mrow, "invdiscperc", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "discperc"))
		setredraw(true)
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	if lds_items.rowcount() > 0 then
		openwithparm(w_quotation_salepopulation_rejected, lds_items)
	end if
	wf_grandtotal()
	return li_retcode

// w_inpatientsale.wf_populatesaledetail(long al_invid, datawindow ad_saledetail, string as_errortext, long al_errorrow) returns boolean
	long ll_detailrows
	long ll_gcode
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode = 1
	long li_counter
	long li_innercounter
	long ll_insertedrows
	long ll_itemsdetailrowcount
	long ll_row
	double ld_stock
	double ld_newstock
	double ld_total_availablestock
	double ld_salelooseqty
	double ld_dueqty
	double ld_looseqty
	double ld_bonusqty
	double ld_totalstock
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	double ld_rate
	double ld_itemflatdisc
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_packprice
	double ld_gstperc
	double ld_unitsalestax
	boolean lb_commitflag = true
	string ls_batch
	string ls_updatesaleprice
	string ls_updsaleprice
	string ls_saleitemdescription
	string ls_claimable
	datetime ld_expiry
	dwitemstatus ldws_column
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	ll_itemsdetailrowcount = 0
	ls_updatesaleprice = f_stringpreferences("updatesaleprice")
	as_errortext = "    Some database problem ocuurs         "
	do while li_counter <= ll_detailrows and lb_commitflag
		ll_gcode = this.id_detail.getitemnumber(li_counter, "gcode")
		ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
		ld_salelooseqty = this.id_detail.getitemnumber(li_counter, "looseqty")
		ld_dueqty = this.id_detail.getitemnumber(li_counter, "dueqty")
		ll_packunits = this.id_detail.getitemnumber(li_counter, "packunits")
		ld_saleprice = this.id_detail.getitemnumber(li_counter, "saleprice")
		ld_packprice = this.id_detail.getitemnumber(li_counter, "packprice")
		ld_discperc = this.id_detail.getitemnumber(li_counter, "discperc")
		ld_rate = this.id_detail.getitemnumber(li_counter, "rate")
		ld_itemflatdisc = this.id_detail.getitemnumber(li_counter, "itemflatdisc")
		ls_saleitemdescription = this.id_detail.getitemstring(li_counter, "saleitemdescription")
		ld_unitsalestax = this.id_detail.getitemnumber(li_counter, "unitsalestax")
		ld_bonusqty = this.id_detail.getitemnumber(li_counter, "bonusqty")
		ld_gstperc = this.id_detail.getitemnumber(li_counter, "gstperc")
		ls_claimable = this.id_detail.getitemstring(li_counter, "claimable")
		ldws_column = this.id_detail.getitemstatus(li_counter, "saleprice", primary!)
		ls_updsaleprice = this.id_detail.getitemstring(li_counter, "updatesaleprice")
		ld_salelooseqty = ld_salelooseqty - ld_dueqty
		this.it_transobject.getitemavgpriceforsale(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			this.it_transobject.getitemstockall(ll_icode, ld_total_availablestock)
			if ld_salelooseqty + ld_bonusqty > 0.0 and lb_commitflag then
				if wf_selectitembatches(ll_gcode, ll_icode, ld_salelooseqty, ld_bonusqty, ad_saledetail, ll_insertedrows, as_errortext) = 0 then
					for li_innercounter = 1 to ll_insertedrows
						ll_row = ll_itemsdetailrowcount + li_innercounter
						ad_saledetail.setitem(ll_row, "code", al_invid)
						ad_saledetail.setitem(ll_row, "packunits", ll_packunits)
						ad_saledetail.setitem(ll_row, "saleprice", ld_saleprice)
						ad_saledetail.setitem(ll_row, "packprice", ld_packprice)
						ad_saledetail.setitem(ll_row, "discperc", ld_discperc)
						ad_saledetail.setitem(ll_row, "rate", ld_rate)
						ad_saledetail.setitem(ll_row, "avgprice", ld_avgprice)
						ad_saledetail.setitem(ll_row, "itemflatdisc", ld_itemflatdisc)
						ad_saledetail.setitem(ll_row, "saleitemdescription", ls_saleitemdescription)
						ad_saledetail.setitem(ll_row, "unitsalestax", ld_unitsalestax)
						ad_saledetail.setitem(ll_row, "gstperc", ld_gstperc)
						ad_saledetail.setitem(ll_row, "claimable", ls_claimable)
						ld_totalstock = ad_saledetail.getitemnumber(ll_row, "totalstock")
						ad_saledetail.setitem(ll_row, "godownbalancestock", ld_totalstock - ld_salelooseqty - ld_bonusqty)
						ls_batch = ad_saledetail.getitemstring(ll_row, "batch")
						ld_expiry = ad_saledetail.getitemdatetime(ll_row, "expiry")
						ld_looseqty = ad_saledetail.getitemnumber(ll_row, "looseqty")
						ld_stock = ad_saledetail.getitemnumber(ll_row, "stock")
						ld_bonusqty = ad_saledetail.getitemnumber(ll_row, "bonusqty")
						ld_newstock = ld_stock - ld_looseqty - ld_bonusqty
						if ld_newstock > 0.0 then
							this.it_transobject.saleupdateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock, ld_stock)
						else
							this.it_transobject.deleteitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
						end if
						if this.it_transobject.sqlcode <> 0 then
							lb_commitflag = false
							as_errortext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
						end if
						ld_total_availablestock = ld_total_availablestock - ld_looseqty - ld_bonusqty
						ad_saledetail.setitem(ll_row, "balancestock", ld_total_availablestock)
					next
					ll_itemsdetailrowcount = ll_itemsdetailrowcount + ll_insertedrows
				else
					this.id_detail.setitem(li_counter, "stock", ld_totalstock)
					lb_commitflag = false
				end if
			end if
			if ld_dueqty > 0.0 and lb_commitflag then
				ll_itemsdetailrowcount = ll_itemsdetailrowcount + 1
				ad_saledetail.insertrow(0)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "gcode", ll_gcode)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "icode", ll_icode)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "batch", "Due")
				ad_saledetail.setitem(ll_itemsdetailrowcount, "expiry", relativedate(today(), 365))
				ad_saledetail.setitem(ll_itemsdetailrowcount, "stock", ld_stock)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "totalstock", 0)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "looseqty", ld_dueqty)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "due", "D")
				ad_saledetail.setitem(ll_itemsdetailrowcount, "balancestock", ld_total_availablestock)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "godownbalancestock", ld_totalstock)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "code", al_invid)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "packunits", ll_packunits)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "saleprice", ld_saleprice)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "packprice", ld_packprice)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "discperc", ld_discperc)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "rate", ld_rate)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "avgprice", ld_avgprice)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "itemflatdisc", ld_itemflatdisc)
			end if
		else
			lb_commitflag = false
		end if
		li_counter = li_counter + 1
	loop
	if not lb_commitflag then
		al_errorrow = li_counter - 1
		messagebox("Database Error", as_errortext)
	end if
	SQL rollback USING sqlca;
	ul_rowcount = ad_saledetail.rowcount()
	sqlca.getmaxutn(ul_rowcount, ul_maxutn)
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
	else
		SQL rollback USING sqlca;
		messagebox("SAVING", " Error in generating Utn ")
		return false
	end if
	for li_counter = 1 to ad_saledetail.rowcount()
		ad_saledetail.setitem(li_counter, "SaleUtn", ul_maxutn)
		ul_maxutn = ul_maxutn + 1
	next
	return lb_commitflag

// w_inpatientsale.wf_setcomments() returns integer
	s_quotationremarks ls_quotationremarks
	ls_quotationremarks.remarks2 = this.id_master.getitemstring(1, "salecomments1")
	ls_quotationremarks.remarks3 = this.id_master.getitemstring(1, "salecomments2")
	openwithparm(w_salecomments, ls_quotationremarks)
	ls_quotationremarks = message.powerobjectparm
	this.id_master.setitem(1, "salecomments1", ls_quotationremarks.remarks2)
	this.id_master.setitem(1, "salecomments2", ls_quotationremarks.remarks3)
	return 1

// w_inpatientsale.wf_get_patientadmission(long al_prescode) returns long
	long ll_admissioncode
	SQL SELECT PatientAdmission.AdmissionCode INTO :ll_admissioncode FROM PatientAdmission WHERE PatientAdmission.Discharged ='N' ANd PatientAdmission.Discharged1 ='N' ANd PatientAdmission.PatientCode IN ( Select patientcode From PrescriptionHeader Where PresCode =:al_prescode ) USING sqlca;
	if sqlca.sqlcode = 0 then
		return ll_admissioncode
	end if
	return -1

// w_inpatientsale.wf_populate_prescription() returns long
	datastore lds_prescdetail
	datastore lds_prescheader
	dwobject dwo
	s_arguements lstr_arg
	long ll_prescode
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrow
	long ll_counter
	long ll_patientcode
	long ll_null
	long ll_admissioncode
	long ll_masterrow
	integer li_retcode = 1
	integer li_errcode
	integer ll_found
	integer ll_innercounter
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	double ld_satisfiedqty
	double ld_newqty
	double ld_qty
	double ld_holdqty
	double ld_holdbonusqty
	double ld_looseqty
	if wf_iseditable() = false then
		return 0
	end if
	open(w_copyprescription)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 0 then
		ll_prescode = lstr_arg.l_code1
		lds_prescdetail = create datastore
		lds_prescheader = create datastore
		lds_prescheader.dataobject = "d_prescription_header"
		lds_prescheader.settransobject(this.it_transobject)
		ll_masterrow = lds_prescheader.retrieve(ll_prescode)
		if ll_masterrow < 0 then
			return -1
		end if
		lds_prescdetail.dataobject = "d_prescription_detail"
		lds_prescdetail.settransobject(this.it_transobject)
		ll_totalrows = lds_prescdetail.retrieve(ll_prescode)
		if ll_totalrows < 0 then
			return -1
		end if
		ll_totalrows = lds_prescdetail.rowcount()
		ll_admissioncode = wf_get_patientadmission(ll_prescode)
		if ll_admissioncode > 0 then
			this.id_master.object.remarks[this.id_master.rowcount()] = lds_prescheader.object.remarks[ll_masterrow]
			this.id_master.object.doctcode[this.id_master.rowcount()] = lds_prescheader.object.doctcode[ll_masterrow]
			this.id_master.object.custrefno[this.id_master.rowcount()] = lds_prescheader.object.refno[ll_masterrow]
			dwo = this.id_master.object.admissioncode
			this.id_master.setcolumn("admissioncode")
			this.id_master.setitem(this.id_master.getrow(), "admissioncode", ll_admissioncode)
			this.id_master.setitem(this.id_master.getrow(), "prescode", ll_prescode)
			this.id_master.setitem(1, "patientregno", this.idc_patient.getitemstring(this.idc_patient.getrow(), "regno"))
			this.id_master.event itemchanged(1, dwo, string(ll_admissioncode))
			if this.ii_saletype = 2 and long(this.id_master.object.admissioncode.visible) = 0 then
				this.id_master.object.custcode.protect = 0
				this.id_master.object.aliasname.protect = 0
			end if
			ll_rowcount = this.id_detail.rowcount()
			for ll_counter = 1 to ll_rowcount
				event ue_deleteitem()
			next
			for ll_counter = 1 to ll_totalrows
				ld_qty = lds_prescdetail.getitemnumber(ll_counter, "noofunits") * lds_prescdetail.getitemnumber(ll_counter, "dosefactor")
				ll_icode = lds_prescdetail.getitemnumber(ll_counter, "icode")
				sqlca.getsatisfiedqty_for_prescription(ll_prescode, ll_icode, ld_satisfiedqty)
				if sqlca.sqlcode = 0 then
					ld_newqty = ld_qty - ld_satisfiedqty
					if ld_newqty > 0.0 then
						ll_insertedrow = this.id_detail.insertrow(0)
						wf_inititeminfo(ll_icode, ll_insertedrow, li_errcode, ls_errortext)
						this.id_detail.setitem(ll_insertedrow, "looseqty", ld_newqty)
						lb_enablesave = true
					end if
				else
					messagebox("Fetch Error", "Unable to fetch already issued qty against this prescription for item Code = " + string(ll_icode))
				end if
			next
			if lb_enablesave then
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_print.enabled = true
				wf_grandtotal()
			else
				setnull(ll_null)
				this.id_master.setitem(this.id_master.getrow(), "prescode", ll_null)
				messagebox("Items Validation", "No items left to populate for this prescription.")
			end if
		end if
		destroy lds_prescdetail
	end if
	return 0

// w_inpatientsale.wf_findpatientcode(long al_admissioncode) returns long
	long ll_patientcode
	SQL SELECT PatientCode INTO :ll_patientcode FROM PatientAdmission WHERE AdmissionCode =:al_admissioncode USING this.it_transobject;
	return ll_patientcode

// w_inpatientsale.wf_setadmissiondetails(long al_admissioncode) returns long
	long ll_retflag
	long ll_doctcode
	long ll_locationcode
	long ll_patientcode
	SQL SELECT patientadmission.doctorcode , patientadmission.locationcode , patientcode INTO :ll_doctcode, :ll_locationcode, :ll_patientcode FROM patientadmission WHERE patientadmission.Admissioncode =:al_admissioncode AND patientadmission.discharged1 ='N' and patientadmission.discharged ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.object.doctcode[this.id_master.getrow()] = ll_doctcode
		this.id_master.object.locationcode[this.id_master.getrow()] = ll_locationcode
		wf_set_patientbalance(ll_patientcode)
		ll_retflag = 1
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_inpatientsale.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_discountvalue
	double ld_invtaxperc1val
	double ld_intaxperc1
	double ld_totaltax
	double ld_totalitemleveltax
	real lr_discperc
	real lr_flatdisc
	real lr_misccharges
	real lr_salestax
	real lr_itemstotal
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		lr_discperc = this.id_footer.object.invdiscperc[1]
		lr_flatdisc = this.id_footer.object.flatdisc[1]
		lr_misccharges = this.id_footer.object.misccharges[1]
		lr_salestax = this.id_footer.object.salestax[1]
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
		ld_intaxperc1 = this.id_footer.object.invgstperc1[1]
		ld_totalitemleveltax = this.id_detail.getitemnumber(1, "c_sumtaxval") + this.id_detail.getitemnumber(1, "c_sumgstval")
		this.id_footer.object.t_discountvalue.text = string(ld_detaildwtotal * lr_discperc * 0.01, "########0.00")
		ld_discountvalue = ld_detaildwtotal * lr_discperc * 0.01
		ld_grandtotal = ld_detaildwtotal - ld_discountvalue - lr_flatdisc + lr_misccharges + lr_salestax
		ld_invtaxperc1val = round((ld_detaildwtotal - ld_discountvalue - lr_flatdisc) * ld_intaxperc1 * 0.01, 2)
		ld_totaltax = round(ld_invtaxperc1val + ld_totalitemleveltax, 0)
		ld_grandtotal = round(ld_grandtotal, 0) + ld_totaltax
		this.id_footer.setitem(1, "total", ld_grandtotal)
	end if
	return ld_grandtotal

// w_inpatientsale.wf_inititeminfo(long al_icode, long al_row, integer ai_rtcode, string as_errortext) returns boolean
	boolean retflag = true
	double ld_rpp
	double ld_purprice
	double ld_flatdisc
	double ld_invdiscperc
	double ld_discperc2
	double ld_discperc3
	double ld_discperc4
	double ld_saleprice
	double ld_discperc
	double ld_purdiscperc
	double ld_avgprice
	double ld_unitsalestax
	double ld_gstperc1
	double ld_gstperc2
	double ld_packsalestax
	double ld_saleprice2
	double ld_saleprice3
	double ld_saleprice4
	double ld_saleprice5
	double ld_discperc5
	double ld_retailprice
	double ld_custitemcatdiscperc
	long ll_packunits
	long ll_saleinvcode
	long ll_reorderqty
	long li_discstatus
	long ll_qtysale
	long ll_bonus
	long ll_itemdesc_status
	long ll_null
	integer li_gcode
	integer li_defaultgcode
	integer li_defaultgst
	integer li_custcode
	integer li_flatdiscstatus
	integer li_itemdiscpercno
	integer li_icatcode
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_antinorcotix
	string ls_itemtotalval
	string ls_locksaleprice
	string ls_lockdiscperc
	string ls_remarks
	string ls_packingdesc
	double ld_holdlooseqty
	double ld_desiredbonus
	double ld_godownstock
	double ld_saleqty
	double ld_totalstock
	double ld_rppmargin
	setnull(ls_null)
	setnull(ll_null)
	SQL SELECT item.customicode , item.name , item.saleprice , item.packunits , item.salediscperc , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.avgprice , item.PurDiscPerc , item.antinorcotix , item.reorderqty , item.purprice , item.recentpurprice , round ( item.Packsalestax / item.packunits , 2 ) , item.gstperc1 , item.gstperc2 , qtysale =item.saleqty , bonus =item.bonusqty , item.Packsalestax , item.flatdisc , item.locksaleprice , item.lockdiscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 , item.remarks , item.retailprice , item.icatcode , item.packingdesc INTO :ls_fullcode, :ls_name, :ld_saleprice, :ll_packunits, :ld_discperc, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :ld_avgprice, :ld_purdiscperc, :ls_antinorcotix, :ll_reorderqty, :ld_purprice, :ld_rpp, :ld_unitsalestax, :ld_gstperc1, :ld_gstperc2, :ll_qtysale, :ll_bonus, :ld_packsalestax, :ld_flatdisc, :ls_locksaleprice, :ls_lockdiscperc, :ld_discperc2, :ld_discperc3, :ld_discperc4, :ld_discperc5, :ls_remarks, :ld_retailprice, :li_icatcode, :ls_packingdesc FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
	li_custcode = this.id_master.getitemnumber(1, "custcode")
	if isnull(li_custcode) then
		retflag = false
		as_errortext = "Validation Error: Select Customer "
	end if
	li_defaultgst = this.id_master.getitemnumber(1, "dd_gstperc")
	SQL SELECT InvDiscPerc INTO :ld_invdiscperc FROM customer WHERE customer.custcode =:li_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
	else
		if this.il_strategy = 2 then
			li_gcode = wf_getitemassociategcode(al_icode)
		end if
		if this.il_strategy = 1 then
			li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
		end if
	end if
	this.it_transobject.getitemstockall(al_icode, ld_totalstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if retflag then
		this.id_detail.setitem(al_row, "gcode", li_gcode)
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		li_discstatus = long(this.id_detail.object.discperc.visible)
		ll_itemdesc_status = long(this.id_detail.object.saleitemdescription.visible)
		li_flatdiscstatus = long(this.id_detail.object.itemflatdisc.visible)
		if li_discstatus = 1 and this.id_detail.getitemstatus(al_row, "discperc", primary!) = notmodified! then
			li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
			if wf_getcustitemcatwisesalesdiscount(al_icode, li_custcode, ld_custitemcatdiscperc) = true then
				this.id_detail.setitem(al_row, "discperc", ld_custitemcatdiscperc)
			elseif long(this.id_detail.object.discperc.visible) = 1 then
				choose case li_itemdiscpercno
				case 1
					this.id_detail.setitem(al_row, "discperc", ld_discperc)
				case 2
					this.id_detail.setitem(al_row, "discperc", ld_discperc2)
				case 3
					this.id_detail.setitem(al_row, "discperc", ld_discperc3)
				case 4
					this.id_detail.setitem(al_row, "discperc", ld_discperc4)
				case 5
					this.id_detail.setitem(al_row, "discperc", ld_discperc5)
				end choose
			else
				this.id_detail.setitem(al_row, "discperc", 0)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") and li_discstatus = 1 then
			li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
			if wf_getcustitemcatwisesalesdiscount(al_icode, li_custcode, ld_custitemcatdiscperc) = true then
				this.id_detail.setitem(al_row, "discperc", ld_custitemcatdiscperc)
			else
				choose case li_itemdiscpercno
				case 1
					this.id_detail.setitem(al_row, "discperc", ld_discperc)
				case 2
					this.id_detail.setitem(al_row, "discperc", ld_discperc2)
				case 3
					this.id_detail.setitem(al_row, "discperc", ld_discperc3)
				case 4
					this.id_detail.setitem(al_row, "discperc", ld_discperc4)
				case 5
					this.id_detail.setitem(al_row, "discperc", ld_discperc5)
				end choose
			end if
		end if
		if this.id_detail.getitemstatus(al_row, "saleprice", primary!) = notmodified! then
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
			case 2.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice2 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice3 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice4 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice5 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_purprice / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_purprice)
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_rpp / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_rpp)
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
			case else
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_avgprice)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
			end choose
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
			case 2.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice2 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice3 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice4 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice5 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_purprice / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_purprice)
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_rpp / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_rpp)
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
			case else
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_avgprice)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
			end choose
		end if
		this.id_detail.setitem(al_row, "icode", al_icode)
		this.id_detail.setitem(al_row, "packunits", ll_packunits)
		this.id_detail.setitem(al_row, "stock", ld_godownstock)
		this.id_detail.setitem(al_row, "packingdesc", ls_packingdesc)
		this.id_detail.setitem(al_row, "totalstock", ld_totalstock)
		this.id_detail.setitem(al_row, "retailprice", ld_retailprice / ll_packunits)
		this.id_detail.setitem(al_row, "saleorderrowid", ll_null)
		if li_flatdiscstatus = 1 then
			if this.id_detail.getitemstatus(al_row, "itemflatdisc", primary!) = notmodified! then
				this.id_detail.setitem(al_row, "itemflatdisc", ld_flatdisc)
			end if
		else
			this.id_detail.setitem(al_row, "itemflatdisc", 0)
		end if
		if f_stringpreferences("SaleCopyItemRemarks") = "Y" and this.id_detail.getitemstatus(al_row, "saleitemdescription", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "saleitemdescription", ls_remarks)
		end if
		this.id_detail.setitem(al_row, "recentpurprice", ld_rpp)
		this.id_detail.setitem(al_row, "purprice", ld_purprice)
		this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
		this.id_detail.setitem(al_row, "itemtotalval", ls_itemtotalval)
		if f_stringpreferences("bonusinsale") = "Y" then
			this.id_detail.setitem(al_row, "qtysale", ll_qtysale)
			this.id_detail.setitem(al_row, "bonus", ll_bonus)
		end if
		if this.id_detail.getitemstatus(al_row, "Unitsalestax", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
		end if
		if this.id_detail.getitemstatus(al_row, "gstperc", primary!) = notmodified! then
			if li_defaultgst = 2 then
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
			if li_defaultgst = 2 then
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
			end if
			if f_stringpreferences("SaleCopyItemRemarks") = "Y" then
				this.id_detail.setitem(al_row, "saleitemdescription", ls_remarks)
			end if
		end if
		this.id_detail.setitem(al_row, "locksaleprice", ls_locksaleprice)
		this.id_detail.setitem(al_row, "lockdiscperc", ls_lockdiscperc)
		if ld_godownstock = 0.0 then
			ai_rtcode = -2
			as_errortext = "Item can not be sold, its Stock is Zero"
		end if
	else
		retflag = false
		as_errortext = "Item can not be sold, its Stock is Zero"
	end if
	if f_stringpreferences("salepromptforreorder") = "Y" and ll_reorderqty > round(ld_godownstock / ll_packunits, 0) then
		messagebox("Stock", "Stock for this item become~r~n less than ReorderQty")
	end if
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_totalstock)
	this.id_footer.setitem(1, "retailprice", ld_retailprice / ll_packunits)
	ld_rppmargin = this.id_detail.object.packprice[al_row] - ld_rpp
	if this.id_detail.object.packprice[al_row] = 0 then
		ld_rppmargin = ld_rppmargin * 100.0
	else
		ld_rppmargin = ld_rppmargin / this.id_detail.object.packprice[al_row] * 100
	end if
	this.id_footer.setitem(1, "rppmargin", ld_rppmargin)
	this.id_footer.setitem(1, "rpp", ld_rpp)
	this.id_footer.setitem(1, "purprice", ld_purprice)
	this.id_footer.setitem(1, "avgprice", ld_avgprice)
	this.id_footer.setitem(1, "itemtotalval", ls_itemtotalval)
	if this.id_footer.getitemstatus(1, "invdiscperc", primary!) = notmodified! and this.ib_modify = false then
		this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
	end if
	if f_stringpreferences("bonusinsale") = "Y" then
		this.id_footer.setitem(1, "bonusratio", trim(string(ll_qtysale)) + ":" + trim(string(ll_bonus)))
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			ld_holdlooseqty = this.id_detail.getitemnumber(al_row, "looseqty")
			if this.id_detail.getitemnumber(al_row, "qtysale") = 0.0 then
				ld_desiredbonus = 0
			else
				ld_desiredbonus = ld_holdlooseqty / double(this.id_detail.getitemnumber(al_row, "qtysale")) * double(this.id_detail.getitemnumber(al_row, "Bonus"))
			end if
			if ld_holdlooseqty + ld_desiredbonus <= ld_godownstock then
				this.id_detail.setitem(al_row, "bonusqty", ld_desiredbonus)
			elseif ld_holdlooseqty > ld_godownstock then
				messagebox("Quantity Validation", "Quantity " + string(ld_holdlooseqty) + " exceeds stock " + string(ld_godownstock) + ".")
				this.id_detail.setitem(al_row, "looseqty", 1)
				this.id_detail.setitem(al_row, "bonusqty", 0)
			else
				ld_desiredbonus = messagebox("Problem allocating bonus", "Sale Qty = " + string(ld_holdlooseqty) + " ~r" + "Required Bonus = " + trim(string(ld_desiredbonus)) + " ~r" + "Stock available = " + trim(string(ld_godownstock)) + " ~r" + "Allocate possible bonus?", question!, yesno!, 2)
				if ld_desiredbonus = 1.0 then
					this.id_detail.setitem(al_row, "bonusqty", ld_godownstock - ld_holdlooseqty)
				else
					retflag = false
					this.id_detail.setitem(al_row, "bonusqty", 0)
				end if
			end if
		end if
	end if
	this.id_footer.object.t_purdiscper.text = string(ld_purdiscperc)
	this.id_detail.setitem(al_row, "itemcode", al_icode)
	if ls_antinorcotix = "Y" and retflag = true and not (this.il_norcotixcode = al_icode) and isnull(trim(this.id_master.getitemstring(1, "remarks"))) then
		messagebox("Item Validation", "This is Narcotics item ~r~n please type Doctor name in remarks")
		this.il_norcotixcode = al_icode
		retflag = false
		this.il_norcotixcode = al_icode
		if f_stringpreferences("doctnamefornorcotix") = "Y" then
			this.id_master.setfocus()
			this.id_master.setcolumn("remarks")
		end if
	end if
	return retflag

// w_inpatientsale.wf_post() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	if this.tab_retrieve.selectedtab = 1 then
		return 0
	end if
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		openwithparm(w_arg_patientadmission_sinv_linv, this.ii_saletype)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			li_errcode = wf_locksaleinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_saleinvcount)
			if li_errcode = 0 then
				sqlca.postsaleledger_wrt_patientadmission(lstr_arginfo.l_code1, lstr_arginfo.l_code2, this.ii_saletype, ll_salesmancode, lstr_arginfo.l_code3, lstr_arginfo.l_code4, this.ic_impactinventory)
				if sqlca.sqlcode <> 0 then
					li_errcode = sqlca.sqlcode
					ls_msgtext = sqlca.sqlerrtext
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = sqlca.sqlcode
				ls_msgtext = sqlca.sqlerrtext
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if li_errcode <> 0 then
		messagebox("Posting Fails", "Some database request fails, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode))
	else
		messagebox("Posting Successfull", "Total unposted rows were " + string(ll_saleinvcount) + "~n~rAll rows have been posted successfully")
	end if
	return li_errcode

// w_inpatientsale.wf_admitted(long al_admissioncode) returns long
	long ll_count
	SQL SELECT Count ( *) INTO :ll_count FROM PatientAdmission WHERE PatientAdmission.AdmissionCode =:al_admissioncode AND PatientAdmission.Discharged ='N' AND PatientAdmission.Discharged1 ='N' USING sqlca;
	return ll_count

// w_inpatientsale.wf_copyinvoice() returns integer
	datastore lds_saletemplatedetail
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrows
	integer li_retcode = 1
	integer li_errcode
	integer li_counter
	integer ll_found
	integer ll_innercounter
	double ld_looseqty
	double ld_holdqty
	double ld_holdbonusqty
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	boolean lb_bonus
	datawindowchild ldc_godown
	if wf_iseditable() = false then
		return 0
	end if
	lds_saletemplatedetail = create datastore
	open(w_copysaleinvoicefrom)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		destroy lds_saletemplatedetail
		return -1
	end if
	if f_stringpreferences("BonusInSale") = "Y" then
		lb_bonus = true
	end if
	if lstr_template.c_copyinvfrom = "T" then
		lds_saletemplatedetail.dataobject = "d_saletemplate_detail"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "qty"))
		next
	elseif lstr_template.c_copyinvfrom = "I" then
		lds_saletemplatedetail.dataobject = this.id_detail.dataobject
		lds_saletemplatedetail.settransobject(this.it_transobject)
		li_retcode = lds_saletemplatedetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "looseqty"))
			if lb_bonus then
				this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "bonusqty"))
			end if
		next
	elseif lstr_template.c_copyinvfrom = "P" then
		if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
			lds_saletemplatedetail.dataobject = "d_normalpurchasedetail"
		else
			lds_saletemplatedetail.dataobject = "d_loosepurchasedetail"
		end if
		lds_saletemplatedetail.settransobject(this.it_transobject)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_detailrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for li_counter = 1 to ll_detailrows
			ld_holdqty = 0
			ld_holdbonusqty = 0
			ll_icode = lds_saletemplatedetail.object.icode[li_counter]
			ll_found = lds_saletemplatedetail.find("icode=" + string(ll_icode), 1, li_counter - 1)
			if ll_found > 0 then
				if ll_detailrows = 1 then
					lb_isitemexists = false
				elseif li_counter = 1 then
					lb_isitemexists = false
				else
					lb_isitemexists = true
				end if
			else
				lb_isitemexists = false
			end if
			if lb_isitemexists = false then
				if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
					ld_holdqty = lds_saletemplatedetail.object.packqty[li_counter]
					ld_holdbonusqty = lds_saletemplatedetail.object.bonusqty[li_counter]
				else
					ld_holdqty = lds_saletemplatedetail.object.looseqty[li_counter]
					ld_holdbonusqty = lds_saletemplatedetail.object.bonusqty[li_counter]
				end if
				if li_counter <> ll_detailrows then
					ll_found = lds_saletemplatedetail.find("icode=" + string(ll_icode), li_counter + 1, ll_detailrows)
					ll_innercounter = ll_found
					do while ll_found > 0 and ll_innercounter <= ll_detailrows
						if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
							ld_holdqty = ld_holdqty + lds_saletemplatedetail.object.packqty[ll_found]
							ld_holdbonusqty = ld_holdbonusqty + lds_saletemplatedetail.object.bonusqty[ll_found]
						else
							ld_holdqty = ld_holdqty + lds_saletemplatedetail.object.looseqty[ll_found]
							ld_holdbonusqty = ld_holdbonusqty + lds_saletemplatedetail.object.bonusqty[ll_found]
						end if
						ll_innercounter = ll_found + 1
						ll_found = lds_saletemplatedetail.find("icode=" + string(ll_icode), ll_innercounter, ll_detailrows)
					loop
				end if
				ll_insertedrows = this.id_detail.insertrow(0)
				wf_inititeminfo(lds_saletemplatedetail.getitemnumber(li_counter, "icode"), ll_insertedrows, li_errcode, ls_errortext)
				if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
					ld_holdqty = ld_holdqty * lds_saletemplatedetail.getitemnumber(li_counter, "packunits")
					ld_holdbonusqty = ld_holdbonusqty * lds_saletemplatedetail.getitemnumber(li_counter, "packunits")
				end if
				this.id_detail.setitem(ll_insertedrows, "looseqty", ld_holdqty)
				if lb_bonus then
					this.id_detail.setitem(ll_insertedrows, "bonusqty", ld_holdbonusqty)
				end if
			end if
		next
	elseif lstr_template.c_copyinvfrom = "R" then
		lds_saletemplatedetail.dataobject = "d_OpenWholeSaleReturnDetail"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "looseqty"))
			if lb_bonus then
				this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "bonusqty"))
			end if
		next
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	destroy lds_saletemplatedetail
	return li_retcode

// w_inpatientsale.wf_getsalesstockinfo(long al_saleinvcode, long al_gcode, long al_icode, double ad_saleqty) returns integer
	SQL Select IsNull ( Sum ( saledetail.looseqty + saledetail.bonusqty ) , 0 ) INTO :ad_saleqty from saledetail where saledetail.saleinvcode =:al_saleinvcode and saledetail.gcode =:al_gcode and saledetail.icode =:al_icode USING this.it_transobject;
	if isnull(ad_saleqty) then
		ad_saleqty = 0
	end if
	return this.it_transobject.sqlcode

// w_inpatientsale.wf_selectitembatches(long al_gcode, long al_icode, double ad_qty, double ad_bonus, datawindow ad_itemsdetail, long al_rowscount, string al_errortext) returns integer
	datastore lds_itemstockinfo
	integer li_errcode
	long ll_counter
	long ll_detailrowcount
	double ld_saleqty
	double ld_reqqty
	double ld_totalstock
	double ld_batchqty
	double ld_bonusqty
	lds_itemstockinfo = create datastore
	lds_itemstockinfo.dataobject = "d_itemstockinfo"
	lds_itemstockinfo.settransobject(this.it_transobject)
	if lds_itemstockinfo.retrieve(al_gcode, al_icode) > 0 then
		ld_totalstock = lds_itemstockinfo.getitemnumber(1, "c_totalstock")
		if ld_totalstock >= ad_qty + ad_bonus then
			ld_reqqty = ad_qty + ad_bonus
			ll_detailrowcount = ad_itemsdetail.rowcount()
			ll_counter = 1
			do while ll_counter <= lds_itemstockinfo.rowcount() and ld_reqqty > 0.0
				ld_batchqty = lds_itemstockinfo.getitemnumber(ll_counter, "currqty")
				if ld_batchqty >= ld_reqqty then
					ld_saleqty = ad_qty
					ld_bonusqty = ad_bonus
				elseif ld_batchqty <= ad_qty then
					ld_saleqty = ld_batchqty
					ld_bonusqty = 0
				else
					ld_saleqty = ad_qty
					ld_bonusqty = ld_batchqty - ad_qty
				end if
				ad_qty = ad_qty - ld_saleqty
				ad_bonus = ad_bonus - ld_bonusqty
				ld_reqqty = ad_qty + ad_bonus
				ad_itemsdetail.insertrow(0)
				ll_detailrowcount = ll_detailrowcount + 1
				ad_itemsdetail.setitem(ll_detailrowcount, "gcode", al_gcode)
				ad_itemsdetail.setitem(ll_detailrowcount, "icode", al_icode)
				ad_itemsdetail.setitem(ll_detailrowcount, "batch", lds_itemstockinfo.getitemstring(ll_counter, "batch"))
				ad_itemsdetail.setitem(ll_detailrowcount, "expiry", lds_itemstockinfo.getitemdatetime(ll_counter, "expiry"))
				ad_itemsdetail.setitem(ll_detailrowcount, "stock", ld_batchqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "totalstock", ld_totalstock)
				ad_itemsdetail.setitem(ll_detailrowcount, "looseqty", ld_saleqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "bonusqty", ld_bonusqty)
				ll_counter = ll_counter + 1
			loop
			al_rowscount = ll_counter - 1
		else
			li_errcode = 1
			al_rowscount = ld_totalstock
			al_errortext = "Stock has been decreased for this item   "
		end if
	else
		li_errcode = 1
		al_rowscount = ld_totalstock
		al_errortext = "Stock does not exist for this item   "
	end if
	destroy lds_itemstockinfo
	return li_errcode

// w_inpatientsale.wf_setiteminfo(long al_icode, long al_row, double ad_saleprice, double ad_discperc, double ad_stock, double ad_avgprice, double ad_totalstock, double ad_purdiscperc) returns 0
	this.id_detail.setitem(al_row, "saleprice", ad_saleprice)
	if this.ii_saletype = 2 then
		this.id_detail.setitem(al_row, "discperc", ad_discperc)
	else
		this.id_detail.setitem(al_row, "discperc", 0.0)
	end if
	this.id_detail.setitem(al_row, "rate", ad_saleprice)
	this.id_detail.setitem(al_row, "avgprice", ad_avgprice)
	this.id_footer.object.icode[this.id_footer.getrow()] = al_icode
	this.id_footer.object.stock[this.id_footer.getrow()] = ad_stock

// w_inpatientsale.wf_set_itemtotal_formatmask() returns long
	string ls_modify
	string ls_format
	ls_format = trim(f_stringpreferences("FormatForAmtInSale"))
	ls_modify = "c_itemtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_detaildwtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_finalitemval.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_sumfinalitemval.Format='" + ls_format + "'  "
	this.id_detail.modify(ls_modify)
	return 0

// w_inpatientsale.wf_assign_master_cash_win_object() returns 0
	this.ids_cashwin = create u_ds_standard
	this.ids_cashwin.dataobject = "d_cashierwindow_detail"
	this.ids_cashwin.settransobject(this.it_transobject)

// w_inpatientsale.wf_set_cashaccount() returns long
	long ll_cashacccode
	long ll_module
	long ll_code
	ll_module = 25
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = f_is_group_module_cashaccount_allowed(this.il_groupcode, ll_module)
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		ll_cashacccode = 0
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
	elseif isnull(ll_code) or this.id_master.object.code[1] <= 0 then
		this.id_master.object.cashacccode[this.id_master.rowcount()] = ll_cashacccode
	else
		ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	end if
	return ll_cashacccode

// w_inpatientsale.wf_show_mastercashierwindow() returns long
	long ll_counter
	long ll_code
	long ll_row
	long ll_insrow
	long ll_module
	long ll_cashacccode
	double ld_tot_acc_amt
	s_mastercashwin lstr_values
	lstr_values.i_interfacecode = 7
	if f_stringpreferences("askmastercashwin_in_inpatientsale") = "N" then
		return 1
	end if
	ll_module = 25
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
		return 0
	end if
	lstr_values.l_invcode = ll_code
	lstr_values.l_cashacccode = ll_cashacccode
	lstr_values.l_groupcode = this.il_groupcode
	lstr_values.l_module = ll_module
	lstr_values.d_netamt = wf_grandtotal()
	lstr_values.d_cashtendered = this.id_master.object.cashtendered[this.id_master.rowcount()]
	lstr_values.d_cashcharged = this.id_master.object.cashcharged[this.id_master.rowcount()]
	lstr_values.d_cashback = this.id_master.object.cashback[this.id_master.rowcount()]
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		lstr_values.l_acccode[ll_counter] = this.ids_cashwin.object.acccode[ll_counter]
		lstr_values.s_remarks[ll_counter] = this.ids_cashwin.object.remarks[ll_counter]
		lstr_values.d_amount[ll_counter] = this.ids_cashwin.object.amount[ll_counter]
		lstr_values.l_rowid[ll_counter] = this.ids_cashwin.object.rowid[ll_counter]
		ld_tot_acc_amt = ld_tot_acc_amt + this.ids_cashwin.object.amount[ll_counter]
	next
	if lstr_values.d_netamt >= lstr_values.d_cashcharged then
		lstr_values.d_invbalance = lstr_values.d_netamt - lstr_values.d_cashcharged - ld_tot_acc_amt
	else
		lstr_values.d_invbalance = 0
	end if
	for ll_counter = 1 to 100
		if lstr_values.l_rowid[ll_counter] <= 0 then
			lstr_values.l_rowid[ll_counter] = -1
		end if
	next
	openwithparm(w_cashierwindow, lstr_values)
	lstr_values = message.powerobjectparm
	if lstr_values.i_status = 1 then
		this.ids_cashwin.reset()
		ld_tot_acc_amt = 0
		for ll_counter = 1 to 100
			if lstr_values.l_acccode[ll_counter] > 0 and lstr_values.d_amount[ll_counter] > 0 and lstr_values.l_rowid[ll_counter] > 0 then
				ll_insrow = this.ids_cashwin.insertrow(0)
				this.ids_cashwin.object.saleinvcode[ll_insrow] = ll_code
				this.ids_cashwin.object.acccode[ll_insrow] = lstr_values.l_acccode[ll_counter]
				this.ids_cashwin.object.remarks[ll_insrow] = lstr_values.s_remarks[ll_counter]
				this.ids_cashwin.object.amount[ll_insrow] = lstr_values.d_amount[ll_counter]
				this.ids_cashwin.object.rowid[ll_insrow] = lstr_values.l_rowid[ll_counter]
			end if
		next
		this.id_master.object.cashacccode[this.id_master.rowcount()] = lstr_values.l_cashacccode
		this.id_master.object.cashtendered[this.id_master.rowcount()] = lstr_values.d_cashtendered
		this.id_master.object.cashcharged[this.id_master.rowcount()] = lstr_values.d_cashcharged
		this.id_master.object.cashback[this.id_master.rowcount()] = lstr_values.d_cashback
		this.id_master.object.cashreceived[this.id_master.rowcount()] = lstr_values.d_cashtendered
		if this.ii_saletype = 3 then
			if this.id_master.object.cashcharged[this.id_master.rowcount()] = lstr_values.d_netamt and lstr_values.d_invbalance = 0 then
				this.id_master.object.outstandingamt[this.id_master.rowcount()] = 0
			else
				this.id_master.object.outstandingamt[this.id_master.rowcount()] = lstr_values.d_invbalance
			end if
		else
			this.id_master.object.outstandingamt[this.id_master.rowcount()] = lstr_values.d_invbalance
		end if
		return 1
	end if
	return 0

// w_inpatientsale.wf_update_cashierwindow(long al_invcode) returns long
	long ll_counter
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		this.ids_cashwin.object.saleinvcode[ll_counter] = al_invcode
	next
	SQL DELETE DBO.CashierWindow WHERE SaleInvCode =:al_invcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if this.ids_cashwin.update() > 0 then
			return 0
		else
			return -1
		end if
		return
	end if
	return -1

// w_inpatientsale.wf_show_accountledger() returns long
	long ll_acccode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_acccode = this.id_master.object.custcode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_acccode = this.id_list.object.custcode[this.id_list.getrow()]
	end if
	if not isnull(ll_acccode) and ll_acccode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_account_ledger, ll_acccode)
	end if
	return 0

// w_inpatientsale.wf_show_patientledger() returns long
	long ll_patientcode
	long ll_admissioncode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_admissioncode = this.id_master.object.admissioncode[this.id_master.getrow()]
			SQL SELECT patientcode INTO :ll_patientcode FROM PatientAdmission WHERE AdmissionCode =:ll_admissioncode USING sqlca;
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_patientcode = this.id_list.object.patientcode[this.id_list.getrow()]
	end if
	if not isnull(ll_patientcode) and ll_patientcode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_patient_ledger, ll_patientcode)
	end if
	return 0

// w_inpatientsale.wf_show_inpatientbill() returns long
	long ll_admissioncode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_admissioncode = this.id_master.object.admissioncode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_admissioncode = this.id_list.object.admissioncode[this.id_list.getrow()]
	end if
	if not isnull(ll_admissioncode) and ll_admissioncode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_inpatient_bill, ll_admissioncode)
	end if
	return 0

// w_inpatientsale.wf_open_item_form_popup() returns 0
	openwithparm(w_patientadmission_form_popup, this, this)

// w_inpatientsale.wf_validate_admissioncode(long al_admissioncode) returns long
	long ll_admissioncode
	long ll_custcode
	long rt_code
	long ll_null
	string ls_result
	setnull(ll_null)
	if this.ii_saletype = 2 then
		this.id_master.setitem(1, "patientregno", this.idc_patient.getitemstring(this.idc_patient.getrow(), "regno"))
		if isnull(al_admissioncode) then
			this.id_master.object.custcode.protect = 0
			this.id_master.setitem(1, "patientregno", "")
			this.id_master.setitem(1, "custcode", 0)
			this.id_master.setitem(1, "itemdiscpercno", setnull(ll_null))
			this.id_master.setitem(1, "sprice", 1)
			this.id_master.setitem(1, "dd_gstperc", 1)
		else
			ll_admissioncode = al_admissioncode
			SQL SELECT patient.custcode , patient.regno INTO :ll_custcode, :ls_result FROM patient , patientadmission WHERE patientadmission.discharged1 ='N' and patientadmission.discharged ='N' and patientadmission.admissioncode =:ll_admissioncode and patient.patientcode =patientadmission.patientcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				this.id_master.setitem(1, "patientregno", ls_result)
				this.id_master.setitem(1, "custcode", ll_custcode)
				this.id_master.object.custcode.protect = 1
				this.id_master.object.aliasname.protect = 1
				rt_code = wf_setcustomerinfo(1, 1, string(ll_custcode))
				wf_setadmissiondetails(ll_admissioncode)
			else
				messagebox("Patient Information", "Problem in retrieving corresponding customer")
				rt_code = 1
			end if
		end if
	end if
	return rt_code

// w_inpatientsale.wf_update_virtualgl() returns integer
	SQL rollback USING sqlca;
	sqlca.virtualgl("A")
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
	else
		SQL rollback USING sqlca;
	end if
	return 0

// w_inpatientsale.wf_set_patientbalance(long al_patientcode) returns integer
	datetime ldt_datetime
	double ld_balance
	ldt_datetime = datetime(date(today()), time(today()))
	sqlca.patientopeningbalance(al_patientcode, ldt_datetime, ld_balance)
	if sqlca.sqlcode = 0 then
		this.id_master.object.patientbalance[1] = ld_balance
		return 0
	end if
	return -1

// w_inpatientsale.wf_show_patientgallery() returns long
	long ll_code
	long ll_patientcode
	if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
		ll_code = this.id_master.object.admissioncode[this.id_master.getrow()]
		ll_patientcode = wf_findpatientcode(ll_code)
		if ll_patientcode > 0 then
			f_show_patient_gallary(ll_patientcode)
		end if
	end if
	return 0

// w_inpatientsale.wf_misccharges_calc() returns long
	double ld_misccharges
	double ld_misccharges_perc
	double ld_invtotal
	long ll_custcode
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	ld_misccharges = this.id_footer.getitemnumber(1, "misccharges")
	ld_invtotal = this.id_footer.getitemnumber(1, "total")
	ld_misccharges_perc = 0
	SQL select miscchargesperc INTO :ld_misccharges_perc FROM Customer WHERE customer.custcode =:ll_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Database Problem", "Unable to get customer Misc.Charges(%)")
		return -1
	end if
	ld_misccharges = (ld_invtotal - ld_misccharges) * 0.01 * ld_misccharges_perc
	this.id_footer.object.misccharges[1] = ld_misccharges
	this.id_footer.accepttext()
	wf_grandtotal()
	this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
	return 0

// w_inpatientsale.wf_findadmissioncode(string as_regno, long al_admissioncode) returns long
	long ll_admissioncode
	long ll_retflag
	string ls_itemname
	SQL SELECT patientadmission.admissioncode INTO :ll_admissioncode FROM patient , patientadmission WHERE patient.regno =:as_regno AND patient.patientcode =patientadmission.patientcode and patientadmission.discharged1 ='N' and patientadmission.discharged ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_admissioncode = ll_admissioncode
		if isnull(al_admissioncode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_inpatientsale.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_inpatientsalemenu" then
		this.menuid = create m_inpatientsalemenu
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	this.dw_saleinvdetail = create dw_saleinvdetail
	this.ic_cashdrawerprinter = create ic_cashdrawerprinter
	this.ic_comport = create ic_comport
	this.ic_drawerport = create ic_drawerport
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.dw_saleinvdetail
	this.control[icurrent + 3] = this.ic_cashdrawerprinter
	this.control[icurrent + 4] = this.ic_comport
	this.control[icurrent + 5] = this.ic_drawerport

// w_inpatientsale.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.dw_saleinvdetail
	destroy this.ic_cashdrawerprinter
	destroy this.ic_comport
	destroy this.ic_drawerport

// w_inpatientsale.ue_save() returns 0 [event]
	datastore lds_groupdiscinfo
	double ld_itemflatdisc
	double ld_unitsalestax
	double ld_itemgstperc
	double ld_invdisc
	double ld_invgstperc
	double ld_itemamount
	double ld_amountdiff
	double ld_clonesaleprice
	boolean lb_validdisc
	long ll_detailrows
	long ll_counter2
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode = 1
	long ll_gcode
	long ll_headerno
	long ll_headerinvno
	long ll_counter
	long ll_count
	long ll_null
	long ll_modifycount
	long ll_rightfound
	long ll_saveresult
	boolean lb_commitflag = true
	boolean lb_continue = true
	integer li_counter
	integer li_filehandle
	integer li_maxretcode
	string ls_errtext
	string ls_holdstring
	string ls_drawermessage
	string ls_askuserpwd
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_invamount
	double ld_cashtended
	double ld_cashbalance
	double ld_invgstperc1
	double ld_price
	s_salesman lstr_salesman
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	datetime ldt_server_datetime
	string ls_date_errtext
	datawindowchild ldc_headerno
	string ls_env_name
	string ls_env_val
	long ll_env_len
	if this.tab_retrieve.selectedtab = 2 then
		return
	end if
	if wf_iseditable() = false then
		return
	end if
	this.ib_lcdshow = false
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if this.id_detail.rowcount() < 1 then
		messagebox("Rows Validation", "Please insert a row before proceeding")
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	for ll_counter = 1 to this.id_detail.rowcount()
		if f_stringpreferences("SaleOnZeroPrice") = "N" then
			ld_price = this.id_detail.getitemnumber(ll_counter, "Saleprice")
			if ld_price = 0.0 or isnull(ld_price) then
				messagebox("Price Validation", "SalePrice is Zero in Row " + string(ll_counter))
				this.id_detail.setfocus()
				this.id_detail.scrolltorow(ll_counter)
				this.id_detail.setcolumn("SalePrice")
				return
			end if
			return
		end if
		if this.id_detail.getitemnumber(ll_counter, "looseqty") + this.id_detail.getitemnumber(ll_counter, "bonusqty") <= 0.0 then
			messagebox("Sale Qty Validation", "Please Enter Valid Sale Qty")
			this.id_detail.setfocus()
			this.id_detail.scrolltorow(ll_counter)
			this.id_detail.setcolumn("looseqty")
			return
		end if
	next
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	if wf_admitted(this.id_master.object.admissioncode[this.id_master.getrow()]) <= 0 then
		messagebox("Problem Saving", "Patient No more Admitted.~r~nChoose some other patient")
		this.id_master.setfocus()
		this.id_master.setcolumn("admissioncode")
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	wf_grandtotal()
	if f_stringpreferences("autoapplymiscchargesperc_on_saving") = "Y" and wf_misccharges_calc() <> 0 then
		return
	end if
	wf_grandtotal()
	this.id_footer.accepttext()
	this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
	this.is_lcditem = "Total = " + string(wf_grandtotal(), "########0.00")
	if f_stringpreferences("DisplayPool") = "Y" then
		this.ic_comport.triggerevent("ue_show")
	end if
	if wf_set_cashaccount() = 0 then
		return
	end if
	wf_setamountoninvoice()
	if this.ii_saletype = 2 then
		ls_askuserpwd = "CreditSaleAskUserPassword"
	else
		ls_askuserpwd = "Salesalesmanwindow"
	end if
	if f_stringpreferences(ls_askuserpwd) = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		lds_groupdiscinfo = create datastore
		lds_groupdiscinfo.dataobject = "d_groups_discount"
		lds_groupdiscinfo.settransobject(this.it_transobject)
		lds_groupdiscinfo.retrieve(ll_salesmancode)
		ld_invdiscperc = this.id_footer.getitemnumber(1, "invdiscperc")
		ld_flatdisc = this.id_footer.getitemnumber(1, "flatdisc")
		for ll_counter = 1 to lds_groupdiscinfo.rowcount()
			if ld_flatdisc <= lds_groupdiscinfo.getitemnumber(ll_counter, "saleinvflatdisc") then
				lb_validdisc = true
			end if
		next
		if lb_validdisc = false then
			messagebox("Flat Discount Validation", "Flat Discount is greater than your permission~r~n Please consult Administrator")
			this.id_footer.setfocus()
			this.id_footer.setcolumn("flatdisc")
			destroy lds_groupdiscinfo
			return
		end if
		for ll_counter = 1 to this.id_detail.rowcount()
			ld_saleprice = this.id_detail.getitemnumber(ll_counter, "saleprice")
			ld_discperc = this.id_detail.getitemnumber(ll_counter, "discperc")
			ld_itemflatdisc = this.id_detail.getitemnumber(ll_counter, "itemflatdisc")
			ld_unitsalestax = this.id_detail.getitemnumber(ll_counter, "unitsalestax")
			ld_itemgstperc = this.id_detail.getitemnumber(ll_counter, "gstperc")
			ld_invdisc = this.id_footer.getitemnumber(1, "invdiscperc")
			ld_invgstperc = this.id_footer.getitemnumber(1, "invgstperc1")
			ld_avgprice = this.id_detail.getitemnumber(ll_counter, "avgprice")
			ld_itemamount = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2) - round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2) * ld_invdiscperc * 0.01 + ld_unitsalestax + round(round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2) * ld_itemgstperc * 0.01, 2)
			if f_stringpreferences("saleavgpricecheck") = "N" and ld_avgprice > ld_itemamount then
				messagebox("Price Validation", "Sale Price become less than AvgPrice~r~nPlease change Sale Price or Setting In Preferences")
				this.id_detail.setrow(ll_counter)
				destroy lds_groupdiscinfo
				return
			end if
			lb_validdisc = false
			for ll_counter2 = 1 to lds_groupdiscinfo.rowcount()
				ld_amountdiff = ld_saleprice - ld_itemamount
				ld_clonesaleprice = ld_saleprice
				if ld_clonesaleprice = 0.0 then
					ld_clonesaleprice = 1
				end if
				if ld_amountdiff * 100.0 / ld_clonesaleprice <= lds_groupdiscinfo.getitemnumber(ll_counter2, "saleitemdiscperc") then
					lb_validdisc = true
				end if
			next
			if lb_validdisc = false then
				messagebox("Disc% Validation", "Disc% is greater than your permission~r~n Please consult Administrator")
				this.id_detail.setfocus()
				this.id_detail.setrow(ll_counter)
				this.id_detail.setcolumn("itemname")
				destroy lds_groupdiscinfo
				return
			end if
		next
		destroy lds_groupdiscinfo
		if wf_show_mastercashierwindow() = 0 then
			return
		end if
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if isnull(ll_invid) then
			li_maxretcode = wf_tabnewid("saleledger", ll_invid)
			if li_maxretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~n ~t~t~t~t~t~t~t~t~t~t~t~t~tgenerating InvCode")
				return
			end if
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
		end if
		this.id_master.getchild("headerno", ldc_headerno)
		if f_stringpreferences("Headeronsaleinv") = "N" then
			this.id_master.setitem(ll_mastercurrrow, "Headerno", ldc_headerno.getitemnumber(ll_mastercurrrow, "code"))
			ll_headerno = ldc_headerno.getitemnumber(ll_mastercurrrow, "code")
			ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
			if isnull(ll_headerinvno) then
				f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
				if ll_headerinvno > 0 then
					this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
				end if
			end if
		end if
		if f_stringpreferences("Headeronsaleinv") = "Y" or gs_company = "SA" or gs_company = "EPP" then
			ll_headerno = this.id_master.getitemnumber(ll_mastercurrrow, "headerno")
			ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
			if isnull(ll_headerinvno) then
				f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
				if ll_headerinvno > 0 then
					this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
				end if
			end if
		end if
		ld_misccharges = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges")
		ld_invdiscperc = this.id_footer.getitemnumber(ll_footercurrrow, "invdiscperc")
		ld_flatdisc = this.id_footer.getitemnumber(ll_footercurrrow, "flatdisc")
		ld_salestax = this.id_footer.getitemnumber(ll_footercurrrow, "salestax")
		ld_invgstperc1 = this.id_footer.getitemnumber(ll_footercurrrow, "InvGSTPerc1")
		this.id_master.setitem(ll_mastercurrrow, "discperc", ld_invdiscperc)
		this.id_master.setitem(ll_mastercurrrow, "flatdisc", ld_flatdisc)
		this.id_master.setitem(ll_mastercurrrow, "misccharges", ld_misccharges)
		this.id_master.setitem(ll_mastercurrrow, "salestax", ld_salestax)
		this.id_master.setitem(ll_mastercurrrow, "InvGSTPerc1", ld_invgstperc1)
		ls_env_name = "COMPUTERNAME"
		ls_env_val = space(20)
		ll_env_len = 20
		ll_env_len = getenvironmentvariablea(ls_env_name, ls_env_val, ll_env_len)
		this.id_master.setitem(ll_mastercurrrow, "machinename", ls_env_val)
		choose case this.ii_saletype
		case 3
			if this.id_master.object.salecatcode[1] = 3 then
				if f_stringpreferences("RetailSalePosting") = "N" then
					this.id_master.setitem(ll_mastercurrrow, "Posted", "N")
				end if
			elseif f_stringpreferences("CreditSalePosting") = "N" then
				this.id_master.setitem(ll_mastercurrrow, "Posted", "N")
			end if
		case 2
			if f_stringpreferences("CreditSalePosting") = "N" then
				this.id_master.setitem(ll_mastercurrrow, "Posted", "N")
			end if
		end choose
		if this.ib_modify then
			ll_modifycount = this.id_master.getitemdecimal(ll_mastercurrrow, "modifycounter")
			if isnull(ll_modifycount) then
				ll_modifycount = 0
			end if
			this.id_master.setitem(ll_mastercurrrow, "modifycounter", ll_modifycount + 1)
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			if f_stringpreferences("PreserveSaleInvHistory") = "Y" then
				if f_generatesaleslog(ll_invid, ldt_server_datetime, this.it_transobject) = 0 then
					lb_continue = true
				else
					messagebox("Sales History!", "Failure in Saving Sales Invoice History!.")
					return
				end if
				return
			end if
			if lb_continue then
				this.ids_invoiceinfo.retrieve(ll_invid)
				for ll_count = 1 to this.id_detail.rowcount()
					ll_icode = this.id_detail.getitemnumber(ll_count, "icode")
					ll_gcode = this.id_detail.getitemnumber(ll_count, "gcode")
					for ll_counter = 1 to this.ids_invoiceinfo.rowcount()
						if ll_icode = this.ids_invoiceinfo.getitemnumber(ll_counter, "icode") and (not isnull(this.ids_invoiceinfo.getitemstring(ll_counter, "due")) and not isnull(this.id_detail.getitemstring(ll_count, "Due"))) and this.id_detail.getitemnumber(ll_count, "Dueqty") = 0.0 then
							this.id_detail.setitem(ll_count, "Due", "D")
							this.id_detail.setitem(ll_count, "Dueqty", this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty"))
						end if
					next
				next
				lb_continue = wf_returnsaleinvoice(ll_invid, ls_errtext)
			end if
		else
			this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
		end if
		if this.ii_saletype = 2 then
			ll_rightfound = 0
			ll_rightfound = gds_securitywindow.find("rightcode = 582", 1, gds_securitywindow.rowcount())
			if this.id_master.getitemstring(1, "accountfor") = "Y" and f_stringpreferences("AskAmtOnCreditSale") = "Y" and f_stringpreferences("askmastercashwin_in_inpatientsale") = "N" and ll_rightfound > 0 then
				this.id_master.setitem(ll_mastercurrrow, "amtby", ll_salesmancode)
				this.id_master.setitem(ll_mastercurrrow, "amtdate", ldt_server_datetime)
			end if
		end if
		if lb_continue then
			this.id_saleinvdetail.reset()
			if not wf_populatesaledetail(ll_invid, this.id_saleinvdetail, ls_errtext, ll_errrowid) then
				lb_continue = false
				this.id_detail.scrolltorow(ll_errrowid)
				this.id_detail.setfocus()
			else
				this.id_detail = this.id_saleinvdetail
				ll_saveresult = event ue_save_withnocommit()
				if ll_saveresult = 0 then
					if wf_update_cashierwindow(ll_invid) = 0 then
						SQL commit USING this.it_transobject;
						messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
						this.ib_commitok = true
						this.id_master.resetupdate()
						this.im_menu.m_file.m_new.enabled = true
						this.editflag = false
						if gd_recenttransdate < this.id_systemdate then
							gd_recenttransdate = this.id_systemdate
						end if
					else
						messagebox("Saving Problem", "Changes Not Saved in database for Master Cashier Window transactions.", stopsign!, ok!, 1)
					end if
				end if
				this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
				this.id_saleinvdetail.reset()
				if this.ib_commitok then
					this.ib_modify = false
				elseif this.ib_modify = false then
					setnull(ll_null)
					this.id_master.setitem(1, "Code", ll_null)
					this.id_master.accepttext()
				end if
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			if this.ib_modify = false then
				setnull(ll_null)
				this.id_master.setitem(1, "Code", ll_null)
				this.id_master.accepttext()
			end if
			messagebox("Updation Error", ls_errtext + " in current row", stopsign!)
		else
			if f_stringpreferences("IncSaleInActMonitor") = "Y" then
				this.it_transobject.updateactivitymonitor("SV", ll_invid)
				if this.it_transobject.sqlcode <> 0 then
					SQL rollback USING this.it_transobject;
					messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
				else
					SQL commit USING this.it_transobject;
				end if
			end if
			if f_stringpreferences("ShowSaleInCashierActivity") = "Y" then
				this.it_transobject.updatecashieractivity(this.ii_module, ll_invid)
				if this.it_transobject.sqlcode <> 0 then
					SQL rollback USING this.it_transobject;
					messagebox("Activity Monitor", "Problem in updating cashier activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
				else
					SQL commit USING this.it_transobject;
				end if
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_inpatientsale.ue_newform() returns 0 [event]
	integer rtncode
	integer li_defaultgcode
	integer li_ismodifysaleprice
	integer li_ismodifyitemdiscperc
	integer li_ismodifyitemflatdisc
	integer li_modifysalestax
	integer li_viewstock
	integer li_viewtotalstock
	long li_fetched_code
	long row
	long ll_manfcode
	long ll_counter
	long ll_custcode
	double ld_invdiscperc
	call super::ue_newform
	wf_update_virtualgl()
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.il_norcotixcode = -1
	wf_assign_master_cash_win_object()
	this.im_menu.m_file.m_print.enabled = true
	wf_protectdw(this.id_master, 0)
	this.id_detail.setredraw(false)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.id_detail.setredraw(true)
	this.ib_modify = false
	this.id_master.object.patientcode.visible = false
	this.id_master.object.admissioncode.visible = true
	wf_setgodownoption()
	li_ismodifysaleprice = 1
	li_ismodifyitemdiscperc = 1
	li_ismodifyitemflatdisc = 1
	li_modifysalestax = 1
	li_viewstock = 0
	li_viewtotalstock = 0
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 511 then
			li_ismodifysaleprice = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 516 then
			li_ismodifyitemdiscperc = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 517 then
			li_ismodifyitemflatdisc = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 520 then
			li_modifysalestax = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 535 then
			li_viewstock = 1
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 536 then
			li_viewtotalstock = 1
		end if
	next
	this.id_footer.object.t_stock.visible = li_viewstock
	this.id_footer.object.stock.visible = li_viewstock
	this.id_footer.object.t_totalstock.visible = li_viewtotalstock
	this.id_footer.object.totalstock.visible = li_viewtotalstock
	this.id_detail.object.saleprice.protect = li_ismodifysaleprice
	this.id_detail.object.discperc.protect = li_ismodifyitemdiscperc
	this.id_detail.object.itemflatdisc.protect = li_ismodifyitemflatdisc
	this.id_detail.object.unitsalestax.protect = li_modifysalestax
	this.id_detail.object.gstperc.protect = li_modifysalestax
	this.id_footer.setitem(1, "invdiscperc", f_numberpreferences("invdiscperc"))
	if not wf_validatedate() then
		close(this)
	else
		if this.ii_saletype = 3 then
			ll_custcode = this.id_master.getitemnumber(1, "custcode")
			SQL Select invdiscperc INTO :ld_invdiscperc From Customer Where custcode =:ll_custcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
			end if
			this.id_detail.setfocus()
		else
			this.id_master.setfocus()
		end if
		wf_visible(true)
	end if
	if f_stringpreferences("DisplayPool") = "Y" then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
			setnull(this.is_lcditem)
			this.ic_comport.triggerevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
			setnull(this.is_lcditem)
			this.ic_comport.triggerevent("ue_show")
		end if
	end if
	this.ib_lcdshow = true
	this.ii_focuscustomer = 2

// w_inpatientsale.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect = 1
	integer li_ismodifysaleprice
	integer li_ismodifyitemdiscperc
	integer li_ismodifyitemflatdisc
	integer li_modifysalestax
	long ll_row
	long ll_code
	long ll_counter
	long ll_admissioncode
	boolean lb_flag
	boolean lb_modify
	m_inpatientsalemenu lm_menu
	long ll_rowcount
	long ll_validinv
	double ld_code
	lm_menu = this.menuid
	this.tab_retrieve.tabpage_list.em_invno.getdata(ld_code)
	if ld_code = 0.0 then
		ld_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	else
		SQL select count ( *) , MAX ( admissioncode ) INTO :ll_validinv, :ll_admissioncode from Saleledger where saleinvcode =:ld_code and salecatcode =:this.ii_saletype USING this.it_transobject;
		if ll_validinv <> 1 then
			this.id_detail.reset()
			messagebox("Invoice Validation", "Invoice does not exist, or ~r~n it does not belong to current sale type")
			this.tab_retrieve.selecttab(2)
			return
		end if
		if isnull(ll_admissioncode) then
			this.id_detail.reset()
			messagebox("Invoice Validation", "Not an In-Patient Sale~r~nUse Credit Sale To open This Invoice")
			this.tab_retrieve.selecttab(2)
			return
		end if
	end if
	if wf_allowsalemodification(ld_code, this.il_groupcode, this.il_strategy) <> 0 then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "You Can not modify this Invoice,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.im_menu.m_file.m_print.enabled = true
	this.i_editmode = 2
	this.i_retrievemode = 2
	this.id_dwcontrol = this.id_master
	ll_rowcount = wf_retrieve(ld_code)
	this.id_master.setrow(1)
	this.id_master.scrolltorow(1)
	this.id_dwcontrol = this.id_footer
	wf_retrieve(ld_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	this.id_dwcontrol = this.id_detail
	wf_retrieve(ld_code)
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	this.id_dwcontrol = this.id_list
	if wf_admitted(this.id_master.object.admissioncode[this.id_master.getrow()]) <= 0 then
		this.id_master.object.patientcode.visible = true
		this.id_master.object.admissioncode.visible = false
		this.id_master.setitem(1, "patientcode", wf_findpatientcode(this.id_master.object.admissioncode[this.id_master.getrow()]))
	else
		this.id_master.object.patientcode.visible = false
		this.id_master.object.admissioncode.visible = true
	end if
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		if this.ii_saletype = 2 and this.ib_creditmodify then
			lb_modify = true
		end if
		if this.ii_saletype = 3 and this.ib_retailmodify then
			lb_modify = true
		end if
	end if
	if not lb_modify then
		this.im_menu.m_file.m_save.enabled = false
		this.editflag = false
	else
		li_protect = 0
		wf_initmodify(li_protect)
	end if
	if this.id_master.object.code[this.id_master.rowcount()] > 0 then
		this.ids_cashwin.retrieve(ld_code)
	else
		wf_assign_master_cash_win_object()
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_salegodown
	end if
	wf_setgodownoption()
	this.il_custcode = this.id_master.getitemnumber(1, "custcode")
	if li_protect = 0 then
		li_ismodifysaleprice = 1
		li_ismodifyitemdiscperc = 1
		li_ismodifyitemflatdisc = 1
		li_modifysalestax = 1
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 511 then
				li_ismodifysaleprice = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 516 then
				li_ismodifyitemdiscperc = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 517 then
				li_ismodifyitemflatdisc = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 520 then
				li_modifysalestax = 0
			end if
		next
		this.id_detail.object.saleprice.protect = li_ismodifysaleprice
		this.id_detail.object.discperc.protect = li_ismodifyitemdiscperc
		this.id_detail.object.itemflatdisc.protect = li_ismodifyitemflatdisc
		this.id_detail.object.unitsalestax.protect = li_modifysalestax
		this.id_detail.object.gstperc.protect = li_modifysalestax
	end if
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	wf_grandtotal()
	setredraw(true)

// w_inpatientsale.ue_newitem() returns 0 [event]
	integer li_defaultgcode
	long ll_rowcount
	setnull(this.is_aliasname)
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true
	this.ii_defaultgcode = this.ii_salegodown

// w_inpatientsale.ue_deleteitem() returns 0 [event]
	long ll_row
	long ll_footerrow
	call super::ue_deleteitem
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() > 0 then
		this.id_footer.setitem(ll_footerrow, "icode", this.id_detail.getitemnumber(ll_row, "icode"))
		this.id_footer.setitem(ll_footerrow, "stock", this.id_detail.getitemnumber(ll_row, "stock"))
		return
	end if
	this.id_footer.setitem(ll_footerrow, "icode", 0)
	this.id_footer.setitem(ll_footerrow, "stock", 0)
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_save.enabled = false

// w_inpatientsale.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	if f_stringpreferences("DisplayPool") = "Y" then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
			this.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
			postevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
			this.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
			this.ic_comport.triggerevent("ue_show")
		else
			this.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
			this.ic_comport.triggerevent("ue_show")
		end if
	end if
	return 1

// w_inpatientsale.ue_list() returns 0 [event]
	long ll_row
	m_inpatientsalemenu lm_menu
	call super::ue_list
	lm_menu = this.menuid
	SQL rollback USING this.it_transobject;
	lm_menu.m_file.m_post.enabled = true
	lm_menu.m_file.m_print.enabled = false
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	this.tab_retrieve.tabpage_list.em_invno.selecttext(1, 7)
	this.tab_retrieve.tabpage_list.em_invno.clear()
	this.il_norcotixcode = -1
	ll_row = wf_retrievelist()
	wf_disabledetailtab(ll_row)
	post event ue_enableprint()

// w_inpatientsale.ue_print() returns 0 [event]
	long ll_custcode
	long ll_row
	long ll_invcode
	long ll_counter
	string ls_custname
	string ls_posted
	string ls_invoicesize
	integer li_option
	integer li_reprintingcounter
	integer li_printretcode
	double ld_balance
	boolean lb_listtab
	s_datastore lstr
	string ls_printer
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
			else
				event ue_newitem()
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	SQL SELECT ISNULL ( reprintingcounter , 0 ) , invoicesize INTO :li_reprintingcounter, :ls_invoicesize FROM saleledger WHERE saleinvcode =:ll_invcode USING this.it_transobject;
	if not lb_listtab then
		li_reprintingcounter = li_reprintingcounter + 1
		SQL update SaleLedger SET ReprintingCounter =:li_reprintingcounter WHERE saleinvcode =:ll_invcode USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Database Error", "Some database problem has occur")
		SQL rollback USING this.it_transobject;
		return
	else
		SQL commit USING this.it_transobject;
	end if
	if this.ii_saletype = 2 then
		this.ib_printout = false
	end if
	if gs_company = "TOUHEED" and lb_listtab = false then
		this.id_print.dataobject = "d_gar_retailsaleinvreport_quarter"
		this.id_print.settransobject(this.it_transobject)
		this.id_print.retrieve(this.id_master.getitemnumber(1, "code"))
		this.id_print.print()
	end if
	wf_selectprintreport()
	this.id_print.retrieve(ll_invcode)
	if gs_company = "DWSMALLCREDIT" and ls_invoicesize = "F" then
		for ll_counter = 2 to this.id_print.rowcount()
			this.id_print.setitem(ll_counter + 1, "cumulativesum", this.id_print.getitemnumber(ll_counter, "c_pagesum"))
			this.id_print.setitem(ll_counter, "cumulativesumfoot", this.id_print.getitemnumber(ll_counter, "c_pagesum"))
		next
	end if
	if f_stringpreferences("CustBalanceOnPrintOut") = "Y" and (this.id_master.getitemstring(1, "invoicesize") = "F" or this.id_master.getitemstring(1, "invoicesize") = "H" or this.id_master.getitemstring(1, "invoicesize") = "Q") and this.ii_saletype = 2 and gs_company <> "SA" and this.id_print.getitemstring(1, "Posted") = "N" then
		ll_custcode = this.id_print.getitemnumber(1, "CustCode")
		SQL rollback USING sqlca;
		ld_balance = 0
		sqlca.absoluteopeningbalance(ll_custcode, ld_balance)
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
			messagebox("Balance Problem", "Unable to fetch balance on sales printing.")
			return
		end if
		this.id_print.setitem(this.id_print.rowcount(), "balance", ld_balance)
	end if
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		else
			li_reprintingcounter = li_reprintingcounter + 1
			SQL update SaleLedger SET ReprintingCounter =:li_reprintingcounter WHERE saleinvcode =:ll_invcode USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Database Error", "Some database problem has occur during updation of reprinting counter.")
				SQL rollback USING this.it_transobject;
				return
			else
				SQL commit USING this.it_transobject;
			end if
		end if
	end if
	if f_stringpreferences("saleaskforcopies") = "Y" then
		open(w_printer_copies)
		this.id_print.object.datawindow.print.copies = string(message.doubleparm)
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		li_printretcode = this.id_print.print()
		if li_printretcode < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		elseif f_stringpreferences("CashDrawerWithPrinter") = "Y" and lb_listtab = false then
			ls_printer = f_stringpreferences("CashDrawerPrinter")
			if ls_printer = "" or isnull(ls_printer) then
				messagebox("Cash Drawer Printer", "Cash Drawer Printer name not found.~r~nSuggested Option is check Cash Drawer Printer name in Preferences.")
			else
				this.ic_cashdrawerprinter.object.__invoke_method("opendrawer", 4, {ls_printer, 10, "Control", 65}, true)
			end if
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_inpatientsale.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	if this.ii_saletype <> 3 then
		setpointer(hourglass!)
		this.idc_customers.setredraw(false)
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.retrieve()
		this.idc_customers.setredraw(true)
		setpointer(arrow!)
	end if
	this.idc_doctors.setredraw(false)
	this.idc_doctors.settransobject(this.it_transobject)
	this.idc_doctors.retrieve()
	this.idc_doctors.setredraw(true)
	this.idc_patient.setredraw(false)
	this.idc_patient.settransobject(this.it_transobject)
	this.idc_patient.retrieve()
	this.idc_patient.setredraw(true)

// w_inpatientsale.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false
	wf_assign_master_cash_win_object()

// w_inpatientsale.ue_postopen() returns 0 [event]
	datawindowchild ldc_headerno
	m_inpatientsalemenu lm_menu
	integer li_rtncode
	integer li_defaultgodown
	integer i
	long ll_counter
	long ll_pos
	long ll_prow
	long ll_pcode
	long ll_found
	integer li_defaultsaleprice
	integer li_defaultitemdiscperc
	datastore lds_headers
	call super::ue_postopen
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	this.ids_invoiceinfo = create datastore
	this.ids_invoiceinfo.dataobject = "d_saleinvinfo"
	this.ids_invoiceinfo.settransobject(this.it_transobject)
	lm_menu = this.menuid
	wf_assign_master_cash_win_object()
	setredraw(false)
	wf_setsaletype(integer(message.doubleparm))
	this.id_print = this.dw_saleinvrep
	this.id_saleinvdetail = this.dw_saleinvdetail
	this.id_saleinvdetail.settransobject(this.it_transobject)
	choose case this.ii_saletype
	case 2
		this.title = "In-Patient Sale"
		wf_assigndatawindowobjects("d_inpatientsaleheader", "d_inpatientSaleDetail", "d_inpatientsalefooter", "d_inpatientSaleInvlist", "d_inpatientInvReport")
		if f_stringpreferences("InSaleCustomerBalance") = "Y" then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
			this.ids_customersbalance = create datastore
			this.ids_customersbalance.dataobject = "d_customerbalances_in_sales"
			this.ids_customersbalance.settransobject(sqlca)
			this.ids_customersbalance.retrieve()
		else
			this.id_master.object.debitorcredit.visible = false
			this.id_master.object.customerbalance.visible = false
			this.id_master.object.t_balance.visible = false
		end if
		li_rtncode = this.id_master.getchild("custcode", this.idc_customers)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_customers.settransobject(this.it_transobject)
		this.id_master.object.custcode.initial = "0"
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 501 then
				this.im_menu.m_file.m_post.visible = true
				this.im_menu.m_file.m_post.toolbaritemvisible = true
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 503 then
				this.ib_creditmodify = true
			end if
		next
		li_rtncode = this.id_master.getchild("admissioncode", this.idc_patient)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_patient.settransobject(this.it_transobject)
		this.idc_patient.retrieve()
	end choose
	li_rtncode = this.id_master.getchild("doctcode", this.idc_doctors)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_doctors.settransobject(this.it_transobject)
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit to Make Sales")
		close(this)
		return
	end if
	li_rtncode = this.id_detail.getchild("gcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to sale")
		close(this)
		return
	end if
	this.ii_salegodown = this.idc_godown.getitemnumber(1, "gcode")
	this.id_detail.object.gcode.initial = string(this.ii_salegodown)
	li_rtncode = this.id_master.getchild("sprice", this.idc_price)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_price.settransobject(this.it_transobject)
	li_rtncode = this.idc_price.retrieve(this.ii_module, this.il_groupcode)
	if this.ii_saletype <> 3 then
		this.id_master.object.sprice.initial = string(this.idc_price.getitemnumber(1, "pricetypecode"))
	end if
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Price Rights to sale")
		close(this)
		return
	end if
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = true
	this.id_itemslist.object.sstock.visible = true
	this.id_itemslist.object.t_pstock.visible = false
	this.id_itemslist.object.pstock.visible = false
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 513", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		if this.ii_saletype = 2 and f_stringpreferences("CrSPNo") = "Y" then
			this.id_master.object.sprice.visible = true
			this.id_master.object.t_sprice.visible = true
		elseif this.ii_saletype = 3 and f_stringpreferences("CaSPNo") = "Y" then
			this.id_master.object.sprice.visible = true
			this.id_master.object.t_sprice.visible = true
		end if
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 522", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.dd_gstperc.visible = true
		this.id_master.object.gstperc_t.visible = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 523", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_footer.object.rpp.visible = true
		this.id_footer.object.t_rpp.visible = true
		this.id_footer.object.rppmargin.visible = true
		this.id_footer.object.avgprice.visible = true
		this.id_footer.object.purprice.visible = true
		this.id_footer.object.retailprice.visible = true
	end if
	this.is_reportratedeviationusing = f_stringpreferences("ReportRateDeviationUsing")
	if f_stringpreferences("Itemflatdisc") = "N" then
		this.id_detail.object.itemflatdisc.visible = false
	end if
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Sales")
		close(this)
		return
	end if
	if f_stringpreferences("headeronsaleinv") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.t_headerno.visible = false
	end if
	this.id_master.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to lds_headers.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
		ldc_headerno.setitem(ll_counter, "name", "")
	next
	this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
	this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.t_gcode.visible = true
		this.id_master.object.gcode.visible = true
		this.id_master.object.gcode.initial = string(this.ii_salegodown)
		this.id_detail.object.gcode.visible = false
		this.id_footer.object.t_totalstock.visible = false
		this.id_footer.object.totalstock.visible = false
	end if
	if f_stringpreferences("DueItem") = "N" then
		lm_menu = this.menuid
		lm_menu.mf_disablemenu()
	end if
	if f_stringpreferences("packingdescinsale") = "N" then
		this.id_detail.object.packingdesc.visible = false
	end if
	if f_stringpreferences("SaleItemdescription") = "N" then
		this.id_detail.object.saleitemdescription.visible = false
	end if
	if f_stringpreferences("Saleclaimable") = "N" then
		this.id_detail.object.claimable.visible = false
	end if
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 577", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_populateprescription.visible = true
		lm_menu.m_file.m_populateprescription.enabled = true
	else
		lm_menu.m_file.m_populateprescription.visible = false
		lm_menu.m_file.m_populateprescription.enabled = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.sstock.visible = false
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	gd_itemsinfo.sharedata(this.id_itemslist)
	if this.ii_saletype = 2 and f_stringpreferences("discpercincredit") = "N" then
		wf_visibleinvisiblediscount()
	end if
	if f_stringpreferences("itemunittax") = "N" then
		this.id_detail.object.unitsalestax.visible = false
		this.id_detail.object.taxperunit_t.visible = false
		this.id_detail.object.c_sumtaxval.visible = false
		this.id_detail.object.c_taxval.visible = false
		this.id_detail.object.taxval_t.visible = false
	end if
	if f_stringpreferences("itemgstperc") = "N" then
		this.id_detail.object.gstperc.visible = false
		this.id_detail.object.gstperc_t.visible = false
		this.id_detail.object.c_sumgstval.visible = false
		this.id_detail.object.c_gstval.visible = false
		this.id_detail.object.gstval_t.visible = false
	end if
	if f_stringpreferences("invgstperc") = "N" then
		this.id_footer.object.invgstperc1.visible = false
		this.id_footer.object.invgstperc1_t.visible = false
	end if
	if f_stringpreferences("SaleOnZeroPrice") = "N" then
		this.id_detail.setvalidate("Saleprice", "Number(GetText( )) > 0")
	end if
	this.id_master.object.invoicesize.initial = f_stringpreferences("pagesize")
	if f_stringpreferences("bonusinsale") = "N" then
		this.id_detail.object.bonusqty.visible = false
		this.id_footer.object.t_bonus.visible = false
		this.id_footer.object.bonusratio.visible = false
	end if
	if f_stringpreferences("defaultwaranty") = "Y" then
		this.id_master.object.printwaranty.initial = "Y"
	else
		this.id_master.object.printwaranty.initial = "N"
	end if
	if f_stringpreferences("SaleDisplayItemDiscPerc") = "Y" then
		this.id_master.object.itemdiscpercno.visible = true
		this.id_master.object.t_itemdiscpercno.visible = true
	end if
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.id_master.accepttext()
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 563", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.date.protect = 0
		this.id_master.object.date.background.color = rgb(255, 255, 255)
		this.ib_modifydate = true
		lm_menu.m_file.m_setserverdate.visible = true
		lm_menu.m_file.m_setserverdate.enabled = true
	end if
	if not this.ib_modifydate then
		this.id_master.object.date.protect = 1
		this.id_master.settaborder("date", 0)
		lm_menu.m_file.m_setserverdate.visible = false
		lm_menu.m_file.m_setserverdate.enabled = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 577", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_populateprescription.visible = true
		lm_menu.m_file.m_populateprescription.enabled = true
	else
		lm_menu.m_file.m_populateprescription.visible = false
		lm_menu.m_file.m_populateprescription.enabled = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 575", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_itemsalehistory.visible = true
		lm_menu.m_file.m_itemsalehistory.enabled = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 576", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_previousinvoiceinfo.visible = true
		lm_menu.m_file.m_previousinvoiceinfo.enabled = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 588", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_footer.object.invgstperc1.visible = true
		this.id_footer.object.invgstperc1_t.visible = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 589", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_footer.object.flatdisc.visible = true
		this.id_footer.object.flatdisc_t.visible = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 590", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_footer.object.misccharges.visible = true
		this.id_footer.object.misccharges_t.visible = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 591", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_footer.object.invdiscperc.visible = true
		this.id_footer.object.invdiscperc_t.visible = true
		this.id_footer.object.t_discountvalue.visible = true
		this.id_footer.object.t_discvalcap.visible = true
	end if
	f_setcolumnstyle(this.id_detail, "Qty")
	wf_set_itemtotal_formatmask()
	setredraw(true)
	if f_islicenseexpire() = -2 then
		close(this)
	end if

// w_inpatientsale.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	return ::message.returnvalue

// w_inpatientsale.ue_deleteitem_row(long al_row) returns 0 [event]
	long ll_row
	long ll_footerrow
	super::ue_deleteitem_row(al_row)
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() > 0 then
		this.id_footer.setitem(ll_footerrow, "icode", this.id_detail.getitemnumber(ll_row, "icode"))
		this.id_footer.setitem(ll_footerrow, "stock", this.id_detail.getitemnumber(ll_row, "stock"))
		return
	end if
	this.id_footer.setitem(ll_footerrow, "icode", 0)
	this.id_footer.setitem(ll_footerrow, "stock", 0)
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_save.enabled = false

// w_inpatientsale.ue_callback_popupwindow(any ar_object) returns 0 [event]
	long ll_code
	long ll_row
	string as_errortext
	super::ue_callback_popupwindow(ar_object)
	ll_code = long(ar_object)
	ll_row = this.id_detail.getrow()
	if ll_row > 0 and ll_code > 0 then
		this.idc_patient.retrieve()
		if this.id_master.rowcount() > 0 then
			this.id_master.setitem(this.id_master.rowcount(), "admissioncode", ll_code)
		end if
		this.id_master.setfocus()
		this.id_master.setcolumn("admissioncode")
		wf_validate_admissioncode(ll_code)
	end if
	this.id_master.accepttext()

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	if newindex = 1 then
		parent.ii_focuscustomer = 1
	end if
	return ::message.returnvalue

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
	case "flatdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	end choose
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_code
	long ll_detailrows
	long ll_suppcode
	long ll_custcode
	long ll_counter
	long ll_customerbalance
	long ll_headerinvno
	long ll_admissioncode
	integer rt_code
	integer li_res
	integer li_smancode
	double ld_avgprice
	double ld_rpp
	double ld_gstperc1
	double ld_gstperc2
	double ld_custgst
	double ld_invdiscperc
	double ld_itemdiscperc
	double ld_itemdiscperc2
	double ld_itemdiscperc3
	double ld_itemdiscperc4
	double ld_purprice
	long ll_icode
	long ll_rpp
	long li_packunits = 1
	long ll_patientcode
	long ll_null
	string ls_result
	string ls_null
	datetime ld_currdate
	date ld_datepart
	time lt_timepart
	integer li_salepriceno
	integer li_itemdiscpercno
	double ld_saleprice1
	double ld_saleprice2
	double ld_saleprice3
	double ld_saleprice4
	double ld_saleprice5
	double ld_salediscperc
	double ld_salediscperc2
	double ld_salediscperc3
	double ld_salediscperc4
	integer li_custcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "sprice"
		parent.setredraw(false)
		if parent.parent.parent.id_detail.getrow() > 0 and isnull(parent.parent.parent.id_detail.getitemnumber(parent.parent.parent.id_detail.getrow(), "itemcode")) then
			parent.parent.parent.event ue_deleteitem()
		end if
		for ll_counter = 1 to parent.parent.parent.id_detail.rowcount()
			ll_icode = parent.parent.parent.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT item.saleprice , item.saleprice2 , item.saleprice3 , item.avgprice , item.packunits , item.purprice , item.recentpurprice , item.saleprice4 , item.saleprice5 INTO :ld_saleprice1, :ld_saleprice2, :ld_saleprice3, :ld_avgprice, :li_packunits, :ld_purprice, :ld_rpp, :ld_saleprice4, :ld_saleprice5 FROM item WHERE item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = -1 then
				parent.setredraw(true)
				messagebox("Database Error", "Item information can not be retrieved")
				return 1
			end if
			if not (parent.parent.parent.it_transobject.sqlcode = 100) then
				choose case long(data)
				case 1
					parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice1 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice1)
				case 2
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice2 / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice2 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice2)
				case 3
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice3 / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice3 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice3)
				case 7
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice4 / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice4 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice4)
				case 8
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice5 / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice5 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice5)
				case 4
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_purprice / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_purprice / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_purprice)
				case 5
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_rpp / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_rpp / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_rpp)
				case else
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_avgprice / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_avgprice)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_avgprice * li_packunits)
				end choose
			elseif not isnull(parent.parent.parent.id_detail.getitemstring(1, "itemname")) then
				parent.setredraw(true)
				messagebox("DataBase Error", "Rows not retrieve")
				return 0
			end if
		next
		if parent.parent.parent.id_detail.rowcount() <= 0 then
			parent.parent.parent.event ue_newitem()
			parent.parent.parent.id_master.setfocus()
		end if
		parent.setredraw(true)
	case "dd_gstperc"
		for ll_counter = 1 to parent.parent.parent.id_detail.rowcount()
			ll_icode = parent.parent.parent.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT item.gstperc1 , item.gstperc2 INTO :ld_gstperc1, :ld_gstperc2 FROM item WHERE item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = -1 then
				messagebox("Database Error", "Item information can not be retrieved")
				return 1
			end if
			if not (parent.parent.parent.it_transobject.sqlcode = 100) then
				if data = "2" then
					parent.parent.parent.id_detail.setitem(ll_counter, "gstperc", ld_gstperc2)
				else
					parent.parent.parent.id_detail.setitem(ll_counter, "gstperc", ld_gstperc1)
				end if
			end if
		next
	case "itemdiscpercno"
		for ll_counter = 1 to parent.parent.parent.id_detail.rowcount()
			ll_icode = parent.parent.parent.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT item.salediscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 INTO :ld_salediscperc, :ld_salediscperc2, :ld_salediscperc3, :ld_salediscperc4 FROM item WHERE item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = -1 then
				messagebox("Database Error", "Item information can not be retrieved")
				return 1
			end if
			if long(parent.parent.parent.id_detail.object.discperc.visible) = 1 then
				choose case data
				case "1"
					parent.parent.parent.id_detail.setitem(ll_counter, "discperc", ld_salediscperc)
				case "2"
					parent.parent.parent.id_detail.setitem(ll_counter, "discperc", ld_salediscperc2)
				case "3"
					parent.parent.parent.id_detail.setitem(ll_counter, "discperc", ld_salediscperc3)
				case "4"
					parent.parent.parent.id_detail.setitem(ll_counter, "discperc", ld_salediscperc4)
				end choose
			else
				parent.parent.parent.id_detail.setitem(ll_counter, "discperc", 0)
			end if
		next
	case "headerno"
		setnull(ll_headerinvno)
		setitem(row, "headerinvno", ll_headerinvno)
	case "date"
	case "aliasname"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findcustcode(data, li_custcode)
			if li_res > 0 then
				setitem(row, "custcode", li_custcode)
				rt_code = parent.parent.parent.wf_setcustomerinfo(row, 1, string(li_custcode))
			else
				messagebox("Customer Validation", "Customer with  Alias Name  " + data + " does not exist")
				return 1
			end if
		else
			return 0
		end if
	case "patientregno"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findadmissioncode(data, ll_admissioncode)
			if li_res > 0 then
				setitem(row, "admissioncode", ll_admissioncode)
				rt_code = 0
				if parent.parent.parent.ii_saletype = 2 then
					SQL SELECT patient.custcode INTO :ll_custcode FROM patient , patientadmission WHERE patientadmission.discharged1 ='N' and patientadmission.discharged ='N' and patientadmission.admissioncode =:ll_admissioncode and patient.patientcode =patientadmission.patientcode USING parent.parent.parent.it_transobject;
					if parent.parent.parent.it_transobject.sqlcode = 0 then
						parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
						parent.parent.parent.id_master.object.custcode.protect = 1
						parent.parent.parent.id_master.object.aliasname.protect = 1
						rt_code = parent.parent.parent.wf_setcustomerinfo(row, 1, string(ll_custcode))
						parent.parent.parent.wf_setadmissiondetails(ll_admissioncode)
					else
						messagebox("Patient Information", "Problem in retrieving corresponding customer")
						rt_code = 1
					end if
				end if
			else
				messagebox("Patient Validation", "Patient with  RegNo  " + data + " is not admitted yet. Kindly select some other patient.")
				rt_code = 1
			end if
		end if
	case "custcode"
		return parent.parent.parent.wf_setcustomerinfo(row, 1, data)
	case "messagecode"
		if not isnull(getitemnumber(row, "custcode")) then
			rt_code = parent.parent.parent.wf_customermessagevalidation(getitemnumber(row, "custcode"), long(data))
			if rt_code = 1 then
				rt_code = messagebox("Invalid Message Alert", "Wrong Message Selected" + "~rIs That Ok?", question!, yesno!, 2)
				if rt_code = 1 then
					rt_code = 0
				end if
			end if
		end if
	case "admissioncode"
		return parent.parent.parent.wf_validate_admissioncode(long(data))
	end choose
	return rt_code

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "date"
		messagebox("Date Time Validation", "Date and Time is invalid,~r~nPlease enter current date and time")
	case "custcode"
		messagebox("Customer Name Validation", "You must select some Customer")
	case "custrefno"
		if data = "" or isnull(data) then
			messagebox("Customer Reference Validation", "Please Enter Reference")
		end if
	case "headerno"
		if data = "" or isnull(data) then
			messagebox("Header No Validation", "You must select some HeaderNo")
		end if
	case "Regno"
		if data = "" or isnull(data) then
			messagebox("Patient Validation", "RegNo Does Not Exist")
		end if
	end choose
	return 1

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	long ll_found
	long ll_admissioncode
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyenter! and getcolumnname() = "custcode" then
		parent.parent.parent.id_master.setitem(1, "custcode", parent.parent.parent.idc_customers.getitemnumber(parent.parent.parent.idc_customers.getrow(), "accounts_acccode"))
		if parent.parent.parent.il_custcode <> parent.parent.parent.id_master.getitemnumber(1, "custcode") and parent.parent.parent.wf_setcustomerinfo(1, 1, string(parent.parent.parent.idc_customers.getitemnumber(parent.parent.parent.idc_customers.getrow(), "accounts_acccode"))) = 1 then
			parent.parent.parent.id_master.setitem(1, "custcode", 0)
		end if
	end if
	if key = keyf5! and getcolumnname() = "admissioncode" then
		ll_found = gds_security.find("rightcode = 369 OR rightcode = 1220 ", 1, gds_security.rowcount())
		if ll_found > 0 then
			parent.parent.parent.wf_open_item_form_popup()
		end if
	elseif key = keyf6! and getcolumnname() = "admissioncode" then
		ll_admissioncode = this.object.admissioncode[1]
		openwithparm(w_mr_patient_prescription_view, ll_admissioncode)
	elseif key = keyf9! and getcolumnname() = "admissioncode" then
		parent.parent.parent.wf_show_patientgallery()
	end if
	return ::message.returnvalue

// dw_detail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	parent.parent.parent.post wf_setcustomername(data)
	return ::message.returnvalue

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if string(dwo.name) = "custcode" then
		parent.parent.parent.id_master.selecttext(1, 40)
		if f_stringpreferences("CreditSaleAutoPopUpWindow") = "Y" then
			parent.parent.parent.post wf_viewheader()
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_focuscustomer() returns 0 [event]
	integer ll_row
	integer ll_custcode
	parent.parent.parent.id_master.setcolumn("custcode")
	parent.parent.parent.id_master.setfocus()
	messagebox("Customer Selection", "Please select a Customer from the Dropdown Box")

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	long ll_null
	long ll_icode
	long ll_gcode
	string ls_null
	string ls_itemname
	double ld_invdiscperc
	double ld_newqty
	double ld_storedqty
	double ld_stock
	double ld_desiredbonus
	integer li_res
	integer li_saleprice
	double ld_salediscperc
	double ld_purdiscperc
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
		parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		if f_stringpreferences("multigodown") = "N" then
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = row
			li_errcode = 0
		else
			parent.parent.parent.ib_godownvalidated = false
			parent.parent.parent.ib_itemvalidated = true
		end if
	case "looseqty"
		ld_newqty = double(data) + getitemnumber(row, "bonusqty")
		ld_storedqty = getitemnumber(row, "looseqty") + getitemnumber(row, "bonusqty")
		if ld_newqty > ld_storedqty then
			ld_stock = this.object.stock[row]
			if ld_newqty > ld_stock then
				messagebox("Quantity Validation", "Quantity " + data + " exceeds the stock")
				selecttext(1, len(data))
				li_errcode = 1
			elseif f_stringpreferences("BonusinSale") = "Y" then
				if getitemnumber(row, "qtysale") = 0.0 then
					ld_desiredbonus = double(data) / 1.0 * getitemnumber(row, "Bonus")
				else
					ld_desiredbonus = double(data) / double(getitemnumber(row, "qtysale")) * double(getitemnumber(row, "Bonus"))
				end if
				if double(data) + ld_desiredbonus <= ld_stock then
					setitem(row, "bonusqty", ld_desiredbonus)
				elseif double(data) > ld_stock then
					messagebox("Quantity Validation", "Quantity " + data + " exceeds the stock")
					selecttext(1, len(data))
					li_errcode = 1
				else
					ld_desiredbonus = messagebox("Problem allocating bonus", "Sale Qty = " + data + " ~r" + "Required Bonus = " + trim(string(ld_desiredbonus)) + " ~r" + "Stock available = " + trim(string(ld_stock)) + " ~r" + "Allocate possible bonus?", question!, yesno!, 2)
					if ld_desiredbonus = 1.0 then
						li_errcode = -1
						setitem(row, "bonusqty", ld_stock - double(data))
					else
						li_errcode = 1
						setitem(row, "bonusqty", 0)
						selecttext(1, len(data))
					end if
				end if
			end if
		elseif ld_newqty <= 0.0 and f_stringpreferences("BonusinSale") = "N" then
			messagebox("Quantity Validation", "Item Qty ~"" + data + "~" should be greater than zero")
			li_errcode = 1
		elseif ld_newqty <= 0.0 and f_stringpreferences("BonusinSale") = "Y" then
			if ld_newqty < 0.0 then
				messagebox("Quantity Validation", "Item Qty ~"" + data + "~" should be greater than zero")
				li_errcode = 1
			end if
		elseif ld_newqty <= ld_storedqty then
			ld_stock = this.object.stock[row]
			if ld_newqty > ld_stock then
				messagebox("Quantity Validation", "Quantity " + data + " exceeds the stock")
				selecttext(1, len(data))
				li_errcode = 1
			elseif f_stringpreferences("BonusinSale") = "Y" then
				if getitemnumber(row, "qtysale") = 0.0 then
					ld_desiredbonus = double(data) / 1.0 * double(getitemnumber(row, "Bonus"))
				else
					ld_desiredbonus = double(data) / double(getitemnumber(row, "qtysale")) * double(getitemnumber(row, "Bonus"))
				end if
				if double(data) + ld_desiredbonus <= ld_stock then
					setitem(row, "bonusqty", ld_desiredbonus)
				elseif double(data) > ld_stock then
					messagebox("Quantity Validation", "Quantity " + data + " exceeds the stock")
					selecttext(1, len(data))
					li_errcode = 1
				else
					ld_desiredbonus = messagebox("Problem allocating bonus", "Sale Qty = " + data + " ~r" + "Required Bonus = " + trim(string(ld_desiredbonus)) + " ~r" + "Stock available = " + trim(string(ld_stock)) + " ~r" + "Allocate possible bonus?", question!, yesno!, 2)
					if ld_desiredbonus = 1.0 then
						li_errcode = -1
						setitem(row, "bonusqty", ld_stock - double(data))
						selecttext(1, len(data))
					else
						li_errcode = 1
						setitem(row, "bonusqty", 0)
						selecttext(1, len(data))
					end if
				end if
			end if
		end if
	case "bonusqty"
		ld_newqty = double(data) + getitemnumber(row, "looseQty")
		ld_storedqty = getitemnumber(row, "looseqty") + getitemnumber(row, "bonusqty")
		if ld_newqty > ld_storedqty then
			ld_stock = this.object.stock[row]
			if ld_newqty > ld_stock then
				messagebox("Quantity Validation", "Total Quantity " + string(ld_newqty) + " exceeds the stock")
				selecttext(1, len(data))
				li_errcode = 1
			end if
		elseif ld_newqty <= 0.0 and f_stringpreferences("BonusinSale") = "Y" and ld_newqty <= 0.0 then
			messagebox("Quantity Validation", "Item Qty ~"" + data + "~" should be greater than zero")
			li_errcode = 1
		end if
		if f_stringpreferences("BonusinSale") = "Y" and li_errcode <> 1 then
			if getitemnumber(row, "qtysale") = 0.0 then
				ld_desiredbonus = double(getitemnumber(row, "looseqty") / 1.0) * double(getitemnumber(row, "Bonus"))
			else
				ld_desiredbonus = double(getitemnumber(row, "looseqty") / double(getitemnumber(row, "qtysale"))) * double(getitemnumber(row, "Bonus"))
			end if
			if double(data) > ld_desiredbonus then
				ld_desiredbonus = messagebox("Bonus Quantity Alert", "Bonus Quantity Should Be = " + string(ld_desiredbonus) + "~rRequested Bonus Quantity is = " + data + "~rIs That Ok?", question!, yesno!, 2)
				if ld_desiredbonus = 1.0 then
					li_errcode = -1
				else
					li_errcode = 1
				end if
			end if
		end if
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname)
			if li_res > 0 then
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
			else
				messagebox("ItemNumber Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_errcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_errcode = 2
		end if
	case "saleprice"
		setitem(row, "updatesaleprice", "Y")
		if getitemstring(row, "locksaleprice") = "Y" then
			messagebox("SalePrice Validation", "SalePrice is locked, you can not change it ")
			li_errcode = 2
		else
			li_errcode = parent.parent.parent.wf_itemnetprice(double(data), parent.parent.parent.id_detail.getitemnumber(row, "discperc"), parent.parent.parent.id_detail.getitemnumber(row, "Itemflatdisc"), this.object.icode[row])
		end if
	case "gcode"
		parent.parent.parent.is_columnname = "gcode"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_godownvalidated = false
		li_errcode = 0
	case "itemflatdisc"
		li_saleprice = getitemnumber(row, "saleprice")
		if li_saleprice < long(data) then
			messagebox("FlatDisc Validation", "Itemflatdisc must be less than sale price")
			li_errcode = 1
		end if
		li_errcode = parent.parent.parent.wf_itemnetprice(parent.parent.parent.id_detail.getitemnumber(row, "saleprice"), parent.parent.parent.id_detail.getitemnumber(row, "discperc"), double(data), this.object.icode[row])
	case "discperc"
		if getitemstring(row, "lockdiscperc") = "Y" then
			messagebox("Disc(%) Validation", "Disc(%) is locked, you can not change it")
			li_errcode = 2
		else
			if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
				ld_salediscperc = double(data)
				ll_icode = this.object.icode[row]
				SQL Select item.purdiscperc INTO :ld_purdiscperc From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
				if ld_salediscperc > ld_purdiscperc then
					messagebox("Discount Validation", "Discount(%) " + data + " exceeds the purchase discount")
					li_errcode = 1
				end if
			end if
			li_errcode = parent.parent.parent.wf_itemnetprice(parent.parent.parent.id_detail.getitemnumber(row, "saleprice"), double(data), parent.parent.parent.id_detail.getitemnumber(row, "Itemflatdisc"), this.object.icode[row])
		end if
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ll_icode
	long ll_gcode
	long ll_count
	long ll_check_dup_icode
	long ancestorreturnvalue
	ll_check_dup_icode = parent.parent.parent.id_detail.getitemnumber(row, "icode")
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(false) = -1 then
		return ::message.returnvalue
	end if
	if parent.parent.parent.ib_godownvalidated = false and parent.parent.parent.wf_validategodown() = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "itemname" then
		parent.parent.parent.ib_focusdetail = true
	end if
	if dwo.name = "looseqty" and parent.parent.parent.ib_itemslistopen then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
	end if
	parent.parent.parent.wf_grandtotal()
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return 0

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	double ld_rppmargin
	dwitemstatus lrs_status
	long ll_icode
	double ld_purdiscperc
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if currentrow > 0 then
		parent.parent.parent.is_aliasname = getitemstring(currentrow, "fullcode")
	end if
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(true) = -1 then
		return ::message.returnvalue
	end if
	if parent.parent.parent.ib_godownvalidated = false and parent.parent.parent.wf_validategodown() = -1 then
		return ::message.returnvalue
	end if
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if getcolumnname() <> parent.parent.parent.is_columnitemname then
		if rowcount() > 0 and lrs_status <> new! then
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", getitemnumber(currentrow, "icode"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", getitemnumber(currentrow, "stock"))
			ld_rppmargin = getitemnumber(currentrow, "packprice") - getitemnumber(currentrow, "recentpurprice")
			if getitemnumber(currentrow, "packprice") = 0.0 then
				ld_rppmargin = ld_rppmargin * 100.0
			elseif getitemnumber(currentrow, "packprice") = 0.0 or isnull(getitemnumber(currentrow, "packprice")) then
				ld_rppmargin = ld_rppmargin * 100.0
			else
				ld_rppmargin = ld_rppmargin / getitemnumber(currentrow, "packprice") * 100.0
			end if
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "rppmargin", ld_rppmargin)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "rpp", getitemnumber(currentrow, "recentpurprice"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "purprice", getitemnumber(currentrow, "purprice"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "avgprice", getitemnumber(currentrow, "avgprice"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "itemtotalval", getitemstring(currentrow, "itemtotalval"))
			if f_stringpreferences("BonusinSale") = "Y" then
				parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "bonusratio", trim(string(getitemnumber(currentrow, "qtysale"))) + ":" + trim(string(getitemnumber(currentrow, "bonus"))))
			end if
			if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
				ll_icode = this.object.icode[currentrow]
				SQL Select item.purdiscperc INTO :ld_purdiscperc From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
				parent.parent.parent.id_footer.object.t_purdiscper.text = string(ld_purdiscperc)
			end if
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", getitemnumber(currentrow, "totalstock"))
		elseif parent.parent.parent.id_footer.getrow() > 0 then
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", 0)
			if f_stringpreferences("BonusinSale") = "Y" then
				parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "bonusratio", "")
			end if
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	long ll_currentrow
	string ls_holdstr
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	if f_stringpreferences("DisplayPool") = "Y" then
		ll_currentrow = getrow()
		if ll_currentrow <> 0 and parent.parent.parent.ib_lcdshow = true then
			ls_holdstr = this.object.itemname[ll_currentrow]
			if len(ls_holdstr) < 20 then
				parent.parent.parent.is_lcditem = ls_holdstr + space(20 - len(ls_holdstr))
			else
				parent.parent.parent.is_lcditem = left(ls_holdstr, 20)
			end if
			parent.parent.parent.is_lcditem = parent.parent.parent.is_lcditem + "Qty=" + string(this.object.looseqty[ll_currentrow])
			parent.parent.parent.is_lcditem = parent.parent.parent.is_lcditem + " Rs=" + string(this.object.saleprice[ll_currentrow], "#######0.00")
			parent.parent.parent.ic_comport.triggerevent("ue_show")
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "fullcode"
		if data = "" or isnull(data) then
		end if
	case parent.parent.parent.is_columnitemname
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case "looseqty"
	case "packqty"
		if real(data) < 1.0 then
			messagebox("Item Qty Validation", "Item Qty ~"" + data + "~" should be greater than zero")
		end if
	case "discperc"
		if real(data) < 0.0 and real(data) > 100.0 then
			messagebox("Item Discount Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
		end if
	case "saleprice"
		if double(data) < 0.0 then
			messagebox("Item Price Validation", "Item price ~"" + data + "~" must be greater than or equal to zero")
			return 1
		end if
	end choose
	return 1

// dw_itemsdetail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	integer ll_row
	integer ll_custcode
	long ancestorreturnvalue
	if f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	if parent.parent.parent.ii_saletype = 2 then
		ll_row = parent.parent.parent.id_master.getrow()
		ll_custcode = parent.parent.parent.id_master.object.custcode[ll_row]
		if parent.parent.parent.ii_focuscustomer = 2 and ll_custcode = 0 then
			post event ue_focuscustomer()
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanging(long currentrow, long newrow) returns long [event]
	long ancestorreturnvalue
	string ls_holdstr
	ancestorreturnvalue = super::rowfocuschanging(currentrow, newrow)
	if currentrow <= rowcount() then
		if currentrow > 0 and parent.parent.parent.id_detail.rowcount() > 0 and parent.parent.parent.id_detail.getitemnumber(currentrow, "looseqty") + parent.parent.parent.id_detail.getitemnumber(currentrow, "bonusqty") <= 0.0 then
			messagebox("Sale Qty Validation", "Please Enter Valid Sale Qty")
			parent.parent.parent.id_detail.setcolumn("looseqty")
			parent.parent.parent.id_detail.setrow(currentrow)
			return 1
		end if
		if f_stringpreferences("DisplayPool") = "Y" and (currentrow <> 0 and parent.parent.parent.ib_lcdshow = true) and parent.parent.parent.id_detail.rowcount() > 0 then
			ls_holdstr = this.object.itemname[currentrow]
			if len(ls_holdstr) < 20 then
				parent.parent.parent.is_lcditem = ls_holdstr + space(20 - len(ls_holdstr))
			else
				parent.parent.parent.is_lcditem = left(ls_holdstr, 20)
			end if
			parent.parent.parent.is_lcditem = parent.parent.parent.is_lcditem + "Qty=" + string(this.object.looseqty[currentrow])
			parent.parent.parent.is_lcditem = parent.parent.parent.is_lcditem + " Rs=" + string(this.object.saleprice[currentrow], "#######0.00")
			parent.parent.parent.ic_comport.postevent("ue_show")
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	integer li_rowno
	integer i
	boolean lb_duplicate
	if getrow() = rowcount() then
		for i = 1 to parent.parent.parent.id_detail.rowcount() - 1
			if parent.parent.parent.id_detail.getitemstring(i, "fullcode") = parent.parent.parent.is_aliasname then
				lb_duplicate = true
			end if
		next
		if getcolumn() = 1 and not lb_duplicate and gs_company = "KSS" then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
		if getcolumn() = integer(this.object.datawindow.column.count) then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
	elseif not ((gs_company = "SHE" or gs_company = "RIZWAN" or gs_company = "REHMAT" or gs_company = "ALABBAS") and parent.parent.parent.ii_saletype = 2) and getcolumn() = integer(this.object.datawindow.column.count) then
		scrollnextrow()
		if f_stringpreferences("ItemCode") = "Y" then
			setcolumn(1)
		else
			setcolumn(2)
		end if
		setfocus()
		return 1
	end if
	li_rowno = gd_itemsinfo.find("fullcode='" + parent.parent.parent.is_aliasname + "'", 1, gd_itemsinfo.rowcount())
	if getcolumn() = 1 and li_rowno > 0 then
		if (gs_company = "SHE" or gs_company = "KOHSAR" or gs_company = "RIZWAN" or gs_company = "REHMAT" or gs_company = "ALABBAS") and parent.parent.parent.ii_saletype = 2 then
			parent.parent.parent.id_detail.setcolumn(integer(this.object.datawindow.column.count) - 3)
		else
			parent.parent.parent.id_detail.setcolumn(integer(this.object.datawindow.column.count))
		end if
		setfocus()
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	if getcolumn() = 1 then
		parent.parent.parent.is_aliasname = data
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_focusqty() returns 0 [event]
	call super::ue_focusqty

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_counter
	long ll_rowm
	s_positem ls_itemdetail
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(99999)
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(1)
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf4! then
			parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
			setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
			setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	elseif key = keydownarrow! then
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_focusfooter")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	end if
	if getcolumnname() = "looseqty" and key = keyf5! then
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 545 then
				ls_itemdetail.l_icode = getitemnumber(getrow(), "icode")
				if isnull(ls_itemdetail.l_icode) then
					messagebox("Item Validation", "Please select some item in the current row, than try again.")
				else
					openwithparm(w_popup_itempriority_settings, ls_itemdetail)
				end if
				exit
			end if
		next
		rt_code = 1
	end if
	return rt_code

// tabpage_list.create() returns 0 [event]
	integer icurrent
	this.st_3 = create st_3
	this.em_invno = create em_invno
	call super::create
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_3
	this.control[icurrent + 2] = this.em_invno

// tabpage_list.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_3
	destroy this.em_invno

// em_invno.ue_downkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		parent.parent.parent.tab_retrieve.selecttab(1)
	end if
	return ::message.returnvalue

// ic_comport.ue_show() returns long [event]
	if isnull(parent.is_lcditem) then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
			parent.is_lcditem = char(26) + char(1)
			parent.ic_comport.triggerevent("ue_show")
			parent.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
			parent.ic_comport.triggerevent("ue_show")
			return 1
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
			parent.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
		else
			parent.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
		end if
	end if
	this.object.portopen = true
	if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
		this.object.output = char(26) + parent.is_lcditem
	elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
		this.object.output = char(12) + parent.is_lcditem
	else
		this.object.output = char(12) + parent.is_lcditem
	end if
	this.object.portopen = false
	return 1

// ic_comport.constructor() returns long [event]
	if f_stringpreferences("DisplayPool") = "Y" then
		this.object.commport = 2
		this.object.settings = "9600,N,8,1"
		this.object.inputlen = 0
	end if
	return ::message.returnvalue

// ic_drawerport.constructor() returns long [event]
	if f_stringpreferences("CashDrawer") = "Y" then
		this.object.commport = 1
		this.object.settings = "300,N,8,1"
		this.object.inputlen = 0
	end if
	return ::message.returnvalue
