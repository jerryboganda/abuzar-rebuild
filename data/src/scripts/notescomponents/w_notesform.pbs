// window w_notesform (notescomponents)  ancestor: w_multi_entry

// w_notesform.wf_deletenote(long al_notecode) returns integer
	SQL Delete notesdetail Where notesdetail.NoteCode =:al_notecode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_notesform.wf_detailrowcount(long al_notecode) returns long
	long ll_count
	SQL SELECT ISNULL ( COUNT ( NoteCode ) , 0 ) INTO :ll_count FROM NotesDetail WHERE NOTECODE =:al_notecode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		ll_count = 0
	end if
	return ll_count

// w_notesform.wf_getinvinfo(long al_notecode, long al_invcode, double ad_amt) returns integer
	SQL Select IsNull ( Sum ( notesdetail.amt ) , 0 ) INTO :ad_amt from notesdetail where notesdetail.notecode =:al_notecode and notesdetail.invoicecode =:al_invcode USING this.it_transobject;
	if isnull(ad_amt) then
		ad_amt = 0
	end if
	return this.it_transobject.sqlcode

// w_notesform.wf_getnewvouchercode(integer ai_notecatcode, long al_vouchercode, transaction at_transobject) returns integer
	long ll_rtcode
	SQL SELECT NOTESCATEGORY.COUNTER INTO :al_vouchercode FROM NOTESCATEGORY WITH ( UPDLOCK HOLDLOCK ) WHERE NOTESCATEGORY.NoteCatCode =:ai_notecatcode USING at_transobject;
	if at_transobject.sqlcode = 0 then
		al_vouchercode = al_vouchercode + 1
		SQL update dbo.NOTESCATEGORY SET Counter =:al_vouchercode WHERE NOTESCATEGORY.NoteCatCode =:ai_notecatcode USING at_transobject;
		if at_transobject.sqlcode < 0 then
			ll_rtcode = at_transobject.sqlcode
			al_vouchercode = 0
		end if
	else
		ll_rtcode = at_transobject.sqlcode
		al_vouchercode = 0
	end if
	return ll_rtcode

// w_notesform.wf_grandtotal() returns double
	long ll_count
	long ll_masterorow
	double ld_amt
	ll_masterorow = this.id_master.rowcount()
	if ll_masterorow > 0 then
		ll_count = this.id_detail.rowcount()
		if ll_count > 0 then
			if isnull(this.id_detail.getitemdecimal(1, "c_amt")) then
				ld_amt = this.id_master.object.amount[ll_masterorow]
			else
				ld_amt = this.id_master.object.amount[ll_masterorow] - this.id_detail.getitemdecimal(1, "c_amt")
			end if
		else
			ld_amt = this.id_master.object.amount[ll_masterorow]
		end if
		this.id_master.object.unappliedamt[ll_masterorow] = ld_amt
	end if
	return ld_amt

// w_notesform.wf_initmodify(integer ai_protect) returns 0
	long ll_notecode
	long ll_invcode
	long ll_counter
	long ll_count
	double ld_balance
	double ld_amt
	double ld_oldamt
	double ld_srbalance
	string ls_itemtotalval
	this.idc_invoices.settransobject(this.it_transobject)
	ll_count = this.idc_invoices.retrieve(this.id_master.getitemnumber(1, "acccode"), this.id_master.getitemnumber(1, "code"), this.is_module)
	if ll_count <= 0 then
		this.idc_invoices.insertrow(0)
	end if
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_notecode = this.id_master.getitemnumber(1, "code")
		if wf_locknote(ll_notecode) = 0 then
			this.id_master.retrieve(ll_notecode)
			if wf_detailrowcount(ll_notecode) > 0 then
				this.id_detail.retrieve(ll_notecode)
			end if
			for ll_count = 1 to this.id_detail.rowcount()
				ll_invcode = this.id_detail.getitemnumber(ll_count, "invoicecode")
				ld_amt = this.id_detail.getitemdecimal(ll_count, "amt")
				if this.ii_notetype = 1 then
					this.it_transobject.getsaleinvbalance(ll_invcode, ld_balance)
				else
					this.it_transobject.getpurinvbalance(ll_invcode, ld_balance)
				end if
				if this.it_transobject.sqlcode <> 0 then
					ai_protect = 0
				else
					this.id_detail.setitem(ll_count, "outstandingamt", ld_balance + ld_amt)
				end if
			next
			if ai_protect = 0 then
				this.ib_modify = true
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
			return
		end if
		messagebox("Cannot Modify", "Invoice is already in use")
	end if

// w_notesform.wf_lockinvoice(long al_invcode) returns integer
	integer li_count
	this.it_transobject.dbparm = " Async =1, DBGetTime = 20"
	if this.ii_notetype = 1 then
		this.it_transobject.locksaleinvoice(al_invcode)
	else
		this.it_transobject.lockpurinvoice(al_invcode)
	end if
	this.it_transobject.dbparm = "Async =0, DBGetTime = 0"
	return this.it_transobject.sqlcode

// w_notesform.wf_locknote(long al_notecode) returns integer
	integer li_count
	this.it_transobject.dbparm = " Async =1, DBGetTime = 20"
	this.it_transobject.locknote(al_notecode)
	this.it_transobject.dbparm = "Async =0, DBGetTime = 0"
	return this.it_transobject.sqlcode

// w_notesform.wf_locknotes(long al_sinvcode, long al_linvcode, long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From Notes WITH ( UPDLOCK HOLDLOCK ) Where Notes.NoteCode Between :al_sinvcode AND :al_linvcode AND Notes.NoteCatCode =:this.ii_notetype AND Notes.Posted ='N' AND Finalized ='Y' AND BankAccCode IS NOT NULL USING sqlca;
	return sqlca.sqlcode

// w_notesform.wf_populate_ddlb(datawindow dwcontrol) returns 0
	integer li_column_count
	integer li_counter
	string ls_column_name
	string ls_columntype
	this.tab_retrieve.tabpage_list.ddlb_filter_column.reset()
	this.tab_retrieve.tabpage_list.ddlb_sort.reset()
	li_column_count = integer(dwcontrol.object.datawindow.column.count)
	for li_counter = li_column_count to li_counter step -1
		ls_column_name = dwcontrol.describe("#" + string(li_counter) + ".Name")
		this.tab_retrieve.tabpage_list.ddlb_sort.additem(ls_column_name)
		this.tab_retrieve.tabpage_list.ddlb_filter_column.additem(ls_column_name)
	next
	this.tab_retrieve.tabpage_list.ddlb_sort.text = ls_column_name
	ls_columntype = this.id_dwcontrol.describe("#1.ColType")
	if left(ls_columntype, 4) = "char" then
		this.ii_type = 1
	elseif left(ls_columntype, 4) = "date" then
		this.ii_type = 3
	else
		this.ii_type = 2
	end if
	this.ii_colindex = 1
	this.tab_retrieve.tabpage_list.rb_descending.checked = true
	wf_sortdw(this.tab_retrieve.tabpage_list.ddlb_sort.text, this.is_sortsequence)
	this.id_master.setfocus()

// w_notesform.wf_post() returns integer
	integer li_errcode
	long ll_usercode
	long ll_invcount
	long ll_counter
	boolean lb_flag
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_usercode = long(message.doubleparm)
	setfocus()
	if ll_usercode > 0 then
		open(w_arg_account_sinv_linv)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			li_errcode = wf_locknotes(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_invcount)
			if li_errcode = 0 then
				sqlca.postnotes(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_usercode, lstr_arginfo.l_code3, this.ii_notetype, lstr_arginfo.l_code4)
				if sqlca.sqlcode <> 0 then
					li_errcode = -1
				end if
			else
				li_errcode = -1
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_usercode > 0 then
		if li_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again")
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_invcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return li_errcode

// w_notesform.wf_print() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_count
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			for ll_count = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
				this.id_print.retrieve(ll_count)
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			next
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	return li_errcode

// w_notesform.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_notesform.wf_returnnote(long al_invid, string as_errortext) returns boolean
	long ll_invcode
	long ll_counter
	long ll_detailrows
	long ll_masterrow
	boolean lb_commitflag
	double ld_amt
	double ld_oldtotalamt
	double ld_balance
	double ld_totalamt
	double ld_newbalance
	this.id_notesdetail.retrieve(al_invid)
	as_errortext = "Some database problem occur"
	ll_detailrows = this.id_notesdetail.rowcount()
	ll_counter = 1
	do while ll_counter <= ll_detailrows and lb_commitflag
		ll_invcode = this.id_notesdetail.getitemnumber(ll_counter, "invoicecode")
		ld_amt = this.id_notesdetail.getitemdecimal(ll_counter, "amt")
		if wf_lockinvoice(ll_invcode) = 0 then
			if this.ii_notetype = 1 then
				this.it_transobject.getsaleinvbalance(ll_invcode, ld_balance)
				if this.it_transobject.sqlcode = 0 then
					if ld_amt > 0.0 and lb_commitflag then
						ld_newbalance = ld_balance + ld_amt
						this.it_transobject.updatesaleinvbalance(ll_invcode, ld_newbalance)
						if this.it_transobject.sqlcode <> 0 then
							lb_commitflag = false
							as_errortext = "Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
						end if
					else
						lb_commitflag = false
						as_errortext = "Not Enough Balance On Sale Invoice."
					end if
				else
					lb_commitflag = false
					as_errortext = "Balance Retrieval Error:~r~n" + this.it_transobject.sqlerrtext
				end if
			else
				this.it_transobject.getpurinvbalance(ll_invcode, ld_balance)
				if this.it_transobject.sqlcode = 0 then
					if ld_amt > 0.0 and lb_commitflag then
						ld_newbalance = ld_balance + ld_amt
						this.it_transobject.updatepurinvbalance(ll_invcode, ld_newbalance)
						if this.it_transobject.sqlcode <> 0 then
							lb_commitflag = false
							as_errortext = "Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
						end if
					else
						lb_commitflag = false
						as_errortext = "Not Enough Balance On Purchase Invoice."
					end if
				else
					lb_commitflag = false
					as_errortext = "Balance Retrieval Error:~r~n" + this.it_transobject.sqlerrtext
				end if
			end if
		else
			lb_commitflag = false
			as_errortext = "Invoice is used by another user"
		end if
		ll_counter = ll_counter + 1
	loop
	if lb_commitflag and wf_deletenote(al_invid) <> 0 then
		lb_commitflag = false
		as_errortext = "Some database problem occur during modification of this sale invoice"
	end if
	return lb_commitflag

// w_notesform.wf_setaccountinfo(long al_acccode) returns integer
	integer li_rtcode
	long ll_row
	long ll_acccode
	double ld_returnamt
	double ld_outstandingamt
	double ld_oldamt
	string ls_aliasname
	string ls_name
	SQL SELECT Accounts.AliasName , Accounts.Name , Accounts.AccCode INTO :ls_aliasname, :ls_name, :ll_acccode FROM Accounts WHERE Accounts.AccCode =:al_acccode USING this.it_transobject;
	ll_row = this.id_master.getrow()
	li_rtcode = 0
	if this.it_transobject.sqlcode = 0 then
		if ll_acccode > 0 then
			this.id_master.object.acccode[ll_row] = ll_acccode
			this.id_master.object.aliasname[ll_row] = ls_aliasname
		else
			li_rtcode = 1
		end if
	else
		li_rtcode = 1
	end if
	return li_rtcode

// w_notesform.wf_setaliasname(string as_aliasname) returns integer
	integer li_rtcode
	integer li_result
	long ll_row
	long ll_acccode
	long ll_detailrows
	string ls_aliasname
	string ls_name
	dwitemstatus lrs_status
	SQL SELECT Accounts.AliasName , Accounts.Name , Accounts.AccCode INTO :ls_aliasname, :ls_name, :ll_acccode FROM Accounts WHERE Accounts.AliasName =:as_aliasname USING this.it_transobject;
	ll_row = this.id_master.getrow()
	li_rtcode = 0
	if this.it_transobject.sqlcode = 0 then
		if ll_acccode > 0 then
			ll_detailrows = this.id_detail.rowcount()
			if ll_detailrows > 0 then
				lrs_status = this.id_detail.getitemstatus(1, 0, primary!)
				if lrs_status <> new! and not isnull(this.id_detail.getitemnumber(1, "invoicecode")) then
					li_result = messagebox("Warning", "Rows in Detail Window will be Lost", exclamation!, okcancel!, 2)
					if li_result = 2 then
						li_rtcode = 2
					else
						this.id_detail.setredraw(false)
						this.id_detail.reset()
						this.id_detail.insertrow(0)
						this.id_detail.setfocus()
						this.id_detail.setredraw(true)
					end if
				end if
			end if
			if li_rtcode = 0 then
				this.id_master.object.acccode[ll_row] = ll_acccode
				this.id_master.object.aliasname[ll_row] = ls_aliasname
			end if
		else
			li_rtcode = 1
		end if
	else
		li_rtcode = 1
	end if
	return li_rtcode

// w_notesform.wf_validateamt(long al_invcode, long al_row, double ad_amt) returns boolean
	long ll_detailcount
	long ll_masterrow
	boolean lb_retval
	double ld_amttotal
	ll_detailcount = this.id_detail.rowcount()
	ll_masterrow = this.id_master.rowcount()
	if ll_detailcount > 0 then
		if isnull(this.id_detail.getitemdecimal(1, "c_amt")) then
			ld_amttotal = ad_amt
		elseif isnull(this.id_detail.getitemdecimal(al_row, "amt")) then
			ld_amttotal = this.id_detail.getitemdecimal(1, "c_amt") + ad_amt
		else
			ld_amttotal = this.id_detail.getitemdecimal(1, "c_amt") - this.id_detail.getitemdecimal(al_row, "amt") + ad_amt
		end if
	else
		ld_amttotal = ad_amt
	end if
	if ll_masterrow > 0 then
		if ld_amttotal > this.id_master.object.amount[ll_masterrow] then
			lb_retval = false
		elseif ll_detailcount > 0 then
			if this.id_master.object.amount[ll_masterrow] - ld_amttotal >= 0 then
				this.id_master.object.unappliedamt[ll_masterrow] = this.id_master.object.amount[ll_masterrow] - ld_amttotal
				lb_retval = true
			else
				lb_retval = false
			end if
		else
			lb_retval = false
		end if
	else
		lb_retval = false
	end if
	return lb_retval

// w_notesform.wf_validateinvcode(long al_row, long al_invcode) returns integer
	integer li_rtcode
	long ll_invcode
	long ll_acccode
	long ll_notecode
	double ld_outstandingamt
	double ld_netamt
	double ld_oldamt
	datetime ld_date
	datetime ld_duedate
	datetime ld_today
	ll_acccode = this.id_master.object.acccode[this.id_master.rowcount()]
	if vf_dwdupcode1(this.id_detail, "invoicecode", string(al_invcode), al_row) = true then
		li_rtcode = 1
		messagebox("Invoice Validation", "Duplicate Invoice, please select some other invoice")
	else
		if this.ii_notetype = 1 then
			if this.ib_modify then
				SQL SELECT SaleLedger.SaleInvCode , SaleLedger.Date , SaleLedger.DueDate , Today =cast ( convert ( varchar ( 100 ) , getdate ( ) , 101 ) as datetime ) , SaleLedger.CustCode , SaleLedger.OutstandingAmt , SaleLedger.InvTotal INTO :ll_invcode, :ld_date, :ld_duedate, :ld_today, :ll_acccode, :ld_outstandingamt, :ld_netamt FROM SaleLedger WHERE SaleLedger.SaleInvCode =:al_invcode AND SaleLedger.CustCode =:ll_acccode AND SaleLedger.AccountFor ='Y' AND SaleLedger.Marked ='N' AND SaleLedger.Posted ='Y' AND SaleLedger.SaleCatCode IN ( 2 ) USING sqlca;
			else
				SQL SELECT SaleLedger.SaleInvCode , SaleLedger.Date , SaleLedger.DueDate , Today =cast ( convert ( varchar ( 100 ) , getdate ( ) , 101 ) as datetime ) , SaleLedger.CustCode , SaleLedger.OutstandingAmt , SaleLedger.InvTotal INTO :ll_invcode, :ld_date, :ld_duedate, :ld_today, :ll_acccode, :ld_outstandingamt, :ld_netamt FROM SaleLedger WHERE SaleLedger.SaleInvCode =:al_invcode AND SaleLedger.CustCode =:ll_acccode AND SaleLedger.AccountFor ='Y' AND SaleLedger.Marked ='N' AND SaleLedger.Posted ='Y' AND SaleLedger.OutstandingAmt > 0 AND SaleLedger.SaleCatCode IN ( 2 ) USING sqlca;
			end if
		elseif this.ib_modify then
			SQL SELECT PurLedger.PurInvCode , PurLedger.Date , DueDate =PurLedger.Date + ISNULL ( PurLedger.CreditDays , 0 ) , Today =cast ( convert ( varchar ( 100 ) , getdate ( ) , 101 ) as datetime ) , PurLedger.SuppCode , PurLedger.OutstandingAmt , PurLedger.InvTotal INTO :ll_invcode, :ld_date, :ld_duedate, :ld_today, :ll_acccode, :ld_outstandingamt, :ld_netamt FROM PurLedger WHERE PurLedger.PurInvCode =:al_invcode AND PurLedger.SuppCode =:ll_acccode AND PurLedger.AccountFor ='Y' AND PurLedger.Marked ='N' AND PurLedger.Posted ='Y' USING sqlca;
		else
			SQL SELECT PurLedger.PurInvCode , PurLedger.Date , DueDate =PurLedger.Date + ISNULL ( PurLedger.CreditDays , 0 ) , Today =cast ( convert ( varchar ( 100 ) , getdate ( ) , 101 ) as datetime ) , PurLedger.SuppCode , PurLedger.OutstandingAmt , PurLedger.InvTotal INTO :ll_invcode, :ld_date, :ld_duedate, :ld_today, :ll_acccode, :ld_outstandingamt, :ld_netamt FROM PurLedger WHERE PurLedger.PurInvCode =:al_invcode AND PurLedger.SuppCode =:ll_acccode AND PurLedger.AccountFor ='Y' AND PurLedger.Marked ='N' AND PurLedger.Posted ='Y' AND PurLedger.OutstandingAmt > 0 USING sqlca;
		end if
		if sqlca.sqlcode = 0 then
			if ll_invcode > 0 then
				this.id_detail.object.invoicecode[al_row] = ll_invcode
				this.id_detail.object.date[al_row] = ld_date
				this.id_detail.object.netamt[al_row] = ld_netamt
				if this.ib_fetchduedate then
					if ld_duedate >= ld_today then
						this.id_master.object.duedate[1] = ld_duedate
					end if
				end if
				if this.ib_modify then
					ll_notecode = this.id_master.object.code[this.id_master.rowcount()]
					li_rtcode = wf_getinvinfo(ll_notecode, ll_invcode, ld_oldamt)
					if li_rtcode = 0 then
						if ld_oldamt >= 0.0 then
							this.id_detail.object.outstandingamt[al_row] = ld_outstandingamt + ld_oldamt
						else
							li_rtcode = 1
						end if
					else
						li_rtcode = 1
					end if
				else
					this.id_detail.object.outstandingamt[al_row] = ld_outstandingamt
				end if
				if li_rtcode = 0 and this.id_detail.object.outstandingamt[al_row] <= 0 then
					li_rtcode = 1
				end if
				this.id_detail.object.amt[al_row] = ld_outstandingamt
			else
				li_rtcode = 1
			end if
		else
			li_rtcode = 1
		end if
	end if
	return li_rtcode

// w_notesform.wf_validateacccode(long al_row, long al_acccode) returns integer
	long ll_detailrows
	long ll_custcode
	integer li_rtcode
	integer li_result
	datetime ld_datetime
	boolean lb_rtflag
	string ls_errtext
	string ls_batch
	dwitemstatus lrs_status
	if not isnull(al_acccode) and al_acccode > 0 then
		this.im_menu.m_file.m_options.enabled = true
		ll_detailrows = this.id_detail.rowcount()
		if ll_detailrows > 0 then
			lrs_status = this.id_detail.getitemstatus(1, 0, primary!)
			if lrs_status <> new! and not isnull(this.id_detail.getitemnumber(1, "invoicecode")) then
				li_result = messagebox("Warning", "Rows in Detail Window will be Lost", exclamation!, okcancel!, 2)
				if li_result = 2 then
					li_rtcode = 2
				else
					this.id_detail.setredraw(false)
					this.id_detail.reset()
					this.id_detail.insertrow(0)
					this.id_detail.setfocus()
					this.id_detail.setredraw(true)
				end if
			end if
		end if
		if li_rtcode = 0 then
			li_rtcode = wf_setaccountinfo(al_acccode)
			if li_rtcode = 0 then
				this.ii_focusaccount = 1
			else
				li_rtcode = 1
			end if
		end if
	else
		li_rtcode = 1
	end if
	if li_rtcode <> 0 then
		this.ii_focusaccount = 2
	end if
	return li_rtcode

// w_notesform.wf_deleteallemptydetailrows() returns integer
	long ll_count
	long ll_deletecount
	long ll_code
	long ll_rowcount
	double ld_amt
	ll_deletecount = 0
	ll_rowcount = this.id_detail.rowcount()
	for ll_count = 1 to this.id_detail.rowcount()
		ll_code = this.id_detail.getitemnumber(ll_count, "invoicecode")
		ld_amt = this.id_detail.getitemdecimal(ll_count, "amt")
		if isnull(ll_code) or ld_amt = 0.0 or isnull(ld_amt) then
			ll_deletecount = ll_deletecount + 1
			this.id_detail.deleterow(ll_count)
		end if
	next
	for ll_count = 1 to this.id_detail.rowcount()
		ll_code = this.id_detail.getitemnumber(ll_count, "invoicecode")
		ld_amt = this.id_detail.getitemdecimal(ll_count, "amt")
		if isnull(ll_code) or ld_amt = 0.0 or isnull(ld_amt) then
			ll_deletecount = ll_deletecount + 1
			this.id_detail.deleterow(ll_count)
		end if
	next
	return ll_deletecount

// w_notesform.wf_deleteemptydetailrow() returns integer
	long ll_rowcount
	long ll_code
	double ld_amt
	integer li_rtcode
	ll_rowcount = this.id_detail.rowcount()
	ll_code = this.id_detail.getitemnumber(ll_rowcount, "invoicecode")
	ld_amt = this.id_detail.getitemdecimal(ll_rowcount, "amt")
	if ll_rowcount > 1 and (isnull(ll_code) or ld_amt = 0.0 or isnull(ld_amt)) then
		this.id_detail.deleterow(ll_rowcount)
		li_rtcode = 1
		setfocus()
	end if
	return li_rtcode

// w_notesform.wf_retrieveinvoicelist(long al_acccode, long al_code, string as_module) returns integer
	long ll_rtcode
	this.idc_invoices.settransobject(this.it_transobject)
	ll_rtcode = this.idc_invoices.retrieve(al_acccode, al_code, as_module)
	if ll_rtcode > 0 then
		if this.id_detail.rowcount() < 1 then
			this.id_detail.insertrow(0)
		end if
	else
		ll_rtcode = this.idc_invoices.retrieve(0, 0, as_module)
	end if
	return ll_rtcode

// w_notesform.wf_retrievelist() returns long
	long ll_rtcode
	if this.ib_showtransactioninlist then
		this.id_list.setfilter("posted='N'")
		ll_rtcode = this.id_list.retrieve()
		this.id_list.filter()
	else
		ll_rtcode = -1
	end if
	return ll_rtcode

// w_notesform.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_notesform.wf_populatedetail(long al_invid, datawindow ad_detail, string as_errortext, long al_errorrow) returns boolean
	long ll_detailrows
	long ll_errrowid
	long ll_usercode
	long ll_invcode
	long ll_counter
	long ll_masterrow
	long ll_row
	long ll_unpostedtrans
	double ld_amt
	double ld_balance
	double ld_newbalance
	double ld_totalamt
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	boolean lb_commitflag
	string ls_msg
	ls_msg = "000                                                                                                                                 "
	ll_detailrows = this.id_detail.rowcount()
	ll_counter = 1
	as_errortext = "    Some database problem ocuurs         "
	ll_masterrow = this.id_master.rowcount()
	if ll_detailrows > 0 then
		ld_totalamt = this.id_detail.getitemnumber(ll_detailrows, "c_amt")
	else
		ld_totalamt = 0
	end if
	do while ll_counter <= ll_detailrows and lb_commitflag
		ll_invcode = this.id_detail.getitemnumber(ll_counter, "invoicecode")
		ld_amt = this.id_detail.getitemdecimal(ll_counter, "amt")
		if wf_lockinvoice(ll_invcode) = 0 then
			if this.ii_notetype = 1 then
				ls_msg = "000                                                                                                                                 "
				this.it_transobject.checkunpostedsaleinvintransactions(ll_invcode, al_invid, this.is_module, ll_unpostedtrans, ls_msg)
				if ll_unpostedtrans > 0 then
					lb_commitflag = false
					as_errortext = "Unposted Transaction(s) Exist for this Invoice~r~n~r~n" + ls_msg
				else
					this.it_transobject.getsaleinvbalance(ll_invcode, ld_balance)
					if this.it_transobject.sqlcode = 0 then
						if ld_amt > 0.0 and ld_amt <= ld_balance and lb_commitflag then
							ll_row = ad_detail.insertrow(0)
							ad_detail.setitem(ll_row, "code", al_invid)
							ad_detail.setitem(ll_row, "invoicecode", ll_invcode)
							ad_detail.setitem(ll_row, "outstandingamt", ld_balance)
							ad_detail.setitem(ll_row, "amt", ld_amt)
							ld_newbalance = ld_balance - ld_amt
							this.it_transobject.updatesaleinvbalance(ll_invcode, ld_newbalance)
							if this.it_transobject.sqlcode <> 0 then
								lb_commitflag = false
								as_errortext = "Sale Invoice Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
							end if
						else
							lb_commitflag = false
							as_errortext = "Not Enough Balance On Sale Invoice."
						end if
					else
						lb_commitflag = false
						as_errortext = "Sale Invoice Balance Retrieval Error:~r~n" + this.it_transobject.sqlerrtext
					end if
				end if
			else
				ls_msg = "000                                                                                                                                 "
				this.it_transobject.checkunpostedpurinvintransactions(ll_invcode, al_invid, this.is_module, ll_unpostedtrans, ls_msg)
				if ll_unpostedtrans > 0 then
					lb_commitflag = false
					as_errortext = "Unposted Transaction(s) Exist for this Invoice~r~n~r~n" + ls_msg
				else
					this.it_transobject.getpurinvbalance(ll_invcode, ld_balance)
					if this.it_transobject.sqlcode = 0 then
						if ld_amt > 0.0 and ld_amt <= ld_balance and lb_commitflag then
							ll_row = ad_detail.insertrow(0)
							ad_detail.setitem(ll_row, "code", al_invid)
							ad_detail.setitem(ll_row, "invoicecode", ll_invcode)
							ad_detail.setitem(ll_row, "outstandingamt", ld_balance)
							ad_detail.setitem(ll_row, "amt", ld_amt)
							ld_newbalance = ld_balance - ld_amt
							this.it_transobject.updatepurinvbalance(ll_invcode, ld_newbalance)
							if this.it_transobject.sqlcode <> 0 then
								lb_commitflag = false
								as_errortext = "Purchase Invoice Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
							end if
						else
							lb_commitflag = false
							as_errortext = "Not Enough Balance On Purchase Invoice"
						end if
					else
						lb_commitflag = false
						as_errortext = "Purchase Invoice Balance Retrieval Error:~r~n" + this.it_transobject.sqlerrtext
					end if
				end if
			end if
		else
			lb_commitflag = false
			as_errortext = "Invoice Is Used by some other user"
		end if
		ll_counter = ll_counter + 1
	loop
	if lb_commitflag then
		SQL rollback USING sqlca;
		ul_rowcount = ad_detail.rowcount()
		sqlca.getmaxutn(ul_rowcount, ul_maxutn)
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
			messagebox("SAVING", " Error in generating Utn ")
			return false
		end if
		for ll_counter = 1 to ad_detail.rowcount()
			ad_detail.setitem(ll_counter, "NotesUtn", ul_maxutn)
			ul_maxutn = ul_maxutn + 1
		next
	else
		al_errorrow = ll_counter - 1
	end if
	return lb_commitflag

// w_notesform.wf_finalize() returns integer
	integer li_errcode
	long ll_usercode
	long ll_invcount
	long ll_counter
	boolean lb_flag
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_usercode = long(message.doubleparm)
	setfocus()
	if ll_usercode > 0 then
		open(w_arg_account_sinv_linv)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			li_errcode = wf_locknotes_for_finalize(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_invcount)
			if li_errcode = 0 then
				sqlca.finalizenotes(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_usercode, lstr_arginfo.l_code3, this.ii_notetype, lstr_arginfo.l_code4)
				if sqlca.sqlcode <> 0 then
					li_errcode = -1
				end if
			else
				li_errcode = -1
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_usercode > 0 then
		if li_errcode <> 0 then
			messagebox("Finalization Process Fails", "Some database request fails, Please try again")
		else
			messagebox("Finalization Process Successfull", "Total un finalized rows were " + string(ll_invcount) + "~n~rAll rows have been Finalized successfully")
		end if
	end if
	return li_errcode

// w_notesform.wf_locknotes_for_finalize(long al_sinvcode, long al_linvcode, long al_totalinvoice) returns long
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From Notes WITH ( UPDLOCK HOLDLOCK ) Where Notes.NoteCode Between :al_sinvcode AND :al_linvcode AND Notes.NoteCatCode =:this.ii_notetype AND Notes.Posted ='N' AND Finalized ='N' USING sqlca;
	return sqlca.sqlcode

// w_notesform.wf_selectprintreport() returns 0
	string ls_report
	if gs_company = "MARJ" then
		ls_report = "d_marj_notes_printout"
	end if
	if ls_report = "" or isnull(ls_report) then
		ls_report = "d_notes_printout"
	end if
	this.id_print.dataobject = ls_report

// w_notesform.wf_retrievelistall() returns long
	this.id_list.setfilter("")
	this.id_list.filter()
	return this.id_list.retrieve()

// w_notesform.wf_postwithdate() returns long
	integer li_errcode
	long ll_usercode
	long ll_code
	long ll_invcount
	boolean lb_flag
	s_arguements lstr_arginfo
	if this.tab_retrieve.selectedtab = 1 then
		return 0
	end if
	if this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
		ll_usercode = gl_usercode
		setfocus()
		if ll_usercode > 0 then
			open(w_arg_sdate)
			lstr_arginfo = message.powerobjectparm
			if lstr_arginfo.i_status = 1 then
				setpointer(hourglass!)
				SQL rollback USING sqlca;
				li_errcode = wf_locknotes(ll_code, ll_code, ll_invcount)
				if li_errcode = 0 then
					sqlca.postnote(ll_code, ll_usercode, this.ii_notetype, lstr_arginfo.d_sdate)
					if sqlca.sqlcode <> 0 then
						li_errcode = -1
					end if
				else
					li_errcode = -1
				end if
			end if
			if li_errcode = 0 then
				SQL commit USING sqlca;
				if sqlca.sqlcode <> 0 then
					li_errcode = -1
				end if
			else
				SQL rollback USING sqlca;
			end if
		else
			setfocus()
		end if
		setpointer(arrow!)
		if ll_usercode > 0 then
			if li_errcode <> 0 then
				messagebox("Posting Fails", "Some database request fails, Please try again")
			else
				messagebox("Posting Successfull", "Total unposted rows were " + string(ll_invcount) + "~n~rAll rows have been posted successfully")
			end if
		end if
	end if
	return li_errcode

// w_notesform.wf_printcheque() returns 0
	long ll_code
	if this.tab_retrieve.selectedtab = 2 then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_list.object.code[this.id_list.getrow()]
		if isnull(ll_code) or ll_code <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
		if f_stringpreferences("ChequePrintingInterface") = "C" then
			wf_invoke_crystalreport(ll_code)
		else
			openwithparm(w_printcheques, ll_code)
		end if
	end if

// w_notesform.wf_invoke_crystalreport(long al_code) returns 0
	w_crystal_report_viewer lw_sheet
	s_reportinfo ls_reportinfo
	ls_reportinfo.s_reporttitle = "Cheque Printing"
	ls_reportinfo.s_reportobject = "rptPrintCheque.rpt"
	ls_reportinfo.l_code = al_code
	opensheetwithparm(lw_sheet, ls_reportinfo, this, 0, layered!)

// w_notesform.wf_accountledger() returns 0
	long ll_acccode
	if this.id_master = getfocus() and this.id_master.rowcount() > 0 then
		if this.id_master.getcolumnname() = "acccode" then
			ll_acccode = this.id_master.getitemnumber(this.id_master.getrow(), "acccode")
		else
			ll_acccode = this.id_master.getitemnumber(this.id_master.getrow(), "bankacccode")
		end if
		if not isnull(ll_acccode) then
			openwithparm(w_account_ledger, ll_acccode)
		end if
	end if

// w_notesform.create() returns 0
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_notesmenu" then
		this.menuid = create m_notesmenu
	end if
	this.dw_print = create dw_print
	this.dw_invdetail = create dw_invdetail
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print
	this.control[icurrent + 2] = this.dw_invdetail

// w_notesform.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_print
	destroy this.dw_invdetail

// w_notesform.ue_save() returns 0
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_errrowid
	long ll_salesmancode
	long ll_counter
	long ll_count
	long ll_vouchercode
	long ll_null
	long ll_unpostedtrans
	boolean lb_commitflag
	boolean lb_continue
	integer li_counter
	integer li_maxretcode
	integer li_vouchretcode
	string ls_errtext
	string ls_msg
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	datetime ldt_server_datetime
	string ls_date_errtext
	ls_msg = "000                                                                                                                                 "
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		for ll_counter = 1 to ll_detailrows
			if isnull(this.id_detail.getitemnumber(ll_counter, "invoicecode")) or this.id_detail.getitemnumber(ll_counter, "invoicecode") = 0.0 then
				this.id_detail.deleterow(ll_counter)
			end if
		next
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	wf_deleteallemptydetailrows()
	if this.id_detail.rowcount() = 0 and this.ib_forceinvsettlement then
		messagebox("Invoice Settlement Problem", "Open Cheque without any Invoice Settlement in not allowed right now.~r~nCheck Preferences for this to allow.", stopsign!)
		return
	end if
	if this.id_master.object.amount[this.id_master.rowcount()] <= 0 then
		messagebox("Amount Validation", "Please enter a valid amount")
		this.id_master.setcolumn("amount")
		this.id_master.setfocus()
		return
	end if
	if this.id_master.object.unappliedamt[this.id_master.rowcount()] < 0 then
		messagebox("Un-Applied Amount Validation", "Un-Applied Amount should not be -ve.~r~nIt means Invoice Settlement is more than cheque amount.", stopsign!)
		return
	end if
	if this.id_detail.rowcount() < 0 then
		messagebox("Rows Validation", "Please insert a row before proceeding")
		return
	end if
	ll_detailrows = this.id_detail.rowcount()
	if this.id_detail.rowcount() > 0 and this.id_master.object.posted[1] = "N" and this.id_master.object.finalized[1] = "N" then
		for ll_counter = 1 to ll_detailrows
			ls_msg = "000                                                                                                                                 "
			if this.is_module = "NR" then
				this.it_transobject.checkunpostedsaleinvintransactions(this.id_detail.object.invoicecode[ll_counter], this.id_master.object.code[this.id_master.rowcount()], this.is_module, ll_unpostedtrans, ls_msg)
			else
				this.it_transobject.checkunpostedpurinvintransactions(this.id_detail.object.invoicecode[ll_counter], this.id_master.object.code[this.id_master.rowcount()], this.is_module, ll_unpostedtrans, ls_msg)
			end if
			if ll_unpostedtrans > 0 then
				this.id_detail.scrolltorow(ll_counter)
				this.id_detail.setfocus()
				if this.is_module = "NR" then
					messagebox("Sale Invoice Validation Problem", "Unposted Transaction(s) Exist for this Sale Invoice~r~n~r~n" + ls_msg)
				else
					messagebox("Purchase Invoice Validation Problem", "Unposted Transaction(s) Exist for this Purchase Invoice~r~n~r~n" + ls_msg)
				end if
				return
			end if
		next
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		ll_mastercurrrow = this.id_master.getrow()
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if isnull(ll_invid) then
			li_maxretcode = wf_tabnewid("notes", ll_invid)
			if li_maxretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~n ~t~t~t~t~t~t~t~t~t~t~t~t~tgenerating InvCode")
				return
			end if
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
		end if
		ll_vouchercode = this.id_master.getitemnumber(ll_mastercurrrow, "vouchercode")
		if isnull(ll_vouchercode) or ll_vouchercode = 0 then
			li_vouchretcode = wf_getnewvouchercode(this.ii_notetype, ll_vouchercode, this.it_transobject)
			if li_vouchretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~n ~t~t~t~t~t~t~t~t~t~t~t~t~tgenerating Voucher Code")
				return
			end if
			if ll_vouchercode > 0 then
				this.id_master.setitem(ll_mastercurrrow, "vouchercode", ll_vouchercode)
			end if
		end if
		if this.ib_modify then
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				SQL rollback USING this.it_transobject;
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "modified", "Y")
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			this.idt_server_datetime = ldt_server_datetime
			if lb_continue then
				lb_continue = wf_returnnote(ll_invid, ls_errtext)
			end if
		else
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				SQL rollback USING this.it_transobject;
				if this.ib_modify = false then
					setnull(ll_null)
					this.id_master.setitem(1, "Code", ll_null)
					this.id_master.setitem(1, "VoucherCode", ll_null)
					this.id_master.accepttext()
				end if
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.idt_server_datetime = ldt_server_datetime
			this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
		end if
		if lb_continue then
			this.id_notesdetail.reset()
			if not wf_populatedetail(ll_invid, this.id_notesdetail, ls_errtext, ll_errrowid) then
				lb_continue = false
				this.id_detail.scrolltorow(ll_errrowid)
				this.id_detail.setfocus()
			else
				this.id_detail = this.id_notesdetail
				call super::ue_save
				this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
				this.id_notesdetail.reset()
				if this.ib_commitok then
					this.ib_modify = false
				elseif this.ib_modify = false then
					setnull(ll_null)
					this.id_master.setitem(1, "Code", ll_null)
					this.id_master.setitem(1, "VoucherCode", ll_null)
					this.id_master.accepttext()
				end if
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			if this.ib_modify = false then
				setnull(ll_null)
				this.id_master.setitem(1, "Code", ll_null)
				this.id_master.setitem(1, "VoucherCode", ll_null)
				this.id_master.accepttext()
			end if
			messagebox("Updation Error", ls_errtext + " in current row", stopsign!)
		elseif f_stringpreferences("IncBRBPInActMonitor") = "Y" then
			this.it_transobject.updateactivitymonitor("NN", ll_invid)
			if this.it_transobject.sqlcode = 0 then
				SQL commit USING this.it_transobject;
			else
				SQL rollback USING this.it_transobject;
				messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_notesform.ue_newform() returns 0
	m_notesmenu lm_menu
	lm_menu = this.menuid
	this.im_menu.m_file.m_print.enabled = false
	lm_menu.m_file.m_finalize.visible = true
	lm_menu.m_file.m_finalize.enabled = false
	lm_menu.m_file.m_printcheques.visible = false
	lm_menu.m_file.m_printcheques.enabled = false
	wf_protectdw(this.id_master, 0)
	this.id_detail.setredraw(false)
	wf_protectdw(this.id_detail, 0)
	this.id_detail.setredraw(true)
	this.ib_modify = false
	this.id_master.setfocus()
	this.ii_focusaccount = 2
	setredraw(false)
	this.i_editmode = 1
	this.i_retrievemode = 2
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_new.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true
	this.im_menu.m_file.m_first.enabled = false
	this.im_menu.m_file.m_next.enabled = false
	this.im_menu.m_file.m_previous.enabled = false
	this.im_menu.m_file.m_last.enabled = false
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_retrieve.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.tab_retrieve.tabpage_detail.enabled = true
	if this.id_master.rowcount() > 0 then
		this.id_master.reset()
	end if
	this.ib_focusdetail = false
	this.id_master.insertrow(0)
	this.id_detail.reset()
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	setredraw(true)

// w_notesform.ue_detail() returns 0
	integer li_rtncode
	integer li_protect
	integer li_ismodifysaleprice
	integer li_ismodifyitemdiscperc
	integer li_ismodifyitemflatdisc
	integer li_modifysalestax
	long ll_row
	long ll_code
	long ll_counter
	long ll_admissioncode
	long ll_allowed
	long ll_custcode
	boolean lb_flag
	boolean lb_modify
	long ll_rowcount
	long ll_validinv
	double ld_code
	m_notesmenu lm_menu
	lm_menu = this.menuid
	ld_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.im_menu.m_file.m_print.enabled = true
	lm_menu.m_file.m_finalize.visible = true
	lm_menu.m_file.m_finalize.enabled = false
	lm_menu.m_file.m_printcheques.visible = false
	lm_menu.m_file.m_printcheques.enabled = false
	this.i_editmode = 2
	this.i_retrievemode = 2
	this.id_dwcontrol = this.id_master
	ll_rowcount = wf_retrieve(ld_code)
	this.id_master.setrow(1)
	this.id_master.scrolltorow(1)
	this.idc_invoices.settransobject(this.it_transobject)
	this.id_dwcontrol = this.id_detail
	if wf_detailrowcount(ld_code) > 0 then
		if this.idc_invoices.retrieve(this.id_master.object.acccode[1], this.id_master.object.code[1], this.is_module) <= 0 then
			this.idc_invoices.insertrow(0)
		end if
		wf_retrieve(ld_code)
	else
		this.idc_invoices.insertrow(0)
		wf_retrieve(ld_code)
	end if
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	this.id_dwcontrol = this.id_list
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	if this.id_master.object.posted[this.id_master.getrow()] = "N" then
		lb_modify = true
	end if
	if not lb_modify then
		this.im_menu.m_file.m_save.enabled = false
		this.editflag = false
	else
		li_protect = 0
		wf_initmodify(li_protect)
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	if this.id_master.object.posted[this.id_master.getrow()] = "N" and this.id_master.object.finalized[this.id_master.getrow()] = "Y" then
		li_protect = 1
		wf_protectdw(this.id_master, li_protect)
		wf_protectdw(this.id_detail, li_protect)
		this.id_master.object.remarks.protect = "0"
		this.id_master.object.bankacccode.protect = "0"
		this.im_menu.m_item.m_newitem.enabled = false
		this.im_menu.m_item.m_deleteitem.enabled = false
	end if
	if li_protect = 0 then
		lb_flag = true
	end if
	setredraw(true)

// w_notesform.ue_newitem() returns 0
	long ll_rowcount
	long ll_rtcode
	if this.id_detail.rowcount() = 0 then
		this.idc_invoices.settransobject(this.it_transobject)
		if this.id_master.object.acccode[this.id_master.rowcount()] > 0 then
			ll_rtcode = this.idc_invoices.retrieve(this.id_master.object.acccode[this.id_master.rowcount()], this.id_master.object.code[this.id_master.rowcount()], this.is_module)
			if ll_rtcode <= 0 then
				messagebox("Account Title Validation", "No Un-paid Invoice Exists for this Account Title")
				this.idc_invoices.retrieve(0, 0, this.is_module)
				return
			end if
		else
			messagebox("Account Title Validation", "No Un-paid Invoice Exists for this Account Title")
			this.idc_invoices.retrieve(0, 0, this.is_module)
			return
		end if
	elseif this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.setcolumn("invoicecode")
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_notesform.close() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	return ::message.returnvalue

// w_notesform.ue_list() returns 0
	long ll_row
	m_notesmenu lm_menu
	call super::ue_list
	lm_menu = this.menuid
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_post.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_save.enabled = false
	this.editflag = false
	lm_menu.m_file.m_finalize.visible = true
	lm_menu.m_file.m_finalize.enabled = true
	lm_menu.m_file.m_finalize.toolbaritemvisible = true
	lm_menu.m_file.m_printcheques.visible = true
	lm_menu.m_file.m_printcheques.enabled = true
	lm_menu.m_file.m_printcheques.toolbaritemvisible = true
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	ll_row = wf_retrievelist()
	wf_disabledetailtab(ll_row)

// w_notesform.ue_refreshddw() returns 0
	call super::ue_refreshddw
	setpointer(hourglass!)
	this.idc_account.retrieve()
	this.idc_bankaccount.retrieve()
	setpointer(arrow!)

// w_notesform.ue_new() returns 0
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_notesform.ue_postopen() returns 0
	integer li_rtncode
	integer i
	long ll_counter
	long ll_pos
	long ll_prow
	long ll_pcode
	long ll_found
	m_notesmenu lm_menu
	call super::ue_postopen
	lm_menu = this.menuid
	setredraw(false)
	this.ii_notetype = message.doubleparm
	this.id_print = this.dw_print
	if this.ii_notetype = 1 then
		this.is_module = "NR"
		this.title = "Post Dated Cheques-Receivables"
		wf_assigndatawindowobjects("d_notesheader", "d_notesdetail_customer", "", "d_noteslist", "")
		this.dw_invdetail.dataobject = "d_notesdetail"
	else
		this.is_module = "NP"
		this.title = "Post Dated Cheques-Payables"
		wf_assigndatawindowobjects("d_notesheader", "d_notesdetail_supplier", "", "d_noteslist_np", "")
		this.dw_invdetail.dataobject = "d_notesdetail_pur"
	end if
	this.id_notesdetail = this.dw_invdetail
	this.id_notesdetail.settransobject(this.it_transobject)
	this.id_master.setitem(1, "acccode", 0)
	li_rtncode = this.id_master.getchild("acccode", this.idc_account)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_account.settransobject(this.it_transobject)
	li_rtncode = this.idc_account.retrieve()
	li_rtncode = this.id_master.getchild("bankacccode", this.idc_bankaccount)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_bankaccount.settransobject(this.it_transobject)
	li_rtncode = this.idc_bankaccount.retrieve()
	li_rtncode = this.id_detail.getchild("invoicecode", this.idc_invoices)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_invoices.settransobject(this.it_transobject)
	li_rtncode = this.idc_invoices.retrieve(0, 0, this.is_module)
	this.idc_invoices.insertrow(0)
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 565", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_showtransactioninlist = true
	else
		this.ib_showtransactioninlist = false
	end if
	this.id_master.object.notecatcode.initial = trim(string(this.ii_notetype))
	if this.ii_notetype = 1 then
		if not f_rightexists(5240) then
			this.id_master.object.issuedate.protect = 1
			this.id_master.object.issuedate.background.color = this.backcolor
			this.id_master.settaborder("issuedate", 0)
		end if
	elseif not f_rightexists(5239) then
		this.id_master.object.issuedate.protect = 1
		this.id_master.object.issuedate.background.color = this.backcolor
		this.id_master.settaborder("issuedate", 0)
	end if
	if f_stringpreferences("AutoFetchChequeDueDate") = "Y" then
		this.ib_fetchduedate = true
	end if
	if f_stringpreferences("InsistOnInvoiceSettlement") = "Y" then
		this.ib_forceinvsettlement = true
	end if
	setredraw(true)

// w_notesform.ue_deleteitem() returns 0
	long ll_currow
	long ll_detailrows
	this.ib_itemvalidated = true
	this.id_detail.deleterow(0)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows < 0 then
		this.im_menu.m_file.m_save.enabled = false
	end if
	wf_grandtotal()

// w_notesform.ue_print() returns 0
	long ll_code
	long ll_counter
	long ll_rowcount
	integer li_option
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		li_option = messagebox("Save Changes", "Do you want to save voucher", information!, yesno!, 2)
		if li_option = 1 then
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_code) or ll_code <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_code = this.id_master.getitemnumber(1, "code")
	end if
	wf_selectprintreport()
	this.id_print.settransobject(this.it_transobject)
	ll_rowcount = this.id_print.retrieve(ll_code)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if ll_rowcount > 0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Voucher", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Voucher,~r~nNo rows are retrieved", information!)
