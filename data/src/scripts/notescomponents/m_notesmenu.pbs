// m_notesmenu.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_finalize = create m_finalize
	this.m_postwithdate = create m_postwithdate
	this.m_printcheques = create m_printcheques
	this.m_showaccountledger = create m_showaccountledger
	this.item[upperbound(this.item) + 1] = this.m_finalize
	this.item[upperbound(this.item) + 1] = this.m_postwithdate
	this.item[upperbound(this.item) + 1] = this.m_printcheques
	this.item[upperbound(this.item) + 1] = this.m_showaccountledger

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_finalize
	destroy this.m_postwithdate
	destroy this.m_printcheques
	destroy this.m_showaccountledger

// m_finalize.clicked() returns 0 [event]
