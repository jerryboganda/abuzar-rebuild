	string ls_updsaleprice
	string ls_saleitemdescription
	string ls_alternatecustomicode
	datetime ld_expiry
	integer li_errorcode
	string ls_errortext
	datetime ldt_datetime
	long ll_usercode
	long ll_headerno
	long ll_prodcode
	string ls_proderror
	boolean lb_prodflag
	integer li_round_qty
	dwitemstatus ldws_column
	datawindowchild ldc_godown
	u_production uo_prod
	datastore lds_recipedetail
	li_round_qty = f_get_colprecision("Qty")
	ldt_datetime = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
	if this.ib_modify then
		ll_usercode = this.id_master.getitemnumber(this.id_master.getrow(), "salesmancode")
	else
		ll_usercode = this.id_master.getitemnumber(this.id_master.getrow(), "salesmancode")
	end if
	ll_headerno = this.id_master.getitemnumber(this.id_master.getrow(), "headerno")
	ll_detailrows = this.id_detail.rowcount()
	this.id_holdsaledetail.reset()
	this.id_holdsaledetail.getchild("gcode", ldc_godown)
	ldc_godown.settransobject(this.it_transobject)
	ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	for li_counter = 1 to ll_detailrows
		ld_holdqty = 0
		ll_gcode = this.id_detail.object.gcode[li_counter]
		ll_icode = this.id_detail.object.icode[li_counter]
		ll_insertedrows = this.id_holdsaledetail.insertrow(0)
		this.id_holdsaledetail.object.fullcode[ll_insertedrows] = this.id_detail.object.fullcode[li_counter]
		this.id_holdsaledetail.object.alternatecustomicode[ll_insertedrows] = this.id_detail.object.alternatecustomicode[li_counter]
		this.id_holdsaledetail.object.itemname[ll_insertedrows] = this.id_detail.object.itemname[li_counter]
		this.id_holdsaledetail.object.currlistrow[ll_insertedrows] = this.id_detail.object.currlistrow[li_counter]
		this.id_holdsaledetail.object.stock[ll_insertedrows] = this.id_detail.object.stock[li_counter]
		this.id_holdsaledetail.object.qtysale[ll_insertedrows] = this.id_detail.object.qtysale[li_counter]
		this.id_holdsaledetail.object.bonus[ll_insertedrows] = this.id_detail.object.bonus[li_counter]
		this.id_holdsaledetail.object.totalstock[ll_insertedrows] = this.id_detail.object.totalstock[li_counter]
		this.id_holdsaledetail.object.purprice[ll_insertedrows] = this.id_detail.object.purprice[li_counter]
		this.id_holdsaledetail.object.recentpurprice[ll_insertedrows] = this.id_detail.object.recentpurprice[li_counter]
		this.id_holdsaledetail.object.avgprice[ll_insertedrows] = this.id_detail.object.avgprice[li_counter]
		this.id_holdsaledetail.object.itemtotalval[ll_insertedrows] = this.id_detail.object.itemtotalval[li_counter]
		this.id_holdsaledetail.object.assgcode[ll_insertedrows] = this.id_detail.object.assgcode[li_counter]
		this.id_holdsaledetail.object.updatesaleprice[ll_insertedrows] = this.id_detail.object.updatesaleprice[li_counter]
		this.id_holdsaledetail.object.code[ll_insertedrows] = this.id_detail.object.code[li_counter]
		this.id_holdsaledetail.object.icode[ll_insertedrows] = this.id_detail.object.icode[li_counter]
		this.id_holdsaledetail.object.gcode[ll_insertedrows] = this.id_detail.object.gcode[li_counter]
		this.id_holdsaledetail.object.itemflatdisc[ll_insertedrows] = this.id_detail.object.itemflatdisc[li_counter]
		this.id_holdsaledetail.object.cloneitemflatdisc[ll_insertedrows] = this.id_detail.object.cloneitemflatdisc[li_counter]
		this.id_holdsaledetail.object.id[ll_insertedrows] = this.id_detail.object.id[li_counter]
		this.id_holdsaledetail.object.packunits[ll_insertedrows] = this.id_detail.object.packunits[li_counter]
		this.id_holdsaledetail.object.saleprice[ll_insertedrows] = this.id_detail.object.saleprice[li_counter]
		this.id_holdsaledetail.object.retailprice[ll_insertedrows] = this.id_detail.object.retailprice[li_counter]
		this.id_holdsaledetail.object.rate[ll_insertedrows] = this.id_detail.object.rate[li_counter]
		this.id_holdsaledetail.object.salestax[ll_insertedrows] = this.id_detail.object.salestax[li_counter]
		this.id_holdsaledetail.object.due[ll_insertedrows] = this.id_detail.object.due[li_counter]
		this.id_holdsaledetail.object.satisfieddate[ll_insertedrows] = this.id_detail.object.satisfieddate[li_counter]
		this.id_holdsaledetail.object.dueqty[ll_insertedrows] = this.id_detail.object.dueqty[li_counter]
		this.id_holdsaledetail.object.packqty[ll_insertedrows] = this.id_detail.object.packqty[li_counter]
		this.id_holdsaledetail.object.saleitemdescription[ll_insertedrows] = this.id_detail.object.saleitemdescription[li_counter]
		this.id_holdsaledetail.object.discperc[ll_insertedrows] = this.id_detail.object.discperc[li_counter]
		this.id_holdsaledetail.object.clonediscperc[ll_insertedrows] = this.id_detail.object.clonediscperc[li_counter]
		this.id_holdsaledetail.object.itemcode[ll_insertedrows] = this.id_detail.object.itemcode[li_counter]
		this.id_holdsaledetail.object.packprice[ll_insertedrows] = this.id_detail.object.packprice[li_counter]
		this.id_holdsaledetail.object.taxflag[ll_insertedrows] = this.id_detail.object.taxflag[li_counter]
		this.id_holdsaledetail.object.unitsalestax[ll_insertedrows] = this.id_detail.object.unitsalestax[li_counter]
		this.id_holdsaledetail.object.alternatepurprice[ll_insertedrows] = this.id_detail.object.alternatepurprice[li_counter]
		this.id_holdsaledetail.object.gstperc[ll_insertedrows] = this.id_detail.object.gstperc[li_counter]
		this.id_holdsaledetail.object.commissionperc[ll_insertedrows] = this.id_detail.object.commissionperc[li_counter]
		this.id_holdsaledetail.object.commissionperunit[ll_insertedrows] = this.id_detail.object.commissionperunit[li_counter]
		this.id_holdsaledetail.object.saleorderrowid[ll_insertedrows] = this.id_detail.object.saleorderrowid[li_counter]
		this.id_holdsaledetail.object.bonusqty[ll_insertedrows] = this.id_detail.object.bonusqty[li_counter]
		this.id_holdsaledetail.object.looseqty[ll_insertedrows] = this.id_detail.object.looseqty[li_counter]
		this.id_holdsaledetail.object.itemtypecode[ll_insertedrows] = this.id_detail.object.itemtypecode[li_counter]
	next
	if this.ib_autoproduction = true then
		for li_counter = 1 to this.id_holdsaledetail.rowcount()
			ll_icode = this.id_holdsaledetail.object.icode[li_counter]
			if ll_icode > 0 then
				SQL SELECT Count ( ResultedItem ) INTO :ll_count FROM Recipe WHERE ResultedItem =:ll_icode USING this.it_transobject;
				if isnull(ll_count) then
					ll_count = 0
				end if
				if this.it_transobject.sqlcode = 0 and ll_count > 0 then
					goto L6968
				end if
				exit
			end if
		next
		if ll_count > 0 then
			lb_prodflag = false
			uo_prod = create u_production
			uo_prod.of_settransobject(this.it_transobject)
			if uo_prod.of_retrieve_recipe() >= 0 and ll_count > 0 then
				if uo_prod.of_insertrow_master(ldt_datetime, 1, 1, ll_usercode, this.id_master.object.code[this.id_master.getrow()]) > 0 then
					if uo_prod.of_insertrow_detail(this.id_holdsaledetail) > 0 then
						ll_prodcode = uo_prod.of_savechanges()
						if ll_prodcode > 0 then
							if uo_prod.of_finalize(ll_prodcode, ll_usercode, ls_proderror) <> 0 then
								messagebox("Production Status", "Unable to finalized production for this POS Invoice.~r~nPossible Reasons are:~r~n" + ls_proderror)
								lb_prodflag = false
							elseif uo_prod.of_post(ll_prodcode, ll_usercode, ll_headerno, ldt_datetime, ls_proderror) <> 0 then
								messagebox("Production Status", "Unable to generate production for this POS Invoice.~r~nPossible Reasons are:~r~n" + ls_proderror)
								lb_prodflag = false
							else
								lb_prodflag = true
							end if
						else
							messagebox("Production Status", "Unable to save changes in Production.")
							lb_prodflag = false
						end if
					else
						messagebox("Production Status", "Unable to save Production in detail table.")
						lb_prodflag = false
					end if
				else
					messagebox("Production Status", "Unable to save Production in header table.")
					lb_prodflag = false
				end if
			end if
			if lb_prodflag = false then
				destroy uo_prod
				return false
			end if
			return
		end if
		return
	end if
	this.ids_salesetsheader.reset()
	this.ids_salesetsdetail.reset()
	this.ids_salesetsorigdetail.reset()
	if this.ib_salesets = true then
		wf_grandtotal()
		ld_invtotal = this.id_footer.getitemnumber(1, "total")
		setredraw(false)
		this.id_detail.reset()
		lds_recipedetail = create datastore
		lds_recipedetail.dataobject = "d_sale_recipedetail"
		lds_recipedetail.settransobject(this.it_transobject)
		ll_rowgroup = 1
		for li_counter = 1 to this.id_holdsaledetail.rowcount()
			ll_icode = this.id_holdsaledetail.object.icode[li_counter]
			if this.id_holdsaledetail.object.itemtypecode[li_counter] = 2 then
				lds_recipedetail.reset()
				ll_setitems = lds_recipedetail.retrieve(ll_icode)
				if ll_setitems <= 0 then
					ll_insertedrows = lds_recipedetail.insertrow(0)
					lds_recipedetail.object.icode[ll_insertedrows] = ll_icode
					lds_recipedetail.object.qty[ll_insertedrows] = 1
					lds_recipedetail.object.price[ll_insertedrows] = this.id_holdsaledetail.object.saleprice[li_counter]
				end if
				ll_insertedrows = this.ids_salesetsheader.insertrow(0)
				wf_tabnewid("SaleSetsHeader", ll_setcode)
				this.ids_salesetsheader.object.setcode[ll_insertedrows] = ll_setcode
				this.ids_salesetsheader.object.saleinvcode[ll_insertedrows] = this.id_master.object.code[this.id_master.getrow()]
				this.ids_salesetsheader.object.seticode[ll_insertedrows] = ll_icode
				this.ids_salesetsheader.object.qty[ll_insertedrows] = this.id_holdsaledetail.object.looseqty[li_counter]
				this.ids_salesetsheader.object.saleprice[ll_insertedrows] = this.id_holdsaledetail.object.saleprice[li_counter]
				for ll_innercounter = 1 to lds_recipedetail.rowcount()
					ll_insertedrows = this.id_detail.insertrow(0)
					ll_icode = lds_recipedetail.object.icode[ll_innercounter]
					wf_inititeminfo(ll_icode, ll_insertedrows, li_errorcode, ls_errortext)
					this.id_detail.object.looseqty[ll_insertedrows] = round(lds_recipedetail.object.qty[ll_innercounter] * this.id_holdsaledetail.object.looseqty[li_counter], li_round_qty)
					this.id_detail.object.saleprice[ll_insertedrows] = lds_recipedetail.object.price[ll_innercounter]
					ll_insertedrows = this.ids_salesetsdetail.insertrow(0)
					this.ids_salesetsdetail.object.setcode[ll_insertedrows] = ll_setcode
					this.ids_salesetsdetail.object.icode[ll_insertedrows] = ll_icode
					this.ids_salesetsdetail.object.rowgroup[ll_insertedrows] = ll_rowgroup
					ll_insertedrows = this.ids_salesetsorigdetail.insertrow(0)
					this.ids_salesetsorigdetail.object.setcode[ll_insertedrows] = ll_setcode
					this.ids_salesetsorigdetail.object.icode[ll_insertedrows] = lds_recipedetail.object.icode[ll_innercounter]
					this.ids_salesetsorigdetail.object.qty[ll_insertedrows] = lds_recipedetail.object.qty[ll_innercounter]
					this.ids_salesetsorigdetail.object.saleprice[ll_insertedrows] = lds_recipedetail.object.price[ll_innercounter]
					ll_rowgroup = ll_rowgroup + 1
				next
			else
				ll_insertedrows = this.id_detail.insertrow(0)
				this.id_detail.object.fullcode[ll_insertedrows] = this.id_holdsaledetail.object.fullcode[li_counter]
				this.id_detail.object.alternatecustomicode[ll_insertedrows] = this.id_holdsaledetail.object.alternatecustomicode[li_counter]
				this.id_detail.object.itemname[ll_insertedrows] = this.id_holdsaledetail.object.itemname[li_counter]
				this.id_detail.object.currlistrow[ll_insertedrows] = this.id_holdsaledetail.object.currlistrow[li_counter]
				this.id_detail.object.stock[ll_insertedrows] = this.id_holdsaledetail.object.stock[li_counter]
				this.id_detail.object.qtysale[ll_insertedrows] = this.id_holdsaledetail.object.qtysale[li_counter]
				this.id_detail.object.bonus[ll_insertedrows] = this.id_holdsaledetail.object.bonus[li_counter]
				this.id_detail.object.totalstock[ll_insertedrows] = this.id_holdsaledetail.object.totalstock[li_counter]
				this.id_detail.object.purprice[ll_insertedrows] = this.id_holdsaledetail.object.purprice[li_counter]
				this.id_detail.object.recentpurprice[ll_insertedrows] = this.id_holdsaledetail.object.recentpurprice[li_counter]
				this.id_detail.object.avgprice[ll_insertedrows] = this.id_holdsaledetail.object.avgprice[li_counter]
				this.id_detail.object.itemtotalval[ll_insertedrows] = this.id_holdsaledetail.object.itemtotalval[li_counter]
				this.id_detail.object.assgcode[ll_insertedrows] = this.id_holdsaledetail.object.assgcode[li_counter]
				this.id_detail.object.updatesaleprice[ll_insertedrows] = this.id_holdsaledetail.object.updatesaleprice[li_counter]
				this.id_detail.object.code[ll_insertedrows] = this.id_holdsaledetail.object.code[li_counter]
				this.id_detail.object.icode[ll_insertedrows] = this.id_holdsaledetail.object.icode[li_counter]
				this.id_detail.object.gcode[ll_insertedrows] = this.id_holdsaledetail.object.gcode[li_counter]
				this.id_detail.object.itemflatdisc[ll_insertedrows] = this.id_holdsaledetail.object.itemflatdisc[li_counter]
				this.id_detail.object.cloneitemflatdisc[ll_insertedrows] = this.id_holdsaledetail.object.cloneitemflatdisc[li_counter]
				this.id_detail.object.id[ll_insertedrows] = this.id_holdsaledetail.object.id[li_counter]
				this.id_detail.object.packunits[ll_insertedrows] = this.id_holdsaledetail.object.packunits[li_counter]
				this.id_detail.object.saleprice[ll_insertedrows] = this.id_holdsaledetail.object.saleprice[li_counter]
				this.id_detail.object.rate[ll_insertedrows] = this.id_holdsaledetail.object.rate[li_counter]
				this.id_detail.object.salestax[ll_insertedrows] = this.id_holdsaledetail.object.salestax[li_counter]
				this.id_detail.object.due[ll_insertedrows] = this.id_holdsaledetail.object.due[li_counter]
				this.id_detail.object.satisfieddate[ll_insertedrows] = this.id_holdsaledetail.object.satisfieddate[li_counter]
				this.id_detail.object.dueqty[ll_insertedrows] = this.id_holdsaledetail.object.dueqty[li_counter]
				this.id_detail.object.packqty[ll_insertedrows] = this.id_holdsaledetail.object.packqty[li_counter]
				this.id_detail.object.saleitemdescription[ll_insertedrows] = this.id_holdsaledetail.object.saleitemdescription[li_counter]
				this.id_detail.object.discperc[ll_insertedrows] = this.id_holdsaledetail.object.discperc[li_counter]
				this.id_detail.object.clonediscperc[ll_insertedrows] = this.id_holdsaledetail.object.clonediscperc[li_counter]
				this.id_detail.object.itemcode[ll_insertedrows] = this.id_holdsaledetail.object.itemcode[li_counter]
				this.id_detail.object.packprice[ll_insertedrows] = this.id_holdsaledetail.object.packprice[li_counter]
				this.id_detail.object.taxflag[ll_insertedrows] = this.id_holdsaledetail.object.taxflag[li_counter]
				this.id_detail.object.unitsalestax[ll_insertedrows] = this.id_holdsaledetail.object.unitsalestax[li_counter]
				this.id_detail.object.alternatepurprice[ll_insertedrows] = this.id_holdsaledetail.object.alternatepurprice[li_counter]
				this.id_detail.object.gstperc[ll_insertedrows] = this.id_holdsaledetail.object.gstperc[li_counter]
				this.id_detail.object.saleorderrowid[ll_insertedrows] = this.id_holdsaledetail.object.saleorderrowid[li_counter]
				this.id_detail.object.bonusqty[ll_insertedrows] = this.id_holdsaledetail.object.bonusqty[li_counter]
				this.id_detail.object.looseqty[ll_insertedrows] = this.id_holdsaledetail.object.looseqty[li_counter]
				this.id_detail.object.itemtypecode[ll_insertedrows] = this.id_holdsaledetail.object.itemtypecode[li_counter]
				ll_rowgroup = ll_rowgroup + 1
			end if
		next
		wf_grandtotal()
		ld_newinvtotal = this.id_footer.getitemnumber(1, "total")
		if ld_newinvtotal - ld_invtotal > 0.0 then
			this.id_footer.object.flatdisc[1] = this.id_footer.object.flatdisc[1] + round(ld_newinvtotal - ld_invtotal, 2)
			this.id_master.object.flatdisc[1] = this.id_footer.object.flatdisc[1]
		elseif ld_newinvtotal - ld_invtotal < 0.0 then
			this.id_footer.object.misccharges[1] = this.id_footer.object.misccharges[1] + round(ld_invtotal - ld_newinvtotal, 2)
			this.id_master.object.misccharges[1] = this.id_footer.object.misccharges[1]
		end if
		wf_grandtotal()
		setredraw(true)
	else
		this.id_detail = this.id_holdsaledetail
	end if
	ll_insertedrows = 1
	li_counter = 1
	ll_itemsdetailrowcount = 0
	ls_updatesaleprice = f_stringpreferences("updatesaleprice")
	ll_detailrows = this.id_detail.rowcount()
	as_errortext = "    Some database problem ocuurs         "
	ll_rowgroup = 0
	do while li_counter <= ll_detailrows and lb_commitflag
		ll_rowgroup = ll_rowgroup + 1
		ll_gcode = this.id_detail.getitemnumber(li_counter, "gcode")
		ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
		ls_alternatecustomicode = this.id_detail.getitemstring(li_counter, "AlternateCustomICode")
		ld_salelooseqty = this.id_detail.getitemnumber(li_counter, "looseqty")
		ld_dueqty = this.id_detail.getitemnumber(li_counter, "dueqty")
		ll_packunits = this.id_detail.getitemnumber(li_counter, "packunits")
		ld_saleprice = this.id_detail.getitemnumber(li_counter, "saleprice")
		ld_packprice = this.id_detail.getitemnumber(li_counter, "packprice")
		ld_clonediscperc = this.id_detail.getitemnumber(li_counter, "clonediscperc")
		ld_discperc = this.id_detail.getitemnumber(li_counter, "discperc")
		ld_purprice = this.id_detail.getitemnumber(li_counter, "purprice")
		ld_rate = this.id_detail.getitemnumber(li_counter, "rate")
		ld_alternatepurprice = this.id_detail.getitemnumber(li_counter, "alternatepurprice")
		ld_itemflatdisc = this.id_detail.getitemnumber(li_counter, "itemflatdisc")
		ld_cloneitemflatdisc = this.id_detail.getitemnumber(li_counter, "cloneitemflatdisc")
		ll_saleorderrowid = this.id_detail.getitemnumber(li_counter, "saleorderrowid")
		ls_saleitemdescription = this.id_detail.getitemstring(li_counter, "saleitemdescription")
		ll_taxflag = this.id_detail.getitemnumber(li_counter, "taxflag")
		ld_unitsalestax = this.id_detail.getitemnumber(li_counter, "unitsalestax")
		ld_bonusqty = this.id_detail.getitemnumber(li_counter, "bonusqty")
		ld_gstperc = this.id_detail.getitemnumber(li_counter, "gstperc")
		ld_commissionperunit = this.id_detail.getitemnumber(li_counter, "commissionperunit")
		ld_commissionperc = this.id_detail.getitemnumber(li_counter, "commissionperc")
		ldws_column = this.id_detail.getitemstatus(li_counter, "saleprice", primary!)
		ls_updsaleprice = this.id_detail.getitemstring(li_counter, "updatesaleprice")
		ld_salelooseqty = ld_salelooseqty - ld_dueqty
		this.it_transobject.getitemavgpriceforsale(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			this.it_transobject.getitemstockall(ll_icode, ld_total_availablestock)
			if ld_salelooseqty + ld_bonusqty > 0.0 and lb_commitflag then
				if wf_selectitembatches(ll_gcode, ll_icode, ld_salelooseqty, ld_bonusqty, ad_saledetail, ll_insertedrows, as_errortext) = 0 then
					for li_innercounter = 1 to ll_insertedrows
						ll_row = ll_itemsdetailrowcount + li_innercounter
						ad_saledetail.setitem(ll_row, "code", al_invid)
						ad_saledetail.setitem(ll_row, "AlternateCustomICode", ls_alternatecustomicode)
						ad_saledetail.setitem(ll_row, "rowgroup", ll_rowgroup)
						ad_saledetail.setitem(ll_row, "packunits", ll_packunits)
						ad_saledetail.setitem(ll_row, "saleprice", ld_saleprice)
						ad_saledetail.setitem(ll_row, "packprice", ld_packprice)
						ad_saledetail.setitem(ll_row, "discperc", ld_discperc)
						ad_saledetail.setitem(ll_row, "clonediscperc", ld_clonediscperc)
						ad_saledetail.setitem(ll_row, "rate", ld_rate)
						if isnull(ld_avgprice) then
							ld_avgprice = 0
						end if
						if ld_avgprice = 0.0 then
							ad_saledetail.setitem(ll_row, "avgprice", ld_purprice)
						else
							ad_saledetail.setitem(ll_row, "avgprice", ld_avgprice)
						end if
						ld_totalstock = ad_saledetail.getitemnumber(ll_row, "totalstock")
						ad_saledetail.setitem(ll_row, "GodownBalanceStock", ld_totalstock - ld_salelooseqty - ld_bonusqty)
						ad_saledetail.setitem(ll_row, "alternatepurprice", ld_alternatepurprice)
						ad_saledetail.setitem(ll_row, "itemflatdisc", ld_itemflatdisc)
						ad_saledetail.setitem(ll_row, "cloneitemflatdisc", ld_cloneitemflatdisc)
						ad_saledetail.setitem(ll_row, "saleorderrowid", ll_saleorderrowid)
						ad_saledetail.setitem(ll_row, "saleitemdescription", ls_saleitemdescription)
						ad_saledetail.setitem(ll_row, "taxflag", ll_taxflag)
						ad_saledetail.setitem(ll_row, "unitsalestax", ld_unitsalestax)
						ad_saledetail.setitem(ll_row, "gstperc", ld_gstperc)
						ad_saledetail.setitem(ll_row, "commissionperunit", ld_commissionperunit)
						ad_saledetail.setitem(ll_row, "commissionperc", ld_commissionperc)
						ls_batch = ad_saledetail.getitemstring(ll_row, "batch")
						ld_expiry = ad_saledetail.getitemdatetime(ll_row, "expiry")
						ld_looseqty = ad_saledetail.getitemnumber(ll_row, "looseqty")
						ld_stock = ad_saledetail.getitemnumber(ll_row, "stock")
						ld_bonusqty = ad_saledetail.getitemnumber(ll_row, "bonusqty")
						ld_newstock = ld_stock - ld_looseqty - ld_bonusqty
						if not (lower(ls_batch) = "due" and ld_stock = 0.0) then
							if ld_newstock > 0.0 then
								this.it_transobject.saleupdateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock, ld_stock)
							else
								this.it_transobject.deleteitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
							end if
							if this.it_transobject.sqlcode <> 0 then
								lb_commitflag = false
								as_errortext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
							end if
						end if
						ld_total_availablestock = ld_total_availablestock - ld_looseqty - ld_bonusqty
						ad_saledetail.setitem(ll_row, "balancestock", ld_total_availablestock)
					next
					ll_itemsdetailrowcount = ll_itemsdetailrowcount + ll_insertedrows
				else
					this.id_detail.setitem(li_counter, "stock", ll_insertedrows)
					lb_commitflag = false
				end if
			end if
			if ld_dueqty > 0.0 and lb_commitflag then
				ll_itemsdetailrowcount = ll_itemsdetailrowcount + 1
				ad_saledetail.insertrow(0)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "gcode", ll_gcode)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "icode", ll_icode)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "AlternateCustomICode", ls_alternatecustomicode)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "rowgroup", ll_rowgroup)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "saleorderrowid", ll_saleorderrowid)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "batch", "Due")
				ad_saledetail.setitem(ll_itemsdetailrowcount, "expiry", relativedate(today(), 365))
				ad_saledetail.setitem(ll_itemsdetailrowcount, "stock", ld_stock)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "totalstock", 0.0000)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "looseqty", ld_dueqty)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "balancestock", ld_total_availablestock)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "godownbalancestock", ld_totalstock)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "due", "D")
				ad_saledetail.setitem(ll_itemsdetailrowcount, "code", al_invid)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "packunits", ll_packunits)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "saleprice", ld_saleprice)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "packprice", ld_packprice)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "discperc", ld_discperc)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "clonediscperc", ld_clonediscperc)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "rate", ld_rate)
				if isnull(ld_avgprice) then
					ld_avgprice = 0
				end if
				if ld_avgprice = 0.0 then
					ad_saledetail.setitem(ll_itemsdetailrowcount, "avgprice", ld_purprice)
				else
					ad_saledetail.setitem(ll_itemsdetailrowcount, "avgprice", ld_avgprice)
				end if
				ad_saledetail.setitem(ll_itemsdetailrowcount, "avgprice", ld_avgprice)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "alternatepurprice", ld_alternatepurprice)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "itemflatdisc", ld_itemflatdisc)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "cloneitemflatdisc", ld_cloneitemflatdisc)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "taxflag", ll_taxflag)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "unitsalestax", ld_unitsalestax)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "gstperc", ld_gstperc)
			end if
		else
			lb_commitflag = false
		end if
		li_counter = li_counter + 1
	loop
	if not lb_commitflag then
		al_errorrow = li_counter - 1
		messagebox("Database Error", as_errortext)
		return lb_commitflag
	end if
	SQL rollback USING sqlca;
	ul_rowcount = ad_saledetail.rowcount()
	sqlca.getmaxutn(ul_rowcount, ul_maxutn)
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
	else
		SQL rollback USING sqlca;
		messagebox("SAVING", " Error in generating Utn ")
		return false
	end if
	if this.it_transobject.sqlcode <> 0 then
		messagebox("SAVING", " Error in generating Utn ")
		lb_commitflag = false
	end if
	for li_counter = 1 to ad_saledetail.rowcount()
		ad_saledetail.setitem(li_counter, "SaleUtn", ul_maxutn)
		ul_maxutn = ul_maxutn + 1
	next
	return lb_commitflag

// w_postsale.wf_copyinvoice() returns integer
	datastore lds_saletemplatedetail
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrows
	integer li_retcode
	integer li_errcode
	integer li_looseqty
	integer li_counter
	integer ll_found
	integer ll_innercounter
	integer li_holdqty
	string ls_errortext
	boolean lb_isitemexists
	datawindowchild ldc_godown
	lds_saletemplatedetail = create datastore
	open(w_copysaleinvoicefrom)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		destroy lds_saletemplatedetail
		return -1
	end if
	if lstr_template.c_copyinvfrom = "T" then
		lds_saletemplatedetail.dataobject = "d_saletemplate_detail"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		this.id_detail.reset()
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "qty"))
		next
	elseif lstr_template.c_copyinvfrom = "I" then
		lds_saletemplatedetail.dataobject = this.id_detail.dataobject
		lds_saletemplatedetail.settransobject(this.it_transobject)
		li_retcode = lds_saletemplatedetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		this.id_detail.reset()
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "looseqty"))
		next
	elseif lstr_template.c_copyinvfrom = "P" then
		if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
			lds_saletemplatedetail.dataobject = "d_normalpurchasedetail"
		else
			lds_saletemplatedetail.dataobject = "d_loosepurchasedetail"
		end if
		lds_saletemplatedetail.settransobject(this.it_transobject)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_detailrows = lds_saletemplatedetail.rowcount()
		this.id_detail.reset()
		for li_counter = 1 to li_counter
			li_holdqty = 0
			ll_icode = lds_saletemplatedetail.object.icode[li_counter]
			ll_found = lds_saletemplatedetail.find("icode=" + string(ll_icode), 1, li_counter - 1)
			if ll_found > 0 then
				if ll_detailrows = 1 then
					lb_isitemexists = false
				elseif li_counter = 1 then
					lb_isitemexists = false
				else
					lb_isitemexists = true
				end if
			else
				lb_isitemexists = false
			end if
			if lb_isitemexists = false then
				if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
					li_holdqty = lds_saletemplatedetail.object.packqty[li_counter]
				else
					li_holdqty = lds_saletemplatedetail.object.looseqty[li_counter]
				end if
				if li_counter <> ll_detailrows then
					ll_found = lds_saletemplatedetail.find("icode=" + string(ll_icode), li_counter + 1, ll_detailrows)
					ll_innercounter = ll_found
					do while ll_found > 0 and ll_innercounter <= ll_detailrows
						if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
							li_holdqty = li_holdqty + lds_saletemplatedetail.object.packqty[ll_found]
						else
							li_holdqty = li_holdqty + lds_saletemplatedetail.object.looseqty[ll_found]
						end if
						ll_innercounter = ll_found + 1
						ll_found = lds_saletemplatedetail.find("icode=" + string(ll_icode), ll_innercounter, ll_detailrows)
					loop
				end if
				ll_insertedrows = this.id_detail.insertrow(0)
				wf_inititeminfo(lds_saletemplatedetail.getitemnumber(li_counter, "icode"), li_counter, li_errcode, ls_errortext)
				if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
					li_holdqty = li_holdqty * lds_saletemplatedetail.getitemnumber(li_counter, "packunits")
				end if
				this.id_detail.setitem(li_counter, "looseqty", li_holdqty)
			end if
		next
	end if
	destroy lds_saletemplatedetail
	return li_retcode

// w_postsale.wf_customerinfo(long al_custcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	string ls_aliasname
	integer li_messagecode
	long ll_currow
	long ll_retcode
	double ld_currbalance
	double ld_invdiscperc
	char lc_printbalance
	lc_printbalance = "Y"
	SQL SELECT customer.address1 , customer.city , customer.phone , customer.messagecode , accounts.aliasname , customer.printbalance , invdiscperc INTO :ls_address, :ls_city, :ls_phone, :li_messagecode, :ls_aliasname, :lc_printbalance, :ld_invdiscperc FROM customer , accounts WHERE customer.custcode =:al_custcode and customer.custcode =accounts.acccode and accounts.active ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_retcode = wf_setcustomerinfo(al_custcode)
		if ll_retcode = 0 then
			ll_currow = this.id_master.getrow()
			this.id_master.object.address[ll_currow] = ls_address
			this.id_master.object.aliasname[ll_currow] = ls_aliasname
			this.id_master.object.city[ll_currow] = ls_city
			this.id_master.object.phone[ll_currow] = ls_phone
			this.id_master.object.printbalance[ll_currow] = lc_printbalance
			if this.id_footer.rowcount() > 0 then
				this.id_footer.object.invdiscperc[1] = ld_invdiscperc
			end if
			if isnull(li_messagecode) then
				this.id_master.object.messagecode[ll_currow] = 1
			else
				this.id_master.object.messagecode[ll_currow] = li_messagecode
			end if
			wf_set_loyaltypoints(al_custcode)
		else
			return ll_retcode
		end if
		return
	end if
	return this.it_transobject.sqlcode

// w_postsale.wf_customermessagevalidation(long al_custcode, long al_messagecode) returns integer
	integer li_messagecode
	long ll_currrow
	SQL SELECT customer.messagecode INTO :li_messagecode FROM customer WHERE customer.custcode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currrow = this.id_master.getrow()
		if isnull(li_messagecode) then
			ll_currrow = 0
		else
			ll_currrow = 1
		end if
	end if
	return ll_currrow

// w_postsale.wf_deletesaleinvoice(long al_saleinvcode) returns integer
	SQL Delete saledetail Where saledetail.SaleInvCode =:al_saleinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_postsale.wf_post() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	integer[] li_saletype
	string ls_msgtext
	s_arguements lstr_arginfo
	li_saletype[1] = 2
	li_saletype[2] = 3
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		openwithparm(w_arg_cust_sinvcode_linvcode, this.ii_saletype)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING this.it_transobject;
			li_errcode = wf_locksaleinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_saleinvcount)
			if li_errcode = 0 then
				this.it_transobject.postpointofsaleledger(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode, lstr_arginfo.l_code3, 1, this.ic_impactinventory)
				if this.it_transobject.sqlcode <> 0 then
					li_errcode = this.it_transobject.sqlcode
					ls_msgtext = this.it_transobject.sqlerrtext
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				li_errcode = this.it_transobject.sqlcode
				ls_msgtext = this.it_transobject.sqlerrtext
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if li_errcode <> 0 then
		messagebox("Posting Fails", "Some database request fails, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode))
	else
		messagebox("Posting Successfull", "Total unposted rows were " + string(ll_saleinvcount) + "~n~rAll rows have been posted successfully")
	end if
	return li_errcode

// w_postsale.wf_allowsalemodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM SaleDetail WHERE SaleInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING this.it_transobject;
	return ll_disallowedcount

// w_postsale.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_postsale.wf_closelist() returns 0
	this.ib_itemslistopen = false
	this.id_itemslist.hide()

// w_postsale.wf_isinvoiceinuse(long al_invoiceno) returns boolean
	long ll_found
	SQL Select count ( *) INTO :ll_found From SaleLedger With ( ReadPast , RowLock , UpdLock ) Where SaleInvCode =:al_invoiceno AND Deleted ='N' AND ImpactInventory ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_found = 0 then
			return true
		else
			return false
		end if
		return
	end if
	return false

// w_postsale.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_postsale.wf_adjustitemqty() returns boolean
	s_saledetail ls_saledetail
	s_positem ls_positem
	long ll_icode
	long ll_gcode
	long ll_counter
	long ll_detailrows
	integer li_qty
	if this.id_detail.rowcount() <= 1 then
		return false
	end if
	if this.id_detail.accepttext() = -1 then
		return false
	end if
	wf_deleteemptydetailrow()
	ll_detailrows = this.id_detail.rowcount()
	for ll_counter = 1 to ll_detailrows
		if isnull(this.id_detail.getitemnumber(ll_counter, "icode")) then
			messagebox("Item Validation", "Item Validation error occur in row " + string(ll_counter))
			this.id_detail.scrolltorow(ll_counter)
			this.id_detail.setfocus()
			return false
		end if
	next
	ls_saledetail.dw_saledetail = this.id_detail
	openwithparm(w_pos_selectitem, ls_saledetail)
	ls_positem = message.powerobjectparm
	li_qty = ls_positem.i_qty
	ll_icode = ls_positem.l_icode
	ll_gcode = ls_positem.l_gcode
	ll_detailrows = this.id_detail.rowcount()
	if li_qty = 0 then
		setredraw(false)
		for ll_counter = 1 to this.id_detail.rowcount()
			if ll_counter <= 0 then
				exit
			end if
			if ll_icode = this.id_detail.getitemnumber(ll_counter, "icode") then
				this.id_detail.setrow(ll_counter)
				triggerevent("ue_deleteitem")
				ll_counter = ll_counter - 1
			end if
		next
		post event ue_newitem()
		setredraw(true)
	elseif li_qty > 0 then
		setredraw(false)
		for ll_counter = 1 to this.id_detail.rowcount()
			if ll_counter <= 0 then
				exit
			end if
			if ll_icode = this.id_detail.getitemnumber(ll_counter, "icode") then
				this.id_detail.setrow(ll_counter)
				triggerevent("ue_deleteitem")
				ll_counter = ll_counter - 1
			end if
		next
		setredraw(true)
		this.il_currrow = this.id_detail.insertrow(0)
		if this.il_currrow > 0 then
			this.id_detail.setrow(this.il_currrow)
			this.id_detail.setitem(this.il_currrow, "icode", ll_icode)
			if wf_validateitem(true) = -1 then
				return false
			end if
			this.id_detail.setitem(this.il_currrow, "looseqty", li_qty)
			post event ue_newitem()
		end if
	else
		post event ue_newitem()
	end if
	return true

// w_postsale.wf_show_sets() returns long
	long ll_icode
	ll_icode = this.id_detail.object.icode[this.id_detail.getrow()]
	if ll_icode > 0 then
		openwithparm(w_popup_show_sets, ll_icode)
	end if
	return 1

// w_postsale.wf_select_draft_printout(long al_invcode) returns long
	string ls_report
	string ls_filename
	long ll_row
	long ll_retcode
	if gs_company = "BESTBUY" then
		ls_report = "d_bestbuy_draftmode_print_usingtextfile"
	end if
	if ls_report <> "" then
		this.id_print.dataobject = ls_report
		this.id_print.settransobject(sqlca)
		this.id_print.retrieve(al_invcode)
		ls_filename = "invoice.txt"
		ll_row = wf_save_saleinv_as_text(ls_filename)
		if ll_row > 0 then
			ll_retcode = 1
			run("invoice.bat", minimized!)
		else
			ll_retcode = 0
		end if
	else
		ll_retcode = 0
	end if
	return ll_retcode

// w_postsale.wf_save_saleinv_as_text(string as_filename) returns long
	integer li_filehandle
	long ll_counter
	long ll_innercounter
	long ll_rowcount
	string ls_writetofile
	string ls_temp
	li_filehandle = fileopen(as_filename, linemode!, write!, lockwrite!, replace!)
	if li_filehandle > -1 then
		ll_rowcount = this.id_print.rowcount()
		if ll_rowcount > 0 then
			for ll_counter = 1 to 11
				ls_temp = "c_line" + trim(string(ll_counter))
				ls_writetofile = ""
				ls_writetofile = ls_writetofile + this.id_print.getitemstring(1, ls_temp)
				filewrite(li_filehandle, ls_writetofile)
			next
			ll_counter = 0
			for ll_counter = 1 to ll_rowcount
				ls_writetofile = ""
				ls_temp = "rowdetail"
				ls_writetofile = ls_writetofile + this.id_print.getitemstring(ll_counter, ls_temp)
				filewrite(li_filehandle, ls_writetofile)
			next
			for ll_counter = 1 to 16
				ls_writetofile = ""
				ls_temp = "footerrow" + trim(string(ll_counter))
				ls_writetofile = ls_writetofile + this.id_print.getitemstring(1, ls_temp)
				filewrite(li_filehandle, ls_writetofile)
			next
			for ll_counter = 1 to 10
				ls_writetofile = " "
				filewrite(li_filehandle, ls_writetofile)
			next
		end if
		fileclose(li_filehandle)
		return 1
	end if
	return 0

// w_postsale.wf_getassocsaleinvlisttotal(double ad_invamount) returns long
	long ll_counter
	long ll_saleinvcode
	double ld_invamount
	for ll_counter = 1 to this.id_assocsaleinvlist.rowcount()
		ll_saleinvcode = this.id_assocsaleinvlist.object.assocsaleinvcode[ll_counter]
		ld_invamount = this.it_transobject.getsaleinvtotal(ll_saleinvcode)
		ad_invamount = ad_invamount + ld_invamount
	next
	return 0

// w_postsale.wf_set_post_assocsaleinv() returns boolean
	long ll_saleinvcode
	long ll_custcode
	long ll_salecatcode
	long ll_assocsaleinvcode
	long ll_totalrows
	long ll_counter
	long ll_salesmancode
	if this.ib_assocsaleinvlist then
		ll_saleinvcode = this.id_master.object.code[1]
		ll_custcode = this.id_master.object.custcode[1]
		ll_salecatcode = this.id_master.object.salecatcode[1]
		ll_salesmancode = this.id_master.object.salesmancode[1]
		ll_totalrows = this.id_assocsaleinvlist.rowcount()
		for ll_counter = 1 to ll_totalrows
			ll_assocsaleinvcode = this.id_assocsaleinvlist.object.assocsaleinvcode[ll_counter]
			SQL update SaleLedger Set CustCode =:ll_custcode , salecatcode =:ll_salecatcode Where SaleInvCode =:ll_assocsaleinvcode And POSTED ='N' USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Associated SaleInv Updation Error", "Unable to update customer information in Associated SaleInvNo.: " + string(ll_assocsaleinvcode))
				return false
			else
				this.it_transobject.postsaleledger(ll_assocsaleinvcode, ll_assocsaleinvcode, ll_salecatcode, ll_salesmancode, ll_custcode, 0, "Y")
				if this.it_transobject.sqlcode <> 0 then
					messagebox("Associated SaleInv Posting Error", "Posting Error in Associated SaleInvNo.: " + string(ll_assocsaleinvcode) + "~r~nReasons are: " + this.it_transobject.sqlerrtext)
					return false
				end if
			end if
		next
		this.it_transobject.postsaleledger(ll_saleinvcode, ll_saleinvcode, ll_salecatcode, ll_salesmancode, ll_custcode, 0, "Y")
		if this.it_transobject.sqlcode <> 0 then
			messagebox("SaleInv Posting Error", "Posting Error in SaleInvNo.: " + string(ll_saleinvcode) + "~r~nReasons are: " + this.it_transobject.sqlerrtext)
			return false
		end if
		return
	end if
	return true

// w_postsale.wf_getsalesstockinfo(long al_saleinvcode, long al_gcode, long al_icode, double al_saleqty) returns integer
	SQL Select IsNull ( Sum ( saledetail.looseqty + saledetail.bonusqty ) , 0 ) INTO :al_saleqty from saledetail where saledetail.saleinvcode =:al_saleinvcode and saledetail.gcode =:al_gcode and saledetail.icode =:al_icode USING this.it_transobject;
	if isnull(al_saleqty) then
		al_saleqty = 0
	end if
	return this.it_transobject.sqlcode

// w_postsale.wf_selectitembatches(long al_gcode, long al_icode, double al_qty, double al_bonus, datawindow ad_itemsdetail, long al_rowscount, string al_errortext) returns integer
	datastore lds_itemstockinfo
	long ll_counter
	long ll_detailrowcount
	long ll_rowsreturn
	double ld_bonusqty
	integer li_errcode
	double ld_saleqty
	double ld_reqqty
	double ld_totalstock
	double ld_batchqty
	lds_itemstockinfo = create datastore
	lds_itemstockinfo.dataobject = "d_itemstockinfo_sales"
	lds_itemstockinfo.settransobject(this.it_transobject)
	ll_rowsreturn = lds_itemstockinfo.retrieve(al_gcode, al_icode)
	if ll_rowsreturn > 0 then
		ld_totalstock = lds_itemstockinfo.getitemnumber(1, "c_totalstock")
		if ld_totalstock >= al_qty + al_bonus then
			ld_reqqty = al_qty + al_bonus
			ll_detailrowcount = ad_itemsdetail.rowcount()
			ll_counter = 1
			do while ll_counter <= lds_itemstockinfo.rowcount() and ld_reqqty > 0.0
				ld_batchqty = lds_itemstockinfo.getitemnumber(ll_counter, "currqty")
				if ld_batchqty >= ld_reqqty then
					ld_saleqty = al_qty
					ld_bonusqty = al_bonus
				elseif ld_batchqty <= al_qty then
					ld_saleqty = ld_batchqty
					ld_bonusqty = 0
				else
					ld_saleqty = al_qty
					ld_bonusqty = ld_batchqty - al_qty
				end if
				al_qty = al_qty - ld_saleqty
				al_bonus = al_bonus - ld_bonusqty
				ld_reqqty = al_qty + al_bonus
				ad_itemsdetail.insertrow(0)
				ll_detailrowcount = ll_detailrowcount + 1
				ad_itemsdetail.setitem(ll_detailrowcount, "gcode", al_gcode)
				ad_itemsdetail.setitem(ll_detailrowcount, "icode", al_icode)
				ad_itemsdetail.setitem(ll_detailrowcount, "batch", lds_itemstockinfo.getitemstring(ll_counter, "batch"))
				ad_itemsdetail.setitem(ll_detailrowcount, "expiry", lds_itemstockinfo.getitemdatetime(ll_counter, "expiry"))
				ad_itemsdetail.setitem(ll_detailrowcount, "stock", ld_batchqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "totalstock", ld_totalstock)
				ad_itemsdetail.setitem(ll_detailrowcount, "looseqty", ld_saleqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "bonusqty", ld_bonusqty)
				ll_counter = ll_counter + 1
			loop
			al_rowscount = ll_counter - 1
		else
			ld_reqqty = al_qty
			ll_detailrowcount = ad_itemsdetail.rowcount()
			ll_counter = 1
			do while ll_counter <= lds_itemstockinfo.rowcount() and ld_reqqty > 0.0
				ld_batchqty = lds_itemstockinfo.getitemnumber(ll_counter, "currqty")
				if ld_batchqty >= ld_reqqty then
					ld_saleqty = al_qty
				elseif ld_batchqty <= al_qty then
					ld_saleqty = ld_batchqty
				else
					ld_saleqty = al_qty
				end if
				al_qty = al_qty - ld_saleqty
				ld_reqqty = al_qty
				ad_itemsdetail.insertrow(0)
				ll_detailrowcount = ll_detailrowcount + 1
				ad_itemsdetail.setitem(ll_detailrowcount, "gcode", al_gcode)
				ad_itemsdetail.setitem(ll_detailrowcount, "icode", al_icode)
				ad_itemsdetail.setitem(ll_detailrowcount, "batch", lds_itemstockinfo.getitemstring(ll_counter, "batch"))
				ad_itemsdetail.setitem(ll_detailrowcount, "expiry", lds_itemstockinfo.getitemdatetime(ll_counter, "expiry"))
				ad_itemsdetail.setitem(ll_detailrowcount, "stock", ld_batchqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "totalstock", ld_totalstock)
				ad_itemsdetail.setitem(ll_detailrowcount, "looseqty", ld_saleqty)
				ll_counter = ll_counter + 1
			loop
			al_rowscount = ll_counter - 1
			if ld_reqqty > 0.0 then
				ad_itemsdetail.insertrow(0)
				ll_detailrowcount = ll_detailrowcount + 1
				ad_itemsdetail.setitem(ll_detailrowcount, "gcode", al_gcode)
				ad_itemsdetail.setitem(ll_detailrowcount, "icode", al_icode)
				ad_itemsdetail.setitem(ll_detailrowcount, "batch", "Due")
				ad_itemsdetail.setitem(ll_detailrowcount, "expiry", relativedate(today(), 365))
				ad_itemsdetail.setitem(ll_detailrowcount, "stock", 0)
				ad_itemsdetail.setitem(ll_detailrowcount, "totalstock", 0)
				ad_itemsdetail.setitem(ll_detailrowcount, "looseqty", ld_reqqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "Due", "D")
				al_rowscount = ll_counter
			end if
		end if
	elseif ll_rowsreturn = 0 then
		ld_reqqty = al_qty
		ll_detailrowcount = ad_itemsdetail.rowcount()
		ad_itemsdetail.insertrow(0)
		ll_detailrowcount = ll_detailrowcount + 1
		ad_itemsdetail.setitem(ll_detailrowcount, "gcode", al_gcode)
		ad_itemsdetail.setitem(ll_detailrowcount, "icode", al_icode)
		ad_itemsdetail.setitem(ll_detailrowcount, "batch", "Due")
		ad_itemsdetail.setitem(ll_detailrowcount, "expiry", relativedate(today(), 365))
		ad_itemsdetail.setitem(ll_detailrowcount, "stock", 0)
		ad_itemsdetail.setitem(ll_detailrowcount, "totalstock", 0)
		ad_itemsdetail.setitem(ll_detailrowcount, "looseqty", ld_reqqty)
		ad_itemsdetail.setitem(ll_detailrowcount, "Due", "D")
		al_rowscount = 1
	else
		li_errcode = 1
		al_errortext = "Please try again some Database problem occur ~r~n while fetching stock information from database."
	end if
	destroy lds_itemstockinfo
	return li_errcode

// w_postsale.wf_checkdueright(long al_usercode) returns long
	integer li_option
	long ll_duerightfound
	long ll_counter
	long ll_currentrow
	long ll_rowfound
	long ll_icode
	long ll_dueonitem
	long ll_retcode
	long ll_totitemqty
	double ld_looseqty
	double ld_bonusqty
	double ld_stock
	boolean lb_found
	boolean lb_due_item_exist
	string ls_errtext
	long ll_detailrows
	long ll_found
	long ll_rowcount
	string ls_msgtitle
	string ls_itemname
	string ls_msgdetail
	datastore lds_itemdetail
	datawindowchild ldc_godown
	datastore lds_items
	s_datastore lstr_arg
	if f_stringpreferences("CheckDueRightOnPOS_Save") = "N" then
		ll_retcode = 1
		return ll_retcode
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		return 0
	end if
	setredraw(false)
	lds_itemdetail = create datastore
	lds_itemdetail.dataobject = this.id_detail.dataobject
	lds_itemdetail.settransobject(this.it_transobject)
	ll_retcode = lds_itemdetail.getchild("gcode", ldc_godown)
	if ll_retcode = -1 then
		messagebox("datawindow child", "can not get datawindow child for colum name= godown")
	end if
	ldc_godown.settransobject(this.it_transobject)
	ldc_godown.insertrow(0)
	for ll_counter = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		ll_found = lds_itemdetail.find("icode = " + string(ll_icode), 1, lds_itemdetail.rowcount())
		if ll_found > 0 and ll_found <= lds_itemdetail.rowcount() then
			lds_itemdetail.object.looseqty[ll_found] = lds_itemdetail.object.looseqty[ll_found] + this.id_detail.object.looseqty[ll_counter]
			lds_itemdetail.object.bonusqty[ll_found] = lds_itemdetail.object.bonusqty[ll_found] + this.id_detail.object.bonusqty[ll_counter]
		elseif lds_itemdetail.rowcount() = 0 then
			this.id_detail.rowscopy(ll_counter, ll_counter, primary!, lds_itemdetail, 1, primary!)
		else
			this.id_detail.rowscopy(ll_counter, ll_counter, primary!, lds_itemdetail, lds_itemdetail.rowcount(), primary!)
		end if
	next
	ll_detailrows = lds_itemdetail.rowcount()
	ll_counter = 0
	for ll_counter = 1 to ll_detailrows
		ll_icode = lds_itemdetail.object.icode[ll_counter]
		ls_itemname = lds_itemdetail.object.itemname[ll_counter]
		ld_looseqty = lds_itemdetail.object.looseqty[ll_counter]
		ld_bonusqty = lds_itemdetail.object.bonusqty[ll_counter]
		ld_stock = lds_itemdetail.object.stock[ll_counter]
		if ld_looseqty + ld_bonusqty - ld_stock > 0.0 and ll_icode >= 0 and not isnull(ll_icode) then
			lb_due_item_exist = true
			ll_rowfound = ll_counter
			exit
		end if
	next
	if lb_due_item_exist then
		SQL SELECT COUNT ( *) INTO :ll_duerightfound FROM DBO.GroupRights WHERE RightCode =635 AND GroupCode IN ( SELECT GroupCode FROM DBO.UserGroups WHERE UserCode =:al_usercode ) USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Due Rights Problem", "Problem in varification of due rights~rcontact system administrator for help", stopsign!)
			ll_retcode = 0
			return ll_retcode
		end if
	else
		ll_retcode = 1
		return ll_retcode
	end if
	if lb_due_item_exist and ll_duerightfound = 0 then
		li_option = messagebox("Due Rights Problem", "There are some due items in this invoice.~r~nYou donot have sufficient rights to sale such item(s).~r~nKindly either remove them or call administrator for your support~rDo you need list of such items?", question!, yesno!, 1)
		if li_option = 1 then
			lds_items = create datastore
			lds_items.dataobject = "d_item_dueitemlist"
			lds_items.settransobject(sqlca)
			for ll_counter = 1 to lds_itemdetail.rowcount()
				ld_looseqty = lds_itemdetail.getitemnumber(ll_counter, "looseqty")
				ld_bonusqty = lds_itemdetail.getitemnumber(ll_counter, "bonusqty")
				ld_stock = lds_itemdetail.getitemnumber(ll_counter, "stock")
				if ld_looseqty + ld_bonusqty - ld_stock > 0.0 then
					lb_found = true
					ll_currentrow = lds_items.insertrow(0)
					lds_items.setitem(ll_currentrow, "icode", lds_itemdetail.getitemnumber(ll_counter, "icode"))
					lds_items.setitem(ll_currentrow, "aliasname", lds_itemdetail.getitemstring(ll_counter, "fullcode"))
					lds_items.setitem(ll_currentrow, "itemname", lds_itemdetail.getitemstring(ll_counter, "itemname"))
					lds_items.setitem(ll_currentrow, "gcode", lds_itemdetail.getitemnumber(ll_counter, "gcode"))
					lds_items.setitem(ll_currentrow, "stock", lds_itemdetail.getitemnumber(ll_counter, "stock"))
					lds_items.setitem(ll_currentrow, "saleqty", lds_itemdetail.getitemnumber(ll_counter, "looseqty"))
					lds_items.setitem(ll_currentrow, "dueqty", ld_looseqty + ld_bonusqty - ld_stock)
				end if
			next
			if lb_found then
				lstr_arg.ds = lds_items
				openwithparm(w_due_itemlist, lstr_arg)
				lstr_arg = message.powerobjectparm
				if lstr_arg.i_closemode < 1 then
					ll_retcode = 0
					return ll_retcode
				end if
				return
			end if
		else
			ll_retcode = 0
		end if
	elseif lb_due_item_exist and ll_duerightfound > 0 then
		for ll_counter = 1 to lds_itemdetail.rowcount()
			ll_icode = lds_itemdetail.getitemnumber(ll_counter, "icode")
			ld_looseqty = lds_itemdetail.getitemnumber(ll_counter, "looseqty")
			ld_bonusqty = lds_itemdetail.getitemnumber(ll_counter, "bonusqty")
			ld_stock = lds_itemdetail.getitemnumber(ll_counter, "stock")
			if ld_looseqty + ld_bonusqty - ld_stock > 0.0 then
				ll_dueonitem = wf_is_itemdue_allowed(ll_icode, ls_errtext)
				if ll_dueonitem <= 0 then
					ll_found = this.id_detail.find(" icode = " + trim(string(ll_icode)), 1, this.id_detail.rowcount())
					if ll_found > 0 then
						messagebox("Item Due Validation", ls_errtext + "~r~nRow No.: " + string(ll_found) + "~r~nTotal Qty: " + string(ld_looseqty + ld_bonusqty) + "~r~nStock in Hand: " + string(ld_stock) + "~r~nDue Qty: " + string(ld_looseqty + ld_bonusqty - ld_stock), stopsign!)
						this.id_detail.setrow(ll_found)
						this.id_detail.setcolumn("looseqty")
						this.id_detail.setfocus()
						ll_retcode = 0
						return ll_retcode
					end if
				else
					ll_retcode = 1
				end if
			end if
		next
	end if
	return ll_retcode

// w_postsale.wf_set_itemtotal_formatmask() returns long
	string ls_modify
	string ls_format
	ls_format = trim(f_stringpreferences("FormatForAmtInSale"))
	ls_modify = "c_itemtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_detaildwtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_finalitemval.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_sumfinalitemval.Format='" + ls_format + "'  "
	this.id_detail.modify(ls_modify)
	return 0

// w_postsale.wf_apply_pricepolicy(integer ai_mode) returns long
	long ll_custcode
	long ll_masterrow
	long ll_detailrows
	long ll_found
	long ll_counter
	long ll_retcode
	long ll_rowcount
	long ll_icode
	long ll_manualprice_itemcount
	double ld_looseqty
	double ld_bonusqty
	double ld_policy_price
	double ld_price
	string ls_msgtitle
	string ls_itemname
	string ls_msgdetail
	string ls_finditem
	boolean lb_editsaleprice
	datastore lds_itemdetail
	datawindowchild ldc_godown
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_custcode = this.id_master.getitemnumber(ll_masterrow, "custcode")
	if ll_custcode = 0 or isnull(ll_custcode) then
		messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Items before applying Price Policy to this invoice", stopsign!)
		return 0
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 511", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editsaleprice = true
	else
		messagebox(ls_msgtitle, "Not enough rights to modify item sale price.~r~nPlease contact system administrator for help", stopsign!)
		return 0
	end if
	setredraw(false)
	lds_itemdetail = create datastore
	lds_itemdetail.dataobject = this.id_detail.dataobject
	lds_itemdetail.settransobject(this.it_transobject)
	ll_retcode = lds_itemdetail.getchild("gcode", ldc_godown)
	if ll_retcode = -1 then
		messagebox("datawindow child", "can not get datawindow child for colum name= godown")
	end if
	ldc_godown.settransobject(this.it_transobject)
	ldc_godown.insertrow(0)
	for ll_counter = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		ls_finditem = "icode = " + string(ll_icode)
		ll_found = lds_itemdetail.find(ls_finditem, 1, lds_itemdetail.rowcount())
		if ll_found > 0 and ll_found <= lds_itemdetail.rowcount() then
			lds_itemdetail.object.looseqty[ll_found] = lds_itemdetail.object.looseqty[ll_found] + this.id_detail.object.looseqty[ll_counter]
			lds_itemdetail.object.bonusqty[ll_found] = lds_itemdetail.object.bonusqty[ll_found] + this.id_detail.object.bonusqty[ll_counter]
		elseif lds_itemdetail.rowcount() = 0 then
			this.id_detail.rowscopy(ll_counter, ll_counter, primary!, lds_itemdetail, 1, primary!)
		else
			this.id_detail.rowscopy(ll_counter, ll_counter, primary!, lds_itemdetail, lds_itemdetail.rowcount(), primary!)
		end if
	next
	ll_detailrows = lds_itemdetail.rowcount()
	ll_counter = 0
	for ll_counter = 1 to ll_detailrows
		ll_icode = lds_itemdetail.object.icode[ll_counter]
		ls_itemname = lds_itemdetail.object.itemname[ll_counter]
		ld_looseqty = lds_itemdetail.object.looseqty[ll_counter]
		ld_price = lds_itemdetail.object.saleprice[ll_counter]
		if ld_looseqty > 0.0 and ll_icode >= 0 and not isnull(ll_icode) then
			ld_policy_price = 0
			this.it_transobject.getpricepolicybased_itemprice(gl_usercode, ll_icode, ld_looseqty, ld_policy_price)
			if this.it_transobject.sqlcode = 0 then
				if isnull(ld_policy_price) then
					lds_itemdetail.object.pricepolicyapplied[ll_counter] = 0
				else
					lds_itemdetail.object.saleprice[ll_counter] = round(ld_policy_price, 2)
					lds_itemdetail.object.pricepolicyapplied[ll_counter] = 1
				end if
			else
				ls_msgdetail = "Some Problem Occured while fetching item Price policy details~r~n" + this.it_transobject.sqlerrtext
				messagebox(ls_msgtitle, ls_msgdetail, stopsign!)
				return 0
			end if
			return
		end if
	next
	ll_detailrows = this.id_detail.rowcount()
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ld_looseqty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		ld_price = this.id_detail.getitemnumber(ll_rowcount, "saleprice")
		if ld_looseqty > 0.0 and ll_icode >= 0 and not isnull(ll_icode) and this.id_detail.object.taxflag[ll_rowcount] = 0 then
			ls_finditem = "icode = " + string(ll_icode) + " and pricepolicyapplied = 1 "
			ll_found = lds_itemdetail.find(ls_finditem, 1, lds_itemdetail.rowcount())
			if ll_found > 0 and ll_found <= lds_itemdetail.rowcount() then
				this.id_detail.object.saleprice[ll_rowcount] = lds_itemdetail.object.saleprice[ll_found]
				this.id_detail.object.taxflag[ll_rowcount] = 0
			else
				ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname
				ll_manualprice_itemcount = ll_manualprice_itemcount + 1
			end if
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_manualprice_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Price Policy exists for Following " + trim(string(ll_manualprice_itemcount)) + " item(s)~r~nTheir Pricing should be set by user manually~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_postsale.wf_apply_bonuspolicy(integer ai_mode) returns long
	long ll_custcode
	long ll_masterrow
	long ll_detailrows
	long ll_found
	long ll_rowcount
	long ll_icode
	long ll_newbonusqty
	long ll_manualbonus_itemcount
	double ld_looseqty
	double ld_bonusqty
	string ls_msgtitle
	string ls_itemname
	string ls_msgdetail
	boolean lb_editbonusqty
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_custcode = this.id_master.getitemnumber(ll_masterrow, "custcode")
	if ll_custcode = 0 or isnull(ll_custcode) then
		messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Items before applying Bonus Policy to this invoice", stopsign!)
		return 0
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 596", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editbonusqty = true
	else
		messagebox(ls_msgtitle, "Not enough rights to modify bonus qty.~r~nPlease contact system administrator for help", stopsign!)
		return 0
	end if
	setredraw(false)
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ld_looseqty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		ld_bonusqty = this.id_detail.getitemnumber(ll_rowcount, "bonusqty")
		if ld_looseqty > 0.0 and ll_icode >= 0 and not isnull(ll_icode) then
			ll_newbonusqty = 0
			this.it_transobject.getbonuspolicybased_itembonusqty(ll_icode, ld_looseqty, ll_newbonusqty)
			if this.it_transobject.sqlcode = 0 then
				if isnull(ll_newbonusqty) then
					ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname
					ll_manualbonus_itemcount = ll_manualbonus_itemcount + 1
				else
					this.id_detail.setitem(ll_rowcount, "bonusqty", ll_newbonusqty)
					this.id_detail.object.taxflag[ll_rowcount] = 0
				end if
			else
				ls_msgdetail = "Some Problem Occured while fetching item bonus policy details~r~n" + this.it_transobject.sqlerrtext
				messagebox(ls_msgtitle, ls_msgdetail, stopsign!)
				return 0
			end if
			return
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_manualbonus_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Bonus Policy exists for Following " + trim(string(ll_manualbonus_itemcount)) + " item(s)~r~nTheir Bonus should be set by user manually~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_postsale.wf_apply_discountpolicy(integer ai_mode) returns long
	long ll_custcode
	long ll_masterrow
	long ll_detailrows
	long ll_found
	long ll_rowcount
	long ll_icode
	long ll_manualdiscount_itemcount
	double ld_looseqty
	double ld_policy_discperc
	double ld_discperc
	double ld_policy_itemflatdisc
	double ld_itemflatdisc
	string ls_msgtitle
	string ls_itemname
	string ls_msgdetail
	boolean lb_editsalediscperc
	boolean lb_edititemflatdisc
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_custcode = this.id_master.getitemnumber(ll_masterrow, "custcode")
	if ll_custcode = 0 or isnull(ll_custcode) then
		messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Items before applying Discount Policy to this invoice", stopsign!)
		return 0
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 516", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editsalediscperc = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 517", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_edititemflatdisc = true
	end if
	if lb_editsalediscperc = false and lb_edititemflatdisc = false then
		messagebox(ls_msgtitle, "Not enough rights to modify item sale disc (%) or item flat discount.~r~nPlease contact system administrator for help", stopsign!)
		return 0
	end if
	setredraw(false)
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ld_looseqty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		ld_discperc = this.id_detail.getitemnumber(ll_rowcount, "DiscPerc")
		ld_itemflatdisc = this.id_detail.getitemnumber(ll_rowcount, "itemflatdisc")
		if ld_looseqty > 0.0 and ll_icode >= 0 and not isnull(ll_icode) and this.id_detail.object.taxflag[ll_rowcount] = 0 then
			ld_policy_discperc = 0
			ld_policy_itemflatdisc = 0
			this.it_transobject.getdiscountpolicybased_itemdiscount(ll_icode, ld_looseqty, ld_policy_discperc, ld_policy_itemflatdisc)
			if this.it_transobject.sqlcode = 0 then
				if isnull(ld_policy_discperc) or isnull(ld_policy_itemflatdisc) then
					ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname
					ll_manualdiscount_itemcount = ll_manualdiscount_itemcount + 1
				else
					if lb_editsalediscperc then
						this.id_detail.setitem(ll_rowcount, "DiscPerc", ld_policy_discperc)
						this.id_detail.object.taxflag[ll_rowcount] = 0
					end if
					if lb_edititemflatdisc then
						this.id_detail.setitem(ll_rowcount, "ItemFlatDisc", ld_policy_itemflatdisc)
						this.id_detail.object.taxflag[ll_rowcount] = 0
					end if
				end if
			else
				ls_msgdetail = "Some Problem Occured while fetching item Discount policy details~r~n" + this.it_transobject.sqlerrtext
				messagebox(ls_msgtitle, ls_msgdetail, stopsign!)
				return 0
			end if
			return
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_manualdiscount_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Discount Policy Exists for Following " + trim(string(ll_manualdiscount_itemcount)) + " item(s)~r~nTheir Discount should be set by user manually~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_postsale.wf_getpendingdueinfo() returns long
	s_itemsalehistory ls_itemsalehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itemsalehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itemsalehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_pendingdueinfo, ls_itemsalehistory)
	end if
	return 0

// w_postsale.wf_print_storesummary(long al_invcode) returns long
	long ll_retcode
	string ls_report
	datastore lds_storesummary
	if f_stringpreferences("printstoresummwithpossinv") = "N" then
		return 0
	end if
	lds_storesummary = create datastore
	if gs_company = "ALHAQCORP" then
		ls_report = "d_storekeepersummary_withsales"
	elseif gs_company = "RSHOP" then
		ls_report = "d_storekeepersum_withsale_shahzadplywood"
	elseif gs_company = "ANGELSHINE" then
		ls_report = "d_angelshine_storekeepersummery_print"
	elseif gs_company = "NAVEEDYOUSAF" then
		ls_report = "d_nyg_storekeepersummery_print"
	elseif gs_company = "TOUHEED" then
		ls_report = "d_gar_storekeepersummery_print"
	else
		ls_report = "d_storekeepersummary_withsales"
	end if
	lds_storesummary.dataobject = ls_report
	lds_storesummary.settransobject(this.it_transobject)
	ll_retcode = lds_storesummary.retrieve(al_invcode, this.il_groupcode)
	if ll_retcode > 0 then
		lds_storesummary.print()
	end if
	return 0

// w_postsale.wf_assign_master_cash_win_object() returns 0
	this.ids_cashwin = create u_ds_standard
	this.ids_cashwin.dataobject = "d_cashierwindow_detail"
	this.ids_cashwin.settransobject(this.it_transobject)

// w_postsale.wf_setoutstandingamount() returns long
	double ld_invtotal
	double ld_amt
	double ld_outstandingamt
	double ld_balance
	double ld_cashcharged
	double ld_amtrecvd
	long ll_masterrow
	long ll_footerrow
	ll_masterrow = this.id_master.rowcount()
	ll_footerrow = this.id_footer.rowcount()
	wf_grandtotal()
	ld_invtotal = this.id_footer.getitemnumber(ll_footerrow, "total")
	ld_amt = 0
	ld_balance = ld_invtotal - ld_amt
	if ld_balance > 0.0 then
		ld_outstandingamt = ld_balance
	else
		ld_outstandingamt = 0.00
	end if
	ld_cashcharged = this.id_master.object.cashcharged[ll_masterrow]
	if ld_outstandingamt - ld_cashcharged <= 0.0 then
		ld_outstandingamt = 0.00
	else
		ld_outstandingamt = ld_outstandingamt - ld_cashcharged
	end if
	ld_amtrecvd = 0
	if this.ids_cashwin.rowcount() > 0 then
		ld_amtrecvd = this.ids_cashwin.getitemnumber(1, "c_totalamt")
		if ld_outstandingamt - ld_amtrecvd <= 0.0 then
			ld_outstandingamt = 0.00
		else
			ld_outstandingamt = ld_outstandingamt - ld_amtrecvd
		end if
	end if
	this.id_master.setitem(ll_masterrow, "outstandingamt", ld_outstandingamt)
	return 0

// w_postsale.wf_update_cashierwindow(long al_invcode) returns long
	long ll_counter
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		this.ids_cashwin.object.saleinvcode[ll_counter] = al_invcode
	next
	SQL DELETE DBO.CashierWindow WHERE SaleInvCode =:al_invcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if this.ids_cashwin.update() > 0 then
			return 0
		else
			return -1
		end if
		return
	end if
	return -1

// w_postsale.wf_set_cashaccount() returns long
	long ll_cashacccode
	long ll_module
	long ll_code
	ll_module = 35
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = f_is_group_module_cashaccount_allowed(this.il_groupcode, ll_module)
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		ll_cashacccode = 0
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
	elseif isnull(ll_code) or this.id_master.object.code[1] <= 0 then
		this.id_master.object.cashacccode[this.id_master.rowcount()] = ll_cashacccode
	else
		ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	end if
	return ll_cashacccode

// w_postsale.wf_show_salereturninsale_form() returns 0
	long ll_custcode
	long ll_null
	if wf_iseditable() = false then
		return
	end if
	setnull(ll_null)
	if this.id_master.accepttext() < 0 then
		return
	end if
	if this.id_master.rowcount() > 0 then
		ll_custcode = this.id_master.object.custcode[1]
		if isnull(ll_custcode) or ll_custcode = 0 then
			ll_custcode = 19
		end if
		this.istr_buffer.i_status = 1
		this.istr_buffer.l_code1 = this.id_master.object.srbufferinvcode[this.id_master.getrow()]
		this.istr_buffer.l_code2 = ll_null
		this.istr_buffer.l_code3 = ll_custcode
		this.istr_buffer.l_code4 = 0
		this.istr_buffer.l_code5 = ll_null
		if this.ii_saletype = 3 then
			if f_stringpreferences("retailsaleposting") = "Y" then
				this.istr_buffer.s_name1 = "Y"
			else
				this.istr_buffer.s_name1 = "N"
			end if
		elseif f_stringpreferences("creditsaleposting") = "Y" then
			this.istr_buffer.s_name1 = "Y"
		else
			this.istr_buffer.s_name1 = "N"
		end if
		openwithparm(w_salereturnbuffer_popup, this, this)
	end if

// w_postsale.wf_set_salereturn_amount() returns long
	long ll_retinvcode
	long ll_saleinvcode
	double ld_returnamt
	if this.id_master.rowcount() > 0 then
		ll_retinvcode = this.id_master.object.srbufferinvcode[1]
		if ll_retinvcode > 0 then
			SQL SELECT RetAmt =ISNULL ( DBO.fn_GetSRBufferInvTotal ( T.SRBufferInvCode ) , 0 ) , T.Saleinvcode INTO :ld_returnamt, :ll_saleinvcode FROM SRBufferLedger T WHERE T.SRBufferInvCode =:ll_retinvcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ld_returnamt < 0.0 then
					ld_returnamt = 0.00
				end if
			else
				ld_returnamt = 0.00
			end if
		end if
		this.id_footer.object.salereturnamt[1] = ld_returnamt
	end if
	return 0

// w_postsale.wf_retrievelist_datelimit() returns long
	string[] ls_posted
	string ls_showrows
	integer[] li_salecategory
	integer li_invforlastdays
	long ll_counter
	datetime ld_invdate
	boolean lb_netamount
	s_arguements lstr_arg
	ls_showrows = "N"
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	li_salecategory[1] = 1
	li_salecategory[2] = 2
	li_salecategory[3] = 3
	open(w_arg_sdate)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		ld_invdate = lstr_arg.d_sdate
	else
		return 0
	end if
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 538 then
			ls_showrows = "Y"
		end if
	next
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, ls_showrows, this.il_groupcode, this.ii_module)

// w_postsale.wf_save_salereturnascredit(long al_srbufferinvcode, long al_custcode) returns boolean
	long ll_retcode
	string ls_posted
	boolean lb_retflag
	if al_srbufferinvcode > 0 and al_custcode > 19 then
		SQL rollback USING this.it_transobject;
		this.it_transobject.change_salereturn(al_srbufferinvcode, al_custcode)
		SQL commit USING this.it_transobject;
	end if
	return lb_retflag

// w_postsale.wf_edit_saleorder() returns integer
	datastore lds_saleorderdetail
	datastore lds_saleorderheader
	s_saletemplate lstr_template
	boolean lb_enablesave
	boolean lb_insertrow
	integer li_retcode
	integer li_errcode
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_counter
	long ll_tmprowid
	long ll_tmpcode
	long ll_icode
	double ld_tmpqty
	double ld_tmpbonus
	string ls_errortext
	if wf_iseditable() = false then
		return 0
	end if
	lds_saleorderdetail = create datastore
	lds_saleorderheader = create datastore
	open(w_editsaleorder_finalized_form)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_saleorderdetail.dataobject = "d_SaleOrderdetail_retrieve"
		lds_saleorderdetail.settransobject(this.it_transobject)
		lds_saleorderheader.dataobject = "d_SaleOrderheader"
		lds_saleorderheader.settransobject(this.it_transobject)
		ll_row = lds_saleorderheader.retrieve(lstr_template.l_invtemplate)
		if ll_row <= 0 then
			li_retcode = -1
		else
			ll_mrow = this.id_master.getrow()
			this.id_master.setitem(ll_mrow, "SaleOrdercode", lstr_template.l_invtemplate)
			if this.ii_saletype = 2 then
				this.id_master.setitem(ll_mrow, "custcode", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "custcode"))
			end if
			this.id_master.setitem(ll_mrow, "sprice", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "sprice"))
			this.id_master.setitem(ll_mrow, "remarks", lds_saleorderheader.getitemstring(lds_saleorderheader.getrow(), "remarks"))
			this.id_master.setitem(ll_mrow, "headerno", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "headerno"))
			this.id_footer.setitem(ll_mrow, "misccharges", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "misccharges"))
			this.id_footer.setitem(ll_mrow, "flatdisc", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "flatdisc"))
			this.id_footer.setitem(ll_mrow, "invdiscperc", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "discperc"))
			this.id_master.setitem(ll_mrow, "smancode", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "smancode"))
			lds_saleorderdetail.retrieve(lstr_template.l_invtemplate, lstr_template.i_invtype)
		end if
		ll_totalrows = lds_saleorderdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		if lb_enablesave then
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
			this.id_detail.reset()
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				lb_insertrow = false
				ld_tmpqty = 0
				ld_tmpbonus = 0
				if lstr_template.i_invtype = 0 then
					lb_insertrow = true
				else
					if this.ib_modify and this.id_master.getitemnumber(1, "code") > 0.0 then
						ll_tmprowid = lds_saleorderdetail.getitemnumber(ll_counter, "rowid")
						ll_tmpcode = this.id_master.getitemnumber(1, "code")
						SQL SELECT sum ( looseqty ) , sum ( bonusqty ) INTO :ld_tmpqty, :ld_tmpbonus FROM SaleDetail WHERE SaleOrderRowID =:ll_tmprowid AND SaleInvCode =:ll_tmpcode USING this.it_transobject;
						if this.it_transobject.sqlcode <> 0 then
							lb_insertrow = false
						end if
					end if
					if isnull(ld_tmpqty) then
						ld_tmpqty = 0
					end if
					if isnull(ld_tmpbonus) then
						ld_tmpbonus = 0
					end if
					if lds_saleorderdetail.getitemnumber(ll_counter, "looseqty") - lds_saleorderdetail.getitemnumber(ll_counter, "saleqty") + ld_tmpqty > 0.0 or lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty") - lds_saleorderdetail.getitemnumber(ll_counter, "salebonus") + ld_tmpbonus > 0.0 then
						lb_insertrow = true
					end if
				end if
				if lb_insertrow = true then
					ll_rowcount = this.id_detail.insertrow(0)
					ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_saleorderdetail.getitemnumber(ll_counter, "gcode")), 1, this.idc_godown.rowcount())
					ll_icode = lds_saleorderdetail.getitemnumber(ll_counter, "icode")
					if wf_inititeminfo(ll_icode, ll_rowcount, li_errcode, ls_errortext) then
						ll_gcode = lds_saleorderdetail.getitemnumber(ll_counter, "gcode")
						this.id_detail.setitem(ll_rowcount, "gcode", ll_gcode)
						if wf_set_godown_item_stock(ll_gcode, ll_icode, ll_rowcount, ls_errortext) = 0 then
							this.id_detail.setitem(ll_rowcount, "SaleOrderrowid", lds_saleorderdetail.getitemnumber(ll_counter, "rowid"))
							this.id_detail.setitem(ll_rowcount, "packunits", lds_saleorderdetail.getitemnumber(ll_counter, "packunits"))
							this.id_detail.setitem(ll_rowcount, "discperc", lds_saleorderdetail.getitemnumber(ll_counter, "discperc"))
							this.id_detail.setitem(ll_rowcount, "itemflatdisc", lds_saleorderdetail.getitemnumber(ll_counter, "itemflatdisc"))
							this.id_detail.setitem(ll_rowcount, "saleprice", lds_saleorderdetail.getitemnumber(ll_counter, "saleprice"))
							if lstr_template.i_invtype = 0 then
								this.id_detail.setitem(ll_rowcount, "looseqty", lds_saleorderdetail.getitemnumber(ll_counter, "looseqty"))
								this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty"))
							else
								ld_tmpqty = lds_saleorderdetail.getitemnumber(ll_counter, "looseqty") - lds_saleorderdetail.getitemnumber(ll_counter, "saleqty") + ld_tmpqty
								ld_tmpbonus = lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty") - lds_saleorderdetail.getitemnumber(ll_counter, "salebonus") + ld_tmpbonus
								if ld_tmpqty > 0.0 then
									this.id_detail.setitem(ll_rowcount, "looseqty", ld_tmpqty)
								end if
								if ld_tmpbonus > 0.0 then
									this.id_detail.setitem(ll_rowcount, "bonusqty", ld_tmpbonus)
								end if
							end if
						end if
					end if
				end if
			next
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return li_retcode

// w_postsale.wf_set_godown_item_stock(long ai_gcode, long al_icode, long al_detailrow, string as_errortext) returns long
	double ld_godownstock
	boolean retflag
	this.it_transobject.getitemstocktotal(ai_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.id_detail.setitem(al_detailrow, "stock", ld_godownstock)
	this.id_footer.setitem(this.id_footer.getrow(), "stock", ld_godownstock)
	if retflag then
		return 0
	end if
	return -1

// w_postsale.wf_pd_initialize() returns long
	string ls_init_string
	ls_init_string = char(27) + char(73) + char(12)
	pd_writepd(ls_init_string, len(ls_init_string))
	return 0

// w_postsale.wf_selectprintreport(string as_invsize) returns string
	string ls_pagesize
	string ls_report
	long ll_currrow
	integer li_headerno
	ll_currrow = this.id_master.getrow()
	ls_pagesize = as_invsize
	li_headerno = this.id_master.getitemnumber(ll_currrow, "headerno")
	ls_report = f_getposprintout(ls_pagesize, this.ib_printout, li_headerno)
	this.id_print.dataobject = ls_report
	f_set_headerlogo(this.id_print, li_headerno)
	this.id_print.settransobject(this.it_transobject)
	this.ib_printout = true
	return ls_report

// w_postsale.wf_getitemdiscounts(long al_icode, long al_custcode, double ad_salediscperc, double ad_maxsalediscperc) returns long
	long ll_retcode
	SQL SELECT SaleDiscPerc =CASE ( SELECT DefaultItemDiscPerc FROM DBO.Customer WHERE CustCode =:al_custcode ) WHEN 1 THEN SaleDiscPerc WHEN 2 THEN SaleDiscPerc2 WHEN 3 THEN SaleDiscPerc3 WHEN 4 THEN SaleDiscPerc4 WHEN 5 THEN SaleDiscPerc5 ELSE 0 END , MaxSaleDiscPerc INTO :ad_salediscperc, :ad_maxsalediscperc FROM item WHERE ICode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_retcode = 0
	else
		ll_retcode = -1
	end if
	return ll_retcode

// w_postsale.wf_quotationinuse(long al_quotationcode, long al_saleinvno) returns long
	long ll_saleinvcode
	ll_saleinvcode = this.id_master.object.code[this.id_master.getrow()]
	SQL Select SaleInvCode INTO :al_saleinvno From SaleLedger Where QuotationNo =:al_quotationcode And SaleInvCode Not In ( :ll_saleinvcode ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 100 then
		return 0
	end if
	return -1

// w_postsale.wf_getitemsaleprice(long al_icode, double ad_saleprice) returns long
	long ll_retcode
	SQL SELECT saleprice =Round ( saleprice / CASE PackUnits WHEN 0 THEN 1 ELSE PackUnits END , 2 ) INTO :ad_saleprice FROM item WHERE ICode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_retcode = 0
	else
		ll_retcode = -1
	end if
	return ll_retcode

// w_postsale.wf_inititeminfo_quotation(long al_icode, long al_row, integer ai_rtcode, string as_errortext, integer al_gcode) returns boolean
	boolean retflag
	integer li_gcode
	integer li_defaultgcode
	integer li_defaultgst
	integer li_custcode
	integer li_flatdiscstatus
	integer li_itemdiscpercno
	long ll_packunits
	long ll_saleinvcode
	long ll_reorderqty
	long ll_null
	long ll_totalpieces
	long ll_piecesinhand
	long li_discstatus
	long ll_qtysale
	long ll_bonus
	long ll_itemdesc_status
	double ld_rpp
	double ld_purprice
	double ld_flatdisc
	double ld_invdiscperc
	double ld_discperc2
	double ld_discperc3
	double ld_discperc4
	double ld_saleprice
	double ld_discperc
	double ld_purdiscperc
	double ld_avgprice
	double ld_unitsalestax
	double ld_gstperc1
	double ld_gstperc2
	double ld_packsalestax
	double ld_saleprice2
	double ld_saleprice3
	double ld_saleprice4
	double ld_saleprice5
	double ld_discperc5
	double ld_godownstock
	double ld_saleqty
	double ld_totalstock
	double ld_holdlooseqty
	double ld_desiredbonus
	double ld_purunitrate
	double ld_rppunitrate
	double ld_unitweight
	double ld_packingfactor
	double ld_alternatepurprice
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_antinorcotix
	string ls_itemtotalval
	string ls_locksaleprice
	string ls_lockdiscperc
	string ls_remarks
	setnull(ls_null)
	setnull(ll_null)
	SQL SELECT item.customicode , item.name , item.saleprice , item.packunits , item.salediscperc , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.avgprice , item.PurDiscPerc , item.antinorcotix , item.reorderqty , item.purprice , item.recentpurprice , round ( item.Packsalestax / item.packunits , 2 ) , item.gstperc1 , item.gstperc2 , qtysale =item.saleqty , bonus =item.bonusqty , item.Packsalestax , item.flatdisc , item.locksaleprice , item.lockdiscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 , item.remarks , round ( item.purprice / item.packunits , 2 ) , round ( item.recentpurprice / item.packunits , 2 ) , item.unitweight , item.packingfactor , totalpieces , item.alternatepurprice INTO :ls_fullcode, :ls_name, :ld_saleprice, :ll_packunits, :ld_discperc, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :ld_avgprice, :ld_purdiscperc, :ls_antinorcotix, :ll_reorderqty, :ld_purprice, :ld_rpp, :ld_unitsalestax, :ld_gstperc1, :ld_gstperc2, :ll_qtysale, :ll_bonus, :ld_packsalestax, :ld_flatdisc, :ls_locksaleprice, :ls_lockdiscperc, :ld_discperc2, :ld_discperc3, :ld_discperc4, :ld_discperc5, :ls_remarks, :ld_purunitrate, :ld_rppunitrate, :ld_unitweight, :ld_packingfactor, :ll_piecesinhand, :ld_alternatepurprice FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
	li_custcode = this.id_master.getitemnumber(1, "custcode")
	if isnull(li_custcode) then
		retflag = false
		as_errortext = "Validation Error: Select Customer "
	end if
	li_defaultgst = this.id_master.getitemnumber(1, "dd_gstperc")
	SQL SELECT InvDiscPerc INTO :ld_invdiscperc FROM customer WHERE customer.custcode =:li_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	li_gcode = al_gcode
	this.it_transobject.getitemstockall(al_icode, ld_totalstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.ib_modify and retflag then
		ll_saleinvcode = this.id_master.getitemnumber(1, "code")
		if wf_getsalesstockinfo(ll_saleinvcode, li_gcode, al_icode, ld_saleqty) <> 0 then
			retflag = false
			as_errortext = "Database Error: Item information can not be retrieved"
		end if
		ld_godownstock = ld_godownstock + ld_saleqty
		ll_piecesinhand = ll_piecesinhand + ll_totalpieces
	end if
	if retflag then
		this.id_detail.setitem(al_row, "gcode", li_gcode)
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		li_discstatus = long(this.id_detail.object.discperc.visible)
		ll_itemdesc_status = long(this.id_detail.object.saleitemdescription.visible)
		li_flatdiscstatus = long(this.id_detail.object.itemflatdisc.visible)
		if li_discstatus = 1 and this.id_detail.getitemstatus(al_row, "discperc", primary!) = notmodified! then
			li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
			if long(this.id_detail.object.discperc.visible) = 1 then
				choose case li_itemdiscpercno
				case 1
					this.id_detail.setitem(al_row, "discperc", ld_discperc)
				case 2
					this.id_detail.setitem(al_row, "discperc", ld_discperc2)
				case 3
					this.id_detail.setitem(al_row, "discperc", ld_discperc3)
				case 4
					this.id_detail.setitem(al_row, "discperc", ld_discperc4)
				case 5
					this.id_detail.setitem(al_row, "discperc", ld_discperc5)
				end choose
			else
				this.id_detail.setitem(al_row, "discperc", 0)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") and li_discstatus = 1 then
			li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
			choose case li_itemdiscpercno
			case 1
				this.id_detail.setitem(al_row, "discperc", ld_discperc)
			case 2
				this.id_detail.setitem(al_row, "discperc", ld_discperc2)
			case 3
				this.id_detail.setitem(al_row, "discperc", ld_discperc3)
			case 4
				this.id_detail.setitem(al_row, "discperc", ld_discperc4)
			case 5
				this.id_detail.setitem(al_row, "discperc", ld_discperc5)
			end choose
		end if
		if this.id_detail.getitemstatus(al_row, "saleprice", primary!) = notmodified! then
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
			case 2.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice2 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice3 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice4 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice5 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_purprice / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_purprice)
				this.id_detail.setitem(al_row, "packprice", ld_purprice)
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_rpp / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_rpp)
				this.id_detail.setitem(al_row, "packprice", ld_rpp)
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
			case else
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_avgprice)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
			end choose
			this.id_detail.setitem(al_row, "discprice", this.id_detail.getitemnumber(al_row, "saleprice") * (1.0 - this.id_detail.getitemnumber(al_row, "discperc") * 0.01))
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
			case 2.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice2 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice3 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice4 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_saleprice5 / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_purprice / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_purprice)
				this.id_detail.setitem(al_row, "packprice", ld_purprice)
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_rpp / ll_packunits)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_rpp)
				this.id_detail.setitem(al_row, "packprice", ld_rpp)
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
			case else
				if this.is_reportratedeviationusing = "A" then
					this.id_detail.setitem(al_row, "rate", ld_avgprice)
				else
					this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
				end if
				this.id_detail.setitem(al_row, "packsaleprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
			end choose
			this.id_detail.setitem(al_row, "discprice", this.id_detail.getitemnumber(al_row, "saleprice") * (1.0 - this.id_detail.getitemnumber(al_row, "discperc") * 0.01))
		end if
		this.id_detail.setitem(al_row, "icode", al_icode)
		this.id_detail.setitem(al_row, "packunits", ll_packunits)
		this.id_detail.setitem(al_row, "stock", ld_godownstock)
		this.id_detail.setitem(al_row, "totalstock", ld_totalstock)
		this.id_detail.setitem(al_row, "piecesinhand", ll_piecesinhand)
		this.id_detail.setitem(al_row, "unitweight", ld_unitweight)
		this.id_detail.setitem(al_row, "packingfactor", ld_packingfactor)
		if ll_piecesinhand = 0 then
			this.id_detail.setitem(al_row, "totalpieces", 0)
		end if
		this.id_detail.setitem(al_row, "saleorderrowid", ll_null)
		if li_flatdiscstatus = 1 then
			if this.id_detail.getitemstatus(al_row, "itemflatdisc", primary!) = notmodified! then
				this.id_detail.setitem(al_row, "itemflatdisc", ld_flatdisc)
			end if
		else
			this.id_detail.setitem(al_row, "itemflatdisc", 0)
		end if
		if f_stringpreferences("SaleCopyItemRemarks") = "Y" and this.id_detail.getitemstatus(al_row, "saleitemdescription", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "saleitemdescription", ls_remarks)
		end if
		this.id_detail.setitem(al_row, "recentpurprice", ld_rpp)
		this.id_detail.setitem(al_row, "purprice", ld_purprice)
		if ld_avgprice = 0.0 then
			this.id_detail.setitem(al_row, "avgprice", ld_purunitrate)
		else
			this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
		end if
		this.id_detail.setitem(al_row, "purunitrate", ld_purunitrate)
		this.id_detail.setitem(al_row, "rppunitrate", ld_rppunitrate)
		this.id_detail.setitem(al_row, "alternatepurprice", ld_alternatepurprice)
		this.id_detail.setitem(al_row, "itemtotalval", ls_itemtotalval)
		if f_stringpreferences("bonusinsale") = "Y" then
			this.id_detail.setitem(al_row, "qtysale", ll_qtysale)
			this.id_detail.setitem(al_row, "bonus", ll_bonus)
		end if
		if this.id_detail.getitemstatus(al_row, "Unitsalestax", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
		end if
		if this.id_detail.getitemstatus(al_row, "gstperc", primary!) = notmodified! then
			if li_defaultgst = 2 then
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
			if li_defaultgst = 2 then
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
			end if
			if f_stringpreferences("SaleCopyItemRemarks") = "Y" then
				this.id_detail.setitem(al_row, "saleitemdescription", ls_remarks)
			end if
		end if
		this.id_detail.setitem(al_row, "locksaleprice", ls_locksaleprice)
		this.id_detail.setitem(al_row, "lockdiscperc", ls_lockdiscperc)
		if ld_godownstock = 0.0 then
			ai_rtcode = -2
			as_errortext = "Item can not be sold, its Stock is Zero"
		end if
	else
		retflag = false
		as_errortext = "Item can not be sold, its Stock is Zero"
	end if
	if f_stringpreferences("salepromptforreorder") = "Y" and ll_reorderqty > round(ld_godownstock / ll_packunits, 0) then
		messagebox("Stock", "Stock for this item become~r~n less than ReorderQty")
	end if
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_totalstock)
	this.id_footer.setitem(1, "piecesinhand", ll_piecesinhand)
	this.id_footer.setitem(1, "rpp", ld_rpp)
	this.id_footer.setitem(1, "purprice", ld_purprice)
	this.id_footer.setitem(1, "avgprice", ld_avgprice)
	this.id_footer.setitem(1, "itemtotalval", ls_itemtotalval)
	if this.id_footer.getitemstatus(1, "invdiscperc", primary!) = notmodified! and this.ib_modify = false then
		this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
	end if
	if f_stringpreferences("bonusinsale") = "Y" then
		this.id_footer.setitem(1, "bonusratio", trim(string(ll_qtysale)) + ":" + trim(string(ll_bonus)))
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			ld_holdlooseqty = this.id_detail.getitemnumber(al_row, "looseqty")
			if this.id_detail.getitemnumber(al_row, "qtysale") = 0.0 then
				ld_desiredbonus = 0
			else
				ld_desiredbonus = int(ld_holdlooseqty / double(this.id_detail.getitemnumber(al_row, "qtysale")) * double(this.id_detail.getitemnumber(al_row, "Bonus")))
			end if
			if ld_holdlooseqty + ld_desiredbonus <= ld_godownstock then
				this.id_detail.setitem(al_row, "bonusqty", ld_desiredbonus)
			elseif ld_holdlooseqty > ld_godownstock then
				messagebox("Quantity Validation", "Quantity " + string(ld_holdlooseqty) + " exceeds stock " + string(ld_godownstock) + ".")
				this.id_detail.setitem(al_row, "looseqty", 1)
				this.id_detail.setitem(al_row, "bonusqty", 0)
			else
				ld_desiredbonus = messagebox("Problem allocating bonus", "Sale Qty = " + string(ld_holdlooseqty) + " ~r" + "Required Bonus = " + trim(string(ld_desiredbonus)) + " ~r" + "Stock available = " + trim(string(ld_godownstock)) + " ~r" + "Allocate possible bonus?", question!, yesno!, 2)
				if ld_desiredbonus = 1.0 then
					this.id_detail.setitem(al_row, "bonusqty", ld_godownstock - ld_holdlooseqty)
				else
					retflag = false
					this.id_detail.setitem(al_row, "bonusqty", 0)
				end if
			end if
		end if
	end if
	this.id_footer.object.t_purdiscper.text = string(ld_purdiscperc)
	this.id_detail.setitem(al_row, "itemcode", al_icode)
	if ls_antinorcotix = "Y" and retflag = true and not (this.il_norcotixcode = al_icode) then
		messagebox("Item Validation", "This is Narcotics item ~r~n please type Doctor name in remarks")
		this.il_norcotixcode = al_icode
	end if
	return retflag

// w_postsale.wf_set_discperc_onlyon_unlock_discperc() returns long
	s_arguements lstr_arg
	long ll_counter
	long ll_icode
	u_transaction lt_transobject
	char ls_islock
	lt_transobject = create u_transaction
	SQL start USING lt_transobject;
	open(w_arg_only_decimal_input)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT lockdiscperc INTO :ls_islock FROM ITEM WHERE ITEM.icode =:ll_icode USING lt_transobject;
			if ls_islock = "N" then
				this.id_detail.setitem(ll_counter, "discperc", lstr_arg.db_code1)
			end if
		next
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	return 0

// w_postsale.wf_is_itemdue_allowed(long al_icode, string as_errtext) returns long
	char ls_allowdue
	string ls_itemname
	SQL SELECT itemname =Name , AllowDue =UPPER ( AllowDue ) INTO :ls_itemname, :ls_allowdue FROM Item WHERE ICode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ls_allowdue = "Y" then
			return 1
		else
			as_errtext = "Due not Allowed on this item.~r~nItem Name = " + ls_itemname
			return 0
		end if
		return
	end if
	as_errtext = "Database Problem while check Allow Due Status of item.~r~nReasons are:- " + this.it_transobject.sqlerrtext
	return -1

// w_postsale.wf_show_customerwisesaledetailreport() returns 0
	long ll_custcode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_custcode = this.id_master.object.custcode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_custcode = this.id_list.object.custcode[this.id_list.getrow()]
	end if
	if not isnull(ll_custcode) and ll_custcode <> 0 then
		openwithparm(w_customer_saledetail_report, ll_custcode)
	end if

// w_postsale.wf_show_mastercashierwindow(integer ai_mode) returns long
	long ll_counter
	long ll_code
	long ll_row
	long ll_insrow
	long ll_module
	long ll_cashacccode
	double ld_tot_acc_amt
	double ld_sale
	double ld_ret
	string ls_cashtend
	string ls_invtotal
	s_mastercashwin lstr_values
	lstr_values.i_interfacecode = 1
	if f_stringpreferences("askmastercashwin_in_possale") = "N" then
		return 1
	end if
	ll_module = 35
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
		return 0
	end if
	lstr_values.l_invcode = ll_code
	lstr_values.l_cashacccode = ll_cashacccode
	lstr_values.l_groupcode = this.il_groupcode
	lstr_values.l_module = ll_module
	ld_sale = wf_grandtotal()
	if isnull(ld_sale) then
		ld_sale = 0
	end if
	ld_ret = this.id_footer.object.salereturnamt[1]
	if isnull(ld_ret) then
		ld_ret = 0
	end if
	lstr_values.d_netamt = round(ld_sale - ld_ret, 0)
	lstr_values.d_cashtendered = this.id_master.object.cashtendered[this.id_master.rowcount()]
	lstr_values.d_cashcharged = this.id_master.object.cashcharged[this.id_master.rowcount()]
	lstr_values.d_cashback = this.id_master.object.cashback[this.id_master.rowcount()]
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		lstr_values.l_acccode[ll_counter] = this.ids_cashwin.object.acccode[ll_counter]
		lstr_values.s_remarks[ll_counter] = this.ids_cashwin.object.remarks[ll_counter]
		lstr_values.d_amount[ll_counter] = this.ids_cashwin.object.amount[ll_counter]
		lstr_values.l_rowid[ll_counter] = this.ids_cashwin.object.rowid[ll_counter]
		ld_tot_acc_amt = ld_tot_acc_amt + this.ids_cashwin.object.amount[ll_counter]
	next
	if lstr_values.d_netamt >= lstr_values.d_cashcharged then
		lstr_values.d_invbalance = lstr_values.d_netamt - lstr_values.d_cashcharged - ld_tot_acc_amt
	else
		lstr_values.d_invbalance = 0
	end if
	for ll_counter = 1 to 100
		if lstr_values.l_rowid[ll_counter] <= 0 then
			lstr_values.l_rowid[ll_counter] = -1
		end if
	next
	lstr_values.l_mode = ai_mode
	openwithparm(w_cashierwindow, lstr_values)
	lstr_values = message.powerobjectparm
	if lstr_values.i_status = 1 then
		this.ids_cashwin.reset()
		ld_tot_acc_amt = 0
		for ll_counter = 1 to 100
			if lstr_values.l_acccode[ll_counter] > 0 and lstr_values.d_amount[ll_counter] > 0 and lstr_values.l_rowid[ll_counter] > 0 then
				ll_insrow = this.ids_cashwin.insertrow(0)
				this.ids_cashwin.object.saleinvcode[ll_insrow] = ll_code
				this.ids_cashwin.object.acccode[ll_insrow] = lstr_values.l_acccode[ll_counter]
				this.ids_cashwin.object.remarks[ll_insrow] = lstr_values.s_remarks[ll_counter]
				this.ids_cashwin.object.amount[ll_insrow] = lstr_values.d_amount[ll_counter]
				this.ids_cashwin.object.rowid[ll_insrow] = lstr_values.l_rowid[ll_counter]
			end if
		next
		this.id_master.object.cashacccode[this.id_master.rowcount()] = lstr_values.l_cashacccode
		this.id_master.object.cashtendered[this.id_master.rowcount()] = lstr_values.d_cashtendered
		this.id_master.object.cashcharged[this.id_master.rowcount()] = lstr_values.d_cashcharged
		this.id_master.object.cashback[this.id_master.rowcount()] = lstr_values.d_cashback
		this.id_master.object.cashreceived[this.id_master.rowcount()] = lstr_values.d_cashtendered
		if this.ii_saletype = 3 then
			if this.id_master.object.cashcharged[this.id_master.rowcount()] = lstr_values.d_netamt and lstr_values.d_invbalance = 0 then
				this.id_master.object.outstandingamt[this.id_master.rowcount()] = 0
			else
				this.id_master.object.outstandingamt[this.id_master.rowcount()] = lstr_values.d_invbalance
			end if
		else
			this.id_master.object.outstandingamt[this.id_master.rowcount()] = lstr_values.d_invbalance
		end if
		if f_stringpreferences("DisplayPool") = "Y" and upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
			ls_cashtend = string(this.id_master.object.cashtendered[this.id_master.rowcount()], "#######0.00")
			ls_invtotal = string(lstr_values.d_netamt, "########0.00")
			this.ole_lcddisplay.object.__invoke_method("showcashtender", 2, {ls_invtotal, ls_cashtend}, true)
		end if
		return 1
	end if
	return 0

// w_postsale.wf_show_payment_info() returns long
	long ll_code
	double ld_amt
	double ld_cashreceived
	boolean lb_listtab
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	ll_code = this.id_master.object.code[1]
	if ll_code > 0 and lb_listtab then
		wf_show_mastercashierwindow(1)
	end if
	return 0

// w_postsale.wf_set_loyaltypoints(long al_acccode) returns long
	datetime ldt_balancedate
	long ll_layaltypointsbalance
	long ll_retcode
	double ld_layaltypointsvalue
	if f_stringpreferences("pos_loyaltypointsbalance") = "N" then
		return 0
	end if
	SQL SELECT GETDATE ( ) INTO :ldt_balancedate FROM _Utn USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 and al_acccode > 0 then
		this.it_transobject.getaccountloyaltybalance(al_acccode, ldt_balancedate, ll_layaltypointsbalance, ld_layaltypointsvalue)
		if this.it_transobject.sqlcode = 0 then
			this.id_master.object.loyaltypointsbalance[1] = ll_layaltypointsbalance
			this.id_master.object.loyaltypointsvalue[1] = ld_layaltypointsvalue
		else
			messagebox("Loyalty Points Balance", "Loyalty Points Fetching Error.~r~nDetails are:-~r~n" + this.it_transobject.sqlerrtext)
			ll_retcode = -1
		end if
	end if
	return ll_retcode

// w_postsale.wf_new_customerregisteration() returns integer
	string ls_aliasname
	long ll_acccode
	long ll_found
	long ll_row
	dwobject dwo
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 694", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		open(w_customer_register)
		ls_aliasname = message.stringparm
		if not (ls_aliasname = "" or isnull(ls_aliasname)) then
			wf_customer_retrieve()
			ll_found = 0
			ll_found = this.idc_customers.find("accounts_aliasname = '" + ls_aliasname + "'", 1, this.idc_customers.rowcount())
			if ll_found > 0 then
				this.id_master.setitem(1, "custcode", this.idc_customers.getitemstring(ll_found, "accounts_aliasname"))
				ll_acccode = this.idc_customers.getitemnumber(ll_found, "accounts_acccode")
				this.id_master.setitem(1, "custcode", ll_acccode)
				dwo = this.id_master.object.custcode
				this.id_master.post event itemchanged(1, dwo, string(ll_acccode))
			end if
		end if
	end if
	return 0

// w_postsale.wf_customer_retrieve() returns integer
	this.idc_customers.setredraw(false)
	this.idc_customers.settransobject(this.it_transobject)
	this.idc_customers.retrieve()
	this.idc_customers.setredraw(true)
	return 0

// w_postsale.wf_getcustitemcatwisesalesdiscount(long al_icode, long al_custcode, double ad_discperc, double ad_itemflatdisc) returns boolean
	double ld_null
	setnull(ld_null)
	ad_discperc = ld_null
	SQL SELECT discperc , itemflatdisc INTO :ad_discperc, :ad_itemflatdisc FROM DBO.CustItemCatWiseSaleDiscount WHERE CustCatCode =ISNULL ( ( SELECT Customer.custcatcode FROM dbo.customer Where Customer.custcode =:al_custcode ) , 0 ) AND ICatCode =ISNULL ( ( SELECT Item.icatcode FROM dbo.Item Where Item.Icode =:al_icode ) , 0 ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ad_discperc) or isnull(ad_itemflatdisc) then
			return false
		else
			return true
		end if
		return
	end if
	return false

// w_postsale.wf_apply_saleinvoice_discountpolicy() returns long
	double ld_invtotal
	double ld_invdiscperc
	string ls_msgtitle
	string ls_msgdetail
	if wf_iseditable() = false then
		return 0
	end if
	if f_stringpreferences("ApplySaleInvoiceDiscountPolicyOnSaving") = "N" then
		return 0
	end if
	ld_invtotal = wf_grandtotal()
	this.it_transobject.apply_saleamt_based_discountpolicy(ld_invtotal, ld_invdiscperc)
	if this.it_transobject.sqlcode = 0 then
		if isnull(ld_invdiscperc) or ld_invdiscperc < 0.00 then
			ld_invdiscperc = 0
		end if
		this.id_footer.object.invdiscperc[1] = ld_invdiscperc
		this.id_footer.accepttext()
		wf_grandtotal()
		this.id_master.setitem(1, "discperc", ld_invdiscperc)
		this.id_master.accepttext()
		this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
		ld_invtotal = wf_grandtotal()
		if ld_invtotal < 0.0 then
			messagebox("Invoice Total Validation", "Sale Invoice Total can not be -ve value.", stopsign!)
			return -1
		end if
		return
	end if
	wf_setoutstandingamount()
	return 0

// w_postsale.wf_autoredeemloyaltypointsasdiscount(integer ai_mode) returns long
	long ll_custcode
	long ll_masterrow
	long ll_detailrows
	long ll_found
	long ll_insrow
	long ll_row
	long ll_icode
	long ll_manualdiscount_itemcount
	long ll_retcode
	long ll_loyaltypolicycode
	long ll_redeemablepoints
	double ld_looseqty
	double ld_policy_discperc
	double ld_discperc
	double ld_policy_itemflatdisc
	double ld_itemflatdisc
	double ld_redemptiondiscperc
	double ld_bonusqty
	double ld_saleprice
	double ld_redeemableamt
	string ls_msgtitle
	string ls_itemname
	string ls_msgdetail
	string ls_fullcode
	string ls_customername
	boolean lb_editsalediscperc
	boolean lb_edititemflatdisc
	datastore lds_items
	if f_stringpreferences("autoredeemloyaltypointsasredemptiondiscperc") = "N" then
		this.id_redemptionvalue = 0
		this.il_pointsredeemed = 0
		return 0
	end if
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.object.posted[1] = "N" then
		return 0
	end if
	lds_items = create datastore
	lds_items.dataobject = "d_loyaltyredemptiondiscperc"
	lds_items.settransobject(this.it_transobject)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		return 0
	end if
	ll_custcode = this.id_master.object.custcode[1]
	if this.id_master.object.loyaltypointsbalance[1] > 0 and this.id_master.object.loyaltypointsvalue[1] > 0 and this.id_master.object.posted[1] = "Y" then
		for ll_row = 1 to ll_detailrows
			ll_icode = this.id_detail.getitemnumber(ll_row, "icode")
			ls_fullcode = this.id_detail.getitemstring(ll_row, "fullcode")
			ls_itemname = this.id_detail.getitemstring(ll_row, "itemname")
			ld_looseqty = this.id_detail.getitemnumber(ll_row, "looseqty")
			ld_bonusqty = this.id_detail.getitemnumber(ll_row, "bonusqty")
			ld_saleprice = this.id_detail.getitemnumber(ll_row, "saleprice")
			ld_discperc = this.id_detail.getitemnumber(ll_row, "DiscPerc")
			SQL SELECT RedemptionDiscPerc INTO :ld_redemptiondiscperc FROM Item WHERE ICode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 and ld_redemptiondiscperc > 0.0 then
				ll_insrow = lds_items.insertrow(0)
				if ll_insrow > 0 then
					lds_items.object.custcode[ll_insrow] = this.id_master.object.custcode[1]
					lds_items.object.customeralias[ll_insrow] = this.id_master.object.aliasname[1]
					SQL SELECT Name INTO :ls_customername FROM Accounts WHERE AccCode =:ll_custcode USING this.it_transobject;
					lds_items.object.customername[ll_insrow] = ls_customername
					lds_items.object.loyaltypointsbalance[ll_insrow] = this.id_master.object.loyaltypointsbalance[1]
					lds_items.object.loyaltypointsvalue[ll_insrow] = this.id_master.object.loyaltypointsvalue[1]
					lds_items.object.icode[ll_insrow] = ll_icode
					lds_items.object.fullcode[ll_insrow] = ls_fullcode
					lds_items.object.itemname[ll_insrow] = ls_itemname
					lds_items.object.qty[ll_insrow] = ld_looseqty
					lds_items.object.bonusqty[ll_insrow] = ld_bonusqty
					lds_items.object.saleprice[ll_insrow] = ld_saleprice
					lds_items.object.discperc[ll_insrow] = ld_discperc
					lds_items.object.redemptiondiscperc[ll_insrow] = ld_redemptiondiscperc
				end if
			end if
		next
		if lds_items.rowcount() > 0 then
			ld_redeemableamt = lds_items.getitemnumber(1, "c_redeemableamt")
			if ld_redeemableamt <= this.id_master.object.loyaltypointsvalue[1] then
				openwithparm(w_loyaltyredemptiondiscount, lds_items)
				ll_retcode = message.doubleparm
				if ll_retcode = -1 then
					return -1
				elseif ai_mode = 1 then
					ll_detailrows = lds_items.rowcount()
					if ll_detailrows > 0 then
						ll_row = 1
						for ll_row = 1 to ll_detailrows
							ll_icode = lds_items.object.icode[ll_row]
							ld_redemptiondiscperc = lds_items.object.redemptiondiscperc[ll_row]
							ll_found = this.id_detail.find("icode = " + trim(string(ll_icode)), 1, this.id_detail.rowcount())
							if ll_found > 0 and ll_found <= this.id_detail.rowcount() then
								this.id_detail.object.discperc[ll_found] = ld_redemptiondiscperc
							end if
						next
						ll_loyaltypolicycode = wf_get_loyaltypolicy(ll_custcode)
						ll_redeemablepoints = wf_get_pointsredeemed(ll_loyaltypolicycode, ld_redeemableamt)
						if ll_redeemablepoints > this.id_master.object.loyaltypointsbalance[1] then
							ll_redeemablepoints = this.id_master.object.loyaltypointsbalance[1]
						end if
						this.il_pointsredeemed = ll_redeemablepoints
						this.id_redemptionvalue = ld_redeemableamt
					end if
				end if
			end if
		end if
	end if
	wf_grandtotal()
	return 1

// w_postsale.wf_get_pointsredeemed(long al_policycode, double ad_redeemablevalue) returns long
	double ld_pointsvalue
	long ll_retcode
	long ll_points
	ll_retcode = 0
	ld_pointsvalue = 0
	SQL SELECT LoyaltyPoints =A.LoyaltyPoints , PointsValue =A.RedemptionValue INTO :ll_points, :ld_pointsvalue FROM ( SELECT LoyaltyPoints =MAX ( D.LoyaltyPoints ) , RedemptionValue =MAX ( D.RedemptionValue ) FROM LoyaltyPolicyDetail D , ( SELECT LoyaltyPoints =MIN ( LoyaltyPoints ) FROM LoyaltyPolicyDetail WHERE LoyaltyPolicyCode =:al_policycode AND RedemptionValue >= :ad_redeemablevalue UNION SELECT LoyaltyPoints =MAX ( LoyaltyPoints ) FROM LoyaltyPolicyDetail WHERE LoyaltyPolicyCode =:al_policycode AND RedemptionValue <= :ad_redeemablevalue ) T WHERE D.LoyaltyPolicyCode =:al_policycode AND D.LoyaltyPoints =T.LoyaltyPoints AND D.RedemptionValue <= :ad_redeemablevalue ) A USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		ll_points = 0
	end if
	return ll_points

// w_postsale.wf_get_loyaltypolicy(long al_custcode) returns long
	long ll_policycode
	SQL SELECT MIN ( LoyaltyPolicyCode ) INTO :ll_policycode FROM LoyaltyCard WHERE AccCode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		return ll_policycode
	end if
	return -1

// w_postsale.wf_setcustomername(string as_data) returns 0
	long ll_rowno
	ll_rowno = this.idc_customers.find("customer_name >='" + as_data + "'", 1, this.idc_customers.rowcount())
	if ll_rowno > 0 then
		this.idc_customers.selectrow(0, false)
		this.idc_customers.setrow(ll_rowno)
		this.idc_customers.scrolltorow(ll_rowno)
		this.idc_customers.selectrow(ll_rowno, true)
	end if

// w_postsale.wf_refetch_price_for_salestax_extraction(long al_icode, long al_custcode, long al_row) returns long
	long ll_counter
	long ll_dayslimit
	double ld_custgst
	double ld_gstperc1
	double ld_gstperc2
	double ld_itemdiscperc
	double ld_itemdiscperc2
	double ld_itemdiscperc3
	double ld_itemdiscperc4
	double ld_saleprice1
	double ld_saleprice2
	double ld_saleprice3
	double ld_invdiscperc
	double ld_retailprice
	double ld_saleprice4
	double ld_saleprice5
	double ld_itemdiscperc5
	double ld_custitemcatdiscperc
	double ld_itemflatdisc
	double ld_customerbalance
	double ld_avgprice
	double ld_purunitrate
	double ld_rppunitrate
	double ld_purprice
	double ld_rpp
	integer li_salepriceno
	integer li_itemdiscpercno
	integer li_packunits
	integer li_smancode
	integer li_null
	integer li_option
	integer li_saletypecode
	boolean lb_setiteminfo
	string ls_null
	string ls_aliasname
	string ls_printwaranty
	string ls_printbalance
	setnull(li_null)
	setnull(ls_null)
	if this.ib_apply_stax_schedule_on_unit_stax = false then
		return 0
	end if
	if isnull(al_custcode) then
		return 0
	end if
	if isnull(al_custcode) then
		messagebox("Database Error", "Customer information can not be retrieved")
		return 1
	end if
	if this.id_master.accepttext() = -1 then
		return 1
	end if
	setredraw(false)
	if f_stringpreferences("setcustwiseiteminfo") = "Y" then
		lb_setiteminfo = true
	end if
	if lb_setiteminfo = true then
		SQL SELECT cust.defaultgst , cust.defaultsaleprice , cust.defaultitemdiscperc , acc.aliasname , cust.saletypecode INTO :ld_custgst, :li_salepriceno, :li_itemdiscpercno, :ls_aliasname, :li_saletypecode FROM customer cust , accounts acc WHERE cust.custcode =:al_custcode AND cust.custcode =acc.acccode USING this.it_transobject;
		if this.it_transobject.sqlcode = -1 then
			messagebox("Database Error", "Customer information can not be retrieved")
			return 1
		end if
		SQL SELECT item.gstperc1 , item.gstperc2 , item.salediscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 , item.saleprice , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.packunits , item.avgprice , PurUnitRate =round ( item.purprice / item.packunits , 2 ) , RppUnitRate =round ( item.recentpurprice / item.packunits , 2 ) , item.PurPrice , item.RecentPurPrice INTO :ld_gstperc1, :ld_gstperc2, :ld_itemdiscperc, :ld_itemdiscperc2, :ld_itemdiscperc3, :ld_itemdiscperc4, :ld_itemdiscperc5, :ld_saleprice1, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :li_packunits, :ld_avgprice, :ld_purunitrate, :ld_rppunitrate, :ld_purprice, :ld_rpp FROM item WHERE item.icode =:al_icode USING this.it_transobject;
		if this.it_transobject.sqlcode = -1 then
			messagebox("Database Error", "Item information can not be retrieved")
			return 1
		end if
		choose case li_salepriceno
		case 1
			this.id_detail.setitem(al_row, "rate", ld_saleprice1 / li_packunits)
			this.id_detail.setitem(al_row, "saleprice", ld_saleprice1 / li_packunits)
			this.id_detail.setitem(al_row, "packprice", ld_saleprice1)
		case 2
			if this.is_reportratedeviationusing = "A" then
				this.id_detail.setitem(al_row, "rate", ld_saleprice2 / li_packunits)
			else
				this.id_detail.setitem(al_row, "rate", ld_saleprice1 / li_packunits)
			end if
			this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / li_packunits)
			this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
		case 3
			if this.is_reportratedeviationusing = "A" then
				this.id_detail.setitem(al_row, "rate", ld_saleprice3 / li_packunits)
			else
				this.id_detail.setitem(al_row, "rate", ld_saleprice1 / li_packunits)
			end if
			this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / li_packunits)
			this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
		case 4
			if this.is_reportratedeviationusing = "A" then
				this.id_detail.setitem(al_row, "rate", ld_purprice / li_packunits)
			else
				this.id_detail.setitem(al_row, "rate", ld_saleprice1 / li_packunits)
			end if
			this.id_detail.setitem(al_row, "packsaleprice", ld_purprice)
			this.id_detail.setitem(al_row, "packprice", ld_purprice)
			this.id_detail.setitem(al_row, "saleprice", ld_purprice / li_packunits)
		case 5
			if this.is_reportratedeviationusing = "A" then
				this.id_detail.setitem(al_row, "rate", ld_rpp / li_packunits)
			else
				this.id_detail.setitem(al_row, "rate", ld_saleprice1 / li_packunits)
			end if
			this.id_detail.setitem(al_row, "packsaleprice", ld_rpp)
			this.id_detail.setitem(al_row, "packprice", ld_rpp)
			this.id_detail.setitem(al_row, "saleprice", ld_rpp / li_packunits)
		case 7
			if this.is_reportratedeviationusing = "A" then
				this.id_detail.setitem(al_row, "rate", ld_saleprice4 / li_packunits)
			else
				this.id_detail.setitem(al_row, "rate", ld_saleprice1 / li_packunits)
			end if
			this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice4)
			this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
			this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / li_packunits)
		case 8
			if this.is_reportratedeviationusing = "A" then
				this.id_detail.setitem(al_row, "rate", ld_saleprice5 / li_packunits)
			else
				this.id_detail.setitem(al_row, "rate", ld_saleprice1 / li_packunits)
			end if
			this.id_detail.setitem(al_row, "packsaleprice", ld_saleprice5)
			this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
			this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / li_packunits)
		case else
			if this.is_reportratedeviationusing = "A" then
				this.id_detail.setitem(al_row, "rate", ld_avgprice)
			else
				this.id_detail.setitem(al_row, "rate", ld_saleprice1 / li_packunits)
			end if
			this.id_detail.setitem(al_row, "retailprice", ld_retailprice / li_packunits)
			this.id_detail.setitem(al_row, "packsaleprice", ld_avgprice * li_packunits)
			this.id_detail.setitem(al_row, "packprice", ld_avgprice * li_packunits)
			this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
		end choose
	else
		SQL SELECT item.saleprice , item.packunits , item.retailprice INTO :ld_saleprice1, :li_packunits, :ld_retailprice FROM item WHERE item.icode =:al_icode USING this.it_transobject;
		if this.it_transobject.sqlcode = -1 then
			messagebox("Database Error", "Item information can not be retrieved")
			return 1
		end if
		this.id_detail.setitem(al_row, "retailprice", ld_retailprice / li_packunits)
		this.id_detail.setitem(al_row, "rate", ld_saleprice1 / li_packunits)
		this.id_detail.setitem(al_row, "saleprice", ld_saleprice1 / li_packunits)
		this.id_detail.setitem(al_row, "packprice", ld_saleprice1)
	end if
	setredraw(true)
	return 0

// w_postsale.wf_setcustomerinfo(long al_custcode) returns integer
	long ll_custcode
	long ll_counter
	long ll_icode
	long ll_lastinvcode
	long ll_dayslimit
	double ld_custgst
	double ld_gstperc1
	double ld_gstperc2
	double ld_itemdiscperc
	double ld_itemdiscperc2
	double ld_itemdiscperc3
	double ld_itemdiscperc4
	double ld_saleprice1
	double ld_saleprice2
	double ld_saleprice3
	double ld_invdiscperc
	double ld_saleprice4
	double ld_saleprice5
	double ld_itemdiscperc5
	double ld_custitemcatdiscperc
	double ld_itemflatdisc
	double ld_customerbalance
	double ld_purunitrate
	double ld_rppunitrate
	double ld_avgprice
	double ld_purprice
	double ld_rpp
	integer li_salepriceno
	integer li_itemdiscpercno
	integer li_packunits
	integer li_smancode
	integer li_null
	integer li_option
	integer li_saletypecode
	boolean lb_setiteminfo
	string ls_null
	string ls_aliasname
	string ls_printwaranty
	string ls_printbalance
	setnull(li_null)
	setnull(ls_null)
	ll_custcode = al_custcode
	if this.id_detail.getrow() > 0 and isnull(this.id_detail.getitemnumber(this.id_detail.getrow(), "itemcode")) then
		if this.id_detail.getrow() = 1 or this.id_detail.rowcount() = 1 then
			this.id_detail.object.fullcode[this.id_detail.getrow()] = ls_null
			this.id_detail.object.icode[this.id_detail.getrow()] = li_null
			this.id_detail.object.itemname[this.id_detail.getrow()] = ls_null
			this.id_detail.object.bonusqty[this.id_detail.getrow()] = 0
			this.id_detail.object.saleprice[this.id_detail.getrow()] = li_null
		else
			event ue_deleteitem()
		end if
	end if
	SQL Select invdiscperc , salesmancode , printwaranty , printbalance INTO :ld_invdiscperc, :li_smancode, :ls_printwaranty, :ls_printbalance From Customer Where custcode =:ll_custcode USING this.it_transobject;
	this.id_master.setitem(1, "printbalance", ls_printbalance)
	if this.it_transobject.sqlcode = 0 then
		if f_stringpreferences("SalesManInSale") = "Y" then
			this.id_master.setitem(1, "smancode", li_smancode)
		end if
		if f_stringpreferences("setcustwiseiteminfo") = "Y" then
			lb_setiteminfo = true
		end if
	end if
	if lb_setiteminfo = true then
		this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
		SQL SELECT cust.defaultgst , cust.defaultsaleprice , cust.defaultitemdiscperc , acc.aliasname , cust.saletypecode INTO :ld_custgst, :li_salepriceno, :li_itemdiscpercno, :ls_aliasname, :li_saletypecode FROM customer cust , accounts acc WHERE cust.custcode =:ll_custcode AND cust.custcode =acc.acccode USING this.it_transobject;
		if this.it_transobject.sqlcode = -1 then
			messagebox("Database Error", "Customer information can not be retrieved")
			return 1
		end if
		if not (this.it_transobject.sqlcode = 100) then
			if ld_custgst = 2.0 then
				this.id_master.setitem(1, "dd_gstperc", 2)
			else
				this.id_master.setitem(1, "dd_gstperc", 1)
			end if
		end if
		this.id_master.setitem(1, "saletypecode", li_saletypecode)
		this.id_master.setitem(1, "itemdiscpercno", li_itemdiscpercno)
		this.id_master.setitem(1, "sprice", li_salepriceno)
		this.id_master.setitem(1, "aliasname", ls_aliasname)
		this.id_master.setitem(1, "printwaranty", ls_printwaranty)
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
			if not isnull(ll_icode) then
				SQL SELECT item.gstperc1 , item.gstperc2 , item.salediscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 , item.saleprice , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.packunits , item.avgprice , PurUnitRate =round ( item.purprice / item.packunits , 2 ) , RppUnitRate =round ( item.recentpurprice / item.packunits , 2 ) , item.PurPrice , item.RecentPurPrice INTO :ld_gstperc1, :ld_gstperc2, :ld_itemdiscperc, :ld_itemdiscperc2, :ld_itemdiscperc3, :ld_itemdiscperc4, :ld_itemdiscperc5, :ld_saleprice1, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :li_packunits, :ld_avgprice, :ld_purunitrate, :ld_rppunitrate, :ld_purprice, :ld_rpp FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
				if this.it_transobject.sqlcode = -1 then
					messagebox("Database Error", "Item information can not be retrieved")
					return 1
				end if
				if not (this.it_transobject.sqlcode = 100) then
					if ld_custgst = 2.0 then
						this.id_detail.setitem(ll_counter, "gstperc", ld_gstperc2)
					else
						this.id_detail.setitem(ll_counter, "gstperc", ld_gstperc1)
					end if
				end if
				choose case li_salepriceno
				case 1
					this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice1 / li_packunits)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice1)
				case 2
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice2 / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice2 / li_packunits)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice2)
				case 3
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice3 / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice3 / li_packunits)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice3)
				case 4
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_purprice / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "packsaleprice", ld_purprice)
					this.id_detail.setitem(ll_counter, "packprice", ld_purprice)
					this.id_detail.setitem(ll_counter, "saleprice", ld_purprice / li_packunits)
				case 5
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_rpp / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "packsaleprice", ld_rpp)
					this.id_detail.setitem(ll_counter, "packprice", ld_rpp)
					this.id_detail.setitem(ll_counter, "saleprice", ld_rpp / li_packunits)
				case 7
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice4 / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "packsaleprice", ld_saleprice4)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice4)
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice4 / li_packunits)
				case 8
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice5 / li_packunits)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "packsaleprice", ld_saleprice5)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice5)
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice5 / li_packunits)
				case else
					if this.is_reportratedeviationusing = "A" then
						this.id_detail.setitem(ll_counter, "rate", ld_avgprice)
					else
						this.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					this.id_detail.setitem(ll_counter, "packsaleprice", ld_avgprice * li_packunits)
					this.id_detail.setitem(ll_counter, "packprice", ld_avgprice * li_packunits)
					this.id_detail.setitem(ll_counter, "saleprice", ld_avgprice)
				end choose
				if long(this.id_detail.object.discperc.visible) = 1 then
					if wf_getcustitemcatwisesalesdiscount(ll_icode, ll_custcode, ld_custitemcatdiscperc, ld_itemflatdisc) = true then
						this.id_detail.setitem(ll_counter, "discperc", ld_custitemcatdiscperc)
						this.id_detail.setitem(ll_counter, "itemflatdisc", ld_itemflatdisc)
					else
						choose case li_itemdiscpercno
						case 1
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc)
						case 2
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc2)
						case 3
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc3)
						case 4
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc4)
						case 5
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc5)
						end choose
					end if
				else
					this.id_detail.setitem(ll_counter, "discperc", 0)
				end if
			end if
			this.id_detail.object.taxflag[ll_counter] = 0
		next
	end if
	return 0

// w_postsale.wf_getsalefiscalized(long al_saleinvcode) returns long
	n_winsock my_socket
	unsignedlong lul_mysocket
	string ls_hostname
	string ls_hostip
	string ls_errortext
	string ls_saleinvcode
	if al_saleinvcode > 0 then
		my_socket.of_startup()
		my_socket.of_setunicode(false, false)
		ls_hostname = my_socket.of_gethostname()
		ls_hostip = my_socket.of_getipaddress(ls_hostname)
		lul_mysocket = my_socket.of_connect("azhar", 9111)
		if lul_mysocket > 0 then
			ls_saleinvcode = trim(string(al_saleinvcode))
			if my_socket.of_send(lul_mysocket, ls_saleinvcode) then
			end if
		else
			ls_errortext = my_socket.of_getlasterror()
			messagebox("Fiscalization Error", ls_errortext)
		end if
	end if
	return 0

// w_postsale.wf_fiscalizesaleinvoice() returns long
	long ll_saleinvcode
	string ls_fiscalized
	string ls_posted
	if this.tab_retrieve.selectedtab = 2 and this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 then
		ll_saleinvcode = this.id_list.object.code[this.id_list.getrow()]
		SQL SELECT Fiscalized , Posted INTO :ls_fiscalized, :ls_posted FROM SaleLedger WHERE SaleInvCode =:ll_saleinvcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 and (ls_posted = "Y" and ls_fiscalized = "N") then
			f_fiscalizesaleinvoice(ll_saleinvcode)
		end if
	end if
	return 0

// w_postsale.wf_fiscalizesaleinvoices() returns long
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	long ll_saleinvcode
	long ll_rows
	string ls_fiscalized
	string ls_posted
	datastore lds_invoices
	if this.tab_retrieve.selectedtab = 2 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
		if ll_salesmancode > 0 then
			open(w_arg_sinvcode_linvcode_sales)
			lstr_arginfo = message.powerobjectparm
			if lstr_arginfo.i_status = 1 and lstr_arginfo.l_code1 <= lstr_arginfo.l_code2 then
				setpointer(hourglass!)
				lds_invoices = create datastore
				lds_invoices.dataobject = "d_saleinvlist_notfiscalized"
				lds_invoices.settransobject(this.it_transobject)
				ll_rows = lds_invoices.retrieve(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
				if ll_rows > 0 then
					for ll_counter = 1 to ll_rows
						ll_saleinvcode = lds_invoices.object.saleinvcode[ll_counter]
						if ll_saleinvcode > 0 then
							SQL SELECT Fiscalized , Posted INTO :ls_fiscalized, :ls_posted FROM SaleLedger WHERE SaleInvCode =:ll_saleinvcode USING this.it_transobject;
							if this.it_transobject.sqlcode = 0 and (ls_posted = "Y" and ls_fiscalized = "N") then
								f_fiscalizesaleinvoice(ll_saleinvcode)
								ll_saleinvcount = ll_saleinvcount + 1
							end if
						end if
					next
					if ll_saleinvcount > 0 then
						messagebox("Fiscalization Completed", "Total Sales Invoices were : " + trim(string(ll_rows)) + "~r~nFiscalized Successfully : " + trim(string(ll_saleinvcount)))
					end if
				end if
			end if
		else
			setfocus()
		end if
	end if
	return 0

// w_postsale.wf_get_document(long al_row, long al_code) returns long
	blob lbl_image
	u_transaction lt_transobject
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server")
		destroy lt_transobject
		return -1
	end if
	SQL SelectBlob Document INTO :lbl_image From SaleDocument Where SaleInvCode =:al_code AND RowID =:al_row USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Sale Document/Image/Picture ", "Unable to fetch Sale Document/Image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	this.istr_document.blob[al_row] = lbl_image
	return 0

// w_postsale.wf_populate_document(long al_code) returns long
	long ll_counter
	long ll_rowcount
	long ll_code
	ll_rowcount = this.dw_document.rowcount()
	if ll_rowcount <= 0 then
		return 0
	end if
	if isnull(al_code) or al_code <= 0 then
		return 0
	end if
	ll_code = this.dw_document.object.code[1]
	for ll_counter = 1 to ll_rowcount
		this.istr_document.ls_value[ll_counter, 1] = trim(string(this.dw_document.object.rowid[ll_counter]))
		this.istr_document.ls_value[ll_counter, 2] = this.dw_document.object.docdescription[ll_counter]
		this.istr_document.ls_value[ll_counter, 3] = this.dw_document.object.documenttype[ll_counter]
		wf_get_document(ll_counter, al_code)
	next
	return 0

// w_postsale.wf_set_saledocument() returns long
	long ll_counter
	long ll_code
	long ll_row
	long ll_null
	s_itemimage lstr_document
	lstr_document.s_caller = "SV"
	setnull(ll_null)
	if this.tab_retrieve.selectedtab = 1 then
		return 0
	elseif this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 then
		this.istr_document = this.istr_blank_document
		ll_code = this.id_list.object.code[this.id_list.getrow()]
		if ll_code > 0 then
			this.dw_document.retrieve(ll_code)
			wf_populate_document(ll_code)
			for ll_counter = 1 to this.dw_document.rowcount()
				lstr_document.ls_value[ll_counter, 1] = trim(string(this.dw_document.object.rowid[ll_counter]))
				lstr_document.ls_value[ll_counter, 2] = this.dw_document.object.docdescription[ll_counter]
				lstr_document.ls_value[ll_counter, 3] = this.dw_document.object.documenttype[ll_counter]
				lstr_document.blob[ll_counter] = this.istr_document.blob[ll_counter]
			next
			openwithparm(w_saledocument, lstr_document)
			lstr_document = message.powerobjectparm
			if lstr_document.i_closemode = 1 then
				this.istr_document = lstr_document
				this.dw_document.reset()
				for ll_counter = 1 to 200
					if long(lstr_document.ls_value[ll_counter, 1]) > 0 then
						ll_row = this.dw_document.insertrow(0)
						this.dw_document.object.code[ll_row] = ll_code
						this.dw_document.object.rowid[ll_row] = long(lstr_document.ls_value[ll_counter, 1])
						this.dw_document.object.docdescription[ll_row] = lstr_document.ls_value[ll_counter, 2]
						this.dw_document.object.documenttype[ll_row] = lstr_document.ls_value[ll_counter, 3]
					end if
				next
				if wf_update_document(ll_code) = 0 then
					this.dw_document.reset()
					this.istr_document = this.istr_blank_document
				end if
			end if
		end if
	end if
	return 0

// w_postsale.wf_update_document(long al_code) returns long
	long ll_counter
	long ll_rowid
	long ll_null
	string ls_desc
	string ls_imgtype
	u_transaction lt_transobject
	setnull(ll_null)
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server for updating/inserting in SaleDocument Table")
		destroy lt_transobject
		return -1
	end if
	SQL DELETE SaleDocument WHERE SaleInvCode =:al_code USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to Delete Previous Sale Document Record from database")
		destroy lt_transobject
		return -1
	end if
	for ll_counter = 1 to this.dw_document.rowcount()
		ll_rowid = this.dw_document.object.rowid[ll_counter]
		ls_desc = this.dw_document.object.docdescription[ll_counter]
		ls_imgtype = this.dw_document.object.documenttype[ll_counter]
		SQL INSERT INTO SaleDocument ( SaleInvCode , docDescription , RowID , documentType ) VALUES ( :al_code , :ls_desc , :ll_rowid , :ls_imgtype ) USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Insert Error", "Unable to Insert Sale Documents Into SaleDocument Table.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
			SQL stop USING lt_transobject;
			destroy lt_transobject
			return -1
		end if
		SQL UpdateBlob SaleDocument Set Document =:this.istr_document.blob[ll_counter] Where SaleInvCode =:al_code and ROWID =:ll_rowid USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Sale Document ", "Unable to update SaleDocument.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		end if
	next
	SQL stop USING lt_transobject;
	destroy lt_transobject
	return 0

// w_postsale.wf_show_documentgallery() returns long
	long ll_code
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_code = this.id_master.object.code[this.id_master.getrow()]
		end if
	elseif this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
	end if
	if ll_code > 0 then
		openwithparm(w_saledocument_gallery, ll_code)
	end if
	return 0

// w_postsale.wf_gen_qrcode(long al_saleinvcode, string as_qrcode) returns integer
	string ls_qr_method
	string ls_setting
	long ll_rows
	ls_qr_method = f_stringpreferences("qrcodeprintingmethodinsale")
	ls_setting = this.id_print.describe("p_qrcode.filename")
	ll_rows = this.id_print.rowcount()
	if ls_setting = "!" then
		ls_setting = this.id_print.object.dw_1[ll_rows].object.p_qrcode.filename
		if ls_setting <> "!" then
			if ls_qr_method = "G" then
				this.id_print.object.dw_1[ll_rows].object.p_qrcode.filename = "qrcode.gif"
				f_get_google_qrcode(as_qrcode)
			elseif ls_qr_method = "H" then
				this.id_print.object.dw_1[ll_rows].object.p_qrcode.filename = "qrcode.gif"
				f_get_googleqrcode_for_fiscalinvno(al_saleinvcode)
			elseif ls_qr_method = "I" then
				f_gen_idautomation_qrcode(as_qrcode)
			elseif ls_qr_method = "M" then
				this.id_print.object.dw_1[ll_rows].object.p_qrcode.filename = "qrcode.bmp"
				f_gen_morovia_qrcode(as_qrcode, 5, 3)
			elseif ls_qr_method = "Q" then
				this.id_print.object.dw_1[ll_rows].object.p_qrcode.filename = "qrcode.bmp"
				f_gen_pb_qrcode(as_qrcode)
			end if
		end if
	elseif ls_qr_method = "G" then
		this.id_print.object.p_qrcode.filename = "qrcode.gif"
		f_get_google_qrcode(as_qrcode)
	elseif ls_qr_method = "H" then
		this.id_print.object.p_qrcode.filename = "qrcode.gif"
		f_get_googleqrcode_for_fiscalinvno(al_saleinvcode)
	elseif ls_qr_method = "I" then
		f_gen_idautomation_qrcode(as_qrcode)
	elseif ls_qr_method = "M" then
		this.id_print.object.p_qrcode.filename = "qrcode.bmp"
		f_gen_morovia_qrcode(as_qrcode, 5, 3)
	elseif ls_qr_method = "Q" then
		this.id_print.object.p_qrcode.filename = "qrcode.bmp"
		f_gen_pb_qrcode(as_qrcode)
	end if
	return 0

// w_postsale.wf_set_misccharges() returns long
	double ld_processingfee
	double ld_netamt
	double ld_misccharges
	double ld_newnetamt
	double ld_advincometax
	ld_netamt = wf_grandtotal()
	ld_misccharges = this.id_footer.object.misccharges[1]
	ld_newnetamt = ld_netamt - ld_misccharges
	if ld_newnetamt < 0.0 or isnull(ld_newnetamt) then
		ld_newnetamt = 0
	end if
	openwithparm(w_set_misccharges, ld_newnetamt)
	ld_processingfee = message.doubleparm
	if ld_processingfee >= 0.0 then
		ld_advincometax = 0.00
		this.id_footer.object.misccharges5[1] = ld_processingfee
		this.id_footer.object.misccharges[1] = ld_advincometax + this.id_footer.object.misccharges1[1] + this.id_footer.object.misccharges2[1] + this.id_footer.object.misccharges3[1] + this.id_footer.object.misccharges4[1] + ld_processingfee
		this.id_footer.accepttext()
		wf_grandtotal()
	end if
	return 0

// w_postsale.wf_show_misccharges_breakup() returns long
	double ld_advincometax
	s_values lstr_values
	lstr_values.d_value1 = this.id_footer.object.misccharges1[1]
	lstr_values.d_value2 = this.id_footer.object.misccharges2[1]
	lstr_values.d_value3 = this.id_footer.object.misccharges3[1]
	lstr_values.d_value4 = this.id_footer.object.misccharges4[1]
	lstr_values.d_value5 = this.id_footer.object.misccharges5[1]
	lstr_values.i_status = 1
	openwithparm(w_misccharges_breakup, lstr_values)
	lstr_values = message.powerobjectparm
	if lstr_values.i_status = 1 then
		this.id_footer.object.misccharges1[1] = lstr_values.d_value1
		this.id_footer.object.misccharges2[1] = lstr_values.d_value2
		this.id_footer.object.misccharges3[1] = lstr_values.d_value3
		this.id_footer.object.misccharges4[1] = lstr_values.d_value4
		this.id_footer.object.misccharges5[1] = lstr_values.d_value5
		ld_advincometax = 0.00
		this.id_footer.object.misccharges[1] = ld_advincometax + lstr_values.d_value1 + lstr_values.d_value2 + lstr_values.d_value3 + lstr_values.d_value4 + lstr_values.d_value5
	end if
	return 0

// w_postsale.wf_set_flatdiscount() returns long
	double ld_disc_with_gst
	double ld_netamt
	double ld_flatdiscamt
	double ld_newnetamt
	ld_netamt = wf_grandtotal()
	ld_flatdiscamt = this.id_footer.object.flatdisc[1]
	ld_newnetamt = ld_netamt + ld_flatdiscamt
	if ld_newnetamt < 0.0 or isnull(ld_newnetamt) then
		ld_newnetamt = 0
	end if
	openwithparm(w_set_flatdiscamt, ld_newnetamt)
	ld_disc_with_gst = message.doubleparm
	if ld_disc_with_gst >= 0.0 then
		this.id_footer.object.flatdisc[1] = ld_disc_with_gst
		this.id_footer.accepttext()
		wf_grandtotal()
	end if
	return 0

// w_postsale.wf_set_flatdiscount2() returns long
	return 0

// w_postsale.wf_misccharges_calc() returns long
	double ld_misccharges
	double ld_misccharges_perc
	double ld_invtotal
	long ll_custcode
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	ld_misccharges = this.id_footer.getitemnumber(1, "misccharges")
	ld_invtotal = this.id_footer.getitemnumber(1, "total")
	ld_misccharges_perc = 0
	SQL select miscchargesperc INTO :ld_misccharges_perc FROM Customer WHERE customer.custcode =:ll_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Database Problem", "Unable to get customer Misc.Charges(%)")
		return -1
	end if
	ld_misccharges = (ld_invtotal - ld_misccharges) * 0.01 * ld_misccharges_perc
	this.id_footer.object.misccharges[1] = ld_misccharges + this.id_footer.object.misccharges1[1] + this.id_footer.object.misccharges2[1] + this.id_footer.object.misccharges3[1] + this.id_footer.object.misccharges4[1] + this.id_footer.object.misccharges5[1]
	return 0

// w_postsale.wf_unfiscalize() returns 0
	long ll_code
	string ls_errtext
	string ls_eventtype
	string ls_module
	string ls_detail
	ls_eventtype = "Information"
	ls_module = "POS"
	ls_detail = "Un-Fiscalized Sale Invoice # "
	if this.tab_retrieve.selectedtab = 1 then
		return
	end if
	if wf_iseditable() then
		return
	end if
	if gl_usercode <> 1 then
		return
	end if
	if this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
	end if
	if ll_code > 0 and this.id_list.object.posted[this.id_list.getrow()] = "Y" and this.id_list.object.fiscalized[this.id_list.getrow()] = "Y" then
		SQL update SaleLedger SET Fiscalized ='N' WHERE SaleInvCode =:ll_code USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			ls_detail = ls_detail + trim(string(ll_code))
			this.it_transobject.insert_eventlog(ls_eventtype, ls_module, ls_detail, gl_usercode)
			SQL commit USING this.it_transobject;
			messagebox("Fiscalization", "Successfully Un-Fiscalized Sale Invoice No. " + trim(string(ll_code)), information!)
		else
			ls_errtext = this.it_transobject.sqlerrtext
			SQL rollback USING this.it_transobject;
			messagebox("Fiscalization Problem", "Unable to Un-Fiscalize Sale Invoice~r~nReasons are:-~r~n" + ls_errtext, stopsign!)
			return
		end if
		return
	end if

// w_postsale.wf_show_branch_itemstockposition() returns long
	s_itemsalehistory ls_itemsalehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itemsalehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		if ls_itemsalehistory.ar_icode > 0 then
			openwithparm(w_crs_branch_itemstockposition, ls_itemsalehistory)
		end if
	end if
	return 0

// w_postsale.wf_link_to_cashiershift() returns integer
	long ll_cashiershiftcode
	if f_stringpreferences("CashierShift") = "Y" then
		this.id_master.object.cashiershiftcode.visible = true
		SQL SELECT MAX ( A.CashierShiftCode ) INTO :ll_cashiershiftcode FROM ( SELECT CashierShiftCode =CashierShiftCode FROM CashierShift WHERE ShiftStatus ='O' AND ShiftOwner =:gl_usercode UNION SELECT CashierShiftCode =CashierShiftCode FROM CashierShiftUsers WHERE UserCode =:gl_usercode AND CashierShiftCode IN ( SELECT CashierShiftCode FROM CashierShift WHERE ShiftStatus ='O' ) ) A USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if ll_cashiershiftcode < 0 then
				ll_cashiershiftcode = -1
			end if
		else
			ll_cashiershiftcode = -1
		end if
	else
		ll_cashiershiftcode = -1
	end if
	if ll_cashiershiftcode = -1 then
		setnull(ll_cashiershiftcode)
	end if
	this.id_master.object.cashiershiftcode[1] = ll_cashiershiftcode
	return 0

// w_postsale.wf_check_cashiershift_on_saving(long al_cashiershiftcode, long al_usercode) returns long
	long ll_cashiershiftcode
	long ll_cashacccode
	if f_stringpreferences("CashierShift") = "Y" then
		this.id_master.object.cashiershiftcode.visible = true
		SQL SELECT MAX ( A.CashierShiftCode ) INTO :ll_cashiershiftcode FROM ( SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND ShiftOwner =:al_usercode AND CashierShiftCode =:al_cashiershiftcode UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShiftUsers WHERE UserCode =:al_usercode AND CashierShiftCode IN ( SELECT MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND CashierShiftCode =:al_cashiershiftcode ) UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND ShiftOwner =:al_usercode UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShiftUsers WHERE UserCode =:al_usercode AND CashierShiftCode IN ( SELECT MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' ) ) A USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if ll_cashiershiftcode < 0 then
				ll_cashiershiftcode = -1
			end if
		else
			ll_cashiershiftcode = -1
		end if
	else
		ll_cashiershiftcode = -1
	end if
	if ll_cashiershiftcode = -1 then
		setnull(ll_cashiershiftcode)
	end if
	this.id_master.object.cashiershiftcode[1] = ll_cashiershiftcode
	if ll_cashiershiftcode > 0 then
		SQL SELECT CashAccCode INTO :ll_cashacccode FROM CashierShift WHERE CashierShiftCode =:ll_cashiershiftcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.id_master.object.cashacccode[1] = ll_cashacccode
		end if
	end if
	if f_stringpreferences("CashierShift") = "Y" and isnull(ll_cashiershiftcode) then
		messagebox("Cashier Shift Linkage Missing", "Cashier Shift Linkage Missing~r~nContact System Administrator and try again.", stopsign!)
		return -1
	end if
	return 0

// w_postsale.wf_protect_row(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=if(isrownew(),0,1)")
	next

// w_postsale.wf_apply_salestaxschedule_on_saving(integer ai_mode, long al_usercode) returns long
	string ls_errortext
	long ll_counter
	long ll_icode
	long ll_taxflag
	long ll_custcode
	char lc_tax_applicable
	char lc_tax_type
	double ld_tax_perc
	double ld_unitsaletax
	double ld_saleprice
	double ld_itemflatdisc
	double ld_discperc
	double ld_retailprice
	double ld_netsaleprice
	integer li_rtcode
	char ls_exempt
	datawindowchild ldc_godown
	datawindowchild ldc_itemmeter
	datastore lds_local
	if this.id_master.rowcount() > 0 then
		ll_custcode = this.id_master.object.custcode[1]
		if ll_custcode > 0 then
			SQL SELECT SalesTaxExemption INTO :ls_exempt FROM Customer WHERE CustCode =:ll_custcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if upper(ls_exempt) = "Y" then
					return 0
				end if
			else
				messagebox("Apply Sales Tax Schedule", "Problem in verification of Customer Sales Tax Exemption Status.~r~nDetails are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
				return -1
			end if
			return
		end if
		return
	end if
	if this.ib_apply_stax_schedule_on_unit_stax and upper(ls_exempt) = "N" then
		if ai_mode = 1 then
			lds_local = create datastore
			lds_local.dataobject = this.id_detail.dataobject
			li_rtcode = lds_local.settransobject(this.it_transobject)
			li_rtcode = this.id_detail.rowscopy(1, this.id_detail.rowcount(), primary!, lds_local, 1, primary!)
			ll_counter = 1
			for ll_counter = 1 to lds_local.rowcount()
				ll_icode = lds_local.object.icode[ll_counter]
				ld_saleprice = lds_local.object.saleprice[ll_counter]
				ld_itemflatdisc = lds_local.object.itemflatdisc[ll_counter]
				ld_discperc = lds_local.object.discperc[ll_counter]
				ld_retailprice = lds_local.object.retailprice[ll_counter]
				if this.id_detail.object.taxflag[ll_counter] = 0 then
					lds_local.object.cloneitemflatdisc[ll_counter] = lds_local.object.itemflatdisc[ll_counter]
					lds_local.object.clonediscperc[ll_counter] = lds_local.object.discperc[ll_counter]
					lds_local.object.clonesaleprice[ll_counter] = ld_saleprice
				end if
				if ld_retailprice <= 0.0 or isnull(ld_retailprice) then
					ld_retailprice = ld_saleprice
				end if
				ll_taxflag = lds_local.object.taxflag[ll_counter]
				if ll_taxflag = 0 then
					SQL SELECT tax_applicable =ISNULL ( ( SELECT STS.Applicable FROM SalesTaxSchedule STS WHERE STS.SalesTaxScheduleCode =item.SalesTaxScheduleCode ) , 'N' ) , tax_perc =ISNULL ( ( SELECT STS.TaxPerc FROM SalesTaxSchedule STS WHERE STS.SalesTaxScheduleCode =item.SalesTaxScheduleCode ) , 0 ) , tax_type =ISNULL ( ( SELECT STS.TaxType FROM SalesTaxSchedule STS WHERE STS.SalesTaxScheduleCode =item.SalesTaxScheduleCode ) , 'S' ) INTO :lc_tax_applicable, :ld_tax_perc, :lc_tax_type FROM Item WHERE Item.ICode =:ll_icode USING this.it_transobject;
					if this.it_transobject.sqlcode = 0 then
						if lc_tax_applicable = "Y" then
							if lc_tax_type = "S" then
								ld_unitsaletax = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01) * ld_tax_perc * 0.01, 2)
								lds_local.object.unitsalestax[ll_counter] = ld_unitsaletax
								this.id_detail.object.unitsalestax[ll_counter] = ld_unitsaletax
							elseif lc_tax_type = "R" then
								ld_unitsaletax = round(ld_retailprice * ld_tax_perc * 0.01, 2)
								lds_local.object.unitsalestax[ll_counter] = ld_unitsaletax
								this.id_detail.object.unitsalestax[ll_counter] = ld_unitsaletax
							elseif lc_tax_type = "D" then
								ld_unitsaletax = round(ld_retailprice * ld_tax_perc * 0.01, 2)
								ld_netsaleprice = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2)
								lds_local.object.saleprice[ll_counter] = ld_netsaleprice - ld_unitsaletax
								lds_local.object.itemflatdisc[ll_counter] = 0.00
								lds_local.object.discperc[ll_counter] = 0.00
								lds_local.object.unitsalestax[ll_counter] = ld_unitsaletax
							elseif lc_tax_type = "E" then
								ld_unitsaletax = round(ld_retailprice * ld_tax_perc / (100.0 + ld_tax_perc), 2)
								ld_netsaleprice = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2)
								lds_local.object.saleprice[ll_counter] = ld_netsaleprice - ld_unitsaletax
								lds_local.object.itemflatdisc[ll_counter] = 0.00
								lds_local.object.discperc[ll_counter] = 0.00
								lds_local.object.unitsalestax[ll_counter] = ld_unitsaletax
							elseif lc_tax_type = "I" then
								ll_custcode = this.id_master.object.custcode[1]
								ld_saleprice = lds_local.object.saleprice[ll_counter]
								lds_local.object.saleprice[ll_counter] = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01) * 100.0 / (100.0 + ld_tax_perc), 2)
								lds_local.object.unitsalestax[ll_counter] = round(lds_local.object.saleprice[ll_counter] * ld_tax_perc * 0.01, 2)
								lds_local.object.itemflatdisc[ll_counter] = 0.00
								lds_local.object.discperc[ll_counter] = 0.00
							end if
							lds_local.object.taxflag[ll_counter] = 1
						end if
					else
						messagebox("Apply Sales Tax Schedule", "Problem faced in Applying Sales Tax Schedule on Saving.~r~nDetails are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
						return -1
					end if
					return
				end if
			next
			if wf_validate_price_discount_matters(1, al_usercode, lds_local) < 0 then
				return -1
			end if
		else
			ll_counter = 1
			for ll_counter = 1 to this.id_detail.rowcount()
				ll_icode = this.id_detail.object.icode[ll_counter]
				ld_saleprice = this.id_detail.object.saleprice[ll_counter]
				ld_itemflatdisc = this.id_detail.object.itemflatdisc[ll_counter]
				ld_discperc = this.id_detail.object.discperc[ll_counter]
				ld_retailprice = this.id_detail.object.retailprice[ll_counter]
				if this.id_detail.object.taxflag[ll_counter] = 0 then
					this.id_detail.object.cloneitemflatdisc[ll_counter] = this.id_detail.object.itemflatdisc[ll_counter]
					this.id_detail.object.clonediscperc[ll_counter] = this.id_detail.object.discperc[ll_counter]
					this.id_detail.object.clonesaleprice[ll_counter] = ld_saleprice
				end if
				if ld_retailprice <= 0.0 or isnull(ld_retailprice) then
					ld_retailprice = ld_saleprice
				end if
				ll_taxflag = this.id_detail.object.taxflag[ll_counter]
				if ll_taxflag = 0 then
					SQL SELECT tax_applicable =ISNULL ( ( SELECT STS.Applicable FROM SalesTaxSchedule STS WHERE STS.SalesTaxScheduleCode =item.SalesTaxScheduleCode ) , 'N' ) , tax_perc =ISNULL ( ( SELECT STS.TaxPerc FROM SalesTaxSchedule STS WHERE STS.SalesTaxScheduleCode =item.SalesTaxScheduleCode ) , 0 ) , tax_type =ISNULL ( ( SELECT STS.TaxType FROM SalesTaxSchedule STS WHERE STS.SalesTaxScheduleCode =item.SalesTaxScheduleCode ) , 'S' ) INTO :lc_tax_applicable, :ld_tax_perc, :lc_tax_type FROM Item WHERE Item.ICode =:ll_icode USING this.it_transobject;
					if this.it_transobject.sqlcode = 0 then
						if lc_tax_applicable = "Y" then
							if lc_tax_type = "S" then
								ld_unitsaletax = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01) * ld_tax_perc * 0.01, 2)
								this.id_detail.object.unitsalestax[ll_counter] = ld_unitsaletax
							elseif lc_tax_type = "R" then
								ld_unitsaletax = round(ld_retailprice * ld_tax_perc * 0.01, 2)
								this.id_detail.object.unitsalestax[ll_counter] = ld_unitsaletax
							elseif lc_tax_type = "D" then
								ld_unitsaletax = round(ld_retailprice * ld_tax_perc * 0.01, 2)
								ld_netsaleprice = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2)
								this.id_detail.object.saleprice[ll_counter] = ld_netsaleprice - ld_unitsaletax
								this.id_detail.object.itemflatdisc[ll_counter] = 0.00
								this.id_detail.object.discperc[ll_counter] = 0.00
								this.id_detail.object.unitsalestax[ll_counter] = ld_unitsaletax
							elseif lc_tax_type = "E" then
								ld_unitsaletax = round(ld_retailprice * ld_tax_perc / (100.0 + ld_tax_perc), 2)
								ld_netsaleprice = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2)
								this.id_detail.object.saleprice[ll_counter] = ld_netsaleprice - ld_unitsaletax
								this.id_detail.object.itemflatdisc[ll_counter] = 0.00
								this.id_detail.object.discperc[ll_counter] = 0.00
								this.id_detail.object.unitsalestax[ll_counter] = ld_unitsaletax
							elseif lc_tax_type = "I" then
								ll_custcode = this.id_master.object.custcode[1]
								ld_saleprice = this.id_detail.object.saleprice[ll_counter]
								this.id_detail.object.saleprice[ll_counter] = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01) * 100.0 / (100.0 + ld_tax_perc), 2)
								this.id_detail.object.unitsalestax[ll_counter] = round(this.id_detail.object.saleprice[ll_counter] * ld_tax_perc * 0.01, 2)
								this.id_detail.object.itemflatdisc[ll_counter] = 0.00
								this.id_detail.object.discperc[ll_counter] = 0.00
							end if
							this.id_detail.object.taxflag[ll_counter] = 1
						end if
					else
						messagebox("Apply Sales Tax Schedule", "Problem faced in Applying Sales Tax Schedule on Saving.~r~nDetails are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
						return -1
					end if
					return
				end if
			next
		end if
	end if
	this.id_detail.accepttext()
	wf_grandtotal()
	return 0

// w_postsale.wf_validate_price_discount_matters(integer ai_mode, long al_usercode, datastore ads_local) returns integer
	long ll_counter
	long ll_counter2
	long ll_icode
	long ll_custcode
	long ll_allowsalebelowavgprice
	long ll_masterrow
	string ls_consideralldiscountsonitem
	string ls_considerratechangeasdiscount
	double ld_invdiscperc
	double ld_flatdisc
	double ld_saleprice
	double ld_rate
	double ld_rpp
	double ld_discperc
	double ld_itemflatdisc
	double ld_unitsalestax
	double ld_itemgstperc
	double ld_invdisc
	double ld_invgstperc
	double ld_avgprice
	double ld_itemamount
	double ld_amountdiff
	double ld_clonesaleprice
	double ld_itemsalediscperc
	double ld_maxitemsalediscperc
	double ld_grossamt_rate_qty
	double ld_totaldiscount
	double ld_accumulateddiscperc
	double ld_qty
	double ld_actual_accumdiscperc
	double ld_accumdiscperccaution
	double ld_discgiven
	double ld_groupsaleitemdiscperc
	double ld_cloneflatdisc
	double ld_clonediscperc
	double ld_tempflatdisc
	double ld_tempdiscperc
	boolean lb_validdisc
	datastore lds_groupdiscinfo
	ls_considerratechangeasdiscount = f_stringpreferences("ConsiderRateChangeAsDiscount")
	if trim(ls_considerratechangeasdiscount) = "" or isnull(ls_considerratechangeasdiscount) then
		ls_considerratechangeasdiscount = "N"
	end if
	wf_grandtotal()
	lds_groupdiscinfo = create datastore
	lds_groupdiscinfo.dataobject = "d_groups_discount"
	lds_groupdiscinfo.settransobject(this.it_transobject)
	lds_groupdiscinfo.retrieve(al_usercode)
	ld_invdiscperc = this.id_footer.getitemnumber(1, "invdiscperc")
	ld_flatdisc = this.id_footer.getitemnumber(1, "flatdisc")
	lb_validdisc = false
	ll_masterrow = this.id_master.rowcount()
	for ll_counter = 1 to lds_groupdiscinfo.rowcount()
		ld_accumulateddiscperc = lds_groupdiscinfo.object.accumulateddiscperc[ll_counter]
		ld_accumdiscperccaution = lds_groupdiscinfo.object.accumdiscperccaution[ll_counter]
		ls_consideralldiscountsonitem = lds_groupdiscinfo.object.consideralldiscountsonitem[ll_counter]
		ld_groupsaleitemdiscperc = lds_groupdiscinfo.object.saleitemdiscperc[ll_counter]
		if ld_flatdisc <= lds_groupdiscinfo.object.saleinvflatdisc[ll_counter] then
			lb_validdisc = true
		end if
	next
	if lb_validdisc = false then
		messagebox("Flat Discount Validation", "Flat Discount is greater than your permission~r~n Please consult Administrator")
		this.id_footer.setfocus()
		this.id_footer.setcolumn("flatdisc")
		destroy lds_groupdiscinfo
		return -1
	end if
	ld_grossamt_rate_qty = 0
	ld_totaldiscount = 0
	ll_counter = 0
	for ll_counter = 1 to ads_local.rowcount()
		ll_icode = ads_local.getitemnumber(ll_counter, "icode")
		ld_qty = ads_local.getitemnumber(ll_counter, "looseqty")
		ld_saleprice = ads_local.getitemnumber(ll_counter, "saleprice")
		if ls_considerratechangeasdiscount = "Y" then
			ld_rate = ads_local.getitemnumber(ll_counter, "rate")
		else
			ld_rate = ld_saleprice
		end if
		ld_discperc = ads_local.getitemnumber(ll_counter, "discperc")
		ld_itemflatdisc = ads_local.getitemnumber(ll_counter, "itemflatdisc")
		ld_cloneflatdisc = ads_local.getitemnumber(ll_counter, "cloneitemflatdisc")
		ld_clonediscperc = ads_local.getitemnumber(ll_counter, "clonediscperc")
		if isnull(ld_cloneflatdisc) then
			ld_cloneflatdisc = 0.00
		end if
		if isnull(ld_clonediscperc) then
			ld_clonediscperc = 0.00
		end if
		ld_unitsalestax = ads_local.getitemnumber(ll_counter, "unitsalestax")
		ld_itemgstperc = ads_local.getitemnumber(ll_counter, "gstperc")
		ld_invdisc = this.id_footer.getitemnumber(1, "invdiscperc")
		ld_invgstperc = this.id_footer.getitemnumber(1, "invgstperc1")
		ld_avgprice = ads_local.getitemnumber(ll_counter, "avgprice")
		ld_itemamount = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2) - round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2) * ld_invdiscperc * 0.01
		ld_amountdiff = ld_rate - ld_itemamount
		ld_clonesaleprice = ld_rate
		if ld_clonesaleprice = 0.0 or isnull(ld_clonesaleprice) then
			ld_clonesaleprice = 1
		end if
		ll_custcode = this.id_master.object.custcode[1]
		wf_getitemdiscounts(ll_icode, ll_custcode, ld_itemsalediscperc, ld_maxitemsalediscperc)
		lb_validdisc = false
		if f_stringpreferences("FroceMaxSaleDiscPerc") = "Y" and round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2) > 0 then
			if ld_amountdiff * 100.0 / ld_clonesaleprice <= ld_maxitemsalediscperc then
				lb_validdisc = true
			end if
			if lb_validdisc = false then
				ld_discgiven = round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2)
				messagebox("Discount Validation", "Given Discount = " + trim(string(ld_discgiven, "###,###.##")) + "%~r~n" + "Maximun Sale Discount = " + trim(string(ld_maxitemsalediscperc, "###,###.##")) + "%~r~n~r~n" + "Given Discount Percentage is greater than Maximum Sale Discount Percentage for this item~r~n~r~n" + "Please consult Administrator", stopsign!)
				this.id_detail.setfocus()
				this.id_detail.setrow(ll_counter)
				this.id_detail.setcolumn("itemname")
				destroy lds_groupdiscinfo
				return -1
			end if
			return
		end if
		if f_stringpreferences("AllowSaleBelowRPP") = "N" and round(ld_rpp, 2) > round(ld_itemamount, 2) then
			messagebox("Price Validation", "Sale Price become less than RPP" + "~r~nNet Sale Price = " + string(round(ld_itemamount, 2), "###,###,##0.00") + "~r~nRPP = " + string(round(ld_rpp, 2), "###,###,##0.00") + "~r~nPlease Change Sale Price or Setting In Preferences", stopsign!)
			this.id_detail.setfocus()
			this.id_detail.setrow(ll_counter)
			this.id_detail.setcolumn("itemname")
			this.id_detail.scrolltorow(ll_counter)
			destroy lds_groupdiscinfo
			return -1
		end if
		if f_stringpreferences("saleavgpricecheck") = "N" and ll_allowsalebelowavgprice = 0 and round(ld_avgprice, 2) > round(ld_itemamount, 2) then
			messagebox("Price Validation", "Sale Price become Less Than Avg. Price" + "~r~nNet Sale Price = " + string(round(ld_itemamount, 2), "###,###,##0.00") + "~r~nAvg. Price = " + string(round(ld_avgprice, 2), "###,###,##0.00") + "~r~nPlease Change Sale Price or Setting In Preferences", stopsign!)
			this.id_detail.setfocus()
			this.id_detail.setrow(ll_counter)
			this.id_detail.setcolumn("itemname")
			this.id_detail.scrolltorow(ll_counter)
			destroy lds_groupdiscinfo
			return -1
		end if
		if f_stringpreferences("AllowSalePriceGreaterThanAvgPrice") = "N" and ll_allowsalebelowavgprice = 0 and round(ld_itemamount, 2) > round(ld_avgprice, 2) then
			messagebox("Price Validation", "Sale Price become Greater Than Avg. Price" + "~r~nNet Sale Price = " + string(round(ld_itemamount, 2), "###,###,##0.00") + "~r~nAvg. Price = " + string(round(ld_avgprice, 2), "###,###,##0.00") + "~r~nPlease Change Sale Price or Setting In Preferences", stopsign!)
			this.id_detail.setfocus()
			this.id_detail.setrow(ll_counter)
			this.id_detail.setcolumn("itemname")
			this.id_detail.scrolltorow(ll_counter)
			destroy lds_groupdiscinfo
			return -1
		end if
		lb_validdisc = false
		ll_counter2 = 0
		for ll_counter2 = 1 to lds_groupdiscinfo.rowcount()
			ls_consideralldiscountsonitem = lds_groupdiscinfo.object.consideralldiscountsonitem[ll_counter2]
			ld_groupsaleitemdiscperc = lds_groupdiscinfo.object.saleitemdiscperc[ll_counter2]
			ld_tempflatdisc = ld_cloneflatdisc
			ld_tempdiscperc = ld_clonediscperc
			if ld_discperc > ld_clonediscperc then
				ld_tempdiscperc = ld_discperc
			end if
			if ld_itemflatdisc > ld_cloneflatdisc then
				ld_tempflatdisc = ld_itemflatdisc
			end if
			if ls_consideralldiscountsonitem = "N" then
				ld_amountdiff = ld_rate - round(ld_saleprice * (1.0 - ld_discperc * 0.01) * (1.0 - ld_invdiscperc * 0.01), 2)
			else
				ld_amountdiff = ld_rate - round((ld_saleprice - ld_tempflatdisc) * (1.0 - ld_tempdiscperc * 0.01) * (1.0 - ld_invdiscperc * 0.01), 2)
			end if
			if round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2) <= ld_groupsaleitemdiscperc then
				lb_validdisc = true
			elseif round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2) <= ld_itemsalediscperc then
				lb_validdisc = true
			else
				lb_validdisc = false
			end if
		next
		if lb_validdisc = false then
			ld_discgiven = round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2)
			if isnull(ld_discgiven) then
				ld_discgiven = 0.00
			end if
			messagebox("Discount Validation ..", "Given Discount = " + trim(string(ld_discgiven, "###,##0.00")) + "%~r~n" + "Group Permission = " + trim(string(ld_groupsaleitemdiscperc, "###,##0.00")) + "%~r~n" + "Item Basic Data = " + trim(string(ld_itemsalediscperc, "###,##0.00")) + "%~r~n~r~n" + "So Given Discount Percentage is greater than your group permission and~r~n" + "Item Basicdata setting for Sale Discount~r~n~r~n" + "Please consult Administrator", stopsign!)
			this.id_detail.setfocus()
			this.id_detail.setrow(ll_counter)
			this.id_detail.setcolumn("itemname")
			destroy lds_groupdiscinfo
			return -1
		end if
	next
	destroy lds_groupdiscinfo
	if f_stringpreferences("ApplyAccumulatedDiscPerc") = "Y" then
		ld_totaldiscount = this.id_footer.object.totaldiscount[1]
		ld_grossamt_rate_qty = this.id_footer.object.grossforaccumdisc[1]
		ld_actual_accumdiscperc = round(this.id_footer.object.accumulateddiscperc[1], 2)
		if ld_actual_accumdiscperc > ld_accumulateddiscperc then
			messagebox("Accumulated Sales Discount %age Validation", "Accumulated Sales Discount %age is more than the allowed limit~r~nKindly Adjust Sales Discounts in this invoice to acceptable limits~r~n~r~nActual Accumulated Sales Invoice Discount  =" + trim(string(ld_actual_accumdiscperc, "###0.00")) + "%~r~nAllowed Accumulated Sales Invoice Discount   = " + trim(string(ld_accumulateddiscperc, "###0.00")) + "%", stopsign!, ok!)
			return -1
		end if
		if ld_actual_accumdiscperc >= ld_accumdiscperccaution and ld_actual_accumdiscperc - ld_accumdiscperccaution <> 0.0 and (this.id_master.object.custrefno2[1] = "" or isnull(this.id_master.object.custrefno2[1])) then
			messagebox("Accumulated Sales Discount %age Validation", "Accumulated Sales Discount %age is more than the allowed cautious limit~r~nKindly write reason for exceeding cautious limit in customer reference no. 2~r~n~r~nActual Accumulated Sales Invoice Discount  =" + trim(string(ld_actual_accumdiscperc, "###0.00")) + "%~r~nAllowed Accumulated Sales Invoice Discount Cautious Limit  = " + trim(string(ld_accumdiscperccaution, "###0.00")) + "%", stopsign!, ok!)
			return -1
		end if
		return
	end if
	return 0

// w_postsale.wf_validate_price_discount_matters(integer ai_mode, long al_usercode, datawindow adw_dw) returns long
	long ll_counter
	long ll_counter2
	long ll_icode
	long ll_custcode
	long ll_allowsalebelowavgprice
	long ll_masterrow
	string ls_consideralldiscountsonitem
	string ls_considerratechangeasdiscount
	string ls_itemgrouperror
	double ld_invdiscperc
	double ld_flatdisc
	double ld_saleprice
	double ld_rate
	double ld_rpp
	double ld_discperc
	double ld_itemflatdisc
	double ld_unitsalestax
	double ld_itemgstperc
	double ld_invdisc
	double ld_invgstperc
	double ld_avgprice
	double ld_itemamount
	double ld_amountdiff
	double ld_clonesaleprice
	double ld_itemsalediscperc
	double ld_maxitemsalediscperc
	double ld_grossamt_rate_qty
	double ld_totaldiscount
	double ld_accumulateddiscperc
	double ld_qty
	double ld_actual_accumdiscperc
	double ld_accumdiscperccaution
	double ld_discgiven
	double ld_groupsaleitemdiscperc
	double ld_cloneflatdisc
	double ld_clonediscperc
	double ld_tempflatdisc
	double ld_tempdiscperc
	boolean lb_validdisc
	datastore lds_groupdiscinfo
	ls_considerratechangeasdiscount = f_stringpreferences("ConsiderRateChangeAsDiscount")
	if trim(ls_considerratechangeasdiscount) = "" or isnull(ls_considerratechangeasdiscount) then
		ls_considerratechangeasdiscount = "N"
	end if
	wf_grandtotal()
	lds_groupdiscinfo = create datastore
	lds_groupdiscinfo.dataobject = "d_groups_discount"
	lds_groupdiscinfo.settransobject(this.it_transobject)
	lds_groupdiscinfo.retrieve(al_usercode)
	ld_invdiscperc = this.id_footer.getitemnumber(1, "invdiscperc")
	ld_flatdisc = this.id_footer.getitemnumber(1, "flatdisc")
	lb_validdisc = false
	ll_masterrow = this.id_master.rowcount()
	for ll_counter = 1 to lds_groupdiscinfo.rowcount()
		ld_accumulateddiscperc = lds_groupdiscinfo.object.accumulateddiscperc[ll_counter]
		ld_accumdiscperccaution = lds_groupdiscinfo.object.accumdiscperccaution[ll_counter]
		ls_consideralldiscountsonitem = lds_groupdiscinfo.object.consideralldiscountsonitem[ll_counter]
		ld_groupsaleitemdiscperc = lds_groupdiscinfo.object.saleitemdiscperc[ll_counter]
		if ld_flatdisc <= lds_groupdiscinfo.object.saleinvflatdisc[ll_counter] then
			lb_validdisc = true
		end if
	next
	if lb_validdisc = false then
		messagebox("Flat Discount Validation", "Flat Discount is greater than your permission~r~n Please consult Administrator")
		this.id_footer.setfocus()
		this.id_footer.setcolumn("flatdisc")
		destroy lds_groupdiscinfo
		return -1
	end if
	ld_grossamt_rate_qty = 0
	ld_totaldiscount = 0
	ll_counter = 0
	for ll_counter = 1 to adw_dw.rowcount()
		ll_icode = adw_dw.getitemnumber(ll_counter, "icode")
		ld_qty = adw_dw.getitemnumber(ll_counter, "looseqty")
		ld_saleprice = adw_dw.getitemnumber(ll_counter, "saleprice")
		if ls_considerratechangeasdiscount = "Y" then
			ld_rate = adw_dw.getitemnumber(ll_counter, "rate")
		else
			ld_rate = ld_saleprice
		end if
		ld_discperc = adw_dw.getitemnumber(ll_counter, "discperc")
		ld_itemflatdisc = adw_dw.getitemnumber(ll_counter, "itemflatdisc")
		ld_cloneflatdisc = adw_dw.getitemnumber(ll_counter, "cloneitemflatdisc")
		ld_clonediscperc = adw_dw.getitemnumber(ll_counter, "clonediscperc")
		if isnull(ld_cloneflatdisc) then
			ld_cloneflatdisc = 0.00
		end if
		if isnull(ld_clonediscperc) then
			ld_clonediscperc = 0.00
		end if
		ld_unitsalestax = adw_dw.getitemnumber(ll_counter, "unitsalestax")
		ld_itemgstperc = adw_dw.getitemnumber(ll_counter, "gstperc")
		ld_invdisc = this.id_footer.getitemnumber(1, "invdiscperc")
		ld_invgstperc = this.id_footer.getitemnumber(1, "invgstperc1")
		ld_avgprice = adw_dw.getitemnumber(ll_counter, "avgprice")
		ld_itemamount = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2) - round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2) * ld_invdiscperc * 0.01
		ld_amountdiff = ld_rate - ld_itemamount
		ld_clonesaleprice = ld_rate
		if ld_clonesaleprice = 0.0 or isnull(ld_clonesaleprice) then
			ld_clonesaleprice = 1
		end if
		ll_custcode = this.id_master.object.custcode[1]
		wf_getitemdiscounts(ll_icode, ll_custcode, ld_itemsalediscperc, ld_maxitemsalediscperc)
		lb_validdisc = false
		if f_stringpreferences("FroceMaxSaleDiscPerc") = "Y" and round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2) > 0 then
			if ld_amountdiff * 100.0 / ld_clonesaleprice <= ld_maxitemsalediscperc then
				lb_validdisc = true
			end if
			if lb_validdisc = false then
				ld_discgiven = round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2)
				messagebox("Discount Validation", "Given Discount = " + trim(string(ld_discgiven, "###,###.##")) + "%~r~n" + "Maximun Sale Discount = " + trim(string(ld_maxitemsalediscperc, "###,###.##")) + "%~r~n~r~n" + "Given Discount Percentage is greater than Maximum Sale Discount Percentage for this item~r~n~r~n" + "Please consult Administrator", stopsign!)
				adw_dw.setfocus()
				adw_dw.setrow(ll_counter)
				adw_dw.setcolumn("itemname")
				destroy lds_groupdiscinfo
				return -1
			end if
			return
		end if
		if f_stringpreferences("AllowSaleBelowRPP") = "N" and round(ld_rpp, 2) > round(ld_itemamount, 2) then
			messagebox("Price Validation", "Sale Price become less than RPP" + "~r~nNet Sale Price = " + string(round(ld_itemamount, 2), "###,###,##0.00") + "~r~nRPP = " + string(round(ld_rpp, 2), "###,###,##0.00") + "~r~nPlease Change Sale Price or Setting In Preferences", stopsign!)
			adw_dw.setfocus()
			adw_dw.setrow(ll_counter)
			adw_dw.setcolumn("itemname")
			adw_dw.scrolltorow(ll_counter)
			destroy lds_groupdiscinfo
			return -1
		end if
		if f_stringpreferences("saleavgpricecheck") = "N" and ll_allowsalebelowavgprice = 0 and round(ld_avgprice, 2) > round(ld_itemamount, 2) and wf_check_item_user_salebelowavgprice(ll_icode, al_usercode, ls_itemgrouperror) < 0 then
			messagebox("Price Validation", ls_itemgrouperror + "~r~nSale Price become Less Than Avg. Price" + "~r~nNet Sale Price = " + string(round(ld_itemamount, 2), "###,###,##0.00") + "~r~nAvg. Price = " + string(round(ld_avgprice, 2), "###,###,##0.00") + "~r~nPlease Change Sale Price or Setting In Preferences", stopsign!)
			adw_dw.setfocus()
			adw_dw.setrow(ll_counter)
			adw_dw.setcolumn("itemname")
			adw_dw.scrolltorow(ll_counter)
			destroy lds_groupdiscinfo
			return -1
		end if
		if f_stringpreferences("AllowSalePriceGreaterThanAvgPrice") = "N" and ll_allowsalebelowavgprice = 0 and round(ld_itemamount, 2) > round(ld_avgprice, 2) then
			messagebox("Price Validation", "Sale Price become Greater Than Avg. Price" + "~r~nNet Sale Price = " + string(round(ld_itemamount, 2), "###,###,##0.00") + "~r~nAvg. Price = " + string(round(ld_avgprice, 2), "###,###,##0.00") + "~r~nPlease Change Sale Price or Setting In Preferences", stopsign!)
			adw_dw.setfocus()
			adw_dw.setrow(ll_counter)
			adw_dw.setcolumn("itemname")
			adw_dw.scrolltorow(ll_counter)
			destroy lds_groupdiscinfo
			return -1
		end if
		lb_validdisc = false
		ll_counter2 = 0
		for ll_counter2 = 1 to lds_groupdiscinfo.rowcount()
			ls_consideralldiscountsonitem = lds_groupdiscinfo.object.consideralldiscountsonitem[ll_counter2]
			ld_groupsaleitemdiscperc = lds_groupdiscinfo.object.saleitemdiscperc[ll_counter2]
			ld_tempflatdisc = ld_cloneflatdisc
			ld_tempdiscperc = ld_clonediscperc
			if ld_discperc > ld_clonediscperc then
				ld_tempdiscperc = ld_discperc
			end if
			if ld_itemflatdisc > ld_cloneflatdisc then
				ld_tempflatdisc = ld_itemflatdisc
			end if
			if ls_consideralldiscountsonitem = "N" then
				ld_amountdiff = ld_rate - round(ld_saleprice * (1.0 - ld_discperc * 0.01) * (1.0 - ld_invdiscperc * 0.01), 2)
			else
				ld_amountdiff = ld_rate - round((ld_saleprice - ld_tempflatdisc) * (1.0 - ld_tempdiscperc * 0.01) * (1.0 - ld_invdiscperc * 0.01), 2)
			end if
			if round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2) <= ld_groupsaleitemdiscperc then
				lb_validdisc = true
			elseif round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2) <= ld_itemsalediscperc then
				lb_validdisc = true
			else
				lb_validdisc = false
			end if
		next
		if lb_validdisc = false then
			ld_discgiven = round(ld_amountdiff * 100.0 / ld_clonesaleprice, 2)
			if isnull(ld_discgiven) then
				ld_discgiven = 0.00
			end if
			messagebox("Discount Validation ..", "Given Discount = " + trim(string(ld_discgiven, "###,##0.00")) + "%~r~n" + "Group Permission = " + trim(string(ld_groupsaleitemdiscperc, "###,##0.00")) + "%~r~n" + "Item Basic Data = " + trim(string(ld_itemsalediscperc, "###,##0.00")) + "%~r~n~r~n" + "So Given Discount Percentage is greater than your group permission and~r~n" + "Item Basicdata setting for Sale Discount~r~n~r~n" + "Please consult Administrator", stopsign!)
			adw_dw.setfocus()
			adw_dw.setrow(ll_counter)
			adw_dw.setcolumn("itemname")
			destroy lds_groupdiscinfo
			return -1
		end if
	next
	destroy lds_groupdiscinfo
	if f_stringpreferences("ApplyAccumulatedDiscPerc") = "Y" then
		ld_totaldiscount = this.id_footer.object.totaldiscount[1]
		ld_grossamt_rate_qty = this.id_footer.object.grossforaccumdisc[1]
		ld_actual_accumdiscperc = round(this.id_footer.object.accumulateddiscperc[1], 2)
		if ld_actual_accumdiscperc > ld_accumulateddiscperc then
			messagebox("Accumulated Sales Discount %age Validation", "Accumulated Sales Discount %age is more than the allowed limit~r~nKindly Adjust Sales Discounts in this invoice to acceptable limits~r~n~r~nActual Accumulated Sales Invoice Discount  =" + trim(string(ld_actual_accumdiscperc, "###0.00")) + "%~r~nAllowed Accumulated Sales Invoice Discount   = " + trim(string(ld_accumulateddiscperc, "###0.00")) + "%", stopsign!, ok!)
			return -1
		end if
		if ld_actual_accumdiscperc >= ld_accumdiscperccaution and ld_actual_accumdiscperc - ld_accumdiscperccaution <> 0.0 and (this.id_master.object.custrefno2[1] = "" or isnull(this.id_master.object.custrefno2[1])) then
			messagebox("Accumulated Sales Discount %age Validation", "Accumulated Sales Discount %age is more than the allowed cautious limit~r~nKindly write reason for exceeding cautious limit in customer reference no. 2~r~n~r~nActual Accumulated Sales Invoice Discount  =" + trim(string(ld_actual_accumdiscperc, "###0.00")) + "%~r~nAllowed Accumulated Sales Invoice Discount Cautious Limit  = " + trim(string(ld_accumdiscperccaution, "###0.00")) + "%", stopsign!, ok!)
			return -1
		end if
		return
	end if
	return 0

// w_postsale.wf_check_item_user_salebelowavgprice(long al_icode, long al_usercode, string as_errortext) returns long
	string ls_itemright
	string ls_groupright
	SQL SELECT ItemRight =I.ItemRight , GroupRight =CASE WHEN G.GroupRight =0 THEN 'N' ELSE 'Y' END INTO :ls_itemright, :ls_groupright FROM ( SELECT ItemRight =MAX ( AllowSalePriceBelowAvgPrice ) FROM Item WHERE ICode =:al_icode ) I , ( SELECT GroupRight =ISNULL ( COUNT ( RightCode ) , 0 ) FROM GroupRights WHERE RightCode =1797 AND GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:al_usercode ) ) G USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if upper(ls_itemright) = "Y" and upper(ls_groupright) = "Y" then
			return 0
		else
			if ls_itemright = "N" then
				as_errortext = "Item Right Not Allowed To Sale Below Avg. Price"
				return -1
			end if
			if ls_groupright = "N" then
				as_errortext = "User/Group Not Allowed To Sale Below Avg. Price"
				return -1
			end if
		end if
		return
	end if
	as_errortext = "Database Error While Implementing Sale Price Below Avg. Price (Item and Group Right)"
	return -1

// w_postsale.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_posmenu" then
		this.menuid = create m_posmenu
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	this.dw_saleinvdetail = create dw_saleinvdetail
	this.ic_comport = create ic_comport
	this.ic_drawerport = create ic_drawerport
	this.dw_holdpostsaledetail = create dw_holdpostsaledetail
	this.dw_assocsaleinvlist = create dw_assocsaleinvlist
	this.ole_lcddisplay = create ole_lcddisplay
	this.dw_document = create dw_document
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.dw_saleinvdetail
	this.control[icurrent + 3] = this.ic_comport
	this.control[icurrent + 4] = this.ic_drawerport
	this.control[icurrent + 5] = this.dw_holdpostsaledetail
	this.control[icurrent + 6] = this.dw_assocsaleinvlist
	this.control[icurrent + 7] = this.ole_lcddisplay
	this.control[icurrent + 8] = this.dw_document

// w_postsale.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.dw_saleinvdetail
	destroy this.ic_comport
	destroy this.ic_drawerport
	destroy this.dw_holdpostsaledetail
	destroy this.dw_assocsaleinvlist
	destroy this.ole_lcddisplay
	destroy this.dw_document

// w_postsale.ue_save() returns 0 [event]
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_custcode
	long ll_salesmancode
	long ll_gcode
	long ll_headerno
	long ll_headerinvno
	long ll_counter
	long ll_count
	long ll_found
	long ll_null
	long ll_dummyinvcode
	long ll_contactcardcode
	boolean lb_commitflag
	boolean lb_continue
	boolean lb_isnewinv
	integer li_counter
	integer li_filehandle
	integer li_maxretcode
	integer li_salecatcode
	string ls_errtext
	string ls_holdstring
	string ls_drawermessage
	string ls_altersaleinvcounter
	string ls_cashtend
	string ls_invtotal
	string ls_invlist
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_misccharges1
	double ld_misccharges2
	double ld_misccharges3
	double ld_misccharges4
	double ld_misccharges5
	double ld_invamount
	double ld_ret_total
	double ld_cashtended
	double ld_cashbalance
	double ld_invgstperc1
	double ld_price
	double ld_commissionperunit
	double ld_commissionperc
	s_salesman lstr_salesman
	double ld_stock
	double ld_newstock
	double ld_salelooseqty
	double ld_balance
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	datetime ldt_server_datetime
	string ls_date_errtext
	char lc_printbalance
	char ls_posted
	datawindowchild ldc_headerno
	s_cashierwindow ls_cashierwindow
	s_dw_header lstr_header
	string ls_env_name
	string ls_env_val
	long ll_env_len
	this.ib_lcdshow = false
	lc_printbalance = "Y"
	setnull(ll_contactcardcode)
	setnull(ll_null)
	if this.id_master.object.selectcustomer[1] <> "N" then
		if this.id_master.object.custcode[1] = 19 then
			messagebox("Validation Error", "Please select some customer from DropDown box")
			this.id_master.setcolumn("custcode")
			this.id_master.setfocus()
			return
		end if
	end if
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		return
	end if
	wf_deleteemptydetailrow()
	if this.id_detail.rowcount() <= 0 then
		return
	end if
	ll_contactcardcode = this.id_master.object.contactcardcode[1]
	if f_stringpreferences("AskContactCardForSMS") = "Y" then
		openwithparm(w_contactcard_quick, ll_contactcardcode)
		ll_contactcardcode = message.doubleparm
		if ll_contactcardcode > 0 then
			this.id_master.object.contactcardcode[1] = ll_contactcardcode
		else
			this.id_master.object.contactcardcode[1] = ll_null
		end if
	end if
	for ll_counter = 1 to this.id_detail.rowcount()
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		SQL SELECT commissionperunit , commissionperc INTO :ld_commissionperunit, :ld_commissionperc FROM Item WHERE item.icode =:ll_icode USING this.it_transobject;
		if this.it_transobject.sqlcode < 0 then
			messagebox("Connection Error", "Unable to get item information " + this.it_transobject.sqlerrtext)
			return
		end if
		this.id_detail.setitem(ll_counter, "CommissionPerUnit", ld_commissionperunit)
		this.id_detail.setitem(ll_counter, "CommissionPerc", ld_commissionperc)
	next
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	if f_stringpreferences("ForceBonusPolicyOnSavingSale") = "Y" and wf_apply_bonuspolicy(1) <= 0 then
		messagebox("Bonus Policy Implementation", "Problem in Applying Bonus Policy on Saving")
		return
	end if
	if f_stringpreferences("ForceDiscPolicyOnSavingSale") = "Y" and wf_apply_discountpolicy(1) <= 0 then
		messagebox("Discount Policy Implementation", "Problem in Applying Discount Policy on Saving")
		return
	end if
	if f_stringpreferences("SaleOnZeroPrice") = "N" then
		ll_found = this.id_detail.find("saleprice = 0 OR ISNull(saleprice)", 1, this.id_detail.rowcount())
		if ll_found > 0 then
			messagebox("Price Validation", "SalePrice is Zero in Row " + string(ll_found))
			this.id_detail.setfocus()
			this.id_detail.scrolltorow(ll_found)
			this.id_detail.setcolumn("SalePrice")
			return
		end if
		return
	end if
	ll_found = this.id_detail.find("looseqty + bonusqty <= 0 ", 1, this.id_detail.rowcount())
	if ll_found > 0 then
		messagebox("Sale Qty Validation", "Please Enter Valid Sale Qty in Row " + string(ll_found))
		this.id_detail.setfocus()
		this.id_detail.scrolltorow(ll_found)
		this.id_detail.setcolumn("looseqty")
		return
	end if
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if f_stringpreferences("ForcePricePolicyOnSavingSale") = "Y" and wf_apply_pricepolicy(1) <= 0 then
		messagebox("Price Policy Implementation", "Problem in Applying Item Price Policy on Saving")
		return
	end if
	if wf_apply_saleinvoice_discountpolicy() < 0 then
		return
	end if
	if wf_autoredeemloyaltypointsasdiscount(1) < 0 then
		return
	end if
	if f_stringpreferences("autoapplymiscchargesperc_on_saving") = "Y" then
	end if
	wf_grandtotal()
	this.id_footer.accepttext()
	this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
	ld_ret_total = this.id_footer.getitemnumber(1, "salereturnamt")
	if isnull(ld_ret_total) then
		ld_ret_total = 0.00
	end if
	if f_stringpreferences("DisplayPool") = "Y" then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
			this.is_lcditem = "SALES  = " + string(wf_grandtotal(), "#######0.00")
			this.is_lcditem2 = "NET AMT= " + string(wf_grandtotal() - ld_ret_total, "#######0.00")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
			this.ole_lcddisplay.object.__invoke_method("showtotal", 1, {string(wf_grandtotal() - ld_ret_total, "########0.00")}, true)
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "TYSSO VFD-860-A" then
			this.is_lcditem = "NO OF ITEM=" + space(9 - len(string(this.id_detail.rowcount(), "####0"))) + string(this.id_detail.rowcount(), "####0") + "BILL TOTAL=" + space(9 - len(string(wf_grandtotal() - ld_ret_total, "#####0.00"))) + string(wf_grandtotal() - ld_ret_total, "#####0.00")
			this.is_lcditem = left(this.is_lcditem, 40)
			this.ic_comport.triggerevent("ue_show")
		else
			this.is_lcditem = "TOTAL = " + string(wf_grandtotal() - ld_ret_total, "########0.00")
			this.is_lcditem = this.is_lcditem + space(39 - len(this.is_lcditem))
			this.is_lcditem = left(this.is_lcditem, 39)
		end if
		this.ic_comport.triggerevent("ue_show")
	end if
	if this.ib_assocsaleinvlist then
		if this.ib_modify then
			this.id_assocsaleinvlist.retrieve(this.id_master.object.code[1])
			lstr_header.l_code = this.id_master.object.code[1]
		else
			this.id_assocsaleinvlist.reset()
		end if
		lstr_header.dw_header = this.id_assocsaleinvlist
		lstr_header.t_transobject = this.it_transobject
		lstr_header.b_modifystatus = this.ib_modify
		openwithparm(w_assocsaleinvlist_form, lstr_header)
		lstr_header = message.powerobjectparm
		if lstr_header.i_closemode = -1 then
			return
		end if
		return
	end if
	if wf_set_cashaccount() = 0 then
		return
	end if
	if f_stringpreferences("ApplySalesTaxOnSavingBeforeUserPwd") = "Y" then
		if wf_apply_salestaxschedule_on_saving(0, gl_usercode) < 0 then
			return
		end if
		if wf_validate_price_discount_matters(0, gl_usercode, this.id_detail) < 0 then
			return
		end if
		return
	end if
	wf_grandtotal()
	if f_stringpreferences("POSSaleSalesmanWindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if f_stringpreferences("ApplySalesTaxOnSavingBeforeUserPwd") = "N" then
			if wf_apply_salestaxschedule_on_saving(1, ll_salesmancode) < 0 then
				return
			end if
		elseif wf_validate_price_discount_matters(0, ll_salesmancode, this.id_detail) < 0 then
			return
		end if
		if wf_check_cashiershift_on_saving(this.id_master.object.cashiershiftcode[1], ll_salesmancode) < 0 then
			return
		end if
		if wf_checkdueright(ll_salesmancode) = 0 then
			return
		end if
		if wf_show_mastercashierwindow(0) = 0 then
			return
		end if
		if this.ii_saletype = 3 and f_stringpreferences("CashierWindowOnPOS") = "Y" and f_stringpreferences("askmastercashwin_in_possale") = "N" then
			ld_ret_total = this.id_footer.getitemnumber(1, "salereturnamt")
			if isnull(ld_ret_total) then
				ld_ret_total = 0.00
			end if
			wf_grandtotal()
			ld_invamount = this.id_footer.getitemnumber(1, "total") - ld_ret_total
			wf_getassocsaleinvlisttotal(ld_invamount)
			if this.id_master.object.selectcustomer[1] = "N" then
				ls_cashierwindow.l_custcode = this.id_master.getitemnumber(1, "custcode")
				ls_cashierwindow.d_invamt = ld_invamount
				openwithparm(w_salesmanpassword_invtype, ls_cashierwindow)
				setfocus()
				lstr_salesman = message.powerobjectparm
				if lstr_salesman.l_salesmancode < 1 then
					return
				end if
				if lstr_salesman.b_lcd_flag then
					ld_cashtended = lstr_salesman.d_cashtended
					ld_cashbalance = lstr_salesman.d_cashbalance
					this.id_footer.object.t_balance.text = string(ld_cashbalance, "########0.00")
					if f_stringpreferences("DisplayPool") = "Y" then
						if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
							this.is_lcditem = "Cash    :" + string(ld_cashtended, "#######0.00")
							this.is_lcditem2 = "Balance :" + string(ld_cashbalance, "#######0.00")
							this.ic_comport.triggerevent("ue_show")
						elseif upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
							ls_cashtend = string(ld_cashtended, "#######0.00")
							ls_invtotal = string(ld_invamount, "########0.00")
							this.ole_lcddisplay.object.__invoke_method("showcashtender", 2, {ls_invtotal, ls_cashtend}, true)
						elseif upper(f_stringpreferences("DisplayPoolCompany")) = "TYSSO VFD-860-A" then
							ls_cashtend = string(ld_cashtended, "#####0.00")
							ls_invtotal = string(ls_invtotal, "#####0.00")
							this.is_lcditem = "CASH" + space(6) + "=" + space(9 - len(ls_cashtend)) + ls_cashtend
							ls_holdstring = "BALANCE" + space(3) + "=" + space(9 - len(string(ld_cashbalance, "#####0.00"))) + string(ld_cashbalance, "#####0.00")
							this.is_lcditem = this.is_lcditem + ls_holdstring
							this.is_lcditem = left(this.is_lcditem, 40)
							this.ic_comport.triggerevent("ue_show")
						else
							this.is_lcditem = "Cash   ="
							ls_holdstring = string(ld_cashtended, "########0.00")
							if len(ls_holdstring) < 12 then
								ls_holdstring = ls_holdstring + space(12 - len(ls_holdstring))
							else
								ls_holdstring = left(ls_holdstring, 12)
							end if
							this.is_lcditem = this.is_lcditem + ls_holdstring
							ls_holdstring = string(ld_cashbalance, "########0.00")
							if len(ls_holdstring) < 12 then
								ls_holdstring = ls_holdstring + space(12 - len(ls_holdstring))
							else
								ls_holdstring = left(ls_holdstring, 12)
							end if
							this.is_lcditem = this.is_lcditem + "Balance=" + ls_holdstring
							this.is_lcditem = left(this.is_lcditem, 39)
							this.is_lcditem = this.is_lcditem + space(39 - len(this.is_lcditem))
							this.ic_comport.triggerevent("ue_show")
						end if
					end if
					if f_stringpreferences("CashDrawer") = "Y" then
						this.ic_drawerport.object.portopen = true
						this.ic_drawerport.object.output = "A"
						this.ic_drawerport.object.portopen = false
					end if
				else
					this.id_master.object.selectcustomer[1] = "Y"
					this.id_master.object.custcode[1] = lstr_salesman.l_custcode
					this.id_footer.object.t_balance.text = "0.00"
					this.ib_lcdshow = true
				end if
			else
				this.id_footer.object.t_balance.text = "0.00"
				this.ib_lcdshow = true
			end if
		end if
		if f_stringpreferences("ApplySalesTaxOnSavingBeforeUserPwd") = "N" then
			if wf_apply_salestaxschedule_on_saving(0, ll_salesmancode) < 0 then
				return
			end if
			if wf_validate_price_discount_matters(0, ll_salesmancode, this.id_detail) < 0 then
				return
			end if
			return
		end if
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		ls_posted = this.id_master.object.posted[ll_mastercurrrow]
		if isnull(ll_invid) then
			lb_isnewinv = true
			li_maxretcode = wf_tabnewid("saleledger", ll_invid)
			if li_maxretcode <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in generating InvCode")
				return
			end if
			return
		end if
		if this.ib_assocsaleinvlist then
			for ll_counter = 1 to this.id_assocsaleinvlist.rowcount()
				this.id_assocsaleinvlist.object.saleinvcode[ll_counter] = ll_invid
			next
		end if
		this.id_master.getchild("headerno", ldc_headerno)
		if f_stringpreferences("Headeronsaleinv") = "N" then
			this.id_master.setitem(ll_mastercurrrow, "Headerno", ldc_headerno.getitemnumber(ll_mastercurrrow, "code"))
			ll_headerno = ldc_headerno.getitemnumber(ll_mastercurrrow, "code")
			ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
			if isnull(ll_headerinvno) then
				f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
				if ll_headerinvno > 0 then
					this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
				end if
			end if
		end if
		if f_stringpreferences("Headeronsaleinv") = "Y" or gs_company = "SA" or gs_company = "EPP" then
			ll_headerno = this.id_master.getitemnumber(ll_mastercurrrow, "headerno")
			ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
			if isnull(ll_headerinvno) then
				f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
				if ll_headerinvno > 0 then
					this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
				end if
			end if
		end if
		ld_misccharges = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges")
		ld_misccharges1 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges1")
		ld_misccharges2 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges2")
		ld_misccharges3 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges3")
		ld_misccharges4 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges4")
		ld_misccharges5 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges5")
		ld_invdiscperc = this.id_footer.getitemnumber(ll_footercurrrow, "invdiscperc")
		ld_flatdisc = this.id_footer.getitemnumber(ll_footercurrrow, "flatdisc")
		ld_salestax = this.id_footer.getitemnumber(ll_footercurrrow, "salestax")
		ld_invgstperc1 = this.id_footer.getitemnumber(ll_footercurrrow, "InvGSTPerc1")
		this.id_master.setitem(ll_mastercurrrow, "discperc", ld_invdiscperc)
		this.id_master.setitem(ll_mastercurrrow, "flatdisc", ld_flatdisc)
		this.id_master.setitem(ll_mastercurrrow, "misccharges", ld_misccharges)
		this.id_master.object.misccharges1[ll_mastercurrrow] = ld_misccharges1
		this.id_master.object.misccharges2[ll_mastercurrrow] = ld_misccharges2
		this.id_master.object.misccharges3[ll_mastercurrrow] = ld_misccharges3
		this.id_master.object.misccharges4[ll_mastercurrrow] = ld_misccharges4
		this.id_master.object.misccharges5[ll_mastercurrrow] = ld_misccharges5
		this.id_master.setitem(ll_mastercurrrow, "salestax", ld_salestax)
		this.id_master.setitem(ll_mastercurrrow, "InvGSTPerc1", ld_invgstperc1)
		ls_env_name = "COMPUTERNAME"
		ls_env_val = space(20)
		ll_env_len = 20
		ll_env_len = getenvironmentvariablea(ls_env_name, ls_env_val, ll_env_len)
		this.id_master.setitem(ll_mastercurrrow, "machinename", ls_env_val)
		if f_stringpreferences("askmastercashwin_in_possale") = "N" then
			if this.id_master.object.selectcustomer[ll_mastercurrrow] = "Y" then
				this.id_master.setitem(1, "salecatcode", 2)
				this.id_master.setitem(ll_mastercurrrow, "cashreceived", lstr_salesman.d_cashtended)
				this.id_master.object.cashtendered[ll_mastercurrrow] = 0
				this.id_master.object.cashcharged[ll_mastercurrrow] = 0
				this.id_master.object.cashback[ll_mastercurrrow] = 0
				if this.id_master.object.srbufferinvcode[ll_mastercurrrow] > 0 then
					lstr_salesman.l_custcode = this.id_master.object.custcode[ll_mastercurrrow]
					if wf_save_salereturnascredit(this.id_master.object.srbufferinvcode[ll_mastercurrrow], lstr_salesman.l_custcode) = false then
						return
					end if
					this.id_master.setitem(1, "custcode", lstr_salesman.l_custcode)
				end if
				this.ib_printout = false
			else
				this.id_master.setitem(ll_mastercurrrow, "cashreceived", lstr_salesman.d_cashtended)
				this.id_master.object.cashtendered[ll_mastercurrrow] = this.id_master.object.cashreceived[ll_mastercurrrow]
				this.id_master.object.cashcharged[ll_mastercurrrow] = this.id_master.object.invtotal[ll_mastercurrrow]
				if this.id_master.object.cashtendered[ll_mastercurrrow] - this.id_master.object.cashcharged[ll_mastercurrrow] >= 0 then
					this.id_master.object.cashback[ll_mastercurrrow] = this.id_master.object.cashtendered[ll_mastercurrrow] - this.id_master.object.cashcharged[ll_mastercurrrow]
				else
					this.id_master.object.cashback[ll_mastercurrrow] = 0
				end if
				if this.id_master.object.selectcustomer[1] = "N" then
					this.id_master.setitem(1, "salecatcode", 3)
				else
					this.id_master.setitem(1, "salecatcode", 2)
				end if
				if this.id_master.object.salecatcode[1] <> 3 then
					this.id_master.setitem(ll_mastercurrrow, "cashreceived", lstr_salesman.d_cashtended)
					this.id_master.object.cashtendered[ll_mastercurrrow] = 0
					this.id_master.object.cashcharged[ll_mastercurrrow] = 0
					this.id_master.object.cashback[ll_mastercurrrow] = 0
					if wf_save_salereturnascredit(this.id_master.object.srbufferinvcode[ll_mastercurrrow], lstr_salesman.l_custcode) = false then
						return
					end if
					this.id_master.setitem(1, "custcode", lstr_salesman.l_custcode)
					SQL Select printbalance INTO :lc_printbalance FROM customer WHERE customer.custcode =:lstr_salesman.l_custcode USING this.it_transobject;
					if this.it_transobject.sqlcode <> 0 then
						messagebox("Database problem", "Unable to get Print Balance value~r~nfor selected customer")
						return
					end if
					this.id_master.setitem(1, "printbalance", lc_printbalance)
					this.ib_printout = false
				end if
			end if
		else
			this.id_master.object.cashreceived[ll_mastercurrrow] = this.id_master.object.cashtendered[ll_mastercurrrow]
			this.id_footer.object.t_balance.text = string(ld_cashbalance, "########0.00")
			if this.id_master.object.cashcharged[ll_mastercurrrow] <> this.id_master.object.invtotal[ll_mastercurrrow] or this.ids_cashwin.rowcount() > 0 then
				this.id_master.setitem(1, "salecatcode", 2)
				this.ib_printout = false
			end if
		end if
		this.id_master.accepttext()
		if lb_isnewinv then
			if f_stringpreferences("AutoMonthSaleInvCode") = "Y" then
				if this.it_transobject.updatesaleledgerdummycounter() = -1 then
					SQL rollback USING this.it_transobject;
					messagebox("DataBase Problem", "Reasons:~r~n" + this.it_transobject.sqlerrtext)
					return
				end if
			elseif this.it_transobject.updatesaleledgerdummycounter2() = -1 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Reasons:~r~n" + this.it_transobject.sqlerrtext)
				return
			end if
			if f_stringpreferences("SepSaleInvCounterForCashCredit") = "Y" then
				li_salecatcode = this.id_master.getitemnumber(1, "salecatcode")
				if li_salecatcode = 3 then
					ls_altersaleinvcounter = "saleledgercashdummy"
				else
					ls_altersaleinvcounter = "saleledgercreditdummy"
				end if
			else
				ls_altersaleinvcounter = "saleledgercashdummy"
			end if
			li_maxretcode = wf_tabnewid(ls_altersaleinvcounter, ll_dummyinvcode)
			if li_maxretcode <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~n ~t~t~t~t~t~t~t~t~t~t~t~t~tgenerating alternate InvCode.")
				return
			end if
			if ll_dummyinvcode > 0 then
				this.id_master.setitem(ll_mastercurrrow, "altersaleinvcode", ll_dummyinvcode)
			end if
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
		end if
		choose case this.ii_saletype
		case 3
			if this.id_master.object.salecatcode[1] = 3 then
				if f_stringpreferences("RetailSalePosting") = "N" then
					this.id_master.setitem(ll_mastercurrrow, "Posted", "N")
				end if
			elseif f_stringpreferences("CreditSalePosting") = "N" then
				this.id_master.setitem(ll_mastercurrrow, "Posted", "N")
			end if
		case 2
			if f_stringpreferences("CreditSalePosting") = "N" then
				this.id_master.setitem(ll_mastercurrrow, "Posted", "N")
			end if
		end choose
		if this.id_master.object.salecatcode[1] <> 3 and f_stringpreferences("SaveBalanceOnSalePosting") = "Y" then
			SQL rollback USING sqlca;
			ld_balance = 0
			sqlca.openingbalance(ll_custcode, ldt_server_datetime, ld_balance)
			if sqlca.sqlcode = 0 then
				this.id_master.setitem(ll_mastercurrrow, "balance", ld_balance)
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
				messagebox("Balance Saving Problem", "Unable to save balance on sales posting.")
				return
			end if
			return
		end if
		if this.ib_modify then
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			if f_stringpreferences("PreserveSaleInvHistory") = "Y" then
				if f_generatesaleslog(ll_invid, ldt_server_datetime, this.it_transobject) = 0 then
					lb_continue = true
				else
					messagebox("Sales History!", "Failure in Saving Sales Invoice History!.")
					return
				end if
				return
			end if
			if lb_continue then
				this.ids_invoiceinfo.retrieve(ll_invid)
				for ll_count = 1 to this.id_detail.rowcount()
					ll_icode = this.id_detail.getitemnumber(ll_count, "icode")
					ll_gcode = this.id_detail.getitemnumber(ll_count, "gcode")
					for ll_counter = 1 to this.ids_invoiceinfo.rowcount()
						if ll_icode = this.ids_invoiceinfo.getitemnumber(ll_counter, "icode") and (not isnull(this.ids_invoiceinfo.getitemstring(ll_counter, "due")) and not isnull(this.id_detail.getitemstring(ll_count, "Due"))) and this.id_detail.getitemnumber(ll_count, "Dueqty") = 0.0 then
							this.id_detail.setitem(ll_count, "Due", "D")
							this.id_detail.setitem(ll_count, "Dueqty", this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty"))
						end if
					next
				next
				lb_continue = wf_returnsaleinvoice(ll_invid, ls_errtext)
			end if
		else
			this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "billingdate", ldt_server_datetime)
		end if
		if lb_continue then
			this.id_saleinvdetail.reset()
			if not wf_populatesaledetail(ll_invid, this.id_saleinvdetail, ls_errtext, ll_errrowid) then
				lb_continue = false
				this.id_detail.scrolltorow(ll_errrowid)
				this.id_detail.setfocus()
			else
				wf_setoutstandingamount()
				this.id_detail = this.id_saleinvdetail
				ls_posted = this.id_master.object.posted[ll_mastercurrrow]
				event ue_save_current()
				this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
				this.id_saleinvdetail.reset()
				if this.ib_commitok then
					this.ib_modify = false
				elseif this.ib_modify = false then
					setnull(ll_null)
					this.id_master.setitem(1, "Code", ll_null)
					this.id_master.accepttext()
					lb_continue = false
				end if
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			if this.ib_modify = false then
				setnull(ll_null)
				this.id_master.setitem(1, "Code", ll_null)
				this.id_master.accepttext()
			end if
			messagebox("Updation Error", ls_errtext + " in row " + string(ll_errrowid), stopsign!)
		else
			if f_stringpreferences("IncSaleInActMonitor") = "Y" then
				this.it_transobject.updateactivitymonitor("SV", ll_invid)
				if this.it_transobject.sqlcode <> 0 then
					SQL rollback USING this.it_transobject;
					messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
				else
					SQL commit USING this.it_transobject;
				end if
			end if
			if f_stringpreferences("ShowPOSInCashierActivity") = "Y" then
				this.it_transobject.updatecashieractivity(this.ii_module, ll_invid)
				if this.it_transobject.sqlcode <> 0 then
					SQL rollback USING this.it_transobject;
					messagebox("Activity Monitor", "Problem in updating cashier activity.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
				else
					SQL commit USING this.it_transobject;
				end if
			end if
			if ls_posted = "Y" and f_stringpreferences("autoredeemloyaltypointsasredemptiondiscperc") = "Y" and this.il_pointsredeemed > 0 and this.id_redemptionvalue > 0.0 then
				this.it_transobject.autoloyaltyredemption(ll_custcode, this.il_pointsredeemed, this.id_redemptionvalue, ll_invid, "SV", ll_salesmancode)
				if this.it_transobject.sqlcode <> 0 then
					ls_errtext = "Problem in Generating Auto Loyalty Redemption.~r~nReasons are:- " + this.it_transobject.sqlerrtext
					SQL rollback USING this.it_transobject;
					messagebox("Auto Loyalty Redemption", ls_errtext)
				else
					SQL commit USING this.it_transobject;
				end if
			end if
			if gs_allowsmsfunctions = "Y" and ls_posted = "Y" then
				ls_invlist = trim(string(ll_invid))
				this.it_transobject.createautotriggersms(ls_invlist, this.ii_module, "Posting")
				if this.it_transobject.sqlcode <> 0 then
					ls_errtext = "Problem in Generating Auto Triggered SMS.~r~nReasons are:- " + this.it_transobject.sqlerrtext
					SQL rollback USING this.it_transobject;
					messagebox("Auto Triggered SMS", ls_errtext)
				else
					SQL commit USING this.it_transobject;
				end if
			end if
			if f_stringpreferences("AutoFiscalizeOnPosting") = "Y" and ls_posted = "Y" then
				f_fiscalizesaleinvoice(ll_invid)
			end if
			if f_stringpreferences("ApplyLoyaltypolicyonsaleposting") = "Y" and ls_posted = "Y" then
				this.it_transobject.manageloyaltypoints("SV", ll_invid)
				if this.it_transobject.sqlcode <> 0 then
					ls_errtext = "Problem in updating loyalty points for this account.~r~nReasons are:- " + this.it_transobject.sqlerrtext
					SQL rollback USING this.it_transobject;
					messagebox("Loyalty Points Updation", ls_errtext)
				else
					SQL commit USING this.it_transobject;
				end if
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_postsale.ue_newform() returns 0 [event]
	integer rtncode
	integer li_defaultgcode
	integer li_ismodifysaleprice
	integer li_ismodifyitemdiscperc
	integer li_ismodifyitemflatdisc
	integer li_modifysalestax
	integer li_viewstock
	integer li_viewtotalstock
	long li_fetched_code
	long row
	long ll_manfcode
	long ll_counter
	long ll_custcode
	string ls_custcode
	call super::ue_newform
	if f_stringpreferences("AllowCustomerInCashSale") = "Y" and this.ii_saletype = 3 and this.idc_customers.rowcount() > 0 then
		ls_custcode = f_stringpreferences("defaultcustomerincashsale")
		if ls_custcode = "-1" then
			ll_custcode = this.idc_customers.getitemnumber(1, "accounts_acccode")
		else
			ll_custcode = long(ls_custcode)
		end if
		this.id_master.object.custcode[1] = ll_custcode
		this.id_master.accepttext()
		if wf_customerinfo(ll_custcode) <> 0 then
			messagebox("Database Error", "Customer information can not be retrieved")
			return
		end if
		return
	end if
	this.id_assocsaleinvlist.reset()
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.il_norcotixcode = -1
	this.im_menu.m_file.m_print.enabled = true
	wf_protectdw(this.id_master, 0)
	this.id_detail.setredraw(false)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.id_detail.setredraw(true)
	this.ib_modify = false
	wf_assign_master_cash_win_object()
	wf_setgodownoption()
	li_ismodifysaleprice = 1
	li_ismodifyitemdiscperc = 1
	li_ismodifyitemflatdisc = 1
	li_modifysalestax = 1
	li_viewstock = 0
	li_viewtotalstock = 0
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 511 then
			li_ismodifysaleprice = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 516 then
			li_ismodifyitemdiscperc = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 517 then
			li_ismodifyitemflatdisc = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 520 then
			li_modifysalestax = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 535 then
			li_viewstock = 1
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 536 then
			li_viewtotalstock = 1
		end if
	next
	this.id_footer.object.t_stock.visible = li_viewstock
	this.id_footer.object.stock.visible = li_viewstock
	this.id_footer.object.t_totalstock.visible = li_viewtotalstock
	this.id_footer.object.totalstock.visible = li_viewtotalstock
	if f_stringpreferences("InitInvBalanceInFooter") = "Y" then
		this.id_footer.object.t_balance.text = "0.00"
	end if
	this.id_detail.object.saleprice.protect = li_ismodifysaleprice
	this.id_detail.object.discperc.protect = li_ismodifyitemdiscperc
	this.id_detail.object.itemflatdisc.protect = li_ismodifyitemflatdisc
	this.id_detail.object.unitsalestax.protect = li_modifysalestax
	this.id_detail.object.gstperc.protect = li_modifysalestax
	this.id_footer.setitem(1, "invdiscperc", f_numberpreferences("invdiscperc"))
	if not wf_validatedate() then
		close(this)
	elseif f_stringpreferences("ItemCode") = "N" then
		this.id_detail.setfocus()
	else
		this.id_detail.setcolumn(1)
		this.id_detail.setfocus()
	end if
	if f_stringpreferences("DisplayPool") = "Y" then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
			setnull(this.is_lcditem)
			this.ic_comport.triggerevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
			setnull(this.is_lcditem)
			this.ic_comport.triggerevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
			this.is_lcditem = space((20 - len(trim(left(f_reportheaderinfosale("clientname", this.id_master.object.headerno[1]), 20)))) / 2.0) + upper(trim(left(f_reportheaderinfosale("clientname", this.id_master.object.headerno[1]), 20)))
			this.is_lcditem2 = "WELCOME YOU AT SALES"
			this.ic_comport.triggerevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
			this.ole_lcddisplay.object.enablegreeting = true
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "TYSSO VFD-860-A" then
			setnull(this.is_lcditem)
			this.is_lcditem = " WE WELCOME YOU AT  " + space((20 - len(trim(left(f_reportheaderinfosale("clientname", this.id_master.object.headerno[1]), 20)))) / 2.0) + upper(trim(left(f_reportheaderinfosale("clientname", this.id_master.object.headerno[1]), 20)))
			this.ic_comport.triggerevent("ue_show")
		end if
	end if
	this.ib_lcdshow = true
	this.ii_focuscustomer = 2
	this.id_master.object.selectcustomer[1] = "N"
	this.id_detail.object.t_looseqtytotal.text = "0"
	if f_stringpreferences("LockQtyINPos") = "Y" then
		this.id_detail.object.looseqty.protect = "1"
		this.id_detail.object.bonusqty.protect = "1"
	else
		this.id_detail.object.looseqty.protect = "0"
		this.id_detail.object.bonusqty.protect = "0"
	end if
	if f_rightexists(5052) = false then
		this.id_detail.object.itemname.protect = "1~tif(icode > 0, 1, 0)"
		this.id_detail.object.fullcode.protect = "1~tif(icode > 0, 1, 0)"
		this.id_detail.object.gcode.protect = "1~tif(icode > 0, 1, 0)"
	else
		this.id_detail.object.itemname.protect = "0"
		this.id_detail.object.fullcode.protect = "0"
		this.id_detail.object.gcode.protect = "0"
	end if
	if f_stringpreferences("LockItemnameInPOS") = "Y" then
		this.id_detail.object.itemname.protect = 1
	end if
	wf_link_to_cashiershift()

// w_postsale.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect
	integer li_ismodifysaleprice
	integer li_ismodifyitemdiscperc
	integer li_ismodifyitemflatdisc
	integer li_modifysalestax
	long ll_row
	long ll_code
	long ll_counter
	long ll_rowcount
	boolean lb_flag
	boolean lb_modify
	double ld_code
	m_posmenu lm_menu
	lm_menu = this.menuid
	this.tab_retrieve.tabpage_list.em_invno.getdata(ld_code)
	if ld_code = 0.0 then
		ld_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	end if
	ll_code = long(ld_code)
	if wf_isinvoiceinuse(ll_code) = true then
		messagebox("Invoice Validation", "Sale Invoice already in use by some other user.~r~nKindly try again after sometime or open some other invoice.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if wf_allowsalemodification(ll_code, this.il_groupcode, this.il_strategy) <> 0 then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "You Can not modify this Invoice,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.im_menu.m_file.m_print.enabled = true
	this.i_editmode = 2
	this.i_retrievemode = 2
	this.id_dwcontrol = this.id_master
	ll_rowcount = wf_retrieve(ll_code)
	this.id_master.setrow(1)
	this.id_master.scrolltorow(1)
	this.id_dwcontrol = this.id_footer
	wf_retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	this.id_dwcontrol = this.id_detail
	wf_retrieve(ll_code)
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	this.id_dwcontrol = this.id_list
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		if this.ii_saletype = 2 and this.ib_creditmodify then
			lb_modify = true
		end if
		if this.ii_saletype = 3 and this.ib_retailmodify then
			lb_modify = true
		end if
	end if
	if not lb_modify then
		this.im_menu.m_file.m_save.enabled = false
		this.editflag = false
	else
		li_protect = 0
		wf_initmodify(li_protect)
	end if
	if this.id_master.object.code[this.id_master.rowcount()] > 0 then
		this.ids_cashwin.retrieve(ld_code)
	else
		wf_assign_master_cash_win_object()
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if f_stringpreferences("LockItemnameInPOS") = "Y" and this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		this.id_detail.object.itemname.protect = 1
	end if
	if f_stringpreferences("LockQtyINPos") = "Y" then
		this.id_detail.object.looseqty.protect = "1"
		this.id_detail.object.bonusqty.protect = "1"
	elseif this.id_master.object.posted[1] = "N" then
		this.id_detail.object.looseqty.protect = "0"
		this.id_detail.object.bonusqty.protect = "0"
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_salegodown
	end if
	if li_protect = 0 then
		li_ismodifysaleprice = 1
		li_ismodifyitemdiscperc = 1
		li_ismodifyitemflatdisc = 1
		li_modifysalestax = 1
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 511 then
				li_ismodifysaleprice = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 516 then
				li_ismodifyitemdiscperc = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 517 then
				li_ismodifyitemflatdisc = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 520 then
				li_modifysalestax = 0
			end if
		next
		this.id_detail.object.saleprice.protect = li_ismodifysaleprice
		this.id_detail.object.discperc.protect = li_ismodifyitemdiscperc
		this.id_detail.object.itemflatdisc.protect = li_ismodifyitemflatdisc
		this.id_detail.object.unitsalestax.protect = li_modifysalestax
		this.id_detail.object.gstperc.protect = li_modifysalestax
	end if
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	this.id_detail.object.t_looseqtytotal.text = string(this.id_detail.object.c_looseqtytotal[1])
	wf_grandtotal()
	setredraw(true)

// w_postsale.ue_newitem() returns 0 [event]
	integer li_defaultgcode
	long ll_rowcount
	setnull(this.is_aliasname)
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	if f_stringpreferences("AutoSelectLastGodownInSale") = "Y" and this.id_detail.rowcount() > 0 then
		this.id_detail.object.gcode.initial = string(this.id_detail.object.gcode[this.id_detail.rowcount()])
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true
	this.ii_defaultgcode = this.ii_salegodown
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.setfocus()

// w_postsale.ue_deleteitem() returns 0 [event]
	long ll_row
	long ll_footerrow
	long ll_icode
	long ll_usercode
	long ll_groupcode
	long ll_count
	long ll_currow
	long ll_detailrows
	dwruntimeerror myexc
	u_deleted_saleitemlog lu_deleted_saleitemlog
	if f_rightexists(5051) = false then
		open(w_salesmanpassword)
		ll_usercode = long(message.doubleparm)
		setfocus()
		if ll_usercode > 0 then
			ll_groupcode = f_getgroupcode(ll_usercode)
			if ll_groupcode > 0 then
				SQL SELECT ISNULL ( COUNT ( RightCode ) , 0 ) INTO :ll_count FROM GroupRights WHERE RightCode =5051 AND GroupCode =:ll_groupcode USING this.it_transobject;
				if this.it_transobject.sqlcode = 0 then
					if ll_count <= 0 then
						messagebox("Delete Item", "You are not authorised for deletion of Item(s)", stopsign!)
						return
					end if
				else
					messagebox("Delete Item", "Problem in validating rights for deletion of Item(s)", stopsign!)
					return
				end if
			else
				return
			end if
		else
			return
		end if
	else
		ll_usercode = gl_usercode
	end if
	this.ib_itemvalidated = true
	try
		ll_icode = this.id_detail.object.icode[this.id_detail.getrow()]
	catch (throwable myexc)
	end try
	if not isnull(ll_icode) then
		this.id_detail.rowscopy(this.id_detail.getrow(), this.id_detail.getrow(), primary!, this.ids_itemrecyclebin, this.ids_itemrecyclebin.rowcount() + 1, primary!)
	end if
	if f_stringpreferences("allowdeleteiteminpos") = "Y" then
		if f_stringpreferences("PreserveDeletedSaleItemsLog") = "Y" and ll_icode > 0 then
			lu_deleted_saleitemlog.of_generatelog(this.id_detail, this.id_detail.getrow(), this.id_master.object.code[1], ll_usercode)
		end if
		this.id_detail.deleterow(0)
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows < 1 then
		this.im_menu.m_file.m_save.enabled = false
	end if
	wf_grandtotal()
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() > 0 then
		this.id_footer.setitem(ll_footerrow, "icode", this.id_detail.getitemnumber(ll_row, "icode"))
		this.id_footer.setitem(ll_footerrow, "stock", this.id_detail.getitemnumber(ll_row, "stock"))
	else
		this.id_footer.setitem(ll_footerrow, "icode", 0)
		this.id_footer.setitem(ll_footerrow, "stock", 0)
		this.im_menu.m_file.m_print.enabled = false
		this.im_menu.m_file.m_save.enabled = false
	end if
	this.id_detail.postevent("ue_setstock")
	this.id_detail.postevent("ue_setQtyTotal")
	this.id_detail.postevent("ue_setFocusQty")

// w_postsale.close() returns long [event]
	long ancestorreturnvalue
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	if f_stringpreferences("DisplayPool") = "Y" then
		try
			if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
				this.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
				postevent("ue_show")
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
				this.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
				this.ic_comport.triggerevent("ue_show")
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				this.is_lcditem = "     THANK YOU"
				this.is_lcditem2 = "   FOR YOUR VISIT"
				this.ic_comport.triggerevent("ue_show")
				pd_closeusbpd()
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
				this.ole_lcddisplay.object.enablegreeting = true
				this.ole_lcddisplay.object.__invoke_method("stopdisplay", 0, {}, true)
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "TYSSO VFD-860-A" then
				setnull(this.is_lcditem)
				this.ic_comport.triggerevent("ue_show")
			else
				this.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
				this.ic_comport.triggerevent("ue_show")
			end if
		catch (throwable exdw)
			messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
		catch (throwable exnullobj)
			messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
		catch (throwable ex)
			messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
		end try
	end if
	return 1

// w_postsale.ue_list() returns 0 [event]
	long ll_row
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_post.enabled = true
	this.im_menu.m_file.m_print.enabled = false
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	this.il_norcotixcode = -1
	this.tab_retrieve.tabpage_list.em_invno.selecttext(1, 7)
	this.tab_retrieve.tabpage_list.em_invno.clear()
	ll_row = wf_retrievelist()
	wf_disabledetailtab(ll_row)
	post event ue_enableprint()

// w_postsale.ue_print() returns 0 [event]
	long ll_custcode
	long ll_row
	long ll_invcode
	long t
	long ll_draftprint
	long li_salecatcode
	string ls_custname
	string ls_posted
	string ls_qrcode
	string ls_fiscalinvoiceno
	integer li_option
	integer li_reprintingcounter
	double ld_balance
	boolean lb_listtab
	string ls_invsize
	s_datastore lstr
	runtimeerror ex
	long ll_job
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
			else
				event ue_newitem()
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
		ls_fiscalinvoiceno = this.id_list.object.fiscalinvoiceno[this.id_list.getrow()]
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
		ls_fiscalinvoiceno = this.id_master.object.fiscalinvoiceno[1]
	end if
	li_reprintingcounter = 0
	SQL SELECT ISNULL ( reprintingcounter , 0 ) , salecatcode , invoicesize INTO :li_reprintingcounter, :li_salecatcode, :ls_invsize FROM saleledger WHERE saleinvcode =:ll_invcode USING this.it_transobject;
	li_reprintingcounter = li_reprintingcounter + 1
	SQL update SaleLedger SET ReprintingCounter =:li_reprintingcounter WHERE saleinvcode =:ll_invcode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Database Error", "Some database problem has occur")
		SQL rollback USING this.it_transobject;
		return
	else
		SQL commit USING this.it_transobject;
	end if
	if this.ii_saletype = 2 then
		this.ib_printout = false
	end if
	ll_draftprint = wf_select_draft_printout(ll_invcode)
	if ll_draftprint = 0 then
		wf_selectprintreport(ls_invsize)
		this.id_print.retrieve(ll_invcode)
		if this.id_print.rowcount() > 0 then
			try
				ls_fiscalinvoiceno = this.id_print.object.fiscalinvoiceno[1]
				if len(ls_fiscalinvoiceno) > 0 then
					ls_qrcode = ls_fiscalinvoiceno
					wf_gen_qrcode(ll_invcode, ls_qrcode)
				end if
			catch (throwable ex)
			end try
		end if
		if isnull(ls_fiscalinvoiceno) then
			ls_fiscalinvoiceno = ""
		end if
		if this.ic_autofiscalize = "Y" and this.ic_printunfiscalizedinvoice = "N" and len(ls_fiscalinvoiceno) <= 0 then
			if lb_listtab then
				return
			else
				if this.im_menu.m_file.m_save.enabled = true then
					postevent("ue_new")
				end if
				return
			end if
			return
		end if
		if f_stringpreferences("CustBalanceOnPrintOut") = "Y" and (this.id_master.getitemstring(1, "invoicesize") = "F" or this.id_master.getitemstring(1, "invoicesize") = "H" or this.id_master.getitemstring(1, "invoicesize") = "Q") and li_salecatcode <> 3 and gs_company <> "SA" and this.id_print.getitemstring(1, "Posted") = "N" then
			ll_custcode = this.id_print.getitemnumber(1, "CustCode")
			SQL rollback USING sqlca;
			ld_balance = 0
			sqlca.absoluteopeningbalance(ll_custcode, ld_balance)
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
				messagebox("Balance Problem", "Unable to fetch balance on sales printing.")
				return
			end if
			this.id_print.setitem(this.id_print.rowcount(), "balance", ld_balance)
		end if
		if lb_listtab then
			lstr.s_module = "sale"
			lstr.dw = this.id_print
			lstr.s_name1 = this.id_print.dataobject
			openwithparm(w_preview_invoices, lstr)
			lstr = message.powerobjectparm
			if lstr.i_closemode = -1 then
				li_reprintingcounter = li_reprintingcounter - 1
				SQL update SaleLedger SET ReprintingCounter =:li_reprintingcounter WHERE saleinvcode =:ll_invcode USING this.it_transobject;
				if this.it_transobject.sqlcode <> 0 then
					messagebox("Database Error", "Some database problem has occur during updation of reprinting counter.")
					SQL rollback USING this.it_transobject;
					return
				else
					SQL commit USING this.it_transobject;
				end if
				return
			end if
		end if
		if f_stringpreferences("saleaskforcopies") = "Y" then
			open(w_printer_copies)
			this.id_print.object.datawindow.print.copies = string(message.doubleparm)
		end if
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
			if this.im_menu.m_file.m_save.enabled = true then
				postevent("ue_new")
			end if
			return
		end if
		if this.id_print.rowcount() > 0 then
			if ls_invsize = "T" then
				ll_job = printopen("waseela", false)
				if ll_job = -1 then
					messagebox("Error", "Unable to Open Print Job for Label printing")
				else
					printdatawindow(ll_job, this.id_print)
					printclose(ll_job)
				end if
			elseif this.id_print.print() < 0 then
				messagebox("Printing", "Can not Print Invoice", information!)
			end if
			wf_print_storesummary(ll_invcode)
			if this.im_menu.m_file.m_save.enabled = true then
				postevent("ue_new")
			end if
		else
			messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
		end if
		return
	end if
	if this.im_menu.m_file.m_save.enabled = true then
		postevent("ue_new")
	end if

// w_postsale.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	if this.ii_saletype <> 3 then
		setpointer(hourglass!)
		this.idc_customers.setredraw(false)
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.retrieve()
		this.idc_customers.setredraw(true)
		setpointer(arrow!)
	end if
	this.idc_doctors.setredraw(false)
	this.idc_doctors.settransobject(this.it_transobject)
	this.idc_doctors.retrieve()
	this.idc_doctors.setredraw(true)
	this.idc_patient.setredraw(false)
	this.idc_patient.settransobject(this.it_transobject)
	this.idc_patient.retrieve()
	this.idc_patient.setredraw(true)

// w_postsale.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false
	wf_assign_master_cash_win_object()

// w_postsale.ue_postopen() returns 0 [event]
	datawindowchild ldc_headerno
	m_posmenu lm_menu
	integer li_rtncode
	integer li_defaultgodown
	integer i
	long ll_counter
	long ll_pos
	long ll_found
	datastore lds_headers
	datawindowchild ldc_godown
	call super::ue_postopen
	this.id_assocsaleinvlist = this.dw_assocsaleinvlist
	this.id_assocsaleinvlist.settransobject(this.it_transobject)
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(this.it_transobject)
	this.ids_invoiceinfo = create datastore
	this.ids_invoiceinfo.dataobject = "d_saleinvinfo"
	this.ids_invoiceinfo.settransobject(this.it_transobject)
	wf_assign_master_cash_win_object()
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	this.id_holdsaledetail = this.dw_holdpostsaledetail
	this.id_holdsaledetail.dataobject = "d_postsaledetail"
	this.id_holdsaledetail.settransobject(this.it_transobject)
	this.id_holdsaledetail.getchild("gcode", ldc_godown)
	ldc_godown.settransobject(this.it_transobject)
	ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	this.ids_salesetsheader = create datastore
	this.ids_salesetsdetail = create datastore
	this.ids_salesetsorigdetail = create datastore
	this.ids_salesetsheader.dataobject = "d_salesetsheader"
	this.ids_salesetsdetail.dataobject = "d_salesetsdetail"
	this.ids_salesetsorigdetail.dataobject = "d_salesetsorigdetail"
	this.ids_salesetsheader.settransobject(this.it_transobject)
	this.ids_salesetsdetail.settransobject(this.it_transobject)
	this.ids_salesetsorigdetail.settransobject(this.it_transobject)
	this.ic_fbrposfee = f_stringpreferences("Auto_Apply_FBR_POS_Fee_InSale")
	if this.ic_fbrposfee = "" or isnull(this.ic_fbrposfee) then
		this.ic_fbrposfee = "N"
	end if
	this.ic_autofiscalize = f_stringpreferences("AutoFiscalizeOnPosting")
	if this.ic_autofiscalize = "" or isnull(this.ic_autofiscalize) then
		this.ic_autofiscalize = "N"
	end if
	this.ic_printunfiscalizedinvoice = f_stringpreferences("PrintUnFiscalizedInvoice")
	if this.ic_printunfiscalizedinvoice = "" or isnull(this.ic_printunfiscalizedinvoice) then
		this.ic_printunfiscalizedinvoice = "N"
	end if
	lm_menu = this.menuid
	setredraw(false)
	wf_setsaletype(integer(message.doubleparm))
	this.id_print = this.dw_saleinvrep
	this.id_saleinvdetail = this.dw_saleinvdetail
	this.id_saleinvdetail.settransobject(this.it_transobject)
	this.title = "POS Sale"
	choose case this.ii_saletype
	case 2
		if gs_company = "SHE" then
			wf_assigndatawindowobjects("d_PostSaleHeader", "d_PostSaleDetail", "d_PostSaleFooter", "d_PostSaleInvlist", "d_PostSaleInvReport")
			this.id_master.object.salecatcode.initial = "1"
		else
			wf_assigndatawindowobjects("d_PostSaleHeader", "d_PostSaleDetail", "d_PostSaleFooter", "d_PostSaleInvlist", "d_PostSaleInvReport")
		end if
		if gs_company = "CMH" or gs_company = "NM" or gs_company = "FZGUL" then
			this.id_master.object.custrefno.editmask.mask = "########0"
			this.id_master.object.custrefno.editmask.required = true
		end if
		if gs_company = "PIC" then
			this.id_master.object.salecatcode.visible = false
			this.id_master.object.t_1.visible = false
		end if
		if f_stringpreferences("InSaleCustomerBalance") = "Y" then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
			this.ids_customersbalance = create datastore
			this.ids_customersbalance.dataobject = "d_customerbalances_in_sales"
			this.ids_customersbalance.settransobject(sqlca)
			this.ids_customersbalance.retrieve()
		else
			this.id_master.object.debitorcredit.visible = false
			this.id_master.object.customerbalance.visible = false
			this.id_master.object.t_balance.visible = false
		end if
		li_rtncode = this.id_master.getchild("custcode", this.idc_customers)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_customers.settransobject(this.it_transobject)
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 529 then
				this.im_menu.m_file.m_post.visible = true
				this.im_menu.m_file.m_post.toolbaritemvisible = true
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 530 then
				this.ib_creditmodify = true
			end if
		next
		li_rtncode = this.id_master.getchild("patientcode", this.idc_patient)
		if li_rtncode = -1 then
