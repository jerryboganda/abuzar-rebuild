// w_postsale.wf_retrievelist() returns long
	string[] ls_posted
	string ls_showrows
	integer[] li_salecategory
	integer li_invforlastdays
	long ll_counter
	datetime ld_invdate
	li_invforlastdays = f_numberpreferences("poslistviewretrievaldays") * -1
	ld_invdate = datetime(relativedate(today(), li_invforlastdays))
	ls_showrows = "N"
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	li_salecategory[1] = 1
	li_salecategory[2] = 2
	li_salecategory[3] = 3
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 538 then
			ls_showrows = "Y"
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 539 then
		end if
	next
	if ls_showrows = "N" then
		this.tab_retrieve.tabpage_list.cb_retrieve.enabled = false
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, ls_showrows, this.il_groupcode, this.ii_module)

// w_postsale.wf_retrievelistall() returns long
	string[] ls_posted
	string ls_showrows
	integer[] li_salecategory
	integer li_invforlastdays
	long ll_counter
	datetime ld_invdate
	li_invforlastdays = f_numberpreferences("poslistviewmaxretrievaldays") * -1
	ld_invdate = datetime(relativedate(today(), li_invforlastdays), time("00:00:00"))
	ls_showrows = "N"
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	li_salecategory[1] = 1
	li_salecategory[2] = 2
	li_salecategory[3] = 3
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 538 then
			ls_showrows = "Y"
		end if
	next
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, ls_showrows, this.il_groupcode, this.ii_module)

