	return ::message.returnvalue

// w_postsale.ue_callback_popupwindow(any ar_object) returns 0 [event]
	long ll_code
	long ll_row
	string as_errortext
	super::ue_callback_popupwindow(ar_object)
	ll_code = long(ar_object)
	ll_row = this.id_master.getrow()
	if ll_row > 0 and ll_code > 0 then
		this.id_master.object.srbufferinvcode[ll_row] = ll_code
		setredraw(true)
		wf_set_salereturn_amount()
		if f_stringpreferences("DisplayPool") = "Y" and upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
			pd_openusbpd()
			if pd_pdstate() = 0 then
				wf_pd_initialize()
			end if
		end if
	end if

// w_postsale.closequery() returns long [event]
	integer li_yesno
	integer li_rtcode
	string ls_pref
	long ll_counter
	u_deleted_saleitemlog lu_deleted_saleitemlog
	ls_pref = f_stringpreferences("mustsaveinvonexitinpos")
	if ls_pref = "Y" then
		if this.editflag = true and this.id_detail.rowcount() > 0 then
			wf_deleteemptydetailrow()
			if this.id_detail.rowcount() > 0 then
				li_yesno = 1
				if li_yesno = 1 then
					if f_rightexists(551) then
						triggerevent("ue_save")
					else
						triggerevent("ue_print")
					end if
					if wf_commitform() = false then
						li_rtcode = 1
					end if
				elseif li_yesno = 3 then
					li_rtcode = 1
				end if
			else
				this.editflag = false
				li_rtcode = 0
			end if
		end if
	elseif this.editflag = true then
		li_yesno = messagebox("Invoice", "Do You want to save changes", question!, yesnocancel!, 2)
		if li_yesno = 1 then
			if f_rightexists(551) then
				triggerevent("ue_save")
			else
				triggerevent("ue_print")
			end if
			if wf_commitform() = false then
				li_rtcode = 1
			end if
		elseif li_yesno = 3 then
			li_rtcode = 1
		elseif this.id_detail.rowcount() > 0 and f_stringpreferences("PreserveDeletedSaleItemsLog") = "Y" then
			for ll_counter = 1 to this.id_detail.rowcount()
				if this.id_detail.object.icode[ll_counter] > 0 then
					lu_deleted_saleitemlog.of_generatelog(this.id_detail, ll_counter, this.id_master.object.code[1], gl_usercode)
				end if
			next
		end if
	end if
	return li_rtcode

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	if newindex = 1 then
		parent.ii_focuscustomer = 1
	end if
	return ::message.returnvalue

// tab_retrieve.selectionchanging(integer oldindex, integer newindex) returns long [event]
	integer li_yesno
	integer li_rtcode
	string ls_pref
	long ll_counter
	u_deleted_saleitemlog lu_deleted_saleitemlog
	ls_pref = f_stringpreferences("mustsaveinvonexitinpos")
	if oldindex = 1 and newindex = 2 and parent.editflag = true then
		if ls_pref = "Y" then
			if parent.id_detail.rowcount() > 0 then
				parent.wf_deleteemptydetailrow()
				if parent.id_detail.rowcount() > 0 then
					li_yesno = 1
					if li_yesno = 1 then
						if f_rightexists(551) then
							getparent().triggerevent("ue_save")
						else
							getparent().triggerevent("ue_print")
						end if
						if getparent().dynamic wf_commitform() = false then
							li_rtcode = 1
						end if
					elseif li_yesno = 3 then
						li_rtcode = 1
					else
						parent.editflag = false
						parent.i_editmode = 2
					end if
				else
					parent.editflag = false
					parent.i_editmode = 2
					li_rtcode = 0
				end if
			else
				parent.editflag = false
				parent.i_editmode = 2
				li_rtcode = 0
			end if
		elseif parent.id_detail.rowcount() > 0 then
			li_yesno = messagebox("Confirm Changes", "Yes to save changes that you've typed", question!, yesnocancel!, 2)
			if li_yesno = 1 then
				if f_rightexists(551) then
					getparent().triggerevent("ue_save")
				else
					getparent().triggerevent("ue_print")
				end if
				if getparent().dynamic wf_commitform() = false then
					li_rtcode = 1
				end if
			elseif li_yesno = 3 then
				li_rtcode = 1
			else
				parent.editflag = false
				parent.i_editmode = 2
				if parent.id_detail.rowcount() > 0 and f_stringpreferences("PreserveDeletedSaleItemsLog") = "Y" then
					for ll_counter = 1 to parent.id_detail.rowcount()
						if parent.id_detail.object.icode[ll_counter] > 0 then
							lu_deleted_saleitemlog.of_generatelog(parent.id_detail, ll_counter, parent.id_master.object.code[1], gl_usercode)
						end if
					next
				end if
			end if
		end if
	end if
	return li_rtcode

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
	case "flatdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	end choose
	return 1

// dw_footer.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if (getcolumnname() = "misccharges" or getcolumnname() = "invdiscperc") and key = keyf5! then
		parent.parent.parent.wf_set_misccharges()
		rt_code = 1
	end if
	if (getcolumnname() = "misccharges" or getcolumnname() = "flatdisc" or getcolumnname() = "invdiscperc") and key = keyf7! then
		parent.parent.parent.wf_show_misccharges_breakup()
		rt_code = 1
	end if
	if getcolumnname() = "flatdisc" and key = keyf5! then
		parent.parent.parent.wf_set_flatdiscount()
		rt_code = 1
	end if
	if getcolumnname() = "flatdisc" and key = keyf6! then
		parent.parent.parent.wf_set_flatdiscount2()
		rt_code = 1
	end if
	return rt_code

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_code
	long ll_detailrows
	long ll_suppcode
	long ll_custcode
	long ll_counter
	long ll_customerbalance
	long ll_headerinvno
	integer rt_code
	integer li_res
	double ld_avgprice
	double ld_gstperc1
	double ld_gstperc2
	double ld_custgst
	double ld_purprice
	double ld_saleprice1
	double ld_saleprice2
	double ld_saleprice3
	double ld_saleprice4
	double ld_saleprice5
	double ld_rpp
	long ll_icode
	long li_packunits
	string ls_result
	string ls_null
	datetime ld_currdate
	date ld_datepart
	time lt_timepart
	integer li_custcode
	integer li_patientcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "selectcustomer"
	case "sprice"
		parent.setredraw(false)
		if parent.parent.parent.id_detail.getrow() > 0 and isnull(parent.parent.parent.id_detail.getitemnumber(parent.parent.parent.id_detail.getrow(), "itemcode")) then
			parent.parent.parent.event ue_deleteitem()
		end if
		for ll_counter = 1 to parent.parent.parent.id_detail.rowcount()
			ll_icode = parent.parent.parent.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT item.saleprice , item.saleprice2 , item.saleprice3 , item.avgprice , item.packunits , item.purprice , item.recentpurprice , item.saleprice4 , item.saleprice5 INTO :ld_saleprice1, :ld_saleprice2, :ld_saleprice3, :ld_avgprice, :li_packunits, :ld_purprice, :ld_rpp, :ld_saleprice4, :ld_saleprice5 FROM item WHERE item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = -1 then
				parent.setredraw(true)
				messagebox("Database Error", "Item information can not be retrieved")
				return 1
			end if
			if not (parent.parent.parent.it_transobject.sqlcode = 100) then
				choose case long(data)
				case 1
					parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice1 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice1)
				case 2
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice2 / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice2 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice2)
				case 3
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice3 / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice3 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice3)
				case 7
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice4 / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice4 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice4)
				case 8
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice5 / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice5 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice5)
				case 4
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_purprice / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_purprice / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_purprice)
				case 5
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_rpp / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_rpp / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_rpp)
				case else
					if parent.parent.parent.is_reportratedeviationusing = "A" then
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_avgprice / li_packunits)
					else
						parent.parent.parent.id_detail.setitem(ll_counter, "rate", ld_saleprice1 / li_packunits)
					end if
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_avgprice)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_avgprice * li_packunits)
				end choose
			elseif not isnull(parent.parent.parent.id_detail.getitemstring(1, "itemname")) then
				parent.setredraw(true)
				messagebox("DataBase Error", "Rows not retrieve")
				return 0
			end if
		next
		if parent.parent.parent.id_detail.rowcount() <= 0 then
			parent.parent.parent.event ue_newitem()
			parent.parent.parent.id_master.setfocus()
		end if
		parent.setredraw(true)
	case "dd_gstperc"
	case "headerno"
		setnull(ll_headerinvno)
		setitem(row, "headerinvno", ll_headerinvno)
	case "date"
		if isdate(left(data, 10)) then
			ld_datepart = date(left(data, 10))
			if istime(mid(data, 12, 8)) then
				lt_timepart = time(mid(data, 12, 8))
				ld_currdate = datetime(ld_datepart, lt_timepart)
				if ld_currdate < parent.parent.parent.id_systemdate then
					rt_code = 1
				end if
			else
				rt_code = 1
			end if
		else
			rt_code = 1
		end if
	case "aliasname"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findcustcode(data, li_custcode)
			if li_res > 0 then
				setitem(row, "custcode", li_custcode)
				parent.setredraw(false)
				if parent.parent.parent.wf_customerinfo(long(li_custcode)) <> 0 then
					messagebox("Database Error", "Customer Information can not be retrieved")
					parent.setredraw(true)
					return 1
				end if
				parent.setredraw(true)
				rt_code = 0
			else
				messagebox("Customer Validation", "Customer with  Alias Name  " + data + " does not exist")
				return 1
			end if
		else
			return 0
		end if
	case "patientregno"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findpatientcode(data, li_patientcode)
			if li_res > 0 then
				setitem(row, "patientcode", li_patientcode)
				rt_code = 0
			else
				messagebox("Patient Validation", "Patient with  RegNo  " + data + " does not exist")
				rt_code = 1
			end if
		end if
	case "custcode"
		if not isnull(data) then
			ll_code = long(data)
			parent.setredraw(false)
			if parent.parent.parent.wf_customerinfo(ll_code) <> 0 then
				messagebox("Database Error", "Customer information can not be retrieved")
				parent.setredraw(true)
				return 1
			end if
			parent.setredraw(true)
			if accepttext() = -1 then
				return 1
			end if
			return
		end if
	case "messagecode"
		if not isnull(getitemnumber(row, "custcode")) then
			rt_code = parent.parent.parent.wf_customermessagevalidation(getitemnumber(row, "custcode"), long(data))
			if rt_code = 1 then
				rt_code = messagebox("Invalid Message Alert", "Wrong Message Selected" + "~rIs That Ok?", question!, yesno!, 2)
				if rt_code = 1 then
					rt_code = 0
				end if
			end if
		end if
		return rt_code
	end choose
	return rt_code

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "date"
		messagebox("Date Time Validation", "Date and Time is invalid,~r~nPlease enter current date and time")
	case "custcode"
	case "custrefno"
		if data = "" or isnull(data) then
			messagebox("Customer Reference Validation", "Please Enter Reference")
		end if
	case "headerno"
		if data = "" or isnull(data) then
			messagebox("Header No Validation", "You must select some HeaderNo")
		end if
	case "Regno"
		if data = "" or isnull(data) then
			messagebox("Patient Validation", "RegNo Does Not Exist")
		end if
	end choose
	return 1

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	s_arguements lstr_arg
	long[] la_custcatcode
	long ll_counter
	long ll_foundcode
	string ls_custcats
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	try
		if key = keyf5! and getcolumnname() = "custcode" then
			open(w_choose_customercategory)
			lstr_arg = message.powerobjectparm
			if lstr_arg.i_status = 1 then
				la_custcatcode = lstr_arg.ia_integerlist
				ls_custcats = ""
				for ll_counter = 1 to upperbound(la_custcatcode)
					ls_custcats = ls_custcats + string(la_custcatcode[ll_counter]) + " , "
				next
				ls_custcats = ls_custcats + " 0"
				if parent.parent.parent.ii_saletype = 2 then
					parent.parent.parent.idc_customers.setfilter("custcatcode In (" + ls_custcats + ") and accounts_acccode <> 19 ")
				else
					parent.parent.parent.idc_customers.setfilter("custcatcode In (" + ls_custcats + ") ")
				end if
				parent.parent.parent.idc_customers.filter()
			end if
		elseif key = keyf6! and getcolumnname() = "custcode" then
			parent.parent.parent.wf_new_customerregisteration()
		elseif key = keyf7! and getcolumnname() = "custcode" then
			parent.parent.parent.is_comprehensive_search_dataobject = "d_customer_list"
			ll_foundcode = parent.parent.parent.wf_comprehensive_search()
			if ll_foundcode >= 0 then
				this.object.custcode[1] = ll_foundcode
				parent.parent.parent.wf_customerinfo(ll_foundcode)
			end if
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
		setnull(ll_counter)
		parent.parent.parent.id_master.setitem(1, "custcode", ll_counter)
	end try
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_detail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	parent.parent.parent.post wf_setcustomername(data)
	return ::message.returnvalue

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if string(dwo.name) = "custcode" then
		parent.parent.parent.id_master.selecttext(1, 40)
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_focuscustomer() returns 0 [event]
	integer ll_row
	integer ll_custcode
	parent.parent.parent.id_master.setcolumn("custcode")
	parent.parent.parent.id_master.setfocus()
	messagebox("Customer Selection", "Please select a Customer from the Dropdown Box")

// dw_itemsdetail.ue_setqtytotal() returns 0 [event]
	if rowcount() >= 1 then
		if isnull(this.object.icode[rowcount()]) then
			this.object.t_looseqtytotal.text = string(getitemnumber(rowcount(), "c_looseqtytotal") - 1.0)
		else
			this.object.t_looseqtytotal.text = string(getitemnumber(rowcount(), "c_looseqtytotal"))
		end if
		return
	end if
	this.object.t_looseqtytotal.text = "0"

// dw_itemsdetail.ue_setstock() returns 0 [event]
	long ll_row
	if rowcount() > 0 then
		if isnull(parent.parent.parent.id_detail.getitemnumber(getrow(), "icode")) then
			if getrow() > 1 then
				ll_row = getrow() - 1
			else
				ll_row = getrow()
			end if
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", getitemnumber(ll_row, "stock"))
			return
		end if
		parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", getitemnumber(getrow(), "stock"))
	end if

// dw_itemsdetail.ue_setfocusqty() returns 0 [event]
	setcolumn("looseqty")
	selecttext(1, len(gettext()))

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	long ll_null
	long ll_icode
	long ll_gcode
	long ll_itemcodetype
	long ll_counter
	long ll_detailrows
	string ls_null
	string ls_itemname
	double ld_saleprice
	double ld_newqty
	double ld_storedqty
	double ld_stock
	double ld_desiredbonus
	integer li_res
	double li_saleprice
	double ld_salediscperc
	double ld_purdiscperc
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	if row > 0 and getrow() > 0 and parent.parent.parent.editflag then
		choose case dwo.name
		case "itemname", "fullcode", "saleprice", "packsaleprice", "rateperlength", "discprice", "prediscperc", "extrataxperc", "itemflatdisc", "discperc", "gstperc", "unitsalestax", "cloneitemflatdisc", "clonediscperc"
			this.object.taxflag[row] = 0
		end choose
	end if
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
		parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		if parent.parent.parent.il_godowncount > 1 then
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = row
			li_errcode = 0
		else
			parent.parent.parent.ib_godownvalidated = false
			parent.parent.parent.ib_itemvalidated = true
		end if
	case "looseqty"
		ld_newqty = double(data)
		ld_stock = this.object.stock[row]
		li_errcode = 0
		if ld_newqty > ld_stock then
			if f_stringpreferences("promptstockinpos") = "Y" then
				li_errcode = messagebox("Quantity Validation", "Quantity " + data + " exceeds the stock." + "~r~nDo you want to continue?", information!, yesno!, 1)
			end if
			selecttext(1, len(data))
			if li_errcode = 2 then
				li_errcode = 1
			else
				li_errcode = 0
			end if
		end if
		if li_errcode = 0 and (double(long(data)) <> double(data) and this.object.allowsaleindecimalqty[row] = "N") then
			messagebox("Decimal Quantity Validation", "Sale Quantity In decimals is not allowed for this item", stopsign!)
			li_errcode = 1
		end if
	case "bonusqty"
		if double(long(data)) <> double(data) and this.object.allowsaleindecimalqty[row] = "N" then
			messagebox("Decimal Bonus Quantity Validation", "Bonus Sales Quantity In decimals is not allowed for this item", stopsign!)
			li_errcode = 1
		end if
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname, ll_itemcodetype, parent.parent.parent.idbl_packqty, parent.parent.parent.idbl_purprice, parent.parent.parent.idbl_saleprice)
			if li_res > 0 then
				if parent.parent.parent.idbl_packqty = 0.0 then
					parent.parent.parent.idbl_packqty = 1
				end if
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				setitem(row, "looseqty", parent.parent.parent.idbl_packqty)
				if ll_itemcodetype = 2 then
					setitem(row, "alternatecustomicode", data)
					if parent.parent.parent.ib_applyalternatealiasprice then
						setitem(row, "rate", parent.parent.parent.idbl_saleprice / parent.parent.parent.idbl_packqty)
						setitem(row, "packprice", parent.parent.parent.idbl_saleprice)
						setitem(row, "saleprice", parent.parent.parent.idbl_saleprice / parent.parent.parent.idbl_packqty)
					end if
				else
					setitem(row, "alternatecustomicode", ls_null)
				end if
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
			else
				messagebox("ItemNumber Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_errcode = 1
				return 1
			end if
		else
			return 1
		end if
	case "saleprice"
		setitem(row, "updatesaleprice", "Y")
		if isnull(this.object.icode[row]) and double(data) <> 0.0 then
			messagebox("Sale Price Validation", "Sale Price is is not valid. Please select some valid item and then enter sale price", stopsign!)
			return 1
		end if
		if getitemstring(row, "locksaleprice") = "N" then
			ll_icode = parent.parent.parent.id_detail.object.icode[row]
			ll_gcode = parent.parent.parent.id_detail.object.gcode[row]
			ll_detailrows = rowcount()
		else
			messagebox("SalePrice Validation", "SalePrice is locked, you can not change it ")
			li_errcode = 2
		end if
	case "gcode"
		parent.parent.parent.is_columnname = "gcode"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_godownvalidated = false
		li_errcode = 0
	case "itemflatdisc"
		if isnull(this.object.icode[row]) and double(data) <> 0.0 then
			messagebox("Item Flat Discount Validation", "Item Flat Discount is not valid. Please select some valid item and then enter Item Flat Discount", stopsign!)
			return 1
		end if
		li_saleprice = getitemnumber(row, "saleprice")
		if li_saleprice < double(data) then
			messagebox("FlatDisc Validation", "Itemflatdisc must be less than sale price")
			li_errcode = 1
		end if
		this.object.cloneitemflatdisc[row] = round(double(data), 2)
	case "discperc"
		if isnull(this.object.icode[row]) and double(data) <> 0.0 then
			messagebox("Discount % Validation", "Discount % is not valid. Please select some valid item and then enter Item Flat Discount", stopsign!)
			return 1
		end if
		if getitemstring(row, "lockdiscperc") = "N" then
			ll_icode = parent.parent.parent.id_detail.object.icode[row]
			ll_gcode = parent.parent.parent.id_detail.object.gcode[row]
			ll_detailrows = rowcount()
		else
			messagebox("DiscPerc Validation", "DiscPerc is locked, you can not change it")
			li_errcode = 2
		end if
		if gs_company = "SHE" then
			ld_salediscperc = double(data)
			ll_icode = this.object.icode[row]
			SQL Select item.purdiscperc INTO :ld_purdiscperc From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			if ld_salediscperc > ld_purdiscperc then
				messagebox("Discount Validation", "Discount(%) " + data + " exceeds the purchase discount")
				li_errcode = 1
			end if
		end if
		parent.parent.parent.id_detail.object.clonediscperc[row] = double(data)
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ll_icode
	long ll_gcode
	long ll_godownstock
	long ll_count
	long ll_check_dup_ico
	long ancestorreturnvalue
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(false) = -1 then
		return ::message.returnvalue
	end if
	if parent.parent.parent.ib_godownvalidated = false and parent.parent.parent.wf_validategodown() = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "itemname" then
		parent.parent.parent.ib_focusdetail = true
	end if
	if dwo.name = "looseqty" and parent.parent.parent.ib_itemslistopen then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
	end if
	parent.parent.parent.wf_grandtotal()
	post event ue_setqtytotal()
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return 0

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_icode
	double ld_purdiscperc
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if currentrow > 0 then
		parent.parent.parent.is_aliasname = getitemstring(currentrow, "fullcode")
	end if
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(true) = -1 then
		return ::message.returnvalue
	end if
	if parent.parent.parent.ib_godownvalidated = false and parent.parent.parent.wf_validategodown() = -1 then
		return ::message.returnvalue
	end if
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if getcolumnname() <> parent.parent.parent.is_columnitemname then
		if rowcount() > 0 and lrs_status <> new! then
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", getitemnumber(currentrow, "icode"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "rpp", getitemnumber(currentrow, "recentpurprice"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "purprice", getitemnumber(currentrow, "purprice"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "avgprice", getitemnumber(currentrow, "avgprice"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "itemtotalval", getitemstring(currentrow, "itemtotalval"))
			if f_stringpreferences("BonusinSale") = "Y" then
				parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "bonusratio", trim(string(getitemnumber(currentrow, "qtysale"))) + ":" + trim(string(getitemnumber(currentrow, "bonus"))))
			end if
			if gs_company = "SHE" then
				ll_icode = this.object.icode[currentrow]
				SQL Select item.purdiscperc INTO :ld_purdiscperc From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
				parent.parent.parent.id_footer.object.t_purdiscper.text = string(ld_purdiscperc)
			end if
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", getitemnumber(currentrow, "totalstock"))
		elseif parent.parent.parent.id_footer.getrow() > 0 then
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", 0)
			if f_stringpreferences("BonusinSale") = "Y" then
				parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "bonusratio", "")
			end if
		end if
	end if
	post event ue_setqtytotal()
	post event ue_setstock()
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	long ll_currentrow
	string ls_holdstr
	string ls_temp
	string ls_qty
	string ls_rate
	string ls_total
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	if f_stringpreferences("DisplayPool") = "Y" then
		ll_currentrow = getrow()
		if ll_currentrow <> 0 and parent.parent.parent.ib_lcdshow = true then
			if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				if this.object.icode[ll_currentrow] > 0 then
					parent.parent.parent.is_lcditem = trim(left(this.object.itemname[ll_currentrow], 20)) + space(20 - len(trim(left(this.object.itemname[ll_currentrow], 20))))
					parent.parent.parent.is_lcditem2 = "Qty=" + string(this.object.looseqty[ll_currentrow], f_setcolumnformat("Qty")) + " Rs=" + string(this.object.saleprice[ll_currentrow], "#######0.00")
				end if
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
				parent.parent.parent.is_lcditem = trim(left(this.object.itemname[ll_currentrow], 20)) + space(20 - len(trim(left(this.object.itemname[ll_currentrow], 20))))
				ls_qty = string(this.object.looseqty[ll_currentrow], f_setcolumnformat("Qty"))
				ls_rate = string(this.object.saleprice[ll_currentrow], "#######0.00")
				ls_total = string(this.object.looseqty[ll_currentrow] * this.object.saleprice[ll_currentrow], "#####0.00")
				if isnull(parent.parent.parent.is_lcditem) then
					parent.parent.parent.is_lcditem = ""
				end if
				if isnull(ls_qty) then
					ls_qty = ""
				end if
				if isnull(ls_rate) then
					ls_rate = ""
				end if
				if isnull(ls_total) then
					ls_total = ""
				end if
				if trim(parent.parent.parent.is_lcditem) <> "" then
					parent.parent.parent.ole_lcddisplay.object.__invoke_method("showitem", 4, {parent.parent.parent.is_lcditem, ls_rate, ls_qty, ls_total}, true)
				end if
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "TYSSO VFD-860-A" then
				ls_holdstr = left(this.object.itemname[ll_currentrow], 10)
				if len(ls_holdstr) < 10 then
					ls_holdstr = ls_holdstr + space(10 - len(ls_holdstr))
				end if
				ls_total = "=" + space(9 - len(string(this.object.looseqty[ll_currentrow] * this.object.saleprice[ll_currentrow], "#####0.00"))) + string(this.object.looseqty[ll_currentrow] * this.object.saleprice[ll_currentrow], "#####0.00")
				ls_temp = ls_holdstr + ls_total
				ls_temp = ls_temp + "TOTAL     =" + space(9 - len(string(parent.parent.parent.wf_grandtotal(), "#####0.00"))) + string(parent.parent.parent.wf_grandtotal(), "#####0.00")
				ls_temp = left(ls_temp, 40)
				if len(ls_temp) <= 40 then
					if 40 - len(ls_temp) > 0 then
						ls_temp = ls_temp + space(40 - len(ls_temp))
					else
						ls_temp = left(ls_temp, 40)
					end if
				else
					ls_temp = left(ls_temp, 40)
				end if
				if not isnull(ls_temp) then
					parent.parent.parent.is_lcditem = ls_temp
				end if
				if isnull(parent.parent.parent.is_lcditem) then
					parent.parent.parent.is_lcditem = ""
				end if
				parent.parent.parent.ic_comport.triggerevent("ue_show")
			else
				ls_holdstr = this.object.itemname[ll_currentrow]
				if len(ls_holdstr) < 19 then
					ls_temp = ls_holdstr + space(19 - len(ls_holdstr))
				else
					ls_temp = left(ls_holdstr, 19)
				end if
				ls_temp = ls_temp + "Qty=" + string(this.object.looseqty[ll_currentrow], f_setcolumnformat("Qty"))
				ls_temp = ls_temp + " Rs=" + string(this.object.saleprice[ll_currentrow], "#######0.00")
				if len(ls_temp) <= 39 then
					if 39 - len(ls_temp) > 0 then
						ls_temp = ls_temp + space(39 - len(ls_temp))
					else
						ls_temp = left(ls_temp, 39)
					end if
				else
					ls_temp = left(ls_temp, 39)
				end if
				parent.parent.parent.is_lcditem = ls_temp
			end if
			parent.parent.parent.ic_comport.triggerevent("ue_show")
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "fullcode"
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case parent.parent.parent.is_columnitemname
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case "looseqty"
	case "packqty"
		if double(data) <= 0.0 then
			messagebox("Item Qty Validation", "Item Qty ~"" + data + "~" should be greater than zero")
		end if
	case "discperc"
		if real(data) < 0.0 and real(data) > 100.0 then
			messagebox("Item Discount Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
		end if
	case "saleprice"
		if double(data) < 0.0 then
			messagebox("Item Price Validation", "Item price ~"" + data + "~" must be greater than or equal to zero")
			return 1
		end if
	end choose
	return 1

// dw_itemsdetail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	integer ll_row
	integer ll_custcode
	long ancestorreturnvalue
	if f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	if parent.parent.parent.ii_saletype = 2 then
		ll_row = parent.parent.parent.id_master.getrow()
		ll_custcode = parent.parent.parent.id_master.object.custcode[ll_row]
		if parent.parent.parent.ii_focuscustomer = 2 and ll_custcode = 0 then
			post event ue_focuscustomer()
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanging(long currentrow, long newrow) returns long [event]
	long ancestorreturnvalue
	string ls_holdstr
	string ls_temp
	string ls_qty
	string ls_rate
	string ls_total
	ancestorreturnvalue = super::rowfocuschanging(currentrow, newrow)
	if f_stringpreferences("DisplayPool") = "Y" and (currentrow <> 0 and parent.parent.parent.ib_lcdshow = true) and parent.parent.parent.id_detail.rowcount() > 0 then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
			parent.parent.parent.is_lcditem = trim(left(this.object.itemname[currentrow], 20)) + space(20 - len(trim(left(this.object.itemname[currentrow], 20))))
			parent.parent.parent.is_lcditem2 = "Qty=" + string(this.object.looseqty[currentrow], f_setcolumnformat("Qty")) + " Rs=" + string(this.object.saleprice[currentrow], "#######0.00")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
			parent.parent.parent.ole_lcddisplay.object.enablegreeting = false
			parent.parent.parent.is_lcditem = trim(left(this.object.itemname[currentrow], 20)) + space(20 - len(trim(left(this.object.itemname[currentrow], 20))))
			ls_qty = string(this.object.looseqty[currentrow], f_setcolumnformat("Qty"))
			ls_rate = string(this.object.saleprice[currentrow], "#######0.00")
			ls_total = string(this.object.looseqty[currentrow] * this.object.saleprice[currentrow], "#####0.00")
			if isnull(parent.parent.parent.is_lcditem) then
				parent.parent.parent.is_lcditem = ""
			end if
			if isnull(ls_qty) then
				ls_qty = ""
			end if
			if isnull(ls_rate) then
				ls_rate = ""
			end if
			if isnull(ls_total) then
				ls_total = ""
			end if
			if trim(parent.parent.parent.is_lcditem) <> "" then
				parent.parent.parent.ole_lcddisplay.object.__invoke_method("showitem", 4, {parent.parent.parent.is_lcditem, ls_rate, ls_qty, ls_total}, true)
			end if
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "TYSSO VFD-860-A" then
			ls_holdstr = left(this.object.itemname[currentrow], 10)
			if len(ls_holdstr) < 10 then
				ls_holdstr = ls_holdstr + space(10 - len(ls_holdstr))
			end if
			ls_total = "=" + space(9 - len(trim(string(this.object.looseqty[currentrow] * this.object.saleprice[currentrow], "#####0.00")))) + trim(string(this.object.looseqty[currentrow] * this.object.saleprice[currentrow], "#####0.00"))
			ls_temp = ls_holdstr + ls_total
			ls_temp = ls_temp + "TOTAL     =" + space(9 - len(string(parent.parent.parent.wf_grandtotal(), "#####0.00"))) + string(parent.parent.parent.wf_grandtotal(), "#####0.00")
			ls_temp = left(ls_temp, 40)
			if len(ls_temp) <= 40 then
				if 40 - len(ls_temp) > 0 then
					ls_temp = ls_temp + space(40 - len(ls_temp))
				else
					ls_temp = left(ls_temp, 40)
				end if
			else
				ls_temp = left(ls_temp, 40)
			end if
			parent.parent.parent.is_lcditem = ls_temp
			if isnull(parent.parent.parent.is_lcditem) then
				parent.parent.parent.is_lcditem = ""
			end if
			parent.parent.parent.ic_comport.postevent("ue_show")
		else
			ls_holdstr = this.object.itemname[currentrow]
			if len(ls_holdstr) < 19 then
				ls_temp = ls_holdstr + space(19 - len(ls_holdstr))
			else
				ls_temp = left(ls_holdstr, 19)
			end if
			ls_temp = ls_temp + " Qty=" + string(this.object.looseqty[currentrow], f_setcolumnformat("Qty"))
			ls_temp = ls_temp + " Rs=" + string(this.object.saleprice[currentrow], "#######0.00")
			if len(ls_temp) <= 39 then
				if 39 - len(ls_temp) > 0 then
					ls_temp = ls_temp + space(39 - len(ls_temp))
				else
					ls_temp = left(ls_temp, 39)
				end if
			else
				ls_temp = left(ls_temp, 39)
			end if
			parent.parent.parent.is_lcditem = ls_temp
		end if
		parent.parent.parent.ic_comport.postevent("ue_show")
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	integer li_rowno
	integer i
	boolean lb_duplicate
	string ls_qty_protect
	ls_qty_protect = describe("looseqty.protect")
	if getrow() = rowcount() then
		if getcolumn() = 1 then
			if accepttext() = -1 then
				return 1
			end if
			if not isnull(this.object.fullcode[getrow()]) then
				parent.parent.parent.event ue_newitem()
				return 1
			end if
			return
		end if
		if ls_qty_protect = "1" and (getcolumnname() = "gcode" or getcolumnname() = "saleprice" or getcolumnname() = "discperc") then
			parent.parent.parent.event ue_newitem()
			return 1
		elseif ls_qty_protect = "1" and getcolumnname() = "itemname" then
			if accepttext() = -1 then
				return 1
			end if
			parent.parent.parent.event ue_newitem()
			return 1
		elseif getcolumn() = integer(this.object.datawindow.column.count) then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
	elseif not (gs_company = "SHE" and parent.parent.parent.ii_saletype = 2) and getcolumn() = integer(this.object.datawindow.column.count) then
		scrollnextrow()
		if f_stringpreferences("ItemCode") = "Y" then
			setcolumn(1)
		else
			setcolumn(2)
		end if
		setfocus()
		return 1
	end if
	li_rowno = gd_itemsinfo.find("fullcode='" + parent.parent.parent.is_aliasname + "'", 1, gd_itemsinfo.rowcount())
	if getcolumn() = 1 and li_rowno > 0 then
		if gs_company = "SHE" and parent.parent.parent.ii_saletype = 2 then
			parent.parent.parent.id_detail.setcolumn(integer(this.object.datawindow.column.count) - 3)
		else
			parent.parent.parent.id_detail.setcolumn(integer(this.object.datawindow.column.count))
		end if
		setfocus()
		return 1
	end if
	if getcolumnname() = "itemname" then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	if getcolumn() = 1 then
		parent.parent.parent.is_aliasname = data
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_focusqty() returns 0 [event]
	call super::ue_focusqty

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	integer li_res
	integer li_errcode
	long ll_null
	long ll_currrow
	long ll_listcurrrow
	long ll_icode
	long ll_found
	long ll_rowm
	long ll_itemcodetype
	string ls_itemname
	string ls_null
	double ld_saleprice
	s_datastore lstr_ds
	s_popup_selection lstr_selection
	setnull(ll_null)
	setnull(ls_null)
	if keyflags = 2 and key = keyf5! then
		parent.parent.parent.wf_show_itemgallery()
		rt_code = 1
		return rt_code
	end if
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollnextrow()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyuparrow! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollpriorrow()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keypagedown! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollnextpage()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keypageup! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollpriorpage()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyend! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrolltorow(99999)
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyhome! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrolltorow(1)
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf4! then
			if f_rightexists(5052) then
				parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
				setredraw(true)
			elseif getrow() > 0 then
				if not (parent.parent.parent.id_detail.object.icode[getrow()] > 0 and parent.parent.parent.id_detail.object.icode[getrow()] = parent.parent.parent.id_detail.object.itemcode[getrow()]) then
					parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
					setredraw(true)
				end if
			end if
		elseif key = keyf7! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			lstr_ds.s_name1 = gd_popup_itemsinfo.dataobject
			lstr_ds.s_name2 = "name"
			openwithparm(w_popup_responsivesearch_selection, lstr_ds)
			lstr_selection = message.powerobjectparm
			if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(lstr_selection.l_code2), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 and ll_found <= parent.parent.parent.id_itemslist.rowcount() then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf8! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("namesearch", parent.parent.parent.ii_module)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf9! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("criteriasearch", parent.parent.parent.ii_module)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
			setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
			setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		elseif rt_code = 2 then
			ll_rowm = getrow()
			parent.parent.parent.id_itemslist.selectrow(0, false)
			if getrow() > 0 then
				ll_listcurrrow = parent.parent.parent.id_itemslist.find("itemname = '" + this.object.itemname[ll_rowm] + "'", 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_listcurrrow > 0 and ll_listcurrrow <= parent.parent.parent.id_itemslist.rowcount() then
					parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
					setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
					setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
					setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
					selecttext(1, len(gettext()))
					parent.parent.parent.ib_itemvalidated = true
					parent.parent.parent.il_currrow = ll_rowm
					setitem(ll_rowm, "CurrListRow", ll_listcurrrow)
					setredraw(true)
				end if
				rt_code = 0
			end if
		end if
	elseif key = keydownarrow! then
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_focusfooter")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	elseif key = keyf6! then
		parent.parent.parent.wf_adjustitemqty()
		rt_code = 1
	elseif key = keyf8! then
		if rowcount() > 1 then
			if isnull(this.object.icode[rowcount()]) then
				scrolltorow(rowcount() - 1)
			elseif not isnull(this.object.icode[rowcount()]) then
				scrolltorow(rowcount())
			end if
			event ue_focusqty()
			selecttext(1, len(gettext()))
		elseif rowcount() = 1 then
			scrolltorow(rowcount())
			event ue_focusqty()
			selecttext(1, len(gettext()))
		end if
		rt_code = 1
	elseif key = keyf9! then
		parent.parent.parent.wf_show_sets()
		rt_code = 1
	end if
	if getcolumnname() = "looseqty" and key = keyf11! then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
		setredraw(true)
		ll_icode = getitemnumber(getrow(), "icode")
		ld_saleprice = f_drilldown_batchsearch("batchsearch", ll_icode)
		setitem(getrow(), "saleprice", ld_saleprice)
		setfocus()
		rt_code = 1
	end if
	if getcolumnname() = "fullcode" and key = keyf5! then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
		setredraw(true)
		ll_icode = f_drilldown_itemsearch("aliasnamesearch", parent.parent.parent.ii_module)
		if ll_icode > 0 then
			ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
			if ll_found > 0 then
				ll_listcurrrow = ll_found
				parent.parent.parent.id_itemslist.selectrow(0, false)
				rt_code = 1
			end if
		end if
		setfocus()
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			ll_rowm = getrow()
			if ll_rowm > 0 then
				setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
				setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				selecttext(1, len(gettext()))
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = ll_rowm
			end if
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	end if
	if (getcolumnname() = "fullcode" or getcolumnname() = "itemname") and key = keyf6! then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
		setredraw(true)
		lstr_ds.s_name1 = gd_popup_itemsinfo.dataobject
		lstr_ds.s_name2 = "name"
		if getcolumn() = 1 then
			lstr_ds.s_name3 = parent.parent.parent.is_aliasname
		else
			lstr_ds.s_name3 = parent.parent.parent.is_name_value
		end if
		openwithparm(w_popup_responsivesearch_selection_aa, lstr_ds)
		lstr_selection = message.powerobjectparm
		if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
			ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(lstr_selection.l_code2), 1, parent.parent.parent.id_itemslist.rowcount())
			if ll_found > 0 and ll_found <= parent.parent.parent.id_itemslist.rowcount() then
				ll_listcurrrow = ll_found
				parent.parent.parent.id_itemslist.selectrow(0, false)
				rt_code = 1
			end if
		end if
		setfocus()
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			ll_rowm = getrow()
			if ll_rowm > 0 then
				setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
				setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				setitem(ll_rowm, "alternatecustomicode", lstr_selection.s_name2)
				ll_itemcodetype = lstr_selection.l_code3
				li_res = parent.parent.parent.wf_findfullcode(lstr_selection.s_name2, ll_icode, ls_itemname, ll_itemcodetype, parent.parent.parent.idbl_packqty, parent.parent.parent.idbl_purprice, parent.parent.parent.idbl_saleprice)
				if li_res > 0 then
					if parent.parent.parent.idbl_packqty <= 0.0 or isnull(parent.parent.parent.idbl_packqty) then
						parent.parent.parent.idbl_packqty = 1
					end if
					setitem(ll_rowm, "icode", ll_icode)
					setitem(ll_rowm, "itemname", ls_itemname)
					setitem(ll_rowm, "looseqty", parent.parent.parent.idbl_packqty)
					if ll_itemcodetype = 2 then
						setitem(ll_rowm, "alternatecustomicode", lstr_selection.s_name2)
						setitem(ll_rowm, "rate", parent.parent.parent.idbl_saleprice / parent.parent.parent.idbl_packqty)
						setitem(ll_rowm, "packsaleprice", parent.parent.parent.idbl_saleprice)
						setitem(ll_rowm, "packprice", parent.parent.parent.idbl_saleprice)
						setitem(ll_rowm, "saleprice", parent.parent.parent.idbl_saleprice / parent.parent.parent.idbl_packqty)
					else
						setitem(ll_rowm, "alternatecustomicode", ls_null)
					end if
					parent.parent.parent.ib_itemvalidated = false
					parent.parent.parent.il_currrow = ll_rowm
					li_errcode = 0
					if parent.parent.parent.wf_validateitem(false) = 0 then
						li_errcode = 0
					else
						li_errcode = 1
					end if
				else
					messagebox("Item Code/Alias Name Validation", "Item does not exist")
					setitem(ll_rowm, "icode", ll_null)
					setitem(ll_rowm, "fullcode", ls_null)
					li_errcode = 1
				end if
				selecttext(1, len(gettext()))
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = ll_rowm
			end if
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	end if
	if getcolumnname() = "fullcode" and (key = keyf7! or key = keyf4!) then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
		setredraw(true)
		lstr_ds.s_name1 = gd_popup_itemsinfo.dataobject
		if key = keyf4! then
			lstr_ds.s_name2 = "aliasname"
		else
			lstr_ds.s_name2 = "aliasname"
		end if
		openwithparm(w_popup_responsivesearch_selection, lstr_ds)
		lstr_selection = message.powerobjectparm
		if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
			ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(lstr_selection.l_code2), 1, parent.parent.parent.id_itemslist.rowcount())
			if ll_found > 0 and ll_found <= parent.parent.parent.id_itemslist.rowcount() then
				ll_listcurrrow = ll_found
				parent.parent.parent.id_itemslist.selectrow(0, false)
				rt_code = 1
			end if
		end if
		setfocus()
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			ll_rowm = getrow()
			if ll_rowm > 0 then
				setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
				setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				selecttext(1, len(gettext()))
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = ll_rowm
			end if
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	end if
	return rt_code

// tabpage_list.create() returns 0 [event]
	integer icurrent
	this.st_3 = create st_3
	this.em_invno = create em_invno
	call super::create
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_3
	this.control[icurrent + 2] = this.em_invno

// tabpage_list.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_3
	destroy this.em_invno

// dw_find.keypressed(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	long ll_row
	ancestorreturnvalue = super::keypressed(key, keyflags)
	if keyflags = 2 and key = keyf8! then
		ll_row = parent.parent.parent.id_list.getrow()
		if ll_row > 0 then
			parent.parent.parent.wf_unfiscalize()
			setfocus()
		end if
	end if
	return ::message.returnvalue

// em_invno.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		parent.parent.parent.tab_retrieve.selecttab(1)
	end if
	return ::message.returnvalue

// ic_comport.ue_show() returns long [event]
	string ls_line
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	try
		if isnull(parent.is_lcditem) then
			if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
				parent.is_lcditem = char(26) + char(1)
				parent.ic_comport.triggerevent("ue_show")
				parent.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
				parent.ic_comport.triggerevent("ue_show")
				return 1
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
				parent.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
				return 1
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "TYSSO VFD-860-A" then
				parent.is_lcditem = space(5) + "THANK YOU" + space(6) + space(3) + "FOR YOUR VISIT" + space(3)
				return 1
			else
				parent.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
			end if
		end if
		if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
			parent.wf_pd_initialize()
			pd_writepd(ls_line, len(ls_line))
			if not isnull(parent.is_lcditem) then
				pd_writepd(parent.is_lcditem, len(parent.is_lcditem))
			end if
			ls_line = char(27) + char(72) + char(20)
			pd_writepd(ls_line, len(ls_line))
			if not isnull(parent.is_lcditem2) then
				pd_writepd(parent.is_lcditem2, len(parent.is_lcditem2))
			end if
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
			return 1
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "TYSSO VFD-860-A" then
			this.object.portopen = true
			if isnull(parent.is_lcditem) then
				parent.is_lcditem = space(5) + "THANK YOU" + space(6) + space(3) + "FOR YOUR VISIT" + space(3)
			end if
			this.object.output = parent.is_lcditem
			this.object.portopen = false
		else
			this.object.portopen = true
			if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
				this.object.output = char(26) + parent.is_lcditem
			elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
				this.object.output = char(12) + parent.is_lcditem
			else
				this.object.output = char(12) + parent.is_lcditem
			end if
			this.object.portopen = false
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try
	return 1

// ic_comport.constructor() returns long [event]
	integer li_defaultcomport
	integer li_status
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	try
		if f_stringpreferences("DisplayPool") = "Y" then
			if upper(f_stringpreferences("DisplayPoolCompany")) = "POSIFLEX PD-2600 SERIES" then
				pd_openusbpd()
				li_status = pd_pdstate()
				if li_status = 0 then
					parent.wf_pd_initialize()
				end if
			elseif upper(f_stringpreferences("DisplayPoolCompany")) <> "BAYLAN VFD-860-A" then
				if upper(f_stringpreferences("DisplayPoolCompany")) = "TYSSO VFD-860-A" then
					li_defaultcomport = f_numberpreferences("DefaultComPort")
					if isnull(li_defaultcomport) then
						li_defaultcomport = 1
					end if
					this.object.commport = li_defaultcomport
					this.object.settings = "9600,N,8,1"
					this.object.inputlen = 0
				else
					li_defaultcomport = f_numberpreferences("DefaultComPort")
					if isnull(li_defaultcomport) then
						li_defaultcomport = 1
					end if
					this.object.commport = li_defaultcomport
					this.object.settings = "9600,N,8,1"
					this.object.inputlen = 0
				end if
			end if
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try
	return ::message.returnvalue

// ic_drawerport.constructor() returns long [event]
	integer li_defaultcomport
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	try
		if f_stringpreferences("CashDrawer") = "Y" then
			li_defaultcomport = f_numberpreferences("CashDrawerComPort")
			if isnull(li_defaultcomport) then
				li_defaultcomport = 1
			end if
			this.object.commport = li_defaultcomport
			this.object.settings = "300,N,8,1"
			this.object.inputlen = 0
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try
	return ::message.returnvalue

// ole_lcddisplay.constructor() returns long [event]
	integer li_defaultcomport
	integer li_status
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	try
		if f_stringpreferences("DisplayPool") = "Y" and upper(f_stringpreferences("DisplayPoolCompany")) = "BAYLAN VFD-860-A" then
			li_defaultcomport = f_numberpreferences("DefaultComPort")
			if isnull(li_defaultcomport) then
				li_defaultcomport = 1
			end if
			this.object.commport = li_defaultcomport
			this.object.settings = "9600,N,8,1"
			this.object.__invoke_method("startdisplay", 0, {}, true)
			this.object.welcomemsgl1 = "WELCOME TO"
			this.object.welcomemsgl2 = left(f_reportheaderinfo("clientname"), 19)
			this.object.welcomewait = 3
			this.object.greetingmsgl1 = "THANK YOU FOR"
			this.object.greetingmsgl2 = "SHOPPING WITH US"
			this.object.greetingwait = 3
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try
	return ::message.returnvalue
