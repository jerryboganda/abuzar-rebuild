// m_save.clicked() returns 0 [event]
	boolean lb_saveright
	long ll_counter
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 531 then
			lb_saveright = true
		end if
	next
	if lb_saveright = false then
		messagebox("Save", "Press Ctrl + P  for Save and Print")
		return
	end if
	this.parentwindow.triggerevent("ue_save")
	if this.parentwindow.dynamic wf_commitform() = true then
		this.parentwindow.postevent("ue_new")
	end if

