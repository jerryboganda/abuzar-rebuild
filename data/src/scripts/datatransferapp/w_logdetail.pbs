// window w_logdetail (datatransferapp)  ancestor: window

// w_logdetail.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	choose case key
	case keyescape!
		post event ue_close()
	end choose
	return ::message.returnvalue

// w_logdetail.ue_close() returns 0 [event]
	closewithreturn(this, 0)

// w_logdetail.ue_first() returns 0 [event]
	long ll_code
	ll_code = wf_first()
	wf_selectunselectrow(1)
	ll_code = this.dw_detail.retrieve(this.dw_master.object.transferlogid[this.il_selectedrow], this.dw_master.object.invoicecode[this.il_selectedrow], this.dw_master.object.invoicetype[this.il_selectedrow])
	if ll_code <> 0 then
		this.il_detailrow = 1
	end if

// w_logdetail.ue_next() returns 0 [event]
	long ll_code
	ll_code = wf_next()
	wf_selectunselectrow(this.dw_master.getrow())
	ll_code = this.dw_detail.retrieve(this.dw_master.object.transferlogid[this.il_selectedrow], this.dw_master.object.invoicecode[this.il_selectedrow], this.dw_master.object.invoicetype[this.il_selectedrow])
	if ll_code <> 0 then
		this.il_detailrow = 1
	end if

// w_logdetail.ue_previous() returns 0 [event]
	long ll_code
	ll_code = wf_previous()
	wf_selectunselectrow(this.dw_master.getrow())
	ll_code = this.dw_detail.retrieve(this.dw_master.object.transferlogid[this.il_selectedrow], this.dw_master.object.invoicecode[this.il_selectedrow], this.dw_master.object.invoicetype[this.il_selectedrow])
	if ll_code <> 0 then
		this.il_detailrow = 1
	end if

// w_logdetail.ue_last() returns 0 [event]
	long ll_code
	ll_code = wf_last()
	wf_selectunselectrow(this.dw_master.rowcount())
	ll_code = this.dw_detail.retrieve(this.dw_master.object.transferlogid[this.il_selectedrow], this.dw_master.object.invoicecode[this.il_selectedrow], this.dw_master.object.invoicetype[this.il_selectedrow])
	if ll_code <> 0 then
		this.il_detailrow = 1
	end if

// w_logdetail.wf_first() returns long
	long ret_val
	if this.dw_master.rowcount() > 0 then
		this.dw_master.scrolltorow(0)
		ret_val = this.dw_master.getrow()
	end if
	return ret_val

// w_logdetail.wf_last() returns long
	long ret_val
	this.dw_master.scrolltorow(this.dw_master.rowcount())
	ret_val = this.dw_master.getrow()
	return ret_val

// w_logdetail.wf_next() returns long
	long ret_val
	this.dw_master.scrollnextrow()
	ret_val = this.dw_master.getrow()
	return ret_val

// w_logdetail.wf_previous() returns long
	long ret_val
	this.dw_master.scrollpriorrow()
	ret_val = this.dw_master.getrow()
	return ret_val

// w_logdetail.wf_selectunselectrow(long row) returns 0
	if row > 0 then
		this.il_selectedrow = row
	end if
	if this.dw_master.rowcount() > 0 and this.il_selectedrow <> 0 then
		this.dw_master.selectrow(0, false)
		this.dw_master.selectrow(this.il_selectedrow, true)
	end if

// w_logdetail.create() returns 0 [event]
	this.dw_footer = create dw_footer
	this.dw_detail = create dw_detail
	this.dw_master = create dw_master
	this.control = {this.dw_footer, this.dw_detail, this.dw_master}

// w_logdetail.destroy() returns 0 [event]
	destroy this.dw_footer
	destroy this.dw_detail
	destroy this.dw_master

// w_logdetail.open() returns long [event]
	long ll_module
	long ll_rtcode
	long k
	long[] ll_longlist
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	this.istr_logdetail = message.powerobjectparm
	this.dw_master.settransobject(this.istr_logdetail.ta_transobj)
	this.dw_detail.settransobject(this.istr_logdetail.ta_transobj)
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	for k = 1 to upperbound(this.istr_logdetail.la_longlist)
		ll_longlist[k] = this.istr_logdetail.la_longlist[k]
	next
	ll_rtcode = this.dw_master.retrieve(ll_longlist)
	if ll_rtcode <> 0 then
		post event ue_first()
	end if
	f_setcolumnstyle(this.dw_detail, "Qty")
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_detail.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	long ll_row
	if key = keyuparrow! then
		if parent.il_detailrow <= parent.dw_detail.rowcount() then
			if parent.il_detailrow = 1 then
				ll_row = 1
			else
				ll_row = parent.il_detailrow - 1
				parent.dw_detail.setrow(ll_row)
				parent.dw_detail.scrolltorow(ll_row)
			end if
		end if
	elseif key = keydownarrow! then
		if parent.il_detailrow <= parent.dw_detail.rowcount() then
			if parent.il_detailrow = parent.dw_detail.rowcount() then
				ll_row = parent.il_detailrow
			else
				ll_row = parent.il_detailrow + 1
				parent.dw_detail.setrow(ll_row)
				parent.dw_detail.scrolltorow(ll_row)
			end if
		end if
	elseif key = keypagedown! then
		parent.dw_detail.scrollnextpage()
		ll_row = parent.dw_detail.getrow()
	elseif key = keypageup! then
		parent.dw_detail.scrollpriorpage()
		ll_row = parent.dw_detail.getrow()
	elseif key = keyhome! then
		scrolltorow(1)
		ll_row = 1
	elseif key = keyend! then
		ll_row = parent.dw_detail.rowcount()
		scrolltorow(ll_row)
	end if
	if ll_row > 0 and ll_row <= parent.dw_detail.rowcount() then
		parent.il_detailrow = ll_row
		parent.dw_detail.selectrow(0, false)
		parent.dw_detail.selectrow(parent.il_detailrow, true)
	end if
	return ::message.returnvalue

// dw_detail.getfocus() returns long [event]
	if parent.dw_detail.rowcount() > 0 then
		parent.dw_detail.selectrow(0, false)
		parent.dw_detail.selectrow(1, true)
		parent.il_detailrow = 1
	end if
	return ::message.returnvalue

// dw_detail.losefocus() returns long [event]
	if parent.dw_detail.rowcount() > 0 then
		parent.dw_detail.selectrow(0, false)
		parent.il_detailrow = 1
	end if
	return ::message.returnvalue

// dw_detail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	parent.dw_detail.selectrow(0, false)
	parent.dw_detail.selectrow(row, true)
	parent.il_detailrow = row
	return ::message.returnvalue

// dw_detail.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	parent.dw_detail.selectrow(0, false)
	parent.dw_detail.selectrow(row, true)
	parent.il_detailrow = row
	return ::message.returnvalue

// dw_master.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	integer li_movement
	long ll_row
	long ll_temp
	string sl_columnname
	if key = keyuparrow! then
		if parent.il_selectedrow <= parent.dw_master.rowcount() then
			if parent.il_selectedrow > 1 then
				ll_row = parent.il_selectedrow - 1
				parent.dw_master.scrolltorow(ll_row)
			else
				ll_row = parent.il_selectedrow
			end if
		end if
	elseif key = keydownarrow! then
		if parent.il_selectedrow <= parent.dw_master.rowcount() then
			if parent.il_selectedrow < parent.dw_master.rowcount() then
				ll_row = parent.il_selectedrow + 1
				parent.dw_master.scrolltorow(ll_row)
			else
				ll_row = parent.il_selectedrow
			end if
		end if
	elseif key = keypagedown! then
		parent.dw_master.scrollnextpage()
		ll_row = parent.dw_master.getrow()
	elseif key = keypageup! then
		parent.dw_master.scrollpriorpage()
		ll_row = parent.dw_master.getrow()
	elseif key = keyhome! then
		scrolltorow(1)
		ll_row = 1
	elseif key = keyend! then
		ll_row = parent.dw_master.rowcount()
		scrolltorow(ll_row)
	end if
	if ll_row > 0 and ll_row <= parent.dw_master.rowcount() then
		parent.dw_master.selectrow(0, false)
		parent.dw_master.selectrow(ll_row, true)
		parent.il_selectedrow = ll_row
		if parent.dw_master.rowcount() > 0 then
			parent.dw_detail.retrieve(parent.dw_master.object.transferlogid[parent.il_selectedrow], parent.dw_master.object.invoicecode[parent.il_selectedrow], parent.dw_master.object.invoicetype[parent.il_selectedrow])
		end if
	end if
	return ::message.returnvalue

// dw_master.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	parent.wf_selectunselectrow(row)
	if parent.dw_master.rowcount() > 0 then
		parent.dw_detail.retrieve(parent.dw_master.object.transferlogid[parent.il_selectedrow], parent.dw_master.object.invoicecode[parent.il_selectedrow], parent.dw_master.object.invoicetype[parent.il_selectedrow])
	end if
	return ::message.returnvalue

// dw_master.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	parent.wf_selectunselectrow(row)
	if parent.dw_master.rowcount() > 0 then
		parent.dw_detail.retrieve(parent.dw_master.object.transferlogid[parent.il_selectedrow], parent.dw_master.object.invoicecode[parent.il_selectedrow], parent.dw_master.object.invoicetype[parent.il_selectedrow])
	end if
	return ::message.returnvalue

// dw_master.losefocus() returns long [event]
	if parent.dw_master.rowcount() > 0 then
		parent.dw_master.selectrow(0, false)
	end if
	return ::message.returnvalue

// dw_master.getfocus() returns long [event]
	if parent.dw_master.rowcount() > 0 then
		parent.dw_master.selectrow(0, false)
		if parent.il_selectedrow <= parent.dw_master.rowcount() then
			parent.dw_master.selectrow(parent.il_selectedrow, true)
		else
			parent.il_selectedrow = 1
			parent.dw_master.selectrow(1, true)
		end if
	end if
	return ::message.returnvalue
