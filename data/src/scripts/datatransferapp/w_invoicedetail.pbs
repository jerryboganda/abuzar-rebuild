// w_invoicedetail.create() returns 0
	this.dw_footer = create dw_footer
	this.dw_detail = create dw_detail
	this.dw_master = create dw_master
	this.control = {this.dw_footer, this.dw_detail, this.dw_master}

// w_invoicedetail.destroy() returns 0
	destroy this.dw_footer
	destroy this.dw_detail
	destroy this.dw_master

// w_invoicedetail.open() returns long
	long ll_module
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	this.istr_invdetail = message.powerobjectparm
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		this.width = ll_win_width * 0.90
		this.height = ll_win_height * 0.95
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	choose case this.istr_invdetail.i_module
	case 1
		this.title = "Sale Invoice Detail"
		wf_assigndwobjects("d_saleheader_view", "d_saledetail_view", "d_salefooter_view")
		wf_setsalevisibility()
	case 2
		this.title = "Sale Return Detail"
		wf_assigndwobjects("d_salereturn_view", "d_salereturndetail_view", "d_salereturnfooter_view")
	case 3
		this.title = "Purchase Invoice Detail"
		wf_assigndwobjects("d_purchaseheader_view", "d_purchasedetail_view", "d_purchasefooter_view")
	case 4
		this.title = "Purchase Return Detail"
		wf_assigndwobjects("d_purchasereturn_view", "d_purchasereturndetail_view", "d_purchasereturnfooter_view")
	case 5
		this.title = "Issue/Delivery Challan"
		wf_assigndwobjects("d_issueheader_view", "d_issuedetail_view", "d_issuefooter_view")
	case 6
		this.title = "Receipt"
		wf_assigndwobjects("d_receiptheader_view", "d_receiptdetail_view", "d_receiptfooter_view")
	case 7
		this.title = "Stock Adjustment"
		wf_assigndwobjects("d_adjheader_view", "d_adjdetail_view", "d_adjfooter_view")
	case 8
		this.title = "Inter Godown Transfer Detail"
		wf_assigndwobjects("d_transfer_header_view", "d_transfer_detail_view", "d_transfer_footer_view")
	case 22
		this.title = "Services Sales"
		wf_assigndwobjects("d_serviceheader_view", "d_servicedetail_view", "d_servicefooter_view")
	case 28
		this.title = "Services Sales Return"
		wf_assigndwobjects("d_serviceRheader_view", "d_serviceRdetail_view", "d_serviceRfooter_view")
	case 43
		this.title = "Services Purchases"
		wf_assigndwobjects("d_servicepurheader_view", "d_servicepurdetail_view", "d_servicepurfooter_view")
	case 44
		this.title = "Services P/R"
		wf_assigndwobjects("d_serviceprheader_view", "d_serviceprdetail_view", "d_serviceprfooter_view")
	case 1001
		this.title = "Note Receivable/Payable"
		wf_assigndwobjects("d_notesheader_view", "d_notedetail_view", "d_notefooter_view")
	case 1002
		this.title = "Due Satisfy"
		wf_assigndwobjects("d_duesatisfy_header_view", "d_duesatisfy_detail_view", "d_duesatisfy_footer_view")
	case 1003
		this.title = "Due Satisfy"
		wf_assigndwobjects("d_duesatisfy_header_view", "d_duedelete_detail_view", "d_duesatisfy_footer_view")
	case else
		this.title = "A/C Vouchers"
		wf_assigndwobjects("d_voucherheader_view", "d_voucherdetail_view", "d_voucherfooter_view")
		wf_setvouchervisibility()
	end choose
	f_setcolumnstyle(this.dw_detail, "Qty")
	this.dw_master.retrieve(this.istr_invdetail.l_invcode)
	this.dw_detail.retrieve(this.istr_invdetail.l_invcode)
	this.dw_footer.retrieve(this.istr_invdetail.l_invcode)
	this.dw_master.x = 0
	this.dw_detail.x = 0
	this.dw_footer.x = 0
	this.dw_master.width = this.width - 10
	this.dw_detail.width = this.width - 10
	this.dw_footer.width = this.width - 10
	this.dw_detail.height = this.height - (this.dw_master.height + this.dw_footer.height) - 100
	this.dw_footer.y = this.dw_detail.y + this.dw_detail.height + 5
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue
