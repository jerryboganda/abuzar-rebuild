	else
		this.dw_detail.object.unitweight.visible = true
		this.dw_detail.object.c_item_unitweight.visible = true
	end if
	if f_stringpreferences("ShowPackingFactorInSale") = "N" then
		this.dw_detail.object.packingfactor.visible = false
