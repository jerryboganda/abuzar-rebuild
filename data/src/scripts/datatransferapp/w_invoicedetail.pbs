// window w_invoicedetail (datatransferapp)  ancestor: window

// w_invoicedetail.ue_keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		post event ue_close()
	end if
	return ::message.returnvalue

// w_invoicedetail.ue_close() returns 0
	closewithreturn(this, 0)

// w_invoicedetail.wf_assigndwobjects(string as_masterdw, string as_detaildw, string as_footerdw) returns 0
	this.dw_master.dataobject = as_masterdw
	this.dw_detail.dataobject = as_detaildw
	this.dw_footer.dataobject = as_footerdw
	this.dw_master.settransobject(sqlca)
	this.dw_detail.settransobject(sqlca)
	this.dw_footer.settransobject(sqlca)

// w_invoicedetail.wf_setvouchervisibility() returns long
	if f_stringpreferences("ShowCurrentBalanceInTrans") = "N" then
		this.dw_detail.object.c_balance.visible = false
		this.dw_detail.object.c_balance_type.visible = false
	end if
	if f_stringpreferences("ShowEffectiveBalanceInTrans") = "N" then
		this.dw_detail.object.c_effective_balance.visible = false
		this.dw_detail.object.c_effective_balance_type.visible = false
	end if
	if f_stringpreferences("ShowCurrencyInVouchers") = "N" then
		this.dw_master.object.currencycode.visible = false
		this.dw_master.object.currencycode_t.visible = false
		this.dw_master.object.conversionrate.visible = false
		this.dw_master.object.conversionrate_t.visible = false
		this.dw_detail.object.foreignamt.visible = false
	end if
	if f_stringpreferences("PatientInTransaction") = "N" then
		this.dw_detail.object.regno.visible = false
		this.dw_detail.object.patient.visible = false
	end if
	if f_stringpreferences("GuestInTransaction") = "N" then
		this.dw_detail.object.guestregno.visible = false
		this.dw_detail.object.guest.visible = false
	end if
	if f_stringpreferences("StudentInTransaction") = "N" then
		this.dw_detail.object.studentregno.visible = false
		this.dw_detail.object.student.visible = false
	end if
	if f_stringpreferences("SalePersonInTrans") = "Y" then
		this.dw_master.object.smancode.visible = true
		this.dw_master.object.smancode_t.visible = true
	end if
	return 0

