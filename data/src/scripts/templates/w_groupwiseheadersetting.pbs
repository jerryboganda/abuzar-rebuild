// w_groupwiseheadersetting.open() returns long [event]
	long ll_groupcode
	long ll_row
	long ll_totrows
	long ll_module
	long ll_headercode
	long ll_found
	string ls_datawindow
	string ls_headername
	string ls_headeralias
	ll_groupcode = message.doubleparm
	for ll_row = 1 to gds_reoprtheaderinfo.rowcount()
		ll_headercode = gds_reoprtheaderinfo.getitemnumber(ll_row, "headerno")
		ls_headername = gds_reoprtheaderinfo.getitemstring(ll_row, "clientname")
		ls_headeralias = gds_reoprtheaderinfo.getitemstring(ll_row, "remarks")
		wf_insertheaderinfo(this.dw_groupallowedheader_sale, ll_headercode, ls_headername, ls_headeralias, ll_groupcode, 1)
		wf_insertheaderinfo(this.dw_groupallowedheader_salereturn, ll_headercode, ls_headername, ls_headeralias, ll_groupcode, 2)
		wf_insertheaderinfo(this.dw_groupallowedheader_purchase, ll_headercode, ls_headername, ls_headeralias, ll_groupcode, 3)
		wf_insertheaderinfo(this.dw_groupallowedheader_purchasereturn, ll_headercode, ls_headername, ls_headeralias, ll_groupcode, 4)
		wf_insertheaderinfo(this.dw_groupallowedheader_issue, ll_headercode, ls_headername, ls_headeralias, ll_groupcode, 5)
		wf_insertheaderinfo(this.dw_groupallowedheader_receipt, ll_headercode, ls_headername, ls_headeralias, ll_groupcode, 6)
		wf_insertheaderinfo(this.dw_groupallowedheader_adjustment, ll_headercode, ls_headername, ls_headeralias, ll_groupcode, 7)
		wf_insertheaderinfo(this.dw_groupallowedheader_transfer, ll_headercode, ls_headername, ls_headeralias, ll_groupcode, 8)
		wf_insertheaderinfo(this.dw_groupallowedheader_saleorder, ll_headercode, ls_headername, ls_headeralias, ll_groupcode, 12)
		wf_insertheaderinfo(this.dw_groupallowedheader_quotation, ll_headercode, ls_headername, ls_headeralias, ll_groupcode, 15)
		wf_insertheaderinfo(this.dw_groupallowedheader_advancedsale, ll_headercode, ls_headername, ls_headeralias, ll_groupcode, 21)
		wf_insertheaderinfo(this.dw_groupallowedheader_servicepur, ll_headercode, ls_headername, ls_headeralias, ll_groupcode, 43)
		wf_insertheaderinfo(this.dw_groupallowedheader_servicepr, ll_headercode, ls_headername, ls_headeralias, ll_groupcode, 44)
		wf_insertheaderinfo(this.dw_groupallowedheader_servicesale, ll_headercode, ls_headername, ls_headeralias, ll_groupcode, 51)
		wf_insertheaderinfo(this.dw_groupallowedheader_servicesr, ll_headercode, ls_headername, ls_headeralias, ll_groupcode, 52)
	next
	this.dw_groupinfo.settransobject(sqlca)
	this.dw_groupallowedheaderdetail.settransobject(sqlca)
	this.dw_groupinfo.retrieve(ll_groupcode)
	ll_row = this.dw_groupinfo.rowcount()
	if ll_row <= 0 then
		messagebox("Database Error", "Problem occured at database.")
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ll_groupcode = this.dw_groupinfo.getitemnumber(ll_row, "code")
	this.dw_groupallowedheaderdetail.retrieve(ll_groupcode)
	for ll_row = 1 to this.dw_groupallowedheaderdetail.rowcount()
		choose case this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "module")
		case 1.0
			ll_found = this.dw_groupallowedheader_sale.find("headercode = " + trim(string(this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "headercode"))), 1, this.dw_groupallowedheader_sale.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedheader_sale.setitem(ll_found, "allowed", 1)
				this.dw_groupallowedheader_sale.setitem(ll_found, "priority", this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "priority"))
			end if
		case 2.0
			ll_found = this.dw_groupallowedheader_salereturn.find("headercode = " + trim(string(this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "headercode"))), 1, this.dw_groupallowedheader_salereturn.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedheader_salereturn.setitem(ll_found, "allowed", 1)
				this.dw_groupallowedheader_salereturn.setitem(ll_found, "priority", this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "priority"))
			end if
		case 3.0
			ll_found = this.dw_groupallowedheader_purchase.find("headercode = " + trim(string(this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "headercode"))), 1, this.dw_groupallowedheader_purchase.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedheader_purchase.setitem(ll_found, "allowed", 1)
				this.dw_groupallowedheader_purchase.setitem(ll_found, "priority", this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "priority"))
			end if
		case 4.0
			ll_found = this.dw_groupallowedheader_purchasereturn.find("headercode = " + trim(string(this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "headercode"))), 1, this.dw_groupallowedheader_purchasereturn.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedheader_purchasereturn.setitem(ll_found, "allowed", 1)
				this.dw_groupallowedheader_purchasereturn.setitem(ll_found, "priority", this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "priority"))
			end if
		case 5.0
			ll_found = this.dw_groupallowedheader_issue.find("headercode = " + trim(string(this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "headercode"))), 1, this.dw_groupallowedheader_issue.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedheader_issue.setitem(ll_found, "allowed", 1)
				this.dw_groupallowedheader_issue.setitem(ll_found, "priority", this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "priority"))
			end if
		case 6.0
			ll_found = this.dw_groupallowedheader_receipt.find("headercode = " + trim(string(this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "headercode"))), 1, this.dw_groupallowedheader_receipt.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedheader_receipt.setitem(ll_found, "allowed", 1)
				this.dw_groupallowedheader_receipt.setitem(ll_found, "priority", this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "priority"))
			end if
		case 7.0
			ll_found = this.dw_groupallowedheader_adjustment.find("headercode = " + trim(string(this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "headercode"))), 1, this.dw_groupallowedheader_adjustment.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedheader_adjustment.setitem(ll_found, "allowed", 1)
				this.dw_groupallowedheader_adjustment.setitem(ll_found, "priority", this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "priority"))
			end if
		case 8.0
			ll_found = this.dw_groupallowedheader_transfer.find("headercode = " + trim(string(this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "headercode"))), 1, this.dw_groupallowedheader_transfer.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedheader_transfer.setitem(ll_found, "allowed", 1)
				this.dw_groupallowedheader_transfer.setitem(ll_found, "priority", this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "priority"))
			end if
		case 12.0
			ll_found = this.dw_groupallowedheader_saleorder.find("headercode = " + trim(string(this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "headercode"))), 1, this.dw_groupallowedheader_saleorder.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedheader_saleorder.setitem(ll_found, "allowed", 1)
				this.dw_groupallowedheader_saleorder.setitem(ll_found, "priority", this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "priority"))
			end if
		case 15.0
			ll_found = this.dw_groupallowedheader_quotation.find("headercode = " + trim(string(this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "headercode"))), 1, this.dw_groupallowedheader_quotation.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedheader_quotation.setitem(ll_found, "allowed", 1)
				this.dw_groupallowedheader_quotation.setitem(ll_found, "priority", this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "priority"))
			end if
		case 21.0
			ll_found = this.dw_groupallowedheader_advancedsale.find("headercode = " + trim(string(this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "headercode"))), 1, this.dw_groupallowedheader_advancedsale.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedheader_advancedsale.setitem(ll_found, "allowed", 1)
				this.dw_groupallowedheader_advancedsale.setitem(ll_found, "priority", this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "priority"))
			end if
		case 43.0
			ll_found = this.dw_groupallowedheader_servicepur.find("headercode = " + trim(string(this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "headercode"))), 1, this.dw_groupallowedheader_servicepur.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedheader_servicepur.setitem(ll_found, "allowed", 1)
				this.dw_groupallowedheader_servicepur.setitem(ll_found, "priority", this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "priority"))
			end if
		case 44.0
			ll_found = this.dw_groupallowedheader_servicepr.find("headercode = " + trim(string(this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "headercode"))), 1, this.dw_groupallowedheader_servicepr.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedheader_servicepr.setitem(ll_found, "allowed", 1)
				this.dw_groupallowedheader_servicepr.setitem(ll_found, "priority", this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "priority"))
			end if
		case 51.0
			ll_found = this.dw_groupallowedheader_servicesale.find("headercode = " + trim(string(this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "headercode"))), 1, this.dw_groupallowedheader_servicesale.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedheader_servicesale.setitem(ll_found, "allowed", 1)
				this.dw_groupallowedheader_servicesale.setitem(ll_found, "priority", this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "priority"))
			end if
		case 52.0
			ll_found = this.dw_groupallowedheader_servicesr.find("headercode = " + trim(string(this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "headercode"))), 1, this.dw_groupallowedheader_servicesr.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedheader_servicesr.setitem(ll_found, "allowed", 1)
				this.dw_groupallowedheader_servicesr.setitem(ll_found, "priority", this.dw_groupallowedheaderdetail.getitemnumber(ll_row, "priority"))
			end if
		end choose
	next
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_groupwiseheadersetting.close() returns long [event]
	close(this)
	return ::message.returnvalue

// w_groupwiseheadersetting.activate() returns long [event]
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.post event Close()
	return ::message.returnvalue

// cb_save.clicked() returns long [event]
	parent.post event ue_save()
	return ::message.returnvalue
