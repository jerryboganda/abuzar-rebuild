// window w_groupwiseheadersetting (templates)  ancestor: window

// w_groupwiseheadersetting.ue_save() returns 0 [event]
	long ll_row
	long ll_totrows
	long ll_rowcount
	long ll_retval
	setpointer(hourglass!)
	if f_validatedw(this.dw_groupinfo) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedheader_sale) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedheader_salereturn) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedheader_purchase) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedheader_purchasereturn) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedheader_issue) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedheader_receipt) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedheader_adjustment) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedheader_transfer) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedheader_saleorder) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedheader_quotation) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedheader_advancedsale) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedheader_servicesale) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedheader_servicesr) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedheader_servicepur) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedheader_servicepr) < 0 then
		return
	end if
	ll_totrows = this.dw_groupallowedheaderdetail.rowcount()
	ll_row = 0
	do while ll_totrows > 0 and ll_row <= ll_totrows
		this.dw_groupallowedheaderdetail.deleterow(0)
		ll_row = ll_row + 1
	loop
	ll_retval = wf_getgroupallowedheader(this.dw_groupallowedheader_sale, this.dw_groupallowedheaderdetail)
	ll_retval = wf_getgroupallowedheader(this.dw_groupallowedheader_salereturn, this.dw_groupallowedheaderdetail)
	ll_retval = wf_getgroupallowedheader(this.dw_groupallowedheader_purchase, this.dw_groupallowedheaderdetail)
	ll_retval = wf_getgroupallowedheader(this.dw_groupallowedheader_purchasereturn, this.dw_groupallowedheaderdetail)
	ll_retval = wf_getgroupallowedheader(this.dw_groupallowedheader_issue, this.dw_groupallowedheaderdetail)
	ll_retval = wf_getgroupallowedheader(this.dw_groupallowedheader_receipt, this.dw_groupallowedheaderdetail)
	ll_retval = wf_getgroupallowedheader(this.dw_groupallowedheader_adjustment, this.dw_groupallowedheaderdetail)
	ll_retval = wf_getgroupallowedheader(this.dw_groupallowedheader_transfer, this.dw_groupallowedheaderdetail)
	ll_retval = wf_getgroupallowedheader(this.dw_groupallowedheader_saleorder, this.dw_groupallowedheaderdetail)
	ll_retval = wf_getgroupallowedheader(this.dw_groupallowedheader_quotation, this.dw_groupallowedheaderdetail)
	ll_retval = wf_getgroupallowedheader(this.dw_groupallowedheader_advancedsale, this.dw_groupallowedheaderdetail)
	ll_retval = wf_getgroupallowedheader(this.dw_groupallowedheader_servicepur, this.dw_groupallowedheaderdetail)
	ll_retval = wf_getgroupallowedheader(this.dw_groupallowedheader_servicepr, this.dw_groupallowedheaderdetail)
	ll_retval = wf_getgroupallowedheader(this.dw_groupallowedheader_servicesale, this.dw_groupallowedheaderdetail)
	ll_retval = wf_getgroupallowedheader(this.dw_groupallowedheader_servicesr, this.dw_groupallowedheaderdetail)
	if this.dw_groupallowedheaderdetail.update() > 0 then
		SQL commit USING sqlca;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		setpointer(arrow!)
		post event Close()
	else
		SQL rollback USING sqlca;
		setpointer(arrow!)
		messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs", exclamation!, ok!, 1)
		return
	end if
	setpointer(arrow!)

// w_groupwiseheadersetting.wf_validategroupallowedheader(ref datawindow ad_grouplist) returns integer
	long ll_totrows
	long ll_row
	long ll_retval
	ll_totrows = ad_grouplist.rowcount()
	ll_row = 1
	ll_retval = 0
	do while ll_totrows <> 0 and ll_row <= ll_totrows
		if ad_grouplist.object.allowed[ll_row] = 1 then
			ll_retval = ll_row
			return ll_retval
		end if
		ll_row = ll_row + 1
	loop
	return ll_retval

// w_groupwiseheadersetting.wf_insertheaderinfo(ref datawindow adw_targetdw, long al_headercode, string as_headername, string as_headeralias, long al_groupcode, integer ai_module) returns 0
	long ll_row
	ll_row = adw_targetdw.insertrow(0)
	adw_targetdw.object.groupcode[ll_row] = al_groupcode
	adw_targetdw.object.header[ll_row] = as_headername
	adw_targetdw.object.headeralias[ll_row] = as_headeralias
	adw_targetdw.object.headercode[ll_row] = al_headercode
	adw_targetdw.object.allowed[ll_row] = 0
	adw_targetdw.object.module[ll_row] = ai_module
	adw_targetdw.object.priority[ll_row] = 10

// w_groupwiseheadersetting.wf_getgroupallowedheader(ref datawindow ad_sourcedw, ref datawindow ad_targetdw) returns long
	long ll_totrows
	long ll_row
	long ll_newrow
	ll_totrows = ad_sourcedw.rowcount()
	ll_row = 1
	do while ll_totrows <> 0 and ll_row <= ll_totrows
		if ad_sourcedw.object.allowed[ll_row] = 1 then
			ll_newrow = ad_targetdw.insertrow(0)
			ad_targetdw.object.groupcode[ll_newrow] = ad_sourcedw.object.groupcode[ll_row]
			ad_targetdw.object.headercode[ll_newrow] = ad_sourcedw.object.headercode[ll_row]
			ad_targetdw.object.module[ll_newrow] = ad_sourcedw.object.module[ll_row]
			ad_targetdw.object.allowed[ll_newrow] = ad_sourcedw.object.allowed[ll_row]
			ad_targetdw.object.priority[ll_newrow] = ad_sourcedw.object.priority[ll_row]
		end if
		ll_row = ll_row + 1
	loop
	return 1

