// window w_saletemplate_saleestimates (templates)  ancestor: window

// w_saletemplate_saleestimates.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// w_saletemplate_saleestimates.wf_adjust_sale_template() returns integer
	long ll_counter
	long ll_found
	long ll_lastfound
	long ll_updcount
	long ll_inscount
	long ll_groupcode
	long ll_groupcode2
	long ll_code
	long ll_icode
	long ll_saleinvcode
	long ll_counter2
	long ll_insrow
	long ll_rowcount
	long ll_row
	long ll_newrows
	long ll_counter3
	long ll_stockcount
	long ll_delcount
	long ll_delcounter
	long ll_invcount
	double ld_reqvalue
	double ld_satisfiedvalue
	double ld_stock
	double ld_this_value
	double ld_value
	double ld_difftoadd
	double ld_prefferedsaleqty
	double ld_saleprice
	boolean lb_ok
	string ls_grouping
	datastore lds_templateitems
	datastore lds_stockitems
	setpointer(hourglass!)
	setredraw(false)
	lds_templateitems = create datastore
	lds_stockitems = create datastore
	ll_code = this.istr_arg.l_code1
	ls_grouping = this.istr_arg.s_name1
	lds_templateitems.dataobject = "d_saletemplate_detail_saleestimates"
	lds_templateitems.settransobject(this.it_transobject)
	lds_templateitems.retrieve(this.istr_arg.s_name1, this.istr_arg.l_code1)
	this.dw_selection.setfilter("RequiredValue <= Value")
	this.dw_selection.filter()
	if lds_templateitems.rowcount() > 0 and this.dw_selection.rowcount() >= 0 then
		for ll_counter = 1 to lds_templateitems.rowcount()
			lds_templateitems.object.marked[ll_counter] = "Y"
		next
		ll_counter = 1
		for ll_counter = 1 to this.dw_selection.rowcount()
			ll_groupcode = this.dw_selection.object.groupcode[ll_counter]
			ld_reqvalue = this.dw_selection.object.requiredvalue[ll_counter]
			ld_value = this.dw_selection.object.value[ll_counter]
			ld_satisfiedvalue = 0
			ll_found = 0
			ll_lastfound = 0
			if ld_reqvalue = 0.0 then
				lds_templateitems.setfilter("groupcode= " + trim(string(ll_groupcode)))
				lds_templateitems.filter()
				for ll_delcounter = 1 to lds_templateitems.rowcount()
					lds_templateitems.object.marked[ll_delcounter] = "N"
					ll_updcount = ll_updcount + 1
				next
				lds_templateitems.setfilter("")
				lds_templateitems.filter()
			end if
			if ld_value <> ld_reqvalue and ld_reqvalue > ld_satisfiedvalue then
				lb_ok = true
				do while lb_ok
					ll_found = lds_templateitems.find("groupcode = " + trim(string(ll_groupcode)), ll_lastfound + 1, lds_templateitems.rowcount())
					if ll_found > 0 and ll_found <= lds_templateitems.rowcount() then
						ll_lastfound = ll_found
						ld_this_value = lds_templateitems.getitemnumber(ll_found, "c_itemtotal")
						if ld_this_value + ld_satisfiedvalue <= ld_reqvalue then
							ld_satisfiedvalue = ld_satisfiedvalue + ld_this_value
						else
							ll_updcount = ll_updcount + 1
							lb_ok = false
							ll_groupcode2 = ll_groupcode
							do while ll_groupcode = ll_groupcode2
								ll_found = ll_found + 1
								if ll_found <= lds_templateitems.rowcount() then
									ll_groupcode2 = lds_templateitems.object.groupcode[ll_found]
									if ll_groupcode = ll_groupcode2 then
										lds_templateitems.object.marked[ll_found] = "N"
										ll_updcount = ll_updcount + 1
									end if
								else
									ll_groupcode2 = -1
								end if
							loop
						end if
					else
						ll_lastfound = 0
						lb_ok = false
					end if
				loop
			end if
		next
		this.dw_selection.setfilter("RequiredValue > Value")
		this.dw_selection.filter()
		ll_counter = 1
		ll_inscount = 0
		lds_stockitems.dataobject = "d_saletemplate_additionalsale"
		lds_stockitems.settransobject(this.it_transobject)
		for ll_counter = 1 to this.dw_selection.rowcount()
			ll_groupcode = this.dw_selection.object.groupcode[ll_counter]
			ld_reqvalue = this.dw_selection.object.requiredvalue[ll_counter]
			ld_value = this.dw_selection.object.value[ll_counter]
			ld_satisfiedvalue = 0
			ll_found = 0
			ll_lastfound = 0
			if ld_value <> ld_reqvalue and ld_reqvalue > ld_satisfiedvalue then
				lb_ok = true
				ld_difftoadd = ld_reqvalue - ld_value
				ll_found = lds_templateitems.find("groupcode = " + trim(string(ll_groupcode)), ll_lastfound + 1, lds_templateitems.rowcount())
				if ll_found >= 0 and ll_found <= lds_templateitems.rowcount() then
					lds_stockitems.retrieve(this.istr_arg.s_name1, ll_groupcode, this.istr_arg.l_code1)
					ll_stockcount = lds_stockitems.rowcount()
					if ll_stockcount > 0 and ld_difftoadd > 0.0 then
						ll_counter2 = 1
						do while ld_difftoadd > 0.0 and ll_counter2 <= ll_stockcount
							ll_icode = lds_stockitems.object.icode[ll_counter2]
							ld_prefferedsaleqty = lds_stockitems.object.prefferedsaleqty[ll_counter2]
							ld_saleprice = lds_stockitems.object.saleprice[ll_counter2]
							ld_stock = lds_stockitems.object.stock[ll_counter2]
							ll_invcount = lds_stockitems.object.invcount[ll_counter2]
							if ld_prefferedsaleqty * ld_saleprice <= 0.0 then
								ll_newrows = 0
							else
								ll_newrows = long(ld_difftoadd / (ld_prefferedsaleqty * ld_saleprice))
								if ll_newrows > ll_invcount then
									ll_newrows = ll_invcount
								end if
								if ld_prefferedsaleqty * ll_newrows > ld_stock then
									ll_newrows = long(ld_stock / ld_prefferedsaleqty)
									if ll_newrows > ll_invcount then
										ll_newrows = ll_invcount
									end if
								end if
							end if
							for ll_counter3 = 1 to ll_newrows
								ll_insrow = lds_templateitems.insertrow(0)
								lds_templateitems.object.code[ll_insrow] = this.istr_arg.l_code1
								lds_templateitems.object.icode[ll_insrow] = lds_stockitems.object.icode[ll_counter2]
								lds_templateitems.object.qty[ll_insrow] = lds_stockitems.object.prefferedsaleqty[ll_counter2]
								lds_templateitems.object.saleprice[ll_insrow] = lds_stockitems.object.saleprice[ll_counter2]
								lds_templateitems.object.discperc[ll_insrow] = 0
								lds_templateitems.object.itemflatdisc[ll_insrow] = 0
								lds_templateitems.object.unitsalestax[ll_insrow] = lds_stockitems.object.unitsalestax[ll_counter2]
								lds_templateitems.object.gstperc[ll_insrow] = lds_stockitems.object.gstperc[ll_counter2]
								lds_templateitems.object.marked[ll_insrow] = "Y"
								ld_difftoadd = ld_difftoadd - lds_templateitems.object.qty[ll_insrow] * lds_templateitems.object.saleprice[ll_insrow]
								ld_satisfiedvalue = ld_satisfiedvalue + lds_templateitems.object.qty[ll_insrow] * lds_templateitems.object.saleprice[ll_insrow]
								ll_inscount = ll_inscount + 1
							next
							ll_counter2 = ll_counter2 + 1
						loop
					else
						ll_lastfound = 0
						lb_ok = false
					end if
				else
					ll_lastfound = 0
					lb_ok = false
				end if
			end if
		next
		this.dw_selection.setfilter("")
		this.dw_selection.filter()
		if ll_inscount > 0 then
			ll_counter = 0
			randomize(0)
			ll_rowcount = lds_templateitems.rowcount()
			for ll_counter = 1 to lds_templateitems.rowcount()
				if isnull(lds_templateitems.object.saleinvcode[ll_counter]) then
					ll_row = rand(ll_rowcount)
					if ll_row > 0 and ll_row <= ll_rowcount then
						if isnull(lds_templateitems.object.saleinvcode[ll_row]) then
							ll_counter = ll_counter - 1
						else
							lds_templateitems.object.groupcode[ll_counter] = lds_templateitems.object.groupcode[ll_row]
							lds_templateitems.object.groupname[ll_counter] = lds_templateitems.object.groupname[ll_row]
							lds_templateitems.object.saleinvcode[ll_counter] = lds_templateitems.object.saleinvcode[ll_row]
							lds_templateitems.object.saledate[ll_counter] = lds_templateitems.object.saledate[ll_row]
							lds_templateitems.object.custcode[ll_counter] = lds_templateitems.object.custcode[ll_row]
							lds_templateitems.object.salecatcode[ll_counter] = lds_templateitems.object.salecatcode[ll_row]
							lds_templateitems.object.remarks[ll_counter] = lds_templateitems.object.remarks[ll_row]
						end if
					end if
				end if
			next
		end if
		if ll_updcount > 0 or ll_inscount > 0 then
			if lds_templateitems.update() > 0 then
				SQL DELETE SaleTemplateDetail WHERE SaleTemplateCode =:ll_code AND Marked ='N' USING this.it_transobject;
				if this.it_transobject.sqlcode = 0 then
					if ll_inscount > 0 then
						lds_templateitems.setsort("saleinvcode asc, itemname asc")
						lds_templateitems.sort()
						for ll_counter = 1 to lds_templateitems.rowcount()
							lds_templateitems.setitemstatus(ll_counter, 0, primary!, newmodified!)
						next
						SQL DELETE SaleTemplateDetail WHERE SaleTemplateCode =:ll_code USING this.it_transobject;
						if this.it_transobject.sqlcode = 0 then
							if lds_templateitems.update() > 0 then
								SQL commit USING this.it_transobject;
								messagebox("Sales Template", "Sale Template Successfully adjusted w.r.t. sales estimates", information!)
							else
								SQL rollback USING this.it_transobject;
								messagebox("Sales Template", "Sale Template adjustment w.r.t. sales estimates is not done successfully", stopsign!)
							end if
						else
							SQL rollback USING this.it_transobject;
							messagebox("Sales Template", "Sale Template adjustment w.r.t. sales estimates is not done successfully", stopsign!)
						end if
					else
						SQL commit USING this.it_transobject;
						messagebox("Sales Template", "Sale Template Successfully adjusted w.r.t. sales estimates", information!)
					end if
				else
					SQL rollback USING this.it_transobject;
					messagebox("Sales Template", "Sale Template adjustment w.r.t. sales estimates is not done successfully", stopsign!)
				end if
			else
				SQL rollback USING this.it_transobject;
				messagebox("Sales Template", "Sale Template adjustment w.r.t. sales estimates is not done successfully", stopsign!)
			end if
		end if
	end if
	setpointer(arrow!)
	setredraw(true)
	return 0

// w_saletemplate_saleestimates.create() returns 0 [event]
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.dw_selection = create dw_selection
	this.control = {this.cb_cancel, this.cb_ok, this.dw_selection}

// w_saletemplate_saleestimates.destroy() returns 0 [event]
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.dw_selection

// w_saletemplate_saleestimates.open() returns long [event]
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_code
	environment env
	long ll_format
	this.istr_arg = message.powerobjectparm
	this.it_transobject = create u_transaction
	SQL start USING this.it_transobject;
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	openwithparm(w_selectformat_sale_or_all, this.istr_arg.s_name1)
	ll_format = message.doubleparm
	this.dw_selection.settransobject(this.it_transobject)
	this.dw_selection.retrieve(this.istr_arg.s_name1, this.istr_arg.l_code1, ll_format)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.istr_arg.i_status = -1
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ll_counter
	long ll_res
	parent.istr_arg.i_status = 1
	if parent.dw_selection.accepttext() = 1 then
		ll_res = messagebox("Data Loss Warning", "Rows once removed will be lost forever. Are you sure to perform this activity?", question!, yesnocancel!, 3)
		if ll_res <> 1 then
			return ::message.returnvalue
		else
			parent.wf_adjust_sale_template()
			parent.post event ue_close()
		end if
	end if
	return ::message.returnvalue

// dw_selection.rowfocuschanged(long currentrow) returns long [event]
	selectrow(0, false)
	selectrow(currentrow, true)
	return ::message.returnvalue

// dw_selection.itemfocuschanged(long row, dwobject dwo) returns long [event]
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_selection.getfocus() returns long [event]
	selecttext(1, len(gettext()))
	return ::message.returnvalue
