// window w_stockledger_repair (templates)  ancestor: window

// w_stockledger_repair.ue_close(double ad_qty) returns 0
	close(this)

// w_stockledger_repair.create() returns 0
	this.uo_1 = create uo_1
	this.control = {this.uo_1}

// w_stockledger_repair.destroy() returns 0
	destroy this.uo_1

// w_stockledger_repair.open() returns long
	environment le_env
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_width = pixelstounits(le_env.screenwidth, xpixelstounits!) - this.width
		ll_height = pixelstounits(le_env.screenheight, ypixelstounits!) - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width * 0.5
			ll_height = ll_height * 0.5
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// uo_1.destroy() returns 0
	call super::destroy
