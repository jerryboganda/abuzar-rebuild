// menu m_saletemplatemenu (templates)  ancestor: m_multi_entry

// m_saletemplatemenu.create() returns 0 [event]
	m_saletemplatemenu = this
	call super::create
	this.text = "m_saletemplatemenu"

// m_saletemplatemenu.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_generate = create m_generate
	this.m_updatetemplateprice = create m_updatetemplateprice
	this.m_populateitems = create m_populateitems
	this.m_print2 = create m_print2
	this.m_updatesalepriceinbasicdata = create m_updatesalepriceinbasicdata
	this.m_setgst% = create m_setgst%
	this.m_importsalesdata = create m_importsalesdata
	this.m_launchtemplateanalyzer = create m_launchtemplateanalyzer
	this.m_launchtemplatemanipulator = create m_launchtemplatemanipulator
	this.m_generatesalesfrommarkeditems = create m_generatesalesfrommarkeditems
	this.m_autoadjusttemplatewrtstock = create m_autoadjusttemplatewrtstock
	this.m_adjusttemplatewrtsalesestimates = create m_adjusttemplatewrtsalesestimates
	this.item[upperbound(this.item) + 1] = this.m_generate
	this.item[upperbound(this.item) + 1] = this.m_updatetemplateprice
	this.item[upperbound(this.item) + 1] = this.m_populateitems
	this.item[upperbound(this.item) + 1] = this.m_print2
	this.item[upperbound(this.item) + 1] = this.m_updatesalepriceinbasicdata
	this.item[upperbound(this.item) + 1] = this.m_setgst%
	this.item[upperbound(this.item) + 1] = this.m_importsalesdata
	this.item[upperbound(this.item) + 1] = this.m_launchtemplateanalyzer
	this.item[upperbound(this.item) + 1] = this.m_launchtemplatemanipulator
	this.item[upperbound(this.item) + 1] = this.m_generatesalesfrommarkeditems
	this.item[upperbound(this.item) + 1] = this.m_autoadjusttemplatewrtstock
	this.item[upperbound(this.item) + 1] = this.m_adjusttemplatewrtsalesestimates

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_generate
	destroy this.m_updatetemplateprice
	destroy this.m_populateitems
	destroy this.m_print2
	destroy this.m_updatesalepriceinbasicdata
	destroy this.m_setgst%
	destroy this.m_importsalesdata
	destroy this.m_launchtemplateanalyzer
	destroy this.m_launchtemplatemanipulator
	destroy this.m_generatesalesfrommarkeditems
	destroy this.m_autoadjusttemplatewrtstock
	destroy this.m_adjusttemplatewrtsalesestimates

// m_generate.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_generatesale()

// m_generate.create() returns 0 [event]
