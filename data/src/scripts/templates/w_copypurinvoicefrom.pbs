// window w_copypurinvoicefrom (templates)  ancestor: window

// w_copypurinvoicefrom.ue_setfocus(char ac_type) returns 0
	long ll_invcode
	setnull(ll_invcode)
	if ac_type = "P" then
		this.dw_purordertemplate.enabled = true
		this.dw_purordertemplate.setfocus()
		this.rb_copyinvfrompurchaseinvoice.checked = true
	end if

// w_copypurinvoicefrom.ue_postopen() returns 0
	this.istr_template.b_userinput = false
	this.dw_purordertemplate.settransobject(sqlca)
	this.dw_purordertemplate.insertrow(0)
	this.dw_purordertemplate.scrolltorow(0)
	if this.dw_purordertemplate.getchild("pocode", this.idc_purordertemplate) <> 1 then
		messagebox("DataWindow Child", "Can not get DataWindow Child reference for purchase order")
		return
	end if
	this.idc_purordertemplate.settransobject(sqlca)
	this.idc_purordertemplate.setsort("pocode D")
	this.idc_purordertemplate.sort()

// w_copypurinvoicefrom.create() returns 0
	this.dw_purordertemplate = create dw_purordertemplate
	this.st_purchaseinvno = create st_purchaseinvno
	this.rb_copyinvfrompurchaseinvoice = create rb_copyinvfrompurchaseinvoice
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.gb_1 = create gb_1
	this.control = {this.dw_purordertemplate, this.st_purchaseinvno, this.rb_copyinvfrompurchaseinvoice, this.cb_cancel, this.cb_ok, this.gb_1}

// w_copypurinvoicefrom.destroy() returns 0
	destroy this.dw_purordertemplate
	destroy this.st_purchaseinvno
	destroy this.rb_copyinvfrompurchaseinvoice
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.gb_1

// w_copypurinvoicefrom.open() returns long
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	post event ue_postopen()
	return ::message.returnvalue

// w_copypurinvoicefrom.close() returns long
	closewithreturn(this, this.istr_template)
	return ::message.returnvalue

// w_copypurinvoicefrom.key(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		post event Close()
	end if
	return ::message.returnvalue

// dw_purordertemplate.ue_key(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		parent.post event Close()
	end if
	return ::message.returnvalue

// dw_purordertemplate.itemerror(long row, dwobject dwo, string data) returns long
	messagebox("Purchase Order Code Validation", "Please enter valid Purchase Order Code")
	return 1

// rb_copyinvfrompurchaseinvoice.clicked() returns long
	if parent.rb_copyinvfrompurchaseinvoice.checked then
		parent.event ue_setfocus("P")
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.istr_template.b_userinput = false
	parent.post event Close()
	return ::message.returnvalue

// cb_ok.clicked() returns long
	long ll_find
	parent.istr_template.b_userinput = false
	if parent.rb_copyinvfrompurchaseinvoice.checked then
		if parent.dw_purordertemplate.accepttext() = -1 then
			parent.dw_purordertemplate.setfocus()
			return ::message.returnvalue
		end if
		ll_find = parent.idc_purordertemplate.find("pocode=" + string(parent.dw_purordertemplate.getitemnumber(1, "pocode")), 1, parent.idc_purordertemplate.rowcount())
		if ll_find <= 0 then
			messagebox("Purchase Order Code Validation", "Purchase Order Code does not exist")
			parent.dw_purordertemplate.setfocus()
			return ::message.returnvalue
		end if
		parent.istr_template.c_copyinvfrom = "P"
		parent.istr_template.l_invtemplate = parent.dw_purordertemplate.getitemnumber(1, "pocode")
		parent.istr_template.d_date = parent.idc_purordertemplate.getitemdatetime(parent.idc_purordertemplate.getrow(), "date")
	end if
	parent.istr_template.b_userinput = true
	parent.post event Close()
	return ::message.returnvalue
