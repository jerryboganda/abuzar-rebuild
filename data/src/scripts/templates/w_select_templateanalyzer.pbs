// window w_select_templateanalyzer (templates)  ancestor: window

// w_select_templateanalyzer.ue_close(integer ai_status) returns 0
	long ll_retcode
	if ai_status > 0 then
		if this.rb_format1.checked = true then
			ll_retcode = 1
		elseif this.rb_format2.checked = true then
			ll_retcode = 2
		elseif this.rb_format3.checked = true then
			ll_retcode = 3
		elseif this.rb_format4.checked = true then
			ll_retcode = 4
		elseif this.rb_format5.checked = true then
			ll_retcode = 5
		elseif this.rb_format6.checked = true then
			ll_retcode = 6
		elseif this.rb_format7.checked = true then
			ll_retcode = 7
		elseif this.rb_format8.checked = true then
			ll_retcode = 8
		end if
	else
		ll_retcode = -1
	end if
	closewithreturn(this, ll_retcode)

// w_select_templateanalyzer.create() returns 0
	this.rb_format8 = create rb_format8
	this.rb_format7 = create rb_format7
	this.cb_cancel = create cb_cancel
	this.rb_format6 = create rb_format6
	this.rb_format5 = create rb_format5
	this.rb_format4 = create rb_format4
	this.rb_format3 = create rb_format3
	this.cb_ok = create cb_ok
	this.rb_format2 = create rb_format2
	this.rb_format1 = create rb_format1
	this.gb_format = create gb_format
	this.control = {this.rb_format8, this.rb_format7, this.cb_cancel, this.rb_format6, this.rb_format5, this.rb_format4, this.rb_format3, this.cb_ok, this.rb_format2, this.rb_format1, this.gb_format}

// w_select_templateanalyzer.destroy() returns 0
	destroy this.rb_format8
	destroy this.rb_format7
	destroy this.cb_cancel
	destroy this.rb_format6
	destroy this.rb_format5
	destroy this.rb_format4
	destroy this.rb_format3
	destroy this.cb_ok
	destroy this.rb_format2
	destroy this.rb_format1
	destroy this.gb_format

// w_select_templateanalyzer.open() returns long
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// cb_cancel.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	parent.post event ue_close(1)
	return ::message.returnvalue
