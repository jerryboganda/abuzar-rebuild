// w_copysaleinvoicefrom2.open() returns long [event]
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	post event ue_postopen()
	return ::message.returnvalue

// w_copysaleinvoicefrom2.close() returns long [event]
	closewithreturn(this, this.istr_template)
	return ::message.returnvalue

// w_copysaleinvoicefrom2.key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		post event Close()
	end if
	return ::message.returnvalue

// dw_control.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "doctypecode"
		parent.wf_set_dw_visible(long(data))
	end choose
	return 0

// dw_control.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// cb_cancel.clicked() returns long [event]
	parent.istr_template.b_userinput = false
	parent.post event Close()
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ll_find
	long ll_invcode
	parent.istr_template.b_userinput = false
	if parent.dw_control.object.doctypecode[1] = 1 then
		if isnull(parent.dw_template.getitemnumber(1, "template")) then
			return ::message.returnvalue
		end if
		parent.istr_template.c_copyinvfrom = "T"
		parent.istr_template.l_invtemplate = parent.dw_template.getitemnumber(1, "template")
		parent.istr_template.l_moduleid = 39
		parent.istr_template.l_doccode = parent.dw_template.getitemnumber(1, "template")
	elseif parent.dw_control.object.doctypecode[1] = 2 then
		if parent.dw_saleinvtemplate.accepttext() = -1 then
			parent.dw_saleinvtemplate.setfocus()
			return ::message.returnvalue
		end if
		ll_invcode = parent.dw_saleinvtemplate.getitemnumber(1, "saleinvcode")
		SQL Select count ( *) INTO :ll_find From SaleLedger Where SaleInvcode =:ll_invcode USING sqlca;
		if ll_find <= 0 or sqlca.sqlcode <> 0 then
			messagebox("Sale Invoice Code Validation", "Sale Invoice Code does not exist")
			parent.dw_saleinvtemplate.setfocus()
			return ::message.returnvalue
		end if
		parent.istr_template.c_copyinvfrom = "I"
		parent.istr_template.l_invtemplate = parent.dw_saleinvtemplate.getitemnumber(1, "saleinvcode")
		parent.istr_template.l_moduleid = 1
		parent.istr_template.l_doccode = ll_invcode
	elseif parent.dw_control.object.doctypecode[1] = 3 then
		if parent.dw_purchaseinvtemplate.accepttext() = -1 then
			parent.dw_purchaseinvtemplate.setfocus()
			return ::message.returnvalue
		end if
		ll_invcode = parent.dw_purchaseinvtemplate.getitemnumber(1, "purinvcode")
		SQL Select count ( *) INTO :ll_find From PurLedger Where PurInvcode =:ll_invcode USING sqlca;
		if ll_find <= 0 or sqlca.sqlcode <> 0 then
			messagebox("Purchase Invoice Code Validation", "Purchase Invoice Code does not exist")
			parent.dw_purchaseinvtemplate.setfocus()
			return ::message.returnvalue
		end if
		parent.istr_template.c_copyinvfrom = "P"
		parent.istr_template.l_invtemplate = parent.dw_purchaseinvtemplate.getitemnumber(1, "purinvcode")
		parent.istr_template.i_invtype = parent.idc_purchaseinvtemplate.getitemnumber(parent.idc_purchaseinvtemplate.getrow(), "purcatcode")
		parent.istr_template.l_moduleid = 3
		parent.istr_template.l_doccode = ll_invcode
	elseif parent.dw_control.object.doctypecode[1] = 4 then
		if parent.dw_salereturninvtemplate.accepttext() = -1 then
			parent.dw_salereturninvtemplate.setfocus()
			return ::message.returnvalue
		end if
		ll_invcode = parent.dw_salereturninvtemplate.getitemnumber(1, "srinvcode")
		SQL Select Count ( *) INTO :ll_find From SrLedger Where SrInvCode =:ll_invcode USING sqlca;
		if ll_find <= 0 or sqlca.sqlcode <> 0 then
			messagebox("Sale Return Invoice Code Validation", "Sale Return Invoice Code does not exist")
			parent.dw_salereturninvtemplate.setfocus()
			return ::message.returnvalue
		end if
		parent.istr_template.c_copyinvfrom = "R"
		parent.istr_template.l_invtemplate = parent.dw_salereturninvtemplate.getitemnumber(1, "srinvcode")
		parent.istr_template.l_moduleid = 2
		parent.istr_template.l_doccode = ll_invcode
	elseif parent.dw_control.object.doctypecode[1] = 5 then
		if parent.dw_issuerequest.accepttext() = -1 then
			parent.dw_issuerequest.setfocus()
			return ::message.returnvalue
		end if
		ll_invcode = parent.dw_issuerequest.getitemnumber(1, "issuereqinvcode")
		SQL Select count ( *) INTO :ll_find From IssueReqheader Where IssueReqInvcode =:ll_invcode USING sqlca;
		if ll_find <= 0 or sqlca.sqlcode <> 0 then
			messagebox("Issue Request Code Validation", "Issue Request Code does not exist")
			parent.dw_issuerequest.setfocus()
			return ::message.returnvalue
		end if
		parent.istr_template.c_copyinvfrom = "A"
		parent.istr_template.l_invtemplate = parent.dw_issuerequest.getitemnumber(1, "issuereqinvcode")
		parent.istr_template.l_moduleid = 40
		parent.istr_template.l_doccode = ll_invcode
	elseif parent.dw_control.object.doctypecode[1] = 6 then
		if parent.dw_trans.accepttext() = -1 then
			parent.dw_trans.setfocus()
			return ::message.returnvalue
		end if
		ll_invcode = parent.dw_trans.getitemnumber(1, "transcode")
		SQL Select count ( *) INTO :ll_find From Theader Where Transcode =:ll_invcode USING sqlca;
		if ll_find <= 0 or sqlca.sqlcode <> 0 then
			messagebox("Transfer Code Validation", "Transfer Code does not exist")
			parent.dw_trans.setfocus()
			return ::message.returnvalue
		end if
		parent.istr_template.c_copyinvfrom = "N"
		parent.istr_template.l_invtemplate = parent.dw_trans.getitemnumber(1, "transcode")
		parent.istr_template.l_moduleid = 8
		parent.istr_template.l_doccode = ll_invcode
	elseif parent.dw_control.object.doctypecode[1] = 7 then
		if parent.dw_receipt.accepttext() = -1 then
			parent.dw_receipt.setfocus()
			return ::message.returnvalue
		end if
		ll_invcode = parent.dw_receipt.getitemnumber(1, "Invcode")
		SQL Select count ( *) INTO :ll_find From ReceiptHeader Where ReceiptInvcode =:ll_invcode USING sqlca;
		if ll_find <= 0 or sqlca.sqlcode <> 0 then
			messagebox("Receipt Document Code Validation", "Receipt Document Code does not exist")
			parent.dw_receipt.setfocus()
			return ::message.returnvalue
		end if
		parent.istr_template.c_copyinvfrom = "C"
		parent.istr_template.l_invtemplate = parent.dw_receipt.getitemnumber(1, "invcode")
		parent.istr_template.l_moduleid = 6
		parent.istr_template.l_doccode = ll_invcode
	elseif parent.dw_control.object.doctypecode[1] = 8 then
		if parent.dw_po.accepttext() = -1 then
			parent.dw_po.setfocus()
			return ::message.returnvalue
		end if
		ll_invcode = parent.dw_po.getitemnumber(1, "ordercode")
		SQL Select count ( *) INTO :ll_find From PurOrderHeader Where POcode =:ll_invcode USING sqlca;
		if ll_find <= 0 or sqlca.sqlcode <> 0 then
			messagebox("Purchase Order Code Validation", "Purchase Order Code does not exist")
			parent.dw_po.setfocus()
			return ::message.returnvalue
		end if
		parent.istr_template.c_copyinvfrom = "O"
		parent.istr_template.l_invtemplate = parent.dw_po.getitemnumber(1, "ordercode")
		parent.istr_template.l_moduleid = 16
		parent.istr_template.l_doccode = ll_invcode
	end if
	parent.istr_template.b_userinput = true
	parent.post event Close()
	return ::message.returnvalue

