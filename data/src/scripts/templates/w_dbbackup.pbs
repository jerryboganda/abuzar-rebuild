// window w_dbbackup (templates)  ancestor: window

// w_dbbackup.create() returns 0 [event]
	this.cb_cancel = create cb_cancel
	this.cb_backup = create cb_backup
	this.hpb_dbbackup = create hpb_dbbackup
	this.control = {this.cb_cancel, this.cb_backup, this.hpb_dbbackup}

// w_dbbackup.destroy() returns 0 [event]
	destroy this.cb_cancel
	destroy this.cb_backup
	destroy this.hpb_dbbackup

// cb_cancel.clicked() returns long [event]
	SQL stop USING parent.it_transobject;
	close(w_dbbackup)
	return ::message.returnvalue

// cb_backup.clicked() returns long [event]
	integer li_counter
	parent.it_transobject = create u_transaction
	SQL start USING parent.it_transobject;
	parent.hpb_dbbackup.position = 30
	parent.it_transobject.backupdb()
	parent.hpb_dbbackup.position = 32
	for li_counter = 1 to 1000
		rand(10000)
	next
	parent.hpb_dbbackup.position = 36
	for li_counter = 1 to 1000
		rand(10000)
	next
	parent.hpb_dbbackup.position = 40
	for li_counter = 1 to 1000
		rand(10000)
	next
	parent.hpb_dbbackup.position = 50
	parent.hpb_dbbackup.position = 70
	for li_counter = 1 to 1000
		rand(10000)
	next
	parent.hpb_dbbackup.position = 90
	for li_counter = 1 to 5000
		rand(10000)
	next
	parent.hpb_dbbackup.position = 100
	if parent.it_transobject.sqldbcode = 4035 then
		messagebox("BackUp DataBase", "BackUp Successful")
	else
		messagebox("BackUp DataBase", "Backup Fail")
	end if
	close(parent)
	return ::message.returnvalue
