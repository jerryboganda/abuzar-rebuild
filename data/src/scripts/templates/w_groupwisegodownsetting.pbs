// w_groupwisegodownsetting.wf_getgroupallowedgodown(datawindow ad_sourcedw, datawindow ad_targetdw) returns long
	long ll_totrows
	long ll_row
	long ll_newrow
	ll_totrows = ad_sourcedw.rowcount()
	ll_row = 1
	do while ll_totrows <> 0 and ll_row <= ll_totrows
		if ad_sourcedw.object.allowed[ll_row] = 1 then
			ll_newrow = ad_targetdw.insertrow(0)
			ad_targetdw.object.groupcode[ll_newrow] = ad_sourcedw.object.groupcode[ll_row]
			ad_targetdw.object.godown[ll_newrow] = ad_sourcedw.object.godown[ll_row]
			ad_targetdw.object.gcode[ll_newrow] = ad_sourcedw.object.gcode[ll_row]
			ad_targetdw.object.module[ll_newrow] = ad_sourcedw.object.module[ll_row]
			ad_targetdw.object.allowed[ll_newrow] = ad_sourcedw.object.allowed[ll_row]
			ad_targetdw.object.priority[ll_newrow] = ad_sourcedw.object.priority[ll_row]
		end if
		ll_row = ll_row + 1
	loop
	return 1

// w_groupwisegodownsetting.wf_validategroupallowedgodown(datawindow ad_grouplist) returns integer
	long ll_totrows
	long ll_row
	long ll_retval
	ll_totrows = ad_grouplist.rowcount()
	ll_row = 1
	ll_retval = 0
	do while ll_totrows <> 0 and ll_row <= ll_totrows
		if ad_grouplist.object.allowed[ll_row] = 1 then
			ll_retval = ll_row
			return ll_retval
		end if
		ll_row = ll_row + 1
	loop
	return ll_retval

