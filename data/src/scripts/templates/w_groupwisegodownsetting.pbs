// dw_quotationstrategy.itemchanged(long row, dwobject dwo, string data) returns long [event]
	choose case dwo.name
	case "transfersourcegodownstrategy"
		if long(data) = 1 then
			parent.dw_groupallowedgodown_transfer2.visible = true
		else
			parent.dw_groupallowedgodown_transfer2.visible = false
		end if
	end choose
	return ::message.returnvalue

