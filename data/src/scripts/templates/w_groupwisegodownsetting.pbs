		end if
	end choose
	return ::message.returnvalue

// dw_purchasereturnstrategy.itemchanged(long row, dwobject dwo, string data) returns long [event]
	choose case dwo.name
	case "purchasereturngodownstrategy"
		if long(data) = 1 then
			parent.dw_groupallowedgodown_purchasereturn.visible = true
		else
			parent.dw_groupallowedgodown_purchasereturn.visible = false
