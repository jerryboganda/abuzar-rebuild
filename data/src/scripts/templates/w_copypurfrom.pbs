// window w_copypurfrom (templates)  ancestor: window

// w_copypurfrom.ue_setfocus(char ac_type) returns 0 [event]
	long ll_invcode
	setnull(ll_invcode)
	if ac_type = "P" then
		this.dw_pur.enabled = true
		this.dw_pur.setfocus()
		this.rb_copyinvfrompurchaseinvoice.checked = true
	end if

// w_copypurfrom.ue_postopen() returns 0 [event]
	long ll_invcode
	long ll_startinginv
	this.istr_template.b_userinput = false
	this.dw_pur.settransobject(sqlca)
	this.dw_pur.settransobject(sqlca)
	if this.dw_pur.getchild("purinvcode", this.idc_pur) <> 1 then
		messagebox("DataWindow Child", "Can not get DataWindow Child reference for purchase invoice")
		return
	end if
	this.idc_pur.settransobject(sqlca)
	SQL Select Max ( PurInvcode ) INTO :ll_invcode From PurLedger USING sqlca;
	if sqlca.sqlcode <> 0 then
		messagebox("Fetch Error", "Unable to fetch Purchase Invoice code.")
		return
	end if
	this.idc_pur.retrieve(ll_invcode - ll_startinginv, ll_invcode)
	this.dw_pur.insertrow(0)
	this.dw_pur.scrolltorow(0)
	this.idc_pur.settransobject(sqlca)
	this.idc_pur.setsort("purinvcode D")
	this.idc_pur.sort()

// w_copypurfrom.create() returns 0 [event]
	this.dw_pur = create dw_pur
	this.st_purchaseinvno = create st_purchaseinvno
	this.rb_copyinvfrompurchaseinvoice = create rb_copyinvfrompurchaseinvoice
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.gb_1 = create gb_1
	this.control = {this.dw_pur, this.st_purchaseinvno, this.rb_copyinvfrompurchaseinvoice, this.cb_cancel, this.cb_ok, this.gb_1}

// w_copypurfrom.destroy() returns 0 [event]
	destroy this.dw_pur
	destroy this.st_purchaseinvno
	destroy this.rb_copyinvfrompurchaseinvoice
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.gb_1

// w_copypurfrom.open() returns long [event]
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	post event ue_postopen()
	return ::message.returnvalue

// w_copypurfrom.close() returns long [event]
	closewithreturn(this, this.istr_template)
	return ::message.returnvalue

// w_copypurfrom.key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		post event Close()
	end if
	return ::message.returnvalue

// dw_pur.ue_key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		parent.post event Close()
	end if
	return ::message.returnvalue

// dw_pur.itemerror(long row, dwobject dwo, string data) returns long [event]
	messagebox("Purchase Invoice Code Validation", "Please enter valid Purchase Invoice Code")
	return 1

// rb_copyinvfrompurchaseinvoice.clicked() returns long [event]
	if parent.rb_copyinvfrompurchaseinvoice.checked then
		parent.event ue_setfocus("P")
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.istr_template.b_userinput = false
	parent.post event Close()
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ll_find
	long ll_invcode
	parent.istr_template.b_userinput = false
	if parent.rb_copyinvfrompurchaseinvoice.checked then
		if parent.dw_pur.accepttext() = -1 then
			parent.dw_pur.setfocus()
			return ::message.returnvalue
		end if
		ll_invcode = parent.dw_pur.getitemnumber(1, "purinvcode")
		SQL Select count ( *) INTO :ll_find From PurLedger Where PurInvcode =:ll_invcode USING sqlca;
		if ll_find <= 0 or sqlca.sqlcode <> 0 then
			messagebox("Purchase Invoice Code Validation", "Purchase Invoice Code does not exist")
			parent.dw_pur.setfocus()
			return ::message.returnvalue
		end if
		parent.istr_template.c_copyinvfrom = "P"
		parent.istr_template.l_invtemplate = parent.dw_pur.getitemnumber(1, "purinvcode")
		parent.istr_template.i_invtype = parent.idc_pur.getitemnumber(parent.idc_pur.getrow(), "purcatcode")
		parent.istr_template.d_date = parent.idc_pur.getitemdatetime(parent.idc_pur.getrow(), "date")
	end if
	parent.istr_template.b_userinput = true
	parent.post event Close()
	return ::message.returnvalue
