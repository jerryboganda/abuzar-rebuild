// window w_select_templatemanipulator (templates)  ancestor: window

// w_select_templatemanipulator.ue_close(integer ai_status) returns 0
	long ll_retcode
	if ai_status >= 0 then
		if this.rb_format1.checked = true then
			ll_retcode = 1
		elseif this.rb_format2.checked = true then
			ll_retcode = 2
		elseif this.rb_format3.checked = true then
			ll_retcode = 3
		elseif this.rb_format4.checked = true then
			ll_retcode = 4
		elseif this.rb_format5.checked = true then
			ll_retcode = 5
		elseif this.rb_format6.checked = true then
			ll_retcode = 6
		elseif this.rb_format7.checked = true then
			ll_retcode = 7
		elseif this.rb_format8.checked = true then
			ll_retcode = 8
		elseif this.rb_format9.checked = true then
			ll_retcode = 9
		elseif this.rb_format10.checked = true then
			ll_retcode = 10
		elseif this.rb_format11.checked = true then
			ll_retcode = 11
		elseif this.rb_format12.checked = true then
			ll_retcode = 12
		elseif this.rb_format13.checked = true then
			ll_retcode = 13
		elseif this.rb_format14.checked = true then
			ll_retcode = 14
		elseif this.rb_format15.checked = true then
			ll_retcode = 15
		elseif this.rb_format16.checked = true then
			ll_retcode = 16
		elseif this.rb_format17.checked = true then
			ll_retcode = 17
		elseif this.rb_format18.checked = true then
			ll_retcode = 18
		else
			ll_retcode = -1
		end if
	else
		ll_retcode = -1
	end if
	closewithreturn(this, ll_retcode)

// w_select_templatemanipulator.create() returns 0
	this.rb_format18 = create rb_format18
	this.rb_format17 = create rb_format17
	this.rb_format16 = create rb_format16
