// window w_templatemanipulater_cust_sdate_ldate (templates)  ancestor: window

// w_templatemanipulater_cust_sdate_ldate.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		post event ue_close()
	end if
	return ::message.returnvalue

// w_templatemanipulater_cust_sdate_ldate.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// w_templatemanipulater_cust_sdate_ldate.wf_assigndwobjects(string as_masterdw, string as_detaildw, string as_footerdw) returns 0
	this.dw_master.dataobject = as_masterdw
	this.dw_detail.dataobject = as_detaildw
	this.dw_footer.dataobject = as_footerdw
	this.dw_master.settransobject(sqlca)
	this.dw_detail.settransobject(sqlca)
	this.dw_footer.settransobject(sqlca)

// w_templatemanipulater_cust_sdate_ldate.create() returns 0 [event]
	this.dw_footer = create dw_footer
	this.dw_master = create dw_master
	this.cb_retrieve = create cb_retrieve
	this.cb_ok = create cb_ok
	this.dw_detail = create dw_detail
	this.control = {this.dw_footer, this.dw_master, this.cb_retrieve, this.cb_ok, this.dw_detail}

// w_templatemanipulater_cust_sdate_ldate.destroy() returns 0 [event]
	destroy this.dw_footer
	destroy this.dw_master
	destroy this.cb_retrieve
	destroy this.cb_ok
	destroy this.dw_detail

// w_templatemanipulater_cust_sdate_ldate.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_custcode
	string ls_date
	this.il_code = message.doubleparm
	if isnull(this.il_code) or this.il_code = 0 then
		messagebox("Template Validation", "Can not populate Sale Template~r~nPlease Select Valid SAle Template")
		post event ue_close()
	end if
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	wf_assigndwobjects("d_customer_sdate_ldate2", "d_templatemanipulator_cust_sdate_ldate", "")
	this.dw_master.insertrow(0)
	this.dw_master.scrolltorow(0)
	ls_date = string(date(this.dw_master.getitemdatetime(this.dw_master.getrow(), "startdate")), "mm/dd/yyyy")
	this.dw_master.setitem(this.dw_master.getrow(), "startdate", datetime(date(ls_date), time(" 00:00:00")))
	this.dw_master.setitem(this.dw_master.getrow(), "enddate", datetime(date(ls_date), time(" 23:59:59")))
	this.dw_master.setcolumn("custcode")
	this.dw_master.setfocus()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_master.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// cb_retrieve.clicked() returns long [event]
	string ls_filter
	long ll_masterrow
	parent.dw_master.accepttext()
	ll_masterrow = parent.dw_master.getrow()
	if parent.dw_master.getitemdatetime(ll_masterrow, "startdate") <= parent.dw_master.getitemdatetime(ll_masterrow, "enddate") then
		parent.dw_detail.retrieve(parent.il_code, parent.dw_master.getitemnumber(ll_masterrow, "custcode"), parent.dw_master.getitemdatetime(ll_masterrow, "startdate"), parent.dw_master.getitemdatetime(ll_masterrow, "enddate"))
		parent.dw_detail.setredraw(false)
		parent.dw_detail.setredraw(true)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long[] ll_invcode
	long ll_rowcount
	long ll_counter
	long ll_arrindex
	long ll_thiscode
	long ll_template_rows
	long ll_found
	boolean lb_remarks
	boolean lb_continue
	string ls_date
	string ls_errtext
	string ls_findexp
	datastore lds_detail
	lds_detail = create datastore
	lds_detail.dataobject = "d_saletemplate_detail"
	lds_detail.settransobject(sqlca)
	lds_detail.retrieve(parent.il_code)
	ll_template_rows = lds_detail.rowcount()
	parent.istr_arg.l_code1 = parent.dw_master.getitemnumber(parent.dw_master.getrow(), "custcode")
	ll_rowcount = parent.dw_detail.rowcount()
	if ll_template_rows > 0 then
		for ll_counter = 1 to ll_rowcount
			ll_thiscode = parent.dw_detail.object.saleinvcode[ll_counter]
			if parent.dw_detail.getitemstring(ll_counter, "marked") = "N" then
				lb_continue = true
				do while lb_continue
					ls_findexp = "saleinvcode=" + trim(string(ll_thiscode)) + " and marked='Y'"
					ll_found = lds_detail.find(ls_findexp, 1, lds_detail.rowcount())
					if ll_found > 0 and ll_found <= ll_template_rows then
						lds_detail.object.marked[ll_found] = "N"
					else
						lb_continue = false
					end if
				loop
			end if
		next
		if lds_detail.update(true, true) = 1 then
			SQL commit USING sqlca;
		else
			ls_errtext = sqlca.sqlerrtext
			SQL rollback USING sqlca;
			messagebox("Problem", "Changes do not take effect in database. Reasons are:-~r~n" + ls_errtext, stopsign!)
		end if
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close()
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
