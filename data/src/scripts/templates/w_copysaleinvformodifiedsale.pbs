// window w_copysaleinvformodifiedsale (templates)  ancestor: window

// w_copysaleinvformodifiedsale.ue_setfocus(char ac_type) returns 0 [event]
	long ll_invcode
	setnull(ll_invcode)
	if ac_type = "T" then
		this.dw_saleinvtemplate.setitem(1, "saleinvcode", ll_invcode)
		this.dw_saleinvtemplate.enabled = false
	end if

// w_copysaleinvformodifiedsale.ue_postopen() returns 0 [event]
	this.istr_template.b_userinput = false
	SQL rollback USING sqlca;
	this.dw_saleinvtemplate.settransobject(sqlca)
	this.dw_saleinvtemplate.insertrow(0)
	this.dw_saleinvtemplate.scrolltorow(0)
	if this.dw_saleinvtemplate.getchild("saleinvcode", this.idc_saleinvtemplate) <> 1 then
		messagebox("DataWindow Child", "Can not get DataWindow Child reference for sale invoice")
		return
	end if
	this.idc_saleinvtemplate.settransobject(sqlca)
	this.idc_saleinvtemplate.setsort("saleinvcode D")
	this.idc_saleinvtemplate.sort()
	this.dw_saleinvtemplate.setfocus()

// w_copysaleinvformodifiedsale.create() returns 0 [event]
	this.dw_saleinvtemplate = create dw_saleinvtemplate
	this.st_saleinvno = create st_saleinvno
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.gb_1 = create gb_1
	this.control = {this.dw_saleinvtemplate, this.st_saleinvno, this.cb_cancel, this.cb_ok, this.gb_1}

// w_copysaleinvformodifiedsale.destroy() returns 0 [event]
	destroy this.dw_saleinvtemplate
	destroy this.st_saleinvno
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.gb_1

// w_copysaleinvformodifiedsale.open() returns long [event]
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	post event ue_postopen()
	return ::message.returnvalue

// w_copysaleinvformodifiedsale.close() returns long [event]
	closewithreturn(this, this.istr_template)
	return ::message.returnvalue

// w_copysaleinvformodifiedsale.key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		post event Close()
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.istr_template.b_userinput = false
	parent.post event Close()
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ll_find
	parent.istr_template.b_userinput = false
	if parent.dw_saleinvtemplate.accepttext() = -1 then
		parent.dw_saleinvtemplate.setfocus()
		return ::message.returnvalue
	end if
	ll_find = parent.idc_saleinvtemplate.find("saleinvcode=" + string(parent.dw_saleinvtemplate.getitemnumber(1, "saleinvcode")), 1, parent.idc_saleinvtemplate.rowcount())
	if ll_find <= 0 then
		messagebox("Sale Invoice Code Validation", "Sale Invoice Code does not exist")
		parent.dw_saleinvtemplate.setfocus()
		return ::message.returnvalue
	end if
	parent.istr_template.c_copyinvfrom = "I"
	parent.istr_template.l_invtemplate = parent.dw_saleinvtemplate.getitemnumber(1, "saleinvcode")
	parent.istr_template.b_userinput = true
	parent.post event Close()
	return ::message.returnvalue
