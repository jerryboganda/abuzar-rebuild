// window w_groupwise_allowedgroups_setting (templates)  ancestor: window

// w_groupwise_allowedgroups_setting.ue_save() returns 0 [event]
	long ll_row
	long ll_totrows
	long ll_rowcount
	long ll_retval
	setpointer(hourglass!)
	if f_validatedw(this.dw_groupinfo) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedgroups_sale) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedgroups_purchase) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedgroups_visitappointment) < 0 then
		return
	end if
	if f_validatedw(this.dw_groupallowedgroups_visit) < 0 then
		return
	end if
	ll_totrows = this.dw_groupallowedgroupsdetail.rowcount()
	ll_row = 0
	do while ll_totrows > 0 and ll_row <= ll_totrows
		this.dw_groupallowedgroupsdetail.deleterow(0)
		ll_row = ll_row + 1
	loop
	ll_retval = wf_getgroupallowedgroups(this.dw_groupallowedgroups_sale, this.dw_groupallowedgroupsdetail)
	ll_retval = wf_getgroupallowedgroups(this.dw_groupallowedgroups_purchase, this.dw_groupallowedgroupsdetail)
	ll_retval = wf_getgroupallowedgroups(this.dw_groupallowedgroups_visitappointment, this.dw_groupallowedgroupsdetail)
	ll_retval = wf_getgroupallowedgroups(this.dw_groupallowedgroups_visit, this.dw_groupallowedgroupsdetail)
	if this.dw_groupallowedgroupsdetail.update() > 0 then
		SQL commit USING sqlca;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		setpointer(arrow!)
		post event Close()
	else
		SQL rollback USING sqlca;
		setpointer(arrow!)
		messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs", exclamation!, ok!, 1)
		return
	end if
	setpointer(arrow!)

// w_groupwise_allowedgroups_setting.wf_validategroupallowedheader(datawindow ad_grouplist) returns integer
	long ll_totrows
	long ll_row
	long ll_retval
	ll_totrows = ad_grouplist.rowcount()
	ll_row = 1
	ll_retval = 0
	do while ll_totrows <> 0 and ll_row <= ll_totrows
		if ad_grouplist.object.allowed[ll_row] = 1 then
			ll_retval = ll_row
			return ll_retval
		end if
		ll_row = ll_row + 1
	loop
	return ll_retval

// w_groupwise_allowedgroups_setting.wf_insertgroupinfo(datawindow adw_targetdw, integer ai_module) returns 0
	long ll_row
	long ll_counter
	for ll_counter = 1 to this.id_groups.rowcount()
		if this.il_groupcode <> long(this.id_groups.object.groupcode[ll_counter]) then
			ll_row = adw_targetdw.insertrow(0)
			adw_targetdw.object.groupcode[ll_row] = this.id_groups.object.groupcode[ll_counter]
			adw_targetdw.object.groupname[ll_row] = this.id_groups.object.groupname[ll_counter]
			adw_targetdw.object.module[ll_row] = ai_module
			adw_targetdw.object.allowed[ll_row] = 0
		end if
	next

// w_groupwise_allowedgroups_setting.wf_getgroupallowedgroups(datawindow ad_sourcedw, datawindow ad_targetdw) returns long
	long ll_totrows
	long ll_row
	long ll_newrow
	ll_totrows = ad_sourcedw.rowcount()
	ll_row = 1
	do while ll_totrows <> 0 and ll_row <= ll_totrows
		if ad_sourcedw.object.allowed[ll_row] = 1 then
			ll_newrow = ad_targetdw.insertrow(0)
			ad_targetdw.object.groupcode[ll_newrow] = this.il_groupcode
			ad_targetdw.object.module[ll_newrow] = ad_sourcedw.object.module[ll_row]
			ad_targetdw.object.allowedgroupcode[ll_newrow] = ad_sourcedw.object.groupcode[ll_row]
		end if
		ll_row = ll_row + 1
	loop
	return 1

// w_groupwise_allowedgroups_setting.create() returns 0 [event]
	if this.menuname = "m_groupheadersetting" then
		this.menuid = create m_groupheadersetting
	end if
	this.dw_groupallowedgroups_visit = create dw_groupallowedgroups_visit
	this.dw_groupallowedgroups_visitappointment = create dw_groupallowedgroups_visitappointment
	this.dw_groupallowedgroups_purchase = create dw_groupallowedgroups_purchase
	this.dw_groups = create dw_groups
	this.cb_cancel = create cb_cancel
	this.cb_save = create cb_save
	this.dw_groupallowedgroupsdetail = create dw_groupallowedgroupsdetail
	this.dw_groupallowedgroups_sale = create dw_groupallowedgroups_sale
	this.dw_groupinfo = create dw_groupinfo
	this.gb_sale = create gb_sale
	this.gb_purchase = create gb_purchase
	this.gb_visitappointmen = create gb_visitappointmen
	this.gb_visit = create gb_visit
	this.control = {this.dw_groupallowedgroups_visit, this.dw_groupallowedgroups_visitappointment, this.dw_groupallowedgroups_purchase, this.dw_groups, this.cb_cancel, this.cb_save, this.dw_groupallowedgroupsdetail, this.dw_groupallowedgroups_sale, this.dw_groupinfo, this.gb_sale, this.gb_purchase, this.gb_visitappointmen, this.gb_visit}

// w_groupwise_allowedgroups_setting.destroy() returns 0 [event]
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_groupallowedgroups_visit
	destroy this.dw_groupallowedgroups_visitappointment
	destroy this.dw_groupallowedgroups_purchase
	destroy this.dw_groups
	destroy this.cb_cancel
	destroy this.cb_save
	destroy this.dw_groupallowedgroupsdetail
	destroy this.dw_groupallowedgroups_sale
	destroy this.dw_groupinfo
	destroy this.gb_sale
	destroy this.gb_purchase
	destroy this.gb_visitappointmen
	destroy this.gb_visit

// w_groupwise_allowedgroups_setting.open() returns long [event]
	long ll_groupcode
	long ll_row
	long ll_totrows
	long ll_module
	long ll_headercode
	long ll_found
	string ls_datawindow
	string ls_headername
	string ls_headeralias
	ll_groupcode = message.doubleparm
	this.il_groupcode = ll_groupcode
	this.id_groups = this.dw_groups
	this.id_groups.settransobject(sqlca)
	if this.id_groups.retrieve() <= 0 then
		messagebox("DataBase Error", "Unable to retrieve groups information")
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	this.dw_groupinfo.settransobject(sqlca)
	this.dw_groupallowedgroups_sale.settransobject(sqlca)
	this.dw_groupallowedgroups_purchase.settransobject(sqlca)
	this.dw_groupallowedgroups_visitappointment.settransobject(sqlca)
	this.dw_groupallowedgroups_visit.settransobject(sqlca)
	this.dw_groupallowedgroupsdetail.settransobject(sqlca)
	this.dw_groupinfo.retrieve(ll_groupcode)
	wf_insertgroupinfo(this.dw_groupallowedgroups_sale, 1)
	wf_insertgroupinfo(this.dw_groupallowedgroups_purchase, 3)
	wf_insertgroupinfo(this.dw_groupallowedgroups_visitappointment, 19)
	wf_insertgroupinfo(this.dw_groupallowedgroups_visit, 20)
	ll_row = this.dw_groupinfo.rowcount()
	if ll_row <= 0 then
		messagebox("Database Error", "Problem occured at database.")
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ll_groupcode = this.dw_groupinfo.getitemnumber(ll_row, "code")
	this.dw_groupallowedgroupsdetail.retrieve(ll_groupcode)
	for ll_row = 1 to this.dw_groupallowedgroupsdetail.rowcount()
		choose case this.dw_groupallowedgroupsdetail.getitemnumber(ll_row, "module")
		case 1.0
			ll_found = this.dw_groupallowedgroups_sale.find("groupcode = " + trim(string(this.dw_groupallowedgroupsdetail.getitemnumber(ll_row, "allowedgroupcode"))), 1, this.dw_groupallowedgroups_sale.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedgroups_sale.setitem(ll_found, "allowed", 1)
			end if
		case 3.0
			ll_found = this.dw_groupallowedgroups_purchase.find("groupcode = " + trim(string(this.dw_groupallowedgroupsdetail.getitemnumber(ll_row, "allowedgroupcode"))), 1, this.dw_groupallowedgroups_purchase.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedgroups_purchase.setitem(ll_found, "allowed", 1)
			end if
		case 19.0
			ll_found = this.dw_groupallowedgroups_visitappointment.find("groupcode = " + trim(string(this.dw_groupallowedgroupsdetail.getitemnumber(ll_row, "allowedgroupcode"))), 1, this.dw_groupallowedgroups_visitappointment.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedgroups_visitappointment.setitem(ll_found, "allowed", 1)
			end if
		case 20.0
			ll_found = this.dw_groupallowedgroups_visit.find("groupcode = " + trim(string(this.dw_groupallowedgroupsdetail.getitemnumber(ll_row, "allowedgroupcode"))), 1, this.dw_groupallowedgroups_visit.rowcount())
			if ll_found > 0 then
				this.dw_groupallowedgroups_visit.setitem(ll_found, "allowed", 1)
			end if
		end choose
	next
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_groupwise_allowedgroups_setting.close() returns long [event]
	close(this)
	return ::message.returnvalue

// w_groupwise_allowedgroups_setting.activate() returns long [event]
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.post event Close()
	return ::message.returnvalue

// cb_save.clicked() returns long [event]
	parent.post event ue_save()
	return ::message.returnvalue
