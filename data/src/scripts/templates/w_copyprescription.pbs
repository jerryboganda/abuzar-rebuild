// window w_copyprescription (templates)  ancestor: window

// w_copyprescription.ue_postopen() returns 0 [event]
	long rt_code
	this.dw_pres.settransobject(sqlca)
	rt_code = this.dw_pres.reset()
	rt_code = this.dw_pres.insertrow(0)
	if rt_code <= 0 then
		messagebox("Prescription Validation", "No Prescription Retrieved.")
		this.istr_arg.i_status = -1
		post event ue_close()
	end if

// w_copyprescription.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// w_copyprescription.open() returns long [event]
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	post event ue_postopen()
	return ::message.returnvalue

// w_copyprescription.create() returns 0 [event]
	this.dw_pres = create dw_pres
	this.st_prescriptionno = create st_prescriptionno
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.gb_1 = create gb_1
	this.control = {this.dw_pres, this.st_prescriptionno, this.cb_cancel, this.cb_ok, this.gb_1}

// w_copyprescription.destroy() returns 0 [event]
	destroy this.dw_pres
	destroy this.st_prescriptionno
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.gb_1

// dw_pres.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// cb_cancel.clicked() returns long [event]
	parent.istr_arg.i_status = -1
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		post event clicked()
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ll_code
	if parent.dw_pres.accepttext() = -1 then
		messagebox("Prescription Validation", "Kindly select some prescription from the list.")
		parent.dw_pres.setfocus()
		return ::message.returnvalue
	end if
	ll_code = parent.dw_pres.getitemnumber(parent.dw_pres.getrow(), "prescode")
	parent.istr_arg.l_code1 = ll_code
	parent.post event ue_close()
	return ::message.returnvalue
