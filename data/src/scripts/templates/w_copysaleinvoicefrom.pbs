// w_copysaleinvoicefrom.ue_postopen() returns 0
	long ll_invcode
	long ll_startinginv
	this.istr_template.b_userinput = false
	this.dw_template.settransobject(sqlca)
	this.dw_template.insertrow(0)
	this.dw_template.scrolltorow(0)
	ll_startinginv = 10
	this.dw_saleinvtemplate.settransobject(sqlca)
	if this.dw_saleinvtemplate.getchild("saleinvcode", this.idc_saleinvtemplate) <> 1 then
		messagebox("DataWindow Child", "Can not get DataWindow Child reference for sale invoice")
		return
	end if
	this.idc_saleinvtemplate.settransobject(sqlca)
	SQL Select Max ( SaleInvCode ) INTO :ll_invcode From SaleLedger USING sqlca;
	if sqlca.sqlcode <> 0 then
		messagebox("Fetch Error", "Unable to fetch Sale Invoice code.")
		return
	end if
	this.idc_saleinvtemplate.retrieve(ll_invcode - ll_startinginv, ll_invcode)
	this.dw_saleinvtemplate.insertrow(0)
	this.dw_saleinvtemplate.scrolltorow(0)
	this.dw_purchaseinvtemplate.settransobject(sqlca)
	if this.dw_purchaseinvtemplate.getchild("purinvcode", this.idc_purchaseinvtemplate) <> 1 then
		messagebox("DataWindow Child", "Can not get DataWindow Child reference for purchase invoice")
		return
	end if
	this.idc_purchaseinvtemplate.settransobject(sqlca)
	SQL Select Max ( PurInvcode ) INTO :ll_invcode From PurLedger USING sqlca;
	if sqlca.sqlcode <> 0 then
		messagebox("Fetch Error", "Unable to fetch Purchase Invoice code.")
		return
	end if
	this.idc_purchaseinvtemplate.retrieve(ll_invcode - ll_startinginv, ll_invcode)
	this.dw_purchaseinvtemplate.insertrow(0)
	this.dw_purchaseinvtemplate.scrolltorow(0)
	this.dw_salereturninvtemplate.settransobject(sqlca)
	if this.dw_salereturninvtemplate.getchild("srinvcode", this.idc_salereturninvtemplate) <> 1 then
		messagebox("DataWindow Child", "Can not get DataWindow Child reference for sale return invoice")
		return
	end if
	this.idc_salereturninvtemplate.settransobject(sqlca)
	SQL Select Max ( SrInvCode ) INTO :ll_invcode From SrLedger USING sqlca;
	if sqlca.sqlcode <> 0 then
		messagebox("Fetch Error", "Unable to fetch Sale Return Invoice code.")
		return
	end if
	this.idc_salereturninvtemplate.retrieve(ll_invcode - ll_startinginv, ll_invcode)
	this.dw_salereturninvtemplate.insertrow(0)
	this.dw_salereturninvtemplate.scrolltorow(0)
	this.dw_issuerequest.settransobject(sqlca)
	if this.dw_issuerequest.getchild("issuereqinvcode", this.idc_issuereqtemplate) <> 1 then
		messagebox("DataWindow Child", "Can not get DataWindow Child reference for Issue Request invoice")
		return
	end if
	this.idc_issuereqtemplate.settransobject(sqlca)
	SQL Select Max ( IssueReqInvCode ) INTO :ll_invcode From IssueReqHeader USING sqlca;
	if sqlca.sqlcode <> 0 then
		messagebox("Fetch Error", "Unable to fetch Issue Request code.")
		return
	end if
	this.idc_issuereqtemplate.retrieve(ll_invcode - ll_startinginv, ll_invcode)
	this.dw_issuerequest.insertrow(0)
	this.dw_issuerequest.scrolltorow(0)
	this.dw_trans.settransobject(sqlca)
	this.dw_trans.insertrow(0)
	this.dw_trans.scrolltorow(0)
	this.dw_template.setfocus()

