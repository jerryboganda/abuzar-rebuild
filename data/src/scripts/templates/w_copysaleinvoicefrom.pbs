// w_copysaleinvoicefrom.ue_setfocus(char ac_type) returns 0
	long ll_invcode
	setnull(ll_invcode)
	if ac_type = "S" then
		this.dw_purchaseinvtemplate.setitem(1, "purinvcode", ll_invcode)
