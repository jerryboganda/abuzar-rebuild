// w_copysaleinvoicefrom.open() returns long
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	post event ue_postopen()
	return ::message.returnvalue

// w_copysaleinvoicefrom.close() returns long
	closewithreturn(this, this.istr_template)
	return ::message.returnvalue

// w_copysaleinvoicefrom.key(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		post event Close()
	end if
	return ::message.returnvalue

// rb_copyinvfromtrans.clicked() returns long
	if this.checked then
		parent.event ue_setfocus("N")
	end if
	return ::message.returnvalue

// rb_copyinvfromissuereq.clicked() returns long
	if this.checked then
		parent.event ue_setfocus("A")
