	this.gb_1 = create gb_1
	this.control = {this.dw_trans, this.st_3, this.rb_copyinvfromtrans, this.dw_issuerequest, this.st_2, this.rb_copyinvfromissuereq, this.dw_salereturninvtemplate, this.st_1, this.rb_copyinvfromsalereturninvoice, this.dw_purchaseinvtemplate, this.dw_saleinvtemplate, this.st_purchaseinvno, this.rb_copyinvfrompurchaseinvoice, this.st_saleinvno, this.st_template, this.dw_template, this.rb_copyinvfromsaleinvoice, this.rb_copyinvfromtemplate, this.cb_cancel, this.cb_ok, this.gb_1}

