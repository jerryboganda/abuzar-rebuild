		elseif this.il_formatcode = 3 then
			ls_report = "d_barcodealbel_saleorder_masoodhomoeo3"
		elseif this.il_formatcode = 4 then
			ls_report = "d_barcodealbel_saleorder_masoodhomoeo4"
		elseif this.il_formatcode = 5 then
			ls_report = "d_barcodealbel_saleorder_masoodhomoeo5"
		elseif this.il_formatcode = 6 then
			ls_report = "d_barcodealbel_saleorder_masoodhomoeo6"
		elseif this.il_formatcode = 7 then
			ls_report = "d_barcodealbel_saleorder_masoodhomoeo7"
		elseif this.il_formatcode = 8 then
			ls_report = "d_barcodealbel_saleorder_masoodhomoeo8"
