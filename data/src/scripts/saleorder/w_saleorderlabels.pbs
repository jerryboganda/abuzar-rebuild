// w_saleorderlabels.wf_sortitems() returns long
	string ls_null
	setnull(ls_null)
	this.id_detail.setsort(ls_null)
	this.id_detail.sort()
	return 0

// w_saleorderlabels.wf_filteritems() returns long
	string ls_null
	setnull(ls_null)
	this.id_detail.scrolltorow(0)
	this.id_detail.setfilter(ls_null)
	this.is_filterexp = this.id_detail.object.datawindow.table.filter
	if this.is_filterexp = "" or this.is_filterexp = "?" or isnull(this.is_filterexp) then
		setnull(this.is_filterexp)
	end if
	this.id_detail.filter()
	this.id_detail.groupcalc()
	return 0

// w_saleorderlabels.wf_filter_unsold_items() returns long
	long ll_code
	long ll_detailrows
	long ll_unsoldrows
	long ll_counter
	long ll_icode
	long ll_found
	u_ds_standard lds_saleorder
	if this.tab_retrieve.selectedtab = 2 then
		return 0
	end if
	if this.id_master.getrow() > 0 then
		ll_code = this.id_master.object.code[1]
		if ll_code > 0 then
			lds_saleorder = create u_ds_standard
			lds_saleorder.dataobject = "d_saleorderdetail_retrieve"
			lds_saleorder.settransobject(this.it_transobject)
			lds_saleorder.retrieve(ll_code, 1)
			lds_saleorder.setfilter("looseqty - saleqty > 0 OR bonusqty - salebonus > 0")
			lds_saleorder.filter()
			ll_unsoldrows = lds_saleorder.rowcount()
			this.is_filterexp = ""
			this.id_detail.setfilter(this.is_filterexp)
			this.id_detail.filter()
			ll_detailrows = this.id_detail.rowcount()
			if ll_detailrows > 0 then
				ll_counter = 1
				for ll_counter = 1 to ll_detailrows
					ll_icode = this.id_detail.object.icode[ll_counter]
					ll_found = lds_saleorder.find("icode = " + trim(string(ll_icode)), 1, ll_unsoldrows)
					if ll_found > 0 and ll_found <= ll_unsoldrows then
						this.id_detail.object.looseqty[ll_counter] = lds_saleorder.object.looseqty[ll_found] - lds_saleorder.object.saleqty[ll_found]
						this.id_detail.object.bonusqty[ll_counter] = lds_saleorder.object.bonusqty[ll_found] - lds_saleorder.object.salebonus[ll_found]
						this.id_detail.object.filter[ll_counter] = "Y"
					end if
				next
			end if
			this.is_filterexp = "filter = 'Y'"
			this.id_detail.setfilter(this.is_filterexp)
			this.id_detail.filter()
		end if
	end if
	return 0

// w_saleorderlabels.wf_printbarcode_format3() returns integer
	long ll_job
	string ls_contents
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	integer li_file2
	integer li_strengthperc
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_packing
	string ls_batch
	string ls_mfg_date
	string ls_expiry
	string ls_remarks
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = this.id_master.object.aliasname[this.id_master.getrow()]
	ll_headerno = this.id_master.getitemnumber(this.id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = this.id_print.rowcount()
	ls_printer = trim(f_stringpreferences("BarCodePrinterName"))
	if lower(ls_printer) = lower("Zebra ZT230") then
		li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
		if li_file = -1 then
			messagebox("Error", "Unable to locate file for Label printing")
			return 0
		else
			ls_filecontent = "CT~~~~CD,~~CC^~~CT~~"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "^XATA000JSN^LT0^MNW^MTD^PON^PMN^LH0,0^JMA^PR5,5SD15^JUS^LRN^CI0^XZ"
			filewrite(li_file, ls_filecontent)
			for ll_counter = 1 to ll_totalrows
				ls_filecontent = ""
				ls_itemname = ""
				ls_aliasname = ""
				li_strengthperc = 0
				ls_price = ""
				ll_qty = 0
				ls_packing = ""
				ls_batch = ""
				ls_mfg_date = ""
				ls_expiry = ""
				ls_remarks = ""
				ll_qty = 1
				ls_itemname = trim(left(trim(this.id_print.object.itemname[ll_counter]), 45))
				ls_aliasname = left(trim(this.id_print.object.aliasname[ll_counter]), li_barcodeleninprint)
				ls_packing = this.id_print.object.packing[ll_counter]
				ls_batch = this.id_print.object.batchno[ll_counter]
				ls_mfg_date = string(this.id_print.object.mfgdate[ll_counter], "dd/mm/yyyy")
				ls_expiry = string(this.id_print.object.expiry[ll_counter], "dd/mm/yyyy")
				li_strengthperc = this.id_print.object.strengthperc[ll_counter]
				ls_price = string(this.id_print.object.saleprice[ll_counter], "##,###,##0.00")
				ls_remarks = this.id_print.object.mfgremarks[ll_counter]
				if len(ls_itemname) < 45 then
					ls_itemname = space(int((45 - len(ls_itemname)) / 2.0)) + ls_itemname
				end if
				ls_filecontent = "^XA"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^MMT"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^PW711"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^LL0243"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^LS0"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^FT624,200,2^A0I,28,33^FH\^FD" + ls_itemname + "^FS"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^FT423,176,2^A0I,20,19^FH\^FD" + "Alcohol Vol % " + trim(string(li_strengthperc)) + "^FS"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^BY1,3,26^FT220,172^B3I,N,,N,N"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^FD" + ls_aliasname + "^FS"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^FT160,161^A0I,12,12^FH\^FD" + ls_aliasname + "^FS"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^FT640,158^A0I,17,16^FH\^FDQuantity: ^FS"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^FT545,156^A0I,17,16^FH\^FD" + ls_packing + "^FS"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^FT640,136^A0I,17,16^FH\^FDBatch #: ^FS"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^FT545,135^A0I,17,16^FH\^FD" + ls_batch + "^FS"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^FT640,116^A0I,17,16^FH\^FDMfg. Date: ^FS"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^FT545,115^A0I,17,16^FH\^FD" + ls_mfg_date + "^FS"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^FT640,94^A0I,17,16^FH\^FDExpiry: ^FS"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^FT545,93^A0I,17,16^FH\^FD" + ls_expiry + "^FS"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^FT640,74^A0I,17,16^FH\^FDMRP: ^FS"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^FT545,72^A0I,17,16^FH\^FD" + ls_price + "^FS"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^PQ" + trim(string(ll_qty)) + ",0,1,Y^XZ"
				filewrite(li_file, ls_filecontent)
			next
			fileclose(li_file)
			li_file2 = fileopen("label.prn", textmode!, read!, lockread!)
			if li_file2 = -1 then
				messagebox("Error", "Unable to locate file for Label printing")
				return 0
			else
				filereadex(li_file2, ls_contents)
				fileclose(li_file2)
				printsetprinter("Zebra ZT230")
				ll_job = printopen("waseela", false)
				if ll_job = -1 then
					messagebox("Error", "Unable to Open Print Job for Label printing")
				else
					printsend(ll_job, ls_contents)
					printclose(ll_job)
				end if
			end if
		end if
	end if
	return 0

// w_saleorderlabels.wf_printbarcode_format4() returns long
	return 0

// w_saleorderlabels.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_saleorderlabelsmenu" then
		this.menuid = create m_saleorderlabelsmenu
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	this.ic_cashdrawerprinter = create ic_cashdrawerprinter
	this.ic_comport = create ic_comport
	this.ic_drawerport = create ic_drawerport
	this.dw_saleinvdetail = create dw_saleinvdetail
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.ic_cashdrawerprinter
	this.control[icurrent + 3] = this.ic_comport
	this.control[icurrent + 4] = this.ic_drawerport
	this.control[icurrent + 5] = this.dw_saleinvdetail

// w_saleorderlabels.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.ic_cashdrawerprinter
	destroy this.ic_comport
	destroy this.ic_drawerport
	destroy this.dw_saleinvdetail

