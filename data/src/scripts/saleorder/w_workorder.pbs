// w_workorder.open() returns long [event]
	integer li_xpos
	integer li_ypos
	integer li_xendpos
	integer li_counter
	integer li_taborder
	integer li_visiblecolumns
	integer li_zerotaborder
	long ll_counter
	long li_retcode
	long li_rtncode
	boolean lb_active
	boolean lb_restricted
	boolean lb_customicode
	boolean lb_zerotabordercol
	date ld_date
	long ll_retcode
	ld_date = today()
	this.istr_datatype = message.powerobjectparm
	this.il_protect = this.istr_datatype.ai_int
	this.il_code = this.istr_datatype.al_long
	this.it_transobject = create u_transaction
	if wf_connect() <> 0 then
		messagebox("Connection Failure", "Unable to connect to the database", stopsign!)
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	wf_set_workorderinfo(this.il_code)
	wf_retrieve_tabs()
	wf_apply_protect_setting()
	wf_set_interface_adjustments()
	wf_set_tab_visibility()
	triggerevent("ue_postopen")
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_printorder.clicked() returns long [event]
	parent.ib_printorder = true
	parent.wf_save()
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.postevent("ue_close")
	return ::message.returnvalue

// cb_ok.ue_enterkry(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return 1

// cb_ok.clicked() returns long [event]
	string ls_aliasname
	long ll_newid
	long ll_row
	long ll_counter
	long ll_liccode
	long li_rc
	long ll_pk
	long ll_null
	long ll_usercode
	boolean lb_commitok
	datetime ldt_server_datetime
	string ls_date_errtext
	setnull(ll_null)
	if parent.il_protect = 1 then
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_header) < 0 then
		parent.tab_main.selecttab(1)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_assessment) < 0 then
		parent.tab_main.selecttab(2)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_resources) < 0 then
		parent.tab_main.selecttab(3)
		return ::message.returnvalue
	end if
	if parent.wf_validate_resource() = 1 then
		parent.tab_main.selecttab(3)
		return ::message.returnvalue
	end if
	parent.wf_grandtotal()
	if not parent.wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return ::message.returnvalue
	end if
	ll_pk = parent.id_header.object.code[1]
	ll_usercode = gl_usercode
	if ll_usercode > 0 then
		if not parent.wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			return ::message.returnvalue
		end if
		if isnull(ll_pk) then
			parent.wf_tabnewid("workorder", ll_newid)
			if ll_newid > 0 then
				parent.id_header.object.code[1] = ll_newid
			end if
		else
			ll_newid = parent.id_header.object.code[1]
		end if
		if parent.id_header.rowcount() > 0 and parent.id_footer.rowcount() > 0 then
			parent.id_header.object.code[1] = ll_newid
		end if
		if parent.id_assessment.rowcount() > 0 and parent.ib_approved then
			parent.id_assessment.object.code[1] = ll_newid
		end if
		for ll_counter = 1 to parent.id_resources.rowcount()
			parent.id_resources.object.code[ll_counter] = ll_newid
		next
		if parent.id_header.update(true, true) = 1 then
			if parent.id_assessment.update(true, true) = 1 then
				if parent.id_resources.update(true, true) = 1 then
					SQL commit USING parent.it_transobject;
					parent.il_code = ll_newid
					lb_commitok = true
					if parent.ib_printorder then
						parent.wf_printorder()
					end if
					parent.event ue_close()
					return ::message.returnvalue
				else
					if isnull(ll_pk) then
						parent.id_header.object.code[1] = ll_null
						parent.id_assessment.object.code[1] = ll_null
					end if
					messagebox("Work Order Saving Problem", "Unable to update Work Order Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
					SQL rollback USING parent.it_transobject;
				end if
			else
				if isnull(ll_pk) then
					parent.id_header.object.code[1] = ll_null
					parent.id_assessment.object.code[1] = ll_null
				end if
				messagebox("Work Order Saving Problem", "Unable to update Work Order Assessment Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
				SQL rollback USING parent.it_transobject;
			end if
		else
			if isnull(ll_pk) then
				parent.id_header.object.code[1] = ll_null
				parent.id_assessment.object.code[1] = ll_null
			end if
			messagebox("Work Order Saving Problem", "Unable to update Work Order Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
			SQL rollback USING parent.it_transobject;
		end if
	end if
	return ::message.returnvalue

// tab_main.create() returns 0 [event]
	this.tabpage_header = create tabpage_header
	this.tabpage_assessment = create tabpage_assessment
	this.tabpage_resources = create tabpage_resources
	this.tabpage_issue = create tabpage_issue
	this.tabpage_receipt = create tabpage_receipt
	this.tabpage_transfers = create tabpage_transfers
	this.control = {this.tabpage_header, this.tabpage_assessment, this.tabpage_resources, this.tabpage_issue, this.tabpage_receipt, this.tabpage_transfers}

// tab_main.destroy() returns 0 [event]
	destroy this.tabpage_header
	destroy this.tabpage_assessment
	destroy this.tabpage_resources
	destroy this.tabpage_issue
	destroy this.tabpage_receipt
	destroy this.tabpage_transfers

// tab_main.selectionchanged(integer oldindex, integer newindex) returns long [event]
	if parent.il_protect = 0 then
		if newindex = 1 then
			parent.id_header.setfocus()
			if parent.id_header.rowcount() = 0 then
				parent.wf_insert_row(parent.id_header, 0)
				if parent.id_header.getrow() > 0 then
					parent.id_header.object.usercode[parent.id_header.getrow()] = gl_usercode
				end if
			end if
		elseif newindex = 2 then
			parent.id_assessment.setfocus()
			if parent.id_assessment.rowcount() = 0 and parent.ib_approved then
				parent.wf_insert_row(parent.id_assessment, 0)
				if parent.id_assessment.getrow() > 0 then
					parent.id_assessment.object.usercode[parent.id_assessment.getrow()] = gl_usercode
				end if
			end if
		elseif newindex = 3 then
			parent.id_resources.setfocus()
			if parent.id_resources.rowcount() = 0 and parent.ib_approved then
				parent.wf_insert_row(parent.id_resources, 0)
				if parent.id_resources.getrow() > 0 then
					parent.id_resources.object.usercode[parent.id_resources.getrow()] = gl_usercode
				end if
			end if
		elseif newindex = 4 then
			parent.id_issue.setfocus()
			parent.id_issue.retrieve(parent.il_code)
		elseif newindex = 5 then
			parent.id_receipt.setfocus()
			parent.id_receipt.retrieve(parent.il_code)
		elseif newindex = 6 then
			parent.id_transfer.setfocus()
			parent.id_transfer.retrieve(parent.il_code)
		end if
	end if
	return ::message.returnvalue

// tabpage_header.create() returns 0 [event]
	this.dw_header = create dw_header
	this.control = {this.dw_header}

// tabpage_header.destroy() returns 0 [event]
	destroy this.dw_header

// dw_header.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ll_counter
	long ll_foundcode
	s_popup_selection lstr_selection
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	try
		if getcolumnname() = "custcode" and key = keyf5! then
			parent.parent.parent.wf_new_customerregisteration()
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
		setnull(ll_counter)
		parent.parent.parent.id_header.setitem(1, "custcode", ll_counter)
	end try
	return ::message.returnvalue

// dw_header.ue_enterkey() returns long [event]
	if not (getcolumnname() = "complaint" or getcolumnname() = "demand") then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// dw_header.getfocus() returns long [event]
	setfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_header.itemfocuschanged(long row, dwobject dwo) returns long [event]
	if len(gettext()) > 0 then
		selecttext(1, len(gettext()))
	end if
	return ::message.returnvalue

// dw_header.itemchanged(long row, dwobject dwo, string data) returns long [event]
	dwitemstatus lrs_status
	long ll_code
	long ll_detailrows
	long ll_suppcode
	long ll_custcode
	long ll_counter
	long ll_customerbalance
	long ll_headerinvno
	long ll_patientcode
	integer rt_code
	long ll_icode
	long ld_saleprice1
	long ld_saleprice2
	long ld_saleprice3
	long ld_avgprice
	long li_packunits
	string ls_result
	string ls_null
	string ls_aliasname
	string ls_regno
	datetime ld_currdate
	date ld_datepart
	time lt_timepart
	char lc_newcustomer
	integer li_res
	choose case dwo.name
	case "date"
		if isdate(left(data, 10)) then
			ld_datepart = date(left(data, 10))
			if istime(mid(data, 12, 8)) then
				lt_timepart = time(mid(data, 12, 8))
				ld_currdate = datetime(ld_datepart, lt_timepart)
			else
				rt_code = 1
			end if
		else
			rt_code = 1
		end if
	case "aliasname"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findcustcode(ll_custcode, data)
			if li_res > 0 then
				setitem(row, "custcode", ll_custcode)
				rt_code = 0
			else
				messagebox("Customer Validation", "Customer with  Alias Name  " + data + "   does not exist")
				rt_code = 1
			end if
		end if
	case "custcode"
		if not isnull(data) then
			ll_code = long(data)
			parent.setredraw(false)
			if parent.parent.parent.wf_customerinfo(ll_code) <> 0 then
				messagebox("Database Error", "Can not retrieve information of customer from database")
				rt_code = 1
			else
				if accepttext() = -1 then
					return 1
				end if
				ls_aliasname = parent.parent.parent.idc_customers.getitemstring(parent.parent.parent.idc_customers.getrow(), "accounts_aliasname")
				setitem(row, "aliasname", ls_aliasname)
			end if
			parent.setredraw(true)
		end if
		return rt_code
	end choose
	return rt_code

