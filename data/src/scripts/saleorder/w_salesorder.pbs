// window w_salesorder (saleorder)  ancestor: w_multi_entry

// w_salesorder.ue_setitemfocus() returns 0 [event]
	string ls_null
	setnull(ls_null)
	if f_stringpreferences("itemcode") = "Y" then
		this.id_detail.setcolumn("fullcode")
		this.id_detail.setfocus()
		return
	end if
	this.id_detail.setitem(this.id_detail.getrow(), "itemname", " ")
	this.id_detail.setcolumn("itemname")
	this.id_detail.setfocus()
	this.id_detail.setitem(this.id_detail.getrow(), "itemname", ls_null)

// w_salesorder.ue_enableprint() returns 0 [event]
	this.im_menu.m_file.m_print.enabled = true

// w_salesorder.ue_deleteinvoice() returns 0 [event]
	long ll_invcode
	long ll_counter
	long ll_usercode
	long ll_found
	long ll_deleteoption
	datetime ldt_server_datetime
	string ls_errtext
	string ls_msgtitle
	string ls_msg
	string ls_date_errtext
	string ls_askuserpwd
	boolean lb_deletionallowed
	ls_msgtitle = "Delete Sales Order"
	ls_msg = "Delete Operation Terminated Unsuccessfuly~r~n"
	ll_found = 0
	if this.ii_saletype = 3 then
		ll_found = gds_securitywindow.find("rightcode = 572", 1, gds_securitywindow.rowcount())
	else
		ll_found = gds_securitywindow.find("rightcode = 573", 1, gds_securitywindow.rowcount())
	end if
	if ll_found <= 0 then
		messagebox(ls_msgtitle, ls_msg + "Reason: Not enough rights to delete Sales Order", stopsign!)
		return
	end if
	if this.ii_saletype = 2 then
		ls_askuserpwd = "CreditSaleAskUserPassword"
	else
		ls_askuserpwd = "Salesalesmanwindow"
	end if
	if f_stringpreferences(ls_askuserpwd) = "Y" then
		open(w_salesmanpassword)
		ll_usercode = long(message.doubleparm)
		setfocus()
	else
		ll_usercode = gl_usercode
	end if
	if ll_usercode > 0 then
		if this.il_selectedrow <= 0 then
			messagebox(ls_msgtitle, ls_msg + "Please Select a Valid Sales Order to delete", stopsign!)
			return
		end if
		ll_invcode = this.id_list.object.code[this.il_selectedrow]
		if isnull(ll_invcode) or ll_invcode < 0 then
			messagebox(ls_msgtitle, ls_msg + "Please Select a Valid Sales Order To delete", stopsign!)
			return
		end if
		ll_deleteoption = messagebox(ls_msgtitle, "Delete this Sale Order permanently from Database?", question!, yesnocancel!, 2)
		if ll_deleteoption <> 1 then
			return
		end if
		if wf_isdeleted(ll_invcode) = true then
			messagebox(ls_msgtitle, ls_msg + "Reason: Sale Order already deleted", stopsign!)
			return
		end if
		if wf_isfinalized(ll_invcode) = true then
			messagebox(ls_msgtitle, ls_msg + "Reason: Sale Order already Finalized and Can not be deleted", stopsign!)
			return
		end if
		if wf_isposted(ll_invcode) = true then
			messagebox(ls_msgtitle, ls_msg + "Reason: Posted Sale Order can not be deleted", stopsign!)
			return
		end if
		if wf_isinvoiceinuse(ll_invcode) = true then
			messagebox(ls_msgtitle, ls_msg + "Reason: Sale Order already in use by some other user.~r~nKindly try again after sometime.", stopsign!)
			return
		end if
		if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_msg + "Reason: " + ls_date_errtext, stopsign!)
			return
		end if
		SQL rollback USING this.it_transobject;
		SQL update DBO.SaleOrderHeader Set Deleted ='Y' , ModifiedBy =:ll_usercode , Date =:ldt_server_datetime WHERE SaleOrderCode =:ll_invcode AND Deleted ='N' AND Posted ='N' AND Finalized ='N' USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			SQL commit USING this.it_transobject;
			messagebox(ls_msgtitle, "Sale Order Successfully Deleted")
			return
		else
			SQL rollback USING this.it_transobject;
			messagebox(ls_msgtitle, ls_msg + "Reason: " + this.it_transobject.sqlerrtext, stopsign!)
			return
		end if
		return
	end if
	messagebox(ls_msgtitle, ls_msg + "Reason: " + "Please enter a Valid user/password", stopsign!)

// w_salesorder.ue_viewinvmargin() returns 0 [event]
	long ll_count
	datastore lds_invitemlist
	boolean lb_listtab
	s_datastore lstr
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if not lb_listtab then
		lds_invitemlist = create datastore
		lds_invitemlist.dataobject = "d_marginpreview_report"
		lds_invitemlist.settransobject(sqlca)
		this.id_detail.accepttext()
		this.id_footer.accepttext()
		for ll_count = 1 to this.id_detail.rowcount()
			lds_invitemlist.insertrow(0)
			lds_invitemlist.setitem(ll_count, "fullcode", this.id_detail.getitemstring(ll_count, "fullcode"))
			lds_invitemlist.setitem(ll_count, "itemname", this.id_detail.getitemstring(ll_count, "itemname"))
			lds_invitemlist.setitem(ll_count, "saleprice", this.id_detail.getitemnumber(ll_count, "saleprice"))
			lds_invitemlist.setitem(ll_count, "avgprice", this.id_detail.getitemnumber(ll_count, "avgprice"))
			lds_invitemlist.setitem(ll_count, "looseqty", this.id_detail.getitemnumber(ll_count, "looseqty"))
			lds_invitemlist.setitem(ll_count, "discperc", this.id_detail.getitemnumber(ll_count, "discperc"))
			lds_invitemlist.setitem(ll_count, "itemflatdisc", this.id_detail.getitemnumber(ll_count, "itemflatdisc"))
			lds_invitemlist.setitem(ll_count, "invdiscperc", this.id_footer.getitemnumber(1, "invdiscperc"))
		next
		lstr.ds = lds_invitemlist
		lstr.s_name1 = "d_marginpreview_report"
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		destroy lds_invitemlist
	end if

// w_salesorder.ue_enforcedefaultfocussettings() returns 0 [event]
	string ls_focuscolsetting
	string ls_setting
	choose case this.ii_saletype
	case 2
		ls_focuscolsetting = f_stringpreferences("creditsaledefaultfocussetting")
	case else
		ls_focuscolsetting = f_stringpreferences("cashsaledefaultfocussetting")
	end choose
	if ls_focuscolsetting = "detailwindow" then
		post event ue_setitemfocus()
		return
	end if
	ls_setting = this.id_master.describe(trim(ls_focuscolsetting) + ".visible")
	if trim(ls_setting) = "1" then
		this.id_master.setcolumn(ls_focuscolsetting)
		this.id_master.setfocus()
		return
	end if
	choose case this.ii_saletype
	case 2
		this.id_master.setfocus()
		return
	end choose
	post event ue_setitemfocus()

// w_salesorder.ue_populate_so_from_datacarrydb() returns long [event]
	datastore lds_sodetail
	long ll_detailrows
	long ll_count
	long ll_row
	long ll_master_row
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_lockedcount
	long ll_retrievecount
	integer li_result
	integer li_rtncode
	boolean lb_populateflag
	string ls_connsetting
	string ls_sodetailquery
	string ls_newsyntax
	string ls_error_syntax
	string ls_errortxt
	long ll_socode
	s_arguements lstr_arg
	u_transaction lt_transobject
	ll_master_row = this.id_master.rowcount()
	if wf_iseditable() = false then
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 and not isnull(this.id_detail.object.icode[1]) then
		li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
		if li_result = 1 then
			for ll_count = 1 to ll_detailrows
				this.id_detail.deleterow(0)
			next
			this.id_detail.reset()
		else
			lb_populateflag = false
		end if
	end if
	if lb_populateflag = true then
		open(w_populate_so_from_datacarrydb)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = -1 then
			lb_populateflag = false
		else
			lb_populateflag = true
		end if
	end if
	if lb_populateflag = true then
		lt_transobject = create u_transaction
		SQL start USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Connection Problem", "Unable to connect to database.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
			return -1
		end if
		SQL EXECUTE IMMEDIATE :ls_connsetting USING lt_transobject;
		ll_socode = lstr_arg.l_code1
		lds_sodetail = create datastore
		ls_sodetailquery = "Select ~tD.SaleOrdercode, D.icode, D.looseqty, D.bonusqty, D.packunits, D.saleprice, D.discperc, D.itemflatdisc, H.CustCode, InvDiscPerc=H.DiscPerc, H.MiscCharges, H.FlatDisc, H.Remarks  " + "From ~t" + gs_inlinkserver + "." + gs_inlinkserverdb + "." + gs_inlinkserverowner + "." + "SaleOrderDetail D, " + gs_inlinkserver + "." + gs_inlinkserverdb + "." + gs_inlinkserverowner + "." + "SaleOrderHeader H " + "Where ~tD.saleordercode = " + string(ll_socode) + " AND H.saleordercode = D.saleordercode " + "order by D.rowid"
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_sodetailquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For Sale Order Header DataStore")
			this.id_detail.setredraw(true)
			return -1
		else
			ls_error_syntax = ""
			lds_sodetail.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For Sale Order Header DataStore")
				this.id_detail.setredraw(true)
				return -1
			end if
		end if
		lds_sodetail.settransobject(lt_transobject)
		if lds_sodetail.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source Sale Order Header.")
			this.id_detail.setredraw(true)
			return -1
		end if
		this.id_detail.reset()
		ll_rowcount = lds_sodetail.rowcount()
		if ll_rowcount > 0 and this.id_master.rowcount() > 0 then
			this.id_master.object.custcode[this.id_master.rowcount()] = lds_sodetail.object.custcode[1]
			this.id_master.object.flatdisc[this.id_master.rowcount()] = lds_sodetail.object.flatdisc[1]
			this.id_master.object.discperc[this.id_master.rowcount()] = lds_sodetail.object.invdiscperc[1]
			this.id_master.object.misccharges[this.id_master.rowcount()] = lds_sodetail.object.misccharges[1]
			this.id_master.object.remarks[this.id_master.rowcount()] = lds_sodetail.object.remarks[1]
		end if
		for ll_count = 1 to ll_rowcount
			ll_icode = lds_sodetail.object.icode[ll_count]
			ll_row = this.id_detail.insertrow(0)
			if wf_inititeminfo(ll_icode, ll_row, li_rtncode, ls_errortxt) = true then
				this.id_detail.object.looseqty[ll_row] = lds_sodetail.object.looseqty[ll_count]
				this.id_detail.object.bonusqty[ll_row] = lds_sodetail.object.bonusqty[ll_count]
				this.id_detail.object.saleprice[ll_row] = lds_sodetail.object.saleprice[ll_count]
				if long(this.id_detail.object.discperc.visible) = 1 then
					this.id_detail.object.discperc[ll_row] = lds_sodetail.object.discperc[ll_count]
				end if
				if long(this.id_detail.object.itemflatdisc.visible) = 1 then
					this.id_detail.object.itemflatdisc[ll_row] = lds_sodetail.object.itemflatidisc[ll_count]
				end if
				ll_retrievecount = ll_retrievecount + 1
			else
				ll_lockedcount = ll_lockedcount + 1
			end if
		next
		destroy lds_sodetail
		SQL stop USING lt_transobject;
		destroy lt_transobject
	end if
	if ll_retrievecount = ll_rowcount then
		messagebox("Result", "Sale Order Successfully populated~n~r" + string(ll_rowcount) + " Items populated. ")
	else
		messagebox("Result", "Total item(s) were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_lockedcount) + " item(s) populated successfully~n~r" + string(ll_lockedcount) + " item(s) were not populated")
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_salesorder.wf_visibleinvisiblediscount() returns integer
	this.id_detail.object.discperc.visible = 0
	this.id_detail.object.discperc.initial = "0"
	return 1

// w_salesorder.wf_allowsalemodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM SaleOrderDetail WHERE SaleOrderCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_salesorder.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_salesorder.wf_closelist() returns 0
	this.ib_itemslistopen = false
	this.id_itemslist.hide()

// w_salesorder.wf_copyinvoice() returns integer
	datastore lds_saletemplatedetail
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrows
	long ll_insrow
	integer li_retcode
	integer li_errcode
	integer li_counter
	integer ll_found
	integer ll_innercounter
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	boolean lb_bonus
	double ld_looseqty
	double ld_holdqty
	double ld_holdbonusqty
	datawindowchild ldc_godown
	if wf_iseditable() = false then
		return 0
	end if
	lds_saletemplatedetail = create datastore
	open(w_copysaleinvoicefrom)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		destroy lds_saletemplatedetail
		return -1
	end if
	if f_stringpreferences("BonusInSale") = "Y" then
		lb_bonus = true
	end if
	if lstr_template.c_copyinvfrom = "T" then
		lds_saletemplatedetail.dataobject = "d_saletemplate_detail"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for ll_rowcount = 1 to ll_totalrows
			ll_insrow = this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_insrow, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_insrow, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "qty"))
		next
	elseif lstr_template.c_copyinvfrom = "I" then
		lds_saletemplatedetail.dataobject = this.id_detail.dataobject
		lds_saletemplatedetail.settransobject(this.it_transobject)
		li_retcode = lds_saletemplatedetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to li_counter
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "looseqty"))
			if lb_bonus then
				this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "bonusqty"))
			end if
		next
	elseif lstr_template.c_copyinvfrom = "P" then
		if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
			lds_saletemplatedetail.dataobject = "d_normalpurchasedetail"
		else
			lds_saletemplatedetail.dataobject = "d_loosepurchasedetail"
		end if
		lds_saletemplatedetail.settransobject(this.it_transobject)
		li_retcode = lds_saletemplatedetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_detailrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to li_counter
			event ue_deleteitem()
		next
		for li_counter = 1 to li_counter
			ld_holdqty = 0
			ld_holdbonusqty = 0
			ll_icode = lds_saletemplatedetail.object.icode[li_counter]
			ll_found = lds_saletemplatedetail.find("icode=" + string(ll_icode), 1, li_counter - 1)
			if ll_found > 0 then
				if ll_detailrows = 1 then
					lb_isitemexists = false
				elseif li_counter = 1 then
					lb_isitemexists = false
				else
					lb_isitemexists = true
				end if
			else
				lb_isitemexists = false
			end if
			if lb_isitemexists = false then
				if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
					ld_holdqty = lds_saletemplatedetail.object.packqty[li_counter]
					ld_holdbonusqty = lds_saletemplatedetail.object.bonusqty[li_counter]
				else
					ld_holdqty = lds_saletemplatedetail.object.looseqty[li_counter]
					ld_holdbonusqty = lds_saletemplatedetail.object.bonusqty[li_counter]
				end if
				if li_counter <> ll_detailrows then
					ll_found = lds_saletemplatedetail.find("icode=" + string(ll_icode), li_counter + 1, ll_detailrows)
					ll_innercounter = ll_found
					do while ll_found > 0 and ll_innercounter <= ll_detailrows
						if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
							ld_holdqty = ld_holdqty + lds_saletemplatedetail.object.packqty[ll_found]
							ld_holdbonusqty = ld_holdbonusqty + lds_saletemplatedetail.object.bonusqty[ll_found]
						else
							ld_holdqty = ld_holdqty + lds_saletemplatedetail.object.looseqty[ll_found]
							ld_holdbonusqty = ld_holdbonusqty + lds_saletemplatedetail.object.bonusqty[ll_found]
						end if
						ll_innercounter = ll_found + 1
						ll_found = lds_saletemplatedetail.find("icode=" + string(ll_icode), ll_innercounter, ll_detailrows)
					loop
				end if
				ll_insertedrows = this.id_detail.insertrow(0)
				wf_inititeminfo(lds_saletemplatedetail.getitemnumber(li_counter, "icode"), ll_insertedrows, li_errcode, ls_errortext)
				if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
					ld_holdqty = ld_holdqty * lds_saletemplatedetail.getitemnumber(li_counter, "packunits")
					ld_holdbonusqty = ld_holdbonusqty * lds_saletemplatedetail.getitemnumber(li_counter, "packunits")
				end if
				this.id_detail.setitem(ll_insertedrows, "looseqty", ld_holdqty)
				if lb_bonus then
					this.id_detail.setitem(ll_insertedrows, "bonusqty", ld_holdbonusqty)
				end if
			end if
		next
	elseif lstr_template.c_copyinvfrom = "R" then
		lds_saletemplatedetail.dataobject = "d_OpenWholeSaleReturnDetail"
		lds_saletemplatedetail.settransobject(this.it_transobject)
		li_retcode = lds_saletemplatedetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		ll_totalrows = lds_saletemplatedetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saletemplatedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to li_counter
			event ue_deleteitem()
		next
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_saletemplatedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "looseqty"))
			if lb_bonus then
				this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saletemplatedetail.getitemnumber(ll_rowcount, "bonusqty"))
			end if
		next
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	destroy lds_saletemplatedetail
	return li_retcode

// w_salesorder.wf_customerinfo(long al_custcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	string ls_aliasname
	integer li_messagecode
	long ll_currow
	double ld_currbalance
	SQL SELECT customer.address1 , customer.city , customer.phone , customer.messagecode , accounts.aliasname INTO :ls_address, :ls_city, :ls_phone, :li_messagecode, :ls_aliasname FROM customer , accounts WHERE customer.custcode =:al_custcode and customer.custcode =accounts.acccode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
		this.id_master.object.address[ll_currow] = ls_address
		this.id_master.object.aliasname[ll_currow] = ls_aliasname
		this.id_master.object.city[ll_currow] = ls_city
		this.id_master.object.phone[ll_currow] = ls_phone
		if isnull(li_messagecode) then
			this.id_master.object.messagecode[ll_currow] = 1
		else
			this.id_master.object.messagecode[ll_currow] = li_messagecode
		end if
	end if
	return this.it_transobject.sqlcode

// w_salesorder.wf_customermessagevalidation(long al_custcode, long al_messagecode) returns integer
	integer li_messagecode
	long ll_currrow
	SQL SELECT customer.messagecode INTO :li_messagecode FROM customer WHERE customer.custcode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currrow = this.id_master.getrow()
		if isnull(li_messagecode) then
			ll_currrow = 0
		else
			ll_currrow = 1
		end if
	end if
	return ll_currrow

// w_salesorder.wf_deleteallemptydetailrows() returns integer
	long ll_count
	long ll_deletecount
	ll_deletecount = 0
	for ll_count = 1 to this.id_detail.rowcount()
		if isnull(this.id_detail.getitemnumber(ll_count, "icode")) then
			ll_deletecount = ll_deletecount + 1
			this.id_detail.deleterow(ll_count)
		end if
	next
	return ll_deletecount

// w_salesorder.wf_deletesaleinvoice(long al_invcode) returns integer
	SQL Delete saleorderdetail Where saleorderdetail.SaleOrderCode =:al_invcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_salesorder.wf_fetchserverdate(boolean ab_checked) returns long
	if ab_checked then
		this.ib_fetchserverdate = true
	else
		this.ib_fetchserverdate = false
	end if
	return 0

// w_salesorder.wf_findcustcode(string as_aliasname, integer ai_custcode) returns integer
	integer li_custcode
	integer ll_retflag
	string ls_itemname
	SQL SELECT accounts.acccode INTO :li_custcode FROM accounts , customer WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =customer.custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_custcode = li_custcode
		if isnull(ai_custcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_salesorder.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	integer ll_retflag
	long ll_icode
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND ( item.Restricted ='N' OR ( Item.Restricted ='Y' AND Exists ( select *from grouprights where rightcode =515 and groupcode =:this.il_groupcode ) ) ) AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND ( item.Restricted ='N' OR ( Item.Restricted ='Y' AND Exists ( select *from grouprights where rightcode =515 and groupcode =:this.il_groupcode ) ) ) USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_salesorder.wf_findpatientcode(string as_regno, integer ai_patientcode) returns integer
	integer li_patientcode
	integer ll_retflag
	string ls_itemname
	SQL SELECT patient.patientcode INTO :li_patientcode FROM patient WHERE patient.regno =:as_regno AND patient.active ='Y' and patient.patientcatcode in ( select distinct patientcatcode from patientcatallowedmodule where moduleid =:this.ii_saleordermodule ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_patientcode = li_patientcode
		if isnull(ai_patientcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_salesorder.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	long iccode
	long icatcode
	long packcode
	long manfcode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_salesorder.wf_get_patient(long al_prescode) returns long
	long ll_patientcode
	SQL Select patientcode INTO :ll_patientcode From PrescriptionHeader Where PresCode =:al_prescode USING sqlca;
	if sqlca.sqlcode = 0 then
		return ll_patientcode
	end if
	return -1

// w_salesorder.wf_getcustomerinfo() returns 0
	long ll_custcode
	if this.id_master = getfocus() and this.id_master.rowcount() > 0 then
		ll_custcode = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		openwithparm(w_customerinfo, ll_custcode)
	end if

// w_salesorder.wf_getitemassociategcode(long la_icode) returns integer
	integer li_gcode
	SQL Select Gcode INTO :li_gcode From item Where icode =:la_icode USING this.it_transobject;
	return li_gcode

// w_salesorder.wf_getmaxdate(datetime ad_date) returns integer
	SQL Select Max ( Date ) INTO :ad_date From SaleOrderHeader USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_salesorder.wf_isdeleted(long al_invcode) returns boolean
	long ll_count
	SQL SELECT Count ( SaleOrderCode ) INTO :ll_count FROM SaleOrderHeader WHERE SaleOrderCode =:al_invcode and Deleted ='Y' USING sqlca;
	if sqlca.sqlcode = 0 then
		if ll_count > 0 then
			return true
		else
			return false
		end if
		return
	end if
	return false

// w_salesorder.wf_isinvoiceinuse(long al_invoiceno) returns boolean
	long ll_found
	SQL Select count ( *) INTO :ll_found From SaleOrderHeader Where SaleOrderCode =:al_invoiceno and Posted ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_found = 0 or isnull(ll_found) then
			ll_found = 0
			SQL Select count ( *) INTO :ll_found From SaleOrderHeader With ( ReadPast , RowLock , UpdLock ) Where SaleOrderCode =:al_invoiceno USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ll_found = 0 then
					return true
				else
					return false
				end if
			else
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_salesorder.wf_isposted(long al_invcode) returns boolean
	long ll_count
	SQL SELECT Count ( SaleOrderCode ) INTO :ll_count FROM SaleOrderHeader WHERE SaleOrderCode =:al_invcode and Posted ='Y' USING sqlca;
	if sqlca.sqlcode = 0 then
		if ll_count > 0 then
			return true
		else
			return false
		end if
		return
	end if
	return false

// w_salesorder.wf_itemnetprice(double al_saleprice, double al_discperc, double al_itemflatdisc, long al_icode) returns integer
	double ld_saleprice
	double ld_recentpurprice
	double ld_discperc
	double ld_itemflatdisc
	double ld_itemnetprice
	integer li_packunits
	integer li_retmsgcode
	SQL Select item.RecentPurPrice , item.packunits INTO :ld_recentpurprice, :li_packunits From Item Where item.icode =:al_icode USING this.it_transobject;
	if li_packunits < 1 or isnull(li_packunits) then
		li_packunits = 1
	end if
	ld_itemnetprice = (al_saleprice - al_itemflatdisc) * (1.0 - al_discperc / 100.0)
	if ld_itemnetprice < ld_recentpurprice / li_packunits then
		li_retmsgcode = messagebox("Sale Validation", "Net Price " + string(ld_itemnetprice) + " is less than Recent Purchase Price~r~n Do you want to continue", question!, yesno!)
		if li_retmsgcode = 1 then
			return 0
		else
			return 1
		end if
		return
	end if
	return 0

// w_salesorder.wf_itemsalehistory() returns 0
	s_itemsalehistory ls_itemsalehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itemsalehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itemsalehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itemsalehistory, ls_itemsalehistory)
	end if

// w_salesorder.wf_populate_postedsaleinv() returns integer
	datastore lds_saledetail
	s_arguements lstr_arg
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_custcode
	long ll_counter
	integer li_retcode
	integer li_errcode
	string ls_errortext
	boolean lb_enablesave
	boolean lb_bonus
	if wf_iseditable() = false then
		return 0
	end if
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	if isnull(ll_custcode) or ll_custcode = 0 then
		messagebox("Customer Validation", "Can not populate sale invoices~r~nPlease Select Valid Customer")
		this.id_master.setcolumn("custcode")
		this.id_master.setfocus()
		return -1
	end if
	if f_stringpreferences("BonusInSale") = "Y" then
		lb_bonus = true
	end if
	if wf_iseditable() = false then
		return 0
	end if
	lds_saledetail = create datastore
	lds_saledetail.dataobject = "d_postedsale_for_proformainvoice"
	lds_saledetail.settransobject(this.it_transobject)
	openwithparm(w_populate_saleinvoices, ll_custcode)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		if lstr_arg.i_supress then
			this.id_master.setitem(this.id_master.rowcount(), "remarks", lstr_arg.s_name2)
		end if
		ll_totalrows = lds_saledetail.retrieve(lstr_arg.ia_integerlist, lstr_arg.s_name1)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saledetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		ll_counter = 0
		ll_detailrows = this.id_detail.rowcount()
		for ll_counter = 1 to ll_detailrows
			event ue_deleteitem()
		next
		ll_counter = 0
		for ll_rowcount = 1 to ll_totalrows
			ll_counter = this.id_detail.insertrow(0)
			if wf_inititeminfo(lds_saledetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext) then
				this.id_detail.setitem(ll_counter, "icode", lds_saledetail.getitemnumber(ll_rowcount, "icode"))
				this.id_detail.setitem(ll_counter, "gcode", lds_saledetail.getitemnumber(ll_rowcount, "gcode"))
				this.id_detail.setitem(ll_counter, "batch", lds_saledetail.getitemstring(ll_rowcount, "batch"))
				this.id_detail.setitem(ll_counter, "expiry", lds_saledetail.getitemdatetime(ll_rowcount, "expiry"))
				this.id_detail.setitem(ll_counter, "looseqty", lds_saledetail.getitemnumber(ll_rowcount, "looseqty"))
				this.id_detail.setitem(ll_counter, "packunits", lds_saledetail.getitemnumber(ll_rowcount, "packunits"))
				this.id_detail.setitem(ll_counter, "saleprice", lds_saledetail.getitemnumber(ll_rowcount, "saleprice"))
				this.id_detail.setitem(ll_counter, "avgprice", lds_saledetail.getitemnumber(ll_rowcount, "avgprice"))
				this.id_detail.setitem(ll_counter, "rate", lds_saledetail.getitemnumber(ll_rowcount, "rate"))
				this.id_detail.setitem(ll_counter, "discperc", lds_saledetail.getitemnumber(ll_rowcount, "discperc"))
				this.id_detail.setitem(ll_counter, "itemflatdisc", lds_saledetail.getitemnumber(ll_rowcount, "itemflatdisc"))
				this.id_detail.setitem(ll_counter, "saleitemdescription", lds_saledetail.getitemstring(ll_rowcount, "saleitemdescription"))
				this.id_detail.setitem(ll_counter, "packprice", lds_saledetail.getitemnumber(ll_rowcount, "packprice"))
				this.id_detail.setitem(ll_counter, "unitsalestax", lds_saledetail.getitemnumber(ll_rowcount, "unitsalestax"))
				this.id_detail.setitem(ll_counter, "gstperc", lds_saledetail.getitemnumber(ll_rowcount, "gstperc"))
				this.id_detail.setitem(ll_counter, "packqtyforsale", lds_saledetail.getitemnumber(ll_rowcount, "packqtyforsale"))
				this.id_detail.setitem(ll_counter, "sourcesaleinvcode", lds_saledetail.getitemnumber(ll_rowcount, "sourcesaleinvcode"))
				this.id_detail.setitem(ll_counter, "salerowid", lds_saledetail.getitemnumber(ll_rowcount, "salerowid"))
				if lb_bonus = true then
					this.id_detail.setitem(ll_counter, "bonusqty", lds_saledetail.getitemnumber(ll_rowcount, "bonusqty"))
					this.id_detail.setitem(ll_counter, "bonuspackqtyforsale", lds_saledetail.getitemnumber(ll_rowcount, "bonuspackqtyforsale"))
				else
					this.id_detail.setitem(ll_counter, "bonusqty", 0)
					this.id_detail.setitem(ll_counter, "bonuspackqtyforsale", 0)
				end if
			else
				event ue_deleteitem()
			end if
		next
	else
		li_retcode = -1
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	destroy lds_saledetail
	return li_retcode

// w_salesorder.wf_populate_prescription() returns long
	datastore lds_prescdetail
	dwobject dwo
	s_arguements lstr_arg
	long ll_prescode
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrow
	long ll_counter
	long ll_patientcode
	long ll_null
	integer li_retcode
	integer li_errcode
	integer ll_found
	integer ll_innercounter
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	double ld_satisfiedqty
	double ld_newqty
	double ld_qty
	double ld_looseqty
	double ld_holdqty
	double ld_holdbonusqty
	if wf_iseditable() = false then
		return 0
	end if
	open(w_copyprescription_all)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 0 then
		ll_prescode = lstr_arg.l_code1
		lds_prescdetail = create datastore
		lds_prescdetail.dataobject = "d_prescription_detail_for_saleorder"
		lds_prescdetail.settransobject(this.it_transobject)
		ll_totalrows = lds_prescdetail.retrieve(ll_prescode)
		if ll_totalrows < 0 then
			return -1
		end if
		ll_totalrows = lds_prescdetail.rowcount()
		ll_patientcode = wf_get_patient(ll_prescode)
		dwo = this.id_master.object.patientcode
		this.id_master.setcolumn("patientcode")
		this.id_master.setitem(this.id_master.getrow(), "patientcode", ll_patientcode)
		this.id_master.setitem(this.id_master.getrow(), "prescode", ll_prescode)
		this.id_master.setitem(1, "patientregno", this.idc_patient.getitemstring(this.idc_patient.getrow(), "regno"))
		this.id_master.event itemchanged(1, dwo, string(ll_patientcode))
		if this.ii_saletype = 2 and long(this.id_master.object.patientcode.visible) = 0 then
			this.id_master.object.custcode.protect = 0
			this.id_master.object.aliasname.protect = 0
		end if
		ll_rowcount = this.id_detail.rowcount()
		for ll_counter = 1 to ll_rowcount
			event ue_deleteitem()
		next
		for ll_counter = 1 to ll_totalrows
			ld_qty = lds_prescdetail.getitemnumber(ll_counter, "noofunits") * lds_prescdetail.getitemnumber(ll_counter, "dosefactor")
			ll_icode = lds_prescdetail.getitemnumber(ll_counter, "icode")
			ld_newqty = ld_qty - lds_prescdetail.getitemnumber(ll_counter, "saleorderedqty")
			if ld_newqty > 0.0 then
				ll_insertedrow = this.id_detail.insertrow(0)
				wf_inititeminfo(ll_icode, ll_insertedrow, li_errcode, ls_errortext)
				this.id_detail.setitem(ll_insertedrow, "looseqty", ld_newqty)
				this.id_detail.setitem(ll_insertedrow, "prescriptionrowid", lds_prescdetail.getitemnumber(ll_counter, "rowid"))
				lb_enablesave = true
			end if
		next
		if lb_enablesave then
			this.im_menu.m_file.m_save.enabled = true
			this.im_menu.m_file.m_print.enabled = true
			wf_grandtotal()
		else
			setnull(ll_null)
			this.id_master.setitem(this.id_master.getrow(), "prescode", ll_null)
			messagebox("Items Validation", "No items left to populate for this prescription.")
		end if
		destroy lds_prescdetail
	end if
	return 0

// w_salesorder.wf_preinvinfo() returns 0
	s_previnvinfo ls_previnvinfo
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_previnvinfo.ar_customer = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		ls_previnvinfo.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_previnvinfo.ar_invdate = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_previnvinfo, ls_previnvinfo)
	end if

// w_salesorder.wf_print() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_count
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			for ll_count = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
				this.id_print.retrieve(ll_count)
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			next
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	return li_errcode

// w_salesorder.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_salesorder.wf_retrievelist() returns long
	string[] ls_posted
	string ls_showrows
	integer[] li_salecategory
	integer li_invforlastdays
	integer li_listrows
	datetime ld_invdate
	long ll_counter
	boolean lb_netamount
	ld_invdate = datetime(relativedate(today(), li_invforlastdays))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		if f_stringpreferences("ShowAllInvInCreditSaleList") = "Y" then
			li_salecategory[1] = 1
			li_salecategory[2] = 2
			li_salecategory[3] = 3
		else
			li_salecategory[1] = 1
			li_salecategory[2] = 2
		end if
	else
		li_salecategory[1] = this.ii_saletype
	end if
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 538 then
			ls_showrows = "Y"
		end if
	next
	if ls_showrows = "N" then
		this.tab_retrieve.tabpage_list.cb_retrieve.enabled = false
		this.tab_retrieve.tabpage_list.em_invno.enabled = false
	end if
	return this.id_list.retrieve(this.ii_socatcode, li_salecategory, ls_posted, ld_invdate, ls_showrows, this.il_groupcode, this.ii_module)

// w_salesorder.wf_retrievelistall() returns long
	string[] ls_posted
	string ls_showrows
	integer[] li_salecategory
	long ll_counter
	datetime ld_invdate
	ld_invdate = datetime(date("12/12/1998"), time("00:00:00"))
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 538 then
			ls_showrows = "Y"
		end if
	next
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		if f_stringpreferences("ShowAllInvInCreditSaleList") = "Y" then
			li_salecategory[1] = 1
			li_salecategory[2] = 2
			li_salecategory[3] = 3
		else
			li_salecategory[1] = 1
			li_salecategory[2] = 2
		end if
	else
		li_salecategory[1] = this.ii_saletype
	end if
	return this.id_list.retrieve(this.ii_socatcode, li_salecategory, ls_posted, ld_invdate, ls_showrows, this.il_groupcode, this.ii_module)

// w_salesorder.wf_savastemplate() returns integer
	s_saletemplateheader lstr_templateheader
	long ll_invid
	integer li_retcode
	long ll_code
	long ll_qty
	long ll_icode
	long ll_totalrows
	long ll_rowcount
	if wf_iseditable() = false then
		return -1
	end if
	if this.tab_retrieve.selectedtab = 2 then
		return -1
	end if
	open(w_savesaleastemplate)
	lstr_templateheader = message.powerobjectparm
	f_newtableid("SaleTemplateHeader", ll_invid)
	SQL INSERT INTO SaleTemplateHeader ( saletemplatecode , date , modified , name ) values ( :ll_invid , :lstr_templateheader.dt_templatedate , :lstr_templateheader.dt_templatedate , :lstr_templateheader.s_template ) USING this.it_transobject;
	ll_totalrows = this.id_detail.rowcount()
	for ll_rowcount = 1 to ll_totalrows
		ll_code = ll_invid
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ll_qty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		SQL insert into saletemplatedetail ( saletemplatecode , icode , looseqty ) values ( :ll_code , :ll_icode , :ll_qty ) USING this.it_transobject;
	next
	setpointer(hourglass!)
	if this.it_transobject.sqlcode < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return li_retcode
	else
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Template saved", exclamation!, ok!, 1)
	end if
	return li_retcode

// w_salesorder.wf_searchgodown() returns long
	s_popup_selection lstr_selection
	long ll_icode
	ll_icode = this.id_detail.object.icode[this.id_detail.getrow()]
	lstr_selection.l_longarray[1] = ll_icode
	lstr_selection.l_longarray[2] = this.il_strategy
	lstr_selection.l_longarray[3] = this.il_groupcode
	lstr_selection.l_longarray[4] = this.ii_module
	openwithparm(w_popup_godownselection, lstr_selection)
	lstr_selection = message.powerobjectparm
	if lstr_selection.l_code > 0 then
		this.id_detail.setitem(this.id_detail.getrow(), "gcode", lstr_selection.l_code)
	end if
	return 0

// w_salesorder.wf_selectcustomerareawise() returns integer
	s_popup_selection ls_popup_selection
	if this.ii_saletype = 2 and this.editflag = true and f_stringpreferences("patientOnCreditSale") = "N" then
		open(w_popup_areaselection)
		ls_popup_selection = message.powerobjectparm
		if ls_popup_selection.l_code > 0 then
			openwithparm(w_popup_customerselectionareawise_forsal, ls_popup_selection)
			ls_popup_selection = message.powerobjectparm
			if ls_popup_selection.l_code > 0 then
				this.id_master.setitem(this.id_master.getrow(), "custcode", ls_popup_selection.l_code)
				wf_setcustomername(ls_popup_selection.s_name)
				wf_setcustomerinfo(this.id_master.getrow(), 1, string(ls_popup_selection.l_code))
			end if
		end if
	end if
	return 1

// w_salesorder.wf_setcustomer() returns integer
	if f_validatedw(this.id_master) < 0 then
		return -1
	end if

// w_salesorder.wf_setcustomerinfo(long row, integer i, string data) returns integer
	long ll_code
	long ll_custcode
	long ll_counter
	long ll_icode
	long ll_customerbalance
	long ll_lastinvcode
	double ld_custgst
	double ld_gstperc1
	double ld_gstperc2
	double ld_itemdiscperc
	double ld_itemdiscperc2
	double ld_itemdiscperc3
	double ld_itemdiscperc4
	double ld_saleprice1
	double ld_saleprice2
	double ld_saleprice3
	double ld_invdiscperc
	double ld_saleprice4
	double ld_saleprice5
	double ld_itemdiscperc5
	double ld_custitemcatdiscperc
	double ld_itemflatdisc
	double ld_taxperc
	integer li_salepriceno
	integer li_itemdiscpercno
	integer li_packunits
	integer li_smancode
	integer li_null
	boolean lb_setiteminfo
	char lc_taxable
	string ls_null
	setnull(li_null)
	setnull(ls_null)
	if not isnull(data) and this.ii_saletype = 2 then
		ll_code = long(data)
		this.il_custcode = ll_code
		setredraw(false)
		if wf_customerinfo(ll_code) <> 0 then
			messagebox("Database Error", "Customer information can not be retrieved")
			setredraw(true)
			return 1
		end if
		setredraw(true)
	elseif data = "0" and this.ii_saletype = 2 then
		messagebox("Database Error", "Customer information can not be retrieved")
		return 1
	end if
	if this.id_master.accepttext() = -1 then
		return 1
	end if
	setredraw(false)
	ll_custcode = this.id_master.getitemnumber(row, "custcode")
	if this.id_detail.getrow() > 0 and isnull(this.id_detail.getitemnumber(this.id_detail.getrow(), "itemcode")) then
		if this.id_detail.getrow() = 1 or this.id_detail.rowcount() = 1 then
			this.id_detail.object.fullcode[this.id_detail.getrow()] = ls_null
			this.id_detail.object.icode[this.id_detail.getrow()] = li_null
			this.id_detail.object.itemname[this.id_detail.getrow()] = ls_null
			this.id_detail.object.bonusqty[this.id_detail.getrow()] = 0
			this.id_detail.object.saleprice[this.id_detail.getrow()] = li_null
		else
			event ue_deleteitem()
		end if
	end if
	if f_stringpreferences("InSaleCustomerBalance") = "Y" then
		for ll_counter = 1 to this.ids_customersbalance.rowcount()
			if this.ids_customersbalance.getitemnumber(ll_counter, "code1") = this.id_master.getitemnumber(row, "custcode") then
				this.ii_focuscustomer = 3
				ll_customerbalance = this.ids_customersbalance.getitemnumber(ll_counter, "value1")
				this.id_master.setitem(row, "customerbalance", ll_customerbalance)
				if ll_customerbalance > 0 then
					this.id_master.setitem(row, "debitorcredit", "Dr")
				else
					this.id_master.setitem(row, "debitorcredit", "Cr")
				end if
				exit
			else
				this.ii_focuscustomer = 3
				this.id_master.setitem(row, "debitorcredit", "Cr")
				this.id_master.setitem(row, "customerbalance", 0)
			end if
		next
	end if
	SQL Select invdiscperc , salesmancode INTO :ld_invdiscperc, :li_smancode From Customer Where custcode =:ll_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if f_stringpreferences("SalesManInSale") = "Y" then
			this.id_master.setitem(1, "smancode", li_smancode)
		end if
		if f_stringpreferences("setcustwiseiteminfo") = "Y" then
			lb_setiteminfo = true
		end if
	end if
	if lb_setiteminfo = true then
		this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
		SQL SELECT customer.defaultgst , customer.defaultsaleprice , customer.defaultitemdiscperc , taxperc =( SELECT TC.taxperc FROM TaxCategory TC WHERE TC.TaxCategoryCode =customer.taxcategorycode ) INTO :ld_custgst, :li_salepriceno, :li_itemdiscpercno, :ld_taxperc FROM customer WHERE customer.custcode =:ll_custcode USING this.it_transobject;
		if this.it_transobject.sqlcode = -1 then
			messagebox("Database Error", "Customer information can not be retrieved")
			return 1
		end if
		if not (this.it_transobject.sqlcode = 100) then
			if ld_custgst = 2.0 then
				this.id_master.setitem(1, "dd_gstperc", 2)
			else
				this.id_master.setitem(1, "dd_gstperc", 1)
			end if
		end if
		this.id_master.setitem(1, "itemdiscpercno", li_itemdiscpercno)
		this.id_master.setitem(1, "sprice", li_salepriceno)
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
			if not isnull(ll_icode) then
				SQL SELECT item.gstperc1 , item.gstperc2 , item.salediscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 , item.saleprice , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.packunits , item.taxable INTO :ld_gstperc1, :ld_gstperc2, :ld_itemdiscperc, :ld_itemdiscperc2, :ld_itemdiscperc3, :ld_itemdiscperc4, :ld_itemdiscperc5, :ld_saleprice1, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :li_packunits, :lc_taxable FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
				if this.it_transobject.sqlcode = -1 then
					messagebox("Database Error", "Item information can not be retrieved")
					return 1
				end if
				if not (this.it_transobject.sqlcode = 100) then
					if ld_custgst = 2.0 then
						this.id_detail.setitem(ll_counter, "gstperc", ld_gstperc2)
					else
						this.id_detail.setitem(ll_counter, "gstperc", ld_gstperc1)
					end if
				end if
				choose case li_salepriceno
				case 1
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice1 / li_packunits)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice1)
				case 2
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice2 / li_packunits)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice2)
				case 3
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice3 / li_packunits)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice3)
				case 4
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice4 / li_packunits)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice4)
				case 5
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice5 / li_packunits)
					this.id_detail.setitem(ll_counter, "packprice", ld_saleprice5)
				end choose
				if long(this.id_detail.object.discperc.visible) = 1 then
					if wf_getcustitemcatwisesalesdiscount(ll_icode, ll_custcode, ld_custitemcatdiscperc, ld_itemflatdisc) = true then
						this.id_detail.setitem(ll_counter, "discperc", ld_custitemcatdiscperc)
						this.id_detail.setitem(ll_counter, "itemflatdisc", ld_itemflatdisc)
					else
						choose case li_itemdiscpercno
						case 1
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc)
						case 2
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc2)
						case 3
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc3)
						case 4
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc4)
						case 5
							this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc5)
						end choose
					end if
				else
					this.id_detail.setitem(ll_counter, "discperc", 0)
				end if
				this.id_detail.object.taxable[ll_counter] = lc_taxable
				if this.ic_advancetaxonsale = "Y" and lc_taxable = "Y" then
					this.id_detail.object.itemadvancetaxperc[ll_counter] = ld_taxperc
				else
					this.id_detail.object.itemadvancetaxperc[ll_counter] = 0.00
				end if
			end if
		next
	end if
	if this.id_detail.rowcount() <= 0 then
		event ue_newitem()
		this.id_master.setfocus()
	end if
	setredraw(true)
	return 0

// w_salesorder.wf_setcustomername(string as_data) returns 0
	long ll_rowno
	ll_rowno = this.idc_customers.find("customer_name >='" + as_data + "'", 1, this.idc_customers.rowcount())
	if ll_rowno > 0 then
		this.idc_customers.selectrow(0, false)
		this.idc_customers.setrow(ll_rowno)
		this.idc_customers.scrolltorow(ll_rowno)
		this.idc_customers.selectrow(ll_rowno, true)
	end if

// w_salesorder.wf_setfocuswithscroll(string as_colname, long al_row) returns integer
	this.id_detail.scrolltorow(al_row)
	this.id_detail.setcolumn(as_colname)
	this.id_detail.setfocus()
	this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	return 1

// w_salesorder.wf_setgodownoption() returns 0
	if this.id_detail.rowcount() > 0 then
		this.ii_salegodown = this.id_detail.getitemnumber(1, "gcode")
	end if
	if this.il_strategy = 2 or this.il_strategy = 1 and this.il_godowncount = 1 then
		this.id_detail.modify("gcode" + ".Protect=1")
		this.id_detail.object.gcode.background.color = this.backcolor
	end if

// w_salesorder.wf_setitemdataoncustlatestsale() returns integer
	integer li_rowsaffected
	long ll_counter
	long ll_custcode
	long ll_icode
	double ld_saleprice
	double ld_discperc
	double ld_itemflatdisc
	double ld_looseqty
	double ld_prevbonusqty
	double ld_desiredbonus
	double ld_prevsaleqty
	string ls_bonusqty
	string ls_discperc
	string ls_itemflatdisc
	ls_bonusqty = this.id_detail.object.bonusqty.visible
	ls_discperc = this.id_detail.object.discperc.visible
	ls_itemflatdisc = this.id_detail.object.itemflatdisc.visible
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	for ll_counter = 1 to this.id_detail.rowcount()
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		ld_looseqty = this.id_detail.getitemnumber(ll_counter, "looseqty")
		li_rowsaffected = 0
		this.it_transobject.getcustwiselatestitemsale(ll_custcode, ll_icode, ld_saleprice, ld_prevsaleqty, ld_prevbonusqty, ld_discperc, ld_itemflatdisc, li_rowsaffected)
		if this.it_transobject.sqlcode = 0 then
			if li_rowsaffected > 0 then
				if f_stringpreferences("UpdSPriceUsingCustLatestSale") = "Y" then
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice)
				end if
				if ls_bonusqty = "1" and f_stringpreferences("UpdBonusQtyUsingCustLatestSale") = "Y" then
					if ld_prevsaleqty <> 0.0 then
						ld_desiredbonus = ld_looseqty / ld_prevsaleqty * ld_prevbonusqty
						this.id_detail.setitem(ll_counter, "bonusqty", ld_desiredbonus)
					end if
				end if
				if ls_discperc = "1" and f_stringpreferences("UpdDiscPercUsingCustLatestSale") = "Y" then
					this.id_detail.setitem(ll_counter, "discperc", ld_discperc)
				end if
				if ls_itemflatdisc = "1" and f_stringpreferences("UpdFlatDiscUsingCustLatestSale") = "Y" then
					this.id_detail.setitem(ll_counter, "itemflatdisc", ld_itemflatdisc)
				end if
			end if
		else
			return -1
		end if
	next
	return 1

// w_salesorder.wf_setnormalsale() returns 0
	this.ib_saveasnormalsale = true

// w_salesorder.wf_setsaleitemdesc() returns long
	long ll_row
	long ll_icode
	long ll_packunits
	long ll_custcode
	long ll_rtcode
	long li_discstatus
	long li_itemdesc_status
	long li_flatdiscstatus
	double ld_saleprice
	double ld_flatdisc
	double ld_saleprice2
	double ld_saleprice3
	double ld_saleprice4
	double ld_saleprice5
	double ld_packsalestax
	double ld_unitsalestax
	double ld_gstperc1
	double ld_gstperc2
	double ld_discperc
	double ld_discperc2
	double ld_discperc3
	double ld_discperc4
	double ld_discperc5
	double ld_purprice
	double ld_rpp
	double ld_avgprice
	double ld_retailprice
	double ld_custitemcatdiscperc
	double ld_itemflatdisc
	integer li_discpercno
	integer li_itemdiscpercno
	integer li_defaultgst
	string ls_itemname
	s_arguements lstr_arg
	ll_row = this.id_detail.getrow()
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	li_defaultgst = this.id_master.getitemnumber(1, "dd_gstperc")
	open(w_arg_item)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		ll_icode = lstr_arg.l_code1
		SQL Select name , packunits , avgprice , purprice , recentpurprice , retailprice , saleprice , flatdisc , salediscperc , salediscperc2 , salediscperc3 , salediscperc4 , salediscperc5 , packsalestax , gstperc1 , gstperc2 INTO :ls_itemname, :ll_packunits, :ld_avgprice, :ld_purprice, :ld_rpp, :ld_retailprice, :ld_saleprice, :ld_flatdisc, :ld_discperc, :ld_discperc2, :ld_discperc3, :ld_discperc4, :ld_discperc5, :ld_packsalestax, :ld_gstperc1, :ld_gstperc2 From Item Where icode =:ll_icode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if isnull(ll_packunits) or ll_packunits = 0 then
				ll_packunits = 1
			end if
			ld_unitsalestax = round(ld_packsalestax / ll_packunits, 2)
			li_discstatus = long(this.id_detail.object.discperc.visible)
			li_flatdiscstatus = long(this.id_detail.object.itemflatdisc.visible)
			if li_discstatus = 1 then
				li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
				if wf_getcustitemcatwisesalesdiscount(ll_icode, ll_custcode, ld_custitemcatdiscperc, ld_itemflatdisc) = true then
					this.id_detail.setitem(ll_row, "discperc", ld_custitemcatdiscperc)
					this.id_detail.setitem(ll_row, "itemflatdisc", ld_itemflatdisc)
				else
					choose case li_itemdiscpercno
					case 1
						this.id_detail.setitem(ll_row, "discperc", ld_discperc)
					case 2
						this.id_detail.setitem(ll_row, "discperc", ld_discperc2)
					case 3
						this.id_detail.setitem(ll_row, "discperc", ld_discperc3)
					case 4
						this.id_detail.setitem(ll_row, "discperc", ld_discperc4)
					case 5
						this.id_detail.setitem(ll_row, "discperc", ld_discperc5)
					end choose
				end if
			else
				this.id_detail.setitem(ll_row, "discperc", 0)
			end if
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				this.id_detail.setitem(ll_row, "packprice", ld_saleprice)
				this.id_detail.setitem(ll_row, "saleprice", ld_saleprice / ll_packunits)
			case 2.0
				this.id_detail.setitem(ll_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(ll_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				this.id_detail.setitem(ll_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(ll_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				this.id_detail.setitem(ll_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(ll_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				this.id_detail.setitem(ll_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(ll_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				this.id_detail.setitem(ll_row, "packprice", ld_purprice)
				this.id_detail.setitem(ll_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				this.id_detail.setitem(ll_row, "packprice", ld_rpp)
				this.id_detail.setitem(ll_row, "saleprice", ld_rpp / ll_packunits)
			case else
				this.id_detail.setitem(ll_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(ll_row, "saleprice", ld_avgprice)
			end choose
			this.id_detail.setitem(ll_row, "rate", ld_saleprice / ll_packunits)
			this.id_detail.setitem(ll_row, "retailprice", ld_retailprice / ll_packunits)
			if li_flatdiscstatus = 1 then
				this.id_detail.setitem(ll_row, "itemflatdisc", ld_flatdisc)
			else
				this.id_detail.setitem(ll_row, "itemflatdisc", 0)
			end if
			this.id_detail.setitem(ll_row, "unitsalestax", ld_unitsalestax)
			if li_defaultgst = 2 then
				this.id_detail.setitem(ll_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(ll_row, "gstperc", ld_gstperc1)
			end if
			this.id_detail.setitem(ll_row, "saleitemdescription", ls_itemname)
		else
			messagebox("Item Validation", "Unable to get item information.")
		end if
	end if
	return 0

// w_salesorder.wf_setsaletype(integer ai_saletype) returns 0
	this.ii_saletype = ai_saletype

// w_salesorder.wf_setsuppinfo(long al_suppcode, datawindow ad_master) returns 0
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	SQL SELECT supplier.address1 , supplier.city , supplier.phone INTO :ls_address, :ls_city, :ls_phone FROM supplier WHERE supplier.suppcode =:al_suppcode USING this.it_transobject;
	ll_currow = ad_master.getrow()
	ad_master.object.supplier_address[ll_currow] = ls_address
	ad_master.object.supplier_city[ll_currow] = ls_city
	ad_master.object.supplier_phone[ll_currow] = ls_phone

// w_salesorder.wf_updatesaleprice(long al_icode, double ad_saleprice) returns integer
	SQL update Item SET saleprice =:ad_saleprice WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_salesorder.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	long ll_icode
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean lb_rtflag
	boolean ib_due
	integer li_null
	string ls_null
	ls_titleerrtext = "Item Validation"
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), al_currrow) = true then
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
	elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			li_option = messagebox("Item Validation", "Item stock does not exist~n~rDo You want to due this item", information!, yesno!, 2)
			if li_option = 1 then
				this.id_detail.setitem(this.il_currrow, "looseqty", 1)
				this.id_detail.setitem(this.il_currrow, "dueqty", 1)
				ib_due = true
			else
				li_errcode = -1
			end if
		end if
	else
		li_errcode = -1
		ls_titleerrtext = "Item Validation"
	end if
	if li_errcode = -1 and not ib_due then
		lb_rtflag = false
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setitem(al_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(al_currrow, "icode", li_null)
		this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	end if
	return lb_rtflag

// w_salesorder.wf_validateitem(boolean ab_flag) returns integer
	long ll_icode
	long ll_count
	long ll_duprow
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	integer n
	boolean ib_due
	boolean lb_dupitem
	boolean lb_zerostock
	boolean lb_invalidrow
	integer li_null
	string ls_null
	if isnull(this.il_currrow) or this.il_currrow <= 0 then
		lb_invalidrow = true
		setnull(ll_icode)
	else
		ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	end if
	if not isnull(ll_icode) then
		if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true and f_stringpreferences("AllowDuplicateItemInSO") = "N" then
			ls_titleerrtext = "Item Validation"
			ls_errtext = "Duplicate item, please select some other item"
			lb_dupitem = true
			li_errcode = -1
		elseif not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
			ls_titleerrtext = "Item Validation"
		end if
	end if
	if ab_flag then
		this.ib_godownvalidated = true
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		if lb_invalidrow = true then
			li_errcode = -1
		elseif lb_dupitem = true then
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.icode[this.il_currrow] = li_null
			this.id_detail.object.fullcode[this.il_currrow] = ls_null
			this.id_detail.object.itemname[this.il_currrow] = ls_null
			post event ue_deleteitem_row(this.il_currrow)
			for ll_count = 1 to this.id_detail.rowcount()
				if this.id_detail.getitemnumber(ll_count, "icode") = ll_icode then
					post event ue_scrolltorow(ll_count, "looseqty")
					exit
				end if
			next
			messagebox("Item", "Duplicate Item, please select some other item")
		else
			ls_titleerrtext = "Item Validation"
			messagebox(ls_titleerrtext, ls_errtext)
			if f_stringpreferences("itemcode") = "N" then
				this.id_detail.setcolumn(this.is_columnitemname)
				this.ib_itemslistopen = true
				this.id_itemslist.show()
			else
				this.id_detail.setcolumn("fullcode")
				this.id_detail.object.fullcode[this.il_currrow] = ls_null
			end if
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.icode[this.il_currrow] = li_null
			this.id_detail.object.itemname[this.il_currrow] = ls_null
			this.id_detail.object.looseqty[this.il_currrow] = 1
			this.id_detail.object.bonusqty[this.il_currrow] = 0
			this.id_detail.object.saleprice[this.il_currrow] = li_null
			if long(this.id_detail.object.discperc.visible) = 1 then
				this.id_detail.object.discperc[this.il_currrow] = li_null
			else
				this.id_detail.object.discperc[this.il_currrow] = 0
			end if
			if long(this.id_detail.object.itemflatdisc.visible) = 1 then
				this.id_detail.object.itemflatdisc[this.il_currrow] = li_null
			else
				this.id_detail.object.itemflatdisc[this.il_currrow] = 0
			end if
			this.id_detail.object.unitsalestax[this.il_currrow] = li_null
			this.id_detail.object.gstperc[this.il_currrow] = li_null
		end if
	end if
	return li_errcode

// w_salesorder.wf_validateitemnew() returns integer
	long ll_icode
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
		messagebox(ls_titleerrtext, ls_errtext)
	elseif not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		ls_titleerrtext = "Item Validation"
		li_errcode = -2
	end if
	this.ib_itemvalidated = true
	return li_errcode

// w_salesorder.wf_visible(boolean ab_flag) returns 0

// w_salesorder.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_discountvalue
	double ld_invtaxperc1val
	double ld_intaxperc1
	double ld_advincometax
	double ld_totaltax
	double ld_totalitemleveltax
	real lr_discperc
	real lr_flatdisc
	real lr_misccharges
	real lr_salestax
	real lr_itemstotal
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		lr_discperc = this.id_footer.object.invdiscperc[1]
		lr_flatdisc = this.id_footer.object.flatdisc[1]
		lr_misccharges = this.id_footer.object.misccharges[1]
		lr_salestax = 0
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
		ld_intaxperc1 = this.id_footer.object.invgstperc1[1]
		ld_advincometax = this.id_detail.getitemnumber(1, "c_totadvancetax")
		ld_totalitemleveltax = this.id_detail.getitemnumber(1, "c_sumtaxval") + this.id_detail.getitemnumber(1, "c_sumgstval")
		this.id_footer.object.t_discountvalue.text = string(ld_detaildwtotal * lr_discperc * 0.01, "########0.00")
		ld_discountvalue = ld_detaildwtotal * lr_discperc * 0.01
		if this.ic_advancetaxonsale = "Y" then
			this.id_footer.object.misccharges[1] = ld_advincometax + this.id_footer.object.misccharges1[1] + this.id_footer.object.misccharges2[1] + this.id_footer.object.misccharges3[1] + this.id_footer.object.misccharges4[1] + this.id_footer.object.misccharges5[1]
			this.id_footer.object.advancetaxamt[1] = ld_advincometax
		else
			lr_misccharges = this.id_footer.object.misccharges[1]
			this.id_footer.object.advancetaxamt[1] = 0.00
		end if
		if this.ic_fbrposfee = "Y" then
			this.id_footer.object.misccharges[1] = this.id_footer.object.advancetaxamt[1] + this.id_footer.object.misccharges1[1] + this.id_footer.object.misccharges2[1] + this.id_footer.object.misccharges3[1] + this.id_footer.object.misccharges4[1] + this.id_footer.object.misccharges5[1] + this.id_master.object.fbrposfee[1]
		else
			lr_misccharges = this.id_footer.object.misccharges[1]
		end if
		lr_misccharges = this.id_footer.object.misccharges[1]
		ld_grandtotal = ld_detaildwtotal - ld_discountvalue - lr_flatdisc + lr_misccharges + lr_salestax
		ld_invtaxperc1val = round((ld_detaildwtotal - ld_discountvalue - lr_flatdisc) * ld_intaxperc1 * 0.01, 2)
		ld_totaltax = round(ld_invtaxperc1val + ld_totalitemleveltax, 0)
		ld_grandtotal = round(ld_grandtotal, 0) + ld_totaltax
		this.id_footer.setitem(1, "total", ld_grandtotal)
	end if
	return ld_grandtotal

// w_salesorder.wf_populate_ddlb(datawindow dwcontrol) returns 0
	integer li_column_count
	integer li_counter
	string ls_column_name
	string ls_columntype
	this.tab_retrieve.tabpage_list.ddlb_filter_column.reset()
	this.tab_retrieve.tabpage_list.ddlb_sort.reset()
	li_column_count = integer(dwcontrol.object.datawindow.column.count)
	for li_counter = li_column_count to li_counter step -1
		ls_column_name = dwcontrol.describe("#" + string(li_counter) + ".Name")
		this.tab_retrieve.tabpage_list.ddlb_sort.additem(ls_column_name)
		this.tab_retrieve.tabpage_list.ddlb_filter_column.additem(ls_column_name)
	next
	this.tab_retrieve.tabpage_list.ddlb_sort.text = ls_column_name
	ls_columntype = this.id_dwcontrol.describe("#1.ColType")
	if left(ls_columntype, 4) = "char" then
		this.ii_type = 1
	elseif left(ls_columntype, 4) = "date" then
		this.ii_type = 3
	else
		this.ii_type = 2
	end if
	this.ii_colindex = 1
	this.tab_retrieve.tabpage_list.rb_descending.checked = true
	wf_sortdw(this.tab_retrieve.tabpage_list.ddlb_sort.text, this.is_sortsequence)
	if this.ii_saletype = 3 then
		this.id_detail.setfocus()
		return
	end if
	this.id_master.setfocus()

// w_salesorder.wf_viewheader() returns integer
	s_dw_header ls_dw_header
	string[] ls_values
	string ls_posted
	long ll_row
	long ll_currrow
	integer li_protectdw
	datetime ldt_datetime
	if this.tab_retrieve.selectedtab <> 1 then
		return -1
	end if
	ls_posted = this.id_master.getitemstring(this.id_master.getrow(), "Posted")
	ls_dw_header.dw_header = this.id_master
	ls_dw_header.s_saletype = "Credit"
	ls_dw_header.l_code2 = this.ii_module
	if this.editflag = false and ls_posted = "Y" then
		ls_dw_header.i_protectdw = 1
	else
		ls_dw_header.i_protectdw = 0
	end if
	openwithparm(w_view_saleorderheader, ls_dw_header)
	ls_dw_header = message.powerobjectparm
	if ls_dw_header.i_closemode = -1 then
		return -1
	end if
	ll_row = this.id_master.getrow()
	ls_values = ls_dw_header.values
	if this.editflag = true then
		this.id_master.setitem(ll_row, "patientregno", ls_values[1])
		this.id_master.setitem(ll_row, "patientcode", long(ls_values[2]))
		this.id_master.setitem(ll_row, "doctcode", long(ls_values[3]))
		this.id_master.setitem(ll_row, "relationcode", long(ls_values[4]))
		this.id_master.setitem(ll_row, "wardcode", long(ls_values[5]))
		this.id_master.setitem(ll_row, "diseasecode", long(ls_values[6]))
		this.id_master.setitem(ll_row, "invoicesize", ls_values[7])
		this.id_master.setitem(ll_row, "smancode", long(ls_values[8]))
		if this.ii_saletype = 2 then
			this.id_master.setitem(ll_row, "custrefno2", ls_values[9])
			this.id_master.setitem(ll_row, "custrefno3", ls_values[10])
			this.id_master.setitem(ll_row, "custrefno4", ls_values[11])
		end if
		this.id_master.setitem(ll_row, "deliveredby", long(ls_values[12]))
		this.id_master.setitem(ll_row, "billingdate", datetime(date(ls_values[13]), time(ls_values[14])))
		this.id_master.setitem(ll_row, "pptcustcode", long(ls_values[15]))
		this.id_master.setitem(ll_row, "custsitecode", long(ls_values[16]))
	end if
	return 1

// w_salesorder.wf_selectprintreport(string as_invoicesize) returns string
	string ls_pagesize
	string ls_report
	long ll_currrow
	boolean lb_listtab
	ls_pagesize = as_invoicesize
	if ls_pagesize = "Q" and this.ib_printout then
		if gs_company = "ALNASEEB" then
			ls_report = "d_alnaseeb_saleorderprint_quarter"
		else
			ls_report = "d_saleorderprint_quarter"
		end if
	elseif ls_pagesize = "Q" and this.ib_printout = false then
		if gs_company = "ALNASEEB" then
			ls_report = "d_alnaseeb_saleorderprint_quarter"
		elseif gs_company = "SHAHZADPLYWOOD" or gs_company = "RSHOP" or gs_company = "KUKHI" then
			ls_report = "d_shahzadplywood_saleorderprint_quarter"
		elseif gs_company = "BOMBAYCHOCNNUTS" then
			ls_report = "d_bombaychocnnuts_saleorderprint"
		else
			ls_report = "d_saleorderprint_quarter"
		end if
	elseif ls_pagesize = "F" and this.ib_printout then
		if gs_company = "CLINIXMS" or gs_company = "CLINIXSMARKET" or gs_company = "C1WAREHOUSE" then
			ls_report = "d_clinixms_saleorderprint_full"
		elseif gs_company = "MEDICAMP" then
			ls_report = "d_medicamp_saleorderprint"
		elseif gs_company = "AIJAZANDSONS" then
			ls_report = "d_aijazandsons_saleorderprint_full"
		elseif gs_company = "TAJMEDICOSWH" then
			ls_report = "d_tajmedicosewh_saleorderprint_full"
		elseif gs_company = "REFRAPRODUCTS" then
			ls_report = "d_refraproducts_saleorderprint_full"
		elseif gs_company = "MSHARIFCOMPANY" then
			ls_report = "d_msharifcompany_saleorderprint_full"
		elseif gs_company = "DFOODSISB" then
			ls_report = "d_dfoodsisb_saleorderprint_full"
		elseif gs_company = "NPR" or gs_company = "KOHINOORMLTN" or gs_company = "KKM" or gs_company = "KBBS" or gs_company = "KLM" then
			ls_report = "d_npr_saleorderprint_full"
		else
			ls_report = "d_saleorderprint_full"
		end if
	elseif ls_pagesize = "F" and this.ib_printout = false then
		if gs_company = "CLINIXMS" or gs_company = "CLINIXSMARKET" or gs_company = "C1WAREHOUSE" then
			ls_report = "d_clinixms_saleorderprint_full"
		elseif gs_company = "MEDICAMP" then
			ls_report = "d_medicamp_saleorderprint"
		elseif gs_company = "AIJAZANDSONS" then
			ls_report = "d_aijazandsons_saleorderprint_full"
		elseif gs_company = "TAJMEDICOSWH" then
			ls_report = "d_tajmedicosewh_saleorderprint_full"
		elseif gs_company = "REFRAPRODUCTS" then
			ls_report = "d_refraproducts_saleorderprint_full"
		elseif gs_company = "MSHARIFCOMPANY" then
			ls_report = "d_msharifcompany_saleorderprint_full"
		elseif gs_company = "DFOODSISB" then
			ls_report = "d_dfoodsisb_saleorderprint_full"
		elseif gs_company = "NPR" or gs_company = "KOHINOORMLTN" or gs_company = "KKM" or gs_company = "KBBS" or gs_company = "KLM" then
			ls_report = "d_npr_saleorderprint_full"
		else
			ls_report = "d_saleorderprint_full"
		end if
	elseif ls_pagesize = "H" and this.ib_printout then
		ls_report = "d_saleorderprint_half"
	elseif ls_pagesize = "H" and this.ib_printout = false then
		if gs_company = "CHIFFON" then
			ls_report = "d_chiffon_saleorderprint_half"
		else
			ls_report = "d_saleorderprint_half"
		end if
	else
		ls_report = "d_saleorderprint_quarter"
	end if
	if left(gs_company, 12) = "MASOODHOMOEO" then
		if this.ii_socatcode = 1 then
			ls_report = "d_masoodhomoeo_saleorderprint_full"
		else
			ls_report = "d_masoodhomoeo_saleorderprint_full2"
		end if
	elseif gs_company = "ALHARMAINLIGHTS" then
		ls_report = "d_alharmainlights_saleorderprint"
	elseif gs_company = "BBIKHI" then
		ls_report = "d_bbikhi_saleorderprint_full"
	elseif gs_company = "AHMEDGLASS" then
		ls_report = "d_ahmedglass_saleorderprint"
	elseif gs_company = "LEADERAUTOS" then
		ls_report = "d_leaderautos_saleorderinvreport"
	elseif gs_company = "DAWNAUTOS" or gs_company = "LALAGAUTOS" then
		ls_report = "d_dawnautos_saleorderprint_quarter"
	elseif gs_company = "BIOLIFE" then
		ls_report = "d_biolife_saleorderprint_full"
	end if
	this.id_print.dataobject = ls_report
	this.id_print.settransobject(this.it_transobject)
	this.ib_printout = true
	return ls_report

// w_salesorder.wf_setamountoninvoice() returns 0
	long ll_null
	long ll_rightfound
	double ld_netamt
	double ld_null
	string ls_null
	s_amountoninvoice lstr_amountoninvoice
	setnull(ld_null)
	setnull(ls_null)
	setnull(ll_null)
	if this.ii_saletype <> 3 then
		ld_netamt = wf_grandtotal()
		if f_stringpreferences("AskAmtOnCreditSale") = "Y" then
			ll_rightfound = 0
			ll_rightfound = gds_securitywindow.find("rightcode = 582", 1, gds_securitywindow.rowcount())
			lstr_amountoninvoice.l_invcode = this.id_master.getitemnumber(1, "code")
			lstr_amountoninvoice.d_netamt = ld_netamt
			lstr_amountoninvoice.d_amt = this.id_master.getitemdecimal(1, "amt")
			if isnull(lstr_amountoninvoice.d_amt) then
				lstr_amountoninvoice.d_balance = ld_netamt
			else
				lstr_amountoninvoice.d_balance = ld_netamt - lstr_amountoninvoice.d_amt
			end if
			if isnull(this.id_master.getitemstring(1, "paymentmode")) then
				this.id_master.setitem(1, "paymentmode", f_stringpreferences("SalePaymentMode"))
				this.id_master.setitem(1, "paymentacccode", f_numberpreferences("SalePaymentAcccode"))
			end if
			lstr_amountoninvoice.c_paymentmode = this.id_master.getitemstring(1, "paymentmode")
			lstr_amountoninvoice.i_acccode = this.id_master.getitemnumber(1, "paymentacccode")
			lstr_amountoninvoice.s_reference = this.id_master.getitemstring(1, "amtreference")
			lstr_amountoninvoice.s_module = "salesorder"
			if ll_rightfound > 0 then
				openwithparm(w_amountoninvoice, lstr_amountoninvoice)
				lstr_amountoninvoice = message.powerobjectparm
				this.id_master.setitem(1, "amt", lstr_amountoninvoice.d_amt)
				this.id_master.setitem(1, "paymentmode", lstr_amountoninvoice.c_paymentmode)
				this.id_master.setitem(1, "paymentacccode", lstr_amountoninvoice.i_acccode)
				this.id_master.setitem(1, "amtreference", lstr_amountoninvoice.s_reference)
			end if
		else
			this.id_master.setitem(1, "paymentmode", ls_null)
			this.id_master.setitem(1, "paymentacccode", ll_null)
			this.id_master.setitem(1, "amtreference", ls_null)
			this.id_master.setitem(1, "amt", 0)
		end if
		return
	end if
	this.id_master.setitem(1, "amt", 0)
	this.id_master.setitem(1, "paymentmode", ls_null)
	this.id_master.setitem(1, "paymentacccode", ll_null)
	this.id_master.setitem(1, "amtreference", ls_null)

// w_salesorder.wf_populatesaledetail(long al_invid, datawindow ad_saledetail, string as_errortext, long al_errorrow) returns boolean
	long ll_detailrows
	long ll_icode
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode
	long li_counter
	long li_innercounter
	long ll_itemsdetailrowcount
	long ll_remainingdays
	long ll_rowgroup
	long ll_row
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	double ld_avgprice
	double ld_itemadvancetaxperc
	char lc_taxable
	integer li_rtmesscode
	boolean lb_commitflag
	string ls_updatesaleprice
	string ls_updsaleprice
	datetime ld_expiry
	dwitemstatus ldws_column
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	ll_itemsdetailrowcount = 0
	ls_updatesaleprice = f_stringpreferences("updatesaleprice")
	as_errortext = "    Some database problem ocuurs         "
	ll_rowgroup = 0
	do while li_counter <= ll_detailrows and lb_commitflag
		ll_rowgroup = ll_rowgroup + 1
		ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
		ldws_column = this.id_detail.getitemstatus(li_counter, "saleprice", primary!)
		ls_updsaleprice = this.id_detail.getitemstring(li_counter, "updatesaleprice")
		this.it_transobject.getitemavgpriceforsale(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			ll_row = ad_saledetail.insertrow(0)
			ad_saledetail.setitem(ll_row, "code", al_invid)
			ad_saledetail.setitem(ll_row, "icode", this.id_detail.getitemnumber(li_counter, "icode"))
			ad_saledetail.setitem(ll_row, "gcode", this.id_detail.getitemnumber(li_counter, "gcode"))
			ad_saledetail.setitem(ll_row, "batch", this.id_detail.getitemstring(li_counter, "batch"))
			ad_saledetail.setitem(ll_row, "manfdate", this.id_detail.getitemdatetime(li_counter, "manfdate"))
			ad_saledetail.setitem(ll_row, "expiry", this.id_detail.getitemdatetime(li_counter, "expiry"))
			ad_saledetail.setitem(ll_row, "strengthperc", this.id_detail.getitemnumber(li_counter, "strengthperc"))
			ad_saledetail.setitem(ll_row, "looseqty", this.id_detail.getitemnumber(li_counter, "looseqty"))
			ad_saledetail.setitem(ll_row, "bonusqty", this.id_detail.getitemnumber(li_counter, "bonusqty"))
			ad_saledetail.setitem(ll_row, "packqtyforsale", this.id_detail.getitemnumber(li_counter, "packqtyforsale"))
			ad_saledetail.setitem(ll_row, "bonuspackqtyforsale", this.id_detail.getitemnumber(li_counter, "bonuspackqtyforsale"))
			ad_saledetail.setitem(ll_row, "packunits", this.id_detail.getitemnumber(li_counter, "packunits"))
			ad_saledetail.setitem(ll_row, "saleprice", this.id_detail.getitemnumber(li_counter, "saleprice"))
			ad_saledetail.setitem(ll_row, "packprice", this.id_detail.getitemnumber(li_counter, "packprice"))
			ad_saledetail.setitem(ll_row, "rate", this.id_detail.getitemnumber(li_counter, "rate"))
			ad_saledetail.setitem(ll_row, "avgprice", ld_avgprice)
			ad_saledetail.setitem(ll_row, "claimable", this.id_detail.getitemstring(li_counter, "claimable"))
			ad_saledetail.setitem(ll_row, "claimablediscperc", this.id_detail.getitemnumber(li_counter, "claimablediscperc"))
			ad_saledetail.setitem(ll_row, "discperc", this.id_detail.getitemnumber(li_counter, "discperc"))
			ad_saledetail.setitem(ll_row, "itemflatdisc", this.id_detail.getitemnumber(li_counter, "itemflatdisc"))
			ad_saledetail.setitem(ll_row, "unitsalestax", this.id_detail.getitemnumber(li_counter, "unitsalestax"))
			ad_saledetail.setitem(ll_row, "gstperc", this.id_detail.getitemnumber(li_counter, "gstperc"))
			ad_saledetail.setitem(ll_row, "saleitemdescription", this.id_detail.getitemstring(li_counter, "saleitemdescription"))
			ad_saledetail.setitem(ll_row, "sizedescription", this.id_detail.getitemstring(li_counter, "sizedescription"))
			ad_saledetail.setitem(ll_row, "rowgroup", ll_rowgroup)
			ad_saledetail.setitem(ll_row, "quotationrowid", this.id_detail.getitemnumber(li_counter, "quotationrowid"))
			ad_saledetail.setitem(ll_row, "prescriptionrowid", this.id_detail.getitemnumber(li_counter, "prescriptionrowid"))
			ad_saledetail.setitem(ll_row, "saleorderitemstatuscode", this.id_detail.getitemnumber(li_counter, "saleorderitemstatuscode"))
			ad_saledetail.setitem(ll_row, "remarks", this.id_detail.getitemstring(li_counter, "remarks"))
			ad_saledetail.setitem(ll_row, "taxable", this.id_detail.getitemstring(li_counter, "taxable"))
			ad_saledetail.setitem(ll_row, "ItemAdvanceTaxPerc", this.id_detail.getitemnumber(li_counter, "ItemAdvanceTaxPerc"))
		else
			lb_commitflag = false
		end if
		li_counter = li_counter + 1
	loop
	if not lb_commitflag then
		al_errorrow = li_counter - 1
		messagebox("Database Error", as_errortext)
	end if
	return lb_commitflag

// w_salesorder.wf_locksaleorder(long al_saleordercode) returns integer
	integer li_count
	this.it_transobject.dbparm = " Async =1, DBGetTime = 20"
	this.it_transobject.locksaleorderheader(al_saleordercode)
	this.it_transobject.dbparm = "Async =0, DBGetTime = 0"
	return this.it_transobject.sqlcode

// w_salesorder.wf_locksaleorders(long al_sinvcode, long al_linvcode, long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From saleorderheader WITH ( UPDLOCK HOLDLOCK ) Where saleorderheader.socatcode =:this.ii_socatcode AND saleorderheader.saleordercode Between :al_sinvcode AND :al_linvcode AND saleorderheader.Posted ='N' AND saleorderheader.Deleted ='N' USING sqlca;
	return sqlca.sqlcode

// w_salesorder.wf_post() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	s_arguements lstr_arginfo
	string ls_askuserpwd
	ls_askuserpwd = "AskUserPwdInSaleOrder"
	if f_stringpreferences(ls_askuserpwd) = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	setfocus()
	if ll_salesmancode > 0 then
		openwithparm(w_arg_cust_sinvcode_linvcode, this.ii_saletype)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			li_errcode = wf_locksaleorders(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_saleinvcount)
			if li_errcode = 0 then
				sqlca.postsaleorder(this.ii_socatcode, lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode, lstr_arginfo.l_code3, lstr_arginfo.l_code4)
				if sqlca.sqlcode <> 0 then
					li_errcode = -1
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again")
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_saleinvcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return li_errcode

// w_salesorder.wf_search_customer() returns 0
	long ll_code
	long ll_oldcode
	s_popup_selection lstr_selection
	if wf_iseditable() = false then
		return
	end if
	if this.ii_saletype = 3 then
		return
	end if
	ll_oldcode = this.id_master.getitemnumber(1, "custcode")
	this.id_master.setcolumn("custcode")
	this.id_master.setfocus()
	openwithparm(w_popup_partialsearch_selection, "d_customer_list")
	lstr_selection = message.powerobjectparm
	if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
		this.id_master.setitem(1, "custcode", lstr_selection.l_code2)
		if wf_setcustomerinfo(1, 1, string(lstr_selection.l_code2)) <> 0 then
			this.id_master.setitem(1, "custcode", ll_oldcode)
		end if
	end if

// w_salesorder.wf_inititeminfo(long al_icode, long al_row, integer ai_rtcode, string as_errortext) returns boolean
	boolean retflag
	double ld_rpp
	double ld_purprice
	double ld_flatdisc
	double ld_invdiscperc
	double ld_discperc2
	double ld_discperc3
	double ld_discperc4
	double ld_saleprice
	double ld_discperc
	double ld_purdiscperc
	double ld_avgprice
	double ld_unitsalestax
	double ld_gstperc1
	double ld_gstperc2
	double ld_packsalestax
	double ld_saleprice2
	double ld_saleprice3
	double ld_saleprice4
	double ld_saleprice5
	double ld_discperc5
	double ld_retailprice
	double ld_custitemcatdiscperc
	double ld_itemflatdisc
	double ld_claimablediscperc
	double ld_taxperc
	long ll_packunits
	long ll_saleinvcode
	long ll_reorderqty
	long li_discstatus
	long ll_qtysale
	long ll_bonus
	long ll_itemdesc_status
	long ll_null
	integer li_gcode
	integer li_defaultgcode
	integer li_defaultgst
	integer ll_custcode
	integer li_flatdiscstatus
	integer li_itemdiscpercno
	integer li_icatcode
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_antinorcotix
	string ls_itemtotalval
	string ls_locksaleprice
	string ls_lockdiscperc
	string ls_remarks
	string ls_packingdesc
	string ls_sizedescription
	double ld_godownstock
	double ld_saleqty
	double ld_totalstock
	double ld_holdlooseqty
	double ld_desiredbonus
	double ld_unitweight
	double ld_packingfactor
	char lc_taxable
	setnull(ll_null)
	setnull(ls_null)
	SQL SELECT item.customicode , item.name , item.saleprice , item.packunits , item.salediscperc , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.avgprice , item.PurDiscPerc , item.antinorcotix , item.reorderqty , item.purprice , item.recentpurprice , round ( item.Packsalestax / item.packunits , 2 ) , item.gstperc1 , item.gstperc2 , qtysale =item.saleqty , bonus =item.bonusqty , item.Packsalestax , item.flatdisc , item.locksaleprice , item.lockdiscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 , item.remarks , item.retailprice , item.icatcode , item.packingdesc , item.unitweight , item.packingfactor , Item.SizeDescription , item.claimablediscperc , item.taxable INTO :ls_fullcode, :ls_name, :ld_saleprice, :ll_packunits, :ld_discperc, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :ld_avgprice, :ld_purdiscperc, :ls_antinorcotix, :ll_reorderqty, :ld_purprice, :ld_rpp, :ld_unitsalestax, :ld_gstperc1, :ld_gstperc2, :ll_qtysale, :ll_bonus, :ld_packsalestax, :ld_flatdisc, :ls_locksaleprice, :ls_lockdiscperc, :ld_discperc2, :ld_discperc3, :ld_discperc4, :ld_discperc5, :ls_remarks, :ld_retailprice, :li_icatcode, :ls_packingdesc, :ld_unitweight, :ld_packingfactor, :ls_sizedescription, :ld_claimablediscperc, :lc_taxable FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	if isnull(ll_custcode) then
		retflag = false
		as_errortext = "Validation Error: Select Customer "
	end if
	li_defaultgst = this.id_master.getitemnumber(1, "dd_gstperc")
	SQL SELECT InvDiscPerc , TaxPerc =( SELECT TC.TaxPerc FROM TaxCategory TC WHERE TC.TaxCategoryCode =Customer.TaxCategoryCode ) INTO :ld_invdiscperc, :ld_taxperc FROM customer WHERE customer.custcode =:ll_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
	else
		if this.il_strategy = 2 then
			li_gcode = wf_getitemassociategcode(al_icode)
		end if
		if this.il_strategy = 1 then
			li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
		end if
	end if
	this.it_transobject.getitemstockall(al_icode, ld_totalstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if retflag then
		this.id_detail.setitem(al_row, "gcode", li_gcode)
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		this.id_detail.setitem(al_row, "taxable", lc_taxable)
		if ld_claimablediscperc > 0.0 then
			this.id_detail.setitem(al_row, "claimable", "Y")
		end if
		if this.ic_advancetaxonsale = "Y" and lc_taxable = "Y" then
			this.id_detail.object.itemadvancetaxperc[al_row] = ld_taxperc
		else
			this.id_detail.object.itemadvancetaxperc[al_row] = 0.00
		end if
		li_discstatus = long(this.id_detail.object.discperc.visible)
		ll_itemdesc_status = long(this.id_detail.object.saleitemdescription.visible)
		li_flatdiscstatus = long(this.id_detail.object.itemflatdisc.visible)
		if li_discstatus = 1 and this.id_detail.getitemstatus(al_row, "discperc", primary!) = notmodified! then
			li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
			if wf_getcustitemcatwisesalesdiscount(al_icode, ll_custcode, ld_custitemcatdiscperc, ld_itemflatdisc) = true then
				this.id_detail.setitem(al_row, "discperc", ld_custitemcatdiscperc)
				this.id_detail.setitem(al_row, "itemflatdisc", ld_itemflatdisc)
			elseif long(this.id_detail.object.discperc.visible) = 1 then
				choose case li_itemdiscpercno
				case 1
					this.id_detail.setitem(al_row, "discperc", ld_discperc)
				case 2
					this.id_detail.setitem(al_row, "discperc", ld_discperc2)
				case 3
					this.id_detail.setitem(al_row, "discperc", ld_discperc3)
				case 4
					this.id_detail.setitem(al_row, "discperc", ld_discperc4)
				case 5
					this.id_detail.setitem(al_row, "discperc", ld_discperc5)
				end choose
			else
				this.id_detail.setitem(al_row, "discperc", 0)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") and li_discstatus = 1 then
			li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
			if wf_getcustitemcatwisesalesdiscount(al_icode, ll_custcode, ld_custitemcatdiscperc, ld_itemflatdisc) = true then
				this.id_detail.setitem(al_row, "discperc", ld_custitemcatdiscperc)
				this.id_detail.setitem(al_row, "itemflatdisc", ld_itemflatdisc)
			else
				choose case li_itemdiscpercno
				case 1
					this.id_detail.setitem(al_row, "discperc", ld_discperc)
				case 2
					this.id_detail.setitem(al_row, "discperc", ld_discperc2)
				case 3
					this.id_detail.setitem(al_row, "discperc", ld_discperc3)
				case 4
					this.id_detail.setitem(al_row, "discperc", ld_discperc4)
				case 5
					this.id_detail.setitem(al_row, "discperc", ld_discperc5)
				end choose
			end if
		end if
		if this.id_detail.getitemstatus(al_row, "saleprice", primary!) = notmodified! then
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
			case 2.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				this.id_detail.setitem(al_row, "packprice", ld_purprice)
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				this.id_detail.setitem(al_row, "packprice", ld_rpp)
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
			case else
				this.id_detail.setitem(al_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
			end choose
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
			case 2.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				this.id_detail.setitem(al_row, "packprice", ld_purprice)
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				this.id_detail.setitem(al_row, "packprice", ld_rpp)
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
			case else
				this.id_detail.setitem(al_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
			end choose
		end if
		this.id_detail.setitem(al_row, "icode", al_icode)
		this.id_detail.setitem(al_row, "packunits", ll_packunits)
		this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
		this.id_detail.setitem(al_row, "stock", ld_godownstock)
		this.id_detail.setitem(al_row, "packingdesc", ls_packingdesc)
		this.id_detail.setitem(al_row, "totalstock", ld_totalstock)
		this.id_detail.setitem(al_row, "retailprice", ld_retailprice / ll_packunits)
		this.id_detail.setitem(al_row, "unitweight", ld_unitweight)
		this.id_detail.setitem(al_row, "packingfactor", ld_packingfactor)
		this.id_detail.setitem(al_row, "sizedescription", ls_sizedescription)
		if li_flatdiscstatus = 1 then
			if this.id_detail.getitemstatus(al_row, "itemflatdisc", primary!) = notmodified! then
				this.id_detail.setitem(al_row, "itemflatdisc", ld_flatdisc)
			end if
		else
			this.id_detail.setitem(al_row, "itemflatdisc", 0)
		end if
		if f_stringpreferences("SaleCopyItemRemarks") = "Y" and this.id_detail.getitemstatus(al_row, "saleitemdescription", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "saleitemdescription", ls_remarks)
		end if
		this.id_detail.setitem(al_row, "recentpurprice", ld_rpp)
		this.id_detail.setitem(al_row, "purprice", ld_purprice)
		this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
		this.id_detail.setitem(al_row, "itemtotalval", ls_itemtotalval)
		this.id_detail.setitem(al_row, "quotationrowid", ll_null)
		if f_stringpreferences("bonusinsale") = "Y" then
			this.id_detail.setitem(al_row, "qtysale", ll_qtysale)
			this.id_detail.setitem(al_row, "bonus", ll_bonus)
		end if
		if this.id_detail.getitemstatus(al_row, "Unitsalestax", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
		end if
		if this.id_detail.getitemstatus(al_row, "gstperc", primary!) = notmodified! then
			if li_defaultgst = 2 then
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
			if li_defaultgst = 2 then
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
			end if
			if f_stringpreferences("SaleCopyItemRemarks") = "Y" then
				this.id_detail.setitem(al_row, "saleitemdescription", ls_remarks)
			end if
			this.id_detail.setitem(al_row, "claimablediscperc", ld_claimablediscperc)
		end if
		this.id_detail.setitem(al_row, "locksaleprice", ls_locksaleprice)
		this.id_detail.setitem(al_row, "lockdiscperc", ls_lockdiscperc)
		if ld_godownstock = 0.0 then
		end if
	else
		retflag = false
		as_errortext = "Item can not be sold"
	end if
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_totalstock)
	this.id_footer.setitem(1, "retailprice", ld_retailprice / ll_packunits)
	this.id_footer.setitem(1, "rpp", ld_rpp)
	this.id_footer.setitem(1, "purprice", ld_purprice)
	this.id_footer.setitem(1, "avgprice", ld_avgprice)
	this.id_footer.setitem(1, "itemtotalval", ls_itemtotalval)
	if this.id_footer.getitemstatus(1, "invdiscperc", primary!) = notmodified! and this.ib_modify = false then
		this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
	end if
	if f_stringpreferences("bonusinsale") = "Y" then
		this.id_footer.setitem(1, "bonusratio", trim(string(ll_qtysale)) + ":" + trim(string(ll_bonus)))
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			ld_holdlooseqty = this.id_detail.getitemnumber(al_row, "looseqty")
			if this.id_detail.getitemnumber(al_row, "qtysale") = 0.0 then
				ld_desiredbonus = 0
			else
				ld_desiredbonus = ld_holdlooseqty / double(this.id_detail.getitemnumber(al_row, "qtysale")) * double(this.id_detail.getitemnumber(al_row, "Bonus"))
			end if
			this.id_detail.setitem(al_row, "bonusqty", ld_desiredbonus)
		end if
	end if
	if al_icode > 0 and (al_icode <> this.id_detail.object.itemcode[al_row] or isnull(this.id_detail.object.itemcode[al_row])) then
		wf_setcustomerlatestnetrate(ll_custcode, al_icode, al_row)
		wf_setcustomerlatestsaleprice(ll_custcode, al_icode, al_row)
		if f_stringpreferences("AutoShowPrevInvInfo") = "Y" then
			wf_preinvinfo()
		end if
	end if
	this.id_footer.object.t_purdiscper.text = string(ld_purdiscperc)
	this.id_detail.setitem(al_row, "itemcode", al_icode)
	return retflag

// w_salesorder.wf_inititeminfo_quotation(long al_icode, long al_row, integer ai_rtcode, string as_errortext, long al_gcode) returns boolean
	boolean retflag
	double ld_rpp
	double ld_purprice
	double ld_flatdisc
	double ld_invdiscperc
	double ld_discperc2
	double ld_discperc3
	double ld_discperc4
	double ld_saleprice
	double ld_discperc
	double ld_purdiscperc
	double ld_avgprice
	double ld_unitsalestax
	double ld_gstperc1
	double ld_gstperc2
	double ld_packsalestax
	double ld_saleprice2
	double ld_saleprice3
	double ld_saleprice4
	double ld_saleprice5
	double ld_discperc5
	long ll_packunits
	long ll_saleinvcode
	long ll_reorderqty
	long li_discstatus
	long ll_qtysale
	long ll_bonus
	long ll_itemdesc_status
	long ll_null
	integer li_gcode
	integer li_defaultgcode
	integer li_defaultgst
	integer li_custcode
	integer li_flatdiscstatus
	integer li_itemdiscpercno
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_antinorcotix
	string ls_itemtotalval
	string ls_locksaleprice
	string ls_lockdiscperc
	string ls_remarks
	double ld_godownstock
	double ld_saleqty
	double ld_totalstock
	double ld_holdlooseqty
	double ld_desiredbonus
	double ld_unitweight
	double ld_packingfactor
	setnull(ll_null)
	setnull(ls_null)
	SQL SELECT item.customicode , item.name , item.saleprice , item.packunits , item.salediscperc , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.avgprice , item.PurDiscPerc , item.antinorcotix , item.reorderqty , item.purprice , item.recentpurprice , round ( item.Packsalestax / item.packunits , 2 ) , item.gstperc1 , item.gstperc2 , qtysale =item.saleqty , bonus =item.bonusqty , item.Packsalestax , item.flatdisc , item.locksaleprice , item.lockdiscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 , item.remarks , item.unitweight , item.packingfactor INTO :ls_fullcode, :ls_name, :ld_saleprice, :ll_packunits, :ld_discperc, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :ld_avgprice, :ld_purdiscperc, :ls_antinorcotix, :ll_reorderqty, :ld_purprice, :ld_rpp, :ld_unitsalestax, :ld_gstperc1, :ld_gstperc2, :ll_qtysale, :ll_bonus, :ld_packsalestax, :ld_flatdisc, :ls_locksaleprice, :ls_lockdiscperc, :ld_discperc2, :ld_discperc3, :ld_discperc4, :ld_discperc5, :ls_remarks, :ld_unitweight, :ld_packingfactor FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
	li_custcode = this.id_master.getitemnumber(1, "custcode")
	if isnull(li_custcode) then
		retflag = false
		as_errortext = "Validation Error: Select Customer "
	end if
	li_defaultgst = this.id_master.getitemnumber(1, "dd_gstperc")
	SQL SELECT InvDiscPerc INTO :ld_invdiscperc FROM customer WHERE customer.custcode =:li_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	li_gcode = al_gcode
	this.it_transobject.getitemstockall(al_icode, ld_totalstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if retflag then
		this.id_detail.setitem(al_row, "gcode", li_gcode)
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		li_discstatus = long(this.id_detail.object.discperc.visible)
		ll_itemdesc_status = long(this.id_detail.object.saleitemdescription.visible)
		li_flatdiscstatus = long(this.id_detail.object.itemflatdisc.visible)
		if li_discstatus = 1 and this.id_detail.getitemstatus(al_row, "discperc", primary!) = notmodified! then
			li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
			if long(this.id_detail.object.discperc.visible) = 1 then
				choose case li_itemdiscpercno
				case 1
					this.id_detail.setitem(al_row, "discperc", ld_discperc)
				case 2
					this.id_detail.setitem(al_row, "discperc", ld_discperc2)
				case 3
					this.id_detail.setitem(al_row, "discperc", ld_discperc3)
				case 4
					this.id_detail.setitem(al_row, "discperc", ld_discperc4)
				case 5
					this.id_detail.setitem(al_row, "discperc", ld_discperc5)
				end choose
			else
				this.id_detail.setitem(al_row, "discperc", 0)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") and li_discstatus = 1 then
			li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
			choose case li_itemdiscpercno
			case 1
				this.id_detail.setitem(al_row, "discperc", ld_discperc)
			case 2
				this.id_detail.setitem(al_row, "discperc", ld_discperc2)
			case 3
				this.id_detail.setitem(al_row, "discperc", ld_discperc3)
			case 4
				this.id_detail.setitem(al_row, "discperc", ld_discperc4)
			case 5
				this.id_detail.setitem(al_row, "discperc", ld_discperc5)
			end choose
		end if
		if this.id_detail.getitemstatus(al_row, "saleprice", primary!) = notmodified! then
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
			case 2.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				this.id_detail.setitem(al_row, "packprice", ld_purprice)
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				this.id_detail.setitem(al_row, "packprice", ld_rpp)
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
			case else
				this.id_detail.setitem(al_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
			end choose
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
			case 2.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				this.id_detail.setitem(al_row, "packprice", ld_purprice)
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				this.id_detail.setitem(al_row, "packprice", ld_rpp)
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
			case else
				this.id_detail.setitem(al_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
			end choose
		end if
		this.id_detail.setitem(al_row, "icode", al_icode)
		this.id_detail.setitem(al_row, "packunits", ll_packunits)
		this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
		this.id_detail.setitem(al_row, "stock", ld_godownstock)
		this.id_detail.setitem(al_row, "totalstock", ld_totalstock)
		this.id_detail.setitem(al_row, "unitweight", ld_unitweight)
		this.id_detail.setitem(al_row, "packingfactor", ld_packingfactor)
		if li_flatdiscstatus = 1 then
			if this.id_detail.getitemstatus(al_row, "itemflatdisc", primary!) = notmodified! then
				this.id_detail.setitem(al_row, "itemflatdisc", ld_flatdisc)
			end if
		else
			this.id_detail.setitem(al_row, "itemflatdisc", 0)
		end if
		if f_stringpreferences("SaleCopyItemRemarks") = "Y" and this.id_detail.getitemstatus(al_row, "saleitemdescription", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "saleitemdescription", ls_remarks)
		end if
		this.id_detail.setitem(al_row, "recentpurprice", ld_rpp)
		this.id_detail.setitem(al_row, "purprice", ld_purprice)
		this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
		this.id_detail.setitem(al_row, "itemtotalval", ls_itemtotalval)
		this.id_detail.setitem(al_row, "quotationrowid", ll_null)
		if f_stringpreferences("bonusinsale") = "Y" then
			this.id_detail.setitem(al_row, "qtysale", ll_qtysale)
			this.id_detail.setitem(al_row, "bonus", ll_bonus)
		end if
		if this.id_detail.getitemstatus(al_row, "Unitsalestax", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
		end if
		if this.id_detail.getitemstatus(al_row, "gstperc", primary!) = notmodified! then
			if li_defaultgst = 2 then
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
			if li_defaultgst = 2 then
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
			end if
			if f_stringpreferences("SaleCopyItemRemarks") = "Y" then
				this.id_detail.setitem(al_row, "saleitemdescription", ls_remarks)
			end if
		end if
		this.id_detail.setitem(al_row, "locksaleprice", ls_locksaleprice)
		this.id_detail.setitem(al_row, "lockdiscperc", ls_lockdiscperc)
	else
		retflag = false
		as_errortext = "Item can not be sold, its Stock is Zero"
	end if
	if f_stringpreferences("salepromptforreorder") = "Y" and ll_reorderqty > round(ld_godownstock / ll_packunits, 0) then
		messagebox("Stock", "Stock for this item become~r~n less than ReorderQty")
	end if
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_totalstock)
	this.id_footer.setitem(1, "rpp", ld_rpp)
	this.id_footer.setitem(1, "purprice", ld_purprice)
	this.id_footer.setitem(1, "avgprice", ld_avgprice)
	this.id_footer.setitem(1, "itemtotalval", ls_itemtotalval)
	if this.id_footer.getitemstatus(1, "invdiscperc", primary!) = notmodified! and this.ib_modify = false then
		this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
	end if
	if f_stringpreferences("bonusinsale") = "Y" then
		this.id_footer.setitem(1, "bonusratio", trim(string(ll_qtysale)) + ":" + trim(string(ll_bonus)))
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			ld_holdlooseqty = this.id_detail.getitemnumber(al_row, "looseqty")
			if this.id_detail.getitemnumber(al_row, "qtysale") = 0.0 then
				ld_desiredbonus = 0
			else
				ld_desiredbonus = ld_holdlooseqty / double(this.id_detail.getitemnumber(al_row, "qtysale")) * double(this.id_detail.getitemnumber(al_row, "Bonus"))
			end if
			this.id_detail.setitem(al_row, "bonusqty", ld_desiredbonus)
		end if
	end if
	this.id_footer.object.t_purdiscper.text = string(ld_purdiscperc)
	this.id_detail.setitem(al_row, "itemcode", al_icode)
	return retflag

// w_salesorder.wf_post_wrt_patient() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	s_arguements lstr_arginfo
	string ls_askuserpwd
	ls_askuserpwd = "AskUserPwdInSaleOrder"
	if f_stringpreferences(ls_askuserpwd) = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	setfocus()
	if ll_salesmancode > 0 then
		openwithparm(w_arg_patient_sinvcode_linvcode, this.ii_saletype)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			li_errcode = wf_locksaleorders(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_saleinvcount)
			if li_errcode = 0 then
				sqlca.postsaleorder_wrt_patient(this.ii_socatcode, lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode, lstr_arginfo.l_code3)
				if sqlca.sqlcode <> 0 then
					li_errcode = -1
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again")
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_saleinvcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return li_errcode

// w_salesorder.wf_postsaleheaderwise() returns integer
	integer li_errcode
	integer li_count
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	s_arguements lstr_arginfo
	string ls_askuserpwd
	ls_askuserpwd = "AskUserPwdInSaleOrder"
	if f_stringpreferences(ls_askuserpwd) = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_postsaleheaderwise)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			SQL Select count ( *) INTO :ll_saleinvcount From saleorderheader WITH ( UPDLOCK HOLDLOCK ) Where saleorderheader.headerinvno Between :lstr_arginfo.l_code1 AND :lstr_arginfo.l_code2 AND saleorderheader.HeaderNo =:lstr_arginfo.l_code3 AND saleorderheader.Posted ='N' AND saleorderheader.Deleted ='N' USING sqlca;
			li_errcode = sqlca.sqlcode
			if li_errcode = 0 then
				sqlca.postsaleorderheaderwise(this.ii_socatcode, lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode, lstr_arginfo.l_code3)
				if sqlca.sqlcode <> 0 then
					li_errcode = -1
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again")
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_saleinvcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return li_errcode

// w_salesorder.wf_finalizesaleorders() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	string ls_askuserpwd
	s_arguements lstr_arginfo
	ls_askuserpwd = "AskUserPwdInSaleOrder"
	if f_stringpreferences(ls_askuserpwd) = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	setfocus()
	if ll_salesmancode > 0 then
		openwithparm(w_arg_cust_sinvcode_linvcode, this.ii_saletype)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			li_errcode = wf_locksaleorders(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_saleinvcount)
			if li_errcode = 0 then
				sqlca.finalizesaleorder(this.ii_socatcode, lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode, lstr_arginfo.l_code3, lstr_arginfo.l_code4)
				if sqlca.sqlcode <> 0 then
					li_errcode = -1
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Sale Order Finalization Fails", "Some database request fails, Please try again")
		else
			messagebox("Sale Order Finalization Successfull", "Total unposted rows were " + string(ll_saleinvcount) + "~n~rAll rows have been finalized successfully")
		end if
	end if
	return li_errcode

// w_salesorder.wf_initmodify(integer ai_protect) returns 0
	long ll_saleordercode
	long ll_gcode
	long ll_icode
	long ll_counter
	long ll_count
	double ld_saleprice
	double ld_packsalestax
	double ld_avgprice
	double ld_recentpurprice
	double ld_purprice
	string ls_itemtotalval
	double ld_looseqty
	double ld_bonusqty
	double ld_stock
	double ld_purdiscperc
	long ll_disc_icode
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_saleordercode = this.id_master.getitemnumber(1, "code")
		if wf_locksaleorder(ll_saleordercode) = 0 then
			this.id_master.retrieve(ll_saleordercode)
			this.id_detail.retrieve(ll_saleordercode)
			if ai_protect = 0 and this.id_detail.rowcount() > 0 then
				this.ib_modify = true
				this.id_footer.setitem(1, "stock", this.id_detail.getitemnumber(1, "stock"))
				this.id_footer.setitem(1, "totalstock", this.id_detail.getitemnumber(1, "totalstock"))
				if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
					ll_disc_icode = this.id_detail.getitemnumber(1, "icode")
					SQL Select item.purdiscperc INTO :ld_purdiscperc From Item Where item.icode =:ll_disc_icode USING this.it_transobject;
					this.id_footer.object.t_purdiscper.text = string(ld_purdiscperc)
				end if
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
			return
		end if
		messagebox("Cannot Modify", "Sale invoice is already in use")
	end if

// w_salesorder.wf_isfinalized(long al_invcode) returns boolean
	long ll_count
	SQL SELECT Count ( SaleOrderCode ) INTO :ll_count FROM SaleOrderHeader WHERE SaleOrderCode =:al_invcode and Finalized ='Y' USING sqlca;
	if sqlca.sqlcode = 0 then
		if ll_count > 0 then
			return true
		else
			return false
		end if
		return
	end if
	return false

// w_salesorder.wf_allowinvoice(long al_custcode, long al_lastinvcode) returns long
	long ll_retcode
	long ll_code
	if this.ib_modify then
		ll_code = this.id_master.getitemnumber(this.id_master.rowcount(), "code")
		SQL SELECT COUNT ( CustCode ) , max ( SaleOrderCode ) INTO :ll_retcode, :al_lastinvcode FROM SaleOrderHeader WHERE CustCode =:al_custcode and SaleOrderCode <> :ll_code and Posted ='N' AND Deleted ='N' USING sqlca;
	else
		SQL SELECT COUNT ( CustCode ) , max ( SaleOrderCode ) INTO :ll_retcode, :al_lastinvcode FROM SaleOrderHeader WHERE CustCode =:al_custcode and Posted ='N' AND Deleted ='N' USING sqlca;
	end if
	return ll_retcode

// w_salesorder.wf_editquotation() returns integer
	datastore lds_quotationdetail
	datastore lds_quotationheader
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_counter
	long ll_tmprowid
	long ll_tmpcode
	long ll_found
	long ll_loosepack
	long ll_packunits
	integer li_retcode
	integer li_errcode
	string ls_errortext
	boolean lb_enablesave
	boolean lb_insertrow
	double ld_price
	double ld_tmpqty
	double ld_tmpbonus
	double ld_qqty
	double ld_qbonus
	if wf_iseditable() = false then
		return 0
	end if
	if this.ib_modify and this.id_master.getitemnumber(1, "code") > 0.0 and (this.id_master.getitemstring(1, "Finalized") = "Y" or this.id_master.getitemstring(1, "Posted") = "Y" or this.id_master.getitemstring(1, "Deleted") = "Y") then
		return 0
	end if
	lds_quotationdetail = create datastore
	lds_quotationheader = create datastore
	open(w_editquotation_posted_saleorder_form)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		this.id_detail.setredraw(false)
		lds_quotationdetail.dataobject = "d_quotationdetail_retrieve_saleorder"
		lds_quotationdetail.settransobject(this.it_transobject)
		lds_quotationheader.dataobject = "d_quotationheader"
		lds_quotationheader.settransobject(this.it_transobject)
		ll_row = lds_quotationheader.retrieve(lstr_template.l_invtemplate)
		lds_quotationdetail.retrieve(lstr_template.l_invtemplate, lstr_template.l_invtemplate2, lstr_template.i_invtype)
		ll_totalrows = lds_quotationheader.retrieve(lstr_template.l_invtemplate)
		if ll_row <= 0 then
			li_retcode = -1
		else
			ll_mrow = this.id_master.getrow()
			this.id_master.setitem(ll_mrow, "quotationcode", lstr_template.l_invtemplate)
			if this.ii_saletype = 2 then
				this.id_master.setitem(ll_mrow, "custcode", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "custcode"))
			end if
			this.id_master.setitem(ll_mrow, "sprice", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "sprice"))
			this.id_master.setitem(ll_mrow, "remarks", lds_quotationheader.getitemstring(lds_quotationheader.getrow(), "remarks"))
			this.id_master.setitem(ll_mrow, "headerno", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "headerno"))
			this.id_footer.setitem(ll_mrow, "misccharges", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "misccharges"))
			this.id_footer.setitem(ll_mrow, "flatdisc", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "flatdisc"))
			this.id_footer.setitem(ll_mrow, "invdiscperc", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "discperc"))
			ll_loosepack = lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "loosepack")
		end if
		ll_totalrows = lds_quotationdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		if lb_enablesave then
			wf_deleteallemptydetailrows()
			if lstr_template.b_userinput = true then
				for ll_rowcount = 1 to this.id_detail.rowcount()
					event ue_deleteitem()
				next
				this.id_detail.reset()
			end if
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				lb_insertrow = false
				ld_tmpqty = 0
				ld_tmpbonus = 0
				ll_packunits = lds_quotationdetail.getitemnumber(ll_counter, "packunits")
				if ll_packunits = 0 then
					ll_packunits = 1
				end if
				ll_found = 0
				if lstr_template.b_userinput = false then
					ll_found = this.id_detail.find("quotationrowid=" + string(lds_quotationdetail.getitemnumber(ll_counter, "rowid")) + " AND icode=" + string(lds_quotationdetail.getitemnumber(ll_counter, "icode")), 1, this.id_detail.rowcount())
				end if
				if ll_found <= 0 then
					if ll_loosepack = 1 then
						ld_qqty = lds_quotationdetail.getitemnumber(ll_counter, "looseqty")
						ld_qbonus = lds_quotationdetail.getitemnumber(ll_counter, "bonusqty")
						ld_price = lds_quotationdetail.getitemnumber(ll_counter, "saleprice")
					else
						ld_qqty = lds_quotationdetail.getitemnumber(ll_counter, "looseqty") * ll_packunits
						ld_qbonus = lds_quotationdetail.getitemnumber(ll_counter, "bonusqty") * ll_packunits
						ld_price = round(lds_quotationdetail.getitemnumber(ll_counter, "saleprice") / ll_packunits, 2)
					end if
					if lstr_template.i_invtype = 0 then
						lb_insertrow = true
					else
						if this.ib_modify and this.id_master.getitemnumber(1, "code") > 0.0 then
							ll_tmprowid = lds_quotationdetail.getitemnumber(ll_counter, "rowid")
							ll_tmpcode = this.id_master.getitemnumber(1, "code")
							SQL SELECT sum ( looseqty ) , sum ( bonusqty ) INTO :ld_tmpqty, :ld_tmpbonus FROM SaleOrderDetail WHERE QuotationRowID =:ll_tmprowid AND SaleOrderCode =:ll_tmpcode USING sqlca;
							if sqlca.sqlcode <> 0 then
								lb_insertrow = false
							end if
						end if
						if isnull(ld_tmpqty) then
							ld_tmpqty = 0
						end if
						if isnull(ld_tmpbonus) then
							ld_tmpbonus = 0
						end if
						if ll_loosepack = 1 then
							if ld_qqty - lds_quotationdetail.getitemnumber(ll_counter, "saleorderqty") + ld_tmpqty > 0.0 or ld_qbonus - lds_quotationdetail.getitemnumber(ll_counter, "saleorderbonus") + ld_tmpbonus > 0.0 then
								lb_insertrow = true
							end if
						elseif ld_qqty * ll_packunits - lds_quotationdetail.getitemnumber(ll_counter, "saleorderqty") + ld_tmpqty > 0.0 or ld_qbonus * ll_packunits - lds_quotationdetail.getitemnumber(ll_counter, "saleorderbonus") + ld_tmpbonus > 0.0 then
							lb_insertrow = true
						end if
					end if
					if lb_insertrow = true then
						ll_rowcount = this.id_detail.insertrow(0)
						ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_quotationdetail.getitemnumber(ll_counter, "gcode")), 1, this.idc_godown.rowcount())
						if ll_validgodowncode = 0 or this.il_strategy = 2 or this.il_godowncount = 1 then
							wf_inititeminfo(lds_quotationdetail.getitemnumber(ll_counter, "icode"), ll_rowcount, li_errcode, ls_errortext)
						else
							ll_gcode = lds_quotationdetail.getitemnumber(ll_counter, "gcode")
							this.id_detail.setitem(ll_rowcount, "gcode", ll_gcode)
							wf_inititeminfo_quotation(lds_quotationdetail.getitemnumber(ll_counter, "icode"), ll_rowcount, li_errcode, ls_errortext, ll_gcode)
						end if
						this.id_detail.setitem(ll_rowcount, "quotationrowid", lds_quotationdetail.getitemnumber(ll_counter, "rowid"))
						this.id_detail.setitem(ll_rowcount, "packunits", ll_packunits)
						this.id_detail.setitem(ll_rowcount, "discperc", lds_quotationdetail.getitemnumber(ll_counter, "discperc"))
						this.id_detail.setitem(ll_rowcount, "itemflatdisc", lds_quotationdetail.getitemnumber(ll_counter, "itemflatdisc"))
						this.id_detail.setitem(ll_rowcount, "claimablediscperc", lds_quotationdetail.getitemnumber(ll_counter, "claimablediscperc"))
						if lds_quotationdetail.getitemnumber(ll_counter, "claimablediscperc") > 0.0 then
							this.id_detail.setitem(ll_rowcount, "claimable", "Y")
						else
							this.id_detail.setitem(ll_rowcount, "claimable", "N")
						end if
						this.id_detail.setitem(ll_rowcount, "saleprice", ld_price)
						if lstr_template.i_invtype = 0 then
							this.id_detail.setitem(ll_rowcount, "looseqty", ld_qqty)
							this.id_detail.setitem(ll_rowcount, "bonusqty", ld_qbonus)
						else
							ld_tmpqty = ld_qqty - lds_quotationdetail.getitemnumber(ll_counter, "saleorderqty") + ld_tmpqty
							ld_tmpbonus = ld_qbonus - lds_quotationdetail.getitemnumber(ll_counter, "saleorderbonus") + ld_tmpbonus
							if ld_tmpqty > 0.0 then
								this.id_detail.setitem(ll_rowcount, "looseqty", ld_tmpqty)
							end if
							if ld_tmpbonus > 0.0 then
								this.id_detail.setitem(ll_rowcount, "bonusqty", ld_tmpbonus)
							end if
						end if
					end if
				end if
			next
		end if
		this.id_detail.setredraw(true)
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return li_retcode

// w_salesorder.wf_custominfo_view() returns 0
	long ll_custcode
	if this.id_master.rowcount() > 0 then
		ll_custcode = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		if ll_custcode > 0 and not isnull(ll_custcode) then
			openwithparm(w_customerinfo_view, ll_custcode)
		end if
	end if

// w_salesorder.wf_check_creditlimit(long al_custcode, long al_usercode, integer ai_mode) returns long
	double ld_grandtotal
	double ld_crlimit
	double ld_balance
	double ld_unpostedbal
	long ll_retcode
	long ll_option
	long ll_groupcode
	long ll_rightallowed
	string ls_msg
	string ls_msgtitle
	if this.ii_saletype = 2 then
		ll_groupcode = f_getgroupcode(al_usercode)
		if f_stringpreferences("CheckCrLimitInCrSales") = "Y" and this.ii_saletype = 2 then
			ld_grandtotal = wf_grandtotal()
			SQL SELECT RightAllowed =ISNULL ( ( SELECT MAX ( 1 ) FROM GroupRights WHERE GroupCode =:ll_groupcode AND RightCode =611 ) , 0 ) , CrLimit =ISNULL ( CrLimit , 0 ) , Balance =ISNULL ( ( SELECT SUM ( Debit - Credit ) FROM VirtualGL WHERE AccCode =:al_custcode ) , 0 ) , UnpostedBal =ISNULL ( ( SELECT SUM ( S.InvTotal ) FROM SaleLedger S WHERE S.CustCode =:al_custcode AND S.SaleCatCode =:this.ii_saletype AND S.Posted ='N' AND S.AccountFor ='Y' GROUP BY S.CustCode ) , 0 ) INTO :ll_rightallowed, :ld_crlimit, :ld_balance, :ld_unpostedbal FROM Customer WHERE CustCode =:al_custcode USING sqlca;
			if sqlca.sqlcode = 0 then
				if ld_balance + ld_unpostedbal + ld_grandtotal > ld_crlimit then
					ls_msg = "Total Recivable From Customer Exceeds Credit Limit~r~n~r~n" + "Previous Balance    : ~t~t" + string(ld_balance, "###,###,###0.00") + "~r~n" + "Un-Posted Invoices Value: ~t~t" + string(ld_unpostedbal, "###,###,###0.00") + "~r~n" + "This Invoice Amount: ~t~t" + string(ld_grandtotal, "###,###,###0.00") + "~r~n" + "Total Receivable: ~t~t~t" + string(ld_balance + ld_grandtotal + ld_unpostedbal, "###,###,###0.00") + "~r~n" + "Credit Limit: ~t~t~t" + string(ld_crlimit, "###,###,###0.00") + "~r~n"
					if ai_mode = 0 then
						messagebox(ls_msgtitle, ls_msg, information!, ok!)
						ll_option = 1
					elseif ll_rightallowed = 1 then
						ls_msg = ls_msg + "~r~nContinue Anyway?"
						ll_option = messagebox(ls_msgtitle, ls_msg, question!, yesno!, 2)
					else
						messagebox(ls_msgtitle, ls_msg, stopsign!, ok!)
						ll_option = 2
					end if
					if ll_option = 1 then
						ll_retcode = 0
					else
						ll_retcode = 1
					end if
				else
					ll_retcode = 0
				end if
			else
				messagebox("Customer Validation!", "Can not fetch customer credit limit.", stopsign!)
				ll_retcode = 2
			end if
		else
			ll_retcode = 0
		end if
	else
		ll_retcode = 0
	end if
	return ll_retcode

// w_salesorder.wf_getcustitemcatwisesalesdiscount(long al_icode, long al_custcode, double ad_discperc, double ad_itemflatdisc) returns boolean
	double ld_null
	setnull(ld_null)
	ad_discperc = ld_null
	SQL SELECT discperc , itemflatdisc INTO :ad_discperc, :ad_itemflatdisc FROM DBO.CustItemCatWiseSaleDiscount WHERE CustCatCode =ISNULL ( ( SELECT Customer.custcatcode FROM dbo.customer Where Customer.custcode =:al_custcode ) , 0 ) AND ICatCode =ISNULL ( ( SELECT Item.icatcode FROM dbo.Item Where Item.Icode =:al_icode ) , 0 ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ad_discperc) or isnull(ad_itemflatdisc) then
			return false
		else
			return true
		end if
		return
	end if
	return false

// w_salesorder.wf_setiteminfo(long al_icode, long al_row, double ad_saleprice, double ad_discperc, double ad_stock, double ad_avgprice, double ad_totalstock, double ad_purdiscperc) returns 0
	this.id_detail.setitem(al_row, "saleprice", ad_saleprice)
	if this.ii_saletype = 2 then
		this.id_detail.setitem(al_row, "discperc", ad_discperc)
	else
		this.id_detail.setitem(al_row, "discperc", 0.0)
	end if
	this.id_detail.setitem(al_row, "rate", ad_saleprice)
	this.id_detail.setitem(al_row, "avgprice", ad_avgprice)
	this.id_footer.object.icode[this.id_footer.getrow()] = al_icode
	this.id_footer.object.stock[this.id_footer.getrow()] = ad_stock

// w_salesorder.wf_populate_po() returns long
	datastore lds_saledetail
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_custcode
	long ll_counter
	integer li_retcode
	integer li_errcode
	string ls_errortext
	boolean lb_enablesave
	boolean lb_bonus
	s_saletemplate lstr_template
	if wf_iseditable() = false then
		return 0
	end if
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	if isnull(ll_custcode) or ll_custcode = 0 then
		messagebox("Customer Validation", "Can not populate sale invoices~r~nPlease Select Valid Customer")
		this.id_master.setcolumn("custcode")
		this.id_master.setfocus()
		return -1
	end if
	if f_stringpreferences("BonusInSale") = "Y" then
		lb_bonus = true
	end if
	if wf_iseditable() = false then
		return 0
	end if
	open(w_editpurchaseorderform)
	lstr_template = message.powerobjectparm
	if lstr_template.l_invtemplate <= 0 then
		return 0
	end if
	lds_saledetail = create datastore
	lds_saledetail.dataobject = "d_populatepurorder_in_saleorder"
	lds_saledetail.settransobject(this.it_transobject)
	if lstr_template.l_invtemplate > 0 then
		ll_totalrows = lds_saledetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_saledetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		ll_counter = 0
		ll_detailrows = this.id_detail.rowcount()
		for ll_counter = 1 to ll_detailrows
			event ue_deleteitem()
		next
		ll_counter = 0
		for ll_rowcount = 1 to ll_totalrows
			ll_counter = this.id_detail.insertrow(0)
			if wf_inititeminfo(lds_saledetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext) then
				this.id_detail.setitem(ll_counter, "icode", lds_saledetail.getitemnumber(ll_rowcount, "icode"))
				this.id_detail.setitem(ll_counter, "gcode", lds_saledetail.getitemnumber(ll_rowcount, "gcode"))
				this.id_detail.setitem(ll_counter, "looseqty", lds_saledetail.getitemnumber(ll_rowcount, "qty") * this.id_detail.getitemnumber(ll_counter, "Packunits"))
				if lb_bonus = true then
					this.id_detail.setitem(ll_counter, "bonusqty", lds_saledetail.getitemnumber(ll_rowcount, "bonusqty") * this.id_detail.getitemnumber(ll_counter, "Packunits"))
					this.id_detail.setitem(ll_counter, "bonuspackqtyforsale", 0)
				else
					this.id_detail.setitem(ll_counter, "bonusqty", 0)
					this.id_detail.setitem(ll_counter, "bonuspackqtyforsale", 0)
				end if
			else
				event ue_deleteitem()
			end if
		next
	else
		li_retcode = -1
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	destroy lds_saledetail
	return li_retcode

// w_salesorder.wf_gen_saleordercode(integer ai_socatcode, long al_ordercode, transaction at_transobject) returns long
	long ll_rtcode
	SQL SELECT dbo.SaleOrderCategory.COUNTER INTO :al_ordercode FROM dbo.SaleOrderCategory WITH ( UPDLOCK HOLDLOCK ) WHERE dbo.SaleOrderCategory.SOCatCode =:ai_socatcode USING at_transobject;
	if at_transobject.sqlcode = 0 then
		al_ordercode = al_ordercode + 1
		SQL update dbo.SaleOrderCategory SET dbo.SaleOrderCategory.COUNTER =:al_ordercode WHERE dbo.SaleOrderCategory.SOCatCode =:ai_socatcode USING at_transobject;
		if at_transobject.sqlcode < 0 then
			ll_rtcode = at_transobject.sqlcode
			al_ordercode = 0
		end if
	else
		ll_rtcode = at_transobject.sqlcode
		al_ordercode = 0
	end if
	return ll_rtcode

// w_salesorder.wf_apply_associated_quotation(integer ai_mode) returns long
	long ll_custcode
	long ll_masterrow
	long ll_quotationcode
	long ll_detailrows
	long ll_qheaderrow
	long ll_quotationrows
	long ll_found
	long ll_loosepack
	long ll_rowcount
	long ll_quotpackunits
	long ll_icode
	long ll_notfound_itemcount
	double ld_quotprice
	double ld_quotdiscperc
	double ld_quotitemflatdisc
	double ld_quotclaimablediscperc
	double ld_quotgstperc
	double ld_quotqty
	double ld_quotbonusqty
	double ld_qty
	double ld_bonusqty
	double ld_bonusfactor
	string ls_msgtitle
	string ls_itemname
	string ls_msgdetail
	string ls_fetchprice
	string ls_fetchitemflatdisc
	string ls_fetchitemdiscperc
	string ls_claimablediscperc
	string ls_fetchgstperc
	boolean lb_editsaleprice
	boolean lb_editsalediscperc
	boolean lb_editbonusqty
	boolean lb_edititewflatdisc
	datastore lds_quotationdetail
	datastore lds_quotationheader
	if wf_iseditable() = false then
		return 0
	end if
	ls_fetchprice = f_stringpreferences("fetchpricefromassocquot")
	ls_fetchitemflatdisc = f_stringpreferences("fetchitemflatdiscfromassocquot")
	ls_fetchitemdiscperc = f_stringpreferences("fetchdiscpercfromassocquot")
	ls_claimablediscperc = f_stringpreferences("fetchclaimablediscpercfromassocquot")
	ls_fetchgstperc = f_stringpreferences("fetchitemgstdiscpercfromassocquot")
	if ls_claimablediscperc = "" or isnull(ls_claimablediscperc) then
		ls_claimablediscperc = "N"
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_custcode = this.id_master.getitemnumber(ll_masterrow, "custcode")
	if ll_custcode = 0 or isnull(ll_custcode) then
		messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Items before applying Customers' Associated Quotation", stopsign!)
		return 0
	end if
	ll_quotationcode = wf_get_associatedquotationcode(ll_custcode)
	if ll_quotationcode < 0 then
		if ll_quotationcode = -1 then
			messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
			return 0
		else
			messagebox(ls_msgtitle, "Problem in retrieving Associated Quotation of Customer", stopsign!)
			return 0
		end if
	elseif ll_quotationcode = 0 then
		if ai_mode = 0 then
			messagebox(ls_msgtitle, "No Associated Quotation found for this Customer", stopsign!)
			return 0
		else
			return 1
		end if
		return
	end if
	lds_quotationdetail = create datastore
	lds_quotationheader = create datastore
	lds_quotationdetail.dataobject = "d_quotationdetail_retrieve"
	lds_quotationdetail.settransobject(this.it_transobject)
	lds_quotationheader.dataobject = "d_quotationheader"
	lds_quotationheader.settransobject(this.it_transobject)
	ll_qheaderrow = lds_quotationheader.retrieve(ll_quotationcode)
	if ll_qheaderrow < 0 then
		messagebox(ls_msgtitle, "Associated Quotation Header Retrieval Problem", stopsign!)
		return 0
	else
		ll_qheaderrow = lds_quotationheader.rowcount()
		if ll_qheaderrow = 0 then
			messagebox(ls_msgtitle, "Associated Quotation Does not Exist", stopsign!)
			return 0
		end if
	end if
	ll_quotationrows = lds_quotationdetail.retrieve(ll_quotationcode)
	if ll_quotationrows < 0 then
		messagebox(ls_msgtitle, "Associated Quotation Detail Retrieval Problem", stopsign!)
		return 0
	else
		ll_quotationrows = lds_quotationdetail.rowcount()
		if ll_quotationrows = 0 then
			if ai_mode = 0 then
				messagebox(ls_msgtitle, "Associated Quotation contain no rows", stopsign!)
				return 0
			else
				return 1
			end if
			return
		end if
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 511", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editsaleprice = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 516", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editsalediscperc = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 596", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editbonusqty = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 517", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_edititewflatdisc = true
	end if
	ll_loosepack = lds_quotationheader.getitemnumber(ll_qheaderrow, "loosepack")
	setredraw(false)
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ll_found = 0
		ll_found = lds_quotationdetail.find("icode = " + trim(string(ll_icode)), 1, ll_quotationrows)
		if ll_found > 0 then
			ll_quotpackunits = lds_quotationdetail.getitemnumber(ll_found, "packunits")
			ld_quotdiscperc = lds_quotationdetail.getitemnumber(ll_found, "discperc")
			ld_quotitemflatdisc = lds_quotationdetail.getitemnumber(ll_found, "itemflatdisc")
			ld_quotclaimablediscperc = lds_quotationdetail.getitemnumber(ll_found, "claimablediscperc")
			ld_quotgstperc = lds_quotationdetail.getitemnumber(ll_found, "gstperc")
			if ll_quotpackunits = 0 then
				ll_quotpackunits = 1
			end if
			if ll_loosepack = 1 then
				ld_quotqty = lds_quotationdetail.getitemnumber(ll_found, "looseqty")
				ld_quotbonusqty = lds_quotationdetail.getitemnumber(ll_found, "bonusqty")
				ld_quotprice = lds_quotationdetail.getitemnumber(ll_found, "saleprice")
			else
				ld_quotqty = lds_quotationdetail.getitemnumber(ll_found, "looseqty") * ll_quotpackunits
				ld_quotbonusqty = lds_quotationdetail.getitemnumber(ll_found, "bonusqty") * ll_quotpackunits
				ld_quotprice = round(lds_quotationdetail.getitemnumber(ll_found, "saleprice") / ll_quotpackunits, 2)
			end if
			if ld_quotqty <= 0.0 then
				ld_quotqty = 1
			end if
			ld_qty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
			ld_bonusqty = this.id_detail.getitemnumber(ll_rowcount, "bonusqty")
			ld_bonusfactor = round(ld_qty / ld_quotqty, 4)
			if lb_editbonusqty then
				this.id_detail.setitem(ll_rowcount, "bonusqty", round(ld_bonusfactor * ld_quotbonusqty, 4))
			end if
			if lb_editsaleprice and this.id_detail.getitemstring(ll_rowcount, "locksaleprice") = "N" and ls_fetchprice = "Y" then
				this.id_detail.setitem(ll_rowcount, "saleprice", ld_quotprice)
			end if
			if lb_editsalediscperc and this.id_detail.getitemstring(ll_rowcount, "lockdiscperc") = "N" and ls_fetchitemdiscperc = "Y" then
				this.id_detail.setitem(ll_rowcount, "discperc", ld_quotdiscperc)
			end if
			if lb_edititewflatdisc and ls_fetchitemflatdisc = "Y" then
				this.id_detail.setitem(ll_rowcount, "itemflatdisc", ld_quotitemflatdisc)
			end if
			if ls_claimablediscperc = "Y" then
				if ld_quotclaimablediscperc > 0.0 then
					this.id_detail.setitem(ll_rowcount, "claimable", "Y")
				else
					this.id_detail.setitem(ll_rowcount, "claimable", "N")
				end if
				this.id_detail.setitem(ll_rowcount, "claimablediscperc", ld_quotclaimablediscperc)
			end if
			if ls_fetchgstperc = "Y" then
				this.id_detail.setitem(ll_rowcount, "gstperc", ld_quotgstperc)
			end if
			this.id_detail.setitem(ll_rowcount, "quotationrowid", lds_quotationdetail.getitemnumber(ll_found, "rowid"))
		else
			ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname
			ll_notfound_itemcount = ll_notfound_itemcount + 1
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_notfound_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Guidelines Exist for Following " + trim(string(ll_notfound_itemcount)) + " item(s) in Associated Quotation/Pricing Contract~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_salesorder.wf_get_associatedquotationcode(long al_custcode) returns long
	long ll_retcode
	long ll_quotationcode
	if al_custcode = 0 or isnull(al_custcode) then
		ll_retcode = -1
		return ll_retcode
	else
		SQL SELECT AssociatedQuotationCode INTO :ll_quotationcode FROM DBO.Customer WHERE CustCode =:al_custcode USING sqlca;
		if sqlca.sqlcode = 0 then
			if ll_quotationcode = 0 or isnull(ll_quotationcode) then
				ll_retcode = 0
			else
				ll_retcode = ll_quotationcode
			end if
		else
			ll_retcode = -2
		end if
	end if
	return ll_retcode

// w_salesorder.wf_consolidatequotations_in_a_saleorder() returns long
	long ll_counter
	long ll_arr_rows
	long ll_saleordercode
	string ls_list
	s_arguements lstr_arg
	if wf_iseditable() = true then
		return 0
	end if
	open(w_quotation_range_selection)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		ll_arr_rows = upperbound(lstr_arg.ia_integerlist)
		ls_list = ""
		for ll_counter = 1 to ll_arr_rows
			ls_list = ls_list + trim(string(lstr_arg.ia_integerlist[ll_counter])) + ","
		next
		ls_list = left(ls_list, len(ls_list) - 1)
		if len(ls_list) > 0 then
			SQL rollback USING this.it_transobject;
			this.it_transobject.consolidatequotation_as_saleorder(gl_usercode, ls_list, ll_saleordercode)
			if this.it_transobject.sqlcode = 0 then
				SQL commit USING this.it_transobject;
				messagebox("Sale Order Consolidation", "Sale Order Consolidation done successfully.~r~nSale Order Code = " + trim(string(ll_saleordercode)), information!)
			else
				messagebox("Sale Order Consolidation", this.it_transobject.sqlerrtext, stopsign!)
				SQL rollback USING this.it_transobject;
			end if
		end if
	end if
	return 0

// w_salesorder.wf_item_consolidation_breakup() returns long
	long ll_row
	boolean lb_listtab
	s_arguements lst_arg
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab then
		if this.id_list.getrow() > 0 then
			lst_arg.l_code1 = this.id_list.object.code[this.id_list.getrow()]
			lst_arg.l_code2 = 12
			openwithparm(w_arg_items_documentfiltered, lst_arg)
			lst_arg = message.powerobjectparm
			if lst_arg.i_status = 1 then
				openwithparm(w_itemsbreakup_in_consolidatedsaleorder, lst_arg)
			end if
		end if
	elseif this.id_detail.rowcount() > 0 and this.id_detail.getrow() > 0 and this.id_detail.object.icode[this.id_detail.getrow()] > 0 then
		lst_arg.l_code1 = this.id_master.object.code[1]
		lst_arg.l_code2 = this.id_detail.object.icode[this.id_detail.getrow()]
		openwithparm(w_itembreakup_in_consolidatedsaleorder, lst_arg)
	end if
	return 0

// w_salesorder.wf_populate_crs_invoice() returns long
	datastore lds_saledetail
	s_arguements lstr_arg
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_custcode
	long ll_counter
	integer li_retcode
	integer li_errcode
	string ls_errortext
	boolean lb_enablesave
	boolean lb_bonus
	if wf_iseditable() = false then
		return 0
	end if
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	if isnull(ll_custcode) or ll_custcode = 0 then
		messagebox("Customer Validation", "Can not populate sale invoices~r~nPlease Select Valid Customer")
		this.id_master.setcolumn("custcode")
		this.id_master.setfocus()
		return -1
	end if
	if f_stringpreferences("BonusInSale") = "Y" then
		lb_bonus = true
	end if
	if wf_iseditable() = false then
		return 0
	end if
	lds_saledetail = create datastore
	lds_saledetail.dataobject = "d_crs_salepopulation_in_saleorder"
	lds_saledetail.settransobject(this.it_transobject)
	ll_totalrows = lds_saledetail.retrieve()
	if ll_totalrows > 0 then
		this.id_master.object.clientinstanceid[1] = lds_saledetail.object.clientinstanceid[1]
		this.id_master.object.custrefno[1] = lds_saledetail.object.custrefno[1]
		this.id_master.object.custrefno2[1] = lds_saledetail.object.custrefno2[1]
		this.id_master.object.custrefno3[1] = lds_saledetail.object.custrefno3[1]
		this.id_master.object.custrefno4[1] = lds_saledetail.object.custrefno4[1]
		this.id_master.object.remarks[1] = lds_saledetail.object.remarks[1]
		this.id_master.object.discperc[1] = lds_saledetail.object.invdiscperc[1]
		this.id_master.object.flatdisc[1] = lds_saledetail.object.flatdisc[1]
		this.id_master.object.misccharges[1] = lds_saledetail.object.misccharges[1]
		this.id_master.object.invgstperc1[1] = lds_saledetail.object.invgstperc1[1]
		this.id_footer.object.invdiscperc[1] = lds_saledetail.object.invdiscperc[1]
		this.id_footer.object.flatdisc[1] = lds_saledetail.object.flatdisc[1]
		this.id_footer.object.misccharges[1] = lds_saledetail.object.misccharges[1]
		this.id_footer.object.invgstperc1[1] = lds_saledetail.object.invgstperc1[1]
		ll_counter = 0
		ll_detailrows = this.id_detail.rowcount()
		for ll_counter = 1 to ll_detailrows
			event ue_deleteitem()
		next
		ll_counter = 0
		for ll_rowcount = 1 to ll_totalrows
			ll_counter = this.id_detail.insertrow(0)
			if wf_inititeminfo(lds_saledetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext) then
				this.id_detail.setitem(ll_counter, "icode", lds_saledetail.getitemnumber(ll_rowcount, "icode"))
				this.id_detail.setitem(ll_counter, "looseqty", lds_saledetail.getitemnumber(ll_rowcount, "looseqty"))
				this.id_detail.setitem(ll_counter, "packunits", lds_saledetail.getitemnumber(ll_rowcount, "packunits"))
				this.id_detail.setitem(ll_counter, "saleprice", lds_saledetail.getitemnumber(ll_rowcount, "saleprice"))
				this.id_detail.setitem(ll_counter, "discperc", lds_saledetail.getitemnumber(ll_rowcount, "discperc"))
				this.id_detail.setitem(ll_counter, "itemflatdisc", lds_saledetail.getitemnumber(ll_rowcount, "itemflatdisc"))
				this.id_detail.setitem(ll_counter, "saleitemdescription", lds_saledetail.getitemstring(ll_rowcount, "saleitemdescription"))
				this.id_detail.setitem(ll_counter, "unitsalestax", lds_saledetail.getitemnumber(ll_rowcount, "unitsalestax"))
				this.id_detail.setitem(ll_counter, "gstperc", lds_saledetail.getitemnumber(ll_rowcount, "gstperc"))
				if lb_bonus = true then
					this.id_detail.setitem(ll_counter, "bonusqty", lds_saledetail.getitemnumber(ll_rowcount, "bonusqty"))
				else
					this.id_detail.setitem(ll_counter, "bonusqty", 0)
				end if
			else
				event ue_deleteitem()
			end if
		next
		lb_enablesave = true
	else
		li_retcode = -1
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	destroy lds_saledetail
	return li_retcode

// w_salesorder.wf_search_crs_invoice() returns long
	s_arguements istr_arg
	open(w_crs_searchinvoice)
	istr_arg = message.powerobjectparm
	if istr_arg.i_status = 1 then
		wf_populate_crs_invoice()
	end if
	return 0

// w_salesorder.wf_show_saleordersupplier_info() returns long
	long ll_code
	boolean lb_listtab
	if wf_iseditable() then
		return 0
	end if
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab = false then
		return 0
	end if
	if this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
		if ll_code > 0 and not isnull(ll_code) then
			openwithparm(w_saleorder_supplierinfo, ll_code)
		end if
	end if
	return 0

