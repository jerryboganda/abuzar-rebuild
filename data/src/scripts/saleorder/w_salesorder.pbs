	long ll_code
	boolean lb_listtab
	if wf_iseditable() then
		return 0
	end if
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab = false then
		return 0
	end if
	if this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
		if ll_code > 0 and not isnull(ll_code) then
			openwithparm(w_saleorder_purorder_info, ll_code)
		end if
	end if
	return 0

// w_salesorder.wf_apply_customized_gstperc() returns long
	datastore lds_saledetail
	long ll_detailrows
	long ll_icode
	long ll_custcode
	long ll_counter
	string ls_errortext
	boolean lb_enablesave
	boolean lb_bonus
	double ld_saleprice
	double ld_gstperc
	s_arguements lstr_arg
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.rowcount() > 0 and (this.id_master.object.finalized[1] = "Y" or this.id_master.object.posted[1] = "Y") then
		return 0
	end if
	open(w_arg_gstperc)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = -1 then
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows <= 0 then
		return 0
	end if
	ld_gstperc = lstr_arg.db_code1
	if ld_gstperc < 0.0 or isnull(ld_gstperc) then
		return 0
	end if
	for ll_counter = 1 to ll_detailrows
		this.id_detail.object.gstperc[ll_counter] = ld_gstperc
		ld_saleprice = this.id_detail.object.saleprice[ll_counter]
		this.id_detail.object.saleprice[ll_counter] = round(ld_saleprice * 100.0 / (100.0 + ld_gstperc), 2)
	next
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return 0

// w_salesorder.wf_raise_saleinvoice() returns long
	integer li_errcode
	long ll_usercode
	long ll_invcount
	long ll_counter
	long ll_code
	long ll_saleinvcode
	boolean lb_flag
	string ls_errtext
	s_arguements lstr_arginfo
	if wf_iseditable() = true then
		return 0
	end if
	if this.tab_retrieve.selectedtab = 1 then
		return 0
	end if
	if this.id_list.getrow() > 0 and (this.id_list.object.code[this.id_list.getrow()] > 0 and this.id_list.object.posted[this.id_list.getrow()] = "N") then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
		open(w_salesmanpassword)
		ll_usercode = long(message.doubleparm)
		setfocus()
		if ll_usercode > 0 then
			setpointer(hourglass!)
			SQL rollback USING this.it_transobject;
			li_errcode = wf_locksaleorder(ll_code)
			if li_errcode = 0 then
				this.it_transobject.generatesale_from_saleorder(ll_code, ll_usercode, ll_saleinvcode)
				if this.it_transobject.sqlcode <> 0 then
					ls_errtext = this.it_transobject.sqlerrtext
					li_errcode = -1
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				ls_errtext = this.it_transobject.sqlerrtext
				li_errcode = -1
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
		setpointer(arrow!)
		if li_errcode <> 0 then
			if isnull(ls_errtext) then
				ls_errtext = ""
			end if
			messagebox("Raise Sale Invoice Fails", "Some database request fails, Please try again.~r~nReasons are:- " + ls_errtext)
		else
			messagebox("Raise Sale Invoice Successfull", "Raised Sale Invoice successfully.~r~nSale Invoice Code = " + trim(string(ll_saleinvcode)))
		end if
	end if
	return li_errcode

// w_salesorder.wf_check_stock_availability() returns long
	integer li_errcode
	long ll_usercode
	long ll_invcount
	long ll_counter
	long ll_code
	long ll_saleinvcode
	boolean lb_flag
	string ls_errtext
	s_arguements lstr_arginfo
	if wf_iseditable() = true then
		return 0
	end if
	if this.tab_retrieve.selectedtab = 1 then
		return 0
	end if
	if this.id_list.getrow() > 0 and this.id_list.object.code[this.id_list.getrow()] > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
		openwithparm(w_saleorder_stockavailability, ll_code)
	end if
	return li_errcode

// w_salesorder.wf_setcustomerlatestsaleprice(integer al_custcode, long al_icode, long al_row) returns long
	integer li_rowsaffected
	double ld_saleprice
	if f_stringpreferences("FetchCustomerLatestSalePrice") = "Y" and al_icode > 0 and al_custcode > 19 and al_row > 0 then
		li_rowsaffected = 0
		this.it_transobject.fetchcustomerlatestsaleprice(al_custcode, al_icode, ld_saleprice, li_rowsaffected)
		if this.it_transobject.sqlcode = 0 then
			if li_rowsaffected > 0 then
				this.id_detail.object.saleprice[al_row] = round(ld_saleprice, 2)
			end if
		else
			messagebox("Customer Latest Sale Price Error", "Unable to Fetch Customer Latest Sale Price due to some problem.~r~nDetails Are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
			return -1
		end if
		return 1
	end if
	return 0

// w_salesorder.wf_setcustomerlatestnetrate(long al_custcode, long al_icode, long al_row) returns long
	integer li_rowsaffected
	double ld_netrate
	if f_stringpreferences("ShowCustomerLatestNetRateInFooter") = "Y" and al_icode > 0 and al_custcode > 19 and al_row > 0 then
		li_rowsaffected = 0
		this.it_transobject.fetchcustomerlatestnetrate(al_custcode, al_icode, ld_netrate, li_rowsaffected)
		if this.it_transobject.sqlcode = 0 then
			if li_rowsaffected > 0 then
				this.id_footer.object.latestnetrate[1] = round(ld_netrate, 2)
				this.id_detail.object.latestnetrate[al_row] = round(ld_netrate, 2)
			end if
		else
			messagebox("Customer Latest NetRate Error", "Unable to Fetch Customer Latest Net Rate due to some problem.~r~nDetails Are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
			return -1
		end if
		return 1
	end if
	return 0

// w_salesorder.wf_show_misccharges_breakup() returns long
	double ld_advincometax
	s_values lstr_values
	lstr_values.d_value1 = this.id_footer.object.misccharges1[1]
	lstr_values.d_value2 = this.id_footer.object.misccharges2[1]
	lstr_values.d_value3 = this.id_footer.object.misccharges3[1]
	lstr_values.d_value4 = this.id_footer.object.misccharges4[1]
	lstr_values.d_value5 = this.id_footer.object.misccharges5[1]
	lstr_values.i_status = 1
	openwithparm(w_misccharges_breakup, lstr_values)
	lstr_values = message.powerobjectparm
	if lstr_values.i_status = 1 then
		this.id_footer.object.misccharges1[1] = lstr_values.d_value1
		this.id_footer.object.misccharges2[1] = lstr_values.d_value2
		this.id_footer.object.misccharges3[1] = lstr_values.d_value3
		this.id_footer.object.misccharges4[1] = lstr_values.d_value4
		this.id_footer.object.misccharges5[1] = lstr_values.d_value5
		if this.ic_advancetaxonsale = "Y" then
			ld_advincometax = this.id_footer.object.advancetaxamt[1]
		else
			ld_advincometax = 0.00
		end if
		this.id_footer.object.misccharges[1] = ld_advincometax + lstr_values.d_value1 + lstr_values.d_value2 + lstr_values.d_value3 + lstr_values.d_value4 + lstr_values.d_value5
	end if
	return 0

// w_salesorder.wf_set_misccharges() returns long
	double ld_processingfee
	double ld_netamt
	double ld_misccharges
	double ld_newnetamt
	double ld_advincometax
	ld_netamt = wf_grandtotal()
	ld_misccharges = this.id_footer.object.misccharges[1]
	ld_newnetamt = ld_netamt - ld_misccharges
	if ld_newnetamt < 0.0 or isnull(ld_newnetamt) then
		ld_newnetamt = 0
	end if
	openwithparm(w_set_misccharges, ld_newnetamt)
	ld_processingfee = message.doubleparm
	if ld_processingfee >= 0.0 then
		if this.ic_advancetaxonsale = "Y" then
			ld_advincometax = this.id_footer.object.advancetaxamt[1]
		else
			ld_advincometax = 0.00
		end if
		this.id_footer.object.misccharges5[1] = ld_processingfee
		this.id_footer.object.misccharges[1] = ld_advincometax + this.id_footer.object.misccharges1[1] + this.id_footer.object.misccharges2[1] + this.id_footer.object.misccharges3[1] + this.id_footer.object.misccharges4[1] + ld_processingfee
		this.id_footer.accepttext()
		wf_grandtotal()
	end if
	return 0

// w_salesorder.wf_set_flatdiscount2() returns long
	double ld_disc_with_gst
	double ld_netamt
	double ld_flatdiscamt
	double ld_newnetamt
	if this.id_detail.rowcount() > 0 then
		ld_netamt = this.id_detail.getitemdecimal(1, "c_grossamt")
	else
		ld_netamt = 0.00
	end if
	ld_flatdiscamt = this.id_footer.object.flatdisc[1]
	ld_newnetamt = ld_netamt
	if ld_newnetamt < 0.0 or isnull(ld_newnetamt) then
		ld_newnetamt = 0
	end if
	openwithparm(w_set_flatdiscamt2, ld_newnetamt)
	ld_disc_with_gst = message.doubleparm
	if ld_disc_with_gst >= 0.0 then
		this.id_footer.object.flatdisc[1] = ld_disc_with_gst
		this.id_footer.accepttext()
		wf_grandtotal()
	end if
	return 0

// w_salesorder.wf_set_flatdiscount() returns long
	double ld_disc_with_gst
	double ld_netamt
	double ld_flatdiscamt
	double ld_newnetamt
	ld_netamt = wf_grandtotal()
	ld_flatdiscamt = this.id_footer.object.flatdisc[1]
	ld_newnetamt = ld_netamt + ld_flatdiscamt
	if ld_newnetamt < 0.0 or isnull(ld_newnetamt) then
		ld_newnetamt = 0
	end if
	openwithparm(w_set_flatdiscamt, ld_newnetamt)
	ld_disc_with_gst = message.doubleparm
	if ld_disc_with_gst >= 0.0 then
		this.id_footer.object.flatdisc[1] = ld_disc_with_gst
		this.id_footer.accepttext()
		wf_grandtotal()
	end if
	return 0

// w_salesorder.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_saleordermenu" then
		this.menuid = create m_saleordermenu
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	this.ic_cashdrawerprinter = create ic_cashdrawerprinter
	this.ic_comport = create ic_comport
	this.ic_drawerport = create ic_drawerport
	this.dw_saleinvdetail = create dw_saleinvdetail
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.ic_cashdrawerprinter
	this.control[icurrent + 3] = this.ic_comport
	this.control[icurrent + 4] = this.ic_drawerport
	this.control[icurrent + 5] = this.dw_saleinvdetail

// w_salesorder.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.ic_cashdrawerprinter
	destroy this.ic_comport
	destroy this.ic_drawerport
	destroy this.dw_saleinvdetail

// w_salesorder.ue_save() returns 0 [event]
	datastore lds_groupdiscinfo
	double ld_itemflatdisc
	double ld_unitsalestax
	double ld_itemgstperc
	double ld_invdisc
	double ld_invgstperc
	double ld_itemamount
	double ld_amountdiff
	double ld_advancetaxamt
	double ld_fbrposfee
	double ld_misccharges1
	double ld_misccharges2
	double ld_misccharges3
	double ld_misccharges4
	double ld_misccharges5
	double ld_clonesaleprice
	boolean lb_validdisc
	long ll_detailrows
	long ll_counter2
	long ll_mastercurrrow
	long ll_choice
	long ll_footercurrrow
	long ll_invid
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode
	long ll_gcode
	long ll_headerno
	long ll_headerinvno
	long ll_counter
	long ll_count
	long ll_null
	long ll_modifycount
	long ll_lastinvcode
	long l_customerallowed
	long ll_found
	long ll_ordercode
	long li_orderretcode
	long ll_custcode
	boolean lb_commitflag
	boolean lb_continue
	integer li_counter
	integer li_filehandle
	integer li_maxretcode
	string ls_errtext
	string ls_holdstring
	string ls_drawermessage
	string ls_askuserpwd
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_invamount
	double ld_cashtended
	double ld_cashbalance
	double ld_invgstperc1
	double ld_price
	double ld_balance
	s_salesman lstr_salesman
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	datetime ldt_server_datetime
	string ls_date_errtext
	datawindowchild ldc_headerno
	string ls_lockdiscperc
	string ls_itemname
	string ls_messagetext
	string ls_env_name
	string ls_env_val
	long ll_env_len
	if this.tab_retrieve.selectedtab = 2 then
		return
	end if
	if wf_iseditable() = false then
		return
	end if
	this.ib_lcdshow = false
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if this.ii_saletype = 2 and this.id_master.getitemnumber(this.id_master.getrow(), "custcode") = 19.0 then
		messagebox("Customer Validation!", "Cash Sale Walking Customer is not allowed in Credit Sales")
		this.id_master.setcolumn("custcode")
		this.id_master.setfocus()
		return
	end if
	if this.id_detail.rowcount() < 1 then
		messagebox("Rows Validation", "Please insert a row before proceeding")
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	ll_custcode = this.id_master.getitemnumber(this.id_master.rowcount(), "custcode")
	this.il_custcode = ll_custcode
	this.il_allowedcustomer = ll_custcode
	if f_stringpreferences("SaleOnZeroPrice") = "N" then
		ll_found = this.id_detail.find("saleprice = 0 OR ISNull(saleprice)", 1, this.id_detail.rowcount())
		if ll_found > 0 then
			messagebox("Price Validation", "SalePrice is Zero in Row " + string(ll_found))
			this.id_detail.setfocus()
			this.id_detail.scrolltorow(ll_found)
			this.id_detail.setcolumn("SalePrice")
			return
		end if
		return
	end if
	ll_found = this.id_detail.find("looseqty + bonusqty <= 0 ", 1, this.id_detail.rowcount())
	if ll_found > 0 and ll_found <= this.id_detail.rowcount() then
		ll_choice = messagebox("Sale Qty Validation", "There are some row(s) with invalid sale qty in current sale order. Do you wish to remove them automatically?", question!, yesnocancel!, 2)
		if ll_choice = 1 then
			ll_found = this.id_detail.find("looseqty + bonusqty <= 0 ", 1, this.id_detail.rowcount())
			do while ll_found > 0 and ll_found <= this.id_detail.rowcount()
				this.id_detail.deleterow(ll_found)
				ll_found = this.id_detail.find("looseqty + bonusqty <= 0 ", 1, this.id_detail.rowcount())
			loop
		elseif ll_choice = 3 then
			return
		end if
		return
	end if
	ll_found = this.id_detail.find("looseqty + bonusqty <= 0 ", 1, this.id_detail.rowcount())
	if ll_found > 0 then
		messagebox("Sale Qty Validation", "Please Enter Valid Sale Qty in Row " + string(ll_found))
		this.id_detail.setfocus()
		this.id_detail.scrolltorow(ll_found)
		this.id_detail.setcolumn("looseqty")
		return
	end if
	if f_stringpreferences("ApplyAssociatedQuotationInSO") = "Y" and wf_apply_associated_quotation(1) <= 0 then
		messagebox("Customer Associated Quotation", "Problem in using associated quotation")
		return
	end if
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	wf_grandtotal()
	this.id_footer.accepttext()
	this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
	this.is_lcditem = "Total = " + string(wf_grandtotal(), "########0.00")
	if f_stringpreferences("DisplayPool") = "Y" then
		this.ic_comport.triggerevent("ue_show")
	end if
	ld_invdiscperc = this.id_footer.getitemnumber(1, "invdiscperc")
	ld_flatdisc = this.id_footer.getitemnumber(1, "flatdisc")
	ls_messagetext = ""
	if ld_invdiscperc > 0.0 or ld_flatdisc > 0.0 then
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT lockdiscperc , name INTO :ls_lockdiscperc, :ls_itemname FROM Item WHERE item.icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode < 0 then
				messagebox("Connection Error", "Unable to get item information " + this.it_transobject.sqlerrtext)
				return
			end if
			if ls_lockdiscperc = "Y" then
				ls_messagetext = ls_messagetext + "Row NO=" + string(ll_counter) + " , itemname=" + ls_itemname + "~r~n"
			end if
		next
	end if
	if ls_messagetext <> "" then
		messagebox("Item Validation", "Due to item LockSaleDisc% setting Please remove following items~r~n" + ls_messagetext + "~r~nOR~r~nSet invoice level discount to zero")
		return
	end if
	if this.id_master.getitemstring(this.id_master.getrow(), "finalized") = "N" then
		wf_setamountoninvoice()
	end if
	ls_askuserpwd = "AskUserPwdInSaleOrder"
	if f_stringpreferences(ls_askuserpwd) = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if wf_check_creditlimit(ll_custcode, ll_salesmancode, 1) > 0 then
			return
		end if
		lds_groupdiscinfo = create datastore
		lds_groupdiscinfo.dataobject = "d_groups_discount"
		lds_groupdiscinfo.settransobject(this.it_transobject)
		lds_groupdiscinfo.retrieve(ll_salesmancode)
		ld_invdiscperc = this.id_footer.getitemnumber(1, "invdiscperc")
		ld_flatdisc = this.id_footer.getitemnumber(1, "flatdisc")
		for ll_counter = 1 to lds_groupdiscinfo.rowcount()
			if ld_flatdisc <= lds_groupdiscinfo.getitemnumber(ll_counter, "saleinvflatdisc") then
				lb_validdisc = true
			end if
		next
		if lb_validdisc = false then
			messagebox("Flat Discount Validation", "Flat Discount is greater than your permission~r~n Please consult Administrator")
			this.id_footer.setfocus()
			this.id_footer.setcolumn("flatdisc")
			destroy lds_groupdiscinfo
			return
		end if
		for ll_counter = 1 to this.id_detail.rowcount()
			ld_saleprice = this.id_detail.getitemnumber(ll_counter, "saleprice")
			ld_discperc = this.id_detail.getitemnumber(ll_counter, "discperc")
			ld_itemflatdisc = this.id_detail.getitemnumber(ll_counter, "itemflatdisc")
			ld_unitsalestax = this.id_detail.getitemnumber(ll_counter, "unitsalestax")
			ld_itemgstperc = this.id_detail.getitemnumber(ll_counter, "gstperc")
			ld_invdisc = this.id_footer.getitemnumber(1, "invdiscperc")
			ld_invgstperc = this.id_footer.getitemnumber(1, "invgstperc1")
			ld_avgprice = this.id_detail.getitemnumber(ll_counter, "avgprice")
			ld_itemamount = round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2) - round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2) * ld_invdiscperc * 0.01 + ld_unitsalestax + round(round((ld_saleprice - ld_itemflatdisc) * (1.0 - ld_discperc * 0.01), 2) * ld_itemgstperc * 0.01, 2)
			if f_stringpreferences("saleavgpricecheck") = "N" and ld_avgprice > ld_itemamount then
				messagebox("Price Validation", "Sale Price become less than AvgPrice~r~nPlease change Sale Price or Setting In Preferences")
				this.id_detail.setrow(ll_counter)
				destroy lds_groupdiscinfo
				return
			end if
			lb_validdisc = false
			for ll_counter2 = 1 to lds_groupdiscinfo.rowcount()
				ld_amountdiff = ld_saleprice - ld_itemamount
				ld_clonesaleprice = ld_saleprice
				if ld_clonesaleprice = 0.0 then
					ld_clonesaleprice = 1
				end if
				if ld_amountdiff * 100.0 / ld_clonesaleprice <= lds_groupdiscinfo.getitemnumber(ll_counter2, "saleitemdiscperc") then
					lb_validdisc = true
				end if
			next
			if lb_validdisc = false then
				messagebox("Disc% Validation", "Disc% is greater than your permission~r~n Please consult Administrator")
				this.id_detail.setfocus()
				this.id_detail.setrow(ll_counter)
				this.id_detail.setcolumn("itemname")
				destroy lds_groupdiscinfo
				return
			end if
		next
		destroy lds_groupdiscinfo
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_custcode = this.id_master.getitemnumber(ll_mastercurrrow, "custcode")
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if isnull(ll_invid) then
			li_maxretcode = wf_tabnewid("saleorderheader", ll_invid)
			if li_maxretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~n ~t~t~t~t~t~t~t~t~t~t~t~t~tgenerating InvCode")
				return
			end if
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
		end if
		ll_ordercode = this.id_master.getitemnumber(ll_mastercurrrow, "ordercode")
		if isnull(ll_ordercode) or ll_ordercode = 0 then
			li_orderretcode = wf_gen_saleordercode(this.ii_socatcode, ll_ordercode, this.it_transobject)
			if li_orderretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~n ~t~t~t~t~t~t~t~t~t~t~t~t~tgenerating Sale Order Code")
				return
			end if
			if ll_ordercode > 0 then
				this.id_master.setitem(ll_mastercurrrow, "ordercode", ll_ordercode)
			end if
		end if
		this.id_master.getchild("headerno", ldc_headerno)
		if f_stringpreferences("Headeronsaleinv") = "N" then
			this.id_master.setitem(ll_mastercurrrow, "Headerno", ldc_headerno.getitemnumber(ll_mastercurrrow, "code"))
			ll_headerno = ldc_headerno.getitemnumber(ll_mastercurrrow, "code")
			ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
			if isnull(ll_headerinvno) then
				f_generateheaderinvcode(ll_headerno, 12, ll_headerinvno)
				if ll_headerinvno > 0 then
					this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
				end if
			end if
		end if
		if f_stringpreferences("Headeronsaleinv") = "Y" or gs_company = "SA" or gs_company = "EPP" then
			ll_headerno = this.id_master.getitemnumber(ll_mastercurrrow, "headerno")
			ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
			if isnull(ll_headerinvno) then
				f_generateheaderinvcode(ll_headerno, 12, ll_headerinvno)
				if ll_headerinvno > 0 then
					this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
				end if
			end if
		end if
		ld_misccharges = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges")
		ld_misccharges1 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges1")
		ld_misccharges2 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges2")
		ld_misccharges3 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges3")
		ld_misccharges4 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges4")
		ld_misccharges5 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges5")
		ld_invdiscperc = this.id_footer.getitemnumber(ll_footercurrrow, "invdiscperc")
		ld_flatdisc = this.id_footer.getitemnumber(ll_footercurrrow, "flatdisc")
		ld_invgstperc1 = this.id_footer.getitemnumber(ll_footercurrrow, "InvGSTPerc1")
		ld_advancetaxamt = this.id_footer.getitemnumber(ll_footercurrrow, "advancetaxamt")
		this.id_master.setitem(ll_mastercurrrow, "discperc", ld_invdiscperc)
		this.id_master.setitem(ll_mastercurrrow, "flatdisc", ld_flatdisc)
		this.id_master.setitem(ll_mastercurrrow, "misccharges", ld_misccharges)
		this.id_master.setitem(ll_mastercurrrow, "InvGSTPerc1", ld_invgstperc1)
		this.id_master.setitem(ll_mastercurrrow, "advancetaxamt", ld_advancetaxamt)
		this.id_master.object.misccharges1[ll_mastercurrrow] = ld_misccharges1
		this.id_master.object.misccharges2[ll_mastercurrrow] = ld_misccharges2
		this.id_master.object.misccharges3[ll_mastercurrrow] = ld_misccharges3
		this.id_master.object.misccharges4[ll_mastercurrrow] = ld_misccharges4
		this.id_master.object.misccharges5[ll_mastercurrrow] = ld_misccharges5
		ls_env_name = "COMPUTERNAME"
		ls_env_val = space(20)
		ll_env_len = 20
		ll_env_len = getenvironmentvariablea(ls_env_name, ls_env_val, ll_env_len)
		this.id_master.setitem(ll_mastercurrrow, "machinename", ls_env_val)
		if this.ii_saletype = 3 and lstr_salesman.l_custcode > 19 then
			this.id_master.setitem(1, "custcode", lstr_salesman.l_custcode)
			this.ib_printout = false
			this.id_master.accepttext()
		end if
		if f_stringpreferences("autofinalizesaleorder") = "N" then
			this.id_master.object.finalized[1] = "N"
		else
			this.id_master.object.finalized[1] = "Y"
		end if
		if f_stringpreferences("AutoPostSaleOrder") = "N" then
			this.id_master.setitem(ll_mastercurrrow, "Posted", "N")
		else
			this.id_master.setitem(ll_mastercurrrow, "Posted", "Y")
			this.id_master.setitem(ll_mastercurrrow, "Finalized", "Y")
		end if
		if this.ib_modify then
			ll_modifycount = this.id_master.getitemdecimal(ll_mastercurrrow, "modifycounter")
			if isnull(ll_modifycount) then
				ll_modifycount = 0
			end if
			this.id_master.setitem(ll_mastercurrrow, "modifycounter", ll_modifycount + 1)
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.idt_server_datetime = ldt_server_datetime
			if wf_deletesaleinvoice(ll_invid) <> 0 then
				lb_continue = false
			end if
		else
			this.id_master.setitem(ll_mastercurrrow, "usercode", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.idt_server_datetime = ldt_server_datetime
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
		end if
		if this.id_master.getitemnumber(ll_mastercurrrow, "amt") <> 0.0 and not isnull(this.id_master.getitemnumber(ll_mastercurrrow, "amt")) then
			this.id_master.setitem(ll_mastercurrrow, "amtby", ll_salesmancode)
			this.id_master.setitem(ll_mastercurrrow, "amtdate", ldt_server_datetime)
		end if
		if lb_continue then
			this.id_saleinvdetail.reset()
			if not wf_populatesaledetail(ll_invid, this.id_saleinvdetail, ls_errtext, ll_errrowid) then
				lb_continue = false
				this.id_detail.scrolltorow(ll_errrowid)
				this.id_detail.setfocus()
			else
				this.id_detail = this.id_saleinvdetail
				call super::ue_save
				this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
				this.id_saleinvdetail.reset()
				if this.ib_commitok then
					this.ib_modify = false
				elseif this.ib_modify = false then
					setnull(ll_null)
					this.id_master.setitem(1, "Code", ll_null)
					this.id_master.accepttext()
				end if
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			if this.ib_modify = false then
				setnull(ll_null)
				this.id_master.setitem(1, "Code", ll_null)
				this.id_master.accepttext()
			end if
			messagebox("Updation Error", ls_errtext + " in current row", stopsign!)
		elseif f_stringpreferences("IncSOInActMonitor") = "Y" then
			this.it_transobject.updateactivitymonitor("SO", ll_invid)
			if this.it_transobject.sqlcode <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
			else
				SQL commit USING this.it_transobject;
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_salesorder.ue_newform() returns 0 [event]
	integer rtncode
	integer li_defaultgcode
	integer li_ismodifysaleprice
	integer li_ismodifyitemdiscperc
	integer li_ismodifyitemflatdisc
	integer li_modifysalestax
	integer li_viewstock
	integer li_viewtotalstock
	long li_fetched_code
	long row
	long ll_manfcode
	long ll_counter
	long ll_custcode
	double ld_invdiscperc
	datetime ldt_server_datetime
	string ls_date_errtext
	m_saleordermenu lm_menu
	call super::ue_newform
	lm_menu = this.menuid
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.il_norcotixcode = -1
	this.im_menu.m_file.m_print.enabled = true
	lm_menu.m_file.m_postwrtpatient.enabled = false
	lm_menu.m_file.m_postsaleheaderwise.enabled = false
	lm_menu.m_file.m_deletesaleinvoice.enabled = false
	lm_menu.m_file.m_finalizesaleorders.enabled = false
	lm_menu.m_file.m_finalizesaleorders.toolbaritemvisible = false
	wf_protectdw(this.id_master, 0)
	this.id_detail.setredraw(false)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.id_detail.setredraw(true)
	this.ib_modify = false
	wf_setgodownoption()
	li_ismodifysaleprice = 1
	li_ismodifyitemdiscperc = 1
	li_ismodifyitemflatdisc = 1
	li_modifysalestax = 1
	li_viewstock = 0
	li_viewtotalstock = 0
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 511 then
			li_ismodifysaleprice = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 516 then
			li_ismodifyitemdiscperc = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 517 then
			li_ismodifyitemflatdisc = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 520 then
			li_modifysalestax = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 535 then
			li_viewstock = 1
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 536 then
			li_viewtotalstock = 1
		end if
	next
	this.id_footer.object.t_stock.visible = li_viewstock
	this.id_footer.object.stock.visible = li_viewstock
	this.id_footer.object.t_totalstock.visible = li_viewtotalstock
	this.id_footer.object.totalstock.visible = li_viewtotalstock
	this.id_detail.object.saleprice.protect = li_ismodifysaleprice
	this.id_master.object.headerno.protect = 0
	this.id_detail.object.discperc.protect = li_ismodifyitemdiscperc
	this.id_detail.object.itemflatdisc.protect = li_ismodifyitemflatdisc
	this.id_detail.object.unitsalestax.protect = li_modifysalestax
	this.id_detail.object.gstperc.protect = li_modifysalestax
	if not wf_validatedate() then
		close(this)
	else
		if this.ii_saletype = 3 then
			ll_custcode = this.id_master.getitemnumber(1, "custcode")
			SQL Select invdiscperc INTO :ld_invdiscperc From Customer Where custcode =:ll_custcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
			end if
			post event ue_enforcedefaultfocussettings()
		else
			this.id_master.setfocus()
			post event ue_enforcedefaultfocussettings()
		end if
		wf_visible(true)
	end if
	this.id_master.object.advancetax[1] = this.ic_advancetaxonsale
	if f_stringpreferences("DisplayPool") = "Y" then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
			setnull(this.is_lcditem)
			this.ic_comport.triggerevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
			setnull(this.is_lcditem)
			this.ic_comport.triggerevent("ue_show")
		end if
	end if
	this.ib_lcdshow = true
	this.ii_focuscustomer = 2
	if this.ib_modifydate then
		if this.ib_fetchserverdate then
			wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
			this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
		else
			this.id_master.setitem(this.id_master.getrow(), "date", today())
		end if
	end if
	this.il_custcode = 0
	this.il_allowedcustomer = 0

// w_salesorder.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect
	integer li_ismodifysaleprice
	integer li_ismodifyitemdiscperc
	integer li_ismodifyitemflatdisc
	integer li_modifysalestax
	integer li_modifyheaderno
	long ll_row
	long ll_code
	long ll_counter
	long ll_admissioncode
	long ll_allowed
	long ll_custcode
	boolean lb_flag
	boolean lb_modify
	m_saleordermenu lm_menu
	long ll_rowcount
	long ll_validinv
	double ld_code
	lm_menu = this.menuid
	this.tab_retrieve.tabpage_list.em_invno.getdata(ld_code)
	if ld_code = 0.0 then
		ld_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	else
		SQL select count ( *) INTO :ll_validinv from SaleOrderHeader where saleordercode =:ld_code USING this.it_transobject;
		if ll_validinv <> 1 then
			this.id_detail.reset()
			messagebox("Invoice Validation", "Sale Order does not exist")
			this.tab_retrieve.selecttab(2)
			return
		end if
	end if
	if wf_isdeleted(ld_code) = true then
		messagebox("Invoice Validation", "Can not Modify Deleted Sales Order")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if wf_isinvoiceinuse(ld_code) = true then
		messagebox("Invoice Validation", "Sale Order already in use by some other user.~r~nKindly try again after sometime or open some other Sale Order.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if this.id_dwcontrol.borderstyle.posted[this.il_selectedrow] = "N" and wf_allowsalemodification(ld_code, this.il_groupcode, this.il_strategy) <> 0 then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "You Can not modify this Sale Order,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if f_stringpreferences("GroupCustomerCategory") = "Y" and this.ii_saletype = 2 then
		SQL Select custcode INTO :ll_custcode From SaleOrderHeader Where SaleOrderCode =:ld_code USING sqlca;
		ll_allowed = 0
		this.it_transobject.isallowedcustomergroupcategory(this.il_groupcode, ll_custcode, ll_allowed)
		if this.it_transobject.sqlcode = 0 then
			if ll_allowed < 1 then
				this.id_detail.reset()
				messagebox("Group Customer Category Validation", "Current user group does not have enough permissions w.r.t customers~r~n" + "to open the selected invoice.~r~nPossible reasons are selected invoice customer has customer cateogry ~r~n which is not allowed to this user group.")
				wf_selectunselectrow(1)
				this.tab_retrieve.selecttab(2)
				return
			end if
		end if
	end if
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.im_menu.m_file.m_print.enabled = true
	this.i_editmode = 2
	this.i_retrievemode = 2
	this.id_dwcontrol = this.id_master
	ll_rowcount = wf_retrieve(ld_code)
	this.id_master.setrow(1)
	this.id_master.scrolltorow(1)
	this.id_dwcontrol = this.id_footer
	wf_retrieve(ld_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	this.id_dwcontrol = this.id_detail
	wf_retrieve(ld_code)
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	this.id_dwcontrol = this.id_list
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	lm_menu.m_file.m_finalizesaleorders.enabled = false
	lm_menu.m_file.m_finalizesaleorders.toolbaritemvisible = false
	lm_menu.m_file.m_postwrtpatient.enabled = false
	lm_menu.m_file.m_postsaleheaderwise.enabled = false
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		lb_modify = true
	end if
	if lb_modify then
		li_protect = 0
		wf_initmodify(li_protect)
		if this.ii_saletype = 3 then
			if f_stringpreferences("itemcode") = "Y" then
				this.id_detail.setcolumn("fullcode")
				this.id_detail.setfocus()
			else
				this.id_detail.setcolumn("itemname")
				this.id_detail.setfocus()
			end if
		end if
	else
		this.im_menu.m_file.m_save.enabled = false
		this.editflag = false
	end if
	if this.id_master.getitemstring(this.id_master.getrow(), "Finalized") = "Y" and this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		wf_protectdw(this.id_master, 1)
		wf_protectdw(this.id_detail, 1)
		wf_protectdw(this.id_footer, 1)
		this.id_detail.object.saleorderitemstatuscode.protect = 0
		this.id_detail.object.remarks.protect = 0
		lm_menu.m_item.m_newitem.enabled = false
		lm_menu.m_item.m_deleteitem.enabled = false
	elseif this.id_master.getitemstring(this.id_master.getrow(), "Finalized") = "N" and this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		wf_protectdw(this.id_master, 0)
		wf_protectdw(this.id_detail, 0)
		wf_protectdw(this.id_footer, 0)
		lm_menu.m_item.m_newitem.enabled = true
		lm_menu.m_item.m_deleteitem.enabled = true
	else
		wf_protectdw(this.id_master, li_protect)
		wf_protectdw(this.id_detail, li_protect)
		wf_protectdw(this.id_footer, li_protect)
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_salegodown
	end if
	wf_setgodownoption()
	this.il_custcode = this.id_master.getitemnumber(1, "custcode")
	if li_protect = 0 then
		li_ismodifysaleprice = 1
		li_ismodifyitemdiscperc = 1
		li_ismodifyitemflatdisc = 1
		li_modifysalestax = 1
		li_modifyheaderno = 1
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 511 then
				li_ismodifysaleprice = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 516 then
				li_ismodifyitemdiscperc = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 517 then
				li_ismodifyitemflatdisc = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 520 then
				li_modifysalestax = 0
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 557 then
				li_modifyheaderno = 0
			end if
		next
		if not (this.id_master.getitemstring(this.id_master.getrow(), "Finalized") = "Y" and this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N") then
			this.id_detail.object.saleprice.protect = li_ismodifysaleprice
			this.id_detail.object.discperc.protect = li_ismodifyitemdiscperc
			this.id_detail.object.itemflatdisc.protect = li_ismodifyitemflatdisc
			this.id_detail.object.unitsalestax.protect = li_modifysalestax
			this.id_detail.object.gstperc.protect = li_modifysalestax
			this.id_master.object.headerno.protect = li_modifyheaderno
		end if
	end if
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	wf_grandtotal()
	lm_menu.m_file.m_deletesaleinvoice.enabled = false
	if this.id_master.object.posted[1] = "Y" then
		this.editflag = false
	end if
	setredraw(true)

// w_salesorder.ue_newitem() returns 0 [event]
	integer li_defaultgcode
	long ll_rowcount
	setnull(this.is_aliasname)
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	if f_stringpreferences("AutoSelectLastGodownInSale") = "Y" and this.id_detail.rowcount() > 0 then
		this.id_detail.object.gcode.initial = string(this.id_detail.object.gcode[this.id_detail.rowcount()])
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true
	this.ii_defaultgcode = this.ii_salegodown

// w_salesorder.ue_deleteitem() returns 0 [event]
	long ll_row
	long ll_footerrow
	long ll_currow
	long ll_detailrows
	this.ib_itemvalidated = true
	this.id_detail.deleterow(0)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows < 1 then
		this.im_menu.m_file.m_save.enabled = false
	end if
	wf_grandtotal()
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() > 0 then
		this.id_footer.setitem(ll_footerrow, "icode", this.id_detail.getitemnumber(ll_row, "icode"))
		this.id_footer.setitem(ll_footerrow, "stock", this.id_detail.getitemnumber(ll_row, "stock"))
		return
	end if
	this.id_footer.setitem(ll_footerrow, "icode", 0)
	this.id_footer.setitem(ll_footerrow, "stock", 0)
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_save.enabled = false

// w_salesorder.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	if f_stringpreferences("DisplayPool") = "Y" then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
			this.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
			postevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
			this.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
			this.ic_comport.triggerevent("ue_show")
		else
			this.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
			this.ic_comport.triggerevent("ue_show")
		end if
	end if
	return 1

// w_salesorder.ue_list() returns 0 [event]
	long ll_row
	m_saleordermenu lm_menu
	call super::ue_list
	lm_menu = this.menuid
	SQL rollback USING this.it_transobject;
	if this.ib_cashsaleposting and this.ii_saletype = 3 then
		this.im_menu.m_file.m_post.enabled = true
	elseif this.ib_creditsaleposting and this.ii_saletype = 2 then
		this.im_menu.m_file.m_post.enabled = true
	else
		this.im_menu.m_file.m_post.enabled = false
	end if
	this.im_menu.m_file.m_print.enabled = false
	lm_menu.m_file.m_finalizesaleorders.enabled = true
	lm_menu.m_file.m_finalizesaleorders.toolbaritemvisible = true
	lm_menu.m_file.m_postwrtpatient.enabled = true
	lm_menu.m_file.m_postsaleheaderwise.enabled = true
	lm_menu.m_file.m_deletesaleinvoice.enabled = true
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	this.tab_retrieve.tabpage_list.em_invno.selecttext(1, 7)
	this.tab_retrieve.tabpage_list.em_invno.clear()
	this.il_norcotixcode = -1
	ll_row = wf_retrievelist()
	wf_disabledetailtab(ll_row)
	post event ue_enableprint()
	this.editflag = false
	this.im_menu.m_file.m_save.enabled = false

// w_salesorder.ue_print() returns 0 [event]
	long ll_custcode
	long ll_row
	long ll_invcode
	long ll_counter
	string ls_custname
	string ls_posted
	string ls_invoicesize
	integer li_option
	integer li_reprintingcounter
	double ld_balance
	boolean lb_listtab
	s_datastore lstr
	string ls_printer
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save sale order", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
			else
				event ue_newitem()
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
		if wf_isdeleted(ll_invcode) = true then
			messagebox("Selection Validation", "Can not print deleted sales order~r~nPlease select a valid sales order")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	SQL SELECT ISNULL ( reprintingcounter , 0 ) , invoicesize INTO :li_reprintingcounter, :ls_invoicesize FROM saleorderheader WHERE saleordercode =:ll_invcode USING this.it_transobject;
	if not lb_listtab then
		li_reprintingcounter = li_reprintingcounter + 1
		SQL update SaleOrderHeader SET ReprintingCounter =:li_reprintingcounter WHERE saleordercode =:ll_invcode USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Database Error", "Some database problem has occur")
		SQL rollback USING this.it_transobject;
		return
	else
		SQL commit USING this.it_transobject;
	end if
	if this.ii_saletype = 2 then
		this.ib_printout = false
	end if
	wf_selectprintreport(ls_invoicesize)
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		else
			li_reprintingcounter = li_reprintingcounter + 1
			SQL update SaleOrderHeader SET ReprintingCounter =:li_reprintingcounter WHERE saleordercode =:ll_invcode USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Database Error", "Some database problem has occur during updation of reprinting counter.")
				SQL rollback USING this.it_transobject;
				return
			else
				SQL commit USING this.it_transobject;
			end if
		end if
	end if
	if f_stringpreferences("saleaskforcopies") = "Y" then
		open(w_printer_copies)
		this.id_print.object.datawindow.print.copies = string(message.doubleparm)
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		elseif f_stringpreferences("CashDrawerWithPrinter") = "Y" and lb_listtab = false then
			ls_printer = f_stringpreferences("CashDrawerPrinter")
			if ls_printer = "" or isnull(ls_printer) then
				messagebox("Cash Drawer Printer", "Cash Drawer Printer name not found.~r~nSuggested Option is check Cash Drawer Printer name in Preferences.")
			else
				this.ic_cashdrawerprinter.object.__invoke_method("opendrawer", 4, {ls_printer, 10, "Control", 65}, true)
			end if
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_salesorder.ue_refreshddw() returns 0 [event]
	long ll_prow
	long ll_pcode
	call super::ue_refreshddw
	if this.ii_saletype <> 3 then
		setpointer(hourglass!)
		this.idc_customers.setredraw(false)
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.retrieve()
		this.idc_customers.setredraw(true)
		setpointer(arrow!)
	end if
	this.idc_doctors.setredraw(false)
	this.idc_doctors.settransobject(this.it_transobject)
	this.idc_doctors.retrieve()
	this.idc_doctors.setredraw(true)
	this.idc_patient.setredraw(false)
	this.idc_patient.settransobject(this.it_transobject)
	this.idc_patient.retrieve(this.ii_saleordermodule)
	ll_prow = this.idc_patient.insertrow(0)
	setnull(ll_pcode)
	this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
	this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
	this.idc_patient.setitem(ll_prow, "name", "<NONE>")
	this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
	this.idc_patient.setitem(ll_prow, "city", "<NONE>")
	this.idc_patient.scrolltorow(ll_prow)
	this.idc_patient.setredraw(true)

// w_salesorder.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_salesorder.ue_postopen() returns 0 [event]
	datawindowchild ldc_headerno
	m_saleordermenu lm_menu
	integer li_rtncode
	integer li_defaultgodown
	integer i
	long ll_counter
	long ll_pos
	long ll_prow
	long ll_pcode
	long ll_found
	integer li_defaultsaleprice
	integer li_defaultitemdiscperc
	string ls_custfilterstring
	datastore lds_headers
	s_arguements lstr_arg
	datastore lds_listsetting
	call super::ue_postopen
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	lm_menu = this.menuid
	setredraw(false)
	wf_setsaletype(2)
	lstr_arg = message.powerobjectparm
	this.ii_socatcode = lstr_arg.l_code1
	this.id_print = this.dw_saleinvrep
	this.id_saleinvdetail = this.dw_saleinvdetail
	this.id_saleinvdetail.settransobject(this.it_transobject)
	this.title = "Sale Order: " + lstr_arg.s_name1
	choose case this.ii_saletype
	case 2
		wf_assigndatawindowobjects("d_saleorderheader", "d_saleorderdetail", "d_SaleOrderFooter", "d_SaleOrderInvlist", "d_saleorderprint_quarter")
		if gs_company = "CMH" or gs_company = "NM" or gs_company = "FZGUL" then
			this.id_master.object.custrefno.editmask.mask = "########0"
			this.id_master.object.custrefno.editmask.required = true
		end if
		if f_stringpreferences("InSaleCustomerBalance") = "Y" then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
			this.ids_customersbalance = create datastore
			this.ids_customersbalance.dataobject = "d_customerbalances_in_sales"
			this.ids_customersbalance.settransobject(sqlca)
			this.ids_customersbalance.retrieve()
		else
			this.id_master.object.debitorcredit.visible = false
			this.id_master.object.customerbalance.visible = false
			this.id_master.object.t_balance.visible = false
		end if
		li_rtncode = this.id_master.getchild("custcode", this.idc_customers)
		if li_rtncode = -1 then
			messagebox("Error!", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.retrieve()
		if f_stringpreferences("GroupCustomerCategory") = "Y" then
			this.il_groupcode = f_getgroupcode(gl_usercode)
			ls_custfilterstring = "0                                                                                                                                                                                                             "
			this.it_transobject.getallowedgroupcustomercategory(this.il_groupcode, ls_custfilterstring)
			if ls_custfilterstring = " " or ls_custfilterstring = "" or isnull(ls_custfilterstring) then
				ls_custfilterstring = "0"
				messagebox("Group Customer Category Validation", "Current user group does not have enough permissions w.r.t customer to make sale.~r~nIn order to make sale kindly assign customer categories to this user group ~r~n using Group Customer Category module.~r~nOR~r~nDisable Group Customer Category from Preferences.")
				close(this)
				return
			end if
			this.idc_customers.setfilter("custcatcode In (" + ls_custfilterstring + ") and accounts_acccode <> 19")
			this.idc_customers.filter()
		else
			this.idc_customers.setfilter("accounts_acccode <> 19")
			this.idc_customers.filter()
		end if
		this.id_master.object.custcode.initial = "0"
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 501 then
				this.ib_creditsaleposting = true
				this.im_menu.m_file.m_post.visible = true
				this.im_menu.m_file.m_post.toolbaritemvisible = true
				this.im_menu.m_file.m_post.enabled = false
				lm_menu.m_file.m_finalizesaleorders.visible = true
				lm_menu.m_file.m_finalizesaleorders.toolbaritemvisible = true
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 556 then
				lm_menu.m_file.m_postsaleheaderwise.visible = true
				lm_menu.m_file.m_postsaleheaderwise.enabled = false
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 503 then
				this.ib_creditmodify = true
			end if
		next
		if not this.ib_creditsaleposting then
			this.im_menu.m_file.m_post.visible = false
			this.im_menu.m_file.m_post.toolbaritemvisible = false
			this.im_menu.m_file.m_post.enabled = false
			lm_menu.m_file.m_finalizesaleorders.visible = true
			lm_menu.m_file.m_finalizesaleorders.toolbaritemvisible = true
		end if
		li_rtncode = this.id_master.getchild("patientcode", this.idc_patient)
		if li_rtncode = -1 then
			messagebox("Error!!", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_patient.settransobject(this.it_transobject)
		this.idc_patient.retrieve(this.ii_saleordermodule)
		ll_prow = this.idc_patient.insertrow(0)
		setnull(ll_pcode)
		this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
		this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
		this.idc_patient.setitem(ll_prow, "name", "<NONE>")
		this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
		this.idc_patient.setitem(ll_prow, "city", "<NONE>")
		this.idc_patient.scrolltorow(ll_prow)
		if f_stringpreferences("patientOnCreditSale") = "N" then
			this.id_master.object.patientcode.visible = false
			this.id_master.object.t_regno.visible = false
			this.id_master.object.t_patient.visible = false
			this.id_master.object.patientregno.visible = false
		end if
	case 3
		wf_assigndatawindowobjects("d_saleorderheader", "d_saleorderdetail", "d_SaleOrderFooter", "d_SaleOrderInvlist", "d_SaleOrder_quarter")
		this.it_transobject.getglobalcode("GT_RetailSaleCustomerACC", this.il_code)
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 500 then
				this.ib_cashsaleposting = true
				this.im_menu.m_file.m_post.visible = true
				this.im_menu.m_file.m_post.toolbaritemvisible = true
				this.im_menu.m_file.m_post.enabled = false
				lm_menu.m_file.m_finalizesaleorders.visible = true
				lm_menu.m_file.m_finalizesaleorders.toolbaritemvisible = true
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 502 then
				this.ib_retailmodify = true
			end if
		next
		if not this.ib_cashsaleposting then
			this.im_menu.m_file.m_post.visible = false
			this.im_menu.m_file.m_post.toolbaritemvisible = false
			this.im_menu.m_file.m_post.enabled = false
			lm_menu.m_file.m_finalizesaleorders.visible = true
			lm_menu.m_file.m_finalizesaleorders.toolbaritemvisible = true
		end if
		li_rtncode = this.id_master.getchild("patientcode", this.idc_patient)
		if li_rtncode = -1 then
			messagebox("Error!!!", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_patient.settransobject(this.it_transobject)
		this.idc_patient.retrieve(this.ii_saleordermodule)
		ll_prow = this.idc_patient.insertrow(0)
		setnull(ll_pcode)
		this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
		this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
		this.idc_patient.setitem(ll_prow, "name", "<NONE>")
		this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
		this.idc_patient.setitem(ll_prow, "city", "<NONE>")
		this.idc_patient.scrolltorow(ll_prow)
		if f_stringpreferences("patientOnRetailSale") = "N" then
			this.id_master.object.patientcode.visible = false
			this.id_master.object.t_regno.visible = false
			this.id_master.object.t_patient.visible = false
			this.id_master.object.patientregno.visible = false
		end if
		SQL SELECT defaultsaleprice , defaultitemdiscperc INTO :li_defaultsaleprice, :li_defaultitemdiscperc FROM Customer WHERE custcode =19 USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.id_master.object.sprice.initial = string(li_defaultsaleprice)
			this.id_master.object.itemdiscpercno.initial = string(li_defaultitemdiscperc)
		else
			messagebox("Customer Information", "Error in Retrieving Customer Information")
			close(this)
		end if
	end choose
	this.id_master.object.socatcode.initial = string(this.ii_socatcode)
	li_rtncode = this.id_master.getchild("doctcode", this.idc_doctors)
	if li_rtncode = -1 then
		messagebox("Error!!!!", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_doctors.settransobject(this.it_transobject)
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit to Make Sales")
		close(this)
		return
	end if
	li_rtncode = this.id_detail.getchild("gcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error!!!!!", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error!!!!!!", "Not Enough Godown Rights to make sale order")
		close(this)
		return
	end if
	this.ii_salegodown = this.idc_godown.getitemnumber(1, "gcode")
	this.id_detail.object.gcode.initial = string(this.ii_salegodown)
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = true
	this.id_itemslist.object.sstock.visible = true
	this.id_itemslist.object.t_pstock.visible = false
	this.id_itemslist.object.pstock.visible = false
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 513 and f_stringpreferences("CaSPNo") = "Y" then
			this.id_master.object.sprice.visible = true
			this.id_master.object.t_sprice.visible = true
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 522 then
			this.id_master.object.dd_gstperc.visible = true
			this.id_master.object.gstperc_t.visible = true
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 523 then
			this.id_footer.object.rpp.visible = true
			this.id_footer.object.t_rpp.visible = true
			this.id_footer.object.avgprice.visible = true
			this.id_footer.object.purprice.visible = true
			this.id_footer.object.retailprice.visible = true
		end if
	next
	if f_stringpreferences("Itemflatdisc") = "N" then
		this.id_detail.object.itemflatdisc.visible = false
	end if
	if f_stringpreferences("showsizedescinsaleorder") = "N" then
		this.id_detail.object.sizedescription.visible = false
	end if
	li_rtncode = lds_headers.retrieve(this.il_groupcode, 12)
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Sales Order")
		close(this)
		return
	end if
	if f_stringpreferences("headeronsaleinv") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.t_headerno.visible = false
	end if
	if f_stringpreferences("ShowGoodsCompanyInSale") = "N" then
		this.id_master.object.gccode.visible = false
		this.id_master.object.gccode_t.visible = false
	end if
	if f_stringpreferences("ShowVehicleInSale") = "N" then
		this.id_master.object.vehicle.visible = false
		this.id_master.object.vehicle_t.visible = false
	end if
	if f_stringpreferences("ShowShipToInSale") = "N" then
		this.id_master.object.shipto.visible = false
		this.id_master.object.shipto_t.visible = false
	end if
	if f_stringpreferences("ShowAssociatedPurInvCodeInSale") = "N" then
		this.id_master.object.associatedpurinvcode.visible = false
		this.id_master.object.associatedpurinvcode_t.visible = false
	end if
	if f_stringpreferences("ShowSuppInvCodeInSale") = "N" then
		this.id_master.object.suppinvcode.visible = false
		this.id_master.object.suppinvcode_t.visible = false
	end if
	if f_stringpreferences("ShowGRNInSale") = "N" then
		this.id_master.object.grn.visible = false
		this.id_master.object.grn_t.visible = false
	end if
	this.id_master.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to lds_headers.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
		ldc_headerno.setitem(ll_counter, "name", "")
		ll_found = 0
		ll_found = gds_reoprtheaderinfo.find("headerno=" + string(lds_headers.getitemnumber(ll_counter, "headercode")), 1, gds_reoprtheaderinfo.rowcount())
		if ll_found > 0 then
			ldc_headerno.setitem(ll_counter, "headeralias", gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks"))
		end if
	next
	this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
	this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.t_gcode.visible = true
		this.id_master.object.gcode.visible = true
		this.id_master.object.gcode.initial = string(this.ii_salegodown)
		this.id_detail.object.gcode.visible = false
		this.id_footer.object.t_totalstock.visible = false
		this.id_footer.object.totalstock.visible = false
	end if
	if f_stringpreferences("ShowCustomerLatestNetRateInFooter") = "N" then
		this.id_footer.object.latestnetrate.visible = false
	end if
	if f_stringpreferences("SaleItemdescription") = "N" then
		this.id_detail.object.saleitemdescription.visible = false
	end if
	if f_stringpreferences("packingdescinsale") = "N" then
		this.id_detail.object.packingdesc.visible = false
	end if
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.sstock.visible = false
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	gd_itemsinfo.sharedata(this.id_itemslist)
	if this.ii_saletype = 3 and (gs_company = "SHE" or gs_company = "RIZWAN" or gs_company = "REHMAT") then
		wf_visibleinvisiblediscount()
		li_defaultgodown = this.ii_salegodown
	end if
	if this.ii_saletype = 3 and f_stringpreferences("discpercinretail") = "N" then
		wf_visibleinvisiblediscount()
	end if
	if this.ii_saletype = 2 and f_stringpreferences("discpercincredit") = "N" then
		wf_visibleinvisiblediscount()
	end if
	if gs_company = "SHE" or gs_company = "RIZWAN" or gs_company = "REHMAT" then
		this.id_footer.object.t_2.visible = true
		this.id_footer.object.t_purdiscper.visible = true
	end if
	if f_stringpreferences("itemunittax") = "N" then
		this.id_detail.object.unitsalestax.visible = false
		this.id_detail.object.taxperunit_t.visible = false
		this.id_detail.object.c_sumtaxval.visible = false
		this.id_detail.object.c_taxval.visible = false
		this.id_detail.object.taxval_t.visible = false
	end if
	if f_stringpreferences("itemgstperc") = "N" then
		this.id_detail.object.gstperc.visible = false
		this.id_detail.object.gstperc_t.visible = false
		this.id_detail.object.c_sumgstval.visible = false
		this.id_detail.object.c_gstval.visible = false
		this.id_detail.object.gstval_t.visible = false
	end if
	if f_stringpreferences("ShowUnitWeightInSale") = "N" then
		this.id_detail.object.unitweight.visible = false
		this.id_detail.object.c_item_unitweight.visible = false
	else
		this.id_detail.object.unitweight.visible = true
		this.id_detail.object.c_item_unitweight.visible = true
	end if
	if f_stringpreferences("Saleclaimable") = "N" then
		this.id_detail.object.claimable.visible = false
	end if
	if f_stringpreferences("ShowClaimableDiscPercInSale") = "N" then
		this.id_detail.object.claimablediscperc.visible = false
	end if
	if f_stringpreferences("ShowPackingFactorInSale") = "N" then
		this.id_detail.object.packingfactor.visible = false
		this.id_detail.object.c_item_packingfactor.visible = false
	else
		this.id_detail.object.packingfactor.visible = true
		this.id_detail.object.c_item_packingfactor.visible = true
	end if
	if f_stringpreferences("invgstperc") = "N" then
		this.id_footer.object.invgstperc1.visible = false
		this.id_footer.object.invgstperc1_t.visible = false
	end if
	if f_stringpreferences("SaleOnZeroPrice") = "N" then
		this.id_detail.setvalidate("Saleprice", "Number(GetText( )) > 0")
	end if
	if this.ii_saletype = 2 then
		this.id_master.object.invoicesize.initial = f_stringpreferences("creditsalepagesize")
	else
		this.id_master.object.invoicesize.initial = f_stringpreferences("pagesize")
	end if
	if f_stringpreferences("bonusinsale") = "N" then
		this.id_detail.object.bonusqty.visible = false
		this.id_footer.object.t_bonus.visible = false
		this.id_footer.object.bonusratio.visible = false
	end if
	if f_stringpreferences("messageinsale") = "N" then
		this.id_master.object.messagecode.visible = false
		this.id_master.object.t_message.visible = false
	end if
	if f_stringpreferences("salesmaninsale") = "N" then
		this.id_master.object.smancode.visible = false
		this.id_master.object.t_salesman.visible = false
	end if
	if f_stringpreferences("SaleDisplayItemDiscPerc") = "Y" then
		this.id_master.object.itemdiscpercno.visible = true
		this.id_master.object.t_itemdiscpercno.visible = true
	end if
	if f_stringpreferences("askdeliverydeadlineinso") = "Y" then
		this.id_master.object.deliverydeadline.visible = true
		this.id_master.object.t_deliverydeadline.visible = true
	end if
	if f_stringpreferences("asklatedeliverychargesinso") = "Y" then
		this.id_master.object.latedeliverycharges.visible = true
		this.id_master.object.t_latedeliverycharges.visible = true
	end if
	if f_stringpreferences("asksectioninso") = "N" then
		this.id_master.object.section_t.visible = false
		this.id_master.object.sectcode.visible = false
	end if
	lds_listsetting = create datastore
	lds_listsetting.dataobject = "d_interfacesettingcols"
	lds_listsetting.settransobject(this.it_transobject)
	if this.ii_saletype = 2 then
		lds_listsetting.retrieve(11, 4, 0)
	else
		lds_listsetting.retrieve(10, 4, 0)
	end if
	for ll_counter = 1 to lds_listsetting.rowcount()
		this.id_list.modify(lds_listsetting.getitemstring(ll_counter, "colname") + "_t" + ".Visible=0")
		this.id_list.modify(lds_listsetting.getitemstring(ll_counter, "colname") + ".Visible=0")
	next
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.id_master.accepttext()
	f_setcolumnstyle(this.id_detail, "Qty")
	setredraw(true)
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 563", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.date.protect = 0
		this.id_master.object.date.background.color = rgb(255, 255, 255)
		this.ib_modifydate = true
		lm_menu.m_file.m_setserverdate.visible = true
		lm_menu.m_file.m_setserverdate.enabled = true
	end if
	if not this.ib_modifydate then
		this.id_master.object.date.protect = 1
		this.id_master.settaborder("date", 0)
		lm_menu.m_file.m_setserverdate.visible = false
		lm_menu.m_file.m_setserverdate.enabled = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 570", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_detail.object.packqtyforsale.visible = true
	else
		this.id_detail.object.packqtyforsale.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 571", 1, gds_securitywindow.rowcount())
	if ll_found > 0 and f_stringpreferences("bonusinsale") = "Y" then
		this.id_detail.object.bonuspackqtyforsale.visible = true
	else
		this.id_detail.object.bonuspackqtyforsale.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 577", 1, gds_securitywindow.rowcount())
	if this.ii_saletype = 2 and gs_company = "CARENCUREKHI" then
		this.id_master.object.t_custrefno.text = "Order No.:"
	end if
	this.ic_advancetaxonsale = f_stringpreferences("ApplyAdvanceIncomeTaxInSale")
	if this.ic_advancetaxonsale = "" or isnull(this.ic_advancetaxonsale) then
		this.ic_advancetaxonsale = "N"
	end if
	this.ic_fbrposfee = f_stringpreferences("Auto_Apply_FBR_POS_Fee_InSale")
	if this.ic_fbrposfee = "" or isnull(this.ic_fbrposfee) then
		this.ic_fbrposfee = "N"
	end if
	if this.ic_fbrposfee = "Y" then
		this.id_footer.settaborder("misccharges", 0)
		this.id_master.object.fbrposfee.initial = trim(string(f_doublepreferences("Amount_For_FBR_POS_Fee_InSale"), "##0.00"))
	else
		this.id_master.object.fbrposfee.initial = "0.00"
	end if
	if this.ic_advancetaxonsale = "Y" then
		this.id_footer.settaborder("misccharges", 0)
	else
		this.id_detail.object.c_advancetax.visible = false
		this.id_footer.object.advancetaxamt_t.visible = false
		this.id_footer.object.advancetaxamt.visible = false
	end if
	if f_islicenseexpire() = -2 then
		close(this)
	end if
	if f_stringpreferences("askbatchinsaleorder") = "N" then
		this.id_detail.object.batch.visible = false
	end if
	if f_stringpreferences("askexpiryinsaleorder") = "N" then
		this.id_detail.object.expiry.visible = false
	end if
	if f_stringpreferences("askmfgdateinsaleorder") = "N" then
		this.id_detail.object.manfdate.visible = false
	end if
	if f_stringpreferences("askstrengthpercinsaleorder") = "N" then
		this.id_detail.object.strengthperc.visible = false
	end if
	this.id_detail.object.manfdate.initial = string(date(today()))
	this.id_detail.object.expiry.initial = string(relativedate(today(), 365 * 5))
	ll_found = 0
	if this.ii_saletype = 3 then
		ll_found = gds_securitywindow.find("rightcode = 572", 1, gds_securitywindow.rowcount())
	else
		ll_found = gds_securitywindow.find("rightcode = 573", 1, gds_securitywindow.rowcount())
	end if
	if ll_found > 0 then
		lm_menu.m_file.m_deletesaleinvoice.visible = true
	end if
	if f_rightexists(5211) then
		lm_menu.m_file.m_applycustomizedgstperc.visible = true
		lm_menu.m_file.m_applycustomizedgstperc.enabled = true
	end if
	if f_rightexists(5212) then
		lm_menu.m_file.m_raisesaleinvoice.visible = true
		lm_menu.m_file.m_raisesaleinvoice.enabled = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 574", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_previewinvoicemargin.visible = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5015", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_applycustomerassociatedquotation.visible = true
		lm_menu.m_file.m_applycustomerassociatedquotation.enabled = true
	else
		lm_menu.m_file.m_applycustomerassociatedquotation.visible = false
		lm_menu.m_file.m_applycustomerassociatedquotation.enabled = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 620", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_populatesofromdatacarry.visible = true
		lm_menu.m_file.m_populatesofromdatacarry.enabled = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 734", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_showpricevalues = true
	end if
	if this.ib_showpricevalues = false then
		this.id_detail.object.discperc.initial = "0"
		this.id_detail.object.saleprice.visible = false
		this.id_detail.object.discperc.visible = false
		this.id_detail.object.itemflatdisc.visible = false
		this.id_detail.object.c_itemtotal.visible = false
		this.id_detail.object.unitsalestax.visible = false
		this.id_detail.object.c_taxval.visible = false
		this.id_detail.object.gstperc.visible = false
		this.id_detail.object.c_gstval.visible = false
		this.id_detail.object.c_finalitemval.visible = false
		this.id_footer.object.total.visible = false
		this.id_footer.object.total_t.visible = false
		this.id_list.object.netamount.visible = false
	end if
	if f_stringpreferences("showitemstatusinsaleorder") = "N" then
		this.id_detail.object.saleorderitemstatuscode.visible = false
	end if
	if f_stringpreferences("showitemremarksinsaleorder") = "N" then
		this.id_detail.object.remarks.visible = false
	end if

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	if newindex = 1 then
		parent.ii_focuscustomer = 1
	end if
	return ::message.returnvalue

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
	case "flatdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	end choose
	return 1

// dw_footer.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if (getcolumnname() = "misccharges" or getcolumnname() = "invdiscperc") and key = keyf5! then
		parent.parent.parent.wf_set_misccharges()
		rt_code = 1
	end if
	if (getcolumnname() = "misccharges" or getcolumnname() = "flatdisc" or getcolumnname() = "invdiscperc") and key = keyf7! then
		parent.parent.parent.wf_show_misccharges_breakup()
		rt_code = 1
	end if
	if getcolumnname() = "flatdisc" and key = keyf5! then
		parent.parent.parent.wf_set_flatdiscount()
		rt_code = 1
	end if
	if getcolumnname() = "flatdisc" and key = keyf6! then
		parent.parent.parent.wf_set_flatdiscount2()
		rt_code = 1
	end if
	return rt_code

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_code
	long ll_detailrows
	long ll_suppcode
	long ll_custcode
	long ll_counter
	long ll_customerbalance
	long ll_headerinvno
	integer rt_code
	integer li_res
	integer li_smancode
	double ld_avgprice
	double ld_gstperc1
	double ld_gstperc2
	double ld_custgst
	double ld_invdiscperc
	double ld_itemdiscperc
	double ld_itemdiscperc2
	double ld_itemdiscperc3
	double ld_itemdiscperc4
	double ld_purprice
	double ld_saleprice4
	double ld_saleprice5
	double ld_salediscperc5
	long ll_icode
	long ll_rpp
	long li_packunits
	long ll_patientcode
	long ll_allowed
	long ll_null
	string ls_result
	string ls_null
	datetime ld_currdate
	date ld_datepart
	time lt_timepart
	integer li_salepriceno
	integer li_itemdiscpercno
	double ld_saleprice1
	double ld_saleprice2
	double ld_saleprice3
	double ld_salediscperc
	double ld_salediscperc2
	double ld_salediscperc3
	double ld_salediscperc4
	integer li_custcode
	integer li_patientcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "sprice"
		parent.setredraw(false)
		if parent.parent.parent.id_detail.getrow() > 0 and isnull(parent.parent.parent.id_detail.getitemnumber(parent.parent.parent.id_detail.getrow(), "itemcode")) then
			parent.parent.parent.event ue_deleteitem()
		end if
		for ll_counter = 1 to parent.parent.parent.id_detail.rowcount()
			ll_icode = parent.parent.parent.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT item.saleprice , item.saleprice2 , item.saleprice3 , item.avgprice , item.packunits , item.purprice , item.recentpurprice , item.saleprice4 , item.saleprice5 INTO :ld_saleprice1, :ld_saleprice2, :ld_saleprice3, :ld_avgprice, :li_packunits, :ld_purprice, :ll_rpp, :ld_saleprice4, :ld_saleprice5 FROM item WHERE item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = -1 then
				parent.setredraw(true)
				messagebox("Database Error", "Item information can not be retrieved")
				return 1
			end if
			if not (parent.parent.parent.it_transobject.sqlcode = 100) then
				choose case long(data)
				case 1
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice1 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice1)
				case 2
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice2 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice2)
				case 3
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice3 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice3)
				case 7
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice4 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice4)
				case 8
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_saleprice5 / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_saleprice5)
				case 4
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_purprice / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_purprice)
				case 5
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ll_rpp / li_packunits)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ll_rpp)
				case else
					parent.parent.parent.id_detail.setitem(ll_counter, "saleprice", ld_avgprice)
					parent.parent.parent.id_detail.setitem(ll_counter, "packprice", ld_avgprice * li_packunits)
				end choose
			elseif not isnull(parent.parent.parent.id_detail.getitemstring(1, "itemname")) then
				parent.setredraw(true)
				messagebox("DataBase Error", "Rows not retrieve")
				return 0
			end if
		next
		if parent.parent.parent.id_detail.rowcount() <= 0 then
			parent.parent.parent.event ue_newitem()
			parent.parent.parent.id_master.setfocus()
		end if
		parent.setredraw(true)
	case "dd_gstperc"
		parent.setredraw(false)
		if parent.parent.parent.id_detail.getrow() > 0 and isnull(parent.parent.parent.id_detail.getitemnumber(parent.parent.parent.id_detail.getrow(), "itemcode")) then
			parent.parent.parent.event ue_deleteitem()
		end if
		for ll_counter = 1 to parent.parent.parent.id_detail.rowcount()
			ll_icode = parent.parent.parent.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT item.gstperc1 , item.gstperc2 INTO :ld_gstperc1, :ld_gstperc2 FROM item WHERE item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = -1 then
				parent.setredraw(true)
				messagebox("Database Error", "Item information can not be retrieved")
				return 1
			end if
			if not (parent.parent.parent.it_transobject.sqlcode = 100) then
				if data = "2" then
					parent.parent.parent.id_detail.setitem(ll_counter, "gstperc", ld_gstperc2)
				else
					parent.parent.parent.id_detail.setitem(ll_counter, "gstperc", ld_gstperc1)
				end if
			end if
		next
		if parent.parent.parent.id_detail.rowcount() <= 0 then
			parent.parent.parent.event ue_newitem()
			parent.parent.parent.id_master.setfocus()
		end if
		parent.setredraw(true)
	case "itemdiscpercno"
		parent.setredraw(false)
		if parent.parent.parent.id_detail.getrow() > 0 and isnull(parent.parent.parent.id_detail.getitemnumber(parent.parent.parent.id_detail.getrow(), "itemcode")) then
			parent.parent.parent.event ue_deleteitem()
		end if
		for ll_counter = 1 to parent.parent.parent.id_detail.rowcount()
			ll_icode = parent.parent.parent.id_detail.getitemnumber(ll_counter, "icode")
			SQL SELECT item.salediscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 INTO :ld_salediscperc, :ld_salediscperc2, :ld_salediscperc3, :ld_salediscperc4, :ld_salediscperc5 FROM item WHERE item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = -1 then
				parent.setredraw(true)
				messagebox("Database Error", "Item information can not be retrieved")
				return 1
			end if
			if not (parent.parent.parent.it_transobject.sqlcode = 100) then
				if long(parent.parent.parent.id_detail.object.discperc.visible) = 1 then
					choose case data
					case "1"
						parent.parent.parent.id_detail.setitem(ll_counter, "discperc", ld_salediscperc)
					case "2"
						parent.parent.parent.id_detail.setitem(ll_counter, "discperc", ld_salediscperc2)
					case "3"
						parent.parent.parent.id_detail.setitem(ll_counter, "discperc", ld_salediscperc3)
					case "4"
						parent.parent.parent.id_detail.setitem(ll_counter, "discperc", ld_salediscperc4)
					case "5"
						parent.parent.parent.id_detail.setitem(ll_counter, "discperc", ld_salediscperc5)
					end choose
				else
					parent.parent.parent.id_detail.setitem(ll_counter, "discperc", 0)
				end if
			end if
		next
		if parent.parent.parent.id_detail.rowcount() <= 0 then
			parent.parent.parent.event ue_newitem()
			parent.parent.parent.id_master.setfocus()
		end if
		parent.setredraw(true)
	case "quotationcode"
		setnull(ll_headerinvno)
		setitem(row, "headerinvno", ll_headerinvno)
	case "headerno"
		setnull(ll_headerinvno)
		setitem(row, "headerinvno", ll_headerinvno)
	case "date"
	case "aliasname"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findcustcode(data, li_custcode)
			if li_custcode = 19 and parent.parent.parent.ii_saletype <> 3 then
				messagebox("Customer Validation", "Cash Sale Walk-In Customer is not allowed in Credit Sale")
				return 1
			end if
			if li_res > 0 and f_stringpreferences("GroupCustomerCategory") = "Y" then
				ll_allowed = 0
				parent.parent.parent.it_transobject.isallowedcustomergroupcategory(parent.parent.parent.il_groupcode, li_custcode, ll_allowed)
				if parent.parent.parent.it_transobject.sqlcode <> 0 then
					messagebox("Fetch Error", "Unable to fetch group customer category information.")
					return 1
				elseif ll_allowed < 1 then
					messagebox("Group Customer Category Validation", "Current group does not have enough permissions for sale ~r~n" + "against the customer whose alias name provided in alias name box.")
					return 1
				end if
				return
			end if
			if li_res > 0 then
				setitem(row, "custcode", li_custcode)
				rt_code = parent.parent.parent.wf_setcustomerinfo(row, 1, string(li_custcode))
			else
				messagebox("Customer Validation", "Customer with  Alias Name  " + data + " does not exist")
				return 1
			end if
		else
			return 0
		end if
	case "patientregno"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findpatientcode(data, li_patientcode)
			if li_res > 0 then
				if parent.parent.parent.ii_saletype = 3 then
					setitem(row, "patientcode", li_patientcode)
				end if
				rt_code = 0
				if parent.parent.parent.ii_saletype = 2 then
					SQL SELECT custcode INTO :ll_custcode FROM patient WHERE patientcode =:li_patientcode USING parent.parent.parent.it_transobject;
					if parent.parent.parent.it_transobject.sqlcode = 0 then
						ll_allowed = 0
						if f_stringpreferences("GroupCustomerCategory") = "Y" then
							parent.parent.parent.it_transobject.isallowedcustomergroupcategory(parent.parent.parent.il_groupcode, ll_custcode, ll_allowed)
							if parent.parent.parent.it_transobject.sqlcode <> 0 then
								messagebox("Fetch Error", "Unable to fetch group customer category information.")
								return 1
							elseif ll_allowed < 1 then
								messagebox("Group Customer Category Validation", "Current group does not have enough permissions for sale ~r~n" + "against the customer.")
								return 1
							end if
							return
						end if
						setitem(row, "patientcode", li_patientcode)
						parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
						parent.parent.parent.id_master.object.custcode.protect = 1
						parent.parent.parent.id_master.object.aliasname.protect = 1
						rt_code = parent.parent.parent.wf_setcustomerinfo(row, 1, string(ll_custcode))
					else
						messagebox("Patient Information", "Problem in retrieving corresponding customer")
						rt_code = 1
					end if
				end if
			else
				messagebox("Patient Validation", "Patient with  RegNo  " + data + " does not exist")
				rt_code = 1
			end if
		end if
	case "custcode"
		return parent.parent.parent.wf_setcustomerinfo(row, 1, data)
	case "messagecode"
		if not isnull(getitemnumber(row, "custcode")) then
			rt_code = parent.parent.parent.wf_customermessagevalidation(getitemnumber(row, "custcode"), long(data))
			if rt_code = 1 then
				rt_code = messagebox("Invalid Message Alert", "Wrong Message Selected" + "~rIs That Ok?", question!, yesno!, 2)
				if rt_code = 1 then
					rt_code = 0
				end if
			end if
		end if
	case "patientcode"
		if parent.parent.parent.ii_saletype = 2 then
			parent.parent.parent.id_master.setitem(1, "patientregno", parent.parent.parent.idc_patient.getitemstring(parent.parent.parent.idc_patient.getrow(), "regno"))
			if isnull(data) then
				parent.parent.parent.id_master.object.custcode.protect = 0
				parent.parent.parent.id_master.setitem(1, "custcode", 0)
				parent.parent.parent.id_master.setitem(1, "itemdiscpercno", setnull(ll_null))
				parent.parent.parent.id_master.setitem(1, "sprice", 1)
				parent.parent.parent.id_master.setitem(1, "dd_gstperc", 1)
			else
				ll_patientcode = long(data)
				SQL SELECT custcode INTO :ll_custcode FROM patient WHERE patientcode =:ll_patientcode USING parent.parent.parent.it_transobject;
				if parent.parent.parent.it_transobject.sqlcode = 0 then
					ll_allowed = 0
					if f_stringpreferences("GroupCustomerCategory") = "Y" then
						parent.parent.parent.it_transobject.isallowedcustomergroupcategory(parent.parent.parent.il_groupcode, ll_custcode, ll_allowed)
						if parent.parent.parent.it_transobject.sqlcode <> 0 then
							messagebox("Fetch Error", "Unable to fetch group customer category information.")
							return 1
						elseif ll_allowed < 1 then
							messagebox("Group Customer Category Validation", "Current group does not have enough permissions for sale ~r~n" + "against the customer whose patient is selected in the list box.")
							return 1
						end if
						return
					end if
					parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
					parent.parent.parent.id_master.object.custcode.protect = 1
					parent.parent.parent.id_master.object.aliasname.protect = 1
					rt_code = parent.parent.parent.wf_setcustomerinfo(row, 1, string(ll_custcode))
				else
					messagebox("Patient Information", "Problem in retrieving corresponding customer.")
					rt_code = 1
				end if
			end if
		end if
		return rt_code
	end choose
	return rt_code

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "date"
		messagebox("Date Time Validation", "Date and Time is invalid,~r~nPlease enter current date and time")
	case "custcode"
		messagebox("Customer Name Validation", "You must select some Customer")
	case "custrefno"
		if data = "" or isnull(data) then
			messagebox("Customer Reference Validation", "Please Enter Reference")
		end if
	case "headerno"
		if data = "" or isnull(data) then
			messagebox("Header No Validation", "You must select some HeaderNo")
		end if
	case "Regno"
		if data = "" or isnull(data) then
			messagebox("Patient Validation", "RegNo Does Not Exist")
		end if
	end choose
	return 1

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyenter! and getcolumnname() = "custcode" then
		parent.parent.parent.id_master.setitem(1, "custcode", parent.parent.parent.idc_customers.getitemnumber(parent.parent.parent.idc_customers.getrow(), "accounts_acccode"))
		if parent.parent.parent.il_custcode <> parent.parent.parent.id_master.getitemnumber(1, "custcode") and parent.parent.parent.wf_setcustomerinfo(1, 1, string(parent.parent.parent.idc_customers.getitemnumber(parent.parent.parent.idc_customers.getrow(), "accounts_acccode"))) = 1 then
			parent.parent.parent.id_master.setitem(1, "custcode", 0)
		end if
		parent.parent.parent.id_master.setcolumn("custcode")
		parent.parent.parent.id_master.setfocus()
	end if
	return ::message.returnvalue

// dw_detail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	parent.parent.parent.post wf_setcustomername(data)
	return ::message.returnvalue

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if string(dwo.name) = "custcode" then
		parent.parent.parent.id_master.selecttext(1, 40)
		if f_stringpreferences("CreditSaleAutoPopUpWindow") = "Y" then
			parent.parent.parent.post wf_viewheader()
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_focuscustomer() returns 0 [event]
	integer ll_row
	integer ll_custcode
	parent.parent.parent.id_master.setcolumn("custcode")
	parent.parent.parent.id_master.setfocus()
	messagebox("Customer Selection", "Please select a Customer from the Dropdown Box")

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_null
	string ls_itemname
	integer li_errcode
	long ll_null
	long ll_icode
	long ll_gcode
	long ll_packunits
	double ld_packqty
	double ld_bonuspackqty
	double ld_newbonusqty
	double ld_desiredbonus
	double ld_newqty
	double ld_storedqty
	double ld_stock
	double ld_invdiscperc
	integer li_res
	integer li_saleprice
	double ld_salediscperc
	double ld_purdiscperc
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
		parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		li_errcode = 0
	case "packqtyforsale"
		ld_packqty = double(data)
		if not isnull(ld_packqty) or ld_packqty >= 0.0 then
			ll_icode = getitemnumber(row, "icode")
			if not isnull(ll_icode) then
				SQL Select packunits INTO :ll_packunits From item Where icode =:ll_icode USING sqlca;
				if sqlca.sqlcode = 0 then
					if isnull(ll_packunits) or ll_packunits = 0 then
						ll_packunits = 1
					end if
					ld_newqty = ll_packunits * ld_packqty
					if f_stringpreferences("bonusinsale") = "Y" then
						ld_newqty = ld_newqty + getitemnumber(row, "bonusqty")
					end if
					setitem(row, "looseqty", ld_newqty)
				end if
			end if
		end if
	case "bonuspackqtyforsale"
		ld_bonuspackqty = double(data)
		if not isnull(ld_bonuspackqty) or ld_bonuspackqty >= 0.0 then
			ll_icode = getitemnumber(row, "icode")
			if not isnull(ll_icode) then
				SQL Select packunits INTO :ll_packunits From item Where icode =:ll_icode USING sqlca;
				if sqlca.sqlcode = 0 then
					if isnull(ll_packunits) or ll_packunits = 0 then
						ll_packunits = 1
					end if
					ld_newbonusqty = ll_packunits * ld_bonuspackqty
					ld_newqty = ld_newbonusqty + getitemnumber(row, "looseqty")
					setitem(getrow(), "bonusqty", ld_newbonusqty)
				end if
			end if
		end if
	case "looseqty"
		ld_newqty = double(data) + getitemnumber(row, "bonusqty")
		ld_storedqty = getitemnumber(row, "looseqty") + getitemnumber(row, "bonusqty")
		if ld_newqty <= 0.0 and f_stringpreferences("BonusinSale") = "N" then
			messagebox("Quantity Validation", "Item Qty ~"" + data + "~" should be greater than zero")
			li_errcode = 1
		elseif ld_newqty <= 0.0 and f_stringpreferences("BonusinSale") = "Y" then
			if ld_newqty < 0.0 then
				messagebox("Quantity Validation", "Item Qty ~"" + data + "~" should be greater than zero")
				li_errcode = 1
			end if
		elseif f_stringpreferences("BonusinSale") = "Y" then
			if getitemnumber(row, "qtysale") = 0.0 then
				ld_desiredbonus = double(data) / 1.0 * double(getitemnumber(row, "Bonus"))
			else
				ld_desiredbonus = long(data) / double(getitemnumber(row, "qtysale")) * double(getitemnumber(row, "Bonus"))
			end if
			setitem(row, "bonusqty", ld_desiredbonus)
		end if
	case "bonusqty"
		ld_newqty = double(data) + getitemnumber(row, "looseQty")
		ld_storedqty = getitemnumber(row, "looseqty") + getitemnumber(row, "bonusqty")
		if ld_newqty <= 0.0 and f_stringpreferences("BonusinSale") = "Y" and ld_newqty < 0.0 then
			messagebox("Quantity Validation", "Item Qty ~"" + data + "~" should be greater than zero")
			li_errcode = 1
		end if
		if f_stringpreferences("BonusinSale") = "Y" and li_errcode <> 1 then
			if getitemnumber(row, "qtysale") = 0.0 then
				ld_desiredbonus = double(getitemnumber(row, "looseqty") / 1.0000) * double(getitemnumber(row, "Bonus"))
			else
				ld_desiredbonus = double(getitemnumber(row, "looseqty") / double(getitemnumber(row, "qtysale"))) * double(getitemnumber(row, "Bonus"))
			end if
			if double(data) > ld_desiredbonus then
				ld_desiredbonus = messagebox("Bonus Quantity Alert", "Bonus Quantity Should Be = " + string(ld_desiredbonus) + "~rRequested Bonus Quantity is = " + data + "~rIs That Ok?", question!, yesno!, 2)
				if ld_desiredbonus = 1.0 then
					li_errcode = -1
				else
					li_errcode = 1
				end if
			end if
		end if
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname)
			if li_res > 0 then
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
			else
				messagebox("ItemNumber Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_errcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_errcode = 2
		end if
	case "saleprice"
		setitem(row, "updatesaleprice", "Y")
		if getitemstring(row, "locksaleprice") = "Y" then
			messagebox("SalePrice Validation", "SalePrice is locked, you can not change it ")
			li_errcode = 2
		else
			li_errcode = parent.parent.parent.wf_itemnetprice(double(data), parent.parent.parent.id_detail.getitemnumber(row, "discperc"), parent.parent.parent.id_detail.getitemnumber(row, "Itemflatdisc"), this.object.icode[row])
		end if
	case "gcode"
		parent.parent.parent.is_columnname = "gcode"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_godownvalidated = false
		li_errcode = 0
	case "itemflatdisc"
		li_saleprice = getitemnumber(row, "saleprice")
		if li_saleprice < long(data) then
			messagebox("FlatDisc Validation", "Itemflatdisc must be less than sale price")
			li_errcode = 1
		end if
		li_errcode = parent.parent.parent.wf_itemnetprice(parent.parent.parent.id_detail.getitemnumber(row, "saleprice"), parent.parent.parent.id_detail.getitemnumber(row, "discperc"), double(data), this.object.icode[row])
	case "discperc"
		if getitemstring(row, "lockdiscperc") = "Y" then
			messagebox("Disc(%) Validation", "Disc(%) is locked, you can not change it")
			li_errcode = 2
		else
			if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
				ld_salediscperc = double(data)
				ll_icode = this.object.icode[row]
				SQL Select item.purdiscperc INTO :ld_purdiscperc From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
				if ld_salediscperc > ld_purdiscperc then
					messagebox("Discount Validation", "Discount(%) " + data + " exceeds the purchase discount")
					li_errcode = 1
				end if
			end if
			li_errcode = parent.parent.parent.wf_itemnetprice(parent.parent.parent.id_detail.getitemnumber(row, "saleprice"), double(data), parent.parent.parent.id_detail.getitemnumber(row, "Itemflatdisc"), this.object.icode[row])
		end if
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ll_icode
	long ll_gcode
	long ll_count
	long ll_check_dup_icode
	long ancestorreturnvalue
	ll_check_dup_icode = parent.parent.parent.id_detail.getitemnumber(row, "icode")
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(false) = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "itemname" then
		parent.parent.parent.ib_focusdetail = true
	end if
	if dwo.name = "looseqty" and parent.parent.parent.ib_itemslistopen then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
	end if
	parent.parent.parent.wf_grandtotal()
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return 0

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_icode
	double ld_purdiscperc
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if currentrow > 0 then
		parent.parent.parent.is_aliasname = getitemstring(currentrow, "fullcode")
	end if
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(true) = -1 then
		return ::message.returnvalue
	end if
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if getcolumnname() <> parent.parent.parent.is_columnitemname then
		if rowcount() > 0 and lrs_status <> new! then
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", getitemnumber(currentrow, "icode"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", getitemnumber(currentrow, "stock"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "retailprice", getitemdecimal(currentrow, "retailprice"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "rpp", getitemnumber(currentrow, "recentpurprice"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "purprice", getitemnumber(currentrow, "purprice"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "avgprice", getitemnumber(currentrow, "avgprice"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "latestnetrate", getitemnumber(currentrow, "latestnetrate"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "itemtotalval", getitemstring(currentrow, "itemtotalval"))
			if f_stringpreferences("BonusinSale") = "Y" then
				parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "bonusratio", trim(string(getitemnumber(currentrow, "qtysale"))) + ":" + trim(string(getitemnumber(currentrow, "bonus"))))
			end if
			if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
				ll_icode = this.object.icode[currentrow]
				SQL Select item.purdiscperc INTO :ld_purdiscperc From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
				parent.parent.parent.id_footer.object.t_purdiscper.text = string(ld_purdiscperc)
			end if
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", getitemnumber(currentrow, "totalstock"))
		elseif parent.parent.parent.id_footer.getrow() > 0 then
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "retailprice", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "latestnetrate", 0)
			if f_stringpreferences("BonusinSale") = "Y" then
				parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "bonusratio", "")
			end if
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	long ll_currentrow
	string ls_holdstr
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	if f_stringpreferences("DisplayPool") = "Y" then
		ll_currentrow = getrow()
		if ll_currentrow <> 0 and parent.parent.parent.ib_lcdshow = true then
			ls_holdstr = this.object.itemname[ll_currentrow]
			if len(ls_holdstr) < 20 then
				parent.parent.parent.is_lcditem = ls_holdstr + space(20 - len(ls_holdstr))
			else
				parent.parent.parent.is_lcditem = left(ls_holdstr, 20)
			end if
			parent.parent.parent.is_lcditem = parent.parent.parent.is_lcditem + "Qty=" + string(this.object.looseqty[ll_currentrow])
			parent.parent.parent.is_lcditem = parent.parent.parent.is_lcditem + " Rs=" + string(this.object.saleprice[ll_currentrow], "#######0.00")
			parent.parent.parent.ic_comport.triggerevent("ue_show")
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "fullcode"
		if data = "" or isnull(data) then
		end if
	case parent.parent.parent.is_columnitemname
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case "packqtyforsale"
		if double(data) < 0.0 or isnull(data) then
			messagebox("Item Pack Qty Validation", "Item Pack Qty ~"" + data + "~" should be greater than or equal to zero")
		end if
	case "bonuspackqtyforsale"
		if double(data) < 0.0 or isnull(data) then
			messagebox("Item Pack Bonus Validation", "Item Pack Bonus ~"" + data + "~" should be greater than or equal to zero")
		end if
	case "looseqty"
	case "packqty"
		if real(data) < 1.0 then
			messagebox("Item Qty Validation", "Item Qty ~"" + data + "~" should be greater than zero")
		end if
	case "discperc"
		if real(data) < 0.0 and real(data) > 100.0 then
			messagebox("Item Discount Validation", "Discount ~"" + data + "~" must be betweeen 0 and 100")
		end if
	case "gcode"
		if real(data) < 0.0 or isnull(data) then
			messagebox("Item Godown Validation", "Please select some other godown")
		end if
	case "saleprice"
		if double(data) < 0.0 then
			messagebox("Item Price Validation", "Item price ~"" + data + "~" must be greater than or equal to zero")
			return 1
		end if
	end choose
	return 1

// dw_itemsdetail.getfocus() returns long [event]
	integer ll_row
	integer ll_custcode
	long ll_lastinvcode
	long ll_customerallowed
	long ancestorreturnvalue
	if f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	if parent.parent.parent.ii_saletype = 2 then
		ll_row = parent.parent.parent.id_master.getrow()
		ll_custcode = parent.parent.parent.id_master.object.custcode[ll_row]
		if parent.parent.parent.ii_focuscustomer = 2 and ll_custcode = 0 then
			post event ue_focuscustomer()
		end if
		if parent.parent.parent.ii_focuscustomer = 3 and ll_custcode > 0 and parent.parent.parent.il_custcode <> parent.parent.parent.il_allowedcustomer then
			parent.parent.parent.wf_check_creditlimit(ll_custcode, gl_usercode, 0)
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanging(long currentrow, long newrow) returns long [event]
	long ancestorreturnvalue
	string ls_holdstr
	ancestorreturnvalue = super::rowfocuschanging(currentrow, newrow)
	if currentrow <= rowcount() and f_stringpreferences("DisplayPool") = "Y" and (currentrow <> 0 and parent.parent.parent.ib_lcdshow = true) and parent.parent.parent.id_detail.rowcount() > 0 then
		ls_holdstr = this.object.itemname[currentrow]
		if len(ls_holdstr) < 20 then
			parent.parent.parent.is_lcditem = ls_holdstr + space(20 - len(ls_holdstr))
		else
			parent.parent.parent.is_lcditem = left(ls_holdstr, 20)
		end if
		parent.parent.parent.is_lcditem = parent.parent.parent.is_lcditem + "Qty=" + string(this.object.looseqty[currentrow])
		parent.parent.parent.is_lcditem = parent.parent.parent.is_lcditem + " Rs=" + string(this.object.saleprice[currentrow], "#######0.00")
		parent.parent.parent.ic_comport.postevent("ue_show")
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	integer li_rowno
	integer i
	integer li_columnno
	boolean lb_duplicate
	if parent.parent.parent.ii_saletype = 2 then
		if f_numberpreferences("CreditsaleDetailWindowFormat") = 1 then
			li_columnno = integer(this.object.datawindow.column.count)
		elseif f_stringpreferences("ShowPriceValuesInSaleOrder") = "Y" then
			li_columnno = integer(this.object.discperc.id)
		else
			li_columnno = integer(this.object.datawindow.column.count)
		end if
	end if
	if parent.parent.parent.ii_saletype = 3 then
		if f_numberpreferences("CashsaleDetailWindowFormat") = 1 then
			li_columnno = integer(this.object.datawindow.column.count)
		elseif f_stringpreferences("ShowPriceValuesInSaleOrder") = "Y" then
			li_columnno = integer(this.object.discperc.id)
		else
			li_columnno = integer(this.object.datawindow.column.count)
		end if
	end if
	if getrow() = rowcount() then
		for i = 1 to i
			if parent.parent.parent.id_detail.getitemstring(i, "fullcode") = parent.parent.parent.is_aliasname then
				lb_duplicate = true
			end if
		next
		if getcolumn() = 1 and not lb_duplicate and gs_company = "KSS" then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
		if getcolumn() = li_columnno then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
	elseif li_columnno = integer(this.object.datawindow.column.count) and getcolumn() = li_columnno then
		scrollnextrow()
		if f_stringpreferences("ItemCode") = "Y" then
			setcolumn(1)
		else
			setcolumn(2)
		end if
		setfocus()
		return 1
	end if
	li_rowno = gd_itemsinfo.find("fullcode='" + parent.parent.parent.is_aliasname + "'", 1, gd_itemsinfo.rowcount())
	if getcolumn() = 1 and li_rowno > 0 then
		parent.parent.parent.id_detail.setcolumn(integer(this.object.datawindow.column.count))
		setfocus()
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_icode
	long ll_row
	string ls_itemname
	string ls_aliasname
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	if getcolumn() = 1 then
		parent.parent.parent.is_aliasname = data
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_focusqty() returns 0 [event]
	call super::ue_focusqty

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_counter
	long ll_found
	long ll_rowm
	long ll_icode
	long ll_row
	string ls_itemname
	string ls_aliasname
	s_positem ls_itemdetail
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(99999)
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(1)
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf8! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("namesearch", parent.parent.parent.ii_module)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf9! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("criteriasearch", parent.parent.parent.ii_module)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf4! then
			parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
			setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
			setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	elseif key = keydownarrow! then
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_focusfooter")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	end if
	if getcolumnname() = "saleitemdescription" and key = keyf6! then
		parent.parent.parent.wf_setsaleitemdesc()
		rt_code = 1
	end if
	if getcolumnname() = "gcode" and key = keyf7! then
		parent.parent.parent.wf_searchgodown()
		rt_code = 1
	end if
	if getcolumnname() = "looseqty" and key = keyf5! then
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 545 then
				ls_itemdetail.i_qty = -1
				ls_itemdetail.l_icode = getitemnumber(getrow(), "icode")
				ls_itemdetail.i_module = 1
				if isnull(ls_itemdetail.l_icode) then
					messagebox("Item Validation", "Please select some item in the current row, than try again.")
				else
					openwithparm(w_popup_itempriority_settings, ls_itemdetail)
				end if
				exit
			end if
		next
		rt_code = 1
	end if
	return rt_code

// tabpage_list.create() returns 0 [event]
	integer icurrent
	this.st_3 = create st_3
	this.em_invno = create em_invno
	call super::create
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_3
	this.control[icurrent + 2] = this.em_invno

// tabpage_list.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_3
	destroy this.em_invno

// dw_find.keypressed(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::keypressed(key, keyflags)
	if key = keyf7! then
		parent.parent.parent.wf_show_saleordersupplier_info()
	elseif key = keyf8! then
		parent.parent.parent.wf_show_saleorder_purorder_info()
	end if
	return ::message.returnvalue

// em_invno.ue_downkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		parent.parent.parent.tab_retrieve.selecttab(1)
	end if
	return ::message.returnvalue

// ic_comport.ue_show() returns long [event]
	if isnull(parent.is_lcditem) then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
			parent.is_lcditem = char(26) + char(1)
			parent.ic_comport.triggerevent("ue_show")
			parent.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
			parent.ic_comport.triggerevent("ue_show")
			return 1
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
			parent.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
		else
			parent.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
		end if
	end if
	this.object.portopen = true
	if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
		this.object.output = char(26) + parent.is_lcditem
	elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
		this.object.output = char(12) + parent.is_lcditem
	else
		this.object.output = char(12) + parent.is_lcditem
	end if
	this.object.portopen = false
	return 1

// ic_comport.constructor() returns long [event]
	integer li_defaultcomport
	if f_stringpreferences("DisplayPool") = "Y" then
		li_defaultcomport = f_numberpreferences("DefaultComPort")
		if isnull(li_defaultcomport) then
			li_defaultcomport = 1
		end if
		this.object.commport = li_defaultcomport
		this.object.settings = "9600,N,8,1"
		this.object.inputlen = 0
	end if
	return ::message.returnvalue

// ic_drawerport.constructor() returns long [event]
	integer li_defaultcomport
	if f_stringpreferences("CashDrawer") = "Y" then
		li_defaultcomport = f_numberpreferences("CashDrawerComPort")
		if isnull(li_defaultcomport) then
			li_defaultcomport = 1
		end if
		this.object.commport = li_defaultcomport
		this.object.settings = "300,N,8,1"
		this.object.inputlen = 0
	end if
	return ::message.returnvalue
