// window w_populate_finalizedsaleorder (saleorder)  ancestor: window

// w_populate_finalizedsaleorder.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		post event ue_close()
	end if
	return ::message.returnvalue

// w_populate_finalizedsaleorder.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// w_populate_finalizedsaleorder.wf_assigndwobjects(string as_masterdw, string as_detaildw, string as_footerdw) returns 0
	this.dw_master.dataobject = as_masterdw
	this.dw_detail.dataobject = as_detaildw
	this.dw_footer.dataobject = as_footerdw
	this.dw_master.settransobject(sqlca)
	this.dw_detail.settransobject(sqlca)
	this.dw_footer.settransobject(sqlca)

// w_populate_finalizedsaleorder.create() returns 0 [event]
	this.rb_pricefrombasicdata = create rb_pricefrombasicdata
	this.rb_pricefromso = create rb_pricefromso
	this.rb_eqty = create rb_eqty
	this.rb_totqty = create rb_totqty
	this.cb_ok = create cb_ok
	this.dw_footer = create dw_footer
	this.dw_master = create dw_master
	this.dw_detail = create dw_detail
	this.gb_1 = create gb_1
	this.gb_2 = create gb_2
	this.control = {this.rb_pricefrombasicdata, this.rb_pricefromso, this.rb_eqty, this.rb_totqty, this.cb_ok, this.dw_footer, this.dw_master, this.dw_detail, this.gb_1, this.gb_2}

// w_populate_finalizedsaleorder.destroy() returns 0 [event]
	destroy this.rb_pricefrombasicdata
	destroy this.rb_pricefromso
	destroy this.rb_eqty
	destroy this.rb_totqty
	destroy this.cb_ok
	destroy this.dw_footer
	destroy this.dw_master
	destroy this.dw_detail
	destroy this.gb_1
	destroy this.gb_2

// w_populate_finalizedsaleorder.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_custcode
	ll_custcode = message.doubleparm
	if isnull(ll_custcode) or ll_custcode = 0 then
		messagebox("Customer Validation", "Can not populate sale invoices~r~nPlease Select Valid Customer")
		post event ue_close()
	end if
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	this.title = "Populate Finalized Sale Order(s)"
	wf_assigndwobjects("d_customerinfo", "d_populate_finalizedsaleorder_for_sales", "")
	this.dw_master.retrieve(ll_custcode)
	this.dw_detail.retrieve(ll_custcode)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_ok.clicked() returns long [event]
	long[] ll_invcode
	long ll_rowcount
	long ll_counter
	long ll_arrindex
	long ll_thiscode
	boolean lb_remarks
	boolean lb_invoiceexists
	string ls_date
	ll_rowcount = parent.dw_detail.rowcount()
	for ll_counter = 1 to ll_rowcount
		if parent.dw_detail.getitemstring(ll_counter, "selected") = "Y" then
			lb_invoiceexists = true
			ll_arrindex = ll_arrindex + 1
			ll_thiscode = parent.dw_detail.getitemnumber(ll_counter, "saleordercode")
			parent.istr_arg.ia_integerlist[ll_arrindex] = ll_thiscode
		end if
	next
	if lb_invoiceexists then
		parent.istr_arg.i_status = 1
	end if
	if parent.rb_eqty.checked = true then
		parent.istr_arg.l_code1 = 1
	else
		parent.istr_arg.l_code1 = 0
	end if
	if parent.rb_pricefrombasicdata.checked = true then
		parent.istr_arg.l_code2 = 1
	else
		parent.istr_arg.l_code2 = 0
	end if
	parent.post event ue_close()
	return ::message.returnvalue
