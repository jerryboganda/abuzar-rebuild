// window w_itembreakup_in_consolidatedsaleorder (saleorder)  ancestor: window

// w_itembreakup_in_consolidatedsaleorder.create() returns 0
	this.cb_close = create cb_close
	this.cb_print = create cb_print
	this.dw_report = create dw_report
	this.control = {this.cb_close, this.cb_print, this.dw_report}

// w_itembreakup_in_consolidatedsaleorder.destroy() returns 0
	destroy this.cb_close
	destroy this.cb_print
	destroy this.dw_report

// w_itembreakup_in_consolidatedsaleorder.open() returns long
	long ll_width
	long ll_height
	long ll_counter
	long ll_currentrow
	environment env
	this.lstr_arg = message.powerobjectparm
	if getenvironment(env) = 1 then
		ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_height = pixelstounits(env.screenheight, ypixelstounits!)
		setredraw(false)
		this.width = ll_width * 0.98
		this.height = ll_height * 0.90
		this.y = int((ll_height - this.height) / 2.0)
		this.dw_report.width = this.width - this.width * 0.02
		this.dw_report.height = this.height * 0.90
		this.cb_print.y = this.dw_report.height + 50
		this.cb_close.y = this.dw_report.height + 50
	end if
	this.dw_report.settransobject(sqlca)
	this.dw_report.retrieve(this.lstr_arg.l_code1, this.lstr_arg.l_code2)
	this.dw_report.modify("DataWindow.Print.Preview=yes")
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_itembreakup_in_consolidatedsaleorder.key(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		close(this)
	end if
	return ::message.returnvalue

// cb_close.clicked() returns long
	close(parent)
	return ::message.returnvalue

// cb_print.clicked() returns long
	if parent.dw_report.visible then
		if printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			parent.dw_report.printcancel()
		end if
		parent.dw_report.print()
	end if
	return ::message.returnvalue
