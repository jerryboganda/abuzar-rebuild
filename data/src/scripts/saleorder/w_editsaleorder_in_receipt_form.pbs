// window w_editsaleorder_in_receipt_form (saleorder)  ancestor: window

// w_editsaleorder_in_receipt_form.ue_close(integer ai_status) returns 0 [event]
	closewithreturn(this, this.istr_template)

// w_editsaleorder_in_receipt_form.create() returns 0 [event]
	this.rb_keepsobatch = create rb_keepsobatch
	this.em_expiry = create em_expiry
	this.st_1 = create st_1
	this.rb_saleorderbatch = create rb_saleorderbatch
	this.rb_defbatch = create rb_defbatch
	this.st_template = create st_template
	this.dw_template = create dw_template
	this.cb_ok = create cb_ok
	this.gb_batch = create gb_batch
	this.control = {this.rb_keepsobatch, this.em_expiry, this.st_1, this.rb_saleorderbatch, this.rb_defbatch, this.st_template, this.dw_template, this.cb_ok, this.gb_batch}

// w_editsaleorder_in_receipt_form.destroy() returns 0 [event]
	destroy this.rb_keepsobatch
	destroy this.em_expiry
	destroy this.st_1
	destroy this.rb_saleorderbatch
	destroy this.rb_defbatch
	destroy this.st_template
	destroy this.dw_template
	destroy this.cb_ok
	destroy this.gb_batch

// w_editsaleorder_in_receipt_form.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	this.dw_template.settransobject(sqlca)
	this.dw_template.insertrow(0)
	this.dw_template.scrolltorow(0)
	this.em_expiry.text = string(f_datepreferences("defaultexpiry"), "dd/mm/yyyy")
	return ::message.returnvalue

// w_editsaleorder_in_receipt_form.key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		this.istr_template.c_copyinvfrom = "N"
		this.istr_template.l_invtemplate = -1
		post event ue_close(1)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	date ld_date
	if isnull(parent.dw_template.getitemnumber(1, "saleordercode")) then
		return ::message.returnvalue
	end if
	parent.istr_template.c_copyinvfrom = "T"
	parent.istr_template.l_invtemplate = parent.dw_template.getitemnumber(1, "saleordercode")
	if parent.rb_defbatch.checked = true then
		parent.istr_template.i_invtype = 0
	end if
	if parent.rb_saleorderbatch.checked = true then
		parent.istr_template.i_invtype = 1
	end if
	if parent.rb_keepsobatch.checked = true then
		parent.istr_template.i_invtype = 2
	end if
	parent.em_expiry.getdata(ld_date)
	parent.istr_template.d_date = datetime(ld_date, time("00:00:00"))
	parent.post event ue_close(1)
	return ::message.returnvalue
