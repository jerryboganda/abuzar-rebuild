// window w_editsaleorder_inproformasale_finalized (saleorder)  ancestor: window

// w_editsaleorder_inproformasale_finalized.ue_close(integer ai_status) returns 0 [event]
	closewithreturn(this, this.istr_template)

// w_editsaleorder_inproformasale_finalized.create() returns 0 [event]
	this.st_template = create st_template
	this.dw_template = create dw_template
	this.cb_ok = create cb_ok
	this.control = {this.st_template, this.dw_template, this.cb_ok}

// w_editsaleorder_inproformasale_finalized.destroy() returns 0 [event]
	destroy this.st_template
	destroy this.dw_template
	destroy this.cb_ok

// w_editsaleorder_inproformasale_finalized.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	this.dw_template.settransobject(sqlca)
	this.dw_template.insertrow(0)
	this.dw_template.scrolltorow(0)
	return ::message.returnvalue

// w_editsaleorder_inproformasale_finalized.key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		this.istr_template.c_copyinvfrom = "N"
		this.istr_template.l_invtemplate = -1
		post event ue_close(1)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	if isnull(parent.dw_template.getitemnumber(1, "saleordercode")) then
		return ::message.returnvalue
	end if
	parent.istr_template.c_copyinvfrom = "T"
	parent.istr_template.l_invtemplate = parent.dw_template.getitemnumber(1, "saleordercode")
	parent.istr_template.i_invtype = 0
	parent.post event ue_close(1)
	return ::message.returnvalue
