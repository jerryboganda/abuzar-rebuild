// window w_saleordercategory_form (saleorder)  ancestor: w_single_entry

// w_saleordercategory_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM SaleOrderCategory WHERE SaleOrderCategory.name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_saleordercategory_form.wf_duplicate_shortname(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM SaleOrderCategory WHERE SaleOrderCategory.shortname =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_saleordercategory_form.create() returns 0 [event]
	call super::create

// w_saleordercategory_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_saleordercategory_form.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "SaleOrderCategory"
	return ::message.returnvalue

// w_saleordercategory_form.ue_detail() returns 0 [event]
	integer li_protect
	call super::ue_detail
	if this.id_detail.object.posted[this.id_detail.rowcount()] = "Y" then
		this.im_menu.m_file.m_save.enabled = false
		li_protect = 1
	else
		this.im_menu.m_file.m_save.enabled = true
		li_protect = 0
	end if
	wf_protectdw(this.id_detail, li_protect)

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "name"
		if parent.parent.parent.wf_duplicatename(data) then
			messagebox("Name Validation", "Duplication Name Error~n~rPlease Choose Some Other Name")
			return 1
		end if
	case "shortname"
		if parent.parent.parent.wf_duplicate_shortname(data) then
			messagebox("Short Name Validation", "Duplication of Short Name Error~n~rPlease Choose Some Other Short Name")
			return 1
		end if
	end choose
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "name"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	end choose
	return 1
