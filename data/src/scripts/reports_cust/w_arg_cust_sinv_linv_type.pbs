// window w_arg_cust_sinv_linv_type (reports_cust)  ancestor: w_popup_forselection_walias

// w_arg_cust_sinv_linv_type.create() returns 0
	integer icurrent
	call super::create
	this.gb_2 = create gb_2
	this.st_1 = create st_1
	this.st_2 = create st_2
	this.em_startdate = create em_startdate
	this.em_enddate = create em_enddate
	this.dw_startendinvoice = create dw_startendinvoice
	this.st_5 = create st_5
	this.st_6 = create st_6
	this.cbx_cash = create cbx_cash
	this.cbx_credit = create cbx_credit
	this.em_disc = create em_disc
	this.st_3 = create st_3
	this.gb_3 = create gb_3
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_2
	this.control[icurrent + 2] = this.st_1
	this.control[icurrent + 3] = this.st_2
	this.control[icurrent + 4] = this.em_startdate
	this.control[icurrent + 5] = this.em_enddate
	this.control[icurrent + 6] = this.dw_startendinvoice
	this.control[icurrent + 7] = this.st_5
	this.control[icurrent + 8] = this.st_6
	this.control[icurrent + 9] = this.cbx_cash
	this.control[icurrent + 10] = this.cbx_credit
	this.control[icurrent + 11] = this.em_disc
	this.control[icurrent + 12] = this.st_3
	this.control[icurrent + 13] = this.gb_3

// w_arg_cust_sinv_linv_type.destroy() returns 0
	call super::destroy
	destroy this.gb_2
	destroy this.st_1
	destroy this.st_2
	destroy this.em_startdate
	destroy this.em_enddate
	destroy this.dw_startendinvoice
	destroy this.st_5
	destroy this.st_6
	destroy this.cbx_cash
	destroy this.cbx_credit
	destroy this.em_disc
	destroy this.st_3
	destroy this.gb_3

// w_arg_cust_sinv_linv_type.open() returns long
	long ancestorreturnvalue
	date ld_currdate
	string ls_text
	ancestorreturnvalue = super::open()
	ld_currdate = today()
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 00:00:00"
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.em_enddate.text = ls_text
	this.dw_startendinvoice.settransobject(sqlca)
	this.dw_startendinvoice.insertrow(0)
	this.dw_startendinvoice.scrolltorow(0)
	return ::message.returnvalue

// w_arg_cust_sinv_linv_type.ue_close() returns 0
	closewithreturn(this, this.istr_arg)

// em_startdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_enddate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// dw_startendinvoice.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
