// window w_arg_areas_for_a_zone_region (reports_cust)  ancestor: w_listarguments

// w_arg_areas_for_a_zone_region.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_selectable = create st_selectable
	this.st_selected = create st_selected
	this.rb_posted = create rb_posted
	this.rb_unposted = create rb_unposted
	this.rb_both = create rb_both
	this.gb_5 = create gb_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_selectable
	this.control[icurrent + 2] = this.st_selected
	this.control[icurrent + 3] = this.rb_posted
	this.control[icurrent + 4] = this.rb_unposted
	this.control[icurrent + 5] = this.rb_both
	this.control[icurrent + 6] = this.gb_5

// w_arg_areas_for_a_zone_region.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_selectable
	destroy this.st_selected
	destroy this.rb_posted
	destroy this.rb_unposted
	destroy this.rb_both
	destroy this.gb_5

// w_arg_areas_for_a_zone_region.open() returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.istr_arg = message.powerobjectparm
	this.is_dataobject = "d_arg_areas_for_a_region_zone"
	this.is_colname = "areacode"
	this.is_childcolname = "areacode"
	this.st_selectable.text = "Area(s)"
	this.st_selected.text = "Area(s)"
	this.dw_control.dataobject = this.is_dataobject
	this.dw_control.settransobject(sqlca)
	rtncode = this.dw_control.getchild(this.is_colname, this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	this.idc_categories.settransobject(sqlca)
	this.idc_categories.retrieve(this.istr_arg.l_code1, this.istr_arg.s_name1)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_price.settransobject(sqlca)
	this.dw_price.insertrow(0)
	this.dw_price.scrolltorow(0)
	this.dw_price.setitem(1, "price", 1)
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, parent.is_childcolname)
		next
	else
		for ll_counter = 1 to parent.lb_selectedcategories.totalitems()
			ll_found = parent.idc_categories.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, parent.is_childcolname)
			end if
		next
	end if
	parent.istr_arg.l_code2 = parent.dw_price.getitemnumber(1, "price")
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if parent.rb_posted.checked = true then
		parent.istr_arg.sa_stringlist[1] = "Y"
	elseif parent.rb_unposted.checked = true then
		parent.istr_arg.sa_stringlist[1] = "N"
	elseif parent.rb_both.checked = true then
		parent.istr_arg.sa_stringlist[1] = "Y"
		parent.istr_arg.sa_stringlist[2] = "N"
	end if
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
