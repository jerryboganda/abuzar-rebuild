// window w_arg_zone_sdate_ldate_top_n_customer (reports_cust)  ancestor: w_arguements

// w_arg_zone_sdate_ldate_top_n_customer.create() returns 0 [event]
	integer icurrent
	call super::create
	this.dw_custcount = create dw_custcount
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_custcount

// w_arg_zone_sdate_ldate_top_n_customer.destroy() returns 0 [event]
	call super::destroy
	destroy this.dw_custcount

// w_arg_zone_sdate_ldate_top_n_customer.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_custcount.settransobject(sqlca)
	this.dw_custcount.insertrow(0)
	this.dw_custcount.scrolltorow(0)
	return ::message.returnvalue

// w_arg_zone_sdate_ldate_top_n_customer.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.dw_custcount.accepttext()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "zonecode")
	if isnull(parent.istr_arg.l_code1) then
		parent.istr_arg.l_code1 = 0
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.l_code2 = parent.dw_custcount.object.count[1]
	if parent.istr_arg.l_code2 <= 0 or isnull(parent.istr_arg.l_code2) then
		messagebox("Number of Customer Validation!", "Please enter valid value")
		parent.dw_custcount.setfocus()
		return ::message.returnvalue
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_custcount.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
