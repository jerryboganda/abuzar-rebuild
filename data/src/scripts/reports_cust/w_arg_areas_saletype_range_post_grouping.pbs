// window w_arg_areas_saletype_range_post_grouping (reports_cust)  ancestor: w_listarguments

// w_arg_areas_saletype_range_post_grouping.create() returns 0
	integer icurrent
	call super::create
	this.cbx_posted = create cbx_posted
	this.cbx_unposted = create cbx_unposted
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.dw_grouping = create dw_grouping
	this.lb_selectablesaletype = create lb_selectablesaletype
	this.lb_selectedsaletype = create lb_selectedsaletype
	this.st_9 = create st_9
	this.st_10 = create st_10
	this.dw_control2 = create dw_control2
	this.cbx_allsaletype = create cbx_allsaletype
	this.gb_5 = create gb_5
	this.gb_6 = create gb_6
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.cbx_posted
	this.control[icurrent + 2] = this.cbx_unposted
	this.control[icurrent + 3] = this.st_4
	this.control[icurrent + 4] = this.st_8
	this.control[icurrent + 5] = this.dw_grouping
	this.control[icurrent + 6] = this.lb_selectablesaletype
	this.control[icurrent + 7] = this.lb_selectedsaletype
	this.control[icurrent + 8] = this.st_9
	this.control[icurrent + 9] = this.st_10
	this.control[icurrent + 10] = this.dw_control2
	this.control[icurrent + 11] = this.cbx_allsaletype
	this.control[icurrent + 12] = this.gb_5
	this.control[icurrent + 13] = this.gb_6

// w_arg_areas_saletype_range_post_grouping.destroy() returns 0
	call super::destroy
	destroy this.cbx_posted
	destroy this.cbx_unposted
	destroy this.st_4
	destroy this.st_8
	destroy this.dw_grouping
	destroy this.lb_selectablesaletype
	destroy this.lb_selectedsaletype
	destroy this.st_9
	destroy this.st_10
	destroy this.dw_control2
	destroy this.cbx_allsaletype
	destroy this.gb_5
	destroy this.gb_6

// w_arg_areas_saletype_range_post_grouping.open() returns long
	long ancestorreturnvalue
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.insertrow(0)
	this.dw_control2.scrolltorow(0)
	this.dw_grouping.settransobject(sqlca)
	this.dw_grouping.insertrow(0)
	this.dw_grouping.scrolltorow(0)
	this.dw_grouping.setitem(1, "grouping", 2)
	rtncode = this.dw_control.getchild("area", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	rtncode = this.dw_control2.getchild("saletypecode", this.idc_saletype)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_saletype.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_selectablesaletype.additem(this.idc_saletype.getitemstring(ll_counter, "name"))
	next
	this.dw_startendinvoice.settransobject(sqlca)
	this.dw_startendinvoice.insertrow(0)
	this.dw_startendinvoice.scrolltorow(0)
	return ::message.returnvalue

// cbx_posted.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// cbx_unposted.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// dw_grouping.ue_enterkey() returns long
	send(handle(this), 256, 9, long(90))
	return 1

// lb_selectablesaletype.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_selectablesaletype.doubleclicked(integer index) returns long
	string ls_item
	long ll_selectedindex
	ls_item = string(selecteditem())
	ll_selectedindex = selectedindex()
	if not isnull(ls_item) and index >= 1 then
		parent.lb_selectedsaletype.additem(ls_item)
		deleteitem(index)
		if ll_selectedindex > 1 then
			if totalitems() < ll_selectedindex then
				selectitem(totalitems())
			else
				selectitem(ll_selectedindex)
			end if
		else
			selectitem(1)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selectable listbox")
	end if
	return ::message.returnvalue

// lb_selectablesaletype.getfocus() returns long
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue

// lb_selectedsaletype.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_selectedsaletype.doubleclicked(integer index) returns long
	string ls_item
	long ll_selectedindex
	ll_selectedindex = selectedindex()
	ls_item = string(selecteditem())
	if not isnull(ls_item) and index >= 1 then
		parent.lb_selectablesaletype.additem(ls_item)
		deleteitem(index)
		if totalitems() < ll_selectedindex then
			selectitem(totalitems())
		else
			selectitem(ll_selectedindex)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selected listbox")
	end if
	return ::message.returnvalue

// lb_selectedsaletype.getfocus() returns long
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue

// cbx_allsaletype.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
