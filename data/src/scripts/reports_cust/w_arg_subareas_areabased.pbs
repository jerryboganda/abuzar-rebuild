// window w_arg_subareas_areabased (reports_cust)  ancestor: w_listarguments

// w_arg_subareas_areabased.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8

// w_arg_subareas_areabased.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_8

// w_arg_subareas_areabased.open() returns long [event]
	long ancestorreturnvalue
	s_arguements lstr_arg
	long ll_counter
	long ll_rowcount
	integer rtncode
	listviewitem l_lvi
	ancestorreturnvalue = super::open()
	lstr_arg = message.powerobjectparm
	this.dw_control.settransobject(sqlca)
	rtncode = this.dw_control.getchild("subareacode", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	this.idc_categories.settransobject(sqlca)
	this.idc_categories.retrieve(lstr_arg.ia_integerlist)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	this.em_startdate.text = string(today(), "dd/mm/yyyy hh:mm:ss")
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_found
	ancestorreturnvalue = super::clicked()
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "subareacode")
		next
	else
		for ll_counter = 1 to parent.lb_selectedcategories.totalitems()
			ll_found = parent.idc_categories.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "subareacode")
			end if
		next
	end if
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.la_longlist = parent.istr_arg.ia_integerlist
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
