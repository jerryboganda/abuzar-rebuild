// window w_arg_custcat_sdate_ldate_comment (reports_cust)  ancestor: w_arguements

// w_arg_custcat_sdate_ldate_comment.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.em_note1 = create em_note1
	this.em_note2 = create em_note2
	this.em_note3 = create em_note3
	this.em_note4 = create em_note4
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.em_note1
	this.control[icurrent + 3] = this.em_note2
	this.control[icurrent + 4] = this.em_note3
	this.control[icurrent + 5] = this.em_note4

// w_arg_custcat_sdate_ldate_comment.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.em_note1
	destroy this.em_note2
	destroy this.em_note3
	destroy this.em_note4

// w_arg_custcat_sdate_ldate_comment.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_custcat_sdate_ldate_comment.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "custcatcode")
	if parent.istr_arg.l_code1 = 0 or isnull(parent.istr_arg.l_code1) then
		messagebox("Customer category Validation", "Please Select Valid Customer Category")
		parent.dw_control.setcolumn("custcatcode")
		parent.dw_control.setfocus()
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.em_note1.getdata(parent.istr_arg.s_name1)
	parent.em_note2.getdata(parent.istr_arg.s_name2)
	parent.em_note3.getdata(parent.istr_arg.s_name3)
	parent.em_note4.getdata(parent.istr_arg.s_name4)
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// em_note1.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

