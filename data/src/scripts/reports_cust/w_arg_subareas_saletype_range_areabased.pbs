// window w_arg_subareas_saletype_range_areabased (reports_cust)  ancestor: w_listarguments

// w_arg_subareas_saletype_range_areabased.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_8 = create st_8
	this.dw_grouping = create dw_grouping
	this.lb_selectablesaletype = create lb_selectablesaletype
	this.lb_selectedsaletype = create lb_selectedsaletype
	this.st_9 = create st_9
	this.st_10 = create st_10
	this.dw_control2 = create dw_control2
	this.cbx_allsaletype = create cbx_allsaletype
	this.cbx_saleinv = create cbx_saleinv
	this.cbx_storesumm = create cbx_storesumm
	this.gb_6 = create gb_6
	this.gb_5 = create gb_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_8
	this.control[icurrent + 3] = this.dw_grouping
	this.control[icurrent + 4] = this.lb_selectablesaletype
	this.control[icurrent + 5] = this.lb_selectedsaletype
	this.control[icurrent + 6] = this.st_9
	this.control[icurrent + 7] = this.st_10
	this.control[icurrent + 8] = this.dw_control2
	this.control[icurrent + 9] = this.cbx_allsaletype
	this.control[icurrent + 10] = this.cbx_saleinv
	this.control[icurrent + 11] = this.cbx_storesumm
	this.control[icurrent + 12] = this.gb_6
	this.control[icurrent + 13] = this.gb_5

// w_arg_subareas_saletype_range_areabased.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_8
	destroy this.dw_grouping
	destroy this.lb_selectablesaletype
	destroy this.lb_selectedsaletype
	destroy this.st_9
	destroy this.st_10
	destroy this.dw_control2
	destroy this.cbx_allsaletype
	destroy this.cbx_saleinv
	destroy this.cbx_storesumm
	destroy this.gb_6
	destroy this.gb_5

// w_arg_subareas_saletype_range_areabased.open() returns long [event]
	long ancestorreturnvalue
	s_arguements lstr_arg
	long ll_counter
	long ll_rowcount
	integer rtncode
	ancestorreturnvalue = super::open()
	lstr_arg = message.powerobjectparm
	this.dw_control.settransobject(sqlca)
	rtncode = this.dw_control.getchild("subareacode", this.idc_categories)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	this.idc_categories.settransobject(sqlca)
	this.idc_categories.retrieve(lstr_arg.ia_integerlist)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_control2.settransobject(sqlca)
	this.dw_control2.insertrow(0)
	this.dw_control2.scrolltorow(0)
	this.dw_grouping.settransobject(sqlca)
	this.dw_grouping.insertrow(0)
	this.dw_grouping.scrolltorow(0)
	this.dw_grouping.setitem(1, "grouping", 2)
	ll_rowcount = this.idc_categories.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_categories.additem(this.idc_categories.getitemstring(ll_counter, "name"))
	next
	rtncode = this.dw_control2.getchild("saletypecode", this.idc_saletype)
	if rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rowcount = this.idc_saletype.rowcount()
	for ll_counter = 1 to ll_rowcount
		this.lb_selectablesaletype.additem(this.idc_saletype.getitemstring(ll_counter, "name"))
	next
	this.dw_startendinvoice.settransobject(sqlca)
	this.dw_startendinvoice.insertrow(0)
	this.dw_startendinvoice.scrolltorow(0)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	long ll_count
	long ll_counter
	long ll_innercounter
	long ll_found
	integer li_temp
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.s_name1 = ""
	if parent.cbx_all.checked = true then
		for ll_counter = 1 to parent.idc_categories.rowcount()
			parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_counter, "subareacode")
		next
		for ll_counter = 1 to parent.lb_categories.totalitems()
			parent.istr_arg.s_name1 = parent.istr_arg.s_name1 + parent.lb_categories.text(ll_counter) + ", "
		next
	else
		for ll_counter = 1 to parent.lb_selectedcategories.totalitems()
			ll_found = parent.idc_categories.find("name ='" + parent.lb_selectedcategories.text(ll_counter) + "'", 1, parent.idc_categories.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist[ll_counter] = parent.idc_categories.getitemnumber(ll_found, "subareacode")
			end if
			parent.istr_arg.s_name1 = parent.istr_arg.s_name1 + parent.lb_selectedcategories.text(ll_counter) + ", "
		next
	end if
	parent.istr_arg.s_name2 = ""
	if parent.cbx_allsaletype.checked = true then
		for ll_counter = 1 to parent.idc_saletype.rowcount()
			parent.istr_arg.ia_integerlist1[ll_counter] = parent.idc_saletype.getitemnumber(ll_counter, "saletypecode")
		next
		for ll_counter = 1 to parent.lb_selectablesaletype.totalitems()
			parent.istr_arg.s_name2 = parent.istr_arg.s_name2 + parent.lb_selectablesaletype.text(ll_counter) + ", "
		next
	else
		for ll_counter = 1 to parent.lb_selectedsaletype.totalitems()
			ll_found = parent.idc_saletype.find("name ='" + parent.lb_selectedsaletype.text(ll_counter) + "'", 1, parent.idc_saletype.rowcount())
			if ll_found > 0 then
				parent.istr_arg.ia_integerlist1[ll_counter] = parent.idc_saletype.getitemnumber(ll_found, "saletypecode")
			end if
		next
		for ll_counter = 1 to parent.lb_selectablesaletype.totalitems()
			parent.istr_arg.s_name2 = parent.istr_arg.s_name2 + parent.lb_selectablesaletype.text(ll_counter) + ", "
		next
	end if
	parent.dw_startendinvoice.accepttext()
	parent.istr_arg.l_code1 = parent.dw_startendinvoice.getitemnumber(1, "sinvcode")
	parent.istr_arg.l_code2 = parent.dw_startendinvoice.getitemnumber(1, "linvcode")
	if parent.istr_arg.l_code1 > parent.istr_arg.l_code2 then
		li_temp = parent.istr_arg.l_code1
		parent.istr_arg.l_code1 = parent.istr_arg.l_code2
		parent.istr_arg.l_code2 = li_temp
	end if
	parent.dw_grouping.accepttext()
	parent.istr_arg.l_code3 = parent.dw_grouping.getitemnumber(1, "grouping")
	if parent.cbx_storesumm.checked = true then
		parent.istr_arg.l_code4 = 1
	else
		parent.istr_arg.l_code4 = 0
	end if
	if parent.cbx_saleinv.checked = true then
		parent.istr_arg.l_code5 = 1
	else
		parent.istr_arg.l_code5 = 0
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_grouping.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// lb_selectablesaletype.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_selectablesaletype.doubleclicked(integer index) returns long [event]
	string ls_item
	long ll_selectedindex
	ls_item = string(selecteditem())
	ll_selectedindex = selectedindex()
	if not isnull(ls_item) and index >= 1 then
		parent.lb_selectedsaletype.additem(ls_item)
		deleteitem(index)
		if ll_selectedindex > 1 then
			if totalitems() < ll_selectedindex then
				selectitem(totalitems())
			else
				selectitem(ll_selectedindex)
			end if
		else
			selectitem(1)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selectable listbox")
	end if
	return ::message.returnvalue

// lb_selectablesaletype.getfocus() returns long [event]
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue

// lb_selectedsaletype.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_selectedsaletype.doubleclicked(integer index) returns long [event]
	string ls_item
	long ll_selectedindex
	ll_selectedindex = selectedindex()
	ls_item = string(selecteditem())
	if not isnull(ls_item) and index >= 1 then
		parent.lb_selectablesaletype.additem(ls_item)
		deleteitem(index)
		if totalitems() < ll_selectedindex then
			selectitem(totalitems())
		else
			selectitem(ll_selectedindex)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selected listbox")
	end if
	return ::message.returnvalue

// lb_selectedsaletype.getfocus() returns long [event]
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue

// cbx_allsaletype.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
