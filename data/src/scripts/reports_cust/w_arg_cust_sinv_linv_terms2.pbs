	this.st_4 = create st_4
	this.em_discperc = create em_discperc
	this.st_8 = create st_8
	this.gb_3 = create gb_3
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_2
	this.control[icurrent + 2] = this.st_1
	this.control[icurrent + 3] = this.st_2
	this.control[icurrent + 4] = this.em_startdate
	this.control[icurrent + 5] = this.em_enddate
	this.control[icurrent + 6] = this.dw_startendinvoice
	this.control[icurrent + 7] = this.st_5
	this.control[icurrent + 8] = this.st_6
	this.control[icurrent + 9] = this.em_caption
	this.control[icurrent + 10] = this.st_7
	this.control[icurrent + 11] = this.em_caption2
	this.control[icurrent + 12] = this.st_3
	this.control[icurrent + 13] = this.em_caption3
	this.control[icurrent + 14] = this.st_4
	this.control[icurrent + 15] = this.em_discperc
	this.control[icurrent + 16] = this.st_8
	this.control[icurrent + 17] = this.gb_3

// w_arg_cust_sinv_linv_terms2.destroy() returns 0
