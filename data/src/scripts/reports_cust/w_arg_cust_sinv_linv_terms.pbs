// window w_arg_cust_sinv_linv_terms (reports_cust)  ancestor: w_popup_forselection_walias

// w_arg_cust_sinv_linv_terms.create() returns 0 [event]
	integer icurrent
	call super::create
	this.gb_2 = create gb_2
	this.st_1 = create st_1
	this.st_2 = create st_2
	this.em_startdate = create em_startdate
	this.em_enddate = create em_enddate
	this.dw_startendinvoice = create dw_startendinvoice
	this.st_3 = create st_3
	this.st_4 = create st_4
	this.em_term1 = create em_term1
	this.em_term2 = create em_term2
	this.st_5 = create st_5
	this.st_6 = create st_6
	this.em_caption = create em_caption
	this.st_7 = create st_7
	this.gb_3 = create gb_3
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_2
	this.control[icurrent + 2] = this.st_1
	this.control[icurrent + 3] = this.st_2
	this.control[icurrent + 4] = this.em_startdate
	this.control[icurrent + 5] = this.em_enddate
	this.control[icurrent + 6] = this.dw_startendinvoice
	this.control[icurrent + 7] = this.st_3
	this.control[icurrent + 8] = this.st_4
	this.control[icurrent + 9] = this.em_term1
	this.control[icurrent + 10] = this.em_term2
	this.control[icurrent + 11] = this.st_5
	this.control[icurrent + 12] = this.st_6
	this.control[icurrent + 13] = this.em_caption
	this.control[icurrent + 14] = this.st_7
	this.control[icurrent + 15] = this.gb_3

// w_arg_cust_sinv_linv_terms.destroy() returns 0 [event]
	call super::destroy
	destroy this.gb_2
	destroy this.st_1
	destroy this.st_2
	destroy this.em_startdate
	destroy this.em_enddate
	destroy this.dw_startendinvoice
	destroy this.st_3
	destroy this.st_4
	destroy this.em_term1
	destroy this.em_term2
	destroy this.st_5
	destroy this.st_6
	destroy this.em_caption
	destroy this.st_7
	destroy this.gb_3

// w_arg_cust_sinv_linv_terms.open() returns long [event]
	long ancestorreturnvalue
	date ld_currdate
	string ls_text
	ancestorreturnvalue = super::open()
	ld_currdate = today()
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 00:00:00"
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.em_enddate.text = ls_text
	this.dw_startendinvoice.settransobject(sqlca)
	this.dw_startendinvoice.insertrow(0)
	this.dw_startendinvoice.scrolltorow(0)
	return ::message.returnvalue

// w_arg_cust_sinv_linv_terms.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.id_selected.getitemnumber(1, "code")
	if isnull(parent.istr_arg.l_code1) then
		parent.istr_arg.l_code1 = 0
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if parent.dw_startendinvoice.accepttext() = 1 then
		parent.istr_arg.l_code2 = parent.dw_startendinvoice.getitemnumber(1, "sinvcode")
		parent.istr_arg.l_code3 = parent.dw_startendinvoice.getitemnumber(1, "linvcode")
	else
		return ::message.returnvalue
	end if
	parent.em_caption.getdata(parent.istr_arg.s_name1)
	parent.em_term1.getdata(parent.istr_arg.sa_stringlist[1])
	parent.em_term2.getdata(parent.istr_arg.sa_stringlist[2])
	parent.istr_arg.i_status = 1
	return ::message.returnvalue

// em_startdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_enddate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// dw_startendinvoice.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_term1.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_term2.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_caption.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue
