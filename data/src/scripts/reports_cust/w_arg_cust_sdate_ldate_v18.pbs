// window w_arg_cust_sdate_ldate_v18 (reports_cust)  ancestor: w_popup_forselection_walias

// w_arg_cust_sdate_ldate_v18.create() returns 0 [event]
	integer icurrent
	call super::create
	this.gb_3 = create gb_3
	this.gb_2 = create gb_2
	this.st_1 = create st_1
	this.st_2 = create st_2
	this.em_startdate = create em_startdate
	this.em_enddate = create em_enddate
	this.st_3 = create st_3
	this.st_4 = create st_4
	this.em_caption = create em_caption
	this.em_discperc = create em_discperc
	this.rb_originaldate = create rb_originaldate
	this.rb_lastsavingdate = create rb_lastsavingdate
	this.rb_billingdate = create rb_billingdate
	this.em_term1 = create em_term1
	this.em_term2 = create em_term2
	this.st_5 = create st_5
	this.st_6 = create st_6
	this.cbx_suppressheader = create cbx_suppressheader
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_3
	this.control[icurrent + 2] = this.gb_2
	this.control[icurrent + 3] = this.st_1
	this.control[icurrent + 4] = this.st_2
	this.control[icurrent + 5] = this.em_startdate
	this.control[icurrent + 6] = this.em_enddate
	this.control[icurrent + 7] = this.st_3
	this.control[icurrent + 8] = this.st_4
	this.control[icurrent + 9] = this.em_caption
	this.control[icurrent + 10] = this.em_discperc
	this.control[icurrent + 11] = this.rb_originaldate
	this.control[icurrent + 12] = this.rb_lastsavingdate
	this.control[icurrent + 13] = this.rb_billingdate
	this.control[icurrent + 14] = this.em_term1
	this.control[icurrent + 15] = this.em_term2
	this.control[icurrent + 16] = this.st_5
	this.control[icurrent + 17] = this.st_6
	this.control[icurrent + 18] = this.cbx_suppressheader

// w_arg_cust_sdate_ldate_v18.destroy() returns 0 [event]
	call super::destroy
	destroy this.gb_3
	destroy this.gb_2
	destroy this.st_1
	destroy this.st_2
	destroy this.em_startdate
	destroy this.em_enddate
	destroy this.st_3
	destroy this.st_4
	destroy this.em_caption
	destroy this.em_discperc
	destroy this.rb_originaldate
	destroy this.rb_lastsavingdate
	destroy this.rb_billingdate
	destroy this.em_term1
	destroy this.em_term2
	destroy this.st_5
	destroy this.st_6
	destroy this.cbx_suppressheader

// w_arg_cust_sdate_ldate_v18.open() returns long [event]
	long ancestorreturnvalue
	date ld_currdate
	string ls_text
	ancestorreturnvalue = super::open()
	ld_currdate = today()
	if f_stringpreferences("ApplyArgSDate") = "N" then
		ls_text = string(ld_currdate, "dd/mm/yyyy")
		ls_text = trim(ls_text) + " 00:00:00"
	else
		ls_text = string(f_datepreferences("DefaultArgSDate"), "dd/mm/yyyy hh:mm:ss")
	end if
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.em_enddate.text = ls_text
	return ::message.returnvalue

// w_arg_cust_sdate_ldate_v18.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.id_selected.getitemnumber(1, "code")
	if isnull(parent.istr_arg.l_code1) then
		parent.istr_arg.l_code1 = 0
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	parent.em_caption.getdata(parent.istr_arg.s_name1)
	parent.em_discperc.getdata(parent.istr_arg.db_code1)
	if parent.rb_originaldate.checked then
		parent.istr_arg.s_name3 = "originaldate"
	elseif parent.rb_billingdate.checked then
		parent.istr_arg.s_name3 = "billingdate"
	else
		parent.istr_arg.s_name3 = "lastsavingdate"
	end if
	parent.istr_arg.l_code4 = 0
	if parent.cbx_suppressheader.checked then
		parent.istr_arg.l_code4 = 1
	else
		parent.istr_arg.l_code4 = 0
	end if
	parent.em_term1.getdata(parent.istr_arg.sa_stringlist[1])
	parent.em_term2.getdata(parent.istr_arg.sa_stringlist[2])
	parent.istr_arg.i_status = 1
	return ::message.returnvalue

// em_startdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

