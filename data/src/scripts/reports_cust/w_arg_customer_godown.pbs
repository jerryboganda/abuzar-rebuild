// window w_arg_customer_godown (reports_cust)  ancestor: w_arg_manf

// w_arg_customer_godown.create() returns 0 [event]
	call super::create

// w_arg_customer_godown.destroy() returns 0 [event]
	call super::destroy

// w_arg_customer_godown.open() returns long [event]
	long ll_retcode
	long ll_custcode
	long ll_count
	string ls_text
	date ld_currdate
	time lt_currtime
	datetime ld_startdate
	datetime ld_enddate
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	ll_custcode = message.doubleparm
	if ll_custcode > 0 then
		SQL SELECT ISNULL ( Count ( *) , 0 ) INTO :ll_count FROM AccountGodown WHERE AccCode =:ll_custcode USING sqlca;
		if ll_count > 0 then
			ll_retcode = this.dw_control.getchild("gcode", this.idc_child)
			if ll_retcode = -1 then
				messagebox("Error-1", "Can not get datawindow child")
				this.istr_arg.i_status = -1
				closewithreturn(this, this.istr_arg)
				if not isvalid(message) then
					return 0
				end if
				return message.returnvalue
			end if
		else
			messagebox("Error-2", "Can not get datawindow child. No Associated Godown For This Customer.")
			this.istr_arg.i_status = -1
			closewithreturn(this, this.istr_arg)
			if not isvalid(message) then
				return 0
			end if
			return message.returnvalue
		end if
	else
		messagebox("Error-3", "Can not get datawindow child. No Customer Selected")
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	this.idc_child.settransobject(sqlca)
	this.idc_child.retrieve(ll_custcode)
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	ld_currdate = today()
	if f_stringpreferences("ApplyArgSDate") = "N" then
		ls_text = string(ld_currdate, "dd/mm/yyyy")
		ls_text = trim(ls_text) + " 00:00:00"
	else
		ls_text = string(f_datepreferences("DefaultArgSDate"), "dd/mm/yyyy hh:mm:ss")
	end if
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.em_enddate.text = ls_text
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_ok.clicked() returns long [event]
	parent.istr_arg.l_code3 = parent.dw_control.getitemnumber(1, "gcode")
	parent.istr_arg.i_supress = parent.cbx_supress.checked
	parent.istr_arg.i_hide = parent.cbx_hide.checked
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
