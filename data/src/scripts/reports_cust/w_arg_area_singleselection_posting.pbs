// window w_arg_area_singleselection_posting (reports_cust)  ancestor: w_arguements

// w_arg_area_singleselection_posting.create() returns 0
	integer icurrent
	call super::create
	this.rb_range = create rb_range
	this.rb_all = create rb_all
	this.dw_sinvcode_linvcode = create dw_sinvcode_linvcode
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.rb_range
	this.control[icurrent + 2] = this.rb_all
	this.control[icurrent + 3] = this.dw_sinvcode_linvcode

// w_arg_area_singleselection_posting.destroy() returns 0
	call super::destroy
	destroy this.rb_range
	destroy this.rb_all
	destroy this.dw_sinvcode_linvcode

// w_arg_area_singleselection_posting.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_sinvcode_linvcode.settransobject(sqlca)
	this.dw_sinvcode_linvcode.insertrow(0)
	this.istr_arg.s_name1 = "N"
	return ::message.returnvalue

// w_arg_area_singleselection_posting.ue_close(integer ai_stauts) returns 0
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// rb_range.clicked() returns long
	parent.dw_sinvcode_linvcode.visible = true
	parent.st_1.visible = true
	parent.st_2.visible = true
	parent.istr_arg.s_name1 = "N"
	return ::message.returnvalue

// rb_all.clicked() returns long
	parent.dw_sinvcode_linvcode.visible = false
	parent.st_1.visible = false
	parent.st_2.visible = false
	parent.istr_arg.s_name1 = "Y"
	return ::message.returnvalue

// dw_sinvcode_linvcode.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
