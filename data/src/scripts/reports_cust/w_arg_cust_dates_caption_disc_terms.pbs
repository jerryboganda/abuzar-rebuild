// w_arg_cust_dates_caption_disc_terms.open() returns long [event]
	long ancestorreturnvalue
	date ld_currdate
	string ls_text
	ancestorreturnvalue = super::open()
	ld_currdate = today()
	if f_stringpreferences("ApplyArgSDate") = "N" then
		ls_text = string(ld_currdate, "dd/mm/yyyy")
		ls_text = trim(ls_text) + " 00:00:00"
	else
		ls_text = string(f_datepreferences("DefaultArgSDate"), "dd/mm/yyyy hh:mm:ss")
	end if
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.em_enddate.text = ls_text
	this.ddlb_format.selectitem("Format 1", 1)
	return ::message.returnvalue

// w_arg_cust_dates_caption_disc_terms.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.id_selected.getitemnumber(1, "code")
	if isnull(parent.istr_arg.l_code1) then
		parent.istr_arg.l_code1 = 0
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	setnull(parent.istr_arg.s_name1)
	parent.em_caption.getdata(parent.istr_arg.s_name2)
	parent.em_caption2.getdata(parent.istr_arg.s_name3)
	parent.em_discperc.getdata(parent.istr_arg.db_code1)
	if parent.rb_originaldate.checked then
		parent.istr_arg.s_name4 = "originaldate"
	elseif parent.rb_billingdate.checked then
		parent.istr_arg.s_name4 = "billingdate"
	else
		parent.istr_arg.s_name4 = "lastsavingdate"
	end if
	parent.istr_arg.l_code4 = 0
	if parent.cbx_suppressheader.checked then
		parent.istr_arg.l_code4 = 1
	else
		parent.istr_arg.l_code4 = 0
	end if
	parent.em_term1.getdata(parent.istr_arg.sa_stringlist[1])
	parent.em_term2.getdata(parent.istr_arg.sa_stringlist[2])
	if parent.ddlb_format.text = "Format 1 (summary - Form No., Staff No.)" then
		parent.istr_arg.l_code2 = 1
	elseif parent.ddlb_format.text = "Format 2 (detail of format1)" then
		parent.istr_arg.l_code2 = 2
	elseif parent.ddlb_format.text = "Format 3 (summary - Book No.)" then
		parent.istr_arg.l_code2 = 3
	elseif parent.ddlb_format.text = "Format 4 (detail of format3)" then
		parent.istr_arg.l_code2 = 4
	elseif parent.ddlb_format.text = "Format 5 (summary - EPI No.)" then
		parent.istr_arg.l_code2 = 5
	elseif parent.ddlb_format.text = "Format 6 (doctor patient summary)" then
		parent.istr_arg.l_code2 = 6
	elseif parent.ddlb_format.text = "Format 7 (doctor summary of bills)" then
		parent.istr_arg.l_code2 = 7
	elseif parent.ddlb_format.text = "Format 8 (doctor patient summary)(with Doct Name)" then
		parent.istr_arg.l_code2 = 8
	end if
	parent.istr_arg.i_status = 1
	return ::message.returnvalue

// em_startdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

