	this.rb_lastsavingdate = create rb_lastsavingdate
	this.rb_billingdate = create rb_billingdate
	this.st_4 = create st_4
	this.st_3 = create st_3
	this.st_5 = create st_5
	this.st_6 = create st_6
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_3
	this.control[icurrent + 2] = this.gb_2
	this.control[icurrent + 3] = this.st_1
	this.control[icurrent + 4] = this.st_2
	this.control[icurrent + 5] = this.em_startdate
	this.control[icurrent + 6] = this.em_enddate
	this.control[icurrent + 7] = this.lb_selected
	this.control[icurrent + 8] = this.cbx_all
	this.control[icurrent + 9] = this.em_caption
	this.control[icurrent + 10] = this.em_term1
	this.control[icurrent + 11] = this.em_term2
	this.control[icurrent + 12] = this.em_discperc
	this.control[icurrent + 13] = this.cbx_suppressheader
	this.control[icurrent + 14] = this.rb_originaldate
	this.control[icurrent + 15] = this.rb_lastsavingdate
	this.control[icurrent + 16] = this.rb_billingdate
	this.control[icurrent + 17] = this.st_4
	this.control[icurrent + 18] = this.st_3
	this.control[icurrent + 19] = this.st_5
	this.control[icurrent + 20] = this.st_6

// w_arg_customers_sdate_ldate_v3.destroy() returns 0
	call super::destroy
	destroy this.gb_3
	destroy this.gb_2
	destroy this.st_1
	destroy this.st_2
	destroy this.em_startdate
	destroy this.em_enddate
	destroy this.lb_selected
