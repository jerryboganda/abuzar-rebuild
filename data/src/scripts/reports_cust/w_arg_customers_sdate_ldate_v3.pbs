// window w_arg_customers_sdate_ldate_v3 (reports_cust)  ancestor: w_popup_forselection_walias

// w_arg_customers_sdate_ldate_v3.create() returns 0
	integer icurrent
	call super::create
	this.gb_3 = create gb_3
	this.gb_2 = create gb_2
	this.st_1 = create st_1
	this.st_2 = create st_2
