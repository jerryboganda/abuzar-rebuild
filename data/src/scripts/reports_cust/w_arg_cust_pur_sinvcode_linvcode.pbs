// window w_arg_cust_pur_sinvcode_linvcode (reports_cust)  ancestor: w_arguements

// w_arg_cust_pur_sinvcode_linvcode.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.st_5 = create st_5
	this.dw_ranginvoice = create dw_ranginvoice
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.st_5
	this.control[icurrent + 3] = this.dw_ranginvoice

// w_arg_cust_pur_sinvcode_linvcode.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.st_5
	destroy this.dw_ranginvoice

// w_arg_cust_pur_sinvcode_linvcode.open() returns long [event]
	long ancestorreturnvalue
	integer li_saletype
	ancestorreturnvalue = super::open()
	li_saletype = message.doubleparm
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_ranginvoice.insertrow(0)
	if li_saletype = 3 or li_saletype = 10 then
		this.dw_ranginvoice.setfocus()
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_arg_cust_pur_sinvcode_linvcode.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code3 = parent.dw_control.getitemnumber(1, "custcode")
	if isnull(parent.istr_arg.l_code3) then
		parent.istr_arg.l_code1 = 0
	end if
	if parent.cbx_hide.checked = true then
		parent.istr_arg.l_code4 = 1
	else
		parent.istr_arg.l_code4 = 0
	end if
	parent.dw_ranginvoice.accepttext()
	parent.istr_arg.l_code1 = parent.dw_ranginvoice.getitemnumber(1, "sinvcode")
	parent.istr_arg.l_code2 = parent.dw_ranginvoice.getitemnumber(1, "linvcode")
	if parent.istr_arg.l_code1 > parent.istr_arg.l_code2 then
		messagebox("Range Validation!", "Starting Number Should be lesser or equal to ending")
		parent.dw_ranginvoice.setcolumn("sinvcode")
		parent.dw_ranginvoice.setfocus()
		return ::message.returnvalue
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_ranginvoice.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
