// window w_arg_cust_sdate_ldate_dateoption (reports_cust)  ancestor: w_popup_forselection_walias

// w_arg_cust_sdate_ldate_dateoption.create() returns 0
	integer icurrent
	call super::create
	this.gb_2 = create gb_2
	this.st_1 = create st_1
	this.st_2 = create st_2
	this.em_startdate = create em_startdate
	this.em_enddate = create em_enddate
	this.rb_billingdate = create rb_billingdate
	this.rb_lastsavingdate = create rb_lastsavingdate
	this.rb_originaldate = create rb_originaldate
	this.gb_5 = create gb_5
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_2
	this.control[icurrent + 2] = this.st_1
	this.control[icurrent + 3] = this.st_2
	this.control[icurrent + 4] = this.em_startdate
	this.control[icurrent + 5] = this.em_enddate
	this.control[icurrent + 6] = this.rb_billingdate
	this.control[icurrent + 7] = this.rb_lastsavingdate
	this.control[icurrent + 8] = this.rb_originaldate
	this.control[icurrent + 9] = this.gb_5

// w_arg_cust_sdate_ldate_dateoption.destroy() returns 0
	call super::destroy
	destroy this.gb_2
	destroy this.st_1
	destroy this.st_2
	destroy this.em_startdate
	destroy this.em_enddate
	destroy this.rb_billingdate
	destroy this.rb_lastsavingdate
	destroy this.rb_originaldate
	destroy this.gb_5

// w_arg_cust_sdate_ldate_dateoption.open() returns long
	long ancestorreturnvalue
	date ld_currdate
	string ls_text
	ancestorreturnvalue = super::open()
	ld_currdate = today()
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 00:00:00"
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.em_enddate.text = ls_text
	return ::message.returnvalue

// w_arg_cust_sdate_ldate_dateoption.ue_close() returns 0
	closewithreturn(this, this.istr_arg)

// em_startdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_enddate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// rb_billingdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		parent.cb_ok.setfocus()
	end if
	return ::message.returnvalue

// rb_lastsavingdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		parent.cb_ok.setfocus()
	end if
	return ::message.returnvalue

// rb_originaldate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		parent.cb_ok.setfocus()
	end if
	return ::message.returnvalue
