// window w_arg_customers_reminderletter (reports_cust)  ancestor: w_popup_forselection_walias

// w_arg_customers_reminderletter.wf_search_areawisecustomer() returns long
	long ll_option
	long ll_code
	long ll_counter
	long ll_found
	string ls_name
	string ls_findexp
	datastore lds_customer
	s_arguements lstr_arg
	lds_customer = create datastore
	lds_customer.dataobject = "d_areawise_customers_selection"
	lds_customer.settransobject(sqlca)
	open(w_arg_areas)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		if this.lb_selected.totalitems() > 0 then
			ll_option = messagebox("Customer Selection", "Your Current Customer Selection will be cleared.~r~nAre you sure to apply Area Selection to the current customer selection?", question!, yesno!, 1)
			if ll_option <> 1 then
				return 0
			end if
			return
		end if
		do while this.lb_selected.totalitems() > 0
			this.lb_selected.selectitem(1)
			this.lb_selected.post event doubleclicked(this.lb_selected.selectedindex())
			this.lb_selected.deleteitem(1)
		loop
		lds_customer.retrieve(lstr_arg.ia_integerlist)
		if lds_customer.rowcount() > 0 then
			for ll_counter = 1 to lds_customer.rowcount()
				ll_code = lds_customer.object.code[ll_counter]
				ls_name = lds_customer.object.name[ll_counter]
				ls_findexp = "name = '" + ls_name + "'"
				ll_found = 0
				ll_found = this.id_selectionlist.find(ls_findexp, 1, this.id_selectionlist.rowcount())
				if ll_found > 0 and ll_found <= this.id_selectionlist.rowcount() then
					this.dw_selected.object.name[1] = ls_name
					this.dw_selected.object.code[1] = ll_code
					this.dw_selected.accepttext()
					this.dw_selected.event ue_addnewitem()
				end if
			next
		end if
	end if
	return 0

// w_arg_customers_reminderletter.create() returns 0
	integer icurrent
	call super::create
	this.gb_3 = create gb_3
	this.gb_2 = create gb_2
	this.st_1 = create st_1
	this.st_2 = create st_2
	this.em_startdate = create em_startdate
	this.em_enddate = create em_enddate
	this.lb_selected = create lb_selected
	this.cbx_all = create cbx_all
	this.dw_saleperson = create dw_saleperson
	this.st_3 = create st_3
	this.cb_areawiseselection = create cb_areawiseselection
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.gb_3
	this.control[icurrent + 2] = this.gb_2
	this.control[icurrent + 3] = this.st_1
	this.control[icurrent + 4] = this.st_2
	this.control[icurrent + 5] = this.em_startdate
	this.control[icurrent + 6] = this.em_enddate
	this.control[icurrent + 7] = this.lb_selected
	this.control[icurrent + 8] = this.cbx_all
	this.control[icurrent + 9] = this.dw_saleperson
	this.control[icurrent + 10] = this.st_3
	this.control[icurrent + 11] = this.cb_areawiseselection

// w_arg_customers_reminderletter.destroy() returns 0
	call super::destroy
	destroy this.gb_3
	destroy this.gb_2
	destroy this.st_1
	destroy this.st_2
	destroy this.em_startdate
	destroy this.em_enddate
	destroy this.lb_selected
	destroy this.cbx_all
	destroy this.dw_saleperson
	destroy this.st_3
	destroy this.cb_areawiseselection

// w_arg_customers_reminderletter.open() returns long
	long ancestorreturnvalue
	date ld_currdate
	string ls_text
	ancestorreturnvalue = super::open()
	ld_currdate = today()
	if f_stringpreferences("ApplyArgSDate") = "N" then
		ls_text = string(ld_currdate, "dd/mm/yyyy")
		ls_text = trim(ls_text) + " 00:00:00"
	else
		ls_text = string(f_datepreferences("DefaultArgSDate"), "dd/mm/yyyy hh:mm:ss")
	end if
	this.em_startdate.text = ls_text
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	ls_text = trim(ls_text) + " 23:59:59"
	this.em_enddate.text = ls_text
	this.ids_hold = create datastore
	this.ids_hold.dataobject = "d_popup_customerselection"
	this.ids_hold.settransobject(sqlca)
	this.ids_allcustomers = create datastore
	this.ids_allcustomers.dataobject = "d_popup_customerselection"
	this.ids_allcustomers.settransobject(sqlca)
	this.ids_allcustomers.retrieve()
	this.dw_saleperson.settransobject(sqlca)
	this.dw_saleperson.insertrow(0)
	return ::message.returnvalue

// w_arg_customers_reminderletter.ue_close() returns 0
	closewithreturn(this, this.istr_arg)

// em_startdate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// em_enddate.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// lb_selected.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		post event doubleclicked(selectedindex())
	end if
	return ::message.returnvalue

// lb_selected.doubleclicked(integer index) returns long
	string ls_name
	long ll_selectedindex
	long ll_found
	long ll_currentrow
	long ll_found1
	ll_selectedindex = selectedindex()
	ls_name = string(selecteditem())
	if not isnull(ls_name) and index >= 1 then
		ll_currentrow = parent.id_selectionlist.insertrow(0)
		ll_found = parent.ids_hold.find("name='" + ls_name + "'", 1, parent.ids_hold.rowcount())
		if ll_found > 0 then
			parent.id_selectionlist.setredraw(false)
			ll_currentrow = parent.id_selectionlist.insertrow(0)
			parent.id_selectionlist.setrow(ll_currentrow)
			parent.id_selectionlist.setitem(ll_currentrow, "code", parent.ids_hold.object.code[ll_found])
			parent.id_selectionlist.setitem(ll_currentrow, "name", parent.ids_hold.object.name[ll_found])
			parent.id_selectionlist.setitem(ll_currentrow, "aliasname", parent.ids_hold.object.aliasname[ll_found])
			parent.id_selectionlist.setitem(ll_currentrow, "address1", parent.ids_hold.object.address1[ll_found])
			parent.id_selectionlist.setitem(ll_currentrow, "city", parent.ids_hold.object.city[ll_found])
			parent.id_selectionlist.setsort("name A")
			parent.id_selectionlist.sort()
			parent.ids_hold.deleterow(ll_found)
			parent.ids_hold.accepttext()
			parent.id_selectionlist.deleterow(0)
			parent.id_selectionlist.accepttext()
			parent.id_selectionlist.setredraw(true)
			deleteitem(index)
		end if
	else
		messagebox("Selection Validation", "Please select some value from selected listbox")
	end if
	return ::message.returnvalue

// lb_selected.getfocus() returns long
	selectitem(0)
	selectitem(1)
	return ::message.returnvalue

// cbx_all.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// dw_saleperson.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return ::message.returnvalue

// cb_areawiseselection.clicked() returns long
	parent.wf_search_areawisecustomer()
	return ::message.returnvalue
