// window w_arg_area_sdate_ldate_posted_unposted (reports_cust)  ancestor: w_arguements

// w_arg_area_sdate_ldate_posted_unposted.create() returns 0 [event]
	call super::create

// w_arg_area_sdate_ldate_posted_unposted.destroy() returns 0 [event]
	call super::destroy

// w_arg_area_sdate_ldate_posted_unposted.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_arg_area_sdate_ldate_posted_unposted.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "areacode")
	if isnull(parent.istr_arg.l_code1) then
		parent.istr_arg.l_code1 = 0
	end if
	parent.em_startdate.getdata(parent.istr_arg.d_sdate)
	parent.em_enddate.getdata(parent.istr_arg.d_edate)
	if parent.cbx_supress.checked = true then
		parent.istr_arg.l_code2 = 1
	else
		parent.istr_arg.l_code2 = 0
	end if
	if parent.cbx_hide.checked = true then
		parent.istr_arg.l_code3 = 1
	else
		parent.istr_arg.l_code3 = 0
	end if
	parent.istr_arg.i_status = 1
	parent.post event ue_close(1)
	return ::message.returnvalue
