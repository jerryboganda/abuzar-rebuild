// window w_select_case (packingmodule)  ancestor: window

// w_select_case.ue_close(integer ai_status) returns 0 [event]
	long ll_code
	if ai_status = 1 then
		this.dw_control.accepttext()
		ll_code = this.dw_control.object.packlayoutcode[1]
	else
		ll_code = 0
	end if
	closewithreturn(this, ll_code)

// w_select_case.create() returns 0 [event]
	this.dw_control = create dw_control
	this.cb_ok = create cb_ok
	this.gb_format = create gb_format
	this.control = {this.dw_control, this.cb_ok, this.gb_format}

// w_select_case.destroy() returns 0 [event]
	destroy this.dw_control
	destroy this.cb_ok
	destroy this.gb_format

// w_select_case.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	this.dw_control.settransobject(sqlca)
	this.dw_control.retrieve()
	this.dw_control.scrolltorow(0)
	return ::message.returnvalue

// w_select_case.close() returns long [event]
	post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	parent.dw_control.accepttext()
	parent.post event ue_close(1)
	return ::message.returnvalue
