// window w_packcasecapacity (packingmodule)  ancestor: w_multi_entry

// w_packcasecapacity.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM ItemCategory WHERE Name =:as_name USING this.it_transobject;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_packcasecapacity.wf_validateitem() returns integer
	long ll_catcode
	long ll_packcode
	long rt_code
	integer li_errcode
	integer li_null
	boolean ib_yesno
	setnull(li_null)
	ll_packcode = this.id_detail.getitemnumber(this.il_currrow, "packcode")
	if this.id_detail.rowcount() > 1 then
		if this.il_currrow > 1 then
			rt_code = this.id_detail.find("packcode = " + trim(string(ll_packcode)), this.il_currrow - 1, 0)
		end if
		if rt_code = 0 then
			if this.il_currrow <> this.id_detail.rowcount() then
				rt_code = this.id_detail.find("packcode = " + trim(string(ll_packcode)), this.il_currrow + 1, this.id_detail.rowcount())
			end if
			if rt_code <> 0 then
				ib_yesno = true
			end if
		else
			ib_yesno = true
		end if
	end if
	if ib_yesno = true then
		messagebox("Duplication Error", "Current row is duplicate")
		li_errcode = -1
	else
		li_errcode = 0
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		this.id_detail.setcolumn("packcode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.packcode[this.il_currrow] = li_null
	end if
	return li_errcode

// w_packcasecapacity.wf_populate_possible_packs() returns long
	long ll_retcode
	long ll_rowcount
	long ll_counter
	long ll_res = 2
	long ll_newrow
	datastore lds_packs
	lds_packs = create datastore
	lds_packs.dataobject = "ddd_itempacking"
	lds_packs.settransobject(this.it_transobject)
	lds_packs.retrieve()
	ll_res = messagebox("Populate Packings", "Populate all Possible Packings?~r~n~r~nExisting Rows will be lost before population", question!, yesnocancel!, 2)
	if ll_res = 1 then
		for ll_rowcount = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		ll_rowcount = lds_packs.rowcount()
		for ll_counter = 1 to ll_rowcount
			ll_newrow = this.id_detail.insertrow(0)
			this.id_detail.object.packcode[ll_newrow] = lds_packs.object.packcode[ll_counter]
		next
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_save.visible = true
	return 0

// w_packcasecapacity.wf_populate_packing_for_this_category() returns long
	long ll_retcode
	long ll_rowcount
	long ll_counter
	long ll_res = 2
	long ll_newrow
	long ll_icatcode
	datastore lds_packs
	ll_icatcode = this.id_master.object.code[1]
	if ll_icatcode <= 0 then
		return 0
	end if
	lds_packs = create datastore
	lds_packs.dataobject = "ddd_packinglist_for_a_category"
	lds_packs.settransobject(this.it_transobject)
	lds_packs.retrieve(ll_icatcode)
	ll_res = messagebox("Populate Packings", "Populate all Possible Packings for the selected category?~r~n~r~nExisting Rows will be lost before population", question!, yesnocancel!, 2)
	if ll_res = 1 then
		for ll_rowcount = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		ll_rowcount = lds_packs.rowcount()
		for ll_counter = 1 to ll_rowcount
			ll_newrow = this.id_detail.insertrow(0)
			this.id_detail.object.packcode[ll_newrow] = lds_packs.object.packcode[ll_counter]
		next
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_save.visible = true
	return 0

// w_packcasecapacity.create() returns 0 [event]
	call super::create

// w_packcasecapacity.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_packcasecapacity.ue_save() returns 0 [event]
	long ll_mastercurrrow
	long ll_invid
	long ll_detailrows
	integer li_counter
	integer ll_salesmancode
	boolean lb_commitflag = true
	dwitemstatus lds_rowstatus
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	setpointer(hourglass!)
	ll_mastercurrrow = this.id_master.getrow()
	if ll_mastercurrrow > 0 then
		if isnull(this.id_master.object.code[ll_mastercurrrow]) then
			messagebox("Item Category Validation", "No Item Category Selected from List View.~r~nPlease select a valid Item Category from List View and then define packing cases capacities.")
			return
		end if
	else
		return
	end if
	ll_invid = this.id_master.object.code[ll_mastercurrrow]
	if isnull(ll_invid) then
		f_newtableid("itemcategory", ll_invid)
		this.id_master.object.code[ll_mastercurrrow] = ll_invid
	end if
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	do while li_counter <= ll_detailrows and lb_commitflag = true
		lds_rowstatus = this.id_detail.getitemstatus(li_counter, 0, primary!)
		if lds_rowstatus = newmodified! then
			this.id_detail.setitem(li_counter, "code", ll_invid)
		end if
		li_counter = li_counter + 1
	loop
	call super::ue_save
	setpointer(arrow!)

// w_packcasecapacity.ue_newform() returns 0 [event]
	call super::ue_newform
	this.id_master.setfocus()

// w_packcasecapacity.ue_newitem() returns 0 [event]
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	call super::ue_newitem
	this.id_detail.setcolumn("packcode")

// w_packcasecapacity.ue_detail() returns 0 [event]
	call super::ue_detail
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_delete.enabled = true
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "name"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	case "manfname"
		if data = "" or isnull(data) then
			messagebox("ManfName Validation", "Value requiredfor " + upper(dwo.manfname) + "in current row")
		end if
	case "manager"
		if data = "" or isnull(data) then
			messagebox("Manager Validation", "Value required for Manager in current row")
		end if
	end choose
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "name"
		if parent.parent.parent.wf_duplicatename(data) then
			messagebox("Name Validation", "Duplication Name Error~n~rPlease Choose Some Other Name")
			return 1
		end if
	end choose
	return ::message.returnvalue

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf5! then
		parent.parent.parent.wf_populate_possible_packs()
	elseif key = keyf6! then
		parent.parent.parent.wf_populate_packing_for_this_category()
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	string ls_managername
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "salesmancode"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_itemvalidated = false
		li_errcode = 0
	case "ocqty"
		if long(data) < 0 then
			messagebox("Outer Case Capacity Validation", "Not a Valid Outer Case Capacity~r~nPlease enter Valid Packing Capacity for Outer Case")
			li_errcode = 1
		elseif long(data) = 0 then
			parent.parent.parent.id_detail.object.mcqty[row] = 0
			parent.parent.parent.id_detail.object.scqty[row] = 0
		else
			parent.parent.parent.id_detail.object.mcqty[row] = long(data) / 2.0
			parent.parent.parent.id_detail.object.scqty[row] = long(data) / 6.0
		end if
	case "mcqty"
		if long(data) < 0 then
			messagebox("Master Carton Capacity Validation", "Not a Valid Master Carton Capacity~r~nPlease enter Valid Packing Capacity for Master Carton")
			li_errcode = 1
		end if
	case "scqty"
		if long(data) < 0 then
			messagebox("Carton Capacity Validation", "Not a Valid Carton Capacity~r~nPlease enter Valid Packing Capacity for Carton")
			li_errcode = 1
		end if
	case else
		parent.parent.parent.ib_itemvalidated = true
	end choose
	return li_errcode

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "salesmancode"
		if data = "" or isnull(data) then
			messagebox("Sales Person Name Validation", "Value required Sales Person Name in current row")
		end if
	end choose
	return 1

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	return ::message.returnvalue
