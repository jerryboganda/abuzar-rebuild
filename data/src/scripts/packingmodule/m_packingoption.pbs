// menu m_packingoption (packingmodule)  ancestor: menu

// m_packingoption.create() returns 0
	m_packingoption = this
	call super::create
	this.text = "m_packingoption"
	this.m_insert = create m_insert
	this.m_delete = create m_delete
	this.m_- = create m_-
	this.m_packfiltereditems = create m_packfiltereditems
	this.m_un-packitems = create m_un-packitems
	this.item[upperbound(this.item) + 1] = this.m_insert
	this.item[upperbound(this.item) + 1] = this.m_delete
	this.item[upperbound(this.item) + 1] = this.m_-
	this.item[upperbound(this.item) + 1] = this.m_packfiltereditems
	this.item[upperbound(this.item) + 1] = this.m_un-packitems

// m_packingoption.destroy() returns 0
	call super::destroy
	destroy this.m_insert
	destroy this.m_delete
	destroy this.m_-
	destroy this.m_packfiltereditems
	destroy this.m_un-packitems

// m_insert.create() returns 0
	call super::create
	this.text = "&Insert"
	this.microhelp = "Insert Packing Case, Master Carton or Carton"

// m_insert.destroy() returns 0
	call super::destroy

// m_delete.create() returns 0
	call super::create
	this.text = "&Delete"
	this.microhelp = "Delete Packing Case, Master Carton or Carton"

// m_delete.destroy() returns 0
	call super::destroy

// m_-.create() returns 0
	call super::create
	this.text = "-"
	this.enabled = false

// m_-.destroy() returns 0
	call super::destroy

// m_packfiltereditems.create() returns 0
	call super::create
	this.text = "&Pack Filtered Items"
	this.microhelp = "Pack Filtered Items into this Packing Case, Master Carton or Carton"

// m_packfiltereditems.destroy() returns 0
	call super::destroy

// m_un-packitems.create() returns 0
	call super::create
	this.text = "&Un-Pack Items"
	this.microhelp = "Pack Items From this Packing Case, Master Carton or Carton"

// m_un-packitems.destroy() returns 0
	call super::destroy
