// m_file.create() returns 0 [event]
	call super::create
	this.m_open = create m_open
	this.m_populaterecipe = create m_populaterecipe
	this.m_populatesaleorder = create m_populatesaleorder
	this.m_previoussaleinvinfo = create m_previoussaleinvinfo
	this.m_showissuetermscomments = create m_showissuetermscomments
	this.m_populateissuerequest = create m_populateissuerequest
	this.m_itemissuehistory = create m_itemissuehistory
	this.m_applycustomerassociatedquotation = create m_applycustomerassociatedquotation
	this.m_viewheader = create m_viewheader
	this.m_populateallreceiptitems = create m_populateallreceiptitems
	this.m_editquotation = create m_editquotation
	this.m_pushissuetodropbox = create m_pushissuetodropbox
	this.item[upperbound(this.item) + 1] = this.m_open
	this.item[upperbound(this.item) + 1] = this.m_populaterecipe
	this.item[upperbound(this.item) + 1] = this.m_populatesaleorder
	this.item[upperbound(this.item) + 1] = this.m_previoussaleinvinfo
	this.item[upperbound(this.item) + 1] = this.m_showissuetermscomments
	this.item[upperbound(this.item) + 1] = this.m_populateissuerequest
	this.item[upperbound(this.item) + 1] = this.m_itemissuehistory
	this.item[upperbound(this.item) + 1] = this.m_applycustomerassociatedquotation
	this.item[upperbound(this.item) + 1] = this.m_viewheader
	this.item[upperbound(this.item) + 1] = this.m_populateallreceiptitems
	this.item[upperbound(this.item) + 1] = this.m_editquotation
	this.item[upperbound(this.item) + 1] = this.m_pushissuetodropbox

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_open
	destroy this.m_populaterecipe
	destroy this.m_populatesaleorder
	destroy this.m_previoussaleinvinfo
	destroy this.m_showissuetermscomments
	destroy this.m_populateissuerequest
	destroy this.m_itemissuehistory
	destroy this.m_applycustomerassociatedquotation
	destroy this.m_viewheader
	destroy this.m_populateallreceiptitems
	destroy this.m_editquotation
	destroy this.m_pushissuetodropbox

