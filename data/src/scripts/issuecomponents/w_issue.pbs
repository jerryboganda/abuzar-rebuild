// w_issue.wf_returnsaleinvoice(long al_invid, string as_errtext) returns boolean
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_counter
	long ll_detailrows
	string ls_batch
	string ls_due
	datetime ld_expiry
	boolean lb_commitflag
	double ld_avgprice
	double ld_looseqty
	double ld_stock
	double ld_newstock
	this.id_saleinvdetail.retrieve(al_invid)
	ll_detailrows = this.id_saleinvdetail.rowcount()
	ll_counter = 1
	do while ll_counter <= ll_detailrows and lb_commitflag
		ll_gcode = this.id_saleinvdetail.getitemnumber(ll_counter, "gcode")
		ll_icode = this.id_saleinvdetail.getitemnumber(ll_counter, "icode")
		ls_batch = this.id_saleinvdetail.getitemstring(ll_counter, "batch")
		ld_expiry = this.id_saleinvdetail.getitemdatetime(ll_counter, "expiry")
		ld_looseqty = this.id_saleinvdetail.getitemnumber(ll_counter, "qty")
		this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
			if this.it_transobject.sqlcode = 0 then
				ld_newstock = ld_stock + ld_looseqty
				this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
				if this.it_transobject.sqlcode <> 0 then
					lb_commitflag = false
				end if
				if ld_stock = 0.0 then
					SQL update GodownDetail Set Priority =1 Where GodownDetail.GCode =:ll_gcode and GodownDetail.ICode =:ll_icode and GodownDetail.Batch =:ls_batch and GodownDetail.Expiry =:ld_expiry USING this.it_transobject;
				end if
			else
				lb_commitflag = false
			end if
		else
			lb_commitflag = false
		end if
		ll_counter = ll_counter + 1
	loop
	if lb_commitflag then
		if wf_deletesaleinvoice(al_invid) <> 0 then
			lb_commitflag = false
			as_errtext = "    Some database problem occur"
		end if
	else
		as_errtext = "    Some database problem occur"
	end if
	return lb_commitflag

// w_issue.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_issue.wf_closelist() returns 0
	this.ib_itemslistopen = false
	this.id_itemslist.hide()

// w_issue.wf_getitemassociategcode(long la_icode) returns integer
	integer li_gcode
	SQL Select Gcode INTO :li_gcode From item Where icode =:la_icode USING this.it_transobject;
	return li_gcode

// w_issue.wf_locksaleinvoice(long al_saleinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From IssueHeader WITH ( UPDLOCK HOLDLOCK ) Where IssueHeader.Issueinvcode =:al_saleinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_issue.wf_post() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	s_arguements lstr_arginfo
	datetime ldt_server_datetime
	string ls_date_errtext
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return -1
			end if
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			li_errcode = wf_locksaleinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_saleinvcount, this.ii_category)
			if li_errcode = 0 then
				sqlca.postissueledger(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode, this.ii_category)
				if sqlca.sqlcode <> 0 then
					li_errcode = -1
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if li_errcode <> 0 then
		messagebox("Posting Fails", "Some database request fails, Please try again")
	else
		messagebox("Posting Successfull", "Total unposted rows were " + string(ll_saleinvcount) + "~n~rAll rows have been posted successfully")
	end if
	return li_errcode

// w_issue.wf_preinvinfo() returns 0
	s_previnvinfo ls_previnvinfo
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_previnvinfo.ar_customer = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		ls_previnvinfo.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		openwithparm(w_previnvinfo, ls_previnvinfo)
	end if

// w_issue.wf_print() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_count
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			for ll_count = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
				this.id_print.retrieve(ll_count)
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			next
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	return li_errcode

// w_issue.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_issue.wf_setgodownoption() returns 0
	this.ii_salegodown = this.id_detail.getitemnumber(1, "gcode")
	if this.il_strategy = 2 or this.il_strategy = 1 and this.il_godowncount = 1 then
		this.id_detail.modify("gcode" + ".Protect=1")
		this.id_detail.object.gcode.background.color = this.backcolor
	end if

// w_issue.wf_setiteminfo(long al_icode, long al_row, double ad_saleprice, double ad_discperc, long al_stock, double ad_avgprice, long al_totalstock, double ad_purdiscperc) returns 0
	this.id_detail.setitem(al_row, "saleprice", ad_saleprice)
	if this.ii_saletype = 2 then
		this.id_detail.setitem(al_row, "discperc", ad_discperc)
	else
		this.id_detail.setitem(al_row, "discperc", 0.0)
	end if
	this.id_detail.setitem(al_row, "rate", ad_saleprice)
	this.id_detail.setitem(al_row, "avgprice", ad_avgprice)
	this.id_footer.object.icode[this.id_footer.getrow()] = al_icode
	this.id_footer.object.stock[this.id_footer.getrow()] = al_stock

// w_issue.wf_setsaletype(integer ai_saletype) returns 0
	this.ii_saletype = ai_saletype

// w_issue.wf_setsuppinfo(long al_suppcode, datawindow ad_master) returns 0
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	SQL SELECT supplier.address1 , supplier.city , supplier.phone INTO :ls_address, :ls_city, :ls_phone FROM supplier WHERE supplier.suppcode =:al_suppcode USING this.it_transobject;
	ll_currow = ad_master.getrow()
	ad_master.object.supplier_address[ll_currow] = ls_address
	ad_master.object.supplier_city[ll_currow] = ls_city
	ad_master.object.supplier_phone[ll_currow] = ls_phone

// w_issue.wf_updatesaleprice(long al_icode, double ad_saleprice) returns integer
	SQL update Item SET saleprice =:ad_saleprice WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_issue.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean lb_rtflag
	boolean ib_due
	integer li_null
	string ls_null
	ls_titleerrtext = "Item Validation"
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), al_currrow) = true then
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
	elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			li_option = messagebox("Item Validation", "Item stock does not exist~n~rDo You want to due this item", information!, yesno!, 2)
			if li_option = 1 then
				this.id_detail.setitem(this.il_currrow, "looseqty", 1)
				this.id_detail.setitem(this.il_currrow, "dueqty", 1)
				ib_due = true
			else
				li_errcode = -1
			end if
		end if
	else
		li_errcode = -1
		ls_titleerrtext = "Item Validation"
	end if
	if li_errcode = -1 and not ib_due then
		lb_rtflag = false
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setitem(al_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(al_currrow, "icode", li_null)
		this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	end if
	return lb_rtflag

// w_issue.wf_validategodown() returns integer
	long ll_icode
	long ll_gcode
	long ll_stock
	long ll_counter
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	string ls_null
	integer li_errcode
	integer li_null
	integer li_option
	integer li_duperr
	boolean ib_due
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	this.ii_defaultgcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	if wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			li_errcode = -1
		elseif f_stringpreferences("AllowDuplicateItemInIssue") = "N" then
			for ll_counter = 1 to this.id_detail.rowcount()
				if this.il_currrow <> ll_counter and (ll_icode = this.id_detail.getitemnumber(ll_counter, "icode") and this.ii_defaultgcode = this.id_detail.getitemnumber(ll_counter, "gcode")) then
					li_duperr = -2
				end if
			next
		end if
	end if
	this.ib_godownvalidated = true
	if li_errcode = -1 and not ib_due then
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		this.id_detail.setfocus()
		this.id_detail.setcolumn("gcode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
	end if
	if li_duperr = -2 and not ib_due then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate Item, please select some other item"
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
		this.ib_itemslistopen = true
		this.id_itemslist.show()
		li_errcode = -1
	end if
	return li_errcode

// w_issue.wf_retrievelist() returns long
	string[] ls_posted
	integer li_salecategory
	integer li_invforlastdays
	datetime ld_invdate
	ld_invdate = datetime(relativedate(today(), li_invforlastdays))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		li_salecategory = this.ii_salecategory
	else
		li_salecategory = this.ii_saletype
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, this.il_groupcode, this.ii_module, this.ii_category)

// w_issue.wf_retrievelistall() returns long
	string[] ls_posted
	integer li_salecategory
	datetime ld_invdate
	ld_invdate = datetime(date("12/12/1998"), time("00:00:00"))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		li_salecategory = this.ii_salecategory
	else
		li_salecategory = this.ii_saletype
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, this.il_groupcode, this.ii_module, this.ii_category)

// w_issue.wf_initmodify(integer ai_protect) returns 0
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_counter
	long ll_count
	double ld_looseqty
	double ld_stock
	if this.id_master.getitemstring(1, "posted") = "N" then
		this.id_master.setitem(1, "sitecode", gl_sitecode)
		ll_saleinvcode = this.id_detail.getitemnumber(1, "code")
		if wf_locksaleinvoice(ll_saleinvcode) = 0 then
			this.id_master.retrieve(ll_saleinvcode)
			this.id_detail.retrieve(ll_saleinvcode)
			this.ids_invoiceinfo.retrieve(ll_saleinvcode)
			for ll_count = 1 to this.id_detail.rowcount()
				ll_icode = this.id_detail.getitemnumber(ll_count, "icode")
				ll_gcode = this.id_detail.getitemnumber(ll_count, "gcode")
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				if this.it_transobject.sqlcode <> 0 then
					ai_protect = 0
				end if
				ld_looseqty = 0
				for ll_counter = 1 to this.ids_invoiceinfo.rowcount()
					if ll_icode = this.ids_invoiceinfo.getitemnumber(ll_counter, "icode") then
						ld_looseqty = ld_looseqty + this.ids_invoiceinfo.getitemnumber(ll_counter, "qty")
						this.id_detail.setitem(ll_count, "stock", ld_stock + ld_looseqty)
					end if
				next
			next
			if ai_protect = 0 then
				this.ib_modify = true
				this.id_footer.setitem(1, "stock", this.id_detail.getitemnumber(1, "stock"))
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
			return
		end if
		messagebox("Cannot Modify", "Issue invoice is already in use")
	end if

// w_issue.wf_copyinvoice() returns integer
	datastore lds_copyheader
	datastore lds_copydetail
	datawindowchild ldc_section
	datawindowchild ldc_godown
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_deptcode
	long ll_detailrows
	long ll_icode
	long ll_counter
	long ll_found
	long ll_innercounter
	long ll_insertedrows
	long ll_packunits
	integer li_retcode
	integer li_errcode
	integer li_addbonusinqty
	double ld_holdbonusqty
	double ld_holdqty
	string ls_errortext
	boolean lb_pricefromtemplate
	boolean lb_enablesave
	boolean lb_isitemexists
	boolean lb_bonus
	lds_copyheader = create datastore
	lds_copydetail = create datastore
	if wf_iseditable() = false then
		return 0
	end if
	open(w_copyissueinvoicefrom)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		destroy lds_copyheader
		destroy lds_copydetail
		return -1
	end if
	if lstr_template.c_copyinvfrom = "I" then
		lds_copyheader.dataobject = "d_issuereqheader"
		lds_copyheader.settransobject(this.it_transobject)
		lds_copyheader.retrieve(lstr_template.l_invtemplate)
		ll_deptcode = lds_copyheader.object.deptcode[1]
		this.id_master.object.deptcode[1] = lds_copyheader.object.deptcode[1]
		this.id_master.object.areacode[1] = lds_copyheader.object.areacode[1]
		this.id_master.object.smancode[1] = lds_copyheader.object.smancode[1]
		this.id_master.object.remarks[1] = lds_copyheader.object.remarks[1]
		this.id_detail.reset()
		lds_copydetail.dataobject = "d_issuereqdetail"
		lds_copydetail.settransobject(this.it_transobject)
		lds_copydetail.getchild("sectcode", ldc_section)
		ldc_section.settransobject(this.it_transobject)
		ldc_section.retrieve(ll_deptcode)
		if ldc_section.rowcount() = 0 then
			ldc_section.insertrow(0)
		end if
		this.idc_section.retrieve(ll_deptcode)
		if this.idc_section.rowcount() = 0 then
			this.idc_section.insertrow(0)
		end if
		ll_totalrows = lds_copydetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_copydetail.rowcount()
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_copydetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "qty", lds_copydetail.getitemnumber(ll_rowcount, "qty"))
			this.id_detail.setitem(ll_rowcount, "sectcode", lds_copydetail.getitemnumber(ll_rowcount, "sectcode"))
		next
	elseif lstr_template.c_copyinvfrom = "R" then
		lds_copyheader.dataobject = "d_receiptheader"
		lds_copyheader.settransobject(this.it_transobject)
		lds_copyheader.retrieve(lstr_template.l_invtemplate)
		ll_deptcode = lds_copyheader.object.deptcode[1]
		this.id_master.object.deptcode[1] = lds_copyheader.object.deptcode[1]
		this.id_master.object.areacode[1] = lds_copyheader.object.areacode[1]
		this.id_master.object.smancode[1] = lds_copyheader.object.smancode[1]
		this.id_master.object.remarks[1] = lds_copyheader.object.remarks[1]
		this.id_detail.reset()
		lds_copydetail.dataobject = "d_receiptdetail"
		lds_copydetail.settransobject(this.it_transobject)
		lds_copydetail.getchild("sectcode", ldc_section)
		ldc_section.settransobject(this.it_transobject)
		ldc_section.retrieve(ll_deptcode)
		if ldc_section.rowcount() = 0 then
			ldc_section.insertrow(0)
		end if
		this.idc_section.retrieve(ll_deptcode)
		if this.idc_section.rowcount() = 0 then
			this.idc_section.insertrow(0)
		end if
		ll_totalrows = lds_copydetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_copydetail.rowcount()
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_copydetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "qty", lds_copydetail.getitemnumber(ll_rowcount, "qty"))
			this.id_detail.setitem(ll_rowcount, "sectcode", lds_copydetail.getitemnumber(ll_rowcount, "sectcode"))
		next
	elseif lstr_template.c_copyinvfrom = "P" then
		li_addbonusinqty = messagebox("Bonus In Issue Qty", "Do you want to add Bonus In Issue Qty?", question!, yesno!, 2)
		if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
			lds_copydetail.dataobject = "d_normalpurchasedetail"
			lds_copyheader.dataobject = "d_normalpurchaseheader"
		else
			lds_copydetail.dataobject = "d_loosepurchasedetail"
			lds_copyheader.dataobject = "d_loosepurchaseheader"
		end if
		if messagebox("Issue Price Confirmation", "Do you want to apply Price from Purchase invoice?", stopsign!, yesno!, 2) = 1 then
			lb_pricefromtemplate = true
		end if
		lds_copydetail.settransobject(this.it_transobject)
		lds_copyheader.settransobject(this.it_transobject)
		li_retcode = lds_copydetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		ll_totalrows = lds_copydetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = 0
		ll_totalrows = lds_copyheader.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_detailrows = lds_copydetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for ll_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_counter = 1 to ll_detailrows
			ld_holdqty = 0
			ld_holdbonusqty = 0
			ll_icode = lds_copydetail.object.icode[ll_counter]
			ll_found = lds_copydetail.find("icode=" + string(ll_icode), 1, ll_counter - 1)
			if ll_found > 0 then
				if ll_detailrows = 1 then
					lb_isitemexists = false
				elseif ll_counter = 1 then
					lb_isitemexists = false
				else
					lb_isitemexists = true
				end if
			else
				lb_isitemexists = false
			end if
			if lb_isitemexists = false then
				if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
					ld_holdqty = lds_copydetail.object.packqty[ll_counter]
					ld_holdbonusqty = lds_copydetail.object.bonusqty[ll_counter]
				else
					ld_holdqty = lds_copydetail.object.looseqty[ll_counter]
					ld_holdbonusqty = lds_copydetail.object.bonusqty[ll_counter]
				end if
				if ll_counter <> ll_detailrows then
					ll_found = lds_copydetail.find("icode=" + string(ll_icode), ll_counter + 1, ll_detailrows)
					ll_innercounter = ll_found
					do while ll_found > 0 and ll_innercounter <= ll_detailrows
						if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
							ld_holdqty = ld_holdqty + lds_copydetail.object.packqty[ll_found]
							ld_holdbonusqty = ld_holdbonusqty + lds_copydetail.object.bonusqty[ll_found]
						else
							ld_holdqty = ld_holdqty + lds_copydetail.object.looseqty[ll_found]
							ld_holdbonusqty = ld_holdbonusqty + lds_copydetail.object.bonusqty[ll_found]
						end if
						ll_innercounter = ll_found + 1
						ll_found = lds_copydetail.find("icode=" + string(ll_icode), ll_innercounter, ll_detailrows)
					loop
				end if
				ll_insertedrows = this.id_detail.insertrow(0)
				wf_inititeminfo(lds_copydetail.getitemnumber(ll_counter, "icode"), ll_insertedrows, li_errcode, ls_errortext)
				if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
					ld_holdqty = ld_holdqty * lds_copydetail.getitemnumber(ll_counter, "packunits")
					ld_holdbonusqty = ld_holdbonusqty * lds_copydetail.getitemnumber(ll_counter, "packunits")
				end if
				if li_addbonusinqty = 1 then
					this.id_detail.setitem(ll_insertedrows, "qty", ld_holdqty + ld_holdbonusqty)
				else
					this.id_detail.setitem(ll_insertedrows, "qty", ld_holdqty)
				end if
			end if
			if lb_pricefromtemplate then
				ll_packunits = this.id_detail.getitemnumber(ll_insertedrows, "packunits")
				if ll_packunits = 0 then
					ll_packunits = 1
				end if
				if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
					this.id_detail.setitem(ll_insertedrows, "price", lds_copydetail.getitemnumber(ll_counter, "purprice") / ll_packunits)
				else
					this.id_detail.setitem(ll_insertedrows, "price", lds_copydetail.getitemnumber(ll_counter, "purprice"))
				end if
			end if
		next
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	destroy lds_copydetail
	destroy lds_copyheader
	return li_retcode

// w_issue.wf_dup_refno(long al_issuetype, string as_refno) returns boolean
	long ll_count
	long ll_code
	boolean b_flag
	as_refno = trim(as_refno)
	if this.ib_modify then
		ll_code = this.id_master.getitemnumber(this.id_master.getrow(), "code")
		SQL SELECT count ( *) INTO :ll_count FROM IssueHeader WHERE IssueHeader.ReferenceNo =:as_refno AND IssueHeader.IssueTypeCode =:al_issuetype AND IssueHeader.IssueInvCode <> :ll_code USING sqlca;
	else
		SQL SELECT count ( *) INTO :ll_count FROM IssueHeader WHERE IssueHeader.ReferenceNo =:as_refno AND IssueHeader.IssueTypeCode =:al_issuetype USING sqlca;
	end if
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_issue.wf_validateitemnew() returns integer
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
		messagebox(ls_titleerrtext, ls_errtext)
	elseif not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		ls_titleerrtext = "Item Validation"
		li_errcode = -2
	end if
	this.ib_itemvalidated = true
	return li_errcode

// w_issue.wf_validateitem(boolean ab_flag) returns integer
	long ll_icode
	long ll_stock
	long ll_totalstock
	long ll_count
	long ll_receiptinvcode
	long ll_dddwrow
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean ib_due
	boolean lb_dupitem
	boolean lb_zerostock
	boolean lb_invalidrow
	integer li_null
	string ls_null
	ll_receiptinvcode = this.id_master.getitemnumber(this.id_master.getrow(), "ReceiptInvCode")
	if ll_receiptinvcode > 0 and not isnull(ll_receiptinvcode) then
		ll_dddwrow = this.id_itemslist.getrow()
		if wf_inititeminfo(this.idc_itemdddw, this.il_currrow, ll_dddwrow, ls_errtext) <> 0 then
			ls_titleerrtext = "Item Validation"
			li_errcode = -1
		end if
	else
		if this.il_currrow > this.id_detail.rowcount() then
			this.il_currrow = this.id_detail.rowcount()
		end if
		if isnull(this.il_currrow) or this.il_currrow <= 0 then
			lb_invalidrow = true
			setnull(ll_icode)
		else
			ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
		end if
		if not isnull(ll_icode) then
			if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true and f_stringpreferences("AllowDuplicateItemInIssue") = "N" then
				ls_titleerrtext = "Item Validation"
				ls_errtext = "Duplicate item, please select some other item"
				lb_dupitem = true
				li_errcode = -1
			elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
				if li_errcode = -2 then
					lb_zerostock = true
					li_errcode = -1
				end if
			else
				ls_titleerrtext = "Item Validation"
			end if
		end if
		if ab_flag then
			this.ib_itemvalidated = true
		end if
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		if this.il_strategy = 1 and this.il_godowncount > 1 and lb_zerostock then
			messagebox(ls_titleerrtext, "Stock is zero, please select some other godown")
			this.ib_itemslistopen = false
			this.id_itemslist.hide()
			this.id_detail.setcolumn("gcode")
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.gcode[this.il_currrow] = li_null
		elseif lb_dupitem = true then
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.icode[this.il_currrow] = li_null
			this.id_detail.object.fullcode[this.il_currrow] = ls_null
			this.id_detail.object.itemname[this.il_currrow] = ls_null
			post event ue_deleteitem_row(this.il_currrow)
			for ll_count = 1 to this.id_detail.rowcount()
				if this.id_detail.getitemnumber(ll_count, "icode") = ll_icode then
					this.id_detail.scrolltorow(ll_count)
					this.id_detail.setcolumn("qty")
					this.id_detail.setfocus()
				end if
			next
			messagebox("Item", "Duplicate Item, please select some other item")
		elseif lb_invalidrow = true then
			li_errcode = -1
		else
			ls_titleerrtext = "Item Validation"
			messagebox(ls_titleerrtext, ls_errtext)
			if f_stringpreferences("itemcode") = "N" then
				this.id_detail.setcolumn(this.is_columnitemname)
				this.ib_itemslistopen = true
				this.id_itemslist.show()
			else
				this.id_detail.setcolumn("fullcode")
				this.id_detail.object.fullcode[this.il_currrow] = ls_null
			end if
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.icode[this.il_currrow] = li_null
			this.id_detail.object.itemname[this.il_currrow] = ls_null
		end if
	end if
	return li_errcode

// w_issue.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_issue.wf_setitemprice(long al_icode, long al_row, long al_pricetypecode) returns long
	long ll_retcode
	long ll_packunits
	double ld_saleprice1
	double ld_saleprice2
	double ld_saleprice3
	double ld_saleprice4
	double ld_saleprice5
	double ld_avgprice
	double ld_rpp
	double ld_purprice
	string ls_alternatecustomicode
	string ls_null
	string ls_fullcode
	setnull(ls_null)
	SQL SELECT ROUND ( item.saleprice / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) , ROUND ( item.saleprice2 / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) , ROUND ( item.saleprice3 / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) , item.avgprice , item.packunits , ROUND ( item.purprice / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) , ROUND ( item.recentpurprice / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) , ROUND ( item.saleprice4 / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) , ROUND ( item.saleprice5 / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) INTO :ld_saleprice1, :ld_saleprice2, :ld_saleprice3, :ld_avgprice, :ll_packunits, :ld_purprice, :ld_rpp, :ld_saleprice4, :ld_saleprice5 FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		ll_retcode = -1
		return ll_retcode
	end if
	if not (this.it_transobject.sqlcode = 100) then
		ls_alternatecustomicode = trim(this.id_detail.object.alternatecustomicode[al_row])
		ls_fullcode = this.id_detail.object.fullcode[al_row]
		if lower(ls_fullcode) = lower(ls_alternatecustomicode) then
			ls_alternatecustomicode = ls_null
			this.id_detail.object.alternatecustomicode[al_row] = ls_null
		end if
		if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) or this.id_detail.object.packunits[al_row] <= 0 then
			this.id_detail.setitem(al_row, "saleprice", ld_saleprice1)
		end if
		this.id_detail.setitem(al_row, "purchaseprice", ld_purprice)
		this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
		this.id_detail.setitem(al_row, "mrpp", ld_rpp)
		choose case al_pricetypecode
		case 1
			if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) or this.id_detail.object.packunits[al_row] <= 0 then
				this.id_detail.setitem(al_row, "price", ld_saleprice1)
			end if
		case 2
			this.id_detail.setitem(al_row, "price", ld_saleprice2)
		case 3
			this.id_detail.setitem(al_row, "price", ld_saleprice3)
		case 7
			this.id_detail.setitem(al_row, "price", ld_saleprice4)
		case 8
			this.id_detail.setitem(al_row, "price", ld_saleprice5)
		case 4
			this.id_detail.setitem(al_row, "price", ld_purprice)
		case 5
			this.id_detail.setitem(al_row, "price", ld_rpp)
		case else
			this.id_detail.setitem(al_row, "price", ld_avgprice)
		end choose
		ll_retcode = 0
	else
		ll_retcode = -2
	end if
	return ll_retcode

// w_issue.wf_inititeminfo(long al_icode, long al_row, integer ai_rtcode, string as_errortext) returns boolean
	boolean retflag
	double ld_saleprice
	long ll_packunits
	long ll_issuecode
	long ll_result
	long ll_pricetypecode
	long ll_piecesinhand
	long ll_totalpieces
	double ld_saleprice2
	double ld_saleprice3
	double ld_avgprice
	double ld_mrpp
	double ld_purprice
	double ld_unitweight
	double ld_packingfactor
	double ld_packcapacity
	double ld_areavolume
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_alternatecustomicode
	double ld_godownstock
	double ld_saleqty
	double ld_totalstock
	setnull(ls_null)
	SQL SELECT item.customicode , item.name , item.saleprice , item.packunits , item.purprice , item.saleprice2 , item.saleprice3 , item.avgprice , item.recentpurprice , item.unitweight , item.packingfactor , item.packcapacity , item.areavolume , item.totalpieces INTO :ls_fullcode, :ls_name, :ld_saleprice, :ll_packunits, :ld_purprice, :ld_saleprice2, :ld_saleprice3, :ld_avgprice, :ld_mrpp, :ld_unitweight, :ld_packingfactor, :ld_packcapacity, :ld_areavolume, :ll_piecesinhand FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	ll_pricetypecode = this.id_master.getitemnumber(this.id_master.getrow(), "pricetypecode")
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
	else
		if this.il_strategy = 2 then
			li_gcode = wf_getitemassociategcode(al_icode)
		end if
		if this.il_strategy = 1 then
			li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
		end if
	end if
	this.it_transobject.getitemstockinallowedgodown(al_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_totalstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.ib_modify and retflag then
		ll_issuecode = this.id_master.getitemnumber(1, "code")
		if wf_getissuestockinfo(ll_issuecode, li_gcode, al_icode, ld_saleqty) <> 0 then
			retflag = false
			as_errortext = "Database Error: Item information can not be retrieved"
		end if
		ld_godownstock = ld_godownstock + ld_saleqty
	end if
	ls_alternatecustomicode = this.id_detail.object.alternatecustomicode[al_row]
	if isnull(ls_alternatecustomicode) then
		ls_alternatecustomicode = ""
	end if
	if lower(ls_fullcode) = lower(ls_alternatecustomicode) then
		ls_alternatecustomicode = ls_null
		this.id_detail.object.alternatecustomicode[al_row] = ls_null
	end if
	if retflag then
		this.id_detail.setitem(al_row, "gcode", li_gcode)
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		ll_result = wf_setitemprice(al_icode, al_row, ll_pricetypecode)
		if ll_result = -1 then
			as_errortext = "Item information can not be retrieved"
			retflag = false
		elseif ll_result = 100 then
			as_errortext = "Rows not retrieve"
			retflag = false
		else
			retflag = true
		end if
		this.id_detail.setitem(al_row, "icode", al_icode)
		this.id_detail.setitem(al_row, "packunits", ll_packunits)
		this.id_detail.setitem(al_row, "stock", ld_godownstock)
		this.id_detail.setitem(al_row, "unitweight", ld_unitweight)
		this.id_detail.setitem(al_row, "packingfactor", ld_packingfactor)
		this.id_detail.setitem(al_row, "piecesinhand", ll_piecesinhand)
		if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
			ld_areavolume = 1
		end if
		if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
			ld_packcapacity = 1
		end if
		this.id_detail.setitem(al_row, "packcapacity", ld_packcapacity)
		this.id_detail.setitem(al_row, "areavolume", ld_areavolume)
		this.id_detail.setitem(al_row, "pcs", round(this.id_detail.object.qty[al_row] / ld_areavolume, 6))
		this.id_detail.setitem(al_row, "cartons", trim(string(long(this.id_detail.object.pcs[al_row] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[al_row] mod ld_packcapacity, 2))))))
		if ll_piecesinhand = 0 or isnull(ll_piecesinhand) then
			this.id_detail.setitem(al_row, "totalpieces", 0)
		end if
		if ld_godownstock = 0.0 then
			ai_rtcode = -2
			as_errortext = "Item can not be sale, its Stock is Zero"
		end if
	else
		retflag = false
		as_errortext = "Item can not be sale, its Stock is Zero"
	end if
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_totalstock)
	this.id_detail.setitem(al_row, "itemcode", al_icode)
	wf_set_itemimage(al_icode)
	return retflag

// w_issue.wf_allowissuemodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM IssueDetail WHERE IssueInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_issue.wf_populatesaledetail(long al_invid, datawindow ad_saledetail, string as_errortext, long al_errorrow) returns boolean
	long ll_detailrows
	long ll_gcode
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode
	long li_counter
	long li_innercounter
	long ll_insertedrows
	long ll_itemsdetailrowcount
	long ll_row
	long ll_rowgroup
	long ll_totalpieces
	long ll_piecesinhand
	long ll_itemflatdisc
	long ll_sectcode
	long ll_issuereqrowid
	long ll_receiptinvcode
	long ll_receiptrowid
	double ld_stock
	double ld_newstock
	double ld_looseqty
	double ld_salelooseqty
	double ld_dueqty
	double ld_total_availablestock
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_mrpp
	double ld_purchaseprice
	double ld_price
	double ld_unitweight
	double ld_packingfactor
	double ld_packcapacity
	double ld_areavolume
	double ld_pcs
	double ld_claimablediscperc
	char lc_claimable
	boolean lb_commitflag
	string ls_batch
	string ls_updatesaleprice
	string ls_updsaleprice
	string ls_itemdescription
	string ls_alternatecustomicode
	datetime ld_expiry
	dwitemstatus ldws_column
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	ll_itemsdetailrowcount = 0
	ls_updatesaleprice = f_stringpreferences("updatesaleprice")
	as_errortext = "    Some database problem ocuurs         "
	ll_rowgroup = 0
	ll_receiptinvcode = this.id_master.object.receiptinvcode[1]
	do while li_counter <= ll_detailrows and lb_commitflag
		ll_rowgroup = ll_rowgroup + 1
		ll_gcode = this.id_detail.getitemnumber(li_counter, "gcode")
		ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
		ls_batch = this.id_detail.object.batch[li_counter]
		ld_expiry = this.id_detail.object.expiry[li_counter]
		ls_alternatecustomicode = this.id_detail.getitemstring(li_counter, "alternatecustomicode")
		ld_salelooseqty = this.id_detail.getitemnumber(li_counter, "qty")
		ld_price = this.id_detail.getitemnumber(li_counter, "price")
		ll_packunits = this.id_detail.getitemnumber(li_counter, "packunits")
		ld_saleprice = this.id_detail.getitemnumber(li_counter, "saleprice")
		ld_purchaseprice = this.id_detail.getitemnumber(li_counter, "purchaseprice")
		ld_avgprice = this.id_detail.getitemnumber(li_counter, "avgprice")
		ld_mrpp = this.id_detail.getitemnumber(li_counter, "mrpp")
		ld_unitweight = this.id_detail.getitemnumber(li_counter, "unitweight")
		ld_packingfactor = this.id_detail.getitemnumber(li_counter, "packingfactor")
		ll_issuereqrowid = this.id_detail.getitemnumber(li_counter, "issuereqrowid")
		ll_receiptrowid = this.id_detail.getitemnumber(li_counter, "receiptrowid")
		ll_totalpieces = this.id_detail.getitemnumber(li_counter, "totalpieces")
		ll_piecesinhand = this.id_detail.getitemnumber(li_counter, "piecesinhand")
		lc_claimable = this.id_detail.getitemstring(li_counter, "claimable")
		ld_claimablediscperc = this.id_detail.getitemnumber(li_counter, "claimablediscperc")
		ld_packcapacity = this.id_detail.getitemnumber(li_counter, "packcapacity")
		ld_areavolume = this.id_detail.getitemnumber(li_counter, "areavolume")
		ld_pcs = this.id_detail.getitemnumber(li_counter, "pcs")
		ll_sectcode = this.id_detail.getitemnumber(li_counter, "sectcode")
		ls_itemdescription = this.id_detail.getitemstring(li_counter, "itemdescription")
		ldws_column = this.id_detail.getitemstatus(li_counter, "saleprice", primary!)
		ls_updsaleprice = this.id_detail.getitemstring(li_counter, "updatesaleprice")
		ld_salelooseqty = ld_salelooseqty
		this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			this.it_transobject.getitemtotalpiecesinhand(ll_icode, ll_piecesinhand)
			if this.it_transobject.sqlcode <> 0 then
				lb_commitflag = false
			else
				this.id_detail.setitem(li_counter, "piecesinhand", ll_piecesinhand)
				if ll_piecesinhand >= ll_totalpieces then
					this.it_transobject.updateitemtotalpiecesinhand(ll_icode, -1, ll_totalpieces)
					if this.it_transobject.sqlcode <> 0 then
						lb_commitflag = false
					end if
				end if
			end if
			this.it_transobject.getitemstockall(ll_icode, ld_total_availablestock)
			if ld_total_availablestock < 0.0 or isnull(ld_total_availablestock) then
				ld_total_availablestock = 0
			end if
			if ld_salelooseqty > 0.0 and lb_commitflag then
				if isnull(ll_receiptinvcode) then
					if wf_selectitembatches(ll_gcode, ll_icode, ld_salelooseqty, ad_saledetail, ll_insertedrows, as_errortext) = 0 then
						for li_innercounter = 1 to ll_insertedrows
							ll_row = ll_itemsdetailrowcount + li_innercounter
							ad_saledetail.setitem(ll_row, "code", al_invid)
							ad_saledetail.setitem(ll_row, "alternatecustomicode", ls_alternatecustomicode)
							ad_saledetail.setitem(ll_row, "rowgroup", ll_rowgroup)
							ad_saledetail.setitem(ll_row, "packunits", ll_packunits)
							ad_saledetail.setitem(ll_row, "saleprice", ld_saleprice)
							ad_saledetail.setitem(ll_row, "avgprice", ld_avgprice)
							ad_saledetail.setitem(ll_row, "mrpp", ld_mrpp)
							ad_saledetail.setitem(ll_row, "purchaseprice", ld_purchaseprice)
							ad_saledetail.setitem(ll_row, "avgprice", ld_avgprice)
							ad_saledetail.setitem(ll_row, "unitweight", ld_unitweight)
							ad_saledetail.setitem(ll_row, "packingfactor", ld_packingfactor)
							ad_saledetail.setitem(ll_row, "sectcode", ll_sectcode)
							ad_saledetail.setitem(ll_row, "price", ld_price)
							ad_saledetail.setitem(ll_row, "saleorderrowid", this.id_detail.getitemnumber(li_counter, "saleorderrowid"))
							ad_saledetail.setitem(ll_row, "issuereqrowid", this.id_detail.getitemnumber(li_counter, "issuereqrowid"))
							ad_saledetail.setitem(ll_row, "receiptrowid", this.id_detail.getitemnumber(li_counter, "receiptrowid"))
							ad_saledetail.setitem(ll_row, "itemdescription", ls_itemdescription)
							ad_saledetail.setitem(ll_row, "areavolume", ld_areavolume)
							ad_saledetail.setitem(ll_row, "packcapacity", ld_packcapacity)
							ad_saledetail.setitem(ll_row, "claimable", lc_claimable)
							ad_saledetail.setitem(ll_row, "claimablediscperc", ld_claimablediscperc)
							ad_saledetail.setitem(ll_row, "pcs", ld_pcs)
							ad_saledetail.setitem(ll_row, "piecesinhand", ll_piecesinhand)
							ad_saledetail.setitem(ll_row, "totalpieces", ll_totalpieces)
							ls_batch = ad_saledetail.getitemstring(ll_row, "batch")
							ld_expiry = ad_saledetail.getitemdatetime(ll_row, "expiry")
							ld_looseqty = ad_saledetail.getitemnumber(ll_row, "qty")
							ld_stock = ad_saledetail.getitemnumber(ll_row, "stock")
							ld_total_availablestock = ld_total_availablestock - ld_looseqty
							ad_saledetail.setitem(ll_row, "balancestock", ld_total_availablestock)
							ld_newstock = ld_stock - ld_looseqty
							if ld_newstock > 0.0 then
								this.it_transobject.saleupdateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock, ld_stock)
							else
								this.it_transobject.deleteitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
							end if
							if this.it_transobject.sqlcode <> 0 then
								lb_commitflag = false
								as_errortext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
							end if
						next
						ll_itemsdetailrowcount = ll_itemsdetailrowcount + ll_insertedrows
					else
						this.id_detail.setitem(li_counter, "stock", ll_insertedrows)
						lb_commitflag = false
						as_errortext = "Stock Updation Error:~r~nStock does not exist for the item (" + this.id_detail.getitemstring(li_counter, "itemname") + ") in row number " + string(li_counter)
					end if
				else
					ll_row = ad_saledetail.insertrow(0)
					ad_saledetail.setitem(ll_row, "code", al_invid)
					ad_saledetail.setitem(ll_row, "alternatecustomicode", ls_alternatecustomicode)
					ad_saledetail.setitem(ll_row, "icode", ll_icode)
					ad_saledetail.setitem(ll_row, "gcode", ll_gcode)
					ad_saledetail.setitem(ll_row, "batch", ls_batch)
					ad_saledetail.setitem(ll_row, "expiry", ld_expiry)
					ad_saledetail.setitem(ll_row, "qty", ld_salelooseqty)
					ad_saledetail.setitem(ll_row, "rowgroup", ll_rowgroup)
					ad_saledetail.setitem(ll_row, "packunits", ll_packunits)
					ad_saledetail.setitem(ll_row, "saleprice", ld_saleprice)
					ad_saledetail.setitem(ll_row, "avgprice", ld_avgprice)
					ad_saledetail.setitem(ll_row, "mrpp", ld_mrpp)
					ad_saledetail.setitem(ll_row, "purchaseprice", ld_purchaseprice)
					ad_saledetail.setitem(ll_row, "avgprice", ld_avgprice)
					ad_saledetail.setitem(ll_row, "unitweight", ld_unitweight)
					ad_saledetail.setitem(ll_row, "packingfactor", ld_packingfactor)
					ad_saledetail.setitem(ll_row, "sectcode", ll_sectcode)
					ad_saledetail.setitem(ll_row, "price", ld_price)
					ad_saledetail.setitem(ll_row, "saleorderrowid", this.id_detail.getitemnumber(li_counter, "saleorderrowid"))
					ad_saledetail.setitem(ll_row, "issuereqrowid", this.id_detail.getitemnumber(li_counter, "issuereqrowid"))
					ad_saledetail.setitem(ll_row, "receiptrowid", this.id_detail.getitemnumber(li_counter, "receiptrowid"))
					ad_saledetail.setitem(ll_row, "itemdescription", ls_itemdescription)
					ad_saledetail.setitem(ll_row, "areavolume", ld_areavolume)
					ad_saledetail.setitem(ll_row, "packcapacity", ld_packcapacity)
					ad_saledetail.setitem(ll_row, "claimable", lc_claimable)
					ad_saledetail.setitem(ll_row, "claimablediscperc", ld_claimablediscperc)
					ad_saledetail.setitem(ll_row, "pcs", ld_pcs)
					ad_saledetail.setitem(ll_row, "piecesinhand", ll_piecesinhand)
					ad_saledetail.setitem(ll_row, "totalpieces", ll_totalpieces)
					ld_total_availablestock = ld_total_availablestock - ld_salelooseqty
					ad_saledetail.setitem(ll_row, "balancestock", ld_total_availablestock)
					this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
					if this.it_transobject.sqlcode = 0 then
						if ld_stock >= ld_salelooseqty then
							ld_newstock = ld_stock - ld_salelooseqty
							if ld_newstock > 0.0 then
								this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
								if this.it_transobject.sqlcode <> 0 then
									lb_commitflag = false
									as_errortext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
								end if
							else
								this.it_transobject.deleteitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
								if this.it_transobject.sqlcode <> 0 then
									lb_commitflag = false
									as_errortext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
								end if
							end if
						else
							lb_commitflag = false
							as_errortext = "Stock quantity (" + string(ld_stock) + ") is less than issued quantity (" + string(ld_salelooseqty) + ") "
							as_errortext = as_errortext + "~r~nPossible suggestions are decrease the issue quantity"
							as_errortext = as_errortext + "~r~nOr~r~nSelect some other godown in which enough stock exists."
						end if
					else
						as_errortext = "Batch Wise Stock Fetch Error:~r~n" + this.it_transobject.sqlerrtext
						lb_commitflag = false
					end if
				end if
			end if
		else
			lb_commitflag = false
		end if
		li_counter = li_counter + 1
	loop
	if not lb_commitflag then
		al_errorrow = li_counter - 1
		messagebox("Database Error", as_errortext)
	end if
	SQL rollback USING sqlca;
	ul_rowcount = ad_saledetail.rowcount()
	sqlca.getmaxutn(ul_rowcount, ul_maxutn)
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
	else
		SQL rollback USING sqlca;
		messagebox("Saving", "Error in generating UTN ")
		return false
	end if
	for li_counter = 1 to ad_saledetail.rowcount()
		ad_saledetail.setitem(li_counter, "IssueUtn", ul_maxutn)
		ul_maxutn = ul_maxutn + 1
	next
	return lb_commitflag

// w_issue.wf_populate_recipe() returns long
	datastore lds_detail
	s_arguements lstr_arg
	long ll_totalrows
	long ll_currrow
	long ll_rowcount
	long ll_populatecount
	long ll_drow
	long ll_ds_row
	integer li_retcode
	integer li_errcode
	string ls_errortext
	string ls_itemname
	boolean lb_enablesave
	boolean lb_editsaleprice
	boolean lb_insertrow
	double ld_recipeqty
	double ld_qty
	if wf_iseditable() = false then
		return 0
	end if
	lds_detail = create datastore
	open(w_arg_item_recipe_qty_sdate_ldate)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		lds_detail.dataobject = "d_recipedetail"
		lds_detail.settransobject(this.it_transobject)
		li_retcode = lds_detail.retrieve(lstr_arg.l_code1)
		ll_totalrows = lds_detail.rowcount()
		if ll_totalrows > 0 then
			setredraw(false)
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
			this.id_detail.reset()
			lb_enablesave = true
			for ll_rowcount = 1 to ll_totalrows
				ll_populatecount = ll_populatecount + 1
				ll_drow = this.id_detail.insertrow(0)
				li_errcode = 0
				ls_itemname = lds_detail.getitemstring(ll_rowcount, "itemname")
				wf_inititeminfo(lds_detail.getitemnumber(ll_rowcount, "icode"), ll_drow, li_errcode, ls_errortext)
				if li_errcode = -2 then
					messagebox("Problem in Recipe Population!", "Row No. : " + trim(string(ll_drow)) + "~r~nItem Name = " + ls_itemname + "~r~n" + ls_errortext)
				end if
				ld_recipeqty = lds_detail.getitemnumber(ll_rowcount, "qty")
				ld_qty = round(lstr_arg.l_code2 * ld_recipeqty, f_get_colprecision("Qty"))
				this.id_detail.setitem(ll_drow, "qty", ld_qty)
			next
			setredraw(true)
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return 0

// w_issue.wf_populate_saleorder() returns long
	datastore lds_saleorderdetail
	datastore lds_saleorderheader
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_counter
	long ll_tmpqty
	long ll_tmpbonus
	long ll_tmprowid
	long ll_tmpcode
	long ll_icode
	long ll_recipientcode
	integer li_retcode
	integer li_errcode
	string ls_errortext
	string ls_itemname
	boolean lb_enablesave
	boolean lb_insertrow
	if wf_iseditable() = false then
		return 0
	end if
	lds_saleorderdetail = create datastore
	lds_saleorderheader = create datastore
	open(w_editsaleorder_finalized_form)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_saleorderdetail.dataobject = "d_SaleOrderdetail_issue_retrieve"
		lds_saleorderdetail.settransobject(this.it_transobject)
		lds_saleorderheader.dataobject = "d_SaleOrderheader"
		lds_saleorderheader.settransobject(this.it_transobject)
		ll_row = lds_saleorderheader.retrieve(lstr_template.l_invtemplate)
		lds_saleorderdetail.retrieve(lstr_template.l_invtemplate)
		ll_totalrows = lds_saleorderheader.retrieve(lstr_template.l_invtemplate)
		if ll_row <= 0 then
			li_retcode = -1
		else
			ll_mrow = this.id_master.getrow()
			this.id_master.setitem(ll_mrow, "RecipientCode", ll_recipientcode)
			event ue_set_requiredcolumns(ll_recipientcode, 0)
			this.id_master.setitem(ll_mrow, "AccCode", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "custcode"))
			this.id_master.setitem(ll_mrow, "pricetypecode", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "sprice"))
			this.id_master.setitem(ll_mrow, "remarks", lds_saleorderheader.getitemstring(lds_saleorderheader.getrow(), "remarks"))
			this.id_master.setitem(ll_mrow, "referenceno", lds_saleorderheader.getitemstring(lds_saleorderheader.getrow(), "custrefno"))
			this.id_master.setitem(ll_mrow, "referencedate", lds_saleorderheader.getitemdatetime(lds_saleorderheader.getrow(), "deliverydeadline"))
			this.id_master.setitem(ll_mrow, "headerno", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "headerno"))
		end if
		ll_totalrows = lds_saleorderdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		if lb_enablesave then
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
			this.id_detail.reset()
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				lb_insertrow = false
				ll_tmpqty = 0
				ll_tmpbonus = 0
				if lstr_template.i_invtype = 0 then
					lb_insertrow = true
				else
					if this.ib_modify and this.id_master.getitemnumber(1, "code") > 0.0 then
						ll_tmprowid = lds_saleorderdetail.getitemnumber(ll_counter, "rowid")
						ll_tmpcode = this.id_master.getitemnumber(1, "code")
						SQL SELECT sum ( qty ) INTO :ll_tmpqty FROM DBO.IssueDetail WHERE SaleOrderRowID =:ll_tmprowid AND IssueInvCode =:ll_tmpcode USING sqlca;
						if sqlca.sqlcode <> 0 then
							lb_insertrow = false
						end if
					end if
					if isnull(ll_tmpqty) then
						ll_tmpqty = 0
					end if
					if lds_saleorderdetail.getitemnumber(ll_counter, "looseqty") + lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty") - lds_saleorderdetail.getitemnumber(ll_counter, "issueqty") + ll_tmpqty > 0.0 then
						lb_insertrow = true
					end if
				end if
				if lb_insertrow = true then
					ll_rowcount = this.id_detail.insertrow(0)
					ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_saleorderdetail.getitemnumber(ll_counter, "gcode")), 1, this.idc_godown.rowcount())
					ll_icode = lds_saleorderdetail.getitemnumber(ll_counter, "icode")
					ls_itemname = lds_saleorderdetail.getitemstring(ll_rowcount, "itemname")
					if wf_inititeminfo(ll_icode, ll_rowcount, li_errcode, ls_errortext) then
						ll_gcode = lds_saleorderdetail.getitemnumber(ll_counter, "gcode")
						this.id_detail.setitem(ll_rowcount, "gcode", ll_gcode)
						this.id_detail.setitem(ll_rowcount, "SaleOrderrowid", lds_saleorderdetail.getitemnumber(ll_counter, "rowid"))
						this.id_detail.object.price[ll_rowcount] = lds_saleorderdetail.object.saleprice[ll_counter]
						this.id_detail.object.saleprice[ll_rowcount] = lds_saleorderdetail.object.saleprice[ll_counter]
						if lstr_template.i_invtype = 0 then
							this.id_detail.setitem(ll_rowcount, "qty", lds_saleorderdetail.getitemnumber(ll_counter, "looseqty") + lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty"))
						else
							ll_tmpqty = lds_saleorderdetail.getitemnumber(ll_counter, "looseqty") - lds_saleorderdetail.getitemnumber(ll_counter, "issueqty") + ll_tmpqty
							if ll_tmpqty > 0 then
								this.id_detail.setitem(ll_rowcount, "qty", ll_tmpqty)
							end if
						end if
					end if
				end if
			next
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return li_retcode

// w_issue.wf_selectitembatches(long al_gcode, long al_icode, double al_qty, datawindow ad_itemsdetail, long al_rowscount, string al_errortext) returns integer
	datastore lds_itemstockinfo
	long ll_counter
	long ll_detailrowcount
	boolean lb_flag
	integer li_errcode
	double ld_saleqty
	double ld_reqqty
	double ld_totalstock
	double ld_batchqty
	lds_itemstockinfo = create datastore
	lds_itemstockinfo.dataobject = "d_itemstockinfo"
	lds_itemstockinfo.settransobject(this.it_transobject)
	if lds_itemstockinfo.retrieve(al_gcode, al_icode) > 0 then
		ld_totalstock = lds_itemstockinfo.getitemnumber(1, "c_totalstock")
		if ld_totalstock >= al_qty then
			ld_reqqty = al_qty
			ll_detailrowcount = ad_itemsdetail.rowcount()
			ll_counter = 1
			do while ll_counter <= lds_itemstockinfo.rowcount() and not lb_flag
				ld_batchqty = lds_itemstockinfo.getitemnumber(ll_counter, "currqty")
				if ld_batchqty >= ld_reqqty then
					ld_saleqty = ld_reqqty
					lb_flag = true
				else
					ld_saleqty = ld_batchqty
					ld_reqqty = ld_reqqty - ld_batchqty
				end if
				ad_itemsdetail.insertrow(0)
				ll_detailrowcount = ll_detailrowcount + 1
				ad_itemsdetail.setitem(ll_detailrowcount, "gcode", al_gcode)
				ad_itemsdetail.setitem(ll_detailrowcount, "icode", al_icode)
				ad_itemsdetail.setitem(ll_detailrowcount, "batch", lds_itemstockinfo.getitemstring(ll_counter, "batch"))
				ad_itemsdetail.setitem(ll_detailrowcount, "expiry", lds_itemstockinfo.getitemdatetime(ll_counter, "expiry"))
				ad_itemsdetail.setitem(ll_detailrowcount, "stock", ld_batchqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "totalstock", ld_totalstock)
				ad_itemsdetail.setitem(ll_detailrowcount, "qty", ld_saleqty)
				ll_counter = ll_counter + 1
			loop
			al_rowscount = ll_counter - 1
		else
			li_errcode = 1
			al_rowscount = ld_totalstock
			al_errortext = "Stock has been decreased for this item   "
		end if
	else
		li_errcode = 1
		al_rowscount = ld_totalstock
		al_errortext = "Stock does not exist for this item   "
	end if
	destroy lds_itemstockinfo
	return li_errcode

// w_issue.wf_presaleinvinfo() returns 0
	s_previnvinfo ls_previnvinfo
	if this.id_detail = getfocus() and this.id_master.getitemnumber(1, "recipientcode") = 2.0 and this.id_detail.rowcount() > 0 then
		ls_previnvinfo.ar_customer = this.id_master.getitemnumber(this.id_master.getrow(), "acccode")
		ls_previnvinfo.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_previnvinfo.ar_invdate = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_previnvinfo, ls_previnvinfo)
	end if

// w_issue.wf_print_storesummary(long al_invcode) returns long
	long ll_retcode
	string ls_report
	datastore lds_storesummary
	if f_stringpreferences("PrintStoreSummWithIssue") = "N" then
		return 0
	end if
	lds_storesummary = create datastore
	if gs_company = "SHAHZADPLYWOOD" or gs_company = "RSHOP" then
		ls_report = "d_storekeepersum_withissu_shahzadplywood"
	elseif gs_company = "FORLANDMOTORS" then
		ls_report = "d_forlandmotors_issueprint_dc"
	else
		ls_report = "d_storekeepersum_withissu_shahzadplywood"
	end if
	lds_storesummary.dataobject = ls_report
	lds_storesummary.settransobject(this.it_transobject)
	ll_retcode = lds_storesummary.retrieve(al_invcode, this.il_groupcode)
	if ll_retcode > 0 then
		lds_storesummary.print()
	end if
	return 0

// w_issue.wf_setcomments() returns integer
	s_quotationremarks ls_quotationremarks
	ls_quotationremarks.remarks2 = this.id_master.getitemstring(1, "terms1")
	ls_quotationremarks.remarks3 = this.id_master.getitemstring(1, "terms2")
	openwithparm(w_salecomments, ls_quotationremarks)
	ls_quotationremarks = message.powerobjectparm
	this.id_master.setitem(1, "terms1", ls_quotationremarks.remarks2)
	this.id_master.setitem(1, "terms2", ls_quotationremarks.remarks3)
	return 1

// w_issue.wf_deletesaleinvoice(long al_invcode) returns integer
	SQL Delete IssueDetail Where IssueDetail.IssueInvCode =:al_invcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_issue.wf_getissuestockinfo(long al_invcode, long al_gcode, long al_icode, double al_issueqty) returns integer
	SQL Select IsNull ( Sum ( IssueDetail.qty ) , 0 ) INTO :al_issueqty from IssueDetail where IssueDetail.Issueinvcode =:al_invcode and IssueDetail.gcode =:al_gcode and IssueDetail.icode =:al_icode USING this.it_transobject;
	if isnull(al_issueqty) then
		al_issueqty = 0
	end if
	return this.it_transobject.sqlcode

// w_issue.wf_populate_issue_request() returns long
	datastore lds_issuereqdetail
	datastore lds_issuereqheader
	datastore lds_items
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_counter
	long ll_tmpqty
	long ll_tmpbonus
	long ll_tmprowid
	long ll_acccode
	long ll_subcode
	long ll_tmpcode
	long ll_icode
	long ll_null
	long ll_ds_row
	long ll_drow
	long ll_recipientcode
	long ll_deptcode
	integer li_retcode
	integer li_errcode
	integer li_gcode
	string ls_errortext
	string ls_itemname
	boolean lb_enablesave
	boolean lb_insertrow
	double ld_qty
	double ld_stock
	setnull(ll_null)
	if wf_iseditable() = false then
		return 0
	end if
	lds_issuereqdetail = create datastore
	lds_issuereqheader = create datastore
	lds_items = create datastore
	open(w_editissuereqform)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_issuereqdetail.dataobject = "d_issuereqdetail_retrieve_issue"
		lds_issuereqdetail.settransobject(this.it_transobject)
		lds_issuereqheader.dataobject = "d_IssueReqheader"
		lds_issuereqheader.settransobject(this.it_transobject)
		lds_items.dataobject = "d_issuereq_issuepopulation_rejected"
		lds_items.settransobject(this.it_transobject)
		ll_row = lds_issuereqheader.retrieve(lstr_template.l_invtemplate)
		if ll_row <= 0 then
			li_retcode = -1
		else
			ll_mrow = this.id_master.getrow()
			ll_deptcode = lds_issuereqheader.getitemnumber(lds_issuereqheader.getrow(), "deptcode")
			this.id_master.setitem(ll_mrow, "RecipientCode", ll_recipientcode)
			event ue_set_requiredcolumns(ll_recipientcode, 0)
			if lds_issuereqheader.object.acccode[1] > 0 then
				ll_acccode = lds_issuereqheader.object.acccode[1]
				SQL SELECT SubCode INTO :ll_subcode FROM Accounts WHERE AccCode =:ll_acccode USING this.it_transobject;
				if this.it_transobject.sqlcode = 0 then
					if ll_subcode = 3 then
						ll_recipientcode = 2
					else
						ll_recipientcode = 3
					end if
					this.id_master.setitem(ll_mrow, "RecipientCode", ll_recipientcode)
					event ue_set_requiredcolumns(ll_recipientcode, 0)
					this.id_master.setitem(ll_mrow, "AccCode", ll_acccode)
				end if
			elseif lds_issuereqheader.object.deptcode[1] > 0 then
				ll_recipientcode = 1
				this.id_master.setitem(ll_mrow, "RecipientCode", ll_recipientcode)
				event ue_set_requiredcolumns(ll_recipientcode, 0)
				this.id_master.setitem(ll_mrow, "AccCode", ll_null)
				this.id_master.setitem(ll_mrow, "deptcode", ll_deptcode)
			elseif lds_issuereqheader.object.smancode[1] > 0 then
				ll_recipientcode = 4
				this.id_master.setitem(ll_mrow, "RecipientCode", ll_recipientcode)
				event ue_set_requiredcolumns(ll_recipientcode, 0)
				this.id_master.setitem(ll_mrow, "recipientsalesman", lds_issuereqheader.getitemnumber(lds_issuereqheader.getrow(), "smancode"))
				this.id_master.setitem(ll_mrow, "AccCode", ll_null)
			end if
			this.id_master.setitem(ll_mrow, "smancode", lds_issuereqheader.getitemnumber(lds_issuereqheader.getrow(), "smancode"))
			this.id_master.setitem(ll_mrow, "areacode", lds_issuereqheader.getitemnumber(lds_issuereqheader.getrow(), "areacode"))
			this.id_master.setitem(ll_mrow, "pricetypecode", 1)
			this.id_master.setitem(ll_mrow, "remarks", lds_issuereqheader.getitemstring(lds_issuereqheader.getrow(), "remarks"))
			this.id_master.setitem(ll_mrow, "ServiceOCode", lds_issuereqheader.getitemnumber(lds_issuereqheader.getrow(), "ServiceOCode"))
			lds_issuereqdetail.retrieve(lstr_template.l_invtemplate)
			ll_totalrows = lds_issuereqdetail.rowcount()
			if ll_totalrows > 0 then
				lb_enablesave = true
			end if
		end if
		if lb_enablesave then
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
			this.id_detail.reset()
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				lb_insertrow = false
				ll_tmpqty = 0
				ll_tmpbonus = 0
				if lstr_template.i_invtype = 0 then
					lb_insertrow = true
				else
					if this.ib_modify and this.id_master.getitemnumber(1, "code") > 0.0 then
						ll_tmprowid = lds_issuereqdetail.getitemnumber(ll_counter, "issuereqrowid")
						ll_tmpcode = this.id_master.getitemnumber(1, "code")
						SQL SELECT sum ( qty ) INTO :ll_tmpqty FROM DBO.IssueDetail WHERE IssueReqRowID =:ll_tmprowid AND IssueInvCode =:ll_tmpcode USING sqlca;
						if sqlca.sqlcode <> 0 then
							lb_insertrow = false
						end if
					end if
					if isnull(ll_tmpqty) then
						ll_tmpqty = 0
					end if
					if lds_issuereqdetail.getitemnumber(ll_counter, "qty") - lds_issuereqdetail.getitemnumber(ll_counter, "issueqty") + ll_tmpqty > 0.0 then
						lb_insertrow = true
					end if
				end if
				if lb_insertrow = true then
					ll_rowcount = this.id_detail.insertrow(0)
					ll_icode = lds_issuereqdetail.getitemnumber(ll_counter, "icode")
					ls_itemname = lds_issuereqdetail.getitemstring(ll_counter, "itemname")
					li_gcode = this.id_detail.object.gcode[ll_rowcount]
					if wf_inititeminfo(ll_icode, ll_rowcount, li_errcode, ls_errortext) then
						this.id_detail.setitem(ll_rowcount, "IssueReqrowid", lds_issuereqdetail.getitemnumber(ll_counter, "issuereqrowid"))
						this.id_detail.setitem(ll_rowcount, "Claimable", lds_issuereqdetail.getitemstring(ll_counter, "Claimable"))
						this.id_detail.setitem(ll_rowcount, "ClaimableDiscperc", lds_issuereqdetail.getitemnumber(ll_counter, "ClaimableDiscperc"))
						if lstr_template.i_invtype = 0 then
							this.id_detail.setitem(ll_rowcount, "qty", lds_issuereqdetail.getitemnumber(ll_counter, "qty"))
						else
							ll_tmpqty = lds_issuereqdetail.getitemnumber(ll_counter, "qty") - lds_issuereqdetail.getitemnumber(ll_counter, "issueqty") + ll_tmpqty
							if ll_tmpqty > 0 then
								this.id_detail.setitem(ll_rowcount, "qty", ll_tmpqty)
							end if
						end if
					end if
					ld_qty = this.id_detail.object.qty[ll_rowcount]
					if ld_qty > 0.0 and ld_qty > this.id_detail.object.stock[ll_rowcount] then
						ll_ds_row = lds_items.insertrow(0)
						ld_stock = this.id_detail.getitemnumber(ll_rowcount, "stock")
						lds_items.setitem(ll_ds_row, "deptcode", ll_deptcode)
						lds_items.setitem(ll_ds_row, "code", lds_issuereqdetail.getitemnumber(ll_counter, "code"))
						lds_items.setitem(ll_ds_row, "icode", lds_issuereqdetail.getitemnumber(ll_counter, "icode"))
						lds_items.setitem(ll_ds_row, "stock", ld_stock)
						lds_items.setitem(ll_ds_row, "balance", lds_issuereqdetail.getitemnumber(ll_counter, "qty") - ld_stock)
						lds_items.setitem(ll_ds_row, "type", "L")
						lds_items.setitem(ll_ds_row, "aliasname", this.id_detail.getitemstring(ll_rowcount, "fullcode"))
						lds_items.setitem(ll_ds_row, "itemname", lds_issuereqdetail.getitemstring(ll_counter, "itemname"))
						lds_items.setitem(ll_ds_row, "qty", lds_issuereqdetail.getitemnumber(ll_counter, "qty"))
						if ld_stock > ld_qty and ld_stock > 0.0 then
							this.id_detail.setitem(ll_rowcount, "qty", ld_qty)
						elseif ld_stock <= 0.0 then
							this.id_detail.setitem(ll_rowcount, "qty", 1)
						else
							this.id_detail.setitem(ll_rowcount, "qty", ld_stock)
						end if
						if ld_stock <= 0.0 then
							this.id_detail.setrow(ll_rowcount)
							this.id_detail.scrolltorow(ll_rowcount)
							event ue_deleteitem()
						end if
					end if
				end if
			next
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	if lds_items.rowcount() > 0 then
		openwithparm(w_issuereq_issuepopulation_rejected, lds_items)
	end if
	wf_grandtotal()
	return li_retcode

// w_issue.wf_itemissuehistory() returns 0
	s_itemsalehistory ls_itemsalehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itemsalehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itemsalehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itemissuehistory, ls_itemsalehistory)
	end if

// w_issue.wf_apply_associatedquotation(integer ai_mode) returns long
	long ll_custcode
	long ll_masterrow
	long ll_quotationcode
	long ll_detailrows
	long ll_qheaderrow
	long ll_quotationrows
	long ll_found
	long ll_loosepack
	long ll_rowcount
	long ll_quotpackunits
	long ll_icode
	long ll_notfound_itemcount
	long ll_recipientcode
	double ld_quotprice
	double ld_quotdiscperc
	double ld_quotitemflatdisc
	double ld_quotqty
	double ld_quotbonusqty
	double ld_qty
	double ld_bonusqty
	double ld_bonusfactor
	string ls_msgtitle
	string ls_itemname
	string ls_msgdetail
	boolean lb_editsaleprice
	boolean lb_editsalediscperc
	boolean lb_editbonusqty
	boolean lb_edititewflatdisc
	datastore lds_quotationdetail
	datastore lds_quotationheader
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_recipientcode = this.id_master.getitemnumber(ll_masterrow, "recipientcode")
	if ll_recipientcode <> 2 then
		return 1
	end if
	ll_custcode = this.id_master.getitemnumber(ll_masterrow, "acccode")
	if ll_custcode = 0 or isnull(ll_custcode) then
		messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Items before applying Customers' Associated Quotation", stopsign!)
		return 0
	end if
	ll_quotationcode = wf_get_associatedquotationcode(ll_custcode)
	if ll_quotationcode < 0 then
		if ll_quotationcode = -1 then
			messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
			return 0
		else
			messagebox(ls_msgtitle, "Problem in retrieving Associated Quotation of Customer", stopsign!)
			return 0
		end if
	elseif ll_quotationcode = 0 then
		if ai_mode = 0 then
			messagebox(ls_msgtitle, "No Associated Quotation found for this Customer", stopsign!)
			return 0
		else
			return 1
		end if
		return
	end if
	lds_quotationdetail = create datastore
	lds_quotationheader = create datastore
	lds_quotationdetail.dataobject = "d_quotationdetail_retrieve"
	lds_quotationdetail.settransobject(this.it_transobject)
	lds_quotationheader.dataobject = "d_quotationheader"
	lds_quotationheader.settransobject(this.it_transobject)
	ll_qheaderrow = lds_quotationheader.retrieve(ll_quotationcode)
	if ll_qheaderrow < 0 then
		messagebox(ls_msgtitle, "Associated Quotation Header Retrieval Problem", stopsign!)
		return 0
	else
		ll_qheaderrow = lds_quotationheader.rowcount()
		if ll_qheaderrow = 0 then
			messagebox(ls_msgtitle, "Associated Quotation Does not Exist", stopsign!)
			return 0
		end if
	end if
	ll_quotationrows = lds_quotationdetail.retrieve(ll_quotationcode)
	if ll_quotationrows < 0 then
		messagebox(ls_msgtitle, "Associated Quotation Detail Retrieval Problem", stopsign!)
		return 0
	else
		ll_quotationrows = lds_quotationdetail.rowcount()
		if ll_quotationrows = 0 then
			if ai_mode = 0 then
				messagebox(ls_msgtitle, "Associated Quotation contain no rows", stopsign!)
				return 0
			else
				return 1
			end if
			return
		end if
	end if
	ll_loosepack = lds_quotationheader.getitemnumber(ll_qheaderrow, "loosepack")
	setredraw(false)
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ll_found = 0
		ll_found = lds_quotationdetail.find("icode = " + trim(string(ll_icode)), 1, ll_quotationrows)
		if ll_found > 0 then
			ll_quotpackunits = lds_quotationdetail.getitemnumber(ll_found, "packunits")
			ld_quotdiscperc = lds_quotationdetail.getitemnumber(ll_found, "discperc")
			ld_quotitemflatdisc = lds_quotationdetail.getitemnumber(ll_found, "itemflatdisc")
			if ll_quotpackunits = 0 then
				ll_quotpackunits = 1
			end if
			if ll_loosepack = 1 then
				ld_quotqty = lds_quotationdetail.getitemnumber(ll_found, "looseqty")
				ld_quotbonusqty = lds_quotationdetail.getitemnumber(ll_found, "bonusqty")
				ld_quotprice = lds_quotationdetail.getitemnumber(ll_found, "saleprice")
			else
				ld_quotqty = lds_quotationdetail.getitemnumber(ll_found, "looseqty") * ll_quotpackunits
				ld_quotbonusqty = lds_quotationdetail.getitemnumber(ll_found, "bonusqty") * ll_quotpackunits
				ld_quotprice = round(lds_quotationdetail.getitemnumber(ll_found, "saleprice") / ll_quotpackunits, 2)
			end if
			if ld_quotqty <= 0.0 then
				ld_quotqty = 1
			end if
			this.id_detail.setitem(ll_rowcount, "price", ld_quotprice)
		else
			ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname
			ll_notfound_itemcount = ll_notfound_itemcount + 1
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_notfound_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Guidelines Exist for Following " + trim(string(ll_notfound_itemcount)) + " item(s) in Associated Quotation/Pricing Contract~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_issue.wf_get_associatedquotationcode(long al_custcode) returns long
	long ll_retcode
	long ll_quotationcode
	if al_custcode = 0 or isnull(al_custcode) then
		ll_retcode = -1
		return ll_retcode
	else
		SQL SELECT AssociatedQuotationCode INTO :ll_quotationcode FROM DBO.Customer WHERE CustCode =:al_custcode USING sqlca;
		if sqlca.sqlcode = 0 then
			if ll_quotationcode = 0 or isnull(ll_quotationcode) then
				ll_retcode = 0
			else
				ll_retcode = ll_quotationcode
			end if
		else
			ll_retcode = -2
		end if
	end if
	return ll_retcode

// w_issue.wf_search_customer() returns 0
	long ll_code
	long ll_oldcode
	s_popup_selection lstr_selection
	if wf_iseditable() = false then
		return
	end if
	this.id_master.setcolumn("acccode")
	this.id_master.setfocus()
	openwithparm(w_popup_partialsearch_selection, "d_customer_list")
	lstr_selection = message.powerobjectparm
	if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
		ll_code = lstr_selection.l_code2
		this.id_master.setitem(1, "acccode", ll_code)
	end if

// w_issue.wf_fetch_customer_balance(long al_custcode, long row) returns 0
	long ll_custcode
	long ll_counter
	double ld_customerbalance
	if f_stringpreferences("InSaleCustomerBalance") = "Y" then
		this.id_master.accepttext()
		ll_custcode = this.id_master.getitemnumber(row, "custcode")
		for ll_counter = 1 to this.ids_customersbalance.rowcount()
			if this.ids_customersbalance.getitemnumber(ll_counter, "code1") = this.id_master.getitemnumber(row, "custcode") then
				ld_customerbalance = this.ids_customersbalance.getitemnumber(ll_counter, "value1")
				this.id_master.setitem(row, "customerbalance", ld_customerbalance)
				if ld_customerbalance > 0.0 then
					this.id_master.setitem(row, "debitorcredit", "Dr")
				else
					this.id_master.setitem(row, "debitorcredit", "Cr")
				end if
				return
			else
				this.id_master.setitem(row, "debitorcredit", "Cr")
				this.id_master.setitem(row, "customerbalance", 0)
			end if
		next
	end if

// w_issue.wf_viewheader() returns long
	s_dw_header ls_dw_header
	string[] ls_values
	string ls_posted
	long ll_row
	long ll_currrow
	integer li_protectdw
	datetime ldt_datetime
	if this.tab_retrieve.selectedtab <> 1 then
		return -1
	end if
	ls_posted = this.id_master.getitemstring(this.id_master.getrow(), "Posted")
	ls_dw_header.dw_header = this.id_master
	if this.editflag = false and ls_posted = "Y" then
		ls_dw_header.i_protectdw = 1
	else
		ls_dw_header.i_protectdw = 0
	end if
	openwithparm(w_view_issueheader, ls_dw_header)
	ls_dw_header = message.powerobjectparm
	if ls_dw_header.i_closemode = -1 then
		return -1
	end if
	ll_row = this.id_master.getrow()
	ls_values = ls_dw_header.values
	if this.editflag = true then
		this.id_master.setitem(ll_row, "patientregno", ls_values[1])
		this.id_master.setitem(ll_row, "patientcode", long(ls_values[2]))
		this.id_master.setitem(ll_row, "custsitecode", long(ls_values[3]))
		this.id_master.setitem(ll_row, "refno2", ls_values[4])
		this.id_master.setitem(ll_row, "refno3", ls_values[5])
		this.id_master.setitem(ll_row, "refno4", ls_values[6])
		this.id_master.setitem(ll_row, "refno5", ls_values[7])
		this.id_master.setitem(ll_row, "orderdate", datetime(date(ls_values[8]), time(ls_values[9])))
	end if
	return 1

// w_issue.wf_validateserviceorder(long al_code) returns long
	long ll_code
	long ll_custcode
	SQL SELECT ServiceOCode , CustCode INTO :ll_code, :ll_custcode FROM ServiceOHeader WHERE ServiceOCode =:al_code AND Posted ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ll_code) or ll_code < 0 then
			return -1
		else
			this.id_master.object.acccode[1] = ll_custcode
			return 0
		end if
		return
	end if
	return -1

// w_issue.wf_validate_pcs(long row, string data) returns long
	long ll_errcode
	long ll_found
	double ld_storedqty
	double ld_newqty
	double ld_stock
	double ld_desiredbonus
	double ld_areavolume
	double ld_pcs
	double ld_packcapacity
	double ld_tmpqty
	integer li_roundupto
	string ls_null
	setnull(ls_null)
	ld_packcapacity = this.id_detail.object.packcapacity[row]
	if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
		ld_packcapacity = 1
	end if
	ld_areavolume = this.id_detail.object.areavolume[row]
	if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
		ld_areavolume = 1
	end if
	ld_pcs = double(data)
	li_roundupto = f_get_colprecision("Qty")
	ld_tmpqty = round(ld_pcs * ld_areavolume, li_roundupto)
	if ld_pcs > 0.0 then
		this.id_detail.setitem(row, "qty", ld_tmpqty)
		this.id_detail.setitem(row, "cartons", trim(string(long(ld_pcs / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(ld_pcs mod ld_packcapacity, 2))))))
	else
		ll_errcode = 1
		messagebox("PCS Validation", "Only possitive PCS are allowed for this item", stopsign!)
	end if
	return ll_errcode

// w_issue.wf_validateworkorder(long al_code) returns long
	long ll_code
	long ll_custcode
	long ll_recipientcode
	SQL SELECT WorkOrderCode , CustCode INTO :ll_code, :ll_custcode FROM WorkOrder WHERE WorkOrderCode =:al_code AND Approved ='Y' AND Posted ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ll_code) or ll_code < 0 then
			return -1
		else
			ll_recipientcode = 2
			this.id_master.object.recipientcode[1] = ll_recipientcode
			post event ue_set_requiredcolumns(ll_recipientcode, 1)
			this.id_master.object.acccode[1] = ll_custcode
			wf_customerinfo(ll_custcode)
			return 0
		end if
		return
	end if
	return -1

// w_issue.wf_set_itemimage(long al_icode) returns long
	long ll_rowid
	string ls_filename
	string ls_imagetype
	string ls_imagedesc
	blob lb_image
	this.id_master.object.p_itemimage.filename = ""
	if al_icode <= 0 or isnull(al_icode) then
		return 0
	end if
	if f_stringpreferences("showitemimageinissue") = "N" then
		return 0
	end if
	this.it_imagetrans.getfirstitemimagedetail(al_icode, ll_rowid, ls_imagetype, ls_imagedesc)
	if this.it_imagetrans.sqlcode <> 0 then
		messagebox("Item Image/Picture ", "Unable to fetch item Image Details.~r~nReasons are:~r~n" + this.it_imagetrans.sqlerrtext)
		return -1
	end if
	if ll_rowid <= 0 then
		return 0
	end if
	SQL SelectBlob ItemImage INTO :lb_image From ItemImage Where Icode =:al_icode AND RowID =:ll_rowid USING this.it_imagetrans;
	if this.it_imagetrans.sqlcode <> 0 then
		messagebox("Item Image/Picture ", "Unable to fetch item Image.~r~nReasons are:~r~n" + this.it_imagetrans.sqlerrtext)
		return -1
	end if
	ls_filename = gs_temp_img_filename
	ls_filename = left(ls_filename, len(ls_filename) - 4)
	ls_filename = trim(string(ls_filename)) + "." + ls_imagetype
	f_writeimgtofile(ls_filename, lb_image)
	this.id_master.object.p_itemimage.filename = ls_filename
	return 0

// w_issue.wf_item_image_setting() returns long
	if f_stringpreferences("showitemimageinissue") = "N" then
		this.id_master.object.p_itemimage.visible = 0
	else
		this.it_imagetrans = create u_transaction
		this.it_imagetrans.autocommit = true
		SQL start USING this.it_imagetrans;
		if this.it_imagetrans.sqlcode <> 0 then
			return -1
		end if
		this.id_master.object.p_itemimage.visible = 1
	end if
	return 0

// w_issue.wf_validate_receipt(long al_code) returns long
	long ll_code
	long ll_deptcode
	long ll_areacode
	long ll_smancode
	long ll_recipientcode
	long ll_acccode
	long ll_recipientsalesman
	string ls_remarks
	string ls_referenceno
	string ls_posted
	datetime ldt_referencedate
	SQL SELECT ReceiptInvCode , DeptCode , Remarks , AreaCode , SManCode , ReferenceNo , ReferenceDate , RecipientCode , AccCode , RecipientSalesMan , Posted INTO :ll_code, :ll_deptcode, :ls_remarks, :ll_areacode, :ll_smancode, :ls_referenceno, :ldt_referencedate, :ll_recipientcode, :ll_acccode, :ll_recipientsalesman, :ls_posted FROM ReceiptHeader WHERE ReceiptInvCode =:al_code USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ls_posted = "N" then
			messagebox("Receipt Invoice Validation", "Receipt Invoice is not posted", stopsign!)
			return 1
		elseif isnull(ll_code) or ll_code < 0 then
			messagebox("Receipt Invoice Validation", "Please enter valid Receipt Invoice No.", stopsign!)
			return 1
		else
			this.id_master.object.recipientcode[1] = ll_recipientcode
			post event ue_set_requiredcolumns(ll_recipientcode, 1)
			this.id_master.object.deptcode[1] = ll_deptcode
			this.id_master.object.acccode[1] = ll_acccode
			this.id_master.object.remarks[1] = ls_remarks
			this.id_master.object.areacode[1] = ll_areacode
			this.id_master.object.smancode[1] = ll_smancode
			this.id_master.object.referenceno[1] = ls_referenceno
			this.id_master.object.referencedate[1] = ldt_referencedate
			this.id_master.object.recipientsalesman[1] = ll_recipientsalesman
			wf_setitemslist(al_code)
			return 0
		end if
		return
	end if
	messagebox("Receipt Invoice Validation", "Receipt Invoice Does not Exist.", stopsign!)
	return 1

// w_issue.wf_setitemslist(long al_receiptinvcode) returns long
	long ll_found
	if al_receiptinvcode > 0 then
		this.id_itemslist.dataobject = "ddd_receiptinvitems"
		this.id_itemslist.settransobject(sqlca)
		this.ids_receipt.retrieve(al_receiptinvcode)
		if this.ids_receipt.rowcount() = 0 then
			this.ids_receipt.insertrow(0)
			this.ids_receipt.setrow(1)
		end if
		this.ids_receipt.sharedata(this.id_itemslist)
	else
		this.id_itemslist.dataobject = gd_itemsinfo.dataobject
		this.id_itemslist.settransobject(sqlca)
		gd_itemsinfo.sharedata(this.id_itemslist)
		wf_itemslistcolvisibility()
	end if
	return 0

// w_issue.wf_itemslistcolvisibility() returns integer
	long ll_found
	this.id_itemslist.setredraw(false)
	if f_stringpreferences("itemcode") = "N" then
		this.id_itemslist.object.fullcode.visible = false
	end if
	if f_stringpreferences("localitemname") = "N" then
		this.id_itemslist.object.localitemname.visible = false
	end if
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("itempackingdesc") = "N" then
		this.id_itemslist.object.packingdesc.visible = false
	end if
	if f_stringpreferences("itemlocation") = "N" then
		this.id_itemslist.object.location.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_pstock.visible = false
	this.id_itemslist.object.pstock.visible = false
	this.id_itemslist.object.t_sstock.visible = true
	this.id_itemslist.object.sstock.visible = true
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.pstock.visible = false
	end if
	this.id_itemslist.setredraw(true)
	return 0

// w_issue.wf_inititeminfo(datawindowchild adc_itemdddw, long al_row, long al_dddwrow, string as_errtext) returns integer
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_receiptinvcode
	long ll_salerowid
	long ll_totalpieces
	long ll_piecesinhand
	long ll_receiptrowid
	double ld_saleprice
	double ld_discperc
	double ld_basicdatasaleprice
	double ld_avgprice
	string ls_fullcode
	string ls_batch
	string ls_itemname
	string ls_remarks
	string ls_alternatecustomicode
	datetime ld_expiry
	integer li_errcode
	double ld_retableqty
	double ld_stock
	double ld_totalstock
	double ld_itemprevqty
	double ld_itemreceiptqty
	double ld_itemprevqty_oncurrentinv
	double ld_alternatepurprice
	double ld_packcapacity
	double ld_areavolume
	ll_receiptinvcode = this.id_master.getitemnumber(this.id_master.getrow(), "ReceiptInvCode")
	if ll_receiptinvcode > 0 then
		ll_icode = this.id_itemslist.getitemnumber(al_dddwrow, "icode")
		SQL SELECT saleprice , packunits , totalpieces , remarks , alternatepurprice , item.packcapacity , item.areavolume INTO :ld_basicdatasaleprice, :ll_packunits, :ll_piecesinhand, :ls_remarks, :ld_alternatepurprice, :ld_packcapacity, :ld_areavolume FROM Item WHERE icode =:ll_icode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			ll_gcode = this.id_itemslist.getitemnumber(al_dddwrow, "gcode")
			ll_icode = this.id_itemslist.getitemnumber(al_dddwrow, "icode")
			ls_fullcode = this.id_itemslist.getitemstring(al_dddwrow, "fullcode")
			ls_alternatecustomicode = this.id_itemslist.getitemstring(al_dddwrow, "alternatecustomicode")
			ls_batch = this.id_itemslist.getitemstring(al_dddwrow, "batch")
			ld_expiry = this.id_itemslist.getitemdatetime(al_dddwrow, "Expiry")
			ld_saleprice = this.id_itemslist.getitemnumber(al_dddwrow, "saleprice")
			ld_discperc = this.id_itemslist.getitemnumber(al_dddwrow, "discperc")
			ll_receiptrowid = this.id_itemslist.getitemnumber(al_dddwrow, "Receiptrowid")
			ll_totalpieces = this.id_itemslist.getitemnumber(al_dddwrow, "totalpieces")
			ls_itemname = this.id_itemslist.getitemstring(al_dddwrow, "itemname")
			ld_avgprice = this.id_itemslist.getitemnumber(al_dddwrow, "avgprice")
			ld_retableqty = this.id_itemslist.getitemnumber(al_dddwrow, "receiptqty") - this.id_itemslist.getitemnumber(al_dddwrow, "issuedqty")
			if ld_retableqty < 0.0 then
				ld_retableqty = 0
			end if
			if wf_itemprevissueqty(ll_receiptinvcode, ll_receiptrowid, ll_icode, ld_itemprevqty) = 0 then
				wf_oninvoiceitemprevqty(al_row, ll_icode, ll_receiptrowid, ld_itemprevqty_oncurrentinv, ls_batch, ld_expiry)
				ld_itemreceiptqty = this.id_itemslist.getitemnumber(al_dddwrow, "Receiptqty")
				ld_retableqty = ld_itemreceiptqty - ld_itemprevqty - ld_itemprevqty_oncurrentinv
				this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_totalstock)
				if ld_retableqty > 0.0 then
					if this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock) = 0 then
						if ld_stock > 0.0 then
							this.id_detail.setitem(al_row, "gcode", ll_gcode)
							this.id_detail.setitem(al_row, "icode", ll_icode)
							this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
							this.id_detail.setitem(al_row, "alternatecustomicode", ls_alternatecustomicode)
							this.id_detail.setitem(al_row, "batch", ls_batch)
							this.id_detail.setitem(al_row, "expiry", ld_expiry)
							this.id_detail.setitem(al_row, "price", ld_saleprice)
							if ld_retableqty <= ld_stock then
								if isnull(this.id_detail.object.itemcode[al_row]) then
									this.id_detail.setitem(al_row, "qty", ld_retableqty)
								end if
								this.id_detail.setitem(al_row, "issueableqty", ld_retableqty)
							else
								if isnull(this.id_detail.object.itemcode[al_row]) then
									this.id_detail.setitem(al_row, "qty", ld_stock)
								end if
								this.id_detail.setitem(al_row, "issueableqty", ld_stock)
							end if
							this.id_detail.setitem(al_row, "stock", ld_stock)
							this.id_detail.setitem(al_row, "totalstock", ld_totalstock)
							this.id_detail.setitem(al_row, "packunits", ll_packunits)
							this.id_detail.setitem(al_row, "piecesinhand", ll_piecesinhand)
							this.id_detail.setitem(al_row, "totalpieces", ll_totalpieces)
							this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
							this.id_detail.setitem(al_row, "itemname", ls_itemname)
							this.id_detail.setitem(al_row, "receiptrowid", ll_receiptrowid)
							this.id_detail.setitem(al_row, "price", ld_basicdatasaleprice / ll_packunits)
							this.id_detail.setitem(al_row, "itemdescription", this.id_itemslist.object.itemdesc[al_dddwrow])
							if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
								ld_areavolume = 1
							end if
							if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
								ld_packcapacity = 1
							end if
							this.id_detail.setitem(al_row, "packcapacity", ld_packcapacity)
							this.id_detail.setitem(al_row, "areavolume", ld_areavolume)
							this.id_detail.setitem(al_row, "pcs", round(this.id_detail.object.qty[al_row] / ld_areavolume, 6))
							this.id_detail.setitem(al_row, "cartons", trim(string(this.id_detail.object.pcs[al_row] / ld_packcapacity)) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[al_row] mod ld_packcapacity, 2))))))
							this.id_detail.setitem(al_row, "itemdescription", ls_remarks)
							this.id_detail.setitem(al_row, "itemcode", ll_icode)
							this.id_footer.setitem(1, "stock", ld_stock)
							this.id_footer.setitem(1, "totalstock", ld_totalstock)
						else
							as_errtext = "Stock for this particular batch and expiry is not enough to issue."
							li_errcode = -1
						end if
					else
						as_errtext = "Can not retrieve item stock information"
						li_errcode = -1
					end if
				else
					as_errtext = "item qty has already been returned"
					li_errcode = 1
				end if
			else
				li_errcode = -1
				as_errtext = "Receipt invoice information can not retrieve"
			end if
		else
			li_errcode = -1
			as_errtext = "Unable To Get Item's Information"
		end if
	else
		li_errcode = -1
		as_errtext = "Please Select Valid Receipt Invoice First, Unable To Get Item's Information"
	end if
	return li_errcode

// w_issue.wf_itemprevissueqty(long al_receiptinvcode, long al_receiptrowid, long al_icode, double al_itemprevqty) returns long
	SQL SELECT IsNull ( Sum ( qty ) , 0 ) INTO :al_itemprevqty FROM IssueHeader , IssueDetail WHERE IssueHeader.ReceiptInvCode =:al_receiptinvcode And IssueHeader.posted ='Y' And IssueHeader.IssueInvcode =IssueDetail.IssueInvCode And IssueDetail.ICode =:al_icode And IssueDetail.ReceiptRowId =:al_receiptrowid USING this.it_transobject;
	if isnull(al_itemprevqty) then
		al_itemprevqty = 0
	end if
	return this.it_transobject.sqlcode

// w_issue.wf_oninvoiceitemprevqty(long al_row, long al_icode, long al_receiptrowid, double al_itemprevqty, string as_batch, datetime adt_expiry) returns integer
	long ll_counter
	long ll_rowcount
	long ll_icode
	long ll_receiptrowid
	double ld_holdqty
	double ld_holdbonusqty
	string ls_batch
	datetime ldt_expiry
	ll_rowcount = this.id_detail.rowcount()
	for ll_counter = 1 to al_row - 1
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		ll_receiptrowid = this.id_detail.getitemnumber(ll_counter, "receiptrowid")
		ls_batch = this.id_detail.getitemstring(ll_counter, "batch")
		ldt_expiry = this.id_detail.getitemdatetime(ll_counter, "expiry")
		if ll_icode = al_icode and ll_receiptrowid = al_receiptrowid and ls_batch = as_batch and ldt_expiry = adt_expiry then
			ld_holdqty = ld_holdqty + this.id_detail.getitemnumber(ll_counter, "qty")
		end if
	next
	for ll_counter = al_row + 1 to ll_rowcount
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		ll_receiptrowid = this.id_detail.getitemnumber(ll_counter, "receiptrowid")
		ls_batch = this.id_detail.getitemstring(ll_counter, "batch")
		ldt_expiry = this.id_detail.getitemdatetime(ll_counter, "expiry")
		if ll_icode = al_icode and ll_receiptrowid = al_receiptrowid and ls_batch = as_batch and ldt_expiry = adt_expiry then
			ld_holdqty = ld_holdqty + this.id_detail.getitemnumber(ll_counter, "qty")
		end if
	next
	al_itemprevqty = ld_holdqty
	return 0

// w_issue.wf_populatereceipt() returns long
	long ll_rowcount
	long ll_counter
	long ll_receiptinvcode
	long ll_rowscopy
	long ll_returneditems
	long ll_erroritems
	string ls_errtext
	integer li_errcode
	if this.editflag = false or this.tab_retrieve.selectedtab <> 1 then
		return -1
	end if
	if this.id_master.accepttext() <> 1 then
		return -1
	end if
	this.id_detail.setredraw(false)
	this.id_detail.reset()
	ll_receiptinvcode = this.id_master.getitemnumber(this.id_master.getrow(), "ReceiptInvCode")
	this.ib_itemvalidated = true
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_itemslist.rowcount()
	ll_rowscopy = 1
	for ll_counter = 1 to ll_rowcount
		li_errcode = wf_inititeminfo(this.idc_itemdddw, ll_receiptinvcode, ll_counter, ll_rowscopy, ls_errtext)
		if li_errcode = 1 then
			ll_returneditems = ll_returneditems + 1
		elseif li_errcode = -1 then
			ll_erroritems = ll_erroritems + 1
		else
			ll_rowscopy = ll_rowscopy + 1
			this.id_detail.insertrow(0)
		end if
	next
	this.id_detail.deleterow(ll_rowscopy)
	messagebox("Populate Receipt Invoice Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowscopy - 1) + " records were retrieved successfully~n~r" + string(ll_returneditems) + " records has already been returned~n~r" + string(ll_erroritems) + " record's database info. cannot be retrieved")
	if ll_rowscopy - 1 > 0 then
		this.im_menu.m_file.m_save.enabled = true
		this.id_detail.scrolltorow(0)
		this.id_detail.setcolumn(1)
		this.id_detail.setfocus()
		wf_grandtotal()
	end if
	this.id_detail.setredraw(true)
	return ll_rowscopy

// w_issue.wf_inititeminfo(datawindowchild adc_itemdddw, long al_receiptinvcode, long al_dsrow, long al_detaildwrow, string as_errtext) returns long
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_receiptrowid
	long ll_totalpieces
	long ll_piecesinhand
	double ld_saleprice
	double ld_basicdatasaleprice
	double ld_packcapacity
	double ld_areavolume
	string ls_fullcode
	string ls_batch
	string ls_itemname
	string ls_remarks
	string ls_alternatecustomicode
	string ls_null
	datetime ld_expiry
	integer li_errcode
	long ll_currentrowinlist
	double ld_retableqty
	double ld_itemprevqty
	double ld_itemreceiptqty
	double ld_stock
	double ld_alternatepurprice
	double ld_avgprice
	double ld_totalstock
	setnull(ls_null)
	ll_currentrowinlist = al_detaildwrow
	ll_icode = this.id_itemslist.getitemnumber(ll_currentrowinlist, "icode")
	SQL SELECT saleprice , packunits , totalpieces , remarks , alternatepurprice , item.packcapacity , item.areavolume INTO :ld_basicdatasaleprice, :ll_packunits, :ll_piecesinhand, :ls_remarks, :ld_alternatepurprice, :ld_packcapacity, :ld_areavolume FROM Item WHERE icode =:ll_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_gcode = this.id_itemslist.getitemnumber(ll_currentrowinlist, "gcode")
		ll_icode = this.id_itemslist.getitemnumber(ll_currentrowinlist, "icode")
		ls_fullcode = this.id_itemslist.getitemstring(ll_currentrowinlist, "fullcode")
		ls_alternatecustomicode = this.id_itemslist.getitemstring(ll_currentrowinlist, "alternatecustomicode")
		ls_batch = this.id_itemslist.getitemstring(ll_currentrowinlist, "batch")
		ld_expiry = this.id_itemslist.getitemdatetime(ll_currentrowinlist, "Expiry")
		ld_saleprice = this.id_itemslist.getitemnumber(ll_currentrowinlist, "saleprice")
		ld_itemreceiptqty = this.id_itemslist.getitemnumber(ll_currentrowinlist, "receiptqty")
		ll_receiptrowid = this.id_itemslist.getitemnumber(ll_currentrowinlist, "receiptrowid")
		ll_totalpieces = this.id_itemslist.getitemnumber(ll_currentrowinlist, "totalpieces")
		ld_avgprice = this.id_itemslist.getitemnumber(ll_currentrowinlist, "avgprice")
		ll_piecesinhand = ll_totalpieces
		ls_itemname = this.id_itemslist.getitemstring(ll_currentrowinlist, "itemname")
		this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_totalstock)
		if wf_itemprevissueqty(al_receiptinvcode, ll_receiptrowid, ll_icode, ld_itemprevqty) = 0 then
			ld_retableqty = ld_itemreceiptqty - ld_itemprevqty
			if ld_retableqty > 0.0 then
				if this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock) = 0 then
					this.id_detail.setitem(al_detaildwrow, "gcode", ll_gcode)
					this.id_detail.setitem(al_detaildwrow, "receiptrowid", ll_receiptrowid)
					this.id_detail.setitem(al_detaildwrow, "icode", ll_icode)
					this.id_detail.setitem(al_detaildwrow, "fullcode", ls_fullcode)
					this.id_detail.setitem(al_detaildwrow, "alternatecustomicode", ls_alternatecustomicode)
					this.id_detail.setitem(al_detaildwrow, "batch", ls_batch)
					this.id_detail.setitem(al_detaildwrow, "expiry", ld_expiry)
					this.id_detail.setitem(al_detaildwrow, "price", ld_saleprice)
					this.id_detail.setitem(al_detaildwrow, "qty", ld_retableqty)
					this.id_detail.setitem(al_detaildwrow, "issueableqty", ld_retableqty)
					this.id_detail.setitem(al_detaildwrow, "stock", ld_stock)
					this.id_detail.setitem(al_detaildwrow, "totalstock", ld_totalstock)
					this.id_detail.setitem(al_detaildwrow, "packunits", ll_packunits)
					this.id_detail.setitem(al_detaildwrow, "totalpieces", ll_totalpieces)
					this.id_detail.setitem(al_detaildwrow, "piecesinhand", ll_piecesinhand)
					this.id_detail.setitem(al_detaildwrow, "avgprice", ld_avgprice)
					if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
						ld_areavolume = 1
					end if
					if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
						ld_packcapacity = 1
					end if
					this.id_detail.setitem(al_detaildwrow, "packcapacity", ld_packcapacity)
					this.id_detail.setitem(al_detaildwrow, "areavolume", ld_areavolume)
					this.id_detail.setitem(al_detaildwrow, "pcs", round(this.id_detail.object.qty[al_detaildwrow] / ld_areavolume, 6))
					this.id_detail.setitem(al_detaildwrow, "cartons", trim(string(long(this.id_detail.object.pcs[al_detaildwrow] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[al_detaildwrow] mod ld_packcapacity, 2))))))
					this.id_detail.setitem(al_detaildwrow, "itemdescription", ls_remarks)
					this.id_detail.setitem(al_detaildwrow, "itemname", ls_itemname)
					this.id_detail.setitem(al_detaildwrow, "price", ld_basicdatasaleprice / ll_packunits)
					this.id_detail.setitem(al_detaildwrow, "itemcode", ll_icode)
					this.id_footer.setitem(1, "stock", ld_stock)
					this.id_footer.setitem(1, "totalstock", ld_totalstock)
				else
					as_errtext = "Can not retrieve item stock information"
					li_errcode = 1
				end if
			else
				as_errtext = "Item Qty has already been issued"
				li_errcode = 1
			end if
		else
			li_errcode = -1
			as_errtext = "Receipt invoice information can not retrieve"
		end if
	else
		li_errcode = -1
		as_errtext = "Unable To Retrieve Price from Item Basic Data"
	end if
	return li_errcode

// w_issue.wf_validate_qty(long al_row, double ad_qty) returns long
	integer li_rtcode
	double ld_issueableqty
	double ld_itemprevqty
	double ld_areavolume
	double ld_packcapacity
	long ll_icode
	long ll_receiptrowid
	datetime ld_expiry
	string ls_batch
	if this.id_master.getitemnumber(1, "receiptinvcode") > 0.0 then
		ld_issueableqty = this.id_detail.getitemnumber(al_row, "issueableqty")
		ll_icode = this.id_detail.getitemnumber(al_row, "icode")
		ll_receiptrowid = this.id_detail.getitemnumber(al_row, "receiptrowid")
		ld_expiry = this.id_detail.getitemdatetime(al_row, "expiry")
		ls_batch = this.id_detail.getitemstring(al_row, "batch")
		wf_oninvoiceitemprevqty(al_row, ll_icode, ll_receiptrowid, ld_itemprevqty, ls_batch, ld_expiry)
		if ad_qty + ld_itemprevqty > ld_issueableqty then
			li_rtcode = 1
			messagebox("Quantity Validation", "    Qty Should be less than " + string(ld_issueableqty))
		end if
	end if
	if li_rtcode = 0 then
		ld_areavolume = this.id_detail.object.areavolume[al_row]
		if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
			ld_areavolume = 1
		end if
		ld_packcapacity = this.id_detail.object.packcapacity[al_row]
		if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
			ld_packcapacity = 1
		end if
		this.id_detail.setitem(al_row, "pcs", round(ad_qty / ld_areavolume, 6))
		this.id_detail.setitem(al_row, "cartons", trim(string(long(this.id_detail.object.pcs[al_row] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[al_row] mod ld_packcapacity, 2))))))
	end if
	return li_rtcode

// w_issue.wf_findfullcode(string as_fullcode, long al_icode, string as_itemname, long al_itemcodetype, double ad_qty, double ad_purprice, double ad_saleprice) returns long
	long ll_rowid
	long ll_retflag
	if this.id_master.object.receiptinvcode[1] > 0 then
		ll_rowid = this.id_itemslist.find("fullcode = '" + as_fullcode + "'", 1, this.id_itemslist.rowcount())
		if ll_rowid > 0 and ll_rowid <= this.id_itemslist.rowcount() then
			al_icode = this.id_itemslist.getitemnumber(ll_rowid, "icode")
			as_itemname = this.id_itemslist.getitemstring(ll_rowid, "itemname")
			this.id_itemslist.setrow(ll_rowid)
			ll_retflag = 1
		else
			ll_retflag = 0
		end if
	else
		setnull(al_icode)
		as_itemname = "                                                            "
		this.it_transobject.getaliasname_withqtyprice(gl_usercode, as_fullcode, al_icode, as_itemname, al_itemcodetype, ad_qty, ad_purprice, ad_saleprice)
		if this.it_transobject.sqlcode = 0 then
			if isnull(al_icode) then
				ll_retflag = 0
			else
				ll_retflag = 1
			end if
		else
			ll_retflag = -1
		end if
	end if
	return ll_retflag

// w_issue.wf_generate_issuecategory_counter(integer ai_issuecategorycode, long al_issuecode, transaction at_transobject) returns long
	long ll_rtcode
	SQL SELECT dbo.IssueCategory.COUNTER INTO :al_issuecode FROM dbo.IssueCategory WITH ( UPDLOCK HOLDLOCK ) WHERE dbo.IssueCategory.IssueCategoryCode =:ai_issuecategorycode USING at_transobject;
	if at_transobject.sqlcode = 0 then
		al_issuecode = al_issuecode + 1
		SQL update dbo.IssueCategory SET dbo.IssueCategory.COUNTER =:al_issuecode WHERE dbo.IssueCategory.IssueCategoryCode =:ai_issuecategorycode USING at_transobject;
		if at_transobject.sqlcode < 0 then
			ll_rtcode = at_transobject.sqlcode
			al_issuecode = 0
		end if
	else
		ll_rtcode = at_transobject.sqlcode
		al_issuecode = 0
	end if
	return ll_rtcode

// w_issue.wf_locksaleinvoices(long al_sinvcode, long al_linvcode, long al_totalinvoice, integer ai_issuecategorycode) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From IssueHeader WITH ( UPDLOCK HOLDLOCK ) Where IssueHeader.Issueinvcode Between :al_sinvcode AND :al_linvcode AND IssueHeader.Posted ='N' AND IssueHeader.IssueCategoryCode =:ai_issuecategorycode USING sqlca;
	return sqlca.sqlcode

// w_issue.wf_quotationinuse(long al_quotationcode, long al_issueinvcode) returns long
	long ll_issueinvcode
	ll_issueinvcode = this.id_master.object.code[this.id_master.getrow()]
	SQL Select issueinvcode INTO :al_issueinvcode From IssueHeader Where QuotationCode =:al_quotationcode And IssueInvCode Not In ( :ll_issueinvcode ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 100 then
		return 0
	end if
	return -1

// w_issue.wf_motorvehicle_retrieve() returns long
	long ll_row
	long ll_code
	this.idc_motorvehicle.settransobject(this.it_transobject)
	this.idc_motorvehicle.retrieve()
	ll_row = this.idc_motorvehicle.insertrow(0)
	setnull(ll_code)
	this.idc_motorvehicle.setitem(ll_row, "code", ll_code)
	this.idc_motorvehicle.setitem(ll_row, "chasisno", "<NONE>")
	this.idc_motorvehicle.setitem(ll_row, "motorvehicle", "<NONE>")
	this.idc_motorvehicle.setitem(ll_row, "customer", "<NONE>")
	this.idc_motorvehicle.scrolltorow(ll_row)
	return 0

// w_issue.wf_find_motorvehiclecode(string as_chasisno, long al_code) returns long
	long ll_motorvehiclecode
	long ll_retflag
	ll_retflag = 0
	SQL SELECT motorvehiclecode INTO :ll_motorvehiclecode FROM motorvehicle WHERE chasisno =:as_chasisno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_code = ll_motorvehiclecode
		if isnull(al_code) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_issue.wf_motorvehiclesearch() returns string
	string ls_chasisno
	long ll_res
	long ll_null
	long ll_code
	s_arguements ls_arguements
	setnull(ll_null)
	open(w_vehiclesearch)
	ls_arguements = message.powerobjectparm
	if ls_arguements.i_status = 1 then
		openwithparm(w_vehiclesearchresult, ls_arguements)
		ls_arguements = message.powerobjectparm
		if ls_arguements.i_status = 1 and ls_arguements.l_code1 > 0 then
			this.id_master.object.chasisno[1] = ls_arguements.s_name1
			this.id_master.object.motorvehiclecode[1] = ls_arguements.l_code1
			this.id_master.object.acccode[1] = ls_arguements.l_code2
			this.id_master.object.recipientcode[1] = 2
			event ue_set_requiredcolumns(2, 1)
			ll_code = ls_arguements.l_code1
			wf_set_motorvehicleinfo(ll_code)
			ls_chasisno = this.id_master.object.chasisno[1]
		end if
	end if
	return ls_chasisno

// w_issue.wf_set_motorvehicleinfo(long al_code) returns long
	long ll_custcode
	long ll_retcode
	string ls_chasisno
	string ls_aliasname
	SQL SELECT MotorVehicle.ChasisNo , MotorVehicle.CustCode , Accounts.AliasName INTO :ls_chasisno, :ll_custcode, :ls_aliasname FROM MotorVehicle , Accounts WHERE MotorVehicle.MotorVehicleCode =:al_code AND MotorVehicle.CustCode =Accounts.AccCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.setitem(this.id_master.rowcount(), "chasisno", ls_chasisno)
		this.id_master.setitem(this.id_master.rowcount(), "acccode", ll_custcode)
		ll_retcode = 1
	else
		messagebox("Motor Vehicle Information", "Problem in retrieving corresponding customer")
		ll_retcode = 0
	end if
	return ll_retcode

// w_issue.wf_new_motorvehicle() returns long
	string ls_chasisno
	long ll_motorvehiclecode
	long ll_found
	long ll_row
	dwobject dwo
	open(w_motorvehicle)
	ls_chasisno = message.stringparm
	if len(ls_chasisno) > 0 then
		wf_motorvehicle_retrieve()
		ll_found = 0
		ll_found = this.idc_motorvehicle.find("chasisno = '" + ls_chasisno + "'", 1, this.idc_motorvehicle.rowcount())
		if ll_found > 0 then
			this.id_master.setitem(1, "chasisno", this.idc_motorvehicle.getitemstring(ll_found, "chasisno"))
			ll_motorvehiclecode = this.idc_motorvehicle.getitemnumber(ll_found, "code")
			this.id_master.setitem(1, "motorvehiclecode", ll_motorvehiclecode)
			dwo = this.id_master.object.motorvehiclecode
			this.id_master.post event itemchanged(1, dwo, string(ll_motorvehiclecode))
		end if
	end if
	return 0

// w_issue.wf_supplierinfo(long al_suppcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	long ll_sitecode
	double ld_currbalance
	SQL SELECT supplier.sitecode INTO :ll_sitecode FROM supplier WHERE supplier.suppcode =:al_suppcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
		this.id_master.object.targetsitecode[1] = ll_sitecode
	end if
	return this.it_transobject.sqlcode

// w_issue.wf_push_issue_to_dropbox() returns long
	integer li_errcode
	long ll_salesmancode
	long ll_invcount
	long ll_counter
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			li_errcode = this.it_transobject.pushissuetodropbox(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode, gs_dropbox_server, gs_dropbox_db, "DBO", ll_invcount)
			if li_errcode <> 0 then
				li_errcode = this.it_transobject.sqlcode
				ls_msgtext = this.it_transobject.sqlerrtext
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				ls_msgtext = this.it_transobject.sqlerrtext
				li_errcode = this.it_transobject.sqlcode
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Push Issue To Drop Box Fails", "Some database request fails, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode), stopsign!)
		else
			messagebox("Push to Drop Box Successfull", "Total Invoices to push were " + string(ll_invcount) + "~n~rAll Invoices have been pushed successfully to drop box.", information!)
		end if
	end if
	return li_errcode

// w_issue.create() returns 0
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_issuemenu" then
		this.menuid = create m_issuemenu
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	this.dw_saleinvdetail = create dw_saleinvdetail
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.dw_saleinvdetail

// w_issue.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.dw_saleinvdetail

// w_issue.ue_save() returns 0
	long ll_null
	long ll_issuecode
	long ll_issueretcode
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_stock
	long ll_newstock
	long ll_icode
	long ll_salelooseqty
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode
	long ll_gcode
	long ll_headerno
	long ll_headerinvno
	long ll_counter
	long ll_count
	long ll_issuetype
	boolean lb_commitflag
	boolean lb_continue
	integer li_counter
	string ls_errtext
	string ls_ref
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	datetime ldt_server_datetime
	string ls_date_errtext
	datawindowchild ldc_headerno
	setnull(ll_null)
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	if this.id_master.object.accountfor[1] = "N" then
		this.id_master.object.dracccode[1] = ll_null
	end if
	if this.id_master.object.accountfor[1] = "Y" and isnull(this.id_master.object.dracccode[1]) then
		this.id_master.setcolumn("dracccode")
		this.id_master.setfocus()
		return
	end if
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	ls_ref = this.id_master.getitemstring(this.id_master.getrow(), "referenceno")
	ll_issuetype = this.id_master.getitemnumber(this.id_master.getrow(), "issuetypecode")
	if not isnull(ls_ref) and not isnull(ll_issuetype) and wf_dup_refno(ll_issuetype, ls_ref) then
		messagebox("Reference No. Validation", "Duplicate Reference Number for this issue type.~r~nPlease Enter valid Reference Number.")
		this.id_master.setfocus()
		this.id_master.setcolumn("referenceno")
		return
	end if
	setpointer(hourglass!)
	if not this.ib_modifydate and not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if this.ib_apply_associated_quotaion_onsaving and wf_apply_associatedquotation(1) <= 0 then
		messagebox("Customer Associated Quotation", "Problem in using associated quotation")
		return
	end if
	if f_stringpreferences("ForcePCSInInterAtSalesSaving") = "Y" then
		for ll_counter = 1 to this.id_detail.rowcount()
			if this.id_detail.object.pcs[ll_counter] <> long(this.id_detail.object.pcs[ll_counter]) then
				messagebox("PCS Validation", "Please enter some valid PCS. It Should be some valid integer value", stopsign!)
				this.id_detail.setrow(ll_counter)
				this.id_detail.setfocus()
				this.id_detail.setcolumn("PCS")
				return
			end if
		next
	end if
	ll_counter = 0
	if f_stringpreferences("Salesalesmanwindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if isnull(ll_invid) then
			f_newtableid("IssueHeader", ll_invid)
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
		end if
		ll_issuecode = this.id_master.getitemnumber(ll_mastercurrrow, "issuecode")
		if isnull(ll_issuecode) or ll_issuecode = 0 then
			ll_issueretcode = wf_generate_issuecategory_counter(this.ii_category, ll_issuecode, this.it_transobject)
			if ll_issueretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~ngenerating Issue Code")
				return
			end if
			if ll_issuecode > 0 then
				this.id_master.setitem(ll_mastercurrrow, "issuecode", ll_issuecode)
			end if
		end if
		this.id_master.getchild("headerno", ldc_headerno)
		if f_stringpreferences("Headeronissueinv") = "N" then
			this.id_master.setitem(ll_mastercurrrow, "Headerno", ldc_headerno.getitemnumber(ll_mastercurrrow, "code"))
		end if
		ll_headerno = this.id_master.getitemnumber(ll_mastercurrrow, "headerno")
		ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
		if isnull(ll_headerinvno) then
			f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
			if ll_headerinvno > 0 then
				this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
			end if
		end if
		if f_stringpreferences("IssuePosting") = "N" then
			this.id_master.setitem(ll_mastercurrrow, "Posted", "N")
		end if
		if this.ib_modify then
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			lb_continue = wf_returnsaleinvoice(ll_invid, ls_errtext)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		else
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
		end if
		if lb_continue then
			this.id_saleinvdetail.reset()
			if not wf_populatesaledetail(ll_invid, this.id_saleinvdetail, ls_errtext, ll_errrowid) then
				lb_continue = false
				this.id_detail.scrolltorow(ll_errrowid)
				this.id_detail.setfocus()
			else
				this.id_detail = this.id_saleinvdetail
				call super::ue_save
				this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
				this.id_saleinvdetail.reset()
				if this.ib_commitok then
					this.ib_modify = false
				end if
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			messagebox("Updation Error", ls_errtext + " ", stopsign!)
		elseif f_stringpreferences("IncIssInActMonitor") = "Y" then
			this.it_transobject.updateactivitymonitor("IV", ll_invid)
			if this.it_transobject.sqlcode <> 0 then
				lb_continue = false
				SQL rollback USING this.it_transobject;
				messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
			else
				SQL commit USING this.it_transobject;
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_issue.ue_newform() returns 0
	integer rtncode
	long li_fetched_code
	long row
	long ll_manfcode
	long li_rtncode
	setredraw(false)
	this.idc_section.reset()
	this.idc_section.insertrow(0)
	call super::ue_newform
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.im_menu.m_file.m_print.enabled = true
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.ib_modify = false
	wf_setgodownoption()
	this.id_footer.setitem(1, "invdiscperc", f_numberpreferences("invdiscperc"))
	if not wf_validatedate() then
		close(this)
	else
		this.id_master.setcolumn(1)
		this.id_master.setfocus()
		if f_stringpreferences("ShowQtyInIssue") = "N" then
			this.id_detail.object.qty.visible = false
			this.id_footer.object.t_stock.visible = false
			this.id_footer.object.stock.visible = false
			this.id_footer.object.t_totalstock.visible = false
			this.id_footer.object.totalstock.visible = false
		else
			wf_visible(true)
		end if
		setredraw(true)
	end if
	li_rtncode = this.id_master.getchild("motorvehiclecode", this.idc_motorvehicle)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_motorvehicle.settransobject(this.it_transobject)
	wf_motorvehicle_retrieve()
	post event ue_set_requiredcolumns(integer(this.id_master.object.recipientcode.initial), 0)
	this.id_master.setitem(1, "Terms1", f_stringpreferences("IssueTerms1"))
	this.id_master.setitem(1, "Terms2", f_stringpreferences("IssueTerms2"))
	this.ids_receipt.reset()
	wf_setitemslist(0)

// w_issue.ue_detail() returns 0
	integer li_rtncode
	integer li_protect
	long ll_row
	long ll_code
	long ll_deptcode
	long ll_rowcount
	long ll_receiptinvcode
	boolean lb_flag
	boolean lb_modify
	m_issuemenu lm_menu
	lm_menu = this.menuid
	setredraw(false)
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	this.id_master.retrieve(ll_code)
	ll_deptcode = this.id_master.object.deptcode[this.id_master.getrow()]
	this.idc_section.retrieve(ll_deptcode)
	if this.idc_section.rowcount() = 0 then
		this.idc_section.insertrow(0)
	end if
	call super::ue_detail
	this.im_menu.m_file.m_post.enabled = false
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	if wf_allowissuemodification(ll_code, this.il_groupcode, this.il_strategy) <> 0 then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "You Can not modify this Invoice,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" and this.ib_issuemodify then
		lb_modify = true
	end if
	if not lb_modify then
		this.im_menu.m_file.m_save.enabled = false
		this.editflag = false
	else
		li_protect = 0
		wf_initmodify(li_protect)
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_salegodown
	end if
	event ue_set_requiredcolumns(this.id_master.object.recipientcode[1], 1)
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	ll_receiptinvcode = this.id_master.getitemnumber(1, "receiptinvcode")
	if ll_receiptinvcode > 0 then
		wf_setitemslist(ll_receiptinvcode)
	else
		wf_setitemslist(0)
	end if
	wf_grandtotal()
	setredraw(true)

// w_issue.ue_newitem() returns 0
	long ll_deptcode
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	if this.id_detail.rowcount() <= 0 then
		ll_deptcode = this.id_master.getitemnumber(this.id_master.getrow(), "deptcode")
		if isnull(ll_deptcode) then
			if this.idc_section.rowcount() = 0 then
				this.idc_section.insertrow(0)
			end if
		else
			this.idc_section.retrieve(ll_deptcode)
			if this.idc_section.rowcount() = 0 then
				this.idc_section.insertrow(0)
			end if
		end if
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true
	this.ii_defaultgcode = this.ii_salegodown

// w_issue.ue_deleteitem() returns 0
	long ll_row
	long ll_footerrow
	call super::ue_deleteitem
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() > 0 then
		this.id_footer.setitem(ll_footerrow, "icode", this.id_detail.getitemnumber(ll_row, "icode"))
		this.id_footer.setitem(ll_footerrow, "stock", this.id_detail.getitemnumber(ll_row, "stock"))
		return
	end if
	this.id_footer.setitem(ll_footerrow, "icode", 0)
	this.id_footer.setitem(ll_footerrow, "stock", 0)
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_save.enabled = false

// w_issue.close() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	destroy this.ids_receipt
	this.id_itemslist.sharedataoff()
	return ::message.returnvalue

// w_issue.ue_list() returns 0
	call super::ue_list
	SQL rollback USING this.it_transobject;
	if this.ib_issueposting then
		this.im_menu.m_file.m_post.enabled = true
	else
		this.im_menu.m_file.m_post.enabled = false
	end if
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		triggerevent("ue_deleteitem")
	end if
	wf_retrievelist()
	this.im_menu.m_file.m_print.visible = true
	this.im_menu.m_file.m_print.enabled = true

// w_issue.ue_print() returns 0
	long ll_custcode
	long ll_row
	long ll_invcode
	string ls_custname
	integer li_option
	integer li_printretcode
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	wf_selectprintreport()
	this.id_print.retrieve(ll_invcode)
	if this.id_print.rowcount() <= 0 then
		messagebox("Printing", "no rows retrieve")
		return
	end if
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		lstr.d_value = ll_invcode
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.id_print.rowcount() > 0 then
		li_printretcode = this.id_print.print()
		wf_print_storesummary(ll_invcode)
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
	end if

// w_issue.ue_refreshddw() returns 0
	call super::ue_refreshddw
	if this.ii_saletype <> 3 then
		setpointer(hourglass!)
		this.idc_customers.setredraw(false)
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.retrieve()
		this.idc_customers.setredraw(true)
		setpointer(arrow!)
	end if

// w_issue.ue_new() returns 0
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_issue.ue_postopen() returns 0
	datawindowchild ldc_headerno
	m_issuemenu lm_menu
	integer li_rtncode
	long ll_counter
	long ll_pos
	long ll_found
	datastore lds_headers
	call super::ue_postopen
	f_fetch_sites()
	this.is_receiptcompulsion = f_stringpreferences("EnforceReceiptCompulsion_InIssue")
	if isnull(this.is_receiptcompulsion) then
		this.is_receiptcompulsion = "N"
	end if
	this.istr_arg = message.powerobjectparm
	this.il_openparm = this.istr_arg.l_code2
	if this.il_openparm = 2 then
		this.title = "Passport Issue To Customer"
		this.im_menu.m_window.m_refreshcatwise.visible = false
		this.im_menu.m_window.m_refreshcustomize.visible = false
		this.im_menu.m_window.m_refreshdrilldownfilter.visible = false
		this.im_menu.m_window.m_refreshfilterstockitemsonly.visible = false
		this.im_menu.m_window.m_refreshitemnamefilter.visible = false
	else
		this.title = "Issue / Delivery Challan - " + this.istr_arg.s_name1
	end if
	this.ii_category = this.istr_arg.l_code1
	this.ic_accountfor = this.istr_arg.s_name2
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	this.ids_invoiceinfo = create datastore
	this.ids_invoiceinfo.dataobject = "d_issueinvinfo"
	this.ids_invoiceinfo.settransobject(this.it_transobject)
	this.ids_receipt = create datastore
	this.ids_receipt.dataobject = "ddd_receiptinvitems"
	this.ids_receipt.settransobject(sqlca)
	lm_menu = this.menuid
	setredraw(false)
	this.id_print = this.dw_saleinvrep
	this.id_saleinvdetail = this.dw_saleinvdetail
	this.id_saleinvdetail.settransobject(this.it_transobject)
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit Issue of Stock")
		close(this)
		return
	end if
	li_rtncode = this.id_detail.getchild("gcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to Issue")
		close(this)
		return
	end if
	li_rtncode = this.id_master.getchild("recipientcode", this.idc_recipienttype)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_recipienttype.settransobject(this.it_transobject)
	li_rtncode = this.idc_recipienttype.retrieve(this.ii_module, this.il_groupcode)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Recipient Rights to Issue")
		close(this)
		return
	end if
	this.id_master.object.recipientcode.initial = trim(string(this.idc_recipienttype.getitemnumber(1, "RecipientCode")))
	if this.idc_recipienttype.rowcount() = 1 then
		this.id_master.object.recipientcode.visible = false
		this.id_master.object.recipientcode_t.visible = false
	end if
	li_rtncode = this.id_detail.getchild("sectcode", this.idc_section)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild for Sections.")
		close(this)
		return
	end if
	this.idc_section.settransobject(this.it_transobject)
	this.idc_section.insertrow(0)
	this.ii_salegodown = this.idc_godown.getitemnumber(1, "gcode")
	this.id_detail.object.gcode.initial = string(this.ii_salegodown)
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode_t.visible = true
		this.id_master.object.gcode.visible = true
		this.id_master.object.gcode.initial = string(this.ii_salegodown)
		this.id_detail.object.gcode.visible = false
		this.id_footer.object.t_totalstock.visible = false
		this.id_footer.object.totalstock.visible = false
	end if
	li_rtncode = this.id_master.getchild("pricetypecode", this.idc_price)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_price.settransobject(this.it_transobject)
	li_rtncode = this.idc_price.retrieve(this.ii_module, this.il_groupcode)
	this.id_master.object.pricetypecode.initial = string(this.idc_price.getitemnumber(1, "pricetypecode"))
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Price Rights to Issue")
		close(this)
		return
	end if
	li_rtncode = this.id_master.getchild("dracccode", this.idc_draccount)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_draccount.settransobject(this.it_transobject)
	li_rtncode = this.idc_draccount.retrieve(this.ii_category)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Issue Category Accounts selection")
		close(this)
		return
	end if
	if this.idc_draccount.rowcount() > 0 then
		this.id_master.object.dracccode.initial = trim(string(this.idc_draccount.getitemnumber(1, "acccode")))
	else
		messagebox("Error", "Not Enough Issue Category Account Selection")
		close(this)
		return
	end if
	li_rtncode = this.id_master.getchild("motorvehiclecode", this.idc_motorvehicle)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_motorvehicle.settransobject(this.it_transobject)
	wf_motorvehicle_retrieve()
	this.id_master.object.issuecategorycode.initial = trim(string(this.ii_category))
	this.id_master.object.accountfor.initial = this.ic_accountfor
	if this.ic_accountfor = "N" then
		this.id_master.object.dracccode.visible = false
		this.id_master.object.dracccode_t.visible = false
	else
		this.id_master.object.dracccode.dddw.required = "yes"
	end if
	if gl_sitecode > 0 and gc_dropbox = "Y" then
		this.id_master.object.sitecode.initial = trim(string(gl_sitecode))
		this.id_master.object.targetsitecode.visible = true
		this.id_master.object.t_targetsitecode.visible = true
	else
		this.id_master.object.targetsitecode.visible = false
		this.id_master.object.t_targetsitecode.visible = false
	end if
	if f_stringpreferences("alternatecustomicodeinissue") = "N" then
		this.id_detail.object.alternatecustomicode.visible = false
	end if
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = true
	this.id_itemslist.object.sstock.visible = true
	this.id_itemslist.object.t_pstock.visible = false
	this.id_itemslist.object.pstock.visible = false
	if f_stringpreferences("showissuepricetypecode") = "N" then
		this.id_master.object.pricetypecode_t.visible = false
		this.id_master.object.pricetypecode.visible = false
	end if
	if f_stringpreferences("showmotorvehicleinissue") = "N" then
		this.id_master.object.chasisno_t.visible = false
		this.id_master.object.chasisno.visible = false
		this.id_master.object.motorvehiclecode_t.visible = false
		this.id_master.object.motorvehiclecode.visible = false
	end if
	if f_stringpreferences("ShowUnitWeightInIssue") = "N" then
		this.id_detail.object.unitweight.visible = false
		this.id_detail.object.c_item_unitweight.visible = false
	else
		this.id_detail.object.unitweight.visible = true
		this.id_detail.object.c_item_unitweight.visible = true
	end if
	if f_stringpreferences("ShowPackingFactorInIssue") = "N" then
		this.id_detail.object.packingfactor.visible = false
		this.id_detail.object.c_item_packingfactor.visible = false
	else
		this.id_detail.object.packingfactor.visible = true
		this.id_detail.object.c_item_packingfactor.visible = true
	end if
	if f_stringpreferences("ShowPackCapacityInSale") = "N" then
		this.id_detail.object.packcapacity.visible = false
	end if
	if f_stringpreferences("ShowAreaVolumeInSale") = "N" then
		this.id_detail.object.areavolume.visible = false
	end if
	if f_stringpreferences("ShowPackCoverageInSale") = "N" then
		this.id_detail.object.c_packcoverage.visible = false
	end if
	if f_stringpreferences("ShowPCSInSale") = "N" then
		this.id_detail.object.pcs.visible = false
	end if
	if f_stringpreferences("ShowCartonsInSale") = "N" then
		this.id_detail.object.cartons.visible = false
	end if
	if f_stringpreferences("ShowTotalPiecesInIssue") = "N" then
		this.id_detail.object.piecesinhand.visible = false
		this.id_detail.object.totalpieces.visible = false
		this.id_detail.object.totalpieces.initial = "0"
		this.id_detail.object.totalpieces.validation = "Real (GetText()) >= 0"
	end if
	this.id_master.object.pricetypecode.initial = trim(string(f_numberpreferences("issuepricetypecode")))
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5017", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_applycustomerassociatedquotation.visible = true
		lm_menu.m_file.m_applycustomerassociatedquotation.enabled = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5016", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_apply_associated_quotaion_onsaving = true
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.sstock.visible = false
	end if
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Issue")
		close(this)
		return
	end if
	if f_stringpreferences("headeronissueinv") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.headerno_t.visible = false
	end if
	if f_stringpreferences("salespersoninissue") = "N" then
		this.id_master.object.smancode.visible = false
		this.id_master.object.smancode_t.visible = false
	end if
	if f_stringpreferences("areainissue") = "N" then
		this.id_master.object.areacode.visible = false
		this.id_master.object.areacode_t.visible = false
	end if
	if f_stringpreferences("issuetypeinissue") = "N" then
		this.id_master.object.issuetypecode.visible = false
		this.id_master.object.issuetypecode_t.visible = false
	end if
	if f_stringpreferences("sectioninissue") = "N" then
		this.id_detail.object.sectcode.visible = false
	end if
	this.id_master.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to lds_headers.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
		ldc_headerno.setitem(ll_counter, "name", "")
		ll_found = 0
		ll_found = gds_reoprtheaderinfo.find("headerno=" + string(lds_headers.getitemnumber(ll_counter, "headercode")), 1, gds_reoprtheaderinfo.rowcount())
		if ll_found > 0 then
			ldc_headerno.setitem(ll_counter, "headeralias", gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks"))
		end if
	next
	this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
	this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	if f_stringpreferences("ShowPriceInIssue") = "N" then
		this.id_detail.object.price.visible = false
		this.id_detail.object.c_itemtotal.visible = false
		this.id_footer.object.total.visible = false
		this.id_footer.object.t_total.visible = false
	end if
	if f_stringpreferences("showclaimableinissue") = "N" then
		this.id_detail.object.claimable.visible = false
	end if
	if f_stringpreferences("showclaimablediscpercinissue") = "N" then
		this.id_detail.object.claimablediscperc.visible = false
		this.id_detail.object.c_claimablevalue.visible = false
	end if
	if f_stringpreferences("IssueItemdescription") = "N" then
		this.id_detail.object.itemdescription.visible = false
	end if
	if f_stringpreferences("showunitcostinissue") = "N" then
		this.id_detail.object.avgprice.visible = false
	end if
	if f_stringpreferences("showtotalcostinissue") = "N" then
		this.id_detail.object.c_totalcost.visible = false
	end if
	li_rtncode = this.id_master.getchild("acccode", this.idc_acccode)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild For Accounts DataWindow")
	end if
	this.idc_acccode.settransobject(this.it_transobject)
	this.idc_acccode.retrieve()
	event ue_set_requiredcolumns(1, 1)
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 559 then
			this.ib_issueposting = true
			this.im_menu.m_file.m_post.visible = true
			this.im_menu.m_file.m_post.toolbaritemvisible = true
			this.im_menu.m_file.m_post.enabled = false
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 560 then
			this.ib_issuemodify = true
		end if
	next
	if not this.ib_issueposting then
		this.im_menu.m_file.m_post.visible = false
		this.im_menu.m_file.m_post.toolbaritemvisible = false
		this.im_menu.m_file.m_post.enabled = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 692", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.date.protect = 0
		this.id_master.object.date.background.color = rgb(255, 255, 255)
		this.ib_modifydate = true
	end if
	if not this.ib_modifydate then
		this.id_master.object.date.protect = 1
		this.id_master.settaborder("date", 0)
		this.id_master.object.date.background.color = this.backcolor
	end if
	if this.is_receiptcompulsion = "Y" then
		this.id_master.object.receiptinvcode_t.visible = true
		this.id_master.object.receiptinvcode.visible = true
		this.id_master.object.receiptinvcode.edit.required = "yes"
	else
		this.id_master.object.receiptinvcode_t.visible = false
		this.id_master.object.receiptinvcode.visible = false
		this.id_master.object.receiptinvcode.edit.required = "no"
		this.id_detail.object.batch.visible = false
		this.id_detail.object.expiry.visible = false
		gd_itemsinfo.sharedata(this.id_itemslist)
	end if
	if wf_item_image_setting() < 0 then
		messagebox("Connection Problem", "Problem in connecting database. Kindly Try Again", stopsign!)
		close(this)
	end if
	f_setcolumnstyle(this.id_detail, "Qty")
	if not f_rightexists(5278) then
		lm_menu.m_file.m_pushissuetodropbox.enabled = false
		lm_menu.m_file.m_pushissuetodropbox.visible = false
		this.id_list.object.pushed.visible = false
		this.id_list.object.pushedon.visible = false
		this.id_list.object.pushedby.visible = false
		this.id_list.object.pushedfor.visible = false
	end if
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	setredraw(true)

// w_issue.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	return ::message.returnvalue
