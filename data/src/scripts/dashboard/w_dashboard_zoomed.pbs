// window w_dashboard_zoomed (dashboard)  ancestor: window

// w_dashboard_zoomed.wf_settimer(long ai_time) returns integer
	timer(ai_time, this)
	return 0

// w_dashboard_zoomed.create() returns 0 [event]
	this.st_tooltip = create st_tooltip
	this.dw_graph = create dw_graph
	this.control = {this.st_tooltip, this.dw_graph}

// w_dashboard_zoomed.destroy() returns 0 [event]
	destroy this.st_tooltip
	destroy this.dw_graph

// w_dashboard_zoomed.open() returns long [event]
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	date ld_currdate
	string ls_text
	datetime ldt_startdate
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width * 0.98
		ll_height = ll_win_height * 0.96
		this.width = ll_width
		this.height = ll_height
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	this.idw_dw = message.powerobjectparm
	ld_currdate = today()
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	this.istr_arg.d_sdate = datetime(date(trim(ls_text)), time("00:00:00"))
	ls_text = string(ld_currdate, "dd/mm/yyyy")
	this.istr_arg.d_edate = datetime(date(trim(ls_text)), time("23:59:59"))
	this.dw_graph.x = 10
	this.dw_graph.y = 0
	this.dw_graph.width = this.width - 10
	this.dw_graph.height = this.height - 10
	this.dw_graph.dataobject = this.idw_dw.dataobject
	this.dw_graph.tag = this.idw_dw.tag
	this.dw_graph.settransobject(sqlca)
	this.idw_dw.sharedata(this.dw_graph)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_graph.ue_rbuttonup(unsignedlong flags, integer xpos, integer ypos) returns long [event]
	parent.st_tooltip.visible = false
	return ::message.returnvalue

// dw_graph.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	grobjecttype clickedobject
	integer li_series
	integer li_category
	string ls_category
	str_graphinfo lstr_graph
	if dwo.name = "gr_1" then
		clickedobject = objectatpointer("gr_1", li_series, li_category)
		if clickedobject = typedata! or clickedobject = typecategory! then
			ls_category = categoryname("gr_1", li_category)
			lstr_graph.controlname = this.tag
			lstr_graph.category = ls_category
			openwithparm(w_dashboard_drilldown, lstr_graph)
		end if
	end if
	return ::message.returnvalue

// dw_graph.rbuttondown(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	grobjecttype clickedobject
	integer li_series
	integer li_category
	long ll_counter
	clickedobject = objectatpointer("gr_1", li_series, li_category)
	if clickedobject = typedata! then
		parent.st_tooltip.text = string(getdata("gr_1", li_series, li_category), "###,###,##0.00")
		parent.st_tooltip.x = parent.pointerx()
		parent.st_tooltip.y = parent.pointery() - 65
		parent.st_tooltip.visible = true
	end if
	return ::message.returnvalue
