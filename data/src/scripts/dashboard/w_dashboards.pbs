	if newindex = 1 then
		if f_rightexists(5225) then
			parent.id_summary1.retrieve(f_numberpreferences("Dashboard_SummaryAnlaysis"))
			parent.id_summary2.retrieve(f_numberpreferences("Dashboard_SummaryAnlaysis"))
		end if
	elseif newindex = 2 then
		if f_rightexists(5226) then
			parent.id_inventory1.retrieve(f_stringpreferences("Dashboard_InventoryBreakupCriteria"))
			parent.id_inventory2.retrieve()
			parent.id_inventory3.retrieve()
			parent.id_inventory4.retrieve(f_stringpreferences("Dashboard_InventoryBreakupCriteria"), f_numberpreferences("Dashboard_SummaryAnlaysis"))
		end if
	elseif newindex = 3 then
		if f_rightexists(5227) then
			parent.id_sales1.retrieve(f_numberpreferences("Dashboard_SalesAnlaysis"))
			parent.id_sales2.retrieve(f_numberpreferences("Dashboard_SalesAnlaysis"))
		end if
	elseif newindex = 4 then
		if f_rightexists(5228) then
			parent.id_purchase1.retrieve(f_numberpreferences("Dashboard_PurAnlaysis"))
			parent.id_purchase2.retrieve(f_numberpreferences("Dashboard_PurAnlaysis"))
		end if
	elseif newindex = 5 then
		if f_rightexists(5230) then
			parent.id_issue1.retrieve(f_numberpreferences("Dashboard_IssueAnalysis"))
			parent.id_issue2.retrieve(f_numberpreferences("Dashboard_IssueAnalysis"))
		end if
	elseif newindex = 6 then
		if f_rightexists(5231) then
			parent.id_receipt1.retrieve(f_numberpreferences("Dashboard_ReceiptAnalysis"))
			parent.id_receipt2.retrieve(f_numberpreferences("Dashboard_ReceiptAnalysis"))
		end if
	elseif newindex = 7 then
		if f_rightexists(5232) then
			parent.id_adj1.retrieve(f_numberpreferences("Dashboard_AdjustmentAnalysis"))
			parent.id_adj2.retrieve(f_numberpreferences("Dashboard_AdjustmentAnalysis"))
		end if
	elseif newindex = 8 then
		if f_rightexists(5233) then
			parent.id_transfer1.retrieve(f_numberpreferences("Dashboard_TransferAnalysis"))
			parent.id_transfer2.retrieve(f_numberpreferences("Dashboard_TransferAnalysis"))
			parent.id_transfer3.retrieve(f_numberpreferences("Dashboard_TransferAnalysis"))
		end if
	elseif newindex = 9 then
		if f_rightexists(5234) then
			parent.id_service1.retrieve(f_numberpreferences("Dashboard_ServiceAnalysis"))
			parent.id_service2.retrieve(f_numberpreferences("Dashboard_ServiceAnalysis"))
		end if
	elseif newindex = 10 then
		if f_rightexists(5235) then
			parent.id_accounts1.retrieve(f_numberpreferences("Dashboard_AccountsAnalysis"))
		end if
	elseif newindex = 11 and f_rightexists(5254) then
		parent.id_crs1.retrieve()
		parent.id_crs2.retrieve()
		parent.id_crs3.retrieve(f_numberpreferences("Dashboard_SalesAnlaysis"))
		parent.id_crs4.retrieve(f_numberpreferences("Dashboard_SalesAnlaysis"))
	end if
	return ::message.returnvalue

