// window w_summaccount_balance (accountsrespwin)  ancestor: window

// w_summaccount_balance.create() returns 0
	this.dw_previnv = create dw_previnv
	this.control = {this.dw_previnv}

// w_summaccount_balance.destroy() returns 0
	destroy this.dw_previnv

// w_summaccount_balance.open() returns long
	long ll_width
	long ll_height
	long ll_acccode
	long ll_counter
	long ll_rowcount
	environment env
	ll_acccode = message.doubleparm
	if getenvironment(env) <> 1 then
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.width = ll_width * 0.98
	this.height = ll_height * 0.80
	this.y = int((ll_height - this.height) / 2.0)
	this.dw_previnv.width = this.width - this.width * 0.02
	this.dw_previnv.height = this.height - this.width * 0.05
	SQL rollback USING sqlca;
	sqlca.virtualgl("A")
	if sqlca.sqlcode <> 0 then
		messagebox("Retrieval Problem!", "Problem in Retrieving Summary Account Balance.")
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	else
		SQL commit USING sqlca;
	end if
	this.dw_previnv.settransobject(sqlca)
	ll_rowcount = this.dw_previnv.retrieve(ll_acccode)
	this.dw_previnv.modify("DataWindow.Print.Preview=yes")
	this.dw_previnv.object.datawindow.print.buttons = "yes"
	setredraw(true)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_summaccount_balance.close() returns long
	close(this)
	return ::message.returnvalue

// w_summaccount_balance.key(keycode key, unsignedlong keyflags) returns long
	if keydown(keyescape!) then
		close(this)
	end if
	return ::message.returnvalue
