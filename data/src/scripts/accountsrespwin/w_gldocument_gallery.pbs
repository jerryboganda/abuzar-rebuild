// window w_gldocument_gallery (accountsrespwin)  ancestor: window

// w_gldocument_gallery.ue_postopen() returns 0 [event]
	long ll_code
	long ll_rowid
	this.il_code = message.doubleparm
	if isnull(this.il_code) or this.il_code <= 0 then
		close(this)
		return
	end if
	this.it_transobject = create u_transaction
	this.it_transobject.autocommit = true
	SQL start USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Connection Problem", "Problem in connecting database. Kindly Try Again", stopsign!)
		close(this)
		return
	end if
	this.ids_ds = create u_ds_standard
	this.ids_ds.dataobject = "d_gldocument"
	this.ids_ds.settransobject(sqlca)
	this.ids_ds.retrieve(this.il_code)
	this.il_totrows = this.ids_ds.rowcount()
	this.il_thisrow = this.il_totrows + 1
	if this.il_totrows <= 0 then
		messagebox("Document/Image Gallary", "No Document/Image for this Voucher Exists in the database.~r~nKindly Specify some other Voucher.", stopsign!)
		close(this)
		return
	end if
	this.cb_prev.event clicked()

// w_gldocument_gallery.ue_close(integer ar_closearg) returns 0 [event]
	string ls_file
	long ll_pos
	ls_file = gs_temp_img_filename
	ll_pos = pos(this.is_filename, ".", 1)
	ls_file = left(this.is_filename, ll_pos - 1)
	ls_file = ls_file + "*.*"
	filedelete(ls_file)
	close(this)

// w_gldocument_gallery.wf_set_image(blob ablb_image) returns long
	string ls_imagetypem
	string ls_ext
	long ll_pos
	this.is_filename = gs_temp_img_filename
	ll_pos = pos(this.is_filename, ".", 1)
	this.is_filename = left(this.is_filename, ll_pos - 1)
	if this.il_thisrow > 0 then
		this.is_filename = this.is_filename + trim(string(this.il_thisrow)) + "." + this.is_imgtype
		ls_ext = trim(upper(this.is_imgtype))
		f_writeimgtofile(this.is_filename, ablb_image)
		this.p_image.setredraw(false)
		if ls_ext = "BMP" or ls_ext = "JPG" or ls_ext = "JPEG" or ls_ext = "GIF" then
			this.p_image.picturename = this.is_filename
			this.st_placeholder.visible = false
		else
			this.p_image.picturename = ""
			this.st_placeholder.visible = true
		end if
		this.p_image.setredraw(true)
	end if
	return 0

// w_gldocument_gallery.wf_set_image_details() returns long
	if this.il_thisrow > 0 then
		this.is_no = trim(string(this.ids_ds.object.code[this.il_thisrow]))
		this.is_name = ""
		this.is_caption = trim(this.ids_ds.object.docdescription[this.il_thisrow])
		this.is_imgtype = trim(this.ids_ds.object.documenttype[this.il_thisrow])
		this.st_imagecounter.text = "Document/Image " + trim(string(this.il_thisrow)) + " of " + trim(string(this.il_totrows))
		this.st_imagecaption.text = this.is_caption
		this.st_name.text = "" + this.is_name
		this.st_no.text = "GL Voucher No.: " + this.is_no
		if wf_get_image(this.il_code, this.il_thisrow) = 0 then
			wf_set_image(this.ibl_image)
		else
			messagebox("Document/Image Gallary", "Problem in fetching Document image.", stopsign!)
		end if
	end if
	return 0

// w_gldocument_gallery.wf_get_image(long al_code, long al_row) returns long
	if al_code > 0 and al_row > 0 then
		SQL SelectBlob Document INTO :this.ibl_image From GLDocument Where GLVochCode =:al_code AND RowID =:al_row USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Document/Image/Picture ", "Unable to fetch Document/Image.~r~nReasons are:~r~n" + this.it_transobject.sqlerrtext)
			return -1
		end if
		return
	end if
	return 0

// w_gldocument_gallery.wf_set_image_ole() returns string
	string ls_filename
	string ls_imagetype
	ls_imagetype = this.is_imgtype
	ls_filename = gs_temp_img_filename
	ls_filename = left(ls_filename, len(ls_filename) - 4) + "_ole"
	ls_filename = ls_filename + "." + ls_imagetype
	f_writeimgtofile(ls_filename, this.ibl_image)
	return ls_filename

// w_gldocument_gallery.create() returns 0 [event]
	this.st_placeholder = create st_placeholder
	this.ole_image = create ole_image
	this.st_no = create st_no
	this.st_name = create st_name
	this.st_imagecounter = create st_imagecounter
	this.cb_exit = create cb_exit
	this.cb_next = create cb_next
	this.cb_prev = create cb_prev
	this.st_imagecaption = create st_imagecaption
	this.p_image = create p_image
	this.cb_slideshow = create cb_slideshow
	this.control = {this.st_placeholder, this.ole_image, this.st_no, this.st_name, this.st_imagecounter, this.cb_exit, this.cb_next, this.cb_prev, this.st_imagecaption, this.p_image, this.cb_slideshow}

// w_gldocument_gallery.destroy() returns 0 [event]
	destroy this.st_placeholder
	destroy this.ole_image
	destroy this.st_no
	destroy this.st_name
	destroy this.st_imagecounter
	destroy this.cb_exit
	destroy this.cb_next
	destroy this.cb_prev
	destroy this.st_imagecaption
	destroy this.p_image
	destroy this.cb_slideshow

// w_gldocument_gallery.open() returns long [event]
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		this.width = ll_win_width * 0.98
		this.height = ll_win_height * 0.97
		this.st_no.width = ll_win_width * 0.98 - 25
		this.st_name.width = ll_win_width * 0.98 - 25
		this.st_imagecounter.width = ll_win_width * 0.98 - 25
		this.st_imagecounter.width = ll_win_width * 0.98 - 25
		this.cb_next.x = ll_win_width * 0.98 - 25 - this.cb_next.width
		this.cb_slideshow.x = (ll_win_width - this.cb_slideshow.width) / 2.0
		this.st_imagecaption.width = ll_win_width * 0.98 - 25
		this.cb_exit.x = ll_win_width * 0.98 - 25 - this.cb_exit.width
		this.cb_exit.y = this.height - this.cb_exit.height - 100
		this.st_imagecaption.y = this.cb_exit.y - 10 - this.st_imagecaption.height
		this.p_image.width = ll_win_width - 150
		this.p_image.height = this.st_imagecaption.y - this.p_image.y - 10
		this.st_placeholder.visible = false
		this.st_placeholder.width = this.p_image.width
		this.st_placeholder.y = this.p_image.height / 2.0
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	post event ue_postopen()
	return ::message.returnvalue

// w_gldocument_gallery.key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		post event ue_close(-1)
	elseif key = keyleftarrow! then
		this.cb_prev.event clicked()
	elseif key = keyrightarrow! then
		this.cb_next.event clicked()
	elseif key = keyuparrow! then
		this.cb_prev.event clicked()
	elseif key = keydownarrow! then
		this.cb_next.event clicked()
	end if
	return ::message.returnvalue

// w_gldocument_gallery.close() returns long [event]
	if fileexists(this.is_filename) then
		filedelete(this.is_filename)
	end if
	return ::message.returnvalue

// st_placeholder.clicked() returns long [event]
	string ls_filename
	string ls_null
	setnull(ls_null)
	ls_filename = parent.is_filename
	f_writeimgtofile(ls_filename, parent.ibl_image)
	shellexecute(0, "open", ls_filename, ls_null, ls_null, 1)
	return ::message.returnvalue

// cb_exit.clicked() returns long [event]
	parent.post event ue_close(0)
	return ::message.returnvalue

// cb_next.clicked() returns long [event]
	if parent.il_thisrow < parent.il_totrows then
		parent.il_thisrow = parent.il_thisrow + 1
		parent.wf_set_image_details()
	end if
	return ::message.returnvalue

// cb_prev.clicked() returns long [event]
	if parent.il_thisrow > 1 then
		parent.il_thisrow = parent.il_thisrow - 1
		parent.wf_set_image_details()
	end if
	return ::message.returnvalue

// p_image.clicked() returns long [event]
	string ls_filename
	string ls_cmd
	if not (this.picturename = "" or isnull(this.picturename)) then
		ls_filename = parent.wf_set_image_ole()
		ls_cmd = "rundll32.exe shimgvw.dll,ImageView_Fullscreen " + ls_filename
		run(ls_cmd)
	end if
	return ::message.returnvalue

// cb_slideshow.clicked() returns long [event]
	long ll_counter
	long i
	this.enabled = false
	parent.cb_next.enabled = false
	parent.cb_prev.enabled = false
	parent.il_thisrow = 0
	do while parent.il_thisrow < parent.il_totrows
		parent.il_thisrow = parent.il_thisrow + 1
		parent.wf_set_image_details()
		if parent.il_thisrow <> parent.il_totrows then
			sleep(1000)
		end if
	loop
	parent.cb_next.enabled = true
	parent.cb_prev.enabled = true
	this.enabled = true
	return ::message.returnvalue
