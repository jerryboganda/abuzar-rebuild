// window w_fee_voucher (accounts)  ancestor: w_multi_entry

// w_fee_voucher.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_listdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_list.dataobject = as_listdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)

// w_fee_voucher.wf_cleargroupbox() returns 0

// w_fee_voucher.wf_deleteallemptydetailrows() returns long
	long ll_count
	long ll_deletecount
	long ll_code
	long ll_rowcount
	double ld_dramt
	double ld_cramt
	ll_deletecount = 0
	ll_rowcount = this.id_detail.rowcount()
	if this.is_invoicebased = "Y" then
		for ll_count = 1 to this.id_detail.rowcount()
			ll_code = this.id_detail.getitemnumber(ll_count, "invoicecode")
			ld_dramt = this.id_detail.getitemdecimal(ll_count, "debit")
			ld_cramt = this.id_detail.getitemdecimal(ll_count, "credit")
			if isnull(ll_code) or ld_dramt = 0.0 and ld_cramt = 0.0 then
				ll_deletecount = ll_deletecount + 1
				this.id_detail.deleterow(ll_count)
			end if
		next
		for ll_count = 1 to this.id_detail.rowcount()
			ll_code = this.id_detail.getitemnumber(ll_count, "invoicecode")
			ld_dramt = this.id_detail.getitemdecimal(ll_count, "debit")
			ld_cramt = this.id_detail.getitemdecimal(ll_count, "credit")
			if isnull(ll_code) or ld_dramt = 0.0 and ld_cramt = 0.0 then
				ll_deletecount = ll_deletecount + 1
				this.id_detail.deleterow(ll_count)
			end if
		next
	else
		for ll_count = 1 to this.id_detail.rowcount()
			ll_code = this.id_detail.getitemnumber(ll_count, "acccode")
			ld_dramt = this.id_detail.getitemdecimal(ll_count, "debit")
			ld_cramt = this.id_detail.getitemdecimal(ll_count, "credit")
			if isnull(ll_code) or ld_dramt = 0.0 and ld_cramt = 0.0 then
				ll_deletecount = ll_deletecount + 1
				this.id_detail.deleterow(ll_count)
			end if
		next
		for ll_count = 1 to this.id_detail.rowcount()
			ll_code = this.id_detail.getitemnumber(ll_count, "acccode")
			ld_dramt = this.id_detail.getitemdecimal(ll_count, "debit")
			ld_cramt = this.id_detail.getitemdecimal(ll_count, "credit")
			if isnull(ll_code) or ld_dramt = 0.0 and ld_cramt = 0.0 then
				ll_deletecount = ll_deletecount + 1
				this.id_detail.deleterow(ll_count)
			end if
		next
	end if
	return ll_deletecount

// w_fee_voucher.wf_deleteemptydetailrow() returns integer
	long ll_rowcount
	integer li_rtcode
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 0 then
		if this.is_invoicebased = "N" then
			if isnull(this.id_detail.getitemnumber(ll_rowcount, "acccode")) then
				this.id_detail.deleterow(ll_rowcount)
				li_rtcode = 1
			end if
		elseif isnull(this.id_detail.getitemnumber(ll_rowcount, "invoicecode")) then
			this.id_detail.deleterow(ll_rowcount)
			li_rtcode = 1
		end if
	end if
	return li_rtcode

// w_fee_voucher.wf_deletevoucher(long al_glvochcode) returns integer
	SQL Delete GLDetail Where GLDetail.GLVochCode =:al_glvochcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_fee_voucher.wf_filter(string as_acctype) returns 0
	long ll_subcode
	string ls_filter
	if not isnull(as_acctype) then
		ls_filter = "restricted='N' AND "
	else
		ls_filter = "restricted='N'"
	end if
	if f_rightexists(537) then
		ls_filter = ""
	end if
	if not isnull(as_acctype) then
		if as_acctype = "CashSub" then
			ll_subcode = this.il_cashsub
		elseif as_acctype = "BankSub" then
			ll_subcode = this.il_banksub
		elseif as_acctype = "CreditorsSub" then
			ll_subcode = this.il_creditorssub
		elseif as_acctype = "DebitorsSub" then
			ll_subcode = this.il_debitorssub
		else
			setnull(ll_subcode)
		end if
		if not isnull(ll_subcode) then
			ls_filter = ls_filter + "subcode = Long('" + string(ll_subcode) + "')"
			this.idc_dddwdetailaccount.setfilter(ls_filter)
			this.idc_dddwdetailaccount.filter()
		else
			ls_filter = ls_filter + "subcode <> Long('" + string(this.il_creditorssub) + "') AND subcode <> Long('" + string(this.il_debitorssub) + "')"
			this.idc_dddwdetailaccount.setfilter(ls_filter)
			this.idc_dddwdetailaccount.filter()
		end if
	end if
	this.idc_dddwdetailaccount.setfilter(ls_filter)
	this.idc_dddwdetailaccount.filter()

// w_fee_voucher.wf_findfullcode(string as_fullcode, long al_acccode) returns integer
	boolean lb_groupcustcat
	long ll_found
	long ll_subcode
	lb_groupcustcat = true
	SQL SELECT acccode , subcode INTO :al_acccode, :ll_subcode FROM dbo.accounts WHERE aliasname =:as_fullcode and subcode =:this.il_debitorssub and active ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		return 1
	end if
	if as_fullcode = "" or isnull(as_fullcode) then
		return 1
	end if
	return this.it_transobject.sqlcode

// w_fee_voucher.wf_getbalance(long al_acccode) returns double
	double ld_balance
	SQL SELECT ISNULL ( SUM ( Debit - Credit ) , 0 ) INTO :ld_balance FROM DBO.VirtualGl WHERE AccCode =:al_acccode USING sqlca;
	if sqlca.sqlcode <> 0 then
		ld_balance = 0
	end if
	return ld_balance

// w_fee_voucher.wf_getfullcode(long al_acccode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	SQL SELECT aliasname INTO :ls_fullcode FROM dbo.accounts WHERE dbo.accounts.acccode =:al_acccode and active ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_fee_voucher.wf_getinvinfo(long al_glvochcode, long al_invcode, double ad_amt) returns integer
	double ld_dr
	double ld_cr
	if this.is_jv = "Y" then
		SQL Select IsNull ( Sum ( GLDetail.Debit ) , 0 ) , IsNull ( Sum ( GLDetail.Credit ) , 0 ) INTO :ld_dr, :ld_cr from GLDetail where GLDetail.GLVochCode =:al_glvochcode AND GLDetail.InvoiceCode =:al_invcode USING this.it_transobject;
		if ld_dr - ld_cr > 0.0 then
			if this.is_invoicetype = "Sale" or this.is_invoicetype = "Sale of Service" then
				ad_amt = 0
			else
				ad_amt = ld_dr
			end if
		elseif this.is_invoicetype = "Sale" or this.is_invoicetype = "Sale of Service" then
			ad_amt = ld_cr
		else
			ad_amt = 0
		end if
	elseif this.is_detailtreatment = "D" then
		if this.is_invoicetype = "Sale" or this.is_invoicetype = "Sale of Service" then
			ad_amt = 0
		else
			SQL Select IsNull ( Sum ( GLDetail.Debit ) , 0 ) INTO :ad_amt from GLDetail where GLDetail.GLVochCode =:al_glvochcode AND GLDetail.InvoiceCode =:al_invcode USING this.it_transobject;
		end if
	elseif this.is_invoicetype = "Sale" or this.is_invoicetype = "Sale of Service" then
		SQL Select IsNull ( Sum ( GLDetail.Credit ) , 0 ) INTO :ad_amt from GLDetail where GLDetail.GLVochCode =:al_glvochcode AND GLDetail.InvoiceCode =:al_invcode USING this.it_transobject;
	else
		ad_amt = 0
	end if
	if isnull(ad_amt) then
		ad_amt = 0
	end if
	return this.it_transobject.sqlcode

// w_fee_voucher.wf_getnewvouchercode(integer ai_vouchcatcode, long al_vouchercode, transaction at_transobject) returns integer
	long ll_rtcode
	SQL SELECT dbo.VOCHERCATEGORY.COUNTER INTO :al_vouchercode FROM dbo.VOCHERCATEGORY WITH ( UPDLOCK HOLDLOCK ) WHERE dbo.VOCHERCATEGORY.VochCatCode =:ai_vouchcatcode USING at_transobject;
	if at_transobject.sqlcode = 0 then
		al_vouchercode = al_vouchercode + 1
		SQL update dbo.VOCHERCATEGORY SET dbo.VOCHERCATEGORY.COUNTER =:al_vouchercode WHERE dbo.VOCHERCATEGORY.VochCatCode =:ai_vouchcatcode USING at_transobject;
		if at_transobject.sqlcode < 0 then
			ll_rtcode = at_transobject.sqlcode
			al_vouchercode = 0
		end if
	else
		ll_rtcode = at_transobject.sqlcode
		al_vouchercode = 0
	end if
	return ll_rtcode

// w_fee_voucher.wf_initglobalconstants() returns 0
	this.it_transobject.getglobalcode("GT_CashSub", this.il_cashsub)
	this.it_transobject.getglobalcode("GT_BankSub", this.il_banksub)
	this.it_transobject.getglobalcode("GT_CreditorsSub", this.il_creditorssub)
	this.it_transobject.getglobalcode("GT_DebitorsSub", this.il_debitorssub)

// w_fee_voucher.wf_initmodify(integer ai_protect) returns integer
	long ll_glvochcode
	long ll_counter = 1
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_glvochcode = this.id_detail.getitemnumber(1, "code")
		if wf_lockvoucher(ll_glvochcode) = 0 then
			this.id_master.retrieve(ll_glvochcode)
			this.id_detail.retrieve(ll_glvochcode)
			ai_protect = 0
			this.ib_modify = true
			this.editflag = true
			if this.is_invoicebased = "Y" then
				for ll_counter = 1 to this.id_detail.rowcount()
					wf_validateinvcode(ll_counter, this.id_detail.object.invoicecode[ll_counter])
					wf_setbalance(this.id_detail.object.acccode[ll_counter], ll_counter)
				next
			else
				for ll_counter = 1 to this.id_detail.rowcount()
					wf_setbalance(this.id_detail.object.acccode[ll_counter], ll_counter)
				next
			end if
			this.il_oldacccode = this.id_master.getitemnumber(1, "acccode")
			this.im_menu.m_file.m_save.enabled = true
			this.im_menu.m_file.m_new.enabled = false
			this.im_menu.m_file.m_delete.enabled = false
			this.im_menu.m_item.m_newitem.enabled = true
			this.im_menu.m_item.m_deleteitem.enabled = true
			this.im_menu.m_file.m_first.enabled = false
			this.im_menu.m_file.m_next.enabled = false
			this.im_menu.m_file.m_previous.enabled = false
			this.im_menu.m_file.m_last.enabled = false
			this.im_menu.m_file.m_retrieve.enabled = true
			this.im_menu.m_file.m_retrieve.text = "Lis&t"
			this.tab_retrieve.tabpage_detail.enabled = true
		end if
	else
		for ll_counter = 1 to this.id_detail.rowcount()
			wf_setinvoicedetail(this.id_detail.object.invoicecode[ll_counter], ll_counter)
		next
	end if
	return 1

// w_fee_voucher.wf_lockinvoice(long al_invcode) returns integer
	integer li_count
	this.it_transobject.dbparm = " Async =1, DBGetTime = 20"
	if this.is_invoicetype = "Sale" or this.is_invoicetype = "Sale of Service" then
		if this.is_invoicetype = "Sale" then
			this.it_transobject.locksaleinvoice(al_invcode)
		else
			this.it_transobject.lockserviceinvoice(al_invcode)
		end if
	elseif this.is_invoicetype = "Purchase" then
		this.it_transobject.lockpurinvoice(al_invcode)
	else
		this.it_transobject.lockservicepurinvoice(al_invcode)
	end if
	this.it_transobject.dbparm = "Async =0, DBGetTime = 0"
	return this.it_transobject.sqlcode

// w_fee_voucher.wf_lockvoucher(integer al_glvochcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From glheader WITH ( UPDLOCK HOLDLOCK ) Where glheader.glvochcode =:al_glvochcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_fee_voucher.wf_lockvouchers(long al_sinvcode, long al_linvcode, long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From glheader WITH ( UPDLOCK HOLDLOCK ) Where glheader.glvochcode Between :al_sinvcode AND :al_linvcode AND glheader.Posted ='N' USING sqlca;
	return sqlca.sqlcode

// w_fee_voucher.wf_post(long al_usercode, long al_vouchercode) returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	s_arguements lstr_arginfo
	datetime ldt_server_datetime
	string ls_date_errtext
	if al_usercode = -1 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = al_usercode
	end if
	if ll_salesmancode > 0 then
		if al_usercode = -1 then
			open(w_arg_sinvcode_linvcode)
			lstr_arginfo = message.powerobjectparm
		else
			lstr_arginfo.l_code1 = al_vouchercode
			lstr_arginfo.l_code2 = al_vouchercode
			lstr_arginfo.i_status = 1
		end if
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return -1
			end if
			SQL rollback USING sqlca;
			li_errcode = wf_lockvouchers(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_saleinvcount)
			if li_errcode = 0 then
				sqlca.postgeneralledger(lstr_arginfo.l_code1, lstr_arginfo.l_code2, this.ii_vouchertype, ll_salesmancode)
				if sqlca.sqlcode <> 0 then
					li_errcode = -1
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if li_errcode <> 0 then
		messagebox("Posting Fails", "Some database request fails, Please try again")
		return li_errcode
	end if
	return li_errcode

// w_fee_voucher.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_temp
	string ls_colname
	string ls_rtnstring
	if not isnull(ad_dwcontrol.dataobject) then
		li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
		for li_counter = li_colcount to 1 step -1
			ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
			if lower(ls_colname) = "date" then
				if f_stringpreferences("askdateintrans") = "N" then
					ad_dwcontrol.modify(ls_colname + ".Protect=1")
				else
					ad_dwcontrol.modify(ls_colname + ".Protect=0")
				end if
			elseif ai_doundo = 1 then
				ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
			else
				ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
			end if
		next
	end if

// w_fee_voucher.wf_returnvoucher(long al_invid, string as_errortext) returns boolean
	long ll_invcode
	long ll_counter = 1
	long ll_detailrows
	long ll_masterrow
	boolean lb_commitflag = true
	double ld_amt
	double ld_oldtotalamt
	double ld_balance
	double ld_totalamt
	double ld_newbalance
	this.id_vocherdetail.retrieve(al_invid)
	as_errortext = "Some database problem occur"
	ll_detailrows = this.id_vocherdetail.rowcount()
	ll_counter = 1
	do while this.is_invoicebased = "Y" and (ll_counter <= ll_detailrows and lb_commitflag)
		ll_invcode = this.id_vocherdetail.getitemnumber(ll_counter, "invoicecode")
		if not isnull(ll_invcode) then
			if this.id_vocherdetail.getitemdecimal(ll_counter, "debit") > 0 then
				if this.is_invoicetype = "Sale" or this.is_invoicetype = "Sale of Service" then
					ld_amt = this.id_vocherdetail.getitemdecimal(ll_counter, "debit") * -1
				else
					ld_amt = this.id_vocherdetail.getitemdecimal(ll_counter, "debit")
				end if
			elseif this.is_invoicetype = "Sale" or this.is_invoicetype = "Sale of Service" then
				ld_amt = this.id_vocherdetail.getitemdecimal(ll_counter, "credit")
			else
				ld_amt = this.id_vocherdetail.getitemdecimal(ll_counter, "credit") * -1
			end if
			if wf_lockinvoice(ll_invcode) = 0 then
				if this.is_invoicetype = "Sale" or this.is_invoicetype = "Sale of Service" then
					if this.is_invoicetype = "Sale" then
						this.it_transobject.getsaleinvbalance(ll_invcode, ld_balance)
					else
						this.it_transobject.getserviceinvbalance(ll_invcode, ld_balance)
					end if
					if this.it_transobject.sqlcode = 0 then
						if ld_amt <> 0.0 and lb_commitflag then
							ld_newbalance = ld_balance + ld_amt
							if ld_newbalance >= 0.0 then
								if this.is_invoicetype = "Sale" then
									this.it_transobject.updatesaleinvbalance(ll_invcode, ld_newbalance)
								else
									this.it_transobject.updateserviceinvbalance(ll_invcode, ld_newbalance)
								end if
								if this.it_transobject.sqlcode <> 0 then
									lb_commitflag = false
									as_errortext = "Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
								end if
							else
								lb_commitflag = false
								as_errortext = "Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
							end if
						else
							lb_commitflag = false
							if this.is_invoicetype = "Sale" then
								as_errortext = "Not Enough Balance On Sale Invoice."
							else
								as_errortext = "Not Enough Balance On Service Sale Invoice."
							end if
						end if
					else
						lb_commitflag = false
						as_errortext = "Balance Retrieval Error:~r~n" + this.it_transobject.sqlerrtext
					end if
				else
					if this.is_invoicetype = "Purchase" then
						this.it_transobject.getpurinvbalance(ll_invcode, ld_balance)
					else
						this.it_transobject.getservicepurinvbalance(ll_invcode, ld_balance)
					end if
					if this.it_transobject.sqlcode = 0 then
						if ld_amt <> 0.0 and lb_commitflag then
							ld_newbalance = ld_balance + ld_amt
							if ld_newbalance >= 0.0 then
								if this.is_invoicetype = "Purchase" then
									this.it_transobject.updatepurinvbalance(ll_invcode, ld_newbalance)
								else
									this.it_transobject.updateservicepurinvbalance(ll_invcode, ld_newbalance)
								end if
								if this.it_transobject.sqlcode <> 0 then
									lb_commitflag = false
									as_errortext = "Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
								end if
							else
								lb_commitflag = false
								as_errortext = "Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
							end if
						else
							lb_commitflag = false
							if this.is_invoicetype = "Purchase" then
								as_errortext = "Not Enough Balance On Purchase Invoice."
							else
								as_errortext = "Not Enough Balance On Service Purchase Invoice."
							end if
						end if
					else
						lb_commitflag = false
						as_errortext = "Balance Retrieval Error:~r~n" + this.it_transobject.sqlerrtext
					end if
				end if
			else
				lb_commitflag = false
				as_errortext = "Invoice is used by another user"
			end if
		end if
		ll_counter = ll_counter + 1
	loop
	if lb_commitflag and wf_deletevoucher(al_invid) <> 0 then
		lb_commitflag = false
		as_errortext = "Some database problem occur during modification of this voucher"
	end if
	return lb_commitflag

// w_fee_voucher.wf_setaccountname(string as_data) returns 0
	long ll_rowno
	ll_rowno = this.idc_dddwdetailaccount.find("name >='" + as_data + "'", 1, this.idc_dddwdetailaccount.rowcount())
	if ll_rowno > 0 then
		this.idc_dddwdetailaccount.selectrow(0, false)
		this.idc_dddwdetailaccount.setrow(ll_rowno)
		this.idc_dddwdetailaccount.scrolltorow(ll_rowno)
		this.idc_dddwdetailaccount.selectrow(ll_rowno, true)
	end if

// w_fee_voucher.wf_setbalance(long al_acccode, long al_row) returns double
	double ld_balance
	SQL SELECT ISNULL ( SUM ( Debit - Credit ) , 0 ) INTO :ld_balance FROM DBO.VirtualGl WHERE AccCode =:al_acccode USING sqlca;
	if sqlca.sqlcode <> 0 then
		ld_balance = 0
	end if
	this.id_detail.setitem(al_row, "balance", ld_balance)
	this.id_footer.object.balance[1] = ld_balance
	return ld_balance

// w_fee_voucher.wf_setpatientname(string as_data) returns 0
	long ll_rowno
	ll_rowno = this.idc_dddwdetailpatient.find("name >='" + as_data + "'", 1, this.idc_dddwdetailpatient.rowcount())
	if ll_rowno > 0 then
		this.idc_dddwdetailpatient.selectrow(0, false)
		this.idc_dddwdetailpatient.setrow(ll_rowno)
		this.idc_dddwdetailpatient.scrolltorow(ll_rowno)
		this.idc_dddwdetailpatient.selectrow(ll_rowno, true)
	end if

// w_fee_voucher.wf_validatedate() returns boolean
	datetime ldt_systemdatetime
	SQL SELECT GETDATE ( ) INTO :ldt_systemdatetime FROM _UTN USING sqlca;
	if sqlca.sqlcode = 0 then
		this.id_master.setitem(1, "date", ldt_systemdatetime)
		return true
	end if
	return false

// w_fee_voucher.wf_validategroupcustcat() returns integer
	long ll_acccode
	long ll_found
	long ll_code
	long ll_counter
	long ll_rowcount
	boolean lb_groupcustcat
	if f_stringpreferences("GroupCustCatInTrans") = "N" then
		return 0
	end if
	ll_rowcount = this.id_detail.rowcount()
	ll_code = this.id_master.getitemnumber(1, "code")
	for ll_counter = 1 to ll_rowcount
		ll_acccode = this.id_detail.getitemnumber(ll_counter, "acccode")
		ll_found = 0
		SQL Select Count ( *) INTO :ll_found From dbo.customer Where custcode =:ll_acccode USING this.it_transobject;
		if ll_found > 0 and this.it_transobject.sqlcode = 0 then
			ll_found = 0
			this.it_transobject.isallowedcustomergroupcategory(f_getgroupcode(gl_usercode), ll_acccode, ll_found)
			if this.it_transobject.sqlcode = 0 and ll_found < 1 then
				return -1
			end if
			return
		end if
	next
	return 0

// w_fee_voucher.wf_validatepatient(long al_patientcode, string as_regno, long al_acccode) returns boolean
	SQL SELECT regno , CustCode INTO :as_regno, :al_acccode FROM Patient WHERE PatientCode =:al_patientcode USING sqlca;
	if sqlca.sqlcode = 0 then
		return true
	end if
	return false

// w_fee_voucher.wf_validateregno(string as_regno, long al_patientcode, long al_acccode) returns boolean
	SQL SELECT patientcode , CustCode INTO :al_patientcode, :al_acccode FROM Patient WHERE regno =:as_regno AND patientcode in ( SELECT PP.PatientCode FROM Patient PP WHERE PP.RegNo =:as_regno AND dbo.fn_GetPreference ( 'allowedpatientsintransaction' ) ='A' UNION SELECT PP.PatientCode FROM Patient PP WHERE PP.RegNo =:as_regno AND dbo.fn_GetPreference ( 'allowedpatientsintransaction' ) ='C' AND PP.Active ='Y' UNION SELECT PP.PatientCode FROM Patient PP , PatientAdmission PA WHERE PP.RegNo =:as_regno AND dbo.fn_GetPreference ( 'allowedpatientsintransaction' ) ='D' AND PP.Active ='Y' AND PP.PatientCode =PA.PatientCode AND PA.Discharged ='N' UNION SELECT PP.PatientCode FROM Patient PP WHERE PP.RegNo =:as_regno AND dbo.fn_GetPreference ( 'allowedpatientsintransaction' ) ='X' AND PP.Active ='Y' AND PP.PatientCode NOT IN ( SELECT DISTINCT PA.PatientCode FROM PatientAdmission PA WHERE PA.Discharged ='Y' ) ) USING sqlca;
	if sqlca.sqlcode = 0 then
		return true
	end if
	return false

// w_fee_voucher.wf_populatedetail(long al_invid, datawindow ad_detail, string as_errortext, long al_errorrow) returns boolean
	long ll_detailrows
	long ll_errrowid
	long ll_usercode = 1
	long ll_invcode
	long ll_counter
	long ll_masterrow
	long ll_row
	long ll_acccode
	long ll_patientcode
	long ll_guestcode
	long ll_studentcode
	long ll_null
	long ll_unpostedtrans
	double ld_amt
	double ld_balance
	double ld_newbalance
	double ld_totalamt
	double ld_debit
	double ld_credit
	double ld_invbalance
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	boolean lb_commitflag = true
	string ls_remarks
	string ls_chkno
	string ls_msg
	ls_msg = space(1000)
	setnull(ll_null)
	ll_detailrows = this.id_detail.rowcount()
	ll_counter = 1
	ls_msg = "000                                                                                                                                 "
	as_errortext = "    Some database problem ocuurs         "
	ll_masterrow = this.id_master.rowcount()
	do while ll_counter <= ll_detailrows and lb_commitflag
		ll_acccode = this.id_detail.getitemnumber(ll_counter, "acccode")
		ll_invcode = this.id_detail.getitemnumber(ll_counter, "invoicecode")
		ls_remarks = this.id_detail.getitemstring(ll_counter, "remarks")
		ls_chkno = this.id_detail.getitemstring(ll_counter, "chkno")
		ll_patientcode = this.id_detail.getitemnumber(ll_counter, "patientcode")
		ll_guestcode = this.id_detail.getitemnumber(ll_counter, "guestcode")
		ll_studentcode = this.id_detail.getitemnumber(ll_counter, "studentcode")
		ld_debit = this.id_detail.getitemdecimal(ll_counter, "debit")
		ld_credit = this.id_detail.getitemdecimal(ll_counter, "credit")
		ld_balance = this.id_detail.getitemdecimal(ll_counter, "balance")
		if this.is_invoicebased = "Y" then
			if this.id_detail.getitemdecimal(ll_counter, "debit") > 0 then
				if this.is_invoicetype = "Sale" or this.is_invoicetype = "Sale of Service" then
					ld_amt = this.id_detail.getitemdecimal(ll_counter, "debit")
				else
					ld_amt = this.id_detail.getitemdecimal(ll_counter, "debit") * -1
				end if
			elseif this.is_invoicetype = "Sale" or this.is_invoicetype = "Sale of Service" then
				ld_amt = this.id_detail.getitemdecimal(ll_counter, "credit") * -1
			else
				ld_amt = this.id_detail.getitemdecimal(ll_counter, "credit")
			end if
			if wf_lockinvoice(ll_invcode) = 0 then
				if this.is_invoicetype = "Sale" or this.is_invoicetype = "Sale of Service" then
					ls_msg = "000                                                                                                                                 "
					if this.is_invoicetype = "Sale" then
						this.it_transobject.checkunpostedsaleinvintransactions(ll_invcode, al_invid, "V", ll_unpostedtrans, ls_msg)
					else
						this.it_transobject.checkunpostedserviceinvintransactions(ll_invcode, al_invid, "V", ll_unpostedtrans, ls_msg)
					end if
					if ll_unpostedtrans > 0 then
						lb_commitflag = false
						as_errortext = "Unposted Transaction(s) Exist for this Invoice~r~n~r~n" + ls_msg
					else
						if this.is_invoicetype = "Sale" then
							this.it_transobject.getsaleinvbalance(ll_invcode, ld_invbalance)
						else
							this.it_transobject.getserviceinvbalance(ll_invcode, ld_invbalance)
						end if
						if this.it_transobject.sqlcode = 0 then
							if ld_amt <> 0.0 and lb_commitflag then
								ll_row = ad_detail.insertrow(0)
								ad_detail.setitem(ll_row, "code", al_invid)
								ad_detail.setitem(ll_row, "acccode", ll_acccode)
								ad_detail.setitem(ll_row, "invoicecode", ll_invcode)
								ad_detail.setitem(ll_row, "patientcode", ll_patientcode)
								ad_detail.setitem(ll_row, "studentcode", ll_studentcode)
								ad_detail.setitem(ll_row, "guestcode", ll_guestcode)
								ad_detail.setitem(ll_row, "outstandingamt", ld_invbalance)
								ad_detail.setitem(ll_row, "debit", ld_debit)
								ad_detail.setitem(ll_row, "credit", ld_credit)
								ad_detail.setitem(ll_row, "chkno", ls_chkno)
								ad_detail.setitem(ll_row, "remarks", ls_remarks)
								ad_detail.setitem(ll_row, "balance", wf_getbalance(ll_acccode))
								ld_newbalance = ld_invbalance + ld_amt
								if ld_newbalance >= 0.0 then
									if this.is_invoicetype = "Sale" then
										this.it_transobject.updatesaleinvbalance(ll_invcode, ld_newbalance)
										if this.it_transobject.sqlcode <> 0 then
											lb_commitflag = false
											as_errortext = "Sale Invoice Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
										end if
									else
										this.it_transobject.updateserviceinvbalance(ll_invcode, ld_newbalance)
										if this.it_transobject.sqlcode <> 0 then
											lb_commitflag = false
											as_errortext = "Service Sales Invoice Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
										end if
									end if
								else
									lb_commitflag = false
									if this.is_invoicetype = "Sale" then
										as_errortext = "Sale Invoice Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
									else
										as_errortext = "Service Sale Invoice Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
									end if
								end if
							else
								lb_commitflag = false
								if this.is_invoicetype = "Sale" then
									as_errortext = "Not Enough Balance On Sale Invoice."
								else
									as_errortext = "Not Enough Balance On Service Sale Invoice."
								end if
							end if
						else
							lb_commitflag = false
							if this.is_invoicetype = "Sale" then
								as_errortext = "Sale Invoice Balance Retrieval Error:~r~n" + this.it_transobject.sqlerrtext
							else
								as_errortext = "Service Sale Invoice Balance Retrieval Error:~r~n" + this.it_transobject.sqlerrtext
							end if
						end if
					end if
				else
					ls_msg = "000                                                                                                                                 "
					if this.is_invoicetype = "Purchase" then
						this.it_transobject.checkunpostedpurinvintransactions(ll_invcode, al_invid, "V", ll_unpostedtrans, ls_msg)
					else
						this.it_transobject.checkunpostedservicepurinvintransactions(ll_invcode, al_invid, "V", ll_unpostedtrans, ls_msg)
					end if
					if ll_unpostedtrans > 0 then
						lb_commitflag = false
						as_errortext = "Unposted Transaction(s) Exist for this Invoice~r~n~r~n" + ls_msg
					else
						if this.is_invoicetype = "Purchase" then
							this.it_transobject.getpurinvbalance(ll_invcode, ld_invbalance)
						else
							this.it_transobject.getservicepurinvbalance(ll_invcode, ld_invbalance)
						end if
						if this.it_transobject.sqlcode = 0 then
							if ld_amt <> 0.0 and lb_commitflag then
								ll_row = ad_detail.insertrow(0)
								ad_detail.setitem(ll_row, "code", al_invid)
								ad_detail.setitem(ll_row, "acccode", ll_acccode)
								ad_detail.setitem(ll_row, "invoicecode", ll_invcode)
								ad_detail.setitem(ll_row, "patientcode", ll_patientcode)
								ad_detail.setitem(ll_row, "guestcode", ll_guestcode)
								ad_detail.setitem(ll_row, "studentcode", ll_studentcode)
								ad_detail.setitem(ll_row, "outstandingamt", ld_invbalance)
								ad_detail.setitem(ll_row, "debit", ld_debit)
								ad_detail.setitem(ll_row, "credit", ld_credit)
								ad_detail.setitem(ll_row, "chkno", ls_chkno)
								ad_detail.setitem(ll_row, "remarks", ls_remarks)
								ad_detail.setitem(ll_row, "balance", wf_getbalance(ll_acccode))
								ld_newbalance = ld_invbalance + ld_amt
								if ld_newbalance >= 0.0 then
									if this.is_invoicetype = "Purchase" then
										this.it_transobject.updatepurinvbalance(ll_invcode, ld_newbalance)
										if this.it_transobject.sqlcode <> 0 then
											lb_commitflag = false
											as_errortext = "Purchase Invoice Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
										end if
									else
										this.it_transobject.updateservicepurinvbalance(ll_invcode, ld_newbalance)
										if this.it_transobject.sqlcode <> 0 then
											lb_commitflag = false
											as_errortext = "Service Purchase Invoice Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
										end if
									end if
								else
									lb_commitflag = false
									if this.is_invoicetype = "Purchase" then
										as_errortext = "Purchase Invoice Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
									else
										as_errortext = "Service Purchase Invoice Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
									end if
								end if
							else
								lb_commitflag = false
								if this.is_invoicetype = "Purchase" then
									as_errortext = "Not Enough Balance On Purchase Invoice"
								else
									as_errortext = "Not Enough Balance On Service Purchase Invoice"
								end if
							end if
						else
							lb_commitflag = false
							if this.is_invoicetype = "Purchase" then
								as_errortext = "Purchase Invoice Balance Retrieval Error:~r~n" + this.it_transobject.sqlerrtext
							else
								as_errortext = "Service Purchase Invoice Balance Retrieval Error:~r~n" + this.it_transobject.sqlerrtext
							end if
						end if
					end if
				end if
			else
				lb_commitflag = false
				as_errortext = "Invoice Is Used by some other user"
			end if
		else
			ll_row = ad_detail.insertrow(0)
			ad_detail.setitem(ll_row, "code", al_invid)
			ad_detail.setitem(ll_row, "acccode", ll_acccode)
			ad_detail.setitem(ll_row, "invoicecode", ll_invcode)
			ad_detail.setitem(ll_row, "patientcode", ll_patientcode)
			ad_detail.setitem(ll_row, "guestcode", ll_guestcode)
			ad_detail.setitem(ll_row, "studentcode", ll_studentcode)
			ad_detail.setitem(ll_row, "outstandingamt", ld_invbalance)
			ad_detail.setitem(ll_row, "debit", ld_debit)
			ad_detail.setitem(ll_row, "credit", ld_credit)
			ad_detail.setitem(ll_row, "chkno", ls_chkno)
			ad_detail.setitem(ll_row, "remarks", ls_remarks)
			ad_detail.setitem(ll_row, "balance", wf_getbalance(ll_acccode))
		end if
		ll_counter = ll_counter + 1
	loop
	if this.is_jv = "N" then
		ll_acccode = this.id_master.object.acccode[ll_masterrow]
		ls_remarks = this.id_master.object.remarks[ll_masterrow]
		ls_chkno = this.id_master.object.chkno[ll_masterrow]
		if this.is_detailtreatment = "D" then
			ld_credit = round(this.id_detail.getitemdecimal(1, "c_debitamtsum"), 2)
			ld_debit = 0
		else
			ld_credit = 0
			ld_debit = round(this.id_detail.getitemdecimal(1, "c_creditamtsum"), 2)
		end if
		ll_row = ad_detail.insertrow(0)
		ad_detail.setitem(ll_row, "code", al_invid)
		ad_detail.setitem(ll_row, "acccode", ll_acccode)
		ad_detail.setitem(ll_row, "debit", ld_debit)
		ad_detail.setitem(ll_row, "credit", ld_credit)
		ad_detail.setitem(ll_row, "chkno", ls_chkno)
		ad_detail.setitem(ll_row, "remarks", ls_remarks)
		ad_detail.setitem(ll_row, "invoicecode", ll_null)
		ad_detail.setitem(ll_row, "patientcode", ll_null)
		ad_detail.setitem(ll_row, "studentcode", ll_null)
		ad_detail.setitem(ll_row, "guestcode", ll_null)
		ad_detail.setitem(ll_row, "outstandingamt", 0)
		ad_detail.setitem(ll_row, "balance", wf_getbalance(ll_acccode))
	end if
	if lb_commitflag then
		SQL rollback USING sqlca;
		ul_rowcount = ad_detail.rowcount()
		sqlca.getmaxutn(ul_rowcount, ul_maxutn)
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
			messagebox("SAVING", " Error in generating Utn ")
			return false
		end if
		for ll_counter = 1 to ad_detail.rowcount()
			ad_detail.setitem(ll_counter, "GlUtn", ul_maxutn)
			ul_maxutn = ul_maxutn + 1
		next
	else
		al_errorrow = ll_counter - 1
	end if
	return lb_commitflag

// w_fee_voucher.wf_validateinvcode(long al_row, long al_invcode) returns integer
	integer li_rtcode
	long ll_invcode
	long ll_acccode
	long ll_glvochcode
	long ll_patientcode
	long ll_guestcode
	long ll_studentcode
	long ll_unpostedrows
	double ld_outstandingamt
	double ld_netamt
	double ld_oldamt
	double ld_balance
	datetime ld_date
	string ls_aliasname
	string ls_regno
	string ls_guestregno
	string ls_studentregno
	string ls_remarks
	ll_acccode = this.id_master.object.acccode[this.id_master.rowcount()]
	if vf_dwdupcode1(this.id_detail, "invoicecode", string(al_invcode), al_row) = true then
		li_rtcode = 1
		messagebox("Invoice Validation", "Duplicate Invoice, please select some other invoice")
	else
		if this.is_invoicetype = "Sale" then
			SQL SELECT SaleLedger.SaleInvCode , RegNo =( SELECT Patient.RegNo FROM Patient WHERE Patient.PatientCode =SaleLedger.PatientCode ) , SaleLedger.PatientCode , GuestRegNo =( SELECT Guest.RegNo FROM Guest WHERE Guest.GuestCode =SaleLedger.GuestCode ) , SaleLedger.GuestCode , StudentRegNo =( SELECT Student.RegNo FROM Student WHERE Student.StudentCode =SaleLedger.StudentCode ) , SaleLedger.StudentCode , SaleLedger.Date , SaleLedger.CustCode , Accounts.AliasName , SaleLedger.OutstandingAmt , SaleLedger.InvTotal INTO :ll_invcode, :ls_regno, :ll_patientcode, :ls_guestregno, :ll_guestcode, :ls_studentregno, :ll_studentcode, :ld_date, :ll_acccode, :ls_aliasname, :ld_outstandingamt, :ld_netamt FROM SaleLedger , Accounts WHERE SaleLedger.SaleInvCode =:al_invcode AND SaleLedger.AccountFor ='Y' AND SaleLedger.Marked ='N' AND SaleLedger.Posted ='Y' AND SaleLedger.CustCode =Accounts.AccCode AND SaleLedger.SaleCatCode IN ( 2 ) USING sqlca;
		elseif this.is_invoicetype = "Sale of Service" then
			SQL SELECT ServiceHeader.ServiceInvCode , RegNo =( SELECT Patient.RegNo FROM Patient WHERE Patient.PatientCode =ServiceHeader.PatientCode ) , ServiceHeader.PatientCode , GuestRegNo =( SELECT Guest.RegNo FROM Guest WHERE Guest.GuestCode =ServiceHeader.GuestCode ) , ServiceHeader.GuestCode , StudentRegNo =( SELECT Student.RegNo FROM Student WHERE Student.StudentCode =ServiceHeader.StudentCode ) , ServiceHeader.StudentCode , ServiceHeader.Date , ServiceHeader.CustCode , Accounts.AliasName , ServiceHeader.OutstandingAmt , ServiceHeader.InvTotal , ServiceHeader.Remarks INTO :ll_invcode, :ls_regno, :ll_patientcode, :ls_guestregno, :ll_guestcode, :ls_studentregno, :ll_studentcode, :ld_date, :ll_acccode, :ls_aliasname, :ld_outstandingamt, :ld_netamt, :ls_remarks FROM ServiceHeader , Accounts WHERE ServiceHeader.ServiceInvCode =:al_invcode AND ServiceHeader.Marked ='N' AND ServiceHeader.Posted ='Y' AND ServiceHeader.CustCode =Accounts.AccCode USING sqlca;
		elseif this.is_invoicetype = "Purchase" then
			SQL SELECT PurLedger.PurInvCode , PurLedger.Date , PurLedger.SuppCode , Accounts.AliasName , PurLedger.OutstandingAmt , PurLedger.InvTotal INTO :ll_invcode, :ld_date, :ll_acccode, :ls_aliasname, :ld_outstandingamt, :ld_netamt FROM PurLedger , Accounts WHERE PurLedger.PurInvCode =:al_invcode AND PurLedger.AccountFor ='Y' AND PurLedger.Marked ='N' AND PurLedger.SuppCode =Accounts.AccCode AND PurLedger.Posted ='Y' USING sqlca;
		else
			SQL SELECT ServicePurHeader.ServicePurInvCode , ServicePurHeader.Date , ServicePurHeader.SuppCode , Accounts.AliasName , ServicePurHeader.OutstandingAmt , ServicePurHeader.InvTotal INTO :ll_invcode, :ld_date, :ll_acccode, :ls_aliasname, :ld_outstandingamt, :ld_netamt FROM ServicePurHeader , Accounts WHERE ServicePurHeader.ServicePurInvCode =:al_invcode AND ServicePurHeader.Marked ='N' AND ServicePurHeader.SuppCode =Accounts.AccCode AND ServicePurHeader.Posted ='Y' USING sqlca;
		end if
		if sqlca.sqlcode = 0 then
			if ll_invcode > 0 then
				ld_balance = wf_setbalance(ll_acccode, al_row)
				this.id_detail.object.acccode[al_row] = ll_acccode
				this.id_detail.object.fullcode[al_row] = ls_aliasname
				this.id_detail.object.invoicecode[al_row] = ll_invcode
				this.id_detail.object.invdate[al_row] = ld_date
				this.id_detail.object.netamt[al_row] = ld_netamt
				this.id_detail.object.balance[al_row] = ld_balance
				this.id_footer.object.invdate[1] = ld_date
				this.id_footer.object.netamt[1] = ld_netamt
				this.id_detail.object.balance[1] = ld_balance
				if this.is_invoicetype = "Sale" or this.is_invoicetype = "Sale of Service" then
					this.id_detail.object.patientcode[al_row] = ll_patientcode
					this.id_detail.object.regno[al_row] = ls_regno
					this.id_detail.object.guestcode[al_row] = ll_guestcode
					this.id_detail.object.guestregno[al_row] = ls_guestregno
					this.id_detail.object.studentcode[al_row] = ll_studentcode
					this.id_detail.object.studentregno[al_row] = ls_studentregno
					if this.is_invoicetype = "Sale of Service" then
						this.id_detail.object.remarks[al_row] = ls_remarks
					end if
				end if
				if this.ib_modify then
					ll_glvochcode = this.id_master.object.code[this.id_master.rowcount()]
					li_rtcode = wf_getinvinfo(ll_glvochcode, ll_invcode, ld_oldamt)
					if li_rtcode = 0 then
						ld_outstandingamt = ld_outstandingamt + ld_oldamt
					else
						li_rtcode = 1
					end if
				elseif this.is_jv = "N" then
					if this.is_detailtreatment = "D" then
						if ld_outstandingamt > 0.0 then
							this.id_detail.object.debit[al_row] = ld_outstandingamt
						else
							this.id_detail.object.debit[al_row] = 0
						end if
					elseif ld_outstandingamt > 0.0 then
						this.id_detail.object.credit[al_row] = ld_outstandingamt
					else
						this.id_detail.object.credit[al_row] = 0
					end if
				else
					this.id_detail.object.debit[al_row] = 0
					this.id_detail.object.credit[al_row] = 0
				end if
				this.id_footer.object.outstandingamt[1] = ld_outstandingamt
				this.id_detail.object.outstandingamt[al_row] = ld_outstandingamt
				if li_rtcode = 0 and this.id_detail.object.outstandingamt[al_row] <= 0 then
					li_rtcode = 1
				end if
			else
				li_rtcode = 1
			end if
		else
			li_rtcode = 1
		end if
	end if
	return li_rtcode

// w_fee_voucher.wf_populateinvoices() returns long
	datastore lds_invselected
	long ll_detailrows
	long ll_count
	long ll_duplrows
	long ll_invcode
	long ll_row
	integer li_result
	integer li_rtncode
	s_arguements lstr_selectedinvoices
	long ll_rowcount
	long ll_rtcode
	long ll_retrievecount
	long ll_lockedcount
	string ls_fullcode
	if wf_iseditable() = false then
		return 0
	end if
	if this.is_invoicebased = "N" then
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	if this.is_invoicetype = "Sale" or this.is_invoicetype = "Sale of Service" then
		openwithparm(w_arg_cust_sinv_linv, lstr_selectedinvoices)
	elseif this.is_invoicetype = "Purchase" or this.is_invoicetype = this.isc_svc_pur then
		openwithparm(w_arg_supp_sinv_linv, lstr_selectedinvoices)
	end if
	lstr_selectedinvoices = message.powerobjectparm
	lds_invselected = create datastore
	choose case this.is_invoicetype
	case "Sale"
		lds_invselected.dataobject = "d_creditsaleinvoices_balance"
	case "Sale of Service"
		lds_invselected.dataobject = "d_serviceinvoices_balance"
	case "Purchase"
		lds_invselected.dataobject = "d_purinvoices_balance"
	case this.isc_svc_pur
		lds_invselected.dataobject = "d_servicepurinvoices_balance"
	end choose
	lds_invselected.settransobject(this.it_transobject)
	this.id_detail.reset()
	ll_rtcode = lds_invselected.retrieve(lstr_selectedinvoices.l_code1, lstr_selectedinvoices.l_code2, lstr_selectedinvoices.l_code3, lstr_selectedinvoices.l_code4)
	ll_rowcount = lds_invselected.rowcount()
	for ll_count = 1 to ll_rowcount
		ll_invcode = lds_invselected.object.invcode[ll_count]
		ll_row = this.id_detail.insertrow(0)
		if wf_validateinvcode(ll_row, ll_invcode) = 0 then
			if this.is_jv = "N" then
				if this.is_detailtreatment = "D" then
					this.id_detail.setitem(ll_row, "debit", this.id_detail.getitemnumber(ll_row, "outstandingamt"))
				else
					this.id_detail.setitem(ll_row, "credit", this.id_detail.getitemnumber(ll_row, "outstandingamt"))
				end if
			elseif this.is_invoicetype = "Sale" or this.is_invoicetype = "Sale of Service" then
				this.id_detail.setitem(ll_row, "debit", this.id_detail.getitemnumber(ll_row, "outstandingamt"))
			elseif this.is_invoicetype = "Purchase" or this.is_invoicetype = this.isc_svc_pur then
				this.id_detail.setitem(ll_row, "credit", this.id_detail.getitemnumber(ll_row, "outstandingamt"))
			end if
			this.id_detail.object.chkno[ll_row] = this.id_master.object.chkno[1]
			this.id_detail.object.remarks[ll_row] = this.id_master.object.remarks[1]
			ll_retrievecount = ll_retrievecount + 1
		else
			this.id_detail.deleterow(ll_row)
		end if
	next
	destroy lds_invselected
	if ll_retrievecount = ll_rowcount then
		messagebox("Result", string(ll_rowcount) + " Invoices are populated. ")
	else
		messagebox("Result", "Total invoices were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " invoices populated successfully~n~r" + string(ll_duplrows) + " invoices are not populated successfully~n~r" + string(ll_lockedcount) + " records are in error")
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_fee_voucher.wf_showsummaryaccountbalance() returns 0
	long ll_acccode
	if wf_iseditable() = false then
		return
	end if
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ll_acccode = this.id_detail.getitemnumber(this.id_detail.getrow(), "acccode")
		if not isnull(ll_acccode) then
			openwithparm(w_summaccount_balance, ll_acccode)
		end if
	end if

// w_fee_voucher.wf_setvouchercategorysettings() returns 0
	if this.is_jv = "N" then
		this.id_master.object.acccode.visible = true
		this.id_master.object.acccode_t.visible = true
		if this.is_detailtreatment = "D" then
			this.id_detail.object.debit_t.text = "Amount"
			this.id_detail.object.debit.visible = true
			this.id_detail.object.credit.visible = false
		else
			this.id_detail.object.credit_t.text = "Amount"
			this.id_detail.object.credit.visible = true
			this.id_detail.object.debit.visible = false
		end if
	else
		this.id_master.object.acccode.visible = false
		this.id_master.object.acccode_t.visible = false
		this.id_master.object.acccode.initial = "2"
	end if
	if this.is_invoicebased = "Y" then
		this.id_detail.object.invoicecode.visible = true
		this.id_detail.object.invdate.visible = true
		this.id_detail.object.netamt.visible = true
		this.id_detail.object.outstandingamt.visible = true
		this.id_footer.object.invdate.visible = true
		this.id_footer.object.netamt.visible = true
		this.id_footer.object.outstandingamt.visible = true
		this.id_footer.object.invdate_t.visible = true
		this.id_footer.object.netamt_t.visible = true
		this.id_footer.object.outstandingamt_t.visible = true
		this.id_detail.object.studentregno.background.color = this.backcolor
		this.id_detail.object.studentcode.background.color = this.backcolor
		this.id_detail.settaborder("studentregno", 0)
		this.id_detail.settaborder("studentcode", 0)
		return
	end if
	this.id_detail.object.invoicecode.visible = false
	this.id_detail.object.invdate.visible = false
	this.id_detail.object.netamt.visible = false
	this.id_detail.object.outstandingamt.visible = false
	this.id_footer.object.invdate.visible = false
	this.id_footer.object.netamt.visible = false
	this.id_footer.object.outstandingamt.visible = false
	this.id_footer.object.invdate_t.visible = false
	this.id_footer.object.netamt_t.visible = false
	this.id_footer.object.outstandingamt_t.visible = false
	this.id_detail.settaborder("invoicecode", 0)

// w_fee_voucher.wf_setvouchertype(integer ai_vouchtype) returns 0
	string ls_dataobject
	SQL SELECT VochCatCode , Name , JV =CASE JournalVoucher WHEN 0 THEN 'N' ELSE 'Y' END , HeaderTreatment , DetailTreatment , InvoiceBased =CASE InvoiceBased WHEN 0 THEN 'N' ELSE 'Y' END , InvoiceType =CASE InvoiceType WHEN 1 THEN 'Sale' WHEN 2 THEN 'Purchase' WHEN 3 THEN 'Sale of Service' ELSE 'Purchase of Service' END , AutoPosting , VoucherOrder INTO :this.ii_vouchertype, :this.is_vouchercategoryname, :this.is_jv, :this.is_headertreatment, :this.is_detailtreatment, :this.is_invoicebased, :this.is_invoicetype, :this.ic_autoposting, :this.ii_voucherorder FROM VocherCategory WHERE VochCatCode =:ai_vouchtype AND Posted ='Y' USING sqlca;

// w_fee_voucher.wf_selectprintout() returns 0
	integer li_printformat
	string ls_pagesize
	string ls_printout
	li_printformat = f_numberpreferences("VoucherPrintingFormat")
	ls_pagesize = f_stringpreferences("VoucherPrintingPageSize")
	ls_printout = "d_voucherprint"
	choose case ls_pagesize
	case "F"
		choose case li_printformat
		case 1
			ls_printout = "d_voucherprint"
		case 2
			ls_printout = "d_voucherprint_format2"
		case 3
			ls_printout = "d_voucherprint_patient"
		case 4
			ls_printout = "d_voucherprint_standard2"
		end choose
	case "H"
		choose case li_printformat
		case 1
			ls_printout = "d_voucherprint_half"
		case 2
			ls_printout = "d_voucherprint_half_format2"
		case 3
			ls_printout = "d_voucherprint_half_patient"
		case 4
			ls_printout = "d_voucherprint_half_standard2"
		end choose
	end choose
	if gs_company = "IOLSNAROWAL" then
		if this.ii_vouchertype = 101 then
			ls_printout = "d_iolsnarowal_feereceipt"
		else
			ls_printout = "d_iolsnarowal_voucherprint"
		end if
	elseif gs_company = "WISESCHOOL" then
		ls_printout = "d_wiseschool_feeprint"
	elseif gs_company = "WISESCHOOL2" then
		if this.ii_vouchertype = 101 then
			ls_printout = "d_wiseschool2_feeprint"
		else
			ls_printout = "d_wiseschool2_voucherprint"
		end if
	elseif gs_company = "PAKANGELSSCHOOL" then
		if this.ii_vouchertype = 101 then
			ls_printout = "d_pakangelsschool_feereceipt"
		else
			ls_printout = "d_pakangelsschool_voucherprint"
		end if
	elseif gs_company = "IPS" then
		if this.ii_vouchertype = 101 then
			ls_printout = "d_ips_feereceipt"
		else
			ls_printout = "d_ips_voucherprint"
		end if
	elseif gs_company = "PAKPEARLINST" or gs_company = "PAKPEARLINST2" or gs_company = "PAKPEARLINST3" then
		ls_printout = "d_pakpearlinst_feereceipt"
	end if
	this.dw_voucherrep.dataobject = ls_printout
	this.dw_voucherrep.settransobject(this.it_transobject)
	choose case this.ii_voucherorder
	case 1
		this.dw_voucherrep.setsort("gldetail.glrowid")
		return
	case 2
		this.dw_voucherrep.setsort("GLDetail.Credit A, GLDetail.Debit D, gldetail.glrowid A")
		return
	case 3
		this.dw_voucherrep.setsort("Accounts_name A, gldetail.glrowid A")
		return
	case 4
		this.dw_voucherrep.setsort("Accounts_aliasname A, gldetail.glrowid A")
	end choose

// w_fee_voucher.wf_accountledger() returns 0
	long ll_acccode
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ll_acccode = this.id_detail.getitemnumber(this.id_detail.getrow(), "acccode")
		openwithparm(w_account_ledger, ll_acccode)
		return
	end if
	ll_acccode = this.id_master.getitemnumber(this.id_master.getrow(), "acccode")
	openwithparm(w_account_ledger, ll_acccode)

// w_fee_voucher.wf_retrievelist() returns long
	string[] ls_criteria
	long ll_rtcode
	ls_criteria[1] = "N"
	if this.ib_showtransactioninlist then
		ll_rtcode = this.id_list.retrieve(this.ii_vouchertype, ls_criteria, this.il_groupcode, gl_usercode)
	else
		ll_rtcode = -1
	end if
	return ll_rtcode

// w_fee_voucher.wf_retrievelistall() returns long
	string[] ls_criteria
	ls_criteria[1] = "N"
	ls_criteria[2] = "Y"
	return this.id_list.retrieve(this.ii_vouchertype, ls_criteria, this.il_groupcode, gl_usercode)

// w_fee_voucher.wf_check_unique_refno() returns long
	long ll_counter
	long ll_tmpcode
	string ls_chkno
	string ls_find_criteria
	if f_stringpreferences("UniqueRefNoInTrans") = "Y" then
		for ll_counter = 1 to this.id_detail.rowcount()
			ls_chkno = this.id_detail.getitemstring(ll_counter, "chkno")
			if isnull(ls_chkno) or ls_chkno = "" then
				ls_chkno = ""
			end if
			ls_find_criteria = "chkno = '" + ls_chkno + "'"
			ll_tmpcode = this.id_detail.find(ls_find_criteria, ll_counter + 1, this.id_detail.rowcount())
			if ll_tmpcode <> 0 then
				if ll_tmpcode = ll_counter then
					ll_tmpcode = 0
					return ll_tmpcode
				else
					return ll_tmpcode
				end if
				return
			end if
		next
	end if
	return ll_tmpcode

// w_fee_voucher.wf_show_patientdiscount_window() returns long
	long ll_found
	long ll_retcode
	long ll_patientcode
	double ld_discountvalue
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 616", 1, gds_securitywindow.rowcount())
	if ll_found > 0 and this.id_detail.getrow() > 0 then
		ll_patientcode = this.id_detail.object.patientcode[this.id_detail.getrow()]
		if not isnull(ll_patientcode) then
			ll_patientcode = this.id_detail.object.patientcode[this.id_detail.getrow()]
			openwithparm(w_patientdiscount, ll_patientcode)
			ld_discountvalue = message.doubleparm
			if ld_discountvalue > 0.0 then
				this.id_detail.setitem(this.id_detail.getrow(), "credit", ld_discountvalue)
			end if
		end if
	end if
	return ll_retcode

// w_fee_voucher.wf_isvoucherinuse(long al_glvochcode) returns boolean
	long ll_found
	SQL Select count ( *) INTO :ll_found From GLHeader Where GLVochCode =:al_glvochcode and Posted ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_found = 0 or isnull(ll_found) then
			ll_found = 0
			SQL Select count ( *) INTO :ll_found From GLHeader With ( ReadPast , RowLock , UpdLock ) Where GLVochCode =:al_glvochcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ll_found = 0 then
					return true
				else
					return false
				end if
			else
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_fee_voucher.wf_saveandpost() returns 0
	long ll_sinvcode
	long ll_usercode
	boolean lb_commitflag = true
	if not wf_iseditable() then
		return
	end if
	event ue_save()
	if this.ib_commitok then
		ll_sinvcode = this.id_master.getitemnumber(1, "code")
		ll_usercode = this.id_master.getitemnumber(1, "salesmancode")
		if isnull(ll_sinvcode) or ll_sinvcode < 0 then
			return
		else
			wf_post(ll_usercode, ll_sinvcode)
		end if
	end if
	setpointer(arrow!)

// w_fee_voucher.wf_search_account() returns 0
	long ll_code
	long ll_oldcode
	s_account_search lstr_account_search
	s_popup_selection lstr_selection
	ll_oldcode = this.id_detail.getitemnumber(1, "acccode")
	this.id_detail.setcolumn("acccode")
	this.id_detail.setfocus()
	lstr_account_search.l_vouchertype = this.ii_vouchertype
	lstr_account_search.s_datawindowname = "ddd_vouchdetailaccounts"
	openwithparm(w_popup_partialsearch_selection_acc, lstr_account_search)
	lstr_selection = message.powerobjectparm
	if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
		this.id_detail.setitem(1, "acccode", lstr_selection.l_code2)
	end if

// w_fee_voucher.wf_populate_outstanding_invoices() returns long
	datastore lds_invselected
	long ll_detailrows
	long ll_count
	long ll_duplrows
	long ll_invcode
	long ll_row
	long ll_format = 1
	integer li_result
	integer li_rtncode
	s_arguements lstr_selectedinvoices
	s_arguements lstr_temp
	long ll_rowcount
	long ll_rtcode
	long ll_retrievecount
	long ll_lockedcount
	string ls_fullcode
	if wf_iseditable() = false then
		return 0
	end if
	if this.is_invoicebased = "N" then
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	if this.is_invoicetype = "Sale" then
		open(w_select_invoicepopulation_voucher)
		ll_format = message.doubleparm
		if ll_format = 1 then
			open(w_arg_cust_period_outstanding_inv)
		else
			open(w_arg_areas)
			lstr_temp = message.powerobjectparm
			if lstr_temp.i_status = 1 then
				openwithparm(w_arg_subareas_areabased, lstr_temp)
			end if
		end if
	elseif this.is_invoicetype = "Sale of Service" then
		open(w_arg_cust_period_outstanding_serviceinv)
	elseif this.is_invoicetype = "Purchase" then
		open(w_arg_supp_period_outstanding_inv)
	elseif this.is_invoicetype = this.isc_svc_pur then
		open(w_arg_supp_period_outstanding_serviceinv)
	end if
	lstr_selectedinvoices = message.powerobjectparm
	lds_invselected = create datastore
	choose case this.is_invoicetype
	case "Sale"
		if ll_format = 1 then
			lds_invselected.dataobject = "d_creditsaleinvoices_outstanding"
		else
			lds_invselected.dataobject = "d_creditsaleinvoices_outstanding2"
		end if
	case "Sale of Service"
		lds_invselected.dataobject = "d_serviceinvoices_outstanding"
	case "Purchase"
		lds_invselected.dataobject = "d_purinvoices_outstanding"
	case this.isc_svc_pur
		lds_invselected.dataobject = "d_servicepurinvoices_outstanding"
	end choose
	lds_invselected.settransobject(this.it_transobject)
	this.id_detail.reset()
	if lstr_selectedinvoices.i_status < 1 then
		return 0
	end if
	ll_rtcode = lds_invselected.retrieve(lstr_selectedinvoices.la_longlist)
	ll_rowcount = lds_invselected.rowcount()
	for ll_count = 1 to ll_rowcount
		ll_invcode = lds_invselected.object.invcode[ll_count]
		ll_row = this.id_detail.insertrow(0)
		if wf_validateinvcode(ll_row, ll_invcode) = 0 then
			if this.is_jv = "N" then
				if this.is_detailtreatment = "D" then
					this.id_detail.setitem(ll_row, "debit", this.id_detail.getitemnumber(ll_row, "outstandingamt"))
				else
					this.id_detail.setitem(ll_row, "credit", this.id_detail.getitemnumber(ll_row, "outstandingamt"))
				end if
			elseif this.is_invoicetype = "Sale" or this.is_invoicetype = "Sale of Service" then
				this.id_detail.setitem(ll_row, "debit", this.id_detail.getitemnumber(ll_row, "outstandingamt"))
			elseif this.is_invoicetype = "Purchase" or this.is_invoicetype = this.isc_svc_pur then
				this.id_detail.setitem(ll_row, "credit", this.id_detail.getitemnumber(ll_row, "outstandingamt"))
			end if
			this.id_detail.object.chkno[ll_row] = this.id_master.object.chkno[1]
			this.id_detail.object.remarks[ll_row] = this.id_master.object.remarks[1]
			ll_retrievecount = ll_retrievecount + 1
		else
			this.id_detail.deleterow(ll_row)
		end if
	next
	destroy lds_invselected
	if ll_retrievecount = ll_rowcount then
		messagebox("Result", string(ll_rowcount) + " Invoices are populated. ")
	else
		messagebox("Result", "Total invoices were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " invoices populated successfully~n~r" + string(ll_duplrows) + " invoices are not populated successfully~n~r" + string(ll_lockedcount) + " records are in error")
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_fee_voucher.wf_setinvoicedetail(long al_invcode, long al_row) returns long
	integer li_rtcode
	long ll_invcode
	long ll_acccode
	long ll_glvochcode
	long ll_unpostedrows
	double ld_outstandingamt
	double ld_netamt
	double ld_oldamt
	double ld_balance
	datetime ld_date
	string ls_aliasname
	string ls_regno
	if this.is_invoicetype = "Sale" then
		SQL SELECT SaleLedger.SaleInvCode , SaleLedger.Date , SaleLedger.InvTotal INTO :ll_invcode, :ld_date, :ld_netamt FROM SaleLedger , Accounts WHERE SaleLedger.SaleInvCode =:al_invcode AND SaleLedger.AccountFor ='Y' AND SaleLedger.Marked ='N' AND SaleLedger.Posted ='Y' AND SaleLedger.CustCode =Accounts.AccCode AND SaleLedger.SaleCatCode IN ( 2 ) USING sqlca;
	elseif this.is_invoicetype = "Sale of Service" then
		SQL SELECT ServiceHeader.ServiceInvCode , ServiceHeader.Date , ServiceHeader.InvTotal INTO :ll_invcode, :ld_date, :ld_netamt FROM ServiceHeader , Accounts WHERE ServiceHeader.ServiceInvCode =:al_invcode AND ServiceHeader.Marked ='N' AND ServiceHeader.Posted ='Y' AND ServiceHeader.CustCode =Accounts.AccCode USING sqlca;
	elseif this.is_invoicetype = "Purchase" then
		SQL SELECT PurLedger.PurInvCode , PurLedger.Date , PurLedger.InvTotal INTO :ll_invcode, :ld_date, :ld_netamt FROM PurLedger , Accounts WHERE PurLedger.PurInvCode =:al_invcode AND PurLedger.AccountFor ='Y' AND PurLedger.Marked ='N' AND PurLedger.SuppCode =Accounts.AccCode AND PurLedger.Posted ='Y' USING sqlca;
	else
		SQL SELECT ServicePurHeader.ServicePurInvCode , ServicePurHeader.Date , ServicePurHeader.InvTotal INTO :ll_invcode, :ld_date, :ld_netamt FROM ServicePurHeader , Accounts WHERE ServicePurHeader.ServicePurInvCode =:al_invcode AND ServicePurHeader.Marked ='N' AND ServicePurHeader.SuppCode =Accounts.AccCode AND ServicePurHeader.Posted ='Y' USING sqlca;
	end if
	if sqlca.sqlcode = 0 then
		if ll_invcode > 0 then
			this.id_detail.object.invdate[al_row] = ld_date
			this.id_detail.object.netamt[al_row] = ld_netamt
		else
			li_rtcode = 1
		end if
	else
		li_rtcode = 1
	end if
	return li_rtcode

// w_fee_voucher.wf_setguestname(string as_data) returns long
	long ll_rowno
	ll_rowno = this.idc_dddwdetailguest.find("guest >='" + as_data + "'", 1, this.idc_dddwdetailguest.rowcount())
	if ll_rowno > 0 then
		this.idc_dddwdetailguest.selectrow(0, false)
		this.idc_dddwdetailguest.setrow(ll_rowno)
		this.idc_dddwdetailguest.scrolltorow(ll_rowno)
		this.idc_dddwdetailguest.selectrow(ll_rowno, true)
	end if
	return 0

// w_fee_voucher.wf_setstudentname(string as_data) returns long
	long ll_rowno
	ll_rowno = this.idc_dddwdetailstudent.find("Student >='" + as_data + "'", 1, this.idc_dddwdetailstudent.rowcount())
	if ll_rowno > 0 then
		this.idc_dddwdetailstudent.selectrow(0, false)
		this.idc_dddwdetailstudent.setrow(ll_rowno)
		this.idc_dddwdetailstudent.scrolltorow(ll_rowno)
		this.idc_dddwdetailstudent.selectrow(ll_rowno, true)
	end if
	return 0

// w_fee_voucher.wf_validateguest(long al_guestcode, string as_regno, long al_acccode) returns boolean
	SQL SELECT regno , CustCode INTO :as_regno, :al_acccode FROM Guest WHERE GuestCode =:al_guestcode USING sqlca;
	if sqlca.sqlcode = 0 then
		return true
	end if
	return false

// w_fee_voucher.wf_validatestudent(long al_studentcode, string as_regno, long al_acccode) returns boolean
	SQL SELECT regno , CustCode INTO :as_regno, :al_acccode FROM Student WHERE StudentCode =:al_studentcode USING sqlca;
	if sqlca.sqlcode = 0 then
		return true
	end if
	return false

// w_fee_voucher.wf_validate_guestregno(string as_regno, long al_guestcode, long al_acccode) returns boolean
	SQL SELECT Guestcode , CustCode INTO :al_guestcode, :al_acccode FROM Guest WHERE regno =:as_regno AND Guestcode in ( SELECT PP.GuestCode FROM Guest PP WHERE PP.RegNo =:as_regno AND dbo.fn_GetPreference ( 'allowedGuestsintransaction' ) ='A' UNION SELECT PP.GuestCode FROM Guest PP WHERE PP.RegNo =:as_regno AND dbo.fn_GetPreference ( 'allowedGuestsintransaction' ) ='C' AND PP.Active ='Y' UNION SELECT PP.GuestCode FROM Guest PP , GuestCheckIn PA WHERE PP.RegNo =:as_regno AND dbo.fn_GetPreference ( 'allowedGuestsintransaction' ) ='D' AND PP.Active ='Y' AND PP.GuestCode =PA.GuestCode AND PA.CheckOut ='N' UNION SELECT PP.GuestCode FROM Guest PP WHERE PP.RegNo =:as_regno AND dbo.fn_GetPreference ( 'allowedGuestsintransaction' ) ='X' AND PP.Active ='Y' AND PP.GuestCode NOT IN ( SELECT DISTINCT PA.GuestCode FROM GuestCheckIn PA WHERE PA.CheckOut ='Y' ) ) USING sqlca;
	if sqlca.sqlcode = 0 then
		return true
	end if
	return false

// w_fee_voucher.wf_validate_studentregno(string as_regno, long al_studentcode, long al_acccode) returns boolean
	SQL SELECT Studentcode , CustCode INTO :al_studentcode, :al_acccode FROM Student WHERE regno =:as_regno AND Studentcode in ( SELECT PP.StudentCode FROM Student PP WHERE PP.RegNo =:as_regno AND dbo.fn_GetPreference ( 'allowedStudentsintransaction' ) ='A' UNION SELECT PP.StudentCode FROM Student PP , StudentClass PA , Class C WHERE PP.RegNo =:as_regno AND dbo.fn_GetPreference ( 'allowedStudentsintransaction' ) ='D' AND PP.StudentCode =PA.StudentCode AND PA.ClassCode =C.ClassCode AND C.Active ='Y' ) USING sqlca;
	if sqlca.sqlcode = 0 then
		return true
	end if
	return false

// w_fee_voucher.wf_search_student_receivables() returns long
	string ls_regno
	long ll_res
	long ll_null
	long ll_rowcount
	long ll_rtcode
	long ll_retrievecount
	long ll_lockedcount
	string ls_fullcode
	long ll_detailrows
	long ll_count
	long ll_duplrows
	long ll_invcode
	long ll_row
	integer li_result
	integer li_rtncode
	s_arguements ls_arguements
	datastore lds_invselected
	if wf_iseditable() = false then
		return 0
	end if
	if this.is_invoicebased = "N" then
		return 0
	end if
	setnull(ll_null)
	open(w_studentsearch)
	ls_arguements = message.powerobjectparm
	if ls_arguements.i_status = 1 then
		if this.id_detail.rowcount() > 0 and (isnull(this.id_detail.object.acccode[this.id_detail.rowcount()]) or this.id_detail.object.acccode[this.id_detail.rowcount()] <= 0) then
			triggerevent("ue_deleteitem")
		end if
		openwithparm(w_studentsearchresult, ls_arguements)
		ls_arguements = message.powerobjectparm
		if ls_arguements.i_status = 1 and ls_arguements.l_code1 > 0 then
			lds_invselected = create datastore
			lds_invselected.dataobject = "d_student_outstanding_service"
			lds_invselected.settransobject(this.it_transobject)
			lds_invselected.retrieve(ls_arguements.l_code1)
			ll_rowcount = lds_invselected.rowcount()
			if ll_rowcount > 0 then
				for ll_count = 1 to ll_rowcount
					ll_invcode = lds_invselected.object.invcode[ll_count]
					ll_row = this.id_detail.insertrow(0)
					if wf_validateinvcode(ll_row, ll_invcode) = 0 then
						if this.is_jv = "N" then
							if this.is_detailtreatment = "D" then
								this.id_detail.setitem(ll_row, "debit", this.id_detail.getitemnumber(ll_row, "outstandingamt"))
							else
								this.id_detail.setitem(ll_row, "credit", this.id_detail.getitemnumber(ll_row, "outstandingamt"))
							end if
						elseif this.is_invoicetype = "Sale" or this.is_invoicetype = "Sale of Service" then
							this.id_detail.setitem(ll_row, "debit", this.id_detail.getitemnumber(ll_row, "outstandingamt"))
						elseif this.is_invoicetype = "Purchase" or this.is_invoicetype = this.isc_svc_pur then
							this.id_detail.setitem(ll_row, "credit", this.id_detail.getitemnumber(ll_row, "outstandingamt"))
						end if
						this.id_detail.object.chkno[ll_row] = this.id_master.object.chkno[1]
						if this.id_detail.object.remarks[ll_row] = "" or isnull(this.id_detail.object.remarks[ll_row]) then
							this.id_detail.object.remarks[ll_row] = this.id_master.object.remarks[1]
						end if
						ll_retrievecount = ll_retrievecount + 1
					else
						this.id_detail.deleterow(ll_row)
					end if
				next
				if ll_retrievecount = ll_rowcount then
					messagebox("Result", string(ll_rowcount) + " Invoices are populated. ")
				else
					messagebox("Result", "Total invoices were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " invoices populated successfully~n~r" + string(ll_duplrows) + " invoices are not populated successfully~n~r" + string(ll_lockedcount) + " records are in error")
				end if
			end if
			destroy lds_invselected
		end if
	end if
	this.id_detail.accepttext()
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	return 0

// w_fee_voucher.wf_show_student_fine_waiver() returns long
	long ll_retcode
	long ll_invcode
	if this.id_detail.rowcount() > 0 and this.id_detail.getrow() > 0 and this.id_detail.object.invoicecode[this.id_detail.getrow()] > 0 then
		ll_invcode = this.id_detail.object.invoicecode[this.id_detail.getrow()]
		openwithparm(w_student_fine_waiver, ll_invcode)
		ll_retcode = message.doubleparm
		if ll_retcode = 1 then
			wf_validateinvcode(this.id_detail.getrow(), ll_invcode)
			wf_setinvoicedetail(ll_invcode, this.id_detail.getrow())
		end if
	end if
	return 0

// w_fee_voucher.wf_show_studentledger() returns 0
	long ll_studentcode
	if this.id_detail.rowcount() > 0 and this.id_detail.getrow() > 0 then
		ll_studentcode = this.id_detail.object.studentcode[this.id_detail.getrow()]
	end if
	if not isnull(ll_studentcode) and ll_studentcode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_student_ledger, ll_studentcode)
	end if

// w_fee_voucher.wf_validate_headercashaccount() returns long
	long ll_acccode
	long ll_headeracccode
	long ll_subcode
	long ll_count
	ll_acccode = this.id_master.object.acccode[1]
	SQL SELECT ISNULL ( MAX ( SubCode ) , - 1 ) INTO :ll_subcode FROM Accounts WHERE AccCode =:ll_acccode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_subcode = 2 then
			SQL SELECT ISNULL ( COUNT ( SubAccCode ) , 0 ) INTO :ll_count FROM VocherCategoryHeader WHERE VochCatCode =:this.ii_vouchertype AND SubAccCode =:ll_subcode USING this.it_transobject;
			if ll_count > 0 and this.it_transobject.sqlcode = 0 then
				SQL SELECT ISNULL ( MAX ( CashAccCode ) , - 1 ) INTO :ll_headeracccode FROM GroupCashAccount WHERE GroupCode =:this.il_groupcode AND CashAccCode =:ll_acccode USING this.it_transobject;
				if this.it_transobject.sqlcode = 0 then
					if ll_headeracccode = ll_acccode then
						return 0
					else
						messagebox("Cash Account Validation", "Selected Cash Account does not meet your group wise cash account setting~r~nPlease enter some other valid cash account", stopsign!)
						return 1
					end if
				else
					messagebox("Cash Account Validation", "Error Fetching group wise cash account setting~r~nDetails Are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
					return 1
				end if
			else
				return 0
			end if
		else
			return 0
		end if
		return
	end if
	messagebox("Cash Account Validation", "Error Fetching group wise cash account setting~r~nDetails Are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
	return 1

// w_fee_voucher.wf_populate_student_outstandings(long al_studentcode) returns long
	string ls_regno
	long ll_res
	long ll_null
	long ll_rowcount
	long ll_rtcode
	long ll_retrievecount
	long ll_lockedcount
	long ll_unpostedtrans
	string ls_fullcode
	string ls_msg
	long ll_detailrows
	long ll_count
	long ll_duplrows
	long ll_invcode
	long ll_row
	integer li_result
	integer li_rtncode
	integer li_errcode
	datastore lds_invselected
	if al_studentcode <= 0 or isnull(al_studentcode) then
		return 0
	end if
	setnull(ll_null)
	if this.id_detail.rowcount() > 0 and (isnull(this.id_detail.object.acccode[this.id_detail.rowcount()]) or this.id_detail.object.acccode[this.id_detail.rowcount()] <= 0) then
		triggerevent("ue_deleteitem")
	end if
	lds_invselected = create datastore
	lds_invselected.dataobject = "d_student_outstanding_service"
	lds_invselected.settransobject(this.it_transobject)
	lds_invselected.retrieve(al_studentcode)
	ll_rowcount = lds_invselected.rowcount()
	if ll_rowcount > 0 then
		this.id_master.object.feecomment[1] = lds_invselected.object.feecomment[1]
		this.id_master.object.fnic[1] = lds_invselected.object.fnic[1]
		this.id_master.object.classcode[1] = lds_invselected.object.classcode[1]
		for ll_count = 1 to ll_rowcount
			ll_invcode = lds_invselected.object.invcode[ll_count]
			ll_row = this.id_detail.insertrow(0)
			if wf_validateinvcode(ll_row, ll_invcode) = 0 then
				if this.is_invoicetype = "Sale" then
					this.it_transobject.checkunpostedsaleinvintransactions(ll_invcode, this.id_master.object.code[this.id_master.rowcount()], "V", ll_unpostedtrans, ls_msg)
				elseif this.is_invoicetype = "Sale of Service" then
					this.it_transobject.checkunpostedserviceinvintransactions(ll_invcode, this.id_master.object.code[this.id_master.rowcount()], "V", ll_unpostedtrans, ls_msg)
				elseif this.is_invoicetype = this.isc_svc_pur then
					this.it_transobject.checkunpostedservicepurinvintransactions(ll_invcode, this.id_master.object.code[this.id_master.rowcount()], "V", ll_unpostedtrans, ls_msg)
				elseif this.is_invoicetype = "Purchase" then
					this.it_transobject.checkunpostedpurinvintransactions(ll_invcode, this.id_master.object.code[this.id_master.rowcount()], "V", ll_unpostedtrans, ls_msg)
				end if
				if ll_unpostedtrans > 0 then
					messagebox("Invoice Validation Problem", "Unposted Transaction(s) Exist for this Invoice~r~n~r~n" + trim(ls_msg))
					li_errcode = 1
					this.id_detail.deleterow(ll_row)
				else
					if this.is_jv = "N" then
						if this.is_detailtreatment = "D" then
							this.id_detail.setitem(ll_row, "debit", this.id_detail.getitemnumber(ll_row, "outstandingamt"))
						else
							this.id_detail.setitem(ll_row, "credit", this.id_detail.getitemnumber(ll_row, "outstandingamt"))
						end if
					elseif this.is_invoicetype = "Sale" or this.is_invoicetype = "Sale of Service" then
						this.id_detail.setitem(ll_row, "debit", this.id_detail.getitemnumber(ll_row, "outstandingamt"))
					elseif this.is_invoicetype = "Purchase" or this.is_invoicetype = this.isc_svc_pur then
						this.id_detail.setitem(ll_row, "credit", this.id_detail.getitemnumber(ll_row, "outstandingamt"))
					end if
					this.id_detail.object.chkno[ll_row] = this.id_master.object.chkno[1]
					if this.id_detail.object.remarks[ll_row] = "" or isnull(this.id_detail.object.remarks[ll_row]) then
						this.id_detail.object.remarks[ll_row] = this.id_master.object.remarks[1]
					end if
					ll_retrievecount = ll_retrievecount + 1
				end if
			else
				this.id_detail.deleterow(ll_row)
			end if
		next
	end if
	destroy lds_invselected
	this.id_detail.accepttext()
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	return 0

