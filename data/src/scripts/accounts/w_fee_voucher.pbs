// w_fee_voucher.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_feevoucher" then
		this.menuid = create m_feevoucher
	end if
	this.dw_voucherrep = create dw_voucherrep
	this.dw_vocherdetail = create dw_vocherdetail
	this.dw_coucherreceipt = create dw_coucherreceipt
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_voucherrep
	this.control[icurrent + 2] = this.dw_vocherdetail
	this.control[icurrent + 3] = this.dw_coucherreceipt

// w_fee_voucher.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_voucherrep
	destroy this.dw_vocherdetail
	destroy this.dw_coucherreceipt

// w_fee_voucher.ue_newform() returns 0 [event]
	integer li_rtncode
	long li_fetched_code
	long row
	long ll_manfcode
	m_feevoucher lm_menu
	call super::ue_newform
	lm_menu = this.menuid
	setredraw(false)
	SQL rollback USING sqlca;
	sqlca.virtualgl("A")
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
	else
		SQL rollback USING sqlca;
	end if
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	if f_rightexists(5266) then
		this.id_detail.object.debit.protect = 1
		this.id_detail.object.credit.protect = 1
	end if
	this.ib_modify = false
	lm_menu.m_file.m_saveandpost.enabled = this.ib_saveandpost
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_print.enabled = true
	setredraw(true)
	if not wf_validatedate() then
	end if
	if this.idc_dddwheaderaccount.rowcount() > 0 then
		if isnull(this.ll_last_headeracc) then
			this.id_master.object.acccode[1] = this.idc_dddwheaderaccount.getitemnumber(1, "acccode")
		else
			this.id_master.object.acccode[1] = this.ll_last_headeracc
		end if
	end if
	this.id_master.setcolumn("studentregno")
	this.id_master.setfocus()
	if this.id_master.object.code[1] > 0 then
		return
	end if
	if this.id_detail.rowcount() = 1 then
		this.id_detail.deleterow(0)
	end if

// w_fee_voucher.ue_save() returns 0 [event]
	long ll_detailrows
	long ll_mastercurrrow
	long ll_invid
	long ll_vouchercode
	long ll_acccode
	long ll_salesmancode = 1
	long ll_errrowid
	long ll_null
	long ll_tmpcode
	long ll_headeracccode
	integer li_counter
	integer li_maxretcode
	integer li_vouchretcode
	double ld_debit
	double ld_credit
	double ld_currbalance
	string ls_remarks
	string ls_chkno
	string ls_errtext
	boolean lb_commitflag = true
	boolean lb_continue = true
	integer li_null
	datetime ldt_server_datetime
	string ls_date_errtext
	unsignedlong ul_firstutn
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	setnull(li_null)
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if this.ib_modify = false and this.i_editmode = 2 then
		messagebox("Processing Problem", "Please Close the Module and try again!")
		return
	end if
	wf_deleteemptydetailrow()
	this.id_master.accepttext()
	this.id_detail.accepttext()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	ll_tmpcode = wf_check_unique_refno()
	if ll_tmpcode > 0 then
		messagebox("Reference No Validation!", "Duplicate Reference No. is not Allowed!", stopsign!)
		this.id_detail.setrow(ll_tmpcode)
		this.id_detail.setcolumn("chkno")
		return
	end if
	wf_deleteallemptydetailrows()
	if this.id_detail.rowcount() <= 0 then
		return
	end if
	if this.is_invoicebased = "Y" and isnull(this.id_detail.getitemnumber(this.il_currrow, "invoicecode")) then
		messagebox("Invoice Code Validation", "Please select Valid Invoice Code")
		this.id_detail.setcolumn("invoicecode")
		this.id_detail.scrolltorow(this.il_currrow)
		return
	end if
	if this.id_detail.getitemnumber(this.il_currrow, "debit") < 1.0 and this.id_detail.getitemnumber(this.il_currrow, "credit") < 1.0 then
		messagebox("Amount Validation", "Please Enter Valid Amount")
		if this.is_jv = "Y" then
			if this.id_detail.getitemnumber(this.il_currrow, "debit") < 1.0 then
				this.id_detail.setcolumn("debit")
			else
				this.id_detail.setcolumn("credit")
			end if
		elseif this.is_detailtreatment = "D" then
			this.id_detail.setcolumn("debit")
		else
			this.id_detail.setcolumn("credit")
		end if
		this.id_detail.scrolltorow(this.il_currrow)
		return
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		for li_counter = 1 to ll_detailrows
			if this.id_detail.getitemdecimal(li_counter, "debit") = 0 and this.id_detail.getitemdecimal(li_counter, "credit") = 0 then
				if this.is_detailtreatment = "D" then
					this.id_detail.setcolumn("debit")
				else
					this.id_detail.setcolumn("credit")
				end if
				this.id_detail.scrolltorow(li_counter)
				messagebox("Amount Validation", "Please Enter Valid Amount")
				return
			end if
			if this.is_jv = "Y" then
				if round(this.id_detail.getitemdecimal(this.id_detail.getrow(), "c_creditamtsum"), 2) <> round(this.id_detail.getitemdecimal(this.id_detail.getrow(), "c_debitamtsum"), 2) then
					messagebox("Error !!!", "Sum of Credit and Debit should be equal")
					this.id_detail.setcolumn("debit")
					this.id_detail.scrolltorow(this.il_currrow)
					return
				end if
				if this.id_detail.getitemdecimal(li_counter, "debit") > 0 and this.id_detail.getitemdecimal(li_counter, "credit") > 0 then
					this.id_detail.setcolumn("debit")
					this.id_detail.scrolltorow(li_counter)
					messagebox("Amount Validation", "Please Enter Amount in Either Debit Or Credit Column")
					return
				end if
			else
				if this.id_detail.getitemdecimal(li_counter, "debit") > 0 and this.id_detail.getitemdecimal(li_counter, "credit") > 0 then
					if this.is_detailtreatment = "D" then
						this.id_detail.setcolumn("debit")
					else
						this.id_detail.setcolumn("credit")
					end if
					this.id_detail.scrolltorow(li_counter)
					messagebox("Amount Validation", "Please Enter Valid Amount")
					return
				end if
				if this.id_detail.getitemnumber(li_counter, "acccode") = this.id_master.getitemnumber(1, "acccode") then
					this.id_detail.setcolumn("acccode")
					this.id_detail.scrolltorow(li_counter)
					messagebox("Account Validation", "Duplicate Account!~r Already Selected in Header Window")
					return
				end if
			end if
		next
	end if
	if wf_validate_headercashaccount() <> 0 then
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("Transuserwindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	setfocus()
	ll_mastercurrrow = this.id_master.getrow()
	if f_stringpreferences("askdateintrans") = "N" then
		if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			return
		end if
	else
		ldt_server_datetime = this.id_master.object.date[ll_mastercurrrow]
	end if
	if ll_salesmancode > 0 then
		setpointer(hourglass!)
		ll_mastercurrrow = this.id_master.getrow()
		this.ll_last_headeracc = this.id_master.object.acccode[ll_mastercurrrow]
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		ldt_server_datetime = this.id_master.object.date[ll_mastercurrrow]
		this.id_master.setitem(ll_mastercurrrow, "vochcatcode", this.ii_vouchertype)
		if isnull(ll_invid) then
			li_maxretcode = wf_tabnewid("glheader", ll_invid)
			if li_maxretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~n ~t~t~t~t~t~t~t~t~t~t~t~t~tgenerating GL Voucher Code")
				return
			end if
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
		end if
		ll_vouchercode = this.id_master.getitemnumber(ll_mastercurrrow, "vouchercode")
		if isnull(ll_vouchercode) or ll_vouchercode = 0 then
			li_vouchretcode = wf_getnewvouchercode(this.ii_vouchertype, ll_vouchercode, this.it_transobject)
			if li_vouchretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~n ~t~t~t~t~t~t~t~t~t~t~t~t~tgenerating Voucher Code")
				return
			end if
			if ll_vouchercode > 0 then
				this.id_master.setitem(ll_mastercurrrow, "vouchercode", ll_vouchercode)
			end if
		end if
		if f_stringpreferences("askdateintrans") = "N" then
			if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
				SQL rollback USING this.it_transobject;
				if this.ib_modify = false then
					setnull(ll_null)
					this.id_master.setitem(1, "Code", ll_null)
					this.id_master.setitem(1, "VoucherCode", ll_null)
				end if
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
		else
			ldt_server_datetime = this.id_master.object.date[ll_mastercurrrow]
		end if
		if this.ib_modify then
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			if lb_continue then
				lb_continue = wf_returnvoucher(ll_invid, ls_errtext)
			end if
		else
			this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
		end if
		if lb_continue then
			this.id_vocherdetail.reset()
			if not wf_populatedetail(ll_invid, this.id_vocherdetail, ls_errtext, ll_errrowid) then
				lb_continue = false
				this.id_detail.scrolltorow(ll_errrowid)
				this.id_detail.setfocus()
			else
				this.id_detail = this.id_vocherdetail
				call super::ue_save
				this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
				this.id_vocherdetail.reset()
				if this.ib_commitok then
					this.ib_modify = false
					if this.ic_autoposting = "Y" then
						wf_post(ll_salesmancode, ll_invid)
					end if
				elseif this.ib_modify = false then
					setnull(ll_null)
					this.id_master.setitem(1, "Code", ll_null)
					this.id_master.setitem(1, "VoucherCode", ll_null)
					this.id_master.accepttext()
				end if
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			if this.ib_modify = false then
				setnull(ll_null)
				this.id_master.setitem(1, "Code", ll_null)
				this.id_master.setitem(1, "VoucherCode", ll_null)
				this.id_master.accepttext()
			end if
			this.id_detail.scrolltorow(ll_errrowid)
			this.id_detail.setfocus()
			messagebox("Updation Error", ls_errtext + " in current row", stopsign!)
		elseif f_stringpreferences("IncVochInActMonitor") = "Y" then
			this.it_transobject.updateactivitymonitor("VV", ll_invid)
			if this.it_transobject.sqlcode <> 0 then
				lb_continue = false
				SQL rollback USING this.it_transobject;
				messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
			else
				SQL commit USING this.it_transobject;
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_fee_voucher.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect = 1
	long ll_row
	long ll_vouchcode
	long ll_counter
	string ls_remarks
	string ls_chkno
	m_feevoucher lm_menu
	call super::ue_detail
	lm_menu = this.menuid
	setredraw(false)
	ll_vouchcode = this.id_master.getitemnumber(1, "code")
	SQL select remarks , chkno INTO :ls_remarks, :ls_chkno from glheader where glvochcode =:ll_vouchcode USING this.it_transobject;
	if wf_isvoucherinuse(ll_vouchcode) = true then
		messagebox("Voucher Validation", "Voucher already in use by some other user.~r~nKindly try again after sometime or open some other voucher.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	wf_initmodify(li_protect)
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if this.id_master.object.posted[this.id_master.rowcount()] = "Y" then
		this.id_master.modify("date" + ".Protect=1")
	else
		lm_menu.m_file.m_saveandpost.enabled = this.ib_saveandpost
	end if
	this.id_master.setitem(1, "remarks", ls_remarks)
	this.id_master.setitem(1, "chkno", ls_chkno)
	this.im_menu.m_file.m_post.enabled = false
	setredraw(true)

// w_fee_voucher.ue_newitem() returns 0 [event]
	integer li_null
	long ll_rowcount
	string ls_temp
	setnull(li_null)
	ll_rowcount = this.id_detail.rowcount()
	this.id_detail.accepttext()
	if ll_rowcount > 0 then
		if this.is_invoicebased = "Y" then
			if isnull(this.id_detail.getitemnumber(ll_rowcount, "invoicecode")) then
				messagebox("Invoice Code Validation", "Please select Invoice Code")
				this.id_detail.setcolumn("invoicecode")
				this.id_detail.scrolltorow(ll_rowcount)
				return
			end if
		elseif isnull(this.id_detail.getitemnumber(ll_rowcount, "acccode")) then
			messagebox("Account Validation", "Please select Valid Account")
			this.id_detail.setcolumn("acccode")
			this.id_detail.scrolltorow(ll_rowcount)
			return
		end if
		return
	end if
	if this.is_jv = "Y" then
		if ll_rowcount > 0 then
			if this.is_invoicebased = "Y" then
				if this.id_detail.object.credit[this.id_detail.getrow()] < 1 and this.id_detail.object.debit[this.id_detail.getrow()] < 1 then
					messagebox("Amount Validation", "Enter some valid Amount")
					return
				elseif this.id_detail.object.credit[this.id_detail.getrow()] > 0 and this.id_detail.object.debit[this.id_detail.getrow()] > 0 then
					messagebox("Amount Validation", "Enter some valid Amount")
					return
				end if
			elseif this.id_detail.object.credit[this.id_detail.getrow()] < 1 and this.id_detail.object.debit[this.id_detail.getrow()] < 1 then
				messagebox("Amount Validation", "Enter some valid value for credit or debit field")
				this.id_detail.setcolumn("debit")
				return
			elseif this.id_detail.object.credit[this.id_detail.getrow()] > 0 and this.id_detail.object.debit[this.id_detail.getrow()] > 0 then
				messagebox("Amount Validation", "Either debit or credit field must be zero")
				this.id_detail.setcolumn("debit")
				return
			end if
			return
		end if
	elseif ll_rowcount > 0 then
		if this.id_detail.object.credit[this.id_detail.getrow()] < 1 and this.id_detail.object.debit[this.id_detail.getrow()] < 1 then
			messagebox("Amount Validation", "Enter some valid amount")
			this.id_detail.scrolltorow(ll_rowcount)
			if this.is_detailtreatment = "D" then
				this.id_detail.setcolumn("debit")
			else
				this.id_detail.setcolumn("credit")
			end if
			this.id_detail.scrolltorow(ll_rowcount)
			return
		elseif this.id_detail.object.credit[this.id_detail.getrow()] > 0 and this.id_detail.object.debit[this.id_detail.getrow()] > 0 then
			messagebox("Amount Validation", "Enter Valid Amount")
			if this.is_detailtreatment = "D" then
				this.id_detail.setcolumn("debit")
			else
				this.id_detail.setcolumn("credit")
			end if
			this.id_detail.scrolltorow(ll_rowcount)
			return
		end if
		return
	end if
	if this.ib_itemvalidated = false then
		this.ib_itemvalidated = true
		messagebox("Account Validation", "Duplicate Account, Please select some other")
		this.id_detail.setcolumn("acccode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.acccode[this.il_currrow] = li_null
		return
	end if
	if this.ib_invnovalidated = false then
		messagebox("Invoice No Validation", "Duplicate Invoice No, Please enter some other")
		this.ib_invnovalidated = true
		this.id_detail.setcolumn("invoicecode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.invoicecode[this.il_currrow] = li_null
		return
	end if
	this.im_menu.m_file.m_print.enabled = true
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	if this.is_invoicebased = "N" then
		if f_stringpreferences("StudentInTransaction") <> "N" then
			this.id_detail.setcolumn("studentregno")
		end if
	else
		this.id_detail.setcolumn("invoicecode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	if this.id_detail.getrow() > 1 and this.id_detail.rowcount() > 1 then
		this.id_detail.setitem(this.id_detail.getrow(), "remarks", this.id_detail.getitemstring(this.id_detail.rowcount() - 1, "remarks"))
		if f_stringpreferences("AutoRefNoInTrans") = "Y" then
			ls_temp = trim(this.id_detail.getitemstring(this.id_detail.rowcount() - 1, "chkno"))
			if isnumber(ls_temp) then
				this.id_detail.setitem(this.id_detail.getrow(), "chkno", trim(string(long(ls_temp) + 1)))
			else
				this.id_detail.setitem(this.id_detail.getrow(), "chkno", this.id_detail.getitemstring(this.id_detail.rowcount(), "chkno"))
			end if
		else
			this.id_detail.setitem(this.id_detail.getrow(), "chkno", this.id_detail.getitemstring(this.id_detail.rowcount() - 1, "chkno"))
		end if
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.ib_validatefullcode = true

// w_fee_voucher.ue_refreshddw() returns 0 [event]
	setpointer(hourglass!)
	SQL rollback USING sqlca;
	sqlca.virtualgl("A")
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
	else
		SQL rollback USING sqlca;
	end if
	this.idc_dddwheaderaccount.setredraw(false)
	this.idc_dddwheaderaccount.settransobject(this.it_transobject)
	this.idc_dddwheaderaccount.reset()
	this.idc_dddwheaderaccount.retrieve(this.ii_vouchertype)
	this.idc_dddwheaderaccount.setredraw(true)
	this.idc_dddwdetailstudent.setredraw(false)
	this.idc_dddwdetailstudent.settransobject(this.it_transobject)
	this.idc_dddwdetailstudent.reset()
	this.idc_dddwdetailstudent.retrieve()
	this.idc_dddwdetailstudent.setredraw(true)
	setpointer(arrow!)

// w_fee_voucher.ue_list() returns 0 [event]
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.ib_modify = false
	this.im_menu.m_file.m_post.enabled = true

// w_fee_voucher.ue_postopen() returns 0 [event]
	long ll_counter
	long ll_code
	long ll_found
	long ll_entryformat
	integer li_rtncode
	datawindowchild ldc_dddpurcategory
	m_feevoucher lm_menu
	call super::ue_postopen
	ll_code = message.doubleparm
	lm_menu = this.menuid
	setredraw(false)
	wf_setvouchertype(ll_code)
	SQL rollback USING sqlca;
	sqlca.virtualgl("A")
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
	else
		SQL rollback USING sqlca;
	end if
	this.title = this.is_vouchercategoryname
	this.dw_vocherdetail.dataobject = "d_VoucherDetail_hidden"
	this.id_vocherdetail = this.dw_vocherdetail
	this.id_vocherdetail.settransobject(this.it_transobject)
	wf_initglobalconstants()
	li_rtncode = this.id_master.getchild("acccode", this.idc_dddwheaderaccount)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a master DataWindowChild")
		close(this)
		return
	end if
	this.idc_dddwheaderaccount.settransobject(this.it_transobject)
	this.idc_dddwheaderaccount.retrieve(this.ii_vouchertype)
	li_rtncode = this.id_detail.getchild("studentcode", this.idc_dddwdetailstudent)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a detail DataWindowChild")
		close(this)
		return
	end if
	this.idc_dddwdetailstudent.settransobject(this.it_transobject)
	this.idc_dddwdetailstudent.retrieve()
	this.id_detail.object.studentregno.visible = true
	this.id_detail.object.studentregno_t.visible = true
	this.id_detail.object.studentcode.visible = true
	this.id_detail.object.studentcode_t.visible = true
	wf_setvouchercategorysettings()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.im_menu.m_file.m_print.visible = true
	this.ib_editing = false
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5079", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_searchstudentreceivables.visible = true
		lm_menu.m_file.m_searchstudentreceivables.enabled = true
	else
		lm_menu.m_file.m_searchstudentreceivables.visible = false
		lm_menu.m_file.m_searchstudentreceivables.enabled = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 622", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_saveandpost = true
	end if
	if not f_rightexists(5264) then
		lm_menu.m_file.m_showstudentfinewaiver.visible = false
		lm_menu.m_file.m_showstudentfinewaiver.enabled = false
	end if
	if not f_rightexists(5265) then
		lm_menu.m_file.m_populatestudentreceivables.visible = false
		lm_menu.m_file.m_populatestudentreceivables.enabled = false
	end if
	lm_menu.m_file.m_saveandpost.visible = this.ib_saveandpost
	lm_menu.m_file.m_saveandpost.toolbaritemvisible = this.ib_saveandpost
	lm_menu.m_file.m_saveandpost.enabled = this.ib_saveandpost
	this.il_groupcode = f_getgroupcode(gl_usercode)
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 565", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_showtransactioninlist = true
	else
		this.ib_showtransactioninlist = false
	end if
	setredraw(true)
	setnull(this.ll_last_headeracc)

// w_fee_voucher.ue_print() returns 0 [event]
	long ll_code
	long ll_counter
	long ll_rowcount
	integer li_option
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_code) or ll_code <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_code = this.id_master.getitemnumber(1, "code")
	end if
	wf_selectprintout()
	ll_rowcount = this.dw_voucherrep.retrieve(ll_code)
	if lb_listtab then
		lstr.dw = this.dw_voucherrep
		lstr.s_name1 = this.dw_voucherrep.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if ll_rowcount > 0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.dw_voucherrep.printcancel()
		end if
		if this.dw_voucherrep.print() < 0 then
			messagebox("Printing", "Can not Print Voucher", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Voucher,~r~nNo rows are retrieved", information!)

// w_fee_voucher.ue_deleteitem() returns 0 [event]
	call super::ue_deleteitem
	if this.id_detail.rowcount() <= 0 then
		this.im_menu.m_file.m_print.enabled = false
	end if

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_errcode
	long ll_acccode
	long ll_studentcode
	string ls_fullcode
	string ls_regno
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "studentregno"
		if not isnull(data) and data <> "" then
			if parent.parent.parent.wf_validate_studentregno(data, ll_studentcode, ll_acccode) then
				setitem(row, "studentcode", ll_studentcode)
				if ll_studentcode > 0 then
					settaborder("studentcode", 0)
					parent.parent.parent.wf_populate_student_outstandings(ll_studentcode)
				end if
			else
				messagebox("Reg. No Validation", "Reg. No. ~"" + data + "~" is not valid")
				ll_errcode = 1
			end if
		elseif isnull(data) or data = "" then
			settaborder("studentcode", 40)
		end if
	case "studentcode"
		if not isnull(data) and data <> "" then
			if parent.parent.parent.wf_validatestudent(long(data), ls_regno, ll_acccode) then
				ll_studentcode = long(data)
				setitem(row, "studentregno", ls_regno)
				if ll_studentcode > 0 then
					parent.parent.parent.wf_populate_student_outstandings(ll_studentcode)
				end if
			else
				messagebox("Student Validation", "Please enter valid Student")
				ll_errcode = 1
			end if
		end if
	end choose
	return ll_errcode

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	double ld_newamt
	double ld_storedamt
	double ld_amt
	long ll_acccode
	long ll_patientcode
	long ll_guestcode
	long ll_studentcode
	long ll_rowno
	long ll_unpostedtrans
	long ll_null
	integer li_errcode
	integer li_hold
	string ls_fullcode
	string ls_regno
	string ls_msg
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	ls_msg = "000                                                                                                                                 "
	setnull(ll_null)
	choose case dwo.name
	case "acccode"
		parent.parent.parent.ib_itemvalidated = true
		if parent.parent.parent.wf_getfullcode(long(data), ls_fullcode) = 1 then
			this.object.fullcode[row] = ls_fullcode
			setnull(ll_patientcode)
			setnull(ls_regno)
			this.object.patientcode[row] = ll_null
			this.object.guestcode[row] = ll_null
			this.object.studentcode[row] = ll_null
			this.object.regno[row] = ls_regno
			this.object.guestregno[row] = ""
			this.object.studentregno[row] = ""
			parent.parent.parent.wf_setbalance(long(data), row)
		else
			messagebox("Account Name Validation", "Please Select Valid Account Name")
			li_errcode = 1
			this.object.fullcode[row] = ""
		end if
	case "invoicecode"
		li_errcode = parent.parent.parent.wf_validateinvcode(row, long(data))
		if li_errcode = 0 then
			if parent.parent.parent.is_invoicetype = "Sale" then
				parent.parent.parent.it_transobject.checkunpostedsaleinvintransactions(long(data), parent.parent.parent.id_master.object.code[parent.parent.parent.id_master.rowcount()], "V", ll_unpostedtrans, ls_msg)
			elseif parent.parent.parent.is_invoicetype = "Sale of Service" then
				parent.parent.parent.it_transobject.checkunpostedserviceinvintransactions(long(data), parent.parent.parent.id_master.object.code[parent.parent.parent.id_master.rowcount()], "V", ll_unpostedtrans, ls_msg)
			elseif parent.parent.parent.is_invoicetype = parent.parent.parent.isc_svc_pur then
				parent.parent.parent.it_transobject.checkunpostedservicepurinvintransactions(long(data), parent.parent.parent.id_master.object.code[parent.parent.parent.id_master.rowcount()], "V", ll_unpostedtrans, ls_msg)
			elseif parent.parent.parent.is_invoicetype = "Purchase" then
				parent.parent.parent.it_transobject.checkunpostedpurinvintransactions(long(data), parent.parent.parent.id_master.object.code[parent.parent.parent.id_master.rowcount()], "V", ll_unpostedtrans, ls_msg)
			end if
			if ll_unpostedtrans > 0 then
				messagebox("Invoice Validation Problem", "Unposted Transaction(s) Exist for this Invoice~r~n~r~n" + trim(ls_msg))
				li_errcode = 1
			end if
		end if
	case "regno"
		if not isnull(data) and data <> "" then
			ll_acccode = this.object.acccode[row]
			if parent.parent.parent.wf_validateregno(data, ll_patientcode, ll_acccode) then
				setitem(row, "patientcode", ll_patientcode)
				this.object.acccode[row] = ll_acccode
				parent.parent.parent.wf_getfullcode(ll_acccode, ls_fullcode)
				this.object.fullcode[row] = ls_fullcode
			else
				messagebox("Reg. No Validation", "Reg. No. ~"" + data + "~" is not valid")
				li_errcode = 1
			end if
		end if
	case "patientcode"
		if not isnull(data) and data <> "" then
			ll_acccode = this.object.acccode[row]
			if parent.parent.parent.wf_validatepatient(long(data), ls_regno, ll_acccode) then
				setitem(row, "regno", ls_regno)
				this.object.acccode[row] = ll_acccode
				parent.parent.parent.wf_getfullcode(ll_acccode, ls_fullcode)
				this.object.fullcode[row] = ls_fullcode
			else
				messagebox("Patient Validation", "Please enter valid patient")
				li_errcode = 1
			end if
		end if
	case "guestregno"
		if not isnull(data) and data <> "" then
			ll_acccode = this.object.acccode[row]
			if parent.parent.parent.wf_validate_guestregno(data, ll_guestcode, ll_acccode) then
				setitem(row, "guestcode", ll_guestcode)
				this.object.acccode[row] = ll_acccode
				parent.parent.parent.wf_getfullcode(ll_acccode, ls_fullcode)
				this.object.fullcode[row] = ls_fullcode
			else
				messagebox("Reg. No Validation", "Reg. No. ~"" + data + "~" is not valid")
				li_errcode = 1
			end if
		end if
	case "guestcode"
		if not isnull(data) and data <> "" then
			ll_acccode = this.object.acccode[row]
			if parent.parent.parent.wf_validateguest(long(data), ls_regno, ll_acccode) then
				setitem(row, "guestregno", ls_regno)
				this.object.acccode[row] = ll_acccode
				parent.parent.parent.wf_getfullcode(ll_acccode, ls_fullcode)
				this.object.fullcode[row] = ls_fullcode
			else
				messagebox("Guest Validation", "Please enter valid Guest")
				li_errcode = 1
			end if
		end if
	case "studentregno"
		if not isnull(data) and data <> "" then
			ll_acccode = this.object.acccode[row]
			if parent.parent.parent.wf_validate_studentregno(data, ll_studentcode, ll_acccode) then
				setitem(row, "studentcode", ll_studentcode)
				this.object.acccode[row] = ll_acccode
				parent.parent.parent.wf_getfullcode(ll_acccode, ls_fullcode)
				this.object.fullcode[row] = ls_fullcode
			else
				messagebox("Reg. No Validation", "Reg. No. ~"" + data + "~" is not valid")
				li_errcode = 1
			end if
		end if
	case "studentcode"
		if not isnull(data) and data <> "" then
			ll_acccode = this.object.acccode[row]
			if parent.parent.parent.wf_validatestudent(long(data), ls_regno, ll_acccode) then
				setitem(row, "studentregno", ls_regno)
				this.object.acccode[row] = ll_acccode
				parent.parent.parent.wf_getfullcode(ll_acccode, ls_fullcode)
				this.object.fullcode[row] = ls_fullcode
			else
				messagebox("Student Validation", "Please enter valid Student")
				li_errcode = 1
			end if
		end if
	case "debit"
		ld_newamt = double(data)
		ld_storedamt = getitemdecimal(row, "debit")
		if ld_newamt < 0.0 then
			messagebox("Amount Validation", "Amount ~"" + data + "~" should be greater than zero")
			li_errcode = 1
		end if
		if li_errcode = 0 and parent.parent.parent.is_jv = "N" and parent.parent.parent.is_detailtreatment = "D" and ld_newamt < 1.0 then
			messagebox("Amount Validation", "Amount ~"" + data + "~" should be greater than zero")
			li_errcode = 1
		end if
		if li_errcode = 0 and parent.parent.parent.is_invoicebased = "Y" then
			if not (parent.parent.parent.is_invoicetype = "Sale" or parent.parent.parent.is_invoicetype = "Sale of Service") then
				if double(data) > getitemdecimal(row, "outstandingamt") then
					li_errcode = 1
				end if
			end if
		end if
	case "credit"
		ld_newamt = long(data)
		ld_storedamt = getitemdecimal(row, "credit")
		if ld_newamt < 0.0 then
			messagebox("Amount Validation", "Amount ~"" + data + "~" should be greater than zero")
			li_errcode = 1
		end if
		if li_errcode = 0 and parent.parent.parent.is_jv = "N" and parent.parent.parent.is_detailtreatment = "C" and ld_newamt < 1.0 then
			messagebox("Amount Validation", "Amount ~"" + data + "~" should be greater than zero")
			li_errcode = 1
		end if
		if li_errcode = 0 and parent.parent.parent.is_invoicebased = "Y" and (parent.parent.parent.is_invoicetype = "Sale" or parent.parent.parent.is_invoicetype = "Sale of Service") then
			if double(data) > getitemdecimal(row, "outstandingamt") then
				li_errcode = 1
			end if
		end if
	case "fullcode"
		li_hold = parent.parent.parent.wf_findfullcode(data, ll_acccode)
		if li_hold = 1 then
			this.object.acccode[row] = ll_acccode
			setnull(ll_patientcode)
			setnull(ls_regno)
			this.object.patientcode[row] = ll_patientcode
			this.object.regno[row] = ls_regno
			parent.parent.parent.ib_itemvalidated = true
			ll_rowno = parent.parent.parent.idc_dddwdetailaccount.find("aliasname ='" + data + "'", 1, parent.parent.parent.idc_dddwdetailaccount.rowcount())
			parent.parent.parent.idc_dddwdetailaccount.setrow(ll_rowno)
			parent.parent.parent.wf_setbalance(this.object.acccode[row], row)
		elseif li_hold = -1 then
			parent.parent.parent.ib_itemvalidated = true
		else
			messagebox("Alias Name Validation", "Please Select Valid Alias Name")
			li_errcode = 1
			parent.parent.parent.ib_itemvalidated = false
		end if
	end choose
	return li_errcode

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_detail
	integer li_null
	datetime ldt_date
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	setnull(li_null)
	setnull(ldt_date)
	lrs_detail = getitemstatus(currentrow, 0, primary!)
	if getcolumnname() <> parent.parent.parent.is_columnitemname then
		if rowcount() > 0 and lrs_detail <> new! then
			if parent.parent.parent.is_jv = "Y" then
				if parent.parent.parent.id_detail.rowcount() > 0 then
					parent.parent.parent.id_footer.object.balance[1] = parent.parent.parent.id_detail.getitemdecimal(currentrow, "balance")
					parent.parent.parent.id_footer.object.invdate[1] = parent.parent.parent.id_detail.getitemdatetime(currentrow, "invdate")
					parent.parent.parent.id_footer.object.netamt[1] = parent.parent.parent.id_detail.getitemdecimal(currentrow, "netamt")
					parent.parent.parent.id_footer.object.outstandingamt[1] = parent.parent.parent.id_detail.getitemdecimal(currentrow, "outstandingamt")
					if lrs_detail <> new! then
						if parent.parent.parent.id_detail.object.credit[parent.parent.parent.id_detail.getrow()] < 1 and parent.parent.parent.id_detail.object.debit[parent.parent.parent.id_detail.getrow()] < 1 then
							if parent.parent.parent.is_invoicebased = "Y" then
								messagebox("Amount validation", "Enter some valid value")
							else
								messagebox("Amount validation", "Enter some valid value for credit or debit field")
								if parent.parent.parent.id_detail.object.debit[parent.parent.parent.id_detail.getrow()] < 1 then
									setcolumn("debit")
								else
									setcolumn("credit")
								end if
							end if
							scrolltorow(currentrow)
							return ::message.returnvalue
						elseif parent.parent.parent.id_detail.object.credit[parent.parent.parent.id_detail.getrow()] > 0 and parent.parent.parent.id_detail.object.debit[parent.parent.parent.id_detail.getrow()] > 0 then
							messagebox("Amount validation", "Either Debit or Credit field must be zero")
							setcolumn("debit")
							scrolltorow(currentrow)
							return ::message.returnvalue
						end if
						return
					end if
					return
				end if
			elseif parent.parent.parent.id_detail.rowcount() > 1 then
				parent.parent.parent.id_footer.object.balance[1] = parent.parent.parent.id_detail.getitemdecimal(currentrow, "balance")
				parent.parent.parent.id_footer.object.invdate[1] = parent.parent.parent.id_detail.getitemdatetime(currentrow, "invdate")
				parent.parent.parent.id_footer.object.netamt[1] = parent.parent.parent.id_detail.getitemdecimal(currentrow, "netamt")
				parent.parent.parent.id_footer.object.outstandingamt[1] = parent.parent.parent.id_detail.getitemdecimal(currentrow, "outstandingamt")
				lrs_detail = getitemstatus(currentrow, 0, primary!)
				if lrs_detail <> new! then
					if parent.parent.parent.is_detailtreatment = "D" then
						if parent.parent.parent.id_detail.object.debit[parent.parent.parent.id_detail.getrow()] < 1 then
							messagebox("Amount validation", "Enter some valid amount")
							setcolumn("debit")
							scrolltorow(currentrow)
							return ::message.returnvalue
						end if
					elseif parent.parent.parent.id_detail.object.credit[parent.parent.parent.id_detail.getrow()] < 1 then
						messagebox("Amount validation", "Enter some valid amount")
						setcolumn("credit")
						scrolltorow(currentrow)
						return ::message.returnvalue
					end if
					if parent.parent.parent.id_detail.object.credit[parent.parent.parent.id_detail.getrow()] < 1 and parent.parent.parent.id_detail.object.debit[parent.parent.parent.id_detail.getrow()] < 1 or parent.parent.parent.id_detail.object.credit[parent.parent.parent.id_detail.getrow()] > 0 and parent.parent.parent.id_detail.object.debit[parent.parent.parent.id_detail.getrow()] > 0 then
						messagebox("Amount validation", "Enter some valid amount")
						if parent.parent.parent.is_detailtreatment = "D" then
							setcolumn("debit")
						else
							setcolumn("credit")
						end if
						scrolltorow(currentrow)
						return ::message.returnvalue
					end if
					return
				end if
				return
			end if
		else
			parent.parent.parent.id_footer.object.balance[1] = 0
			parent.parent.parent.id_footer.object.invdate[1] = ldt_date
			parent.parent.parent.id_footer.object.netamt[1] = 0
			parent.parent.parent.id_footer.object.outstandingamt[1] = 0
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	integer li_null
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	setnull(li_null)
	if parent.parent.parent.ib_itemvalidated = false then
		messagebox("Account Validation", "Duplicate Account, Please select some other")
		parent.parent.parent.ib_itemvalidated = true
		setcolumn("acccode")
		scrolltorow(parent.parent.parent.il_currrow)
		this.object.acccode[parent.parent.parent.il_currrow] = li_null
	end if
	if string(dwo.name) = "acccode" then
		parent.parent.parent.id_detail.selecttext(1, 40)
	end if
	parent.parent.parent.il_currrow = row
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	parent.parent.parent.id_master.setfocus()
	parent.parent.parent.id_master.setcolumn("studentregno")
	if parent.parent.parent.id_master.rowcount() > 0 then
		parent.parent.parent.id_master.object.studentregno[1] = ""
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "invoicecode"
		if data = "" or isnull(data) then
			messagebox("Invoice Code Validation", "Please enter valid invoice code")
		end if
	end choose
	return 1

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	choose case dwo.name
	case "acccode"
		parent.parent.parent.post wf_setaccountname(data)
	case "patientcode"
		parent.parent.parent.post wf_setpatientname(data)
	case "guestcode"
		parent.parent.parent.post wf_setguestname(data)
	end choose
	return ::message.returnvalue

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	string ls_fullcode
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyenter! and getcolumnname() = "acccode" then
		if parent.parent.parent.idc_dddwdetailaccount.rowcount() > 0 then
			parent.parent.parent.id_detail.setitem(parent.parent.parent.id_detail.getrow(), "acccode", parent.parent.parent.idc_dddwdetailaccount.getitemnumber(parent.parent.parent.idc_dddwdetailaccount.getrow(), "acccode"))
		end if
		if parent.parent.parent.wf_getfullcode(parent.parent.parent.id_detail.getitemnumber(parent.parent.parent.id_detail.getrow(), "acccode"), ls_fullcode) = 1 then
			this.object.fullcode[parent.parent.parent.id_detail.getrow()] = ls_fullcode
			parent.parent.parent.wf_setbalance(this.object.acccode[parent.parent.parent.id_detail.getrow()], parent.parent.parent.id_detail.getrow())
		else
			messagebox("Account Name Validation", "Please Select Valid Account Name")
			this.object.fullcode[parent.parent.parent.id_detail.getrow()] = ""
		end if
	end if
	if getcolumnname() = "credit" and key = keyf5! then
		parent.parent.parent.wf_show_patientdiscount_window()
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	if getrow() = rowcount() then
		if parent.parent.parent.is_jv = "N" then
			if parent.parent.parent.is_detailtreatment = "D" then
				if getcolumn() = integer(this.object.datawindow.column.count) - 1 then
					parent.parent.parent.event ue_newitem()
					return 1
				end if
			elseif getcolumn() = integer(this.object.datawindow.column.count) then
				parent.parent.parent.event ue_newitem()
				return 1
			end if
		elseif getcolumn() = integer(this.object.datawindow.column.count) then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
		return
	end if
	send(handle(this), 256, 9, long(90))
	return 1
