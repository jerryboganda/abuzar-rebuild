	return ll_retflag

// w_purpayment_form.wf_getserverdatetime(datetime ar_server_datetime, string ar_errtext) returns boolean
	datetime ldt_last_transdate
	datetime ldt_current_serverdate
	integer li_max_allow_days
	string ls_hold_serverdate
	date ld_datepart
	time lt_timepart
	ar_errtext = "Please verify Server DateTime"
	li_max_allow_days = f_numberpreferences("MaxAllowDate")
	if isnull(li_max_allow_days) then
		li_max_allow_days = 4
	end if
	SQL rollback USING sqlca;
	SQL SELECT LastTransDate INTO :ldt_last_transdate FROM ServerDate USING sqlca;
	if sqlca.sqlcode = 0 then
		sqlca.getdatetime(ldt_current_serverdate)
		ar_server_datetime = ldt_current_serverdate
		if sqlca.sqlcode = 0 then
			if ldt_current_serverdate >= ldt_last_transdate and daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) <= li_max_allow_days then
				ld_datepart = date(string(ldt_current_serverdate, "yyyy-mm-dd"))
				lt_timepart = time(string(ldt_current_serverdate, "hh:mm:ss"))
				ldt_current_serverdate = datetime(ld_datepart, lt_timepart)
				SQL update ServerDate SET LastTransDate =:ldt_current_serverdate USING sqlca;
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					ar_server_datetime = ldt_current_serverdate
					return true
				else
					SQL rollback USING sqlca;
					return false
				end if
			elseif ldt_current_serverdate < ldt_last_transdate then
				ar_errtext = "Back Date Invoice Check violates"
				return false
			elseif daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) > li_max_allow_days then
				ar_errtext = "Forward Date Invoice Check violates"
				return false
			end if
		else
			SQL rollback USING sqlca;
			ar_server_datetime = datetime(date(today()), time(today()))
			return false
		end if
		return
	end if
	SQL rollback USING sqlca;
	ar_server_datetime = datetime(date(today()), time(today()))
	return false

// w_purpayment_form.wf_printorder() returns integer
	s_datastore lstr
	string ls_report
	if this.ib_print = true then
		if gs_company = "DECENTPHWH" then
			ls_report = "d_decentphwh_purpayment_print"
		else
			ls_report = "d_purpayment_print"
		end if
		this.dw_print.dataobject = ls_report
		this.dw_print.settransobject(sqlca)
		this.dw_print.retrieve(this.il_code)
		lstr.dw = this.dw_print
		lstr.s_name1 = this.dw_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return 0
		else
			if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
				messagebox("Printer", "Printing Error")
				this.dw_print.printcancel()
			end if
			if this.dw_print.rowcount() > 0 then
				if this.dw_print.print() < 0 then
					messagebox("Printing", "Can not Print Invoice", information!)
				end if
			else
				messagebox("Printing Error", "Can not Print Data,~r~nNo rows are retrieved", information!)
			end if
		end if
	end if
	return 0

// w_purpayment_form.wf_findpatientcode(string as_regno, long al_patientcode) returns long
	long ll_patientcode
	long ll_retflag
	string ls_itemname
	SQL SELECT patient.patientcode INTO :ll_patientcode FROM patient WHERE patient.regno =:as_regno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_patientcode = ll_patientcode
		if isnull(al_patientcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_purpayment_form.wf_findfullcode(string as_fullcode, long al_icode, string as_itemname) returns long
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		as_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_purpayment_form.wf_validateinvoice(long al_invcode) returns long
	long ll_retcode
	long ll_acccode
	long ll_counter
	string ls_aliasname
	double ld_invtotal
	double ld_outstandingamt
	double ld_whperc
	SQL SELECT AliasName =( SELECT A.AliasName FROM Accounts A WHERE A.AccCode =H.SuppCode ) , AccCode =H.SuppCode , WHPerc =ISNULL ( ( SELECT S.WHPerc FROM Supplier S WHERE S.SuppCode =H.SuppCode ) , 0 ) , H.InvTotal , H.OutStandingAmt INTO :ls_aliasname, :ll_acccode, :ld_whperc, :ld_invtotal, :ld_outstandingamt FROM PurLedger H WHERE H.PurInvCode =:al_invcode AND H.Posted ='Y' AND H.AccountFor ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_header.object.purinvcode[1] = al_invcode
		this.id_header.object.netamt[1] = ld_invtotal
		this.id_header.object.outstandingamt[1] = ld_outstandingamt
		this.id_header.object.aliasname[1] = ls_aliasname
		this.id_header.object.acccode[1] = ll_acccode
		this.id_header.object.whtaxbaseamt[1] = ld_outstandingamt
		this.id_header.object.whtaxperc[1] = ld_whperc
		this.id_header.object.whtaxamt[1] = round(ld_outstandingamt * ld_whperc * 0.01, 2)
		this.id_header.object.paymentamt[1] = round(ld_outstandingamt - round(ld_outstandingamt * ld_whperc * 0.01, 2), 2)
	end if
	return ll_retcode

// w_purpayment_form.wf_set_deductionamt(integer ai_deduction, integer ai_perc_or_base, double ad_data) returns long
	if ai_perc_or_base = 1 then
		if ai_deduction = 1 then
			this.id_header.object.whtaxamt[1] = round(ad_data * this.id_header.object.whtaxbaseamt[1] / 100, 0)
			this.id_header.object.paymentamt[1] = this.id_header.object.outstandingamt[1] - round(ad_data * this.id_header.object.whtaxbaseamt[1] / 100, 0)
		end if
	elseif ai_deduction = 1 then
		this.id_header.object.whtaxamt[1] = round(ad_data * this.id_header.object.whtaxperc[1] / 100, 0)
		this.id_header.object.paymentamt[1] = round(this.id_header.object.outstandingamt[1] - round(ad_data * this.id_header.object.whtaxperc[1] / 100, 0), 0)
	end if
	return 0

// w_purpayment_form.wf_return_payment(long al_invid, string as_errortext) returns boolean
	long ll_invcode
	long ll_counter
	long ll_detailrows
	long ll_masterrow
	boolean lb_commitflag
	double ld_amt
	double ld_oldtotalamt
	double ld_balance
	double ld_totalamt
	double ld_newbalance
	ll_invcode = this.id_header.getitemnumber(1, "purinvcode")
	this.id_purpayment.retrieve(al_invid, ll_invcode)
	as_errortext = "Some database problem occur"
	ll_detailrows = this.id_purpayment.rowcount()
	ll_counter = 1
	do while ll_counter <= ll_detailrows and lb_commitflag
		ll_invcode = this.id_purpayment.getitemnumber(ll_counter, "purinvcode")
		if not isnull(ll_invcode) then
			if wf_lockinvoice(ll_invcode) = 0 then
				this.it_transobject.getpurinvbalance(ll_invcode, ld_balance)
				if this.it_transobject.sqlcode = 0 then
					ld_amt = this.id_purpayment.object.paymentamt[ll_counter]
					if this.id_purpayment.object.whtaxamt[ll_counter] > 0 then
						ld_amt = ld_amt + this.id_purpayment.object.whtaxamt[ll_counter]
					end if
					if ld_amt <> 0.0 and lb_commitflag then
						ld_newbalance = ld_balance + ld_amt
						if ld_newbalance >= 0.0 then
							this.it_transobject.updatepurinvbalance(ll_invcode, ld_newbalance)
							if this.it_transobject.sqlcode <> 0 then
								lb_commitflag = false
								as_errortext = "Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
							end if
						else
							lb_commitflag = false
							as_errortext = "Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
						end if
					else
						lb_commitflag = false
						as_errortext = "Not Enough Balance On Purchase Invoice."
					end if
				else
					lb_commitflag = false
					as_errortext = "Balance Retrieval Error:~r~n" + this.it_transobject.sqlerrtext
				end if
			else
				lb_commitflag = false
				as_errortext = "Invoice is used by another user"
			end if
		end if
		ll_counter = ll_counter + 1
	loop
	return lb_commitflag

// w_purpayment_form.wf_lockinvoice(long al_invcode) returns long
	integer li_count
	this.it_transobject.dbparm = " Async =1, DBGetTime = 20"
	this.it_transobject.lockpurinvoice(al_invcode)
	this.it_transobject.dbparm = "Async =0, DBGetTime = 0"
	return this.it_transobject.sqlcode

// w_purpayment_form.wf_populatedetail(long al_invid, string as_errortext) returns boolean
	long ll_detailrows
	long ll_errrowid
	long ll_usercode
	long ll_invcode
	long ll_counter
	long ll_masterrow
	long ll_row
	long ll_acccode
	long ll_patientcode
	long ll_guestcode
	long ll_studentcode
	long ll_null
	long ll_unpostedtrans
	double ld_amt
	double ld_balance
	double ld_newbalance
	double ld_totalamt
	double ld_debit
	double ld_credit
	double ld_invbalance
	double ld_foreignamt
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	boolean lb_commitflag
	string ls_remarks
	string ls_chkno
	string ls_msg
	ls_msg = space(1000)
	setnull(ll_null)
	ll_counter = 1
	ls_msg = "000                                                                                                                                 "
	as_errortext = "    Some database problem ocuurs         "
	ll_masterrow = this.id_header.rowcount()
	if ll_masterrow > 0 then
		ll_invcode = this.id_header.object.purinvcode[ll_masterrow]
	end if
	if wf_lockinvoice(ll_invcode) = 0 and ll_masterrow > 0 then
		ls_msg = "000                                                                                                                                 "
		this.it_transobject.checkunpostedpurinvintransactions(ll_invcode, al_invid, "PP", ll_unpostedtrans, ls_msg)
		if ll_unpostedtrans > 0 then
			lb_commitflag = false
			as_errortext = "Unposted Transaction(s) Exist for this Invoice~r~n~r~n" + ls_msg
		else
			this.it_transobject.getpurinvbalance(ll_invcode, ld_invbalance)
			if this.it_transobject.sqlcode = 0 then
				ld_amt = this.id_header.object.paymentamt[ll_masterrow]
				if this.id_header.object.whtaxamt[ll_masterrow] > 0 then
					ld_amt = ld_amt + this.id_header.object.whtaxamt[ll_masterrow]
				end if
				if ld_amt <> 0.0 and lb_commitflag then
					ld_newbalance = ld_invbalance - ld_amt
					if ld_newbalance >= 0.0 then
						this.it_transobject.updatepurinvbalance(ll_invcode, ld_newbalance)
						if this.it_transobject.sqlcode <> 0 then
							lb_commitflag = false
							as_errortext = "Purchase Invoice Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
						end if
					else
						lb_commitflag = false
						as_errortext = "Purchase Invoice Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
					end if
				else
					lb_commitflag = false
					as_errortext = "Not Enough Balance On Purchase Invoice"
				end if
			else
				lb_commitflag = false
				as_errortext = "Purchase Invoice Balance Retrieval Error:~r~n" + this.it_transobject.sqlerrtext
			end if
		end if
	else
		lb_commitflag = false
		as_errortext = "Invoice Is Used by some other user"
	end if
	return lb_commitflag

// w_purpayment_form.wf_validatedate() returns boolean
	datetime ldt_systemdatetime
	SQL SELECT GETDATE ( ) INTO :ldt_systemdatetime FROM _UTN USING sqlca;
	if sqlca.sqlcode = 0 then
		this.id_header.setitem(1, "date", ldt_systemdatetime)
		return true
	end if
	return false

// w_purpayment_form.create() returns 0 [event]
	this.dw_purpayment = create dw_purpayment
	this.cb_printorder = create cb_printorder
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.tab_main = create tab_main
	this.dw_print = create dw_print
	this.control = {this.dw_purpayment, this.cb_printorder, this.cb_cancel, this.cb_ok, this.tab_main, this.dw_print}

// w_purpayment_form.destroy() returns 0 [event]
	destroy this.dw_purpayment
	destroy this.cb_printorder
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.tab_main
	destroy this.dw_print

// w_purpayment_form.open() returns long [event]
	integer li_xpos
	integer li_ypos
	integer li_xendpos
	integer li_counter
	integer li_taborder
	integer li_visiblecolumns
	integer li_zerotaborder
	long ll_counter
	long li_retcode
	long li_rtncode
	boolean lb_active
	boolean lb_restricted
	boolean lb_customicode
	boolean lb_zerotabordercol
	date ld_date
	long ll_retcode
	this.istr_arg = message.powerobjectparm
	this.il_code = this.istr_arg.l_code1
	this.il_purinvcode = this.istr_arg.l_code2
	this.il_protect = this.istr_arg.l_code3
	this.it_transobject = create u_transaction
	if wf_connect() <> 0 then
		messagebox("Connection Failure!", "Unable to connect to the database", stopsign!)
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	wf_retrieve_tabs()
	wf_apply_protect_setting()
	wf_set_interface_adjustments()
	wf_set_tab_visibility()
	if f_stringpreferences("askdateintrans") = "N" and not wf_validatedate() then
		close(this)
	end if
	triggerevent("ue_postopen")
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_printorder.clicked() returns long [event]
	parent.ib_print = true
	parent.wf_save()
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.postevent("ue_close")
	return ::message.returnvalue

// cb_ok.ue_enterkry(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return 1

// cb_ok.clicked() returns long [event]
	string ls_aliasname
	long ll_newid
	long ll_row
	long ll_counter
	long ll_liccode
	long li_rc
	long ll_pk
	long ll_null
	long ll_usercode
	long ll_insrow
	long ll_unpostedtrans
	long ll_invcode
	boolean lb_commitok
	boolean lb_modify
	boolean lb_continue
	datetime ldt_server_datetime
	string ls_msg
	string ls_errortext
	string ls_date_errtext
	double ld_outstandingamt
	double ld_paymentamt
	double ld_whtaxamt
	setnull(ll_null)
	if parent.il_protect = 1 then
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_header) < 0 then
		parent.tab_main.selecttab(1)
		return ::message.returnvalue
	end if
	if f_stringpreferences("askdateintrans") = "N" then
		if not parent.wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			return ::message.returnvalue
		end if
	else
		ldt_server_datetime = parent.id_header.object.date[1]
	end if
	ll_pk = parent.id_header.object.code[1]
	open(w_salesmanpassword)
	ll_usercode = long(::message.doubleparm)
	setfocus()
	ld_outstandingamt = parent.id_header.object.outstandingamt[1]
	if isnull(ld_outstandingamt) then
		ld_outstandingamt = 0
	end if
	ld_paymentamt = parent.id_header.object.paymentamt[1]
	if isnull(ld_paymentamt) then
		ld_paymentamt = 0
	end if
	ld_whtaxamt = parent.id_header.object.whtaxamt[1]
	if isnull(ld_whtaxamt) then
		ld_whtaxamt = 0
	end if
	if ld_outstandingamt < ld_paymentamt + ld_whtaxamt then
		messagebox("Purchase Payment Validation", "Purchase Payment Amount is more than outstanding amount", stopsign!)
		return ::message.returnvalue
	end if
	if ll_usercode > 0 then
		ll_invcode = parent.id_header.object.purinvcode[1]
		ls_msg = "000                                                                                                                                 "
		parent.it_transobject.checkunpostedpurinvintransactions(parent.id_header.object.purinvcode[1], parent.id_header.object.code[parent.id_header.rowcount()], "PP", ll_unpostedtrans, ls_msg)
		if ll_unpostedtrans > 0 then
			parent.id_header.scrolltorow(1)
			parent.id_header.setfocus()
			messagebox("Purchase Invoice Validation Problem", "Unposted Transaction(s) Exist for this Purchase Invoice~r~n~r~n" + ls_msg, stopsign!)
			return ::message.returnvalue
		end if
		if f_stringpreferences("askdateintrans") = "N" and not parent.wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			return ::message.returnvalue
		end if
		if isnull(ll_pk) then
			parent.wf_tabnewid("PurPayment", ll_newid)
			if ll_newid > 0 then
				parent.id_header.object.code[1] = ll_newid
			end if
		else
			ll_newid = parent.id_header.object.code[1]
			lb_modify = true
		end if
		if parent.id_header.rowcount() > 0 then
			parent.id_header.object.usercode[1] = ll_usercode
			parent.id_header.object.date[1] = ldt_server_datetime
		end if
		if lb_modify and lb_continue then
			lb_continue = parent.wf_return_payment(ll_newid, ls_errortext)
		end if
		if lb_continue then
			lb_continue = parent.wf_populatedetail(ll_newid, ls_errortext)
		end if
		if lb_continue then
			if parent.id_header.update(true, false) = 1 then
				SQL commit USING parent.it_transobject;
				parent.il_code = ll_newid
				lb_commitok = true
				if parent.ib_print then
					parent.wf_printorder()
				end if
				parent.event ue_close()
				return ::message.returnvalue
			else
				if isnull(ll_pk) then
					parent.id_header.object.code[1] = ll_null
				end if
				messagebox("Purchase Payment Saving Problem", "Unable to update Purchase Payment Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
				SQL rollback USING parent.it_transobject;
			end if
		end if
	end if
	return ::message.returnvalue

// tab_main.create() returns 0 [event]
	this.tabpage_header = create tabpage_header
	this.control = {this.tabpage_header}

// tab_main.destroy() returns 0 [event]
	destroy this.tabpage_header

// tab_main.selectionchanged(integer oldindex, integer newindex) returns long [event]
	if parent.il_protect = 0 and newindex = 1 then
		parent.id_header.setfocus()
		if parent.id_header.rowcount() = 0 then
			parent.wf_insert_row(parent.id_header, 0)
		end if
	end if
	return ::message.returnvalue

// tabpage_header.create() returns 0 [event]
	this.dw_header = create dw_header
	this.control = {this.dw_header}

// tabpage_header.destroy() returns 0 [event]
	destroy this.dw_header

// dw_header.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// dw_header.getfocus() returns long [event]
	setfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_header.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ll_retcode
	double ld_balance
	if len(gettext()) > 0 then
		selecttext(1, len(gettext()))
	end if
	choose case dwo.name
	case "paymentmode", "paymentacccode"
		if this.object.paymentmode[row] = "C" then
			parent.parent.parent.idc_paymentaccount.setfilter("subcode=2")
		else
			parent.parent.parent.idc_paymentaccount.setfilter("subcode=4")
		end if
		parent.parent.parent.idc_paymentaccount.filter()
		return 0
	end choose
	return ll_retcode

// dw_header.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ll_retcode
	double ld_balance
	choose case dwo.name
	case "purinvcode"
		if isnull(data) or long(data) < 0 then
			messagebox("Purchase Invoice Code Validation", "Purchase Invoice Code Validation Error~n~rPlease enter Some valid Purchase Invoice Code", stopsign!)
			ll_retcode = 1
		else
			ll_retcode = parent.parent.parent.wf_validateinvoice(long(data))
			if ll_retcode <> 0 then
				messagebox("Purchase Invoice Code Validation", "Purchase Invoice Code Validation Error~n~rPlease enter Some valid Purchase Invoice Code", stopsign!)
				ll_retcode = 1
			end if
		end if
	case "paymentmode"
		if data = "C" then
			parent.parent.parent.idc_paymentaccount.setfilter("subcode=2")
		else
			parent.parent.parent.idc_paymentaccount.setfilter("subcode=4")
		end if
		parent.parent.parent.idc_paymentaccount.filter()
		return 0
	case "whtaxperc"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_set_deductionamt(1, 1, double(data))
		end if
	case "whtaxbaseamt"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_set_deductionamt(1, 2, double(data))
		end if
	case "whtaxamt"
		if data = "" or isnull(data) then
			return 0
		elseif double(data) < 0.0 then
			return 1
		else
			if double(data) >= 0.0 then
				this.object.paymentamt[row] = round(this.object.outstandingamt[row] - double(data), 0)
				if this.object.paymentamt[row] < 0 then
					this.object.paymentamt[row] = 0.00
				end if
			end if
			return 0
		end if
		return
	end choose
	return ll_retcode
