// window w_purpayment_list (accounts)  ancestor: w_listview_form

// w_purpayment_list.wf_setprintout() returns long
	this.id_print.dataobject = "d_purpayment_print"
	return 0

// w_purpayment_list.wf_post() returns long
	return 0

// w_purpayment_list.wf_generatecashreceipt(datetime adt_server_datetime, long al_startinginvoice, long al_endinginvoice, integer ai_salesmancode) returns long
	long ll_counter
	long ll_custcode
	integer li_servicepoststatus
	double ld_invadvance
	double ld_totaladvance
	double ld_servicesadvance
	long ll_vochcode
	long ll_glvochcode
	long ll_null
	long ll_cashacc
	long ll_modifiedby
	long ll_postedby
	long ll_patientcode
	long ll_admissioncode
	string ls_null
	string ls_remarks
	string ls_posted = "Y"
	long ll_vouchercatcode = 2
	datetime ldt_datetime
	double ld_zerovalue
	setnull(ll_null)
	setnull(ll_modifiedby)
	setnull(ls_null)
	setnull(ll_patientcode)
	setnull(ll_admissioncode)
	ll_postedby = ai_salesmancode
	ldt_datetime = adt_server_datetime
	sqlca.getglobalcode("GT_CashAcc", ll_cashacc)
	if sqlca.sqlcode <> 0 then
		messagebox("Auto CashReceipt Generation Error", "Unable to find Cash Account while generating auto cash receipt.")
		return -1
	end if
	for ll_counter = al_startinginvoice to al_endinginvoice
		SQL Select custcode , cashreceived , patientcode , CASE WHEN admissioncode IS NULL THEN NULL ELSE ( SELECT PA.PatientCode FROM PatientAdmission PA WHERE PA.AdmissionCode =ServiceOHeader.Admissioncode ) END INTO :ll_custcode, :ld_invadvance, :ll_patientcode, :ll_admissioncode From ServiceOHeader Where Posted ='N' AND ServiceOCode =:ll_counter USING sqlca;
		if not isnull(ll_admissioncode) then
			ll_patientcode = ll_admissioncode
		end if
		if sqlca.sqlcode = 0 then
			SQL Select Sum ( cashreceived ) INTO :ld_servicesadvance From ServiceODetail Where ServiceOcode =:ll_counter USING sqlca;
			if sqlca.sqlcode = 0 then
				ld_totaladvance = ld_invadvance + ld_servicesadvance
				if ld_totaladvance > 0.0 then
					sqlca.getglobalcode("GT_CashAcc", ll_cashacc)
					if this.it_transobject.sqlcode <> 0 then
						messagebox("Auto CashReceipt Generation Error", "Unable to find Cash Account while generating auto cash receipt.")
						return -1
					end if
					ls_remarks = "Cash Receipt on Service Order#: " + string(ll_counter)
					sqlca.createvoucher(ll_vouchercatcode, ll_cashacc, ldt_datetime, ai_salesmancode, "Y", ldt_datetime, ls_remarks, ldt_datetime, ll_modifiedby, ll_postedby, ls_null, ll_cashacc, ll_custcode, ld_totaladvance, ls_null, ls_remarks, ll_patientcode, ll_null, ll_null, ll_null, ld_zerovalue, ld_zerovalue, ll_glvochcode, ll_vochcode, ll_null)
					if this.it_transobject.sqlcode <> 0 then
						messagebox("Auto CashReceipt Generation Error", "Reasons are:~r~n" + this.it_transobject.sqlerrtext)
						return -1
					end if
					return
				end if
			else
				messagebox("Auto CashReceipt Generation Error", "Error in fetching ServiceOrder detail rows for calculating Services advance.")
				return -1
			end if
		elseif sqlca.sqlcode <> 100 then
			messagebox("Auto CashReceipt Generation Error", "Error in fetching ServiceOrder Header posting information.")
			return -1
		end if
	next
	return 0

// w_purpayment_list.wf_openmywindow(long al_code) returns 0
	s_arguements lstr_arg
	long ll_code
	long ll_retcode = 1
	long ll_protect
	long ll_payment_count
	if this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 and al_code > 0 then
		if this.id_list.object.posted[this.id_list.getrow()] = "Y" then
			SQL SELECT COUNT ( PurPaymentCode ) INTO :ll_payment_count FROM PurPayment WHERE PurInvCode =:al_code USING sqlca;
			if sqlca.sqlcode = 0 then
				if ll_payment_count <= 0 or isnull(ll_payment_count) then
					setnull(ll_code)
					lstr_arg.i_status = 1
					if this.id_list.object.outstandingamt[this.id_list.getrow()] > 0 then
						ll_protect = 0
					else
						ll_protect = 1
					end if
				else
					lstr_arg.l_code2 = al_code
					lstr_arg.i_status = 1
					openwithparm(w_purpayment_for_purinvcode, lstr_arg)
					lstr_arg = message.powerobjectparm
					if lstr_arg.i_status = 1 then
						ll_code = lstr_arg.l_code1
						lstr_arg.l_code2 = al_code
						ll_protect = lstr_arg.l_code3
					end if
				end if
			else
				messagebox("Database Problem", "Some Database Problem while fetching purchase payment information~r~n" + sqlca.sqlerrtext, stopsign!)
				lstr_arg.i_status = 0
			end if
		end if
	else
		setnull(ll_code)
		lstr_arg.i_status = 0
	end if
	lstr_arg.l_code1 = ll_code
	lstr_arg.l_code2 = al_code
	lstr_arg.l_code3 = ll_protect
	if lstr_arg.i_status = 1 then
		openwithparm(w_purpayment_form, lstr_arg)
	end if

// w_purpayment_list.wf_retrieve() returns long
	long rtcode
	this.id_list.setfilter("")
	rtcode = this.id_dwcontrol.retrieve()
	return rtcode

// w_purpayment_list.create() returns 0 [event]
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_purpayment_menu" then
		this.menuid = create m_purpayment_menu
	end if

// w_purpayment_list.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_purpayment_list.ue_new() returns 0 [event]
	long ll_code
	call super::ue_new
	setnull(ll_code)
	wf_openmywindow(ll_code)

// w_purpayment_list.ue_list() returns 0 [event]
	long ll_rtcode = 1
	this.id_list.retrieve()
	if this.id_list.rowcount() <= 0 then
		ll_rtcode = wf_retrieve()
	end if
	wf_populate_ddlb(this.id_list)
	if ll_rtcode > 0 then
		this.im_menu.m_file.m_new.enabled = true
		this.im_menu.m_file.m_save.enabled = false
		this.im_menu.m_file.m_delete.enabled = false
		this.im_menu.m_file.m_first.enabled = true
		this.im_menu.m_file.m_next.enabled = true
		this.im_menu.m_file.m_last.enabled = true
		this.im_menu.m_file.m_print.enabled = true
		this.im_menu.m_file.m_previous.enabled = true
		this.im_menu.m_file.m_retrieve.text = "De&tail"
		this.i_retrievemode = 2
		this.i_editmode = 2
		if this.il_selectedrow = 0 then
			wf_first()
			wf_selectunselectrow(1)
		end if
		this.tab_retrieve.tabpage_list.dw_find.setfocus()
		return
	end if

// w_purpayment_list.ue_print() returns 0 [event]

// w_purpayment_list.ue_postopen() returns 0 [event]
	call super::ue_postopen
	if gs_company = "MRSERVER" then
		this.tab_retrieve.tabpage_list.dw_list.dataobject = "d_mrserver_purpayment_list"
	else
		this.tab_retrieve.tabpage_list.dw_list.dataobject = "d_purpayment_list"
	end if
	this.tab_retrieve.tabpage_list.dw_list.settransobject(this.it_transobject)

// w_purpayment_list.open() returns long [event]
	m_entry lm_menu
	long ll_width
	long ll_height
	environment env
	this.it_transobject = sqlca
	if gs_company = "MRSERVER" then
		this.tab_retrieve.tabpage_list.dw_list.dataobject = "d_mrserver_purpayment_list"
	else
		this.tab_retrieve.tabpage_list.dw_list.dataobject = "d_purpayment_list"
	end if
	this.tab_retrieve.tabpage_list.dw_list.settransobject(this.it_transobject)
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	lm_menu.mf_initsecurityapp(lm_menu)
	this.im_menu.m_file.m_save.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_file.m_previous.enabled = false
	this.im_menu.m_file.m_retrieve.text = "De&tail"
	this.id_list = this.tab_retrieve.tabpage_list.dw_list
	this.id_list.settransobject(this.it_transobject)
	this.id_list.retrieve()
	this.dw_print.dataobject = this.tab_retrieve.tabpage_list.dw_list.dataobject
	this.id_print = this.dw_print
	this.id_printlist = this.dw_listprint
	this.id_print.settransobject(this.it_transobject)
	this.id_printlist.settransobject(this.it_transobject)
	this.id_dwcontrol = this.id_list
	wf_populate_ddlb(this.id_dwcontrol)
	this.tab_retrieve.tabpage_list.dw_find.settransobject(this.it_transobject)
	if getenvironment(env) <> 1 then
		return ::message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.tab_retrieve.width = ll_width * 0.99
	this.tab_retrieve.height = ll_height * 0.83
	this.tab_retrieve.tabpage_list.gb_fliter.width = ll_width * 0.97 - this.tab_retrieve.tabpage_list.gb_sort.width
	this.tab_retrieve.tabpage_list.r_1.width = ll_width * 0.99
	this.tab_retrieve.tabpage_list.r_1.height = ll_height * 0.765 - this.tab_retrieve.tabpage_list.gb_sort.height
	this.tab_retrieve.tabpage_list.dw_list.width = ll_width * 0.98
	this.tab_retrieve.tabpage_list.dw_list.height = ll_height * 0.75 - this.tab_retrieve.tabpage_list.dw_list.y
	setredraw(true)
	return ::message.returnvalue

// dw_list.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	long ll_code
	ancestorreturnvalue = super::doubleclicked(xpos, ypos, row, dwo)
	if row > 0 then
		ll_code = this.object.code[row]
		if ll_code > 0 then
			parent.parent.parent.wf_openmywindow(ll_code)
		end if
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_list.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	return ::message.returnvalue

// dw_find.keypressed(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	long ll_code
	long ll_found
	string ls_regno
	s_arguements lstr_arg
	ancestorreturnvalue = super::keypressed(key, keyflags)
	if key = keyenter! and parent.parent.parent.id_list.getselectedrow(0) > 0 then
		ll_code = parent.parent.parent.id_list.object.code[parent.parent.parent.id_list.getselectedrow(0)]
		parent.parent.parent.wf_openmywindow(ll_code)
		return ::message.returnvalue
	end if
	if key = keyf5! then
		open(w_arg_containerno)
		lstr_arg = ::message.powerobjectparm
		if lstr_arg.i_status = 1 then
			parent.parent.parent.id_list.setfilter("containerno = '" + lstr_arg.s_name1 + "'")
			parent.parent.parent.id_list.filter()
		end if
	end if
	return ::message.returnvalue
