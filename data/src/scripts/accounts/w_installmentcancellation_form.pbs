// window w_installmentcancellation_form (accounts)  ancestor: window

// w_installmentcancellation_form.ue_close() returns 0 [event]
	SQL stop USING this.it_transobject;
	close(this)

// w_installmentcancellation_form.wf_set_interface_adjustments() returns 0
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width * 0.95
		ll_height = ll_win_height * 0.95
		this.width = ll_width
		this.height = ll_height
		this.cb_ok.y = ll_height - this.cb_ok.height - 200
		this.cb_cancel.y = ll_height - this.cb_cancel.height - 200
		this.tab_main.width = ll_width * 0.98
		this.tab_main.height = this.cb_ok.y - 50
		this.tab_main.tabpage_main.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_main.height = this.tab_main.height - 500
		this.tab_main.tabpage_main.dw_master.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_main.dw_master.height = this.tab_main.height - 500
		this.tab_main.tabpage_detail.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_detail.height = this.tab_main.height - 500
		this.tab_main.tabpage_detail.dw_detail.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_detail.dw_detail.height = this.tab_main.height - 500
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if

// w_installmentcancellation_form.wf_set_tab_visibility() returns long
	wf_select_first_tab()
	return 0

// w_installmentcancellation_form.wf_connect() returns long
	SQL start USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_installmentcancellation_form.wf_tabnewid(string as_tablename, ref long al_newid) returns long
	long ll_rtcode
	SQL SELECT TABMAXKEY INTO :al_newid FROM _TABMAXKEY WITH ( UPDLOCK HOLDLOCK ) WHERE _TABMAXKEY.TABName =:as_tablename USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_newid = al_newid + 1
		SQL update dbo._tabmaxkey SET TABMAXKEY =:al_newid WHERE _TABMAXKEY.TABName =:as_tablename USING this.it_transobject;
		if this.it_transobject.sqlcode < 0 then
			ll_rtcode = this.it_transobject.sqlcode
			al_newid = 0
		end if
	else
		ll_rtcode = this.it_transobject.sqlcode
		al_newid = 0
	end if
	return ll_rtcode

// w_installmentcancellation_form.wf_retrieve_tabs() returns long
	this.id_master = this.tab_main.tabpage_main.dw_master
	this.id_master.settransobject(this.it_transobject)
	if this.il_code > 0 then
		this.id_master.retrieve(this.il_code)
	else
		this.id_master.insertrow(0)
	end if
	this.id_detail = this.tab_main.tabpage_detail.dw_detail
	this.id_detail.settransobject(this.it_transobject)
	this.id_detail.retrieve(this.il_code)
	return 0

// w_installmentcancellation_form.wf_protectdw(ref datawindow ad_dwcontrol, integer ai_doundo) returns integer
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next
	return 0

// w_installmentcancellation_form.wf_apply_protect_setting() returns integer
	return 0

// w_installmentcancellation_form.wf_save() returns long
	if this.il_protect = 0 then
		this.cb_ok.triggerevent(clicked!)
	end if
	return 0

// w_installmentcancellation_form.wf_print() returns long
	if this.il_protect = 0 then
		wf_save()
	end if
	return 0

// w_installmentcancellation_form.wf_select_first_tab() returns long
	if this.tab_main.tabpage_main.visible then
		this.tab_main.selecttab(1)
		return 0
	end if
	return 0

// w_installmentcancellation_form.create() returns 0 [event]
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.tab_main = create tab_main
	this.control = {this.cb_cancel, this.cb_ok, this.tab_main}

// w_installmentcancellation_form.destroy() returns 0 [event]
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.tab_main

// w_installmentcancellation_form.open() returns long [event]
	integer li_xpos
	integer li_ypos
	integer li_xendpos
	integer li_counter
	integer li_taborder
	integer li_visiblecolumns
	integer li_zerotaborder
	long ll_counter
	long li_retcode
	long li_rtncode
	boolean lb_active
	boolean lb_restricted
	boolean lb_customicode
	boolean lb_zerotabordercol
	date ld_date
	long ll_retcode
	ld_date = today()
	this.il_code = message.doubleparm
	this.it_transobject = create u_transaction
	if wf_connect() <> 0 then
		messagebox("Connection Failure", "Unable to connect to the database", stopsign!)
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	wf_retrieve_tabs()
	wf_apply_protect_setting()
	wf_set_interface_adjustments()
	wf_set_tab_visibility()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.postevent("ue_close")
	return ::message.returnvalue

// cb_ok.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return 1

// cb_ok.clicked() returns long [event]
	string ls_aliasname
	long ll_newid
	long ll_row
	long ll_counter
	long ll_liccode
	long li_rc
	long ll_invid
	long ll_detailrows
	long ll_salesmancode
	long li_ldsrow = 1
	long ll_null
	boolean lb_commitflag = true
	boolean lb_modify
	setnull(ll_null)
	if f_validatedw(parent.id_master) < 0 then
		parent.tab_main.selecttab(1)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_detail) < 0 then
		parent.tab_main.selecttab(2)
		return ::message.returnvalue
	end if
	setpointer(hourglass!)
	ll_row = parent.id_master.getrow()
	ll_detailrows = parent.id_detail.rowcount()
	if ll_row > 0 and ll_detailrows > 0 then
		if parent.id_detail.update(true, false) > 0 then
			SQL commit USING parent.it_transobject;
			messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
			lb_commitflag = true
			parent.event ue_close()
			return ::message.returnvalue
		else
			SQL rollback USING parent.it_transobject;
			messagebox("Problem Saving", "Can not save group level rights~r~nDetails: - " + parent.it_transobject.sqlerrtext, exclamation!, ok!, 1)
			setpointer(arrow!)
			parent.id_detail = parent.tab_main.tabpage_detail.dw_detail
			lb_commitflag = false
			return ::message.returnvalue
		end if
		return
	end if
	setpointer(arrow!)
	return ::message.returnvalue

// tab_main.create() returns 0 [event]
	this.tabpage_main = create tabpage_main
	this.tabpage_detail = create tabpage_detail
	this.control = {this.tabpage_main, this.tabpage_detail}

// tab_main.destroy() returns 0 [event]
	destroy this.tabpage_main
	destroy this.tabpage_detail

// tab_main.selectionchanged(integer oldindex, integer newindex) returns long [event]
	if newindex = 1 then
		parent.id_master.setfocus()
	elseif newindex = 2 then
		parent.id_detail.setfocus()
	end if
	return ::message.returnvalue

// tabpage_main.create() returns 0 [event]
	this.dw_master = create dw_master
	this.control = {this.dw_master}

// tabpage_main.destroy() returns 0 [event]
	destroy this.dw_master

// dw_master.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// dw_master.getfocus() returns long [event]
	setfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_master.itemfocuschanged(long row, dwobject dwo) returns long [event]
	if len(gettext()) > 0 then
		selecttext(1, len(gettext()))
	end if
	return ::message.returnvalue

// dw_master.itemerror(long row, dwobject dwo, string data) returns long [event]
	choose case dwo.name
	case "groupname"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for Group Name in current row")
		end if
	end choose
	return 1

// tabpage_detail.create() returns 0 [event]
	this.dw_detail = create dw_detail
	this.control = {this.dw_detail}

// tabpage_detail.destroy() returns 0 [event]
	destroy this.dw_detail

// dw_detail.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	setfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if len(gettext()) > 0 then
		selecttext(1, len(gettext()))
	end if
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	datetime ldt_null
	integer li_null
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ldt_null)
	setnull(li_null)
	choose case dwo.name
	case "cancelled"
		if upper(data) = "Y" then
			this.object.cancelledon[row] = today()
			this.object.cancelledby[row] = gl_usercode
		else
			this.object.cancelledon[row] = ldt_null
			this.object.cancelledby[row] = li_null
		end if
	end choose
	return 0
