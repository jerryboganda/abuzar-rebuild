// menu m_feevoucher (accounts)  ancestor: m_multi_entry

// m_feevoucher.create() returns 0 [event]
	m_feevoucher = this
	call super::create
	this.text = "m_feevoucher"

// m_feevoucher.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_saveandpost = create m_saveandpost
	this.m_populateoutstandinginvoices = create m_populateoutstandinginvoices
	this.m_searchstudentreceivables = create m_searchstudentreceivables
	this.m_showstudentfinewaiver = create m_showstudentfinewaiver
	this.m_showstudentledger = create m_showstudentledger
	this.m_searchclasswisestudentreceivables = create m_searchclasswisestudentreceivables
	this.m_populatestudentreceivables = create m_populatestudentreceivables
	this.item[upperbound(this.item) + 1] = this.m_saveandpost
	this.item[upperbound(this.item) + 1] = this.m_populateoutstandinginvoices
	this.item[upperbound(this.item) + 1] = this.m_searchstudentreceivables
	this.item[upperbound(this.item) + 1] = this.m_showstudentfinewaiver
	this.item[upperbound(this.item) + 1] = this.m_showstudentledger
	this.item[upperbound(this.item) + 1] = this.m_searchclasswisestudentreceivables
	this.item[upperbound(this.item) + 1] = this.m_populatestudentreceivables

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_saveandpost
	destroy this.m_populateoutstandinginvoices
	destroy this.m_searchstudentreceivables
	destroy this.m_showstudentfinewaiver
	destroy this.m_showstudentledger
	destroy this.m_searchclasswisestudentreceivables
	destroy this.m_populatestudentreceivables

