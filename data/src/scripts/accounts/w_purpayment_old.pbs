// window w_purpayment_old (accounts)  ancestor: w_multi_entry

// w_purpayment_old.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_listdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_list.dataobject = as_listdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)

// w_purpayment_old.wf_validateinvoice(long al_invcode) returns long
	long ll_retcode
	long ll_acccode
	long ll_counter
	string ls_aliasname
	double ld_invtotal
	double ld_outstandingamt
	SQL SELECT AliasName =( SELECT A.AliasName FROM Accounts A WHERE A.AccCode =H.SuppCode ) , AccCode =H.SuppCode , H.InvTotal , H.OutStandingAmt INTO :ls_aliasname, :ll_acccode, :ld_invtotal, :ld_outstandingamt FROM PurLedger H WHERE H.PurInvCode =:al_invcode AND H.Posted ='Y' AND H.AccountFor ='Y' AND H.OutstandingAmt > 0 USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.object.netamt[1] = ld_invtotal
		this.id_master.object.outstandingamt[1] = ld_outstandingamt
		this.id_master.object.aliasname[1] = ls_aliasname
		this.id_master.object.acccode[1] = ll_acccode
		this.id_master.object.ded1baseamt[1] = ld_outstandingamt
		this.id_master.object.ded2baseamt[1] = ld_outstandingamt
		this.id_master.object.ded3baseamt[1] = ld_outstandingamt
		this.id_master.object.ded4baseamt[1] = ld_outstandingamt
		this.id_master.object.ded5baseamt[1] = ld_outstandingamt
	end if
	return ll_retcode

// w_purpayment_old.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_purpayment_old.wf_create_vouchers() returns long
	integer li_rperson
	long ll_invcode
	long ll_installmentrowid
	long ll_retcode
	long ll_usercode
	long ll_null
	long ll_custcode
	long ll_glcode1
	long ll_vochcode1
	long ll_glcode2
	long ll_vochcode2
	long ll_glcode3
	long ll_vochcode3
	long ll_glcode4
	long ll_vochcode4
	long ll_counter = 1
	double ld_balance
	double ld_amt
	double ld_discount
	double ld_fine
	double ld_totalupd
	double ld_newbalance
	double ld_null
	double ld_total_amt
	double ld_total_discount
	double ld_total_fine
	datetime ldt_date
	datetime ldt_null
	string ls_msg
	string as_errortext
	string ls_null
	ls_msg = "000                                                                                                                                 "
	setnull(ll_null)
	setnull(ld_null)
	setnull(ls_null)
	setnull(ldt_null)
	ll_invcode = this.id_master.object.saleinvcode[1]
	ll_custcode = this.id_master.object.custcode[1]
	li_rperson = this.id_master.object.recoverypersoncode[1]
	for ll_counter = 1 to this.id_detail.rowcount()
		ll_installmentrowid = this.id_detail.object.installmentrowid[ll_counter]
		ld_amt = this.id_detail.object.amtreceived[ll_counter]
		ld_discount = this.id_detail.object.discount[ll_counter]
		ld_fine = this.id_detail.object.fine[ll_counter]
		SQL update InstallmentDetail SET AmtReceived =ISNULL ( AmtReceived + :ld_amt , 0 ) , Discount =ISNULL ( Discount + :ld_discount , 0 ) , Fine =ISNULL ( Fine + :ld_fine , 0 ) WHERE RowID =:ll_installmentrowid USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			ll_retcode = -1
			exit
		else
			ld_total_amt = ld_total_amt + ld_amt
			ld_total_discount = ld_total_discount + ld_discount
			ld_total_fine = ld_total_fine + ld_fine
		end if
	next
	if ll_retcode = 0 then
		ldt_date = this.id_master.object.date[1]
		ll_usercode = this.id_master.object.usercode[1]
		ld_totalupd = ld_total_amt + ld_total_discount
		if ll_invcode > 0 and ld_totalupd > 0.0 then
			this.it_transobject.getsaleinvbalance(ll_invcode, ld_balance)
			if this.it_transobject.sqlcode = 0 then
				if ld_total_amt > 0.0 then
					this.it_transobject.createvoucher(12, 2, ldt_date, ll_usercode, "Y", ldt_date, "Installment Amount Received", ldt_date, ll_null, ll_null, "", 2, ll_custcode, ld_total_amt, "", "Installment Amount Received", ll_null, ll_null, ll_null, ll_invcode, ld_balance, 0.00, ll_glcode1, ll_vochcode1, li_rperson)
					if this.it_transobject.sqlcode <> 0 then
						as_errortext = "Installment Amount Received Voucher Creation Error:~r~n" + this.it_transobject.sqlerrtext
						messagebox("1 Error", as_errortext, stopsign!)
						ll_retcode = -1
					else
						this.id_master.object.glvochcode[1] = ll_glcode1
					end if
				end if
				if ld_total_discount > 0.0 then
					this.it_transobject.createvoucher(22, 25, ldt_date, ll_usercode, "Y", ldt_date, "Installment Discount", ldt_date, ll_null, ll_null, "", 25, ll_custcode, ld_total_discount, "", "Installment Discount Given", ll_null, ll_null, ll_null, ll_invcode, ld_balance, 0.00, ll_glcode2, ll_vochcode2, li_rperson)
					if this.it_transobject.sqlcode <> 0 then
						as_errortext = "Installment Discount Voucher Creation Error:~r~n" + this.it_transobject.sqlerrtext
						messagebox("2 Error", as_errortext, stopsign!)
						ll_retcode = -1
					else
						this.id_master.object.glvochcodedisount[1] = ll_glcode2
					end if
				end if
				if ld_totalupd > 0.0 and ld_totalupd <= ld_balance and ll_retcode = 0 then
					ld_newbalance = ld_balance - ld_totalupd
					this.it_transobject.updatesaleinvbalance(ll_invcode, ld_newbalance)
					if this.it_transobject.sqlcode <> 0 then
						as_errortext = "Sale Invoice Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
						messagebox("3 Error", as_errortext, stopsign!)
						ll_retcode = -1
					end if
				else
					as_errortext = "Not Enough Balance On Sale Invoice."
					messagebox("4 Error", as_errortext, stopsign!)
					ll_retcode = -1
				end if
			else
				as_errortext = "Sale Invoice Balance Retrieval Error:~r~n" + this.it_transobject.sqlerrtext
				ll_retcode = -1
			end if
		end if
		if ll_invcode > 0 and ld_total_fine > 0.0 and ll_retcode = 0 then
			this.it_transobject.createvoucher(5, 2, ldt_date, ll_usercode, "Y", ldt_date, "Installment Fine Charged", ldt_date, ll_null, ll_null, "", ll_custcode, 23, ld_total_fine, "", "Installment Fine Charged", ll_null, ll_null, ll_null, ll_invcode, ld_balance, 0.00, ll_glcode3, ll_vochcode3, li_rperson)
			if this.it_transobject.sqlcode <> 0 then
				as_errortext = "Installment Fine Voucher Creation Error:~r~n" + this.it_transobject.sqlerrtext
				messagebox("5 Error", as_errortext, stopsign!)
				ll_retcode = -1
			else
				this.it_transobject.createvoucher(5, 2, ldt_date, ll_usercode, "Y", ldt_date, "Installment Fine Received", ldt_date, ll_null, ll_null, "", 2, ll_custcode, ld_total_fine, "", "Installment Fine Received", ll_null, ll_null, ll_null, ll_invcode, ld_balance, 0.00, ll_glcode4, ll_vochcode4, li_rperson)
				if this.it_transobject.sqlcode <> 0 then
					as_errortext = "Installment Fine Voucher Creation Error:~r~n" + this.it_transobject.sqlerrtext
					messagebox("6 Error", as_errortext, stopsign!)
					ll_retcode = -1
				else
					this.id_master.object.glvochcodefine[1] = ll_glcode4
				end if
			end if
		end if
	end if
	if ll_retcode <> 0 then
		messagebox("7 Error", as_errortext, stopsign!)
	end if
	return ll_retcode

// w_purpayment_old.wf_validate_aliasname(integer ai_deduction, string as_aliasname) returns integer
	boolean lb_groupcustcat
	long ll_found
	long ll_subcode
	long ll_acccode
	SQL SELECT acccode , subcode INTO :ll_acccode, :ll_subcode FROM dbo.accounts WHERE aliasname =:as_aliasname and active ='Y' AND SubCode NOT IN ( 3 , 7 ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ai_deduction = 1 then
			this.id_master.object.ded1acccode[1] = ll_acccode
		elseif ai_deduction = 2 then
			this.id_master.object.ded2acccode[1] = ll_acccode
		elseif ai_deduction = 3 then
			this.id_master.object.ded3acccode[1] = ll_acccode
		elseif ai_deduction = 4 then
			this.id_master.object.ded4acccode[1] = ll_acccode
		elseif ai_deduction = 5 then
			this.id_master.object.ded5acccode[1] = ll_acccode
		end if
	else
		messagebox("Alias Name Validation", "Alias Name Not Found. Please enter valid Alias Name")
		return 1
	end if
	return 0

// w_purpayment_old.wf_validate_acccode(integer ai_deduction, long al_acccode) returns long
	boolean lb_groupcustcat
	long ll_found
	long ll_subcode
	long ll_acccode
	string ls_aliasname
	SQL SELECT acccode , subcode , aliasname INTO :ll_acccode, :ll_subcode, :ls_aliasname FROM dbo.accounts WHERE acccode =:al_acccode and active ='Y' AND SubCode NOT IN ( 3 , 7 ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ai_deduction = 1 then
			this.id_master.object.ded1aliasname[1] = ls_aliasname
		elseif ai_deduction = 2 then
			this.id_master.object.ded2aliasname[1] = ls_aliasname
		elseif ai_deduction = 3 then
			this.id_master.object.ded3aliasname[1] = ls_aliasname
		elseif ai_deduction = 4 then
			this.id_master.object.ded4aliasname[1] = ls_aliasname
		elseif ai_deduction = 5 then
			this.id_master.object.ded5aliasname[1] = ls_aliasname
		end if
	else
		messagebox("Alias Name Validation", "Alias Name Not Found. Please enter valid Alias Name")
		return 1
	end if
	return 0

// w_purpayment_old.wf_set_deductionamt(integer ai_deduction, integer ai_perc_or_base, double ad_data) returns long
	if ai_perc_or_base = 1 then
		if ai_deduction = 1 then
			this.id_master.object.ded1amt[1] = ad_data * this.id_master.object.ded1baseamt[1] / 100
		elseif ai_deduction = 2 then
			this.id_master.object.ded2amt[1] = ad_data * this.id_master.object.ded2baseamt[1] / 100
		elseif ai_deduction = 3 then
			this.id_master.object.ded3amt[1] = ad_data * this.id_master.object.ded3baseamt[1] / 100
		elseif ai_deduction = 4 then
			this.id_master.object.ded4amt[1] = ad_data * this.id_master.object.ded4baseamt[1] / 100
		elseif ai_deduction = 5 then
			this.id_master.object.ded5amt[1] = ad_data * this.id_master.object.ded5baseamt[1] / 100
		end if
	elseif ai_deduction = 1 then
		this.id_master.object.ded1amt[1] = ad_data * this.id_master.object.ded1perc[1] / 100
	elseif ai_deduction = 2 then
		this.id_master.object.ded2amt[1] = ad_data * this.id_master.object.ded2perc[1] / 100
	elseif ai_deduction = 3 then
		this.id_master.object.ded3amt[1] = ad_data * this.id_master.object.ded3perc[1] / 100
	elseif ai_deduction = 4 then
		this.id_master.object.ded4amt[1] = ad_data * this.id_master.object.ded4perc[1] / 100
	elseif ai_deduction = 5 then
		this.id_master.object.ded5amt[1] = ad_data * this.id_master.object.ded5perc[1] / 100
	end if
	return 0

// w_purpayment_old.wf_deleteemptydetailrow() returns integer
	return 0

// w_purpayment_old.wf_return_payment(long al_invid, string as_errortext) returns boolean
	long ll_invcode
	long ll_counter
	long ll_detailrows
	long ll_masterrow
	boolean lb_commitflag = true
	double ld_amt
	double ld_oldtotalamt
	double ld_balance
	double ld_totalamt
	double ld_newbalance
	this.id_purpayment.retrieve(al_invid)
	as_errortext = "Some database problem occur"
	ll_detailrows = this.id_purpayment.rowcount()
	ll_counter = 1
	do while ll_counter <= ll_detailrows and lb_commitflag
		ll_invcode = this.id_purpayment.getitemnumber(ll_counter, "purinvcode")
		if not isnull(ll_invcode) then
			if wf_lockinvoice(ll_invcode) = 0 then
				this.it_transobject.getpurinvbalance(ll_invcode, ld_balance)
				if this.it_transobject.sqlcode = 0 then
					if ld_amt <> 0.0 and lb_commitflag then
						ld_newbalance = ld_balance + ld_amt
						if ld_newbalance >= 0.0 then
							this.it_transobject.updatepurinvbalance(ll_invcode, ld_newbalance)
							if this.it_transobject.sqlcode <> 0 then
								lb_commitflag = false
								as_errortext = "Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
							end if
						else
							lb_commitflag = false
							as_errortext = "Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
						end if
					else
						lb_commitflag = false
						as_errortext = "Not Enough Balance On Purchase Invoice."
					end if
				else
					lb_commitflag = false
					as_errortext = "Balance Retrieval Error:~r~n" + this.it_transobject.sqlerrtext
				end if
			else
				lb_commitflag = false
				as_errortext = "Invoice is used by another user"
			end if
		end if
		ll_counter = ll_counter + 1
	loop
	return lb_commitflag

// w_purpayment_old.wf_lockinvoice(long al_invcode) returns long
	integer li_count
	this.it_transobject.dbparm = " Async =1, DBGetTime = 20"
	this.it_transobject.lockpurinvoice(al_invcode)
	this.it_transobject.dbparm = "Async =0, DBGetTime = 0"
	return this.it_transobject.sqlcode

// w_purpayment_old.create() returns 0 [event]
	integer icurrent
	call super::create
	this.dw_print = create dw_print
	this.dw_purpayment = create dw_purpayment
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print
	this.control[icurrent + 2] = this.dw_purpayment

// w_purpayment_old.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_print
	destroy this.dw_purpayment

// w_purpayment_old.ue_save() returns 0 [event]
	long ll_mastercurrrow
	long ll_invid
	long ll_null
	long ll_usercode
	long ll_unpostedtrans
	long ll_counter
	integer ll_salesmancode
	boolean lb_commitflag = true
	boolean lb_modify
	boolean lb_continue = true
	string ls_itemname
	string ls_msg
	string ls_errortext
	setnull(ll_null)
	ll_mastercurrrow = this.id_master.getrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	setpointer(hourglass!)
	open(w_salesmanpassword)
	ll_usercode = long(message.doubleparm)
	setfocus()
	ls_msg = "000                                                                                                                                 "
	this.it_transobject.checkunpostedpurinvintransactions(this.id_master.object.purinvcode[1], this.id_master.object.code[this.id_master.rowcount()], "V", ll_unpostedtrans, ls_msg)
	if ll_unpostedtrans > 0 then
		this.id_master.scrolltorow(1)
		this.id_master.setfocus()
		messagebox("Purchase Invoice Validation Problem", "Unposted Transaction(s) Exist for this Purchase Invoice~r~n~r~n" + ls_msg)
		return
	end if
	setpointer(hourglass!)
	if ll_usercode > 0 and ll_mastercurrrow > 0 then
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			wf_tabnewid("PurPayment", ll_invid)
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
		else
			lb_modify = true
		end if
		this.id_master.object.usercode[ll_mastercurrrow] = ll_usercode
		if lb_modify then
			lb_continue = wf_return_payment(ll_invid, ls_errortext)
		end if
		if this.id_master.update(true, false) = 1 then
			SQL commit USING this.it_transobject;
			messagebox("Purchase Payment", "Changes Take Effect in database")
			this.id_master.resetupdate()
			this.ib_commitok = true
			this.editflag = false
		else
			SQL rollback USING this.it_transobject;
			messagebox("1-Purchase Payment", "Changes do not Take Effect in database", stopsign!)
		end if
		ll_invid = ll_null
		this.id_master.object.code[ll_mastercurrrow] = ll_null
	end if
	setpointer(arrow!)

// w_purpayment_old.ue_newform() returns 0 [event]
	call super::ue_newform
	this.id_master.setfocus()
	this.idc_paymentacccode.reset()
	this.idc_paymentacccode.retrieve()
	this.idc_paymentacccode.setfilter("subcode=2")
	this.idc_paymentacccode.filter()
	wf_protectdw(this.id_master, 0)

// w_purpayment_old.ue_detail() returns 0 [event]
	long li_protect
	call super::ue_detail
	this.im_menu.m_file.m_save.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_print.visible = true
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_item.m_newitem.enabled = false
	this.im_menu.m_item.m_deleteitem.enabled = false
	if this.id_list.getrow() > 0 then
		if this.id_list.object.code[this.id_list.getrow()] > 0 then
			li_protect = 1
		else
			li_protect = 0
		end if
		this.id_detail.retrieve(this.id_list.object.code[this.id_list.getrow()])
	end if
	if this.id_master.object.paymentmode[1] = "C" then
		this.idc_paymentacccode.setfilter("subcode=2")
	else
		this.idc_paymentacccode.setfilter("subcode=4")
	end if
	this.idc_paymentacccode.filter()
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)

// w_purpayment_old.ue_postopen() returns 0 [event]
	integer ll_rtcode
	call super::ue_postopen
	ll_rtcode = this.id_master.getchild("paymentacccode", this.idc_paymentacccode)
	this.idc_paymentacccode.settransobject(this.it_transobject)
	this.idc_paymentacccode.retrieve()
	this.id_print = this.dw_print
	this.id_purpayment = this.dw_purpayment
	this.id_purpayment.settransobject(this.it_transobject)

// w_purpayment_old.ue_print() returns 0 [event]
	long ll_row
	long ll_invcode
	long ll_option = 1
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	if gs_company = "REHMANVALLEY" then
		this.id_print.dataobject = "d_rehmanvalley_installmentreceipt_print"
	else
		this.id_print.dataobject = "d_installmentreceipt_print"
	end if
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("saleaskforcopies") = "Y" then
		open(w_printer_copies)
		this.id_print.object.datawindow.print.copies = string(message.doubleparm)
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		this.id_print.print()
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_purpayment_old.ue_list() returns 0 [event]
	call super::ue_list
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_print.visible = true

// w_purpayment_old.open() returns long [event]
	m_entry lm_menu
	long ll_width
	long ll_height
	environment env
	postevent("ue_postopen")
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	lm_menu.dynamic mf_initsecurityapp(lm_menu)
	if getenvironment(env) <> 1 then
		return ::message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.tab_retrieve.width = ll_width * 0.99
	this.tab_retrieve.height = ll_height * 0.83
	this.tab_retrieve.tabpage_detail.dw_detail.width = ll_width * 0.98
	this.tab_retrieve.tabpage_detail.dw_itemsdetail.height = 0
	this.tab_retrieve.tabpage_detail.dw_detail.height = this.tab_retrieve.tabpage_detail.height - 200
	this.tab_retrieve.tabpage_list.gb_fliter.width = ll_width * 0.97 - this.tab_retrieve.tabpage_list.gb_sort.width
	this.tab_retrieve.tabpage_list.r_1.width = ll_width * 0.99
	this.tab_retrieve.tabpage_list.r_1.height = ll_height * 0.765 - this.tab_retrieve.tabpage_list.gb_sort.height
	this.tab_retrieve.tabpage_list.dw_list.width = ll_width * 0.98
	this.tab_retrieve.tabpage_list.dw_list.height = ll_height * 0.75 - this.tab_retrieve.tabpage_list.dw_list.y
	this.tab_retrieve.tabpage_detail.dw_itemslist.height = ll_height * 0.6
	this.tab_retrieve.tabpage_detail.dw_itemslist.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width * 0.67
	this.tab_retrieve.tabpage_detail.dw_itemslist.x = 1150
	setredraw(true)
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "name"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	case "icode"
		if data = "" or isnull(data) then
			messagebox("Item Name Validation", "Value required for item name in current row")
		end if
	end choose
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	double ld_balance
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "purinvcode"
		if isnull(data) or long(data) < 0 then
			messagebox("Purchase Invoice Code Validation", "Purchase Invoice Code Validation Error~n~rPlease enter Some valid Purchase Invoice Code", stopsign!)
			ll_retcode = 1
		else
			ll_retcode = parent.parent.parent.wf_validateinvoice(long(data))
			if ll_retcode <> 0 then
				messagebox("Purchase Invoice Code Validation", "Purchase Invoice Code Validation Error~n~rPlease enter Some valid Purchase Invoice Code", stopsign!)
				ll_retcode = 1
			end if
		end if
	case "paymentmode"
		if data = "C" then
			parent.parent.parent.idc_paymentacccode.setfilter("subcode=2")
		else
			parent.parent.parent.idc_paymentacccode.setfilter("subcode=4")
		end if
		parent.parent.parent.idc_paymentacccode.filter()
		return 0
	case "ded1aliasname"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_validate_aliasname(1, data)
		end if
	case "ded2aliasname"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_validate_aliasname(2, data)
		end if
	case "ded3aliasname"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_validate_aliasname(3, data)
		end if
	case "ded4aliasname"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_validate_aliasname(4, data)
		end if
	case "ded5aliasname"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_validate_aliasname(5, data)
		end if
	case "ded1acccode"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_validate_acccode(1, long(data))
		end if
	case "ded2acccode"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_validate_acccode(2, long(data))
		end if
	case "ded3acccode"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_validate_acccode(3, long(data))
		end if
	case "ded4acccode"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_validate_acccode(4, long(data))
		end if
	case "ded5acccode"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_validate_acccode(5, long(data))
		end if
	case "ded1perc"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_set_deductionamt(1, 1, double(data))
		end if
	case "ded2perc"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_set_deductionamt(2, 1, double(data))
		end if
	case "ded3perc"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_set_deductionamt(3, 1, double(data))
		end if
	case "ded4perc"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_set_deductionamt(4, 1, double(data))
		end if
	case "ded5perc"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_set_deductionamt(5, 1, double(data))
		end if
	case "ded1baseamt"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_set_deductionamt(1, 2, double(data))
		end if
	case "ded2baseamt"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_set_deductionamt(1, 2, double(data))
		end if
	case "ded3baseamt"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_set_deductionamt(1, 3, double(data))
		end if
	case "ded4baseamt"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_set_deductionamt(1, 4, double(data))
		end if
	case "ded5baseamt"
		if data = "" or isnull(data) then
			return 0
		else
			return parent.parent.parent.wf_set_deductionamt(1, 5, double(data))
		end if
		return
	end choose
	return ll_retcode

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	integer li_movement
	long ll_row
	long ll_temp
	long ll_code
	long ll_invcode
	string sl_columnname
	string ls_filterexp
	s_popup_selection lstr_selection
	s_arguements lst_arg
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf5! then
		openwithparm(w_popup_comprehensicesearch_selection, "d_supplier_list")
		lstr_selection = message.powerobjectparm
		if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
			openwithparm(w_arg_sale_outstanding_a_customer, lstr_selection.l_code2)
			lst_arg = message.powerobjectparm
			if lst_arg.i_status = 1 and lst_arg.l_code1 > 0 then
				this.object.saleinvcode[1] = lst_arg.l_code1
				if parent.parent.parent.wf_validateinvoice(lst_arg.l_code1) <> 0 then
					messagebox("Purchase Invoice Code Validation", "Purchase Invoice Code Validation Error~n~rPlease enter Some valid Purchase Invoice Code", stopsign!)
				end if
			end if
		end if
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	double ld_balance
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	choose case dwo.name
	case "paymentmode", "paymentacccode"
		if this.object.paymentmode[row] = "C" then
			parent.parent.parent.idc_paymentacccode.setfilter("subcode=2")
		else
			parent.parent.parent.idc_paymentacccode.setfilter("subcode=4")
		end if
		parent.parent.parent.idc_paymentacccode.filter()
		return 0
	end choose
	return ll_retcode

// dw_itemsdetail.getfocus() returns long [event]
	return ::message.returnvalue
