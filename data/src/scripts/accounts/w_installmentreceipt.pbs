// window w_installmentreceipt (accounts)  ancestor: w_multi_entry

// w_installmentreceipt.wf_validateitem() returns integer
	integer li_errcode
	return li_errcode

// w_installmentreceipt.wf_duplicatename(string as_name) returns boolean
	long ll_count
	long ll_masterrow
	long ll_code
	boolean b_flag
	ll_masterrow = this.id_master.getrow()
	if ll_masterrow > 0 then
		ll_code = this.id_master.object.code[ll_masterrow]
	end if
	as_name = trim(as_name)
	if isnull(ll_code) then
		SQL SELECT count ( *) INTO :ll_count FROM AgingInterval WHERE AgingInterval.name =:as_name USING this.it_transobject;
	else
		SQL SELECT count ( *) INTO :ll_count FROM AgingInterval WHERE AgingInterval.name =:as_name AND AgingInterval.AgingIntervalCode <> :ll_code USING this.it_transobject;
	end if
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_installmentreceipt.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_listdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_list.dataobject = as_listdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)

// w_installmentreceipt.wf_validateinvoice(long al_invcode) returns long
	long ll_retcode
	long ll_custcode
	long ll_counter
	string ls_itemname
	double ld_invtotal
	double ld_outstandingamt
	SQL SELECT CustCode =H.CustCode , ItemName =( SELECT I.Name FROM Item I WHERE I.ICode =H.ICode ) , S.InvTotal , S.OutStandingAmt INTO :ll_custcode, :ls_itemname, :ld_invtotal, :ld_outstandingamt FROM InstallmentHeader H , SaleLedger S WHERE H.SaleInvCode =:al_invcode AND H.Posted ='Y' AND H.SaleInvCode =S.SaleInvCode AND S.OutstandingAmt > 0 USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.object.netamt[1] = ld_invtotal
		this.id_master.object.outstandingamt[1] = ld_outstandingamt
		this.id_master.object.custcode[1] = ll_custcode
		this.id_master.object.itemname[1] = ls_itemname
		this.id_detail.setredraw(false)
		for ll_counter = 1 to this.id_detail.rowcount()
			this.id_detail.deleterow(0)
		next
		this.idc_installment.retrieve(al_invcode)
		if this.idc_installment.rowcount() > 0 then
			ll_counter = 1
			for ll_counter = 1 to this.idc_installment.rowcount()
				this.id_detail.object.installmentrowid[ll_counter] = this.idc_installment.getitemnumber(ll_counter, "rowid")
				wf_validateinstallment(al_invcode, this.id_detail.object.installmentrowid[ll_counter], ll_counter)
			next
		end if
		this.id_detail.setredraw(true)
	end if
	return ll_retcode

// w_installmentreceipt.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if lower(ls_colname) = "date" then
			if f_rightexists(5249) then
				ad_dwcontrol.modify(ls_colname + ".Protect=0")
				ad_dwcontrol.modify(ls_colname + ".backcolor=RGB(255,255,255)")
			else
				ad_dwcontrol.modify(ls_colname + ".Protect=1")
			end if
		elseif ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_installmentreceipt.wf_create_vouchers() returns long
	integer li_rperson
	long ll_invcode
	long ll_installmentrowid
	long ll_retcode
	long ll_usercode
	long ll_null
	long ll_custcode
	long ll_glcode1
	long ll_vochcode1
	long ll_glcode2
	long ll_vochcode2
	long ll_glcode3
	long ll_vochcode3
	long ll_glcode4
	long ll_vochcode4
	long ll_counter
	long ll_acccode
	long ll_vochcatcode
	double ld_balance
	double ld_amt
	double ld_discount
	double ld_fine
	double ld_totalupd
	double ld_newbalance
	double ld_null
	double ld_total_amt
	double ld_total_discount
	double ld_total_fine
	datetime ldt_date
	datetime ldt_null
	string ls_msg
	string as_errortext
	string ls_null
	string ls_refno
	string ls_remarks
	char lc_paymentmode
	ls_msg = "000                                                                                                                                 "
	setnull(ll_null)
	setnull(ld_null)
	setnull(ls_null)
	setnull(ldt_null)
	ll_invcode = this.id_master.object.saleinvcode[1]
	ll_custcode = this.id_master.object.custcode[1]
	li_rperson = this.id_master.object.recoverypersoncode[1]
	for ll_counter = 1 to this.id_detail.rowcount()
		ll_installmentrowid = this.id_detail.object.installmentrowid[ll_counter]
		ld_amt = this.id_detail.object.amtreceived[ll_counter]
		ld_discount = this.id_detail.object.discount[ll_counter]
		ld_fine = this.id_detail.object.fine[ll_counter]
		ll_acccode = this.id_detail.object.receivedacccode[ll_counter]
		lc_paymentmode = this.id_detail.object.paymentmode[ll_counter]
		ls_refno = this.id_detail.object.refno[ll_counter]
		ls_remarks = this.id_detail.object.remarks[ll_counter]
		SQL update InstallmentDetail SET AmtReceived =ISNULL ( AmtReceived + :ld_amt , 0 ) , Discount =ISNULL ( Discount + :ld_discount , 0 ) , Fine =ISNULL ( Fine + :ld_fine , 0 ) WHERE RowID =:ll_installmentrowid USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			ll_retcode = -1
			return ll_retcode
		else
			ld_total_amt = ld_total_amt + ld_amt
			ld_total_discount = ld_total_discount + ld_discount
			ld_total_fine = ld_total_fine + ld_fine
		end if
		if ll_retcode = 0 then
			ldt_date = this.id_detail.object.receivedon[ll_counter]
			ll_usercode = this.id_master.object.usercode[1]
			ld_totalupd = ld_total_amt + ld_total_discount
			if ll_invcode > 0 and ld_amt + ld_discount > 0.0 then
				this.it_transobject.getsaleinvbalance(ll_invcode, ld_balance)
				if this.it_transobject.sqlcode = 0 then
					if ld_amt > 0.0 then
						if lc_paymentmode = "C" then
							ll_vochcatcode = 12
						else
							ll_vochcatcode = 13
						end if
						this.it_transobject.createvoucher(ll_vochcatcode, ll_acccode, ldt_date, ll_usercode, "Y", ldt_date, "Installment Amount Received", ldt_date, ll_null, ll_null, ls_refno, ll_acccode, ll_custcode, ld_amt, ls_refno, "Installment Amount Received", ll_null, ll_null, ll_null, ll_invcode, ld_balance, ld_balance - ld_amt, ll_glcode1, ll_vochcode1, li_rperson)
						if this.it_transobject.sqlcode <> 0 then
							as_errortext = "Installment Amount Received Voucher Creation Error:~r~n" + this.it_transobject.sqlerrtext
							messagebox("1 Error", as_errortext, stopsign!)
							ll_retcode = -1
						else
							this.id_detail.object.glvochcode[ll_counter] = ll_glcode1
						end if
					end if
					if ld_discount > 0.0 then
						this.it_transobject.createvoucher(22, 25, ldt_date, ll_usercode, "Y", ldt_date, "Installment Discount", ldt_date, ll_null, ll_null, ls_refno, 25, ll_custcode, ld_discount, ls_refno, "Installment Discount Given", ll_null, ll_null, ll_null, ll_invcode, ld_balance - ld_amt, ld_balance - ld_amt - ld_discount, ll_glcode2, ll_vochcode2, li_rperson)
						if this.it_transobject.sqlcode <> 0 then
							as_errortext = "Installment Discount Voucher Creation Error:~r~n" + this.it_transobject.sqlerrtext
							messagebox("2 Error", as_errortext, stopsign!)
							ll_retcode = -1
						else
							this.id_detail.object.glvochcodediscount[ll_counter] = ll_glcode2
						end if
					end if
					if ld_amt + ld_discount > 0.0 and ld_amt + ld_discount <= ld_balance and ll_retcode = 0 then
						ld_newbalance = ld_balance - (ld_amt + ld_discount)
						this.it_transobject.updatesaleinvbalance(ll_invcode, ld_newbalance)
						if this.it_transobject.sqlcode <> 0 then
							as_errortext = "Sale Invoice Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
							messagebox("3 Error", as_errortext, stopsign!)
							ll_retcode = -1
						end if
					else
						as_errortext = "Not Enough Balance On Sale Invoice."
						messagebox("4 Error", as_errortext, stopsign!)
						ll_retcode = -1
					end if
				else
					as_errortext = "Sale Invoice Balance Retrieval Error:~r~n" + this.it_transobject.sqlerrtext
					ll_retcode = -1
				end if
			end if
			if ll_invcode > 0 and ld_fine > 0.0 and ll_retcode = 0 then
				this.it_transobject.createvoucher(5, 2, ldt_date, ll_usercode, "Y", ldt_date, "Installment Fine Charged", ldt_date, ll_null, ll_null, ls_refno, ll_custcode, 23, ld_fine, ls_refno, "Installment Fine Charged", ll_null, ll_null, ll_null, ll_invcode, ld_newbalance, ld_newbalance, ll_glcode3, ll_vochcode3, li_rperson)
				if this.it_transobject.sqlcode <> 0 then
					as_errortext = "Installment Fine Voucher Creation Error:~r~n" + this.it_transobject.sqlerrtext
					messagebox("5 Error", as_errortext, stopsign!)
					ll_retcode = -1
				else
					this.it_transobject.createvoucher(5, 2, ldt_date, ll_usercode, "Y", ldt_date, "Installment Fine Received", ldt_date, ll_null, ll_null, ls_refno, 2, ll_custcode, ld_fine, ls_refno, "Installment Fine Received", ll_null, ll_null, ll_null, ll_invcode, ld_newbalance, ld_newbalance, ll_glcode4, ll_vochcode4, li_rperson)
					if this.it_transobject.sqlcode <> 0 then
						as_errortext = "Installment Fine Voucher Creation Error:~r~n" + this.it_transobject.sqlerrtext
						messagebox("6 Error", as_errortext, stopsign!)
						ll_retcode = -1
					else
						this.id_detail.object.glvochcodefine[ll_counter] = ll_glcode4
					end if
				end if
			end if
		end if
		if ll_retcode <> 0 then
			messagebox("7 Error", as_errortext, stopsign!)
		end if
	next
	return ll_retcode

// w_installmentreceipt.wf_validateinstallment(long al_invcode, long al_rowid, long al_row) returns long
	long ll_retcode
	long ll_null
	double ld_amt
	double ld_outstandingamt
	datetime ldt_date
	datetime ldt_null
	setnull(ll_null)
	setnull(ldt_null)
	if vf_dwdupcode1(this.id_detail, "installmentrowid", string(al_rowid), al_row) = true then
		ll_retcode = 2
	else
		SQL SELECT Amount =InstallmentDetail.Amount , Date =InstallmentDetail.Date , Balance =ISNULL ( InstallmentDetail.Amount - InstallmentDetail.Discount - InstallmentDetail.AmtReceived , 0 ) INTO :ld_amt, :ldt_date, :ld_outstandingamt FROM InstallmentDetail , InstallmentHeader WHERE InstallmentHeader.SaleInvCode =:al_invcode AND InstallmentHeader.InstallmentCode =InstallmentDetail.InstallmentCode AND InstallmentDetail.RowID =:al_rowid AND InstallmentDetail.Amount - InstallmentDetail.Discount - InstallmentDetail.AmtReceived > 0 AND InstallmentDetail.Cancelled ='N' USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.id_detail.object.installmentamount[al_row] = ld_amt
			if ld_outstandingamt > 0.0 then
				this.id_detail.object.installmentbalance[al_row] = ld_outstandingamt
			else
				this.id_detail.object.installmentbalance[al_row] = 0.00
			end if
			this.id_detail.object.installmentdate[al_row] = ldt_date
		end if
	end if
	if ll_retcode = 2 then
		this.id_detail.object.installmentrowid[al_row] = ll_null
		this.id_detail.object.installmentamount[al_row] = 0.00
		this.id_detail.object.installmentbalance[al_row] = 0.00
		this.id_detail.object.installmentdate[al_row] = ldt_null
		post event ue_deleteitem_row(al_row)
	end if
	return ll_retcode

// w_installmentreceipt.wf_deleteemptydetailrow() returns integer
	long ll_rowcount
	long ll_counter
	double ld_amt
	double ld_discount
	double ld_fine
	integer li_rtcode
	dwruntimeerror myexc
	ll_rowcount = this.id_detail.rowcount()
	ll_counter = 1
	do while ll_counter <= this.id_detail.rowcount()
		try
			ld_amt = this.id_detail.object.amtreceived[ll_counter]
			ld_discount = this.id_detail.object.discount[ll_counter]
			ld_fine = this.id_detail.object.fine[ll_counter]
		catch (throwable myexc)
		end try
		if ld_amt + ld_discount + ld_fine = 0.0 then
			this.id_detail.deleterow(ll_counter)
			li_rtcode = 1
			this.ib_itemslistopen = false
			this.id_itemslist.hide()
			setfocus()
		else
			ll_counter = ll_counter + 1
		end if
	loop
	return li_rtcode

// w_installmentreceipt.create() returns 0 [event]
	integer icurrent
	call super::create
	this.dw_print = create dw_print
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print

// w_installmentreceipt.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_print

// w_installmentreceipt.ue_save() returns 0 [event]
	long ll_mastercurrrow
	long ll_invid
	long ll_null
	long ll_usercode
	long ll_unpostedtrans
	long ll_counter
	integer ll_salesmancode
	boolean lb_commitflag = true
	string ls_itemname
	string ls_msg
	setnull(ll_null)
	ll_mastercurrrow = this.id_master.getrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	wf_deleteemptydetailrow()
	if this.id_detail.rowcount() = 0 then
		this.id_detail.insertrow(0)
		this.id_detail.setrow(1)
		this.id_detail.scrolltorow(1)
		this.id_detail.setfocus()
		this.id_detail.setcolumn("InstallmentRowID")
		return
	end if
	setpointer(hourglass!)
	open(w_salesmanpassword)
	ll_usercode = long(message.doubleparm)
	setfocus()
	ls_msg = "000                                                                                                                                 "
	this.it_transobject.checkunpostedsaleinvintransactions(this.id_master.object.saleinvcode[1], this.id_master.object.code[this.id_master.rowcount()], "V", ll_unpostedtrans, ls_msg)
	if ll_unpostedtrans > 0 then
		this.id_master.scrolltorow(1)
		this.id_master.setfocus()
		messagebox("Sale Invoice Validation Problem", "Unposted Transaction(s) Exist for this Sale Invoice~r~n~r~n" + ls_msg)
		return
	end if
	setpointer(hourglass!)
	if ll_usercode > 0 and ll_mastercurrrow > 0 then
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			wf_tabnewid("InstallmentReceipt", ll_invid)
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
		end if
		this.id_master.object.usercode[ll_mastercurrrow] = ll_usercode
		for ll_counter = 1 to this.id_detail.rowcount()
			this.id_detail.object.code[ll_counter] = ll_invid
		next
		if wf_create_vouchers() = 0 then
			if this.id_master.update(true, false) = 1 then
				if this.id_detail.update(true, false) = 1 then
					SQL commit USING this.it_transobject;
					messagebox("Installment Receipt", "Changes Take Effect in database")
					this.id_master.resetupdate()
					this.ib_commitok = true
					this.editflag = false
				else
					SQL rollback USING this.it_transobject;
					messagebox("1-1, Installment Receipt", "Changes do not Take Effect in database", stopsign!)
				end if
			else
				SQL rollback USING this.it_transobject;
				messagebox("1-Installment Receipt", "Changes do not Take Effect in database", stopsign!)
			end if
		else
			SQL rollback USING this.it_transobject;
			messagebox("2-Installment Receipt", "Changes do not Take Effect in database", stopsign!)
		end if
		ll_invid = ll_null
		this.id_master.object.code[ll_mastercurrrow] = ll_null
	end if
	setpointer(arrow!)

// w_installmentreceipt.ue_newform() returns 0 [event]
	call super::ue_newform
	this.id_master.setfocus()
	this.idc_installment.reset()
	this.idc_installment.insertrow(0)
	this.idc_acc.reset()
	this.idc_acc.insertrow(0)
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)

// w_installmentreceipt.ue_detail() returns 0 [event]
	long li_protect
	call super::ue_detail
	this.im_menu.m_file.m_save.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_print.visible = true
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_item.m_newitem.enabled = false
	this.im_menu.m_item.m_deleteitem.enabled = false
	if this.id_list.getrow() > 0 then
		if this.id_list.object.code[this.id_list.getrow()] > 0 then
			li_protect = 1
		else
			li_protect = 0
		end if
		this.id_detail.retrieve(this.id_list.object.code[this.id_list.getrow()])
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)

// w_installmentreceipt.ue_postopen() returns 0 [event]
	integer ll_rtcode
	call super::ue_postopen
	ll_rtcode = this.id_detail.getchild("InstallmentRowID", this.idc_installment)
	this.idc_installment.settransobject(this.it_transobject)
	this.idc_installment.insertrow(0)
	ll_rtcode = this.id_detail.getchild("ReceivedAccCode", this.idc_acc)
	this.idc_acc.settransobject(this.it_transobject)
	this.idc_acc.insertrow(0)
	this.id_print = this.dw_print
	if f_rightexists(5136) then
		this.id_detail.object.amtreceived.visible = true
		this.id_master.object.glvochcode.visible = true
		this.id_master.object.glvochcode_t.visible = true
	else
		this.id_detail.object.amtreceived.visible = false
		this.id_master.object.glvochcode.visible = false
		this.id_master.object.glvochcode_t.visible = false
	end if
	if f_rightexists(5137) then
		this.id_detail.object.discount.visible = true
		this.id_master.object.glvochcodedisount.visible = true
		this.id_master.object.glvochcodedisount_t.visible = true
	else
		this.id_detail.object.discount.visible = false
		this.id_master.object.glvochcodediscount.visible = false
		this.id_master.object.glvochcodedisount_t.visible = false
	end if
	if f_rightexists(5138) then
		this.id_detail.object.fine.visible = true
		this.id_master.object.glvochcodefine.visible = true
		this.id_master.object.glvochcodefine_t.visible = true
		return
	end if
	this.id_detail.object.fine.visible = false
	this.id_master.object.glvochcodefine.visible = false
	this.id_master.object.glvochcodefine_t.visible = false

// w_installmentreceipt.ue_print() returns 0 [event]
	long ll_row
	long ll_invcode
	long ll_option = 1
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	if gs_company = "REHMANVALLEY" then
		this.id_print.dataobject = "d_rehmanvalley_installmentreceipt_print"
	elseif gs_company = "JAMEELTRADERS" then
		this.id_print.dataobject = "d_jameeltraders_installmentreceipt_print"
	elseif gs_company = "NAVEEDELECT" then
		this.id_print.dataobject = "d_naveedelect_installmentreceipt_print"
	else
		this.id_print.dataobject = "d_installmentreceipt_print"
	end if
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("saleaskforcopies") = "Y" then
		open(w_printer_copies)
		this.id_print.object.datawindow.print.copies = string(message.doubleparm)
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		this.id_print.print()
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_installmentreceipt.ue_list() returns 0 [event]
	call super::ue_list
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_print.visible = true

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "name"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	case "icode"
		if data = "" or isnull(data) then
			messagebox("Item Name Validation", "Value required for item name in current row")
		end if
	end choose
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	double ld_balance
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "saleinvcode"
		if isnull(data) or long(data) < 0 then
			messagebox("Sale Invoice Code Validation", "Sale Invoice Code Validation Error~n~rPlease enter Some valid Sale Invoice Code", stopsign!)
			ll_retcode = 1
		else
			ll_retcode = parent.parent.parent.wf_validateinvoice(long(data))
			if ll_retcode <> 0 then
				messagebox("Sale Invoice Code Validation", "Sale Invoice Code Validation Error~n~rPlease enter Some valid Sale Invoice Code", stopsign!)
				ll_retcode = 1
			end if
		end if
	end choose
	return ll_retcode

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	integer li_movement
	long ll_row
	long ll_temp
	long ll_code
	long ll_invcode
	string sl_columnname
	string ls_filterexp
	s_popup_selection lstr_selection
	s_arguements lst_arg
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf5! then
		openwithparm(w_popup_comprehensicesearch_selection, "d_customer_list")
		lstr_selection = message.powerobjectparm
		if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
			openwithparm(w_arg_sale_outstanding_a_customer, lstr_selection.l_code2)
			lst_arg = message.powerobjectparm
			if lst_arg.i_status = 1 and lst_arg.l_code1 > 0 then
				this.object.saleinvcode[1] = lst_arg.l_code1
				if parent.parent.parent.wf_validateinvoice(lst_arg.l_code1) <> 0 then
					messagebox("Sale Invoice Code Validation", "Sale Invoice Code Validation Error~n~rPlease enter Some valid Sale Invoice Code", stopsign!)
				end if
			end if
		end if
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	integer ll_retcode
	double ld_balance
	string ls_managername
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "installmentrowid"
		if isnull(data) or long(data) < 0 then
			messagebox("Installment Validation", "Installment Validation Error~n~rPlease select Some valid Installment", stopsign!)
			ll_retcode = 1
		else
			ll_retcode = parent.parent.parent.wf_validateinstallment(parent.parent.parent.id_master.object.saleinvcode[1], long(data), row)
			if ll_retcode <> 0 then
				if ll_retcode = 2 then
					messagebox("Installment Validation", "Installment Validation Error~n~rDuplication Installment. Please select Some valid Installment", stopsign!)
					ll_retcode = 1
				else
					messagebox("Installment Validation", "Installment Validation Error~n~rPlease select Some valid Installment", stopsign!)
					ll_retcode = 1
				end if
			end if
		end if
	case "amtreceived"
		if double(data) >= 0.0 then
			ld_balance = this.object.installmentamount[row] - double(data) - this.object.discount[row]
			if isnull(ld_balance) then
				ld_balance = 0
			end if
			if ld_balance >= 0.0 then
				this.object.installmentbalance[row] = ld_balance
			else
				messagebox("Amount Received Validation", "Installment Amount Received Validation Error~n~rPlease enter some valid Installment Amount Received", stopsign!)
				ll_retcode = 1
			end if
		else
			messagebox("Amount Received Validation", "Installment Amount Received Validation Error~n~rPlease enter some valid Amount Received", stopsign!)
			return 1
		end if
	case "discount"
		if double(data) >= 0.0 then
			ld_balance = this.object.installmentamount[row] - double(data) - this.object.amtreceived[row]
			if isnull(ld_balance) then
				ld_balance = 0
			end if
			if ld_balance >= 0.0 then
				this.object.installmentbalance[row] = ld_balance
			else
				messagebox("Discount Validation", "Installment Discount Validation Error~n~rPlease enter some valid Installment Discount", stopsign!)
				ll_retcode = 1
			end if
		else
			messagebox("Discount Validation", "Installment Discount Validation Error~n~rPlease enter some valid Installment Discount", stopsign!)
			return 1
		end if
	case "fine"
		if double(data) < 0.0 then
			messagebox("Fine Validation", "Installment Fine Validation Error~n~rPlease enter some valid Installment Fine", stopsign!)
			return 1
		end if
	case "paymentmode"
		if data = "C" then
			parent.parent.parent.idc_acc.retrieve(2)
			if parent.parent.parent.idc_acc.rowcount() > 0 then
				parent.parent.parent.id_detail.object.receivedacccode[row] = parent.parent.parent.idc_acc.getitemnumber(1, "acccode")
			end if
		else
			parent.parent.parent.idc_acc.retrieve(4)
			if parent.parent.parent.idc_acc.rowcount() > 0 then
				parent.parent.parent.id_detail.object.receivedacccode[row] = parent.parent.parent.idc_acc.getitemnumber(1, "acccode")
			end if
		end if
	end choose
	return li_errcode

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "limit"
		if data = "" or isnull(data) or real(data) < 0.0 then
			messagebox("Limit Validation", "Valid Value required for limit in current row")
		end if
	end choose
	return 1

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	return ::message.returnvalue
