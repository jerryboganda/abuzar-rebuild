			this.dw_header.object.acccode.protect = 0
		else
			ll_retflag = 1
			this.dw_header.object.patientcode[1] = ll_null
			this.dw_header.object.regno[1] = ls_null
			this.dw_header.object.aliasname[1] = ls_aliasname
			this.dw_header.object.acccode[1] = ll_acccode
			wf_getaccountbalance(ll_acccode)
			this.dw_header.object.aliasname.protect = 0
			this.dw_header.object.acccode.protect = 0
		end if
	else
		this.dw_header.object.aliasname.protect = 0
		this.dw_header.object.acccode.protect = 0
		ll_retflag = -1
