	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	parent.editflag = true
	return ::message.returnvalue

// cb_exit.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return ::message.returnvalue

// cb_exit.clicked() returns long [event]
	long ll_res = 2
	if parent.editflag = true then
		ll_res = messagebox("Save Changes", "Changes Not Saved in Database.~r~nChanges will be discarded. Are you still want to exit?", question!, yesno!, 2)
		if ll_res = 2 then
			return ::message.returnvalue
		end if
		return
	end if
	parent.post event ue_close(parent.il_code)
	return ::message.returnvalue

// cb_save.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return ::message.returnvalue

