	ll_retflag = 0
	SQL SELECT acccode , aliasname INTO :ll_acccode, :ls_aliasname FROM Accounts WHERE AccCode =:al_acccode and active ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ll_acccode) then
