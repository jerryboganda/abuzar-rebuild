// dw_header.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.wf_grandtotal()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_header.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_null
	long ll_res = 1
	long ll_result
	integer li_errcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	parent.editflag = true
	setnull(ll_null)
	choose case dwo.name
	case "cashtendered"
		if double(data) < 0.0 or data = "" or isnull(data) then
			messagebox("Cash Tendered Validation!", "Please enter valid amount for Cash Tendered.", stopsign!)
			return 1
		end if
		parent.wf_setbalance(dwo.name, double(data))
	case "cashcharged"
		if double(data) < 0.0 or data = "" or isnull(data) then
			messagebox("Cash Charged Validation!", "Please enter valid amount for Cash Charged.", stopsign!)
			return 1
		elseif double(data) > this.object.cashtendered[row] then
			messagebox("Cash Charged Validation!", "Please enter valid amount for Cash Charged~r~nCash Charged must not exceed Cash Tendered.", stopsign!)
			return 1
		end if
		parent.wf_setbalance(dwo.name, double(data))
	case "regno"
		if len(data) > 0 then
			ll_result = parent.wf_getpatientinfo(data)
			if ll_result < 0 then
				messagebox("Patient Reg. No. Validation", "This is not a valid patient reg. no.~r~nPlease enter a valid patient reg. no.")
				return 1
			end if
		else
			parent.dw_header.object.aliasname.protect = 0
			parent.dw_header.object.acccode.protect = 0
		end if
	case "patientcode"
		if len(data) > 0 then
			ll_result = parent.wf_getpatientinfo(long(data))
			if ll_result < 0 then
				messagebox("Patient Reg. No. Validation", "This is not a valid patient reg. no.~r~nPlease enter a valid patient reg. no.")
				return 1
			end if
		else
			parent.dw_header.object.aliasname.protect = 0
			parent.dw_header.object.acccode.protect = 0
		end if
	case "aliasname"
		if len(data) > 0 then
			ll_result = parent.wf_getaccountinfo(data)
			if ll_result < 0 then
				messagebox("Alias Name Validation", "This is not a valid Alias Name.~r~nPlease enter a valid Account Alias Name.")
				return 1
			end if
		else
			parent.dw_header.object.aliasname.protect = 0
			parent.dw_header.object.acccode.protect = 0
		end if
	case "acccode"
		if len(data) > 0 then
			ll_result = parent.wf_getaccountinfo(long(data))
			if ll_result < 0 then
				messagebox("Account Name Validation", "This is not a valid Account Name.~r~nPlease enter a valid Account Name.")
				return 1
			end if
		else
			parent.dw_header.object.aliasname.protect = 0
			parent.dw_header.object.acccode.protect = 0
		end if
		return li_errcode
	end choose
	return li_errcode

// dw_header.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

