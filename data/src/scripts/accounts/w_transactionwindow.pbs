// window w_transactionwindow (accounts)  ancestor: window

// w_transactionwindow.ue_close(integer ai_status) returns integer [event]
	closewithreturn(this, this.il_code)
	return 0

// w_transactionwindow.ue_postopen() returns 0 [event]
	long ll_rtcode
	long ll_headerrow
	long ll_footerrow
	long ll_counter
	long ll_insrow
	long ll_found
	long ll_code
	this.il_module_open_value = message.doubleparm
	this.il_groupcode = f_getgroupcode(gl_usercode)
	if this.il_module_open_value = 1 or this.il_module_open_value = 3 then
		this.il_transactioncatcode = 1
	else
		this.il_transactioncatcode = 2
	end if
	if this.il_transactioncatcode = 1 then
		this.il_module = 37
		this.il_interfacecode = 18
		this.title = "Receipt Transaction"
	elseif this.il_transactioncatcode = 2 then
		this.il_module = 38
		this.il_interfacecode = 19
		this.title = "Payment Transaction"
	end if
	this.ids_print = create u_ds_standard
	setnull(this.il_code)

// w_transactionwindow.ue_newform() returns 0 [event]
	long ll_rtcode
	long ll_headerrow
	long ll_footerrow
	this.dw_header.reset()
	this.dw_detail.reset()
	this.dw_footer.reset()
	this.ids_print.reset()
	setpointer(hourglass!)
	SQL rollback USING sqlca;
	sqlca.virtualgl("A")
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
	else
		SQL rollback USING sqlca;
	end if
	this.dw_header.settransobject(this.it_transobject)
	ll_rtcode = this.dw_header.getchild("cashacccode", this.idc_cashacc)
	if ll_rtcode = -1 then
		messagebox("Error", "Not a DataWindowChild")
		close(this)
		return
	end if
	this.idc_cashacc.settransobject(this.it_transobject)
	this.idc_cashacc.retrieve(this.il_groupcode, this.il_module)
	ll_rtcode = this.dw_header.getchild("transactiontypecode", this.idc_transtype)
	if ll_rtcode = -1 then
		messagebox("Error", "Not a DataWindowChild")
		close(this)
		return
	end if
	this.idc_transtype.settransobject(this.it_transobject)
	this.idc_transtype.retrieve(this.il_transactioncatcode)
	ll_rtcode = this.dw_header.getchild("patientcode", this.idc_patient)
	if ll_rtcode = -1 then
		messagebox("Error", "Not a DataWindowChild")
		close(this)
		return
	end if
	this.idc_patient.settransobject(this.it_transobject)
	this.idc_patient.retrieve(this.il_module)
	this.dw_detail.settransobject(this.it_transobject)
	this.dw_footer.settransobject(this.it_transobject)
	this.dw_footer.insertrow(0)
	this.dw_footer.scrolltorow(0)
	this.dw_header.insertrow(0)
	this.dw_header.scrolltorow(0)
	this.ids_print.settransobject(this.it_transobject)
	this.dw_header.object.transactiontypecode[1] = this.idc_transtype.getitemnumber(1, "transactiontypecode")
	ll_headerrow = this.dw_header.rowcount()
	ll_footerrow = this.dw_footer.rowcount()
	wf_adopt_cashwindowtemplate()
	this.dw_header.setfocus()
	this.dw_header.selecttext(1, len(this.dw_header.gettext()))
	if f_stringpreferences("askpatientintransrecpaymentwindow") = "N" then
		this.dw_header.object.regno.visible = false
		this.dw_header.object.regno_t.visible = false
		this.dw_header.object.patientcode.visible = false
		this.dw_header.object.patientcode_t.visible = false
		this.dw_header.object.c_patientbalance.visible = false
		this.dw_header.object.patientbalance_t.visible = false
	else
		this.dw_header.object.regno.visible = true
		this.dw_header.object.regno_t.visible = true
		this.dw_header.object.patientcode.visible = true
		this.dw_header.object.patientcode_t.visible = true
		this.dw_header.object.c_patientbalance.visible = true
		this.dw_header.object.patientbalance_t.visible = true
	end if
	this.editflag = false
	wf_setlasttransaction()
	wf_grandtotal()
	wf_protectdw(this.dw_header, 0)
	wf_protectdw(this.dw_detail, 0)
	setpointer(arrow!)

// w_transactionwindow.wf_getglobalcode(string as_str) returns integer
	integer ll_code
	SQL SELECT Code INTO :ll_code FROM Global WHERE Name =:as_str USING sqlca;
	if sqlca.sqlcode <> 0 then
		ll_code = 0
	end if
	return ll_code

// w_transactionwindow.wf_setbalance(string as_col, double ad_amt) returns 0
	if as_col = "cashtendered" then
		this.dw_header.object.cashcharged[1] = ad_amt
		this.dw_header.object.cashback[1] = 0
		return
	end if
	if as_col = "cashcharged" then
		if ad_amt > this.dw_header.object.cashtendered[1] then
			this.dw_header.object.cashback[1] = 0
			return
		end if
		this.dw_header.object.cashback[1] = this.dw_header.object.cashtendered[1] - ad_amt
	end if

// w_transactionwindow.wf_adopt_cashwindowtemplate() returns long
	long ll_counter
	long ll_temp_rows
	long ll_insrow
	datastore lds_cashtemp
	lds_cashtemp = create datastore
	lds_cashtemp.dataobject = "d_cashierwindowtemplate_detail"
	lds_cashtemp.settransobject(sqlca)
	lds_cashtemp.retrieve(this.il_interfacecode)
	ll_temp_rows = lds_cashtemp.rowcount()
	if ll_temp_rows > 0 then
		for ll_counter = 1 to ll_temp_rows
			ll_insrow = this.dw_detail.insertrow(0)
			this.dw_detail.object.acccode[ll_insrow] = lds_cashtemp.object.acccode[ll_counter]
			this.dw_detail.object.remarks[ll_insrow] = lds_cashtemp.object.remarks[ll_counter]
			this.dw_detail.object.amount[ll_insrow] = 0.00
		next
	end if
	return 0

// w_transactionwindow.wf_connect() returns long
	SQL start USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		return 0
	end if
	messagebox("Database Connection Problem", "Unable To Connect to database.~r~nDetails are:-  " + this.it_transobject.sqlerrtext)
	return this.it_transobject.sqlcode

// w_transactionwindow.wf_getpatientinfo(string as_regno) returns long
	long ll_patientcode
	long ll_retflag
	long ll_admissioncode
	long ll_custcode
	string ls_itemname
	string ls_aliasname
	char lc_active
	ll_retflag = 0
	SQL SELECT patientcode , active , admissioncode =( select MAX ( pa.admissioncode ) from patientadmission pa where pa.patientcode =patient.patientcode and pa.discharged1 ='N' ) , custcode , aliasname =( select a.aliasname from accounts a where a.acccode =patient.custcode ) INTO :ll_patientcode, :lc_active, :ll_admissioncode, :ll_custcode, :ls_aliasname FROM patient WHERE regno =:as_regno and active ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ll_patientcode) then
			ll_retflag = 0
			this.dw_header.object.aliasname.protect = 0
			this.dw_header.object.acccode.protect = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
			this.dw_header.object.patientcode[1] = ll_patientcode
			this.dw_header.object.aliasname[1] = ls_aliasname
			this.dw_header.object.acccode[1] = ll_custcode
			wf_patientopeningbalance(ll_patientcode)
			wf_getaccountbalance(ll_custcode)
			this.dw_header.object.aliasname.protect = 1
			this.dw_header.object.acccode.protect = 1
		else
			ll_retflag = -2
		end if
	else
		this.dw_header.object.aliasname.protect = 0
		this.dw_header.object.acccode.protect = 0
		ll_retflag = -1
	end if
	return ll_retflag

// w_transactionwindow.wf_getpatientinfo(long al_patientcode) returns long
	long ll_patientcode
	long ll_retflag
	long ll_admissioncode
	long ll_custcode
	string ls_itemname
	string ls_aliasname
	string ls_regno
	char lc_active
	ll_retflag = 0
	SQL SELECT patientcode , regno , active , admissioncode =( select MAX ( pa.admissioncode ) from patientadmission pa where pa.patientcode =patient.patientcode and pa.discharged1 ='N' ) , custcode , aliasname =( select a.aliasname from accounts a where a.acccode =patient.custcode ) INTO :ll_patientcode, :ls_regno, :lc_active, :ll_admissioncode, :ll_custcode, :ls_aliasname FROM patient WHERE patientcode =:al_patientcode and active ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ll_patientcode) then
			ll_retflag = 0
			this.dw_header.object.aliasname.protect = 0
			this.dw_header.object.acccode.protect = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
			this.dw_header.object.patientcode[1] = ll_patientcode
			this.dw_header.object.regno[1] = ls_regno
			this.dw_header.object.aliasname[1] = ls_aliasname
			this.dw_header.object.acccode[1] = ll_custcode
			wf_patientopeningbalance(ll_patientcode)
			wf_getaccountbalance(ll_custcode)
			this.dw_header.object.aliasname.protect = 1
			this.dw_header.object.acccode.protect = 1
		else
			ll_retflag = -2
		end if
	else
		this.dw_header.object.aliasname.protect = 0
		this.dw_header.object.acccode.protect = 0
		ll_retflag = -1
	end if
	return ll_retflag

// w_transactionwindow.wf_getaccountinfo(string as_aliasname) returns long
	long ll_acccode
	long ll_retflag
	long ll_null
	string ls_aliasname
	string ls_null
	setnull(ll_null)
	setnull(ls_null)
	ll_retflag = 0
	SQL SELECT acccode , aliasname INTO :ll_acccode, :ls_aliasname FROM Accounts WHERE AliasName =:as_aliasname and active ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ll_acccode) then
			ll_retflag = 0
			this.dw_header.object.aliasname.protect = 0
			this.dw_header.object.acccode.protect = 0
		else
			ll_retflag = 1
			this.dw_header.object.patientcode[1] = ll_null
			this.dw_header.object.regno[1] = ls_null
			this.dw_header.object.aliasname[1] = ls_aliasname
			this.dw_header.object.acccode[1] = ll_acccode
			wf_getaccountbalance(ll_acccode)
			this.dw_header.object.aliasname.protect = 0
			this.dw_header.object.acccode.protect = 0
		end if
	else
		this.dw_header.object.aliasname.protect = 0
		this.dw_header.object.acccode.protect = 0
		ll_retflag = -1
	end if
	return ll_retflag

