// window w_transactiontype_form (accounts)  ancestor: w_single_entry

// w_transactiontype_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM TransactionType WHERE name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_transactiontype_form.wf_duplicateshortname(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM TransactionType WHERE shortname =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_transactiontype_form.create() returns 0 [event]
	call super::create

// w_transactiontype_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_transactiontype_form.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_transactiontype_form.ue_detail() returns 0 [event]
	call super::ue_detail
	if this.id_list.getrow() > 0 and this.id_list.object.posted[this.id_list.getrow()] = "Y" then
		wf_protectdw(this.id_detail, 1)
		this.id_detail.object.autopost.protect = 0
	end if

// w_transactiontype_form.ue_newform() returns 0 [event]
	call super::ue_newform

// w_transactiontype_form.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "TransactionType"
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	long ll_dup_shortname
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "name"
		if parent.parent.parent.wf_duplicatename(data) then
			messagebox("Name Validation", "Duplication Name Error~n~rPlease Choose Some Other Name")
			return 1
		else
			return 0
		end if
	case "shortname"
		if parent.parent.parent.wf_duplicatename(data) then
			messagebox("Short Name Validation", "Duplicate Short Name Error~n~rPlease Choose Some Other Short Name")
			return 1
		else
			ll_dup_shortname = f_validate_shortname(data, "T", parent.parent.parent.id_detail.object.code[1])
			if ll_dup_shortname = -1 then
				messagebox("Short Name Validation", "Short Name already in use~r~nPlease enter some other Short Name")
				rt_code = 1
			elseif ll_dup_shortname = -2 then
				messagebox("Short Name Validation", "Short Name validation problem~r~nPlease enter some other Short Name")
				rt_code = 1
			else
				rt_code = 0
			end if
		end if
	end choose
	return rt_code

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "code"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	case "numericalfactor"
		if data = "" or isnull(data) then
			messagebox("Numerical Factor Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	end choose
	return 1
