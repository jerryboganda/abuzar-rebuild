// window w_assocsaleinvlist_form (salerespwin)  ancestor: window

// w_assocsaleinvlist_form.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		post event ue_close(-1)
	end if
	return ::message.returnvalue

// w_assocsaleinvlist_form.ue_close(integer ai_closemode) returns integer
	long ll_currrow
	long ll_counter
	long ll_assocsaleinvcode
	long ll_invexists
	long ll_saleinvcode
	string[] ls_values
	s_dw_header ls_dw_header
	ll_currrow = this.id_header.getrow()
	if ai_closemode = -1 then
		ls_dw_header.i_closemode = -1
		closewithreturn(this, ls_dw_header)
		return -1
	end if
	if this.id_header.rowcount() > 0 then
		if f_validatedw(this.id_header) < 0 then
			return 1
		end if
		if isnull(this.id_header.getitemnumber(ll_currrow, "assocsaleinvcode")) then
			this.id_header.deleterow(ll_currrow)
		end if
		this.il_currrow = this.id_header.rowcount()
		if this.ib_rowvalidated = false and wf_validateitem() = -1 then
			return 1
		end if
		for ll_counter = 1 to this.id_header.rowcount()
			if isnull(this.id_header.getitemnumber(ll_counter, "assocsaleinvcode")) then
				this.id_header.deleterow(ll_counter)
			end if
		next
		for ll_counter = 1 to this.id_header.rowcount()
			ll_assocsaleinvcode = this.id_header.getitemnumber(ll_counter, "assocsaleinvcode")
			ll_invexists = 0
			SQL Select Count ( *) INTO :ll_invexists From SaleLedger Where SaleInvCode =:ll_assocsaleinvcode USING this.it_transobject;
			if ll_invexists <= 0 then
				messagebox("Associated SaleInv Existance Error", "Given Associated SaleInvNo.: " + string(ll_assocsaleinvcode) + " does not exist in SaleLedger")
				return -1
			end if
			ll_invexists = 0
			if this.ib_modifystatus then
				SQL Select Count ( *) , Max ( SaleInvCode ) INTO :ll_invexists, :ll_saleinvcode From AssocSaleInvList Where SaleInvcode <> :this.il_saleinvcode And AssocSaleInvCode =:ll_assocsaleinvcode USING this.it_transobject;
				if ll_invexists > 0 then
					messagebox("Associated SaleInv Duplication Error", "Given Associated SaleInvNo.: " + string(ll_assocsaleinvcode) + " already associated with SaleInvNo.: " + string(ll_saleinvcode))
					return -1
				end if
			else
				SQL Select Count ( *) , Max ( SaleInvCode ) INTO :ll_invexists, :ll_saleinvcode From AssocSaleInvList Where AssocSaleInvCode =:ll_assocsaleinvcode USING this.it_transobject;
				if ll_invexists > 0 then
					messagebox("Associated SaleInv Duplication Error", "Given Associated SaleInvNo.: " + string(ll_assocsaleinvcode) + " already associated with SaleInvNo.: " + string(ll_saleinvcode))
					return -1
				end if
			end if
			ll_invexists = 0
			SQL Select Count ( *) INTO :ll_invexists From SaleLedger Where SaleInvCode =:ll_assocsaleinvcode And Posted ='Y' USING this.it_transobject;
			if ll_invexists > 0 then
				messagebox("Associated SaleInv Posting Error", "Given Associated SaleInvCode has already been posted.~r~nKindly verify it AssociatedSaleInvNo.: " + string(ll_assocsaleinvcode))
				return -1
			end if
		next
	end if
	ls_dw_header.values = ls_values
	ls_dw_header.dw_header = this.id_header
	ls_dw_header.i_closemode = 1
	closewithreturn(this, ls_dw_header)
	return 0

// w_assocsaleinvlist_form.wf_validateitem() returns integer
	long ll_assocsaleinvcode
	integer li_errcode
	integer li_null
	ll_assocsaleinvcode = this.id_header.getitemnumber(this.il_currrow, "assocsaleinvcode")
	if vf_dwdupcode1(this.id_header, "assocsaleinvcode", string(ll_assocsaleinvcode), this.il_currrow) = true then
		messagebox("Duplication Error", "Current row is duplicate")
		li_errcode = -1
		this.ib_rowvalidated = false
	else
		li_errcode = 0
		this.ib_rowvalidated = true
	end if
	if li_errcode = -1 then
		setnull(li_null)
		this.id_header.setcolumn("assocsaleinvcode")
		this.id_header.scrolltorow(this.il_currrow)
		this.id_header.object.assocsaleinvcode[this.il_currrow] = li_null
	end if
	return li_errcode

// w_assocsaleinvlist_form.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_assocsaleinvlist_form.create() returns 0
	this.cb_ok = create cb_ok
	this.cb_cancel = create cb_cancel
	this.dw_viewheader = create dw_viewheader
	this.control = {this.cb_ok, this.cb_cancel, this.dw_viewheader}

// w_assocsaleinvlist_form.destroy() returns 0
	destroy this.cb_ok
	destroy this.cb_cancel
	destroy this.dw_viewheader

// w_assocsaleinvlist_form.open() returns long
	long ll_row
	long ll_currrow
	long ll_counter
	string ls_saletype
	integer li_protect
	integer li_view_cashorcredit
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	s_dw_header ls_dw_header
	datawindow ldw_header
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	ldw_header = create datawindow
	ls_dw_header = message.powerobjectparm
	this.it_transobject = ls_dw_header.t_transobject
	ldw_header = ls_dw_header.dw_header
	ldw_header.settransobject(this.it_transobject)
	this.id_header = this.dw_viewheader
	this.id_header.settransobject(this.it_transobject)
	ldw_header.sharedata(this.id_header)
	if ldw_header.rowcount() = 0 then
		ldw_header.insertrow(0)
	end if
	this.ib_modifystatus = ls_dw_header.b_modifystatus
	this.il_saleinvcode = ls_dw_header.l_code
	this.id_header.scrolltorow(this.id_header.rowcount())
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_ok.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	parent.post event ue_close(1)
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.post event ue_close(-1)
	return ::message.returnvalue

// dw_viewheader.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	long ll_rowcount
	if key = keyescape! then
		parent.post event ue_close(-1)
	end if
	if keyflags = 2 then
		if key = keyi! then
			if parent.ib_rowvalidated = false and parent.wf_validateitem() = -1 then
				return ::message.returnvalue
			end if
			if parent.id_header.rowcount() > 0 and f_validatedw(parent.id_header) < 0 then
				return ::message.returnvalue
			end if
			ll_rowcount = parent.id_header.insertrow(0)
			if ll_rowcount > 1 then
				parent.id_header.scrolltorow(ll_rowcount)
				parent.id_header.setfocus()
			end if
		end if
		if key = keyd! then
			parent.ib_rowvalidated = true
			if parent.id_header.rowcount() > 0 then
				parent.id_header.deleterow(0)
			end if
			ll_rowcount = parent.id_header.rowcount()
			if ll_rowcount > 1 then
				parent.id_header.scrolltorow(ll_rowcount)
				parent.id_header.setfocus()
			end if
			parent.ib_rowvalidated = true
		end if
	end if
	return ::message.returnvalue

// dw_viewheader.ue_enterkey() returns long
	long ll_rowcount
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		if parent.id_header.rowcount() > 0 and f_validatedw(parent.id_header) < 0 then
			return ::message.returnvalue
		end if
		if parent.ib_rowvalidated = false and parent.wf_validateitem() = -1 then
			return 1
		end if
		ll_rowcount = parent.id_header.insertrow(0)
		if ll_rowcount > 1 then
			parent.id_header.scrolltorow(ll_rowcount)
			parent.id_header.setfocus()
			if isnull(this.object.assocsaleinvcode[ll_rowcount]) then
				ll_rowcount = ll_rowcount - 1
				if ll_rowcount > 0 and isnull(this.object.assocsaleinvcode[ll_rowcount]) then
					parent.cb_ok.triggerevent(clicked!)
				end if
			end if
		end if
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_viewheader.itemerror(long row, dwobject dwo, string data) returns long
	choose case dwo.name
	case "assocsaleinvcode"
		if data = "" or isnull(data) then
			messagebox("SaleInvCode Validation", "Value required SaleInvCode in current row")
		end if
	end choose
	return 1

// dw_viewheader.itemfocuschanged(long row, dwobject dwo) returns long
	if parent.ib_rowvalidated = false and parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_viewheader.itemchanged(long row, dwobject dwo, string data) returns long
	integer li_errcode
	choose case dwo.name
	case "AssocSaleInvCode"
		parent.ib_rowvalidated = false
		parent.il_currrow = row
		li_errcode = 0
	case else
		parent.ib_rowvalidated = true
	end choose
	return li_errcode
