// window w_installmentguarantor_form (salerespwin)  ancestor: window

// w_installmentguarantor_form.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		post event ue_close(-1)
	end if
	return ::message.returnvalue

// w_installmentguarantor_form.ue_close(integer ai_closemode) returns integer
	long ll_currrow
	long ll_counter
	string[] ls_values
	s_dw_header ls_dw_header
	ll_currrow = this.id_header.getrow()
	if ai_closemode = -1 then
		ls_dw_header.i_closemode = -1
		closewithreturn(this, ls_dw_header)
		return -1
	end if
	if this.id_header.rowcount() > 0 then
		if isnull(this.id_header.getitemnumber(ll_currrow, "guaranteepersoncode")) then
			this.id_header.deleterow(ll_currrow)
		end if
		if f_validatedw(this.id_header) < 0 then
			return 1
		end if
		this.il_currrow = this.id_header.rowcount()
		if this.ib_rowvalidated = false and wf_validateitem() = -1 then
			return 1
		end if
		return
	end if
	ls_dw_header.dw_header = this.id_header
	ls_dw_header.i_closemode = 1
	closewithreturn(this, ls_dw_header)
	return 0

// w_installmentguarantor_form.ue_postopen() returns 0
	long ll_row
	long ll_currrow
	long ll_counter
	long ll_retcode
	string ls_saletype
	integer li_protect
	integer li_view_cashorcredit
	s_dw_header ls_dw_header
	datawindow ldw_header
	this.id_header = this.dw_viewheader
	this.id_header.settransobject(sqlca)
	ls_dw_header = message.powerobjectparm
	ldw_header = ls_dw_header.dw_header
	ldw_header.sharedata(this.id_header)
	if this.id_header.rowcount() = 0 then
		this.id_header.insertrow(0)
	end if
	ll_retcode = this.id_header.getchild("guaranteepersoncode", this.idc_child)
	this.idc_child.settransobject(sqlca)
	this.idc_child.retrieve()
	this.id_header.scrolltorow(this.id_header.rowcount())
	wf_protectdw(this.id_header, ls_dw_header.i_protectdw)
	this.ii_protect = ls_dw_header.i_protectdw

// w_installmentguarantor_form.wf_validateitem() returns integer
	long ll_associcode
	integer li_errcode
	string ls_managername
	integer li_null
	ll_associcode = this.id_header.getitemnumber(this.il_currrow, "guranteepersoncode")
	if vf_dwdupcode1(this.id_header, "guaranteepersoncode", string(ll_associcode), this.il_currrow) = true then
		messagebox("Duplication Error", "Current row is duplicate")
		li_errcode = -1
		this.ib_rowvalidated = false
	else
		li_errcode = 0
		this.ib_rowvalidated = true
	end if
	if li_errcode = -1 then
		setnull(li_null)
		this.id_header.setcolumn("guranteepersoncode")
		this.id_header.scrolltorow(this.il_currrow)
		this.id_header.object.icatcode[this.il_currrow] = li_null
	end if
	return li_errcode

// w_installmentguarantor_form.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_installmentguarantor_form.create() returns 0
	this.cb_new = create cb_new
	this.cb_ok = create cb_ok
	this.cb_cancel = create cb_cancel
	this.dw_viewheader = create dw_viewheader
	this.control = {this.cb_new, this.cb_ok, this.cb_cancel, this.dw_viewheader}

// w_installmentguarantor_form.destroy() returns 0
	destroy this.cb_new
	destroy this.cb_ok
	destroy this.cb_cancel
	destroy this.dw_viewheader

// w_installmentguarantor_form.open() returns long
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	post event ue_postopen()
	return ::message.returnvalue

// cb_new.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return ::message.returnvalue

// cb_new.clicked() returns long
	long ll_code
	openwithparm(w_guaranteeperson, ll_code)
	ll_code = message.doubleparm
	if ll_code > 0 then
		parent.idc_child.retrieve()
	end if
	parent.idc_child.retrieve()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_ok.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	parent.post event ue_close(1)
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.post event ue_close(-1)
	return ::message.returnvalue

// dw_viewheader.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	long ll_rowcount
	if key = keyescape! then
		parent.post event ue_close(-1)
	end if
	if keyflags = 2 then
		if parent.ii_protect = 1 then
			return ::message.returnvalue
		end if
		if key = keyi! then
			if parent.ib_rowvalidated = false and parent.wf_validateitem() = -1 then
				return ::message.returnvalue
			end if
			if parent.id_header.rowcount() > 0 and f_validatedw(parent.id_header) < 0 then
				return ::message.returnvalue
			end if
			ll_rowcount = parent.id_header.insertrow(0)
			if ll_rowcount > 1 then
				parent.id_header.scrolltorow(ll_rowcount)
				parent.id_header.setfocus()
			end if
		end if
		if key = keyd! then
			parent.ib_rowvalidated = true
			if parent.id_header.rowcount() > 0 then
				parent.id_header.deleterow(0)
			end if
			ll_rowcount = parent.id_header.rowcount()
			if ll_rowcount > 1 then
				parent.id_header.scrolltorow(ll_rowcount)
				parent.id_header.setfocus()
			end if
			parent.ib_rowvalidated = true
		end if
	end if
	return ::message.returnvalue

// dw_viewheader.ue_enterkey() returns long
	long ll_rowcount
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		if parent.id_header.rowcount() > 0 and f_validatedw(parent.id_header) < 0 then
			return ::message.returnvalue
		end if
		if parent.ib_rowvalidated = false and parent.wf_validateitem() = -1 then
			return 1
		end if
		ll_rowcount = parent.id_header.insertrow(0)
		if ll_rowcount > 1 then
			parent.id_header.scrolltorow(ll_rowcount)
			parent.id_header.setfocus()
		end if
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_viewheader.itemerror(long row, dwobject dwo, string data) returns long
	choose case dwo.name
	case "icatcode"
		if data = "" or isnull(data) then
			messagebox("Item Category Validation", "Value required for Item Category in current row")
		end if
	end choose
	return 1

// dw_viewheader.itemfocuschanged(long row, dwobject dwo) returns long
	if parent.ib_rowvalidated = false and parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_viewheader.itemchanged(long row, dwobject dwo, string data) returns long
	integer li_errcode
	choose case dwo.name
	case "icatcode"
		parent.ib_rowvalidated = false
		parent.il_currrow = row
		li_errcode = 0
	case else
		parent.ib_rowvalidated = true
	end choose
	return li_errcode
