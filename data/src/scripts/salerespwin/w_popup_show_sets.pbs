// window w_popup_show_sets (salerespwin)  ancestor: window

// w_popup_show_sets.ue_postopen() returns 0 [event]
	long ll_icode
	this.id_header = this.dw_show_sets_header
	this.id_detail = this.dw_show_sets_detail
	this.id_header.settransobject(sqlca)
	this.id_detail.settransobject(sqlca)
	ll_icode = message.doubleparm
	this.id_header.retrieve(ll_icode)
	this.id_detail.retrieve(ll_icode)

// w_popup_show_sets.ue_close(long al_return) returns 0 [event]
	closewithreturn(this, al_return)

// w_popup_show_sets.open() returns long [event]
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	post event ue_postopen()
	return ::message.returnvalue

// w_popup_show_sets.create() returns 0 [event]
	this.cb_ok = create cb_ok
	this.dw_show_sets_detail = create dw_show_sets_detail
	this.dw_show_sets_header = create dw_show_sets_header
	this.gb_1 = create gb_1
	this.control = {this.cb_ok, this.dw_show_sets_detail, this.dw_show_sets_header, this.gb_1}

// w_popup_show_sets.destroy() returns 0 [event]
	destroy this.cb_ok
	destroy this.dw_show_sets_detail
	destroy this.dw_show_sets_header
	destroy this.gb_1

// w_popup_show_sets.key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		post event ue_close(1)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	parent.post event ue_close(1)
	return ::message.returnvalue
