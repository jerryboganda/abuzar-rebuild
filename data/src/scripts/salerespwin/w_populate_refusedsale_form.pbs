// window w_populate_refusedsale_form (salerespwin)  ancestor: window

// w_populate_refusedsale_form.ue_keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		post event ue_close()
	end if
	return ::message.returnvalue

// w_populate_refusedsale_form.ue_close() returns 0
	closewithreturn(this, this.istr_arg)

// w_populate_refusedsale_form.wf_assigndwobjects(string as_masterdw, string as_detaildw, string as_footerdw) returns 0
	this.dw_detail.dataobject = as_detaildw
	this.dw_footer.dataobject = as_footerdw
	this.dw_detail.settransobject(sqlca)
	this.dw_footer.settransobject(sqlca)

// w_populate_refusedsale_form.create() returns 0
	this.rb_eqty = create rb_eqty
	this.rb_totqty = create rb_totqty
	this.cb_ok = create cb_ok
	this.dw_footer = create dw_footer
	this.dw_detail = create dw_detail
	this.gb_1 = create gb_1
	this.control = {this.rb_eqty, this.rb_totqty, this.cb_ok, this.dw_footer, this.dw_detail, this.gb_1}

// w_populate_refusedsale_form.destroy() returns 0
	destroy this.rb_eqty
	destroy this.rb_totqty
	destroy this.cb_ok
	destroy this.dw_footer
	destroy this.dw_detail
	destroy this.gb_1

// w_populate_refusedsale_form.open() returns long
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	this.title = "Populate Refused Sale(s)"
	wf_assigndwobjects("", "d_populate_refusedsale", "")
	this.dw_detail.retrieve()
	this.dw_detail.setfocus()
	this.dw_detail.setcolumn("selected")
	return ::message.returnvalue

// cb_ok.clicked() returns long
	long[] ll_invcode
	long ll_rowcount
	long ll_counter
	long ll_arrindex
	long ll_thiscode
	boolean lb_remarks
	boolean lb_invoiceexists
	string ls_date
	ll_rowcount = parent.dw_detail.rowcount()
	for ll_counter = 1 to ll_rowcount
		if parent.dw_detail.getitemstring(ll_counter, "selected") = "Y" then
			lb_invoiceexists = true
			ll_arrindex = ll_arrindex + 1
			ll_thiscode = parent.dw_detail.getitemnumber(ll_counter, "refusedsaleinvcode")
			parent.istr_arg.ia_integerlist[ll_arrindex] = ll_thiscode
		end if
	next
	if lb_invoiceexists then
		parent.istr_arg.i_status = 1
	end if
	if parent.rb_eqty.checked = true then
		parent.istr_arg.l_code1 = 1
	else
		parent.istr_arg.l_code1 = 0
	end if
	parent.post event ue_close()
	return ::message.returnvalue
