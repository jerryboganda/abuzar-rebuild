// window w_cashonsales_headerwise (salerespwin)  ancestor: w_single_entry

// w_cashonsales_headerwise.wf_retrievelist() returns integer
	long rtcode
	rtcode = this.id_dwcontrol.retrieve(this.il_groupcode, this.ii_module)
	return rtcode

// w_cashonsales_headerwise.wf_validatepaymentacccode(char ac_paymentmode, long al_acccode) returns boolean
	long ll_count
	boolean b_flag
	if ac_paymentmode = "C" or isnull(ac_paymentmode) then
		SQL SELECT count ( *) INTO :ll_count FROM accounts WHERE accounts.acccode =:al_acccode and accounts.subcode IN ( SELECT code FROM GLOBAL WHERE name ='GT_CashSub' ) USING sqlca;
	else
		SQL SELECT count ( *) INTO :ll_count FROM accounts WHERE accounts.acccode =:al_acccode and accounts.subcode IN ( SELECT code FROM GLOBAL WHERE name ='GT_BankSub' ) USING sqlca;
	end if
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_cashonsales_headerwise.wf_saveform(string as_messagetitle, string as_messagetext, long al_error_row, string as_error_col) returns integer
	long ll_counter
	long ll_null
	long ll_usercode
	long ll_paymentacccode
	integer li_retcode
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_null
	char lc_null
	char lc_paymentmode
	datetime ldt_null
	double ld_invtotal
	double ld_amt
	dwitemstatus lds_rowstatus
	setnull(ll_null)
	setnull(ls_null)
	setnull(lc_null)
	setnull(ldt_null)
	as_error_col = ""
	al_error_row = 0
	li_retcode = this.id_detail.accepttext()
	if li_retcode < 0 then
		as_messagetitle = "Validation"
		as_messagetext = "Error in validation of data"
		al_error_row = 0
		return -1
	end if
	open(w_salesmanpassword)
	ll_usercode = long(message.doubleparm)
	setfocus()
	if ll_usercode > 0 then
		if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
			as_messagetitle = "Date Violation"
			as_messagetext = ls_date_errtext
			al_error_row = 0
			return -1
		end if
		if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
			as_messagetitle = "Date Violation"
			as_messagetext = ls_date_errtext
			al_error_row = 0
			return -1
		end if
		ll_counter = 1
		do while ll_counter <= this.id_detail.rowcount()
			lds_rowstatus = this.id_detail.getitemstatus(ll_counter, 0, primary!)
			ld_invtotal = this.id_detail.getitemnumber(ll_counter, "invtotal")
			ld_amt = this.id_detail.getitemnumber(ll_counter, "amt")
			lc_paymentmode = this.id_detail.getitemstring(ll_counter, "paymentmode")
			ll_paymentacccode = this.id_detail.getitemnumber(ll_counter, "paymentacccode")
			if lds_rowstatus = datamodified! then
				if ld_amt > 0.0 then
					if isnull(lc_paymentmode) then
						as_messagetitle = "Payment Mode Validation!"
						as_messagetext = "Select Valid Payment Mode for Amount Received"
						al_error_row = ll_counter
						as_error_col = "paymentmode"
						return -1
					end if
					if isnull(ll_paymentacccode) then
						as_messagetitle = "Cash/Bank Account Validation!"
						as_messagetext = "Select Valid Cash/Bank Account for Amount Received"
						al_error_row = ll_counter
						as_error_col = "paymentacccode"
						return -1
					end if
					if wf_validatepaymentacccode(lc_paymentmode, ll_paymentacccode) = true then
						this.id_detail.setitem(ll_counter, "amtdate", ldt_server_datetime)
						this.id_detail.setitem(ll_counter, "amtby", ll_usercode)
						if ld_invtotal - ld_amt >= 0.0 then
							this.id_detail.setitem(ll_counter, "outstandingamt", ld_invtotal - ld_amt)
						else
							this.id_detail.setitem(ll_counter, "outstandingamt", 0)
						end if
					else
						as_messagetitle = "Cash/Bank Account Validation!"
						as_messagetext = "Select Valid Cash/Bank Account for Amount Received"
						al_error_row = ll_counter
						as_error_col = "paymentacccode"
						return -1
					end if
				elseif ld_amt = 0.0 then
					this.id_detail.setitem(ll_counter, "paymentmode", lc_null)
					this.id_detail.setitem(ll_counter, "paymentacccode", ll_null)
					this.id_detail.setitem(ll_counter, "amtdate", ldt_null)
					this.id_detail.setitem(ll_counter, "amtreference", ls_null)
					this.id_detail.setitem(ll_counter, "amtby", ll_usercode)
					this.id_detail.setitem(ll_counter, "outstandingamt", ld_invtotal - ld_amt)
				else
					as_messagetitle = "Cash/Bank Account Validation!"
					as_messagetext = "Select Valid Cash/Bank Account for Amount Received"
					al_error_row = ll_counter
					as_error_col = "amt"
					return -1
				end if
				return
			end if
			ll_counter = ll_counter + 1
		loop
		li_retcode = this.id_detail.update(false, true)
		if li_retcode = 1 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				SQL rollback USING sqlca;
				as_messagetitle = "Error on Commit"
				as_messagetext = sqlca.sqlerrtext
				al_error_row = 0
				as_error_col = ""
				li_retcode = -1
			else
				as_messagetitle = "Saving Completed"
				as_messagetext = "Changes Saved in Database"
				al_error_row = 0
				as_error_col = ""
				li_retcode = 1
			end if
		else
			SQL rollback USING sqlca;
			as_messagetitle = "Update Failed"
			as_messagetext = "Rolling back changes to database"
			al_error_row = 0
			as_error_col = ""
			li_retcode = -1
		end if
	else
		as_messagetitle = "Saving Aborted"
		as_messagetext = "Please enter valid username/password"
		al_error_row = 0
		as_error_col = ""
		li_retcode = -1
	end if
	return li_retcode

// w_cashonsales_headerwise.wf_locksaleinvoice(long al_saleinvcode) returns long
	return 0

// w_cashonsales_headerwise.wf_check_locked_invoice(long al_saleinvcode) returns long
	long ll_counter
	long ll_found
	long ll_found2
	SQL Select count ( *) INTO :ll_found From SaleLedger S Where S.SaleInvcode =:al_saleinvcode AND S.AccountFor ='Y' AND S.Posted ='N' AND S.Deleted ='N' AND S.SaleCatCode =2 USING sqlca;
	if sqlca.sqlcode = 0 and ll_found <> 0 then
		SQL Select count ( *) INTO :ll_found2 From SaleLedger S WITH ( readpast , rowlock , updlock ) Where S.SaleInvcode =:al_saleinvcode AND S.AccountFor ='Y' AND S.Posted ='N' AND S.Deleted ='N' AND S.SaleCatCode =2 USING sqlca;
		if ll_found <> ll_found2 then
			messagebox("Cash on Sales", "Sale Invoice Locking Attempt failed,~r~n" + "This Sale invoice is already under modification process~r~n" + "Kindly complete/abort modification process and try again")
			return -1
		elseif wf_locksaleinvoice(al_saleinvcode) <> 0 then
			messagebox("Cash on Sales", "Sale Invoice Locking Attempt failed,~r~n" + "This sale invoice is already under modification process~r~n" + "Kindly complete/abort modification process and try again")
			return -1
		end if
	else
		messagebox("Cash on Sales", "Unable to fetech status of Sale Invoice~r~nKindly complete/abort modification process of the said invoice and try again")
		return -1
	end if
	return 0

// w_cashonsales_headerwise.wf_retrieve(long retrievalarg) returns long
	return this.id_dwcontrol.retrieve(retrievalarg)

// w_cashonsales_headerwise.create() returns 0 [event]
	call super::create

// w_cashonsales_headerwise.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_cashonsales_headerwise.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_cashonsales_headerwise.open() returns long [event]
	long ancestorreturnvalue
	integer li_rtncode
	ancestorreturnvalue = super::open()
	this.is_tablename = "SaleLedger"
	this.im_menu.m_file.m_new.visible = false
	this.il_groupcode = f_getgroupcode(gl_usercode)
	li_rtncode = this.id_detail.getchild("paymentacccode", this.idc_paymentacccode)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_paymentacccode.settransobject(sqlca)
	this.idc_paymentacccode.insertrow(0)
	this.id_print.dataobject = "d_amt_received_on_sale_print"
	this.id_print.settransobject(sqlca)
	return ::message.returnvalue

// w_cashonsales_headerwise.ue_delete() returns 0 [event]

// w_cashonsales_headerwise.ue_detail() returns 0 [event]
	long ll_code
	long ll_found
	this.im_menu.m_file.m_save.enabled = true
	ll_found = 0
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.i_editmode = 2
	this.i_retrievemode = 2
	if this.tab_retrieve.tabpage_list.dw_list.rowcount() > 0 then
		if this.il_selectedrow = 0 or isnull(this.il_selectedrow) then
			this.il_selectedrow = this.id_list.getrow()
		end if
		if this.il_selectedrow > 0 then
			ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
			this.id_dwcontrol = this.id_detail
			if wf_check_locked_invoice(ll_code) = 0 then
				wf_retrieve(ll_code)
				if this.id_dwcontrol.rowcount() > 0 then
					if this.id_detail.getitemstring(1, "PaymentMode") = "B" then
						this.idc_paymentacccode.retrieve(f_getglobalcode("GT_BankSub"))
					else
						this.idc_paymentacccode.retrieve(f_getglobalcode("GT_CashSub"))
					end if
				else
					this.idc_paymentacccode.insertrow(0)
				end if
			else
				messagebox("Invoice Validation", "Sale Invoice already in use by some other user.~r~nKindly try again after sometime or open some other invoice.")
				this.tab_retrieve.selecttab(2)
				return
			end if
			this.id_dwcontrol = this.id_list
			this.tab_retrieve.tabpage_detail.dw_detail.setfocus()
		end if
	end if
	this.id_detail.selecttext(1, len(this.id_detail.gettext()))

// w_cashonsales_headerwise.ue_list() returns 0 [event]
	long ll_rtcode
	SQL rollback USING sqlca;
	if this.id_list.rowcount() <= 0 then
		ll_rtcode = wf_retrievelist()
	end if
	if ll_rtcode > 0 then
		this.im_menu.m_file.m_save.enabled = false
		this.im_menu.m_file.m_delete.enabled = false
		this.im_menu.m_file.m_first.enabled = true
		this.im_menu.m_file.m_next.enabled = true
		this.im_menu.m_file.m_last.enabled = true
		this.im_menu.m_file.m_print.enabled = true
		this.im_menu.m_file.m_previous.enabled = true
		this.im_menu.m_file.m_retrieve.text = "De&tail"
		this.i_retrievemode = 2
		this.i_editmode = 2
		if this.il_selectedrow = 0 then
			wf_first()
			wf_selectunselectrow(1)
		end if
		this.tab_retrieve.tabpage_list.dw_find.setfocus()
		return
	end if
	messagebox("Result", "No rows or retrieved possible empty table~r~nInsert some rows first")
	postevent("ue_new")

// w_cashonsales_headerwise.ue_save() returns 0 [event]
	long ll_row
	long ll_temp
	long ll_err_row
	string sl_columnname
	string ls_messtitle
	string ls_messtext
	string ls_err_col
	boolean lb_save
	if isnull(this.id_detail.getitemnumber(1, "code")) then
		return
	end if
	if isnull(this.id_detail.getitemnumber(1, "amt")) then
		return
	end if
	if this.id_detail.getitemnumber(1, "amt") < 0.0 then
		return
	end if
	setpointer(hourglass!)
	if wf_saveform(ls_messtitle, ls_messtext, ll_err_row, ls_err_col) >= 0 then
		messagebox(ls_messtitle, ls_messtext, information!)
		this.ib_commitok = true
		this.im_menu.m_file.m_new.enabled = true
		this.editflag = false
	else
		messagebox(ls_messtitle, ls_messtext, stopsign!)
		if ll_err_row > 0 then
			this.id_detail.setrow(ll_err_row)
		end if
		if ls_err_col <> "" then
			this.id_detail.setcolumn(ls_err_col)
		end if
		this.id_detail.setfocus()
	end if
	setpointer(arrow!)

// w_cashonsales_headerwise.ue_newform() returns 0 [event]
	setredraw(false)
	this.i_editmode = 1
	this.i_retrievemode = 2
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_new.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_file.m_first.enabled = false
	this.im_menu.m_file.m_next.enabled = false
	this.im_menu.m_file.m_previous.enabled = false
	this.im_menu.m_file.m_last.enabled = false
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_retrieve.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.tab_retrieve.tabpage_detail.enabled = true
	if this.id_detail.rowcount() > 0 then
		this.id_detail.reset()
	end if
	this.idc_paymentacccode.retrieve(f_getglobalcode("GT_CashSub"))
	this.id_detail.insertrow(0)
	this.id_detail.setcolumn(1)
	this.id_detail.setfocus()
	setredraw(true)

// w_cashonsales_headerwise.ue_print() returns 0 [event]
	long ll_code
	boolean lb_listtab
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
	else
		ll_code = this.id_detail.getitemnumber(this.id_detail.getrow(), "code")
	end if
	if isnull(ll_code) or ll_code <= 0 then
		messagebox("Selection Validation", "Kindly select some valid sale invoice.")
		return
	end if
	this.id_print.retrieve(ll_code)
	if not isnull(this.id_print.getitemnumber(this.id_print.rowcount(), "saleinvcode")) and this.id_print.getitemnumber(this.id_print.rowcount(), "amt") > 0.0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		openwithparm(w_printer, this.id_print)
	end if

// w_cashonsales_headerwise.closequery() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::closequery()
	SQL rollback USING sqlca;
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_opted
	long ll_globalcode
	long ll_tmpcode
	long ll_null
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	choose case dwo.name
	case "amt"
		if double(data) < 0.0 then
			messagebox("Amount Validation", "Negative Amount Not Allowed")
			return 1
		elseif double(data) > getitemdecimal(row, "invtotal") then
			ll_opted = messagebox("Amount Validation", "Amount is Greater Than Invoice Total~r~nAccept Anyway?", question!, yesno!, 1)
			if ll_opted <> 1 then
				return 1
			end if
			return
		end if
		if this.object.paymentmode[row] = "" or isnull(this.object.paymentmode[row]) then
			this.object.paymentmode[row] = "C"
			ll_globalcode = f_getglobalcode("GT_CashSub")
			parent.parent.parent.idc_paymentacccode.retrieve(ll_globalcode)
			this.object.paymentacccode[row] = parent.parent.parent.idc_paymentacccode.getitemnumber(1, "acccode")
		end if
		return 0
	case "paymentmode"
		if data = "" or isnull(data) then
			if this.object.amt[row] = 0 then
				return 0
			else
				return 1
			end if
		else
			if data = "C" then
				ll_globalcode = f_getglobalcode("GT_CashSub")
			else
				ll_globalcode = f_getglobalcode("GT_BankSub")
			end if
			SQL SELECT count ( *) INTO :ll_tmpcode FROM Accounts WHERE SubCode =:ll_globalcode USING sqlca;
			if ll_tmpcode > 0 then
				parent.parent.parent.idc_paymentacccode.reset()
				parent.parent.parent.idc_paymentacccode.retrieve(ll_globalcode)
				if parent.parent.parent.idc_paymentacccode.rowcount() > 0 then
					this.object.paymentacccode[row] = parent.parent.parent.idc_paymentacccode.getitemnumber(1, "acccode")
				end if
			else
				parent.parent.parent.idc_paymentacccode.reset()
				parent.parent.parent.idc_paymentacccode.insertrow(0)
				this.object.paymentacccode[row] = ll_null
			end if
		end if
	end choose
	return 0

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	long ll_globalcode
	long ll_tmpcode
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	selecttext(1, len(gettext()))
	if dwo.name = "paymentacccode" then
		if this.object.paymentmode[row] = "C" then
			ll_globalcode = f_getglobalcode("GT_CashSub")
		else
			ll_globalcode = f_getglobalcode("GT_BankSub")
		end if
		SQL SELECT count ( *) INTO :ll_tmpcode FROM Accounts WHERE SubCode =:ll_globalcode USING sqlca;
		if ll_tmpcode > 0 then
			parent.parent.parent.idc_paymentacccode.reset()
			parent.parent.parent.idc_paymentacccode.retrieve(ll_globalcode)
			this.object.paymentacccode[row] = parent.parent.parent.idc_paymentacccode.getitemnumber(1, "acccode")
		else
			parent.parent.parent.idc_paymentacccode.reset()
			parent.parent.parent.idc_paymentacccode.insertrow(0)
		end if
	end if
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_errormessage
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	ls_errormessage = "Please enter valid value "
	choose case dwo.name
	case "amt"
		ls_errormessage = ls_errormessage + " for Amount Received"
	case "paymentacccode"
		ls_errormessage = ls_errormessage + " for Cash/Bank Account"
	case else
		ls_errormessage = ls_errormessage + " for " + trim(dwo.name)
	end choose
	ls_errormessage = ls_errormessage + " in row number " + string(row)
	messagebox("Item Validation!", ls_errormessage)
	return 1

// cb_retrieve.clicked() returns long [event]
	long ll_rtcode
	parent.parent.parent.id_list.reset()
	ll_rtcode = parent.parent.parent.wf_retrievelist()
	parent.parent.parent.wf_first()
	parent.parent.parent.wf_selectunselectrow(1)
	parent.parent.parent.tab_retrieve.tabpage_list.dw_find.setfocus()
	return ::message.returnvalue
