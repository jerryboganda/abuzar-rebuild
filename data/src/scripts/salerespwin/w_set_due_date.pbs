// window w_set_due_date (salerespwin)  ancestor: window

// w_set_due_date.ue_close(integer ai_status) returns 0
	if ai_status = -1 then
	end if
	closewithreturn(this, 0)

// w_set_due_date.create() returns 0
	this.dw_control = create dw_control
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.control = {this.dw_control, this.cb_cancel, this.cb_ok}

// w_set_due_date.destroy() returns 0
	destroy this.dw_control
	destroy this.cb_cancel
	destroy this.cb_ok

// w_set_due_date.open() returns long
	string ls_aliasname
	string ls_name
	string ls_invcode
	long ll_rtcode
	long ll_invcode
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	this.istr_due_date = message.powerobjectparm
	this.dw_control.settransobject(this.istr_due_date.t_trans)
	this.dw_control.retrieve(this.istr_due_date.l_invcode)
	this.dw_control.scrolltorow(1)
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_control.itemchanged(long row, dwobject dwo, string data) returns long
	long ll_null
	integer li_errcode
	setnull(ll_null)
	choose case dwo.name
	case "rate"
		if double(data) < 0.0 then
			li_errcode = 1
		end if
	end choose
	return li_errcode

// dw_control.itemerror(long row, dwobject dwo, string data) returns long
	choose case dwo.name
	case "amt"
		messagebox("Amount Validation!", "Please Enter Valid Amount")
	case "paymentmode"
		messagebox("Payment Mode Validation!", "Please Enter Valid Payment Mode")
	end choose
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	SQL rollback USING parent.istr_due_date.t_trans;
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long
	integer li_retcode
	li_retcode = 1
	parent.dw_control.accepttext()
	if parent.dw_control.update() = 1 then
		SQL commit USING parent.istr_due_date.t_trans;
		messagebox("Due Date", "Changes take effect in database")
	else
		SQL rollback USING parent.istr_due_date.t_trans;
		messagebox("Due Date", "Problem in changing due date")
		li_retcode = -1
	end if
	parent.post event ue_close(li_retcode)
	return ::message.returnvalue
