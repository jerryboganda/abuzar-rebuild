// window w_popup_godownselection (salerespwin)  ancestor: w_popup_forselection

// w_popup_godownselection.create() returns 0 [event]
	call super::create

// w_popup_godownselection.destroy() returns 0 [event]
	call super::destroy

// w_popup_godownselection.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_popup_selection = message.powerobjectparm
	this.id_selectionlist.retrieve(this.is_popup_selection.l_longarray[1], this.is_popup_selection.l_longarray[2], this.is_popup_selection.l_longarray[3], this.is_popup_selection.l_longarray[4])
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_selected.ue_enterkey() returns long [event]
	return ::message.returnvalue
