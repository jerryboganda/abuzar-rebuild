// window w_customer_saledetail_report (salerespwin)  ancestor: window

// w_customer_saledetail_report.wf_print() returns 0
	if printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.dw_previnv.printcancel()
		return
	end if
	this.dw_previnv.print()

// w_customer_saledetail_report.create() returns 0 [event]
	this.dw_previnv = create dw_previnv
	this.control = {this.dw_previnv}

// w_customer_saledetail_report.destroy() returns 0 [event]
	destroy this.dw_previnv

// w_customer_saledetail_report.open() returns long [event]
	long ll_width
	long ll_height
	long ll_custcode
	long ll_counter
	long ll_rowcount
	environment env
	ll_custcode = message.doubleparm
	if getenvironment(env) <> 1 then
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.width = ll_width * 0.98
	this.height = ll_height * 0.80
	this.y = int((ll_height - this.height) / 2.0)
	this.dw_previnv.width = this.width - this.width * 0.02
	this.dw_previnv.height = this.height - this.width * 0.05
	if gs_company = "PEARLLUBE" or gs_company = "PEARLLUBE2" or gs_company = "PEARLLUBE3" or gs_company = "PEARLLUBE4" then
		this.dw_previnv.dataobject = "d_pearllube_cust_saledetail_sets_itemrep"
	else
		this.dw_previnv.dataobject = "d_customer_saledetail_sets_itemreport"
	end if
	this.dw_previnv.settransobject(sqlca)
	ll_rowcount = this.dw_previnv.retrieve(ll_custcode)
	this.dw_previnv.modify("DataWindow.Print.Preview=yes")
	this.dw_previnv.object.datawindow.print.buttons = "yes"
	setredraw(true)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_customer_saledetail_report.close() returns long [event]
	close(this)
	return ::message.returnvalue

// w_customer_saledetail_report.key(keycode key, unsignedlong keyflags) returns long [event]
	if keydown(keyescape!) then
		close(this)
	end if
	return ::message.returnvalue

// dw_previnv.ue_downkey(keycode key, unsignedlong keyflags) returns long [event]
	if keyflags = 2 and key = keyp! then
		parent.wf_print()
		setfocus()
	end if
	return ::message.returnvalue
