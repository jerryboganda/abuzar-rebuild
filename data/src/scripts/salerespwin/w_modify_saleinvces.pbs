// window w_modify_saleinvces (salerespwin)  ancestor: w_single_entry

// w_modify_saleinvces.wf_replace_custref() returns 0
	integer li_refno
	long ll_counter
	open(w_sale_replace_custref)
	li_refno = message.doubleparm
	if li_refno > 0 and this.id_detail.rowcount() > 0 then
		for ll_counter = 1 to this.id_detail.rowcount()
			choose case li_refno
			case 1
				this.id_detail.setitem(ll_counter, "CustRefno", string(this.id_detail.getitemnumber(ll_counter, "saleinvcode")))
			case 2
				this.id_detail.setitem(ll_counter, "CustRefno2", string(this.id_detail.getitemnumber(ll_counter, "saleinvcode")))
			case 3
				this.id_detail.setitem(ll_counter, "CustRefno3", string(this.id_detail.getitemnumber(ll_counter, "saleinvcode")))
			case 4
				this.id_detail.setitem(ll_counter, "CustRefno4", string(this.id_detail.getitemnumber(ll_counter, "saleinvcode")))
			end choose
		next
	end if

// w_modify_saleinvces.wf_update_billingdate() returns long
	integer li_refno
	long ll_counter
	s_arguements lstr_arg
	open(w_arg_sdate)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 and not isnull(lstr_arg.d_sdate) then
		for ll_counter = 1 to this.id_detail.rowcount()
			this.id_detail.setitem(ll_counter, "billingdate", lstr_arg.d_sdate)
		next
	end if
	return 0

// w_modify_saleinvces.ue_newform() returns 0 [event]
	long ll_found
	setredraw(false)
	this.i_editmode = 1
	this.i_retrievemode = 2
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_new.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_file.m_first.enabled = false
	this.im_menu.m_file.m_next.enabled = false
	this.im_menu.m_file.m_previous.enabled = false
	this.im_menu.m_file.m_last.enabled = false
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_retrieve.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.tab_retrieve.tabpage_detail.enabled = true
	this.id_detail.retrieve(this.istr_arg.l_code1, this.istr_arg.l_code2, this.istr_arg.l_code5, this.istr_arg.d_sdate, this.istr_arg.d_edate, this.istr_arg.l_code3, this.istr_arg.l_code4)
	this.id_detail.insertrow(0)
	this.id_detail.setcolumn(1)
	this.id_detail.setfocus()
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 686", 1, gds_securitywindow.rowcount())
	if ll_found <= 0 then
		this.id_detail.object.custcode.protect = 1
		this.id_detail.object.custcode.background.color = this.backcolor
	end if
	setredraw(true)

// w_modify_saleinvces.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_modify_saleinvoices" then
		this.menuid = create m_modify_saleinvoices
	end if

// w_modify_saleinvces.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_modify_saleinvces.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_modify_saleinvces.ue_save() returns 0 [event]
	long ll_primarykey
	long ll_row
	setpointer(hourglass!)
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if this.id_detail.rowcount() > 0 and not isnull(this.id_detail.object.saleinvcode) then
		this.id_detail.deleterow(this.id_detail.rowcount())
	end if
	if this.id_detail.update() > 0 then
		SQL commit USING sqlca;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		this.ib_commitok = true
		this.im_menu.m_file.m_new.enabled = true
		this.editflag = false
	else
		SQL rollback USING sqlca;
		setpointer(arrow!)
		messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs", exclamation!, ok!, 1)
		return
	end if
	setpointer(arrow!)

// w_modify_saleinvces.open() returns long [event]
	long ancestorreturnvalue
	this.istr_arg = message.powerobjectparm
	ancestorreturnvalue = super::open()
	this.tab_retrieve.tabpage_list.enabled = false
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// tabpage_detail.create() returns 0 [event]
	integer icurrent
	this.dw_1 = create dw_1
	call super::create
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_1

// tabpage_detail.destroy() returns 0 [event]
	call super::destroy
	destroy this.dw_1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	string ls_region
	string ls_name
	long ll_count
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "name"
		ls_region = lower(trim(data))
		SQL Select count ( *) INTO :ll_count From Region Where Region.name =:ls_region USING sqlca;
		if sqlca.sqlcode <> 0 then
			messagebox("Database Error", "Some database request has been fail")
			rt_code = 1
		elseif not isnull(ll_count) and ll_count > 0 then
			messagebox("Name Validation", "Name " + ls_name + " already exist~r~nEnter some differnt name")
			rt_code = 1
		end if
	end choose
	return rt_code

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "name"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	end choose
	return 1

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf5! then
		openwithparm(w_popup_saleitemdescription, getitemnumber(getrow(), "saleinvcode"))
	elseif key = keyf6! then
		openwithparm(w_popup_editsaledetail, getitemnumber(getrow(), "saleinvcode"))
	end if
	return ::message.returnvalue
