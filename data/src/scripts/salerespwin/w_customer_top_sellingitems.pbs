// window w_customer_top_sellingitems (salerespwin)  ancestor: window

// w_customer_top_sellingitems.create() returns 0 [event]
	this.dw_itemsalehistory = create dw_itemsalehistory
	this.control = {this.dw_itemsalehistory}

// w_customer_top_sellingitems.destroy() returns 0 [event]
	destroy this.dw_itemsalehistory

// w_customer_top_sellingitems.open() returns long [event]
	s_itemsalehistory ls_itemsalehistory
	long ll_width
	long ll_height
	environment env
	ls_itemsalehistory = message.powerobjectparm
	if getenvironment(env) <> 1 then
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.width = ll_width * 0.98
	this.height = ll_height * 0.85
	this.y = int((ll_height - this.height) / 2.0)
	this.dw_itemsalehistory.width = this.width - this.width * 0.02
	this.dw_itemsalehistory.height = this.height - this.width * 0.05
	this.dw_itemsalehistory.settransobject(sqlca)
	this.dw_itemsalehistory.retrieve(ls_itemsalehistory.ar_icode)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_customer_top_sellingitems.close() returns long [event]
	close(this)
	return ::message.returnvalue

// w_customer_top_sellingitems.key(keycode key, unsignedlong keyflags) returns long [event]
	if keydown(keyescape!) then
		close(this)
	end if
	return ::message.returnvalue
