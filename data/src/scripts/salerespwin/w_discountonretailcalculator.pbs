// window w_discountonretailcalculator (salerespwin)  ancestor: window

// w_discountonretailcalculator.ue_close(integer ai_status) returns 0 [event]
	if ai_status = -1 then
		this.istr_amountoninvoice.d_amt = this.istr_oldamountoninvoice.d_amt
		this.istr_amountoninvoice.i_acccode = this.istr_oldamountoninvoice.i_acccode
		this.istr_amountoninvoice.s_reference = this.istr_oldamountoninvoice.s_reference
		this.istr_amountoninvoice.i_status = this.istr_oldamountoninvoice.i_status
	end if
	closewithreturn(this, this.istr_amountoninvoice)

// w_discountonretailcalculator.create() returns 0 [event]
	this.dw_amountoninvoice = create dw_amountoninvoice
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.control = {this.dw_amountoninvoice, this.cb_cancel, this.cb_ok}

// w_discountonretailcalculator.destroy() returns 0 [event]
	destroy this.dw_amountoninvoice
	destroy this.cb_cancel
	destroy this.cb_ok

// w_discountonretailcalculator.open() returns long [event]
	string ls_aliasname
	string ls_name
	decimal ld_retailprice
	long ll_packunits
	string ls_invcode
	long ll_rtcode
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	this.istr_amountoninvoice = message.powerobjectparm
	this.istr_oldamountoninvoice = this.istr_amountoninvoice
	choose case this.istr_amountoninvoice.s_module
	case "sales"
		this.title = "Sales Discount On Retail"
	end choose
	this.id_dw = this.dw_amountoninvoice
	this.id_dw.settransobject(sqlca)
	this.id_dw.insertrow(0)
	this.id_dw.scrolltorow(0)
	SQL SELECT customicode , name , retailprice , packunits INTO :ls_aliasname, :ls_name, :ld_retailprice, :ll_packunits FROM Item WHERE ICode =:this.istr_amountoninvoice.l_invcode USING sqlca;
	this.id_dw.object.icode[1] = this.istr_amountoninvoice.l_invcode
	this.id_dw.object.aliasname[1] = ls_aliasname
	this.id_dw.object.name[1] = ls_name
	this.id_dw.object.retailprice[1] = this.istr_amountoninvoice.d_netamt
	this.id_dw.object.discount[1] = this.istr_amountoninvoice.d_amt
	if this.istr_amountoninvoice.d_netamt > 0 then
		this.id_dw.object.discperc[1] = round(this.istr_amountoninvoice.d_amt / this.istr_amountoninvoice.d_netamt * 100, 2)
	elseif this.istr_amountoninvoice.d_amt > 100 then
		this.id_dw.object.discperc[1] = 100
	else
		this.id_dw.object.discperc[1] = round(this.istr_amountoninvoice.d_amt, 2)
	end if
	this.id_dw.selecttext(1, len(this.id_dw.gettext()))
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_amountoninvoice.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ll_null
	integer li_errcode
	setnull(ll_null)
	choose case dwo.name
	case "rate"
		if double(data) < 0.0 then
			li_errcode = 1
		end if
	end choose
	return li_errcode

// dw_amountoninvoice.itemerror(long row, dwobject dwo, string data) returns long [event]
	choose case dwo.name
	case "amt"
		messagebox("Amount Validation!", "Please Enter Valid Amount")
	case "paymentmode"
		messagebox("Payment Mode Validation!", "Please Enter Valid Payment Mode")
	end choose
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.istr_amountoninvoice.i_status = -1
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	if parent.id_dw.accepttext() = 1 then
		if parent.id_dw.getitemdecimal(1, "discperc") < 0 then
			messagebox("Disc %age Validation!", "Please Enter Valid Discount %age.")
			parent.id_dw.setfocus()
			parent.id_dw.setcolumn("discperc")
			return ::message.returnvalue
		end if
		if parent.id_dw.getitemdecimal(1, "discperc") > 100 then
			messagebox("Disc %age Validation!", "Please Enter Valid Discount %age. Range [0-100]")
			parent.id_dw.setfocus()
			parent.id_dw.setcolumn("discperc")
			return ::message.returnvalue
		end if
		parent.id_dw.object.discount[1] = parent.id_dw.object.c_discount[1]
		parent.istr_amountoninvoice.d_netamt = parent.id_dw.getitemdecimal(1, "retailprice")
		parent.istr_amountoninvoice.d_amt = parent.id_dw.getitemdecimal(1, "discount")
		parent.istr_amountoninvoice.i_status = 1
		parent.post event ue_close(1)
	end if
	return ::message.returnvalue
