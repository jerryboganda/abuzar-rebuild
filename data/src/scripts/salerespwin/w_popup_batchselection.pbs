// window w_popup_batchselection (salerespwin)  ancestor: w_popup_forselection

// w_popup_batchselection.create() returns 0
	call super::create

// w_popup_batchselection.destroy() returns 0
	call super::destroy

// w_popup_batchselection.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_popup_selection = message.powerobjectparm
	this.id_selectionlist.retrieve(this.is_popup_selection.s_name2, this.is_popup_selection.l_code2)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue
