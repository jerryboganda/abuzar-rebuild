// window w_salesmanpassword_invtype (salerespwin)  ancestor: window

// w_salesmanpassword_invtype.ue_close() returns 0 [event]

// w_salesmanpassword_invtype.wf_protectdw(ref datawindow ad_dwcontrol, integer ai_doundo) returns long
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next
	return 0

// w_salesmanpassword_invtype.closequery() returns long [event]
	if this.ib_close = false then
		return 1
	end if
	return ::message.returnvalue

// w_salesmanpassword_invtype.create() returns 0 [event]
	this.st_customer = create st_customer
	this.cbx_credit = create cbx_credit
	this.dw_customer = create dw_customer
	this.dw_cash = create dw_cash
	this.cb_ok = create cb_ok
	this.cb_cancel = create cb_cancel
	this.gb_cash = create gb_cash
	this.control = {this.st_customer, this.cbx_credit, this.dw_customer, this.dw_cash, this.cb_ok, this.cb_cancel, this.gb_cash}

// w_salesmanpassword_invtype.destroy() returns 0 [event]
	destroy this.st_customer
	destroy this.cbx_credit
	destroy this.dw_customer
	destroy this.dw_cash
	destroy this.cb_ok
	destroy this.cb_cancel
	destroy this.gb_cash

// w_salesmanpassword_invtype.open() returns long [event]
	double ld_invamount
	s_cashierwindow ls_cashierwindow
	ls_cashierwindow = message.powerobjectparm
	this.dw_cash.settransobject(sqlca)
	this.dw_customer.settransobject(sqlca)
	this.dw_cash.insertrow(0)
	this.dw_customer.insertrow(0)
	if ls_cashierwindow.d_invamt < 0.0 then
		this.dw_cash.object.t_cashreceived.text = "Cash Paid:"
	end if
	this.dw_cash.setitem(1, "invamount", ls_cashierwindow.d_invamt)
	this.dw_customer.setitem(1, "custcode", ls_cashierwindow.l_custcode)
	this.is_return.l_mode = ls_cashierwindow.l_mode
	if ls_cashierwindow.l_mode = 1 then
		wf_protectdw(this.dw_cash, 1)
		wf_protectdw(this.dw_customer, 1)
		this.cbx_credit.enabled = false
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_salesmanpassword_invtype.close() returns long [event]
	hide()
	return ::message.returnvalue

// cbx_credit.clicked() returns long [event]
	if parent.cbx_credit.checked = true then
		parent.st_customer.visible = true
		parent.dw_customer.visible = true
		parent.dw_cash.setitem(1, "Cashreceived", 0)
		parent.dw_cash.setitem(1, "balance", 0)
	else
		parent.dw_customer.setitem(1, "custcode", 0)
		parent.is_return.l_custcode = 0
		parent.dw_customer.accepttext()
		parent.dw_customer.visible = false
		parent.st_customer.visible = false
	end if
	return ::message.returnvalue

// dw_cash.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// dw_cash.editchanged(long row, dwobject dwo, string data) returns long [event]
	double ld_invamount
	double ld_balance
	double ld_cashreceived
	ld_invamount = parent.dw_cash.getitemnumber(1, "invamount")
	if ld_invamount < 0.0 then
		ld_balance = double(data) + ld_invamount
	else
		ld_balance = double(data) - ld_invamount
	end if
	parent.dw_cash.setitem(1, "balance", ld_balance)
	return ::message.returnvalue

// cb_ok.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ll_custcode
	w_salesmanpassword_invtype w_parent
	if parent.is_return.l_mode = 1 then
		close(parent)
		return ::message.returnvalue
	end if
	parent.ib_close = true
	w_parent = getparent()
	w_parent.setfocus()
	parent.dw_cash.accepttext()
	parent.dw_customer.accepttext()
	parent.is_return.l_salesmancode = gl_usercode
	parent.is_return.d_cashtended = parent.dw_cash.getitemnumber(1, "cashreceived")
	parent.is_return.d_cashbalance = parent.dw_cash.getitemnumber(1, "balance")
	if parent.cbx_credit.checked = true then
		parent.is_return.l_custcode = parent.dw_customer.getitemnumber(1, "custcode")
		parent.is_return.d_cashtended = 0
		if parent.is_return.l_custcode = 0 or isnull(parent.is_return.l_custcode) then
			messagebox("Customer Validation", "Please Select Valid Customer")
			parent.dw_customer.setfocus()
			parent.dw_customer.setcolumn("custcode")
			return ::message.returnvalue
		end if
		return
	end if
	if parent.dw_cash.getitemnumber(1, "cashreceived") < 0.0 and parent.dw_cash.getitemnumber(1, "invamount") > 0.0 then
		messagebox("Cash Validation", "Negative Cash is not Allowed~r~nPlease Enter Valid Cash Value")
		parent.dw_cash.setfocus()
		parent.dw_cash.setcolumn("cashreceived")
		return ::message.returnvalue
	end if
	if parent.dw_cash.getitemnumber(1, "cashreceived") = 0.0 and parent.cbx_credit.checked = false and parent.dw_cash.getitemnumber(1, "invamount") > 0.0 then
		messagebox("Cash Validation", "Insert Cash Amount ~r~n OR Save as Credit Invoice and Select Customer")
		parent.dw_cash.setfocus()
		parent.dw_cash.setcolumn("cashreceived")
		return ::message.returnvalue
	end if
	if parent.dw_cash.getitemnumber(1, "cashreceived") < parent.dw_cash.getitemnumber(1, "invamount") and parent.cbx_credit.checked = false then
		messagebox("Cash Validation", "Please Enter Valid Cash Value")
		parent.dw_cash.setfocus()
		parent.dw_cash.setcolumn("cashreceived")
		return ::message.returnvalue
	end if
	if parent.dw_cash.getitemnumber(1, "invamount") < 0.0 and parent.dw_cash.getitemnumber(1, "cashreceived") + parent.dw_cash.getitemnumber(1, "invamount") <> 0.0 then
		messagebox("Cash Validation", "Please Enter Valid Cash Amount")
		parent.dw_cash.setfocus()
		parent.dw_cash.setcolumn("cashreceived")
		return ::message.returnvalue
	end if
	if parent.cbx_credit.checked = true then
		parent.is_return.b_lcd_flag = false
	else
		parent.is_return.b_lcd_flag = true
	end if
	closewithreturn(w_parent, parent.is_return)
	return ::message.returnvalue

// cb_cancel.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	w_salesmanpassword_invtype w_parent
	parent.ib_close = true
	parent.is_return.b_lcd_flag = false
	w_parent = getparent()
	w_parent.setfocus()
	parent.is_return.l_salesmancode = -1
	closewithreturn(w_parent, parent.is_return)
	return ::message.returnvalue
