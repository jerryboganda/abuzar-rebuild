// window w_popup_itemsearchcriteriaselection (salerespwin)  ancestor: window

// w_popup_itemsearchcriteriaselection.ue_close() returns 0
	closewithreturn(this, this.is_popup_selection)

// w_popup_itemsearchcriteriaselection.ue_cancel() returns 0
	this.is_popup_selection.l_code = -1
	closewithreturn(this, this.is_popup_selection)

// w_popup_itemsearchcriteriaselection.ue_keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		post event ue_cancel()
	end if
	return ::message.returnvalue

// w_popup_itemsearchcriteriaselection.create() returns 0
	this.rb_anywhere = create rb_anywhere
	this.rb_endswith = create rb_endswith
	this.rb_startswith = create rb_startswith
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.st_1 = create st_1
	this.em_itemname = create em_itemname
	this.gb_1 = create gb_1
	this.control = {this.rb_anywhere, this.rb_endswith, this.rb_startswith, this.cb_cancel, this.cb_ok, this.st_1, this.em_itemname, this.gb_1}

// w_popup_itemsearchcriteriaselection.destroy() returns 0
	destroy this.rb_anywhere
	destroy this.rb_endswith
	destroy this.rb_startswith
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.st_1
	destroy this.em_itemname
	destroy this.gb_1

// w_popup_itemsearchcriteriaselection.open() returns long
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	this.em_itemname.setfocus()
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.is_popup_selection.l_code = -1
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long
	string ls_name
	long ll_pos
	boolean lb_specialsearch
	parent.em_itemname.getdata(ls_name)
	if ls_name = "" or isnull(ls_name) then
		messagebox("Name Validation", "Please enter a value for name")
		parent.em_itemname.setfocus()
		return ::message.returnvalue
	end if
	parent.is_popup_selection.l_code = 1
	ll_pos = pos(ls_name, "'")
	if ll_pos > 0 then
		ls_name = replace(ls_name, ll_pos, 1, "~~'")
	end if
	ll_pos = pos(ls_name, "~"")
	if ll_pos > 0 then
		ls_name = replace(ls_name, ll_pos, 1, "~~~"")
	end if
	if parent.rb_anywhere.checked then
		parent.is_popup_selection.s_name2 = "%" + ls_name + "%"
	elseif parent.rb_startswith.checked then
		parent.is_popup_selection.s_name2 = ls_name + "%"
	elseif parent.rb_endswith.checked then
		parent.is_popup_selection.s_name2 = "%" + ls_name
	end if
	parent.is_popup_selection.s_name3 = "namesearch"
	parent.post event ue_close()
	return ::message.returnvalue

// em_itemname.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
		return 1
	elseif key = keyescape! then
		parent.post event ue_cancel()
	end if
	return ::message.returnvalue
