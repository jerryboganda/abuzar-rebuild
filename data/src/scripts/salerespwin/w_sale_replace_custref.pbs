// window w_sale_replace_custref (salerespwin)  ancestor: window

// w_sale_replace_custref.create() returns 0 [event]
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.dw_replace_custref = create dw_replace_custref
	this.control = {this.cb_cancel, this.cb_ok, this.dw_replace_custref}

// w_sale_replace_custref.destroy() returns 0 [event]
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.dw_replace_custref

// w_sale_replace_custref.open() returns long [event]
	this.dw_replace_custref.settransobject(sqlca)
	this.dw_replace_custref.insertrow(0)
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	closewithreturn(parent, -1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	closewithreturn(parent, parent.dw_replace_custref.getitemnumber(1, "custref"))
	return ::message.returnvalue
