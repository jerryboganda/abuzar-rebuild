// window w_popup_itemselection_2 (salerespwin)  ancestor: w_popup_forselection

// w_popup_itemselection_2.wf_getitems(string as_search_col, string as_items, long al_code) returns long
	long ll_rtcode
	long ll_counter
	long ll_rowcount
	datastore lds_itemlist
	lds_itemlist = create datastore
	if as_search_col = "modelcode" then
		lds_itemlist.dataobject = "d_model_items"
	elseif as_search_col = "authorcode" then
		lds_itemlist.dataobject = "d_author_items"
	elseif as_search_col = "masteripartcode" then
		lds_itemlist.dataobject = "d_masteripartcode_items"
	end if
	lds_itemlist.settransobject(sqlca)
	ll_rtcode = lds_itemlist.retrieve(al_code)
	ll_rowcount = lds_itemlist.rowcount()
	if ll_rtcode > 0 then
		for ll_counter = 1 to ll_rowcount
			as_items = as_items + trim(string(lds_itemlist.object.icode[ll_counter]))
			if ll_counter <> ll_rowcount then
				as_items = as_items + " ,"
			end if
		next
	end if
	return ll_rtcode

// w_popup_itemselection_2.wf_populatedetails(long al_code) returns long
	long ll_ipartcode
	if al_code > 0 then
		SQL SELECT IPartCode =I.IPartCode INTO :ll_ipartcode FROM DBO.ItemPart IP , Item I WHERE I.ICode =:al_code AND I.IPartCode =IP.IPartCode USING sqlca;
		if sqlca.sqlcode = 0 and ll_ipartcode > 0 then
			this.dw_detail.retrieve(ll_ipartcode)
			this.dw_detail2.retrieve(ll_ipartcode)
		end if
	end if
	return 0

// w_popup_itemselection_2.create() returns 0
	integer icurrent
	call super::create
	this.dw_detail = create dw_detail
	this.dw_detail2 = create dw_detail2
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_detail
	this.control[icurrent + 2] = this.dw_detail2

// w_popup_itemselection_2.destroy() returns 0
	call super::destroy
	destroy this.dw_detail
	destroy this.dw_detail2

// w_popup_itemselection_2.open() returns long
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	long li_groupcode
	long ll_code
	long ll_found
	long ll_retcode
	string ls_selection
	string ls_searchtype
	string ls_items
	boolean lb_restricteditems
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width * 0.99
		ll_height = ll_win_height * 0.95
		this.width = ll_width
		this.height = ll_height
		if ll_width > 0 and ll_height > 0 then
			this.x = (ll_win_width - ll_width) / 2.0
			this.y = (ll_win_height - ll_height) / 2.0
		end if
		this.dw_selectionlist.width = ll_width * 0.95
		this.dw_detail.width = ll_width * 0.95
		this.dw_detail2.width = ll_width * 0.95
		this.dw_selectionlist.height = (ll_height - 130 - this.dw_detail.height) * 0.60
		this.dw_detail2.height = (ll_height - 130 - this.dw_detail.height) * 0.30
		this.dw_selectionlist.y = 5
		this.dw_detail.y = 5 + this.dw_selectionlist.height + 5
		this.dw_detail2.y = 5 + this.dw_selectionlist.height + 5 + this.dw_detail.height
		this.cb_ok.x = ll_width / 2.0 - this.cb_ok.width - 10.0
		this.cb_cancel.x = ll_width / 2.0 + 20.0
		this.cb_ok.y = this.dw_detail2.y + this.dw_detail2.height + 10
		this.cb_cancel.y = this.dw_detail2.y + this.dw_detail2.height + 10
	end if
	setredraw(false)
	this.id_selected = create datawindow
	this.id_selected.settransobject(sqlca)
	this.id_selected = this.dw_selected
	this.id_selectionlist = create datawindow
	this.id_selectionlist = this.dw_selectionlist
	this.id_selectionlist.settransobject(sqlca)
	this.id_selected.reset()
	this.id_selected.insertrow(0)
	setredraw(true)
	post event ue_postopen()
	this.dw_detail.settransobject(sqlca)
	this.dw_detail.insertrow(0)
	this.dw_detail2.settransobject(sqlca)
	this.dw_detail2.insertrow(0)
	this.is_popup_selection = message.powerobjectparm
	li_groupcode = f_getgroupcode(gl_usercode)
	ll_code = this.is_popup_selection.l_code
	ls_selection = this.is_popup_selection.s_name2
	ls_searchtype = this.is_popup_selection.s_name3
	setredraw(false)
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found <= 0 then
		this.id_selectionlist.object.purprice.visible = false
		this.dw_detail.object.purprice.visible = false
		this.dw_detail.object.t_purprice.visible = false
	end if
	gd_popup_itemsinfo.sharedata(this.id_selectionlist)
	ll_retcode = this.id_selectionlist.getchild("ipartcode", this.idc_itempart)
	if ll_retcode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_found = gds_securitywindow.find(" rightcode = 515 ", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_restricteditems = true
	end if
	if lb_restricteditems then
		if ls_searchtype = "criteriasearch" then
			if ls_selection = "modelcode" or ls_selection = "masteripartcode" or ls_selection = "authorcode" then
				if wf_getitems(ls_selection, ls_items, ll_code) > 0 then
					this.id_selectionlist.setfilter(" Code IN (" + ls_items + ")")
				else
					this.id_selectionlist.setfilter(" Code = -1")
				end if
			else
				this.id_selectionlist.setfilter(ls_selection + " = " + string(ll_code))
			end if
		elseif ls_searchtype = "namesearch" then
			this.id_selectionlist.setfilter("name like '" + ls_selection + "'")
		end if
	elseif ls_searchtype = "criteriasearch" then
		if ls_selection = "modelcode" or ls_selection = "masteripartcode" or ls_selection = "authorcode" then
			if wf_getitems(ls_selection, ls_items, ll_code) > 0 then
				this.id_selectionlist.setfilter(" Code IN (" + ls_items + ") And restricted = 'N' ")
			else
				this.id_selectionlist.setfilter(" Code = -1")
			end if
		else
			this.id_selectionlist.setfilter(ls_selection + " = " + string(ll_code) + " And restricted = 'N' ")
		end if
	elseif ls_searchtype = "namesearch" then
		this.id_selectionlist.setfilter("name like '" + ls_selection + "' And restricted = 'N' ")
	end if
	this.id_selectionlist.filter()
	setredraw(true)
	this.id_selectionlist.setfocus()
	this.id_selectionlist.setcolumn("name")
	if this.id_selectionlist.rowcount() > 0 then
		ls_searchtype = f_stringpreferences("QuickPrefferedSearchType")
		if upper(ls_searchtype) = "X" and ls_selection = "masteripartcode" then
			if not (this.is_popup_selection.s_name = "" or isnull(this.is_popup_selection)) then
				if upper(ls_searchtype) = "X" then
					ll_found = this.id_selectionlist.find("itempartno = '" + trim(this.is_popup_selection.s_name) + "' ", 1, this.id_selectionlist.rowcount())
				end if
				if ll_found > 0 then
					if ll_found > this.id_selectionlist.rowcount() or ll_found <= 0 then
						ll_found = 1
					end if
					this.il_itemlistfoundrow = ll_found
					this.id_selectionlist.selectrow(0, false)
					this.id_selectionlist.setrow(this.il_itemlistfoundrow)
					this.id_selectionlist.scrolltorow(this.il_itemlistfoundrow)
					this.id_selectionlist.selectrow(this.il_itemlistfoundrow, true)
					wf_populatedetails(this.id_selectionlist.getitemnumber(this.il_itemlistfoundrow, "code"))
					this.is_popup_selection.l_code = this.id_selectionlist.getitemnumber(this.il_itemlistfoundrow, "code")
					this.is_popup_selection.s_name = this.id_selectionlist.getitemstring(this.il_itemlistfoundrow, "name")
					wf_inititem(this.is_popup_selection.l_code)
				end if
			end if
		end if
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_popup_itemselection_2.ue_postopen() returns 0
	long li_counter
	long ll_startrow
	long ll_rowcount
	char lc_char
	ll_rowcount = this.id_selectionlist.rowcount()
	if ll_rowcount <= 0 or isnull(ll_rowcount) then
		messagebox("Row Validation", "There are no rows to select in SelectionList.~r~nKindly try again.")
		this.is_popup_selection.l_code = -1
		closewithreturn(this, this.is_popup_selection)
		return
	end if
	setredraw(false)
	this.id_selectionlist.setsort("name A")
	this.id_selectionlist.sort()
	for li_counter = 65 to 90
		lc_char = char(li_counter)
		this.ia_llookuptable[li_counter] = this.id_selectionlist.find("Lower(name) >= Lower('" + char(li_counter) + "')", ll_startrow, this.id_selectionlist.rowcount())
		ll_startrow = this.ia_llookuptable[li_counter]
	next
	this.ia_llookuptable[92] = this.id_selectionlist.rowcount()
	setredraw(true)

// w_popup_itemselection_2.key(keycode key, unsignedlong keyflags) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::key(key, keyflags)
	if key = keyescape! then
		post event ue_cancel()
	end if
	return 0
