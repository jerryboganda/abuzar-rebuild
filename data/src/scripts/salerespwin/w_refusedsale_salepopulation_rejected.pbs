// window w_refusedsale_salepopulation_rejected (salerespwin)  ancestor: window

// w_refusedsale_salepopulation_rejected.create() returns 0
	this.cb_close = create cb_close
	this.cb_save = create cb_save
	this.cb_print = create cb_print
	this.dw_report = create dw_report
	this.control = {this.cb_close, this.cb_save, this.cb_print, this.dw_report}

// w_refusedsale_salepopulation_rejected.destroy() returns 0
	destroy this.cb_close
	destroy this.cb_save
	destroy this.cb_print
	destroy this.dw_report

// w_refusedsale_salepopulation_rejected.open() returns long
	datastore lds_items
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_counter
	long ll_currentrow
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	lds_items = create datastore
	lds_items.settransobject(sqlca)
	this.dw_report.settransobject(sqlca)
	lds_items = message.powerobjectparm
	lds_items.sharedata(this.dw_report)
	this.dw_report.sort()
	this.dw_report.modify("DataWindow.Print.Preview=yes")
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_refusedsale_salepopulation_rejected.key(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		close(this)
	end if
	return ::message.returnvalue

// cb_close.clicked() returns long
	close(parent)
	return ::message.returnvalue

// cb_save.clicked() returns long
	parent.dw_report.saveas()
	return ::message.returnvalue

// cb_print.clicked() returns long
	if parent.dw_report.visible then
		if printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			parent.dw_report.printcancel()
		end if
		parent.dw_report.print()
	end if
	return ::message.returnvalue
