// window w_arg_postsaleheaderwise (salerespwin)  ancestor: w_arguements

// w_arg_postsaleheaderwise.create() returns 0 [event]
	integer icurrent
	call super::create
	this.st_4 = create st_4
	this.cbx_cash = create cbx_cash
	this.cbx_credit = create cbx_credit
	this.dw_headerno = create dw_headerno
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.st_4
	this.control[icurrent + 2] = this.cbx_cash
	this.control[icurrent + 3] = this.cbx_credit
	this.control[icurrent + 4] = this.dw_headerno

// w_arg_postsaleheaderwise.destroy() returns 0 [event]
	call super::destroy
	destroy this.st_4
	destroy this.cbx_cash
	destroy this.cbx_credit
	destroy this.dw_headerno

// w_arg_postsaleheaderwise.open() returns long [event]
	long ancestorreturnvalue
	datawindowchild ldc_headerno
	long ll_counter
	ancestorreturnvalue = super::open()
	this.dw_control.settransobject(sqlca)
	this.dw_control.insertrow(0)
	this.dw_control.scrolltorow(0)
	this.dw_headerno.settransobject(sqlca)
	this.dw_headerno.insertrow(0)
	this.dw_headerno.scrolltorow(0)
	this.dw_headerno.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to gds_reoprtheaderinfo.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "name", gds_reoprtheaderinfo.getitemstring(ll_counter, "clientname"))
		ldc_headerno.setitem(ll_counter, "code", gds_reoprtheaderinfo.getitemnumber(ll_counter, "headerno"))
	next
	return ::message.returnvalue

// w_arg_postsaleheaderwise.ue_close(integer ai_stauts) returns 0 [event]
	super::ue_close(ai_stauts)
	closewithreturn(this, this.istr_arg)

// cb_cancel.clicked() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked()
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	parent.dw_control.accepttext()
	parent.dw_headerno.accepttext()
	parent.istr_arg.l_code1 = parent.dw_control.getitemnumber(1, "sinvcode")
	parent.istr_arg.l_code2 = parent.dw_control.getitemnumber(1, "linvcode")
	parent.istr_arg.l_code3 = parent.dw_headerno.getitemnumber(1, "headerno")
	parent.istr_arg.i_status = 1
	if parent.cbx_cash.checked then
		parent.istr_arg.ia_integerlist[3] = 3
	end if
	if parent.cbx_credit.checked then
		parent.istr_arg.ia_integerlist[2] = 2
		parent.istr_arg.ia_integerlist[1] = 1
	end if
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_headerno.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1
