// window w_review_proformasale_item_replacement (salerespwin)  ancestor: window

// w_review_proformasale_item_replacement.wf_set_loyaltypoints(long al_acccode) returns long
	datetime ldt_balancedate
	long ll_layaltypointsbalance
	long ll_retcode
	double ld_layaltypointsvalue
	SQL SELECT GETDATE ( ) INTO :ldt_balancedate FROM _Utn USING sqlca;
	if sqlca.sqlcode = 0 and al_acccode > 0 then
		sqlca.getaccountloyaltybalance(al_acccode, ldt_balancedate, ll_layaltypointsbalance, ld_layaltypointsvalue)
		if sqlca.sqlcode = 0 then
			this.dw_report.object.loyaltypointsbalance[1] = ll_layaltypointsbalance
			this.dw_report.object.loyaltypointsvalue[1] = ld_layaltypointsvalue
		else
			messagebox("Loyalty Points Balance", "Loyalty Points Fetching Error.~r~nDetails are:-~r~n" + sqlca.sqlerrtext)
			ll_retcode = -1
		end if
	end if
	return ll_retcode

// w_review_proformasale_item_replacement.create() returns 0 [event]
	this.cb_updatelater = create cb_updatelater
	this.cb_close = create cb_close
	this.cb_update = create cb_update
	this.dw_report = create dw_report
	this.control = {this.cb_updatelater, this.cb_close, this.cb_update, this.dw_report}

// w_review_proformasale_item_replacement.destroy() returns 0 [event]
	destroy this.cb_updatelater
	destroy this.cb_close
	destroy this.cb_update
	destroy this.dw_report

// w_review_proformasale_item_replacement.open() returns long [event]
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_counter
	long ll_currentrow
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	this.istr_arg = message.powerobjectparm
	this.dw_report.settransobject(sqlca)
	this.dw_report.retrieve(this.istr_arg.l_code3, this.istr_arg.l_code1, this.istr_arg.db_code1, this.istr_arg.l_code2, this.istr_arg.db_code2)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_review_proformasale_item_replacement.key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		closewithreturn(this, -1)
	end if
	return ::message.returnvalue

// cb_updatelater.clicked() returns long [event]
	closewithreturn(parent, 2)
	return ::message.returnvalue

// cb_close.clicked() returns long [event]
	closewithreturn(parent, -1)
	return ::message.returnvalue

// cb_update.clicked() returns long [event]
	if parent.dw_report.accepttext() = 1 then
		closewithreturn(parent, 1)
	end if
	return ::message.returnvalue

// dw_report.getfocus() returns long [event]
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_report.itemfocuschanged(long row, dwobject dwo) returns long [event]
	selecttext(1, len(gettext()))
	return ::message.returnvalue
