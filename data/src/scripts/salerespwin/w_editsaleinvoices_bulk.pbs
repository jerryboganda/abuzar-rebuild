// window w_editsaleinvoices_bulk (salerespwin)  ancestor: window

// w_editsaleinvoices_bulk.ue_keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		post event ue_close()
	end if
	return ::message.returnvalue

// w_editsaleinvoices_bulk.ue_close() returns 0
	closewithreturn(this, this.istr_arg)

// w_editsaleinvoices_bulk.wf_setnewtabid(string as_tablename, long al_newid) returns long
	long ll_rtcode
	SQL SELECT TABMAXKEY INTO :al_newid FROM _TABMAXKEY WITH ( UPDLOCK HOLDLOCK ) WHERE _TABMAXKEY.TABName =:as_tablename USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_newid = al_newid + 1
		SQL update dbo._tabmaxkey SET TABMAXKEY =:al_newid WHERE _TABMAXKEY.TABName =:as_tablename USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			ll_rtcode = this.it_transobject.sqlcode
		else
			ll_rtcode = this.it_transobject.sqlcode
			al_newid = 0
		end if
	else
		ll_rtcode = this.it_transobject.sqlcode
		al_newid = 0
	end if
	return ll_rtcode

// w_editsaleinvoices_bulk.wf_setdetails() returns integer
	long ll_counter
	for ll_counter = 1 to this.dw_detail.rowcount()
		this.dw_detail.object.saleprice[ll_counter] = this.istr_arg2.db_code1
		this.dw_detail.object.discperc[ll_counter] = this.istr_arg2.db_code2
	next
	return 0

// w_editsaleinvoices_bulk.create() returns 0
	this.dw_footer = create dw_footer
	this.cb_retrieve = create cb_retrieve
	this.cb_update = create cb_update
	this.dw_detail = create dw_detail
	this.dw_master = create dw_master
	this.control = {this.dw_footer, this.cb_retrieve, this.cb_update, this.dw_detail, this.dw_master}

// w_editsaleinvoices_bulk.destroy() returns 0
	destroy this.dw_footer
	destroy this.cb_retrieve
	destroy this.cb_update
	destroy this.dw_detail
	destroy this.dw_master

// w_editsaleinvoices_bulk.open() returns long
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	this.it_transobject = create u_transaction
	SQL start USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		close(this)
		return ::message.returnvalue
	end if
	open(w_arg_customers_sinvcode_linvcode_v2)
	this.istr_arg = ::message.powerobjectparm
	if this.istr_arg.i_status = 1 then
		open(w_arg_item_saleprice_discperc)
		this.istr_arg2 = ::message.powerobjectparm
		if this.istr_arg2.i_status <> 1 then
			close(this)
			return ::message.returnvalue
		end if
	else
		close(this)
		return ::message.returnvalue
	end if
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		this.width = ll_win_width * 0.98
		this.height = ll_win_height * 0.90
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	this.dw_detail.width = this.width * 0.98
	this.dw_detail.height = this.height - this.dw_master.height - 230
	this.cb_retrieve.y = this.height - 250
	this.cb_update.y = this.height - 250
	this.dw_master.settransobject(this.it_transobject)
	this.dw_detail.settransobject(this.it_transobject)
	this.dw_footer.settransobject(this.it_transobject)
	this.dw_master.retrieve()
	this.dw_master.scrolltorow(0)
	this.dw_master.setfocus()
	this.dw_detail.retrieve(this.istr_arg.l_code1, this.istr_arg.l_code2, this.istr_arg.l_code3, this.istr_arg.l_code4, this.istr_arg2.l_code1, this.istr_arg2.db_code1, this.istr_arg2.db_code2)
	wf_setdetails()
	return ::message.returnvalue

// cb_retrieve.clicked() returns long
	string ls_filter
	long ll_masterrow
	parent.dw_master.accepttext()
	ll_masterrow = parent.dw_master.getrow()
	parent.dw_detail.setredraw(false)
	parent.dw_detail.retrieve(parent.istr_arg.l_code1, parent.istr_arg.l_code2, parent.istr_arg.l_code3, parent.istr_arg.l_code4, parent.istr_arg2.l_code1, parent.istr_arg2.db_code1, parent.istr_arg2.db_code2)
	parent.wf_setdetails()
	parent.dw_detail.setredraw(true)
	return ::message.returnvalue

// cb_update.clicked() returns long
	long ll_rowcount
	long ll_counter
	long ll_code
	long ll_null
	long ll_insrow
	long ll_rowid
	double ld_saleprice
	double ld_discperc
	string ls_remarks
	boolean lb_ok
	string ls_date
	setpointer(hourglass!)
	setnull(ll_null)
	if parent.dw_detail.accepttext() = 1 then
		ll_rowcount = parent.dw_detail.rowcount()
		if ll_rowcount > 0 then
			for ll_counter = 1 to ll_rowcount
				ll_code = parent.dw_detail.object.saleinvcode[ll_counter]
				ld_saleprice = parent.dw_detail.object.saleprice[ll_counter]
				ld_discperc = parent.dw_detail.object.discperc[ll_counter]
				ll_rowid = parent.dw_detail.object.rowid[ll_counter]
				SQL update SaleDetail SET Saleprice =:ld_saleprice , Discperc =:ld_discperc WHERE SaleInvCode =:ll_code AND Rowid =:ll_rowid USING parent.it_transobject;
				if parent.it_transobject.sqlcode = 0 then
					SQL update SaleLedger SET InvTotal =DBO.fn_GetSaleInvTotal ( SaleInvCode ) , OutStandingAmt =DBO.fn_GetSaleInvTotal ( SaleInvCode ) WHERE SaleInvCode =:ll_code USING parent.it_transobject;
					if parent.it_transobject.sqlcode <> 0 then
						messagebox("Updation Problem", "Problem in updation of saleprices and discount.", stopsign!)
						SQL rollback USING parent.it_transobject;
						close(parent)
						return ::message.returnvalue
					end if
				else
					messagebox("Updation Problem", "Problem in updation of saleprices and discount.", stopsign!)
					SQL rollback USING parent.it_transobject;
					close(parent)
					return ::message.returnvalue
				end if
			next
		end if
		if lb_ok then
			SQL commit USING parent.it_transobject;
			close(parent)
			return ::message.returnvalue
		end if
		return
	end if
	setpointer(arrow!)
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_detail.getfocus() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_master.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
