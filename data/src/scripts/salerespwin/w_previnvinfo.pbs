// window w_previnvinfo (salerespwin)  ancestor: window

// w_previnvinfo.create() returns 0 [event]
	this.cb_print = create cb_print
	this.dw_previnv = create dw_previnv
	this.control = {this.cb_print, this.dw_previnv}

// w_previnvinfo.destroy() returns 0 [event]
	destroy this.cb_print
	destroy this.dw_previnv

// w_previnvinfo.open() returns long [event]
	s_previnvinfo ls_previnvinfo
	long ll_width
	long ll_height
	environment env
	ls_previnvinfo = message.powerobjectparm
	if getenvironment(env) <> 1 then
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.width = ll_width * 0.98
	this.height = ll_height * 0.90
	this.y = int((ll_height - this.height) / 2.0)
	this.dw_previnv.width = this.width - this.width * 0.02
	this.dw_previnv.height = this.height * 0.90
	this.cb_print.y = this.dw_previnv.height + 20
	if isnull(ls_previnvinfo.ar_patientcode) then
		this.dw_previnv.dataobject = "d_previnv"
		this.dw_previnv.settransobject(sqlca)
		this.dw_previnv.retrieve(ls_previnvinfo.ar_customer, ls_previnvinfo.ar_icode, ls_previnvinfo.ar_invdate)
	else
		this.dw_previnv.dataobject = "d_previnv2"
		this.dw_previnv.settransobject(sqlca)
		this.dw_previnv.retrieve(ls_previnvinfo.ar_customer, ls_previnvinfo.ar_patientcode, ls_previnvinfo.ar_icode, ls_previnvinfo.ar_invdate)
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_previnvinfo.close() returns long [event]
	close(this)
	return ::message.returnvalue

// w_previnvinfo.key(keycode key, unsignedlong keyflags) returns long [event]
	if keydown(keyescape!) then
		close(this)
	end if
	return ::message.returnvalue

// cb_print.clicked() returns long [event]
	if parent.dw_previnv.visible then
		if printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			parent.dw_previnv.printcancel()
		end if
		parent.dw_previnv.print()
	end if
	return ::message.returnvalue
