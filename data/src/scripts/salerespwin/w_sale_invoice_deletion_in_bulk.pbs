// window w_sale_invoice_deletion_in_bulk (salerespwin)  ancestor: window

// w_sale_invoice_deletion_in_bulk.ue_close(integer ai_status) returns 0
	SQL stop USING this.it_datatransobject;
	destroy this.it_datatransobject
	close(this)

// w_sale_invoice_deletion_in_bulk.wf_disconnect() returns 0
	SQL stop USING this.it_datatransobject;
	destroy this.it_datatransobject

// w_sale_invoice_deletion_in_bulk.wf_connect() returns integer
	this.it_datatransobject = create u_transaction
	SQL start USING this.it_datatransobject;
	return this.it_datatransobject.sqlcode

// w_sale_invoice_deletion_in_bulk.create() returns 0
	this.dw_control = create dw_control
	this.hpb_basic = create hpb_basic
	this.cb_cancel = create cb_cancel
	this.cb_delete = create cb_delete
	this.gb_options = create gb_options
	this.gb_basic = create gb_basic
	this.control = {this.dw_control, this.hpb_basic, this.cb_cancel, this.cb_delete, this.gb_options, this.gb_basic}

// w_sale_invoice_deletion_in_bulk.destroy() returns 0
	destroy this.dw_control
	destroy this.hpb_basic
	destroy this.cb_cancel
	destroy this.cb_delete
	destroy this.gb_options
	destroy this.gb_basic

// w_sale_invoice_deletion_in_bulk.open() returns long
	long ll_appversion
	long ll_sequenceid
	long ll_dbstatus
	long ll_parentappversion
	long ll_parentsequenceid
	long ll_parentdbstatus
	long ll_retcode
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	open(w_attention_sale_invoice_deletion)
	if message.doubleparm <= 0.0 then
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	ll_retcode = wf_connect()
	if ll_retcode <> 0 then
		messagebox("Connection Problem", "Problem Connecting Parent Server Database, Details are:-~r~n" + this.it_datatransobject.sqlerrtext)
		post event ue_close(0)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	this.dw_control.settransobject(this.it_datatransobject)
	this.dw_control.retrieve()
	this.dw_control.setfocus()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_sale_invoice_deletion_in_bulk.close() returns long
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.post event ue_close(0)
	return ::message.returnvalue

// cb_delete.clicked() returns long
	boolean lb_ok
	string ls_errtext
	long ll_del
	long ll_startsaleinvcode
	long ll_res
	setpointer(hourglass!)
	parent.dw_control.accepttext()
	ll_startsaleinvcode = parent.dw_control.object.startsaleinvcode[1]
	if ll_startsaleinvcode <= 0 or isnull(ll_startsaleinvcode) then
		messagebox("Starting Sale Invoice Code", "Please enter valid Starting Sale Invoice Code", stopsign!)
		return ::message.returnvalue
	elseif ll_startsaleinvcode > parent.dw_control.object.endsaleinvcode[1] then
		messagebox("Starting Sale Invoice Code", "Starting Sale Invoice Code must be less than Ending Sale Invoice Code~r~nPlease enter valid Starting Sale Invoice Code", stopsign!)
		return ::message.returnvalue
	end if
	ll_res = messagebox("Risk Alert", "Sale Invoice Deletion in Bulk is a risky process.~r~nSale Invoices Once deleted cannot be recovered~r~nDo you still want to proceed with Deletion Process?", question!, yesno!, 2)
	if ll_res > 1 then
		return ::message.returnvalue
	end if
	SQL rollback USING parent.it_datatransobject;
	parent.gb_basic.visible = true
	parent.hpb_basic.visible = true
	if lb_ok then
		parent.hpb_basic.stepit()
		ll_del = parent.it_datatransobject.deletesaleinvoice_bulk(ll_startsaleinvcode)
		parent.hpb_basic.stepit()
		if parent.it_datatransobject.sqlcode <> 0 then
			ls_errtext = "Sale Invoice Deletion - In Bulk : ~r~n" + parent.it_datatransobject.sqlerrtext
			SQL rollback USING parent.it_datatransobject;
			messagebox("Sale Invoice Deletion - In Bulk Error", ls_errtext)
			lb_ok = false
		else
			SQL commit USING parent.it_datatransobject;
			messagebox("Sale Invoice Deletion", "Deletion of Sales invoices completed.~r~nChanges Take Effect in database.", information!)
			parent.hpb_basic.stepit()
		end if
	end if
	setpointer(arrow!)
	parent.post event ue_close(1)
	return ::message.returnvalue
