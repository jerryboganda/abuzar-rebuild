// window w_pricecalculator_pur (purchaseresponsewin)  ancestor: window

// w_pricecalculator_pur.ue_close(integer ai_status) returns 0
	closewithreturn(this, this.istr_amountoninvoice)

// w_pricecalculator_pur.create() returns 0
	this.dw_amountoninvoice = create dw_amountoninvoice
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.control = {this.dw_amountoninvoice, this.cb_cancel, this.cb_ok}

// w_pricecalculator_pur.destroy() returns 0
	destroy this.dw_amountoninvoice
	destroy this.cb_cancel
	destroy this.cb_ok

// w_pricecalculator_pur.open() returns long
	string ls_aliasname
	string ls_name
	decimal ld_saleprice
	decimal ld_netrate
	decimal ld_markup
	long ll_packunits
	string ls_invcode
	long ll_rtcode
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	this.istr_amountoninvoice = message.powerobjectparm
	choose case this.istr_amountoninvoice.s_module
	case "Purchase"
		this.title = "Sale Price Calculator"
	end choose
	this.id_dw = this.dw_amountoninvoice
	this.id_dw.settransobject(sqlca)
	this.id_dw.insertrow(0)
	this.id_dw.scrolltorow(0)
	this.id_dw.object.icode[1] = this.istr_amountoninvoice.l_icode
	this.id_dw.object.aliasname[1] = this.istr_amountoninvoice.s_name2
	this.id_dw.object.name[1] = this.istr_amountoninvoice.s_name
	this.id_dw.object.saleprice[1] = this.istr_amountoninvoice.d_saleprice
	this.id_dw.object.netrate[1] = this.istr_amountoninvoice.d_netrate
	this.id_dw.object.newsaleprice[1] = this.istr_amountoninvoice.d_saleprice
	ld_netrate = this.istr_amountoninvoice.d_netrate
	if ld_netrate = 0 or isnull(ld_netrate) then
		ld_netrate = 1
	end if
	ld_saleprice = this.istr_amountoninvoice.d_saleprice
	ld_markup = round((ld_saleprice - this.istr_amountoninvoice.d_netrate) * 100 / ld_netrate, 2)
	this.id_dw.object.perposedmarkup[1] = ld_markup
	this.id_dw.selecttext(1, len(this.id_dw.gettext()))
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_amountoninvoice.ue_enterkey() returns long
	send(handle(this), 256, 9, long(90))
	return 1

// dw_amountoninvoice.itemchanged(long row, dwobject dwo, string data) returns long
	long ll_null
	long ll_salepricecriteria
	integer li_errcode
	double ld_proposedmarkup
	double ld_netrate
	double ld_newsaleprice
	double ld_saleprice
	setnull(ll_null)
	choose case dwo.name
	case "rate"
		if double(data) < 0.0 then
			li_errcode = 1
		end if
	case "salepricecriteria"
		ld_saleprice = getitemnumber(1, "newsaleprice")
		ld_netrate = getitemnumber(1, "NetRate")
		ld_proposedmarkup = getitemnumber(1, "perposedmarkup")
		ll_salepricecriteria = long(data)
		if ld_proposedmarkup <= 0.0 then
			ld_proposedmarkup = 1
		end if
		if ld_saleprice <= 0.0 then
			ld_saleprice = 1
		end if
		if ld_netrate <= 0.0 then
			ld_netrate = 1
		end if
		if ll_salepricecriteria = 1 then
			ld_proposedmarkup = (ld_saleprice - ld_netrate) / ld_netrate * 100.0
		else
			ld_proposedmarkup = (ld_saleprice - ld_netrate) / ld_saleprice * 100.0
		end if
		setitem(1, "perposedmarkup", ld_proposedmarkup)
	case "perposedmarkup"
		ld_proposedmarkup = double(data)
		ld_saleprice = getitemnumber(1, "newsaleprice")
		ld_netrate = getitemnumber(1, "NetRate")
		ll_salepricecriteria = getitemnumber(1, "salepricecriteria")
		if ld_proposedmarkup <= 0.0 then
			ld_proposedmarkup = 1
		end if
		if ld_saleprice <= 0.0 then
			ld_saleprice = 1
		end if
		if ld_netrate <= 0.0 then
			ld_netrate = 1
		end if
		if ll_salepricecriteria = 1 then
			ld_newsaleprice = round(ld_netrate * (1.0 + ld_proposedmarkup * 0.01), 0)
		else
			ld_newsaleprice = round(ld_netrate * (1.0 + (ld_saleprice - ld_netrate) / ld_saleprice), 0)
		end if
		setitem(1, "newsaleprice", ld_newsaleprice)
	case "newsaleprice"
		ld_saleprice = double(data)
		ld_netrate = getitemnumber(1, "NetRate")
		ll_salepricecriteria = getitemnumber(1, "salepricecriteria")
		if ld_saleprice <= 0.0 then
			ld_saleprice = 1
		end if
		if ld_netrate <= 0.0 then
			ld_netrate = 1
		end if
		if ll_salepricecriteria = 1 then
			ld_proposedmarkup = (ld_saleprice - ld_netrate) / ld_netrate * 100.0
		else
			ld_proposedmarkup = (ld_saleprice - ld_netrate) / ld_saleprice * 100.0
		end if
		setitem(1, "perposedmarkup", ld_proposedmarkup)
	end choose
	return li_errcode

// dw_amountoninvoice.itemerror(long row, dwobject dwo, string data) returns long
	choose case dwo.name
	case "amt"
		messagebox("Amount Validation!", "Please Enter Valid Amount")
	case "paymentmode"
		messagebox("Payment Mode Validation!", "Please Enter Valid Payment Mode")
	end choose
	return ::message.returnvalue

// dw_amountoninvoice.itemfocuschanged(long row, dwobject dwo) returns long
	if row > 0 then
		selecttext(1, len(gettext()))
	end if
	return ::message.returnvalue

// cb_cancel.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.istr_amountoninvoice.i_status = -1
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.ue_keypress(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	if parent.id_dw.accepttext() = 1 then
		parent.istr_amountoninvoice.d_new_saleprice = parent.id_dw.getitemnumber(1, "newsaleprice")
		parent.istr_amountoninvoice.i_status = 1
		parent.post event ue_close(1)
	end if
	return ::message.returnvalue
