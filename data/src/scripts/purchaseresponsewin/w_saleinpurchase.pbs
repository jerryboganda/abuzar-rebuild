// window w_saleinpurchase (purchaseresponsewin)  ancestor: window

// w_saleinpurchase.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	wf_grandtotal()
	if key = keyescape! then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// w_saleinpurchase.ue_close(integer ai_closemode) returns integer
	long ll_currrow
	long ll_counter
	long ll_null
	wf_grandtotal()
	if ai_closemode = 1 then
		ll_currrow = this.id_detail.getrow()
		setnull(ll_null)
		if this.id_detail.rowcount() > 0 then
			if isnull(this.id_detail.getitemnumber(ll_currrow, "icode")) then
				if isnull(this.id_detail.getitemstring(ll_currrow, "itemname")) then
					this.id_detail.deleterow(ll_currrow)
				elseif this.ib_itemvalidated = false then
					messagebox("Item Validation", "Please Select Some Valid Item")
					this.id_detail.setcolumn("itemname")
					this.id_detail.scrolltorow(ll_currrow)
					this.id_detail.setfocus()
					return 1
				end if
			elseif this.ib_itemvalidated = false then
				messagebox("Item Validation", "Please Select Some Valid Item")
				this.id_detail.setcolumn("itemname")
				this.id_detail.scrolltorow(ll_currrow)
				this.id_detail.setfocus()
				return 1
			end if
			if f_validatedw(this.id_header) < 0 then
				return 1
			end if
			if f_validatedw(this.id_detail) < 0 then
				return 1
			end if
			this.il_currrow = this.id_detail.rowcount()
			if this.ib_itemvalidated = false and wf_validateitem(ll_currrow) = -1 then
				return 1
			end if
			return
		end if
		if this.istr_ds.i_protect = 0 then
			this.istr_ds.ds1.reset()
			this.istr_ds.ds2.reset()
			this.istr_ds.ds3.reset()
			this.id_header.rowscopy(1, this.id_header.rowcount(), primary!, this.istr_ds.ds1, 1, primary!)
			this.id_detail.rowscopy(1, this.id_detail.rowcount(), primary!, this.istr_ds.ds2, 1, primary!)
			this.id_footer.rowscopy(1, this.id_footer.rowcount(), primary!, this.istr_ds.ds3, 1, primary!)
		end if
		this.istr_ds.i_closemode = 1
	else
		this.istr_ds.i_closemode = -1
	end if
	closewithreturn(this, this.istr_ds)
	return 0

// w_saleinpurchase.ue_postopen() returns 0
	long li_counter
