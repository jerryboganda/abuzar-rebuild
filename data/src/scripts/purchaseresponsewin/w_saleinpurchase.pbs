	end if
	this.id_selectionlist.object.t_stock.visible = false
	this.id_selectionlist.object.stock.visible = false
	this.id_selectionlist.object.t_sstock.visible = true
	this.id_selectionlist.object.sstock.visible = true
	this.id_selectionlist.object.t_pstock.visible = false
	this.id_selectionlist.object.pstock.visible = false
