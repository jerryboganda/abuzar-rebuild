// window w_purinv_slip (purchaseresponsewin)  ancestor: window

// w_purinv_slip.create() returns 0
	this.cb_print = create cb_print
	this.dw_control = create dw_control
	this.control = {this.cb_print, this.dw_control}

// w_purinv_slip.destroy() returns 0
	destroy this.cb_print
	destroy this.dw_control

// w_purinv_slip.open() returns long
	long ll_width
	long ll_height
	long ll_win_width
	long ll_win_height
	string ls_dataobject
	environment env
	this.il_invcode = message.doubleparm
	if getenvironment(env) <> 1 then
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	setredraw(false)
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
	this.width = ll_width * 0.98
	this.height = ll_height * 0.98
	this.dw_control.width = ll_width * 0.95
	this.dw_control.height = ll_height * 0.80
	this.cb_print.x = ll_width * 0.50
	this.cb_print.y = ll_height * 0.85
	ll_width = ll_win_width - this.width
	ll_height = ll_win_height - this.height
	if ll_width > 0 and ll_height > 0 then
		this.x = ll_width / 2.0
		this.y = ll_height / 2.0
	end if
	if f_stringpreferences("PurSlipSize") = "Q" then
		ls_dataobject = "d_pur_invoivce_slip_quarter"
	elseif f_stringpreferences("PurSlipSize") = "H" then
		if gs_company = "MEDCINSUPERSTOR" then
			ls_dataobject = "d_medcinsuperstor_pur_invoivce_slip_half"
		elseif gs_company = "GREENFIELD" then
			ls_dataobject = "d_greemfield_pur_invoivce_slip_half"
		else
			ls_dataobject = "d_pur_invoivce_slip_half"
		end if
	elseif gs_company = "ALNASEEB" then
		ls_dataobject = "d_alnaseeb_pur_invoivce_slip"
	elseif gs_company = "ZEESHANWAREHOSE" then
		ls_dataobject = "d_zeeshanwarehose_pur_invoivce_slip"
	elseif gs_company = "CAREPHARMACY" or gs_company = "CAREPHARMACYSMD" or gs_company = "CAREPHARMACYGC" or gs_company = "CAREPHARMACYHO" or gs_company = "CAREPHARMACYIS" or gs_company = "CAREPHARMACYMT" or gs_company = "CAREPHARMACYSC" or gs_company = "CAREPHARMACYSC2" or gs_company = "CARESUSANFSD" or gs_company = "CAREPHARMACYJH" or gs_company = "PHARMIZPHARMACY" or gs_company = "PHARMIZPHARMCY2" or gs_company = "PHARMIZPHARMCY3" or gs_company = "CAREPHARMACYBC" or gs_company = "CAREPHARMACYCR" or gs_company = "CAREPHARMACYJW" or gs_company = "CAREPHARMACYHA" then
		ls_dataobject = "d_carepharmacy_pur_invoivce_slip"
	elseif gs_company = "VERIZON" then
		ls_dataobject = "d_verizon_pur_inv_slip"
	elseif gs_company = "KSTARPREMIUM" then
		ls_dataobject = "d_kstarpremimum_pur_invoivce_slip_full"
	elseif gs_company = "GIFTNTOYS" or gs_company = "CSHINSIDEMAYO" or gs_company = "CSHWAREHOUSE" or gs_company = "CSHWAREHOUSE2" or gs_company = "CSHMAINMARKET" or gs_company = "CSHDHAPHASE3" or gs_company = "CSHPHARMACYGC" or gs_company = "CSHASKARIX" then
		ls_dataobject = "d_csh_pur_invoivce_slip_full"
	elseif gs_company = "DAWNAUTOS" then
		ls_dataobject = "d_dawnautos_purinv_slip"
	elseif gs_company = "SALEEMIHOMEPLUS" then
		ls_dataobject = "d_saleemihomeplus_pur_invoivce_slip"
	elseif gs_company = "DECENTPH" or gs_company = "DECENTPH2" or gs_company = "DECENTPH3" or gs_company = "DECENTPH4" or gs_company = "DECENTPHWH" or gs_company = "DECENTPLUSPH" then
		ls_dataobject = "d_decent_pur_invoivce_slip"
	elseif gs_company = "MAHMOODEST" then
		ls_dataobject = "d_nmm_pur_invoivce_slip"
	elseif gs_company = "SAVEGALLERYCNC3" then
		ls_dataobject = "d_savegallerycnc3_pur_invoivce_slip"
	elseif gs_company = "MARHABADS" then
		ls_dataobject = "d_marhabads_pur_invoivce_slip"
	elseif gs_company = "PEOPLESPH2" then
		ls_dataobject = "d_peoplesph2_pur_invoivce_slip_f"
	else
		ls_dataobject = "d_pur_invoivce_slip"
	end if
	this.dw_control.dataobject = ls_dataobject
	this.dw_control.settransobject(sqlca)
	if ls_dataobject = "d_carepharmacy_pur_invoivce_slip" then
		this.dw_control.retrieve(this.il_invcode, gs_company)
	else
		this.dw_control.retrieve(this.il_invcode)
	end if
	this.dw_control.modify("DataWindow.Print.Preview=yes")
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_purinv_slip.close() returns long
	close(this)
	return ::message.returnvalue

// w_purinv_slip.key(keycode key, unsignedlong keyflags) returns long
	if keydown(keyescape!) then
		close(this)
	end if
	return ::message.returnvalue

// cb_print.clicked() returns long
	long ll_printed
	SQL rollback USING sqlca;
	SQL update PurLedger SET PurSlipPrintCounter =PurSlipPrintCounter + 1 WHERE PurInvCode =:parent.il_invcode USING sqlca;
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
	else
		SQL rollback USING sqlca;
	end if
	if parent.dw_control.dataobject = "d_carepharmacy_pur_invoivce_slip" then
		parent.dw_control.retrieve(parent.il_invcode, gs_company)
	else
		parent.dw_control.retrieve(parent.il_invcode)
	end if
	if parent.dw_control.rowcount() > 0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" then
			if printsetup() < 0 then
				messagebox("Printer", "Printing Error")
				parent.dw_control.printcancel()
			else
				ll_printed = 1
			end if
		end if
		if parent.dw_control.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		else
			ll_printed = 1
		end if
	else
		messagebox("Printing Error", "Can not Print,~r~nNo rows are retrieved", information!)
	end if
	if ll_printed <> 1 then
		SQL rollback USING sqlca;
		SQL update PurLedger SET PurSlipPrintCounter =PurSlipPrintCounter - 1 WHERE PurInvCode =:parent.il_invcode USING sqlca;
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
	end if
	return ::message.returnvalue
