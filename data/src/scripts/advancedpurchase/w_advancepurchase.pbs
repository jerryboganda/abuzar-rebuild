		this.id_detail.object.retailprice.visible = false
	end if

// w_advancepurchase.wf_post_purchase(long al_purinvcode, long al_usercode, datetime adt_server_datetime, string as_errtext) returns boolean
	long ll_detailrows
	long ll_icode
	long ll_gcode
	long ll_packingunits
	long ll_salesmancode
	long ll_errrowid
	long ll_purrowid
	long ll_headerno
	long ll_headerinvno
	long ll_pocode
	long ll_duedoccode
	long ll_packunits
	double ld_stock
	double ld_godownstock
	double ld_newstock
	double ld_purqty
	double ld_purbonusqty
	double ld_packqty
	double ld_bonusqty
	double ld_looseqty
	double ld_currstock
	double ld_retailprice
	double ld_avgprice
	double ld_newavgprice
	double ld_purprice
	double ld_purdiscpack
	double ld_discperc
	double ld_invdiscperc
	double ld_invgstperc1
	double ld_recentpurprice
	double ld_purpricepack
	double ld_purpriceloose
	double ld_saleprice
	double ld_itemsalestax
	double ld_itemgstperc
	double ld_totalitemsalestax
	double ld_salepriceforitem
	double ld_rate
	double ld_purpriceinadvpur
	double ld_updpurrate
	integer li_errcode
	integer li_rtncode
	integer li_detailcounter
	integer li_purchasecategory
	string ls_batch
	string ls_batchprefix
	string ls_due_message
	string ls_alternatealiasname
	datetime ld_expiry
	double ld_itempurcost
	double ld_netpurcost
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_netrate
	double ld_currbalance
	double ld_discountedsaleprice
	boolean lb_commitflag = true
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	string ls_date_errtext
	string ls_errortext
	string ls_updateavgpricewithnetrate
	integer ci_normalpurchase = 1
	integer ci_openingpurchase = 3
	integer ci_loosepurchase = 7
	long ll_rowcount
	long ll_invcounter
	datastore lds_purdetail
	datawindowchild ldc_godown
	datawindow ldw_changeprice_foritemlog
	ls_batchprefix = ""
	ldw_changeprice_foritemlog = this.dw_changeprice_foritemlog
	ldw_changeprice_foritemlog.settransobject(this.it_transobject)
	lds_purdetail = create datastore
	lds_purdetail.dataobject = "d_normalpurchasedetail"
	lds_purdetail.settransobject(this.it_transobject)
	li_rtncode = lds_purdetail.getchild("gcode", ldc_godown)
	if li_rtncode = -1 then
		ls_errortext = "Can not get a DataWindowChild~r~nPosting Failed"
		return false
	end if
	ldc_godown.settransobject(this.it_transobject)
	li_rtncode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		ls_errortext = "Not Enough Godown Rights to Post Purchase~r~nPosting Failed"
		return false
	end if
	ll_salesmancode = al_usercode
	setfocus()
	if ll_salesmancode > 0 then
		setpointer(hourglass!)
		SQL Select count ( *) INTO :ul_rowcount From PurDetail , PurLedger Where PurLedger.PurInvCode =:al_purinvcode AND PurLedger.Posted ='N' AND PurLedger.PurInvCode =PurDetail.PurInvCode USING this.it_transobject;
		this.it_transobject.getmaxutn(ul_rowcount, ul_maxutn)
		if this.it_transobject.sqlcode <> 0 then
			ls_errortext = "Posting fail due to error in generating Utn"
			return false
		end if
		li_errcode = wf_lock_actualpurchase(al_purinvcode)
	end if
	if li_errcode = 1 then
		SQL SELECT ISNULL ( headerno , 1 ) , headerinvno , misccharges , discperc , flatdisc , salestax , invgstperc1 , pocode , UpdateAvgPriceWithNetRate INTO :ll_headerno, :ll_headerinvno, :ld_misccharges, :ld_invdiscperc, :ld_flatdisc, :ld_salestax, :ld_invgstperc1, :ll_pocode, :ls_updateavgpricewithnetrate FROM DBO.PurLedger WHERE PurInvCode =:al_purinvcode USING this.it_transobject;
		lds_purdetail.retrieve(al_purinvcode)
		ll_detailrows = lds_purdetail.rowcount()
		if ll_detailrows > 0 then
			if isnull(ll_headerinvno) then
				f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
				if ll_headerinvno = 0 or isnull(ll_headerinvno) then
					as_errtext = "Problem is generating Header invoice code, posting unsuccessfull"
					return false
				end if
				return
			end if
			if this.ii_purchasetype = 1 and f_stringpreferences("UpdateSalePriceForItem") = "Y" then
				ldw_changeprice_foritemlog.retrieve(al_purinvcode)
				if f_generateitemlog(ldw_changeprice_foritemlog, "item_changeprice_purchase", this.it_transobject, adt_server_datetime) <= 0 then
					lb_commitflag = false
					ls_errortext = "Item Log Generation Error:~r~n" + this.it_transobject.sqlerrtext
				end if
			end if
		else
			lb_commitflag = false
			ls_errortext = "No rows Available for posting, Posting Unsucessfull"
		end if
	else
		lb_commitflag = false
		ls_errortext = "Please Enter a valid user, Posting Unsucessfull"
	end if
	if lb_commitflag then
		li_detailcounter = 1
		do while li_detailcounter <= ll_detailrows and lb_commitflag = true
			ll_icode = lds_purdetail.object.icode[li_detailcounter]
			ll_gcode = lds_purdetail.object.gcode[li_detailcounter]
			ls_alternatealiasname = lds_purdetail.object.alternatecustomicode[li_detailcounter]
			ls_batch = lds_purdetail.object.batch[li_detailcounter]
			ld_expiry = lds_purdetail.object.expiry[li_detailcounter]
			ld_packqty = lds_purdetail.object.packqty[li_detailcounter]
			ld_looseqty = lds_purdetail.object.looseqty[li_detailcounter]
			ld_bonusqty = lds_purdetail.object.bonusqty[li_detailcounter]
			ll_packingunits = lds_purdetail.object.packunits[li_detailcounter]
			ld_discperc = lds_purdetail.object.discperc[li_detailcounter]
			ld_itemsalestax = lds_purdetail.object.unitsalestax[li_detailcounter]
			ld_itemgstperc = lds_purdetail.object.gstperc[li_detailcounter]
			ll_purrowid = lds_purdetail.object.purrowid[li_detailcounter]
			ld_purpriceinadvpur = lds_purdetail.object.purpriceinadvpur[li_detailcounter]
			ld_netrate = lds_purdetail.object.netrate[li_detailcounter]
			ll_packunits = lds_purdetail.object.packunits[li_detailcounter]
			if ll_packunits = 0 or isnull(ll_packunits) then
				ll_packunits = 1
			end if
			choose case this.ii_purchasetype
			case 1
				ld_purprice = lds_purdetail.object.purprice[li_detailcounter] / ll_packingunits
				ld_purqty = ld_packqty * ll_packingunits
				ld_purbonusqty = ld_bonusqty * ll_packingunits
				if not isnull(ll_pocode) then
					wf_setpurorderqty(this.it_transobject, ll_pocode, ll_icode, ld_packqty, ld_bonusqty)
				end if
				if f_stringpreferences("UpdateSalePriceForItem") = "Y" then
					ld_salepriceforitem = lds_purdetail.getitemdecimal(li_detailcounter, "salepriceforitem")
					if wf_updateitemsaleprice(this.it_transobject, ll_icode, ls_alternatealiasname, ld_salepriceforitem) <> 0 then
						ls_errortext = "Item Sale Price Updation Error:~r~n" + this.it_transobject.sqlerrtext
						lb_commitflag = false
					end if
				end if
				if f_stringpreferences("showretailpriceinpurchase") = "Y" then
					ld_retailprice = lds_purdetail.getitemdecimal(li_detailcounter, "retailprice")
					if wf_updateitemretailprice(this.it_transobject, ll_icode, ld_retailprice) <> 0 then
						ls_errortext = "Item Retail Price Updation Error:~r~n" + this.it_transobject.sqlerrtext
						lb_commitflag = false
					end if
				end if
				ld_purpricepack = lds_purdetail.object.purprice[li_detailcounter]
				ld_purdiscpack = lds_purdetail.object.discperc[li_detailcounter]
				if f_stringpreferences("UpdatePurPrice") = "Y" then
					ld_updpurrate = ld_purpriceinadvpur
				elseif f_stringpreferences("UpdatePurPrice") = "D" then
					ld_updpurrate = round(ld_purpriceinadvpur * (1.0 - ld_discperc * 0.01), 2)
				elseif f_stringpreferences("UpdatePurPrice") = "R" then
					ld_updpurrate = round(ld_netrate, 2)
				end if
				if f_stringpreferences("UpdatePurPrice") <> "N" and wf_updateitempurprice(ll_icode, ls_alternatealiasname, ld_updpurrate) <> 0 then
					lb_commitflag = false
				end if
				if f_stringpreferences("UpdatePurDisc") = "Y" and wf_updateitempurdisc(ll_icode, ld_purdiscpack) <> 0 then
					lb_commitflag = false
				end if
				if f_stringpreferences("PurReplaceItemSaledisc") = "Y" and wf_replacesalediscperc(ll_icode, ld_purdiscpack) <> 0 then
					lb_commitflag = false
				end if
				if isnull(ls_alternatealiasname) then
					ld_recentpurprice = ld_netrate
				else
					ld_recentpurprice = round(ld_netrate / ll_packunits, 2)
				end if
			case else
				ld_purprice = lds_purdetail.object.purprice[li_detailcounter]
				ld_purqty = ld_looseqty
				ld_purbonusqty = ld_bonusqty
				ld_recentpurprice = round(ld_purprice * (1.0 - ld_discperc * 0.01) * (1.0 - ld_invdiscperc * 0.01) * ld_purqty / (ld_purqty + ld_purbonusqty) * ll_packunits, 2)
			end choose
			if wf_updaterecentpurprice(ll_icode, ld_recentpurprice) <> 0 then
				lb_commitflag = false
			end if
			if ls_updateavgpricewithnetrate = "N" then
				ld_itempurcost = ld_purqty * ld_purprice * (1.0 - ld_discperc * 0.01) * (1.0 - ld_invdiscperc * 0.01)
			else
				if this.ii_purchasetype = 1 then
					ld_netrate = ld_netrate / ll_packunits
				end if
				ld_itempurcost = (ld_purqty + ld_purbonusqty) * ld_netrate
			end if
			ld_netpurcost = ld_netpurcost + ld_itempurcost
			this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
			if this.it_transobject.sqlcode = 0 then
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
				this.it_transobject.getitemstockall(ll_icode, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					ld_newstock = ld_stock + ld_purqty + ld_purbonusqty
					ld_currstock = ld_stock
					if ld_newstock > 0.0 then
						ld_newavgprice = (ld_stock * ld_avgprice + ld_itempurcost) / ld_newstock
						this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
						if this.it_transobject.sqlcode = 0 then
							ld_newstock = ld_stock + ld_purqty + ld_purbonusqty
							this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
							if this.it_transobject.sqlcode = 0 then
								this.it_transobject.updateitemavgprice(ll_icode, ld_newavgprice)
								if this.it_transobject.sqlcode = 0 then
									SQL SELECT saleprice , purprice , discountedsaleprice INTO :ld_saleprice, :ld_rate, :ld_discountedsaleprice FROM item Where item.icode =:ll_icode USING this.it_transobject;
									if this.it_transobject.sqlcode = 0 then
										this.it_transobject.updatetransitstock(1, ll_icode, ld_purqty + ld_purbonusqty)
										if this.it_transobject.sqlcode <> 0 then
											lb_commitflag = false
										end if
									else
										lb_commitflag = false
									end if
								else
									lb_commitflag = false
								end if
							else
								lb_commitflag = false
								ls_errortext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
							end if
						else
							lb_commitflag = false
							ls_errortext = "Batch Wise Stock Fetch Error:~r~n" + this.it_transobject.sqlerrtext
						end if
					else
						lb_commitflag = false
					end if
				else
					lb_commitflag = false
				end if
			else
				lb_commitflag = false
			end if
			if lb_commitflag then
				SQL update PurDetail SET purutn =:ul_maxutn , batch =:ls_batch , currstock =:ld_currstock , godownstock =:ld_godownstock , avgprice =:ld_avgprice , newavgprice =:ld_newavgprice , saleprice =:ld_saleprice , discountedsaleprice =:ld_discountedsaleprice , rate =:ld_rate WHERE PurInvCode =:al_purinvcode AND PurRowId =:ll_purrowid USING this.it_transobject;
				if this.it_transobject.sqlcode <> 0 then
					as_errtext = "Purchase Invoice code : " + trim(string(al_purinvcode)) + "~n~rcan not be posted.~r~n" + ls_errortext
					lb_commitflag = false
				end if
			end if
			li_detailcounter = li_detailcounter + 1
			ul_maxutn = ul_maxutn + 1
		loop
		if lb_commitflag = false then
			as_errtext = "Purchase Invoice code : " + trim(string(al_purinvcode)) + "~n~rcan not be posted.~r~n" + ls_errortext
			lb_commitflag = false
		else
			SQL update PurLedger SET Posted ='Y' , PostDate =:adt_server_datetime , PostedBy =:al_usercode , HeaderInvNo =:ll_headerinvno WHERE PurInvCode =:al_purinvcode USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				as_errtext = "Purchase Invoice code : " + trim(string(al_purinvcode)) + "~n~rcan not be posted.~r~n" + ls_errortext
				lb_commitflag = false
			elseif f_stringpreferences("AutoDueSatisfyOnPurPost") = "Y" then
				if this.it_transobject.purchasebased_satisfydue(al_purinvcode, ll_salesmancode, adt_server_datetime, ll_duedoccode) = 0 then
					ls_due_message = ls_due_message + trim(string(ll_duedoccode)) + ", "
					as_errtext = "Auto Due Satisfaction Made Through Due Document Code(s) = " + ls_due_message
				else
					lb_commitflag = false
					as_errtext = "Purchase Invoice code : " + trim(string(al_purinvcode)) + "~n~rcan not be posted.~r~n" + ls_errortext + "~r~n" + "Reason: Problem in auto due satisfaction process."
				end if
			end if
		end if
	else
		as_errtext = "Purchase Invoice code : " + trim(string(al_purinvcode)) + "~n~rcan not be posted.~r~n" + ls_errortext + "~r~n" + "Reason: Problem in Gaining Lock of Purchase invoice."
		lb_commitflag = false
	end if
	destroy lds_purdetail
	setpointer(arrow!)
	return lb_commitflag

// w_advancepurchase.wf_apply_measureunit(long al_code, long al_row) returns long
	double ld_qty
	SQL SELECT MeasureQty INTO :ld_qty FROM DBO.MeasuringUnit WHERE MeasureUnitCode =:al_code USING sqlca;
	if sqlca.sqlcode = 0 then
		this.id_detail.object.measureqty[al_row] = ld_qty
		if ld_qty > 0.0 then
			this.id_detail.object.purprice[al_row] = round(this.id_detail.object.measureunitrate[al_row] / ld_qty, 5)
			return 0
		else
			return 1
		end if
		return
	end if
	return 1

// w_advancepurchase.wf_itemstockinfo(long al_icode, long al_gcode, double ad_stock) returns boolean
	boolean retflag = true
	long ld_stock
	long ld_totalstock
	ad_stock = 100
	return retflag

// w_advancepurchase.wf_setiteminfo(long al_icode, long al_row, long ad_gcode, double ad_saleprice, double ad_discperc, double ad_stock) returns 0
	this.id_detail.setitem(al_row, "gcode", ad_gcode)
	this.id_detail.setitem(al_row, "purprice", ad_saleprice)
	this.id_detail.setitem(al_row, "discperc", ad_discperc)
	this.id_footer.object.stock[this.id_footer.getrow()] = ad_stock

// w_advancepurchase.wf_setpurorderqty(transaction at_transobject, long al_pocode, long al_icode, double ad_qtysatisfied, double ad_bonusqtysatisfied) returns integer
	SQL update purorderdetail Set qtysatisfied =qtysatisfied + :ad_qtysatisfied , bonusqtysatisfied =bonusqtysatisfied + :ad_bonusqtysatisfied Where purorderdetail.pocode =:al_pocode and purorderdetail.icode =:al_icode USING at_transobject;
	return at_transobject.sqlcode

// w_advancepurchase.wf_updateitemstock(long al_icode, long al_gcode, double ad_newstock) returns boolean
	boolean retflag = true
	SQL update godowndetail SET godowndetail.currqty =:ad_newstock WHERE godowndetail.gcode =:al_gcode AND godowndetail.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_advancepurchase.wf_set_itemtotal_formatmask() returns long
	string ls_modify
	string ls_format
	ls_format = trim(f_stringpreferences("FormatForAmtInPur"))
	ls_modify = "c_total.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "d_detaildwtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_finalitemval.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_total_finalitemval.Format='" + ls_format + "'  "
	this.id_detail.modify(ls_modify)
	return 0

// w_advancepurchase.wf_post_adv_purchase(integer ai_postingmode, long al_startinginvcode, long al_endinginvcode) returns boolean
	boolean lb_commitflag = true
	integer li_errcode
	integer li_rtncode
	integer li_detailcounter
	integer li_purchasecategory
	long ll_detailrows
	long ll_salesmancode
	long ll_errrowid
	long ll_purinvcode
	long ll_counter
	long ll_icode
	long ll_code1
	long ll_code2
	double ld_itemflatdisc2
	double ld_retailprice
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_errortext
	string ls_success_msg
	integer ci_normalpurchase = 1
	integer ci_openingpurchase = 3
	integer ci_loosepurchase = 7
	long ll_rowcount
	long ll_invcounter
	long ll_invcode
	s_arguements lstr_arginfo
	datastore lds_purinvforposting
	datastore lds_advpurdetail
	datawindowchild ldc_godown
	lds_advpurdetail = create datastore
	lds_advpurdetail.dataobject = this.id_detail.dataobject
	lds_advpurdetail.settransobject(this.it_transobject)
	li_rtncode = lds_advpurdetail.getchild("gcode", ldc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
		return false
	end if
	ldc_godown.insertrow(0)
	lds_purinvforposting = create datastore
	lds_purinvforposting.dataobject = "d_advpurinvno"
	lds_purinvforposting.settransobject(this.it_transobject)
	if ai_postingmode = 1 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if ai_postingmode = 1 then
			open(w_arg_sinvcode_linvcode)
			lstr_arginfo = message.powerobjectparm
		else
			lstr_arginfo.l_code1 = al_startinginvcode
			lstr_arginfo.l_code2 = al_endinginvcode
			lstr_arginfo.i_status = 1
		end if
		if lstr_arginfo.i_status = 1 then
			if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return false
			end if
			setpointer(hourglass!)
			li_errcode = 0
			if li_errcode = 0 then
				lds_purinvforposting.retrieve(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
				ll_rowcount = lds_purinvforposting.rowcount()
				for ll_invcounter = 1 to ll_rowcount
					ll_invcode = lds_purinvforposting.object.advpurinvcode[ll_invcounter]
					li_errcode = wf_lock_adv_purchase_invoice(ll_invcode)
					if li_errcode <= 0 then
						ls_success_msg = ls_success_msg + "~r~nCan not Lock Invoice No : " + string(ll_invcode) + " (Posting Not Done)~r~n"
						messagebox("Posting", ls_success_msg + "Adv. Purchase No : " + string(ll_invcode) + " and greater can not be posted.~r~n" + ls_errortext, information!)
						return false
					else
						ll_purinvcode = 0
						if wf_allowpurchasemodification(ll_invcode, this.il_groupcode, this.il_strategy) = 0 then
							if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
								messagebox("Date Violation", ls_date_errtext, stopsign!)
								return false
							end if
							lds_advpurdetail.retrieve(ll_invcode)
							ll_detailrows = lds_advpurdetail.rowcount()
							ll_counter = 1
							do while ll_counter <= ll_detailrows and ll_detailrows > 0 and lb_commitflag
								if f_stringpreferences("UpdatePurFlatDiscWithFlatDisc2") = "Y" then
									ld_itemflatdisc2 = lds_advpurdetail.object.itemflatdisc2[ll_counter]
									ll_icode = lds_advpurdetail.object.icode[ll_counter]
									if ld_itemflatdisc2 < 0.0 or isnull(ld_itemflatdisc2) then
										ld_itemflatdisc2 = 0
									end if
									SQL update DBO.Item SET PurFlatDisc =:ld_itemflatdisc2 WHERE Item.ICode =:ll_icode USING this.it_transobject;
									if this.it_transobject.sqlcode = 0 then
										lb_commitflag = true
										goto L1802
									end if
									lb_commitflag = false
									ls_success_msg = ls_success_msg + " can not update purchase flat discount of item.~r~n"
									exit
								end if
								ll_counter = ll_counter + 1
							loop
							ls_success_msg = ls_success_msg + "Adv. Purchase No = " + trim(string(ll_invcode))
							if f_stringpreferences("AutoCreatePurInvoiceFromAdvPur") = "Y" then
								this.it_transobject.createpurchase_from_advpurchase(ll_invcode, ll_purinvcode)
								if this.it_transobject.sqlcode = 0 then
									ls_success_msg = ls_success_msg + ", Purchase Inv. No = " + trim(string(ll_purinvcode))
									if f_stringpreferences("AutoPostPurInvoiceFromAdvPur") = "Y" then
										if wf_post_purchase(ll_purinvcode, ll_salesmancode, ldt_server_datetime, ls_errortext) = false then
											lb_commitflag = false
										else
											ls_success_msg = ls_success_msg + " (Posting Done)~r~n"
											if len(ls_errortext) > 0 then
												ls_success_msg = ls_success_msg + ls_errortext
											end if
										end if
									else
										ls_success_msg = ls_success_msg + " (Posting Not Done)~r~n"
									end if
									if f_stringpreferences("IncPurInActMonitor") = "Y" and ll_purinvcode > 0 and lb_commitflag then
										this.it_transobject.updateactivitymonitor("PV", ll_purinvcode)
										if this.it_transobject.sqlcode <> 0 then
											ls_errortext = this.it_transobject.sqlerrtext
											lb_commitflag = false
										end if
									end if
								else
									ls_errortext = this.it_transobject.sqlerrtext
									lb_commitflag = false
								end if
							else
								setnull(ll_purinvcode)
								ls_success_msg = ls_success_msg + "~r~n"
							end if
						else
							ls_errortext = "Your Godown settings do not permit you to post some advanced purchase invoice.~r~nAdvanced Purchase invoice code = " + string(ll_invcode)
							lb_commitflag = false
						end if
						if lb_commitflag then
							SQL update AdvPurHeader SET Posted ='Y' , PostDate =:ldt_server_datetime , PostedBy =:ll_salesmancode , PurInvCode =:ll_purinvcode WHERE AdvPurInvCode =:ll_invcode AND Posted ='N' USING this.it_transobject;
							if this.it_transobject.sqlcode <> 0 then
								ls_errortext = "Updation Problem Occured in Advance Purchases"
								lb_commitflag = false
								exit
							else
								SQL commit USING this.it_transobject;
							end if
						else
							exit
						end if
					end if
				next
				if lb_commitflag then
					messagebox("Posting", "Posting Successfully Completed. Details Are~r~n" + ls_success_msg)
				else
					if not isnull(ls_success_msg) or ls_success_msg <> "" then
						ls_success_msg = "~r~n"
					else
						ls_success_msg = ""
					end if
					SQL rollback USING this.it_transobject;
					messagebox("Posting Failed", ls_success_msg + "Adv. Purchase No : " + string(ll_invcode) + "~n~rand greater can not be posted.~r~n" + ls_errortext)
					SQL rollback USING this.it_transobject;
				end if
			end if
		end if
	end if
	destroy lds_purinvforposting
	setpointer(arrow!)
	return lb_commitflag

// w_advancepurchase.wf_lock_adv_purchase_invoice(long al_invcode) returns long
	integer li_count
	SQL SELECT count ( *) INTO :li_count FROM AdvPurHeader WITH ( READPAST UPDLOCK ) WHERE AdvPurHeader.advpurinvcode =:al_invcode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		return this.it_transobject.sqlcode
	end if
	return li_count

// w_advancepurchase.wf_lock_actualpurchase(long al_purinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From PurLedger WITH ( READPAST UPDLOCK ) Where PurLedger.Purinvcode =:al_purinvcode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		return this.it_transobject.sqlcode
	end if
	return li_count

// w_advancepurchase.wf_item_image_setting() returns long
	if f_stringpreferences("showitemimageinpur") = "N" then
		this.id_master.object.p_itemimage.visible = 0
	else
		this.it_imagetrans = create u_transaction
		this.it_imagetrans.autocommit = true
		SQL start USING this.it_imagetrans;
		if this.it_imagetrans.sqlcode <> 0 then
			return -1
		end if
		this.id_master.object.p_itemimage.visible = 1
	end if
	return 0

// w_advancepurchase.wf_set_itemimage(long al_icode) returns long
	long ll_rowid
	string ls_filename
	string ls_imagetype
	string ls_imagedesc
	blob lb_image
	this.id_master.object.p_itemimage.filename = ""
	if al_icode <= 0 or isnull(al_icode) then
		return 0
	end if
	if f_stringpreferences("showitemimageinpur") = "N" then
		return 0
	end if
	this.it_imagetrans.getfirstitemimagedetail(al_icode, ll_rowid, ls_imagetype, ls_imagedesc)
	if this.it_imagetrans.sqlcode <> 0 then
		messagebox("Item Image/Picture ", "Unable to fetch item Image Details.~r~nReasons are:~r~n" + this.it_imagetrans.sqlerrtext)
		return -1
	end if
	if ll_rowid <= 0 then
		return 0
	end if
	SQL SelectBlob ItemImage INTO :lb_image From ItemImage Where Icode =:al_icode AND RowID =:ll_rowid USING this.it_imagetrans;
	if this.it_imagetrans.sqlcode <> 0 then
		messagebox("Item Image/Picture ", "Unable to fetch item Image.~r~nReasons are:~r~n" + this.it_imagetrans.sqlerrtext)
		return -1
	end if
	ls_filename = gs_temp_img_filename
	ls_filename = left(ls_filename, len(ls_filename) - 4)
	ls_filename = trim(string(ls_filename)) + "." + ls_imagetype
	f_writeimgtofile(ls_filename, lb_image)
	this.id_master.object.p_itemimage.filename = ls_filename
	return 0

// w_advancepurchase.wf_showaccountledger() returns 0
	long ll_acccode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_acccode = this.id_master.object.suppcode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_acccode = this.id_list.object.suppcode[this.id_list.getrow()]
	end if
	if not isnull(ll_acccode) and ll_acccode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_account_ledger, ll_acccode)
	end if

// w_advancepurchase.wf_showsummaryaccountbalance() returns 0
	long ll_acccode
	if wf_iseditable() = false then
		return
	end if
	if this.tab_retrieve.selectedtab = 1 then
		ll_acccode = this.id_master.getitemnumber(this.id_master.getrow(), "suppcode")
		if not isnull(ll_acccode) and this.id_master.rowcount() > 0 then
			openwithparm(w_summaccount_balance, ll_acccode)
		end if
	end if

// w_advancepurchase.wf_filter_po_itemsonly(integer al_pocode) returns long
	long ll_counter
	long ll_rowcount
	long ll_rtcode
	long ll_found
	long ll_icode
	boolean lb_enablerestricted
	string ls_itemlist
	string ls_filterexp
	long li_count
	long ll_startrow
	char lc_char
	datastore lds_podetail
	if al_pocode > 0 then
		lds_podetail = create datastore
		lds_podetail.dataobject = "d_populatepurorder"
		lds_podetail.settransobject(this.it_transobject)
		ll_rtcode = lds_podetail.retrieve(al_pocode)
		ll_rowcount = lds_podetail.rowcount()
		for ll_counter = 1 to ll_rowcount
			ll_icode = lds_podetail.object.icode[ll_counter]
			ll_found = this.id_detail.find("icode = " + trim(string(ll_icode)), 1, this.id_detail.rowcount())
			if ll_found <= 0 or ll_found > this.id_detail.rowcount() then
				ls_itemlist = ls_itemlist + trim(string(ll_icode)) + ","
			end if
		next
		ls_itemlist = left(ls_itemlist, len(ls_itemlist) - 1)
		gd_itemsinfo.reset()
		gd_itemsinfo.setfilter("")
		gd_itemsinfo.filter()
		if f_stringpreferences("GroupCategoryRights") = "Y" then
			gd_itemsinfo.retrieve(gi_catlist, f_getgroupcode(gl_usercode))
		else
			gd_itemsinfo.retrieve(f_getgroupcode(gl_usercode))
		end if
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 515", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			lb_enablerestricted = true
		end if
		if trim(ls_itemlist) = "" or isnull(ls_itemlist) then
			ls_itemlist = "-1"
		end if
		if lb_enablerestricted = false then
			ls_filterexp = " restricted = 'N' AND Icode IN (" + ls_itemlist + " ) "
		else
			ls_filterexp = " Icode IN (" + ls_itemlist + " ) "
		end if
		gd_itemsinfo.setfilter(ls_filterexp)
		gd_itemsinfo.filter()
		for li_count = 65 to 90
			lc_char = char(li_count)
			ga_llookuptable[li_count] = gd_itemsinfo.find("Lower(itemname) >= Lower('" + char(li_count) + "')", ll_startrow, 99999)
			ll_startrow = ga_llookuptable[li_count]
		next
		ga_llookuptable[92] = 99999
	else
		gd_itemsinfo.reset()
		gd_itemsinfo.setfilter("")
		gd_itemsinfo.filter()
		if f_stringpreferences("GroupCategoryRights") = "Y" then
			gd_itemsinfo.retrieve(gi_catlist, f_getgroupcode(gl_usercode))
		else
			gd_itemsinfo.retrieve(f_getgroupcode(gl_usercode))
		end if
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 515", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			lb_enablerestricted = true
		end if
		if lb_enablerestricted = false then
			gd_itemsinfo.setfilter(" restricted = 'N' ")
			gd_itemsinfo.filter()
		else
			gd_itemsinfo.setfilter(" ")
			gd_itemsinfo.filter()
		end if
		for li_count = 65 to 90
			lc_char = char(li_count)
			ga_llookuptable[li_count] = gd_itemsinfo.find("Lower(itemname) >= Lower('" + char(li_count) + "')", ll_startrow, gd_itemsinfo.rowcount())
			ll_startrow = ga_llookuptable[li_count]
		next
		ga_llookuptable[92] = gd_itemsinfo.rowcount()
	end if
	return 0

// w_advancepurchase.wf_set_po_values(long al_row) returns long
	double ld_qty
	double ld_rate
	double ld_bonusqty
	long ll_pocode
	long ll_icode
	long ll_packunits
	string ls_alternatecustomicode
	ll_pocode = this.id_master.object.pocode[1]
	if ll_pocode > 0 and al_row > 0 then
		ll_icode = this.id_detail.object.icode[al_row]
		ls_alternatecustomicode = this.id_detail.object.alternatecustomicode[al_row]
		if len(ls_alternatecustomicode) > 0 then
			SQL SELECT Qty =SUM ( PD.Qty ) , Rate =MAX ( PD.Rate ) , BonusQty =SUM ( PD.BonusQty ) , PackUnits =Max ( PD.PackUnits ) INTO :ld_qty, :ld_rate, :ld_bonusqty, :ll_packunits FROM PurOrderDetail PD WHERE PD.POCode =:ll_pocode AND PD.ICode =:ll_icode AND PD.AlternateCustomICode =:ls_alternatecustomicode USING this.it_transobject;
		else
			SQL SELECT Qty =SUM ( PD.Qty ) , Rate =MAX ( PD.Rate ) , BonusQty =SUM ( PD.BonusQty ) , PackUnits =Max ( PD.PackUnits ) , AlternateCustomICode =MAX ( PD.AlternateCustomICode ) INTO :ld_qty, :ld_rate, :ld_bonusqty, :ll_packunits, :ls_alternatecustomicode FROM PurOrderDetail PD WHERE PD.POCode =:ll_pocode AND PD.ICode =:ll_icode USING this.it_transobject;
		end if
		if this.it_transobject.sqlcode = 0 and ld_qty > 0.0 then
			if ll_packunits <= 0 or isnull(ll_packunits) then
				ll_packunits = 1
			end if
			this.id_detail.object.alternatecustomicode[al_row] = ls_alternatecustomicode
			this.id_detail.object.packunits[al_row] = ll_packunits
			this.id_detail.object.packqty[al_row] = ld_qty
			this.id_detail.object.purprice[al_row] = ld_rate
			this.id_detail.object.bonusqty[al_row] = ld_bonusqty
		end if
	end if
	return 0

// w_advancepurchase.wf_updateitemretailprice(transaction at_transobject, long al_icode, double ad_retailprice) returns long
	SQL update Item SET RetailPrice =:ad_retailprice WHERE Item.icode =:al_icode USING at_transobject;
	return at_transobject.sqlcode

// w_advancepurchase.wf_updateitemsaleprice(transaction at_transobject, long al_icode, string as_alternatealiasname, double ad_saleprice) returns long
	SQL update Item SET Saleprice =:ad_saleprice WHERE Item.icode =:al_icode USING at_transobject;
	return at_transobject.sqlcode

// w_advancepurchase.wf_updateitempurprice(long al_icode, string as_alternatealiasname, double ad_purprice) returns integer
	if isnull(as_alternatealiasname) then
		SQL update Item SET purprice =:ad_purprice WHERE Item.icode =:al_icode USING this.it_transobject;
	else
		SQL update AlternateItemAlias SET purprice =:ad_purprice WHERE icode =:al_icode AND CustomICode =:as_alternatealiasname USING this.it_transobject;
	end if
	return this.it_transobject.sqlcode

// w_advancepurchase.wf_discperccalc(double ad_discprice) returns long
	double ld_purprice
	long ll_row
	ll_row = this.id_detail.getrow()
	if ll_row > 0 then
		ld_purprice = this.id_detail.object.purprice[ll_row] + this.id_detail.object.purprice2[ll_row] + this.id_detail.object.purprice3[ll_row] + this.id_detail.object.purprice4[ll_row]
		if ld_purprice > ad_discprice then
			if ld_purprice = 0.0 then
				if (ld_purprice - ad_discprice) * 100.0 > 100.0 then
					this.id_detail.object.discperc[ll_row] = 100
				else
					this.id_detail.object.discperc[ll_row] = (ld_purprice - ad_discprice) * 100.0
				end if
			else
				this.id_detail.object.discperc[ll_row] = (ld_purprice - ad_discprice) / ld_purprice * 100.0
			end if
		else
			this.id_detail.object.discperc[ll_row] = 0.00
		end if
	end if
	return 0

// w_advancepurchase.wf_discpricecalc(double ad_discperc) returns long
	double ld_discprice
	long ll_row
	ll_row = this.id_detail.getrow()
	if ll_row > 0 then
		ld_discprice = this.id_detail.object.purprice[ll_row] + this.id_detail.object.purprice2[ll_row] + this.id_detail.object.purprice3[ll_row] + this.id_detail.object.purprice4[ll_row]
		this.id_detail.object.discountedpurprice[ll_row] = ld_discprice * (1.0 - 0.01 * ad_discperc)
	end if
	return 0

// w_advancepurchase.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_advpurchasemenu" then
		this.menuid = create m_advpurchasemenu
	end if
	this.dw_purinvrep = create dw_purinvrep
	this.dw_changeprice_foritemlog = create dw_changeprice_foritemlog
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_purinvrep
	this.control[icurrent + 2] = this.dw_changeprice_foritemlog

// w_advancepurchase.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_purinvrep
	destroy this.dw_changeprice_foritemlog

// w_advancepurchase.ue_save() returns 0 [event]
	double ld_bonusqty
	double ld_looseqty
	double ld_packqty
	integer li_counter = 1
	integer li_option
	long ll_icode
	long ll_salesmancode = 1
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_detailrows
	long ll_count
	long ll_found
	long ll_rightfound
	double ld_saleprice
	double ld_invtotal
	string ls_updatepurprice
	string ls_alternatealiasname
	boolean lb_commitflag = true
	datetime ldt_expiry
	datetime ldt_server_datetime
	string ls_date_errtext
	date ld_expiry
	string ls_expiry
	ls_expiry = f_stringpreferences("purexpiry")
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		for ll_count = 1 to ll_detailrows
			if ls_expiry = "Y" then
				ldt_expiry = this.id_detail.object.expiry[ll_count]
				ld_expiry = date(ldt_expiry)
				if ld_expiry <= relativedate(today(), f_numberpreferences("AcceptFutureExpiryDays")) then
					li_option = messagebox("Item Validation", "Expiry should be greater than " + string(relativedate(today(), f_numberpreferences("AcceptFutureExpiryDays")), "dd/mmm/yyyy") + "~r~nLine No. " + string(ll_count) + ", Expiry Date = " + string(ld_expiry, "dd/mmm/yyyy") + "~r~nAccept this expiry date?", question!, yesno!, 2)
					if li_option <> 1 then
						if this.ii_purchasetype = 1 then
							this.id_detail.setcolumn("packqty")
						else
							this.id_detail.setcolumn("looseqty")
						end if
						this.id_detail.scrolltorow(ll_count)
						this.id_detail.setfocus()
						return
					end if
					return
				end if
				return
			end if
			ll_found = 0
			if ll_count = ll_detailrows then
				exit
			end if
			ll_found = this.id_detail.find("gcode = long('" + string(this.id_detail.getitemnumber(ll_count, "gcode")) + "') and " + " icode = long('" + string(this.id_detail.getitemnumber(ll_count, "icode")) + "') and batch = '" + this.id_detail.getitemstring(ll_count, "batch") + "' and expiry = Date('" + string(this.id_detail.getitemdatetime(ll_count, "expiry"), "yyyy-mm-dd") + "')", ll_count + 1, ll_detailrows)
			if ll_found > 0 then
				messagebox("Item Validation", "Duplicate items found at row " + string(ll_count) + " and " + string(ll_found) + "." + "~r~nSuggested options are either delete the row or ~r~n" + "change Item batch or expiry")
				this.id_detail.scrolltorow(ll_count)
				if this.ii_purchasetype = 1 then
					this.id_detail.setcolumn("packqty")
				else
					this.id_detail.setcolumn("looseqty")
				end if
				this.id_detail.setfocus()
				return
			end if
		next
	elseif ll_detailrows <= 0 then
		messagebox("On Save Validation", "There are no rows to save.~r~nKindly insert some item row.")
		return
	end if
	wf_grandtotal()
	this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
	ld_invtotal = this.id_footer.getitemnumber(1, "total")
	if ld_invtotal < 0.0 then
		messagebox("On Save Validation", "Can not save this purchase invoice.~r~nReason: Grand Total for this Purchase is negative.")
		return
	end if
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	wf_setamountoninvoice()
	if f_stringpreferences("puruserwindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	setfocus()
	if ll_salesmancode > 0 then
		setpointer(hourglass!)
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			f_newtableid("advpurheader", ll_invid)
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
			this.id_master.setitem(ll_mastercurrrow, "usercode", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
		else
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		end if
		this.id_master.object.discperc[ll_mastercurrrow] = this.id_footer.object.discperc[ll_footercurrrow]
		this.id_master.object.flatdisc[ll_mastercurrrow] = this.id_footer.object.flatdisc[ll_footercurrrow]
		this.id_master.object.flatdisc2[ll_mastercurrrow] = this.id_footer.object.flatdisc2[ll_footercurrrow]
		this.id_master.object.misccharges[ll_mastercurrrow] = this.id_footer.object.misccharges[ll_footercurrrow]
		this.id_master.object.misccharges2[ll_mastercurrrow] = this.id_footer.object.misccharges2[ll_footercurrrow]
		this.id_master.object.flatincometax[ll_mastercurrrow] = this.id_footer.object.flatincometax[ll_footercurrrow]
		this.id_master.object.percincometax[ll_mastercurrrow] = this.id_footer.object.percincometax[ll_footercurrrow]
		this.id_master.object.flatadditionaltax[ll_mastercurrrow] = this.id_footer.object.flatadditionaltax[ll_footercurrrow]
		this.id_master.object.percadditionaltax[ll_mastercurrrow] = this.id_footer.object.percadditionaltax[ll_footercurrrow]
		this.id_master.object.flatextratax[ll_mastercurrrow] = this.id_footer.object.flatextratax[ll_footercurrrow]
		this.id_master.object.percextratax[ll_mastercurrrow] = this.id_footer.object.percextratax[ll_footercurrrow]
		this.id_master.object.flatcustomduty[ll_mastercurrrow] = this.id_footer.object.flatcustomduty[ll_footercurrrow]
		this.id_master.object.perccustomduty[ll_mastercurrrow] = this.id_footer.object.perccustomduty[ll_footercurrrow]
		this.id_master.object.flatexciseduty[ll_mastercurrrow] = this.id_footer.object.flatexciseduty[ll_footercurrrow]
		this.id_master.object.percexciseduty[ll_mastercurrrow] = this.id_footer.object.percexciseduty[ll_footercurrrow]
		this.id_master.object.freightlocal[ll_mastercurrrow] = this.id_footer.object.freightlocal[ll_footercurrrow]
		this.id_master.object.freightforeign[ll_mastercurrrow] = this.id_footer.object.freightforeign[ll_footercurrrow]
		wf_grandtotal()
		this.id_footer.accepttext()
		this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
		if this.id_master.getitemstring(1, "accountfor") = "Y" and f_stringpreferences("AskAmtOnPurchase") = "Y" then
			ll_rightfound = 0
			ll_rightfound = gds_securitywindow.find("rightcode = 584", 1, gds_securitywindow.rowcount())
			if ll_rightfound > 0 then
				this.id_master.setitem(ll_mastercurrrow, "amtby", ll_salesmancode)
				this.id_master.setitem(ll_mastercurrrow, "amtdate", ldt_server_datetime)
			end if
		end if
		this.id_master.object.invgstperc1[ll_mastercurrrow] = this.id_footer.object.invgstperc1[ll_footercurrrow]
		do while li_counter <= ll_detailrows
			this.id_detail.setitem(li_counter, "code", ll_invid)
			ll_icode = this.id_detail.object.icode[li_counter]
			ls_alternatealiasname = this.id_detail.object.alternatecustomicode[li_counter]
			SQL SELECT saleprice INTO :ld_saleprice FROM item WHERE icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = -1 then
				messagebox("DataBase Error", "Problem In retrieving Item Information")
				return
			else
				this.id_detail.setitem(li_counter, "saleprice", ld_saleprice)
			end if
			ld_packqty = this.id_detail.getitemnumber(li_counter, "packqty")
			ld_looseqty = this.id_detail.getitemnumber(li_counter, "looseqty")
			ld_bonusqty = this.id_detail.getitemnumber(li_counter, "bonusqty")
			if ld_packqty + ld_looseqty + ld_bonusqty = 0.0 then
				messagebox("Purchase Qty Validation", "Please enter valid qty")
				if this.ii_purchasetype = 1 then
					this.id_detail.setcolumn("packqty")
				else
					this.id_detail.setcolumn("looseqty")
				end if
				this.id_detail.selecttext(1, 1)
				return
			end if
			if lb_commitflag and this.id_detail.getitemstatus(li_counter, "purprice", primary!) = datamodified! and ls_updatepurprice = "Y" and wf_updateitempurprice(ll_icode, ls_alternatealiasname, this.id_detail.getitemnumber(li_counter, "purprice")) <> 0 then
				lb_commitflag = false
			end if
			li_counter = li_counter + 1
		loop
		call super::ue_save
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_advancepurchase.ue_newform() returns 0 [event]
	integer rtncode
	integer ll_counter
	datetime ldt_server_datetime
	string ls_date_errtext
	m_advpurchasemenu lm_menu
	call super::ue_newform
	lm_menu = this.menuid
	setredraw(false)
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 528 then
			lm_menu.m_file.m_savepost.enabled = true
		end if
	next
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	wf_setgodownoption()
	this.id_footer.object.discperc[1] = 0
	this.id_footer.object.flatdisc[1] = 0
	this.id_footer.object.misccharges[1] = 0
	if this.ii_purchasetype = 2 then
		this.id_master.object.suppcode[this.id_master.getrow()] = this.il_code
	end if
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	setredraw(true)
	this.id_footer.object.t_rpp.text = ""
	this.id_footer.object.t_avgprice.text = ""
	if this.ib_modifydate then
		if this.ib_fetchserverdate then
			wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
			this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
		else
			this.id_master.setitem(this.id_master.getrow(), "date", today())
		end if
	end if
	if not wf_validatedate() then
		close(this)
	end if
	this.id_master.object.p_itemimage.filename = ""
	wf_filter_po_itemsonly(-1)

// w_advancepurchase.ue_detail() returns 0 [event]
	long ll_code
	long ll_counter
	integer li_rtncode
	integer li_protect
	m_advpurchasemenu lm_menu
	call super::ue_detail
	lm_menu = this.menuid
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	if wf_isinvoiceinuse(ll_code) = true then
		messagebox("Invoice Validation", "Purchase Invoice already in use by some other user.~r~nKindly try again after sometime or open some other invoice.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	this.id_footer.retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	if wf_allowpurchasemodification(ll_code, this.il_groupcode, this.il_strategy) <> 0 then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "You Can not modify this Invoice,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	wf_initmodify(li_protect)
	if li_protect = 0 then
		if not this.ib_normalpurmodify and this.ii_purchasetype = 1 then
			li_protect = 1
		end if
		if not this.ib_loosepurmodify and this.ii_purchasetype = 7 then
			li_protect = 1
		end if
		if not this.ib_loosepurmodify and this.ii_purchasetype <> 1 and this.ii_purchasetype = 7 then
			li_protect = 1
		end if
	end if
	wf_protectdw(this.id_master, li_protect)
	if not isnull(this.id_master.object.pocode[1]) then
		wf_setpurorderinfo(this.id_master.object.pocode[1])
	end if
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_purchasegodownoption
	end if
	wf_setgodownoption()
	this.im_menu.m_file.m_save.enabled = false
	if li_protect = 0 then
		this.im_menu.m_file.m_save.enabled = true
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 528 then
				lm_menu.m_file.m_savepost.enabled = true
			end if
		next
	end if
	if li_protect = 1 then
		this.editflag = false
		this.id_footer.object.t_rpp.text = ""
		this.id_footer.object.t_avgprice.text = ""
	end if
	this.im_menu.m_file.m_print.enabled = true
	wf_grandtotal()
	this.id_master.object.p_itemimage.filename = ""
	setredraw(true)

// w_advancepurchase.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 1 and this.il_currrow <= this.id_detail.rowcount() and vf_dwdupcodebatch(this.id_detail, "gcode", gl_defaultgcode, "icode", this.id_detail.getitemnumber(this.id_detail.getrow(), "icode"), "batch", this.id_detail.getitemstring(this.id_detail.getrow(), "batch"), "expiry", this.id_detail.getitemdatetime(this.id_detail.getrow(), "expiry"), this.il_currrow) = true then
		messagebox("Item Validation", "Duplicate item, please select some other item")
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.settransobject(this.it_transobject)
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_advancepurchase.ue_deleteitem() returns 0 [event]
	long ll_row
	ll_row = this.id_detail.getrow()
	if this.id_detail.rowcount() > 0 then
		call super::ue_deleteitem
		return
	end if
	this.im_menu.m_file.m_print.enabled = false

// w_advancepurchase.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	destroy this.ids_itemstockinfo
	return ::message.returnvalue

// w_advancepurchase.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_advancepurchase.ue_list() returns 0 [event]
	m_advpurchasemenu lm_menu
	long ll_counter
	call super::ue_list
	lm_menu = this.menuid
	SQL rollback USING this.it_transobject;
	if this.ib_normalpurposting and this.ii_purchasetype = 1 then
		this.im_menu.m_file.m_post.enabled = true
	elseif this.ib_loosepurposting and this.ii_purchasetype = 7 then
		this.im_menu.m_file.m_post.enabled = true
	elseif this.ib_openingpurposting and this.ii_purchasetype = 2 then
		this.im_menu.m_file.m_post.enabled = true
	else
		this.im_menu.m_file.m_post.enabled = false
	end if
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 528 then
			lm_menu.m_file.m_savepost.enabled = false
		end if
	next

// w_advancepurchase.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	if this.ii_purchasetype = 1 then
		setpointer(hourglass!)
		this.idc_supplierlist.setredraw(false)
		this.idc_supplierlist.settransobject(this.it_transobject)
		this.idc_supplierlist.reset()
		this.idc_supplierlist.retrieve()
		this.idc_supplierlist.setredraw(true)
		setpointer(arrow!)
	end if

// w_advancepurchase.ue_print() returns 0 [event]
	long ll_invcode
	long ll_suppcode
	long ll_row
	string ls_suppname
	string ls_printbalance
	string ls_invoicesize
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if f_stringpreferences("PurchaseAutoPosting") = "Y" then
			wf_saveandpost()
		else
			triggerevent("ue_save")
		end if
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	SQL SELECT purinvpagesize INTO :ls_invoicesize FROM advpurheader WHERE advpurinvcode =:ll_invcode USING this.it_transobject;
	wf_selectprintreport(ls_invoicesize)
	if lb_listtab then
		SQL Select PrintBalance INTO :ls_printbalance From advPurHeader Where advPurInvCode =:ll_invcode USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Fetch Problem", "Unable to fetch PrintBalance status from database")
			SQL rollback USING this.it_transobject;
			return
		else
			SQL commit USING this.it_transobject;
		end if
		if ls_printbalance = "Y" then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
		end if
	elseif this.id_master.getitemstring(1, "PrintBalance") = "Y" then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
	end if
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.id_print.rowcount() > 0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_advancepurchase.ue_postopen() returns 0 [event]
	datawindowchild ldc_dddpurcategory
	datawindowchild ldc_headerno
	m_advpurchasemenu lm_menu
	datastore lds_headers
	integer li_rtncode
	long ll_code
	long ll_counter
	long ll_found
	call super::ue_postopen
	lm_menu = this.menuid
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	setredraw(false)
	wf_setpurchasetype(integer(message.doubleparm))
	this.id_print = this.dw_purinvrep
	this.id_print.settransobject(this.it_transobject)
	choose case this.ii_purchasetype
	case 1
		this.title = "Advanced Purchase (in Packs)"
		wf_assigndatawindowobjects("d_AdvPurchaseHeader", "d_AdvPurchaseDetail", "d_AdvPurchaseList")
		li_rtncode = this.id_master.getchild("suppcode", this.idc_supplierlist)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
		end if
		this.idc_supplierlist.settransobject(this.it_transobject)
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 504 then
				this.ib_normalpurposting = true
				this.im_menu.m_file.m_post.visible = true
				this.im_menu.m_file.m_post.toolbaritemvisible = true
				this.im_menu.m_file.m_post.enabled = false
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 507 then
				this.ib_normalpurmodify = true
			end if
		next
		if not this.ib_normalpurposting then
			this.im_menu.m_file.m_post.visible = false
			this.im_menu.m_file.m_post.toolbaritemvisible = false
			this.im_menu.m_file.m_post.enabled = false
		end if
		if f_stringpreferences("showpurchasetypeinpurchase") = "N" then
			this.id_master.object.purtypecode.visible = false
			this.id_master.object.purtypecode_t.visible = false
		end if
		if f_stringpreferences("showpurchaseorderinpurchase") = "N" then
			this.id_master.object.pocode.visible = false
			this.id_master.object.pocode_t.visible = false
			this.id_master.object.podate.visible = false
			this.id_master.object.podate_t.visible = false
		end if
		if f_stringpreferences("showmarkupinpur") = "N" then
			this.id_detail.object.c_markup.visible = false
		end if
		if f_stringpreferences("showmargininpur") = "N" then
			this.id_detail.object.c_margin.visible = false
		end if
		if f_stringpreferences("UpdateSalePriceForItem") = "N" then
			this.id_detail.object.salepriceforitem.visible = false
			this.id_detail.object.c_margin.visible = false
		end if
	case 7
		this.title = "Loose Purchase"
		wf_assigndatawindowobjects("d_LoosePurchaseHeader", "d_loosePurchaseDetail", "d_LoosePurchaseList")
		li_rtncode = this.id_master.getchild("suppcode", this.idc_supplierlist)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
		end if
		this.idc_supplierlist.settransobject(this.it_transobject)
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 505 then
				this.ib_loosepurposting = true
				this.im_menu.m_file.m_post.visible = true
				this.im_menu.m_file.m_post.toolbaritemvisible = true
				this.im_menu.m_file.m_post.enabled = false
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 508 then
				this.ib_loosepurmodify = true
			end if
		next
		if not this.ib_loosepurposting then
			this.im_menu.m_file.m_post.visible = false
			this.im_menu.m_file.m_post.toolbaritemvisible = false
			this.im_menu.m_file.m_post.enabled = false
		end if
		if f_stringpreferences("showpurchasetypeinpurchase") = "N" then
			this.id_master.object.purtypecode.visible = false
			this.id_master.object.purtypecode_t.visible = false
		end if
	case else
		this.title = "Opening Purchase"
		wf_assigndatawindowobjects("d_OpeningPurchaseHeader", "d_OpeningPurchaseDetail", "d_OpeningPurchaseList")
		this.it_transobject.getglobalcode("GT_OpeningSupplierACC", this.il_code)
		lm_menu.m_file.m_setquantity.visible = true
		lm_menu.m_file.m_setquantity.enabled = true
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 506 then
				this.ib_openingpurposting = true
				this.im_menu.m_file.m_post.visible = true
				this.im_menu.m_file.m_post.toolbaritemvisible = true
				this.im_menu.m_file.m_post.enabled = false
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 509 then
				this.ib_openingpurmodify = true
			end if
		next
		if not this.ib_openingpurposting then
			this.im_menu.m_file.m_post.visible = false
			this.im_menu.m_file.m_post.toolbaritemvisible = false
			this.im_menu.m_file.m_post.enabled = false
		end if
	end choose
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 528 then
			lm_menu.m_file.m_savepost.visible = true
			lm_menu.m_file.m_savepost.enabled = true
		end if
	next
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit to Make Purchase")
		close(this)
		return
	end if
	li_rtncode = this.id_detail.getchild("gcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to Purchase")
		close(this)
		return
	end if
	this.ii_purchasegodownoption = this.idc_godown.getitemnumber(1, "gcode")
	this.id_detail.object.gcode.initial = string(this.ii_purchasegodownoption)
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = false
	this.id_itemslist.object.sstock.visible = false
	this.id_itemslist.object.t_pstock.visible = true
	this.id_itemslist.object.pstock.visible = true
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_detail.object.gcode.visible = false
		this.id_master.object.t_gcode.visible = true
		this.id_master.object.gcode.visible = true
		this.id_master.object.gcode.initial = string(this.ii_purchasegodownoption)
	end if
	if f_stringpreferences("AlternateCustomICodeInPur") = "N" then
		this.id_detail.object.alternatecustomicode.visible = false
	end if
	if f_stringpreferences("PackUnitsInPur") = "N" then
		this.id_detail.object.packunits.visible = false
	end if
	if f_stringpreferences("pursuppBalance") = "Y" and (this.ii_purchasetype = 1 or this.ii_purchasetype = 7) then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
	elseif not (this.ii_purchasetype = 2) then
		this.id_master.object.creditordebit.visible = false
		this.id_master.object.suppbalance.visible = false
		this.id_master.object.t_balance.visible = false
	end if
	if f_stringpreferences("puritemdescription") = "N" then
		this.id_detail.object.itemdescription.visible = false
	end if
	if f_stringpreferences("purbatch") = "N" then
		this.id_detail.object.batch.visible = false
	end if
	if f_stringpreferences("purexpiry") = "N" then
		this.id_detail.object.expiry.visible = false
	end if
	if f_stringpreferences("packingdescinpurchase") = "N" then
		this.id_detail.object.packingdesc.visible = false
	end if
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 594", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.currencycode.visible = true
		this.id_master.object.t_currencycode.visible = true
		this.id_master.object.conversionfactor.visible = true
		this.id_master.object.t_conversionfactor.visible = true
		this.id_detail.object.foreignprice.visible = true
		this.id_detail.object.c_foreigntotal.visible = true
	else
		this.id_master.object.currencycode.visible = false
		this.id_master.object.t_currencycode.visible = false
		this.id_master.object.conversionfactor.visible = false
		this.id_master.object.t_conversionfactor.visible = false
		this.id_detail.object.foreignprice.visible = false
		this.id_detail.object.c_foreigntotal.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.pstock.visible = false
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	if f_stringpreferences("visibleporb") = "N" then
		this.id_master.object.porb.visible = false
		this.id_master.object.t_porb.visible = false
	end if
	if f_stringpreferences("showpuritemunittax") = "N" then
		this.id_detail.object.unitsalestax.visible = false
		this.id_detail.object.taxperunit_t.visible = false
		this.id_detail.object.c_sumtaxval.visible = false
		this.id_detail.object.c_taxval.visible = false
		this.id_detail.object.taxval_t.visible = false
	end if
	if f_stringpreferences("showpuritemgstperc") = "N" then
		this.id_detail.object.gstperc.visible = false
		this.id_detail.object.gstperc_t.visible = false
		this.id_detail.object.c_sumgstval.visible = false
		this.id_detail.object.c_gstval.visible = false
		this.id_detail.object.gstval_t.visible = false
	end if
	if f_stringpreferences("showpurinvgstperc") = "N" then
		this.id_footer.object.invgstperc1.visible = false
		this.id_footer.object.invgstperc1_t.visible = false
	end if
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Purchase")
		close(this)
		return
	end if
	if f_stringpreferences("headeronpurchaseinv") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.t_headerno.visible = false
	end if
	this.id_master.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to lds_headers.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
		ldc_headerno.setitem(ll_counter, "name", "")
		ll_found = 0
		ll_found = gds_reoprtheaderinfo.find("headerno=" + string(lds_headers.getitemnumber(ll_counter, "headercode")), 1, gds_reoprtheaderinfo.rowcount())
		if ll_found > 0 then
			ldc_headerno.setitem(ll_counter, "headeralias", gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks"))
		end if
	next
	this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
	this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
	if f_stringpreferences("bonusinpurchase") = "N" then
		this.id_detail.object.bonusqty.visible = false
	end if
	gd_itemsinfo.sharedata(this.id_itemslist)
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	if f_stringpreferences("ShowAccountForinPurchase") = "Y" then
		this.id_master.object.accountfor.visible = true
		this.id_master.object.t_accountfor.visible = true
	else
		this.id_master.object.accountfor.visible = false
		this.id_master.object.t_accountfor.visible = false
	end if
	if f_stringpreferences("PurchaseAccountFor") = "Y" then
		this.id_master.object.accountfor.initial = "Y"
	else
		this.id_master.object.accountfor.initial = "N"
	end if
	if f_stringpreferences("PurchaseOnZeroprice") = "N" and this.id_detail.setvalidate("purprice", "Number(GetText())>0") <> 1 then
		messagebox("Column Validation", "Unable to set validation expression for column Purchase Price")
		return
	end if
	this.id_master.object.purinvpagesize.initial = upper(f_stringpreferences("purinvpagesize"))
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 564", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_showinvoicelist = true
	else
		this.ib_showinvoicelist = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 580", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.date.protect = 0
		this.id_master.object.date.background.color = rgb(255, 255, 255)
		this.ib_modifydate = true
		lm_menu.m_file.m_setserverdate.visible = true
		lm_menu.m_file.m_setserverdate.enabled = true
	end if
	if not this.ib_modifydate then
		this.id_master.object.date.protect = 1
		this.id_master.settaborder("date", 0)
		lm_menu.m_file.m_setserverdate.visible = false
		lm_menu.m_file.m_setserverdate.enabled = false
	end if
	this.id_detail.object.batch.initial = f_stringpreferences("defaultbatch")
	this.id_detail.object.expiry.initial = string(f_datepreferences("defaultexpiry"))
	if wf_item_image_setting() < 0 then
		messagebox("Connection Problem", "Problem in connecting database. Kindly Try Again", stopsign!)
		close(this)
	end if
	wf_apply_advancepurchase_pref()
	f_setcolumnstyle(this.id_detail, "Qty")
	wf_set_itemtotal_formatmask()
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 597", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_showaccountledger.visible = true
		lm_menu.m_file.m_showaccountledger.enabled = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 599", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_showsummaryaccountbalance.visible = true
		lm_menu.m_file.m_showsummaryaccountbalance.enabled = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5091", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_itempurchasehistory.visible = true
		lm_menu.m_file.m_itempurchasehistory.enabled = true
	else
		lm_menu.m_file.m_itempurchasehistory.visible = false
		lm_menu.m_file.m_itempurchasehistory.enabled = false
	end if
	setredraw(true)
	if f_islicenseexpire() = -2 then
		close(this)
	end if

// w_advancepurchase.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	show()
	return ::message.returnvalue

// w_advancepurchase.closequery() returns long [event]
	integer li_yesno
	integer li_rtcode
	if this.editflag = true then
		li_yesno = messagebox("Invoice", "Do You want to save changes", question!, yesnocancel!, 2)
		if li_yesno = 1 then
			triggerevent("ue_save")
			if wf_commitform() = false then
				li_rtcode = 1
			end if
		elseif li_yesno = 2 then
			SQL rollback USING this.it_transobject;
			li_rtcode = 0
		elseif li_yesno = 3 then
			li_rtcode = 1
		end if
	end if
	return li_rtcode

// dw_footer.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	return ::message.returnvalue

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
		return 1
	case "misccharges2"
		messagebox("Misc. Charges 2 Validation", "Charges ~"" + data + "~" should be greater equal zero")
		return 1
	case "faltdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
		return 1
	case "faltdisc2"
		messagebox("Flat Dsicount 2 Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
		return 1
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
		return 1
	end choose
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_result
	long ll_code
	long ll_manfcode
	long ll_detailrows
	double ld_price
	double ld_rate
	string ls_null
	date ld_null
	dwitemstatus lrs_status
	integer li_res
	integer li_suppcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "suppinvdate"
		if date(data) > today() then
			messagebox("Supplier Invoice Date Validaion!", "Forward Date is not acceptable here~r~nPlease Enter Valid Date")
			return 1
		end if
	case "suppcode"
		ll_code = long(data)
		parent.parent.parent.wf_setsuppinfo(ll_code, this)
	case "currencycode"
		ll_code = long(data)
		parent.parent.parent.wf_setcurrency(ll_code)
	case "conversionfactor"
		ld_rate = double(data)
		if ld_rate <= 0.0 then
			return 1
		elseif parent.parent.parent.wf_applycurrency(double(data)) <= 0 then
			return 1
		end if
	case "aliasname"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findsuppcode(data, li_suppcode)
			if li_res > 0 then
				setitem(row, "suppcode", li_suppcode)
				return 0
			else
				messagebox("Supplier Validation", "Supplier with  AliasName " + data + " does not exist")
				return 1
			end if
			return
		end if
	case "pocode"
		if not isnull(data) and integer(data) <> 0 then
			ll_detailrows = parent.dw_itemsdetail.rowcount()
			if ll_detailrows > 0 then
				lrs_status = parent.dw_itemsdetail.getitemstatus(1, 0, primary!)
				ll_code = long(data)
				ll_manfcode = parent.parent.parent.wf_setpurorderinfo(ll_code)
				parent.parent.parent.im_menu.m_file.m_options.enabled = true
				this.object.suppcode.protect = 1
			end if
			parent.parent.parent.wf_filter_po_itemsonly(long(data))
		end if
	end choose
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "suppcode"
		messagebox("Supplier Name Validation", "You must select some supplier")
		return 1
	case "currencycode"
		messagebox("Currency Validation", "You must select some valid currency")
		return 1
	case "conversionfactor"
		messagebox("Conversion Factor/Rate Validation", "You must select some valid Conversion Factor/Rate")
		return 1
	end choose
	return ::message.returnvalue

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if string(dwo.name) = "suppcode" then
		parent.parent.parent.id_master.selecttext(1, 40)
	end if
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyenter! and getcolumnname() = "suppcode" then
		parent.parent.parent.id_master.setitem(1, "suppcode", parent.parent.parent.idc_supplierlist.getitemnumber(parent.parent.parent.idc_supplierlist.getrow(), "supplier_suppcode"))
		parent.parent.parent.wf_setsuppinfo(parent.parent.parent.idc_supplierlist.getitemnumber(parent.parent.parent.idc_supplierlist.getrow(), "supplier_suppcode"), this)
	end if
	return ::message.returnvalue

// dw_detail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	parent.parent.parent.post wf_setsuppname(data)
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_null
	string ls_itemname
	string ls_error
	integer li_errcode
	integer li_packunits
	integer li_retmsgcode
	integer li_option = 2
	datetime ldt_expiry
	date ld_expiry
	time lt_expiry
	long ll_null
	long ll_currentrow
	long ll_icode
	long ll_itemtypecode
	double ld_conversionfactor
	double ld_saleprice
	double ld_newprice
	double ld_totpurprice
	double ld_newqty
	double ld_storedqty
	double ld_stock
	double ld_bonusqty
	double ld_packqty
	double ld_looseqty
	double ld_defaultqty = 1.0
	datawindowchild ldc_items
	dwitemstatus lrs_status
	double ld_godownstock
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	ll_currentrow = getrow()
	lrs_status = getitemstatus(ll_currentrow, 0, primary!)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		if parent.parent.parent.id_itemslist.rowcount() > 0 then
			parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
			parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		end if
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		li_errcode = 0
	case "icode"
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	case "bonusqty"
		ld_bonusqty = double(data)
		ld_packqty = getitemnumber(row, "packqty")
		ld_looseqty = getitemnumber(row, "looseqty")
	case "packqty"
		ld_packqty = double(data)
		ld_bonusqty = getitemnumber(row, "bonusqty")
	case "looseqty"
		ld_looseqty = double(data)
		ld_bonusqty = getitemnumber(row, "bonusqty")
	case "gcode"
		accepttext()
		parent.parent.parent.it_transobject.getitemstocktotal(getitemnumber(row, "gcode"), getitemnumber(row, "icode"), ld_godownstock)
		parent.parent.parent.id_footer.setitem(1, "stock", ld_godownstock)
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname, ll_itemtypecode, parent.parent.parent.idbl_packqty, parent.parent.parent.idbl_purprice, parent.parent.parent.idbl_saleprice)
			if li_res > 0 then
				if parent.parent.parent.idbl_packqty <= 0.0 or isnull(parent.parent.parent.idbl_packqty) then
					parent.parent.parent.idbl_packqty = 1
				end if
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				if ll_itemtypecode = 2 then
					setitem(row, "alternatecustomicode", data)
					setitem(row, "packunits", long(parent.parent.parent.idbl_packqty))
					setitem(row, "purprice", parent.parent.parent.idbl_purprice)
					setitem(row, "saleprice", parent.parent.parent.idbl_saleprice)
					setitem(row, "salepriceforitem", parent.parent.parent.idbl_saleprice)
				else
					setitem(row, "alternatecustomicode", ls_null)
				end if
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
			else
				messagebox("ItemNumber Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_errcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_errcode = 2
		end if
	case "purprice"
		ll_icode = parent.parent.parent.id_detail.getitemnumber(row, "icode")
		SQL Select item.saleprice , item.packunits INTO :ld_saleprice, :li_packunits From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
		choose case parent.parent.parent.ii_purchasetype
		case 1
			if double(data) > ld_saleprice then
				li_retmsgcode = messagebox("Purchase Validation", "Purchase Price " + data + " is greater than Sale Price~r~n Do you want to continue", question!, yesno!)
				if li_retmsgcode = 1 then
					li_errcode = 0
				else
					li_errcode = 1
				end if
			end if
		case 7
			if double(data) > ld_saleprice / li_packunits then
				li_retmsgcode = messagebox("Purchase Validation", "Purchase Price " + data + " is greater than Sale Price~r~n Do you want to continue", question!, yesno!)
				if li_retmsgcode = 1 then
					li_errcode = 0
				else
					li_errcode = 1
				end if
			end if
		end choose
	case "purprice2", "purprice3", "purprice4"
		ll_icode = parent.parent.parent.id_detail.getitemnumber(row, "icode")
		SQL Select item.saleprice , item.packunits INTO :ld_saleprice, :li_packunits From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
		if double(data) >= 0.0 then
			ld_totpurprice = double(data)
			if dwo.name = "purprice2" then
				ld_totpurprice = ld_totpurprice + this.object.purprice[row] + this.object.purprice3[row] + this.object.purprice4[row]
			elseif dwo.name = "purprice3" then
				ld_totpurprice = ld_totpurprice + this.object.purprice[row] + this.object.purprice2[row] + this.object.purprice4[row]
			elseif dwo.name = "purprice4" then
				ld_totpurprice = ld_totpurprice + this.object.purprice[row] + this.object.purprice2[row] + this.object.purprice3[row]
			else
				ld_totpurprice = ld_totpurprice + this.object.purprice2[row] + this.object.purprice3[row] + this.object.purprice4[row]
			end if
		else
			li_errcode = 1
		end if
		if li_errcode = 0 then
			choose case parent.parent.parent.ii_purchasetype
			case 1
				if ld_totpurprice > ld_saleprice then
					li_retmsgcode = messagebox("Purchase Validation", "Purchase Price " + data + " is greater than Sale Price~r~n Do you want to continue", question!, yesno!)
					if li_retmsgcode = 1 then
						li_errcode = 0
					else
						li_errcode = 1
					end if
				end if
			case 7
				if ld_totpurprice > ld_saleprice / li_packunits then
					li_retmsgcode = messagebox("Purchase Validation", "Purchase Price " + data + " is greater than Sale Price~r~n Do you want to continue", question!, yesno!)
					if li_retmsgcode = 1 then
						li_errcode = 0
					else
						li_errcode = 1
					end if
				end if
			end choose
		end if
	case "discountedpurprice"
		parent.parent.parent.wf_discperccalc(double(data))
	case "discperc"
		parent.parent.parent.wf_discpricecalc(double(data))
	case "foreignprice"
		if double(data) >= 0.0 then
			ll_icode = parent.parent.parent.id_detail.getitemnumber(row, "icode")
			ld_conversionfactor = parent.parent.parent.id_master.getitemnumber(parent.parent.parent.id_master.getrow(), "conversionfactor")
			SQL Select item.saleprice , item.packunits INTO :ld_saleprice, :li_packunits From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			choose case parent.parent.parent.ii_purchasetype
			case 1
				ld_newprice = round(double(data) * ld_conversionfactor, 2)
				if ld_newprice > ld_saleprice then
					li_retmsgcode = messagebox("Purchase Validation", "Purchase Price " + string(double(ld_newprice)) + " is greater than Sale Price~r~n Do you want to continue", question!, yesno!)
					if li_retmsgcode = 1 then
						li_errcode = 0
					else
						li_errcode = 1
					end if
				end if
				if li_errcode = 0 then
					this.object.purprice[row] = ld_newprice
					parent.parent.parent.wf_grandtotal()
				end if
			case else
				ld_newprice = round(double(data) * ld_conversionfactor, 2)
				if ld_newprice > ld_saleprice / li_packunits then
					li_retmsgcode = messagebox("Purchase Validation", "Purchase Price " + string(double(ld_newprice)) + " is greater than Sale Price~r~n Do you want to continue", question!, yesno!)
					if li_retmsgcode = 1 then
						li_errcode = 0
					else
						li_errcode = 1
					end if
				end if
				if li_errcode = 0 then
					this.object.purprice[row] = ld_newprice
					parent.parent.parent.wf_grandtotal()
				end if
			end choose
		else
			li_errcode = 1
		end if
	case "expiry"
		ld_expiry = date(mid(data, 1, 10))
		lt_expiry = time("00:00:00.000000")
		ldt_expiry = datetime(ld_expiry, lt_expiry)
		if li_errcode < 1 and rowcount() > 1 and ldt_expiry <> datetime("00/00/0000, 00:00:00") and not (isnull(this.object.icode[row]) and isnull(this.object.batch[row]) and isnull(this.object.expiry[row])) and vf_dwdupcodebatch(this, "gcode", gl_defaultgcode, "icode", getitemnumber(getrow(), "icode"), "batch", getitemstring(getrow(), "batch"), "expiry", ldt_expiry, parent.parent.parent.il_currrow) = true then
			messagebox("Item Validation", "Duplicate item, please select some other item")
			li_errcode = 1
		end if
	case "unittaxrulecode"
		if long(data) = 4 then
			this.object.unitsalestax[row] = 0
		end if
	case "gstrulecode"
		if long(data) = 4 then
			this.object.gstperc[row] = 0
		end if
	case "unitsalestax"
	case "gstperc"
	case "itemflatdisc"
		if real(data) >= 0.0 then
			if this.object.c_totalprice[row] - real(data) < 0 then
				messagebox("Item Flat Discount Validation", "Item Flat Discount cannot be more than purchase price,~r~nPlease Select Valid Item Flat Discount")
				li_errcode = 1
			end if
		elseif real(data) < 0.0 then
			messagebox("Item Flat Discount Validation", "Please Select Valid Item Flat Discount")
			li_errcode = 1
		end if
	case "itemflatdisc2"
		if real(data) >= 0.0 then
			if this.object.c_total[row] + this.object.c_taxval[row] + this.object.c_gstval[row] - real(data) * this.object.packqty[row] < 0 then
				messagebox("Item Flat Discount 2 Validation", "Item Flat Discount2 cannot be more than purchase value,~r~nPlease Select Valid Item Flat Discount2")
				li_errcode = 1
			end if
		elseif real(data) < 0.0 then
			messagebox("Item Flat Discount 2 Validation", "Please Select Valid Item Flat Discount 2")
			li_errcode = 1
		end if
	case "itemflatdiscafterdiscperc"
		if real(data) >= 0.0 then
			if this.object.c_total[row] + this.object.c_taxval[row] + this.object.c_gstval[row] - real(data) * this.object.packqty[row] < 0 then
				messagebox("Item Flat Discount After Disc. (%) Validation", "Item Flat Discount After Disc. (%) cannot be more than purchase value,~r~nPlease Select Valid Item Flat Discount After Disc. %")
				li_errcode = 1
			end if
		elseif real(data) < 0.0 then
			messagebox("Item Flat Discount After Disc. (%) Validation", "Please Select Valid Item Flat Discount After Disc. %")
			li_errcode = 1
		end if
	case "valuedisconitem"
		if real(data) >= 0.0 then
			if this.object.c_itemtotal_afterdiscperc2[row] - real(data) < 0 then
				messagebox("Item Flat Discount After Disc. (%) Validation", "Item Flat Discount After Disc. (%) cannot be more than purchase value,~r~nPlease Select Valid Item Flat Discount After Disc. %")
				li_errcode = 1
			end if
		elseif real(data) < 0.0 then
			messagebox("Item Flat Discount After Disc. (%) Validation", "Please Select Valid Item Flat Discount After Disc. %")
			li_errcode = 1
		end if
	case "measureunitcode"
		return parent.parent.parent.wf_apply_measureunit(long(data), row)
	case "measureunitrate"
		if double(data) >= 0.0 then
			if this.object.measureqty[row] > 0 then
				this.object.purprice[row] = round(double(data) / this.object.measureqty[row], 5)
			else
				this.object.purprice[row] = round(double(data), 5)
			end if
			return 0
		else
			return 1
		end if
		return
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ancestorreturnvalue
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "itemname" then
		parent.parent.parent.ib_focusdetail = true
	elseif (dwo.name = "looseqty" or dwo.name = "packqty") and parent.parent.parent.id_master.object.pocode[1] > 0 then
		parent.parent.parent.wf_filter_po_itemsonly(parent.parent.parent.id_master.object.pocode[1])
	end if
	if row > 0 then
		parent.parent.parent.wf_discpricecalc(parent.parent.parent.id_detail.object.discperc[row])
	end if
	parent.parent.parent.wf_grandtotal()
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	double ld_rpp
	double ld_avgprice
	double ld_rpp2
	double ld_rpp3
	double ld_rpp4
	double ld_rpp5
	dwitemstatus lrs_status
	long ll_icode
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if getcolumnname() <> parent.parent.parent.is_columnitemname then
		if rowcount() > 0 and lrs_status <> new! then
			parent.parent.parent.wf_set_itemimage(getitemnumber(currentrow, "icode"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", getitemnumber(currentrow, "icode"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", getitemnumber(currentrow, "stock"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", getitemnumber(currentrow, "totalstock"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "itemtotalval", getitemstring(currentrow, "itemtotalval"))
			ll_icode = getitemnumber(getrow(), "icode")
			SQL Select item.recentpurprice , item.avgprice , item.recentpurprice2 , item.recentpurprice3 , item.recentpurprice4 , item.recentpurprice5 INTO :ld_rpp, :ld_avgprice, :ld_rpp2, :ld_rpp3, :ld_rpp4, :ld_rpp5 From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			parent.parent.parent.id_footer.object.t_rpp.text = string(ld_rpp) + " , " + string(ld_rpp2) + " , " + string(ld_rpp3) + " , " + string(ld_rpp4) + " , " + string(ld_rpp5)
			parent.parent.parent.id_footer.object.t_avgprice.text = string(ld_avgprice)
		elseif parent.parent.parent.id_footer.getrow() > 0 then
			parent.parent.parent.id_master.object.p_itemimage.filename = ""
			parent.parent.parent.id_footer.object.t_rpp.text = ""
			parent.parent.parent.id_footer.object.t_avgprice.text = ""
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", 0)
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_colname
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	ls_colname = dwo.name
	if ls_colname = "Qty" or ls_colname = "discperc" or ls_colname = "discperc2" or ls_colname = "purprice" or ls_colname = "purprice2" or ls_colname = "discperc3" or ls_colname = "purprice4" or ls_colname = "discountedpurprice" or ls_colname = "itemflatdisc" or ls_colname = "itemflatdisc2" or ls_colname = "itemflatdiscafterdiscperc" or ls_colname = "valuedisconitem" or ls_colname = "foreignprice" then
		parent.parent.parent.wf_grandtotal()
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "fullcode"
		if isnull(data) or data = "" then
			messagebox("Item Code Validation", "Item Code ~"" + data + "~" does not exist")
		end if
		return 1
	case parent.parent.parent.is_columnitemname
		messagebox("Item Validation", "Value required for item in current row")
		return 1
	case "icode"
		messagebox("Item Validation", "Value required for item in current row")
		return 1
	case "bonusqty"
		messagebox("Bonus Qty Validation", "Bonus Qty ~"" + data + "~" should be greater than or equal to zero")
		return 1
	case "discperc", "discperc2"
		messagebox("Item Discount Validation", "Discount ~"" + data + "~" must be betweeen 0 and 100")
		return 1
	case "itemflatdisc", "itemflatdisc2"
		messagebox("Item Flat Discount Validation", "Enter Valid Discount")
		return 1
	case "purprice", "purprice2", "purprice3", "purprice4"
		return 1
	case "gstperc"
		return 1
	case "unitsalestax"
		return 1
	case "expiry"
		return 1
	end choose
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	long ancestorreturnvalue
	if f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanging(long currentrow, long newrow) returns long [event]
	long ancestorreturnvalue
	double ld_packqty
	double ld_looseqty
	double ld_bonusqty
	long ll_icode
	ancestorreturnvalue = super::rowfocuschanging(currentrow, newrow)
	if currentrow > 0 and parent.parent.parent.id_detail.rowcount() > 0 and currentrow <= parent.parent.parent.id_detail.rowcount() then
		ld_packqty = parent.parent.parent.id_detail.getitemnumber(currentrow, "packqty")
		ld_looseqty = parent.parent.parent.id_detail.getitemnumber(currentrow, "looseqty")
		ld_bonusqty = parent.parent.parent.id_detail.getitemnumber(currentrow, "bonusqty")
		ll_icode = parent.parent.parent.id_detail.getitemnumber(currentrow, "icode")
		if ld_packqty + ld_bonusqty + ld_looseqty <= 0.0 and not isnull(ll_icode) then
			messagebox("Purchase Qty Validation", "Please enter valid qty")
			post event ue_focusqty()
			return 1
		end if
		return
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_focusqty() returns 0 [event]
	if parent.parent.parent.ii_purchasetype = 1 then
		parent.parent.parent.id_detail.setcolumn("packqty")
	else
		parent.parent.parent.id_detail.setcolumn("looseqty")
	end if
	parent.parent.parent.id_detail.selecttext(1, len(parent.parent.parent.id_detail.gettext()))
	parent.parent.parent.id_detail.setfocus()

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_icode
	long ll_found
	long ll_rowm
	s_salepricecalculater ls_salepricecalc
	s_datastore lstr_ds
	s_popup_selection lstr_selection
	string ls_alternatealias
	string ls_itemname
	long ll_itemcodetype
	long li_res
	double ld_qty
	double ld_purprice
	double ld_saleprice
	s_unittaxinputs ls_unittaxinputs
	double ld_valuextax
	s_unittaxinputs ls_unittaxinputs2
	double ld_valuextax2
	s_unittaxinputs ls_unittaxinputs3
	if keyflags = 2 and key = keyf5! then
		parent.parent.parent.wf_show_itemgallery()
		rt_code = 1
		return rt_code
	end if
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollnextrow()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyuparrow! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollpriorrow()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keypagedown! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollnextpage()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keypageup! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollpriorpage()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyend! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrolltorow(parent.parent.parent.id_itemslist.rowcount())
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyhome! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrolltorow(1)
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf8! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("namesearch", 1)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf9! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("criteriasearch", 1)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf5! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			parent.parent.parent.wf_open_item_form_popup()
			setfocus()
		elseif key = keyf4! then
			parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			if parent.parent.parent.id_itemslist.rowcount() > 0 then
				setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
			end if
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		elseif rt_code = 2 then
			ll_rowm = getrow()
			parent.parent.parent.id_itemslist.selectrow(0, false)
			if getrow() > 0 then
				ll_listcurrrow = parent.parent.parent.id_itemslist.find("itemname = '" + this.object.itemname[ll_rowm] + "'", 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_listcurrrow > 0 and ll_listcurrrow <= parent.parent.parent.id_itemslist.rowcount() then
					parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
					if parent.parent.parent.id_itemslist.rowcount() > 0 then
						setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
						setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
						setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
					end if
					selecttext(1, len(gettext()))
					parent.parent.parent.ib_itemvalidated = true
					parent.parent.parent.il_currrow = ll_rowm
					setitem(ll_rowm, "CurrListRow", ll_listcurrrow)
					setredraw(true)
				end if
				rt_code = 0
			end if
		end if
	elseif key = keydownarrow! then
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_focusfooter")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	end if
	if getcolumnname() = "fullcode" and key = keyf6! then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
		setredraw(true)
		lstr_ds.s_name1 = gd_popup_itemsinfo.dataobject
		lstr_ds.s_name2 = "customicode"
		if getrow() > 0 then
			lstr_ds.d_value = this.object.icode[getrow()]
		end if
		openwithparm(w_popup_responsivesearch_alternatealias, lstr_ds)
		lstr_selection = message.powerobjectparm
		if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
			ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(lstr_selection.l_code2), 1, parent.parent.parent.id_itemslist.rowcount())
			if ll_found > 0 and ll_found <= parent.parent.parent.id_itemslist.rowcount() then
				ls_alternatealias = lstr_selection.s_name
				li_res = parent.parent.parent.wf_findfullcode(ls_alternatealias, ll_icode, ls_itemname, ll_itemcodetype, parent.parent.parent.idbl_packqty, parent.parent.parent.idbl_purprice, parent.parent.parent.idbl_saleprice)
				if li_res > 0 then
					if parent.parent.parent.idbl_packqty = 0.0 then
						parent.parent.parent.idbl_packqty = 1
					end if
					setitem(getrow(), "icode", ll_icode)
					setitem(getrow(), "itemname", ls_itemname)
					if ll_itemcodetype = 2 then
						setitem(getrow(), "alternatecustomicode", ls_alternatealias)
						setitem(getrow(), "packunits", long(parent.parent.parent.idbl_packqty))
						if parent.parent.parent.ii_purchasetype = 1 then
							setitem(getrow(), "purprice", parent.parent.parent.idbl_purprice)
							setitem(getrow(), "saleprice", parent.parent.parent.idbl_saleprice)
							if parent.parent.parent.ii_purchasetype = 1 then
								setitem(getrow(), "salepriceforitem", parent.parent.parent.idbl_saleprice)
							end if
						else
							setitem(getrow(), "purprice", parent.parent.parent.idbl_purprice / parent.parent.parent.idbl_packqty)
							setitem(getrow(), "saleprice", parent.parent.parent.idbl_saleprice)
							if parent.parent.parent.ii_purchasetype = 1 then
								setitem(getrow(), "salepriceforitem", parent.parent.parent.idbl_saleprice)
							end if
						end if
					end if
					parent.parent.parent.ib_itemvalidated = false
					parent.parent.parent.il_currrow = getrow()
				end if
				ll_listcurrrow = ll_found
				parent.parent.parent.id_itemslist.selectrow(0, false)
				rt_code = 1
			end if
		end if
		setfocus()
	end if
	if getcolumnname() = "unitsalestax" and key = keyf5! then
		accepttext()
		if not isnull(this.object.icode[parent.parent.parent.id_detail.getrow()]) then
			ls_unittaxinputs.l_icode = this.object.icode[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs.d_price = this.object.purprice[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs.d_saleprice = this.object.salepriceforitem[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs.d_unittax = this.object.unitsalestax[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs.d_retailprice = this.object.retailprice[parent.parent.parent.id_detail.getrow()]
			openwithparm(w_unittaxcalculator, ls_unittaxinputs)
			ls_unittaxinputs = message.powerobjectparm
			if ls_unittaxinputs.i_status = 1 then
				this.object.unitsalestax[parent.parent.parent.id_detail.getrow()] = ls_unittaxinputs.d_unittax
			end if
			rt_code = 1
		end if
	end if
	if getcolumnname() = "salepriceforitem" and key = keyf5! and not isnull(this.object.icode[parent.parent.parent.id_detail.getrow()]) then
		ls_salepricecalc.l_icode = this.object.icode[parent.parent.parent.id_detail.getrow()]
		ls_salepricecalc.s_name = this.object.itemname[parent.parent.parent.id_detail.getrow()]
		ls_salepricecalc.s_name2 = this.object.fullcode[parent.parent.parent.id_detail.getrow()]
		ls_salepricecalc.d_saleprice = this.object.salepriceforitem[parent.parent.parent.id_detail.getrow()]
		ls_salepricecalc.d_netrate = this.object.netrate[parent.parent.parent.id_detail.getrow()]
		ls_salepricecalc.s_module = "Purchase"
		openwithparm(w_pricecalculator_pur, ls_salepricecalc)
		ls_salepricecalc = message.powerobjectparm
		if ls_salepricecalc.i_status = 1 then
			this.object.salepriceforitem[parent.parent.parent.id_detail.getrow()] = ls_salepricecalc.d_new_saleprice
		end if
		rt_code = 1
	end if
	if getcolumnname() = "salepriceforitem" and key = keyf6! then
		ll_icode = this.object.icode[parent.parent.parent.id_detail.getrow()]
		if not isnull(ll_icode) then
			openwithparm(w_update_alternate_aliasname_form, ll_icode)
		end if
	end if
	if (getcolumnname() = "itemflatdisc" or getcolumnname() = "itemflatdiscafterdiscperc" or getcolumnname() = "itemflatdisc2") and key = keyf5! then
		accepttext()
		if not isnull(this.object.icode[parent.parent.parent.id_detail.getrow()]) then
			ls_unittaxinputs2.l_icode = this.object.icode[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs2.d_price = this.object.c_total[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs2.d_saleprice = this.object.packqty[parent.parent.parent.id_detail.getrow()]
			if getcolumnname() = "itemflatdiscafterdiscperc" then
				ls_unittaxinputs2.d_unittax = this.object.itemflatdiscafterdiscperc[parent.parent.parent.id_detail.getrow()]
			elseif getcolumnname() = "itemflatdisc2" then
				ls_unittaxinputs2.d_unittax = this.object.itemflatdisc2[parent.parent.parent.id_detail.getrow()]
			else
				ls_unittaxinputs2.d_unittax = this.object.itemflatdisc[parent.parent.parent.id_detail.getrow()]
			end if
			openwithparm(w_itemflatdiscountcalculator, ls_unittaxinputs2)
			ls_unittaxinputs2 = message.powerobjectparm
			if ls_unittaxinputs2.i_status = 1 then
				if getcolumnname() = "itemflatdiscafterdiscperc" then
					this.object.itemflatdiscafterdiscperc[parent.parent.parent.id_detail.getrow()] = ls_unittaxinputs2.d_unittax
				elseif getcolumnname() = "itemflatdisc2" then
					this.object.itemflatdisc2[parent.parent.parent.id_detail.getrow()] = ls_unittaxinputs2.d_unittax
				else
					this.object.itemflatdisc[parent.parent.parent.id_detail.getrow()] = ls_unittaxinputs2.d_unittax
				end if
			end if
			rt_code = 1
		end if
	end if
	if getcolumnname() = "gstperc" and key = keyf5! then
		accepttext()
		if not isnull(this.object.icode[parent.parent.parent.id_detail.getrow()]) then
			ls_unittaxinputs3.l_icode = this.object.icode[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs3.d_price = this.object.c_total[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs3.d_saleprice = this.object.gstperc[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs3.d_unittax = this.object.c_total[parent.parent.parent.id_detail.getrow()] * this.object.gstperc[parent.parent.parent.id_detail.getrow()] * 0.01
			openwithparm(w_gstcalculator, ls_unittaxinputs3)
			ls_unittaxinputs3 = message.powerobjectparm
			if ls_unittaxinputs3.i_status = 1 then
				this.object.gstperc[parent.parent.parent.id_detail.getrow()] = ls_unittaxinputs3.d_saleprice
			end if
			rt_code = 1
		end if
	end if
	return rt_code
