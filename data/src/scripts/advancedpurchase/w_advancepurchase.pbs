	else
		this.id_detail.object.unitextrataxrulecode.initial = trim(string(f_numberpreferences("advpur_defaultunitextrataxrule")))
	end if
	if f_stringpreferences("advpur_showunitextratax") = "N" then
		this.id_detail.object.unitextratax.visible = false
	end if
	if f_stringpreferences("advpur_showpercextrataxrule") = "N" then
		this.id_detail.object.percextrataxrulecode.visible = false
	end if
	if isnull(f_numberpreferences("advpur_defaultpercextrataxrule")) then
		this.id_detail.object.percextrataxrulecode.initial = "4"
	else
		this.id_detail.object.percextrataxrulecode.initial = trim(string(f_numberpreferences("advpur_defaultpercextrataxrule")))
	end if
	if f_stringpreferences("advpur_showpercextratax") = "N" then
		this.id_detail.object.percextratax.visible = false
	end if
	if f_stringpreferences("advpur_showunitextratax") = "N" and f_stringpreferences("advpur_showpercextratax") = "N" then
		this.id_detail.object.c_extrataxvalue.visible = false
	end if
	if f_stringpreferences("advpur_showunitcustomdutyrule") = "N" then
