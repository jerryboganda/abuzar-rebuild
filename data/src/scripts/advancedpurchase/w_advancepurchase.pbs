	end if
	if isnull(f_numberpreferences("advpur_defaultunitcustomdutyrule")) then
		this.id_detail.object.unitcustomdutyrulecode.initial = "4"
	else
		this.id_detail.object.unitcustomdutyrulecode.initial = trim(string(f_numberpreferences("advpur_defaultunitcustomdutyrule")))
	end if
	if f_stringpreferences("advpur_showunitcustomduty") = "N" then
		this.id_detail.object.unitcustomduty.visible = false
	end if
	if f_stringpreferences("advpur_showperccustomdutyrule") = "N" then
		this.id_detail.object.perccustomdutyrulecode.visible = false
	end if
	if isnull(f_numberpreferences("advpur_defaultperccustomdutyrule")) then
		this.id_detail.object.perccustomdutyrulecode.initial = "4"
	else
		this.id_detail.object.perccustomdutyrulecode.initial = trim(string(f_numberpreferences("advpur_defaultperccustomdutyrule")))
	end if
	if f_stringpreferences("advpur_showperccustomduty") = "N" then
		this.id_detail.object.perccustomduty.visible = false
	end if
	if f_stringpreferences("advpur_showunitcustomduty") = "N" and f_stringpreferences("advpur_showperccustomduty") = "N" then
		this.id_detail.object.c_customdutyvalue.visible = false
	end if
	if f_stringpreferences("UnitTaxRuleCodeInAdvPur") = "N" then
		this.id_detail.object.unittaxrulecode.visible = false
	end if
	if isnull(f_numberpreferences("DefaultUnitTaxRuleInAdvPur")) then
		this.id_detail.object.unittaxrulecode.initial = "4"
	else
		this.id_detail.object.unittaxrulecode.initial = trim(string(f_numberpreferences("DefaultUnitTaxRuleInAdvPur")))
	end if
	if f_stringpreferences("GSTRuleCodeInAdvPur") = "N" then
		this.id_detail.object.gstrulecode.visible = false
	end if
	if isnull(f_numberpreferences("DefaultGSTRuleInAdvPur")) then
		this.id_detail.object.gstrulecode.initial = "4"
	else
		this.id_detail.object.gstrulecode.initial = trim(string(f_numberpreferences("DefaultGSTRuleInAdvPur")))
	end if
	if f_stringpreferences("ItemFlatDisc2InAdvPur") = "N" then
		this.id_detail.object.itemflatdisc2.visible = false
	end if
	if f_stringpreferences("DiscPerc2InAdvPur") = "N" then
		this.id_detail.object.c_totitemvalue_b4_discperc2.visible = false
		this.id_detail.object.discperc2.visible = false
	end if
	if f_stringpreferences("ValueDiscOnItemInAdvPur") = "N" then
		this.id_detail.object.c_itemtotal_afterdiscperc2.visible = false
		this.id_detail.object.valuedisconitem.visible = false
	end if
	if f_stringpreferences("ShowMeasuringUnitInAdvPur") = "N" then
		this.id_detail.object.measureunitcode.visible = false
		this.id_detail.object.measureunitrate.visible = false
