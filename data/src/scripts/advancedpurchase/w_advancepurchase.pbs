// window w_advancepurchase (advancedpurchase)  ancestor: w_multi_entry

// w_advancepurchase.wf_setsuppinfo(long al_suppcode, datawindow ad_master) returns 0
	string ls_address
	string ls_city
	string ls_phone
	string ls_aliasname
	long ll_currow
	double ld_currbalance
	SQL SELECT supplier.address1 , supplier.city , supplier.phone , accounts.aliasname INTO :ls_address, :ls_city, :ls_phone, :ls_aliasname FROM supplier , Accounts WHERE supplier.suppcode =:al_suppcode AND supplier.suppcode =Accounts.AccCode USING this.it_transobject;
	ll_currow = ad_master.getrow()
	ll_currow = 1
	ad_master.object.aliasname[ll_currow] = ls_aliasname
	ad_master.object.address[ll_currow] = ls_address
	ad_master.object.city[ll_currow] = ls_city
	ad_master.object.phone[ll_currow] = ls_phone
	ad_master.object.suppbalance[ll_currow] = abs(this.idc_supplierlist.getitemnumber(this.idc_supplierlist.getrow(), "balance"))
	ad_master.object.creditordebit[ll_currow] = this.idc_supplierlist.getitemstring(this.idc_supplierlist.getrow(), "balancetype")

// w_advancepurchase.wf_setsuppname(string as_data) returns 0
	long ll_rowno
	ll_rowno = this.idc_supplierlist.find("accounts_name >='" + as_data + "'", 1, this.idc_supplierlist.rowcount())
	if ll_rowno > 0 then
		this.idc_supplierlist.selectrow(0, false)
		this.idc_supplierlist.setrow(ll_rowno)
		this.idc_supplierlist.scrolltorow(ll_rowno)
		this.idc_supplierlist.selectrow(ll_rowno, true)
	end if

// w_advancepurchase.wf_validateitem() returns integer
	long ll_icode
	long ll_gcode
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_stock
	string ls_fullcode
	string ls_errtext
	string ls_titleerrtext
	integer il_errcode = 1
	integer li_errcode
	boolean lb_invalidrow
	integer li_null
	string ls_null
	if isnull(this.il_currrow) or this.il_currrow <= 0 then
		lb_invalidrow = true
	else
		ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	end if
	if lb_invalidrow = false and wf_genfullcode(ll_icode, ls_fullcode) > 0 then
		this.id_detail.object.fullcode[this.il_currrow] = ls_fullcode
		if not wf_inititeminfo(ll_icode, this.il_currrow, ls_errtext) then
			ls_titleerrtext = "Item Validation"
			li_errcode = -1
		end if
	else
		il_errcode = -1
	end if
	this.ib_itemvalidated = true
	if lb_invalidrow = true then
		il_errcode = -1
	elseif il_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
	end if
	return il_errcode

// w_advancepurchase.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to 1 step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_advancepurchase.wf_purchaseslip() returns 0
	long ll_invcode
	if this.tab_retrieve.selectedtab = 2 then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
		openwithparm(w_purinv_slip, ll_invcode)
	end if

// w_advancepurchase.wf_releaselock(long al_icode) returns boolean
	boolean retflag = true
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM godowndetail WITH ( NOLOCK ) WHERE godowndetail.Gcode =:this.ii_purchasegodownoption AND godowndetail.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_advancepurchase.wf_applycurrency(double ad_conversionfactor) returns long
	long ll_detail_rowcount
	long ll_counter
	long ll_packunits
	long ll_retcode
	long ll_icode
	integer li_retmsgcode
	double ld_saleprice
	double ld_foreignprice
	double ld_newprice
	double ld_purprice
	ll_detail_rowcount = this.id_detail.rowcount()
	ll_retcode = 1
	if ll_detail_rowcount > 0 then
		wf_deleteemptydetailrow()
		ll_detail_rowcount = this.id_detail.rowcount()
		for ll_counter = 1 to ll_detail_rowcount
			ll_icode = this.id_detail.object.icode[ll_counter]
			ld_purprice = this.id_detail.object.purprice[ll_counter]
			ld_foreignprice = this.id_detail.object.foreignprice[ll_counter]
			ll_packunits = this.id_detail.object.packunits[ll_counter]
			if ll_packunits = 0 or isnull(ll_packunits) then
				ll_packunits = 1
			end if
			if wf_getitemsaleprice(ll_icode, ld_saleprice) = true then
				choose case this.ii_purchasetype
				case 1
					ld_newprice = round(ld_foreignprice * ad_conversionfactor, 2)
				case else
					ld_newprice = round(ld_foreignprice * ad_conversionfactor, 2)
				end choose
				if ll_retcode = 1 then
					this.id_detail.object.purprice[ll_counter] = ld_newprice
				end if
			else
				ll_retcode = 0
				exit
			end if
		next
	end if
	wf_grandtotal()
	return ll_retcode

// w_advancepurchase.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_listdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_list.dataobject = as_listdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)

// w_advancepurchase.wf_fetchserverdate(boolean ab_checked) returns long
	if ab_checked then
		this.ib_fetchserverdate = true
	else
		this.ib_fetchserverdate = false
	end if
	return 0

// w_advancepurchase.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_advancepurchase.wf_findsuppcode(string as_aliasname, integer ai_suppcode) returns integer
	integer li_suppcode
	integer ll_retflag
	string ls_itemname
	SQL SELECT accounts.acccode INTO :li_suppcode FROM accounts , supplier WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =supplier.suppcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_suppcode = li_suppcode
		if isnull(ai_suppcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_advancepurchase.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_advancepurchase.wf_getitemsaleprice(long al_icode, double ad_saleprice) returns boolean
	boolean retflag = true
	SQL SELECT item.salePrice INTO :ad_saleprice FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if isnull(ad_saleprice) then
		ad_saleprice = 0
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_advancepurchase.wf_getpomanfcode(long al_pocode, long al_manfcode) returns 0
	al_pocode = this.id_master.object.pocode[this.id_master.getrow()]
	al_manfcode = this.id_master.object.manfcode[this.id_master.getrow()]

// w_advancepurchase.wf_initmodify(integer ai_protect) returns 0
	long ll_purinvcode
	long ll_gcode
	long ll_icode
	long ll_counter = 1
	long ll_packunits
	string ls_batch
	string ls_itemtotalval
	datetime ld_expiry
	double ld_saleprice
	double ld_avgprice
	double ld_packsalestax
	double ld_looseqty
	double ld_stock
	double ld_packqty
	double ld_bonusqty
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_purinvcode = this.id_master.getitemnumber(1, "code")
		if wf_lockpurchaseinvoice(ll_purinvcode) = 0 then
			for ll_counter = 1 to this.id_detail.rowcount()
				ll_gcode = this.id_detail.getitemnumber(ll_counter, "gcode")
				ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
				ld_looseqty = this.id_detail.getitemnumber(ll_counter, "looseqty")
				ld_packqty = this.id_detail.getitemnumber(ll_counter, "packqty")
				ld_bonusqty = this.id_detail.getitemnumber(ll_counter, "bonusqty")
				ll_packunits = this.id_detail.getitemnumber(ll_counter, "packunits")
				SQL Select item.saleprice , item.avgprice , item.packsalestax INTO :ld_saleprice, :ld_avgprice, :ld_packsalestax From Item Where item.icode =:ll_icode USING this.it_transobject;
				ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
				this.id_detail.setitem(ll_counter, "itemtotalval", ls_itemtotalval)
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					ai_protect = 0
					choose case this.ii_purchasetype
					case 1
						this.id_footer.setitem(ll_counter, "stock", ld_stock - ld_looseqty - ld_packqty * ll_packunits + ld_bonusqty * ll_packunits)
					case else
						this.id_footer.setitem(ll_counter, "stock", ld_stock - ld_looseqty - ld_packqty * ll_packunits + ld_bonusqty)
					end choose
				end if
			next
			if ai_protect = 0 then
				this.id_footer.setitem(1, "stock", this.id_footer.getitemnumber(1, "stock"))
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
				SQL Select item.saleprice , item.avgprice , item.packsalestax INTO :ld_saleprice, :ld_avgprice, :ld_packsalestax From Item Where item.icode =:ll_icode USING this.it_transobject;
				this.id_footer.object.t_rpp.text = string(ld_saleprice)
				this.id_footer.object.t_avgprice.text = string(ld_avgprice)
			end if
		end if
		return
	end if
	ai_protect = 1

// w_advancepurchase.wf_isinvoiceinuse(long al_invoiceno) returns boolean
	long ll_found
	SQL Select count ( *) INTO :ll_found From AdvPurHeader Where AdvPurInvCode =:al_invoiceno and Posted ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_found = 0 or isnull(ll_found) then
			SQL Select count ( *) INTO :ll_found From AdvPurHeader With ( ReadPast , RowLock , UpdLock ) Where AdvPurInvCode =:al_invoiceno USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ll_found = 0 then
					return true
				else
					return false
				end if
			else
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_advancepurchase.wf_iteminfo(long al_icode, long al_gcode, double ad_purprice, double ad_discperc, double ad_avgprice, long al_packunits, double al_packsalestax, double al_gstperc, double ad_saleprice) returns boolean
	boolean retflag = true
	SQL SELECT 1 , item.salePrice , item.purdiscperc , item.avgprice , item.packunits , item.saleprice , item.packsalestax , item.gstperc1 INTO :al_gcode, :ad_purprice, :ad_discperc, :ad_avgprice, :al_packunits, :ad_saleprice, :al_packsalestax, :al_gstperc FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if al_packunits < 1 or isnull(al_packunits) then
		al_packunits = 1
	end if
	al_gcode = this.ii_purchasegodownoption
	if isnull(ad_purprice) then
		ad_purprice = 0
	elseif isnull(ad_discperc) then
		ad_discperc = 0
	elseif isnull(ad_avgprice) then
		ad_avgprice = 0
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_advancepurchase.wf_itempurchasehistory() returns 0
	s_itempurchasehistory ls_itempurchasehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itempurchasehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itempurchasehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itempurchasehistory, ls_itempurchasehistory)
	end if

// w_advancepurchase.wf_lockpurchaseinvoice(long al_purinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From AdvPurHeader WITH ( UPDLOCK HOLDLOCK ) Where AdvPurHeader.Advpurinvcode =:al_purinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_advancepurchase.wf_lockpurinvoices(long al_sinvcode, long al_linvcode) returns integer
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM AdvPurHeader WITH ( UPDLOCK HOLDLOCK ) WHERE AdvPurHeader.advpurinvcode Between :al_sinvcode and :al_linvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_advancepurchase.wf_populatedetaildwfrompo(long al_pocode, long al_manfcode) returns integer
	datastore lds_podetail
	datawindowchild ldc_itemdddw
	long ll_detailrows
	long ll_count
	integer li_result
	integer li_rtncode
	boolean populateflag = true
	double ld_godownstock
	double ld_allgodownstock
	string ls_errortext
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_retrievecount
	long ll_lockedcount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packsalestax
	double ld_gstperc
	double ld_stock
	string ls_fullcode
	if this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate Purchase order after posting!")
		return 0
	end if
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 and not isnull(this.id_detail.object.icode[1]) then
		li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
		if li_result = 1 then
			for ll_count = 1 to ll_detailrows
				this.id_detail.deleterow(0)
			next
			if this.id_detail.update() <> 1 then
				messagebox("DataBase Problem", "Problem in Deleting Rows")
				return 0
			end if
			this.id_detail.reset()
		else
			populateflag = false
		end if
	end if
	if populateflag = true then
		lds_podetail = create datastore
		lds_podetail.dataobject = "d_populatepurorder"
		lds_podetail.settransobject(this.it_transobject)
		this.id_detail.reset()
		ll_rtcode = lds_podetail.retrieve(al_pocode)
		ll_rowcount = lds_podetail.rowcount()
		if ll_rowcount > 0 then
			this.id_master.object.currencycode[1] = lds_podetail.object.currencycode[1]
			this.id_master.object.conversionfactor[1] = lds_podetail.object.conversionfactor[1]
		end if
		for ll_count = 1 to ll_rowcount
			this.id_detail.insertrow(0)
			ll_icode = lds_podetail.object.icode[ll_count]
			ll_gcode = lds_podetail.object.gcode[ll_count]
			this.id_detail.object.icode[ll_count] = ll_icode
			this.id_detail.object.fullcode[ll_count] = lds_podetail.object.fullcode[ll_count]
			this.id_detail.object.alternatecustomicode[ll_count] = lds_podetail.object.alternatecustomicode[ll_count]
			this.id_detail.object.packunits[ll_count] = lds_podetail.object.packunits[ll_count]
			if wf_inititeminfo(ll_icode, ll_count, ls_errortext) then
				this.id_detail.object.icode[ll_count] = ll_icode
				ll_gcode = this.ii_purchasegodownoption
				this.id_detail.object.gcode[ll_count] = ll_gcode
				this.id_detail.object.batch[ll_count] = f_stringpreferences("defaultbatch")
				this.id_detail.object.expiry[ll_count] = f_datepreferences("defaultexpiry")
				this.id_detail.object.packqty[ll_count] = lds_podetail.object.reqqty[ll_count]
				this.id_detail.object.alternatecustomicode[ll_count] = lds_podetail.object.alternatecustomicode[ll_count]
				this.id_detail.object.packunits[ll_count] = lds_podetail.object.packunits[ll_count]
				if f_stringpreferences("bonusinpurchase") = "Y" then
					this.id_detail.object.bonusqty[ll_count] = lds_podetail.object.reqbonusqty[ll_count]
				end if
				this.id_detail.object.foreignprice[ll_count] = lds_podetail.object.foreignprice[ll_count]
				if f_stringpreferences("salepriceinpackpur") = "Y" then
					this.id_detail.object.purprice[ll_count] = lds_podetail.object.saleprice[ll_count]
				else
					this.id_detail.object.purprice[ll_count] = lds_podetail.object.rate[ll_count]
				end if
				this.id_detail.object.discperc[ll_count] = lds_podetail.object.discperc[ll_count]
				this.id_detail.object.discperc2[ll_count] = lds_podetail.object.discperc2[ll_count]
				this.id_detail.setitemstatus(ll_count, "purprice", primary!, notmodified!)
				ll_retrievecount = ll_retrievecount + 1
			else
				messagebox("Database Error", ls_errortext)
			end if
		next
		destroy lds_podetail
	end if
	if ll_retrievecount = ll_rowcount then
		messagebox("Result", "Purchase Order retrieval is Successfull~n~r" + string(ll_rowcount) + " Items are retrieved. ")
	else
		messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_retrievecount) + " records are retrieved successfully~n~r" + string(ll_rowcount - ll_retrievecount) + " records are in error")
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_advancepurchase.wf_populatefiltereditems() returns integer
	datastore lds_itemselected
	long ll_detailrows
	long ll_count
	long ll_duplrows
	integer li_result
	integer li_rtncode
	boolean populateflag = true
	s_arguements lstr_selecteditems
	string ls_itemtotalval
	double ld_godownstock
	double ld_allgodownstock
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_retrievecount
	long ll_lockedcount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packsalestax
	double ld_gstperc
	double ld_stock
	string ls_fullcode
	if this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate items after posting!")
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		if not isnull(this.id_detail.object.icode[1]) then
			li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
			if li_result = 1 then
				for ll_count = 1 to ll_detailrows
					this.id_detail.deleterow(0)
				next
				if this.id_detail.update() <> 1 then
					messagebox("DataBase Problem", "Problem in Deleting Rows")
					return 0
				end if
			else
				populateflag = false
			end if
		else
			this.id_detail.reset()
		end if
	end if
	if populateflag = true then
		openwithparm(w_arg_item_populate3, this.ii_module)
		lstr_selecteditems = message.powerobjectparm
		this.id_detail.reset()
		lds_itemselected = create datastore
		if lstr_selecteditems.s_name2 = "OR" then
			lds_itemselected.dataobject = "d_populateditems_active"
		else
			lds_itemselected.dataobject = "d_populateditems_active_and"
		end if
		lds_itemselected.settransobject(this.it_transobject)
		this.id_detail.reset()
		ll_rtcode = lds_itemselected.retrieve(lstr_selecteditems.ia_integerlist, lstr_selecteditems.ia_integerlist1, lstr_selecteditems.ia_integerlist2, lstr_selecteditems.la_longlist, lstr_selecteditems.l_code1, lstr_selecteditems.s_name1)
		ll_rowcount = lds_itemselected.rowcount()
		for ll_count = 1 to ll_rowcount
			ll_icode = lds_itemselected.object.icode[ll_count]
			if wf_genfullcode(ll_icode, ls_fullcode) > 0 then
				this.id_detail.insertrow(0)
				this.id_detail.object.icode[ll_count] = ll_icode
				ll_gcode = lds_itemselected.object.gcode[ll_count]
				if isnull(ll_gcode) then
					this.id_detail.object.gcode[ll_count] = this.ii_purchasegodownoption
					ll_gcode = this.ii_purchasegodownoption
				else
					this.id_detail.object.gcode[ll_count] = ll_gcode
				end if
				this.id_detail.object.fullcode[ll_count] = ls_fullcode
				this.id_detail.object.itemname[ll_count] = lds_itemselected.object.name[ll_count]
				this.id_detail.object.batch[ll_count] = f_stringpreferences("defaultbatch")
				this.id_detail.object.expiry[ll_count] = f_datepreferences("defaultexpiry")
				this.id_detail.object.saleprice[ll_count] = lds_itemselected.object.saleprice[ll_count]
				this.id_detail.object.rate[ll_count] = lds_itemselected.object.rate[ll_count]
				if this.ii_purchasetype = 1 then
					this.id_detail.object.packqty[ll_count] = lds_itemselected.object.qty[ll_count]
					this.id_detail.object.salepriceforitem[ll_count] = lds_itemselected.object.saleprice[ll_count]
				else
					this.id_detail.object.looseqty[ll_count] = lds_itemselected.object.qty[ll_count]
				end if
				if f_stringpreferences("salepriceinpackpur") = "Y" then
					if this.ii_purchasetype = 1 then
						this.id_detail.object.purprice[ll_count] = lds_itemselected.object.saleprice[ll_count]
					else
						this.id_detail.object.purprice[ll_count] = lds_itemselected.object.saleprice[ll_count] / lds_itemselected.object.packunits[ll_count]
					end if
				elseif this.ii_purchasetype = 1 then
					this.id_detail.object.purprice[ll_count] = lds_itemselected.object.rate[ll_count]
				else
					this.id_detail.object.purprice[ll_count] = lds_itemselected.object.rate[ll_count] / lds_itemselected.object.packunits[ll_count]
				end if
				this.id_detail.object.unitsalestax[ll_count] = lds_itemselected.object.packsalestax[ll_count]
				this.id_detail.object.gstperc[ll_count] = lds_itemselected.object.gstperc[ll_count]
				this.id_detail.object.discperc[ll_count] = lds_itemselected.object.discperc[ll_count]
				this.id_detail.object.avgprice[ll_count] = lds_itemselected.object.avgprice[ll_count]
				this.id_detail.object.packunits[ll_count] = lds_itemselected.object.packunits[ll_count]
				this.id_detail.object.packingdesc[ll_count] = lds_itemselected.object.packingdesc[ll_count]
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
				this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
				ls_itemtotalval = string(lds_itemselected.object.saleprice[ll_count], "######0.00") + " + " + string(lds_itemselected.object.packsalestax[ll_count], "######0.00") + " =  " + string(lds_itemselected.object.saleprice[ll_count] + lds_itemselected.object.packsalestax[ll_count], "#####0.00")
				this.id_detail.object.stock[ll_count] = ld_godownstock
				this.id_detail.object.totalstock[ll_count] = ld_allgodownstock
				this.id_detail.object.itemtotalval[ll_count] = ls_itemtotalval
				this.id_footer.object.stock[ll_count] = ld_godownstock
				this.id_footer.object.totalstock[ll_count] = ld_allgodownstock
				this.id_footer.object.itemtotalval[ll_count] = ls_itemtotalval
				if this.it_transobject.sqlcode = -1 then
					messagebox("Database Error", "Database Error: Item information can not be retrieved")
				end if
				this.id_detail.setitemstatus(ll_count, "purprice", primary!, notmodified!)
				ll_retrievecount = ll_retrievecount + 1
			else
				messagebox("Database Error", "Can not generate item FullCode")
			end if
		next
		destroy lds_itemselected
		if ll_retrievecount = ll_rowcount then
			messagebox("Result", string(ll_rowcount) + " Items are populated. ")
		else
			messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " records are retrieved successfully~n~r" + string(ll_duplrows) + " records are duplicate so are not retrieved~n~r" + string(ll_lockedcount) + " records are in error")
		end if
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_advancepurchase.wf_populatepurorder() returns integer
	boolean populateflag = true
	string ls_itemtotalval
	string ls_fullcode
	integer li_result
	integer li_rtncode
	long ll_detailrows
	long ll_count
	long ll_duplrows
	long ll_purordercount
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_retrievecount
	long ll_lockedcount
	double ld_godownstock
	double ld_allgodownstock
	double ld_stock
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packsalestax
	double ld_gstperc
	double ld_unitsalestax
	datastore lds_itemselected
	s_saletemplate lstr_template
	if this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate items after posting!")
		return 0
	end if
	setpointer(hourglass!)
	this.id_detail.setredraw(false)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		if not isnull(this.id_detail.object.icode[1]) then
			li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
			if li_result = 1 then
				for ll_count = 1 to ll_detailrows
					this.id_detail.deleterow(0)
				next
				if this.id_detail.update() <> 1 then
					messagebox("DataBase Problem", "Problem in Deleting Rows")
					return 0
				end if
			else
				populateflag = false
			end if
		else
			this.id_detail.reset()
		end if
	end if
	if populateflag = true then
		open(w_copypurinvoicefrom)
		lstr_template = message.powerobjectparm
		if lstr_template.b_userinput = true then
			setpointer(hourglass!)
			lds_itemselected = create datastore
			lds_itemselected.dataobject = "d_populatepurorder"
			lds_itemselected.settransobject(this.it_transobject)
			this.id_detail.reset()
			ll_rtcode = lds_itemselected.retrieve(lstr_template.l_invtemplate)
			ll_rowcount = lds_itemselected.rowcount()
			ll_gcode = this.ii_purchasegodownoption
			if this.ii_purchasetype = 1 then
				this.id_master.setitem(this.id_master.getrow(), "pocode", lstr_template.l_invtemplate)
				this.id_master.setitem(this.id_master.getrow(), "podate", datetime(lstr_template.d_date))
			end if
			for ll_count = 1 to ll_rowcount
				this.id_detail.insertrow(0)
				ll_icode = lds_itemselected.object.icode[ll_count]
				this.id_detail.object.icode[ll_count] = ll_icode
				if this.ii_purchasegodownoption = 2 then
					ll_gcode = lds_itemselected.object.gcode[ll_count]
				end if
				this.id_detail.object.gcode[ll_count] = ll_gcode
				this.id_detail.object.fullcode[ll_count] = lds_itemselected.object.fullcode[ll_count]
				this.id_detail.object.itemname[ll_count] = lds_itemselected.object.itemname[ll_count]
				this.id_detail.object.batch[ll_count] = "."
				this.id_detail.object.saleprice[ll_count] = lds_itemselected.object.saleprice[ll_count]
				this.id_detail.object.rate[ll_count] = lds_itemselected.object.rate[ll_count]
				if this.ii_purchasetype = 1 then
					this.id_detail.object.packqty[ll_count] = lds_itemselected.object.qty[ll_count]
				else
					this.id_detail.object.looseqty[ll_count] = lds_itemselected.object.qty[ll_count] * lds_itemselected.object.packunits[ll_count]
				end if
				this.id_detail.object.expiry[ll_count] = datetime(date("12/12/2010"))
				if f_stringpreferences("salepriceinpackpur") = "Y" then
					if this.ii_purchasetype = 1 then
						this.id_detail.object.purprice[ll_count] = lds_itemselected.object.saleprice[ll_count]
					else
						this.id_detail.object.purprice[ll_count] = lds_itemselected.object.saleprice[ll_count] / lds_itemselected.object.packunits[ll_count]
					end if
				elseif this.ii_purchasetype = 1 then
					this.id_detail.object.purprice[ll_count] = lds_itemselected.object.rate[ll_count]
				else
					this.id_detail.object.purprice[ll_count] = lds_itemselected.object.rate[ll_count] / lds_itemselected.object.packunits[ll_count]
				end if
				if this.ii_purchasetype = 1 then
					this.id_detail.object.unitsalestax[ll_count] = lds_itemselected.object.packsalestax[ll_count]
					this.id_detail.object.discperc[ll_count] = lds_itemselected.object.discperc[ll_count]
				else
					ld_unitsalestax = round(lds_itemselected.object.packsalestax[ll_count] / lds_itemselected.object.packunits[ll_count], 2)
					this.id_detail.object.unitsalestax[ll_count] = ld_unitsalestax
				end if
				this.id_detail.object.gstperc[ll_count] = lds_itemselected.object.gstperc[ll_count]
				this.id_detail.object.avgprice[ll_count] = lds_itemselected.object.avgprice[ll_count]
				this.id_detail.object.packunits[ll_count] = lds_itemselected.object.packunits[ll_count]
				this.id_detail.object.packingdesc[ll_count] = lds_itemselected.object.packingdesc[ll_count]
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
				this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
				ls_itemtotalval = string(lds_itemselected.object.saleprice[ll_count], "######0.00") + " + " + string(lds_itemselected.object.packsalestax[ll_count], "######0.00") + " =  " + string(lds_itemselected.object.saleprice[ll_count] + lds_itemselected.object.packsalestax[ll_count], "#####0.00")
				this.id_detail.object.stock[ll_count] = ld_godownstock
				this.id_detail.object.totalstock[ll_count] = ld_allgodownstock
				this.id_detail.object.itemtotalval[ll_count] = ls_itemtotalval
				this.id_footer.object.stock[this.id_footer.getrow()] = ld_godownstock
				this.id_footer.object.totalstock[this.id_footer.getrow()] = ld_allgodownstock
				if this.it_transobject.sqlcode = -1 then
					messagebox("Database Error", "Database Error: Item stock information can not be retrieved")
				end if
				this.id_detail.setitemstatus(ll_count, "purprice", primary!, notmodified!)
				ll_retrievecount = ll_retrievecount + 1
			next
			destroy lds_itemselected
		end if
		if ll_retrievecount = ll_rowcount then
			messagebox("Result", string(ll_rowcount) + " Items are populated. ")
		else
			messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " records are retrieved successfully~n~r" + string(ll_duplrows) + " records are duplicate so are not retrieved~n~r" + string(ll_lockedcount) + " records are in error")
		end if
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_advancepurchase.wf_replacesalediscperc(long al_icode, double ad_discperc) returns integer
	if f_numberpreferences("PurReplaceItemSalediscNo") = 1 then
		SQL update Item SET saleDiscPerc =:ad_discperc WHERE Item.icode =:al_icode USING this.it_transobject;
		return this.it_transobject.sqlcode
	end if
	if f_numberpreferences("PurReplaceItemSalediscNo") = 2 then
		SQL update Item SET saleDiscPerc2 =:ad_discperc WHERE Item.icode =:al_icode USING this.it_transobject;
		return this.it_transobject.sqlcode
	end if
	if f_numberpreferences("PurReplaceItemSalediscNo") = 3 then
		SQL update Item SET saleDiscPerc3 =:ad_discperc WHERE Item.icode =:al_icode USING this.it_transobject;
		return this.it_transobject.sqlcode
	end if
	if f_numberpreferences("PurReplaceItemSalediscNo") = 4 then
		SQL update Item SET saleDiscPerc4 =:ad_discperc WHERE Item.icode =:al_icode USING this.it_transobject;
		return this.it_transobject.sqlcode
	end if
	if f_numberpreferences("PurReplaceItemSalediscNo") = 5 then
		SQL update Item SET saleDiscPerc5 =:ad_discperc WHERE Item.icode =:al_icode USING this.it_transobject;
		return this.it_transobject.sqlcode
	end if

// w_advancepurchase.wf_retrievelist() returns long
	string[] ls_posted
	long ll_rtcode
	ls_posted[1] = "N"
	if this.ib_showinvoicelist then
		ll_rtcode = this.id_list.retrieve(ls_posted, this.il_groupcode, this.ii_module)
	else
		ll_rtcode = -1
	end if
	return ll_rtcode

// w_advancepurchase.wf_retrievelistall() returns long
	string[] ls_posted
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	return this.id_list.retrieve(ls_posted, this.il_groupcode, this.ii_module)

// w_advancepurchase.wf_setamountoninvoice() returns 0
	long ll_null
	long ll_rightfound
	double ld_netamt
	double ld_null
	string ls_null
	s_amountoninvoice lstr_amountoninvoice
	setnull(ld_null)
	setnull(ls_null)
	setnull(ll_null)
	if this.id_master.getitemstring(1, "accountfor") = "Y" then
		ld_netamt = wf_grandtotal()
		if f_stringpreferences("AskAmtOnPurchase") = "Y" then
			ll_rightfound = 0
			ll_rightfound = gds_securitywindow.find("rightcode = 584", 1, gds_securitywindow.rowcount())
			lstr_amountoninvoice.l_invcode = this.id_master.getitemnumber(1, "code")
			lstr_amountoninvoice.d_netamt = ld_netamt
			lstr_amountoninvoice.d_amt = this.id_master.getitemdecimal(1, "amt")
			if isnull(lstr_amountoninvoice.d_amt) then
				lstr_amountoninvoice.d_balance = ld_netamt
			else
				lstr_amountoninvoice.d_balance = ld_netamt - lstr_amountoninvoice.d_amt
			end if
			if isnull(this.id_master.getitemstring(1, "paymentmode")) then
				this.id_master.setitem(1, "paymentmode", f_stringpreferences("PurchasePaymentMode"))
				this.id_master.setitem(1, "paymentacccode", f_numberpreferences("PurchasePaymentAcccode"))
			end if
			lstr_amountoninvoice.c_paymentmode = this.id_master.getitemstring(1, "paymentmode")
			lstr_amountoninvoice.i_acccode = this.id_master.getitemnumber(1, "paymentacccode")
			lstr_amountoninvoice.s_reference = this.id_master.getitemstring(1, "amtreference")
			lstr_amountoninvoice.s_module = "purchase"
			if ll_rightfound > 0 then
				openwithparm(w_amountoninvoice, lstr_amountoninvoice)
				lstr_amountoninvoice = message.powerobjectparm
				this.id_master.setitem(1, "amt", lstr_amountoninvoice.d_amt)
				this.id_master.setitem(1, "paymentmode", lstr_amountoninvoice.c_paymentmode)
				this.id_master.setitem(1, "paymentacccode", lstr_amountoninvoice.i_acccode)
				this.id_master.setitem(1, "amtreference", lstr_amountoninvoice.s_reference)
			end if
			if ld_netamt - lstr_amountoninvoice.d_amt >= 0.0 then
				this.id_master.setitem(1, "outstandingamt", ld_netamt - lstr_amountoninvoice.d_amt)
			else
				this.id_master.setitem(1, "outstandingamt", 0)
			end if
		else
			this.id_master.setitem(1, "outstandingamt", ld_netamt)
			this.id_master.setitem(1, "paymentmode", ls_null)
			this.id_master.setitem(1, "paymentacccode", ll_null)
			this.id_master.setitem(1, "amtreference", ls_null)
			this.id_master.setitem(1, "amt", 0)
		end if
		return
	end if
	this.id_master.setitem(1, "outstandingamt", 0)
	this.id_master.setitem(1, "paymentmode", ls_null)
	this.id_master.setitem(1, "paymentacccode", ll_null)
	this.id_master.setitem(1, "amtreference", ls_null)
	this.id_master.setitem(1, "amt", 0)

// w_advancepurchase.wf_setcurrency(long al_currencycode) returns long
	long ll_currow
	long ll_retcode
	double ld_conversionfactor
	SQL SELECT ConversionFactor INTO :ld_conversionfactor FROM Currency WHERE Currency.Currencycode =:al_currencycode USING this.it_transobject;
	ll_retcode = 1
	if this.it_transobject.sqlcode = 0 then
		if ld_conversionfactor < 0.0 then
			ll_retcode = 0
		else
			ll_currow = this.id_master.getrow()
			ll_currow = 1
			this.id_master.object.conversionfactor[ll_currow] = ld_conversionfactor
			if wf_applycurrency(ld_conversionfactor) <= 0 then
				ll_retcode = 0
			end if
		end if
	else
		ll_retcode = 0
	end if
	wf_grandtotal()
	return ll_retcode

// w_advancepurchase.wf_setgodownoption() returns 0
	this.ii_purchasegodownoption = this.id_detail.getitemnumber(1, "gcode")
	if this.il_strategy = 2 or this.il_strategy = 1 and this.il_godowncount = 1 then
		this.id_detail.object.gcode.protect = 1
		this.id_detail.object.gcode.background.color = this.backcolor
	end if

// w_advancepurchase.wf_setpurchasetype(integer ai_purchasetype) returns 0
	if ai_purchasetype <= 2 then
		this.ii_purchasetype = ai_purchasetype
		return
	end if
	if ai_purchasetype = 7 then
		this.ii_purchasetype = 7
		return
	end if
	this.ii_purchasetype = 1

// w_advancepurchase.wf_setpurorderinfo(long al_purordercode) returns long
	long ll_suppcode
	long ll_salesmancode
	long ll_row
	long ll_manfcode = 1
	integer li_rtcode
	datetime ld_podate
	string ls_podate
	string ls_manfname
	SQL SELECT purorderheader.manfcode , purorderheader.suppcode , purorderheader.date INTO :ll_manfcode, :ll_suppcode, :ld_podate FROM purorderheader WHERE purorderheader.pocode =:al_purordercode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Cannot Connect to Database", this.it_transobject.sqlerrtext)
		li_rtcode = -1
	end if
	if isnull(ll_manfcode) then
		ll_manfcode = 1
	end if
	SQL SELECT manufacturer.name INTO :ls_manfname FROM manufacturer WHERE manufacturer.manfcode =:ll_manfcode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Cannot Connect to Database", this.it_transobject.sqlerrtext)
		li_rtcode = -1
	end if
	ll_row = this.id_master.getrow()
	ll_row = 1
	this.id_master.object.suppcode[ll_row] = ll_suppcode
	this.id_master.object.podate[ll_row] = ld_podate
	this.id_master.object.manfname[ll_row] = ls_manfname
	this.id_master.object.manfcode[ll_row] = ll_manfcode
	wf_setsuppinfo(ll_suppcode, this.id_master)
	return ll_manfcode

// w_advancepurchase.wf_setquantity() returns 0
	long ll_rows
	long ll_counter
	long ll_qty
	if this.id_master.object.posted[this.id_master.rowcount()] = "Y" then
		messagebox("Set Quantity Problem", "You can not set quantity after posting.")
		return
	end if
	ll_rows = this.id_detail.rowcount()
	if ll_rows > 0 then
		openwithparm(w_setquantity, ll_qty)
		ll_qty = message.doubleparm
		if ll_qty > 0 then
			for ll_counter = 1 to ll_rows
				this.id_detail.setitem(ll_counter, "looseqty", ll_qty)
			next
		end if
	end if

// w_advancepurchase.wf_updateitemavgprice(long al_icode, double ad_newavgprice) returns boolean
	boolean retflag = true
	SQL update item SET item.avgprice =:ad_newavgprice WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_advancepurchase.wf_updateitempurdisc(long al_icode, double ad_disc) returns integer
	SQL update Item SET PurDiscPerc =:ad_disc WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_advancepurchase.wf_updaterecentpurprice(long al_icode, double ad_rpp) returns integer
	SQL update Item SET recentpurprice5 =recentpurprice4 , recentpurprice4 =recentpurprice3 , recentpurprice3 =recentpurprice2 , recentpurprice2 =recentpurprice , recentpurprice =:ad_rpp , ChangeReason ='Multiple Changes' , Module ='Adv.Pur/Posting' WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_advancepurchase.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	return true

// w_advancepurchase.wf_selectprintreport(string as_pagesize) returns string
	string ls_report
	if as_pagesize = "F" then
		if gs_company = "MIANELECTRONICS" then
			ls_report = "d_mianelectronics_purchaseinvreportstock"
		elseif gs_company = "HASEENSUPERMRKT" then
			ls_report = "d_hasensupermart_advpurcinvreportstock"
		elseif gs_company = "ALQADEEROIL" then
			ls_report = "d_alqadeeroil_advpurcinvreportstock"
		else
			ls_report = "d_advpurcinvreportstock"
		end if
	elseif as_pagesize = "H" then
		ls_report = "d_advpurcinvreportstock_half"
	elseif as_pagesize = "Q" then
		if gs_company = "AGHASUPERMARK" then
			ls_report = "d_agha_advpurinvoice_quarter"
		else
			ls_report = "d_agha_advpurinvoice_quarter"
		end if
	end if
	this.id_print.dataobject = ls_report
	this.id_print.settransobject(this.it_transobject)
	return ls_report

// w_advancepurchase.wf_post() returns boolean
	integer li_postingmode = 1
	long ll_sinvcode
	long ll_linvcode
	setnull(ll_sinvcode)
	setnull(ll_linvcode)
	return wf_post_adv_purchase(li_postingmode, ll_sinvcode, ll_linvcode)

// w_advancepurchase.wf_saveandpost() returns 0
	integer li_postingmode = 2
	long ll_sinvcode
	long ll_linvcode
	boolean lb_commitflag = true
	event ue_save()
	if this.ib_commitok then
		ll_sinvcode = this.id_master.getitemnumber(1, "code")
		ll_linvcode = this.id_master.getitemnumber(1, "code")
		if isnull(ll_sinvcode) or isnull(ll_linvcode) or ll_sinvcode < 0 and ll_linvcode < 0 then
			return
		else
			lb_commitflag = wf_post_adv_purchase(li_postingmode, ll_sinvcode, ll_linvcode)
		end if
	end if
	setpointer(arrow!)

// w_advancepurchase.wf_inititeminfo(long al_icode, long al_row, string as_errortext) returns boolean
	boolean retflag = true
	string ls_fullcode
	string ls_name
	string ls_itemtotalval
	string ls_packingdesc
	string ls_remarks
	string ls_alternatecustomicode
	string ls_null
	char lc_confirmexpiry = "N"
	integer li_gcode
	long ll_packunits
	long ll_measureunitcode
	double ld_purprice
	double ld_discperc
	double ld_saleprice
	double ld_avgprice
	double ld_discountedsaleprice
	double ld_packsalestax
	double ld_gstperc
	double ld_rpp
	double ld_retailprice
	double ld_fp
	double ld_conversionfactor
	double ld_unitsalestax
	double ld_rpp2
	double ld_rpp3
	double ld_rpp4
	double ld_rpp5
	double ld_measureqty
	double ld_godownstock
	double ld_allgodownstock
	double ld_purflatdisc
	datetime ldt_expiry
	setnull(ldt_expiry)
	setnull(ls_null)
	SQL SELECT item.customicode , item.name , item.purprice , item.packunits , item.purdiscperc , item.gcode , item.saleprice , item.avgprice , item.packsalestax , item.gstperc1 , item.recentpurprice , Round ( item.packsalestax / item.packunits , 2 ) , item.recentpurprice2 , recentpurprice3 , recentpurprice4 , recentpurprice5 , item.packingdesc , item.measureunitcode , Item.RetailPrice , measureqty =ISNULL ( ( SELECT m.measureqty FROM MeasuringUnit M WHERE m.measureunitcode =item.measureunitcode ) , 1 ) , item.remarks , item.purflatdisc , item.foreignprice , item.discountedsaleprice , item.confirmexpiry INTO :ls_fullcode, :ls_name, :ld_purprice, :ll_packunits, :ld_discperc, :li_gcode, :ld_saleprice, :ld_avgprice, :ld_packsalestax, :ld_gstperc, :ld_rpp, :ld_unitsalestax, :ld_rpp2, :ld_rpp3, :ld_rpp4, :ld_rpp5, :ls_packingdesc, :ll_measureunitcode, :ld_retailprice, :ld_measureqty, :ls_remarks, :ld_purflatdisc, :ld_fp, :ld_discountedsaleprice, :lc_confirmexpiry FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	ld_conversionfactor = this.id_master.object.conversionfactor[1]
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.ii_defaultgcode = this.id_detail.getitemnumber(al_row, "gcode")
	else
		if this.il_strategy = 2 then
			this.ii_defaultgcode = li_gcode
		end if
		if this.il_strategy = 1 then
			this.ii_defaultgcode = this.id_detail.getitemnumber(al_row, "gcode")
		end if
	end if
	ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
	this.it_transobject.getitemstocktotal(this.ii_defaultgcode, al_icode, ld_godownstock)
	this.it_transobject.getitemstockinallowedgodown(al_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	ls_alternatecustomicode = this.id_detail.object.alternatecustomicode[al_row]
	if isnull(ls_alternatecustomicode) then
		ls_alternatecustomicode = ""
	end if
	if lower(ls_fullcode) = lower(ls_alternatecustomicode) then
		ls_alternatecustomicode = ls_null
		this.id_detail.object.alternatecustomicode[al_row] = ls_null
	end if
	this.id_detail.setitem(al_row, "gcode", this.ii_defaultgcode)
	this.id_detail.setitem(al_row, "icode", al_icode)
	this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
	this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
	this.id_detail.setitem(al_row, "measureunitcode", ll_measureunitcode)
	this.id_detail.setitem(al_row, "measureqty", ld_measureqty)
	this.id_detail.setitem(al_row, "basicpackunits", ll_packunits)
	if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) or this.id_detail.object.packunits[al_row] <= 0 then
		this.id_detail.setitem(al_row, "packunits", ll_packunits)
	end if
	if this.ii_purchasetype = 1 then
		this.id_detail.setitem(al_row, "discperc", ld_discperc)
	end if
	this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
	this.id_detail.setitem(al_row, "rate", ld_purprice)
	this.id_detail.setitem(al_row, "retailprice", ld_retailprice)
	this.id_detail.setitem(al_row, "discountedsaleprice", ld_discountedsaleprice)
	this.id_detail.setitem(al_row, "itemtotalval", ls_itemtotalval)
	this.id_detail.setitem(al_row, "stock", ld_godownstock)
	this.id_detail.setitem(al_row, "totalstock", ld_allgodownstock)
	this.id_detail.setitem(al_row, "packingdesc", ls_packingdesc)
	this.id_detail.setitem(al_row, "itemflatdisc2", ld_purflatdisc)
	if upper(lc_confirmexpiry) = "Y" then
		this.id_detail.setitem(al_row, "expiry", ldt_expiry)
	end if
	this.id_footer.object.t_rpp.text = string(ld_rpp) + " , " + string(ld_rpp2) + " , " + string(ld_rpp3) + " , " + string(ld_rpp4) + " , " + string(ld_rpp5)
	this.id_footer.object.t_avgprice.text = string(ld_avgprice)
	choose case this.ii_purchasetype
	case 1
		if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) then
			if f_stringpreferences("salepriceinpackpur") = "Y" then
				this.id_detail.setitem(al_row, "purprice", ld_saleprice)
			else
				this.id_detail.setitem(al_row, "purprice", ld_purprice)
			end if
		end if
		this.id_detail.setitem(al_row, "salepriceforitem", ld_saleprice)
		this.id_detail.setitem(al_row, "unitsalestax", ld_packsalestax)
		this.id_detail.setitem(al_row, "foreignprice", ld_fp)
		if ld_fp <> 0.0 then
			if f_stringpreferences("salepriceinpackpur") = "Y" then
				this.id_detail.setitem(al_row, "purprice", ld_saleprice)
			else
				this.id_detail.setitem(al_row, "purprice", ld_fp * ld_conversionfactor)
			end if
		end if
	case 7
		if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) then
			if f_stringpreferences("priceinloosepur") = "Y" then
				this.id_detail.setitem(al_row, "purprice", ld_purprice / ll_packunits)
			else
				this.id_detail.setitem(al_row, "purprice", ld_saleprice / ll_packunits)
			end if
		end if
		this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
		this.id_detail.setitem(al_row, "foreignprice", ld_fp)
		if ld_fp <> 0.0 then
			this.id_detail.setitem(al_row, "purprice", ld_fp * ld_conversionfactor)
		end if
	case else
		this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
		if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) then
			this.id_detail.setitem(al_row, "purprice", ld_purprice / ll_packunits)
		end if
		this.id_detail.setitem(al_row, "foreignprice", ld_fp)
		if ld_fp <> 0.0 then
			this.id_detail.setitem(al_row, "purprice", ld_fp * ld_conversionfactor)
		end if
	end choose
	this.id_detail.setitem(al_row, "discountedpurprice", ld_purprice * (1.0 - ld_discperc * 0.01))
	wf_set_po_values(al_row)
	if f_stringpreferences("ShowMeasuringUnitInAdvPur") = "Y" then
		wf_apply_measureunit(ll_measureunitcode, al_row)
	end if
	if f_stringpreferences("pur_copyremarksinitemdesc") = "Y" and this.id_detail.getitemstatus(al_row, "itemdescription", primary!) = notmodified! then
		this.id_detail.setitem(al_row, "itemdescription", ls_remarks)
	end if
	this.id_detail.setitem(al_row, "gstperc", ld_gstperc)
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_allgodownstock)
	this.id_footer.setitem(1, "itemtotalval", ls_itemtotalval)
	wf_set_itemimage(al_icode)
	return retflag

// w_advancepurchase.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_itemleveltax
	double ld_invgstpercval
	double ld_totalsalestax
	double ld_invgstperc1
	double ld_totvalforinvgst
	double ld_netrate
	double ld_discaftersaletax
	double ld_discperc
	double ld_flatdisc
	double ld_flatdisc2
	double ld_misccharges
	double ld_misccharges2
	double ld_flatincometax
	double ld_invpercincometax
	double ld_flatadditionaltax
	double ld_invpercadditionaltax
	double ld_flatextratax
	double ld_invpercextratax
	double ld_flatcustomduty
	double ld_invperccustomduty
	double ld_flatexciseduty
	double ld_invpercexciseduty
	double ld_freightlocal
	double ld_freightforeign
	double ld_itemstotal
	double ld_itemgrossvalue
	double ld_grossvalue
	double ld_invlevelvalue
	double ld_discpercvalue
	long ll_counter
	long ll_packunits
	double ld_totqty
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		ld_discperc = this.id_footer.getitemnumber(1, "discperc")
		ld_flatdisc = this.id_footer.getitemnumber(1, "flatdisc")
		ld_flatdisc2 = this.id_footer.getitemnumber(1, "flatdisc2")
		ld_misccharges = this.id_footer.getitemnumber(1, "misccharges")
		ld_misccharges2 = this.id_footer.getitemnumber(1, "misccharges2")
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "d_detaildwtotal")
		ld_totvalforinvgst = this.id_detail.getitemnumber(1, "c_totvalforinvgst")
		ld_discaftersaletax = this.id_detail.getitemnumber(1, "c_tot_discount_after_saletax")
		ld_discpercvalue = ld_detaildwtotal * ld_discperc * 0.01
		ld_invgstperc1 = this.id_footer.getitemnumber(1, "invgstperc1")
		ld_itemleveltax = this.id_detail.object.c_sumtaxval[1] + this.id_detail.object.c_sumgstval[1]
		ld_invgstpercval = (ld_totvalforinvgst * (1.0 - 0.01 * ld_discperc) - ld_flatdisc - ld_flatdisc2) * 0.01 * ld_invgstperc1
		ld_totalsalestax = ld_invgstpercval + ld_itemleveltax
		ld_flatincometax = this.id_footer.getitemnumber(1, "flatincometax")
		ld_invpercincometax = round(ld_detaildwtotal * 0.01 * this.id_footer.getitemnumber(1, "percincometax"), 2)
		ld_flatadditionaltax = this.id_footer.getitemnumber(1, "flatadditionaltax")
		ld_invpercadditionaltax = round(ld_detaildwtotal * 0.01 * this.id_footer.getitemnumber(1, "percadditionaltax"), 2)
		ld_flatextratax = this.id_footer.getitemnumber(1, "flatextratax")
		ld_invpercextratax = round(ld_detaildwtotal * 0.01 * this.id_footer.getitemnumber(1, "percextratax"), 2)
		ld_flatcustomduty = this.id_footer.getitemnumber(1, "flatcustomduty")
		ld_invperccustomduty = round(ld_detaildwtotal * 0.01 * this.id_footer.getitemnumber(1, "perccustomduty"), 2)
		ld_flatexciseduty = this.id_footer.getitemnumber(1, "flatexciseduty")
		ld_invpercexciseduty = round(ld_detaildwtotal * 0.01 * this.id_footer.getitemnumber(1, "percexciseduty"), 2)
		ld_freightlocal = this.id_footer.getitemnumber(1, "freightlocal")
		ld_freightforeign = this.id_footer.getitemnumber(1, "freightforeign")
		ld_grandtotal = ld_detaildwtotal * (1.0 - ld_discperc * 0.01) - ld_discaftersaletax - ld_flatdisc - ld_flatdisc2 + ld_misccharges + ld_misccharges2 + ld_flatincometax + ld_invpercincometax + ld_flatadditionaltax + ld_invpercadditionaltax + ld_flatextratax + ld_invpercextratax + ld_flatcustomduty + ld_invperccustomduty + ld_flatexciseduty + ld_invpercexciseduty + ld_freightlocal + ld_freightforeign
		ld_grandtotal = round(ld_grandtotal + ld_totalsalestax, 0)
		this.id_footer.setitem(1, "total", ld_grandtotal)
		ld_detaildwtotal = this.id_footer.getitemnumber(1, "total")
		ld_invlevelvalue = ld_invgstpercval + ld_misccharges + ld_misccharges2 - ld_flatdisc - ld_flatdisc2 - ld_discpercvalue + ld_flatincometax + ld_invpercincometax + ld_flatadditionaltax + ld_invpercadditionaltax + ld_flatextratax + ld_invpercextratax + ld_flatcustomduty + ld_invperccustomduty + ld_flatexciseduty + ld_invpercexciseduty + ld_freightlocal + ld_freightforeign
		if ld_invlevelvalue = 0.0 or isnull(ld_invlevelvalue) then
			ld_invlevelvalue = 0
		end if
		ld_grossvalue = this.id_detail.object.c_total_finalitemval[1]
		if ld_grossvalue = 0.0 or isnull(ld_grossvalue) then
			ld_grossvalue = 1
		end if
		for ll_counter = 1 to this.id_detail.rowcount()
			ld_totqty = this.id_detail.object.packqty[ll_counter] + this.id_detail.object.bonusqty[ll_counter]
			if ld_totqty = 0.0 or isnull(ld_totqty) then
				ld_totqty = 1
			end if
			ld_itemgrossvalue = this.id_detail.object.c_finalitemval[ll_counter]
			ld_netrate = (ld_itemgrossvalue / ld_grossvalue * ld_invlevelvalue + ld_itemgrossvalue) / ld_totqty
			this.id_detail.object.netrate[ll_counter] = round(ld_netrate, 5)
		next
	end if
	return ld_grandtotal

// w_advancepurchase.wf_allowpurchasemodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM AdvPurDetail WHERE AdvPurInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_advancepurchase.wf_apply_advancepurchase_pref() returns 0
	if f_stringpreferences("ShowCDiscPercInAdvPur") = "N" then
		this.id_detail.object.cdiscperc.visible = false
	end if
	if f_stringpreferences("ShowCDiscPerc2InAdvPur") = "N" then
		this.id_detail.object.cdiscperc2.visible = false
	end if
	if f_stringpreferences("ShowCDiscPerc3InAdvPur") = "N" then
		this.id_detail.object.cdiscperc3.visible = false
	end if
	if f_stringpreferences("advpur_showinvflatincometax") = "N" then
		this.id_footer.object.flatincometax.visible = false
		this.id_footer.object.flatincometax_t.visible = false
	end if
	if f_stringpreferences("advpur_showinvpercincometax") = "N" then
		this.id_footer.object.percincometax.visible = false
		this.id_footer.object.percincometax_t.visible = false
	end if
	if f_stringpreferences("advpur_showinvpercincometax") = "N" and f_stringpreferences("advpur_showinvflatincometax") = "N" then
		this.id_footer.object.gb_incometax.visible = false
	end if
	if f_stringpreferences("advpur_showinvflatadditionaltax") = "N" then
		this.id_footer.object.flatadditionaltax.visible = false
		this.id_footer.object.flatadditionaltax_t.visible = false
	end if
	if f_stringpreferences("advpur_showinvpercadditionaltax") = "N" then
		this.id_footer.object.percadditionaltax.visible = false
		this.id_footer.object.percadditionaltax_t.visible = false
	end if
	if f_stringpreferences("advpur_showinvflatadditionaltax") = "N" and f_stringpreferences("advpur_showinvpercadditionaltax") = "N" then
		this.id_footer.object.gb_additionaltax.visible = false
	end if
	if f_stringpreferences("advpur_showinvflatextratax") = "N" then
		this.id_footer.object.flatextratax.visible = false
		this.id_footer.object.flatextratax_t.visible = false
	end if
	if f_stringpreferences("advpur_showinvpercextratax") = "N" then
		this.id_footer.object.percextratax.visible = false
		this.id_footer.object.percextratax_t.visible = false
	end if
	if f_stringpreferences("advpur_showinvflatextratax") = "N" and f_stringpreferences("advpur_showinvpercextratax") = "N" then
		this.id_footer.object.gb_extratax.visible = false
	end if
	if f_stringpreferences("advpur_showinvflatcustomduty") = "N" then
		this.id_footer.object.flatcustomduty.visible = false
		this.id_footer.object.flatcustomduty_t.visible = false
	end if
	if f_stringpreferences("advpur_showinvperccustomduty") = "N" then
		this.id_footer.object.perccustomduty.visible = false
		this.id_footer.object.perccustomduty_t.visible = false
	end if
	if f_stringpreferences("advpur_showinvflatcustomduty") = "N" and f_stringpreferences("advpur_showinvperccustomduty") = "N" then
		this.id_footer.object.gb_customduty.visible = false
	end if
	if f_stringpreferences("advpur_showinvflatexciseduty") = "N" then
		this.id_footer.object.flatexciseduty.visible = false
		this.id_footer.object.flatexciseduty_t.visible = false
	end if
	if f_stringpreferences("advpur_showinvpercexciseduty") = "N" then
		this.id_footer.object.percexciseduty.visible = false
		this.id_footer.object.percexciseduty_t.visible = false
	end if
	if f_stringpreferences("advpur_showinvflatexciseduty") = "N" and f_stringpreferences("advpur_showinvpercexciseduty") = "N" then
		this.id_footer.object.gb_exciseduty.visible = false
	end if
	if f_stringpreferences("advpur_showinvfreightlocal") = "N" then
		this.id_footer.object.freightlocal.visible = false
		this.id_footer.object.freightlocal_t.visible = false
	end if
	if f_stringpreferences("advpur_showinvfreightforeign") = "N" then
		this.id_footer.object.freightforeign.visible = false
		this.id_footer.object.freightforeign_t.visible = false
	end if
	if f_stringpreferences("advpur_showinvfreightlocal") = "N" and f_stringpreferences("advpur_showinvfreightforeign") = "N" then
		this.id_footer.object.gb_freight.visible = false
	end if
	if f_stringpreferences("FlatDisc2InAdvPur") = "N" then
		this.id_footer.object.flatdisc2.visible = false
		this.id_footer.object.flatdisc2_t.visible = false
	end if
	if f_stringpreferences("MiscCharges2InAdvPur") = "N" then
		this.id_footer.object.misccharges2.visible = false
		this.id_footer.object.misccharges2_t.visible = false
	end if
	if f_stringpreferences("PurPrice2InAdvPur") = "N" then
		this.id_detail.object.purprice2.visible = false
	end if
	if f_stringpreferences("PurPrice3InAdvPur") = "N" then
		this.id_detail.object.purprice3.visible = false
	end if
	if f_stringpreferences("PurPrice4InAdvPur") = "N" then
		this.id_detail.object.purprice4.visible = false
	end if
	if f_stringpreferences("TotPurPriceInAdvPur") = "N" then
		this.id_detail.object.c_totalprice.visible = false
	end if
	if f_stringpreferences("ItemFlatDiscInAdvPur") = "N" then
		this.id_detail.object.itemflatdisc.visible = false
	end if
	if f_stringpreferences("itmflatdisaftdisprcinadvpur") = "N" then
		this.id_detail.object.itemflatdiscafterdiscperc.visible = false
	end if
	if f_stringpreferences("discountedpurpriceinadvpur") = "N" then
		this.id_detail.object.discountedpurprice.visible = false
	end if
	if f_stringpreferences("advpur_showunitincometaxrule") = "N" then
		this.id_detail.object.unitincometaxrulecode.visible = false
	end if
	if isnull(f_numberpreferences("advpur_defaultunitincometaxrule")) then
		this.id_detail.object.unitincometaxrulecode.initial = "4"
	else
		this.id_detail.object.unitincometaxrulecode.initial = trim(string(f_numberpreferences("advpur_defaultunitincometaxrule")))
	end if
	if f_stringpreferences("advpur_showunitincometax") = "N" then
		this.id_detail.object.unitincometax.visible = false
	end if
	if f_stringpreferences("advpur_showpercincometaxrule") = "N" then
		this.id_detail.object.percincometaxrulecode.visible = false
	end if
	if isnull(f_numberpreferences("advpur_defaultpercincometaxrule")) then
		this.id_detail.object.percincometaxrulecode.initial = "4"
	else
		this.id_detail.object.percincometaxrulecode.initial = trim(string(f_numberpreferences("advpur_defaultpercincometaxrule")))
	end if
	if f_stringpreferences("advpur_showpercincometax") = "N" then
		this.id_detail.object.percincometax.visible = false
	end if
	if f_stringpreferences("advpur_showunitincometax") = "N" and f_stringpreferences("advpur_showpercincometax") = "N" then
		this.id_detail.object.c_incometaxvalue.visible = false
	end if
	if f_stringpreferences("advpur_showunitadditionaltaxrule") = "N" then
		this.id_detail.object.unitadditionaltaxrulecode.visible = false
	end if
	if isnull(f_numberpreferences("advpur_defaultunitadditionaltaxrule")) then
		this.id_detail.object.unitadditionaltaxrulecode.initial = "4"
	else
		this.id_detail.object.unitadditionaltaxrulecode.initial = trim(string(f_numberpreferences("advpur_defaultunitadditionaltaxrule")))
	end if
	if f_stringpreferences("advpur_showunitadditionaltax") = "N" then
		this.id_detail.object.unitadditionaltax.visible = false
	end if
	if f_stringpreferences("advpur_showpercadditionaltaxrule") = "N" then
		this.id_detail.object.percadditionaltaxrulecode.visible = false
	end if
	if isnull(f_numberpreferences("advpur_defaultpercadditionaltaxrule")) then
		this.id_detail.object.percadditionaltaxrulecode.initial = "4"
	else
		this.id_detail.object.percadditionaltaxrulecode.initial = trim(string(f_numberpreferences("advpur_defaultpercadditionaltaxrule")))
