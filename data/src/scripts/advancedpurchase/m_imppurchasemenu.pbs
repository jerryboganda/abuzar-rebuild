// menu m_imppurchasemenu (advancedpurchase)  ancestor: m_multi_entry

// m_imppurchasemenu.create() returns 0 [event]
	m_imppurchasemenu = this
	call super::create

// m_imppurchasemenu.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_open = create m_open
	this.m_populateitems = create m_populateitems
	this.m_savepost = create m_savepost
	this.m_itempurchasehistory = create m_itempurchasehistory
	this.m_setquantity = create m_setquantity
	this.m_purchaseslip = create m_purchaseslip
	this.m_setserverdate = create m_setserverdate
	this.m_finalize = create m_finalize
	this.m_re-calculate = create m_re-calculate
	this.item[upperbound(this.item) + 1] = this.m_open
	this.item[upperbound(this.item) + 1] = this.m_populateitems
	this.item[upperbound(this.item) + 1] = this.m_savepost
	this.item[upperbound(this.item) + 1] = this.m_itempurchasehistory
	this.item[upperbound(this.item) + 1] = this.m_setquantity
	this.item[upperbound(this.item) + 1] = this.m_purchaseslip
	this.item[upperbound(this.item) + 1] = this.m_setserverdate
	this.item[upperbound(this.item) + 1] = this.m_finalize
	this.item[upperbound(this.item) + 1] = this.m_re-calculate

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_open
	destroy this.m_populateitems
	destroy this.m_savepost
	destroy this.m_itempurchasehistory
	destroy this.m_setquantity
	destroy this.m_purchaseslip
	destroy this.m_setserverdate
	destroy this.m_finalize
	destroy this.m_re-calculate

// m_save.create() returns 0 [event]
	call super::create

// m_save.destroy() returns 0 [event]
	call super::destroy

// m_save.clicked() returns 0 [event]
	if f_stringpreferences("PurchaseAutoPosting") = "Y" then
		this.parentwindow.dynamic wf_saveandpost()
	else
		this.parentwindow.triggerevent("ue_save")
	end if
	if this.parentwindow.dynamic wf_commitform() = true then
		this.parentwindow.postevent("ue_new")
	end if

// m_options.clicked() returns 0 [event]
	call super::clicked
	this.parentwindow.dynamic wf_populatepurorder()

// m_options.create() returns 0 [event]
	call super::create
	this.visible = true
	this.text = "Edit Purchase Order"

// m_options.destroy() returns 0 [event]
	call super::destroy

// m_open.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_populatepurorder()

// m_open.create() returns 0 [event]
	call super::create
	this.visible = false
	this.text = "&Open~tCtrl+J"
	this.enabled = false
	this.shortcut = 330

// m_open.destroy() returns 0 [event]
	call super::destroy

// m_populateitems.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_populatefiltereditems()

// m_populateitems.create() returns 0 [event]
	call super::create
	this.text = "Populate Items"

// m_populateitems.destroy() returns 0 [event]
	call super::destroy

// m_savepost.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_saveandpost()
	if this.parentwindow.dynamic wf_commitform() = true then
		this.parentwindow.postevent("ue_new")
	end if

// m_savepost.create() returns 0 [event]
	call super::create
	this.visible = false
	this.text = "Save And Post~tCtrl+Q"
	this.enabled = false
	this.checked = true
	this.shortcut = 337

// m_savepost.destroy() returns 0 [event]
	call super::destroy

// m_itempurchasehistory.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_itempurchasehistory()

// m_itempurchasehistory.create() returns 0 [event]
	call super::create
	this.visible = false
	this.text = "Item Purchase History~tCtrl+H"
	this.enabled = false
	this.shortcut = 328

// m_itempurchasehistory.destroy() returns 0 [event]
	call super::destroy

// m_setquantity.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_setquantity()

// m_setquantity.create() returns 0 [event]
	call super::create
	this.visible = false
	this.text = "Set Q&uantity~tCtrl+U"
	this.enabled = false
	this.shortcut = 341

// m_setquantity.destroy() returns 0 [event]
	call super::destroy

// m_purchaseslip.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_purchaseslip()

// m_purchaseslip.create() returns 0 [event]
	call super::create
	this.text = "Purchase Slip~tCtrl+M"
	this.shortcut = 333

// m_purchaseslip.destroy() returns 0 [event]
	call super::destroy

// m_setserverdate.clicked() returns 0 [event]
	if this.checked then
		this.checked = false
	else
		this.checked = true
	end if
	this.parentwindow.dynamic wf_fetchserverdate(this.checked)

// m_setserverdate.create() returns 0 [event]
	call super::create
	this.text = "Set Server Date"
	this.checked = true

// m_setserverdate.destroy() returns 0 [event]
	call super::destroy

// m_finalize.create() returns 0 [event]
	call super::create
	this.text = "Finalize"
	this.toolbaritemname = "Move!"
	this.toolbaritemtext = "Finalize Imported Purchases"
	this.toolbaritemorder = 11

// m_finalize.destroy() returns 0 [event]
	call super::destroy

// m_finalize.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_finalize()

// m_re-calculate.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_grandtotal_withnetrate()

// m_re-calculate.create() returns 0 [event]
	call super::create
	this.text = "Re-Calculate~tCtrl+F8"
	this.shortcut = 375

// m_re-calculate.destroy() returns 0 [event]
	call super::destroy
