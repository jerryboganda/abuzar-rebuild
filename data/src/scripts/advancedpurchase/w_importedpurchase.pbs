// w_importedpurchase.wf_check_group_import_exp_template() returns long
	long ll_counter
	long ll_temp_rows
	long ll_insrow
	datastore lds_template
	lds_template = create datastore
	lds_template.dataobject = "d_groupwiseimpexptemplate"
	lds_template.settransobject(sqlca)
	lds_template.retrieve(this.il_groupcode)
	ll_temp_rows = lds_template.rowcount()
	if ll_temp_rows > 0 then
		return 0
	end if
	return -1

// w_importedpurchase.wf_update_expenseratio() returns long
	double ld_freightlocal
	double ld_freightforeign
	double ld_totalexp
	double ld_totpurprice
	double ld_expperc
	double[] ld_exppercarr
	long ll_counter
	long ll_rows
	double ld_totqty
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		ld_totalexp = this.id_footer.getitemnumber(1, "c_localexptotal")
		ld_expperc = this.id_master.getitemnumber(1, "c_expenseperc")
		this.id_master.object.totalexpenses[1] = ld_totalexp
		ll_rows = this.id_detail.rowcount()
		for ll_counter = 1 to ll_rows
			ld_exppercarr[ll_counter] = ld_expperc
		next
		this.id_detail.object.expenseperc[1, ll_rows] = ld_exppercarr
	end if
	return 0

// w_importedpurchase.wf_grandtotal_withnetrate() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_itemleveltax
	double ld_invgstpercval
	double ld_totalsalestax
	double ld_invgstperc1
	double ld_totvalforinvgst
	double ld_netrate
	double ld_discaftersaletax
	double ld_discperc
	double ld_itemstotal
	double ld_itemgrossvalue
	double ld_grossvalue
	double ld_invlevelvalue
	double ld_totalexp
	double ld_totpurprice
	double ld_expperc
	long ll_counter
	double ld_totqty
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "d_detaildwtotal")
		ld_totvalforinvgst = this.id_detail.getitemnumber(1, "c_totvalforinvgst")
		ld_discaftersaletax = this.id_detail.getitemnumber(1, "c_tot_discount_after_saletax")
		ld_itemleveltax = this.id_detail.object.c_sumtaxval[1] + this.id_detail.object.c_sumgstval[1]
		ld_totalsalestax = ld_invgstpercval + ld_itemleveltax
		ld_grandtotal = ld_detaildwtotal - ld_discaftersaletax
		ld_totalexp = this.id_footer.getitemnumber(1, "c_localexptotal")
		ld_expperc = this.id_master.getitemnumber(1, "c_expenseperc")
		ld_grandtotal = round(ld_grandtotal + ld_totalsalestax + ld_totalexp, 0)
		this.id_master.object.totalexpenses[1] = ld_totalexp
		this.id_master.setitem(1, "invtotal", ld_grandtotal)
		this.id_footer2.setitem(1, "invtotal", ld_grandtotal)
		ld_invlevelvalue = ld_totalexp
		if ld_invlevelvalue = 0.0 or isnull(ld_invlevelvalue) then
			ld_invlevelvalue = 0
		end if
		ld_grossvalue = this.id_detail.object.c_total_finalitemval[1]
		if ld_grossvalue = 0.0 or isnull(ld_grossvalue) then
			ld_grossvalue = 1
		end if
		for ll_counter = 1 to this.id_detail.rowcount()
			ld_totqty = this.id_detail.object.packqty[ll_counter] + this.id_detail.object.bonusqty[ll_counter]
			if ld_totqty = 0.0 or isnull(ld_totqty) then
				ld_totqty = 1
			end if
			ld_itemgrossvalue = this.id_detail.object.c_finalitemval[ll_counter]
			this.id_detail.object.netdiscountedrate[ll_counter] = this.id_detail.object.c_effectiverate[ll_counter]
			ld_netrate = (ld_itemgrossvalue / ld_grossvalue * ld_invlevelvalue + ld_itemgrossvalue) / ld_totqty
			this.id_detail.object.netrate[ll_counter] = round(ld_netrate, 5)
			ld_totpurprice = this.id_detail.object.netdiscountedrate[ll_counter]
			this.id_detail.object.salepriceforitem[ll_counter] = round(ld_totpurprice + ld_totpurprice * this.id_detail.object.profitperc[ll_counter] * 0.01 + ld_totpurprice * this.id_detail.object.expenseperc[ll_counter] * 0.01, 2)
		next
	end if
	return ld_grandtotal

// w_importedpurchase.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_imppurchasemenu" then
		this.menuid = create m_imppurchasemenu
	end if
	this.dw_purinvrep = create dw_purinvrep
	this.dw_changeprice_foritemlog = create dw_changeprice_foritemlog
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_purinvrep
	this.control[icurrent + 2] = this.dw_changeprice_foritemlog

// w_importedpurchase.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_purinvrep
	destroy this.dw_changeprice_foritemlog

// w_importedpurchase.ue_save() returns 0 [event]
	double ld_bonusqty
	double ld_looseqty
	double ld_packqty
	integer li_counter = 1
	integer li_option
	long ll_icode
	long ll_salesmancode = 1
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_detailrows
	long ll_count
	long ll_found
	long ll_rightfound
	double ld_saleprice
	double ld_invtotal
	double ld_famt
	double ld_ftot
	string ls_updatepurprice
	boolean lb_commitflag = true
	datetime ldt_expiry
	datetime ldt_server_datetime
	string ls_date_errtext
	date ld_expiry
	string ls_expiry
	ls_expiry = f_stringpreferences("purexpiry")
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		for ll_count = 1 to ll_detailrows
			if ls_expiry = "Y" then
				ldt_expiry = this.id_detail.object.expiry[ll_count]
				ld_expiry = date(ldt_expiry)
				if ld_expiry <= relativedate(today(), f_numberpreferences("AcceptFutureExpiryDays")) then
					li_option = messagebox("Item Validation", "Expiry should be greater than " + string(relativedate(today(), f_numberpreferences("AcceptFutureExpiryDays")), "dd/mmm/yyyy") + "~r~nLine No. " + string(ll_count) + ", Expiry Date = " + string(ld_expiry, "dd/mmm/yyyy") + "~r~nAccept this expiry date?", question!, yesno!, 2)
					if li_option <> 1 then
						if this.ii_purchasetype = 1 then
							this.id_detail.setcolumn("packqty")
						else
							this.id_detail.setcolumn("looseqty")
						end if
						this.id_detail.scrolltorow(ll_count)
						this.id_detail.setfocus()
						return
					end if
					return
				end if
				return
			end if
			ll_found = 0
			if ll_count = ll_detailrows then
				exit
			end if
			ll_found = this.id_detail.find("gcode = long('" + string(this.id_detail.getitemnumber(ll_count, "gcode")) + "') and " + " icode = long('" + string(this.id_detail.getitemnumber(ll_count, "icode")) + "') and " + " suppcode = long('" + string(this.id_detail.getitemnumber(ll_count, "suppcode")) + "') and " + " batch = '" + this.id_detail.getitemstring(ll_count, "batch") + "' and expiry = Date('" + string(this.id_detail.getitemdatetime(ll_count, "expiry"), "yyyy-mm-dd") + "')", ll_count + 1, ll_detailrows)
			if ll_found > 0 then
				messagebox("Item Validation", "Duplicate items found at row " + string(ll_count) + " and " + string(ll_found) + "." + "~r~nSuggested options are either delete the row or ~r~n" + "change Item batch or expiry")
				this.id_detail.scrolltorow(ll_count)
				if this.ii_purchasetype = 1 then
					this.id_detail.setcolumn("packqty")
				else
					this.id_detail.setcolumn("looseqty")
				end if
				this.id_detail.setfocus()
				return
			end if
		next
	elseif ll_detailrows <= 0 then
		messagebox("On Save Validation", "There are no rows to save.~r~nKindly insert some item row.")
		return
	end if
	wf_grandtotal()
	wf_grandtotal_withnetrate()
	ld_invtotal = this.id_footer2.getitemnumber(1, "invtotal")
	if ld_invtotal < 0.0 then
		messagebox("On Save Validation", "Can not save this purchase invoice.~r~nReason: Grand Total for this Purchase is negative.")
		return
	end if
	if this.id_master.getitemnumber(1, "invtotal") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	if this.id_detail.rowcount() > 0 then
		ld_famt = round(this.id_master.getitemnumber(1, "foreignamt"), 0)
		ld_ftot = round(this.id_detail.getitemnumber(1, "d_detaildwforeigntotal"), 0)
		if abs(ld_famt - ld_ftot) > 10.0 then
			messagebox("Foreign Amount Validation", "Foreign Amount does not match all items foreign value")
			return
		end if
		return
	end if
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if f_stringpreferences("puruserwindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	setfocus()
	if ll_salesmancode > 0 then
		setpointer(hourglass!)
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			f_newtableid("imppurheader", ll_invid)
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
			this.id_master.setitem(ll_mastercurrrow, "usercode", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Posteddate", ldt_server_datetime)
		else
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		end if
		this.id_footer.accepttext()
		this.id_master.accepttext()
		this.id_detail.accepttext()
		wf_grandtotal()
		this.id_master.setitem(1, "invtotal", this.id_footer2.getitemnumber(1, "invtotal"))
		do while li_counter <= ll_detailrows
			this.id_detail.setitem(li_counter, "code", ll_invid)
			ll_icode = this.id_detail.object.icode[li_counter]
			SQL SELECT saleprice INTO :ld_saleprice FROM item WHERE icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = -1 then
				messagebox("DataBase Error", "Problem In retrieving Item Information")
				return
			else
				this.id_detail.setitem(li_counter, "saleprice", ld_saleprice)
			end if
			ld_packqty = this.id_detail.getitemnumber(li_counter, "packqty")
			ld_looseqty = this.id_detail.getitemnumber(li_counter, "looseqty")
			ld_bonusqty = this.id_detail.getitemnumber(li_counter, "bonusqty")
			if ld_packqty + ld_looseqty + ld_bonusqty = 0.0 then
				messagebox("Purchase Qty Validation", "Please enter valid qty")
				if this.ii_purchasetype = 1 then
					this.id_detail.setcolumn("packqty")
				else
					this.id_detail.setcolumn("looseqty")
				end if
				this.id_detail.selecttext(1, 1)
				return
			end if
			if lb_commitflag and this.id_detail.getitemstatus(li_counter, "purprice", primary!) = datamodified! and ls_updatepurprice = "Y" and wf_updateitempurprice(ll_icode, this.id_detail.getitemnumber(li_counter, "purprice")) <> 0 then
				lb_commitflag = false
			end if
			li_counter = li_counter + 1
		loop
		ll_count = 0
		for ll_count = 1 to this.id_footer.rowcount()
			this.id_footer.setitem(ll_count, "code", ll_invid)
		next
		if this.id_master.update(true, false) < 0 then
			SQL rollback USING this.it_transobject;
			setpointer(arrow!)
			return
		end if
		if this.id_footer.update(true, false) < 0 then
			SQL rollback USING this.it_transobject;
			setpointer(arrow!)
			return
		end if
		if this.id_detail.update() > 0 then
			SQL commit USING this.it_transobject;
			messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
			this.ib_commitok = true
			this.id_master.resetupdate()
			this.im_menu.m_file.m_new.enabled = true
			this.editflag = false
			if gd_recenttransdate < this.id_systemdate then
				gd_recenttransdate = this.id_systemdate
			end if
		else
			SQL rollback USING this.it_transobject;
			setpointer(arrow!)
			return
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_importedpurchase.ue_newform() returns 0 [event]
	integer rtncode
	integer ll_counter
	datetime ldt_server_datetime
	string ls_date_errtext
	m_imppurchasemenu lm_menu
	call super::ue_newform
	lm_menu = this.menuid
	setredraw(false)
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 5007 then
			lm_menu.m_file.m_savepost.enabled = true
		end if
	next
	this.id_footer.reset()
	wf_adopt_impexpense_template()
	if this.id_footer.rowcount() <= 0 then
		this.id_footer.insertrow(0)
		this.id_footer.scrolltorow(0)
	end if
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	wf_protectdw(this.id_footer2, 0)
	wf_setgodownoption()
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	setredraw(true)
	this.id_footer2.object.t_rpp.text = ""
	this.id_footer2.object.t_avgprice.text = ""
	if this.ib_modifydate then
		if this.ib_fetchserverdate then
			wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
			this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
		else
			this.id_master.setitem(this.id_master.getrow(), "date", today())
		end if
	end if
	if not wf_validatedate() then
		close(this)
	end if
	this.id_master.object.p_itemimage.filename = ""

// w_importedpurchase.ue_detail() returns 0 [event]
	long ll_code
	long ll_counter
	long ll_found
	integer li_rtncode
	integer li_protect
	m_imppurchasemenu lm_menu
	call super::ue_detail
	lm_menu = this.menuid
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	if this.id_dwcontrol.borderstyle.posted[this.il_selectedrow] = "N" then
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 736", 1, gds_securitywindow.rowcount())
		if ll_found <= 0 then
			messagebox("Invoice Modification", "You can not modify this Imported Purchase Inovice due to No Modification Rights allowed.~r~nKindly consult your system administrator for help.")
			this.tab_retrieve.selecttab(2)
			return
		end if
		return
	end if
	if wf_isinvoiceinuse(ll_code) = true then
		messagebox("Invoice Validation", "Impotred Purchase Invoice already in use by some other user.~r~nKindly try again after sometime or open some other invoice.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	this.id_footer.retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	this.id_footer2.retrieve(ll_code)
	this.id_footer2.setrow(1)
	this.id_footer2.scrolltorow(1)
	if wf_allowpurchasemodification(ll_code, this.il_groupcode, this.il_strategy) <> 0 then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "You Can not modify this Invoice,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	wf_initmodify(li_protect)
	if li_protect = 0 then
		if not this.ib_normalpurmodify and this.ii_purchasetype = 1 then
			li_protect = 1
		end if
		if not this.ib_loosepurmodify and this.ii_purchasetype = 7 then
			li_protect = 1
		end if
		if not this.ib_loosepurmodify and this.ii_purchasetype <> 1 and this.ii_purchasetype = 7 then
			li_protect = 1
		end if
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	wf_protectdw(this.id_footer2, li_protect)
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_purchasegodownoption
	end if
	wf_setgodownoption()
	this.im_menu.m_file.m_save.enabled = false
	if li_protect = 0 then
		this.im_menu.m_file.m_save.enabled = true
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 5007 then
				lm_menu.m_file.m_savepost.enabled = true
			end if
		next
	end if
	if li_protect = 1 then
		this.editflag = false
		this.id_footer2.object.t_rpp.text = ""
		this.id_footer2.object.t_avgprice.text = ""
	end if
	if this.ib_printinvoice then
		this.im_menu.m_file.m_print.enabled = true
	else
		this.im_menu.m_file.m_print.enabled = false
	end if
	wf_grandtotal()
	this.id_master.object.p_itemimage.filename = ""
	setredraw(true)

// w_importedpurchase.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 1 and this.il_currrow <= this.id_detail.rowcount() and vf_dwdupcodebatch(this.id_detail, "gcode", gl_defaultgcode, "icode", this.id_detail.getitemnumber(this.id_detail.getrow(), "icode"), "batch", this.id_detail.getitemstring(this.id_detail.getrow(), "batch"), "expiry", this.id_detail.getitemdatetime(this.id_detail.getrow(), "expiry"), this.il_currrow) = true then
		messagebox("Item Validation", "Duplicate item, please select some other item")
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.settransobject(this.it_transobject)
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	if this.id_detail.getrow() > 1 and this.id_detail.rowcount() > 1 then
		this.id_detail.object.suppcode[this.id_detail.getrow()] = this.id_detail.object.suppcode[this.id_detail.getrow() - 1]
	end if
	this.im_menu.m_file.m_save.enabled = true
	if this.ib_printinvoice then
		this.im_menu.m_file.m_print.enabled = true
	else
		this.im_menu.m_file.m_print.enabled = false
	end if
	this.ib_validatefullcode = true

// w_importedpurchase.ue_deleteitem() returns 0 [event]
	long ll_row
	ll_row = this.id_detail.getrow()
	if this.id_detail.rowcount() > 0 then
		call super::ue_deleteitem
		return
	end if
	this.im_menu.m_file.m_print.enabled = false

// w_importedpurchase.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	destroy this.ids_itemstockinfo
	return ::message.returnvalue

// w_importedpurchase.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_importedpurchase.ue_list() returns 0 [event]
	m_imppurchasemenu lm_menu
	long ll_counter
	call super::ue_list
	lm_menu = this.menuid
	SQL rollback USING this.it_transobject;
	if this.ib_normalpurposting and this.ii_purchasetype = 1 then
		this.im_menu.m_file.m_post.enabled = true
	elseif this.ib_loosepurposting and this.ii_purchasetype = 7 then
		this.im_menu.m_file.m_post.enabled = true
	elseif this.ib_openingpurposting and this.ii_purchasetype = 2 then
		this.im_menu.m_file.m_post.enabled = true
	else
		this.im_menu.m_file.m_post.enabled = false
	end if
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 5007 then
			lm_menu.m_file.m_savepost.enabled = false
		end if
	next
	if this.ib_printinvoice then
		this.im_menu.m_file.m_print.enabled = true
		return
	end if
	this.im_menu.m_file.m_print.enabled = false

// w_importedpurchase.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw

// w_importedpurchase.ue_print() returns 0 [event]
	long ll_invcode
	long ll_suppcode
	long ll_row
	string ls_suppname
	string ls_printbalance
	string ls_invoicesize
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if f_stringpreferences("PurchaseAutoPosting") = "Y" then
			wf_saveandpost()
		else
			triggerevent("ue_save")
		end if
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	wf_selectprintreport()
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.id_print.rowcount() > 0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_importedpurchase.ue_postopen() returns 0 [event]
	datawindowchild ldc_dddpurcategory
	datawindowchild ldc_headerno
	m_imppurchasemenu lm_menu
	datastore lds_headers
	integer li_rtncode
	long ll_code
	long ll_counter
	long ll_found
	call super::ue_postopen
	lm_menu = this.menuid
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	setredraw(false)
	wf_setpurchasetype(integer(message.doubleparm))
	this.id_footer2 = this.tab_retrieve.tabpage_detail.dw_footer2
	this.id_footer2.settransobject(this.it_transobject)
	this.id_print = this.dw_purinvrep
	this.id_print.settransobject(this.it_transobject)
	wf_assigndatawindowobjects("d_ImpPurchaseHeader", "d_ImpPurchaseDetail", "d_ImpPurchaseList", "d_imppurchasefooter", "d_imppurchasefooter2")
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 738 then
			this.ib_normalpurposting = true
			this.im_menu.m_file.m_post.visible = true
			this.im_menu.m_file.m_post.toolbaritemvisible = true
			this.im_menu.m_file.m_post.enabled = false
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 736 then
			this.ib_normalpurmodify = true
		end if
	next
	if not this.ib_normalpurposting then
		this.im_menu.m_file.m_post.visible = false
		this.im_menu.m_file.m_post.toolbaritemvisible = false
		this.im_menu.m_file.m_post.enabled = false
	end if
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 5007 then
			lm_menu.m_file.m_savepost.visible = true
			lm_menu.m_file.m_savepost.enabled = true
		end if
	next
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit to Make Purchase")
		close(this)
		return
	end if
	li_rtncode = this.id_detail.getchild("gcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to Purchase")
		close(this)
		return
	end if
	if wf_check_group_import_exp_template() < 0 then
		messagebox("Group Wise Import Expense Template", "No Group Wise Import Expense Template Associated with this user's Group~r~nKindly associate/allow some template to it and try again.")
		close(this)
		return
	end if
	this.ii_purchasegodownoption = this.idc_godown.getitemnumber(1, "gcode")
	this.id_detail.object.gcode.initial = string(this.ii_purchasegodownoption)
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = false
	this.id_itemslist.object.sstock.visible = false
	this.id_itemslist.object.t_pstock.visible = true
	this.id_itemslist.object.pstock.visible = true
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_detail.object.gcode.visible = false
		this.id_master.object.gcode_t.visible = true
		this.id_master.object.gcode.visible = true
		this.id_master.object.gcode.initial = string(this.ii_purchasegodownoption)
	end if
	if f_stringpreferences("pursuppBalance") = "Y" and (this.ii_purchasetype = 1 or this.ii_purchasetype = 7) then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
	end if
	if f_stringpreferences("packingdescinpurchase") = "N" then
		this.id_detail.object.packingdesc.visible = false
	end if
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.pstock.visible = false
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Purchase")
		close(this)
		return
	end if
	if f_stringpreferences("headeronpurchaseinv") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.headerno_t.visible = false
	end if
	this.id_master.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to lds_headers.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
		ldc_headerno.setitem(ll_counter, "name", "")
		ll_found = 0
		ll_found = gds_reoprtheaderinfo.find("headerno=" + string(lds_headers.getitemnumber(ll_counter, "headercode")), 1, gds_reoprtheaderinfo.rowcount())
		if ll_found > 0 then
			ldc_headerno.setitem(ll_counter, "headeralias", gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks"))
		end if
	next
	this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
	this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
	gd_itemsinfo.sharedata(this.id_itemslist)
	this.id_footer2.insertrow(0)
	this.id_footer2.scrolltorow(0)
	if f_stringpreferences("PurchaseOnZeroprice") = "N" and this.id_detail.setvalidate("purprice", "Number(GetText())>0") <> 1 then
		messagebox("Column Validation", "Unable to set validation expression for column Purchase Price")
		return
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 564", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_showinvoicelist = true
	else
		this.ib_showinvoicelist = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 580", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.date.protect = 0
		this.id_master.object.date.background.color = rgb(255, 255, 255)
		this.ib_modifydate = true
		lm_menu.m_file.m_setserverdate.visible = true
		lm_menu.m_file.m_setserverdate.enabled = true
	end if
	if not this.ib_modifydate then
		this.id_master.object.date.protect = 1
		this.id_master.settaborder("date", 0)
		lm_menu.m_file.m_setserverdate.visible = false
		lm_menu.m_file.m_setserverdate.enabled = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5091", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_itempurchasehistory.visible = true
		lm_menu.m_file.m_itempurchasehistory.enabled = true
	else
		lm_menu.m_file.m_itempurchasehistory.visible = false
		lm_menu.m_file.m_itempurchasehistory.enabled = false
	end if
	this.id_detail.object.batch.initial = f_stringpreferences("defaultbatch")
	this.id_detail.object.expiry.initial = string(f_datepreferences("defaultexpiry"))
	if wf_item_image_setting() < 0 then
		messagebox("Connection Problem", "Problem in connecting database. Kindly Try Again", stopsign!)
		close(this)
	end if
	wf_apply_imported_purchase_rights()
	f_setcolumnstyle(this.id_detail, "Qty")
	wf_set_itemtotal_formatmask()
	if this.ib_finalize then
		lm_menu.m_file.m_finalize.visible = true
		lm_menu.m_file.m_finalize.enabled = true
	else
		lm_menu.m_file.m_finalize.visible = false
		lm_menu.m_file.m_finalize.enabled = false
	end if
	setredraw(true)
	if f_islicenseexpire() = -2 then
		close(this)
	end if

// w_importedpurchase.open() returns long [event]
	m_entry lm_menu
	long ll_width
	long ll_height
	environment env
	postevent("ue_postopen")
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	lm_menu.dynamic mf_initsecurityapp(lm_menu)
	if getenvironment(env) <> 1 then
		return ::message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.tab_retrieve.width = ll_width * 0.99
	this.tab_retrieve.height = ll_height * 0.83
	this.tab_retrieve.tabpage_detail.dw_detail.width = ll_width * 0.98
	this.tab_retrieve.tabpage_detail.dw_itemsdetail.width = ll_width * 0.98
	this.tab_retrieve.tabpage_detail.dw_detail.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width
	this.tab_retrieve.tabpage_detail.dw_footer.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width
	this.tab_retrieve.tabpage_detail.dw_footer2.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width
	this.tab_retrieve.tabpage_detail.dw_itemsdetail.height = this.tab_retrieve.height * 0.90 - this.tab_retrieve.tabpage_detail.dw_itemsdetail.y - this.tab_retrieve.tabpage_detail.dw_footer2.height
	this.tab_retrieve.tabpage_detail.dw_footer2.y = this.tab_retrieve.tabpage_detail.dw_itemsdetail.y + this.tab_retrieve.tabpage_detail.dw_itemsdetail.height + 10
	this.tab_retrieve.tabpage_list.gb_fliter.width = ll_width * 0.97 - this.tab_retrieve.tabpage_list.gb_sort.width
	this.tab_retrieve.tabpage_list.r_1.width = ll_width * 0.99
	this.tab_retrieve.tabpage_list.r_1.height = ll_height * 0.765 - this.tab_retrieve.tabpage_list.gb_sort.height
	this.tab_retrieve.tabpage_list.dw_list.width = ll_width * 0.98
	this.tab_retrieve.tabpage_list.dw_list.height = ll_height * 0.75 - this.tab_retrieve.tabpage_list.dw_list.y
	this.tab_retrieve.tabpage_detail.dw_itemslist.height = ll_height * 0.6
	this.tab_retrieve.tabpage_detail.dw_itemslist.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width * 0.73
	setredraw(true)
	show()
	return ::message.returnvalue

// w_importedpurchase.closequery() returns long [event]
	integer li_yesno
	integer li_rtcode
	if this.editflag = true then
		li_yesno = messagebox("Invoice", "Do You want to save changes", question!, yesnocancel!, 2)
		if li_yesno = 1 then
			triggerevent("ue_save")
			if wf_commitform() = false then
				li_rtcode = 1
			end if
		elseif li_yesno = 2 then
			SQL rollback USING this.it_transobject;
			li_rtcode = 0
		elseif li_yesno = 3 then
			li_rtcode = 1
		end if
	end if
	return li_rtcode

// tabpage_detail.create() returns 0 [event]
	integer icurrent
	this.dw_footer2 = create dw_footer2
	call super::create
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_footer2

// tabpage_detail.destroy() returns 0 [event]
	call super::destroy
	destroy this.dw_footer2

// dw_footer.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	double ld_conversionrate
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	ld_conversionrate = parent.parent.parent.id_master.object.conversionfactor[1]
	choose case dwo.name
	case "foreignamt"
		if double(data) >= 0.0 then
			this.object.localamt[row] = round(ld_conversionrate * double(data), 2)
			parent.parent.parent.wf_grandtotal()
			return 0
		else
			return 1
		end if
	case "localamt"
		if double(data) >= 0.0 then
			if ld_conversionrate <= 0.0 then
				ld_conversionrate = 1
			end if
			this.object.foreignamt[row] = round(double(data) / ld_conversionrate, 2)
			parent.parent.parent.wf_grandtotal()
			return 0
		else
			return 1
		end if
		return
	end choose
	return 0

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
		return 1
	case "misccharges2"
		messagebox("Misc. Charges 2 Validation", "Charges ~"" + data + "~" should be greater equal zero")
		return 1
	case "faltdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
		return 1
	case "faltdisc2"
		messagebox("Flat Dsicount 2 Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
		return 1
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
		return 1
	end choose
	return ::message.returnvalue

// dw_footer.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer currentrow
	integer rt_code
	accepttext()
	currentrow = getrow()
	if key = keyenter! and getcolumnname() = "localamt" and currentrow = rowcount() then
		getparent().dynamic postevent("ue_FocusDetail")
	end if
	if key = keyuparrow! then
		currentrow = getrow()
		if currentrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	end if
	if key = keydownarrow! then
		currentrow = getrow()
		if currentrow = rowcount() then
			getparent().dynamic postevent("ue_FocusDetail")
			rt_code = 1
		end if
	end if
	parent.parent.parent.wf_grandtotal()
	return rt_code

// dw_footer.ue_enterkey() returns long [event]
	accepttext()
	if getcolumnname() = "localamt" and getrow() = rowcount() then
		getparent().dynamic postevent("ue_FocusDetail")
	else
		send(handle(this), 256, 9, long(90))
	end if
	parent.parent.parent.wf_grandtotal()
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_result
	long ll_code
	long ll_manfcode
	long ll_detailrows
	double ld_price
	double ld_rate
	string ls_null
	date ld_null
	dwitemstatus lrs_status
	integer li_res
	integer li_suppcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "suppcode"
		ll_code = long(data)
		parent.parent.parent.wf_setsuppinfo(ll_code, this)
	case "currencycode"
		ll_code = long(data)
		parent.parent.parent.wf_setcurrency(ll_code)
	case "conversionfactor"
		ld_rate = double(data)
		if ld_rate <= 0.0 then
			return 1
		elseif parent.parent.parent.wf_applycurrency(double(data)) <= 0 then
			return 1
		end if
	case "foreignamt"
		if double(data) < 0.0 then
			parent.parent.parent.wf_grandtotal()
			return 1
		end if
	case "aliasname"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findsuppcode(data, li_suppcode)
			if li_res > 0 then
				setitem(row, "suppcode", li_suppcode)
				return 0
			else
				messagebox("Supplier Validation", "Supplier with  AliasName " + data + " does not exist")
				return 1
			end if
			return
		end if
	case "pocode"
		if not isnull(data) and integer(data) <> 0 then
			ll_detailrows = parent.dw_itemsdetail.rowcount()
			if ll_detailrows > 0 then
				lrs_status = parent.dw_itemsdetail.getitemstatus(1, 0, primary!)
				ll_code = long(data)
				ll_manfcode = parent.parent.parent.wf_setpurorderinfo(ll_code)
				parent.parent.parent.im_menu.m_file.m_options.enabled = true
				this.object.suppcode.protect = 1
			end if
		end if
	end choose
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "suppcode"
		messagebox("Supplier Name Validation", "You must select some supplier")
		return 1
	case "currencycode"
		messagebox("Currency Validation", "You must select some valid currency")
		return 1
	case "conversionfactor"
		messagebox("Conversion Factor/Rate Validation", "You must select some valid Conversion Factor/Rate")
		return 1
	end choose
	return ::message.returnvalue

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if string(dwo.name) = "suppcode" then
		parent.parent.parent.id_master.selecttext(1, 40)
	end if
	return ::message.returnvalue

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyenter! and getcolumnname() = "suppcode" then
		parent.parent.parent.id_master.setitem(1, "suppcode", parent.parent.parent.idc_supplierlist.getitemnumber(parent.parent.parent.idc_supplierlist.getrow(), "supplier_suppcode"))
		parent.parent.parent.wf_setsuppinfo(parent.parent.parent.idc_supplierlist.getitemnumber(parent.parent.parent.idc_supplierlist.getrow(), "supplier_suppcode"), this)
	end if
	if key = keyenter! and getcolumnname() = "foreignamt" then
		getparent().dynamic postevent("ue_FocusFooter")
	end if
	return ::message.returnvalue

// dw_detail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	parent.parent.parent.post wf_setsuppname(data)
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_null
	string ls_itemname
	string ls_error
	integer li_errcode
	integer li_packunits
	integer li_retmsgcode
	integer li_option = 2
	datetime ldt_expiry
	date ld_expiry
	time lt_expiry
	long ll_null
	long ll_currentrow
	long ll_icode
	long ll_itemtypecode
	double ld_conversionfactor
	double ld_saleprice
	double ld_newprice
	double ld_netrate
	double ld_totpurprice
	double ld_newqty
	double ld_storedqty
	double ld_stock
	double ld_totqty
	double ld_bonusqty
	double ld_packqty
	double ld_looseqty
	double ld_defaultqty = 1.0
	datawindowchild ldc_items
	dwitemstatus lrs_status
	double ld_godownstock
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	ll_currentrow = getrow()
	lrs_status = getitemstatus(ll_currentrow, 0, primary!)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
		parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		li_errcode = 0
	case "icode"
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	case "bonusqty"
		ld_bonusqty = double(data)
		ld_packqty = getitemnumber(row, "packqty")
		ld_looseqty = getitemnumber(row, "looseqty")
	case "packqty"
		ld_packqty = double(data)
		ld_bonusqty = getitemnumber(row, "bonusqty")
	case "looseqty"
		ld_looseqty = double(data)
		ld_bonusqty = getitemnumber(row, "bonusqty")
	case "gcode"
		accepttext()
		parent.parent.parent.it_transobject.getitemstocktotal(getitemnumber(row, "gcode"), getitemnumber(row, "icode"), ld_godownstock)
		parent.parent.parent.id_footer2.setitem(1, "stock", ld_godownstock)
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname, ll_itemtypecode)
			if li_res > 0 then
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
			else
				messagebox("ItemNumber Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_errcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_errcode = 2
		end if
	case "purprice"
		ll_icode = parent.parent.parent.id_detail.getitemnumber(row, "icode")
		SQL Select item.saleprice , item.packunits INTO :ld_saleprice, :li_packunits From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
		choose case parent.parent.parent.ii_purchasetype
		case 1
			if double(data) > ld_saleprice then
				li_retmsgcode = messagebox("Purchase Validation", "Purchase Price " + data + " is greater than Sale Price~r~n Do you want to continue", question!, yesno!)
				if li_retmsgcode = 1 then
					li_errcode = 0
				else
					li_errcode = 1
				end if
			end if
		case 7
			if double(data) > ld_saleprice / li_packunits then
				li_retmsgcode = messagebox("Purchase Validation", "Purchase Price " + data + " is greater than Sale Price~r~n Do you want to continue", question!, yesno!)
				if li_retmsgcode = 1 then
					li_errcode = 0
				else
					li_errcode = 1
				end if
			end if
		end choose
	case "purprice2", "purprice3", "purprice4"
		ll_icode = parent.parent.parent.id_detail.getitemnumber(row, "icode")
		SQL Select item.saleprice , item.packunits INTO :ld_saleprice, :li_packunits From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
		if double(data) >= 0.0 then
			ld_totpurprice = double(data)
			if dwo.name = "purprice2" then
				ld_totpurprice = ld_totpurprice + this.object.purprice[row] + this.object.purprice3[row] + this.object.purprice4[row]
			elseif dwo.name = "purprice3" then
				ld_totpurprice = ld_totpurprice + this.object.purprice[row] + this.object.purprice2[row] + this.object.purprice4[row]
			elseif dwo.name = "purprice4" then
				ld_totpurprice = ld_totpurprice + this.object.purprice[row] + this.object.purprice2[row] + this.object.purprice3[row]
			else
				ld_totpurprice = ld_totpurprice + this.object.purprice2[row] + this.object.purprice3[row] + this.object.purprice4[row]
			end if
		else
			li_errcode = 1
		end if
		if li_errcode = 0 then
			choose case parent.parent.parent.ii_purchasetype
			case 1
				if ld_totpurprice > ld_saleprice then
					li_retmsgcode = messagebox("Purchase Validation", "Purchase Price " + data + " is greater than Sale Price~r~n Do you want to continue", question!, yesno!)
					if li_retmsgcode = 1 then
						li_errcode = 0
					else
						li_errcode = 1
					end if
				end if
			case 7
				if ld_totpurprice > ld_saleprice / li_packunits then
					li_retmsgcode = messagebox("Purchase Validation", "Purchase Price " + data + " is greater than Sale Price~r~n Do you want to continue", question!, yesno!)
					if li_retmsgcode = 1 then
						li_errcode = 0
					else
						li_errcode = 1
					end if
				end if
			end choose
		end if
	case "foreignprice"
		if double(data) >= 0.0 then
			ll_icode = parent.parent.parent.id_detail.getitemnumber(row, "icode")
			ld_conversionfactor = parent.parent.parent.id_master.getitemnumber(parent.parent.parent.id_master.getrow(), "conversionfactor")
			SQL Select item.saleprice , item.packunits INTO :ld_saleprice, :li_packunits From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			choose case parent.parent.parent.ii_purchasetype
			case 1
				ld_newprice = round(double(data) * ld_conversionfactor, 2)
				if ld_newprice > ld_saleprice then
					li_retmsgcode = messagebox("Purchase Validation", "Purchase Price " + string(double(ld_newprice)) + " is greater than Sale Price~r~n Do you want to continue", question!, yesno!)
					if li_retmsgcode = 1 then
						li_errcode = 0
					else
						li_errcode = 1
					end if
				end if
				if li_errcode = 0 then
					this.object.purprice[row] = ld_newprice
					parent.parent.parent.wf_grandtotal()
				end if
			case else
				ld_newprice = round(double(data) * ld_conversionfactor, 2)
				if ld_newprice > ld_saleprice / li_packunits then
					li_retmsgcode = messagebox("Purchase Validation", "Purchase Price " + string(double(ld_newprice)) + " is greater than Sale Price~r~n Do you want to continue", question!, yesno!)
					if li_retmsgcode = 1 then
						li_errcode = 0
					else
						li_errcode = 1
					end if
				end if
				if li_errcode = 0 then
					this.object.purprice[row] = ld_newprice
					parent.parent.parent.wf_grandtotal()
				end if
			end choose
		else
			li_errcode = 1
		end if
	case "expiry"
		ld_expiry = date(mid(data, 1, 10))
		lt_expiry = time("00:00:00.000000")
		ldt_expiry = datetime(ld_expiry, lt_expiry)
		if li_errcode < 1 and rowcount() > 1 and ldt_expiry <> datetime("00/00/0000, 00:00:00") and not (isnull(this.object.icode[row]) and isnull(this.object.batch[row]) and isnull(this.object.expiry[row])) and vf_dwdupcodebatch(this, "gcode", gl_defaultgcode, "icode", getitemnumber(getrow(), "icode"), "batch", getitemstring(getrow(), "batch"), "expiry", ldt_expiry, parent.parent.parent.il_currrow) = true then
			messagebox("Item Validation", "Duplicate item, please select some other item")
			li_errcode = 1
		end if
	case "unittaxrulecode"
		if long(data) = 4 then
			this.object.unitsalestax[row] = 0
		end if
	case "gstrulecode"
		if long(data) = 4 then
			this.object.gstperc[row] = 0
		end if
	case "unitsalestax"
	case "gstperc"
	case "itemflatdisc"
		if real(data) >= 0.0 then
			if this.object.c_totalprice[row] - real(data) < 0 then
				messagebox("Item Flat Discount Validation", "Item Flat Discount cannot be more than purchase price,~r~nPlease Select Valid Item Flat Discount")
				li_errcode = 1
			end if
		elseif real(data) < 0.0 then
			messagebox("Item Flat Discount Validation", "Please Select Valid Item Flat Discount")
			li_errcode = 1
		end if
	case "itemflatdisc2"
		if real(data) >= 0.0 then
			if this.object.c_total[row] + this.object.c_taxval[row] + this.object.c_gstval[row] - real(data) * this.object.packqty[row] < 0 then
				messagebox("Item Flat Discount 2 Validation", "Item Flat Discount2 cannot be more than purchase value,~r~nPlease Select Valid Item Flat Discount2")
				li_errcode = 1
			end if
		elseif real(data) < 0.0 then
			messagebox("Item Flat Discount 2 Validation", "Please Select Valid Item Flat Discount 2")
			li_errcode = 1
		end if
	case "itemflatdiscafterdiscperc"
		if real(data) >= 0.0 then
			if this.object.c_total[row] + this.object.c_taxval[row] + this.object.c_gstval[row] - real(data) * this.object.packqty[row] < 0 then
				messagebox("Item Flat Discount After Disc. (%) Validation", "Item Flat Discount After Disc. (%) cannot be more than purchase value,~r~nPlease Select Valid Item Flat Discount After Disc. %")
				li_errcode = 1
			end if
		elseif real(data) < 0.0 then
			messagebox("Item Flat Discount After Disc. (%) Validation", "Please Select Valid Item Flat Discount After Disc. %")
			li_errcode = 1
		end if
	case "valuedisconitem"
		if real(data) >= 0.0 then
			if this.object.c_itemtotal_afterdiscperc2[row] - real(data) < 0 then
				messagebox("Item Flat Discount After Disc. (%) Validation", "Item Flat Discount After Disc. (%) cannot be more than purchase value,~r~nPlease Select Valid Item Flat Discount After Disc. %")
				li_errcode = 1
			end if
		elseif real(data) < 0.0 then
			messagebox("Item Flat Discount After Disc. (%) Validation", "Please Select Valid Item Flat Discount After Disc. %")
			li_errcode = 1
		end if
	case "profitperc"
		if double(data) < 0.0 then
			messagebox("Profit Percentage Validation", "Please enter som valid Profit Percentage {Range[0-100]}")
			return 1
		else
			ld_totqty = parent.parent.parent.id_detail.object.packqty[row] + parent.parent.parent.id_detail.object.bonusqty[row]
			if ld_totqty = 0.0 then
				ld_totqty = 1
			end if
			ld_totpurprice = round(parent.parent.parent.id_detail.object.c_finalitemval[row] / ld_totqty, 2)
			parent.parent.parent.id_detail.object.salepriceforitem[row] = ld_totpurprice + ld_totpurprice * double(data) * 0.01 + ld_totpurprice * parent.parent.parent.id_detail.object.expenseperc[row] * 0.01
			return 0
		end if
	case "measureunitcode"
		return parent.parent.parent.wf_apply_measureunit(long(data), row)
	case "measureunitrate"
		if double(data) >= 0.0 then
			if this.object.measureqty[row] > 0 then
				this.object.purprice[row] = round(double(data) / this.object.measureqty[row], 5)
			else
				this.object.purprice[row] = round(double(data), 5)
			end if
			return 0
		else
			return 1
		end if
		return
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ancestorreturnvalue
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "itemname" then
		parent.parent.parent.ib_focusdetail = true
	end if
	parent.parent.parent.wf_grandtotal_withnetrate()
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	double ld_rpp
	double ld_avgprice
	double ld_rpp2
	double ld_rpp3
	double ld_rpp4
	double ld_rpp5
	dwitemstatus lrs_status
	long ll_icode
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if getcolumnname() <> parent.parent.parent.is_columnitemname then
		if rowcount() > 0 and lrs_status <> new! then
			parent.parent.parent.wf_set_itemimage(getitemnumber(currentrow, "icode"))
			parent.parent.parent.id_footer2.setitem(1, "stock", getitemnumber(currentrow, "stock"))
			parent.parent.parent.id_footer2.setitem(1, "totalstock", getitemnumber(currentrow, "totalstock"))
			parent.parent.parent.id_footer2.setitem(1, "itemtotalval", getitemstring(currentrow, "itemtotalval"))
			ll_icode = getitemnumber(getrow(), "icode")
			SQL Select item.recentpurprice , item.avgprice , item.recentpurprice2 , item.recentpurprice3 , item.recentpurprice4 , item.recentpurprice5 INTO :ld_rpp, :ld_avgprice, :ld_rpp2, :ld_rpp3, :ld_rpp4, :ld_rpp5 From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			parent.parent.parent.id_footer2.object.t_rpp.text = string(ld_rpp) + " , " + string(ld_rpp2) + " , " + string(ld_rpp3) + " , " + string(ld_rpp4) + " , " + string(ld_rpp5)
			parent.parent.parent.id_footer2.object.t_avgprice.text = string(ld_avgprice)
		elseif parent.parent.parent.id_footer.getrow() > 0 then
			parent.parent.parent.id_master.object.p_itemimage.filename = ""
			parent.parent.parent.id_footer2.object.t_rpp.text = ""
			parent.parent.parent.id_footer2.object.t_avgprice.text = ""
			parent.parent.parent.id_footer2.setitem(parent.parent.parent.id_footer.getrow(), "icode", 0)
			parent.parent.parent.id_footer2.setitem(parent.parent.parent.id_footer.getrow(), "stock", 0)
			parent.parent.parent.id_footer2.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", 0)
		end if
	end if
	parent.parent.parent.wf_grandtotal_withnetrate()
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal_withnetrate()
	return ::message.returnvalue

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_colname
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	ls_colname = dwo.name
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "fullcode"
		if isnull(data) or data = "" then
			messagebox("Item Code Validation", "Item Code ~"" + data + "~" does not exist")
		end if
		return 1
	case parent.parent.parent.is_columnitemname
		messagebox("Item Validation", "Value required for item in current row")
		return 1
	case "icode"
		messagebox("Item Validation", "Value required for item in current row")
		return 1
	case "bonusqty"
		messagebox("Bonus Qty Validation", "Bonus Qty ~"" + data + "~" should be greater than or equal to zero")
		return 1
	case "discperc", "discperc2"
		messagebox("Item Discount Validation", "Discount ~"" + data + "~" must be betweeen 0 and 100")
		return 1
	case "itemflatdisc", "itemflatdisc2"
		messagebox("Item Flat Discount Validation", "Enter Valid Discount")
		return 1
	case "purprice", "purprice2", "purprice3", "purprice4"
		return 1
	case "gstperc"
		return 1
	case "unitsalestax"
		return 1
	case "expiry"
		return 1
	end choose
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	long ancestorreturnvalue
	if f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanging(long currentrow, long newrow) returns long [event]
	long ancestorreturnvalue
	double ld_packqty
	double ld_looseqty
	double ld_bonusqty
	long ll_icode
	ancestorreturnvalue = super::rowfocuschanging(currentrow, newrow)
	if currentrow > 0 and parent.parent.parent.id_detail.rowcount() > 0 and currentrow <= parent.parent.parent.id_detail.rowcount() then
		ld_packqty = parent.parent.parent.id_detail.getitemnumber(currentrow, "packqty")
		ld_looseqty = parent.parent.parent.id_detail.getitemnumber(currentrow, "looseqty")
		ld_bonusqty = parent.parent.parent.id_detail.getitemnumber(currentrow, "bonusqty")
		ll_icode = parent.parent.parent.id_detail.getitemnumber(currentrow, "icode")
		if ld_packqty + ld_bonusqty + ld_looseqty <= 0.0 and not isnull(ll_icode) then
			messagebox("Purchase Qty Validation", "Please enter valid qty")
			post event ue_focusqty()
			return 1
		end if
		return
	end if
	parent.parent.parent.wf_grandtotal_withnetrate()
	return ::message.returnvalue

// dw_itemsdetail.ue_focusqty() returns 0 [event]
	if parent.parent.parent.ii_purchasetype = 1 then
		parent.parent.parent.id_detail.setcolumn("packqty")
	else
		parent.parent.parent.id_detail.setcolumn("looseqty")
	end if
	parent.parent.parent.id_detail.selecttext(1, len(parent.parent.parent.id_detail.gettext()))
	parent.parent.parent.id_detail.setfocus()

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_icode
	long ll_found
	long ll_rowm
	s_unittaxinputs ls_unittaxinputs
	double ld_valuextax
	if keyflags = 2 and key = keyf5! then
		parent.parent.parent.wf_show_itemgallery()
		rt_code = 1
		return rt_code
	end if
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(99999)
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(1)
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf8! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("namesearch", 1)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf9! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("criteriasearch", 1)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf5! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			parent.parent.parent.wf_open_item_form_popup()
			setfocus()
		elseif key = keyf4! then
			parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
			setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
			setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	elseif key = keydownarrow! then
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_focusfooter")
			rt_code = 1
		end if
	end if
	if getcolumnname() = "unitsalestax" and key = keyf5! then
		accepttext()
		if not isnull(this.object.icode[parent.parent.parent.id_detail.getrow()]) then
			ls_unittaxinputs.l_icode = this.object.icode[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs.d_price = this.object.purprice[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs.d_saleprice = this.object.salepriceforitem[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs.d_unittax = this.object.unitsalestax[parent.parent.parent.id_detail.getrow()]
			openwithparm(w_unittaxcalculator, ls_unittaxinputs)
			ls_unittaxinputs = message.powerobjectparm
			if ls_unittaxinputs.i_status = 1 then
				this.object.unitsalestax[parent.parent.parent.id_detail.getrow()] = ls_unittaxinputs.d_unittax
			end if
			rt_code = 1
		end if
	end if
	return rt_code
