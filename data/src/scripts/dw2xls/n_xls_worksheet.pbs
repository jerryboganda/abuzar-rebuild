// n_xls_worksheet.of_update_y() returns long
	long li_base_row
	long li_max_row
	long li_row
	double ld_row_h
	prepare_y(this.iul_cellstorage)
	get_y_info(this.iul_cellstorage, li_base_row, li_max_row)
	for li_row = li_base_row to li_max_row
		ld_row_h = get_row_height(this.iul_cellstorage, li_row)
		of_set_row_height(li_row, ld_row_h)
	next
	return update_y(this.iul_cellstorage)

// n_xls_worksheet.of_set_point_to_row_zoom(double ad_x, double ad_y) returns 0
	this.id_x_zoom = ad_x
	this.id_y_zoom = ad_y

// n_xls_worksheet.of_begin_band() returns 0
	begin_band(this.iul_cellstorage)

// n_xls_worksheet.of_getexedir() returns string
	string ls_path
	long li_max
	long li_pos
	long apphandle
	classdefinition lcd
	apphandle = handle(getapplication())
	if apphandle = 0 then
		lcd = getclassdefinition()
		ls_path = lcd.getlibraryname()
	else
		ls_path = space(li_max)
		if of_iswidepb() then
			getmodulefilenamew(apphandle, ls_path, li_max)
		else
			getmodulefilenamea(apphandle, ls_path, li_max)
		end if
	end if
	li_pos = pos(reverse(ls_path), "\")
	if li_pos > 0 then
		ls_path = left(ls_path, len(ls_path) - li_pos)
	else
		ls_path = "."
	end if
	return ls_path

// n_xls_worksheet.of_iswidepb() returns boolean
	return len(blob("*")) = 2

// n_xls_worksheet.of_create_cell(unsignedinteger ai_x1, unsignedinteger ai_x2, unsignedinteger ai_y1, unsignedinteger ai_y2, double aa_value, n_xls_format anvo_format, integer ai_units) returns integer
	long li_xf
	long lul_cell
	if not isnull(anvo_format) and isvalid(anvo_format) then
		li_xf = of_xf(-1, -1, anvo_format)
	else
		return -1
	end if
	lul_cell = add_cell_double(this.iul_cellstorage, aa_value, ai_x1, ai_x2, ai_y1, ai_y2, li_xf, ai_units)
	return 1

// n_xls_worksheet.of_create_cell(unsignedinteger ai_x1, unsignedinteger ai_x2, unsignedinteger ai_y1, unsignedinteger ai_y2, string aa_value, n_xls_format anvo_format, integer ai_units) returns integer
	long li_xf
	long lul_cell
	if not isnull(anvo_format) and isvalid(anvo_format) then
		li_xf = of_xf(-1, -1, anvo_format)
	else
		return -1
	end if
	lul_cell = add_cell_string(this.iul_cellstorage, aa_value, ai_x1, ai_x2, ai_y1, ai_y2, li_xf, ai_units)
	return 1

// n_xls_worksheet.of_create_cell(unsignedinteger ai_x1, unsignedinteger ai_x2, unsignedinteger ai_y1, unsignedinteger ai_y2, time aa_value, n_xls_format anvo_format, integer ai_units) returns integer
	long li_xf
	double ld_val
	integer li_hour
	integer li_minute
	integer li_second
	long lul_cell
	if not isnull(anvo_format) and isvalid(anvo_format) then
		li_xf = of_xf(-1, -1, anvo_format)
	else
		return -1
	end if
	li_hour = hour(aa_value)
	li_minute = minute(aa_value)
	li_second = second(aa_value)
	ld_val = (li_second + li_minute * 60 + li_hour * 3600) / (24 * 3600)
	lul_cell = add_cell_double(this.iul_cellstorage, ld_val, ai_x1, ai_x2, ai_y1, ai_y2, li_xf, ai_units)
	return 1

// n_xls_worksheet.of_create_cell(unsignedinteger ai_x1, unsignedinteger ai_x2, unsignedinteger ai_y1, unsignedinteger ai_y2, datetime aa_value, n_xls_format anvo_format, integer ai_units) returns integer
	long li_xf
	double ld_val
	time lt_time
	string ls_time
	integer li_hour
	integer li_minute
	integer li_second
	long lul_cell
	if not isnull(anvo_format) and isvalid(anvo_format) then
		li_xf = of_xf(-1, -1, anvo_format)
	else
		return -1
	end if
	lt_time = time(aa_value)
	ls_time = string(lt_time)
	lt_time = time(ls_time)
	li_hour = hour(lt_time)
	li_minute = minute(lt_time)
	li_second = second(lt_time)
	ld_val = daysafter(date("1899-12-30"), date(aa_value)) + (li_second + li_minute * 60 + li_hour * 3600) / (24 * 3600)
	lul_cell = add_cell_double(this.iul_cellstorage, ld_val, ai_x1, ai_x2, ai_y1, ai_y2, li_xf, ai_units)
	return 1

// n_xls_worksheet.of_create_cell(unsignedinteger ai_x1, unsignedinteger ai_x2, unsignedinteger ai_y1, unsignedinteger ai_y2, date aa_value, n_xls_format anvo_format, integer ai_units) returns integer
	long li_xf
	double ld_val
	long lul_cell
	if not isnull(anvo_format) and isvalid(anvo_format) then
		li_xf = of_xf(-1, -1, anvo_format)
	else
		return -1
	end if
	ld_val = daysafter(date("1899-12-30"), aa_value)
	lul_cell = add_cell_double(this.iul_cellstorage, ld_val, ai_x1, ai_x2, ai_y1, ai_y2, li_xf, ai_units)
	return 1

// n_xls_worksheet.of_initunitconvertor() returns 0
	long li_unit
	this.inv_unitsub = create n_dwr_sub
	for li_unit = 0 to 3
		set_unit_x_coef(this.iul_cellstorage, li_unit, this.inv_unitsub.of_get_coef_x(li_unit))
		set_unit_y_coef(this.iul_cellstorage, li_unit, this.inv_unitsub.of_get_coef_y(li_unit))
	next

// n_xls_worksheet.of_add_y_pagebreak(long al_y, integer ai_unit) returns 0
	add_h_break(this.iul_cellstorage, al_y, ai_unit)

// n_xls_worksheet.of_end_band(integer ai_units) returns long
	return end_band(this.iul_cellstorage, ai_units)

// n_xls_worksheet.of_setalign(double ad_x, double ad_y) returns 0
	set_align(this.iul_cellstorage, ad_x, ad_y)

// n_xls_worksheet.of_initdata() returns 0
	of_update_y()
	of_update_x()

// n_xls_worksheet.create() returns 0 [event]
	call super::create
	triggerevent("constructor")

// n_xls_worksheet.destroy() returns 0 [event]
	triggerevent("destructor")
	call super::destroy

// n_xls_worksheet.constructor() returns long [event]
	this.invo_sub = create n_xls_subroutines_v97
	return ::message.returnvalue

// n_xls_worksheet.destructor() returns long [event]
	if this.iul_cellstorage <> 0 then
		free_cell_storage(this.iul_cellstorage)
		this.iul_cellstorage = 0
	end if
	destroy this.invo_sub
	return ::message.returnvalue
