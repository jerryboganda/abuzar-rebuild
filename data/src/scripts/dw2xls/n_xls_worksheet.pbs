// n_xls_worksheet.of_update_x() returns integer
	long li_base_col
	long li_max_col
	long li_col
	double ld_col_w
	prepare_x(this.iul_cellstorage)
	get_x_info(this.iul_cellstorage, li_base_col, li_max_col)
	for li_col = li_base_col to li_max_col
		ld_col_w = get_col_width(this.iul_cellstorage, li_col)
		of_set_column_width(li_col, ld_col_w)
	next
	return update_x(this.iul_cellstorage)

// n_xls_worksheet.of_get_cell_count() returns long
	return get_cell_count(this.iul_cellstorage)

// n_xls_worksheet.of_write_cell(long ai_cell, boolean ab_merge) returns integer
	cell_info info
	cell_coord coord
	long li_format
	long li_ret
	long li_row
	long li_col
	string ls_value
	double ld_value
	ai_cell = ai_cell - 1
	info.valuesize = -1
	li_ret = get_cell_info(this.iul_cellstorage, ai_cell, info)
	if li_ret < 0 then
		return -1
	end if
	choose case info.valuetype
	case 2
		ls_value = space(info.valuesize)
		li_ret = get_cell_string(this.iul_cellstorage, ai_cell, ls_value, li_format, coord)
		if li_ret < 0 then
			return -1
		end if
		li_ret = of_write(coord.y1, coord.x1, ls_value, li_format)
	case 1
		li_ret = get_cell_double(this.iul_cellstorage, ai_cell, ld_value, li_format, coord)
		if li_ret < 0 then
			return -1
		end if
		li_ret = of_write(coord.y1, coord.x1, ld_value, li_format)
	case 4
		li_ret = of_add_h_pagebreak(info.valuesize)
	case else
		return -1
	end choose
	if not ab_merge then
		return 1
	end if
	coord.y2 = coord.y2 - 1
	coord.x2 = coord.x2 - 1
	if coord.y1 >= coord.y2 and coord.x1 >= coord.x2 then
		return 1
	end if
	for li_row = coord.y1 to coord.y2
		for li_col = coord.x1 to coord.x2
			if not (li_row = coord.y1 and li_col = coord.x1) then
				of_write(li_row, li_col, "", li_format)
			end if
		next
	next
	of_merge_cells(coord.y1, coord.x1, coord.y2, coord.x2)
	return 1

// n_xls_worksheet.of_write(long ai_row, long ai_col, double aa_value, long ai_format) returns integer
	return 1

