// n_xls_workbook_v5.of_store_ole_file() returns integer
	integer li_ret = 1
	integer li_i
	olestream lstr_book
	n_xls_worksheet_v5 lnvo_sheet
	lstr_book = create olestream
	li_ret = lstr_book.open(this.istg_doc, "Book", stgwrite!)
	if li_ret < 0 then
		li_ret = -1
	else
		li_ret = 1
	end if
	if li_ret = 1 then
		this.invo_data.of_write(lstr_book)
	end if
	if li_ret = 1 then
		for li_i = 1 to this.il_worksheetindex
			lnvo_sheet = this.invo_worksheets[li_i]
			lnvo_sheet.of_write_data(lstr_book)
		next
	end if
	if li_ret = 1 then
		lstr_book.close()
		this.istg_doc.close()
	end if
	return li_ret

