// n_xls_worksheet_v97.of_set_header(blob ab_header, double ad_margin_head) returns integer
	integer li_ret = 1
	if len(ab_header) / 2.0 >= 255.0 then
		messagebox("Error", "Header string must be less than 255 characters", stopsign!)
		li_ret = -1
	end if
	if li_ret = 1 then
		this.ib_header = ab_header
		if isnull(ad_margin_head) then
			this.id_margin_head = 0.50
		else
			this.id_margin_head = ad_margin_head
		end if
	end if
	return li_ret

