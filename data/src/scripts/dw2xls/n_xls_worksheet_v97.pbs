	end if
	if li_ret = 1 then
		lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
		lb_data = this.invo_sub.of_pack("v", ai_row) + this.invo_sub.of_pack("v", ai_col) + this.invo_sub.of_pack("v", li_xf)
		of_append_data(lb_header + lb_data)
	end if
	return li_ret

// n_xls_worksheet_v97.of_store_bof(unsignedinteger ai_type) returns integer
	integer li_ret = 1
	unsignedinteger li_record = 2057
	unsignedinteger li_length = 16
	blob lb_header
	blob lb_data
	unsignedinteger li_version
	unsignedlong ll_history_flag = 16449
	unsignedlong ll_lowest_version = 262
	unsignedinteger li_build = 6319
	unsignedinteger li_year = 1997
	li_version = this.invo_workbook.ii_biff_version
	lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
	lb_data = this.invo_sub.of_pack("v", li_version) + this.invo_sub.of_pack("v", ai_type) + this.invo_sub.of_pack("v", li_build) + this.invo_sub.of_pack("v", li_year) + this.invo_sub.of_pack("V", ll_history_flag) + this.invo_sub.of_pack("V", ll_lowest_version)
