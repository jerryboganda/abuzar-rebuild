// n_xls_worksheet_v97.of_size_col(unsignedinteger ai_col) returns unsignedinteger
	unsignedinteger li_ind
	li_ind = this.invo_key_col_sizes.of_get_key_index(ai_col)
	if li_ind > 0 then
		if this.id_col_sizes[li_ind] = 0.0 then
			return 0
		else
			return this.id_col_sizes[li_ind] * 7.0 + 5.0
		end if
		return
	end if
	return 64

// n_xls_worksheet_v97.of_size_row(unsignedinteger ai_row) returns unsignedinteger
	unsignedinteger li_ind
	li_ind = this.invo_key_row_sizes.of_get_key_index(ai_row)
	if li_ind > 0 then
		if this.id_row_sizes[li_ind] = 0.0 then
			return 0
		else
			return this.id_row_sizes[li_ind] * 4.0 / 3.0
		end if
		return
	end if
	return 17

// n_xls_worksheet_v97.of_store_zoom() returns integer
	integer li_ret = 1
	unsignedinteger li_record = 160
	unsignedinteger li_length = 4
	blob lb_header
	blob lb_data
	if this.ii_zoom = 100 then
		return li_ret
	end if
	lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
	lb_data = this.invo_sub.of_pack("v", this.ii_zoom) + this.invo_sub.of_pack("v", 100)
	of_append_data(lb_header + lb_data)
	return li_ret

// n_xls_worksheet_v97.of_write(unsignedinteger ai_row, unsignedinteger ai_col, double adb_num, n_xls_format anvo_format) returns integer
	integer li_ret = 1
	unsignedinteger li_record = 515
	unsignedinteger li_length = 14
	unsignedinteger li_xf
	blob lb_header
	blob lb_data
	n_xls_format_v97 lnvo_format
	lnvo_format = anvo_format
	li_xf = of_xf(ai_row, ai_col, lnvo_format)
	if of_check_dimensions(ai_row, ai_col) <> 1 then
		li_ret = -2
	end if
	if li_ret = 1 then
		lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
		lb_data = this.invo_sub.of_pack("v", ai_row) + this.invo_sub.of_pack("v", ai_col) + this.invo_sub.of_pack("v", li_xf) + this.invo_sub.of_pack("d", adb_num)
		of_append_data(lb_header + lb_data)
	end if
	return li_ret

// n_xls_worksheet_v97.of_write(unsignedinteger ai_row, unsignedinteger ai_col, string as_str, n_xls_format anvo_format) returns integer
	return of_write(ai_row, ai_col, this.invo_sub.to_unicode(this.invo_sub.of_str2xls(as_str)), anvo_format)

// n_xls_worksheet_v97.of_write(unsignedinteger ai_row, unsignedinteger ai_col, blob ab_unicode_str, n_xls_format anvo_format) returns integer
	integer li_ret = 1
	unsignedinteger li_record = 253
	unsignedinteger li_length = 10
	unsignedinteger li_xf
	unsignedlong ll_sst_index
	blob lb_header
	blob lb_data
	n_xls_format_v97 lnvo_format
	if isnull(ab_unicode_str) then
		ab_unicode_str = blob("")
	end if
	lnvo_format = anvo_format
	li_xf = of_xf(ai_row, ai_col, lnvo_format)
	if of_check_dimensions(ai_row, ai_col) <> 1 then
		li_ret = -2
	end if
	if li_ret = 1 then
		ll_sst_index = this.invo_workbook.event ue_add_unicode(ab_unicode_str)
	end if
	if li_ret = 1 then
		lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
		lb_data = this.invo_sub.of_pack("v", ai_row) + this.invo_sub.of_pack("v", ai_col) + this.invo_sub.of_pack("v", li_xf) + this.invo_sub.of_pack("V", ll_sst_index)
		of_append_data(lb_header + lb_data)
	end if
	return li_ret

// n_xls_worksheet_v97.of_write(unsignedinteger ai_row, unsignedinteger ai_col, datetime adt_datetime, n_xls_format anvo_format) returns integer
	double ld_val
	time lt_time
	string ls_time
	integer li_hour
	integer li_minute
	integer li_second
	lt_time = time(adt_datetime)
	ls_time = string(lt_time)
	lt_time = time(ls_time)
	li_hour = hour(lt_time)
	li_minute = minute(lt_time)
	li_second = second(lt_time)
	ld_val = daysafter(date("1899-12-30"), date(adt_datetime)) + (li_second + li_minute * 60 + li_hour * 3600) / (24 * 3600)
	return of_write(ai_row, ai_col, ld_val, anvo_format)

// n_xls_worksheet_v97.of_write(unsignedinteger ai_row, unsignedinteger ai_col, date ad_date, n_xls_format anvo_format) returns integer
	double ld_val
	ld_val = daysafter(date("1899-12-30"), ad_date)
	return of_write(ai_row, ai_col, ld_val, anvo_format)

