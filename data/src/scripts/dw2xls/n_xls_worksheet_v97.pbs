	blob lb_header
	blob lb_data
	unsignedinteger li_wpassword
	if not this.ib_protect then
		return li_ret
	end if
	li_wpassword = of_encode_password(this.is_password)
	lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
	lb_data = this.invo_sub.of_pack("v", li_wpassword)
