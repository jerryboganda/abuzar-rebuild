	li_ret = of_set_row(al_row, al_height, lnvo_format, lb_hidden)
	return li_ret

// n_xls_worksheet_v97.of_process_bitmap(string as_bitmap_filename, long al_width, long al_height, long al_size, blob ab_data) returns integer
	integer li_ret = 1
	integer li_file
	blob lb_data_item
	blob lb_data
	unsignedlong ll_size
	unsignedinteger li_planes
	unsignedinteger li_bitcount
	unsignedlong ll_compression
	blob lb_header
	li_file = fileopen(as_bitmap_filename, streammode!, read!, lockwrite!)
	if li_file <> -1 then
		setnull(lb_data)
		do while fileread(li_file, lb_data_item) > 0
			if isnull(lb_data) then
				lb_data = lb_data_item
			else
				lb_data = lb_data_item + lb_data
			end if
		loop
		if isnull(lb_data) then
			li_ret = -1
		end if
		fileclose(li_file)
	else
		li_ret = -1
		messagebox("Error", "Couldn't open " + as_bitmap_filename, stopsign!)
	end if
	if li_ret = 1 and len(lb_data) <= 54 then
		li_ret = -1
		messagebox("Error", as_bitmap_filename + " doesn't contain enough data", stopsign!)
	end if
	if li_ret = 1 and string(blobmid(lb_data, 1, 2)) <> "BM" then
		li_ret = -1
		messagebox("Error", as_bitmap_filename + " doesn't appear to to be a valid bitmap image", stopsign!)
	end if
	if li_ret = 1 then
		ll_size = long(blobmid(lb_data, 3, 4))
		ll_size = ll_size - (54 - 12)
		al_width = long(blobmid(lb_data, 19, 4))
		al_height = long(blobmid(lb_data, 23, 4))
		if al_width > 65535 then
			li_ret = -1
			messagebox("Error", as_bitmap_filename + ": largest image width supported is 65535", stopsign!)
		end if
	end if
	if li_ret = 1 and al_height > 65535 then
		li_ret = -1
		messagebox("Error", as_bitmap_filename + ": largest image height supported is 65535", stopsign!)
	end if
	if li_ret = 1 then
		li_planes = integer(blobmid(lb_data, 27, 2))
		li_bitcount = integer(blobmid(lb_data, 29, 2))
		if li_bitcount <> 24 then
			li_ret = -1
			messagebox("Error", as_bitmap_filename + " isn't a 24bit true color bitmap", stopsign!)
		end if
	end if
	if li_ret = 1 and li_planes <> 1 then
		li_ret = -1
		messagebox("Error", as_bitmap_filename + ": only 1 plane supported in bitmap image", stopsign!)
	end if
	if li_ret = 1 then
		ll_compression = long(blobmid(lb_data, 31, 4))
		if ll_compression <> 0 then
			li_ret = -1
			messagebox("Error", as_bitmap_filename + ": compression not supported in bitmap image", stopsign!)
		end if
	end if
	if li_ret = 1 then
		lb_header = this.invo_sub.of_pack("V", 12) + this.invo_sub.of_pack("v", al_width) + this.invo_sub.of_pack("v", al_height) + this.invo_sub.of_pack("v", 1) + this.invo_sub.of_pack("v", 24)
		ab_data = lb_header + blobmid(lb_data, 55, len(lb_data) - 55 + 1)
		al_size = ll_size
	end if
	return li_ret

// n_xls_worksheet_v97.of_insert_bitmap(unsignedinteger ai_row, unsignedinteger ai_col, string as_bitmap_filename, unsignedinteger ai_x, unsignedinteger ai_y, double ad_scale_width, double ad_scale_height) returns integer
	integer li_ret = 1
	long li_width
	long li_height
	long li_size
	blob lb_data
	blob lb_header
	li_ret = of_process_bitmap(as_bitmap_filename, li_width, li_height, li_size, lb_data)
	if li_ret = 1 then
		li_width = li_width * ad_scale_width
		li_height = li_height * ad_scale_height
		li_ret = of_position_image(ai_col, ai_row, ai_x, ai_y, li_width, li_height)
	end if
	if li_ret = 1 then
		lb_header = this.invo_sub.of_pack("v", 127) + this.invo_sub.of_pack("v", 8 + li_size) + this.invo_sub.of_pack("v", 9) + this.invo_sub.of_pack("v", 1) + this.invo_sub.of_pack("V", li_size)
		of_append_data(lb_header + lb_data)
	end if
	return li_ret

// n_xls_worksheet_v97.of_insert_bitmap(unsignedinteger ai_row, unsignedinteger ai_col, string as_bitmap_filename, unsignedinteger ai_x, unsignedinteger ai_y) returns integer
	return of_insert_bitmap(ai_row, ai_col, as_bitmap_filename, ai_x, ai_y, 1, 1)

// n_xls_worksheet_v97.of_insert_bitmap(unsignedinteger ai_row, unsignedinteger ai_col, string as_bitmap_filename) returns integer
	return of_insert_bitmap(ai_row, ai_col, as_bitmap_filename, 0, 0, 1, 1)

// n_xls_worksheet_v97.of_position_image(unsignedinteger ai_col_start, unsignedinteger ai_row_start, unsignedinteger ai_x1, unsignedinteger ai_y1, unsignedinteger ai_width, unsignedinteger ai_height) returns integer
	integer li_ret = 1
	unsignedinteger li_col_end
	unsignedinteger li_row_end
	unsignedinteger li_x2
	unsignedinteger li_y2
	li_col_end = ai_col_start
	li_row_end = ai_row_start
	if ai_x1 >= of_size_col(ai_col_start) then
		ai_x1 = 0
	end if
	if ai_y1 >= of_size_row(ai_row_start) then
		ai_y1 = 0
	end if
	ai_width = ai_width + ai_x1 - 1
	ai_height = ai_height + ai_y1 - 1
	do while ai_width >= of_size_col(li_col_end)
		ai_width = ai_width - of_size_col(li_col_end)
		li_col_end = li_col_end + 1
	loop
	do while ai_height >= of_size_row(li_row_end)
		ai_height = ai_height - of_size_row(li_row_end)
		li_row_end = li_row_end + 1
	loop
	if of_size_col(ai_col_start) = 0 then
		return -1
	end if
	if of_size_col(li_col_end) = 0 then
		return -1
	end if
	if of_size_row(ai_row_start) = 0 then
		return -1
	end if
	if of_size_row(li_row_end) = 0 then
		return -1
	end if
	ai_x1 = ai_x1 / of_size_col(ai_col_start) * 1024.0
	ai_y1 = ai_y1 / of_size_row(ai_row_start) * 256.0
	li_x2 = ai_width / of_size_col(li_col_end) * 1024.0
	li_y2 = ai_height / of_size_row(li_row_end) * 256.0
	li_ret = of_store_obj_picture(ai_col_start, ai_x1, ai_row_start, ai_y1, li_col_end, li_x2, li_row_end, li_y2)
	return li_ret

// n_xls_worksheet_v97.of_get_excel_height(double ad_value) returns unsignedinteger
	unsignedinteger li_w1
	double ld_w1
	double ld_w2
	li_w1 = truncate(ad_value, 0)
	ld_w2 = ad_value - li_w1
	ld_w2 = round(ld_w2 * 4.0, 0) / 4
	return (li_w1 + ld_w2) * 20.0

// n_xls_worksheet_v97.of_get_excel_width(double ad_value) returns unsignedinteger
	unsignedinteger li_w1
	double ld_w1
	double ld_w2
	double ld_w
	li_w1 = truncate(ad_value, 0)
	ld_w2 = ad_value - li_w1
	if li_w1 > 0 then
		ld_w1 = li_w1 + 0.72
	else
		ld_w1 = 0
	end if
	if li_w1 > 0 then
		ld_w = ld_w1 * 256.0 + ld_w2 * 256.0
	else
		ld_w = ld_w1 * 256.0 + ld_w2 * 256.0 * 1.8
	end if
	return ld_w

// n_xls_worksheet_v97.of_select() returns integer
	integer li_ret = 1
	this.ib_selected = true
	return li_ret

// n_xls_worksheet_v97.of_store_obj_picture(unsignedinteger ai_col_start, unsignedinteger ai_x1, unsignedinteger ai_row_start, unsignedinteger ai_y1, unsignedinteger ai_col_end, unsignedinteger ai_x2, unsignedinteger ai_row_end, unsignedinteger ai_y2) returns integer
	integer li_ret = 1
	blob lb_header
	lb_header = this.invo_sub.of_pack("v", 93) + this.invo_sub.of_pack("v", 60) + this.invo_sub.of_pack("V", 1) + this.invo_sub.of_pack("v", 8) + this.invo_sub.of_pack("v", 1) + this.invo_sub.of_pack("v", 1556) + this.invo_sub.of_pack("v", ai_col_start) + this.invo_sub.of_pack("v", ai_x1) + this.invo_sub.of_pack("v", ai_row_start) + this.invo_sub.of_pack("v", ai_y1) + this.invo_sub.of_pack("v", ai_col_end) + this.invo_sub.of_pack("v", ai_x2) + this.invo_sub.of_pack("v", ai_row_end) + this.invo_sub.of_pack("v", ai_y2) + this.invo_sub.of_pack("v", 0) + this.invo_sub.of_pack("V", 0) + this.invo_sub.of_pack("v", 0) + this.invo_sub.of_pack("C", 9) + this.invo_sub.of_pack("C", 9) + this.invo_sub.of_pack("C", 0) + this.invo_sub.of_pack("C", 0) + this.invo_sub.of_pack("C", 8) + this.invo_sub.of_pack("C", 255) + this.invo_sub.of_pack("C", 1) + this.invo_sub.of_pack("C", 0) + this.invo_sub.of_pack("v", 0) + this.invo_sub.of_pack("V", 9) + this.invo_sub.of_pack("v", 0) + this.invo_sub.of_pack("v", 0) + this.invo_sub.of_pack("v", 0) + this.invo_sub.of_pack("v", 1) + this.invo_sub.of_pack("V", 0)
	of_append_data(lb_header)
	return li_ret

// n_xls_worksheet_v97.of_xf(unsignedinteger ai_row, unsignedinteger ai_col, n_xls_format anvo_format) returns integer
	unsignedinteger li_xf = 15
	unsignedlong ll_key
	if not isnull(anvo_format) and isvalid(anvo_format) then
		return this.invo_workbook.of_reg_format(anvo_format)
	end if
	ll_key = this.invo_key_row_formats.of_get_key_index(ai_row)
	if ll_key > 0 then
		return this.invo_workbook.of_reg_format(this.invo_row_formats[ll_key])
	end if
	ll_key = this.invo_key_col_formats.of_get_key_index(ai_col)
	if ll_key > 0 then
		return this.invo_workbook.of_reg_format(this.invo_col_formats[ll_key])
	end if
	return li_xf

// n_xls_worksheet_v97.of_write(long ai_row, long ai_col, double aa_value, long ai_format) returns integer
	integer li_ret = 1
	unsignedinteger li_record = 515
	unsignedinteger li_length = 14
	unsignedinteger li_xf
	blob lb_header
	blob lb_data
	if of_check_dimensions(ai_row, ai_col) <> 1 then
		li_ret = -2
	end if
	if li_ret = 1 then
		lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
		lb_data = this.invo_sub.of_pack("v", ai_row) + this.invo_sub.of_pack("v", ai_col) + this.invo_sub.of_pack("v", ai_format) + this.invo_sub.of_pack("d", aa_value)
		of_append_data(lb_header + lb_data)
	end if
	return li_ret

// n_xls_worksheet_v97.of_write(long ai_row, long ai_col, string aa_value, long ai_format) returns integer
	return of_write(ai_row, ai_col, this.invo_sub.to_unicode(this.invo_sub.of_str2xls(aa_value)), ai_format)

// n_xls_worksheet_v97.of_write(long ai_row, long ai_col, blob aa_value, long ai_format) returns integer
	integer li_ret = 1
	unsignedinteger li_record = 253
	unsignedinteger li_length = 10
	unsignedinteger li_xf
	unsignedlong ll_sst_index
	blob lb_header
	blob lb_data
	if isnull(aa_value) then
		aa_value = blob("")
	end if
	if of_check_dimensions(ai_row, ai_col) <> 1 then
		li_ret = -2
	end if
	if li_ret = 1 then
		ll_sst_index = this.invo_workbook.event ue_add_unicode(aa_value)
	end if
	if li_ret = 1 then
		lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
		lb_data = this.invo_sub.of_pack("v", ai_row) + this.invo_sub.of_pack("v", ai_col) + this.invo_sub.of_pack("v", ai_format) + this.invo_sub.of_pack("V", ll_sst_index)
		of_append_data(lb_header + lb_data)
	end if
	return li_ret

// n_xls_worksheet_v97.of_set_merge_range(long ai_format) returns 0
	this.invo_workbook.of_get_format(ai_format).of_set_merge_range()

// n_xls_worksheet_v97.constructor() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::constructor()
	this.il_dim_rowmin = this.il_xls_rowmax + 1
	this.il_dim_colmin = this.il_xls_colmax + 1
	this.invo_selection = create n_xls_selection
	this.invo_data = create n_xls_data
	this.invo_header = create n_xls_data
	this.invo_selection.ii_first_row = 0
	this.invo_selection.ii_last_row = 0
	this.invo_selection.ii_first_col = 0
	this.invo_selection.ii_last_col = 0
	setnull(this.invo_panes)
	setnull(this.ii_title_rowmin)
	setnull(this.ii_title_rowmax)
	setnull(this.ii_title_colmin)
	setnull(this.ii_title_colmax)
	setnull(this.ii_print_rowmin)
	setnull(this.ii_print_rowmax)
	setnull(this.ii_print_colmin)
	setnull(this.ii_print_colmax)
	this.invo_key_col_sizes = create n_associated_ulong_srv
	this.invo_key_row_sizes = create n_associated_ulong_srv
	this.invo_key_col_formats = create n_associated_ulong_srv
	this.invo_key_row_formats = create n_associated_ulong_srv
	this.invo_key_col_hiddens = create n_associated_ulong_srv
	this.invo_key_row_hiddens = create n_associated_ulong_srv
	return ::message.returnvalue

// n_xls_worksheet_v97.create() returns 0 [event]
	call super::create

// n_xls_worksheet_v97.destroy() returns 0 [event]
	call super::destroy
