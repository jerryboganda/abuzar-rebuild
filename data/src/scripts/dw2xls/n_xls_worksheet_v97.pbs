	setnull(this.ib_data)
	return lb_tmp

// n_xls_worksheet_v97.of_encode_password(string as_password) returns unsignedlong
	unsignedlong ll_ret
	unsignedlong[] ll_chars
	unsignedinteger li_count
	unsignedinteger li_i
	unsignedinteger li_start = 1
	unsignedlong ll_low
	unsignedlong ll_high
	li_count = len(as_password)
	if li_count > 0 then
		for li_i = li_start to li_count
			ll_chars[li_i] = uf_bitshl(asc(mid(as_password, li_i, 1)), li_i)
			ll_low = uf_bitand(ll_chars[li_i], 32767)
			ll_high = uf_bitshr(uf_bitand(ll_chars[li_i], uf_bitshl(32767, 15)), 15)
			ll_chars[li_i] = uf_bitor(ll_low, ll_high)
		next
		ll_ret = 0
		for li_i = li_start to li_count
			ll_ret = uf_bitxor(ll_ret, ll_chars[li_i])
		next
		ll_ret = uf_bitxor(ll_ret, li_count)
		ll_ret = uf_bitxor(ll_ret, 52811)
	else
		ll_ret = 0
	end if
	return ll_ret

// n_xls_worksheet_v97.of_set_row_height(long al_row, double ad_height) returns integer
	integer li_ret = 1
	n_xls_format_v97 lnvo_format
	boolean lb_hidden
	setnull(lnvo_format)
	setnull(lb_hidden)
	li_ret = of_set_row(al_row, ad_height, lnvo_format, lb_hidden)
	return li_ret

// n_xls_worksheet_v97.of_set_row(unsignedinteger ai_row, double ad_height, n_xls_format_v97 anvo_format, boolean ab_hidden) returns integer
	integer li_ret = 1
	unsignedinteger li_record = 520
	unsignedinteger li_length = 16
	unsignedinteger li_colmic
	unsignedinteger li_colmac
	unsignedinteger li_irwmac
	unsignedinteger li_reserved
	unsignedinteger li_grbit = 320
	unsignedinteger li_ixfe = 15
	unsignedinteger li_miyrw = 255
	blob lb_header
	blob lb_data
	unsignedlong ll_i
	boolean lb_format_undef
	if not isnull(anvo_format) then
		if isvalid(anvo_format) then
			li_ixfe = this.invo_workbook.of_reg_format(anvo_format)
			li_grbit = 128 + li_grbit
		else
			lb_format_undef = true
		end if
	else
		lb_format_undef = true
	end if
	if lb_format_undef then
		ll_i = this.invo_key_row_formats.of_get_key_index(ai_row)
		if ll_i > 0 then
			li_ixfe = this.invo_workbook.of_reg_format(this.invo_row_formats[ll_i])
			li_grbit = 128 + li_grbit
		end if
	end if
	if not isnull(ad_height) then
		li_miyrw = of_get_excel_height(ad_height)
	else
		ll_i = this.invo_key_row_sizes.of_get_key_index(ai_row)
		if ll_i > 0 then
			li_miyrw = this.id_row_sizes[ll_i] * 20.0
		end if
	end if
	if isnull(ab_hidden) then
		ll_i = this.invo_key_row_hiddens.of_get_key_index(ai_row)
		if ll_i > 0 and this.ib_row_hiddens[ll_i] then
			li_grbit = 32 + li_grbit
		end if
	elseif ab_hidden then
		li_grbit = 32 + li_grbit
	end if
	lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
	lb_data = this.invo_sub.of_pack("v", ai_row) + this.invo_sub.of_pack("v", li_colmic) + this.invo_sub.of_pack("v", li_colmac) + this.invo_sub.of_pack("v", li_miyrw) + this.invo_sub.of_pack("v", li_irwmac) + this.invo_sub.of_pack("v", li_reserved) + this.invo_sub.of_pack("v", li_grbit) + this.invo_sub.of_pack("v", li_ixfe)
	of_append_data(lb_header + lb_data)
	if not isnull(ab_hidden) then
		ll_i = this.invo_key_row_hiddens.of_get_key_index(ai_row)
		if ll_i = 0 then
			ll_i = this.invo_key_row_hiddens.of_add_key(ai_row)
		end if
		this.ib_row_hiddens[ll_i] = ab_hidden
	end if
	if not isnull(ad_height) then
		ll_i = this.invo_key_row_sizes.of_get_key_index(ai_row)
		if ll_i = 0 then
			ll_i = this.invo_key_row_sizes.of_add_key(ai_row)
		end if
		this.id_row_sizes[ll_i] = ad_height
	end if
	if not isnull(anvo_format) and isvalid(anvo_format) then
		ll_i = this.invo_key_row_formats.of_get_key_index(ai_row)
		if ll_i = 0 then
			ll_i = this.invo_key_row_formats.of_add_key(ai_row)
		end if
		this.invo_row_formats[ll_i] = anvo_format
	end if
	return li_ret

// n_xls_worksheet_v97.of_set_column_width(long al_col, double ad_width) returns integer
	integer li_ret = 1
	n_xls_format_v97 lnvo_format
	boolean lb_hidden
	unsignedlong ll_i
	ll_i = this.invo_key_col_formats.of_get_key_index(al_col)
	if ll_i > 0 then
		lnvo_format = this.invo_col_formats[ll_i]
	else
		setnull(lnvo_format)
	end if
	ll_i = this.invo_key_col_hiddens.of_get_key_index(al_col)
	if ll_i > 0 then
		lb_hidden = this.ib_col_hiddens[ll_i]
	else
		setnull(lb_hidden)
	end if
	li_ret = of_set_column(al_col, al_col, ad_width, lnvo_format, lb_hidden)
	return li_ret

// n_xls_worksheet_v97.of_set_column(unsignedinteger ai_firstcol, unsignedinteger ai_lastcol, double ad_width, n_xls_format anvo_format, boolean ab_hidden) returns integer
	integer li_ret = 1
	double ld_width
	unsignedinteger li_i
	unsignedlong ll_key
	n_xls_format_v97 lnvo_format
	n_xls_colinfo lnvo_colinfo
	lnvo_colinfo = create n_xls_colinfo
	lnvo_colinfo.ii_firstcol = ai_firstcol
	lnvo_colinfo.ii_lastcol = ai_lastcol
	lnvo_colinfo.id_width = ad_width
	if not isnull(anvo_format) then
		if isvalid(anvo_format) then
			lnvo_format = create n_xls_format_v97
			lnvo_format.of_copy(anvo_format)
			this.invo_workbook.of_reg_format(lnvo_format)
		else
			setnull(lnvo_format)
		end if
	else
		setnull(lnvo_format)
	end if
	lnvo_colinfo.invo_format = lnvo_format
	lnvo_colinfo.ib_hidden = ab_hidden
	this.invo_colinfo[upperbound(this.invo_colinfo) + 1] = lnvo_colinfo
	if ab_hidden then
		ld_width = 0
	else
		ld_width = ad_width
	end if
	for li_i = ai_firstcol to ai_lastcol
		ll_key = this.invo_key_col_sizes.of_find_key(li_i)
		if ll_key < 1 then
			ll_key = this.invo_key_col_sizes.of_add_key(li_i)
		end if
		this.id_col_sizes[ll_key] = ad_width
	next
	if not isnull(ab_hidden) then
		for li_i = ai_firstcol to ai_lastcol
			ll_key = this.invo_key_col_hiddens.of_find_key(li_i)
			if ll_key < 1 then
				ll_key = this.invo_key_col_hiddens.of_add_key(li_i)
			end if
			this.ib_col_hiddens[ll_key] = ab_hidden
		next
	end if
	if not isnull(anvo_format) and isvalid(anvo_format) then
		for li_i = ai_firstcol to ai_lastcol
			ll_key = this.invo_key_col_formats.of_find_key(li_i)
			if ll_key < 1 then
				ll_key = this.invo_key_col_formats.of_add_key(li_i)
			end if
			this.invo_col_formats[ll_key] = anvo_format
		next
	end if
	return li_ret

// n_xls_worksheet_v97.of_set_column_width(long al_col, long al_width) returns integer
	integer li_ret = 1
	n_xls_format_v97 lnvo_format
	boolean lb_hidden
	unsignedlong ll_i
	ll_i = this.invo_key_col_formats.of_get_key_index(al_col)
	if ll_i > 0 then
		lnvo_format = this.invo_col_formats[ll_i]
	else
		setnull(lnvo_format)
	end if
	ll_i = this.invo_key_col_hiddens.of_get_key_index(al_col)
	if ll_i > 0 then
		lb_hidden = this.ib_col_hiddens[ll_i]
	else
		setnull(lb_hidden)
	end if
	li_ret = of_set_column(al_col, al_col, al_width, lnvo_format, lb_hidden)
	return li_ret

// n_xls_worksheet_v97.of_set_row_height(long al_row, long al_height) returns integer
