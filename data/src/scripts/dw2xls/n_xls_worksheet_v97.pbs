		li_ret = -1
	end if
	if li_ret = 1 then
		this.ib_footer = ab_footer
		if isnull(ad_margin_foot) then
			this.id_margin_foot = 0.50
		else
			this.id_margin_foot = ad_margin_foot
		end if
	end if
	return li_ret

