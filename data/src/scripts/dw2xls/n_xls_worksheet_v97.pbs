// n_xls_worksheet_v97.of_store_hbreak() returns integer
	integer li_ret = 1
	unsignedinteger[] li_tmp
	unsignedinteger li_record = 27
	unsignedinteger li_length
	blob lb_header
	blob lb_data
	unsignedinteger li_cbrk
	unsignedinteger li_i
	unsignedinteger li_start = 1
	li_tmp = this.ii_hbreaks
	of_sort_pagebreaks(li_tmp)
	li_cbrk = upperbound(li_tmp)
	if li_cbrk = 0 then
		return li_ret
	end if
	li_length = li_cbrk * 6 + 2
	lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
	lb_data = this.invo_sub.of_pack("v", li_cbrk)
	for li_i = li_start to li_cbrk
		lb_data = lb_data + this.invo_sub.of_pack("v", li_tmp[li_i]) + this.invo_sub.of_pack("v", 0) + this.invo_sub.of_pack("v", 255)
	next
	of_append_header(lb_header + lb_data)
	return li_ret

// n_xls_worksheet_v97.of_store_vbreak() returns integer
	integer li_ret = 1
	unsignedinteger[] li_tmp
	unsignedinteger li_record = 26
	unsignedinteger li_length
	blob lb_header
	blob lb_data
	unsignedinteger li_cbrk
	unsignedinteger li_i
	unsignedinteger li_start = 1
	li_tmp = this.ii_vbreaks
	of_sort_pagebreaks(li_tmp)
	li_cbrk = upperbound(li_tmp)
	if li_cbrk = 0 then
		return li_ret
	end if
	li_length = li_cbrk * 6 + 2
	lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
	lb_data = this.invo_sub.of_pack("v", li_cbrk)
	for li_i = li_start to li_cbrk
		lb_data = lb_data + this.invo_sub.of_pack("v", li_tmp[li_i]) + this.invo_sub.of_pack("v", 0) + this.invo_sub.of_pack("v", 65535)
	next
	of_append_header(lb_header + lb_data)
	return li_ret

// n_xls_worksheet_v97.of_store_protect() returns integer
	integer li_ret = 1
	unsignedinteger li_record = 18
	unsignedinteger li_length = 2
	blob lb_header
