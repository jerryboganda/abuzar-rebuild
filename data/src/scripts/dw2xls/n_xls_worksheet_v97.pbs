// userobject n_xls_worksheet_v97 (dw2xls)  ancestor: n_xls_worksheet

// n_xls_worksheet_v97.of_close() returns integer
	integer li_ret = 1
	unsignedinteger li_i
	unsignedinteger li_cnt
	unsignedinteger li_end = 1
	long ll_i
	of_store_bof(16)
	li_cnt = upperbound(this.invo_colinfo)
	if li_cnt > 0 then
		of_store_defcol()
		for li_i = li_cnt to li_end step 65535
			of_store_colinfo(this.invo_colinfo[li_i])
		next
	end if
	of_store_print_headers()
	of_store_print_gridlines()
	of_store_gridset()
	of_store_wsbool()
	of_store_hbreak()
	of_store_vbreak()
	of_store_setup()
	of_store_protect()
	of_store_password()
	of_store_dimensions()
	of_store_margin_bottom()
	of_store_margin_top()
	of_store_margin_right()
	of_store_margin_left()
	of_store_vcenter()
	of_store_hcenter()
	of_store_footer()
	of_store_header()
	of_store_window2()
	of_store_zoom()
	if not isnull(this.invo_panes) and isvalid(this.invo_panes) then
		of_store_panes(this.invo_panes)
	end if
	of_store_selection(this.invo_selection)
	of_store_eof()
	return li_ret

// n_xls_worksheet_v97.of_merge_write(unsignedinteger ai_first_row, unsignedinteger ai_first_col, unsignedinteger ai_last_row, unsignedinteger ai_last_col, double adb_num, n_xls_format anvo_format) returns integer
	integer li_ret = 1
	unsignedinteger li_rwfirst
	unsignedinteger li_colfirst
	unsignedinteger li_rwlast
	unsignedinteger li_collast
	unsignedinteger li_i
	unsignedinteger li_j
	n_xls_format_v97 lnvo_format
	li_rwfirst = ai_first_row
	li_colfirst = ai_first_col
	li_rwlast = ai_last_row
	li_collast = ai_last_col
	if li_rwfirst = li_rwlast and li_colfirst = li_collast then
		messagebox("Error", "Can't merge single cell", stopsign!)
		return -1
	end if
	if li_rwfirst > li_rwlast then
		li_rwfirst = ai_last_row
		li_rwlast = ai_first_row
	end if
	if li_colfirst > li_collast then
		li_colfirst = ai_last_col
		li_collast = ai_first_col
	end if
	if not isnull(anvo_format) and isvalid(anvo_format) then
		lnvo_format = anvo_format
		lnvo_format.of_set_merge_range()
	end if
	of_write(li_rwfirst, li_colfirst, adb_num, anvo_format)
	for li_i = li_rwfirst to li_rwlast
		for li_j = li_colfirst to li_collast
			if not (li_i = li_rwfirst and li_j = li_colfirst) then
				of_write(li_i, li_j, anvo_format)
			end if
		next
	next
	of_merge_cells(li_rwfirst, li_colfirst, li_rwlast, li_collast)
	return li_ret

// n_xls_worksheet_v97.of_merge_write(unsignedinteger ai_first_row, unsignedinteger ai_first_col, unsignedinteger ai_last_row, unsignedinteger ai_last_col, string as_str, n_xls_format anvo_format) returns integer
	return of_merge_write(ai_first_row, ai_first_col, ai_last_row, ai_last_col, this.invo_sub.to_unicode(this.invo_sub.of_str2xls(as_str)), anvo_format)

// n_xls_worksheet_v97.of_merge_write(unsignedinteger ai_first_row, unsignedinteger ai_first_col, unsignedinteger ai_last_row, unsignedinteger ai_last_col, blob ab_unicode_str, n_xls_format anvo_format) returns integer
	integer li_ret = 1
	unsignedinteger li_rwfirst
	unsignedinteger li_colfirst
	unsignedinteger li_rwlast
	unsignedinteger li_collast
	unsignedinteger li_i
	unsignedinteger li_j
	n_xls_format_v97 lnvo_format
	li_rwfirst = ai_first_row
	li_colfirst = ai_first_col
	li_rwlast = ai_last_row
	li_collast = ai_last_col
	if li_rwfirst = li_rwlast and li_colfirst = li_collast then
		messagebox("Error", "Can't merge single cell", stopsign!)
		return -1
	end if
	if li_rwfirst > li_rwlast then
		li_rwfirst = ai_last_row
		li_rwlast = ai_first_row
	end if
	if li_colfirst > li_collast then
		li_colfirst = ai_last_col
		li_collast = ai_first_col
	end if
	if not isnull(anvo_format) and isvalid(anvo_format) then
		lnvo_format = anvo_format
		lnvo_format.of_set_merge_range()
	end if
	of_write(li_rwfirst, li_colfirst, ab_unicode_str, anvo_format)
	for li_i = li_rwfirst to li_rwlast
		for li_j = li_colfirst to li_collast
			if not (li_i = li_rwfirst and li_j = li_colfirst) then
				of_write(li_i, li_j, anvo_format)
			end if
		next
	next
	of_merge_cells(li_rwfirst, li_colfirst, li_rwlast, li_collast)
	return li_ret

// n_xls_worksheet_v97.of_merge_write(unsignedinteger ai_first_row, unsignedinteger ai_first_col, unsignedinteger ai_last_row, unsignedinteger ai_last_col, datetime adt_datetime, n_xls_format anvo_format) returns integer
	double ld_val
	time lt_time
	string ls_time
	integer li_hour
	integer li_minute
	integer li_second
	lt_time = time(adt_datetime)
	ls_time = string(lt_time)
	lt_time = time(ls_time)
	li_hour = hour(lt_time)
	li_minute = minute(lt_time)
	li_second = second(lt_time)
	ld_val = daysafter(date("1899-12-30"), date(adt_datetime)) + (li_second + li_minute * 60 + li_hour * 3600) / (24 * 3600)
	return of_merge_write(ai_first_row, ai_first_col, ai_last_row, ai_last_col, ld_val, anvo_format)

// n_xls_worksheet_v97.of_merge_write(unsignedinteger ai_first_row, unsignedinteger ai_first_col, unsignedinteger ai_last_row, unsignedinteger ai_last_col, date ad_date, n_xls_format anvo_format) returns integer
	double ld_val
	ld_val = daysafter(date("1899-12-30"), ad_date)
	return of_merge_write(ai_first_row, ai_first_col, ai_last_row, ai_last_col, ld_val, anvo_format)

// n_xls_worksheet_v97.of_merge_write(unsignedinteger ai_first_row, unsignedinteger ai_first_col, unsignedinteger ai_last_row, unsignedinteger ai_last_col, n_xls_format anvo_format) returns integer
	integer li_ret = 1
	unsignedinteger li_rwfirst
	unsignedinteger li_colfirst
	unsignedinteger li_rwlast
	unsignedinteger li_collast
	unsignedinteger li_i
	unsignedinteger li_j
	n_xls_format_v97 lnvo_format
	li_rwfirst = ai_first_row
	li_colfirst = ai_first_col
	li_rwlast = ai_last_row
	li_collast = ai_last_col
	if li_rwfirst = li_rwlast and li_colfirst = li_collast then
		messagebox("Error", "Can't merge single cell", stopsign!)
		return -1
	end if
	if li_rwfirst > li_rwlast then
		li_rwfirst = ai_last_row
		li_rwlast = ai_first_row
	end if
	if li_colfirst > li_collast then
		li_colfirst = ai_last_col
		li_collast = ai_first_col
	end if
	if not isnull(anvo_format) and isvalid(anvo_format) then
		lnvo_format = anvo_format
		lnvo_format.of_set_merge_range()
	end if
	of_write(li_rwfirst, li_colfirst, anvo_format)
	for li_i = li_rwfirst to li_rwlast
		for li_j = li_colfirst to li_collast
			if not (li_i = li_rwfirst and li_j = li_colfirst) then
				of_write(li_i, li_j, anvo_format)
			end if
		next
	next
	of_merge_cells(li_rwfirst, li_colfirst, li_rwlast, li_collast)
	return li_ret

// n_xls_worksheet_v97.of_append_data(blob ab_data) returns integer
	integer li_ret = 1
	if len(ab_data) > this.ii_limit then
		ab_data = of_add_continue(ab_data)
	end if
	this.il_datasize = this.il_datasize + len(ab_data)
	this.invo_data.of_append(ab_data)
	return li_ret

// n_xls_worksheet_v97.of_add_continue(blob ab_data) returns blob
	unsignedinteger li_record = 60
	blob lb_header
	blob lb_tmp
	unsignedlong ll_start_pos = 1
	lb_tmp = blobmid(ab_data, 1, this.ii_limit)
	ab_data = blobmid(ab_data, this.ii_limit + 1, len(ab_data) - this.ii_limit)
	blobedit(lb_tmp, 3, this.invo_sub.of_pack("v", this.ii_limit - 4))
	do while len(ab_data) > this.ii_limit
		lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", this.ii_limit)
		lb_tmp = lb_header + lb_tmp
		lb_tmp = blobmid(ab_data, 1, this.ii_limit) + lb_tmp
		ab_data = blobmid(ab_data, this.ii_limit + 1, len(ab_data) - this.ii_limit)
	loop
	if len(ab_data) > 0 then
		lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", len(ab_data))
		lb_tmp = lb_header + lb_tmp
		lb_tmp = ab_data + lb_tmp
	end if
	return lb_tmp

// n_xls_worksheet_v97.of_sort_pagebreaks(unsignedinteger[] ai_page_breaks) returns integer
	integer li_ret = 1
	n_associated_ulong_srv invo_key_breaks
	unsignedinteger li_cnt
	unsignedinteger li_i
	unsignedinteger li_start = 1
	unsignedlong ll_ind
	unsignedinteger[] li_new
	invo_key_breaks = create n_associated_ulong_srv
	li_cnt = upperbound(ai_page_breaks)
	for li_i = li_start to li_cnt
		if ai_page_breaks[li_i] > 0 then
			ll_ind = invo_key_breaks.of_get_key_index(ai_page_breaks[li_i])
			if ll_ind = 0 then
				invo_key_breaks.of_add_key(ai_page_breaks[li_i])
			end if
		end if
	next
	invo_key_breaks.of_sort_keys()
	li_cnt = invo_key_breaks.of_get_keys_count()
	for li_i = li_start to li_cnt
		li_new[li_i] = invo_key_breaks.of_get_key(li_i)
	next
	ai_page_breaks = li_new
	return li_ret

// n_xls_worksheet_v97.of_check_dimensions(unsignedlong al_row, unsignedlong al_col) returns integer
	integer li_ret = 1
	if al_row > this.il_xls_rowmax then
		return -2
	end if
	if al_col > this.il_xls_colmax then
		return -2
	end if
	this.ib_dim_changed = true
	if al_row < this.il_dim_rowmin then
		this.il_dim_rowmin = al_row
	end if
	if al_row > this.il_dim_rowmax then
		this.il_dim_rowmax = al_row
	end if
	if al_col < this.il_dim_colmin then
		this.il_dim_colmin = al_col
	end if
	if al_col > this.il_dim_colmax then
		this.il_dim_colmax = al_col
	end if
	return li_ret

// n_xls_worksheet_v97.of_store_dimensions() returns integer
	integer li_ret = 1
	unsignedinteger li_record = 512
	unsignedinteger li_length = 14
	unsignedinteger li_row_min
	unsignedinteger li_row_max
	unsignedinteger li_col_min
	unsignedinteger li_col_max
	unsignedinteger li_reserved
	blob lb_header
	blob lb_data
	if this.ib_dim_changed then
		li_row_min = this.il_dim_rowmin
		li_row_max = this.il_dim_rowmax + 1
		li_col_min = this.il_dim_colmin
		li_col_max = this.il_dim_colmax + 1
	else
		li_row_min = 0
		li_row_max = 0
		li_col_min = 0
		li_col_max = 256
	end if
	lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
	lb_data = this.invo_sub.of_pack("V", li_row_min) + this.invo_sub.of_pack("V", li_row_max) + this.invo_sub.of_pack("v", li_col_min) + this.invo_sub.of_pack("v", li_col_max) + this.invo_sub.of_pack("v", li_reserved)
	of_append_header(lb_header + lb_data)
	return li_ret

// n_xls_worksheet_v97.of_store_window2() returns integer
	integer li_ret = 1
	unsignedinteger li_record = 574
	unsignedinteger li_length = 18
	blob lb_header
	blob lb_data
	unsignedinteger li_grbit = 182
	unsignedinteger li_rwtop
	unsignedinteger li_colleft
	integer li_fdspfmla
	integer li_fdspgrid
	integer li_fdsprwcol = 1
	integer li_ffrozen
	integer li_fdspzeros = 1
	integer li_fdefaulthdr = 1
	integer li_farabic
	integer li_fdspguts = 1
	integer li_ffrozennosplit
	integer li_fselected
	integer li_fpaged = 1
	if this.ib_screen_gridlines then
		li_fdspgrid = 1
	end if
	if this.ib_frozen then
		li_ffrozen = 1
	end if
	if this.ib_selected then
		li_fselected = 1
	end if
	li_grbit = li_fdspfmla
	li_grbit = li_fdspgrid * 2 + li_grbit
	li_grbit = li_fdsprwcol * 4 + li_grbit
	li_grbit = li_ffrozen * 8 + li_grbit
	li_grbit = li_fdspzeros * 16 + li_grbit
	li_grbit = li_fdefaulthdr * 32 + li_grbit
	li_grbit = li_farabic * 64 + li_grbit
	li_grbit = li_fdspguts * 128 + li_grbit
	li_grbit = li_ffrozennosplit * 256 + li_grbit
	li_grbit = li_fselected * 512 + li_grbit
	li_grbit = li_fpaged * 1024 + li_grbit
	lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
	lb_data = this.invo_sub.of_pack("v", li_grbit) + this.invo_sub.of_pack("v", li_rwtop) + this.invo_sub.of_pack("v", li_colleft) + this.invo_sub.of_pack("v", 64) + this.invo_sub.of_pack("v", 0) + this.invo_sub.of_pack("v", 0) + this.invo_sub.of_pack("v", 0) + this.invo_sub.of_pack("V", 0)
	of_append_data(lb_header + lb_data)
	return li_ret

// n_xls_worksheet_v97.of_store_defcol() returns integer
	integer li_ret = 1
	unsignedinteger li_record = 85
	unsignedinteger li_length = 2
	blob lb_header
	blob lb_data
	unsignedinteger li_colwidth = 8
	lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
	lb_data = this.invo_sub.of_pack("v", li_colwidth)
	of_append_header(lb_header + lb_data)
	return li_ret

// n_xls_worksheet_v97.of_store_colinfo(n_xls_colinfo anvo_colinfo) returns integer
	integer li_ret = 1
	unsignedinteger li_record = 125
	unsignedinteger li_length = 11
	blob lb_header
	blob lb_data
	unsignedinteger li_coldx
	unsignedinteger li_ixfe = 15
	unsignedinteger li_grbit
	unsignedinteger li_reserved
	n_xls_format_v97 lnvo_format
	li_coldx = of_get_excel_width(anvo_colinfo.id_width)
	if anvo_colinfo.ib_hidden then
		li_grbit = 1
	end if
	if not isnull(anvo_colinfo.invo_format) and isvalid(anvo_colinfo.invo_format) then
		lnvo_format = anvo_colinfo.invo_format
		li_ixfe = this.invo_workbook.of_get_xf(lnvo_format)
	end if
	lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
	lb_data = this.invo_sub.of_pack("v", anvo_colinfo.ii_firstcol) + this.invo_sub.of_pack("v", anvo_colinfo.ii_lastcol) + this.invo_sub.of_pack("v", li_coldx) + this.invo_sub.of_pack("v", li_ixfe) + this.invo_sub.of_pack("v", li_grbit) + this.invo_sub.of_pack("C", li_reserved)
	of_append_header(lb_header + lb_data)
	return li_ret

// n_xls_worksheet_v97.of_store_selection(n_xls_selection anvo_selection) returns integer
	integer li_ret = 1
	unsignedinteger li_record = 29
	unsignedinteger li_length = 15
	blob lb_header
	blob lb_data
	unsignedinteger li_pnn
	unsignedinteger li_irefact
	unsignedinteger li_cref = 1
	unsignedinteger li_rwact
	unsignedinteger li_colact
	unsignedinteger li_rwfirst
	unsignedinteger li_rwlast
	unsignedinteger li_colfirst
	unsignedinteger li_collast
	li_pnn = this.ii_active_pane
	li_rwact = anvo_selection.ii_first_row
	li_colact = anvo_selection.ii_first_col
	if anvo_selection.ii_first_row > anvo_selection.ii_last_row then
		li_rwfirst = anvo_selection.ii_last_row
		li_rwlast = anvo_selection.ii_first_row
	else
		li_rwfirst = anvo_selection.ii_first_row
		li_rwlast = anvo_selection.ii_last_row
	end if
	if anvo_selection.ii_first_col > anvo_selection.ii_last_col then
		li_colfirst = anvo_selection.ii_last_col
		li_collast = anvo_selection.ii_first_col
	else
		li_colfirst = anvo_selection.ii_first_col
		li_collast = anvo_selection.ii_last_col
	end if
	lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
	lb_data = this.invo_sub.of_pack("C", li_pnn) + this.invo_sub.of_pack("v", li_rwact) + this.invo_sub.of_pack("v", li_colact) + this.invo_sub.of_pack("v", li_irefact) + this.invo_sub.of_pack("v", li_cref) + this.invo_sub.of_pack("v", li_rwfirst) + this.invo_sub.of_pack("v", li_rwlast) + this.invo_sub.of_pack("C", li_colfirst) + this.invo_sub.of_pack("C", li_collast)
	of_append_data(lb_header + lb_data)
	return li_ret

// n_xls_worksheet_v97.of_store_externsheet(string as_sheetname) returns integer
	integer li_ret = 1
	unsignedinteger li_record = 23
	unsignedinteger li_length
	blob lb_header
	blob lb_data
	unsignedinteger li_cch
	unsignedinteger li_rgch
	if this.is_worksheetname = as_sheetname then
		as_sheetname = ""
		li_length = 2
		li_cch = 1
		li_rgch = 2
	else
		li_length = 2 + len(as_sheetname)
		li_cch = len(as_sheetname)
		li_rgch = 3
	end if
	lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
	lb_data = this.invo_sub.of_pack("C", li_cch) + this.invo_sub.of_pack("C", li_rgch)
	if len(as_sheetname) > 0 then
		lb_data = lb_data + blob(as_sheetname)
	end if
	of_append_header(lb_header + lb_data)
	return li_ret

// n_xls_worksheet_v97.of_store_panes(n_xls_panes anvo_panes) returns integer
	integer li_ret = 1
	unsignedinteger li_record = 65
	unsignedinteger li_length = 10
	blob lb_header
	blob lb_data
	unsignedinteger li_y
	unsignedinteger li_x
	unsignedinteger li_rwtop
	unsignedinteger li_colleft
	unsignedinteger li_pnnact
	if this.ib_frozen then
		li_y = anvo_panes.id_y
		li_x = anvo_panes.id_x
		if isnull(anvo_panes.ii_rowtop) then
			li_rwtop = li_y
		else
			li_rwtop = anvo_panes.ii_rowtop
		end if
		if isnull(anvo_panes.ii_colleft) then
			li_colleft = li_x
		else
			li_colleft = anvo_panes.ii_colleft
		end if
	else
		if isnull(anvo_panes.ii_rowtop) then
			li_rwtop = 0
		else
			li_rwtop = anvo_panes.ii_rowtop
		end if
		if isnull(anvo_panes.ii_colleft) then
			li_colleft = 0
		else
			li_colleft = anvo_panes.ii_colleft
		end if
		li_y = 20.0 * anvo_panes.id_y + 255.0
		li_x = 113.879 * anvo_panes.id_x + 390.0
	end if
	if li_x <> 0 and li_y <> 0 then
		li_pnnact = 0
	end if
	if li_x <> 0 and li_y = 0 then
		li_pnnact = 1
	end if
	if li_x = 0 and li_y <> 0 then
		li_pnnact = 2
	end if
	if li_x = 0 and li_y = 0 then
		li_pnnact = 3
	end if
	this.ii_active_pane = li_pnnact
	lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
	lb_data = this.invo_sub.of_pack("v", li_x) + this.invo_sub.of_pack("v", li_y) + this.invo_sub.of_pack("v", li_rwtop) + this.invo_sub.of_pack("v", li_colleft) + this.invo_sub.of_pack("v", li_pnnact)
	of_append_data(lb_header + lb_data)
	return li_ret

// n_xls_worksheet_v97.of_store_setup() returns integer
	integer li_ret = 1
	unsignedinteger li_record = 161
	unsignedinteger li_length = 34
	blob lb_header
	blob lb_data
	unsignedinteger li_ipagestart = 1
	unsignedinteger li_grbit
	unsignedinteger li_ires = 600
	unsignedinteger li_ivres = 600
	unsignedinteger li_icopies = 1
	unsignedinteger li_flefttoright
	unsignedinteger li_flandscape
	unsignedinteger li_fnopls
	unsignedinteger li_fnocolor
	unsignedinteger li_fdraft
	unsignedinteger li_fnotes
	unsignedinteger li_fnoorient
	unsignedinteger li_fusepage
	li_flandscape = this.ii_orientation
	li_grbit = li_flefttoright
	li_grbit = li_flandscape * 2 + li_grbit
	li_grbit = li_fnopls * 4 + li_grbit
	li_grbit = li_fnocolor * 8 + li_grbit
	li_grbit = li_fdraft * 16 + li_grbit
	li_grbit = li_fnotes * 32 + li_grbit
	li_grbit = li_fnoorient * 64 + li_grbit
	li_grbit = li_fusepage * 128 + li_grbit
	lb_header = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length)
	lb_data = this.invo_sub.of_pack("v", this.ii_paper_size) + this.invo_sub.of_pack("v", this.ii_print_scale) + this.invo_sub.of_pack("v", li_ipagestart) + this.invo_sub.of_pack("v", this.ii_fit_width) + this.invo_sub.of_pack("v", this.ii_fit_height) + this.invo_sub.of_pack("v", li_grbit) + this.invo_sub.of_pack("v", li_ires) + this.invo_sub.of_pack("v", li_ivres) + this.invo_sub.of_pack("d", this.id_margin_head) + this.invo_sub.of_pack("d", this.id_margin_foot) + this.invo_sub.of_pack("v", li_icopies)
	of_append_header(lb_header + lb_data)
	return li_ret

