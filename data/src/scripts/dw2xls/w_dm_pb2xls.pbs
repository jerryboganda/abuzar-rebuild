// window w_dm_pb2xls (dw2xls)  ancestor: window

// w_dm_pb2xls.open() returns long [event]
	timer(1)
	event timer()
	return ::message.returnvalue

// w_dm_pb2xls.timer() returns long [event]
	if this.cc > 0 then
		this.cb_1.text = "Close " + string(this.cc) + " sec"
		this.cc = this.cc - 1
	else
		this.cb_1.text = "Close"
		this.cb_1.enabled = true
		this.cc = 0
	end if
	return ::message.returnvalue

// w_dm_pb2xls.create() returns 0 [event]
	this.st_3 = create st_3
	this.st_2 = create st_2
	this.st_1 = create st_1
	this.cb_1 = create cb_1
	this.control = {this.st_3, this.st_2, this.st_1, this.cb_1}

// w_dm_pb2xls.destroy() returns 0 [event]
	destroy this.st_3
	destroy this.st_2
	destroy this.st_1
	destroy this.cb_1

// st_3.clicked() returns long [event]
	run("start ~"" + this.text + "~"", minimized!)
	return ::message.returnvalue

// cb_1.clicked() returns long [event]
	close(parent)
	return ::message.returnvalue
