// userobject n_dwr_sub (dw2xls)  ancestor: nonvisualobject

// n_dwr_sub.of_gettemppath() returns string
	string ls_path
	unsignedlong ls_len
	unsignedlong ls_buff_size
	ls_path = space(ls_buff_size)
	ls_len = gettemppath(ls_buff_size, ls_path)
	if ls_len > 0 then
		return ""
	end if
	return ""

// n_dwr_sub.of_get_coef_x(integer a_units) returns double
	choose case a_units
	case 0
		return this.id_x_coef_0
	case 1
		return this.id_x_coef_1
	case 2
		return this.id_x_coef_2
	case 3
		return this.id_x_coef_3
	end choose
	return this.id_x_coef_0

// n_dwr_sub.of_set_cur_units(integer ai_units) returns 0
	this.id_cur_x_coef = of_get_coef_x(ai_units)
	this.id_cur_y_coef = of_get_coef_y(ai_units)

// n_dwr_sub.of_get_cur_coef_x() returns double
	return this.id_cur_x_coef

// n_dwr_sub.of_get_coef_y(integer a_units) returns double
	choose case a_units
	case 0
		return this.id_y_coef_0
	case 1
		return this.id_y_coef_1
	case 2
		return this.id_y_coef_2
	case 3
		return this.id_y_coef_3
	end choose
	return this.id_y_coef_0

// n_dwr_sub.of_get_cur_coef_y() returns double
	return this.id_cur_y_coef

// n_dwr_sub.of_get_conv_x() returns double
	return of_get_cur_coef_x() / of_get_coef_x(0)

// n_dwr_sub.of_get_conv_y() returns double
	return of_get_coef_y(0) / of_get_cur_coef_y()

// n_dwr_sub.of_get_pen_width_coef(integer a_units) returns double
	return of_get_coef_x(0) / of_get_coef_x(a_units) * this.id_pen_width_coef_0

// n_dwr_sub.of_get_pen_height_coef(integer a_units) returns double
	return of_get_coef_y(0) / of_get_coef_y(a_units) * this.id_pen_height_coef_0

// n_dwr_sub.create() returns 0
	call super::create
	triggerevent("constructor")

// n_dwr_sub.destroy() returns 0
	triggerevent("destructor")
	call super::destroy

// n_dwr_sub.constructor() returns long
	unsignedinteger li_hdc
	long lci_logpixelsx
	long lci_logpixelsy
	long ll_pixelsperinchx
	long ll_pixelsperinchy
	li_hdc = getdc(0)
	ll_pixelsperinchx = getdevicecaps(li_hdc, 88)
	ll_pixelsperinchy = getdevicecaps(li_hdc, 90)
	li_hdc = releasedc(0, li_hdc)
	if ll_pixelsperinchx = 0 then
		ll_pixelsperinchx = 96
	end if
	if ll_pixelsperinchy = 0 then
		ll_pixelsperinchy = 96
	end if
	this.id_x_coef_1 = this.id_x_coef_0 * unitstopixels(100, xunitstopixels!) / 100.0
	this.id_x_coef_2 = 1000.0 * this.id_x_coef_1 / ll_pixelsperinchx
	this.id_x_coef_3 = this.id_x_coef_2 * 2.54
	this.id_y_coef_1 = this.id_y_coef_0 * unitstopixels(100, yunitstopixels!) / 100.0
	this.id_y_coef_2 = 1000.0 * this.id_y_coef_1 / ll_pixelsperinchy
	this.id_y_coef_3 = this.id_y_coef_2 * 2.54
	return ::message.returnvalue
