	end choose
	if isnumber(ls_val) then
		return long(ls_val)
	end if
	return -1

// n_dwr_field.of_get_width(long al_row) returns long
	long ll_ret
	if this.is_expr_width = "" then
		ll_ret = this.il_cached_width
	elseif this.is_expr_width = "-" then
		this.il_cached_width = of_describe_expr(this.is_dwo_name + ".width", al_row, this.is_expr_width)
		ll_ret = this.il_cached_width
	else
		ll_ret = of_evaluate0(this.is_expr_width, al_row)
	end if
	return ll_ret

// n_dwr_field.of_get_height(long al_row) returns long
	long ll_ret
	long ll_pos
	long ll_lines_cnt = 1
	long ll_row_height
	long ll_row_width
	long ll_i = 1
	long ll_start = 1
	long ll_val
	long ll_col_width
	string ls_type
	string ls_val
	string[] ls_str_array
	if this.is_expr_height = "" then
		ll_ret = this.il_cached_height
	elseif this.is_expr_height = "-" then
		this.il_cached_height = of_describe_expr(this.is_dwo_name + ".height", al_row, this.is_expr_height)
		if this.ii_dwo_type = 1 or this.ii_dwo_type = 2 or this.ii_dwo_type = 3 then
			if this.inv_parm.ib_enable_merge_cells then
				if this.inv_parent_band.ii_dw_processing = 1 and this.inv_parent_band.ii_band_type = 3 and this.inv_parm.ib_grid_columns_by_rowheight then
					ll_val = long(of_describe("evaluate('rowheight()', " + string(al_row) + ")"))
					ll_ret = ll_val - of_get_y1()
					this.is_expr_height = "-"
				elseif this.ib_autosize_height and not this.inv_parm.ib_ignore_autosizeheight then
					ls_val = string(of_getvalue(al_row))
					ll_col_width = of_get_width(al_row)
					ll_val = of_get_col_height_font(ll_col_width, ls_val, of_descr_font_face(), of_descr_font_italic(), of_descr_font_underline(), of_descr_font_weight2(), of_descr_font_height())
					ll_ret = ll_val
					this.is_expr_height = "-"
				else
					ll_ret = this.il_cached_height
				end if
			else
				ll_ret = this.il_cached_height
			end if
		else
			ll_ret = this.il_cached_height
		end if
	else
		ll_ret = of_evaluate0(this.is_expr_height, al_row)
	end if
	return ll_ret

