// userobject n_dwr_field (dw2xls)  ancestor: nonvisualobject

// n_dwr_field.of_getvalue(long al_row) returns any
	choose case this.ipo_requestortype
	case datawindow!
		return of_getvalue_dw(al_row)
	case datastore!
		return of_getvalue_ds(al_row)
	case datawindowchild!
		return of_getvalue_dwc(al_row)
	end choose

// n_dwr_field.of_setformat() returns integer
	integer li_ret = 1
	string ls_format
	integer li_color_index
	long ll_color
	string ls_border_style
	this.inv_format = this.inv_book.of_createformat()
	if li_ret = 1 then
		ls_format = of_descr_numformat()
		if ls_format = "" then
			ls_format = "[General]"
		end if
		ls_format = of_change_format(ls_format, this.is_coltype)
		this.inv_format.setnumformat(this.inv_format.handle, ls_format)
		this.inv_format.setfontname(this.inv_format.handle, of_descr_font_face())
		this.inv_format.setfontsize(this.inv_format.handle, of_descr_font_height())
		if of_descr_font_italic() then
			this.inv_format.setfontitalic(this.inv_format.handle, 1)
		end if
		this.inv_format.setfontunderline(this.inv_format.handle, of_descr_font_underline())
		this.inv_format.setfontweight(this.inv_format.handle, of_descr_font_weight2())
		this.inv_format.sethalign(this.inv_format.handle, of_descr_alignment2())
		this.inv_format.setvalign(this.inv_format.handle, 0)
		if this.is_coltype = "s" then
			this.inv_format.setwrap(this.inv_format.handle, 1)
		end if
		ll_color = of_descr_color2()
		this.inv_format.setfgcolor(this.inv_format.handle, ll_color)
		ll_color = of_descr_bg_color2()
		this.inv_format.setbgcolor(this.inv_format.handle, ll_color)
		this.inv_format.setfontcharset(this.inv_format.handle, of_descr_font_charset())
		this.inv_format.setfontfamily(this.inv_format.handle, of_descr_font_family())
		this.inv_format.setrotation(this.inv_format.handle, of_descr_font_escapement())
	end if
	if li_ret = 1 then
		ls_border_style = of_describe(this.is_dwo_name + ".Border")
		if isnumber(ls_border_style) and integer(ls_border_style) > 0 then
			this.inv_format.setborderstyle(this.inv_format.handle, 1)
		elseif integer(of_describe("Datawindow.Processing")) = 1 and this.inv_parm.ib_draw_dw_grid_lines then
			this.inv_format.setborderstyle(this.inv_format.handle, 7)
		end if
		this.ib_custom_format = this.ib_color_expr or this.ib_bg_color_expr or this.ib_alignment_expr or this.ib_font_face_expr or this.ib_font_height_expr or this.ib_font_italic_expr or this.ib_font_underline_expr or this.ib_font_weight_expr or this.ib_format_expr or this.ib_font_escapement_expr
		if not this.ib_custom_format then
			this.il_format_ix = this.inv_book.of_addformat(this.inv_format)
		end if
	end if
	return li_ret

// n_dwr_field.of_get_x1() returns long
	if this.il_cached_x1 = -1 then
		return of_get_x1(1)
	end if
	return this.il_base_x + this.il_cached_x1

// n_dwr_field.of_get_y1(long al_row) returns long
	long ll_ret
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row > this.il_dw_row_count then
		return 0
	end if
	if this.is_expr_y1 = "" then
		ll_ret = this.il_base_y + this.il_cached_y1
	elseif this.is_expr_y1 = "-" then
		this.il_cached_y1 = of_describe_expr(this.is_dwo_name + ".y", al_row, this.is_expr_y1) - this.il_subband_y
		ll_ret = this.il_base_y + this.il_cached_y1
	else
		ll_ret = this.il_base_y + of_evaluate0(this.is_expr_y1, al_row) - this.il_subband_y
	end if
	return ll_ret

// n_dwr_field.of_get_y2(long al_row) returns long
	long ll_ret
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row > this.il_dw_row_count then
		return 0
	end if
	if this.is_expr_y2 = "" then
		ll_ret = this.il_base_y + this.il_cached_y2
	elseif this.is_expr_y2 = "-" then
		ll_ret = of_get_y1(al_row) + of_get_height(al_row)
		this.il_cached_y2 = ll_ret - this.il_base_y
		if this.is_expr_y1 <> "" or this.is_expr_height <> "" then
			this.is_expr_y2 = "*"
		else
			this.is_expr_y2 = ""
		end if
	else
		ll_ret = of_get_y1(al_row) + of_get_height(al_row)
	end if
	return ll_ret

// n_dwr_field.of_get_y1() returns long
	if this.il_cached_y1 = -1000000000 then
		return of_get_y1(1)
	end if
	return this.il_base_y + this.il_cached_y1

// n_dwr_field.of_get_visible(long al_row) returns integer
	integer li_ret
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		li_ret = of_describe_expr(this.is_dwo_name + ".visible", al_row)
	end if
	return li_ret

// n_dwr_field.of_get_y2() returns long
	if this.il_cached_y2 = -1000000000 then
		return of_get_y2(1)
	end if
	return this.il_base_y + this.il_cached_y2

// n_dwr_field.of_get_item_coltype() returns string
	string ls_coltype
	long ll_pos
	long ll_pos_dec
	ls_coltype = trim(lower(of_describe(this.is_dwo_name + ".coltype")))
	ll_pos = pos(ls_coltype, "(")
	if ll_pos > 0 then
		ll_pos_dec = pos(ls_coltype, ",", ll_pos)
		if ll_pos_dec <= 0 then
			ll_pos_dec = pos(ls_coltype, ")", ll_pos)
		end if
		this.ii_colsize = integer(mid(ls_coltype, ll_pos + 1, ll_pos_dec - ll_pos - 1))
		ls_coltype = trim(left(ls_coltype, ll_pos - 1))
	end if
	choose case ls_coltype
	case "char", "string"
		ls_coltype = "s"
	case "decimal", "int", "long", "ulong", "number", "real", "integer"
		ls_coltype = "n"
	case "date"
		ls_coltype = "d"
	case "datetime", "timestamp"
		ls_coltype = "dt"
	case "time"
		ls_coltype = "t"
	case else
		ls_coltype = "-"
	end choose
	return ls_coltype

// n_dwr_field.of_describe_expr(string as_expr, long al_row) returns long
	string ls_val
	long ll_pos
	n_dwr_string lnvo_str
	choose case this.ipo_requestortype
	case datawindow!
		ls_val = this.idw_requestor.describe(as_expr)
	case datastore!
		ls_val = this.ids_requestor.describe(as_expr)
	case datawindowchild!
		ls_val = this.idwc_requestor.describe(as_expr)
	case else
		return -1
	end choose
	ll_pos = pos(ls_val, "~t")
	if ll_pos > 0 then
		ls_val = mid(ls_val, ll_pos + 1, len(ls_val) - ll_pos - 1)
		ls_val = lnvo_str.of_globalreplace(ls_val, "'", "~~'")
		choose case this.ipo_requestortype
		case datawindow!
			ls_val = this.idw_requestor.describe("evaluate(~"" + ls_val + "~", " + string(al_row) + ")")
		case datastore!
			ls_val = this.ids_requestor.describe("evaluate(~"" + ls_val + "~", " + string(al_row) + ")")
		case datawindowchild!
			ls_val = this.idwc_requestor.describe("evaluate(~"" + ls_val + "~", " + string(al_row) + ")")
		case else
			return -1
		end choose
		if isnumber(ls_val) then
			return long(ls_val)
		end if
	elseif isnumber(ls_val) then
		return long(ls_val)
	end if
	return -1

// n_dwr_field.of_unquote(string as_str) returns string
	long ll_pos
	if left(as_str, 1) = "~"" and right(as_str, 1) = "~"" then
		as_str = mid(as_str, 2, len(as_str) - 2)
	end if
	ll_pos = pos(as_str, "~~~"")
	do while ll_pos > 0
		as_str = replace(as_str, ll_pos, 2, "~"")
		ll_pos = pos(as_str, "~~~"")
	loop
	return as_str

// n_dwr_field.of_change_format(string as_format, string as_type) returns string
	long ll_pos
	n_dwr_string lnvo_str
	string[] ls_arr
	string[] ls_emp
	long ll_cnt
	long ll_i
	long ll_ret
	as_format = lower(as_format)
	if not this.inv_book.ib_system_format_cached then
		ll_ret = registryget("HKEY_CURRENT_USER\Control Panel\International", "sShortDate", regstring!, this.inv_book.is_system_shortdate_format)
		if ll_ret <> 1 then
			this.inv_book.is_system_shortdate_format = "dd.MM.yyyy"
		end if
		ll_ret = registryget("HKEY_CURRENT_USER\Control Panel\International", "sLongDate", regstring!, this.inv_book.is_system_longdate_format)
		if ll_ret <> 1 then
			this.inv_book.is_system_longdate_format = "dd MMMM yyyy"
		end if
		ll_ret = registryget("HKEY_CURRENT_USER\Control Panel\International", "sTimeFormat", regstring!, this.inv_book.is_system_time_format)
		if ll_ret <> 1 then
			this.inv_book.is_system_time_format = "HH:mm"
		end if
		this.inv_book.is_system_time_format = lnvo_str.of_globalreplace(this.inv_book.is_system_time_format, "tt", "AM/PM")
		this.inv_book.is_system_date_format = this.inv_book.is_system_shortdate_format
		this.inv_book.is_system_currency_format = of_get_system_currency_format()
		ll_cnt = lnvo_str.of_parsetoarray(this.inv_book.is_system_currency_format, ";", this.inv_book.is_system_currency_format_parts)
		for ll_i = upperbound(this.inv_book.is_system_currency_format_parts) + 1 to 3
			this.inv_book.is_system_currency_format_parts[ll_i] = this.inv_book.is_system_currency_format_parts[1]
		next
		this.inv_book.ib_system_format_cached = true
	end if
	ll_pos = pos(as_format, "@")
	if ll_pos > 0 then
		as_format = "[general]"
	end if
	ll_cnt = lnvo_str.of_parsetoarray(as_format, ";", ls_arr)
	choose case as_type
	case "n"
		if ll_cnt > 3 then
			ll_cnt = 3
		end if
	case else
		if ll_cnt > 1 then
			ll_cnt = 1
		end if
	end choose
	for ll_i = 1 to ll_cnt
		ls_emp[ll_i] = lnvo_str.of_globalreplace(ls_arr[ll_i], "'", "~"")
		ls_emp[ll_i] = lnvo_str.of_globalreplace(ls_emp[ll_i], "@", "General")
		ls_emp[ll_i] = lnvo_str.of_globalreplace(ls_emp[ll_i], "[currency]", this.inv_book.is_system_currency_format_parts[ll_i])
	next
	lnvo_str.of_arraytostring(ls_emp, ";", as_format)
	if this.is_coltype = "d" then
		as_format = lnvo_str.of_globalreplace(as_format, "[general]", "[shortdate]")
	elseif this.is_coltype = "dt" then
		as_format = lnvo_str.of_globalreplace(as_format, "[general]", "[shortdate]")
	elseif this.is_coltype = "t" then
		as_format = lnvo_str.of_globalreplace(as_format, "[general]", "[time]")
	else
		as_format = lnvo_str.of_globalreplace(as_format, "[general]", "General")
	end if
	as_format = lnvo_str.of_globalreplace(as_format, "[shortdate]", this.inv_book.is_system_shortdate_format)
	as_format = lnvo_str.of_globalreplace(as_format, "[longdate]", this.inv_book.is_system_longdate_format)
	as_format = lnvo_str.of_globalreplace(as_format, "[date]", this.inv_book.is_system_date_format)
	as_format = lnvo_str.of_globalreplace(as_format, "[time]", this.inv_book.is_system_time_format)
	if this.ii_colsize > 255 or this.ii_dwo_type = 2 and as_type = "s" then
		if this.ib_use_general_for_large_cols then
			as_format = "General"
		else
			as_format = ""
		end if
	end if
	return as_format

// n_dwr_field.of_set_color(n_xls_format a_format, long al_row) returns integer
	long ll_color
	integer li_color_index
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ll_color = long(of_describe("evaluate(~"" + this.is_color_expr + "~", " + string(al_row) + ")"))
		if ll_color >= 0 then
			li_color_index = this.invo_colors.of_get_custom_color_index(ll_color)
			if li_color_index > 0 then
				a_format.of_set_color(li_color_index)
			end if
		end if
	end if
	return 1

// n_dwr_field.of_set_bg_color(n_xls_format a_format, long al_row) returns integer
	long ll_color
	integer li_color_index
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ll_color = long(of_describe("evaluate(~"" + this.is_bg_color_expr + "~", " + string(al_row) + ")"))
		if ll_color >= 0 then
			li_color_index = this.invo_colors.of_get_custom_color_index(ll_color)
			if li_color_index > 0 then
				a_format.of_set_bg_color(li_color_index)
			end if
		end if
	end if
	return 1

// n_dwr_field.of_check_property(string as_property_name, boolean ab_is_expression, string as_expression, string as_value) returns integer
	integer li_ret
	string ls_str
	long ll_pos
	if left(as_property_name, 2) = "::" then
		choose case this.ipo_requestortype
		case datawindow!
			ls_str = this.idw_requestor.describe(mid(as_property_name, 3))
		case datastore!
			ls_str = this.ids_requestor.describe(mid(as_property_name, 3))
		case datawindowchild!
			ls_str = this.idwc_requestor.describe(mid(as_property_name, 3))
		case else
			return -1
		end choose
	else
		choose case this.ipo_requestortype
		case datawindow!
			ls_str = this.idw_requestor.describe(this.is_dwo_name + "." + as_property_name)
		case datastore!
			ls_str = this.ids_requestor.describe(this.is_dwo_name + "." + as_property_name)
		case datawindowchild!
			ls_str = this.idwc_requestor.describe(this.is_dwo_name + "." + as_property_name)
		case else
			return -1
		end choose
	end if
	if ls_str <> "!" and ls_str <> "?" and ls_str <> "" then
		ll_pos = pos(lower(ls_str), "~t")
		if ll_pos > 0 then
			as_expression = right(ls_str, len(ls_str) - ll_pos)
			if right(as_expression, 1) = "~"" then
				as_expression = left(as_expression, len(as_expression) - 1)
			end if
			ab_is_expression = trim(as_expression) <> ""
			ls_str = left(ls_str, ll_pos - 1)
			if left(ls_str, 1) = "~"" then
				ls_str = right(ls_str, len(ls_str) - 1)
			end if
		end if
		as_value = ls_str
		li_ret = 1
	else
		li_ret = -1
	end if
	return li_ret

// n_dwr_field.of_descr_numformat() returns string
	integer li_ret
	string ls_value = "-1"
	li_ret = of_check_property("Format", this.ib_format_expr, this.is_format_expr, ls_value)
	if li_ret = 1 then
		return ls_value
	end if
	return ""

// n_dwr_field.of_descr_font_face() returns string
	integer li_ret = -1
	string ls_value
	li_ret = of_check_property("Font.Face", this.ib_font_face_expr, this.is_font_face_expr, ls_value)
	if li_ret = 1 then
		return ls_value
	end if
	return "Arial"

// n_dwr_field.of_descr_font_height() returns long
	integer li_ret
	string ls_value
	li_ret = of_check_property("Font.Height", this.ib_font_height_expr, this.is_font_height_expr, ls_value)
	if li_ret = 1 then
		if isnumber(ls_value) then
			return abs(integer(ls_value))
		else
			return 10
		end if
		return
	end if
	return 10

// n_dwr_field.of_descr_font_italic() returns boolean
	integer li_ret
	string ls_value
	li_ret = of_check_property("Font.Italic", this.ib_font_italic_expr, this.is_font_italic_expr, ls_value)
	if li_ret = 1 then
		return lower(ls_value) = "yes" or ls_value = "1"
	end if
	return false

// n_dwr_field.of_descr_font_underline() returns integer
	integer li_ret
	string ls_value
	li_ret = of_check_property("font.underline", this.ib_font_underline_expr, this.is_font_underline_expr, ls_value)
	if li_ret = 1 then
		if lower(ls_value) = "yes" or ls_value = "1" then
			return 1
		else
			return 0
		end if
		return
	end if
	return 0

// n_dwr_field.of_descr_font_weight() returns boolean
	integer li_ret
	string ls_value
	li_ret = of_check_property("font.weight", this.ib_font_weight_expr, this.is_font_weight_expr, ls_value)
	if li_ret = 1 then
		if isnumber(ls_value) then
			return abs(integer(ls_value)) = 700
		else
			return false
		end if
		return
	end if
	return false

// n_dwr_field.of_descr_alignment() returns string
	integer li_ret
	string ls_value
	li_ret = of_check_property("alignment", this.ib_alignment_expr, this.is_alignment_expr, ls_value)
	if li_ret <> 1 then
		ls_value = "-1"
	end if
	choose case ls_value
	case "0"
		return "left"
	case "1"
		return "right"
	case "2"
		return "center"
	case "3"
		return "justified"
	end choose
	if this.is_coltype = "n" then
		return "right"
	end if
	return "left"

// n_dwr_field.of_descr_bg_color() returns integer
	integer li_ret
	string ls_str
	string ls_value
	long ll_color
	ls_str = of_describe(this.is_dwo_name + ".Background.Mode")
	if ls_str <> "1" then
		li_ret = of_check_property("Background.Color", this.ib_bg_color_expr, this.is_bg_color_expr, ls_value)
		if li_ret = 1 then
			if isnumber(ls_value) then
				ll_color = this.invo_colors.of_get_color(long(ls_value))
				return this.invo_colors.of_get_custom_color_index(ll_color)
			else
				return -1
			end if
		else
			return -1
		end if
		return
	end if
	return -1

// n_dwr_field.of_descr_color() returns integer
	integer li_ret
	string ls_value
	long ll_color
	li_ret = of_check_property("Color", this.ib_color_expr, this.is_color_expr, ls_value)
	if li_ret = 1 then
		if isnumber(ls_value) then
			ll_color = this.invo_colors.of_get_color(long(ls_value))
			return this.invo_colors.of_get_custom_color_index(ll_color)
		else
			return -1
		end if
		return
	end if
	return -1

// n_dwr_field.of_eval_bg_color(n_xls_format anvo_format, long al_row) returns integer
	integer li_color_index
	string ls_value
	long ll_color
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ls_value = of_describe("evaluate(~"" + this.is_bg_color_expr + "~", " + string(al_row) + ")")
		if isnumber(ls_value) then
			ll_color = this.invo_colors.of_get_color(long(ls_value))
			li_color_index = this.invo_colors.of_get_custom_color_index(ll_color)
			if li_color_index > 0 then
				anvo_format.of_set_bg_color(li_color_index)
				return 1
			end if
			return
		end if
		return
	end if
	return -1

// n_dwr_field.of_eval_color(n_xls_format anvo_format, long al_row) returns integer
	integer li_color_index
	string ls_value
	long ll_color
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ls_value = of_describe("evaluate(~"" + this.is_color_expr + "~", " + string(al_row) + ")")
		if isnumber(ls_value) then
			ll_color = this.invo_colors.of_get_color(long(ls_value))
			li_color_index = this.invo_colors.of_get_custom_color_index(ll_color)
			if li_color_index > 0 then
				anvo_format.of_set_color(li_color_index)
				return 1
			end if
			return
		end if
		return
	end if
	return -1

// n_dwr_field.of_eval_font_face(n_xls_format anvo_format, long al_row) returns integer
	string ls_value
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ls_value = trim(of_describe("evaluate(~"" + this.is_font_face_expr + "~", " + string(al_row) + ")"))
		if ls_value <> "" then
			anvo_format.of_set_font(ls_value)
			return 1
		end if
		return
	end if
	return -1

// n_dwr_field.of_eval_numformat(n_xls_format anvo_format, long al_row) returns integer
	string ls_value
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ls_value = trim(of_describe("evaluate(~"" + this.is_format_expr + "~", " + string(al_row) + ")"))
		if ls_value = "" then
			ls_value = "[General]"
		end if
		ls_value = of_change_format(ls_value, this.is_coltype)
		anvo_format.of_set_num_format(ls_value)
		return 1
	end if
	return -1

// n_dwr_field.of_eval_font_height(n_xls_format anvo_format, long al_row) returns integer
	string ls_value
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ls_value = of_describe("evaluate(~"" + this.is_font_height_expr + "~", " + string(al_row) + ")")
		if isnumber(ls_value) then
			anvo_format.of_set_size(abs(integer(ls_value)))
			return 1
		end if
		return
	end if
	return -1

// n_dwr_field.of_eval_font_italic(n_xls_format anvo_format, long al_row) returns integer
	string ls_value
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ls_value = of_describe("evaluate(~"" + this.is_font_italic_expr + "~", " + string(al_row) + ")")
		anvo_format.of_set_italic(lower(ls_value) = "yes" or ls_value = "1")
		return 1
	end if
	return -1

// n_dwr_field.of_eval_font_underline(n_xls_format anvo_format, long al_row) returns integer
	string ls_value
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ls_value = of_describe("evaluate(~"" + this.is_font_underline_expr + "~", " + string(al_row) + ")")
		if lower(ls_value) = "yes" or ls_value = "1" then
			anvo_format.of_set_underline(1)
		else
			anvo_format.of_set_underline(0)
		end if
		return 1
	end if
	return -1

// n_dwr_field.of_eval_font_weight(n_xls_format anvo_format, long al_row) returns integer
	string ls_value
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ls_value = of_describe("evaluate(~"" + this.is_font_weight_expr + "~", " + string(al_row) + ")")
		if isnumber(ls_value) then
			anvo_format.of_set_bold(abs(integer(ls_value)) = 700)
		else
			anvo_format.of_set_bold(false)
		end if
		return 1
	end if
	return -1

// n_dwr_field.of_eval_alignment(n_xls_format anvo_format, long al_row) returns integer
	string ls_value
	string ls_align
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ls_value = trim(of_describe("evaluate(~"" + this.is_alignment_expr + "~", " + string(al_row) + ")"))
		choose case ls_value
		case "0"
			ls_align = "left"
		case "1"
			ls_align = "right"
		case "2"
			ls_align = "center"
		case "3"
			ls_align = "justified"
		case else
			if this.is_coltype = "n" then
				ls_align = "right"
			else
				ls_align = "left"
			end if
		end choose
		anvo_format.of_set_align(ls_align)
		return 1
	end if
	return -1

// n_dwr_field.of_get_x1(long al_row) returns long
	long ll_ret
	if this.is_expr_x1 = "" then
		ll_ret = this.il_base_x + this.il_cached_x1
	elseif this.is_expr_x1 = "-" then
		this.il_cached_x1 = of_describe_expr(this.is_dwo_name + ".x", al_row, this.is_expr_x1)
		ll_ret = this.il_base_x + this.il_cached_x1
	else
		ll_ret = this.il_base_x + of_evaluate0(this.is_expr_x1, al_row)
	end if
	return ll_ret

// n_dwr_field.of_get_x2() returns long
	if this.il_cached_x2 = -1 then
		return of_get_x2(1)
	end if
	return this.il_base_x + this.il_cached_x2

// n_dwr_field.of_get_x2(long al_row) returns long
	long ll_ret
	if this.is_expr_x2 = "" then
		ll_ret = this.il_base_x + this.il_cached_x2
	elseif this.is_expr_x2 = "-" then
		ll_ret = of_get_x1(al_row) + of_get_width(al_row)
		this.il_cached_x2 = ll_ret - this.il_base_x
		if this.is_expr_x1 <> "" or this.is_expr_width <> "" then
			this.is_expr_x2 = this.is_expr_x1 + " + " + this.is_expr_width
		else
			this.is_expr_x2 = ""
		end if
	else
		ll_ret = of_get_x1(al_row) + of_get_width(al_row)
	end if
	return ll_ret

// n_dwr_field.of_describe(string as_expr) returns string
	choose case this.ipo_requestortype
	case datawindow!
		return this.idw_requestor.describe(as_expr)
	case datastore!
		return this.ids_requestor.describe(as_expr)
	case datawindowchild!
		return this.idwc_requestor.describe(as_expr)
	end choose
	return "!"

// n_dwr_field.of_getvalue_dw(long al_row) returns any
	datawindow lpo_requestor
	any la_val
	string ls_val
	double ldb_val
	datetime ldt_val
	date ld_val
	time lt_val
	integer li_id
	lpo_requestor = this.ipo_requestor
	setnull(la_val)
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		choose case this.ii_dwo_type
		case 1, 2
			if this.ii_column_display_type = 1 then
				choose case this.is_coltype
				case "s"
					li_id = integer(lpo_requestor.describe(this.is_dwo_name + ".id"))
					if li_id > 0 then
						la_val = lpo_requestor.getitemstring(al_row, li_id)
					else
						la_val = string(lpo_requestor.describe("Evaluate('" + this.is_dwo_name + "', " + string(al_row) + ")"))
					end if
				case "n"
					la_val = lpo_requestor.getitemdecimal(al_row, this.is_dwo_name)
				case "d"
					la_val = lpo_requestor.getitemdate(al_row, this.is_dwo_name)
				case "dt"
					la_val = lpo_requestor.getitemdatetime(al_row, this.is_dwo_name)
				case "t"
					la_val = lpo_requestor.getitemtime(al_row, this.is_dwo_name)
				end choose
			elseif this.ii_column_display_type = 2 then
				choose case this.is_coltype
				case "s"
					la_val = lpo_requestor.getitemstring(al_row, this.is_dwo_name)
				case "n"
					la_val = lpo_requestor.getitemdecimal(al_row, this.is_dwo_name)
				case "d"
					la_val = lpo_requestor.getitemdate(al_row, this.is_dwo_name)
				case "dt"
					la_val = lpo_requestor.getitemdatetime(al_row, this.is_dwo_name)
				case "t"
					la_val = lpo_requestor.getitemtime(al_row, this.is_dwo_name)
				end choose
				if isnull(la_val) then
					la_val = ""
				end if
			elseif this.ii_column_display_type = 3 then
				choose case this.is_coltype
				case "s"
					la_val = lpo_requestor.getitemstring(al_row, this.is_dwo_name)
				case "n"
					la_val = lpo_requestor.getitemdecimal(al_row, this.is_dwo_name)
				case "d"
					la_val = lpo_requestor.getitemdate(al_row, this.is_dwo_name)
				case "dt"
					la_val = lpo_requestor.getitemdatetime(al_row, this.is_dwo_name)
				case "t"
					la_val = lpo_requestor.getitemtime(al_row, this.is_dwo_name)
				end choose
				if this.ib_disable_lookup_display then
					if isnull(la_val) then
						la_val = ""
					end if
				elseif not isnull(la_val) then
					la_val = string(lpo_requestor.describe("Evaluate('LookUpDisplay(" + this.is_dwo_name + ")', " + string(al_row) + ")"))
				else
					la_val = ""
				end if
			else
				choose case this.is_coltype
				case "s"
					la_val = lpo_requestor.getitemstring(al_row, this.is_dwo_name)
				case "n"
					la_val = lpo_requestor.getitemdecimal(al_row, this.is_dwo_name)
				case "d"
					la_val = lpo_requestor.getitemdate(al_row, this.is_dwo_name)
				case "dt"
					la_val = lpo_requestor.getitemdatetime(al_row, this.is_dwo_name)
				case "t"
					la_val = lpo_requestor.getitemtime(al_row, this.is_dwo_name)
				end choose
				if not isnull(la_val) then
					la_val = string(lpo_requestor.describe("Evaluate('LookUpDisplay(" + this.is_dwo_name + ")', " + string(al_row) + ")"))
				else
					la_val = ""
				end if
			end if
		case 3
			if this.is_text_expr <> "" then
				la_val = of_describe_str_expr(this.is_dwo_name + ".Text", al_row)
			else
				la_val = this.is_text
			end if
		case 4
			la_val = "{" + this.is_dwo_name + "}"
		end choose
	end if
	return la_val

