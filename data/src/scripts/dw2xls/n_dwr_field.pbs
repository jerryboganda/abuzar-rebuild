// n_dwr_field.of_createnestedservice(n_dwr_nested_service_parm anvo_nested_parm, n_dwr_service_parm anvo_parm) returns integer
	integer li_ret
	long ll_parent_rowcount
	string ls_dwo
	blob lblob_1
	environment e
	string ls_tmpfile = "dw2xls_tmp.psr"
	datawindowchild ldwc_nested
	this.inv_nested_service_parm = anvo_nested_parm
	this.inv_parm = anvo_parm
	this.is_parent_band_id = this.inv_nested_service_parm.is_parent_band_id
	this.ids_reportdata = create datastore
	choose case this.ipo_requestortype
	case datawindow!
		ls_dwo = this.idw_requestor.dataobject
		ll_parent_rowcount = this.idw_requestor.rowcount()
	case datastore!
		ls_dwo = this.ids_requestor.dataobject
		ll_parent_rowcount = this.ids_requestor.rowcount()
	case else
		return -1
	end choose
	if ll_parent_rowcount = 0 then
		return -1
	end if
	if ls_dwo <> "" then
		this.ids_reportdata.dataobject = ls_dwo
	end if
	choose case this.ipo_requestortype
	case datawindow!, datastore!
		getenvironment(e)
		if e.pbmajorrevision < 6 then
			if this.ipo_requestor.dynamic saveas(ls_tmpfile, psreport!, true) <> 1 then
				return -1
			end if
			this.ids_reportdata.dataobject = ls_tmpfile
			filedelete(ls_tmpfile)
		elseif this.inv_parm.ib_nested_workaround then
			this.ids_reportdata = this.ipo_requestor
		else
			this.ipo_requestor.dynamic getfullstate(lblob_1)
			this.ids_reportdata.dynamic setfullstate(lblob_1)
		end if
		if not this.inv_parm.ib_nested_workaround then
			this.ids_reportdata.modify("Datawindow.Processing=5")
		end if
	case else
		return -1
	end choose
	if this.inv_parm.ib_nested_workaround then
		this.ids_reportdata.rowsmove(1, 1, primary!, this.ids_reportdata, 1, primary!)
	end if
	li_ret = this.ids_reportdata.getchild(this.is_dwo_name, ldwc_nested)
	if li_ret = 1 then
		this.il_child_cache_row = 1
		this.idwc_child_cache = ldwc_nested
		if this.inv_parm.ib_nested_workaround then
			this.il_child_cache_rowcount = this.idwc_child_cache.rowcount()
			anvo_nested_parm.il_requestor_rowcount = this.il_child_cache_rowcount
		end if
		anvo_nested_parm.il_nested_x = of_get_x1()
		anvo_nested_parm.il_nested_y = of_get_y1()
		this.inv_nestedservice = create using "n_dwr_service"
		li_ret = this.inv_nestedservice.of_create(this.idwc_child_cache, this.inv_book, ":not applicable:", anvo_parm, anvo_nested_parm)
	end if
	if li_ret = 1 then
		li_ret = this.inv_nestedservice.of_analyse_dw(0)
	end if
	return li_ret

// n_dwr_field.of_dynamic_horisontal_layout(long al_row, n_dwr_grid anvo_hgrid) returns integer
	return 1

// n_dwr_field.of_register_dynamic(powerobject apo_requestor) returns integer
	this.ipo_requestor = apo_requestor
	this.ipo_requestortype = this.ipo_requestor.typeof()
	choose case this.ipo_requestortype
	case datawindow!
		this.idw_requestor = this.ipo_requestor
		this.il_dw_row_count = this.idw_requestor.rowcount()
	case datastore!
		this.ids_requestor = this.ipo_requestor
		this.il_dw_row_count = this.ids_requestor.rowcount()
	case datawindowchild!
		this.idwc_requestor = this.ipo_requestor
		this.il_dw_row_count = this.idwc_requestor.rowcount()
	case else
		return -1
	end choose
	return 1

// n_dwr_field.of_init(string as_dwo_name, integer ai_dwo_type) returns integer
	integer li_ret = 1
	integer li_i
	this.is_dwo_name = as_dwo_name
	this.ii_dwo_type = ai_dwo_type
	choose case this.ii_dwo_type
	case 1
		this.is_coltype = of_get_item_coltype()
		this.il_id = long(of_describe(as_dwo_name + ".id"))
	case 2
		this.is_coltype = of_get_item_coltype()
	case 3
		this.is_coltype = "s"
		this.is_text = of_describe(as_dwo_name + ".text")
		this.is_text = of_unquote(this.is_text)
		if pos(this.is_text, "~t") > 0 then
			this.is_text_expr = this.is_text
		end if
	case 4
		this.is_coltype = "r"
		this.is_nested_dataobject = of_describe(this.is_dwo_name + ".DataObject")
	end choose
	if li_ret = 1 then
		choose case this.ipo_requestortype
		case datawindow!
			this.il_dw_row_count = this.idw_requestor.rowcount()
		case datastore!
			this.il_dw_row_count = this.ids_requestor.rowcount()
		case datawindowchild!
			this.il_dw_row_count = this.idwc_requestor.rowcount()
		case else
			return -1
		end choose
		this.ib_autosize_height = of_describe(as_dwo_name + ".height.autosize") = "yes"
		this.ii_column_display_type = of_get_column_display_type()
		li_ret = of_setformat()
		this.ii_units = integer(of_describe("Datawindow.Units"))
		if this.inv_parm.ib_check_suppressed then
			for li_i = 1 to upperbound(this.inv_parent_band.is_sparselist)
				if this.inv_parent_band.is_sparselist[li_i] = as_dwo_name then
					this.ii_sparse = li_i
				end if
			next
		end if
	end if
	return li_ret

// n_dwr_field.of_dwc2ds(datawindowchild adwc_src, boolean ab_copydata) returns datastore
	datastore lds_res
	boolean lb_copy_using_psr
	string ls_tmpfile = "dw2xls_tmp.psr"
	lds_res = create datastore
	adwc_src.modify("DataWindow.Crosstab.StaticMode=Yes")
	if not lb_copy_using_psr then
		lds_res.create(adwc_src.describe("Datawindow.Syntax"))
		if ab_copydata then
			adwc_src.rowscopy(1, adwc_src.rowcount(), primary!, lds_res, 1, primary!)
			lds_res.groupcalc()
		end if
	elseif ab_copydata then
		filedelete(ls_tmpfile)
		if adwc_src.saveas(ls_tmpfile, psreport!, true) <> 1 then
			lds_res.create(adwc_src.describe("Datawindow.Syntax"))
			adwc_src.rowscopy(1, adwc_src.rowcount(), primary!, lds_res, 1, primary!)
			lds_res.groupcalc()
		else
			lds_res.dataobject = ls_tmpfile
			filedelete(ls_tmpfile)
		end if
	else
		lds_res.create(adwc_src.describe("Datawindow.Syntax"))
	end if
	return lds_res

// n_dwr_field.of_get_band_y1() returns long
	if this.il_cached_y1 = -1000000000 then
		return of_get_y1(1) - this.il_base_y
	end if
	return this.il_cached_y1

// n_dwr_field.of_get_band_y2() returns long
	if this.il_cached_y2 = -1000000000 then
		return of_get_y2(1) - this.il_base_y
	end if
	return this.il_cached_y2

// n_dwr_field.of_describe_str_expr(string as_expr, long al_row) returns string
	string ls_val
	long ll_pos
	choose case this.ipo_requestortype
	case datawindow!
		ls_val = this.idw_requestor.describe(as_expr)
	case datastore!
		ls_val = this.ids_requestor.describe(as_expr)
	case datawindowchild!
		ls_val = this.idwc_requestor.describe(as_expr)
	case else
		return ""
	end choose
	ll_pos = pos(ls_val, "~t")
	if ll_pos > 0 then
		ls_val = mid(ls_val, ll_pos + 1, len(ls_val) - ll_pos - 1)
		choose case this.ipo_requestortype
		case datawindow!
			ls_val = this.idw_requestor.describe("evaluate(~"" + ls_val + "~", " + string(al_row) + ")")
		case datastore!
			ls_val = this.ids_requestor.describe("evaluate(~"" + ls_val + "~", " + string(al_row) + ")")
		case datawindowchild!
			ls_val = this.idwc_requestor.describe("evaluate(~"" + ls_val + "~", " + string(al_row) + ")")
		case else
			return ""
		end choose
		return ls_val
	end if
	return ls_val

// n_dwr_field.of_get_system_currency_format() returns string
	long ll_ret
	long ll_mongrouping
	string ls_scurrency
	string ls_smondecimalsep
	string ls_smonthousandsep
	string ls_smongrouping
	string ls_numformat
	string ls_icurrency
	string ls_inegcurr
	string ls_positive
	string ls_negative
	n_dwr_string s
	ll_ret = registryget("HKEY_CURRENT_USER\Control Panel\International", "sCurrency", regstring!, ls_scurrency)
	if ll_ret <> 1 then
		ls_scurrency = "$"
	end if
	ll_ret = registryget("HKEY_CURRENT_USER\Control Panel\International", "iCurrency", regstring!, ls_icurrency)
	if ll_ret <> 1 then
		ls_icurrency = "0"
	end if
	ll_ret = registryget("HKEY_CURRENT_USER\Control Panel\International", "iNegCurr", regstring!, ls_inegcurr)
	if ll_ret <> 1 then
		ls_inegcurr = "0"
	end if
	ll_ret = registryget("HKEY_CURRENT_USER\Control Panel\International", "sMonDecimalSep", regstring!, ls_smondecimalsep)
	if ll_ret <> 1 then
		ls_smondecimalsep = "."
	end if
	ll_ret = registryget("HKEY_CURRENT_USER\Control Panel\International", "sMonThousandSep", regstring!, ls_smonthousandsep)
	if ll_ret <> 1 then
		ls_smonthousandsep = ","
	end if
	ll_ret = registryget("HKEY_CURRENT_USER\Control Panel\International", "sMonGrouping", regstring!, ls_smongrouping)
	if ll_ret <> 1 then
		ls_smongrouping = "3;0"
	end if
	choose case ls_icurrency
	case "0"
		ls_positive = "$n"
	case "1"
		ls_positive = "n$"
	case "2"
		ls_positive = "$ n"
	case "3"
		ls_positive = "n $"
	case else
		ls_positive = "$n"
	end choose
	choose case ls_inegcurr
	case "0"
		ls_negative = "($n)"
	case "1"
		ls_negative = "-$n"
	case "2"
		ls_negative = "$-n"
	case "3"
		ls_negative = "$n-"
	case "4"
		ls_negative = "(n$)"
	case "5"
		ls_negative = "-n$"
	case "6"
		ls_negative = "n-$"
	case "7"
		ls_negative = "n$-"
	case "8"
		ls_negative = "-n $"
	case "9"
		ls_negative = "-$ n"
	case "10"
		ls_negative = "n $-"
	case "11"
		ls_negative = "$ n-"
	case "12"
		ls_negative = "$ -n"
	case "13"
		ls_negative = "n- $"
	case "14"
		ls_negative = "($ n)"
	case "15"
		ls_negative = "(n $)"
	case else
		ls_negative = "-$n"
	end choose
	ll_ret = pos(ls_smongrouping, ";")
	if ll_ret > 0 then
		ls_smongrouping = left(ls_smongrouping, ll_ret - 1)
	end if
	ll_mongrouping = long(ls_smongrouping)
	if ll_mongrouping <> 0 then
		ls_numformat = "#" + ls_smonthousandsep + fill("#", ll_mongrouping - 1) + "0.00"
	else
		ls_numformat = "#0.00"
	end if
	ls_numformat = s.of_globalreplace(ls_positive + ";" + ls_negative, "n", ls_numformat)
	ls_numformat = s.of_globalreplace(ls_numformat, "$", ls_scurrency)
	return ls_numformat

// n_dwr_field.of_describe_expr(string as_expr, long al_row, string as_prop_expr) returns long
	string ls_val
	long ll_pos
	n_dwr_string lnvo_str
	choose case this.ipo_requestortype
	case datawindow!
		ls_val = this.idw_requestor.describe(as_expr)
	case datastore!
		ls_val = this.ids_requestor.describe(as_expr)
	case datawindowchild!
		ls_val = this.idwc_requestor.describe(as_expr)
	case else
		return -1
	end choose
	ll_pos = pos(ls_val, "~t")
	if ll_pos > 0 then
		ls_val = mid(ls_val, ll_pos + 1, len(ls_val) - ll_pos - 1)
		ls_val = lnvo_str.of_globalreplace(ls_val, "'", "~~'")
		as_prop_expr = ls_val
		choose case this.ipo_requestortype
		case datawindow!
			ls_val = this.idw_requestor.describe("evaluate(~"" + ls_val + "~", " + string(al_row) + ")")
		case datastore!
			ls_val = this.ids_requestor.describe("evaluate(~"" + ls_val + "~", " + string(al_row) + ")")
		case datawindowchild!
			ls_val = this.idwc_requestor.describe("evaluate(~"" + ls_val + "~", " + string(al_row) + ")")
		case else
			return -1
		end choose
		if isnumber(ls_val) then
			return long(ls_val)
		end if
	else
		as_prop_expr = ""
		if isnumber(ls_val) then
			return long(ls_val)
		end if
	end if
	return -1

// n_dwr_field.of_evaluate0(string as_expr, long al_row) returns long
	string ls_val
	choose case this.ipo_requestortype
	case datawindow!
		ls_val = this.idw_requestor.describe("evaluate(~"" + as_expr + "~", " + string(al_row) + ")")
	case datastore!
		ls_val = this.ids_requestor.describe("evaluate(~"" + as_expr + "~", " + string(al_row) + ")")
	case datawindowchild!
		ls_val = this.idwc_requestor.describe("evaluate(~"" + as_expr + "~", " + string(al_row) + ")")
	case else
