	end if
	if this.il_child_cache_row <> al_row then
		this.il_child_cache_row = -1
		if al_row > 1 then
			this.ids_reportdata.rowsmove(al_row, al_row, primary!, this.ids_reportdata, 1, primary!)
			lb_restoreoriginalroworder = this.inv_parm.ib_nested_workaround
		end if
		li_ret = this.ids_reportdata.getchild(this.is_dwo_name, this.idwc_child_cache)
		if li_ret <> 1 then
			return 0
		end if
		this.il_child_cache_row = al_row
		this.il_child_cache_rowcount = this.idwc_child_cache.rowcount()
	end if
	this.inv_nested_service_parm.il_writer_row = al_writer_row
	this.inv_nested_service_parm.il_parent_row = al_row
	this.inv_nested_service_parm.ipo_dynamic_requestor = this.idwc_child_cache
	this.inv_nested_service_parm.invo_dynamic_hgrid = anvo_hgrid
	if this.inv_parm.ib_nested_workaround then
		this.inv_nested_service_parm.il_requestor_rowcount = this.il_child_cache_rowcount
	end if
	this.inv_nested_service_parm.ipo_progress = apo_progress
	li_ret = this.inv_nestedservice.of_process_work()
	if li_ret = 1 then
		ll_rown = this.inv_nested_service_parm.il_writer_row - al_writer_row
	end if
	if lb_restoreoriginalroworder then
		this.ids_reportdata.rowsmove(1, 1, primary!, this.ids_reportdata, al_row + 1, primary!)
	end if
	return ll_rown

// n_dwr_field.of_descr_font_weight2() returns integer
	integer li_ret
	string ls_value = "-1"
	li_ret = of_check_property("font.weight", this.ib_font_weight_expr, this.is_font_weight_expr, ls_value)
	if li_ret = 1 then
		if isnumber(ls_value) then
			return abs(integer(ls_value))
		else
			return 400
		end if
		return
	end if
	return 400

// n_dwr_field.of_descr_alignment2() returns long
	integer li_ret = 1
	string ls_value
	li_ret = of_check_property("alignment", this.ib_alignment_expr, this.is_alignment_expr, ls_value)
	if li_ret <> 1 then
		if this.is_coltype = "n" then
			return 1
		else
			return 0
		end if
		return
	end if
	return long(ls_value)

// n_dwr_field.of_descr_color2() returns long
	integer li_ret = 1
	string ls_value
	long ll_color
	li_ret = of_check_property("Color", this.ib_color_expr, this.is_color_expr, ls_value)
	if li_ret = 1 then
		if isnumber(ls_value) then
			ll_color = long(ls_value)
			return ll_color
		else
			return 0
		end if
		return
	end if
	return 0

// n_dwr_field.of_descr_bg_color2() returns long
	integer li_ret
	string ls_str
	string ls_bgmode
	string ls_band
	string ls_value
	long ll_color
	ll_color = 1073741824
	if not this.ib_band_bg then
		ls_str = of_describe(this.is_dwo_name + ".Background.Mode")
		if ls_str <> "1" then
			li_ret = of_check_property("Background.Color", this.ib_bg_color_expr, this.is_bg_color_expr, ls_value)
			if li_ret = 1 then
				if isnumber(ls_value) then
					ll_color = long(ls_value)
				end if
			end if
		end if
	else
		ls_bgmode = of_describe(this.is_dwo_name + ".Background.Mode")
		li_ret = of_check_property("Background.Color", this.ib_bg_color_expr, this.is_bg_color_expr, ls_value)
		if ls_bgmode = "1" or not this.ib_bg_color_expr and (ls_value = "553648127" or ls_value = "536870912") or li_ret <> 1 or not isnumber(ls_value) then
			ls_value = string(this.inv_parent_band.of_descr_bg_color())
			this.ib_bg_color_expr = this.inv_parent_band.ib_bg_color_expr
			this.is_bg_color_expr = this.inv_parent_band.is_bg_color_expr
			if not this.ib_bg_color_expr and (ls_value = "553648127" or ls_value = "536870912") or li_ret <> 1 or not isnumber(ls_value) then
				li_ret = of_check_property("::Datawindow.Color", this.ib_bg_color_expr, this.is_bg_color_expr, ls_value)
			end if
		end if
		ll_color = long(ls_value)
	end if
	return ll_color

// n_dwr_field.of_get_format(long al_row) returns long
	integer li_ret
	long ll_format_ix
	n_xls_format lnvo_temp_format
	if not this.ib_custom_format then
		return this.il_format_ix
	end if
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row > this.il_dw_row_count then
		return this.il_format_ix
	end if
	if this.ib_bg_color_expr then
		of_eval_bg_color(al_row)
	end if
	if this.ib_color_expr then
		of_eval_color(al_row)
	end if
	if this.ib_format_expr then
		of_eval_numformat(al_row)
	end if
	if this.ib_font_face_expr then
		of_eval_font_face(al_row)
	end if
	if this.ib_font_underline_expr then
		of_eval_font_underline(al_row)
	end if
	if this.ib_font_italic_expr then
		of_eval_font_italic(al_row)
	end if
	if this.ib_font_weight_expr then
		of_eval_font_weight(al_row)
	end if
	if this.ib_alignment_expr then
		of_eval_alignment(al_row)
	end if
	if isvalid(this.inv_parm) and not isnull(this.inv_parm) then
		if this.inv_parm.ib_font_height_expression and this.ib_font_height_expr then
			of_eval_font_height(al_row)
		end if
	elseif this.ib_font_height_expr then
		of_eval_font_height(al_row)
	end if
	if this.ib_font_escapement_expr then
		of_eval_font_escapement(al_row)
	end if
	ll_format_ix = this.inv_book.of_addformat(this.inv_format)
	return ll_format_ix

// n_dwr_field.of_eval_alignment(long al_row) returns integer
	long ll_value
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ll_value = long(trim(of_describe("evaluate(~"" + this.is_alignment_expr + "~", " + string(al_row) + ")")))
		this.inv_format.sethalign(this.inv_format.handle, ll_value)
		return 1
	end if
	return -1

// n_dwr_field.of_eval_bg_color(long al_row) returns integer
	integer li_color_index
	string ls_value
	long ll_color
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ll_color = long(of_describe("evaluate(~"" + this.is_bg_color_expr + "~", " + string(al_row) + ")"))
		this.inv_format.setbgcolor(this.inv_format.handle, ll_color)
		return 1
	end if
	return -1

// n_dwr_field.of_eval_color(long al_row) returns integer
	integer li_color_index
	string ls_value
	long ll_color
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ll_color = long(of_describe("evaluate(~"" + this.is_color_expr + "~", " + string(al_row) + ")"))
		this.inv_format.setfgcolor(this.inv_format.handle, ll_color)
		return 1
	end if
	return -1

// n_dwr_field.of_eval_font_face(long al_row) returns integer
	string ls_value
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ls_value = trim(of_describe("evaluate(~"" + this.is_font_face_expr + "~", " + string(al_row) + ")"))
		if ls_value <> "" then
			this.inv_format.setfontname(this.inv_format.handle, ls_value)
			return 1
		end if
		return
	end if
	return -1

// n_dwr_field.of_eval_font_height(long al_row) returns integer
	long ll_value
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ll_value = long(of_describe("evaluate(~"" + this.is_font_height_expr + "~", " + string(al_row) + ")"))
		this.inv_format.setfontsize(this.inv_format.handle, abs(ll_value))
		return 1
	end if
	return -1

// n_dwr_field.of_eval_font_italic(long al_row) returns integer
	string ls_value
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ls_value = of_describe("evaluate(~"" + this.is_font_italic_expr + "~", " + string(al_row) + ")")
		if lower(ls_value) = "yes" or ls_value = "1" then
			this.inv_format.setfontitalic(this.inv_format.handle, 1)
		else
			this.inv_format.setfontitalic(this.inv_format.handle, 0)
		end if
		return 1
	end if
	return -1

// n_dwr_field.of_eval_font_underline(long al_row) returns integer
	string ls_value
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ls_value = of_describe("evaluate(~"" + this.is_font_underline_expr + "~", " + string(al_row) + ")")
		if lower(ls_value) = "yes" or ls_value = "1" then
			this.inv_format.setfontunderline(this.inv_format.handle, 1)
		else
			this.inv_format.setfontunderline(this.inv_format.handle, 0)
		end if
		return 1
	end if
	return -1

// n_dwr_field.of_eval_font_weight(long al_row) returns integer
	string ls_value
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ls_value = of_describe("evaluate(~"" + this.is_font_weight_expr + "~", " + string(al_row) + ")")
		if isnumber(ls_value) then
			this.inv_format.setfontweight(this.inv_format.handle, abs(integer(ls_value)))
		else
			this.inv_format.setfontweight(this.inv_format.handle, 400)
		end if
		return 1
	end if
	return -1

// n_dwr_field.of_eval_numformat(long al_row) returns integer
	string ls_value
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ls_value = trim(of_describe("evaluate(~"" + this.is_format_expr + "~", " + string(al_row) + ")"))
		if ls_value = "" then
			ls_value = "[General]"
		end if
		ls_value = of_change_format(ls_value, this.is_coltype)
		this.inv_format.setnumformat(this.inv_format.handle, ls_value)
		return 1
	end if
	return -1

// n_dwr_field.of_descr_font_charset() returns long
	integer li_ret
	li_ret = long(of_describe(this.is_dwo_name + ".Font.Charset"))
	return li_ret

// n_dwr_field.of_descr_font_family() returns long
	integer li_ret
	li_ret = long(of_describe(this.is_dwo_name + ".Font.Family"))
	return li_ret

// n_dwr_field.of_cancel_nested() returns 0
	if this.ii_dwo_type = 4 then
		this.inv_nestedservice.of_cancel()
	end if

// n_dwr_field.of_descr_font_escapement() returns integer
	integer li_ret
	string ls_value
	integer li_value
	li_ret = of_check_property("font.escapement", this.ib_font_escapement_expr, this.is_font_escapement_expr, ls_value)
	if li_ret = 1 and isnumber(ls_value) then
		li_value = integer(ls_value) / 10.0
	end if
	return li_value

// n_dwr_field.of_eval_font_escapement(long al_row) returns integer
	long ll_value
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ll_value = long(of_describe("evaluate(~"" + this.is_font_escapement_expr + "~", " + string(al_row) + ")"))
		this.inv_format.setrotation(this.inv_format.handle, long(ll_value / 10.0))
		return 1
	end if
	return -1

// n_dwr_field.of_setrect(long al_x1, long al_y1, long al_x2, long al_y2) returns integer
	integer ll_x1
	integer ll_w
	integer ll_y1
	integer ll_h
	integer ll_x2
	integer ll_y2
	ll_x1 = of_get_x1(1)
	ll_x2 = of_get_x2(1)
	ll_w = of_get_width(1)
	ll_y1 = of_get_y1(1)
	ll_y2 = of_get_y2(1)
	ll_h = of_get_height(1)
	this.il_cached_x1 = this.il_cached_x1 + (al_x1 - ll_x1)
	this.il_cached_y1 = this.il_cached_y1 + (al_y1 - ll_y1)
	this.il_cached_x2 = this.il_cached_x2 + (al_x2 - ll_x2)
	this.il_cached_y2 = this.il_cached_y2 + (al_y2 - ll_y2)
	this.il_cached_width = this.il_cached_width + (al_x2 - al_x1 - ll_w)
	this.il_cached_height = this.il_cached_height + (al_y2 - al_y1 - ll_h)
	return 1

// n_dwr_field.of_render(n_dwr_worksheet anv_sheet, long al_row, long al_base_y, long al_units, n_dwr_progress apo_progress) returns boolean
	return false

// n_dwr_field.of_get_band_bg_color(long al_row) returns long
	integer li_color_index
	string ls_value
	long ll_color
	al_row = al_row + this.ii_row_in_detail - 1
	if al_row <= this.il_dw_row_count then
		ll_color = long(of_describe("evaluate(~"" + this.is_bg_color_expr + "~", " + string(al_row) + ")"))
		this.inv_format.setbgcolor(this.inv_format.handle, ll_color)
		return 1
	end if
	return -1

// n_dwr_field.of_use_band_bg(boolean ab_enable) returns integer
	this.ib_band_bg = ab_enable
	return 1

// n_dwr_field.of_register(powerobject apo_requestor, n_dwr_workbook anv_book, n_dwr_colors anvo_colors, long al_base_x, long al_base_y, long al_subband_y, boolean ab_band_background) returns integer
	this.il_base_x = al_base_x
	this.il_base_y = al_base_y
	this.il_subband_y = al_subband_y
	this.ipo_requestor = apo_requestor
	this.ipo_requestortype = this.ipo_requestor.typeof()
	choose case this.ipo_requestortype
	case datawindow!
		this.idw_requestor = this.ipo_requestor
	case datastore!
		this.ids_requestor = this.ipo_requestor
	case datawindowchild!
		this.idwc_requestor = this.ipo_requestor
	case else
		return -1
	end choose
	this.inv_book = anv_book
	this.invo_colors = anvo_colors
	of_use_band_bg(ab_band_background)
	return 1

// n_dwr_field.of_getbgrect(st_rect ast_rect, long al_row) returns 0

// n_dwr_field.of_dispose() returns 0
	setnull(this.inv_nestedservice)
	setnull(this.inv_parent_band)

// n_dwr_field.of_setparentband(powerobject anv_band) returns 0
	this.inv_parent_band = anv_band

// n_dwr_field.of_get_col_height_font(integer ai_col_width, string str, string font_name, boolean font_italic, integer font_underline, integer font_weight, integer font_size) returns long
	if this.inv_parm.ib_nonvisual_calc_height then
		return this.inv_book.invo_height.of_get_col_height_font(ai_col_width, str, font_name, font_italic, font_underline, font_weight, font_size, this.ii_units)
	end if
	return this.inv_book.ws.wf_get_col_height_font(ai_col_width, str, font_name, font_italic, font_underline, font_weight, font_size, this.ii_units)

// n_dwr_field.of_do_static_x_markup(n_dwr_worksheet anv_sheet) returns integer
	integer li_ret
	long ll_x1
	long ll_x2
	if this.ii_dwo_type = 4 then
		if isvalid(this.inv_nestedservice) then
			li_ret = this.inv_nestedservice.of_do_static_x_markup(anv_sheet)
		else
			li_ret = -1
		end if
		return li_ret
	end if
	ll_x1 = of_get_x1(1)
	ll_x2 = of_get_x2(1)
	if this.is_expr_x1 = "" and this.is_expr_x2 = "" then
		anv_sheet.addxinterval(anv_sheet.handle, ll_x1, ll_x2, this.ii_units)
	else
		li_ret = -1
	end if
	return li_ret

// n_dwr_field.of_get_column_display_type() returns integer
	string ls_str
	choose case this.ii_dwo_type
	case 1
		ls_str = of_describe(this.is_dwo_name + ".CheckBox.On")
		if ls_str <> "!" and ls_str <> "?" and ls_str <> "" then
			return 2
		end if
		ls_str = of_describe(this.is_dwo_name + ".DDDW.Name")
		if ls_str <> "!" and ls_str <> "?" and ls_str <> "" then
			return 3
		end if
		ls_str = of_describe(this.is_dwo_name + ".DDLB.Required")
		if ls_str <> "!" and ls_str <> "?" and ls_str <> "" then
			return 4
		end if
		ls_str = of_describe(this.is_dwo_name + ".RadioButtons.Columns")
		if ls_str <> "0" and ls_str <> "!" and ls_str <> "?" and ls_str <> "" then
			return 1
		end if
		ls_str = of_describe(this.is_dwo_name + ".Edit.CodeTable")
		if lower(ls_str) = "yes" then
			return 5
		end if
		return 1
	case 2, 3
		return 1
	case 4
		return 6
	end choose
	return 1

// n_dwr_field.of_register_dynamic2(powerobject apo_requestor, long al_rowcount) returns integer
	this.ipo_requestor = apo_requestor
	this.ipo_requestortype = this.ipo_requestor.typeof()
	choose case this.ipo_requestortype
	case datawindow!
		this.idw_requestor = this.ipo_requestor
		this.il_dw_row_count = al_rowcount
	case datastore!
		this.ids_requestor = this.ipo_requestor
		this.il_dw_row_count = al_rowcount
	case datawindowchild!
		this.idwc_requestor = this.ipo_requestor
		this.il_dw_row_count = al_rowcount
	case else
		return -1
	end choose
	return 1

// n_dwr_field.of_descr_bitmapname() returns boolean
	integer li_ret
	string ls_value
	string ls_dummy
	boolean lb_dummy
	li_ret = of_check_property("bitmapname", lb_dummy, ls_dummy, ls_value)
	if li_ret = 1 then
		return lower(ls_value) = "yes" or ls_value = "1"
	end if
	return false

// n_dwr_field.create() returns 0 [event]
	call super::create
	triggerevent("constructor")

// n_dwr_field.destroy() returns 0 [event]
	triggerevent("destructor")
	call super::destroy

// n_dwr_field.constructor() returns long [event]
	this.inv_const = create n_dwr_const
	return ::message.returnvalue
