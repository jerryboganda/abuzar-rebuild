// function uf_bitxor (dw2xls)  ancestor: function_object

// uf_bitxor.uf_bitxor(unsignedlong al_val1, unsignedlong al_val2) returns unsignedlong
	unsignedlong ll_ret
	integer li_i
	for li_i = 0 to 15
		if long(al_val1 / 2 ^ li_i) mod 2 <> long(al_val2 / 2 ^ li_i) mod 2 then
			ll_ret = ll_ret + 2 ^ li_i
		end if
	next
	return ll_ret
