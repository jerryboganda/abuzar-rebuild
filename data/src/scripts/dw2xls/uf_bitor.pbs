// function uf_bitor (dw2xls)  ancestor: function_object

// uf_bitor.uf_bitor(unsignedlong al_val1, unsignedlong al_val2) returns unsignedlong
	unsignedlong ll_ret
	integer li_i
	for li_i = 0 to 31
		if long(al_val1 / 2 ^ li_i) mod 2 + long(al_val2 / 2 ^ li_i) mod 2 > 0 then
			ll_ret = ll_ret + 2 ^ li_i
		end if
	next
	return ll_ret
