// userobject n_xls_format_v5 (dw2xls)  ancestor: n_xls_format

// n_xls_format_v5.of_set_font(string as_fontname) returns integer
	integer li_ret
	this.is_font = as_fontname
	return li_ret

// n_xls_format_v5.of_set_size(integer ai_size) returns integer
	integer li_ret
	this.ii_size = ai_size
	return li_ret

// n_xls_format_v5.of_get_color(string as_color) returns unsignedinteger
	choose case trim(lower(as_color))
	case "aqua"
		return 15
	case "cyan"
		return 15
	case "black"
		return 8
	case "blue"
		return 12
	case "brown"
		return 16
	case "magenta"
		return 14
	case "fuchsia"
		return 14
	case "gray"
		return 23
	case "grey"
		return 23
	case "green"
		return 17
	case "lime"
		return 11
	case "navy"
		return 18
	case "orange"
		return 53
	case "purple"
		return 20
	case "red"
		return 10
	case "silver"
		return 22
	case "white"
		return 9
	case "yellow"
		return 13
	end choose
	return 32767

// n_xls_format_v5.of_set_color(long al_colorindex) returns integer
	integer li_ret
	if al_colorindex < 8 then
		al_colorindex = al_colorindex + 8
	end if
	if al_colorindex > 63 then
		al_colorindex = 32767
	end if
	this.ii_color = al_colorindex
	return li_ret

// n_xls_format_v5.of_set_color(string as_color) returns integer
	integer li_ret
	of_set_color(of_get_color(as_color))
	return li_ret

// n_xls_format_v5.of_set_bold(boolean ab_bold) returns integer
	integer li_ret
	if ab_bold then
		this.ii_bold = 700
	else
		this.ii_bold = 400
	end if
	return li_ret

// n_xls_format_v5.of_set_italic(boolean ab_italic) returns integer
	integer li_ret
	if ab_italic then
		this.ii_italic = 1
	else
		this.ii_italic = 0
	end if
	return li_ret

// n_xls_format_v5.of_set_num_format(string as_num_format) returns integer
	integer li_ret
	this.is_num_format = as_num_format
	this.ii_num_format = 0
	return li_ret

// n_xls_format_v5.of_set_align(string as_align) returns integer
	integer li_ret
	choose case trim(lower(as_align))
	case "left"
		of_set_text_h_align(1)
	case "centre", "center"
		of_set_text_h_align(2)
	case "right"
		of_set_text_h_align(3)
	case "fill"
		of_set_text_h_align(4)
	case "justify"
		of_set_text_h_align(5)
	case "merge"
		of_set_text_h_align(6)
	case "equal_space"
		of_set_text_h_align(7)
	case "top"
		of_set_text_v_align(0)
	case "vcentre", "vcenter"
		of_set_text_v_align(1)
	case "bottom"
		of_set_text_v_align(2)
	case "vjustify"
		of_set_text_v_align(3)
	case "vequal_space"
		of_set_text_v_align(4)
	case else
		return -1
	end choose
	return li_ret

// n_xls_format_v5.of_set_text_wrap(boolean ab_text_wrap) returns integer
	integer li_ret
	if ab_text_wrap then
		this.ii_text_wrap = 1
	else
		this.ii_text_wrap = 0
	end if
	return li_ret

