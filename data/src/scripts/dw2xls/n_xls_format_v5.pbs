// n_xls_format_v5.of_get_font() returns blob
	unsignedinteger li_record
	unsignedinteger li_length
	unsignedinteger li_dyheight
	unsignedinteger li_grbit
	unsignedinteger li_icv
	unsignedinteger li_bls
	unsignedinteger li_sss
	unsignedinteger li_uls
	unsignedinteger li_bfamily
	unsignedinteger li_bcharset
	unsignedinteger li_reserved
	unsignedinteger li_cch
	string ls_rgch
	blob lb_data
	li_dyheight = this.ii_size * 20
	li_icv = this.ii_color
	li_bls = this.ii_bold
	li_sss = this.ii_font_script
	li_uls = this.ii_underline
	li_bfamily = this.ii_font_family
	li_bcharset = this.ii_font_charset
	ls_rgch = this.is_font
	li_cch = len(ls_rgch)
	li_record = 49
	li_length = 15 + li_cch
	li_reserved = 0
	li_grbit = 0
	li_grbit = this.ii_italic * 2 + li_grbit
	li_grbit = this.ii_font_strikeout * 8 + li_grbit
	li_grbit = this.ii_font_outline * 16 + li_grbit
	li_grbit = this.ii_font_shadow * 32 + li_grbit
	lb_data = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length) + this.invo_sub.of_pack("v", li_dyheight) + this.invo_sub.of_pack("v", li_grbit) + this.invo_sub.of_pack("v", li_icv) + this.invo_sub.of_pack("v", li_bls) + this.invo_sub.of_pack("v", li_sss) + this.invo_sub.of_pack("C", li_uls) + this.invo_sub.of_pack("C", li_bfamily) + this.invo_sub.of_pack("C", li_bcharset) + this.invo_sub.of_pack("C", li_reserved) + this.invo_sub.of_pack("C", li_cch) + blob(this.is_font)
	return lb_data

// n_xls_format_v5.of_get_font_key() returns string
	string ls_ret
	unsignedinteger li_pos
	ls_ret = string(len(this.is_font), "000") + this.is_font + trim(string(this.ii_size, "0000")) + trim(string(this.ii_font_script, "00")) + trim(string(this.ii_underline, "00")) + trim(string(this.ii_font_strikeout, "00")) + trim(string(this.ii_bold, "000")) + trim(string(this.ii_font_outline, "00")) + trim(string(this.ii_font_family, "0000")) + trim(string(this.ii_font_charset, "000000")) + trim(string(this.ii_font_shadow, "00")) + trim(string(this.ii_color, "000")) + trim(string(this.ii_italic, "0"))
	li_pos = pos(ls_ret, " ")
	do while li_pos > 0
		ls_ret = replace(ls_ret, li_pos, 1, "_")
		li_pos = pos(ls_ret, " ")
	loop
	return ls_ret

// n_xls_format_v5.of_get_xf(string as_style) returns blob
	unsignedinteger li_record
	unsignedinteger li_length
	unsignedinteger li_ifnt
	unsignedinteger li_ifmt
	unsignedinteger li_style
	unsignedinteger li_align
	unsignedinteger li_icv
	unsignedinteger li_fill
	unsignedinteger li_border1
	unsignedinteger li_border2
	unsignedinteger li_atr_num
	unsignedinteger li_atr_fnt
	unsignedinteger li_atr_alc
	unsignedinteger li_atr_bdr
	unsignedinteger li_atr_pat
	unsignedinteger li_atr_prot
	blob lb_data
	if as_style = "style" then
		li_style = 65525
	else
		li_style = this.ii_locked + this.ii_hidden * 2
	end if
	if this.ii_num_format <> 0 then
		li_atr_num = 1
	end if
	if this.ii_font_index <> 0 then
		li_atr_fnt = 1
	end if
	if this.ii_text_h_align <> 0 or this.ii_text_v_align <> 2 or this.ii_text_wrap <> 0 then
		li_atr_alc = 1
	end if
	if this.ii_bottom <> 0 or this.ii_top <> 0 or this.ii_left <> 0 or this.ii_right <> 0 then
		li_atr_bdr = 1
	end if
	if this.ii_fg_color <> 64 or this.ii_bg_color <> 65 or this.ii_pattern <> 0 then
		li_atr_pat = 1
	end if
	if this.ii_hidden <> 0 or this.ii_locked <> 1 then
		li_atr_prot = 1
	end if
	if this.ii_fg_color = 32767 then
		this.ii_fg_color = 64
	end if
	if this.ii_bg_color = 32767 then
		this.ii_bg_color = 65
	end if
	if this.ii_bottom_color = 32767 then
		this.ii_bottom_color = 64
	end if
	if this.ii_top_color = 32767 then
		this.ii_top_color = 64
	end if
	if this.ii_left_color = 32767 then
		this.ii_left_color = 64
	end if
	if this.ii_right_color = 32767 then
		this.ii_right_color = 64
	end if
	if this.ii_bottom = 0 then
		this.ii_bottom_color = 0
	end if
	if this.ii_top = 0 then
		this.ii_top_color = 0
	end if
	if this.ii_left = 0 then
		this.ii_left_color = 0
	end if
	if this.ii_right = 0 then
		this.ii_right_color = 0
	end if
	if this.ii_pattern <= 1 and this.ii_bg_color <> 65 and this.ii_fg_color = 64 then
		this.ii_fg_color = this.ii_bg_color
		this.ii_bg_color = 64
		this.ii_pattern = 1
	end if
	if this.ii_pattern <= 1 and this.ii_bg_color = 65 and this.ii_fg_color <> 64 then
		this.ii_bg_color = 64
		this.ii_pattern = 1
	end if
	li_record = 224
	li_length = 16
	li_ifnt = this.ii_font_index
	li_ifmt = this.ii_num_format
	li_align = this.ii_text_h_align + this.ii_text_wrap * 8 + this.ii_text_v_align * 16 + this.ii_text_justlast * 128 + this.ii_rotation * 256 + li_atr_num * 1024 + li_atr_fnt * 2048 + li_atr_alc * 4096 + li_atr_bdr * 8192 + li_atr_pat * 16384 + li_atr_prot * 32768
	li_icv = this.ii_fg_color + this.ii_bg_color * 128
	li_fill = this.ii_pattern + this.ii_bottom * 64 + this.ii_bottom_color * 512
	li_border1 = this.ii_top + this.ii_left * 8 + this.ii_right * 64 + this.ii_top_color * 512
	li_border2 = this.ii_left_color + this.ii_right_color * 128
	lb_data = this.invo_sub.of_pack("v", li_record) + this.invo_sub.of_pack("v", li_length) + this.invo_sub.of_pack("v", li_ifnt) + this.invo_sub.of_pack("v", li_ifmt) + this.invo_sub.of_pack("v", li_style) + this.invo_sub.of_pack("v", li_align) + this.invo_sub.of_pack("v", li_icv) + this.invo_sub.of_pack("v", li_fill) + this.invo_sub.of_pack("v", li_border1) + this.invo_sub.of_pack("v", li_border2)
	return lb_data

