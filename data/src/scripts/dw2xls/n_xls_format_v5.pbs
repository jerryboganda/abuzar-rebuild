// n_xls_format_v5.of_get_format_key() returns string
	string ls_ret
	unsignedinteger li_pos
	ls_ret = string(this.ii_num_format, "00000") + string(len(this.is_num_format), "000") + this.is_num_format + string(this.ii_hidden, "0") + string(this.ii_locked, "0") + string(this.ii_text_h_align, "00") + string(this.ii_text_wrap, "0") + string(this.ii_text_v_align, "00") + string(this.ii_text_justlast, "00") + string(this.ii_rotation, "000") + string(this.ii_fg_color, "000") + string(this.ii_bg_color, "000") + string(this.ii_pattern, "000") + string(this.ii_bottom, "000") + string(this.ii_top, "000") + string(this.ii_left, "000") + string(this.ii_right, "000") + string(this.ii_bottom_color, "000") + string(this.ii_top_color, "000") + string(this.ii_left_color, "000") + string(this.ii_right_color, "000") + string(this.ii_merge_range, "0") + of_get_font_key()
	li_pos = pos(ls_ret, " ")
