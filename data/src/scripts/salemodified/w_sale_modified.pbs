// w_sale_modified.wf_set_itemtotal_formatmask() returns long
	string ls_modify
	string ls_format
	ls_format = trim(f_stringpreferences("FormatForAmtInSale"))
	ls_modify = "c_itemtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_detaildwtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_finalitemval.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_sumfinalitemval.Format='" + ls_format + "'  "
	this.id_detail.modify(ls_modify)
	return 0

// w_sale_modified.wf_view_iteminfo() returns 0
	long ll_code
	if this.tab_retrieve.selectedtab = 2 then
		return
	end if
	if this.id_detail.rowcount() > 0 and this.id_detail.getrow() > 0 then
		ll_code = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		if ll_code > 0 and not isnull(ll_code) then
			openwithparm(w_iteminfo, ll_code)
		end if
	end if

// w_sale_modified.wf_update_invprice_with_selected_price() returns 0
	s_arguements lstr_arg
	u_transaction lt_transobject
	long ll_returncode
	string ls_query
	open(w_arg_sinvcode_linvcode_cust_v4)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		lt_transobject = create u_transaction
		SQL start USING lt_transobject;
		if lstr_arg.l_code3 = 1 then
			SQL update saledetailmodified SET saleprice =Item.saleprice / ( case item.packunits when 0 then 1 else item.packunits end ) FROM Item WHERE saledetailmodified.saleinvcode >= :lstr_arg.l_code1 AND saledetailmodified.saleinvcode <= :lstr_arg.l_code2 AND saledetailmodified.icode =item.icode USING lt_transobject;
		elseif lstr_arg.l_code3 = 2 then
			SQL update saledetailmodified SET saleprice =Item.saleprice2 / ( case item.packunits when 0 then 1 else item.packunits end ) FROM Item WHERE saledetailmodified.saleinvcode >= :lstr_arg.l_code1 AND saledetailmodified.saleinvcode <= :lstr_arg.l_code2 AND saledetailmodified.icode =item.icode USING lt_transobject;
		elseif lstr_arg.l_code3 = 3 then
			SQL update saledetailmodified SET saleprice =Item.saleprice3 / ( case item.packunits when 0 then 1 else item.packunits end ) FROM Item WHERE saledetailmodified.saleinvcode >= :lstr_arg.l_code1 AND saledetailmodified.saleinvcode <= :lstr_arg.l_code2 AND saledetailmodified.icode =item.icode USING lt_transobject;
		elseif lstr_arg.l_code3 = 4 then
			SQL update saledetailmodified SET saleprice =Item.purprice / ( case item.packunits when 0 then 1 else item.packunits end ) FROM Item WHERE saledetailmodified.saleinvcode >= :lstr_arg.l_code1 AND saledetailmodified.saleinvcode <= :lstr_arg.l_code2 AND saledetailmodified.icode =item.icode USING lt_transobject;
		elseif lstr_arg.l_code3 = 5 then
			SQL update saledetailmodified SET saleprice =Item.recentpurprice / ( case item.packunits when 0 then 1 else item.packunits end ) FROM Item WHERE saledetailmodified.saleinvcode >= :lstr_arg.l_code1 AND saledetailmodified.saleinvcode <= :lstr_arg.l_code2 AND saledetailmodified.icode =item.icode USING lt_transobject;
		elseif lstr_arg.l_code3 = 6 then
			SQL update saledetailmodified SET saleprice =Item.avgprice FROM Item WHERE saledetailmodified.saleinvcode >= :lstr_arg.l_code1 AND saledetailmodified.saleinvcode <= :lstr_arg.l_code2 AND saledetailmodified.icode =item.icode USING lt_transobject;
		elseif lstr_arg.l_code3 = 7 then
			SQL update saledetailmodified SET saleprice =Item.saleprice4 / ( case item.packunits when 0 then 1 else item.packunits end ) FROM Item WHERE saledetailmodified.saleinvcode >= :lstr_arg.l_code1 AND saledetailmodified.saleinvcode <= :lstr_arg.l_code2 AND saledetailmodified.icode =item.icode USING lt_transobject;
		elseif lstr_arg.l_code3 = 8 then
			SQL update saledetailmodified SET saleprice =Item.saleprice5 / ( case item.packunits when 0 then 1 else item.packunits end ) FROM Item WHERE saledetailmodified.saleinvcode >= :lstr_arg.l_code1 AND saledetailmodified.saleinvcode <= :lstr_arg.l_code2 AND saledetailmodified.icode =item.icode USING lt_transobject;
		else
			SQL update saledetailmodified SET saleprice =Item.saleprice / ( case item.packunits when 0 then 1 else item.packunits end ) FROM Item WHERE saledetailmodified.saleinvcode >= :lstr_arg.l_code1 AND saledetailmodified.saleinvcode <= :lstr_arg.l_code2 AND saledetailmodified.icode =item.icode USING lt_transobject;
		end if
		if lt_transobject.sqlcode <> 0 then
			messagebox("Database Error", "Some database problem has occur~r~n" + lt_transobject.sqlerrtext)
			SQL rollback USING lt_transobject;
			ll_returncode = -1
		else
			SQL update saleledgermodified SET invtotal =dbo.fn_getcopiedsaleinvtotal ( saleinvcode ) , sprice =:lstr_arg.l_code3 , invoicesize =:lstr_arg.s_name1 , headerno =:lstr_arg.l_code4 WHERE saleledgermodified.saleinvcode >= :lstr_arg.l_code1 AND saleledgermodified.saleinvcode <= :lstr_arg.l_code2 USING lt_transobject;
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Database Error", "Some database problem has occur~r~n" + lt_transobject.sqlerrtext)
				SQL rollback USING lt_transobject;
				ll_returncode = -1
			else
				SQL commit USING lt_transobject;
				messagebox("", "Operation Completed Successfully")
				ll_returncode = 0
			end if
		end if
		SQL stop USING lt_transobject;
		destroy lt_transobject
	end if

// w_sale_modified.wf_update_itemdiscperc_for_rangeinv() returns 0
	s_arguements lstr_arg
	u_transaction lt_transobject
	long ll_returncode
	string ls_query
	open(w_arg_sinvcode_linvcode_disc_salemod)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		lt_transobject = create u_transaction
		SQL start USING lt_transobject;
		SQL update saledetailmodified SET discperc =:lstr_arg.db_code1 WHERE saledetailmodified.saleinvcode >= :lstr_arg.l_code1 AND saledetailmodified.saleinvcode <= :lstr_arg.l_code2 USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Database Error", "Some database problem has occur~r~n" + lt_transobject.sqlerrtext)
			SQL rollback USING lt_transobject;
			ll_returncode = -1
		else
			SQL update saleledgermodified SET invtotal =dbo.fn_getcopiedsaleinvtotal ( saleinvcode ) WHERE saleledgermodified.saleinvcode >= :lstr_arg.l_code1 AND saleledgermodified.saleinvcode <= :lstr_arg.l_code2 USING lt_transobject;
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Database Error", "Some database problem has occur~r~n" + lt_transobject.sqlerrtext)
				SQL rollback USING lt_transobject;
				ll_returncode = -1
			else
				SQL commit USING lt_transobject;
				messagebox("", "Operation Completed Successfully")
				ll_returncode = 0
			end if
		end if
		SQL stop USING lt_transobject;
		destroy lt_transobject
	end if

// w_sale_modified.wf_setimgonprint(integer ai_writeorclear) returns integer
	integer li_retcode
	blob lblob_sigonsaleinv
	if f_stringpreferences("sigonsaleinv") = "Y" then
		if ai_writeorclear = 1 then
			SQL rollback USING sqlca;
			SQL SelectBlob PrefImage INTO :lblob_sigonsaleinv From SoftwarePreferences Where name ='sigonsaleinvimg' USING sqlca;
			if sqlca.sqlcode = 0 then
				li_retcode = 1
			else
				li_retcode = -1
			end if
			SQL rollback USING sqlca;
			f_writeimgtofile("c:\winim.jpg", lblob_sigonsaleinv)
			this.id_print.modify("p_sig.FileName='c:\winim.jpg'")
		elseif ai_writeorclear = 0 then
			lblob_sigonsaleinv = blob("0xoeqpxakvabl")
			f_writeimgtofile("c:\winim.jpg", lblob_sigonsaleinv)
		end if
	end if
	return li_retcode

// w_sale_modified.create() returns 0
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_salemodifiedmenu" then
		this.menuid = create m_salemodifiedmenu
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	this.dw_saleinvdetail = create dw_saleinvdetail
	this.ic_cashdrawerprinter = create ic_cashdrawerprinter
	this.ic_comport = create ic_comport
	this.ic_drawerport = create ic_drawerport
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.dw_saleinvdetail
	this.control[icurrent + 3] = this.ic_cashdrawerprinter
	this.control[icurrent + 4] = this.ic_comport
	this.control[icurrent + 5] = this.ic_drawerport

// w_sale_modified.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.dw_saleinvdetail
	destroy this.ic_cashdrawerprinter
	destroy this.ic_comport
	destroy this.ic_drawerport

// w_sale_modified.ue_save() returns 0
	datastore lds_groupdiscinfo
	double ld_itemflatdisc
	double ld_unitsalestax
	double ld_itemgstperc
	double ld_invdisc
	double ld_invgstperc
	double ld_itemamount
	double ld_amountdiff
	double ld_clonesaleprice
	boolean lb_validdisc
	long ll_detailrows
	long ll_counter2
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode
	long ll_gcode
	long ll_headerno
	long ll_headerinvno
	long ll_counter
	long ll_count
	long ll_null
	long ll_modifycount
	long ll_lastinvcode
	long ll_customerallowed
	long ll_found
	boolean lb_commitflag
	boolean lb_continue
	integer li_counter
	integer li_filehandle
	integer li_maxretcode
	string ls_errtext
	string ls_holdstring
	string ls_drawermessage
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_invamount
	double ld_cashtended
	double ld_cashbalance
	double ld_invgstperc1
	double ld_price
	double ld_stock
	double ld_newstock
	double ld_salelooseqty
	s_salesman lstr_salesman
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	datetime ldt_server_datetime
	string ls_date_errtext
	datawindowchild ldc_headerno
	s_cashierwindow ls_cashierwindow
	this.ib_lcdshow = false
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if this.ii_saletype = 2 and this.id_master.getitemnumber(this.id_master.getrow(), "custcode") = 19.0 then
		messagebox("Customer Validation!", "Cash Sale Walking Customer is not allowed in Credit Sales")
		this.id_master.setcolumn("custcode")
		this.id_master.setfocus()
		return
	end if
	if this.id_detail.rowcount() < 1 then
		messagebox("Rows Validation", "Please insert a row before proceeding")
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	for ll_counter = 1 to this.id_detail.rowcount()
		if f_stringpreferences("SaleOnZeroPrice") = "N" then
			ld_price = this.id_detail.getitemnumber(ll_counter, "Saleprice")
			if ld_price = 0.0 or isnull(ld_price) then
				messagebox("Price Validation", "SalePrice is Zero in Row " + string(ll_counter))
				this.id_detail.setfocus()
				this.id_detail.scrolltorow(ll_counter)
				this.id_detail.setcolumn("SalePrice")
				return
			end if
			return
		end if
		if this.id_detail.getitemnumber(ll_counter, "looseqty") + this.id_detail.getitemnumber(ll_counter, "bonusqty") <= 0.0 then
			messagebox("Sale Qty Validation", "Please Enter Valid Sale Qty")
			this.id_detail.setfocus()
			this.id_detail.scrolltorow(ll_counter)
			this.id_detail.setcolumn("looseqty")
			return
		end if
	next
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	setpointer(hourglass!)
	wf_grandtotal()
	this.id_footer.accepttext()
	this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
	this.is_lcditem = "Total = " + string(wf_grandtotal(), "########0.00")
	if f_stringpreferences("DisplayPool") = "Y" then
		this.ic_comport.triggerevent("ue_show")
	end if
	if f_stringpreferences("Salesalesmanwindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if this.ii_saletype = 3 and f_stringpreferences("SaleCashWindow") = "Y" then
			ld_invamount = this.id_footer.getitemnumber(1, "total")
			ls_cashierwindow.l_custcode = this.id_master.getitemnumber(1, "custcode")
			ls_cashierwindow.d_invamt = ld_invamount
			openwithparm(w_salesmanpassword_invtype, ls_cashierwindow)
			setfocus()
			lstr_salesman = message.powerobjectparm
			if lstr_salesman.l_salesmancode < 1 then
				return
			end if
			if lstr_salesman.b_lcd_flag then
				ld_cashtended = lstr_salesman.d_cashtended
				ld_cashbalance = lstr_salesman.d_cashbalance
				this.id_footer.object.t_balance.text = string(ld_cashbalance, "########0.00")
				this.is_lcditem = "Cash   ="
				ls_holdstring = string(ld_cashtended, "########0.00")
				if len(ls_holdstring) < 12 then
					ls_holdstring = ls_holdstring + space(12 - len(ls_holdstring))
				else
					ls_holdstring = left(ls_holdstring, 12)
				end if
				this.is_lcditem = this.is_lcditem + ls_holdstring
				ls_holdstring = string(ld_cashbalance, "########0.00")
				if len(ls_holdstring) < 12 then
					ls_holdstring = ls_holdstring + space(12 - len(ls_holdstring))
				else
					ls_holdstring = left(ls_holdstring, 12)
				end if
				this.is_lcditem = this.is_lcditem + "Balance=" + ls_holdstring
				if f_stringpreferences("DisplayPool") = "Y" then
					this.ic_comport.triggerevent("ue_show")
				end if
				if f_stringpreferences("CashDrawer") = "Y" then
					this.ic_drawerport.object.portopen = true
					this.ic_drawerport.object.output = "A"
					this.ic_drawerport.object.portopen = false
				end if
			else
				this.id_footer.object.t_balance.text = "0.00"
				this.ib_lcdshow = true
			end if
		end if
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if isnull(ll_invid) then
			messagebox("Sale Invoice Code Validation", "Kindly populate sale invoice again.")
			return
		else
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.setitem(ll_counter, "code", ll_invid)
			next
			wf_setrowgroup(this.id_detail)
		end if
		this.id_master.getchild("headerno", ldc_headerno)
		if f_stringpreferences("Headeronsaleinv") = "N" then
			this.id_master.setitem(ll_mastercurrrow, "Headerno", ldc_headerno.getitemnumber(ll_mastercurrrow, "code"))
			ll_headerno = ldc_headerno.getitemnumber(ll_mastercurrrow, "code")
			ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
			if isnull(ll_headerinvno) then
			end if
		end if
		if f_stringpreferences("Headeronsaleinv") = "Y" or gs_company = "SA" or gs_company = "EPP" then
		end if
		ld_misccharges = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges")
		ld_invdiscperc = this.id_footer.getitemnumber(ll_footercurrrow, "invdiscperc")
		ld_flatdisc = this.id_footer.getitemnumber(ll_footercurrrow, "flatdisc")
		ld_salestax = this.id_footer.getitemnumber(ll_footercurrrow, "salestax")
		ld_invgstperc1 = this.id_footer.getitemnumber(ll_footercurrrow, "InvGSTPerc1")
		this.id_master.setitem(ll_mastercurrrow, "discperc", ld_invdiscperc)
		this.id_master.setitem(ll_mastercurrrow, "flatdisc", ld_flatdisc)
		this.id_master.setitem(ll_mastercurrrow, "misccharges", ld_misccharges)
		this.id_master.setitem(ll_mastercurrrow, "salestax", ld_salestax)
		this.id_master.setitem(ll_mastercurrrow, "InvGSTPerc1", ld_invgstperc1)
		if this.ii_saletype = 3 then
			this.id_master.setitem(ll_mastercurrrow, "cashreceived", lstr_salesman.d_cashtended)
			if lstr_salesman.l_custcode > 19 then
				this.id_master.setitem(1, "salecatcode", 2)
				this.id_master.setitem(1, "custcode", lstr_salesman.l_custcode)
				this.ib_printout = false
				this.id_master.accepttext()
			end if
		end if
		choose case this.ii_saletype
		case 3
		case 2
		end choose
		if this.ib_modify then
			ll_modifycount = this.id_master.getitemdecimal(ll_mastercurrrow, "modifycounter")
			if isnull(ll_modifycount) then
				ll_modifycount = 0
			end if
			this.id_master.setitem(ll_mastercurrrow, "modifycounter", ll_modifycount + 1)
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
		else
			this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
		end if
		if lb_continue then
			call super::ue_save
			this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
			if this.ib_commitok then
				this.ib_modify = false
			elseif this.ib_modify = false then
				setnull(ll_null)
				this.id_master.setitem(1, "Code", ll_null)
				this.id_master.accepttext()
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			if this.ib_modify = false then
				setnull(ll_null)
				this.id_master.setitem(1, "Code", ll_null)
				this.id_master.accepttext()
			end if
			messagebox("Updation Error", ls_errtext + " in current row", stopsign!)
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_sale_modified.ue_newform() returns 0
	integer rtncode
	integer li_defaultgcode
	integer li_ismodifysaleprice
	integer li_ismodifyitemdiscperc
	integer li_ismodifyitemflatdisc
	integer li_modifysalestax
	integer li_viewstock
	integer li_viewtotalstock
	long li_fetched_code
	long row
	long ll_manfcode
	long ll_counter
	long ll_custcode
	double ld_invdiscperc
	call super::ue_newform
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.il_norcotixcode = -1
	this.im_menu.m_file.m_print.enabled = true
	wf_protectdw(this.id_master, 0)
	this.id_detail.setredraw(false)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.id_detail.setredraw(true)
	this.ib_modify = false
	wf_setgodownoption()
	li_ismodifysaleprice = 1
	li_ismodifyitemdiscperc = 1
	li_ismodifyitemflatdisc = 1
	li_modifysalestax = 1
	li_viewstock = 0
	li_viewtotalstock = 0
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 511 then
			li_ismodifysaleprice = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 516 then
			li_ismodifyitemdiscperc = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 517 then
			li_ismodifyitemflatdisc = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 520 then
			li_modifysalestax = 0
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 535 then
			li_viewstock = 1
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 536 then
			li_viewtotalstock = 1
		end if
	next
	this.id_footer.object.t_stock.visible = li_viewstock
	this.id_footer.object.stock.visible = li_viewstock
	this.id_footer.object.t_totalstock.visible = li_viewtotalstock
	this.id_footer.object.totalstock.visible = li_viewtotalstock
	this.id_detail.object.saleprice.protect = li_ismodifysaleprice
	this.id_detail.object.discperc.protect = li_ismodifyitemdiscperc
	this.id_detail.object.itemflatdisc.protect = li_ismodifyitemflatdisc
	this.id_detail.object.unitsalestax.protect = li_modifysalestax
	this.id_detail.object.gstperc.protect = li_modifysalestax
	this.id_footer.setitem(1, "invdiscperc", f_numberpreferences("invdiscperc"))
	if not wf_validatedate() then
		close(this)
	else
		if this.ii_saletype = 3 then
			ll_custcode = this.id_master.getitemnumber(1, "custcode")
			SQL Select invdiscperc INTO :ld_invdiscperc From Customer Where custcode =:ll_custcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
			end if
			this.id_detail.setfocus()
		else
			this.id_master.setfocus()
		end if
		wf_visible(true)
	end if
	if f_stringpreferences("DisplayPool") = "Y" then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
			setnull(this.is_lcditem)
			this.ic_comport.triggerevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
			setnull(this.is_lcditem)
			this.ic_comport.triggerevent("ue_show")
		end if
	end if
	this.ib_lcdshow = true
	this.ii_focuscustomer = 2
	this.il_custcode = 0
	this.il_allowedcustomer = 0

// w_sale_modified.ue_detail() returns 0
	integer li_rtncode
	integer li_protect
	integer li_ismodifysaleprice
	integer li_ismodifyitemdiscperc
	integer li_ismodifyitemflatdisc
	integer li_modifysalestax
	long ll_row
	long ll_code
	long ll_counter
	long ll_admissioncode
	boolean lb_flag
	boolean lb_modify
	m_salemodifiedmenu lm_menu
	long ll_rowcount
	long ll_validinv
	double ld_code
	lm_menu = this.menuid
	this.tab_retrieve.tabpage_list.em_invno.getdata(ld_code)
	if ld_code = 0.0 then
		ld_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	else
		if this.ii_saletype = 3 then
			SQL select count ( *) , MAX ( admissioncode ) INTO :ll_validinv, :ll_admissioncode from SaleledgerModified where saleinvcode =:ld_code and salecatcode =:this.ii_saletype USING this.it_transobject;
		else
			SQL select count ( *) , MAX ( admissioncode ) INTO :ll_validinv, :ll_admissioncode from SaleledgerModified where saleinvcode =:ld_code USING this.it_transobject;
		end if
		if ll_validinv <> 1 then
			this.id_detail.reset()
			messagebox("Invoice Validation", "Invoice does not exist, or ~r~n it does not belong to current sale type")
			this.tab_retrieve.selecttab(2)
			return
		end if
		if not isnull(ll_admissioncode) then
		end if
	end if
	if wf_isinvoiceinuse(ld_code) = true then
		messagebox("Invoice Validation", "Sale Invoice already in use by some other user.~r~nKindly try again after sometime or open some other invoice.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.im_menu.m_file.m_print.enabled = true
	this.i_editmode = 2
	this.i_retrievemode = 2
	this.id_dwcontrol = this.id_master
	ll_rowcount = wf_retrieve(ld_code)
	this.id_master.setrow(1)
	this.id_master.scrolltorow(1)
	this.id_dwcontrol = this.id_footer
	wf_retrieve(ld_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	this.id_dwcontrol = this.id_detail
	wf_retrieve(ld_code)
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	this.id_dwcontrol = this.id_list
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	lb_modify = true
	if not lb_modify then
		this.im_menu.m_file.m_save.enabled = false
		this.editflag = false
	else
		li_protect = 0
		wf_initmodify(li_protect)
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_salegodown
	end if
	wf_setgodownoption()
	this.il_custcode = this.id_master.getitemnumber(1, "custcode")
	if li_protect = 0 then
		li_ismodifysaleprice = 1
		li_ismodifyitemdiscperc = 1
		li_ismodifyitemflatdisc = 1
		li_modifysalestax = 1
		li_ismodifysaleprice = 0
		li_ismodifyitemdiscperc = 0
		li_ismodifyitemflatdisc = 0
		li_modifysalestax = 0
		this.id_detail.object.saleprice.protect = li_ismodifysaleprice
		this.id_detail.object.discperc.protect = li_ismodifyitemdiscperc
		this.id_detail.object.itemflatdisc.protect = li_ismodifyitemflatdisc
		this.id_detail.object.unitsalestax.protect = li_modifysalestax
		this.id_detail.object.gstperc.protect = li_modifysalestax
	end if
	this.im_menu.m_file.m_new.enabled = false
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	wf_grandtotal()
	setredraw(true)

// w_sale_modified.ue_newitem() returns 0
	long ll_insrow
	long ll_currentrow
	integer li_defaultgcode
	long ll_rowcount
	setnull(this.is_aliasname)
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	if f_stringpreferences("AutoSelectLastGodownInSale") = "Y" and this.id_detail.rowcount() > 0 then
		this.id_detail.object.gcode.initial = string(this.id_detail.object.gcode[this.id_detail.rowcount()])
	end if
	ll_currentrow = this.id_detail.getrow()
	ll_rowcount = this.id_detail.rowcount()
	if ll_currentrow = ll_rowcount then
		ll_insrow = this.id_detail.insertrow(0)
	else
		ll_insrow = this.id_detail.insertrow(ll_currentrow)
	end if
	this.id_detail.scrolltorow(ll_insrow)
	this.id_detail.setfocus()
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true
	this.ii_defaultgcode = this.ii_salegodown

// w_sale_modified.ue_deleteitem() returns 0
	long ll_row
	long ll_footerrow
	call super::ue_deleteitem
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() > 0 then
		this.id_footer.setitem(ll_footerrow, "icode", this.id_detail.getitemnumber(ll_row, "icode"))
		this.id_footer.setitem(ll_footerrow, "stock", this.id_detail.getitemnumber(ll_row, "stock"))
		return
	end if
	this.id_footer.setitem(ll_footerrow, "icode", 0)
	this.id_footer.setitem(ll_footerrow, "stock", 0)
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_save.enabled = false

// w_sale_modified.close() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	if f_stringpreferences("DisplayPool") = "Y" then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
			this.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
			postevent("ue_show")
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
			this.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
			this.ic_comport.triggerevent("ue_show")
		else
			this.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
			this.ic_comport.triggerevent("ue_show")
		end if
	end if
	return 1

// w_sale_modified.ue_list() returns 0
	long ll_row
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_new.enabled = false
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	this.tab_retrieve.tabpage_list.em_invno.selecttext(1, 7)
	this.tab_retrieve.tabpage_list.em_invno.clear()
	this.il_norcotixcode = -1
	ll_row = wf_retrievelist()
	wf_disabledetailtab(ll_row)
	post event ue_enableprint()

// w_sale_modified.ue_print() returns 0
	long ll_custcode
	long ll_row
	long ll_invcode
	long t
	long ll_currrow
	string ls_custname
	string ls_posted
	string ls_pagesize
	integer li_option
	integer li_reprintingcounter
	integer li_printretcode
	double ld_balance
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	ll_currrow = this.id_master.getrow()
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	SQL SELECT ISNULL ( reprintingcounter , 0 ) , invoicesize INTO :li_reprintingcounter, :ls_pagesize FROM saleledgermodified WHERE saleinvcode =:ll_invcode USING this.it_transobject;
	if not lb_listtab then
		li_reprintingcounter = li_reprintingcounter + 1
		SQL update SaleLedgerModified SET ReprintingCounter =:li_reprintingcounter WHERE saleinvcode =:ll_invcode USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Database Error", "Some database problem has occur")
		SQL rollback USING this.it_transobject;
		return
	else
		SQL commit USING this.it_transobject;
	end if
	if this.ii_saletype = 2 then
		this.ib_printout = false
	end if
	wf_selectprintreport(ls_pagesize)
	this.id_print.retrieve(ll_invcode)
	if f_stringpreferences("CustBalanceOnPrintOut") = "Y" and (ls_pagesize = "F" or ls_pagesize = "H") and this.ii_saletype = 2 and gs_company <> "SA" and this.id_print.getitemstring(1, "Posted") = "N" then
		ll_custcode = this.id_print.getitemnumber(1, "CustCode")
		SQL rollback USING sqlca;
		ld_balance = 0
		sqlca.absoluteopeningbalance(ll_custcode, ld_balance)
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
			messagebox("Balance Problem", "Unable to fetch balance on sales printing.")
			return
		end if
		this.id_print.setitem(this.id_print.rowcount(), "balance", ld_balance)
	end if
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		else
			li_reprintingcounter = li_reprintingcounter + 1
			SQL update SaleLedgerModified SET ReprintingCounter =:li_reprintingcounter WHERE saleinvcode =:ll_invcode USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Database Error", "Some database problem has occur during updation of reprinting counter.")
				SQL rollback USING this.it_transobject;
				return
			else
				SQL commit USING this.it_transobject;
			end if
		end if
	end if
	if f_stringpreferences("saleaskforcopies") = "Y" then
		open(w_printer_copies)
		this.id_print.object.datawindow.print.copies = string(message.doubleparm)
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		wf_setimgonprint(1)
		li_printretcode = this.id_print.print()
		wf_setimgonprint(0)
		if li_printretcode < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_sale_modified.ue_refreshddw() returns 0
	long ll_prow
	long ll_pcode
	call super::ue_refreshddw
	if this.ii_saletype <> 3 then
		setpointer(hourglass!)
		this.idc_customers.setredraw(false)
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.retrieve()
		this.idc_customers.setredraw(true)
		setpointer(arrow!)
	end if
	this.idc_doctors.setredraw(false)
	this.idc_doctors.settransobject(this.it_transobject)
	this.idc_doctors.retrieve()
	this.idc_doctors.setredraw(true)
	this.idc_patient.setredraw(false)
	this.idc_patient.settransobject(this.it_transobject)
	this.idc_patient.retrieve(this.ii_salemodule)
	ll_prow = this.idc_patient.insertrow(0)
	setnull(ll_pcode)
	this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
	this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
	this.idc_patient.setitem(ll_prow, "name", "<NONE>")
	this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
	this.idc_patient.setitem(ll_prow, "city", "<NONE>")
	this.idc_patient.scrolltorow(ll_prow)
	this.idc_patient.setredraw(true)

// w_sale_modified.ue_new() returns 0
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_sale_modified.ue_postopen() returns 0
	datawindowchild ldc_headerno
	m_salemodifiedmenu lm_menu
	integer li_rtncode
	integer li_defaultgodown
	integer i
	long ll_counter
	long ll_pos
	long ll_prow
	long ll_pcode
	long ll_found
	integer li_defaultsaleprice
	integer li_defaultitemdiscperc
	datastore lds_headers
	call super::ue_postopen
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	this.ids_invoiceinfo = create datastore
	this.ids_invoiceinfo.dataobject = "d_saleinvinfo"
	this.ids_invoiceinfo.settransobject(this.it_transobject)
	lm_menu = this.menuid
	setredraw(false)
	wf_setsaletype(integer(message.doubleparm))
	if this.ii_saletype = 2 then
		this.ii_salemodule = 11
	else
		this.ii_salemodule = 10
	end if
	this.id_print = this.dw_saleinvrep
	this.id_saleinvdetail = this.dw_saleinvdetail
	this.id_saleinvdetail.settransobject(this.it_transobject)
	choose case this.ii_saletype
	case 2
		this.title = "Credit Sale Modifed"
		wf_assigndatawindowobjects("d_CreditSaleHeader_Modified", "d_CreditSaleDetail_Modified", "d_CreditSaleFooter_Modified", "d_CreditSaleInvlist_Modified", "d_wholeSaleModifiedInvReportwh")
		if gs_company = "CMH" or gs_company = "NM" or gs_company = "FZGUL" then
			this.id_master.object.custrefno.editmask.mask = "########0"
			this.id_master.object.custrefno.editmask.required = true
		end if
		if f_stringpreferences("InSaleCustomerBalance") = "Y" then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
			this.ids_customersbalance = create datastore
			this.ids_customersbalance.dataobject = "d_customerbalances_in_sales"
			this.ids_customersbalance.settransobject(sqlca)
			this.ids_customersbalance.retrieve()
		else
			this.id_master.object.debitorcredit.visible = false
			this.id_master.object.customerbalance.visible = false
			this.id_master.object.t_balance.visible = false
		end if
		li_rtncode = this.id_master.getchild("custcode", this.idc_customers)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.retrieve()
		this.idc_customers.setfilter("accounts_acccode <> 19")
		this.idc_customers.filter()
		this.id_master.object.custcode.initial = "0"
		this.im_menu.m_file.m_post.visible = true
		this.im_menu.m_file.m_post.toolbaritemvisible = true
		this.ib_creditmodify = true
		this.ib_creditmodify = true
		li_rtncode = this.id_master.getchild("patientcode", this.idc_patient)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_patient.settransobject(this.it_transobject)
		this.idc_patient.retrieve(this.ii_salemodule)
		ll_prow = this.idc_patient.insertrow(0)
		setnull(ll_pcode)
		this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
		this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
		this.idc_patient.setitem(ll_prow, "name", "<NONE>")
		this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
		this.idc_patient.setitem(ll_prow, "city", "<NONE>")
		this.idc_patient.scrolltorow(ll_prow)
		if f_stringpreferences("patientOnCreditSale") <> "H" then
			this.id_master.object.patientcode.visible = false
			this.id_master.object.t_regno.visible = false
			this.id_master.object.t_patient.visible = false
			this.id_master.object.patientregno.visible = false
		end if
	case 3
		this.title = "Cash Sale Modified"
		wf_assigndatawindowobjects("d_CashSaleHeader_Modified", "d_CreditSaleDetail_Modified", "d_CreditSaleFooter_Modified", "d_CreditSaleInvlist_Modified", "d_retailSaleModifiedInvReportwh")
		this.it_transobject.getglobalcode("GT_RetailSaleCustomerACC", this.il_code)
		this.ib_retailmodify = true
		if f_stringpreferences("SaleCashWindow") = "Y" then
			this.id_footer.object.t_balance.visible = true
			this.id_footer.object.t_bal_alias.visible = true
		end if
		li_rtncode = this.id_master.getchild("custcode", this.idc_customers)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.retrieve()
		li_rtncode = this.id_master.getchild("patientcode", this.idc_patient)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_patient.settransobject(this.it_transobject)
		this.idc_patient.retrieve(this.ii_salemodule)
		ll_prow = this.idc_patient.insertrow(0)
		setnull(ll_pcode)
		this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
		this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
		this.idc_patient.setitem(ll_prow, "name", "<NONE>")
		this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
		this.idc_patient.setitem(ll_prow, "city", "<NONE>")
		this.idc_patient.scrolltorow(ll_prow)
		if f_stringpreferences("patientOnRetailSale") <> "H" then
			this.id_master.object.patientcode.visible = false
			this.id_master.object.t_regno.visible = false
			this.id_master.object.t_patient.visible = false
			this.id_master.object.patientregno.visible = false
		end if
		SQL SELECT defaultsaleprice , defaultitemdiscperc INTO :li_defaultsaleprice, :li_defaultitemdiscperc FROM Customer WHERE custcode =19 USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.id_master.object.sprice.initial = string(li_defaultsaleprice)
			this.id_master.object.itemdiscpercno.initial = string(li_defaultitemdiscperc)
		else
			messagebox("Customer Information", "Error in Retrieving Customer Information")
			close(this)
		end if
	end choose
	li_rtncode = this.id_master.getchild("doctcode", this.idc_doctors)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_doctors.settransobject(this.it_transobject)
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit to Make Sales")
		close(this)
		return
	end if
	li_rtncode = this.id_detail.getchild("gcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to sale")
		close(this)
		return
	end if
	this.ii_salegodown = this.idc_godown.getitemnumber(1, "gcode")
	this.id_detail.object.gcode.initial = string(this.ii_salegodown)
	li_rtncode = this.id_master.getchild("sprice", this.idc_price)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_price.settransobject(this.it_transobject)
	li_rtncode = this.idc_price.retrieve(this.ii_module, this.il_groupcode)
	this.id_master.object.sprice.initial = string(this.idc_price.getitemnumber(1, "pricetypecode"))
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Price Rights to sale")
		close(this)
		return
	end if
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = true
	this.id_itemslist.object.sstock.visible = true
	this.id_itemslist.object.t_pstock.visible = false
	this.id_itemslist.object.pstock.visible = false
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 513 and f_stringpreferences("CaSPNo") = "Y" then
			this.id_master.object.sprice.visible = true
			this.id_master.object.t_sprice.visible = true
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 522 then
			this.id_master.object.dd_gstperc.visible = true
			this.id_master.object.gstperc_t.visible = true
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 523 then
			this.id_footer.object.rpp.visible = true
			this.id_footer.object.t_rpp.visible = true
			this.id_footer.object.avgprice.visible = true
			this.id_footer.object.purprice.visible = true
			this.id_footer.object.retailprice.visible = true
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 550 then
			lm_menu = this.menuid
			lm_menu.m_file.m_dueitem.enabled = true
			lm_menu.m_file.m_dueitem.visible = true
		end if
	next
	if f_stringpreferences("Itemflatdisc") = "N" then
		this.id_detail.object.itemflatdisc.visible = false
	end if
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Sales")
		close(this)
		return
	end if
	if f_stringpreferences("headeronsaleinv") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.t_headerno.visible = false
		this.id_master.object.headerinvno.visible = false
		this.id_master.object.t_headerinvno.visible = false
	end if
	this.id_master.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to lds_headers.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
		ldc_headerno.setitem(ll_counter, "name", "")
	next
	this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
	this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.t_gcode.visible = true
		this.id_master.object.gcode.visible = true
		this.id_master.object.gcode.initial = string(this.ii_salegodown)
		this.id_detail.object.gcode.visible = false
		this.id_footer.object.t_totalstock.visible = false
		this.id_footer.object.totalstock.visible = false
	end if
	if f_stringpreferences("SaleItemdescription") = "N" then
		this.id_detail.object.saleitemdescription.visible = false
	end if
	if f_stringpreferences("Saleclaimable") = "N" then
		this.id_detail.object.claimable.visible = false
	end if
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.sstock.visible = false
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	gd_itemsinfo.sharedata(this.id_itemslist)
	if this.ii_saletype = 3 and (gs_company = "SHE" or gs_company = "RIZWAN" or gs_company = "REHMAT") then
		wf_visibleinvisiblediscount()
		li_defaultgodown = this.ii_salegodown
	end if
	if this.ii_saletype = 3 and f_stringpreferences("discpercinretail") = "N" then
		wf_visibleinvisiblediscount()
	end if
	if this.ii_saletype = 2 and f_stringpreferences("discpercincredit") = "N" then
		wf_visibleinvisiblediscount()
	end if
	if gs_company = "SHE" or gs_company = "RIZWAN" or gs_company = "REHMAT" then
		this.id_footer.object.t_2.visible = true
		this.id_footer.object.t_purdiscper.visible = true
	end if
	if f_stringpreferences("itemunittax") = "N" then
		this.id_detail.object.unitsalestax.visible = false
		this.id_detail.object.taxperunit_t.visible = false
		this.id_detail.object.c_sumtaxval.visible = false
		this.id_detail.object.c_taxval.visible = false
		this.id_detail.object.taxval_t.visible = false
	end if
	if f_stringpreferences("itemgstperc") = "N" then
		this.id_detail.object.gstperc.visible = false
		this.id_detail.object.gstperc_t.visible = false
		this.id_detail.object.c_sumgstval.visible = false
		this.id_detail.object.c_gstval.visible = false
		this.id_detail.object.gstval_t.visible = false
	end if
	if f_stringpreferences("invgstperc") = "N" then
		this.id_footer.object.invgstperc1.visible = false
		this.id_footer.object.invgstperc1_t.visible = false
	end if
	if f_stringpreferences("SaleOnZeroPrice") = "N" then
		this.id_detail.setvalidate("Saleprice", "Number(GetText( )) > 0")
	end if
	this.id_master.object.invoicesize.initial = f_stringpreferences("pagesize")
	if f_stringpreferences("bonusinsale") = "N" then
		this.id_detail.object.bonusqty.visible = false
		this.id_footer.object.t_bonus.visible = false
		this.id_footer.object.bonusratio.visible = false
	end if
	if f_stringpreferences("messageinsale") = "N" then
		this.id_master.object.messagecode.visible = false
		this.id_master.object.t_message.visible = false
	end if
	if f_stringpreferences("salesmaninsale") = "N" then
		this.id_master.object.smancode.visible = false
		this.id_master.object.t_salesman.visible = false
	end if
	if f_stringpreferences("defaultwaranty") = "Y" then
		this.id_master.object.printwaranty.initial = "Y"
	else
		this.id_master.object.printwaranty.initial = "N"
	end if
	if f_stringpreferences("SaleDisplayItemDiscPerc") = "Y" then
		this.id_master.object.itemdiscpercno.visible = true
		this.id_master.object.t_itemdiscpercno.visible = true
	end if
	f_setcolumnstyle(this.id_detail, "Qty")
	wf_set_itemtotal_formatmask()
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.id_master.accepttext()
	setredraw(true)

// w_sale_modified.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	return ::message.returnvalue

// ic_comport.ue_show() returns long
	if isnull(parent.is_lcditem) then
		if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
			parent.is_lcditem = char(26) + char(1)
			parent.ic_comport.triggerevent("ue_show")
			parent.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
			parent.ic_comport.triggerevent("ue_show")
			return 1
		elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
			parent.is_lcditem = "     THANK YOU         FOR YOUR VISIT  "
		else
			parent.is_lcditem = char(12) + char(27) + char(81) + char(68) + " THANK YOU FOR SHOPPING AT POT POURRI SUPER STORE " + char(13)
		end if
	end if
	this.object.portopen = true
	if upper(f_stringpreferences("DisplayPoolCompany")) = "JARLTECH" then
		this.object.output = char(26) + parent.is_lcditem
	elseif upper(f_stringpreferences("DisplayPoolCompany")) = "DSP-2022" then
		this.object.output = char(12) + parent.is_lcditem
	else
		this.object.output = char(12) + parent.is_lcditem
	end if
	this.object.portopen = false
	return 1

// ic_comport.constructor() returns long
	integer li_defaultcomport
	if f_stringpreferences("DisplayPool") = "Y" then
		li_defaultcomport = f_numberpreferences("DefaultComPort")
		if isnull(li_defaultcomport) then
			li_defaultcomport = 2
		end if
		this.object.commport = li_defaultcomport
		this.object.settings = "9600,N,8,1"
		this.object.inputlen = 0
	end if
	return ::message.returnvalue

// ic_drawerport.constructor() returns long
	integer li_defaultcomport
	if f_stringpreferences("CashDrawer") = "Y" then
		li_defaultcomport = f_numberpreferences("DefaultComPort")
		if li_defaultcomport = 1 then
			this.object.commport = 2
		elseif li_defaultcomport = 2 then
			this.object.commport = 1
		else
			this.object.commport = 1
		end if
		this.object.settings = "300,N,8,1"
		this.object.inputlen = 0
	end if
	return ::message.returnvalue
