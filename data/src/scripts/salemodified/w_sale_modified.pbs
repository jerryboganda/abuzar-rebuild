// window w_sale_modified (salemodified)  ancestor: w_multi_entry

// w_sale_modified.ue_printdo() returns 0
	long ll_custcode
	long ll_row
	string ls_custname
	string ls_pagesize
	integer li_option
	if this.im_menu.m_file.m_save.enabled = true then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	ls_pagesize = this.id_master.getitemstring(1, "invoicesize")
	if f_stringpreferences("PurBatch") = "Y" and f_stringpreferences("PurExpiry") = "Y" then
		if gs_company = "MARSHAL" then
			if ls_pagesize = "H" then
				this.id_print.dataobject = "d_marshal_deliveryorder_half"
			else
				this.id_print.dataobject = "d_marshal_deliveryorder_full"
			end if
		else
			this.id_print.dataobject = "d_deliveryorder_batchexpiry_half"
		end if
	elseif gs_company = "MARSHAL" then
		if ls_pagesize = "H" then
			this.id_print.dataobject = "d_marshal_deliveryorder_half"
		else
			this.id_print.dataobject = "d_marshal_deliveryorder_full"
		end if
	else
		this.id_print.dataobject = "d_deliveryorder_half"
	end if
	if gs_company = "SAH" then
		this.id_print.dataobject = "d_sah_deliveryorder_full"
	end if
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(this.id_master.getitemnumber(1, "code"))
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_sale_modified.ue_enableprint() returns 0
	this.im_menu.m_file.m_print.enabled = true

// w_sale_modified.wf_getmaxdate(datetime ad_date) returns integer
	SQL Select Max ( Date ) INTO :ad_date From saleledger USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_sale_modified.wf_savastemplate() returns integer
	s_saletemplateheader lstr_templateheader
	long ll_invid
	integer li_retcode
	long ll_code
	long ll_qty
	long ll_icode
	long ll_totalrows
	long ll_rowcount
	open(w_savesaleastemplate)
	lstr_templateheader = message.powerobjectparm
	f_newtableid("SaleTemplateHeader", ll_invid)
	SQL INSERT INTO SaleTemplateHeader ( saletemplatecode , date , modified , name ) values ( :ll_invid , :lstr_templateheader.dt_templatedate , :lstr_templateheader.dt_templatedate , :lstr_templateheader.s_template ) USING this.it_transobject;
	ll_totalrows = this.id_detail.rowcount()
	for ll_rowcount = 1 to ll_totalrows
		ll_code = ll_invid
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ll_qty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		SQL insert into saletemplatedetail ( saletemplatecode , icode , looseqty ) values ( :ll_code , :ll_icode , :ll_qty ) USING this.it_transobject;
	next
	setpointer(hourglass!)
	if this.it_transobject.sqlcode < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return li_retcode
	else
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Template saved", exclamation!, ok!, 1)
	end if
	return li_retcode

// w_sale_modified.wf_getitemassociategcode(long la_icode) returns integer
	integer li_gcode
	SQL Select Gcode INTO :li_gcode From item Where icode =:la_icode USING this.it_transobject;
	return li_gcode

// w_sale_modified.wf_deletesaleinvoice(long al_saleinvcode) returns integer
	SQL Delete saledetail Where saledetail.SaleInvCode =:al_saleinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_sale_modified.wf_preinvinfo() returns 0
	s_previnvinfo ls_previnvinfo
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_previnvinfo.ar_customer = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		ls_previnvinfo.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_previnvinfo.ar_invdate = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_previnvinfo, ls_previnvinfo)
	end if

// w_sale_modified.wf_setsuppinfo(long al_suppcode, datawindow ad_master) returns 0
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	SQL SELECT supplier.address1 , supplier.city , supplier.phone INTO :ls_address, :ls_city, :ls_phone FROM supplier WHERE supplier.suppcode =:al_suppcode USING this.it_transobject;
	ll_currow = ad_master.getrow()
	ad_master.object.supplier_address[ll_currow] = ls_address
	ad_master.object.supplier_city[ll_currow] = ls_city
	ad_master.object.supplier_phone[ll_currow] = ls_phone

// w_sale_modified.wf_updatesaleprice(long al_icode, double ad_saleprice) returns integer
	SQL update Item SET saleprice =:ad_saleprice WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_sale_modified.wf_validateitemnew() returns integer
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
		messagebox(ls_titleerrtext, ls_errtext)
	elseif not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		ls_titleerrtext = "Item Validation"
		li_errcode = -2
	end if
	this.ib_itemvalidated = true
	return li_errcode

// w_sale_modified.wf_closelist() returns 0
	this.ib_itemslistopen = false
	this.id_itemslist.hide()

// w_sale_modified.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	long iccode
	long icatcode
	long packcode
	long manfcode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_sale_modified.wf_print() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_count
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			for ll_count = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
				this.id_print.retrieve(ll_count)
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			next
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	return li_errcode

// w_sale_modified.wf_findpatientcode(string as_regno, integer ai_patientcode) returns integer
	integer li_patientcode
	integer ll_retflag
	string ls_itemname
	SQL SELECT patient.patientcode INTO :li_patientcode FROM patient WHERE patient.regno =:as_regno and patient.patientcatcode IN ( SELECT DISTINCT patientcatcode FROM PatientCatAllowedModule WHERE PatientCatCode =:this.ii_salemodule ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_patientcode = li_patientcode
		if isnull(ai_patientcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_sale_modified.wf_setsaletype(integer ai_saletype) returns 0
	this.ii_saletype = ai_saletype

// w_sale_modified.wf_visibleinvisiblediscount() returns integer
	this.id_detail.object.discperc.visible = 0
	this.id_detail.object.discperc.initial = "0"
	return 1

// w_sale_modified.wf_customermessagevalidation(long al_custcode, long al_messagecode) returns integer
	integer li_messagecode
	long ll_currrow
	SQL SELECT customer.messagecode INTO :li_messagecode FROM customer WHERE customer.custcode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currrow = this.id_master.getrow()
		if isnull(li_messagecode) then
			ll_currrow = 0
		else
			ll_currrow = 1
		end if
	end if
	return ll_currrow

// w_sale_modified.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean lb_rtflag
	boolean ib_due
	integer li_null
	string ls_null
	ls_titleerrtext = "Item Validation"
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), al_currrow) = true then
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
	elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			li_option = messagebox("Item Validation", "Item stock does not exist~n~rDo You want to due this item", information!, yesno!, 2)
			if li_option = 1 then
				this.id_detail.setitem(this.il_currrow, "looseqty", 1)
				this.id_detail.setitem(this.il_currrow, "dueqty", 1)
				ib_due = true
			else
				li_errcode = -1
			end if
		end if
	else
		li_errcode = -1
		ls_titleerrtext = "Item Validation"
	end if
	if li_errcode = -1 and not ib_due then
		lb_rtflag = false
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setitem(al_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(al_currrow, "icode", li_null)
		this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	end if
	return lb_rtflag

// w_sale_modified.wf_returnsaleinvoice(long al_invid, string as_errtext) returns boolean
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_counter
	long ll_detailrows
	string ls_batch
	string ls_due
	datetime ld_expiry
	boolean lb_commitflag
	double ld_avgprice
	double ld_looseqty
	double ld_bonusqty
	double ld_stock
	double ld_newstock
	this.id_saleinvdetail.retrieve(al_invid)
	ll_detailrows = this.id_saleinvdetail.rowcount()
	ll_counter = 1
	do while ll_counter <= ll_detailrows and lb_commitflag
		ll_gcode = this.id_saleinvdetail.getitemnumber(ll_counter, "gcode")
		ll_icode = this.id_saleinvdetail.getitemnumber(ll_counter, "icode")
		ls_batch = this.id_saleinvdetail.getitemstring(ll_counter, "batch")
		ld_expiry = this.id_saleinvdetail.getitemdatetime(ll_counter, "expiry")
		ld_looseqty = this.id_saleinvdetail.getitemnumber(ll_counter, "looseqty")
		ld_bonusqty = this.id_saleinvdetail.getitemnumber(ll_counter, "bonusqty")
		ls_due = this.id_saleinvdetail.getitemstring(ll_counter, "Due")
		if ls_due <> "D" and ls_due <> "S" or isnull(ls_due) then
			this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
			if this.it_transobject.sqlcode = 0 then
				this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					ld_newstock = ld_stock + ld_looseqty + ld_bonusqty
					this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
					if this.it_transobject.sqlcode <> 0 then
						lb_commitflag = false
					end if
					if ld_stock = 0.0 then
						SQL update GodownDetail Set Priority =1 Where GodownDetail.GCode =:ll_gcode and GodownDetail.ICode =:ll_icode and GodownDetail.Batch =:ls_batch and GodownDetail.Expiry =:ld_expiry USING this.it_transobject;
					end if
				else
					lb_commitflag = false
				end if
			else
				lb_commitflag = false
			end if
		end if
		ll_counter = ll_counter + 1
	loop
	if lb_commitflag then
		if wf_deletesaleinvoice(al_invid) <> 0 then
			lb_commitflag = false
			as_errtext = "    Some database problem occur"
		end if
	else
		as_errtext = "    Some database problem occur"
	end if
	return lb_commitflag

// w_sale_modified.wf_dueitem() returns 0
	s_dueinfo ls_due
	long ll_row
	long li_null
	long ll_code
	long ll_counter
	long ll_icode
	long ll_gcode
	string ls_null
	double ld_qty
	double ld_dueqty
	double ld_godownstock
	this.id_detail.accepttext()
	if this.id_detail = getfocus() and this.id_detail.getcolumnname() = "looseqty" or this.id_detail.getcolumnname() = "gcode" then
		ll_row = this.id_detail.getrow()
		ll_code = this.id_master.getitemnumber(this.id_master.getrow(), "code")
		if not isnull(ll_code) then
			this.ids_invoiceinfo.retrieve(ll_code)
			ll_icode = this.id_detail.getitemnumber(ll_row, "icode")
			ll_gcode = this.id_detail.getitemnumber(ll_row, "gcode")
			this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Stock Validation", "Database Error: Item information can not be retrieved")
			end if
			for ll_counter = 1 to this.ids_invoiceinfo.rowcount()
				if ll_icode = this.ids_invoiceinfo.getitemnumber(ll_counter, "icode") then
					if isnull(this.ids_invoiceinfo.getitemstring(ll_counter, "due")) then
						ld_qty = ld_qty + this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty")
					else
						ld_dueqty = ld_dueqty + this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty")
					end if
				end if
			next
			ls_due.qty = ld_qty
			ls_due.dueqty = ld_dueqty
			ls_due.stock = ld_godownstock + ld_qty
		else
			ls_due.qty = 0
			ls_due.dueqty = this.id_detail.getitemnumber(ll_row, "dueqty")
			ls_due.stock = this.id_detail.getitemnumber(ll_row, "stock")
		end if
		ls_due.itemname = this.id_detail.getitemstring(ll_row, "itemname")
		openwithparm(w_dueinfo, ls_due)
		ls_due = message.powerobjectparm
		ld_qty = ls_due.qty
		ld_dueqty = ls_due.dueqty
		setnull(ls_null)
		setnull(li_null)
		if ld_qty >= 0.0 then
			this.id_detail.setitem(ll_row, "looseqty", ld_qty)
			this.id_detail.setitem(ll_row, "dueqty", ld_dueqty)
		end if
		if ld_dueqty > 0.0 then
			this.id_detail.setitem(ll_row, "due", "D")
		else
			this.id_detail.setitem(ll_row, "due", ls_null)
		end if
		return
	end if
	ll_row = this.id_detail.getrow()

// w_sale_modified.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_sale_modified.wf_visible(boolean ab_flag) returns 0

// w_sale_modified.wf_itemnetprice(double al_saleprice, double al_discperc, double al_itemflatdisc, long al_icode) returns integer
	double ld_saleprice
	double ld_recentpurprice
	double ld_discperc
	double ld_itemflatdisc
	double ld_itemnetprice
	integer li_packunits
	integer li_retmsgcode
	SQL Select item.RecentPurPrice , item.packunits INTO :ld_recentpurprice, :li_packunits From Item Where item.icode =:al_icode USING this.it_transobject;
	if li_packunits < 1 or isnull(li_packunits) then
		li_packunits = 1
	end if
	ld_itemnetprice = (al_saleprice - al_itemflatdisc) * (1.0 - al_discperc / 100.0)
	if ld_itemnetprice < ld_recentpurprice / li_packunits then
		li_retmsgcode = messagebox("Sale Validation", "Net Price " + string(ld_itemnetprice) + " is less than Recent Purchase Price~r~n Do you want to continue", question!, yesno!)
		if li_retmsgcode = 1 then
			return 0
		else
			return 1
		end if
		return
	end if
	return 0

// w_sale_modified.wf_populate_ddlb(datawindow dwcontrol) returns 0
	integer li_column_count
	integer li_counter
	string ls_column_name
	string ls_columntype
	this.tab_retrieve.tabpage_list.ddlb_filter_column.reset()
	this.tab_retrieve.tabpage_list.ddlb_sort.reset()
	li_column_count = integer(dwcontrol.object.datawindow.column.count)
	for li_counter = li_column_count to li_counter step -1
		ls_column_name = dwcontrol.describe("#" + string(li_counter) + ".Name")
		this.tab_retrieve.tabpage_list.ddlb_sort.additem(ls_column_name)
		this.tab_retrieve.tabpage_list.ddlb_filter_column.additem(ls_column_name)
	next
	this.tab_retrieve.tabpage_list.ddlb_sort.text = ls_column_name
	ls_columntype = this.id_dwcontrol.describe("#1.ColType")
	if left(ls_columntype, 4) = "char" then
		this.ii_type = 1
	elseif left(ls_columntype, 4) = "date" then
		this.ii_type = 3
	else
		this.ii_type = 2
	end if
	this.ii_colindex = 1
	this.tab_retrieve.tabpage_list.rb_descending.checked = true
	wf_sortdw(this.tab_retrieve.tabpage_list.ddlb_sort.text, this.is_sortsequence)
	if this.ii_saletype = 3 then
		this.id_detail.setfocus()
		return
	end if
	this.id_master.setfocus()

// w_sale_modified.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_discountvalue
	double ld_invtaxperc1val
	double ld_intaxperc1
	double ld_totaltax
	double ld_totalitemleveltax
	real lr_discperc
	real lr_flatdisc
	real lr_misccharges
	real lr_salestax
	real lr_itemstotal
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		lr_discperc = this.id_footer.object.invdiscperc[1]
		lr_flatdisc = this.id_footer.object.flatdisc[1]
		lr_misccharges = this.id_footer.object.misccharges[1]
		lr_salestax = this.id_footer.object.salestax[1]
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
		ld_intaxperc1 = this.id_footer.object.invgstperc1[1]
		ld_totalitemleveltax = this.id_detail.getitemnumber(1, "c_sumtaxval") + this.id_detail.getitemnumber(1, "c_sumgstval")
		this.id_footer.object.t_discountvalue.text = string(ld_detaildwtotal * lr_discperc * 0.01, "########0.00")
		ld_discountvalue = ld_detaildwtotal * lr_discperc * 0.01
		ld_grandtotal = ld_detaildwtotal - ld_discountvalue - lr_flatdisc + lr_misccharges + lr_salestax
		ld_invtaxperc1val = round((ld_detaildwtotal - ld_discountvalue - lr_flatdisc) * ld_intaxperc1 * 0.01, 2)
		ld_totaltax = round(ld_invtaxperc1val + ld_totalitemleveltax, 0)
		ld_grandtotal = round(ld_grandtotal, 0) + ld_totaltax
		this.id_footer.setitem(1, "total", ld_grandtotal)
	end if
	return ld_grandtotal

// w_sale_modified.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_sale_modified.wf_setiteminfo(long al_icode, long al_row, double ad_saleprice, double ad_discperc, long al_stock, double ad_avgprice, long al_totalstock, double ad_purdiscperc) returns 0
	this.id_detail.setitem(al_row, "saleprice", ad_saleprice)
	if this.ii_saletype = 2 then
		this.id_detail.setitem(al_row, "discperc", ad_discperc)
	else
		this.id_detail.setitem(al_row, "discperc", 0.0)
	end if
	this.id_detail.setitem(al_row, "rate", ad_saleprice)
	this.id_detail.setitem(al_row, "avgprice", ad_avgprice)
	this.id_footer.object.icode[this.id_footer.getrow()] = al_icode
	this.id_footer.object.stock[this.id_footer.getrow()] = al_stock

// w_sale_modified.wf_validategodown() returns integer
	long ll_icode
	long ll_gcode
	long ll_stock
	long ll_counter
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	string ls_null
	integer li_errcode
	integer li_null
	integer li_option
	integer li_duperr
	boolean ib_due
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	this.ii_defaultgcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	if wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			if isnull(this.id_detail.getitemstring(this.il_currrow, "due")) then
				li_errcode = -1
			end if
		else
			for ll_counter = 1 to this.id_detail.rowcount()
				if this.il_currrow <> ll_counter and (ll_icode = this.id_detail.getitemnumber(ll_counter, "icode") and this.ii_defaultgcode = this.id_detail.getitemnumber(ll_counter, "gcode")) then
					li_duperr = -2
				end if
			next
		end if
	end if
	this.ib_godownvalidated = true
	if li_errcode = -1 and not ib_due then
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		this.id_detail.setfocus()
		this.id_detail.setcolumn("gcode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
	end if
	if li_duperr = -2 and not ib_due then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate Item, please select some other item"
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
		this.ib_itemslistopen = true
		this.id_itemslist.show()
		li_errcode = -1
	end if
	return li_errcode

// w_sale_modified.wf_findcustcode(string as_aliasname, integer ai_custcode) returns integer
	integer li_custcode
	integer ll_retflag
	string ls_itemname
	SQL SELECT accounts.acccode INTO :li_custcode FROM accounts , customer WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =customer.custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_custcode = li_custcode
		if isnull(ai_custcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_sale_modified.wf_selectcustomerareawise() returns integer
	s_popup_selection ls_popup_selection
	if this.ii_saletype = 2 and this.editflag = true and f_stringpreferences("patientOnCreditSale") <> "H" then
		open(w_popup_areaselection)
		ls_popup_selection = message.powerobjectparm
		if ls_popup_selection.l_code > 0 then
			openwithparm(w_popup_customerselectionareawise, ls_popup_selection)
			ls_popup_selection = message.powerobjectparm
			if ls_popup_selection.l_code > 0 then
				this.id_master.setitem(this.id_master.getrow(), "custcode", ls_popup_selection.l_code)
				wf_setcustomername(ls_popup_selection.s_name)
				wf_setcustomerinfo(this.id_master.getrow(), 1, string(ls_popup_selection.l_code))
			end if
		end if
	end if
	return 1

// w_sale_modified.wf_allowsalemodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM SaleDetail WHERE SaleInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_sale_modified.wf_setcustomer() returns integer
	if f_validatedw(this.id_master) < 0 then
		return -1
	end if

// w_sale_modified.wf_setcustomername(string as_data) returns 0
	long ll_rowno
	ll_rowno = this.idc_customers.find("customer_name >='" + as_data + "'", 1, this.idc_customers.rowcount())
	if ll_rowno > 0 then
		this.idc_customers.selectrow(0, false)
		this.idc_customers.setrow(ll_rowno)
		this.idc_customers.scrolltorow(ll_rowno)
		this.idc_customers.selectrow(ll_rowno, true)
	end if

// w_sale_modified.wf_itemsalehistory() returns 0
	s_itemsalehistory ls_itemsalehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itemsalehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itemsalehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itemsalehistory, ls_itemsalehistory)
	end if

// w_sale_modified.wf_getcustomerinfo() returns 0
	long ll_custcode
	if this.id_master = getfocus() and this.id_master.rowcount() > 0 then
		ll_custcode = this.id_master.getitemnumber(this.id_master.getrow(), "custcode")
		openwithparm(w_customerinfo, ll_custcode)
	end if

// w_sale_modified.wf_setnormalsale() returns 0
	this.ib_saveasnormalsale = true

// w_sale_modified.wf_setgodownoption() returns 0
	this.ii_salegodown = this.id_detail.getitemnumber(1, "gcode")
	if this.il_strategy = 2 or this.il_strategy = 1 and this.il_godowncount = 1 then
		this.id_detail.modify("gcode" + ".Protect=1")
		this.id_detail.object.gcode.background.color = this.backcolor
	end if

// w_sale_modified.wf_validateitem(boolean ab_flag) returns integer
	long ll_icode
	long ll_stock
	long ll_totalstock
	long ll_count
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	integer n
	boolean ib_due
	boolean lb_dupitem
	boolean lb_zerostock
	boolean lb_invalidrow
	integer li_null
	string ls_null
	if isnull(this.il_currrow) or this.il_currrow <= 0 then
		lb_invalidrow = true
		setnull(ll_icode)
	else
		ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	end if
	if not isnull(ll_icode) then
		if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true and f_stringpreferences("AllowDupItemsInSale") = "N" then
			ls_titleerrtext = "Item Validation"
			ls_errtext = "Duplicate item, please select some other item"
			lb_dupitem = true
			li_errcode = -1
		elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
			if li_errcode = -2 then
				lb_zerostock = true
				if ab_flag and isnull(this.id_detail.getitemstring(this.il_currrow, "due")) then
					li_errcode = -1
				end if
			end if
		else
			ls_titleerrtext = "Item Validation"
		end if
	end if
	if ab_flag then
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		if this.il_strategy = 1 and this.il_godowncount > 1 and lb_zerostock then
			messagebox(ls_titleerrtext, "Stock is zero, please select some other godown")
			this.ib_itemslistopen = false
			this.id_itemslist.hide()
			this.id_detail.setcolumn("gcode")
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.gcode[this.il_currrow] = li_null
		elseif lb_dupitem = true then
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.icode[this.il_currrow] = li_null
			this.id_detail.object.fullcode[this.il_currrow] = ls_null
			this.id_detail.object.itemname[this.il_currrow] = ls_null
			for ll_count = 1 to this.id_detail.rowcount()
				if this.id_detail.getitemnumber(ll_count, "icode") = ll_icode then
					wf_deleteemptydetailrow()
					this.id_detail.scrolltorow(ll_count)
					triggerevent("ue_focusqty")
				end if
			next
			messagebox("Item", "Duplicate Item, please select some other item")
		elseif lb_invalidrow = true then
			li_errcode = -1
		else
			ls_titleerrtext = "Item Validation"
			messagebox(ls_titleerrtext, ls_errtext)
			if f_stringpreferences("itemcode") = "N" then
				this.id_detail.setcolumn(this.is_columnitemname)
				this.ib_itemslistopen = true
				this.id_itemslist.show()
			else
				this.id_detail.setcolumn("fullcode")
				this.id_detail.object.fullcode[this.il_currrow] = ls_null
			end if
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.icode[this.il_currrow] = li_null
			this.id_detail.object.itemname[this.il_currrow] = ls_null
			this.id_detail.object.bonusqty[this.il_currrow] = 0
			this.id_detail.object.saleprice[this.il_currrow] = 0.00
			this.id_detail.object.itemflatdisc[this.il_currrow] = 0.00
			this.id_detail.object.discperc[this.il_currrow] = 0.00
			this.id_detail.object.unitsalestax[this.il_currrow] = 0.00
			this.id_detail.object.gstperc[this.il_currrow] = 0.00
		end if
	end if
	return li_errcode

// w_sale_modified.wf_editquotation() returns integer
	datastore lds_quotationdetail
	datastore lds_quotationheader
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	integer li_retcode
	integer li_errcode
	string ls_errortext
	lds_quotationdetail = create datastore
	lds_quotationheader = create datastore
	open(w_editquotationform)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_quotationdetail.dataobject = "d_quotationdetail"
		lds_quotationdetail.settransobject(this.it_transobject)
		lds_quotationheader.dataobject = "d_quotationheader"
		lds_quotationheader.settransobject(this.it_transobject)
		ll_row = lds_quotationheader.retrieve(lstr_template.l_invtemplate)
		lds_quotationdetail.retrieve(lstr_template.l_invtemplate)
		ll_totalrows = lds_quotationheader.retrieve(lstr_template.l_invtemplate)
		if ll_row < 0 then
			li_retcode = -1
		end if
		ll_mrow = this.id_master.getrow()
		this.id_master.setitem(ll_mrow, "quotationno", lstr_template.l_invtemplate)
		if this.ii_saletype = 2 then
			this.id_master.setitem(ll_mrow, "custcode", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "custcode"))
		end if
		this.id_master.setitem(ll_mrow, "sprice", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "sprice"))
		this.id_master.setitem(ll_mrow, "remarks", lds_quotationheader.getitemstring(lds_quotationheader.getrow(), "remarks"))
		this.id_master.setitem(ll_mrow, "headerno", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "headerno"))
		this.id_footer.setitem(ll_mrow, "misccharges", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "misccharges"))
		this.id_footer.setitem(ll_mrow, "flatdisc", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "flatdisc"))
		ll_totalrows = lds_quotationdetail.rowcount()
		for ll_rowcount = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		this.id_detail.reset()
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_quotationdetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "packunits", lds_quotationdetail.getitemnumber(ll_rowcount, "packunits"))
			this.id_detail.setitem(ll_rowcount, "discperc", lds_quotationdetail.getitemnumber(ll_rowcount, "discperc"))
			this.id_detail.setitem(ll_rowcount, "itemflatdisc", lds_quotationdetail.getitemnumber(ll_rowcount, "itemflatdisc"))
			this.id_detail.setitem(ll_rowcount, "saleprice", lds_quotationdetail.getitemnumber(ll_rowcount, "saleprice"))
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_quotationdetail.getitemnumber(ll_rowcount, "looseqty"))
		next
		this.id_footer.setitem(ll_mrow, "invdiscperc", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "discperc"))
	end if
	wf_grandtotal()
	return li_retcode

// w_sale_modified.wf_customerinfo(long al_custcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	string ls_aliasname
	integer li_messagecode
	long ll_currow
	double ld_currbalance
	SQL SELECT customer.address1 , customer.city , customer.phone , customer.messagecode , accounts.aliasname INTO :ls_address, :ls_city, :ls_phone, :li_messagecode, :ls_aliasname FROM customer , accounts WHERE customer.custcode =:al_custcode and customer.custcode =accounts.acccode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
		this.id_master.object.address[ll_currow] = ls_address
		this.id_master.object.aliasname[ll_currow] = ls_aliasname
		this.id_master.object.city[ll_currow] = ls_city
		this.id_master.object.phone[ll_currow] = ls_phone
		if isnull(li_messagecode) then
			this.id_master.object.messagecode[ll_currow] = 1
		else
			this.id_master.object.messagecode[ll_currow] = li_messagecode
		end if
	end if
	return this.it_transobject.sqlcode

// w_sale_modified.wf_retrievelistall() returns long
	string[] ls_posted
	string ls_showrows
	integer[] li_salecategory
	long ll_counter
	datetime ld_invdate
	ld_invdate = datetime(date("12/12/1998"), time("00:00:00"))
	ls_showrows = "Y"
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		li_salecategory[1] = 1
		li_salecategory[2] = 2
	else
		li_salecategory[3] = this.ii_saletype
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, ls_showrows, this.il_groupcode, this.ii_module)

// w_sale_modified.wf_retrievelist() returns long
	string[] ls_posted
	string ls_showrows
	integer[] li_salecategory
	integer li_invforlastdays
	integer li_listrows
	datetime ld_invdate
	long ll_counter
	ld_invdate = datetime(relativedate(today(), li_invforlastdays))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		li_salecategory[1] = 1
		li_salecategory[2] = 2
	else
		li_salecategory[3] = this.ii_saletype
	end if
	ls_showrows = "Y"
	this.id_list.object.netamount.visible = true
	this.id_list.object.t_netamount.visible = true
	if ls_showrows = "N" then
		this.tab_retrieve.tabpage_list.cb_retrieve.enabled = false
		this.tab_retrieve.tabpage_list.em_invno.enabled = false
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, ls_showrows, this.il_groupcode, this.ii_module)

// w_sale_modified.wf_setitemdataoncustlatestsale() returns integer
	integer li_rowsaffected
	long ll_counter
	long ll_custcode
	long ll_icode
	double ld_saleprice
	double ld_discperc
	double ld_itemflatdisc
	string ls_bonusqty
	string ls_discperc
	string ls_itemflatdisc
	double ld_looseqty
	double ld_prevbonusqty
	double ld_desiredbonus
	double ld_prevsaleqty
	ls_bonusqty = this.id_detail.object.bonusqty.visible
	ls_discperc = this.id_detail.object.discperc.visible
	ls_itemflatdisc = this.id_detail.object.itemflatdisc.visible
	ll_custcode = this.id_master.getitemnumber(1, "custcode")
	for ll_counter = 1 to this.id_detail.rowcount()
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		ld_looseqty = this.id_detail.getitemnumber(ll_counter, "looseqty")
		li_rowsaffected = 0
		this.it_transobject.getcustwiselatestitemsale(ll_custcode, ll_icode, ld_saleprice, ld_prevsaleqty, ld_prevbonusqty, ld_discperc, ld_itemflatdisc, li_rowsaffected)
		if this.it_transobject.sqlcode = 0 then
			if li_rowsaffected > 0 then
				if f_stringpreferences("UpdSPriceUsingCustLatestSale") = "Y" then
					this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice)
				end if
				if ls_bonusqty = "1" and f_stringpreferences("UpdBonusQtyUsingCustLatestSale") = "Y" then
					if ld_prevsaleqty <> 0.0 then
						ld_desiredbonus = ld_looseqty / ld_prevsaleqty * ld_prevbonusqty
						this.id_detail.setitem(ll_counter, "bonusqty", ld_desiredbonus)
					end if
				end if
				if ls_discperc = "1" and f_stringpreferences("UpdDiscPercUsingCustLatestSale") = "Y" then
					this.id_detail.setitem(ll_counter, "discperc", ld_discperc)
				end if
				if ls_itemflatdisc = "1" and f_stringpreferences("UpdFlatDiscUsingCustLatestSale") = "Y" then
					this.id_detail.setitem(ll_counter, "itemflatdisc", ld_itemflatdisc)
				end if
			end if
		else
			return -1
		end if
	next
	return 1

// w_sale_modified.wf_inititeminfo(long al_icode, long al_row, integer ai_rtcode, string as_errortext) returns boolean
	boolean retflag
	double ld_rpp
	double ld_purprice
	double ld_flatdisc
	double ld_invdiscperc
	double ld_discperc2
	double ld_discperc3
	double ld_discperc4
	double ld_saleprice
	double ld_discperc
	double ld_purdiscperc
	double ld_avgprice
	double ld_unitsalestax
	double ld_gstperc1
	double ld_gstperc2
	double ld_packsalestax
	double ld_saleprice4
	double ld_saleprice5
	double ld_discperc5
	double ld_retailprice
	long ll_packunits
	long ll_saleinvcode
	long ld_saleprice2
	long ld_saleprice3
	long li_discstatus
	long ll_qtysale
	long ll_bonus
	integer li_gcode
	integer li_defaultgcode
	integer li_defaultgst
	integer li_custcode
	integer li_flatdiscstatus
	integer li_itemdiscpercno
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_antinorcotix
	string ls_itemtotalval
	string ls_locksaleprice
	string ls_lockdiscperc
	double ld_godownstock
	double ld_saleqty
	double ld_totalstock
	double ld_reorderqty
	setnull(ls_null)
	SQL SELECT item.customicode , item.name , item.saleprice , item.packunits , item.salediscperc , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.avgprice , item.PurDiscPerc , item.antinorcotix , item.reorderqty , item.purprice , item.recentpurprice , round ( item.Packsalestax / item.packunits , 2 ) , item.gstperc1 , item.gstperc2 , qtysale =item.saleqty , bonus =item.bonusqty , item.Packsalestax , item.flatdisc , item.locksaleprice , item.lockdiscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 , item.retailprice INTO :ls_fullcode, :ls_name, :ld_saleprice, :ll_packunits, :ld_discperc, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :ld_avgprice, :ld_purdiscperc, :ls_antinorcotix, :ld_reorderqty, :ld_purprice, :ld_rpp, :ld_unitsalestax, :ld_gstperc1, :ld_gstperc2, :ll_qtysale, :ll_bonus, :ld_packsalestax, :ld_flatdisc, :ls_locksaleprice, :ls_lockdiscperc, :ld_discperc2, :ld_discperc3, :ld_discperc4, :ld_discperc5, :ld_retailprice FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
	li_custcode = this.id_master.getitemnumber(1, "custcode")
	if isnull(li_custcode) then
		retflag = false
		as_errortext = "Validation Error: Select Customer "
	end if
	li_defaultgst = this.id_master.getitemnumber(1, "dd_gstperc")
	SQL SELECT InvDiscPerc INTO :ld_invdiscperc FROM customer WHERE customer.custcode =:li_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
	else
		if this.il_strategy = 2 then
			li_gcode = wf_getitemassociategcode(al_icode)
		end if
		if this.il_strategy = 1 then
			li_gcode = this.id_detail.getitemnumber(al_row, "gcode")
		end if
	end if
	this.it_transobject.getitemstockall(al_icode, ld_totalstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.ib_modify and retflag then
		ll_saleinvcode = this.id_master.getitemnumber(1, "code")
		ld_godownstock = ld_godownstock + ld_saleqty
	end if
	if retflag then
		this.id_detail.setitem(al_row, "gcode", li_gcode)
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		li_discstatus = long(this.id_detail.object.discperc.visible)
		li_flatdiscstatus = long(this.id_detail.object.itemflatdisc.visible)
		if li_discstatus = 1 and this.id_detail.getitemstatus(al_row, "discperc", primary!) = notmodified! then
			li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
			if long(this.id_detail.object.discperc.visible) = 1 then
				choose case li_itemdiscpercno
				case 1
					this.id_detail.setitem(al_row, "discperc", ld_discperc)
				case 2
					this.id_detail.setitem(al_row, "discperc", ld_discperc2)
				case 3
					this.id_detail.setitem(al_row, "discperc", ld_discperc3)
				case 4
					this.id_detail.setitem(al_row, "discperc", ld_discperc4)
				case 5
					this.id_detail.setitem(al_row, "discperc", ld_discperc5)
				end choose
			else
				this.id_detail.setitem(al_row, "discperc", 0)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") and li_discstatus = 1 then
			li_itemdiscpercno = this.id_master.getitemnumber(1, "itemdiscpercno")
			choose case li_itemdiscpercno
			case 1
				this.id_detail.setitem(al_row, "discperc", ld_discperc)
			case 2
				this.id_detail.setitem(al_row, "discperc", ld_discperc2)
			case 3
				this.id_detail.setitem(al_row, "discperc", ld_discperc3)
			case 4
				this.id_detail.setitem(al_row, "discperc", ld_discperc4)
			case 5
				this.id_detail.setitem(al_row, "discperc", ld_discperc5)
			end choose
		end if
		if this.id_detail.getitemstatus(al_row, "saleprice", primary!) = notmodified! then
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
			case 2.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				this.id_detail.setitem(al_row, "packprice", ld_purprice)
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				this.id_detail.setitem(al_row, "packprice", ld_rpp)
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
			case else
				this.id_detail.setitem(al_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
			end choose
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			choose case this.id_master.getitemnumber(this.id_master.getrow(), "sprice")
			case 1.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
			case 2.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice2)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice2 / ll_packunits)
			case 3.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice3)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice3 / ll_packunits)
			case 7.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice4)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice4 / ll_packunits)
			case 8.0
				this.id_detail.setitem(al_row, "packprice", ld_saleprice5)
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice5 / ll_packunits)
			case 4.0
				this.id_detail.setitem(al_row, "packprice", ld_purprice)
				this.id_detail.setitem(al_row, "saleprice", ld_purprice / ll_packunits)
			case 5.0
				this.id_detail.setitem(al_row, "packprice", ld_rpp)
				this.id_detail.setitem(al_row, "saleprice", ld_rpp / ll_packunits)
			case else
				this.id_detail.setitem(al_row, "packprice", ld_avgprice * ll_packunits)
				this.id_detail.setitem(al_row, "saleprice", ld_avgprice)
			end choose
		end if
		this.id_detail.setitem(al_row, "icode", al_icode)
		this.id_detail.setitem(al_row, "packunits", ll_packunits)
		this.id_detail.setitem(al_row, "rate", ld_saleprice / ll_packunits)
		this.id_detail.setitem(al_row, "stock", ld_godownstock)
		this.id_detail.setitem(al_row, "totalstock", ld_totalstock)
		this.id_detail.setitem(al_row, "retailprice", ld_retailprice / ll_packunits)
		if li_flatdiscstatus = 1 then
			if this.id_detail.getitemstatus(al_row, "itemflatdisc", primary!) = notmodified! then
				this.id_detail.setitem(al_row, "itemflatdisc", ld_flatdisc)
			end if
		else
			this.id_detail.setitem(al_row, "itemflatdisc", 0)
		end if
		this.id_detail.setitem(al_row, "recentpurprice", ld_rpp)
		this.id_detail.setitem(al_row, "purprice", ld_purprice)
		this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
		this.id_detail.setitem(al_row, "itemtotalval", ls_itemtotalval)
		if f_stringpreferences("bonusinsale") = "Y" then
			this.id_detail.setitem(al_row, "qtysale", ll_qtysale)
			this.id_detail.setitem(al_row, "bonus", ll_bonus)
		end if
		if this.id_detail.getitemstatus(al_row, "Unitsalestax", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
		end if
		if this.id_detail.getitemstatus(al_row, "gstperc", primary!) = notmodified! then
			if li_defaultgst = 2 then
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
			end if
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
			if li_defaultgst = 2 then
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc2)
			else
				this.id_detail.setitem(al_row, "gstperc", ld_gstperc1)
			end if
		end if
		this.id_detail.setitem(al_row, "locksaleprice", ls_locksaleprice)
		this.id_detail.setitem(al_row, "lockdiscperc", ls_lockdiscperc)
	end if
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_totalstock)
	this.id_footer.setitem(1, "retailprice", ld_retailprice / ll_packunits)
	this.id_footer.setitem(1, "rpp", ld_rpp)
	this.id_footer.setitem(1, "purprice", ld_purprice)
	this.id_footer.setitem(1, "avgprice", ld_avgprice)
	this.id_footer.setitem(1, "itemtotalval", ls_itemtotalval)
	if this.id_footer.getitemstatus(1, "invdiscperc", primary!) = notmodified! and this.ib_modify = false then
		this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
	end if
	if f_stringpreferences("bonusinsale") = "Y" then
		this.id_footer.setitem(1, "bonusratio", trim(string(ll_qtysale)) + ":" + trim(string(ll_bonus)))
	end if
	this.id_footer.object.t_purdiscper.text = string(ld_purdiscperc)
	this.id_detail.setitem(al_row, "itemcode", al_icode)
	if ls_antinorcotix = "Y" and retflag = true and not (this.il_norcotixcode = al_icode) then
		messagebox("Item Validation", "This is Narcotics item ~r~n please type Doctor name in remarks")
		this.il_norcotixcode = al_icode
	end if
	return retflag

// w_sale_modified.wf_setcustomerinfo(long row, integer i, string data) returns integer
	long ll_code
	long ll_custcode
	long ll_counter
	long ll_icode
	long ll_customerbalance
	long ll_lastinvcode
	double ld_custgst
	double ld_gstperc1
	double ld_gstperc2
	double ld_itemdiscperc
	double ld_itemdiscperc2
	double ld_itemdiscperc3
	double ld_itemdiscperc4
	double ld_saleprice1
	double ld_saleprice2
	double ld_saleprice3
	double ld_invdiscperc
	double ld_saleprice4
	double ld_saleprice5
	double ld_itemdiscperc5
	integer li_salepriceno
	integer li_itemdiscpercno
	integer li_packunits
	integer li_smancode
	if not isnull(data) then
		ll_code = long(data)
		this.il_custcode = ll_code
		setredraw(false)
		if wf_customerinfo(ll_code) <> 0 then
			messagebox("Database Error", "Customer information can not be retrieved")
			setredraw(true)
			return 1
		end if
		setredraw(true)
	elseif data = "0" and this.ii_saletype = 2 then
		messagebox("Database Error", "Customer information can not be retrieved")
		return 1
	end if
	if this.id_master.accepttext() = -1 then
		return 1
	end if
	setredraw(false)
	ll_custcode = this.id_master.getitemnumber(row, "custcode")
	if this.id_detail.getrow() > 0 and isnull(this.id_detail.getitemnumber(this.id_detail.getrow(), "itemcode")) then
		event ue_deleteitem()
	end if
	SQL SELECT customer.defaultgst , customer.defaultsaleprice , customer.defaultitemdiscperc INTO :ld_custgst, :li_salepriceno, :li_itemdiscpercno FROM customer WHERE customer.custcode =:ll_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		messagebox("Database Error", "Customer information can not be retrieved")
		return 1
	end if
	if not (this.it_transobject.sqlcode = 100) then
		if ld_custgst = 2.0 then
			this.id_master.setitem(1, "dd_gstperc", 2)
		else
			this.id_master.setitem(1, "dd_gstperc", 1)
		end if
	end if
	this.id_master.setitem(1, "itemdiscpercno", li_itemdiscpercno)
	this.id_master.setitem(1, "sprice", li_salepriceno)
	for ll_counter = 1 to this.id_detail.rowcount()
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		if not isnull(ll_icode) then
			SQL SELECT item.gstperc1 , item.gstperc2 , item.salediscperc , item.salediscperc2 , item.salediscperc3 , item.salediscperc4 , item.salediscperc5 , item.saleprice , item.saleprice2 , item.saleprice3 , item.saleprice4 , item.saleprice5 , item.packunits INTO :ld_gstperc1, :ld_gstperc2, :ld_itemdiscperc, :ld_itemdiscperc2, :ld_itemdiscperc3, :ld_itemdiscperc4, :ld_itemdiscperc5, :ld_saleprice1, :ld_saleprice2, :ld_saleprice3, :ld_saleprice4, :ld_saleprice5, :li_packunits FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = -1 then
				messagebox("Database Error", "Item information can not be retrieved")
				return 1
			end if
			if not (this.it_transobject.sqlcode = 100) then
				if ld_custgst = 2.0 then
					this.id_detail.setitem(ll_counter, "gstperc", ld_gstperc2)
				else
					this.id_detail.setitem(ll_counter, "gstperc", ld_gstperc1)
				end if
			end if
			choose case li_salepriceno
			case 1
				this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice1 / li_packunits)
				this.id_detail.setitem(ll_counter, "packprice", ld_saleprice1)
			case 2
				this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice2 / li_packunits)
				this.id_detail.setitem(ll_counter, "packprice", ld_saleprice2)
			case 3
				this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice3 / li_packunits)
				this.id_detail.setitem(ll_counter, "packprice", ld_saleprice3)
			case 7
				this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice4 / li_packunits)
				this.id_detail.setitem(ll_counter, "packprice", ld_saleprice4)
			case 8
				this.id_detail.setitem(ll_counter, "saleprice", ld_saleprice5 / li_packunits)
				this.id_detail.setitem(ll_counter, "packprice", ld_saleprice5)
			end choose
			if long(this.id_detail.object.discperc.visible) = 1 then
				choose case li_itemdiscpercno
				case 1
					this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc)
				case 2
					this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc2)
				case 3
					this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc3)
				case 4
					this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc4)
				case 5
					this.id_detail.setitem(ll_counter, "discperc", ld_itemdiscperc5)
				end choose
			else
				this.id_detail.setitem(ll_counter, "discperc", 0)
			end if
		end if
	next
	SQL Select invdiscperc , salesmancode INTO :ld_invdiscperc, :li_smancode From Customer Where custcode =:ll_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_footer.setitem(1, "invdiscperc", ld_invdiscperc)
	end if
	if f_stringpreferences("SalesManInSale") = "Y" then
		this.id_master.setitem(1, "smancode", li_smancode)
	end if
	if this.ii_saletype = 2 and f_stringpreferences("InSaleCustomerBalance") = "Y" then
		for ll_counter = 1 to this.ids_customersbalance.rowcount()
			if this.ids_customersbalance.getitemnumber(ll_counter, "code1") = this.id_master.getitemnumber(row, "custcode") then
				this.ii_focuscustomer = 3
				ll_customerbalance = this.ids_customersbalance.getitemnumber(ll_counter, "value1")
				this.id_master.setitem(row, "customerbalance", ll_customerbalance)
				if ll_customerbalance > 0 then
					this.id_master.setitem(row, "debitorcredit", "Dr")
				else
					this.id_master.setitem(row, "debitorcredit", "Cr")
				end if
				exit
			else
				this.ii_focuscustomer = 3
				this.id_master.setitem(row, "debitorcredit", "Cr")
				this.id_master.setitem(row, "customerbalance", 0)
			end if
		next
	end if
	if this.id_detail.rowcount() <= 0 then
		event ue_newitem()
		this.id_master.setfocus()
	end if
	setredraw(true)
	return 0

// w_sale_modified.wf_populatesaledetail(long al_invid, datawindow ad_saledetail, string as_errortext, long al_errorrow) returns boolean
	long ll_detailrows
	long ll_gcode
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode
	long li_counter
	long li_innercounter
	long ll_insertedrows
	long ll_itemsdetailrowcount
	long ll_row
	long ll_remainingdays
	double ld_stock
	double ld_newstock
	double ld_salelooseqty
	double ld_dueqty
	double ld_looseqty
	double ld_bonusqty
	double ld_totalstock
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	double ld_rate
	double ld_itemflatdisc
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_packprice
	double ld_gstperc
	double ld_unitsalestax
	integer li_rtmesscode
	boolean lb_commitflag
	string ls_batch
	string ls_updatesaleprice
	string ls_updsaleprice
	string ls_saleitemdescription
	string ls_claimable
	datetime ld_expiry
	dwitemstatus ldws_column
	return lb_commitflag

// w_sale_modified.wf_copyinvoice() returns integer
	datastore lds_saleheader
	datastore lds_saledetail
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrows
	integer li_retcode
	integer li_errcode
	integer li_counter
	integer ll_found
	integer ll_innercounter
	string ls_itemname
	string ls_aliasname
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	boolean lb_bonus
	double ld_looseqty
	double ld_holdqty
	double ld_holdbonusqty
	if this.tab_retrieve.selectedtab <> 1 then
		return -1
	end if
	lds_saleheader = create datastore
	lds_saledetail = create datastore
	lds_saleheader.dataobject = "d_wholesaleHeader"
	lds_saledetail.dataobject = "d_saledetail"
	lds_saleheader.settransobject(sqlca)
	lds_saledetail.settransobject(sqlca)
	open(w_copysaleinvformodifiedsale)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		destroy lds_saledetail
		return -1
	end if
	lds_saleheader.retrieve(lstr_template.l_invtemplate)
	lds_saledetail.retrieve(lstr_template.l_invtemplate)
	for li_counter = 1 to li_counter
		this.id_master.deleterow(0)
	next
	for li_counter = 1 to li_counter
		this.id_footer.deleterow(0)
	next
	for li_counter = 1 to li_counter
		event ue_deleteitem()
	next
	this.id_master.reset()
	this.id_detail.reset()
	this.id_footer.reset()
	ll_totalrows = lds_saleheader.rowcount()
	for ll_rowcount = 1 to ll_totalrows
		this.id_master.insertrow(0)
		this.id_master.object.code[ll_rowcount] = lds_saleheader.object.code[ll_rowcount]
		this.id_master.object.salecatcode[ll_rowcount] = lds_saleheader.object.salecatcode[ll_rowcount]
		this.id_master.object.date[ll_rowcount] = lds_saleheader.object.date[ll_rowcount]
		this.id_master.object.custrefno[ll_rowcount] = lds_saleheader.object.custrefno[ll_rowcount]
		this.id_master.object.remarks[ll_rowcount] = lds_saleheader.object.remarks[ll_rowcount]
		this.id_master.object.custcode[ll_rowcount] = lds_saleheader.object.custcode[ll_rowcount]
		this.id_master.object.salesmancode[ll_rowcount] = lds_saleheader.object.salesmancode[ll_rowcount]
		this.id_master.object.headerno[ll_rowcount] = lds_saleheader.object.headerno[ll_rowcount]
		this.id_master.object.discperc[ll_rowcount] = lds_saleheader.object.discperc[ll_rowcount]
		this.id_master.object.itemdiscpercno[ll_rowcount] = lds_saleheader.object.itemdiscpercno[ll_rowcount]
		this.id_master.object.flatdisc[ll_rowcount] = lds_saleheader.object.flatdisc[ll_rowcount]
		this.id_master.object.misccharges[ll_rowcount] = lds_saleheader.object.misccharges[ll_rowcount]
		this.id_master.object.salestax[ll_rowcount] = lds_saleheader.object.salestax[ll_rowcount]
		this.id_master.object.posted[ll_rowcount] = lds_saleheader.object.posted[ll_rowcount]
		this.id_master.object.postdate[ll_rowcount] = lds_saleheader.object.postdate[ll_rowcount]
		this.id_master.object.headerinvno[ll_rowcount] = lds_saleheader.object.headerinvno[ll_rowcount]
		this.id_master.object.originaldate[ll_rowcount] = lds_saleheader.object.originaldate[ll_rowcount]
		this.id_master.object.modifiedby[ll_rowcount] = lds_saleheader.object.modifiedby[ll_rowcount]
		this.id_master.object.sprice[ll_rowcount] = lds_saleheader.object.sprice[ll_rowcount]
		this.id_master.object.quotationno[ll_rowcount] = lds_saleheader.object.quotationno[ll_rowcount]
		this.id_master.object.postedby[ll_rowcount] = lds_saleheader.object.postedby[ll_rowcount]
		this.id_master.object.doctcode[ll_rowcount] = lds_saleheader.object.doctcode[ll_rowcount]
		this.id_master.object.patientcode[ll_rowcount] = lds_saleheader.object.patientcode[ll_rowcount]
		this.id_master.object.cashreceived[ll_rowcount] = lds_saleheader.object.cashreceived[ll_rowcount]
		this.id_master.object.invgstperc1[ll_rowcount] = lds_saleheader.object.invgstperc1[ll_rowcount]
		this.id_master.object.printwaranty[ll_rowcount] = lds_saleheader.object.printwaranty[ll_rowcount]
		this.id_master.object.printbatch[ll_rowcount] = lds_saleheader.object.printbatch[ll_rowcount]
		this.id_master.object.messagecode[ll_rowcount] = lds_saleheader.object.messagecode[ll_rowcount]
		this.id_master.object.smancode[ll_rowcount] = lds_saleheader.object.smancode[ll_rowcount]
		this.id_master.object.custrefno2[ll_rowcount] = lds_saleheader.object.custrefno2[ll_rowcount]
		this.id_master.object.custrefno3[ll_rowcount] = lds_saleheader.object.custrefno3[ll_rowcount]
		this.id_master.object.custrefno4[ll_rowcount] = lds_saleheader.object.custrefno4[ll_rowcount]
		this.id_master.object.invoicesize[ll_rowcount] = lds_saleheader.object.invoicesize[ll_rowcount]
		this.id_master.object.invtotal[ll_rowcount] = lds_saleheader.object.invtotal[ll_rowcount]
		this.id_master.object.machinename[ll_rowcount] = lds_saleheader.object.machinename[ll_rowcount]
		this.id_master.object.modifycounter[ll_rowcount] = lds_saleheader.object.modifycounter[ll_rowcount]
		this.id_master.object.wardcode[ll_rowcount] = lds_saleheader.object.wardcode[ll_rowcount]
		this.id_master.object.diseasecode[ll_rowcount] = lds_saleheader.object.diseasecode[ll_rowcount]
		this.id_master.object.relationcode[ll_rowcount] = lds_saleheader.object.relationcode[ll_rowcount]
		this.id_master.object.admissioncode[ll_rowcount] = lds_saleheader.object.admissioncode[ll_rowcount]
		this.id_master.object.dd_gstperc[ll_rowcount] = lds_saleheader.object.dd_gstperc[ll_rowcount]
	next
	for ll_rowcount = 1 to ll_totalrows
		this.id_footer.insertrow(0)
		this.id_footer.object.code[ll_rowcount] = lds_saleheader.object.code[ll_rowcount]
		this.id_footer.object.flatdisc[ll_rowcount] = lds_saleheader.object.flatdisc[ll_rowcount]
		this.id_footer.object.misccharges[ll_rowcount] = lds_saleheader.object.misccharges[ll_rowcount]
		this.id_footer.object.salestax[ll_rowcount] = lds_saleheader.object.salestax[ll_rowcount]
		this.id_footer.object.invdiscperc[ll_rowcount] = lds_saleheader.object.discperc[ll_rowcount]
		this.id_footer.object.invgstperc1[ll_rowcount] = lds_saleheader.object.invgstperc1[ll_rowcount]
	next
	ll_totalrows = lds_saledetail.rowcount()
	for ll_rowcount = 1 to ll_totalrows
		this.id_detail.insertrow(0)
		this.id_detail.object.code[ll_rowcount] = lds_saledetail.object.code[ll_rowcount]
		this.id_detail.object.icode[ll_rowcount] = lds_saledetail.object.icode[ll_rowcount]
		this.id_detail.object.itemcode[ll_rowcount] = lds_saledetail.object.icode[ll_rowcount]
		ll_icode = lds_saledetail.object.icode[ll_rowcount]
		SQL Select name , customicode INTO :ls_itemname, :ls_aliasname from item where icode =:ll_icode USING sqlca;
		if sqlca.sqlcode <> 0 then
			messagebox("Item Validation", "Unable to fetch item data from database.~r~nKindly populate this invoice again.")
			return -1
		end if
		this.id_detail.object.itemname[ll_rowcount] = ls_itemname
		this.id_detail.object.fullcode[ll_rowcount] = ls_aliasname
		this.id_detail.object.batch[ll_rowcount] = lds_saledetail.object.batch[ll_rowcount]
		this.id_detail.object.expiry[ll_rowcount] = lds_saledetail.object.expiry[ll_rowcount]
		this.id_detail.object.looseqty[ll_rowcount] = lds_saledetail.object.looseqty[ll_rowcount]
		this.id_detail.object.bonusqty[ll_rowcount] = lds_saledetail.object.bonusqty[ll_rowcount]
		this.id_detail.object.packqty[ll_rowcount] = lds_saledetail.object.packqty[ll_rowcount]
		this.id_detail.object.packunits[ll_rowcount] = lds_saledetail.object.packunits[ll_rowcount]
		this.id_detail.object.saleprice[ll_rowcount] = lds_saledetail.object.saleprice[ll_rowcount]
		this.id_detail.object.discperc[ll_rowcount] = lds_saledetail.object.discperc[ll_rowcount]
		this.id_detail.object.rate[ll_rowcount] = lds_saledetail.object.rate[ll_rowcount]
		this.id_detail.object.avgprice[ll_rowcount] = lds_saledetail.object.avgprice[ll_rowcount]
		this.id_detail.object.due[ll_rowcount] = lds_saledetail.object.due[ll_rowcount]
		this.id_detail.object.itemflatdisc[ll_rowcount] = lds_saledetail.object.itemflatdisc[ll_rowcount]
		this.id_detail.object.satisfieddate[ll_rowcount] = lds_saledetail.object.satisfieddate[ll_rowcount]
		this.id_detail.object.packprice[ll_rowcount] = lds_saledetail.object.packprice[ll_rowcount]
		this.id_detail.object.saleitemdescription[ll_rowcount] = lds_saledetail.object.saleitemdescription[ll_rowcount]
		this.id_detail.object.claimable[ll_rowcount] = lds_saledetail.object.claimable[ll_rowcount]
		this.id_detail.object.unitsalestax[ll_rowcount] = lds_saledetail.object.unitsalestax[ll_rowcount]
		this.id_detail.object.gstperc[ll_rowcount] = lds_saledetail.object.gstperc[ll_rowcount]
		this.id_detail.object.balancestock[ll_rowcount] = lds_saledetail.object.balancestock[ll_rowcount]
	next
	wf_grandtotal()
	if this.id_detail.rowcount() > 0 then
		this.im_menu.m_file.m_save.enabled = true
	end if
	destroy lds_saledetail
	return li_retcode

// w_sale_modified.wf_setrowgroup(datawindow adw_detail) returns integer
	long ll_counter
	long ll_rowcount
	long ll_rowgroup
	long ll_prevrowgroup
	ll_rowcount = adw_detail.rowcount()
	ll_rowgroup = adw_detail.getitemnumber(1, "rowgroup")
	if ll_rowgroup = 0 then
		ll_rowgroup = 1
		adw_detail.setitem(1, "rowgroup", ll_rowgroup)
	end if
	ll_prevrowgroup = ll_rowgroup
	for ll_counter = 2 to ll_rowcount
		ll_rowgroup = adw_detail.getitemnumber(ll_counter, "rowgroup")
		if ll_rowgroup = 0 then
			ll_rowgroup = ll_prevrowgroup + 1
			adw_detail.setitem(ll_counter, "rowgroup", ll_rowgroup)
		end if
		ll_prevrowgroup = ll_rowgroup
	next
	return 1

// w_sale_modified.wf_post() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		openwithparm(w_arg_cust_sinvcode_linvcode, this.ii_saletype)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			li_errcode = wf_locksaleinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_saleinvcount)
			if li_errcode = 0 then
				sqlca.postsaleledger(lstr_arginfo.l_code1, lstr_arginfo.l_code2, this.ii_saletype, ll_salesmancode, lstr_arginfo.l_code3, lstr_arginfo.l_code4, "Y")
				if sqlca.sqlcode <> 0 then
					li_errcode = -1
				end if
				if this.ii_type = 2 then
					sqlca.postsaleledger(lstr_arginfo.l_code1, lstr_arginfo.l_code2, 1, ll_salesmancode, lstr_arginfo.l_code3, lstr_arginfo.l_code4, "Y")
					if sqlca.sqlcode <> 0 then
						li_errcode = -1
					end if
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again")
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_saleinvcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return li_errcode

// w_sale_modified.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_sale_modified.wf_viewheader() returns integer
	s_dw_header ls_dw_header
	string[] ls_values
	string ls_posted
	long ll_row
	long ll_currrow
	integer li_protectdw
	datetime ldt_datetime
	if this.tab_retrieve.selectedtab <> 1 then
		return -1
	end if
	ls_posted = this.id_master.getitemstring(this.id_master.getrow(), "Posted")
	ls_dw_header.dw_header = this.id_master
	if this.ii_saletype = 2 then
		ls_dw_header.s_saletype = "Credit"
	else
		ls_dw_header.s_saletype = "Cash"
	end if
	ls_dw_header.l_code2 = this.ii_salemodule
	if this.editflag = false and ls_posted = "Y" then
		ls_dw_header.i_protectdw = 1
	else
		ls_dw_header.i_protectdw = 0
	end if
	openwithparm(w_view_saleheader, ls_dw_header)
	ls_dw_header = message.powerobjectparm
	if ls_dw_header.i_closemode = -1 then
		return -1
	end if
	ll_row = this.id_master.getrow()
	ls_values = ls_dw_header.values
	if this.editflag = true then
		this.id_master.setitem(ll_row, "patientregno", ls_values[1])
		this.id_master.setitem(ll_row, "patientcode", long(ls_values[2]))
		this.id_master.setitem(ll_row, "doctcode", long(ls_values[3]))
		this.id_master.setitem(ll_row, "relationcode", long(ls_values[4]))
		this.id_master.setitem(ll_row, "wardcode", long(ls_values[5]))
		this.id_master.setitem(ll_row, "diseasecode", long(ls_values[6]))
		this.id_master.setitem(ll_row, "printwaranty", ls_values[7])
		this.id_master.setitem(ll_row, "printbatch", ls_values[8])
		this.id_master.setitem(ll_row, "invoicesize", ls_values[9])
		this.id_master.setitem(ll_row, "smancode", long(ls_values[10]))
		if this.ii_saletype = 2 then
			this.id_master.setitem(ll_row, "custrefno2", ls_values[11])
			this.id_master.setitem(ll_row, "custrefno3", ls_values[12])
			this.id_master.setitem(ll_row, "custrefno4", ls_values[13])
			this.id_master.setitem(ll_row, "custrefno5", ls_values[23])
		end if
		this.id_master.setitem(ll_row, "printbalance", ls_values[14])
		this.id_master.setitem(ll_row, "deliveredby", long(ls_values[15]))
		this.id_master.setitem(ll_row, "billingdate", datetime(date(ls_values[16]), time(ls_values[17])))
		this.id_master.setitem(ll_row, "pptcustcode", long(ls_values[18]))
		this.id_master.setitem(ll_row, "saletypecode", long(ls_values[19]))
		this.id_master.setitem(ll_row, "recurringinvoice", ls_values[20])
		this.id_master.setitem(ll_row, "recurringperiod", long(ls_values[21]))
		if this.ii_saletype = 2 then
			this.id_master.setitem(ll_row, "duedate", date(ls_values[22]))
		end if
		this.id_master.setitem(ll_row, "custsitecode", long(ls_values[24]))
		this.id_master.setitem(ll_row, "PreviousReading", long(ls_values[25]))
		this.id_master.setitem(ll_row, "CurrentReading", long(ls_values[26]))
		this.id_master.setitem(ll_row, "NextChange", long(ls_values[27]))
	end if
	return 1

// w_sale_modified.wf_patient_retrieve() returns long
	long ll_prow
	long ll_pcode
	this.idc_patient.retrieve()
	ll_prow = this.idc_patient.insertrow(0)
	setnull(ll_pcode)
	this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
	this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
	this.idc_patient.setitem(ll_prow, "name", "<NONE>")
	this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
	this.idc_patient.setitem(ll_prow, "city", "<NONE>")
	this.idc_patient.scrolltorow(ll_prow)
	return 0

// w_sale_modified.wf_new_patientregistration() returns long
	string ls_regno
	long ll_patientcode
	long ll_found
	long ll_row
	dwobject dwo
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 581", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		open(w_patientregistration)
		ls_regno = message.stringparm
		if not (ls_regno = "" or isnull(ls_regno)) then
			wf_patient_retrieve()
			ll_found = 0
			ll_found = this.idc_patient.find("regno = '" + ls_regno + "'", 1, this.idc_patient.rowcount())
			if ll_found > 0 then
				this.id_master.setitem(1, "patientregno", this.idc_patient.getitemstring(ll_found, "regno"))
				ll_patientcode = this.idc_patient.getitemnumber(ll_found, "patientcode")
				this.id_master.setitem(1, "patientcode", ll_patientcode)
				dwo = this.id_master.object.patientcode
				this.id_master.post event itemchanged(1, dwo, string(ll_patientcode))
			end if
		end if
	end if
	return 0

// w_sale_modified.wf_initmodify(integer ai_protect) returns 0
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_counter
	long ll_count
	double ld_saleprice
	double ld_packsalestax
	double ld_avgprice
	double ld_recentpurprice
	double ld_purprice
	string ls_itemtotalval
	double ld_looseqty
	double ld_bonusqty
	double ld_stock
	double ld_purdiscperc
	long ll_disc_icode
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_saleinvcode = this.id_detail.getitemnumber(1, "code")
		if wf_locksaleinvoice(ll_saleinvcode) = 0 then
			this.id_master.retrieve(ll_saleinvcode)
			this.id_detail.retrieve(ll_saleinvcode)
			this.ids_invoiceinfo.retrieve(ll_saleinvcode)
			for ll_count = 1 to this.id_detail.rowcount()
				ll_icode = this.id_detail.getitemnumber(ll_count, "icode")
				ll_gcode = this.id_detail.getitemnumber(ll_count, "gcode")
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				if this.it_transobject.sqlcode <> 0 then
					ai_protect = 0
				end if
				ld_looseqty = 0
				ld_bonusqty = 0
				for ll_counter = 1 to this.ids_invoiceinfo.rowcount()
					if ll_icode = this.ids_invoiceinfo.getitemnumber(ll_counter, "icode") then
						if isnull(this.ids_invoiceinfo.getitemstring(ll_counter, "due")) then
							ld_looseqty = ld_looseqty + this.ids_invoiceinfo.getitemnumber(ll_counter, "looseqty")
							ld_bonusqty = ld_bonusqty + this.ids_invoiceinfo.getitemnumber(ll_counter, "bonusqty")
						end if
						this.id_detail.setitem(ll_count, "stock", ld_stock + ld_looseqty + ld_bonusqty)
						SQL SELECT item.saleprice , item.packsalestax , item.purprice , item.avgprice , item.recentpurprice INTO :ld_saleprice, :ld_packsalestax, :ld_purprice, :ld_avgprice, :ld_recentpurprice FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
						if this.it_transobject.sqlcode = 0 then
							ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
							this.id_detail.setitem(ll_count, "itemtotalval", ls_itemtotalval)
							this.id_detail.setitem(ll_count, "recentpurprice", ld_recentpurprice)
							this.id_detail.setitem(ll_count, "purprice", ld_purprice)
							this.id_detail.setitem(ll_count, "avgprice", ld_avgprice)
						end if
					end if
				next
			next
			if ai_protect = 0 then
				this.ib_modify = true
				this.id_footer.setitem(1, "stock", this.id_detail.getitemnumber(1, "stock"))
				if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
					ll_disc_icode = this.id_detail.getitemnumber(1, "icode")
					SQL Select item.purdiscperc INTO :ld_purdiscperc From Item Where item.icode =:ll_disc_icode USING this.it_transobject;
					this.id_footer.object.t_purdiscper.text = string(ld_purdiscperc)
				end if
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
			return
		end if
		messagebox("Cannot Modify", "Sale invoice is already in use")
	end if

// w_sale_modified.wf_locksaleinvoices(long al_sinvcode, long al_linvcode, long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From saleledgerModified WITH ( UPDLOCK HOLDLOCK ) Where saleledgerModified.saleinvcode Between :al_sinvcode AND :al_linvcode AND saleledgerModified.Posted ='N' USING sqlca;
	return sqlca.sqlcode

// w_sale_modified.wf_allowinvoice(long al_custcode, long al_lastinvcode) returns long
	long ll_retcode
	long ll_code
	if this.ib_modify then
		ll_code = this.id_master.getitemnumber(this.id_master.rowcount(), "code")
		SQL SELECT COUNT ( CustCode ) , max ( SaleInvCode ) INTO :ll_retcode, :al_lastinvcode FROM SaleLedger WHERE CustCode =:al_custcode and SaleInvCode <> :ll_code and Posted ='N' USING sqlca;
	else
		SQL SELECT COUNT ( CustCode ) , max ( SaleInvCode ) INTO :ll_retcode, :al_lastinvcode FROM SaleLedger WHERE CustCode =:al_custcode and Posted ='N' USING sqlca;
	end if
	return ll_retcode

// w_sale_modified.wf_locksaleinvoice(long al_saleinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From saleledgermodified WITH ( UPDLOCK HOLDLOCK ) Where saleledgermodified.saleinvcode =:al_saleinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_sale_modified.wf_isinvoiceinuse(long al_invoiceno) returns boolean
	long ll_found
	SQL Select count ( *) INTO :ll_found From SaleLedgerModified With ( ReadPast , RowLock , UpdLock ) Where SaleInvCode =:al_invoiceno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_found = 0 then
			return true
		else
			return false
		end if
		return
	end if
	return false

// w_sale_modified.wf_getsalesstockinfo(long al_saleinvcode, long al_gcode, long al_icode, double al_saleqty) returns integer
	SQL Select IsNull ( Sum ( saledetail.looseqty + saledetail.bonusqty ) , 0 ) INTO :al_saleqty from saledetail where saledetail.saleinvcode =:al_saleinvcode and saledetail.gcode =:al_gcode and saledetail.icode =:al_icode USING this.it_transobject;
	if isnull(al_saleqty) then
		al_saleqty = 0
	end if
	return this.it_transobject.sqlcode

// w_sale_modified.wf_selectitembatches(long al_gcode, long al_icode, double al_qty, double al_bonus, datawindow ad_itemsdetail, long al_rowscount, string al_errortext) returns integer
	datastore lds_itemstockinfo
	long ll_counter
	long ll_detailrowcount
	integer li_errcode
	double ld_saleqty
	double ld_reqqty
	double ld_totalstock
	double ld_batchqty
	double ld_bonusqty
	lds_itemstockinfo = create datastore
	lds_itemstockinfo.dataobject = "d_itemstockinfo"
	lds_itemstockinfo.settransobject(this.it_transobject)
	if lds_itemstockinfo.retrieve(al_gcode, al_icode) > 0 then
		ld_totalstock = lds_itemstockinfo.getitemnumber(1, "c_totalstock")
		if ld_totalstock >= al_qty + al_bonus then
			ld_reqqty = al_qty + al_bonus
			ll_detailrowcount = ad_itemsdetail.rowcount()
			ll_counter = 1
			do while ll_counter <= lds_itemstockinfo.rowcount() and ld_reqqty > 0.0
				ld_batchqty = lds_itemstockinfo.getitemnumber(ll_counter, "currqty")
				if ld_batchqty >= ld_reqqty then
					ld_saleqty = al_qty
					ld_bonusqty = al_bonus
				elseif ld_batchqty <= al_qty then
					ld_saleqty = ld_batchqty
					ld_bonusqty = 0
				else
					ld_saleqty = al_qty
					ld_bonusqty = ld_batchqty - al_qty
				end if
				al_qty = al_qty - ld_saleqty
				al_bonus = al_bonus - ld_bonusqty
				ld_reqqty = al_qty + al_bonus
				ad_itemsdetail.insertrow(0)
				ll_detailrowcount = ll_detailrowcount + 1
				ad_itemsdetail.setitem(ll_detailrowcount, "gcode", al_gcode)
				ad_itemsdetail.setitem(ll_detailrowcount, "icode", al_icode)
				ad_itemsdetail.setitem(ll_detailrowcount, "batch", lds_itemstockinfo.getitemstring(ll_counter, "batch"))
				ad_itemsdetail.setitem(ll_detailrowcount, "expiry", lds_itemstockinfo.getitemdatetime(ll_counter, "expiry"))
				ad_itemsdetail.setitem(ll_detailrowcount, "stock", ld_batchqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "totalstock", ld_totalstock)
				ad_itemsdetail.setitem(ll_detailrowcount, "looseqty", ld_saleqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "bonusqty", ld_bonusqty)
				ll_counter = ll_counter + 1
			loop
			al_rowscount = ll_counter - 1
		else
			li_errcode = 1
			al_rowscount = ld_totalstock
			al_errortext = "Stock has been decreased for this item   "
		end if
	else
		li_errcode = 1
		al_rowscount = ld_totalstock
		al_errortext = "Stock does not exist for this item   "
	end if
	destroy lds_itemstockinfo
	return li_errcode

// w_sale_modified.wf_selectprintreport(string as_pagesize) returns string
	string ls_report
	if as_pagesize = "Q" and this.ib_printout then
		if gs_company = "HAMMASPHARMA" then
			ls_report = "d_hammaspharma_copied_saleinvreportwh"
		else
			ls_report = "d_retailsalemodifiedinvreportwh"
		end if
	elseif as_pagesize = "Q" and this.ib_printout = false then
		if gs_company = "HAMMASPHARMA" then
			ls_report = "d_hammaspharma_copied_saleinvreportwh"
		else
