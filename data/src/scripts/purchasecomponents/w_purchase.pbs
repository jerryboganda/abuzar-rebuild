// w_purchase.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	show()
	return ::message.returnvalue

// w_purchase.closequery() returns long [event]
	integer li_yesno
	integer li_rtcode
	if this.editflag = true then
		li_yesno = messagebox("Invoice", "Do You want to save changes", question!, yesnocancel!, 2)
		if li_yesno = 1 then
			triggerevent("ue_save")
			if wf_commitform() = false then
				li_rtcode = 1
			end if
		elseif li_yesno = 2 then
			SQL rollback USING this.it_transobject;
			li_rtcode = 0
		elseif li_yesno = 3 then
			li_rtcode = 1
		end if
	end if
	return li_rtcode

// w_purchase.ue_callback_popupwindow(any ar_object) returns 0 [event]
	long ll_icode
	long ll_row
	string as_errortext
	super::ue_callback_popupwindow(ar_object)
	ll_icode = long(ar_object)
	ll_row = this.id_detail.getrow()
	if ll_row > 0 and ll_icode > 0 and wf_inititeminfo(ll_icode, ll_row, as_errortext) = false then
		messagebox("Item Error", as_errortext)
	end if

// w_purchase.ue_settitle() returns 0 [event]
	datawindowchild ldc_headerno
	long ll_counter
	long ll_retcode
	string ls_title
	call super::ue_settitle
	ll_retcode = this.id_master.getchild("headerno", ldc_headerno)
	if ll_retcode = 1 then
		for ll_counter = 1 to ldc_headerno.rowcount()
			if isnull(trim(ldc_headerno.getitemstring(ll_counter, "headeralias"))) then
				ls_title = ls_title + ""
			else
				ls_title = ls_title + "," + trim(ldc_headerno.getitemstring(ll_counter, "headeralias"))
			end if
		next
	else
		ls_title = ""
	end if
	this.title = this.title + "(" + ls_title + ")"

// dw_footer.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "advancetaxamt"
		if double(data) < 0.0 then
			messagebox("Advance Income Tax Validation", "Advance Income Tax can not be -ve")
			return 1
		else
			parent.parent.parent.ib_advancetax_edited = true
			return 0
		end if
	case "total"
		if double(data) < 0.0 then
			messagebox("Grand Total Validation", "Grand Total can not be -ve")
			return 1
		elseif this.object.total[row] > double(data) then
			this.object.flatdisc[row] = this.object.flatdisc[row] + (this.object.total[row] - double(data))
		else
			this.object.misccharges[row] = this.object.misccharges[row] + (double(data) - this.object.total[row])
		end if
		parent.parent.parent.wf_grandtotal()
	end choose
	return ll_retcode

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
		return 1
	case "faltdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
		return 1
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
		return 1
	end choose
	return ::message.returnvalue

// dw_footer.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if (getcolumnname() = "misccharges" or getcolumnname() = "flatdisc" or getcolumnname() = "discperc") and key = keyf5! then
		parent.parent.parent.wf_set_misccharges()
		rt_code = 1
	end if
	if (getcolumnname() = "misccharges" or getcolumnname() = "flatdisc" or getcolumnname() = "discperc") and key = keyf7! then
		parent.parent.parent.wf_show_misccharges_breakup()
		rt_code = 1
	end if
	return rt_code

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_result
	integer li_null
	long ll_code
	long ll_manfcode
	long ll_detailrows
	long ll_icatcodecounter
	double ld_price
	double ld_rate
	string ls_null
	date ld_null
	dwitemstatus lrs_status
	integer li_res
	integer li_suppcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(li_null)
	choose case dwo.name
	case "taxcategorycode"
		return parent.parent.parent.wf_set_taxcategory(long(data))
	case "creditdays"
		if long(data) < 0 then
			messagebox("Supplier Credit Days Validaion!", "Negative Supplier Credit Days is not acceptable here~r~nPlease Enter Valid Supplier Credit Days.")
			return 1
		else
			accepttext()
		end if
	case "suppinvdate"
		if date(data) > today() then
			messagebox("Supplier Invoice Date Validaion!", "Forward Date is not acceptable here~r~nPlease Enter Valid Date")
			return 1
		end if
	case "icatcode"
		setnull(ll_icatcodecounter)
		setitem(row, "monthlycounter", ll_icatcodecounter)
		setitem(row, "dailycounter", ll_icatcodecounter)
	case "suppcode"
		ll_code = long(data)
		parent.parent.parent.wf_setsuppinfo(ll_code, this)
	case "currencycode"
		ll_code = long(data)
		parent.parent.parent.wf_setcurrency(ll_code)
	case "conversionfactor"
		ld_rate = double(data)
		if ld_rate <= 0.0 then
			return 1
		elseif parent.parent.parent.wf_applycurrency(double(data)) <= 0 then
			return 1
		end if
	case "aliasname"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findsuppcode(data, li_suppcode)
			if li_res > 0 then
				setitem(row, "suppcode", li_suppcode)
				if parent.parent.parent.wf_check_groupsuppliercategory() <> 0 then
					messagebox("Group Wise Supplier Category Validation", "Current user group does not have enough permissions w.r.t supplier.~r~nPossible Reasons are:~r~nSupllier is not allowed to the current user group.")
					setitem(row, "suppcode", li_null)
					return 1
				end if
				parent.parent.parent.wf_setsuppinfo(li_suppcode, this)
				return 0
			else
				messagebox("Supplier Validation", "Supplier with  AliasName " + data + " does not exist")
				return 1
			end if
			return
		end if
	case "pocode"
		if not isnull(data) and integer(data) <> 0 then
			ll_detailrows = parent.dw_itemsdetail.rowcount()
			if ll_detailrows > 0 then
				lrs_status = parent.dw_itemsdetail.getitemstatus(1, 0, primary!)
				ll_code = long(data)
				ll_manfcode = parent.parent.parent.wf_setpurorderinfo(ll_code, 1)
				parent.parent.parent.im_menu.m_file.m_options.enabled = true
				this.object.suppcode.protect = 1
			end if
		end if
		parent.parent.parent.wf_filter_po_itemsonly(long(data))
	end choose
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "suppcode"
		messagebox("Supplier Name Validation", "You must select some supplier")
		return 1
	case "currencycode"
		messagebox("Currency Validation", "You must select some valid currency")
		return 1
	case "conversionfactor"
		messagebox("Conversion Factor/Rate Validation", "You must select some valid Conversion Factor/Rate")
		return 1
	end choose
	return ::message.returnvalue

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if string(dwo.name) = "suppcode" then
		parent.parent.parent.id_master.selecttext(1, 40)
	end if
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	s_arguements lstr_arg
	long ll_counter
	integer[] la_suppcatcode
	string ls_suppcats
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	try
		if key = keyenter! and getcolumnname() = "suppcode" then
			parent.parent.parent.id_master.setitem(1, "suppcode", parent.parent.parent.idc_supplierlist.getitemnumber(parent.parent.parent.idc_supplierlist.getrow(), "supplier_suppcode"))
			parent.parent.parent.wf_setsuppinfo(parent.parent.parent.idc_supplierlist.getitemnumber(parent.parent.parent.idc_supplierlist.getrow(), "supplier_suppcode"), this)
		elseif key = keyf5! and getcolumnname() = "suppcode" then
			open(w_choose_suppliercategory)
			lstr_arg = message.powerobjectparm
			if lstr_arg.i_status = 1 then
				la_suppcatcode = lstr_arg.ia_integerlist
				ls_suppcats = ""
				for ll_counter = 1 to upperbound(la_suppcatcode)
					ls_suppcats = ls_suppcats + string(la_suppcatcode[ll_counter]) + " , "
				next
				ls_suppcats = ls_suppcats + " 0"
				parent.parent.parent.idc_supplierlist.setfilter("suppcatcode In (" + ls_suppcats + ")")
				parent.parent.parent.idc_supplierlist.filter()
			end if
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
		setnull(ll_counter)
		parent.parent.parent.id_master.setitem(1, "suppcode", ll_counter)
	end try
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_detail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	parent.parent.parent.post wf_setsuppname(data)
	return ::message.returnvalue

// dw_detail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	if dwo.name = "b_recalc" then
		if parent.parent.parent.id_master.object.pocode[1] > 0 then
			parent.parent.parent.wf_filter_po_itemsonly(parent.parent.parent.id_master.object.pocode[1])
		end if
		parent.parent.parent.wf_grandtotal_with_update_netrate()
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	integer li_packunits
	integer li_retmsgcode
	integer li_option = 2
	long ll_null
	long ll_currentrow
	long ll_icode
	long ll_itemcodetype
	double ld_newqty
	double ld_storedqty
	double ld_stock
	double ld_bonusqty
	double ld_packqty
	double ld_looseqty
	double ld_grossamt
	double ld_defaultqty = 1.0
	double ld_itemvalue
	double ld_packcapacity
	double ld_areavolume
	double ld_purprice
	string ls_null
	string ls_itemname
	datetime ldt_expiry
	date ld_expiry
	time lt_expiry
	string ls_error
	double ld_conversionfactor
	double ld_saleprice
	double ld_newprice
	datawindowchild ldc_items
	dwitemstatus lrs_status
	double ld_godownstock
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	ll_currentrow = getrow()
	lrs_status = getitemstatus(ll_currentrow, 0, primary!)
	setnull(ll_null)
	setnull(ls_null)
	parent.parent.parent.ib_advancetax_edited = false
	choose case dwo.name
	case "quicksearch"
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		if isnull(data) or data = "" then
			return 0
		else
			return parent.parent.parent.wf_searchitem_quicksearch(data)
		end if
	case parent.parent.parent.is_columnitemname
		if parent.parent.parent.id_itemslist.rowcount() > 0 then
			parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
			parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
			parent.parent.parent.id_detail.setitem(row, "alternatecustomicode", ls_null)
		end if
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		li_errcode = 0
	case "icode"
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	case "batch"
		parent.parent.parent.wf_set_batch_expiry_lockstatus(parent.parent.parent.id_detail.object.gcode[row], parent.parent.parent.id_detail.object.icode[row], data, parent.parent.parent.id_detail.object.expiry[row])
	case "bonusqty"
		ld_bonusqty = double(data)
		ld_packqty = getitemnumber(row, "packqty")
		ld_looseqty = getitemnumber(row, "looseqty")
	case "packqty"
		ld_packqty = double(data)
		ld_bonusqty = getitemnumber(row, "bonusqty")
		ld_areavolume = parent.parent.parent.id_detail.object.areavolume[row]
		if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
			ld_areavolume = 1
		end if
		ld_packcapacity = parent.parent.parent.id_detail.object.packcapacity[row]
		if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
			ld_packcapacity = 1
		end if
		parent.parent.parent.id_detail.setitem(row, "pcs", round(double(data) / ld_areavolume, 6))
		parent.parent.parent.id_detail.setitem(row, "cartons", trim(string(long(parent.parent.parent.id_detail.object.pcs[row] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(parent.parent.parent.id_detail.object.pcs[row] mod ld_packcapacity, 2))))))
		parent.parent.parent.wf_update_value_extax(row, double(data), this.object.purprice[row], this.object.discperc[row])
	case "looseqty"
		ld_looseqty = double(data)
		ld_bonusqty = getitemnumber(row, "bonusqty")
		ld_areavolume = parent.parent.parent.id_detail.object.areavolume[row]
		if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
			ld_areavolume = 1
		end if
		ld_packcapacity = parent.parent.parent.id_detail.object.packcapacity[row]
		if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
			ld_packcapacity = 1
		end if
		parent.parent.parent.id_detail.setitem(row, "pcs", round(double(data) / ld_areavolume, 6))
		parent.parent.parent.id_detail.setitem(row, "cartons", trim(string(long(parent.parent.parent.id_detail.object.pcs[row] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(parent.parent.parent.id_detail.object.pcs[row] mod ld_packcapacity, 2))))))
		parent.parent.parent.wf_update_value_extax(row, double(data), this.object.purprice[row], this.object.discperc[row])
	case "gcode"
		accepttext()
		parent.parent.parent.it_transobject.getitemstocktotal(getitemnumber(row, "gcode"), getitemnumber(row, "icode"), ld_godownstock)
		parent.parent.parent.id_footer.setitem(1, "stock", ld_godownstock)
		parent.parent.parent.wf_set_batch_expiry_lockstatus(long(data), parent.parent.parent.id_detail.object.icode[row], parent.parent.parent.id_detail.object.batch[row], parent.parent.parent.id_detail.object.expiry[row])
	case "pcs"
		return parent.parent.parent.wf_validate_pcs(row, data)
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname, ll_itemcodetype, parent.parent.parent.idbl_packqty, parent.parent.parent.idbl_purprice, parent.parent.parent.idbl_saleprice)
			if li_res > 0 then
				if parent.parent.parent.idbl_packqty = 0.0 then
					parent.parent.parent.idbl_packqty = 1
				end if
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				if ll_itemcodetype = 2 then
					setitem(row, "alternatecustomicode", data)
					setitem(row, "packunits", long(parent.parent.parent.idbl_packqty))
					if parent.parent.parent.ii_purchasetype = 1 then
						setitem(row, "purprice", parent.parent.parent.idbl_purprice)
						setitem(row, "saleprice", parent.parent.parent.idbl_saleprice)
						if parent.parent.parent.ii_purchasetype = 1 then
							setitem(row, "salepriceforitem", parent.parent.parent.idbl_saleprice)
						end if
					else
						setitem(row, "purprice", parent.parent.parent.idbl_purprice / parent.parent.parent.idbl_packqty)
						setitem(row, "saleprice", parent.parent.parent.idbl_saleprice)
						if parent.parent.parent.ii_purchasetype = 1 then
							setitem(row, "salepriceforitem", parent.parent.parent.idbl_saleprice)
						end if
					end if
				else
					setitem(row, "alternatecustomicode", ls_null)
				end if
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
				parent.parent.parent.wf_set_batch_expiry_lockstatus(parent.parent.parent.id_detail.object.gcode[row], ll_icode, parent.parent.parent.id_detail.object.batch[row], parent.parent.parent.id_detail.object.expiry[row])
			else
				messagebox("ItemNumber Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_errcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_errcode = 2
		end if
	case "extrataxperc"
		if double(data) < 0.0 or isnull(data) or double(data) > 100.0 then
			messagebox("Extra Tax %age Validation", "Extra Tax %age must be a valid value [Range 0-100]")
			return 1
		else
			ld_itemvalue = getitemnumber(row, "c_total")
			ld_newqty = this.object.packqty[row] + this.object.bonusqty[row]
			if ld_newqty <= 0.0 or isnull(ld_newqty) then
				ld_newqty = 1
			end if
			if isnull(ld_itemvalue) or ld_itemvalue <= 0.0 then
				ld_itemvalue = 0.00
			end if
			this.object.unitsalestax[row] = round(ld_itemvalue * double(data) * 0.01 / ld_newqty, 2)
			return 0
		end if
	case "prediscprice"
		if double(data) > 0.0 then
			this.object.purprice[row] = double(data) - this.object.itemflatdisc[row]
			li_errcode = 0
		else
			li_errcode = 1
		end if
		if li_errcode = 0 then
			parent.parent.parent.wf_update_value_extax(row, this.object.looseqty[row] + this.object.packqty[row], double(data) - this.object.itemflatdisc[row], this.object.discperc[row])
		end if
	case "salepriceforitem"
		if double(data) < 0.0 then
			messagebox("Sale Price Validation", "Please enter valid sale price", stopsign!)
			return 1
		else
			if parent.parent.parent.ic_copysalepriceinretailprice = "Y" then
				setitem(row, "retailprice", double(data))
			end if
			return 0
		end if
	case "purprice"
		ll_icode = parent.parent.parent.id_detail.getitemnumber(row, "icode")
		parent.parent.parent.ib_jump_to_saleprice = false
		SQL Select item.saleprice , item.packunits , item.purprice INTO :ld_saleprice, :li_packunits, :ld_purprice From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
		if li_packunits = 0 or isnull(li_packunits) then
			li_packunits = 1
		end if
		choose case parent.parent.parent.ii_purchasetype
		case 1
			if double(data) > ld_saleprice then
				li_retmsgcode = messagebox("Purchase Validation", "Purchase Price " + data + " is greater than Sale Price~r~n Do you want to continue", question!, yesno!)
				if li_retmsgcode = 1 then
					li_errcode = 0
				else
					li_errcode = 1
				end if
			end if
		case 7
			ld_purprice = ld_purprice / li_packunits
			if double(data) > ld_saleprice / li_packunits then
				li_retmsgcode = messagebox("Purchase Validation", "Purchase Price " + data + " is greater than Sale Price~r~n Do you want to continue", question!, yesno!)
				if li_retmsgcode = 1 then
					li_errcode = 0
				else
					li_errcode = 1
				end if
			end if
		end choose
		if li_errcode = 0 then
			this.object.prediscprice[row] = double(data) + this.object.itemflatdisc[row]
			parent.parent.parent.wf_update_value_extax(row, this.object.looseqty[row] + this.object.packqty[row], double(data), this.object.discperc[row])
		end if
		if li_errcode = 0 and parent.parent.parent.ib_prompt_saleprice_change_on_purprice_mod and double(data) <> ld_purprice then
			li_option = messagebox("Change Sale Price Alert", "Purchase Price Changed.~r~nDo You want to change sale price?", question!, yesno!, 2)
			li_errcode = 0
			if li_option = 1 then
				parent.parent.parent.ib_jump_to_saleprice = true
			end if
		end if
	case "foreignprice"
		if double(data) >= 0.0 then
			ll_icode = parent.parent.parent.id_detail.getitemnumber(row, "icode")
			ld_conversionfactor = parent.parent.parent.id_master.getitemnumber(parent.parent.parent.id_master.getrow(), "conversionfactor")
			SQL Select item.saleprice , item.packunits INTO :ld_saleprice, :li_packunits From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			choose case parent.parent.parent.ii_purchasetype
			case 1
				ld_newprice = round(double(data) * ld_conversionfactor, 2)
				if ld_newprice > ld_saleprice then
					li_retmsgcode = messagebox("Purchase Validation", "Purchase Price " + string(double(ld_newprice)) + " is greater than Sale Price~r~n Do you want to continue", question!, yesno!)
					if li_retmsgcode = 1 then
						li_errcode = 0
					else
						li_errcode = 1
					end if
				end if
				if li_errcode = 0 then
					this.object.purprice[row] = ld_newprice
					this.object.prediscprice[row] = ld_newprice + this.object.itemflatdisc[row]
					parent.parent.parent.wf_grandtotal()
				end if
			case else
				ld_newprice = round(double(data) * ld_conversionfactor, 2)
				if ld_newprice > ld_saleprice / li_packunits then
					li_retmsgcode = messagebox("Purchase Validation", "Purchase Price " + string(double(ld_newprice)) + " is greater than Sale Price~r~n Do you want to continue", question!, yesno!)
					if li_retmsgcode = 1 then
						li_errcode = 0
					else
						li_errcode = 1
					end if
				end if
				if li_errcode = 0 then
					this.object.purprice[row] = ld_newprice
					this.object.prediscprice[row] = ld_newprice + this.object.itemflatdisc[row]
					parent.parent.parent.wf_grandtotal()
				end if
			end choose
		else
			li_errcode = 1
		end if
		if li_errcode = 0 then
			parent.parent.parent.wf_update_value_extax(row, this.object.looseqty[row] + this.object.packqty[row], this.object.purprice[row], this.object.discperc[row])
		end if
	case "itemflatdisc"
		if double(data) >= 0.0 then
			this.object.purprice[row] = this.object.prediscprice[row] - double(data)
			li_errcode = 0
		else
			li_errcode = 1
		end if
		if li_errcode = 0 then
			parent.parent.parent.wf_update_value_extax(row, this.object.looseqty[row] + this.object.packqty[row], this.object.prediscprice[row] - double(data), this.object.discperc[row])
		end if
	case "discperc"
		if double(data) >= 0.0 and double(data) <= 100.0 then
			li_errcode = 0
		else
			li_errcode = 1
		end if
		if li_errcode = 0 then
			parent.parent.parent.wf_update_value_extax(row, this.object.looseqty[row] + this.object.packqty[row], this.object.purprice[row], double(data))
		end if
	case "valueextax"
		if double(data) >= 0.0 then
			ld_grossamt = (this.object.looseqty[row] + this.object.packqty[row]) * this.object.purprice[row]
			if ld_grossamt >= double(data) then
				this.object.discperc[row] = (ld_grossamt - double(data)) / ld_grossamt * 100.0
			else
				if this.object.looseqty[row] + this.object.packqty[row] > 0 then
					this.object.purprice[row] = double(data) / (this.object.looseqty[row] + this.object.packqty[row])
					this.object.prediscprice[row] = double(data) / (this.object.looseqty[row] + this.object.packqty[row]) + this.object.itemflatdisc[row]
				else
					this.object.purprice[row] = double(data) + this.object.itemflatdisc[row]
				end if
				this.object.discperc[row] = 0
			end if
			li_errcode = 0
		else
			li_errcode = 1
		end if
	case "expiry"
		ld_expiry = date(mid(data, 1, 10))
		lt_expiry = time("00:00:00.000000")
		ldt_expiry = datetime(ld_expiry, lt_expiry)
		if rowcount() > 1 and ldt_expiry <> datetime("00/00/0000, 00:00:00") and not (isnull(this.object.icode[row]) and isnull(this.object.batch[row]) and isnull(this.object.expiry[row])) then
			if vf_dwdupcodebatch(this, "gcode", gl_defaultgcode, "icode", getitemnumber(getrow(), "icode"), "batch", getitemstring(getrow(), "batch"), "expiry", ldt_expiry, parent.parent.parent.il_currrow) = true then
				messagebox("Item Validation", "Duplicate item, please select some other item")
				li_errcode = 1
			else
				parent.parent.parent.wf_set_batch_expiry_lockstatus(this.object.gcode[row], this.object.icode[row], this.object.batch[row], ldt_expiry)
			end if
		end if
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ancestorreturnvalue
	if f_stringpreferences("UpdateSalePriceForItem") = "Y" and parent.parent.parent.ib_jump_to_saleprice and (dwo.name = "bonusqty" or dwo.name = "foreignprice" or dwo.name = "discperc" or dwo.name = "valueextax" or dwo.name = "unitsalestax" or dwo.name = "gstperc" or dwo.name = "extrataxperc") then
		parent.parent.parent.id_detail.setcolumn("salepriceforitem")
		parent.parent.parent.ib_jump_to_saleprice = false
	end if
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "itemname" then
		if len(getitemstring(getrow(), "quicksearch")) > 0 and getitemnumber(getrow(), "icode") > 0.0 then
			if parent.parent.parent.ii_purchasetype = 1 then
				parent.parent.parent.id_detail.setcolumn("packqty")
			else
				parent.parent.parent.id_detail.setcolumn("looseqty")
			end if
			return 0
		else
			parent.parent.parent.ib_focusdetail = true
		end if
	elseif dwo.name = "batchsaleprice" and row > 0 then
		parent.parent.parent.wf_fetchbatchsaleprice(this.object.icode[row], this.object.batch[row], this.object.expiry[row], row)
	end if
	parent.parent.parent.wf_grandtotal()
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	double ld_rpp
	double ld_avgprice
	double ld_rpp2
	double ld_rpp3
	double ld_rpp4
	double ld_rpp5
	dwitemstatus lrs_status
	long ll_icode
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if getcolumnname() <> parent.parent.parent.is_columnitemname then
		if rowcount() > 0 and lrs_status <> new! then
			parent.parent.parent.wf_set_itemimage(getitemnumber(currentrow, "icode"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", getitemnumber(currentrow, "icode"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", getitemnumber(currentrow, "stock"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "piecesinhand", getitemnumber(currentrow, "totalpieces"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", getitemnumber(currentrow, "totalstock"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "itemtotalval", getitemstring(currentrow, "itemtotalval"))
			ll_icode = getitemnumber(getrow(), "icode")
			SQL Select item.recentpurprice , item.avgprice , item.recentpurprice2 , item.recentpurprice3 , item.recentpurprice4 , item.recentpurprice5 INTO :ld_rpp, :ld_avgprice, :ld_rpp2, :ld_rpp3, :ld_rpp4, :ld_rpp5 From Item Where item.icode =:ll_icode USING parent.parent.parent.it_transobject;
			parent.parent.parent.id_footer.object.t_rpp.text = string(ld_rpp) + " , " + string(ld_rpp2) + " , " + string(ld_rpp3) + " , " + string(ld_rpp4) + " , " + string(ld_rpp5)
			parent.parent.parent.id_footer.object.t_avgprice.text = string(ld_avgprice)
		elseif parent.parent.parent.id_footer.getrow() > 0 then
			parent.parent.parent.id_master.object.p_itemimage.filename = ""
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "piecesinhand", 0)
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_colname
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	ls_colname = dwo.name
	if ls_colname = "Qty" or ls_colname = "discperc" or ls_colname = "purprice" then
		parent.parent.parent.wf_grandtotal()
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "fullcode"
		if isnull(data) or data = "" then
			messagebox("Item Code Validation", "Item Code ~"" + data + "~" does not exist")
		end if
		return 1
	case parent.parent.parent.is_columnitemname
		messagebox("Item Validation", "Value required for item in current row")
		return 1
	case "icode"
		messagebox("Item Validation", "Value required for item in current row")
		return 1
	case "bonusqty"
		messagebox("Bonus Qty Validation", "Bonus Qty ~"" + data + "~" should be greater than or equal to zero")
		return 1
	case "discperc"
		messagebox("Item Discount Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
		return 1
	case "purprice"
		return 1
	case "expiry"
		return 1
	end choose
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	long ancestorreturnvalue
	if f_stringpreferences("enablequickprefferedsearch") = "N" and f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanging(long currentrow, long newrow) returns long [event]
	long ancestorreturnvalue
	double ld_packqty
	double ld_looseqty
	double ld_bonusqty
	long ll_icode
	ancestorreturnvalue = super::rowfocuschanging(currentrow, newrow)
	if currentrow > 0 and parent.parent.parent.id_detail.rowcount() > 0 and currentrow <= parent.parent.parent.id_detail.rowcount() then
		ld_packqty = parent.parent.parent.id_detail.getitemnumber(currentrow, "packqty")
		ld_looseqty = parent.parent.parent.id_detail.getitemnumber(currentrow, "looseqty")
		ld_bonusqty = parent.parent.parent.id_detail.getitemnumber(currentrow, "bonusqty")
		ll_icode = parent.parent.parent.id_detail.getitemnumber(currentrow, "icode")
		if ld_packqty + ld_bonusqty + ld_looseqty <= 0.0 and not isnull(ll_icode) then
			messagebox("Purchase Qty Validation", "Please enter valid qty")
			post event ue_focusqty()
			return 1
		end if
		return
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_focusqty() returns 0 [event]
	if parent.parent.parent.ii_purchasetype = 1 then
		parent.parent.parent.id_detail.setcolumn("packqty")
	else
		parent.parent.parent.id_detail.setcolumn("looseqty")
	end if
	parent.parent.parent.id_detail.selecttext(1, 1)
	parent.parent.parent.id_detail.setfocus()

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_icode
	long ll_found
	long ll_rowm
	double ld_valuextax
	s_salepricecalculater ls_salepricecalc
	s_unittaxinputs ls_unittaxinputs
	string ls_null
	s_datastore lstr_ds
	s_popup_selection lstr_selection
	string ls_alternatealias
	string ls_itemname
	long ll_itemcodetype
	long li_res
	double ld_qty
	double ld_purprice
	double ld_saleprice
	s_unittaxinputs ls_unittaxinputs2
	double ld_valuextax2
	setnull(ls_null)
	if keyflags = 2 and key = keyf5! then
		parent.parent.parent.wf_show_itemgallery()
		rt_code = 1
		return rt_code
	end if
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollnextrow()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyuparrow! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollpriorrow()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keypagedown! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollnextpage()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keypageup! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollpriorpage()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyend! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrolltorow(parent.parent.parent.id_itemslist.rowcount())
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyhome! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrolltorow(1)
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf7! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			lstr_ds.s_name1 = gd_popup_itemsinfo.dataobject
			lstr_ds.s_name2 = "name"
			openwithparm(w_popup_responsivesearch_selection, lstr_ds)
			lstr_selection = message.powerobjectparm
			if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(lstr_selection.l_code2), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 and ll_found <= parent.parent.parent.id_itemslist.rowcount() then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf8! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("namesearch", 1)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf9! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("criteriasearch", 1)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf5! then
			ll_found = 0
			ll_found = gds_securitywindow.find("rightcode = 5121", 1, gds_securitywindow.rowcount())
			if ll_found > 0 then
				parent.parent.parent.ib_itemslistopen = false
				parent.parent.parent.id_itemslist.hide()
				setredraw(true)
				parent.parent.parent.wf_open_item_form_popup()
				setfocus()
			end if
		elseif key = keyf4! then
			parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			if parent.parent.parent.id_itemslist.rowcount() > 0 then
				setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
				setitem(ll_rowm, "alternatecustomicode", ls_null)
			end if
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		elseif rt_code = 2 then
			ll_rowm = getrow()
			parent.parent.parent.id_itemslist.selectrow(0, false)
			if getrow() > 0 then
				ll_listcurrrow = parent.parent.parent.id_itemslist.find("itemname = '" + this.object.itemname[ll_rowm] + "'", 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_listcurrrow > 0 and ll_listcurrrow <= parent.parent.parent.id_itemslist.rowcount() then
					parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
					if parent.parent.parent.id_itemslist.rowcount() > 0 then
						setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
						setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
						setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
					end if
					selecttext(1, len(gettext()))
					parent.parent.parent.ib_itemvalidated = true
					parent.parent.parent.il_currrow = ll_rowm
					setitem(ll_rowm, "CurrListRow", ll_listcurrrow)
					setredraw(true)
				end if
				rt_code = 0
			end if
		end if
	elseif key = keydownarrow! then
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_focusfooter")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			if parent.parent.parent.ii_purchasetype = 1 or parent.parent.parent.ii_purchasetype = 7 then
				parent.parent.parent.id_master.setcolumn("aliasname")
			end if
			rt_code = 1
		end if
	end if
	if getcolumnname() = "fullcode" and key = keyf6! then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
		setredraw(true)
		lstr_ds.s_name1 = gd_popup_itemsinfo.dataobject
		lstr_ds.s_name2 = "customicode"
		if getrow() > 0 then
			lstr_ds.d_value = this.object.icode[getrow()]
		end if
		openwithparm(w_popup_responsivesearch_alternatealias, lstr_ds)
		lstr_selection = message.powerobjectparm
		if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
			ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(lstr_selection.l_code2), 1, parent.parent.parent.id_itemslist.rowcount())
			if ll_found > 0 and ll_found <= parent.parent.parent.id_itemslist.rowcount() then
				ls_alternatealias = lstr_selection.s_name
				li_res = parent.parent.parent.wf_findfullcode(ls_alternatealias, ll_icode, ls_itemname, ll_itemcodetype, parent.parent.parent.idbl_packqty, parent.parent.parent.idbl_purprice, parent.parent.parent.idbl_saleprice)
				if li_res > 0 then
					if parent.parent.parent.idbl_packqty = 0.0 then
						parent.parent.parent.idbl_packqty = 1
					end if
					setitem(getrow(), "icode", ll_icode)
					setitem(getrow(), "itemname", ls_itemname)
					if ll_itemcodetype = 2 then
						setitem(getrow(), "alternatecustomicode", ls_alternatealias)
						setitem(getrow(), "packunits", long(parent.parent.parent.idbl_packqty))
						if parent.parent.parent.ii_purchasetype = 1 then
							setitem(getrow(), "purprice", parent.parent.parent.idbl_purprice)
							setitem(getrow(), "saleprice", parent.parent.parent.idbl_saleprice)
							if parent.parent.parent.ii_purchasetype = 1 then
								setitem(getrow(), "salepriceforitem", parent.parent.parent.idbl_saleprice)
							end if
						else
							setitem(getrow(), "purprice", parent.parent.parent.idbl_purprice / parent.parent.parent.idbl_packqty)
							setitem(getrow(), "saleprice", parent.parent.parent.idbl_saleprice)
							if parent.parent.parent.ii_purchasetype = 1 then
								setitem(getrow(), "salepriceforitem", parent.parent.parent.idbl_saleprice)
							end if
						end if
					end if
					parent.parent.parent.ib_itemvalidated = false
					parent.parent.parent.il_currrow = getrow()
				end if
				ll_listcurrrow = ll_found
				parent.parent.parent.id_itemslist.selectrow(0, false)
				rt_code = 1
			end if
		end if
		setfocus()
	end if
	if getcolumnname() = "fullcode" and key = keyf7! then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
		setredraw(true)
		lstr_ds.s_name1 = gd_popup_itemsinfo.dataobject
		lstr_ds.s_name2 = "aliasname"
		openwithparm(w_popup_responsivesearch_selection, lstr_ds)
		lstr_selection = message.powerobjectparm
		if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
			ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(lstr_selection.l_code2), 1, parent.parent.parent.id_itemslist.rowcount())
			if ll_found > 0 and ll_found <= parent.parent.parent.id_itemslist.rowcount() then
				ll_listcurrrow = ll_found
				parent.parent.parent.id_itemslist.selectrow(0, false)
				rt_code = 1
			end if
		end if
		setfocus()
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			ll_rowm = getrow()
			if ll_rowm > 0 then
				setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
				setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				selecttext(1, len(gettext()))
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = ll_rowm
			end if
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	end if
	if getcolumnname() = "fullcode" and key = keyf8! then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
		setredraw(true)
		ll_icode = f_drilldown_itemsearch("aliasnamesearch", parent.parent.parent.ii_module)
		if ll_icode > 0 then
			ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
			if ll_found > 0 then
				ll_listcurrrow = ll_found
				parent.parent.parent.id_itemslist.selectrow(0, false)
				rt_code = 1
			end if
		end if
		setfocus()
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			ll_rowm = getrow()
			if ll_rowm > 0 then
				setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
				setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				selecttext(1, len(gettext()))
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = ll_rowm
			end if
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	end if
	if getcolumnname() = "unitsalestax" and key = keyf5! then
		accepttext()
		if not isnull(this.object.icode[parent.parent.parent.id_detail.getrow()]) then
			ls_unittaxinputs.l_icode = this.object.icode[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs.d_price = this.object.purprice[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs.d_saleprice = this.object.salepriceforitem[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs.d_unittax = this.object.unitsalestax[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs.d_retailprice = this.object.retailprice[parent.parent.parent.id_detail.getrow()]
			openwithparm(w_unittaxcalculator, ls_unittaxinputs)
			ls_unittaxinputs = message.powerobjectparm
			if ls_unittaxinputs.i_status = 1 then
				this.object.unitsalestax[parent.parent.parent.id_detail.getrow()] = ls_unittaxinputs.d_unittax
			end if
			rt_code = 1
		end if
	elseif getcolumnname() = "unitsalestax" and key = keyf6! then
		accepttext()
		if not isnull(this.object.icode[parent.parent.parent.id_detail.getrow()]) then
			ls_unittaxinputs.l_icode = this.object.icode[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs.d_qty = this.object.packqty[parent.parent.parent.id_detail.getrow()] + this.object.looseqty[parent.parent.parent.id_detail.getrow()] + this.object.bonusqty[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs.d_unittax = this.object.unitsalestax[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs.d_totaltax = this.object.unitsalestax[parent.parent.parent.id_detail.getrow()] * ls_unittaxinputs.d_qty
			openwithparm(w_unittaxcalculator2, ls_unittaxinputs)
			ls_unittaxinputs = message.powerobjectparm
			if ls_unittaxinputs.i_status = 1 then
				this.object.unitsalestax[parent.parent.parent.id_detail.getrow()] = ls_unittaxinputs.d_unittax
			end if
			rt_code = 1
		end if
	end if
	if getcolumnname() = "gstperc" and key = keyf5! then
		accepttext()
		if not isnull(this.object.icode[parent.parent.parent.id_detail.getrow()]) then
			ls_unittaxinputs2.l_icode = this.object.icode[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs2.d_price = this.object.c_total[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs2.d_saleprice = this.object.gstperc[parent.parent.parent.id_detail.getrow()]
			ls_unittaxinputs2.d_unittax = this.object.c_total[parent.parent.parent.id_detail.getrow()] * this.object.gstperc[parent.parent.parent.id_detail.getrow()] * 0.01
			openwithparm(w_gstcalculator, ls_unittaxinputs2)
			ls_unittaxinputs2 = message.powerobjectparm
			if ls_unittaxinputs2.i_status = 1 then
				this.object.gstperc[parent.parent.parent.id_detail.getrow()] = ls_unittaxinputs2.d_saleprice
			end if
			rt_code = 1
		end if
	end if
	if getcolumnname() = "salepriceforitem" and key = keyf5! and not isnull(this.object.icode[parent.parent.parent.id_detail.getrow()]) then
		ls_salepricecalc.l_icode = this.object.icode[parent.parent.parent.id_detail.getrow()]
		ls_salepricecalc.s_name = this.object.itemname[parent.parent.parent.id_detail.getrow()]
		ls_salepricecalc.s_name2 = this.object.fullcode[parent.parent.parent.id_detail.getrow()]
		ls_salepricecalc.d_saleprice = this.object.salepriceforitem[parent.parent.parent.id_detail.getrow()]
		ls_salepricecalc.d_netrate = this.object.netrate[parent.parent.parent.id_detail.getrow()]
		ls_salepricecalc.s_module = "Purchase"
		openwithparm(w_pricecalculator_pur, ls_salepricecalc)
		ls_salepricecalc = message.powerobjectparm
		if ls_salepricecalc.i_status = 1 then
			this.object.salepriceforitem[parent.parent.parent.id_detail.getrow()] = ls_salepricecalc.d_new_saleprice
		end if
		rt_code = 1
	end if
	if (getcolumnname() = "salepriceforitem" or getcolumnname() = "purprice") and key = keyf6! then
		parent.parent.parent.wf_updatealternatealiasprice()
	end if
	return rt_code

// dw_itemsdetail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	return ::message.returnvalue

// dw_find.keypressed(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::keypressed(key, keyflags)
	if keyflags = 2 and key = keyf12! then
		parent.parent.parent.wf_replace_postdate_with_date()
	end if
	return ::message.returnvalue
