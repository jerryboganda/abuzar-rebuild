				this.id_master.object.wexp2_cracccode.initial = trim(string(ll_cracccode))
			else
				this.id_detail.object.we2.visible = false
				this.id_detail.object.c_we2.visible = false
			end if
			ls_col = lds_exp.object.wexp3_caption[1]
			ll_acccode = lds_exp.object.wexp3_acccode[1]
			ll_cracccode = lds_exp.object.wexp3_cracccode[1]
			ll_len = len(ls_col)
			if ll_len > 0 and ll_acccode > 0 then
				this.id_detail.object.we3_t.text = ls_col
				this.id_detail.object.c_we3_t.text = ls_col + " Total"
				this.id_master.object.we3_acccode.initial = trim(string(ll_acccode))
				this.id_master.object.wexp3_cracccode.initial = trim(string(ll_cracccode))
			else
				this.id_detail.object.we3.visible = false
				this.id_detail.object.c_we3.visible = false
			end if
			ls_col = lds_exp.object.wexp4_caption[1]
			ll_acccode = lds_exp.object.wexp4_acccode[1]
			ll_cracccode = lds_exp.object.wexp4_cracccode[1]
			ll_len = len(ls_col)
			if ll_len > 0 and ll_acccode > 0 then
				this.id_detail.object.we4_t.text = ls_col
				this.id_detail.object.c_we4_t.text = ls_col + " Total"
				this.id_master.object.we4_acccode.initial = trim(string(ll_acccode))
				this.id_master.object.wexp4_cracccode.initial = trim(string(ll_cracccode))
			else
				this.id_detail.object.we4.visible = false
				this.id_detail.object.c_we4.visible = false
			end if
			ls_col = lds_exp.object.wexp5_caption[1]
			ll_acccode = lds_exp.object.wexp5_acccode[1]
			ll_cracccode = lds_exp.object.wexp5_cracccode[1]
			ll_len = len(ls_col)
			if ll_len > 0 and ll_acccode > 0 then
				this.id_detail.object.we5_t.text = ls_col
				this.id_detail.object.c_we5_t.text = ls_col + " Total"
				this.id_master.object.we5_acccode.initial = trim(string(ll_acccode))
				this.id_master.object.wexp5_cracccode.initial = trim(string(ll_cracccode))
			else
				this.id_detail.object.we5.visible = false
				this.id_detail.object.c_we5.visible = false
			end if
		end if
	end if
	return 0

// w_purchase.wf_validate_pcs(long row, string data) returns long
	long ll_errcode
	long ll_found
	double ld_storedqty
	double ld_newqty
	double ld_stock
	double ld_desiredbonus
	double ld_areavolume
	double ld_pcs
	double ld_packcapacity
	double ld_tmpqty
	integer li_roundupto
	string ls_null
	setnull(ls_null)
	ld_packcapacity = this.id_detail.object.packcapacity[row]
	if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
		ld_packcapacity = 1
	end if
	ld_areavolume = this.id_detail.object.areavolume[row]
	if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
		ld_areavolume = 1
	end if
	ld_pcs = double(data)
	li_roundupto = f_get_colprecision("Qty")
	ld_tmpqty = round(ld_pcs * ld_areavolume, li_roundupto)
	if ld_pcs > 0.0 then
		if this.ii_purchasetype = 1 then
			this.id_detail.setitem(row, "packqty", ld_tmpqty)
		else
			this.id_detail.setitem(row, "looseqty", ld_tmpqty)
		end if
		this.id_detail.setitem(row, "cartons", trim(string(long(ld_pcs / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(ld_pcs mod ld_packcapacity, 2))))))
	else
		ll_errcode = 1
		messagebox("PCS Validation", "Only possitive PCS are allowed for this item", stopsign!)
	end if
	return ll_errcode

// w_purchase.wf_populate_prinvoice() returns long
	datastore lds_prdetail
	datastore lds_prheader
	s_saletemplate lstr_template
	datawindowchild ldc_godown
	long ll_detailrows
	long ll_count
	long ll_null
	integer li_result
	integer li_retcode
	boolean populateflag = true
	string ls_errortext
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_stock
	long ll_packunits
	double ld_godownstock
	double ld_allgodownstock
	double ld_purqty
	double ld_purbonus
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_salestax
	double ld_gstperc
	string ls_fullcode
	setnull(ll_null)
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate Purchase invoice after posting!")
		return 0
	end if
	open(w_copyprfrom)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		destroy lds_prdetail
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 and not isnull(this.id_detail.object.icode[1]) then
		li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
		if li_result = 1 then
			for ll_count = 1 to ll_detailrows
				this.id_detail.deleterow(0)
			next
			if this.id_detail.update() <> 1 then
				messagebox("DataBase Problem", "Problem in Deleting Rows")
				return 0
			end if
			this.id_detail.reset()
		else
			populateflag = false
		end if
	end if
	if populateflag = true and lstr_template.c_copyinvfrom = "P" then
		lds_prdetail = create datastore
		lds_prheader = create datastore
		lds_prheader.dataobject = "d_openpurchasereturn"
		lds_prdetail.dataobject = "d_openpurchasereturndetail"
		lds_prheader.settransobject(this.it_transobject)
		lds_prdetail.settransobject(this.it_transobject)
		lds_prheader.retrieve(lstr_template.l_invtemplate)
		li_retcode = lds_prdetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, 4, this.il_strategy)
		lds_prdetail.retrieve(lstr_template.l_invtemplate)
		ll_detailrows = lds_prdetail.rowcount()
		if ll_detailrows < 0 then
			li_retcode = -1
		end if
		if this.id_master.rowcount() > 0 and lds_prheader.rowcount() > 0 then
			this.id_master.object.purtypecode[1] = lds_prheader.object.prtypecode[1]
			if this.ii_purchasetype <> 2 then
				this.id_master.object.suppcode[1] = lds_prheader.object.suppcode[1]
			end if
			this.id_master.object.remarks[1] = lds_prheader.object.remarks[1]
			wf_filter_po_itemsonly(ll_null)
			this.id_footer.object.flatdisc[1] = lds_prheader.object.flatdisc[1]
			this.id_footer.object.misccharges[1] = lds_prheader.object.misccharges[1]
			this.id_footer.object.discperc[1] = lds_prheader.object.misccharges[1]
			this.id_footer.object.invgstperc1[1] = lds_prheader.object.invgstperc1[1]
		end if
		this.id_detail.reset()
		for ll_count = 1 to ll_detailrows
			this.id_detail.insertrow(0)
			ll_icode = lds_prdetail.object.icode[ll_count]
			ll_gcode = lds_prdetail.object.gcode[ll_count]
			if wf_inititeminfo(ll_icode, ll_count, ls_errortext) then
				ll_packunits = this.id_detail.object.packunits[ll_count]
				if ll_packunits = 0 or isnull(ll_packunits) then
					ll_packunits = 1
				end if
				if this.ii_purchasetype = 1 then
					ld_purqty = ceiling(lds_prdetail.object.looseqty[ll_count] / ll_packunits)
					ld_purbonus = ceiling(lds_prdetail.object.bonusqty[ll_count] / ll_packunits)
					ld_purprice = lds_prdetail.object.prprice[ll_count] * ll_packunits
					ld_salestax = lds_prdetail.object.unitsalestax[ll_count] * ll_packunits
					this.id_detail.object.packqty[ll_count] = ld_purqty
				else
					ld_purqty = lds_prdetail.object.looseqty[ll_count]
					ld_purbonus = lds_prdetail.object.bonusqty[ll_count]
					ld_purprice = lds_prdetail.object.prprice[ll_count]
					ld_salestax = lds_prdetail.object.unitsalestax[ll_count]
					this.id_detail.object.looseqty[ll_count] = ld_purqty
				end if
				if f_stringpreferences("bonusinpurchase") = "Y" then
					this.id_detail.object.bonusqty[ll_count] = ld_purbonus
				end if
				this.id_detail.object.batch[ll_count] = lds_prdetail.object.batch[ll_count]
				this.id_detail.object.expiry[ll_count] = lds_prdetail.object.expiry[ll_count]
				this.id_detail.object.purprice[ll_count] = ld_purprice
				this.id_detail.object.discperc[ll_count] = lds_prdetail.object.discperc[ll_count]
				this.id_detail.object.unitsalestax[ll_count] = ld_salestax
				this.id_detail.object.gstperc[ll_count] = ld_gstperc
				this.id_detail.setitemstatus(ll_count, "purprice", primary!, notmodified!)
			end if
			wf_update_value_extax(ll_count, this.id_detail.object.looseqty[ll_count] + this.id_detail.object.packqty[ll_count], this.id_detail.object.purprice[ll_count], this.id_detail.object.discperc[ll_count])
		next
		destroy lds_prdetail
	end if
	wf_grandtotal()
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return 1

// w_purchase.wf_replace_postdate_with_date() returns long
	string ls_errtext = "                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ."
	s_arguements lstr_arg
	if f_rightexists(5161) then
		open(w_arg_sinvcode_linvcode)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = 1 then
			SQL update PurLedger SET PostDate =Date WHERE PurInvCode BETWEEN :lstr_arg.l_code1 AND :lstr_arg.l_code2 USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				SQL commit USING this.it_transobject;
			else
				ls_errtext = this.it_transobject.sqlerrtext
				SQL rollback USING this.it_transobject;
				messagebox("Purchase Posting Date Updation Error", "Error in Updating Posting Date for Selected Purchases.~r~nReasons are:-~r~n" + ls_errtext, stopsign!)
			end if
		end if
	end if
	return 0

// w_purchase.wf_populate_saletemplate() returns long
	datastore lds_itemselected
	long ll_detailrows
	long ll_count
	long ll_duplrows
	double ld_godownstock
	double ld_allgodownstock
	integer li_result
	integer li_rtncode
	boolean populateflag = true
	s_arguements lstr_selecteditems
	string ls_itemtotalval
	string ls_errortext
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_packunits
	double ld_stock
	long ll_retrievecount
	long ll_lockedcount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packsalestax
	double ld_gstperc
	string ls_fullcode
	if this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate items after posting!")
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		if not isnull(this.id_detail.object.icode[1]) then
			li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
			if li_result = 1 then
				for ll_count = 1 to ll_detailrows
					this.id_detail.deleterow(0)
				next
				if this.id_detail.update() <> 1 then
					messagebox("DataBase Problem", "Problem in Deleting Rows")
					return 0
				end if
			else
				populateflag = false
			end if
		else
			this.id_detail.reset()
		end if
	end if
	if populateflag = true then
		open(w_arg_saletemplate_single)
		lstr_selecteditems = message.powerobjectparm
		this.id_detail.reset()
		if lstr_selecteditems.l_code1 > 0 then
			lds_itemselected = create datastore
			lds_itemselected.dataobject = "d_saletemplate_analysis_stock"
			lds_itemselected.settransobject(this.it_transobject)
			lds_itemselected.setfilter("stock < qty")
			lds_itemselected.filter()
			this.id_detail.reset()
			ll_rtcode = lds_itemselected.retrieve(lstr_selecteditems.l_code1)
			ll_rowcount = lds_itemselected.rowcount()
			for ll_count = 1 to ll_rowcount
				this.id_detail.insertrow(0)
				ll_icode = lds_itemselected.object.icode[ll_count]
				if wf_inititeminfo(ll_icode, ll_count, ls_errortext) then
					ll_packunits = this.id_detail.object.packunits[ll_count]
					if isnull(ll_packunits) or ll_packunits <= 0 then
						ll_packunits = 1
					end if
					this.id_detail.object.batch[ll_count] = f_stringpreferences("defaultbatch")
					this.id_detail.object.expiry[ll_count] = f_datepreferences("defaultexpiry")
					if this.ii_purchasetype = 1 then
						this.id_detail.object.packqty[ll_count] = ceiling(lds_itemselected.object.qty[ll_count] / ll_packunits)
					else
						this.id_detail.object.looseqty[ll_count] = lds_itemselected.object.qty[ll_count]
					end if
				end if
				wf_update_value_extax(ll_count, this.id_detail.object.looseqty[ll_count] + this.id_detail.object.packqty[ll_count], this.id_detail.object.purprice[ll_count], this.id_detail.object.discperc[ll_count])
				ll_retrievecount = ll_retrievecount + 1
			next
			destroy lds_itemselected
			if ll_retrievecount = ll_rowcount then
				messagebox("Result", string(ll_rowcount) + " Items are populated. ")
			else
				messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " records are retrieved successfully~n~r" + string(ll_duplrows) + " records are duplicate so are not retrieved~n~r" + string(ll_lockedcount) + " records are in error")
			end if
		end if
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_purchase.wf_fetchbatchsaleprice(long al_icode, string as_batch, datetime adt_expiry, long al_row) returns long
	double ld_saleprice
	SQL SELECT ISNULL ( SalePrice , 0 ) INTO :ld_saleprice FROM DBo.ItemBatchPricing WHERE Icode =:al_icode AND Batch =:as_batch AND Expiry =:adt_expiry USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 and ld_saleprice > 0.0 then
		this.id_detail.object.batchsaleprice[al_row] = ld_saleprice
	end if
	return 0

// w_purchase.wf_post_purchase(integer ai_postingmode, long al_startinginvcode, long al_endinginvcode) returns boolean
	long ll_code1
	long ll_code2
	long ll_headerno
	long ll_headerinvno
