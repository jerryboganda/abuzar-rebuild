	long ll_footercurrrow
	long ll_invid
	long ll_icode
	long ll_gcode
	long ll_packingunits
	long ll_salesmancode
	long ll_errrowid
	long ll_packunits
	long ll_totalpieces
	long ll_piecesinhand
	long ll_basepackunits
	long ll_lockreasoncode
	string ls_batch
	string ls_due_message
	string ls_updateavgpricewithnetrate
	string ls_item
	string ls_alternatealiasname
	string ls_location
	string ls_itemname
	datetime ldt_expiry
	datetime ldt_manfdate
	double ld_avgprice
	double ld_newavgprice
	double ld_purprice
	double ld_purdiscpack
	double ld_discperc
	double ld_itempurcost
	double ld_netpurcost
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_debitamt
	double ld_creditamt
	double ld_currbalance
	double ld_recentpurprice
	double ld_purpricepack
	double ld_purpriceloose
	double ld_saleprice
	double ld_itemsalestax
	double ld_itemgstperc
	double ld_totalitemsalestax
	double ld_invgstperc1
	double ld_salepriceforitem
	double ld_discountedsaleprice
	double ld_rate
	double ld_netrate
	double ld_updpurrate
	double ld_advancetax
	integer li_detailcounter
	integer li_purchasecategory
	boolean lb_commitflag = true
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_errortext
	string ls_batchprefix
	string ls_batchreplacement = "N"
	string ls_batchcosting = "N"
	string ls_batch_pretext
	string ls_enforce_prev_margin = "N"
	string ls_lockbatch = "N"
	char lc_pctcode
	char lc_salestaxschedule
	char lc_itemalert
	date ld_expdate
	integer ci_normalpurchase = 1
	integer ci_openingpurchase = 3
	integer ci_loosepurchase = 7
	long ll_rowcount
	long ll_invcounter
	long ll_invcode
	s_arguements lstr_arginfo
	datastore lds_purinvforposting
	datastore lds_purheader
	datastore lds_purdetail
	datastore lds_purexp
	datawindowchild ldc_godown
	datawindow ldw_changeprice_foritemlog
	ls_batchprefix = ""
	lc_pctcode = f_stringpreferences("showpctcodeinpur")
	if isnull(lc_pctcode) then
		lc_pctcode = "N"
	end if
	lc_itemalert = f_stringpreferences("showitemalertinpur")
	if isnull(lc_itemalert) then
		lc_itemalert = "N"
	end if
	lc_salestaxschedule = f_stringpreferences("showsalestaxscheduleinpur")
	if isnull(lc_salestaxschedule) then
		lc_salestaxschedule = "N"
	end if
	if f_stringpreferences("replacebatchwithpurinvonposting") = "Y" then
		ls_batchreplacement = "Y"
	end if
	if f_stringpreferences("MaintainBatchWiseItemCostOnPosting") = "Y" then
		ls_batchcosting = "Y"
	end if
	if f_stringpreferences("enforce_prev_margin_on_pur_posting") = "Y" then
		ls_enforce_prev_margin = "Y"
	end if
	ldw_changeprice_foritemlog = this.dw_changeprice_foritemlog
	ldw_changeprice_foritemlog.settransobject(this.it_transobject)
	lds_purinvforposting = create datastore
	lds_purinvforposting.dataobject = "d_purinvno"
	lds_purinvforposting.settransobject(this.it_transobject)
	lds_purheader = create datastore
	lds_purheader.dataobject = "d_normalpurchaseheader"
	lds_purheader.settransobject(this.it_transobject)
	lds_purdetail = create datastore
	lds_purdetail.dataobject = "d_normalpurchasedetail"
	lds_purdetail.settransobject(this.it_transobject)
	lds_purexp = create datastore
	lds_purexp.dataobject = "d_purchase_expenses"
	lds_purexp.settransobject(this.it_transobject)
	li_rtncode = lds_purdetail.getchild("gcode", ldc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild~r~nPosting Failed")
		return false
	end if
	ldc_godown.settransobject(this.it_transobject)
	li_rtncode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to Post Purchase~r~nPosting Failed")
		return false
	end if
	if ai_postingmode = 1 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	elseif gl_lastusercode > 0 then
		ll_salesmancode = gl_lastusercode
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if ai_postingmode = 1 then
			open(w_arg_sinvcode_linvcode)
			lstr_arginfo = message.powerobjectparm
		else
			lstr_arginfo.l_code1 = al_startinginvcode
			lstr_arginfo.l_code2 = al_endinginvcode
			lstr_arginfo.i_status = 1
		end if
		if ls_enforce_prev_margin = "Y" then
			if wf_report_prev_margin_deviations(lstr_arginfo.l_code1, lstr_arginfo.l_code2) = 0 then
				lstr_arginfo.i_status = 1
			else
				lstr_arginfo.i_status = -1
			end if
		end if
		if lstr_arginfo.i_status = 1 then
			if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return false
			end if
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			SQL Select count ( *) INTO :ul_rowcount From PurDetail , purledger Where purledger.PurInvCode Between :lstr_arginfo.l_code1 AND :lstr_arginfo.l_code2 AND purledger.posted ='N' AND purledger.ImpactInventory ='Y' AND purledger.purinvcode =purdetail.purinvcode USING sqlca;
			sqlca.getmaxutn(ul_rowcount, ul_maxutn)
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
				messagebox("POSTING", "Posting fail due to error in generating Utn")
				return false
			end if
			choose case this.ii_purchasetype
			case 1
				li_errcode = wf_locknormalpurinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
				ll_code1 = lstr_arginfo.l_code1
				ll_code2 = lstr_arginfo.l_code2
				lds_purinvforposting.retrieve(1, 2, lstr_arginfo.l_code1, lstr_arginfo.l_code2)
			case ci_loosepurchase
				li_errcode = wf_lockloosepurinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
				lds_purinvforposting.retrieve(7, 8, lstr_arginfo.l_code1, lstr_arginfo.l_code2)
			case else
				li_errcode = wf_lockopeningpurinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
				lds_purinvforposting.retrieve(3, 0, lstr_arginfo.l_code1, lstr_arginfo.l_code2)
			end choose
			if li_errcode = 0 then
				ll_rowcount = lds_purinvforposting.rowcount()
				for ll_invcounter = 1 to ll_rowcount
					ll_invcode = lds_purinvforposting.object.purinvcode[ll_invcounter]
					if wf_allowpurchasemodification(ll_invcode, this.il_groupcode, this.il_strategy) = 0 then
						lds_purheader.retrieve(ll_invcode)
						lds_purdetail.retrieve(ll_invcode)
						lds_purexp.retrieve(ll_invcode)
						if lds_purexp.rowcount() > 0 then
							ld_purexp = lds_purexp.object.c_totalamt[1]
						end if
						if ld_purexp = 0.0 or isnull(ld_purexp) then
							ld_purexp = 0
						end if
						ll_mastercurrrow = lds_purheader.getrow()
						ll_detailrows = lds_purdetail.rowcount()
						ll_headerno = lds_purheader.getitemnumber(ll_mastercurrrow, "headerno")
						ll_headerinvno = lds_purheader.getitemnumber(ll_mastercurrrow, "headerinvno")
						li_suppcode = lds_purheader.object.suppcode[ll_mastercurrrow]
						if isnull(ll_headerinvno) then
							f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
							if ll_headerinvno > 0 then
								lds_purheader.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
							end if
						end if
						if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
							messagebox("Date Violation", ls_date_errtext, stopsign!)
							return false
						end if
						lds_purheader.object.postdate[ll_mastercurrrow] = ldt_server_datetime
						if this.ii_purchasetype = 1 and f_stringpreferences("UpdateSalePriceForItem") = "Y" then
							ldw_changeprice_foritemlog.retrieve(ll_invcode)
							if f_generateitemlog(ldw_changeprice_foritemlog, "item_changeprice_purchase", this.it_transobject, ldt_server_datetime) <= 0 then
								lb_commitflag = false
								ls_errortext = "Item Log Generation Error:~r~n" + this.it_transobject.sqlerrtext
							end if
						end if
						lds_purheader.object.posted[ll_mastercurrrow] = "Y"
						lds_purheader.object.postedby[ll_mastercurrrow] = ll_salesmancode
						ll_associatedsaleordercode = lds_purheader.object.associatedsaleordercode[ll_mastercurrrow]
						ld_advancetax = lds_purheader.object.advancetaxamt[ll_mastercurrrow]
						ld_misccharges = lds_purheader.object.misccharges[ll_mastercurrrow]
						ld_invdiscperc = lds_purheader.object.discperc[ll_mastercurrrow]
						ld_flatdisc = lds_purheader.object.flatdisc[ll_mastercurrrow]
						ld_salestax = lds_purheader.object.salestax[ll_mastercurrrow]
						ld_invgstperc1 = lds_purheader.object.invgstperc1[ll_mastercurrrow]
						ls_updateavgpricewithnetrate = lds_purheader.object.updateavgpricewithnetrate[ll_mastercurrrow]
						ld_detaildwtotal = lds_purdetail.getitemnumber(1, "d_detaildwtotal")
						ld_invgstpercval = round((round(ld_detaildwtotal * (1.0 - 0.01 * ld_discperc), 2) - ld_flatdisc) * 0.01 * ld_invgstperc1, 2)
						ld_discpercvalue = round(ld_detaildwtotal * ld_invdiscperc * 0.01, 5)
						ld_grandtotal = ld_detaildwtotal * (1.0 - ld_invdiscperc * 0.01) - ld_flatdisc + ld_misccharges
						if ld_advancetax > 0.0 then
							ld_invlevelvalues = ld_purexp - ld_flatdisc - ld_discpercvalue + ld_misccharges - ld_advancetax
						else
							ld_invlevelvalues = ld_purexp + ld_misccharges - ld_flatdisc - ld_discpercvalue
						end if
						if ld_invlevelvalues = 0.0 or isnull(ld_invlevelvalues) then
							ld_invlevelvalues = 0
						end if
						ld_grossvalue = lds_purdetail.object.d_detaildwtotal[1]
						if ld_grossvalue = 0.0 or isnull(ld_grossvalue) then
							ld_grossvalue = 1
						end if
						li_detailcounter = 1
						if ll_detailrows < 1 then
							lb_commitflag = false
						end if
						do while li_detailcounter <= ll_detailrows and lb_commitflag = true
							lds_purdetail.object.purutn[li_detailcounter] = ul_maxutn
							ul_maxutn = ul_maxutn + 1
							ll_icode = lds_purdetail.object.icode[li_detailcounter]
							ls_itemname = lds_purdetail.object.itemname[li_detailcounter]
							ll_gcode = lds_purdetail.object.gcode[li_detailcounter]
							ls_alternatealiasname = lds_purdetail.object.alternatecustomicode[li_detailcounter]
							if ls_batchcosting = "Y" then
								lds_purdetail.object.batch[li_detailcounter] = "P" + trim(string(ll_invcode)) + "*" + lds_purdetail.object.batch[li_detailcounter]
							end if
							if ls_batchreplacement = "Y" then
								lds_purdetail.object.batch[li_detailcounter] = trim(string(ll_invcode))
								ls_batch = lds_purdetail.object.batch[li_detailcounter]
								ldt_expiry = lds_purdetail.object.expiry[li_detailcounter]
								ld_expdate = date(ldt_expiry)
								ld_expdate = relativedate(ld_expdate, li_detailcounter)
								ldt_expiry = datetime(ld_expdate, time("00:00:00"))
								if vf_dsdupcodebatch(lds_purdetail, "gcode", ll_gcode, "icode", ll_icode, "batch", ls_batch, "expiry", ldt_expiry, li_detailcounter) = true then
									ld_expdate = relativedate(ld_expdate, ll_detailrows + li_detailcounter)
									ldt_expiry = datetime(ld_expdate, time("00:00:00"))
								end if
								lds_purdetail.object.expiry[li_detailcounter] = ldt_expiry
							end if
							ls_location = lds_purdetail.object.location[li_detailcounter]
							ls_batch = lds_purdetail.object.batch[li_detailcounter]
							ls_lockbatch = lds_purdetail.object.lockbatch[li_detailcounter]
							ll_lockreasoncode = lds_purdetail.object.lockreasoncode[li_detailcounter]
							ldt_manfdate = lds_purdetail.object.manfdate[li_detailcounter]
							ldt_expiry = lds_purdetail.object.expiry[li_detailcounter]
							ld_packqty = lds_purdetail.object.packqty[li_detailcounter]
							ld_looseqty = lds_purdetail.object.looseqty[li_detailcounter]
							ld_bonusqty = lds_purdetail.object.bonusqty[li_detailcounter]
							ll_packingunits = lds_purdetail.object.packunits[li_detailcounter]
							ld_discperc = lds_purdetail.object.discperc[li_detailcounter]
							ld_netrate = lds_purdetail.object.netrate[li_detailcounter]
							ll_manfcode = lds_purdetail.object.manfcodeforitem[li_detailcounter]
							ll_packunits = lds_purdetail.object.packunits[li_detailcounter]
							ld_margin = lds_purdetail.getitemdecimal(li_detailcounter, "c_margin")
							ll_salestaxschedulecode = lds_purdetail.object.salestaxschedulecode[li_detailcounter]
							ll_pctcode = lds_purdetail.object.pctcode[li_detailcounter]
							ll_itemalertcode = lds_purdetail.object.itemalertcode[li_detailcounter]
							if ll_packunits = 0 or isnull(ll_packunits) then
								ll_packunits = 1
							end if
							if this.ii_purchasetype = 1 then
								ld_itemexpenses = lds_purdetail.object.c_itemexpenses[li_detailcounter]
							end if
							if ld_itemexpenses <= 0.0 or isnull(ld_itemexpenses) then
								ld_itemexpenses = 0
							end if
							if ls_enforce_prev_margin = "Y" and wf_check_right_exists(ll_salesmancode, 5229) < 1 and wf_fetch_previous_margin(ll_icode, ll_prev_invcode, ld_prev_margin) >= 0 and ld_margin < ld_prev_margin then
								ls_errortext = "Deviation in Margin:~r~nItem Name =" + ls_itemname + "~r~nCurrent Margin = " + trim(string(ld_margin, "###,##0.00")) + "~r~nPrevious Margin = " + trim(string(ld_prev_margin, "###,##0.00")) + "~r~nLast Purchase Posted = " + trim(string(ll_prev_invcode)) + "~r~n~r~nPlease Consult your system administrator/purchase manager to do the needfull."
								lb_commitflag = false
								exit
							end if
							ll_totalpieces = lds_purdetail.object.totalpieces[li_detailcounter]
							ld_itemsalestax = lds_purdetail.object.unitsalestax[li_detailcounter]
							ld_itemgstperc = lds_purdetail.object.gstperc[li_detailcounter]
							choose case this.ii_purchasetype
							case 1
								ld_purprice = lds_purdetail.object.purprice[li_detailcounter] / ll_packingunits
								ld_purqty = ld_packqty * ll_packingunits
								ld_purbonusqty = ld_bonusqty * ll_packingunits
								ll_pocode = lds_purheader.object.pocode[ll_mastercurrrow]
								if not isnull(ll_pocode) then
									wf_setpurorderqty(this.it_transobject, ll_pocode, ll_icode, ld_packqty, ld_bonusqty)
								end if
								if f_stringpreferences("UpdateSalePriceForItem") = "Y" then
									ld_salepriceforitem = lds_purdetail.getitemdecimal(li_detailcounter, "salepriceforitem")
									if wf_updateitemsaleprice(this.it_transobject, ll_icode, ls_alternatealiasname, ll_salesmancode, ld_salepriceforitem) <> 0 then
										ls_errortext = "Item SalePrice Updation Error:~r~n" + this.it_transobject.sqlerrtext
										lb_commitflag = false
									end if
								end if
								if f_stringpreferences("ShowRetailPriceInPurchase") = "Y" then
									ld_retailprice = lds_purdetail.getitemdecimal(li_detailcounter, "retailprice")
									if wf_updateitemretailprice(this.it_transobject, ll_icode, ld_retailprice) <> 0 then
										ls_errortext = "Item Retail Price Updation Error:~r~n" + this.it_transobject.sqlerrtext
										lb_commitflag = false
									end if
								end if
								if f_stringpreferences("UpdateSuppItemInfoOnPosting") = "Y" then
									this.it_transobject.update_supplier_item_info(li_suppcode, ll_icode, ld_netrate, ld_discperc, 0, 0, 0)
									if this.it_transobject.sqlcode <> 0 then
										lb_commitflag = false
									end if
								end if
								ld_purpricepack = lds_purdetail.object.purprice[li_detailcounter]
								ld_purdiscpack = lds_purdetail.object.discperc[li_detailcounter]
								ld_flatdiscforitem = lds_purdetail.object.flatdiscforitem[li_detailcounter]
								if f_stringpreferences("UpdatePurPrice") = "Y" then
									ld_updpurrate = ld_purpricepack
								elseif f_stringpreferences("UpdatePurPrice") = "D" then
									ld_updpurrate = round(ld_purpricepack * (1.0 - ld_discperc * 0.01), 2)
								elseif f_stringpreferences("UpdatePurPrice") = "R" then
									ld_updpurrate = round(ld_netrate, 2)
								end if
								if f_stringpreferences("UpdatePurPrice") <> "N" and wf_updateitempurprice(ll_icode, ls_alternatealiasname, ll_salesmancode, ld_updpurrate) <> 0 then
									lb_commitflag = false
								end if
								if f_stringpreferences("UpdatePurDisc") = "Y" and wf_updateitempurdisc(ll_icode, ld_purdiscpack) <> 0 then
									lb_commitflag = false
								end if
								if f_stringpreferences("PurReplaceItemSaledisc") = "Y" and wf_replacesalediscperc(ll_icode, ld_purdiscpack) <> 0 then
									lb_commitflag = false
								end if
								if f_stringpreferences("updateflatdiscforitem") = "Y" and wf_updateitemflatdisc(ll_icode, ld_flatdiscforitem) <> 0 then
									lb_commitflag = false
								end if
								if f_stringpreferences("updateunitsalestaxinpur") = "Y" and wf_updateunitsalestax(ll_icode, ll_salesmancode, ld_itemsalestax) <> 0 then
									lb_commitflag = false
								end if
								if f_stringpreferences("updateitemlocationinpur") <> "N" and wf_update_itemlocation(ll_icode, ls_location) <> 0 then
									lb_commitflag = false
								end if
								if isnull(ls_alternatealiasname) then
									ld_recentpurprice = ld_netrate
								else
									ld_recentpurprice = round(ld_netrate / ll_packunits, 2)
								end if
							case else
								SQL SELECT PackUnits INTO :ll_basepackunits FROM Item WHERE ICode =:ll_icode USING this.it_transobject;
								if ll_basepackunits <= 0 or isnull(ll_basepackunits) then
									ll_basepackunits = 1
								end if
								ld_purprice = lds_purdetail.object.purprice[li_detailcounter]
								ld_purqty = ld_looseqty
								ld_purbonusqty = ld_bonusqty
								if isnull(ls_alternatealiasname) then
									ld_recentpurprice = round(ld_netrate * ld_purqty / (ld_purqty + ld_purbonusqty) * ll_packunits, 2)
								else
									ld_recentpurprice = round(ld_netrate * ld_purqty / (ld_purqty + ld_purbonusqty) * ll_basepackunits, 2)
								end if
							end choose
							if f_stringpreferences("UpdateBatchSalePriceOnPurPosting") = "Y" then
								ld_batchsaleprice = lds_purdetail.getitemdecimal(li_detailcounter, "batchsaleprice")
								this.it_transobject.update_itembatchsaleprice(ll_icode, ls_batch, ldt_expiry, ld_batchsaleprice, ll_salesmancode)
								if this.it_transobject.sqlcode <> 0 then
									ls_errortext = "Item Batch SalePrice Updation Error:~r~n" + this.it_transobject.sqlerrtext
									lb_commitflag = false
								end if
							end if
							if lc_salestaxschedule = "Y" and ll_salestaxschedulecode > 0 and wf_update_salestaxschedule(ll_icode, ll_salestaxschedulecode) = false then
								lb_commitflag = false
							end if
							if lc_pctcode = "Y" and ll_pctcode > 0 and wf_update_pctcode(ll_icode, ll_pctcode) = false then
								lb_commitflag = false
							end if
							if lc_itemalert = "Y" and ll_itemalertcode > 0 and wf_update_itemalert(ll_icode, ll_itemalertcode) = false then
								lb_commitflag = false
							end if
							if not isnull(ll_manfcode) and wf_updatemanfcode(ll_icode, ll_manfcode) <> 0 then
								lb_commitflag = false
							end if
							if this.ii_purchasetype = 7 then
								if f_stringpreferences("UpdRPPOnLoosePurPosting") = "Y" and wf_updaterecentpurprice(ll_icode, ld_recentpurprice) <> 0 then
									lb_commitflag = false
								end if
							elseif wf_updaterecentpurprice(ll_icode, ld_recentpurprice) <> 0 then
								lb_commitflag = false
							end if
							if this.ii_purchasetype = 1 then
								if ls_updateavgpricewithnetrate = "Y" then
									ld_netrate = ld_netrate / ll_packunits
								else
									ld_totqty = ld_packqty + ld_looseqty + ld_bonusqty
									ld_itemgrossvalue = lds_purdetail.object.c_finalitemval[li_detailcounter] - lds_purdetail.object.c_gstval[li_detailcounter] - lds_purdetail.object.c_taxval[li_detailcounter]
									ld_temprate = (ld_itemgrossvalue / ld_grossvalue * ld_invlevelvalues + ld_itemgrossvalue + ld_itemexpenses) / ld_totqty
									ld_netrate = round(ld_temprate / ll_packunits, 5)
								end if
							elseif ls_updateavgpricewithnetrate = "Y" then
								ld_netrate = ld_netrate
							else
								ld_totqty = ld_packqty + ld_looseqty + ld_bonusqty
								ld_itemgrossvalue = lds_purdetail.object.c_finalitemval[li_detailcounter] - lds_purdetail.object.c_gstval[li_detailcounter] - lds_purdetail.object.c_taxval[li_detailcounter]
								ld_temprate = (ld_itemgrossvalue / ld_grossvalue * ld_invlevelvalues + ld_itemgrossvalue + ld_itemexpenses) / ld_totqty
								ld_netrate = round(ld_temprate, 5)
							end if
							ld_itempurcost = (ld_purqty + ld_purbonusqty) * ld_netrate
							ld_netpurcost = ld_netpurcost + ld_itempurcost
							this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
							if this.it_transobject.sqlcode = 0 then
								this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
								this.it_transobject.getitemstockall(ll_icode, ld_stock)
								if this.it_transobject.sqlcode = 0 then
									lds_purdetail.object.avgprice[li_detailcounter] = ld_avgprice
									lds_purdetail.object.currstock[li_detailcounter] = ld_stock
									lds_purdetail.object.godownstock[li_detailcounter] = ld_godownstock
									ld_newstock = ld_stock + ld_purqty + ld_purbonusqty
									if ld_newstock > 0.0 then
										ld_newavgprice = (ld_stock * ld_avgprice + ld_itempurcost) / ld_newstock
										lds_purdetail.object.newavgprice[li_detailcounter] = ld_newavgprice
										this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ldt_expiry, ld_stock)
										if this.it_transobject.sqlcode = 0 then
											ld_newstock = ld_stock + ld_purqty + ld_purbonusqty
											this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ldt_expiry, ld_newstock)
											if this.it_transobject.sqlcode = 0 then
												this.it_transobject.lockbatch(ll_gcode, ll_icode, ls_batch, ldt_expiry, ld_newstock, ls_lockbatch, ll_lockreasoncode)
												if this.it_transobject.sqlcode = 0 then
													if wf_update_manfdate(ll_icode, ll_gcode, ls_batch, ldt_expiry, ldt_manfdate) = 0 then
														this.it_transobject.updateitemavgprice(ll_icode, ld_newavgprice)
														if this.it_transobject.sqlcode = 0 then
															SQL SELECT saleprice , purprice , discountedsaleprice INTO :ld_saleprice, :ld_rate, :ld_discountedsaleprice FROM item Where item.icode =:ll_icode USING this.it_transobject;
															lds_purdetail.object.saleprice[li_detailcounter] = ld_saleprice
															lds_purdetail.object.discountedsaleprice[li_detailcounter] = ld_discountedsaleprice
															lds_purdetail.object.rate[li_detailcounter] = ld_rate
															if this.it_transobject.sqlcode = 0 then
																this.it_transobject.updatetransitstock(1, ll_icode, ld_purqty + ld_purbonusqty)
																if this.it_transobject.sqlcode <> 0 then
																	lb_commitflag = false
																end if
																this.it_transobject.updateitemtotalpiecesinhand(ll_icode, 1, ll_totalpieces)
																if this.it_transobject.sqlcode <> 0 then
																	lb_commitflag = false
																end if
															else
																lb_commitflag = false
															end if
														else
															lb_commitflag = false
														end if
													else
														lb_commitflag = false
													end if
												else
													lb_commitflag = false
												end if
											else
												lb_commitflag = false
												ls_errortext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
											end if
										else
											lb_commitflag = false
											ls_errortext = "Batch Wise Stock Fetch Error:~r~n" + this.it_transobject.sqlerrtext
										end if
									else
										lb_commitflag = false
									end if
								else
									lb_commitflag = false
								end if
							else
								lb_commitflag = false
							end if
							li_detailcounter = li_detailcounter + 1
						loop
						if lb_commitflag = false then
							SQL rollback USING this.it_transobject;
							messagebox("Updation Fail", string(ll_invcode) + "  invoice code" + "~n~r and greater can not be posted.~r~n" + ls_errortext)
							destroy lds_purinvforposting
							destroy lds_purheader
							destroy lds_purdetail
							return lb_commitflag
						elseif lds_purheader.update(true, false) < 0 then
							SQL rollback USING this.it_transobject;
						elseif lds_purdetail.update() > 0 then
							if ls_batchcosting = "Y" then
								this.it_transobject.add_itembatches_from_purchase(ll_invcode)
								if this.it_transobject.sqlcode <> 0 then
									lb_commitflag = false
									ls_errortext = this.it_transobject.sqlerrtext
									SQL rollback USING this.it_transobject;
									messagebox("Posting Failed", string(ll_invcode) + "  invoice code" + "~n~r and greater can not be posted while adding stock item batches. Details are~r~n" + ls_errortext)
									return false
								else
									lb_commitflag = true
								end if
							end if
							if ll_associatedsaleordercode > 0 and lb_commitflag then
								if this.it_transobject.generate_batchwisesale_from_saleorder(ll_associatedsaleordercode, ll_associatedsaleinvcode) = 0 then
									SQL update PurLedger SET AssociatedSaleInvCode =:ll_associatedsaleinvcode WHERE PurInvCode =:ll_invcode USING this.it_transobject;
									if this.it_transobject.sqlcode <> 0 then
										SQL rollback USING this.it_transobject;
										messagebox("Sales Invoice Generation Problem", "Problem Updating Purchase Invoice~r~n" + "Against Associated Sale Order No " + trim(string(ll_associatedsaleordercode)) + "~r~nDuring posting of purchase inv. no. " + trim(string(ll_invcode)) + "~r~nDetails are:-~r~n" + this.it_transobject.sqlerrtext)
										lb_commitflag = false
									end if
								else
									SQL rollback USING this.it_transobject;
									messagebox("Sale Invoice Generation Problem", "Problem Generating Sale Invoice~r~n" + "Against Associated Sale Order No " + trim(string(ll_associatedsaleordercode)) + "~r~nDuring posting of purchase inv. no. " + trim(string(ll_invcode)) + "~r~nDetails are:-~r~n" + this.it_transobject.sqlerrtext)
									lb_commitflag = false
								end if
							end if
							if lb_commitflag then
								if f_stringpreferences("AutoDueSatisfyOnPurPost") = "Y" then
									if this.it_transobject.purchasebased_satisfydue(ll_invcode, ll_salesmancode, ldt_server_datetime, ll_duedoccode) = 0 then
										if not isnull(ll_duedoccode) or ll_duedoccode <> 0 then
											ls_due_message = ls_due_message + trim(string(ll_duedoccode)) + ", "
										end if
										SQL commit USING this.it_transobject;
									else
										SQL rollback USING this.it_transobject;
										messagebox("Posting Failed", string(ll_invcode) + "  invoice code" + "~n~r and greater can not be posted due to problem in auto due satisfaction process.~r~n" + ls_errortext)
									end if
								else
									SQL commit USING this.it_transobject;
								end if
							end if
						else
							ls_errortext = this.it_transobject.sqlerrtext
							SQL rollback USING this.it_transobject;
							messagebox("Posting Failed", string(ll_invcode) + "  invoice code" + "~n~r and greater can not be posted due to problem in updation.~r~n" + ls_errortext)
							lb_commitflag = false
						end if
					end if
				next
				if lb_commitflag then
					if len(ls_due_message) > 0 then
						ls_due_message = "Auto Due Satisfaction Made Through Due Document Code(s) = " + ls_due_message
					end if
					messagebox("Posting", "Posting Completed~r~n" + ls_due_message)
				end if
			else
				SQL rollback USING this.it_transobject;
				lb_commitflag = false
			end if
		end if
	end if
	setpointer(arrow!)
	destroy lds_purinvforposting
	destroy lds_purheader
	destroy lds_purdetail
	return lb_commitflag

// w_purchase.wf_updateitemsaleprice(transaction at_transobject, long al_icode, string as_alternatealiasname, long al_usercode, double ad_saleprice) returns long
	SQL update Item SET Saleprice =:ad_saleprice , UserCode =:al_usercode , LastUpdate =GETDATE ( ) WHERE Item.icode =:al_icode USING at_transobject;
	return at_transobject.sqlcode

// w_purchase.wf_updateitempurprice(long al_icode, string as_alternatealiasname, long al_usercode, double ad_purprice) returns integer
	long ll_rowno
	long ll_rowcount
	integer li_packuints
	integer li_basicpackunits
	string ls_itemname
	li_packuints = 1
	if isnull(as_alternatealiasname) then
		SQL update Item SET purprice =:ad_purprice , UserCode =:al_usercode , LastUpdate =GETDATE ( ) WHERE Item.icode =:al_icode USING this.it_transobject;
	else
		SQL update AlternateItemAlias SET purprice =:ad_purprice WHERE icode =:al_icode AND CustomICode =:as_alternatealiasname USING this.it_transobject;
		if this.it_transobject.sqlnrows = 0 then
			SQL SELECT name INTO :ls_itemname FROM item WHERE icode =:al_icode USING this.it_transobject;
			messagebox("Alternate Alias Name Validation", " Alternate Item Alias ( " + as_alternatealiasname + " )" + "is not associated with~r~n ~"" + ls_itemname + "~"~r~nPlease delete this item and insert again")
			return -1
		end if
		if this.it_transobject.sqlcode = 0 and this.it_transobject.sqlnrows > 0 then
			SQL update Item SET Item.purprice =Round ( ( :ad_purprice / CASE WHEN ( SELECT MAX ( AI.Qty ) FROM AlternateItemAlias AI WHERE AI.CustomICode =:as_alternatealiasname AND AI.ICode =:al_icode ) =0 THEN 1 ELSE ( SELECT MAX ( AI.Qty ) FROM AlternateItemAlias AI WHERE AI.CustomICode =:as_alternatealiasname AND AI.ICode =:al_icode ) END ) *Item.PackUnits , 2 ) , UserCode =:al_usercode , LastUpdate =GETDATE ( ) WHERE Item.icode =:al_icode USING this.it_transobject;
		end if
	end if
	return this.it_transobject.sqlcode

// w_purchase.wf_updatealternatealiasprice() returns long
	long ll_count
	long ll_icode
	if this.id_detail.getrow() > 0 then
		ll_icode = this.id_detail.object.icode[this.id_detail.getrow()]
		if ll_icode > 0 then
			SQL SELECT ISNULL ( Count ( CustomICode ) , 0 ) INTO :ll_count FROM AlternateItemAlias WHERE ICode =:ll_icode USING sqlca;
			if sqlca.sqlcode = 0 then
				if ll_count = 0 or isnull(ll_count) then
					return 0
				else
					openwithparm(w_alternate_item_aliasname_update, ll_icode)
					return 0
				end if
				return
			end if
			messagebox("Database Problem", "Some Database Problem caused an error. Details are:-~r~n" + sqlca.sqlerrtext, stopsign!)
			return -1
		end if
		return
	end if

// w_purchase.wf_apply_groupsuppliercategory() returns long
	long ll_counter
	integer li_rtncode
	string ls_filterstring
	datastore lds_groupsuppcategory
	if this.ii_purchasetype = 2 then
		this.idc_supplierlist.setfilter("")
		this.idc_supplierlist.filter()
	elseif f_stringpreferences("GroupSuppCatInPurAndPR") = "Y" then
		lds_groupsuppcategory = create datastore
		lds_groupsuppcategory.dataobject = "d_groupsuppcategory_detail"
		lds_groupsuppcategory.settransobject(this.it_transobject)
		this.il_groupcode = f_getgroupcode(gl_usercode)
		lds_groupsuppcategory.retrieve(this.il_groupcode)
		ls_filterstring = ""
		for ll_counter = 1 to lds_groupsuppcategory.rowcount()
			ls_filterstring = ls_filterstring + trim(string(lds_groupsuppcategory.object.suppcatcode[ll_counter])) + ","
		next
		if right(ls_filterstring, 1) = "," then
			ls_filterstring = left(ls_filterstring, len(ls_filterstring) - 1)
		end if
		if ls_filterstring = "" then
			ls_filterstring = "-1"
		end if
		this.idc_supplierlist.setfilter("suppcatcode In (" + ls_filterstring + ") ")
		this.idc_supplierlist.filter()
	end if
	return 0

// w_purchase.wf_check_groupsuppliercategory() returns long
	long ll_acccode
	long ll_found
	long ll_code
	long ll_counter
	long ll_rowcount
	long ll_groupcode
	long ll_suppcatcode
	boolean lb_groupcustcat
	if f_stringpreferences("GroupSuppCatInPurAndPR") = "N" then
		return 0
	end if
	ll_groupcode = f_getgroupcode(gl_usercode)
	ll_rowcount = this.id_detail.rowcount()
	ll_acccode = this.id_master.getitemnumber(1, "suppcode")
	SQL Select MAX ( SuppCode ) , MAX ( SuppCatCode ) INTO :ll_found, :ll_suppcatcode From dbo.supplier Where suppcode =:ll_acccode USING this.it_transobject;
	if ll_found > 0 and ll_suppcatcode > 0 and this.it_transobject.sqlcode = 0 then
		ll_found = 0
		SQL SELECT count ( suppcatcode ) INTO :ll_found FROM GroupSupplierCategory WHERE SuppCatCode =:ll_suppcatcode AND GroupCode =:ll_groupcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 and ll_found < 1 then
			return -1
		end if
		return
	end if
	return 0

// w_purchase.wf_changeitemprices() returns long
	long ll_row
	long ll_icode
	s_previnvinfo lstr_iteminfo
	double ld_purprice
	ll_row = this.id_detail.getrow()
	if ll_row > 0 then
		ll_icode = this.id_detail.object.icode[ll_row]
		if ll_icode > 0 then
			lstr_iteminfo.ar_icode = ll_icode
			lstr_iteminfo.ar_customer = this.ii_purchasetype
			openwithparm(w_change_item_prices_update, lstr_iteminfo)
			SQL SELECT PurPrice INTO :ld_purprice FROM Item WHERE ICode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 and this.ii_purchasetype = 2 then
				if this.id_detail.object.packunits[ll_row] = 0 or isnull(this.id_detail.object.purprice[ll_row]) then
					this.id_detail.object.purprice[ll_row] = ld_purprice
				else
					this.id_detail.object.purprice[ll_row] = round(ld_purprice / this.id_detail.object.packunits[ll_row], 2)
				end if
			end if
		end if
	end if
	return 0

// w_purchase.wf_update_itemlocation(long al_icode, string as_location) returns long
	SQL update Item SET Location =:as_location WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_purchase.wf_check_right_exists(long al_usercode, long al_rightcode) returns long
	long ll_groupcode
	long ll_count
	ll_groupcode = f_getgroupcode(al_usercode)
	SQL SELECT ISNULL ( COUNT ( RightCode ) , 0 ) INTO :ll_count FROM GroupRights WHERE GroupCode =:ll_groupcode AND RightCode =:al_rightcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_count = 0 then
			return 0
		else
			return 1
		end if
		return
	end if
	return -1

// w_purchase.wf_fetch_previous_margin(long al_icode, long al_purinvcode, double ad_margin) returns long
	SQL SELECT PL.PurInvCode , Margin =ROUND ( ( ( PD.SalePriceForItem - PD.NetRate ) / CASE WHEN PD.SalePriceForItem =0 THEN 1 ELSE PD.SalePriceForItem END ) *100 , 2 ) INTO :al_purinvcode, :ad_margin FROM PurLedger PL , PurDetail PD , ( SELECT PurInvCode =MAX ( PurLedger.PurInvCode ) FROM PurLedger WHERE PurLedger.Posted ='Y' AND PurLedger.PostDate IN ( SELECT MAX ( P.PostDate ) FROM PurLedger P , PurDetail D WHERE P.Posted ='Y' AND D.ICode =:al_icode AND P.PurInvCode =D.PurInvCode ) ) T WHERE PL.Posted ='Y' AND PL.PurInvCode =T.PurInvCode AND PL.PurInvCode =PD.PurInvCode AND PD.ICode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		return 1
	end if
	if this.it_transobject.sqlcode = 100 then
		al_purinvcode = -1
		ad_margin = -1
		return 0
	end if
	return -1

// w_purchase.wf_report_prev_margin_deviations(long al_start, long al_end) returns integer
	long ll_detailrows
	long ll_pocode
	long ll_masterrow
	long ll_count
	long ll_found
	long ll_retcode
	long ll_result = 1
	long ll_icode
	long[] ll_invcode
	datastore lds_margindeviations
	s_datastore lstr
	lds_margindeviations = create datastore
	lds_margindeviations.dataobject = "d_prevmargin_deviations_report"
	lds_margindeviations.settransobject(this.it_transobject)
	ll_retcode = lds_margindeviations.retrieve(al_start, al_end)
	if lds_margindeviations.rowcount() > 0 then
		lstr.ds = lds_margindeviations
		lstr.s_name1 = lds_margindeviations.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		ll_result = messagebox("Previous Margin Deviations Report", "Previous Margin Deviations Report Detected some Items~r~nContinue Posting?", question!, yesno!, 1)
		if ll_result = 1 then
			ll_retcode = 0
		else
			ll_retcode = 1
		end if
	end if
	destroy lds_margindeviations
	return ll_retcode

// w_purchase.wf_sortitems() returns long
	string ls_null
	if wf_iseditable() = false then
		return 0
	end if
	setnull(ls_null)
	this.id_detail.setsort(ls_null)
	this.id_detail.sort()
	return 0

// w_purchase.wf_set_batch_expiry_lockstatus(long al_gcode, long al_icode, string as_batch, datetime adt_expiry) returns long
	string ls_locked
	long ll_lockreasoncode
	SQL SELECT ISNULL ( MAX ( Locked ) , 'N' ) , ISNULL ( MAX ( lockreasoncode ) , 1 ) INTO :ls_locked, :ll_lockreasoncode FROM GodownDetail WHERE GCode =:al_gcode AND ICode =:al_icode AND Batch =:as_batch AND expiry =:adt_expiry USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 and (this.id_detail.rowcount() > 0 and this.id_detail.getrow() > 0) then
		this.id_detail.object.lockbatch[this.id_detail.getrow()] = ls_locked
		this.id_detail.object.lockreasoncode[this.id_detail.getrow()] = ll_lockreasoncode
	end if
	return 0

// w_purchase.wf_get_document(long al_row, long al_code) returns long
	blob lbl_image
	u_transaction lt_transobject
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server")
		destroy lt_transobject
		return -1
	end if
	SQL SelectBlob Document INTO :lbl_image From PurchaseDocument Where PurInvCode =:al_code AND RowID =:al_row USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Document/Image/Picture ", "Unable to fetch Document/Image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	this.istr_document.blob[al_row] = lbl_image
	return 0

// w_purchase.wf_populate_document(long al_code) returns long
	long ll_counter
	long ll_rowcount
	long ll_code
	ll_rowcount = this.dw_document.rowcount()
	if ll_rowcount <= 0 then
		return 0
	end if
	if isnull(al_code) or al_code <= 0 then
		return 0
	end if
	ll_code = this.dw_document.object.code[1]
	for ll_counter = 1 to ll_rowcount
		this.istr_document.ls_value[ll_counter, 1] = trim(string(this.dw_document.object.rowid[ll_counter]))
		this.istr_document.ls_value[ll_counter, 2] = this.dw_document.object.docdescription[ll_counter]
		this.istr_document.ls_value[ll_counter, 3] = this.dw_document.object.documenttype[ll_counter]
		wf_get_document(ll_counter, al_code)
	next
	return 0

// w_purchase.wf_set_purdocument() returns integer
	long ll_counter
	long ll_code
	long ll_row
	long ll_null
	s_itemimage lstr_document
	lstr_document.s_caller = "PV"
	setnull(ll_null)
	if this.tab_retrieve.selectedtab = 1 then
		return 0
	elseif this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 then
		this.istr_document = this.istr_blank_document
		ll_code = this.id_list.object.code[this.id_list.getrow()]
		if ll_code > 0 then
			this.dw_document.retrieve(ll_code)
			wf_populate_document(ll_code)
			for ll_counter = 1 to this.dw_document.rowcount()
				lstr_document.ls_value[ll_counter, 1] = trim(string(this.dw_document.object.rowid[ll_counter]))
				lstr_document.ls_value[ll_counter, 2] = this.dw_document.object.docdescription[ll_counter]
				lstr_document.ls_value[ll_counter, 3] = this.dw_document.object.documenttype[ll_counter]
				lstr_document.blob[ll_counter] = this.istr_document.blob[ll_counter]
			next
			openwithparm(w_purdocument, lstr_document)
			lstr_document = message.powerobjectparm
			if lstr_document.i_closemode = 1 then
				this.istr_document = lstr_document
				this.dw_document.reset()
				for ll_counter = 1 to 200
					if long(lstr_document.ls_value[ll_counter, 1]) > 0 then
						ll_row = this.dw_document.insertrow(0)
						this.dw_document.object.code[ll_row] = ll_code
						this.dw_document.object.rowid[ll_row] = long(lstr_document.ls_value[ll_counter, 1])
						this.dw_document.object.docdescription[ll_row] = lstr_document.ls_value[ll_counter, 2]
						this.dw_document.object.documenttype[ll_row] = lstr_document.ls_value[ll_counter, 3]
					end if
				next
				if wf_update_document(ll_code) = 0 then
					this.dw_document.reset()
					this.istr_document = this.istr_blank_document
				end if
			end if
		end if
	end if
	return 0

// w_purchase.wf_show_documentgallery() returns long
	long ll_code
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_code = this.id_master.object.code[this.id_master.getrow()]
		end if
	elseif this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
	end if
	if ll_code > 0 then
		openwithparm(w_purdocument_gallery, ll_code)
	end if
	return 0

// w_purchase.wf_update_document(long al_code) returns long
	long ll_counter
	long ll_rowid
	long ll_null
	string ls_desc
	string ls_imgtype
	u_transaction lt_transobject
	setnull(ll_null)
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server for updating/inserting in Purchase Document Table")
		destroy lt_transobject
		return -1
	end if
	SQL DELETE PurchaseDocument WHERE PurInvCode =:al_code USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to Delete Previous Purchase Document Record from database")
		destroy lt_transobject
		return -1
	end if
	for ll_counter = 1 to this.dw_document.rowcount()
		ll_rowid = this.dw_document.object.rowid[ll_counter]
		ls_desc = this.dw_document.object.docdescription[ll_counter]
		ls_imgtype = this.dw_document.object.documenttype[ll_counter]
		SQL INSERT INTO PurchaseDocument ( PurInvCode , docDescription , RowID , documentType ) VALUES ( :al_code , :ls_desc , :ll_rowid , :ls_imgtype ) USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Insert Error", "Unable to Insert Purchase Documents Into Purchase Document Table.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
			SQL stop USING lt_transobject;
			destroy lt_transobject
			return -1
		end if
		SQL UpdateBlob PurchaseDocument Set Document =:this.istr_document.blob[ll_counter] Where PurInvCode =:al_code and ROWID =:ll_rowid USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Purchase Document ", "Unable to update Purchase Document.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		end if
	next
	SQL stop USING lt_transobject;
	destroy lt_transobject
	return 0

// w_purchase.wf_set_taxcategory(long al_code) returns long
	long ll_counter
	long ll_retcode
	long ll_icode
	double ld_taxperc
	char lc_taxable
	ll_retcode = 0
	if this.id_detail.rowcount() > 0 and al_code > 0 then
		this.ib_advancetax_edited = false
		SQL SELECT taxperc INTO :ld_taxperc FROM TaxCategory WHERE TaxCategoryCode =:al_code USING this.it_transobject;
		if ld_taxperc < 0.0 or isnull(ld_taxperc) then
			ld_taxperc = 0.00
		end if
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.object.icode[ll_counter]
			SQL SELECT Taxable INTO :lc_taxable FROM Item WHERE Icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				this.id_detail.object.taxable[ll_counter] = lc_taxable
				if this.ic_advancetaxonpur = "Y" and lc_taxable = "Y" then
					this.id_detail.object.itemadvancetaxperc[ll_counter] = ld_taxperc
				else
					this.id_detail.object.itemadvancetaxperc[ll_counter] = 0.00
				end if
			else
				return -1
			end if
		next
	end if
	wf_grandtotal()
	return ll_retcode

// w_purchase.wf_fetch_latest_unitsalestax(long al_icode, long al_row) returns long
	long ll_purinvcode
	long ll_packunits
	long ll_purcatcode
	double ld_unitsalestax
	SQL SELECT PurInvCode =MAX ( PL.PurInvCode ) , UnitSalesTax =MAX ( PD.UnitSalesTax ) , Packunits =MAX ( PD.PackUnits ) , PurCatCode =MAX ( PL.PurCatCode ) INTO :ll_purinvcode, :ld_unitsalestax, :ll_packunits, :ll_purcatcode FROM PurDetail PD , PurLedger PL WHERE PL.PurCatCode <> 3 AND PD.PurInvCode IN ( SELECT PurInvCode =MAX ( D.PurInvCode ) FROM PurDetail D WHERE D.ICode =:al_icode ) AND PD.ICode =:al_icode AND PD.PurInvCode =PL.PurInvCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_purinvcode <= 0 or isnull(ll_purinvcode) then
			SQL SELECT PurInvCode =MAX ( PD.PurInvCode ) , UnitSalesTax =MAX ( PD.UnitSalesTax ) , Packunits =MAX ( PD.PackUnits ) , PurCatCode =MAX ( PD.PurCatCode ) INTO :ll_purinvcode, :ld_unitsalestax, :ll_packunits, :ll_purcatcode FROM DBO.LastPurchaseHistory PD WHERE PD.ICode =:al_icode USING this.it_transobject;
		end if
		if ld_unitsalestax <= 0.0 or isnull(ld_unitsalestax) then
			ld_unitsalestax = 0
		end if
		if ll_packunits <= 0 or isnull(ll_packunits) then
			ll_packunits = 1
		end if
		if this.ii_purchasetype = 1 then
			if ll_purcatcode <= 2 then
				this.id_detail.object.unitsalestax[al_row] = round(ld_unitsalestax, 2)
			else
				this.id_detail.object.unitsalestax[al_row] = round(ld_unitsalestax * ll_packunits, 2)
			end if
		elseif ll_purcatcode <= 2 then
			this.id_detail.object.unitsalestax[al_row] = round(ld_unitsalestax / ll_packunits, 2)
		else
			this.id_detail.object.unitsalestax[al_row] = round(ld_unitsalestax, 2)
		end if
		return 0
	end if
	if this.it_transobject.sqlcode = 100 then
		return -1
	end if
	return -1

// w_purchase.wf_update_pctcode(long al_icode, long al_pctcode) returns boolean
	boolean retflag = true
	SQL update item SET item.pctcode =:al_pctcode WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_purchase.wf_update_salestaxschedule(long al_icode, long al_schedulecode) returns boolean
	boolean retflag = true
	SQL update item SET item.salestaxschedulecode =:al_schedulecode WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_purchase.wf_updateunitsalestax(long al_icode, integer al_usercode, double ad_salestax) returns long
	SQL update Item SET PackSalesTax =:ad_salestax , UserCode =:al_usercode , LastUpdate =GETDATE ( ) WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_purchase.wf_update_itemalert(long al_icode, long al_itemalertcode) returns boolean
	boolean retflag = true
	SQL update item SET item.itemalertcode =:al_itemalertcode WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_purchase.wf_apply_item_gstperc() returns long
	long ll_detailrows
	long ll_icode
	long ll_custcode
	long ll_counter
	string ls_errortext
	boolean lb_enablesave
	boolean lb_bonus
	double ld_saleprice
	double ld_gstperc
	s_arguements lstr_arg
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.rowcount() > 0 and this.id_master.object.posted[1] = "Y" then
		return 0
	end if
	open(w_arg_gstperc)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = -1 then
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows <= 0 then
		return 0
	end if
	ld_gstperc = lstr_arg.db_code1
	if ld_gstperc < 0.0 or isnull(ld_gstperc) then
		return 0
	end if
	for ll_counter = 1 to ll_detailrows
		this.id_detail.object.gstperc[ll_counter] = ld_gstperc
	next
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return 0

// w_purchase.wf_apply_item_discountperc() returns long
	long ll_detailrows
	long ll_icode
	long ll_custcode
	long ll_counter
	string ls_errortext
	boolean lb_enablesave
	boolean lb_bonus
	double ld_discperc
	s_arguements lstr_arg
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.rowcount() > 0 and this.id_master.object.posted[1] = "Y" then
		return 0
	end if
	open(w_arg_discperc)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = -1 then
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows <= 0 then
		return 0
	end if
	ld_discperc = lstr_arg.db_code1
	if ld_discperc < 0.0 or isnull(ld_discperc) then
		return 0
	end if
	for ll_counter = 1 to ll_detailrows
		this.id_detail.object.discperc[ll_counter] = ld_discperc
	next
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return 0

// w_purchase.wf_populate_pur_from_other_sources() returns long
	string ls_named
	string ls_filename
	string ls_customicode
	string ls_itemname
	string ls_errortext
	string ls_suppinvno
	long ll_value
	long ll_rowcount
	long ll_counter
	long ll_icode
	long ll_itemcodetype
	long ll_res
	long ll_ins_row
	datastore lds_info
	runtimeerror ex
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate Purchase invoice after posting!")
		return 0
	end if
	ls_named = f_stringpreferences("outputfilepath")
	ll_itemcodetype = 1
	ll_value = getfileopenname("Select File Location", ls_filename, ls_named, "xls", "Excel Files (*.XLS),*.xls, Excel Files (*.XLSX),*.xlsx," + "All Files (*.*),*.*", ls_named)
	if len(ls_filename) > 0 then
		try
			lds_info = create datastore
			lds_info.dataobject = "d_purchase_resultset_from_excel"
			lds_info.settransobject(sqlca)
			lds_info.retrieve(ls_filename)
			ll_rowcount = lds_info.rowcount()
			if ll_rowcount > 0 then
				wf_deleteemptydetailrow()
				for ll_counter = 1 to ll_rowcount
					ls_customicode = lds_info.getitemstring(ll_counter, 3)
					if not isnull(ls_customicode) then
						ls_suppinvno = trim(string(lds_info.getitemdecimal(ll_counter, 1)))
						this.id_master.object.suppinvcode[1] = ls_suppinvno
						ll_res = wf_findfullcode(ls_customicode, ll_icode, ls_itemname, ll_itemcodetype, this.idbl_packqty, this.idbl_purprice, this.idbl_saleprice)
						if ll_icode > 0 then
							ll_ins_row = this.id_detail.insertrow(0)
							if ll_ins_row > 0 then
								if wf_inititeminfo(ll_icode, ll_ins_row, ls_errortext) then
									if this.ii_purchasetype = 1 then
										this.id_detail.object.packqty[ll_ins_row] = lds_info.getitemdecimal(ll_counter, 5)
									else
										this.id_detail.object.looseqty[ll_ins_row] = lds_info.getitemdecimal(ll_counter, 5)
									end if
									this.id_detail.object.batch[ll_ins_row] = lds_info.getitemstring(ll_counter, 6)
									this.id_detail.object.manfdate[ll_ins_row] = lds_info.getitemdatetime(ll_counter, 7)
									this.id_detail.object.expiry[ll_ins_row] = lds_info.getitemdatetime(ll_counter, 8)
								end if
							else
								messagebox("Item Insert Error", "Error inserting Item in row no. " + string(ll_counter), stopsign!)
							end if
						else
							messagebox("Item Validation", "Item Not Found in row number " + string(ll_counter), stopsign!)
						end if
					end if
				next
			end if
		catch (throwable ex)
			messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
		end try
	end if
	return 0

// w_purchase.wf_push_purchase_to_dropbox() returns long
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_counter
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	if ll_salesmancode > 0 then
		openwithparm(w_arg_sinvcode_linvcode, this.ii_purchasetype)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			li_errcode = this.it_transobject.pushpurchasetodropbox(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode, gs_dropbox_server, gs_dropbox_db, "DBO", ll_saleinvcount)
			if li_errcode <> 0 then
				li_errcode = this.it_transobject.sqlcode
				ls_msgtext = this.it_transobject.sqlerrtext
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				ls_msgtext = this.it_transobject.sqlerrtext
				li_errcode = this.it_transobject.sqlcode
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Push Purchase To Drop Box Fails", "Some database request fails, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode), stopsign!)
		else
			messagebox("Push to Drop Box Successfull", "Total Invoices to push were " + string(ll_saleinvcount) + "~n~rAll Invoices have been pushed successfully to drop box.", information!)
		end if
	end if
	return li_errcode

// w_purchase.wf_show_misccharges_breakup() returns long
	double ld_advincometax
	s_values lstr_values
	lstr_values.d_value1 = this.id_footer.object.misccharges1[1]
	lstr_values.d_value2 = this.id_footer.object.misccharges2[1]
	lstr_values.d_value3 = this.id_footer.object.misccharges3[1]
	lstr_values.d_value4 = this.id_footer.object.misccharges4[1]
	lstr_values.d_value5 = this.id_footer.object.misccharges5[1]
	lstr_values.i_status = 1
	openwithparm(w_purmisccharges_breakup, lstr_values)
	lstr_values = message.powerobjectparm
	if lstr_values.i_status = 1 then
		this.id_footer.object.misccharges1[1] = lstr_values.d_value1
		this.id_footer.object.misccharges2[1] = lstr_values.d_value2
		this.id_footer.object.misccharges3[1] = lstr_values.d_value3
		this.id_footer.object.misccharges4[1] = lstr_values.d_value4
		this.id_footer.object.misccharges5[1] = lstr_values.d_value5
		if this.ic_advancetaxonpur = "Y" then
			ld_advincometax = this.id_footer.object.advancetaxamt[1]
		else
			ld_advincometax = 0.00
		end if
		this.id_footer.object.misccharges[1] = ld_advincometax + lstr_values.d_value1 + lstr_values.d_value2 + lstr_values.d_value3 + lstr_values.d_value4 + lstr_values.d_value5
	end if
	wf_grandtotal()
	return 0

// w_purchase.wf_set_misccharges() returns long
	double ld_processingfee
	double ld_netamt
	double ld_misccharges
	double ld_newnetamt
	double ld_advincometax
	ld_netamt = wf_grandtotal()
	ld_misccharges = this.id_footer.object.misccharges[1]
	ld_newnetamt = ld_netamt - ld_misccharges
	if ld_newnetamt < 0.0 or isnull(ld_newnetamt) then
		ld_newnetamt = 0
	end if
	openwithparm(w_set_purmisccharges, ld_newnetamt)
	ld_processingfee = message.doubleparm
	if ld_processingfee >= 0.0 then
		if this.ic_advancetaxonpur = "Y" then
			ld_advincometax = this.id_footer.object.advancetaxamt[1]
		else
			ld_advincometax = 0.00
		end if
		this.id_footer.object.misccharges5[1] = ld_processingfee
		this.id_footer.object.misccharges[1] = ld_advincometax + this.id_footer.object.misccharges1[1] + this.id_footer.object.misccharges2[1] + this.id_footer.object.misccharges3[1] + this.id_footer.object.misccharges4[1] + ld_processingfee
		this.id_footer.accepttext()
		wf_grandtotal()
	end if
	return 0

// w_purchase.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_purchasemenu" then
		this.menuid = create m_purchasemenu
	end if
	this.dw_purinvrep = create dw_purinvrep
	this.dw_changeprice_foritemlog = create dw_changeprice_foritemlog
	this.dw_document = create dw_document
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_purinvrep
	this.control[icurrent + 2] = this.dw_changeprice_foritemlog
	this.control[icurrent + 3] = this.dw_document

// w_purchase.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_purinvrep
	destroy this.dw_changeprice_foritemlog
	destroy this.dw_document

// w_purchase.ue_save() returns 0 [event]
	double ld_bonusqty
	double ld_looseqty
	double ld_packqty
	integer li_counter = 1
	integer li_option
	long ll_icode
	long ll_purinvcode
	long ll_salesmancode = 1
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_suppcode
	long ll_inv_count
	long ll_counter
	long ll_detailrows
	long ll_count
	long ll_found
	long ll_rightfound
	long ll_associatedsaleordercode
	long ll_maxretcode
	long ll_icatcode
	long ll_monthly_counter
	long ll_daily_counter
	double ld_saleprice
	double ld_recentpurprice
	double ld_advancetaxamt
	double ld_misccharges
	double ld_misccharges1
	double ld_misccharges2
	double ld_misccharges3
	double ld_misccharges4
	double ld_misccharges5
	string ls_updatepurprice
	string ls_grn
	string ls_alternatealiasname
	boolean lb_commitflag = true
	boolean lb_isnewinv
	datetime ldt_expiry
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_supp_invcode
	date ld_expiry
	string ls_expiry
	ls_expiry = f_stringpreferences("purexpiry")
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	if wf_check_groupsuppliercategory() <> 0 then
		messagebox("Group Wise Supplier Category Validation", "Current user group does not have enough permissions w.r.t supplier.~r~nPossible Reasons are:~r~nSupllier is not allowed to the current user group.")
		this.id_master.setcolumn("suppcode")
		this.id_master.setfocus()
		return
	end if
	if f_stringpreferences("allow_negative_margin_on_pur_saving") = "N" then
		wf_grandtotal_with_update_netrate()
		for ll_counter = 1 to this.id_detail.rowcount()
			if this.id_detail.getitemdecimal(ll_counter, "c_margin") < 0 then
				messagebox("Margin % Validation", "Negative Margin % is Not Allowed. Margin Should be some valid +ve value", stopsign!)
				this.id_detail.setrow(ll_counter)
				this.id_detail.setfocus()
				this.id_detail.setcolumn("PurPrice")
				return
			end if
		next
	end if
	ll_counter = 0
	if f_stringpreferences("ForcePCSInInterAtSalesSaving") = "Y" then
		for ll_counter = 1 to this.id_detail.rowcount()
			if this.id_detail.object.pcs[ll_counter] <> long(this.id_detail.object.pcs[ll_counter]) then
				messagebox("PCS Validation", "Please enter some valid PCS. It Should be some valid integer value", stopsign!)
				this.id_detail.setrow(ll_counter)
				this.id_detail.setfocus()
				this.id_detail.setcolumn("PCS")
				return
			end if
		next
	end if
	ll_counter = 0
	if f_stringpreferences("ForceUniqueSuppInvNoInPur") = "Y" then
		ls_supp_invcode = this.id_master.getitemstring(1, "suppinvcode")
		if len(ls_supp_invcode) = 0 or isnull(ls_supp_invcode) then
			messagebox("Supplier Inv. Validation", "Supplier Inoice no. is required~r~nEmpty Supplier Invoice No. not allowed.")
			this.id_master.setcolumn("suppinvcode")
			this.id_master.setfocus()
			return
		end if
		ll_suppcode = this.id_master.getitemnumber(1, "suppcode")
		ll_purinvcode = this.id_master.getitemnumber(1, "code")
		if ll_purinvcode > 0 then
			SQL SELECT isNull ( count ( *) , 0 ) INTO :ll_inv_count FROM Purledger WHERE Purledger.suppcode =:ll_suppcode AND purledger.suppinvcode =:ls_supp_invcode AND purledger.purinvcode NOT IN ( :ll_purinvcode ) USING this.it_transobject;
		else
			SQL SELECT isNull ( count ( *) , 0 ) INTO :ll_inv_count FROM Purledger WHERE Purledger.suppcode =:ll_suppcode AND purledger.suppinvcode =:ls_supp_invcode USING this.it_transobject;
		end if
		if this.it_transobject.sqlcode <> 0 then
			messagebox("DataBase Error", "Unable to get Supplier Inv. no. from database ~r~n" + this.it_transobject.sqlerrtext)
			return
		end if
		if ll_inv_count > 0 then
			messagebox("Supplier Inv. Validation", "Same Supplier Inoice no. already exist~r~nfor same Supplier")
			this.id_master.setcolumn("suppinvcode")
			this.id_master.setfocus()
			return
		end if
		return
	end if
	if f_stringpreferences("forceuniquegrnnoinpur") = "Y" then
		ls_grn = ""
		ls_grn = this.id_master.getitemstring(1, "grn")
		ll_suppcode = this.id_master.getitemnumber(1, "suppcode")
		ll_purinvcode = this.id_master.getitemnumber(1, "code")
		if ll_purinvcode > 0 then
			SQL SELECT isNull ( count ( *) , 0 ) INTO :ll_inv_count FROM Purledger WHERE purledger.grn =:ls_grn AND purledger.purinvcode NOT IN ( :ll_purinvcode ) USING this.it_transobject;
		else
			SQL SELECT isNull ( count ( *) , 0 ) INTO :ll_inv_count FROM Purledger WHERE purledger.grn =:ls_grn USING this.it_transobject;
		end if
		if this.it_transobject.sqlcode <> 0 then
			messagebox("DataBase Error", "Unable to get GRN no. from database ~r~n" + this.it_transobject.sqlerrtext)
			return
		end if
		if ll_inv_count > 0 then
			messagebox("Supplier Inv. Validation", "Same GRN# already exist")
			this.id_master.setcolumn("grn")
			this.id_master.setfocus()
			return
		end if
		return
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		for ll_count = 1 to ll_detailrows
			if ls_expiry = "Y" then
				ldt_expiry = this.id_detail.object.expiry[ll_count]
				ld_expiry = date(ldt_expiry)
				if ld_expiry <= relativedate(today(), f_numberpreferences("AcceptFutureExpiryDays")) then
					li_option = messagebox("Item Validation", "Expiry should be greater than " + string(relativedate(today(), f_numberpreferences("AcceptFutureExpiryDays")), "dd/mmm/yyyy") + "~r~nLine No. " + string(ll_count) + ", Expiry Date = " + string(ld_expiry, "dd/mmm/yyyy") + "~r~nAccept this expiry date?", question!, yesno!, 2)
					if li_option <> 1 then
						if this.ii_purchasetype = 1 then
							this.id_detail.setcolumn("packqty")
						else
							this.id_detail.setcolumn("looseqty")
						end if
						this.id_detail.scrolltorow(ll_count)
						this.id_detail.setfocus()
						return
					end if
					return
				end if
				return
			end if
			ll_found = 0
			if ll_count = ll_detailrows then
				exit
			end if
			ll_found = this.id_detail.find("gcode = long('" + string(this.id_detail.getitemnumber(ll_count, "gcode")) + "') and " + " icode = long('" + string(this.id_detail.getitemnumber(ll_count, "icode")) + "') and batch = '" + this.id_detail.getitemstring(ll_count, "batch") + "' and expiry = Date('" + string(this.id_detail.getitemdatetime(ll_count, "expiry"), "yyyy-mm-dd") + "')", ll_count + 1, ll_detailrows)
			if ll_found > 0 then
				messagebox("Item Validation", "Duplicate items found at row " + string(ll_count) + " and " + string(ll_found) + "." + "~r~nSuggested options are either delete the row or ~r~n" + "change Item batch or expiry")
				this.id_detail.scrolltorow(ll_count)
				if this.ii_purchasetype = 1 then
					this.id_detail.setcolumn("packqty")
				else
					this.id_detail.setcolumn("looseqty")
				end if
				this.id_detail.setfocus()
				return
			end if
		next
	elseif ll_detailrows <= 0 then
		messagebox("On Save Validation", "There are no rows to save.~r~nKindly insert some item row.")
		return
	end if
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if wf_show_po_pur_disparity(1) > 0 then
		return
	end if
	if wf_enforce_po_details() > 0 then
		return
	end if
	if f_stringpreferences("MustShowPurExpWindowOnSaving") = "Y" then
		wf_show_pur_expenses_window(0)
	end if
	wf_setamountoninvoice()
	if f_stringpreferences("puruserwindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	setfocus()
	if ll_salesmancode > 0 then
		setpointer(hourglass!)
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			lb_isnewinv = true
			ll_maxretcode = wf_tabnewid("purledger", ll_invid)
			if ll_maxretcode <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~n ~t~t~t~t~t~t~tgenerating InvCode")
				return
			end if
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
			this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					if lb_isnewinv then
						wf_setnull("Code", lb_isnewinv)
						SQL rollback USING this.it_transobject;
					end if
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
		else
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		end if
		ll_icatcode = this.id_master.getitemnumber(1, "icatcode")
		ll_monthly_counter = this.id_master.getitemnumber(1, "monthlycounter")
		if isnull(ll_monthly_counter) then
			if this.it_transobject.updatepurledgermonthlyicatcounter(ll_icatcode) = -1 then
				SQL rollback USING this.it_transobject;
				wf_setnull("Code", lb_isnewinv)
				messagebox("DataBase Problem", "Reasons:~r~n" + this.it_transobject.sqlerrtext)
				return
			end if
			ll_monthly_counter = 0
			wf_categorywise_pur_counter(ll_icatcode, ll_monthly_counter)
			this.id_master.setitem(1, "monthlycounter", ll_monthly_counter)
		end if
		ll_daily_counter = this.id_master.getitemnumber(1, "dailycounter")
		if isnull(ll_daily_counter) then
			if this.it_transobject.updatepurledgerdailyicatcounter(ll_icatcode) = -1 then
				SQL rollback USING this.it_transobject;
				wf_setnull("Code", lb_isnewinv)
				messagebox("DataBase Problem", "Reasons:~r~n" + this.it_transobject.sqlerrtext)
				return
			end if
			ll_daily_counter = 0
			wf_categorywise_pur_counter_daily(ll_icatcode, ll_daily_counter)
			this.id_master.setitem(1, "dailycounter", ll_daily_counter)
		end if
		ld_misccharges = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges")
		ld_misccharges1 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges1")
		ld_misccharges2 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges2")
		ld_misccharges3 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges3")
		ld_misccharges4 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges4")
		ld_misccharges5 = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges5")
		this.id_master.object.discperc[ll_mastercurrrow] = this.id_footer.object.discperc[ll_footercurrrow]
		this.id_master.object.flatdisc[ll_mastercurrrow] = this.id_footer.object.flatdisc[ll_footercurrrow]
		if this.ic_advancetaxonpur = "Y" then
			this.id_master.object.misccharges[ll_mastercurrrow] = this.id_footer.object.advancetaxamt[ll_footercurrrow] + ld_misccharges1 + ld_misccharges2 + ld_misccharges3 + ld_misccharges4 + ld_misccharges5
			this.id_master.object.advancetaxamt[ll_mastercurrrow] = this.id_footer.object.advancetaxamt[ll_footercurrrow]
		else
			this.id_master.object.advancetaxamt[ll_mastercurrrow] = 0.00
			this.id_master.object.misccharges[ll_mastercurrrow] = ld_misccharges1 + ld_misccharges2 + ld_misccharges3 + ld_misccharges4 + ld_misccharges5
		end if
		this.id_master.object.misccharges1[ll_mastercurrrow] = ld_misccharges1
		this.id_master.object.misccharges2[ll_mastercurrrow] = ld_misccharges2
		this.id_master.object.misccharges3[ll_mastercurrrow] = ld_misccharges3
		this.id_master.object.misccharges4[ll_mastercurrrow] = ld_misccharges4
		this.id_master.object.misccharges5[ll_mastercurrrow] = ld_misccharges5
		this.id_master.object.misccharges[ll_mastercurrrow] = this.id_master.object.advancetaxamt[ll_mastercurrrow] + ld_misccharges1 + ld_misccharges2 + ld_misccharges3 + ld_misccharges4 + ld_misccharges5
		wf_grandtotal_with_update_netrate()
		this.id_footer.accepttext()
		this.id_master.setitem(1, "invtotal", this.id_footer.getitemnumber(1, "total"))
		if this.id_master.getitemstring(1, "accountfor") = "Y" and f_stringpreferences("AskAmtOnPurchase") = "Y" then
			ll_rightfound = 0
			ll_rightfound = gds_securitywindow.find("rightcode = 584", 1, gds_securitywindow.rowcount())
			if ll_rightfound > 0 then
				this.id_master.setitem(ll_mastercurrrow, "amtby", ll_salesmancode)
				this.id_master.setitem(ll_mastercurrrow, "amtdate", ldt_server_datetime)
			end if
		end if
		this.id_master.object.invgstperc1[ll_mastercurrrow] = this.id_footer.object.invgstperc1[ll_footercurrrow]
		do while li_counter <= ll_detailrows
			this.id_detail.setitem(li_counter, "code", ll_invid)
			ll_icode = this.id_detail.object.icode[li_counter]
			ls_alternatealiasname = this.id_detail.object.alternatecustomicode[li_counter]
			SQL SELECT saleprice , RecentPurPrice INTO :ld_saleprice, :ld_recentpurprice FROM item WHERE icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = -1 then
				if lb_isnewinv then
					wf_setnull("Code", lb_isnewinv)
					SQL rollback USING this.it_transobject;
				end if
				messagebox("DataBase Error", "Problem In retrieving Item Information")
				return
			else
				this.id_detail.setitem(li_counter, "saleprice", ld_saleprice)
				this.id_detail.setitem(li_counter, "recentpurprice", ld_recentpurprice)
			end if
			ld_packqty = this.id_detail.getitemnumber(li_counter, "packqty")
			ld_looseqty = this.id_detail.getitemnumber(li_counter, "looseqty")
			ld_bonusqty = this.id_detail.getitemnumber(li_counter, "bonusqty")
			if ld_packqty + ld_looseqty + ld_bonusqty = 0.0 then
				if lb_isnewinv then
					wf_setnull("Code", lb_isnewinv)
					SQL rollback USING this.it_transobject;
				end if
				messagebox("Purchase Qty Validation", "Please enter valid qty")
				if this.ii_purchasetype = 1 then
					this.id_detail.setcolumn("packqty")
				else
					this.id_detail.setcolumn("looseqty")
				end if
				this.id_detail.selecttext(1, 1)
				return
			end if
			li_counter = li_counter + 1
		loop
		if lb_commitflag then
			if wf_prepare_saleorder_from_quicksale() = 0 then
				if this.id_master.update(true, false) < 0 then
					SQL rollback USING this.it_transobject;
					setpointer(arrow!)
					if lb_isnewinv then
						wf_setnull("Code", lb_isnewinv)
					end if
					return
				end if
				if this.id_detail.update() > 0 then
					if wf_update_pur_exp(ll_invid) = 0 then
						if f_stringpreferences("IncPurInActMonitor") = "Y" then
							this.it_transobject.updateactivitymonitor("PV", ll_invid)
							if this.it_transobject.sqlcode <> 0 then
								SQL rollback USING this.it_transobject;
								lb_commitflag = false
								messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
								setpointer(arrow!)
								if lb_isnewinv then
									wf_setnull("Code", lb_isnewinv)
								end if
								return
							else
								lb_commitflag = true
							end if
						end if
					else
						lb_commitflag = false
					end if
					if lb_commitflag then
						SQL commit USING this.it_transobject;
						messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
						this.ib_commitok = true
						gl_lastusercode = ll_salesmancode
						this.id_master.resetupdate()
						this.im_menu.m_file.m_new.enabled = true
						this.editflag = false
						this.ib_advancetax_edited = false
						if gd_recenttransdate < this.id_systemdate then
							gd_recenttransdate = this.id_systemdate
						end if
					else
						SQL rollback USING this.it_transobject;
						lb_commitflag = false
						setpointer(arrow!)
						if lb_isnewinv then
							wf_setnull("Code", lb_isnewinv)
						end if
						return
					end if
				else
					messagebox("Purchase Saving Problem!", "Problem in Purchase Detail Upation.~r~nReasons are:-~r~n" + this.it_transobject.sqlerrtext)
					lb_commitflag = false
					setpointer(arrow!)
					if lb_isnewinv then
						wf_setnull("Code", lb_isnewinv)
					end if
					SQL rollback USING this.it_transobject;
					return
				end if
			else
				messagebox("Purchase Saving Problem!", "Problem in Saving Purchase Invoice~r~nProblem in Preparation of Sales Order From Quick Sale.")
				lb_commitflag = false
				setpointer(arrow!)
				if lb_isnewinv then
					wf_setnull("Code", lb_isnewinv)
				end if
				SQL rollback USING this.it_transobject;
				return
			end if
			return
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_purchase.ue_newform() returns 0 [event]
	integer rtncode
	integer ll_counter
	datetime ldt_server_datetime
	string ls_date_errtext
	m_purchasemenu lm_menu
	call super::ue_newform
	lm_menu = this.menuid
	setredraw(false)
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 528 then
			lm_menu.m_file.m_savepost.enabled = true
		end if
	next
	if (this.ii_purchasetype = 1 or this.ii_purchasetype = 7) and f_stringpreferences("PurBlankSuppOnNewPurInv") = "N" then
		this.id_master.setitem(1, "suppcode", this.idc_supplierlist.getitemnumber(1, "supplier_suppcode"))
	end if
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.ids_purexp.reset()
	wf_assign_sale_objects()
	wf_assign_purexp_object()
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	wf_setgodownoption()
	this.id_footer.object.discperc[1] = 0
	this.id_footer.object.flatdisc[1] = 0
	this.id_footer.object.misccharges[1] = 0
	if this.ii_purchasetype = 2 then
		this.id_master.object.suppcode[this.id_master.getrow()] = this.il_code
	end if
	wf_setcurrency(this.id_master.object.currencycode[1])
	if this.id_detail.rowcount() = 0 then
		this.id_detail.insertrow(0)
	end if
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	setredraw(true)
	this.id_footer.object.t_rpp.text = ""
	this.id_footer.object.t_avgprice.text = ""
	if this.ib_modifydate then
		if this.ib_fetchserverdate then
			wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
			this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
		else
			this.id_master.setitem(this.id_master.getrow(), "date", today())
		end if
	end if
	if not wf_validatedate() then
		close(this)
	end if
	this.id_master.object.advancetax[1] = this.ic_advancetaxonpur
	wf_set_taxcategory(this.id_master.object.taxcategorycode[1])
	this.id_master.object.p_itemimage.filename = ""
	wf_filter_po_itemsonly(-1)
	if this.ii_purchasetype <> 2 then
		this.id_master.object.aliasname.protect = 0
		this.id_master.object.suppcode.protect = 0
	end if
	this.ib_advancetax_edited = false

// w_purchase.ue_detail() returns 0 [event]
	long ll_code
	long ll_counter
	integer li_rtncode
	integer li_protect
	m_purchasemenu lm_menu
	call super::ue_detail
	lm_menu = this.menuid
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	if wf_isinvoiceinuse(ll_code) = true then
		messagebox("Invoice Validation", "Purchase Invoice already in use by some other user.~r~nKindly try again after sometime or open some other invoice.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	this.id_footer.retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	if wf_allowpurchasemodification(ll_code, this.il_groupcode, this.il_strategy) <> 0 then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "You Can not modify this Invoice,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if wf_check_groupsuppliercategory() <> 0 then
		messagebox("Group Wise Supplier Category Validation", "Current user group does not have enough permissions w.r.t supplier.~r~nPossible Reasons are:~r~nSupllier is not allowed to the current user group.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	wf_initmodify(li_protect)
	if li_protect = 0 then
		if not this.ib_normalpurmodify and this.ii_purchasetype = 1 then
			li_protect = 1
		end if
		if not this.ib_loosepurmodify and this.ii_purchasetype = 7 then
			li_protect = 1
		end if
		if not this.ib_loosepurmodify and this.ii_purchasetype <> 1 and this.ii_purchasetype = 7 then
			li_protect = 1
		end if
	end if
	wf_protectdw(this.id_master, li_protect)
	if not isnull(this.id_master.object.pocode[1]) then
		wf_setpurorderinfo(this.id_master.object.pocode[1], 0)
	end if
	if this.id_master.object.associatedsaleordercode[this.id_master.rowcount()] > 0 then
		this.ids_sale_header.retrieve(this.id_master.object.associatedsaleordercode[this.id_master.rowcount()])
		this.ids_sale_detail.retrieve(this.id_master.object.associatedsaleordercode[this.id_master.rowcount()])
		this.ids_sale_footer.retrieve(this.id_master.object.associatedsaleordercode[this.id_master.rowcount()])
	else
		wf_assign_sale_objects()
	end if
	if ll_code > 0 then
		wf_assign_purexp_object()
		this.ids_purexp.retrieve(ll_code)
	end if
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_purchasegodownoption
	end if
	wf_setgodownoption()
	this.im_menu.m_file.m_save.enabled = false
	if li_protect = 0 then
		this.im_menu.m_file.m_save.enabled = true
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 528 then
				lm_menu.m_file.m_savepost.enabled = true
			end if
		next
		if this.ii_purchasetype <> 2 then
			if this.id_master.object.custcode[1] > 0 then
				this.id_master.object.aliasname.protect = 1
				this.id_master.object.suppcode.protect = 1
			else
				this.id_master.object.aliasname.protect = 0
				this.id_master.object.suppcode.protect = 0
			end if
		end if
	end if
	if li_protect = 1 then
		this.editflag = false
		this.id_footer.object.t_rpp.text = ""
		this.id_footer.object.t_avgprice.text = ""
	else
		this.ib_advancetax_edited = true
	end if
	this.im_menu.m_file.m_print.enabled = true
	wf_grandtotal()
	this.id_master.object.p_itemimage.filename = ""
	setredraw(true)

// w_purchase.ue_newitem() returns 0 [event]
	long ll_rowcount
	long ll_currentrow
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 1 and this.il_currrow <= this.id_detail.rowcount() and vf_dwdupcodebatch(this.id_detail, "gcode", gl_defaultgcode, "icode", this.id_detail.getitemnumber(this.id_detail.getrow(), "icode"), "batch", this.id_detail.getitemstring(this.id_detail.getrow(), "batch"), "expiry", this.id_detail.getitemdatetime(this.id_detail.getrow(), "expiry"), this.il_currrow) = true then
		messagebox("Item Validation", "Duplicate item, please select some other item")
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.settransobject(this.it_transobject)
	if f_stringpreferences("enablequickprefferedsearch") = "Y" then
		this.id_detail.setcolumn("quicksearch")
	elseif f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	ll_currentrow = this.id_detail.getrow()
	if ll_currentrow = this.id_detail.rowcount() then
		if f_stringpreferences("AutoSelectLastRowGodownInPur") = "Y" and this.id_detail.rowcount() > 0 then
			this.id_detail.object.gcode.initial = string(this.id_detail.object.gcode[this.id_detail.rowcount()])
		end if
		this.id_detail.insertrow(0)
		ll_rowcount = this.id_detail.rowcount()
		if ll_rowcount > 1 then
			this.id_detail.scrolltorow(ll_rowcount)
			this.id_detail.setfocus()
		end if
	else
		if f_stringpreferences("AutoSelectLastRowGodownInPur") = "Y" and ll_currentrow > 0 then
			this.id_detail.object.gcode.initial = string(this.id_detail.object.gcode[ll_currentrow])
		end if
		this.id_detail.insertrow(ll_currentrow)
		this.id_detail.scrolltorow(ll_currentrow)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_purchase.ue_deleteitem() returns 0 [event]
	long ll_row
	ll_row = this.id_detail.getrow()
	if this.id_detail.rowcount() > 0 then
		call super::ue_deleteitem
		return
	end if
	this.im_menu.m_file.m_print.enabled = false

// w_purchase.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	destroy this.ids_itemstockinfo
	return ::message.returnvalue

// w_purchase.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false
	wf_assign_sale_objects()

// w_purchase.ue_list() returns 0 [event]
	m_purchasemenu lm_menu
	long ll_counter
	call super::ue_list
	lm_menu = this.menuid
	SQL rollback USING this.it_transobject;
	if this.ib_normalpurposting and this.ii_purchasetype = 1 then
		this.im_menu.m_file.m_post.enabled = true
	elseif this.ib_loosepurposting and this.ii_purchasetype = 7 then
		this.im_menu.m_file.m_post.enabled = true
	elseif this.ib_openingpurposting and this.ii_purchasetype = 2 then
		this.im_menu.m_file.m_post.enabled = true
	else
		this.im_menu.m_file.m_post.enabled = false
	end if
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 528 then
			lm_menu.m_file.m_savepost.enabled = false
		end if
	next

// w_purchase.ue_refreshddw() returns 0 [event]
	integer li_rtncode
	datawindowchild ldc_po
	call super::ue_refreshddw
	if this.ii_purchasetype = 1 then
		li_rtncode = this.id_master.getchild("pocode", ldc_po)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
		end if
		ldc_po.settransobject(this.it_transobject)
		ldc_po.retrieve()
		setpointer(hourglass!)
		this.idc_supplierlist.setredraw(false)
		this.idc_supplierlist.settransobject(this.it_transobject)
		this.idc_supplierlist.reset()
		this.idc_supplierlist.retrieve()
		wf_apply_groupsuppliercategory()
		this.idc_supplierlist.setredraw(true)
		setpointer(arrow!)
	end if

// w_purchase.ue_print() returns 0 [event]
	long ll_invcode
	long ll_suppcode
	long ll_row
	string ls_suppname
	string ls_printbalance
	string ls_invoicesize
	boolean lb_listtab
	integer li_printcounter
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if f_stringpreferences("PurchaseAutoPosting") = "Y" then
			wf_saveandpost()
		else
			triggerevent("ue_save")
		end if
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	SQL SELECT purinvpagesize , printcounter INTO :ls_invoicesize, :li_printcounter FROM purledger WHERE purinvcode =:ll_invcode USING this.it_transobject;
	wf_selectprintreport(ls_invoicesize)
	if lb_listtab then
		SQL Select PrintBalance INTO :ls_printbalance From PurLedger Where PurInvCode =:ll_invcode USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Fetch Problem", "Unable to fetch PrintBalance status from database")
			SQL rollback USING this.it_transobject;
			return
		else
			SQL commit USING this.it_transobject;
		end if
		if ls_printbalance = "Y" then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
		end if
	elseif this.id_master.getitemstring(1, "PrintBalance") = "Y" then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
	end if
	if this.il_specialprintout = 0 then
		this.id_print.retrieve(ll_invcode)
	else
		this.id_print.retrieve(ll_invcode, this.il_groupcode)
	end if
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.id_print.rowcount() > 0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		else
			li_printcounter = li_printcounter + 1
			SQL update PurLedger SET printcounter =:li_printcounter WHERE purinvcode =:ll_invcode USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Database Error", "Some database problem has occur")
				SQL rollback USING this.it_transobject;
				return
			else
				SQL commit USING this.it_transobject;
			end if
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_purchase.ue_postopen() returns 0 [event]
	datawindowchild ldc_dddpurcategory
	datawindowchild ldc_headerno
	m_purchasemenu lm_menu
	datastore lds_headers
	integer li_rtncode
	long ll_code
	long ll_counter
	long ll_found
	call super::ue_postopen
	lm_menu = this.menuid
	f_fetch_sites()
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	setredraw(false)
	wf_setpurchasetype(integer(message.doubleparm))
	wf_assign_sale_objects()
	wf_assign_purexp_object()
	this.dw_document.settransobject(this.it_transobject)
	this.id_print = this.dw_purinvrep
	this.id_print.settransobject(this.it_transobject)
	choose case this.ii_purchasetype
	case 1
		this.title = "Pack Purchase"
		wf_assigndatawindowobjects("d_NormalPurchaseHeader", "d_NormalPurchaseDetail", "d_NormalPurchaseList")
		li_rtncode = this.id_master.getchild("suppcode", this.idc_supplierlist)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
		end if
		this.idc_supplierlist.settransobject(this.it_transobject)
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 504 then
				this.ib_normalpurposting = true
