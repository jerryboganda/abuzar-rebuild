// w_purchase.wf_updaterecentpurprice(long al_icode, double ad_rpp) returns integer
	SQL update Item SET recentpurprice5 =recentpurprice4 , recentpurprice4 =recentpurprice3 , recentpurprice3 =recentpurprice2 , recentpurprice2 =recentpurprice , recentpurprice =:ad_rpp , ChangeReason ='Multiple Changes' , Module ='Purchase Posting' WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_purchase.wf_purchaseslip() returns 0
	long ll_invcode
	if this.tab_retrieve.selectedtab = 2 then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
		openwithparm(w_purinv_slip, ll_invcode)
	end if

// w_purchase.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to 1 step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_purchase.wf_saveandpost() returns 0
	integer li_postingmode = 2
	long ll_sinvcode
	long ll_linvcode
	boolean lb_commitflag = true
	event ue_save()
	if this.ib_commitok then
		ll_sinvcode = this.id_master.getitemnumber(1, "code")
		ll_linvcode = this.id_master.getitemnumber(1, "code")
		if isnull(ll_sinvcode) or isnull(ll_linvcode) or ll_sinvcode < 0 and ll_linvcode < 0 then
			return
		else
			lb_commitflag = wf_post_purchase(li_postingmode, ll_sinvcode, ll_linvcode)
		end if
	end if
	setpointer(arrow!)

// w_purchase.wf_post() returns boolean
	integer li_postingmode = 1
	long ll_sinvcode
	long ll_linvcode
	setnull(ll_sinvcode)
	setnull(ll_linvcode)
	return wf_post_purchase(li_postingmode, ll_sinvcode, ll_linvcode)

// w_purchase.wf_grandtotal() returns double
	long ll_counter
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_itemleveltax
	double ld_invgstpercval
	double ld_totalsalestax
	double ld_invgstperc1
	double ld_netrate
	double ld_advincometax
	double ld_discperc
	double ld_flatdisc
	double ld_misccharges
	double ld_salestax
	double ld_itemstotal
	double ld_invlevelvalues
	double ld_discpercvalue
	double ld_grossvalue
	double ld_itemgrossvalue
	double ld_totqty
	double ld_salepriceforitem
	double ld_purexp
	double ld_itemexpenses
	integer li_roundupto
	li_roundupto = f_numberpreferences("roundpurinvon")
	if isnull(li_roundupto) or li_roundupto < 0 then
		li_roundupto = 0
	end if
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		ld_discperc = round(this.id_footer.getitemnumber(1, "discperc"), 2)
		ld_flatdisc = round(this.id_footer.getitemnumber(1, "flatdisc"), 2)
		ld_misccharges = round(this.id_footer.getitemnumber(1, "misccharges"), 2)
		ld_salestax = round(this.id_footer.getitemnumber(1, "salestax"), 2)
		ld_purexp = round(this.id_footer.getitemnumber(1, "TotalExp"), 2)
		ld_advincometax = this.id_detail.getitemnumber(1, "c_totadvancetax")
		if this.ic_advancetaxonpur = "Y" then
			if this.id_master.object.posted[1] = "N" then
				if this.ib_advancetax_edited = true then
					ld_advincometax = this.id_footer.object.advancetaxamt[1]
				end if
				ld_misccharges = ld_advincometax + this.id_footer.object.misccharges1[1] + this.id_footer.object.misccharges2[1] + this.id_footer.object.misccharges3[1] + this.id_footer.object.misccharges4[1] + this.id_footer.object.misccharges5[1]
				this.id_footer.object.misccharges[1] = ld_advincometax + this.id_footer.object.misccharges1[1] + this.id_footer.object.misccharges2[1] + this.id_footer.object.misccharges3[1] + this.id_footer.object.misccharges4[1] + this.id_footer.object.misccharges5[1]
				this.id_footer.object.advancetaxamt[1] = ld_advincometax
			else
				ld_misccharges = this.id_footer.object.misccharges[1]
			end if
		else
			ld_misccharges = this.id_footer.object.misccharges1[1] + this.id_footer.object.misccharges2[1] + this.id_footer.object.misccharges3[1] + this.id_footer.object.misccharges4[1] + this.id_footer.object.misccharges5[1]
			this.id_footer.object.advancetaxamt[1] = 0.00
		end if
		if isnull(ld_discperc) then
			ld_discperc = 0.00
		end if
		if isnull(ld_flatdisc) then
			ld_flatdisc = 0.00
		end if
		if isnull(ld_misccharges) then
			ld_misccharges = 0.00
		end if
		if isnull(ld_salestax) then
			ld_salestax = 0.00
		end if
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "d_detaildwtotal")
		ld_invgstperc1 = this.id_footer.getitemnumber(1, "invgstperc1")
		ld_itemleveltax = this.id_detail.object.c_sumtaxval[1] + this.id_detail.object.c_sumgstval[1]
		ld_invgstpercval = round((round(ld_detaildwtotal * (1.0 - 0.01 * ld_discperc), 2) - ld_flatdisc) * 0.01 * ld_invgstperc1, 2)
		ld_discpercvalue = round(ld_detaildwtotal * ld_discperc * 0.01, 5)
		ld_totalsalestax = round(ld_invgstpercval + ld_itemleveltax, li_roundupto)
		ld_grandtotal = ld_detaildwtotal * (1.0 - ld_discperc * 0.01) - ld_flatdisc + ld_misccharges + ld_salestax
		ld_grandtotal = round(ld_grandtotal, li_roundupto) + ld_totalsalestax
		this.id_footer.setitem(1, "total", ld_grandtotal)
		ld_detaildwtotal = this.id_footer.getitemnumber(1, "total")
		ld_invlevelvalues = ld_purexp + ld_invgstpercval + ld_misccharges - ld_flatdisc - ld_discpercvalue
		if ld_invlevelvalues = 0.0 or isnull(ld_invlevelvalues) then
			ld_invlevelvalues = 0
		end if
		ld_grossvalue = this.id_detail.object.c_total_finalitemval[1]
		if ld_grossvalue = 0.0 or isnull(ld_grossvalue) then
			ld_grossvalue = 1
		end if
		if f_stringpreferences("ShowNetRateInPurchase") = "Y" then
		end if
	end if
	return ld_grandtotal

// w_purchase.wf_allowpurchasemodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM PurDetail WHERE PurInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_purchase.wf_printbarcode() returns 0
	s_datawindow lstr_arg
	string ls_datawindow
	datastore lds_detail
	lds_detail = create datastore
	lds_detail.dataobject = this.id_detail.dataobject
	lds_detail.settransobject(this.it_transobject)
	if this.id_detail.rowcount() > 0 then
		this.id_detail.rowscopy(1, this.id_detail.rowcount(), primary!, lds_detail, 1, primary!)
	end if
	lstr_arg.l_code2 = this.id_master.getitemnumber(1, "purcatcode")
	if this.tab_retrieve.selectedtab = 1 then
		lstr_arg.dws = lds_detail
		lstr_arg.l_code = this.ii_purchasetype
		lstr_arg.l_code3 = 1
		openwithparm(w_barcodelabels_popup, lstr_arg)
	end if

// w_purchase.wf_grandtotal_with_update_netrate() returns double
	long ll_counter
	integer li_roundupto
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_itemleveltax
	double ld_invgstpercval
	double ld_totalsalestax
	double ld_invgstperc1
	double ld_netrate
	double ld_advincometax
	double ld_discperc
	double ld_flatdisc
	double ld_misccharges
	double ld_salestax
	double ld_itemstotal
	double ld_invlevelvalues
	double ld_discpercvalue
	double ld_grossvalue
	double ld_itemgrossvalue
	double ld_totqty
	double ld_purexp
	double ld_itemexpenses
	char lc_updateavgpricewithnetrate
	lc_updateavgpricewithnetrate = this.id_master.object.updateavgpricewithnetrate[1]
	if lc_updateavgpricewithnetrate = "" or isnull(lc_updateavgpricewithnetrate) then
		lc_updateavgpricewithnetrate = "N"
	end if
	li_roundupto = f_numberpreferences("roundpurinvon")
	if isnull(li_roundupto) or li_roundupto < 0 then
		li_roundupto = 0
	end if
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		ld_discperc = round(this.id_footer.getitemnumber(1, "discperc"), 2)
		ld_flatdisc = round(this.id_footer.getitemnumber(1, "flatdisc"), 2)
		ld_misccharges = round(this.id_footer.getitemnumber(1, "misccharges"), 2)
		ld_salestax = round(this.id_footer.getitemnumber(1, "salestax"), 2)
		ld_purexp = round(this.id_footer.getitemnumber(1, "TotalExp"), 2)
		ld_advincometax = this.id_detail.getitemnumber(1, "c_totadvancetax")
		if isnull(ld_discperc) then
			ld_discperc = 0.00
		end if
		if isnull(ld_flatdisc) then
			ld_flatdisc = 0.00
		end if
		if isnull(ld_misccharges) then
			ld_misccharges = 0.00
		end if
		if isnull(ld_salestax) then
			ld_salestax = 0.00
		end if
		if isnull(ld_purexp) then
			ld_purexp = 0.00
		end if
		if this.ic_advancetaxonpur = "Y" then
			if this.id_master.object.posted[1] = "N" then
				if this.ib_advancetax_edited = true then
					ld_advincometax = this.id_footer.object.advancetaxamt[1]
				end if
				ld_misccharges = ld_advincometax + this.id_footer.object.misccharges1[1] + this.id_footer.object.misccharges2[1] + this.id_footer.object.misccharges3[1] + this.id_footer.object.misccharges4[1] + this.id_footer.object.misccharges5[1]
				this.id_footer.object.misccharges[1] = ld_advincometax + this.id_footer.object.misccharges1[1] + this.id_footer.object.misccharges2[1] + this.id_footer.object.misccharges3[1] + this.id_footer.object.misccharges4[1] + this.id_footer.object.misccharges5[1]
				this.id_footer.object.advancetaxamt[1] = ld_advincometax
			else
				ld_misccharges = this.id_footer.object.misccharges[1]
			end if
		else
			ld_misccharges = this.id_footer.object.misccharges1[1] + this.id_footer.object.misccharges2[1] + this.id_footer.object.misccharges3[1] + this.id_footer.object.misccharges4[1] + this.id_footer.object.misccharges5[1]
			this.id_footer.object.advancetaxamt[1] = 0.00
		end if
		if isnull(ld_misccharges) then
			ld_misccharges = 0.00
		end if
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "d_detaildwtotal")
		ld_invgstperc1 = this.id_footer.getitemnumber(1, "invgstperc1")
		ld_itemleveltax = this.id_detail.object.c_sumtaxval[1] + this.id_detail.object.c_sumgstval[1]
		ld_invgstpercval = round((round(ld_detaildwtotal * (1.0 - 0.01 * ld_discperc), 2) - ld_flatdisc) * 0.01 * ld_invgstperc1, 2)
		ld_discpercvalue = round(ld_detaildwtotal * ld_discperc * 0.01, 5)
		ld_totalsalestax = round(ld_invgstpercval + ld_itemleveltax, li_roundupto)
		ld_grandtotal = ld_detaildwtotal * (1.0 - ld_discperc * 0.01) - ld_flatdisc + ld_misccharges + ld_salestax
		ld_grandtotal = round(ld_grandtotal, li_roundupto) + ld_totalsalestax
		this.id_footer.setitem(1, "total", ld_grandtotal)
		ld_detaildwtotal = this.id_footer.getitemnumber(1, "total")
		if this.ic_advancetaxonpur = "Y" and ld_advincometax > 0.0 then
			ld_invlevelvalues = ld_purexp + ld_invgstpercval + ld_misccharges - ld_advincometax - ld_flatdisc - ld_discpercvalue
		else
			ld_invlevelvalues = ld_purexp + ld_invgstpercval + ld_misccharges - ld_flatdisc - ld_discpercvalue
		end if
		if ld_invlevelvalues = 0.0 or isnull(ld_invlevelvalues) then
			ld_invlevelvalues = 0
		end if
		ld_grossvalue = this.id_detail.object.c_total_finalitemval[1]
		if ld_grossvalue = 0.0 or isnull(ld_grossvalue) then
			ld_grossvalue = 1
		end if
		for ll_counter = 1 to this.id_detail.rowcount()
			ld_totqty = this.id_detail.object.looseqty[ll_counter] + this.id_detail.object.packqty[ll_counter] + this.id_detail.object.bonusqty[ll_counter]
			if ld_totqty = 0.0 or isnull(ld_totqty) then
				ld_totqty = 1
			end if
			if this.ii_purchasetype = 1 then
				ld_itemexpenses = this.id_detail.object.c_itemexpenses[ll_counter]
			end if
			if ld_itemexpenses <= 0.0 or isnull(ld_itemexpenses) then
				ld_itemexpenses = 0
			end if
			ld_itemgrossvalue = this.id_detail.object.c_finalitemval[ll_counter]
			ld_netrate = (ld_itemgrossvalue / ld_grossvalue * ld_invlevelvalues + ld_itemgrossvalue + ld_itemexpenses) / ld_totqty
			this.id_detail.object.netrate[ll_counter] = round(ld_netrate, 5)
		next
	end if
	return ld_grandtotal

// w_purchase.wf_searchitem_quicksearch(string as_str) returns long
	long ll_found
	long ll_code
	long ll_listcurrrow
	long rt_code = 1
	long ll_row
	long ll_icode
	integer li_errcode
	string ls_errtext
	if as_str = "" or isnull(as_str) then
		rt_code = 0
	else
		ll_code = f_searchitem_quicksearch(as_str, this.it_transobject)
		if ll_code > 0 then
			ll_found = this.id_itemslist.find("icode = " + string(ll_code), 1, this.id_itemslist.rowcount())
			if ll_found > 0 then
				ll_listcurrrow = ll_found
				this.id_itemslist.selectrow(0, false)
				ll_row = this.id_detail.getrow()
				ll_icode = ll_code
				wf_inititeminfo(ll_icode, ll_row, ls_errtext)
				if this.il_currrow > 0 then
					this.id_itemslist.selectrow(this.il_currrow, false)
				end if
				this.id_itemslist.selectrow(ll_listcurrrow, true)
				this.id_detail.setitem(this.id_detail.getrow(), this.is_columnitemname, this.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				this.id_detail.setitem(this.id_detail.getrow(), "icode", this.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				this.id_detail.setitem(this.id_detail.getrow(), "fullcode", this.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
				this.ib_itemvalidated = false
				this.il_currrow = this.id_detail.getrow()
				this.id_detail.setitem(this.id_detail.getrow(), "CurrListRow", ll_listcurrrow)
				rt_code = 0
			end if
		end if
	end if
	return rt_code

// w_purchase.wf_itemstockinfo(long al_icode, long al_gcode, double ad_stock) returns boolean
	boolean retflag = true
	double ld_stock
	double ld_totalstock
	ad_stock = 100
	return retflag

// w_purchase.wf_setpurorderqty(transaction at_transobject, long al_pocode, long al_icode, long al_qtysatisfied, long al_bonusqtysatisfied) returns integer
	SQL update purorderdetail Set qtysatisfied =qtysatisfied + :al_qtysatisfied , bonusqtysatisfied =bonusqtysatisfied + :al_bonusqtysatisfied Where purorderdetail.pocode =:al_pocode and purorderdetail.icode =:al_icode USING at_transobject;
	return at_transobject.sqlcode

// w_purchase.wf_updateitemstock(long al_icode, long al_gcode, double ad_newstock) returns boolean
	boolean retflag = true
	SQL update godowndetail SET godowndetail.currqty =:ad_newstock WHERE godowndetail.gcode =:al_gcode AND godowndetail.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_purchase.wf_setiteminfo(long al_icode, long al_row, long ad_gcode, double ad_saleprice, double ad_discperc, double ad_stock) returns 0
	this.id_detail.setitem(al_row, "gcode", ad_gcode)
	this.id_detail.setitem(al_row, "purprice", ad_saleprice)
	this.id_detail.setitem(al_row, "discperc", ad_discperc)
	this.id_footer.object.stock[this.id_footer.getrow()] = ad_stock

// w_purchase.wf_set_itemtotal_formatmask() returns long
	string ls_modify
	string ls_format
	ls_format = trim(f_stringpreferences("FormatForAmtInPur"))
	this.id_detail.object.valueextax.editmask.mask = ls_format
	ls_modify = "valueextax.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_total.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "d_detaildwtotal.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_finalitemval.Format='" + ls_format + "'  "
	ls_modify = ls_modify + "c_total_finalitemval.Format='" + ls_format + "'  "
	this.id_detail.modify(ls_modify)
	return 0

// w_purchase.wf_view_iteminfo() returns 0
	long ll_code
	if this.tab_retrieve.selectedtab = 2 then
		return
	end if
	if this.id_detail.rowcount() > 0 and this.id_detail.getrow() > 0 then
		ll_code = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		if ll_code > 0 and not isnull(ll_code) then
			openwithparm(w_iteminfo, ll_code)
		end if
	end if

// w_purchase.wf_getsupplierinfo() returns 0
	long ll_suppcode
	if this.id_master = getfocus() and this.id_master.rowcount() > 0 then
		ll_suppcode = this.id_master.getitemnumber(this.id_master.getrow(), "suppcode")
		openwithparm(w_supplierinfo, ll_suppcode)
	end if

// w_purchase.wf_show_po_pur_disparity(integer ai_mode) returns long
	long ll_detailrows
	long ll_pocode
	long ll_masterrow
	long ll_count
	long ll_found
	long ll_retcode
	long ll_result = 1
	long ll_icode
	long[] ll_invcode
	datastore lds_po_disparity
	s_datastore lstr
	lds_po_disparity = create datastore
	lds_po_disparity.dataobject = "d_po_purchase_disparity"
	lds_po_disparity.settransobject(sqlca)
	if this.tab_retrieve.selectedtab = 2 then
		return ll_retcode
	end if
	ll_detailrows = this.id_detail.rowcount()
	ll_masterrow = this.id_master.rowcount()
	if ll_detailrows > 0 and ll_masterrow > 0 then
		ll_pocode = this.id_master.object.pocode[ll_masterrow]
		if isnull(ll_pocode) then
			ll_pocode = long(this.id_master.object.newpurchaseorderno[1])
		end if
		if isnull(ll_pocode) then
			return ll_retcode
		else
			if ai_mode = 1 and f_stringpreferences("showpodisparityonpursaving") = "N" then
				return 0
			end if
			ll_invcode[1] = ll_pocode
			lds_po_disparity.retrieve(ll_invcode, this.id_master.object.date[1], this.id_master.object.date[1])
			for ll_count = 1 to this.id_detail.rowcount()
				ll_icode = this.id_detail.object.icode[ll_count]
				if ll_icode > 0 then
					ll_found = lds_po_disparity.find("icode=" + trim(string(ll_icode)), 1, lds_po_disparity.rowcount())
					if ll_found = 0 then
						ll_found = lds_po_disparity.insertrow(0)
						lds_po_disparity.object.pocode[ll_found] = ll_pocode
						lds_po_disparity.object.date[ll_found] = lds_po_disparity.object.date[1]
						lds_po_disparity.object.remarks[ll_found] = lds_po_disparity.object.remarks[1]
						lds_po_disparity.object.suppcode[ll_found] = lds_po_disparity.object.suppcode[1]
						lds_po_disparity.object.supplieraliasname[ll_found] = lds_po_disparity.object.supplieraliasname[1]
						lds_po_disparity.object.suppliername[ll_found] = lds_po_disparity.object.suppliername[1]
						lds_po_disparity.object.icode[ll_found] = this.id_detail.object.icode[ll_count]
						lds_po_disparity.object.itemaliasname[ll_found] = this.id_detail.object.fullcode[ll_count]
						lds_po_disparity.object.itemname[ll_found] = this.id_detail.object.itemname[ll_count]
						lds_po_disparity.object.manufacturer[ll_found] = ""
						lds_po_disparity.object.poqty[ll_found] = 0
						lds_po_disparity.object.pobonus[ll_found] = 0
						if this.ii_purchasetype = 1 then
							lds_po_disparity.object.purqty[ll_found] = this.id_detail.object.packqty[ll_count]
							lds_po_disparity.object.netqty[ll_found] = -this.id_detail.object.packqty[ll_count]
						else
							lds_po_disparity.object.purqty[ll_found] = this.id_detail.object.looseqty[ll_count]
							lds_po_disparity.object.netqty[ll_found] = -this.id_detail.object.looseqty[ll_count]
						end if
						lds_po_disparity.object.purbonus[ll_found] = this.id_detail.object.bonusqty[ll_count]
						lds_po_disparity.object.netbonus[ll_found] = -this.id_detail.object.bonusqty[ll_count]
					else
						if this.ii_purchasetype = 1 then
							lds_po_disparity.object.purqty[ll_found] = lds_po_disparity.object.purqty[ll_found] + this.id_detail.object.packqty[ll_count]
						else
							lds_po_disparity.object.purqty[ll_found] = lds_po_disparity.object.purqty[ll_found] + this.id_detail.object.looseqty[ll_count]
						end if
						lds_po_disparity.object.purbonus[ll_found] = lds_po_disparity.object.purbonus[ll_found] + this.id_detail.object.bonusqty[ll_count]
						lds_po_disparity.object.netqty[ll_found] = lds_po_disparity.object.poqty[ll_found] - lds_po_disparity.object.purqty[ll_found]
						lds_po_disparity.object.netbonus[ll_found] = lds_po_disparity.object.pobonus[ll_found] - lds_po_disparity.object.purbonus[ll_found]
					end if
				end if
			next
			lds_po_disparity.setfilter("netqty <> 0 OR netbonus <> 0")
			lds_po_disparity.filter()
			lds_po_disparity.sort()
			lds_po_disparity.groupcalc()
			if lds_po_disparity.rowcount() > 0 then
				lstr.ds = lds_po_disparity
				lstr.s_name1 = "d_po_purchase_disparity"
				openwithparm(w_preview_invoices, lstr)
				lstr = message.powerobjectparm
				if ai_mode = 1 then
					ll_result = messagebox("P/O Based Purchase Disparity Checking", "P/O Based Purchase Disparity Checking Detected some Disparities~r~nContinue Saving?", question!, yesno!, 1)
					if ll_result = 1 then
						ll_retcode = 0
					else
						ll_retcode = 1
					end if
				end if
			end if
		end if
	end if
	destroy lds_po_disparity
	return ll_retcode

// w_purchase.wf_assign_sale_objects() returns long
	this.ids_sale_header = create u_ds_standard
	this.ids_sale_header.dataobject = "d_saleinpurchase_header"
	this.ids_sale_header.settransobject(this.it_transobject)
	this.ids_sale_detail = create u_ds_standard
	this.ids_sale_detail.dataobject = "d_saleinpurchase_detail"
	this.ids_sale_detail.settransobject(this.it_transobject)
	this.ids_sale_footer = create u_ds_standard
	this.ids_sale_footer.dataobject = "d_saleinpurchase_footer"
	this.ids_sale_footer.settransobject(this.it_transobject)
	this.ids_sale_header.insertrow(0)
	this.ids_sale_footer.insertrow(0)
	return 0

// w_purchase.wf_show_saleinpurchase() returns 0
	s_datastore lstr_ds
	s_datastore lstr_ds2
	if this.tab_retrieve.selectedtab = 2 then
		return
	end if
	if this.id_detail.rowcount() <= 0 then
		return
	end if
	if this.tab_retrieve.selectedtab = 1 then
		lstr_ds.i_protect = integer(this.id_detail.object.itemname.protect)
		lstr_ds.dw = this.id_detail
		lstr_ds.ds1 = this.ids_sale_header
		lstr_ds.ds2 = this.ids_sale_detail
		lstr_ds.ds3 = this.ids_sale_footer
		lstr_ds.s_name1 = this.id_master.object.suppinvcode[this.id_master.rowcount()]
		lstr_ds.s_name2 = this.id_master.object.grn[this.id_master.rowcount()]
		lstr_ds.s_name3 = trim(string(this.id_master.object.gccode[this.id_master.rowcount()]))
		lstr_ds.s_name4 = this.id_master.object.vehicle[this.id_master.rowcount()]
		lstr_ds.s_name5 = this.id_master.object.shipto[this.id_master.rowcount()]
		lstr_ds.s_name6 = this.id_master.object.remarks[this.id_master.rowcount()]
		if this.ids_sale_detail.rowcount() = 0 and lstr_ds.i_protect = 1 then
			return
		end if
		openwithparm(w_saleinpurchase, lstr_ds)
		lstr_ds2 = message.powerobjectparm
		if lstr_ds2.i_closemode = 1 then
			lstr_ds = lstr_ds2
			this.ids_sale_header = lstr_ds2.ds1
			this.ids_sale_detail = lstr_ds2.ds2
			this.ids_sale_footer = lstr_ds2.ds3
		end if
	end if

// w_purchase.wf_prepare_saleorder_from_quicksale() returns long
	long ll_associatedsaleordercode
	long ll_counter
	long ll_status1
	long ll_status2
	long ll_mastercurrrow
	long ll_footercurrrow
	ll_mastercurrrow = this.id_master.rowcount()
	ll_footercurrrow = this.ids_sale_footer.rowcount()
	if this.ids_sale_header.rowcount() > 0 and this.ids_sale_detail.rowcount() > 0 and this.ids_sale_footer.rowcount() > 0 and not isnull(this.ids_sale_detail.object.icode[1]) then
		ll_associatedsaleordercode = this.id_master.object.associatedsaleordercode[this.id_master.rowcount()]
		if isnull(ll_associatedsaleordercode) or ll_associatedsaleordercode = 0 then
			f_newtableid("saleorderheader", ll_associatedsaleordercode)
		else
			SQL DELETE SaleOrderDetail WHERE SaleOrderCode =:ll_associatedsaleordercode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				SQL DELETE SaleOrderHeader WHERE SaleOrderCode =:ll_associatedsaleordercode USING this.it_transobject;
				if this.it_transobject.sqlcode <> 0 then
					SQL rollback USING this.it_transobject;
					return -1
				end if
			else
				SQL rollback USING this.it_transobject;
				return -1
			end if
		end if
		this.ids_sale_header.object.usercode[1] = this.id_master.object.salesmancode[ll_mastercurrrow]
		this.ids_sale_header.object.discperc[1] = this.ids_sale_footer.object.discperc[ll_footercurrrow]
		this.ids_sale_header.object.flatdisc[1] = this.ids_sale_footer.object.flatdisc[ll_footercurrrow]
		this.ids_sale_header.object.misccharges[1] = this.ids_sale_footer.object.misccharges[ll_footercurrrow]
		this.ids_sale_header.object.invgstperc1[1] = this.ids_sale_footer.object.invgstperc1[ll_footercurrrow]
		this.ids_sale_header.object.invtotal[1] = this.ids_sale_footer.object.total[ll_footercurrrow]
		this.ids_sale_header.object.code[1] = ll_associatedsaleordercode
		this.ids_sale_header.object.suppinvcode[1] = this.id_master.object.suppinvcode[ll_mastercurrrow]
		this.ids_sale_header.object.grn[1] = this.id_master.object.grn[ll_mastercurrrow]
		this.ids_sale_header.object.gccode[1] = this.id_master.object.gccode[ll_mastercurrrow]
		this.ids_sale_header.object.vehicle[1] = this.id_master.object.vehicle[ll_mastercurrrow]
		this.ids_sale_header.object.shipto[1] = this.id_master.object.shipto[ll_mastercurrrow]
		this.ids_sale_header.object.remarks[1] = this.id_master.object.remarks[ll_mastercurrrow]
		this.ids_sale_header.object.machinename[1] = gs_localcomputername
		this.ids_sale_header.object.posted[1] = "N"
		this.ids_sale_header.object.postdate[1] = this.ids_sale_header.object.date[ll_mastercurrrow]
		this.ids_sale_header.setitemstatus(1, 0, primary!, newmodified!)
		for ll_counter = 1 to this.ids_sale_detail.rowcount()
			this.ids_sale_detail.object.code[ll_counter] = ll_associatedsaleordercode
			if ll_counter <= this.id_detail.rowcount() then
				if this.ii_purchasetype = 1 then
					this.ids_sale_detail.object.looseqty[ll_counter] = this.id_detail.object.packqty[ll_counter] * this.id_detail.object.packunits[ll_counter]
					this.ids_sale_detail.object.bonusqty[ll_counter] = this.id_detail.object.bonusqty[ll_counter] * this.id_detail.object.packunits[ll_counter]
				else
					this.ids_sale_detail.object.looseqty[ll_counter] = this.id_detail.object.looseqty[ll_counter]
					this.ids_sale_detail.object.bonusqty[ll_counter] = this.id_detail.object.bonusqty[ll_counter]
				end if
			end if
			this.ids_sale_detail.setitemstatus(ll_counter, 0, primary!, newmodified!)
		next
		if this.ids_sale_header.update() > 0 then
			if this.ids_sale_detail.update() <= 0 then
				return -1
			end if
		else
			return -1
		end if
		this.id_master.object.associatedsaleordercode[this.id_master.rowcount()] = ll_associatedsaleordercode
	end if
	return 0

// w_purchase.wf_populate_saleorder() returns long
	datastore lds_saleorderdetail
	datastore lds_saleorderheader
	s_saletemplate lstr_template
	boolean lb_enablesave
	boolean lb_insertrow
	integer li_retcode = 1
	integer li_errcode
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_counter
	long ll_tmprowid
	long ll_tmpcode
	long ll_icode
	long ll_packunits
	datetime ldt_date
	string ls_errortext
	string ls_batch
	string ls_class
	if wf_iseditable() = false then
		return 0
	end if
	lds_saleorderdetail = create datastore
	lds_saleorderheader = create datastore
	open(w_editsaleorder_in_purchase_form)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_saleorderdetail.dataobject = "d_saleorderdetail_retrieve_purchase"
		lds_saleorderdetail.settransobject(this.it_transobject)
		lds_saleorderheader.dataobject = "d_SaleOrderheader"
		lds_saleorderheader.settransobject(this.it_transobject)
		ll_row = lds_saleorderheader.retrieve(lstr_template.l_invtemplate)
		if ll_row <= 0 then
			li_retcode = -1
			return li_retcode
		else
			ll_mrow = this.id_master.getrow()
			this.id_master.setitem(ll_mrow, "remarks", lds_saleorderheader.getitemstring(lds_saleorderheader.getrow(), "remarks"))
			this.id_master.setitem(ll_mrow, "headerno", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "headerno"))
			this.id_footer.setitem(ll_mrow, "misccharges", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "misccharges"))
			this.id_footer.setitem(ll_mrow, "flatdisc", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "flatdisc"))
			this.id_footer.setitem(ll_mrow, "discperc", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "discperc"))
			ldt_date = lds_saleorderheader.getitemdatetime(lds_saleorderheader.getrow(), "date")
			lds_saleorderdetail.retrieve(lstr_template.l_invtemplate, 0)
		end if
		ll_totalrows = lds_saleorderdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		if lb_enablesave then
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
			this.id_detail.reset()
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				ll_rowcount = this.id_detail.insertrow(0)
				ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_saleorderdetail.getitemnumber(ll_counter, "gcode")), 1, this.idc_godown.rowcount())
				ll_icode = lds_saleorderdetail.getitemnumber(ll_counter, "icode")
				if wf_inititeminfo(ll_icode, ll_rowcount, ls_errortext) then
					ll_packunits = this.id_detail.object.packunits[ll_rowcount]
					if ll_packunits = 0 or isnull(ll_packunits) then
						ll_packunits = 1
					end if
					ll_gcode = lds_saleorderdetail.getitemnumber(ll_counter, "gcode")
					if lstr_template.i_invtype = 0 then
						this.id_detail.object.batch[ll_rowcount] = f_stringpreferences("defaultbatch")
					elseif lstr_template.i_invtype = 1 then
						SQL SELECT NAME INTO :ls_class FROM DBO.ItemClass WHERE ICCode IN ( SELECT ICCode FROM Item WHERE ICode =:ll_icode ) USING this.it_transobject;
						ll_tmpcode = lds_saleorderdetail.getitemnumber(ll_counter, "code")
						ls_batch = trim(string(ll_tmpcode)) + trim(string(ll_icode)) + ls_class
						this.id_detail.object.batch[ll_rowcount] = left(ls_batch, 10)
					elseif lstr_template.i_invtype = 2 then
						this.id_detail.object.batch[ll_rowcount] = lds_saleorderdetail.object.batch[ll_counter]
					end if
					this.id_detail.object.expiry[ll_rowcount] = lstr_template.d_date
					this.id_detail.setitem(ll_rowcount, "gcode", ll_gcode)
					this.id_detail.setitem(ll_rowcount, "discperc", lds_saleorderdetail.getitemnumber(ll_counter, "discperc"))
					if this.ii_purchasetype = 1 then
						this.id_detail.setitem(ll_rowcount, "packqty", ceiling(lds_saleorderdetail.getitemnumber(ll_counter, "looseqty") / ll_packunits))
						this.id_detail.setitem(ll_rowcount, "bonusqty", ceiling(lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty") / ll_packunits))
					else
						this.id_detail.setitem(ll_rowcount, "looseqty", lds_saleorderdetail.getitemnumber(ll_counter, "looseqty"))
						this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty"))
					end if
				end if
				wf_update_value_extax(ll_rowcount, this.id_detail.object.looseqty[ll_rowcount] + this.id_detail.object.packqty[ll_rowcount], this.id_detail.object.purprice[ll_rowcount], this.id_detail.object.discperc[ll_rowcount])
			next
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return li_retcode

// w_purchase.wf_update_value_extax(long al_row, double ad_qty, double ad_price, double ad_discperc) returns long
	if al_row > 0 then
		this.id_detail.object.valueextax[al_row] = ad_qty * ad_price * (1.0 - ad_discperc * 0.01)
	end if
	return 0

// w_purchase.wf_editpostedinvoice() returns 0
	long ll_code
	string ls_specialright
	s_invdetail lstr_invdetail
	ls_specialright = "3"
	if gl_usercode <> 1 then
		return
	end if
	if this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
	end if
	if ll_code > 0 and this.id_list.object.posted[this.id_list.getrow()] = "Y" then
		if f_is_specialright_enabled(ls_specialright) then
			openwithparm(w_special_rights_password, ls_specialright)
			if message.doubleparm > 0.0 then
				lstr_invdetail.i_module = this.ii_module
				lstr_invdetail.l_invcode = ll_code
				openwithparm(w_editpostedinvoice, lstr_invdetail)
			else
				return
			end if
		else
			return
		end if
		return
	end if

// w_purchase.wf_setnull(string as_column, boolean as_isnewinv) returns integer
	long ll_null
	setnull(ll_null)
	this.id_master.setitem(1, as_column, ll_null)
	return 1

// w_purchase.wf_populate_pendingdueitems() returns long
	datastore lds_duedetail
	s_arguements lstr_arg
	boolean lb_enablesave
	boolean lb_insertrow
	integer li_retcode = 1
	integer li_errcode
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_counter
	long ll_tmprowid
	long ll_tmpcode
	long ll_icode
	long ll_packunits
	datetime ldt_date
	string ls_errortext
	string ls_batch
	string ls_class
	if wf_iseditable() = false then
		return 0
	end if
	lds_duedetail = create datastore
	open(w_arg_sdate_ldate)
	lstr_arg = message.powerobjectparm
	if 1 = 1 then
		lds_duedetail.dataobject = "d_purchase_pendingdueitems"
		lds_duedetail.settransobject(this.it_transobject)
		lds_duedetail.retrieve(lstr_arg.d_sdate, lstr_arg.d_edate)
		ll_totalrows = lds_duedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		this.id_detail.setredraw(false)
		if lb_enablesave then
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
			this.id_detail.reset()
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				ll_rowcount = this.id_detail.insertrow(0)
				ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_duedetail.getitemnumber(ll_counter, "gcode")), 1, this.idc_godown.rowcount())
				ll_icode = lds_duedetail.getitemnumber(ll_counter, "icode")
				if wf_inititeminfo(ll_icode, ll_rowcount, ls_errortext) then
					ll_packunits = this.id_detail.object.packunits[ll_rowcount]
					if ll_packunits = 0 or isnull(ll_packunits) then
						ll_packunits = 1
					end if
					ll_gcode = lds_duedetail.getitemnumber(ll_counter, "gcode")
					this.id_detail.object.batch[ll_rowcount] = f_stringpreferences("defaultbatch")
					this.id_detail.object.gcode[ll_rowcount] = ll_gcode
					if this.ii_purchasetype = 1 then
						this.id_detail.object.packqty[ll_rowcount] = ceiling(lds_duedetail.object.qty[ll_counter] / ll_packunits)
						this.id_detail.object.bonusqty[ll_rowcount] = 0
					else
						this.id_detail.object.looseqty[ll_rowcount] = lds_duedetail.object.qty[ll_counter]
						this.id_detail.object.bonusqty[ll_rowcount] = 0
					end if
				end if
				wf_update_value_extax(ll_rowcount, this.id_detail.object.looseqty[ll_rowcount] + this.id_detail.object.packqty[ll_rowcount], this.id_detail.object.purprice[ll_rowcount], this.id_detail.object.discperc[ll_rowcount])
			next
		end if
		this.id_detail.setredraw(true)
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return li_retcode

// w_purchase.wf_updatemanfcode(long al_icode, long al_manfcode) returns integer
	SQL update Item SET manfcode =:al_manfcode WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_purchase.wf_populate_purinvoice() returns long
	datastore lds_purdetail
	datastore lds_purheader
	s_saletemplate lstr_template
	datawindowchild ldc_godown
	long ll_detailrows
	long ll_count
	long ll_null
	integer li_result
	integer li_retcode
	boolean populateflag = true
	string ls_errortext
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_stock
	long ll_packunits
	double ld_godownstock
	double ld_allgodownstock
	double ld_purqty
	double ld_purbonus
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_salestax
	double ld_gstperc
	string ls_fullcode
	setnull(ll_null)
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate Purchase invoice after posting!")
		return 0
	end if
	open(w_copypurfrom)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		destroy lds_purdetail
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 and not isnull(this.id_detail.object.icode[1]) then
		li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
		if li_result = 1 then
			for ll_count = 1 to ll_detailrows
				this.id_detail.deleterow(0)
			next
			if this.id_detail.update() <> 1 then
				messagebox("DataBase Problem", "Problem in Deleting Rows")
				return 0
			end if
			this.id_detail.reset()
		else
			populateflag = false
		end if
	end if
	if populateflag = true and lstr_template.c_copyinvfrom = "P" then
		lds_purdetail = create datastore
		lds_purheader = create datastore
		lds_purheader.dataobject = "d_normalpurchaseheader"
		if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
			lds_purdetail.dataobject = "d_normalpurchasedetail"
		else
			lds_purdetail.dataobject = "d_loosepurchasedetail"
		end if
		lds_purheader.settransobject(this.it_transobject)
		lds_purdetail.settransobject(this.it_transobject)
		lds_purheader.retrieve(lstr_template.l_invtemplate)
		li_retcode = lds_purdetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
		lds_purdetail.retrieve(lstr_template.l_invtemplate)
		ll_detailrows = lds_purdetail.rowcount()
		if ll_detailrows < 0 then
			li_retcode = -1
		end if
		if this.id_master.rowcount() > 0 and lds_purheader.rowcount() > 0 then
			this.id_master.object.purtypecode[1] = lds_purheader.object.purtypecode[1]
			this.id_master.object.suppcode[1] = lds_purheader.object.suppcode[1]
			this.id_master.object.suppinvcode[1] = lds_purheader.object.suppinvcode[1]
			this.id_master.object.suppinvdate[1] = lds_purheader.object.suppinvdate[1]
			this.id_master.object.purinvpagesize[1] = lds_purheader.object.purinvpagesize[1]
			this.id_master.object.remarks[1] = lds_purheader.object.remarks[1]
			this.id_master.object.grn[1] = lds_purheader.object.grn[1]
			this.id_master.object.pocode[1] = ll_null
			wf_filter_po_itemsonly(ll_null)
			this.id_footer.object.flatdisc[1] = lds_purheader.object.flatdisc[1]
			this.id_footer.object.misccharges[1] = lds_purheader.object.misccharges[1]
			this.id_footer.object.discperc[1] = lds_purheader.object.discperc[1]
			this.id_footer.object.invgstperc1[1] = lds_purheader.object.invgstperc1[1]
		end if
		this.id_detail.reset()
		for ll_count = 1 to ll_detailrows
			this.id_detail.insertrow(0)
			ll_icode = lds_purdetail.object.icode[ll_count]
			ll_gcode = lds_purdetail.object.gcode[ll_count]
			if wf_inititeminfo(ll_icode, ll_count, ls_errortext) then
				ll_packunits = this.id_detail.object.packunits[ll_count]
				if ll_packunits = 0 or isnull(ll_packunits) then
					ll_packunits = 1
				end if
				if this.ii_purchasetype = 1 then
					if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
						ld_purqty = lds_purdetail.object.packqty[ll_count]
						ld_purbonus = lds_purdetail.object.bonusqty[ll_count]
						ld_purprice = lds_purdetail.object.purprice[ll_count]
						ld_salestax = lds_purdetail.object.unitsalestax[ll_count]
					else
						ld_purqty = truncate(lds_purdetail.object.looseqty[ll_count] / ll_packunits, 0)
						ld_purbonus = truncate(lds_purdetail.object.bonusqty[ll_count] / ll_packunits, 0)
						ld_purprice = lds_purdetail.object.purprice[ll_count] * ll_packunits
						ld_salestax = lds_purdetail.object.unitsalestax[ll_count] * ll_packunits
					end if
					this.id_detail.object.packqty[ll_count] = ld_purqty
				else
					if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
						ld_purqty = lds_purdetail.object.packqty[ll_count] * ll_packunits
						ld_purbonus = lds_purdetail.object.bonusqty[ll_count] * ll_packunits
						ld_purprice = round(lds_purdetail.object.purprice[ll_count] / ll_packunits, 2)
						ld_salestax = round(lds_purdetail.object.unitsalestax[ll_count] / ll_packunits, 2)
					else
						ld_purqty = lds_purdetail.object.looseqty[ll_count]
						ld_purbonus = lds_purdetail.object.bonusqty[ll_count]
						ld_purprice = lds_purdetail.object.purprice[ll_count]
						ld_salestax = lds_purdetail.object.unitsalestax[ll_count]
					end if
					this.id_detail.object.looseqty[ll_count] = ld_purqty
				end if
				if f_stringpreferences("bonusinpurchase") = "Y" then
					this.id_detail.object.bonusqty[ll_count] = ld_purbonus
				end if
				this.id_detail.object.purprice[ll_count] = ld_purprice
				this.id_detail.object.discperc[ll_count] = lds_purdetail.object.discperc[ll_count]
				this.id_detail.object.unitsalestax[ll_count] = ld_salestax
				this.id_detail.object.gstperc[ll_count] = ld_gstperc
				this.id_detail.setitemstatus(ll_count, "purprice", primary!, notmodified!)
			end if
			wf_update_value_extax(ll_count, this.id_detail.object.looseqty[ll_count] + this.id_detail.object.packqty[ll_count], this.id_detail.object.purprice[ll_count], this.id_detail.object.discperc[ll_count])
		next
		destroy lds_purdetail
	end if
	wf_grandtotal()
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return 1

// w_purchase.wf_generate_batches() returns long
	s_arguements lstr_arg
	long ll_tobeinserted
	long ll_row
	long ll_counter
	long ll_seq
	long ll_insertcount
	string ls_errortext
	if this.tab_retrieve.selectedtab = 2 then
		return 0
	end if
	if wf_iseditable() = false then
		return 0
	end if
	open(w_arg_item_batch_generation_purchase)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		if this.id_detail.rowcount() > 0 and isnull(this.id_detail.object.icode[this.id_detail.rowcount()]) then
			this.id_detail.setrow(this.id_detail.rowcount())
			this.id_detail.scrolltorow(this.id_detail.rowcount())
			triggerevent("ue_deleteitem")
		end if
		if lstr_arg.l_code3 = 0 then
			return 0
		end if
		if lstr_arg.l_code4 = 0 then
			return 0
		end if
		ll_tobeinserted = lstr_arg.l_code4
		ll_seq = lstr_arg.l_code2
		for ll_counter = 1 to ll_tobeinserted
			ll_row = this.id_detail.insertrow(0)
			if ll_row > 0 and wf_inititeminfo(lstr_arg.l_code1, ll_row, ls_errortext) = true then
				this.id_detail.object.batch[ll_row] = lstr_arg.s_name1 + trim(string(ll_seq)) + lstr_arg.s_name2
				if this.ii_purchasetype = 1 then
					this.id_detail.object.packqty[ll_row] = lstr_arg.l_code5
				else
					this.id_detail.object.looseqty[ll_row] = lstr_arg.l_code5
				end if
				this.id_detail.object.expiry[ll_row] = date(lstr_arg.d_sdate)
				ll_seq = ll_seq + lstr_arg.l_code3
				ll_insertcount = ll_insertcount + 1
			end if
		next
	end if
	if this.id_detail.rowcount() > 0 then
		this.im_menu.m_file.m_save.enabled = true
	end if
	return 0

// w_purchase.wf_item_image_setting() returns long
	if f_stringpreferences("showitemimageinpur") = "N" then
		this.id_master.object.p_itemimage.visible = 0
	else
		this.it_imagetrans = create u_transaction
		this.it_imagetrans.autocommit = true
		SQL start USING this.it_imagetrans;
		if this.it_imagetrans.sqlcode <> 0 then
			return -1
		end if
		this.id_master.object.p_itemimage.visible = 1
	end if
	return 0

// w_purchase.wf_set_itemimage(long al_icode) returns long
	long ll_rowid
	string ls_filename
	string ls_imagetype
	string ls_imagedesc
	blob lb_image
	this.id_master.object.p_itemimage.filename = ""
	if al_icode <= 0 or isnull(al_icode) then
		return 0
	end if
	if f_stringpreferences("showitemimageinpur") = "N" then
		return 0
	end if
	this.it_imagetrans.getfirstitemimagedetail(al_icode, ll_rowid, ls_imagetype, ls_imagedesc)
	if this.it_imagetrans.sqlcode <> 0 then
		messagebox("Item Image/Picture ", "Unable to fetch item Image Details.~r~nReasons are:~r~n" + this.it_imagetrans.sqlerrtext)
		return -1
	end if
	if ll_rowid <= 0 then
		return 0
	end if
	SQL SelectBlob ItemImage INTO :lb_image From ItemImage Where Icode =:al_icode AND RowID =:ll_rowid USING this.it_imagetrans;
	if this.it_imagetrans.sqlcode <> 0 then
		messagebox("Item Image/Picture ", "Unable to fetch item Image.~r~nReasons are:~r~n" + this.it_imagetrans.sqlerrtext)
		return -1
	end if
	ls_filename = gs_temp_img_filename
	ls_filename = left(ls_filename, len(ls_filename) - 4)
	ls_filename = trim(string(ls_filename)) + "." + ls_imagetype
	f_writeimgtofile(ls_filename, lb_image)
	this.id_master.object.p_itemimage.filename = ls_filename
	return 0

// w_purchase.wf_updateitemflatdisc(long al_icode, double ad_flatdisc) returns integer
	SQL update Item SET flatdisc =:ad_flatdisc WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_purchase.wf_markup_effect_on_saleprice(long al_row, double ad_markup) returns integer
	double ld_salepriceforitem
	double ld_markupdiff
	double ld_netrate
	double ld_newsalepriceforitem
	ld_netrate = this.id_detail.getitemnumber(al_row, "netrate")
	ld_newsalepriceforitem = round(ld_netrate + ad_markup * ld_netrate * 0.01, 2)
	this.id_detail.setitem(al_row, "salepriceforitem", ld_newsalepriceforitem)
	return 0

// w_purchase.wf_categorywise_pur_counter(long al_icatcode, long al_newid) returns integer
	long ll_rtcode
	SQL SELECT PurMonthlyCounter INTO :al_newid FROM itemcategory WITH ( UPDLOCK HOLDLOCK ) WHERE itemcategory.icatcode =:al_icatcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_newid = al_newid + 1
		SQL update ItemCategory SET PurMonthlyCounter =:al_newid WHERE itemcategory.icatcode =:al_icatcode USING this.it_transobject;
		if this.it_transobject.sqlcode < 0 then
			ll_rtcode = this.it_transobject.sqlcode
			al_newid = 0
		end if
	else
		ll_rtcode = this.it_transobject.sqlcode
		al_newid = 0
	end if
	return ll_rtcode

// w_purchase.wf_categorywise_pur_counter_daily(long al_icatcode, long al_newid) returns integer
	long ll_rtcode
	SQL SELECT PurDailyCounter INTO :al_newid FROM itemcategory WITH ( UPDLOCK HOLDLOCK ) WHERE itemcategory.icatcode =:al_icatcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_newid = al_newid + 1
		SQL update ItemCategory SET PurDailyCounter =:al_newid WHERE itemcategory.icatcode =:al_icatcode USING this.it_transobject;
		if this.it_transobject.sqlcode < 0 then
			ll_rtcode = this.it_transobject.sqlcode
			al_newid = 0
		end if
	else
		ll_rtcode = this.it_transobject.sqlcode
		al_newid = 0
	end if
	return ll_rtcode

// w_purchase.wf_print_purlabels() returns long
	long ll_icode
	long ll_row
	long ll_count
	long ll_insrow
	double ld_price
	double ld_retailprice
	string ls_labelformat
	boolean lb_listtab
	s_datastore lstr
	datastore lds_purlabel
	lds_purlabel = create datastore
	ls_labelformat = wf_select_label_format()
	lds_purlabel.dataobject = ls_labelformat
	lds_purlabel.settransobject(sqlca)
	if this.tab_retrieve.selectedtab = 2 then
		return 0
	end if
	ll_count = this.id_detail.rowcount()
	if ll_count > 0 then
		for ll_row = 1 to ll_count
			ll_icode = this.id_detail.object.icode[ll_row]
			ll_insrow = lds_purlabel.insertrow(0)
			lds_purlabel.object.aliasname[ll_insrow] = "*" + this.id_detail.object.fullcode[ll_row] + "*"
			lds_purlabel.object.aliasname2[ll_insrow] = this.id_detail.object.fullcode[ll_row]
			if gs_company = "SALEEMIHOMEPLUS" then
				lds_purlabel.object.customicode[ll_insrow] = "Code: ( " + this.id_detail.object.fullcode[ll_row] + " )"
			end if
			lds_purlabel.object.name[ll_insrow] = this.id_detail.object.itemname[ll_row]
			lds_purlabel.object.packingdesc[ll_insrow] = this.id_detail.object.packingdesc[ll_row]
			SQL SELECT saleprice , RetailPRice INTO :ld_price, :ld_retailprice FROM Item WHERE ICode =:ll_icode USING sqlca;
			lds_purlabel.object.saleprice[ll_insrow] = ld_price
			lds_purlabel.object.retailprice[ll_insrow] = ld_retailprice
			lds_purlabel.object.qty[ll_insrow] = 1
		next
		lstr.s_module = "purlabel"
		lstr.ds = lds_purlabel
		lstr.s_name1 = lds_purlabel.dataobject
		openwithparm(w_preview_invoices2, lstr)
		lstr = message.powerobjectparm
	end if
	return 0

// w_purchase.wf_enforce_po_details() returns long
	long ll_pocode
	long ll_totrows
	long ll_counter
	long ll_icode
	long ll_rtcode
	long ll_total_po_rows
	long ll_found
	long ll_retcode
	double ld_qty
	double ld_bonusqty
	double ld_reqqty
	double ld_reqbonus
	double ld_origqty
	double ld_qtysatisfied
	string ls_itemname
	datastore lds_podetail
	lds_podetail = create datastore
	lds_podetail.dataobject = "d_populatepurorder"
	lds_podetail.settransobject(this.it_transobject)
	if f_stringpreferences("EnforcePODetailsOnPurSaving") = "N" then
		return 0
	end if
	ll_pocode = this.id_master.object.pocode[1]
	ll_totrows = this.id_detail.rowcount()
	if ll_pocode > 0 and ll_totrows > 0 then
		ll_rtcode = lds_podetail.retrieve(ll_pocode)
		ll_total_po_rows = lds_podetail.rowcount()
		if ll_total_po_rows > 0 then
			ll_counter = 1
			do while ll_counter <= ll_totrows and ll_retcode = 0
				ll_icode = this.id_detail.object.icode[ll_counter]
				ld_qty = this.id_detail.object.packqty[ll_counter] + this.id_detail.object.looseqty[ll_counter]
				ld_bonusqty = this.id_detail.object.bonusqty[ll_counter]
				ls_itemname = this.id_detail.object.itemname[ll_counter]
				ll_found = lds_podetail.find("icode = " + trim(string(ll_icode)), 1, ll_total_po_rows)
				if ll_found > 0 and ll_found <= ll_total_po_rows then
					ld_origqty = lds_podetail.object.qty[ll_found]
					ld_reqqty = lds_podetail.object.reqqty[ll_found]
					ld_reqbonus = lds_podetail.object.reqbonusqty[ll_found]
					ld_qtysatisfied = lds_podetail.object.qtysatisfied[ll_found]
					ll_found = lds_podetail.find("icode = " + trim(string(ll_icode)) + " and reqqty >= " + trim(string(ld_qty)), 1, ll_total_po_rows)
					if not (ll_found > 0 and ll_found <= ll_total_po_rows) then
						messagebox("Purchase Order Enforcement", "Purchase Qty can not be validated with respective purchase order~r~n" + "~r~nItem Name = " + ls_itemname + "~r~nOriginal Order Qty       = " + trim(string(ld_origqty, "######0")) + "~r~nAlready Purchased      = " + trim(string(ld_qtysatisfied, "######0")) + "~r~nRemaining Order Qty   = " + trim(string(ld_reqqty, "######0")) + "~r~nThis Purchase Qty        = " + trim(string(ld_qty, "######0")) + "~r~n~r~nPlease enter valid purchase qty as per Purchase Order", stopsign!)
						ll_retcode = 1
					end if
				else
					messagebox("Purchase Order Enforcement", "This Item can not be validated with respective purchase order~r~n" + "~r~nItem Name = " + ls_itemname + "~r~n~r~nPlease enter valid purchase items as per Purchase Order", stopsign!)
					ll_retcode = 1
				end if
				if ll_retcode = 0 then
					ll_counter = ll_counter + 1
				end if
			loop
			if ll_retcode = 1 then
				this.id_detail.setfocus()
				this.id_detail.setcolumn("ItemName")
				this.id_detail.setrow(ll_counter)
				this.id_detail.scrolltorow(ll_counter)
			end if
		else
			messagebox("Purchase Order Validation", "Purchase Order does not contain sufficient items to be purchased", stopsign!)
			ll_retcode = 1
		end if
	else
		ll_retcode = 0
	end if
	return ll_retcode

// w_purchase.wf_filter_po_itemsonly(long al_pocode) returns long
	long ll_counter
	long ll_rowcount
	long ll_rtcode
	long ll_found
	long ll_icode
	boolean lb_enablerestricted
	string ls_itemlist
	string ls_filterexp
	long li_count
	long ll_startrow
	char lc_char
	datastore lds_podetail
	if al_pocode > 0 then
		lds_podetail = create datastore
		lds_podetail.dataobject = "d_populatepurorder"
		lds_podetail.settransobject(this.it_transobject)
		ll_rtcode = lds_podetail.retrieve(al_pocode)
		ll_rowcount = lds_podetail.rowcount()
		for ll_counter = 1 to ll_rowcount
			ll_icode = lds_podetail.object.icode[ll_counter]
			ll_found = this.id_detail.find("icode = " + trim(string(ll_icode)), 1, this.id_detail.rowcount())
			if ll_found <= 0 or ll_found > this.id_detail.rowcount() then
				ls_itemlist = ls_itemlist + trim(string(ll_icode)) + ","
			end if
		next
		ls_itemlist = left(ls_itemlist, len(ls_itemlist) - 1)
		gd_itemsinfo.reset()
		gd_itemsinfo.setfilter("")
		gd_itemsinfo.filter()
		if f_stringpreferences("GroupCategoryRights") = "Y" then
			gd_itemsinfo.retrieve(gi_catlist, f_getgroupcode(gl_usercode))
		else
			gd_itemsinfo.retrieve(f_getgroupcode(gl_usercode))
		end if
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 515", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			lb_enablerestricted = true
		end if
		if trim(ls_itemlist) = "" or isnull(ls_itemlist) then
			ls_itemlist = "-1"
		end if
		if lb_enablerestricted = false then
			ls_filterexp = " restricted = 'N' AND Icode IN (" + ls_itemlist + " ) "
		else
			ls_filterexp = " Icode IN (" + ls_itemlist + " ) "
		end if
		gd_itemsinfo.setfilter(ls_filterexp)
		gd_itemsinfo.filter()
		for li_count = 65 to 90
			lc_char = char(li_count)
			ga_llookuptable[li_count] = gd_itemsinfo.find("Lower(itemname) >= Lower('" + char(li_count) + "')", ll_startrow, 99999)
			ll_startrow = ga_llookuptable[li_count]
		next
		ga_llookuptable[92] = 999999
	else
		gd_itemsinfo.reset()
		gd_itemsinfo.setfilter("")
		gd_itemsinfo.filter()
		if f_stringpreferences("GroupCategoryRights") = "Y" then
			gd_itemsinfo.retrieve(gi_catlist, f_getgroupcode(gl_usercode))
		else
			gd_itemsinfo.retrieve(f_getgroupcode(gl_usercode))
		end if
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 515", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			lb_enablerestricted = true
		end if
		if lb_enablerestricted = false then
			gd_itemsinfo.setfilter(" restricted = 'N' ")
			gd_itemsinfo.filter()
		else
			gd_itemsinfo.setfilter(" ")
			gd_itemsinfo.filter()
		end if
		for li_count = 65 to 90
			lc_char = char(li_count)
			ga_llookuptable[li_count] = gd_itemsinfo.find("Lower(itemname) >= Lower('" + char(li_count) + "')", ll_startrow, 99999)
			ll_startrow = ga_llookuptable[li_count]
		next
		ga_llookuptable[92] = 999999
	end if
	return 0

// w_purchase.wf_set_po_values(long al_row) returns long
	double ld_qty
	double ld_rate
	double ld_bonusqty
	long ll_pocode
	long ll_icode
	long ll_packunits
	string ls_alternatecustomicode
	ll_pocode = this.id_master.object.pocode[1]
	if ll_pocode > 0 and al_row > 0 then
		ll_icode = this.id_detail.object.icode[al_row]
		ls_alternatecustomicode = this.id_detail.object.alternatecustomicode[al_row]
		if len(ls_alternatecustomicode) > 0 then
			SQL SELECT Qty =SUM ( PD.Qty ) , Rate =MAX ( PD.Rate ) , BonusQty =SUM ( PD.BonusQty ) , PackUnits =Max ( PD.PackUnits ) INTO :ld_qty, :ld_rate, :ld_bonusqty, :ll_packunits FROM PurOrderDetail PD WHERE PD.POCode =:ll_pocode AND PD.ICode =:ll_icode AND PD.AlternateCustomICode =:ls_alternatecustomicode USING this.it_transobject;
		else
			SQL SELECT Qty =SUM ( PD.Qty ) , Rate =MAX ( PD.Rate ) , BonusQty =SUM ( PD.BonusQty ) , PackUnits =Max ( PD.PackUnits ) , AlternateCustomICode =MAX ( PD.AlternateCustomICode ) INTO :ld_qty, :ld_rate, :ld_bonusqty, :ll_packunits, :ls_alternatecustomicode FROM PurOrderDetail PD WHERE PD.POCode =:ll_pocode AND PD.ICode =:ll_icode USING this.it_transobject;
		end if
		if this.it_transobject.sqlcode = 0 and ld_qty > 0.0 then
			if ll_packunits <= 0 or isnull(ll_packunits) then
				ll_packunits = 1
			end if
			this.id_detail.object.alternatecustomicode[al_row] = ls_alternatecustomicode
			this.id_detail.object.packunits[al_row] = ll_packunits
			this.id_detail.object.packqty[al_row] = ld_qty
			this.id_detail.object.purprice[al_row] = ld_rate
			this.id_detail.object.bonusqty[al_row] = ld_bonusqty
		end if
	end if
	return 0

// w_purchase.wf_import_parentserver_transactions() returns long
	open(w_import_parentserver_transaction)
	return 0

// w_purchase.wf_updateitemretailprice(transaction at_transobject, long al_icode, double ad_retailprice) returns long
	SQL update Item SET RetailPrice =:ad_retailprice WHERE Item.icode =:al_icode USING at_transobject;
	return at_transobject.sqlcode

// w_purchase.wf_update_manfdate(long al_icode, long al_gcode, string as_batch, datetime adt_expiry, datetime adt_manfdate) returns long
	SQL update GodownDetail SET GodownDetail.ManfDate =:adt_manfdate WHERE GodownDetail.GCode =:al_gcode AND GodownDetail.ICode =:al_icode AND GodownDetail.Batch =:as_batch AND GodownDetail.Expiry =:adt_expiry USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		return 0
	end if
	return this.it_transobject.sqlcode

// w_purchase.wf_setpurorderinfo(long al_purordercode, integer ai_mode) returns long
	long ll_suppcode
	long ll_salesmancode
	long ll_row
	long ll_icatcode
	long ll_potypecode
	long ll_manfcode = 1
	integer li_rtcode
	datetime ld_podate
	string ls_podate
	string ls_manfname
	string ls_suppref
	string ls_remarks
	SQL SELECT purorderheader.manfcode , purorderheader.suppcode , purorderheader.date , supplierreference , remarks , icatcode , purtypecode INTO :ll_manfcode, :ll_suppcode, :ld_podate, :ls_suppref, :ls_remarks, :ll_icatcode, :ll_potypecode FROM purorderheader WHERE purorderheader.pocode =:al_purordercode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Cannot Connect to Database", this.it_transobject.sqlerrtext)
		li_rtcode = -1
	end if
	if isnull(ll_manfcode) then
		ll_manfcode = 1
	end if
	SQL SELECT manufacturer.name INTO :ls_manfname FROM manufacturer WHERE manufacturer.manfcode =:ll_manfcode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Cannot Connect to Database", this.it_transobject.sqlerrtext)
		li_rtcode = -1
	end if
	ll_row = this.id_master.getrow()
	ll_row = 1
	this.id_master.object.podate[ll_row] = ld_podate
	this.id_master.object.manfname[ll_row] = ls_manfname
	this.id_master.object.manfcode[ll_row] = ll_manfcode
	if ai_mode = 1 then
		this.id_master.object.suppcode[ll_row] = ll_suppcode
	end if
	if this.ii_purchasetype = 1 then
		this.id_master.object.posupplierreference[ll_row] = ls_suppref
	end if
	this.id_master.object.remarks[ll_row] = ls_remarks
	this.id_master.object.icatcode[ll_row] = ll_icatcode
	this.id_master.object.purtypecode[ll_row] = ll_potypecode
	wf_setsuppinfo(ll_suppcode, this.id_master)
	return ll_manfcode

// w_purchase.wf_show_pur_expenses_window(integer ai_mode) returns long
	long ll_counter
	long ll_code
	long ll_row
	long ll_insrow
	double ld_tot_expamt
	s_mastercashwin lstr_values
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	lstr_values.l_invcode = ll_code
	lstr_values.l_groupcode = this.il_groupcode
	for ll_counter = 1 to this.ids_purexp.rowcount()
		lstr_values.l_acccode[ll_counter] = this.ids_purexp.object.acccode[ll_counter]
		lstr_values.s_remarks[ll_counter] = this.ids_purexp.object.remarks[ll_counter]
		lstr_values.d_amount[ll_counter] = this.ids_purexp.object.amount[ll_counter]
		lstr_values.l_rowid[ll_counter] = this.ids_purexp.object.rowid[ll_counter]
		ld_tot_expamt = ld_tot_expamt + this.ids_purexp.object.amount[ll_counter]
	next
	lstr_values.d_invbalance = ld_tot_expamt
	for ll_counter = 1 to 100
		if lstr_values.l_rowid[ll_counter] <= 0 then
			lstr_values.l_rowid[ll_counter] = -1
		end if
	next
	lstr_values.l_mode = ai_mode
	openwithparm(w_pur_exp_window, lstr_values)
	lstr_values = message.powerobjectparm
	if lstr_values.i_status = 1 then
		this.ids_purexp.reset()
		ld_tot_expamt = 0
		for ll_counter = 1 to 100
			if lstr_values.l_acccode[ll_counter] > 0 and lstr_values.d_amount[ll_counter] > 0 and lstr_values.l_rowid[ll_counter] > 0 then
				ll_insrow = this.ids_purexp.insertrow(0)
				this.ids_purexp.object.code[ll_insrow] = ll_code
				this.ids_purexp.object.acccode[ll_insrow] = lstr_values.l_acccode[ll_counter]
				this.ids_purexp.object.remarks[ll_insrow] = lstr_values.s_remarks[ll_counter]
				this.ids_purexp.object.amount[ll_insrow] = lstr_values.d_amount[ll_counter]
				this.ids_purexp.object.rowid[ll_insrow] = lstr_values.l_rowid[ll_counter]
				ld_tot_expamt = ld_tot_expamt + lstr_values.d_amount[ll_counter]
			end if
			if ld_tot_expamt > 0.0 then
				this.id_footer.object.totalexp[1] = ld_tot_expamt
			else
				this.id_footer.object.totalexp[1] = 0.00
			end if
		next
		wf_grandtotal()
		return 1
	end if
	return 0

// w_purchase.wf_update_pur_exp(long al_invcode) returns long
	long ll_counter
	for ll_counter = 1 to this.ids_purexp.rowcount()
		this.ids_purexp.object.code[ll_counter] = al_invcode
		this.ids_purexp.setitemstatus(ll_counter, 0, primary!, new!)
	next
	SQL DELETE DBO.PurExp WHERE PurInvCode =:al_invcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if this.ids_purexp.update() > 0 then
			return 0
		else
			return -1
		end if
		return
	end if
	return -1

// w_purchase.wf_assign_purexp_object() returns 0
	this.ids_purexp = create u_ds_standard
	this.ids_purexp.dataobject = "d_purchase_expenses"
	this.ids_purexp.settransobject(this.it_transobject)

// w_purchase.wf_select_label_format() returns string
	string ls_rep
	if gs_company = "DWATSONF10" or gs_company = "DWATSONCNC" or gs_company = "DWSG11" or gs_company = "DWSSUPERF7" or gs_company = "DWBLUEAREA2008" or gs_company = "DWBLUEAREA20082" or gs_company = "DWATSONCHAKWAL" or gs_company = "DWSBARAKAHU" or gs_company = "DWATSONSCHEME3" or gs_company = "DWBLUEAREAPUR" or gs_company = "DWSBAHRIAP5" or gs_company = "LINGERIELOUNGE" or gs_company = "LINGERISAFAGOLD" then
		ls_rep = "d_dwatson_purlabel_for_purinvoice"
	elseif gs_company = "SALEEMIHOMEPLUS" then
		ls_rep = "d_saleemihomeplus_purlabel"
	elseif gs_company = "ISHAHIZACNC" then
		ls_rep = "d_ishahizacnc_purlabel"
	elseif gs_company = "GREENFIELD" then
		ls_rep = "d_greenfield_purlabel"
	elseif left(gs_company, 14) = "SAVEGALLERYCNC" then
		ls_rep = "d_savegallerycnc_purlabel"
	else
		ls_rep = "d_purlabel_for_purinvoice"
	end if
	return ls_rep

// w_purchase.wf_purchase_from_customer() returns long
	s_arguements lstr_arg
	long ll_custcode
	long ll_targetsite
	if this.tab_retrieve.selectedtab = 2 then
		return 0
	end if
	if this.id_master.object.posted[1] = "Y" then
		return 0
	end if
	if this.ii_purchasetype = 2 then
		return 0
	end if
	ll_custcode = this.id_master.object.custcode[1]
	openwithparm(w_arg_purchasefromcustomer, ll_custcode)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		this.id_master.object.custcode[1] = lstr_arg.l_code1
		if this.id_master.object.custcode[1] > 0 then
			SQL SELECT SiteCode INTO :ll_targetsite FROM Customer WHERE Custcode =:lstr_arg.l_code1 USING sqlca;
			if sqlca.sqlcode = 0 then
				this.id_master.object.targetsitecode[1] = ll_targetsite
			end if
			this.id_master.object.aliasname.protect = 1
			this.id_master.object.suppcode.protect = 1
			this.id_master.object.aliasname[1] = ""
			this.id_master.object.suppcode[1] = 18
			wf_setsuppinfo(18, this.id_master)
		else
			this.id_master.object.aliasname.protect = 0
			this.id_master.object.suppcode.protect = 0
			this.id_master.object.aliasname[1] = ""
			this.id_master.object.suppcode[1] = 18
			wf_setsuppinfo(18, this.id_master)
		end if
	end if
	return 0

