// window w_purchase (purchasecomponents)  ancestor: w_multi_entry

// w_purchase.ue_populate_purchase_from_datacarrydb() returns 0 [event]
	long ll_icode
	long ll_row
	long ll_saleinvcode
	long ll_counter
	long ll_qty
	long ll_bonusqty
	long ll_suppcode
	long ll_check_for_basicdata_sync
	boolean retflag = true
	double ld_purprice
	double ld_discperc
	double ld_itemflatdisc
	double ld_saleprice
	double ld_avgprice
	double ld_packsalestax
	double ld_gstperc
	double ld_rpp
	double ld_unitsalestax
	double ld_itempurprice
	double ld_rate
	double ld_rpp2
	double ld_rpp3
	double ld_rpp4
	double ld_rpp5
	double ld_invdiscperc
	double ld_invflatdisc
	double ld_invmisccharges
	double ld_invgstperc1
	double ld_godownstock
	double ld_allgodownstock
	long ll_packunits
	long ll_itemscount
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_batch
	string ls_itemtotalval
	string ls_packingdesc
	string ls_errortext
	string ls_error_syntax
	string ls_connsetting = "Set ANSI_NULLS ON Set ANSI_WARNINGS ON"
	string ls_saleledgerquery
	string ls_saledetailquery
	string ls_newsyntax
	string ls_suppinvcode
	string ls_suppinvcode_tmp
	string ls_machinename
	datetime ldt_expiry
	datastore lds_saleledger
	datastore lds_saledetail
	s_arguements lstr_arguments
	u_transaction lt_transobject
	if wf_iseditable() = false then
		return
	end if
	ll_suppcode = this.id_master.object.suppcode[this.id_master.rowcount()]
	if isnull(ll_suppcode) then
		messagebox("Supplier Validation!", "Kindly Select a supplier first")
		return
	end if
	open(w_populate_sale_from_datacarrydb)
	lstr_arguments = message.powerobjectparm
	if lstr_arguments.i_status <= 0 then
		return
	end if
	ll_saleinvcode = lstr_arguments.l_code1
	if ll_saleinvcode > 0 and this.id_master.object.suppcode[this.id_master.rowcount()] > 0 then
		ls_suppinvcode = trim(string(ll_saleinvcode))
		if f_stringpreferences("ForceUniqueSuppInvNoInPur") = "Y" then
			SQL SELECT MAX ( SuppInvCode ) INTO :ls_suppinvcode_tmp FROM PurLedger WHERE SuppCode =:ll_suppcode AND SuppInvCode =:ls_suppinvcode USING sqlca;
			if sqlca.sqlcode = 0 then
				if not isnull(ls_suppinvcode_tmp) then
					messagebox("Supplier Inv. Code Validation!", "Supplier Inv. code already exist.~r~nProbably this invoice is already processed.~r~nKindly select some other invoice")
					return
				end if
			else
				messagebox("Connection Problem", "Unable to Fetch Supplier Invoice Code from database.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
				return
			end if
			return
		end if
		return
	end if
	lt_transobject = create u_transaction
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Problem", "Unable to connect to database.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		return
	end if
	SQL EXECUTE IMMEDIATE :ls_connsetting USING lt_transobject;
	if ll_saleinvcode > 0 then
		setpointer(hourglass!)
		ll_check_for_basicdata_sync = f_check_for_basicdata_sync()
		if ll_check_for_basicdata_sync < 0 then
			return
		end if
		lds_saleledger = create datastore
		lds_saledetail = create datastore
		ls_saleledgerquery = "Select ~tSaleInvCode, SaleCatCode, CustCode, SalesmanCode, date, DiscPerc, FlatDisc, MiscCharges, SalesTax,  Posted, PostDate, Remarks, CustRefNo, headerno, headerinvno, OriginalDate, ModifiedBy,PostedBy, InvGSTPerc1, InvTotal, MachineName " + "From ~t" + gs_inlinkserver + "." + gs_inlinkserverdb + "." + gs_inlinkserverowner + "." + "SaleLedger " + "Where   Saleinvcode = " + string(ll_saleinvcode)
		ls_saledetailquery = "Select ~tSaleInvcode, ICode, GCode, Batch, Expiry, PackQty, LooseQty, PackUnits, SalePrice, AvgPrice, Rate, DiscPerc, SalesTax, RowID, itemflatdisc, SaleItemDescription, PackPrice, UnitSalesTax, GSTPerc, SaleUtn, bonusqty, RowGroup " + "From ~t" + gs_inlinkserver + "." + gs_inlinkserverdb + "." + gs_inlinkserverowner + "." + "SaleDetail " + "Where ~tSaleInvCode = " + string(ll_saleinvcode)
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_saleledgerquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For SaleLedger DataStore")
			return
		else
			ls_error_syntax = ""
			lds_saleledger.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For SaleLedger DataStore")
				return
			end if
		end if
		lds_saleledger.settransobject(lt_transobject)
		if lds_saleledger.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source SaleLedger.")
			return
		end if
		ls_newsyntax = ""
		ls_error_syntax = ""
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_saledetailquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For SaleDetail DataStore")
			return
		else
			ls_error_syntax = ""
			lds_saledetail.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For SaleDetail DataStore")
				return
			end if
		end if
		lds_saledetail.settransobject(lt_transobject)
		if lds_saledetail.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source SaleDetail.")
			return
		end if
		ld_invdiscperc = lds_saleledger.getitemnumber(lds_saleledger.getrow(), "discperc")
		ld_invflatdisc = lds_saleledger.getitemnumber(lds_saleledger.getrow(), "flatdisc")
		ld_invmisccharges = lds_saleledger.getitemnumber(lds_saleledger.getrow(), "misccharges")
		ld_invgstperc1 = lds_saleledger.getitemnumber(lds_saleledger.getrow(), "invgstperc1")
		ls_machinename = lds_saleledger.getitemstring(lds_saleledger.getrow(), "machinename")
		this.id_master.setitem(1, "suppinvcode", trim(string(ll_saleinvcode)))
		this.id_master.setitem(1, "suppinvdate", lstr_arguments.d_sdate)
		this.id_master.setitem(1, "newpurchaseorderno", ls_machinename)
		this.id_footer.setitem(1, "discperc", ld_invdiscperc)
		this.id_footer.setitem(1, "flatdisc", ld_invflatdisc)
		this.id_footer.setitem(1, "misccharges", ld_invmisccharges)
		this.id_footer.setitem(1, "invgstperc1", ld_invgstperc1)
		for ll_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_counter = 1 to lds_saledetail.rowcount()
			ll_row = this.id_detail.insertrow(0)
			ll_icode = lds_saledetail.getitemnumber(ll_counter, "icode")
			wf_inititeminfo(ll_icode, ll_counter, ls_errortext)
			ll_qty = lds_saledetail.getitemnumber(ll_counter, "looseqty")
			ll_bonusqty = lds_saledetail.getitemnumber(ll_counter, "bonusqty")
			ld_purprice = lds_saledetail.getitemnumber(ll_counter, "saleprice")
			ld_discperc = lds_saledetail.getitemnumber(ll_counter, "discperc")
			ld_itemflatdisc = lds_saledetail.getitemnumber(ll_counter, "itemflatdisc")
			ld_unitsalestax = lds_saledetail.getitemnumber(ll_counter, "unitsalestax")
			ld_gstperc = lds_saledetail.getitemnumber(ll_counter, "gstperc")
			ls_batch = lds_saledetail.getitemstring(ll_counter, "batch")
			ldt_expiry = lds_saledetail.getitemdatetime(ll_counter, "expiry")
			ld_purprice = ld_purprice - ld_itemflatdisc
			SQL SELECT item.customicode , item.name , item.gcode , item.purprice , item.packsalestax , item.saleprice , item.avgprice , item.recentpurprice , item.recentpurprice2 , recentpurprice3 , recentpurprice4 , recentpurprice5 , item.packingdesc , item.packunits INTO :ls_fullcode, :ls_name, :li_gcode, :ld_itempurprice, :ld_packsalestax, :ld_saleprice, :ld_avgprice, :ld_rpp, :ld_rpp2, :ld_rpp3, :ld_rpp4, :ld_rpp5, :ls_packingdesc, :ll_packunits FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = -1 then
				retflag = false
				ls_errortext = "Database Error: Item information can not be retrieved.~r~nReasons:" + this.it_transobject.sqlerrtext
				messagebox("Item Validation", ls_errortext)
			end if
			if ll_packunits < 1 or isnull(ll_packunits) then
				ll_packunits = 1
			end if
			if this.il_godowncount = 1 and this.il_strategy = 1 then
				this.ii_defaultgcode = this.id_detail.getitemnumber(ll_row, "gcode")
			else
				if this.il_strategy = 2 then
					this.ii_defaultgcode = li_gcode
				end if
				if this.il_strategy = 1 then
					this.ii_defaultgcode = this.id_detail.getitemnumber(ll_row, "gcode")
				end if
			end if
			ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
			this.it_transobject.getitemstocktotal(this.ii_defaultgcode, ll_icode, ld_godownstock)
			this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
			if this.it_transobject.sqlcode = -1 then
				retflag = false
				ls_errortext = "Database Error: Item Stock information can not be retrieved"
			end if
			this.id_detail.setitem(ll_row, "gcode", this.ii_defaultgcode)
			this.id_detail.setitem(ll_row, "icode", ll_icode)
			this.id_detail.setitem(ll_row, this.is_columnitemname, ls_name)
			this.id_detail.setitem(ll_row, "fullcode", ls_fullcode)
			this.id_detail.setitem(ll_row, "packunits", ll_packunits)
			this.id_detail.setitem(ll_row, "discperc", ld_discperc)
			this.id_detail.setitem(ll_row, "saleprice", ld_saleprice)
			this.id_detail.setitem(ll_row, "rate", ld_itempurprice)
			this.id_detail.setitem(ll_row, "itemtotalval", ls_itemtotalval)
			this.id_detail.setitem(ll_row, "stock", ld_godownstock)
			this.id_detail.setitem(ll_row, "totalstock", ld_allgodownstock)
			this.id_detail.setitem(ll_row, "packingdesc", ls_packingdesc)
			this.id_detail.setitem(ll_row, "batch", ls_batch)
			this.id_detail.setitem(ll_row, "expiry", ldt_expiry)
			this.id_footer.object.t_rpp.text = string(ld_rpp) + " , " + string(ld_rpp2) + " , " + string(ld_rpp3) + " , " + string(ld_rpp4) + " , " + string(ld_rpp5)
			this.id_footer.object.t_avgprice.text = string(ld_avgprice)
			choose case this.ii_purchasetype
			case 1
				this.id_detail.setitem(ll_row, "packqty", ll_qty)
				this.id_detail.setitem(ll_row, "bonusqty", ll_bonusqty)
				this.id_detail.setitem(ll_row, "purprice", ld_purprice)
				this.id_detail.setitem(ll_row, "unitsalestax", ld_unitsalestax)
				this.id_detail.setitem(ll_row, "salepriceforitem", ld_saleprice)
			case 7
				this.id_detail.setitem(ll_row, "looseqty", ll_qty)
				this.id_detail.setitem(ll_row, "bonusqty", ll_bonusqty)
				this.id_detail.setitem(ll_row, "purprice", ld_purprice)
				this.id_detail.setitem(ll_row, "unitsalestax", ld_unitsalestax)
			case else
				this.id_detail.setitem(ll_row, "looseqty", ll_qty)
				this.id_detail.setitem(ll_row, "bonusqty", ll_bonusqty)
				this.id_detail.setitem(ll_row, "purprice", ld_purprice)
				this.id_detail.setitem(ll_row, "unitsalestax", ld_unitsalestax)
			end choose
			this.id_detail.setitem(ll_row, "gstperc", ld_gstperc)
			this.id_detail.setitem(ll_row, "valueextax", ll_qty * ld_purprice * (1.0 - ld_discperc * 0.01))
			this.id_footer.setitem(1, "stock", ld_godownstock)
			this.id_footer.setitem(1, "totalstock", ld_allgodownstock)
			this.id_footer.setitem(1, "itemtotalval", ls_itemtotalval)
		next
		if this.id_detail.rowcount() > 0 then
			this.im_menu.m_file.m_save.enabled = true
			wf_grandtotal()
			if this.id_master.object.pocode[1] > 0 or long(this.id_master.object.newpurchaseorderno[1]) > 0 then
				wf_show_po_pur_disparity(0)
			end if
		else
			this.im_menu.m_file.m_save.enabled = false
		end if
	end if
	SQL stop USING lt_transobject;

// w_purchase.ue_populate_and_post_from_datacarrydb() returns 0 [event]
	long ll_totrows
	long ll_row
	if wf_iseditable() = false then
		return
	end if
	triggerevent("ue_populate_purchase_from_datacarrydb")
	wf_saveandpost()
	if wf_commitform() = true then
		postevent("ue_new")
	else
		ll_totrows = this.id_detail.rowcount()
		if ll_totrows > 0 then
			for ll_row = 1 to ll_totrows
				triggerevent("ue_deleteitem")
			next
		end if
	end if

// w_purchase.ue_import_purinvoices_from_datacarrydb() returns 0 [event]
	boolean lb_listtab
	integer li_usercode
	string ls_error
	s_arguements lstr_arg
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab and wf_iseditable() = false then
		open(w_populate_purchase_from_datacarrydb)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = 1 then
			li_usercode = gl_usercode
			this.it_transobject.import_purchases_from_datacarrydb(gs_inlinkserver, gs_inlinkserverdb, gs_inlinkserverowner, lstr_arg.l_code1, lstr_arg.l_code2, 0, li_usercode)
			if this.it_transobject.sqlcode = 0 then
				SQL commit USING this.it_transobject;
			else
				ls_error = this.it_transobject.sqlerrtext
				messagebox("Problem in Import Of Purchase Invoices", "Import Of Purchase Invoices from Data Carry Failed. Reasons are:-~r~n" + ls_error, stopsign!)
			end if
		end if
	end if

// w_purchase.ue_pull_sales_from_dropbox() returns 0 [event]
	long ll_icode
	long ll_row
	long ll_saleinvcode
	long ll_sitecode
	long ll_counter
	long ll_qty
	long ll_bonusqty
	long ll_suppcode
	long ll_check_for_basicdata_sync
	boolean retflag = true
	double ld_purprice
	double ld_discperc
	double ld_itemflatdisc
	double ld_saleprice
	double ld_avgprice
	double ld_packsalestax
	double ld_gstperc
	double ld_rpp
	double ld_unitsalestax
	double ld_itempurprice
	double ld_rate
	double ld_rpp2
	double ld_rpp3
	double ld_rpp4
	double ld_rpp5
	double ld_invdiscperc
	double ld_invflatdisc
	double ld_invmisccharges
	double ld_invgstperc1
	double ld_godownstock
	double ld_allgodownstock
	long ll_packunits
	long ll_itemscount
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_batch
	string ls_itemtotalval
	string ls_packingdesc
	string ls_errortext
	string ls_error_syntax
	string ls_connsetting = "Set ANSI_NULLS ON Set ANSI_WARNINGS ON"
	string ls_saleledgerquery
	string ls_saledetailquery
	string ls_newsyntax
	string ls_suppinvcode
	string ls_suppinvcode_tmp
	string ls_machinename
	string ls_prefix
	datetime ldt_expiry
	datastore lds_saleledger
	datastore lds_saledetail
	s_arguements lstr_arguments
	u_transaction lt_transobject
	long ll_totrows
	if wf_iseditable() = false then
		return
	end if
	ll_suppcode = this.id_master.object.suppcode[this.id_master.rowcount()]
	if isnull(ll_suppcode) then
		messagebox("Supplier Validation!", "Kindly Select a supplier first")
		return
	end if
	open(w_pull_sale_from_dropbox)
	lstr_arguments = message.powerobjectparm
	if lstr_arguments.i_status <= 0 then
		return
	end if
	ll_saleinvcode = lstr_arguments.l_code1
	ll_sitecode = lstr_arguments.l_code2
	if ll_saleinvcode > 0 and this.id_master.object.suppcode[this.id_master.rowcount()] > 0 then
		ls_suppinvcode = trim(string(ll_saleinvcode))
		if f_stringpreferences("ForceUniqueSuppInvNoInPur") = "Y" then
			SQL SELECT MAX ( SuppInvCode ) INTO :ls_suppinvcode_tmp FROM PurLedger WHERE SuppCode =:ll_suppcode AND SuppInvCode =:ls_suppinvcode USING sqlca;
			if sqlca.sqlcode = 0 then
				if not isnull(ls_suppinvcode_tmp) then
					messagebox("Supplier Inv. Code Validation!", "Supplier Inv. code already exist.~r~nProbably this invoice is already processed.~r~nKindly select some other invoice")
					return
				end if
			else
				messagebox("Connection Problem", "Unable to Fetch Supplier Invoice Code from database.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
				return
			end if
			return
		end if
		return
	end if
	lt_transobject = create u_transaction
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Problem", "Unable to connect to database.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		return
	end if
	SQL EXECUTE IMMEDIATE :ls_connsetting USING lt_transobject;
	if ll_saleinvcode > 0 then
		setpointer(hourglass!)
		if ll_check_for_basicdata_sync < 0 then
			return
		end if
		lds_saleledger = create datastore
		lds_saledetail = create datastore
		ls_prefix = ""
		if gs_dropbox_server = "" or isnull(gs_dropbox_server) then
			ls_prefix = ""
		else
			ls_prefix = gs_dropbox_server + "."
		end if
		if gs_dropbox_db = "" or isnull(gs_dropbox_db) then
			ls_prefix = ls_prefix
		else
			ls_prefix = ls_prefix + gs_dropbox_db + "."
		end if
		ls_saleledgerquery = "Select ~tSiteCode, TargetSitecode, SaleInvCode, SaleCatCode, CustCode, SalesmanCode, date, DiscPerc, FlatDisc, MiscCharges, SalesTax,  Remarks, CustRefNo, InvGSTPerc1, InvTotal " + "From ~t" + ls_prefix + "dbo." + "DB_SaleLedger " + "Where   Saleinvcode = " + string(ll_saleinvcode) + " AND sitecode = " + string(ll_sitecode) + " AND TargetSiteCode = " + string(gl_sitecode) + " AND Pulled='N'"
		ls_saledetailquery = "Select ~tSiteCode, SaleInvcode, ICode, GCode, Batch, Expiry, LooseQty, PackUnits, SalePrice, AvgPrice, Rate, DiscPerc, SalesTax, RowID, itemflatdisc, SaleItemDescription, UnitSalesTax, GSTPerc, SaleUtn, bonusqty, RowGroup " + "From ~t" + ls_prefix + "dbo." + "DB_SaleDetail " + "Where ~tSaleInvCode = " + string(ll_saleinvcode) + " AND sitecode = " + string(ll_sitecode)
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_saleledgerquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For DB_SaleLedger DataStore")
			return
		else
			ls_error_syntax = ""
			lds_saleledger.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For DB_SaleLedger DataStore")
				return
			end if
		end if
		lds_saleledger.settransobject(lt_transobject)
		if lds_saleledger.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source DB_SaleLedger.")
			return
		end if
		ls_newsyntax = ""
		ls_error_syntax = ""
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_saledetailquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For DB_SaleDetail DataStore")
			return
		else
			ls_error_syntax = ""
			lds_saledetail.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For DB_SaleDetail DataStore")
				return
			end if
		end if
		lds_saledetail.settransobject(lt_transobject)
		if lds_saledetail.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source DB_SaleDetail.")
			return
		end if
		ld_invdiscperc = lds_saleledger.getitemnumber(lds_saleledger.getrow(), "discperc")
		ld_invflatdisc = lds_saleledger.getitemnumber(lds_saleledger.getrow(), "flatdisc")
		ld_invmisccharges = lds_saleledger.getitemnumber(lds_saleledger.getrow(), "misccharges")
		ld_invgstperc1 = lds_saleledger.getitemnumber(lds_saleledger.getrow(), "invgstperc1")
		this.id_master.setitem(1, "suppinvcode", trim(string(ll_saleinvcode)))
		this.id_master.setitem(1, "suppinvdate", lstr_arguments.d_sdate)
		this.id_footer.setitem(1, "discperc", ld_invdiscperc)
		this.id_footer.setitem(1, "flatdisc", ld_invflatdisc)
		this.id_footer.setitem(1, "misccharges", ld_invmisccharges)
		this.id_footer.setitem(1, "invgstperc1", ld_invgstperc1)
		for ll_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_counter = 1 to lds_saledetail.rowcount()
			ll_row = this.id_detail.insertrow(0)
			ll_icode = lds_saledetail.getitemnumber(ll_counter, "icode")
			wf_inititeminfo(ll_icode, ll_counter, ls_errortext)
			ll_qty = lds_saledetail.getitemnumber(ll_counter, "looseqty")
			ll_bonusqty = lds_saledetail.getitemnumber(ll_counter, "bonusqty")
			ld_purprice = lds_saledetail.getitemnumber(ll_counter, "saleprice")
			ld_discperc = lds_saledetail.getitemnumber(ll_counter, "discperc")
			ld_itemflatdisc = lds_saledetail.getitemnumber(ll_counter, "itemflatdisc")
			ld_unitsalestax = lds_saledetail.getitemnumber(ll_counter, "unitsalestax")
			ld_gstperc = lds_saledetail.getitemnumber(ll_counter, "gstperc")
			ls_batch = lds_saledetail.getitemstring(ll_counter, "batch")
			ldt_expiry = lds_saledetail.getitemdatetime(ll_counter, "expiry")
			ld_purprice = ld_purprice - ld_itemflatdisc
			SQL SELECT item.customicode , item.name , item.gcode , item.purprice , item.packsalestax , item.saleprice , item.avgprice , item.recentpurprice , item.recentpurprice2 , recentpurprice3 , recentpurprice4 , recentpurprice5 , item.packingdesc , item.packunits INTO :ls_fullcode, :ls_name, :li_gcode, :ld_itempurprice, :ld_packsalestax, :ld_saleprice, :ld_avgprice, :ld_rpp, :ld_rpp2, :ld_rpp3, :ld_rpp4, :ld_rpp5, :ls_packingdesc, :ll_packunits FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = -1 then
				retflag = false
				ls_errortext = "Database Error: Item information can not be retrieved.~r~nReasons:" + this.it_transobject.sqlerrtext
				messagebox("Item Validation", ls_errortext)
			end if
			if ll_packunits < 1 or isnull(ll_packunits) then
				ll_packunits = 1
			end if
			if this.il_godowncount = 1 and this.il_strategy = 1 then
				this.ii_defaultgcode = this.id_detail.getitemnumber(ll_row, "gcode")
			else
				if this.il_strategy = 2 then
					this.ii_defaultgcode = li_gcode
				end if
				if this.il_strategy = 1 then
					this.ii_defaultgcode = this.id_detail.getitemnumber(ll_row, "gcode")
				end if
			end if
			ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
			this.it_transobject.getitemstocktotal(this.ii_defaultgcode, ll_icode, ld_godownstock)
			this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
			if this.it_transobject.sqlcode = -1 then
				retflag = false
				ls_errortext = "Database Error: Item Stock information can not be retrieved"
			end if
			this.id_detail.setitem(ll_row, "gcode", this.ii_defaultgcode)
			this.id_detail.setitem(ll_row, "icode", ll_icode)
			this.id_detail.setitem(ll_row, this.is_columnitemname, ls_name)
			this.id_detail.setitem(ll_row, "fullcode", ls_fullcode)
			this.id_detail.setitem(ll_row, "packunits", ll_packunits)
			this.id_detail.setitem(ll_row, "discperc", ld_discperc)
			this.id_detail.setitem(ll_row, "saleprice", ld_saleprice)
			this.id_detail.setitem(ll_row, "rate", ld_itempurprice)
			this.id_detail.setitem(ll_row, "itemtotalval", ls_itemtotalval)
			this.id_detail.setitem(ll_row, "stock", ld_godownstock)
			this.id_detail.setitem(ll_row, "totalstock", ld_allgodownstock)
			this.id_detail.setitem(ll_row, "packingdesc", ls_packingdesc)
			this.id_detail.setitem(ll_row, "batch", ls_batch)
			this.id_detail.setitem(ll_row, "expiry", ldt_expiry)
			this.id_footer.object.t_rpp.text = string(ld_rpp) + " , " + string(ld_rpp2) + " , " + string(ld_rpp3) + " , " + string(ld_rpp4) + " , " + string(ld_rpp5)
			this.id_footer.object.t_avgprice.text = string(ld_avgprice)
			choose case this.ii_purchasetype
			case 1
				this.id_detail.setitem(ll_row, "packqty", ll_qty)
				this.id_detail.setitem(ll_row, "bonusqty", ll_bonusqty)
				this.id_detail.setitem(ll_row, "purprice", ld_purprice)
				this.id_detail.setitem(ll_row, "unitsalestax", ld_unitsalestax)
				this.id_detail.setitem(ll_row, "salepriceforitem", ld_saleprice)
			case 7
				this.id_detail.setitem(ll_row, "looseqty", ll_qty)
				this.id_detail.setitem(ll_row, "bonusqty", ll_bonusqty)
				this.id_detail.setitem(ll_row, "purprice", ld_purprice)
				this.id_detail.setitem(ll_row, "unitsalestax", ld_unitsalestax)
			case else
				this.id_detail.setitem(ll_row, "looseqty", ll_qty)
				this.id_detail.setitem(ll_row, "bonusqty", ll_bonusqty)
				this.id_detail.setitem(ll_row, "purprice", ld_purprice)
				this.id_detail.setitem(ll_row, "unitsalestax", ld_unitsalestax)
			end choose
			this.id_detail.setitem(ll_row, "gstperc", ld_gstperc)
			this.id_detail.setitem(ll_row, "valueextax", ll_qty * ld_purprice * (1.0 - ld_discperc * 0.01))
			this.id_footer.setitem(1, "stock", ld_godownstock)
			this.id_footer.setitem(1, "totalstock", ld_allgodownstock)
			this.id_footer.setitem(1, "itemtotalval", ls_itemtotalval)
		next
		if this.id_detail.rowcount() > 0 then
			this.im_menu.m_file.m_save.enabled = true
			wf_grandtotal()
			if this.id_master.object.pocode[1] > 0 or long(this.id_master.object.newpurchaseorderno[1]) > 0 then
				wf_show_po_pur_disparity(0)
			end if
			wf_saveandpost()
			if wf_commitform() = true then
				SQL rollback USING sqlca;
				sqlca.marksaleinvoiceaspulled(ll_sitecode, ll_saleinvcode, gl_usercode, gs_dropbox_server, gs_dropbox_db, "dbo")
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
				else
					SQL rollback USING sqlca;
				end if
				postevent("ue_new")
			else
				ll_totrows = this.id_detail.rowcount()
				if ll_totrows > 0 then
					for ll_row = 1 to ll_totrows
						triggerevent("ue_deleteitem")
					next
				end if
			end if
		else
			this.im_menu.m_file.m_save.enabled = false
		end if
	end if
	SQL stop USING lt_transobject;

// w_purchase.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_listdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_list.dataobject = as_listdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)

// w_purchase.wf_findsuppcode(string as_aliasname, integer ai_suppcode) returns integer
	integer li_suppcode
	integer ll_retflag
	string ls_itemname
	SQL SELECT accounts.acccode INTO :li_suppcode FROM accounts , supplier WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =supplier.suppcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_suppcode = li_suppcode
		if isnull(ai_suppcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_purchase.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_purchase.wf_getpomanfcode(long al_pocode, long al_manfcode) returns 0
	al_pocode = this.id_master.object.pocode[this.id_master.getrow()]
	al_manfcode = this.id_master.object.manfcode[this.id_master.getrow()]

// w_purchase.wf_initmodify(integer ai_protect) returns 0
	long ll_purinvcode
	long ll_gcode
	long ll_icode
	long ll_counter = 1
	long ll_packunits
	long ll_totalpieces
	double ld_looseqty
	double ld_packqty
	double ld_bonusqty
	double ld_saleprice
	double ld_avgprice
	double ld_packsalestax
	double ld_stock
	double ld_totalstock
	string ls_batch
	string ls_itemtotalval
	datetime ld_expiry
	if this.id_master.getitemstring(1, "posted") = "N" then
		this.id_master.setitem(1, "sitecode", gl_sitecode)
		ll_purinvcode = this.id_master.getitemnumber(1, "code")
		if wf_lockpurchaseinvoice(ll_purinvcode) = 0 then
			for ll_counter = 1 to this.id_detail.rowcount()
				ll_gcode = this.id_detail.getitemnumber(ll_counter, "gcode")
				ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
				ld_looseqty = this.id_detail.getitemnumber(ll_counter, "looseqty")
				ld_packqty = this.id_detail.getitemnumber(ll_counter, "packqty")
				ld_bonusqty = this.id_detail.getitemnumber(ll_counter, "bonusqty")
				ll_packunits = this.id_detail.getitemnumber(ll_counter, "packunits")
				ld_stock = this.id_detail.getitemnumber(ll_counter, "stock")
				ld_totalstock = this.id_detail.getitemnumber(ll_counter, "totalstock")
				SQL Select item.saleprice , item.avgprice , item.packsalestax INTO :ld_saleprice, :ld_avgprice, :ld_packsalestax From Item Where item.icode =:ll_icode USING this.it_transobject;
				ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
				this.id_detail.setitem(ll_counter, "itemtotalval", ls_itemtotalval)
				ai_protect = 0
				this.id_footer.setitem(ll_counter, "stock", ld_stock)
				this.id_footer.setitem(ll_counter, "totalstock", ld_totalstock)
			next
			if ai_protect = 0 then
				this.id_footer.setitem(1, "stock", this.id_footer.getitemnumber(1, "stock"))
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
				SQL Select item.saleprice , item.avgprice , item.packsalestax , item.totalpieces INTO :ld_saleprice, :ld_avgprice, :ld_packsalestax, :ll_totalpieces From Item Where item.icode =:ll_icode USING this.it_transobject;
				this.id_footer.object.t_rpp.text = string(ld_saleprice)
				this.id_footer.object.t_avgprice.text = string(ld_avgprice)
				this.id_footer.object.piecesinhand[1] = ll_totalpieces
			end if
		end if
		return
	end if
	ai_protect = 1

// w_purchase.wf_itempurchasehistory() returns 0
	s_itempurchasehistory ls_itempurchasehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itempurchasehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itempurchasehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itempurchasehistory, ls_itempurchasehistory)
	end if

// w_purchase.wf_lockloosepurinvoices(long al_sinvcode, long al_linvcode) returns integer
	integer li_count
	long ll_loopcount
	char lc_isopen = "N"
	for ll_loopcount = al_sinvcode to al_linvcode
		if wf_isinvoiceinuse(ll_loopcount) then
			lc_isopen = "Y"
			exit
		end if
	next
	if lc_isopen = "Y" then
		messagebox("Invoice Validation", "Purchase Invoice ( " + string(ll_loopcount) + " )already in use by some other user.~r~nKindly try again after sometime or post some other invoice.")
		return -1
	end if
	SQL SELECT count ( *) INTO :li_count FROM purledger WITH ( UPDLOCK ) WHERE purledger.purinvcode Between :al_sinvcode and :al_linvcode AND ( purledger.purcatcode =7 or purledger.purcatcode =8 ) AND purledger.ImpactInventory ='Y' USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_purchase.wf_locknormalpurinvoices(long al_sinvcode, long al_linvcode) returns integer
	integer li_count
	long ll_loopcount
	char lc_isopen = "N"
	for ll_loopcount = al_sinvcode to al_linvcode
		if wf_isinvoiceinuse(ll_loopcount) then
			lc_isopen = "Y"
			exit
		end if
	next
	if lc_isopen = "Y" then
		messagebox("Invoice Validation", "Purchase Invoice ( " + string(ll_loopcount) + " )already in use by some other user.~r~nKindly try again after sometime or post some other invoice.")
		return -1
	end if
	SQL SELECT count ( *) INTO :li_count FROM purledger WITH ( UPDLOCK ) WHERE purledger.purinvcode Between :al_sinvcode and :al_linvcode AND ( purledger.purcatcode =1 or purledger.purcatcode =2 ) AND purledger.ImpactInventory ='Y' USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_purchase.wf_lockopeningpurinvoices(long al_sinvcode, long al_linvcode) returns integer
	integer li_count
	long ll_loopcount
	char lc_isopen = "N"
	for ll_loopcount = al_sinvcode to al_linvcode
		if wf_isinvoiceinuse(ll_loopcount) then
			lc_isopen = "Y"
			exit
		end if
	next
	if lc_isopen = "Y" then
		messagebox("Invoice Validation", "Purchase Invoice ( " + string(ll_loopcount) + " )already in use by some other user.~r~nKindly try again after sometime or post some other invoice.")
		return -1
	end if
	SQL SELECT count ( *) INTO :li_count FROM purledger WITH ( UPDLOCK ) WHERE purledger.purinvcode Between :al_sinvcode and :al_linvcode AND purledger.purcatcode =3 AND Purledger.ImpactInventory ='Y' USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_purchase.wf_lockpurchaseinvoice(long al_purinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From purledger WITH ( UPDLOCK HOLDLOCK ) Where purledger.purinvcode =:al_purinvcode AND Purledger.ImpactInventory ='Y' USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_purchase.wf_lockpurinvoices(long al_sinvcode, long al_linvcode) returns integer
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM purledger WITH ( UPDLOCK HOLDLOCK ) WHERE purledger.purinvcode Between :al_sinvcode and :al_linvcode AND purledger.ImpactInventory ='Y' USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_purchase.wf_releaselock(long al_icode) returns boolean
	boolean retflag = true
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM godowndetail ( NOLOCK ) WHERE godowndetail.Gcode =:this.ii_purchasegodownoption AND godowndetail.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_purchase.wf_retrievelistall() returns long
	string[] ls_posted
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	return this.id_list.retrieve(ls_posted, this.il_groupcode, this.ii_module)

// w_purchase.wf_setgodownoption() returns 0
	this.ii_purchasegodownoption = this.id_detail.getitemnumber(1, "gcode")
	if this.il_strategy = 2 or this.il_strategy = 1 and this.il_godowncount = 1 then
		this.id_detail.object.gcode.protect = 1
		this.id_detail.object.gcode.background.color = this.backcolor
	end if

// w_purchase.wf_setpurchasetype(integer ai_purchasetype) returns 0
	if ai_purchasetype <= 2 then
		this.ii_purchasetype = ai_purchasetype
		return
	end if
	if ai_purchasetype = 7 then
		this.ii_purchasetype = 7
		return
	end if
	this.ii_purchasetype = 1

// w_purchase.wf_updateitemavgprice(long al_icode, double ad_newavgprice) returns boolean
	boolean retflag = true
	SQL update item SET item.avgprice =:ad_newavgprice WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_purchase.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	return true

// w_purchase.wf_iteminfo(long al_icode, long al_gcode, double ad_purprice, double ad_discperc, double ad_avgprice, long al_packunits, double al_packsalestax, double al_gstperc, double ad_saleprice) returns boolean
	boolean retflag = true
	SQL SELECT 1 , item.salePrice , item.purdiscperc , item.avgprice , item.packunits , item.saleprice , item.packsalestax , item.gstperc1 INTO :al_gcode, :ad_purprice, :ad_discperc, :ad_avgprice, :al_packunits, :ad_saleprice, :al_packsalestax, :al_gstperc FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	al_gcode = this.ii_purchasegodownoption
	if isnull(ad_purprice) then
		ad_purprice = 0
	elseif isnull(ad_discperc) then
		ad_discperc = 0
	elseif isnull(ad_avgprice) then
		ad_avgprice = 0
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_purchase.wf_setsuppinfo(long al_suppcode, datawindow ad_master) returns 0
	string ls_address
	string ls_city
	string ls_phone
	string ls_aliasname
	string ls_ntn
	long ll_currow
	long ll_dayslimit
	long ll_sitecode
	double ld_currbalance
	SQL SELECT supplier.address1 , supplier.city , supplier.phone , accounts.aliasname , supplier.dayslimit , supplier.ntnno , supplier.sitecode INTO :ls_address, :ls_city, :ls_phone, :ls_aliasname, :ll_dayslimit, :ls_ntn, :ll_sitecode FROM supplier , Accounts WHERE supplier.suppcode =:al_suppcode AND supplier.suppcode =Accounts.AccCode USING this.it_transobject;
	ll_currow = ad_master.getrow()
	ll_currow = 1
	ad_master.object.aliasname[ll_currow] = ls_aliasname
	ad_master.object.address[ll_currow] = ls_address
	ad_master.object.city[ll_currow] = ls_city
	ad_master.object.phone[ll_currow] = ls_phone
	ad_master.object.ntn[ll_currow] = ls_ntn
	ad_master.object.suppbalance[ll_currow] = abs(this.idc_supplierlist.getitemnumber(this.idc_supplierlist.getrow(), "balance"))
	ad_master.object.creditordebit[ll_currow] = this.idc_supplierlist.getitemstring(this.idc_supplierlist.getrow(), "balancetype")
	this.id_master.object.creditdays[ll_currow] = ll_dayslimit
	this.id_master.object.targetsitecode[ll_currow] = ll_sitecode

// w_purchase.wf_setsuppname(string as_data) returns 0
	long ll_rowno
	ll_rowno = this.idc_supplierlist.find("accounts_name >='" + as_data + "'", 1, this.idc_supplierlist.rowcount())
	if ll_rowno > 0 then
		this.idc_supplierlist.selectrow(0, false)
		this.idc_supplierlist.setrow(ll_rowno)
		this.idc_supplierlist.scrolltorow(ll_rowno)
		this.idc_supplierlist.selectrow(ll_rowno, true)
	end if

// w_purchase.wf_setquantity() returns 0
	long ll_rows
	long ll_counter
	double ld_qty
	double[] ld_qtyarr
	if this.id_master.object.posted[this.id_master.rowcount()] = "Y" then
		messagebox("Set Quantity Problem", "You can not set quantity after posting.")
		return
	end if
	ll_rows = this.id_detail.rowcount()
	if ll_rows > 0 then
		openwithparm(w_setquantity, ld_qty)
		ld_qty = message.doubleparm
		if ld_qty > 0.0 then
			for ll_counter = 1 to ll_rows
				ld_qtyarr[ll_counter] = ld_qty
				wf_update_value_extax(ll_counter, ld_qty, this.id_detail.object.purprice[ll_counter], this.id_detail.object.discperc[ll_counter])
			next
			if this.ii_purchasetype = 1 then
				this.id_detail.object.packqty[1, ll_rows] = ld_qtyarr
				return
			end if
			this.id_detail.object.looseqty[1, ll_rows] = ld_qtyarr
		end if
	end if

// w_purchase.wf_updateitempurdisc(long al_icode, double ad_disc) returns integer
	SQL update Item SET PurDiscPerc =:ad_disc WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_purchase.wf_replacesalediscperc(long al_icode, double ad_discperc) returns integer
	if f_numberpreferences("PurReplaceItemSalediscNo") = 1 then
		SQL update Item SET saleDiscPerc =:ad_discperc WHERE Item.icode =:al_icode USING this.it_transobject;
		return this.it_transobject.sqlcode
	end if
	if f_numberpreferences("PurReplaceItemSalediscNo") = 2 then
		SQL update Item SET saleDiscPerc2 =:ad_discperc WHERE Item.icode =:al_icode USING this.it_transobject;
		return this.it_transobject.sqlcode
	end if
	if f_numberpreferences("PurReplaceItemSalediscNo") = 3 then
		SQL update Item SET saleDiscPerc3 =:ad_discperc WHERE Item.icode =:al_icode USING this.it_transobject;
		return this.it_transobject.sqlcode
	end if
	if f_numberpreferences("PurReplaceItemSalediscNo") = 4 then
		SQL update Item SET saleDiscPerc4 =:ad_discperc WHERE Item.icode =:al_icode USING this.it_transobject;
		return this.it_transobject.sqlcode
	end if
	if f_numberpreferences("PurReplaceItemSalediscNo") = 5 then
		SQL update Item SET saleDiscPerc5 =:ad_discperc WHERE Item.icode =:al_icode USING this.it_transobject;
		return this.it_transobject.sqlcode
	end if

// w_purchase.wf_isinvoiceinuse(long al_invoiceno) returns boolean
	long ll_found
	SQL Select count ( *) INTO :ll_found From PurLedger Where PurInvCode =:al_invoiceno and Posted ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_found = 0 or isnull(ll_found) then
			SQL Select count ( *) INTO :ll_found From PurLedger With ( ReadPast , RowLock , UpdLock ) Where PurInvCode =:al_invoiceno USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ll_found = 0 then
					return true
				else
					return false
				end if
			else
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_purchase.wf_retrievelist() returns long
	string[] ls_posted
	long ll_rtcode
	ls_posted[1] = "N"
	if this.ib_showinvoicelist then
		ll_rtcode = this.id_list.retrieve(ls_posted, this.il_groupcode, this.ii_module)
	else
		ll_rtcode = -1
	end if
	return ll_rtcode

// w_purchase.wf_inititeminfo(long al_icode, long al_row, string as_errortext) returns boolean
	boolean retflag = true
	char lc_confirmexpiry = "N"
	char lc_taxable
	double ld_purprice
	double ld_discperc
	double ld_saleprice
	double ld_avgprice
	double ld_packsalestax
	double ld_gstperc
	double ld_rpp
	double ld_purflatdisc
	double ld_taxperc
	double ld_unitsalestax
	double ld_rpp2
	double ld_rpp3
	double ld_rpp4
	double ld_rpp5
	double ld_fp
	double ld_discountedsaleprice
	double ld_itemflatdisc
	double ld_salediscperc
	double ld_godownstock
	double ld_allgodownstock
	double ld_coversionfactor
	double ld_netrate
	double ld_retailprice
	double ld_unitweight
	double ld_packcapacity
	double ld_areavolume
	long ll_packunits
	long ll_totalpieces
	long ll_manfcode
	long ll_taxcatcode
	long ll_pctcode
	long ll_salestaxschedulecode
	long ll_itemalertcode
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_itemtotalval
	string ls_packingdesc
	string ls_remarks
	string ls_alternatecustomicode
	string ls_null
	string ls_location
	datetime ldt_expiry
	setnull(ldt_expiry)
	setnull(ls_null)
	if this.id_master.rowcount() > 0 then
		ll_taxcatcode = this.id_master.object.taxcategorycode[1]
		SQL SELECT taxperc INTO :ld_taxperc FROM TaxCategory WHERE TaxCategoryCode =:ll_taxcatcode USING this.it_transobject;
	end if
	if ld_taxperc < 0.0 or isnull(ld_taxperc) then
		ld_taxperc = 0
	end if
	SQL SELECT item.customicode , item.name , item.purprice , item.packunits , item.purdiscperc , item.gcode , item.saleprice , item.avgprice , item.packsalestax , item.gstperc1 , item.recentpurprice , Round ( item.packsalestax / item.packunits , 2 ) , item.recentpurprice2 , recentpurprice3 , recentpurprice4 , recentpurprice5 , item.packingdesc , item.totalpieces , item.remarks , item.manfcode , item.foreignprice , item.discountedsaleprice , item.flatdisc , item.confirmexpiry , item.retailprice , item.unitweight , item.packcapacity , item.areavolume , item.salediscperc , item.location , item.purflatdisc , item.taxable , item.pctcode , item.salestaxschedulecode , item.itemalertcode INTO :ls_fullcode, :ls_name, :ld_purprice, :ll_packunits, :ld_discperc, :li_gcode, :ld_saleprice, :ld_avgprice, :ld_packsalestax, :ld_gstperc, :ld_rpp, :ld_unitsalestax, :ld_rpp2, :ld_rpp3, :ld_rpp4, :ld_rpp5, :ls_packingdesc, :ll_totalpieces, :ls_remarks, :ll_manfcode, :ld_fp, :ld_discountedsaleprice, :ld_itemflatdisc, :lc_confirmexpiry, :ld_retailprice, :ld_unitweight, :ld_packcapacity, :ld_areavolume, :ld_salediscperc, :ls_location, :ld_purflatdisc, :lc_taxable, :ll_pctcode, :ll_salestaxschedulecode, :ll_itemalertcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	ld_coversionfactor = this.id_master.object.conversionfactor[1]
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.ii_defaultgcode = this.id_detail.getitemnumber(al_row, "gcode")
	else
		if this.il_strategy = 2 then
			this.ii_defaultgcode = li_gcode
		end if
		if this.il_strategy = 1 then
			this.ii_defaultgcode = this.id_detail.getitemnumber(al_row, "gcode")
		end if
	end if
	ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
	this.it_transobject.getitemstocktotal(this.ii_defaultgcode, al_icode, ld_godownstock)
	this.it_transobject.getitemstockinallowedgodown(al_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	ls_alternatecustomicode = this.id_detail.object.alternatecustomicode[al_row]
	if isnull(ls_alternatecustomicode) then
		ls_alternatecustomicode = ""
	end if
	if lower(ls_fullcode) = lower(ls_alternatecustomicode) then
		ls_alternatecustomicode = ls_null
		this.id_detail.object.alternatecustomicode[al_row] = ls_null
	end if
	this.id_detail.setitem(al_row, "basicpackunits", ll_packunits)
	this.id_detail.setitem(al_row, "gcode", this.ii_defaultgcode)
	this.id_detail.setitem(al_row, "icode", al_icode)
	this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
	this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
	this.id_detail.setitem(al_row, "piecesinhand", ll_totalpieces)
	this.id_detail.setitem(al_row, "taxable", lc_taxable)
	if this.ic_advancetaxonpur = "Y" and lc_taxable = "Y" then
		this.id_detail.object.itemadvancetaxperc[al_row] = ld_taxperc
	else
		this.id_detail.object.itemadvancetaxperc[al_row] = 0.00
	end if
	if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) or this.id_detail.object.packunits[al_row] <= 0 then
		this.id_detail.setitem(al_row, "packunits", ll_packunits)
	end if
	if this.ii_purchasetype = 1 then
		this.id_detail.setitem(al_row, "discperc", ld_discperc)
		this.id_detail.setitem(al_row, "retailprice", ld_retailprice)
	end if
	this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
	this.id_detail.setitem(al_row, "rate", ld_purprice)
	this.id_detail.setitem(al_row, "itemtotalval", ls_itemtotalval)
	this.id_detail.setitem(al_row, "manfcodeforitem", ll_manfcode)
	this.id_detail.setitem(al_row, "discountedsaleprice", ld_discountedsaleprice)
	this.id_detail.setitem(al_row, "unitweight", ld_unitweight)
	this.id_detail.setitem(al_row, "salediscperc", ld_salediscperc)
	this.id_detail.setitem(al_row, "salestaxschedulecode", ll_salestaxschedulecode)
	this.id_detail.setitem(al_row, "pctcode", ll_pctcode)
	this.id_detail.setitem(al_row, "itemalertcode", ll_itemalertcode)
	if upper(lc_confirmexpiry) = "Y" then
		this.id_detail.setitem(al_row, "expiry", ldt_expiry)
	end if
	this.id_detail.setitem(al_row, "stock", ld_godownstock)
	this.id_detail.setitem(al_row, "godownstock", ld_godownstock)
	this.id_detail.setitem(al_row, "totalstock", ld_allgodownstock)
	this.id_detail.setitem(al_row, "packingdesc", ls_packingdesc)
	this.id_footer.object.t_rpp.text = string(ld_rpp) + " , " + string(ld_rpp2) + " , " + string(ld_rpp3) + " , " + string(ld_rpp4) + " , " + string(ld_rpp5)
	this.id_footer.object.t_avgprice.text = string(ld_avgprice)
	this.id_detail.setitem(al_row, "itemflatdisc", ld_purflatdisc)
	choose case this.ii_purchasetype
	case 1
		if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) then
			if f_stringpreferences("salepriceinpackpur") = "Y" then
				this.id_detail.setitem(al_row, "prediscprice", ld_saleprice)
				this.id_detail.setitem(al_row, "purprice", ld_saleprice - ld_itemflatdisc)
			else
				this.id_detail.setitem(al_row, "prediscprice", ld_purprice)
				this.id_detail.setitem(al_row, "purprice", ld_purprice - ld_purflatdisc)
			end if
		end if
		this.id_detail.setitem(al_row, "salepriceforitem", ld_saleprice)
		this.id_detail.setitem(al_row, "unitsalestax", ld_packsalestax)
		this.id_detail.setitem(al_row, "flatdiscforitem", ld_itemflatdisc)
		this.id_detail.setitem(al_row, "foreignprice", ld_fp)
		if ld_fp <> 0.0 then
			if f_stringpreferences("salepriceinpackpur") = "Y" then
				this.id_detail.setitem(al_row, "prediscprice", ld_saleprice)
				this.id_detail.setitem(al_row, "purprice", ld_saleprice - ld_itemflatdisc)
			else
				this.id_detail.setitem(al_row, "prediscprice", ld_fp * ld_coversionfactor)
				this.id_detail.setitem(al_row, "purprice", ld_fp * ld_coversionfactor - ld_purflatdisc)
			end if
		end if
	case 7
		if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) then
			if f_stringpreferences("priceinloosepur") = "Y" then
				this.id_detail.setitem(al_row, "prediscprice", ld_purprice / ll_packunits)
				this.id_detail.setitem(al_row, "purprice", ld_purprice / ll_packunits - ld_purflatdisc)
			else
				this.id_detail.setitem(al_row, "prediscprice", ld_saleprice)
				this.id_detail.setitem(al_row, "purprice", ld_saleprice / ll_packunits - ld_itemflatdisc)
			end if
		end if
		this.id_detail.setitem(al_row, "salepriceforitem", ld_saleprice / ll_packunits)
		this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
		this.id_detail.setitem(al_row, "foreignprice", ld_fp)
		if ld_fp <> 0.0 then
			this.id_detail.setitem(al_row, "purprice", ld_fp * ld_coversionfactor - ld_purflatdisc)
			this.id_detail.setitem(al_row, "prediscprice", ld_fp * ld_coversionfactor)
		end if
	case else
		this.id_detail.setitem(al_row, "salepriceforitem", ld_saleprice / ll_packunits)
		this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
		if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) then
			this.id_detail.setitem(al_row, "prediscprice", ld_purprice / ll_packunits)
			this.id_detail.setitem(al_row, "purprice", ld_purprice / ll_packunits - ld_purflatdisc)
		end if
		this.id_detail.setitem(al_row, "foreignprice", ld_fp)
		if ld_fp <> 0.0 then
			this.id_detail.setitem(al_row, "prediscprice", ld_fp * ld_coversionfactor)
			this.id_detail.setitem(al_row, "purprice", ld_fp * ld_coversionfactor - ld_purflatdisc)
		end if
	end choose
	if this.ic_advancetaxonpur = "Y" and lc_taxable = "Y" then
		this.id_detail.object.itemadvancetaxperc[al_row] = ld_taxperc
	else
		this.id_detail.object.itemadvancetaxperc[al_row] = 0.00
	end if
	wf_fetchbatchsaleprice(al_icode, this.id_detail.object.batch[al_row], this.id_detail.object.expiry[al_row], al_row)
	if this.id_detail.object.batchsaleprice[al_row] <= 0 or isnull(this.id_detail.object.batchsaleprice[al_row]) then
		this.id_detail.setitem(al_row, "batchsaleprice", ld_saleprice)
	end if
	if f_stringpreferences("pur_copyremarksinitemdesc") = "Y" and this.id_detail.getitemstatus(al_row, "itemdescription", primary!) = notmodified! then
		this.id_detail.setitem(al_row, "itemdescription", ls_remarks)
	end if
	if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
		ld_areavolume = 1
	end if
	if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
		ld_packcapacity = 1
	end if
	this.id_detail.setitem(al_row, "location", ls_location)
	this.id_detail.setitem(al_row, "packcapacity", ld_packcapacity)
	this.id_detail.setitem(al_row, "areavolume", ld_areavolume)
	if this.ii_purchasetype = 1 then
		this.id_detail.setitem(al_row, "pcs", round(this.id_detail.object.packqty[al_row] / ld_areavolume, 6))
	else
		this.id_detail.setitem(al_row, "pcs", round(this.id_detail.object.looseqty[al_row] / ld_areavolume, 6))
	end if
	this.id_detail.setitem(al_row, "cartons", trim(string(long(this.id_detail.object.pcs[al_row] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[al_row] mod ld_packcapacity, 2))))))
	wf_set_po_values(al_row)
	this.id_detail.setitem(al_row, "gstperc", ld_gstperc)
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_allgodownstock)
	this.id_footer.setitem(1, "piecesinhand", ll_totalpieces)
	this.id_footer.setitem(1, "itemtotalval", ls_itemtotalval)
	wf_update_value_extax(al_row, this.id_detail.object.packqty[al_row] + this.id_detail.object.looseqty[al_row], this.id_detail.object.purprice[al_row], ld_discperc)
	wf_set_itemimage(al_icode)
	if this.ic_fetchlastunitsalestax = "Y" then
		wf_fetch_latest_unitsalestax(al_icode, al_row)
	end if
	wf_set_batch_expiry_lockstatus(this.id_detail.getitemnumber(al_row, "gcode"), al_icode, this.id_detail.object.batch[al_row], this.id_detail.object.expiry[al_row])
	return retflag

// w_purchase.wf_fetchserverdate(boolean ab_checked) returns long
	if ab_checked then
		this.ib_fetchserverdate = true
	else
		this.ib_fetchserverdate = false
	end if
	return 0

// w_purchase.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_purchase.wf_setamountoninvoice() returns 0
	long ll_null
	long ll_rightfound
	double ld_netamt
	double ld_null
	string ls_null
	s_amountoninvoice lstr_amountoninvoice
	setnull(ld_null)
	setnull(ls_null)
	setnull(ll_null)
	if this.id_master.getitemstring(1, "accountfor") = "Y" then
		ld_netamt = wf_grandtotal()
		if f_stringpreferences("AskAmtOnPurchase") = "Y" then
			ll_rightfound = 0
			ll_rightfound = gds_securitywindow.find("rightcode = 584", 1, gds_securitywindow.rowcount())
			lstr_amountoninvoice.l_invcode = this.id_master.getitemnumber(1, "code")
			lstr_amountoninvoice.d_netamt = ld_netamt
			lstr_amountoninvoice.d_amt = this.id_master.getitemdecimal(1, "amt")
			if isnull(lstr_amountoninvoice.d_amt) then
				lstr_amountoninvoice.d_balance = ld_netamt
			else
				lstr_amountoninvoice.d_balance = ld_netamt - lstr_amountoninvoice.d_amt
			end if
			if isnull(this.id_master.getitemstring(1, "paymentmode")) then
				this.id_master.setitem(1, "paymentmode", f_stringpreferences("PurchasePaymentMode"))
				this.id_master.setitem(1, "paymentacccode", f_numberpreferences("PurchasePaymentAcccode"))
			end if
			lstr_amountoninvoice.c_paymentmode = this.id_master.getitemstring(1, "paymentmode")
			lstr_amountoninvoice.i_acccode = this.id_master.getitemnumber(1, "paymentacccode")
			lstr_amountoninvoice.s_reference = this.id_master.getitemstring(1, "amtreference")
			lstr_amountoninvoice.s_module = "purchase"
			if ll_rightfound > 0 then
				openwithparm(w_amountoninvoice, lstr_amountoninvoice)
				lstr_amountoninvoice = message.powerobjectparm
				this.id_master.setitem(1, "amt", lstr_amountoninvoice.d_amt)
				this.id_master.setitem(1, "paymentmode", lstr_amountoninvoice.c_paymentmode)
				this.id_master.setitem(1, "paymentacccode", lstr_amountoninvoice.i_acccode)
				this.id_master.setitem(1, "amtreference", lstr_amountoninvoice.s_reference)
			end if
			if ld_netamt - lstr_amountoninvoice.d_amt >= 0.0 then
				this.id_master.setitem(1, "outstandingamt", ld_netamt - lstr_amountoninvoice.d_amt)
			else
				this.id_master.setitem(1, "outstandingamt", 0)
			end if
		else
			this.id_master.setitem(1, "outstandingamt", ld_netamt)
			this.id_master.setitem(1, "paymentmode", ls_null)
			this.id_master.setitem(1, "paymentacccode", ll_null)
			this.id_master.setitem(1, "amtreference", ls_null)
			this.id_master.setitem(1, "amt", 0)
		end if
		return
	end if
	this.id_master.setitem(1, "outstandingamt", 0)
	this.id_master.setitem(1, "paymentmode", ls_null)
	this.id_master.setitem(1, "paymentacccode", ll_null)
	this.id_master.setitem(1, "amtreference", ls_null)
	this.id_master.setitem(1, "amt", 0)

// w_purchase.wf_getitemsaleprice(long al_icode, double ad_saleprice) returns boolean
	boolean retflag = true
	SQL SELECT item.salePrice INTO :ad_saleprice FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if isnull(ad_saleprice) then
		ad_saleprice = 0
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_purchase.wf_setcurrency(long al_currencycode) returns long
	long ll_currow
	long ll_retcode
	double ld_conversionfactor
	SQL SELECT ConversionFactor INTO :ld_conversionfactor FROM Currency WHERE Currency.Currencycode =:al_currencycode USING this.it_transobject;
	ll_retcode = 1
	if this.it_transobject.sqlcode = 0 then
		if ld_conversionfactor < 0.0 then
			ll_retcode = 0
		else
			ll_currow = this.id_master.getrow()
			ll_currow = 1
			this.id_master.object.conversionfactor[ll_currow] = ld_conversionfactor
			if wf_applycurrency(ld_conversionfactor) <= 0 then
				ll_retcode = 0
			end if
		end if
	else
		ll_retcode = 0
	end if
	wf_grandtotal()
	return ll_retcode

// w_purchase.wf_applycurrency(double ad_conversionfactor) returns long
	long ll_detail_rowcount
	long ll_counter
	long ld_purprice
	long ll_packunits
	long ll_retcode
	long ll_icode
	integer li_retmsgcode
	double ld_saleprice
	double ld_foreignprice
	double ld_newprice
	ll_detail_rowcount = this.id_detail.rowcount()
	ll_retcode = 1
	if ll_detail_rowcount > 0 then
		wf_deleteemptydetailrow()
		ll_detail_rowcount = this.id_detail.rowcount()
		for ll_counter = 1 to ll_detail_rowcount
			ll_icode = this.id_detail.object.icode[ll_counter]
			ld_purprice = this.id_detail.object.purprice[ll_counter]
			ld_foreignprice = this.id_detail.object.foreignprice[ll_counter]
			ll_packunits = this.id_detail.object.packunits[ll_counter]
			if ll_packunits = 0 or isnull(ll_packunits) then
				ll_packunits = 1
			end if
			if wf_getitemsaleprice(ll_icode, ld_saleprice) = true then
				choose case this.ii_purchasetype
				case 1
					ld_newprice = round(ld_foreignprice * ad_conversionfactor, 2)
				case else
					ld_newprice = round(ld_foreignprice * ad_conversionfactor, 2)
				end choose
				if ll_retcode = 1 then
					this.id_detail.object.purprice[ll_counter] = ld_newprice
				end if
			else
				ll_retcode = 0
				exit
			end if
			wf_update_value_extax(ll_counter, this.id_detail.object.looseqty[ll_counter] + this.id_detail.object.packqty[ll_counter], this.id_detail.object.purprice[ll_counter], this.id_detail.object.discperc[ll_counter])
		next
	end if
	wf_grandtotal()
	return ll_retcode

// w_purchase.wf_validateitem() returns integer
	long ll_icode
	long ll_gcode
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	string ls_fullcode
	string ls_errtext
	string ls_titleerrtext
	integer il_errcode = 1
	integer li_errcode
	boolean lb_invalidrow
	integer li_null
	string ls_null
	if isnull(this.il_currrow) or this.il_currrow <= 0 then
		lb_invalidrow = true
	else
		ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	end if
	if lb_invalidrow = false and wf_genfullcode(ll_icode, ls_fullcode) > 0 then
		this.id_detail.object.fullcode[this.il_currrow] = ls_fullcode
		if not wf_inititeminfo(ll_icode, this.il_currrow, ls_errtext) then
			ls_titleerrtext = "Item Validation"
			li_errcode = -1
		end if
	else
		il_errcode = -1
	end if
	this.ib_itemvalidated = true
	if lb_invalidrow = true then
		il_errcode = -1
	elseif il_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
	end if
	return il_errcode

// w_purchase.wf_populatedetaildwfrompo(long al_pocode, long al_manfcode) returns integer
	datastore lds_podetail
	datawindowchild ldc_itemdddw
	long ll_detailrows
	long ll_count
	long ll_duplrows
	long ll_potypecode
	long ll_icatcode
	integer li_result
	integer li_rtncode
	boolean populateflag = true
	double ld_godownstock
	double ld_allgodownstock
	string ls_errortext
	string ls_poremarks
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_stock
	long ll_packunits
	long ll_retrievecount
	long ll_lockedcount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packsalestax
	double ld_gstperc
	string ls_fullcode
	if this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate Purchase order after posting!")
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	SQL SELECT Remarks , purtypecode , icatcode INTO :ls_poremarks, :ll_potypecode, :ll_icatcode FROM PurOrderHeader WHERE purorderheader.pocode =:al_pocode USING this.it_transobject;
	this.id_master.setitem(1, "remarks", ls_poremarks)
	this.id_master.setitem(1, "purtypecode", ll_potypecode)
	this.id_master.setitem(1, "icatcode", ll_icatcode)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 and not isnull(this.id_detail.object.icode[1]) then
		li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
		if li_result = 1 then
			for ll_count = 1 to ll_detailrows
				this.id_detail.deleterow(0)
			next
			if this.id_detail.update() <> 1 then
				messagebox("DataBase Problem", "Problem in Deleting Rows")
				return 0
			end if
			this.id_detail.reset()
		else
			populateflag = false
		end if
	end if
	if populateflag = true then
		lds_podetail = create datastore
		lds_podetail.dataobject = "d_populatepurorder"
		lds_podetail.settransobject(this.it_transobject)
		this.id_detail.reset()
		ll_rtcode = lds_podetail.retrieve(al_pocode)
		ll_rowcount = lds_podetail.rowcount()
		if ll_rowcount > 0 then
			this.id_master.object.currencycode[1] = lds_podetail.object.currencycode[1]
			this.id_master.object.conversionfactor[1] = lds_podetail.object.conversionfactor[1]
		end if
		for ll_count = 1 to ll_rowcount
			this.id_detail.insertrow(0)
			ll_icode = lds_podetail.object.icode[ll_count]
			ll_gcode = lds_podetail.object.gcode[ll_count]
			this.id_detail.object.fullcode[ll_count] = lds_podetail.object.fullcode[ll_count]
			this.id_detail.object.alternatecustomicode[ll_count] = lds_podetail.object.alternatecustomicode[ll_count]
			this.id_detail.object.packunits[ll_count] = lds_podetail.object.packunits[ll_count]
			if wf_inititeminfo(ll_icode, ll_count, ls_errortext) then
				this.id_detail.object.batch[ll_count] = f_stringpreferences("defaultbatch")
				this.id_detail.object.expiry[ll_count] = f_datepreferences("defaultexpiry")
				this.id_detail.object.packqty[ll_count] = lds_podetail.object.reqqty[ll_count]
				this.id_detail.object.foreignprice[ll_count] = lds_podetail.object.foreignprice[ll_count]
				this.id_detail.object.alternatecustomicode[ll_count] = lds_podetail.object.alternatecustomicode[ll_count]
				this.id_detail.object.packunits[ll_count] = lds_podetail.object.packunits[ll_count]
				if f_stringpreferences("bonusinpurchase") = "Y" then
					this.id_detail.object.bonusqty[ll_count] = lds_podetail.object.reqbonusqty[ll_count]
				end if
				if f_stringpreferences("salepriceinpackpur") = "Y" then
					this.id_detail.object.purprice[ll_count] = lds_podetail.object.saleprice[ll_count]
				else
					this.id_detail.object.purprice[ll_count] = lds_podetail.object.rate[ll_count]
				end if
				this.id_detail.object.foreignprice[ll_count] = lds_podetail.object.foreignprice[ll_count]
				if f_stringpreferences("replacepopricewithlatestitemprice") = "N" then
					this.id_detail.object.purprice[ll_count] = lds_podetail.object.rate[ll_count]
				end if
				this.id_detail.object.discperc[ll_count] = lds_podetail.object.discperc[ll_count]
				this.id_footer.object.discperc[this.id_footer.getrow()] = lds_podetail.object.invleveldiscperc[ll_count]
				this.id_footer.object.invgstperc1[1] = lds_podetail.object.invgstperc1[1]
				this.id_detail.setitemstatus(ll_count, "purprice", primary!, notmodified!)
				ll_retrievecount = ll_retrievecount + 1
			else
				ll_lockedcount = ll_lockedcount + 1
			end if
			wf_update_value_extax(ll_count, this.id_detail.object.looseqty[ll_count] + this.id_detail.object.packqty[ll_count], this.id_detail.object.purprice[ll_count], this.id_detail.object.discperc[ll_count])
			ll_duplrows = ll_duplrows + 1
		next
		destroy lds_podetail
	end if
	if ll_retrievecount = ll_rowcount then
		messagebox("Result", "Purchase Order retrieval is Successfull~n~r" + string(ll_rowcount) + " Items are retrieved. ")
	else
		messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " records are retrieved successfully~n~r" + string(ll_duplrows) + " records are duplicate so are not retrieved~n~r" + string(ll_lockedcount) + " records are in error")
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_purchase.wf_populatefiltereditems() returns integer
	datastore lds_itemselected
	long ll_detailrows
	long ll_count
	long ll_duplrows
	double ld_godownstock
	double ld_allgodownstock
	integer li_result
	integer li_rtncode
	boolean populateflag = true
	s_arguements lstr_selecteditems
	string ls_itemtotalval
	string ls_errortext
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_packunits
	double ld_stock
	long ll_retrievecount
	long ll_lockedcount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packsalestax
	double ld_gstperc
	string ls_fullcode
	if this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate items after posting!")
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		if not isnull(this.id_detail.object.icode[1]) then
			li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
			if li_result = 1 then
				for ll_count = 1 to ll_detailrows
					this.id_detail.deleterow(0)
				next
				if this.id_detail.update() <> 1 then
					messagebox("DataBase Problem", "Problem in Deleting Rows")
					return 0
				end if
			else
				populateflag = false
			end if
		else
			this.id_detail.reset()
		end if
	end if
	if populateflag = true then
		openwithparm(w_arg_item_populate3, this.ii_module)
		lstr_selecteditems = message.powerobjectparm
		this.id_detail.reset()
		lds_itemselected = create datastore
		if lstr_selecteditems.s_name2 = "OR" then
			lds_itemselected.dataobject = "d_populateditems_active"
		else
			lds_itemselected.dataobject = "d_populateditems_active_and"
		end if
		lds_itemselected.settransobject(this.it_transobject)
		this.id_detail.reset()
		ll_rtcode = lds_itemselected.retrieve(lstr_selecteditems.ia_integerlist, lstr_selecteditems.ia_integerlist1, lstr_selecteditems.ia_integerlist2, lstr_selecteditems.la_longlist, lstr_selecteditems.l_code1, lstr_selecteditems.s_name1)
		ll_rowcount = lds_itemselected.rowcount()
		for ll_count = 1 to ll_rowcount
			this.id_detail.insertrow(0)
			ll_icode = lds_itemselected.object.icode[ll_count]
			if wf_inititeminfo(ll_icode, ll_count, ls_errortext) then
				this.id_detail.object.batch[ll_count] = f_stringpreferences("defaultbatch")
				this.id_detail.object.expiry[ll_count] = f_datepreferences("defaultexpiry")
				if this.ii_purchasetype = 1 then
					this.id_detail.object.packqty[ll_count] = lds_itemselected.object.qty[ll_count]
					this.id_detail.object.salepriceforitem[ll_count] = lds_itemselected.object.saleprice[ll_count]
				else
					this.id_detail.object.looseqty[ll_count] = lds_itemselected.object.qty[ll_count]
				end if
			end if
			wf_update_value_extax(ll_count, this.id_detail.object.looseqty[ll_count] + this.id_detail.object.packqty[ll_count], this.id_detail.object.purprice[ll_count], this.id_detail.object.discperc[ll_count])
			ll_retrievecount = ll_retrievecount + 1
		next
		destroy lds_itemselected
		if ll_retrievecount = ll_rowcount then
			messagebox("Result", string(ll_rowcount) + " Items are populated. ")
		else
			messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " records are retrieved successfully~n~r" + string(ll_duplrows) + " records are duplicate so are not retrieved~n~r" + string(ll_lockedcount) + " records are in error")
		end if
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_purchase.wf_populatepurorder() returns integer
	datastore lds_itemselected
	integer li_result
	integer li_rtncode
	boolean populateflag = true
	s_saletemplate lstr_template
	string ls_itemtotalval
	string ls_fullcode
	string ls_errortext
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_retrievecount
	long ll_lockedcount
	long ll_detailrows
	long ll_count
	long ll_duplrows
	long ll_purordercount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packsalestax
	double ld_gstperc
	double ld_unitsalestax
	double ld_godownstock
	double ld_allgodownstock
	double ld_stock
	if this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate items after posting!")
		return 0
	end if
	setpointer(hourglass!)
	this.id_detail.setredraw(false)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		if not isnull(this.id_detail.object.icode[1]) then
			li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
			if li_result = 1 then
				for ll_count = 1 to ll_detailrows
					this.id_detail.deleterow(0)
				next
				if this.id_detail.update() <> 1 then
					messagebox("DataBase Problem", "Problem in Deleting Rows")
					return 0
				end if
			else
				populateflag = false
			end if
		else
			this.id_detail.reset()
		end if
	end if
	if populateflag = true then
		open(w_copypurinvoicefrom)
		lstr_template = message.powerobjectparm
		if lstr_template.b_userinput = true then
			setpointer(hourglass!)
			lds_itemselected = create datastore
			lds_itemselected.dataobject = "d_populatepurorder"
			lds_itemselected.settransobject(this.it_transobject)
			this.id_detail.reset()
			ll_rtcode = lds_itemselected.retrieve(lstr_template.l_invtemplate)
			ll_rowcount = lds_itemselected.rowcount()
			ll_gcode = this.ii_purchasegodownoption
			if this.ii_purchasetype = 1 then
				this.id_master.setitem(this.id_master.getrow(), "pocode", lstr_template.l_invtemplate)
				this.id_master.setitem(this.id_master.getrow(), "podate", datetime(lstr_template.d_date))
				if ll_rowcount > 0 then
					this.id_master.object.currencycode[1] = lds_itemselected.object.currencycode[1]
					this.id_master.object.conversionfactor[1] = lds_itemselected.object.conversionfactor[1]
				end if
			end if
			for ll_count = 1 to ll_rowcount
				this.id_detail.insertrow(0)
				ll_icode = lds_itemselected.object.icode[ll_count]
				ll_gcode = lds_itemselected.object.gcode[ll_count]
				if wf_inititeminfo(ll_icode, ll_count, ls_errortext) then
					if this.ii_purchasegodownoption = 2 then
						ll_gcode = lds_itemselected.object.gcode[ll_count]
					end if
					this.id_detail.object.gcode[ll_count] = ll_gcode
					this.id_detail.object.batch[ll_count] = f_stringpreferences("defaultbatch")
					this.id_detail.object.expiry[ll_count] = f_datepreferences("defaultexpiry")
					if this.ii_purchasetype = 1 then
						this.id_detail.object.packqty[ll_count] = lds_itemselected.object.qty[ll_count]
					else
						this.id_detail.object.looseqty[ll_count] = lds_itemselected.object.qty[ll_count] * lds_itemselected.object.packunits[ll_count]
					end if
					this.id_detail.object.foreignprice[ll_count] = lds_itemselected.object.foreignprice[ll_count]
					if f_stringpreferences("salepriceinpackpur") = "Y" then
						if this.ii_purchasetype = 1 then
							this.id_detail.object.purprice[ll_count] = lds_itemselected.object.saleprice[ll_count]
						else
							this.id_detail.object.purprice[ll_count] = lds_itemselected.object.saleprice[ll_count] / lds_itemselected.object.packunits[ll_count]
						end if
					elseif this.ii_purchasetype = 1 then
						this.id_detail.object.purprice[ll_count] = lds_itemselected.object.rate[ll_count]
					else
						this.id_detail.object.purprice[ll_count] = lds_itemselected.object.rate[ll_count] / lds_itemselected.object.packunits[ll_count]
					end if
					if this.ii_purchasetype = 1 then
						this.id_detail.object.unitsalestax[ll_count] = lds_itemselected.object.packsalestax[ll_count]
						this.id_detail.object.discperc[ll_count] = lds_itemselected.object.discperc[ll_count]
					else
						ld_unitsalestax = round(lds_itemselected.object.packsalestax[ll_count] / lds_itemselected.object.packunits[ll_count], 2)
						this.id_detail.object.unitsalestax[ll_count] = ld_unitsalestax
					end if
					this.id_detail.object.gstperc[ll_count] = lds_itemselected.object.gstperc[ll_count]
					this.id_detail.setitemstatus(ll_count, "purprice", primary!, notmodified!)
					ll_retrievecount = ll_retrievecount + 1
				end if
				wf_update_value_extax(ll_count, this.id_detail.object.looseqty[ll_count] + this.id_detail.object.packqty[ll_count], this.id_detail.object.purprice[ll_count], this.id_detail.object.discperc[ll_count])
			next
			destroy lds_itemselected
		end if
		if ll_retrievecount = ll_rowcount then
			messagebox("Result", string(ll_rowcount) + " Items are populated. ")
		else
			messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " records are retrieved successfully~n~r" + string(ll_duplrows) + " records are duplicate so are not retrieved~n~r" + string(ll_lockedcount) + " records are in error")
		end if
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_purchase.wf_showaccountledger() returns 0
	long ll_acccode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_acccode = this.id_master.object.suppcode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_acccode = this.id_list.object.suppcode[this.id_list.getrow()]
	end if
	if not isnull(ll_acccode) and ll_acccode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_account_ledger, ll_acccode)
	end if

// w_purchase.wf_showsummaryaccountbalance() returns 0
	long ll_acccode
	if wf_iseditable() = false then
		return
	end if
	if this.tab_retrieve.selectedtab = 1 then
		ll_acccode = this.id_master.getitemnumber(this.id_master.getrow(), "suppcode")
		if not isnull(ll_acccode) and this.id_master.rowcount() > 0 then
			openwithparm(w_summaccount_balance, ll_acccode)
		end if
	end if

// w_purchase.wf_selectprintreport(string as_pagesize) returns string
	string ls_report
	if as_pagesize = "F" then
		if gs_company = "ALNASEEB" then
			ls_report = "d_alnaseeb_purchaseinvprintout"
		elseif gs_company = "ALHARMAINLIGHTS" then
			ls_report = "d_alharmainlights_purchaseinvprintout"
		elseif gs_company = "ALQAMARPHARMACY" then
			ls_report = "d_alqamarpharmacy_purinvreport"
