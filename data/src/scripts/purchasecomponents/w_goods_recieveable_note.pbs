// window w_goods_recieveable_note (purchasecomponents)  ancestor: w_multi_entry

// w_goods_recieveable_note.wf_lockpurchaseinvoice(long al_purinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From purledger WITH ( UPDLOCK HOLDLOCK ) Where purledger.purinvcode =:al_purinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_goods_recieveable_note.wf_lockloosepurinvoices(long al_sinvcode, long al_linvcode) returns integer
	integer li_count
	SQL SELECT count ( *) INTO :li_count FROM purledger WITH ( UPDLOCK HOLDLOCK ) WHERE purledger.purinvcode Between :al_sinvcode and :al_linvcode AND ( purledger.purcatcode =7 or purledger.purcatcode =8 ) USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_goods_recieveable_note.wf_updateitempurdisc(long al_icode, double ad_disc) returns integer
	SQL update Item SET PurDiscPerc =:ad_disc WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_goods_recieveable_note.wf_locknormalpurinvoices(long al_sinvcode, long al_linvcode) returns integer
	integer li_count
	SQL SELECT count ( *) INTO :li_count FROM purledger WITH ( UPDLOCK HOLDLOCK ) WHERE purledger.purinvcode Between :al_sinvcode and :al_linvcode AND ( purledger.purcatcode =1 or purledger.purcatcode =2 ) USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_goods_recieveable_note.wf_getitemsaleprice(long al_icode, double ad_saleprice) returns boolean
	boolean retflag
	SQL SELECT item.salePrice INTO :ad_saleprice FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if isnull(ad_saleprice) then
		ad_saleprice = 0
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_goods_recieveable_note.wf_lockpurinvoices(long al_sinvcode, long al_linvcode) returns integer
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM purledger WITH ( UPDLOCK HOLDLOCK ) WHERE purledger.purinvcode Between :al_sinvcode and :al_linvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_goods_recieveable_note.wf_lockopeningpurinvoices(long al_sinvcode, long al_linvcode) returns integer
	integer li_count
	SQL SELECT count ( *) INTO :li_count FROM purledger WITH ( UPDLOCK HOLDLOCK ) WHERE purledger.purinvcode Between :al_sinvcode and :al_linvcode AND purledger.purcatcode =3 USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_goods_recieveable_note.wf_getpomanfcode(long al_pocode, long al_manfcode) returns 0
	al_pocode = this.id_master.object.pocode[this.id_master.getrow()]
	al_manfcode = this.id_master.object.manfcode[this.id_master.getrow()]

// w_goods_recieveable_note.wf_itempurchasehistory() returns 0
	s_itempurchasehistory ls_itempurchasehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itempurchasehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itempurchasehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itempurchasehistory, ls_itempurchasehistory)
	end if

// w_goods_recieveable_note.wf_initmodify(integer ai_protect) returns 0
	long ll_purinvcode
	long ll_gcode
	long ll_icode
	long ll_counter
	long ll_packunits
	double ld_bonusqty
	double ld_stock
	double ld_looseqty
	double ld_packqty
	string ls_batch
	string ls_itemtotalval
	datetime ld_expiry
	double ld_saleprice
	double ld_avgprice
	double ld_packsalestax
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_purinvcode = this.id_master.getitemnumber(1, "code")
		if wf_lockpurchaseinvoice(ll_purinvcode) = 0 then
			for ll_counter = 1 to this.id_detail.rowcount()
				ll_gcode = this.id_detail.getitemnumber(ll_counter, "gcode")
				ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
				ld_looseqty = this.id_detail.getitemnumber(ll_counter, "looseqty")
				ld_packqty = this.id_detail.getitemnumber(ll_counter, "packqty")
				ld_bonusqty = this.id_detail.getitemnumber(ll_counter, "bonusqty")
				ll_packunits = this.id_detail.getitemnumber(ll_counter, "packunits")
				SQL Select item.saleprice , item.avgprice , item.packsalestax INTO :ld_saleprice, :ld_avgprice, :ld_packsalestax From Item Where item.icode =:ll_icode USING this.it_transobject;
				ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
				this.id_detail.setitem(ll_counter, "itemtotalval", ls_itemtotalval)
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					ai_protect = 0
					choose case this.ii_purchasetype
					case 1
						this.id_footer.setitem(ll_counter, "stock", ld_stock - ld_looseqty - ld_packqty * ll_packunits + ld_bonusqty * ll_packunits)
					case else
						this.id_footer.setitem(ll_counter, "stock", ld_stock - ld_looseqty - ld_packqty * ll_packunits + ld_bonusqty)
					end choose
				end if
			next
			if ai_protect = 0 then
				this.id_footer.setitem(1, "stock", this.id_footer.getitemnumber(1, "stock"))
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
				SQL Select item.saleprice , item.avgprice , item.packsalestax INTO :ld_saleprice, :ld_avgprice, :ld_packsalestax From Item Where item.icode =:ll_icode USING this.it_transobject;
				this.id_footer.object.t_rpp.text = string(ld_saleprice)
				this.id_footer.object.t_avgprice.text = string(ld_avgprice)
			end if
		end if
		return
	end if
	ai_protect = 1

// w_goods_recieveable_note.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_listdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_list.dataobject = as_listdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)

// w_goods_recieveable_note.wf_findsuppcode(string as_aliasname, integer ai_suppcode) returns integer
	integer li_suppcode
	integer ll_retflag
	string ls_itemname
	SQL SELECT accounts.acccode INTO :li_suppcode FROM accounts , supplier WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =supplier.suppcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_suppcode = li_suppcode
		if isnull(ai_suppcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_goods_recieveable_note.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_goods_recieveable_note.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_counter step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_goods_recieveable_note.wf_releaselock(long al_icode) returns boolean
	boolean retflag
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM godowndetail ( NOLOCK ) WHERE godowndetail.Gcode =:this.ii_purchasegodownoption AND godowndetail.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_goods_recieveable_note.wf_retrievelist() returns long
	string[] ls_posted
	ls_posted[1] = "N"
	return this.id_list.retrieve(ls_posted, this.il_groupcode, this.ii_module)

// w_goods_recieveable_note.wf_retrievelistall() returns long
	string[] ls_posted
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	return this.id_list.retrieve(ls_posted, this.il_groupcode, this.ii_module)

// w_goods_recieveable_note.wf_setgodownoption() returns 0
	this.ii_purchasegodownoption = this.id_detail.getitemnumber(1, "gcode")
	if this.il_strategy = 2 or this.il_strategy = 1 and this.il_godowncount = 1 then
		this.id_detail.object.gcode.protect = 1
		this.id_detail.object.gcode.background.color = this.backcolor
	end if

// w_goods_recieveable_note.wf_setpurchasetype(integer ai_purchasetype) returns 0
	if ai_purchasetype <= 2 then
		this.ii_purchasetype = ai_purchasetype
		return
	end if
	if ai_purchasetype = 7 then
		this.ii_purchasetype = 7
		return
	end if
	this.ii_purchasetype = 1

// w_goods_recieveable_note.wf_setpurorderinfo(long al_purordercode) returns long
	long ll_suppcode
	long ll_salesmancode
	long ll_row
	long ll_manfcode
	integer li_rtcode
	datetime ld_podate
	string ls_podate
	string ls_manfname
	string ls_suppref
	SQL SELECT purorderheader.manfcode , purorderheader.suppcode , purorderheader.date , supplierreference INTO :ll_manfcode, :ll_suppcode, :ld_podate, :ls_suppref FROM purorderheader WHERE purorderheader.pocode =:al_purordercode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Cannot Connect to Database", this.it_transobject.sqlerrtext)
		li_rtcode = -1
	end if
	if isnull(ll_manfcode) then
		ll_manfcode = 1
	end if
	SQL SELECT manufacturer.name INTO :ls_manfname FROM manufacturer WHERE manufacturer.manfcode =:ll_manfcode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Cannot Connect to Database", this.it_transobject.sqlerrtext)
		li_rtcode = -1
	end if
	ll_row = this.id_master.getrow()
	ll_row = 1
	this.id_master.object.podate[ll_row] = ld_podate
	this.id_master.object.manfname[ll_row] = ls_manfname
	this.id_master.object.manfcode[ll_row] = ll_manfcode
	this.id_master.object.suppcode[ll_row] = ll_suppcode
	this.id_master.object.posupplierreference[ll_row] = ls_suppref
	wf_setsuppinfo(ll_suppcode, this.id_master)
	return ll_manfcode

// w_goods_recieveable_note.wf_setsuppinfo(long al_suppcode, datawindow ad_master) returns 0
	string ls_address
	string ls_city
	string ls_phone
	string ls_aliasname
	long ll_currow
	double ld_currbalance
	SQL SELECT supplier.address1 , supplier.city , supplier.phone , accounts.aliasname INTO :ls_address, :ls_city, :ls_phone, :ls_aliasname FROM supplier , Accounts WHERE supplier.suppcode =:al_suppcode AND supplier.suppcode =Accounts.AccCode USING this.it_transobject;
	ll_currow = ad_master.getrow()
	ll_currow = 1
	ad_master.object.aliasname[ll_currow] = ls_aliasname
	ad_master.object.address[ll_currow] = ls_address
	ad_master.object.city[ll_currow] = ls_city
	ad_master.object.phone[ll_currow] = ls_phone

// w_goods_recieveable_note.wf_updateitemavgprice(long al_icode, double ad_newavgprice) returns boolean
	boolean retflag
	SQL update item SET item.avgprice =:ad_newavgprice WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_goods_recieveable_note.wf_updateitempurprice(long al_icode, double ad_purprice) returns integer
	SQL update Item SET purprice =:ad_purprice WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_goods_recieveable_note.wf_updaterecentpurprice(long al_icode, double ad_rpp) returns integer
	SQL update Item SET recentpurprice5 =recentpurprice4 , recentpurprice4 =recentpurprice3 , recentpurprice3 =recentpurprice2 , recentpurprice2 =recentpurprice , recentpurprice =:ad_rpp , ChangeReason ='Multiple Changes' , Module ='GRN/Posting' WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_goods_recieveable_note.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	return true

// w_goods_recieveable_note.wf_validateitem() returns integer
	long ll_icode
	long ll_gcode
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	string ls_fullcode
	string ls_errtext
	string ls_titleerrtext
	integer il_errcode
	integer li_errcode
	integer li_null
	string ls_null
	ll_icode = this.id_detail.object.icode[this.il_currrow]
	if wf_genfullcode(ll_icode, ls_fullcode) > 0 then
		this.id_detail.object.fullcode[this.il_currrow] = ls_fullcode
		if not wf_inititeminfo(ll_icode, this.il_currrow, ls_errtext) then
			ls_titleerrtext = "Item Validation"
			li_errcode = -1
		end if
	else
		il_errcode = -1
	end if
	this.ib_itemvalidated = true
	if il_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
	end if
	return il_errcode

// w_goods_recieveable_note.wf_setsuppname(string as_data) returns 0
	long ll_rowno
	ll_rowno = this.idc_supplierlist.find("accounts_name >='" + as_data + "'", 1, this.idc_supplierlist.rowcount())
	if ll_rowno > 0 then
		this.idc_supplierlist.selectrow(0, false)
		this.idc_supplierlist.setrow(ll_rowno)
		this.idc_supplierlist.scrolltorow(ll_rowno)
		this.idc_supplierlist.selectrow(ll_rowno, true)
	end if

// w_goods_recieveable_note.wf_iteminfo(long al_icode, long al_gcode, double ad_purprice, double ad_discperc, double ad_avgprice, long al_packunits, double al_packsalestax, double al_gstperc, double ad_saleprice) returns boolean
	boolean retflag
	SQL SELECT 1 , item.salePrice , item.purdiscperc , item.avgprice , item.packunits , item.saleprice , item.packsalestax , item.gstperc1 INTO :al_gcode, :ad_purprice, :ad_discperc, :ad_avgprice, :al_packunits, :ad_saleprice, :al_packsalestax, :al_gstperc FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if isnull(ad_purprice) then
		ad_purprice = 0
	elseif isnull(ad_discperc) then
		ad_discperc = 0
	elseif isnull(ad_avgprice) then
		ad_avgprice = 0
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_goods_recieveable_note.wf_setpurorderqty(transaction at_transobject, long al_pocode, long al_icode, long al_qtysatisfied, long al_bonusqtysatisfied) returns long
	SQL update purorderdetail Set qtysatisfied =qtysatisfied + :al_qtysatisfied , bonusqtysatisfied =bonusqtysatisfied + :al_bonusqtysatisfied Where purorderdetail.pocode =:al_pocode and purorderdetail.icode =:al_icode USING at_transobject;
	return at_transobject.sqlcode

// w_goods_recieveable_note.wf_inititeminfo(long al_icode, long al_row, string as_errortext) returns boolean
	boolean retflag
	double ld_purprice
	double ld_discperc
	double ld_saleprice
	double ld_avgprice
	double ld_packsalestax
	double ld_gstperc
	double ld_rpp
	double ld_unitsalestax
	double ld_rpp2
	double ld_rpp3
	double ld_rpp4
	double ld_rpp5
	long ll_packunits
	double ld_godownstock
	double ld_allgodownstock
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_itemtotalval
	string ls_packingdesc
	string ls_remarks
	SQL SELECT item.customicode , item.name , item.purprice , item.packunits , item.purdiscperc , item.gcode , item.saleprice , item.avgprice , item.packsalestax , item.gstperc1 , item.recentpurprice , Round ( item.packsalestax / item.packunits , 2 ) , item.recentpurprice2 , recentpurprice3 , recentpurprice4 , recentpurprice5 , item.packingdesc , item.remarks INTO :ls_fullcode, :ls_name, :ld_purprice, :ll_packunits, :ld_discperc, :li_gcode, :ld_saleprice, :ld_avgprice, :ld_packsalestax, :ld_gstperc, :ld_rpp, :ld_unitsalestax, :ld_rpp2, :ld_rpp3, :ld_rpp4, :ld_rpp5, :ls_packingdesc, :ls_remarks FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.ii_defaultgcode = this.id_detail.getitemnumber(al_row, "gcode")
	else
		if this.il_strategy = 2 then
			this.ii_defaultgcode = li_gcode
		end if
		if this.il_strategy = 1 then
			this.ii_defaultgcode = this.id_detail.getitemnumber(al_row, "gcode")
		end if
	end if
	ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
	this.it_transobject.getitemstocktotal(this.ii_defaultgcode, al_icode, ld_godownstock)
	this.it_transobject.getitemstockinallowedgodown(al_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.id_detail.setitem(al_row, "gcode", this.ii_defaultgcode)
	this.id_detail.setitem(al_row, "icode", al_icode)
	this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
	this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
	this.id_detail.setitem(al_row, "packunits", ll_packunits)
	if this.ii_purchasetype = 1 then
		this.id_detail.setitem(al_row, "discperc", ld_discperc)
	end if
	this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
	this.id_detail.setitem(al_row, "rate", ld_purprice)
	this.id_detail.setitem(al_row, "itemtotalval", ls_itemtotalval)
	this.id_detail.setitem(al_row, "stock", ld_godownstock)
	this.id_detail.setitem(al_row, "godownstock", ld_godownstock)
	this.id_detail.setitem(al_row, "totalstock", ld_allgodownstock)
	this.id_detail.setitem(al_row, "packingdesc", ls_packingdesc)
	this.id_footer.object.t_rpp.text = string(ld_rpp) + " , " + string(ld_rpp2) + " , " + string(ld_rpp3) + " , " + string(ld_rpp4) + " , " + string(ld_rpp5)
	this.id_footer.object.t_avgprice.text = string(ld_avgprice)
	choose case this.ii_purchasetype
	case 1
		if f_stringpreferences("salepriceinpackpur") = "Y" then
			this.id_detail.setitem(al_row, "purprice", ld_saleprice)
		else
			this.id_detail.setitem(al_row, "purprice", ld_purprice)
		end if
		this.id_detail.setitem(al_row, "unitsalestax", ld_packsalestax)
		this.id_detail.setitem(al_row, "salepriceforitem", ld_saleprice)
	case 7
		if f_stringpreferences("priceinloosepur") = "Y" then
			this.id_detail.setitem(al_row, "purprice", ld_purprice / ll_packunits)
		else
			this.id_detail.setitem(al_row, "purprice", ld_saleprice / ll_packunits)
		end if
		this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
	case else
		this.id_detail.setitem(al_row, "unitsalestax", ld_unitsalestax)
		this.id_detail.setitem(al_row, "purprice", ld_purprice / ll_packunits)
	end choose
	if f_stringpreferences("pur_copyremarksinitemdesc") = "Y" and this.id_detail.getitemstatus(al_row, "itemdescription", primary!) = notmodified! then
		this.id_detail.setitem(al_row, "itemdescription", ls_remarks)
	end if
	this.id_detail.setitem(al_row, "gstperc", ld_gstperc)
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_allgodownstock)
	this.id_footer.setitem(1, "itemtotalval", ls_itemtotalval)
	return retflag

// w_goods_recieveable_note.wf_purchaseslip() returns 0
	long ll_invcode
	if this.tab_retrieve.selectedtab = 2 then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
		openwithparm(w_purinv_slip, ll_invcode)
	end if

// w_goods_recieveable_note.wf_populatedetaildwfrompo(long al_pocode, long al_manfcode) returns integer
	datastore lds_podetail
	datawindowchild ldc_itemdddw
	long ll_detailrows
	long ll_count
	long ll_duplrows
	integer li_result
	integer li_rtncode
	boolean populateflag
	double ld_godownstock
	double ld_allgodownstock
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_retrievecount
	long ll_lockedcount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packsalestax
	double ld_gstperc
	string ls_fullcode
	if this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate Purchase order after posting!")
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 and not isnull(this.id_detail.object.icode[1]) then
		li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
		if li_result = 1 then
			for ll_count = 1 to ll_detailrows
				this.id_detail.deleterow(0)
			next
			if this.id_detail.update() <> 1 then
				messagebox("DataBase Problem", "Problem in Deleting Rows")
				return 0
			end if
			this.id_detail.reset()
		else
			populateflag = false
		end if
	end if
	if populateflag = true then
		lds_podetail = create datastore
		lds_podetail.dataobject = "d_populatepurorder"
		lds_podetail.settransobject(this.it_transobject)
		this.id_detail.reset()
		ll_rtcode = lds_podetail.retrieve(al_pocode)
		ll_rowcount = lds_podetail.rowcount()
		for ll_count = 1 to ll_rowcount
			ll_icode = lds_podetail.object.icode[ll_count]
			if wf_iteminfo(ll_icode, ll_gcode, ld_purprice, ld_discperc, ld_avgprice, ll_packunits, ld_packsalestax, ld_gstperc, ld_saleprice) = true then
				if wf_genfullcode(ll_icode, ls_fullcode) > 0 then
					this.id_detail.insertrow(0)
					this.id_detail.object.icode[ll_count] = ll_icode
					ll_gcode = this.ii_purchasegodownoption
					this.id_detail.object.gcode[ll_count] = ll_gcode
					this.id_detail.object.packingdesc[ll_count] = lds_podetail.object.packingdesc[ll_count]
					this.id_detail.object.fullcode[ll_count] = ls_fullcode
					this.id_detail.setitem(ll_count, this.is_columnitemname, this.id_itemslist.getitemstring(this.id_itemslist.find("icode" + " = " + string(ll_icode) + " ", 1, this.id_itemslist.rowcount()), this.is_columnitemname))
					this.id_detail.object.batch[ll_count] = f_stringpreferences("defaultbatch")
					this.id_detail.object.expiry[ll_count] = f_datepreferences("defaultexpiry")
					this.id_detail.object.salepriceforitem[ll_count] = ld_saleprice
					this.id_detail.object.packqty[ll_count] = lds_podetail.object.reqqty[ll_count]
					if f_stringpreferences("bonusinpurchase") = "Y" then
						this.id_detail.object.bonusqty[ll_count] = lds_podetail.object.reqbonusqty[ll_count]
					end if
					this.id_detail.object.saleprice[ll_count] = ld_saleprice
					this.id_detail.object.rate[ll_count] = ld_purprice
					if f_stringpreferences("salepriceinpackpur") = "Y" then
						this.id_detail.object.purprice[ll_count] = ld_saleprice
					else
						this.id_detail.object.purprice[ll_count] = lds_podetail.object.rate[ll_count]
					end if
					this.id_detail.object.discperc[ll_count] = lds_podetail.object.discperc[ll_count]
					this.id_detail.object.unitsalestax[ll_count] = ld_packsalestax
					this.id_detail.object.gstperc[ll_count] = ld_gstperc
					this.id_detail.object.avgprice[ll_count] = ld_avgprice
					this.id_detail.object.packunits[ll_count] = ll_packunits
					this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
					this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
					this.id_detail.object.stock[ll_count] = ld_godownstock
					this.id_detail.object.totalstock[ll_count] = ld_allgodownstock
					this.id_footer.object.stock[this.id_footer.getrow()] = ld_godownstock
					this.id_footer.object.totalstock[this.id_footer.getrow()] = ld_allgodownstock
					this.id_detail.setitemstatus(ll_count, "purprice", primary!, notmodified!)
					ll_retrievecount = ll_retrievecount + 1
				else
					messagebox("Database Error", "Unable to generate item FullCode")
				end if
			else
				ll_lockedcount = ll_lockedcount + 1
			end if
			ll_duplrows = ll_duplrows + 1
		next
		destroy lds_podetail
	end if
	if ll_retrievecount = ll_rowcount then
		messagebox("Result", "Purchase Order retrieval is Successfull~n~r" + string(ll_rowcount) + " Items are retrieved. ")
	else
		messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " records are retrieved successfully~n~r" + string(ll_duplrows) + " records are duplicate so are not retrieved~n~r" + string(ll_lockedcount) + " records are in error")
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_goods_recieveable_note.wf_populatepurorder() returns integer
	datastore lds_itemselected
	long ll_detailrows
	long ll_count
	long ll_duplrows
	long ll_purordercount
	double ld_godownstock
	double ld_allgodownstock
	integer li_result
	integer li_rtncode
	boolean populateflag
	s_saletemplate lstr_template
	string ls_itemtotalval
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_retrievecount
	long ll_lockedcount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packsalestax
	double ld_gstperc
	double ld_unitsalestax
	string ls_fullcode
	if this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate items after posting!")
		return 0
	end if
	setpointer(hourglass!)
	this.id_detail.setredraw(false)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		if not isnull(this.id_detail.object.icode[1]) then
			li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
			if li_result = 1 then
				for ll_count = 1 to ll_detailrows
					this.id_detail.deleterow(0)
				next
				if this.id_detail.update() <> 1 then
					messagebox("DataBase Problem", "Problem in Deleting Rows")
					return 0
				end if
			else
				populateflag = false
			end if
		else
			this.id_detail.reset()
		end if
	end if
	if populateflag = true then
		open(w_copypurinvoicefrom)
		lstr_template = message.powerobjectparm
		if lstr_template.b_userinput = true then
			setpointer(hourglass!)
			lds_itemselected = create datastore
			lds_itemselected.dataobject = "d_populatepurorder"
			lds_itemselected.settransobject(this.it_transobject)
			this.id_detail.reset()
			ll_rtcode = lds_itemselected.retrieve(lstr_template.l_invtemplate)
			ll_rowcount = lds_itemselected.rowcount()
			ll_gcode = this.ii_purchasegodownoption
			if this.ii_purchasetype = 1 then
				this.id_master.setitem(this.id_master.getrow(), "pocode", lstr_template.l_invtemplate)
				this.id_master.setitem(this.id_master.getrow(), "podate", datetime(lstr_template.d_date))
			end if
			for ll_count = 1 to ll_rowcount
				this.id_detail.insertrow(0)
				ll_icode = lds_itemselected.object.icode[ll_count]
				this.id_detail.object.icode[ll_count] = ll_icode
				if this.ii_purchasegodownoption = 2 then
					ll_gcode = lds_itemselected.object.gcode[ll_count]
				end if
				this.id_detail.object.gcode[ll_count] = ll_gcode
				this.id_detail.object.fullcode[ll_count] = lds_itemselected.object.fullcode[ll_count]
				this.id_detail.object.itemname[ll_count] = lds_itemselected.object.itemname[ll_count]
				this.id_detail.object.batch[ll_count] = "."
				this.id_detail.object.saleprice[ll_count] = lds_itemselected.object.saleprice[ll_count]
				if this.ii_purchasetype = 1 then
					this.id_detail.object.packqty[ll_count] = lds_itemselected.object.qty[ll_count]
				else
					this.id_detail.object.looseqty[ll_count] = lds_itemselected.object.qty[ll_count] * lds_itemselected.object.packunits[ll_count]
				end if
				this.id_detail.object.expiry[ll_count] = datetime(date("12/12/2010"))
				if f_stringpreferences("salepriceinpackpur") = "Y" then
					if this.ii_purchasetype = 1 then
						this.id_detail.object.purprice[ll_count] = lds_itemselected.object.saleprice[ll_count]
					else
						this.id_detail.object.purprice[ll_count] = lds_itemselected.object.saleprice[ll_count] / lds_itemselected.object.packunits[ll_count]
					end if
				elseif this.ii_purchasetype = 1 then
					this.id_detail.object.purprice[ll_count] = lds_itemselected.object.rate[ll_count]
				else
					this.id_detail.object.purprice[ll_count] = lds_itemselected.object.rate[ll_count] / lds_itemselected.object.packunits[ll_count]
				end if
				if this.ii_purchasetype = 1 then
					this.id_detail.object.unitsalestax[ll_count] = lds_itemselected.object.packsalestax[ll_count]
					this.id_detail.object.discperc[ll_count] = lds_itemselected.object.discperc[ll_count]
				else
					ld_unitsalestax = round(lds_itemselected.object.packsalestax[ll_count] / lds_itemselected.object.packunits[ll_count], 2)
					this.id_detail.object.unitsalestax[ll_count] = ld_unitsalestax
				end if
				this.id_detail.object.gstperc[ll_count] = lds_itemselected.object.gstperc[ll_count]
				this.id_detail.object.avgprice[ll_count] = lds_itemselected.object.avgprice[ll_count]
				this.id_detail.object.packunits[ll_count] = lds_itemselected.object.packunits[ll_count]
				this.id_detail.object.packingdesc[ll_count] = lds_itemselected.object.packingdesc[ll_count]
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
				this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
				ls_itemtotalval = string(lds_itemselected.object.saleprice[ll_count], "######0.00") + " + " + string(lds_itemselected.object.packsalestax[ll_count], "######0.00") + " =  " + string(lds_itemselected.object.saleprice[ll_count] + lds_itemselected.object.packsalestax[ll_count], "#####0.00")
				this.id_detail.object.stock[ll_count] = ld_godownstock
				this.id_detail.object.totalstock[ll_count] = ld_allgodownstock
				this.id_detail.object.itemtotalval[ll_count] = ls_itemtotalval
				this.id_footer.object.stock[this.id_footer.getrow()] = ld_godownstock
				this.id_footer.object.totalstock[this.id_footer.getrow()] = ld_allgodownstock
				if this.it_transobject.sqlcode = -1 then
					messagebox("Database Error", "Database Error: Item stock information can not be retrieved")
				end if
				this.id_detail.setitemstatus(ll_count, "purprice", primary!, notmodified!)
				ll_retrievecount = ll_retrievecount + 1
			next
			destroy lds_itemselected
		end if
		if ll_retrievecount = ll_rowcount then
			messagebox("Result", string(ll_rowcount) + " Items are populated. ")
		else
			messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " records are retrieved successfully~n~r" + string(ll_duplrows) + " records are duplicate so are not retrieved~n~r" + string(ll_lockedcount) + " records are in error")
		end if
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_goods_recieveable_note.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_goods_recieveable_note.wf_populatefiltereditems() returns integer
	datastore lds_itemselected
	long ll_detailrows
	long ll_count
	long ll_duplrows
	double ld_godownstock
	double ld_allgodownstock
	integer li_result
	integer li_rtncode
	boolean populateflag
	s_arguements lstr_selecteditems
	string ls_itemtotalval
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_retrievecount
	long ll_lockedcount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	double ld_saleprice
	double ld_packsalestax
	double ld_gstperc
	string ls_fullcode
	if this.id_master.object.posted[1] = "Y" then
		messagebox("Problem", "Can not pouplate items after posting!")
		return 0
	end if
	this.id_detail.setredraw(false)
	setpointer(hourglass!)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		if not isnull(this.id_detail.object.icode[1]) then
			li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
			if li_result = 1 then
				for ll_count = 1 to ll_detailrows
					this.id_detail.deleterow(0)
				next
				if this.id_detail.update() <> 1 then
					messagebox("DataBase Problem", "Problem in Deleting Rows")
					return 0
				end if
			else
				populateflag = false
			end if
		else
			this.id_detail.reset()
		end if
	end if
	if populateflag = true then
		openwithparm(w_arg_item_populate3, this.ii_module)
		lstr_selecteditems = message.powerobjectparm
		this.id_detail.reset()
		lds_itemselected = create datastore
		if lstr_selecteditems.s_name2 = "OR" then
			lds_itemselected.dataobject = "d_populateditems_active"
		else
			lds_itemselected.dataobject = "d_populateditems_active_and"
		end if
		lds_itemselected.settransobject(this.it_transobject)
		this.id_detail.reset()
		ll_rtcode = lds_itemselected.retrieve(lstr_selecteditems.ia_integerlist, lstr_selecteditems.ia_integerlist1, lstr_selecteditems.ia_integerlist2, lstr_selecteditems.la_longlist, lstr_selecteditems.l_code1, lstr_selecteditems.s_name1)
		ll_rowcount = lds_itemselected.rowcount()
		for ll_count = 1 to ll_rowcount
			ll_icode = lds_itemselected.object.icode[ll_count]
			if wf_genfullcode(ll_icode, ls_fullcode) > 0 then
				this.id_detail.insertrow(0)
				this.id_detail.object.icode[ll_count] = ll_icode
				ll_gcode = lds_itemselected.object.gcode[ll_count]
				if isnull(ll_gcode) then
					this.id_detail.object.gcode[ll_count] = this.ii_purchasegodownoption
					ll_gcode = this.ii_purchasegodownoption
				else
					this.id_detail.object.gcode[ll_count] = ll_gcode
				end if
				this.id_detail.object.fullcode[ll_count] = ls_fullcode
				this.id_detail.object.itemname[ll_count] = lds_itemselected.object.name[ll_count]
				this.id_detail.object.batch[ll_count] = f_stringpreferences("defaultbatch")
				this.id_detail.object.expiry[ll_count] = f_datepreferences("defaultexpiry")
				this.id_detail.object.saleprice[ll_count] = lds_itemselected.object.saleprice[ll_count]
				this.id_detail.object.rate[ll_count] = lds_itemselected.object.rate[ll_count]
				if this.ii_purchasetype = 1 then
					this.id_detail.object.packqty[ll_count] = lds_itemselected.object.qty[ll_count]
					this.id_detail.object.salepriceforitem[ll_count] = lds_itemselected.object.saleprice[ll_count]
				else
					this.id_detail.object.looseqty[ll_count] = lds_itemselected.object.qty[ll_count]
				end if
				if f_stringpreferences("salepriceinpackpur") = "Y" then
					if this.ii_purchasetype = 1 then
						this.id_detail.object.purprice[ll_count] = lds_itemselected.object.saleprice[ll_count]
					else
						this.id_detail.object.purprice[ll_count] = lds_itemselected.object.saleprice[ll_count] / lds_itemselected.object.packunits[ll_count]
					end if
				elseif this.ii_purchasetype = 1 then
					this.id_detail.object.purprice[ll_count] = lds_itemselected.object.rate[ll_count]
				else
					this.id_detail.object.purprice[ll_count] = lds_itemselected.object.rate[ll_count] / lds_itemselected.object.packunits[ll_count]
				end if
				this.id_detail.object.unitsalestax[ll_count] = lds_itemselected.object.packsalestax[ll_count]
				this.id_detail.object.gstperc[ll_count] = lds_itemselected.object.gstperc[ll_count]
				this.id_detail.object.discperc[ll_count] = lds_itemselected.object.discperc[ll_count]
				this.id_detail.object.avgprice[ll_count] = lds_itemselected.object.avgprice[ll_count]
				this.id_detail.object.packunits[ll_count] = lds_itemselected.object.packunits[ll_count]
				this.id_detail.object.packingdesc[ll_count] = lds_itemselected.object.packingdesc[ll_count]
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
				this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
				ls_itemtotalval = string(lds_itemselected.object.saleprice[ll_count], "######0.00") + " + " + string(lds_itemselected.object.packsalestax[ll_count], "######0.00") + " =  " + string(lds_itemselected.object.saleprice[ll_count] + lds_itemselected.object.packsalestax[ll_count], "#####0.00")
				this.id_detail.object.stock[ll_count] = ld_godownstock
				this.id_detail.object.totalstock[ll_count] = ld_allgodownstock
				this.id_detail.object.itemtotalval[ll_count] = ls_itemtotalval
				this.id_footer.object.stock[ll_count] = ld_godownstock
				this.id_footer.object.totalstock[ll_count] = ld_allgodownstock
				this.id_footer.object.itemtotalval[ll_count] = ls_itemtotalval
				if this.it_transobject.sqlcode = -1 then
					messagebox("Database Error", "Database Error: Item information can not be retrieved")
				end if
				this.id_detail.setitemstatus(ll_count, "purprice", primary!, notmodified!)
				ll_retrievecount = ll_retrievecount + 1
			else
				messagebox("Database Error", "Can not generate item FullCode")
			end if
		next
		destroy lds_itemselected
		if ll_retrievecount = ll_rowcount then
			messagebox("Result", string(ll_rowcount) + " Items are populated. ")
		else
			messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_rowcount - ll_duplrows - ll_lockedcount) + " records are retrieved successfully~n~r" + string(ll_duplrows) + " records are duplicate so are not retrieved~n~r" + string(ll_lockedcount) + " records are in error")
		end if
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setpointer(arrow!)
	this.id_detail.setredraw(true)
	return ll_retrievecount

// w_goods_recieveable_note.wf_selectprintreport() returns string
	string ls_report
	if gs_company = "ZAFARTRACTOR" or gs_company = "ZAFARTRACTOR5" then
		ls_report = "d_zafartractor_grninvreport"
		this.id_print.dataobject = ls_report
	else
		ls_report = "d_grninvreport"
		this.id_print.dataobject = ls_report
	end if
	this.id_print.settransobject(this.it_transobject)
	return ls_report

// w_goods_recieveable_note.wf_post() returns boolean
	integer li_postingmode
	long ll_sinvcode
	long ll_linvcode
	setnull(ll_sinvcode)
	setnull(ll_linvcode)
	return wf_post_purchase(li_postingmode, ll_sinvcode, ll_linvcode)

// w_goods_recieveable_note.wf_replacesalediscperc(long al_icode, double ad_discperc) returns integer
	if f_numberpreferences("PurReplaceItemSalediscNo") = 1 then
		SQL update Item SET saleDiscPerc =:ad_discperc WHERE Item.icode =:al_icode USING this.it_transobject;
		return this.it_transobject.sqlcode
	end if
	if f_numberpreferences("PurReplaceItemSalediscNo") = 2 then
		SQL update Item SET saleDiscPerc2 =:ad_discperc WHERE Item.icode =:al_icode USING this.it_transobject;
		return this.it_transobject.sqlcode
	end if
	if f_numberpreferences("PurReplaceItemSalediscNo") = 3 then
		SQL update Item SET saleDiscPerc3 =:ad_discperc WHERE Item.icode =:al_icode USING this.it_transobject;
		return this.it_transobject.sqlcode
	end if
	if f_numberpreferences("PurReplaceItemSalediscNo") = 4 then
		SQL update Item SET saleDiscPerc4 =:ad_discperc WHERE Item.icode =:al_icode USING this.it_transobject;
		return this.it_transobject.sqlcode
	end if
	if f_numberpreferences("PurReplaceItemSalediscNo") = 5 then
		SQL update Item SET saleDiscPerc5 =:ad_discperc WHERE Item.icode =:al_icode USING this.it_transobject;
		return this.it_transobject.sqlcode
	end if

// w_goods_recieveable_note.wf_updateitemsaleprice(transaction at_transobject, long al_icode, double ad_saleprice) returns long
	SQL update Item SET Saleprice =:ad_saleprice WHERE Item.icode =:al_icode USING at_transobject;
	return at_transobject.sqlcode

// w_goods_recieveable_note.wf_grandtotal() returns double
	long ll_counter
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_itemleveltax
	double ld_invgstpercval
	double ld_totalsalestax
	double ld_invgstperc1
	double ld_netrate
	double ld_discperc
	double ld_flatdisc
	double ld_misccharges
	double ld_salestax
	double ld_itemstotal
	double ld_invlevelvalues
	double ld_discpercvalue
	double ld_grossvalue
	double ld_itemgrossvalue
	double ld_totqty
	integer li_roundupto
	li_roundupto = f_numberpreferences("roundpurinvon")
	if isnull(li_roundupto) or li_roundupto < 0 then
		li_roundupto = 0
	end if
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		ld_discperc = round(this.id_footer.getitemnumber(1, "discperc"), 2)
		ld_flatdisc = round(this.id_footer.getitemnumber(1, "flatdisc"), 2)
		ld_misccharges = round(this.id_footer.getitemnumber(1, "misccharges"), 2)
		ld_salestax = round(this.id_footer.getitemnumber(1, "salestax"), 2)
		if isnull(ld_discperc) then
			ld_discperc = 0.00
		end if
		if isnull(ld_flatdisc) then
			ld_flatdisc = 0.00
		end if
		if isnull(ld_misccharges) then
			ld_misccharges = 0.00
		end if
		if isnull(ld_salestax) then
			ld_salestax = 0.00
		end if
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "d_detaildwtotal")
		ld_invgstperc1 = this.id_footer.getitemnumber(1, "invgstperc1")
		ld_itemleveltax = this.id_detail.object.c_sumtaxval[1] + this.id_detail.object.c_sumgstval[1]
		ld_invgstpercval = round((round(ld_detaildwtotal * (1.0 - 0.01 * ld_discperc), 2) - ld_flatdisc) * 0.01 * ld_invgstperc1, 2)
		ld_discpercvalue = round(ld_detaildwtotal * ld_discperc * 0.01, 5)
		ld_totalsalestax = round(ld_invgstpercval + ld_itemleveltax, li_roundupto)
		ld_grandtotal = ld_detaildwtotal * (1.0 - ld_discperc * 0.01) - ld_flatdisc + ld_misccharges + ld_salestax
		ld_grandtotal = round(ld_grandtotal, li_roundupto) + ld_totalsalestax
		this.id_footer.setitem(1, "total", ld_grandtotal)
		ld_detaildwtotal = this.id_footer.getitemnumber(1, "total")
		ld_invlevelvalues = ld_invgstpercval + ld_misccharges - ld_flatdisc - ld_discpercvalue
		if ld_invlevelvalues = 0.0 or isnull(ld_invlevelvalues) then
			ld_invlevelvalues = 0
		end if
		ld_grossvalue = this.id_detail.object.c_total_finalitemval[1]
		if ld_grossvalue = 0.0 or isnull(ld_grossvalue) then
			ld_grossvalue = 1
		end if
		for ll_counter = 1 to this.id_detail.rowcount()
			ld_totqty = this.id_detail.object.looseqty[ll_counter] + this.id_detail.object.packqty[ll_counter] + this.id_detail.object.bonusqty[ll_counter]
			if ld_totqty = 0.0 or isnull(ld_totqty) then
				ld_totqty = 1
			end if
			ld_itemgrossvalue = this.id_detail.object.c_finalitemval[ll_counter]
			ld_netrate = (ld_itemgrossvalue / ld_grossvalue * ld_invlevelvalues + ld_itemgrossvalue) / ld_totqty
			this.id_detail.object.netrate[ll_counter] = round(ld_netrate, 5)
		next
	end if
	return ld_grandtotal

// w_goods_recieveable_note.wf_columns_releatedtopurchase() returns integer
	this.id_master.object.currencycode.visible = false
	this.id_master.object.t_currencycode.visible = false
	this.id_master.object.conversionfactor.visible = false
	this.id_master.object.t_conversionfactor.visible = false
	this.id_detail.object.foreignprice.visible = false
	this.id_detail.object.c_foreigntotal.visible = false
	this.id_detail.object.purprice.visible = false
	this.id_detail.object.c_finalitemval.visible = false
	this.id_detail.object.c_gstval.visible = false
	this.id_detail.object.gstperc.visible = false
	this.id_detail.object.discperc.visible = false
	this.id_detail.object.c_total.visible = false
	this.id_detail.object.c_taxval.visible = false
	this.id_detail.object.unitsalestax.visible = false
	this.id_detail.object.netrate.visible = false
	this.id_footer.visible = false
	return 1

// w_goods_recieveable_note.wf_allowpurchasemodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM PurDetail WHERE PurInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_goods_recieveable_note.wf_saveandpost() returns 0
	integer li_postingmode
	long ll_sinvcode
	long ll_linvcode
	boolean lb_commitflag
	event ue_save()
	if this.ib_commitok then
		ll_sinvcode = this.id_master.getitemnumber(1, "code")
		ll_linvcode = this.id_master.getitemnumber(1, "code")
		if isnull(ll_sinvcode) or isnull(ll_linvcode) or ll_sinvcode < 0 and ll_linvcode < 0 then
			return
		else
			lb_commitflag = wf_post_purchase(li_postingmode, ll_sinvcode, ll_linvcode)
		end if
	end if
	setpointer(arrow!)

// w_goods_recieveable_note.wf_post_purchase(integer ai_postingmode, long al_startinginvcode, long al_endinginvcode) returns boolean
	long ll_code1
	long ll_code2
	long ll_headerno
	long ll_headerinvno
	long ll_pocode
	long ll_duedoccode
	integer li_errcode
	integer li_rtncode
	long ll_supplieracc
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_icode
	long ll_gcode
	long ll_packingunits
	long ll_salesmancode
	long ll_errrowid
	long ll_packunits
	double ld_bonusqty
	double ld_packqty
	double ld_purbonusqty
	double ld_purqty
	double ld_newstock
	double ld_godownstock
	double ld_looseqty
	double ld_stock
	string ls_batch
	string ls_due_message
	datetime ld_expiry
	datetime ldt_manfdate
	double ld_avgprice
	double ld_newavgprice
	double ld_purprice
	double ld_purdiscpack
	double ld_discperc
	double ld_itempurcost
	double ld_netpurcost
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_debitamt
	double ld_creditamt
	double ld_currbalance
	double ld_recentpurprice
	double ld_purpricepack
	double ld_purpriceloose
	double ld_saleprice
	double ld_itemsalestax
	double ld_itemgstperc
	double ld_totalitemsalestax
	double ld_invgstperc1
	double ld_salepriceforitem
	double ld_rate
	double ld_netrate
	double ld_updpurrate
	integer li_detailcounter
	integer li_purchasecategory
	boolean lb_commitflag
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_errortext
	string ls_batchprefix
	integer ci_normalpurchase
	integer ci_openingpurchase
	integer ci_loosepurchase
	long ll_rowcount
	long ll_invcounter
	long ll_invcode
	s_arguements lstr_arginfo
	datastore lds_purinvforposting
	datastore lds_purheader
	datastore lds_purdetail
	datawindowchild ldc_godown
	datawindow ldw_changeprice_foritemlog
	ls_batchprefix = ""
	ldw_changeprice_foritemlog = this.dw_changeprice_foritemlog
	ldw_changeprice_foritemlog.settransobject(this.it_transobject)
	lds_purinvforposting = create datastore
	lds_purinvforposting.dataobject = "d_purinvno"
	lds_purinvforposting.settransobject(this.it_transobject)
	lds_purheader = create datastore
	lds_purheader.dataobject = "d_normalpurchaseheader"
	lds_purheader.settransobject(this.it_transobject)
	lds_purdetail = create datastore
	lds_purdetail.dataobject = "d_normalpurchasedetail"
	lds_purdetail.settransobject(this.it_transobject)
	li_rtncode = lds_purdetail.getchild("gcode", ldc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild~r~nPosting Failed")
		return false
	end if
	ldc_godown.settransobject(this.it_transobject)
	li_rtncode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to Post Purchase~r~nPosting Failed")
		return false
	end if
	if ai_postingmode = 1 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if ai_postingmode = 1 then
			open(w_arg_sinvcode_linvcode)
			lstr_arginfo = message.powerobjectparm
		else
			lstr_arginfo.l_code1 = al_startinginvcode
			lstr_arginfo.l_code2 = al_endinginvcode
			lstr_arginfo.i_status = 1
		end if
		if lstr_arginfo.i_status = 1 then
			if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return false
			end if
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			SQL Select count ( *) INTO :ul_rowcount From PurDetail , purledger Where purledger.PurInvCode Between :lstr_arginfo.l_code1 AND :lstr_arginfo.l_code2 AND purledger.posted ='N' AND purledger.purinvcode =purdetail.purinvcode USING sqlca;
			sqlca.getmaxutn(ul_rowcount, ul_maxutn)
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
				messagebox("POSTING", "Posting fail due to error in generating Utn")
				return false
			end if
			choose case this.ii_purchasetype
			case 1
				li_errcode = wf_locknormalpurinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
				ll_code1 = lstr_arginfo.l_code1
				ll_code2 = lstr_arginfo.l_code2
				lds_purinvforposting.retrieve(1, 2, lstr_arginfo.l_code1, lstr_arginfo.l_code2)
			case ci_loosepurchase
				li_errcode = wf_lockloosepurinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
				lds_purinvforposting.retrieve(7, 8, lstr_arginfo.l_code1, lstr_arginfo.l_code2)
			case else
				li_errcode = wf_lockopeningpurinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
				lds_purinvforposting.retrieve(3, 0, lstr_arginfo.l_code1, lstr_arginfo.l_code2)
			end choose
			if li_errcode = 0 then
				ll_rowcount = lds_purinvforposting.rowcount()
				for ll_invcounter = 1 to ll_rowcount
					ll_invcode = lds_purinvforposting.object.purinvcode[ll_invcounter]
					if wf_allowpurchasemodification(ll_invcode, this.il_groupcode, this.il_strategy) = 0 then
						lds_purheader.retrieve(ll_invcode)
						lds_purdetail.retrieve(ll_invcode)
						ll_mastercurrrow = lds_purheader.getrow()
						ll_detailrows = lds_purdetail.rowcount()
						ll_headerno = lds_purheader.getitemnumber(ll_mastercurrrow, "headerno")
						ll_headerinvno = lds_purheader.getitemnumber(ll_mastercurrrow, "headerinvno")
						if isnull(ll_headerinvno) then
							f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
							if ll_headerinvno > 0 then
								lds_purheader.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
							end if
						end if
						if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
							messagebox("Date Violation", ls_date_errtext, stopsign!)
							return false
						end if
						lds_purheader.object.postdate[ll_mastercurrrow] = ldt_server_datetime
						if this.ii_purchasetype = 1 and f_stringpreferences("UpdateSalePriceForItem") = "Y" then
							ldw_changeprice_foritemlog.retrieve(ll_invcode)
							if f_generateitemlog(ldw_changeprice_foritemlog, "item_changeprice_purchase", this.it_transobject, ldt_server_datetime) <= 0 then
								lb_commitflag = false
								ls_errortext = "Item Log Generation Error:~r~n" + this.it_transobject.sqlerrtext
							end if
						end if
						lds_purheader.object.posted[ll_mastercurrrow] = "Y"
						lds_purheader.object.postedby[ll_mastercurrrow] = ll_salesmancode
						ld_misccharges = lds_purheader.object.misccharges[ll_mastercurrrow]
						ld_invdiscperc = lds_purheader.object.discperc[ll_mastercurrrow]
						ld_flatdisc = lds_purheader.object.flatdisc[ll_mastercurrrow]
						ld_salestax = lds_purheader.object.salestax[ll_mastercurrrow]
						ld_invgstperc1 = lds_purheader.object.invgstperc1[ll_mastercurrrow]
						li_detailcounter = 1
						if ll_detailrows < 1 then
							lb_commitflag = false
						end if
						do while li_detailcounter <= ll_detailrows and lb_commitflag = true
							lds_purdetail.object.purutn[li_detailcounter] = ul_maxutn
							ul_maxutn = ul_maxutn + 1
							ll_icode = lds_purdetail.object.icode[li_detailcounter]
							ll_gcode = lds_purdetail.object.gcode[li_detailcounter]
							ls_batch = lds_purdetail.object.batch[li_detailcounter]
							ldt_manfdate = lds_purdetail.object.manfdate[li_detailcounter]
							ld_expiry = lds_purdetail.object.expiry[li_detailcounter]
							ld_packqty = lds_purdetail.object.packqty[li_detailcounter]
							ld_looseqty = lds_purdetail.object.looseqty[li_detailcounter]
							ld_bonusqty = lds_purdetail.object.bonusqty[li_detailcounter]
							ll_packingunits = lds_purdetail.object.packunits[li_detailcounter]
							ld_discperc = lds_purdetail.object.discperc[li_detailcounter]
							ld_netrate = lds_purdetail.object.netrate[li_detailcounter]
							ll_packunits = lds_purdetail.object.packunits[li_detailcounter]
							ld_itemsalestax = lds_purdetail.object.unitsalestax[li_detailcounter]
							ld_itemgstperc = lds_purdetail.object.gstperc[li_detailcounter]
							choose case this.ii_purchasetype
							case 1
								ld_purprice = lds_purdetail.object.purprice[li_detailcounter] / ll_packingunits
								ld_purqty = ld_packqty * ll_packingunits
								ld_purbonusqty = ld_bonusqty * ll_packingunits
								ll_pocode = lds_purheader.object.pocode[ll_mastercurrrow]
								if not isnull(ll_pocode) then
									wf_setpurorderqty(this.it_transobject, ll_pocode, ll_icode, ld_packqty, ld_bonusqty)
								end if
								if f_stringpreferences("UpdateSalePriceForItem") = "Y" then
									ld_salepriceforitem = lds_purdetail.getitemdecimal(li_detailcounter, "salepriceforitem")
									if wf_updateitemsaleprice(this.it_transobject, ll_icode, ld_salepriceforitem) <> 0 then
										ls_errortext = "Item SalePrice Updation Error:~r~n" + this.it_transobject.sqlerrtext
										lb_commitflag = false
									end if
								end if
								ld_purpricepack = lds_purdetail.object.purprice[li_detailcounter]
								ld_purdiscpack = lds_purdetail.object.discperc[li_detailcounter]
								if f_stringpreferences("UpdatePurPrice") = "Y" then
									ld_updpurrate = ld_purpricepack
								elseif f_stringpreferences("UpdatePurPrice") = "D" then
									ld_updpurrate = round(ld_purpricepack * (1.0 - ld_discperc * 0.01), 2)
								elseif f_stringpreferences("UpdatePurPrice") = "R" then
									ld_updpurrate = round(ld_netrate, 2)
								end if
								if f_stringpreferences("UpdatePurPrice") <> "N" and wf_updateitempurprice(ll_icode, ld_updpurrate) <> 0 then
									lb_commitflag = false
								end if
								if f_stringpreferences("UpdatePurDisc") = "Y" and wf_updateitempurdisc(ll_icode, ld_purdiscpack) <> 0 then
									lb_commitflag = false
								end if
								if f_stringpreferences("PurReplaceItemSaledisc") = "Y" and wf_replacesalediscperc(ll_icode, ld_purdiscpack) <> 0 then
									lb_commitflag = false
								end if
								ld_recentpurprice = ld_netrate
							case else
								ld_purprice = lds_purdetail.object.purprice[li_detailcounter]
								ld_purqty = ld_looseqty
								ld_purbonusqty = ld_bonusqty
								ld_recentpurprice = round(ld_purprice * (1.0 - ld_discperc * 0.01) * (1.0 - ld_invdiscperc * 0.01) * ld_purqty / (ld_purqty + ld_purbonusqty) * ll_packunits, 2)
							end choose
							if this.ii_purchasetype = 7 then
								if f_stringpreferences("UpdRPPOnLoosePurPosting") = "Y" and wf_updaterecentpurprice(ll_icode, ld_recentpurprice) <> 0 then
									lb_commitflag = false
								end if
							elseif wf_updaterecentpurprice(ll_icode, ld_recentpurprice) <> 0 then
								lb_commitflag = false
							end if
							ld_itempurcost = ld_purqty * ld_purprice * (1.0 - ld_discperc * 0.01) * (1.0 - ld_invdiscperc * 0.01)
							ld_netpurcost = ld_netpurcost + ld_itempurcost
							this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
							if this.it_transobject.sqlcode = 0 then
								this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_godownstock)
								this.it_transobject.getitemstockall(ll_icode, ld_stock)
								if this.it_transobject.sqlcode = 0 then
									lds_purdetail.object.avgprice[li_detailcounter] = ld_avgprice
									lds_purdetail.object.currstock[li_detailcounter] = ld_stock
									lds_purdetail.object.godownstock[li_detailcounter] = ld_godownstock
									ld_newstock = ld_stock + ld_purqty + ld_purbonusqty
									if ld_newstock > 0.0 then
										ld_newavgprice = (ld_stock * ld_avgprice + ld_itempurcost) / ld_newstock
										lds_purdetail.object.newavgprice[li_detailcounter] = ld_newavgprice
										this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
										if this.it_transobject.sqlcode = 0 then
											ld_newstock = ld_stock + ld_purqty + ld_purbonusqty
											this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
											if this.it_transobject.sqlcode = 0 then
												if wf_update_manfdate(ll_icode, ll_gcode, ls_batch, ld_expiry, ldt_manfdate) = 0 then
													this.it_transobject.updateitemavgprice(ll_icode, ld_newavgprice)
													if this.it_transobject.sqlcode = 0 then
														SQL SELECT saleprice , purprice INTO :ld_saleprice, :ld_rate FROM item Where item.icode =:ll_icode USING this.it_transobject;
														lds_purdetail.object.saleprice[li_detailcounter] = ld_saleprice
														lds_purdetail.object.rate[li_detailcounter] = ld_rate
														if this.it_transobject.sqlcode = 0 then
															this.it_transobject.updatetransitstock(1, ll_icode, ld_purqty + ld_purbonusqty)
															if this.it_transobject.sqlcode <> 0 then
																lb_commitflag = false
															end if
														else
															lb_commitflag = false
														end if
													else
														lb_commitflag = false
													end if
												else
													lb_commitflag = false
												end if
											else
												lb_commitflag = false
												ls_errortext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
											end if
										else
											lb_commitflag = false
											ls_errortext = "Batch Wise Stock Fetch Error:~r~n" + this.it_transobject.sqlerrtext
										end if
									else
										lb_commitflag = false
									end if
								else
									lb_commitflag = false
								end if
							else
								lb_commitflag = false
							end if
							li_detailcounter = li_detailcounter + 1
						loop
						if lb_commitflag = false then
							SQL rollback USING this.it_transobject;
							messagebox("Updation Fail", string(ll_invcode) + "  invoice code" + "~n~r and greater can not be posted.~r~n" + ls_errortext)
							destroy lds_purinvforposting
							destroy lds_purheader
							destroy lds_purdetail
							return lb_commitflag
						elseif lds_purheader.update(true, false) < 0 then
							SQL rollback USING this.it_transobject;
						elseif lds_purdetail.update() > 0 then
							if f_stringpreferences("AutoDueSatisfyOnPurPost") = "Y" then
								if this.it_transobject.purchasebased_satisfydue(ll_invcode, ll_salesmancode, ldt_server_datetime, ll_duedoccode) = 0 then
									ls_due_message = ls_due_message + trim(string(ll_duedoccode)) + ", "
									SQL commit USING this.it_transobject;
								else
									SQL rollback USING this.it_transobject;
									messagebox("Posting Failed", string(ll_invcode) + "  invoice code" + "~n~r and greater can not be posted due to problem in auto due satisfaction process.~r~n" + ls_errortext)
								end if
							else
								SQL commit USING this.it_transobject;
							end if
						else
							SQL rollback USING this.it_transobject;
						end if
					end if
				next
				if len(ls_due_message) > 0 then
					ls_due_message = "Auto Due Satisfaction Made Through Due Document Code(s) = " + ls_due_message
				end if
				messagebox("Posting", "Posting Completed~r~n" + ls_due_message)
				destroy lds_purinvforposting
				destroy lds_purheader
				destroy lds_purdetail
				return lb_commitflag
			end if
			return
		end if
		return
	end if
	setpointer(arrow!)
	return lb_commitflag

// w_goods_recieveable_note.wf_fetchserverdate(boolean ab_checked) returns long
	if ab_checked then
		this.ib_fetchserverdate = true
	else
		this.ib_fetchserverdate = false
	end if
	return 0

// w_goods_recieveable_note.wf_itemstockinfo(long al_icode, long al_gcode, double ad_stock) returns boolean
	boolean retflag
	double ld_stock
	double ld_totalstock
	ad_stock = 100
	return retflag

// w_goods_recieveable_note.wf_updateitemstock(long al_icode, long al_gcode, double ad_newstock) returns boolean
	boolean retflag
	SQL update godowndetail SET godowndetail.currqty =:ad_newstock WHERE godowndetail.gcode =:al_gcode AND godowndetail.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_goods_recieveable_note.wf_setiteminfo(long al_icode, long al_row, long ad_gcode, double ad_saleprice, double ad_discperc, double ad_stock) returns 0
	this.id_detail.setitem(al_row, "gcode", ad_gcode)
	this.id_detail.setitem(al_row, "purprice", ad_saleprice)
	this.id_detail.setitem(al_row, "discperc", ad_discperc)
	this.id_footer.object.stock[this.id_footer.getrow()] = ad_stock

// w_goods_recieveable_note.wf_getsupplierinfo() returns 0
	long ll_suppcode
	if this.id_master = getfocus() and this.id_master.rowcount() > 0 then
		ll_suppcode = this.id_master.getitemnumber(this.id_master.getrow(), "suppcode")
		openwithparm(w_supplierinfo, ll_suppcode)
	end if

// w_goods_recieveable_note.wf_view_iteminfo() returns 0
	long ll_code
	if this.tab_retrieve.selectedtab = 2 then
		return
	end if
	if this.id_detail.rowcount() > 0 and this.id_detail.getrow() > 0 then
		ll_code = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		if ll_code > 0 and not isnull(ll_code) then
			openwithparm(w_iteminfo, ll_code)
		end if
	end if

// w_goods_recieveable_note.wf_populate_saleorder() returns long
	datastore lds_saleorderdetail
	datastore lds_saleorderheader
	s_saletemplate lstr_template
	boolean lb_enablesave
	boolean lb_insertrow
	integer li_retcode
	integer li_errcode
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_counter
	long ll_tmprowid
	long ll_tmpcode
	long ll_icode
	long ll_packunits
	datetime ldt_date
	string ls_errortext
	string ls_batch
	string ls_class
	if wf_iseditable() = false then
		return 0
	end if
	lds_saleorderdetail = create datastore
	lds_saleorderheader = create datastore
	open(w_editsaleorder_in_purchase_form)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_saleorderdetail.dataobject = "d_SaleOrderdetail_retrieve"
		lds_saleorderdetail.settransobject(this.it_transobject)
		lds_saleorderheader.dataobject = "d_SaleOrderheader"
		lds_saleorderheader.settransobject(this.it_transobject)
		ll_row = lds_saleorderheader.retrieve(lstr_template.l_invtemplate)
		if ll_row <= 0 then
			li_retcode = -1
			return li_retcode
		else
			ll_mrow = this.id_master.getrow()
			this.id_master.setitem(ll_mrow, "remarks", lds_saleorderheader.getitemstring(lds_saleorderheader.getrow(), "remarks"))
			this.id_master.setitem(ll_mrow, "headerno", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "headerno"))
			this.id_footer.setitem(ll_mrow, "misccharges", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "misccharges"))
			this.id_footer.setitem(ll_mrow, "flatdisc", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "flatdisc"))
			this.id_footer.setitem(ll_mrow, "discperc", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "discperc"))
			ldt_date = lds_saleorderheader.getitemdatetime(lds_saleorderheader.getrow(), "date")
			lds_saleorderdetail.retrieve(lstr_template.l_invtemplate, 0)
		end if
		ll_totalrows = lds_saleorderdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		if lb_enablesave then
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
			this.id_detail.reset()
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				ll_rowcount = this.id_detail.insertrow(0)
				ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_saleorderdetail.getitemnumber(ll_counter, "gcode")), 1, this.idc_godown.rowcount())
				ll_icode = lds_saleorderdetail.getitemnumber(ll_counter, "icode")
				if wf_inititeminfo(ll_icode, ll_rowcount, ls_errortext) then
					ll_packunits = this.id_detail.object.packunits[ll_rowcount]
					if ll_packunits = 0 or isnull(ll_packunits) then
						ll_packunits = 1
					end if
					ll_gcode = lds_saleorderdetail.getitemnumber(ll_counter, "gcode")
					if lstr_template.i_invtype = 0 then
						this.id_detail.object.batch[ll_rowcount] = f_stringpreferences("defaultbatch")
						this.id_detail.object.expiry[ll_rowcount] = f_datepreferences("defaultexpiry")
					else
						SQL SELECT NAME INTO :ls_class FROM DBO.ItemClass WHERE ICCode IN ( SELECT ICCode FROM Item WHERE ICode =:ll_icode ) USING this.it_transobject;
						ll_tmpcode = lds_saleorderdetail.getitemnumber(ll_counter, "code")
						ls_batch = trim(string(ll_tmpcode)) + trim(string(ll_icode)) + ls_class
						this.id_detail.object.batch[ll_rowcount] = left(ls_batch, 10)
						this.id_detail.object.expiry[ll_rowcount] = datetime(date(ldt_date), time("00:00:00"))
					end if
					this.id_detail.setitem(ll_rowcount, "gcode", ll_gcode)
					this.id_detail.setitem(ll_rowcount, "discperc", lds_saleorderdetail.getitemnumber(ll_counter, "discperc"))
					if this.ii_purchasetype = 1 then
						this.id_detail.setitem(ll_rowcount, "packqty", ceiling(lds_saleorderdetail.getitemnumber(ll_counter, "looseqty") / ll_packunits))
						this.id_detail.setitem(ll_rowcount, "bonusqty", ceiling(lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty") / ll_packunits))
					else
						this.id_detail.setitem(ll_rowcount, "looseqty", lds_saleorderdetail.getitemnumber(ll_counter, "looseqty"))
						this.id_detail.setitem(ll_rowcount, "bonusqty", lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty"))
					end if
				end if
			next
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	return li_retcode

// w_goods_recieveable_note.wf_setnull(string as_column, boolean as_isnewinv) returns integer
	long ll_null
	setnull(ll_null)
	this.id_master.setitem(1, as_column, ll_null)
	return 1

// w_goods_recieveable_note.wf_update_manfdate(long al_icode, long al_gcode, string as_batch, datetime adt_expiry, datetime adt_manfdate) returns long
	SQL update GodownDetail SET GodownDetail.ManfDate =:adt_manfdate WHERE GodownDetail.GCode =:al_gcode AND GodownDetail.ICode =:al_icode AND GodownDetail.Batch =:as_batch AND GodownDetail.Expiry =:adt_expiry USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		return 0
	end if
	return this.it_transobject.sqlcode

// w_goods_recieveable_note.wf_purchase_from_customer() returns long
	s_arguements lstr_arg
	long ll_custcode
	if this.tab_retrieve.selectedtab = 2 then
		return 0
	end if
	if this.id_master.object.posted[1] = "Y" then
		return 0
	end if
	ll_custcode = this.id_master.object.custcode[1]
	openwithparm(w_arg_purchasefromcustomer, ll_custcode)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		this.id_master.object.custcode[1] = lstr_arg.l_code1
		if this.id_master.object.custcode[1] > 0 then
			this.id_master.object.aliasname.protect = 1
			this.id_master.object.suppcode.protect = 1
			this.id_master.object.aliasname[1] = ""
			this.id_master.object.suppcode[1] = 18
			wf_setsuppinfo(18, this.id_master)
		else
			this.id_master.object.aliasname.protect = 0
			this.id_master.object.suppcode.protect = 0
			this.id_master.object.aliasname[1] = ""
			this.id_master.object.suppcode[1] = 18
			wf_setsuppinfo(18, this.id_master)
		end if
	end if
	return 0

