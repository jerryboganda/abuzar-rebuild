// w_goods_recieveable_note.create() returns 0
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_purchasemenu" then
		this.menuid = create m_purchasemenu
	end if
	this.dw_purinvrep = create dw_purinvrep
	this.dw_changeprice_foritemlog = create dw_changeprice_foritemlog
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_purinvrep
	this.control[icurrent + 2] = this.dw_changeprice_foritemlog

// w_goods_recieveable_note.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_purinvrep
	destroy this.dw_changeprice_foritemlog

// w_goods_recieveable_note.ue_save() returns 0
	integer li_counter
	integer li_option
	long ll_icode
	long ll_salesmancode
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_detailrows
	long ll_count
	long ll_found
	long ll_maxretcode
	double ld_saleprice
	double ld_packqty
	double ld_bonusqty
	double ld_looseqty
	string ls_updatepurprice
	boolean lb_commitflag
	boolean lb_isnewinv
	datetime ldt_expiry
	datetime ldt_server_datetime
	string ls_date_errtext
	date ld_expiry
	string ls_expiry
	ls_expiry = f_stringpreferences("purexpiry")
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 1 then
		for ll_count = 1 to ll_detailrows
			if ls_expiry = "Y" then
				ldt_expiry = this.id_detail.object.expiry[ll_count]
				ld_expiry = date(ldt_expiry)
				if ld_expiry <= relativedate(today(), f_numberpreferences("AcceptFutureExpiryDays")) then
					li_option = messagebox("Item Validation", "Expiry should be greater than " + string(relativedate(today(), f_numberpreferences("AcceptFutureExpiryDays")), "dd/mmm/yyyy") + "~r~nLine No. " + string(ll_count) + ", Expiry Date = " + string(ld_expiry, "dd/mmm/yyyy") + "~r~nAccept this expiry date?", question!, yesno!, 2)
					if li_option <> 1 then
						if this.ii_purchasetype = 1 then
							this.id_detail.setcolumn("packqty")
						else
							this.id_detail.setcolumn("looseqty")
						end if
						this.id_detail.scrolltorow(ll_count)
						this.id_detail.setfocus()
						return
					end if
					return
				end if
				return
			end if
			ll_found = 0
			if ll_count = ll_detailrows then
				exit
			end if
			ll_found = this.id_detail.find("gcode = long('" + string(this.id_detail.getitemnumber(ll_count, "gcode")) + "') and " + " icode = long('" + string(this.id_detail.getitemnumber(ll_count, "icode")) + "') and batch = '" + this.id_detail.getitemstring(ll_count, "batch") + "' and expiry = Date('" + string(this.id_detail.getitemdatetime(ll_count, "expiry"), "yyyy-mm-dd") + "')", ll_count + 1, ll_detailrows)
			if ll_found > 0 then
				messagebox("Item Validation", "Duplicate items found at row " + string(ll_count) + " and " + string(ll_found) + "." + "~r~nSuggested options are either delete the row or ~r~n" + "change Item batch or expiry")
				this.id_detail.scrolltorow(ll_count)
				if this.ii_purchasetype = 1 then
					this.id_detail.setcolumn("packqty")
				else
					this.id_detail.setcolumn("looseqty")
				end if
				this.id_detail.setfocus()
				return
			end if
		next
	elseif ll_detailrows <= 0 then
		messagebox("On Save Validation", "There are no rows to save.~r~nKindly insert some item row.")
		return
	end if
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if f_stringpreferences("puruserwindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	setfocus()
	if ll_salesmancode > 0 then
		setpointer(hourglass!)
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			lb_isnewinv = true
			ll_maxretcode = wf_tabnewid("purledger", ll_invid)
			if ll_maxretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~n ~t~t~t~t~t~t~tgenerating InvCode")
				return
			end if
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
			this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					if lb_isnewinv then
						wf_setnull("Code", lb_isnewinv)
						SQL rollback USING this.it_transobject;
					end if
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
		else
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		end if
		this.id_master.object.discperc[ll_mastercurrrow] = this.id_footer.object.discperc[ll_footercurrrow]
		this.id_master.object.flatdisc[ll_mastercurrrow] = this.id_footer.object.flatdisc[ll_footercurrrow]
		this.id_master.object.misccharges[ll_mastercurrrow] = this.id_footer.object.misccharges[ll_footercurrrow]
		this.id_master.object.invgstperc1[ll_mastercurrrow] = this.id_footer.object.invgstperc1[ll_footercurrrow]
		do while li_counter <= ll_detailrows
			this.id_detail.setitem(li_counter, "code", ll_invid)
			ll_icode = this.id_detail.object.icode[li_counter]
			SQL SELECT saleprice INTO :ld_saleprice FROM item WHERE icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = -1 then
				if lb_isnewinv then
					wf_setnull("Code", lb_isnewinv)
					SQL rollback USING this.it_transobject;
				end if
				messagebox("DataBase Error", "Problem In retrieving Item Information")
				return
			else
				this.id_detail.setitem(li_counter, "saleprice", ld_saleprice)
			end if
			ld_packqty = this.id_detail.getitemnumber(li_counter, "packqty")
			ld_looseqty = this.id_detail.getitemnumber(li_counter, "looseqty")
			ld_bonusqty = this.id_detail.getitemnumber(li_counter, "bonusqty")
			if ld_packqty + ld_looseqty + ld_bonusqty = 0.0 then
				if lb_isnewinv then
					wf_setnull("Code", lb_isnewinv)
					SQL rollback USING this.it_transobject;
				end if
				messagebox("Purchase Qty Validation", "Please enter valid qty")
				if this.ii_purchasetype = 1 then
					this.id_detail.setcolumn("packqty")
				else
					this.id_detail.setcolumn("looseqty")
				end if
				this.id_detail.selecttext(1, 1)
				return
			end if
			if lb_commitflag and this.id_detail.getitemstatus(li_counter, "purprice", primary!) = datamodified! and ls_updatepurprice = "Y" and wf_updateitempurprice(ll_icode, this.id_detail.getitemnumber(li_counter, "purprice")) <> 0 then
				lb_commitflag = false
			end if
			li_counter = li_counter + 1
		loop
		call super::ue_save
		if this.ib_commitok = false and lb_isnewinv then
			wf_setnull("Code", lb_isnewinv)
		end if
		if lb_commitflag and f_stringpreferences("IncPurInActMonitor") = "Y" then
			this.it_transobject.updateactivitymonitor("PV", ll_invid)
			if this.it_transobject.sqlcode <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
			else
				SQL commit USING this.it_transobject;
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_goods_recieveable_note.ue_newform() returns 0
	integer rtncode
	integer ll_counter
	string ls_date_errtext
	datetime ldt_server_datetime
	m_purchasemenu lm_menu
	call super::ue_newform
	lm_menu = this.menuid
	setredraw(false)
	lm_menu.m_file.m_itempurchasehistory.enabled = false
	for ll_counter = 1 to ll_counter
		if gds_securitywindow.object.rightcode[ll_counter] = 528 then
			lm_menu.m_file.m_savepost.enabled = true
		end if
	next
	wf_setgodownoption()
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.ids_purexp.reset()
	wf_assign_purexp_object()
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.id_footer.object.discperc[1] = 0
	this.id_footer.object.flatdisc[1] = 0
	this.id_footer.object.misccharges[1] = 0
	if this.ii_purchasetype = 2 then
		this.id_master.object.suppcode[this.id_master.getrow()] = this.il_code
	end if
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	setredraw(true)
	this.id_footer.object.t_rpp.text = ""
	this.id_footer.object.t_avgprice.text = ""
	if this.ib_modifydate then
		if this.ib_fetchserverdate then
			wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
			this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
		else
			this.id_master.setitem(this.id_master.getrow(), "date", today())
		end if
	end if
	if not wf_validatedate() then
		close(this)
	end if
	this.id_master.object.aliasname.protect = 0
	this.id_master.object.suppcode.protect = 0

// w_goods_recieveable_note.ue_detail() returns 0
	long ll_code
	long ll_counter
	integer li_rtncode
	integer li_protect
	m_purchasemenu lm_menu
	call super::ue_detail
	lm_menu = this.menuid
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	this.id_footer.retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	if wf_allowpurchasemodification(ll_code, this.il_groupcode, this.il_strategy) <> 0 then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "You Can not modify this Invoice,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	wf_initmodify(li_protect)
	if li_protect = 0 then
		if not this.ib_normalpurmodify and this.ii_purchasetype = 1 then
			li_protect = 1
		end if
		if not this.ib_loosepurmodify and this.ii_purchasetype = 7 then
			li_protect = 1
		end if
		if not this.ib_loosepurmodify and this.ii_purchasetype <> 1 and this.ii_purchasetype = 7 then
			li_protect = 1
		end if
	end if
	wf_protectdw(this.id_master, li_protect)
	if not isnull(this.id_master.object.pocode[1]) then
		wf_setpurorderinfo(this.id_master.object.pocode[1])
	end if
	if ll_code > 0 then
		wf_assign_purexp_object()
		this.ids_purexp.retrieve(ll_code)
	end if
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_purchasegodownoption
	end if
	wf_setgodownoption()
	this.im_menu.m_file.m_save.enabled = false
	if li_protect = 0 then
		this.im_menu.m_file.m_save.enabled = true
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 528 then
				lm_menu.m_file.m_savepost.enabled = true
			end if
		next
		if this.id_master.object.custcode[1] > 0 then
			this.id_master.object.aliasname.protect = 1
			this.id_master.object.suppcode.protect = 1
		else
			this.id_master.object.aliasname.protect = 0
			this.id_master.object.suppcode.protect = 0
		end if
	end if
	if li_protect = 1 then
		this.editflag = false
		this.id_footer.object.t_rpp.text = ""
		this.id_footer.object.t_avgprice.text = ""
	end if
	this.im_menu.m_file.m_print.enabled = true
	wf_grandtotal()
	setredraw(true)

// w_goods_recieveable_note.ue_newitem() returns 0
	long ll_rowcount
	long ll_currentrow
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 1 and vf_dwdupcodebatch(this.id_detail, "gcode", gl_defaultgcode, "icode", this.id_detail.getitemnumber(this.id_detail.getrow(), "icode"), "batch", this.id_detail.getitemstring(this.id_detail.getrow(), "batch"), "expiry", this.id_detail.getitemdatetime(this.id_detail.getrow(), "expiry"), this.il_currrow) = true then
		messagebox("Item Validation", "Duplicate item, please select some other item")
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.settransobject(this.it_transobject)
	if f_stringpreferences("enablequickprefferedsearch") = "Y" then
		this.id_detail.setcolumn("quicksearch")
	elseif f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	ll_currentrow = this.id_detail.getrow()
	if ll_currentrow = this.id_detail.rowcount() then
		if f_stringpreferences("AutoSelectLastRowGodownInPur") = "Y" and this.id_detail.rowcount() > 0 then
			this.id_detail.object.gcode.initial = string(this.id_detail.object.gcode[this.id_detail.rowcount()])
		end if
		this.id_detail.insertrow(0)
		ll_rowcount = this.id_detail.rowcount()
		if ll_rowcount > 1 then
			this.id_detail.scrolltorow(ll_rowcount)
			this.id_detail.setfocus()
		end if
	else
		if f_stringpreferences("AutoSelectLastRowGodownInPur") = "Y" and ll_currentrow > 0 then
			this.id_detail.object.gcode.initial = string(this.id_detail.object.gcode[ll_currentrow])
		end if
		this.id_detail.insertrow(ll_currentrow)
		this.id_detail.scrolltorow(ll_currentrow)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_goods_recieveable_note.ue_deleteitem() returns 0
	long ll_row
	ll_row = this.id_detail.getrow()
	if this.id_detail.rowcount() > 0 then
		call super::ue_deleteitem
		return
	end if
	this.im_menu.m_file.m_print.enabled = false

// w_goods_recieveable_note.close() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	destroy this.ids_itemstockinfo
	return ::message.returnvalue

// w_goods_recieveable_note.ue_new() returns 0
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_goods_recieveable_note.ue_list() returns 0
	m_purchasemenu lm_menu
	long ll_counter
	call super::ue_list
	lm_menu = this.menuid
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_post.enabled = true
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 528 then
			lm_menu.m_file.m_savepost.enabled = false
		end if
	next

// w_goods_recieveable_note.ue_refreshddw() returns 0
	call super::ue_refreshddw
	if this.ii_purchasetype = 1 then
		setpointer(hourglass!)
		this.idc_supplierlist.setredraw(false)
		this.idc_supplierlist.settransobject(this.it_transobject)
		this.idc_supplierlist.reset()
		this.idc_supplierlist.retrieve()
		this.idc_supplierlist.setredraw(true)
		setpointer(arrow!)
	end if

// w_goods_recieveable_note.ue_print() returns 0
	long ll_suppcode
	long ll_row
	string ls_suppname
	call super::ue_print
	if this.im_menu.m_file.m_save.enabled = true then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	wf_selectprintreport()
	this.id_print.retrieve(this.id_master.getitemnumber(1, "code"))
	if this.id_print.rowcount() > 0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_goods_recieveable_note.ue_postopen() returns 0
	datawindowchild ldc_dddpurcategory
	datawindowchild ldc_headerno
	m_purchasemenu lm_menu
	datastore lds_headers
	integer li_rtncode
	long ll_code
	long ll_counter
	long ll_found
	call super::ue_postopen
	lm_menu = this.menuid
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	setredraw(false)
	wf_setpurchasetype(integer(message.doubleparm))
	wf_assign_purexp_object()
	this.id_print = this.dw_purinvrep
	this.id_print.settransobject(this.it_transobject)
	choose case this.ii_purchasetype
	case 1
		this.title = "Goods Receiving Note(Pack)"
		wf_assigndatawindowobjects("d_NormalPurchaseHeader", "d_NormalPurchaseDetail", "d_NormalPurchaseList")
		li_rtncode = this.id_master.getchild("suppcode", this.idc_supplierlist)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
		end if
		this.idc_supplierlist.settransobject(this.it_transobject)
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 540 then
				this.im_menu.m_file.m_post.visible = true
				this.im_menu.m_file.m_post.toolbaritemvisible = true
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 542 then
				this.ib_normalpurmodify = true
			end if
		next
		this.id_detail.object.salepriceforitem.visible = false
		this.id_detail.object.flatdiscforitem.visible = false
		this.id_detail.object.retailprice.visible = false
		this.id_detail.object.batchsaleprice.visible = false
		if f_stringpreferences("showpurchaseorderinpurchase") = "N" then
			this.id_master.object.pocode.visible = false
			this.id_master.object.pocode_t.visible = false
			this.id_master.object.podate.visible = false
			this.id_master.object.podate_t.visible = false
			this.id_master.object.posupplierreference.visible = false
			this.id_master.object.posupplierreference_t.visible = false
		end if
		if f_stringpreferences("ShowGoodsCompanyInPurchase") = "N" then
			this.id_master.object.gccode.visible = false
			this.id_master.object.gccode_t.visible = false
		end if
		if f_stringpreferences("ShowVehicleInPurchase") = "N" then
			this.id_master.object.vehicle.visible = false
			this.id_master.object.vehicle_t.visible = false
		end if
		if f_stringpreferences("ShowShipToInPurchase") = "N" then
			this.id_master.object.shipto.visible = false
			this.id_master.object.shipto_t.visible = false
		end if
		if f_stringpreferences("ShowAssociatedSaleInvCodeInPurchase") = "N" then
			this.id_master.object.associatedsaleinvcode.visible = false
			this.id_master.object.associatedsaleinvcode_t.visible = false
		end if
		if f_stringpreferences("asknewponoinpur") = "N" then
			this.id_master.object.newpurchaseorderno.visible = false
			this.id_master.object.t_newpurchaseorderno.visible = false
			this.id_master.object.newpurchaseorderno.initial = "."
		elseif f_stringpreferences("allowemptynewponoinpur") = "N" then
			this.id_master.object.newpurchaseorderno.edit.required = "yes"
		end if
		if f_stringpreferences("asklcnoinpur") = "N" then
			this.id_master.object.lcno.visible = false
			this.id_master.object.t_lcno.visible = false
			this.id_master.object.lcno.initial = "."
		elseif f_stringpreferences("allowemptylcnoinpur") = "N" then
			this.id_master.object.lcno.edit.required = "yes"
		end if
		if f_stringpreferences("askcrdaysinpur") = "N" then
			this.id_master.object.creditdays.visible = false
			this.id_master.object.creditdays_t.visible = false
			this.id_master.object.c_duedate.visible = false
			this.id_master.object.c_duedate_t.visible = false
		end if
		if f_stringpreferences("asklcnoinpur") = "N" then
			this.id_master.object.lcno.visible = false
			this.id_master.object.t_lcno.visible = false
			this.id_master.object.lcno.initial = "."
		elseif f_stringpreferences("allowemptylcnoinpur") = "N" then
			this.id_master.object.lcno.edit.required = "yes"
		end if
	case 7
		this.title = "Goods Receiving Note(Loose)"
		wf_assigndatawindowobjects("d_LoosePurchaseHeader", "d_loosePurchaseDetail", "d_LoosePurchaseList")
		li_rtncode = this.id_master.getchild("suppcode", this.idc_supplierlist)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
		end if
		this.idc_supplierlist.settransobject(this.it_transobject)
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 541 then
				this.im_menu.m_file.m_post.visible = true
				this.im_menu.m_file.m_post.toolbaritemvisible = true
			end if
			if gds_securitywindow.object.rightcode[ll_counter] = 543 then
				this.ib_loosepurmodify = true
			end if
		next
		if f_stringpreferences("asknewponoinpur") = "N" then
			this.id_master.object.newpurchaseorderno.visible = false
			this.id_master.object.t_newpurchaseorderno.visible = false
			this.id_master.object.newpurchaseorderno.initial = "."
		elseif f_stringpreferences("allowemptynewponoinpur") = "N" then
			this.id_master.object.newpurchaseorderno.edit.required = "yes"
		end if
		if f_stringpreferences("asklcnoinpur") = "N" then
			this.id_master.object.lcno.visible = false
			this.id_master.object.t_lcno.visible = false
			this.id_master.object.lcno.initial = "."
		elseif f_stringpreferences("allowemptylcnoinpur") = "N" then
			this.id_master.object.lcno.edit.required = "yes"
		end if
		if f_stringpreferences("askcrdaysinpur") = "N" then
			this.id_master.object.creditdays.visible = false
			this.id_master.object.creditdays_t.visible = false
			this.id_master.object.c_duedate.visible = false
			this.id_master.object.c_duedate_t.visible = false
		end if
		if f_stringpreferences("asklcnoinpur") = "N" then
			this.id_master.object.lcno.visible = false
			this.id_master.object.t_lcno.visible = false
			this.id_master.object.lcno.initial = "."
		elseif f_stringpreferences("allowemptylcnoinpur") = "N" then
			this.id_master.object.lcno.edit.required = "yes"
		end if
	case else
		this.title = "Opening Purchase"
		wf_assigndatawindowobjects("d_OpeningPurchaseHeader", "d_OpeningPurchaseDetail", "d_OpeningPurchaseList")
		this.it_transobject.getglobalcode("GT_OpeningSupplierACC", this.il_code)
	end choose
	this.id_detail.object.c_netmargin.visible = false
	this.id_detail.object.c_margin.visible = false
	this.id_detail.object.c_markup.visible = false
	this.id_detail.object.salediscperc.visible = false
	this.id_detail.object.alternatecustomicode.visible = false
	this.id_detail.object.packunits.visible = false
	this.id_detail.object.unitweight.visible = false
	this.id_detail.object.c_totalweight.visible = false
	this.id_detail.object.packcapacity.visible = false
	this.id_detail.object.areavolume.visible = false
	this.id_detail.object.c_packcoverage.visible = false
	this.id_detail.object.pcs.visible = false
	this.id_detail.object.cartons.visible = false
	this.id_detail.object.extrataxperc.visible = false
	if f_stringpreferences("showpurchasetypeinpurchase") = "N" then
		this.id_master.object.purtypecode.visible = false
		this.id_master.object.purtypecode_t.visible = false
	elseif f_stringpreferences("allowemptypurtypeinpur") = "N" then
		this.id_master.object.purtypecode.dddw.required = "yes"
	end if
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 544 then
			lm_menu.m_file.m_savepost.visible = true
			lm_menu.m_file.m_savepost.enabled = true
		end if
	next
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit to Make GRN/Purchase")
		close(this)
		return
	end if
	li_rtncode = this.id_detail.getchild("gcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to GRN/Purchase")
		close(this)
		return
	end if
	this.ii_purchasegodownoption = this.idc_godown.getitemnumber(1, "gcode")
	this.id_detail.object.gcode.initial = string(this.ii_purchasegodownoption)
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = false
	this.id_itemslist.object.sstock.visible = false
	this.id_itemslist.object.t_pstock.visible = true
	this.id_itemslist.object.pstock.visible = true
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_detail.object.gcode.visible = false
		this.id_master.object.t_gcode.visible = true
		this.id_master.object.gcode.visible = true
		this.id_master.object.gcode.initial = string(this.ii_purchasegodownoption)
	end if
	if f_stringpreferences("puritemdescription") = "N" then
		this.id_detail.object.itemdescription.visible = false
	end if
	if f_stringpreferences("purbatch") = "N" then
		this.id_detail.object.batch.visible = false
	end if
	if f_stringpreferences("ManfDateInPur") = "N" then
		this.id_detail.object.manfdate.visible = false
	end if
	if f_stringpreferences("purexpiry") = "N" then
		this.id_detail.object.expiry.visible = false
	end if
	this.id_list.object.total.visible = false
	if f_stringpreferences("packingdescinpurchase") = "N" then
		this.id_detail.object.packingdesc.visible = false
	end if
	this.id_detail.object.totalpieces.visible = false
	this.id_detail.object.totalpieces.initial = "0"
	this.id_detail.object.totalpieces.validation = "Real (GetText()) >= 0"
	this.id_detail.object.pcs.initial = "0"
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.pstock.visible = false
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	if f_stringpreferences("visibleporb") = "N" then
		this.id_master.object.porb.visible = false
		this.id_master.object.t_porb.visible = false
	end if
	if f_stringpreferences("showpuritemunittax") = "N" then
		this.id_detail.object.unitsalestax.visible = false
		this.id_detail.object.c_sumtaxval.visible = false
		this.id_detail.object.c_taxval.visible = false
	end if
	if f_stringpreferences("showpuritemgstperc") = "N" then
		this.id_detail.object.gstperc.visible = false
		this.id_detail.object.c_sumgstval.visible = false
		this.id_detail.object.c_gstval.visible = false
	end if
	this.id_detail.object.manfcodeforitem.visible = false
	if f_stringpreferences("showpurinvgstperc") = "N" then
		this.id_footer.object.invgstperc1.visible = false
		this.id_footer.object.invgstperc1_t.visible = false
	end if
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make GRN/Purchase")
		close(this)
		return
	end if
	if f_stringpreferences("headeronpurchaseinv") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.t_headerno.visible = false
	end if
	this.id_master.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to lds_headers.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
		ldc_headerno.setitem(ll_counter, "name", "")
		ll_found = 0
		ll_found = gds_reoprtheaderinfo.find("headerno=" + string(lds_headers.getitemnumber(ll_counter, "headercode")), 1, gds_reoprtheaderinfo.rowcount())
		if ll_found > 0 then
			ldc_headerno.setitem(ll_counter, "headeralias", gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks"))
		end if
	next
	this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
	this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
	this.id_detail.object.valueextax.visible = false
	if f_stringpreferences("puritemdescription") = "N" then
		this.id_detail.object.itemdescription.visible = false
	end if
	if f_stringpreferences("bonusinpurchase") = "N" then
		this.id_detail.object.bonusqty.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 580", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.date.protect = 0
		this.id_master.object.date.background.color = rgb(255, 255, 255)
		this.ib_modifydate = true
		lm_menu.m_file.m_setserverdate.visible = true
		lm_menu.m_file.m_setserverdate.enabled = true
	end if
	if not this.ib_modifydate then
		this.id_master.object.date.protect = 1
		this.id_master.settaborder("date", 0)
		lm_menu.m_file.m_setserverdate.visible = false
		lm_menu.m_file.m_setserverdate.enabled = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5154", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_purchasefromcustomer.visible = true
		lm_menu.m_file.m_purchasefromcustomer.enabled = true
	else
		lm_menu.m_file.m_purchasefromcustomer.visible = false
		lm_menu.m_file.m_purchasefromcustomer.enabled = false
	end if
	this.id_footer.settaborder("total", 0)
	if f_stringpreferences("updateavgpricewithnetrate") = "N" then
		this.id_master.object.updateavgpricewithnetrate.initial = "N"
	else
		this.id_master.object.updateavgpricewithnetrate.initial = "Y"
	end if
	this.id_detail.object.quicksearch.visible = false
	this.id_master.object.creditordebit.visible = false
	this.id_master.object.suppbalance.visible = false
	this.id_master.object.t_balance.visible = false
	wf_set_itemexpense_interface()
	if f_stringpreferences("Showdeptinpur") = "Y" then
		this.id_master.object.icatcode.visible = true
		this.id_master.object.icatcode_t.visible = true
	else
		this.id_master.object.icatcode.visible = false
		this.id_master.object.icatcode_t.visible = false
	end if
	if f_stringpreferences("ShowSuppDateinpur") = "Y" then
		this.id_master.object.suppinvdate.visible = true
		this.id_master.object.suppinvdate_t.visible = true
	else
		this.id_master.object.suppinvdate.visible = false
		this.id_master.object.suppinvdate_t.visible = false
	end if
	if this.ii_purchasetype = 1 or this.ii_purchasetype = 7 then
		if f_stringpreferences("ShowSuppAmtinpur") = "Y" then
			this.id_master.object.suppinvamount.visible = true
			this.id_master.object.suppinvamount_t.visible = true
		else
			this.id_master.object.suppinvamount.visible = false
			this.id_master.object.suppinvamount_t.visible = false
		end if
	end if
	if f_stringpreferences("ShowGrninpur") = "Y" then
		this.id_master.object.grn.visible = true
		this.id_master.object.grn_t.visible = true
	else
		this.id_master.object.grn.visible = false
		this.id_master.object.grn_t.visible = false
	end if
	if f_stringpreferences("ShowSuppInvNoinpur") = "Y" then
		this.id_master.object.suppinvcode.visible = true
		this.id_master.object.suppinvcode_t.visible = true
	else
		this.id_master.object.suppinvcode.visible = false
		this.id_master.object.suppinvcode_t.visible = false
	end if
	if f_stringpreferences("ShowAccountForinPurchase") = "Y" then
		this.id_master.object.accountfor.visible = true
		this.id_master.object.t_accountfor.visible = true
	else
		this.id_master.object.accountfor.visible = false
		this.id_master.object.t_accountfor.visible = false
	end if
	if f_stringpreferences("PurchaseAccountFor") = "Y" then
		this.id_master.object.accountfor.initial = "Y"
	else
		this.id_master.object.accountfor.initial = "N"
	end if
	this.id_detail.object.netrate.visible = false
	this.id_detail.object.valueextax.visible = false
	gd_itemsinfo.sharedata(this.id_itemslist)
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.id_footer.settaborder("total", 0)
	wf_columns_releatedtopurchase()
	f_setcolumnstyle(this.id_detail, "Qty")
	setredraw(true)

// w_goods_recieveable_note.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	show()
	return ::message.returnvalue

// w_goods_recieveable_note.closequery() returns long
	integer li_yesno
	integer li_rtcode
	if this.editflag = true then
		li_yesno = messagebox("Invoice", "Do You want to save changes", question!, yesnocancel!, 2)
		if li_yesno = 1 then
			triggerevent("ue_save")
			if wf_commitform() = false then
				li_rtcode = 1
			end if
		elseif li_yesno = 2 then
			SQL rollback USING this.it_transobject;
			li_rtcode = 0
		elseif li_yesno = 3 then
			li_rtcode = 1
		end if
	end if
	return li_rtcode
