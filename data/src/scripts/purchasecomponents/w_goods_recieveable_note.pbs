	this.id_detail.object.qe1.visible = false
	this.id_detail.object.c_qe1.visible = false
	this.id_detail.object.qe2.visible = false
	this.id_detail.object.c_qe2.visible = false
	this.id_detail.object.qe3.visible = false
	this.id_detail.object.c_qe3.visible = false
	this.id_detail.object.qe4.visible = false
	this.id_detail.object.c_qe4.visible = false
	this.id_detail.object.qe5.visible = false
	this.id_detail.object.c_qe5.visible = false
	this.id_detail.object.we1.visible = false
	this.id_detail.object.c_we1.visible = false
	this.id_detail.object.we2.visible = false
	this.id_detail.object.c_we2.visible = false
	this.id_detail.object.we3.visible = false
	this.id_detail.object.c_we3.visible = false
	this.id_detail.object.we4.visible = false
	this.id_detail.object.c_we4.visible = false
	this.id_detail.object.we5.visible = false
	this.id_detail.object.c_we5.visible = false
	this.id_detail.object.c_itemexpenses.visible = false
