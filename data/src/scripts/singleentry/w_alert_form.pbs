// window w_alert_form (singleentry)  ancestor: w_single_entry

// w_alert_form.ue_newform() returns 0 [event]
	call super::ue_newform

// w_alert_form.create() returns 0 [event]
	integer icurrent
	call super::create

// w_alert_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_alert_form.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.is_tablename = "Alert"
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_alert_form.ue_save() returns 0 [event]
	long ll_newid
	long ll_row
	ll_row = this.id_detail.getrow()
	ll_newid = this.id_detail.object.code[this.id_detail.getrow()]
	if isnull(ll_newid) then
		f_newtableid("Alert", ll_newid)
		this.id_detail.object.code[ll_row] = ll_newid
	end if
	call super::ue_save

// tabpage_detail.create() returns 0 [event]
	integer icurrent
	this.dw_1 = create dw_1
	call super::create
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_1

// tabpage_detail.destroy() returns 0 [event]
	call super::destroy
	destroy this.dw_1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_name
	string ls_name2
	long ll_count
	integer rt_code
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "name"
		ls_name = lower(trim(data))
		SQL Select count ( *) INTO :ll_count From alert Where name =:ls_name USING sqlca;
		if sqlca.sqlcode <> 0 then
			messagebox("Database Error", "Some database request has been fail")
			rt_code = 1
		elseif not isnull(ll_count) and ll_count > 0 then
			messagebox("Name Validation", "Name " + ls_name + " already exist~r~nEnter some differnt name")
			rt_code = 1
		end if
	end choose
	return rt_code

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "name"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	end choose
	return 1

// dw_detail.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	if parent.dw_detail.getcolumnname() <> "detail" then
		ancestorreturnvalue = super::ue_enterkey()
		return 1
	end if
	return ::message.returnvalue
