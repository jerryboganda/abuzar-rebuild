// menu m_accountmenu (singleentry)  ancestor: m_single_entry

// m_accountmenu.create() returns 0 [event]
	m_accountmenu = this
	call super::create

// m_accountmenu.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_showaccountledger = create m_showaccountledger
	this.item[upperbound(this.item) + 1] = this.m_showaccountledger

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_showaccountledger

// m_showaccountledger.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_showaccountledger()

// m_showaccountledger.create() returns 0 [event]
	call super::create
	this.visible = false
	this.text = "Show Account Ledger~tF1"
	this.enabled = false
	this.shortcut = 112

// m_showaccountledger.destroy() returns 0 [event]
	call super::destroy
