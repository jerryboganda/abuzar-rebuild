// window w_guaranteeperson_form (singleentry)  ancestor: w_single_entry

// w_guaranteeperson_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM GuaranteePerson WHERE GuaranteePerson.name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_guaranteeperson_form.create() returns 0
	call super::create

// w_guaranteeperson_form.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_guaranteeperson_form.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "guaranteeperson"
	return ::message.returnvalue
