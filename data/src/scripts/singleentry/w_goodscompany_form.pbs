// window w_goodscompany_form (singleentry)  ancestor: w_single_entry

// w_goodscompany_form.ue_newform() returns 0
	call super::ue_newform

// w_goodscompany_form.create() returns 0
	call super::create

// w_goodscompany_form.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_goodscompany_form.activate() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_goodscompany_form.ue_save() returns 0
	call super::ue_save

// w_goodscompany_form.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "GoodsCompany"
	return ::message.returnvalue
