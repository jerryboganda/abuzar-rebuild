// window w_goodscompany_form (singleentry)  ancestor: w_single_entry

// w_goodscompany_form.ue_newform() returns 0 [event]
	call super::ue_newform

// w_goodscompany_form.create() returns 0 [event]
	call super::create

// w_goodscompany_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_goodscompany_form.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_goodscompany_form.ue_save() returns 0 [event]
	call super::ue_save

// w_goodscompany_form.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "GoodsCompany"
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "name"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for " + upper(dwo.name) + " in current row")
		else
			messagebox("Name Validation", "~t~tThe First letter of  ~"" + data + "~"~t~t~r~n should be Alphabet")
		end if
	end choose
	return 1
