// window w_guaranteeperson (singleentry)  ancestor: window

// w_guaranteeperson.ue_close(integer ai_status) returns 0
	if ai_status = -1 then
		setnull(this.il_code)
	end if
	closewithreturn(this, this.il_code)

// w_guaranteeperson.ue_postopen() returns 0
	integer li_rtncode
	this.dw_detail.settransobject(this.it_transobject)
	this.dw_detail.insertrow(0)

// w_guaranteeperson.wf_validateserverdatetime(datetime ar_server_datetime, string ar_errtext) returns boolean
	datetime ldt_last_transdate
	datetime ldt_current_serverdate
	long li_max_allow_days
	ar_errtext = "Invoice Date  Check violates"
	li_max_allow_days = f_numberpreferences("MaxAllowDate")
	if isnull(li_max_allow_days) then
		li_max_allow_days = 4
	end if
	SQL SELECT LastTransDate INTO :ldt_last_transdate FROM ServerDate USING sqlca;
	if sqlca.sqlcode = 0 then
		sqlca.getdatetime(ldt_current_serverdate)
		if sqlca.sqlcode = 0 then
			if ldt_current_serverdate >= ldt_last_transdate and daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) <= li_max_allow_days then
				ar_server_datetime = ldt_current_serverdate
				return true
			elseif ldt_current_serverdate < ldt_last_transdate then
				ar_errtext = "Back Date Invoice Check violates"
				return false
			elseif daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) > li_max_allow_days then
				ar_errtext = "Forward Date Invoice Check violates"
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_guaranteeperson.wf_connect() returns long
	this.it_transobject = create u_transaction
	SQL start USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		return 0
	end if
	messagebox("Connection Problem", "Problem Connecting Database ... ~r~n" + this.it_transobject.sqlerrtext)
	return -1

// w_guaranteeperson.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM GuaranteePerson WHERE GuaranteePerson.name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_guaranteeperson.create() returns 0
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.dw_detail = create dw_detail
	this.control = {this.cb_cancel, this.cb_ok, this.dw_detail}

// w_guaranteeperson.destroy() returns 0
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.dw_detail

// w_guaranteeperson.open() returns long
	long ll_row
	long ll_width
	long ll_height
	environment env
	if wf_connect() <> 0 then
		close(this)
		return ::message.returnvalue
	end if
	if getenvironment(env) <> 1 then
		return ::message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.x = int((ll_width - this.width) / 2.0)
	this.y = int((ll_height - this.height) / 2.0)
	post event ue_postopen()
	return ::message.returnvalue

// cb_cancel.ue_keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.ue_keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	long ll_primarykey
	long ll_row
	long ll_usercode
	long ll_null
	long ll_new_pat_reg
	long ll_primarykey_old
	integer li_patientcatcode
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_regno
	dwitemstatus ldw_active
	boolean lb_commit
	setpointer(hourglass!)
	setnull(ll_null)
	if f_validatedw(parent.dw_detail) < 0 then
		return ::message.returnvalue
	end if
	ll_row = parent.dw_detail.getrow()
	ll_primarykey = parent.dw_detail.object.code[ll_row]
	ll_primarykey_old = ll_primarykey
	if isnull(ll_primarykey) then
		ll_primarykey = 0
		ll_new_pat_reg = 1
		SQL rollback USING parent.it_transobject;
		parent.it_transobject.gettabmaxkey("guaranteeperson", ll_primarykey)
		if parent.it_transobject.sqlcode = 0 then
			parent.dw_detail.setitem(ll_row, "code", ll_primarykey)
		else
			SQL rollback USING parent.it_transobject;
			lb_commit = false
			parent.dw_detail.setitem(ll_row, "code", ll_null)
			messagebox("Guarantee Person Problem", "Problem in Auto Generation of Guarantee Person~r~n Possibe Reason: " + parent.it_transobject.sqlerrtext)
		end if
	end if
	if lb_commit then
		if parent.dw_detail.update() > 0 then
			SQL commit USING parent.it_transobject;
			messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
			parent.il_code = ll_primarykey
		else
			SQL rollback USING parent.it_transobject;
			setpointer(arrow!)
			if isnull(ll_primarykey_old) then
				parent.dw_detail.setitem(ll_row, "code", ll_null)
			end if
			messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs", exclamation!, ok!, 1)
			return ::message.returnvalue
		end if
		setpointer(arrow!)
		parent.post event ue_close(1)
	end if
	if isnull(ll_primarykey_old) then
		parent.dw_detail.setitem(ll_row, "code", ll_null)
	end if
	setpointer(arrow!)
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long
	send(handle(this), 256, 9, long(90))
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long
	choose case dwo.name
	case "name"
		if parent.wf_duplicatename(data) then
			messagebox("Name Validation", "Duplication Name Error~n~rPlease Choose Some Other Name")
			return 1
		end if
	end choose
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long
	choose case dwo.name
	case "regno"
		messagebox("ItemNo Validation", "Item Duplication Error~r~nPlease enter some other Reg No")
	end choose
	return 1
