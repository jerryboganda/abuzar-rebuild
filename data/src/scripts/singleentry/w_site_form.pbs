// window w_site_form (singleentry)  ancestor: w_single_entry

// w_site_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM Site WHERE InstanceID =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_site_form.create() returns 0 [event]
	call super::create

// w_site_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_site_form.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_site_form.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_tablename = "Site"
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "Name"
		if data = "" or isnull(data) then
			messagebox("Site Name Validation", "Site Name Error~n~rPlease enter Some valid Name")
			return 1
		end if
	case "InstanceID"
		if parent.parent.parent.wf_duplicatename(data) then
			messagebox("Site Instance ID Validation", "Duplication Site Instance ID Error~n~rPlease enter Some Valid Unique Site Instance ID")
			return 1
		end if
	end choose
	return ::message.returnvalue
