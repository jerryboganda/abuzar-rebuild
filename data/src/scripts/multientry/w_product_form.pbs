// w_product_form.create() returns 0
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_productmenu" then
		this.menuid = create m_productmenu
	end if
	this.dw_print = create dw_print
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print

// w_product_form.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_print

// w_product_form.ue_save() returns 0
	long ll_mastercurrrow
	long ll_invid
	long ll_detailrows
	long ll_null
	integer li_counter
	integer ll_salesmancode
	boolean lb_commitflag
	setnull(ll_null)
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if isnull(this.id_master.object.chasisno[1]) or this.id_master.object.chasisno[1] = "" then
		this.id_master.setfocus()
		this.id_master.setcolumn("chasisno")
	end if
	if isnull(this.id_master.object.engineno[1]) or this.id_master.object.engineno[1] = "" then
		this.id_master.setfocus()
		this.id_master.setcolumn("engineno")
	end if
	setpointer(hourglass!)
	ll_mastercurrrow = this.id_master.getrow()
	ll_invid = this.id_master.object.code[ll_mastercurrrow]
	if isnull(ll_invid) then
		wf_tabnewid("product", ll_invid)
		this.id_master.object.code[ll_mastercurrrow] = ll_invid
	end if
	this.id_master.object.usercode[1] = gl_usercode
	if isnull(this.id_master.object.finalizedby[1]) then
		this.id_master.object.finalizedby[1] = gl_usercode
	end if
	if isnull(this.id_master.object.aquiredby[1]) then
		this.id_master.object.aquiredby[1] = gl_usercode
	end if
	if isnull(this.id_master.object.deliveredby[1]) then
		this.id_master.object.deliveredby[1] = gl_usercode
	end if
	if isnull(this.id_master.object.soldby[1]) then
		this.id_master.object.soldby[1] = gl_usercode
	end if
	if this.id_master.update(true, true) < 0 then
		this.id_master.object.code[ll_mastercurrrow] = ll_null
		SQL rollback USING this.it_transobject;
	else
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		this.ib_commitok = true
		this.id_master.resetupdate()
		this.im_menu.m_file.m_new.enabled = true
		this.editflag = false
		if gd_recenttransdate < this.id_systemdate then
			gd_recenttransdate = this.id_systemdate
		end if
	end if
	setpointer(arrow!)

// w_product_form.ue_newform() returns 0
	m_productmenu lm_menu
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	setredraw(false)
	this.i_editmode = 1
	this.i_retrievemode = 2
	lm_menu.m_file.m_save.enabled = true
	lm_menu.m_file.m_new.enabled = false
	lm_menu.m_file.m_delete.enabled = false
	lm_menu.m_item.m_newitem.enabled = true
	lm_menu.m_item.m_deleteitem.enabled = true
	lm_menu.m_item.m_insertnewitem.enabled = false
	lm_menu.m_item.m_deletecurrentitem.enabled = false
	lm_menu.m_file.m_first.enabled = false
	lm_menu.m_file.m_next.enabled = false
	lm_menu.m_file.m_previous.enabled = false
	lm_menu.m_file.m_last.enabled = false
	lm_menu.m_file.m_print.enabled = false
	lm_menu.m_file.m_retrieve.enabled = true
	lm_menu.m_file.m_retrieve.text = "Lis&t"
	this.tab_retrieve.tabpage_detail.enabled = true
	if this.id_master.rowcount() > 0 then
		this.id_master.reset()
	end if
	this.ib_focusdetail = false
	this.id_master.insertrow(0)
	this.id_detail.reset()
	this.id_detail.insertrow(0)
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	this.ids_itemrecyclebin.reset()
	setredraw(true)
	this.id_master.setfocus()
	this.id_master.setcolumn("name")

// w_product_form.ue_newitem() returns 0

// w_product_form.ue_detail() returns 0
	m_productmenu lm_menu
	call super::ue_detail
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	lm_menu.m_file.m_delete.enabled = true
	lm_menu.m_file.m_first.enabled = true
	lm_menu.m_file.m_next.enabled = true
	lm_menu.m_file.m_last.enabled = true
	lm_menu.m_file.m_print.enabled = true
	lm_menu.m_file.m_previous.enabled = true
	lm_menu.m_item.m_newitem.enabled = false
	lm_menu.m_item.m_deleteitem.enabled = false
	if this.id_master.object.sold[1] = "Y" then
		lm_menu.m_file.m_save.enabled = false
		return
	end if
	lm_menu.m_file.m_save.enabled = true

// w_product_form.ue_postopen() returns 0
	string ls_describe
	setredraw(false)
	wf_connect()
	this.id_master = this.tab_retrieve.tabpage_detail.dw_detail
	this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
	this.id_footer = this.tab_retrieve.tabpage_detail.dw_footer
	this.id_list = this.tab_retrieve.tabpage_list.dw_list
	this.id_itemslist = this.tab_retrieve.tabpage_detail.dw_itemslist
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_itemslist.settransobject(this.it_transobject)
	this.id_print = this.dw_print
	this.id_dwcontrol = this.id_list
	post wf_populate_ddlb(this.id_dwcontrol)
	this.tab_retrieve.tabpage_list.dw_find.settransobject(this.it_transobject)
	this.id_master.setfocus()
	setredraw(true)
	if f_stringpreferences("aliasname") = "N" then
		this.id_itemslist.object.fullcode.visible = false
	end if
	if f_stringpreferences("localitemname") = "N" then
		ls_describe = trim(this.id_itemslist.describe("localitemname.visible"))
		if ls_describe = "1" then
			this.id_itemslist.object.localitemname.visible = false
		end if
	end if
	if f_stringpreferences("itempackingdesc") = "N" then
		this.id_itemslist.object.packingdesc.visible = false
	end if
	if f_stringpreferences("itemlocation") = "N" then
		this.id_itemslist.object.location.visible = false
	end if
	if f_stringpreferences("GenericItemName") = "N" and this.id_itemslist.describe("genericname.visible") <> "!" then
		this.id_itemslist.object.genericname.visible = false
	end if
	if this.id_itemslist.describe("c_pack_sstock.visible") <> "!" then
		if f_stringpreferences("PackStock") = "Y" and this.is_child = "w_sale" then
			this.id_itemslist.object.c_pack_sstock.visible = true
			this.id_itemslist.object.t_c_pack_sstock.visible = true
		else
			this.id_itemslist.object.c_pack_sstock.visible = false
			this.id_itemslist.object.t_c_pack_sstock.visible = false
		end if
	end if
	this.ids_itemrecyclebin = create datastore
	this.ids_itemrecyclebin.tag = this.id_detail.dataobject
	this.ids_itemrecyclebin.settransobject(this.it_transobject)

// w_product_form.open() returns long
	m_productmenu lm_menu
	long ll_width
	long ll_height
	environment env
	postevent("ue_postopen")
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	lm_menu.dynamic mf_initsecurityapp(lm_menu)
	if getenvironment(env) <> 1 then
		return ::message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.tab_retrieve.width = ll_width * 0.99
	this.tab_retrieve.height = ll_height * 0.83
	this.tab_retrieve.tabpage_detail.dw_detail.width = ll_width * 0.98
	this.tab_retrieve.tabpage_detail.dw_detail.height = ll_height * 0.90
	this.tab_retrieve.tabpage_detail.dw_itemsdetail.width = ll_width * 0.98
	this.tab_retrieve.tabpage_detail.dw_footer.y = this.tab_retrieve.height * 0.90 - this.tab_retrieve.tabpage_detail.dw_footer.height
	this.tab_retrieve.tabpage_detail.dw_detail.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width
	this.tab_retrieve.tabpage_detail.dw_footer.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width
	this.tab_retrieve.tabpage_list.gb_fliter.width = ll_width * 0.97 - this.tab_retrieve.tabpage_list.gb_sort.width
	this.tab_retrieve.tabpage_list.r_1.width = ll_width * 0.99
	this.tab_retrieve.tabpage_list.r_1.height = ll_height * 0.765 - this.tab_retrieve.tabpage_list.gb_sort.height
	this.tab_retrieve.tabpage_list.dw_list.width = ll_width * 0.98
	this.tab_retrieve.tabpage_list.dw_list.height = ll_height * 0.75 - this.tab_retrieve.tabpage_list.dw_list.y
	if int(this.tab_retrieve.tabpage_list.ddlb_data.width / this.tab_retrieve.tabpage_list.width) < 26 then
		this.tab_retrieve.tabpage_list.ddlb_data.width = int(this.tab_retrieve.tabpage_list.width * 0.26)
	end if
	this.tab_retrieve.tabpage_detail.dw_itemslist.height = ll_height * 0.6
	this.tab_retrieve.tabpage_detail.dw_itemslist.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width * 0.67
	this.tab_retrieve.tabpage_detail.dw_itemslist.x = 1150
	setredraw(true)
	return ::message.returnvalue

// w_product_form.ue_print() returns 0
	long ll_custcode
	long ll_row
	long ll_invcode
	string ls_custname
	integer li_option
	integer li_printretcode
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
		if li_option = 1 then
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	this.id_print.dataobject = "d_forlandmotors_productprint"
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(ll_invcode)
	if this.id_print.rowcount() <= 0 then
		messagebox("Printing", "no rows retrieve")
		return
	end if
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		lstr.d_value = ll_invcode
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.id_print.rowcount() > 0 then
		li_printretcode = this.id_print.print()
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
	end if

// w_product_form.ue_list() returns 0
	m_productmenu lm_menu
	long ll_rtcode
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	if this.id_list.rowcount() <= 0 then
		ll_rtcode = wf_retrievelist()
		if ll_rtcode <= 0 then
			ll_rtcode = wf_retrievelistall()
		end if
	end if
	if ll_rtcode > 0 then
		lm_menu.m_file.m_new.enabled = true
		lm_menu.m_file.m_save.enabled = false
		lm_menu.m_file.m_delete.enabled = false
		lm_menu.m_item.m_newitem.enabled = false
		lm_menu.m_item.m_deleteitem.enabled = false
		lm_menu.m_item.m_insertnewitem.enabled = false
		lm_menu.m_item.m_deletecurrentitem.enabled = false
		lm_menu.m_file.m_first.enabled = true
		lm_menu.m_file.m_next.enabled = true
		lm_menu.m_file.m_last.enabled = true
		lm_menu.m_file.m_print.visible = true
		lm_menu.m_file.m_print.enabled = true
		lm_menu.m_file.m_previous.enabled = true
		lm_menu.m_file.m_retrieve.text = "De&tail"
		this.i_retrievemode = 2
		this.i_editmode = 2
		if this.il_selectedrow = 0 then
			wf_first()
			wf_selectunselectrow(1)
		else
			this.il_selectedrow = 1
		end if
		this.tab_retrieve.tabpage_list.dw_find.setfocus()
		return
	end if
	messagebox("Result", "No rows or retrieved possible empty table~r~nInsert some rows first")
	postevent("ue_new")
