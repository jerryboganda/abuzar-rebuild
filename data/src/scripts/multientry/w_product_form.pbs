// w_product_form.wf_duplicatechasisno(string as_chasisno) returns boolean
	long ll_count
	long ll_code
	boolean b_flag
	as_chasisno = trim(as_chasisno)
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	if isnull(ll_code) then
		SQL SELECT count ( *) INTO :ll_count FROM Product WHERE Chasisno =:as_chasisno USING this.it_transobject;
	else
		SQL SELECT count ( *) INTO :ll_count FROM Product WHERE Chasisno =:as_chasisno USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		if ll_count > 0 then
			b_flag = true
		else
			b_flag = false
		end if
	else
		b_flag = false
	end if
	return b_flag

// w_product_form.wf_duplicateengineno(string as_engineno) returns boolean
	long ll_count
	long ll_code
	boolean b_flag
	as_engineno = trim(as_engineno)
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	if isnull(ll_code) then
		SQL SELECT count ( *) INTO :ll_count FROM Product WHERE engineno =:as_engineno USING this.it_transobject;
	else
		SQL SELECT count ( *) INTO :ll_count FROM Product WHERE engineno =:as_engineno USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		if ll_count > 0 then
			b_flag = true
		else
			b_flag = false
		end if
	else
		b_flag = false
	end if
	return b_flag

// w_product_form.wf_print_deliveryletter(long al_invcode) returns long
	long ll_retcode
	string ls_report
	datastore lds_print
	s_datastore lstr
	lds_print = create datastore
	ls_report = "d_forlandmotors_dc"
	lds_print.dataobject = ls_report
	lds_print.settransobject(this.it_transobject)
	ll_retcode = lds_print.retrieve(al_invcode)
	lstr.ds = lds_print
	lstr.s_name1 = lds_print.dataobject
	lstr.d_value = al_invcode
	openwithparm(w_preview_invoices2, lstr)
	lstr = message.powerobjectparm
	if lstr.i_closemode = -1 then
		return 0
	end if
	return 0

