// menu m_productmenu (multientry)  ancestor: m_multi_entry

// m_productmenu.create() returns 0 [event]
	m_productmenu = this
	call super::create

// m_productmenu.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_printgatepass = create m_printgatepass
	this.m_printdeliveryletter = create m_printdeliveryletter
	this.m_printpassagecertificate = create m_printpassagecertificate
	this.item[upperbound(this.item) + 1] = this.m_printgatepass
	this.item[upperbound(this.item) + 1] = this.m_printdeliveryletter
	this.item[upperbound(this.item) + 1] = this.m_printpassagecertificate

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_printgatepass
	destroy this.m_printdeliveryletter
	destroy this.m_printpassagecertificate

// m_printgatepass.clicked() returns 0 [event]
	this.parentwindow.triggerevent("ue_print_gatepass")

// m_printgatepass.create() returns 0 [event]
	call super::create
	this.text = "Print Gate Pass~tCtrl+G"
	this.shortcut = 327
	this.menutextcolor = 134217735
	this.menubackcolor = 134217732
	this.menuhighlightcolor = 134217741
	this.textsize = 8
	this.weight = 400
	this.facename = "Tahoma"
	this.titlebackcolor = 134217730
	this.bitmapbackcolor = 12632256
	this.menubitmaps = true
	this.titlegradient = true
	this.toolbartextcolor = 134217746
	this.toolbarbackcolor = 67108864
	this.toolbarhighlightcolor = 134217741
	this.toolbargradient = true
	this.bitmapgradient = true

// m_printgatepass.destroy() returns 0 [event]
	call super::destroy

