// window w_currency_form (multientry)  ancestor: w_multi_entry

// w_currency_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM Currency WHERE Currency.name =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_currency_form.wf_validateitem() returns integer
	long ll_icode
	integer li_errcode
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "Denomination")
	if vf_dwdupcode1(this.id_detail, "Denomination", string(ll_icode), this.il_currrow) = true then
		messagebox("Duplication Error", "Current row is duplicate")
		li_errcode = -1
	else
		li_errcode = 0
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		this.id_detail.setcolumn("Denomination")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.denomination[this.il_currrow] = 1
	end if
	return li_errcode

// w_currency_form.wf_duplicatecode(string as_code) returns boolean
	integer li_code
	integer li_dupcode
	li_code = integer(as_code)
	SQL SELECT Currency.Currencycode INTO :li_dupcode FROM Currency WHERE Currency.Currencycode =:li_code USING sqlca;
	if li_dupcode = li_code then
		return true
	end if
	return false

// w_currency_form.wf_duplicateshortname(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM Currency WHERE Currency.shortname =:as_name USING sqlca;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_currency_form.create() returns 0 [event]
	call super::create

// w_currency_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_currency_form.ue_save() returns 0 [event]
	long ll_mastercurrrow
	long ll_invid
	long ll_detailrows
	integer li_counter
	integer ll_salesmancode
	boolean lb_commitflag
	dwitemstatus lds_rowstatus
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	setpointer(hourglass!)
	ll_mastercurrrow = this.id_master.getrow()
	ll_invid = this.id_master.object.code[ll_mastercurrrow]
	if isnull(ll_invid) then
		f_newtableid("currency", ll_invid)
		this.id_master.object.code[ll_mastercurrrow] = ll_invid
	end if
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	do while li_counter <= ll_detailrows and lb_commitflag = true
		lds_rowstatus = this.id_detail.getitemstatus(li_counter, 0, primary!)
		if lds_rowstatus = newmodified! then
			this.id_detail.setitem(li_counter, "code", ll_invid)
		end if
		li_counter = li_counter + 1
	loop
	call super::ue_save
	setpointer(arrow!)

// w_currency_form.ue_newform() returns 0 [event]
	call super::ue_newform
	this.id_master.setfocus()

// w_currency_form.ue_newitem() returns 0 [event]
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	call super::ue_newitem
	if this.id_detail.rowcount() > 1 then
		this.id_detail.object.type[this.id_detail.rowcount()] = this.id_detail.object.type[this.id_detail.rowcount() - 1]
		this.id_detail.object.name[this.id_detail.rowcount()] = this.id_detail.object.name[this.id_detail.rowcount() - 1]
	end if

// w_currency_form.ue_detail() returns 0 [event]
	call super::ue_detail
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_delete.enabled = true
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "name"
		if data = "" or isnull(data) then
			messagebox("Name Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	case "shortname"
		if data = "" or isnull(data) then
			messagebox("Short Name Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	case "conversionfactor"
		if long(data) <= 0 or isnull(data) then
			messagebox("Conversion Factor/Rate Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	end choose
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	integer li_currencycode
	integer li_dupcurrcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "code"
		li_currencycode = integer(data)
		SQL SELECT Currency.CurrencyCode INTO :li_dupcurrcode FROM Currency WHERE Currency.currencycode =:li_currencycode USING sqlca;
		if sqlca.sqlcode = 0 and li_dupcurrcode = li_currencycode then
			rt_code = 1
			messagebox("Currency Code Validation", "Duplicate Currency Code, Enter some other Currency code")
		end if
	case "shortname"
		if parent.parent.parent.wf_duplicateshortname(data) then
			messagebox("Short Name Validation", "Duplicate Short Name Error~n~rPlease Choose Some Other Short Name")
			return 1
		end if
	case "name"
		if parent.parent.parent.wf_duplicatename(data) then
			messagebox("Name Validation", "Duplicate Name Error~n~rPlease Choose Some Other Name")
			return 1
		end if
	end choose
	return rt_code

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	string ls_managername
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "denomination"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_itemvalidated = false
		li_errcode = 0
	case else
		parent.parent.parent.ib_itemvalidated = true
	end choose
	return li_errcode

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "denomination"
		if data = "" or isnull(data) then
			messagebox("Currency Denominations Validation", "Value required for Currency Denominations in current row")
		end if
	end choose
	return 1

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	return ::message.returnvalue
