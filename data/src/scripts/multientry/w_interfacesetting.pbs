// w_interfacesetting.systemkey(keycode key, unsignedlong keyflags) returns long [event]
	if keyflags = 1 and key = keyk! and this.tab_interfacesetting.selectedtab = 8 then
		f_rightsmodification()
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.postevent("ue_close")
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	if parent.id_itemsetting.accepttext() = 1 then
		if parent.id_saleorderpopup.accepttext() = 1 then
			if parent.id_cashsalepopup.accepttext() = 1 then
				if parent.id_creditsalepopup.accepttext() = 1 then
					if parent.id_itemsetting.update() = 1 then
						if parent.id_cashsalepopup.update() = 1 then
							if parent.id_creditsalepopup.update() = 1 then
								if parent.id_cashsalelist.update() = 1 then
									if parent.id_creditsalelist.update() = 1 then
										if parent.id_itemlistsetting.update() = 1 then
											if parent.id_popup_itemsearchlist.update() = 1 then
												if parent.id_saleorderpopup.update() = 1 then
													if parent.id_patientregistration.update() = 1 then
														if parent.id_purorder.update() = 1 then
															if parent.id_advancedsale.update() = 1 then
																if parent.id_customer.update() = 1 then
																	if parent.id_polist.update() = 1 then
																		if parent.id_servicebasicdata.update() = 1 then
																			if parent.id_custsite.update() = 1 then
																				if parent.id_issue_popup.update() = 1 then
																					if parent.id_itemreg.update() = 1 then
																						if parent.id_gbdw.update() = 1 then
																							if parent.id_changeitemprice.update() = 1 then
																								SQL commit USING sqlca;
																								messagebox("Confirm Changes", "Changes take effect in the database.")
																								parent.postevent("ue_close")
																							else
																								SQL rollback USING sqlca;
																								messagebox("Updation Error", "Unable to update Change Item Price Interface settings.")
																								parent.id_changeitemprice.setfocus()
																								return ::message.returnvalue
																							end if
																						else
																							SQL rollback USING sqlca;
																							messagebox("Updation Error", "Unable to update Garments Basic Data Wizard interface settings.")
																							parent.id_gbdw.setfocus()
																							return ::message.returnvalue
																						end if
																					else
																						SQL rollback USING sqlca;
																						messagebox("Updation Error", "Unable to update Item Reqistration Request interface settings.")
																						parent.id_itemreg.setfocus()
																						return ::message.returnvalue
																					end if
																				else
																					SQL rollback USING sqlca;
																					messagebox("Updation Error", "Unable to update Issue Popup interface settings.")
																					parent.id_issue_popup.setfocus()
																					return ::message.returnvalue
																				end if
																			else
																				SQL rollback USING sqlca;
																				messagebox("Updation Error", "Unable to update Customer Site interface settings.")
																				parent.id_custsite.setfocus()
																				return ::message.returnvalue
																			end if
																		else
																			SQL rollback USING sqlca;
																			messagebox("Updation Error", "Unable to update Service Basic Data interface settings.")
																			parent.id_servicebasicdata.setfocus()
																			return ::message.returnvalue
																		end if
																	else
																		SQL rollback USING sqlca;
																		messagebox("Updation Error", "Unable to update P/O List interface settings.")
																		parent.id_polist.setfocus()
																		return ::message.returnvalue
																	end if
																else
																	SQL rollback USING sqlca;
																	messagebox("Updation Error", "Unable to update Customer interface settings.")
																	parent.id_customer.setfocus()
																	return ::message.returnvalue
																end if
															else
																SQL rollback USING sqlca;
																messagebox("Updation Error", "Unable to update Advanced Sales interface settings.")
																parent.id_advancedsale.setfocus()
																return ::message.returnvalue
															end if
														else
															SQL rollback USING sqlca;
															messagebox("Updation Error", "Unable to update Purchase Order interface settings.")
															parent.id_purorder.setfocus()
															return ::message.returnvalue
														end if
													else
														SQL rollback USING sqlca;
														messagebox("Updation Error", "Unable to update Patient Registration interface settings.")
														parent.id_patientregistration.setfocus()
														return ::message.returnvalue
													end if
												else
													SQL rollback USING sqlca;
													messagebox("Updation Error", "Unable to update Sale Order interface settings.")
													parent.id_saleorderpopup.setfocus()
													return ::message.returnvalue
												end if
											else
												SQL rollback USING sqlca;
												messagebox("Updation Error", "Unable to update Item Search list interface settings.")
												return ::message.returnvalue
											end if
										else
											SQL rollback USING sqlca;
											messagebox("Updation Error", "Unable to update Item list interface settings.")
											return ::message.returnvalue
										end if
									else
										SQL rollback USING sqlca;
										messagebox("Updation Error", "Unable to update credit sale list interface settings.")
										return ::message.returnvalue
									end if
								else
									SQL rollback USING sqlca;
									messagebox("Updation Error", "Unable to update cash sale list interface settings.")
									return ::message.returnvalue
								end if
							else
								SQL rollback USING sqlca;
								messagebox("Updation Error", "Unable to update credit sale popup interface settings.")
								return ::message.returnvalue
							end if
						else
							SQL rollback USING sqlca;
							messagebox("Updation Error", "Unable to update credit sale popup interface settings.")
							return ::message.returnvalue
						end if
					else
						SQL rollback USING sqlca;
						messagebox("Updation Error", "Unable to update credit sale popup interface settings.")
						return ::message.returnvalue
					end if
				else
					parent.id_creditsalepopup.setfocus()
					return ::message.returnvalue
				end if
			else
				parent.id_cashsalepopup.setfocus()
				return ::message.returnvalue
			end if
		else
			parent.id_saleorderpopup.setfocus()
			return ::message.returnvalue
		end if
	else
		parent.id_itemsetting.setfocus()
		return ::message.returnvalue
