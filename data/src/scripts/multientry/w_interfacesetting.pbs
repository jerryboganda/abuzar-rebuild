// w_interfacesetting.wf_set_firsttab() returns long
	long ll_counter
	long ll_tottabs
	string ls_first_tab
	userobject[] l_any_arr
	userobject l_any_this
	l_any_arr = this.tab_interfacesetting.control
	ll_tottabs = upperbound(l_any_arr)
	for ll_counter = 1 to ll_tottabs
		l_any_this = this.tab_interfacesetting.control[ll_counter]
		if l_any_this.visible = true then
			ls_first_tab = string(l_any_this.classname())
			this.tab_interfacesetting.setfocus()
			this.tab_interfacesetting.selecttab(ll_counter)
			this.tab_interfacesetting.selecttab(ls_first_tab)
			return 0
		end if
	next
	return 0

// w_interfacesetting.create() returns 0 [event]
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.tab_interfacesetting = create tab_interfacesetting
	this.control = {this.cb_cancel, this.cb_ok, this.tab_interfacesetting}

// w_interfacesetting.destroy() returns 0 [event]
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.tab_interfacesetting

// w_interfacesetting.open() returns long [event]
	wf_set_interface_adjustments()
	this.id_itemsetting = this.tab_interfacesetting.tabpage_item.dw_itemsetting
	this.id_itemsetting.settransobject(sqlca)
	this.id_itemsetting.retrieve(9, 3)
	this.id_cashsalepopup = this.tab_interfacesetting.tabpage_cashsalepopup.dw_cashsalepopup
