// window w_survey_form (multientry)  ancestor: w_multi_entry

// w_survey_form.ue_printdo() returns 0 [event]
	long ll_custcode
	long ll_row
	string ls_custname
	if this.im_menu.m_file.m_save.enabled = true then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	this.id_print.dataobject = "d_deliveryorder_half"
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(this.id_master.getitemnumber(1, "code"))
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_survey_form.wf_customerinfo(long al_custcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	double ld_currbalance
	SQL SELECT customer.address1 , customer.city , customer.phone INTO :ls_address, :ls_city, :ls_phone FROM customer WHERE customer.custcode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
		this.id_master.object.address[ll_currow] = ls_address
		this.id_master.object.city[ll_currow] = ls_city
		this.id_master.object.phone[ll_currow] = ls_phone
	end if
	return this.it_transobject.sqlcode

// w_survey_form.wf_visible(boolean ab_flag) returns 0
	this.id_footer.object.stock.visible = ab_flag
	this.id_footer.object.t_stock.visible = ab_flag

// w_survey_form.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	long iccode
	long icatcode
	long packcode
	long manfcode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_survey_form.wf_getmaxdate(datetime ad_date) returns integer
	SQL Select Max ( Date ) INTO :ad_date From saleledger USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_survey_form.wf_savastemplate() returns integer
	s_saletemplateheader lstr_templateheader
	long ll_invid
	integer li_retcode
	long ll_code
	long ll_qty
	long ll_icode
	long ll_totalrows
	long ll_rowcount
	open(w_savesaleastemplate)
	lstr_templateheader = message.powerobjectparm
	f_newtableid("SaleTemplateHeader", ll_invid)
	SQL INSERT INTO SaleTemplateHeader ( saletemplatecode , date , modified , name ) values ( :ll_invid , :lstr_templateheader.dt_templatedate , :lstr_templateheader.dt_templatedate , :lstr_templateheader.s_template ) USING this.it_transobject;
	ll_totalrows = this.id_detail.rowcount()
	for ll_rowcount = 1 to ll_totalrows
		ll_code = ll_invid
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ll_qty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		SQL insert into saletemplatedetail ( saletemplatecode , icode , looseqty ) values ( :ll_code , :ll_icode , :ll_qty ) USING this.it_transobject;
	next
	setpointer(hourglass!)
	if this.it_transobject.sqlcode < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return li_retcode
	else
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Template saved", exclamation!, ok!, 1)
	end if
	return li_retcode

// w_survey_form.wf_validateitemnew() returns integer
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
		messagebox(ls_titleerrtext, ls_errtext)
	elseif not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		ls_titleerrtext = "Item Validation"
		li_errcode = -2
	end if
	this.ib_itemvalidated = true
	return li_errcode

// w_survey_form.wf_editquotation() returns integer
	datastore lds_quotationdetail
	datastore lds_quotationheader
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	integer li_retcode
	integer li_errcode
	string ls_errortext
	lds_quotationdetail = create datastore
	lds_quotationheader = create datastore
	open(w_editquotationform)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_quotationdetail.dataobject = "d_quotationdetail"
		lds_quotationdetail.settransobject(this.it_transobject)
		lds_quotationheader.dataobject = "d_quotationheader"
		lds_quotationheader.settransobject(this.it_transobject)
		ll_row = lds_quotationheader.retrieve(lstr_template.l_invtemplate)
		lds_quotationdetail.retrieve(lstr_template.l_invtemplate)
		ll_totalrows = lds_quotationheader.retrieve(lstr_template.l_invtemplate)
		if ll_row < 0 then
			li_retcode = -1
		end if
		ll_mrow = this.id_master.getrow()
		this.id_master.setitem(ll_mrow, "quotationno", lstr_template.l_invtemplate)
		this.id_master.setitem(ll_mrow, "custcode", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "custcode"))
		this.id_master.setitem(ll_mrow, "sprice", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "sprice"))
		this.id_master.setitem(ll_mrow, "remarks", lds_quotationheader.getitemstring(lds_quotationheader.getrow(), "remarks"))
		this.id_master.setitem(ll_mrow, "headerno", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "headerno"))
		this.id_footer.setitem(ll_mrow, "misccharges", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "misccharges"))
		this.id_footer.setitem(ll_mrow, "invdiscperc", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "discperc"))
		this.id_footer.setitem(ll_mrow, "flatdisc", lds_quotationheader.getitemnumber(lds_quotationheader.getrow(), "flatdisc"))
		ll_totalrows = lds_quotationdetail.rowcount()
		this.id_detail.reset()
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_quotationdetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "packunits", lds_quotationdetail.getitemnumber(ll_rowcount, "packunits"))
			this.id_detail.setitem(ll_rowcount, "discperc", lds_quotationdetail.getitemnumber(ll_rowcount, "discperc"))
			this.id_detail.setitem(ll_rowcount, "saleprice", lds_quotationdetail.getitemnumber(ll_rowcount, "saleprice"))
			this.id_detail.setitem(ll_rowcount, "looseqty", lds_quotationdetail.getitemnumber(ll_rowcount, "looseqty"))
		next
	end if
	return li_retcode

// w_survey_form.wf_dueitem() returns 0

// w_survey_form.wf_deletesaleinvoice(long al_saleinvcode) returns integer
	SQL Delete IssueDetail Where IssueDetail.IssueInvCode =:al_saleinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_survey_form.wf_selectprintreport() returns string
	string ls_pagesize
	string ls_report
	ls_pagesize = f_stringpreferences("pagesize")
	if ls_pagesize = "Q" and this.ii_saletype = 3 then
		if gs_company = "ZA" or gs_company = "CLINIX" then
			ls_report = "d_retailsaleinvreportwh"
		else
			ls_report = "d_retailsaleinvreport"
		end if
	elseif ls_pagesize = "Q" and this.ii_saletype = 2 then
		if gs_company = "ZA" or gs_company = "CLINIX" then
			ls_report = "d_wholesaleinvreportwh"
		else
			ls_report = "d_wholesaleinvreport"
		end if
	elseif ls_pagesize = "F" and this.ii_saletype = 3 then
		if gs_company = "SA" then
			ls_report = "d_sa_retailsaleinvreport_full"
		else
			ls_report = "d_retailsaleinvreport_full"
		end if
	elseif ls_pagesize = "F" and this.ii_saletype = 2 then
		if gs_company = "SA" then
			ls_report = "d_sa_wholesaleinvreport_full"
		else
			ls_report = "d_wholesaleinvreport_full"
		end if
	else
		ls_report = "d_retailsaleinvreport_full"
	end if
	this.id_print.dataobject = ls_report
	this.id_print.settransobject(this.it_transobject)
	return ls_report

// w_survey_form.wf_returnsaleinvoice(long al_invid, string as_errtext) returns boolean
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_counter
	long ll_detailrows
	double ld_looseqty
	double ld_stock
	double ld_newstock
	string ls_batch
	string ls_due
	datetime ld_expiry
	boolean lb_commitflag
	double ld_avgprice
	this.id_saleinvdetail.retrieve(al_invid)
	ll_detailrows = this.id_saleinvdetail.rowcount()
	ll_counter = 1
	do while ll_counter <= ll_detailrows and lb_commitflag
		ll_gcode = this.id_saleinvdetail.getitemnumber(ll_counter, "gcode")
		ll_icode = this.id_saleinvdetail.getitemnumber(ll_counter, "icode")
		ls_batch = this.id_saleinvdetail.getitemstring(ll_counter, "batch")
		ld_expiry = this.id_saleinvdetail.getitemdatetime(ll_counter, "expiry")
		ld_looseqty = this.id_saleinvdetail.getitemnumber(ll_counter, "qty")
		this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
			if this.it_transobject.sqlcode = 0 then
				ld_newstock = ld_stock + ld_looseqty
				this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
				if this.it_transobject.sqlcode <> 0 then
					lb_commitflag = false
				end if
				if ld_stock = 0.0 then
					SQL update GodownDetail Set Priority =1 Where GodownDetail.GCode =:ll_gcode and GodownDetail.ICode =:ll_icode and GodownDetail.Batch =:ls_batch and GodownDetail.Expiry =:ld_expiry USING this.it_transobject;
				end if
			else
				lb_commitflag = false
			end if
		else
			lb_commitflag = false
		end if
		ll_counter = ll_counter + 1
	loop
	if lb_commitflag then
		if wf_deletesaleinvoice(al_invid) <> 0 then
			lb_commitflag = false
			as_errtext = "    Some database problem occur"
		end if
	else
		as_errtext = "    Some database problem occur"
	end if
	return lb_commitflag

// w_survey_form.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
