// window w_disclaimerwindow (abuzarapp)  ancestor: window

// w_disclaimerwindow.ue_close(integer ai_value) returns 0
	closewithreturn(this, ai_value)

// w_disclaimerwindow.create() returns 0
	this.st_4 = create st_4
	this.st_3 = create st_3
	this.st_2 = create st_2
	this.st_1 = create st_1
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.gb_1 = create gb_1
	this.control = {this.st_4, this.st_3, this.st_2, this.st_1, this.cb_cancel, this.cb_ok, this.gb_1}

// w_disclaimerwindow.destroy() returns 0
	destroy this.st_4
	destroy this.st_3
	destroy this.st_2
	destroy this.st_1
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.gb_1

// w_disclaimerwindow.open() returns long
	environment le_env
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_width = pixelstounits(le_env.screenwidth, xpixelstounits!) - this.width
		ll_height = pixelstounits(le_env.screenheight, ypixelstounits!) - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width * 0.5
			ll_height = ll_height * 0.5
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	post event ue_postopen()
	return ::message.returnvalue

// w_disclaimerwindow.key(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		post event ue_close(-1)
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		post event clicked()
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	parent.post event ue_close(1)
	return ::message.returnvalue
