// window w_bkg (abuzarapp)  ancestor: window

// w_bkg.create() returns 0
	this.p_1 = create p_1
	this.control = {this.p_1}

// w_bkg.destroy() returns 0
	destroy this.p_1

// w_bkg.open() returns long
	environment env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	this.p_1.width = this.width
	this.p_1.height = this.height
	setredraw(false)
	setredraw(true)
	return ::message.returnvalue

// w_bkg.activate() returns long
	this.p_1.width = this.width
	this.p_1.height = this.height
	return ::message.returnvalue
