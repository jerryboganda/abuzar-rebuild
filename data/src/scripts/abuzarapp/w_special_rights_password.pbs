// window w_special_rights_password (abuzarapp)  ancestor: window

// w_special_rights_password.ue_close(integer ai_value) returns 0 [event]
	closewithreturn(this, ai_value)

// w_special_rights_password.create() returns 0 [event]
	this.sle_key = create sle_key
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.st_2 = create st_2
	this.control = {this.sle_key, this.cb_cancel, this.cb_ok, this.st_2}

// w_special_rights_password.destroy() returns 0 [event]
	destroy this.sle_key
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.st_2

// w_special_rights_password.open() returns long [event]
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	this.is_rightid = message.stringparm
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	if f_is_specialright_enabled(this.is_rightid) = false then
		closewithreturn(this, -1)
	end if
	post event ue_postopen()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_special_rights_password.key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		post event ue_close(-1)
	end if
	return ::message.returnvalue

// sle_key.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		post event clicked()
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	string ls_pwd
	string ls_key
	ls_key = parent.sle_key.text
	ls_pwd = f_get_specialright_password(parent.is_rightid)
	parent.il_attempts = parent.il_attempts + 1
	if ls_key = ls_pwd then
		parent.post event ue_close(1)
		return ::message.returnvalue
	else
		messagebox("Password Validation!", "Wrong Password.~r~nPlease enter correct password.")
		parent.sle_key.text = ""
		parent.sle_key.setfocus()
		if parent.il_attempts > 2 then
			parent.post event ue_close(-1)
		end if
		return ::message.returnvalue
	end if
	return ::message.returnvalue
