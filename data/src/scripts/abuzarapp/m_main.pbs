// menu m_main (abuzarapp)  ancestor: menu

// m_main.create() returns 0
	m_main = this
	call super::create
	this.m_file = create m_file
	this.m_purchase = create m_purchase
	this.m_sales = create m_sales
	this.m_transactions = create m_transactions
	this.m_reports = create m_reports
	this.m_basicdata = create m_basicdata
	this.m_window = create m_window
	this.m_help = create m_help
	this.item[upperbound(this.item) + 1] = this.m_file
	this.item[upperbound(this.item) + 1] = this.m_purchase
	this.item[upperbound(this.item) + 1] = this.m_sales
	this.item[upperbound(this.item) + 1] = this.m_transactions
	this.item[upperbound(this.item) + 1] = this.m_reports
	this.item[upperbound(this.item) + 1] = this.m_basicdata
	this.item[upperbound(this.item) + 1] = this.m_window
	this.item[upperbound(this.item) + 1] = this.m_help

// m_main.destroy() returns 0
	call super::destroy
	destroy this.m_file
	destroy this.m_purchase
	destroy this.m_sales
	destroy this.m_transactions
	destroy this.m_reports
	destroy this.m_basicdata
	destroy this.m_window
	destroy this.m_help

// m_file.create() returns 0
	call super::create
	this.text = "&File"
	this.m_exit = create m_exit
	this.item[upperbound(this.item) + 1] = this.m_exit

// m_file.destroy() returns 0
	call super::destroy
	destroy this.m_exit

// m_exit.create() returns 0
	call super::create
	this.text = "Exit"

// m_exit.clicked() returns 0
	halt close

// m_exit.destroy() returns 0
	call super::destroy

