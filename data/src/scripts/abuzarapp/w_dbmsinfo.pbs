// window w_dbmsinfo (abuzarapp)  ancestor: window

// w_dbmsinfo.ue_postopen() returns 0 [event]
	string ls_info
	ls_info = message.stringparm
	this.st_info.text = ls_info
	this.st_server.text = gs_servername
	this.st_db.text = gs_dbname

// w_dbmsinfo.ue_close(integer ai_value) returns 0 [event]
	closewithreturn(this, ai_value)

// w_dbmsinfo.create() returns 0 [event]
	this.st_db = create st_db
	this.st_server = create st_server
	this.st_3 = create st_3
	this.st_2 = create st_2
	this.st_info = create st_info
	this.cb_ok = create cb_ok
	this.gb_details = create gb_details
	this.control = {this.st_db, this.st_server, this.st_3, this.st_2, this.st_info, this.cb_ok, this.gb_details}

// w_dbmsinfo.destroy() returns 0 [event]
	destroy this.st_db
	destroy this.st_server
	destroy this.st_3
	destroy this.st_2
	destroy this.st_info
	destroy this.cb_ok
	destroy this.gb_details

// w_dbmsinfo.open() returns long [event]
	environment le_env
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_width = pixelstounits(le_env.screenwidth, xpixelstounits!) - this.width
		ll_height = pixelstounits(le_env.screenheight, ypixelstounits!) - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width * 0.5
			ll_height = ll_height * 0.5
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	post event ue_postopen()
	return ::message.returnvalue

// w_dbmsinfo.key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		post event ue_close(-1)
	end if
	return ::message.returnvalue

// cb_ok.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		post event clicked()
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	parent.post event ue_close(1)
	return ::message.returnvalue
