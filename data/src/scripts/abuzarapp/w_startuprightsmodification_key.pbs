// window w_startuprightsmodification_key (abuzarapp)  ancestor: window

// w_startuprightsmodification_key.ue_postopen() returns 0
	long ll_date
	long ll_randno
	ll_randno = rand(32767)
	SQL Select Convert ( int , Convert ( DateTime , GetDate ( ) ) ) INTO :ll_date From Sequence USING sqlca;
	this.em_statuscode.text = string(ll_date + ll_randno)

// w_startuprightsmodification_key.ue_close(integer ai_value) returns 0
	closewithreturn(this, ai_value)

// w_startuprightsmodification_key.create() returns 0
	this.sle_key = create sle_key
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.em_statuscode = create em_statuscode
	this.st_2 = create st_2
	this.st_1 = create st_1
	this.control = {this.sle_key, this.cb_cancel, this.cb_ok, this.em_statuscode, this.st_2, this.st_1}

// w_startuprightsmodification_key.destroy() returns 0
	destroy this.sle_key
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.em_statuscode
	destroy this.st_2
	destroy this.st_1

// w_startuprightsmodification_key.open() returns long
	environment le_env
	long ll_width
	long ll_height
	randomize(0)
	if getenvironment(le_env) = 1 then
		ll_width = pixelstounits(le_env.screenwidth, xpixelstounits!) - this.width
		ll_height = pixelstounits(le_env.screenheight, ypixelstounits!) - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width * 0.5
			ll_height = ll_height * 0.5
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	post event ue_postopen()
	return ::message.returnvalue

// w_startuprightsmodification_key.key(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		post event ue_close(-1)
	end if
	return ::message.returnvalue

// sle_key.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.post event ue_close(-1)
	return ::message.returnvalue

// cb_ok.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		post event clicked()
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	long ll_key
	long ll_statuscode
	ll_statuscode = long(parent.em_statuscode.text)
	ll_key = long(parent.sle_key.text)
	parent.il_attempts = parent.il_attempts + 1
	if ll_key - ll_statuscode > 20 and ll_key - ll_statuscode < 40 and ll_key mod 10 = 0 then
		parent.post event ue_close(1)
		return ::message.returnvalue
	end if
	messagebox("Key Validation", "Kindly enter valid key.")
	parent.sle_key.setfocus()
	if parent.il_attempts > 2 then
		parent.post event ue_close(-1)
	end if
	return ::message.returnvalue
