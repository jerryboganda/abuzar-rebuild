// w_pointofsalepreferences.open() returns long [event]
	string ls_defaultcomport
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	this.id_preferences = this.dw_preferences
	this.id_preferences.settransobject(sqlca)
	this.id_preferences.retrieve()
	if f_stringpreferences("POS_ItemFlatDisc") = "Y" then
		this.cbx_itemflatdisc.checked = true
	end if
	if f_stringpreferences("POS_ItemGstPerc") = "Y" then
		this.cbx_itemgstperc.checked = true
	end if
	if f_stringpreferences("POS_ItemUnitTax") = "Y" then
		this.cbx_itemunittax.checked = true
	end if
	if f_stringpreferences("POS_ItemDiscPerc") = "Y" then
		this.cbx_itemdiscperc.checked = true
	end if
	if f_stringpreferences("POS_InvGstPerc") = "Y" then
		this.cbx_invgstperc.checked = true
	end if
	if f_stringpreferences("POS_SalesMan") = "Y" then
		this.cbx_salesman.checked = true
	end if
	if f_stringpreferences("POS_InvSize") = "Y" then
		this.cbx_invsize.checked = true
	end if
	if f_stringpreferences("POS_MiscCharges") = "Y" then
		this.cbx_misccharges.checked = true
	end if
	if f_stringpreferences("POS_InvDiscPerc") = "Y" then
		this.cbx_invdiscperc.checked = true
	end if
	if f_stringpreferences("POS_InvFlatDisc") = "Y" then
		this.cbx_invflatdisc.checked = true
	end if
	if f_stringpreferences("PromptStockInPos") = "Y" then
		this.cbx_promptzerostock.checked = true
	end if
	if f_stringpreferences("SaleSets") = "Y" then
		this.cbx_salesets.checked = true
	end if
	if f_stringpreferences("AutoProductionInPOS") = "Y" then
		this.cbx_autoproduction.checked = true
	end if
	if f_stringpreferences("AssocSaleInvListInPOS") = "Y" then
		this.cbx_assocsaleinvlist.checked = true
	end if
	if f_stringpreferences("checkduerightonpos_save") = "Y" then
		this.cbx_checkduerightonpos_save.checked = true
	end if
	if f_stringpreferences("CashierWindowOnPOS") = "Y" then
		this.cbx_showcashierwindow.checked = true
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	close(parent)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	string ls_temp
	w_pointofsalepreferences w_parent
	if parent.cbx_itemflatdisc.checked = true then
		ls_temp = "Y"
	else
		ls_temp = "N"
	end if
