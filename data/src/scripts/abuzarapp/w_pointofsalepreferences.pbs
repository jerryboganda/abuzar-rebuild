		ls_temp = "Y"
	else
		ls_temp = "N"
	end if
	f_set_preference_local(parent.id_preferences, "CashierWindowOnPOS", ls_temp)
	if f_validatedw(parent.id_preferences) < 0 then
		return ::message.returnvalue
	end if
	w_parent = getparent()
	if parent.id_preferences.update() > 0 then
		SQL commit USING sqlca;
		gds_preferences.retrieve()
	else
		messagebox("Datasase Error", "Some Database problem occur during saving")
		SQL rollback USING sqlca;
		setpointer(arrow!)
	end if
	w_parent.setfocus()
	close(w_pointofsalepreferences)
	return ::message.returnvalue
