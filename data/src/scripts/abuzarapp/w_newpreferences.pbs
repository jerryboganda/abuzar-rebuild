					li_unitvalue = parent.tab_preferences.tabpage_schedule.dw_backupschedule.getitemnumber(1, "unitvalue")
					li_unit = parent.tab_preferences.tabpage_schedule.dw_backupschedule.getitemnumber(1, "unit")
					if li_unit = 4 then
						if not (li_unitvalue >= 1 and li_unitvalue <= 1440) then
							messagebox("BackUp Time Validation", "Please enter valid value for minutes between 1 and 1440.")
							parent.tab_preferences.tabpage_schedule.dw_backupschedule.setcolumn(1)
							parent.tab_preferences.tabpage_schedule.dw_backupschedule.setfocus()
							return ::message.returnvalue
						end if
					elseif li_unit = 8 then
						if not (li_unitvalue >= 1 and li_unitvalue <= 24) then
							messagebox("BackUp Time Validation", "Please enter valid value for hours between 1 and 24.")
							parent.tab_preferences.tabpage_schedule.dw_backupschedule.setcolumn(2)
							parent.tab_preferences.tabpage_schedule.dw_backupschedule.setfocus()
							return ::message.returnvalue
						end if
					else
						messagebox("BackUp Time Validation", "Please select minutes/hours from dropdown list box")
						parent.tab_preferences.tabpage_schedule.dw_backupschedule.setcolumn(2)
						parent.tab_preferences.tabpage_schedule.dw_backupschedule.setfocus()
						return ::message.returnvalue
					end if
				else
					messagebox("BackUp Time Validation", "Please enter valid value for a unit.")
					parent.tab_preferences.tabpage_schedule.dw_backupschedule.setcolumn(1)
					parent.tab_preferences.tabpage_schedule.dw_backupschedule.setfocus()
					return ::message.returnvalue
				end if
				ll_activetime = 0
			end if
			sqlca.adjustjobschedule(ls_jobname, ls_schedulename, ll_activetime, li_unit, li_unitvalue)
			sqlca.activatejob(ls_jobname, 1)
		else
			sqlca.activatejob(ls_jobname, 0)
		end if
		ls_jobname = gs_autoinpatientservicesjob
		ls_schedulename = gs_autoinpatientservicesjobschedule
		if parent.tab_preferences.tabpage_schedule.cbx_inpatientrecurringservices.checked = true then
			ls_hr = parent.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicehr.text
			ls_min = parent.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicemin.text
			ls_sec = parent.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicesec.text
			ls_ampm = parent.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicetime.text
			if isnull(ls_hr) or ls_hr = "" or ls_hr = "none" then
				messagebox("BackUp Time Validation", "Please select hours from dropdown box.")
				parent.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicehr.setfocus()
				return ::message.returnvalue
			elseif isnull(ls_min) or ls_min = "" or ls_min = "none" then
				messagebox("BackUp Time Validation", "Please select minutes from dropdown box.")
				parent.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicemin.setfocus()
				return ::message.returnvalue
			elseif isnull(ls_sec) or ls_sec = "" or ls_sec = "none" then
				messagebox("BackUp Time Validation", "Please select seconds from dropdown box.")
				parent.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicesec.setfocus()
				return ::message.returnvalue
			elseif isnull(ls_ampm) or ls_ampm = "" or ls_ampm = "none" then
				messagebox("BackUp Time Validation", "Please select AM/PM from dropdown box.")
				parent.tab_preferences.tabpage_schedule.ddlb_inpatientrecurringservicetime.setfocus()
				return ::message.returnvalue
			end if
			li_hr = integer(ls_hr)
			if ls_ampm = "PM" then
				if li_hr < 12 then
					li_hr = li_hr + 12
				end if
			elseif li_hr = 12 then
				li_hr = 0
			end if
			ls_activetime = string(li_hr) + ls_min + ls_sec
			ll_activetime = long(ls_activetime)
			li_unit = 1
			li_unitvalue = 0
			sqlca.adjustjobschedule(ls_jobname, ls_schedulename, ll_activetime, li_unit, li_unitvalue)
			sqlca.activatejob(ls_jobname, 1)
		else
			sqlca.activatejob(ls_jobname, 0)
		end if
		ls_jobname = gs_autocashsalepostingjob
		ls_schedulename = gs_autocashsalepostingjobschedule
		if sqlca.sqlcode = 0 then
			if parent.tab_preferences.tabpage_schedule.cbx_activateautocashsaleposting.checked = true then
				if parent.tab_preferences.tabpage_schedule.dw_autocashsalepostingschedule.accepttext() = 1 then
					li_unitvalue = parent.tab_preferences.tabpage_schedule.dw_autocashsalepostingschedule.getitemnumber(1, "unitvalue")
					li_unit = parent.tab_preferences.tabpage_schedule.dw_autocashsalepostingschedule.getitemnumber(1, "unit")
					if li_unit = 4 then
						if not (li_unitvalue >= 1 and li_unitvalue <= 1440) then
							messagebox("Cash Sale Posting Time Validation", "Please enter valid value for minutes between 1 and 1440 for auto cash sale posting.")
							parent.tab_preferences.tabpage_schedule.dw_autocashsalepostingschedule.setcolumn(1)
							parent.tab_preferences.tabpage_schedule.dw_autocashsalepostingschedule.setfocus()
							return ::message.returnvalue
						end if
					elseif li_unit = 8 then
						if not (li_unitvalue >= 1 and li_unitvalue <= 24) then
							messagebox("Cash Sale Posting Time Validation", "Please enter valid value for hours between 1 and 24 for auto cash sale posting.")
							parent.tab_preferences.tabpage_schedule.dw_autocashsalepostingschedule.setcolumn(2)
							parent.tab_preferences.tabpage_schedule.dw_autocashsalepostingschedule.setfocus()
							return ::message.returnvalue
						end if
					else
						messagebox("Cash Sale Posting Time Validation", "Please select minutes/hours from dropdown list box of auto cash sale posting.")
						parent.tab_preferences.tabpage_schedule.dw_autocashsalepostingschedule.setcolumn(2)
						parent.tab_preferences.tabpage_schedule.dw_autocashsalepostingschedule.setfocus()
						return ::message.returnvalue
					end if
				else
					messagebox("Cash Sale Posting Validation", "Please enter valid value of a unit for auto cash sale posting.")
					parent.tab_preferences.tabpage_schedule.dw_autocashsalepostingschedule.setcolumn(1)
					parent.tab_preferences.tabpage_schedule.dw_autocashsalepostingschedule.setfocus()
					return ::message.returnvalue
				end if
				ll_activetime = 0
				sqlca.adjustjobschedule(ls_jobname, ls_schedulename, ll_activetime, li_unit, li_unitvalue)
				sqlca.activatejob(ls_jobname, 1)
			else
				sqlca.activatejob(ls_jobname, 0)
			end if
			ls_jobname = gs_autocreditsalepostingjob
			ls_schedulename = gs_autocreditsalepostingjobschedule
			if sqlca.sqlcode = 0 then
				if parent.tab_preferences.tabpage_schedule.cbx_activateautocreditsaleposting.checked = true then
					if parent.tab_preferences.tabpage_schedule.dw_autocreditsalepostingschedule.accepttext() = 1 then
						li_unitvalue = parent.tab_preferences.tabpage_schedule.dw_autocreditsalepostingschedule.getitemnumber(1, "unitvalue")
						li_unit = parent.tab_preferences.tabpage_schedule.dw_autocreditsalepostingschedule.getitemnumber(1, "unit")
						if li_unit = 4 then
							if not (li_unitvalue >= 1 and li_unitvalue <= 1440) then
								messagebox("Credit Sale Posting Time Validation", "Please enter valid value for minutes between 1 and 1440 for auto credit sale posting.")
								parent.tab_preferences.tabpage_schedule.dw_autocreditsalepostingschedule.setcolumn(1)
								parent.tab_preferences.tabpage_schedule.dw_autocreditsalepostingschedule.setfocus()
								return ::message.returnvalue
							end if
						elseif li_unit = 8 then
							if not (li_unitvalue >= 1 and li_unitvalue <= 24) then
								messagebox("Credit Sale Posting Time Validation", "Please enter valid value for hours between 1 and 24 for auto credit sale posting.")
								parent.tab_preferences.tabpage_schedule.dw_autocreditsalepostingschedule.setcolumn(2)
								parent.tab_preferences.tabpage_schedule.dw_autocreditsalepostingschedule.setfocus()
								return ::message.returnvalue
							end if
						else
							messagebox("Credit Sale Posting Time Validation", "Please select minutes/hours from dropdown list box of auto credit sale posting.")
							parent.tab_preferences.tabpage_schedule.dw_autocreditsalepostingschedule.setcolumn(2)
							parent.tab_preferences.tabpage_schedule.dw_autocreditsalepostingschedule.setfocus()
							return ::message.returnvalue
						end if
					else
						messagebox("Credit Sale Posting Validation", "Please enter valid value of a unit for auto credit sale posting.")
						parent.tab_preferences.tabpage_schedule.dw_autocreditsalepostingschedule.setcolumn(1)
						parent.tab_preferences.tabpage_schedule.dw_autocreditsalepostingschedule.setfocus()
						return ::message.returnvalue
					end if
					ll_activetime = 0
					sqlca.adjustjobschedule(ls_jobname, ls_schedulename, ll_activetime, li_unit, li_unitvalue)
					sqlca.activatejob(ls_jobname, 1)
				else
					sqlca.activatejob(ls_jobname, 0)
				end if
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					gds_preferences.retrieve()
				else
					SQL rollback USING sqlca;
					messagebox("Job Error", "Unable to update credit sale posting job status.")
					setpointer(arrow!)
				end if
			else
				SQL rollback USING sqlca;
				messagebox("Job Error", "Unable to update cash sale posting job status.")
				setpointer(arrow!)
			end if
		else
			SQL rollback USING sqlca;
			messagebox("Job Error", "Unable to update backup job status.")
			setpointer(arrow!)
		end if
	else
		SQL rollback USING sqlca;
		return ::message.returnvalue
	end if
	if parent.wf_updatesigfile() = -1 then
		return ::message.returnvalue
	end if
	setpointer(arrow!)
	w_parent.setfocus()
	close(w_newpreferences)
	return ::message.returnvalue

