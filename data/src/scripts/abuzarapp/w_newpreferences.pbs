// dw_otherspref.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	string ls_docname
	string ls_named
	string ls_path
	integer li_value
	string ls_s
	ls_s = dwo.name
	choose case dwo.name
	case "b_browse"
		ls_docname = this.object.outputfilepath[1]
		li_value = getfileopenname("Select File Location", ls_docname, ls_named, "TXT", "All Files (*.*),*.*," + "All Files (*.*),*.*")
		if li_value = 1 then
			ls_path = left(ls_docname, len(ls_docname) - pos(reverse(ls_docname), "\") + 1)
			this.object.outputfilepath[1] = ls_path
		end if
	end choose
	return ::message.returnvalue

