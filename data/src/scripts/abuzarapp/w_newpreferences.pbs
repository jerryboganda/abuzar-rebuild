	this.tab_preferences.tabpage_schedule.dw_autocashsalepostingschedule.retrieve(gs_autocashsalepostingjob, gs_autocashsalepostingjobschedule)
	SQL Select enabled INTO :li_enabled From SysJobs Where Name =:gs_autocashsalepostingjob USING this.it_jobtransobject;
	if this.it_jobtransobject.sqlcode = 0 then
		this.tab_preferences.tabpage_schedule.em_autocashsalepostingtime.text = string(this.id_general1.getitemnumber(this.id_general1.getrow(), "cashsaleautopostingtime"))
