// function f_get_specialright_password (functions)  ancestor: function_object

// f_get_specialright_password.f_get_specialright_password(string as_rightid) returns string
	string ls_pwd
	string ls_null
	setnull(ls_null)
	SQL SELECT RightPwd INTO :ls_pwd FROM DBO.SpecialRight WHERE RightID =:as_rightid AND UPPER ( enable ) ='Y' USING sqlca;
	if sqlca.sqlcode = 0 then
		if isnull(ls_pwd) then
			return ls_null
		else
			return ls_pwd
		end if
		return
	end if
	return ls_null
