// function f_get_servicecomponentunit_editmask (functions)  ancestor: function_object

// f_get_servicecomponentunit_editmask.f_get_servicecomponentunit_editmask(string as_datatype) returns string
	if as_datatype = "N" then
		return "########0"
	end if
	if as_datatype = "D" then
		return "########0.0000"
	end if
	return ""
