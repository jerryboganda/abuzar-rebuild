// function f_generatesaleslog (functions)  ancestor: function_object

// f_generatesaleslog.f_generatesaleslog(long al_saleinvcode, datetime adt_server_datetime, ref transaction at_transobject) returns long
	long ll_retval
	long ll_logid
	if f_newtableid1("SaleLedgerLog", ll_logid) >= 0 then
		SQL INSERT SaleLedgerlog SELECT SaleLedgerLogID =:ll_logid , SaleLogDate =:adt_server_datetime , S.*FROM SaleLedger S WHERE S.SaleInvCode =:al_saleinvcode USING at_transobject;
		if at_transobject.sqlcode = 0 then
			SQL INSERT SaleDetaillog SELECT SaleLedgerLogID =:ll_logid , SD.*FROM SaleDetail SD WHERE SD.SaleInvCode =:al_saleinvcode USING at_transobject;
			if at_transobject.sqlcode = 0 then
				ll_retval = 0
			else
				ll_retval = -1
			end if
		else
			ll_retval = -1
		end if
	else
		ll_retval = -1
	end if
	return ll_retval
