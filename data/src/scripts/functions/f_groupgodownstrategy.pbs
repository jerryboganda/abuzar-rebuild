// function f_groupgodownstrategy (functions)  ancestor: function_object

// f_groupgodownstrategy.f_groupgodownstrategy(integer ai_module, long al_groupcode) returns long
	long ll_strategy
	choose case ai_module
	case 1
		SQL SELECT SaleGodownStrategy INTO :ll_strategy FROM groups WHERE GroupCode =:al_groupcode USING sqlca;
	case 2
		SQL SELECT SaleReturnGodownStrategy INTO :ll_strategy FROM groups WHERE GroupCode =:al_groupcode USING sqlca;
	case 3
		SQL SELECT PurchaseGodownStrategy INTO :ll_strategy FROM groups WHERE GroupCode =:al_groupcode USING sqlca;
	case 4
		SQL SELECT PurchaseReturnGodownStrategy INTO :ll_strategy FROM groups WHERE GroupCode =:al_groupcode USING sqlca;
	case 5
		SQL SELECT IssueGodownStrategy INTO :ll_strategy FROM groups WHERE GroupCode =:al_groupcode USING sqlca;
	case 6
		SQL SELECT ReceiptGodownStrategy INTO :ll_strategy FROM groups WHERE GroupCode =:al_groupcode USING sqlca;
	case 7
		SQL SELECT AdjustmentGodownStrategy INTO :ll_strategy FROM groups WHERE GroupCode =:al_groupcode USING sqlca;
	case else
		SQL SELECT SaleGodownStrategy INTO :ll_strategy FROM groups WHERE GroupCode =:al_groupcode USING sqlca;
	end choose
	return ll_strategy
