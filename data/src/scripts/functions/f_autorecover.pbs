// function f_autorecover (functions)  ancestor: function_object

// f_autorecover.f_autorecover(ref string as_backupname, ref datetime adt_datetime, ref double ad_size, ref string as_errtext) returns long
	string backupname
	string backupdescription
	string username
	string servername
	string databasename
	string machinename
	string collation
	string bindingid
	string recoveryforkid
	string familyguid
	string firstrecoveryforkid
	string recoverymodel
	string differentialbaseguid
	string backuptypedescription
	string backupsetguid
	long backuptype
	long compressed
	long position
	long devicetype
	long databaseversion
	long sortorder
	long codepage
	long unicodelocaleid
	long unicodecomparisonstyle
	long compatibilitylevel
	long softwarevendorid
	long softwareversionmajor
	long compressedbackupsize
	long containment
	long softwareversionminor
	long softwareversionbuild
	long flags
	long hasbulkloggeddata
	long issnapshot
	long is_readonly
	long issingleuser
	long hasbackupchecksums
	long isdamaged
	long beginslogchain
	long hasincompletemetadata
	long isforceoffline
	long iscopyonly
	datetime expirationdate
	datetime databasecreationdate
	datetime backupstartdate
	datetime backupfinishdate
	double backupsize
	double firstlsn
	double lastlsn
	double checkpointlsn
	double differentialbaselsn
	double dabasebackuplsn
	double forkpointlsn
	string ls_query
	string ls_backupdevice
	string ls_servername
	string[] ls_bkupdevice
	string ls_version_info = "0                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             0"
	long ll_counter
	long ll_arraycount
	long ll_row
	long ll_pos
	long ll_retcode
	long ll_validbackupcount
	u_ds_standard lds_bkup
	lds_bkup = create u_ds_standard
	lds_bkup.dataobject = "d_backupinfo"
	lds_bkup.settransobject(sqlca)
	SQL SELECT Ver =@@Version INTO :ls_version_info FROM ( SELECT A =1 ) AS T USING sqlca;
	if sqlca.sqlcode <> 0 then
		messagebox("", "Unable to Fetch SQL Server Version Information. Details are:-~r~n" + sqlca.sqlerrtext)
		return -1
	end if
	ls_bkupdevice[1, 2] = "Manual Backup"
	ls_bkupdevice[1, 3] = "manual"
	ls_bkupdevice[2, 2] = "Auto Client Backup"
	ls_bkupdevice[2, 3] = "autoclient"
	ls_bkupdevice[3, 2] = "Auto StartUp Backup"
	ls_bkupdevice[3, 3] = "autostartup"
	ll_pos = pos(gs_servername, "\")
	if ll_pos > 0 then
		ls_servername = left(gs_servername, ll_pos - 1)
	else
		ls_servername = gs_servername
	end if
	for ll_counter = 1 to 3
		ls_backupdevice = f_getbackupdevicename(ls_bkupdevice[ll_counter, 3])
		ls_bkupdevice[ll_counter, 1] = ls_backupdevice
	next
	ll_counter = 1
	ls_query = "USE tempdb          if exists (select * from dbo.sysobjects where id = object_id(N'[dbo].[sp_execute_temp]') and OBJECTPROPERTY(id, N'IsProcedure') = 1)    DROP PROCEDURE dbo.sp_execute_temp "
	SQL EXECUTE IMMEDIATE :ls_query USING sqlca;
	if sqlca.sqlcode = 0 then
		ls_query = "CREATE PROCEDURE dbo.sp_execute_temp @qry VarChar(8000) As Execute (@Qry)"
		SQL EXECUTE IMMEDIATE :ls_query USING sqlca;
	end if
	for ll_counter = 1 to 3
		backupname = ""
		backupdescription = ""
		username = ""
		servername = ""
		databasename = ""
		machinename = ""
		collation = ""
		bindingid = ""
		recoveryforkid = ""
		familyguid = ""
		firstrecoveryforkid = ""
		recoverymodel = ""
		differentialbaseguid = ""
		backuptypedescription = ""
		backupsetguid = ""
		setnull(expirationdate)
		setnull(databasecreationdate)
		setnull(backupstartdate)
		setnull(backupfinishdate)
		backupsize = 0
		firstlsn = 0
		lastlsn = 0
		checkpointlsn = 0
		differentialbaselsn = 0
		dabasebackuplsn = 0
		forkpointlsn = 0
		ls_backupdevice = ls_bkupdevice[ll_counter, 1]
		ll_row = lds_bkup.insertrow(0)
		lds_bkup.object.databasename[ll_row] = databasename
		lds_bkup.object.backupname[ll_row] = ls_bkupdevice[ll_counter, 1]
		lds_bkup.object.backupdescription[ll_row] = ls_bkupdevice[ll_counter, 2] + " (Not Found)"
		if match(ls_version_info, "SQL Server 2012") = true then
			ls_query = "Restore HeaderOnly FROM " + ls_backupdevice
		else
			ls_query = "Restore HeaderOnly FROM " + ls_backupdevice + " With PASSWORD = 'REDACTED" + lower(ls_servername) + "', MEDIAPASSWORD = 'REDACTED" + lower(ls_servername) + "'"
		end if
		SQL EXECUTE IMMEDIATE :ls_query USING sqlca;
		if sqlca.sqlcode = 0 then
			SQL EXECUTE sp_temp USING sqlca; /* args: ls_query */
			if sqlca.sqlcode = 0 then
				if match(ls_version_info, "SQL Server 2012") = true then
					SQL FETCH sp_temp INTO :backupname, :backupdescription, :backuptype, :expirationdate, :compressed, :position, :devicetype, :username, :servername, :databasename, :databaseversion, :databasecreationdate, :backupsize, :firstlsn, :lastlsn, :checkpointlsn, :dabasebackuplsn, :backupstartdate, :backupfinishdate, :sortorder, :codepage, :unicodelocaleid, :unicodecomparisonstyle, :compatibilitylevel, :softwarevendorid, :softwareversionmajor, :softwareversionminor, :softwareversionbuild, :machinename, :flags, :bindingid, :recoveryforkid, :collation, :familyguid, :hasbulkloggeddata, :issnapshot, :is_readonly, :issingleuser, :hasbackupchecksums, :isdamaged, :beginslogchain, :hasincompletemetadata, :isforceoffline, :iscopyonly, :firstrecoveryforkid, :forkpointlsn, :recoverymodel, :differentialbaselsn, :differentialbaseguid, :backuptypedescription, :backupsetguid, :compressedbackupsize, :containment USING sqlca;
				else
					SQL FETCH sp_temp INTO :backupname, :backupdescription, :backuptype, :expirationdate, :compressed, :position, :devicetype, :username, :servername, :databasename, :databaseversion, :databasecreationdate, :backupsize, :firstlsn, :lastlsn, :checkpointlsn, :dabasebackuplsn, :backupstartdate, :backupfinishdate, :sortorder, :codepage, :unicodelocaleid, :unicodecomparisonstyle, :compatibilitylevel, :softwarevendorid, :softwareversionmajor, :softwareversionminor, :softwareversionbuild, :machinename, :flags, :bindingid, :recoveryforkid, :collation USING sqlca;
				end if
				if sqlca.sqlcode = 0 then
					lds_bkup.object.backupdescription[ll_row] = ls_bkupdevice[ll_counter, 2]
					lds_bkup.object.backupstartdate[ll_row] = backupstartdate
					lds_bkup.object.backupfinishdate[ll_row] = backupfinishdate
					lds_bkup.object.backupsize[ll_row] = round(backupsize / 1024.00 / 1024.00, 2)
					lds_bkup.object.machinename[ll_row] = machinename
					lds_bkup.object.servername[ll_row] = servername
					lds_bkup.object.physicallocation[ll_row] = ""
					SQL CLOSE sp_temp USING sqlca;
				else
					messagebox("Back Information", "Unable to fetch backup header information for backup device." + ls_bkupdevice[ll_counter, 1] + "~r~n" + sqlca.sqlerrtext)
					SQL CLOSE sp_temp USING sqlca;
				end if
			else
				messagebox("Back Information..", "Unable to fetch backup header information for backup device." + ls_bkupdevice[ll_counter, 1] + "~r~n" + sqlca.sqlerrtext)
				SQL CLOSE sp_temp USING sqlca;
			end if
		else
			messagebox("Back Information...", "Unable to create temporary stored proc.~r~nUnable to fetch backup header information for backup device. " + ls_bkupdevice[ll_counter, 1] + "~r~n" + sqlca.sqlerrtext)
		end if
	next
	ll_counter = 1
	lds_bkup.sort()
	for ll_counter = 1 to lds_bkup.rowcount()
		if not isnull(lds_bkup.object.backupfinishdate[ll_counter]) then
			ll_validbackupcount = ll_validbackupcount + 1
			if match(ls_version_info, "SQL Server 2012") = true then
				ls_query = "RESTORE DATABASE " + gs_dbname + " FROM " + lds_bkup.object.backupname[ll_counter] + " With RECOVERY, REPLACE "
			else
				ls_query = "RESTORE DATABASE " + gs_dbname + " FROM " + lds_bkup.object.backupname[ll_counter] + " With RECOVERY, REPLACE, PASSWORD = 'REDACTED" + lower(ls_servername) + "', MEDIAPASSWORD = 'REDACTED" + lower(ls_servername) + "'"
			end if
			SQL EXECUTE IMMEDIATE :ls_query USING sqlca;
			if sqlca.sqlcode = 0 then
				as_backupname = lds_bkup.object.backupname[ll_counter]
				adt_datetime = lds_bkup.object.backupfinishdate[ll_counter]
				ad_size = lds_bkup.object.backupsize[ll_counter]
				as_errtext = sqlca.sqlerrtext
				ll_retcode = 1
				exit
			else
				as_errtext = sqlca.sqlerrtext
			end if
		end if
	next
	if ll_validbackupcount = 0 then
		ll_retcode = -1
	end if
	return ll_retcode
