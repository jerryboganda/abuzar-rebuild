// function f_readimgfromfile (functions)  ancestor: function_object

// f_readimgfromfile.f_readimgfromfile(string as_filepath, blob ablob_contents) returns integer
	long ll_filenum
	long ll_ret
	ablob_contents = blob(fill("0", 1000000))
	ll_filenum = fileopen(as_filepath, streammode!, read!, lockread!)
	ll_ret = filereadex(ll_filenum, ablob_contents)
	fileclose(ll_filenum)
	return 1
