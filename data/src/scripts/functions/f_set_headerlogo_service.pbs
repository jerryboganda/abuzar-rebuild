// function f_set_headerlogo_service (functions)  ancestor: function_object

// f_set_headerlogo_service.f_set_headerlogo_service(datawindow adw_dw, integer ai_headerno) returns long
	string ls_logofilename
	string ls_filename
	if not isnull(ai_headerno) and ai_headerno > 0 then
		ls_logofilename = ls_filename + trim(string(ai_headerno)) + ".bmp"
	end if
	if gs_company = "FATIMAPHARMACY" or gs_company = "FAWMOTORS" then
		adw_dw.object.p_1.filename = ls_logofilename
	end if
	return 0
