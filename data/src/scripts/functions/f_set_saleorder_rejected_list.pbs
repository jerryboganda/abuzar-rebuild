// function f_set_saleorder_rejected_list (functions)  ancestor: function_object

// f_set_saleorder_rejected_list.f_set_saleorder_rejected_list() returns string
	if gs_company = "TAJMEDICOSCFC" or gs_company = "TAJMEDICOSE" or gs_company = "TAJMEDICOSWH" or gs_company = "TAJMEDICOS3" or gs_company = "TAJMEDICOS2" or gs_company = "TAJMEDICOSKT" or gs_company = "TAJMEDICOSSSGC" then
		return "d_saleorder_rejected_tajmedicos"
	end if
	if gs_company = "MASOODHOMOEO" or gs_company = "MASOODHOMOEOKL" or gs_company = "MASOODHOMOEODHA" then
		return "d_so_salepopulation_rejected_masood"
	end if
	return "d_saleorder_salepopulation_rejected"
