// function f_writeimgtofile (functions)  ancestor: function_object

// f_writeimgtofile.f_writeimgtofile(string as_filepath, blob ablob_contents) returns integer
	long ll_filenum
	filedelete(as_filepath)
	ll_filenum = fileopen(as_filepath, streammode!, write!, lockreadwrite!, replace!)
	filewriteex(ll_filenum, ablob_contents)
	fileclose(ll_filenum)
	return 1
