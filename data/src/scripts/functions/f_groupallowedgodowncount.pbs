// function f_groupallowedgodowncount (functions)  ancestor: function_object

// f_groupallowedgodowncount.f_groupallowedgodowncount(integer ai_module, long al_groupcode) returns long
	long ll_godowncount
	SQL SELECT Isnull ( COUNT ( gcode ) , 0 ) INTO :ll_godowncount FROM GroupAllowedGodown WHERE GroupCode =:al_groupcode and Module =:ai_module USING sqlca;
	return ll_godowncount
