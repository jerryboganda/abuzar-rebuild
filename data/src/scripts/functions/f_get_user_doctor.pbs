// function f_get_user_doctor (functions)  ancestor: function_object

// f_get_user_doctor.f_get_user_doctor(long al_usercode) returns long
	long ll_doctcode
	SQL SELECT ISNULL ( MIN ( DoctCode ) , 1 ) INTO :ll_doctcode FROM UserAllowedDoctor WHERE UserCode =:al_usercode USING sqlca;
	if sqlca.sqlcode = 0 then
		return ll_doctcode
	end if
	return 1
