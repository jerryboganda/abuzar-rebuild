// function f_opentransactionwindow (functions)  ancestor: function_object

// f_opentransactionwindow.f_opentransactionwindow(long al_category) returns long
	long ll_arg
	long ll_found
	long ll_rightcode
	w_transactionwindow lw_sheet
	if al_category = 1 then
		ll_arg = 1
		ll_rightcode = 1223
	else
		ll_arg = 2
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = " + trim(string(ll_rightcode)), 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		openwithparm(lw_sheet, ll_arg)
	end if
	return 0
