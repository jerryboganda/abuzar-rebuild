// function f_pump_purorder_purreturn_to_datacarrydb (functions)  ancestor: function_object

// f_pump_purorder_purreturn_to_datacarrydb.f_pump_purorder_purreturn_to_datacarrydb(ref transaction at_transobject, long al_spocode, long al_lpocode, long al_sprcode, long al_lprcode, long al_ssocode, long al_lsocode) returns long
	long ll_rtcode
	integer li_custcode
	string ls_errtext
	u_transaction lt_transobject
	lt_transobject = at_transobject
	setnull(li_custcode)
	SQL rollback USING lt_transobject;
	ll_rtcode = lt_transobject.empty_datacarrydb(gs_outlinkserver, gs_outlinkserverdb, gs_outlinkserverowner)
	if ll_rtcode >= 0 and lt_transobject.sqlcode = 0 then
		ll_rtcode = lt_transobject.insertpo_to_datacarrydb(gs_outlinkserver, gs_outlinkserverdb, gs_outlinkserverowner, al_spocode, al_lpocode)
		if ll_rtcode >= 0 and lt_transobject.sqlcode = 0 then
			ll_rtcode = lt_transobject.insertpr_to_datacarrydb(gs_outlinkserver, gs_outlinkserverdb, gs_outlinkserverowner, al_sprcode, al_lprcode)
			if ll_rtcode >= 0 and lt_transobject.sqlcode = 0 then
				ll_rtcode = lt_transobject.insertso_to_datacarrydb(gs_outlinkserver, gs_outlinkserverdb, gs_outlinkserverowner, al_ssocode, al_lsocode, li_custcode)
				if ll_rtcode >= 0 and lt_transobject.sqlcode = 0 then
					SQL commit USING lt_transobject;
					messagebox("Data Transfer", "Successfull Data Transfer to DataCarryDB.")
				else
					ls_errtext = lt_transobject.sqlerrtext
					SQL rollback USING lt_transobject;
					messagebox("DataCarryDB Problem", "Error in Inserting Sale Order data from DataCarryDB.~r~nReasons are:~r~n" + ls_errtext)
					return -1
				end if
			else
				ls_errtext = lt_transobject.sqlerrtext
				SQL rollback USING lt_transobject;
				messagebox("DataCarryDB Problem", "Error in Inserting PurReturn data from DataCarryDB.~r~nReasons are:~r~n" + ls_errtext)
				return -1
			end if
		else
			ls_errtext = lt_transobject.sqlerrtext
			SQL rollback USING lt_transobject;
			messagebox("DataCarryDB Problem", "Error in Inserting PurOrder data from DataCarryDB.~r~nReasons are:~r~n" + ls_errtext)
			return -1
		end if
	else
		ls_errtext = lt_transobject.sqlerrtext
		SQL rollback USING lt_transobject;
		messagebox("DataCarryDB Problem", "Error in Emptying data from DataCarryDB.~r~nReasons are:~r~n" + ls_errtext)
		return -1
	end if
	return 1
