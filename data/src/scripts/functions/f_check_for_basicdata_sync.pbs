// function f_check_for_basicdata_sync (functions)  ancestor: function_object

// f_check_for_basicdata_sync.f_check_for_basicdata_sync() returns long
	long ll_retcode
	long ll_itemscount
	long ll_logrows
	long ll_res
	string ls_error_syntax
	string ls_newsyntax
	string ls_server
	string ls_connsetting
	string ls_errortext
	u_transaction lt_transobject
	char lc_items
	char lc_accounts
	char lc_security
	char lc_patients
	char ac_service
	ls_connsetting = "Set ANSI_NULLS ON Set ANSI_WARNINGS ON"
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Problem", "Problem in Connecting Database", stopsign!)
		return -1
	end if
	SQL EXECUTE IMMEDIATE :ls_connsetting USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Setting Problem", "Problem in Reseting Connection Properties", stopsign!)
		return -1
	end if
	ll_retcode = lt_transobject.checkfornewitemindatacarry(gs_inlinkserver)
	ls_errortext = lt_transobject.sqlerrtext
	if lt_transobject.sqlcode = 0 then
		if ll_retcode = 0 then
			return 0
		elseif ll_retcode > 0 then
			ll_res = messagebox("Basic Data Synchronization Alert", "It seems that there are few basic data changes in data carry that you~r~nmight need to update first and then proceed further.~r~nNot doing so may result in errors.~r~n~r~nDo you want to synchronize basic data first?", question!, okcancel!, 1)
			if ll_res = 1 then
				if f_importdata_from_datacarrydb(lc_items, ac_service, lc_accounts, lc_security, lc_patients, lt_transobject, gl_usercode) <= 0 then
					ll_retcode = -1
					return ll_retcode
				end if
			elseif ll_res = 2 then
				ll_retcode = -1
				return ll_retcode
			end if
			return ll_retcode
		else
			messagebox("New Item Checking Problem", "Problem in Checking New Items in Data Carry.~r~nDetails are:-~r~n" + ls_errortext, stopsign!)
		end if
		return
	end if
	messagebox("New Item Checking Problem", "Problem in Checking New Items in Data Carry.~r~nDetails are:-~r~n" + ls_errortext, stopsign!)
	return -1
