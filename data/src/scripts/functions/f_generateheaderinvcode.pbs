// function f_generateheaderinvcode (functions)  ancestor: function_object

// f_generateheaderinvcode.f_generateheaderinvcode(integer ai_headercode, integer ai_module, long al_headerinvcode) returns integer
	long ll_rtcode
	SQL rollback USING sqlca;
	SQL SELECT TABMAXKEY INTO :al_headerinvcode FROM _HEADERTABMAXKEY WITH ( UPDLOCK HOLDLOCK ) WHERE _HEADERTABMAXKEY.HeaderCode =:ai_headercode AND _HEADERTABMAXKEY.Module =:ai_module USING sqlca;
	if sqlca.sqlcode = 0 then
		al_headerinvcode = al_headerinvcode + 1
		SQL update dbo._HEADERTABMAXKEY SET TABMAXKEY =:al_headerinvcode WHERE _HEADERTABMAXKEY.HeaderCode =:ai_headercode AND _HEADERTABMAXKEY.Module =:ai_module USING sqlca;
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			ll_rtcode = sqlca.sqlcode
			al_headerinvcode = 0
			SQL rollback USING sqlca;
		end if
	else
		ll_rtcode = sqlca.sqlcode
		al_headerinvcode = 0
		SQL rollback USING sqlca;
	end if
	return ll_rtcode
