// function f_setserviceqty_format (functions)  ancestor: function_object

// f_setserviceqty_format.f_setserviceqty_format() returns string
	string ls_allowdecimalinserviceqty
	string ls_editstyle
	ls_allowdecimalinserviceqty = upper(f_stringpreferences("AllowDecimalInServiceQty"))
	if ls_allowdecimalinserviceqty = "Y" then
		ls_editstyle = "##,###,##0.00"
	else
		ls_editstyle = "##,###,##0"
	end if
	return ls_editstyle
