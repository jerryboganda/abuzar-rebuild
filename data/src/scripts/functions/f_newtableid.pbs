// function f_newtableid (functions)  ancestor: function_object

// f_newtableid.f_newtableid(string as_tablename, ref long al_newid) returns integer
	long ll_rtcode
	SQL rollback USING sqlca;
	SQL SELECT TABMAXKEY INTO :al_newid FROM _TABMAXKEY WITH ( UPDLOCK HOLDLOCK ) WHERE _TABMAXKEY.TABName =:as_tablename USING sqlca;
	if sqlca.sqlcode = 0 then
		al_newid = al_newid + 1
		SQL update dbo._tabmaxkey SET TABMAXKEY =:al_newid WHERE _TABMAXKEY.TABName =:as_tablename USING sqlca;
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			ll_rtcode = sqlca.sqlcode
			al_newid = 0
			SQL rollback USING sqlca;
		end if
	else
		ll_rtcode = sqlca.sqlcode
		al_newid = 0
		SQL rollback USING sqlca;
	end if
	return ll_rtcode
