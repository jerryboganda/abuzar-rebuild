// function f_get_username (functions)  ancestor: function_object

// f_get_username.f_get_username(long al_usercode) returns string
	string ls_username
	SQL SELECT UserName INTO :ls_username FROM DBO.Users WHERE UserCode =:al_usercode USING sqlca;
	if sqlca.sqlcode <> 0 then
		ls_username = ""
	end if
	return ls_username
