// function f_rightsmodification (functions)  ancestor: function_object

// f_rightsmodification.f_rightsmodification() returns long
	open(w_rightsmodification_key)
	if message.doubleparm = -1.0 or message.doubleparm = 0.0 then
		return -1
	end if
	openwithparm(w_rightsmodification, message.doubleparm)
	return 0
