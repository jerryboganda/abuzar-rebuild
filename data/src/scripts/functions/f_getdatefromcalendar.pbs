// function f_getdatefromcalendar (functions)  ancestor: function_object

// f_getdatefromcalendar.f_getdatefromcalendar(string as_date) returns long
	string ls_date
	ls_date = left(as_date, 10)
	openwithparm(w_calendar, ls_date)
	ls_date = message.stringparm
	if ls_date = "" or isnull(ls_date) then
		as_date = ""
	else
		as_date = ls_date
	end if
	return 0
