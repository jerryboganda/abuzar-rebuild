// function vf_dwdupdate (functions)  ancestor: function_object

// vf_dwdupdate.vf_dwdupdate(datawindow ad_dwcontrol, string as_colname, datetime ad_date, long al_row) returns boolean
	long rt_code
	boolean yesno
	string ls_find
	if ad_dwcontrol.rowcount() > 1 then
		ls_find = "string(" + as_colname + ", 'mm/dd/yyyy') = '" + string(ad_date, "mm/dd/yyyy") + "'"
		if al_row > 1 then
			rt_code = ad_dwcontrol.find(ls_find, al_row - 1, 0)
		end if
		if rt_code = 0 then
			if al_row <> ad_dwcontrol.rowcount() then
				rt_code = ad_dwcontrol.find(ls_find, al_row + 1, ad_dwcontrol.rowcount())
			end if
			if rt_code <> 0 then
				yesno = true
			end if
		else
			yesno = true
		end if
	end if
	return yesno
