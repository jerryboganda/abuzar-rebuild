// function f_get_preference_local (functions)  ancestor: function_object

// f_get_preference_local.f_get_preference_local(ref datawindow adw_dw, string as_prefname, ref string as_prefvalue) returns long
	long ll_found
	string ls_prefname
	ls_prefname = lower(as_prefname)
	ll_found = adw_dw.find("lower(name) = '" + ls_prefname + "'", 1, adw_dw.rowcount())
	if ll_found > 0 and ll_found <= adw_dw.rowcount() then
		as_prefvalue = trim(adw_dw.object.prefvalue[ll_found])
	end if
	return 0
