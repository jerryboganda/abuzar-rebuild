// function f_generateitemlog (functions)  ancestor: function_object

// f_generateitemlog.f_generateitemlog(ref datawindow ad_dwcontrol, string as_module, ref transaction at_transobject, datetime adt_server_datetime) returns long
	long ll_retval
	long ll_rowcount
	long ll_counter
	long ll_code
	long ll_icatcode
	long ll_packcode
	long ll_manfcode
	long ll_classcode
	long ll_icode
	long ll_iccode
	double ld_newsaleprice
	double ld_saledisc
	ll_rowcount = ad_dwcontrol.rowcount()
	if ll_rowcount > 0 then
		ll_counter = 1
		ll_retval = 0
		choose case as_module
		case "item_basicdata"
			do while ll_counter <= ll_rowcount
				if ad_dwcontrol.getitemstatus(ll_counter, "name", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "purprice", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "saleprice", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "packunits", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "customicode", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "manfcode", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "packsalestax", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "salestax", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "gstperc1", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "gstperc2", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "packcode", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "printable", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "icatcode", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "active", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "iccode", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "purdiscperc", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "salediscperc", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "gcode", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "saleprice2", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "saleprice3", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "saleprice4", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "saleprice5", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "itemalertcode", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "restricted", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "usercode", primary!) = datamodified! then
					ll_code = ad_dwcontrol.getitemnumber(ll_counter, "code")
					ld_newsaleprice = ad_dwcontrol.getitemnumber(ll_counter, "saleprice")
					SQL INSERT itemlog SELECT LogDate =:adt_server_datetime , newsaleprice =:ld_newsaleprice , stock =( SELECT isnull ( sum ( g.currqty ) , 0 ) FROM godowndetail g WHERE g.icode =i.icode ) , i.*FROM item i WHERE i.icode =:ll_code USING at_transobject;
					if at_transobject.sqlcode = 0 then
						ll_retval = 1
					else
						ll_retval = -1
						return ll_retval
					end if
					return
				end if
				ll_counter = ll_counter + 1
			loop
		case "sale_margin_markup_auditing"
			do while ll_counter <= ll_rowcount
				if ad_dwcontrol.getitemstatus(ll_counter, "item_name", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_saleprice", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "itemmargin", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "itemmarkup", primary!) = datamodified! then
					ll_code = ad_dwcontrol.getitemnumber(ll_counter, "code")
					ld_newsaleprice = ad_dwcontrol.getitemdecimal(ll_counter, "item_saleprice")
					SQL INSERT itemlog SELECT LogDate =:adt_server_datetime , newsaleprice =:ld_newsaleprice , stock =( SELECT isnull ( sum ( g.currqty ) , 0 ) FROM godowndetail g WHERE g.icode =i.icode ) , i.*FROM item i WHERE i.icode =:ll_code USING at_transobject;
					if at_transobject.sqlcode = 0 then
						ll_retval = 1
					else
						ll_retval = -1
						return ll_retval
					end if
					return
				end if
				ll_counter = ll_counter + 1
			loop
		case "item_changeprice"
			do while ll_counter <= ll_rowcount
				if ad_dwcontrol.getitemstatus(ll_counter, "item_name", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_saleprice", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_saleprice2", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_saleprice3", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_saleprice4", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "Item_saleprice5", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_purprice", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_salediscperc", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_purdiscperc", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_packsalestax", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_gstperc1", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_gstperc2", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_packunits", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_icatcode", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_iccode", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_manfcode", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_itemalertcode", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_printable", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_packcode", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "item_usercode", primary!) = datamodified! then
					ll_code = ad_dwcontrol.getitemnumber(ll_counter, "code")
					ld_newsaleprice = ad_dwcontrol.getitemdecimal(ll_counter, "item_saleprice")
					SQL INSERT itemlog SELECT LogDate =:adt_server_datetime , newsaleprice =:ld_newsaleprice , stock =( SELECT isnull ( sum ( g.currqty ) , 0 ) FROM godowndetail g WHERE g.icode =i.icode ) , i.*FROM item i WHERE i.icode =:ll_code USING at_transobject;
					if at_transobject.sqlcode = 0 then
						ll_retval = 1
					else
						ll_retval = -1
						return ll_retval
					end if
					return
				end if
				ll_counter = ll_counter + 1
			loop
		case "item_changeprice_purchase"
			do while ll_counter <= ll_rowcount
				ll_icode = ad_dwcontrol.getitemnumber(ll_counter, "icode")
				ld_newsaleprice = ad_dwcontrol.getitemnumber(ll_counter, "salepriceforitem")
				ll_manfcode = ad_dwcontrol.getitemnumber(ll_counter, "manfcode")
				SQL INSERT itemlog SELECT LogDate =:adt_server_datetime , newsaleprice =:ld_newsaleprice , stock =( SELECT isnull ( sum ( g.currqty ) , 0 ) FROM godowndetail g WHERE g.icode =i.icode ) , i.*FROM item i WHERE i.icode =:ll_icode USING at_transobject;
				if at_transobject.sqlcode = 0 then
					ll_retval = 1
				else
					ll_retval = -1
					return ll_retval
				end if
				ll_counter = ll_counter + 1
			loop
		case "item_changeprices"
			do while ll_counter <= ll_rowcount
				ll_icatcode = ad_dwcontrol.getitemnumber(ll_counter, "icatcode")
				ll_packcode = ad_dwcontrol.getitemnumber(ll_counter, "packcode")
				ll_manfcode = ad_dwcontrol.getitemnumber(ll_counter, "manfcode")
				ld_newsaleprice = ad_dwcontrol.getitemnumber(ll_counter, "price")
				SQL INSERT itemlog SELECT LogDate =:adt_server_datetime , newsaleprice =:ld_newsaleprice , stock =( SELECT isnull ( sum ( g.currqty ) , 0 ) FROM godowndetail g WHERE g.icode =i.icode ) , i.*FROM item i WHERE i.icatcode =:ll_icatcode and i.packcode =:ll_packcode and i.manfcode =:ll_manfcode and i.Active =1 USING at_transobject;
				if at_transobject.sqlcode = 0 then
					ll_retval = 1
				else
					ll_retval = -1
					return ll_retval
				end if
				ll_counter = ll_counter + 1
			loop
		case "item_changeprices2"
			do while ll_counter <= ll_rowcount
				ll_icatcode = ad_dwcontrol.getitemnumber(ll_counter, "icatcode")
				ll_packcode = ad_dwcontrol.getitemnumber(ll_counter, "packcode")
				ll_manfcode = ad_dwcontrol.getitemnumber(ll_counter, "manfcode")
				ll_iccode = ad_dwcontrol.getitemnumber(ll_counter, "iccode")
				ld_newsaleprice = ad_dwcontrol.getitemnumber(ll_counter, "price")
				SQL INSERT itemlog SELECT LogDate =:adt_server_datetime , newsaleprice =:ld_newsaleprice , stock =( SELECT isnull ( sum ( g.currqty ) , 0 ) FROM godowndetail g WHERE g.icode =i.icode ) , i.*FROM item i WHERE i.icatcode =:ll_icatcode and i.packcode =:ll_packcode and i.manfcode =:ll_manfcode and i.iccode =:ll_iccode and i.Active =1 USING at_transobject;
				if at_transobject.sqlcode = 0 then
					ll_retval = 1
				else
					ll_retval = -1
					return ll_retval
				end if
				ll_counter = ll_counter + 1
			loop
		case "item_changedisc_maf_cat_packing"
			do while ll_counter <= ll_rowcount
				ld_saledisc = ad_dwcontrol.getitemdecimal(ll_counter, "saledisc")
				ll_manfcode = ad_dwcontrol.getitemnumber(ll_counter, "manfcode")
				ll_icatcode = ad_dwcontrol.getitemnumber(ll_counter, "icatcode")
				ll_packcode = ad_dwcontrol.getitemnumber(ll_counter, "packcode")
				SQL INSERT itemlog SELECT LogDate =:adt_server_datetime , newsaleprice =i.saleprice , stock =( SELECT isnull ( sum ( g.currqty ) , 0 ) FROM godowndetail g WHERE g.icode =i.icode ) , i.*FROM item i WHERE i.manfcode =:ll_manfcode AND i.icatcode =:ll_icatcode AND i.packcode =:ll_packcode AND i.active =1 USING at_transobject;
				if at_transobject.sqlcode = 0 then
					ll_retval = 1
				else
					ll_retval = -1
					return ll_retval
				end if
				ll_counter = ll_counter + 1
			loop
		case "item_changedisc"
			do while ll_counter <= ll_rowcount
				ld_saledisc = ad_dwcontrol.getitemdecimal(ll_counter, "saledisc")
				ll_icatcode = ad_dwcontrol.getitemnumber(ll_counter, "icatcode")
				SQL INSERT itemlog SELECT LogDate =:adt_server_datetime , newsaleprice =i.saleprice , stock =( SELECT isnull ( sum ( g.currqty ) , 0 ) FROM godowndetail g WHERE g.icode =i.icode ) , i.*FROM item i WHERE i.icatcode =:ll_icatcode AND i.active =1 USING at_transobject;
				if at_transobject.sqlcode = 0 then
					ll_retval = 1
				else
					ll_retval = -1
					return ll_retval
				end if
				ll_counter = ll_counter + 1
			loop
		case "item_changedisc_manfwise"
			do while ll_counter <= ll_rowcount
				ld_saledisc = ad_dwcontrol.getitemdecimal(ll_counter, "saledisc")
				ll_manfcode = ad_dwcontrol.getitemnumber(ll_counter, "manfcode")
				SQL INSERT itemlog SELECT LogDate =:adt_server_datetime , newsaleprice =i.saleprice , stock =( SELECT isnull ( sum ( g.currqty ) , 0 ) FROM godowndetail g WHERE g.icode =i.icode ) , i.*FROM item i WHERE i.manfcode =:ll_manfcode AND i.active =1 USING at_transobject;
				if at_transobject.sqlcode = 0 then
					ll_retval = 1
				else
					ll_retval = -1
					return ll_retval
				end if
				ll_counter = ll_counter + 1
			loop
		case "item_changedisc_classwise"
			do while ll_counter <= ll_rowcount
				ld_saledisc = ad_dwcontrol.getitemdecimal(ll_counter, "saledisc")
				ll_classcode = ad_dwcontrol.getitemnumber(ll_counter, "iccode")
				SQL INSERT itemlog SELECT LogDate =:adt_server_datetime , newsaleprice =i.saleprice , stock =( SELECT isnull ( sum ( g.currqty ) , 0 ) FROM godowndetail g WHERE g.icode =i.icode ) , i.*FROM item i WHERE i.iccode =:ll_classcode AND i.active =1 USING at_transobject;
				if at_transobject.sqlcode = 0 then
					ll_retval = 1
				else
					ll_retval = -1
					return ll_retval
				end if
				ll_counter = ll_counter + 1
			loop
		case "item_changepurprice_manfwise"
			do while ll_counter <= ll_rowcount
				ll_manfcode = ad_dwcontrol.getitemnumber(ll_counter, "manfcode")
				SQL INSERT itemlog SELECT LogDate =:adt_server_datetime , newsaleprice =i.saleprice , stock =( SELECT isnull ( sum ( g.currqty ) , 0 ) FROM godowndetail g WHERE g.icode =i.icode ) , i.*FROM item i WHERE i.manfcode =:ll_manfcode AND i.active =1 USING at_transobject;
				if at_transobject.sqlcode = 0 then
					ll_retval = 1
				else
					ll_retval = -1
					return ll_retval
				end if
				ll_counter = ll_counter + 1
			loop
		case "item_changedisc_packwise"
			do while ll_counter <= ll_rowcount
				ll_packcode = ad_dwcontrol.getitemnumber(ll_counter, "packcode")
				SQL INSERT itemlog SELECT LogDate =:adt_server_datetime , newsaleprice =i.saleprice , stock =( SELECT isnull ( sum ( g.currqty ) , 0 ) FROM godowndetail g WHERE g.icode =i.icode ) , i.*FROM item i WHERE i.packcode =:ll_packcode AND i.active =1 USING at_transobject;
				if at_transobject.sqlcode = 0 then
					ll_retval = 1
				else
					ll_retval = -1
					return ll_retval
				end if
				ll_counter = ll_counter + 1
			loop
		case "item_avgprice_change"
			do while ll_counter <= ll_rowcount
				ll_code = ad_dwcontrol.getitemnumber(ll_counter, "icode")
				if ad_dwcontrol.getitemstatus(ll_counter, "newsaleprice", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "newpurprice", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "newavgprice", primary!) = datamodified! then
					SQL INSERT itemlog SELECT LogDate =:adt_server_datetime , newsaleprice =i.saleprice , stock =( SELECT isnull ( sum ( g.currqty ) , 0 ) FROM godowndetail g WHERE g.icode =i.icode ) , i.*FROM item i WHERE i.icode =:ll_code USING at_transobject;
					if at_transobject.sqlcode = 0 then
						ll_retval = 1
					else
						ll_retval = -1
						return ll_retval
					end if
					return
				end if
				ll_counter = ll_counter + 1
			loop
			if ll_retval = 0 then
				ll_retval = 1
			end if
		case "item_changesaleprice_frompurchase"
			do while ll_counter <= ll_rowcount
				ll_code = ad_dwcontrol.getitemnumber(ll_counter, "code")
				if ad_dwcontrol.getitemstatus(ll_counter, "saleprice", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "saleprice2", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "saleprice3", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "saleprice4", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "saleprice5", primary!) = datamodified! or ad_dwcontrol.getitemstatus(ll_counter, "retailprice", primary!) = datamodified! then
					SQL INSERT itemlog SELECT LogDate =:adt_server_datetime , newsaleprice =i.saleprice , stock =( SELECT isnull ( sum ( g.currqty ) , 0 ) FROM godowndetail g WHERE g.icode =i.icode ) , i.*FROM item i WHERE i.icode =:ll_code USING at_transobject;
					if at_transobject.sqlcode = 0 then
						ll_retval = 1
					else
						ll_retval = -1
						return ll_retval
					end if
					return
				end if
				ll_counter = ll_counter + 1
			loop
			if ll_retval = 0 then
				ll_retval = 1
			end if
			return ll_retval
		end choose
	end if
	return ll_retval
