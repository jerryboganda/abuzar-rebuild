// function f_getgroupcode (functions)  ancestor: function_object

// f_getgroupcode.vf_getgroupcode(long al_usercode) returns long
	long ll_groupcode
	SQL SELECT MIN ( GroupCode ) INTO :ll_groupcode FROM UserGroups USING sqlca;
	return ll_groupcode

// f_getgroupcode.f_getgroupcode(long al_usercode) returns long
	long ll_groupcode
	SQL SELECT MIN ( GroupCode ) INTO :ll_groupcode FROM UserGroups WHERE UserCode =:al_usercode USING sqlca;
	return ll_groupcode
