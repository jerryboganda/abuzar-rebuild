// function f_set_headerlogo (functions)  ancestor: function_object

// f_set_headerlogo.f_set_headerlogo(datawindow adw_dw, integer ai_headerno) returns long
	string ls_logofilename
	string ls_filename
	string ls_logoexist
	if not isnull(ai_headerno) and ai_headerno > 0 then
		ls_logofilename = ls_filename + trim(string(ai_headerno)) + ".bmp"
	end if
	if (gs_company = "ALHARMAINLIGHTS" or gs_company = "HISKHI" or gs_company = "ALNASEEB" or gs_company = "BOMBAYCHOCNNUTS" or gs_company = "BOMBAYDRYFRUIT" or gs_company = "HASEENSUPERMRKT" or gs_company = "ADCAREPHARMA" or gs_company = "SBMEDICOSKHI" or gs_company = "HDPHARMALITE" or gs_company = "ZAMZAMSTORES" or gs_company = "ZAMZAMSTORES2" or gs_company = "SAFFRON" or gs_company = "ALMAJEEDSTORE" or gs_company = "HAJIDAWOODSTORE" or gs_company = "CELL4U" or gs_company = "SYNAPTICPHARMA" or gs_company = "ADVANCEBUSINESS" or gs_company = "NAFEESASSTORE" or gs_company = "ARAZAQSTORE" or gs_company = "ANGELZCLUB" or gs_company = "DWATSONJEHLUM" or gs_company = "KARACHICOMPUTER" or gs_company = "PARASARTFEVER" or gs_company = "THEFACEPOINT" or gs_company = "THREEGSTORE" or gs_company = "DUHS" or gs_company = "MGPHARMACY" or gs_company = "HEALTHSERVICES" or gs_company = "MOVEANDPICK" or gs_company = "WORLDMART" or gs_company = "MDSSUPERMARKET" or gs_company = "ALAHAD" or gs_company = "SKYPHARMACY" or gs_company = "ZEESHANMEDICOS2" or gs_company = "SKYPHARMACY2" or gs_company = "BAYGPHARMA" or gs_company = "TFSEVEN" or gs_company = "PHARMALINE" or gs_company = "NIZAMWATCH" or gs_company = "WILDWINGS" or gs_company = "PCPLABS") and adw_dw.describe("p_1.filename") <> "!" then
		adw_dw.object.p_1.filename = ls_logofilename
	end if
	return 0
