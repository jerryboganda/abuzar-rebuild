// function f_reporttitle (functions)  ancestor: function_object

// f_reporttitle.f_reporttitle(integer ai_reportid) returns string
	string ls_reporttitle
	SQL Select ReportTitle INTO :ls_reporttitle From ReportTitles Where reportid =:ai_reportid USING sqlca;
	if sqlca.sqlcode = 0 then
		return ls_reporttitle
	end if
	return " "
