// function f_get_alter_bg_color (functions)  ancestor: function_object

// f_get_alter_bg_color.f_get_alter_bg_color(long ai_alertcode) returns long
	long ll_bgcolor
	SQL SELECT BGColor INTO :ll_bgcolor FROM ItemAlert WHERE ItemAlertCode =:ai_alertcode USING sqlca;
	if sqlca.sqlcode = 0 then
		return ll_bgcolor
	end if
	ll_bgcolor = 16777215
	return ll_bgcolor
