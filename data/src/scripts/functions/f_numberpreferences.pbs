// function f_numberpreferences (functions)  ancestor: function_object

// f_numberpreferences.f_numberpreferences(string as_preferencename) returns integer
	long ll_found
	string ls_prefname
	string ls_ret_string
	ls_prefname = lower(trim(as_preferencename))
	ll_found = gds_preferences.find(" lower(name) = '" + ls_prefname + "'", 1, gds_preferences.rowcount())
	if ll_found > 0 and ll_found <= gds_preferences.rowcount() then
		ls_ret_string = trim(gds_preferences.getitemstring(ll_found, "prefvalue"))
	else
		ls_ret_string = ""
	end if
	return integer(ls_ret_string)
