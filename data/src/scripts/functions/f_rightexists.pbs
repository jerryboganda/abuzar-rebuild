// function f_rightexists (functions)  ancestor: function_object

// f_rightexists.f_rightexists(long al_rightcode) returns boolean
	long ll_counter
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = al_rightcode then
			return true
		end if
	next
	ll_counter = 1
	for ll_counter = 1 to gds_security.rowcount()
		if gds_security.object.rightcode[ll_counter] = al_rightcode then
			return true
		end if
	next
	return false
