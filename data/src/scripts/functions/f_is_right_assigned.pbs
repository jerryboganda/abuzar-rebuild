// function f_is_right_assigned (functions)  ancestor: function_object

// f_is_right_assigned.f_is_right_assigned(long al_rightcode) returns long
	long ll_found
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = " + trim(string(al_rightcode)), 1, gds_securitywindow.rowcount())
	return ll_found
