// function f_get_itemalert_background (functions)  ancestor: function_object

// f_get_itemalert_background.f_get_itemalert_background(long al_alerttype) returns long
	long ll_rgb
	if al_alerttype = 1 then
		ll_rgb = rgb(255, 255, 255)
	elseif al_alerttype = 2 then
		ll_rgb = rgb(0, 255, 0)
	elseif al_alerttype = 3 then
		ll_rgb = rgb(255, 255, 0)
	elseif al_alerttype = 4 then
		ll_rgb = rgb(255, 0, 0)
	else
		ll_rgb = rgb(255, 255, 255)
	end if
	return ll_rgb
