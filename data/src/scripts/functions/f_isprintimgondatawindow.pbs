// function f_isprintimgondatawindow (functions)  ancestor: function_object

// f_isprintimgondatawindow.f_isprintimgondatawindow(datawindow adw_print) returns boolean
	boolean lb_return
	lb_return = false
	if gs_company = "NUMAN" and adw_print.dataobject = "d_nauman_wholesaleinvreport_reprint" then
		lb_return = true
	end if
	return lb_return
