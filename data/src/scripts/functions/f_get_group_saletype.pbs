// function f_get_group_saletype (functions)  ancestor: function_object

// f_get_group_saletype.f_get_group_saletype(long ai_usercode) returns long
	integer li_saletypecode
	SQL SELECT Min ( SaleTypeCode ) INTO :li_saletypecode FROM Groups WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:ai_usercode ) USING sqlca;
	return li_saletypecode
