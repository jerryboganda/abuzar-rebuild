// function padzeros (functions)  ancestor: function_object

// padzeros.padzeros(integer value, integer total_width) returns string
	string zeros
	string paded_string
	integer no_of_zeros
	integer i
	no_of_zeros = total_width - len(string(value))
	for i = 1 to no_of_zeros
		zeros = zeros + "0"
	next
	paded_string = zeros + string(value)
	return paded_string
