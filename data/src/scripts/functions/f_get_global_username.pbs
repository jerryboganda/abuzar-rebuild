// function f_get_global_username (functions)  ancestor: function_object

// f_get_global_username.f_get_global_username() returns string
	string ls_username
	SQL SELECT UserName INTO :ls_username FROM DBO.Users WHERE UserCode =:gl_usercode USING sqlca;
	if sqlca.sqlcode <> 0 then
		ls_username = ""
	end if
	if isnull(ls_username) then
		ls_username = ""
	end if
	return ls_username
