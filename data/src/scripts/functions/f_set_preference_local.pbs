// function f_set_preference_local (functions)  ancestor: function_object

// f_set_preference_local.f_set_preference_local(datawindow adw_dw, string as_prefname, string as_prefvalue) returns long
	long ll_found
	string ls_prefname
	ls_prefname = lower(as_prefname)
	ll_found = adw_dw.find("lower(name) = '" + ls_prefname + "'", 1, adw_dw.rowcount())
	if ll_found > 0 and ll_found <= adw_dw.rowcount() then
		adw_dw.object.prefvalue[ll_found] = trim(as_prefvalue)
		adw_dw.object.prefvalue2[ll_found] = trim(as_prefvalue)
	end if
	return 0
