// function f_gen_morovia_qrcode (functions)  ancestor: function_object

// f_gen_morovia_qrcode.f_gen_morovia_qrcode(string as_info, long al_version, long al_level) returns unsignedlong
	string ls_code
	string ls_eol
	string ls_qrcode
	string ls_fname = "qrcode.bmp"
	blob blb_qrcode
	ls_code = as_info
	ls_eol = char(13) + char(10)
	if fileexists(ls_fname) then
		filedelete(ls_fname)
	end if
	paintqrcodeimageraster(qrcodeencode2(ls_code, al_version, al_level), ls_fname, 3, 0, 16777215, 4)
	return 0
