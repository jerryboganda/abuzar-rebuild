// function f_printbarcode_ranams (barcodefunctions)  ancestor: function_object

// f_printbarcode_ranams.f_printbarcode_ranams(datawindow id_master, datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_itemname2
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_packing
	string ls_expdate
	string ls_expiry
	string ls_mfg
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_date = "PD:" + trim(string(today(), "dd-mm-yy"))
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if upper(ls_printer) = "TSC TTP-244 PRO" then
		ls_format = id_master.object.labelformat[1]
		ll_supply_cols_per_row = 2
		ll_labelno = 1
		if ll_totalrows > 0 then
			ll_counter = 1
			tsc_openport_new("TSC TTP-244 PRO")
			tsc_setup_new("80", "26", "4", "8", "0", "0", "0")
			tsc_sendcommand_new("GAP 2 mm, 0 mm")
			tsc_sendcommand_new("SPEED 4")
			tsc_sendcommand_new("DENSITY 7")
			tsc_sendcommand_new("DIRECTION 1,0")
			for ll_counter = 1 to ll_totalrows
				if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 25)
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					if ib_printprice then
						ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
					else
						ls_price = ""
					end if
					ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
					ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
					if isnull(ls_mfg) then
						ls_mfg = ""
					end if
					if isnull(ls_expiry) then
						ls_expiry = ""
					end if
					if len(ls_mfg) > 0 then
						ls_expiry = ls_mfg + space(2) + ls_expiry
					end if
					tsc_clearbuffer_new()
					ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
					tsc_windowsfont_new(15, 5, 25, 0, 2, 0, "Arial", ls_clientname)
					tsc_barcode_new("15", "39", "128", "85", "0", "0", "2", "3", ls_aliasname)
					tsc_windowsfont_new(15, 126, 25, 0, 2, 0, "arial", ls_aliasname)
					tsc_windowsfont_new(15, 150, 20, 0, 2, 0, "Arial", left(ls_itemname, 28))
					tsc_windowsfont_new(15, 170, 35, 0, 2, 0, "Arial", ls_price)
					tsc_windowsfont_new(340, 5, 25, 0, 2, 0, "Arial", ls_clientname)
					tsc_barcode_new("340", "39", "128", "85", "0", "0", "2", "3", ls_aliasname)
					tsc_windowsfont_new(340, 126, 25, 0, 2, 0, "arial", ls_aliasname)
					tsc_windowsfont_new(340, 150, 20, 0, 2, 0, "Arial", left(ls_itemname, 28))
					tsc_windowsfont_new(340, 170, 35, 0, 2, 0, "Arial", ls_price)
					tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
				end if
			next
			tsc_closeport_new()
		end if
	elseif lower(ls_printer) = lower("Gprinter GP-3120T") then
		ls_format = id_master.object.labelformat[1]
		ll_supply_cols_per_row = 2
		ll_labelno = 1
		if ll_totalrows > 0 then
			ll_counter = 1
			tsc_openport_new("Gprinter GP-3120T'")
			tsc_setup_new("80", "26", "4", "8", "0", "0", "0")
			tsc_sendcommand_new("GAP 2 mm, 0 mm")
			tsc_sendcommand_new("SPEED 4")
			tsc_sendcommand_new("DENSITY 7")
			tsc_sendcommand_new("DIRECTION 1,0")
			for ll_counter = 1 to ll_totalrows
				if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 25)
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					if ib_printprice then
						ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
					else
						ls_price = ""
					end if
					ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
					ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
					if isnull(ls_mfg) then
						ls_mfg = ""
					end if
					if isnull(ls_expiry) then
						ls_expiry = ""
					end if
					if len(ls_mfg) > 0 then
						ls_expiry = ls_mfg + space(2) + ls_expiry
					end if
					tsc_clearbuffer_new()
					ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
					tsc_windowsfont_new(15, 5, 25, 0, 2, 0, "Arial", ls_clientname)
					tsc_barcode_new("15", "39", "128", "85", "0", "0", "2", "3", ls_aliasname)
					tsc_windowsfont_new(15, 126, 25, 0, 2, 0, "arial", ls_aliasname)
					tsc_windowsfont_new(15, 150, 20, 0, 2, 0, "Arial", left(ls_itemname, 28))
					tsc_windowsfont_new(15, 170, 35, 0, 2, 0, "Arial", ls_price)
					tsc_windowsfont_new(340, 5, 25, 0, 2, 0, "Arial", ls_clientname)
					tsc_barcode_new("340", "39", "128", "85", "0", "0", "2", "3", ls_aliasname)
					tsc_windowsfont_new(340, 126, 25, 0, 2, 0, "arial", ls_aliasname)
					tsc_windowsfont_new(340, 150, 20, 0, 2, 0, "Arial", left(ls_itemname, 28))
					tsc_windowsfont_new(340, 170, 35, 0, 2, 0, "Arial", ls_price)
					tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
				end if
			next
			tsc_closeport_new()
		end if
	end if
	return 0
