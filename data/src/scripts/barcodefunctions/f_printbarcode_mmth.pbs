// function f_printbarcode_mmth (barcodefunctions)  ancestor: function_object

// f_printbarcode_mmth.f_printbarcode_mmth(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_packing
	string ls_expdate
	string ls_expiry
	string ls_mfg
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_date = trim(string(today(), "dd-mm-yyyy"))
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if upper(ls_printer) = "TSC TTP-244 PRO" then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PRO")
				tsc_setup_new("28", "19", "5", "12", "0", "2", "0")
				tsc_sendcommand_new("DIRECTION 1,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						ls_infocode = ""
						ls_date = ""
						if id_master.rowcount() > 0 then
							ls_infocode = string(id_master.object.code[1])
							if isnull(ls_infocode) then
								ls_infocode = ""
							end if
							ls_date = string(id_master.object.date[1], "dd/mm/yy")
							if isnull(ls_date) then
								ls_date = string(today(), "dd/mm/yy")
							end if
						end if
						if ls_infocode <> "" then
							ls_infocode = "#: " + ls_infocode
						end if
						if isnull(ls_mfg) then
							ls_mfg = ""
						end if
						if isnull(ls_expiry) then
							ls_expiry = ""
						end if
						if len(ls_mfg) > 0 then
							ls_expiry = ls_mfg + space(2) + ls_expiry
						end if
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
						tsc_clearbuffer_new()
						tsc_windowsfont_new(10, 10, 25, 0, 2, 0, "Arial", left(ls_itemname, 16))
						tsc_windowsfont_new(10, 29, 25, 0, 2, 0, "Arial", mid(ls_itemname, 17, 16))
						tsc_barcode_new("10", "50", "128", "55", "1", "0", "2", "3", ls_aliasname)
						tsc_windowsfont_new(10, 126, 22, 0, 2, 0, "Arial", ls_infocode)
						tsc_windowsfont_new(140, 126, 22, 0, 2, 0, "Arial", ls_date)
						tsc_printlabel_new("1", string(ll_qty))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "2" then
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PRO")
				tsc_setup_new("28", "19", "5", "12", "0", "2", "0")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						if isnull(ls_mfg) then
							ls_mfg = ""
						end if
						if isnull(ls_expiry) then
							ls_expiry = ""
						end if
						if len(ls_mfg) > 0 then
							ls_expiry = ls_mfg + space(2) + ls_expiry
						end if
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
						tsc_clearbuffer_new()
						tsc_windowsfont_new(10, 10, 18, 0, 2, 0, "Arial", ls_clientname)
						tsc_barcode_new("10", "30", "128", "40", "0", "0", "2", "3", ls_aliasname)
						tsc_windowsfont_new(10, 71, 20, 0, 2, 0, "Arial", ls_aliasname)
						tsc_windowsfont_new(10, 89, 18, 0, 2, 0, "Arial", left(ls_itemname, 22))
						tsc_windowsfont_new(10, 107, 18, 0, 2, 0, "Arial", mid(ls_itemname, 23, 22))
						tsc_windowsfont_new(10, 125, 25, 0, 2, 0, "Arial", ls_price)
						tsc_printlabel_new("1", string(ll_qty))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "3" then
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PRO")
				tsc_setup_new("28", "19", "5", "12", "0", "2", "0")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						if isnull(ls_mfg) then
							ls_mfg = ""
						end if
						if isnull(ls_expiry) then
							ls_expiry = ""
						end if
						if len(ls_mfg) > 0 then
							ls_expiry = ls_mfg + space(2) + ls_expiry
						end if
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
						tsc_clearbuffer_new()
						tsc_windowsfont_new(10, 10, 18, 0, 2, 0, "Arial", ls_clientname)
						tsc_barcode_new("10", "30", "128", "40", "0", "0", "2", "3", ls_aliasname)
						tsc_windowsfont_new(10, 71, 20, 0, 2, 0, "Arial", ls_aliasname)
						tsc_windowsfont_new(10, 89, 18, 0, 2, 0, "Arial", left(ls_itemname, 28))
						tsc_windowsfont_new(10, 108, 17, 0, 2, 0, "Arial", ls_expiry)
						tsc_windowsfont_new(10, 124, 25, 0, 2, 0, "Arial", ls_price)
						tsc_printlabel_new("1", string(ll_qty))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "4" then
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PRO")
				tsc_setup_new("28", "19", "5", "12", "0", "3", "0")
				tsc_sendcommand_new("DIRECTION 1,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						if isnull(ls_mfg) then
							ls_mfg = ""
						end if
						if isnull(ls_expiry) then
							ls_expiry = ""
						end if
						if len(ls_mfg) > 0 then
							ls_expiry = ls_mfg + space(2) + ls_expiry
						end if
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
						tsc_clearbuffer_new()
						tsc_windowsfont_new(10, 15, 25, 0, 2, 0, "Arial", left(ls_itemname, 16))
						tsc_windowsfont_new(10, 35, 25, 0, 2, 0, "Arial", mid(ls_itemname, 17, 16))
						tsc_barcode_new("10", "60", "128", "60", "1", "0", "2", "3", ls_aliasname)
						tsc_printlabel_new("1", string(ll_qty))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "5" then
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PRO")
				tsc_setup_new("28", "19", "5", "12", "0", "3", "0")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						if isnull(ls_mfg) then
							ls_mfg = ""
						end if
						if isnull(ls_expiry) then
							ls_expiry = ""
						end if
						if len(ls_mfg) > 0 then
							ls_expiry = ls_mfg + space(2) + ls_expiry
						end if
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
						tsc_clearbuffer_new()
						tsc_windowsfont_new(10, 10, 18, 0, 2, 0, "Arial", ls_clientname)
						tsc_barcode_new("10", "30", "128", "40", "0", "0", "2", "3", ls_aliasname)
						tsc_windowsfont_new(10, 71, 20, 0, 2, 0, "Arial", ls_aliasname)
						tsc_windowsfont_new(10, 89, 18, 0, 2, 0, "Arial", left(ls_itemname, 22))
						tsc_windowsfont_new(10, 107, 18, 0, 2, 0, "Arial", mid(ls_itemname, 23, 22))
						tsc_windowsfont_new(10, 125, 25, 0, 2, 0, "Arial", ls_price)
						tsc_printlabel_new("1", string(ll_qty))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "6" and ll_totalrows > 0 then
			ll_counter = 1
			tsc_openport_new("TSC TTP-244 PRO")
			tsc_setup_new("28", "19", "5", "12", "0", "3", "0")
			tsc_sendcommand_new("DIRECTION 0,0")
			tsc_sendcommand_new("REFERENCE 0,0")
			tsc_sendcommand_new("OFFSET 0 mm")
			tsc_sendcommand_new("SHIFT 0")
			for ll_counter = 1 to ll_totalrows
				if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
					ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
					if isnull(ls_mfg) then
						ls_mfg = ""
					end if
					if isnull(ls_expiry) then
						ls_expiry = ""
					end if
					if len(ls_mfg) > 0 then
						ls_expiry = ls_mfg + space(2) + ls_expiry
					end if
					if ib_printprice then
						ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
					else
						ls_price = ""
					end if
					ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
					tsc_clearbuffer_new()
					tsc_windowsfont_new(10, 10, 18, 0, 2, 0, "Arial", ls_clientname)
					tsc_barcode_new("10", "30", "128", "40", "0", "0", "2", "3", ls_aliasname)
					tsc_windowsfont_new(10, 71, 20, 0, 2, 0, "Arial", ls_aliasname)
					tsc_windowsfont_new(10, 89, 18, 0, 2, 0, "Arial", left(ls_itemname, 28))
					tsc_windowsfont_new(10, 108, 17, 0, 2, 0, "Arial", ls_expiry)
					tsc_windowsfont_new(10, 124, 25, 0, 2, 0, "Arial", ls_price)
					tsc_printlabel_new("1", string(ll_qty))
				end if
			next
			tsc_closeport_new()
		end if
	end if
	return 0
