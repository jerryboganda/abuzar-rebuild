// function f_printbarcode_zebra_tlp_2844z (barcodefunctions)  ancestor: function_object

// f_printbarcode_zebra_tlp_2844z.f_printbarcode_zebra_tlp_2844z(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	long ll_job
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	integer li_file2
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_itemname2
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_contents
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if lower(ls_printer) = lower("Zebra TLP 2844z") then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
			if li_file = -1 then
				messagebox("Error", "Unable to locate file for Label printing")
				return 0
			else
				ls_filecontent = ""
				filewrite(li_file, ls_filecontent)
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "CT~~CD,~~CC^~~CT~~"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^XA~~TA000~~JSN^LT0^MNW^MTT^PON^PMN^LH0,0^JMA^PR8,8~~SD15^JUS^LRN^CI0^XZ"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^MMT"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^PW416"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^LL0320"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^LS0"
				filewrite(li_file, ls_filecontent)
				for ll_counter = 1 to ll_totalrows
					if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs.: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						ls_filecontent = "^XA"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FT415,277^A0I,35,30^FH\^FD" + trim(ls_clientname) + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^BY2,2^FT415,151^BCI,112,Y,N,N,A"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FD" + ls_aliasname + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FT415,93^A0I,27,26^FH\^FD" + left(ls_itemname, 35) + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FT415,63^A0I,27,26^FH\^FD" + mid(ls_itemname, 36, 35) + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FT415,20^A0I,52,57^FH\^FD" + ls_price + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^PQ" + trim(string(ll_qty)) + ",0,1,N^XZ"
						filewrite(li_file, ls_filecontent)
					end if
				next
				fileclose(li_file)
				li_file2 = fileopen("label.prn", textmode!, read!, lockread!)
				if li_file2 = -1 then
					messagebox("Error", "Unable to locate file for Label printing")
					return 0
				else
					filereadex(li_file2, ls_contents)
					fileclose(li_file2)
					printsetprinter("Zebra TLP 2844z")
					ll_job = printopen("waseela", false)
					if ll_job = -1 then
						messagebox("Error", "Unable to Open Print Job for Label printing")
					else
						printsend(ll_job, ls_contents)
						printclose(ll_job)
					end if
				end if
			end if
		elseif ls_format = "2" and ll_totalrows > 0 then
			ll_counter = 1
			li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
			if li_file = -1 then
				messagebox("Error", "Unable to locate file for Label printing")
			else
				ll_supply_cols_per_row = 2
				ls_filecontent = ""
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "CT~~CD,~~CC^~~CT~~"
				filewrite(li_file, ls_filecontent)
				filewrite(li_file, "^XA~~TA000~~JSN^LT0^MNW^MTD^PON^PMN^LH0,0^JMA^PR4,4^SD15^JUS^LRN^CI0^XZ")
				ll_labelno = 1
				for ll_counter = 1 to ll_totalrows
					if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 25)
						ls_itemname2 = mid(trim(id_detail.getitemstring(ll_counter, "itemname")), 26, 25)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), 12)
						if ib_printprice then
							ls_price = trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						for ll_innercounter = 1 to ll_qty
							ll_labelpos = ll_labelno mod ll_supply_cols_per_row
							if ll_labelpos = 1 then
								filewrite(li_file, "^XA")
								filewrite(li_file, "^MMT")
								filewrite(li_file, "^PW607")
								filewrite(li_file, "^LL0224")
								filewrite(li_file, "^LS0")
								ls_xpos = "600"
							else
								ls_xpos = "285"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",188^A0I,28,26^FH\^FD" + trim(ls_clientname) + "^FS"
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "^BY2,3,65^FT" + ls_xpos + ",116^BCI,,Y,N"
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "^FD" + ls_aliasname + "^FS"
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "^FT" + ls_xpos + ",76^A0I,18,19^FH\^FD" + ls_itemname + "^FS"
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "^FT" + ls_xpos + ",49^A0I,18,19^FH\^FD" + ls_itemname2 + "^FS"
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "^FT" + ls_xpos + ",14^A0I,28,33^FH\^FDRs.: " + ls_price + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 0 then
								filewrite(li_file, "^PQ1,0,1,Y^XZ")
							end if
							ll_labelno = ll_labelno + 1
						next
					end if
				next
				if ll_labelpos > 0 then
					filewrite(li_file, "^PQ1,0,1,Y^XZ")
				end if
				fileclose(li_file)
				li_file2 = fileopen("label.prn", textmode!, read!, lockread!)
				if li_file2 = -1 then
					messagebox("Error", "Unable to locate file for Label printing")
					return 0
				else
					filereadex(li_file2, ls_contents)
					fileclose(li_file2)
					printsetprinter("Zebra TLP 2844z")
					ll_job = printopen("waseela", false)
					if ll_job = -1 then
						messagebox("Error", "Unable to Open Print Job for Label printing")
					else
						printsend(ll_job, ls_contents)
						printclose(ll_job)
					end if
				end if
			end if
		end if
	end if
	return 0
