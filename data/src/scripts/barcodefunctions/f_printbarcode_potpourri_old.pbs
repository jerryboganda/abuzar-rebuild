				else
					setnull(ll_purinvcode)
					ls_date = string(today(), "yymmdd")
				end if
				ls_date = mid(ls_date, 2, 1) + left(ls_date, 1) + right(ls_date, 4)
				for ll_counter = 1 to ll_totalrows
					if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "remarks")), 26)
						ls_itemname2 = mid(trim(id_detail.getitemstring(ll_counter, "remarks")), 27, 26)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs: " + trim(string(long(id_detail.getitemdecimal(ll_counter, "salepriceforitem")), "###,###,##0"))
						else
							ls_price = ""
						end if
						for ll_innercounter = 1 to ll_qty
							ll_labelpos = ll_labelno mod ll_supply_cols_per_row
							if ll_labelpos = 1 then
								filewriteex(li_file, "^XA^LL0152")
								filewriteex(li_file, "^PW719")
							end if
							if ll_labelpos = 1 then
								ls_xpos = "16"
							elseif ll_labelpos = 2 then
								ls_xpos = "255"
							elseif ll_labelpos = 0 then
								ls_xpos = "495"
							end if
							if gs_company = "PP" or gs_company = "POTPOURRIWHOUSE" or gs_company = "PP2" or gs_company = "PP3" then
								ls_filecontent = "^FT" + ls_xpos + ",30^A0N,17,16^FH\^FD" + ls_supp_alias + space(10 - len(ls_aliasname) + 5) + ls_aliasname + "" + "^FS"
							end if
							filewriteex(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "16"
							elseif ll_labelpos = 2 then
								ls_xpos = "255"
							elseif ll_labelpos = 0 then
								ls_xpos = "495"
							end if
							ls_filecontent = "^BY2,2,50^FT" + ls_xpos + ",82^B3N,N,,N,N"
							filewriteex(li_file, ls_filecontent)
							filewriteex(li_file, "^FD" + ls_aliasname + "^FS")
							if ll_labelpos = 1 then
								ls_xpos = "16"
							elseif ll_labelpos = 2 then
								ls_xpos = "255"
							elseif ll_labelpos = 0 then
								ls_xpos = "495"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",98^A0N,14,14^FH\^FD" + ls_itemname + "^FS"
							filewriteex(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "16"
							elseif ll_labelpos = 2 then
								ls_xpos = "255"
							elseif ll_labelpos = 0 then
								ls_xpos = "495"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",113^A0N,14,14^FH\^FD" + ls_itemname2 + "^FS"
							filewriteex(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "16"
							elseif ll_labelpos = 2 then
								ls_xpos = "255"
							elseif ll_labelpos = 0 then
								ls_xpos = "495"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",141^A0N,26,33^FH\^FD" + ls_price + "^FS"
							filewriteex(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "148"
							elseif ll_labelpos = 2 then
								ls_xpos = "388"
							elseif ll_labelpos = 0 then
								ls_xpos = "625"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",155^A0N,15,21^FH\^FD" + ls_date + "^FS"
							filewriteex(li_file, ls_filecontent)
							if ll_labelpos = 0 then
								filewriteex(li_file, "^PQ1,0,1,Y^XZ")
							end if
							ll_labelno = ll_labelno + 1
						next
					end if
				next
			elseif ls_format = "2" then
				ll_supply_cols_per_row = 3
				filewriteex(li_file, "^XATA000JSB^LT0^MMT^MNW^MTT^PON^PMN^LH0,0^JMA^PR6,6^MD10^JUS^LRN^CI0^XZ")
