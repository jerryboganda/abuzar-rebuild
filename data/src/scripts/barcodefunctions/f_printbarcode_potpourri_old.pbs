							ls_filecontent = "^BY2,3,81^FT" + ls_xpos + ",130^BCN,,Y,N"
							filewriteex(li_file, ls_filecontent)
							filewriteex(li_file, "^FD" + ls_aliasname + "^FS")
							if ll_labelpos = 1 then
								ls_xpos = "22"
							else
								ls_xpos = "350"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",175^A0N,23,21^FH\^FD" + ls_itemname + "^FS"
							filewriteex(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "22"
							else
								ls_xpos = "350"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",209^A0N,24,43^FH\^FD" + ls_price + "^FS"
							filewriteex(li_file, ls_filecontent)
							if ll_labelpos = 0 then
								filewriteex(li_file, "^PQ1,0,1,Y^XZ")
							end if
							ll_labelno = ll_labelno + 1
						next
					end if
				next
			elseif ls_format = "4" then
				ll_supply_cols_per_row = 2
				filewriteex(li_file, "^XATA000JSN^LT0^MMT^MNW^MTT^PON^PMN^LH0,0^JMA^PR4,4^MD8^JUS^LRN^CI0^XZ")
				ll_labelno = 1
				for ll_counter = 1 to ll_totalrows
					if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "remarks")), 50)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), 17)
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "salepriceforitem"), 2)))
						else
							ls_price = ""
						end if
						for ll_innercounter = 1 to ll_qty
							ll_labelpos = ll_labelno mod ll_supply_cols_per_row
							if ll_labelpos = 1 then
								filewriteex(li_file, "^XA^LL0230")
								filewriteex(li_file, "^PW643")
							end if
							if ll_labelpos = 1 then
								ls_xpos = "22"
							else
								ls_xpos = "350"
							end if
							if isnull(ls_supp_alias) or ls_supp_alias = "" then
								ls_filecontent = "^FT" + ls_xpos + ",44^A0N,31,24^FH\^FD" + "POTPOURRI" + "^FS"
							else
								ls_filecontent = "^FT" + ls_xpos + ",44^A0N,31,24^FH\^FD" + "POTPOURRI  (" + ls_supp_alias + ")" + "^FS"
							end if
							filewriteex(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "29"
							else
								ls_xpos = "357"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",96^A0N,41,31^FH\^FD" + ls_aliasname + "^FS"
							filewriteex(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "22"
							else
								ls_xpos = "350"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",136^A0N,24,21^FH\^FD" + left(ls_itemname, 25) + "^FS"
							filewriteex(li_file, ls_filecontent)
							ls_filecontent = "^FT" + ls_xpos + ",166^A0N,24,21^FH\^FD" + mid(ls_itemname, 26, 25) + "^FS"
							filewriteex(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "23"
							else
								ls_xpos = "351"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",209^A0N,33,40^FH\^FD" + ls_price + "^FS"
							filewriteex(li_file, ls_filecontent)
							if ll_labelpos = 0 then
								filewriteex(li_file, "^PQ1,0,1,Y^XZ")
							end if
							ll_labelno = ll_labelno + 1
						next
					end if
				next
			end if
			if ll_labelpos > 0 then
				filewriteex(li_file, "^PQ1,0,1,Y^XZ")
			end if
			fileclose(li_file)
			run("..\BarcodePrint\BP.bat", normal!)
		end if
	end if
	return 0
