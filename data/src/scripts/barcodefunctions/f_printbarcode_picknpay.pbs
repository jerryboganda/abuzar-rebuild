// function f_printbarcode_picknpay (barcodefunctions)  ancestor: function_object

// f_printbarcode_picknpay.f_printbarcode_picknpay(datawindow id_master, datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_packing
	string ls_expdate
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	datetime ldt_expiry
	ls_seperator = ";"
	ls_date = "PD:" + trim(string(today(), "dd-mm-yy"))
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 21)
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if upper(ls_printer) = "TSC TTP-244 PRO" then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			ll_supply_cols_per_row = 3
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PRO")
				tsc_setup_new("89.6", "19.1", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER ON")
				tsc_sendcommand_new("SET TEAR ON")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_barcode_new("700", "85", "128", "28", "0", "180", "2", "3", ls_aliasname)
						tsc_barcode_new("462", "85", "128", "28", "0", "180", "2", "3", ls_aliasname)
						tsc_barcode_new("222", "85", "128", "28", "0", "180", "2", "3", ls_aliasname)
						tsc_printerfont_new("700", "56", "0", "180", "6", "5", ls_aliasname)
						tsc_printerfont_new("462", "56", "0", "180", "6", "5", ls_aliasname)
						tsc_printerfont_new("222", "56", "0", "180", "6", "5", ls_aliasname)
						tsc_printerfont_new("700", "41", "0", "180", "5", "5", left(ls_itemname, 27))
						tsc_printerfont_new("462", "41", "0", "180", "5", "5", left(ls_itemname, 27))
						tsc_printerfont_new("222", "41", "0", "180", "5", "5", left(ls_itemname, 27))
						tsc_printerfont_new("700", "30", "0", "180", "5", "5", mid(ls_itemname, 28, 27))
						tsc_printerfont_new("462", "30", "0", "180", "5", "5", mid(ls_itemname, 28, 27))
						tsc_printerfont_new("222", "30", "0", "180", "5", "5", mid(ls_itemname, 28, 27))
						tsc_printerfont_new("700", "17", "0", "180", "10", "6", ls_price)
						tsc_printerfont_new("462", "17", "0", "180", "10", "6", ls_price)
						tsc_printerfont_new("222", "17", "0", "180", "10", "6", ls_price)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "2" then
			ll_supply_cols_per_row = 2
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PRO")
				tsc_setup_new("76.10", "28.7", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER ON")
				tsc_sendcommand_new("SET TEAR ON")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_barcode_new("604", "150", "128", "50", "1", "180", "2", "3", ls_aliasname)
						tsc_barcode_new("278", "150", "128", "50", "1", "180", "2", "3", ls_aliasname)
						tsc_printerfont_new("604", "74", "0", "180", "8", "6", left(ls_itemname, 25))
						tsc_printerfont_new("278", "74", "0", "180", "8", "6", left(ls_itemname, 25))
						tsc_printerfont_new("604", "58", "0", "180", "8", "6", mid(ls_itemname, 26, 25))
						tsc_printerfont_new("278", "58", "0", "180", "8", "6", mid(ls_itemname, 26, 25))
						tsc_printerfont_new("604", "42", "0", "180", "11", "11", ls_price)
						tsc_printerfont_new("278", "42", "0", "180", "11", "11", ls_price)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "3" and ll_totalrows > 0 then
			ll_counter = 1
			tsc_openport_new("TSC TTP-244 PRO")
			tsc_setup_new("38.1", "28.57", "5", "12", "0", "3", "0")
			for ll_counter = 1 to ll_totalrows
				if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					if ib_printprice then
						ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
					else
						ls_price = ""
					end if
					ldt_expiry = id_detail.object.expiry[ll_counter]
					ls_date = "BB " + trim(string(ldt_expiry, "mmm-yyyy"))
					ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
					tsc_clearbuffer_new()
					tsc_barcode_new("12", "50", "128", "60", "0", "0", "2", "3", ls_aliasname)
					tsc_windowsfont_new(12, 113, 25, 0, 2, 0, "arial", ls_aliasname)
					tsc_windowsfont_new(12, 138, 22, 0, 2, 0, "Arial", left(ls_itemname, 26))
					tsc_windowsfont_new(12, 163, 30, 0, 2, 0, "Arial", ls_price)
					tsc_windowsfont_new(12, 195, 22, 0, 2, 0, "Arial", ls_date)
					tsc_printlabel_new("1", string(ll_qty))
				end if
			next
			tsc_closeport_new()
		end if
	end if
	return 0
