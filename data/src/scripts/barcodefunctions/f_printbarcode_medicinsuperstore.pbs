				else
					filereadex(li_file2, ls_contents)
					fileclose(li_file2)
					printsetprinter("Zebra ZM 400 (200dpi)")
					ll_job = printopen("waseela", false)
					if ll_job = -1 then
						messagebox("Error", "Unable to Open Print Job for Label printing")
					else
						printsend(ll_job, ls_contents)
						printclose(ll_job)
					end if
				end if
			end if
		end if
	elseif ls_printer = "TSC TTP/TDP-243M(244ME)" and ll_totalrows > 0 then
		ll_counter = 1
		tsc_openport_new("TSC TTP/TDP-243M(244ME)")
		tsc_setup_new("38.1", "28.57", "8", "7", "0", "3.04", "0")
		tsc_formfeed_new()
		for ll_counter = 1 to ll_totalrows
			if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
				ll_qty = id_detail.getitemnumber(ll_counter, "qty")
				ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 30)
				ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), 15)
				if ib_printprice then
					ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
				else
					ls_price = ""
				end if
				tsc_clearbuffer_new()
				tsc_printerfont_new("12", "14", "2", "0", "1", "1", ls_clientname)
				tsc_barcode_new("12", "45", "128", "100", "0", "0", "2", "3", ls_aliasname)
				tsc_windowsfont_new(12, 155, 25, 0, 0, 0, "arial", ls_aliasname)
				tsc_windowsfont_new(12, 180, 20, 0, 2, 0, "arial", ls_itemname)
				tsc_windowsfont_new(12, 200, 30, 0, 0, 0, "arial", ls_price)
				tsc_printlabel_new("1", string(ll_qty))
			end if
		next
		tsc_closeport_new()
	end if
	return 0
