// function f_printbarcode_medicinsuperstore (barcodefunctions)  ancestor: function_object

// f_printbarcode_medicinsuperstore.f_printbarcode_medicinsuperstore(datawindow id_master, datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	long ll_job
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	integer li_file2
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_contents
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_mfg
	string ls_manufphone
	string ls_expiry
	string ls_manufaddress
	string ls_packedby
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 21)
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ls_clientname = "FAMILY SUPER STORE"
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if ls_printer = "TSC ME240" then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC ME240")
				tsc_setup_new("35", "19", "8", "7", "0", "3", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER ON")
				tsc_sendcommand_new("SET TEAR ON")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				tsc_formfeed_new()
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 30)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						tsc_windowsfont_new(18, 6, 22, 0, 2, 0, "arial", ls_clientname)
						tsc_barcode_new("18", "28", "128", "35", "0", "0", "2", "3", ls_aliasname)
						tsc_windowsfont_new(18, 63, 20, 0, 2, 0, "arial", ls_aliasname)
						tsc_windowsfont_new(18, 80, 20, 0, 2, 0, "arial", left(ls_itemname, 20))
						tsc_windowsfont_new(18, 98, 20, 0, 2, 0, "arial", mid(ls_itemname, 21, 20))
						tsc_windowsfont_new(18, 113, 30, 0, 2, 0, "arial", ls_price)
						tsc_printlabel_new("1", string(ll_qty))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "2" and ll_totalrows > 0 then
			ll_counter = 1
			tsc_openport_new("TSC ME240")
			tsc_sendcommand_new("SIZE 60 mm, 40 mm")
			tsc_sendcommand_new("GAP 3 mm, 0 mm")
			tsc_sendcommand_new("SPEED 7")
			tsc_sendcommand_new("DENSITY 10")
			tsc_sendcommand_new("DIRECTION 0,0")
			tsc_sendcommand_new("REFERENCE 0,0")
			tsc_sendcommand_new("OFFSET 0 mm")
			tsc_sendcommand_new("SHIFT 0")
			tsc_sendcommand_new("SET PEEL OFF")
			tsc_sendcommand_new("SET CUTTER ON")
			tsc_sendcommand_new("SET TEAR ON")
			tsc_sendcommand_new("CLS")
			tsc_sendcommand_new("CODEPAGE 850")
			tsc_formfeed_new()
			for ll_counter = 1 to ll_totalrows
				if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					if ib_printprice then
						ls_price = "Rs.: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
					else
						ls_price = ""
					end if
					ls_mfg = "Mfg.:" + string(id_detail.object.manfdate[ll_counter], "dd-mmm-yyyy")
					if isnull(ls_mfg) then
						ls_mfg = ""
					end if
					ls_expiry = "Exp.:" + string(id_detail.object.expiry[ll_counter], "dd-mmm-yyyy")
					if isnull(ls_expiry) then
						ls_expiry = ""
					end if
					if len(ls_mfg) > 0 then
						ls_expiry = ls_mfg + ", " + ls_expiry
					end if
					ls_manufshortname = trim(id_detail.getitemstring(ll_counter, "ManufShortName"))
					ls_manufaddress = trim(id_detail.getitemstring(ll_counter, "ManufAddress"))
					ls_manufphone = trim(id_detail.getitemstring(ll_counter, "manufphone"))
					if isnull(ls_manufshortname) or ls_manufshortname = "" then
						ls_manufshortname = ""
					else
						ls_manufshortname = "Mfg. By:" + ls_manufshortname
					end if
					if isnull(ls_manufaddress) or ls_manufaddress = "" then
						ls_manufaddress = ""
					else
						ls_manufaddress = "Address:" + ls_manufaddress
					end if
					if isnull(ls_manufphone) or ls_manufphone = "" then
						ls_manufphone = ""
					else
						ls_manufphone = "Phone No:" + ls_manufphone
					end if
					ls_packedby = "Packed By: " + ls_clientname
					tsc_clearbuffer_new()
					tsc_windowsfont_new(20, 15, 40, 0, 2, 0, "Arial", ls_clientname)
					tsc_barcode_new("20", "52", "128", "70", "1", "0", "2", "3", ls_aliasname)
					tsc_windowsfont_new(20, 145, 30, 0, 2, 0, "Arial", left(ls_itemname, 30))
					tsc_windowsfont_new(20, 172, 25, 0, 2, 0, "Arial", ls_expiry)
					tsc_windowsfont_new(20, 192, 25, 0, 2, 0, "Arial", ls_manufshortname)
					tsc_windowsfont_new(20, 212, 25, 0, 2, 0, "Arial", ls_manufaddress)
					tsc_windowsfont_new(20, 232, 25, 0, 2, 0, "Arial", ls_manufphone)
					tsc_windowsfont_new(20, 252, 25, 0, 2, 0, "Arial", ls_packedby)
					tsc_windowsfont_new(20, 270, 50, 0, 2, 0, "Arial", ls_price)
					tsc_printlabel_new("1", string(ll_qty))
				end if
			next
			tsc_closeport_new()
		end if
	elseif lower(ls_printer) = lower("Zebra ZM 400 (200dpi)") then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			if ll_totalrows > 0 then
				ll_counter = 1
				li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
				if li_file = -1 then
					messagebox("Error", "Unable to locate file for Label printing")
					return 0
				else
					ls_filecontent = "CT~~CD,~~CC^~~CT~~"
					filewriteex(li_file, ls_filecontent)
					ls_filecontent = "^XA~~TA000~~JSN^LT0^MNW^MTT^PON^PMN^LH0,0^JMA^PR2,2~~SD25^JUS^LRN^CI0^XZ"
					filewriteex(li_file, ls_filecontent)
					ls_filecontent = "^MMT"
					filewriteex(li_file, ls_filecontent)
					ls_filecontent = "^PW643"
					filewriteex(li_file, ls_filecontent)
					ls_filecontent = "^XA^LL0230"
					filewriteex(li_file, ls_filecontent)
					ls_filecontent = "^LS0"
					filewriteex(li_file, ls_filecontent)
					for ll_counter = 1 to ll_totalrows
						if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
							ls_filecontent = ""
							ls_itemname = ""
							ls_aliasname = ""
							ls_price = ""
							ll_qty = 0
							ll_qty = id_detail.getitemnumber(ll_counter, "qty")
							ls_itemname = id_detail.getitemstring(ll_counter, "itemname")
							ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
							if ib_printprice then
								ls_price = "Rs:" + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "##,###,##0.00"))
							else
								ls_price = ""
							end if
							if isnull(id_detail.object.manfdate[ll_counter]) then
								ls_mfg = ""
							else
								ls_mfg = "Mfg.:" + string(id_detail.object.manfdate[ll_counter], "dd-mmm-yyyy")
							end if
							if isnull(ls_mfg) then
								ls_mfg = ""
							end if
							ls_expiry = "Exp.:" + string(id_detail.object.expiry[ll_counter], "dd-mmm-yyyy")
							if isnull(ls_expiry) then
								ls_expiry = ""
							end if
							if len(ls_mfg) > 0 then
								ls_expiry = ls_mfg + ", " + ls_expiry
							end if
							ls_filecontent = "^XA"
							filewriteex(li_file, ls_filecontent)
							ls_filecontent = "^FT10,40^A0N,22,28^FH\^FD" + ls_clientname + "^FS"
							filewriteex(li_file, ls_filecontent)
							ls_filecontent = "^BY2,3,75^FT10,105^BCN,60,Y,N"
							filewriteex(li_file, ls_filecontent)
							ls_filecontent = "^FD>:" + ls_aliasname + "^FS"
							filewriteex(li_file, ls_filecontent)
							ls_filecontent = "^FT10,145^A0N,20,20^FH\^FD" + left(trim(ls_itemname), 28) + "^FS"
							filewriteex(li_file, ls_filecontent)
							ls_filecontent = "^FT10,167^A0N,20,20^FH\^FD" + mid(trim(ls_itemname), 29, 28) + "^FS"
							filewriteex(li_file, ls_filecontent)
							ls_filecontent = "^FT10,195^A0N,30,45^FH\^FD" + ls_price + "^FS"
							filewriteex(li_file, ls_filecontent)
							ls_filecontent = "^FT10,215^A0N,20,15^FH\^FD" + ls_expiry + "^FS"
							filewriteex(li_file, ls_filecontent)
							ls_filecontent = "^PQ" + trim(string(ll_qty)) + ",0,1,Y^XZ"
							filewriteex(li_file, ls_filecontent)
						end if
					next
					fileclose(li_file)
					li_file2 = fileopen("label.prn", textmode!, read!, lockread!)
					if li_file2 = -1 then
						messagebox("Error", "Unable to locate file for Label printing")
						return 0
					else
						filereadex(li_file2, ls_contents)
						fileclose(li_file2)
						printsetprinter("Zebra ZM 400 (200dpi)")
						ll_job = printopen("waseela", false)
						if ll_job = -1 then
							messagebox("Error", "Unable to Open Print Job for Label printing")
						else
							printsend(ll_job, ls_contents)
							printclose(ll_job)
						end if
					end if
				end if
			end if
		elseif ls_format = "2" then
			if ll_totalrows > 0 then
				ll_counter = 1
				li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
				if li_file = -1 then
					messagebox("Error", "Unable to locate file for Label printing")
					return 0
				else
					ls_filecontent = "CT~~CD,~~CC^~~CT~~"
					filewriteex(li_file, ls_filecontent)
					ls_filecontent = "^XA~~TA000~~JSN^LT0^MNW^MTT^PON^PMN^LH0,0^JMA^PR2,2~~SD25^JUS^LRN^CI0^XZ"
					filewriteex(li_file, ls_filecontent)
					ls_filecontent = "^MMT"
					filewriteex(li_file, ls_filecontent)
					ls_filecontent = "^PW643"
					filewriteex(li_file, ls_filecontent)
					ls_filecontent = "^XA^LL0230"
					filewriteex(li_file, ls_filecontent)
					ls_filecontent = "^LS0"
					filewriteex(li_file, ls_filecontent)
					for ll_counter = 1 to ll_totalrows
						if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
							ls_filecontent = ""
							ls_itemname = ""
							ls_aliasname = ""
							ls_price = ""
							ll_qty = 0
							ll_qty = id_detail.getitemnumber(ll_counter, "qty")
							ls_itemname = id_detail.getitemstring(ll_counter, "itemname")
							ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
							if ib_printprice then
								ls_price = "Rs:" + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "##,###,##0.00"))
							else
								ls_price = ""
							end if
							if isnull(id_detail.object.manfdate[ll_counter]) then
								ls_mfg = ""
							else
								ls_mfg = "Mfg.:" + string(id_detail.object.manfdate[ll_counter], "dd-mmm-yyyy")
							end if
							if isnull(ls_mfg) then
								ls_mfg = ""
							end if
							ls_expiry = "Exp.:" + string(id_detail.object.expiry[ll_counter], "dd-mmm-yyyy")
							if isnull(ls_expiry) then
								ls_expiry = ""
							end if
							if len(ls_mfg) > 0 then
								ls_expiry = ls_mfg + ", " + ls_expiry
							end if
							ls_manufshortname = trim(id_detail.getitemstring(ll_counter, "ManufShortName"))
							ls_manufaddress = trim(id_detail.getitemstring(ll_counter, "ManufAddress"))
							ls_manufphone = trim(id_detail.getitemstring(ll_counter, "manufphone"))
							if isnull(ls_manufshortname) or ls_manufshortname = "" then
								ls_manufshortname = ""
							else
								ls_manufshortname = "Mfg. By:" + ls_manufshortname
							end if
							if isnull(ls_manufaddress) or ls_manufaddress = "" then
								ls_manufaddress = ""
							else
								ls_manufaddress = "Address:" + ls_manufaddress
							end if
							if isnull(ls_manufphone) or ls_manufphone = "" then
								ls_manufphone = ""
							else
								ls_manufphone = "Phone No:" + ls_manufphone
							end if
							ls_packedby = "Pkd By:" + ls_clientname
							ls_filecontent = "^XA"
							filewriteex(li_file, ls_filecontent)
							ls_filecontent = "^FT10,30^A0N,22,24^FH\^FD" + ls_packedby + "^FS"
							filewriteex(li_file, ls_filecontent)
							ls_filecontent = "^FT10,50^A0N,20,15^FH\^FD" + ls_manufshortname + "^FS"
							filewriteex(li_file, ls_filecontent)
							ls_filecontent = "^FT10,70^A0N,20,13^FH\^FD" + ls_manufaddress + "^FS"
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "^BY2,3,55^FT10,130^BCN,,Y,N"
							filewriteex(li_file, ls_filecontent)
							ls_filecontent = "^FD>:" + ls_aliasname + "^FS"
							filewriteex(li_file, ls_filecontent)
							ls_filecontent = "^FT10,170^A0N,20,20^FH\^FD" + left(ls_itemname, 40) + "^FS"
							filewriteex(li_file, ls_filecontent)
							ls_filecontent = "^FT10,192^A0N,25,40^FH\^FD" + ls_price + "^FS"
							filewriteex(li_file, ls_filecontent)
							ls_filecontent = "^FT10,215^A0N,20,15^FH\^FD" + ls_expiry + "^FS"
							filewriteex(li_file, ls_filecontent)
							ls_filecontent = "^PQ" + trim(string(ll_qty)) + ",0,1,Y^XZ"
							filewriteex(li_file, ls_filecontent)
						end if
					next
					fileclose(li_file)
					li_file2 = fileopen("label.prn", textmode!, read!, lockread!)
					if li_file2 = -1 then
						messagebox("Error", "Unable to locate file for Label printing")
						return 0
					else
						filereadex(li_file2, ls_contents)
						fileclose(li_file2)
						printsetprinter("Zebra ZM 400 (200dpi)")
						ll_job = printopen("waseela", false)
						if ll_job = -1 then
							messagebox("Error", "Unable to Open Print Job for Label printing")
						else
							printsend(ll_job, ls_contents)
							printclose(ll_job)
						end if
					end if
				end if
			end if
		elseif ls_format = "3" and ll_totalrows > 0 then
			ll_counter = 1
			li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
			if li_file = -1 then
				messagebox("Error", "Unable to locate file for Label printing")
				return 0
			else
				ls_filecontent = "CT~~CD,~~CC^~~CT~~"
				filewriteex(li_file, ls_filecontent)
				ls_filecontent = "^XA~~TA000~~JSN^LT0^MNW^MTT^PON^PMN^LH0,0^JMA^PR2,2~~SD25^JUS^LRN^CI0^XZ"
				filewriteex(li_file, ls_filecontent)
				ls_filecontent = "^MMT"
				filewriteex(li_file, ls_filecontent)
				ls_filecontent = "^PW480"
				filewriteex(li_file, ls_filecontent)
				ls_filecontent = "^LL0320"
				filewriteex(li_file, ls_filecontent)
				ls_filecontent = "^LS0"
				filewriteex(li_file, ls_filecontent)
				for ll_counter = 1 to ll_totalrows
					if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ls_filecontent = ""
						ls_itemname = ""
						ls_aliasname = ""
						ls_price = ""
						ll_qty = 0
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = id_detail.getitemstring(ll_counter, "itemname")
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs:" + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "##,###,##0.00"))
						else
							ls_price = ""
						end if
						if isnull(id_detail.object.manfdate[ll_counter]) then
							ls_mfg = ""
						else
							ls_mfg = "Mfg.:" + string(id_detail.object.manfdate[ll_counter], "dd-mmm-yyyy")
						end if
						if isnull(ls_mfg) then
							ls_mfg = ""
						end if
						ls_expiry = "Exp.:" + string(id_detail.object.expiry[ll_counter], "dd-mmm-yyyy")
						if isnull(ls_expiry) then
							ls_expiry = ""
						end if
						if len(ls_mfg) > 0 then
							ls_expiry = ls_mfg + ", " + ls_expiry
						end if
						ls_manufshortname = trim(id_detail.getitemstring(ll_counter, "ManufShortName"))
						ls_manufaddress = trim(id_detail.getitemstring(ll_counter, "ManufAddress"))
						ls_manufphone = trim(id_detail.getitemstring(ll_counter, "manufphone"))
						if isnull(ls_manufshortname) or ls_manufshortname = "" then
							ls_manufshortname = ""
						else
							ls_manufshortname = "Mfg. By:" + ls_manufshortname
						end if
						if isnull(ls_manufaddress) or ls_manufaddress = "" then
							ls_manufaddress = ""
						else
							ls_manufaddress = "Address:" + ls_manufaddress
						end if
						if isnull(ls_manufphone) or ls_manufphone = "" then
							ls_manufphone = ""
						else
							ls_manufphone = "Phone No:" + ls_manufphone
						end if
						ls_packedby = "Packed By: " + ls_clientname
						ls_filecontent = "^XA"
						filewriteex(li_file, ls_filecontent)
						ls_filecontent = "^FT40,40^A0N,24,45^FH\^FD" + ls_clientname + "^FS"
						filewriteex(li_file, ls_filecontent)
						ls_filecontent = "^BY2,3,70^FT40,105^BCN,60,Y,N"
						filewriteex(li_file, ls_filecontent)
						ls_filecontent = "^FD>:" + ls_aliasname + "^FS"
