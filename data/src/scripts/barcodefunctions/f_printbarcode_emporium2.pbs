// function f_printbarcode_emporium2 (barcodefunctions)  ancestor: function_object

// f_printbarcode_emporium2.f_printbarcode_emporium2(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_job
	string ls_contents
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	integer li_file2
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_expiry
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if lower(ls_printer) = lower("ZDesigner LP 2824") then
		li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
		if li_file = -1 then
			messagebox("Error", "Unable to locate file for Label printing")
			return 0
		else
			ls_filecontent = ""
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "Q224,024"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "q288"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "rN"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "S10"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "D8"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "ZT"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "JB"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "OD"
			filewrite(li_file, ls_filecontent)
			for ll_counter = 1 to ll_totalrows
				if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ls_filecontent = ""
					ls_itemname = ""
					ls_aliasname = ""
					ls_price = ""
					ll_qty = 0
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = id_detail.getitemstring(ll_counter, "itemname")
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					if ib_printprice then
						ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
					else
						ls_price = ""
					end if
					ls_expiry = "Expiry:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
					if isnull(ls_expiry) then
						ls_expiry = ""
					end if
					ls_filecontent = "N"
					filewrite(li_file, ls_filecontent)
					ls_filecontent = "A10,10,0,3,1,1,N,~"" + ls_clientname + "~""
					filewrite(li_file, ls_filecontent)
					ls_filecontent = "B10,36,0,1,2,6,75,B,~"" + ls_aliasname + "~""
					filewrite(li_file, ls_filecontent)
					ls_filecontent = "A10,142,0,2,1,1,N,~"" + left(ls_itemname, 22) + "~""
					filewrite(li_file, ls_filecontent)
					if len(ls_expiry) > 0 then
						ls_filecontent = "A10,160,0,2,1,1,N,~"" + ls_expiry + "~""
					else
						ls_filecontent = "A10,160,0,2,1,1,N,~"" + mid(ls_itemname, 23, 22) + "~""
					end if
					filewrite(li_file, ls_filecontent)
					ls_filecontent = "A10,178,0,4,1,1,N,~"" + ls_price + "~""
					filewrite(li_file, ls_filecontent)
					ls_filecontent = "P" + trim(string(ll_qty))
					filewrite(li_file, ls_filecontent)
				end if
			next
			fileclose(li_file)
			li_file2 = fileopen("label.prn", textmode!, read!, lockread!)
			if li_file2 = -1 then
				messagebox("Error", "Unable to locate file for Label printing")
				return 0
			else
				filereadex(li_file2, ls_contents)
				fileclose(li_file2)
				printsetprinter("ZDesigner LP 2824")
				ll_job = printopen("waseela", false)
				if ll_job = -1 then
					messagebox("Error", "Unable to Open Print Job for Label printing")
				else
					printsend(ll_job, ls_contents)
					printclose(ll_job)
				end if
			end if
		end if
	end if
	return 0
