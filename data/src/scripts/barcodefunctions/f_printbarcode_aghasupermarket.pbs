// function f_printbarcode_aghasupermarket (barcodefunctions)  ancestor: function_object

// f_printbarcode_aghasupermarket.f_printbarcode_aghasupermarket(datawindow id_master, datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_date = string(today(), "yymmdd..")
	ls_date = "      (" + ls_date + ")"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ls_clientname = "   AGHA'S"
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if upper(ls_printer) = "TSC TTP-244 PLUS" then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			ls_clientname = "       AGHA'S"
			ll_supply_cols_per_row = 3
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PLUS")
				tsc_setup_new("89.6", "19.1", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER OFF")
				tsc_sendcommand_new("SET TEAR OFF")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 20)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_windowsfont_new(710, 47, 30, 180, 2, 0, "Times new Roman", ls_price)
						tsc_windowsfont_new(463, 47, 30, 180, 2, 0, "Times new Roman", ls_price)
						tsc_windowsfont_new(217, 47, 30, 180, 2, 0, "Times new Roman", ls_price)
						tsc_windowsfont_new(710, 66, 20, 180, 2, 0, "Times new Roman", ls_itemname)
						tsc_windowsfont_new(463, 66, 20, 180, 2, 0, "Times new Roman", ls_itemname)
						tsc_windowsfont_new(217, 66, 20, 180, 2, 0, "Times new Roman", ls_itemname)
						tsc_windowsfont_new(710, 93, 25, 180, 2, 0, "Times new Roman", ls_aliasname + ls_date)
						tsc_windowsfont_new(463, 93, 25, 180, 2, 0, "Times new Roman", ls_aliasname + ls_date)
						tsc_windowsfont_new(217, 93, 25, 180, 2, 0, "Times new Roman", ls_aliasname + ls_date)
						tsc_barcode_new("710", "137", "128", "41", "0", "180", "2", "3", ls_aliasname)
						tsc_barcode_new("463", "137", "128", "41", "0", "180", "2", "3", ls_aliasname)
						tsc_barcode_new("217", "137", "128", "41", "0", "180", "2", "3", ls_aliasname)
						tsc_windowsfont_new(710, 160, 25, 180, 2, 0, "Arial", ls_clientname)
						tsc_windowsfont_new(463, 160, 25, 180, 2, 0, "Arial", ls_clientname)
						tsc_windowsfont_new(217, 160, 25, 180, 2, 0, "Arial", ls_clientname)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_formfeed_new()
				tsc_closeport_new()
			end if
		elseif ls_format = "2" then
			if ll_totalrows > 0 then
				ls_date = string(today(), "yymmdd..")
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 Plus")
				tsc_setup_new("40.1", "28.8", "4", "7", "0", "3", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET TEAR OFF")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER OFF")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 27)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "###,##0.00"))
						else
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						ls_clientname = "AGHA'S"
						tsc_printerfont_new("210", "218", "0", "180", "13", "8", ls_clientname)
						tsc_printerfont_new("312", "189", "0", "180", "8", "7", ls_itemname)
						tsc_printerfont_new("312", "214", "0", "180", "9", "6", ls_date)
						tsc_barcode_new("308", "165", "128M", "89", "0", "180", "3", "6", ls_aliasname)
						tsc_printerfont_new("224", "72", "ROMAN.TTF", "180", "1", "9", ls_aliasname)
						tsc_printerfont_new("299", "42", "0", "180", "19", "12", ls_price)
						tsc_printlabel_new("1", string(ll_qty))
					end if
				next
				tsc_closeport_new()
			end if
		else
			ll_supply_cols_per_row = 3
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PLUS")
				tsc_setup_new("89.6", "19.1", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER OFF")
				tsc_sendcommand_new("SET TEAR OFF")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 35)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_printerfont_new("701", "32", "0", "180", "9", "6", ls_price)
						tsc_printerfont_new("454", "32", "0", "180", "9", "6", ls_price)
						tsc_printerfont_new("207", "32", "0", "180", "9", "6", ls_price)
						tsc_printerfont_new("701", "48", "0", "180", "6", "6", ls_itemname)
						tsc_printerfont_new("454", "48", "0", "180", "6", "6", ls_itemname)
						tsc_printerfont_new("207", "48", "0", "180", "6", "6", ls_itemname)
						tsc_printerfont_new("701", "150", "0", "180", "8", "6", ls_clientname)
						tsc_printerfont_new("454", "150", "0", "180", "8", "6", ls_clientname)
						tsc_printerfont_new("207", "150", "0", "180", "8", "6", ls_clientname)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		end if
	end if
	return 0
