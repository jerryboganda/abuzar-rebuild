// function f_printbarcode_mdssupermarket (barcodefunctions)  ancestor: function_object

// f_printbarcode_mdssupermarket.f_printbarcode_mdssupermarket(datawindow id_master, datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_itemname2
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_packing
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_expiry
	string ls_manfdate
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 21)
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if upper(ls_printer) = "TSC TTP-244 PRO" then
		if ll_totalrows > 0 then
			ll_counter = 1
			tsc_openport_new("TSC TTP-244 PRO")
			tsc_setup_new("60", "40", "5", "12", "0", "3", "0")
			for ll_counter = 1 to ll_totalrows
				if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					if isnull(id_detail.object.expiry[ll_counter]) then
						ls_expiry = ""
					else
						ls_expiry = "Exp. Date: " + string(id_detail.object.expiry[ll_counter], "dd-mmm-yyyy")
					end if
					if isnull(id_detail.object.manfdate[ll_counter]) then
						ls_manfdate = ""
					else
						ls_manfdate = "Packed On: " + string(id_detail.object.manfdate[ll_counter], "dd-mmm-yyyy")
					end if
					if ib_printprice then
						ls_price = trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
					else
						ls_price = ""
					end if
					ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
					tsc_clearbuffer_new()
					if len(ls_price) > 0 then
						tsc_sendcommand_new("BOX 12,50,195,142,4")
						tsc_windowsfont_new(15, 55, 40, 0, 2, 0, "Arial", space(6) + "Rs.")
						tsc_windowsfont_new(15, 95, 40, 0, 2, 0, "Arial", space(int((12 - len(ls_price)) / 2.0)) + ls_price)
					end if
					tsc_windowsfont_new(205, 20, 30, 0, 2, 0, "Arial", ls_clientname)
					tsc_barcode_new("205", "55", "128", "95", "1", "0", "2", "3", ls_aliasname)
					tsc_windowsfont_new(12, 187, 30, 0, 2, 0, "Arial", left(ls_itemname, 20))
					tsc_windowsfont_new(12, 215, 30, 0, 2, 0, "Arial", mid(ls_itemname, 21, 20))
					tsc_windowsfont_new(12, 243, 30, 0, 2, 0, "Arial", mid(ls_itemname, 41, 20))
					tsc_windowsfont_new(270, 282, 18, 0, 2, 0, "Arial", ls_expiry)
					tsc_windowsfont_new(270, 300, 18, 0, 2, 0, "Arial", ls_manfdate)
					tsc_printlabel_new("1", string(ll_qty))
				end if
			next
			tsc_closeport_new()
		end if
	elseif ls_printer = "Zebra ZM 400 (200dpi)" and ll_totalrows > 0 then
		ll_counter = 1
		li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
		if li_file = -1 then
			messagebox("Error", "Unable to locate file for Label printing")
		else
			ll_supply_cols_per_row = 2
			filewrite(li_file, "^XA~~TA000~~JSN^LT0^MNW^MTT^PON^PMN^LH0,0^JMA^PR2,2^MD10^JUS^LRN^CI0^XZ")
			ll_labelno = 1
			for ll_counter = 1 to ll_totalrows
				if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 28)
					ls_itemname2 = mid(trim(id_detail.getitemstring(ll_counter, "itemname")), 29, 28)
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					if ib_printprice then
						ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "##,###,###.##"))
					else
						ls_price = ""
					end if
					ls_date = string(today(), "dd/mm")
					for ll_innercounter = 1 to ll_qty
						ll_labelpos = ll_labelno mod ll_supply_cols_per_row
						if ll_labelpos = 1 then
							filewrite(li_file, "^XA")
							filewrite(li_file, "^MMT")
							filewrite(li_file, "^LL0224")
							filewrite(li_file, "^PW645")
							filewrite(li_file, "^LS0")
						end if
						if ll_labelpos = 1 then
							ls_xpos = "46"
						elseif ll_labelpos = 0 then
							ls_xpos = "374"
						end if
						ls_filecontent = "^BY2,3,81^FT" + ls_xpos + ",123^BCN,,Y,N"
						filewrite(li_file, ls_filecontent)
						filewrite(li_file, "^FD>:" + ls_aliasname + "^FS")
						if ll_labelpos = 1 then
							ls_xpos = "16"
						elseif ll_labelpos = 0 then
							ls_xpos = "344"
						end if
						ls_filecontent = "^FO" + ls_xpos + ",7^GB290,34,34^FS"
						filewrite(li_file, ls_filecontent)
						if ll_labelpos = 1 then
							ls_xpos = "16"
						elseif ll_labelpos = 0 then
							ls_xpos = "344"
						end if
						if gs_company = "MDSSUPERMARKET" then
							ls_filecontent = "^FT" + ls_xpos + ",34^A0N,28,33^FR^FH\^FDMDS SUPER MARKET^FS"
						else
							ls_filecontent = "^FT" + ls_xpos + ",34^A0N,28,33^FR^FH\^FD" + ls_clientname + "^FS"
						end if
						filewrite(li_file, ls_filecontent)
						if ll_labelpos = 1 then
							ls_xpos = "24"
						elseif ll_labelpos = 0 then
							ls_xpos = "352"
						end if
						ls_filecontent = "^FT" + ls_xpos + ",212^A0N,28,55^FH\^FD" + ls_price + "^FS"
						filewrite(li_file, ls_filecontent)
						if ll_labelpos = 1 then
							ls_xpos = "20"
						elseif ll_labelpos = 0 then
							ls_xpos = "348"
						end if
						ls_filecontent = "^FT" + ls_xpos + ",162^A0N,15,19^FH\^FD" + ls_itemname + "^FS"
						filewrite(li_file, ls_filecontent)
						if ll_labelpos = 1 then
							ls_xpos = "20"
						elseif ll_labelpos = 0 then
							ls_xpos = "348"
						end if
						ls_filecontent = "^FT" + ls_xpos + ",180^A0N,15,19^FH\^FD" + ls_itemname2 + "^FS"
						filewrite(li_file, ls_filecontent)
						if ll_labelpos = 0 then
							filewrite(li_file, "^PQ1,0,1,Y^XZ")
						end if
						ll_labelno = ll_labelno + 1
					next
				end if
			next
			if ll_labelpos > 0 then
				filewrite(li_file, "^PQ1,0,1,Y^XZ")
			end if
			fileclose(li_file)
			run("..\BarcodePrint\BP.bat", normal!)
		end if
	end if
	return 0
