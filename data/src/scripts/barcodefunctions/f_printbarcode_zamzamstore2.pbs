// function f_printbarcode_zamzamstore2 (barcodefunctions)  ancestor: function_object

// f_printbarcode_zamzamstore2.f_printbarcode_zamzamstore2(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_alternatealias
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if ls_printer = "Zebra ZM 400 (200dpi)" and ll_totalrows > 0 then
		ll_counter = 1
		li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
		if li_file = -1 then
			messagebox("Error", "Unable to locate file for Label printing")
		else
			ll_supply_cols_per_row = 2
			filewrite(li_file, "^XATA000JSN^LT0^MNW^MTT^PON^PMN^LH0,0^JMA^PR2,2^MD10^JUS^LRN^CI0^XZ")
			ll_labelno = 1
			for ll_counter = 1 to ll_totalrows
				if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
					ls_alternatealias = left(trim(id_detail.getitemstring(ll_counter, "alternatecustomicode")), li_barcodeleninprint)
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					if len(ls_alternatealias) > 0 then
						ls_aliasname = ls_alternatealias
					end if
					if ib_printprice then
						ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "##,###,###"))
					else
						ls_price = ""
					end if
					ls_date = string(today(), "dd/mm")
					for ll_innercounter = 1 to ll_qty
						ll_labelpos = ll_labelno mod ll_supply_cols_per_row
						if ll_labelpos = 1 then
							filewrite(li_file, "^XA")
							filewrite(li_file, "^MMT")
							filewrite(li_file, "^LL0224")
							filewrite(li_file, "^PW645")
							filewrite(li_file, "^LS0")
						end if
						if ll_labelpos = 1 then
							ls_xpos = "17"
						elseif ll_labelpos = 0 then
							ls_xpos = "345"
						end if
						ls_filecontent = "^FT" + ls_xpos + ",38^A0N,31,50^FH\^FDZAM ZAM^FS"
						filewrite(li_file, ls_filecontent)
						if ll_labelpos = 1 then
							ls_xpos = "219"
						elseif ll_labelpos = 0 then
							ls_xpos = "547"
						end if
						ls_filecontent = "^FT" + ls_xpos + ",38^A0N,20,26^FH\^FDSTORES^FS"
						filewrite(li_file, ls_filecontent)
						if ll_labelpos = 1 then
							ls_xpos = "48"
						elseif ll_labelpos = 0 then
							ls_xpos = "376"
						end if
						ls_filecontent = "^BY2,3,74^FT" + ls_xpos + ",119^BCN,,Y,N"
						filewrite(li_file, ls_filecontent)
						filewrite(li_file, "^FD>:" + ls_aliasname + "^FS")
						if ll_labelpos = 1 then
							ls_xpos = "24"
						elseif ll_labelpos = 0 then
							ls_xpos = "352"
						end if
						ls_filecontent = "^FT" + ls_xpos + ",161^A0N,15,19^FH\^FD" + mid(ls_itemname, 1, 27) + "^FS"
						filewrite(li_file, ls_filecontent)
						if ll_labelpos = 1 then
							ls_xpos = "24"
						elseif ll_labelpos = 0 then
							ls_xpos = "352"
						end if
						ls_filecontent = "^FT" + ls_xpos + ",179^A0N,15,19^FH\^FD" + mid(ls_itemname, 28, 54) + "^FS"
						filewrite(li_file, ls_filecontent)
						if ll_labelpos = 1 then
							ls_xpos = "24"
						elseif ll_labelpos = 0 then
							ls_xpos = "352"
						end if
						ls_filecontent = "^FT" + ls_xpos + ",212^A0N,28,38^FH\^FD" + ls_price + "^FS"
						filewrite(li_file, ls_filecontent)
						if ll_labelpos = 0 then
							filewrite(li_file, "^PQ1,0,1,Y^XZ")
						end if
						ll_labelno = ll_labelno + 1
					next
				end if
			next
			if ll_labelpos > 0 then
				filewrite(li_file, "^PQ1,0,1,Y^XZ")
			end if
			fileclose(li_file)
			run("..\BarcodePrint\BP.bat", normal!)
		end if
	end if
	return 0
