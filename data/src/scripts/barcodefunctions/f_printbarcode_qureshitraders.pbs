// function f_printbarcode_qureshitraders (barcodefunctions)  ancestor: function_object

// f_printbarcode_qureshitraders.f_printbarcode_qureshitraders(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	integer li_file2
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_contents
	string ls_defaultinfo
	string ls_defaultprinter
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_packing
	string ls_batch
	string ls_expdate
	string ls_expiry
	string ls_mfg
	string ls_rp_tax
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	long ll_job
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_date = "PD:" + trim(string(today(), "dd-mm-yy"))
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if upper(ls_printer) = "TSC TTP-244 PRO" then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PRO")
				tsc_setup_new("38.1", "28.57", "5", "12", "0", "3", "0")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_batch = "Batch:" + trim(id_detail.getitemstring(ll_counter, "batch"))
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						if isnull(ls_mfg) then
							ls_mfg = ""
						end if
						if isnull(ls_expiry) then
							ls_expiry = ""
						end if
						if len(ls_mfg) > 0 then
							ls_expiry = ls_mfg + space(2) + ls_expiry
						end if
						if ib_printprice then
							ls_rp_tax = "RP: Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "retailprice"), 2))) + " + ST " + trim(string(round(id_detail.getitemdecimal(ll_counter, "salestax"), 2)))
							ls_price = "CP: Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "c_customerprice"), 2)))
						else
							ls_rp_tax = ""
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						tsc_windowsfont_new(15, 30, 20, 0, 2, 0, "Arial", ls_batch)
						tsc_windowsfont_new(15, 48, 20, 0, 2, 0, "Arial", ls_expiry)
						tsc_windowsfont_new(15, 66, 25, 0, 2, 0, "Arial", ls_rp_tax)
						tsc_windowsfont_new(15, 91, 25, 0, 2, 0, "Arial", ls_price)
						tsc_barcode_new("15", "120", "128", "40", "0", "0", "2", "3", ls_aliasname)
						tsc_windowsfont_new(15, 162, 20, 0, 2, 0, "arial", ls_aliasname)
						tsc_printlabel_new("1", string(ll_qty))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "2" then
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PRO")
				tsc_setup_new("38.1", "28.57", "5", "12", "0", "3", "0")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_batch = "Batch:" + trim(id_detail.getitemstring(ll_counter, "batch"))
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						if isnull(ls_mfg) then
							ls_mfg = ""
						end if
						if isnull(ls_expiry) then
							ls_expiry = ""
						end if
						if len(ls_mfg) > 0 then
							ls_expiry = ls_mfg + space(2) + ls_expiry
						end if
						if ib_printprice then
							ls_rp_tax = "RP: Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "retailprice"), 2))) + " + ST " + trim(string(round(id_detail.getitemdecimal(ll_counter, "salestax"), 2)))
							ls_price = "CP: Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "c_customerprice"), 2)))
						else
							ls_rp_tax = ""
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						tsc_windowsfont_new(15, 20, 20, 0, 2, 0, "Arial", ls_batch)
						tsc_windowsfont_new(15, 38, 20, 0, 2, 0, "Arial", ls_expiry)
						tsc_windowsfont_new(15, 56, 25, 0, 2, 0, "Arial", ls_rp_tax)
						tsc_windowsfont_new(15, 81, 25, 0, 2, 0, "Arial", ls_price)
						tsc_windowsfont_new(15, 106, 18, 0, 2, 0, "Arial", "----------------------------------------------")
						tsc_windowsfont_new(15, 125, 20, 0, 2, 0, "Arial", ls_batch)
						tsc_windowsfont_new(15, 143, 20, 0, 2, 0, "Arial", ls_expiry)
						tsc_windowsfont_new(15, 161, 25, 0, 2, 0, "Arial", ls_rp_tax)
						tsc_windowsfont_new(15, 183, 25, 0, 2, 0, "Arial", ls_price)
						tsc_printlabel_new("1", string(ll_qty))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "3" and ll_totalrows > 0 then
			ll_counter = 1
			tsc_openport_new("TSC TTP-244 PRO")
			tsc_setup_new("38.1", "28.57", "5", "12", "0", "3", "0")
			for ll_counter = 1 to ll_totalrows
				if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
					ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
					if isnull(ls_mfg) then
						ls_mfg = ""
					end if
					if isnull(ls_expiry) then
						ls_expiry = ""
					end if
					if len(ls_mfg) > 0 then
						ls_expiry = ls_mfg + space(2) + ls_expiry
					end if
					if ib_printprice then
						ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
					else
						ls_price = ""
					end if
					ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
					tsc_clearbuffer_new()
					tsc_windowsfont_new(15, 20, 20, 0, 2, 0, "Arial", ls_clientname)
					tsc_barcode_new("15", "45", "128", "65", "0", "0", "2", "3", ls_aliasname)
					tsc_windowsfont_new(15, 114, 25, 0, 2, 0, "arial", ls_aliasname)
					tsc_windowsfont_new(15, 138, 20, 0, 2, 0, "Arial", left(ls_itemname, 28))
					tsc_windowsfont_new(15, 179, 35, 0, 2, 0, "Arial", ls_price)
					tsc_printlabel_new("1", string(ll_qty))
				end if
			next
			tsc_closeport_new()
		end if
	elseif left(lower(ls_printer), 5) = lower("Zebra") then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			if ll_totalrows > 0 then
				ll_counter = 1
				li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
				if li_file = -1 then
					messagebox("Error", "Unable to locate file for Label printing")
				else
					ll_supply_cols_per_row = 2
					filewrite(li_file, "^XA~~TA000~~JSN^LT0^MNW^MTD^PON^PMN^LH0,0^JMA^PR4,4^MD0^JUS^LRN^CI0^XZ")
					ll_labelno = 1
					for ll_counter = 1 to ll_totalrows
						if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
							ll_qty = id_detail.getitemnumber(ll_counter, "qty")
							ls_batch = "Batch:" + trim(id_detail.getitemstring(ll_counter, "batch"))
							ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
							ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
							ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
							ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
							if isnull(ls_mfg) then
								ls_mfg = ""
							end if
							if isnull(ls_expiry) then
								ls_expiry = ""
							end if
							if len(ls_mfg) > 0 then
								ls_expiry = ls_mfg + space(2) + ls_expiry
							end if
							if ib_printprice then
								ls_rp_tax = "RP: Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "retailprice"), 2))) + " + ST " + trim(string(round(id_detail.getitemdecimal(ll_counter, "salestax"), 2)))
								ls_price = "CP: Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "c_customerprice"), 2)))
							else
								ls_rp_tax = ""
								ls_price = ""
							end if
							for ll_innercounter = 1 to ll_qty
								ll_labelpos = ll_labelno mod ll_supply_cols_per_row
								if ll_labelpos = 1 then
									filewrite(li_file, "^XA^LL0304")
									filewrite(li_file, "^MMT")
									filewrite(li_file, "^PW990")
									filewrite(li_file, "^LS0")
								end if
								if ll_labelpos = 1 then
									ls_xpos = "35"
								elseif ll_labelpos = 0 then
									ls_xpos = "365"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",20^A0N,20,20^FH\^FD" + ls_batch + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "35"
								elseif ll_labelpos = 0 then
									ls_xpos = "365"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",42^A0N,20,20^FH\^FD" + ls_expiry + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "35"
								elseif ll_labelpos = 0 then
									ls_xpos = "365"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",70^A0N,25,20^FH\^FD" + ls_rp_tax + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "35"
								elseif ll_labelpos = 0 then
									ls_xpos = "365"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",95^A0N,25,20^FH\^FD" + ls_price + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "35"
								elseif ll_labelpos = 0 then
									ls_xpos = "365"
								end if
								ls_filecontent = "^BY2,3,60^FT" + ls_xpos + ",158^BCN,,Y,N"
								filewrite(li_file, ls_filecontent)
								filewrite(li_file, "^FD>:" + ls_aliasname + "^FS")
								if ll_labelpos = 0 then
									filewrite(li_file, "^PQ1,0,1,Y^XZ")
								end if
								ll_labelno = ll_labelno + 1
							next
						end if
					next
					if ll_labelpos > 0 then
						filewrite(li_file, "^PQ1,0,1,Y^XZ")
					end if
					fileclose(li_file)
					li_file2 = fileopen("label.prn", textmode!, read!, lockread!)
					if li_file2 = -1 then
						messagebox("Error", "Unable to locate file for Label printing")
						return 0
					else
						filereadex(li_file2, ls_contents)
						fileclose(li_file2)
						ls_defaultinfo = printgetprinter()
						ls_defaultprinter = left(ls_defaultinfo, pos(ls_defaultinfo, "~t") - 1)
						printsetprinter(ls_printer)
						ll_job = printopen("waseela", false)
						if ll_job = -1 then
							messagebox("Error", "Unable to Open Print Job for Label printing")
						else
							printsend(ll_job, ls_contents)
							printclose(ll_job)
						end if
						printsetprinter(trim(ls_defaultprinter))
					end if
				end if
			end if
		elseif ls_format = "2" then
			if ll_totalrows > 0 then
				ll_counter = 1
				li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
				if li_file = -1 then
					messagebox("Error", "Unable to locate file for Label printing")
				else
					ll_supply_cols_per_row = 2
					filewrite(li_file, "^XA~~TA000~~JSN^LT0^MNW^MTD^PON^PMN^LH0,0^JMA^PR4,4^MD0^JUS^LRN^CI0^XZ")
					ll_labelno = 1
					for ll_counter = 1 to ll_totalrows
						if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
							ll_qty = id_detail.getitemnumber(ll_counter, "qty")
							ls_batch = "Batch:" + trim(id_detail.getitemstring(ll_counter, "batch"))
							ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
							ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
							ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
							ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
							if isnull(ls_mfg) then
								ls_mfg = ""
							end if
							if isnull(ls_expiry) then
								ls_expiry = ""
							end if
							if len(ls_mfg) > 0 then
								ls_expiry = ls_mfg + space(2) + ls_expiry
							end if
							if ib_printprice then
								ls_rp_tax = "RP: Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "retailprice"), 2))) + " + ST " + trim(string(round(id_detail.getitemdecimal(ll_counter, "salestax"), 2)))
								ls_price = "CP: Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "c_customerprice"), 2)))
							else
								ls_rp_tax = ""
								ls_price = ""
							end if
							for ll_innercounter = 1 to ll_qty
								ll_labelpos = ll_labelno mod ll_supply_cols_per_row
								if ll_labelpos = 1 then
									filewrite(li_file, "^XA^LL0304")
									filewrite(li_file, "^MMT")
									filewrite(li_file, "^PW990")
									filewrite(li_file, "^LS0")
								end if
								if ll_labelpos = 1 then
									ls_xpos = "35"
								elseif ll_labelpos = 0 then
									ls_xpos = "365"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",15^A0N,20,20^FH\^FD" + ls_batch + "^FS"
								filewrite(li_file, ls_filecontent)
								ls_filecontent = "^FT" + ls_xpos + ",37^A0N,20,20^FH\^FD" + ls_expiry + "^FS"
								filewrite(li_file, ls_filecontent)
								ls_filecontent = "^FT" + ls_xpos + ",65^A0N,25,20^FH\^FD" + ls_rp_tax + "^FS"
								filewrite(li_file, ls_filecontent)
								ls_filecontent = "^FT" + ls_xpos + ",90^A0N,25,20^FH\^FD" + ls_price + "^FS"
								filewrite(li_file, ls_filecontent)
								ls_filecontent = "^FT" + ls_xpos + ",110^A0N,25,20^FH\^FD" + "----------------" + "^FS"
								filewrite(li_file, ls_filecontent)
								ls_filecontent = "^FT" + ls_xpos + ",125^A0N,20,20^FH\^FD" + ls_batch + "^FS"
								filewrite(li_file, ls_filecontent)
								ls_filecontent = "^FT" + ls_xpos + ",147^A0N,20,20^FH\^FD" + ls_expiry + "^FS"
								filewrite(li_file, ls_filecontent)
								ls_filecontent = "^FT" + ls_xpos + ",175^A0N,25,20^FH\^FD" + ls_rp_tax + "^FS"
								filewrite(li_file, ls_filecontent)
								ls_filecontent = "^FT" + ls_xpos + ",200^A0N,25,20^FH\^FD" + ls_price + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 0 then
									filewrite(li_file, "^PQ1,0,1,Y^XZ")
								end if
								ll_labelno = ll_labelno + 1
							next
						end if
					next
					if ll_labelpos > 0 then
						filewrite(li_file, "^PQ1,0,1,Y^XZ")
					end if
					fileclose(li_file)
					li_file2 = fileopen("label.prn", textmode!, read!, lockread!)
					if li_file2 = -1 then
						messagebox("Error", "Unable to locate file for Label printing")
						return 0
					else
						filereadex(li_file2, ls_contents)
						fileclose(li_file2)
						ls_defaultinfo = printgetprinter()
						ls_defaultprinter = left(ls_defaultinfo, pos(ls_defaultinfo, "~t") - 1)
						printsetprinter(ls_printer)
						ll_job = printopen("waseela", false)
						if ll_job = -1 then
							messagebox("Error", "Unable to Open Print Job for Label printing")
						else
							printsend(ll_job, ls_contents)
							printclose(ll_job)
						end if
						printsetprinter(trim(ls_defaultprinter))
					end if
				end if
			end if
		elseif ls_format = "3" and ll_totalrows > 0 then
			ll_counter = 1
			li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
			if li_file = -1 then
				messagebox("Error", "Unable to locate file for Label printing")
			else
				ll_supply_cols_per_row = 2
				filewrite(li_file, "^XA~~TA000~~JSN^LT0^MNW^MTD^PON^PMN^LH0,0^JMA^PR4,4^MD0^JUS^LRN^CI0^XZ")
				ll_labelno = 1
				for ll_counter = 1 to ll_totalrows
					if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 30)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "#####0"))
						else
							ls_price = ""
						end if
						ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						if isnull(ls_mfg) then
							ls_mfg = ""
						end if
						if isnull(ls_expiry) then
							ls_expiry = ""
						end if
						if len(ls_mfg) > 0 then
							ls_expiry = ls_mfg + space(2) + ls_expiry
						end if
						ls_date = string(today(), "dd/mm")
						for ll_innercounter = 1 to ll_qty
							ll_labelpos = ll_labelno mod ll_supply_cols_per_row
							if ll_labelpos = 1 then
								filewrite(li_file, "^XA^LL0304")
								filewrite(li_file, "^MMT")
								filewrite(li_file, "^PW990")
								filewrite(li_file, "^LS0")
							end if
							if ll_labelpos = 1 then
								ls_xpos = "35"
							elseif ll_labelpos = 0 then
								ls_xpos = "365"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",20^A0N,30,30^FR^FH\^FD" + ls_clientname + "^FS"
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "^BY2,3,70^FT" + ls_xpos + ",100^BCN,,Y,N"
							filewrite(li_file, ls_filecontent)
							filewrite(li_file, "^FD>:" + ls_aliasname + "^FS")
							ls_filecontent = "^FT" + ls_xpos + ",146^A0N,25,20^FH\^FD" + left(ls_itemname, 26) + "^FS"
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "^FT" + ls_xpos + ",173^A0N,25,20^FH\^FD" + mid(ls_itemname, 27, 26) + "^FS"
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "^FT" + ls_xpos + ",200^A0N,30,43^FH\^FD" + ls_price + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 0 then
								filewrite(li_file, "^PQ1,0,1,Y^XZ")
							end if
							ll_labelno = ll_labelno + 1
						next
					end if
				next
				if ll_labelpos > 0 then
					filewrite(li_file, "^PQ1,0,1,Y^XZ")
				end if
				fileclose(li_file)
				li_file2 = fileopen("label.prn", textmode!, read!, lockread!)
				if li_file2 = -1 then
					messagebox("Error", "Unable to locate file for Label printing")
					return 0
				else
					filereadex(li_file2, ls_contents)
					fileclose(li_file2)
					ls_defaultinfo = printgetprinter()
					ls_defaultprinter = left(ls_defaultinfo, pos(ls_defaultinfo, "~t") - 1)
					printsetprinter(ls_printer)
					ll_job = printopen("waseela", false)
					if ll_job = -1 then
						messagebox("Error", "Unable to Open Print Job for Label printing")
					else
						printsend(ll_job, ls_contents)
						printclose(ll_job)
					end if
					printsetprinter(trim(ls_defaultprinter))
				end if
			end if
		end if
	end if
	return 0
