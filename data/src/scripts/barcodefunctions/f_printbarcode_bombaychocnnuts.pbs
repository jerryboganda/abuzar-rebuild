// function f_printbarcode_bombaychocnnuts (barcodefunctions)  ancestor: function_object

// f_printbarcode_bombaychocnnuts.f_printbarcode_bombaychocnnuts(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 21)
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if lower(ls_printer) = lower("Zebra S4M (200dpi)") then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			ll_supply_cols_per_row = 3
			if ll_totalrows > 0 then
				ll_counter = 1
				li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
				if li_file = -1 then
					messagebox("Error", "Unable to locate file for Label printing")
				else
					filewrite(li_file, "^XATA000JSN^LT0^MNW^MTD^PON^PMN^LH0,0^JMA^PR4,4SD15^JUS^LRN^CI0^XZ")
					ll_labelno = 1
					for ll_counter = 1 to ll_totalrows
						if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
							ll_qty = id_detail.getitemnumber(ll_counter, "qty")
							ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 29)
							ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
							ls_infocode = trim(string(id_master.object.code[1]))
							if ib_printprice then
								ls_price = trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
							else
								ls_price = ""
							end if
							for ll_innercounter = 1 to ll_qty
								ll_labelpos = ll_labelno mod ll_supply_cols_per_row
								if ll_labelpos = 1 then
									filewrite(li_file, "^XA")
									filewrite(li_file, "^MMT")
									filewrite(li_file, "^LL0152")
									filewrite(li_file, "^PW719")
									filewrite(li_file, "^LS0")
								end if
								if ll_labelpos = 1 then
									ls_xpos = "12"
								elseif ll_labelpos = 2 then
									ls_xpos = "260"
								else
									ls_xpos = "508"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",24^A0N,20,55^FH\^FDBOMBAY^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "43"
								elseif ll_labelpos = 2 then
									ls_xpos = "291"
								else
									ls_xpos = "539"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",42^A0N,14,24^FH\^FDCHOC n NUTS^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "8"
								elseif ll_labelpos = 2 then
									ls_xpos = "256"
								else
									ls_xpos = "504"
								end if
								ls_filecontent = "^BY2,3,45^FT" + ls_xpos + ",90^BCN,,Y,N"
								filewrite(li_file, ls_filecontent)
								ls_filecontent = "^FD>:" + ls_aliasname + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "3"
								elseif ll_labelpos = 2 then
									ls_xpos = "251"
								else
									ls_xpos = "499"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",124^A0N,14,14^FH\^FD" + ls_itemname + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "7"
								elseif ll_labelpos = 2 then
									ls_xpos = "255"
								else
									ls_xpos = "503"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",147^A0N,20,33^FH\^FDRS. " + ls_price + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "205"
								elseif ll_labelpos = 2 then
									ls_xpos = "453"
								else
									ls_xpos = "701"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",110^A0B,19,21^FH\^FD" + ls_infocode + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 0 then
									filewrite(li_file, "^PQ1,0,1,Y^XZ")
								end if
								ll_labelno = ll_labelno + 1
							next
						end if
					next
					if ll_labelpos > 0 then
						filewrite(li_file, "^PQ1,0,1,Y^XZ")
					end if
					fileclose(li_file)
					run("..\BarcodePrint\BP.bat", normal!)
				end if
			end if
		elseif ls_format = "2" then
			ll_supply_cols_per_row = 2
			if ll_totalrows > 0 then
				ll_counter = 1
				li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
				if li_file = -1 then
					messagebox("Error", "Unable to locate file for Label printing")
				else
					filewrite(li_file, "^XATA000JSN^LT0^MNW^MTD^PON^PMN^LH0,0^JMA^PR4,4SD15^JUS^LRN^CI0^XZ")
					ll_labelno = 1
					for ll_counter = 1 to ll_totalrows
						if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
							ll_qty = id_detail.getitemnumber(ll_counter, "qty")
							ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 35)
							ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
							ls_infocode = trim(string(id_master.object.code[1]))
							if ib_printprice then
								ls_price = trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
							else
								ls_price = ""
							end if
							for ll_innercounter = 1 to ll_qty
								ll_labelpos = ll_labelno mod ll_supply_cols_per_row
								if ll_labelpos = 1 then
									filewrite(li_file, "^XA")
									filewrite(li_file, "^MMT")
									filewrite(li_file, "^LL0224")
									filewrite(li_file, "^PW631")
									filewrite(li_file, "^LS0")
								end if
								if ll_labelpos = 1 then
									ls_xpos = "10"
								else
									ls_xpos = "338"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",33^A0N,25,79^FH\^FDBOMBAY^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "59"
								else
									ls_xpos = "387"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",54^A0N,18,33^FH\^FDCHOC n NUTS^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "14"
								else
									ls_xpos = "342"
								end if
								ls_filecontent = "^BY2,3,89^FT" + ls_xpos + ",148^BCN,,Y,N"
								filewrite(li_file, ls_filecontent)
								ls_filecontent = "^FD>:" + ls_aliasname + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "287"
								else
									ls_xpos = "615"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",172^A0B,27,31^FH\^FD" + ls_infocode + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "12"
								else
									ls_xpos = "340"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",191^A0N,18,16^FH\^FD" + ls_itemname + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "14"
								else
									ls_xpos = "342"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",218^A0N,22,45^FH\^FDRS. " + ls_price + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 0 then
									filewrite(li_file, "^PQ1,0,1,Y^XZ")
								end if
								ll_labelno = ll_labelno + 1
							next
						end if
					next
					if ll_labelpos > 0 then
						filewrite(li_file, "^PQ1,0,1,Y^XZ")
					end if
					fileclose(li_file)
					run("..\BarcodePrint\BP.bat", normal!)
				end if
			end if
		end if
	end if
	return 0
