// function f_printbarcode_bhattisuperstore (barcodefunctions)  ancestor: function_object

// f_printbarcode_bhattisuperstore.f_printbarcode_bhattisuperstore(datawindow id_master, datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_packing
	string ls_expiry
	string ls_mfg
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_disc
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if lower(ls_printer) = lower("TSC ME240") then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			ll_supply_cols_per_row = 2
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC ME240")
				tsc_setup_new("76.10", "28.7", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 1,0")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 30)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "###,##0.00"))
						else
							ls_price = ""
						end if
						ls_disc = "Dis Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "flatdisc"), 0), "####0"))
						if id_detail.getitemdecimal(ll_counter, "flatdisc") = 0 then
							ls_disc = ""
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_windowsfont_new(45, 10, 25, 0, 2, 0, "Times new Roman", ls_clientname)
						tsc_windowsfont_new(375, 10, 25, 0, 2, 0, "Times new Roman", ls_clientname)
						tsc_barcode_new("45", "65", "128", "73", "0", "0", "2", "3", ls_aliasname)
						tsc_barcode_new("375", "65", "128", "73", "0", "0", "2", "3", ls_aliasname)
						tsc_windowsfont_new(45, 138, 25, 0, 2, 0, "Times new Roman", ls_aliasname)
						tsc_windowsfont_new(375, 138, 25, 0, 2, 0, "Times new Roman", ls_aliasname)
						tsc_windowsfont_new(203, 138, 25, 0, 2, 0, "Times new Roman", ls_disc)
						tsc_windowsfont_new(535, 138, 25, 0, 2, 0, "Times new Roman", ls_disc)
						tsc_windowsfont_new(45, 164, 20, 0, 2, 0, "Arial", ls_itemname)
						tsc_windowsfont_new(375, 164, 20, 0, 2, 0, "Arial", ls_itemname)
						tsc_windowsfont_new(45, 178, 35, 0, 2, 0, "Times new Roman", ls_price)
						tsc_windowsfont_new(375, 178, 35, 0, 2, 0, "Times new Roman", ls_price)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "2" then
			ll_supply_cols_per_row = 2
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC ME240")
				tsc_setup_new("76.10", "28.7", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 1,0")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 30)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "###,##0.00"))
						else
							ls_price = ""
						end if
						ls_disc = "Dis Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "flatdisc"), 0), "####0"))
						if id_detail.getitemdecimal(ll_counter, "flatdisc") = 0 then
							ls_disc = ""
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_barcode_new("45", "65", "128", "73", "0", "0", "2", "3", ls_aliasname)
						tsc_barcode_new("375", "65", "128", "73", "0", "0", "2", "3", ls_aliasname)
						tsc_windowsfont_new(45, 138, 25, 0, 2, 0, "Times new Roman", ls_aliasname)
						tsc_windowsfont_new(375, 138, 25, 0, 2, 0, "Times new Roman", ls_aliasname)
						tsc_windowsfont_new(203, 138, 25, 0, 2, 0, "Times new Roman", ls_disc)
						tsc_windowsfont_new(535, 138, 25, 0, 2, 0, "Times new Roman", ls_disc)
						tsc_windowsfont_new(45, 164, 20, 0, 2, 0, "Arial", ls_itemname)
						tsc_windowsfont_new(375, 164, 20, 0, 2, 0, "Arial", ls_itemname)
						tsc_windowsfont_new(45, 178, 35, 0, 2, 0, "Times new Roman", ls_price)
						tsc_windowsfont_new(375, 178, 35, 0, 2, 0, "Times new Roman", ls_price)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "3" then
			ll_supply_cols_per_row = 2
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC ME240")
				tsc_setup_new("76.10", "28.7", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 1,0")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 30)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "###,##0.00"))
						else
							ls_price = ""
						end if
						ls_disc = "Dis Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "flatdisc"), 0), "####0"))
						if id_detail.getitemdecimal(ll_counter, "flatdisc") = 0 then
							ls_disc = ""
						end if
						ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						if isnull(ls_mfg) then
							ls_mfg = ""
						end if
						if isnull(ls_expiry) then
							ls_expiry = ""
						end if
						if len(ls_mfg) > 0 then
							ls_expiry = ls_mfg + space(2) + ls_expiry
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_windowsfont_new(45, 10, 25, 0, 2, 0, "Times new Roman", ls_clientname)
						tsc_windowsfont_new(375, 10, 25, 0, 2, 0, "Times new Roman", ls_clientname)
						tsc_barcode_new("45", "38", "128", "75", "0", "0", "2", "3", ls_aliasname)
						tsc_barcode_new("375", "38", "128", "75", "0", "0", "2", "3", ls_aliasname)
						tsc_windowsfont_new(45, 113, 25, 0, 2, 0, "Times new Roman", ls_aliasname)
						tsc_windowsfont_new(375, 113, 25, 0, 2, 0, "Times new Roman", ls_aliasname)
						tsc_windowsfont_new(203, 113, 25, 0, 2, 0, "Times new Roman", ls_disc)
						tsc_windowsfont_new(535, 113, 25, 0, 2, 0, "Times new Roman", ls_disc)
						tsc_windowsfont_new(45, 139, 20, 0, 2, 0, "Arial", ls_itemname)
						tsc_windowsfont_new(375, 139, 20, 0, 2, 0, "Arial", ls_itemname)
						tsc_windowsfont_new(45, 164, 15, 0, 2, 0, "Arial", ls_expiry)
						tsc_windowsfont_new(375, 164, 15, 0, 2, 0, "Arial", ls_expiry)
						tsc_windowsfont_new(45, 178, 35, 0, 2, 0, "Times new Roman", ls_price)
						tsc_windowsfont_new(375, 178, 35, 0, 2, 0, "Times new Roman", ls_price)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "4" then
			ll_supply_cols_per_row = 3
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC ME240")
				tsc_setup_new("105", "25.5", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 1,0")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 30)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "###,##0.00"))
						else
							ls_price = ""
						end if
						ls_disc = "Dis Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "flatdisc"), 0), "####0"))
						if id_detail.getitemdecimal(ll_counter, "flatdisc") = 0 then
							ls_disc = ""
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_windowsfont_new(20, 10, 25, 0, 2, 0, "Times new Roman", ls_clientname)
						tsc_windowsfont_new(298, 10, 25, 0, 2, 0, "Times new Roman", ls_clientname)
						tsc_windowsfont_new(575, 10, 25, 0, 2, 0, "Times new Roman", ls_clientname)
						tsc_barcode_new("20", "40", "128", "70", "0", "0", "2", "2", ls_aliasname)
						tsc_barcode_new("298", "40", "128", "70", "0", "0", "2", "2", ls_aliasname)
						tsc_barcode_new("575", "40", "128", "70", "0", "0", "2", "2", ls_aliasname)
						tsc_windowsfont_new(20, 115, 20, 0, 2, 0, "Times new Roman", ls_aliasname)
						tsc_windowsfont_new(298, 115, 20, 0, 2, 0, "Times new Roman", ls_aliasname)
						tsc_windowsfont_new(575, 115, 20, 0, 2, 0, "Times new Roman", ls_aliasname)
						tsc_windowsfont_new(170, 115, 20, 0, 2, 0, "Times new Roman", ls_disc)
						tsc_windowsfont_new(450, 115, 20, 0, 2, 0, "Times new Roman", ls_disc)
						tsc_windowsfont_new(720, 115, 20, 0, 2, 0, "Times new Roman", ls_disc)
						tsc_windowsfont_new(20, 140, 20, 0, 2, 0, "Arial", ls_itemname)
						tsc_windowsfont_new(298, 140, 20, 0, 2, 0, "Arial", ls_itemname)
						tsc_windowsfont_new(575, 140, 20, 0, 2, 0, "Arial", ls_itemname)
						tsc_windowsfont_new(20, 160, 35, 0, 2, 0, "Times new Roman", ls_price)
						tsc_windowsfont_new(298, 160, 35, 0, 2, 0, "Times new Roman", ls_price)
						tsc_windowsfont_new(575, 160, 35, 0, 2, 0, "Times new Roman", ls_price)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		end if
	end if
	return 0
