// function f_printbarcode_amermedicalstor (barcodefunctions)  ancestor: function_object

// f_printbarcode_amermedicalstor.f_printbarcode_amermedicalstor(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	long ll_job
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	integer li_file2
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_contents
	string ls_manfdate
	string ls_defaultinfo
	string ls_defaultprinter
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if lower(ls_printer) = lower("Xprinter XP-360B") then
		li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
		if li_file = -1 then
			messagebox("Error", "Unable to locate file for Label printing")
			return 0
		else
			ls_filecontent = "SIZE 40 mm, 30 mm"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "GAP 3 mm,0"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "DENSITY 8"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "SPEED 6"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "DIRECTION 1"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "REFERENCE 0,0"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "OFFSET 0 mm"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "SET TEAR OFF"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "SET PEEL OFF"
			filewrite(li_file, ls_filecontent)
			for ll_counter = 1 to ll_totalrows
				if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					if ib_printprice then
						ls_price = "Rs.: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "###,###,##0.00"))
					else
						ls_price = ""
					end if
					ls_filecontent = "CLS"
					filewrite(li_file, ls_filecontent)
					ls_filecontent = "CODEPAGE 1252"
					filewrite(li_file, ls_filecontent)
					ls_filecontent = "TEXT 20,15,~"2~",0,1,1,~"" + ls_clientname + "~""
					filewrite(li_file, ls_filecontent)
					ls_filecontent = "BARCODE 20,40,~"128~",65,0,0,2,5,~"" + ls_aliasname + "~""
					filewrite(li_file, ls_filecontent)
					ls_filecontent = "TEXT 20,109,~"2~",0,1,1,~"" + ls_aliasname + "~""
					filewrite(li_file, ls_filecontent)
					ls_filecontent = "TEXT 20,135,~"2~",0,1,1,~"" + left(ls_itemname, 20) + "~""
					filewrite(li_file, ls_filecontent)
					ls_filecontent = "TEXT 20,163,~"2~",0,1,1,~"" + mid(ls_itemname, 21, 20) + "~""
					filewrite(li_file, ls_filecontent)
					ls_filecontent = "TEXT 20,192,~"3~",0,1,1,~"" + ls_price + "~""
					filewrite(li_file, ls_filecontent)
					ls_filecontent = "PRINT 1," + trim(string(ll_qty))
					filewrite(li_file, ls_filecontent)
				end if
			next
			fileclose(li_file)
			li_file2 = fileopen("label.prn", textmode!, read!, lockread!)
			if li_file2 = -1 then
				messagebox("Error", "Unable to locate file for Label printing")
				return 0
			else
				filereadex(li_file2, ls_contents)
				fileclose(li_file2)
				ls_defaultinfo = printgetprinter()
				ls_defaultprinter = left(ls_defaultinfo, pos(ls_defaultinfo, "~t") - 1)
				printsetprinter("Xprinter XP-360B")
				ll_job = printopen("waseela", false)
				if ll_job = -1 then
					messagebox("Error", "Unable to Open Print Job for Label printing")
				else
					printsend(ll_job, ls_contents)
					printclose(ll_job)
				end if
				printsetprinter(trim(ls_defaultprinter))
			end if
		end if
	end if
	return 0
