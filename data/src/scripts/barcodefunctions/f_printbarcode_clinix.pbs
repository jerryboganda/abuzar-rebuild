// function f_printbarcode_clinix (barcodefunctions)  ancestor: function_object

// f_printbarcode_clinix.f_printbarcode_clinix(datawindow id_master, datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_remarks
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_packing
	string ls_expdate
	string ls_expiry
	string ls_mfg
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_date = "PD:" + trim(string(today(), "dd-mm-yy"))
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if upper(ls_printer) = "TSC ME240" then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			ll_supply_cols_per_row = 2
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC ME240")
				tsc_setup_new("80", "28.7", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER ON")
				tsc_sendcommand_new("SET TEAR ON")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 25)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						if isnull(ls_mfg) then
							ls_mfg = ""
						end if
						if isnull(ls_expiry) then
							ls_expiry = ""
						end if
						if len(ls_mfg) > 0 then
							ls_expiry = ls_mfg + space(2) + ls_expiry
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_printerfont_new("270", "230", "0", "180", "8", "8", ls_clientname)
						tsc_printerfont_new("600", "230", "0", "180", "8", "8", ls_clientname)
						tsc_barcode_new("270", "203", "128", "70", "1", "180", "2", "3", ls_aliasname)
						tsc_barcode_new("600", "203", "128", "70", "1", "180", "2", "3", ls_aliasname)
						tsc_printerfont_new("270", "106", "0", "180", "8", "6", ls_itemname)
						tsc_printerfont_new("600", "106", "0", "180", "8", "6", ls_itemname)
						tsc_printerfont_new("270", "79", "0", "180", "10", "10", ls_price)
						tsc_printerfont_new("600", "79", "0", "180", "10", "10", ls_price)
						tsc_printerfont_new("270", "50", "0", "180", "8", "8", ls_expiry)
						tsc_printerfont_new("600", "50", "0", "180", "8", "8", ls_expiry)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "2" then
			ll_supply_cols_per_row = 2
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC ME240")
				tsc_setup_new("80", "28.7", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER ON")
				tsc_sendcommand_new("SET TEAR ON")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						if isnull(ls_mfg) then
							ls_mfg = ""
						end if
						if isnull(ls_expiry) then
							ls_expiry = ""
						end if
						if len(ls_mfg) > 0 then
							ls_expiry = ls_mfg + space(2) + ls_expiry
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_printerfont_new("270", "230", "0", "180", "8", "8", ls_clientname)
						tsc_printerfont_new("600", "230", "0", "180", "8", "8", ls_clientname)
						tsc_barcode_new("270", "203", "128", "70", "1", "180", "2", "3", ls_aliasname)
						tsc_barcode_new("600", "203", "128", "70", "1", "180", "2", "3", ls_aliasname)
						tsc_printerfont_new("270", "106", "0", "180", "8", "6", left(ls_itemname, 25))
						tsc_printerfont_new("600", "106", "0", "180", "8", "6", left(ls_itemname, 25))
						tsc_printerfont_new("270", "85", "0", "180", "8", "6", mid(ls_itemname, 26, 25))
						tsc_printerfont_new("600", "85", "0", "180", "8", "6", mid(ls_itemname, 26, 25))
						tsc_printerfont_new("270", "60", "0", "180", "12", "12", ls_price)
						tsc_printerfont_new("600", "60", "0", "180", "12", "12", ls_price)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "3" then
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC ME240")
				tsc_setup_new("100", "40", "5", "15", "0", "1", "0")
				tsc_sendcommand_new("DIRECTION 1,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						ls_remarks = id_detail.object.remarks[ll_counter]
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
						tsc_clearbuffer_new()
						tsc_barcode_new("120", "30", "128", "80", "1", "0", "2", "3", ls_aliasname)
						tsc_windowsfont_new(120, 130, 35, 0, 2, 0, "Arial", left(ls_itemname, 20))
						tsc_windowsfont_new(120, 158, 35, 0, 2, 0, "Arial", mid(ls_itemname, 21, 40))
						tsc_windowsfont_new(120, 185, 40, 0, 2, 0, "Arial", ls_price)
						tsc_printlabel_new("1", string(ll_qty))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "4" then
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC ME240")
				tsc_setup_new("100", "25", "5", "15", "0", "3", "0")
				tsc_sendcommand_new("DIRECTION 1,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						ls_remarks = id_detail.object.remarks[ll_counter]
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
						tsc_clearbuffer_new()
						tsc_windowsfont_new(60, 5, 35, 0, 2, 0, "Arial", left(ls_itemname, 20))
						tsc_windowsfont_new(60, 35, 35, 0, 2, 0, "Arial", trim(mid(ls_itemname, 21, 40)))
						tsc_windowsfont_new(60, 70, 40, 0, 2, 0, "Arial", ls_price)
						tsc_barcode_new("60", "110", "128", "50", "1", "0", "2", "3", ls_aliasname)
						tsc_printlabel_new("1", string(ll_qty))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "5" and ll_totalrows > 0 then
			ll_counter = 1
			tsc_openport_new("TSC ME240")
			tsc_setup_new("100", "25", "5", "15", "0", "3", "0")
			tsc_sendcommand_new("DIRECTION 1,0")
			tsc_sendcommand_new("REFERENCE 0,0")
			tsc_sendcommand_new("OFFSET 0 mm")
			tsc_sendcommand_new("SHIFT 0")
			for ll_counter = 1 to ll_totalrows
				if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					ls_remarks = id_detail.object.remarks[ll_counter]
					if ib_printprice then
						ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
					else
						ls_price = ""
					end if
					ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
					tsc_clearbuffer_new()
					tsc_windowsfont_new(60, 5, 35, 0, 2, 0, "Arial", left(ls_itemname, 20))
					tsc_windowsfont_new(60, 35, 35, 0, 2, 0, "Arial", trim(mid(ls_itemname, 21, 40)))
					tsc_windowsfont_new(60, 70, 35, 0, 2, 0, "Arial", trim(mid(ls_itemname, 41, 60)))
					tsc_windowsfont_new(60, 105, 80, 0, 2, 0, "Arial", ls_price)
					tsc_printlabel_new("1", string(ll_qty))
				end if
			next
			tsc_closeport_new()
		end if
	end if
	return 0
