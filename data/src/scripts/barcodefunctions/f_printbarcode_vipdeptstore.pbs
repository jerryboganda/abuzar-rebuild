// function f_printbarcode_vipdeptstore (barcodefunctions)  ancestor: function_object

// f_printbarcode_vipdeptstore.f_printbarcode_vipdeptstore(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_itemname2
	string ls_expiry
	string ls_mfg
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if upper(ls_printer) = "TSC TTP-244 PLUS" then
		ls_format = id_master.object.labelformat[1]
		ll_labelno = 1
		if ll_totalrows > 0 then
			ll_counter = 1
			tsc_openport_new("TSC TTP-244 PLUS")
			tsc_setup_new("38.1", "28.57", "4", "8", "0", "2", "0")
			tsc_sendcommand_new("DIRECTION 0,0")
			tsc_sendcommand_new("REFERENCE 0,0")
			tsc_sendcommand_new("OFFSET 0 mm")
			tsc_sendcommand_new("SHIFT 0")
			tsc_sendcommand_new("SET PEEL OFF")
			tsc_sendcommand_new("SET CUTTER OFF")
			tsc_sendcommand_new("SET TEAR ON")
			tsc_sendcommand_new("CLS")
			tsc_sendcommand_new("CODEPAGE 850")
			for ll_counter = 1 to ll_totalrows
				if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = trim(left(trim(id_detail.getitemstring(ll_counter, "itemname")), 25))
					ls_itemname2 = trim(mid(trim(id_detail.getitemstring(ll_counter, "itemname")), 26, 25))
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					ls_expiry = string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
					if not isnull(ls_expiry) then
						ls_expiry = "Exp:" + ls_expiry
					end if
					ls_mfg = string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
					if not isnull(ls_mfg) then
						ls_mfg = "Pkd:" + ls_mfg
					end if
					if ib_printprice then
						ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
					else
						ls_price = ""
					end if
					tsc_clearbuffer_new()
					ll_tot_label_rows = ll_qty
					tsc_printerfont_new("288", "198", "0", "180", "11", "9", ls_clientname)
					tsc_barcode_new("288", "171", "128", "65", "0", "180", "2", "3", ls_aliasname)
					tsc_printerfont_new("288", "104", "0", "180", "8", "8", ls_aliasname)
					tsc_printerfont_new("288", "81", "0", "180", "8", "8", ls_itemname)
					tsc_printerfont_new("288", "58", "0", "180", "8", "8", ls_itemname2)
					tsc_printerfont_new("288", "35", "0", "180", "13", "11", ls_price)
					tsc_printerfont_new("400", "36", "0", "180", "5", "5", ls_mfg)
					tsc_printerfont_new("400", "23", "0", "180", "5", "5", ls_expiry)
					tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
				end if
			next
			tsc_closeport_new()
		end if
	end if
	return 0
