// function f_printbarcode_unitedcorp (barcodefunctions)  ancestor: function_object

// f_printbarcode_unitedcorp.f_printbarcode_unitedcorp(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_phone
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_packing
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = "MEHRAN AUTOS"
	ls_phone = "03125566380 / 0515566380"
	li_barcodeleninprint = 25
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if lower(ls_printer) = lower("TSC TTP-244 PLUS") then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			ll_supply_cols_per_row = 2
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PLUS")
				tsc_setup_new("106.7", "34.9", "8", "7", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER OFF")
				tsc_sendcommand_new("SET TEAR ON")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = trim(id_detail.getitemstring(ll_counter, "fullcode"))
						ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_printerfont_new("832", "263", "0", "180", "11", "7", ls_clientname)
						tsc_printerfont_new("400", "263", "0", "180", "11", "7", ls_clientname)
						tsc_printerfont_new("832", "238", "0", "180", "8", "7", ls_phone)
						tsc_printerfont_new("400", "238", "0", "180", "8", "7", ls_phone)
						tsc_printerfont_new("832", "213", "0", "180", "8", "7", left(ls_itemname, 38))
						tsc_printerfont_new("400", "213", "0", "180", "8", "7", left(ls_itemname, 38))
						tsc_barcode_new("832", "185", "39", "116", "0", "180", "1", "3", left(ls_aliasname, 20))
						tsc_barcode_new("400", "185", "39", "116", "0", "180", "1", "3", left(ls_aliasname, 20))
						tsc_printerfont_new("832", "65", "0", "180", "8", "7", ls_aliasname)
						tsc_printerfont_new("400", "65", "0", "180", "8", "7", ls_aliasname)
						tsc_printerfont_new("832", "40", "0", "180", "8", "7", ls_packing)
						tsc_printerfont_new("400", "40", "0", "180", "8", "7", ls_packing)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "2" and ll_totalrows > 0 then
			ll_counter = 1
			tsc_openport_new("TSC TTP-244 PLUS")
			tsc_setup_new("38.1", "28.57", "8", "7", "0", "3", "0")
			tsc_sendcommand_new("DIRECTION 1,0")
			for ll_counter = 1 to ll_totalrows
				if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), 20)
					if ib_printprice then
						ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
					else
						ls_price = ""
					end if
					ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
					tsc_clearbuffer_new()
					tsc_printerfont_new("15", "18", "2", "0", "1", "1", left(ls_itemname, 20))
					if len(ls_itemname) > 20 then
						tsc_printerfont_new("15", "40", "2", "0", "1", "1", mid(ls_itemname, 21, 40))
					end if
					tsc_barcode_new("12", "65", "128", "90", "0", "0", "1", "1", ls_aliasname)
					tsc_windowsfont_new(12, 158, 25, 0, 0, 0, "arial", ls_aliasname)
					if not isnull(ls_packing) then
						tsc_printerfont_new("15", "183", "2", "0", "1", "1", left(ls_packing, 20))
					end if
					tsc_printlabel_new("1", string(ll_qty))
				end if
			next
			tsc_closeport_new()
		end if
	end if
	return 0
