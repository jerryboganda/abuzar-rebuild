// function f_printbarcode_newbombaydryfruit (barcodefunctions)  ancestor: function_object

// f_printbarcode_newbombaydryfruit.f_printbarcode_newbombaydryfruit(datawindow id_master, datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	long ll_modvalue
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_itemname2
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	boolean lb_printlineexists
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	if gs_company = "BOMBAYDRYFRUIT" then
		ls_clientname = " NEW BOMBAY DRY FRUIT "
	end if
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if lower(ls_printer) = lower("Zebra TLP 2844") and ll_totalrows > 0 then
		ll_counter = 1
		li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
		if li_file = -1 then
			messagebox("Error", "Unable to locate file for Label printing")
		else
			ll_supply_cols_per_row = 3
			ll_labelno = 1
			for ll_counter = 1 to ll_totalrows
				if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 20)
					ls_itemname2 = mid(trim(id_detail.getitemstring(ll_counter, "itemname")), 21, 40)
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					ls_infocode = trim(string(id_master.object.code[1]))
					if isnull(ls_infocode) then
						ls_infocode = ""
					end if
					if ib_printprice then
						ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 0)))
					else
						ls_price = ""
					end if
					if int(ll_qty / ll_supply_cols_per_row) > 0 then
						filewrite(li_file, "")
						filewrite(li_file, "O")
						filewrite(li_file, "Q175,1")
						filewrite(li_file, "q719")
						filewrite(li_file, "S4")
						filewrite(li_file, "D7")
						filewrite(li_file, "ZT")
						filewrite(li_file, "JB")
						filewrite(li_file, "")
						filewrite(li_file, "N")
						ls_filecontent = "A05,2,0,1,1,2,R,~"" + ls_clientname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "B20,27,0,1,2,0,48,N,~"" + ls_aliasname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A70,80,0,1,1,1,N,~"" + ls_aliasname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A215,32,1,1,1,1,N,~"" + ls_infocode + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A05,95,0,1,1,1,N,~"" + ls_itemname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A32,111,0,1,2,2,N,~"" + ls_price + "~""
						filewrite(li_file, ls_filecontent)
						filewrite(li_file, "")
						ls_filecontent = "A255,2,0,1,1,2,R,~"" + ls_clientname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "B265,27,0,1,2,0,48,N,~"" + ls_aliasname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A304,80,0,1,1,1,N,~"" + ls_aliasname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A465,32,1,1,1,1,N,~"" + ls_infocode + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A255,95,0,1,1,1,N,~"" + ls_itemname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A282,111,0,1,2,2,N,~"" + ls_price + "~""
						filewrite(li_file, ls_filecontent)
						filewrite(li_file, "")
						ls_filecontent = "A505,2,0,1,1,2,R,~"" + ls_clientname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "B517,27,0,1,2,0,48,N,~"" + ls_aliasname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A562,80,0,1,1,1,N,~"" + ls_aliasname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A715,32,1,1,1,1,N,~"" + ls_infocode + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A505,95,0,1,1,1,N,~"" + ls_itemname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A540,111,0,1,2,2,N,~"" + ls_price + "~""
						filewrite(li_file, ls_filecontent)
						filewrite(li_file, "P" + trim(string(int(ll_qty / ll_supply_cols_per_row))))
						lb_printlineexists = true
					end if
					ll_modvalue = ll_qty mod ll_supply_cols_per_row
					if ll_modvalue > 0 then
						filewrite(li_file, "")
						filewrite(li_file, "O")
						filewrite(li_file, "Q175,1")
						filewrite(li_file, "q719")
						filewrite(li_file, "S4")
						filewrite(li_file, "D7")
						filewrite(li_file, "ZT")
						filewrite(li_file, "JB")
						filewrite(li_file, "")
						filewrite(li_file, "N")
						if ll_modvalue >= 1 then
							ls_filecontent = "A05,2,0,1,1,2,R,~"" + ls_clientname + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "B20,27,0,1,2,0,48,N,~"" + ls_aliasname + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "A70,80,0,1,1,1,N,~"" + ls_aliasname + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "A215,32,1,1,1,1,N,~"" + ls_infocode + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "A05,95,0,1,1,1,N,~"" + ls_itemname + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "A32,111,0,1,2,2,N,~"" + ls_price + "~""
							filewrite(li_file, ls_filecontent)
						end if
						if ll_modvalue >= 2 then
							filewrite(li_file, "")
							ls_filecontent = "A255,2,0,1,1,2,R,~"" + ls_clientname + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "B265,27,0,1,2,0,48,N,~"" + ls_aliasname + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "A304,80,0,1,1,1,N,~"" + ls_aliasname + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "A465,32,1,1,1,1,N,~"" + ls_infocode + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "A255,95,0,1,1,1,N,~"" + ls_itemname + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "A282,111,0,1,2,2,N,~"" + ls_price + "~""
							filewrite(li_file, ls_filecontent)
						end if
						filewrite(li_file, "P1")
						lb_printlineexists = true
					end if
				end if
			next
			fileclose(li_file)
			run("..\BarcodePrint\BP.bat", normal!)
		end if
	end if
	return 0
