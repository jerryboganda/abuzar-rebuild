// function f_printbarcode_zamzama (barcodefunctions)  ancestor: function_object

// f_printbarcode_zamzama.f_printbarcode_zamzama(datawindow id_master, datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if upper(ls_printer) = "TSC TTP-244 PLUS" then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			ll_supply_cols_per_row = 3
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PLUS")
				tsc_setup_new("89.6", "19.1", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER OFF")
				tsc_sendcommand_new("SET TEAR OFF")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 35)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_printerfont_new("701", "32", "0", "180", "9", "6", ls_price)
						tsc_printerfont_new("454", "32", "0", "180", "9", "6", ls_price)
						tsc_printerfont_new("207", "32", "0", "180", "9", "6", ls_price)
						tsc_printerfont_new("701", "48", "0", "180", "6", "6", ls_itemname)
						tsc_printerfont_new("454", "48", "0", "180", "6", "6", ls_itemname)
						tsc_printerfont_new("207", "48", "0", "180", "6", "6", ls_itemname)
						tsc_barcode_new("701", "123", "39", "50", "1", "180", "1", "3", ls_aliasname)
						tsc_barcode_new("454", "123", "39", "50", "1", "180", "1", "3", ls_aliasname)
						tsc_barcode_new("207", "123", "39", "50", "1", "180", "1", "3", ls_aliasname)
						tsc_printerfont_new("701", "150", "0", "180", "8", "6", ls_clientname)
						tsc_printerfont_new("454", "150", "0", "180", "8", "6", ls_clientname)
						tsc_printerfont_new("207", "150", "0", "180", "8", "6", ls_clientname)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_formfeed_new()
				tsc_closeport_new()
			end if
		elseif ls_format = "2" then
			ll_supply_cols_per_row = 2
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PLUS")
				tsc_setup_new("76.10", "28.7", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER OFF")
				tsc_sendcommand_new("SET TEAR OFF")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 25)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_printerfont_new("604", "225", "0", "180", "7", "10", ls_clientname)
						tsc_printerfont_new("275", "225", "0", "180", "7", "10", ls_clientname)
						tsc_barcode_new("604", "190", "39", "80", "1", "180", "2", "5", ls_aliasname)
						tsc_barcode_new("275", "190", "39", "80", "1", "180", "2", "5", ls_aliasname)
						tsc_printerfont_new("604", "85", "0", "180", "8", "6", ls_itemname)
						tsc_printerfont_new("275", "85", "0", "180", "8", "6", ls_itemname)
						tsc_printerfont_new("604", "65", "0", "180", "9", "8", ls_price)
						tsc_printerfont_new("275", "65", "0", "180", "9", "8", ls_price)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		else
			ll_supply_cols_per_row = 2
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PLUS")
				tsc_setup_new("76.10", "28.7", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER OFF")
				tsc_sendcommand_new("SET TEAR OFF")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 25)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_printerfont_new("604", "225", "0", "180", "7", "10", ls_clientname)
						tsc_printerfont_new("275", "225", "0", "180", "7", "10", ls_clientname)
						tsc_printerfont_new("604", "190", "0", "180", "7", "10", ls_aliasname)
						tsc_printerfont_new("275", "190", "0", "180", "7", "10", ls_aliasname)
						tsc_printerfont_new("604", "155", "0", "180", "7", "10", ls_itemname)
						tsc_printerfont_new("275", "155", "0", "180", "7", "10", ls_itemname)
						tsc_printerfont_new("604", "115", "0", "180", "25", "25", ls_price)
						tsc_printerfont_new("275", "115", "0", "180", "25", "25", ls_price)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		end if
	elseif ls_printer = "Zebra ZM 400 (200dpi)" then
		ls_clientname = "ZamZama Super Store"
		if ll_totalrows > 0 then
			ll_counter = 1
			li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
			if li_file = -1 then
				messagebox("Error", "Unable to locate file for Label printing")
			else
				ls_format = id_master.object.labelformat[1]
				if ls_format = "1" then
					ll_supply_cols_per_row = 3
					filewrite(li_file, "CT~~CD,~~CC^~~CT~~")
					filewrite(li_file, "^XATA000JSN^LT0^MNW^MTT^PON^PMN^LH0,0^JMA^PR2,2SD20^JUS^LRN^CI0^XZ")
					ll_labelno = 1
					for ll_counter = 1 to ll_totalrows
						if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
							ll_qty = id_detail.getitemnumber(ll_counter, "qty")
							ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 31)
							ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
							if ib_printprice then
								ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "##,###,###.#0"))
							else
								ls_price = ""
							end if
							ls_date = string(today(), "dd/mm")
							for ll_innercounter = 1 to ll_qty
								ll_labelpos = ll_labelno mod ll_supply_cols_per_row
								if ll_labelpos = 1 then
									filewrite(li_file, "^XA")
									filewrite(li_file, "^MMT")
									filewrite(li_file, "^PW735")
									filewrite(li_file, "^LL0152")
									filewrite(li_file, "^LS0")
								end if
								if ll_labelpos = 1 then
									ls_xpos = "7"
								elseif ll_labelpos = 2 then
									ls_xpos = "263"
								elseif ll_labelpos = 0 then
									ls_xpos = "518"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",22^A0N,19,24^FH\^FD" + ls_clientname + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "13"
								elseif ll_labelpos = 2 then
									ls_xpos = "269"
								elseif ll_labelpos = 0 then
									ls_xpos = "524"
								end if
								ls_filecontent = "^BY2,3,63^FT" + ls_xpos + ",90^BCN,,Y,N"
								filewrite(li_file, ls_filecontent)
								filewrite(li_file, "^FD>:" + ls_aliasname + "^FS")
								if ll_labelpos = 1 then
									ls_xpos = "4"
								elseif ll_labelpos = 2 then
									ls_xpos = "260"
								elseif ll_labelpos = 0 then
									ls_xpos = "515"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",126^A0N,16,14^FH\^FD" + ls_itemname + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "9"
								elseif ll_labelpos = 2 then
									ls_xpos = "265"
								elseif ll_labelpos = 0 then
									ls_xpos = "520"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",146^A0N,16,45^FH\^FD" + ls_price + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 0 then
									filewrite(li_file, "^PQ1,0,1,Y^XZ")
								end if
								ll_labelno = ll_labelno + 1
							next
						end if
					next
				else
					ll_supply_cols_per_row = 2
					filewrite(li_file, "CT~~CD,~~CC^~~CT~~")
					filewrite(li_file, "^XATA000JSN^LT0^MNW^MTT^PON^PMN^LH0,0^JMA^PR2,2SD20^JUS^LRN^CI0^XZ")
					ll_labelno = 1
					for ll_counter = 1 to ll_totalrows
						if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
							ll_qty = id_detail.getitemnumber(ll_counter, "qty")
							ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 25)
							ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
							if ib_printprice then
								ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "##,###,###.#0"))
							else
								ls_price = ""
							end if
							ls_date = string(today(), "dd/mm")
							for ll_innercounter = 1 to ll_qty
								ll_labelpos = ll_labelno mod ll_supply_cols_per_row
								if ll_labelpos = 1 then
									filewrite(li_file, "^XA")
									filewrite(li_file, "^MMT")
									filewrite(li_file, "^PW631")
									filewrite(li_file, "^LL0224")
									filewrite(li_file, "^LS0")
								end if
								if ll_labelpos = 1 then
									ls_xpos = "38"
								elseif ll_labelpos = 0 then
									ls_xpos = "366"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",33^A0N,26,28^FH\^FD" + ls_clientname + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "32"
								elseif ll_labelpos = 0 then
									ls_xpos = "360"
								end if
								ls_filecontent = "^BY2,3,114^FT" + ls_xpos + ",155^BCN,,Y,N"
								filewrite(li_file, ls_filecontent)
								filewrite(li_file, "^FD>:" + ls_aliasname + "^FS")
								if ll_labelpos = 1 then
									ls_xpos = "23"
								elseif ll_labelpos = 0 then
									ls_xpos = "351"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",192^A0N,16,16^FH\^FD" + ls_itemname + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "21"
								elseif ll_labelpos = 0 then
									ls_xpos = "349"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",218^A0N,22,52^FH\^FD" + ls_price + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 0 then
									filewrite(li_file, "^PQ1,0,1,Y^XZ")
								end if
								ll_labelno = ll_labelno + 1
							next
						end if
					next
				end if
				if ll_labelpos > 0 then
					filewrite(li_file, "^PQ1,0,1,Y^XZ")
				end if
				fileclose(li_file)
				run("..\BarcodePrint\BP.bat", normal!)
			end if
		end if
	end if
	return 0
