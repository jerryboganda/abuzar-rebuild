						filewrite(li_file, ls_filecontent)
						ls_filecontent = "101100000050008" + ls_itemname
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "103100000000008" + ls_price
						filewrite(li_file, ls_filecontent)
						ls_qty = trim(string(ll_qty))
