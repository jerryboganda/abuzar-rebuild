// function f_printbarcode_bambino (barcodefunctions)  ancestor: function_object

// f_printbarcode_bambino.f_printbarcode_bambino(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	long ll_job
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	integer li_file2
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_expiry
	string ls_manfdate
	string ls_contents
	string ls_defaultinfo
	string ls_defaultprinter
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 21)
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	if gs_company <> "ABCD2" then
		ls_clientname = "BAMBINO"
	end if
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if ls_printer = "ZDesigner ZT410-203dpi ZPL" then
		if ll_totalrows > 0 then
			ll_counter = 1
			li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
			if li_file = -1 then
				messagebox("Error", "Unable to locate file for Label printing")
			else
				ls_format = id_master.object.labelformat[1]
				if ls_format = "1" then
					ll_supply_cols_per_row = 2
					filewrite(li_file, "^XATA000JSB^LT0^MMT^MNW^MTT^PON^PMN^LH0,0^JMA^PR4,4^MD4^JUS^LRN^CI0^XZ")
					ll_labelno = 1
					for ll_counter = 1 to ll_totalrows
						if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
							ll_qty = id_detail.getitemnumber(ll_counter, "qty")
							ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 29)
							ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), 7)
							if ib_printprice then
								ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
							else
								ls_price = ""
							end if
							ls_date = string(today(), "dd/mm")
							for ll_innercounter = 1 to ll_qty
								ll_labelpos = ll_labelno mod ll_supply_cols_per_row
								if ll_labelpos = 1 then
									filewrite(li_file, "^XA^LL0223")
									filewrite(li_file, "^PW623")
								end if
								if ll_labelpos = 1 then
									ls_xpos = "83"
								elseif ll_labelpos = 0 then
									ls_xpos = "411"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",38^A0N,16,31^FH\^FD" + ls_clientname + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "25"
								elseif ll_labelpos = 0 then
									ls_xpos = "353"
								end if
								ls_filecontent = "^BY2,3,103^FT" + ls_xpos + ",148^B3N,N,,Y,N"
								filewrite(li_file, ls_filecontent)
								filewrite(li_file, "^FD" + ls_aliasname + "^FS")
								if ll_labelpos = 1 then
									ls_xpos = "25"
								elseif ll_labelpos = 0 then
									ls_xpos = "353"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",188^A0N,18,19^FH\^FD" + ls_itemname + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "25"
								elseif ll_labelpos = 0 then
									ls_xpos = "353"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",216^A0N,23,48^FH\^FD" + ls_price + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "232"
								elseif ll_labelpos = 0 then
									ls_xpos = "560"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",38^A0N,16,24^FH\^FD" + ls_date + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 0 then
									filewrite(li_file, "^PQ1,0,1,Y^XZ")
								end if
								ll_labelno = ll_labelno + 1
							next
						end if
					next
					if ll_labelpos > 0 then
						filewrite(li_file, "^PQ1,0,1,Y^XZ")
					end if
				else
					ll_supply_cols_per_row = 2
					filewrite(li_file, "^XATA000JSB^LT0^MMT^MNW^MTT^PON^PMN^LH0,0^JMA^PR4,4^MD4^JUS^LRN^CI0^XZ")
					ll_labelno = 1
					for ll_counter = 1 to ll_totalrows
						if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
							ll_qty = id_detail.getitemnumber(ll_counter, "qty")
							ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 29)
							ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), 7)
							if isnull(id_detail.object.manfdate[ll_counter]) then
								ls_manfdate = ""
							else
								ls_manfdate = "PD: " + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
							end if
							ls_expiry = "EXP: " + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
							if ib_printprice then
								ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
							else
								ls_price = ""
							end if
							ls_date = string(today(), "dd/mm")
							for ll_innercounter = 1 to ll_qty
								ll_labelpos = ll_labelno mod ll_supply_cols_per_row
								if ll_labelpos = 1 then
									filewrite(li_file, "^XA^LL0223")
									filewrite(li_file, "^PW623")
								end if
								if ll_labelpos = 1 then
									ls_xpos = "83"
								elseif ll_labelpos = 0 then
									ls_xpos = "411"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",38^A0N,16,31^FH\^FD" + ls_clientname + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "25"
								elseif ll_labelpos = 0 then
									ls_xpos = "353"
								end if
								ls_filecontent = "^BY2,3,85^FT" + ls_xpos + ",133^B3N,N,,Y,N"
								filewrite(li_file, ls_filecontent)
								filewrite(li_file, "^FD" + ls_aliasname + "^FS")
								if ll_labelpos = 1 then
									ls_xpos = "25"
								elseif ll_labelpos = 0 then
									ls_xpos = "353"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",170^A0N,19,19^FH\^FD" + ls_itemname + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "25"
								elseif ll_labelpos = 0 then
									ls_xpos = "353"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",192^A0N,19,19^FH\^FD" + trim(ls_manfdate + space(5) + ls_expiry) + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "25"
								elseif ll_labelpos = 0 then
									ls_xpos = "353"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",216^A0N,23,48^FH\^FD" + ls_price + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "232"
								elseif ll_labelpos = 0 then
									ls_xpos = "560"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",38^A0N,16,24^FH\^FD" + ls_date + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 0 then
									filewrite(li_file, "^PQ1,0,1,Y^XZ")
								end if
								ll_labelno = ll_labelno + 1
							next
						end if
					next
					if ll_labelpos > 0 then
						filewrite(li_file, "^PQ1,0,1,Y^XZ")
					end if
				end if
				if ll_labelpos > 0 then
					filewriteex(li_file, "^PQ1,0,1,Y^XZ")
				end if
				fileclose(li_file)
				li_file2 = fileopen("label.prn", textmode!, read!, lockread!)
				if li_file2 = -1 then
					messagebox("Error", "Unable to locate file for Label printing")
					return 0
				else
					filereadex(li_file2, ls_contents)
					fileclose(li_file2)
					ls_defaultinfo = printgetprinter()
					ls_defaultprinter = left(ls_defaultinfo, pos(ls_defaultinfo, "~t") - 1)
					printsetprinter("ZDesigner ZT410-203dpi ZPL")
					ll_job = printopen("waseela", false)
					if ll_job = -1 then
						messagebox("Error", "Unable to Open Print Job for Label printing")
					else
						printsend(ll_job, ls_contents)
						printclose(ll_job)
					end if
					printsetprinter(trim(ls_defaultprinter))
				end if
			end if
		end if
	elseif ls_printer = "Zebra  Z4M Plus (200dpi)" then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			if ll_totalrows > 0 then
				ll_counter = 1
				li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
				if li_file = -1 then
					messagebox("Error", "Unable to locate file for Label printing")
				else
					ll_supply_cols_per_row = 2
					filewrite(li_file, "^XATA000JSB^LT0^MMT^MNW^MTT^PON^PMN^LH0,0^JMA^PR4,4^MD4^JUS^LRN^CI0^XZ")
					ll_labelno = 1
					for ll_counter = 1 to ll_totalrows
						if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
							ll_qty = id_detail.getitemnumber(ll_counter, "qty")
							ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 29)
							ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), 7)
							if ib_printprice then
								ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
							else
								ls_price = ""
							end if
							ls_date = string(today(), "dd/mm")
							for ll_innercounter = 1 to ll_qty
								ll_labelpos = ll_labelno mod ll_supply_cols_per_row
								if ll_labelpos = 1 then
									filewrite(li_file, "^XA^LL0223")
									filewrite(li_file, "^PW623")
								end if
								if ll_labelpos = 1 then
									ls_xpos = "83"
								elseif ll_labelpos = 0 then
									ls_xpos = "411"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",28^A0N,16,31^FH\^FD" + ls_clientname + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "5"
								elseif ll_labelpos = 0 then
									ls_xpos = "333"
								end if
								ls_filecontent = "^BY2,3,103^FT" + ls_xpos + ",138^B3N,N,,Y,N"
								filewrite(li_file, ls_filecontent)
								filewrite(li_file, "^FD" + ls_aliasname + "^FS")
								if ll_labelpos = 1 then
									ls_xpos = "5"
								elseif ll_labelpos = 0 then
									ls_xpos = "333"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",178^A0N,18,19^FH\^FD" + ls_itemname + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "5"
								elseif ll_labelpos = 0 then
									ls_xpos = "333"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",206^A0N,19,48^FH\^FD" + ls_price + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 1 then
									ls_xpos = "232"
								elseif ll_labelpos = 0 then
									ls_xpos = "560"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",27^A0N,16,24^FH\^FD" + ls_date + "^FS"
								filewrite(li_file, ls_filecontent)
								if ll_labelpos = 0 then
									filewrite(li_file, "^PQ1,0,1,Y^XZ")
								end if
								ll_labelno = ll_labelno + 1
							next
						end if
					next
					if ll_labelpos > 0 then
						filewrite(li_file, "^PQ1,0,1,Y^XZ")
					end if
					fileclose(li_file)
					run("..\BarcodePrint\BP.bat", normal!)
				end if
			end if
		elseif ll_totalrows > 0 then
			ll_counter = 1
			li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
			if li_file = -1 then
				messagebox("Error", "Unable to locate file for Label printing")
			else
				ll_supply_cols_per_row = 2
				filewrite(li_file, "^XATA000JSB^LT0^MMT^MNW^MTT^PON^PMN^LH0,0^JMA^PR4,4^MD4^JUS^LRN^CI0^XZ")
				ll_labelno = 1
				for ll_counter = 1 to ll_totalrows
					if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 29)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), 7)
						ls_manfdate = "PD: " + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						ls_expiry = "EXP: " + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						ls_date = string(today(), "dd/mm")
						for ll_innercounter = 1 to ll_qty
							ll_labelpos = ll_labelno mod ll_supply_cols_per_row
							if ll_labelpos = 1 then
								filewrite(li_file, "^XA^LL0223")
								filewrite(li_file, "^PW623")
							end if
							if ll_labelpos = 1 then
								ls_xpos = "83"
							elseif ll_labelpos = 0 then
								ls_xpos = "411"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",28^A0N,16,31^FH\^FD" + ls_clientname + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "5"
							elseif ll_labelpos = 0 then
								ls_xpos = "333"
							end if
							ls_filecontent = "^BY2,3,85^FT" + ls_xpos + ",123^B3N,N,,Y,N"
							filewrite(li_file, ls_filecontent)
							filewrite(li_file, "^FD" + ls_aliasname + "^FS")
							if ll_labelpos = 1 then
								ls_xpos = "5"
							elseif ll_labelpos = 0 then
								ls_xpos = "333"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",160^A0N,19,19^FH\^FD" + ls_itemname + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "5"
							elseif ll_labelpos = 0 then
								ls_xpos = "333"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",182^A0N,19,19^FH\^FD" + ls_manfdate + space(5) + ls_expiry + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "5"
							elseif ll_labelpos = 0 then
								ls_xpos = "333"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",206^A0N,19,48^FH\^FD" + ls_price + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "232"
							elseif ll_labelpos = 0 then
								ls_xpos = "560"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",27^A0N,16,24^FH\^FD" + ls_date + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 0 then
								filewrite(li_file, "^PQ1,0,1,Y^XZ")
							end if
							ll_labelno = ll_labelno + 1
						next
					end if
				next
				if ll_labelpos > 0 then
					filewrite(li_file, "^PQ1,0,1,Y^XZ")
				end if
				fileclose(li_file)
				run("..\BarcodePrint\BP.bat", normal!)
			end if
		end if
	end if
	return 0
