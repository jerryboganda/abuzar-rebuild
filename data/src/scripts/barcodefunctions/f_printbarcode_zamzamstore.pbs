// function f_printbarcode_zamzamstore (barcodefunctions)  ancestor: function_object

// f_printbarcode_zamzamstore.f_printbarcode_zamzamstore(datawindow id_master, datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if ls_printer = "Zebra ZM 400 (200dpi)" and ll_totalrows > 0 then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			ll_counter = 1
			li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
			if li_file = -1 then
				messagebox("Error", "Unable to locate file for Label printing")
			else
				ll_supply_cols_per_row = 3
				filewrite(li_file, "CT~~CD,~~CC^~~CT~~")
				filewrite(li_file, "^XA~~TA000~~JSN^LT0^MNW^MTT^PON^PMN^LH0,0^JMA^PR2,2~~SD10^JUS^LRN^CI0^XZ")
				ll_labelno = 1
				for ll_counter = 1 to ll_totalrows
					if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 31)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "##,###,###.#0"))
						else
							ls_price = ""
						end if
						ls_date = string(today(), "dd/mm")
						for ll_innercounter = 1 to ll_qty
							ll_labelpos = ll_labelno mod ll_supply_cols_per_row
							if ll_labelpos = 1 then
								filewrite(li_file, "^XA")
								filewrite(li_file, "^MMT")
								filewrite(li_file, "^^PW719")
								filewrite(li_file, "^LL0152")
								filewrite(li_file, "^LS0")
							end if
							if ll_labelpos = 1 then
								ls_xpos = "15"
							elseif ll_labelpos = 2 then
								ls_xpos = "263"
							elseif ll_labelpos = 0 then
								ls_xpos = "511"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",32^A0N,24,21^FH\^FD" + ls_clientname + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "19"
							elseif ll_labelpos = 2 then
								ls_xpos = "267"
							elseif ll_labelpos = 0 then
								ls_xpos = "515"
							end if
							ls_filecontent = "^BY1,3,69^FT" + ls_xpos + ",103^BCN,,Y,N"
							filewrite(li_file, ls_filecontent)
							filewrite(li_file, "^FD>:" + ls_aliasname + "^FS")
							if ll_labelpos = 1 then
								ls_xpos = "14"
							elseif ll_labelpos = 2 then
								ls_xpos = "262"
							elseif ll_labelpos = 0 then
								ls_xpos = "510"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",129^A0N,11,14^FH\^FD" + ls_itemname + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "15"
							elseif ll_labelpos = 2 then
								ls_xpos = "263"
							elseif ll_labelpos = 0 then
								ls_xpos = "511"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",148^A0N,14,36^FH\^FD" + ls_price + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 0 then
								filewrite(li_file, "^PQ1,0,1,Y^XZ")
							end if
							ll_labelno = ll_labelno + 1
						next
					end if
				next
				if ll_labelpos > 0 then
					filewrite(li_file, "^PQ1,0,1,Y^XZ")
				end if
				fileclose(li_file)
				run("..\BarcodePrint\BP.bat", normal!)
			end if
		elseif ls_format = "2" then
			ll_counter = 1
			li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
			if li_file = -1 then
				messagebox("Error", "Unable to locate file for Label printing")
			else
				ll_supply_cols_per_row = 2
				filewrite(li_file, "CT~~CD,~~CC^~~CT~~")
				filewrite(li_file, "^XA~~TA000~~JSN^LT0^MNW^MTT^PON^PMN^LH0,0^JMA^PR2,2~~SD10^JUS^LRN^CI0^XZ")
				ll_labelno = 1
				for ll_counter = 1 to ll_totalrows
					if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 31)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "##,###,###.#0"))
						else
							ls_price = ""
						end if
						ls_date = string(today(), "dd/mm")
						for ll_innercounter = 1 to ll_qty
							ll_labelpos = ll_labelno mod ll_supply_cols_per_row
							if ll_labelpos = 1 then
								filewrite(li_file, "^XA")
								filewrite(li_file, "^MMT")
								filewrite(li_file, "^PW632")
								filewrite(li_file, "^LL0224")
								filewrite(li_file, "^LS0")
							end if
							if ll_labelpos = 1 then
								ls_xpos = "17"
							elseif ll_labelpos = 0 then
								ls_xpos = "345"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",38^A0N,28,28^FH\^FD" + ls_clientname + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "7"
							elseif ll_labelpos = 0 then
								ls_xpos = "335"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",183^A0N,20,19^FH\^FD" + ls_itemname + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "10"
							elseif ll_labelpos = 0 then
								ls_xpos = "338"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",215^A0N,26,50^FH\^FD" + ls_price + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "35"
							elseif ll_labelpos = 0 then
								ls_xpos = "363"
							end if
							ls_filecontent = "^BY1,3,106^FT" + ls_xpos + ",151^BCN,,Y,N"
							filewrite(li_file, ls_filecontent)
							filewrite(li_file, "^FD>:" + ls_aliasname + "^FS")
							if ll_labelpos = 0 then
								filewrite(li_file, "^PQ1,0,1,Y^XZ")
							end if
							ll_labelno = ll_labelno + 1
						next
					end if
				next
				if ll_labelpos > 0 then
					filewrite(li_file, "^PQ1,0,1,Y^XZ")
				end if
				fileclose(li_file)
				run("..\BarcodePrint\BP.bat", normal!)
			end if
		end if
	end if
	return 0
