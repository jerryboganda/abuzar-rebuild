// function f_printbarcode_citycashandcarry (barcodefunctions)  ancestor: function_object

// f_printbarcode_citycashandcarry.f_printbarcode_citycashandcarry(datawindow id_master, datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_itemname2
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_packing
	string ls_manfdate
	string ls_expiry
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if upper(ls_printer) = upper("TSC TTP-2410M Pro") then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			ll_supply_cols_per_row = 2
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-2410M Pro")
				tsc_setup_new("83", "28", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 30)
						ls_itemname2 = mid(trim(id_detail.getitemstring(ll_counter, "itemname")), 31, 30)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						ls_date = "Print Date = " + string(today(), "dd/mm/yyyy")
						ls_manfdate = "PD: " + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						ls_expiry = "EXP: " + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_printerfont_new("303", "208", "0", "180", "13", "5", ls_clientname)
						tsc_printerfont_new("630", "208", "0", "180", "13", "5", ls_clientname)
						tsc_barcode_new("303", "188", "39", "75", "1", "180", "2", "5", ls_aliasname)
						tsc_barcode_new("630", "188", "39", "75", "1", "180", "2", "5", ls_aliasname)
						tsc_printerfont_new("303", "85", "0", "180", "7", "8", ls_itemname)
						tsc_printerfont_new("630", "85", "0", "180", "7", "8", ls_itemname)
						tsc_printerfont_new("303", "62", "0", "180", "13", "13", ls_price)
						tsc_printerfont_new("630", "62", "0", "180", "13", "13", ls_price)
						tsc_printerfont_new("303", "18", "0", "180", "6", "6", ls_date)
						tsc_printerfont_new("630", "18", "0", "180", "6", "6", ls_date)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "2" then
			ll_supply_cols_per_row = 2
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-2410M Pro")
				tsc_setup_new("83", "28", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 30)
						ls_itemname2 = mid(trim(id_detail.getitemstring(ll_counter, "itemname")), 31, 30)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						ls_date = "Print Date = " + string(today(), "dd/mm/yyyy")
						ls_manfdate = "PD: " + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						ls_expiry = "EXP: " + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_printerfont_new("303", "208", "0", "180", "13", "5", ls_clientname)
						tsc_printerfont_new("630", "208", "0", "180", "13", "5", ls_clientname)
						tsc_barcode_new("303", "188", "39", "65", "1", "180", "2", "5", ls_aliasname)
						tsc_barcode_new("630", "188", "39", "65", "1", "180", "2", "5", ls_aliasname)
						tsc_printerfont_new("303", "96", "0", "180", "7", "8", ls_itemname)
						tsc_printerfont_new("630", "96", "0", "180", "7", "8", ls_itemname)
						tsc_printerfont_new("303", "72", "0", "180", "12", "12", ls_price)
						tsc_printerfont_new("630", "72", "0", "180", "12", "12", ls_price)
						tsc_printerfont_new("303", "42", "0", "180", "7", "7", ls_manfdate + space(5) + ls_expiry)
						tsc_printerfont_new("630", "42", "0", "180", "7", "7", ls_manfdate + space(5) + ls_expiry)
						tsc_printerfont_new("303", "18", "0", "180", "6", "6", ls_date)
						tsc_printerfont_new("630", "18", "0", "180", "6", "6", ls_date)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		end if
	end if
	return 0
