// function f_printbarcode_ahmedglass (barcodefunctions)  ancestor: function_object

// f_printbarcode_ahmedglass.f_printbarcode_ahmedglass(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_packing
	string ls_expdate
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_date = "PD:" + trim(string(today(), "dd-mm-yy"))
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 21)
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	if id_master.object.code[1] > 0 then
		ls_infocode = "TR # " + trim(string(id_master.object.code[1]))
	else
		ls_infocode = ""
	end if
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if upper(ls_printer) = "TSC TTP-244 PRO" and ll_totalrows > 0 then
		ll_counter = 1
		tsc_openport_new("TSC TTP-244 PRO")
		tsc_setup_new("50", "25", "5", "12", "0", "3", "0")
		for ll_counter = 1 to ll_totalrows
			if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
				ll_qty = id_detail.getitemnumber(ll_counter, "qty")
				ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
				ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
				if ib_printprice then
					ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
				else
					ls_price = ""
				end if
				ls_packing = trim(id_detail.getitemstring(ll_counter, "packing"))
				tsc_clearbuffer_new()
				tsc_windowsfont_new(15, 5, 25, 0, 2, 0, "Arial", left(ls_itemname, 28))
				tsc_windowsfont_new(15, 30, 25, 0, 2, 0, "Arial", mid(ls_itemname, 29, 28))
				tsc_windowsfont_new(15, 55, 25, 0, 2, 0, "Arial", "Brand : " + ls_packing)
				tsc_windowsfont_new(15, 80, 20, 0, 2, 0, "Arial", ls_infocode)
				tsc_barcode_new("15", "100", "128", "55", "0", "0", "2", "3", ls_aliasname)
				tsc_windowsfont_new(15, 156, 25, 0, 2, 0, "arial", ls_aliasname)
				tsc_printlabel_new("1", string(ll_qty))
			end if
		next
		tsc_closeport_new()
	end if
	return 0
