// function f_printbarcode_proposal (barcodefunctions)  ancestor: function_object

// f_printbarcode_proposal.f_printbarcode_proposal(datawindow id_master, datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_phone
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_packing
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = "MEHRAN AUTOS"
	ls_phone = "052-4267373, 4291240"
	li_barcodeleninprint = 25
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if lower(ls_printer) = lower("TSC TTP-244 PLUS") then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			if ll_totalrows > 0 then
				ls_date = string(today(), "yymmdd..")
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 Plus")
				tsc_setup_new("62", "40", "4", "7", "0", "4", "0")
				tsc_sendcommand_new("GAP 4 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET TEAR OFF")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER OFF")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 60)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "###,##0.00"))
						else
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						tsc_printerfont_new("470", "305", "0", "180", "15", "10", ls_clientname)
						tsc_printerfont_new("470", "274", "0", "180", "13", "7", ls_phone)
						tsc_printerfont_new("470", "250", "0", "180", "10", "7", left(ls_itemname, 30))
						tsc_printerfont_new("470", "227", "0", "180", "10", "7", mid(ls_itemname, 31, 30))
						tsc_barcode_new("470", "205", "39", "110", "0", "180", "2", "3", ls_aliasname)
						tsc_printerfont_new("470", "87", "0", "180", "10", "7", ls_aliasname)
						tsc_printerfont_new("470", "62", "0", "180", "10", "7", ls_packing)
						tsc_printerfont_new("470", "40", "0", "180", "18", "14", ls_price)
						tsc_printlabel_new("1", string(ll_qty))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "2" and ll_totalrows > 0 then
			ls_date = string(today(), "yymmdd..")
			ll_counter = 1
			tsc_openport_new("TSC TTP-244 Plus")
			tsc_setup_new("40.1", "28.8", "4", "7", "0", "3", "0")
			tsc_sendcommand_new("GAP 3 mm, 0 mm")
			tsc_sendcommand_new("SPEED 4")
			tsc_sendcommand_new("DENSITY 7")
			tsc_sendcommand_new("DIRECTION 0,0")
			tsc_sendcommand_new("REFERENCE 0,0")
			tsc_sendcommand_new("OFFSET 0 mm")
			tsc_sendcommand_new("SHIFT 0")
			tsc_sendcommand_new("SET TEAR OFF")
			tsc_sendcommand_new("SET PEEL OFF")
			tsc_sendcommand_new("SET CUTTER OFF")
			tsc_sendcommand_new("CLS")
			tsc_sendcommand_new("CODEPAGE 850")
			for ll_counter = 1 to ll_totalrows
				if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 27)
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
					if ib_printprice then
						ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "###,##0.00"))
					else
						ls_price = ""
					end if
					tsc_clearbuffer_new()
					tsc_printerfont_new("287", "230", "0", "180", "13", "8", ls_clientname)
					tsc_printerfont_new("290", "208", "0", "180", "10", "6", ls_phone)
					tsc_printerfont_new("305", "191", "0", "180", "8", "7", ls_itemname)
					tsc_barcode_new("305", "168", "39", "68", "1", "180", "2", "3", ls_aliasname)
					tsc_printerfont_new("305", "73", "0", "180", "8", "7", ls_packing)
					tsc_printerfont_new("305", "54", "0", "180", "14", "12", ls_price)
					tsc_printlabel_new("1", string(ll_qty))
				end if
			next
			tsc_closeport_new()
		end if
	end if
	return 0
