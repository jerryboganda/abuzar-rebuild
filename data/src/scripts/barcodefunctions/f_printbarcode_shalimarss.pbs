// function f_printbarcode_shalimarss (barcodefunctions)  ancestor: function_object

// f_printbarcode_shalimarss.f_printbarcode_shalimarss(datawindow id_master, datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_expiry
	string ls_mfg
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_packing
	string ls_expdate
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_date = "PD:" + trim(string(today(), "dd-mm-yy"))
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if upper(ls_printer) = "TSC TTP-244 PRO" then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PRO")
				tsc_setup_new("38.1", "28.57", "5", "12", "0", "3", "0")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
						tsc_clearbuffer_new()
						tsc_windowsfont_new(12, 26, 30, 0, 2, 0, "Arial", ls_clientname)
						tsc_barcode_new("12", "55", "128", "85", "0", "0", "2", "3", ls_aliasname)
						tsc_windowsfont_new(12, 143, 25, 0, 2, 0, "arial", ls_aliasname)
						tsc_windowsfont_new(12, 170, 22, 0, 2, 0, "Arial", left(ls_itemname, 26))
						tsc_windowsfont_new(12, 195, 30, 0, 2, 0, "Arial", ls_price)
						tsc_printlabel_new("1", string(ll_qty))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "2" then
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PRO")
				tsc_setup_new("38.1", "28.57", "5", "12", "0", "3", "0")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						if isnull(ls_mfg) then
							ls_mfg = ""
						end if
						if isnull(ls_expiry) then
							ls_expiry = ""
						end if
						if len(ls_mfg) > 0 then
							ls_expiry = ls_mfg + space(2) + ls_expiry
						end if
						if ib_printprice then
							ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
						tsc_clearbuffer_new()
						tsc_windowsfont_new(15, 26, 30, 0, 2, 0, "Arial", ls_clientname)
						tsc_barcode_new("15", "55", "128", "65", "0", "0", "2", "3", ls_aliasname)
						tsc_windowsfont_new(12, 123, 25, 0, 2, 0, "arial", ls_aliasname)
						tsc_windowsfont_new(15, 148, 20, 0, 2, 0, "Arial", left(ls_itemname, 28))
						tsc_windowsfont_new(15, 170, 20, 0, 2, 0, "Arial", ls_expiry)
						tsc_windowsfont_new(15, 191, 30, 0, 2, 0, "Arial", ls_price)
						tsc_printlabel_new("1", string(ll_qty))
					end if
				next
				tsc_closeport_new()
			end if
		else
			ll_supply_cols_per_row = 2
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PRO")
				tsc_setup_new("82", "28", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 2 mm, 0 mm")
				tsc_sendcommand_new("SPEED 10")
				tsc_sendcommand_new("DENSITY 10")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER ON")
				tsc_sendcommand_new("SET TEAR ON")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_printerfont_new("627", "210", "0", "180", "12", "8", ls_clientname)
						tsc_printerfont_new("305", "210", "0", "180", "12", "8", ls_clientname)
						tsc_barcode_new("627", "188", "128", "72", "1", "180", "2", "3", ls_aliasname)
						tsc_barcode_new("305", "188", "128", "72", "1", "180", "2", "3", ls_aliasname)
						tsc_printerfont_new("627", "90", "0", "180", "8", "8", left(ls_itemname, 26))
						tsc_printerfont_new("305", "90", "0", "180", "8", "8", left(ls_itemname, 26))
						tsc_printerfont_new("627", "68", "0", "180", "8", "8", mid(ls_itemname, 27, 26))
						tsc_printerfont_new("305", "68", "0", "180", "8", "8", mid(ls_itemname, 27, 26))
						tsc_printerfont_new("628", "44", "0", "180", "15", "15", ls_price)
						tsc_printerfont_new("305", "44", "0", "180", "15", "15", ls_price)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		end if
	end if
	return 0
