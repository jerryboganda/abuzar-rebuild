// function f_printbarcode_dwssuperf7 (barcodefunctions)  ancestor: function_object

// f_printbarcode_dwssuperf7.f_printbarcode_dwssuperf7(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_packing
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if lower(ls_printer) = lower("Zebra TLP 2844") then
		li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
		if li_file = -1 then
			messagebox("Error", "Unable to locate file for Label printing")
		else
			ls_filecontent = ""
			filewrite(li_file, ls_filecontent)
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "Q224,019"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "q831"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "rN"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "S1"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "D10"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "ZT"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "JB"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "O"
			filewrite(li_file, ls_filecontent)
			ls_filecontent = "R265,0"
			filewrite(li_file, ls_filecontent)
			for ll_counter = 1 to ll_totalrows
				if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ls_manufshortname = left(id_detail.object.manufshortname[ll_counter], 5)
					ls_design = left(id_detail.object.design[ll_counter], 14)
					ls_purprice = left(trim(string(id_detail.object.purprice[ll_counter])), 4)
					if isnull(ls_purprice) then
						ls_purprice = "0"
					end if
					if isnull(ls_design) then
						ls_design = ""
					end if
					if isnull(ls_manufshortname) then
						ls_manufshortname = ""
					end if
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), 9)
					if ib_printprice then
						ls_price = "Rs.: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
					else
						ls_price = ""
					end if
					ls_infocode = ls_manufshortname + "-" + ls_design + "-" + ls_purprice
					ls_filecontent = "N"
					filewrite(li_file, ls_filecontent)
					ls_filecontent = "A294,195,2,1,1,2,N,~"" + trim(ls_clientname) + "~""
					filewrite(li_file, ls_filecontent)
					ls_filecontent = "B285,167,2,3,2,4,80,B,~"" + ls_aliasname + "~""
					filewrite(li_file, ls_filecontent)
					ls_filecontent = "A285,55,2,1,1,2,N,~"" + left(ls_itemname, 28) + "~""
					filewrite(li_file, ls_filecontent)
					ls_filecontent = "A285,28,2,1,1,2,N,~"" + ls_price + "~""
					filewrite(li_file, ls_filecontent)
					ls_filecontent = "P" + trim(string(ll_qty))
					filewrite(li_file, ls_filecontent)
				end if
			next
			fileclose(li_file)
			run("..\BarcodePrint\BP.bat", normal!)
		end if
	elseif upper(ls_printer) = "TSC TTP-244 PLUS" then
		ls_format = id_master.object.labelformat[1]
		if ll_totalrows > 0 then
			ll_counter = 1
			tsc_openport_new("TSC TTP-244 Plus")
			tsc_setup_new("38.1", "28.57", "5", "12", "0", "3", "0")
			for ll_counter = 1 to ll_totalrows
				if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), 15)
					if ib_printprice then
						ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
					else
						ls_price = ""
					end if
					ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
					tsc_clearbuffer_new()
					tsc_windowsfont_new(15, 18, 30, 0, 2, 0, "Arial", ls_clientname)
					tsc_barcode_new("12", "50", "39", "85", "0", "0", "2", "3", ls_aliasname)
					tsc_windowsfont_new(12, 138, 25, 0, 2, 0, "arial", ls_aliasname)
					tsc_windowsfont_new(12, 165, 22, 0, 2, 0, "Arial", left(ls_itemname, 26))
					tsc_windowsfont_new(12, 189, 30, 0, 2, 0, "Arial", ls_price)
					tsc_printlabel_new("1", string(ll_qty))
				end if
			next
			tsc_closeport_new()
		end if
	end if
	return 0
