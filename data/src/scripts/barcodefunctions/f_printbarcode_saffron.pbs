						filewrite(li_file, ls_filecontent)
						ls_filecontent = "102100000150072" + ls_invcode
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "102100000150038" + ls_date
						filewrite(li_file, ls_filecontent)
						ls_qty = trim(string(ll_qty))
						if len(ls_qty) < 2 then
