// function f_printbarcode_malikmasalajaat (barcodefunctions)  ancestor: function_object

// f_printbarcode_malikmasalajaat.f_printbarcode_malikmasalajaat(datawindow id_master, datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_mfg_date
	string ls_expiry
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if upper(ls_printer) = "TSC TTP-244 PRO" then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			ll_supply_cols_per_row = 3
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PRO")
				tsc_setup_new("100", "19.1", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 10")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER ON")
				tsc_sendcommand_new("SET TEAR ON")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "###,##0.00"))
						else
							ls_price = ""
						end if
						if isnull(id_detail.object.expiry[ll_counter]) then
							ls_expiry = ""
						else
							ls_expiry = "Expiry:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						end if
						if isnull(id_detail.object.manfdate[ll_counter]) then
							ls_mfg_date = ""
						else
							ls_mfg_date = "Mfg.:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_printerfont_new("780", "143", "0", "180", "9", "9", ls_clientname)
						tsc_printerfont_new("513", "143", "0", "180", "9", "9", ls_clientname)
						tsc_printerfont_new("251", "143", "0", "180", "9", "9", ls_clientname)
						tsc_barcode_new("780", "120", "128", "30", "1", "180", "2", "3", ls_aliasname)
						tsc_barcode_new("513", "120", "128", "30", "1", "180", "2", "3", ls_aliasname)
						tsc_barcode_new("251", "120", "128", "30", "1", "180", "2", "3", ls_aliasname)
						tsc_printerfont_new("780", "68", "0", "180", "6", "6", left(ls_itemname, 30))
						tsc_printerfont_new("513", "68", "0", "180", "6", "6", left(ls_itemname, 30))
						tsc_printerfont_new("251", "68", "0", "180", "6", "6", left(ls_itemname, 30))
						tsc_printerfont_new("780", "53", "0", "180", "6", "6", mid(ls_itemname, 31, 30))
						tsc_printerfont_new("513", "53", "0", "180", "6", "6", mid(ls_itemname, 31, 30))
						tsc_printerfont_new("251", "53", "0", "180", "6", "6", mid(ls_itemname, 31, 30))
						tsc_printerfont_new("780", "38", "0", "180", "10", "10", ls_price)
						tsc_printerfont_new("513", "38", "0", "180", "10", "10", ls_price)
						tsc_printerfont_new("251", "38", "0", "180", "10", "10", ls_price)
						tsc_printerfont_new("780", "14", "0", "180", "6", "6", trim(ls_mfg_date + space(3) + ls_expiry))
						tsc_printerfont_new("513", "14", "0", "180", "6", "6", trim(ls_mfg_date + space(3) + ls_expiry))
						tsc_printerfont_new("251", "14", "0", "180", "6", "6", trim(ls_mfg_date + space(3) + ls_expiry))
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		end if
	elseif ls_printer = "Zebra  Z4M Plus (200dpi)" and ll_totalrows > 0 then
		ll_counter = 1
		li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
		if li_file = -1 then
			messagebox("Error", "Unable to locate file for Label printing")
		else
			ls_format = id_master.object.labelformat[1]
			if ls_format = "1" then
				ll_supply_cols_per_row = 2
				filewrite(li_file, "^XATA000JSN^LT0^MMT^MNW^MTT^PON^PMN^LH0,0^JMA^PR4,4^MD0^JUS^LRN^CI0^XZ")
				ll_labelno = 1
				for ll_counter = 1 to ll_totalrows
					if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						if isnull(id_detail.object.expiry[ll_counter]) then
							ls_expiry = ""
						else
							ls_expiry = "Expiry:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						end if
						if isnull(id_detail.object.manfdate[ll_counter]) then
							ls_mfg_date = ""
						else
							ls_mfg_date = "Mfg.:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						end if
						for ll_innercounter = 1 to ll_qty
							ll_labelpos = ll_labelno mod ll_supply_cols_per_row
							if ll_labelpos = 1 then
								filewrite(li_file, "^XA^LL0224")
								filewrite(li_file, "^PW680")
							end if
							if ll_labelpos = 1 then
								ls_xpos = "20"
							elseif ll_labelpos = 0 then
								ls_xpos = "350"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",35^A0N,28,28^FH\^FD" + ls_clientname + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "20"
							elseif ll_labelpos = 0 then
								ls_xpos = "350"
							end if
							ls_filecontent = "^BY2,3,65^FT" + ls_xpos + ",105^BCN,,Y,N"
							filewrite(li_file, ls_filecontent)
							filewrite(li_file, "^FD" + ls_aliasname + "^FS")
							if ll_labelpos = 1 then
								ls_xpos = "20"
							elseif ll_labelpos = 0 then
								ls_xpos = "350"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",144^A0N,20,20^FH\^FD" + left(ls_itemname, 27) + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "20"
							elseif ll_labelpos = 0 then
								ls_xpos = "350"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",162^A0N,20,20^FH\^FD" + mid(ls_itemname, 28, 27) + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "20"
							elseif ll_labelpos = 0 then
								ls_xpos = "350"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",193^A0N,36,36^FH\^FD" + ls_price + "^FS"
							filewrite(li_file, ls_filecontent)
							if ls_mfg_date <> "" then
								if ll_labelpos = 1 then
									ls_xpos = "20"
								elseif ll_labelpos = 0 then
									ls_xpos = "350"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",215^A0N,18,18^FH\^FD" + ls_mfg_date + "^FS"
								filewrite(li_file, ls_filecontent)
							end if
							if ls_expiry <> "" then
								if ll_labelpos = 1 then
									ls_xpos = "155"
								elseif ll_labelpos = 0 then
									ls_xpos = "477"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",215^A0N,18,18^FH\^FD" + ls_expiry + "^FS"
								filewrite(li_file, ls_filecontent)
							end if
							if ll_labelpos = 0 then
								filewrite(li_file, "^PQ1,0,1,Y^XZ")
							end if
							ll_labelno = ll_labelno + 1
						next
					end if
				next
			elseif ls_format = "2" then
				ll_supply_cols_per_row = 3
				filewrite(li_file, "^XATA000JSN^LT0^MMT^MNW^MTT^PON^PMN^LH0,0^JMA^PR4,4^MD0^JUS^LRN^CI0^XZ")
				ll_labelno = 1
				for ll_counter = 1 to ll_totalrows
					if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 25)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						if isnull(id_detail.object.expiry[ll_counter]) then
							ls_expiry = ""
						else
							ls_expiry = "Expiry:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						end if
						if isnull(id_detail.object.manfdate[ll_counter]) then
							ls_mfg_date = ""
						else
							ls_mfg_date = "Mfg.:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						end if
						for ll_innercounter = 1 to ll_qty
							ll_labelpos = ll_labelno mod ll_supply_cols_per_row
							if ll_labelpos = 1 then
								filewrite(li_file, "^XA^LL0166")
								filewrite(li_file, "^PW738")
							end if
							if ll_labelpos = 1 then
								ls_xpos = "1"
							elseif ll_labelpos = 2 then
								ls_xpos = "255"
							elseif ll_labelpos = 0 then
								ls_xpos = "520"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",34^A0N,25,25^FH\^FD" + ls_clientname + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "1"
							elseif ll_labelpos = 2 then
								ls_xpos = "255"
							elseif ll_labelpos = 0 then
								ls_xpos = "520"
							end if
							ls_filecontent = "^BY2,3,39^FT" + ls_xpos + ",78^BCN,,Y,N"
							filewrite(li_file, ls_filecontent)
							filewrite(li_file, "^FD" + ls_aliasname + "^FS")
							if ll_labelpos = 1 then
								ls_xpos = "1"
							elseif ll_labelpos = 2 then
								ls_xpos = "255"
							elseif ll_labelpos = 0 then
								ls_xpos = "520"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",118^A0N,20,16^FH\^FD" + ls_itemname + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "1"
							elseif ll_labelpos = 2 then
								ls_xpos = "255"
							elseif ll_labelpos = 0 then
								ls_xpos = "520"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",137^A0N,21,33^FH\^FD" + ls_price + "^FS"
							filewrite(li_file, ls_filecontent)
							if ls_mfg_date <> "" then
								if ll_labelpos = 1 then
									ls_xpos = "1"
								elseif ll_labelpos = 2 then
									ls_xpos = "255"
								elseif ll_labelpos = 0 then
									ls_xpos = "520"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",149^A0N,13,13^FH\^FD" + ls_mfg_date + "^FS"
								filewrite(li_file, ls_filecontent)
							end if
							if ls_expiry <> "" then
								if ll_labelpos = 1 then
									ls_xpos = "110"
								elseif ll_labelpos = 2 then
									ls_xpos = "370"
								elseif ll_labelpos = 0 then
									ls_xpos = "622"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",149^A0N,13,13^FH\^FD" + ls_expiry + "^FS"
								filewrite(li_file, ls_filecontent)
							end if
							if ll_labelpos = 0 then
								filewrite(li_file, "^PQ1,0,1,Y^XZ")
							end if
							ll_labelno = ll_labelno + 1
						next
					end if
				next
			elseif ls_format = "3" then
				ll_supply_cols_per_row = 3
				filewrite(li_file, "^XATA000JSN^LT0^MMT^MNW^MTT^PON^PMN^LH0,0^JMA^PR4,4^MD0^JUS^LRN^CI0^XZ")
				ll_labelno = 1
				for ll_counter = 1 to ll_totalrows
					if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 25)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						if isnull(id_detail.object.expiry[ll_counter]) then
							ls_expiry = ""
						else
							ls_expiry = "Expiry:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						end if
						if isnull(id_detail.object.manfdate[ll_counter]) then
							ls_mfg_date = ""
						else
							ls_mfg_date = "Mfg.:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						end if
						for ll_innercounter = 1 to ll_qty
							ll_labelpos = ll_labelno mod ll_supply_cols_per_row
							if ll_labelpos = 1 then
								filewrite(li_file, "^XA^LL0166")
								filewrite(li_file, "^PW738")
							end if
							if ll_labelpos = 1 then
								ls_xpos = "27"
							elseif ll_labelpos = 2 then
								ls_xpos = "276"
							elseif ll_labelpos = 0 then
								ls_xpos = "526"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",34^A0N,28,28^FH\^FD" + ls_clientname + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "28"
							elseif ll_labelpos = 2 then
								ls_xpos = "277"
							elseif ll_labelpos = 0 then
								ls_xpos = "527"
							end if
							ls_filecontent = "^BY2,3,39^FT" + ls_xpos + ",78^BCN,,Y,N"
							filewrite(li_file, ls_filecontent)
							filewrite(li_file, "^FD" + ls_aliasname + "^FS")
							if ll_labelpos = 1 then
								ls_xpos = "24"
							elseif ll_labelpos = 2 then
								ls_xpos = "273"
							elseif ll_labelpos = 0 then
								ls_xpos = "523"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",118^A0N,20,16^FH\^FD" + ls_itemname + "^FS"
							filewrite(li_file, ls_filecontent)
							if ll_labelpos = 1 then
								ls_xpos = "37"
							elseif ll_labelpos = 2 then
								ls_xpos = "286"
							elseif ll_labelpos = 0 then
								ls_xpos = "536"
							end if
							ls_filecontent = "^FT" + ls_xpos + ",137^A0N,21,33^FH\^FD" + ls_price + "^FS"
							filewrite(li_file, ls_filecontent)
							if ls_mfg_date <> "" then
								if ll_labelpos = 1 then
									ls_xpos = "24"
								elseif ll_labelpos = 2 then
									ls_xpos = "273"
								elseif ll_labelpos = 0 then
									ls_xpos = "523"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",149^A0N,12,12^FH\^FD" + ls_mfg_date + "^FS"
								filewrite(li_file, ls_filecontent)
							end if
							if ls_expiry <> "" then
								if ll_labelpos = 1 then
									ls_xpos = "112"
								elseif ll_labelpos = 2 then
									ls_xpos = "362"
								elseif ll_labelpos = 0 then
									ls_xpos = "612"
								end if
								ls_filecontent = "^FT" + ls_xpos + ",149^A0N,12,12^FH\^FD" + ls_expiry + "^FS"
								filewrite(li_file, ls_filecontent)
							end if
							if ll_labelpos = 0 then
								filewrite(li_file, "^PQ1,0,1,Y^XZ")
							end if
							ll_labelno = ll_labelno + 1
						next
					end if
				next
			end if
			if ll_labelpos > 0 then
				filewrite(li_file, "^PQ1,0,1,Y^XZ")
			end if
			fileclose(li_file)
			run("..\BarcodePrint\BP.bat", normal!)
		end if
	end if
	return 0
