// function f_printbarcode_faisaljalil (barcodefunctions)  ancestor: function_object

// f_printbarcode_faisaljalil.f_printbarcode_faisaljalil(datawindow id_master, datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_itemname2
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_expiry
	string ls_mfg
	string ls_defaultinfo
	string ls_currentprinter
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	boolean lb_printlineexists
	integer li_barcodeleninprint
	s_arguements lstr_arg
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	if gs_company = "FAISALJALIL" then
		ls_clientname = "STAPLES"
	end if
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	openwithparm(w_arg_printers, ls_printer)
	lstr_arg = message.powerobjectparm
	if upper(ls_printer) = "TSC TTP-244 PRO" then
		ll_supply_cols_per_row = 2
		ll_labelno = 1
		if ll_totalrows > 0 then
			ll_counter = 1
			tsc_openport_new(lstr_arg.s_name1)
			tsc_setup_new("90", "20", "4", "8", "0", "0", "0")
			tsc_sendcommand_new("GAP 3 mm, 0 mm")
			tsc_sendcommand_new("SPEED 4")
			tsc_sendcommand_new("DENSITY 7")
			tsc_sendcommand_new("DIRECTION 0,0")
			tsc_sendcommand_new("REFERENCE 0,0")
			tsc_sendcommand_new("OFFSET 0 mm")
			tsc_sendcommand_new("SHIFT 0")
			tsc_sendcommand_new("SET PEEL OFF")
			tsc_sendcommand_new("SET CUTTER ON")
			tsc_sendcommand_new("SET TEAR ON")
			tsc_sendcommand_new("CLS")
			tsc_sendcommand_new("CODEPAGE 850")
			for ll_counter = 1 to ll_totalrows
				if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 25)
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					if ib_printprice then
						ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
					else
						ls_price = ""
					end if
					ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
					ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
					if isnull(ls_mfg) then
						ls_mfg = ""
					end if
					if isnull(ls_expiry) then
						ls_expiry = ""
					end if
					if len(ls_mfg) > 0 then
						ls_expiry = ls_mfg + space(2) + ls_expiry
					end if
					tsc_clearbuffer_new()
					ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
					tsc_printerfont_new("325", "148", "0", "180", "11", "9", ls_clientname)
					tsc_printerfont_new("670", "148", "0", "180", "11", "9", ls_clientname)
					tsc_barcode_new("325", "126", "128", "50", "1", "180", "2", "3", ls_aliasname)
					tsc_barcode_new("670", "126", "128", "50", "1", "180", "2", "3", ls_aliasname)
					tsc_printerfont_new("325", "51", "0", "180", "8", "6", ls_itemname)
					tsc_printerfont_new("670", "51", "0", "180", "8", "6", ls_itemname)
					tsc_printerfont_new("325", "34", "0", "180", "11", "11", ls_price)
					tsc_printerfont_new("670", "34", "0", "180", "11", "11", ls_price)
					tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
				end if
			next
			tsc_closeport_new()
		end if
	elseif lower(ls_printer) = lower("Zebra TLP 2844") and ll_totalrows > 0 then
		ll_counter = 1
		li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
		if li_file = -1 then
			messagebox("Error", "Unable to locate file for Label printing")
		else
			ll_supply_cols_per_row = 2
			ll_labelno = 1
			for ll_counter = 1 to ll_totalrows
				if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 30)
					ls_itemname2 = mid(trim(id_detail.getitemstring(ll_counter, "itemname")), 31, 60)
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					if ib_printprice then
						ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
					else
						ls_price = ""
					end if
					if int(ll_qty / ll_supply_cols_per_row) > 0 then
						filewrite(li_file, "")
						filewrite(li_file, "Q168,024")
						filewrite(li_file, "q831")
						filewrite(li_file, "rN")
						filewrite(li_file, "S2")
						filewrite(li_file, "D10")
						filewrite(li_file, "ZT")
						filewrite(li_file, "JB")
						filewrite(li_file, "OD")
						filewrite(li_file, "R84,0")
						filewrite(li_file, "N")
						ls_filecontent = "A640,138,2,1,1,2,N,~"" + ls_clientname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "B640,115,2,1,2,6,52,N,~"" + ls_aliasname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A640,56,2,2,1,1,N,~"" + ls_aliasname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A640,35,2,1,1,1,N,~"" + ls_itemname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A640,18,2,2,1,1,N,~"" + ls_price + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A290,138,2,1,1,2,N,~"" + ls_clientname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "B290,115,2,1,2,6,52,N,~"" + ls_aliasname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A290,56,2,2,1,1,N,~"" + ls_aliasname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A290,35,2,1,1,1,N,~"" + ls_itemname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A290,18,2,2,1,1,N,~"" + ls_price + "~""
						filewrite(li_file, ls_filecontent)
						filewrite(li_file, "P" + trim(string(int(ll_qty / ll_supply_cols_per_row))))
						lb_printlineexists = true
					end if
					if ll_qty mod ll_supply_cols_per_row > 0 then
						filewrite(li_file, "")
						filewrite(li_file, "Q168,024")
						filewrite(li_file, "q831")
						filewrite(li_file, "rN")
						filewrite(li_file, "S2")
						filewrite(li_file, "D10")
						filewrite(li_file, "ZT")
						filewrite(li_file, "JB")
						filewrite(li_file, "OD")
						filewrite(li_file, "R84,0")
						filewrite(li_file, "N")
						ls_filecontent = "A640,138,2,1,1,2,N,~"" + ls_clientname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "B640,115,2,1,2,6,52,N,~"" + ls_aliasname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A640,56,2,2,1,1,N,~"" + ls_aliasname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A640,35,2,1,1,1,N,~"" + ls_itemname + "~""
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "A640,18,2,2,1,1,N,~"" + ls_price + "~""
						filewrite(li_file, ls_filecontent)
						filewrite(li_file, "P1")
						lb_printlineexists = true
					end if
				end if
			next
			fileclose(li_file)
			run("..\BarcodePrint\BP.bat", normal!)
		end if
	end if
	return 0
