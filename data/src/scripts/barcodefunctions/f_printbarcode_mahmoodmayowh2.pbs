// function f_printbarcode_mahmoodmayowh2 (barcodefunctions)  ancestor: function_object

// f_printbarcode_mahmoodmayowh2.f_printbarcode_mahmoodmayowh2(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	long ll_purinvcode
	long ll_job
	long ll_remain_qty
	integer li_startcell
	integer li_stopcell
	integer li_temp
	long li_file
	long li_file2
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_itemname2
	string ls_itemname3
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_contents
	string ls_defaultinfo
	string ls_defaultprinter
	datetime ldt_date
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	if ls_supp_alias = "" or isnull(ls_supp_alias) then
		ls_supp_alias = ""
	end if
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if ls_printer = "Zebra S4M (200dpi)" and ll_totalrows > 0 then
		ll_counter = 1
		li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
		if li_file = -1 then
			messagebox("Error", "Unable to locate file for Label printing")
		else
			ll_supply_cols_per_row = 1
			filewriteex(li_file, "CT~~CD,~~CC^~~CT~~")
			filewriteex(li_file, "^XA~~TA000~~JSN^LT0^MNW^MTD^PON^PMN^LH0,0^JMA^PR4,4~~SD15^JUS^LRN^CI0^XZ")
			ll_labelno = 1
			if id_master.rowcount() > 0 then
				ll_purinvcode = id_master.object.code[1]
				ldt_date = id_master.object.date[1]
				ls_date = string(ldt_date, "yymmdd")
			else
				setnull(ll_purinvcode)
				ls_date = string(today(), "yymmdd")
			end if
			ls_date = mid(ls_date, 2, 1) + left(ls_date, 1) + right(ls_date, 4)
			for ll_counter = 1 to ll_totalrows
				if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 30)
					ls_itemname2 = mid(trim(id_detail.getitemstring(ll_counter, "itemname")), 31, 60)
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					if ib_printprice then
						ls_price = "Rs: " + trim(string(long(id_detail.getitemdecimal(ll_counter, "salepriceforitem")), "###,###,##0"))
					else
						ls_price = ""
					end if
					filewriteex(li_file, "^XA")
					filewriteex(li_file, "^MMT")
					filewriteex(li_file, "^PW304")
					filewriteex(li_file, "^LS0")
					filewriteex(li_file, "^FT10,36^A0N,28,28^FH\^FD" + ls_clientname + "^FS")
					filewriteex(li_file, "^BY2,3,77^FT10,123^BCN,,Y,N")
					filewriteex(li_file, "^FD" + ls_aliasname + "^FS")
					filewriteex(li_file, "^FT10,172^A0N,28,20^FH\^FD" + ls_itemname + "^FS")
					filewriteex(li_file, "^FT10,200^A0N,28,40^FH\^FD" + ls_price + "^FS")
					filewriteex(li_file, "^PQ" + trim(string(ll_qty)) + ",0,1,Y^XZ")
				end if
			next
			fileclose(li_file)
			li_file2 = fileopen("label.prn", textmode!, read!, lockread!)
			if li_file2 = -1 then
				messagebox("Error", "Unable to locate file for Label printing")
				return 0
			else
				filereadex(li_file2, ls_contents)
				fileclose(li_file2)
				ls_defaultinfo = printgetprinter()
				ls_defaultprinter = left(ls_defaultinfo, pos(ls_defaultinfo, "~t") - 1)
				printsetprinter("Zebra S4M (200dpi)")
				ll_job = printopen("waseela", false)
				if ll_job = -1 then
					messagebox("Error", "Unable to Open Print Job for Label printing")
				else
					printsend(ll_job, ls_contents)
					printclose(ll_job)
				end if
				printsetprinter(trim(ls_defaultprinter))
			end if
		end if
	end if
	return 0
