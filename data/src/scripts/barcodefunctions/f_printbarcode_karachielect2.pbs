// function f_printbarcode_karachielect2 (barcodefunctions)  ancestor: function_object

// f_printbarcode_karachielect2.f_printbarcode_karachielect2(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	long ll_purinvcode
	long ll_job
	long ll_remain_qty
	integer li_startcell
	integer li_stopcell
	integer li_temp
	long li_file
	long li_file2
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_itemname2
	string ls_itemname3
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_contents
	string ls_defaultinfo
	string ls_defaultprinter
	datetime ldt_date
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = "KES GROUP"
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	if ls_supp_alias = "" or isnull(ls_supp_alias) then
		ls_supp_alias = ""
	end if
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if ls_printer = "Zebra ZT230" and ll_totalrows > 0 then
		ll_counter = 1
		li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
		if li_file = -1 then
			messagebox("Error", "Unable to locate file for Label printing")
		else
			ls_format = id_master.object.labelformat[1]
			ll_supply_cols_per_row = 2
			filewriteex(li_file, "^XATA000JSN^LT0^MMT^MNW^MTT^PON^PMN^LH0,0^JMA^PR4,4^MD20^JUS^LRN^CI0^XZ")
			ll_labelno = 1
			for ll_counter = 1 to ll_totalrows
				if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 25)
					ls_itemname2 = mid(trim(id_detail.getitemstring(ll_counter, "itemname")), 26, 25)
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					if ib_printprice then
						ls_price = "Rs: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "##,###,##0.00"))
					else
						ls_price = ""
					end if
					for ll_innercounter = 1 to ll_qty
						ll_labelpos = ll_labelno mod ll_supply_cols_per_row
						if ll_labelpos = 1 then
							filewriteex(li_file, "^XA^LL0230")
							filewriteex(li_file, "^PW643")
						end if
						if ll_labelpos = 1 then
							ls_xpos = "10"
						else
							ls_xpos = "335"
						end if
						ls_filecontent = "^FT" + ls_xpos + ",35^A0N,27,40^FH\^FD" + ls_clientname + "^FS"
						filewriteex(li_file, ls_filecontent)
						if ll_labelpos = 1 then
							ls_xpos = "10"
						else
							ls_xpos = "335"
						end if
						ls_filecontent = "^BY2,3,75^FT" + ls_xpos + ",115^BCN,,Y,N"
						filewriteex(li_file, ls_filecontent)
						filewriteex(li_file, "^FD" + ls_aliasname + "^FS")
						if ll_labelpos = 1 then
							ls_xpos = "10"
						else
							ls_xpos = "335"
						end if
						ls_filecontent = "^FT" + ls_xpos + ",160^A0N,23,21^FH\^FD" + ls_itemname + "^FS"
						filewriteex(li_file, ls_filecontent)
						if ll_labelpos = 1 then
							ls_xpos = "10"
						else
							ls_xpos = "335"
						end if
						ls_filecontent = "^FT" + ls_xpos + ",180^A0N,23,21^FH\^FD" + ls_itemname2 + "^FS"
						filewriteex(li_file, ls_filecontent)
						if ll_labelpos = 1 then
							ls_xpos = "10"
						else
							ls_xpos = "335"
						end if
						ls_filecontent = "^FT" + ls_xpos + ",207^A0N,28,40^FH\^FD" + ls_price + "^FS"
						filewriteex(li_file, ls_filecontent)
						if ll_labelpos = 0 then
							filewriteex(li_file, "^PQ1,0,1,Y^XZ")
						end if
						ll_labelno = ll_labelno + 1
					next
				end if
			next
			if ll_labelpos > 0 then
				filewriteex(li_file, "^PQ1,0,1,Y^XZ")
			end if
			fileclose(li_file)
			li_file2 = fileopen("label.prn", textmode!, read!, lockread!)
			if li_file2 = -1 then
				messagebox("Error", "Unable to locate file for Label printing")
				return 0
			else
				filereadex(li_file2, ls_contents)
				fileclose(li_file2)
				ls_defaultinfo = printgetprinter()
				ls_defaultprinter = left(ls_defaultinfo, pos(ls_defaultinfo, "~t") - 1)
				printsetprinter("Zebra ZT230")
				ll_job = printopen("waseela", false)
				if ll_job = -1 then
					messagebox("Error", "Unable to Open Print Job for Label printing")
				else
					printsend(ll_job, ls_contents)
					printclose(ll_job)
				end if
				printsetprinter(trim(ls_defaultprinter))
			end if
		end if
	end if
	return 0
