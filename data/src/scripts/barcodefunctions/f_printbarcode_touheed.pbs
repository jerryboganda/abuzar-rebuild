// function f_printbarcode_touheed (barcodefunctions)  ancestor: function_object

// f_printbarcode_touheed.f_printbarcode_touheed(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	long ll_icode
	long ll_ret
	long li_file
	long li_file2
	long ll_job
	integer li_startcell
	integer li_stopcell
	integer li_temp
	double ld_prefsaleqty
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_brandname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_packing
	string ls_expdate
	string ls_prefsaleqty
	string ls_sizedescription
	string ls_size
	string ls_mrp
	string ls_barcode
	string ls_expiry
	string ls_mfg
	string ls_err
	string ls_contents
	string ls_defaultinfo
	string ls_defaultprinter
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_date = "PD:" + trim(string(today(), "dd-mm-yy"))
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 21)
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if upper(ls_printer) = "TSC TTP-244 PRO" then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PRO")
				tsc_setup_new("50", "38", "5", "12", "0", "3", "0")
				for ll_counter = 1 to ll_totalrows
					ll_icode = id_detail.object.icode[ll_counter]
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint then
						SQL SELECT PrefferedSaleQty INTO :ld_prefsaleqty FROM Item WHERE ICode =:ll_icode USING sqlca;
						if ld_prefsaleqty <= 0.0 or isnull(ld_prefsaleqty) then
							ld_prefsaleqty = 1
						end if
						ls_prefsaleqty = string(ld_prefsaleqty, f_setcolumnformat("Qty"))
						if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
							ll_qty = id_detail.getitemnumber(ll_counter, "qty")
							ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
							ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), 15)
							if ib_printprice then
								ls_price = "Rs:" + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "#####0"))
							else
								ls_price = ""
							end if
							ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
							tsc_clearbuffer_new()
							tsc_windowsfont_new(10, 12, 50, 0, 2, 1, "Arial Black", "D.No.")
							tsc_windowsfont_new(220, 12, 50, 0, 3, 0, "Arial Black", "A.T.G")
							tsc_windowsfont_new(10, 40, 83, 0, 2, 0, "Arial Black", ls_aliasname)
							tsc_barcode_new("10", "117", "128", "45", "0", "0", "3", "7", ls_aliasname)
							tsc_windowsfont_new(10, 165, 28, 0, 2, 0, "Arial", ls_itemname)
							tsc_windowsfont_new(10, 190, 32, 0, 2, 0, "Arial", "Packed =")
							tsc_windowsfont_new(10, 210, 75, 0, 2, 0, "Arial Black", ls_prefsaleqty)
							tsc_windowsfont_new(110, 210, 80, 0, 2, 0, "Arial Black", ls_price)
							tsc_printlabel_new("1", string(ll_qty))
						end if
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "2" then
			li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
			if li_file = -1 then
				messagebox("Error", "Unable to locate file for Label printing")
				return 0
			else
				ls_filecontent = "SIZE 50 mm, 25 mm"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "GAP 3 mm, 0 mm"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "DIRECTION 0,0"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "REFERENCE 0,0"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "OFFSET 0 mm"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "SET PEEL OFF"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "SET CUTTER OFF"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "SET TEAR ON"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "CODEPAGE 1252"
				filewrite(li_file, ls_filecontent)
				for ll_counter = 1 to ll_totalrows
					if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ls_filecontent = ""
						ls_itemname = ""
						ls_aliasname = ""
						ls_price = ""
						ls_prefsaleqty = ""
						ls_itemname = ""
						ls_aliasname = ""
						ls_supp_alias = ""
						ls_manufshortname = ""
						ls_design = ""
						ls_size = ""
						ls_sizedescription = ""
						ls_mrp = ""
						ls_barcode = ""
						ll_qty = 0
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 25)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						ls_manufshortname = id_detail.object.manufshortname[ll_counter]
						if isnull(ls_manufshortname) then
							ls_manufshortname = ""
						end if
						ls_supp_alias = id_detail.object.suppcode[ll_counter]
						if isnull(ls_supp_alias) or ls_supp_alias = "-1" then
							ls_supp_alias = ""
						end if
						ls_design = id_detail.object.design[ll_counter]
						if isnull(ls_design) then
							ls_design = ""
						end if
						ls_size = id_detail.object.size[ll_counter]
						if isnull(ls_size) then
							ls_size = ""
						end if
						ls_sizedescription = id_detail.object.sizedescription[ll_counter]
						if isnull(ls_sizedescription) then
							ls_sizedescription = ""
						end if
						ls_prefsaleqty = trim(string(id_detail.object.prefferedsaleqty[ll_counter], "###0"))
						if isnull(ls_prefsaleqty) then
							ls_prefsaleqty = ""
						end if
						ls_prefsaleqty = fill("0", 2 - len(ls_prefsaleqty)) + ls_prefsaleqty
						if isnull(ls_prefsaleqty) then
							ls_prefsaleqty = ""
						end if
						ls_mrp = id_detail.object.mrp[ll_counter]
						if isnull(ls_mrp) or ls_mrp = "-1" then
							ls_mrp = ""
						end if
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "###,##0"))
						else
							ls_price = ""
						end if
						ls_expiry = "Exp:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						ls_mfg = "Mfg:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						if isnull(ls_mfg) then
							ls_mfg = ""
						end if
						if isnull(ls_expiry) then
							ls_expiry = ""
						end if
						if len(ls_mfg) > 0 then
							ls_expiry = ls_mfg + space(2) + ls_expiry
						end if
						ls_barcode = ""
						ls_aliasname = fill("0", 8 - len(ls_aliasname)) + ls_aliasname
						ll_ret = f_getean13_barcode("98", ls_aliasname, ls_prefsaleqty, ls_barcode, ls_err)
						if ll_ret = 0 then
							ls_filecontent = "CLS"
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "TEXT 193,180,~"0~",180,20,18,~"®~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "TEXT 303,172,~"0~",180,15,18,~"ATG~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "BARCODE 303,96,~"EAN13~",75,1,180,2,4,~"" + ls_barcode + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "TEXT 267,125,~"0~",180,10,10,~"" + space((12 - len(ls_supp_alias)) / 2.0) + ls_supp_alias + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "TEXT 390,15,~"0~",90,9,9,~"" + space((15 - len(ls_manufshortname)) / 2.0) + ls_manufshortname + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "TEXT 362,15,~"0~",90,9,9,~"" + space((15 - len(ls_design)) / 2.0) + ls_design + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "TEXT 334,15,~"0~",90,9,9,~"" + space((15 - len(ls_mrp)) / 2.0) + ls_mrp + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "TEXT 100,20,~"0~",180,8,8,~"" + ls_prefsaleqty + "x1" + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "TEXT 95,38,~"0~",90,9,9,~"" + ls_size + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "TEXT 73,49,~"0~",90,9,9,~"" + ls_sizedescription + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "TEXT 50,20,~"0~",90,13,13,~"" + ls_price + "~""
							filewrite(li_file, ls_filecontent)
							ls_filecontent = "PRINT " + trim(string(ll_qty))
							filewrite(li_file, ls_filecontent)
						end if
					end if
				next
				fileclose(li_file)
				li_file2 = fileopen("label.prn", textmode!, read!, lockread!)
				if li_file2 = -1 then
					messagebox("Error", "Unable to locate file for Label printing")
					return 0
				else
					filereadex(li_file2, ls_contents)
					fileclose(li_file2)
					ls_defaultinfo = printgetprinter()
					ls_defaultprinter = left(ls_defaultinfo, pos(ls_defaultinfo, "~t") - 1)
					printsetprinter("TSC TTP-244 PRO")
					ll_job = printopen("waseela", false)
					if ll_job = -1 then
						messagebox("Error", "Unable to Open Print Job for Label printing")
					else
						printsend(ll_job, ls_contents)
						printclose(ll_job)
					end if
					printsetprinter(trim(ls_defaultprinter))
				end if
			end if
		elseif ls_format = "3" and ll_totalrows > 0 then
			ll_counter = 1
			tsc_openport_new("TSC TTP-244 PRO")
			tsc_setup_new("50", "25", "5", "12", "0", "3", "0")
			for ll_counter = 1 to ll_totalrows
				ll_icode = id_detail.object.icode[ll_counter]
				if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint then
					SQL SELECT PrefferedSaleQty , Brand =ISNULL ( ( SELECT B.Name FROM ItemBrand B WHERE B.IBrandCode =Item.IBrandCode ) , '' ) INTO :ld_prefsaleqty, :ls_brandname FROM Item WHERE ICode =:ll_icode USING sqlca;
					if ld_prefsaleqty <= 0.0 or isnull(ld_prefsaleqty) then
						ld_prefsaleqty = 1
					end if
					ls_prefsaleqty = string(ld_prefsaleqty, f_setcolumnformat("Qty"))
					if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), 15)
						if ib_printprice then
							ls_price = "Rs:" + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2), "#####0"))
						else
							ls_price = ""
						end if
						ls_packing = left(trim(id_detail.getitemstring(ll_counter, "packing")), 30)
						tsc_clearbuffer_new()
						tsc_windowsfont_new(10, 1, 50, 0, 2, 1, "Arial Black", "D-" + ls_aliasname)
						tsc_windowsfont_new(270, 1, 35, 0, 3, 0, "Arial Black", "A.T.G®" + space(5))
						tsc_windowsfont_new(270, 30, 20, 0, 2, 0, "Arial Black", ls_brandname)
						tsc_barcode_new("10", "52", "128", "50", "0", "0", "3", "7", ls_aliasname)
						tsc_windowsfont_new(10, 105, 28, 0, 2, 0, "Arial", ls_itemname)
						tsc_windowsfont_new(10, 115, 75, 0, 2, 0, "Arial Black", ls_prefsaleqty)
						tsc_windowsfont_new(110, 115, 75, 0, 2, 0, "Arial Black", ls_price)
						tsc_printlabel_new("1", string(ll_qty))
					end if
				end if
			next
			tsc_closeport_new()
		end if
	end if
	return 0
