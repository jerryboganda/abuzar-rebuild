// function f_printbarcode_moveandpick (barcodefunctions)  ancestor: function_object

// f_printbarcode_moveandpick.f_printbarcode_moveandpick(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ls_clientname = "MOV & PICK"
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if upper(ls_printer) = "TSC TTP-244 PLUS" then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			ll_supply_cols_per_row = 3
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PLUS")
				tsc_setup_new("89.5", "18", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER OFF")
				tsc_sendcommand_new("SET TEAR ON")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 29)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_printerfont_new("220", "138", "0", "180", "14", "9", ls_clientname)
						tsc_printerfont_new("463", "138", "0", "180", "14", "9", ls_clientname)
						tsc_printerfont_new("705", "138", "0", "180", "14", "9", ls_clientname)
						tsc_barcode_new("213", "111", "128", "48", "0", "180", "2", "4", ls_aliasname)
						tsc_barcode_new("456", "111", "128", "48", "0", "180", "2", "4", ls_aliasname)
						tsc_barcode_new("698", "111", "128", "48", "0", "180", "2", "4", ls_aliasname)
						tsc_printerfont_new("173", "62", "ROMAN.TTF", "180", "1", "7", ls_aliasname)
						tsc_printerfont_new("416", "62", "ROMAN.TTF", "180", "1", "7", ls_aliasname)
						tsc_printerfont_new("658", "62", "ROMAN.TTF", "180", "1", "7", ls_aliasname)
						tsc_printerfont_new("221", "46", "0", "180", "5", "6", ls_itemname)
						tsc_printerfont_new("464", "46", "0", "180", "5", "6", ls_itemname)
						tsc_printerfont_new("706", "46", "0", "180", "5", "6", ls_itemname)
						tsc_printerfont_new("221", "29", "0", "180", "13", "8", ls_price)
						tsc_printerfont_new("464", "29", "0", "180", "13", "8", ls_price)
						tsc_printerfont_new("706", "29", "0", "180", "13", "8", ls_price)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_formfeed_new()
				tsc_closeport_new()
			end if
		elseif ls_format = "2" then
			ll_supply_cols_per_row = 2
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PLUS")
				tsc_setup_new("76.10", "28.7", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER OFF")
				tsc_sendcommand_new("SET TEAR OFF")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 25)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), 10)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_printerfont_new("604", "225", "0", "180", "7", "10", ls_clientname)
						tsc_printerfont_new("275", "225", "0", "180", "7", "10", ls_clientname)
						tsc_barcode_new("604", "190", "39", "80", "1", "180", "2", "5", ls_aliasname)
						tsc_barcode_new("275", "190", "39", "80", "1", "180", "2", "5", ls_aliasname)
						tsc_printerfont_new("604", "85", "0", "180", "8", "6", ls_itemname)
						tsc_printerfont_new("275", "85", "0", "180", "8", "6", ls_itemname)
						tsc_printerfont_new("604", "65", "0", "180", "9", "8", ls_price)
						tsc_printerfont_new("275", "65", "0", "180", "9", "8", ls_price)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		else
			ll_supply_cols_per_row = 2
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-244 PLUS")
				tsc_setup_new("76.10", "28.7", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER OFF")
				tsc_sendcommand_new("SET TEAR OFF")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 25)
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), 10)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_printerfont_new("604", "225", "0", "180", "7", "10", ls_clientname)
						tsc_printerfont_new("275", "225", "0", "180", "7", "10", ls_clientname)
						tsc_printerfont_new("604", "190", "0", "180", "7", "10", ls_aliasname)
						tsc_printerfont_new("275", "190", "0", "180", "7", "10", ls_aliasname)
						tsc_printerfont_new("604", "155", "0", "180", "7", "10", ls_itemname)
						tsc_printerfont_new("275", "155", "0", "180", "7", "10", ls_itemname)
						tsc_printerfont_new("604", "115", "0", "180", "25", "25", ls_price)
						tsc_printerfont_new("275", "115", "0", "180", "25", "25", ls_price)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		end if
	end if
	return 0
