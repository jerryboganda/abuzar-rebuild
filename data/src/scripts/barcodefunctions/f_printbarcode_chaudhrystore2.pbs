// function f_printbarcode_chaudhrystore2 (barcodefunctions)  ancestor: function_object

// f_printbarcode_chaudhrystore2.f_printbarcode_chaudhrystore2(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	long ll_job
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	integer li_file2
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_contents
	string ls_expiry
	string ls_mfg
	string ls_manufaddress
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if lower(ls_printer) = lower("Zebra TLP 2844z") then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
			if li_file = -1 then
				messagebox("Error", "Unable to locate file for Label printing")
				return 0
			else
				ls_filecontent = ""
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "CT~~CD,~~CC^~~CT~~"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^XA~~TA000~~JSN^LT0^MNW^MTT^PON^PMN^LH0,0^JMA^PR2,2SD15^JUS^LRN^CI0^XZ"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^MMT"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^PW480"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^LL0320"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^LS0"
				filewrite(li_file, ls_filecontent)
				for ll_counter = 1 to ll_totalrows
					if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs.: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						ls_mfg = "Mfg. Date:" + string(id_detail.object.manfdate[ll_counter], "dd-mmm-yyyy")
						if isnull(ls_mfg) then
							ls_mfg = ""
						end if
						ls_expiry = "Exp. Date:" + string(id_detail.object.expiry[ll_counter], "dd-mmm-yyyy")
						if isnull(ls_expiry) then
							ls_expiry = ""
						end if
						if len(ls_mfg) > 0 then
							ls_expiry = ls_mfg + ", " + ls_expiry
						end if
						ls_manufshortname = trim(id_detail.getitemstring(ll_counter, "ManufShortName"))
						ls_manufaddress = "Packed By Azhar Store"
						if isnull(ls_manufshortname) then
							ls_manufshortname = ""
						else
							ls_manufshortname = "Mfg. By:" + ls_manufshortname
						end if
						ls_filecontent = "^XA"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FT330,274^A0I,35,35^FH\^FD" + "Azhar Store" + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^BY2,2^FT375,186^BCI,80,Y,N,N,A"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FD" + ls_aliasname + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FT460,142^A0I,27,26^FH\^FD" + ls_itemname + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FT460,120^A0I,20,20^FH\^FD" + ls_expiry + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FT460,100^A0I,20,20^FH\^FD" + ls_manufshortname + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FT460,80^A0I,20,20^FH\^FD" + ls_manufaddress + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FT460,60^A0I,20,20^FH\^FD" + "Address: " + trim(f_reportheaderinfo_wrt_headerno("address1", ll_headerno)) + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FT460,40^A0I,20,20^FH\^FD" + "Phone No: " + trim(f_reportheaderinfo_wrt_headerno("phone", ll_headerno)) + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FT460,05^A0I,35,60^FH\^FD" + ls_price + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^PQ" + trim(string(ll_qty)) + ",0,1,N^XZ"
						filewrite(li_file, ls_filecontent)
					end if
				next
				fileclose(li_file)
				li_file2 = fileopen("label.prn", textmode!, read!, lockread!)
				if li_file2 = -1 then
					messagebox("Error", "Unable to locate file for Label printing")
					return 0
				else
					filereadex(li_file2, ls_contents)
					fileclose(li_file2)
					printsetprinter("Zebra TLP 2844z")
					ll_job = printopen("waseela", false)
					if ll_job = -1 then
						messagebox("Error", "Unable to Open Print Job for Label printing")
					else
						printsend(ll_job, ls_contents)
						printclose(ll_job)
					end if
				end if
			end if
		else
			li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
			if li_file = -1 then
				messagebox("Error", "Unable to locate file for Label printing")
				return 0
			else
				ls_filecontent = ""
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "CT~~CD,~~CC^~~CT~~"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^XA~~TA000~~JSN^LT0^MNW^MTT^PON^PMN^LH0,0^JMA^PR2,2SD15^JUS^LRN^CI0^XZ"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^MMT"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^PW480"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^LL0320"
				filewrite(li_file, ls_filecontent)
				ls_filecontent = "^LS0"
				filewrite(li_file, ls_filecontent)
				for ll_counter = 1 to ll_totalrows
					if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs.: " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						ls_filecontent = "^XA"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FT330,270^A0I,45,45^FH\^FD" + "Azhar Store" + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^BY2,2^FT375,151^BCI,100,Y,N,N,A"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FD" + ls_aliasname + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FT460,95^A0I,27,26^FH\^FD" + ls_itemname + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FT460,73^A0I,27,26^FH\^FD" + mid(ls_itemname, 36, 35) + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FT460,20^A0I,52,57^FH\^FD" + ls_price + "^FS"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^PQ" + trim(string(ll_qty)) + ",0,1,N^XZ"
						filewrite(li_file, ls_filecontent)
					end if
				next
				fileclose(li_file)
				li_file2 = fileopen("label.prn", textmode!, read!, lockread!)
				if li_file2 = -1 then
					messagebox("Error", "Unable to locate file for Label printing")
					return 0
				else
					filereadex(li_file2, ls_contents)
					fileclose(li_file2)
					printsetprinter("Zebra TLP 2844z")
					ll_job = printopen("waseela", false)
					if ll_job = -1 then
						messagebox("Error", "Unable to Open Print Job for Label printing")
					else
						printsend(ll_job, ls_contents)
						printclose(ll_job)
					end if
				end if
			end if
		end if
	end if
	return 0
