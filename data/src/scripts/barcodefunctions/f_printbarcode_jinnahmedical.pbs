// function f_printbarcode_jinnahmedical (barcodefunctions)  ancestor: function_object

// f_printbarcode_jinnahmedical.f_printbarcode_jinnahmedical(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_packing
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if upper(ls_printer) = "TSC TTP-244 PRO" then
		ll_supply_cols_per_row = 3
		ll_labelno = 1
		if ll_totalrows > 0 then
			ll_counter = 1
			tsc_openport_new("TSC TTP-244 PRO")
			tsc_setup_new("105", "19", "5", "10", "0", "0", "0")
			tsc_sendcommand_new("GAP 2 mm, 2 mm")
			tsc_sendcommand_new("SPEED 4")
			tsc_sendcommand_new("DENSITY 10")
			tsc_sendcommand_new("DIRECTION 0,0")
			tsc_sendcommand_new("REFERENCE 0,0")
			tsc_sendcommand_new("OFFSET 0 mm")
			tsc_sendcommand_new("SHIFT 0")
			tsc_sendcommand_new("SET PEEL OFF")
			tsc_sendcommand_new("SET CUTTER ON")
			tsc_sendcommand_new("SET TEAR ON")
			tsc_sendcommand_new("CLS")
			tsc_sendcommand_new("CODEPAGE 850")
			for ll_counter = 1 to ll_totalrows
				if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 35)
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), 10)
					if ib_printprice then
						ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
					else
						ls_price = ""
					end if
					tsc_clearbuffer_new()
					ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
					tsc_printerfont_new("765", "155", "0", "180", "10", "6", ls_clientname)
					tsc_printerfont_new("500", "155", "0", "180", "10", "6", ls_clientname)
					tsc_printerfont_new("240", "155", "0", "180", "10", "6", ls_clientname)
					tsc_barcode_new("765", "135", "128", "55", "1", "180", "2", "3", ls_aliasname)
					tsc_barcode_new("500", "135", "128", "55", "1", "180", "2", "3", ls_aliasname)
					tsc_barcode_new("240", "135", "128", "55", "1", "180", "2", "3", ls_aliasname)
					tsc_printerfont_new("765", "52", "0", "180", "8", "6", left(ls_itemname, 20))
					tsc_printerfont_new("500", "52", "0", "180", "8", "6", left(ls_itemname, 20))
					tsc_printerfont_new("240", "52", "0", "180", "8", "6", left(ls_itemname, 20))
					tsc_printerfont_new("765", "37", "0", "180", "8", "6", mid(ls_itemname, 21, 20))
					tsc_printerfont_new("500", "37", "0", "180", "8", "6", mid(ls_itemname, 21, 20))
					tsc_printerfont_new("240", "37", "0", "180", "8", "6", mid(ls_itemname, 21, 20))
					tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
				end if
			next
			tsc_closeport_new()
		end if
	end if
	return 0
