// function f_printbarcode_sabirsuperstore2 (barcodefunctions)  ancestor: function_object

// f_printbarcode_sabirsuperstore2.f_printbarcode_sabirsuperstore2(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_packing
	string ls_mfg_date
	string ls_expiry
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 21)
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ls_date = string(today(), "dd/mm/yyyy")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if upper(ls_printer) = "TSC TTP-245 PLUS" then
		ls_format = id_master.object.labelformat[1]
		if ls_format = "1" then
			ll_supply_cols_per_row = 3
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-245 PLUS")
				tsc_setup_new("100", "20", "2", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 2 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER ON")
				tsc_sendcommand_new("SET TEAR ON")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_printerfont_new("247", "168", "0", "180", "9", "8", ls_clientname)
						tsc_printerfont_new("512", "168", "0", "180", "9", "8", ls_clientname)
						tsc_printerfont_new("777", "168", "0", "180", "9", "8", ls_clientname)
						tsc_barcode_new("247", "146", "128", "40", "0", "180", "2", "3", ls_aliasname)
						tsc_barcode_new("512", "146", "128", "40", "0", "180", "2", "3", ls_aliasname)
						tsc_barcode_new("777", "146", "128", "40", "0", "180", "2", "3", ls_aliasname)
						tsc_printerfont_new("247", "103", "0", "180", "8", "7", ls_aliasname)
						tsc_printerfont_new("512", "103", "0", "180", "8", "7", ls_aliasname)
						tsc_printerfont_new("777", "103", "0", "180", "8", "7", ls_aliasname)
						tsc_printerfont_new("113", "103", "0", "180", "7", "6", ls_date)
						tsc_printerfont_new("373", "103", "0", "180", "7", "6", ls_date)
						tsc_printerfont_new("638", "103", "0", "180", "7", "6", ls_date)
						tsc_printerfont_new("247", "84", "0", "180", "7", "6", trim(left(ls_itemname, 24)))
						tsc_printerfont_new("512", "84", "0", "180", "7", "6", trim(left(ls_itemname, 24)))
						tsc_printerfont_new("777", "84", "0", "180", "7", "6", trim(left(ls_itemname, 24)))
						tsc_printerfont_new("247", "68", "0", "180", "7", "6", trim(mid(ls_itemname, 25, 24)))
						tsc_printerfont_new("512", "68", "0", "180", "7", "6", trim(mid(ls_itemname, 25, 24)))
						tsc_printerfont_new("777", "68", "0", "180", "7", "6", trim(mid(ls_itemname, 25, 24)))
						tsc_printerfont_new("247", "52", "0", "180", "10", "10", ls_price)
						tsc_printerfont_new("512", "52", "0", "180", "10", "10", ls_price)
						tsc_printerfont_new("777", "52", "0", "180", "10", "10", ls_price)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		elseif ls_format = "2" then
			ll_supply_cols_per_row = 2
			ll_labelno = 1
			if ll_totalrows > 0 then
				ll_counter = 1
				tsc_openport_new("TSC TTP-245 PLUS")
				tsc_setup_new("85", "28.7", "4", "8", "0", "0", "0")
				tsc_sendcommand_new("GAP 3 mm, 0 mm")
				tsc_sendcommand_new("SPEED 4")
				tsc_sendcommand_new("DENSITY 7")
				tsc_sendcommand_new("DIRECTION 0,0")
				tsc_sendcommand_new("REFERENCE 0,0")
				tsc_sendcommand_new("OFFSET 0 mm")
				tsc_sendcommand_new("SHIFT 0")
				tsc_sendcommand_new("SET PEEL OFF")
				tsc_sendcommand_new("SET CUTTER ON")
				tsc_sendcommand_new("SET TEAR ON")
				tsc_sendcommand_new("CLS")
				tsc_sendcommand_new("CODEPAGE 850")
				for ll_counter = 1 to ll_totalrows
					if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
						ll_qty = id_detail.getitemnumber(ll_counter, "qty")
						ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
						ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
						if ib_printprice then
							ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
						else
							ls_price = ""
						end if
						if isnull(id_detail.object.expiry[ll_counter]) then
							ls_expiry = ""
						else
							ls_expiry = "Expiry:" + string(id_detail.object.expiry[ll_counter], "dd/mm/yyyy")
						end if
						if isnull(id_detail.object.manfdate[ll_counter]) then
							ls_mfg_date = ""
						else
							ls_mfg_date = "Mfg.:" + string(id_detail.object.manfdate[ll_counter], "dd/mm/yyyy")
						end if
						tsc_clearbuffer_new()
						ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
						tsc_windowsfont_new(635, 223, 30, 180, 2, 0, "Arial", ls_clientname)
						tsc_windowsfont_new(305, 223, 30, 180, 2, 0, "Arial", ls_clientname)
						tsc_barcode_new("635", "195", "128", "72", "0", "180", "2", "3", ls_aliasname)
						tsc_barcode_new("305", "195", "128", "72", "0", "180", "2", "3", ls_aliasname)
						tsc_windowsfont_new(637, 122, 25, 180, 2, 0, "Arial", ls_aliasname)
						tsc_windowsfont_new(307, 122, 25, 180, 2, 0, "Arial", ls_aliasname)
						tsc_windowsfont_new(637, 99, 20, 180, 2, 0, "Arial", left(ls_itemname, 24))
						tsc_windowsfont_new(307, 99, 20, 180, 2, 0, "Arial", left(ls_itemname, 24))
						tsc_windowsfont_new(637, 79, 20, 180, 2, 0, "Arial", mid(ls_itemname, 25, 24))
						tsc_windowsfont_new(307, 79, 20, 180, 2, 0, "Arial", mid(ls_itemname, 25, 24))
						tsc_windowsfont_new(637, 63, 35, 180, 2, 0, "Arial", ls_price)
						tsc_windowsfont_new(307, 63, 35, 180, 2, 0, "Arial", ls_price)
						tsc_windowsfont_new(637, 32, 18, 180, 2, 0, "Arial", ls_mfg_date)
						tsc_windowsfont_new(307, 32, 18, 180, 2, 0, "Arial", ls_mfg_date)
						tsc_windowsfont_new(496, 32, 18, 180, 2, 0, "Arial", ls_expiry)
						tsc_windowsfont_new(166, 32, 18, 180, 2, 0, "Arial", ls_expiry)
						tsc_printlabel_new("1", trim(string(ll_tot_label_rows)))
					end if
				next
				tsc_closeport_new()
			end if
		end if
	end if
	return 0
