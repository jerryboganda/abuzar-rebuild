// function f_printbarcode_zebra_zs4m_300dpi (barcodefunctions)  ancestor: function_object

// f_printbarcode_zebra_zs4m_300dpi.f_printbarcode_zebra_zs4m_300dpi(datawindow id_master, datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 21)
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if lower(ls_printer) = lower("Zebra S4M (300dpi)") and ll_totalrows > 0 then
		ll_counter = 1
		li_file = fileopen("label.prn", linemode!, write!, lockwrite!, replace!)
		if li_file = -1 then
			messagebox("Error", "Unable to locate file for Label printing")
		else
			ll_supply_cols_per_row = 2
			filewrite(li_file, "^XA~~TA000~~JSN^LT0^MMT^MNW^MTT^PON^PMN^LH0,0^JMA^PR4,4^MD10^JUS^LRN^CI0^XZ")
			ll_labelno = 1
			for ll_counter = 1 to ll_totalrows
				if id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = left(trim(id_detail.getitemstring(ll_counter, "itemname")), 25)
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), 12)
					if ib_printprice then
						ls_price = trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
					else
						ls_price = ""
					end if
					for ll_innercounter = 1 to ll_qty
						ll_labelpos = ll_labelno mod ll_supply_cols_per_row
						if ll_labelpos = 1 then
							filewrite(li_file, "^XA^LL0330")
							filewrite(li_file, "^PW990")
						end if
						if ll_labelpos = 1 then
							ls_xpos = "36"
						else
							ls_xpos = "531"
						end if
						ls_filecontent = "^BY3,3,126^FT" + ls_xpos + ",191^BCN,,N,N"
						filewrite(li_file, ls_filecontent)
						ls_filecontent = "^FD>:" + ls_aliasname + ">63^FS"
						filewrite(li_file, ls_filecontent)
						if ll_labelpos = 1 then
							ls_xpos = "87"
						else
							ls_xpos = "582"
						end if
						ls_filecontent = "^FT" + ls_xpos + ",228^A0N,42,40^FH\^FD" + ls_aliasname + "^FS"
						filewrite(li_file, ls_filecontent)
						if ll_labelpos = 1 then
							ls_xpos = "19"
						else
							ls_xpos = "514"
						end if
						ls_filecontent = "^FT" + ls_xpos + ",270^A0N,33,33^FH\^FD" + ls_itemname + "^FS"
						filewrite(li_file, ls_filecontent)
						if ll_labelpos = 1 then
							ls_xpos = "19"
						else
							ls_xpos = "514"
						end if
						ls_filecontent = "^FT" + ls_xpos + ",315^A0N,42,40^FH\^FDRs.^FS"
						filewrite(li_file, ls_filecontent)
						if ll_labelpos = 1 then
							ls_xpos = "79"
						else
							ls_xpos = "574"
						end if
						ls_filecontent = "^FT" + ls_xpos + ",317^A0N,42,40^FH\^FD" + ls_price + "^FS"
						filewrite(li_file, ls_filecontent)
						if ll_labelpos = 1 then
							ls_xpos = "114"
						else
							ls_xpos = "609"
						end if
						ls_filecontent = "^FT" + ls_xpos + ",49^A0N,42,40^FH\^FD" + ls_clientname_25_char + "^FS"
						filewrite(li_file, ls_filecontent)
						if ll_labelpos = 0 then
							filewrite(li_file, "^PQ1,0,1,Y^XZ")
						end if
						ll_labelno = ll_labelno + 1
					next
				end if
			next
			if ll_labelpos > 0 then
				filewrite(li_file, "^PQ1,0,1,Y^XZ")
			end if
			fileclose(li_file)
			run("..\BarcodePrint\BP.bat", normal!)
		end if
	end if
	return 0
