// function f_printbarcode_tsc_b_2404 (barcodefunctions)  ancestor: function_object

// f_printbarcode_tsc_b_2404.f_printbarcode_tsc_b_2404(ref datawindow id_master, ref datawindow id_detail, boolean ib_printprice) returns long
	long ll_totalrows
	long ll_counter
	long ll_innercounter
	long ll_qty
	long ll_currrow
	long ll_tot_label_rows
	integer li_startcell
	integer li_stopcell
	integer li_temp
	integer li_file
	string ls_clientname
	string ls_clientname_25_char
	string ls_itemname
	string ls_aliasname
	string ls_price
	string ls_filecontent
	string ls_seperator
	string ls_date
	string ls_format
	string ls_xpos
	string ls_infocode
	string ls_printer
	string ls_manufshortname
	string ls_design
	string ls_purprice
	string ls_supp_alias
	string ls_packing
	long ll_headerno
	long ll_labelno
	long ll_labelpos
	long ll_supply_cols_per_row
	integer li_barcodeleninprint
	ls_seperator = ";"
	ls_supp_alias = id_master.object.aliasname[id_master.getrow()]
	ll_headerno = id_master.getitemnumber(id_master.getrow(), "headerno")
	ls_clientname = trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno))
	ls_clientname_25_char = upper(left(trim(f_reportheaderinfo_wrt_headerno("clientname", ll_headerno)), 25))
	li_barcodeleninprint = f_numberpreferences("BarCodeLenInPrint")
	ll_totalrows = id_detail.rowcount()
	ls_printer = trim(id_master.object.barcodeprinter[1])
	if lower(ls_printer) = lower("TSC  B-2404") then
		ls_format = id_master.object.labelformat[1]
		ll_supply_cols_per_row = 2
		ll_labelno = 1
		if ll_totalrows > 0 then
			ll_counter = 1
			bcp_openport_new("TSC  B-2404")
			bcp_setup_new("82", "28", "4", "8", "0", "0", "0")
			bcp_sendcommand_new("GAP 3 mm, 0 mm")
			bcp_sendcommand_new("SPEED 4")
			bcp_sendcommand_new("DENSITY 7")
			bcp_sendcommand_new("DIRECTION 0,0")
			bcp_sendcommand_new("REFERENCE 0,0")
			bcp_sendcommand_new("OFFSET 0 mm")
			bcp_sendcommand_new("SHIFT 0")
			bcp_sendcommand_new("SET PEEL OFF")
			bcp_sendcommand_new("SET CUTTER ON")
			bcp_sendcommand_new("SET TEAR ON")
			bcp_sendcommand_new("CLS")
			bcp_sendcommand_new("CODEPAGE 850")
			for ll_counter = 1 to ll_totalrows
				if len(trim(id_detail.getitemstring(ll_counter, "fullcode"))) <= li_barcodeleninprint and id_detail.getitemnumber(ll_counter, "qty") > 0.0 then
					ll_qty = id_detail.getitemnumber(ll_counter, "qty")
					ls_itemname = trim(id_detail.getitemstring(ll_counter, "itemname"))
					ls_aliasname = left(trim(id_detail.getitemstring(ll_counter, "fullcode")), li_barcodeleninprint)
					if ib_printprice then
						ls_price = "Rs. " + trim(string(round(id_detail.getitemdecimal(ll_counter, "saleprice"), 2)))
					else
						ls_price = ""
					end if
					bcp_clearbuffer_new()
					ll_tot_label_rows = ceiling(ll_qty / ll_supply_cols_per_row)
					bcp_printerfont_new("633", "207", "0", "180", "10", "10", ls_clientname)
					bcp_printerfont_new("306", "207", "0", "180", "10", "10", ls_clientname)
					bcp_barcode_new("633", "178", "39", "70", "1", "180", "2", "3", ls_aliasname)
					bcp_barcode_new("306", "178", "39", "70", "1", "180", "2", "3", ls_aliasname)
					bcp_printerfont_new("633", "81", "0", "180", "8", "6", left(ls_itemname, 25))
					bcp_printerfont_new("306", "81", "0", "180", "8", "6", left(ls_itemname, 25))
					bcp_printerfont_new("633", "62", "0", "180", "8", "6", mid(ls_itemname, 26, 25))
					bcp_printerfont_new("306", "62", "0", "180", "8", "6", mid(ls_itemname, 26, 25))
					bcp_printerfont_new("633", "45", "0", "180", "12", "12", ls_price)
					bcp_printerfont_new("306", "45", "0", "180", "12", "12", ls_price)
					bcp_printlabel_new("1", trim(string(ll_tot_label_rows)))
				end if
			next
			bcp_closeport_new()
		end if
	end if
	return 0
