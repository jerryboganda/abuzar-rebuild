	if f_stringpreferences("showflatdiscinserviceprdetail") = "N" then
		this.id_detail.object.serviceflatdisc.visible = false
	end if
	if f_stringpreferences("showdiscpercinserviceprdetail") = "N" then
		this.id_detail.object.discperc.visible = false
	end if
	if f_stringpreferences("showremarksinserviceprdetail") = "N" then
		this.id_detail.object.remarks.visible = false
	end if
	if f_stringpreferences("ShowPostedInServicePRList") = "N" then
		this.id_list.object.posted.visible = false
	end if
	if f_stringpreferences("ShowPostedByInServicePRList") = "N" then
		this.id_list.object.postedby.visible = false
	end if
	if f_stringpreferences("ShowModifiedByInServicePRList") = "N" then
		this.id_list.object.modifiedby.visible = false
	end if
	if f_stringpreferences("ShowRef1InServicePRList") = "N" then
		this.id_list.object.ref1.visible = false
	end if
	if f_stringpreferences("ShowRef2InServicePRList") = "N" then
		this.id_list.object.ref2.visible = false
	end if
	if f_stringpreferences("ShowRef3InServicePRList") = "N" then
		this.id_list.object.ref3.visible = false
	end if
	if f_stringpreferences("ShowRef4InServicePRList") = "N" then
		this.id_list.object.ref4.visible = false
	end if
	if f_stringpreferences("ShowRemarksInServicePRList") = "N" then
		this.id_list.object.remarks.visible = false
	end if
	if f_stringpreferences("ShowHeaderNoInServicePRList") = "N" then
		this.id_list.object.headerno.visible = false
	end if
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(1)
	f_setserviceqtystyle(this.id_detail, "qty")
	setredraw(true)

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
	case "flatdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	end choose
	return 1

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_code
	long ll_detailrows
	long ll_custcode
	integer li_result
	string ls_result
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "suppcode"
		ll_code = long(data)
		parent.setredraw(false)
		if parent.parent.parent.wf_supplierinfo(ll_code) <> 0 then
			messagebox("Database Error", "Can not retrieve information from database")
		end if
		parent.setredraw(true)
	case "servicepurinvcode"
		li_result = parent.parent.parent.wf_validate_service_purinvcode(row, long(data))
		return li_result
	end choose
	return li_result

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_saletype
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "servicepurinvcode"
		if isnull(data) or integer(data) = 0 then
			messagebox("Service Purchase Invoice code Validation", "You must select some valid service purchase invoice")
		end if
	end choose
	return 1

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	string ls_columnobject
	long ll_currow
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	ls_columnobject = dwo.name
	ll_currow = rowcount()
	if ll_currow > 0 and (ls_columnobject = "discperc" or ls_columnobject = "price" or ls_columnobject = "qty") and isnull(this.object.icode[ll_currow]) then
		scrolltorow(ll_currow)
		setcolumn("icode")
	end if
	return 0

// dw_detail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.getparent().dynamic postevent("ue_accepttext")
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_null
	long ll_rowfound
	string ls_null
	integer li_rtcode
	string ls_batch
	string ls_itemname
	datetime ld_expiry
	long ll_gcode
	long ll_icode
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case "servicecode"
		if long(data) > 0 then
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = row
		else
			return 1
		end if
	case "fullcode"
		if isnull(data) or data = "" then
			setitem(row, "servicecode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_rtcode = 2
		else
			li_res = parent.parent.parent.wf_find_service_fullcode(data, ll_icode, ls_itemname)
			if li_res > 0 then
				if ll_icode > 0 and parent.parent.parent.id_master.object.serviceinvcode[1] > 0 then
					ll_rowfound = parent.parent.parent.idc_itemdddw.find("servicecode = " + string(ll_icode) + " and (qty - returnqty) > 0", 1, parent.parent.parent.idc_itemdddw.rowcount())
					if ll_rowfound > 0 and ll_rowfound <= parent.parent.parent.idc_itemdddw.rowcount() then
						setitem(row, "servicecode", ll_icode)
						setitem(row, "qty", 1)
						parent.parent.parent.ib_itemvalidated = false
						parent.parent.parent.il_currrow = row
						li_rtcode = 0
					else
						messagebox("Service Code/Alias Name Validation", "Service does not exist in service invoice no.: " + string(parent.parent.parent.id_master.object.serviceinvcode[1]))
						setitem(row, "servicecode", ll_null)
						setitem(row, "fullcode", ls_null)
						li_rtcode = 1
					end if
				else
					messagebox("Service Code/Alias Name Validation", "Service does not exist")
					setitem(row, "servicecode", ll_null)
					setitem(row, "fullcode", ls_null)
					li_rtcode = 1
				end if
			else
				messagebox("Service Code/Alias Name Validation", "Service does not exist")
				setitem(row, "servicecode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_rtcode = 1
			end if
		end if
	case "qty"
		li_rtcode = parent.parent.parent.wf_validateqty(row, double(data))
	end choose
	return li_rtcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ll_icode
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "servicecode" then
		parent.parent.parent.ib_focusdetail = true
	else
		parent.parent.parent.ib_focusdetail = true
	end if
	parent.parent.parent.wf_grandtotal()
	parent.parent.parent.editflag = true
	selecttext(1, len(gettext()))
	parent.parent.parent.id_itemslist.hide()
	return 0

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	long ll_icode
	long ll_foundrow
	dwitemstatus lrs_status
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if parent.parent.parent.id_detail.rowcount() > 0 and lrs_status <> new! then
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "servicecode"
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case parent.parent.parent.is_columnitemname
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case "discperc"
		messagebox("Item Discount Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	case "serviceprice"
		if double(data) <= 0.0 then
			messagebox("Item Price Validation", "Item price ~"" + data + "~" must be greater than zero")
		else
			messagebox("Item Price Validation", "Item price can not be changed")
		end if
	end choose
	setnull(parent.parent.parent.is_validationerrtext)
	return 1

// dw_itemsdetail.getfocus() returns long [event]
	if parent.parent.parent.im_menu.m_file.m_save.enabled = true then
		if not parent.parent.parent.ib_focusdetail then
			parent.parent.parent.ib_focusdetail = true
			if f_stringpreferences("itemcode") = "N" then
			end if
		end if
		if parent.parent.parent.ib_itemslistopen then
			setfocus()
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	if getcolumn() = 1 then
		parent.parent.parent.is_aliasname = data
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	integer li_rowno
	integer i
	integer li_columnno = 1
	li_columnno = integer(this.object.qty.id)
	if getrow() = rowcount() then
		if getcolumn() = li_columnno then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
	elseif li_columnno = integer(this.object.datawindow.column.count) and getcolumn() = li_columnno then
		scrollnextrow()
		if f_stringpreferences("ItemCode") = "Y" then
			setcolumn("fullcode")
		else
			setcolumn("servicecode")
		end if
		setfocus()
		return 1
	end if
	li_rowno = parent.parent.parent.idc_itemdddw.find("fullcode='" + parent.parent.parent.is_aliasname + "'", 1, parent.parent.parent.idc_itemdddw.rowcount())
	if getcolumn() = 1 and li_rowno > 0 and li_rowno <= parent.parent.parent.idc_itemdddw.rowcount() then
		if isnull(parent.parent.parent.is_aliasname) or parent.parent.parent.is_aliasname = "" then
			setcolumn("servicecode")
		else
			setcolumn("qty")
		end if
		setfocus()
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_icode
	long ll_found
	long ll_rowm
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			parent.parent.parent.idc_itemdddw.selectrow(0, false)
			parent.parent.parent.idc_itemdddw.scrollnextrow()
			ll_listcurrrow = parent.parent.parent.idc_itemdddw.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.parent.parent.idc_itemdddw.selectrow(0, false)
			parent.parent.parent.idc_itemdddw.scrollpriorrow()
			ll_listcurrrow = parent.parent.parent.idc_itemdddw.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.parent.parent.idc_itemdddw.selectrow(0, false)
			parent.parent.parent.idc_itemdddw.scrollnextpage()
			ll_listcurrrow = parent.parent.parent.idc_itemdddw.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.parent.parent.idc_itemdddw.selectrow(0, false)
			parent.parent.parent.idc_itemdddw.scrollpriorpage()
			ll_listcurrrow = parent.parent.parent.idc_itemdddw.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.parent.parent.idc_itemdddw.selectrow(0, false)
			parent.parent.parent.idc_itemdddw.scrolltorow(99999)
			ll_listcurrrow = parent.parent.parent.idc_itemdddw.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.parent.parent.idc_itemdddw.selectrow(0, false)
			parent.parent.parent.idc_itemdddw.scrolltorow(1)
			ll_listcurrrow = parent.parent.parent.idc_itemdddw.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			setfocus()
			setredraw(true)
		elseif key = keyf4! then
			parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.idc_itemdddw.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, "servicecode", parent.parent.parent.idc_itemdddw.getitemnumber(ll_listcurrrow, "servicecode"))
			setitem(ll_rowm, "fullcode", parent.parent.parent.idc_itemdddw.getitemstring(ll_listcurrrow, "fullcode"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	elseif key = keydownarrow! then
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_focusfooter")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	end if
	return rt_code
