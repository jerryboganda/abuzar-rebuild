// w_servicepurreturn.wf_refreshitemslist_catwise() returns 0
	long ll_counter
	string ls_categories
	integer[] la_catcode
	s_arguements lstr_arg
	open(w_choose_servicecategory)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = -1 then
		return
	end if
	la_catcode = lstr_arg.ia_integerlist
	ls_categories = ""
	for ll_counter = 1 to upperbound(la_catcode)
		ls_categories = ls_categories + string(la_catcode[ll_counter]) + " , "
	next
	ls_categories = ls_categories + " 0 "
	f_retrieve_servicelist(this.id_itemslist, this.it_transobject)
	this.id_itemslist.setfilter("servicecatcode In (" + ls_categories + ")")
	this.id_itemslist.filter()

// w_servicepurreturn.wf_refreshitemslist_itemname() returns 0
	s_popup_selection lstr_selection
	long ll_counter
	boolean lb_enablerestricted
	string ls_selection
	integer[] la_catcode
	open(w_popup_itemsearchcriteriaselection)
	lstr_selection = message.powerobjectparm
	if lstr_selection.l_code > 0 then
		ls_selection = lstr_selection.s_name2
		this.id_itemslist.reset()
		this.id_itemslist.setfilter("")
		this.id_itemslist.filter()
		f_retrieve_servicelist(this.id_itemslist, this.it_transobject)
		this.id_itemslist.setfilter("itemname LIKE '" + ls_selection + "'")
		this.id_itemslist.filter()
	end if

// w_servicepurreturn.wf_assign_master_cash_win_object() returns 0
	this.ids_cashwin = create u_ds_standard
	this.ids_cashwin.dataobject = "d_mastercashierwindow_detail"
	this.ids_cashwin.settransobject(this.it_transobject)

// w_servicepurreturn.wf_set_cashaccount() returns long
	long ll_cashacccode
	long ll_module
	long ll_code
	ll_module = 44
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = f_is_group_module_cashaccount_allowed(this.il_groupcode, ll_module)
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		ll_cashacccode = 0
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
	elseif isnull(ll_code) or this.id_master.object.code[1] <= 0 then
		this.id_master.object.cashacccode[this.id_master.rowcount()] = ll_cashacccode
	else
		ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	end if
	return ll_cashacccode

// w_servicepurreturn.wf_show_mastercashierwindow() returns long
	long ll_counter
	long ll_code
	long ll_row
	long ll_insrow
	long ll_module
	long ll_cashacccode
	double ld_tot_acc_amt
	s_mastercashwin_all lstr_values
	lstr_values.i_interfacecode = 22
	if f_stringpreferences("AskMasterCashierWin_InServicePR") = "N" then
		return 1
	end if
	ll_module = 44
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
		return 0
	end if
	lstr_values.l_doccode = ll_code
	lstr_values.s_doctype = this.is_doctype
	lstr_values.l_cashacccode = ll_cashacccode
	lstr_values.l_groupcode = this.il_groupcode
	lstr_values.l_module = ll_module
	lstr_values.d_netamt = wf_grandtotal()
	lstr_values.d_cashtendered = this.id_master.object.cashtendered[this.id_master.rowcount()]
	lstr_values.d_cashcharged = this.id_master.object.cashcharged[this.id_master.rowcount()]
	lstr_values.d_cashback = this.id_master.object.cashback[this.id_master.rowcount()]
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		lstr_values.l_acccode[ll_counter] = this.ids_cashwin.object.acccode[ll_counter]
		lstr_values.s_remarks[ll_counter] = this.ids_cashwin.object.remarks[ll_counter]
		lstr_values.d_amount[ll_counter] = this.ids_cashwin.object.amount[ll_counter]
		lstr_values.l_rowid[ll_counter] = this.ids_cashwin.object.rowid[ll_counter]
		ld_tot_acc_amt = ld_tot_acc_amt + this.ids_cashwin.object.amount[ll_counter]
	next
	if lstr_values.d_netamt >= lstr_values.d_cashcharged then
		lstr_values.d_docbalance = lstr_values.d_netamt - lstr_values.d_cashcharged - ld_tot_acc_amt
	else
		lstr_values.d_docbalance = 0
	end if
	for ll_counter = 1 to 100
		if lstr_values.l_rowid[ll_counter] <= 0 then
			lstr_values.l_rowid[ll_counter] = -1
		end if
	next
	openwithparm(w_mastercashierwindow, lstr_values)
	lstr_values = message.powerobjectparm
	if lstr_values.i_status = 1 then
		this.ids_cashwin.reset()
		ld_tot_acc_amt = 0
		for ll_counter = 1 to 100
			if lstr_values.l_acccode[ll_counter] > 0 and lstr_values.d_amount[ll_counter] > 0 and lstr_values.l_rowid[ll_counter] > 0 then
				ll_insrow = this.ids_cashwin.insertrow(0)
				this.ids_cashwin.object.documentcode[ll_insrow] = ll_code
				this.ids_cashwin.object.documenttype[ll_insrow] = this.is_doctype
				this.ids_cashwin.object.acccode[ll_insrow] = lstr_values.l_acccode[ll_counter]
				this.ids_cashwin.object.remarks[ll_insrow] = lstr_values.s_remarks[ll_counter]
				this.ids_cashwin.object.amount[ll_insrow] = lstr_values.d_amount[ll_counter]
				this.ids_cashwin.object.rowid[ll_insrow] = lstr_values.l_rowid[ll_counter]
			end if
		next
		this.id_master.object.cashacccode[this.id_master.rowcount()] = lstr_values.l_cashacccode
		this.id_master.object.cashtendered[this.id_master.rowcount()] = lstr_values.d_cashtendered
		this.id_master.object.cashcharged[this.id_master.rowcount()] = lstr_values.d_cashcharged
		this.id_master.object.cashback[this.id_master.rowcount()] = lstr_values.d_cashback
		return 1
	end if
	return 0

// w_servicepurreturn.wf_update_mastercashierwindow(long al_code, string as_type) returns long
	long ll_counter
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		this.ids_cashwin.object.documentcode[ll_counter] = al_code
		this.ids_cashwin.object.documenttype[ll_counter] = as_type
		this.ids_cashwin.object.date[ll_counter] = this.id_master.object.date[1]
	next
	SQL DELETE DBO.MasterCashWin WHERE DocumentCode =:al_code AND DocumentType =:as_type USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if this.ids_cashwin.update() > 0 then
			return 0
		else
			return -1
		end if
		return
	end if
	return -1

// w_servicepurreturn.wf_validateqty(long al_row, double ad_qty) returns integer
	integer li_rtcode
	long ll_servicecode
	long ll_srvrowid
	double ld_qtyreturned
	double ld_oninvoiceitemretqty
	double ld_qty
	double ld_returnableqty
	double ld_serviceqty
	ll_servicecode = this.id_detail.getitemnumber(al_row, "servicecode")
	ll_srvrowid = this.id_detail.getitemnumber(al_row, "srvrowid")
	ld_serviceqty = this.id_detail.getitemnumber(al_row, "serviceqty")
	wf_oninvoiceitemprevretqty(al_row, ll_servicecode, ll_srvrowid, ld_oninvoiceitemretqty)
	ld_qtyreturned = this.id_detail.getitemnumber(al_row, "retqty")
	ld_qtyreturned = ld_qtyreturned + ld_oninvoiceitemretqty
	ld_returnableqty = ld_serviceqty - ld_qtyreturned
	if ad_qty > ld_returnableqty then
		li_rtcode = 1
		messagebox("Quantity Validation", "   Qty Should be less than or equal to " + string(round(ld_returnableqty, 2)))
	elseif ad_qty > 0.0 then
		if double(long(ad_qty)) <> ad_qty and this.id_detail.object.allowsaleindecimal[al_row] = "N" then
			messagebox("Quantity Validation", "Quantity In decimals is not allowed for this service", stopsign!)
			li_rtcode = 1
		else
			li_rtcode = 0
		end if
	else
		messagebox("Quantity Validation", "Please enter a valid Quantity for this service", stopsign!)
		li_rtcode = 1
	end if
	return li_rtcode

// w_servicepurreturn.wf_oninvoiceitemprevretqty(long al_row, long al_servicecode, long al_srvrowid, double ad_serviceprevqty) returns integer
	long ll_counter
	long ll_rowcount
	long ll_servicecode
	long ll_srvrowid
	double ld_holdqty
	ll_rowcount = this.id_detail.rowcount()
	for ll_counter = 1 to al_row - 1
		ll_servicecode = this.id_detail.getitemnumber(ll_counter, "servicecode")
		ll_srvrowid = this.id_detail.getitemnumber(ll_counter, "srvrowid")
		if ll_servicecode = al_servicecode and ll_srvrowid = al_srvrowid then
			ld_holdqty = ld_holdqty + this.id_detail.getitemnumber(ll_counter, "qty")
		end if
	next
	for ll_counter = al_row + 1 to ll_rowcount
		ll_servicecode = this.id_detail.getitemnumber(ll_counter, "servicecode")
		ll_srvrowid = this.id_detail.getitemnumber(ll_counter, "srvrowid")
		if ll_servicecode = al_servicecode and ll_srvrowid = al_srvrowid then
			ld_holdqty = ld_holdqty + this.id_detail.getitemnumber(ll_counter, "qty")
		end if
	next
	ad_serviceprevqty = ld_holdqty
	return 0

// w_servicepurreturn.wf_supplierinfo(long al_suppcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	string ls_suppname
	string ls_aliasname
	long ll_currow
	SQL SELECT Supplier.address1 , Supplier.city , Supplier.phone , Accounts.Name , Accounts.AliasName INTO :ls_address, :ls_city, :ls_phone, :ls_suppname, :ls_aliasname FROM Supplier , Accounts WHERE Supplier.suppcode =:al_suppcode AND Supplier.SuppCode =Accounts.AccCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
		this.id_master.object.suppcode[ll_currow] = al_suppcode
		this.id_master.object.suppname[this.id_master.getrow()] = ls_suppname
		this.id_master.object.aliasname[this.id_master.getrow()] = ls_aliasname
		this.id_master.object.address1[ll_currow] = ls_address
		this.id_master.object.city[ll_currow] = ls_city
		this.id_master.object.phone[ll_currow] = ls_phone
	end if
	return this.it_transobject.sqlcode

// w_servicepurreturn.wf_find_header_no(long al_servicepurinvcode) returns integer
	integer li_header_no
	SQL SELECT headerno INTO :li_header_no FROM ServicePurHeader WHERE ServicePurInvCode =:al_servicepurinvcode USING this.it_transobject;
	return li_header_no

// w_servicepurreturn.wf_find_service_pur_invoice(long al_servicepurinvcode, datetime ad_date, string as_errtext) returns integer
	integer li_rtcode
	long ll_admissioncode
	long ll_suppcode
	long ll_null
	string ls_posted
	setnull(ll_null)
	SQL SELECT date , posted , suppcode INTO :ad_date, :ls_posted, :ll_suppcode FROM ServicePurHeader WHERE ServicePurinvcode =:al_servicepurinvcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ls_posted) then
			as_errtext = "You must select some valid Service Purchase Invoice"
			li_rtcode = 1
		elseif ls_posted = "Y" then
			this.id_master.object.suppcode[1] = ll_suppcode
			if wf_check_groupsuppliercategory() <> 0 then
				messagebox("Group Wise Supplier Category Validation", "Current user group does not have enough permissions w.r.t supplier.~r~nPossible Reasons are:~r~nSupllier is not allowed to the current user group.")
				this.id_master.object.suppcode[1] = ll_null
				return -1
			end if
			li_rtcode = 0
		else
			li_rtcode = 1
			as_errtext = "Service Purchase invoice " + string(al_servicepurinvcode) + " is unposted~n~rOnly Posted invoices can be returned"
		end if
	else
		li_rtcode = 1
		as_errtext = "Database Error, Some database request fails"
	end if
	return li_rtcode

// w_servicepurreturn.wf_inititeminfo(datawindowchild adc_itemdddw, long al_servicepurinvcode, long al_dsrow, long al_detaildwrow, string as_errtext) returns integer
	long ll_servicecode
	long ll_gcode
	long ll_packunits
	long ll_srvrowid
	double ld_retableqty
	double ld_itemprevqty
	double ld_itemsaleqty
	double ld_stock
	double ld_serviceprice
	double ld_discperc
	double ld_commission
	double ld_costprice
	double ld_flatdisc
	string ls_fullcode
	string ls_batch
	string ls_allowsaleindecimal
	datetime ld_expiry
	integer li_errcode
	ll_servicecode = adc_itemdddw.getitemnumber(al_dsrow, "servicecode")
	ld_serviceprice = adc_itemdddw.getitemnumber(al_dsrow, "price")
	ld_flatdisc = adc_itemdddw.getitemnumber(al_dsrow, "serviceflatdisc")
	ld_discperc = adc_itemdddw.getitemnumber(al_dsrow, "discperc")
	ll_srvrowid = adc_itemdddw.getitemnumber(al_dsrow, "rowid")
	ls_allowsaleindecimal = adc_itemdddw.getitemstring(al_dsrow, "AllowSaleInDecimal")
	if wf_itemprevretqty(al_servicepurinvcode, ll_gcode, ll_servicecode, ld_itemprevqty) = 0 then
		if ld_itemprevqty = 0.0 then
			this.id_detail.setitem(al_detaildwrow, "servicecode", ll_servicecode)
			this.id_detail.setitem(al_detaildwrow, "price", ld_serviceprice)
			this.id_detail.setitem(al_detaildwrow, "serviceflatdisc", ld_flatdisc)
			this.id_detail.setitem(al_detaildwrow, "discperc", ld_discperc)
			this.id_detail.setitem(al_detaildwrow, "srvrowid", ll_srvrowid)
			this.id_detail.setitem(al_detaildwrow, "AllowSaleInDecimal", ls_allowsaleindecimal)
		else
			as_errtext = "Service has already been returned"
			li_errcode = 1
		end if
	else
		li_errcode = -1
		as_errtext = "Service invoice information can not retrieve"
	end if
	return li_errcode

// w_servicepurreturn.wf_itemprevretqty(long al_servicepurinvcode, long al_srvrowid, long al_servicecode, double ad_serviceprevqty) returns integer
	SQL SELECT Sum ( qty ) INTO :ad_serviceprevqty FROM serviceprheader , serviceprdetail WHERE serviceprheader.servicePurinvcode =:al_servicepurinvcode And serviceprheader.posted ='Y' And serviceprheader.serviceprinvcode =serviceprdetail.servicePRInvCode And serviceprdetail.servicecode =:al_servicecode And serviceprdetail.rowid =:al_srvrowid USING this.it_transobject;
	if isnull(ad_serviceprevqty) then
		ad_serviceprevqty = 0
	end if
	return this.it_transobject.sqlcode

// w_servicepurreturn.wf_lock_service_pr_invoices(long al_sinvcode, long al_linvcode) returns integer
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM serviceprheader WITH ( UPDLOCK HOLDLOCK ) WHERE serviceprheader.serviceprinvcode Between :al_sinvcode and :al_linvcode USING sqlca;
	return sqlca.sqlcode

// w_servicepurreturn.wf_lock_servicepur_invoice(long al_servicepurinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From servicepurheader WITH ( UPDLOCK HOLDLOCK ) Where servicepurheader.servicepurinvcode =:al_servicepurinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_servicepurreturn.wf_setfooterinfo(long al_servicepurinvcode) returns 0
	double ld_discperc
	double ld_flatdisc
	double ld_misccharges
	SQL SELECT servicepurheader.discperc , servicepurheader.flatdisc , servicepurheader.misccharges INTO :ld_discperc, :ld_flatdisc, :ld_misccharges FROM servicepurheader WHERE servicepurheader.servicepurinvcode =:al_servicepurinvcode USING sqlca;
	this.id_footer.setitem(1, "discperc", ld_discperc)
	this.id_footer.setitem(1, "flatdisc", ld_flatdisc)
	this.id_footer.setitem(1, "misccharges", ld_misccharges)

// w_servicepurreturn.wf_set_servicepur_info(long al_servicepurinvcode, long al_suppcode) returns 0
	long ll_row
	long ll_headerno
	datetime ld_date
	string ls_ref1
	string ls_ref2
	string ls_ref3
	string ls_ref4
	string ls_remarks
	SQL SELECT Suppcode , date , headerno , ref1 , ref2 , ref3 , ref4 , remarks INTO :al_suppcode, :ld_date, :ll_headerno, :ls_ref1, :ls_ref2, :ls_ref3, :ls_ref4, :ls_remarks FROM servicepurheader WHERE servicepurheader.servicepurinvcode =:al_servicepurinvcode USING this.it_transobject;
	ll_row = this.id_master.getrow()
	this.id_master.object.servicepurdate[1] = ld_date
	this.id_master.object.headerno[1] = ll_headerno
	this.id_master.object.ref1[1] = ls_ref1
	this.id_master.object.ref2[1] = ls_ref2
	this.id_master.object.ref3[1] = ls_ref3
	this.id_master.object.ref4[1] = ls_ref4
	this.id_master.object.remarks[1] = ls_remarks

// w_servicepurreturn.wf_validate_service_purinvcode(long al_row, long al_servicepurinvcode) returns integer
	long ll_detailrows
	long ll_suppcode
	integer li_rtcode
	integer li_result
	integer li_header_no
	datetime ld_datetime
	boolean lb_rtflag
	string ls_errtext
	string ls_batch
	dwitemstatus lrs_status
	if not isnull(al_servicepurinvcode) and al_servicepurinvcode > 0 then
		this.im_menu.m_file.m_options.enabled = true
		ll_detailrows = this.id_detail.rowcount()
		if ll_detailrows > 0 then
			lrs_status = this.id_detail.getitemstatus(1, 0, primary!)
			if lrs_status <> new! and not isnull(this.id_detail.getitemnumber(1, "servicecode")) then
				li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
				if li_result = 2 then
					li_rtcode = 2
				else
					this.id_detail.setredraw(false)
					this.id_detail.reset()
					this.id_detail.insertrow(0)
					this.id_detail.setfocus()
					this.id_detail.setredraw(true)
				end if
			end if
		end if
		if li_rtcode = 0 then
			li_rtcode = wf_find_service_pur_invoice(al_servicepurinvcode, ld_datetime, ls_errtext)
			if li_rtcode = 0 then
				li_rtcode = wf_findunpostedreturns(al_servicepurinvcode, ls_errtext)
				if li_rtcode = 0 then
					li_rtcode = wf_lock_servicepur_invoice(al_servicepurinvcode)
					if li_rtcode = 0 then
						this.id_detail.setredraw(false)
						wf_set_servicepur_info(al_servicepurinvcode, ll_suppcode)
						wf_supplierinfo(ll_suppcode)
						this.id_master.setitem(1, "servicepurdate", ld_datetime)
						this.idc_itemdddw.retrieve(al_servicepurinvcode)
						this.id_detail.setredraw(true)
					else
						li_rtcode = 1
					end if
				else
					li_rtcode = 1
				end if
			else
				li_rtcode = 1
			end if
		end if
	else
		li_rtcode = 1
	end if
	if li_rtcode = 1 then
		messagebox("Service Invoice validation", ls_errtext)
	end if
	return li_rtcode

// w_servicepurreturn.wf_apply_groupsuppliercategory() returns long
	long ll_counter
	integer li_rtncode
	string ls_filterstring
	datastore lds_groupsuppcategory
	if f_stringpreferences("GroupSuppCatInPurAndPRSvc") = "Y" then
		lds_groupsuppcategory = create datastore
		lds_groupsuppcategory.dataobject = "d_groupsuppcategory_detail"
		lds_groupsuppcategory.settransobject(this.it_transobject)
		this.il_groupcode = f_getgroupcode(gl_usercode)
		lds_groupsuppcategory.retrieve(this.il_groupcode)
		ls_filterstring = ""
		for ll_counter = 1 to lds_groupsuppcategory.rowcount()
			ls_filterstring = ls_filterstring + trim(string(lds_groupsuppcategory.object.suppcatcode[ll_counter])) + ","
		next
		if right(ls_filterstring, 1) = "," then
			ls_filterstring = left(ls_filterstring, len(ls_filterstring) - 1)
		end if
		if ls_filterstring = "" then
			ls_filterstring = "-1"
		end if
		this.idc_supplierlist.setfilter("suppcatcode In (" + ls_filterstring + ") ")
		this.idc_supplierlist.filter()
	end if
	return 0

// w_servicepurreturn.wf_check_groupsuppliercategory() returns long
	long ll_acccode
	long ll_found
	long ll_code
	long ll_counter
	long ll_rowcount
	long ll_groupcode
	long ll_suppcatcode
	boolean lb_groupcustcat
	if f_stringpreferences("GroupSuppCatInPurAndPRSvc") = "N" then
		return 0
	end if
	ll_groupcode = f_getgroupcode(gl_usercode)
	ll_rowcount = this.id_detail.rowcount()
	ll_acccode = this.id_master.getitemnumber(1, "suppcode")
	SQL Select MAX ( SuppCode ) , MAX ( SuppCatCode ) INTO :ll_found, :ll_suppcatcode From dbo.supplier Where suppcode =:ll_acccode USING this.it_transobject;
	if ll_found > 0 and ll_suppcatcode > 0 and this.it_transobject.sqlcode = 0 then
		ll_found = 0
		SQL SELECT count ( suppcatcode ) INTO :ll_found FROM GroupSupplierCategory WHERE SuppCatCode =:ll_suppcatcode AND GroupCode =:ll_groupcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 and ll_found < 1 then
			return -1
		end if
		return
	end if
	return 0

// w_servicepurreturn.wf_findunpostedreturns(long al_servicepurinvcode, string as_errtext) returns integer
	integer li_rtcode
	long ll_count
	long ll_suppcode
	long ll_null
	setnull(ll_null)
	SQL SELECT count ( *) , MAX ( SuppCode ) INTO :ll_count, :ll_suppcode FROM serviceprheader WHERE servicepurinvcode =:al_servicepurinvcode AND posted ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_count > 0 then
			li_rtcode = 1
			as_errtext = "Some Unposted Service Purchase Return invoice already exist,~n~rModify that invoice"
		else
			this.id_master.object.suppcode[1] = ll_suppcode
			if wf_check_groupsuppliercategory() <> 0 then
				messagebox("Group Wise Supplier Category Validation", "Current user group does not have enough permissions w.r.t supplier.~r~nPossible Reasons are:~r~nSupllier is not allowed to the current user group.")
				this.id_master.object.suppcode[1] = ll_null
				return -1
			end if
		end if
	else
		li_rtcode = 1
		as_errtext = "Database Error, Some database request fails"
	end if
	return li_rtcode

// w_servicepurreturn.wf_set_headersetting() returns long
	integer li_rtncode
	long ll_counter
	long ll_found
	datastore lds_headers
	datawindowchild ldc_headerno
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		return li_rtncode
	end if
	if lds_headers.rowcount() > 0 then
		this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
		this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
		this.id_master.getchild("headerno", ldc_headerno)
		for ll_counter = 1 to lds_headers.rowcount()
			ldc_headerno.insertrow(0)
			ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
			ll_found = 0
			ll_found = gds_reoprtheaderinfo.find("headerno=" + string(lds_headers.getitemnumber(ll_counter, "headercode")), 1, gds_reoprtheaderinfo.rowcount())
			if ll_found > 0 then
				ldc_headerno.setitem(ll_counter, "name", gds_reoprtheaderinfo.getitemstring(ll_found, "clientname"))
				if isnull(gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks")) then
					ldc_headerno.setitem(ll_counter, "headeralias", trim(string(gds_reoprtheaderinfo.getitemnumber(ll_found, "headerno"))))
				else
					ldc_headerno.setitem(ll_counter, "headeralias", trim(gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks")) + " (" + trim(string(gds_reoprtheaderinfo.getitemnumber(ll_found, "headerno"))) + ")")
				end if
			end if
		next
	end if
	return 1

// w_servicepurreturn.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_servicepreturnmenu" then
		this.menuid = create m_servicepreturnmenu
	end if
	this.dw_print = create dw_print
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print

// w_servicepurreturn.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_print

// w_servicepurreturn.ue_save() returns 0 [event]
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_salesmancode = 1
	long ll_rowcount
	long ll_servicecode
	long ll_gcode
	long ll_qty
	long ll_stock
	long ll_newstock
	long ll_counter = 1
	long ll_saveresult
	long ll_null
	long ll_headerno
	long ll_headerinvno
	boolean lb_commitflag = true
	boolean lb_continue = true
	integer li_errcode
	integer li_pos
	datetime ld_expiry
	string ls_errtext
	string ls_batch
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_avgprice
	datetime ldt_server_datetime
	string ls_date_errtext
	setnull(ll_null)
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	wf_grandtotal()
	if wf_check_groupsuppliercategory() <> 0 then
		messagebox("Group Wise Supplier Category Validation", "Current user group does not have enough permissions w.r.t supplier.~r~nPossible Reasons are:~r~nSupllier is not allowed to the current user group.")
		this.id_master.setcolumn("suppcode")
		this.id_master.setfocus()
		return
	end if
	if this.id_detail.rowcount() <= 0 then
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if wf_set_cashaccount() = 0 then
		return
	end if
	if f_stringpreferences("ServiceSalesManWindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	wf_grandtotal()
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	if ll_salesmancode > 0 then
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_rowcount = this.id_detail.rowcount()
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if wf_show_mastercashierwindow() = 0 then
			return
		end if
		if isnull(ll_invid) then
			wf_tabnewid("ServicePRHeader", ll_invid)
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
				this.id_master.setitem(ll_mastercurrrow, "usercode", ll_salesmancode)
			end if
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
		else
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		end if
		if f_stringpreferences("ShowHeaderNoInServicePR") = "N" then
			this.id_master.setitem(ll_mastercurrrow, "Headerno", f_numberpreferences("headerno"))
		end if
		ll_headerno = this.id_master.getitemnumber(ll_mastercurrrow, "headerno")
		ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
		if isnull(ll_headerinvno) then
			f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
			if ll_headerinvno > 0 then
				this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
			end if
		end if
		ld_misccharges = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges")
		ld_invdiscperc = this.id_footer.getitemnumber(ll_footercurrrow, "discperc")
		ld_flatdisc = this.id_footer.getitemnumber(ll_footercurrrow, "flatdisc")
		this.id_master.setitem(ll_mastercurrrow, "discperc", ld_invdiscperc)
		this.id_master.setitem(ll_mastercurrrow, "flatdisc", ld_flatdisc)
		this.id_master.setitem(ll_mastercurrrow, "misccharges", ld_misccharges)
		this.id_master.setitem(ll_mastercurrrow, "postedby", ll_salesmancode)
		this.id_master.setitem(ll_mastercurrrow, "invtotal", wf_grandtotal())
		if f_stringpreferences("AskMasterCashierWin_InServicePR") = "N" then
			this.id_master.object.cashtendered[ll_mastercurrrow] = 0
			this.id_master.object.cashcharged[ll_mastercurrrow] = 0
			this.id_master.object.cashback[ll_mastercurrrow] = 0
			this.id_master.object.outstandingamt[ll_mastercurrrow] = this.id_master.object.invtotal[ll_mastercurrrow]
			this.id_master.accepttext()
		elseif this.id_master.object.invtotal[ll_mastercurrrow] - this.id_master.object.cashcharged[ll_mastercurrrow] >= 0 then
			this.id_master.object.outstandingamt[ll_mastercurrrow] = this.id_master.object.invtotal[ll_mastercurrrow] - this.id_master.object.cashcharged[ll_mastercurrrow]
		else
			this.id_master.object.outstandingamt[ll_mastercurrrow] = 0.00
		end if
		do while ll_counter <= ll_rowcount and li_errcode = 0
			this.id_detail.setitem(ll_counter, "code", ll_invid)
			ll_servicecode = this.id_detail.getitemnumber(ll_counter, "servicecode")
			ll_counter = ll_counter + 1
		loop
		if lb_continue then
			ll_saveresult = event ue_save_withnocommit()
			if ll_saveresult = 0 then
				if wf_update_mastercashierwindow(ll_invid, this.is_doctype) = 0 then
					SQL commit USING this.it_transobject;
					messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
					this.ib_commitok = true
					this.id_master.resetupdate()
					this.im_menu.m_file.m_new.enabled = true
					this.editflag = false
					if gd_recenttransdate < this.id_systemdate then
						gd_recenttransdate = this.id_systemdate
					end if
				else
					messagebox("Saving Problem", "Changes Not Saved in database for Master Cashier Window transactions.", stopsign!, ok!, 1)
				end if
			else
				messagebox("Saving Problem", "Changes Not Saved in database while saving service record.", stopsign!, ok!, 1)
			end if
			if this.ib_commitok then
				this.ib_modify = false
			else
				lb_continue = false
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			messagebox("Updation Error", ls_errtext + " in current row", stopsign!)
			if this.ib_modify = false then
				this.id_master.setitem(1, "Code", ll_null)
				this.id_master.accepttext()
			end if
		elseif f_stringpreferences("includservicepr_inactivitymonitor") = "Y" then
			this.it_transobject.updateactivitymonitor(this.is_doctype, ll_invid)
			if this.it_transobject.sqlcode <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
			else
				SQL commit USING this.it_transobject;
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_servicepurreturn.ue_newform() returns 0 [event]
	integer rtncode
	long li_fetched_code
	long row
	long ll_manfcode
	call super::ue_newform
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_print.enabled = true
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	wf_assign_master_cash_win_object()
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.ib_modify = false
	this.idc_itemdddw.reset()
	this.idc_itemdddw.insertrow(0)
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	setredraw(true)
	if not wf_validatedate() then
		close(this)
	end if

// w_servicepurreturn.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect = 1
	long ll_row
	long ll_code
	long ll_found
	boolean lb_flag
	boolean lb_modify
	call super::ue_detail
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_print.enabled = true
	ll_code = this.id_master.getitemnumber(1, "code")
	if wf_check_groupsuppliercategory() <> 0 then
		messagebox("Group Wise Supplier Category Validation", "Current user group does not have enough permissions w.r.t supplier.~r~nPossible Reasons are:~r~nSupllier is not allowed to the current user group.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	this.id_footer.retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	if this.id_master.object.code[this.id_master.rowcount()] > 0 and this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		li_protect = 0
		wf_initmodify(li_protect)
	end if
	this.idc_itemdddw.settransobject(this.it_transobject)
	li_rtncode = this.idc_itemdddw.retrieve(this.id_master.getitemnumber(1, "servicepurinvcode"))
	if this.id_master.object.code[this.id_master.rowcount()] > 0 then
		this.ids_cashwin.retrieve(this.id_master.object.code[1], this.is_doctype)
	else
		wf_assign_master_cash_win_object()
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	wf_grandtotal()
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "Y" then
		this.editflag = false
	end if
	setredraw(true)

// w_servicepurreturn.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.settransobject(this.it_transobject)
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.setcolumn(this.is_columnitemname)
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		if f_stringpreferences("itemcode") = "N" then
			this.id_detail.setcolumn(this.is_columnitemname)
			this.ib_focusdetail = true
		else
			this.id_detail.setcolumn("fullcode")
			this.ib_focusdetail = true
		end if
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true
	this.id_itemslist.hide()

// w_servicepurreturn.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	return ::message.returnvalue

// w_servicepurreturn.ue_print() returns 0 [event]
	long ll_custcode
	long ll_row
	long ll_invcode
	integer li_option
	string ls_custname
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	wf_selectprintreport()
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_servicepurreturn.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	setpointer(hourglass!)
	setpointer(arrow!)

// w_servicepurreturn.ue_list() returns 0 [event]
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_post.enabled = true
	this.im_menu.m_file.m_print.enabled = true

