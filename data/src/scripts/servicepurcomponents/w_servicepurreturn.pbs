		this.id_master.object.ref4.visible = false
		this.id_master.object.ref4_t.visible = false
	end if
	if f_stringpreferences("showheadernoinservicepr") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.headerno_t.visible = false
	end if
	if f_stringpreferences("showremarksinservicepr") = "N" then
		this.id_master.object.remarks.visible = false
		this.id_master.object.remarks_t.visible = false
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
