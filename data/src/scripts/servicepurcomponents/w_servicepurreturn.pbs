// window w_servicepurreturn (servicepurcomponents)  ancestor: w_multi_entry

// w_servicepurreturn.ue_accepttext() returns 0 [event]
	if this.id_detail.accepttext() = -1 then
		this.id_detail.setfocus()
	end if

// w_servicepurreturn.ue_save_withnocommit() returns long [event]
	setpointer(hourglass!)
	if f_validatedw(this.id_master) < 0 then
		return -1
	end if
	if f_validatedw(this.id_detail) < 0 then
		return -2
	end if
	if this.id_master.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -3
	end if
	if this.id_detail.update() < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -4
	end if
	setpointer(arrow!)
	return 0

