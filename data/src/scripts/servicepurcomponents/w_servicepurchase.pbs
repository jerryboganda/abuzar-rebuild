// w_servicepurchase.wf_post_service_custwise(integer ai_postingmode, long al_startinginvcode, long al_endinginvcode) returns long
	integer li_errcode
	long ll_salesmancode
	long ll_invcount
	long ll_counter
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	if ai_postingmode = 1 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if ai_postingmode = 1 then
			open(w_arg_supp_sinv_linv)
			lstr_arginfo = message.powerobjectparm
		else
			lstr_arginfo.l_code1 = al_startinginvcode
			lstr_arginfo.l_code2 = al_endinginvcode
			lstr_arginfo.l_code3 = this.id_master.getitemnumber(1, "suppcode")
			lstr_arginfo.l_code4 = 1
			lstr_arginfo.i_status = 1
		end if
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			li_errcode = wf_lockserviceinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2, lstr_arginfo.l_code3, ll_invcount)
			if li_errcode = 0 then
				this.it_transobject.postpurofservice_suppwise(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode, lstr_arginfo.l_code3, lstr_arginfo.l_code4)
				if this.it_transobject.sqlcode <> 0 then
					li_errcode = this.it_transobject.sqlcode
					ls_msgtext = this.it_transobject.sqlerrtext
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				ls_msgtext = this.it_transobject.sqlerrtext
				li_errcode = this.it_transobject.sqlcode
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode))
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_invcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return li_errcode

// w_servicepurchase.wf_lockserviceinvoices(long al_sinvcode, long al_linvcode, long al_suppcode, long al_totalinvoice) returns integer
	integer li_count
	if al_suppcode = 0 or isnull(al_suppcode) then
		SQL Select count ( *) INTO :al_totalinvoice From ServicePurHeader WITH ( UPDLOCK HOLDLOCK ) Where ServicePurinvcode Between :al_sinvcode AND :al_linvcode AND Posted ='N' USING this.it_transobject;
	else
		SQL Select count ( *) INTO :al_totalinvoice From ServicePurHeader WITH ( UPDLOCK HOLDLOCK ) Where SuppCode =:al_suppcode AND ServicePurinvcode Between :al_sinvcode AND :al_linvcode AND Posted ='N' USING this.it_transobject;
	end if
	return this.it_transobject.sqlcode

// w_servicepurchase.wf_returnthisinvoice(long al_invid, string as_errtext) returns boolean
	boolean lb_commitflag
	if lb_commitflag then
		if wf_deleteserviceinvoice(al_invid) <> 0 then
			lb_commitflag = false
			as_errtext = "    Some database problem occur"
		end if
	else
		as_errtext = "    Some database problem occur"
	end if
	return lb_commitflag

// w_servicepurchase.wf_apply_groupsuppliercategory() returns long
	long ll_counter
	long ll_rows
	integer li_rtncode
	string ls_filterstring
	datastore lds_groupsuppcategory
	if f_stringpreferences("GroupSuppCatInPurAndPRSvc") = "Y" then
		lds_groupsuppcategory = create datastore
		lds_groupsuppcategory.dataobject = "d_groupsuppcategory_detail"
		lds_groupsuppcategory.settransobject(this.it_transobject)
		this.il_groupcode = f_getgroupcode(gl_usercode)
		ll_rows = lds_groupsuppcategory.retrieve(this.il_groupcode)
		ls_filterstring = ""
		for ll_counter = 1 to lds_groupsuppcategory.rowcount()
			ls_filterstring = ls_filterstring + trim(string(lds_groupsuppcategory.object.suppcatcode[ll_counter])) + ","
		next
		if right(ls_filterstring, 1) = "," then
			ls_filterstring = left(ls_filterstring, len(ls_filterstring) - 1)
		end if
		if ls_filterstring = "" then
			ls_filterstring = "-1"
		end if
		this.idc_supplierlist.setfilter("suppcatcode In (" + ls_filterstring + ") ")
		this.idc_supplierlist.filter()
	end if
	return 0

// w_servicepurchase.wf_check_groupsuppliercategory() returns long
	long ll_acccode
	long ll_found
	long ll_code
	long ll_counter
	long ll_rowcount
	long ll_groupcode
	long ll_suppcatcode
	boolean lb_groupcustcat
	if f_stringpreferences("GroupSuppCatInPurAndPRSvc") = "N" then
		return 0
	end if
	ll_groupcode = f_getgroupcode(gl_usercode)
	ll_rowcount = this.id_detail.rowcount()
	ll_acccode = this.id_master.getitemnumber(1, "suppcode")
	SQL Select MAX ( SuppCode ) , MAX ( SuppCatCode ) INTO :ll_found, :ll_suppcatcode From dbo.supplier Where suppcode =:ll_acccode USING this.it_transobject;
	if ll_found > 0 and ll_suppcatcode > 0 and this.it_transobject.sqlcode = 0 then
		ll_found = 0
		SQL SELECT count ( suppcatcode ) INTO :ll_found FROM GroupSupplierCategory WHERE SuppCatCode =:ll_suppcatcode AND GroupCode =:ll_groupcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 and ll_found < 1 then
			return -1
		end if
		return
	end if
	return 0

// w_servicepurchase.wf_set_headersetting() returns long
	integer li_rtncode
	long ll_counter
	long ll_found
	datastore lds_headers
	datawindowchild ldc_headerno
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		return li_rtncode
	end if
	if lds_headers.rowcount() > 0 then
		this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
		this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
		this.id_master.getchild("headerno", ldc_headerno)
		for ll_counter = 1 to lds_headers.rowcount()
			ldc_headerno.insertrow(0)
			ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
			ll_found = 0
			ll_found = gds_reoprtheaderinfo.find("headerno=" + string(lds_headers.getitemnumber(ll_counter, "headercode")), 1, gds_reoprtheaderinfo.rowcount())
			if ll_found > 0 then
				ldc_headerno.setitem(ll_counter, "name", gds_reoprtheaderinfo.getitemstring(ll_found, "clientname"))
				if isnull(gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks")) then
					ldc_headerno.setitem(ll_counter, "headeralias", trim(string(gds_reoprtheaderinfo.getitemnumber(ll_found, "headerno"))))
				else
					ldc_headerno.setitem(ll_counter, "headeralias", trim(gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks")) + " (" + trim(string(gds_reoprtheaderinfo.getitemnumber(ll_found, "headerno"))) + ")")
				end if
			end if
		next
	end if
	return 1

// w_servicepurchase.create() returns 0 [event]
	integer icurrent
	call super::create
	this.dw_saleinvrep = create dw_saleinvrep
	this.dw_saleinvdetail = create dw_saleinvdetail
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.dw_saleinvdetail

// w_servicepurchase.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.dw_saleinvdetail

// w_servicepurchase.ue_save() returns 0 [event]
	long ll_suppcode
	long ll_detailrows
	long ll_saveresult
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_icode
	long ll_errrowid
	long ll_usercode
	long ll_headerno
	long ll_headerinvno
	long ll_counter
	long ll_count
	long ll_statusrow
	long ll_null
	boolean lb_commitflag
	boolean lb_continue
	integer li_counter
	integer li_tokenno
	string ls_errtext
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_cashreceived
	datetime ldt_server_datetime
	string ls_date_errtext
	setnull(ll_null)
	this.ib_commitok = false
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	wf_grandtotal()
	if wf_check_groupsuppliercategory() <> 0 then
		messagebox("Group Wise Supplier Category Validation", "Current user group does not have enough permissions w.r.t supplier.~r~nPossible Reasons are:~r~nSupllier is not allowed to the current user group.")
		this.id_master.setcolumn("suppcode")
		this.id_master.setfocus()
		return
	end if
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if wf_set_cashaccount() = 0 then
		return
	end if
	if f_stringpreferences("ServiceSalesManWindow") = "Y" then
		open(w_salesmanpassword)
		ll_usercode = long(message.doubleparm)
		setfocus()
	else
		ll_usercode = gl_usercode
	end if
	wf_grandtotal()
	if ll_usercode > 0 then
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		if wf_show_mastercashierwindow() = 0 then
			return
		end if
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if isnull(ll_invid) then
			wf_tabnewid("ServicePurHeader", ll_invid)
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
		end if
		if f_stringpreferences("showheadernoinservicepur") = "N" then
			this.id_master.setitem(ll_mastercurrrow, "Headerno", f_numberpreferences("headerno"))
		end if
		ll_headerno = this.id_master.getitemnumber(ll_mastercurrrow, "headerno")
		ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
		if isnull(ll_headerinvno) then
			f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
			if ll_headerinvno > 0 then
				this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
			end if
		end if
		ld_misccharges = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges")
		ld_invdiscperc = this.id_footer.getitemnumber(ll_footercurrrow, "invdiscperc")
		ld_flatdisc = this.id_footer.getitemnumber(ll_footercurrrow, "flatdisc")
		ll_suppcode = this.id_master.getitemnumber(ll_mastercurrrow, "suppcode")
		this.id_master.setitem(ll_mastercurrrow, "discperc", ld_invdiscperc)
		this.id_master.setitem(ll_mastercurrrow, "flatdisc", ld_flatdisc)
		this.id_master.setitem(ll_mastercurrrow, "misccharges", ld_misccharges)
		this.id_master.setitem(ll_mastercurrrow, "invtotal", wf_grandtotal())
		if f_stringpreferences("askmastercashierwin_inservicepur") = "N" then
			this.id_master.object.cashtendered[ll_mastercurrrow] = 0
			this.id_master.object.cashcharged[ll_mastercurrrow] = 0
			this.id_master.object.cashback[ll_mastercurrrow] = 0
			this.id_master.object.outstandingamt[ll_mastercurrrow] = this.id_master.object.invtotal[ll_mastercurrrow]
			this.id_master.accepttext()
		elseif this.id_master.object.invtotal[ll_mastercurrrow] - this.id_master.object.cashcharged[ll_mastercurrrow] >= 0 then
			this.id_master.object.outstandingamt[ll_mastercurrrow] = this.id_master.object.invtotal[ll_mastercurrrow] - this.id_master.object.cashcharged[ll_mastercurrrow]
		else
			this.id_master.object.outstandingamt[ll_mastercurrrow] = 0.00
		end if
		if this.ib_modify then
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_usercode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			lb_continue = wf_returnthisinvoice(ll_invid, ls_errtext)
		else
			this.id_master.setitem(ll_mastercurrrow, "usercode", ll_usercode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "PostDate", ldt_server_datetime)
		end if
		if lb_continue then
			this.id_saleinvdetail.reset()
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_saleinvdetail.insertrow(0)
				this.id_saleinvdetail.setitem(ll_counter, "Code", ll_invid)
				this.id_saleinvdetail.setitem(ll_counter, "icode", this.id_detail.getitemnumber(ll_counter, "icode"))
				this.id_saleinvdetail.setitem(ll_counter, "fullcode", this.id_detail.getitemstring(ll_counter, "fullcode"))
				this.id_saleinvdetail.setitem(ll_counter, "itemname", this.id_detail.getitemstring(ll_counter, "itemname"))
				this.id_saleinvdetail.setitem(ll_counter, "qty", this.id_detail.getitemnumber(ll_counter, "qty"))
				this.id_saleinvdetail.setitem(ll_counter, "price", this.id_detail.getitemnumber(ll_counter, "price"))
				this.id_saleinvdetail.setitem(ll_counter, "serviceflatdisc", this.id_detail.getitemnumber(ll_counter, "serviceflatdisc"))
				this.id_saleinvdetail.setitem(ll_counter, "discperc", this.id_detail.getitemnumber(ll_counter, "discperc"))
				this.id_saleinvdetail.setitem(ll_counter, "allowsaleindecimal", this.id_detail.getitemstring(ll_counter, "allowsaleindecimal"))
				this.id_saleinvdetail.setitem(ll_counter, "remarks", this.id_detail.getitemstring(ll_counter, "remarks"))
			next
			this.id_detail = this.id_saleinvdetail
			ll_saveresult = event ue_save_withnocommit()
			if ll_saveresult = 0 then
				if wf_update_mastercashierwindow(ll_invid, this.is_doctype) = 0 then
					SQL commit USING this.it_transobject;
					messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
					this.ib_commitok = true
					this.il_codevalue = ll_invid
					this.id_master.resetupdate()
					this.im_menu.m_file.m_new.enabled = true
					this.editflag = false
					if gd_recenttransdate < this.id_systemdate then
						gd_recenttransdate = this.id_systemdate
					end if
				else
					messagebox("Saving Problem", "Changes Not Saved in database for Master Cashier Window transactions.", stopsign!, ok!, 1)
				end if
			else
				messagebox("Saving Problem", "Changes Not Saved in database while saving service record.", stopsign!, ok!, 1)
			end if
			this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
			this.id_saleinvdetail.reset()
			if this.ib_commitok then
				this.ib_modify = false
			else
				lb_continue = false
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			messagebox("Updation Error", ls_errtext + " in current row", stopsign!)
			if this.ib_modify = false then
				this.id_master.setitem(1, "Code", ll_null)
				this.id_master.accepttext()
			end if
		elseif f_stringpreferences("includservicepur_inactivitymonitor") = "Y" then
			this.it_transobject.updateactivitymonitor(this.is_doctype, ll_invid)
			if this.it_transobject.sqlcode <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
			else
				SQL commit USING this.it_transobject;
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_servicepurchase.ue_newform() returns 0 [event]
	integer rtncode
	integer li_rtncode
	long li_fetched_code
	long row
	long ll_manfcode
	datetime ldt_server_datetime
	string ls_date_errtext
	call super::ue_newform
	wf_update_virtualgl()
	setredraw(false)
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.im_menu.m_file.m_print.enabled = true
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.ib_modify = false
	if this.ib_modifydate then
		wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
		this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
	end if
	wf_assign_master_cash_win_object()
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	wf_visible(true)
	setredraw(true)

// w_servicepurchase.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect
	long ll_row
	long ll_code
	long ll_found
	boolean lb_flag
	boolean lb_modify
	call super::ue_detail
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_print.enabled = true
	if this.id_master.object.code[this.id_master.rowcount()] > 0 and wf_check_groupsuppliercategory() <> 0 then
		this.editflag = false
		messagebox("Group Wise Supplier Category Validation", "Current user group does not have enough permissions w.r.t supplier.~r~nPossible Reasons are:~r~nSupllier is not allowed to the current user group.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if this.id_master.object.code[this.id_master.rowcount()] > 0 and this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 5074", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			li_protect = 0
			wf_initmodify(li_protect)
		else
			this.id_detail.reset()
			messagebox("Purchase of Service Modification", "Not Enough rights for Purchase of service invoice modification~r~nPlease contact your system administrator to do the needfull", stopsign!)
			this.tab_retrieve.selecttab(2)
			return
		end if
		return
	end if
	if this.id_master.object.code[this.id_master.rowcount()] > 0 then
		this.ids_cashwin.retrieve(this.id_master.object.code[1], this.is_doctype)
	else
		wf_assign_master_cash_win_object()
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	wf_grandtotal()
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "Y" then
		this.editflag = false
	end if
	this.id_itemslist.hide()
	this.ib_itemslistopen = false
	setredraw(true)

// w_servicepurchase.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		if f_stringpreferences("itemcode") = "N" then
			this.id_detail.setcolumn("itemname")
			this.ib_focusdetail = true
			this.id_itemslist.show()
		else
			this.id_detail.setcolumn("fullcode")
			this.ib_focusdetail = true
			this.id_itemslist.hide()
		end if
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_servicepurchase.ue_deleteitem() returns 0 [event]
	long ll_row
	long ll_footerrow
	call super::ue_deleteitem
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() > 0 then
		this.id_footer.setitem(ll_footerrow, "icode", this.id_detail.getitemnumber(ll_row, "icode"))
		return
	end if
	this.id_footer.setitem(ll_footerrow, "icode", 0)
	this.im_menu.m_file.m_save.enabled = false

// w_servicepurchase.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	return ::message.returnvalue

// w_servicepurchase.ue_list() returns 0 [event]
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_post.enabled = true
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	wf_retrievelist()
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_print.visible = true

// w_servicepurchase.ue_print() returns 0 [event]
	long ll_row
	long ll_invcode
	integer li_option
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	wf_selectprintreport()
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_servicepurchase.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	f_retrieve_servicelist(this.id_itemslist, this.it_transobject)
	setpointer(hourglass!)
	wf_update_virtualgl()
	this.idc_supplierlist.setredraw(false)
	this.idc_supplierlist.settransobject(this.it_transobject)
	this.idc_supplierlist.retrieve()
	this.idc_supplierlist.setredraw(true)
	wf_apply_groupsuppliercategory()
	setpointer(arrow!)

// w_servicepurchase.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_servicepurchase.ue_postopen() returns 0 [event]
	datawindowchild ldc_headerno
	m_multi_entry lm_menu
	integer li_rtncode
	long ll_counter
	long ll_pos
	long ll_found
	long li_count
	long ll_startrow
	char lc_char
	call super::ue_postopen
	lm_menu = this.menuid
	setredraw(false)
	wf_update_virtualgl()
	wf_assign_master_cash_win_object()
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.id_print = this.dw_saleinvrep
	this.id_saleinvdetail = this.dw_saleinvdetail
	this.id_saleinvdetail.settransobject(this.it_transobject)
	li_rtncode = this.id_master.getchild("suppcode", this.idc_supplierlist)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_supplierlist.settransobject(this.it_transobject)
	this.idc_supplierlist.retrieve()
	wf_apply_groupsuppliercategory()
	li_rtncode = wf_set_headersetting()
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Service Sales")
		close(this)
		return
	end if
	wf_set_preferences()
	this.id_master.object.posted.initial = "N"
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	f_retrieve_servicelist(this.id_itemslist, this.it_transobject)
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5075", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.date.protect = 0
		this.id_master.object.date.background.color = rgb(255, 255, 255)
		this.ib_modifydate = true
	end if
	if not this.ib_modifydate then
		this.id_master.object.date.protect = 1
		this.id_master.settaborder("date", 0)
	end if
	this.id_itemslist.object.location.visible = false
	for li_count = 65 to 90
		lc_char = char(li_count)
		this.ia_llookuptable[li_count] = this.id_itemslist.find("Lower(itemname) >= Lower('" + char(li_count) + "')", ll_startrow, 99999)
		ll_startrow = this.ia_llookuptable[li_count]
	next
	this.ia_llookuptable[92] = 99999
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	if f_stringpreferences("filter_svccat_on_startup_in_servicepur") = "Y" then
		wf_refresh_singleservicecategory()
		this.id_itemslist.hide()
	end if
	f_setserviceqtystyle(this.id_detail, "qty")
	setredraw(true)

// w_servicepurchase.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.is_child = classname()
	return ::message.returnvalue

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	return ::message.returnvalue

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		if data = "" or double(data) < 0.0 then
			messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
		end if
	case "flatdisc"
		if data = "" or double(data) < 0.0 then
			messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
		end if
	case "discperc"
		if data = "" or double(data) < 0.0 or double(data) > 100.0 then
			messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
		end if
	end choose
	return 1

// dw_footer.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	parent.parent.parent.id_itemslist.hide()
	parent.parent.parent.ib_itemslistopen = false
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_code
	long ll_detailrows
	long ll_suppcode
	long ll_counter
	long ll_icode
	integer rt_code
	integer li_suppcode
	integer li_res
	string ls_result
	string ls_null
	string ls_aliasname
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "suppcode"
		ll_code = long(data)
		parent.parent.parent.wf_setsuppinfo(ll_code, this)
	case "aliasname"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_find_suppcode(li_suppcode, data)
			if li_res > 0 then
				setitem(row, "suppcode", li_suppcode)
				parent.parent.parent.wf_setsuppinfo(li_suppcode, this)
				return 0
			else
				messagebox("Supplier Validation", "Supplier with  AliasName " + data + " does not exist")
				return 1
			end if
			return
		end if
		return rt_code
	end choose
	return rt_code

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "date"
		messagebox("Date Time Validation", "Date and Time is invalid,~r~nPlease enter current date and time")
	case "suppcode"
		messagebox("Supplier Name Validation", "You must select some Supplier")
	case "headerno"
		if data = "" or isnull(data) then
			messagebox("Header No Validation", "You must select some HeaderNo")
		end if
	end choose
	return 1

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	long ll_counter
	long ll_foundcode
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	try
		if key = keyf6! and getcolumnname() = "suppcode" then
		end if
	catch (throwable exdw)
		messagebox("Exception Occur", "Details are:~r~n" + exdw.getmessage())
	catch (throwable exnullobj)
		messagebox("Exception Occur", "Details are:~r~n" + exnullobj.getmessage())
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
		setnull(ll_counter)
		parent.parent.parent.id_master.setitem(1, "suppcode", ll_counter)
	end try
	return ::message.returnvalue

// dw_detail.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	parent.parent.parent.id_itemslist.hide()
	parent.parent.parent.ib_itemslistopen = false
	return ::message.returnvalue

// dw_detail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	parent.parent.parent.post wf_setsuppname(data)
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	integer li_servicecode
	long ll_newqty
	long ll_storedqty
	long ll_stock
	long ll_null
	long ll_icode
	long ll_gcode
	string ls_null
	string ls_itemname
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
		parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		li_errcode = 0
	case "fullcode"
		if isnull(data) or data = "" then
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			setitem(row, "itemname", ls_itemname)
			li_errcode = 2
		else
			li_res = parent.parent.parent.wf_find_service_fullcode(data, ll_icode, ls_itemname)
			if li_res > 0 then
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				setitem(row, "qty", 1)
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
				if parent.parent.parent.wf_validateitem(false) = 0 then
					li_errcode = 0
				else
					li_errcode = 1
				end if
			else
				messagebox("Service Code/Alias Name Validation", "Service does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				setitem(row, "itemname", ls_itemname)
				li_errcode = 1
			end if
		end if
	case "qty"
		if double(data) > 0.0 then
			if double(long(data)) <> double(data) and parent.parent.parent.id_detail.object.allowsaleindecimal[row] = "N" then
				messagebox("Quantity Validation", "Quantity In decimals is not allowed for this service", stopsign!)
				li_errcode = 1
			else
				li_errcode = 0
			end if
		else
			messagebox("Quantity Validation", "Please enter a valid Quantity for this service", stopsign!)
			li_errcode = 1
		end if
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ll_icode
	long ll_gcode
	long ll_godownstock
	long ancestorreturnvalue
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(false) = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "itemname" then
		parent.parent.parent.ib_focusdetail = true
		parent.parent.parent.id_itemslist.show()
	else
		parent.parent.parent.ib_focusdetail = true
		parent.parent.parent.id_itemslist.hide()
	end if
	parent.parent.parent.wf_grandtotal()
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return 0

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(true) = -1 then
		return ::message.returnvalue
	end if
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if getcolumnname() <> parent.parent.parent.is_columnitemname then
		if rowcount() > 0 and lrs_status <> new! then
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", getitemnumber(currentrow, "icode"))
		elseif parent.parent.parent.id_footer.getrow() > 0 then
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", 0)
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	parent.parent.parent.id_itemslist.hide()
	parent.parent.parent.ib_itemslistopen = false
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		if data = "" or isnull(data) then
			messagebox("Service Validation", "Please enter value for Service in row " + string(row))
		end if
	case "discperc"
		if real(data) < 0.0 and real(data) > 100.0 then
			messagebox("Service Discount Validation", "Discount ~"" + data + "~" must be betweeen 0 and 100")
		end if
	case "smancode"
		messagebox("SalesPerson Validation", "Please select SalesPerson from the dropdown box.")
	end choose
	return 1

// dw_itemsdetail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	return ::message.returnvalue

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ll_currrow
	long ll_startrow
	long ll_endrow
	if parent.parent.parent.editflag = false then
		parent.parent.parent.editflag = true
		parent.parent.parent.im_menu.m_file.m_save.enabled = true
	end if
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		if upper(left(data, 1)) >= "A" and upper(left(data, 1)) <= "Z" or left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
			ll_currrow = parent.parent.parent.id_itemslist.getrow()
			if len(data) > 1 then
				ll_startrow = ll_currrow
			else
				if left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
					ll_startrow = 1
				else
					ll_startrow = parent.parent.parent.ia_llookuptable[asc(upper(data))]
				end if
				parent.parent.parent.ib_bkspace = false
			end if
			if parent.parent.parent.ib_bkspace then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.find("Lower(itemname) <= '" + lower(data) + "'", ll_startrow, 0)
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.il_itemlistfoundrow + 1
				parent.parent.parent.ib_bkspace = false
			else
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.find("Lower(itemname) >= '" + lower(data) + "'", ll_startrow, 99999)
			end if
			if parent.parent.parent.il_itemlistfoundrow = 0 then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.rowcount()
			end if
			if parent.parent.parent.il_itemlistfoundrow <> ll_currrow then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.setrow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_itemslist.scrolltorow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_itemslist.selectrow(parent.parent.parent.il_itemlistfoundrow, true)
				ll_endrow = setitem(row, "currlistrow", parent.parent.parent.il_itemlistfoundrow)
				ll_endrow = getitemnumber(row, "currlistrow")
				setfocus()
			end if
		end if
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	end choose
	if getcolumn() = 1 then
		parent.parent.parent.is_aliasname = data
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	integer li_rowno
	integer i
	integer li_columnno
	li_columnno = integer(this.object.qty.id)
	if getrow() = rowcount() then
		if getcolumn() = li_columnno then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
	elseif li_columnno = integer(this.object.datawindow.column.count) and getcolumn() = li_columnno then
		scrollnextrow()
		if f_stringpreferences("ItemCode") = "Y" then
			setcolumn("fullcode")
		else
			setcolumn("itemname")
		end if
		setfocus()
		return 1
	end if
	li_rowno = parent.parent.parent.id_itemslist.find("fullcode='" + parent.parent.parent.is_aliasname + "'", 1, parent.parent.parent.id_itemslist.rowcount())
	if getcolumn() = 1 and li_rowno > 0 and li_rowno <= parent.parent.parent.id_itemslist.rowcount() then
		if isnull(parent.parent.parent.is_aliasname) or parent.parent.parent.is_aliasname = "" then
			setcolumn("itemname")
		else
			setcolumn("qty")
		end if
		setfocus()
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_itemsdetail.getfocus() returns long [event]
	long ancestorreturnvalue
	if f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_icode
	long ll_found
	long ll_rowm
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(parent.parent.parent.id_itemslist.rowcount())
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(1)
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf4! then
			parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
			setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
			setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	elseif key = keydownarrow! then
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_focusfooter")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	end if
	return rt_code
