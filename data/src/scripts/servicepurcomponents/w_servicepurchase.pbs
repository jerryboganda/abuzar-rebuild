// w_servicepurchase.wf_initmodify(integer ai_protect) returns 0
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_looseqty
	long ll_stock
	long ll_counter
	long ll_count
	if this.id_master.getitemstring(1, "posted") = "N" then
		if ai_protect = 0 then
			this.ib_modify = true
			this.editflag = true
			this.im_menu.m_file.m_save.enabled = true
			this.im_menu.m_file.m_new.enabled = false
			this.im_menu.m_file.m_delete.enabled = false
			this.im_menu.m_item.m_newitem.enabled = true
			this.im_menu.m_item.m_deleteitem.enabled = true
			this.im_menu.m_file.m_first.enabled = false
			this.im_menu.m_file.m_next.enabled = false
			this.im_menu.m_file.m_previous.enabled = false
			this.im_menu.m_file.m_last.enabled = false
			this.im_menu.m_file.m_retrieve.enabled = true
			this.im_menu.m_file.m_retrieve.text = "Lis&t"
			this.tab_retrieve.tabpage_detail.enabled = true
		end if
		return
	end if
	this.ib_modify = false
	this.editflag = false

// w_servicepurchase.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	integer ll_icode
	integer ll_retflag
	string ls_itemname
	if f_stringpreferences("EnableServiceCatRights") = "Y" then
		SQL SELECT service.servicecode , service.name INTO :ll_icode, :ls_itemname FROM service WHERE service.aliasname =:as_fullcode AND service.servicecatcode IN ( SELECT sc.servicecatcode FROM GroupAllowedServiceCategory sc WHERE sc.GroupCode =:this.il_groupcode ) USING this.it_transobject;
	else
		SQL SELECT service.servicecode , service.name INTO :ll_icode, :ls_itemname FROM service WHERE service.aliasname =:as_fullcode USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_servicepurchase.wf_validateitem(boolean ab_flag) returns integer
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean ib_due
	integer li_null
	string ls_null
	if this.id_detail.rowcount() > 0 and this.il_currrow > 0 then
		ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	else
		li_errcode = -1
	end if
	if not isnull(ll_icode) and wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
	end if
	if ab_flag then
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		ls_titleerrtext = "Purcahse of Service Validation"
		messagebox(ls_titleerrtext, ls_errtext)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
	end if
	return li_errcode

// w_servicepurchase.wf_inititeminfo(long al_icode, long al_row, integer ai_rtcode, string as_errortext) returns boolean
	boolean retflag
	boolean lb_continue
	double ld_saleprice
	double ld_discperc
	double ld_costprice
	double ld_flatdisc
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_allowsaleindecimal
	setnull(ls_null)
	SQL SELECT service.aliasname , service.name , service.price , service.costprice , ServiceFlatDisc , AllowSaleInDecimal INTO :ls_fullcode, :ls_name, :ld_saleprice, :ld_costprice, :ld_flatdisc, :ls_allowsaleindecimal FROM service WHERE service.servicecode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		ai_rtcode = -1
		retflag = false
		as_errortext = "Database Error: Service information can not be retrieved"
	end if
	if retflag then
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		this.id_detail.setitem(al_row, "allowsaleindecimal", ls_allowsaleindecimal)
		if this.id_detail.getitemstatus(al_row, "price", primary!) = new! or this.id_detail.getitemstatus(al_row, "price", primary!) = notmodified! then
			this.id_detail.setitem(al_row, "price", ld_saleprice)
			this.id_detail.setitem(al_row, "serviceflatdisc", ld_flatdisc)
		end if
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
			this.id_detail.setitem(al_row, "price", ld_saleprice)
			this.id_detail.setitem(al_row, "serviceflatdisc", ld_flatdisc)
		end if
		this.id_detail.setitem(al_row, "itemcode", al_icode)
		this.id_detail.setitem(al_row, "icode", al_icode)
		ai_rtcode = 0
	end if
	return retflag

// w_servicepurchase.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_servicepurchase.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_customerbalance
	double ld_cashreceived
	real lr_discperc
	real lr_flatdisc
	real lr_misccharges
	real lr_salestax
	real lr_itemstotal
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		lr_discperc = this.id_footer.object.invdiscperc[1]
		lr_flatdisc = this.id_footer.object.flatdisc[1]
		lr_misccharges = this.id_footer.object.misccharges[1]
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
		ld_grandtotal = ld_detaildwtotal * (1.0 - lr_discperc * 0.01) - lr_flatdisc + lr_misccharges + lr_salestax
		ld_grandtotal = round(ld_grandtotal, 0)
		this.id_footer.setitem(1, "total", ld_grandtotal)
	end if
	return ld_grandtotal

// w_servicepurchase.wf_selectprintreport() returns string
	string ls_pagesize
