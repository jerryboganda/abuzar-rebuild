// window w_itemtransferhistory (transfer)  ancestor: window

// w_itemtransferhistory.create() returns 0 [event]
	this.cb_print = create cb_print
	this.dw_control = create dw_control
	this.control = {this.cb_print, this.dw_control}

// w_itemtransferhistory.destroy() returns 0 [event]
	destroy this.cb_print
	destroy this.dw_control

// w_itemtransferhistory.open() returns long [event]
	s_itemsalehistory ls_itemsalehistory
	long ll_width
	long ll_height
	environment env
	ls_itemsalehistory = message.powerobjectparm
	if getenvironment(env) <> 1 then
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.width = ll_width * 0.98
	this.height = ll_height * 0.90
	this.y = int((ll_height - this.height) / 2.0)
	this.dw_control.width = this.width - this.width * 0.02
	this.dw_control.height = this.height * 0.90
	this.cb_print.y = this.dw_control.height + 20
	this.dw_control.settransobject(sqlca)
	this.dw_control.retrieve(ls_itemsalehistory.ar_icode, ls_itemsalehistory.ar_date)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_itemtransferhistory.close() returns long [event]
	close(this)
	return ::message.returnvalue

// w_itemtransferhistory.key(keycode key, unsignedlong keyflags) returns long [event]
	if keydown(keyescape!) then
		close(this)
	end if
	return ::message.returnvalue

// cb_print.clicked() returns long [event]
	if parent.dw_control.visible then
		if printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			parent.dw_control.printcancel()
		end if
		parent.dw_control.print()
	end if
	return ::message.returnvalue
