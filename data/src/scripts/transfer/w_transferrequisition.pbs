// w_transferrequisition.wf_fetchitemlist(integer ai_sourcegcode) returns 0
	this.id_detail.setredraw(false)
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		this.idc_itemdddw.retrieve(gi_catlist, ai_sourcegcode)
		this.ids_sourcegodownitems.retrieve(gi_catlist, ai_sourcegcode)
	else
		this.idc_itemdddw.retrieve(ai_sourcegcode)
		this.ids_sourcegodownitems.retrieve(ai_sourcegcode)
	end if
	this.ids_sourcegodownitems.sharedata(this.id_itemslist)
	this.ii_currsourcegodown = ai_sourcegcode
	this.id_detail.setredraw(true)

// w_transferrequisition.wf_findfullcode(string as_fullcode, long al_icode, string as_itemname) returns integer
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		as_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_transferrequisition.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	long iccode
	long icatcode
	long packcode
	long manfcode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

