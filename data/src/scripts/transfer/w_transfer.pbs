		this.id_detail.object.saleprice.visible = false
	end if
	if f_stringpreferences("ShowPackCapacityInSale") = "N" then
		this.id_detail.object.packcapacity.visible = false
	end if
	if f_stringpreferences("ShowAreaVolumeInSale") = "N" then
		this.id_detail.object.areavolume.visible = false
	end if
	if f_stringpreferences("ShowPackCoverageInSale") = "N" then
		this.id_detail.object.c_packcoverage.visible = false
	end if
	if f_stringpreferences("ShowPCSInSale") = "N" then
		this.id_detail.object.pcs.visible = false
	end if
	if f_stringpreferences("ShowCartonsInSale") = "N" then
		this.id_detail.object.cartons.visible = false
	end if
	if f_stringpreferences("ShowSourceStockInTransfer") = "N" then
		this.id_detail.object.sourcestk.visible = false
	end if
	if f_stringpreferences("ShowTargetStockInTransfer") = "N" then
		this.id_detail.object.targetstk.visible = false
	end if
	if f_stringpreferences("ShowReorderQtyInTransfer") = "N" then
		this.id_detail.object.reorderqty.visible = false
	end if
	if f_stringpreferences("ShowOptimumQtyInTransfer") = "N" then
		this.id_detail.object.optimumqty.visible = false
	end if
	if f_stringpreferences("ShowRequiredQtyInTransfer") = "N" then
		this.id_detail.object.requiredqty.visible = false
	end if
	if f_stringpreferences("ShowitemdescriptionInTransfer") = "N" then
		this.id_detail.object.itemdescription.visible = false
	end if

// w_transfer.wf_inititeminfo(long al_icode, long al_row, integer ai_rtcode, string as_errortext) returns boolean
	boolean retflag = true
	double ld_saleprice
	double ld_discperc
	double ld_purprice
	double ld_avgprice
	long ll_packunits
	long ll_saleinvcode
	long ll_oldicode
	double ld_saleqty
	double ld_totalstock
	double ld_sourcestk
	double ld_targetstk
	double ld_requiredqty
	double ld_packcapacity
	double ld_areavolume
	long ll_greorderqty
	long ll_goptimumqty
	integer li_ttype
	integer li_sgcode
	integer li_dgcode
	string ls_fullcode
	string ls_name
	string ls_alternatecustomicode
	string ls_null
	string ls_packingdesc
	datetime ldt_startdate
	datetime ldt_enddate
	long ll_godownwise_reorderqty
	long ll_godownwise_optimumqty
	long ll_sourcegodown_reorderqty
	long ll_itemalertcode
	li_sgcode = this.id_master.getitemnumber(this.id_master.getrow(), "sgcode")
	li_dgcode = this.id_master.getitemnumber(this.id_master.getrow(), "dgcode")
	li_ttype = this.id_master.getitemnumber(this.id_master.getrow(), "ttcode")
	ldt_startdate = this.id_master.getitemdatetime(this.id_master.getrow(), "startdate")
	ldt_enddate = this.id_master.getitemdatetime(this.id_master.getrow(), "enddate")
	setnull(ls_null)
	SQL SELECT item.customicode , item.name , item.packingdesc , item.saleprice , item.packunits , item.salediscperc , item.purprice , item.avgprice , isnull ( item.greorderqty , 0 ) , isnull ( item.goptimumqty , 0 ) , sourcegodown_reorderqty =ISNULL ( ( Select IsNull ( reorderqty , 0 ) From godownitemsetting where godownitemsetting.icode =item.icode and godownitemsetting.gcode =:li_sgcode ) , 0 ) , godownwise_reorderqty =ISNULL ( ( Select IsNull ( reorderqty , 0 ) From godownitemsetting where godownitemsetting.icode =item.icode and godownitemsetting.gcode =:li_dgcode ) , 0 ) , godownwise_optimumqty =ISNULL ( ( Select IsNull ( optimumqty , 0 ) From godownitemsetting where godownitemsetting.icode =item.icode and godownitemsetting.gcode =:li_dgcode ) , 0 ) , sourcestk =ISNULL ( ( select isnull ( sum ( currqty ) , 0 ) FROM godowndetail where godowndetail.icode =item.icode and godowndetail.gcode =:li_sgcode ) , 0 ) , targetstk =ISNULL ( ( select isnull ( sum ( currqty ) , 0 ) FROM godowndetail where godowndetail.icode =item.icode and godowndetail.gcode =:li_dgcode ) , 0 ) , totalstk =ISNULL ( ( select isnull ( sum ( currqty ) , 0 ) FROM godowndetail where godowndetail.icode =item.icode and godowndetail.gcode IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :this.il_strategy WHEN 2 THEN ( SELECT DISTINCT G.GCode From Godown G WHERE G.Gcode =Godown.GCode ) ELSE ( SELECT DISTINCT GCode From GroupAllowedGodown WHERE GroupAllowedGodown.GroupCode =:this.il_groupcode AND GroupAllowedGodown.Module =:this.ii_module AND GroupAllowedGodown.GCode =Godown.GCode ) END ) ) ) , 0 ) , item.itemalertcode , item.packcapacity , item.areavolume INTO :ls_fullcode, :ls_name, :ls_packingdesc, :ld_saleprice, :ll_packunits, :ld_discperc, :ld_purprice, :ld_avgprice, :ll_greorderqty, :ll_goptimumqty, :ll_sourcegodown_reorderqty, :ll_godownwise_reorderqty, :ll_godownwise_optimumqty, :ld_sourcestk, :ld_targetstk, :ld_totalstock, :ll_itemalertcode, :ld_packcapacity, :ld_areavolume FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	elseif this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	ls_alternatecustomicode = this.id_detail.object.alternatecustomicode[al_row]
	if isnull(ls_alternatecustomicode) then
		ls_alternatecustomicode = ""
	end if
	if lower(ls_fullcode) = lower(ls_alternatecustomicode) then
		ls_alternatecustomicode = ls_null
		this.id_detail.object.alternatecustomicode[al_row] = ls_null
	end if
	if retflag then
		this.id_detail.setitem(al_row, "icode", al_icode)
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "packingdesc", ls_packingdesc)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		this.id_detail.setitem(al_row, "stock", ld_sourcestk)
		this.id_detail.setitem(al_row, "totalstock", ld_totalstock)
		this.id_detail.setitem(al_row, "sourcestk", ld_sourcestk)
		this.id_detail.setitem(al_row, "targetstk", ld_targetstk)
		this.id_detail.setitem(al_row, "packunits", ll_packunits)
		if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) then
			if this.id_detail.getitemstatus(al_row, "saleprice", primary!) = notmodified! then
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
			end if
			if isnull(this.il_previcode) = false and al_icode <> this.il_previcode then
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
			end if
			this.id_detail.setitem(al_row, "purprice", ld_purprice)
		end if
		this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
		if li_ttype = 2 then
			if isnull(ll_godownwise_reorderqty) then
				ll_godownwise_reorderqty = 0
			end if
			if isnull(ll_godownwise_optimumqty) then
				ll_godownwise_optimumqty = 0
			end if
			ll_greorderqty = ll_godownwise_reorderqty
			ll_goptimumqty = ll_godownwise_optimumqty
		end if
		this.id_detail.setitem(al_row, "reorderqty", ll_greorderqty)
		this.id_detail.setitem(al_row, "optimumqty", ll_goptimumqty)
		if li_ttype = 3 and this.ib_godwisecons_itemfetch = true then
			ld_requiredqty = 0
			this.it_transobject.getitemreqqtyfortransfer(ldt_startdate, ldt_enddate, al_icode, li_dgcode, ld_requiredqty)
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Item Validation", "Unable to fetch item required quantity.")
				ld_requiredqty = 0
			end if
			this.id_detail.setitem(al_row, "reorderqty", 0)
			this.id_detail.setitem(al_row, "optimumqty", 0)
			this.id_detail.setitem(al_row, "requiredqty", ld_requiredqty)
			if ld_sourcestk >= ld_requiredqty then
				this.id_detail.setitem(al_row, "qty", ld_requiredqty)
			else
				this.id_detail.setitem(al_row, "qty", ld_sourcestk)
			end if
		elseif li_ttype = 4 then
			if ld_sourcestk > 0.0 then
				this.id_detail.setitem(al_row, "requiredqty", ld_sourcestk)
				this.id_detail.setitem(al_row, "qty", ld_sourcestk)
			else
				this.id_detail.setitem(al_row, "requiredqty", 0)
				this.id_detail.setitem(al_row, "qty", 0)
			end if
		elseif ld_sourcestk >= double(ll_goptimumqty) - ld_targetstk then
			if double(ll_goptimumqty) - ld_targetstk > 0.0 then
				this.id_detail.setitem(al_row, "requiredqty", double(ll_goptimumqty) - ld_targetstk)
				this.id_detail.setitem(al_row, "qty", double(ll_goptimumqty) - ld_targetstk)
			else
				this.id_detail.setitem(al_row, "requiredqty", 0)
				this.id_detail.setitem(al_row, "qty", 0)
				ai_rtcode = -2
			end if
		else
			this.id_detail.setitem(al_row, "requiredqty", ld_sourcestk)
			this.id_detail.setitem(al_row, "qty", ld_sourcestk)
		end if
		if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
			ld_areavolume = 1
		end if
		if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
			ld_packcapacity = 1
		end if
		this.id_detail.setitem(al_row, "packcapacity", ld_packcapacity)
		this.id_detail.setitem(al_row, "areavolume", ld_areavolume)
		this.id_detail.setitem(al_row, "pcs", round(this.id_detail.object.qty[al_row] / ld_areavolume, 6))
		this.id_detail.setitem(al_row, "cartons", trim(string(long(this.id_detail.object.pcs[al_row] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[al_row] mod ld_packcapacity, 2))))))
		if this.id_detail.getitemstatus(al_row, "itemalertcode", primary!) = notmodified! then
			ai_rtcode = wf_show_itemalert(ll_itemalertcode)
			if ai_rtcode < 0 then
				retflag = false
				setnull(as_errortext)
			else
				this.id_detail.setitem(al_row, "itemalertcode", ll_itemalertcode)
			end if
		end if
		if f_stringpreferences("promptifsourcestockreachesreorderlevel") = "Y" and double(ll_sourcegodown_reorderqty) > ld_sourcestk - this.id_detail.object.qty[al_row] then
			messagebox("Source Godown Reorder Level Alert", "Source Godown Stock for this item become less than its Reorder Qty.~r~nKindly do the needfull to maintain Re-Order Level at the earliest possible.")
		end if
		if ld_sourcestk = 0.0 then
			if this.ib_allowinsufficientstockitems then
				ai_rtcode = 0
			else
				ai_rtcode = -2
			end if
			as_errortext = "Cannot transfer this item, its Stock is Zero"
		end if
		if double(ll_goptimumqty) - ld_targetstk <= 0.0 then
			ai_rtcode = -3
			as_errortext = "Cannot transfer this item, Not Required at Destination"
		end if
	else
		if this.ib_allowinsufficientstockitems then
			ai_rtcode = 0
			retflag = true
		else
			ai_rtcode = -1
			retflag = false
		end if
		as_errortext = "Cannot transfer this item, its Stock is Zero"
	end if
	this.id_footer.setitem(1, "stock", ld_sourcestk)
	this.id_footer.setitem(1, "totalstock", ld_totalstock)
	return retflag

// w_transfer.wf_validateitem() returns integer
	long ll_icode
	double ld_stock
	double ld_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	integer li_option
	boolean ib_due
	integer li_null
	string ls_null
	if this.il_currrow = 0 then
		return 1
	end if
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if f_stringpreferences("AllowBatchWiseTrasnfer") = "N" then
		if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true and f_stringpreferences("AllowDupItemsInTransfer") = "N" then
			ls_titleerrtext = "Item Validation"
			ls_errtext = "Duplicate item, please select some other item"
			li_errcode = -1
		else
			wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext)
			if li_errcode = -2 then
				messagebox("Item Validation", "Item stock does not exist")
				li_errcode = -1
			end if
		end if
	else
		wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext)
		if li_errcode = -2 then
			messagebox("Item Validation", "Item stock does not exist")
			li_errcode = -1
		end if
	end if
	if this.id_detail.getitemnumber(this.il_currrow, "qty") < 0.0 then
		ls_errtext = "Please enter valid quantity."
		li_errcode = -1
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 and not ib_due then
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.setfocus()
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.fullcode[this.il_currrow] = ls_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
	end if
	return li_errcode

// w_transfer.wf_allowtransfermodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns integer
	long ll_disallowedcount
	SQL SELECT DISTINCT SGCode =ISNull ( Count ( SGCode ) , 0 ) INTO :ll_disallowedcount FROM THeader WHERE TransCode =:ad_invoicecode AND SGCode Not IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_transfer.wf_getsalesstockinfo(long al_saleinvcode, long al_gcode, long al_icode, double ad_saleqty) returns integer
	SQL Select IsNull ( Sum ( saledetail.looseqty ) , 0 ) INTO :ad_saleqty from saledetail where saledetail.saleinvcode =:al_saleinvcode and saledetail.gcode =:al_gcode and saledetail.icode =:al_icode USING this.it_transobject;
	if isnull(ad_saleqty) then
		ad_saleqty = 0
	end if
	return this.it_transobject.sqlcode

// w_transfer.wf_setiteminfo(long al_icode, long al_row, double ad_saleprice, double ad_discperc, double ad_stock, double ad_avgprice, double ad_totalstock, double ad_purdiscperc) returns 0
	this.id_detail.setitem(al_row, "saleprice", ad_saleprice)
	if this.ii_saletype = 1 then
		this.id_detail.setitem(al_row, "discperc", ad_discperc)
	else
		this.id_detail.setitem(al_row, "discperc", 0.0)
	end if
	this.id_detail.setitem(al_row, "rate", ad_saleprice)
	this.id_detail.setitem(al_row, "avgprice", ad_avgprice)
	this.id_footer.object.icode[this.id_footer.getrow()] = al_icode
	this.id_footer.object.stock[this.id_footer.getrow()] = ad_stock

// w_transfer.wf_selectitembatches(long al_gcode, long al_icode, double ad_qty, datawindow ad_itemsdetail, long al_rowscount, string al_errortext) returns integer
	datastore lds_itemstockinfo
	long ll_counter
	long ll_detailrowcount
	double ld_saleqty
	double ld_reqqty
	double ld_totalstock
	double ld_batchqty
	boolean lb_flag
	integer li_errcode
	lds_itemstockinfo = create datastore
	lds_itemstockinfo.dataobject = "d_itemstockinfo"
	lds_itemstockinfo.settransobject(this.it_transobject)
	if lds_itemstockinfo.retrieve(al_gcode, al_icode) > 0 then
		ld_totalstock = lds_itemstockinfo.getitemnumber(1, "c_totalstock")
		if ld_totalstock >= ad_qty then
			ld_reqqty = ad_qty
			ll_detailrowcount = ad_itemsdetail.rowcount()
			ll_counter = 1
			do while ll_counter <= lds_itemstockinfo.rowcount() and not lb_flag
				ld_batchqty = lds_itemstockinfo.getitemnumber(ll_counter, "currqty")
				if ld_batchqty >= ld_reqqty then
					ld_saleqty = ld_reqqty
					lb_flag = true
				else
					ld_saleqty = ld_batchqty
					ld_reqqty = ld_reqqty - ld_batchqty
				end if
				ad_itemsdetail.insertrow(0)
				ll_detailrowcount = ll_detailrowcount + 1
				ad_itemsdetail.setitem(ll_detailrowcount, "icode", al_icode)
				ad_itemsdetail.setitem(ll_detailrowcount, "batch", lds_itemstockinfo.getitemstring(ll_counter, "batch"))
				ad_itemsdetail.setitem(ll_detailrowcount, "expiry", lds_itemstockinfo.getitemdatetime(ll_counter, "expiry"))
				ad_itemsdetail.setitem(ll_detailrowcount, "stock", ld_batchqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "totalstock", ld_totalstock)
				ad_itemsdetail.setitem(ll_detailrowcount, "qty", ld_saleqty)
				ll_counter = ll_counter + 1
			loop
			al_rowscount = ll_counter - 1
		else
			li_errcode = 1
			al_rowscount = ld_totalstock
			al_errortext = "Stock has been decreased for this item   "
		end if
	else
		li_errcode = 1
		al_rowscount = ld_totalstock
		al_errortext = "Stock does not exist for this item   "
	end if
	destroy lds_itemstockinfo
	return li_errcode

// w_transfer.wf_copyinvoice() returns long
	datastore lds_tempdetail
	s_saletemplate lstr_template
	m_transfer lm_menu
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	boolean lb_bonus
	boolean lb_salepricefromtemplate
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrows
	long ll_newrow
	integer li_retcode = 1
	integer li_errcode
	integer li_counter
	integer ll_found
	integer ll_innercounter
	integer li_holdqty
	integer li_addbonusinqty
	double ld_looseqty
	double ld_holdbonusqty
	double ld_qty
	double ld_sourcestk
	datawindowchild ldc_godown
	lm_menu = this.menuid
	if wf_iseditable() = false then
		return 0
	end if
	if this.ib_itemslistopen then
		this.id_itemslist.hide()
		this.ib_itemslistopen = false
	end if
	if this.id_master.getitemnumber(this.id_master.getrow(), "sgcode") = this.id_master.getitemnumber(this.id_master.getrow(), "dgcode") then
		messagebox("Godown Validation", "Source and Target Godown must be different.~r~nCannot generate Transfer Items")
		return -1
	elseif isnull(this.id_master.getitemnumber(this.id_master.getrow(), "sgcode")) then
		messagebox("Source Godown Validation", "Please Select Valid Source Godown.")
		this.id_master.setcolumn("sgcode")
		this.id_master.setfocus()
		return -1
	elseif isnull(this.id_master.getitemnumber(this.id_master.getrow(), "dgcode")) then
		messagebox("Target Godown Validation", "Please Select Valid Target Godown.")
		this.id_master.setcolumn("dgcode")
		this.id_master.setfocus()
		return -1
	end if
	lds_tempdetail = create datastore
	open(w_copysaleinvoicefrom)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		destroy lds_tempdetail
		return -1
	end if
	setredraw(false)
	if this.id_detail.rowcount() > 0 then
		li_counter = 1
		this.id_detail.setrow(this.id_detail.rowcount())
		this.id_detail.scrolltorow(this.id_detail.rowcount())
		for li_counter = this.id_detail.rowcount() to 1 step -1
			event ue_deleteitem()
		next
	end if
	if lstr_template.c_copyinvfrom = "T" then
		if messagebox("Sale Price Confirmation", "Do you want to apply SalePrice from saletemplate?", stopsign!, yesno!, 2) = 1 then
			lb_salepricefromtemplate = true
		end if
		lds_tempdetail.dataobject = "d_saletemplate_detail"
		lds_tempdetail.settransobject(this.it_transobject)
		ll_totalrows = lds_tempdetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_tempdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for ll_rowcount = 1 to ll_totalrows
			ll_newrow = this.id_detail.insertrow(0)
			wf_inititeminfo(lds_tempdetail.getitemnumber(ll_rowcount, "icode"), ll_newrow, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_newrow, "qty", lds_tempdetail.getitemnumber(ll_rowcount, "qty"))
			if lb_salepricefromtemplate = true then
				this.id_detail.setitem(ll_newrow, "saleprice", lds_tempdetail.getitemnumber(ll_rowcount, "saleprice") * lds_tempdetail.getitemnumber(ll_rowcount, "packunits"))
			end if
		next
	elseif lstr_template.c_copyinvfrom = "A" then
		lds_tempdetail.dataobject = "d_IssueReqdetail_temp"
		lds_tempdetail.settransobject(this.it_transobject)
		ll_totalrows = lds_tempdetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_tempdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for ll_rowcount = 1 to ll_totalrows
			ll_newrow = this.id_detail.insertrow(0)
			wf_inititeminfo(lds_tempdetail.getitemnumber(ll_rowcount, "icode"), ll_newrow, li_errcode, ls_errortext)
			if isnull(this.id_detail.getitemnumber(ll_newrow, "icode")) then
				messagebox("Problem", "Problem at Row #" + string(ll_rowcount))
			end if
			ld_qty = lds_tempdetail.getitemnumber(ll_rowcount, "qty")
			ld_sourcestk = this.id_detail.getitemnumber(ll_newrow, "stock")
			if ld_qty > 0.0 then
				this.id_detail.setitem(ll_newrow, "requiredqty", ld_qty)
				if this.id_detail.getitemnumber(ll_newrow, "stock") >= ld_qty then
					this.id_detail.setitem(ll_newrow, "qty", ld_qty)
				else
					this.id_detail.setitem(ll_newrow, "qty", this.id_detail.getitemnumber(ll_newrow, "stock"))
				end if
			else
				this.id_detail.setitem(ll_newrow, "requiredqty", 0)
				this.id_detail.setitem(ll_newrow, "qty", 0)
			end if
		next
	elseif lstr_template.c_copyinvfrom = "I" then
		lds_tempdetail.dataobject = "d_WholeSaleDetail"
		lds_tempdetail.settransobject(this.it_transobject)
		li_retcode = lds_tempdetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, 1, this.il_strategy)
		ll_totalrows = lds_tempdetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_tempdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for ll_rowcount = 1 to ll_totalrows
			ll_newrow = this.id_detail.insertrow(0)
			wf_inititeminfo(lds_tempdetail.getitemnumber(ll_rowcount, "icode"), ll_newrow, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_newrow, "qty", lds_tempdetail.getitemnumber(ll_rowcount, "looseqty") + lds_tempdetail.getitemnumber(ll_rowcount, "bonusqty"))
		next
	elseif lstr_template.c_copyinvfrom = "P" then
		li_addbonusinqty = messagebox("Bonus In Sale Qty", "Do you want to add Bonus In Transfer Qty?", question!, yesno!, 2)
		if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
			lds_tempdetail.dataobject = "d_normalpurchasedetail"
		else
			lds_tempdetail.dataobject = "d_loosepurchasedetail"
		end if
		lds_tempdetail.settransobject(this.it_transobject)
		li_retcode = lds_tempdetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, 3, this.il_strategy)
		ll_totalrows = lds_tempdetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_detailrows = lds_tempdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for li_counter = 1 to ll_detailrows
			li_holdqty = 0
			ld_holdbonusqty = 0
			ll_icode = lds_tempdetail.object.icode[li_counter]
			ll_found = lds_tempdetail.find("icode=" + string(ll_icode), 1, li_counter - 1)
			if ll_found > 0 then
				if ll_detailrows = 1 then
					lb_isitemexists = false
				elseif li_counter = 1 then
					lb_isitemexists = false
				else
					lb_isitemexists = true
				end if
			else
				lb_isitemexists = false
			end if
			if lb_isitemexists = false then
				if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
					li_holdqty = lds_tempdetail.object.packqty[li_counter]
					ld_holdbonusqty = lds_tempdetail.object.bonusqty[li_counter]
				else
					li_holdqty = lds_tempdetail.object.looseqty[li_counter]
					ld_holdbonusqty = lds_tempdetail.object.bonusqty[li_counter]
				end if
				if li_counter <> ll_detailrows then
					ll_found = lds_tempdetail.find("icode=" + string(ll_icode), li_counter + 1, ll_detailrows)
					ll_innercounter = ll_found
					do while ll_found > 0 and ll_innercounter <= ll_detailrows
						if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
							li_holdqty = li_holdqty + lds_tempdetail.object.packqty[ll_found]
							ld_holdbonusqty = ld_holdbonusqty + lds_tempdetail.object.bonusqty[ll_found]
						else
							li_holdqty = li_holdqty + lds_tempdetail.object.looseqty[ll_found]
							ld_holdbonusqty = ld_holdbonusqty + lds_tempdetail.object.bonusqty[ll_found]
						end if
						ll_innercounter = ll_found + 1
						ll_found = lds_tempdetail.find("icode=" + string(ll_icode), ll_innercounter, ll_detailrows)
					loop
				end if
				ll_insertedrows = this.id_detail.insertrow(0)
				wf_inititeminfo(lds_tempdetail.getitemnumber(li_counter, "icode"), ll_insertedrows, li_errcode, ls_errortext)
				if lstr_template.i_invtype = 1 or lstr_template.i_invtype = 2 then
					li_holdqty = li_holdqty * lds_tempdetail.getitemnumber(li_counter, "packunits")
					ld_holdbonusqty = ld_holdbonusqty * lds_tempdetail.getitemnumber(li_counter, "packunits")
				end if
				if li_addbonusinqty = 1 then
					this.id_detail.setitem(ll_insertedrows, "qty", li_holdqty + ld_holdbonusqty)
				else
					this.id_detail.setitem(ll_insertedrows, "qty", li_holdqty)
				end if
			end if
		next
	elseif lstr_template.c_copyinvfrom = "R" then
		lds_tempdetail.dataobject = "d_OpenWholeSaleReturnDetail"
		lds_tempdetail.settransobject(this.it_transobject)
		li_retcode = lds_tempdetail.getchild("gcode", ldc_godown)
		ldc_godown.settransobject(this.it_transobject)
		li_retcode = ldc_godown.retrieve(this.il_groupcode, 2, this.il_strategy)
		ll_totalrows = lds_tempdetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_tempdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for ll_rowcount = 1 to ll_totalrows
			ll_newrow = this.id_detail.insertrow(0)
			wf_inititeminfo(lds_tempdetail.getitemnumber(ll_rowcount, "icode"), ll_newrow, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_newrow, "qty", lds_tempdetail.getitemnumber(ll_rowcount, "looseqty") + lds_tempdetail.getitemnumber(ll_rowcount, "bonusqty"))
		next
	elseif lstr_template.c_copyinvfrom = "N" then
		lds_tempdetail.dataobject = "d_transfer_detail"
		lds_tempdetail.settransobject(this.it_transobject)
		ll_totalrows = lds_tempdetail.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows < 0 then
			li_retcode = -1
		end if
		ll_totalrows = lds_tempdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		for ll_rowcount = 1 to ll_totalrows
			ll_newrow = this.id_detail.insertrow(0)
			wf_inititeminfo(lds_tempdetail.getitemnumber(ll_rowcount, "icode"), ll_newrow, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_newrow, "qty", lds_tempdetail.getitemnumber(ll_rowcount, "qty"))
		next
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	destroy lds_tempdetail
	if this.id_detail.rowcount() <= 0 then
		event ue_newitem()
	else
		this.im_menu.m_file.m_save.enabled = true
		lm_menu.m_file.m_saveandpost.enabled = true
		if this.id_detail.rowcount() > 1 then
			this.id_detail.setcolumn("qty")
			this.id_detail.scrolltorow(this.id_detail.rowcount())
			this.id_detail.setfocus()
		end if
	end if
	setredraw(true)
	return li_retcode

// w_transfer.wf_populate_transferrequisition(long al_transreqcode) returns long
	long ll_retcode
	long ll_res = 2
	long ll_totalrows
	long ll_counter
	long ll_rowcount
	long ll_insrow
	integer li_errcode
	boolean lb_enablesave
	string ls_errortext
	u_ds_standard lds_trans_req_header
	u_ds_standard lds_trans_req_detail
	ll_res = messagebox("Populate Transfer Requisition", "Data in the detail window will lost?~r~nAre you sure to proceed?", question!, yesno!, 2)
	if ll_res = 2 then
		ll_retcode = 1
	else
		for ll_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		if al_transreqcode > 0 then
			lds_trans_req_header = create u_ds_standard
			lds_trans_req_detail = create u_ds_standard
			lds_trans_req_header.dataobject = "d_transferrequisition_header"
			lds_trans_req_header.settransobject(sqlca)
			ll_totalrows = lds_trans_req_header.retrieve(al_transreqcode)
			if ll_totalrows < 0 then
				ll_retcode = 1
			end if
			ll_totalrows = lds_trans_req_header.rowcount()
			if ll_totalrows > 0 then
				this.id_master.object.ttcode[this.id_master.getrow()] = lds_trans_req_header.object.ttcode[ll_totalrows]
				this.id_master.object.sgcode[this.id_master.getrow()] = lds_trans_req_header.object.sgcode[ll_totalrows]
				this.id_master.object.dgcode[this.id_master.getrow()] = lds_trans_req_header.object.dgcode[ll_totalrows]
				this.id_master.object.startdate[this.id_master.getrow()] = lds_trans_req_header.object.startdate[ll_totalrows]
				this.id_master.object.enddate[this.id_master.getrow()] = lds_trans_req_header.object.enddate[ll_totalrows]
				this.id_master.object.remarks[this.id_master.getrow()] = lds_trans_req_header.object.remarks[ll_totalrows]
			end if
			wf_settransfertype(this.id_master.object.ttcode[this.id_master.getrow()])
			lds_trans_req_detail.dataobject = "d_transferrequisition_detail"
			lds_trans_req_detail.settransobject(sqlca)
			ll_totalrows = lds_trans_req_detail.retrieve(al_transreqcode)
			if ll_totalrows < 0 then
				ll_retcode = 1
			end if
			ll_totalrows = lds_trans_req_detail.rowcount()
			if ll_totalrows > 0 then
				lb_enablesave = true
			end if
			for ll_rowcount = 1 to ll_totalrows
				if this.idc_itembatches.rowcount() <= 0 then
					this.idc_itembatches.insertrow(0)
				end if
				ll_insrow = this.id_detail.insertrow(0)
				wf_inititeminfo(lds_trans_req_detail.getitemnumber(ll_rowcount, "icode"), ll_insrow, li_errcode, ls_errortext)
				this.id_detail.object.qty[ll_insrow] = lds_trans_req_detail.object.qty[ll_rowcount]
			next
			if ll_insrow > 0 then
				this.im_menu.m_file.m_save.visible = true
				this.im_menu.m_file.m_save.enabled = true
			end if
		end if
		ll_retcode = 0
	end if
	return ll_retcode

// w_transfer.wf_show_itemalert(long al_itemalertcode) returns long
	long ll_retcode
	long ll_alerttype
	long ll_res
	string ls_alertname
	string ls_alertdetail
	SQL SELECT Name , ItemAlertTypeCode , AlertDetail INTO :ls_alertname, :ll_alerttype, :ls_alertdetail FROM ItemAlert WHERE ItemAlertCode =:al_itemalertcode AND ItemAlertTypeCode =ItemAlertTypeCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_alerttype = 1 then
			ll_retcode = 0
		elseif ll_alerttype = 2 then
			messagebox(ls_alertname, ls_alertdetail, information!, ok!)
			ll_retcode = 0
		elseif ll_alerttype = 3 then
			ll_res = 2
			ll_res = messagebox(ls_alertname, ls_alertdetail, question!, yesno!, 2)
			if ll_res = 2 then
				ll_retcode = -1
			else
				ll_retcode = 0
			end if
		elseif ll_alerttype = 4 then
			messagebox(ls_alertname, ls_alertdetail, stopsign!, ok!)
			ll_retcode = -1
		end if
	else
		messagebox("Alert Fetching Error", "Problem in retrieving item alert information", stopsign!)
		ll_retcode = -1
	end if
	return ll_retcode

// w_transfer.wf_is_postable(long al_invcode) returns boolean
	boolean lb_postable
	long ll_dgcode
	SQL SELECT H.DGCode INTO :ll_dgcode FROM THeader H WHERE H.TransCode =:al_invcode AND H.DGCode IN ( SELECT GCode FROM Godown WHERE ( SELECT TransferTargetGodownStrategy FROM Groups WHERE GroupCode =:this.il_groupcode ) =2 UNION SELECT GCode FROM GroupAllowedGodown WHERE GroupCode =:this.il_groupcode AND Module =:this.ii_module AND ( SELECT TransferSourceGodownStrategy FROM Groups WHERE GroupCode =:this.il_groupcode ) =1 ) USING sqlca;
	if sqlca.sqlcode = 0 then
		if isnull(ll_dgcode) or ll_dgcode <= 0 then
			lb_postable = false
		else
			lb_postable = true
		end if
	else
		lb_postable = false
	end if
	return lb_postable

// w_transfer.wf_retrievelistall() returns long
	string[] ls_posted
	integer li_salecategory
	long ll_counter
	datetime ld_invdate
	ld_invdate = datetime(date("00/00/00"), time("00:00:00"))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 1 then
		li_salecategory = this.ii_salecategory
	else
		li_salecategory = this.ii_saletype
	end if
	return this.id_list.retrieve(this.il_groupcode, ld_invdate)

// w_transfer.wf_retrievelist() returns long
	string[] ls_posted
	integer li_salecategory
	integer li_invforlastdays = -3
	integer li_listrows
	datetime ld_invdate
	long ll_counter
	boolean lb_netamount
	ls_posted[1] = "N"
	if this.ii_saletype = 1 then
		li_salecategory = this.ii_salecategory
	else
		li_salecategory = this.ii_saletype
	end if
	li_invforlastdays = f_numberpreferences("transferlistviewretrievaldays") * -1
	ld_invdate = datetime(relativedate(today(), li_invforlastdays))
	return this.id_list.retrieve(this.il_groupcode, ld_invdate)

// w_transfer.wf_retrievelist_datelimit() returns long
	string[] ls_posted
	integer li_salecategory
	datetime ld_invdate
	long ll_counter
	s_arguements lstr_arg
	open(w_arg_sdate)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		ld_invdate = lstr_arg.d_sdate
	else
		return 0
	end if
	if this.ii_saletype = 1 then
		li_salecategory = this.ii_salecategory
	else
		li_salecategory = this.ii_saletype
	end if
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	return this.id_list.retrieve(this.il_groupcode, ld_invdate)

// w_transfer.wf_show_itemtransferhistory() returns 0
	s_itemsalehistory ls_itemsalehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itemsalehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itemsalehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itemtransferhistory, ls_itemsalehistory)
	end if

// w_transfer.wf_use_customer_associated_godown() returns long
	long ll_custcode
	long ll_gcode
	s_arguements lstr_arg
	s_arguements lstr_temp
	if wf_iseditable() = false then
		return 0
	end if
	open(w_arg_cust)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 and lstr_arg.l_code1 > 0 then
		ll_custcode = lstr_arg.l_code1
		openwithparm(w_arg_customer_godown, ll_custcode)
		lstr_temp = message.powerobjectparm
		if lstr_temp.i_status = 1 and lstr_temp.l_code3 > 0 then
			ll_gcode = lstr_temp.l_code3
			lstr_arg.l_code2 = lstr_temp.l_code3
			this.id_master.object.dgcode[1] = ll_gcode
			this.id_master.object.dgcode.protect = "1"
		end if
	end if
	return 0

// w_transfer.wf_get_customer_associated_godown(string as_colname) returns long
	long ll_count
	long ll_gcode
	long ll_custcode
	long ll_retcode
	s_arguements lstr_arg
	open(w_arg_cust)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 and lstr_arg.l_code1 > 0 then
		ll_custcode = lstr_arg.l_code1
		SQL SELECT ISNULL ( COUNT ( GCode ) , 0 ) , MIN ( Gcode ) INTO :ll_count, :ll_gcode FROM AccountGodown WHERE AccCode =:ll_custcode USING sqlca;
		if sqlca.sqlcode = 0 then
			if ll_count = 1 then
				ll_retcode = 0
			elseif ll_count > 1 then
				openwithparm(w_arg_account_godown, ll_custcode)
				lstr_arg = message.powerobjectparm
				if lstr_arg.i_status = 1 and lstr_arg.l_code3 > 0 then
					ll_gcode = lstr_arg.l_code3
				end if
				ll_retcode = 0
			end if
			if as_colname = "sgcode" then
				if this.id_master.object.dgcode[1] <> ll_gcode then
					this.id_master.object.sgcode[1] = ll_gcode
					ll_retcode = 0
					wf_fetchitemlist(ll_gcode)
				else
					messagebox("Source Godown Validation", "Source and Target Godowns Can not be same", stopsign!)
					ll_retcode = -1
				end if
			elseif as_colname = "dgcode" then
				if this.id_master.object.sgcode[1] <> ll_gcode then
					this.id_master.object.dgcode[1] = ll_gcode
					ll_retcode = 0
				else
					messagebox("Target/Destination Godown Validation", "Source and Target Godowns Can not be same", stopsign!)
					ll_retcode = -1
				end if
			end if
		end if
	end if
	return 0

// w_transfer.wf_approximate_selectitembatches(long al_gcode, long al_icode, double ad_qty, datastore ad_itemsdetail, long al_rowscount, string as_errortext) returns long
	datastore lds_itemstockinfo
	long ll_counter
	long ll_detailrowcount
	double ld_saleqty
	double ld_reqqty
	double ld_totalstock
	double ld_batchqty
	boolean lb_flag
	integer li_errcode
	lds_itemstockinfo = create datastore
	lds_itemstockinfo.dataobject = "d_itemstockinfo"
	lds_itemstockinfo.settransobject(this.it_transobject)
	if lds_itemstockinfo.retrieve(al_gcode, al_icode) > 0 then
		ld_totalstock = lds_itemstockinfo.getitemnumber(1, "c_totalstock")
		if ld_totalstock >= ad_qty then
			ld_reqqty = ad_qty
			ll_detailrowcount = ad_itemsdetail.rowcount()
			ll_counter = 1
			do while ll_counter <= lds_itemstockinfo.rowcount() and not lb_flag
				ld_batchqty = lds_itemstockinfo.getitemnumber(ll_counter, "currqty")
				if ld_batchqty >= ld_reqqty then
					ld_saleqty = ld_reqqty
					lb_flag = true
				else
					ld_saleqty = ld_batchqty
					ld_reqqty = ld_reqqty - ld_batchqty
				end if
				ad_itemsdetail.insertrow(0)
				ll_detailrowcount = ll_detailrowcount + 1
				ad_itemsdetail.setitem(ll_detailrowcount, "icode", al_icode)
				ad_itemsdetail.setitem(ll_detailrowcount, "batch", lds_itemstockinfo.getitemstring(ll_counter, "batch"))
				ad_itemsdetail.setitem(ll_detailrowcount, "expiry", lds_itemstockinfo.getitemdatetime(ll_counter, "expiry"))
				ad_itemsdetail.setitem(ll_detailrowcount, "manfdate", lds_itemstockinfo.getitemdatetime(ll_counter, "manfdate"))
				ad_itemsdetail.setitem(ll_detailrowcount, "stock", ld_batchqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "totalstock", ld_totalstock)
				ad_itemsdetail.setitem(ll_detailrowcount, "qty", ld_saleqty)
				ll_counter = ll_counter + 1
			loop
			al_rowscount = ll_counter - 1
		else
			li_errcode = 1
			al_rowscount = ld_totalstock
			as_errortext = "Stock has been decreased for this item   "
		end if
	else
		li_errcode = 1
		al_rowscount = ld_totalstock
		as_errortext = "Stock does not exist for this item   "
	end if
	destroy lds_itemstockinfo
	return li_errcode

// w_transfer.wf_show_approx_batchallocation_detail() returns integer
	long ll_retcode
	long ll_detailrows
	long ll_gcode
	long ll_dgcode
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long li_counter
	long li_innercounter
	long ll_insertedrows
	long ll_itemsdetailrowcount
	long ll_row
	long ll_rowgroup
	long ll_innercounter
	long ll_startrow
	long ll_found
	long ll_errorrow
	double ld_stock
	double ld_newstock
	double ld_qty
	double ld_totalstock
	double ld_holdqty
	integer li_round_qty
	integer li_errorcode
	boolean lb_commitflag = true
	string ls_batch
	string ls_errortext
	string ls_alternatecustomicode
	string ls_customicode
	string ls_itemname
	datetime ld_expiry
	datetime ldt_datetime
	datawindowchild ldc_godown
	datawindowchild ldc_itemmeter
	dwitemstatus ldws_column
	datastore id_batchallocation
	s_datastore lstr
	if this.tab_retrieve.selectedtab = 2 then
		return 0
	end if
	if not wf_iseditable() then
		return 0
	end if
	id_batchallocation = create datastore
	id_batchallocation.dataobject = "d_transfer_approx_batchallocation_detail"
	id_batchallocation.settransobject(this.it_transobject)
	li_round_qty = f_get_colprecision("Qty")
	ll_detailrows = this.id_detail.rowcount()
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	ll_itemsdetailrowcount = 0
	ls_errortext = "    Some database problem ocuurs         "
	ll_rowgroup = 0
	do while li_counter <= ll_detailrows and lb_commitflag
		ll_rowgroup = ll_rowgroup + 1
		ll_gcode = this.id_master.object.sgcode[1]
		ll_dgcode = this.id_master.object.dgcode[1]
		ls_customicode = this.id_detail.object.fullcode[li_counter]
		ls_itemname = this.id_detail.object.itemname[li_counter]
		ll_icode = this.id_detail.object.icode[li_counter]
		ld_qty = this.id_detail.object.qty[li_counter]
		ll_packunits = this.id_detail.object.packunits[li_counter]
		if ld_qty > 0.0 and lb_commitflag and wf_approximate_selectitembatches(ll_gcode, ll_icode, ld_qty, id_batchallocation, ll_insertedrows, ls_errortext) = 0 then
			for li_innercounter = 1 to ll_insertedrows
				ll_row = ll_itemsdetailrowcount + li_innercounter
				id_batchallocation.setitem(ll_row, "rowgroup", ll_rowgroup)
				id_batchallocation.setitem(ll_row, "customicode", ls_customicode)
				id_batchallocation.setitem(ll_row, "itemname", ls_itemname)
				id_batchallocation.setitem(ll_row, "gcode", ll_gcode)
				id_batchallocation.setitem(ll_row, "dgcode", ll_dgcode)
			next
			ll_itemsdetailrowcount = ll_itemsdetailrowcount + ll_insertedrows
		end if
		li_counter = li_counter + 1
	loop
	if id_batchallocation.rowcount() > 0 then
		lstr.s_module = "approx. batch allocation"
		lstr.ds = id_batchallocation
		lstr.s_name1 = id_batchallocation.dataobject
		openwithparm(w_preview_invoices2, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
		end if
	end if
	return 0

// w_transfer.wf_validate_pcs(long row, string data) returns long
	long ll_errcode
	long ll_found
	double ld_storedqty
	double ld_newqty
	double ld_stock
	double ld_desiredbonus
	double ld_areavolume
	double ld_pcs
	double ld_packcapacity
	double ld_tmpqty
	integer li_roundupto
	string ls_null
	setnull(ls_null)
	ld_packcapacity = this.id_detail.object.packcapacity[row]
	if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
		ld_packcapacity = 1
	end if
	ld_areavolume = this.id_detail.object.areavolume[row]
	if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
		ld_areavolume = 1
	end if
	ld_pcs = double(data)
	li_roundupto = f_get_colprecision("Qty")
	ld_tmpqty = round(ld_pcs * ld_areavolume, li_roundupto)
	if ld_pcs > 0.0 then
		this.id_detail.setitem(row, "qty", ld_tmpqty)
		this.id_detail.setitem(row, "cartons", trim(string(long(ld_pcs / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(ld_pcs mod ld_packcapacity, 2))))))
	else
		ll_errcode = 1
		messagebox("PCS Validation", "Only possitive PCS are allowed for this item", stopsign!)
	end if
	return ll_errcode

// w_transfer.wf_populate_posted_quotation() returns long
	datastore lds_tempdetail
	datastore lds_tempheader
	s_saletemplate lstr_template
	m_transfer lm_menu
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	boolean lb_bonus
	boolean lb_salepricefromtemplate
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrows
	long ll_newrow
	integer li_retcode = 1
	integer li_errcode
	integer li_counter
	integer ll_found
	integer ll_innercounter
	integer li_holdqty
	integer li_loose_pack = 1
	integer li_addbonusinqty
	double ld_looseqty
	double ld_holdbonusqty
	double ld_qty
	double ld_sourcestk
	double ld_quot_qty
	datawindowchild ldc_godown
	lm_menu = this.menuid
	if wf_iseditable() = false then
		return 0
	end if
	if this.ib_itemslistopen then
		this.id_itemslist.hide()
		this.ib_itemslistopen = false
	end if
	if this.id_master.getitemnumber(this.id_master.getrow(), "sgcode") = this.id_master.getitemnumber(this.id_master.getrow(), "dgcode") then
		messagebox("Godown Validation", "Source and Target Godown must be different.~r~nCannot generate Transfer Items")
		return -1
	elseif isnull(this.id_master.getitemnumber(this.id_master.getrow(), "sgcode")) then
		messagebox("Source Godown Validation", "Please Select Valid Source Godown.")
		this.id_master.setcolumn("sgcode")
		this.id_master.setfocus()
		return -1
	elseif isnull(this.id_master.getitemnumber(this.id_master.getrow(), "dgcode")) then
		messagebox("Target Godown Validation", "Please Select Valid Target Godown.")
		this.id_master.setcolumn("dgcode")
		this.id_master.setfocus()
		return -1
	end if
	lds_tempdetail = create datastore
	lds_tempheader = create datastore
	open(w_editquotation_posted_form)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		destroy lds_tempdetail
		return -1
	end if
	setredraw(false)
	if this.id_detail.rowcount() > 0 then
		li_counter = 1
		this.id_detail.setrow(this.id_detail.rowcount())
		this.id_detail.scrolltorow(this.id_detail.rowcount())
		for li_counter = this.id_detail.rowcount() to 1 step -1
			event ue_deleteitem()
		next
	end if
	if lstr_template.c_copyinvfrom = "T" then
		if messagebox("Sale Price Confirmation", "Do you want to apply Sale Price from Quotation?", stopsign!, yesno!, 2) = 1 then
			lb_salepricefromtemplate = true
		end if
		lds_tempheader.dataobject = "d_quotationheader"
		lds_tempheader.settransobject(this.it_transobject)
		ll_totalrows = lds_tempheader.retrieve(lstr_template.l_invtemplate)
		if ll_totalrows <= 0 then
			messagebox("Quotation Retrieval", "Problem in Retrieving Quotation Header Information.", stopsign!)
			li_retcode = -1
		else
			li_loose_pack = lds_tempheader.object.loosepack[1]
			lds_tempdetail.dataobject = "d_quotationdetail"
			lds_tempdetail.settransobject(this.it_transobject)
			ll_totalrows = lds_tempdetail.retrieve(lstr_template.l_invtemplate)
			if ll_totalrows < 0 then
				messagebox("Quotation Retrieval", "Problem in Retrieving Quotation Details.", stopsign!)
				li_retcode = -1
			end if
			ll_totalrows = lds_tempdetail.rowcount()
		end if
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		if li_retcode <> -1 then
			for ll_rowcount = 1 to ll_totalrows
				if this.idc_itembatches.rowcount() <= 0 then
					this.idc_itembatches.insertrow(0)
				end if
				ll_newrow = this.id_detail.insertrow(0)
				wf_inititeminfo(lds_tempdetail.getitemnumber(ll_rowcount, "icode"), ll_newrow, li_errcode, ls_errortext)
				if li_loose_pack = 1 then
					ld_quot_qty = lds_tempdetail.object.looseqty[ll_rowcount] + lds_tempdetail.object.bonusqty[ll_rowcount]
				else
					ld_quot_qty = (lds_tempdetail.object.looseqty[ll_rowcount] + lds_tempdetail.object.bonusqty[ll_rowcount]) * this.id_detail.object.packunits[ll_newrow]
				end if
				this.id_detail.setitem(ll_newrow, "qty", ld_quot_qty)
				if lb_salepricefromtemplate = true then
					if lds_tempdetail.object.packunits[ll_rowcount] > 0 then
						this.id_detail.setitem(ll_newrow, "saleprice", lds_tempdetail.object.saleprice[ll_rowcount] / lds_tempdetail.object.packunits[ll_rowcount])
					else
						this.id_detail.setitem(ll_newrow, "saleprice", lds_tempdetail.object.saleprice[ll_rowcount])
					end if
				end if
			next
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	destroy lds_tempheader
	destroy lds_tempdetail
	if this.id_detail.rowcount() <= 0 then
		event ue_newitem()
	else
		this.im_menu.m_file.m_save.enabled = true
		lm_menu.m_file.m_saveandpost.enabled = true
		if this.id_detail.rowcount() > 1 then
			this.id_detail.setcolumn("qty")
			this.id_detail.scrolltorow(this.id_detail.rowcount())
			this.id_detail.setfocus()
		end if
	end if
	setredraw(true)
	return li_retcode

// w_transfer.wf_validateworkorder(long al_code) returns long
	long ll_code
	long ll_custcode
	SQL SELECT WorkOrderCode , CustCode INTO :ll_code, :ll_custcode FROM WorkOrder WHERE WorkOrderCode =:al_code AND Approved ='Y' AND Posted ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ll_code) or ll_code < 0 then
			return -1
		else
			return 0
		end if
		return
	end if
	return -1

// w_transfer.wf_validatebatch(long al_icode, string as_batch, integer ai_gcode, datetime adt_expiry) returns long
	string ls_batch
	SQL SELECT batch INTO :ls_batch FROM GodownDetail WHERE ICode =:al_icode AND GCode =:ai_gcode AND Batch =:as_batch AND Expiry =:adt_expiry USING sqlca;
	return sqlca.sqlcode

// w_transfer.wf_set_batchinfo(long al_gcode, long al_icode, string as_batch, datetime adt_expiry, double ad_qty, datawindow ad_itemsdetail, long al_rowscount, string as_errortext) returns long
	datastore lds_itemstockinfo
	long ll_counter
	long ll_detailrowcount
	double ld_saleqty
	double ld_reqqty
	double ld_totalstock
	double ld_batchqty
	boolean lb_flag
	integer li_errcode
	string ls_itemname
	lds_itemstockinfo = create datastore
	lds_itemstockinfo.dataobject = "d_itemstockinfo"
	lds_itemstockinfo.settransobject(this.it_transobject)
	if lds_itemstockinfo.retrieve(al_gcode, al_icode) > 0 then
		ld_totalstock = lds_itemstockinfo.getitemnumber(1, "c_totalstock")
		SQL SELECT ISNULL ( CurrQty , 0 ) , Name =ISNULL ( ( SELECT Name FROM Item WHERE Item.ICode =:al_icode ) , '' ) INTO :ld_batchqty, :ls_itemname FROM DBO.GodownDetail WHERE GCode =:al_gcode AND ICode =:al_icode AND Batch =:as_batch AND Expiry =:adt_expiry USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if ld_batchqty >= ad_qty then
				ll_detailrowcount = ad_itemsdetail.insertrow(0)
				ad_itemsdetail.setitem(ll_detailrowcount, "icode", al_icode)
				ad_itemsdetail.setitem(ll_detailrowcount, "batch", as_batch)
				ad_itemsdetail.setitem(ll_detailrowcount, "expiry", adt_expiry)
				ad_itemsdetail.setitem(ll_detailrowcount, "stock", ld_batchqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "totalstock", ld_totalstock)
				ad_itemsdetail.setitem(ll_detailrowcount, "qty", ad_qty)
				al_rowscount = 1
			else
				li_errcode = 1
				al_rowscount = ll_detailrowcount
				as_errortext = "Not Enogh Stock for this item~r~nItem Name = " + ls_itemname + "~r~nBatch = " + as_batch + "~r~nBatch Stock = " + trim(string(ld_batchqty, "#,###,###.0000")) + ", Required Qty = " + trim(string(ad_qty, "#,###,###.0000"))
			end if
		elseif this.it_transobject.sqlcode = 100 then
			SQL SELECT Name INTO :ls_itemname FROM Item WHERE ICode =:al_icode USING this.it_transobject;
			li_errcode = 1
			al_rowscount = ll_detailrowcount
			as_errortext = "Not Enogh Stock for this item~r~nItem Name = " + ls_itemname + "~r~nBatch = " + as_batch + "~r~nBatch Stock = " + trim(string(ld_batchqty, "#,###,###.0000")) + ", Required Qty = " + trim(string(ad_qty, "#,###,###.0000"))
		else
			li_errcode = 1
			al_rowscount = ld_totalstock
			as_errortext = "Database Problem: Details are:-~r~n" + this.it_transobject.sqlerrtext
		end if
	else
		li_errcode = 1
		al_rowscount = ld_totalstock
		as_errortext = "Stock does not exist for this item   "
	end if
	destroy lds_itemstockinfo
	return li_errcode

