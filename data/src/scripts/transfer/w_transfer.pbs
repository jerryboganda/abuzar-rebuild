// w_transfer.wf_post_transfer(integer ai_postingmode, long al_startinginvcode, long al_endinginvcode) returns boolean
	integer li_errcode
	integer li_icode
	integer ll_counter1
	integer li_sourcegodown
	integer li_packunits
	long ll_salesmancode
	long ll_saleinvcount
	long ll_headerno
	long ll_headerinvno
	long ll_mastercurrrow
	long ll_unpostedcount
	long ll_retcode
	unsignedlong ul_loopcounter
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	long ll_detailrows
	long ll_icode
	long ll_errrowid
	long ll_customeracc
	long ll_counter
	long ll_innercounter
	long ll_insertedrows
	long ll_itemsdetailrowcount
	long ll_row
	long ll_sgcode
	long ll_dgcode
	long al_errorrow
	long ll_tcode
	long ll_transferinvcount
	long ll_reorderqty
	long ll_optimumqty
	long ll_st
	long ll_et
	long ll_tcount
	long ll_unpostedrow
	long ll_unpostedcounter
	long ll_unpostrows
	long ll_rtcode
	boolean lb_commitflag = true
	boolean lb_unpostedflag
	string ls_batch
	string ls_updatesaleprice
	string ls_updsaleprice
	string ls_errortext
	string ls_itemdescription
	datetime ld_expiry
	double ld_avgprice
	double ld_saleprice
	double ld_purprice
	double ld_sourcestock
	double ld_targetstock
	double ld_itemcurrqty
	double ld_requiredqty
	double ld_packqty
	double ld_qty
	double ld_stock
	double ld_newstock
	dwitemstatus ldws_column
	datawindow ld_tdetail
	datawindowchild ldc_batch
	s_arguements lstr_arginfo
	datetime ldt_server_datetime
	string ls_date_errtext
	datastore lds_transferinfo
	long ll_rowcount
	lds_transferinfo = create datastore
	lds_transferinfo.dataobject = "d_transferinfo"
	lds_transferinfo.settransobject(this.it_transobject)
	ll_transferinvcount = 0
	ll_unpostedrow = 0
	li_errcode = 0
	ld_tdetail = this.dw_saleinvdetail
	ld_tdetail.settransobject(this.it_transobject)
	ll_rtcode = ld_tdetail.getchild("batch", ldc_batch)
	if ll_rtcode = -1 then
		return false
	end if
	ldc_batch.settransobject(this.it_transobject)
	ldc_batch.insertrow(0)
	if ai_postingmode = 1 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	setfocus()
	if ll_salesmancode > 0 then
		if ai_postingmode = 1 then
			open(w_arg_sinvcode_linvcode)
			lstr_arginfo = message.powerobjectparm
		else
			lstr_arginfo.l_code1 = al_startinginvcode
			lstr_arginfo.l_code2 = al_endinginvcode
			lstr_arginfo.i_status = 1
		end if
		ll_st = lstr_arginfo.l_code1
		ll_et = lstr_arginfo.l_code2
		lds_transferinfo.retrieve(ll_st, ll_et)
		ll_unpostrows = lds_transferinfo.rowcount()
		if lstr_arginfo.i_status = 1 then
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return false
			end if
			setpointer(hourglass!)
			li_errcode = wf_locktransferinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_saleinvcount)
			if li_errcode = 0 then
				for ll_tcount = ll_st to ll_et
					lb_unpostedflag = false
					for ll_unpostedcounter = 1 to ll_unpostrows
						if ll_tcount = lds_transferinfo.getitemnumber(ll_unpostedcounter, "Transcode") then
							lb_unpostedflag = true
							exit
						end if
					next
					if lb_unpostedflag then
						if this.idc_itembatches.rowcount() <= 0 then
							this.idc_itembatches.insertrow(0)
						end if
						this.id_detail.retrieve(ll_tcount)
						this.id_master.retrieve(ll_tcount)
						ll_tcode = this.id_master.getitemnumber(this.id_master.getrow(), "code")
						if wf_is_postable(ll_tcode) = true then
							ld_tdetail.retrieve(ll_tcount)
							for ll_rowcount = ld_tdetail.rowcount() to 1 step -1
								ld_tdetail.deleterow(ll_rowcount)
							next
							ll_detailrows = this.id_detail.rowcount()
							ll_counter = 1
							ll_itemsdetailrowcount = 0
							ls_errortext = "    Some database problem ocuurs         "
							ll_mastercurrrow = this.id_master.getrow()
							ll_sgcode = this.id_master.getitemnumber(ll_mastercurrrow, "sgcode")
							ll_dgcode = this.id_master.getitemnumber(ll_mastercurrrow, "dgcode")
							ll_tcode = this.id_master.getitemnumber(ll_mastercurrrow, "code")
							ll_headerno = this.id_master.getitemnumber(ll_mastercurrrow, "headerno")
							ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
							if isnull(ll_headerinvno) then
								f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
								if ll_headerinvno > 0 then
									this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
								end if
							end if
							this.id_master.setitem(ll_mastercurrrow, "posted", "Y")
							this.id_master.setitem(ll_mastercurrrow, "postedby", ll_salesmancode)
							this.id_master.setitem(ll_mastercurrrow, "postdate", ldt_server_datetime)
							do while ll_counter <= ll_detailrows and lb_commitflag
								ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
								ld_qty = this.id_detail.getitemnumber(ll_counter, "qty")
								ls_batch = this.id_detail.object.batch[ll_counter]
								ld_expiry = this.id_detail.object.expiry[ll_counter]
								this.it_transobject.getitemstocktotal(ll_sgcode, ll_icode, ld_sourcestock)
								this.it_transobject.getitemstocktotal(ll_dgcode, ll_icode, ld_targetstock)
								ll_reorderqty = this.id_detail.getitemnumber(ll_counter, "reorderqty")
								ll_optimumqty = this.id_detail.getitemnumber(ll_counter, "optimumqty")
								ld_requiredqty = this.id_detail.getitemnumber(ll_counter, "requiredqty")
								ld_packqty = this.id_detail.getitemnumber(ll_counter, "packqty")
								ls_itemdescription = this.id_detail.getitemstring(ll_counter, "itemdescription")
								ld_saleprice = this.id_detail.getitemnumber(ll_counter, "saleprice")
								this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
								SQL Select purprice , packunits INTO :ld_purprice, :li_packunits From Item Where Icode =:ll_icode USING this.it_transobject;
								if this.it_transobject.sqlcode <> 0 then
									lb_commitflag = false
								end if
								if ld_qty > 0.0 and lb_commitflag then
									if f_stringpreferences("AllowBatchWiseTrasnfer") = "N" then
										ll_retcode = wf_selectitembatches(ll_sgcode, ll_icode, ld_qty, ld_tdetail, ll_insertedrows, ls_errortext)
									else
										ll_retcode = wf_set_batchinfo(ll_sgcode, ll_icode, ls_batch, ld_expiry, ld_qty, ld_tdetail, ll_insertedrows, ls_errortext)
									end if
									if ll_retcode = 0 then
										for ll_innercounter = 1 to ll_insertedrows
											ll_row = ll_itemsdetailrowcount + ll_innercounter
											ld_tdetail.setitem(ll_row, "code", ll_tcode)
											ld_tdetail.setitem(ll_row, "itemname", "asif")
											ld_tdetail.setitem(ll_row, "avgprice", ld_avgprice)
											ld_tdetail.setitem(ll_row, "saleprice", ld_saleprice)
											ld_tdetail.setitem(ll_row, "purprice", ld_purprice)
											ld_tdetail.setitem(ll_row, "packunits", li_packunits)
											ld_tdetail.setitem(ll_row, "sourcestk", ld_sourcestock)
											ld_tdetail.setitem(ll_row, "targetstk", ld_targetstock)
											ld_tdetail.setitem(ll_row, "reorderqty", ll_reorderqty)
											ld_tdetail.setitem(ll_row, "optimumqty", ll_optimumqty)
											ld_tdetail.setitem(ll_row, "requiredqty", ld_requiredqty)
											ld_tdetail.setitem(ll_row, "packqty", ld_packqty)
											ld_tdetail.setitem(ll_row, "rowgroup", ll_counter)
											ld_tdetail.setitem(ll_row, "itemdescription", ls_itemdescription)
											ls_batch = ld_tdetail.getitemstring(ll_row, "batch")
											ld_expiry = ld_tdetail.getitemdatetime(ll_row, "expiry")
											ld_stock = ld_tdetail.getitemnumber(ll_row, "stock")
											ld_qty = ld_tdetail.getitemnumber(ll_row, "Qty")
											ld_newstock = ld_stock - ld_qty
											if ld_newstock > 0.0 then
												this.it_transobject.saleupdateitemstockbatch(ll_sgcode, ll_icode, ls_batch, ld_expiry, ld_newstock, ld_stock)
											else
												this.it_transobject.deleteitemstockbatch(ll_sgcode, ll_icode, ls_batch, ld_expiry, ld_stock)
											end if
											if this.it_transobject.sqlcode <> 0 then
												lb_commitflag = false
												ls_errortext = "Stock Updation Error In Source Godown:~r~n" + this.it_transobject.sqlerrtext
											end if
											this.it_transobject.updategodowndetail(ll_dgcode, ll_icode, ls_batch, ld_expiry, ld_qty)
											if this.it_transobject.sqlcode <> 0 then
												lb_commitflag = false
												ls_errortext = "Stock Updation Error In Target Godown:~r~n" + this.it_transobject.sqlerrtext
											end if
										next
										ll_itemsdetailrowcount = ll_itemsdetailrowcount + ll_insertedrows
									else
										this.id_detail.setitem(ll_counter, "stock", ll_insertedrows)
										lb_commitflag = false
									end if
								else
									lb_commitflag = false
								end if
								ll_counter = ll_counter + 1
							loop
							if lb_commitflag then
								ll_transferinvcount = ll_transferinvcount + 1
								ul_rowcount = ld_tdetail.rowcount()
								SQL rollback USING sqlca;
								sqlca.getmaxutn(ul_rowcount, ul_maxutn)
								if sqlca.sqlcode = 0 then
									SQL commit USING sqlca;
									for ul_loopcounter = 1 to ul_rowcount
										ld_tdetail.setitem(ul_loopcounter, "transferutn", ul_maxutn)
										ul_maxutn = ul_maxutn + 1
									next
								else
									SQL rollback USING sqlca;
									messagebox("POSTING", "Posting fail due to error in generating Utn")
									lb_commitflag = false
								end if
							else
								ll_unpostedrow = ll_unpostedrow - 1
							end if
							if lb_commitflag then
								if this.id_master.update() > 0 then
									if ld_tdetail.update() > 0 then
										SQL commit USING this.it_transobject;
									else
										lb_commitflag = false
										SQL rollback USING this.it_transobject;
									end if
								else
									SQL rollback USING this.it_transobject;
									lb_commitflag = false
								end if
							else
								SQL rollback USING this.it_transobject;
								lb_commitflag = false
							end if
						else
							messagebox("Transfer Posting Rights Validation", "Not Enough Godown Permissions Available for posting~r~n" + "You can not post this transfer document.~r~n~r~n" + "Details are as follows:-~r~n" + "Target Godown of this transfer document is not allowed to you as a Valid Source Godown.~r~n" + "Transfer Document Code = " + trim(string(ll_tcode)) + " will remain unposted.~r~n~r~n" + "Please Consult Your Administrator to do the needfull", stopsign!)
							ll_unpostedcount = ll_unpostedcount + 1
						end if
					end if
				next
			end if
		else
			lb_commitflag = false
		end if
	end if
	if not lb_commitflag then
		SQL rollback USING this.it_transobject;
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if not lb_commitflag then
			messagebox("Posting Fails", "Some database request fails, Kindly try again.~r~n" + ls_errortext)
		else
			messagebox("Posting Report", "Total Transfer Document(s) were " + string(ll_saleinvcount) + "~n~rUnposted Rows = " + trim(string(ll_unpostedcount)) + "~r~nSuccessfully Posted = " + trim(string(ll_saleinvcount - ll_unpostedcount)))
		end if
	end if
	destroy lds_transferinfo
	return lb_commitflag

// w_transfer.wf_post() returns boolean
	integer li_postingmode = 1
	long ll_sinvcode
	long ll_linvcode
	setnull(ll_sinvcode)
	setnull(ll_linvcode)
	return wf_post_transfer(li_postingmode, ll_sinvcode, ll_linvcode)

// w_transfer.wf_saveandpost() returns 0
	integer li_postingmode = 2
	long ll_sinvcode
	long ll_linvcode
	boolean lb_commitflag = true
	event ue_save()
	if this.ib_commitok then
		ll_sinvcode = this.id_master.getitemnumber(1, "code")
		ll_linvcode = this.id_master.getitemnumber(1, "code")
		if isnull(ll_sinvcode) or isnull(ll_linvcode) or ll_sinvcode < 0 and ll_linvcode < 0 then
			return
		else
			lb_commitflag = wf_post_transfer(li_postingmode, ll_sinvcode, ll_linvcode)
		end if
	end if
	setpointer(arrow!)

// w_transfer.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_transfer" then
		this.menuid = create m_transfer
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	this.dw_saleinvdetail = create dw_saleinvdetail
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.dw_saleinvdetail

// w_transfer.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.dw_saleinvdetail

// w_transfer.ue_save() returns 0 [event]
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_counter
	long ll_invid
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode = 1
	long ll_gcode
	long ll_currentrow
	long ll_rowcount
	long ll_found
	boolean lb_commitflag = true
	boolean lb_continue = true
	boolean lb_found
	integer li_counter = 1
	integer li_sourcegodown
	integer li_ttype
	string ls_errtext
	double ld_rate
	double ld_packcapacity
	double ld_areavolume
	double ld_purprice
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_itemcurrqty
	datetime ldt_server_datetime
	string ls_date_errtext
	s_datastore lstr_arg
	datastore lds_items
	lds_items = create datastore
	lds_items.dataobject = "d_item_transferqty"
	lds_items.settransobject(this.it_transobject)
	lds_items.reset()
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	if this.id_detail.rowcount() = 0 then
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Validation", ls_date_errtext, stopsign!)
		return
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 1 and f_stringpreferences("AllowBatchWiseTrasnfer") = "Y" then
		for ll_counter = 1 to ll_detailrows
			ll_found = 0
			if ll_counter = ll_detailrows then
				exit
			end if
			ll_found = this.id_detail.find(" icode = long('" + string(this.id_detail.getitemnumber(ll_counter, "icode")) + "') and batch = '" + this.id_detail.getitemstring(ll_counter, "batch") + "' and expiry = Date('" + string(this.id_detail.getitemdatetime(ll_counter, "expiry"), "yyyy-mm-dd") + "')", ll_counter + 1, ll_detailrows)
			if ll_found > 0 then
				messagebox("Item Validation", "Duplicate items found at row " + string(ll_counter) + " and " + string(ll_found) + "." + "~r~nSuggested options are either delete the row or ~r~n" + "change Item batch")
				this.id_detail.scrolltorow(ll_counter)
				this.id_detail.setcolumn("qty")
				this.id_detail.setfocus()
				return
			end if
		next
	end if
	if not this.ib_modifydate then
		if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			return
		end if
		this.id_master.setitem(1, "Date", ldt_server_datetime)
		this.id_master.setitem(1, "PostDate", ldt_server_datetime)
	else
		ldt_server_datetime = this.id_master.getitemdatetime(1, "date")
		this.id_master.setitem(1, "date", ldt_server_datetime)
		this.id_master.setitem(1, "Postdate", ldt_server_datetime)
	end if
	li_sourcegodown = this.id_master.getitemnumber(1, "sgcode")
	li_ttype = this.id_master.getitemnumber(this.id_master.getrow(), "ttcode")
	if li_ttype = 1 or li_ttype = 2 then
		for li_counter = 1 to this.id_detail.rowcount()
			ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
			SQL SELECT SUM ( currqty ) INTO :ld_itemcurrqty FROM godowndetaiL WHERE godowndetail.icode =:ll_icode AND godowndetail.gcode =:li_sourcegodown USING this.it_transobject;
			if this.it_transobject.sqlcode = -1 then
				messagebox("Stock Validation", "Stock for the item in row " + string(li_counter) + " in source godown does not exist.")
			else
				if isnull(ld_itemcurrqty) then
					ld_itemcurrqty = 0
				end if
				if this.id_detail.getitemnumber(li_counter, "qty") > ld_itemcurrqty then
					if not this.ib_allowinsufficientstockitems then
						messagebox("Item Stock Validation", "Qty exceed than Stock in source godown.")
						this.id_detail.setitem(li_counter, "qty", ld_itemcurrqty)
						ld_areavolume = this.id_detail.object.areavolume[li_counter]
						ld_packcapacity = this.id_detail.object.packcapacity[li_counter]
						if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
							ld_areavolume = 1
						end if
						if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
							ld_packcapacity = 1
						end if
						this.id_detail.setitem(li_counter, "pcs", round(ld_itemcurrqty / ld_areavolume, 5))
						this.id_detail.setitem(li_counter, "cartons", trim(string(long(this.id_detail.object.pcs[li_counter] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(this.id_detail.object.pcs[li_counter] mod ld_packcapacity, 2))))))
						this.id_detail.setfocus()
						this.id_detail.setrow(li_counter)
						this.id_detail.setcolumn("qty")
						return
					end if
					return
				end if
			end if
		next
	end if
	if f_stringpreferences("ForcePCSInInterAtSalesSaving") = "Y" then
		for ll_counter = 1 to this.id_detail.rowcount()
			if this.id_detail.object.pcs[ll_counter] <> long(this.id_detail.object.pcs[ll_counter]) then
				messagebox("PCS Validation", "Please enter some valid PCS. It Should be some valid integer value", stopsign!)
				this.id_detail.setrow(ll_counter)
				this.id_detail.setfocus()
				this.id_detail.setcolumn("PCS")
				return
			end if
		next
	end if
	ll_counter = 0
	for li_counter = 1 to this.id_detail.rowcount()
		if this.id_detail.getitemnumber(li_counter, "qty") = 0.0 then
			if not this.ib_allowinsufficientstockitems then
				lb_found = true
				ll_currentrow = lds_items.insertrow(0)
				lds_items.setitem(ll_currentrow, "source", this.idc_godown.getitemstring(this.idc_godown.getrow(), "name"))
				lds_items.setitem(ll_currentrow, "target", this.idc_targetgodown.getitemstring(this.idc_targetgodown.getrow(), "name"))
				lds_items.setitem(ll_currentrow, "icode", this.id_detail.getitemnumber(li_counter, "icode"))
				lds_items.setitem(ll_currentrow, "aliasname", this.id_detail.getitemstring(li_counter, "fullcode"))
				lds_items.setitem(ll_currentrow, "itemname", this.id_detail.getitemstring(li_counter, "itemname"))
				lds_items.setitem(ll_currentrow, "sourcestk", this.id_detail.getitemnumber(li_counter, "sourcestk"))
				lds_items.setitem(ll_currentrow, "targetstk", this.id_detail.getitemnumber(li_counter, "targetstk"))
				lds_items.setitem(ll_currentrow, "requiredqty", this.id_detail.getitemnumber(li_counter, "requiredqty"))
			end if
		end if
	next
	if lb_found then
		lstr_arg.ds = lds_items
		openwithparm(w_transfer_itemlist, lstr_arg)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_closemode < 1 then
			return
		end if
		return
	end if
	li_counter = 1
	ll_detailrows = this.id_detail.rowcount()
	ll_rowcount = this.id_detail.rowcount()
	for li_counter = ll_rowcount to 1 step -1
		if this.id_detail.getitemnumber(li_counter, "qty") = 0.0 then
			this.id_detail.deleterow(li_counter)
		end if
	next
	if this.id_detail.rowcount() < 1 then
		messagebox("Row Validation", "There are no rows to save.~r~nKindly insert some rows.")
		return
	end if
	if f_stringpreferences("AskUserPwdOnsavingInTransfer") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			return
		end if
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if isnull(ll_invid) then
			f_newtableid("theader", ll_invid)
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
		end if
		this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
		li_counter = 1
		ll_detailrows = this.id_detail.rowcount()
		do while li_counter <= ll_detailrows
			ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
			SQL Select saleprice , purprice , avgprice INTO :ld_saleprice, :ld_purprice, :ld_avgprice From Item Where icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("Fetch Error", "Unable to fetch prices from item basic data")
				setpointer(arrow!)
				setfocus()
				return
			end if
			this.id_detail.setitem(li_counter, "code", ll_invid)
			if f_stringpreferences("AllowBatchWiseTrasnfer") = "N" then
				this.id_detail.setitem(li_counter, "batch", "?")
				this.id_detail.setitem(li_counter, "expiry", date("12/12/2010"))
			end if
			this.id_detail.setitem(li_counter, "purprice", ld_purprice)
			this.id_detail.setitem(li_counter, "avgprice", ld_avgprice)
			this.id_detail.setitem(li_counter, "rowgroup", li_counter)
			li_counter = li_counter + 1
		loop
		call super::ue_save
		if this.ib_commitok and f_stringpreferences("IncTransferInActMonitor") = "Y" then
			this.it_transobject.updateactivitymonitor("GT", ll_invid)
			if this.it_transobject.sqlcode <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
			else
				SQL commit USING this.it_transobject;
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_transfer.ue_newform() returns 0 [event]
	integer rtncode
	long li_fetched_code
	long row
	long ll_manfcode
	long ll_found
	m_transfer lm_menu
	datetime ldt_server_datetime
	string ls_date_errtext
	call super::ue_newform
	lm_menu = this.menuid
	if this.idc_itembatches.rowcount() <= 0 then
		this.idc_itembatches.insertrow(0)
	end if
	setredraw(false)
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 732", 1, gds_securitywindow.rowcount())
	if ll_found > 0 and this.id_master.object.posted[1] = "N" then
		lm_menu.m_file.m_saveandpost.enabled = true
	else
		lm_menu.m_file.m_saveandpost.enabled = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5158", 1, gds_securitywindow.rowcount())
	if ll_found > 0 and this.id_master.object.posted[1] = "N" then
		lm_menu.m_file.m_usecustomerassociatedgodownastarget.visible = true
	else
		lm_menu.m_file.m_usecustomerassociatedgodownastarget.visible = false
	end if
	lm_menu.m_file.m_open.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_print.visible = true
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.ib_modify = false
	wf_setgodownoption()
	if this.ii_transfergodown = 2 then
	end if
	this.id_footer.setitem(1, "invdiscperc", f_numberpreferences("invdiscperc"))
	if not wf_validatedate() then
		close(this)
	else
		this.id_master.setcolumn(1)
		this.id_master.setfocus()
		wf_visible(true)
		if this.ib_modifydate then
			if this.ib_fetchserverdate then
				wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
				this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
			else
				this.id_master.setitem(this.id_master.getrow(), "date", today())
			end if
		end if
		setredraw(true)
	end if
	wf_settransfertype(this.id_master.getitemnumber(this.id_master.getrow(), "ttcode"))
	post event ue_enforcedefaultfocussettings()

// w_transfer.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect = 1
	long ll_row
	long ll_code
	long ll_found
	long ll_rowcount
	boolean lb_flag
	boolean lb_
	m_transfer lm_menu
	lm_menu = this.menuid
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.im_menu.m_file.m_print.enabled = true
	this.i_editmode = 2
	this.i_retrievemode = 2
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	this.id_dwcontrol = this.id_master
	ll_rowcount = wf_retrieve(ll_code)
	this.id_master.setrow(1)
	this.id_master.scrolltorow(1)
	this.id_dwcontrol = this.id_footer
	wf_retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	this.id_dwcontrol = this.id_detail
	this.idc_itembatches.settransobject(this.it_transobject)
	if this.idc_itembatches.rowcount() <= 0 then
		this.idc_itembatches.insertrow(0)
	end if
	wf_retrieve(ll_code)
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	this.id_dwcontrol = this.id_list
	ll_code = this.id_master.getitemnumber(this.id_master.getrow(), "code")
	if wf_allowtransfermodification(ll_code, this.il_groupcode, this.il_strategy) <> 0 then
		if this.idc_itembatches.rowcount() <= 0 then
			this.idc_itembatches.insertrow(0)
		end if
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "You Can not modify this Invoice,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if this.id_master.getitemnumber(this.id_master.getrow(), "sgcode") <> this.ii_currsourcegodown and this.id_master.getitemstring(this.id_master.getrow(), "Posted") <> "Y" then
		wf_fetchitemlist(this.id_master.getitemnumber(this.id_master.getrow(), "sgcode"))
	end if
	setredraw(false)
	this.im_menu.m_file.m_retrieve.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.tab_retrieve.tabpage_detail.enabled = true
	if this.id_master.getitemstring(this.id_master.getrow(), "posted") = "N" then
		li_protect = 0
		this.ib_modify = true
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_item.m_newitem.enabled = true
		this.im_menu.m_item.m_deleteitem.enabled = true
		this.im_menu.m_file.m_first.enabled = false
		this.im_menu.m_file.m_next.enabled = false
		this.im_menu.m_file.m_previous.enabled = false
		this.im_menu.m_file.m_last.enabled = false
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") <> "Y" then
		wf_settransfertype(this.id_master.getitemnumber(this.id_master.getrow(), "ttcode"))
		lm_menu.m_file.m_open.enabled = true
	else
		lm_menu.m_file.m_open.enabled = false
		lm_menu.m_file.m_generate.enabled = false
		lm_menu.m_file.m_generategodownwise.enabled = false
		lm_menu.m_file.m_generateconsumptionwise.enabled = false
		lm_menu.m_file.m_generatesourcegodownstockbasedtransfer.enabled = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 732", 1, gds_securitywindow.rowcount())
	if ll_found > 0 and this.id_master.object.posted[1] = "N" then
		lm_menu.m_file.m_saveandpost.enabled = true
	else
		lm_menu.m_file.m_saveandpost.enabled = false
	end if
	this.im_menu.m_file.m_post.enabled = false
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	wf_grandtotal()
	setredraw(true)

// w_transfer.ue_newitem() returns 0 [event]
	long ll_sgcode
	long ll_rowcount
	if this.idc_itembatches.rowcount() <= 0 then
		this.idc_itembatches.insertrow(0)
	end if
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_master.rowcount() > 0 then
		ll_sgcode = this.id_master.object.sgcode[1]
	else
		ll_sgcode = 1
	end if
	if this.id_detail.rowcount() > 1 and vf_dwdupitembatch(this.id_detail, "icode", this.id_detail.getitemnumber(this.id_detail.getrow(), "icode"), "batch", this.id_detail.getitemstring(this.id_detail.getrow(), "batch"), "expiry", this.id_detail.getitemdatetime(this.id_detail.getrow(), "expiry"), this.il_currrow) = true then
		messagebox("Item Validation", "Duplicate item, please select some other item")
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_transfer.ue_deleteitem() returns 0 [event]
	long ll_row
	call super::ue_deleteitem
	ll_row = this.id_detail.getrow()
	if this.id_detail.rowcount() > 0 then
		this.id_footer.setitem(this.id_footer.getrow(), "icode", this.id_detail.getitemnumber(ll_row, "icode"))
		this.id_footer.setitem(this.id_footer.getrow(), "stock", this.id_detail.getitemnumber(ll_row, "stock"))
	else
		this.id_footer.setitem(this.id_footer.getrow(), "icode", 0)
		this.id_footer.setitem(this.id_footer.getrow(), "stock", 0)
		this.im_menu.m_file.m_print.enabled = false
		this.im_menu.m_file.m_save.enabled = false
	end if
	if this.id_detail.rowcount() = 0 then
		this.id_itemslist.hide()
	end if

// w_transfer.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	return ::message.returnvalue

// w_transfer.ue_list() returns 0 [event]
	long ll_found
	m_transfer lm_menu
	call super::ue_list
	lm_menu = this.menuid
	SQL rollback USING this.it_transobject;
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 732", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.im_menu.m_file.m_post.enabled = true
	else
		this.im_menu.m_file.m_post.enabled = false
	end if
	lm_menu.m_file.m_saveandpost.enabled = false
	this.im_menu.m_file.m_print.enabled = false
	lm_menu.m_file.m_open.enabled = false
	this.ib_modify = false
	post event ue_enableprint()

// w_transfer.ue_print() returns 0 [event]
	long ll_custcode
	long ll_row
	long ll_invcode
	string ls_custname
	string ls_report
	integer li_option
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				if f_stringpreferences("TransferAutoPosting") = "Y" then
					wf_saveandpost()
				else
					triggerevent("ue_save")
				end if
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			if f_stringpreferences("TransferAutoPosting") = "Y" then
				wf_saveandpost()
			else
				triggerevent("ue_save")
			end if
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if gs_company = "ALNASEEB" then
		ls_report = "d_alnaseeb_transferinvreport_full"
	elseif gs_company = "ALNASEEB2" then
		ls_report = "d_alnaseeb2_transferinvreport_full"
	elseif gs_company = "ALHARMAINLIGHTS" then
		ls_report = "d_alharmainlights_transferinvreport_full"
	elseif gs_company = "MARSHAL" then
		ls_report = "d_marshal_transferinvreport"
	elseif gs_company = "AGHASUPERMARK" or gs_company = "FARIDS" then
		ls_report = "d_quart_transferinvreport"
	elseif gs_company = "ZAFARTRACTOR" then
		ls_report = "d_zafartractor_transferinvreport"
	elseif gs_company = "ALKAUSAR" then
		ls_report = "d_alkausar_transferinvreport"
	elseif gs_company = "PIC" then
		ls_report = "d_pic_transferinvreport"
	elseif gs_company = "WAQASAUTO" then
		ls_report = "d_waqasauto_transferinvreport"
	elseif gs_company = "SHE" then
		ls_report = "d_shee_transferinvreport"
	elseif gs_company = "PAKPUNJABTRADER" then
		ls_report = "d_pakpunjabtrader_transferinvreport_half"
	elseif gs_company = "SUNSTARTSTORE" then
		ls_report = "d_sunstarstore_transferinvreport"
	elseif gs_company = "MIANELECTRONICS" or gs_company = "MIANELECTRONIC2" or gs_company = "SAMICORPORATION" then
		ls_report = "d_mianelectronics_transferinvreport_half"
	elseif gs_company = "TM" then
		ls_report = "d_tm_transferinvreport"
	elseif gs_company = "BAJWATRADERS" then
		ls_report = "d_bajwatraders_transferinvreport_half"
	elseif gs_company = "RAD" then
		ls_report = "d_rad_transferinvreport_full"
	elseif gs_company = "SEICO2010" then
		ls_report = "d_seico2010_transferinvreport_full"
	elseif gs_company = "HUMAYUN" then
		ls_report = "d_humayun_transferinvreport_half"
	elseif gs_company = "VERIZON" then
		ls_report = "d_verizon_transferinvreport_full"
	elseif gs_company = "BISMILLAHSTORE" then
		ls_report = "d_bismillahstore_transferinvreport_full"
	elseif gs_company = "SAARAMDIST" then
		ls_report = "d_saaramdist_transferinvreport_full"
	elseif gs_company = "QUALITYMEDICAL" then
		ls_report = "d_qualitymedical_transferinvreport_full"
	elseif gs_company = "BESTWAYSUPPLY" then
		ls_report = "d_bestwaysupply_transferinvreport_full"
	elseif gs_company = "MARDANPLASTIC" then
		ls_report = "d_mardanplastic_transferinvreport"
	elseif gs_company = "MARDANKS" then
		ls_report = "d_mardanks_transferinvreport"
	elseif gs_company = "MAWF" then
		ls_report = "d_mawf_transferinvreport_full"
	elseif gs_company = "GREENPLUS17" then
		ls_report = "d_greenplus17_transferinvreport_full"
	elseif gs_company = "SHAHIDERA" then
		ls_report = "d_shahidera_transferinvreport_t"
	elseif gs_company = "PWMPHARMACY" then
		ls_report = "d_pwmpharmacy_transferinvreport_full"
	elseif gs_company = "BESTWAYSURGICAL" then
		ls_report = "d_bestwaysurgical_transferinvreport_t"
	elseif gs_company = "MEDLABSERVICE" then
		ls_report = "d_medlabservices_transferinvreport_full"
	elseif gs_company = "MSTRADERS" then
		ls_report = "d_mstraders_transferinvreport_full"
	elseif gs_company = "ASIFTRADERS" then
		ls_report = "d_asiftraders_transferinvreport_t"
	elseif gs_company = "HEARTCARESYS" then
		ls_report = "d_heartcaresys_transferinvreport_full"
	elseif gs_company = "MUKHTARKS" then
		ls_report = "d_mukhtarks_transferinvreport_t"
	elseif gs_company = "HOMELANDMART" then
		ls_report = "d_homelandmart_transferinvreport_full"
	elseif gs_company = "SKYMEDAGENCIES" then
		ls_report = "d_skymedagencies_transferinvreport_f"
	elseif gs_company = "MUSHTAQPHARMACY" then
		ls_report = "d_mushtaqpharmacy_transferinvreport_full"
	elseif gs_company = "THECUREMDC" then
		ls_report = "d_thecuremdc_transferinvreport_full"
	end if
	if ls_report = "" or isnull(ls_report) then
		ls_report = wf_selectprintreport()
	end if
	this.id_print.dataobject = ls_report
	this.id_print.settransobject(this.it_transobject)
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("saleaskforcopies") = "Y" then
		open(w_printer_copies)
		this.id_print.object.datawindow.print.copies = string(message.doubleparm)
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_transfer.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	wf_fetchitemlist(this.id_master.object.sgcode[1])
	if this.ii_saletype <> 3 then
		setpointer(hourglass!)
		this.idc_customers.setredraw(false)
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.retrieve()
		this.idc_customers.setredraw(true)
		setpointer(arrow!)
	end if

// w_transfer.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_transfer.ue_postopen() returns 0 [event]
	datawindowchild ldc_dddsalecategory
	datawindowchild ldc_headerno
	long ll_counter
	long ll_found
	long ll_targetgodowncount
	integer li_rtncode
	integer li_openparm
	m_transfer lm_menu
	datastore lds_headers
	call super::ue_postopen
	lm_menu = this.menuid
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	setredraw(false)
	this.id_print = this.dw_saleinvrep
	li_openparm = message.doubleparm
	if li_openparm = 2 then
		this.title = "Passport Transfers"
		this.im_menu.m_window.m_refreshcatwise.visible = false
		this.im_menu.m_window.m_refreshcustomize.visible = false
		this.im_menu.m_window.m_refreshdrilldownfilter.visible = false
		this.im_menu.m_window.m_refreshfilterstockitemsonly.visible = false
		this.im_menu.m_window.m_refreshitemnamefilter.visible = false
	end if
	this.ids_sourcegodownitems = create datastore
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		this.ids_sourcegodownitems.dataobject = "ddd_sourcegodownitems_cat"
	else
		this.ids_sourcegodownitems.dataobject = "ddd_sourcegodownitems"
	end if
	this.ids_sourcegodownitems.settransobject(sqlca)
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Source Godown Settings do not permit to Make Transfer(s)")
		close(this)
		return
	end if
	li_rtncode = this.id_master.getchild("sgcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to Make Transfer")
		close(this)
		return
	end if
	ll_targetgodowncount = f_groupallowedgodowncount(13, this.il_groupcode)
	if isnull(this.il_strategy) or this.il_strategy = 1 and ll_targetgodowncount = 0 then
		messagebox("Error", "Your Target Godown Settings do not permit to Make Transfer(s)")
		close(this)
		return
	end if
	li_rtncode = this.id_master.getchild("dgcode", this.idc_targetgodown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild for target godown")
		close(this)
		return
	end if
	this.idc_targetgodown.settransobject(this.it_transobject)
	li_rtncode = this.idc_targetgodown.retrieve(this.il_groupcode, 13, this.il_strategy)
	this.ii_transfergodown = this.idc_godown.getitemnumber(1, "gcode")
	this.id_master.object.sgcode.initial = string(this.ii_transfergodown)
	if this.idc_targetgodown.rowcount() > 0 then
		if this.idc_targetgodown.getitemnumber(1, "gcode") <> this.ii_transfergodown then
			this.id_master.object.dgcode.initial = string(this.idc_targetgodown.getitemnumber(1, "gcode"))
		elseif this.idc_targetgodown.rowcount() > 1 then
			this.id_master.object.dgcode.initial = string(this.idc_targetgodown.getitemnumber(2, "gcode"))
		else
			this.id_master.object.dgcode.initial = string(this.idc_targetgodown.getitemnumber(this.idc_targetgodown.rowcount(), "gcode"))
		end if
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_footer.object.t_totalstock.visible = false
		this.id_footer.object.totalstock.visible = false
	end if
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Transfer")
		close(this)
		return
	end if
	if f_stringpreferences("headerontransferinv") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.headerno_t.visible = false
	end if
	if f_stringpreferences("ShowSalePersonInTransfer") = "N" then
		this.id_master.object.smancode.visible = false
		this.id_master.object.smancode_t.visible = false
	end if
	this.id_master.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to lds_headers.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
		ldc_headerno.setitem(ll_counter, "name", "")
		ll_found = 0
		ll_found = gds_reoprtheaderinfo.find("headerno=" + string(lds_headers.getitemnumber(ll_counter, "headercode")), 1, gds_reoprtheaderinfo.rowcount())
		if ll_found > 0 then
			ldc_headerno.setitem(ll_counter, "headeralias", gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks"))
		end if
	next
	this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
	this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
	li_rtncode = this.id_detail.getchild("batch", this.idc_itembatches)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
	end if
	this.idc_itembatches.settransobject(this.it_transobject)
	this.idc_itembatches.insertrow(0)
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.stock.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	if f_stringpreferences("alternatecustomicodeintransfer") = "N" then
		this.id_detail.object.alternatecustomicode.visible = false
	end if
	if f_stringpreferences("AllowBatchWiseTrasnfer") = "N" then
		this.id_detail.object.batch.visible = false
		this.id_detail.object.expiry.visible = false
		this.id_detail.object.batch.initial = "."
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	if f_stringpreferences("packingdescintrasnfer") = "N" then
		this.id_detail.object.packingdesc.visible = false
	end if
	wf_fetchitemlist(this.ii_transfergodown)
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	if f_stringpreferences("ShowQtyInTransfer") = "Y" then
		this.ib_showqty = true
	else
		this.ib_showqty = false
	end if
	if f_stringpreferences("ShowPackQtyInTransfer") = "Y" then
		this.ib_showpackqtytotransfer = true
	else
		this.ib_showpackqtytotransfer = false
	end if
	if f_stringpreferences("AllowInsufficientStockItemsInTransfer") = "Y" then
		this.ib_allowinsufficientstockitems = true
	else
		this.ib_allowinsufficientstockitems = false
	end if
	wf_settransfertype(1)
	this.id_master.object.startdate.initial = string(today())
	this.im_menu.m_file.m_post.enabled = false
	f_setcolumnstyle(this.id_detail, "Qty")
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 698", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.date.protect = 0
		this.id_master.object.date.background.color = rgb(255, 255, 255)
		this.ib_modifydate = true
		lm_menu.m_file.m_setserverdate.visible = true
		lm_menu.m_file.m_setserverdate.enabled = true
	end if
	if f_rightexists(5062) then
		lm_menu.m_file.m_showitemtransferhistory.visible = true
		lm_menu.m_file.m_showitemtransferhistory.enabled = true
	else
		lm_menu.m_file.m_showitemtransferhistory.visible = false
		lm_menu.m_file.m_showitemtransferhistory.enabled = false
	end if
	if not this.ib_modifydate then
		this.id_master.object.date.protect = 1
		this.id_master.settaborder("date", 0)
		lm_menu.m_file.m_setserverdate.visible = false
		lm_menu.m_file.m_setserverdate.enabled = false
	end if
	setredraw(true)

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	return ::message.returnvalue

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
	case "flatdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	end choose
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_code
	long ll_detailrows
	long ll_suppcode
	long ll_icode
	integer rt_code
	integer li_option
	string ls_result
	string ls_null
	long ll_null
	datetime ld_currdate
	date ld_datepart
	time lt_timepart
	boolean lb_godownflag
	long ll_newgcode
	long ll_storedgcode
	long ll_row
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "transreqcode"
		return parent.parent.parent.wf_populate_transferrequisition(long(data))
	case "date"
		if isdate(left(data, 10)) then
			ld_datepart = date(left(data, 10))
			if istime(mid(data, 12, 8)) then
				lt_timepart = time(mid(data, 12, 8))
				ld_currdate = datetime(ld_datepart, lt_timepart)
				if ld_currdate < parent.parent.parent.id_systemdate then
					rt_code = 1
				end if
			else
				rt_code = 1
			end if
		else
			rt_code = 1
		end if
	case "custcode"
		if not isnull(data) and parent.parent.parent.ii_saletype = 1 then
			ll_code = long(data)
			parent.setredraw(false)
			if parent.parent.parent.wf_customerinfo(ll_code) <> 0 then
				messagebox("Database Error", "Can not retrieve information from database")
			end if
			parent.setredraw(true)
		end if
	case "salecatcode"
		if integer(data) = 1 then
			setnull(ls_null)
			setitem(row, "custcode", 22)
			parent.parent.parent.id_master.object.address[row] = ls_null
			parent.parent.parent.id_master.object.city[row] = ls_null
			parent.parent.parent.id_master.object.phone[row] = ls_null
		end if
	case "sgcode"
		parent.parent.parent.is_columngodownname = "sgcode"
		ll_newgcode = long(data)
		ll_storedgcode = getitemnumber(row, "sgcode")
		if ll_newgcode <> ll_storedgcode then
			lb_godownflag = true
			rt_code = parent.parent.parent.wf_cleanupdetailrows()
			if rt_code = 0 then
				parent.parent.parent.wf_fetchitemlist(ll_newgcode)
			end if
		end if
		parent.parent.parent.ib_godownvalidated = false
	case "dgcode"
		parent.parent.parent.is_columngodownname = "dgcode"
		parent.parent.parent.ib_godownvalidated = false
		ll_newgcode = long(data)
		ll_storedgcode = getitemnumber(row, "dgcode")
		if ll_newgcode <> ll_storedgcode then
			lb_godownflag = true
		end if
	case "ttcode"
		if parent.parent.parent.id_detail.rowcount() > 0 and not isnull(parent.parent.parent.id_detail.getitemnumber(1, "icode")) then
			li_option = messagebox("Transfer Type Validation", "Rows in detail will be lost.~r~nDo you want to continue?", question!, yesno!)
			if li_option = 1 then
				rt_code = 0
				lb_godownflag = true
			else
				setitem(getrow(), "ttcode", getitemnumber(getrow(), "ttcode"))
				return 1
			end if
			return
		end if
		parent.parent.parent.wf_settransfertype(integer(data))
	case "workordercode"
		if not (isnull(data) or data = "") then
			if long(data) < 0 then
				messagebox("Work Order No.", "Please enter a valid Work Order No.", stopsign!)
				return 1
			elseif parent.parent.parent.wf_validateworkorder(long(data)) < 0 then
				messagebox("Work Order No.", "Please enter a valid Work Order No.", stopsign!)
				return 1
			end if
		end if
	end choose
	if lb_godownflag then
		for ll_row = parent.parent.parent.id_detail.rowcount() to 1 step -1
			parent.parent.parent.id_detail.deleterow(ll_row)
		next
		parent.parent.parent.id_detail.insertrow(0)
	end if
	return rt_code

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "date"
		messagebox("Date Time Validation", "Date and Time is invalid,~r~nPlease enter current date and time")
	case "custcode"
		messagebox("Customer Name Validation", "You must select some Customer")
	case "sgcode"
		if data = "" or isnull(data) then
			messagebox("Source Godown Validation", "Please select valid source godown")
		end if
	case "dgcode"
		if data = "" or isnull(data) then
			messagebox("Target Godown Validation", "Please select valid target godown")
		end if
	end choose
	return 1

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	if parent.parent.parent.ib_godownvalidated = false then
		return ::message.returnvalue
	end if
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return 0

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf5! and (getcolumnname() = "sgcode" or getcolumnname() = "dgcode") then
		parent.parent.parent.wf_get_customer_associated_godown(getcolumnname())
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_focusgodown(string as_column) returns 0 [event]
	long ll_thisrow
	ll_thisrow = parent.parent.parent.id_master.getrow()
	parent.parent.parent.id_master.setfocus()
	if as_column = "sgcode" then
		if parent.parent.parent.id_master.object.sgcode[ll_thisrow] = parent.parent.parent.id_master.object.dgcode[ll_thisrow] then
			messagebox("Godown Validation", "Source and Target Godown must be different.~r~n")
		end if
	elseif as_column = "dgcode" then
	end if
	parent.parent.parent.id_master.setcolumn(as_column)
	parent.parent.parent.id_master.scrolltorow(ll_thisrow)

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	long ld_newqty
	long ld_storedqty
	long ld_stock
	long ld_packqty
	long ll_gcode
	long ll_null
	long ll_icode
	long ll_packunits
	long ll_itemtypecode
	string ls_null
	string ls_itemname
	double ld_areavolume
	double ld_packcapacity
	date ld_expiry
	time lt_expiry
	datetime ldt_expiry
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.il_previcode = parent.parent.parent.id_detail.getitemnumber(row, "icode")
		parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
		parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		li_errcode = 0
	case "qty"
		ld_newqty = double(data)
		ld_storedqty = getitemnumber(row, "qty")
		if ld_newqty > ld_storedqty then
			ld_stock = this.object.stock[row]
			if ld_newqty > ld_stock then
				if parent.parent.parent.ib_allowinsufficientstockitems then
					li_errcode = 0
				else
					messagebox("Quantity Validation", "Quantity " + data + " exceeds the stock")
					li_errcode = 1
				end if
			else
				ld_areavolume = parent.parent.parent.id_detail.object.areavolume[row]
				if ld_areavolume <= 0.0 or isnull(ld_areavolume) then
					ld_areavolume = 1
				end if
				ld_packcapacity = parent.parent.parent.id_detail.object.packcapacity[row]
				if ld_packcapacity <= 0.0 or isnull(ld_packcapacity) then
					ld_packcapacity = 1
				end if
				parent.parent.parent.id_detail.setitem(row, "pcs", round(double(data) / ld_areavolume, 6))
				parent.parent.parent.id_detail.setitem(row, "cartons", trim(string(long(parent.parent.parent.id_detail.object.pcs[row] / ld_packcapacity))) + " : " + trim(string(long(ceiling(round(parent.parent.parent.id_detail.object.pcs[row] mod ld_packcapacity, 2))))))
			end if
		elseif ld_newqty < 0 then
			messagebox("Quantity Validation", "Item Qty ~"" + data + "~" should be greater than zero")
			li_errcode = 1
		end if
	case "pcs"
		return parent.parent.parent.wf_validate_pcs(row, data)
	case "packqty"
		ld_packqty = double(data)
		if not isnull(ld_packqty) or ld_packqty >= 0 then
			ll_icode = getitemnumber(row, "icode")
			if not isnull(ll_icode) then
				SQL Select packunits INTO :ll_packunits From item Where icode =:ll_icode USING sqlca;
				if sqlca.sqlcode = 0 then
					if isnull(ll_packunits) or ll_packunits = 0 then
						ll_packunits = 1
					end if
					ld_newqty = ll_packunits * ld_packqty
					ld_stock = this.object.stock[row]
					if ld_newqty > ld_stock then
						if parent.parent.parent.ib_allowinsufficientstockitems then
							li_errcode = 0
						else
							messagebox("Pack Quantity Validation", "Pack quantity " + string(ld_newqty) + " exceeds stock.")
							li_errcode = 1
						end if
					else
						setitem(row, "qty", ld_newqty)
					end if
				end if
			end if
		end if
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname, ll_itemtypecode, parent.parent.parent.idbl_packqty, parent.parent.parent.idbl_purprice, parent.parent.parent.idbl_saleprice)
			if li_res > 0 then
				if parent.parent.parent.idbl_packqty <= 0.0 or isnull(parent.parent.parent.idbl_packqty) then
					parent.parent.parent.idbl_packqty = 1
				end if
				parent.parent.parent.il_previcode = parent.parent.parent.id_detail.getitemnumber(row, "icode")
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				setitem(row, "qty", parent.parent.parent.idbl_packqty)
				if ll_itemtypecode = 2 then
					setitem(row, "alternatecustomicode", data)
					setitem(row, "saleprice", parent.parent.parent.idbl_saleprice)
					setitem(row, "purprice", parent.parent.parent.idbl_purprice)
				else
					setitem(row, "alternatecustomicode", ls_null)
				end if
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
			else
				messagebox("ItemNumber Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_errcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_errcode = 2
		end if
	case "expiry"
		ld_expiry = date(mid(data, 1, 10))
		lt_expiry = time("00:00:00.000000")
		ldt_expiry = datetime(ld_expiry, lt_expiry)
		ll_gcode = parent.parent.parent.id_master.object.sgcode[1]
		if rowcount() > 1 and ldt_expiry <> datetime("00/00/0000, 00:00:00") and not (isnull(this.object.icode[row]) and isnull(this.object.batch[row]) and isnull(this.object.expiry[row])) and vf_dwdupcodebatch(this, "gcode", ll_gcode, "icode", getitemnumber(getrow(), "icode"), "batch", getitemstring(getrow(), "batch"), "expiry", ldt_expiry, parent.parent.parent.il_currrow) = true then
			messagebox("Item Validation", "Duplicate item, please select some other item")
			li_errcode = 1
		end if
	case "batch"
		if parent.parent.parent.idc_itembatches.getrow() < 1 or isnull(parent.parent.parent.idc_itembatches.getrow()) then
			return 1
		end if
		if parent.parent.parent.wf_validatebatch(this.object.icode[row], data, parent.parent.parent.id_master.object.sgcode[1], parent.parent.parent.idc_itembatches.getitemdatetime(parent.parent.parent.idc_itembatches.getrow(), "Expiry")) = 0 then
			setitem(row, "Expiry", parent.parent.parent.idc_itembatches.getitemdatetime(parent.parent.parent.idc_itembatches.getrow(), "Expiry"))
		else
			return 1
		end if
		return
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	string ls_batch
	long ll_currow
	long ll_icode
	long ll_gcode
	long ancestorreturnvalue
	if dwo.name = "batch" and row > 0 then
		ll_icode = parent.parent.parent.id_detail.getitemnumber(row, "icode")
		ll_gcode = parent.parent.parent.id_master.getitemnumber(1, "sgcode")
		parent.parent.parent.idc_itembatches.retrieve(ll_gcode, ll_icode)
		ls_batch = parent.parent.parent.id_detail.object.batch[row]
		parent.parent.parent.idc_itembatches.find("batch = '" + ls_batch + "'", 1, parent.parent.parent.idc_itembatches.rowcount())
	end if
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return 0

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if getcolumnname() <> parent.parent.parent.is_columnitemname then
		if rowcount() > 0 and lrs_status <> new! then
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", getitemnumber(currentrow, "icode"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", getitemnumber(currentrow, "stock"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", getitemnumber(currentrow, "totalstock"))
		elseif parent.parent.parent.id_footer.getrow() > 0 then
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", 0)
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "fullcode"
		if data = "" or isnull(data) then
		end if
	case parent.parent.parent.is_columnitemname
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case "looseqty"
	case "packqty"
		if real(data) < 0.0 then
			messagebox("Item Qty Validation", "Item Qty ~"" + data + "~" should be greater than zero")
		end if
	case "discperc"
		if real(data) < 0.0 and real(data) > 100.0 then
			messagebox("Item Discount Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
		end if
	case "saleprice"
		if double(data) <= 0.0 then
			messagebox("Item Price Validation", "Item price ~"" + data + "~" must be greater than zero")
		else
			messagebox("Item Price Validation", "Item price can not be changed")
		end if
	case "batch"
		messagebox("Item Batch Validation", "Kindly enter valid item batch number in the current row.~r~nPossible reasons are there is no stock for the selected godown.~r~nPossible suggestions are select some other godown than try again.")
	end choose
	return 1

// dw_itemsdetail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	if isnull(parent.parent.parent.id_master.getitemnumber(parent.parent.parent.id_master.getrow(), "sgcode")) then
		post event ue_focusgodown("sgcode")
	elseif isnull(parent.parent.parent.id_master.getitemnumber(parent.parent.parent.id_master.getrow(), "dgcode")) then
		post event ue_focusgodown("dgcode")
	elseif parent.parent.parent.id_master.getitemnumber(parent.parent.parent.id_master.getrow(), "sgcode") = parent.parent.parent.id_master.getitemnumber(parent.parent.parent.id_master.getrow(), "dgcode") then
		post event ue_focusgodown("sgcode")
	end if
	parent.parent.parent.id_itemslist.hide()
	if f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_focusqty() returns 0 [event]
	setcolumn("qty")
	setfocus()

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_icode
	long ll_found
	long ll_counter
	long ll_rowm
	s_datastore lstr_ds
	s_popup_selection lstr_selection
	s_positem ls_itemdetail
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorrow()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollnextpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrollpriorpage()
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(parent.parent.parent.id_itemslist.rowcount())
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.parent.parent.id_itemslist.selectrow(0, false)
			parent.parent.parent.id_itemslist.scrolltorow(1)
			ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf7! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			lstr_ds.s_name1 = gd_popup_itemsinfo.dataobject
			lstr_ds.s_name2 = "name"
			openwithparm(w_popup_responsivesearch_selection, lstr_ds)
			lstr_selection = message.powerobjectparm
			if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(lstr_selection.l_code2), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 and ll_found <= parent.parent.parent.id_itemslist.rowcount() then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf8! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("namesearch", 1)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf9! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("criteriasearch", 1)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf4! then
			parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
			setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
			setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	elseif key = keydownarrow! then
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_focusfooter")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	end if
	if getcolumnname() = "fullcode" and key = keyf7! then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
		setredraw(true)
		lstr_ds.s_name1 = gd_popup_itemsinfo.dataobject
		lstr_ds.s_name2 = "aliasname"
		openwithparm(w_popup_responsivesearch_selection, lstr_ds)
		lstr_selection = message.powerobjectparm
		if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
			ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(lstr_selection.l_code2), 1, parent.parent.parent.id_itemslist.rowcount())
			if ll_found > 0 and ll_found <= parent.parent.parent.id_itemslist.rowcount() then
				ll_listcurrrow = ll_found
				parent.parent.parent.id_itemslist.selectrow(0, false)
				rt_code = 1
			end if
		end if
		setfocus()
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			ll_rowm = getrow()
			if ll_rowm > 0 then
				setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
				setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				selecttext(1, len(gettext()))
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = ll_rowm
			end if
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	end if
	if getcolumnname() = "qty" and key = keyf5! then
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 643 then
				ls_itemdetail.l_icode = getitemnumber(getrow(), "icode")
				ls_itemdetail.i_module = parent.parent.parent.ii_module
				if isnull(ls_itemdetail.l_icode) then
					messagebox("Item Validation", "Please select some item in the current row, than try again.")
				else
					openwithparm(w_popup_itempriority_settings, ls_itemdetail)
				end if
				exit
			end if
		next
		rt_code = 1
	end if
	return rt_code

// dw_itemsdetail.ue_enterkey() returns long [event]
	if getrow() = rowcount() then
		if getcolumn() = integer(this.object.datawindow.column.count) then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
		if f_stringpreferences("ShowQtyInTransfer") = "N" and getcolumnname() = "itemname" then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
		return
	end if
	send(handle(this), 256, 9, long(90))
	return 1
