// window w_transfer (transfer)  ancestor: w_multi_entry

// w_transfer.ue_generate() returns 0 [event]
	datastore lds_re
	long ll_rows
	long i
	long ll_endrow
	long ll_counter
	long ll_packunits
	long ll_sgcode
	long ll_dgcode
	long ll_ttcode
	double ld_qty
	double ld_looseqty
	double ld_sourcestk
	double ld_targetstk
	integer li_retcode
	integer k
	string ls_errtext
	m_transfer lm_menu
	s_arguements lstr_arg
	lm_menu = this.menuid
	lds_re = create datastore
	if this.ib_itemslistopen then
		this.id_itemslist.hide()
		this.ib_itemslistopen = false
	end if
	ll_ttcode = this.id_master.getitemnumber(this.id_master.getrow(), "ttcode")
	if ll_ttcode > 2 then
		messagebox("Transfer Type Validation", "Please Select Valid Transfer Type")
		return
	end if
	ll_sgcode = this.id_master.getitemnumber(this.id_master.getrow(), "sgcode")
	ll_dgcode = this.id_master.getitemnumber(this.id_master.getrow(), "dgcode")
	if ll_sgcode = ll_dgcode then
		messagebox("Godown Validation", "Source and Target Godown must be different.~r~nCannot generate Transfer Items")
		return
	elseif isnull(ll_sgcode) then
		messagebox("Source Godown Validation", "Please Select Valid Source Godown.")
		this.id_master.setcolumn("sgcode")
		this.id_master.setfocus()
		return
	elseif isnull(ll_dgcode) then
		messagebox("Target Godown Validation", "Please Select Valid Target Godown.")
		this.id_master.setcolumn("dgcode")
		this.id_master.setfocus()
		return
	end if
	open(w_arg_item_populate_all_withoutgodown)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status <> 1 then
		return
	end if
	if lstr_arg.s_name2 = "AND" then
		lds_re.dataobject = "d_greorderdetail_and"
		lds_re.settransobject(sqlca)
		ll_rows = lds_re.retrieve(ll_dgcode, ll_sgcode, lstr_arg.ia_integerlist, lstr_arg.l_code1, lstr_arg.ia_integerlist1, lstr_arg.l_code2, lstr_arg.ia_integerlist2, lstr_arg.l_code3, lstr_arg.la_longlist, lstr_arg.l_code4)
	else
		lds_re.dataobject = "d_greorderdetail"
		lds_re.settransobject(sqlca)
		ll_rows = lds_re.retrieve(ll_dgcode, ll_sgcode, lstr_arg.ia_integerlist, lstr_arg.l_code1, lstr_arg.ia_integerlist1, lstr_arg.l_code2, lstr_arg.ia_integerlist2, lstr_arg.l_code3, lstr_arg.la_longlist, lstr_arg.l_code4, lstr_arg.s_name1)
	end if
	setredraw(false)
	ll_counter = 1
	for ll_counter = this.id_detail.rowcount() to 1 step -1
		this.id_detail.deleterow(ll_counter)
	next
	ll_counter = 1
	if ll_rows >= 0 then
		ll_endrow = lds_re.rowcount()
		setpointer(hourglass!)
		for ll_counter = 1 to ll_endrow
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_re.getitemnumber(ll_counter, "icode"), ll_counter, li_retcode, ls_errtext)
			ll_packunits = lds_re.getitemnumber(ll_counter, "packunits")
			if isnull(ll_packunits) or ll_packunits = 0 then
				ll_packunits = 1
			else
				ll_packunits = ll_packunits
			end if
			ld_qty = double(lds_re.getitemnumber(ll_counter, "goptimumqty")) - lds_re.getitemnumber(ll_counter, "currqty")
			ld_targetstk = lds_re.getitemnumber(ll_counter, "currqty")
			ld_sourcestk = this.id_detail.getitemnumber(ll_counter, "stock")
			this.id_detail.setitem(ll_counter, "reorderqty", lds_re.getitemnumber(ll_counter, "greorderqty"))
			this.id_detail.setitem(ll_counter, "optimumqty", lds_re.getitemnumber(ll_counter, "goptimumqty"))
			this.id_detail.setitem(ll_counter, "sourcestk", ld_sourcestk)
			this.id_detail.setitem(ll_counter, "targetstk", ld_targetstk)
			if ld_qty > 0.0 then
				this.id_detail.setitem(ll_counter, "requiredqty", ld_qty)
				if this.id_detail.getitemnumber(ll_counter, "stock") >= ld_qty then
					this.id_detail.setitem(ll_counter, "qty", ld_qty)
				else
					this.id_detail.setitem(ll_counter, "qty", this.id_detail.getitemnumber(ll_counter, "stock"))
				end if
			else
				this.id_detail.setitem(ll_counter, "requiredqty", 0)
				this.id_detail.setitem(ll_counter, "qty", 0)
			end if
		next
		for ll_counter = 1 to lds_re.rowcount()
			if isnull(this.id_detail.getitemnumber(ll_counter, "icode")) then
				messagebox("Problem", "Problem at Row #" + string(ll_counter))
			end if
		next
		setpointer(arrow!)
	end if
	if this.id_detail.rowcount() <= 0 then
		event ue_newitem()
	else
		this.im_menu.m_file.m_save.enabled = true
		lm_menu.m_file.m_saveandpost.enabled = true
		if this.id_detail.rowcount() > 1 then
			this.id_detail.setcolumn("qty")
			this.id_detail.scrolltorow(this.id_detail.rowcount())
			this.id_detail.setfocus()
		end if
	end if
	setredraw(true)
	event ue_selectfirstrow()

// w_transfer.ue_generate_godownreorderlevel() returns 0 [event]
	datastore lds_re
	long ll_rows
	long i
	long ll_endrow
	long ll_counter
	long ll_packunits
	long ll_ttcode
	double ld_qty
	double ld_looseqty
	double ld_sourcestk
	double ld_targetstk
	integer li_retcode
	integer k
	string ls_errtext
	m_transfer lm_menu
	lm_menu = this.menuid
	if this.ib_itemslistopen then
		this.id_itemslist.hide()
		this.ib_itemslistopen = false
	end if
	lds_re = create datastore
	lds_re.dataobject = "d_godownwise_itemreorder"
	lds_re.settransobject(sqlca)
	ll_ttcode = this.id_master.getitemnumber(this.id_master.getrow(), "ttcode")
	if ll_ttcode > 2 then
		messagebox("Transfer Type Validation", "Please Select Valid Transfer Type")
		return
	end if
	if this.id_master.getitemnumber(this.id_master.getrow(), "sgcode") = this.id_master.getitemnumber(this.id_master.getrow(), "dgcode") then
		messagebox("Godown Validation", "Source and Target Godown must be different.~r~nCannot generate Transfer Items")
		return
	elseif isnull(this.id_master.getitemnumber(this.id_master.getrow(), "sgcode")) then
		messagebox("Source Godown Validation", "Please Select Valid Source Godown.")
		this.id_master.setcolumn("sgcode")
		this.id_master.setfocus()
		return
	elseif isnull(this.id_master.getitemnumber(this.id_master.getrow(), "dgcode")) then
		messagebox("Target Godown Validation", "Please Select Valid Target Godown.")
		this.id_master.setcolumn("dgcode")
		this.id_master.setfocus()
		return
	end if
	ll_rows = lds_re.retrieve(this.id_master.getitemnumber(this.id_master.getrow(), "dgcode"), this.id_master.getitemnumber(this.id_master.getrow(), "sgcode"))
	setredraw(false)
	ll_counter = 1
	for ll_counter = this.id_detail.rowcount() to 1 step -1
		this.id_detail.deleterow(ll_counter)
	next
	ll_counter = 1
	if ll_rows >= 0 then
		ll_endrow = lds_re.rowcount()
		setpointer(hourglass!)
		for ll_counter = 1 to ll_endrow
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_re.getitemnumber(ll_counter, "icode"), ll_counter, li_retcode, ls_errtext)
			ld_qty = lds_re.getitemnumber(ll_counter, "optimumqty") - lds_re.getitemnumber(ll_counter, "currqty")
			ld_targetstk = lds_re.getitemnumber(ll_counter, "currqty")
			ld_sourcestk = this.id_detail.getitemnumber(ll_counter, "stock")
			this.id_detail.setitem(ll_counter, "reorderqty", lds_re.getitemnumber(ll_counter, "reorderqty"))
			this.id_detail.setitem(ll_counter, "optimumqty", lds_re.getitemnumber(ll_counter, "optimumqty"))
			this.id_detail.setitem(ll_counter, "sourcestk", ld_sourcestk)
			this.id_detail.setitem(ll_counter, "targetstk", ld_targetstk)
			if ld_qty > 0.0 then
				this.id_detail.setitem(ll_counter, "requiredqty", ld_qty)
				if this.id_detail.getitemnumber(ll_counter, "stock") >= ld_qty then
					this.id_detail.setitem(ll_counter, "qty", ld_qty)
				else
					this.id_detail.setitem(ll_counter, "qty", this.id_detail.getitemnumber(ll_counter, "stock"))
				end if
			else
				this.id_detail.setitem(ll_counter, "requiredqty", 0)
				this.id_detail.setitem(ll_counter, "qty", 0)
			end if
		next
		for ll_counter = 1 to lds_re.rowcount()
			if isnull(this.id_detail.getitemnumber(ll_counter, "icode")) then
				messagebox("Problem", "Problem at Row #" + string(ll_counter))
			end if
		next
		setpointer(arrow!)
	end if
	if this.id_detail.rowcount() <= 0 then
		event ue_newitem()
	else
		this.im_menu.m_file.m_save.enabled = true
		lm_menu.m_file.m_saveandpost.enabled = true
		if this.id_detail.rowcount() > 1 then
			this.id_detail.setcolumn("qty")
			this.id_detail.scrolltorow(this.id_detail.rowcount())
			this.id_detail.setfocus()
		end if
	end if
	setredraw(true)
	event ue_selectfirstrow()

// w_transfer.ue_generate_godownwise_consumption() returns 0 [event]
	datastore lds_re
	long ll_rows
	long i
	long ll_endrow
	long ll_counter
	long ll_ttcode
	double ld_qty
	double ll_packunits
	double ld_sourcestk
	double ld_targetstk
	integer li_retcode
	string ls_errtext
	datetime ldt_startdate
	datetime ldt_enddate
	s_arguements lstr_arg
	m_transfer lm_menu
	lm_menu = this.menuid
	if this.id_master.accepttext() = -1 then
		return
	end if
	if this.ib_itemslistopen then
		this.id_itemslist.hide()
		this.ib_itemslistopen = false
	end if
	lds_re = create datastore
	lds_re.dataobject = "d_godownwise_consumption"
	lds_re.settransobject(sqlca)
	ll_ttcode = this.id_master.getitemnumber(this.id_master.getrow(), "ttcode")
	if ll_ttcode <> 3 then
		messagebox("Transfer Type Validation", "Please Select Valid Transfer Type")
		return
	end if
	if this.id_master.getitemnumber(this.id_master.getrow(), "sgcode") = this.id_master.getitemnumber(this.id_master.getrow(), "dgcode") then
		messagebox("Godown Validation", "Source and Target Godown must be different.~r~nCannot generate Transfer Items")
		return
	elseif isnull(this.id_master.getitemnumber(this.id_master.getrow(), "sgcode")) then
		messagebox("Source Godown Validation", "Please Select Valid Source Godown.")
		this.id_master.setcolumn("sgcode")
		this.id_master.setfocus()
		return
	elseif isnull(this.id_master.getitemnumber(this.id_master.getrow(), "dgcode")) then
		messagebox("Target Godown Validation", "Please Select Valid Target Godown.")
		this.id_master.setcolumn("dgcode")
		this.id_master.setfocus()
		return
	end if
	ldt_startdate = this.id_master.getitemdatetime(this.id_master.getrow(), "startdate")
	ldt_enddate = this.id_master.getitemdatetime(this.id_master.getrow(), "enddate")
	if ldt_startdate > ldt_enddate then
		messagebox("Date Time Validation", "Start datetime should be less than end datetime")
		return
	end if
	open(w_arg_categories_transfer)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = -1 or upperbound(lstr_arg.ia_integerlist) <= 0 then
		return
	end if
	setredraw(false)
	ll_rows = lds_re.retrieve(this.id_master.getitemnumber(this.id_master.getrow(), "dgcode"), this.id_master.getitemnumber(this.id_master.getrow(), "sgcode"), ldt_startdate, ldt_enddate, lstr_arg.ia_integerlist)
	ll_counter = 1
	for ll_counter = this.id_detail.rowcount() to 1 step -1
		this.id_detail.deleterow(ll_counter)
	next
	ll_counter = 1
	if ll_rows >= 0 then
		this.ib_godwisecons_itemfetch = false
		ll_endrow = lds_re.rowcount()
		setpointer(hourglass!)
		for ll_counter = 1 to ll_endrow
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_re.getitemnumber(ll_counter, "icode"), ll_counter, li_retcode, ls_errtext)
			ld_qty = lds_re.getitemnumber(ll_counter, "netsaleqty")
			this.id_detail.setitem(ll_counter, "reorderqty", 0)
			this.id_detail.setitem(ll_counter, "optimumqty", 0)
			this.id_detail.setitem(ll_counter, "requiredqty", ld_qty)
			if this.id_detail.getitemnumber(ll_counter, "stock") >= ld_qty then
				this.id_detail.setitem(ll_counter, "qty", ld_qty)
			else
				this.id_detail.setitem(ll_counter, "qty", this.id_detail.getitemnumber(ll_counter, "stock"))
			end if
		next
		for ll_counter = 1 to lds_re.rowcount()
			if isnull(this.id_detail.getitemnumber(ll_counter, "icode")) then
				messagebox("Problem", "Problem at Row #" + string(ll_counter))
			end if
		next
		setpointer(arrow!)
		this.ib_godwisecons_itemfetch = true
	end if
	if this.id_detail.rowcount() <= 0 then
		event ue_newitem()
	else
		this.im_menu.m_file.m_save.enabled = true
		lm_menu.m_file.m_saveandpost.enabled = true
		if this.id_detail.rowcount() > 1 then
			this.id_detail.setcolumn("qty")
			this.id_detail.scrolltorow(this.id_detail.rowcount())
			this.id_detail.setfocus()
		end if
	end if
	setredraw(true)
	event ue_selectfirstrow()

// w_transfer.ue_enableprint() returns 0 [event]
	this.im_menu.m_file.m_print.enabled = true

// w_transfer.ue_generate_sourcebased() returns 0 [event]
	datastore lds_re
	long ll_rows
	long i
	long ll_endrow
	long ll_counter
	long ll_packunits
	long ll_sgcode
	long ll_dgcode
	long ll_ttcode
	double ld_qty
	double ld_looseqty
	double ld_sourcestk
	double ld_targetstk
	double ld_stockperc
	integer li_retcode
	integer k
	string ls_errtext
	m_transfer lm_menu
	s_arguements lstr_arg
	lm_menu = this.menuid
	lds_re = create datastore
	if this.ib_itemslistopen then
		this.id_itemslist.hide()
		this.ib_itemslistopen = false
	end if
	ll_ttcode = this.id_master.getitemnumber(this.id_master.getrow(), "ttcode")
	if ll_ttcode <> 4 then
		messagebox("Transfer Type Validation", "Please Select Valid Transfer Type")
		return
	end if
	ll_sgcode = this.id_master.getitemnumber(this.id_master.getrow(), "sgcode")
	ll_dgcode = this.id_master.getitemnumber(this.id_master.getrow(), "dgcode")
	if ll_sgcode = ll_dgcode then
		messagebox("Godown Validation", "Source and Target Godown must be different.~r~nCannot generate Transfer Items")
		return
	elseif isnull(ll_sgcode) then
		messagebox("Source Godown Validation", "Please Select Valid Source Godown.")
		this.id_master.setcolumn("sgcode")
		this.id_master.setfocus()
		return
	elseif isnull(ll_dgcode) then
		messagebox("Target Godown Validation", "Please Select Valid Target Godown.")
		this.id_master.setcolumn("dgcode")
		this.id_master.setfocus()
		return
	end if
	open(w_arg_item_populate2)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status <> 1 then
		return
	end if
	open(w_sourcebasedtransfer_stockperc)
	ld_stockperc = message.doubleparm
	if ld_stockperc <= 0.0 then
		messagebox("Inter Godown Transfer", "Nothing to transfer, Please enter valid stock transfer criteria in %age")
		return
	end if
	if lstr_arg.s_name2 = "AND" then
		lds_re.dataobject = "d_sourcebasedtransfer_and"
		lds_re.settransobject(sqlca)
		ll_rows = lds_re.retrieve(ll_sgcode, lstr_arg.ia_integerlist, lstr_arg.ia_integerlist1, lstr_arg.ia_integerlist2, lstr_arg.la_longlist, ld_stockperc)
	else
		lds_re.dataobject = "d_sourcebasedtransfer"
		lds_re.settransobject(sqlca)
		ll_rows = lds_re.retrieve(ll_sgcode, lstr_arg.ia_integerlist, lstr_arg.ia_integerlist1, lstr_arg.ia_integerlist2, lstr_arg.la_longlist, lstr_arg.s_name1, ld_stockperc)
	end if
	setredraw(false)
	ll_counter = 1
	for ll_counter = this.id_detail.rowcount() to 1 step -1
		this.id_detail.deleterow(ll_counter)
	next
	ll_counter = 1
	if ll_rows >= 0 then
		ll_endrow = lds_re.rowcount()
		setpointer(hourglass!)
		for ll_counter = 1 to ll_endrow
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_re.getitemnumber(ll_counter, "icode"), ll_counter, li_retcode, ls_errtext)
			ll_packunits = lds_re.getitemnumber(ll_counter, "packunits")
			if isnull(ll_packunits) or ll_packunits = 0 then
				ll_packunits = 1
			else
				ll_packunits = ll_packunits
			end if
			ld_qty = lds_re.getitemnumber(ll_counter, "currqty")
			ld_targetstk = lds_re.getitemnumber(ll_counter, "currqty")
			ld_sourcestk = this.id_detail.getitemnumber(ll_counter, "stock")
			this.id_detail.setitem(ll_counter, "reorderqty", lds_re.getitemnumber(ll_counter, "greorderqty"))
			this.id_detail.setitem(ll_counter, "optimumqty", lds_re.getitemnumber(ll_counter, "goptimumqty"))
			this.id_detail.setitem(ll_counter, "sourcestk", ld_sourcestk)
			this.id_detail.setitem(ll_counter, "targetstk", ld_targetstk)
			if ld_qty > 0.0 then
				this.id_detail.setitem(ll_counter, "requiredqty", ld_qty)
				this.id_detail.setitem(ll_counter, "qty", ld_qty)
			else
				this.id_detail.setitem(ll_counter, "requiredqty", 0)
				this.id_detail.setitem(ll_counter, "qty", 0)
			end if
		next
		for ll_counter = 1 to lds_re.rowcount()
			if isnull(this.id_detail.getitemnumber(ll_counter, "icode")) then
				messagebox("Problem", "Problem at Row #" + string(ll_counter))
			end if
		next
		setpointer(arrow!)
	end if
	if this.id_detail.rowcount() <= 0 then
		event ue_newitem()
	else
		this.im_menu.m_file.m_save.enabled = true
		lm_menu.m_file.m_saveandpost.enabled = true
		if this.id_detail.rowcount() > 1 then
			this.id_detail.setcolumn("qty")
			this.id_detail.scrolltorow(this.id_detail.rowcount())
			this.id_detail.setfocus()
		end if
	end if
	event ue_selectfirstrow()
	setredraw(true)

// w_transfer.ue_selectfirstrow() returns 0 [event]
	if this.id_detail.rowcount() > 0 then
		this.id_detail.setcolumn("itemname")
		this.id_detail.setrow(1)
		this.id_detail.scrolltorow(1)
	end if
	if this.ib_itemslistopen then
		this.id_itemslist.hide()
		this.ib_itemslistopen = false
	end if

// w_transfer.ue_enforcedefaultfocussettings() returns 0 [event]
	string ls_focuscolsetting
	string ls_setting
	ls_focuscolsetting = f_stringpreferences("TransferDefaultFocusSetting")
	if ls_focuscolsetting = "itemdetailwindow" then
		post event ue_setitemfocus()
		return
	end if
	ls_setting = this.id_master.describe(trim(ls_focuscolsetting) + ".visible")
	if trim(ls_setting) = "1" then
		this.id_master.setcolumn(trim(ls_focuscolsetting))
		this.id_master.setfocus()
		return
	end if
	this.id_master.setcolumn("ttcode")
	this.id_master.setfocus()

// w_transfer.ue_setitemfocus() returns 0 [event]
	string ls_null
	setnull(ls_null)
	if f_stringpreferences("itemcode") = "Y" then
		this.id_detail.setcolumn("fullcode")
		this.id_detail.setfocus()
		return
	end if
	this.id_detail.setitem(this.id_detail.getrow(), "itemname", " ")
	this.id_detail.setcolumn("itemname")
	this.id_detail.setfocus()
	this.id_detail.setitem(this.id_detail.getrow(), "itemname", ls_null)

// w_transfer.duplicategodown() returns 0

// w_transfer.wf_visible(boolean ab_flag) returns 0
	this.id_footer.object.stock.visible = ab_flag
	this.id_footer.object.t_stock.visible = ab_flag
	this.id_footer.object.totalstock.visible = ab_flag
	this.id_footer.object.t_totalstock.visible = ab_flag

// w_transfer.wf_locksaleinvoice(long al_saleinvcode) returns integer
	integer li_count
	this.it_transobject.dbparm = " Async =1, DBGetTime = 20"
	this.it_transobject.locksaleinvoice(al_saleinvcode)
	this.it_transobject.dbparm = "Async =0, DBGetTime = 0"
	return this.it_transobject.sqlcode

// w_transfer.wf_locktransferinvoices(long al_sinvcode, long al_linvcode, long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From Theader WITH ( UPDLOCK HOLDLOCK ) Where Theader.Transcode Between :al_sinvcode AND :al_linvcode AND Theader.Posted ='N' USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_transfer.wf_setsaletype(integer ai_saletype) returns 0
	this.ii_saletype = ai_saletype

// w_transfer.wf_setsuppinfo(long al_suppcode, datawindow ad_master) returns 0
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	SQL SELECT supplier.address1 , supplier.city , supplier.phone INTO :ls_address, :ls_city, :ls_phone FROM supplier WHERE supplier.suppcode =:al_suppcode USING this.it_transobject;
	ll_currow = ad_master.getrow()
	ad_master.object.supplier_address[ll_currow] = ls_address
	ad_master.object.supplier_city[ll_currow] = ls_city
	ad_master.object.supplier_phone[ll_currow] = ls_phone

// w_transfer.wf_updatesaleprice(long al_icode, double ad_saleprice) returns integer
	SQL update Item SET saleprice =:ad_saleprice WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_transfer.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	long ll_icode
	double ld_stock
	double ld_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	string ls_itemname
	integer li_errcode = 1
	integer li_assgcode
	integer li_option
	boolean lb_rtflag = true
	boolean ib_due
	integer li_null
	string ls_null
	ls_titleerrtext = "Item Validation"
	if wf_findfullcode(as_custicode, ll_icode, ls_itemname) > 0 then
		if f_stringpreferences("AllowBatchWiseTrasnfer") = "N" then
			if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), al_currrow) = true and f_stringpreferences("AllowDupItemsInTransfer") = "N" then
				ls_errtext = "Duplicate item, please select some other item"
				li_errcode = -1
			elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
				if li_errcode = -2 then
					li_option = messagebox("Item Validation", "Item stock does not exist~n~rDo You want to due this item", information!, yesno!, 2)
					if li_option = 1 then
						this.id_detail.setitem(this.il_currrow, "looseqty", 1)
						this.id_detail.setitem(this.il_currrow, "dueqty", 1)
						ib_due = true
					else
						li_errcode = -1
					end if
				end if
			else
				li_errcode = -1
				ls_titleerrtext = "Item Validation"
			end if
		elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
			if li_errcode = -2 then
				li_option = messagebox("Item Validation", "Item stock does not exist~n~rDo You want to due this item", information!, yesno!, 2)
				if li_option = 1 then
					this.id_detail.setitem(this.il_currrow, "looseqty", 1)
					this.id_detail.setitem(this.il_currrow, "dueqty", 1)
					ib_due = true
				else
					li_errcode = -1
				end if
			end if
		else
			li_errcode = -1
			ls_titleerrtext = "Item Validation"
		end if
	else
		li_errcode = -1
		ls_errtext = "Item Number does not exist please enter some other"
	end if
	if li_errcode = -1 and not ib_due then
		lb_rtflag = false
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setitem(al_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(al_currrow, "icode", li_null)
		this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	end if
	return lb_rtflag

// w_transfer.wf_validategodown() returns integer
	integer li_errcode = 1
	long ll_null
	long ll_row
	string ls_titleerrtext
	string ls_errtext
	ll_row = this.id_master.getrow()
	if this.id_master.getitemnumber(ll_row, "sgcode") = this.id_master.getitemnumber(ll_row, "dgcode") and li_errcode >= 0 then
		ls_titleerrtext = "Godown Validation"
		ls_errtext = "Source and Target Godown must be different.~n~rPlease select some other Godown."
		li_errcode = -1
	end if
	this.ib_godownvalidated = true
	if li_errcode < 0 then
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(ll_null)
		this.id_master.setcolumn(this.is_columngodownname)
		this.id_master.scrolltorow(ll_row)
		this.id_master.setitem(ll_row, this.is_columngodownname, ll_null)
	end if
	return li_errcode

// w_transfer.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_transfer.wf_savastemplate() returns integer
	s_saletemplateheader lstr_templateheader
	long ll_invid
	integer li_retcode = 1
	long ll_code
	long ll_icode
	long ll_totalrows
	long ll_rowcount
	double ld_qty
	open(w_savesaleastemplate)
	lstr_templateheader = message.powerobjectparm
	f_newtableid("SaleTemplateHeader", ll_invid)
	SQL INSERT INTO SaleTemplateHeader ( saletemplatecode , date , modified , name ) values ( :ll_invid , :lstr_templateheader.dt_templatedate , :lstr_templateheader.dt_templatedate , :lstr_templateheader.s_template ) USING this.it_transobject;
	ll_totalrows = this.id_detail.rowcount()
	for ll_rowcount = 1 to ll_totalrows
		ll_code = ll_invid
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ld_qty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		SQL insert into saletemplatedetail ( saletemplatecode , icode , looseqty ) values ( :ll_code , :ll_icode , :ld_qty ) USING this.it_transobject;
	next
	setpointer(hourglass!)
	if this.it_transobject.sqlcode < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return li_retcode
	else
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Template saved", exclamation!, ok!, 1)
	end if
	return li_retcode

// w_transfer.wf_setgodownoption() returns 0

// w_transfer.wf_getmaxdate(datetime ad_date) returns integer
	SQL Select Max ( Date ) INTO :ad_date From saleledger USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_transfer.wf_grandtotal() returns double
	return 0

// w_transfer.wf_initmodify(integer ai_protect) returns 0
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_counter = 1
	double ld_stock
	double ld_looseqty
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_saleinvcode = this.id_detail.getitemnumber(1, "code")
		if wf_locksaleinvoice(ll_saleinvcode) = 0 then
			this.id_master.retrieve(ll_saleinvcode)
			if this.idc_itembatches.rowcount() <= 0 then
				this.idc_itembatches.insertrow(0)
			end if
			this.id_detail.retrieve(ll_saleinvcode)
			for ll_counter = 1 to this.id_detail.rowcount()
				ll_gcode = this.id_detail.getitemnumber(ll_counter, "gcode")
				ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
				ld_looseqty = this.id_detail.getitemnumber(ll_counter, "looseqty")
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					ai_protect = 0
					this.id_detail.setitem(ll_counter, "stock", ld_stock + ld_looseqty)
				end if
			next
			if ai_protect = 0 then
				this.ib_modify = true
				this.id_footer.setitem(1, "stock", this.id_detail.getitemnumber(1, "stock"))
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
			return
		end if
		messagebox("Cannot Modify", "Sale invoice is already in use")
	end if

// w_transfer.wf_returnsaleinvoice(long al_invid, string as_errtext) returns boolean
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_counter = 1
	long ll_detailrows
	double ld_looseqty
	double ld_stock
	double ld_newstock
	string ls_batch
	datetime ld_expiry
	boolean lb_commitflag = true
	double ld_avgprice
	this.id_saleinvdetail.retrieve(al_invid)
	ll_detailrows = this.id_saleinvdetail.rowcount()
	ll_counter = 1
	do while ll_counter <= ll_detailrows and lb_commitflag
		ll_gcode = this.id_saleinvdetail.getitemnumber(ll_counter, "gcode")
		ll_icode = this.id_saleinvdetail.getitemnumber(ll_counter, "icode")
		ls_batch = this.id_saleinvdetail.getitemstring(ll_counter, "batch")
		ld_expiry = this.id_saleinvdetail.getitemdatetime(ll_counter, "expiry")
		ld_looseqty = this.id_saleinvdetail.getitemnumber(ll_counter, "looseqty")
		this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
			if this.it_transobject.sqlcode = 0 then
				ld_newstock = ld_stock + ld_looseqty
				this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
				if this.it_transobject.sqlcode <> 0 then
					lb_commitflag = false
				end if
				if ld_stock = 0.0 then
					SQL update GodownDetail Set Priority =1 Where GodownDetail.GCode =:ll_gcode and GodownDetail.ICode =:ll_icode and GodownDetail.Batch =:ls_batch and GodownDetail.Expiry =:ld_expiry USING this.it_transobject;
				end if
			else
				lb_commitflag = false
			end if
		else
			lb_commitflag = false
		end if
		ll_counter = ll_counter + 1
	loop
	if lb_commitflag then
		if wf_deletesaleinvoice(al_invid) <> 0 then
			lb_commitflag = false
			as_errtext = "    Some database problem occur"
		end if
	else
		as_errtext = "    Some database problem occur"
	end if
	return lb_commitflag

// w_transfer.wf_validateitemnew() returns integer
	long ll_icode
	double ld_stock
	double ld_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if f_stringpreferences("AllowBatchWiseTrasnfer") = "N" then
		if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
			ls_titleerrtext = "Item Validation"
			ls_errtext = "Duplicate item, please select some other item"
			li_errcode = -1
			messagebox(ls_titleerrtext, ls_errtext)
		elseif not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
			ls_titleerrtext = "Item Validation"
			li_errcode = -2
		end if
	elseif not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		ls_titleerrtext = "Item Validation"
		li_errcode = -2
	end if
	this.ib_itemvalidated = true
	return li_errcode

// w_transfer.wf_iseditable() returns boolean
	if this.tab_retrieve.selectedtab = 1 and this.editflag = true and this.id_master.getitemstring(this.id_master.getrow(), "posted") <> "Y" then
		return true
	end if
	return false

// w_transfer.wf_selectprintreport() returns string
	string ls_pagesize
	string ls_report
	ls_pagesize = f_stringpreferences("pagesize")
	ls_report = "d_transferinvreport_full"
	this.id_print.dataobject = ls_report
	this.id_print.settransobject(this.it_transobject)
	return ls_report

// w_transfer.wf_print() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_count
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			for ll_count = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
				this.id_print.retrieve(ll_count)
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			next
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	return li_errcode

// w_transfer.wf_cleanupdetailrows() returns integer
	integer li_rtcode
	integer li_result
	long ll_detailrows
	long ll_count
	dwitemstatus lrs_status
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		lrs_status = this.id_detail.getitemstatus(1, 0, primary!)
		if not isnull(this.id_detail.getitemnumber(1, "icode")) and lrs_status <> new! then
			li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
			if li_result = 2 then
				li_rtcode = 2
			else
				this.id_detail.setredraw(false)
				for ll_count = 1 to ll_detailrows
					this.id_detail.deleterow(0)
				next
				this.idc_itembatches.insertrow(0)
				this.id_detail.insertrow(0)
				this.id_detail.setfocus()
				this.id_detail.setredraw(true)
			end if
		end if
	end if
	return li_rtcode

// w_transfer.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_transfer.wf_customerinfo(long al_custcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	double ld_currbalance
	SQL SELECT customer.address1 , customer.city , customer.phone INTO :ls_address, :ls_city, :ls_phone FROM customer WHERE customer.custcode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
		this.id_master.object.address[ll_currow] = ls_address
		this.id_master.object.city[ll_currow] = ls_city
		this.id_master.object.phone[ll_currow] = ls_phone
	end if
	return this.it_transobject.sqlcode

// w_transfer.wf_deleterows(integer ar_code) returns 0
	long ll_rowcount
	for ll_rowcount = this.id_detail.rowcount() to 1 step -1
		this.id_detail.deleterow(ll_rowcount)
	next

// w_transfer.wf_deletesaleinvoice(long al_saleinvcode) returns integer
	SQL Delete saledetail Where saledetail.SaleInvCode =:al_saleinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_transfer.wf_fetchitemlist(integer ai_sourcegcode) returns 0
	this.id_detail.setredraw(false)
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		this.idc_itemdddw.retrieve(gi_catlist, ai_sourcegcode)
		this.ids_sourcegodownitems.retrieve(gi_catlist, ai_sourcegcode)
	else
		this.idc_itemdddw.retrieve(ai_sourcegcode, 0)
		this.ids_sourcegodownitems.retrieve(ai_sourcegcode)
	end if
	this.ids_sourcegodownitems.sharedata(this.id_itemslist)
	this.ii_currsourcegodown = ai_sourcegcode
	this.id_detail.setredraw(true)

// w_transfer.wf_findfullcode(string as_fullcode, long al_icode, string as_itemname) returns integer
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		as_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_transfer.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	long iccode
	long icatcode
	long packcode
	long manfcode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

