// m_setserverdate.clicked() returns 0 [event]
	if this.checked then
		this.checked = false
	else
		this.checked = true
	end if
	this.parentwindow.dynamic wf_fetchserverdate(this.checked)

// m_setserverdate.create() returns 0 [event]
	call super::create
	this.text = "Set Server Date"
	this.checked = true

// m_setserverdate.destroy() returns 0 [event]
	call super::destroy

// m_showitemtransferhistory.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_show_itemtransferhistory()

// m_showitemtransferhistory.create() returns 0 [event]
	call super::create
