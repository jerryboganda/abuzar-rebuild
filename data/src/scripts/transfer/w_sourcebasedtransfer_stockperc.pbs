// window w_sourcebasedtransfer_stockperc (transfer)  ancestor: window

// w_sourcebasedtransfer_stockperc.ue_close(integer ai_status) returns 0 [event]
	double ld_stockperc
	this.em_stockperc.getdata(ld_stockperc)
	if ld_stockperc > 0.0 then
		if ld_stockperc > 100.0 then
			messagebox("Transfer Criteria", "Please select valid value in stock percentage")
			return
		end if
		closewithreturn(this, ld_stockperc)
		return
	end if
	messagebox("Transfer Criteria", "Please select valid value in stock percentage")

// w_sourcebasedtransfer_stockperc.create() returns 0 [event]
	this.st_1 = create st_1
	this.em_stockperc = create em_stockperc
	this.cb_ok = create cb_ok
	this.gb_format = create gb_format
	this.control = {this.st_1, this.em_stockperc, this.cb_ok, this.gb_format}

// w_sourcebasedtransfer_stockperc.destroy() returns 0 [event]
	destroy this.st_1
	destroy this.em_stockperc
	destroy this.cb_ok
	destroy this.gb_format

// w_sourcebasedtransfer_stockperc.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	return ::message.returnvalue

// cb_ok.ue_keypressed(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	parent.post event ue_close(1)
	return ::message.returnvalue
