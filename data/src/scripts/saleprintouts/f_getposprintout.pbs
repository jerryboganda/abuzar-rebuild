		elseif f_numberpreferences("salethermalprintformat") = 12 then
			ls_report = "d_thermal_saleprint_3inch_staxschedule5"
		elseif f_numberpreferences("salethermalprintformat") = 13 then
			ls_report = "d_thermal_saleprint_3inch_staxschedule6"
		else
			ls_report = "d_thermal_retailsaleinvrepwh_3inches"
		end if
	else
		ls_report = "d_retailsaleinvreport_full"
	end if
	return ls_report
