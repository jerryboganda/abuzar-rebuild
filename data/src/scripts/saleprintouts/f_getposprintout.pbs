				ls_report = "d_tm_saleinvreprotwh_thermal"
			elseif gs_company = "GNSTORES" then
				ls_report = "d_gnstores_retailsaleinvrepwh_t"
			elseif gs_company = "JANDCASHNCARRY" then
				ls_report = "d_jandcashncarry_sprnt_t"
			elseif gs_company = "ABCD2" then
				ls_report = "d_abcd2_retailsaleinvrepwh"
			elseif gs_company = "SHAHEENGROCER2" then
				ls_report = "d_shaheengrocer2_retailsaleinvrepwh_t"
			elseif gs_company = "BINDAWOODMALL" then
				ls_report = "d_bindawoodmall_retailsaleinvrepwh_t"
			elseif gs_company = "HOMELANDMART" then
				ls_report = "d_homelandmart_saleinvprnt_t"
			elseif gs_company = "PATTANMART" then
				ls_report = "d_pattanmart_retailsaleinvrepwh_t"
			elseif gs_company = "SAVEGALLERYCNC2" then
				ls_report = "d_savegallerycnc2_saleprint_t"
			elseif gs_company = "PP" then
				ls_report = "d_pp_thermal_salestaxprintout"
			elseif gs_company = "SALAMPHNCNC" then
				ls_report = "d_salamphncnc_retailsaleinvrepwh_t"
			elseif gs_company = "PETSET2" then
				ls_report = "d_petset2_retailsaleinvrepwh_t"
			elseif gs_company = "YSWHOLESALE" or gs_company = "ISWHOLESALERS" then
				ls_report = "d_yswholesale_saleprint_credit_thrml"
			elseif gs_company = "SALEEMIHPLUST" then
				ls_report = "d_saleemihplust_saleprint_t"
			else
				ls_report = "d_thermal_retailsaleinvrepwh_3inches"
			end if
		elseif f_numberpreferences("salethermalprintformat") = 2 then
			ls_report = "d_thermal_retailsaleinvrepwh_headerlogo"
		elseif f_numberpreferences("salethermalprintformat") = 3 then
			ls_report = "d_thermal_saleinvprnt_header_footer_logo"
		elseif f_numberpreferences("salethermalprintformat") = 4 then
			ls_report = "d_thermal_saleprnt_header_footer_logo2"
		elseif f_numberpreferences("salethermalprintformat") = 5 then
			ls_report = "d_thermal_saleprint_3inch_staxschedule"
		elseif f_numberpreferences("salethermalprintformat") = 6 then
			ls_report = "d_thermal_saleprnt_header_footer_logo3"
		elseif f_numberpreferences("salethermalprintformat") = 7 then
			ls_report = "d_thrml_retailsaleinvrepwh_cashreceived"
		elseif f_numberpreferences("salethermalprintformat") = 8 then
			ls_report = "d_thermal_saleprint_3inch_staxschedule2"
		elseif f_numberpreferences("salethermalprintformat") = 9 then
			ls_report = "d_thermal_saleprint_3inch_staxschedule3"
		elseif f_numberpreferences("salethermalprintformat") = 10 then
			ls_report = "d_thermal_saleprint_3inch_staxschedule4"
		elseif f_numberpreferences("salethermalprintformat") = 11 then
