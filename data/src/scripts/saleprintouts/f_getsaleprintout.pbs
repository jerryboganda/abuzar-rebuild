// function f_getsaleprintout (saleprintouts)  ancestor: function_object

// f_getsaleprintout.f_getsaleprintout(string as_pagesize, boolean ab_retail, integer ai_headerno) returns string
	string ls_report
	if as_pagesize = "Q" then
		return f_getsaleprintout_quarter(ab_retail, ai_headerno)
	elseif as_pagesize = "F" then
		return f_getsaleprintout_full(ab_retail, ai_headerno)
	elseif as_pagesize = "H" then
		return f_getsaleprintout_half(ab_retail, ai_headerno)
	elseif as_pagesize = "T" then
		return f_getsaleprintout_thermal(ab_retail, ai_headerno)
	else
		ls_report = "d_retailsaleinvreport_full"
	end if
	return ls_report
