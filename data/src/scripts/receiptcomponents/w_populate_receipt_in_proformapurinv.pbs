// window w_populate_receipt_in_proformapurinv (receiptcomponents)  ancestor: window

// w_populate_receipt_in_proformapurinv.ue_keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		post event ue_close()
	end if
	return ::message.returnvalue

// w_populate_receipt_in_proformapurinv.ue_close() returns 0
	closewithreturn(this, this.istr_arg)

// w_populate_receipt_in_proformapurinv.wf_assigndwobjects(string as_masterdw, string as_detaildw, string as_footerdw) returns 0
	this.dw_master.dataobject = as_masterdw
	this.dw_detail.dataobject = as_detaildw
	this.dw_footer.dataobject = as_footerdw
	this.dw_master.settransobject(sqlca)
	this.dw_detail.settransobject(sqlca)
	this.dw_footer.settransobject(sqlca)

// w_populate_receipt_in_proformapurinv.create() returns 0
	this.cb_retrieve = create cb_retrieve
	this.cbx_updateremarks = create cbx_updateremarks
	this.rb_both = create rb_both
	this.rb_npop = create rb_npop
	this.rb_pop = create rb_pop
	this.cb_ok = create cb_ok
	this.dw_footer = create dw_footer
	this.dw_master = create dw_master
	this.gb_1 = create gb_1
	this.gb_3 = create gb_3
	this.dw_detail = create dw_detail
	this.control = {this.cb_retrieve, this.cbx_updateremarks, this.rb_both, this.rb_npop, this.rb_pop, this.cb_ok, this.dw_footer, this.dw_master, this.gb_1, this.gb_3, this.dw_detail}

// w_populate_receipt_in_proformapurinv.destroy() returns 0
	destroy this.cb_retrieve
	destroy this.cbx_updateremarks
	destroy this.rb_both
	destroy this.rb_npop
	destroy this.rb_pop
	destroy this.cb_ok
	destroy this.dw_footer
	destroy this.dw_master
	destroy this.gb_1
	destroy this.gb_3
	destroy this.dw_detail

// w_populate_receipt_in_proformapurinv.open() returns long
	environment le_env
	integer li_rtncode
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_recipientcode
	ll_recipientcode = message.doubleparm
	if isnull(ll_recipientcode) or ll_recipientcode = 0 then
		messagebox("Recipient Validation", "Can not populate Receipt Invoices~r~nPlease Select Valid Recipient")
		post event ue_close()
	end if
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	wf_assigndwobjects("d_recipient_in_proformapurinv_header", "d_populate_receipt_proformapurinv", "")
	li_rtncode = this.dw_master.getchild("recipientcode", this.idc_recipient)
	this.idc_recipient.settransobject(sqlca)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get datawindow child")
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	this.idc_recipient.retrieve(3)
	this.dw_master.retrieve()
	this.dw_detail.retrieve(3, ll_recipientcode)
	this.dw_master.object.recipientcode[1] = ll_recipientcode
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_retrieve.clicked() returns long
	if parent.dw_master.rowcount() > 0 then
		parent.dw_detail.retrieve(parent.dw_master.object.recipienttypecode[1], parent.dw_master.object.recipientcode[1])
	end if
	return ::message.returnvalue

// rb_both.clicked() returns long
	string ls_filter
	if parent.rb_pop.checked = true then
		ls_filter = "status='Populated'"
	elseif parent.rb_npop.checked = true then
		ls_filter = "status='Pending'"
	else
		ls_filter = ""
	end if
	parent.dw_detail.setredraw(false)
	parent.dw_detail.setfilter(ls_filter)
	parent.dw_detail.filter()
	parent.dw_detail.setredraw(true)
	return ::message.returnvalue

// rb_npop.clicked() returns long
	string ls_filter
	if parent.rb_pop.checked = true then
		ls_filter = "status='Populated'"
	elseif parent.rb_npop.checked = true then
		ls_filter = "status='Pending'"
	else
		ls_filter = ""
	end if
	parent.dw_detail.setredraw(false)
	parent.dw_detail.setfilter(ls_filter)
	parent.dw_detail.filter()
	parent.dw_detail.setredraw(true)
	return ::message.returnvalue

// rb_pop.clicked() returns long
	string ls_filter
	if parent.rb_pop.checked = true then
		ls_filter = "status='Populated'"
	elseif parent.rb_npop.checked = true then
		ls_filter = "status='Pending'"
	else
		ls_filter = ""
	end if
	parent.dw_detail.setredraw(false)
	parent.dw_detail.setfilter(ls_filter)
	parent.dw_detail.filter()
	parent.dw_detail.setredraw(true)
	return ::message.returnvalue

// cb_ok.clicked() returns long
	long[] ll_invcode
	long ll_rowcount
	long ll_counter
	long ll_arrindex
	long ll_thiscode
	boolean lb_remarks
	string ls_date
	if parent.cbx_updateremarks.checked then
		parent.istr_arg.s_name2 = ""
		lb_remarks = true
		parent.istr_arg.i_supress = true
	else
		parent.istr_arg.i_supress = false
	end if
	ll_rowcount = parent.dw_detail.rowcount()
	for ll_counter = 1 to ll_rowcount
		if parent.dw_detail.getitemstring(ll_counter, "selected") = "Y" then
			ll_arrindex = ll_arrindex + 1
			ls_date = string(date(parent.dw_detail.getitemdatetime(ll_counter, "date")), "dd/mm/yyyy")
			ll_thiscode = parent.dw_detail.getitemnumber(ll_counter, "receiptinvcode")
			parent.istr_arg.ia_integerlist[ll_arrindex] = ll_thiscode
			if lb_remarks then
				parent.istr_arg.s_name2 = parent.istr_arg.s_name2 + "GRN No." + trim(string(ll_thiscode)) + "; Date:" + trim(ls_date) + ", "
			end if
		end if
	next
	parent.istr_arg.i_status = 1
	parent.post event ue_close()
	return ::message.returnvalue

// dw_master.itemchanged(long row, dwobject dwo, string data) returns long
	integer ll_retcode
	long ll_recipientcode
	long ll_null
	setnull(ll_null)
	choose case dwo.name
	case "recipienttypecode"
		if isnull(data) or data = "" then
			messagebox("Recipient Type Validation", "Please enter valid Recipient Type ", stopsign!)
			ll_retcode = 1
		else
			parent.idc_recipient.retrieve(long(data))
			parent.dw_master.object.recipientcode[1] = ll_null
		end if
	end choose
	return ll_retcode
