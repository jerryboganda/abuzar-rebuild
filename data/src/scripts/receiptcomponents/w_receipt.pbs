// w_receipt.wf_motorvehicle_retrieve() returns long
	long ll_row
	long ll_code
	this.idc_motorvehicle.settransobject(this.it_transobject)
	this.idc_motorvehicle.retrieve()
	ll_row = this.idc_motorvehicle.insertrow(0)
	setnull(ll_code)
	this.idc_motorvehicle.setitem(ll_row, "code", ll_code)
	this.idc_motorvehicle.setitem(ll_row, "chasisno", "<NONE>")
	this.idc_motorvehicle.setitem(ll_row, "motorvehicle", "<NONE>")
	this.idc_motorvehicle.setitem(ll_row, "customer", "<NONE>")
	this.idc_motorvehicle.scrolltorow(ll_row)
	return 0

// w_receipt.wf_find_motorvehiclecode(string as_chasisno, long al_code) returns long
	long ll_motorvehiclecode
	long ll_retflag
	ll_retflag = 0
	SQL SELECT motorvehiclecode INTO :ll_motorvehiclecode FROM motorvehicle WHERE chasisno =:as_chasisno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_code = ll_motorvehiclecode
		if isnull(al_code) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_receipt.wf_motorvehiclesearch() returns string
	string ls_chasisno
	long ll_res
	long ll_null
	long ll_code
	s_arguements ls_arguements
	setnull(ll_null)
	open(w_vehiclesearch)
	ls_arguements = message.powerobjectparm
	if ls_arguements.i_status = 1 then
		openwithparm(w_vehiclesearchresult, ls_arguements)
		ls_arguements = message.powerobjectparm
		if ls_arguements.i_status = 1 and ls_arguements.l_code1 > 0 then
			this.id_master.object.chasisno[1] = ls_arguements.s_name1
			this.id_master.object.motorvehiclecode[1] = ls_arguements.l_code1
			this.id_master.object.acccode[1] = ls_arguements.l_code2
			this.id_master.object.recipientcode[1] = 2
			event ue_set_requiredcolumns(2, 1)
			ll_code = ls_arguements.l_code1
			wf_set_motorvehicleinfo(ll_code)
			ls_chasisno = this.id_master.object.chasisno[1]
		end if
	end if
	return ls_chasisno

// w_receipt.wf_set_motorvehicleinfo(long al_code) returns long
	long ll_custcode
	long ll_retcode
	string ls_chasisno
	string ls_aliasname
	SQL SELECT MotorVehicle.ChasisNo , MotorVehicle.CustCode , Accounts.AliasName INTO :ls_chasisno, :ll_custcode, :ls_aliasname FROM MotorVehicle , Accounts WHERE MotorVehicle.MotorVehicleCode =:al_code AND MotorVehicle.CustCode =Accounts.AccCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.setitem(this.id_master.rowcount(), "chasisno", ls_chasisno)
		this.id_master.setitem(this.id_master.rowcount(), "acccode", ll_custcode)
		ll_retcode = 1
	else
		messagebox("Motor Vehicle Information", "Problem in retrieving corresponding customer")
		ll_retcode = 0
	end if
	return ll_retcode

// w_receipt.wf_new_motorvehicle() returns long
	string ls_chasisno
	long ll_motorvehiclecode
	long ll_found
	long ll_row
	dwobject dwo
	open(w_motorvehicle)
	ls_chasisno = message.stringparm
	if not (ls_chasisno = "" or isnull(ls_chasisno)) then
		wf_motorvehicle_retrieve()
		ll_found = 0
		ll_found = this.idc_motorvehicle.find("chasisno = '" + ls_chasisno + "'", 1, this.idc_motorvehicle.rowcount())
		if ll_found > 0 then
			this.id_master.setitem(1, "chasisno", this.idc_motorvehicle.getitemstring(ll_found, "chasisno"))
			ll_motorvehiclecode = this.idc_motorvehicle.getitemnumber(ll_found, "code")
			this.id_master.setitem(1, "motorvehiclecode", ll_motorvehiclecode)
			dwo = this.id_master.object.motorvehiclecode
			this.id_master.post event itemchanged(1, dwo, string(ll_motorvehiclecode))
		end if
	end if
	return 0

// w_receipt.wf_setitemslist(integer al_issueinvcode) returns integer
	long ll_found
	if al_issueinvcode > 0 then
		this.id_itemslist.dataobject = "ddd_issueinvitems"
		this.id_itemslist.settransobject(sqlca)
		this.ids_issue.retrieve(al_issueinvcode)
		if this.ids_issue.rowcount() = 0 then
			this.ids_issue.insertrow(0)
			this.ids_issue.setrow(1)
		end if
		this.ids_issue.sharedata(this.id_itemslist)
	else
		this.id_itemslist.dataobject = gd_itemsinfo.dataobject
		this.id_itemslist.settransobject(sqlca)
		gd_itemsinfo.sharedata(this.id_itemslist)
		wf_itemslistcolvisibility()
	end if
	return 0

// w_receipt.wf_itemslistcolvisibility() returns integer
	long ll_found
	this.id_itemslist.setredraw(false)
	if f_stringpreferences("itemcode") = "N" then
		this.id_itemslist.object.fullcode.visible = false
	end if
	if f_stringpreferences("localitemname") = "N" then
		this.id_itemslist.object.localitemname.visible = false
	end if
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("itempackingdesc") = "N" then
		this.id_itemslist.object.packingdesc.visible = false
	end if
	if f_stringpreferences("itemlocation") = "N" then
		this.id_itemslist.object.location.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_pstock.visible = true
	this.id_itemslist.object.pstock.visible = true
	this.id_itemslist.object.t_sstock.visible = false
	this.id_itemslist.object.sstock.visible = false
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.sstock.visible = false
	end if
	this.id_itemslist.setredraw(true)
	return 0

// w_receipt.wf_validate_issue(long al_code) returns long
	long ll_code
	long ll_deptcode
	long ll_areacode
	long ll_smancode
	long ll_recipientcode
	long ll_acccode
	long ll_recipientsalesman
	string ls_remarks
	string ls_referenceno
	string ls_posted
	datetime ldt_referencedate
	long ll_counter
	long ll_rowcount
	SQL SELECT IssueInvCode , DeptCode , Remarks , AreaCode , SManCode , ReferenceNo , ReferenceDate , RecipientCode , AccCode , RecipientSalesMan , Posted INTO :ll_code, :ll_deptcode, :ls_remarks, :ll_areacode, :ll_smancode, :ls_referenceno, :ldt_referencedate, :ll_recipientcode, :ll_acccode, :ll_recipientsalesman, :ls_posted FROM IssueHeader WHERE IssueInvCode =:al_code USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ls_posted = "N" then
			messagebox("Issue Invoice Validation", "Issue Invoice is not posted", stopsign!)
			return 1
		elseif isnull(ll_code) or ll_code < 0 then
			messagebox("Issue Invoice Validation", "Please enter valid Issue Invoice No.", stopsign!)
			return 1
		else
			ll_rowcount = this.id_detail.rowcount()
			for ll_counter = 1 to ll_rowcount
				triggerevent("ue_deleteitem")
			next
			triggerevent("ue_newitem")
			this.id_master.object.recipientcode[1] = ll_recipientcode
			post event ue_set_requiredcolumns(ll_recipientcode, 1)
			this.id_master.object.deptcode[1] = ll_deptcode
			this.id_master.object.acccode[1] = ll_acccode
			this.id_master.object.remarks[1] = ls_remarks
			this.id_master.object.areacode[1] = ll_areacode
			this.id_master.object.smancode[1] = ll_smancode
			this.id_master.object.referenceno[1] = ls_referenceno
			this.id_master.object.referencedate[1] = ldt_referencedate
			this.id_master.object.recipientsalesman[1] = ll_recipientsalesman
			wf_setitemslist(al_code)
			return 0
		end if
		return
	end if
	messagebox("Receipt Invoice Validation", "Receipt Invoice Does not Exist.", stopsign!)
	return 1

// w_receipt.wf_inititeminfo(datawindowchild adc_itemdddw, long al_issueinvcode, long al_dsrow, long al_detaildwrow, string as_errtext) returns long
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_issuerowid
	long ll_totalpieces
	long ll_piecesinhand
	double ld_saleprice
	double ld_basicdatasaleprice
	double ld_packcapacity
	double ld_areavolume
	string ls_fullcode
	string ls_batch
	string ls_itemname
	string ls_remarks
	string ls_alternatecustomicode
	string ls_null
	datetime ld_expiry
	integer li_errcode
	long ll_currentrowinlist
	double ld_retableqty
	double ld_itemprevqty
	double ld_itemissueqty
	double ld_stock
	double ld_alternatepurprice
	double ld_avgprice
	double ld_totalstock
	setnull(ls_null)
	ll_currentrowinlist = al_detaildwrow
	ll_icode = this.id_itemslist.getitemnumber(ll_currentrowinlist, "icode")
	SQL SELECT saleprice , packunits , totalpieces , remarks , alternatepurprice , item.packcapacity , item.areavolume INTO :ld_basicdatasaleprice, :ll_packunits, :ll_piecesinhand, :ls_remarks, :ld_alternatepurprice, :ld_packcapacity, :ld_areavolume FROM Item WHERE icode =:ll_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_gcode = this.id_itemslist.getitemnumber(ll_currentrowinlist, "gcode")
		ll_icode = this.id_itemslist.getitemnumber(ll_currentrowinlist, "icode")
		ls_fullcode = this.id_itemslist.getitemstring(ll_currentrowinlist, "fullcode")
		ls_alternatecustomicode = this.id_itemslist.getitemstring(ll_currentrowinlist, "alternatecustomicode")
		ls_batch = this.id_itemslist.getitemstring(ll_currentrowinlist, "batch")
		ld_expiry = this.id_itemslist.getitemdatetime(ll_currentrowinlist, "Expiry")
		ld_saleprice = this.id_itemslist.getitemnumber(ll_currentrowinlist, "saleprice")
		ld_itemissueqty = this.id_itemslist.getitemnumber(ll_currentrowinlist, "issueqty")
		ll_issuerowid = this.id_itemslist.getitemnumber(ll_currentrowinlist, "issrowid")
		ll_totalpieces = this.id_itemslist.getitemnumber(ll_currentrowinlist, "totalpieces")
		ld_avgprice = this.id_itemslist.getitemnumber(ll_currentrowinlist, "avgprice")
		ll_piecesinhand = ll_totalpieces
		ls_itemname = this.id_itemslist.getitemstring(ll_currentrowinlist, "itemname")
		this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_totalstock)
		if wf_itemprevqty(al_issueinvcode, ll_issuerowid, ll_icode, ld_itemprevqty) = 0 then
			ld_retableqty = ld_itemissueqty - ld_itemprevqty
			if ld_retableqty > 0.0 then
				this.id_detail.setitem(al_detaildwrow, "gcode", ll_gcode)
				this.id_detail.setitem(al_detaildwrow, "issuerowid", ll_issuerowid)
				this.id_detail.setitem(al_detaildwrow, "icode", ll_icode)
				this.id_detail.setitem(al_detaildwrow, "fullcode", ls_fullcode)
				this.id_detail.setitem(al_detaildwrow, "alternatecustomicode", ls_alternatecustomicode)
				this.id_detail.setitem(al_detaildwrow, "batch", ls_batch)
				this.id_detail.setitem(al_detaildwrow, "expiry", ld_expiry)
				this.id_detail.setitem(al_detaildwrow, "price", ld_saleprice)
				this.id_detail.setitem(al_detaildwrow, "qty", ld_retableqty)
				this.id_detail.setitem(al_detaildwrow, "receivableqty", ld_retableqty)
				this.id_detail.setitem(al_detaildwrow, "stock", ld_stock)
				this.id_detail.setitem(al_detaildwrow, "totalstock", ld_totalstock)
				this.id_detail.setitem(al_detaildwrow, "packunits", ll_packunits)
				this.id_detail.setitem(al_detaildwrow, "totalpieces", ll_totalpieces)
				this.id_detail.setitem(al_detaildwrow, "piecesinhand", ll_piecesinhand)
				this.id_detail.setitem(al_detaildwrow, "avgprice", ld_avgprice)
				this.id_detail.setitem(al_detaildwrow, "itemdescription", ls_remarks)
				this.id_detail.setitem(al_detaildwrow, "itemname", ls_itemname)
				this.id_detail.setitem(al_detaildwrow, "price", ld_basicdatasaleprice / ll_packunits)
				this.id_detail.setitem(al_detaildwrow, "itemcode", ll_icode)
				this.id_footer.setitem(1, "stock", ld_stock)
				this.id_footer.setitem(1, "totalstock", ld_totalstock)
			else
				as_errtext = "Item Qty has already been Received"
				li_errcode = 1
			end if
		else
			li_errcode = -1
			as_errtext = "Issue invoice information can not retrieved"
		end if
	else
		li_errcode = -1
		as_errtext = "Unable To Retrieve Price from Item Basic Data"
	end if
	return li_errcode

// w_receipt.wf_itemprevqty(long al_issueinvcode, long al_issuerowid, long al_icode, double al_itemprevqty) returns long
	SQL SELECT IsNull ( Sum ( qty ) , 0 ) INTO :al_itemprevqty FROM ReceiptHeader , ReceiptDetail WHERE ReceiptHeader.IssueInvCode =:al_issueinvcode And ReceiptHeader.ReceiptInvcode =ReceiptDetail.ReceiptInvCode And ReceiptDetail.ICode =:al_icode And ReceiptDetail.IssueRowId =:al_issuerowid USING this.it_transobject;
	if isnull(al_itemprevqty) then
		al_itemprevqty = 0
	end if
	return this.it_transobject.sqlcode

// w_receipt.wf_inititeminfo(datawindowchild adc_itemdddw, long al_row, long al_dddwrow, string as_errtext) returns integer
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_issueinvcode
	long ll_totalpieces
	long ll_piecesinhand
	long ll_issuerowid
	double ld_saleprice
	double ld_discperc
	double ld_basicdatasaleprice
	double ld_avgprice
	string ls_fullcode
	string ls_batch
	string ls_itemname
	string ls_remarks
	string ls_alternatecustomicode
	datetime ld_expiry
	integer li_errcode
	double ld_retableqty
	double ld_stock
	double ld_totalstock
	double ld_itemprevqty
	double ld_itemissueqty
	double ld_itemprevqty_oncurrentinv
	double ld_alternatepurprice
	double ld_packcapacity
	double ld_areavolume
	ll_issueinvcode = this.id_master.getitemnumber(this.id_master.getrow(), "IssueInvCode")
	if ll_issueinvcode > 0 then
		ll_icode = this.id_itemslist.getitemnumber(al_dddwrow, "icode")
		SQL SELECT saleprice , packunits , totalpieces , remarks , alternatepurprice , item.packcapacity , item.areavolume INTO :ld_basicdatasaleprice, :ll_packunits, :ll_piecesinhand, :ls_remarks, :ld_alternatepurprice, :ld_packcapacity, :ld_areavolume FROM Item WHERE icode =:ll_icode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			ll_gcode = this.id_itemslist.getitemnumber(al_dddwrow, "gcode")
			ll_icode = this.id_itemslist.getitemnumber(al_dddwrow, "icode")
			ls_fullcode = this.id_itemslist.getitemstring(al_dddwrow, "fullcode")
			ls_alternatecustomicode = this.id_itemslist.getitemstring(al_dddwrow, "alternatecustomicode")
			ls_batch = this.id_itemslist.getitemstring(al_dddwrow, "batch")
			ld_expiry = this.id_itemslist.getitemdatetime(al_dddwrow, "Expiry")
			ld_saleprice = this.id_itemslist.getitemnumber(al_dddwrow, "saleprice")
			ld_discperc = this.id_itemslist.getitemnumber(al_dddwrow, "discperc")
			ll_issuerowid = this.id_itemslist.getitemnumber(al_dddwrow, "Issuerowid")
			ll_totalpieces = this.id_itemslist.getitemnumber(al_dddwrow, "totalpieces")
			ls_itemname = this.id_itemslist.getitemstring(al_dddwrow, "itemname")
			ld_avgprice = this.id_itemslist.getitemnumber(al_dddwrow, "avgprice")
			ld_retableqty = this.id_itemslist.getitemnumber(al_dddwrow, "issueqty") - this.id_itemslist.getitemnumber(al_dddwrow, "receivedqty")
			if ld_retableqty < 0.0 then
				ld_retableqty = 0
			end if
			if wf_itemprevqty(ll_issueinvcode, ll_issuerowid, ll_icode, ld_itemprevqty) = 0 then
				wf_oninvoiceitemprevqty(al_row, ll_icode, ll_issuerowid, ld_itemprevqty_oncurrentinv, ls_batch, ld_expiry)
				ld_itemissueqty = this.id_itemslist.getitemnumber(al_dddwrow, "Issueqty")
				ld_retableqty = ld_itemissueqty - ld_itemprevqty - ld_itemprevqty_oncurrentinv
				this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_totalstock)
				if ld_retableqty > 0.0 then
					this.id_detail.setitem(al_row, "gcode", ll_gcode)
					this.id_detail.setitem(al_row, "icode", ll_icode)
					this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
					this.id_detail.setitem(al_row, "alternatecustomicode", ls_alternatecustomicode)
					this.id_detail.setitem(al_row, "batch", ls_batch)
					this.id_detail.setitem(al_row, "expiry", ld_expiry)
					this.id_detail.setitem(al_row, "price", ld_saleprice)
					this.id_detail.setitem(al_row, "qty", ld_retableqty)
					this.id_detail.setitem(al_row, "issueableqty", ld_retableqty)
					this.id_detail.setitem(al_row, "stock", ld_stock)
					this.id_detail.setitem(al_row, "totalstock", ld_totalstock)
					this.id_detail.setitem(al_row, "packunits", ll_packunits)
					this.id_detail.setitem(al_row, "piecesinhand", ll_piecesinhand)
					this.id_detail.setitem(al_row, "totalpieces", ll_totalpieces)
					this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
					this.id_detail.setitem(al_row, "itemname", ls_itemname)
					this.id_detail.setitem(al_row, "issuerowid", ll_issuerowid)
					this.id_detail.setitem(al_row, "price", ld_basicdatasaleprice / ll_packunits)
					this.id_detail.setitem(al_row, "itemdescription", ls_remarks)
					this.id_detail.setitem(al_row, "itemcode", ll_icode)
					this.id_footer.setitem(1, "stock", ld_stock)
					this.id_footer.setitem(1, "totalstock", ld_totalstock)
				else
					li_errcode = -1
					as_errtext = "Issue invoice information can not retrieved"
				end if
			end if
		else
			li_errcode = -1
			as_errtext = "Unable To Get Item's Information"
		end if
	else
		li_errcode = -1
		as_errtext = "Please Select Valid Issue Invoice First, Unable To Get Item's Information"
	end if
	return li_errcode

// w_receipt.wf_oninvoiceitemprevqty(long al_row, long al_icode, long al_issuerowid, double al_itemprevqty, string as_batch, datetime adt_expiry) returns integer
	long ll_counter
	long ll_rowcount
	long ll_icode
	long ll_issuerowid
	double ld_holdqty
	double ld_holdbonusqty
	string ls_batch
	datetime ldt_expiry
	ll_rowcount = this.id_detail.rowcount()
	for ll_counter = 1 to al_row - 1
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		ll_issuerowid = this.id_detail.getitemnumber(ll_counter, "issuerowid")
		if ll_icode = al_icode and ll_issuerowid = al_issuerowid then
			ld_holdqty = ld_holdqty + this.id_detail.getitemnumber(ll_counter, "qty")
		end if
	next
	for ll_counter = al_row + 1 to ll_rowcount
		ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
		ll_issuerowid = this.id_detail.getitemnumber(ll_counter, "issuerowid")
		if ll_icode = al_icode and ll_issuerowid = al_issuerowid then
			ld_holdqty = ld_holdqty + this.id_detail.getitemnumber(ll_counter, "qty")
		end if
	next
	al_itemprevqty = ld_holdqty
	return 0

// w_receipt.wf_validate_receipt_on_saving() returns integer
	long ll_counter
	long ll_incounter
	long ll_rowcount
	long ll_icode
	long ll_issueinvcode
	long ll_issuerows
	long ll_gcode
	long ll_found
	string ls_exp
	string ls_itemname
	double ld_issueqty
	double ld_receivedqty
	double ld_unposted_receivedqty
	double ld_itemqty_total
	datastore lds_receivedforissue
	lds_receivedforissue = create datastore
	lds_receivedforissue.dataobject = "ddd_issueinvitems"
	lds_receivedforissue.settransobject(this.it_transobject)
	ll_issueinvcode = this.id_master.object.issueinvcode[1]
	if isnull(ll_issueinvcode) then
		return 0
	end if
	ll_issuerows = lds_receivedforissue.retrieve(ll_issueinvcode)
	ll_rowcount = this.id_detail.rowcount()
	if ll_issueinvcode > 0 and ll_issuerows > 0 then
		for ll_counter = 1 to ll_rowcount
			ll_gcode = this.id_detail.object.gcode[ll_counter]
			ll_icode = this.id_detail.object.icode[ll_counter]
			ls_itemname = this.id_detail.object.itemname[ll_counter]
			ls_exp = "gcode = " + trim(string(ll_gcode)) + " AND icode = " + trim(string(ll_icode))
			ll_found = lds_receivedforissue.find(ls_exp, 1, ll_issuerows)
			if ll_found > 0 and ll_found <= ll_issuerows then
				ld_issueqty = lds_receivedforissue.object.issueqty[ll_found]
				ld_receivedqty = lds_receivedforissue.object.receivedqty[ll_found]
				ld_itemqty_total = this.id_detail.object.qty[ll_counter]
				if ld_receivedqty + ld_itemqty_total > ld_issueqty then
					messagebox("Received Qty Validation", "Issue Invoice Code = " + string(ll_issueinvcode) + "~r~nItem Name = " + ls_itemname + "~r~nReceived Qty Exceeds Issue Qty~r~nIssue Qty = " + string(ld_issueqty) + "~r~nPrev. Received Qty = " + string(ld_receivedqty, "######0.0000") + "~r~nThis Receipt = " + string(ld_itemqty_total, "######0.0000") + "~r~nTotal = " + string(ld_receivedqty + ld_itemqty_total, "######0.0000"), stopsign!)
					this.id_detail.setrow(ll_incounter)
					this.id_detail.setcolumn("Qty")
					return -1
				end if
				return
			end if
		next
	end if
	return 0

// w_receipt.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_receiptmenu" then
		this.menuid = create m_receiptmenu
	end if
	this.dw_purinvrep = create dw_purinvrep
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_purinvrep

// w_receipt.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_purinvrep

// w_receipt.ue_save() returns 0 [event]
	integer li_counter
	long ll_null
	long ll_icode
	long ll_salesmancode
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_detailrows
	long ll_count
	long ll_found
	long ll_receiptcode
	long ll_receiptretcode
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_updatepurprice
	boolean lb_commitflag
	setnull(ll_null)
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 1 then
		for ll_count = 1 to ll_detailrows
			ll_found = 0
			if ll_count = ll_detailrows then
				exit
			end if
			ll_found = this.id_detail.find("gcode = long('" + string(this.id_detail.getitemnumber(ll_count, "gcode")) + "') and " + " icode = long('" + string(this.id_detail.getitemnumber(ll_count, "icode")) + "') and batch = '" + this.id_detail.getitemstring(ll_count, "batch") + "' and expiry = Date('" + string(this.id_detail.getitemdatetime(ll_count, "expiry"), "yyyy-mm-dd") + "')", ll_count + 1, ll_detailrows)
			if ll_found > 0 then
				messagebox("Item Validation", "Duplicate items found at row " + string(ll_count) + " and " + string(ll_found) + "." + "~r~nSuggested options are either delete the row or ~r~n" + "change Item batch or expiry")
				this.id_detail.scrolltorow(ll_count)
				this.id_detail.setcolumn("qty")
				this.id_detail.setfocus()
				return
			end if
		next
	elseif ll_detailrows <= 0 then
		messagebox("On Save Validation", "There are no rows to save.~r~nKindly insert some item row.")
		return
	end if
	if wf_validate_receipt_on_saving() < 0 then
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	if this.id_master.object.accountfor[1] = "N" then
		this.id_master.object.cracccode[1] = ll_null
	end if
	if this.id_master.object.accountfor[1] = "Y" and isnull(this.id_master.object.cracccode[1]) then
		this.id_master.setcolumn("cracccode")
		this.id_master.setfocus()
		return
	end if
	if not this.ib_modifydate and not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		setpointer(hourglass!)
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			f_newtableid("ReceiptHeader", ll_invid)
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
			this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
		else
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
		end if
		ll_receiptcode = this.id_master.getitemnumber(ll_mastercurrrow, "receiptcode")
		if isnull(ll_receiptcode) or ll_receiptcode = 0 then
			ll_receiptretcode = wf_genenerate_receiptcategory_counter(this.ii_category, ll_receiptcode, this.it_transobject)
			if ll_receiptretcode < 0 then
				SQL rollback USING this.it_transobject;
				messagebox("DataBase Problem", "Transaction is Rollback Due to Problem in~r~ngenerating Receipt Code")
				return
			end if
			if ll_receiptcode > 0 then
				this.id_master.setitem(ll_mastercurrrow, "receiptcode", ll_receiptcode)
			end if
		end if
		if not this.ib_modifydate then
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
		else
			ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
		end if
		this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		wf_autoreplacebatches()
		do while li_counter <= ll_detailrows
			this.id_detail.setitem(li_counter, "code", ll_invid)
			ll_icode = this.id_detail.object.icode[li_counter]
			if lb_commitflag and this.id_detail.getitemstatus(li_counter, "purchaseprice", primary!) = datamodified! and ls_updatepurprice = "Y" and wf_updateitempurprice(ll_icode, this.id_detail.getitemnumber(li_counter, "purprice")) <> 0 then
				lb_commitflag = false
			end if
			li_counter = li_counter + 1
		loop
		call super::ue_save
		if lb_commitflag and f_stringpreferences("IncRecInActMonitor") = "Y" then
			this.it_transobject.updateactivitymonitor("RC", ll_invid)
			if this.it_transobject.sqlcode <> 0 then
				SQL rollback USING this.it_transobject;
				messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
			else
				SQL commit USING this.it_transobject;
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_receipt.ue_newform() returns 0 [event]
	m_receiptmenu lm_menu
	integer li_rtncode
	lm_menu = this.menuid
	this.ic_autoreplacebatches = f_stringpreferences("AutoReplaceBatchOnSaving_InReceipt")
	setredraw(false)
	this.idc_section.reset()
	this.idc_section.insertrow(0)
	call super::ue_newform
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	lm_menu.m_file.m_saveandpost.enabled = this.ib_receiptsaveandpost
	wf_setgodownoption()
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	setredraw(true)
	if not wf_validatedate() then
		close(this)
	end if
	li_rtncode = this.id_master.getchild("motorvehiclecode", this.idc_motorvehicle)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_motorvehicle.settransobject(this.it_transobject)
	wf_motorvehicle_retrieve()
	post event ue_set_requiredcolumns(integer(this.id_master.object.recipientcode.initial), 0)
	if f_stringpreferences("ShowQtyInReceipt") = "N" then
		this.id_detail.object.qty.visible = false
		this.id_footer.object.totalstock.visible = false
		this.id_footer.object.totalstock_t.visible = false
		this.id_footer.object.stock.visible = false
		this.id_footer.object.stock_t.visible = false
	end if
	this.ids_issue.reset()
	wf_setitemslist(0)

// w_receipt.ue_detail() returns 0 [event]
	long ll_code
	long ll_deptcode
	long ll_issueinvcode
	integer li_rtncode
	integer li_protect
	boolean lb_modify
	m_receiptmenu lm_menu
	lm_menu = this.menuid
	setredraw(false)
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	this.id_master.retrieve(ll_code)
	ll_deptcode = this.id_master.object.deptcode[this.id_master.getrow()]
	this.idc_section.retrieve(ll_deptcode)
	if this.idc_section.rowcount() = 0 then
		this.idc_section.insertrow(0)
	end if
	call super::ue_detail
	this.im_menu.m_file.m_post.enabled = false
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	this.id_footer.retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	if wf_allowreceiptmodification(ll_code, this.il_groupcode, this.il_strategy) <> 0 then
		this.id_detail.reset()
		messagebox("Invoice Modification Validation", "You Can not modify this Invoice,~r~nGodown settings do not permit this modification.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		if this.ib_receiptmodify then
			lb_modify = true
		end if
		lm_menu.m_file.m_saveandpost.enabled = this.ib_receiptsaveandpost
	end if
	if not lb_modify then
		this.im_menu.m_file.m_save.enabled = false
		this.editflag = false
	else
		li_protect = 0
		wf_initmodify(li_protect)
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_master.object.gcode[1] = this.ii_purchasegodownoption
	end if
	wf_setgodownoption()
	event ue_set_requiredcolumns(this.id_master.object.recipientcode[1], 1)
	this.im_menu.m_file.m_print.enabled = true
	ll_issueinvcode = this.id_master.getitemnumber(1, "issueinvcode")
	if ll_issueinvcode > 0 then
		wf_setitemslist(ll_issueinvcode)
	else
		wf_setitemslist(0)
	end if
	wf_grandtotal()
	setredraw(true)

// w_receipt.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 1 and vf_dwdupcodebatch(this.id_detail, "gcode", gl_defaultgcode, "icode", this.id_detail.getitemnumber(this.id_detail.getrow(), "icode"), "batch", this.id_detail.getitemstring(this.id_detail.getrow(), "batch"), "expiry", this.id_detail.getitemdatetime(this.id_detail.getrow(), "expiry"), this.il_currrow) = true then
		messagebox("Item Validation", "Duplicate item, please select some other item")
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.settransobject(this.it_transobject)
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_receipt.ue_deleteitem() returns 0 [event]
	long ll_row
	ll_row = this.id_detail.getrow()
	if this.id_detail.rowcount() > 0 then
		call super::ue_deleteitem
		return
	end if
	this.im_menu.m_file.m_print.enabled = false

// w_receipt.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	destroy this.ids_itemstockinfo
	return ::message.returnvalue

// w_receipt.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_receipt.ue_list() returns 0 [event]
	m_receiptmenu lm_menu
	call super::ue_list
	lm_menu = this.menuid
	this.im_menu.m_file.m_print.enabled = false
	if this.ib_receiptposting then
		this.im_menu.m_file.m_post.enabled = true
	else
		this.im_menu.m_file.m_post.enabled = false
	end if
	wf_retrievelist()
	this.im_menu.m_file.m_print.enabled = true
	lm_menu.m_file.m_saveandpost.enabled = this.ib_receiptsaveandpost

// w_receipt.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	if this.ii_purchasetype = 1 then
		setpointer(hourglass!)
		this.idc_supplierlist.setredraw(false)
		this.idc_supplierlist.settransobject(this.it_transobject)
		this.idc_supplierlist.reset()
		this.idc_supplierlist.retrieve()
		this.idc_supplierlist.setredraw(true)
		setpointer(arrow!)
	end if

// w_receipt.ue_print() returns 0 [event]
	long ll_suppcode
	long ll_row
	long ll_invcode
	string ls_suppname
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	wf_selectprintreport()
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_receipt.ue_postopen() returns 0 [event]
	integer li_rtncode
	long ll_code
	long ll_counter
	long ll_found
	datetime ldt_defaultexpiry
	date ldt_expdate
	string ls_expdate
	datawindowchild ldc_headerno
	datastore lds_headers
	m_receiptmenu lm_menu
	call super::ue_postopen
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	lm_menu = this.menuid
	this.ids_issue = create datastore
	this.ids_issue.dataobject = "ddd_issueinvitems"
	this.ids_issue.settransobject(sqlca)
	this.ic_issuecompulsion = f_stringpreferences("EnforceIssueCompulsion_InReceipt")
	if isnull(this.ic_issuecompulsion) then
		this.ic_issuecompulsion = "N"
	end if
	setredraw(false)
	f_fetch_sites()
	this.istr_arg = message.powerobjectparm
	this.il_openparm = this.istr_arg.l_code2
	if this.il_openparm = 2 then
		this.title = "Passport Receipt From Customer"
		this.im_menu.m_window.m_refreshcatwise.visible = false
		this.im_menu.m_window.m_refreshcustomize.visible = false
		this.im_menu.m_window.m_refreshdrilldownfilter.visible = false
		this.im_menu.m_window.m_refreshfilterstockitemsonly.visible = false
		this.im_menu.m_window.m_refreshitemnamefilter.visible = false
	else
		this.title = "Receipt - " + this.istr_arg.s_name1
	end if
	this.ii_category = this.istr_arg.l_code1
	this.ic_accountfor = this.istr_arg.s_name2
	this.id_print = this.dw_purinvrep
	this.id_print.settransobject(this.it_transobject)
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit Receipt(s)")
		close(this)
		return
	end if
	li_rtncode = this.id_detail.getchild("gcode", this.idc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_godown.settransobject(this.it_transobject)
	li_rtncode = this.idc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to Receipt")
		close(this)
		return
	end if
	li_rtncode = this.id_master.getchild("recipientcode", this.idc_recipienttype)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_recipienttype.settransobject(this.it_transobject)
	li_rtncode = this.idc_recipienttype.retrieve(this.ii_module, this.il_groupcode)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Recipient Rights to Make Receipt Document(s)")
		close(this)
		return
	end if
	this.id_master.object.recipientcode.initial = trim(string(this.idc_recipienttype.getitemnumber(1, "RecipientCode")))
	if this.idc_recipienttype.rowcount() = 1 then
		this.id_master.object.recipientcode.visible = false
		this.id_master.object.recipientcode_t.visible = false
	end if
	li_rtncode = this.id_detail.getchild("sectcode", this.idc_section)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild for Sections.")
		close(this)
		return
	end if
	this.idc_section.settransobject(this.it_transobject)
	this.idc_section.insertrow(0)
	li_rtncode = this.id_master.getchild("motorvehiclecode", this.idc_motorvehicle)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_motorvehicle.settransobject(this.it_transobject)
	wf_motorvehicle_retrieve()
	this.ii_purchasegodownoption = this.idc_godown.getitemnumber(1, "gcode")
	this.id_detail.object.gcode.initial = string(this.ii_purchasegodownoption)
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = false
	this.id_itemslist.object.sstock.visible = false
	this.id_itemslist.object.t_pstock.visible = true
	this.id_itemslist.object.pstock.visible = true
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.id_detail.object.gcode.visible = false
		this.id_master.object.gcode_t.visible = true
		this.id_master.object.gcode.visible = true
		this.id_master.object.gcode.initial = string(this.ii_purchasegodownoption)
	end if
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Receipts")
		close(this)
		return
	end if
	if f_stringpreferences("headeronreceiptinv") = "N" then
		this.id_master.object.headerno.visible = false
		this.id_master.object.headerno_t.visible = false
	end if
	if f_stringpreferences("showmotorvehicleinreceipt") = "N" then
		this.id_master.object.chasisno_t.visible = false
		this.id_master.object.chasisno.visible = false
		this.id_master.object.motorvehiclecode_t.visible = false
		this.id_master.object.motorvehiclecode.visible = false
	end if
	if f_stringpreferences("showreceiptpricetypecode") = "N" then
		this.id_master.object.pricetypecode_t.visible = false
		this.id_master.object.pricetypecode.visible = false
	end if
	this.id_master.object.pricetypecode.initial = trim(string(f_numberpreferences("receiptpricetypecode")))
	if f_stringpreferences("salespersoninreceipt") = "N" then
		this.id_master.object.smancode.visible = false
		this.id_master.object.smancode_t.visible = false
	end if
	if f_stringpreferences("areainreceipt") = "N" then
		this.id_master.object.areacode.visible = false
		this.id_master.object.areacode_t.visible = false
	end if
	if f_stringpreferences("sectioninreceipt") = "N" then
		this.id_detail.object.sectcode.visible = false
	end if
	if f_stringpreferences("ShowTotalPiecesInReceipt") = "N" then
		this.id_detail.object.piecesinhand.visible = false
		this.id_detail.object.totalpieces.visible = false
		this.id_detail.object.totalpieces.initial = "0"
		this.id_detail.object.totalpieces.validation = "Real (GetText()) >= 0"
	end if
	this.id_master.getchild("headerno", ldc_headerno)
	for ll_counter = 1 to lds_headers.rowcount()
		ldc_headerno.insertrow(0)
		ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
		ldc_headerno.setitem(ll_counter, "name", "")
		ll_found = 0
		ll_found = gds_reoprtheaderinfo.find("headerno=" + string(lds_headers.getitemnumber(ll_counter, "headercode")), 1, gds_reoprtheaderinfo.rowcount())
		if ll_found > 0 then
			ldc_headerno.setitem(ll_counter, "headeralias", gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks"))
		end if
	next
	this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
	this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
	li_rtncode = this.id_master.getchild("cracccode", this.idc_craccount)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_craccount.settransobject(this.it_transobject)
	li_rtncode = this.idc_craccount.retrieve(this.ii_category)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Receipt Category Accounts selection")
		close(this)
		return
	end if
	if this.idc_craccount.rowcount() > 0 then
		this.id_master.object.cracccode.initial = trim(string(this.idc_craccount.getitemnumber(1, "acccode")))
	else
		messagebox("Error", "Not Enough Receipt Category Account Selection")
		close(this)
		return
	end if
	this.id_master.object.receiptcategorycode.initial = trim(string(this.ii_category))
	this.id_master.object.accountfor.initial = this.ic_accountfor
	if this.ic_accountfor = "N" then
		this.id_master.object.cracccode.visible = false
		this.id_master.object.cracccode_t.visible = false
	else
		this.id_master.object.cracccode.dddw.required = "yes"
	end if
	wf_set_itemexpense_interface()
	li_rtncode = this.id_master.getchild("pricetypecode", this.idc_price)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_price.settransobject(this.it_transobject)
	li_rtncode = this.idc_price.retrieve(this.ii_module, this.il_groupcode)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Price Rights to Receipt")
		close(this)
		return
	end if
	if this.idc_price.rowcount() > 0 then
		this.id_master.object.pricetypecode.initial = trim(string(this.idc_price.getitemnumber(1, "pricetypecode")))
	else
		messagebox("Error", "Not Enough Price Rights to Receipt")
		close(this)
		return
	end if
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.pstock.visible = false
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	if f_stringpreferences("alternatecustomicodeinreceipt") = "N" then
		this.id_detail.object.alternatecustomicode.visible = false
	end if
	if f_stringpreferences("ShowPriceInReceipt") = "N" then
		this.id_detail.object.price.visible = false
		this.id_detail.object.c_total.visible = false
		this.id_footer.object.total.visible = false
		this.id_footer.object.t_total.visible = false
	end if
	li_rtncode = this.id_master.getchild("acccode", this.idc_acccode)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild For Accounts DataWindow")
	end if
	this.idc_acccode.settransobject(this.it_transobject)
	this.idc_acccode.retrieve()
	event ue_set_requiredcolumns(1, 1)
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 561 then
			this.ib_receiptposting = true
			this.im_menu.m_file.m_post.visible = true
			this.im_menu.m_file.m_post.toolbaritemvisible = true
			this.im_menu.m_file.m_post.enabled = false
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 562 then
			this.ib_receiptmodify = true
		end if
		if gds_securitywindow.object.rightcode[ll_counter] = 621 then
			this.ib_receiptsaveandpost = true
		end if
	next
	if not this.ib_receiptposting then
		this.im_menu.m_file.m_post.visible = false
		this.im_menu.m_file.m_post.toolbaritemvisible = false
		this.im_menu.m_file.m_post.enabled = false
	end if
	lm_menu.m_file.m_saveandpost.visible = this.ib_receiptsaveandpost
	lm_menu.m_file.m_saveandpost.toolbaritemvisible = this.ib_receiptsaveandpost
	lm_menu.m_file.m_saveandpost.enabled = this.ib_receiptsaveandpost
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 641", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_autobatchgeneration.visible = true
		lm_menu.m_file.m_autobatchgeneration.enabled = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 735", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_populatesaleorder.visible = true
		lm_menu.m_file.m_populatesaleorder.enabled = true
	end if
	this.id_detail.object.batch.initial = f_stringpreferences("defaultbatch")
	this.id_detail.object.expiry.initial = string(f_datepreferences("defaultexpiry"))
	this.id_detail.object.updateavgprice.initial = f_stringpreferences("UpdAvgPriceInReceipt")
	if f_stringpreferences("ShowUpdAvgPriceInReceipt") = "N" then
		this.id_detail.object.updateavgprice.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 693", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.date.protect = 0
		this.id_master.object.date.background.color = rgb(255, 255, 255)
		this.ib_modifydate = true
	end if
	if not this.ib_modifydate then
		this.id_master.object.date.protect = 1
		this.id_master.settaborder("date", 0)
		this.id_master.object.date.background.color = this.backcolor
	end if
	if f_stringpreferences("showbatchinreceipt") = "N" then
		this.id_detail.object.batch.visible = false
	end if
	if f_stringpreferences("showmfgdateinreceipt") = "N" then
		this.id_detail.object.manfdate.visible = false
	end if
	if f_stringpreferences("showexpiryinreceipt") = "N" then
		this.id_detail.object.expiry.visible = false
	end if
	if f_stringpreferences("showitemdescriptioninreceipt") = "N" then
		this.id_detail.object.itemdescription.visible = false
	end if
	if f_stringpreferences("showunitcostinreceipt") = "N" then
		this.id_detail.object.avgprice.visible = false
	end if
	if f_stringpreferences("showtotalcostinreceipt") = "N" then
		this.id_detail.object.c_totalcost.visible = false
	end if
	if f_stringpreferences("showunitweightinreceipt") = "N" then
		this.id_detail.object.unitweight.visible = false
		this.id_detail.object.c_totalweight.visible = false
	end if
	if f_stringpreferences("shownetrateinreceipt") = "N" then
		this.id_detail.object.c_netrate.visible = false
	end if
	if this.ic_issuecompulsion = "Y" then
		this.id_master.object.issueinvcode_t.visible = true
		this.id_master.object.issueinvcode.visible = true
		this.id_master.object.issueinvcode.edit.required = "yes"
	else
		this.id_master.object.issueinvcode_t.visible = false
		this.id_master.object.issueinvcode.visible = false
		this.id_master.object.issueinvcode.edit.required = "no"
		gd_itemsinfo.sharedata(this.id_itemslist)
	end if
	if wf_item_image_setting() < 0 then
		messagebox("Connection Problem", "Problem in connecting database. Kindly Try Again", stopsign!)
		close(this)
	end if
	if not f_rightexists(5277) then
		lm_menu.m_file.m_pullsalesfromdropbox.enabled = false
		lm_menu.m_file.m_pullsalesfromdropbox.visible = false
	end if
	if not f_rightexists(5279) then
		lm_menu.m_file.m_pullissuefromdropbox.enabled = false
		lm_menu.m_file.m_pullissuefromdropbox.visible = false
	end if
	f_setcolumnstyle(this.id_detail, "Qty")
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	setredraw(true)

// w_receipt.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	show()
	return ::message.returnvalue

// w_receipt.ue_callback_popupwindow(any ar_object) returns 0 [event]
	long ll_icode
	long ll_row
	string as_errortext
	super::ue_callback_popupwindow(ar_object)
	ll_icode = long(ar_object)
	ll_row = this.id_detail.getrow()
	if ll_row > 0 and ll_icode > 0 and wf_inititeminfo(ll_icode, ll_row, as_errortext) = false then
		messagebox("Item Error", as_errortext)
	end if

// dw_footer.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	return ::message.returnvalue

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
		return 1
	case "faltdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
		return 1
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
		return 1
	end choose
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_result
	long ll_code
	long ll_manfcode
	long ll_detailrows
	long ll_null
	long ll_counter
	long ll_icode
	long ll_motorvehiclecode
	long ll_res
	long ll_recipientcode
	long ll_custcode
	long rt_code
	double ld_price
	string ls_null
	date ld_null
	dwitemstatus lrs_status
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "recipientcode"
		ll_recipientcode = long(data)
		parent.parent.parent.post event ue_set_requiredcolumns(ll_recipientcode, 0)
	case "pricetypecode"
		parent.setredraw(false)
		if parent.parent.parent.id_detail.getrow() > 0 and isnull(parent.parent.parent.id_detail.getitemnumber(parent.parent.parent.id_detail.getrow(), "icode")) then
			parent.parent.parent.event ue_deleteitem()
		end if
		for ll_counter = 1 to parent.parent.parent.id_detail.rowcount()
			ll_icode = parent.parent.parent.id_detail.getitemnumber(ll_counter, "icode")
			ll_code = parent.parent.parent.wf_setitemprice(ll_icode, ll_counter, long(data))
			if ll_code = -1 then
				parent.setredraw(true)
				messagebox("Database Error", "Item information can not be retrieved")
				return 1
			elseif ll_code = 100 and not isnull(parent.parent.parent.id_detail.getitemstring(1, "itemname")) then
				parent.setredraw(true)
				messagebox("DataBase Error", "Rows not retrieve")
				return 0
			end if
		next
		if parent.parent.parent.id_detail.rowcount() <= 0 then
			parent.parent.parent.event ue_newitem()
			parent.parent.parent.id_master.setfocus()
		end if
		parent.setredraw(true)
	case "deptcode"
		setnull(ll_null)
		for ll_counter = 1 to parent.parent.parent.id_detail.rowcount()
			parent.parent.parent.id_detail.setitem(ll_counter, "sectcode", ll_null)
		next
		parent.parent.parent.idc_section.retrieve(long(data))
		if parent.parent.parent.idc_section.rowcount() = 0 then
			parent.parent.parent.idc_section.insertrow(0)
		end if
	case "suppcode"
		ll_code = long(data)
		parent.parent.parent.wf_setsuppinfo(ll_code, this)
	case "pocode"
		if not isnull(data) and integer(data) <> 0 then
			ll_detailrows = parent.dw_itemsdetail.rowcount()
			if ll_detailrows > 0 then
				lrs_status = parent.dw_itemsdetail.getitemstatus(1, 0, primary!)
				if lrs_status <> new! then
					li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
					if li_result = 2 then
						return 2
					else
						parent.dw_itemsdetail.setredraw(false)
						parent.dw_itemsdetail.reset()
						parent.dw_itemsdetail.insertrow(0)
						parent.dw_itemsdetail.setredraw(true)
					end if
				end if
				ll_code = long(data)
				ll_manfcode = parent.parent.parent.wf_setpurorderinfo(ll_code)
				parent.parent.parent.im_menu.m_file.m_options.enabled = true
				this.object.suppcode.protect = 1
			else
				parent.parent.parent.im_menu.m_file.m_options.enabled = false
				this.object.suppcode.protect = 0
				setnull(ll_manfcode)
				setnull(ls_null)
				setnull(ld_null)
				this.object.manfcode[row] = ll_manfcode
				this.object.manfname[row] = ls_null
				this.object.podate[row] = ld_null
			end if
		end if
	case "workordercode"
		if not (isnull(data) or data = "") then
			if long(data) < 0 then
				messagebox("Work Order No.", "Please enter a valid Work Order No.", stopsign!)
				return 1
			elseif parent.parent.parent.wf_validateworkorder(long(data)) < 0 then
				messagebox("Work Order No.", "Please enter a valid Work Order No.", stopsign!)
				return 1
			end if
		end if
	case "chasisno"
		if not (isnull(data) or data = "") then
			ll_res = parent.parent.parent.wf_find_motorvehiclecode(data, ll_motorvehiclecode)
			if ll_res > 0 then
				setitem(row, "motorvehiclecode", ll_motorvehiclecode)
				rt_code = 0
				SQL SELECT custcode INTO :ll_custcode FROM motorvehicle WHERE motorvehiclecode =:ll_motorvehiclecode USING parent.parent.parent.it_transobject;
				if parent.parent.parent.it_transobject.sqlcode = 0 then
					setitem(row, "motorvehiclecode", ll_motorvehiclecode)
					parent.parent.parent.id_master.setitem(1, "acccode", ll_custcode)
					parent.parent.parent.id_master.setitem(1, "recipientcode", 2)
					parent.parent.parent.id_master.object.acccode.protect = 1
					parent.parent.parent.id_master.object.recipientcode.protect = 1
					ll_recipientcode = 2
					parent.parent.parent.post event ue_set_requiredcolumns(ll_recipientcode, 1)
				else
					messagebox("Motor Vehicle Information", "Problem in retrieving corresponding customer")
					rt_code = 1
				end if
				parent.parent.parent.wf_set_motorvehicleinfo(ll_motorvehiclecode)
			else
				if ll_res = -2 then
					messagebox("Motor Vehicle Validation", "Motor Vehicle with  Chasis no " + data + " is Inactive")
				else
					messagebox("Motor Vehicle Validation", "Motor Vehicle with  Chasis No. " + data + " does not exist")
				end if
				rt_code = 1
			end if
			parent.parent.parent.wf_set_motorvehicleinfo(ll_motorvehiclecode)
		end if
	case "issueinvcode"
		if not (isnull(data) or data = "") then
			if long(data) < 0 then
				messagebox("Issue Invoice Validation", "Please enter a valid Issue Invoice No.", stopsign!)
				return 1
			elseif parent.parent.parent.wf_validate_issue(long(data)) <> 0 then
				return 1
			end if
		end if
	case "motorvehiclecode"
		if not isnull(data) then
			ll_motorvehiclecode = long(data)
			SQL SELECT custcode INTO :ll_custcode FROM motorvehicle WHERE motorvehiclecode =:ll_motorvehiclecode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = 0 then
				parent.parent.parent.id_master.setitem(1, "Acccode", ll_custcode)
				parent.parent.parent.id_master.setitem(1, "recipientcode", 2)
				parent.parent.parent.id_master.object.acccode.protect = 1
				parent.parent.parent.id_master.object.recipientcode.protect = 1
				ll_recipientcode = 2
				parent.parent.parent.post event ue_set_requiredcolumns(ll_recipientcode, 1)
			else
				messagebox("Motor Vehicle Information", "Problem in retrieving corresponding customer")
				rt_code = 1
			end if
			if parent.parent.parent.wf_set_motorvehicleinfo(ll_motorvehiclecode) = 0 then
				messagebox("Motor Vehicle Validation", "Motor Vehicle does not exist or Already Inactive.")
				return 1
			end if
		end if
	end choose
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "suppcode"
		messagebox("Supplier Name Validation", "You must select some supplier")
		return 1
	end choose
	return ::message.returnvalue

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf9! then
		parent.parent.parent.ic_autoreplacebatches = parent.parent.parent.wf_get_preference("AutoReplaceBatchOnSaving_InReceipt")
		if not (parent.parent.parent.ic_autoreplacebatches = "Y" or parent.parent.parent.ic_autoreplacebatches = "N") then
			parent.parent.parent.ic_autoreplacebatches = "N"
		end if
	elseif key = keyf5! and (getcolumnname() = "motorvehiclecode" or getcolumnname() = "chasisno") then
		parent.parent.parent.wf_new_motorvehicle()
	elseif key = keyf6! and (getcolumnname() = "motorvehiclecode" or getcolumnname() = "chasisno") then
		parent.parent.parent.wf_motorvehiclesearch()
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	long ll_null
	long ll_currentrow
	long ll_icode
	long ll_itemtypecode
	string ls_null
	string ls_itemname
	datetime ldt_expiry
	date ld_expiry
	time lt_expiry
	string ls_error
	double ld_bonusqty
	double ld_packqty
	double ld_defaultqty
	double ld_newqty
	double ld_storedqty
	double ld_stock
	datawindowchild ldc_items
	dwitemstatus lrs_status
	double ld_godownstock
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	ll_currentrow = getrow()
	lrs_status = getitemstatus(ll_currentrow, 0, primary!)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
		parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		li_errcode = 0
	case "icode"
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	case "qty"
		if parent.parent.parent.id_master.object.issueinvcode[1] > 0 then
			if double(data) > this.object.issueableqty[row] then
				messagebox("Receipt Qty Validation", "Receipt Qty exceeds issued qty.", stopsign!)
				return 1
			end if
		elseif double(data) <= 0.0 then
			return 1
		end if
	case "bonusqty"
		ld_bonusqty = double(data)
		ld_packqty = getitemnumber(row, "packqty")
		if ld_packqty + ld_bonusqty <= 0.0 then
			setitem(row, "packqty", ld_defaultqty)
		end if
	case "packqty"
		ld_packqty = double(data)
		ld_bonusqty = getitemnumber(row, "bonusqty")
		if ld_packqty + ld_bonusqty <= 0.0 then
			setitem(row, "bonusqty", ld_defaultqty)
		end if
	case "gcode"
		accepttext()
		parent.parent.parent.it_transobject.getitemstocktotal(getitemnumber(row, "gcode"), getitemnumber(row, "icode"), ld_godownstock)
		parent.parent.parent.id_footer.setitem(1, "stock", ld_godownstock)
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname, ll_itemtypecode, parent.parent.parent.idbl_packqty, parent.parent.parent.idbl_purprice, parent.parent.parent.idbl_saleprice)
			if li_res > 0 then
				if parent.parent.parent.idbl_packqty <= 0.0 or isnull(parent.parent.parent.idbl_packqty) then
					parent.parent.parent.idbl_packqty = 1
				end if
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				if ll_itemtypecode = 2 then
					setitem(row, "alternatecustomicode", data)
					setitem(row, "qty", parent.parent.parent.idbl_packqty)
					setitem(row, "saleprice", parent.parent.parent.idbl_saleprice / parent.parent.parent.idbl_packqty)
					setitem(row, "purchaseprice", parent.parent.parent.idbl_purprice / parent.parent.parent.idbl_packqty)
					setitem(row, "price", parent.parent.parent.idbl_saleprice / parent.parent.parent.idbl_packqty)
				else
					setitem(row, "alternatecustomicode", ls_null)
				end if
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
			else
				messagebox("ItemNumber Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_errcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_errcode = 2
		end if
	case "batch"
		if data = "" or isnull(data) then
			messagebox("Batch Validation", "Please enter a valid batch no.", stopsign!)
			return 1
		elseif vf_dwdupcodebatch(this, "gcode", parent.parent.parent.id_detail.object.gcode[row], "icode", parent.parent.parent.id_detail.object.icode[row], "batch", data, "expiry", parent.parent.parent.id_detail.object.expiry[row], row) = true then
			messagebox("Item Validation", "Duplicate item, please select some other item")
			li_errcode = 1
		end if
	case "expiry"
		ld_expiry = date(mid(data, 1, 10))
		lt_expiry = time("00:00:00.000000")
		ldt_expiry = datetime(ld_expiry, lt_expiry)
		if ld_expiry <= today() then
			messagebox("Item Validation", "Expiry should be greater than today's date")
			li_errcode = 1
		elseif rowcount() > 1 and ldt_expiry <> datetime("00/00/0000, 00:00:00") and not (isnull(this.object.icode[row]) and isnull(this.object.batch[row]) and isnull(this.object.expiry[row])) and vf_dwdupcodebatch(this, "gcode", gl_defaultgcode, "icode", getitemnumber(getrow(), "icode"), "batch", getitemstring(getrow(), "batch"), "expiry", ldt_expiry, parent.parent.parent.il_currrow) = true then
			messagebox("Item Validation", "Duplicate item, please select some other item")
			li_errcode = 1
		end if
	case "totalpieces"
		if long(data) >= 0 then
			return 0
		else
			messagebox("Item Total Pieces Validation", "Please enter valid value for total pieces receipt for this item", stopsign!)
			return 0
		end if
		return
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ancestorreturnvalue
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "itemname" then
		parent.parent.parent.ib_focusdetail = true
	end if
	if dwo.name = "sectcode" then
		parent.parent.parent.idc_section.retrieve(parent.parent.parent.id_master.getitemnumber(1, "deptcode"))
	end if
	parent.parent.parent.wf_grandtotal()
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if getcolumnname() <> parent.parent.parent.is_columnitemname then
		if rowcount() > 0 and lrs_status <> new! then
			parent.parent.parent.wf_set_itemimage(getitemnumber(currentrow, "icode"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", getitemnumber(currentrow, "icode"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", getitemnumber(currentrow, "stock"))
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", getitemnumber(currentrow, "totalstock"))
		elseif parent.parent.parent.id_footer.getrow() > 0 then
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "icode", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "stock", 0)
			parent.parent.parent.id_footer.setitem(parent.parent.parent.id_footer.getrow(), "totalstock", 0)
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "fullcode"
		if isnull(data) or data = "" then
			messagebox("Item Code Validation", "Item Code ~"" + data + "~" does not exist")
		end if
		return 1
	case parent.parent.parent.is_columnitemname
		messagebox("Item Validation", "Value required for item in current row")
		return 1
	case "icode"
		messagebox("Item Validation", "Value required for item in current row")
		return 1
	case "looseqty"
		messagebox("Item Qty Validation", "Item Qty ~"" + data + "~" should be greater than zero")
		return 1
	case "discperc"
		messagebox("Item Discount Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
		return 1
	case "purprice"
		messagebox("Item Price Validation", "Item price ~"" + data + "~" must be greater than zero")
		return 1
	case "expiry"
		return 1
	end choose
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	long ancestorreturnvalue
	if f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	if getrow() = rowcount() then
		if getcolumn() = integer(this.object.datawindow.column.count) then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
		if f_stringpreferences("ShowQtyInReceipt") = "N" and getcolumnname() = "itemname" then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
		return
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_icode
	long ll_found
	long ll_rowm
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollnextrow()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyuparrow! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollpriorrow()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keypagedown! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollnextpage()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keypageup! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollpriorpage()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyend! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrolltorow(99999)
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyhome! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrolltorow(1)
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf8! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("namesearch", 1)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf9! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("criteriasearch", 1)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf4! then
			parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
			setredraw(true)
		elseif key = keyf5! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			parent.parent.parent.wf_open_item_form_popup()
			setfocus()
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			if parent.parent.parent.id_itemslist.rowcount() > 0 then
				setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
			end if
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		elseif rt_code = 2 then
			ll_rowm = getrow()
			parent.parent.parent.id_itemslist.selectrow(0, false)
			if getrow() > 0 then
				ll_listcurrrow = parent.parent.parent.id_itemslist.find("itemname = '" + this.object.itemname[ll_rowm] + "'", 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_listcurrrow > 0 and ll_listcurrrow <= parent.parent.parent.id_itemslist.rowcount() then
					parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
					setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
					setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
					setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
					selecttext(1, len(gettext()))
					parent.parent.parent.ib_itemvalidated = true
					parent.parent.parent.il_currrow = ll_rowm
					setitem(ll_rowm, "CurrListRow", ll_listcurrrow)
					setredraw(true)
				end if
				rt_code = 0
			end if
		end if
	elseif key = keydownarrow! then
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_focusfooter")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	end if
	return rt_code
