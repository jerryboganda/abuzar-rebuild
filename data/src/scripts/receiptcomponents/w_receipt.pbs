// window w_receipt (receiptcomponents)  ancestor: w_multi_entry

// w_receipt.ue_set_requiredcolumns(long al_recipientcode, long al_mode) returns 0 [event]
	long ll_value
	long li_rtncode
	long ll_acccode
	long ll_deptcode
	long ll_recipientsalesman
	string ls_custfilterstring
	setnull(ll_value)
	if this.id_master.rowcount() > 0 then
		ll_acccode = this.id_master.object.acccode[1]
		ll_deptcode = this.id_master.object.deptcode[1]
		ll_recipientsalesman = this.id_master.object.recipientsalesman[1]
	end if
	if al_mode = 0 then
		this.id_master.object.deptcode[1] = ll_value
		this.id_master.object.recipientsalesman[1] = ll_value
		this.id_master.object.acccode[1] = ll_value
	end if
	this.id_master.object.deptcode.dddw.required = "no"
	this.id_master.object.recipientsalesman.dddw.required = "no"
	this.id_master.object.acccode.dddw.required = "no"
	if al_recipientcode = 1 then
		this.id_master.object.deptcode.dddw.required = "yes"
	elseif al_recipientcode = 2 then
		this.id_master.object.acccode.dddw.required = "yes"
	elseif al_recipientcode = 3 then
		this.id_master.object.acccode.dddw.required = "yes"
	elseif al_recipientcode = 4 then
		this.id_master.object.recipientsalesman.dddw.required = "yes"
	end if
	if al_recipientcode = 1 then
		this.id_master.object.deptcode.visible = 1
		this.id_master.settaborder("deptcode", 40)
		this.id_master.object.recipientsalesman.visible = 0
		this.id_master.settaborder("recipientsalesman", 0)
		this.id_master.object.acccode.visible = 0
		this.id_master.settaborder("acccode", 0)
		this.id_master.object.deptcode[1] = ll_deptcode
	elseif al_recipientcode = 2 then
		this.id_master.object.deptcode.visible = 0
		this.id_master.settaborder("deptcode", 0)
		this.id_master.object.recipientsalesman.visible = 0
		this.id_master.settaborder("recipientsalesman", 0)
		this.id_master.object.acccode.visible = 1
		this.id_master.settaborder("acccode", 40)
		this.id_master.getchild("acccode", this.idc_acccode)
		this.idc_acccode.settransobject(this.it_transobject)
		if f_stringpreferences("GroupCustomerCategory") = "Y" then
			this.il_groupcode = f_getgroupcode(gl_usercode)
			ls_custfilterstring = "0                                                                                                                                                                                                             "
			this.it_transobject.getallowedgroupcustomercategory(this.il_groupcode, ls_custfilterstring)
			if ls_custfilterstring = " " or ls_custfilterstring = "" or isnull(ls_custfilterstring) then
				ls_custfilterstring = "0"
				messagebox("Group Customer Category Validation", "Current user group does not have enough permissions w.r.t customer to make sale.~r~nIn order to make sale kindly assign customer categories to this user group ~r~n using Group Customer Category module.~r~nOR~r~nDisable Group Customer Category from Preferences.")
			end if
			this.idc_acccode.setfilter("custcatcode In (" + ls_custfilterstring + ") and subcode = 3")
		else
			this.idc_acccode.setfilter("subcode = 3")
		end if
		this.idc_acccode.filter()
		if this.idc_acccode.rowcount() > 0 then
			this.id_master.object.acccode[1] = this.idc_acccode.getitemnumber(1, "acccode")
		end if
		this.id_master.object.acccode[1] = ll_acccode
	elseif al_recipientcode = 3 then
		this.id_master.object.deptcode.visible = 0
		this.id_master.settaborder("deptcode", 0)
		this.id_master.object.recipientsalesman.visible = 0
		this.id_master.settaborder("recipientsalesman", 0)
		this.id_master.object.acccode.visible = 1
		this.id_master.settaborder("acccode", 40)
		this.id_master.getchild("acccode", this.idc_acccode)
		this.idc_acccode.settransobject(this.it_transobject)
		this.idc_acccode.setfilter("subcode = 7")
		this.idc_acccode.filter()
		if this.idc_acccode.rowcount() > 0 then
			this.id_master.object.acccode[1] = this.idc_acccode.getitemnumber(1, "acccode")
		end if
		this.id_master.object.acccode[1] = ll_acccode
	elseif al_recipientcode = 4 then
		this.id_master.object.deptcode.visible = 0
		this.id_master.settaborder("deptcode", 0)
		this.id_master.object.recipientsalesman.visible = 1
		this.id_master.settaborder("recipientsalesman", 40)
		this.id_master.object.acccode.visible = 0
		this.id_master.settaborder("acccode", 0)
		this.id_master.object.recipientsalesman[1] = ll_recipientsalesman
	end if

// w_receipt.ue_populate_from_datacarrydb() returns 0 [event]
	long ll_icode
	long ll_row
	long ll_saleinvcode
	long ll_counter
	long ll_qty
	long ll_bonusqty
	long ll_suppcode
	long ll_check_for_basicdata_sync
	boolean retflag
	double ld_purprice
	double ld_discperc
	double ld_itemflatdisc
	double ld_saleprice
	double ld_avgprice
	double ld_packsalestax
	double ld_gstperc
	double ld_rpp
	double ld_unitsalestax
	double ld_itempurprice
	double ld_rate
	double ld_rpp2
	double ld_rpp3
	double ld_rpp4
	double ld_rpp5
	double ld_invdiscperc
	double ld_invflatdisc
	double ld_invmisccharges
	double ld_invgstperc1
	double ld_godownstock
	double ld_allgodownstock
	long ll_packunits
	long ll_itemscount
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_batch
	string ls_itemtotalval
	string ls_packingdesc
	string ls_errortext
	string ls_error_syntax
	string ls_connsetting
	string ls_saleledgerquery
	string ls_saledetailquery
	string ls_newsyntax
	string ls_suppinvcode
	string ls_suppinvcode_tmp
	datetime ldt_expiry
	datastore lds_saleledger
	datastore lds_saledetail
	s_arguements lstr_arguments
	u_transaction lt_transobject
	if wf_iseditable() = false then
		return
	end if
	if isnull(this.id_master.object.recipientcode[this.id_master.rowcount()]) then
		messagebox("Recipient Validation!", "Kindly Select a Recipient first")
		return
	elseif isnull(this.id_master.object.acccode[this.id_master.rowcount()]) and isnull(this.id_master.object.deptcode[this.id_master.rowcount()]) and isnull(this.id_master.object.recipientsalesman[this.id_master.rowcount()]) then
		messagebox("Recipient Validation!", "Kindly Select a Recipient first")
		return
	end if
	open(w_populate_sale_from_datacarrydb)
	lstr_arguments = message.powerobjectparm
	if lstr_arguments.i_status <= 0 then
		return
	end if
	ll_saleinvcode = lstr_arguments.l_code1
	lt_transobject = create u_transaction
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Problem", "Unable to connect to database.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		return
	end if
	SQL EXECUTE IMMEDIATE :ls_connsetting USING lt_transobject;
	if ll_saleinvcode > 0 then
		setpointer(hourglass!)
		ll_check_for_basicdata_sync = f_check_for_basicdata_sync()
		if ll_check_for_basicdata_sync < 0 then
			return
		end if
		lds_saleledger = create datastore
		lds_saledetail = create datastore
		ls_saleledgerquery = "Select ~tSaleInvCode, SaleCatCode, CustCode, SalesmanCode, date, DiscPerc, FlatDisc, MiscCharges, SalesTax,  Posted, PostDate, Remarks, CustRefNo, headerno, headerinvno, OriginalDate, ModifiedBy,PostedBy, InvGSTPerc1, InvTotal " + "From ~t" + gs_inlinkserver + "." + gs_inlinkserverdb + "." + gs_inlinkserverowner + "." + "SaleLedger " + "Where   Saleinvcode = " + string(ll_saleinvcode)
		ls_saledetailquery = "Select ~tSaleInvcode, ICode, GCode, Batch, Expiry, PackQty, LooseQty, PackUnits, SalePrice, AvgPrice, Rate, DiscPerc, SalesTax, RowID, itemflatdisc, SaleItemDescription, PackPrice, UnitSalesTax, GSTPerc, SaleUtn, bonusqty, RowGroup " + "From ~t" + gs_inlinkserver + "." + gs_inlinkserverdb + "." + gs_inlinkserverowner + "." + "SaleDetail " + "Where ~tSaleInvCode = " + string(ll_saleinvcode)
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_saleledgerquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For SaleLedger DataStore")
			return
		else
			ls_error_syntax = ""
			lds_saleledger.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For SaleLedger DataStore")
				return
			end if
		end if
		lds_saleledger.settransobject(lt_transobject)
		if lds_saleledger.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source SaleLedger.")
			return
		end if
		ls_newsyntax = ""
		ls_error_syntax = ""
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_saledetailquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For SaleDetail DataStore")
			return
		else
			ls_error_syntax = ""
			lds_saledetail.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For SaleDetail DataStore")
				return
			end if
		end if
		lds_saledetail.settransobject(lt_transobject)
		if lds_saledetail.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source SaleDetail.")
			return
		end if
		this.id_master.setitem(1, "referenceno", trim(string(ll_saleinvcode)))
		this.id_master.setitem(1, "referencedate", lstr_arguments.d_sdate)
		for ll_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_counter = 1 to lds_saledetail.rowcount()
			ll_row = this.id_detail.insertrow(0)
			ll_icode = lds_saledetail.getitemnumber(ll_counter, "icode")
			wf_inititeminfo(ll_icode, ll_counter, ls_errortext)
			ll_qty = lds_saledetail.getitemnumber(ll_counter, "looseqty")
			ll_bonusqty = lds_saledetail.getitemnumber(ll_counter, "bonusqty")
			ld_purprice = lds_saledetail.getitemnumber(ll_counter, "saleprice")
			ld_saleprice = lds_saledetail.getitemnumber(ll_counter, "saleprice")
			ld_discperc = lds_saledetail.getitemnumber(ll_counter, "discperc")
			ld_itemflatdisc = lds_saledetail.getitemnumber(ll_counter, "itemflatdisc")
			ld_unitsalestax = lds_saledetail.getitemnumber(ll_counter, "unitsalestax")
			ld_gstperc = lds_saledetail.getitemnumber(ll_counter, "gstperc")
			ls_batch = lds_saledetail.getitemstring(ll_counter, "batch")
			ldt_expiry = lds_saledetail.getitemdatetime(ll_counter, "expiry")
			ld_purprice = ld_purprice - ld_itemflatdisc
			SQL SELECT item.customicode , item.name , item.gcode , item.purprice , item.packsalestax , item.avgprice , item.recentpurprice , item.recentpurprice2 , recentpurprice3 , recentpurprice4 , recentpurprice5 , item.packingdesc , item.packunits INTO :ls_fullcode, :ls_name, :li_gcode, :ld_itempurprice, :ld_packsalestax, :ld_avgprice, :ld_rpp, :ld_rpp2, :ld_rpp3, :ld_rpp4, :ld_rpp5, :ls_packingdesc, :ll_packunits FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = -1 then
				retflag = false
				ls_errortext = "Database Error: Item information can not be retrieved.~r~nReasons:" + this.it_transobject.sqlerrtext
				messagebox("Item Validation", ls_errortext)
			end if
			if ll_packunits < 1 or isnull(ll_packunits) then
				ll_packunits = 1
			end if
			if this.il_godowncount = 1 and this.il_strategy = 1 then
				this.ii_defaultgcode = this.id_detail.getitemnumber(ll_row, "gcode")
			else
				this.ii_defaultgcode = this.id_detail.getitemnumber(ll_row, "gcode")
			end if
			ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
			this.it_transobject.getitemstocktotal(this.ii_defaultgcode, ll_icode, ld_godownstock)
			this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
			if this.it_transobject.sqlcode = -1 then
				retflag = false
				ls_errortext = "Database Error: Item Stock information can not be retrieved"
			end if
			this.id_detail.setitem(ll_row, "gcode", this.ii_defaultgcode)
			this.id_detail.setitem(ll_row, "icode", ll_icode)
			this.id_detail.setitem(ll_row, this.is_columnitemname, ls_name)
			this.id_detail.setitem(ll_row, "fullcode", ls_fullcode)
			this.id_detail.setitem(ll_row, "packunits", ll_packunits)
			this.id_detail.setitem(ll_row, "price", ld_saleprice)
			this.id_detail.setitem(ll_row, "stock", ld_godownstock)
			this.id_detail.setitem(ll_row, "totalstock", ld_allgodownstock)
			this.id_detail.setitem(ll_row, "batch", ls_batch)
			this.id_detail.setitem(ll_row, "expiry", ldt_expiry)
			this.id_detail.setitem(ll_row, "qty", ll_qty)
			this.id_detail.setitem(ll_row, "purchaseprice", ld_purprice)
			this.id_footer.setitem(1, "stock", ld_godownstock)
			this.id_footer.setitem(1, "totalstock", ld_allgodownstock)
		next
		if this.id_detail.rowcount() > 0 then
			this.im_menu.m_file.m_save.enabled = true
			wf_grandtotal()
		else
			this.im_menu.m_file.m_save.enabled = false
		end if
	end if
	SQL stop USING lt_transobject;

// w_receipt.ue_populate_and_post_from_datacarrydb() returns 0 [event]
	long ll_totrows
	long ll_row
	if wf_iseditable() = false then
		return
	end if
	triggerevent("ue_populate_from_datacarrydb")
	wf_saveandpost()
	if wf_commitform() = true then
		postevent("ue_new")
	else
		ll_totrows = this.id_detail.rowcount()
		if ll_totrows > 0 then
			for ll_row = 1 to ll_totrows
				triggerevent("ue_deleteitem")
			next
		end if
	end if

// w_receipt.ue_pull_sale_from_dropbox() returns 0 [event]
	long ll_icode
	long ll_row
	long ll_saleinvcode
	long ll_counter
	long ll_qty
	long ll_bonusqty
	long ll_suppcode
	long ll_check_for_basicdata_sync
	long ll_sitecode
	boolean retflag
	double ld_purprice
	double ld_discperc
	double ld_itemflatdisc
	double ld_saleprice
	double ld_avgprice
	double ld_packsalestax
	double ld_gstperc
	double ld_rpp
	double ld_unitsalestax
	double ld_itempurprice
	double ld_rate
	double ld_rpp2
	double ld_rpp3
	double ld_rpp4
	double ld_rpp5
	double ld_invdiscperc
	double ld_invflatdisc
	double ld_invmisccharges
	double ld_invgstperc1
	double ld_godownstock
	double ld_allgodownstock
	long ll_packunits
	long ll_itemscount
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_batch
	string ls_itemtotalval
	string ls_packingdesc
	string ls_errortext
	string ls_error_syntax
	string ls_connsetting
	string ls_saleledgerquery
	string ls_saledetailquery
	string ls_newsyntax
	string ls_suppinvcode
	string ls_suppinvcode_tmp
	string ls_prefix
	datetime ldt_expiry
	datastore lds_saleledger
	datastore lds_saledetail
	s_arguements lstr_arguments
	u_transaction lt_transobject
	long ll_totrows
	if wf_iseditable() = false then
		return
	end if
	if isnull(this.id_master.object.recipientcode[this.id_master.rowcount()]) then
		messagebox("Recipient Validation!", "Kindly Select a Recipient first")
		return
	elseif isnull(this.id_master.object.acccode[this.id_master.rowcount()]) and isnull(this.id_master.object.deptcode[this.id_master.rowcount()]) and isnull(this.id_master.object.recipientsalesman[this.id_master.rowcount()]) then
		messagebox("Recipient Validation!", "Kindly Select a Recipient first")
		return
	end if
	open(w_pull_sale_from_dropbox)
	lstr_arguments = message.powerobjectparm
	if lstr_arguments.i_status <= 0 then
		return
	end if
	ll_saleinvcode = lstr_arguments.l_code1
	ll_sitecode = lstr_arguments.l_code2
	lt_transobject = create u_transaction
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Problem", "Unable to connect to database.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		return
	end if
	SQL EXECUTE IMMEDIATE :ls_connsetting USING lt_transobject;
	if ll_saleinvcode > 0 then
		setpointer(hourglass!)
		ll_check_for_basicdata_sync = f_check_for_basicdata_sync()
		if ll_check_for_basicdata_sync < 0 then
			return
		end if
		lds_saleledger = create datastore
		lds_saledetail = create datastore
		ls_prefix = ""
		if gs_dropbox_server = "" or isnull(gs_dropbox_server) then
			ls_prefix = ""
		else
			ls_prefix = gs_dropbox_server + "."
		end if
		if gs_dropbox_db = "" or isnull(gs_dropbox_db) then
			ls_prefix = ls_prefix
		else
			ls_prefix = ls_prefix + gs_dropbox_db + "."
		end if
		ls_saleledgerquery = "Select ~tSiteCode, TargetSitecode, SaleInvCode, SaleCatCode, CustCode, SalesmanCode, date, DiscPerc, FlatDisc, MiscCharges, SalesTax,  Remarks, CustRefNo, InvGSTPerc1, InvTotal " + "From ~t" + ls_prefix + "dbo." + "DB_SaleLedger " + "Where   Saleinvcode = " + string(ll_saleinvcode) + " AND sitecode = " + string(ll_sitecode) + " AND TargetSiteCode = " + string(gl_sitecode) + " AND Pulled='N'"
		ls_saledetailquery = "Select ~tSiteCode, SaleInvcode, ICode, GCode, Batch, Expiry, LooseQty, PackUnits, SalePrice, AvgPrice, Rate, DiscPerc, SalesTax, RowID, itemflatdisc, SaleItemDescription, UnitSalesTax, GSTPerc, SaleUtn, bonusqty, RowGroup " + "From ~t" + ls_prefix + "dbo." + "DB_SaleDetail " + "Where ~tSaleInvCode = " + string(ll_saleinvcode) + " AND sitecode = " + string(ll_sitecode)
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_saleledgerquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For DB_SaleLedger DataStore")
			return
		else
			ls_error_syntax = ""
			lds_saleledger.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For DB_SaleLedger DataStore")
				return
			end if
		end if
		lds_saleledger.settransobject(lt_transobject)
		if lds_saleledger.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source DB_SaleLedger.")
			return
		end if
		ls_newsyntax = ""
		ls_error_syntax = ""
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_saledetailquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For DB_SaleDetail DataStore")
			return
		else
			ls_error_syntax = ""
			lds_saledetail.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For DB_SaleDetail DataStore")
				return
			end if
		end if
		lds_saledetail.settransobject(lt_transobject)
		if lds_saledetail.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source DB_SaleDetail.")
			return
		end if
		this.id_master.setitem(1, "referenceno", trim(string(ll_saleinvcode)))
		this.id_master.setitem(1, "referencedate", lstr_arguments.d_sdate)
		for ll_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_counter = 1 to lds_saledetail.rowcount()
			ll_row = this.id_detail.insertrow(0)
			ll_icode = lds_saledetail.getitemnumber(ll_counter, "icode")
			wf_inititeminfo(ll_icode, ll_counter, ls_errortext)
			ll_qty = lds_saledetail.getitemnumber(ll_counter, "looseqty")
			ll_bonusqty = lds_saledetail.getitemnumber(ll_counter, "bonusqty")
			ld_purprice = lds_saledetail.getitemnumber(ll_counter, "saleprice")
			ld_saleprice = lds_saledetail.getitemnumber(ll_counter, "saleprice")
			ld_discperc = lds_saledetail.getitemnumber(ll_counter, "discperc")
			ld_itemflatdisc = lds_saledetail.getitemnumber(ll_counter, "itemflatdisc")
			ld_unitsalestax = lds_saledetail.getitemnumber(ll_counter, "unitsalestax")
			ld_gstperc = lds_saledetail.getitemnumber(ll_counter, "gstperc")
			ls_batch = lds_saledetail.getitemstring(ll_counter, "batch")
			ldt_expiry = lds_saledetail.getitemdatetime(ll_counter, "expiry")
			ld_purprice = ld_purprice - ld_itemflatdisc
			SQL SELECT item.customicode , item.name , item.gcode , item.purprice , item.packsalestax , item.avgprice , item.recentpurprice , item.recentpurprice2 , recentpurprice3 , recentpurprice4 , recentpurprice5 , item.packingdesc , item.packunits INTO :ls_fullcode, :ls_name, :li_gcode, :ld_itempurprice, :ld_packsalestax, :ld_avgprice, :ld_rpp, :ld_rpp2, :ld_rpp3, :ld_rpp4, :ld_rpp5, :ls_packingdesc, :ll_packunits FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = -1 then
				retflag = false
				ls_errortext = "Database Error: Item information can not be retrieved.~r~nReasons:" + this.it_transobject.sqlerrtext
				messagebox("Item Validation", ls_errortext)
			end if
			if ll_packunits < 1 or isnull(ll_packunits) then
				ll_packunits = 1
			end if
			if this.il_godowncount = 1 and this.il_strategy = 1 then
				this.ii_defaultgcode = this.id_detail.getitemnumber(ll_row, "gcode")
			else
				this.ii_defaultgcode = this.id_detail.getitemnumber(ll_row, "gcode")
			end if
			ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
			this.it_transobject.getitemstocktotal(this.ii_defaultgcode, ll_icode, ld_godownstock)
			this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
			if this.it_transobject.sqlcode = -1 then
				retflag = false
				ls_errortext = "Database Error: Item Stock information can not be retrieved"
			end if
			this.id_detail.setitem(ll_row, "gcode", this.ii_defaultgcode)
			this.id_detail.setitem(ll_row, "icode", ll_icode)
			this.id_detail.setitem(ll_row, this.is_columnitemname, ls_name)
			this.id_detail.setitem(ll_row, "fullcode", ls_fullcode)
			this.id_detail.setitem(ll_row, "packunits", ll_packunits)
			this.id_detail.setitem(ll_row, "price", ld_saleprice)
			this.id_detail.setitem(ll_row, "stock", ld_godownstock)
			this.id_detail.setitem(ll_row, "totalstock", ld_allgodownstock)
			this.id_detail.setitem(ll_row, "batch", ls_batch)
			this.id_detail.setitem(ll_row, "expiry", ldt_expiry)
			this.id_detail.setitem(ll_row, "qty", ll_qty)
			this.id_detail.setitem(ll_row, "purchaseprice", ld_purprice)
			this.id_footer.setitem(1, "stock", ld_godownstock)
			this.id_footer.setitem(1, "totalstock", ld_allgodownstock)
		next
		if this.id_detail.rowcount() > 0 then
			this.im_menu.m_file.m_save.enabled = true
			wf_grandtotal()
			wf_saveandpost()
			if wf_commitform() = true then
				SQL rollback USING sqlca;
				sqlca.marksaleinvoiceaspulled(ll_sitecode, ll_saleinvcode, gl_usercode, gs_dropbox_server, gs_dropbox_db, "dbo")
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
				else
					SQL rollback USING sqlca;
				end if
				postevent("ue_new")
			else
				ll_totrows = this.id_detail.rowcount()
				if ll_totrows > 0 then
					for ll_row = 1 to ll_totrows
						triggerevent("ue_deleteitem")
					next
				end if
			end if
		else
			this.im_menu.m_file.m_save.enabled = false
		end if
	end if
	SQL stop USING lt_transobject;

// w_receipt.ue_pull_issue_from_dropbox() returns 0 [event]
	long ll_icode
	long ll_row
	long ll_issueinvcode
	long ll_counter
	long ll_qty
	long ll_bonusqty
	long ll_suppcode
	long ll_check_for_basicdata_sync
	long ll_sitecode
	boolean retflag
	double ld_purprice
	double ld_discperc
	double ld_itemflatdisc
	double ld_saleprice
	double ld_avgprice
	double ld_packsalestax
	double ld_gstperc
	double ld_rpp
	double ld_unitsalestax
	double ld_itempurprice
	double ld_rate
	double ld_rpp2
	double ld_rpp3
	double ld_rpp4
	double ld_rpp5
	double ld_invdiscperc
	double ld_invflatdisc
	double ld_invmisccharges
	double ld_invgstperc1
	double ld_godownstock
	double ld_allgodownstock
	long ll_packunits
	long ll_itemscount
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_batch
	string ls_itemtotalval
	string ls_packingdesc
	string ls_errortext
	string ls_error_syntax
	string ls_connsetting
	string ls_saleledgerquery
	string ls_saledetailquery
	string ls_newsyntax
	string ls_suppinvcode
	string ls_suppinvcode_tmp
	string ls_prefix
	datetime ldt_expiry
	datastore lds_saleledger
	datastore lds_saledetail
	s_arguements lstr_arguments
	u_transaction lt_transobject
	long ll_totrows
	if wf_iseditable() = false then
		return
	end if
	if isnull(this.id_master.object.recipientcode[this.id_master.rowcount()]) then
		messagebox("Recipient Validation!", "Kindly Select a Recipient first")
		return
	elseif isnull(this.id_master.object.acccode[this.id_master.rowcount()]) and isnull(this.id_master.object.deptcode[this.id_master.rowcount()]) and isnull(this.id_master.object.recipientsalesman[this.id_master.rowcount()]) then
		messagebox("Recipient Validation!", "Kindly Select a Recipient first")
		return
	end if
	open(w_pull_issue_from_dropbox)
	lstr_arguments = message.powerobjectparm
	if lstr_arguments.i_status <= 0 then
		return
	end if
	ll_issueinvcode = lstr_arguments.l_code1
	ll_sitecode = lstr_arguments.l_code2
	lt_transobject = create u_transaction
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Problem", "Unable to connect to database.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		return
	end if
	SQL EXECUTE IMMEDIATE :ls_connsetting USING lt_transobject;
	if ll_issueinvcode > 0 then
		setpointer(hourglass!)
		ll_check_for_basicdata_sync = f_check_for_basicdata_sync()
		if ll_check_for_basicdata_sync < 0 then
			return
		end if
		lds_saleledger = create datastore
		lds_saledetail = create datastore
		ls_prefix = ""
		if gs_dropbox_server = "" or isnull(gs_dropbox_server) then
			ls_prefix = ""
		else
			ls_prefix = gs_dropbox_server + "."
		end if
		if gs_dropbox_db = "" or isnull(gs_dropbox_db) then
			ls_prefix = ls_prefix
		else
			ls_prefix = ls_prefix + gs_dropbox_db + "."
		end if
		ls_saleledgerquery = "Select ~tSiteCode, TargetSitecode, IssueInvCode, IssueCategoryCode, AccCode, AreaCode, DeptCode, RecipientSalesman, SalesmanCode, date, Remarks, ReferenceNo, RefNo2, RefNo3, RefNo4, RefNo5 " + "From ~t" + ls_prefix + "dbo." + "DB_IssueHeader " + "Where   IssueInvCode = " + string(ll_issueinvcode) + " AND sitecode = " + string(ll_sitecode) + " AND TargetSiteCode = " + string(gl_sitecode) + " AND Pulled='N'"
		ls_saledetailquery = "Select ~tSiteCode, IssueInvCode, ICode, GCode, Batch, Expiry, Qty, PackUnits, SalePrice, AvgPrice, PurchasePrice, IssRowId, itemdescription " + "From ~t" + ls_prefix + "dbo." + "DB_IssueDetail " + "Where ~tIssueInvCode = " + string(ll_issueinvcode) + " AND sitecode = " + string(ll_sitecode) + " Order By IssueInvCode, IssRowId "
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_saleledgerquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For DB_IssueHeader DataStore")
			return
		else
			ls_error_syntax = ""
			lds_saleledger.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For DB_IssueHeader DataStore")
				return
			end if
		end if
		lds_saleledger.settransobject(lt_transobject)
		if lds_saleledger.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source DB_IssueHeader.")
			return
		end if
		ls_newsyntax = ""
		ls_error_syntax = ""
		ls_newsyntax = lt_transobject.syntaxfromsql(ls_saledetailquery, "", ls_error_syntax)
		if len(ls_error_syntax) > 0 then
			SQL stop USING lt_transobject;
			messagebox("Syntax Validation", "Syntax Error For DB_IssueDetail DataStore")
			return
		else
			ls_error_syntax = ""
			lds_saledetail.create(ls_newsyntax, ls_error_syntax)
			if len(ls_error_syntax) > 0 then
				SQL stop USING lt_transobject;
				messagebox("Create Validation", "Create Error For DB_IssueDetail DataStore")
				return
			end if
		end if
		lds_saledetail.settransobject(lt_transobject)
		if lds_saledetail.retrieve() <= 0 then
			SQL stop USING lt_transobject;
			messagebox("Fetch Error", "Unable to fetch any data from source DB_IssueDetail.")
			return
		end if
		this.id_master.setitem(1, "referenceno", trim(string(ll_issueinvcode)))
		this.id_master.setitem(1, "referencedate", lstr_arguments.d_sdate)
		for ll_counter = 1 to this.id_detail.rowcount()
			event ue_deleteitem()
		next
		for ll_counter = 1 to lds_saledetail.rowcount()
			ll_row = this.id_detail.insertrow(0)
			ll_icode = lds_saledetail.getitemnumber(ll_counter, "icode")
			wf_inititeminfo(ll_icode, ll_counter, ls_errortext)
			ll_qty = lds_saledetail.getitemnumber(ll_counter, "qty")
			ld_purprice = lds_saledetail.getitemnumber(ll_counter, "purchaseprice")
			ld_saleprice = lds_saledetail.getitemnumber(ll_counter, "saleprice")
			ls_batch = lds_saledetail.getitemstring(ll_counter, "batch")
			ldt_expiry = lds_saledetail.getitemdatetime(ll_counter, "expiry")
			SQL SELECT item.customicode , item.name , item.gcode , item.purprice , item.packsalestax , item.avgprice , item.recentpurprice , item.recentpurprice2 , recentpurprice3 , recentpurprice4 , recentpurprice5 , item.packingdesc , item.packunits INTO :ls_fullcode, :ls_name, :li_gcode, :ld_itempurprice, :ld_packsalestax, :ld_avgprice, :ld_rpp, :ld_rpp2, :ld_rpp3, :ld_rpp4, :ld_rpp5, :ls_packingdesc, :ll_packunits FROM item WHERE item.icode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = -1 then
				retflag = false
				ls_errortext = "Database Error: Item information can not be retrieved.~r~nReasons:" + this.it_transobject.sqlerrtext
				messagebox("Item Validation", ls_errortext)
			end if
			if ll_packunits < 1 or isnull(ll_packunits) then
				ll_packunits = 1
			end if
			if this.il_godowncount = 1 and this.il_strategy = 1 then
				this.ii_defaultgcode = this.id_detail.getitemnumber(ll_row, "gcode")
			else
				this.ii_defaultgcode = this.id_detail.getitemnumber(ll_row, "gcode")
			end if
			ls_itemtotalval = string(ld_saleprice, "######0.00") + " + " + string(ld_packsalestax, "######0.00") + " =  " + string(ld_saleprice + ld_packsalestax, "#####0.00")
			this.it_transobject.getitemstocktotal(this.ii_defaultgcode, ll_icode, ld_godownstock)
			this.it_transobject.getitemstockinallowedgodown(ll_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
			if this.it_transobject.sqlcode = -1 then
				retflag = false
				ls_errortext = "Database Error: Item Stock information can not be retrieved"
			end if
			this.id_detail.setitem(ll_row, "gcode", this.ii_defaultgcode)
			this.id_detail.setitem(ll_row, "icode", ll_icode)
			this.id_detail.setitem(ll_row, this.is_columnitemname, ls_name)
			this.id_detail.setitem(ll_row, "fullcode", ls_fullcode)
			this.id_detail.setitem(ll_row, "packunits", ll_packunits)
			this.id_detail.setitem(ll_row, "price", ld_saleprice)
			this.id_detail.setitem(ll_row, "stock", ld_godownstock)
			this.id_detail.setitem(ll_row, "totalstock", ld_allgodownstock)
			this.id_detail.setitem(ll_row, "batch", ls_batch)
			this.id_detail.setitem(ll_row, "expiry", ldt_expiry)
			this.id_detail.setitem(ll_row, "qty", ll_qty)
			this.id_detail.setitem(ll_row, "purchaseprice", ld_purprice)
			this.id_footer.setitem(1, "stock", ld_godownstock)
			this.id_footer.setitem(1, "totalstock", ld_allgodownstock)
		next
		if this.id_detail.rowcount() > 0 then
			this.im_menu.m_file.m_save.enabled = true
			wf_grandtotal()
			wf_saveandpost()
			if wf_commitform() = true then
				SQL rollback USING sqlca;
				sqlca.markissueaspulled(ll_sitecode, ll_issueinvcode, gl_usercode, gs_dropbox_server, gs_dropbox_db, "dbo")
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
				else
					SQL rollback USING sqlca;
				end if
				postevent("ue_new")
			else
				ll_totrows = this.id_detail.rowcount()
				if ll_totrows > 0 then
					for ll_row = 1 to ll_totrows
						triggerevent("ue_deleteitem")
					next
				end if
			end if
		else
			this.im_menu.m_file.m_save.enabled = false
		end if
	end if
	SQL stop USING lt_transobject;

// w_receipt.wf_validateitem() returns integer
	long ll_icode
	long ll_gcode
	long ll_stock
	long ll_issueinvcode
	long ll_dddwrow
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	string ls_fullcode
	string ls_errtext
	string ls_titleerrtext
	integer il_errcode
	integer li_errcode
	integer li_null
	string ls_null
	ll_icode = this.id_detail.object.icode[this.il_currrow]
	ll_issueinvcode = this.id_master.getitemnumber(this.id_master.getrow(), "IssueInvCode")
	if ll_issueinvcode > 0 and not isnull(ll_issueinvcode) then
		ll_dddwrow = this.id_itemslist.getrow()
		if wf_inititeminfo(this.idc_itemdddw, this.il_currrow, ll_dddwrow, ls_errtext) >= 0 then
			this.ib_itemvalidated = true
		else
			ls_titleerrtext = "Item Validation"
			li_errcode = -1
		end if
	elseif wf_genfullcode(ll_icode, ls_fullcode) > 0 then
		this.id_detail.object.fullcode[this.il_currrow] = ls_fullcode
		if wf_inititeminfo(ll_icode, this.il_currrow, ls_errtext) then
			this.ib_itemvalidated = true
		else
			ls_titleerrtext = "Item Validation"
			li_errcode = -1
		end if
	else
		li_errcode = -1
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
	end if
	return il_errcode

// w_receipt.wf_retrievelistall() returns long
	string[] ls_posted
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	return this.id_list.retrieve(ls_posted, this.il_groupcode, this.ii_module, this.ii_category)

// w_receipt.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_listdw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_list.dataobject = as_listdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)

// w_receipt.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_receipt.wf_getpomanfcode(long al_pocode, long al_manfcode) returns 0
	al_pocode = this.id_master.object.pocode[this.id_master.getrow()]
	al_manfcode = this.id_master.object.manfcode[this.id_master.getrow()]

// w_receipt.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	real lr_discperc
	real lr_flatdisc
	real lr_misccharges
	real lr_salestax
	real lr_itemstotal
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		lr_discperc = 0
		lr_flatdisc = 0
		lr_misccharges = 0
		lr_salestax = 0
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "d_detaildwtotal")
		ld_grandtotal = ld_detaildwtotal * (1.0 - lr_discperc * 0.01) - lr_flatdisc + lr_misccharges + lr_salestax
		ld_grandtotal = round(ld_grandtotal, 0)
		this.id_footer.setitem(1, "total", ld_grandtotal)
		ld_detaildwtotal = this.id_footer.getitemnumber(1, "total")
	end if
	return ld_grandtotal

// w_receipt.wf_iteminfo(long al_icode, long al_gcode, double ad_purprice, double ad_discperc, double ad_avgprice, long al_packunits) returns boolean
	boolean retflag
	SQL SELECT 1 , item.salePrice , item.purdiscperc , item.avgprice , item.packunits INTO :al_gcode, :ad_purprice, :ad_discperc, :ad_avgprice, :al_packunits FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	al_gcode = this.ii_purchasegodownoption
	if isnull(ad_purprice) then
		ad_purprice = 0
	elseif isnull(ad_discperc) then
		ad_discperc = 0
	elseif isnull(ad_avgprice) then
		ad_avgprice = 0
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_receipt.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_counter step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_receipt.wf_releaselock(long al_icode) returns boolean
	boolean retflag
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM godowndetail WITH ( NOLOCK ) WHERE godowndetail.Gcode =:this.ii_purchasegodownoption AND godowndetail.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_receipt.wf_retrievelist() returns long
	string[] ls_posted
	ls_posted[1] = "N"
	return this.id_list.retrieve(ls_posted, this.il_groupcode, this.ii_module, this.ii_category)

// w_receipt.wf_selectprintreport() returns string
	string ls_report
	if left(gs_company, 12) = "MASOODHOMOEO" then
		if f_stringpreferences("PurBatch") = "Y" and f_stringpreferences("PurExpiry") = "Y" then
			ls_report = "d_receiptinv_batchexpiry_masoodhomeo"
		else
			ls_report = "d_receiptinvreport_half_masoodhomeo"
		end if
	elseif f_stringpreferences("PurBatch") = "Y" and f_stringpreferences("PurExpiry") = "Y" then
		ls_report = "d_receiptinvreport_batchexpiry_half"
	else
		ls_report = "d_receiptinvreport_half"
	end if
	if gs_company = "ZAFARTRACTOR" or gs_company = "ZAFARTRACTOR3" then
		ls_report = "d_zafartractor_receiptinvreport"
	elseif gs_company = "MIANELECTRONICS" or gs_company = "MIANELECTRONIC2" or gs_company = "SAMICORP2" or gs_company = "SAMICORPORATION" then
		ls_report = "d_mianelectronics_receiptinvreport"
	elseif gs_company = "VERIZON" then
		ls_report = "d_verizon_receiptinvreport_full"
	elseif gs_company = "NMM" or gs_company = "MAHMOOD2008" or gs_company = "NMGHARISHAHU" or gs_company = "ISLAMPURANMP" or gs_company = "WAHDATROADNMP" or gs_company = "SHADBAGHNMP" or gs_company = "MAHMOODLWH" or gs_company = "MULTANROADNMP" or gs_company = "MOCHIGATENMP" or gs_company = "DHARAMPURANMP" or gs_company = "CHAHMEERANNMP" then
		ls_report = "d_nmp_receiptinvreport"
	end if
	this.id_print.dataobject = ls_report
	this.id_print.settransobject(this.it_transobject)
	return ls_report

// w_receipt.wf_setpurchasetype(integer ai_purchasetype) returns 0
	if ai_purchasetype <= 2 then
		this.ii_purchasetype = ai_purchasetype
		return
	end if
	if ai_purchasetype = 7 then
		this.ii_purchasetype = 7
		return
	end if
	this.ii_purchasetype = 1

// w_receipt.wf_setpurorderinfo(long al_purordercode) returns long
	long ll_manfcode
	long ll_suppcode
	long ll_salesmancode
	long ll_row
	integer li_rtcode
	datetime ld_podate
	string ls_podate
	string ls_manfname
	SQL SELECT purorderheader.manfcode , purorderheader.suppcode , purorderheader.date INTO :ll_manfcode, :ll_suppcode, :ld_podate FROM purorderheader WHERE purorderheader.pocode =:al_purordercode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Cannot Connect to Database", this.it_transobject.sqlerrtext)
		li_rtcode = -1
	end if
	SQL SELECT manufacturer.name INTO :ls_manfname FROM manufacturer WHERE manufacturer.manfcode =:ll_manfcode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Cannot Connect to Database", this.it_transobject.sqlerrtext)
		li_rtcode = -1
	end if
	ll_row = this.id_master.getrow()
	ll_row = 1
	this.id_master.object.suppcode[ll_row] = ll_suppcode
	this.id_master.object.podate[ll_row] = ld_podate
	this.id_master.object.manfname[ll_row] = ls_manfname
	this.id_master.object.manfcode[ll_row] = ll_manfcode
	wf_setsuppinfo(ll_suppcode, this.id_master)
	return ll_manfcode

// w_receipt.wf_setsuppinfo(long al_suppcode, datawindow ad_master) returns 0
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	double ld_currbalance
	SQL SELECT supplier.address1 , supplier.city , supplier.phone INTO :ls_address, :ls_city, :ls_phone FROM supplier WHERE supplier.suppcode =:al_suppcode USING this.it_transobject;
	ll_currow = ad_master.getrow()
	ll_currow = 1
	ad_master.object.address[ll_currow] = ls_address
	ad_master.object.city[ll_currow] = ls_city
	ad_master.object.phone[ll_currow] = ls_phone

// w_receipt.wf_updateitemavgprice(long al_icode, double ad_newavgprice) returns boolean
	boolean retflag
	SQL update item SET item.avgprice =:ad_newavgprice WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_receipt.wf_updateitempurprice(long al_icode, double ad_purprice) returns integer
	SQL update Item SET purprice =:ad_purprice WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_receipt.wf_updateitemstock(long al_icode, long al_gcode, long al_newstock) returns boolean
	boolean retflag
	SQL update godowndetail SET godowndetail.currqty =:al_newstock WHERE godowndetail.gcode =:al_gcode AND godowndetail.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
	end if
	return retflag

// w_receipt.wf_updaterecentpurprice(long al_icode, double ad_rpp) returns integer
	SQL update Item SET recentpurprice =:ad_rpp WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_receipt.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	return true

// w_receipt.wf_post() returns boolean
	integer li_postingmode
	long ll_sinvcode
	long ll_linvcode
	setnull(ll_sinvcode)
	setnull(ll_linvcode)
	return wf_post_receipt(li_postingmode, ll_sinvcode, ll_linvcode)

// w_receipt.wf_setgodownoption() returns 0
	this.ii_purchasegodownoption = this.id_detail.getitemnumber(1, "gcode")
	if this.il_strategy = 2 or this.il_strategy = 1 and this.il_godowncount = 1 then
		this.id_detail.modify("gcode" + ".Protect=1")
		this.id_detail.object.gcode.background.color = this.backcolor
	end if

// w_receipt.wf_initmodify(integer ai_protect) returns 0
	long ll_receiptinvcode
	long ll_gcode
	long ll_icode
	long ll_counter
	long ll_packunits
	string ls_batch
	datetime ld_expiry
	double ld_looseqty
	double ld_stock
	double ld_packqty
	double ld_bonusqty
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_receiptinvcode = this.id_detail.getitemnumber(1, "code")
		if wf_lockinvoice(ll_receiptinvcode) = 0 then
			for ll_counter = 1 to this.id_detail.rowcount()
				ll_gcode = this.id_detail.getitemnumber(ll_counter, "gcode")
				ll_icode = this.id_detail.getitemnumber(ll_counter, "icode")
				ld_looseqty = this.id_detail.getitemnumber(ll_counter, "qty")
				ll_packunits = this.id_detail.getitemnumber(ll_counter, "packunits")
				this.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
				if this.it_transobject.sqlcode = 0 then
					ai_protect = 0
					this.id_footer.setitem(ll_counter, "stock", ld_stock - ld_looseqty)
				end if
			next
			if ai_protect = 0 then
				this.id_footer.setitem(1, "stock", this.id_footer.getitemnumber(1, "stock"))
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
		end if
		return
	end if
	ai_protect = 1

// w_receipt.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_receipt.wf_setiteminfo(long al_icode, long al_row, long ad_gcode, double ad_saleprice, double ad_discperc, long al_stock) returns 0
	this.id_detail.setitem(al_row, "gcode", ad_gcode)
	this.id_detail.setitem(al_row, "purprice", ad_saleprice)
	this.id_detail.setitem(al_row, "discperc", ad_discperc)
	this.id_footer.object.stock[this.id_footer.getrow()] = al_stock

// w_receipt.wf_setitemprice(long al_icode, long al_row, long al_pricetypecode) returns long
	long ll_retcode
	long ll_packunits
	double ld_saleprice1
	double ld_saleprice2
	double ld_saleprice3
	double ld_saleprice4
	double ld_saleprice5
	double ld_avgprice
	double ld_rpp
	double ld_purprice
	string ls_alternatecustomicode
	string ls_null
	string ls_fullcode
	setnull(ls_null)
	SQL SELECT ROUND ( item.saleprice / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) , ROUND ( item.saleprice2 / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) , ROUND ( item.saleprice3 / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) , item.avgprice , item.packunits , ROUND ( item.purprice / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) , ROUND ( item.recentpurprice / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) , ROUND ( item.saleprice4 / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) , ROUND ( item.saleprice5 / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) INTO :ld_saleprice1, :ld_saleprice2, :ld_saleprice3, :ld_avgprice, :ll_packunits, :ld_purprice, :ld_rpp, :ld_saleprice4, :ld_saleprice5 FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		ll_retcode = -1
		return ll_retcode
	end if
	if not (this.it_transobject.sqlcode = 100) then
		ls_alternatecustomicode = trim(this.id_detail.object.alternatecustomicode[al_row])
		ls_fullcode = this.id_detail.object.fullcode[al_row]
		if lower(ls_fullcode) = lower(ls_alternatecustomicode) then
			ls_alternatecustomicode = ls_null
			this.id_detail.object.alternatecustomicode[al_row] = ls_null
		end if
		if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) or this.id_detail.object.packunits[al_row] <= 0 then
			this.id_detail.setitem(al_row, "saleprice", ld_saleprice1)
			this.id_detail.setitem(al_row, "purchaseprice", ld_purprice)
		end if
		this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
		this.id_detail.setitem(al_row, "mrpp", ld_rpp)
		choose case al_pricetypecode
		case 1
			if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) or this.id_detail.object.packunits[al_row] <= 0 then
				this.id_detail.setitem(al_row, "price", ld_saleprice1)
			end if
		case 2
			this.id_detail.setitem(al_row, "price", ld_saleprice2)
		case 3
			this.id_detail.setitem(al_row, "price", ld_saleprice3)
		case 7
			this.id_detail.setitem(al_row, "price", ld_saleprice4)
		case 8
			this.id_detail.setitem(al_row, "price", ld_saleprice5)
		case 4
			this.id_detail.setitem(al_row, "price", ld_purprice)
		case 5
			this.id_detail.setitem(al_row, "price", ld_rpp)
		case else
			this.id_detail.setitem(al_row, "price", ld_avgprice)
		end choose
		ll_retcode = 0
	else
		ll_retcode = -2
	end if
	return ll_retcode

// w_receipt.wf_allowreceiptmodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM ReceiptDetail WHERE ReceiptInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_receipt.wf_inititeminfo(long al_icode, long al_row, string as_errortext) returns boolean
	boolean retflag
	double ld_purprice
	double ld_avgprice
	double ld_mrpp
	double ld_saleprice
	double ld_unitweight
	long ll_packunits
	long ll_result
	long ll_pricetypecode
	long ll_piecesinhand
	long ll_totalpieces
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_alternatecustomicode
	string ls_null
	double ld_godownstock
	double ld_allgodownstock
	setnull(ls_null)
	SQL SELECT item.customicode , item.name , item.purprice , item.packunits , item.saleprice , item.gcode , item.avgprice , item.recentpurprice , item.totalpieces , item.unitweight INTO :ls_fullcode, :ls_name, :ld_purprice, :ll_packunits, :ld_saleprice, :li_gcode, :ld_avgprice, :ld_mrpp, :ll_piecesinhand, :ld_unitweight FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	ll_pricetypecode = this.id_master.getitemnumber(this.id_master.getrow(), "pricetypecode")
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		this.ii_defaultgcode = this.id_detail.getitemnumber(al_row, "gcode")
	else
		if this.il_strategy = 2 then
			this.ii_defaultgcode = li_gcode
		end if
		if this.il_strategy = 1 then
			this.ii_defaultgcode = this.id_detail.getitemnumber(al_row, "gcode")
		end if
		this.it_transobject.getitemstockinallowedgodown(al_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_allgodownstock)
		if this.it_transobject.sqlcode <> 0 then
			retflag = false
			as_errortext = "Database Error: Item information can not be retrieved"
		end if
	end if
	this.it_transobject.getitemstocktotal(this.ii_defaultgcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	ls_alternatecustomicode = this.id_detail.object.alternatecustomicode[al_row]
	if isnull(ls_alternatecustomicode) then
		ls_alternatecustomicode = ""
	end if
	if lower(ls_fullcode) = lower(ls_alternatecustomicode) then
		ls_alternatecustomicode = ls_null
		this.id_detail.object.alternatecustomicode[al_row] = ls_null
	end if
	this.id_detail.setitem(al_row, "gcode", this.ii_defaultgcode)
	this.id_detail.setitem(al_row, "icode", al_icode)
	this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
	this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
	if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) or this.id_detail.object.packunits[al_row] <= 0 then
		this.id_detail.setitem(al_row, "packunits", ll_packunits)
	end if
	this.id_detail.setitem(al_row, "mrpp", ld_mrpp / ll_packunits)
	this.id_detail.setitem(al_row, "avgprice", ld_avgprice)
	if len(ls_alternatecustomicode) = 0 or isnull(ls_alternatecustomicode) then
		this.id_detail.setitem(al_row, "saleprice", ld_saleprice / ll_packunits)
		this.id_detail.setitem(al_row, "purchaseprice", ld_purprice / ll_packunits)
	end if
	this.id_detail.setitem(al_row, "piecesinhand", ll_piecesinhand)
	if isnull(ll_piecesinhand) or ll_piecesinhand <= 0 then
		this.id_detail.setitem(al_row, "totalpieces", 0)
	end if
	this.id_detail.setitem(al_row, "unitweight", ld_unitweight)
	ll_result = wf_setitemprice(al_icode, al_row, ll_pricetypecode)
	if ll_result = -1 then
		as_errortext = "Item information can not be retrieved"
		retflag = false
	elseif ll_result = 100 then
		as_errortext = "Rows not retrieve"
		retflag = false
	else
		retflag = true
	end if
	this.id_detail.setitem(al_row, "stock", ld_godownstock)
	this.id_detail.setitem(al_row, "totalstock", ld_allgodownstock)
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_allgodownstock)
	wf_set_itemimage(al_icode)
	return retflag

// w_receipt.wf_itemstockinfo(long al_icode, long al_gcode, double al_stock) returns boolean
	boolean retflag
	double ld_stock
	double ld_totalstock
	al_stock = 100
	return retflag

// w_receipt.wf_post_receipt(integer ai_postingmode, long al_startinginvcode, long al_endinginvcode) returns boolean
	long ll_code1
	long ll_code2
	long ll_headerno
	long ll_headerinvno
	long ll_totalpieces
	long ll_piecesinhand
	integer li_errcode
	integer li_rtncode
	long ll_supplieracc
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_icode
	long ll_gcode
	long ll_packingunits
	long ll_salesmancode
	long ll_errrowid
	string ls_batch
	string ls_errortext
	datetime ld_expiry
	datetime ld_mfgdate
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	datetime ldt_server_datetime
	string ls_date_errtext
	double ld_avgprice
	double ld_newavgprice
	double ld_purprice
	double ld_discperc
	double ld_itempurcost
	double ld_netpurcost
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_debitamt
	double ld_creditamt
	double ld_currbalance
	double ld_recentpurprice
	double ld_purpricepack
	double ld_saleprice
	double ld_mrpp
	double ld_price
	integer li_detailcounter
	integer li_purchasecategory
	boolean lb_commitflag
	char lc_updateavgprice
	double ld_stock
	double ld_newstock
	double ld_purqty
	double ld_purbonusqty
	double ld_packqty
	double ld_bonusqty
	double ld_looseqty
	integer ci_normalpurchase
	integer ci_openingpurchase
	integer ci_loosepurchase
	long ll_rowcount
	long ll_invcounter
	long ll_invcode
	s_arguements lstr_arginfo
	datastore lds_purinvforposting
	datastore lds_purheader
	datastore lds_purdetail
	datawindowchild ldc_godown
	datawindowchild ldc_section
	lds_purinvforposting = create datastore
	lds_purinvforposting.dataobject = "d_receiptno"
	lds_purinvforposting.settransobject(this.it_transobject)
	lds_purheader = create datastore
	lds_purheader.dataobject = "d_receiptheader"
	lds_purheader.settransobject(this.it_transobject)
	lds_purdetail = create datastore
	lds_purdetail.dataobject = "d_receiptdetail"
	lds_purdetail.settransobject(this.it_transobject)
	li_rtncode = lds_purdetail.getchild("gcode", ldc_godown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild~r~nPosting Failed")
		return false
	end if
	li_rtncode = lds_purdetail.getchild("sectcode", ldc_section)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild for section~r~nPosting Failed")
		return false
	end if
	ldc_section.settransobject(this.it_transobject)
	ldc_section.insertrow(0)
	ldc_godown.settransobject(this.it_transobject)
	li_rtncode = ldc_godown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to Post Receipt~r~nPosting Failed")
		return false
	end if
	if ai_postingmode = 1 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if ai_postingmode = 1 then
			open(w_arg_sinvcode_linvcode)
			lstr_arginfo = message.powerobjectparm
		else
			lstr_arginfo.l_code1 = al_startinginvcode
			lstr_arginfo.l_code2 = al_endinginvcode
			lstr_arginfo.i_status = 1
		end if
		if lstr_arginfo.i_status = 1 then
			if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return false
			end if
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			SQL Select count ( *) INTO :ul_rowcount From ReceiptDetail , ReceiptHeader Where ReceiptHeader.ReceiptInvCode Between :lstr_arginfo.l_code1 AND :lstr_arginfo.l_code2 AND ReceiptHeader.ReceiptCategoryCode =:this.ii_category AND ReceiptHeader.posted ='N' AND ReceiptHeader.receiptinvcode =Receiptdetail.Receiptinvcode AND ReceiptHeader.receiptinvcode NOT IN ( SELECT ProdHeader.receiptinvcode FROM ProdHeader WHERE ProdHeader.ReceiptInvCode IS NOT NULL ) USING sqlca;
			sqlca.getmaxutn(ul_rowcount, ul_maxutn)
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
				messagebox("POSTING", "Posting fail due to error in generating Utn")
				return false
			end if
			li_errcode = wf_lockreceiptinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2, this.ii_category)
			ll_code1 = lstr_arginfo.l_code1
			ll_code2 = lstr_arginfo.l_code2
			lds_purinvforposting.retrieve(lstr_arginfo.l_code1, lstr_arginfo.l_code2, this.ii_category)
			if li_errcode = 0 then
				ll_rowcount = lds_purinvforposting.rowcount()
				for ll_invcounter = 1 to ll_rowcount
					ll_invcode = lds_purinvforposting.object.receiptinvcode[ll_invcounter]
					if wf_allowreceiptmodification(ll_invcode, this.il_groupcode, this.il_strategy) = 0 then
						lds_purheader.retrieve(ll_invcode)
						lds_purdetail.retrieve(ll_invcode)
						ll_mastercurrrow = lds_purheader.getrow()
						ll_detailrows = lds_purdetail.rowcount()
						ll_headerno = lds_purheader.getitemnumber(ll_mastercurrrow, "headerno")
						ll_headerinvno = lds_purheader.getitemnumber(ll_mastercurrrow, "headerinvno")
						if isnull(ll_headerinvno) then
							f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
							if ll_headerinvno > 0 then
								lds_purheader.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
							end if
						end if
						if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
							messagebox("Date Violation", ls_date_errtext, stopsign!)
							return false
						end if
						lds_purheader.object.postdate[ll_mastercurrrow] = ldt_server_datetime
						lds_purheader.object.posted[ll_mastercurrrow] = "Y"
						lds_purheader.object.postdate[ll_mastercurrrow] = today()
						lds_purheader.object.postedby[ll_mastercurrrow] = ll_salesmancode
						li_detailcounter = 1
						do while li_detailcounter <= ll_detailrows and lb_commitflag = true
							lds_purdetail.object.receiptutn[li_detailcounter] = ul_maxutn
							ul_maxutn = ul_maxutn + 1
							ll_icode = lds_purdetail.object.icode[li_detailcounter]
							ll_gcode = lds_purdetail.object.gcode[li_detailcounter]
							ls_batch = lds_purdetail.object.batch[li_detailcounter]
							ld_expiry = lds_purdetail.object.expiry[li_detailcounter]
							ld_mfgdate = lds_purdetail.object.manfdate[li_detailcounter]
							ld_looseqty = lds_purdetail.object.qty[li_detailcounter]
							ll_packingunits = lds_purdetail.object.packunits[li_detailcounter]
							ld_purprice = lds_purdetail.object.purchaseprice[li_detailcounter]
							ld_saleprice = lds_purdetail.object.saleprice[li_detailcounter]
							ld_mrpp = lds_purdetail.object.mrpp[li_detailcounter]
							ld_price = lds_purdetail.object.price[li_detailcounter]
							lc_updateavgprice = lds_purdetail.object.updateavgprice[li_detailcounter]
							ld_purqty = ld_looseqty
							ld_purbonusqty = ld_bonusqty
							ll_totalpieces = lds_purdetail.object.totalpieces[li_detailcounter]
							ld_itempurcost = ld_purqty * lds_purdetail.getitemnumber(li_detailcounter, "c_netrate")
							ld_netpurcost = ld_netpurcost + ld_itempurcost
							this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
							if this.it_transobject.sqlcode = 0 then
								this.it_transobject.getitemtotalpiecesinhand(ll_icode, ll_piecesinhand)
								if this.it_transobject.sqlcode <> 0 then
									ls_errortext = "Item Pieces in Hand Fetch Error:~r~n" + this.it_transobject.sqlerrtext
									lb_commitflag = false
								else
									lds_purdetail.setitem(li_detailcounter, "piecesinhand", ll_piecesinhand)
									this.it_transobject.updateitemtotalpiecesinhand(ll_icode, 1, ll_totalpieces)
									if this.it_transobject.sqlcode <> 0 then
										lb_commitflag = false
										ls_errortext = "Item Pieces in Hand Updation Error:~r~n" + this.it_transobject.sqlerrtext
									end if
								end if
								if lb_commitflag then
									this.it_transobject.getitemstockall(ll_icode, ld_stock)
									if this.it_transobject.sqlcode = 0 then
										lds_purdetail.object.avgprice[li_detailcounter] = ld_avgprice
										lds_purdetail.object.currstock[li_detailcounter] = ld_stock
										ld_newstock = ld_stock + ld_purqty + ld_purbonusqty
										if ld_newstock > 0.0 then
											ld_newavgprice = round((ld_stock * ld_avgprice + ld_itempurcost) / ld_newstock, 5)
											if lc_updateavgprice = "Y" then
												this.it_transobject.updateitemavgprice(ll_icode, ld_newavgprice)
												if this.it_transobject.sqlcode <> 0 then
													lb_commitflag = false
													ls_errortext = "Item Avg. Price Updation Error:~r~n" + this.it_transobject.sqlerrtext
												end if
											else
												ld_newavgprice = ld_avgprice
											end if
											lds_purdetail.object.newavgprice[li_detailcounter] = ld_newavgprice
											if lb_commitflag then
												this.it_transobject.getitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
												if this.it_transobject.sqlcode = 0 then
													ld_newstock = ld_stock + ld_purqty + ld_purbonusqty
													this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock)
													if this.it_transobject.sqlcode = 0 then
														if wf_update_manfdate(ll_icode, ll_gcode, ls_batch, ld_expiry, ld_mfgdate) <> 0 then
															lb_commitflag = false
															ls_errortext = "Stock Updation, Mfg. Date Updation Error:~r~n" + this.it_transobject.sqlerrtext
														end if
													else
														lb_commitflag = false
														ls_errortext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
													end if
												else
													lb_commitflag = false
													ls_errortext = "Batch Wise Stock Fetch Error:~r~n" + this.it_transobject.sqlerrtext
												end if
											end if
										else
											lb_commitflag = false
										end if
									else
										lb_commitflag = false
									end if
								else
									lb_commitflag = false
								end if
							else
								lb_commitflag = false
							end if
							li_detailcounter = li_detailcounter + 1
						loop
						if lb_commitflag = false then
							SQL rollback USING this.it_transobject;
							messagebox("Updation Fail", string(ll_invcode) + " can not be posted.~r~n" + ls_errortext)
							destroy lds_purinvforposting
							destroy lds_purheader
							destroy lds_purdetail
							return lb_commitflag
						else
							if lds_purheader.update(true, false) < 0 then
								SQL rollback USING this.it_transobject;
							end if
							if lds_purdetail.update() > 0 then
								SQL commit USING this.it_transobject;
							else
								SQL rollback USING this.it_transobject;
							end if
						end if
					end if
				next
				messagebox("Posting", "Posting Completed")
				destroy lds_purinvforposting
				destroy lds_purheader
				destroy lds_purdetail
				return lb_commitflag
			end if
			return
		end if
		return
	end if
	setpointer(arrow!)
	destroy lds_purinvforposting
	destroy lds_purheader
	destroy lds_purdetail
	return lb_commitflag

// w_receipt.wf_saveandpost() returns 0
	integer li_postingmode
	long ll_sinvcode
	long ll_linvcode
	boolean lb_commitflag
	if not wf_iseditable() then
		return
	end if
	event ue_save()
	if this.ib_commitok then
		ll_sinvcode = this.id_master.getitemnumber(1, "code")
		ll_linvcode = this.id_master.getitemnumber(1, "code")
		if isnull(ll_sinvcode) or isnull(ll_linvcode) or ll_sinvcode < 0 and ll_linvcode < 0 then
			return
		else
			lb_commitflag = wf_post_receipt(li_postingmode, ll_sinvcode, ll_linvcode)
		end if
	end if
	setpointer(arrow!)

// w_receipt.wf_duplicate_batch_in_receipt(long al_icode, string as_batch) returns boolean
	string ls_batch
	SQL SELECT Max ( Batch ) INTO :ls_batch FROM DBO.ReceiptDetail WHERE ICode =:al_icode AND Batch =:as_batch USING sqlca;
	if sqlca.sqlcode <> 0 then
		messagebox("Batch Verification Error", "Can not Validate Batch in receipt~r~nSome database Problem Occured~r~nReasons are:-" + sqlca.sqlerrtext)
		return false
	elseif not isnull(ls_batch) then
		messagebox("Batch Verification Error", "Can not enter Duplicate Batch in receipt~r~nPerhaps this batch is already allocated to this item")
		return false
	end if
	return true

// w_receipt.wf_generatebatches() returns long
	s_arguements lstr_arg
	long ll_tobeinserted
	long ll_row
	long ll_counter
	long ll_seq
	long ll_insertcount
	string ls_errortext
	if this.tab_retrieve.selectedtab = 2 then
		return 0
	end if
	if wf_iseditable() = false then
		return 0
	end if
	open(w_arg_item_batch_generation_receipt)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		if this.id_detail.rowcount() > 0 and isnull(this.id_detail.object.icode[this.id_detail.rowcount()]) then
			this.id_detail.setrow(this.id_detail.rowcount())
			this.id_detail.scrolltorow(this.id_detail.rowcount())
			triggerevent("ue_deleteitem")
		end if
		if lstr_arg.l_code3 = 0 then
			return 0
		end if
		if lstr_arg.l_code4 = 0 then
			return 0
		end if
		ll_tobeinserted = lstr_arg.l_code4
		ll_seq = lstr_arg.l_code2
		for ll_counter = 1 to ll_tobeinserted
			ll_row = this.id_detail.insertrow(0)
			if ll_row > 0 then
				if wf_duplicate_batch_in_receipt(lstr_arg.l_code1, lstr_arg.s_name1 + trim(string(ll_seq)) + lstr_arg.s_name2) then
					if wf_inititeminfo(lstr_arg.l_code1, ll_row, ls_errortext) = true then
						this.id_detail.object.batch[ll_row] = lstr_arg.s_name1 + trim(string(ll_seq)) + lstr_arg.s_name2
						this.id_detail.object.qty[ll_row] = lstr_arg.l_code5
						this.id_detail.object.expiry[ll_row] = date(lstr_arg.d_sdate)
						ll_seq = ll_seq + lstr_arg.l_code3
						ll_insertcount = ll_insertcount + 1
					end if
				else
					this.id_detail.setcolumn("qty")
					this.id_detail.setfocus()
					return 0
				end if
				return
			end if
		next
	end if
	if this.id_detail.rowcount() > 0 then
		this.im_menu.m_file.m_save.enabled = true
	end if
	if ll_insertcount > 0 then
		wf_saveandpost()
		if wf_commitform() = true then
			triggerevent("ue_new")
		end if
	end if
	return 0

// w_receipt.wf_itempurchasehistory() returns 0
	s_itempurchasehistory ls_itempurchasehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itempurchasehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itempurchasehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_itempurchasehistory, ls_itempurchasehistory)
	end if

// w_receipt.wf_populate_saleorder() returns long
	datastore lds_saleorderdetail
	datastore lds_saleorderheader
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_counter
	long ll_tmpqty
	long ll_tmpbonus
	long ll_tmprowid
	long ll_tmpcode
	long ll_icode
	long ll_recipientcode
	long ll_format
	integer li_retcode
	integer li_errcode
	string ls_errortext
	string ls_itemname
	string ls_class
	string ls_batch
	boolean lb_enablesave
	boolean lb_insertrow
	if wf_iseditable() = false then
		return 0
	end if
	lds_saleorderdetail = create datastore
	lds_saleorderheader = create datastore
	open(w_editsaleorder_in_receipt_form)
	lstr_template = message.powerobjectparm
	setpointer(hourglass!)
	this.id_detail.setredraw(false)
	if lstr_template.c_copyinvfrom = "T" then
		open(w_selectformat_sale_receipt)
		ll_format = message.doubleparm
		if ll_format = 1 then
			lds_saleorderdetail.dataobject = "d_saleorderdetail_receipt_retrieve"
		else
			lds_saleorderdetail.dataobject = "d_saleorderdetail_sale_population"
		end if
		lds_saleorderdetail.settransobject(this.it_transobject)
		lds_saleorderheader.dataobject = "d_SaleOrderheader"
		lds_saleorderheader.settransobject(this.it_transobject)
		ll_row = lds_saleorderheader.retrieve(lstr_template.l_invtemplate)
		if ll_format = 1 then
			lds_saleorderdetail.retrieve(lstr_template.l_invtemplate)
		else
			lds_saleorderdetail.retrieve(lstr_template.l_invtemplate, 1)
			lds_saleorderdetail.setfilter("looseqty - saleqty > 0 OR bonusqty - salebonus > 0")
			lds_saleorderdetail.filter()
		end if
		ll_totalrows = lds_saleorderheader.retrieve(lstr_template.l_invtemplate)
		if ll_row <= 0 then
			li_retcode = -1
		else
			ll_mrow = this.id_master.getrow()
			this.id_master.setitem(ll_mrow, "RecipientCode", ll_recipientcode)
			event ue_set_requiredcolumns(ll_recipientcode, 0)
			this.id_master.setitem(ll_mrow, "AccCode", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "custcode"))
			this.id_master.setitem(ll_mrow, "remarks", lds_saleorderheader.getitemstring(lds_saleorderheader.getrow(), "remarks"))
			this.id_master.setitem(ll_mrow, "referenceno", lds_saleorderheader.getitemstring(lds_saleorderheader.getrow(), "custrefno"))
			this.id_master.setitem(ll_mrow, "headerno", lds_saleorderheader.getitemnumber(lds_saleorderheader.getrow(), "headerno"))
		end if
		ll_totalrows = lds_saleorderdetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		if lb_enablesave then
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
			this.id_detail.reset()
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				lb_insertrow = false
				ll_tmpqty = 0
				ll_tmpbonus = 0
				ll_tmprowid = lds_saleorderdetail.getitemnumber(ll_counter, "rowid")
				ll_tmpcode = this.id_master.getitemnumber(1, "code")
				lb_insertrow = true
				if lb_insertrow = true then
					ll_rowcount = this.id_detail.insertrow(0)
					ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_saleorderdetail.getitemnumber(ll_counter, "gcode")), 1, this.idc_godown.rowcount())
					ll_icode = lds_saleorderdetail.getitemnumber(ll_counter, "icode")
					ls_itemname = lds_saleorderdetail.getitemstring(ll_rowcount, "itemname")
					if wf_inititeminfo(ll_icode, ll_rowcount, ls_errortext) then
						ll_gcode = lds_saleorderdetail.getitemnumber(ll_counter, "gcode")
						this.id_detail.setitem(ll_rowcount, "gcode", ll_gcode)
						if lstr_template.i_invtype = 0 then
							this.id_detail.object.batch[ll_rowcount] = f_stringpreferences("defaultbatch")
						elseif lstr_template.i_invtype = 1 then
							SQL SELECT NAME INTO :ls_class FROM DBO.ItemClass WHERE ICCode IN ( SELECT ICCode FROM Item WHERE ICode =:ll_icode ) USING this.it_transobject;
							ll_tmpcode = lds_saleorderdetail.getitemnumber(ll_counter, "code")
							ls_batch = trim(string(ll_tmpcode)) + trim(string(ll_icode)) + ls_class
							this.id_detail.object.batch[ll_rowcount] = ls_batch
						elseif lstr_template.i_invtype = 2 then
							this.id_detail.object.batch[ll_rowcount] = lds_saleorderdetail.object.batch[ll_counter]
						end if
						this.id_detail.object.manfdate[ll_rowcount] = lds_saleorderdetail.object.manfdate[ll_counter]
						this.id_detail.object.expiry[ll_rowcount] = lstr_template.d_date
						this.id_detail.setitem(ll_rowcount, "SaleOrderrowid", lds_saleorderdetail.getitemnumber(ll_counter, "rowid"))
						if ll_format = 1 then
							this.id_detail.setitem(ll_rowcount, "qty", lds_saleorderdetail.getitemnumber(ll_counter, "looseqty") + lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty"))
						else
							this.id_detail.setitem(ll_rowcount, "qty", lds_saleorderdetail.getitemnumber(ll_counter, "looseqty") + lds_saleorderdetail.getitemnumber(ll_counter, "bonusqty") - lds_saleorderdetail.getitemnumber(ll_counter, "saleqty") - lds_saleorderdetail.getitemnumber(ll_counter, "salebonus"))
						end if
					end if
				end if
			next
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	this.id_detail.setredraw(true)
	setpointer(arrow!)
	return li_retcode

// w_receipt.wf_populatedetaildwfrompo() returns integer
	datastore lds_podetail
	long ll_detailrows
	long ll_count
	long ll_pocode
	long ll_insrow
	integer li_result
	integer li_rtncode
	string ls_errortext
	boolean populateflag
	s_saletemplate lstr_template
	long ll_rowcount
	long ll_rtcode
	long ll_icode
	long ll_gcode
	long ll_packunits
	long ll_retrievecount
	long ll_lockedcount
	double ld_purprice
	double ld_discperc
	double ld_avgprice
	string ls_fullcode
	double ld_stock
	this.id_detail.reset()
	if f_validatedw(this.id_detail) < 0 then
		return 0
	end if
	if this.id_master.object.recipientcode[1] <> 3 then
		return 0
	end if
	open(w_editpurchaseorderform)
	lstr_template = message.powerobjectparm
	if lstr_template.l_invtemplate <= 0 then
		return 0
	end if
	ll_pocode = lstr_template.l_invtemplate
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 and not isnull(this.id_detail.object.icode[1]) then
		li_result = messagebox("Warning", "Rows in Detail Window will Lost", exclamation!, okcancel!, 2)
		if li_result = 1 then
			this.id_detail.reset()
		else
			populateflag = false
		end if
	end if
	if populateflag = true then
		this.id_detail.setredraw(false)
		setpointer(hourglass!)
		lds_podetail = create datastore
		lds_podetail.dataobject = "d_purchaseorderdetail"
		lds_podetail.settransobject(this.it_transobject)
		ll_rtcode = lds_podetail.retrieve(ll_pocode)
		ll_rowcount = lds_podetail.rowcount()
		for ll_count = 1 to ll_rowcount
			ll_icode = lds_podetail.object.icode[ll_count]
			ll_insrow = this.id_detail.insertrow(0)
			if ll_insrow > 0 and wf_inititeminfo(ll_icode, ll_insrow, ls_errortext) = true then
				ll_packunits = this.id_detail.object.packunits[ll_insrow]
				if ll_packunits = 0 then
					ll_packunits = 1
				end if
				this.id_detail.object.packunits[ll_insrow] = ll_packunits
				this.id_detail.object.icode[ll_insrow] = ll_icode
				this.id_detail.object.gcode[ll_insrow] = gl_defaultgcode
				this.id_detail.setitem(ll_insrow, this.is_columnitemname, this.id_itemslist.getitemstring(this.id_itemslist.find("icode" + "= integer('" + string(ll_icode) + "')", 1, 99999), this.is_columnitemname))
				this.id_detail.object.batch[ll_insrow] = "."
				this.id_detail.object.expiry[ll_insrow] = today()
				this.id_detail.object.qty[ll_insrow] = lds_podetail.object.qty[ll_count] * ll_packunits
				this.id_detail.object.price[ll_insrow] = round(lds_podetail.object.purprice[ll_count] * lds_podetail.object.discperc[ll_count] * 0.01 / ll_packunits, 2)
				ll_retrievecount = ll_retrievecount + 1
			end if
		next
		destroy lds_podetail
		setpointer(arrow!)
		this.id_detail.setredraw(true)
	end if
	if ll_retrievecount = ll_rowcount then
		messagebox("Result", "Purchase Order retrieval is Successfull~n~r" + string(ll_rowcount) + " Items are retrieved. ")
	else
		messagebox("Result", "Total records were " + string(ll_rowcount) + "~n~r" + string(ll_retrievecount) + " records are retrieved successfully~n~r" + string(ll_rowcount - ll_retrievecount) + " records are in error")
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows > 0 then
		this.im_menu.m_file.m_save.enabled = true
	end if
	return ll_retrievecount

// w_receipt.wf_open_item_form_popup() returns 0
	openwithparm(w_passport_form_popup, this, this)

// w_receipt.wf_validateworkorder(long al_code) returns long
	long ll_code
	long ll_custcode
	long ll_recipientcode
	SQL SELECT WorkOrderCode , CustCode INTO :ll_code, :ll_custcode FROM WorkOrder WHERE WorkOrderCode =:al_code AND Approved ='Y' AND Posted ='N' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ll_code) or ll_code < 0 then
			return -1
		else
			post event ue_set_requiredcolumns(ll_recipientcode, 1)
			ll_recipientcode = 2
			this.id_master.object.recipientcode[1] = ll_recipientcode
			this.id_master.object.acccode[1] = ll_custcode
			return 0
		end if
		return
	end if
	return -1

// w_receipt.wf_item_image_setting() returns long
	if f_stringpreferences("showitemimageinreceipt") = "N" then
		this.id_master.object.p_itemimage.visible = 0
	else
		this.it_imagetrans = create u_transaction
		this.it_imagetrans.autocommit = true
		SQL start USING this.it_imagetrans;
		if this.it_imagetrans.sqlcode <> 0 then
			return -1
		end if
		this.id_master.object.p_itemimage.visible = 1
	end if
	return 0

// w_receipt.wf_set_itemimage(long al_icode) returns long
	long ll_rowid
	string ls_filename
	string ls_imagetype
	string ls_imagedesc
	blob lb_image
	this.id_master.object.p_itemimage.filename = ""
	if al_icode <= 0 or isnull(al_icode) then
		return 0
	end if
	if f_stringpreferences("showitemimageinreceipt") = "N" then
		return 0
	end if
	this.it_imagetrans.getfirstitemimagedetail(al_icode, ll_rowid, ls_imagetype, ls_imagedesc)
	if this.it_imagetrans.sqlcode <> 0 then
		messagebox("Item Image/Picture ", "Unable to fetch item Image Details.~r~nReasons are:~r~n" + this.it_imagetrans.sqlerrtext)
		return -1
	end if
	if ll_rowid <= 0 then
		return 0
	end if
	SQL SelectBlob ItemImage INTO :lb_image From ItemImage Where Icode =:al_icode AND RowID =:ll_rowid USING this.it_imagetrans;
	if this.it_imagetrans.sqlcode <> 0 then
		messagebox("Item Image/Picture ", "Unable to fetch item Image.~r~nReasons are:~r~n" + this.it_imagetrans.sqlerrtext)
		return -1
	end if
	ls_filename = gs_temp_img_filename
	ls_filename = left(ls_filename, len(ls_filename) - 4)
	ls_filename = trim(string(ls_filename)) + "." + ls_imagetype
	f_writeimgtofile(ls_filename, lb_image)
	this.id_master.object.p_itemimage.filename = ls_filename
	return 0

// w_receipt.wf_populate_issue() returns long
	datastore lds_issuedetail
	datastore lds_issueheader
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	long ll_validgodowncode
	long ll_gcode
	long ll_counter
	long ll_tmprowid
	long ll_found
	long ll_tmpcode
	long ll_icode
	long ll_recipientcode
	long ll_format
	double ld_tmpqty
	double ld_tmpbonus
	integer li_retcode
	integer li_errcode
	string ls_errortext
	string ls_itemname
	string ls_class
	string ls_batch
	boolean lb_enablesave
	boolean lb_insertrow
	if wf_iseditable() = false then
		return 0
	end if
	lds_issuedetail = create datastore
	lds_issueheader = create datastore
	if isnull(this.id_master.object.issueinvcode[1]) then
		open(w_edit_issue_posted)
		lstr_template = message.powerobjectparm
	else
		lstr_template.c_copyinvfrom = "T"
		lstr_template.l_invtemplate = this.id_master.object.issueinvcode[1]
	end if
	setpointer(hourglass!)
	this.id_detail.setredraw(false)
	if lstr_template.c_copyinvfrom = "T" then
		lds_issuedetail.dataobject = "d_populate_issue_in_receipt"
		lds_issuedetail.settransobject(this.it_transobject)
		lds_issueheader.dataobject = "d_issueheader"
		lds_issueheader.settransobject(this.it_transobject)
		ll_row = lds_issueheader.retrieve(lstr_template.l_invtemplate)
		lds_issuedetail.retrieve(lstr_template.l_invtemplate)
		ll_totalrows = lds_issueheader.retrieve(lstr_template.l_invtemplate)
		if ll_row <= 0 then
			li_retcode = -1
		else
			ll_mrow = this.id_master.getrow()
			ll_recipientcode = lds_issueheader.getitemnumber(lds_issueheader.getrow(), "RecipientCode")
			this.id_master.setitem(ll_mrow, "RecipientCode", ll_recipientcode)
			this.id_master.setitem(ll_mrow, "AccCode", lds_issueheader.getitemnumber(lds_issueheader.getrow(), "AccCode"))
			this.id_master.setitem(ll_mrow, "DeptCode", lds_issueheader.getitemnumber(lds_issueheader.getrow(), "DeptCode"))
			this.id_master.setitem(ll_mrow, "RecipientSalesMan", lds_issueheader.getitemnumber(lds_issueheader.getrow(), "RecipientSalesMan"))
			this.id_master.setitem(ll_mrow, "pricetypecode", lds_issueheader.getitemnumber(lds_issueheader.getrow(), "pricetypecode"))
			this.id_master.setitem(ll_mrow, "remarks", lds_issueheader.getitemstring(lds_issueheader.getrow(), "remarks"))
			this.id_master.setitem(ll_mrow, "referenceno", lds_issueheader.getitemstring(lds_issueheader.getrow(), "referenceno"))
			this.id_master.setitem(ll_mrow, "referencedate", lds_issueheader.getitemdatetime(lds_issueheader.getrow(), "referencedate"))
			this.id_master.setitem(ll_mrow, "headerno", lds_issueheader.getitemnumber(lds_issueheader.getrow(), "headerno"))
			this.id_master.setitem(ll_mrow, "areacode", lds_issueheader.getitemnumber(lds_issueheader.getrow(), "areacode"))
			this.id_master.setitem(ll_mrow, "smancode", lds_issueheader.getitemnumber(lds_issueheader.getrow(), "smancode"))
			event ue_set_requiredcolumns(ll_recipientcode, 0)
		end if
		wf_deleteallemptydetailrows()
		ll_totalrows = lds_issuedetail.rowcount()
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
		if lb_enablesave then
			for ll_counter = 1 to ll_rowcount
				triggerevent("ue_deleteitem")
			next
			ll_counter = 0
			for ll_counter = 1 to ll_totalrows
				lb_insertrow = false
				ld_tmpqty = 0
				ld_tmpbonus = 0
				ll_tmprowid = lds_issuedetail.getitemnumber(ll_counter, "issuerowid")
				ll_tmpcode = this.id_master.getitemnumber(1, "code")
				if lstr_template.b_userinput = true then
					for ll_rowcount = 1 to this.id_detail.rowcount()
						event ue_deleteitem()
					next
				end if
				lb_insertrow = true
				if lb_insertrow = true then
					ll_rowcount = this.id_detail.insertrow(0)
					ll_validgodowncode = this.idc_godown.find("gcode=" + string(lds_issuedetail.getitemnumber(ll_counter, "gcode")), 1, this.idc_godown.rowcount())
					ll_icode = lds_issuedetail.getitemnumber(ll_counter, "icode")
					ls_itemname = lds_issuedetail.getitemstring(ll_counter, "itemname")
					if this.ic_issuecompulsion = "N" then
						if wf_inititeminfo(ll_icode, ll_rowcount, ls_errortext) then
							ll_gcode = lds_issuedetail.getitemnumber(ll_counter, "gcode")
							this.id_detail.setitem(ll_rowcount, "gcode", ll_gcode)
							this.id_detail.object.batch[ll_rowcount] = lds_issuedetail.object.batch[ll_counter]
							this.id_detail.object.expiry[ll_rowcount] = lds_issuedetail.object.expiry[ll_counter]
							this.id_detail.object.price[ll_rowcount] = lds_issuedetail.object.price[ll_counter]
							this.id_detail.object.issuerowid[ll_rowcount] = lds_issuedetail.object.issuerowid[ll_counter]
							if lstr_template.i_invtype = 0 then
								ld_tmpqty = lds_issuedetail.object.qty[ll_counter]
							else
								ld_tmpqty = lds_issuedetail.object.qty[ll_counter] - lds_issuedetail.object.receiptqty[ll_counter]
							end if
							if ld_tmpqty < 0.0 then
								ld_tmpqty = 0
							end if
							this.id_detail.object.qty[ll_rowcount] = ld_tmpqty
						end if
					elseif wf_inititeminfo(this.idc_itemdddw, ll_rowcount, ll_counter, ls_errortext) < 0 then
						this.id_detail.deleterow(ll_rowcount)
					end if
				end if
			next
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	wf_grandtotal()
	this.id_detail.setredraw(true)
	setpointer(arrow!)
	return li_retcode

// w_receipt.wf_deleteallemptydetailrows() returns long
	long ll_count
	long ll_deletecount
	ll_deletecount = 0
	for ll_count = 1 to this.id_detail.rowcount()
		if isnull(this.id_detail.getitemnumber(ll_count, "icode")) then
			ll_deletecount = ll_deletecount + 1
			this.id_detail.deleterow(ll_count)
		end if
	next
	return ll_deletecount

// w_receipt.wf_update_manfdate(long al_icode, long al_gcode, string as_batch, datetime adt_expiry, datetime adt_manfdate) returns long
	SQL update GodownDetail SET GodownDetail.ManfDate =:adt_manfdate WHERE GodownDetail.GCode =:al_gcode AND GodownDetail.ICode =:al_icode AND GodownDetail.Batch =:as_batch AND GodownDetail.Expiry =:adt_expiry USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		return 0
	end if
	return this.it_transobject.sqlcode

// w_receipt.wf_autoreplacebatches() returns long
	long ll_detailrows
	long ll_count
	long ll_receiptcode
	double ld_totqty
	string ls_batch
	if this.ic_autoreplacebatches = "Y" then
		ll_detailrows = this.id_detail.rowcount()
		ll_count = 1
		ll_receiptcode = this.id_master.object.code[1]
		if isnull(string(ll_receiptcode)) then
			ll_receiptcode = 0
		end if
		ld_totqty = this.id_detail.getitemnumber(1, "c_totqty")
		if isnull(string(ld_totqty)) then
			ld_totqty = 0
		end if
		ls_batch = trim(string(ll_receiptcode)) + "/" + trim(string(ld_totqty, "######0"))
		if ll_detailrows > 0 then
			for ll_count = 1 to ll_detailrows
				this.id_detail.object.batch[ll_count] = ls_batch
			next
		end if
	end if
	return 0

// w_receipt.wf_get_preference(string as_pref) returns string
	long ll_found
	string ls_pref_value
	s_preference ls_pref
	datastore lds_pref
	lds_pref = create datastore
	lds_pref.dataobject = "d_general1"
	lds_pref.settransobject(sqlca)
	lds_pref.retrieve()
	if lds_pref.rowcount() > 0 then
		ll_found = lds_pref.find("name='" + as_pref + "'", 1, lds_pref.rowcount())
		if ll_found > 0 and ll_found <= lds_pref.rowcount() then
			ls_pref.id = lds_pref.object.prefid[ll_found]
			ls_pref.name = lds_pref.object.name[ll_found]
			ls_pref.caption = lds_pref.object.caption[ll_found]
			ls_pref.datatype = lds_pref.object.prefdatatype[ll_found]
			ls_pref.value = lds_pref.object.prefvalue[ll_found]
			ls_pref.value2 = lds_pref.object.prefvalue2[ll_found]
			ls_pref.subcatcode = lds_pref.object.subcatcode[ll_found]
			ls_pref.colwidth = lds_pref.object.colwidth[ll_found]
			ls_pref.decimal = lds_pref.object.decimals[ll_found]
			ls_pref.userobject = lds_pref.object.usedobject[ll_found]
			ls_pref.visible = lds_pref.object.visible[ll_found]
			ls_pref.assocprefname = lds_pref.object.assocprefname[ll_found]
			ls_pref.assocrightcode = lds_pref.object.assocrightcode[ll_found]
			if lower(left(ls_pref.userobject, 1)) = "w" then
				choose case ls_pref.userobject
				case "w_pref_get_text"
					openwithparm(w_pref_get_text, ls_pref)
				case "w_pref_get_text2"
					openwithparm(w_pref_get_text2, ls_pref)
				case "w_pref_get_datetime"
					openwithparm(w_pref_get_datetime, ls_pref)
				case "w_pref_get_date"
					openwithparm(w_pref_get_date, ls_pref)
				case "w_pref_get_long"
					openwithparm(w_pref_get_long, ls_pref)
				case "w_pref_get_decimal"
					openwithparm(w_pref_get_decimal, ls_pref)
				case "w_pref_get_password"
					openwithparm(w_pref_get_password, ls_pref)
				end choose
			elseif lower(left(ls_pref.userobject, 1)) = "d" then
				openwithparm(w_pref_get_dropdown, ls_pref)
			elseif ls_pref.userobject <> "imagefiledialog" then
				if ls_pref.userobject = "filedirectorydialog" then
				end if
			end if
			if lower(left(ls_pref.userobject, 1)) = "d" or lower(left(ls_pref.userobject, 1)) = "w" then
				ls_pref = message.powerobjectparm
				if ls_pref.status then
					ls_pref_value = ls_pref.value
				end if
			else
				ls_pref_value = ls_pref.value
			end if
		end if
	end if
	return ls_pref_value

// w_receipt.wf_genenerate_receiptcategory_counter(integer ai_receiptcategorycode, long al_receiptcode, transaction at_transobject) returns long
	long ll_rtcode
	SQL SELECT dbo.ReceiptCategory.COUNTER INTO :al_receiptcode FROM dbo.ReceiptCategory WITH ( UPDLOCK HOLDLOCK ) WHERE dbo.ReceiptCategory.ReceiptCategoryCode =:ai_receiptcategorycode USING at_transobject;
	if at_transobject.sqlcode = 0 then
		al_receiptcode = al_receiptcode + 1
		SQL update dbo.ReceiptCategory SET dbo.ReceiptCategory.COUNTER =:al_receiptcode WHERE dbo.ReceiptCategory.ReceiptCategoryCode =:ai_receiptcategorycode USING at_transobject;
		if at_transobject.sqlcode < 0 then
			ll_rtcode = at_transobject.sqlcode
			al_receiptcode = 0
		end if
	else
		ll_rtcode = at_transobject.sqlcode
		al_receiptcode = 0
	end if
	return ll_rtcode

// w_receipt.wf_lockinvoice(long al_code) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From ReceiptHeader WITH ( UPDLOCK HOLDLOCK ) Where ReceiptHeader.ReceiptInvcode =:al_code USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_receipt.wf_lockinvoices(long al_sinvcode, long al_linvcode, integer ai_receiptcategorycode) returns integer
	long ll_count
	SQL SELECT count ( *) INTO :ll_count FROM ReceiptHeader WITH ( UPDLOCK HOLDLOCK ) WHERE ReceiptHeader.ReceiptInvcode Between :al_sinvcode and :al_linvcode AND ReceiptHeader.ReceiptCategoryCode =:ai_receiptcategorycode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_receipt.wf_lockreceiptinvoices(long al_sinvcode, long al_linvcode, integer ai_receiptcategorycode) returns integer
	integer li_count
	SQL SELECT count ( *) INTO :li_count FROM ReceiptHeader WITH ( UPDLOCK HOLDLOCK ) WHERE ReceiptHeader.receiptinvcode Between :al_sinvcode and :al_linvcode AND ReceiptHeader.ReceiptCategoryCode =:ai_receiptcategorycode USING this.it_transobject;
	return this.it_transobject.sqlcode

