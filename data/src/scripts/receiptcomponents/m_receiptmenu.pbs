	this.m_populatedallissueditems = create m_populatedallissueditems
	this.m_pullsalesfromdropbox = create m_pullsalesfromdropbox
	this.m_pullissuefromdropbox = create m_pullissuefromdropbox
	this.item[upperbound(this.item) + 1] = this.m_saveandpost
	this.item[upperbound(this.item) + 1] = this.m_autobatchgeneration
	this.item[upperbound(this.item) + 1] = this.m_itempurchsehistory
	this.item[upperbound(this.item) + 1] = this.m_populatesaleorder
	this.item[upperbound(this.item) + 1] = this.m_populatefromdatacarrydb
	this.item[upperbound(this.item) + 1] = this.m_populateandpostfromdatacarrydb
	this.item[upperbound(this.item) + 1] = this.m_populateissuedeliverychallan
	this.item[upperbound(this.item) + 1] = this.m_populatedallissueditems
	this.item[upperbound(this.item) + 1] = this.m_pullsalesfromdropbox
	this.item[upperbound(this.item) + 1] = this.m_pullissuefromdropbox

// m_file.destroy() returns 0 [event]
