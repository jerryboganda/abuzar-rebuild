	this.facename = "Tahoma"
	this.titlebackcolor = 134217730
	this.bitmapbackcolor = 12632256
	this.menubitmaps = true
	this.titlegradient = true
	this.toolbartextcolor = 134217746
	this.toolbarbackcolor = 67108864
	this.toolbarhighlightcolor = 134217741
	this.toolbargradient = true
	this.bitmapgradient = true

// m_save.destroy() returns 0 [event]
	call super::destroy

// m_save.clicked() returns 0 [event]
	if f_stringpreferences("ReceiptAutoPosting") = "Y" then
		this.parentwindow.dynamic wf_saveandpost()
	else
		this.parentwindow.triggerevent("ue_save")
	end if
	if this.parentwindow.dynamic wf_commitform() = true then
		this.parentwindow.postevent("ue_new")
	end if

