// m_file.create() returns 0 [event]
	call super::create
	this.m_saveandpost = create m_saveandpost
	this.m_autobatchgeneration = create m_autobatchgeneration
	this.m_itempurchsehistory = create m_itempurchsehistory
	this.m_populatesaleorder = create m_populatesaleorder
