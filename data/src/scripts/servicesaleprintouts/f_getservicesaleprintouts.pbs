				elseif gs_company = "TAHIRMCBLANK" then
					ls_dataobject = "d_tahirmcblank_serviceinvrep_3inch"
				elseif gs_company = "BAKHTAWARPH2" then
					ls_dataobject = "d_bakhtawarph2_serviceinvrep_t"
				elseif gs_company = "PAKPEARLINST" or gs_company = "PAKPEARLINST2" then
					ls_dataobject = "d_pakpearlinst_serviceinvrep"
				elseif gs_company = "HABIBMEDICAL" then
					ls_dataobject = "d_habibmedical_serviceinvrep_t"
				elseif gs_company = "MAFAZATULHAYAT" then
					ls_dataobject = "d_mafazatulhayat_serviceinvrep_t"
				elseif gs_company = "NAZEERHSP" then
