		ls_dataobject = "d_imranmemoriall_serviceinvrep_t"
	elseif gs_company = "STANDARDCAREHSP" then
		ls_dataobject = "d_standardcarehsp_serviceinvrep_full"
	end if
	if ls_dataobject = "" then
		if as_servicetype = 11 then
			ls_pagesize = f_stringpreferences("creditservicepagesize")
			if ls_pagesize = "Q" then
				if f_stringpreferences("PatientOnCreditSale") = "N" then
					ls_dataobject = "d_creditserviceinvreport"
				else
					ls_dataobject = "d_patientcreditserviceinvrep"
				end if
			elseif ls_pagesize = "H" then
				if gs_company = "HABIBMEDICAL" then
					SQL SELECT MAX ( Service.ServiceCode ) INTO :ll_servicecode FROM Service , ServiceDetail WHERE ServiceDetail.ServiceInvCode =:al_serviceinvcode AND ServiceDetail.ServiceCode =Service.ServiceCode AND Service.ServiceTypeCode =2 USING sqlca;
					if sqlca.sqlcode = 0 then
						if ll_servicecode > 0 then
							ls_dataobject = "d_habibmedical_patientserviceinv_half2"
						else
							ls_dataobject = "d_habibmedical_patientserviceinvrep_half"
						end if
					else
						ls_dataobject = "d_habibmedical_patientserviceinvrep_half"
					end if
				elseif gs_company = "MMTRUSTHSP" then
					ls_dataobject = "d_mmtrusthsp_creditserviceinvrep_h"
				else
					ls_dataobject = "d_patientserviceinvrep_half"
				end if
			elseif ls_pagesize = "F" then
				if gs_company = "KARAMATHC" then
					ls_dataobject = "d_karamathc_patientserviceinvrep_f"
				else
					ls_dataobject = "d_patientserviceinvrep_full"
				end if
			elseif ls_pagesize = "T" then
				if gs_company = "SHAHBANOHSP" then
					ls_dataobject = "d_shahbanohsp_serviceinvrep_t"
