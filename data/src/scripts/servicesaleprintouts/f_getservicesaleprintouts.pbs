				end if
			elseif ls_pagesize = "F" then
				if gs_company = "MMTRUSTHSP" then
					ls_dataobject = "d_mmtrusthsp_patientserviceinvrep_f"
				elseif gs_company = "KARAMATHC" then
					ls_dataobject = "d_karamathc_patientserviceinvrep_f"
				else
					ls_dataobject = "d_patientserviceinvrep_full"
				end if
			elseif ls_pagesize = "T" then
