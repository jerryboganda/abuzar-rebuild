					ls_dataobject = "d_mafazatulhayat_serviceinvrep_t"
				elseif gs_company = "KARAMATHC" then
					ls_dataobject = "d_karamathc_serviceinvrep_t"
				else
					ls_dataobject = "d_thermal_serviceinvrep_3inch"
				end if
			end if
		else
			ls_pagesize = f_stringpreferences("cashservicepagesize")
			if ls_pagesize = "Q" then
				if f_stringpreferences("PatientOnCreditSale") = "N" then
					ls_dataobject = "d_cashserviceinvreport"
				else
					ls_dataobject = "d_patientserviceinvrep"
				end if
			elseif ls_pagesize = "H" then
				if gs_company = "HABIBMEDICAL" then
					SQL SELECT MAX ( Service.ServiceCode ) INTO :ll_servicecode FROM Service , ServiceDetail WHERE ServiceDetail.ServiceInvCode =:al_serviceinvcode AND ServiceDetail.ServiceCode =Service.ServiceCode AND Service.ServiceTypeCode =2 USING sqlca;
					if sqlca.sqlcode = 0 then
						if ll_servicecode > 0 then
							ls_dataobject = "d_habibmedical_patientserviceinv_half2"
						else
							ls_dataobject = "d_habibmedical_patientserviceinvrep_half"
						end if
					else
						ls_dataobject = "d_habibmedical_patientserviceinvrep_half"
					end if
				else
