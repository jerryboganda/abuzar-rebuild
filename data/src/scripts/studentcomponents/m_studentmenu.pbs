// menu m_studentmenu (studentcomponents)  ancestor: m_single_entry

// m_studentmenu.create() returns 0 [event]
	m_studentmenu = this
	call super::create
	this.text = "m_studentmenu"

// m_studentmenu.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_showstudentledger = create m_showstudentledger
	this.item[upperbound(this.item) + 1] = this.m_showstudentledger

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_showstudentledger

// m_showstudentledger.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_show_studentledger()

// m_showstudentledger.create() returns 0 [event]
	call super::create
	this.text = "Show Student Ledger~tCtrl+G"
	this.shortcut = 327
	this.menutextcolor = 134217735
	this.menubackcolor = 134217732
	this.menuhighlightcolor = 134217741
	this.textsize = 8
	this.weight = 400
	this.facename = "Tahoma"
	this.titlebackcolor = 134217730
	this.bitmapbackcolor = 12632256
	this.menubitmaps = true
	this.titlegradient = true
	this.toolbartextcolor = 134217746
	this.toolbarbackcolor = 67108864
	this.toolbarhighlightcolor = 134217741
	this.toolbargradient = true
	this.bitmapgradient = true

// m_showstudentledger.destroy() returns 0 [event]
	call super::destroy
