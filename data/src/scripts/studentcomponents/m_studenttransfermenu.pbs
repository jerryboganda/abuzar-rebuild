// menu m_studenttransfermenu (studentcomponents)  ancestor: m_single_entry

// m_studenttransfermenu.create() returns 0 [event]
	m_studenttransfermenu = this
	call super::create

// m_studenttransfermenu.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_transferhistory = create m_transferhistory
	this.item[upperbound(this.item) + 1] = this.m_transferhistory

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_transferhistory

// m_transferhistory.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_transferhistory()

// m_transferhistory.create() returns 0 [event]
	call super::create
	this.text = "Transfer History~tF5"
	this.shortcut = 116

// m_transferhistory.destroy() returns 0 [event]
	call super::destroy
