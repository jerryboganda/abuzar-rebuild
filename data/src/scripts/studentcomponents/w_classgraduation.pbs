// w_classgraduation.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	integer li_option
	boolean lb_rtflag = true
	boolean ib_due
	integer li_null
	string ls_null
	ls_titleerrtext = "Item Validation"
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), al_currrow) = true then
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
	elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			li_option = messagebox("Item Validation", "Item stock does not exist~n~rDo You want to due this item", information!, yesno!, 2)
			if li_option = 1 then
				this.id_detail.setitem(this.il_currrow, "looseqty", 1)
				this.id_detail.setitem(this.il_currrow, "dueqty", 1)
				ib_due = true
			else
				li_errcode = -1
			end if
		end if
	else
		li_errcode = -1
		ls_titleerrtext = "Item Validation"
	end if
	if li_errcode = -1 and not ib_due then
		lb_rtflag = false
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setitem(al_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(al_currrow, "icode", li_null)
		this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	end if
	return lb_rtflag

// w_classgraduation.wf_grandtotal() returns double
	double ld_grandtotal
	ld_grandtotal = 0
	return ld_grandtotal

// w_classgraduation.wf_initmodify(integer ai_protect) returns 0
	long ll_code
	ll_code = this.id_master.getitemnumber(1, "code")
	this.id_master.retrieve(ll_code)
	this.id_detail.retrieve(ll_code)
	this.ib_modify = true
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_new.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true
	this.im_menu.m_file.m_first.enabled = false
	this.im_menu.m_file.m_next.enabled = false
	this.im_menu.m_file.m_previous.enabled = false
	this.im_menu.m_file.m_last.enabled = false
	this.im_menu.m_file.m_retrieve.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.tab_retrieve.tabpage_detail.enabled = true

// w_classgraduation.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_classgraduation.wf_validateitem(boolean ab_flag) returns integer
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode = 1
	integer li_assgcode
	integer li_option
	boolean ib_due
	integer li_null
	string ls_null
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if not isnull(ll_icode) then
		if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
			ls_titleerrtext = "Item Validation"
			ls_errtext = "Duplicate item, please select some other item"
			li_errcode = -1
		elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
			if li_errcode = -2 then
				li_errcode = -1
			end if
		else
			li_errcode = -1
			ls_titleerrtext = "Item Validation"
		end if
	end if
	if ab_flag then
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		ls_titleerrtext = "Item Validation"
		messagebox(ls_titleerrtext, ls_errtext)
		this.id_detail.setcolumn("fullcode")
		this.id_detail.object.fullcode[this.il_currrow] = ls_null
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
	end if
	return li_errcode

// w_classgraduation.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	integer ll_icode
	integer ll_retflag
	integer ll_classcode
	string ls_itemname
	string ls_class
	ll_classcode = this.id_master.object.code[1]
	SQL SELECT Student.Studentcode , Student.name + ' (' + Student.RegNo + ')' INTO :ll_icode, :ls_itemname FROM Student WHERE Student.RegNo =:as_fullcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		SQL SELECT Class =MAX ( C.Name ) INTO :ls_class FROM StudentClass SC , Class C WHERE C.Active ='Y' AND C.ClassCode =SC.ClassCode AND SC.StudentCode =:ll_icode AND C.ClassCode <> :ll_classcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if isnull(ls_class) then
				al_icode = ll_icode
				al_itemname = ls_itemname
				if isnull(al_icode) then
					ll_retflag = 0
				else
					ll_retflag = 1
				end if
			else
				ll_retflag = -2
				messagebox("Student Validation", "Student already enrolled in " + ls_class)
			end if
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_classgraduation.wf_inititeminfo(long al_icode, long al_row, integer ai_rtcode, string as_errortext) returns boolean
	boolean retflag = true
	long ll_packunits
	long ll_saleinvcode
	long ll_classcode
	double ld_saleprice
	double ld_saleprice2
	double ld_saleprice3
	double ld_avgprice
	double ld_mrpp
	double ld_purprice
	double ld_godownstock
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_fname
	string ls_class
	setnull(ls_null)
	SQL SELECT RegNo , name =name + ' (' + RegNo + ')' , fname INTO :ls_fullcode, :ls_name, :ls_fname FROM Student WHERE Studentcode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Student information can not be retrieved"
	end if
	li_gcode = this.id_master.object.code[1]
	if retflag then
		ll_classcode = this.id_master.object.code[1]
		SQL SELECT Class =MAX ( C.Name ) INTO :ls_class FROM StudentClass SC , Class C WHERE C.Active ='Y' AND C.ClassCode =SC.ClassCode AND SC.StudentCode =:al_icode AND C.ClassCode <> :ll_classcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if not isnull(ls_class) then
				retflag = false
				as_errortext = "Student already enrolled in " + ls_class
			end if
		else
			retflag = false
			as_errortext = "Database Error: Student information can not be retrieved"
		end if
		this.id_detail.setitem(al_row, "code", li_gcode)
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		this.id_detail.setitem(al_row, "icode", al_icode)
		this.id_detail.setitem(al_row, "fathername", ls_fname)
	else
		retflag = false
		as_errortext = "Database Error: Student information can not be retrieved"
	end if
	return retflag

// w_classgraduation.wf_validate_class(long al_classcode) returns long
	long ll_retcode
	long ll_classcode
	long ll_counter
	long ll_insrow
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_fname
	string ls_class
	datastore lds_studentlist
	lds_studentlist = create datastore
	lds_studentlist.dataobject = "d_classstudentlist_for_graduation"
	lds_studentlist.settransobject(this.it_transobject)
	setnull(ls_null)
	lds_studentlist.retrieve(al_classcode)
	if lds_studentlist.rowcount() <= 0 then
		ll_retcode = 1
	else
		this.id_detail.reset()
		for ll_counter = 1 to lds_studentlist.rowcount()
			ll_insrow = this.id_detail.insertrow(0)
			this.id_detail.setitem(ll_insrow, "itemname", lds_studentlist.object.studentname[ll_counter])
			this.id_detail.setitem(ll_insrow, "fullcode", lds_studentlist.object.regno[ll_counter])
			this.id_detail.setitem(ll_insrow, "studentcode", lds_studentlist.object.studentcode[ll_counter])
			this.id_detail.setitem(ll_insrow, "fathername", lds_studentlist.object.fname[ll_counter])
			this.id_detail.setitem(ll_insrow, "rollno", lds_studentlist.object.rollno[ll_counter])
		next
	end if
	return ll_retcode

// w_classgraduation.create() returns 0 [event]
	integer icurrent
	call super::create
	this.dw_saleinvrep = create dw_saleinvrep
	this.dw_saleinvdetail = create dw_saleinvdetail
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.dw_saleinvdetail

// w_classgraduation.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.dw_saleinvdetail

// w_classgraduation.ue_save() returns 0 [event]
	long ll_detailrows
	long ll_counter
	long ll_count
	long ll_salesmancode
	long ll_mastercurrrow
	long ll_row
	long ll_pk
	boolean lb_commitflag = true
	boolean lb_continue = true
	integer li_counter
	string ls_errtext
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if isnull(this.id_master.getitemnumber(1, "classcode")) then
		messagebox("Class Validation", "Kindly select some Class To Graduate")
		return
	end if
	setpointer(hourglass!)
	ll_salesmancode = gl_usercode
	if ll_salesmancode > 0 then
		ll_pk = this.id_master.object.code[1]
		if isnull(ll_pk) then
			wf_tabnewid("classgraduation", ll_pk)
		end if
		if ll_pk > 0 then
			this.id_master.object.code[1] = ll_pk
			this.id_master.object.usercode[1] = ll_salesmancode
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.object.code[ll_counter] = ll_pk
			next
			if this.id_master.update(true, false) > 0 then
				if this.id_detail.update() > 0 then
					this.it_transobject.graduateclass(ll_pk)
					if this.it_transobject.sqlcode = 0 then
						SQL commit USING this.it_transobject;
						messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
						this.ib_commitok = true
						this.id_master.resetupdate()
						this.im_menu.m_file.m_new.enabled = true
						this.editflag = false
						if gd_recenttransdate < this.id_systemdate then
							gd_recenttransdate = this.id_systemdate
						end if
					else
						ls_errtext = this.it_transobject.sqlerrtext
						SQL rollback USING this.it_transobject;
						messagebox("Save Changes", "Changes Do not take effect in database~r~nReasons are:-~r~n" + ls_errtext, stopsign!, ok!, 1)
						setpointer(arrow!)
						return
					end if
				else
					messagebox("Save Changes..", "Changes Do not take effect in database", stopsign!, ok!, 1)
					SQL rollback USING this.it_transobject;
					setpointer(arrow!)
					return
				end if
			else
				messagebox("Save Changes.", "Changes Do not take effect in database", stopsign!, ok!, 1)
				SQL rollback USING this.it_transobject;
				setpointer(arrow!)
				return
			end if
			return
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_classgraduation.ue_newform() returns 0 [event]
	integer rtncode
	long ll_retcode
	setredraw(false)
	call super::ue_newform
	ll_retcode = this.id_master.getchild("classcode", this.idc_class)
	if ll_retcode = -1 then
		messagebox("Error.", "Can not get datawindow child for Graduation Class")
		close(this)
		return
	end if
	this.idc_class.settransobject(this.it_transobject)
	this.idc_class.retrieve()
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_post.enabled = false
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.ib_modify = false
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	wf_visible(true)
	setredraw(true)

