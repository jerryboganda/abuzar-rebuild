// window w_generate_studentfeesheet (studentcomponents)  ancestor: window

// w_generate_studentfeesheet.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		post event ue_close()
	end if
	return ::message.returnvalue

// w_generate_studentfeesheet.ue_close() returns 0 [event]
	closewithreturn(this, this.istr_arg)

// w_generate_studentfeesheet.wf_setnewtabid(string as_tablename, ref long al_newid) returns long
	long ll_rtcode
	SQL SELECT TABMAXKEY INTO :al_newid FROM _TABMAXKEY WITH ( UPDLOCK HOLDLOCK ) WHERE _TABMAXKEY.TABName =:as_tablename USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_newid = al_newid + 1
		SQL update dbo._tabmaxkey SET TABMAXKEY =:al_newid WHERE _TABMAXKEY.TABName =:as_tablename USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			ll_rtcode = this.it_transobject.sqlcode
		else
			ll_rtcode = this.it_transobject.sqlcode
			al_newid = 0
		end if
	else
		ll_rtcode = this.it_transobject.sqlcode
		al_newid = 0
	end if
	return ll_rtcode

// w_generate_studentfeesheet.wf_prepare_studentfeesheet() returns long
	long ll_rowcount
	long ll_counter
	long ll_servicecode
	long ll_studentcode
	long ll_classcode
	long ll_code
	long ll_studentfeesheetcode
	long ll_null
	long ll_insrow
	long ll_arraycount
	double ld_fee
	double ld_discperc
	double ld_flatdisc
	string ls_remarks
	string ls_studentname
	string ls_classname
	string ls_servicename
	boolean lb_ok = true
	string ls_date
	setnull(ll_null)
	ll_rowcount = this.dw_detail.rowcount()
	setpointer(hourglass!)
	for ll_counter = 1 to ll_rowcount
		if this.dw_detail.object.tuitionfee[ll_counter] = 0 then
			ll_servicecode = this.dw_detail.object.servicecode[ll_counter]
			if upperbound(this.istr_arg.ia_integerlist1) > 0 then
				ll_arraycount = 0
				for ll_arraycount = 1 to upperbound(this.istr_arg.ia_integerlist1)
					if this.istr_arg.ia_integerlist1[ll_arraycount] = ll_servicecode then
						this.dw_detail.object.fee[ll_counter] = this.istr_arg.da_doublelist[ll_arraycount]
					end if
				next
			end if
		end if
	next
	setpointer(arrow!)
	return 0

// w_generate_studentfeesheet.create() returns 0 [event]
	this.dw_feedetail = create dw_feedetail
	this.dw_feeheader = create dw_feeheader
	this.dw_footer = create dw_footer
	this.dw_master = create dw_master
	this.cb_retrieve = create cb_retrieve
	this.cb_ok = create cb_ok
	this.dw_detail = create dw_detail
	this.control = {this.dw_feedetail, this.dw_feeheader, this.dw_footer, this.dw_master, this.cb_retrieve, this.cb_ok, this.dw_detail}

// w_generate_studentfeesheet.destroy() returns 0 [event]
	destroy this.dw_feedetail
	destroy this.dw_feeheader
	destroy this.dw_footer
	destroy this.dw_master
	destroy this.cb_retrieve
	destroy this.cb_ok
	destroy this.dw_detail

// w_generate_studentfeesheet.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	this.it_transobject = create u_transaction
	SQL start USING this.it_transobject;
	this.istr_arg = message.powerobjectparm
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		this.width = ll_win_width * 0.98
		this.height = ll_win_height * 0.90
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	this.dw_detail.width = this.width * 0.98
	this.dw_detail.height = this.height - this.dw_master.height - 230
	this.cb_retrieve.y = this.height - 200
	this.cb_ok.y = this.height - 200
	this.dw_master.settransobject(this.it_transobject)
	this.dw_detail.settransobject(this.it_transobject)
	this.dw_footer.settransobject(this.it_transobject)
	this.dw_feeheader.settransobject(this.it_transobject)
	this.dw_feedetail.settransobject(this.it_transobject)
	this.dw_master.retrieve()
	this.dw_master.scrolltorow(0)
	this.dw_master.setfocus()
	this.dw_detail.retrieve(this.istr_arg.ia_integerlist, this.istr_arg.d_date1, this.istr_arg.ia_integerlist1, this.istr_arg.da_doublelist)
	wf_prepare_studentfeesheet()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_master.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// cb_retrieve.clicked() returns long [event]
	string ls_filter
	long ll_masterrow
	parent.dw_master.accepttext()
	ll_masterrow = parent.dw_master.getrow()
	parent.dw_detail.setredraw(false)
	parent.dw_detail.retrieve(parent.istr_arg.ia_integerlist, parent.istr_arg.d_date1, parent.istr_arg.ia_integerlist1, parent.istr_arg.da_doublelist)
	parent.wf_prepare_studentfeesheet()
	parent.dw_detail.setredraw(true)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	long ll_rowcount
	long ll_counter
	long ll_servicecode
	long ll_studentcode
	long ll_classcode
	long ll_code
	long ll_studentfeesheetcode
	long ll_null
	long ll_insrow
	long ll_arraycount
	double ld_fee
	double ld_discperc
	double ld_flatdisc
	string ls_remarks
	string ls_studentname
	string ls_classname
	string ls_servicename
	boolean lb_ok = true
	string ls_date
	setnull(ll_null)
	if parent.dw_master.accepttext() < 0 then
		return ::message.returnvalue
	end if
	if parent.dw_detail.accepttext() < 0 then
		return ::message.returnvalue
	end if
	ll_rowcount = parent.dw_detail.rowcount()
	setpointer(hourglass!)
	ll_code = parent.wf_setnewtabid("studentfeesheet", ll_studentfeesheetcode)
	if ll_code = 0 and ll_studentfeesheetcode > 0 then
		parent.dw_feeheader.reset()
		parent.dw_feedetail.reset()
		parent.dw_feeheader.insertrow(0)
		parent.dw_feeheader.object.code[1] = ll_studentfeesheetcode
		parent.dw_feeheader.object.date[1] = today()
		parent.dw_feeheader.object.usercode[1] = gl_usercode
		parent.dw_feeheader.object.remarks[1] = parent.dw_master.getitemstring(parent.dw_master.getrow(), "remarks")
		parent.dw_feeheader.object.posted[1] = "N"
		for ll_counter = 1 to ll_rowcount
			ll_insrow = parent.dw_feedetail.insertrow(0)
			if ll_insrow > 0 then
				parent.dw_feedetail.object.code[ll_insrow] = ll_studentfeesheetcode
				parent.dw_feedetail.object.classcode[ll_insrow] = parent.dw_detail.object.classcode[ll_counter]
				parent.dw_feedetail.object.studentcode[ll_insrow] = parent.dw_detail.object.studentcode[ll_counter]
				parent.dw_feedetail.object.servicecode[ll_insrow] = parent.dw_detail.object.servicecode[ll_counter]
				parent.dw_feedetail.object.fee[ll_insrow] = parent.dw_detail.object.fee[ll_counter]
				parent.dw_feedetail.object.flatdisc[ll_insrow] = parent.dw_detail.object.flatdiscount[ll_counter]
				parent.dw_feedetail.object.discperc[ll_insrow] = parent.dw_detail.object.discperc[ll_counter]
				parent.dw_feedetail.object.rollno[ll_insrow] = parent.dw_detail.object.rollno[ll_counter]
				parent.dw_feedetail.object.feepaiduptill[ll_insrow] = parent.dw_detail.object.feepaiduptill[ll_counter]
				parent.dw_feedetail.object.duedate[ll_insrow] = parent.dw_detail.object.duedate[ll_counter]
				parent.dw_feedetail.object.serviceinvcode[ll_insrow] = ll_null
				parent.dw_feedetail.object.servicetemplatecode[ll_insrow] = ll_null
			end if
		next
		if parent.dw_feedetail.rowcount() > 0 and parent.dw_feeheader.rowcount() > 0 then
			if parent.dw_feeheader.update(true, false) = 1 then
				if parent.dw_feedetail.update(true, false) = 1 then
					SQL commit USING parent.it_transobject;
					if parent.it_transobject.sqlcode = 0 then
						parent.post event ue_close()
					else
						messagebox("Student Fee Generation", "Some Problem Occurred while Generating Student Fee.~r~nDetails are:-~r~n" + parent.it_transobject.sqlerrtext)
					end if
				end if
			else
				messagebox("Database Connection Problem", "Some Database Connection Problem Occurred~r~nDetails are:-~r~n" + parent.it_transobject.sqlerrtext)
				return ::message.returnvalue
			end if
			return
		end if
	else
		SQL rollback USING parent.it_transobject;
	end if
	setpointer(arrow!)
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_detail.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	selecttext(1, len(gettext()))
	return ::message.returnvalue
