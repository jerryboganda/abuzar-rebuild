// menu m_studentcardmenu (studentcomponents)  ancestor: m_multi_entry

// m_studentcardmenu.create() returns 0 [event]
	m_studentcardmenu = this
	call super::create
	this.text = "m_studentcardmenu"

// m_studentcardmenu.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_populatestudentsclasswise = create m_populatestudentsclasswise
	this.item[upperbound(this.item) + 1] = this.m_populatestudentsclasswise

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_populatestudentsclasswise

// m_populatestudentsclasswise.create() returns 0 [event]
	call super::create
	this.text = "Populate Students Class Wise~tF5"
	this.shortcut = 116

// m_populatestudentsclasswise.destroy() returns 0 [event]
	call super::destroy

// m_populatestudentsclasswise.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_populate_students_classwise()
