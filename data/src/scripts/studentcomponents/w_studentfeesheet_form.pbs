// tab_main.selectionchanged(integer oldindex, integer newindex) returns long [event]
	if parent.il_protect = 0 and newindex = 1 then
		parent.id_header.setfocus()
		if parent.id_header.rowcount() = 0 then
			parent.wf_insert_row(parent.id_header, 0)
		end if
	end if
	return ::message.returnvalue

// tabpage_header.create() returns 0 [event]
	this.dw_header = create dw_header
	this.dw_detail = create dw_detail
	this.control = {this.dw_header, this.dw_detail}

// tabpage_header.destroy() returns 0 [event]
	destroy this.dw_header
	destroy this.dw_detail

// dw_header.ue_enterkey() returns long [event]
	send(handle(this), 256, 9, long(90))
	return 1

// dw_header.getfocus() returns long [event]
	setfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_detail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	long ll_col
	long ll_row
	string ls_column
	string ls_desc
	string ls_exp
	string ls_value
	string ls_tag
	string ls_name
	string ls_type
	string ls_band
	string s_str
	string s_t
	integer i_len
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	s_str = string(dwo.name)
	s_t = right(s_str, 2)
	if s_t = "_t" then
		i_len = len(s_str)
		s_str = left(s_str, i_len - 2)
		if this.s_previous <> s_str then
			this.b_flag = true
		end if
		if this.b_flag = true then
			setsort(s_str)
			sort()
			this.b_flag = false
		else
			setsort(s_str + " D")
			sort()
			this.b_flag = true
		end if
	end if
	this.s_previous = s_str
	ls_name = dwo.name
	ls_type = dwo.type
	ls_band = getbandatpointer()
	if upper(left(ls_band, 7)) = "DETAIL" then
		ll_row = row
	elseif pos(ls_band, "~t") > 0 then
		ll_row = long(mid(ls_band, pos(ls_band, "~t") + 1, len(ls_band)))
	end if
	if ll_row > 0 then
	end if
	ll_col = getclickedcolumn()
	if ll_col > 0 then
		setcolumn(ll_col)
		ls_desc = "#" + trim(string(ll_col)) + ".pointer"
	elseif upper(left(ls_type, 6)) = "COLUMN" and len(ls_name) > 0 then
		ls_column = ls_name
		setcolumn(ls_column)
		ls_desc = ls_column + ".pointer"
	end if
	ls_desc = describe(ls_desc)
	if ls_desc = "~"HyperLink!~"" then
		if ll_col > 0 then
			ls_exp = describe("#" + trim(string(ll_col)) + ".coltype")
			ls_tag = describe("#" + trim(string(ll_col)) + ".tag")
		else
			ls_exp = describe(ls_column + ".coltype")
			ls_tag = describe(ls_column + ".tag")
		end if
		if upper(left(ls_exp, 4)) = "CHAR" then
			if ll_col > 0 then
				ls_value = getitemstring(ll_row, ll_col)
			else
				ls_value = getitemstring(ll_row, ls_column)
			end if
			if pos(ls_value, "-") <= 0 then
				if ls_tag <> "" then
					ls_value = ls_tag + "-" + ls_value
				end if
			end if
			f_opentranaction(ls_value)
		elseif upper(left(ls_exp, 4)) = "LONG" or upper(left(ls_exp, 6)) = "NUMBER" then
			if ls_tag = "" or isnull(ls_tag) then
				ls_tag = ""
			end if
			if ls_tag = "" then
				ls_tag = ""
			else
				ls_tag = ls_tag + "-"
			end if
			if ll_col > 0 then
				ls_value = ls_tag + trim(string(getitemnumber(ll_row, ll_col)))
			else
				ls_value = ls_tag + trim(string(getitemnumber(ll_row, ls_column)))
			end if
			f_opentranaction(ls_value)
		end if
	end if
	return ::message.returnvalue
