// w_studentfeesheet_form.open() returns long [event]
	integer li_xpos
	integer li_ypos
	integer li_xendpos
	integer li_counter
	integer li_taborder
	integer li_visiblecolumns
	integer li_zerotaborder
	long ll_counter
	long li_retcode
	long li_rtncode
	boolean lb_active
	boolean lb_restricted
	boolean lb_customicode
	boolean lb_zerotabordercol
	date ld_date
	long ll_retcode
	this.istr_arg = message.powerobjectparm
	this.il_code = this.istr_arg.l_code1
	this.il_studentfeesheetcode = this.istr_arg.l_code2
	this.il_protect = this.istr_arg.l_code3
	this.it_transobject = create u_transaction
	if wf_connect() <> 0 then
		messagebox("Connection Failure!", "Unable to connect to the database", stopsign!)
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	wf_retrieve_tabs()
	wf_apply_protect_setting()
	wf_set_interface_adjustments()
	wf_set_tab_visibility()
	if f_stringpreferences("askdateintrans") = "N" and not wf_validatedate() then
		close(this)
	end if
	triggerevent("ue_postopen")
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_studentfeesheet_form.close() returns long [event]
	triggerevent("ue_close")
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.postevent("ue_close")
	return ::message.returnvalue

