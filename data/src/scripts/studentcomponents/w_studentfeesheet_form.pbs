// window w_studentfeesheet_form (studentcomponents)  ancestor: window

// w_studentfeesheet_form.ue_close() returns 0 [event]
	SQL stop USING this.it_transobject;
	close(this)

// w_studentfeesheet_form.ue_postopen() returns 0 [event]
	long ll_counter
	long ll_pos
	long ll_prow
	long ll_pcode
	integer li_rtncode
	setredraw(true)
	if f_stringpreferences("askdateintrans") = "Y" then
		this.id_header.object.date.protect = 0
		this.id_header.object.date.background.color = rgb(255, 255, 255)
		return
	end if
	this.id_header.settaborder("date", 0)
	this.id_header.object.date.protect = 1
	this.id_header.object.date.background.color = this.backcolor

// w_studentfeesheet_form.wf_set_interface_adjustments() returns 0
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width * 0.95
		ll_height = ll_win_height * 0.95
		this.width = ll_width
		this.height = ll_height
		this.cb_cancel.y = ll_height - this.cb_cancel.height - 200
		this.tab_main.width = ll_width - 100
		this.tab_main.height = this.cb_cancel.y - 50
		this.tab_main.tabpage_header.width = this.tab_main.width - 50
		this.tab_main.tabpage_header.height = this.tab_main.height - 100
		this.tab_main.tabpage_header.dw_header.width = this.tab_main.tabpage_header.width - 20
		this.tab_main.tabpage_header.dw_detail.width = this.tab_main.tabpage_header.width - 20
		this.tab_main.tabpage_header.dw_detail.height = this.tab_main.tabpage_header.height - this.tab_main.tabpage_header.dw_header.height - 100
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if

// w_studentfeesheet_form.wf_set_tab_visibility() returns long
	wf_select_first_tab()
	return 0

// w_studentfeesheet_form.wf_connect() returns long
	SQL start USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_studentfeesheet_form.wf_tabnewid(string as_tablename, long al_newid) returns long
	long ll_rtcode
	SQL SELECT TABMAXKEY INTO :al_newid FROM _TABMAXKEY WITH ( UPDLOCK HOLDLOCK ) WHERE _TABMAXKEY.TABName =:as_tablename USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_newid = al_newid + 1
		SQL update dbo._tabmaxkey SET TABMAXKEY =:al_newid WHERE _TABMAXKEY.TABName =:as_tablename USING this.it_transobject;
		if this.it_transobject.sqlcode < 0 then
			ll_rtcode = this.it_transobject.sqlcode
			al_newid = 0
		end if
	else
		ll_rtcode = this.it_transobject.sqlcode
		al_newid = 0
	end if
	return ll_rtcode

// w_studentfeesheet_form.wf_retrieve_tabs() returns long
	long ll_retrieve
	this.tab_main.tabpage_header.dw_header.settransobject(this.it_transobject)
	this.id_header = create datawindow
	this.id_header = this.tab_main.tabpage_header.dw_header
	this.id_header.settransobject(this.it_transobject)
	this.id_detail = create datawindow
	this.id_detail = this.tab_main.tabpage_header.dw_detail
	this.id_detail.settransobject(this.it_transobject)
	if this.il_code > 0 then
		this.id_header.retrieve(this.il_code)
		this.id_detail.retrieve(this.il_code)
		this.id_header.setfocus()
	end if
	return 0

// w_studentfeesheet_form.wf_insert_row(datawindow adw_dw, integer ai_askpermit) returns long
	long ll_row
	long ll_res = 2
	if ai_askpermit = 1 then
		ll_res = messagebox("Insert New Record", "Do you want to Insert New Record?", question!, yesnocancel!, 2)
	else
		ll_res = 1
	end if
	if ll_res = 1 then
		ll_row = adw_dw.insertrow(0)
		adw_dw.setrow(ll_row)
		adw_dw.scrolltorow(ll_row)
	end if
	return 0

// w_studentfeesheet_form.wf_delete_row(datawindow adw_dw, integer ai_askpermit) returns long
	long ll_row
	long ll_res = 2
	if adw_dw.rowcount() > 0 and adw_dw.getrow() > 0 then
		if ai_askpermit = 1 then
			ll_res = messagebox("Delete Record", "Do you want to delete this record?", question!, yesnocancel!, 2)
		else
			ll_res = 1
		end if
		if ll_res = 1 then
			ll_row = adw_dw.getrow()
			if adw_dw.deleterow(ll_row) = 1 and adw_dw.rowcount() > 0 then
				adw_dw.setrow(1)
				adw_dw.scrolltorow(1)
			end if
		end if
	end if
	return 0

// w_studentfeesheet_form.wf_goto_record(datawindow adw_dw) returns long
	long ll_current
	long ll_counter
	long ll_row
	datastore lds_ds
	s_arguements lstr_arg
	ll_current = adw_dw.getrow()
	if adw_dw.rowcount() > 0 then
		lds_ds = create datastore
		lds_ds.dataobject = "d_mr_recordpointer"
		lds_ds.settransobject(sqlca)
		for ll_counter = 1 to adw_dw.rowcount()
			ll_row = lds_ds.insertrow(0)
			if ll_row = ll_current then
				lds_ds.object.currentrow[ll_row] = 1
			else
				lds_ds.object.currentrow[ll_row] = 0
			end if
			lds_ds.object.rowid[ll_row] = adw_dw.object.rowid[ll_counter]
			lds_ds.object.rowno[ll_row] = ll_counter
			lds_ds.object.date[ll_row] = adw_dw.object.date[ll_counter]
		next
		if lds_ds.rowcount() > 0 then
			openwithparm(w_arg_mr_record_pointer, lds_ds)
			lstr_arg = message.powerobjectparm
			if lstr_arg.i_status = 1 and lstr_arg.l_code1 > 0 then
				adw_dw.setrow(lstr_arg.l_code1)
				adw_dw.scrolltorow(lstr_arg.l_code1)
			end if
		end if
	end if
	return 0

// w_studentfeesheet_form.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns integer
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next
	return 0

// w_studentfeesheet_form.wf_apply_protect_setting() returns integer
	if this.il_protect = 1 then
		wf_protectdw(this.id_header, this.il_protect)
		wf_protectdw(this.id_detail, this.il_protect)
	end if
	return 0

// w_studentfeesheet_form.wf_save() returns long
	if this.il_protect <> 0 then
		if this.ib_print then
		end if
	end if
	return 0

// w_studentfeesheet_form.wf_print() returns long
	if this.il_protect = 0 then
		wf_save()
	end if
	return 0

// w_studentfeesheet_form.wf_select_first_tab() returns long
	if this.tab_main.tabpage_header.visible then
		this.tab_main.selecttab(1)
		return 0
	end if
	return 0

// w_studentfeesheet_form.wf_show_patient_gallery() returns long
	if this.il_code > 0 then
		openwithparm(w_patientgallary, this.il_code)
	end if
	return 0

// w_studentfeesheet_form.wf_validateserverdatetime(datetime ar_server_datetime, string ar_errtext) returns boolean
	datetime ldt_last_transdate
	datetime ldt_current_serverdate
	long li_max_allow_days
	ar_errtext = "Invoice Date  Check violates"
	li_max_allow_days = f_numberpreferences("MaxAllowDate")
	if isnull(li_max_allow_days) then
		li_max_allow_days = 4
	end if
	SQL SELECT LastTransDate INTO :ldt_last_transdate FROM ServerDate USING sqlca;
	if sqlca.sqlcode = 0 then
		sqlca.getdatetime(ldt_current_serverdate)
		if sqlca.sqlcode = 0 then
			if ldt_current_serverdate >= ldt_last_transdate and daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) <= li_max_allow_days then
				ar_server_datetime = ldt_current_serverdate
				return true
			elseif ldt_current_serverdate < ldt_last_transdate then
				ar_errtext = "Back Date Invoice Check violates"
				return false
			elseif daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) > li_max_allow_days then
				ar_errtext = "Forward Date Invoice Check violates"
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_studentfeesheet_form.wf_print_dischargeslip() returns integer
	return 0

// w_studentfeesheet_form.wf_findcustcode(long ai_custcode, string as_aliasname) returns long
	integer li_custcode
	integer ll_retflag
	string ls_itemname
	SQL SELECT accounts.acccode INTO :li_custcode FROM accounts , customer WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =customer.custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_custcode = li_custcode
		if isnull(ai_custcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

