// w_studentfeesheet_form.wf_getserverdatetime(datetime ar_server_datetime, string ar_errtext) returns boolean
	datetime ldt_last_transdate
	datetime ldt_current_serverdate
	integer li_max_allow_days
	string ls_hold_serverdate
	date ld_datepart
	time lt_timepart
	ar_errtext = "Please verify Server DateTime"
	li_max_allow_days = f_numberpreferences("MaxAllowDate")
	if isnull(li_max_allow_days) then
		li_max_allow_days = 4
	end if
	SQL rollback USING sqlca;
	SQL SELECT LastTransDate INTO :ldt_last_transdate FROM ServerDate USING sqlca;
	if sqlca.sqlcode = 0 then
		sqlca.getdatetime(ldt_current_serverdate)
		ar_server_datetime = ldt_current_serverdate
		if sqlca.sqlcode = 0 then
			if ldt_current_serverdate >= ldt_last_transdate and daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) <= li_max_allow_days then
				ld_datepart = date(string(ldt_current_serverdate, "yyyy-mm-dd"))
				lt_timepart = time(string(ldt_current_serverdate, "hh:mm:ss"))
				ldt_current_serverdate = datetime(ld_datepart, lt_timepart)
				SQL update ServerDate SET LastTransDate =:ldt_current_serverdate USING sqlca;
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					ar_server_datetime = ldt_current_serverdate
					return true
				else
					SQL rollback USING sqlca;
					return false
				end if
			elseif ldt_current_serverdate < ldt_last_transdate then
				ar_errtext = "Back Date Invoice Check violates"
				return false
			elseif daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) > li_max_allow_days then
				ar_errtext = "Forward Date Invoice Check violates"
				return false
			end if
		else
			SQL rollback USING sqlca;
			ar_server_datetime = datetime(date(today()), time(today()))
			return false
		end if
		return
	end if
	SQL rollback USING sqlca;
	ar_server_datetime = datetime(date(today()), time(today()))
	return false

// w_studentfeesheet_form.wf_findpatientcode(string as_regno, long al_patientcode) returns long
	long ll_patientcode
	long ll_retflag
	string ls_itemname
	SQL SELECT patient.patientcode INTO :ll_patientcode FROM patient WHERE patient.regno =:as_regno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_patientcode = ll_patientcode
		if isnull(al_patientcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_studentfeesheet_form.wf_findfullcode(string as_fullcode, long al_icode, string as_itemname) returns long
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		as_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_studentfeesheet_form.wf_validateinvoice(long al_invcode) returns long
	long ll_retcode
	long ll_acccode
	long ll_counter
	string ls_aliasname
	double ld_invtotal
	double ld_outstandingamt
	double ld_whperc
	SQL SELECT AliasName =( SELECT A.AliasName FROM Accounts A WHERE A.AccCode =H.SuppCode ) , AccCode =H.SuppCode , WHPerc =ISNULL ( ( SELECT S.WHPerc FROM Supplier S WHERE S.SuppCode =H.SuppCode ) , 0 ) , H.InvTotal , H.OutStandingAmt INTO :ls_aliasname, :ll_acccode, :ld_whperc, :ld_invtotal, :ld_outstandingamt FROM PurLedger H WHERE H.PurInvCode =:al_invcode AND H.Posted ='Y' AND H.AccountFor ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_header.object.purinvcode[1] = al_invcode
		this.id_header.object.netamt[1] = ld_invtotal
		this.id_header.object.outstandingamt[1] = ld_outstandingamt
		this.id_header.object.aliasname[1] = ls_aliasname
		this.id_header.object.acccode[1] = ll_acccode
		this.id_header.object.whtaxbaseamt[1] = ld_outstandingamt
		this.id_header.object.whtaxperc[1] = ld_whperc
		this.id_header.object.whtaxamt[1] = round(ld_outstandingamt * ld_whperc * 0.01, 2)
		this.id_header.object.paymentamt[1] = round(ld_outstandingamt - round(ld_outstandingamt * ld_whperc * 0.01, 2), 2)
	end if
	return ll_retcode

// w_studentfeesheet_form.wf_set_deductionamt(integer ai_deduction, integer ai_perc_or_base, double ad_data) returns long
	if ai_perc_or_base = 1 then
		if ai_deduction = 1 then
			this.id_header.object.whtaxamt[1] = round(ad_data * this.id_header.object.whtaxbaseamt[1] / 100, 0)
			this.id_header.object.paymentamt[1] = this.id_header.object.outstandingamt[1] - round(ad_data * this.id_header.object.whtaxbaseamt[1] / 100, 0)
		end if
	elseif ai_deduction = 1 then
		this.id_header.object.whtaxamt[1] = round(ad_data * this.id_header.object.whtaxperc[1] / 100, 0)
		this.id_header.object.paymentamt[1] = round(this.id_header.object.outstandingamt[1] - round(ad_data * this.id_header.object.whtaxperc[1] / 100, 0), 0)
	end if
	return 0

// w_studentfeesheet_form.wf_lockinvoice(long al_invcode) returns long
	integer li_count
	this.it_transobject.dbparm = " Async =1, DBGetTime = 20"
	this.it_transobject.lockpurinvoice(al_invcode)
	this.it_transobject.dbparm = "Async =0, DBGetTime = 0"
	return this.it_transobject.sqlcode

// w_studentfeesheet_form.wf_populatedetail(long al_invid, string as_errortext) returns boolean
	long ll_detailrows
	long ll_errrowid
	long ll_usercode = 1
	long ll_invcode
	long ll_counter
	long ll_masterrow
	long ll_row
	long ll_acccode
	long ll_patientcode
	long ll_guestcode
	long ll_studentcode
	long ll_null
	long ll_unpostedtrans
	double ld_amt
	double ld_balance
	double ld_newbalance
	double ld_totalamt
	double ld_debit
	double ld_credit
	double ld_invbalance
	double ld_foreignamt
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	boolean lb_commitflag = true
	string ls_remarks
	string ls_chkno
	string ls_msg
	ls_msg = space(1000)
	setnull(ll_null)
	ll_counter = 1
	ls_msg = "000                                                                                                                                 "
	as_errortext = "    Some database problem ocuurs         "
	ll_masterrow = this.id_header.rowcount()
	if ll_masterrow > 0 then
		ll_invcode = this.id_header.object.purinvcode[ll_masterrow]
	end if
	if wf_lockinvoice(ll_invcode) = 0 and ll_masterrow > 0 then
		ls_msg = "000                                                                                                                                 "
		this.it_transobject.checkunpostedpurinvintransactions(ll_invcode, al_invid, "PP", ll_unpostedtrans, ls_msg)
		if ll_unpostedtrans > 0 then
			lb_commitflag = false
			as_errortext = "Unposted Transaction(s) Exist for this Invoice~r~n~r~n" + ls_msg
		else
			this.it_transobject.getpurinvbalance(ll_invcode, ld_invbalance)
			if this.it_transobject.sqlcode = 0 then
				ld_amt = this.id_header.object.paymentamt[ll_masterrow]
				if this.id_header.object.whtaxamt[ll_masterrow] > 0 then
					ld_amt = ld_amt + this.id_header.object.whtaxamt[ll_masterrow]
				end if
				if ld_amt <> 0.0 and lb_commitflag then
					ld_newbalance = ld_invbalance - ld_amt
					if ld_newbalance >= 0.0 then
						this.it_transobject.updatepurinvbalance(ll_invcode, ld_newbalance)
						if this.it_transobject.sqlcode <> 0 then
							lb_commitflag = false
							as_errortext = "Purchase Invoice Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
						end if
					else
						lb_commitflag = false
						as_errortext = "Purchase Invoice Balance Updation Error:~r~n" + this.it_transobject.sqlerrtext
					end if
				else
					lb_commitflag = false
					as_errortext = "Not Enough Balance On Purchase Invoice"
				end if
			else
				lb_commitflag = false
				as_errortext = "Purchase Invoice Balance Retrieval Error:~r~n" + this.it_transobject.sqlerrtext
			end if
		end if
	else
		lb_commitflag = false
		as_errortext = "Invoice Is Used by some other user"
	end if
	return lb_commitflag

// w_studentfeesheet_form.wf_validatedate() returns boolean
