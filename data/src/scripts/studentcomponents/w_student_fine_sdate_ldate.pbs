// window w_student_fine_sdate_ldate (studentcomponents)  ancestor: window

// w_student_fine_sdate_ldate.ue_keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		post event ue_close()
	end if
	return ::message.returnvalue

// w_student_fine_sdate_ldate.ue_close() returns 0
	closewithreturn(this, this.istr_arg)

// w_student_fine_sdate_ldate.create() returns 0
	this.cb_cancel = create cb_cancel
	this.dw_master = create dw_master
	this.cb_retrieve = create cb_retrieve
	this.cb_ok = create cb_ok
	this.dw_detail = create dw_detail
	this.dw_footer = create dw_footer
	this.control = {this.cb_cancel, this.dw_master, this.cb_retrieve, this.cb_ok, this.dw_detail, this.dw_footer}

// w_student_fine_sdate_ldate.destroy() returns 0
	destroy this.cb_cancel
	destroy this.dw_master
	destroy this.cb_retrieve
	destroy this.cb_ok
	destroy this.dw_detail
	destroy this.dw_footer

// w_student_fine_sdate_ldate.open() returns long
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	string ls_date
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		this.width = ll_win_width * 0.98
		this.height = ll_win_height * 0.90
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	this.dw_detail.width = this.width * 0.98
	this.dw_detail.height = this.height - this.dw_master.height - 250
	this.cb_retrieve.y = this.height - 200
	this.cb_ok.y = this.height - 200
	this.cb_cancel.y = this.height - 200
	this.dw_master.settransobject(sqlca)
	this.dw_detail.settransobject(sqlca)
	this.dw_footer.settransobject(sqlca)
	this.dw_master.insertrow(0)
	this.dw_master.scrolltorow(0)
	ls_date = string(date(this.dw_master.getitemdatetime(this.dw_master.getrow(), "startdate")), "mm/dd/yyyy")
	this.dw_master.setitem(this.dw_master.getrow(), "startdate", datetime(date(ls_date), time(" 00:00:00")))
	this.dw_master.setitem(this.dw_master.getrow(), "enddate", datetime(date(ls_date), time(" 23:59:59")))
	this.dw_master.setcolumn("startdate")
	this.dw_master.setfocus()
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.istr_arg.i_status = -1
	parent.post event ue_close()
	return ::message.returnvalue

// dw_master.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// cb_retrieve.clicked() returns long
	string ls_filter
	char lc_excludepartialpaidinvoices
	datetime ldt_stardate
	datetime ldt_enddate
	long ll_masterrow
	long ll_serviceinvtypecode
	double ld_null
	double ld_fineamt
	setnull(ld_null)
	if parent.dw_master.accepttext() < 1 then
		return ::message.returnvalue
	end if
	ll_masterrow = parent.dw_master.getrow()
	if ll_masterrow > 0 then
		if isnull(parent.dw_master.getitemnumber(ll_masterrow, "fineamt")) then
			ld_fineamt = ld_null
		else
			ld_fineamt = parent.dw_master.getitemnumber(ll_masterrow, "fineamt")
		end if
		ldt_stardate = parent.dw_master.getitemdatetime(ll_masterrow, "startdate")
		ldt_enddate = parent.dw_master.getitemdatetime(ll_masterrow, "enddate")
		ll_serviceinvtypecode = parent.dw_master.getitemnumber(ll_masterrow, "serviceinvtypecode")
		lc_excludepartialpaidinvoices = parent.dw_master.getitemstring(ll_masterrow, "excludepartialpaidinvoices")
	else
		ld_fineamt = ld_null
	end if
	if ldt_stardate <= ldt_enddate and ll_serviceinvtypecode > 0 and ld_fineamt >= 0.0 then
		parent.dw_detail.retrieve(ld_fineamt, ldt_stardate, ldt_enddate, ll_serviceinvtypecode, lc_excludepartialpaidinvoices)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	date ld_date
	char lc_excludepartialpaidinvoices
	time lt_time
	string ls_errtext
	datetime ldt_datetime
	long ll_serviceinvtypecode
	if parent.dw_master.accepttext() < 1 then
		return ::message.returnvalue
	end if
	if parent.dw_master.rowcount() = 0 then
		return ::message.returnvalue
	end if
	ldt_datetime = datetime(string(today(), "yyyy-mm-dd hh:mm"))
	ld_date = date(ldt_datetime)
	lt_time = time(ldt_datetime)
	ll_serviceinvtypecode = parent.dw_master.getitemnumber(parent.dw_master.getrow(), "serviceinvtypecode")
	lc_excludepartialpaidinvoices = parent.dw_master.getitemstring(parent.dw_master.getrow(), "excludepartialpaidinvoices")
	if parent.dw_master.getitemnumber(parent.dw_master.getrow(), "fineamt") < 0.0 then
		messagebox("Student Fine", "Please Enter Valid Student Fine Amount", stopsign!)
		return ::message.returnvalue
	end if
	parent.istr_arg.db_code1 = parent.dw_master.getitemnumber(parent.dw_master.getrow(), "fineamt")
	parent.istr_arg.d_sdate = parent.dw_master.object.startdate[1]
	parent.istr_arg.d_edate = parent.dw_master.object.enddate[1]
	parent.istr_arg.s_name1 = lc_excludepartialpaidinvoices
	if parent.istr_arg.db_code1 >= 0.0 and parent.istr_arg.d_sdate <= parent.istr_arg.d_edate then
		SQL rollback USING sqlca;
		sqlca.apply_studentfine_on_unpaidinvoices(parent.istr_arg.db_code1, parent.istr_arg.d_sdate, parent.istr_arg.d_edate, ll_serviceinvtypecode, left(parent.istr_arg.s_name1, 1))
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
			messagebox("Student Fine", "Student Fine Allocated Successfully", information!)
			parent.post event ue_close()
		else
			ls_errtext = sqlca.sqlerrtext
			SQL rollback USING sqlca;
			messagebox("Student Fine", "Student Fine not Allocated Successfully.~r~nReasons are:-~r~n" + ls_errtext, stopsign!)
		end if
	end if
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
