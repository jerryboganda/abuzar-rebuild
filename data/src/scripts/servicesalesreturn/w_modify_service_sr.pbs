// window w_modify_service_sr (servicesalesreturn)  ancestor: w_single_entry

// w_modify_service_sr.wf_replace_custref() returns 0
	integer li_refno
	long ll_counter
	li_refno = message.doubleparm
	if li_refno > 0 and this.id_detail.rowcount() > 0 then
		for ll_counter = 1 to this.id_detail.rowcount()
			choose case li_refno
			case 1
				this.id_detail.setitem(ll_counter, "Ref1", string(this.id_detail.getitemnumber(ll_counter, "serviceinvcode")))
			case 2
				this.id_detail.setitem(ll_counter, "Ref2", string(this.id_detail.getitemnumber(ll_counter, "serviceinvcode")))
			end choose
		next
	end if

// w_modify_service_sr.ue_newform() returns 0
	long ll_found
	setredraw(false)
	this.i_editmode = 1
	this.i_retrievemode = 2
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_new.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_file.m_first.enabled = false
	this.im_menu.m_file.m_next.enabled = false
	this.im_menu.m_file.m_previous.enabled = false
	this.im_menu.m_file.m_last.enabled = false
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_retrieve.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.tab_retrieve.tabpage_detail.enabled = true
	this.id_detail.retrieve(this.istr_arg.l_code1, this.istr_arg.l_code2, this.istr_arg.d_sdate, this.istr_arg.d_edate)
	if this.id_detail.rowcount() > 0 then
		this.id_detail.setcolumn(1)
		this.id_detail.setfocus()
	end if
	setredraw(true)

// w_modify_service_sr.create() returns 0
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_multi_entry" then
		this.menuid = create m_multi_entry
	end if

// w_modify_service_sr.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_modify_service_sr.activate() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// w_modify_service_sr.ue_save() returns 0
	long ll_primarykey
	long ll_row
	setpointer(hourglass!)
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if this.id_detail.update() > 0 then
		SQL commit USING sqlca;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		this.ib_commitok = true
		this.im_menu.m_file.m_new.enabled = true
		this.editflag = false
	else
		SQL rollback USING sqlca;
		setpointer(arrow!)
		messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs", exclamation!, ok!, 1)
		return
	end if
	setpointer(arrow!)

// w_modify_service_sr.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.tab_retrieve.tabpage_list.enabled = false
	this.istr_arg = message.powerobjectparm
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue
