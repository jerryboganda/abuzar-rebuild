// w_servicereturn.wf_get_studentinfo(long row, string data) returns long
	long ll_code
	long ll_counter
	long ll_studentcode
	string ls_null
	setnull(ls_null)
	ll_code = long(data)
	if not isnull(data) then
		if wf_setstudentinfo(ll_code) = 0 then
			messagebox("Database Error", "Student information can not be retrieved")
			return 1
		end if
	elseif isnull(data) then
		this.id_master.object.custcode.protect = 0
		this.id_master.object.aliasname.protect = 0
		this.id_master.setitem(1, "custcode", 22)
		this.id_master.setitem(1, "aliasname", "")
	elseif data = "0" then
		messagebox("Database Error", "Student information can not be retrieved")
		return 1
	end if
	if this.id_master.accepttext() = -1 then
		return 1
	end if
	setredraw(true)
	return 0

// w_servicereturn.wf_set_headersetting() returns long
	integer li_rtncode
	long ll_counter
	long ll_found
	datastore lds_headers
	datawindowchild ldc_headerno
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		return li_rtncode
	end if
	if lds_headers.rowcount() > 0 then
		this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
		this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
		this.id_master.getchild("headerno", ldc_headerno)
		for ll_counter = 1 to lds_headers.rowcount()
			ldc_headerno.insertrow(0)
			ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
			ll_found = 0
			ll_found = gds_reoprtheaderinfo.find("headerno=" + string(lds_headers.getitemnumber(ll_counter, "headercode")), 1, gds_reoprtheaderinfo.rowcount())
			if ll_found > 0 then
				ldc_headerno.setitem(ll_counter, "name", gds_reoprtheaderinfo.getitemstring(ll_found, "clientname"))
				if isnull(gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks")) then
					ldc_headerno.setitem(ll_counter, "headeralias", trim(string(gds_reoprtheaderinfo.getitemnumber(ll_found, "headerno"))))
				else
					ldc_headerno.setitem(ll_counter, "headeralias", trim(gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks")) + " (" + trim(string(gds_reoprtheaderinfo.getitemnumber(ll_found, "headerno"))) + ")")
				end if
			end if
		next
	end if
	return 1

// w_servicereturn.wf_set_motorvehicleinfo(long al_code) returns long
	long ll_custcode
	long ll_retcode
	string ls_chasisno
	string ls_aliasname
	SQL SELECT MotorVehicle.ChasisNo , MotorVehicle.CustCode , Accounts.AliasName INTO :ls_chasisno, :ll_custcode, :ls_aliasname FROM MotorVehicle , Accounts WHERE MotorVehicle.MotorVehicleCode =:al_code AND MotorVehicle.CustCode =Accounts.AccCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.setitem(this.id_master.rowcount(), "chasisno", ls_chasisno)
		this.id_master.setitem(this.id_master.rowcount(), "custcode", ll_custcode)
		this.id_master.setitem(this.id_master.rowcount(), "aliasname", ls_aliasname)
		this.id_master.object.custcode.protect = 1
		this.id_master.object.aliasname.protect = 1
		ll_retcode = 1
	else
		messagebox("Motor Vehicle Information", "Problem in retrieving corresponding customer")
		ll_retcode = 0
	end if
	return ll_retcode

// w_servicereturn.wf_find_motorvehiclecode(string as_chasisno, long al_code) returns long
	long ll_motorvehiclecode
	long ll_retflag
	ll_retflag = 0
	SQL SELECT motorvehiclecode INTO :ll_motorvehiclecode FROM motorvehicle WHERE chasisno =:as_chasisno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_code = ll_motorvehiclecode
		if isnull(al_code) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_servicereturn.wf_motorvehicle_retrieve() returns long
	long ll_row
	long ll_code
	this.idc_motorvehicle.settransobject(this.it_transobject)
	this.idc_motorvehicle.retrieve()
	ll_row = this.idc_motorvehicle.insertrow(0)
	setnull(ll_code)
	this.idc_motorvehicle.setitem(ll_row, "code", ll_code)
	this.idc_motorvehicle.setitem(ll_row, "chasisno", "<NONE>")
	this.idc_motorvehicle.setitem(ll_row, "motorvehicle", "<NONE>")
	this.idc_motorvehicle.setitem(ll_row, "customer", "<NONE>")
	this.idc_motorvehicle.scrolltorow(ll_row)
	return 0

// w_servicereturn.wf_motorvehiclesearch() returns string
	string ls_chasisno
	long ll_res
	long ll_null
	long ll_code
	s_arguements ls_arguements
	setnull(ll_null)
	open(w_vehiclesearch)
	ls_arguements = message.powerobjectparm
	if ls_arguements.i_status = 1 then
		openwithparm(w_vehiclesearchresult, ls_arguements)
		ls_arguements = message.powerobjectparm
		if ls_arguements.i_status = 1 and ls_arguements.l_code1 > 0 then
			this.id_master.object.chasisno[1] = ls_arguements.s_name1
			this.id_master.object.motorvehiclecode[1] = ls_arguements.l_code1
			this.id_master.object.custcode[1] = ls_arguements.l_code2
			ll_code = ls_arguements.l_code1
			wf_set_motorvehicleinfo(ll_code)
			ls_chasisno = this.id_master.object.chasisno[1]
		end if
	end if
	return ls_chasisno

// w_servicereturn.wf_link_to_cashiershift() returns long
	long ll_cashiershiftcode
	if f_stringpreferences("CashierShift") = "Y" then
		this.id_master.object.cashiershiftcode.visible = true
		SQL SELECT MAX ( A.CashierShiftCode ) INTO :ll_cashiershiftcode FROM ( SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND ShiftOwner =:gl_usercode UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShiftUsers WHERE UserCode =:gl_usercode AND CashierShiftCode IN ( SELECT MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' ) ) A USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if ll_cashiershiftcode < 0 then
				ll_cashiershiftcode = -1
			end if
		else
			ll_cashiershiftcode = -1
		end if
	else
		ll_cashiershiftcode = -1
	end if
	if ll_cashiershiftcode = -1 then
		setnull(ll_cashiershiftcode)
	end if
	this.id_master.object.cashiershiftcode[1] = ll_cashiershiftcode
	return 0

// w_servicereturn.wf_check_cashiershift_on_saving(long al_cashiershiftcode, long al_usercode) returns long
	long ll_cashiershiftcode
	long ll_cashacccode
	if f_stringpreferences("CashierShift") = "Y" then
		this.id_master.object.cashiershiftcode.visible = true
		SQL SELECT MAX ( A.CashierShiftCode ) INTO :ll_cashiershiftcode FROM ( SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND ShiftOwner =:al_usercode AND CashierShiftCode =:al_cashiershiftcode UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShiftUsers WHERE UserCode =:al_usercode AND CashierShiftCode IN ( SELECT MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND CashierShiftCode =:al_cashiershiftcode ) UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND ShiftOwner =:al_usercode UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShiftUsers WHERE UserCode =:al_usercode AND CashierShiftCode IN ( SELECT MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' ) ) A USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if ll_cashiershiftcode < 0 then
				ll_cashiershiftcode = -1
			end if
		else
			ll_cashiershiftcode = -1
		end if
	else
		ll_cashiershiftcode = -1
	end if
	if ll_cashiershiftcode = -1 then
		setnull(ll_cashiershiftcode)
	end if
	this.id_master.object.cashiershiftcode[1] = ll_cashiershiftcode
	if ll_cashiershiftcode > 0 then
		SQL SELECT CashAccCode INTO :ll_cashacccode FROM CashierShift WHERE CashierShiftCode =:ll_cashiershiftcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.id_master.object.cashacccode[1] = ll_cashacccode
		end if
	end if
	if f_stringpreferences("CashierShift") = "Y" and isnull(ll_cashiershiftcode) then
		messagebox("Cashier Shift Linkage Missing", "Cashier Shift Linkage Missing~r~nContact System Administrator and try again.", stopsign!)
		return -1
	end if
	return 0

// w_servicereturn.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_servicereturnmenu" then
		this.menuid = create m_servicereturnmenu
	end if
	this.dw_print = create dw_print
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print

// w_servicereturn.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_print

// w_servicereturn.ue_save() returns 0 [event]
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_salesmancode
	long ll_rowcount
	long ll_servicecode
	long ll_serviceinvcode
	long ll_custcode
	long ll_gcode
	long ll_qty
	long ll_stock
	long ll_newstock
	long ll_counter
	long ll_saveresult
	long ll_null
	long ll_headerinvno
	long ll_headerno
	boolean lb_commitflag
	boolean lb_continue
	integer li_errcode
	integer li_pos
	datetime ld_expiry
	string ls_errtext
	string ls_batch
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_avgprice
	datetime ldt_server_datetime
	string ls_date_errtext
	setnull(ll_null)
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	wf_grandtotal()
	if this.id_detail.rowcount() <= 0 then
		return
	end if
	ll_serviceinvcode = this.id_master.object.serviceinvcode[1]
	if (isnull(ll_serviceinvcode) or trim(string(ll_serviceinvcode)) = "") and isnull(this.id_master.object.custcode[1]) then
		if this.ii_servicerettype = 13 then
			ll_custcode = 19
		else
			ll_custcode = 22
		end if
		wf_customerinfo(ll_custcode)
		wf_customername(ll_custcode)
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	wf_setguestcheckin()
	if wf_set_cashaccount() = 0 then
		return
	end if
	if f_stringpreferences("ServiceSalesManWindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	wf_grandtotal()
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	if wf_check_return_vs_outstandingamt() < 0 then
		return
	end if
	if ll_salesmancode > 0 then
		if wf_check_cashiershift_on_saving(this.id_master.object.cashiershiftcode[1], ll_salesmancode) < 0 then
			return
		end if
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_rowcount = this.id_detail.rowcount()
		if wf_validate_price_discount_matters(ll_salesmancode) < 0 then
			return
		end if
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if wf_show_mastercashierwindow() = 0 then
			return
		end if
		if isnull(ll_invid) then
			wf_tabnewid("ServiceRHeader", ll_invid)
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
				this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
			end if
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
		else
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		end if
		if f_stringpreferences("Headeronsaleinv") = "N" then
			this.id_master.setitem(ll_mastercurrrow, "Headerno", f_numberpreferences("headerno"))
		end if
		ll_headerno = this.id_master.getitemnumber(ll_mastercurrrow, "headerno")
		ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
		if isnull(ll_headerinvno) then
			f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
			if ll_headerinvno > 0 then
				this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
			end if
		end if
		ld_misccharges = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges")
		ld_invdiscperc = this.id_footer.getitemnumber(ll_footercurrrow, "discperc")
		ld_flatdisc = this.id_footer.getitemnumber(ll_footercurrrow, "flatdisc")
		ll_serviceinvcode = this.id_master.getitemnumber(1, "serviceinvcode")
		this.id_master.setitem(ll_mastercurrrow, "discperc", ld_invdiscperc)
		this.id_master.setitem(ll_mastercurrrow, "flatdisc", ld_flatdisc)
		this.id_master.setitem(ll_mastercurrrow, "misccharges", ld_misccharges)
		this.id_master.setitem(ll_mastercurrrow, "postedby", ll_salesmancode)
		this.id_master.setitem(ll_mastercurrrow, "invtotal", wf_grandtotal())
		if this.ii_servicerettype <> 14 then
			if f_stringpreferences("askmastercashwin_in_cashsvcret") = "N" then
				this.id_master.object.cashtendered[ll_mastercurrrow] = wf_grandtotal()
				this.id_master.object.cashcharged[ll_mastercurrrow] = wf_grandtotal()
				this.id_master.object.cashback[ll_mastercurrrow] = 0
				this.id_master.setitem(ll_mastercurrrow, "outstandingamt", 0.00)
				this.id_master.accepttext()
			elseif not (this.id_master.object.cashcharged[ll_mastercurrrow] = wf_grandtotal() and this.ids_cashwin.rowcount() = 0) then
				this.id_master.setitem(1, "servicercatcode", 14)
				this.id_master.accepttext()
			end if
		elseif f_stringpreferences("askmastercashwin_in_crsvcret") = "N" then
			this.id_master.setitem(ll_mastercurrrow, "outstandingamt", wf_grandtotal())
		end if
		do while ll_counter <= ll_rowcount and li_errcode = 0
			this.id_detail.setitem(ll_counter, "code", ll_invid)
			ll_servicecode = this.id_detail.getitemnumber(ll_counter, "servicecode")
			ll_counter = ll_counter + 1
		loop
		if lb_continue then
			ll_saveresult = event ue_save_withnocommit()
			if ll_saveresult = 0 then
				if wf_update_mastercashierwindow(ll_invid, this.is_doctype) = 0 then
					SQL commit USING this.it_transobject;
					messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
					this.ib_commitok = true
					this.id_master.resetupdate()
					this.im_menu.m_file.m_new.enabled = true
					this.editflag = false
					if gd_recenttransdate < this.id_systemdate then
						gd_recenttransdate = this.id_systemdate
					end if
				else
					messagebox("Saving Problem", "Changes Not Saved in database for Master Cashier Window transactions.", stopsign!, ok!, 1)
				end if
			else
				messagebox("Saving Problem", "Changes Not Saved in database while saving service record.", stopsign!, ok!, 1)
			end if
			if this.ib_commitok then
				this.ib_modify = false
			else
				lb_continue = false
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			messagebox("Updation Error", ls_errtext + " in current row", stopsign!)
			if this.ib_modify = false then
				this.id_master.setitem(1, "Code", ll_null)
				this.id_master.accepttext()
			end if
		else
			wf_allocate_servicereturn(ll_invid, ll_serviceinvcode, ldt_server_datetime, ll_salesmancode)
			if f_stringpreferences("IncSvcSRInActMonitor") = "Y" then
				this.it_transobject.updateactivitymonitor("RR", ll_invid)
				if this.it_transobject.sqlcode <> 0 then
					SQL rollback USING this.it_transobject;
					messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
				else
					SQL commit USING this.it_transobject;
				end if
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_servicereturn.ue_newform() returns 0 [event]
	integer rtncode
	long li_fetched_code
	long row
	long ll_manfcode
	long ll_null
	call super::ue_newform
	setnull(ll_null)
	wf_update_virtualgl()
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_print.enabled = true
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	wf_assign_master_cash_win_object()
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.ib_modify = false
	if not this.ib_openservicereturn then
		this.idc_itemdddw.retrieve(ll_null)
	end if
	if this.ii_servicerettype = 13 then
		this.id_master.object.custcode[1] = this.il_code
	end if
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	setredraw(true)
	if not wf_validatedate() then
		close(this)
	end if
	wf_link_to_cashiershift()

// w_servicereturn.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect
	long ll_row
	long ll_code
	boolean lb_flag
	call super::ue_detail
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	if this.id_master.rowcount() > 0 then
		ll_code = this.id_master.getitemnumber(1, "code")
	end if
	this.id_footer.retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	if not this.ib_openservicereturn then
		this.idc_itemdddw.settransobject(this.it_transobject)
		li_rtncode = this.idc_itemdddw.retrieve(this.id_master.getitemnumber(1, "serviceinvcode"))
	end if
	if this.id_master.object.code[this.id_master.rowcount()] > 0 then
		this.ids_cashwin.retrieve(this.id_master.object.code[1], this.is_doctype)
	else
		wf_assign_master_cash_win_object()
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if not this.ib_openservicereturn then
	end if
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_grandtotal()
	setredraw(true)

// w_servicereturn.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.settransobject(this.it_transobject)
	if this.ib_openservicereturn then
		if f_stringpreferences("itemcode") = "N" then
			this.id_detail.setcolumn(this.is_columnitemname)
		else
			this.id_detail.setcolumn("fullcode")
		end if
	else
		if f_stringpreferences("itemcode") = "N" then
			this.id_detail.setcolumn(this.is_columnitemname)
		else
			this.id_detail.setcolumn("fullcode")
		end if
		this.id_detail.setcolumn(this.is_columnitemname)
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		if f_stringpreferences("itemcode") = "N" then
			this.id_detail.setcolumn(this.is_columnitemname)
			this.ib_focusdetail = true
		else
			this.id_detail.setcolumn("fullcode")
			this.ib_focusdetail = true
		end if
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true
	this.id_itemslist.hide()

// w_servicereturn.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	return ::message.returnvalue

// w_servicereturn.ue_print() returns 0 [event]
	long ll_custcode
	long ll_row
	long ll_invcode
	integer li_option
	string ls_custname
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	wf_selectprintreport()
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_servicereturn.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	if this.ib_opensalereturn and this.ii_salerettype = 1 then
		setpointer(hourglass!)
		this.idc_customers.setredraw(false)
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.reset()
		this.idc_customers.retrieve()
		this.idc_customers.setredraw(true)
		setpointer(arrow!)
	end if
	wf_patient_retrieve()
	wf_student_retrieve()
	wf_guest_retrieve()

// w_servicereturn.ue_list() returns 0 [event]
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_print.enabled = true

// w_servicereturn.ue_postopen() returns 0 [event]
	datawindowchild ldc_dddservicecategory
	s_servicerettype ls_servicerettype
	long li_rtncode
	call super::ue_postopen
	this.id_print = this.dw_print
	setredraw(false)
	ls_servicerettype = message.powerobjectparm
	this.ii_patientmodule = 23
	wf_setsalereturntype(ls_servicerettype.servicerettype, ls_servicerettype.openservice)
	wf_assign_master_cash_win_object()
	this.il_groupcode = f_getgroupcode(gl_usercode)
	if not this.ib_openservicereturn then
		this.is_columnitemname = "servicecode"
		choose case this.ii_servicerettype
		case 14
			this.title = "Credit Service Return"
			wf_assigndatawindowobjects("d_Credit_ServiceReturn_Header", "d_CreditService_ReturnDetail", "d_Service_ReturnFooter", "d_ServiceRet_CreditList", "d_WholeSaleReturnInvReport")
			if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
				this.id_master.object.servicercatcode.initial = "15"
			end if
			if f_stringpreferences("ServiceCategory") = "N" then
				this.id_master.object.servicercatcode.visible = false
				this.id_master.object.t_servicercategory.visible = false
			end if
			if f_stringpreferences("showflattaxincreditservice") = "N" then
				this.id_detail.object.serviceflattax.visible = false
				this.id_detail.object.c_flattaxvalue.visible = false
			end if
			if f_stringpreferences("showgstpercincreditservice") = "N" then
				this.id_detail.object.servicegstperc.visible = false
				this.id_detail.object.c_gstvalue.visible = false
			end if
			if f_stringpreferences("showcreditserviceinvgstperc") = "N" then
				this.id_footer.object.serviceinvgstperc.visible = false
				this.id_footer.object.serviceinvgstperc_t.visible = false
			end if
			if f_stringpreferences("showcommissionincrditservice") = "N" then
				this.id_detail.object.commission.visible = false
			end if
			if f_stringpreferences("showsharepercincreditservice") = "N" then
				this.id_detail.object.shareperc.visible = false
			end if
			if f_stringpreferences("servicedoctid") = "N" then
				this.id_master.object.doctcode.visible = false
				this.id_master.object.doctcode_t.visible = false
			end if
			if f_stringpreferences("PatientOnCreditService") <> "H" then
				this.id_master.object.patientcode.visible = false
				this.id_master.object.patientcode_t.visible = false
				this.id_master.object.patientregno_t.visible = false
				this.id_master.object.patientregno.visible = false
			end if
			if f_stringpreferences("GuestOnCreditService") <> "H" then
				this.id_master.object.guestcode.visible = false
				this.id_master.object.guestcode_t.visible = false
				this.id_master.object.guestregno.visible = false
				this.id_master.object.guestregno_t.visible = false
			end if
			if f_stringpreferences("StudentOnCreditService") <> "H" then
				this.id_master.object.studentcode.visible = false
				this.id_master.object.studentcode_t.visible = false
				this.id_master.object.studentregno.visible = false
				this.id_master.object.studentregno_t.visible = false
			end if
			if f_stringpreferences("showmotorvehicleincreditservice") = "N" then
				this.id_master.object.chasisno_t.visible = false
				this.id_master.object.chasisno.visible = false
				this.id_master.object.motorvehiclecode_t.visible = false
				this.id_master.object.motorvehiclecode.visible = false
			end if
		case 13
			wf_assigndatawindowobjects("d_Serviceret_RetailHeader", "d_ServiceRet_RetailDetail", "d_Service_ReturnFooter", "d_ServiceRet_RetailList", "d_RetailSaleReturnInvReport")
			this.it_transobject.getglobalcode("GT_RetailSaleCustomerACC", this.il_code)
			if f_stringpreferences("showflattaxincashservice") = "N" then
				this.id_detail.object.serviceflattax.visible = false
				this.id_detail.object.c_flattaxvalue.visible = false
			end if
			if f_stringpreferences("showgstpercincashservice") = "N" then
				this.id_detail.object.servicegstperc.visible = false
				this.id_detail.object.c_gstvalue.visible = false
			end if
			if f_stringpreferences("showcashserviceinvgstperc") = "N" then
				this.id_footer.object.serviceinvgstperc.visible = false
				this.id_footer.object.serviceinvgstperc_t.visible = false
			end if
			if f_stringpreferences("showcommissionincashservice") = "N" then
				this.id_detail.object.commission.visible = false
			end if
			if f_stringpreferences("showsharepercincashservice") = "N" then
				this.id_detail.object.shareperc.visible = false
			end if
			if f_stringpreferences("showdoctorincashservice") = "N" then
				this.id_master.object.doctcode.visible = false
				this.id_master.object.doctcode_t.visible = false
			end if
			if f_stringpreferences("PatientOnCashService") <> "H" then
				this.id_master.object.patientcode.visible = false
				this.id_master.object.patientcode_t.visible = false
				this.id_master.object.patientregno_t.visible = false
				this.id_master.object.patientregno.visible = false
			end if
			if f_stringpreferences("GuestOnCashService") <> "H" then
				this.id_master.object.guestcode.visible = false
				this.id_master.object.guestcode_t.visible = false
				this.id_master.object.guestregno.visible = false
				this.id_master.object.guestregno_t.visible = false
			end if
			if f_stringpreferences("StudentOnCashService") <> "H" then
				this.id_master.object.studentcode.visible = false
				this.id_master.object.studentcode_t.visible = false
				this.id_master.object.studentregno.visible = false
				this.id_master.object.studentregno_t.visible = false
			end if
			if f_stringpreferences("showmotorvehicleincashservice") = "N" then
				this.id_master.object.chasisno_t.visible = false
				this.id_master.object.chasisno.visible = false
				this.id_master.object.motorvehiclecode_t.visible = false
				this.id_master.object.motorvehiclecode.visible = false
			end if
		end choose
		li_rtncode = this.id_detail.getchild("smancode", this.idc_salesman)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild for SalesMan in detail datawindow")
			close(this)
		end if
		this.idc_salesman.settransobject(this.it_transobject)
		this.ib_editing = false
	else
		choose case this.ii_servicerettype
		case 14
			this.title = "Credit Service Return"
			wf_assigndatawindowobjects("d_credit_servicereturn_header", "d_CreditService_ReturnDetail", "d_service_returnfooter", "d_serviceret_creditlist", "d_WholeSaleReturnInvReport")
			if f_stringpreferences("showmotorvehicleincreditservice") = "N" then
				this.id_master.object.chasisno_t.visible = false
				this.id_master.object.chasisno.visible = false
				this.id_master.object.motorvehiclecode_t.visible = false
				this.id_master.object.motorvehiclecode.visible = false
			end if
		case 13
			this.title = "Open Retail Sale Return"
			wf_assigndatawindowobjects("d_Serviceret_RetailHeader", "d_ServiceRet_RetailDetail", "d_Service_ReturnFooter", "d_ServiceRet_RetailList", "d_RetailSaleReturnInvReport")
			this.it_transobject.getglobalcode("GT_RetailSaleCustomerACC", this.il_code)
			if f_stringpreferences("showmotorvehicleincashservice") = "N" then
				this.id_master.object.chasisno_t.visible = false
				this.id_master.object.chasisno.visible = false
				this.id_master.object.motorvehiclecode_t.visible = false
				this.id_master.object.motorvehiclecode.visible = false
			end if
		end choose
	end if
	li_rtncode = wf_set_headersetting()
	if li_rtncode <= 0 then
		messagebox("Problem", "Not Enough Header Rights to Make Service Return")
		close(this)
		return
	end if
	if this.ib_openservicereturn <> true then
		li_rtncode = this.id_detail.getchild("servicecode", this.idc_itemdddw)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_itemdddw.settransobject(this.it_transobject)
		this.idc_itemdddw.insertrow(0)
	else
		gd_itemsinfo.sharedata(this.id_itemslist)
		if this.ii_salerettype = 1 then
			li_rtncode = this.id_master.getchild("custcode", this.idc_customers)
			if li_rtncode = -1 then
				messagebox("Error", "Can not get a DataWindowChild")
			end if
			this.idc_customers.settransobject(this.it_transobject)
		end if
	end if
	li_rtncode = this.id_master.getchild("patientcode", this.idc_patient)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_patient.settransobject(this.it_transobject)
	wf_patient_retrieve()
	li_rtncode = this.id_master.getchild("guestcode", this.idc_guest)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_guest.settransobject(this.it_transobject)
	wf_guest_retrieve()
	li_rtncode = this.id_master.getchild("studentcode", this.idc_student)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_student.settransobject(this.it_transobject)
	wf_student_retrieve()
	li_rtncode = this.id_master.getchild("motorvehiclecode", this.idc_motorvehicle)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_motorvehicle.settransobject(this.it_transobject)
	wf_motorvehicle_retrieve()
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	if f_stringpreferences("SalesManInService") = "N" then
		this.id_detail.object.smancode.visible = false
		this.id_detail.object.t_salesman.visible = false
	end if
	if this.ii_servicerettype = 13 then
		if f_stringpreferences("showflatdiscincashservicedetail") = "N" then
			this.id_detail.object.serviceflatdisc.visible = false
		end if
	elseif f_stringpreferences("showflatdiscincreditservicedetail") = "N" then
		this.id_detail.object.serviceflatdisc.visible = false
	end if
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(1)
	f_setserviceqtystyle(this.id_detail, "qty")
	setredraw(true)

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::selectionchanged(oldindex, newindex)
	if parent.ib_modify and newindex <> 1 then
		SQL rollback USING parent.it_transobject;
		parent.ib_modify = false
	end if
	return ::message.returnvalue

// dw_footer.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "misccharges"
		messagebox("Misc. Charges Validation", "Charges ~"" + data + "~" should be greater equal zero")
	case "flatdisc"
		messagebox("Flat Dsicount Validation", "Flat Discount ~"" + data + "~" should be greater equal zero")
	case "discperc"
		messagebox("Invoice Discount(%) Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	end choose
	return 1

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_code
	long ll_detailrows
	long ll_custcode
	long ll_find
	long ll_patientcode
	long ll_guestcode
	long ll_studentcode
	long ll_res
	long ll_motorvehiclecode
	long rt_code
	long ll_allowed
	integer li_result
	string ls_result
	string ls_aliasname
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "serviceinvcode"
		li_result = parent.parent.parent.wf_validatesaleinvcode(row, long(data))
	case "aliasname"
		if not isnull(data) and data <> "" then
			li_result = parent.parent.parent.wf_findcustcode(ll_custcode, data)
			if li_result > 0 then
				if parent.parent.parent.wf_customerinfo(ll_code) <> 0 then
					parent.parent.parent.wf_enforce_custallowedservices(ll_custcode)
					setitem(row, "custcode", ll_custcode)
					li_result = 0
				end if
			else
				messagebox("Customer Validation", "Customer with  Alias Name  " + data + "   does not exist")
				li_result = 1
			end if
		end if
	case "custcode"
		if not isnull(data) then
			ll_code = long(data)
			parent.setredraw(false)
			if parent.parent.parent.wf_customerinfo(ll_code) <> 0 then
				messagebox("Database Error", "Can not retrieve information of customer from database")
				li_result = 1
			else
				if accepttext() = -1 then
					return 1
				end if
				parent.parent.parent.wf_enforce_custallowedservices(ll_code)
			end if
			parent.setredraw(true)
		end if
	case "patientregno"
		if not isnull(data) and data <> "" then
			li_result = parent.parent.parent.wf_findpatientcode(data, ll_patientcode)
			if li_result > 0 then
				setitem(row, "patientcode", ll_patientcode)
				li_result = 0
				SQL SELECT acccode , aliasname INTO :ll_custcode, :ls_aliasname FROM patient , accounts WHERE patientcode =:ll_patientcode and custcode =acccode USING parent.parent.parent.it_transobject;
				if parent.parent.parent.it_transobject.sqlcode = 0 then
					setitem(row, "custcode", ll_custcode)
					setitem(row, "aliasname", ls_aliasname)
					parent.parent.parent.id_master.object.custcode.protect = 1
					parent.parent.parent.id_master.object.aliasname.protect = 1
				else
					messagebox("Patient Information", "Problem in retrieving corresponding customer")
					li_result = 1
				end if
				parent.parent.parent.wf_setpatientinfo(ll_patientcode)
			else
				if li_result = -2 then
					messagebox("Patient Validation", "Patient with  RegNo  " + data + " is Inactive")
				else
					messagebox("Patient Validation", "Patient with  RegNo  " + data + " does not exist")
				end if
				li_result = 1
			end if
		end if
	case "patientcode"
		ll_patientcode = long(data)
		if isnull(data) then
			parent.parent.parent.id_master.object.custcode.protect = 0
			parent.parent.parent.id_master.object.aliasname.protect = 0
			parent.parent.parent.id_master.setitem(1, "custcode", 0)
			parent.parent.parent.id_master.setitem(1, "aliasname", "")
		elseif parent.parent.parent.wf_setpatientinfo(ll_patientcode) = 0 then
			messagebox("Patient Validation", "Patient does not exist or Already Inactive.")
			return 1
		end if
	case "guestregno"
		if not isnull(data) and data <> "" then
			li_result = parent.parent.parent.wf_findguestcode(data, ll_guestcode)
			if li_result > 0 then
				setitem(row, "guestcode", ll_guestcode)
				li_result = 0
				SQL SELECT acccode , aliasname INTO :ll_custcode, :ls_aliasname FROM guest , accounts WHERE guestcode =:ll_guestcode and custcode =acccode USING parent.parent.parent.it_transobject;
				if parent.parent.parent.it_transobject.sqlcode = 0 then
					setitem(row, "custcode", ll_custcode)
					setitem(row, "aliasname", ls_aliasname)
					parent.parent.parent.id_master.object.custcode.protect = 1
					parent.parent.parent.id_master.object.aliasname.protect = 1
				else
					messagebox("Guest Information", "Problem in retrieving corresponding customer")
					li_result = 1
				end if
				parent.parent.parent.wf_setguestinfo(ll_guestcode)
			else
				if li_result = -2 then
					messagebox("Guest Validation", "Guest with  RegNo  " + data + " is Inactive")
				else
					messagebox("Guest Validation", "Guest with  RegNo  " + data + " does not exist")
				end if
				li_result = 1
			end if
		end if
	case "guestcode"
		ll_guestcode = long(data)
		if isnull(data) then
			parent.parent.parent.id_master.object.custcode.protect = 0
			parent.parent.parent.id_master.object.aliasname.protect = 0
			parent.parent.parent.id_master.setitem(1, "custcode", 0)
			parent.parent.parent.id_master.setitem(1, "aliasname", "")
		elseif parent.parent.parent.wf_setguestinfo(ll_guestcode) = 0 then
			messagebox("Guest Validation", "Guest does not exist or Already Inactive.")
			return 1
		end if
	case "studentregno"
		if not isnull(data) and data <> "" then
			li_result = parent.parent.parent.wf_findstudentcode(data, ll_studentcode)
			if li_result > 0 then
				setitem(row, "StudentCode", ll_studentcode)
				li_result = 0
				SQL SELECT accounts.acccode , accounts.aliasname INTO :ll_custcode, :ls_aliasname FROM Student , accounts WHERE Student.Studentcode =:ll_studentcode AND Student.custcode =accounts.acccode USING parent.parent.parent.it_transobject;
				if parent.parent.parent.it_transobject.sqlcode = 0 then
					setitem(row, "custcode", ll_custcode)
					setitem(row, "aliasname", ls_aliasname)
					parent.parent.parent.id_master.object.custcode.protect = 1
					parent.parent.parent.id_master.object.aliasname.protect = 1
				else
					messagebox("Student Information", "Problem in retrieving corresponding customer~r~nReasons are:-~r~n" + parent.parent.parent.it_transobject.sqlerrtext)
					li_result = 1
				end if
				parent.parent.parent.wf_setstudentinfo(ll_studentcode)
			else
				if li_result = -2 then
					messagebox("Student Validation", "Student with  RegNo  " + data + " is Inactive")
				else
					messagebox("Student Validation", "Student with  RegNo  " + data + " does not exist")
				end if
				li_result = 1
			end if
		end if
	case "studentcode"
		return parent.parent.parent.wf_get_studentinfo(row, data)
	case "chasisno"
		if not (isnull(data) or data = "") then
			ll_res = parent.parent.parent.wf_find_motorvehiclecode(data, ll_motorvehiclecode)
			if ll_res > 0 then
				setitem(row, "motorvehiclecode", ll_motorvehiclecode)
				rt_code = 0
				SQL SELECT custcode INTO :ll_custcode FROM motorvehicle WHERE motorvehiclecode =:ll_motorvehiclecode USING parent.parent.parent.it_transobject;
				if parent.parent.parent.it_transobject.sqlcode = 0 then
					ll_allowed = 0
					if f_stringpreferences("GroupCustomerCategory") = "Y" then
						parent.parent.parent.it_transobject.isallowedcustomergroupcategory(parent.parent.parent.il_groupcode, ll_custcode, ll_allowed)
						if parent.parent.parent.it_transobject.sqlcode <> 0 then
							messagebox("Fetch Error", "Unable to fetch group customer category information.")
							return 1
						elseif ll_allowed < 1 then
							messagebox("Group Customer Category Validation", "Current group does not have enough permissions for sale ~r~n" + "against the customer.")
							return 1
						end if
						return
					end if
					setitem(row, "motorvehiclecode", ll_motorvehiclecode)
					parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
					parent.parent.parent.id_master.object.custcode.protect = 1
					parent.parent.parent.id_master.object.aliasname.protect = 1
				end if
				parent.parent.parent.wf_set_motorvehicleinfo(ll_motorvehiclecode)
			else
				if ll_res = -2 then
					messagebox("Motor Vehicle Validation", "Motor Vehicle with  Chasis no " + data + " is Inactive")
				else
					messagebox("Motor Vehicle Validation", "Motor Vehicle with  Chasis No. " + data + " does not exist")
				end if
				rt_code = 1
			end if
			parent.parent.parent.wf_set_motorvehicleinfo(ll_motorvehiclecode)
		end if
	case "motorvehiclecode"
		parent.parent.parent.id_master.setitem(1, "chasisno", parent.parent.parent.idc_motorvehicle.getitemstring(parent.parent.parent.idc_motorvehicle.getrow(), "chasisno"))
		if isnull(data) then
			parent.parent.parent.id_master.object.custcode.protect = 0
			parent.parent.parent.id_master.setitem(1, "custcode", 0)
		else
			ll_motorvehiclecode = long(data)
			if parent.parent.parent.wf_set_motorvehicleinfo(ll_motorvehiclecode) = 0 then
				messagebox("Motor Vehicle Validation", "Motor Vehicle does not exist or Already Inactive.")
				return 1
			end if
			SQL SELECT custcode INTO :ll_custcode FROM motorvehicle WHERE motorvehiclecode =:ll_motorvehiclecode USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = 0 then
				ll_allowed = 0
				if f_stringpreferences("GroupCustomerCategory") = "Y" then
					parent.parent.parent.it_transobject.isallowedcustomergroupcategory(parent.parent.parent.il_groupcode, ll_custcode, ll_allowed)
					if parent.parent.parent.it_transobject.sqlcode <> 0 then
						messagebox("Fetch Error", "Unable to fetch group customer category information.")
						return 1
					elseif ll_allowed < 1 then
						messagebox("Group Customer Category Validation", "Current group does not have enough permissions for sale ~r~n" + "against the customer whose patient is selected in the list box.")
						return 1
					end if
					return
				end if
				parent.parent.parent.id_master.setitem(1, "custcode", ll_custcode)
				parent.parent.parent.id_master.object.custcode.protect = 1
				parent.parent.parent.id_master.object.aliasname.protect = 1
			else
				messagebox("Motor Vehicle Information", "Problem in retrieving corresponding customer.")
				rt_code = 1
			end if
		end if
	case "srcatcode"
		return li_result
	end choose
	return li_result

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	string ls_saletype
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "serviceinvcode"
		if parent.parent.parent.ii_servicerettype = 13 then
			ls_saletype = "Cash Service"
		else
			ls_saletype = "Credit Service"
		end if
		if long(data) < 0 then
			messagebox("Service Invoice code Validation", "You must select some " + ls_saletype + " invoice")
		end if
	end choose
	return 1

// dw_detail.retrieveend(long rowcount) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::retrieveend(rowcount)
	if parent.parent.parent.ib_opensalereturn and rowcount > 0 then
		parent.parent.parent.idc_itemdddw.settransobject(parent.parent.parent.it_transobject)
		parent.parent.parent.idc_itemdddw.reset()
		parent.parent.parent.idc_itemdddw.retrieve(this.object.serviceinvcode[rowcount])
	end if
	return ::message.returnvalue

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	string ls_columnobject
	long ll_currow
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_grandtotal()
	ls_columnobject = dwo.name
	ll_currow = rowcount()
	if ll_currow > 0 and (ls_columnobject = "discperc" or ls_columnobject = "srprice" or ls_columnobject = "qty") and isnull(this.object.icode[ll_currow]) then
		scrolltorow(ll_currow)
		setcolumn("icode")
	end if
	return 0

// dw_detail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.getparent().dynamic postevent("ue_accepttext")
	return ::message.returnvalue

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf6! and (getcolumnname() = "motorvehiclecode" or getcolumnname() = "chasisno") then
		parent.parent.parent.wf_motorvehiclesearch()
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_null
	long ll_rowfound
	string ls_null
	integer li_rtcode
	string ls_batch
	string ls_itemname
	datetime ld_expiry
	long ll_gcode
	long ll_icode
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case "servicecode"
		if long(data) > 0 then
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = row
		else
			return 1
		end if
	case "fullcode"
		if isnull(data) or data = "" then
			setitem(row, "servicecode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_rtcode = 2
		else
			li_res = parent.parent.parent.wf_find_service_fullcode(data, ll_icode, ls_itemname)
			if li_res > 0 then
				if ll_icode > 0 and parent.parent.parent.id_master.object.serviceinvcode[1] > 0 then
					ll_rowfound = parent.parent.parent.idc_itemdddw.find("servicecode = " + string(ll_icode) + " and (qty - returnqty) > 0", 1, parent.parent.parent.idc_itemdddw.rowcount())
					if ll_rowfound > 0 and ll_rowfound <= parent.parent.parent.idc_itemdddw.rowcount() then
						setitem(row, "servicecode", ll_icode)
						setitem(row, "qty", 1)
						parent.parent.parent.ib_itemvalidated = false
						parent.parent.parent.il_currrow = row
						li_rtcode = 0
					else
						messagebox("Service Code/Alias Name Validation", "Service does not exist in service invoice no.: " + string(parent.parent.parent.id_master.object.serviceinvcode[1]))
						setitem(row, "servicecode", ll_null)
						setitem(row, "fullcode", ls_null)
						li_rtcode = 1
					end if
				else
					ll_rowfound = parent.parent.parent.idc_itemdddw.find("servicecode = " + string(ll_icode), 1, parent.parent.parent.idc_itemdddw.rowcount())
					if ll_rowfound > 0 and ll_rowfound <= parent.parent.parent.idc_itemdddw.rowcount() then
						setitem(row, "servicecode", ll_icode)
						setitem(row, "qty", 1)
						parent.parent.parent.ib_itemvalidated = false
						parent.parent.parent.il_currrow = row
						li_rtcode = 0
					else
						messagebox("Service Code/Alias Name Validation", "Service does not exist")
						setitem(row, "servicecode", ll_null)
						setitem(row, "fullcode", ls_null)
						li_rtcode = 1
					end if
				end if
			else
				messagebox("Service Code/Alias Name Validation", "Service does not exist")
				setitem(row, "servicecode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_rtcode = 1
			end if
		end if
	case "qty"
		li_rtcode = parent.parent.parent.wf_validateqty(row, double(data))
	end choose
	return li_rtcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	string ls_columnobject
	long ll_currow
	long ll_icode
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "servicecode" then
		parent.parent.parent.ib_focusdetail = true
	else
		parent.parent.parent.ib_focusdetail = true
	end if
	parent.parent.parent.wf_grandtotal()
	parent.parent.parent.editflag = true
	selecttext(1, len(gettext()))
	parent.parent.parent.id_itemslist.hide()
	return 0

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	long ll_icode
	long ll_foundrow
	dwitemstatus lrs_status
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if parent.parent.parent.id_detail.rowcount() > 0 and lrs_status <> new! then
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "servicecode"
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case parent.parent.parent.is_columnitemname
		if data = "" or isnull(data) then
			messagebox("Item Validation", "Value required for item in current row")
		end if
	case "discperc"
		messagebox("Item Discount Validation", "Dsicount ~"" + data + "~" must be betweeen 0 and 100")
	case "serviceprice"
		if double(data) <= 0.0 then
			messagebox("Item Price Validation", "Item price ~"" + data + "~" must be greater than zero")
		else
			messagebox("Item Price Validation", "Item price can not be changed")
		end if
	end choose
	setnull(parent.parent.parent.is_validationerrtext)
	return 1

// dw_itemsdetail.getfocus() returns long [event]
	if parent.parent.parent.im_menu.m_file.m_save.enabled = true then
		if not parent.parent.parent.ib_focusdetail then
			parent.parent.parent.ib_focusdetail = true
			if f_stringpreferences("itemcode") = "N" then
			end if
		end if
		if parent.parent.parent.ib_itemslistopen then
			setfocus()
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	if getcolumn() = 1 then
		parent.parent.parent.is_aliasname = data
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	integer li_rowno
	integer i
	integer li_columnno
	li_columnno = integer(this.object.qty.id)
	if getrow() = rowcount() then
		if getcolumn() = li_columnno then
			parent.parent.parent.event ue_newitem()
			return 1
		end if
	elseif li_columnno = integer(this.object.datawindow.column.count) and getcolumn() = li_columnno then
		scrollnextrow()
		if f_stringpreferences("ItemCode") = "Y" then
			setcolumn("fullcode")
		else
			setcolumn("servicecode")
		end if
		setfocus()
		return 1
	end if
	li_rowno = parent.parent.parent.idc_itemdddw.find("fullcode='" + parent.parent.parent.is_aliasname + "'", 1, parent.parent.parent.idc_itemdddw.rowcount())
	if getcolumn() = 1 and li_rowno > 0 and li_rowno <= parent.parent.parent.idc_itemdddw.rowcount() then
		if isnull(parent.parent.parent.is_aliasname) or parent.parent.parent.is_aliasname = "" then
			setcolumn("servicecode")
		else
			setcolumn("qty")
		end if
		setfocus()
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_icode
	long ll_found
	long ll_rowm
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			parent.parent.parent.idc_itemdddw.selectrow(0, false)
			parent.parent.parent.idc_itemdddw.scrollnextrow()
			ll_listcurrrow = parent.parent.parent.idc_itemdddw.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.parent.parent.idc_itemdddw.selectrow(0, false)
			parent.parent.parent.idc_itemdddw.scrollpriorrow()
			ll_listcurrrow = parent.parent.parent.idc_itemdddw.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.parent.parent.idc_itemdddw.selectrow(0, false)
			parent.parent.parent.idc_itemdddw.scrollnextpage()
			ll_listcurrrow = parent.parent.parent.idc_itemdddw.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.parent.parent.idc_itemdddw.selectrow(0, false)
			parent.parent.parent.idc_itemdddw.scrollpriorpage()
			ll_listcurrrow = parent.parent.parent.idc_itemdddw.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.parent.parent.idc_itemdddw.selectrow(0, false)
			parent.parent.parent.idc_itemdddw.scrolltorow(99999)
			ll_listcurrrow = parent.parent.parent.idc_itemdddw.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.parent.parent.idc_itemdddw.selectrow(0, false)
			parent.parent.parent.idc_itemdddw.scrolltorow(1)
			ll_listcurrrow = parent.parent.parent.idc_itemdddw.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			setfocus()
			setredraw(true)
		elseif key = keyf4! then
			parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.idc_itemdddw.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, "servicecode", parent.parent.parent.idc_itemdddw.getitemnumber(ll_listcurrrow, "servicecode"))
			setitem(ll_rowm, "fullcode", parent.parent.parent.idc_itemdddw.getitemstring(ll_listcurrrow, "fullcode"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	elseif key = keydownarrow! then
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_focusfooter")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	end if
	return rt_code
