// w_servicereturn.wf_findcustcode(long ai_custcode, string as_aliasname) returns long
	integer li_custcode
	integer ll_retflag
	string ls_itemname
	SQL SELECT accounts.acccode INTO :li_custcode FROM accounts , customer WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =customer.custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_custcode = li_custcode
		if isnull(ai_custcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_servicereturn.wf_enforce_custallowedservices(long al_custcode) returns long
	long ll_counter
	string ls_servicelist
	u_ds_standard lds_ccustallowedservice
	if f_stringpreferences("Enforce_Customer_Allowed_Services") = "N" then
		return 0
	end if
	if isnull(al_custcode) then
		this.id_itemslist.setfilter("")
		this.id_itemslist.filter()
		return 0
	end if
	lds_ccustallowedservice = create u_ds_standard
	lds_ccustallowedservice.dataobject = "d_custallowedservice_detail"
	lds_ccustallowedservice.settransobject(this.it_transobject)
	lds_ccustallowedservice.retrieve(al_custcode)
	for ll_counter = 1 to lds_ccustallowedservice.rowcount()
		if ls_servicelist <> "" then
			ls_servicelist = ls_servicelist + ","
		end if
		ls_servicelist = ls_servicelist + trim(string(lds_ccustallowedservice.object.icode[ll_counter]))
	next
	if ls_servicelist = "" then
		ls_servicelist = "icode < 0 "
	else
		ls_servicelist = "icode IN (" + ls_servicelist + ")"
	end if
	this.id_itemslist.setfilter(ls_servicelist)
	this.id_itemslist.filter()
	return 0

// w_servicereturn.wf_findpatientcode(string as_regno, long al_patientcode) returns long
	long ll_patientcode
	long ll_retflag
	string ls_itemname
	char lc_active
	ll_retflag = 0
	SQL SELECT patient.patientcode , patient.active INTO :ll_patientcode, :lc_active FROM patient WHERE patient.regno =:as_regno and patientcatcode in ( select distinct patientcatcode from patientcatallowedmodule where moduleid =:this.ii_patientmodule ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_patientcode = ll_patientcode
		if isnull(al_patientcode) then
			ll_retflag = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
		else
			ll_retflag = -2
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_servicereturn.wf_setpatientinfo(long al_patientcode) returns long
	long ll_doctcode
	long ll_custcode
	long ll_retcode
	string ls_regno
	string ls_aliasname
	SQL SELECT Patient.RegNo , Patient.doctcode , Patient.CustCode , Accounts.AliasName INTO :ls_regno, :ll_doctcode, :ll_custcode, :ls_aliasname FROM Patient , Accounts WHERE Patient.PatientCode =:al_patientcode AND Patient.Active ='Y' AND Patient.CustCode =Accounts.AccCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.setitem(this.id_master.rowcount(), "patientregno", ls_regno)
		this.id_master.setitem(this.id_master.rowcount(), "doctcode", ll_doctcode)
		this.id_master.setitem(this.id_master.rowcount(), "patientregno", ls_regno)
		this.id_master.setitem(this.id_master.rowcount(), "custcode", ll_custcode)
		this.id_master.setitem(this.id_master.rowcount(), "aliasname", ls_aliasname)
		this.id_master.object.custcode.protect = 1
		this.id_master.object.aliasname.protect = 1
		wf_enforce_custallowedservices(ll_custcode)
		ll_retcode = 1
	else
		messagebox("Patient Information", "Problem in retrieving corresponding customer")
		ll_retcode = 0
	end if
	return ll_retcode

