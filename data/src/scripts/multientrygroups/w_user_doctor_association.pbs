// window w_user_doctor_association (multientrygroups)  ancestor: w_multi_entry

// w_user_doctor_association.wf_validate() returns integer
	long ll_code
	integer li_errcode
	integer li_code
	ll_code = this.id_detail.getitemnumber(this.il_currrow, "doctcode")
	if vf_dwdupcode1(this.id_detail, "doctcode", string(ll_code), this.il_currrow) = true then
		messagebox("Duplicate Doctor Name", "This Doctor has already been selected")
		li_errcode = -1
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		setnull(li_code)
		this.id_detail.setcolumn("doctcode")
		this.id_detail.setitem(this.il_currrow, "doctcode", li_code)
		this.id_detail.scrolltorow(this.il_currrow)
	end if
	return li_errcode

// w_user_doctor_association.wf_retrievelist() returns long
	long ll_groupcode
	ll_groupcode = f_getgroupcode(gl_usercode)
	return this.id_list.retrieve(ll_groupcode)

// w_user_doctor_association.wf_retrievelistall() returns long
	long ll_groupcode
	ll_groupcode = f_getgroupcode(gl_usercode)
	return this.id_list.retrieve(ll_groupcode)

// w_user_doctor_association.create() returns 0 [event]
	call super::create

// w_user_doctor_association.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_user_doctor_association.ue_save() returns 0 [event]
	long ll_counter
	long ll_code
	setpointer(hourglass!)
	if this.ib_itemvalidated = false and wf_validate() = -1 then
		return
	end if
	ll_code = this.id_master.getitemnumber(this.id_master.getrow(), "code")
	for ll_counter = 1 to this.id_detail.rowcount()
		this.id_detail.setitem(ll_counter, "code", ll_code)
	next
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if this.id_detail.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		messagebox("Save Changes Fail", "Changes do not take effect in database~n~r Some database problem occur", exclamation!, ok!, 1)
		setpointer(arrow!)
	else
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		this.ib_commitok = true
		this.id_detail.resetupdate()
		this.im_menu.m_file.m_new.enabled = true
		this.editflag = false
	end if
	setpointer(arrow!)

// w_user_doctor_association.ue_newform() returns 0 [event]
	call super::ue_newform
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true
	this.id_master.setfocus()

// w_user_doctor_association.ue_newitem() returns 0 [event]
	if this.ib_itemvalidated = false and wf_validate() = -1 then
		return
	end if
	call super::ue_newitem

// w_user_doctor_association.ue_detail() returns 0 [event]
	long ll_code
	long ll_rowcount
	call super::ue_detail
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.im_menu.m_file.m_print.enabled = true
	this.i_editmode = 2
	this.i_retrievemode = 2
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	this.id_dwcontrol = this.id_master
	ll_rowcount = wf_retrieve(ll_code)
	this.id_dwcontrol = this.id_detail
	wf_retrieve(ll_code)
	this.id_detail.setrow(1)
	this.id_detail.scrolltorow(1)
	this.id_detail.setcolumn("doctcode")
	this.id_detail.setfocus()
	this.id_dwcontrol = this.id_list
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_new.visible = false
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true

// w_user_doctor_association.ue_postopen() returns 0 [event]
	call super::ue_postopen
	this.id_detail.getchild("doctcode", this.idc_doctor)
	this.idc_doctor.settransobject(this.it_transobject)

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "doctcode"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_itemvalidated = false
		li_errcode = 0
	case else
		parent.parent.parent.ib_itemvalidated = true
	end choose
	return li_errcode

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "doctcode"
		if data = "" or isnull(data) then
			messagebox("Doctor Validation", "Value required for Doctor in current row")
		end if
	end choose
	return 1

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validate() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	return ::message.returnvalue
