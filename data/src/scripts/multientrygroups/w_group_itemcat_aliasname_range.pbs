// window w_group_itemcat_aliasname_range (multientrygroups)  ancestor: window

// w_group_itemcat_aliasname_range.create() returns 0 [event]
	this.dw_control = create dw_control
	this.control = {this.dw_control}

// w_group_itemcat_aliasname_range.destroy() returns 0 [event]
	destroy this.dw_control

// w_group_itemcat_aliasname_range.open() returns long [event]
	long ll_width
	long ll_height
	long ll_code
	environment env
	ll_code = message.doubleparm
	if getenvironment(env) <> 1 then
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.width = ll_width * 0.98
	this.height = ll_height * 0.85
	this.y = int((ll_height - this.height) / 2.0)
	this.dw_control.width = this.width - this.width * 0.02
	this.dw_control.height = this.height - this.width * 0.05
	this.dw_control.settransobject(sqlca)
	this.dw_control.retrieve(ll_code)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_group_itemcat_aliasname_range.close() returns long [event]
	close(this)
	return ::message.returnvalue

// w_group_itemcat_aliasname_range.key(keycode key, unsignedlong keyflags) returns long [event]
	if keydown(keyescape!) then
		close(this)
	end if
	return ::message.returnvalue
