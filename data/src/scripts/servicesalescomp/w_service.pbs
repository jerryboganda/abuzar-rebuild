// w_service.wf_deleteserviceinvoice(long al_serviceinvcode) returns integer
	SQL Delete Servicedetail Where Servicedetail.ServiceInvCode =:al_serviceinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_service.wf_locksaleinvoices(long al_sinvcode, long al_linvcode, long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From saleledger WITH ( UPDLOCK HOLDLOCK ) Where saleledger.saleinvcode Between :al_sinvcode AND :al_linvcode AND saleledger.Posted ='N' USING sqlca;
	return sqlca.sqlcode

// w_service.wf_lockserviceinvoices(long al_sinvcode, long al_linvcode, long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From ServiceHeader WITH ( UPDLOCK HOLDLOCK ) Where ServiceHeader.Serviceinvcode Between :al_sinvcode AND :al_linvcode AND ServiceHeader.Posted ='N' AND ServiceHeader.AdmissionCode IS NULL USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_service.wf_initmodify(integer ai_protect) returns 0
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_looseqty
	long ll_stock
	long ll_counter
	long ll_count
	if this.id_master.getitemstring(1, "posted") = "N" then
		if ai_protect = 0 then
			this.ib_modify = true
			this.editflag = true
			this.im_menu.m_file.m_save.enabled = true
			this.im_menu.m_file.m_new.enabled = false
			this.im_menu.m_file.m_delete.enabled = false
			this.im_menu.m_item.m_newitem.enabled = true
			this.im_menu.m_item.m_deleteitem.enabled = true
			this.im_menu.m_file.m_first.enabled = false
			this.im_menu.m_file.m_next.enabled = false
			this.im_menu.m_file.m_previous.enabled = false
			this.im_menu.m_file.m_last.enabled = false
			this.im_menu.m_file.m_retrieve.enabled = true
			this.im_menu.m_file.m_retrieve.text = "Lis&t"
			this.tab_retrieve.tabpage_detail.enabled = true
		end if
		return
	end if
	this.ib_modify = false
	this.editflag = false

// w_service.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	integer ll_icode
	integer ll_retflag
	string ls_itemname
	if f_stringpreferences("EnableServiceCatRights") = "Y" then
		SQL SELECT service.servicecode , service.name INTO :ll_icode, :ls_itemname FROM service WHERE service.aliasname =:as_fullcode AND service.servicecatcode IN ( SELECT sc.servicecatcode FROM GroupAllowedServiceCategory sc WHERE sc.GroupCode =:this.il_groupcode ) USING this.it_transobject;
	else
		SQL SELECT service.servicecode , service.name INTO :ll_icode, :ls_itemname FROM service WHERE service.aliasname =:as_fullcode USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_service.wf_findcustcode(integer ai_custcode, string as_aliasname) returns integer
	integer li_custcode
	integer ll_retflag
	string ls_itemname
	SQL SELECT accounts.acccode INTO :li_custcode FROM accounts , customer WHERE accounts.aliasname =:as_aliasname AND accounts.acccode =customer.custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_custcode = li_custcode
		if isnull(ai_custcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_service.wf_validateitem(boolean ab_flag) returns integer
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean ib_due
	integer li_null
	string ls_null
	if this.id_detail.rowcount() > 0 and this.il_currrow > 0 then
		ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	else
		li_errcode = -1
	end if
	if not isnull(ll_icode) and wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
	end if
	if ab_flag then
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		ls_titleerrtext = "Service Validation"
		messagebox(ls_titleerrtext, ls_errtext)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
	end if
	return li_errcode

// w_service.wf_inititeminfo(long al_icode, long al_row, integer ai_rtcode, string as_errortext) returns boolean
	boolean retflag
	boolean lb_continue
	double ld_saleprice
	double ld_discperc
	double ld_commission
	double ld_costprice
	double ld_policy_price
	double ld_flatdisc
	double ld_serviceflattax
	double ld_servicegstperc
	double ld_shareperc
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_allowsaleindecimal
	datetime ldt_date
	datetime ldt_deliverydate
	datetime ldt_dt
	datetime ldt_dt2
	datetime ldt_dt3
	datetime ldt_today
	char lc_lockprice
	char lc_lockdiscperc
	char lc_lockserviceflatdisc
	setnull(ls_null)
	SQL SELECT service.aliasname , service.name , service.price , service.commission , service.costprice , dt =DATEADD ( mi , processmin , DATEADD ( hh , processhours , DATEADD ( dd , processdays , GETDATE ( ) ) ) ) , dt2 =( SELECT CAST ( convert ( varchar ( 100 ) , getdate ( ) , 111 ) + ' ' + convert ( varchar ( 100 ) , ISNULL ( ServiceDeliveryTime , CAST ( '1900-01-01 00:00:00' AS DATETIME ) ) , 108 ) AS DATETIME ) FROM Groups WHERE GroupCode =:this.il_groupcode ) , dt3 =( SELECT CAST ( convert ( varchar ( 100 ) , getdate ( ) + 1 , 111 ) + ' ' + convert ( varchar ( 100 ) , ISNULL ( ServiceDeliveryTime , CAST ( '1900-01-01 00:00:00' AS DATETIME ) ) , 108 ) AS DATETIME ) FROM Groups WHERE GroupCode =:this.il_groupcode ) , Today =( SELECT GETDATE ( ) FROM Groups WHERE GroupCode =:this.il_groupcode ) , ServiceFlatDisc , AllowSaleInDecimal , LockPrice , LockDiscPerc , LockServiceFlatDisc , ServiceFlatTax , ServiceGSTPerc , SharePerc INTO :ls_fullcode, :ls_name, :ld_saleprice, :ld_commission, :ld_costprice, :ldt_dt, :ldt_dt2, :ldt_dt3, :ldt_today, :ld_flatdisc, :ls_allowsaleindecimal, :lc_lockprice, :lc_lockdiscperc, :lc_lockserviceflatdisc, :ld_serviceflattax, :ld_servicegstperc, :ld_shareperc FROM service WHERE service.servicecode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		ai_rtcode = -1
		retflag = false
		as_errortext = "Database Error: Service information can not be retrieved"
	end if
	if retflag then
		if f_stringpreferences("FetchServiceDeliveryDateFrom") = "S" then
			ldt_deliverydate = ldt_dt
		elseif ldt_dt2 > ldt_today then
			ldt_deliverydate = ldt_dt2
		else
			ldt_deliverydate = ldt_dt3
		end if
		if f_stringpreferences("FetchServicePriceFromPricePolicy") = "Y" then
			ld_policy_price = 0
			this.it_transobject.getpricefromservicepricepolicy(al_icode, ld_policy_price)
			if this.it_transobject.sqlcode = 0 then
				ld_saleprice = ld_policy_price
			else
				messagebox("Price Policy Implementation", "Some Problem Occured while fetching Service Price Policy details~r~n" + this.it_transobject.sqlerrtext, stopsign!)
				ai_rtcode = -1
				lb_continue = false
			end if
		end if
		if lb_continue then
			this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
			this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
			this.id_detail.setitem(al_row, "allowsaleindecimal", ls_allowsaleindecimal)
			if this.id_detail.getitemstatus(al_row, "saleprice", primary!) = new! or this.id_detail.getitemstatus(al_row, "saleprice", primary!) = notmodified! then
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
				this.id_detail.setitem(al_row, "commission", ld_commission)
				this.id_detail.setitem(al_row, "deliverydate", ldt_deliverydate)
				this.id_detail.setitem(al_row, "serviceflatdisc", ld_flatdisc)
				this.id_detail.setitem(al_row, "serviceflattax", ld_serviceflattax)
				this.id_detail.setitem(al_row, "servicegstperc", ld_servicegstperc)
				this.id_detail.setitem(al_row, "SharePerc", ld_shareperc)
			end if
			if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
				this.id_detail.setitem(al_row, "saleprice", ld_saleprice)
				this.id_detail.setitem(al_row, "commission", ld_commission)
				this.id_detail.setitem(al_row, "deliverydate", ldt_deliverydate)
				this.id_detail.setitem(al_row, "serviceflatdisc", ld_flatdisc)
				this.id_detail.setitem(al_row, "serviceflattax", ld_serviceflattax)
				this.id_detail.setitem(al_row, "servicegstperc", ld_servicegstperc)
				this.id_detail.setitem(al_row, "SharePerc", ld_shareperc)
			end if
			this.id_detail.setitem(al_row, "itemcode", al_icode)
			this.id_detail.setitem(al_row, "costprice", ld_costprice)
			this.id_detail.setitem(al_row, "icode", al_icode)
			this.id_detail.setitem(al_row, "lockprice", lc_lockprice)
			this.id_detail.setitem(al_row, "lockdiscperc", lc_lockdiscperc)
			this.id_detail.setitem(al_row, "lockserviceflatdisc", lc_lockserviceflatdisc)
			ai_rtcode = 0
		end if
	end if
	return retflag

// w_service.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_service.wf_grandtotal() returns double
	double ld_grandtotal
	double ld_detaildwtotal
	double ld_customerbalance
	double ld_cashreceived
	double ld_serviceflattax
	double ld_servicegstperc
	double ld_sumitemleveltaxval
	double ld_suminvleveltaxval
	double ld_totaltaxoninv
	real lr_discperc
	real lr_flatdisc
	real lr_serviceinvgstperc
	real lr_misccharges
	real lr_salestax
	real lr_itemstotal
	if this.id_detail.rowcount() > 0 and this.id_footer.rowcount() > 0 then
		lr_discperc = this.id_footer.object.invdiscperc[1]
		lr_flatdisc = this.id_footer.object.flatdisc[1]
		lr_misccharges = this.id_footer.object.misccharges[1]
		lr_serviceinvgstperc = this.id_footer.object.serviceinvgstperc[1]
		ld_detaildwtotal = this.id_detail.getitemnumber(1, "c_detaildwtotal")
		ld_grandtotal = ld_detaildwtotal * (1.0 - lr_discperc * 0.01) - lr_flatdisc + lr_misccharges + lr_salestax
		ld_sumitemleveltaxval = this.id_detail.getitemnumber(1, "c_sumflattaxval") + this.id_detail.getitemnumber(1, "c_sumgstval")
		ld_suminvleveltaxval = round((ld_detaildwtotal * (1.0 - lr_discperc * 0.01) - lr_flatdisc) * 0.01 * lr_serviceinvgstperc, 2)
		ld_totaltaxoninv = round(ld_sumitemleveltaxval + ld_suminvleveltaxval, 0)
		ld_grandtotal = round(ld_grandtotal, 0)
		ld_grandtotal = ld_grandtotal + ld_totaltaxoninv
		this.id_footer.setitem(1, "total", ld_grandtotal)
		if this.ii_servicetype = 10 then
			this.id_footer.setitem(1, "balance", ld_grandtotal)
		else
			ld_customerbalance = this.id_master.object.customerbalance[1]
			if isnull(ld_customerbalance) then
				ld_customerbalance = 0
			end if
			ld_cashreceived = ld_grandtotal + ld_customerbalance
			this.id_footer.setitem(1, "balance", ld_cashreceived)
		end if
	end if
	return ld_grandtotal

// w_service.wf_populatesaledetail(long al_invid, datawindow ad_saledetail, string as_errortext, long al_errorrow) returns boolean
	long ll_detailrows
	long ll_stock
	long ll_newstock
	long ll_gcode
	long ll_icode
	long ll_salelooseqty
	long ll_dueqty
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode
	long li_counter
	long li_innercounter
	long ll_insertedrows
	long ll_looseqty
	long ll_itemsdetailrowcount
	long ll_row
	long ll_itemflatdisc
	double ld_rate
	double ld_flatdisc
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	boolean lb_commitflag
	string ls_batch
	string ls_updatesaleprice
	string ls_updsaleprice
	string ls_saleitemdescription
	datetime ld_expiry
	dwitemstatus ldws_column
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	ll_itemsdetailrowcount = 0
	ls_updatesaleprice = f_stringpreferences("updatesaleprice")
	as_errortext = "    Some database problem ocuurs         "
	do while li_counter <= ll_detailrows and lb_commitflag
		ll_gcode = this.id_detail.getitemnumber(li_counter, "gcode")
		ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
		ll_salelooseqty = this.id_detail.getitemnumber(li_counter, "looseqty")
		ll_dueqty = this.id_detail.getitemnumber(li_counter, "dueqty")
		ll_packunits = this.id_detail.getitemnumber(li_counter, "packunits")
		ld_saleprice = this.id_detail.getitemnumber(li_counter, "saleprice")
		ld_discperc = this.id_detail.getitemnumber(li_counter, "discperc")
		ld_flatdisc = this.id_detail.getitemnumber(li_counter, "serviceflatdisc")
		ld_rate = this.id_detail.getitemnumber(li_counter, "rate")
		ll_itemflatdisc = this.id_detail.getitemnumber(li_counter, "itemflatdisc")
		ls_saleitemdescription = this.id_detail.getitemstring(li_counter, "saleitemdescription")
		ldws_column = this.id_detail.getitemstatus(li_counter, "saleprice", primary!)
		ls_updsaleprice = this.id_detail.getitemstring(li_counter, "updatesaleprice")
		ll_salelooseqty = ll_salelooseqty - ll_dueqty
		this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			if ll_salelooseqty > 0 and lb_commitflag then
				if wf_selectitembatches(ll_gcode, ll_icode, ll_salelooseqty, ad_saledetail, ll_insertedrows, as_errortext) = 0 then
					for li_innercounter = 1 to ll_insertedrows
						ll_row = ll_itemsdetailrowcount + li_innercounter
						ad_saledetail.setitem(ll_row, "code", al_invid)
						ad_saledetail.setitem(ll_row, "packunits", ll_packunits)
						ad_saledetail.setitem(ll_row, "saleprice", ld_saleprice)
						ad_saledetail.setitem(ll_row, "serviceflatdisc", ld_flatdisc)
						ad_saledetail.setitem(ll_row, "discperc", ld_discperc)
						ad_saledetail.setitem(ll_row, "rate", ld_rate)
						ad_saledetail.setitem(ll_row, "avgprice", ld_avgprice)
						ad_saledetail.setitem(ll_row, "itemflatdisc", ll_itemflatdisc)
						ad_saledetail.setitem(ll_row, "saleitemdescription", ls_saleitemdescription)
						ls_batch = ad_saledetail.getitemstring(ll_row, "batch")
						ld_expiry = ad_saledetail.getitemdatetime(ll_row, "expiry")
						ll_looseqty = ad_saledetail.getitemnumber(ll_row, "looseqty")
						ll_stock = ad_saledetail.getitemnumber(ll_row, "stock")
						ll_newstock = ll_stock - ll_looseqty
						if ll_newstock > 0 then
							this.it_transobject.updateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ll_newstock)
						else
							this.it_transobject.deleteitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ll_stock)
						end if
						if this.it_transobject.sqlcode <> 0 then
							lb_commitflag = false
						end if
					next
					ll_itemsdetailrowcount = ll_itemsdetailrowcount + ll_insertedrows
				else
					this.id_detail.setitem(li_counter, "stock", ll_insertedrows)
					lb_commitflag = false
				end if
			end if
			if ll_dueqty > 0 and lb_commitflag then
				ll_itemsdetailrowcount = ll_itemsdetailrowcount + 1
				ad_saledetail.insertrow(0)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "gcode", ll_gcode)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "icode", ll_icode)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "batch", "Due")
				ad_saledetail.setitem(ll_itemsdetailrowcount, "expiry", relativedate(today(), 365))
				ad_saledetail.setitem(ll_itemsdetailrowcount, "stock", ll_stock)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "totalstock", 0)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "looseqty", ll_dueqty)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "due", "D")
				ad_saledetail.setitem(ll_itemsdetailrowcount, "code", al_invid)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "packunits", ll_packunits)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "saleprice", ld_saleprice)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "serviceflatdisc", ld_flatdisc)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "discperc", ld_discperc)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "rate", ld_rate)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "avgprice", ld_avgprice)
				ad_saledetail.setitem(ll_itemsdetailrowcount, "itemflatdisc", ll_itemflatdisc)
			end if
		else
			lb_commitflag = false
		end if
		li_counter = li_counter + 1
	loop
	if not lb_commitflag then
		al_errorrow = li_counter - 1
		messagebox("Database Error", as_errortext)
	end if
	return lb_commitflag

// w_service.wf_selectprintreport() returns string
	string ls_pagesize
	string ls_report
	ls_pagesize = f_stringpreferences("pagesize")
	if ls_pagesize = "Q" and this.ii_saletype = 3 then
		if gs_company = "FZ" or gs_company = "CMH" or gs_company = "FZGUL" then
			ls_report = "d_retailsaleinvreport"
		else
			ls_report = "d_retailsaleinvreportwh"
		end if
	elseif ls_pagesize = "Q" and this.ii_saletype = 2 then
		if gs_company = "FZ" or gs_company = "CMH" or gs_company = "FZGUL" then
			ls_report = "d_wholesaleinvreport"
		else
			ls_report = "d_wholesaleinvreportwh"
		end if
	elseif ls_pagesize = "F" and this.ii_saletype = 3 then
		if gs_company = "SA" then
			ls_report = "d_sa_retailsaleinvreport_full"
		else
			ls_report = "d_retailsaleinvreport_full"
		end if
	elseif ls_pagesize = "F" and this.ii_saletype = 2 then
		if gs_company = "SA" then
			ls_report = "d_sa_wholesaleinvreport_full"
		else
			ls_report = "d_wholesaleinvreport_full"
		end if
	else
		ls_report = "d_retailsaleinvreport_full"
	end if
	this.id_print.dataobject = ls_report
	this.id_print.settransobject(this.it_transobject)
	return ls_report

// w_service.wf_newcustomer() returns integer
	s_saletemplate lstr_template
	long ll_custcode
	if wf_iseditable() = false then
		return -1
	end if
	open(w_popup_customer)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = true and this.ii_servicetype = 11 then
		setpointer(hourglass!)
		this.idc_customers.setredraw(false)
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.retrieve()
		this.idc_customers.setredraw(true)
		ll_custcode = lstr_template.l_invtemplate
		this.id_master.setitem(this.id_master.getrow(), "custcode", ll_custcode)
		setpointer(arrow!)
	end if
	return 1

// w_service.wf_copyinvoice() returns integer
	datastore lds_servicedetail
	datastore lds_serviceheader
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrows
	long ll_srvorowid
	long ll_currentrow
	integer li_retcode
	integer li_errcode
	integer li_looseqty
	integer li_counter
	integer ll_found
	integer ll_innercounter
	integer li_holdqty
	integer li_holdbonusqty
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	boolean lb_bonus
	long[] lla_detailrows
	long ll_custcode
	long ll_currrow
	long ll_counter
	long ll_customerbalance
	if wf_iseditable() = false then
		return -1
	end if
	if this.id_master.rowcount() < 1 then
		return 1
	elseif this.id_master.getitemstring(1, "posted") = "Y" and not isnull(this.id_master.getitemnumber(1, "code")) then
		return 1
	end if
	lds_servicedetail = create datastore
	open(w_copyserviceinvoicefrom)
	lstr_template = message.powerobjectparm
	if lstr_template.b_userinput = false then
		destroy lds_servicedetail
		return -1
	end if
	if lstr_template.c_copyinvfrom = "O" then
		lds_servicedetail.dataobject = "d_copy_serviceorderdetail"
		lds_servicedetail.settransobject(this.it_transobject)
		lla_detailrows = lstr_template.l_detailrows
		for li_counter = this.id_detail.rowcount() to li_counter step -1
			event ue_deleteitem()
		next
		ll_totalrows = upperbound(lstr_template.l_detailrows)
		for ll_rowcount = 1 to ll_totalrows
			ll_srvorowid = lla_detailrows[ll_rowcount]
			if ll_rowcount = 1 then
				SQL Select ServiceOHeader.custcode INTO :ll_custcode From ServiceOHeader , ServiceODetail Where ServiceODetail.SrvORowId =:ll_srvorowid AND ServiceOHeader.ServiceOCode =ServiceODetail.ServiceOCode USING sqlca;
				if sqlca.sqlcode = 0 then
					if this.ii_servicetype = 11 then
						this.id_master.setitem(this.id_master.getrow(), "custcode", ll_custcode)
					end if
				else
					messagebox("Customer Information", "Unable to fetch customer information")
				end if
			end if
			lds_servicedetail.retrieve(ll_srvorowid)
			ll_currentrow = lds_servicedetail.getrow()
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_servicedetail.getitemnumber(ll_currentrow, "servicecode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "icode", lds_servicedetail.getitemnumber(ll_currentrow, "servicecode"))
			this.id_detail.setitem(ll_rowcount, "itemname", lds_servicedetail.getitemstring(ll_currentrow, "service"))
			this.id_detail.setitem(ll_rowcount, "smancode", lds_servicedetail.getitemnumber(ll_currentrow, "smancode"))
			this.id_detail.setitem(ll_rowcount, "qty", lds_servicedetail.getitemnumber(ll_currentrow, "qty"))
			this.id_detail.setitem(ll_rowcount, "saleprice", lds_servicedetail.getitemnumber(ll_currentrow, "price"))
			this.id_detail.setitem(ll_rowcount, "serviceflatdisc", lds_servicedetail.getitemnumber(ll_currentrow, "serviceflatdisc"))
			this.id_detail.setitem(ll_rowcount, "discperc", lds_servicedetail.getitemnumber(ll_currentrow, "discperc"))
			this.id_detail.setitem(ll_rowcount, "SrvORowId", lds_servicedetail.getitemnumber(ll_currentrow, "SrvORowId"))
			this.id_detail.setitem(ll_rowcount, "ServiceStatus", "Y")
		next
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
		if this.ii_servicetype = 11 and f_stringpreferences("InServiceCustomerBalance") = "Y" then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
			this.ids_customersbalance.retrieve()
			ll_currrow = this.id_master.getrow()
			for ll_counter = 1 to this.ids_customersbalance.rowcount()
				if this.ids_customersbalance.getitemnumber(ll_counter, "code1") = this.id_master.getitemnumber(ll_currrow, "custcode") then
					ll_customerbalance = this.ids_customersbalance.getitemnumber(ll_counter, "value1")
					this.id_master.setitem(ll_currrow, "customerbalance", ll_customerbalance)
					if ll_customerbalance > 0 then
						this.id_master.setitem(ll_currrow, "debitorcredit", "Dr")
					else
						this.id_master.setitem(ll_currrow, "debitorcredit", "Cr")
					end if
					exit
				else
					this.id_master.setitem(ll_currrow, "debitorcredit", "Cr")
					this.id_master.setitem(ll_currrow, "customerbalance", 0)
				end if
			next
		end if
		wf_grandtotal()
	end if
	destroy lds_servicedetail
	return li_retcode

// w_service.wf_post() returns integer
	integer li_postingmode
	long ll_sinvcode
	long ll_linvcode
	long ll_found
	if this.tab_retrieve.selectedtab = 1 then
		return 0
	end if
	setnull(ll_sinvcode)
	setnull(ll_linvcode)
	ll_found = 0
	if this.ii_servicetype = 10 then
		ll_found = gds_securitywindow.find("rightcode = 715", 1, gds_securitywindow.rowcount())
	else
		ll_found = gds_securitywindow.find("rightcode = 716", 1, gds_securitywindow.rowcount())
	end if
	if ll_found <= 0 then
		messagebox("Service Invoice Posting", "Not Enough rights to post service invoice")
		return -1
	end if
	return wf_post_service_custwise(li_postingmode, ll_sinvcode, ll_linvcode)

// w_service.wf_select_service_printout() returns 0
	string ls_pagesize
	string ls_dataobject
	long ll_serviceinvcode
	boolean lb_listtab
	integer li_headerno
	if this.tab_retrieve.selectedtab = 1 then
		lb_listtab = false
	else
		lb_listtab = true
	end if
	if lb_listtab then
		ll_serviceinvcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		li_headerno = this.id_list.getitemnumber(this.id_list.getrow(), "headerno")
	else
		ll_serviceinvcode = this.id_master.getitemnumber(this.id_master.getrow(), "code")
		li_headerno = this.id_master.getitemnumber(1, "headerno")
	end if
	ls_dataobject = f_getservicesaleprintouts(this.ii_servicetype, li_headerno, ll_serviceinvcode)
	this.id_print.dataobject = ls_dataobject
	f_set_headerlogo_service(this.id_print, li_headerno)

// w_service.wf_protect_saleprice() returns 0
	long ll_found
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 610", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_detail.object.saleprice.protect = 0
		return
	end if
	this.id_detail.object.saleprice.protect = 1

// w_service.wf_populateserviceorder(long al_ordercode) returns long
	datastore lds_servicedetail
	datastore lds_serviceheader
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_detailrows
	long ll_icode
	long ll_insertedrows
	long ll_srvorowid
	long ll_currentrow
	long ll_found
	integer li_retcode
	integer li_errcode
	integer li_looseqty
	integer li_counter
	integer ll_innercounter
	integer li_holdqty
	integer li_holdbonusqty
	string ls_errortext
	boolean lb_isitemexists
	boolean lb_enablesave
	boolean lb_bonus
	long[] lla_detailrows
	long ll_custcode
	long ll_currrow
	long ll_counter
	long ll_customerbalance
	if wf_iseditable() = false then
		return -1
	end if
	if this.id_master.rowcount() < 1 then
		return 1
	elseif this.id_master.getitemstring(1, "posted") = "Y" and not isnull(this.id_master.getitemnumber(1, "code")) then
		return 1
	end if
	lds_servicedetail = create datastore
	lds_serviceheader = create datastore
	if al_ordercode > 0 and not isnull(al_ordercode) then
		for li_counter = this.id_detail.rowcount() to li_counter step -1
			event ue_deleteitem()
		next
		lds_servicedetail.dataobject = "d_serviceorderdetail"
		lds_servicedetail.settransobject(this.it_transobject)
		lds_servicedetail.retrieve(al_ordercode)
		lds_serviceheader.dataobject = "d_serviceorderheader"
		lds_serviceheader.settransobject(this.it_transobject)
		lds_serviceheader.retrieve(al_ordercode)
		ll_totalrows = lds_servicedetail.rowcount()
		for ll_rowcount = 1 to ll_totalrows
			if lds_serviceheader.rowcount() > 0 and ll_rowcount = 1 then
				if this.ii_servicetype = 11 then
					this.id_master.setitem(1, "custcode", lds_serviceheader.object.custcode[1])
				end if
				this.id_master.setitem(1, "discperc", lds_serviceheader.object.discperc[1])
				this.id_master.setitem(1, "flatdisc", lds_serviceheader.object.flatdisc[1])
				this.id_master.setitem(1, "misccharges", lds_serviceheader.object.misccharges[1])
				this.id_master.setitem(1, "remarks", lds_serviceheader.object.remarks[1])
				this.id_master.setitem(1, "doctcode", lds_serviceheader.object.doctcode[1])
				this.id_master.setitem(1, "patientcode", lds_serviceheader.object.patientcode[1])
			end if
			ll_currentrow = this.id_detail.insertrow(0)
			wf_inititeminfo(lds_servicedetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_currentrow, "icode", lds_servicedetail.getitemnumber(ll_rowcount, "icode"))
			this.id_detail.setitem(ll_currentrow, "itemname", lds_servicedetail.getitemstring(ll_rowcount, "itemname"))
			this.id_detail.setitem(ll_currentrow, "smancode", lds_servicedetail.getitemnumber(ll_rowcount, "smancode"))
			this.id_detail.setitem(ll_currentrow, "qty", lds_servicedetail.getitemnumber(ll_rowcount, "qty"))
			this.id_detail.setitem(ll_currentrow, "saleprice", lds_servicedetail.getitemnumber(ll_rowcount, "saleprice"))
			this.id_detail.setitem(ll_currentrow, "serviceflatdisc", lds_servicedetail.getitemnumber(ll_rowcount, "serviceflatdisc"))
			this.id_detail.setitem(ll_currentrow, "discperc", lds_servicedetail.getitemnumber(ll_rowcount, "discperc"))
			this.id_detail.setitem(ll_currentrow, "SrvORowId", lds_servicedetail.getitemnumber(ll_rowcount, "SrvORowId"))
			this.id_detail.setitem(ll_currentrow, "ServiceStatus", "Y")
		next
		if ll_totalrows > 0 then
			lb_enablesave = true
		end if
	end if
	if lb_enablesave then
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
		if this.ii_servicetype = 11 and f_stringpreferences("InServiceCustomerBalance") = "Y" then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
			this.ids_customersbalance.retrieve()
			ll_currrow = this.id_master.getrow()
			ll_found = this.ids_customersbalance.find(" code1 = " + trim(string(this.id_master.getitemnumber(ll_currrow, "custcode"))), 1, this.ids_customersbalance.rowcount())
			if ll_found > 0 then
				if this.ids_customersbalance.getitemnumber(ll_found, "code1") = this.id_master.getitemnumber(ll_currrow, "custcode") then
					ll_customerbalance = this.ids_customersbalance.getitemnumber(ll_found, "value1")
					this.id_master.setitem(ll_currrow, "customerbalance", ll_customerbalance)
					if ll_customerbalance > 0 then
						this.id_master.setitem(ll_currrow, "debitorcredit", "Dr")
					else
						this.id_master.setitem(ll_currrow, "debitorcredit", "Cr")
					end if
				else
					this.id_master.setitem(ll_currrow, "debitorcredit", "Cr")
					this.id_master.setitem(ll_currrow, "customerbalance", 0)
				end if
			end if
		end if
		wf_grandtotal()
	end if
	destroy lds_servicedetail
	return li_retcode

// w_service.wf_editservicetemplate() returns long
	datastore lds_detail
	datastore lds_header
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_row
	long ll_mrow
	integer li_retcode
	integer li_errcode
	string ls_errortext
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.rowcount() > 0 then
		if this.id_master.object.posted[1] = "Y" and this.id_master.object.code[1] > 0 then
			return 0
		end if
	else
		return 0
	end if
	lds_detail = create datastore
	lds_header = create datastore
	open(w_edit_servicetemplate)
	lstr_template = message.powerobjectparm
	if lstr_template.c_copyinvfrom = "T" then
		lds_detail.dataobject = "d_servicetemplate_detail"
		lds_detail.settransobject(this.it_transobject)
		lds_header.dataobject = "d_servicetemplate_header"
		lds_header.settransobject(this.it_transobject)
		ll_row = lds_header.retrieve(lstr_template.l_invtemplate)
		lds_detail.retrieve(lstr_template.l_invtemplate)
		ll_totalrows = lds_header.retrieve(lstr_template.l_invtemplate)
		if ll_row < 0 or ll_totalrows < 0 then
			li_retcode = -1
			return -1
		else
			for ll_rowcount = 1 to this.id_detail.rowcount()
				event ue_deleteitem()
			next
		end if
		ll_mrow = this.id_master.getrow()
		ll_totalrows = lds_detail.rowcount()
		this.id_detail.reset()
		for ll_rowcount = 1 to ll_totalrows
			this.id_detail.insertrow(0)
			wf_inititeminfo(lds_detail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
			this.id_detail.setitem(ll_rowcount, "qty", lds_detail.getitemnumber(ll_rowcount, "qty"))
			this.id_detail.setitem(ll_rowcount, "saleprice", lds_detail.getitemnumber(ll_rowcount, "saleprice"))
			this.id_detail.setitem(ll_rowcount, "serviceflatdisc", lds_detail.getitemnumber(ll_rowcount, "serviceflatdisc"))
			this.id_detail.setitem(ll_rowcount, "discperc", lds_detail.getitemnumber(ll_rowcount, "discperc"))
			this.id_detail.setitem(ll_rowcount, "smancode", lds_detail.getitemnumber(ll_rowcount, "smancode"))
		next
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_print.enabled = true
	end if
	return li_retcode

// w_service.wf_patient_retrieve() returns long
	long ll_prow
	long ll_pcode
	long ll_retcode
	if this.ic_retrievepatientlist = "N" then
		ll_retcode = 0
	else
		this.idc_patient.retrieve(this.ii_patientmodule)
	end if
	if this.idc_patient.rowcount() <= 0 then
		ll_prow = this.idc_patient.insertrow(0)
		setnull(ll_pcode)
		this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
		this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
		this.idc_patient.setitem(ll_prow, "name", "<NONE>")
		this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
		this.idc_patient.setitem(ll_prow, "city", "<NONE>")
		this.idc_patient.scrolltorow(ll_prow)
	end if
	return 0

// w_service.wf_setpatientinfo(long al_patientcode) returns long
	long ll_doctcode
	long ll_custcode
	long ll_retcode
	string ls_regno
	string ls_aliasname
	SQL SELECT Patient.RegNo , Patient.doctcode , Patient.CustCode , Accounts.AliasName INTO :ls_regno, :ll_doctcode, :ll_custcode, :ls_aliasname FROM Patient , Accounts WHERE Patient.PatientCode =:al_patientcode AND Patient.Active ='Y' AND Patient.CustCode =Accounts.AccCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.setitem(this.id_master.rowcount(), "patientregno", ls_regno)
		this.id_master.setitem(this.id_master.rowcount(), "doctcode", ll_doctcode)
		this.id_master.setitem(this.id_master.rowcount(), "patientregno", ls_regno)
		this.id_master.setitem(this.id_master.rowcount(), "custcode", ll_custcode)
		this.id_master.setitem(this.id_master.rowcount(), "aliasname", ls_aliasname)
		this.id_master.object.custcode.protect = 1
		this.id_master.object.aliasname.protect = 1
		wf_set_patientbalance(al_patientcode)
		wf_set_customerbalance(this.id_master.object.custcode[this.id_master.rowcount()], this.id_master.rowcount())
		wf_enforce_custallowedservices(ll_custcode)
		this.dw_image.retrieve(al_patientcode)
		wf_populate_image(al_patientcode)
		ll_retcode = 1
	else
		messagebox("Patient Information", "Problem in retrieving corresponding customer")
		ll_retcode = 0
	end if
	return ll_retcode

// w_service.wf_new_patientregistration() returns long
	string ls_regno
	long ll_patientcode
	long ll_found
	long ll_row
	dwobject dwo
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 689", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		open(w_patientregistration)
		ls_regno = message.stringparm
		if not (ls_regno = "" or isnull(ls_regno)) then
			wf_patient_retrieve()
			wf_validate_patient_from_outside(ls_regno)
			ll_found = 0
			ll_found = this.idc_patient.find("regno = '" + ls_regno + "'", 1, this.idc_patient.rowcount())
			if ll_found > 0 then
				this.id_master.setitem(1, "patientregno", this.idc_patient.getitemstring(ll_found, "regno"))
				ll_patientcode = this.idc_patient.getitemnumber(ll_found, "patientcode")
				this.id_master.setitem(1, "patientcode", ll_patientcode)
				dwo = this.id_master.object.patientcode
				this.id_master.post event itemchanged(1, dwo, string(ll_patientcode))
			end if
		end if
	end if
	return 0

// w_service.wf_apply_associated_doctor_tempate(integer ai_mode) returns long
	long ll_doctcode
	long ll_masterrow
	long ll_templatecode
	long ll_detailrows
	long ll_templateheaderrow
	long ll_templaterows
	long ll_found
	long ll_rowcount
	long ll_templatepackunits
	long ll_icode
	long ll_notfound_itemcount
	long ll_prefsetting
	double ld_templateprice
	double ld_templatediscperc
	double ld_template_flatdisc
	double ld_template_shareperc
	double ld_templateqty
	double ld_qty
	double ld_commission
	string ls_msgtitle
	string ls_itemname
	string ls_msgdetail
	boolean lb_editsaleprice
	boolean lb_editsalediscperc
	boolean lb_editbonusqty
	boolean lb_edititewflatdisc
	datastore lds_templatedetail
	datastore lds_templateheader
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_doctcode = this.id_master.getitemnumber(ll_masterrow, "doctcode")
	if ll_doctcode = 0 or isnull(ll_doctcode) then
		messagebox(ls_msgtitle, "Please Select Valid Doctor", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Items before applying Doctors' Associated Service Template", stopsign!)
		return 0
	end if
	ll_templatecode = wf_get_associated_templatecode(ll_doctcode)
	if ll_templatecode < 0 then
		if ll_templatecode = -1 then
			messagebox(ls_msgtitle, "Please Select Valid Doctor", stopsign!)
			return 0
		else
			messagebox(ls_msgtitle, "Problem in retrieving Associated Service Template of this Doctor", stopsign!)
			return 0
		end if
	elseif ll_templatecode = 0 then
		if ai_mode = 0 then
			messagebox(ls_msgtitle, "No Associated Service Template found for this Doctor", stopsign!)
			return 0
		else
			return 1
		end if
		return
	end if
	if f_stringpreferences("applydoctortemplateonsaving") = "Y" then
		ll_prefsetting = 1
	elseif f_stringpreferences("applydoctortemplateonsaving") = "P" then
		ll_prefsetting = 2
	elseif f_stringpreferences("applydoctortemplateonsaving") = "D" then
		ll_prefsetting = 3
	elseif f_stringpreferences("applydoctortemplateonsaving") = "C" then
		ll_prefsetting = 4
	elseif f_stringpreferences("applydoctortemplateonsaving") = "S" then
		ll_prefsetting = 5
	elseif f_stringpreferences("applydoctortemplateonsaving") = "T" then
		ll_prefsetting = 6
	else
		ll_prefsetting = 0
	end if
	lds_templatedetail = create datastore
	lds_templateheader = create datastore
	lds_templatedetail.dataobject = "d_servicetemplate_detail"
	lds_templatedetail.settransobject(this.it_transobject)
	lds_templateheader.dataobject = "d_servicetemplate_header"
	lds_templateheader.settransobject(this.it_transobject)
	ll_templateheaderrow = lds_templateheader.retrieve(ll_templatecode)
	if ll_templateheaderrow < 0 then
		messagebox(ls_msgtitle, "Associated Service Template Header Retrieval Problem", stopsign!)
		return 0
	else
		ll_templateheaderrow = lds_templateheader.rowcount()
		if ll_templateheaderrow = 0 then
			messagebox(ls_msgtitle, "Associated Service Template Does not Exist", stopsign!)
			return 0
		end if
	end if
	ll_templaterows = lds_templatedetail.retrieve(ll_templatecode)
	if ll_templaterows < 0 then
		messagebox(ls_msgtitle, "Associated Service Template Detail Retrieval Problem", stopsign!)
		return 0
	else
		ll_templaterows = lds_templatedetail.rowcount()
		if ll_templaterows = 0 then
			if ai_mode = 0 then
				messagebox(ls_msgtitle, "Associated Service Template contain no rows", stopsign!)
				return 0
			else
				return 1
			end if
			return
		end if
	end if
	setredraw(false)
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ll_found = 0
		ll_found = lds_templatedetail.find("icode = " + trim(string(ll_icode)), 1, ll_templaterows)
		if ll_found > 0 then
			ld_templatediscperc = lds_templatedetail.getitemnumber(ll_found, "discperc")
			ld_templateprice = lds_templatedetail.getitemnumber(ll_found, "saleprice")
			ld_template_flatdisc = lds_templatedetail.getitemnumber(ll_found, "serviceflatdisc")
			ld_template_shareperc = lds_templatedetail.getitemnumber(ll_found, "shareperc")
			ld_commission = lds_templatedetail.getitemnumber(ll_found, "commission")
			if ll_prefsetting >= 1 then
				if ll_prefsetting <= 2 or ll_prefsetting = 6 then
					this.id_detail.setitem(ll_rowcount, "saleprice", ld_templateprice)
				end if
				if ll_prefsetting = 1 or ll_prefsetting = 3 then
					this.id_detail.setitem(ll_rowcount, "discperc", ld_templatediscperc)
					this.id_detail.setitem(ll_rowcount, "serviceflatdisc", ld_template_flatdisc)
				end if
				if ll_prefsetting = 1 or ll_prefsetting = 4 or ll_prefsetting = 6 then
					this.id_detail.setitem(ll_rowcount, "commission", ld_commission)
				end if
				if ll_prefsetting = 1 or ll_prefsetting = 5 or ll_prefsetting = 6 then
					this.id_detail.setitem(ll_rowcount, "shareperc", ld_template_shareperc)
				end if
			end if
			ld_qty = this.id_detail.getitemnumber(ll_rowcount, "qty")
		else
			ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname
			ll_notfound_itemcount = ll_notfound_itemcount + 1
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_notfound_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Guidelines Exist for Following " + trim(string(ll_notfound_itemcount)) + " service(s) in Associated Template/Pricing Contract~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_service.wf_get_associated_templatecode(long al_doctcode) returns long
	long ll_retcode
	long ll_templatecode
	if al_doctcode = 0 or isnull(al_doctcode) then
		ll_retcode = -1
		return ll_retcode
	else
		SQL SELECT ServiceTemplateCode INTO :ll_templatecode FROM DBO.Doctors WHERE DoctCode =:al_doctcode USING sqlca;
		if sqlca.sqlcode = 0 then
			if ll_templatecode = 0 or isnull(ll_templatecode) then
				ll_retcode = 0
			else
				ll_retcode = ll_templatecode
			end if
		else
			ll_retcode = -2
		end if
	end if
	return ll_retcode

// w_service.wf_refreshitemslist_catwise() returns 0
	long ll_counter
	string ls_categories
	integer[] la_catcode
	s_arguements lstr_arg
	open(w_choose_servicecategory)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = -1 then
		return
	end if
	la_catcode = lstr_arg.ia_integerlist
	ls_categories = ""
	for ll_counter = 1 to upperbound(la_catcode)
		ls_categories = ls_categories + string(la_catcode[ll_counter]) + " , "
	next
	ls_categories = ls_categories + " 0 "
	f_retrieve_servicelist(this.id_itemslist, this.it_transobject)
	this.id_itemslist.setfilter("servicecatcode In (" + ls_categories + ")")
	this.id_itemslist.filter()
	wf_initialize_lookup_table()

// w_service.wf_refreshitemslist_itemname() returns 0
	s_popup_selection lstr_selection
	long ll_counter
	boolean lb_enablerestricted
	string ls_selection
	integer[] la_catcode
	open(w_popup_itemsearchcriteriaselection)
	lstr_selection = message.powerobjectparm
	if lstr_selection.l_code > 0 then
		ls_selection = lstr_selection.s_name2
		this.id_itemslist.reset()
		this.id_itemslist.setfilter("")
		this.id_itemslist.filter()
		f_retrieve_servicelist(this.id_itemslist, this.it_transobject)
		this.id_itemslist.setfilter("itemname LIKE '" + ls_selection + "'")
		this.id_itemslist.filter()
	end if
	wf_initialize_lookup_table()

// w_service.wf_set_customerbalance(long ll_custcode, long row) returns long
	long ll_counter
	char lc_fetchbalance
	double ld_customerbalance
	if this.ii_servicetype = 11 then
		lc_fetchbalance = f_stringpreferences("InServiceCustomerBalance")
	else
		lc_fetchbalance = f_stringpreferences("showcustomerbalanceincashservice")
	end if
	if lc_fetchbalance = "Y" then
		for ll_counter = 1 to this.ids_customersbalance.rowcount()
			if this.ids_customersbalance.getitemnumber(ll_counter, "code1") = this.id_master.getitemnumber(row, "custcode") then
				ld_customerbalance = this.ids_customersbalance.getitemnumber(ll_counter, "value1")
				this.id_master.setitem(row, "customerbalance", ld_customerbalance)
				if ld_customerbalance > 0.0 then
					this.id_master.setitem(row, "debitorcredit", "Dr")
				else
					this.id_master.setitem(row, "debitorcredit", "Cr")
				end if
				return 0
			else
				this.id_master.setitem(row, "debitorcredit", "Cr")
				this.id_master.setitem(row, "customerbalance", 0)
			end if
		next
	end if
	return 0

