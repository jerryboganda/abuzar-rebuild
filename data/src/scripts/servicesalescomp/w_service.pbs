// w_service.wf_setguestinfo(long al_code) returns long
	long ll_doctcode
	long ll_custcode
	long ll_retcode
	string ls_regno
	string ls_aliasname
	SQL SELECT Guest.RegNo , Guest.CustCode , Accounts.AliasName INTO :ls_regno, :ll_custcode, :ls_aliasname FROM Guest , Accounts WHERE Guest.GuestCode =:al_code AND Guest.Active ='Y' AND Guest.CustCode =Accounts.AccCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.setitem(this.id_master.rowcount(), "Guestregno", ls_regno)
		this.id_master.setitem(this.id_master.rowcount(), "custcode", ll_custcode)
		this.id_master.setitem(this.id_master.rowcount(), "aliasname", ls_aliasname)
		this.id_master.object.custcode.protect = 1
		this.id_master.object.aliasname.protect = 1
		wf_set_guestbalance(al_code)
		wf_set_customerbalance(this.id_master.object.custcode[this.id_master.rowcount()], this.id_master.rowcount())
		wf_enforce_custallowedservices(ll_custcode)
		ll_retcode = 1
	else
		messagebox("Guest Information", "Problem in retrieving corresponding customer")
		ll_retcode = 0
	end if
	return ll_retcode

// w_service.wf_findguestcode(string as_regno, long al_code) returns long
	long ll_guestcode
	long ll_retflag
	string ls_itemname
	char lc_active
	ll_retflag = 0
	SQL SELECT Guest.Guestcode , Guest.active INTO :ll_guestcode, :lc_active FROM Guest WHERE Guest.regno =:as_regno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_code = ll_guestcode
		if isnull(al_code) then
			ll_retflag = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
		else
			ll_retflag = -2
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

