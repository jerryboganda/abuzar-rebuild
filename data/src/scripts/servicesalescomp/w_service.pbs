// w_service.wf_enforce_custallowedservices(long al_custcode) returns long
	long ll_counter
	string ls_servicelist
	u_ds_standard lds_ccustallowedservice
	if f_stringpreferences("Enforce_Customer_Allowed_Services") = "N" then
		return 0
	end if
	if isnull(al_custcode) then
		this.id_itemslist.setfilter("")
		this.id_itemslist.filter()
		return 0
	end if
	lds_ccustallowedservice = create u_ds_standard
	lds_ccustallowedservice.dataobject = "d_custallowedservice_detail"
	lds_ccustallowedservice.settransobject(this.it_transobject)
	lds_ccustallowedservice.retrieve(al_custcode)
	for ll_counter = 1 to lds_ccustallowedservice.rowcount()
		if ls_servicelist <> "" then
			ls_servicelist = ls_servicelist + ","
		end if
		ls_servicelist = ls_servicelist + trim(string(lds_ccustallowedservice.object.icode[ll_counter]))
	next
	if ls_servicelist = "" then
		ls_servicelist = "icode < 0 "
	else
		ls_servicelist = "icode IN (" + ls_servicelist + ")"
	end if
	this.id_itemslist.setfilter(ls_servicelist)
	this.id_itemslist.filter()
	return 0

// w_service.wf_check_custallowedservices() returns long
	long ll_counter
	long ll_custcode
	long ll_found
	long ll_servicecode
	string ls_itemname
	u_ds_standard lds_ccustallowedservice
	if f_stringpreferences("Enforce_Customer_Allowed_Services") = "N" then
		return 0
	end if
	if this.id_master.rowcount() > 0 then
		ll_custcode = this.id_master.object.custcode[1]
	end if
	if isnull(ll_custcode) then
		messagebox("Customer Validation", "Please select a valid customer for this sales invoice", stopsign!)
		return -1
	end if
	lds_ccustallowedservice = create u_ds_standard
	lds_ccustallowedservice.dataobject = "d_custallowedservice_detail"
	lds_ccustallowedservice.settransobject(this.it_transobject)
	lds_ccustallowedservice.retrieve(ll_custcode)
	for ll_counter = 1 to this.id_detail.rowcount()
		ll_servicecode = this.id_detail.object.icode[ll_counter]
		ls_itemname = this.id_detail.object.itemname[ll_counter]
		if isnull(ls_itemname) then
			ls_itemname = ""
		end if
		if ll_servicecode > 0 then
			ll_found = lds_ccustallowedservice.find("icode = " + trim(string(ll_servicecode)), 1, lds_ccustallowedservice.rowcount())
			if not (ll_found > 0 and ll_found <= lds_ccustallowedservice.rowcount()) then
				messagebox("Service Validation", "Service Name = " + ls_itemname + "~r~nThis service is not allowed in the customer allowed list.~r~nKindly Consult your administrator to do the needfull.", stopsign!)
				this.id_detail.setrow(ll_counter)
				this.id_detail.setcolumn("itemname")
				return -1
			end if
			return
		end if
	next
	return 0

// w_service.wf_generate_from_studentservicetemplate() returns long
