// w_service.wf_setimage(string as_caller) returns long
	long ll_counter
	long ll_code
	long ll_row
	long ll_patientcode
	long ll_null
	s_itemimage lstr_image
	lstr_image.s_caller = as_caller
	setnull(ll_null)
	if this.id_master.rowcount() > 0 then
		ll_patientcode = this.id_master.object.patientcode[1]
	end if
	if ll_patientcode > 0 then
		for ll_counter = 1 to this.dw_image.rowcount()
			lstr_image.ls_value[ll_counter, 1] = trim(string(this.dw_image.object.rowid[ll_counter]))
			lstr_image.ls_value[ll_counter, 2] = this.dw_image.object.imagedescription[ll_counter]
			lstr_image.ls_value[ll_counter, 3] = this.dw_image.object.imagetype[ll_counter]
			lstr_image.blob[ll_counter] = this.istr_image.blob[ll_counter]
		next
		openwithparm(w_patientimage, lstr_image)
		lstr_image = message.powerobjectparm
		if lstr_image.i_closemode = 1 then
			this.istr_image = lstr_image
			this.dw_image.reset()
			ll_code = ll_patientcode
			for ll_counter = 1 to 200
				if long(lstr_image.ls_value[ll_counter, 1]) > 0 then
					ll_row = this.dw_image.insertrow(0)
					this.dw_image.object.code[ll_row] = ll_code
					this.dw_image.object.admissioncode[ll_row] = ll_null
					this.dw_image.object.visitcode[ll_row] = ll_null
					this.dw_image.object.rowid[ll_row] = long(lstr_image.ls_value[ll_counter, 1])
					this.dw_image.object.imagedescription[ll_row] = lstr_image.ls_value[ll_counter, 2]
					this.dw_image.object.imagetype[ll_row] = lstr_image.ls_value[ll_counter, 3]
				end if
			next
		end if
	end if
	return 0

// w_service.wf_update_image() returns long
	long ll_counter
	long ll_code
	long ll_rowid
	long ll_patientcode
	long ll_null
	string ls_desc
	string ls_imgtype
	u_transaction lt_transobject
	setnull(ll_null)
	if this.id_master.rowcount() > 0 then
		ll_code = this.id_master.object.code[1]
		ll_patientcode = this.id_master.object.patientcode[1]
	end if
	if ll_code > 0 and this.dw_image.rowcount() = 0 then
		return 0
	end if
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server for updating/inserting in PatientImage Table")
		destroy lt_transobject
		return -1
	end if
	SQL DELETE PatientImage WHERE PatientCode =:ll_patientcode USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to Delete Previous Patient Image Record from database")
		destroy lt_transobject
		return -1
	end if
	for ll_counter = 1 to this.dw_image.rowcount()
		ll_rowid = this.dw_image.object.rowid[ll_counter]
		ls_desc = this.dw_image.object.imagedescription[ll_counter]
		ls_imgtype = this.dw_image.object.imagetype[ll_counter]
		SQL INSERT INTO PatientImage ( Patientcode , ImageDescription , RowID , ImageType , AdmissionCode , visitcode ) VALUES ( :ll_patientcode , :ls_desc , :ll_rowid , :ls_imgtype , :ll_null , :ll_null ) USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Insert Error", "Unable to Insert Patient Images Into Patient Image Table.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
			SQL stop USING lt_transobject;
			destroy lt_transobject
			return -1
		end if
		SQL UpdateBlob PatientImage Set PatientImage =:this.istr_image.blob[ll_counter] Where Patientcode =:ll_patientcode and ROWID =:ll_rowid USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Patient Image ", "Unable to update Patient image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		end if
	next
	SQL stop USING lt_transobject;
	destroy lt_transobject
	return 0

// w_service.wf_get_image(long al_row, long al_patientcode) returns long
	blob lbl_image
	u_transaction lt_transobject
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server")
		destroy lt_transobject
		return -1
	end if
	SQL SelectBlob PatientImage INTO :lbl_image From PatientImage Where Patientcode =:al_patientcode AND RowID =:al_row USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Patient Image/Picture ", "Unable to fetch patient Image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	this.istr_image.blob[al_row] = lbl_image
	return 0

// w_service.wf_populate_image(long al_patientcode) returns long
	long ll_counter
	long ll_rowcount
	long ll_code
	ll_rowcount = this.dw_image.rowcount()
	if ll_rowcount <= 0 then
		return 0
	end if
	if isnull(al_patientcode) or al_patientcode <= 0 then
		return 0
	end if
	ll_code = this.dw_image.object.code[1]
	for ll_counter = 1 to ll_rowcount
		this.istr_image.ls_value[ll_counter, 1] = trim(string(this.dw_image.object.rowid[ll_counter]))
		this.istr_image.ls_value[ll_counter, 2] = this.dw_image.object.imagedescription[ll_counter]
		this.istr_image.ls_value[ll_counter, 3] = this.dw_image.object.imagetype[ll_counter]
		wf_get_image(ll_counter, al_patientcode)
	next
	return 0

// w_service.wf_show_appointments() returns long
	long ll_code
	long ll_temp
	long ll_doctcode
	long ll_patientcode
	datetime ldt_mindate
	datetime ldt_maxdate
	datetime ldt_duedate
	date ld_date
	s_arguements lstr_arg
	ld_date = today()
	ldt_mindate = datetime(ld_date, time("00:00:00"))
	ldt_maxdate = datetime(ld_date, time("23:59:59"))
	ll_doctcode = this.id_master.object.doctcode[1]
	lstr_arg.i_status = 1
	lstr_arg.l_code1 = ll_doctcode
	lstr_arg.d_sdate = ldt_mindate
	lstr_arg.d_edate = ldt_maxdate
	openwithparm(w_appointments_for_a_period, lstr_arg)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 and lstr_arg.l_code2 > 0 then
		ll_patientcode = lstr_arg.l_code2
		this.id_master.object.patientregno[1] = lstr_arg.s_name1
		this.id_master.object.patientcode[1] = lstr_arg.l_code2
		wf_findpatientcode(lstr_arg.s_name1, ll_patientcode)
		wf_setpatientinfo(ll_patientcode)
	end if
	return 0

// w_service.wf_validate_patient_from_outside(string as_regno) returns long
	u_transaction it_mytrans
	string ls_name
	string ls_regno
	string ls_city
	string ls_nic
	string ls_customer
	string ls_patient
	string ls_ref
	long ll_patientcode
	long ll_relationcode
	long ll_doctcode
	long ll_wardcode
	long ll_recperiod
	long ll_prow
	long ll_found
	long ll_pcode
	it_mytrans = create u_transaction
	SQL start USING it_mytrans;
	it_mytrans.validate_patient_from_outside(as_regno)
	if it_mytrans.sqlcode = 0 then
		SQL commit USING it_mytrans;
	else
		SQL rollback USING it_mytrans;
	end if
	if this.ic_retrievepatientlist = "N" then
		SQL SELECT Name =P.name , Regno =P.regno , patientcode =P.patientcode , City =P.city , NIC =P.NationalIDCard , relationcode =P.relationcode , doctcode =P.doctcode , wardcode =P.wardcode , customer =A.name , patient =LTRIM ( RTRIM ( P.Name ) ) + ' (' + LTRIM ( RTRIM ( P.RegNo ) ) + ')' , RecurringPeriod =ISNULL ( P.RecurringPeriod , 0 ) , Reference =P.Reference INTO :ls_name, :ls_regno, :ll_patientcode, :ls_city, :ls_nic, :ll_relationcode, :ll_doctcode, :ll_wardcode, :ls_customer, :ls_patient, :ll_recperiod, :ls_ref FROM Patient P , Accounts A WHERE P.RegNo =:as_regno AND P.CustCode =A.AccCode USING it_mytrans;
		if it_mytrans.sqlcode = 0 then
			ll_found = this.idc_patient.find("regno = '" + as_regno + "'", 1, this.idc_patient.rowcount())
			if ll_found > 0 and ll_found <= this.idc_patient.rowcount() then
				ll_prow = ll_found
			else
				ll_prow = this.idc_patient.insertrow(0)
			end if
			setnull(ll_pcode)
			this.idc_patient.setitem(ll_prow, "name", ls_name)
			this.idc_patient.setitem(ll_prow, "regno", ls_regno)
			this.idc_patient.setitem(ll_prow, "patientcode", ll_patientcode)
			this.idc_patient.setitem(ll_prow, "city", ls_city)
			this.idc_patient.setitem(ll_prow, "nic", ls_nic)
			this.idc_patient.setitem(ll_prow, "relationcode", ll_relationcode)
			this.idc_patient.setitem(ll_prow, "doctcode", ll_doctcode)
			this.idc_patient.setitem(ll_prow, "wardcode", ll_wardcode)
			this.idc_patient.setitem(ll_prow, "customer", ls_customer)
			this.idc_patient.setitem(ll_prow, "patient", ls_patient)
			this.idc_patient.setitem(ll_prow, "RecurringPeriod", ll_recperiod)
			this.idc_patient.setitem(ll_prow, "Reference", ls_ref)
			this.idc_patient.scrolltorow(ll_prow)
			this.id_master.setredraw(false)
			this.id_master.object.patientcode[1] = ll_patientcode
			this.id_master.setredraw(true)
		end if
	else
		this.idc_patient.retrieve(this.ii_patientmodule)
	end if
	this.idc_patient.setredraw(true)
	destroy it_mytrans
	return 0

// w_service.wf_find_patient_by_phone() returns integer
	long ll_null
	string ls_null
	string ls_regno
	s_arguements lstr_arg
	long ll_totpatients
	u_ds_standard lds_patients
	setnull(ll_null)
	setnull(ls_null)
	open(w_arg_phoneno)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		lds_patients = create u_ds_standard
		lds_patients.dataobject = "ddd_patientbyphoneno"
		lds_patients.settransobject(this.it_transobject)
		lds_patients.retrieve(lstr_arg.s_name1)
		ll_totpatients = lds_patients.rowcount()
		if ll_totpatients <> 0 then
			if ll_totpatients = 1 then
				lstr_arg.l_code1 = lds_patients.object.patientcode[1]
				wf_setpatientinfo(lstr_arg.l_code1)
				ls_regno = lds_patients.object.regno[1]
				wf_validate_patient_from_outside(ls_regno)
				this.id_master.object.patientregno[1] = lds_patients.object.regno[1]
				this.id_master.object.patientcode[1] = lds_patients.object.patientcode[1]
				this.id_master.object.custcode[1] = lds_patients.object.custcode[1]
			else
				openwithparm(w_patientphonesearchresult, lstr_arg)
				lstr_arg = message.powerobjectparm
				if lstr_arg.i_status = 1 then
					this.id_master.object.patientcode[1] = lstr_arg.l_code1
					this.id_master.object.patientregno[1] = lstr_arg.s_name1
					this.id_master.object.custcode[1] = lstr_arg.l_code2
					wf_setpatientinfo(lstr_arg.l_code1)
					ls_regno = lstr_arg.s_name1
					wf_validate_patient_from_outside(ls_regno)
				end if
			end if
		end if
	end if
	return 0

// w_service.wf_patientsearch() returns string
	string ls_regno
	long ll_res
	long ll_null
	long ll_patientcode
	s_arguements ls_arguements
	setnull(ll_null)
	open(w_patientsearch)
	ls_arguements = message.powerobjectparm
	if ls_arguements.i_status = 1 then
		openwithparm(w_patientsearchresult, ls_arguements)
		ls_arguements = message.powerobjectparm
		if ls_arguements.i_status = 1 and ls_arguements.l_code1 > 0 then
			this.id_master.object.patientregno[1] = ls_arguements.s_name1
			this.id_master.object.patientcode[1] = ls_arguements.l_code1
			this.id_master.object.custcode[1] = ls_arguements.l_code4
			ll_patientcode = ls_arguements.l_code1
			wf_setpatientinfo(ll_patientcode)
			ls_regno = this.id_master.object.patientregno[1]
			wf_validate_patient_from_outside(ls_regno)
		end if
	end if
	return ls_regno

// w_service.wf_set_headersetting() returns long
	integer li_rtncode
	long ll_counter
	long ll_found
	datastore lds_headers
	datawindowchild ldc_headerno
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	li_rtncode = lds_headers.retrieve(this.il_groupcode, this.ii_module)
	if li_rtncode <= 0 then
		return li_rtncode
	end if
	if lds_headers.rowcount() > 0 then
		this.id_master.object.headerno.initial = string(lds_headers.getitemnumber(1, "headercode"))
		this.id_master.setitem(1, "headerno", this.id_master.object.headerno.initial)
		this.id_master.getchild("headerno", ldc_headerno)
		for ll_counter = 1 to lds_headers.rowcount()
			ldc_headerno.insertrow(0)
			ldc_headerno.setitem(ll_counter, "code", lds_headers.getitemnumber(ll_counter, "headercode"))
			ll_found = 0
			ll_found = gds_reoprtheaderinfo.find("headerno=" + string(lds_headers.getitemnumber(ll_counter, "headercode")), 1, gds_reoprtheaderinfo.rowcount())
			if ll_found > 0 then
				ldc_headerno.setitem(ll_counter, "name", gds_reoprtheaderinfo.getitemstring(ll_found, "clientname"))
				if isnull(gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks")) then
					ldc_headerno.setitem(ll_counter, "headeralias", trim(string(gds_reoprtheaderinfo.getitemnumber(ll_found, "headerno"))))
				else
					ldc_headerno.setitem(ll_counter, "headeralias", trim(gds_reoprtheaderinfo.getitemstring(ll_found, "Remarks")) + " (" + trim(string(gds_reoprtheaderinfo.getitemnumber(ll_found, "headerno"))) + ")")
				end if
			end if
		next
	end if
	return 1

// w_service.wf_enforce_pricerange_onsaving() returns long
	long ll_counter
	long ll_servicecode
	double ld_saleprice
	double ld_minprice
	double ld_maxprice
	if f_stringpreferences("EnforceServicPriceLimit") = "Y" then
		for ll_counter = 1 to this.id_detail.rowcount()
			ll_servicecode = this.id_detail.object.icode[ll_counter]
			ld_saleprice = this.id_detail.object.saleprice[ll_counter]
			if ll_servicecode > 0 then
				SQL SELECT MinPrice , MaxPrice INTO :ld_minprice, :ld_maxprice FROM Service WHERE ServiceCode =:ll_servicecode USING this.it_transobject;
				if this.it_transobject.sqlcode = 0 then
					if ld_saleprice < ld_minprice then
						messagebox("Service Price Validation", "Min. Price Limit Violation.~r~nService Price can not be less than minimum price limit~r~nMinimum Price Limit = " + string(ld_minprice), stopsign!)
						this.id_detail.setcolumn("saleprice")
						this.id_detail.setrow(ll_counter)
						return -1
					end if
					if ld_saleprice > ld_maxprice then
						messagebox("Service Price Validation", "Max. Price Limit Violation.~r~nService Price can not be more than maximum price limit~r~nMaximum Price Limit = " + string(ld_maxprice), stopsign!)
						this.id_detail.setcolumn("saleprice")
						this.id_detail.setrow(ll_counter)
						return -1
					end if
				else
					messagebox("Service Price Validation", "Price Limit Validation Error.~r~nDetails are~r~n" + this.it_transobject.sqlerrtext, stopsign!)
					this.id_detail.setcolumn("saleprice")
					this.id_detail.setrow(ll_counter)
					return -1
				end if
				return
			end if
		next
	end if
	return 0

// w_service.wf_find_tokenable_services() returns long
	long ll_counter
	long ll_servicecode
	long ll_rowcount
	long ll_retcode
	string ls_tokenable
	ll_rowcount = this.id_detail.rowcount()
	for ll_counter = 1 to ll_rowcount
		ll_servicecode = this.id_detail.object.icode[ll_counter]
		if ll_servicecode > 0 then
			SQL SELECT UPPER ( Tokenable ) INTO :ls_tokenable FROM Service WHERE ServiceCode =:ll_servicecode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ls_tokenable = "Y" then
					ll_retcode = 1
					return ll_retcode
				end if
			else
				ll_retcode = -1
			end if
		end if
	next
	return ll_retcode

// w_service.wf_findpatientcode(string as_regno, long ai_patientcode) returns long
	long ll_patientcode
	long ll_retflag
	long ll_found
	long ll_counter
	long ll_custcode
	string ls_itemname
	string ls_autopatientreg
	string ls_enforce_cellno_in_patientreg
	string ls_regno
	string ls_thischar
	char lc_active
	ls_autopatientreg = f_stringpreferences("AutoRegisterPatient")
	ls_enforce_cellno_in_patientreg = f_stringpreferences("EnforceCellNoInPatientReg")
	ll_retflag = 0
	SQL SELECT patient.patientcode , patient.active INTO :ll_patientcode, :lc_active FROM patient WHERE patient.regno =:as_regno and patientcatcode in ( select distinct patientcatcode from patientcatallowedmodule where moduleid =:this.ii_patientmodule ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ai_patientcode = ll_patientcode
		if isnull(ai_patientcode) then
			ll_retflag = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
		else
			ll_retflag = -2
		end if
	elseif this.it_transobject.sqlcode = 100 then
		if isnull(ll_patientcode) or ll_patientcode = 0 then
			if ls_autopatientreg = "Y" and ls_enforce_cellno_in_patientreg = "Y" then
				for ll_counter = 1 to len(as_regno)
					ls_thischar = mid(as_regno, ll_counter, 1)
					if not (asc(ls_thischar) >= 48 and asc(ls_thischar) <= 57) then
						messagebox("Patient Reg. No. Validation", "Please enter valid cell no. as Patient Reg. No.", stopsign!)
						ll_retflag = -3
						return ll_retflag
					end if
				next
				if len(as_regno) < 11 then
					messagebox("Patient Reg. No. Validation", "Please enter valid cell no. as Patient Reg. No.", stopsign!)
					ll_retflag = -3
					return ll_retflag
				end if
				return
			end if
			if ls_autopatientreg = "Y" then
				ll_custcode = this.id_master.object.custcode[1]
				ls_regno = as_regno + "«" + trim(string(ll_custcode))
				openwithparm(w_simple_patientregistration, ls_regno)
				ls_regno = message.stringparm
				if not (ls_regno = "" or isnull(ls_regno)) then
					wf_patient_retrieve()
					ll_found = 0
					ll_found = this.idc_patient.find("regno = '" + ls_regno + "'", 1, this.idc_patient.rowcount())
					if ll_found > 0 then
						ll_patientcode = this.idc_patient.getitemnumber(ll_found, "patientcode")
						ai_patientcode = ll_patientcode
						this.id_master.setitem(1, "patientcode", ll_patientcode)
					end if
				end if
			else
				ll_retflag = -1
			end if
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_service.wf_show_serviceinvpurtemplate() returns 0
	long ll_serviceinvcode
	long ll_custcode
	long ll_null
	long ll_patientcode
	long ll_currlistrow
	string ls_posted
	if wf_iseditable() = true then
		return
	end if
	setnull(ll_null)
	if this.id_list.rowcount() <= 0 or this.id_list.getrow() <= 0 then
		return
	end if
	ll_currlistrow = this.id_list.getrow()
	if this.id_list.rowcount() > 0 and ll_currlistrow > 0 then
		ll_serviceinvcode = this.id_list.object.code[ll_currlistrow]
		ll_custcode = this.id_list.object.custcode[ll_currlistrow]
		ll_patientcode = this.id_list.object.patientcode[ll_currlistrow]
		if isnull(ll_custcode) or ll_custcode = 0 then
			messagebox("Customer Validation", "Please Select a customer first")
			return
		end if
		if ll_serviceinvcode > 0 then
			SQL SELECT Posted INTO :ls_posted FROM ServiceInvPurTempHeader WHERE ServiceInvcode =:ll_serviceinvcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				this.istr_buffer.i_status = 1
				this.istr_buffer.l_code1 = this.id_list.object.code[this.id_list.getrow()]
				this.istr_buffer.l_code2 = ll_null
				this.istr_buffer.l_code3 = ll_custcode
				this.istr_buffer.l_code4 = 0
				this.istr_buffer.l_code5 = ll_patientcode
				this.istr_buffer.s_name1 = ls_posted
				openwithparm(w_serviceinvpurtemplate_popup, this, this)
			end if
		end if
	end if

// w_service.wf_motorvehicle_retrieve() returns long
	long ll_row
	long ll_code
	this.idc_motorvehicle.settransobject(this.it_transobject)
	this.idc_motorvehicle.retrieve()
	ll_row = this.idc_motorvehicle.insertrow(0)
	setnull(ll_code)
	this.idc_motorvehicle.setitem(ll_row, "code", ll_code)
	this.idc_motorvehicle.setitem(ll_row, "chasisno", "<NONE>")
	this.idc_motorvehicle.setitem(ll_row, "motorvehicle", "<NONE>")
	this.idc_motorvehicle.setitem(ll_row, "customer", "<NONE>")
	this.idc_motorvehicle.scrolltorow(ll_row)
	return 0

// w_service.wf_find_motorvehiclecode(string as_chasisno, long al_code) returns integer
	long ll_motorvehiclecode
	long ll_retflag
	ll_retflag = 0
	SQL SELECT motorvehiclecode INTO :ll_motorvehiclecode FROM motorvehicle WHERE chasisno =:as_chasisno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_code = ll_motorvehiclecode
		if isnull(al_code) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_service.wf_set_motorvehicleinfo(long al_code) returns long
	long ll_custcode
	long ll_retcode
	string ls_chasisno
	string ls_aliasname
	SQL SELECT MotorVehicle.ChasisNo , MotorVehicle.CustCode , Accounts.AliasName INTO :ls_chasisno, :ll_custcode, :ls_aliasname FROM MotorVehicle , Accounts WHERE MotorVehicle.MotorVehicleCode =:al_code AND MotorVehicle.CustCode =Accounts.AccCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.setitem(this.id_master.rowcount(), "chasisno", ls_chasisno)
		this.id_master.setitem(this.id_master.rowcount(), "custcode", ll_custcode)
		this.id_master.setitem(this.id_master.rowcount(), "aliasname", ls_aliasname)
		this.id_master.object.custcode.protect = 1
		this.id_master.object.aliasname.protect = 1
		ll_retcode = 1
	else
		messagebox("Motor Vehicle Information", "Problem in retrieving corresponding customer")
		ll_retcode = 0
	end if
	return ll_retcode

// w_service.wf_motorvehiclesearch() returns string
	string ls_chasisno
	long ll_res
	long ll_null
	long ll_code
	s_arguements ls_arguements
	setnull(ll_null)
	open(w_vehiclesearch)
	ls_arguements = message.powerobjectparm
	if ls_arguements.i_status = 1 then
		openwithparm(w_vehiclesearchresult, ls_arguements)
		ls_arguements = message.powerobjectparm
		if ls_arguements.i_status = 1 and ls_arguements.l_code1 > 0 then
			this.id_master.object.chasisno[1] = ls_arguements.s_name1
			this.id_master.object.motorvehiclecode[1] = ls_arguements.l_code1
			this.id_master.object.custcode[1] = ls_arguements.l_code2
			ll_code = ls_arguements.l_code1
			wf_set_motorvehicleinfo(ll_code)
			ls_chasisno = this.id_master.object.chasisno[1]
		end if
	end if
	return ls_chasisno

// w_service.wf_new_motorvehicle() returns long
	string ls_chasisno
	long ll_motorvehiclecode
	long ll_found
	long ll_row
	dwobject dwo
	open(w_motorvehicle)
	ls_chasisno = message.stringparm
	if len(ls_chasisno) > 0 then
		wf_motorvehicle_retrieve()
		ll_found = 0
		ll_found = this.idc_motorvehicle.find("chasisno = '" + ls_chasisno + "'", 1, this.idc_motorvehicle.rowcount())
		if ll_found > 0 then
			this.id_master.setitem(1, "chasisno", this.idc_motorvehicle.getitemstring(ll_found, "chasisno"))
			ll_motorvehiclecode = this.idc_motorvehicle.getitemnumber(ll_found, "code")
			this.id_master.setitem(1, "motorvehiclecode", ll_motorvehiclecode)
			dwo = this.id_master.object.motorvehiclecode
			this.id_master.post event itemchanged(1, dwo, string(ll_motorvehiclecode))
		end if
	end if
	return 0

// w_service.wf_link_to_cashiershift() returns long
	long ll_cashiershiftcode
	if f_stringpreferences("CashierShift") = "Y" then
		this.id_master.object.cashiershiftcode.visible = true
		SQL SELECT MAX ( A.CashierShiftCode ) INTO :ll_cashiershiftcode FROM ( SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND ShiftOwner =:gl_usercode UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShiftUsers WHERE UserCode =:gl_usercode AND CashierShiftCode IN ( SELECT MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' ) ) A USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if ll_cashiershiftcode < 0 then
				ll_cashiershiftcode = -1
			end if
		else
			ll_cashiershiftcode = -1
		end if
	else
		ll_cashiershiftcode = -1
	end if
	if ll_cashiershiftcode = -1 then
		setnull(ll_cashiershiftcode)
	end if
	this.id_master.object.cashiershiftcode[1] = ll_cashiershiftcode
	return 0

// w_service.wf_check_cashiershift_on_saving(long al_cashiershiftcode, long al_usercode) returns long
	long ll_cashiershiftcode
	long ll_cashacccode
	if f_stringpreferences("CashierShift") = "Y" then
		this.id_master.object.cashiershiftcode.visible = true
		SQL SELECT MAX ( A.CashierShiftCode ) INTO :ll_cashiershiftcode FROM ( SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND ShiftOwner =:al_usercode AND CashierShiftCode =:al_cashiershiftcode UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShiftUsers WHERE UserCode =:al_usercode AND CashierShiftCode IN ( SELECT MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND CashierShiftCode =:al_cashiershiftcode ) UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' AND ShiftOwner =:al_usercode UNION SELECT CashierShiftCode =MAX ( CashierShiftCode ) FROM CashierShiftUsers WHERE UserCode =:al_usercode AND CashierShiftCode IN ( SELECT MAX ( CashierShiftCode ) FROM CashierShift WHERE ShiftStatus ='O' ) ) A USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if ll_cashiershiftcode < 0 then
				ll_cashiershiftcode = -1
			end if
		else
			ll_cashiershiftcode = -1
		end if
	else
		ll_cashiershiftcode = -1
	end if
	if ll_cashiershiftcode = -1 then
		setnull(ll_cashiershiftcode)
	end if
	this.id_master.object.cashiershiftcode[1] = ll_cashiershiftcode
	if ll_cashiershiftcode > 0 then
		SQL SELECT CashAccCode INTO :ll_cashacccode FROM CashierShift WHERE CashierShiftCode =:ll_cashiershiftcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.id_master.object.cashacccode[1] = ll_cashacccode
		end if
	end if
	if f_stringpreferences("CashierShift") = "Y" and isnull(ll_cashiershiftcode) then
		messagebox("Cashier Shift Linkage Missing", "Cashier Shift Linkage Missing~r~nContact System Administrator and try again.", stopsign!)
		return -1
	end if
	return 0

// w_service.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_servicemenu" then
		this.menuid = create m_servicemenu
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	this.dw_saleinvdetail = create dw_saleinvdetail
	this.dw_servicestatus = create dw_servicestatus
	this.dw_serviceticket = create dw_serviceticket
	this.dw_image = create dw_image
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.dw_saleinvdetail
	this.control[icurrent + 3] = this.dw_servicestatus
	this.control[icurrent + 4] = this.dw_serviceticket
	this.control[icurrent + 5] = this.dw_image

// w_service.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.dw_saleinvdetail
	destroy this.dw_servicestatus
	destroy this.dw_serviceticket
	destroy this.dw_image

// w_service.ue_save() returns 0 [event]
	long ll_detailrows
	long ll_saveresult
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_stock
	long ll_newstock
	long ll_icode
	long ll_salelooseqty
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode
	long ll_gcode
	long ll_headerno
	long ll_headerinvno
	long ll_counter
	long ll_count
	long ll_statusrow
	long ll_custcode
	long ll_patientcode
	long ll_guestcode
	long ll_guestcheckincode
	long ll_studentcode
	long ll_doctcode
	long ll_serviceresultcode
	long ll_null
	boolean lb_commitflag
	boolean lb_continue
	integer li_counter
	integer li_tokenno
	string ls_errtext
	string ls_invlist
	string ls_posted
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	double ld_cashreceived
	double ld_serviceinvgstperc
	datetime ldt_server_datetime
	string ls_date_errtext
	setnull(ll_patientcode)
	setnull(ll_guestcode)
	setnull(ll_studentcode)
	setnull(ll_null)
	this.ib_commitok = false
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.ib_godownvalidated = false and wf_validategodown() = -1 then
		return
	end if
	wf_deleteemptydetailrow()
	if this.ii_servicetype = 11 then
		if f_stringpreferences("CreditServiceAllowNullPatient") = "N" then
			this.id_master.object.patientcode.dddw.required = "YES"
		else
			this.id_master.object.patientcode.dddw.required = "NO"
		end if
		if f_stringpreferences("CreditServiceAllowNullGuest") = "N" then
			this.id_master.object.guestcode.dddw.required = "YES"
		else
			this.id_master.object.guestcode.dddw.required = "NO"
		end if
		if f_stringpreferences("CreditServiceAllowNullStudent") = "N" then
			this.id_master.object.studentcode.dddw.required = "YES"
		else
			this.id_master.object.studentcode.dddw.required = "NO"
		end if
	else
		if f_stringpreferences("CashServiceAllowNullPatient") = "N" then
			this.id_master.object.patientcode.dddw.required = "YES"
		else
			this.id_master.object.patientcode.dddw.required = "NO"
		end if
		if f_stringpreferences("CashServiceAllowNullGuest") = "N" then
			this.id_master.object.guestcode.dddw.required = "YES"
		else
			this.id_master.object.guestcode.dddw.required = "NO"
		end if
		if f_stringpreferences("CashServiceAllowNullStudent") = "N" then
			this.id_master.object.studentcode.dddw.required = "YES"
		else
			this.id_master.object.studentcode.dddw.required = "NO"
		end if
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	wf_grandtotal()
	if this.ii_servicetype = 11 and this.id_master.getitemnumber(this.id_master.getrow(), "custcode") = 19.0 then
		messagebox("Customer Validation!", "Cash Sale Walking Customer is not allowed in Credit Service")
		this.id_master.setcolumn("custcode")
		this.id_master.setfocus()
		return
	end if
	if f_stringpreferences("applydoctortemplateonsaving") <> "N" then
		if wf_apply_associated_doctor_tempate(1) <= 0 then
			messagebox("Doctor Associated Service Template", "Problem in using Doctor Associated Service Template")
			this.id_master.setfocus()
			this.id_master.setcolumn("doctcode")
			return
		end if
	end if
	if f_stringpreferences("applycustomertemplateonsaving") <> "N" then
		if wf_apply_associated_customer_tempate(1) <= 0 then
			messagebox("Customer Associated Service Template", "Problem in using Customer Associated Service Template")
			this.id_master.setfocus()
			this.id_master.setcolumn("custcode")
			return
		end if
	end if
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "total") < 0.0 then
		messagebox("Invoice Total Validation", "Invoice total can not be negative")
		return
	end if
	if this.id_footer.getitemnumber(this.id_footer.getrow(), "cashreceived") < 0.0 then
		messagebox("Cash Received Validation", "Cash Received can not be negative")
		this.id_footer.setcolumn("cashreceived")
		this.id_footer.setfocus()
		return
	end if
	if wf_check_custallowedservices() < 0 then
		return
	end if
	if wf_enforce_pricerange_onsaving() < 0 then
		return
	end if
	if wf_checkservicecharges() = false then
		return
	end if
	if f_stringpreferences("ForcePricePolicyOnSavingService") = "Y" and wf_apply_pricepolicy(1) <= 0 then
		messagebox("Price Policy Implementation", "Problem in Applying Service Price Policy on Saving")
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	wf_setguestcheckin()
	if wf_set_cashaccount() = 0 then
		return
	end if
	if f_stringpreferences("ServiceSalesManWindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	wf_grandtotal()
	if ll_salesmancode > 0 then
		if wf_check_cashiershift_on_saving(this.id_master.object.cashiershiftcode[1], ll_salesmancode) < 0 then
			return
		end if
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		if wf_validate_price_discount_matters(ll_salesmancode) < 0 then
			return
		end if
		ll_patientcode = this.id_master.object.patientcode[ll_mastercurrrow]
		ll_guestcode = this.id_master.object.guestcode[ll_mastercurrrow]
		ll_studentcode = this.id_master.object.studentcode[ll_mastercurrrow]
		ls_posted = this.id_master.object.posted[ll_mastercurrrow]
		if wf_check_lockerstatus() < 0 then
			return
		end if
		if wf_show_mastercashierwindow() = 0 then
			return
		end if
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if isnull(ll_invid) then
			wf_tabnewid("ServiceHeader", ll_invid)
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
		end if
		ll_headerno = this.id_master.getitemnumber(ll_mastercurrrow, "headerno")
		ll_headerinvno = this.id_master.getitemnumber(ll_mastercurrrow, "headerinvno")
		if isnull(ll_headerinvno) then
			f_generateheaderinvcode(ll_headerno, this.ii_module, ll_headerinvno)
			if ll_headerinvno > 0 then
				this.id_master.setitem(ll_mastercurrrow, "headerinvno", ll_headerinvno)
			end if
		end if
		ld_misccharges = this.id_footer.getitemnumber(ll_footercurrrow, "misccharges")
		ld_invdiscperc = this.id_footer.getitemnumber(ll_footercurrrow, "invdiscperc")
		ld_flatdisc = this.id_footer.getitemnumber(ll_footercurrrow, "flatdisc")
		ld_cashreceived = this.id_footer.getitemnumber(ll_footercurrrow, "cashreceived")
		ll_custcode = this.id_master.getitemnumber(ll_mastercurrrow, "custcode")
		ll_doctcode = this.id_master.getitemnumber(ll_mastercurrrow, "doctcode")
		ld_serviceinvgstperc = this.id_footer.getitemnumber(ll_mastercurrrow, "serviceinvgstperc")
		this.id_master.setitem(ll_mastercurrrow, "discperc", ld_invdiscperc)
		this.id_master.setitem(ll_mastercurrrow, "flatdisc", ld_flatdisc)
		this.id_master.setitem(ll_mastercurrrow, "serviceinvgstperc", ld_serviceinvgstperc)
		this.id_master.setitem(ll_mastercurrrow, "misccharges", ld_misccharges)
		this.id_master.setitem(ll_mastercurrrow, "invtotal", wf_grandtotal())
		if this.ii_servicetype = 11 then
			if f_stringpreferences("askmastercashwin_in_creditservice") = "N" then
				this.id_master.setitem(ll_mastercurrrow, "cashreceived", ld_cashreceived)
			else
				this.id_master.setitem(ll_mastercurrrow, "cashreceived", 0)
			end if
		elseif f_stringpreferences("askmastercashwin_in_cashservice") = "N" then
			this.id_master.object.cashreceived[ll_mastercurrrow] = 0
			this.id_master.object.cashtendered[ll_mastercurrrow] = 0
			this.id_master.object.cashcharged[ll_mastercurrrow] = this.id_footer.getitemdecimal(this.id_footer.getrow(), "total")
			this.id_master.object.cashback[ll_mastercurrrow] = 0
			this.id_master.accepttext()
		else
			this.id_master.object.cashreceived[ll_mastercurrrow] = 0
			if not (this.id_master.object.cashcharged[ll_mastercurrrow] = wf_grandtotal() and this.ids_cashwin.rowcount() = 0) then
				this.id_master.setitem(1, "servicecatcode", 11)
				this.id_master.accepttext()
			end if
		end if
		wf_set_outstanding_amt()
		if this.ib_modify then
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			lb_continue = wf_returnsaleinvoice(ll_invid, ls_errtext)
		else
			this.id_master.setitem(ll_mastercurrrow, "salesmancode", ll_salesmancode)
			if not this.ib_modifydate then
				if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
					messagebox("Date Violation", ls_date_errtext, stopsign!)
					return
				end if
			else
				ldt_server_datetime = this.id_master.getitemdatetime(ll_mastercurrrow, "date")
			end if
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "PostDate", ldt_server_datetime)
			if ll_doctcode > 0 and f_stringpreferences("gendoctortokenonservice") = "Y" and wf_get_tokenno(ll_doctcode, li_tokenno) >= 0 and li_tokenno >= 0 then
				this.id_master.setitem(ll_mastercurrrow, "tokenno", li_tokenno)
			end if
		end if
		if wf_update_lockerstatus() < 0 then
			lb_continue = false
		end if
		if lb_continue then
			this.id_saleinvdetail.reset()
			this.dw_servicestatus.reset()
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_saleinvdetail.insertrow(0)
				this.id_saleinvdetail.setitem(ll_counter, "Code", ll_invid)
				this.id_saleinvdetail.setitem(ll_counter, "saleprice", this.id_detail.getitemnumber(ll_counter, "saleprice"))
				this.id_saleinvdetail.setitem(ll_counter, "serviceflatdisc", this.id_detail.getitemnumber(ll_counter, "serviceflatdisc"))
				this.id_saleinvdetail.setitem(ll_counter, "discperc", this.id_detail.getitemnumber(ll_counter, "discperc"))
				this.id_saleinvdetail.setitem(ll_counter, "icode", this.id_detail.getitemnumber(ll_counter, "icode"))
				this.id_saleinvdetail.setitem(ll_counter, "smancode", this.id_detail.getitemnumber(ll_counter, "smancode"))
				this.id_saleinvdetail.setitem(ll_counter, "qty", this.id_detail.getitemnumber(ll_counter, "qty"))
				this.id_saleinvdetail.setitem(ll_counter, "commission", this.id_detail.getitemnumber(ll_counter, "commission"))
				this.id_saleinvdetail.setitem(ll_counter, "costprice", this.id_detail.getitemnumber(ll_counter, "costprice"))
				this.id_saleinvdetail.setitem(ll_counter, "deliverydate", this.id_detail.getitemdatetime(ll_counter, "deliverydate"))
				this.id_saleinvdetail.setitem(ll_counter, "sampletaken", this.id_detail.getitemstring(ll_counter, "sampletaken"))
				this.id_saleinvdetail.setitem(ll_counter, "reportmade", this.id_detail.getitemstring(ll_counter, "reportmade"))
				this.id_saleinvdetail.setitem(ll_counter, "remarks", this.id_detail.getitemstring(ll_counter, "remarks"))
				this.id_saleinvdetail.setitem(ll_counter, "serviceflattax", this.id_detail.getitemnumber(ll_counter, "serviceflattax"))
				this.id_saleinvdetail.setitem(ll_counter, "servicegstperc", this.id_detail.getitemnumber(ll_counter, "servicegstperc"))
				this.id_saleinvdetail.setitem(ll_counter, "shareperc", this.id_detail.getitemnumber(ll_counter, "shareperc"))
				if this.id_detail.getitemstring(ll_counter, "ServiceStatus") = "Y" then
					this.dw_servicestatus.retrieve(this.id_detail.getitemnumber(ll_counter, "SrvORowID"))
					this.dw_servicestatus.setitem(this.dw_servicestatus.getrow(), "ServiceStatus", "Y")
					if this.dw_servicestatus.update() <> 1 then
						SQL rollback USING this.it_transobject;
						messagebox("Service Status Updation", "Unable to modify Service Status.")
						setfocus()
						setpointer(arrow!)
						if this.ib_modify = false then
							this.id_master.setitem(1, "Code", ll_null)
						end if
						return
					end if
					return
				end if
			next
			ld_cashreceived = this.id_master.getitemnumber(ll_mastercurrrow, "cashreceived")
			if ld_cashreceived > 0.0 and this.ii_servicetype = 11 and wf_generatecashreceipt(ldt_server_datetime, ll_custcode, ld_cashreceived, ll_salesmancode, ll_invid, ll_patientcode, ll_guestcode, ll_studentcode) = -1 then
				SQL rollback USING this.it_transobject;
				if this.ib_modify = false then
					this.id_master.setitem(1, "Code", ll_null)
				end if
				return
			end if
			this.id_detail = this.id_saleinvdetail
			ll_saveresult = event ue_save_withnocommit()
			if ll_saveresult = 0 then
				if wf_update_lockerdetail(ll_invid) = 0 then
					if wf_generate_serviceresult(ll_invid, ll_salesmancode, ll_serviceresultcode) = 0 then
						if wf_generate_service_ticket(ll_invid, ll_salesmancode) = 0 then
							if wf_generate_serviceinvpurtemplate(ll_invid, ll_salesmancode) = 0 then
								if wf_raise_doctorbased_purofservice(ll_invid, ll_salesmancode) = 0 then
									if wf_generate_service_issuerequest(ll_invid, ll_salesmancode) = 0 then
										if wf_update_mastercashierwindow(ll_invid, this.is_doctype) = 0 then
											if f_stringpreferences("UseDoctorTemplateToFilterServices") = "Y" then
												this.id_itemslist.setfilter("")
												this.id_itemslist.filter()
											end if
											SQL commit USING this.it_transobject;
											if wf_update_image() = 0 then
												this.dw_image.reset()
												this.istr_image = this.istr_blank_image
											end if
											if gs_allowsmsfunctions = "Y" and ls_posted = "Y" then
												ls_invlist = trim(string(ll_invid))
												this.it_transobject.createautotriggersms(ls_invlist, this.ii_patientmodule, "Posting")
												if this.it_transobject.sqlcode <> 0 then
													ls_errtext = "Problem in Generating Auto Triggered SMS.~r~nReasons are:- " + this.it_transobject.sqlerrtext
													SQL rollback USING this.it_transobject;
													messagebox("Auto Triggered SMS", ls_errtext)
												else
													SQL commit USING this.it_transobject;
												end if
											end if
											messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
											this.ib_commitok = true
											this.il_codevalue = ll_invid
											this.id_master.resetupdate()
											this.im_menu.m_file.m_new.enabled = true
											this.editflag = false
											if gd_recenttransdate < this.id_systemdate then
												gd_recenttransdate = this.id_systemdate
											end if
										else
											messagebox("Saving Problem", "Changes Not Saved in database for Master Cashier Window transactions.", stopsign!, ok!, 1)
										end if
									else
										messagebox("Saving Problem", "Changes Not Saved in database due to problem in generation of service issue request.", stopsign!, ok!, 1)
									end if
								else
									messagebox("Saving Problem", "Changes Not Saved in database due to problem in purchase of service generation.", stopsign!, ok!, 1)
								end if
							else
								messagebox("Saving Problem", "Changes Not Saved in database due to problem in service purchase template generation.", stopsign!, ok!, 1)
							end if
						else
							messagebox("Saving Problem", "Changes Not Saved in database due to problems in service ticket generation.", stopsign!, ok!, 1)
						end if
					else
						messagebox("Saving Problem", "Changes Not Saved in database due to problems in auto service result generation.", stopsign!, ok!, 1)
					end if
				else
					messagebox("Saving Problem", "Changes Not Saved in database due to problems in updating locker details.", stopsign!, ok!, 1)
				end if
			else
				messagebox("Saving Problem", "Changes Not Saved in database while saving service record.", stopsign!, ok!, 1)
			end if
			this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
			this.id_saleinvdetail.reset()
			if this.ib_commitok then
				this.ib_modify = false
			else
				lb_continue = false
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			messagebox("Updation Error", ls_errtext + " in current row", stopsign!)
			if this.ib_modify = false then
				this.id_master.setitem(1, "Code", ll_null)
				this.id_master.accepttext()
			end if
		else
			if f_stringpreferences("IncSvcSaleInActMonitor") = "Y" then
				this.it_transobject.updateactivitymonitor(this.is_doctype, ll_invid)
				if this.it_transobject.sqlcode <> 0 then
					SQL rollback USING this.it_transobject;
					messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
				else
					SQL commit USING this.it_transobject;
				end if
			end if
			if f_stringpreferences("ShowServiceSaleInCashierActivity") = "Y" then
				this.it_transobject.updatecashieractivity(this.ii_patientmodule, ll_invid)
				if this.it_transobject.sqlcode <> 0 then
					ls_errtext = "Problem in updating cashier activity.~r~nReasons are:- " + this.it_transobject.sqlerrtext
					SQL rollback USING this.it_transobject;
					messagebox("Activity Monitor", ls_errtext)
				else
					SQL commit USING this.it_transobject;
				end if
			end if
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_service.ue_newform() returns 0 [event]
	integer rtncode
	integer li_rtncode
	long li_fetched_code
	long row
	long ll_manfcode
	long ll_null
	long ll_custcode
	long ll_doctcode
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_custcode
	string ls_doctcode
	call super::ue_newform
	setnull(ll_null)
	if this.ii_servicetype <> 10 then
		wf_update_virtualgl()
	end if
	wf_assign_lockerdetail_objects()
	setredraw(false)
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.dw_image.reset()
	this.im_menu.m_file.m_print.enabled = true
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.ib_modify = false
	if this.idc_customers.rowcount() > 0 then
		ls_custcode = f_stringpreferences("defaultcustomerinservice")
		if ls_custcode = "-1" then
			ll_custcode = this.idc_customers.getitemnumber(1, "accounts_acccode")
		else
			ll_custcode = long(ls_custcode)
		end if
		this.id_master.object.custcode[1] = ll_custcode
		this.id_master.accepttext()
		wf_enforce_custallowedservices(ll_custcode)
		this.id_master.setitem(1, "custcode", ll_custcode)
		wf_set_customerbalance(ll_custcode, 1)
	end if
	if this.ii_servicetype = 11 then
		ls_doctcode = f_stringpreferences("defaultdoctorincreditservice")
	else
		ls_doctcode = f_stringpreferences("defaultdoctorincashservice")
	end if
	if ls_doctcode = "-1" then
		setnull(ll_doctcode)
	else
		ll_doctcode = long(ls_doctcode)
	end if
	this.id_master.object.doctcode[1] = ll_doctcode
	post wf_set_doctor_info(ll_doctcode)
	wf_protect_saleprice()
	if this.ib_modifydate then
		wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
		this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
	end if
	if this.id_master.rowcount() > 0 then
		if isnull(this.id_master.object.date[1]) then
			this.id_master.object.duedate[1] = datetime(today(), relativetime(time(now()), this.il_responsetime_sec))
		else
			this.id_master.object.duedate[1] = this.id_master.object.date[1]
		end if
	end if
	li_rtncode = this.id_master.getchild("patientcode", this.idc_patient)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_patient.settransobject(this.it_transobject)
	wf_patient_retrieve()
	li_rtncode = this.id_master.getchild("guestcode", this.idc_guest)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_guest.settransobject(this.it_transobject)
	wf_guest_retrieve()
	li_rtncode = this.id_master.getchild("Studentcode", this.idc_student)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild")
		close(this)
		return
	end if
	this.idc_student.settransobject(this.it_transobject)
	wf_student_retrieve()
	this.idc_locker.settransobject(this.it_transobject)
	this.idc_locker.retrieve()
	wf_assign_master_cash_win_object()
	if this.id_master.rowcount() > 0 then
		wf_enforce_custallowedservices(this.id_master.object.custcode[1])
	end if
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	wf_visible(true)
	setredraw(true)
	wf_link_to_cashiershift()
	post event ue_enforcedefaultfocussettings(0)

// w_service.ue_detail() returns 0 [event]
	integer li_rtncode
	integer li_protect
	long ll_row
	long ll_code
	long ll_found
	boolean lb_flag
	boolean lb_modify
	m_servicemenu lm_menu
	call super::ue_detail
	lm_menu = this.menuid
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_print.enabled = true
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		ll_found = 0
		if this.ii_servicetype = 10 then
			ll_found = gds_securitywindow.find("rightcode = 713", 1, gds_securitywindow.rowcount())
		else
			ll_found = gds_securitywindow.find("rightcode = 714", 1, gds_securitywindow.rowcount())
		end if
		if ll_found > 0 then
			li_protect = 0
			wf_initmodify(li_protect)
		else
			this.id_detail.reset()
			messagebox("Service Modification", "Not Enough rights for service invoice modification~r~nPlease contact your system administrator to do the needfull", stopsign!)
			this.tab_retrieve.selecttab(2)
			return
		end if
		return
	end if
	if this.id_master.object.code[this.id_master.rowcount()] > 0 then
		this.ids_cashwin.retrieve(this.id_master.object.code[1], this.is_doctype)
		this.ids_lockerdetail.retrieve(this.id_master.object.code[1])
	else
		wf_assign_master_cash_win_object()
		wf_assign_lockerdetail_objects()
	end if
	if this.id_master.rowcount() > 0 and this.id_master.object.patientcode[1] > 0 then
		this.dw_image.retrieve(this.id_master.object.patientcode[1])
		wf_populate_image(this.id_master.object.patientcode[1])
	end if
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	wf_protectdw(this.dw_image, li_protect)
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		wf_protect_saleprice()
	end if
	if li_protect = 0 and this.ii_servicetype = 11 and this.id_master.getitemnumber(this.id_master.getrow(), "custcode") = 19.0 then
		this.id_master.setitem(this.id_master.getrow(), "servicecatcode", 11)
	end if
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	wf_grandtotal()
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "Y" then
		this.editflag = false
	end if
	this.id_itemslist.hide()
	this.ib_itemslistopen = false
	setredraw(true)
	wf_enforce_custallowedservices(this.id_master.object.custcode[1])

// w_service.ue_newitem() returns 0 [event]
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		if f_stringpreferences("itemcode") = "N" then
			this.id_detail.setcolumn("itemname")
			this.ib_focusdetail = true
			this.id_itemslist.show()
		else
			this.id_detail.setcolumn("fullcode")
			this.ib_focusdetail = true
			this.id_itemslist.hide()
		end if
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true

// w_service.ue_deleteitem() returns 0 [event]
	long ll_row
	long ll_footerrow
	call super::ue_deleteitem
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() > 0 then
		this.id_footer.setitem(ll_footerrow, "icode", this.id_detail.getitemnumber(ll_row, "icode"))
		return
	end if
	this.id_footer.setitem(ll_footerrow, "icode", 0)
	this.im_menu.m_file.m_save.enabled = false

// w_service.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	return ::message.returnvalue

// w_service.ue_list() returns 0 [event]
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_post.enabled = true
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	wf_retrievelist()
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_print.visible = true

// w_service.ue_print() returns 0 [event]
	long ll_custcode
	long ll_row
	long ll_saleinvcode
	long i
	long ll_invcode
	long ll_rep_qty_print
	string ls_custname
	integer li_option
	integer li_reprintingcounter
	datastore lds_salecatinfo
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	lds_salecatinfo = create datastore
	lds_salecatinfo.dataobject = "d_salecatinfo"
	lds_salecatinfo.settransobject(this.it_transobject)
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	SQL SELECT ISNULL ( reprintingcounter , 0 ) INTO :li_reprintingcounter FROM ServiceHeader WHERE serviceinvcode =:ll_invcode USING this.it_transobject;
	li_reprintingcounter = li_reprintingcounter + 1
	SQL update ServiceHeader SET ReprintingCounter =:li_reprintingcounter WHERE serviceinvcode =:ll_invcode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Database Error", "Some database problem has occur")
		SQL rollback USING this.it_transobject;
		return
	else
		SQL commit USING this.it_transobject;
	end if
	wf_select_service_printout()
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(ll_invcode)
	ll_rep_qty_print = wf_replicate_qty_print(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			li_reprintingcounter = li_reprintingcounter - 1
			SQL update ServiceHeader SET ReprintingCounter =:li_reprintingcounter WHERE serviceinvcode =:ll_invcode USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				messagebox("Database Error", "Some database problem has occur during updation of reprinting counter.")
				SQL rollback USING this.it_transobject;
				return
			else
				SQL commit USING this.it_transobject;
			end if
			return
		end if
		return
	end if
	if f_stringpreferences("askforcopiesinservice") = "Y" then
		open(w_printer_copies)
		this.id_print.object.datawindow.print.copies = string(message.doubleparm)
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		if ll_rep_qty_print = 0 and this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if lb_listtab then
			setnull(ll_saleinvcode)
		else
			ll_saleinvcode = this.id_master.getitemnumber(1, "saleinvcode")
		end if
		if isnull(ll_saleinvcode) then
			if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
				postevent("ue_new")
			end if
		elseif f_stringpreferences("printsepsaleinvafterserviceinv") = "Y" then
			lds_salecatinfo.retrieve(ll_saleinvcode)
			this.ii_saletype = lds_salecatinfo.getitemnumber(lds_salecatinfo.getrow(), "salecatcode")
			wf_selectprintreport()
			this.id_print.retrieve(ll_saleinvcode)
			if ll_rep_qty_print = 0 then
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			end if
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_service.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	f_retrieve_servicelist(this.id_itemslist, this.it_transobject)
	if this.ii_servicetype = 11 then
		setpointer(hourglass!)
		this.idc_customers.setredraw(false)
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.retrieve()
		this.idc_customers.setredraw(true)
		this.idc_salesman.settransobject(this.it_transobject)
		this.idc_salesman.retrieve()
		if f_stringpreferences("InServiceCustomerBalance") = "Y" then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
			this.ids_customersbalance.retrieve()
		end if
		setpointer(arrow!)
	end if
	wf_patient_retrieve()
	wf_student_retrieve()
	wf_guest_retrieve()

// w_service.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_service.ue_postopen() returns 0 [event]
	datawindowchild ldc_headerno
	m_servicemenu lm_menu
	integer li_rtncode
	long ll_counter
	long ll_pos
	long ll_pcode
	long ll_prow
	long ll_found
	long li_count
	long ll_startrow
	char lc_char
	call super::ue_postopen
	lm_menu = this.menuid
	setredraw(false)
	this.ii_servicetype = integer(message.doubleparm)
	wf_assign_master_cash_win_object()
	this.il_groupcode = f_getgroupcode(gl_usercode)
	if this.ii_servicetype = 11 then
		this.ii_patientmodule = 23
	else
		this.ii_patientmodule = 22
	end if
	this.ic_retrievepatientlist = f_stringpreferences("retrievepatientlistinservice")
	this.id_print = this.dw_saleinvrep
	this.id_saleinvdetail = this.dw_saleinvdetail
	this.id_saleinvdetail.settransobject(this.it_transobject)
	this.dw_servicestatus.settransobject(this.it_transobject)
	this.id_printticket = this.dw_serviceticket
	this.dw_image.settransobject(this.it_transobject)
	choose case this.ii_servicetype
	case 11
		this.title = "Credit Service"
		if gs_company = "SHE" or gs_company = "REHMAT" or gs_company = "RIZWAN" then
			this.id_master.object.servicecatcode.initial = "12"
		end if
		li_rtncode = this.id_master.getchild("custcode", this.idc_customers)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
		end if
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.retrieve()
		this.idc_customers.setfilter("accounts_acccode <> 19")
		this.idc_customers.filter()
		if f_stringpreferences("showheaderincreditservice") = "N" then
			this.id_master.object.headerno.visible = false
			this.id_master.object.headerno_t.visible = false
		else
			li_rtncode = wf_set_headersetting()
			if li_rtncode <= 0 then
				messagebox("Problem", "Not Enough Header Rights to Make Service Sales")
				close(this)
				return
			end if
		end if
		if f_stringpreferences("InServiceCustomerBalance") = "Y" then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
			this.ids_customersbalance = create datastore
			this.ids_customersbalance.dataobject = "d_customerbalances_in_sales"
			this.ids_customersbalance.settransobject(sqlca)
			this.ids_customersbalance.retrieve()
		else
			this.id_master.object.debitorcredit.visible = false
			this.id_master.object.customerbalance.visible = false
			this.id_master.object.customerbalance_t.visible = false
		end if
		if f_stringpreferences("ServiceCategory") = "N" then
			this.id_master.object.servicecatcode.visible = false
			this.id_master.object.servicecatcode_t.visible = false
		end if
		li_rtncode = this.id_master.getchild("patientcode", this.idc_patient)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
			return
		end if
		this.idc_patient.settransobject(this.it_transobject)
		wf_patient_retrieve()
		if f_stringpreferences("PatientOnCreditService") <> "H" then
			this.id_master.object.patientcode.visible = false
			this.id_master.object.patientregno_t.visible = false
			this.id_master.object.patientcode_t.visible = false
			this.id_master.object.patientregno.visible = false
			this.id_master.object.patientbalance.visible = false
			this.id_master.object.t_patientbalance.visible = false
			this.id_master.object.c_patientbalancedrcr.visible = false
		end if
		li_rtncode = this.id_master.getchild("guestcode", this.idc_guest)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
			return
		end if
		this.idc_guest.settransobject(this.it_transobject)
		wf_guest_retrieve()
		if f_stringpreferences("GuestOnCreditService") <> "H" then
			this.id_master.object.guestcode.visible = false
			this.id_master.object.guestregno_t.visible = false
			this.id_master.object.guestcode_t.visible = false
			this.id_master.object.guestregno.visible = false
			this.id_master.object.guestbalance.visible = false
			this.id_master.object.guestbalance_t.visible = false
			this.id_master.object.c_guestbalance_drcr.visible = false
		end if
		li_rtncode = this.id_master.getchild("studentcode", this.idc_student)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
			return
		end if
		this.idc_student.settransobject(this.it_transobject)
		wf_student_retrieve()
		if f_stringpreferences("StudentOnCreditService") <> "H" then
			this.id_master.object.studentcode.visible = false
			this.id_master.object.studentregno_t.visible = false
			this.id_master.object.studentcode_t.visible = false
			this.id_master.object.studentregno.visible = false
			this.id_master.object.studentbalance.visible = false
			this.id_master.object.studentbalance_t.visible = false
			this.id_master.object.c_studentbalance_drcr.visible = false
		end if
		li_rtncode = this.id_master.getchild("motorvehiclecode", this.idc_motorvehicle)
		if li_rtncode = -1 then
			messagebox("Error", "Can not get a DataWindowChild")
			close(this)
			return
		end if
		this.idc_motorvehicle.settransobject(this.it_transobject)
		wf_motorvehicle_retrieve()
		if f_stringpreferences("showmotorvehicleincreditservice") = "N" then
			this.id_master.object.chasisno_t.visible = false
			this.id_master.object.chasisno.visible = false
			this.id_master.object.motorvehiclecode_t.visible = false
			this.id_master.object.motorvehiclecode.visible = false
		end if
		if f_stringpreferences("AskServiceOrderInService") = "N" then
			this.id_master.object.serviceocode.visible = false
			this.id_master.object.serviceocode_t.visible = false
		end if
		if f_stringpreferences("servicedoctid") = "N" then
			this.id_master.object.doctcode.visible = false
			this.id_master.object.doctcode_t.visible = false
			this.id_master.object.tokenno.visible = false
			this.id_master.object.tokenno_t.visible = false
		end if
		this.id_detail.object.smancode.initial = trim(string(f_numberpreferences("InitialSManCodeInService")))
		if f_stringpreferences("SalesManInService") = "N" then
			this.id_detail.object.smancode.visible = false
			this.id_detail.object.smancode_t.visible = false
		end if
		if f_stringpreferences("showcommissionincrditservice") = "N" then
			this.id_detail.object.commission.visible = false
		end if
		if f_stringpreferences("showdeliverydateincreditservice") = "N" then
			this.id_detail.object.deliverydate.visible = false
		end if
		if f_stringpreferences("showremarksincreditservicedetail") = "N" then
			this.id_detail.object.remarks.visible = false
		end if
		if f_stringpreferences("prediscpercincreditservicedetail") = "N" then
			this.id_detail.object.prediscperc.visible = false
		end if
		if f_stringpreferences("showflatdiscincreditservicedetail") = "N" then
			this.id_detail.object.serviceflatdisc.visible = false
		end if
		if f_stringpreferences("showflattaxincreditservice") = "N" then
			this.id_detail.object.serviceflattax.visible = false
			this.id_detail.object.c_flattaxval.visible = false
		end if
		if f_stringpreferences("showgstpercincreditservice") = "N" then
			this.id_detail.object.servicegstperc.visible = false
			this.id_detail.object.c_gstval.visible = false
		end if
		if f_stringpreferences("showsharepercincreditservice") = "N" then
			this.id_detail.object.shareperc.visible = false
		end if
		if f_stringpreferences("showcreditserviceinvgstperc") = "N" then
			this.id_footer.object.serviceinvgstperc.visible = false
			this.id_footer.object.serviceinvgstperc_t.visible = false
		end if
		if f_stringpreferences("showcreditserviceinvflatdisc") = "N" then
			this.id_footer.object.flatdisc.visible = false
			this.id_footer.object.flatdisc_t.visible = false
		end if
		if f_stringpreferences("showcreditserviceinvdiscperc") = "N" then
			this.id_footer.object.invdiscperc.visible = false
			this.id_footer.object.discperc_t.visible = false
		end if
		if f_stringpreferences("showcreditserviceinvmisccharges") = "N" then
			this.id_footer.object.misccharges.visible = false
			this.id_footer.object.misccharges_t.visible = false
		end if
		if f_stringpreferences("showcustomerincreditservice") = "N" then
			this.id_master.object.custcode.visible = false
			this.id_master.object.custcode_t.visible = false
			this.id_master.object.aliasname.visible = false
			this.id_master.object.aliasname_t.visible = false
