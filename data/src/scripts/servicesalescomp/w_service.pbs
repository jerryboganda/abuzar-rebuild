// w_service.wf_populate_serviceinfo() returns long
	s_arguements lstr_arg
	datastore lds_serviceheader
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.rowcount() < 1 then
		return 0
	end if
	open(w_arg_code)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		lds_serviceheader = create datastore
		lds_serviceheader.dataobject = "d_serviceheader_retrieve"
		lds_serviceheader.settransobject(this.it_transobject)
		lds_serviceheader.retrieve(lstr_arg.l_code1)
		if lds_serviceheader.rowcount() > 0 then
			if this.ii_servicetype = 11 then
				if lds_serviceheader.object.servicecatcode[1] <= 10 then
					messagebox("Service Header Info. Population", "Cash Service Contents can not be populated in Credit Service Invoice", information!)
					return 0
				end if
			elseif lds_serviceheader.object.servicecatcode[1] > 10 then
				messagebox("Service Header Info. Population", "Credit Service Contents can not be populated in Cash Service Invoice", information!)
				return 0
			end if
			this.id_master.setitem(1, "servicecatcode", lds_serviceheader.object.servicecatcode[1])
			this.id_master.setitem(1, "patientregno", lds_serviceheader.object.patientregno[1])
			this.id_master.setitem(1, "patientcode", lds_serviceheader.object.patientcode[1])
			this.id_master.setitem(1, "aliasname", lds_serviceheader.object.aliasname[1])
			this.id_master.setitem(1, "custcode", lds_serviceheader.object.custcode[1])
			this.id_master.setitem(1, "saleinvcode", lds_serviceheader.object.saleinvcode[1])
			this.id_master.setitem(1, "serviceocode", lds_serviceheader.object.serviceocode[1])
			this.id_master.setitem(1, "doctcode", lds_serviceheader.object.doctcode[1])
			this.id_master.setitem(1, "fullpatientname", lds_serviceheader.object.fullpatientname[1])
			this.id_master.setitem(1, "patientsex", lds_serviceheader.object.patientsex[1])
			this.id_master.setitem(1, "patientage", lds_serviceheader.object.patientage[1])
			this.id_master.setitem(1, "patientrefby", lds_serviceheader.object.patientrefby[1])
			this.id_master.setitem(1, "ref1", lds_serviceheader.object.ref1[1])
			this.id_master.setitem(1, "ref2", lds_serviceheader.object.ref2[1])
			this.id_master.setitem(1, "remarks", lds_serviceheader.object.remarks[1])
			this.id_master.setitem(1, "discperc", lds_serviceheader.object.discperc[1])
			this.id_master.setitem(1, "flatdisc", lds_serviceheader.object.flatdisc[1])
			this.id_master.setitem(1, "misccharges", lds_serviceheader.object.misccharges[1])
			this.id_master.setitem(1, "doctcode", lds_serviceheader.object.doctcode[1])
		end if
	end if
	return 0

// w_service.wf_refresh_singleservicecategory() returns 0
	long ll_counter
	long ll_find
	string ls_categories
	string ls_servicecat
	integer[] la_catcode
	datastore lds_ds
	lds_ds = create datastore
	lds_ds.dataobject = "d_servicecategory_list"
	lds_ds.settransobject(sqlca)
	lds_ds.retrieve()
	open(w_select_single_servicecategry)
	ls_servicecat = message.stringparm
	ll_find = lds_ds.find("name = '" + ls_servicecat + "'", 1, lds_ds.rowcount())
	ls_categories = ""
	if ll_find > 0 and ll_find <= lds_ds.rowcount() then
		ls_categories = string(lds_ds.object.code[ll_find])
	end if
	f_retrieve_servicelist(this.id_itemslist, this.it_transobject)
	this.id_itemslist.setfilter("servicecatcode In (" + ls_categories + ")")
	this.id_itemslist.filter()
	wf_initialize_lookup_table()

// w_service.wf_initialize_lookup_table() returns integer
	long li_count
	long ll_startrow
	char lc_char
	for li_count = 65 to 90
		lc_char = char(li_count)
		this.ia_llookuptable[li_count] = this.id_itemslist.find("Lower(itemname) >= Lower('" + char(li_count) + "')", ll_startrow, 99999)
		ll_startrow = this.ia_llookuptable[li_count]
	next
	this.ia_llookuptable[92] = 999999
	return 0

// w_service.wf_refreshitemslist() returns 0
	f_retrieve_servicelist(this.id_itemslist, this.it_transobject)
	wf_initialize_lookup_table()

// w_service.wf_new_customerregisteration() returns integer
	string ls_aliasname
	long ll_acccode
	long ll_found
	long ll_row
	dwobject dwo
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 695", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		open(w_customer_register)
		ls_aliasname = message.stringparm
		if not (ls_aliasname = "" or isnull(ls_aliasname)) then
			wf_customer_retrieve()
			ll_found = 0
			ll_found = this.idc_customers.find("accounts_aliasname = '" + ls_aliasname + "'", 1, this.idc_customers.rowcount())
			if ll_found > 0 then
				this.id_master.setitem(1, "custcode", this.idc_customers.getitemstring(ll_found, "accounts_aliasname"))
				ll_acccode = this.idc_customers.getitemnumber(ll_found, "accounts_acccode")
				this.id_master.setitem(1, "custcode", ll_acccode)
				dwo = this.id_master.object.custcode
				this.id_master.post event itemchanged(1, dwo, string(ll_acccode))
			end if
		end if
	end if
	return 0

// w_service.wf_customer_retrieve() returns long
	this.idc_customers.setredraw(false)
	this.idc_customers.settransobject(this.it_transobject)
	this.idc_customers.retrieve()
	this.idc_customers.setredraw(true)
	return 0

// w_service.wf_assign_master_cash_win_object() returns 0
	this.ids_cashwin = create u_ds_standard
	this.ids_cashwin.dataobject = "d_mastercashierwindow_detail"
	this.ids_cashwin.settransobject(this.it_transobject)

// w_service.wf_set_cashaccount() returns long
	long ll_cashacccode
	long ll_module
	long ll_code
	if this.ii_servicetype = 10 then
		ll_module = 22
	else
		ll_module = 23
	end if
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = f_is_group_module_cashaccount_allowed(this.il_groupcode, ll_module)
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		ll_cashacccode = 0
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
	elseif isnull(ll_code) or this.id_master.object.code[1] <= 0 then
		this.id_master.object.cashacccode[this.id_master.rowcount()] = ll_cashacccode
	else
		ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	end if
	return ll_cashacccode

// w_service.wf_show_mastercashierwindow() returns long
	long ll_counter
	long ll_code
	long ll_row
	long ll_insrow
	long ll_module
	long ll_cashacccode
	double ld_tot_acc_amt
	double ld_netsales
	double ld_servicetotal
	s_mastercashwin_all lstr_values
	if this.ii_servicetype = 11 then
		lstr_values.i_interfacecode = 5
		if f_stringpreferences("askmastercashwin_in_creditservice") = "N" then
			return 1
		end if
		ll_module = 23
	else
		lstr_values.i_interfacecode = 4
		if f_stringpreferences("askmastercashwin_in_cashservice") = "N" then
			return 1
		end if
		ll_module = 22
	end if
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	ll_cashacccode = this.id_master.object.cashacccode[this.id_master.rowcount()]
	if ll_cashacccode <= 0 or isnull(ll_cashacccode) then
		messagebox("Group Cash Account Problem", "No Cash Account Attached to the group of the user logged on~r~nKindly contact system administrator to do the needfull.", stopsign!, ok!)
		return 0
	end if
	ld_netsales = this.id_footer.object.netsales[1]
	if isnull(ld_netsales) then
		ld_netsales = 0.00
	end if
	ld_servicetotal = wf_grandtotal()
	if isnull(ld_servicetotal) then
		ld_servicetotal = 0.00
	end if
	lstr_values.l_doccode = ll_code
	lstr_values.s_doctype = this.is_doctype
	lstr_values.l_cashacccode = ll_cashacccode
	lstr_values.l_groupcode = this.il_groupcode
	lstr_values.l_module = ll_module
	lstr_values.d_netamt = round(ld_servicetotal + ld_netsales, 0)
	lstr_values.d_cashtendered = this.id_master.object.cashtendered[this.id_master.rowcount()]
	lstr_values.d_cashcharged = this.id_master.object.cashcharged[this.id_master.rowcount()]
	lstr_values.d_cashback = this.id_master.object.cashback[this.id_master.rowcount()]
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		lstr_values.l_acccode[ll_counter] = this.ids_cashwin.object.acccode[ll_counter]
		lstr_values.s_remarks[ll_counter] = this.ids_cashwin.object.remarks[ll_counter]
		lstr_values.d_amount[ll_counter] = this.ids_cashwin.object.amount[ll_counter]
		lstr_values.l_rowid[ll_counter] = this.ids_cashwin.object.rowid[ll_counter]
		ld_tot_acc_amt = ld_tot_acc_amt + this.ids_cashwin.object.amount[ll_counter]
	next
	if lstr_values.d_netamt >= lstr_values.d_cashcharged then
		lstr_values.d_docbalance = lstr_values.d_netamt - lstr_values.d_cashcharged - ld_tot_acc_amt
	else
		lstr_values.d_docbalance = 0
	end if
	for ll_counter = 1 to 100
		if lstr_values.l_rowid[ll_counter] <= 0 then
			lstr_values.l_rowid[ll_counter] = -1
		end if
	next
	openwithparm(w_mastercashierwindow, lstr_values)
	lstr_values = message.powerobjectparm
	if lstr_values.i_status = 1 then
		this.ids_cashwin.reset()
		ld_tot_acc_amt = 0
		for ll_counter = 1 to 100
			if lstr_values.l_acccode[ll_counter] > 0 and lstr_values.d_amount[ll_counter] > 0 and lstr_values.l_rowid[ll_counter] > 0 then
				ll_insrow = this.ids_cashwin.insertrow(0)
				this.ids_cashwin.object.documentcode[ll_insrow] = ll_code
				this.ids_cashwin.object.documenttype[ll_insrow] = this.is_doctype
				this.ids_cashwin.object.acccode[ll_insrow] = lstr_values.l_acccode[ll_counter]
				this.ids_cashwin.object.remarks[ll_insrow] = lstr_values.s_remarks[ll_counter]
				this.ids_cashwin.object.amount[ll_insrow] = lstr_values.d_amount[ll_counter]
				this.ids_cashwin.object.rowid[ll_insrow] = lstr_values.l_rowid[ll_counter]
			end if
		next
		this.id_master.object.cashacccode[this.id_master.rowcount()] = lstr_values.l_cashacccode
		this.id_master.object.cashtendered[this.id_master.rowcount()] = lstr_values.d_cashtendered
		this.id_master.object.cashcharged[this.id_master.rowcount()] = lstr_values.d_cashcharged
		this.id_master.object.cashback[this.id_master.rowcount()] = lstr_values.d_cashback
		this.id_master.object.cashreceived[this.id_master.rowcount()] = lstr_values.d_cashtendered
		this.id_master.object.outstandingamt[this.id_master.rowcount()] = lstr_values.d_docbalance
		return 1
	end if
	return 0

// w_service.wf_update_mastercashierwindow(long al_code, string as_type) returns long
	long ll_counter
	for ll_counter = 1 to this.ids_cashwin.rowcount()
		this.ids_cashwin.object.documentcode[ll_counter] = al_code
		this.ids_cashwin.object.documenttype[ll_counter] = as_type
		this.ids_cashwin.object.date[ll_counter] = this.id_master.object.date[1]
	next
	SQL DELETE DBO.MasterCashWin WHERE DocumentCode =:al_code AND DocumentType =:as_type USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if this.ids_cashwin.update() > 0 then
			return 0
		else
			return -1
		end if
		return
	end if
	return -1

// w_service.wf_post_service_custwise(integer ai_postingmode, long al_startinginvcode, long al_endinginvcode) returns long
	integer li_errcode
	long ll_salesmancode
	long ll_invcount
	long ll_counter
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	if ai_postingmode = 1 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if ai_postingmode = 1 then
			openwithparm(w_arg_cust_sinvcode_linvcode2, this.ii_servicetype)
			lstr_arginfo = message.powerobjectparm
		else
			lstr_arginfo.l_code1 = al_startinginvcode
			lstr_arginfo.l_code2 = al_endinginvcode
			lstr_arginfo.l_code3 = this.id_master.getitemnumber(1, "custcode")
			lstr_arginfo.l_code4 = 1
			lstr_arginfo.i_status = 1
		end if
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			li_errcode = wf_lockserviceinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_invcount)
			if li_errcode = 0 then
				this.it_transobject.postservice_custwise(lstr_arginfo.l_code1, lstr_arginfo.l_code2, this.ii_servicetype, ll_salesmancode, lstr_arginfo.l_code3, lstr_arginfo.l_code4)
				if this.it_transobject.sqlcode <> 0 then
					li_errcode = this.it_transobject.sqlcode
					ls_msgtext = this.it_transobject.sqlerrtext
				elseif ai_postingmode <> 1 then
					if wf_generate_service_ticket(lstr_arginfo.l_code1, ll_salesmancode) <> 0 then
						li_errcode = this.it_transobject.sqlcode
						ls_msgtext = this.it_transobject.sqlerrtext
					end if
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				ls_msgtext = this.it_transobject.sqlerrtext
				li_errcode = this.it_transobject.sqlcode
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode))
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_invcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return li_errcode

// w_service.wf_post_service_patientwise() returns long
	integer li_errcode
	long ll_salesmancode
	long ll_invcount
	long ll_counter
	long ll_found
	boolean lb_flag
	string ls_msgtext
	s_arguements lstr_arginfo
	if this.tab_retrieve.selectedtab = 1 then
		return 0
	end if
	ll_found = 0
	if this.ii_servicetype = 10 then
		ll_found = gds_securitywindow.find("rightcode = 715", 1, gds_securitywindow.rowcount())
	else
		ll_found = gds_securitywindow.find("rightcode = 716", 1, gds_securitywindow.rowcount())
	end if
	if ll_found <= 0 then
		messagebox("Service Invoice Posting", "Not Enough rights to post service invoice")
		return -1
	end if
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		openwithparm(w_arg_patient_sinvcode_linvcode, this.ii_servicetype)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			li_errcode = wf_lockserviceinvoices(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_invcount)
			if li_errcode = 0 then
				this.it_transobject.postservice_patientwise(lstr_arginfo.l_code1, lstr_arginfo.l_code2, this.ii_servicetype, ll_salesmancode, lstr_arginfo.l_code3, lstr_arginfo.l_code4)
				if this.it_transobject.sqlcode <> 0 then
					li_errcode = this.it_transobject.sqlcode
					ls_msgtext = this.it_transobject.sqlerrtext
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				ls_msgtext = this.it_transobject.sqlerrtext
				li_errcode = this.it_transobject.sqlcode
			end if
		else
			SQL rollback USING this.it_transobject;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again.~r~nReasons Are:-~r~n" + ls_msgtext + "~r~nError Code = " + string(li_errcode))
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_invcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return li_errcode

// w_service.wf_show_patientledger() returns long
	long ll_patientcode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_patientcode = this.id_master.object.patientcode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_patientcode = this.id_list.object.patientcode[this.id_list.getrow()]
	end if
	if not isnull(ll_patientcode) and ll_patientcode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_patient_ledger, ll_patientcode)
	end if
	return 0

// w_service.wf_show_accountledger() returns long
	long ll_acccode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_acccode = this.id_master.object.custcode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_acccode = this.id_list.object.custcode[this.id_list.getrow()]
	end if
	if not isnull(ll_acccode) and ll_acccode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_account_ledger, ll_acccode)
	end if
	return 0

// w_service.wf_validate_price_discount_matters(long al_usercode) returns long
	long ll_masterrow
	long ll_servicecode
	long ll_counter
	double ld_discperc
	double ld_serviceflatdisc
	double ld_serviceinvflatdisc
	double ld_servicediscperclimit
	double ld_max_srv_flatdisc
	double ld_max_inv_flatdisc
	boolean lb_validdisc
	boolean lb_srv_flatdisc
	datastore lds_groupdiscinfo
	wf_grandtotal()
	lds_groupdiscinfo = create datastore
	lds_groupdiscinfo.dataobject = "d_groups_discount"
	lds_groupdiscinfo.settransobject(this.it_transobject)
	lds_groupdiscinfo.retrieve(al_usercode)
	lb_validdisc = false
	ll_masterrow = this.id_master.rowcount()
	for ll_counter = 1 to lds_groupdiscinfo.rowcount()
		ld_servicediscperclimit = lds_groupdiscinfo.getitemnumber(ll_counter, "servicediscperclimit")
		ld_max_srv_flatdisc = lds_groupdiscinfo.getitemnumber(ll_counter, "MaxServiceFlatDisc")
		ld_max_inv_flatdisc = lds_groupdiscinfo.getitemnumber(ll_counter, "MaxServiceInvFlatDisc")
	next
	ld_serviceinvflatdisc = this.id_footer.object.flatdisc[1]
	if isnull(ld_serviceinvflatdisc) then
		ld_serviceinvflatdisc = 0
	end if
	if ld_serviceinvflatdisc > ld_max_inv_flatdisc then
		messagebox("Service Invoice Flat Discount Validation", "Service Invoice Flat Discount is greater than your group permission~r~nGroup Discount limit for Services Invoice Flat Discount is " + trim(string(ld_max_inv_flatdisc)) + "~r~nPlease consult Administrator")
		this.id_footer.setfocus()
		this.id_footer.setrow(ll_counter)
		this.id_footer.setcolumn("flatdisc")
		return -1
	end if
	for ll_counter = 1 to this.id_detail.rowcount()
		ll_servicecode = this.id_detail.getitemnumber(ll_counter, "icode")
		ld_discperc = this.id_detail.getitemnumber(ll_counter, "discperc")
		ld_serviceflatdisc = this.id_detail.getitemnumber(ll_counter, "serviceflatdisc")
		if ld_discperc > ld_servicediscperclimit then
			lb_validdisc = false
			exit
		else
			lb_validdisc = true
		end if
		if ld_serviceflatdisc > ld_max_srv_flatdisc then
			lb_srv_flatdisc = false
			exit
		else
			lb_srv_flatdisc = true
		end if
	next
	destroy lds_groupdiscinfo
	if lb_validdisc = false then
		messagebox("Disc% Validation ..", "Disc% is greater than your group permission~r~nGroup Discount % limit for Services is " + trim(string(ld_servicediscperclimit)) + "%~r~nPlease consult Administrator")
		this.id_detail.setfocus()
		this.id_detail.setrow(ll_counter)
		this.id_detail.setcolumn("discperc")
		return -1
	end if
	if lb_srv_flatdisc = false then
		messagebox("Service Flat Discount Validation ..", "Service Flat Discount is greater than your group permission~r~nGroup Service Flat Discount limit for Services is " + trim(string(ld_max_srv_flatdisc)) + "%~r~nPlease consult Administrator")
		this.id_detail.setfocus()
		this.id_detail.setrow(ll_counter)
		this.id_detail.setcolumn("serviceflatdisc")
		return -1
	end if
	return 0

// w_service.wf_checkservicecharges() returns boolean
	long ll_counter
	long ll_rowcount
	double ld_servicecharges
	double ld_costprice
	boolean lb_retflag
	string ls_allowzero_servicecharges
	string ls_belowcost_servicecharges
	ll_rowcount = this.id_detail.rowcount()
	ls_allowzero_servicecharges = upper(f_stringpreferences("allowzeroservicecharges"))
	ls_belowcost_servicecharges = upper(f_stringpreferences("allowservicechargesbelowcost"))
	for ll_counter = 1 to ll_rowcount
		ld_costprice = this.id_detail.object.costprice[ll_counter]
		ld_servicecharges = this.id_detail.object.saleprice[ll_counter]
		if ls_allowzero_servicecharges = "N" and ld_servicecharges <= 0.0 then
			messagebox("Service Charges Validation", "Service Charges Can not be zero or -ve~r~nPlease enter valid service charges", stopsign!)
			lb_retflag = false
			this.id_detail.setfocus()
			this.id_detail.setrow(ll_counter)
			this.id_detail.setcolumn("saleprice")
			return lb_retflag
		end if
		if ls_belowcost_servicecharges = "N" and ld_servicecharges < ld_costprice then
			messagebox("Service Charges Validation", "Service Charges Can not be less than Cost Price~r~nPlease enter valid service charges", stopsign!)
			lb_retflag = false
			this.id_detail.setfocus()
			this.id_detail.setrow(ll_counter)
			this.id_detail.setcolumn("saleprice")
			return lb_retflag
		end if
	next
	return lb_retflag

// w_service.wf_get_customer_associated_templatecode(long al_custcode) returns long
	long ll_retcode
	long ll_templatecode
	if al_custcode = 0 or isnull(al_custcode) then
		ll_retcode = -1
		return ll_retcode
	else
		SQL SELECT AssociatedServiceTemplateCode INTO :ll_templatecode FROM DBO.Customer WHERE CustCode =:al_custcode USING sqlca;
		if sqlca.sqlcode = 0 then
			if ll_templatecode = 0 or isnull(ll_templatecode) then
				ll_retcode = 0
			else
				ll_retcode = ll_templatecode
			end if
		else
			ll_retcode = -2
		end if
	end if
	return ll_retcode

// w_service.wf_apply_associated_customer_tempate(integer ai_mode) returns long
	long ll_custcode
	long ll_masterrow
	long ll_templatecode
	long ll_detailrows
	long ll_templateheaderrow
	long ll_templaterows
	long ll_found
	long ll_rowcount
	long ll_templatepackunits
	long ll_icode
	long ll_notfound_itemcount
	long ll_prefsetting
	double ld_templateprice
	double ld_templatediscperc
	double ld_template_flatdisc
	double ld_template_shareperc
	double ld_templateqty
	double ld_qty
	double ld_commission
	string ls_msgtitle
	string ls_itemname
	string ls_msgdetail
	boolean lb_editsaleprice
	boolean lb_editsalediscperc
	boolean lb_editbonusqty
	boolean lb_edititewflatdisc
	datastore lds_templatedetail
	datastore lds_templateheader
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_custcode = this.id_master.getitemnumber(ll_masterrow, "custcode")
	if ll_custcode = 0 or isnull(ll_custcode) then
		messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Items before applying Customers' Associated Service Template", stopsign!)
		return 0
	end if
	ll_templatecode = wf_get_customer_associated_templatecode(ll_custcode)
	if ll_templatecode < 0 then
		if ll_templatecode = -1 then
			messagebox(ls_msgtitle, "Please Select Valid customer", stopsign!)
			return 0
		else
			messagebox(ls_msgtitle, "Problem in retrieving Associated Service Template of this customer", stopsign!)
			return 0
		end if
	elseif ll_templatecode = 0 then
		if ai_mode = 0 then
			messagebox(ls_msgtitle, "No Associated Service Template found for this customer", stopsign!)
			return 0
		else
			return 1
		end if
		return
	end if
	if f_stringpreferences("applycustomertemplateonsaving") = "Y" then
		ll_prefsetting = 1
	elseif f_stringpreferences("applycustomertemplateonsaving") = "P" then
		ll_prefsetting = 2
	elseif f_stringpreferences("applycustomertemplateonsaving") = "D" then
		ll_prefsetting = 3
	elseif f_stringpreferences("applycustomertemplateonsaving") = "C" then
		ll_prefsetting = 4
	elseif f_stringpreferences("applycustomertemplateonsaving") = "S" then
		ll_prefsetting = 5
	elseif f_stringpreferences("applycustomertemplateonsaving") = "T" then
		ll_prefsetting = 6
	else
		ll_prefsetting = 0
	end if
	lds_templatedetail = create datastore
	lds_templateheader = create datastore
	lds_templatedetail.dataobject = "d_servicetemplate_detail"
	lds_templatedetail.settransobject(this.it_transobject)
	lds_templateheader.dataobject = "d_servicetemplate_header"
	lds_templateheader.settransobject(this.it_transobject)
	ll_templateheaderrow = lds_templateheader.retrieve(ll_templatecode)
	if ll_templateheaderrow < 0 then
		messagebox(ls_msgtitle, "Associated Service Template Header Retrieval Problem", stopsign!)
		return 0
	else
		ll_templateheaderrow = lds_templateheader.rowcount()
		if ll_templateheaderrow = 0 then
			messagebox(ls_msgtitle, "Associated Service Template Does not Exist", stopsign!)
			return 0
		end if
	end if
	ll_templaterows = lds_templatedetail.retrieve(ll_templatecode)
	if ll_templaterows < 0 then
		messagebox(ls_msgtitle, "Associated Service Template Detail Retrieval Problem", stopsign!)
		return 0
	else
		ll_templaterows = lds_templatedetail.rowcount()
		if ll_templaterows = 0 then
			if ai_mode = 0 then
				messagebox(ls_msgtitle, "Associated Service Template contain no rows", stopsign!)
				return 0
			else
				return 1
			end if
			return
		end if
	end if
	setredraw(false)
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ll_found = 0
		ll_found = lds_templatedetail.find("icode = " + trim(string(ll_icode)), 1, ll_templaterows)
		if ll_found > 0 then
			ld_templatediscperc = lds_templatedetail.getitemnumber(ll_found, "discperc")
			ld_templateprice = lds_templatedetail.getitemnumber(ll_found, "saleprice")
			ld_template_flatdisc = lds_templatedetail.getitemnumber(ll_found, "serviceflatdisc")
			ld_template_shareperc = lds_templatedetail.getitemnumber(ll_found, "shareperc")
			ld_commission = lds_templatedetail.getitemnumber(ll_found, "commission")
			if ll_prefsetting >= 1 then
				if ll_prefsetting <= 2 or ll_prefsetting = 6 then
					this.id_detail.setitem(ll_rowcount, "saleprice", ld_templateprice)
				end if
				if ll_prefsetting = 1 or ll_prefsetting = 3 then
					this.id_detail.setitem(ll_rowcount, "discperc", ld_templatediscperc)
					this.id_detail.setitem(ll_rowcount, "serviceflatdisc", ld_template_flatdisc)
				end if
				if ll_prefsetting = 1 or ll_prefsetting = 4 or ll_prefsetting = 6 then
					this.id_detail.setitem(ll_rowcount, "commission", ld_commission)
				end if
				if ll_prefsetting = 1 or ll_prefsetting = 5 or ll_prefsetting = 6 then
					this.id_detail.setitem(ll_rowcount, "shareperc", ld_template_shareperc)
				end if
			end if
			ld_qty = this.id_detail.getitemnumber(ll_rowcount, "qty")
		else
			ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_rowcount) + "~t Item Name:  " + ls_itemname
			ll_notfound_itemcount = ll_notfound_itemcount + 1
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_notfound_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Guidelines Exist for Following " + trim(string(ll_notfound_itemcount)) + " service(s) in Associated Template/Pricing Contract~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_service.wf_show_saleinservice() returns 0
	long ll_custcode
	long ll_null
	long ll_patientcode
	long ll_salecatcode
	if wf_iseditable() = false then
		return
	end if
	setnull(ll_null)
	if this.id_master.accepttext() < 0 then
		return
	end if
	if this.id_master.rowcount() > 0 then
		ll_custcode = this.id_master.object.custcode[1]
		if isnull(ll_custcode) or ll_custcode = 0 then
			messagebox("Customer Validation", "Please Select a customer first")
			return
		end if
		ll_patientcode = this.id_master.object.patientcode[1]
		this.istr_buffer.i_status = 1
		this.istr_buffer.l_code1 = this.id_master.object.saleinvcode[this.id_master.getrow()]
		this.istr_buffer.l_code3 = ll_custcode
		this.istr_buffer.l_code4 = ll_patientcode
		if this.ii_servicetype = 10 then
			this.istr_buffer.l_code2 = 3
			this.istr_buffer.s_name1 = f_stringpreferences("autopost_cashservice")
		else
			this.istr_buffer.l_code2 = 2
			this.istr_buffer.s_name1 = f_stringpreferences("autopost_creditservice")
		end if
		openwithparm(w_sale_popup, this, this)
	end if

// w_service.wf_set_saleamount() returns long
	long ll_retinvcode
	long ll_saleinvcode
	double ld_returnamt
	double ld_saleamt
	if this.id_master.rowcount() > 0 then
		ll_saleinvcode = this.id_master.object.saleinvcode[1]
		SQL SELECT SaleAmt =ISNULL ( DBO.fn_GetSaleInvTotal ( T.SaleInvCode ) , 0 ) , T.SRBufferInvCode INTO :ld_saleamt, :ll_retinvcode FROM SaleLedger T WHERE T.SaleInvCode =:ll_saleinvcode USING sqlca;
		if sqlca.sqlcode = 0 then
			if ld_saleamt < 0.0 then
				ld_saleamt = 0.00
			end if
		else
			ld_saleamt = 0
		end if
		if ll_retinvcode > 0 then
			SQL SELECT RetAmt =ISNULL ( DBO.fn_GetSRBufferInvTotal ( T.SRBufferInvCode ) , 0 ) INTO :ld_returnamt FROM SRBufferLedger T WHERE T.SRBufferInvCode =:ll_retinvcode USING sqlca;
			if sqlca.sqlcode = 0 then
				if ld_returnamt < 0.0 then
					ld_returnamt = 0.00
				end if
			else
				ld_returnamt = 0.00
			end if
		end if
		this.id_footer.object.netsales[1] = ld_saleamt - ld_returnamt
	end if
	return 0

// w_service.wf_saveandpost() returns long
	boolean lb_listtab
	boolean lb_continueposting
	integer li_postingmode
	integer li_errcode
	integer li_printoption
	long ll_sinvcode
	long ll_linvcode
	long ll_found
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab then
		return 0
	end if
	if wf_iseditable() = false then
		return 0
	end if
	if this.id_master.object.posted[1] = "Y" then
		return 0
	end if
	ll_found = 0
	if this.ii_servicetype = 10 then
		ll_found = gds_securitywindow.find("rightcode = 715", 1, gds_securitywindow.rowcount())
	else
		ll_found = gds_securitywindow.find("rightcode = 716", 1, gds_securitywindow.rowcount())
	end if
	if ll_found <= 0 then
		messagebox("Service Invoice Posting", "Not Enough rights to post service invoice")
		return -1
	end if
	li_printoption = messagebox("Print Service Invoice", "Do You want to Print Service invoice As Well?", information!, yesno!, 1)
	if li_printoption = 1 then
		event ue_print()
	else
		event ue_save()
	end if
	if this.ib_commitok and this.il_codevalue > 0 then
		lb_continueposting = true
	else
		return 0
	end if
	if lb_continueposting then
		ll_sinvcode = this.il_codevalue
		ll_linvcode = this.il_codevalue
		if isnull(ll_sinvcode) or isnull(ll_linvcode) or ll_sinvcode < 0 or ll_linvcode < 0 then
			return 0
		else
			li_errcode = wf_post_service_custwise(li_postingmode, ll_sinvcode, ll_linvcode)
			event ue_new()
		end if
	end if
	setpointer(arrow!)
	return li_errcode

// w_service.wf_get_service_slip() returns string
	string ls_pagesize
	string ls_dataobject
	if gs_company = "RAWALDENTALHSP" then
		ls_dataobject = "d_rawaldentalhsp_serviceslip_print"
	elseif gs_company = "FRIENDSHSP2" then
		ls_dataobject = "d_friendshsp2_serviceslip_half"
	elseif gs_company = "GBSHAHFABRICS" then
		ls_dataobject = "d_gbshahfabrics_serviceslip_half"
	elseif gs_company = "DWATSONDC" then
		ls_dataobject = "d_dwatsondc_serviceslipreport"
	elseif gs_company = "MDLAB" then
		ls_dataobject = "d_mdlab_serviceslipreport"
	elseif gs_company = "SALMANPH" then
		ls_dataobject = "d_salmanph_service_slip_full"
	end if
	if ls_dataobject = "" then
		ls_dataobject = "d_serviceslip_half"
	end if
	return ls_dataobject

// w_service.wf_set_patientbalance(long al_patientcode) returns long
