// w_service.wf_generatecashreceipt(datetime adt_server_datetime, long al_custcode, double ad_totalcashreceived, integer ai_salesmancode, long al_invid, long al_patientcode, long al_guestcode, long al_studentcode) returns integer
	long ll_vochcode
	long ll_glvochcode
	long ll_null
	long ll_cashacc
	long ll_modifiedby
	long ll_postedby
	string ls_null
	string ls_remarks
	string ls_posted
	long ll_vouchercatcode
	datetime ldt_datetime
	double ld_zerovalue
	setnull(ll_null)
	setnull(ll_modifiedby)
	setnull(ls_null)
	ls_remarks = "Cash Receipt on Credit Service #: " + string(al_invid)
	ll_postedby = ai_salesmancode
	ldt_datetime = adt_server_datetime
	if ad_totalcashreceived > 0.0 then
		this.it_transobject.getglobalcode("GT_CashAcc", ll_cashacc)
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Auto CashReceipt Generation Error", "Unable to find Cash Account while generating auto cash receipt.")
			return -1
		end if
		this.it_transobject.createvoucher(ll_vouchercatcode, ll_cashacc, ldt_datetime, ai_salesmancode, "Y", ldt_datetime, ls_remarks, ldt_datetime, ll_modifiedby, ll_postedby, ls_null, ll_cashacc, al_custcode, ad_totalcashreceived, ls_null, ls_remarks, ll_null, al_patientcode, al_guestcode, al_studentcode, ld_zerovalue, ld_zerovalue, ll_glvochcode, ll_vochcode, ll_null)
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Auto CashReceipt Generation Error", "Reasons are:~r~n" + this.it_transobject.sqlerrtext)
			return -1
		end if
		return
	end if
	return 0

