	this.id_footer.dataobject = as_footerdw
	this.id_list.dataobject = as_listdw
	this.id_print.dataobject = as_printdw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_print.settransobject(this.it_transobject)

// w_service.wf_show_lockerdetail(integer ai_mode) returns long
	long ll_counter
	long ll_code
	long ll_row
	long ll_insrow
	double ld_tot_expamt
	s_mastercashwin lstr_values
	if this.id_master.object.lockercode[this.id_master.rowcount()] > 0 then
		ll_code = this.id_master.object.code[this.id_master.rowcount()]
		lstr_values.l_invcode = ll_code
		lstr_values.l_groupcode = this.il_groupcode
		for ll_counter = 1 to this.ids_lockerdetail.rowcount()
			lstr_values.l_invcode = this.ids_lockerdetail.object.code[ll_counter]
			lstr_values.l_acccode[ll_counter] = this.ids_lockerdetail.object.icode[ll_counter]
			lstr_values.s_remarks[ll_counter] = this.ids_lockerdetail.object.remarks[ll_counter]
			lstr_values.d_amount[ll_counter] = this.ids_lockerdetail.object.qty[ll_counter]
			lstr_values.l_rowid[ll_counter] = ll_counter
		next
		for ll_counter = 1 to 100
			if lstr_values.l_rowid[ll_counter] <= 0 then
				lstr_values.l_rowid[ll_counter] = -1
			end if
		next
		lstr_values.l_mode = ai_mode
		openwithparm(w_servicelockerdetail, lstr_values)
		lstr_values = message.powerobjectparm
		if lstr_values.i_status = 1 then
			this.ids_lockerdetail.reset()
			for ll_counter = 1 to 100
				if lstr_values.l_acccode[ll_counter] > 0 and lstr_values.d_amount[ll_counter] > 0 then
					ll_insrow = this.ids_lockerdetail.insertrow(0)
					this.ids_lockerdetail.object.code[ll_insrow] = ll_code
					this.ids_lockerdetail.object.icode[ll_insrow] = lstr_values.l_acccode[ll_counter]
					this.ids_lockerdetail.object.remarks[ll_insrow] = lstr_values.s_remarks[ll_counter]
					this.ids_lockerdetail.object.qty[ll_insrow] = lstr_values.d_amount[ll_counter]
				end if
			next
			return 1
		else
			return 0
		end if
		return
	end if
	messagebox("Locker Detail", "Please select valid un-occupied locker first then enter its details.", information!)
	this.id_master.setcolumn("lockercode")
	this.id_master.setfocus()
	return 0

// w_service.wf_assign_lockerdetail_objects() returns integer
	this.ids_lockerdetail = create u_ds_standard
	this.ids_lockerdetail.dataobject = "d_servicelockerdetail"
	this.ids_lockerdetail.settransobject(this.it_transobject)
	return 0

// w_service.wf_update_lockerdetail(long al_invcode) returns long
	long ll_counter
	for ll_counter = 1 to this.ids_lockerdetail.rowcount()
		this.ids_lockerdetail.object.code[ll_counter] = al_invcode
		this.ids_lockerdetail.setitemstatus(ll_counter, 0, primary!, new!)
	next
	SQL DELETE DBO.ServiceLockerDetail WHERE ServiceInvCode =:al_invcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if this.ids_lockerdetail.update() > 0 then
			return 0
		else
			return -1
		end if
		return
	end if
	return -1

// w_service.wf_generate_service_issuerequest(long al_serviceinvcode, long al_usercode) returns long
	long ll_retcode
	if al_serviceinvcode > 0 and al_usercode > 0 then
		this.it_transobject.autogenerateissuereqforconsumableitem(al_serviceinvcode, al_usercode)
		if this.it_transobject.sqlcode = 0 then
			ll_retcode = 0
		else
			messagebox("Service Issue Request Generation", "Problems Occured in Service Issue Request Generation.~r~nReasons Are:-" + this.it_transobject.sqlerrtext)
			ll_retcode = -1
		end if
	end if
	return ll_retcode

// w_service.wf_show_servicesalehistory() returns long
	s_itemsalehistory ls_itemsalehistory
	if this.id_detail = getfocus() and this.id_detail.rowcount() > 0 then
		ls_itemsalehistory.ar_icode = this.id_detail.getitemnumber(this.id_detail.getrow(), "icode")
		ls_itemsalehistory.ar_date = this.id_master.getitemdatetime(this.id_master.getrow(), "date")
		openwithparm(w_servicesalehistory, ls_itemsalehistory)
