// w_service.wf_update_virtualgl() returns integer
	boolean lb_update
	SQL rollback USING sqlca;
	sqlca.virtualgl("A")
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
	else
		SQL rollback USING sqlca;
	end if
	return 0

// w_service.wf_get_tokenno(long al_doctcode, integer ai_tokenno) returns long
	long ll_rtcode
	long ll_tokenno
	long ll_temptoken
	long ll_patientcode
	datetime ldt_date
	ldt_date = this.id_master.object.date[1]
	ll_patientcode = this.id_master.object.patientcode[1]
	ll_rtcode = wf_find_tokenable_services()
	if ll_rtcode <= 0 then
		return ll_rtcode
	end if
	SQL SELECT ISNULL ( TokenNo , - 1 ) INTO :ll_tokenno FROM VisitAppointMent WHERE DoctCode =:al_doctcode AND PatientCode =:ll_patientcode AND CONVERT ( VARCHAR ( 12 ) , :ldt_date , 103 ) =CONVERT ( VARCHAR ( 12 ) , DUEDATE , 103 ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 and ll_tokenno > 0 then
		ai_tokenno = ll_tokenno
		return 0
	end if
	SQL SELECT ISNULL ( MAX ( LastToken ) , 0 ) + 1 INTO :ll_tokenno FROM ( SELECT LastToken =ISNULL ( MAX ( TokenNo ) , 0 ) FROM VisitAppointMent WHERE DoctCode =:al_doctcode AND CONVERT ( VARCHAR ( 12 ) , :ldt_date , 103 ) =CONVERT ( VARCHAR ( 12 ) , DUEDATE , 103 ) UNION SELECT LastToken =ISNULL ( MAX ( TokenNo ) , 0 ) FROM ServiceHeader WHERE DoctCode =:al_doctcode AND CONVERT ( VARCHAR ( 12 ) , :ldt_date , 103 ) =CONVERT ( VARCHAR ( 12 ) , DATE , 103 ) ) T USING this.it_transobject;
	SQL SELECT LastTokenNo INTO :ll_temptoken FROM Doctors WITH ( UPDLOCK HOLDLOCK ) WHERE Doctors.DoctCode =:al_doctcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		SQL update dbo.doctors SET LastTokenNo =:ll_tokenno WHERE Doctors.DoctCode =:al_doctcode USING this.it_transobject;
		if this.it_transobject.sqlcode < 0 then
			ll_rtcode = this.it_transobject.sqlcode
			ai_tokenno = 0
		else
			ai_tokenno = ll_tokenno
		end if
	else
		ll_rtcode = this.it_transobject.sqlcode
		ai_tokenno = 0
	end if
	return ll_rtcode

// w_service.wf_set_doctor_info(long al_doctcode) returns long
	long ll_tokenno
	long ll_patientcode
	long ll_servicetemplatecode
	long ll_counter
	long ll_rows
	string ls_services
	string ls_filter
	datastore lds_services
	ll_patientcode = this.id_master.object.patientcode[1]
	if al_doctcode <= 0 then
		return 0
	end if
	if ll_patientcode > 0 and al_doctcode > 0 then
		SQL SELECT ISNULL ( TokenNo , - 1 ) INTO :ll_tokenno FROM VisitAppointMent WHERE DoctCode =:al_doctcode AND PatientCode =:ll_patientcode AND CONVERT ( VARCHAR ( 12 ) , GETDATE ( ) , 103 ) =CONVERT ( VARCHAR ( 12 ) , DUEDATE , 103 ) USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 and ll_tokenno > 0 then
			this.id_master.object.tokenno[1] = ll_tokenno
			return 0
		end if
		return
	end if
	SQL SELECT ISNULL ( Max ( LastTokenNo ) + 1 , 0 ) , MAX ( ServiceTemplateCode ) INTO :ll_tokenno, :ll_servicetemplatecode FROM Doctors WHERE Doctors.DoctCode =:al_doctcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.object.tokenno[1] = ll_tokenno
		if f_stringpreferences("UseDoctorTemplateToFilterServices") = "Y" and ll_servicetemplatecode > 0 then
			lds_services = create datastore
			lds_services.dataobject = "d_servicetemplate_services"
			lds_services.settransobject(this.it_transobject)
			lds_services.retrieve(ll_servicetemplatecode)
			ll_rows = lds_services.rowcount()
			ls_services = ""
			this.id_itemslist.setfilter(ls_services)
			this.id_itemslist.filter()
			for ll_counter = 1 to ll_rows
				ls_services = ls_services + trim(string(lds_services.object.servicecode[ll_counter])) + ","
			next
			if right(ls_services, 1) = "," then
				ls_services = left(ls_services, len(ls_services) - 1)
			end if
			ls_filter = "icode IN (" + ls_services + ")"
			this.id_itemslist.setfilter(ls_filter)
			this.id_itemslist.filter()
		end if
		return 0
	end if
	return 1

// w_service.wf_apply_pricepolicy(integer ai_mode) returns long
	long ll_custcode
	long ll_masterrow
	long ll_detailrows
	long ll_found
	long ll_rowcount
	long ll_icode
	long ll_manualprice_itemcount
	double ld_qty
	double ld_policy_price
	double ld_price
	string ls_msgtitle
	string ls_itemname
	string ls_msgdetail
	boolean lb_editsaleprice
	if wf_iseditable() = false then
		return 0
	end if
	ll_masterrow = this.id_master.rowcount()
	ll_custcode = this.id_master.getitemnumber(ll_masterrow, "custcode")
	if ll_custcode = 0 or isnull(ll_custcode) then
		messagebox(ls_msgtitle, "Please Select Valid Customer", stopsign!)
		return 0
	end if
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows = 0 then
		messagebox(ls_msgtitle, "Please Enter Some Services before applying Price Policy to this invoice", stopsign!)
		return 0
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 610", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lb_editsaleprice = true
	else
		messagebox(ls_msgtitle, "Not enough rights to modify service price.~r~nPlease contact system administrator for help", stopsign!)
		return 0
	end if
	setredraw(false)
	for ll_rowcount = 1 to ll_detailrows
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ls_itemname = this.id_detail.getitemstring(ll_rowcount, "itemname")
		ld_qty = this.id_detail.getitemnumber(ll_rowcount, "qty")
		ld_price = this.id_detail.getitemnumber(ll_rowcount, "saleprice")
		if ld_qty > 0.0 and ll_icode >= 0 and not isnull(ll_icode) then
			ld_policy_price = 0
			this.it_transobject.getpricefromservicepricepolicy(ll_icode, ld_policy_price)
			if this.it_transobject.sqlcode = 0 then
				if isnull(ld_policy_price) then
					ls_msgdetail = ls_msgdetail + "~r~nRow #: " + string(ll_rowcount) + "~t Service Name:  " + ls_itemname
					ll_manualprice_itemcount = ll_manualprice_itemcount + 1
				else
					this.id_detail.setitem(ll_rowcount, "saleprice", ld_policy_price)
				end if
			else
				ls_msgdetail = "Some Problem Occured while fetching Service Price Policy details~r~n" + this.it_transobject.sqlerrtext
				messagebox(ls_msgtitle, ls_msgdetail, stopsign!)
				return 0
			end if
			return
		end if
	next
	setredraw(true)
	wf_grandtotal()
	if ll_manualprice_itemcount > 0 and ai_mode = 0 then
		messagebox(ls_msgtitle, "No Price Policy exists for Following " + trim(string(ll_manualprice_itemcount)) + " Service(s)~r~nTheir Pricing should be set by user manually~r~n" + ls_msgdetail, information!)
	end if
	return 1

// w_service.wf_generate_service_ticket(long al_serviceinvcode, integer al_usercode) returns long
