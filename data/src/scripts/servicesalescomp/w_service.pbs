// w_service.wf_set_outstanding_amt() returns long
	double ld_invtotal
	double ld_amt
	double ld_outstandingamt
	double ld_balance
	double ld_adjamt
	double ld_cashcharged
	double ld_amtrecvd
	long ll_masterrow
	long ll_footerrow
	ll_masterrow = this.id_master.rowcount()
	ll_footerrow = this.id_footer.rowcount()
	this.id_master.accepttext()
	this.id_detail.accepttext()
	this.id_footer.accepttext()
	ld_invtotal = wf_grandtotal()
	if isnull(ld_invtotal) then
		ld_invtotal = 0
	end if
	ld_outstandingamt = ld_invtotal
	this.id_footer.setitem(ll_footerrow, "total", ld_invtotal)
	ld_cashcharged = this.id_master.object.cashcharged[ll_masterrow] + this.id_master.object.cashreceived[ll_masterrow]
	if ld_outstandingamt - ld_cashcharged <= 0.0 then
		ld_outstandingamt = 0.00
	else
		ld_outstandingamt = ld_outstandingamt - ld_cashcharged
	end if
	ld_amtrecvd = 0
	if this.ids_cashwin.rowcount() > 0 then
		ld_amtrecvd = this.ids_cashwin.getitemnumber(1, "c_totalamt")
		if ld_outstandingamt - ld_amtrecvd <= 0.0 then
			ld_outstandingamt = 0.00
		else
			ld_outstandingamt = ld_outstandingamt - ld_amtrecvd
		end if
	end if
	this.id_master.setitem(ll_masterrow, "outstandingamt", ld_outstandingamt)
	return 0

// w_service.wf_show_studentledger() returns 0
	long ll_studentcode
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 and this.id_master.getrow() > 0 then
			ll_studentcode = this.id_master.object.studentcode[this.id_master.getrow()]
		end if
	elseif this.tab_retrieve.selectedtab = 2 and (this.id_list.rowcount() > 0 and this.id_list.getrow() > 0) then
		ll_studentcode = this.id_list.object.studentcode[this.id_list.getrow()]
	end if
	if not isnull(ll_studentcode) and ll_studentcode <> 0 then
		SQL rollback USING sqlca;
		sqlca.virtualgl("A")
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		openwithparm(w_student_ledger, ll_studentcode)
	end if

// w_service.wf_setstudentinfo(long al_code) returns long
	long ll_doctcode
	long ll_custcode
	long ll_retcode
	string ls_regno
	string ls_aliasname
	SQL SELECT Student.RegNo , Student.CustCode , Accounts.AliasName INTO :ls_regno, :ll_custcode, :ls_aliasname FROM Student , Accounts WHERE Student.StudentCode =:al_code AND Student.CustCode =Accounts.AccCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.setitem(this.id_master.rowcount(), "Studentregno", ls_regno)
		this.id_master.setitem(this.id_master.rowcount(), "custcode", ll_custcode)
		this.id_master.setitem(this.id_master.rowcount(), "aliasname", ls_aliasname)
		this.id_master.object.custcode.protect = 1
		this.id_master.object.aliasname.protect = 1
		wf_set_studentbalance(al_code)
		wf_set_customerbalance(this.id_master.object.custcode[this.id_master.rowcount()], this.id_master.rowcount())
		wf_enforce_custallowedservices(ll_custcode)
		ll_retcode = 1
	else
		messagebox("Student Information", "Problem in retrieving corresponding customer")
		ll_retcode = 0
	end if
	return ll_retcode

// w_service.wf_set_studentinlist(string as_data) returns 0
	long ll_rowno
	if as_data <> "" and not isnull(as_data) then
		ll_rowno = this.idc_student.find("student >='" + as_data + "'", 1, this.idc_student.rowcount())
	elseif this.idc_student.rowcount() > 0 then
		ll_rowno = 1
	else
		ll_rowno = 0
	end if
	if ll_rowno > 0 then
		this.idc_student.selectrow(0, false)
		this.idc_student.setrow(ll_rowno)
		this.idc_student.scrolltorow(ll_rowno)
		this.idc_student.selectrow(ll_rowno, true)
	end if

// w_service.wf_get_studentinfo(long row, string data) returns long
	long ll_code
	long ll_counter
	long ll_studentcode
	string ls_null
	setnull(ls_null)
	ll_code = long(data)
	if not isnull(data) then
		if wf_setstudentinfo(ll_code) = 0 then
			messagebox("Database Error", "Student information can not be retrieved")
			return 1
		end if
	elseif isnull(data) then
		this.id_master.object.custcode.protect = 0
		this.id_master.object.aliasname.protect = 0
		if this.ii_servicetype = 11 then
			this.id_master.setitem(1, "custcode", 22)
		else
			this.id_master.setitem(1, "custcode", 19)
		end if
		this.id_master.setitem(1, "aliasname", "")
	elseif data = "0" then
		messagebox("Database Error", "Student information can not be retrieved")
		return 1
	end if
	if this.id_master.accepttext() = -1 then
		return 1
	end if
	setredraw(true)
	return 0

// w_service.wf_new_studentregistration() returns long
	string ls_regno
	long ll_studentcode
	long ll_found
	long ll_row
	dwobject dwo
	ll_studentcode = this.id_master.object.studentcode[1]
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5090", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		openwithparm(w_studentregisteration, ll_studentcode)
		ls_regno = message.stringparm
		if not (ls_regno = "" or isnull(ls_regno)) then
			wf_student_retrieve()
			ll_found = 0
			ll_found = this.idc_student.find("regno = '" + ls_regno + "'", 1, this.idc_student.rowcount())
			if ll_found > 0 and ll_found <= this.idc_student.rowcount() then
				this.id_master.setitem(1, "studentregno", this.idc_student.getitemstring(ll_found, "regno"))
				ll_studentcode = this.idc_student.getitemnumber(ll_found, "code")
				this.id_master.setitem(1, "studentcode", ll_studentcode)
				dwo = this.id_master.object.studentcode
				this.id_master.post event itemchanged(1, dwo, string(ll_studentcode))
			end if
		end if
	end if
	return 0

// w_service.wf_generate_student_absentfine() returns long
	boolean lb_listtab
	s_arguements lstr_arg
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab and wf_iseditable() = false then
		open(w_arg_students)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = 1 then
			openwithparm(w_generate_services_academicclass3, lstr_arg)
		end if
