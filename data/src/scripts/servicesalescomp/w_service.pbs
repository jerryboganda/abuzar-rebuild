// w_service.wf_replicate_qty_print(long al_code) returns long
	long ll_counter
	long ll_innercounter
	long ll_insrow
	long ll_rowcount
	long ll_retcode
	double ld_qty
	this.id_printticket.dataobject = this.id_print.dataobject
	this.id_printticket.settransobject(this.it_transobject)
	ll_rowcount = this.id_printticket.retrieve(al_code)
	if gs_company = "MAGICPLANET" and this.id_printticket.rowcount() > 0 then
		this.id_print.reset()
		for ll_counter = 1 to this.id_printticket.rowcount()
			ld_qty = this.id_printticket.object.qty[ll_counter]
			for ll_innercounter = 1 to long(ld_qty)
				if this.id_print.rowcount() > 0 then
					this.id_print.deleterow(ll_insrow)
				end if
				ll_insrow = this.id_print.insertrow(0)
				this.id_print.object.serverdate[ll_insrow] = this.id_printticket.object.serverdate[ll_counter]
				this.id_print.object.serviceinvcode[ll_insrow] = this.id_printticket.object.serviceinvcode[ll_counter]
				this.id_print.object.headerno[ll_insrow] = this.id_printticket.object.headerno[ll_counter]
				this.id_print.object.itemname[ll_insrow] = this.id_printticket.object.itemname[ll_counter]
				this.id_print.object.qty[ll_insrow] = 1
				this.id_print.object.price[ll_insrow] = this.id_printticket.object.price[ll_counter]
				this.id_print.object.serviceflatdisc[ll_insrow] = this.id_printticket.object.serviceflatdisc[ll_counter]
				this.id_print.object.servicedetail_discperc[ll_insrow] = this.id_printticket.object.servicedetail_discperc[ll_counter]
				ll_retcode = 1
				this.id_print.print()
			next
		next
	end if
	return ll_retcode

// w_service.wf_import_serviceinvoices_from_datacarry() returns long
	boolean lb_listtab
	integer li_usercode
	string ls_error
	s_arguements lstr_arg
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab and wf_iseditable() = false then
		open(w_populate_services_from_datacarrydb)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = 1 then
			li_usercode = gl_usercode
			this.it_transobject.import_servicesales_from_datacarrydb(gs_inlinkserver, gs_inlinkserverdb, gs_inlinkserverowner, lstr_arg.l_code1, lstr_arg.l_code2, 0, li_usercode)
			if this.it_transobject.sqlcode = 0 then
				SQL commit USING this.it_transobject;
			else
				ls_error = this.it_transobject.sqlerrtext
				messagebox("Problem in Import Of Service Sales", "Import Of Service Sales from Data Carry Failed. Reasons are:-~r~n" + ls_error, stopsign!)
			end if
		end if
	end if
	return 0

// w_service.wf_raise_doctorbased_purofservice(long al_serviceinvcode, long al_usercode) returns long
	long ll_retcode
	if al_serviceinvcode > 0 and al_usercode > 0 and f_stringpreferences("raisedoctorsharebasedpurofsvconposting") = "Y" then
		this.it_transobject.autogeneratepurchaseofservice_doctorsharebased(al_serviceinvcode, al_usercode)
		if this.it_transobject.sqlcode = 0 then
			ll_retcode = 0
		else
			messagebox("Auto Generation of Purchase of Service", "Problems Occured in Purchase of Service Auto Generation.~r~nReasons Are:-" + this.it_transobject.sqlerrtext)
			ll_retcode = -1
		end if
	end if
	return ll_retcode

// w_service.wf_check_lockerstatus() returns integer
	long ll_code
	long ll_lockercode
	long ll_old_lockercode
	long ll_lastserviceinvcode
	string ls_occupied
	ll_code = this.id_master.object.code[1]
	if ll_code > 0 then
		SQL SELECT LockerCode INTO :ll_old_lockercode FROM ServiceHeader WHERE ServiceInvCode =:ll_code USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			ll_old_lockercode = -1
		end if
	else
		ll_old_lockercode = -1
	end if
	ll_lockercode = this.id_master.object.lockercode[1]
	if ll_lockercode > 0 and ll_lockercode <> ll_old_lockercode then
		SQL SELECT Occupied , LastServiceInvCode INTO :ls_occupied, :ll_lastserviceinvcode FROM Locker WHERE LockerCode =:ll_lockercode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if ls_occupied = "Y" then
				messagebox("Locker Occupancy", "Locker Already Occupied.", stopsign!)
				this.id_master.setcolumn("lockercode")
				this.id_master.setfocus()
				return -1
			else
				return 0
			end if
		else
			messagebox("Locker Occupancy", "Locker Occupancy can not be determined.~r~nReasons are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
			return -1
		end if
		return
	end if
	return 0

// w_service.wf_update_lockerstatus() returns long
	long ll_code
	long ll_lockercode
	long ll_old_lockercode
	long ll_lastserviceinvcode
	string ls_occupied
	ll_code = this.id_master.object.code[1]
	if ll_code > 0 then
		SQL SELECT LockerCode INTO :ll_old_lockercode FROM ServiceHeader WHERE ServiceInvCode =:ll_code USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			ll_old_lockercode = -1
		end if
	else
		ll_old_lockercode = -1
	end if
	ll_lockercode = this.id_master.object.lockercode[1]
	if ll_lockercode > 0 and ll_lockercode <> ll_old_lockercode then
		if ll_old_lockercode > 0 then
			SQL update Locker SET Occupied ='N' WHERE LockerCode =:ll_old_lockercode USING this.it_transobject;
		end if
		SQL update Locker SET Occupied ='Y' , LastServiceInvCode =:ll_code WHERE LockerCode =:ll_lockercode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			return 0
		else
			messagebox("Locker Occupancy", "Unable to update Locker Occupancy status.~r~nReasons are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
			return -1
		end if
		return
	end if
	return 0

// w_service.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_footerdw, string as_listdw, string as_printdw) returns 0
	this.id_master.dataobject = as_masterdw
