// window w_service (servicesalescomp)  ancestor: w_multi_entry

// w_service.ue_printdo() returns 0 [event]
	long ll_custcode
	long ll_row
	string ls_custname
	if this.im_menu.m_file.m_save.enabled = true then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	this.id_print.dataobject = "d_deliveryorder_half"
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(this.id_master.getitemnumber(1, "code"))
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_service.ue_save_withnocommit() returns long [event]
	setpointer(hourglass!)
	if f_validatedw(this.id_master) < 0 then
		return -1
	end if
	if f_validatedw(this.id_detail) < 0 then
		return -2
	end if
	if this.id_master.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -3
	end if
	if this.id_detail.update() < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return -4
	end if
	setpointer(arrow!)
	return 0

// w_service.ue_print_service_slip() returns 0 [event]
	long ll_row
	long ll_invcode
	long ll_rows
	integer li_option
	boolean lb_listtab
	s_datastore lstr
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab = false then
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	if ll_invcode > 0 then
		this.id_print.dataobject = wf_get_service_slip()
		this.id_print.settransobject(sqlca)
		ll_rows = this.id_print.retrieve(ll_invcode)
		if this.id_print.rowcount() > 0 then
			if lb_listtab then
				lstr.dw = this.id_print
				lstr.s_name1 = this.id_print.dataobject
				openwithparm(w_preview_invoices, lstr)
				lstr = message.powerobjectparm
			end if
			if lstr.i_closemode = 1 then
				if f_stringpreferences("PromptBeforePrinting") = "Y" then
					if printsetup() < 0 then
						messagebox("Printer", "Printing Error")
						this.id_print.printcancel()
					end if
					return
				end if
				if this.id_print.print() < 0 then
					messagebox("Printing", "Can not Print Service Slip.", information!)
				end if
			end if
		end if
	end if

// w_service.ue_print_ticket() returns 0 [event]
	long ll_custcode
	long ll_row
	long ll_invcode
	string ls_custname
	string ls_printout
	integer li_option
	boolean lb_listtab
	s_datastore lstr
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	if gs_company = "RAWALDENTALHSP" then
		ls_printout = "d_rawaldentalhsp_serviceticket_printout"
	else
		ls_printout = "d_service_serviceticket_printout"
	end if
	this.id_printticket.dataobject = ls_printout
	this.id_printticket.settransobject(this.it_transobject)
	this.id_printticket.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_printticket
		lstr.s_name1 = this.id_printticket.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_printticket.printcancel()
	end if
	if this.id_printticket.rowcount() > 0 then
		if this.id_printticket.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_service.ue_enforcedefaultfocussettings(integer ai_editmode) returns 0 [event]
	string ls_focuscolsetting
	string ls_setting
	if this.ii_servicetype = 10 then
		ls_focuscolsetting = f_stringpreferences("CashServiceInitialFocus")
	else
		ls_focuscolsetting = f_stringpreferences("CreditServiceInitialFocus")
	end if
	if ls_focuscolsetting = "detailwindow" then
		post event ue_setitemfocus(ai_editmode)
		return
	end if
	ls_setting = this.id_master.describe(trim(ls_focuscolsetting) + ".visible")
	if trim(ls_setting) = "1" then
		this.id_master.setcolumn(ls_focuscolsetting)
		this.id_master.setfocus()
		return
	end if
	if this.ii_servicetype = 10 then
		post event ue_setitemfocus(ai_editmode)
		return
	end if
	this.id_master.setfocus()

// w_service.ue_setitemfocus(integer ai_editmode) returns 0 [event]
	string ls_null
	setnull(ls_null)
	if f_stringpreferences("itemcode") = "Y" then
		this.id_detail.setcolumn("fullcode")
		this.id_detail.setfocus()
		return
	end if
	if ai_editmode = 0 then
		this.id_detail.setitem(this.id_detail.getrow(), "itemname", " ")
	end if
	this.id_detail.setcolumn("itemname")
	this.id_detail.setfocus()
	if ai_editmode = 0 then
		this.id_detail.setitem(this.id_detail.getrow(), "itemname", ls_null)
	end if

// w_service.wf_setsuppinfo(long al_suppcode, datawindow ad_master) returns 0
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	SQL SELECT supplier.address1 , supplier.city , supplier.phone INTO :ls_address, :ls_city, :ls_phone FROM supplier WHERE supplier.suppcode =:al_suppcode USING this.it_transobject;
	ll_currow = ad_master.getrow()
	ad_master.object.supplier_address[ll_currow] = ls_address
	ad_master.object.supplier_city[ll_currow] = ls_city
	ad_master.object.supplier_phone[ll_currow] = ls_phone

// w_service.wf_customerinfo(long al_custcode) returns integer
	string ls_address
	string ls_city
	string ls_phone
	string ls_aliasname
	long ll_currow
	double ld_currbalance
	SQL SELECT customer.address1 , customer.city , customer.phone , aliasname =( select a.aliasname from accounts a where a.acccode =customer.custcode ) INTO :ls_address, :ls_city, :ls_phone, :ls_aliasname FROM customer WHERE customer.custcode =:al_custcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_currow = this.id_master.getrow()
		this.id_master.object.aliasname[ll_currow] = ls_aliasname
		this.id_master.object.address[ll_currow] = ls_address
		this.id_master.object.city[ll_currow] = ls_city
		this.id_master.object.phone[ll_currow] = ls_phone
	end if
	return this.it_transobject.sqlcode

// w_service.wf_genfullcode(long al_icode, string as_fullcode) returns integer
	integer li_retflag
	string ls_fullcode
	long icode
	long iccode
	long icatcode
	long packcode
	long manfcode
	SQL SELECT customicode INTO :ls_fullcode FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		li_retflag = 1
		as_fullcode = ls_fullcode
	else
		li_retflag = this.it_transobject.sqlcode
	end if
	return li_retflag

// w_service.wf_setiteminfo(long al_icode, long al_row, double ad_saleprice, double ad_discperc, long al_stock, double ad_avgprice, long al_totalstock, double ad_purdiscperc) returns 0
	this.id_detail.setitem(al_row, "saleprice", ad_saleprice)
	if this.ii_saletype = 2 then
		this.id_detail.setitem(al_row, "discperc", ad_discperc)
	else
		this.id_detail.setitem(al_row, "discperc", 0.0)
	end if
	this.id_detail.setitem(al_row, "rate", ad_saleprice)
	this.id_detail.setitem(al_row, "avgprice", ad_avgprice)
	this.id_footer.object.icode[this.id_footer.getrow()] = al_icode
	this.id_footer.object.stock[this.id_footer.getrow()] = al_stock

// w_service.wf_getmaxdate(datetime ad_date) returns integer
	SQL Select Max ( Date ) INTO :ad_date From saleledger USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_service.wf_locksaleinvoice(long al_saleinvcode) returns integer
	integer li_count
	this.it_transobject.dbparm = " Async =1, DBGetTime = 20"
	this.it_transobject.locksaleinvoice(al_saleinvcode)
	this.it_transobject.dbparm = "Async =0, DBGetTime = 0"
	return this.it_transobject.sqlcode

// w_service.wf_getsalesstockinfo(long al_saleinvcode, long al_gcode, long al_icode, long al_saleqty) returns integer
	SQL Select IsNull ( Sum ( saledetail.looseqty ) , 0 ) INTO :al_saleqty from saledetail where saledetail.saleinvcode =:al_saleinvcode and saledetail.gcode =:al_gcode and saledetail.icode =:al_icode USING this.it_transobject;
	if isnull(al_saleqty) then
		al_saleqty = 0
	end if
	return this.it_transobject.sqlcode

// w_service.wf_savastemplate() returns integer
	s_saletemplateheader lstr_templateheader
	long ll_invid
	integer li_retcode
	long ll_code
	long ll_qty
	long ll_icode
	long ll_totalrows
	long ll_rowcount
	open(w_savesaleastemplate)
	lstr_templateheader = message.powerobjectparm
	f_newtableid("SaleTemplateHeader", ll_invid)
	SQL INSERT INTO SaleTemplateHeader ( saletemplatecode , date , modified , name ) values ( :ll_invid , :lstr_templateheader.dt_templatedate , :lstr_templateheader.dt_templatedate , :lstr_templateheader.s_template ) USING this.it_transobject;
	ll_totalrows = this.id_detail.rowcount()
	for ll_rowcount = 1 to ll_totalrows
		ll_code = ll_invid
		ll_icode = this.id_detail.getitemnumber(ll_rowcount, "icode")
		ll_qty = this.id_detail.getitemnumber(ll_rowcount, "looseqty")
		SQL insert into saletemplatedetail ( saletemplatecode , icode , looseqty ) values ( :ll_code , :ll_icode , :ll_qty ) USING this.it_transobject;
	next
	setpointer(hourglass!)
	if this.it_transobject.sqlcode < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return li_retcode
	else
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Template saved", exclamation!, ok!, 1)
	end if
	return li_retcode

// w_service.wf_getitemassociategcode(long la_icode) returns integer
	integer li_gcode
	SQL Select Gcode INTO :li_gcode From item Where icode =:la_icode USING this.it_transobject;
	return li_gcode

// w_service.wf_print() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_count
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			for ll_count = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
				this.id_print.retrieve(ll_count)
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			next
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	return li_errcode

// w_service.wf_preinvinfo() returns 0
