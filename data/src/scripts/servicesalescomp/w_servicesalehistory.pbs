// window w_servicesalehistory (servicesalescomp)  ancestor: window

// w_servicesalehistory.create() returns 0 [event]
	this.cb_print = create cb_print
	this.dw_itemsalehistory = create dw_itemsalehistory
	this.control = {this.cb_print, this.dw_itemsalehistory}

// w_servicesalehistory.destroy() returns 0 [event]
	destroy this.cb_print
	destroy this.dw_itemsalehistory

// w_servicesalehistory.open() returns long [event]
	s_itemsalehistory ls_itemsalehistory
	long ll_width
	long ll_height
	environment env
	ls_itemsalehistory = message.powerobjectparm
	if getenvironment(env) <> 1 then
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.width = ll_width * 0.98
	this.height = ll_height * 0.90
	this.y = int((ll_height - this.height) / 2.0)
	this.dw_itemsalehistory.width = this.width - this.width * 0.02
	this.dw_itemsalehistory.height = this.height * 0.90
	this.cb_print.y = this.dw_itemsalehistory.height + 20
	this.dw_itemsalehistory.settransobject(sqlca)
	this.dw_itemsalehistory.retrieve(ls_itemsalehistory.ar_icode, ls_itemsalehistory.ar_date)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_servicesalehistory.close() returns long [event]
	close(this)
	return ::message.returnvalue

// w_servicesalehistory.key(keycode key, unsignedlong keyflags) returns long [event]
	if keydown(keyescape!) then
		close(this)
	end if
	return ::message.returnvalue

// cb_print.clicked() returns long [event]
	if parent.dw_itemsalehistory.visible then
		if printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			parent.dw_itemsalehistory.printcancel()
		end if
		parent.dw_itemsalehistory.print()
	end if
	return ::message.returnvalue
