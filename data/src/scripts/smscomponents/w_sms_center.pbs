// cb_save_schedule.clicked() returns long [event]
	string ls_jobname
	string ls_schedulename
	string ls_hr
	string ls_min
	string ls_sec
	string ls_activetime
	string ls_ampm
	string ls_errtext
	integer li_unitvalue
	integer li_unit
	integer li_hr
	long ll_activetime
	ls_jobname = gs_autocreatescheduledsmsjob
	ls_schedulename = gs_autocreatescheduledsmsjobschedule
	if parent.parent.parent.tab_smscenter.tabpage_schedule.cbx_activate.checked = true then
		if parent.parent.parent.tab_smscenter.tabpage_schedule.rb_once.checked = true then
			ls_hr = parent.parent.parent.tab_smscenter.tabpage_schedule.ddlb_hr.text
			ls_min = parent.parent.parent.tab_smscenter.tabpage_schedule.ddlb_min.text
			ls_sec = parent.parent.parent.tab_smscenter.tabpage_schedule.ddlb_sec.text
			ls_ampm = parent.parent.parent.tab_smscenter.tabpage_schedule.ddlb_time.text
			if isnull(ls_hr) or ls_hr = "" or ls_hr = "none" then
				messagebox(" Time Validation", "Please select hours from dropdown box.")
				parent.parent.parent.tab_smscenter.tabpage_schedule.ddlb_hr.setfocus()
				return ::message.returnvalue
			elseif isnull(ls_min) or ls_min = "" or ls_min = "none" then
				messagebox(" Time Validation", "Please select minutes from dropdown box.")
				parent.parent.parent.tab_smscenter.tabpage_schedule.ddlb_min.setfocus()
				return ::message.returnvalue
			elseif isnull(ls_sec) or ls_sec = "" or ls_sec = "none" then
				messagebox(" Time Validation", "Please select seconds from dropdown box.")
				parent.parent.parent.tab_smscenter.tabpage_schedule.ddlb_sec.setfocus()
				return ::message.returnvalue
			elseif isnull(ls_ampm) or ls_ampm = "" or ls_ampm = "none" then
				messagebox(" Time Validation", "Please select AM/PM from dropdown box.")
				parent.parent.parent.tab_smscenter.tabpage_schedule.ddlb_time.setfocus()
				return ::message.returnvalue
			end if
			li_hr = integer(ls_hr)
			if ls_ampm = "PM" then
				if li_hr < 12 then
					li_hr = li_hr + 12
				end if
			elseif li_hr = 12 then
				li_hr = 0
			end if
			ls_activetime = string(li_hr) + ls_min + ls_sec
			ll_activetime = long(ls_activetime)
			li_unit = 1
			li_unitvalue = 0
		else
			if parent.parent.parent.tab_smscenter.tabpage_schedule.dw_schedule.accepttext() = 1 then
				li_unitvalue = parent.parent.parent.tab_smscenter.tabpage_schedule.dw_schedule.getitemnumber(1, "unitvalue")
				li_unit = parent.parent.parent.tab_smscenter.tabpage_schedule.dw_schedule.getitemnumber(1, "unit")
				if li_unit = 4 then
					if not (li_unitvalue >= 1 and li_unitvalue <= 1440) then
						messagebox(" Time Validation", "Please enter valid value for minutes between 1 and 1440.")
						parent.parent.parent.tab_smscenter.tabpage_schedule.dw_schedule.setcolumn(1)
						parent.parent.parent.tab_smscenter.tabpage_schedule.dw_schedule.setfocus()
						return ::message.returnvalue
					end if
				elseif li_unit = 8 then
					if not (li_unitvalue >= 1 and li_unitvalue <= 24) then
						messagebox(" Time Validation", "Please enter valid value for hours between 1 and 24.")
						parent.parent.parent.tab_smscenter.tabpage_schedule.dw_schedule.setcolumn(2)
						parent.parent.parent.tab_smscenter.tabpage_schedule.dw_schedule.setfocus()
						return ::message.returnvalue
					end if
				else
					messagebox(" Time Validation", "Please select minutes/hours from dropdown list box")
					parent.parent.parent.tab_smscenter.tabpage_schedule.dw_schedule.setcolumn(2)
					parent.parent.parent.tab_smscenter.tabpage_schedule.dw_schedule.setfocus()
					return ::message.returnvalue
				end if
			else
				messagebox(" Time Validation", "Please enter valid value for a unit.")
				parent.parent.parent.tab_smscenter.tabpage_schedule.dw_schedule.setcolumn(1)
				parent.parent.parent.tab_smscenter.tabpage_schedule.dw_schedule.setfocus()
				return ::message.returnvalue
			end if
			ll_activetime = 0
		end if
		sqlca.adjustjobschedule(ls_jobname, ls_schedulename, ll_activetime, li_unit, li_unitvalue)
		sqlca.activatejob(ls_jobname, 1)
	else
		sqlca.activatejob(ls_jobname, 0)
	end if
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
		messagebox("Schedule Setting", "Successfully Saved Schedule Settting")
	else
		ls_errtext = "Problem while Saving Schedule Settting~r~nReasons Are" + sqlca.sqlerrtext
		SQL rollback USING sqlca;
		messagebox("Schedule Setting", ls_errtext)
	end if
	return ::message.returnvalue

// rb_every.clicked() returns long [event]
	if this.checked = true then
		parent.parent.parent.tab_smscenter.tabpage_schedule.dw_schedule.enabled = true
		parent.parent.parent.tab_smscenter.tabpage_schedule.ddlb_hr.enabled = false
		parent.parent.parent.tab_smscenter.tabpage_schedule.ddlb_min.enabled = false
		parent.parent.parent.tab_smscenter.tabpage_schedule.ddlb_sec.enabled = false
		parent.parent.parent.tab_smscenter.tabpage_schedule.ddlb_time.enabled = false
	end if
	return ::message.returnvalue

