		parent.parent.parent.tab_smscenter.tabpage_schedule.rb_every.enabled = true
		parent.parent.parent.tab_smscenter.tabpage_schedule.dw_schedule.enabled = false
		parent.parent.parent.tab_smscenter.tabpage_schedule.ddlb_hr.enabled = true
		parent.parent.parent.tab_smscenter.tabpage_schedule.ddlb_min.enabled = true
		parent.parent.parent.tab_smscenter.tabpage_schedule.ddlb_sec.enabled = true
		parent.parent.parent.tab_smscenter.tabpage_schedule.ddlb_time.enabled = true
	else
		parent.parent.parent.tab_smscenter.tabpage_schedule.rb_every.enabled = false
		parent.parent.parent.tab_smscenter.tabpage_schedule.rb_once.enabled = false
		parent.parent.parent.tab_smscenter.tabpage_schedule.dw_schedule.enabled = false
		parent.parent.parent.tab_smscenter.tabpage_schedule.ddlb_hr.enabled = false
		parent.parent.parent.tab_smscenter.tabpage_schedule.ddlb_min.enabled = false
