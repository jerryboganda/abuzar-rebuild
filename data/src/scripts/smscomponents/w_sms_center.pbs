// w_sms_center.wf_sendsms_pdumode(string as_smsto, string as_smstext, ref string as_errtext) returns long
	integer li_pdu_length
	integer li_totsms
	integer li_smscounter
	integer li_start
	long ll_retcode
	long ll_init
	long ll_msgidentifier = 1
	boolean lb_portopen
	string ls_command
	string ls_response
	string ls_pdu_str
	string ls_finalmsg
	string ls_thissmstext
	runtimeerror ex
	if as_smstext = "" or isnull(as_smstext) then
		as_smstext = ""
	end if
	try
		li_totsms = ceiling(len(as_smstext) / 130.0)
		li_start = 1
		if li_totsms > 1 then
			randomize(0)
			ll_msgidentifier = rand(200)
		end if
		for li_smscounter = 1 to li_totsms
			ls_thissmstext = mid(as_smstext, li_start, 130)
			if li_totsms > 1 and li_smscounter > 1 then
				sleep(3000)
			end if
			li_pdu_length = 0
			ls_pdu_str = wf_encode_sms_in_pdu(ls_thissmstext, as_smsto, li_pdu_length, li_totsms, li_smscounter, ll_msgidentifier)
			ls_finalmsg = ls_pdu_str
			li_start = li_start + 130
			if wf_initialize() = 1 then
				ls_command = "AT+CMGF=0~r~n"
				this.ole_device.object.output = trim(ls_command)
				sleep(500)
				ls_response = upper(this.ole_device.object.input)
				if match(ls_response, "OK") then
					ls_command = "AT+CMGS=" + trim(string(li_pdu_length)) + "~r~n"
					this.ole_device.object.output = trim(ls_command)
					sleep(1000)
					ls_response = upper(this.ole_device.object.input)
					if match(ls_response, ">") then
						ls_command = ls_finalmsg + chara(26)
						this.ole_device.object.output = ls_command
						sleep(500)
						ls_response = upper(this.ole_device.object.input)
						if match(ls_response, "ERROR") then
							as_errtext = ls_response
							ll_retcode = 1
							exit
						else
							ll_retcode = 0
						end if
					else
						as_errtext = "3~r~n" + ls_response
						ll_retcode = 3
						exit
					end if
				else
					as_errtext = "4~r~n" + ls_response
					ll_retcode = 4
					exit
				end if
			else
				as_errtext = "5~r~n" + ls_response
				ll_retcode = 5
				exit
			end if
		next
	catch (throwable ex)
		ll_retcode = 7
		messagebox("Com Port Exception", "Com Port Exception Occurred.~r~nDetails are:~r~n" + ex.getmessage())
	end try
	return ll_retcode

// w_sms_center.wf_get_sms_center() returns string
	string ls_smsc
	string ls_command
	string ls_response
	string ls_temp
	long ll_counter
	ls_command = "AT+CSCA?~r~n"
	this.ole_device.object.output = ls_command
	sleep(500)
	ls_response = upper(this.ole_device.object.input)
	if match(ls_response, "OK") then
		if pos(ls_response, ls_command) > 0 then
			ls_smsc = mid(ls_response, pos(ls_response, ls_command) + len(ls_command), len(ls_response))
		else
			ls_smsc = ls_response
		end if
		ls_smsc = trim(wf_remove_whitespace(ls_smsc))
		if pos(ls_smsc, " OK") > 0 then
			ls_temp = trim(left(ls_smsc, pos(ls_smsc, " OK") - 1))
			ls_smsc = ls_temp
			ls_smsc = mid(ls_temp, pos(ls_temp, "+CSCA:") + len("+CSCA:"), len(ls_temp) - len("+CSCA:"))
		end if
	else
		ls_smsc = "N/A"
	end if
	return ls_smsc

// w_sms_center.wf_set_sms_centre() returns string
	string ls_smsc
	string ls_command
	string ls_response
	string ls_temp
	long ll_counter
	long ll_portno
	long ll_portstatus
	long ll_row
	boolean lb_portopen
	s_arguements lstr_arg
	ll_row = this.id_device.getrow()
	open(w_arg_smscenter)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 and ll_row > 0 then
		ls_smsc = lstr_arg.s_name1
		ll_portno = this.id_device.object.portno[ll_row]
		ll_portstatus = this.id_device.object.portstatus[ll_row]
		if ll_portno > 0 and ll_portstatus > 0 then
			lb_portopen = wf_open_port(ll_portno)
		end if
		if lb_portopen then
			ls_command = "AT+CSCA=~"" + ls_smsc + "~",145"
			this.ole_device.object.output = ls_command
			sleep(500)
			ls_response = upper(this.ole_device.object.input)
			if match(ls_response, "OK") then
				if pos(ls_response, ls_command) > 0 then
					ls_smsc = mid(ls_response, pos(ls_response, ls_command) + len(ls_command), len(ls_response))
				else
					ls_smsc = ls_response
				end if
				ls_smsc = trim(wf_remove_whitespace(ls_smsc))
				if pos(ls_smsc, " OK") > 0 then
					ls_temp = trim(left(ls_smsc, pos(ls_smsc, " OK") - 1))
					ls_smsc = ls_temp
				end if
			else
				ls_smsc = "N/A"
			end if
			this.ole_device.object.portopen = false
		end if
	end if
	return ls_smsc

// w_sms_center.wf_get_signal_strength() returns string
	string ls_signal
	string ls_command
	string ls_response
	string ls_temp
	string ls_temp1
	string ls_temp2
	long ll_counter
	ls_command = "AT+CSQ~r~n"
	this.ole_device.object.output = ls_command
	sleep(500)
	ls_response = upper(this.ole_device.object.input)
	if match(ls_response, "OK") then
		if pos(ls_response, ls_command) > 0 then
			ls_signal = mid(ls_response, pos(ls_response, ls_command) + len(ls_command), len(ls_response))
		else
			ls_signal = ls_response
		end if
		ls_signal = trim(wf_remove_whitespace(ls_signal))
		if pos(ls_signal, " OK") > 0 then
			ls_temp = trim(left(ls_signal, pos(ls_signal, " OK") - 1))
			ls_signal = ls_temp
			ls_signal = mid(ls_temp, pos(ls_temp, "+CSQ:") + len("+CSQ:"), len(ls_temp) - len("+CSQ:"))
			ls_temp = trim(ls_signal)
			ls_temp1 = mid(ls_temp, 1, pos(ls_temp, ",") - 1)
			ls_temp2 = mid(ls_temp, pos(ls_temp, ",") + 1, len(ls_temp))
			if integer(ls_temp1) <= 9 then
				ls_signal = "Marginal"
			elseif integer(ls_temp1) <= 14 then
				ls_signal = "OK"
			elseif integer(ls_temp1) <= 19 then
				ls_signal = "Good"
			elseif integer(ls_temp1) >= 20 then
				ls_signal = "Excellent"
			end if
			if len(trim(ls_temp2)) > 0 then
				ls_signal = ls_signal + ", Level = " + ls_temp2 + "dBm "
			end if
		end if
	else
		ls_signal = "N/A"
	end if
	return ls_signal

// w_sms_center.wf_get_battery_status() returns string
	string ls_battery
	string ls_command
	string ls_response
	string ls_temp
	string ls_temp2
	long ll_counter
	ls_command = "AT+CBC~r~n"
	this.ole_device.object.output = ls_command
	sleep(500)
	ls_response = upper(this.ole_device.object.input)
	if match(ls_response, "OK") then
		if pos(ls_response, ls_command) > 0 then
			ls_battery = mid(ls_response, pos(ls_response, ls_command) + len(ls_command), len(ls_response))
		else
			ls_battery = ls_response
		end if
		ls_battery = trim(wf_remove_whitespace(ls_battery))
		if pos(ls_battery, " OK") > 0 then
			ls_temp = trim(left(ls_battery, pos(ls_battery, " OK") - 1))
			ls_battery = ls_temp
			ls_battery = mid(ls_temp, pos(ls_temp, "+CBC:") + len("+CBC:"), len(ls_temp) - len("+CBC:"))
			ls_temp = trim(ls_battery)
			ls_temp2 = mid(ls_temp, pos(ls_temp, ",") + 1, len(ls_temp) - 1) + "%"
			if left(ls_temp, 1) = "0" then
				ls_battery = "Battery Powered, " + ls_temp2 + " Remaining"
			elseif left(ls_temp, 1) = "1" then
				ls_battery = "Battery Powered and Connected, " + ls_temp2 + " Remaining"
			elseif left(ls_temp, 1) = "2" then
				ls_battery = "Device Not Connected to Battery."
			elseif left(ls_temp, 1) = "3" then
				ls_battery = "Recognized power fault, calls inhibited"
			end if
		end if
	else
		ls_battery = "N/A"
	end if
	return ls_battery

// w_sms_center.wf_encode_sms_in_pdu(string as_userdata, string as_destaddress, ref integer ai_pdu_length, integer ai_totsms, integer ai_thissmsno, integer ai_msgidentifier) returns string
	string ls_pdu_str
	oleobject ole_pdu
	integer result
	ole_pdu = create oleobject
	result = ole_pdu.connecttonewobject("MyPDUConverter.pduconverter")
	if result = 0 then
		ls_pdu_str = ole_pdu.__invoke_method("encodepdu", 6, {as_userdata, as_destaddress, ai_pdu_length, ai_totsms, ai_thissmsno, ai_msgidentifier}, true)
	else
		messagebox("connection failure", "Connection failure. Error Code = " + string(result))
	end if
	destroy ole_pdu
	if result < 0 then
		setnull(ls_pdu_str)
	end if
	return ls_pdu_str

// w_sms_center.wf_send_websms(long al_row) returns long
	integer li_pdu_length
	integer li_res
	integer li_ret
	long ll_smscode
	long ll_retcode
	long ll_sms_sended = 1
	string ls_smstext
	string ls_smsto
	string ls_errtext = "                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        0"
	string ls_lang = "En"
	string ls_reponsetype = "xml"
	string ls_userid
	string ls_password
	string ls_mask
	string ls_url
	string ls_temp
	string ls_parm
	string ls_key
	inet iinet_base
	u_websms_result lu_websms_result
	nc_urlencode l_nc_urlencode
	soapconnection conn
	basichttpbinding_icorporatecbs proxy_obj
	long rval
	long llog
	long ll_ret
	string str_endpoint
	string ls_response
	quicksmsresquest obj_quicksms
	soapexception e
	blob lblb_args
	string ls_headers
	long ll_length
	ls_userid = f_stringpreferences("WEBSMSUserID")
	ls_password = f_stringpreferences("WEBSMSPassword")
	ls_mask = f_stringpreferences("WEBSMSMask")
	ls_key = f_stringpreferences("WebSMSAPIKey")
	setpointer(hourglass!)
	if al_row > 0 then
		ll_smscode = this.id_outbox.object.smscode[al_row]
		ls_smsto = trim(this.id_outbox.object.smsto[al_row])
		ls_smstext = trim(this.id_outbox.object.smstext[al_row])
		if isnull(ls_smstext) then
			ls_smstext = ""
		end if
		if f_stringpreferences("WebSMSProvider") = "Z" then
			proxy_obj = create basichttpbinding_icorporatecbs
			str_endpoint = "http://cbs.zong.com.pk/ReachCWSv2/CorporateSMS.svc?Service1"
			conn = create soapconnection
			llog = conn.setoptions("SoapLog='C:\mySoapLog.log', UserID='" + ls_userid + "',Password='" + ls_password + "',Timeout=0,ConnectionCache=True")
			rval = conn.createinstance(proxy_obj, "basichttpbinding_icorporatecbs", str_endpoint)
			try
				obj_quicksms = create quicksmsresquest
				obj_quicksms.loginid = ls_userid
				obj_quicksms.loginpassword = ls_password
				if ls_mask = "" or isnull(ls_mask) then
					ls_mask = f_reportheaderinfo("clientname")
				end if
				obj_quicksms.mask = ls_mask
				obj_quicksms.unicode = "0"
				obj_quicksms.shortcodeprefered = "n"
				obj_quicksms.ws_message = ls_smstext
				obj_quicksms.destination = ls_smsto
				ls_response = proxy_obj.quicksms(obj_quicksms)
				ll_sms_sended = 0
			catch (throwable e)
				ll_sms_sended = 1
			end try
			destroy conn
		elseif f_stringpreferences("WebSMSProvider") = "B" then
			iinet_base = create inet
			lu_websms_result = create u_websms_result
			ls_url = "https://brandyourtext.com/sms/api/send?username=" + ls_userid + "&password=" + ls_password + "&mask=" + ls_mask + "&mobile=" + ls_smsto + "&message="
			l_nc_urlencode = create nc_urlencode
			ls_temp = l_nc_urlencode.of_urlencode(ls_smstext)
			ls_url = ls_url + ls_temp
			li_ret = getcontextservice("Internet", iinet_base)
			if li_ret = 1 then
				li_res = iinet_base.geturl(ls_url, lu_websms_result)
				if li_res = 1 then
					if lu_websms_result.il_retcode = 1 then
						ll_sms_sended = 0
					else
						ls_errtext = lu_websms_result.is_msg + "~r~nDetails are:-~r~n" + lu_websms_result.is_data
					end if
				else
					ls_errtext = "Cannot invoke Web service"
					ll_sms_sended = 1
				end if
			end if
		elseif f_stringpreferences("WebSMSProvider") = "J" then
			iinet_base = create inet
			lu_websms_result = create u_websms_result
			l_nc_urlencode = create nc_urlencode
			ls_temp = l_nc_urlencode.of_urlencode(ls_smstext)
			ls_url = "https://connect.jazzcmt.com/sendsms_url.html?Username=" + ls_userid + "&Password=" + ls_password + "&From=" + ls_mask + "&To=" + ls_smsto + "&Message="
			ls_url = ls_url + ls_temp
			li_ret = getcontextservice("Internet", iinet_base)
			if li_ret = 1 then
				li_res = iinet_base.geturl(ls_url, lu_websms_result)
				if li_res = 1 then
					if lu_websms_result.il_retcode = 1 then
						ll_sms_sended = 0
					else
						ls_errtext = lu_websms_result.is_msg + "~r~nDetails are:-~r~n" + lu_websms_result.is_data
					end if
				else
					ls_errtext = "Cannot invoke Web service"
					ll_sms_sended = 1
				end if
			end if
		elseif f_stringpreferences("WebSMSProvider") = "D" then
			iinet_base = create inet
			lu_websms_result = create u_websms_result
			l_nc_urlencode = create nc_urlencode
			ls_temp = l_nc_urlencode.of_urlencode(ls_smstext)
			ls_url = "http://brandedsms.pk/api/sendsms.php?id=" + ls_userid + "&key=" + ls_key + "&msg=" + ls_temp + "&to=" + ls_smsto + "&mask=" + ls_mask + "&lang=" + ls_lang + "&type=" + ls_reponsetype
			li_ret = getcontextservice("Internet", iinet_base)
			if li_ret = 1 then
				li_res = iinet_base.geturl(ls_url, lu_websms_result)
				if li_res = 1 then
					if lu_websms_result.il_retcode = 1 then
						ll_sms_sended = 0
					else
						ls_errtext = lu_websms_result.is_msg + "~r~nDetails are:-~r~n" + lu_websms_result.is_data
					end if
				else
					ls_errtext = "Cannot invoke Web service"
					ll_sms_sended = 1
				end if
			end if
		elseif f_stringpreferences("WebSMSProvider") = "I" then
			iinet_base = create inet
			lu_websms_result = create u_websms_result
			l_nc_urlencode = create nc_urlencode
			ls_temp = l_nc_urlencode.of_urlencode(ls_smstext)
			ls_url = "http://api.bizsms.pk/api-send-branded-sms.aspx?username=" + ls_userid + "&pass=" + ls_password + "&text=" + ls_temp + "&masking=" + ls_mask + "&destinationnum=" + ls_smsto + "&language=English&responsetype=text"
			li_ret = getcontextservice("Internet", iinet_base)
			if li_ret = 1 then
				li_res = iinet_base.geturl(ls_url, lu_websms_result)
				if li_res = 1 then
					if lu_websms_result.il_retcode = 1 then
						ll_sms_sended = 0
					else
						ls_errtext = lu_websms_result.is_msg + "~r~nDetails are:-~r~n" + lu_websms_result.is_data
					end if
				else
					ls_errtext = "Cannot invoke Web service"
					ll_sms_sended = 1
				end if
			end if
		elseif f_stringpreferences("WebSMSProvider") = "O" then
			iinet_base = create inet
			lu_websms_result = create u_websms_result
			ls_url = "http://outreach.pk/api/sendsms.php/sendsms/url?id=" + ls_userid + "&pass=" + ls_password + "&mask=" + ls_mask + "&to=" + ls_smsto + "&lang=English&msg="
			l_nc_urlencode = create nc_urlencode
			ls_temp = l_nc_urlencode.of_urlencode(ls_smstext)
			ls_url = ls_url + ls_temp + "&type=xml"
			li_ret = getcontextservice("Internet", iinet_base)
			if li_ret = 1 then
				li_res = iinet_base.geturl(ls_url, lu_websms_result)
				if li_res = 1 then
					if lu_websms_result.il_retcode = 1 then
						ll_sms_sended = 0
					else
						ls_errtext = lu_websms_result.is_msg + "~r~nDetails are:-~r~n" + lu_websms_result.is_data
					end if
				else
					ls_errtext = "Cannot invoke Web service"
					ll_sms_sended = 1
				end if
			end if
		elseif f_stringpreferences("WebSMSProvider") = "P" then
			iinet_base = create inet
			lu_websms_result = create u_websms_result
			ls_url = "http://www.smspoint.pk/api/smsapi/"
			l_nc_urlencode = create nc_urlencode
			ls_temp = l_nc_urlencode.of_urlencode(ls_smstext)
			ls_parm = "username=" + ls_userid + "&password=" + ls_password + "&clientid=" + ls_userid + "&mask=" + ls_mask + "&msg=" + ls_temp + "&to=" + ls_smsto + "&language=English"
			li_ret = getcontextservice("Internet", iinet_base)
			if li_ret = 1 then
				lblb_args = blob(space(800000) + "0", encodingutf8!)
				lblb_args = blob(ls_parm, encodingutf8!)
				ll_length = len(lblb_args)
				ls_headers = "Content-Type: " + "application/x-www-form-urlencoded"
				li_res = iinet_base.posturl(ls_url, lblb_args, ls_headers, 80, lu_websms_result)
				if li_res = 1 then
					if lu_websms_result.il_retcode = 1 then
						ll_sms_sended = 0
					else
						ls_errtext = lu_websms_result.is_msg + "~r~nDetails are:-~r~n" + lu_websms_result.is_data
					end if
				else
					ls_errtext = "Cannot invoke Web service"
					ll_sms_sended = 1
				end if
			end if
		end if
		if ll_sms_sended = 0 then
			if wf_update_smsstatus(ll_smscode) = 0 then
				ll_retcode = 0
			else
				ll_retcode = 1
			end if
		else
			ll_retcode = ll_sms_sended
		end if
	end if
	setpointer(arrow!)
	return ll_retcode

// w_sms_center.wf_get_patientsforsms() returns long
	string ls_mobile
	string ls_mobilelist
	string ls_phone
	string ls_temp
	long ll_count
	long ll_counter
	long ll_lastpos
	long ll_start
	s_arguements lstr_arg
	s_arguements lstr_arg2
	datastore lds_ds
	lds_ds = create datastore
	lds_ds.dataobject = "d_smscenter_patientselection_detail"
	lds_ds.settransobject(this.it_transobject)
	open(w_arg_patientcategory_only)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		openwithparm(w_arg_patientselection_smscenter, lstr_arg)
		lstr_arg2 = message.powerobjectparm
		if lstr_arg2.i_status = 1 then
			lds_ds.retrieve(lstr_arg2.ia_integerlist)
			if lds_ds.rowcount() > 0 then
				for ll_counter = 1 to lds_ds.rowcount()
					ls_mobile = lds_ds.object.mobile[ll_counter]
					if len(ls_mobile) > 0 and not isnull(ls_mobile) and wf_validate_phoneno(ls_mobile) = 0 then
						ls_mobilelist = ls_mobilelist + ls_mobile + ","
					end if
				next
				ls_phone = trim(this.id_compose.object.phoneno[1])
				if len(ls_phone) > 0 then
					ls_phone = ls_phone + "," + ls_mobilelist
				else
					ls_phone = ls_mobilelist
				end if
				if len(ls_phone) > 8000 then
					ll_count = ceiling(len(ls_phone) / 8000.0)
					ll_start = 1
					for ll_counter = 1 to ll_count
						ll_lastpos = lastpos(ls_phone, ",", ll_counter * 8000)
						ls_temp = mid(ls_phone, ll_start, ll_lastpos - 1)
						ll_start = ll_lastpos + 1
						if ll_counter = 1 then
							this.id_compose.setitem(1, "phoneno", ls_temp)
						else
							this.id_compose.setitem(1, "phoneno" + trim(string(ll_counter)), ls_temp)
						end if
					next
				else
					this.id_compose.object.phoneno[1] = ls_phone
				end if
			end if
		end if
	end if
	return 0

// w_sms_center.wf_update_expired_smsstatus(long al_code) returns long
	SQL update DBO.SMS_Center SET SMSStatusCode =3 WHERE SMSCode =:al_code USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		SQL commit USING this.it_transobject;
		return 0
	end if
	SQL rollback USING this.it_transobject;
	return 1

// w_sms_center.create() returns 0 [event]
	if this.menuname = "m_smscentermenu" then
		this.menuid = create m_smscentermenu
	end if
	this.dw_print = create dw_print
	this.tab_smscenter = create tab_smscenter
	this.ole_device = create ole_device
	this.timing_2 = create timing_2
	this.timing_1 = create timing_1
	this.control = {this.dw_print, this.tab_smscenter, this.ole_device}

// w_sms_center.destroy() returns 0 [event]
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_print
	destroy this.tab_smscenter
	destroy this.ole_device
	destroy this.timing_2
	destroy this.timing_1

// w_sms_center.open() returns long [event]
	long ll_counter
	long ll_pos
	long ll_rtcode
	long ll_found
	long ll_groupcode
	string ls_exp
	string ls_exp2
	string ls_username
	w_entry w_parent
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	this.im_menu = this.menuid
	this.it_transobject = create u_transaction
	SQL start USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Connection Failure", "Unable to connect to the database", stopsign!)
		close(this)
		return ::message.returnvalue
	end if
	this.id_print = create datawindow
	this.ids_print = create u_ds_standard
	this.dw_print.dataobject = "d_khyber_thermal_saleinvrep"
	this.dw_print.settransobject(this.it_transobject)
	this.id_print = this.dw_print
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width * 0.98
		ll_height = ll_win_height * 0.96
		this.width = ll_width
		this.height = ll_height
		this.tab_smscenter.width = ll_width * 0.98
		this.tab_smscenter.height = ll_height * 0.83
		this.tab_smscenter.tabpage_device.dw_device.width = this.tab_smscenter.width * 0.98
		this.tab_smscenter.tabpage_device.dw_device.height = this.tab_smscenter.height * 0.91 - 100
		this.tab_smscenter.tabpage_compose.dw_compose.width = this.tab_smscenter.width * 0.98
		this.tab_smscenter.tabpage_compose.dw_compose.height = this.tab_smscenter.height * 0.91 - 100
		this.tab_smscenter.tabpage_outbox.dw_outbox.width = this.tab_smscenter.width * 0.98
		this.tab_smscenter.tabpage_outbox.dw_outbox.height = this.tab_smscenter.height * 0.89 - 100
		this.tab_smscenter.tabpage_outbox.hpb_sentprog.width = this.tab_smscenter.width * 0.98 - 10
		this.tab_smscenter.tabpage_outbox.hpb_sentprog.y = this.tab_smscenter.tabpage_outbox.dw_outbox.y + this.tab_smscenter.tabpage_outbox.dw_outbox.height + 10
		this.tab_smscenter.tabpage_sent.dw_sent.width = this.tab_smscenter.width * 0.98
		this.tab_smscenter.tabpage_sent.dw_sent.height = this.tab_smscenter.height * 0.91 - 100
		this.tab_smscenter.tabpage_expired.dw_expired.width = this.tab_smscenter.width * 0.98
		this.tab_smscenter.tabpage_expired.dw_expired.height = this.tab_smscenter.height * 0.91 - 100
		this.tab_smscenter.tabpage_summary.dw_summary.width = this.tab_smscenter.width * 0.98
		this.tab_smscenter.tabpage_summary.dw_summary.height = this.tab_smscenter.height * 0.91 - 100
		this.tab_smscenter.tabpage_graph.gr_graph.width = this.tab_smscenter.width * 0.98
		this.tab_smscenter.tabpage_graph.gr_graph.height = this.tab_smscenter.height * 0.91
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	this.id_device = this.tab_smscenter.tabpage_device.dw_device
	this.id_device.settransobject(this.it_transobject)
	ll_rtcode = this.id_device.getchild("portno", this.idc_deviceinfo)
	if ll_rtcode = -1 then
		messagebox("Error", "can not get datawindow child")
		close(this)
		return ::message.returnvalue
	end if
	this.idc_deviceinfo.settransobject(this.it_transobject)
	this.id_device.retrieve()
	this.id_compose = this.tab_smscenter.tabpage_compose.dw_compose
	this.id_compose.settransobject(this.it_transobject)
	this.id_compose.reset()
	this.id_compose.insertrow(0)
	this.id_outbox = this.tab_smscenter.tabpage_outbox.dw_outbox
	this.id_outbox.settransobject(this.it_transobject)
	this.id_sent = this.tab_smscenter.tabpage_sent.dw_sent
	this.id_sent.settransobject(this.it_transobject)
	this.id_summary = this.tab_smscenter.tabpage_summary.dw_summary
	this.id_summary.settransobject(this.it_transobject)
	this.id_expired = this.tab_smscenter.tabpage_expired.dw_expired
	this.id_expired.settransobject(this.it_transobject)
	wf_get_jobschedule()
	wf_apply_rights()
	if f_rightexists(5041) then
		wf_settimer(f_numberpreferences("ActMonRefreshTime"))
	end if
	wf_getdevices()
	wf_update_sent_outbox_info()
	this.is_smsmethod = f_stringpreferences("SendMethod")
	if this.is_smsmethod = "M" then
		this.id_device.setfocus()
	else
		this.tab_smscenter.tabpage_device.visible = false
		this.tab_smscenter.tabpage_compose.setfocus()
		this.tab_smscenter.selecttab("tabpage_compose")
		this.id_compose.setfocus()
	end if
	return ::message.returnvalue

// w_sms_center.timer() returns long [event]
	if this.ib_editrefresh = false then
		wf_update_sent_outbox_info()
		wf_sendsms_from_outbox(-1)
		wf_update_sent_outbox_info()
	end if
	return ::message.returnvalue

// tab_smscenter.create() returns 0 [event]
	this.tabpage_device = create tabpage_device
	this.tabpage_compose = create tabpage_compose
	this.tabpage_outbox = create tabpage_outbox
	this.tabpage_sent = create tabpage_sent
	this.tabpage_expired = create tabpage_expired
	this.tabpage_schedule = create tabpage_schedule
	this.tabpage_summary = create tabpage_summary
	this.tabpage_graph = create tabpage_graph
	this.control = {this.tabpage_device, this.tabpage_compose, this.tabpage_outbox, this.tabpage_sent, this.tabpage_expired, this.tabpage_schedule, this.tabpage_summary, this.tabpage_graph}

// tab_smscenter.destroy() returns 0 [event]
	destroy this.tabpage_device
	destroy this.tabpage_compose
	destroy this.tabpage_outbox
	destroy this.tabpage_sent
	destroy this.tabpage_expired
	destroy this.tabpage_schedule
	destroy this.tabpage_summary
	destroy this.tabpage_graph

// tab_smscenter.selectionchanged(integer oldindex, integer newindex) returns long [event]
	long ll_count
	if newindex = 3 then
		parent.id_outbox.retrieve(1)
		ll_count = parent.id_outbox.rowcount()
		if isnull(ll_count) then
			ll_count = 0
		end if
		this.tabpage_outbox.text = "Outbox (" + trim(string(ll_count)) + ")"
	elseif newindex = 4 then
		parent.id_sent.retrieve(2)
		ll_count = parent.id_sent.rowcount()
		if isnull(ll_count) then
			ll_count = 0
		end if
		this.tabpage_sent.text = "Sent (" + trim(string(ll_count)) + ")"
	elseif newindex = 5 then
		parent.id_expired.retrieve(3)
		ll_count = parent.id_expired.rowcount()
		if isnull(ll_count) then
			ll_count = 0
		end if
		this.tabpage_expired.text = "Expired (" + trim(string(ll_count)) + ")"
	end if
	return ::message.returnvalue

// tabpage_device.create() returns 0 [event]
	this.cb_set_smscentre = create cb_set_smscentre
	this.cb_refresh = create cb_refresh
	this.dw_device = create dw_device
	this.control = {this.cb_set_smscentre, this.cb_refresh, this.dw_device}

// tabpage_device.destroy() returns 0 [event]
	destroy this.cb_set_smscentre
	destroy this.cb_refresh
	destroy this.dw_device

// cb_set_smscentre.clicked() returns long [event]
	parent.parent.parent.wf_set_sms_centre()
	return ::message.returnvalue

// cb_refresh.clicked() returns long [event]
	parent.parent.parent.id_device.reset()
	parent.parent.parent.wf_getdevices()
	if parent.parent.parent.id_device.rowcount() > 0 then
		parent.parent.parent.id_device.setrow(1)
	end if
	return ::message.returnvalue

// dw_device.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "portno"
		return parent.parent.parent.wf_setdevicedetail(long(data))
	end choose
	return ::message.returnvalue

// dw_device.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// tabpage_compose.create() returns 0 [event]
	this.cb_reset = create cb_reset
	this.cb_send = create cb_send
	this.dw_compose = create dw_compose
	this.control = {this.cb_reset, this.cb_send, this.dw_compose}

// tabpage_compose.destroy() returns 0 [event]
	destroy this.cb_reset
	destroy this.cb_send
	destroy this.dw_compose

// cb_reset.clicked() returns long [event]
	parent.parent.parent.id_compose.reset()
	parent.parent.parent.id_compose.insertrow(0)
	return ::message.returnvalue

// cb_send.clicked() returns long [event]
	string ls_phones
	string ls_phoneno
	string ls_groupcontacts
	string ls_finalcontacts
	string ls_smstext
	string ls_temp
	string ls_phoneno2
	string ls_phoneno3
	string ls_phoneno4
	string ls_phoneno5
	string ls_phoneno6
	string ls_phoneno7
	string ls_phoneno8
	string ls_phoneno9
	string ls_phoneno10
	long ll_groupcode
	long ll_start
	long ll_end
	long ll_smstype
	long ll_smstemplatecode
	long ll_totsmsdone
	long ll_counter
	long ll_count
	long ll_lastpos
	char lc_temp
	boolean lb_phoneok = true
	setnull(ll_smstemplatecode)
	parent.parent.parent.id_compose.accepttext()
	ls_phoneno = trim(parent.parent.parent.id_compose.object.phoneno[1])
	if isnull(ls_phoneno) then
		ls_phoneno = ""
	end if
	ls_phoneno2 = trim(parent.parent.parent.id_compose.object.phoneno2[1])
	if isnull(ls_phoneno2) then
		ls_phoneno2 = ""
	end if
	ls_phoneno3 = trim(parent.parent.parent.id_compose.object.phoneno3[1])
	if isnull(ls_phoneno3) then
		ls_phoneno3 = ""
	end if
	ls_phoneno4 = trim(parent.parent.parent.id_compose.object.phoneno4[1])
	if isnull(ls_phoneno4) then
		ls_phoneno4 = ""
	end if
	ls_phoneno5 = trim(parent.parent.parent.id_compose.object.phoneno5[1])
	if isnull(ls_phoneno5) then
		ls_phoneno5 = ""
	end if
	ls_phoneno6 = trim(parent.parent.parent.id_compose.object.phoneno6[1])
	if isnull(ls_phoneno6) then
		ls_phoneno6 = ""
	end if
	ls_phoneno7 = trim(parent.parent.parent.id_compose.object.phoneno7[1])
	if isnull(ls_phoneno7) then
		ls_phoneno7 = ""
	end if
	ls_phoneno8 = trim(parent.parent.parent.id_compose.object.phoneno8[1])
	if isnull(ls_phoneno8) then
		ls_phoneno8 = ""
	end if
	ls_phoneno9 = trim(parent.parent.parent.id_compose.object.phoneno9[1])
	if isnull(ls_phoneno9) then
		ls_phoneno9 = ""
	end if
	ls_phoneno10 = trim(parent.parent.parent.id_compose.object.phoneno10[1])
	if isnull(ls_phoneno10) then
		ls_phoneno10 = ""
	end if
	ll_groupcode = parent.parent.parent.id_compose.object.groupcode[1]
	ll_smstype = parent.parent.parent.id_compose.object.smstypecode[1]
	ls_smstext = trim(parent.parent.parent.id_compose.object.smstext[1])
	ll_smstemplatecode = parent.parent.parent.id_compose.object.smstemplatecode[1]
	ls_phones = ls_phoneno + ls_phoneno2 + ls_phoneno3 + ls_phoneno4 + ls_phoneno5 + ls_phoneno6 + ls_phoneno7 + ls_phoneno8 + ls_phoneno9 + ls_phoneno10
	if len(ls_phones) = 0 and (ll_groupcode = 0 or isnull(ll_groupcode)) then
		messagebox("Message Recipient Validation", "Not a valid Message Recipient selected", stopsign!)
		parent.parent.parent.id_compose.setcolumn("phoneno")
		parent.parent.parent.id_compose.setfocus()
		return ::message.returnvalue
	end if
	if len(ls_phones) > 0 then
		ll_end = len(ls_phones)
		for ll_start = 1 to ll_end
			lc_temp = mid(ls_phones, ll_start, 1)
			if not (asc(lc_temp) = 44 or asc(lc_temp) > 47 and asc(lc_temp) < 58) then
				lb_phoneok = false
				exit
			end if
		next
	end if
	if lb_phoneok = false then
		messagebox("Phone Number Validation", "Invalid characters in Phone no are not allowed.~r~nPlease enter valid phone number", stopsign!)
		parent.parent.parent.id_compose.setcolumn("phoneno")
		parent.parent.parent.id_compose.setfocus()
		return ::message.returnvalue
	end if
	if ll_groupcode > 0 then
		parent.parent.parent.wf_get_groupcontacts(ll_groupcode, ls_groupcontacts)
	else
		ls_groupcontacts = ""
	end if
	if len(ls_phoneno) > 0 then
		ls_finalcontacts = ls_phoneno
	end if
	ls_phoneno = parent.parent.parent.id_compose.object.phoneno2[1]
	if len(ls_phoneno) > 0 then
		if ls_finalcontacts = "" then
			ls_finalcontacts = ls_phoneno
		else
			ls_finalcontacts = ls_finalcontacts + "," + ls_phoneno
		end if
	end if
	ls_phoneno = parent.parent.parent.id_compose.object.phoneno3[1]
	if len(ls_phoneno) > 0 then
		if ls_finalcontacts = "" then
			ls_finalcontacts = ls_phoneno
		else
			ls_finalcontacts = ls_finalcontacts + "," + ls_phoneno
		end if
	end if
	ls_phoneno = parent.parent.parent.id_compose.object.phoneno4[1]
	if len(ls_phoneno) > 0 then
		if ls_finalcontacts = "" then
			ls_finalcontacts = ls_phoneno
		else
			ls_finalcontacts = ls_finalcontacts + "," + ls_phoneno
		end if
	end if
	ls_phoneno = parent.parent.parent.id_compose.object.phoneno5[1]
	if len(ls_phoneno) > 0 then
		if ls_finalcontacts = "" then
			ls_finalcontacts = ls_phoneno
		else
			ls_finalcontacts = ls_finalcontacts + "," + ls_phoneno
		end if
	end if
	ls_phoneno = parent.parent.parent.id_compose.object.phoneno6[1]
	if len(ls_phoneno) > 0 then
		if ls_finalcontacts = "" then
			ls_finalcontacts = ls_phoneno
		else
			ls_finalcontacts = ls_finalcontacts + "," + ls_phoneno
		end if
	end if
	ls_phoneno = parent.parent.parent.id_compose.object.phoneno7[1]
	if len(ls_phoneno) > 0 then
		if ls_finalcontacts = "" then
			ls_finalcontacts = ls_phoneno
		else
			ls_finalcontacts = ls_finalcontacts + "," + ls_phoneno
		end if
	end if
	ls_phoneno = parent.parent.parent.id_compose.object.phoneno8[1]
	if len(ls_phoneno) > 0 then
		if ls_finalcontacts = "" then
			ls_finalcontacts = ls_phoneno
		else
			ls_finalcontacts = ls_finalcontacts + "," + ls_phoneno
		end if
	end if
	ls_phoneno = parent.parent.parent.id_compose.object.phoneno9[1]
	if len(ls_phoneno) > 0 then
		if ls_finalcontacts = "" then
			ls_finalcontacts = ls_phoneno
		else
			ls_finalcontacts = ls_finalcontacts + "," + ls_phoneno
		end if
	end if
	ls_phoneno = parent.parent.parent.id_compose.object.phoneno10[1]
	if len(ls_phoneno) > 0 then
		if ls_finalcontacts = "" then
			ls_finalcontacts = ls_phoneno
		else
			ls_finalcontacts = ls_finalcontacts + "," + ls_phoneno
		end if
	end if
	if len(ls_groupcontacts) > 0 then
		if len(ls_finalcontacts) > 0 then
			ls_finalcontacts = ls_finalcontacts + "," + ls_groupcontacts
		else
			ls_finalcontacts = ls_groupcontacts
		end if
	end if
	SQL rollback USING parent.parent.parent.it_transobject;
	if len(ls_finalcontacts) >= 8000 then
		ll_count = ceiling(len(ls_finalcontacts) / 8000.0)
		ll_start = 1
		for ll_counter = 1 to ll_count
			ll_lastpos = lastpos(ls_finalcontacts, ",", ll_counter * 8000)
			if ll_lastpos = 0 then
				ll_lastpos = len(ls_finalcontacts) + 1
			end if
			ls_temp = mid(ls_finalcontacts, ll_start, ll_lastpos - 1)
			ll_start = ll_lastpos + 1
			parent.parent.parent.it_transobject.createsms(ls_temp, ll_smstype, ls_smstext, ll_smstemplatecode, ll_totsmsdone)
			if parent.parent.parent.it_transobject.sqlcode = 0 then
				SQL commit USING parent.parent.parent.it_transobject;
			else
				SQL rollback USING parent.parent.parent.it_transobject;
				messagebox("Send SMS", "SMS Not Successfully sent to Outbox of SMS Center.~r~nReasons are:-~r~n" + parent.parent.parent.it_transobject.sqlerrtext, stopsign!)
			end if
		next
	else
		parent.parent.parent.it_transobject.createsms(ls_finalcontacts, ll_smstype, ls_smstext, ll_smstemplatecode, ll_totsmsdone)
		if parent.parent.parent.it_transobject.sqlcode = 0 then
			SQL commit USING parent.parent.parent.it_transobject;
		else
			SQL rollback USING parent.parent.parent.it_transobject;
			messagebox("Send SMS", "SMS Not Successfully sent to Outbox of SMS Center.~r~nReasons are:-~r~n" + parent.parent.parent.it_transobject.sqlerrtext, stopsign!)
		end if
	end if
	parent.parent.parent.wf_update_sent_outbox_info()
	return ::message.returnvalue

// dw_compose.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	if getcolumnname() <> "smstext" then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// dw_compose.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	s_arguements lstr_arg
	s_arguements lstr_arg2
	long ll_choice
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if getcolumnname() = "phoneno" and key = keyf4! then
		parent.parent.parent.wf_get_contactlist()
	elseif getcolumnname() = "phoneno" and key = keyf5! then
		open(w_select_school_branch_class_defaulter)
		ll_choice = message.doubleparm
		if ll_choice = 1 then
			open(w_arg_academicclass)
		elseif ll_choice = 2 then
			open(w_arg_school)
		elseif ll_choice = 3 then
			open(w_arg_schollbranch)
		elseif ll_choice = 4 then
			open(w_arg_schollbranch_sdate_ldate_age_total)
		end if
		if ll_choice > 0 then
			lstr_arg = message.powerobjectparm
			if lstr_arg.i_status = 1 then
				lstr_arg.l_code1 = ll_choice
				openwithparm(w_arg_classwise_studentselection_forsms, lstr_arg)
				lstr_arg2 = message.powerobjectparm
				if lstr_arg2.i_status = 1 then
					parent.parent.parent.id_compose.object.phoneno[1] = lstr_arg2.s_name1
				end if
			end if
		end if
	elseif getcolumnname() = "phoneno" and key = keyf6! then
		open(w_selectformat_emp_cat_dept_desig)
		ll_choice = message.doubleparm
		if ll_choice = 1 then
			open(w_arg_emp_category)
		elseif ll_choice = 2 then
			open(w_arg_emp_department)
		elseif ll_choice = 3 then
			open(w_arg_emp_designation)
		end if
		if ll_choice > 0 then
			lstr_arg = message.powerobjectparm
			if lstr_arg.i_status = 1 then
				lstr_arg.l_code1 = ll_choice
				openwithparm(w_arg_employeeselection_forsms, lstr_arg)
				lstr_arg2 = message.powerobjectparm
				if lstr_arg2.i_status = 1 then
					parent.parent.parent.id_compose.object.phoneno[1] = lstr_arg2.s_name1
				end if
			end if
		end if
	elseif getcolumnname() = "phoneno" and key = keyf7! then
		parent.parent.parent.wf_get_patientsforsms()
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_compose.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "smstext"
		if len(data) = 161 then
			messagebox("SMS Text Validation", "SMS Text Crossed the Maximum Limit of a SMS (160 Characters per sms)", stopsign!)
			return 0
		end if
	case "smstemplatecode"
		return parent.parent.parent.wf_get_smstemplatetext(long(data))
	end choose
	return ::message.returnvalue

// dw_compose.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	choose case dwo.name
	case "smstext"
		accepttext()
		return 0
	end choose
	return 0

// tabpage_outbox.create() returns 0 [event]
	this.cb_mark_outbox_expired = create cb_mark_outbox_expired
	this.cb_sendselected = create cb_sendselected
	this.hpb_sentprog = create hpb_sentprog
	this.cb_mark_outbox = create cb_mark_outbox
	this.cb_sort_outbox = create cb_sort_outbox
	this.cb_filter_outbox = create cb_filter_outbox
	this.cb_retrieve_outbox = create cb_retrieve_outbox
	this.cb_send_outbox = create cb_send_outbox
	this.dw_outbox = create dw_outbox
	this.control = {this.cb_mark_outbox_expired, this.cb_sendselected, this.hpb_sentprog, this.cb_mark_outbox, this.cb_sort_outbox, this.cb_filter_outbox, this.cb_retrieve_outbox, this.cb_send_outbox, this.dw_outbox}

// tabpage_outbox.destroy() returns 0 [event]
	destroy this.cb_mark_outbox_expired
	destroy this.cb_sendselected
	destroy this.hpb_sentprog
	destroy this.cb_mark_outbox
	destroy this.cb_sort_outbox
	destroy this.cb_filter_outbox
	destroy this.cb_retrieve_outbox
	destroy this.cb_send_outbox
	destroy this.dw_outbox

// cb_mark_outbox_expired.clicked() returns long [event]
	long ll_smscode
	if parent.parent.parent.id_outbox.getrow() > 0 and parent.parent.parent.id_outbox.rowcount() > 0 then
		ll_smscode = parent.parent.parent.id_outbox.object.smscode[parent.parent.parent.id_outbox.getrow()]
		parent.parent.parent.wf_update_expired_smsstatus(ll_smscode)
	end if
	parent.parent.parent.wf_update_sent_outbox_info()
	return ::message.returnvalue

// cb_sendselected.clicked() returns long [event]
	if parent.parent.parent.id_outbox.getrow() > 0 then
		parent.parent.parent.wf_sendsms_from_outbox(parent.parent.parent.id_outbox.getrow())
	end if
	return ::message.returnvalue

// cb_mark_outbox.clicked() returns long [event]
	long ll_smscode
	if parent.parent.parent.id_outbox.getrow() > 0 and parent.parent.parent.id_outbox.rowcount() > 0 then
		ll_smscode = parent.parent.parent.id_outbox.object.smscode[parent.parent.parent.id_outbox.getrow()]
		parent.parent.parent.wf_update_smsstatus(ll_smscode)
	end if
	parent.parent.parent.wf_update_sent_outbox_info()
	return ::message.returnvalue

// cb_sort_outbox.clicked() returns long [event]
	string ls_null
	setnull(ls_null)
	parent.parent.parent.id_outbox.setsort(ls_null)
	parent.parent.parent.id_outbox.sort()
	parent.parent.parent.id_outbox.groupcalc()
	return ::message.returnvalue

// cb_filter_outbox.clicked() returns long [event]
	string ls_null
	setnull(ls_null)
	parent.parent.parent.id_outbox.scrolltorow(0)
	parent.parent.parent.id_outbox.setfilter(ls_null)
	parent.parent.parent.id_outbox.filter()
	parent.parent.parent.id_outbox.groupcalc()
	return ::message.returnvalue

// cb_retrieve_outbox.clicked() returns long [event]
	parent.parent.parent.wf_update_sent_outbox_info()
	return ::message.returnvalue

// cb_send_outbox.clicked() returns long [event]
	parent.parent.parent.wf_sendsms_from_outbox(-1)
	return ::message.returnvalue

// dw_outbox.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_outbox.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if currentrow > 0 then
		selectrow(0, false)
		setrow(currentrow)
		scrolltorow(currentrow)
		selectrow(currentrow, true)
	end if
	return ::message.returnvalue

// dw_outbox.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	parent.parent.parent.ib_editflag = true
	return ::message.returnvalue

// dw_outbox.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	long ll_code
	ancestorreturnvalue = super::doubleclicked(xpos, ypos, row, dwo)
	if row > 0 then
		ll_code = parent.parent.parent.id_outbox.object.smscode[row]
		if ll_code > 0 then
			openwithparm(w_smscenter_preview, ll_code)
		end if
	end if
	return ::message.returnvalue

// tabpage_sent.create() returns 0 [event]
	this.cb_deleteall = create cb_deleteall
	this.cb_delete = create cb_delete
	this.cb_mark_unsent = create cb_mark_unsent
	this.cb_sort_sent = create cb_sort_sent
	this.cb_filter_sent = create cb_filter_sent
	this.cb_retrieve_sent = create cb_retrieve_sent
	this.dw_sent = create dw_sent
	this.control = {this.cb_deleteall, this.cb_delete, this.cb_mark_unsent, this.cb_sort_sent, this.cb_filter_sent, this.cb_retrieve_sent, this.dw_sent}

// tabpage_sent.destroy() returns 0 [event]
	destroy this.cb_deleteall
	destroy this.cb_delete
	destroy this.cb_mark_unsent
	destroy this.cb_sort_sent
	destroy this.cb_filter_sent
	destroy this.cb_retrieve_sent
	destroy this.dw_sent

// cb_deleteall.clicked() returns long [event]
	long ll_res = 2
	ll_res = messagebox("Delete Sent SMS", "Are you sure to delete All the Sent SMS Record from SMS Center?", question!, yesnocancel!, 2)
	if ll_res = 1 then
		SQL DELETE DBO.SMS_Center WHERE SMSStatusCode =2 USING parent.parent.parent.it_transobject;
		if parent.parent.parent.it_transobject.sqlcode = 0 then
			SQL commit USING parent.parent.parent.it_transobject;
			messagebox("Delete Sent SMS", "Sent SMS Succsessfully Deleted from database.", information!)
			parent.parent.parent.id_sent.retrieve(2)
			parent.parent.parent.tab_smscenter.tabpage_sent.text = "Sent (" + trim(string(parent.parent.parent.id_sent.rowcount())) + ")"
		else
			SQL rollback USING parent.parent.parent.it_transobject;
			messagebox("Delete Sent SMS", "Problem in Deleting Sent SMS from database.~r~nDetails are:~r~n" + parent.parent.parent.it_transobject.sqlerrtext, stopsign!)
		end if
	end if
	parent.parent.parent.wf_update_sent_outbox_info()
	return ::message.returnvalue

// cb_delete.clicked() returns long [event]
	long ll_res = 2
	s_arguements lstr_arg
	open(w_arg_sdate_ldate)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		ll_res = messagebox("Delete Sent SMS", "Are you sure to delete Sent SMS Record from SMS Center?", question!, yesnocancel!, 2)
		if ll_res = 1 then
			SQL DELETE DBO.SMS_Center WHERE Date BETWEEN :lstr_arg.d_sdate AND :lstr_arg.d_edate AND SMSStatusCode =2 USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = 0 then
				SQL commit USING parent.parent.parent.it_transobject;
				messagebox("Delete Sent SMS", "Sent SMS Succsessfully Deleted from database.", information!)
				parent.parent.parent.id_sent.retrieve(2)
				parent.parent.parent.tab_smscenter.tabpage_sent.text = "Sent (" + trim(string(parent.parent.parent.id_sent.rowcount())) + ")"
			else
				SQL rollback USING parent.parent.parent.it_transobject;
				messagebox("Delete Sent SMS", "Problem in Deleting Sent SMS from database.~r~nDetails are:~r~n" + parent.parent.parent.it_transobject.sqlerrtext, stopsign!)
			end if
		end if
	end if
	parent.parent.parent.wf_update_sent_outbox_info()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_mark_unsent.clicked() returns long [event]
	long ll_smscode
	if parent.parent.parent.id_sent.getrow() > 0 then
		ll_smscode = parent.parent.parent.id_sent.object.smscode[parent.parent.parent.id_sent.getrow()]
		SQL update DBO.SMS_Center SET SMSStatusCode =1 WHERE SMSCode =:ll_smscode USING parent.parent.parent.it_transobject;
		if parent.parent.parent.it_transobject.sqlcode = 0 then
			SQL commit USING parent.parent.parent.it_transobject;
		else
			SQL rollback USING parent.parent.parent.it_transobject;
		end if
	end if
	parent.parent.parent.wf_update_sent_outbox_info()
	return ::message.returnvalue

