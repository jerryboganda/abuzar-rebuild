// gr_graph.clicked() returns long [event]
	grobjecttype clickedobject
	string ls_cat
	integer li_series
	integer li_category
	clickedobject = objectatpointer(li_series, li_category)
	if clickedobject = typedata! or clickedobject = typecategory! then
		ls_cat = categoryname(li_category)
	end if
	return ::message.returnvalue

// gr_graph.rbuttondown(unsignedlong flags, integer xpos, integer ypos) returns long [event]
	grobjecttype clickedobject
	integer li_series
	integer li_category
	long ll_counter
	clickedobject = objectatpointer(li_series, li_category)
	if clickedobject = typedata! then
		parent.st_tooltip.text = string(getdata(li_series, li_category), "###,###,##0")
		parent.st_tooltip.x = parent.pointerx()
		parent.st_tooltip.y = parent.pointery() - 65
		parent.parent.parent.tab_smscenter.tabpage_graph.st_tooltip.visible = true
	end if
	return ::message.returnvalue

// timing_2.create() returns 0 [event]
	call super::create
	triggerevent("constructor")

// timing_2.destroy() returns 0 [event]
	triggerevent("destructor")
	call super::destroy

// timing_1.create() returns 0 [event]
	call super::create
	triggerevent("constructor")

// timing_1.destroy() returns 0 [event]
	triggerevent("destructor")
	call super::destroy
