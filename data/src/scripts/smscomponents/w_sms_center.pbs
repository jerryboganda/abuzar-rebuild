// w_sms_center.wf_select_printslip() returns 0
	long ll_listrow
	long ll_module
	string ls_report
	string ls_doctype
	ll_listrow = this.id_outbox.getrow()
	if ll_listrow > 0 then
		ll_module = this.id_outbox.object.moduleid[ll_listrow]
	end if
	if ls_report = "" then
		ls_report = "d_cashieractivitymonitor_printout"
	end if
	this.ids_print.dataobject = ls_report
	this.ids_print.settransobject(this.it_transobject)

// w_sms_center.wf_selectprintreport(integer ai_module, long al_doccode) returns string
	string ls_pagesize
	string ls_report
	long ll_currrow
	boolean lb_printout
	integer li_headerno
	integer li_catcode
	integer li_printformat
	ll_currrow = this.id_outbox.getrow()
	if ll_currrow > 0 then
		li_catcode = this.id_outbox.object.catcode[ll_currrow]
		if li_catcode = 1 then
			lb_printout = true
		end if
		if ai_module = 1 then
			SQL SELECT InvoiceSize , HeaderNo INTO :ls_pagesize, :li_headerno FROM SaleLedger WHERE SaleInvCode =:al_doccode USING this.it_transobject;
			ls_report = f_getsaleprintout(ls_pagesize, lb_printout, li_headerno)
			f_set_headerlogo(this.id_print, li_headerno)
		elseif ai_module = 2 then
			SQL SELECT PageSize , HeaderNo INTO :ls_pagesize, :li_headerno FROM SRLedger WHERE SRInvCode =:al_doccode USING this.it_transobject;
			if ls_pagesize = "F" then
				ls_report = "d_wholesaleretinvreport_full"
			elseif ls_pagesize = "H" then
				ls_report = "d_wholesaleretinvreport_half"
			else
				ls_report = "d_wholesaleretinvreport"
			end if
		else
			li_printformat = f_numberpreferences("VoucherPrintingFormat")
			ls_pagesize = f_stringpreferences("VoucherPrintingPageSize")
			ls_report = "d_voucherprint"
			choose case ls_pagesize
			case "F"
				choose case li_printformat
				case 1
					ls_report = "d_voucherprint"
				case 2
					ls_report = "d_voucherprint_format2"
				case 3
					ls_report = "d_voucherprint_patient"
				case 4
					ls_report = "d_voucherprint_standard2"
				end choose
			case "H"
				choose case li_printformat
				case 1
					ls_report = "d_voucherprint_half"
				case 2
					ls_report = "d_voucherprint_half_format2"
				case 3
					ls_report = "d_voucherprint_half_patient"
				case 4
					ls_report = "d_voucherprint_half_standard2"
				end choose
			end choose
		end if
		this.id_print.dataobject = ls_report
		this.id_print.settransobject(this.it_transobject)
	end if
	return ls_report

// w_sms_center.wf_set_preferences() returns long
	long ll_refreshtime
	return 0

// w_sms_center.wf_initialize() returns long
	string ls_command
	string ls_reponse
	long ll_counter
	ls_command = "AT~r~n"
	this.ole_device.object.output = ls_command
	sleep(500)
	ls_reponse = upper(this.ole_device.object.input)
	if match(ls_reponse, "OK") then
		return 1
	end if
	return 0

// w_sms_center.wf_get_make() returns string
	string ls_make
	string ls_command
	string ls_response
	string ls_temp
	long ll_counter
	ls_command = "AT+GMI~r~n"
	this.ole_device.object.output = ls_command
	sleep(500)
	ls_response = upper(this.ole_device.object.input)
	if match(ls_response, "OK") then
		if pos(ls_response, ls_command) > 0 then
			ls_make = mid(ls_response, pos(ls_response, ls_command) + len(ls_command), len(ls_response))
		else
			ls_make = ls_response
		end if
		ls_make = trim(wf_remove_whitespace(ls_make))
		if pos(ls_make, " OK") > 0 then
			ls_temp = trim(left(ls_make, pos(ls_make, " OK") - 1))
			ls_make = ls_temp
		end if
	else
		ls_make = "N/A"
	end if
	this.is_make = ls_make
	return ls_make

// w_sms_center.wf_wait() returns long
	long ll_waitcount
	for ll_waitcount = 1 to 9999999
	next
	return 0

// w_sms_center.wf_get_model() returns string
	string ls_model
	string ls_command
	string ls_response
	string ls_temp
	long ll_counter
	ls_command = "AT+GMM~r~n"
	this.ole_device.object.output = ls_command
	sleep(500)
	ls_response = upper(this.ole_device.object.input)
	if match(ls_response, "OK") then
		if pos(ls_response, ls_command) > 0 then
			ls_model = mid(ls_response, pos(ls_response, ls_command) + len(ls_command), len(ls_response))
		else
			ls_model = ls_response
		end if
		ls_model = trim(wf_remove_whitespace(ls_model))
		if pos(ls_model, " OK") > 0 then
			ls_temp = trim(left(ls_model, pos(ls_model, " OK") - 1))
			ls_model = ls_temp
		end if
	else
		ls_model = "N/A"
	end if
	this.is_model = ls_model
	return ls_model

// w_sms_center.wf_set_motorola_textmode() returns long
	string ls_command
	string ls_reponse
	long ll_counter
	ls_command = "AT+Mode=2" + this.is_cr + this.is_lf
	this.ole_device.object.output = ls_command
	ls_reponse = upper(this.ole_device.object.input)
	wf_wait()
	ls_reponse = upper(this.ole_device.object.input)
	if match(ls_reponse, "OK") then
		return 1
	end if
	return 0

// w_sms_center.wf_getdevices() returns long
	long ll_portno
	long ll_totalports = 3000
	long ll_counter
	long ll_insrow
	long ll_count
	boolean lb_portopen
	string ls_portname
	runtimeerror ex
	setpointer(hourglass!)
	this.idc_deviceinfo.reset()
	for ll_counter = 1 to ll_totalports
		ll_portno = ll_counter
		ls_portname = "COM" + trim(string(ll_counter))
		ll_insrow = this.idc_deviceinfo.insertrow(0)
		this.idc_deviceinfo.setitem(ll_insrow, "portno", ll_counter)
		this.idc_deviceinfo.setitem(ll_insrow, "portname", ls_portname)
		try
			this.ole_device.object.commport = ll_portno
			this.ole_device.object.settings = "9600,N,8,1"
			this.ole_device.object.inputlen = 0
			this.ole_device.object.portopen = true
			wf_wait()
			lb_portopen = true
		catch (throwable ex)
			lb_portopen = false
		end try
		if lb_portopen then
			this.idc_deviceinfo.setitem(ll_insrow, "portstatus", 1)
			this.ole_device.object.portopen = false
		else
			this.idc_deviceinfo.setitem(ll_insrow, "portstatus", 0)
		end if
	next
	this.idc_deviceinfo.setfilter("portstatus=1")
	this.idc_deviceinfo.filter()
	wf_identifydevices()
	this.idc_deviceinfo.setfilter("portstatus=1 and modemstatus=1")
	this.idc_deviceinfo.filter()
	this.id_device.reset()
	this.id_device.insertrow(0)
	ll_count = this.id_device.rowcount()
	if isnull(ll_count) then
		ll_count = 0
	end if
	this.tab_smscenter.tabpage_device.text = "Devices (" + trim(string(ll_count)) + ")"
	if this.idc_deviceinfo.rowcount() > 0 and this.id_device.rowcount() > 0 then
		this.id_device.setitem(1, "PortNo", this.idc_deviceinfo.getitemnumber(1, "portno"))
		wf_setdevicedetail(this.id_device.object.portno[1])
	end if
	setpointer(arrow!)
	return 0

// w_sms_center.wf_identifydevices() returns long
	long ll_portno
	long ll_totalrows
	long ll_counter
	long ll_insrow
	long ll_waitcount
	boolean lb_portopen
	string ls_command
	string ls_reponse
	string ls_msgtitle
	string ls_portname
	runtimeerror ex
	ls_command = ""
	ll_totalrows = this.idc_deviceinfo.rowcount()
	for ll_counter = 1 to ll_totalrows
		ll_portno = this.idc_deviceinfo.getitemnumber(ll_counter, "portno")
		ls_portname = this.idc_deviceinfo.getitemstring(ll_counter, "portname")
		try
			this.ole_device.object.commport = ll_portno
			this.ole_device.object.settings = "9600,N,8,1"
			this.ole_device.object.inputlen = 0
			this.ole_device.object.portopen = true
			sleep(500)
			lb_portopen = true
			if lb_portopen then
				this.idc_deviceinfo.setitem(ll_counter, "modemstatus", wf_initialize())
				this.is_make = wf_get_make()
				this.idc_deviceinfo.setitem(ll_counter, "make", this.is_make)
				this.idc_deviceinfo.setitem(ll_counter, "modelname", wf_get_model())
				this.idc_deviceinfo.setitem(ll_counter, "imei", wf_get_imei())
				this.idc_deviceinfo.setitem(ll_counter, "smscenterno", wf_get_sms_center())
				this.idc_deviceinfo.setitem(ll_counter, "batterystatus", wf_get_battery_status())
				this.idc_deviceinfo.setitem(ll_counter, "signalstrength", wf_get_signal_strength())
				this.ole_device.object.portopen = false
			else
				this.idc_deviceinfo.setitem(ll_counter, "modemstatus", 0)
			end if
		catch (throwable ex)
			lb_portopen = false
			messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
			goto L1030
		end try
	next
	return 0

// w_sms_center.wf_setdevicedetail(long al_portno) returns long
	long ll_found
	ll_found = this.idc_deviceinfo.find("portno = " + string(al_portno), 1, this.idc_deviceinfo.rowcount())
	if this.id_device.rowcount() > 0 and ll_found > 0 then
		this.id_device.setitem(1, "portname", this.idc_deviceinfo.getitemstring(ll_found, "portname"))
		this.id_device.setitem(1, "portstatus", this.idc_deviceinfo.getitemnumber(ll_found, "portstatus"))
		this.id_device.setitem(1, "ModemStatus", this.idc_deviceinfo.getitemnumber(ll_found, "ModemStatus"))
		this.id_device.setitem(1, "make", this.idc_deviceinfo.getitemstring(ll_found, "make"))
		this.id_device.setitem(1, "modelname", this.idc_deviceinfo.getitemstring(ll_found, "modelname"))
		this.id_device.setitem(1, "imei", this.idc_deviceinfo.getitemstring(ll_found, "imei"))
		this.id_device.setitem(1, "smscenterno", this.idc_deviceinfo.getitemstring(ll_found, "smscenterno"))
		this.id_device.setitem(1, "batterystatus", this.idc_deviceinfo.getitemstring(ll_found, "batterystatus"))
		this.id_device.setitem(1, "signalstrength", this.idc_deviceinfo.getitemstring(ll_found, "signalstrength"))
		this.is_model = this.idc_deviceinfo.getitemstring(ll_found, "modelname")
		this.is_make = this.idc_deviceinfo.getitemstring(ll_found, "make")
		return 0
	end if
	return 1

// w_sms_center.wf_get_groupcontacts(long al_groupcode, ref string as_groupcontacts) returns long
	string ls_mobile
	string ls_mobilelist
	long ll_counter
	datastore lds_ds
	if al_groupcode > 0 then
		lds_ds = create datastore
		lds_ds.dataobject = "d_smscenter_contactgroup_selection"
		lds_ds.settransobject(this.it_transobject)
		lds_ds.retrieve(al_groupcode)
		if lds_ds.rowcount() > 0 then
			for ll_counter = 1 to lds_ds.rowcount()
				ls_mobile = lds_ds.object.mobile[ll_counter]
				if wf_validate_phoneno(ls_mobile) = 0 then
					ls_mobilelist = ls_mobilelist + ls_mobile + ","
				end if
			next
			as_groupcontacts = left(ls_mobilelist, len(ls_mobilelist) - 1)
		end if
	else
		as_groupcontacts = ""
	end if
	return 0

// w_sms_center.wf_validate_phoneno(string as_phoneno) returns long
	long ll_start
	long ll_end
	char lc_temp
	boolean lb_phoneok = true
	if len(as_phoneno) > 0 then
		ll_end = len(as_phoneno)
		for ll_start = 1 to ll_end
			lc_temp = mid(as_phoneno, ll_start, 1)
			if not (asc(lc_temp) = 44 or asc(lc_temp) > 47 and asc(lc_temp) < 58) then
				lb_phoneok = false
				exit
			end if
		next
	end if
	if lb_phoneok = false then
		return -1
	end if
	return 0

// w_sms_center.wf_get_contactlist() returns long
	string ls_mobile
	string ls_mobilelist
	string ls_phone
	string ls_temp
	long ll_count
	long ll_counter
	long ll_lastpos
	long ll_start
	s_arguements lstr_arg
	datastore lds_ds
	lds_ds = create datastore
	lds_ds.dataobject = "d_smscenter_contactselection"
	lds_ds.settransobject(this.it_transobject)
	open(w_arg_contactselection_smscenter)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		lds_ds.retrieve(lstr_arg.ia_integerlist)
		if lds_ds.rowcount() > 0 then
			for ll_counter = 1 to lds_ds.rowcount()
				ls_mobile = lds_ds.object.mobile[ll_counter]
				if len(ls_mobile) > 0 and not isnull(ls_mobile) and wf_validate_phoneno(ls_mobile) = 0 then
					ls_mobilelist = ls_mobilelist + ls_mobile + ","
				end if
			next
			ls_phone = trim(this.id_compose.object.phoneno[1])
			if len(ls_phone) > 0 then
				ls_phone = ls_phone + "," + ls_mobilelist
			else
				ls_phone = ls_mobilelist
			end if
			if len(ls_phone) > 8000 then
				ll_count = ceiling(len(ls_phone) / 8000.0)
				ll_start = 1
				for ll_counter = 1 to ll_count
					ll_lastpos = lastpos(ls_phone, ",", ll_counter * 8000)
					ls_temp = mid(ls_phone, ll_start, ll_lastpos - 1)
					ll_start = ll_lastpos + 1
					if ll_counter = 1 then
						this.id_compose.setitem(1, "phoneno", ls_temp)
					else
						this.id_compose.setitem(1, "phoneno" + trim(string(ll_counter)), ls_temp)
					end if
				next
			else
				this.id_compose.object.phoneno[1] = ls_phone
			end if
		end if
	end if
	return 0

// w_sms_center.wf_get_smstemplatetext(long al_code) returns long
	string ls_smstext
	long ll_smstypecode
	if al_code > 0 then
		SQL SELECT smstemplate , smstypecode INTO :ls_smstext, :ll_smstypecode FROM SMS_Template WHERE SMSTemplateCode =:al_code USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.id_compose.object.smstext[1] = ls_smstext
			this.id_compose.object.smstypecode[1] = ll_smstypecode
			this.id_compose.object.smstypecode.protect = 1
		else
			return 1
		end if
	else
		this.id_compose.object.smstext[1] = ""
		this.id_compose.object.smstypecode[1] = 1
		this.id_compose.object.smstypecode.protect = 0
	end if
	return 0

// w_sms_center.wf_sendsms(long al_row) returns long
	integer li_pdu_length
	long ll_smscode
	long ll_retcode
	long ll_sms_sended = 1
	string ls_smstext
	string ls_smsto
	string ls_errtext = "                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        0"
	setpointer(hourglass!)
	if al_row > 0 then
		ll_smscode = this.id_outbox.object.smscode[al_row]
		ls_smsto = trim(this.id_outbox.object.smsto[al_row])
		ls_smstext = trim(this.id_outbox.object.smstext[al_row])
		if isnull(ls_smstext) then
			ls_smstext = ""
		end if
		ll_sms_sended = wf_sendsms_pdumode(ls_smsto, ls_smstext, ls_errtext)
		if ll_sms_sended = 0 then
			if wf_update_smsstatus(ll_smscode) = 0 then
				ll_retcode = 0
			else
				ll_retcode = 1
			end if
		else
			ll_retcode = ll_sms_sended
		end if
	end if
	setpointer(arrow!)
	return ll_retcode

// w_sms_center.wf_update_smsstatus(long al_code) returns long
	SQL update DBO.SMS_Center SET SMSStatusCode =2 , SentDate =GETDATE ( ) WHERE SMSCode =:al_code USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		SQL commit USING this.it_transobject;
		return 0
	end if
	SQL rollback USING this.it_transobject;
	return 1

// w_sms_center.wf_remove_whitespace(string as_text) returns string
	long start_pos = 1
	string old_str
	string new_str
	string mystring
	string ret_str
	mystring = as_text
	old_str = "~r~n"
	new_str = " "
	start_pos = pos(mystring, old_str, start_pos)
	do while start_pos > 0
		mystring = replace(mystring, start_pos, len(old_str), new_str)
		start_pos = pos(mystring, old_str, start_pos + len(new_str))
	loop
	ret_str = mystring
	return ret_str

// w_sms_center.wf_get_imei() returns string
	string ls_emei
	string ls_command
	string ls_response
	long ll_counter
	ls_command = "AT+CGSN~r~n"
	this.ole_device.object.output = ls_command
	sleep(500)
	ls_response = upper(this.ole_device.object.input)
	if match(ls_response, "OK") then
		if pos(ls_response, ls_command) > 0 then
			ls_emei = mid(ls_response, pos(ls_response, ls_command) + len(ls_command), len(ls_response))
		else
			ls_emei = ls_response
		end if
		ls_emei = trim(wf_remove_whitespace(ls_emei))
		ls_emei = trim(left(ls_emei, pos(ls_emei, "OK") - 1))
	else
		ls_emei = "N/A"
	end if
	return ls_emei

// w_sms_center.wf_generate_datasms() returns long
	long ll_templatecode
	long ll_totsmsdone
	long ll_smsdatacode
	string ls_list = "                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      0"
	string ls_reason
	s_arguements lstr_arg
	open(w_arg_smstemplate_data_enabled)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		ll_templatecode = lstr_arg.l_code1
		SQL SELECT smsdatacode INTO :ll_smsdatacode FROM SMS_template WHERE SMSTemplateCode =:ll_templatecode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
		end if
		if ll_smsdatacode > 0 then
			choose case ll_smsdatacode
			case 1
				open(w_sms_finalizedsaleorder)
				lstr_arg = message.powerobjectparm
			case 2
				open(w_sms_postedsales)
				lstr_arg = message.powerobjectparm
			case 10
				open(w_arg_zone)
				lstr_arg = message.powerobjectparm
				lstr_arg.s_name1 = trim(string(lstr_arg.l_code1))
			case 26
				open(w_arg_patients)
				lstr_arg = message.powerobjectparm
			case else
				lstr_arg.s_name1 = "1"
			end choose
			if lstr_arg.i_status = 1 and len(lstr_arg.s_name1) > 0 then
				ls_list = lstr_arg.s_name1
				this.it_transobject.createdatasms(ls_list, ll_templatecode, ll_totsmsdone)
				if this.it_transobject.sqlcode = 0 then
					SQL commit USING this.it_transobject;
				else
					ls_reason = this.it_transobject.sqlerrtext
					SQL rollback USING this.it_transobject;
					messagebox("Generate Data SMS", "Data SMS Generation Terminated due to some problems. Details are:-~r~n" + ls_reason, stopsign!)
				end if
			end if
		end if
	end if
	return 0

// w_sms_center.wf_open_port(integer ai_portno) returns boolean
	boolean lb_portopen
	runtimeerror ex
	try
		this.ole_device.object.commport = ai_portno
		this.ole_device.object.settings = "9600,N,8,1"
		this.ole_device.object.inputlen = 0
		this.ole_device.object.portopen = true
		lb_portopen = true
	catch (throwable ex)
		lb_portopen = false
		messagebox("Com Port Exception", "Com Port Exception Occurred.~r~nDetails are:~r~n" + ex.getmessage())
	end try
	return lb_portopen

// w_sms_center.wf_sendsms_textmode(string as_smsto, string as_smstext) returns long
	long ll_retcode
	boolean lb_portopen
	string ls_command
	string ls_response
	runtimeerror ex
	as_smstext = wf_remove_whitespace(as_smstext)
	as_smstext = as_smstext + space(20) + this.is_ctrl_z
	if as_smstext = "" or isnull(as_smstext) then
		as_smstext = ""
	end if
	try
		if wf_initialize() = 1 then
			if match(this.is_make, "MOTOROLA") then
				wf_set_motorola_textmode()
			end if
			ls_command = "AT+CMGF=1" + this.is_cr + this.is_lf
			this.ole_device.object.output = trim(ls_command)
			sleep(500)
			ls_response = upper(this.ole_device.object.input)
			if match(ls_response, "OK") then
				ls_command = "AT+CMGS=~"" + as_smsto + "~"" + this.is_cr + this.is_lf
				this.ole_device.object.output = trim(ls_command)
				sleep(300)
				ls_response = upper(this.ole_device.object.input)
				if match(ls_response, ">") then
					ls_command = as_smstext
					this.ole_device.object.output = ls_command
					sleep(1000)
					ls_response = upper(this.ole_device.object.input)
					if match(ls_response, "ERROR") then
						ll_retcode = 1
					elseif match(ls_response, "OK") or ls_response = "" or isnull(ls_response) then
						ll_retcode = 0
					else
						ll_retcode = 2
					end if
				else
					ll_retcode = 3
				end if
			else
				ll_retcode = 4
			end if
		else
			ll_retcode = 5
		end if
	catch (throwable ex)
		ll_retcode = 7
		messagebox("Com Port Exception", "Com Port Exception Occurred.~r~nDetails are:~r~n" + ex.getmessage())
	end try
	setpointer(arrow!)
	return ll_retcode

// w_sms_center.wf_encode_pdu(string as_userdata, string as_destaddress, string as_smsaddress, ref integer ai_pdu_length, integer ai_totsms, integer ai_thissmsno, boolean ab_incsmsc) returns string
	string ls_pdu_str
	oleobject ole_pdu
	integer result
	ole_pdu = create oleobject
	result = ole_pdu.connecttonewobject("project1.pdu")
	if result = 0 then
		ls_pdu_str = ole_pdu.__invoke_method("encodepdu", 7, {as_userdata, as_destaddress, as_smsaddress, ai_pdu_length, ai_totsms, ai_thissmsno, ab_incsmsc}, true)
	else
		messagebox("connection failure", "Connection failure. Error Code = " + string(result))
	end if
	destroy ole_pdu
	if result < 0 then
		setnull(ls_pdu_str)
	end if
	return ls_pdu_str

// w_sms_center.wf_sendsms_from_outbox(long al_row) returns long
	long ll_retcode
	long ll_rowcount
	long ll_code
	long ll_row
	long ll_sendcount
	long ll_portno
	long ll_portstatus
	boolean lb_portopen
	boolean lb_flag
	this.ib_editrefresh = true
	this.id_outbox.retrieve(1)
	ll_rowcount = this.id_outbox.rowcount()
	ll_row = this.id_device.getrow()
	if al_row < 0 then
		for ll_row = 1 to ll_rowcount
			if this.id_outbox.object.expiry[ll_row] <= this.id_outbox.object.today[ll_row] then
				ll_code = this.id_outbox.object.smscode[ll_row]
				wf_update_expired_smsstatus(ll_code)
				lb_flag = true
			end if
		next
		ll_row = 1
	end if
	if lb_flag then
		this.id_outbox.retrieve(1)
		ll_rowcount = this.id_outbox.rowcount()
	end if
	if ll_rowcount > 0 then
		if this.is_smsmethod = "M" then
			if this.id_device.rowcount() > 0 and this.idc_deviceinfo.rowcount() > 0 and ll_row > 0 then
				ll_portno = this.id_device.object.portno[ll_row]
				ll_portstatus = this.id_device.object.portstatus[ll_row]
				if ll_portno > 0 and ll_portstatus > 0 then
					lb_portopen = wf_open_port(ll_portno)
				end if
				if lb_portopen then
					this.tab_smscenter.tabpage_outbox.hpb_sentprog.visible = true
					this.tab_smscenter.tabpage_outbox.hpb_sentprog.minposition = 0
					this.tab_smscenter.tabpage_outbox.hpb_sentprog.maxposition = ll_rowcount
					this.tab_smscenter.tabpage_outbox.hpb_sentprog.setstep = 1
					if al_row > 0 then
						ll_retcode = wf_sendsms(al_row)
						if ll_retcode = 0 then
							ll_sendcount = ll_sendcount + 1
							this.tab_smscenter.tabpage_outbox.hpb_sentprog.stepit()
						end if
					else
						for ll_row = 1 to ll_rowcount
							ll_retcode = wf_sendsms(ll_row)
							if ll_retcode = 0 then
								ll_sendcount = ll_sendcount + 1
								this.tab_smscenter.tabpage_outbox.hpb_sentprog.stepit()
							end if
						next
					end if
					this.tab_smscenter.tabpage_outbox.hpb_sentprog.visible = false
					this.ole_device.object.portopen = false
				else
					this.ib_editrefresh = false
					return 0
				end if
				return
			end if
		elseif this.is_smsmethod = "W" then
			this.tab_smscenter.tabpage_outbox.hpb_sentprog.visible = true
			this.tab_smscenter.tabpage_outbox.hpb_sentprog.minposition = 0
			this.tab_smscenter.tabpage_outbox.hpb_sentprog.maxposition = ll_rowcount
			this.tab_smscenter.tabpage_outbox.hpb_sentprog.setstep = 1
			if al_row > 0 then
				ll_retcode = wf_send_websms(al_row)
				if ll_retcode = 0 then
					ll_sendcount = ll_sendcount + 1
					this.tab_smscenter.tabpage_outbox.hpb_sentprog.stepit()
				end if
			else
				for ll_row = 1 to ll_rowcount
					ll_retcode = wf_send_websms(ll_row)
					if ll_retcode = 0 then
						ll_sendcount = ll_sendcount + 1
						this.tab_smscenter.tabpage_outbox.hpb_sentprog.stepit()
					end if
				next
			end if
			this.tab_smscenter.tabpage_outbox.hpb_sentprog.visible = false
		end if
	else
		if ll_rowcount = 0 then
			this.ib_editrefresh = false
			return 0
		end if
		if this.id_device.rowcount() = 0 or this.idc_deviceinfo.rowcount() = 0 then
			this.ib_editrefresh = false
			return 0
		end if
	end if
	wf_update_sent_outbox_info()
	if ll_sendcount > 0 then
	end if
	this.ib_editrefresh = false
	return ll_retcode

// w_sms_center.wf_get_jobschedule() returns long
	string ls_jobstarttime
	string ls_hold
	integer li_hr
	integer li_enabled
	this.it_jobtransobject = create u_transaction
	this.it_jobtransobject.autocommit = true
	this.it_jobtransobject.dbparm = "PROVIDER='SQLOLEDB',DATASOURCE='" + gs_servername + "',CommitOnDisconnect='No',PROVIDERSTRING='DataBase=MSDB" + ";APP=" + gs_app + ";WSID=" + gs_localcomputername + "',PBTrimCharColumns='Yes',StripParmNames='Yes'"
	SQL start USING this.it_jobtransobject;
	this.tab_smscenter.tabpage_schedule.dw_schedule.settransobject(this.it_jobtransobject)
	this.tab_smscenter.tabpage_schedule.dw_schedule.retrieve(gs_autocreatescheduledsmsjob, gs_autocreatescheduledsmsjobschedule)
	SQL Select enabled INTO :li_enabled From SysJobs Where Name =:gs_autocreatescheduledsmsjob USING this.it_jobtransobject;
	if this.it_jobtransobject.sqlcode = 0 then
		if li_enabled = 1 then
			this.tab_smscenter.tabpage_schedule.cbx_activate.checked = true
			if this.tab_smscenter.tabpage_schedule.dw_schedule.getitemnumber(1, "unit") = 1.0 then
				this.tab_smscenter.tabpage_schedule.rb_once.checked = true
				ls_jobstarttime = string(this.tab_smscenter.tabpage_schedule.dw_schedule.getitemnumber(1, "occurancetime"))
				li_hr = integer(left(ls_jobstarttime, len(ls_jobstarttime) - 4))
				ls_hold = left(right(ls_jobstarttime, 4), len(right(ls_jobstarttime, 4)) - 2)
				if isnull(ls_hold) or ls_hold = "" then
					ls_hold = "00"
				elseif len(ls_hold) = 1 then
					ls_hold = "0" + ls_hold
				end if
				this.tab_smscenter.tabpage_schedule.ddlb_min.selectitem(ls_hold, 0)
				ls_hold = right(ls_jobstarttime, 2)
				if isnull(ls_hold) or ls_hold = "" then
					ls_hold = "00"
				elseif len(ls_hold) = 1 then
					ls_hold = "0" + ls_hold
				end if
				this.tab_smscenter.tabpage_schedule.ddlb_sec.selectitem(ls_hold, 0)
				if li_hr > 12 then
					this.tab_smscenter.tabpage_schedule.ddlb_hr.selectitem(string(li_hr - 12), 0)
					this.tab_smscenter.tabpage_schedule.ddlb_time.selectitem("PM", 0)
				elseif li_hr = 12 then
					this.tab_smscenter.tabpage_schedule.ddlb_hr.selectitem("12", 0)
					this.tab_smscenter.tabpage_schedule.ddlb_time.selectitem("PM", 0)
				else
					if isnull(li_hr) or li_hr = 0 then
						this.tab_smscenter.tabpage_schedule.ddlb_hr.selectitem("12", 0)
					else
						this.tab_smscenter.tabpage_schedule.ddlb_hr.selectitem(string(li_hr), 0)
					end if
					this.tab_smscenter.tabpage_schedule.ddlb_time.selectitem("AM", 0)
				end if
				this.tab_smscenter.tabpage_schedule.dw_schedule.enabled = false
			else
				this.tab_smscenter.tabpage_schedule.rb_every.checked = true
				this.tab_smscenter.tabpage_schedule.ddlb_hr.enabled = false
				this.tab_smscenter.tabpage_schedule.ddlb_min.enabled = false
				this.tab_smscenter.tabpage_schedule.ddlb_sec.enabled = false
				this.tab_smscenter.tabpage_schedule.ddlb_time.enabled = false
			end if
		else
			this.tab_smscenter.tabpage_schedule.cbx_activate.checked = false
			this.tab_smscenter.tabpage_schedule.rb_every.enabled = false
			this.tab_smscenter.tabpage_schedule.dw_schedule.enabled = false
			this.tab_smscenter.tabpage_schedule.rb_once.enabled = false
			this.tab_smscenter.tabpage_schedule.ddlb_hr.enabled = false
			this.tab_smscenter.tabpage_schedule.ddlb_min.enabled = false
			this.tab_smscenter.tabpage_schedule.ddlb_sec.enabled = false
			this.tab_smscenter.tabpage_schedule.ddlb_time.enabled = false
		end if
	else
		messagebox("Job", "Unable to fetch  job status.")
	end if
	return 0

// w_sms_center.wf_update_summary_and_graph() returns long
	long ll_rowcount
	long ll_counter
	long ll_found
	long ll_row
	long ll_typecode
	long ll_smscount
	integer li_series_num
	integer li_cat_num
	string ls_type
	graph gr_1
	gr_1 = this.tab_smscenter.tabpage_graph.gr_graph
	setredraw(false)
	this.id_summary.setfilter("")
	this.id_summary.filter()
	this.id_summary.retrieve()
	ll_rowcount = this.id_sent.rowcount()
	gr_1.reset(all!)
	for ll_counter = 1 to ll_rowcount
		ll_typecode = this.id_sent.object.smstypecode[ll_counter]
		ll_found = this.id_summary.find("smstypecode = " + string(ll_typecode), 1, this.id_summary.rowcount())
		if ll_found > 0 then
			ll_row = ll_found
			this.id_summary.object.smscount[ll_row] = this.id_summary.object.smscount[ll_row] + 1
		end if
	next
	this.id_summary.setfilter("smscount <> 0")
	this.id_summary.filter()
	ll_counter = 0
	for ll_counter = 1 to this.id_summary.rowcount()
		ls_type = this.id_summary.object.smstype[ll_counter]
		ll_smscount = this.id_summary.object.smscount[ll_counter]
		li_series_num = gr_1.findseries(ls_type)
		if li_series_num = -1 then
			li_series_num = gr_1.addseries(ls_type)
		end if
		if li_series_num > 0 then
			gr_1.adddata(li_series_num, ll_smscount, ls_type)
		end if
	next
	this.id_summary.setredraw(false)
	this.id_summary.sort()
	this.id_summary.groupcalc()
	this.id_summary.setredraw(true)
	gr_1.textcolor = rgb(285, 105, 135)
	this.tab_smscenter.tabpage_graph.gr_graph = gr_1
	setpointer(arrow!)
	setredraw(true)
	return 0

// w_sms_center.wf_update_sent_outbox_info() returns long
	long ll_count
	if this.ib_editrefresh = false then
		this.id_outbox.retrieve(1)
		ll_count = this.id_outbox.rowcount()
		if isnull(ll_count) then
			ll_count = 0
		end if
		this.tab_smscenter.tabpage_outbox.text = "Outbox (" + trim(string(ll_count)) + ")"
		this.id_sent.retrieve(2)
		ll_count = this.id_sent.rowcount()
		if isnull(ll_count) then
			ll_count = 0
		end if
		this.tab_smscenter.tabpage_sent.text = "Sent (" + trim(string(ll_count)) + ")"
		wf_update_summary_and_graph()
	end if
	return 0

