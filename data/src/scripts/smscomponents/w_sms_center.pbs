// cb_expired_delete.clicked() returns long [event]
	long ll_res = 2
	s_arguements lstr_arg
	open(w_arg_sdate_ldate)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		ll_res = messagebox("Delete Expired SMS", "Are you sure to delete Expired SMS Record from SMS Center?", question!, yesnocancel!, 2)
		if ll_res = 1 then
			SQL DELETE DBO.SMS_Center WHERE Date BETWEEN :lstr_arg.d_sdate AND :lstr_arg.d_edate AND SMSStatusCode =3 USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = 0 then
				SQL commit USING parent.parent.parent.it_transobject;
				messagebox("Delete Expired SMS", "Expired SMS Succsessfully Deleted from database.", information!)
				parent.parent.parent.id_expired.retrieve(3)
				parent.parent.parent.tab_smscenter.tabpage_expired.text = "Expired (" + trim(string(parent.parent.parent.id_expired.rowcount())) + ")"
			else
				SQL rollback USING parent.parent.parent.it_transobject;
				messagebox("Delete Expired SMS", "Problem in Deleting Expired SMS from database.~r~nDetails are:~r~n" + parent.parent.parent.it_transobject.sqlerrtext, stopsign!)
			end if
		end if
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

