	long ll_found
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5026", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_autoprint = true
	end if
	return 0

// w_sms_center.wf_settimer(long ai_time) returns 0
	timer(ai_time, this)

// w_sms_center.wf_refresh(integer ai_mode) returns long
	long ll_index
	long ll_rowcount
	long ll_series_num
	long ll_counter
	long ll_innercounter
	long ll_groupcode
	long ll_prints_left
	long[] ll_docrowid
	long ll_printable_count
	long ll_min_refresh
	boolean lb_continue = true
	datetime ldt_startdate
	setpointer(hourglass!)
	setredraw(false)
	if this.ib_editrefresh = false then
	end if
	if ai_mode = 1 then
		this.id_outbox.retrieve()
		this.ib_editflag = false
	elseif this.ib_editflag = false then
		this.id_outbox.retrieve()
	end if
	ll_rowcount = this.id_outbox.rowcount()
	setpointer(arrow!)
	setredraw(true)
