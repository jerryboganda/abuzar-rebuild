// window w_smscenter_preview (smscomponents)  ancestor: window

// w_smscenter_preview.create() returns 0 [event]
	this.dw_preview = create dw_preview
	this.cb_ok = create cb_ok
	this.control = {this.dw_preview, this.cb_ok}

// w_smscenter_preview.destroy() returns 0 [event]
	destroy this.dw_preview
	destroy this.cb_ok

// w_smscenter_preview.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_code
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	ll_code = message.doubleparm
	this.dw_preview.settransobject(sqlca)
	this.dw_preview.retrieve(ll_code)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_smscenter_preview.close() returns long [event]
	closewithreturn(this, this.is_selectedreport)
	return ::message.returnvalue

// w_smscenter_preview.key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		event Close()
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	close(parent)
	return ::message.returnvalue
