// w_godownitem_setting.wf_print() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_count
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			for ll_count = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
				this.id_print.retrieve(ll_count)
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			next
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	return li_errcode

// w_godownitem_setting.wf_setiteminfo(long al_icode, long al_row, double ad_saleprice, double ad_discperc, long al_stock, double ad_avgprice, long al_totalstock, double ad_purdiscperc) returns 0
	this.id_detail.setitem(al_row, "saleprice", ad_saleprice)
	if this.ii_saletype = 2 then
		this.id_detail.setitem(al_row, "discperc", ad_discperc)
	else
		this.id_detail.setitem(al_row, "discperc", 0.0)
	end if
	this.id_detail.setitem(al_row, "rate", ad_saleprice)
	this.id_detail.setitem(al_row, "avgprice", ad_avgprice)
	this.id_footer.object.icode[this.id_footer.getrow()] = al_icode
	this.id_footer.object.stock[this.id_footer.getrow()] = al_stock

// w_godownitem_setting.wf_setsaletype(integer ai_saletype) returns 0
	this.ii_saletype = ai_saletype

// w_godownitem_setting.wf_setsuppinfo(long al_suppcode, datawindow ad_master) returns 0
	string ls_address
	string ls_city
	string ls_phone
	long ll_currow
	SQL SELECT supplier.address1 , supplier.city , supplier.phone INTO :ls_address, :ls_city, :ls_phone FROM supplier WHERE supplier.suppcode =:al_suppcode USING this.it_transobject;
	ll_currow = ad_master.getrow()
	ad_master.object.supplier_address[ll_currow] = ls_address
	ad_master.object.supplier_city[ll_currow] = ls_city
	ad_master.object.supplier_phone[ll_currow] = ls_phone

// w_godownitem_setting.wf_updatesaleprice(long al_icode, double ad_saleprice) returns integer
	SQL update Item SET saleprice =:ad_saleprice WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_godownitem_setting.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean lb_rtflag
	boolean ib_due
	integer li_null
	string ls_null
	ls_titleerrtext = "Item Validation"
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), al_currrow) = true then
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
	elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			li_option = messagebox("Item Validation", "Item stock does not exist~n~rDo You want to due this item", information!, yesno!, 2)
			if li_option = 1 then
				this.id_detail.setitem(this.il_currrow, "looseqty", 1)
				this.id_detail.setitem(this.il_currrow, "dueqty", 1)
				ib_due = true
			else
				li_errcode = -1
			end if
		end if
	else
		li_errcode = -1
		ls_titleerrtext = "Item Validation"
	end if
	if li_errcode = -1 and not ib_due then
		lb_rtflag = false
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setitem(al_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(al_currrow, "icode", li_null)
		this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	end if
	return lb_rtflag

// w_godownitem_setting.wf_validategodown() returns integer
	long ll_icode
	long ll_gcode
	long ll_stock
	long ll_counter
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	string ls_null
	integer li_errcode
	integer li_null
	integer li_option
	integer li_duperr
	boolean ib_due
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	this.ii_defaultgcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	if wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode <> -2 then
			for ll_counter = 1 to this.id_detail.rowcount()
				if this.il_currrow <> ll_counter and (ll_icode = this.id_detail.getitemnumber(ll_counter, "icode") and this.ii_defaultgcode = this.id_detail.getitemnumber(ll_counter, "gcode")) then
					li_duperr = -2
				end if
			next
		end if
	end if
	this.ib_godownvalidated = true
	if li_errcode = -1 and not ib_due then
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		this.id_detail.setfocus()
		this.id_detail.setcolumn("gcode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
	end if
	if li_duperr = -2 and not ib_due then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate Item, please select some other item"
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
		this.ib_itemslistopen = true
		this.id_itemslist.show()
		li_errcode = -1
	end if
	return li_errcode

// w_godownitem_setting.wf_retrievelist() returns long
	string[] ls_posted
	integer li_salecategory
	integer li_invforlastdays
	datetime ld_invdate
	ld_invdate = datetime(relativedate(today(), li_invforlastdays))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		li_salecategory = this.ii_salecategory
	else
		li_salecategory = this.ii_saletype
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, this.il_groupcode, this.ii_module)

// w_godownitem_setting.wf_retrievelistall() returns long
	string[] ls_posted
	integer li_salecategory
	datetime ld_invdate
	ld_invdate = datetime(date("12/12/1998"), time("00:00:00"))
	ls_posted[1] = "N"
	ls_posted[2] = "Y"
	if this.ii_saletype = 2 then
		li_salecategory = this.ii_salecategory
	else
		li_salecategory = this.ii_saletype
	end if
	return this.id_list.retrieve(li_salecategory, ls_posted, ld_invdate, this.il_groupcode, this.ii_module)

// w_godownitem_setting.wf_selectitembatches(long al_gcode, long al_icode, long al_qty, datawindow ad_itemsdetail, long al_rowscount, string al_errortext) returns integer
	datastore lds_itemstockinfo
	long ll_counter
	long ll_saleqty
	long ll_reqqty
	long ll_totalstock
	long ll_batchqty
	long ll_detailrowcount
	boolean lb_flag
	integer li_errcode
	lds_itemstockinfo = create datastore
	lds_itemstockinfo.dataobject = "d_itemstockinfo"
	lds_itemstockinfo.settransobject(this.it_transobject)
	if lds_itemstockinfo.retrieve(al_gcode, al_icode) > 0 then
		ll_totalstock = lds_itemstockinfo.getitemnumber(1, "c_totalstock")
		if ll_totalstock >= al_qty then
			ll_reqqty = al_qty
			ll_detailrowcount = ad_itemsdetail.rowcount()
			ll_counter = 1
			do while ll_counter <= lds_itemstockinfo.rowcount() and not lb_flag
				ll_batchqty = lds_itemstockinfo.getitemnumber(ll_counter, "currqty")
				if ll_batchqty >= ll_reqqty then
					ll_saleqty = ll_reqqty
					lb_flag = true
				else
					ll_saleqty = ll_batchqty
					ll_reqqty = ll_reqqty - ll_batchqty
				end if
				ad_itemsdetail.insertrow(0)
				ll_detailrowcount = ll_detailrowcount + 1
				ad_itemsdetail.setitem(ll_detailrowcount, "gcode", al_gcode)
				ad_itemsdetail.setitem(ll_detailrowcount, "icode", al_icode)
				ad_itemsdetail.setitem(ll_detailrowcount, "batch", lds_itemstockinfo.getitemstring(ll_counter, "batch"))
				ad_itemsdetail.setitem(ll_detailrowcount, "expiry", lds_itemstockinfo.getitemdatetime(ll_counter, "expiry"))
				ad_itemsdetail.setitem(ll_detailrowcount, "stock", ll_batchqty)
				ad_itemsdetail.setitem(ll_detailrowcount, "totalstock", ll_totalstock)
				ad_itemsdetail.setitem(ll_detailrowcount, "qty", ll_saleqty)
				ll_counter = ll_counter + 1
			loop
			al_rowscount = ll_counter - 1
		else
			li_errcode = 1
			al_rowscount = ll_totalstock
			al_errortext = "Stock has been decreased for this item   "
		end if
	else
		li_errcode = 1
		al_rowscount = ll_totalstock
		al_errortext = "Stock does not exist for this item   "
	end if
	destroy lds_itemstockinfo
	return li_errcode

// w_godownitem_setting.wf_copyinvoice() returns integer
	datastore lds_issuereqheader
	datastore lds_issuereqdetail
	datawindowchild ldc_section
	s_saletemplate lstr_template
	long ll_totalrows
	long ll_rowcount
	long ll_deptcode
	integer li_retcode
	integer li_errcode
	string ls_errortext
	if this.editflag = true then
		open(w_copyissueinvoicefrom)
		lstr_template = message.powerobjectparm
		if lstr_template.b_userinput = true then
			lds_issuereqheader = create datastore
			lds_issuereqheader.dataobject = "d_issuereqheader"
			lds_issuereqheader.settransobject(this.it_transobject)
			lds_issuereqheader.retrieve(lstr_template.l_invtemplate)
			ll_deptcode = lds_issuereqheader.object.deptcode[1]
			this.id_master.object.deptcode[1] = lds_issuereqheader.object.deptcode[1]
			this.id_master.object.areacode[1] = lds_issuereqheader.object.areacode[1]
			this.id_master.object.smancode[1] = lds_issuereqheader.object.smancode[1]
			this.id_master.object.remarks[1] = lds_issuereqheader.object.remarks[1]
			this.id_detail.reset()
			lds_issuereqdetail = create datastore
			lds_issuereqdetail.dataobject = "d_issuereqdetail"
			lds_issuereqdetail.settransobject(this.it_transobject)
			lds_issuereqdetail.getchild("sectcode", ldc_section)
			ldc_section.settransobject(this.it_transobject)
			ldc_section.retrieve(ll_deptcode)
			if ldc_section.rowcount() = 0 then
				ldc_section.insertrow(0)
			end if
			this.idc_section.retrieve(ll_deptcode)
			if this.idc_section.rowcount() = 0 then
				this.idc_section.insertrow(0)
			end if
			ll_totalrows = lds_issuereqdetail.retrieve(lstr_template.l_invtemplate)
			if ll_totalrows < 0 then
				li_retcode = -1
			end if
			ll_totalrows = lds_issuereqdetail.rowcount()
			for ll_rowcount = 1 to ll_totalrows
				this.id_detail.insertrow(0)
				wf_inititeminfo(lds_issuereqdetail.getitemnumber(ll_rowcount, "icode"), ll_rowcount, li_errcode, ls_errortext)
				this.id_detail.setitem(ll_rowcount, "qty", lds_issuereqdetail.getitemnumber(ll_rowcount, "qty"))
				this.id_detail.setitem(ll_rowcount, "sectcode", lds_issuereqdetail.getitemnumber(ll_rowcount, "sectcode"))
			next
		end if
	end if
	return li_retcode

// w_godownitem_setting.wf_setgodownoption() returns 0
	this.ii_salegodown = this.id_detail.getitemnumber(1, "gcode")
	if this.il_strategy = 2 or this.il_strategy = 1 and this.il_godowncount = 1 then
		this.id_detail.modify("gcode" + ".Protect=1")
		this.id_detail.object.gcode.background.color = this.backcolor
	end if

// w_godownitem_setting.wf_grandtotal() returns double
	double ld_grandtotal
	ld_grandtotal = 0
	return ld_grandtotal

// w_godownitem_setting.wf_initmodify(integer ai_protect) returns 0
	long ll_code
	long ll_gcode
	long ll_icode
	long ll_counter
	long ll_count
	ll_code = this.id_master.getitemnumber(1, "code")
	this.id_master.retrieve(ll_code)
	this.id_detail.retrieve(ll_code)
	this.ib_modify = true
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_new.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true
	this.im_menu.m_file.m_first.enabled = false
	this.im_menu.m_file.m_next.enabled = false
	this.im_menu.m_file.m_previous.enabled = false
	this.im_menu.m_file.m_last.enabled = false
	this.im_menu.m_file.m_retrieve.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.tab_retrieve.tabpage_detail.enabled = true

// w_godownitem_setting.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_godownitem_setting.wf_validateitem(boolean ab_flag) returns integer
	long ll_icode
	long ll_stock
	long ll_totalstock
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean ib_due
	integer li_null
	string ls_null
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if not isnull(ll_icode) then
		if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), this.il_currrow) = true then
			ls_titleerrtext = "Item Validation"
			ls_errtext = "Duplicate item, please select some other item"
			li_errcode = -1
		elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
			if li_errcode = -2 then
				li_errcode = -1
			end if
		else
			ls_titleerrtext = "Item Validation"
		end if
	end if
	if ab_flag then
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		ls_titleerrtext = "Item Validation"
		messagebox(ls_titleerrtext, ls_errtext)
		if f_stringpreferences("itemcode") = "N" then
			this.id_detail.setcolumn(this.is_columnitemname)
			this.ib_itemslistopen = true
			this.id_itemslist.show()
		else
			this.id_detail.setcolumn("fullcode")
			this.id_detail.object.fullcode[this.il_currrow] = ls_null
		end if
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
	end if
	return li_errcode

// w_godownitem_setting.wf_findfullcode(string as_fullcode, long al_icode, string al_itemname) returns integer
	integer ll_icode
	integer ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_godownitem_setting.wf_populatesaledetail(long al_invid, datawindow ad_saledetail, string as_errortext, long al_errorrow) returns boolean
	long ll_detailrows
	long ll_stock
	long ll_newstock
	long ll_gcode
	long ll_icode
	long ll_salelooseqty
	long ll_dueqty
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode
	long li_counter
	long li_innercounter
	long ll_insertedrows
	long ll_looseqty
	long ll_itemsdetailrowcount
	long ll_row
	long ll_itemflatdisc
	long ll_sectcode
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_mrpp
	double ld_purchaseprice
	boolean lb_commitflag
	string ls_batch
	string ls_updatesaleprice
	string ls_updsaleprice
	string ls_saleitemdescription
	datetime ld_expiry
	dwitemstatus ldws_column
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	ll_itemsdetailrowcount = 0
	ls_updatesaleprice = f_stringpreferences("updatesaleprice")
	as_errortext = "    Some database problem ocuurs         "
	do while li_counter <= ll_detailrows and lb_commitflag
		ll_gcode = this.id_detail.getitemnumber(li_counter, "gcode")
		ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
		ll_salelooseqty = this.id_detail.getitemnumber(li_counter, "qty")
		ll_packunits = this.id_detail.getitemnumber(li_counter, "packunits")
		ld_saleprice = this.id_detail.getitemnumber(li_counter, "saleprice")
		ld_purchaseprice = this.id_detail.getitemnumber(li_counter, "purchaseprice")
		ld_avgprice = this.id_detail.getitemnumber(li_counter, "avgprice")
		ld_mrpp = this.id_detail.getitemnumber(li_counter, "mrpp")
		ll_sectcode = this.id_detail.getitemnumber(li_counter, "sectcode")
		ldws_column = this.id_detail.getitemstatus(li_counter, "saleprice", primary!)
		ls_updsaleprice = this.id_detail.getitemstring(li_counter, "updatesaleprice")
		ll_salelooseqty = ll_salelooseqty
		this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			if ll_salelooseqty > 0 and lb_commitflag then
				if wf_selectitembatches(ll_gcode, ll_icode, ll_salelooseqty, ad_saledetail, ll_insertedrows, as_errortext) = 0 then
					for li_innercounter = 1 to ll_insertedrows
						ll_row = ll_itemsdetailrowcount + li_innercounter
						ad_saledetail.setitem(ll_row, "code", al_invid)
						ad_saledetail.setitem(ll_row, "packunits", ll_packunits)
						ad_saledetail.setitem(ll_row, "saleprice", ld_saleprice)
						ad_saledetail.setitem(ll_row, "avgprice", ld_avgprice)
						ad_saledetail.setitem(ll_row, "mrpp", ld_mrpp)
						ad_saledetail.setitem(ll_row, "purchaseprice", ld_purchaseprice)
						ad_saledetail.setitem(ll_row, "avgprice", ld_avgprice)
						ad_saledetail.setitem(ll_row, "sectcode", ll_sectcode)
						ls_batch = ad_saledetail.getitemstring(ll_row, "batch")
						ld_expiry = ad_saledetail.getitemdatetime(ll_row, "expiry")
						ll_looseqty = ad_saledetail.getitemnumber(ll_row, "qty")
						ll_stock = ad_saledetail.getitemnumber(ll_row, "stock")
						ll_newstock = ll_stock - ll_looseqty
						if ll_newstock > 0 then
							this.it_transobject.saleupdateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ll_newstock, ll_stock)
						else
							this.it_transobject.deleteitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ll_stock)
						end if
						if this.it_transobject.sqlcode <> 0 then
							lb_commitflag = false
							as_errortext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
						end if
					next
					ll_itemsdetailrowcount = ll_itemsdetailrowcount + ll_insertedrows
				else
					this.id_detail.setitem(li_counter, "stock", ll_insertedrows)
					lb_commitflag = false
					as_errortext = "Stock Updation Error:~r~nStock does not exist for the item (" + this.id_detail.getitemstring(li_counter, "itemname") + ") in row number " + string(li_counter)
				end if
			end if
		else
			lb_commitflag = false
		end if
		li_counter = li_counter + 1
	loop
	if not lb_commitflag then
		al_errorrow = li_counter - 1
		messagebox("Database Error", as_errortext)
	end if
	SQL rollback USING sqlca;
	ul_rowcount = ad_saledetail.rowcount()
	sqlca.getmaxutn(ul_rowcount, ul_maxutn)
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
	else
		SQL rollback USING sqlca;
		messagebox("Saving", "Error in generating UTN ")
		return false
	end if
	for li_counter = 1 to ad_saledetail.rowcount()
		ad_saledetail.setitem(li_counter, "IssueUtn", ul_maxutn)
		ul_maxutn = ul_maxutn + 1
	next
	return lb_commitflag

// w_godownitem_setting.wf_inititeminfo(long al_icode, long al_row, integer ai_rtcode, string as_errortext) returns boolean
	boolean retflag
	long ll_packunits
	long ll_saleinvcode
	double ld_saleprice
	double ld_saleprice2
	double ld_saleprice3
	double ld_avgprice
	double ld_mrpp
	double ld_purprice
	double ld_godownstock
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_null
	setnull(ls_null)
	SQL SELECT item.customicode , item.name INTO :ls_fullcode, :ls_name FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	li_gcode = this.id_master.object.code[1]
	if retflag then
		this.id_detail.setitem(al_row, "code", li_gcode)
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		this.id_detail.setitem(al_row, "icode", al_icode)
	else
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	return retflag

// w_godownitem_setting.wf_setqty(integer ai_type) returns integer
	long ll_detailcount
	long ll_rowcount
	long ll_qty
	long ll_type
	long ll_counter
	long ll_icode
	long ll_found
	long ll_gcode
	double ld_qty
	string as_col
	s_arguements lstr_arg
	datastore lds_ds
	ll_gcode = this.id_master.object.code[1]
	open(w_select_godown_consumptioncriteria)
	ll_type = message.doubleparm
	if ai_type = 2 then
		as_col = "optimumqty"
	else
		as_col = "reorderqty"
	end if
	if ll_type = 5 then
		open(w_setquantity)
		ll_qty = message.doubleparm
		setredraw(false)
		for ll_counter = 1 to this.id_detail.rowcount()
			this.id_detail.setitem(ll_counter, as_col, ll_qty)
		next
		setredraw(true)
	else
		open(w_arg_sdate_ldate)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = 1 then
			SQL rollback USING sqlca;
			sqlca.getgodownconsumption(ll_gcode, ll_type, lstr_arg.d_sdate, lstr_arg.d_edate)
			SQL commit USING sqlca;
			lds_ds = create datastore
			lds_ds.dataobject = "d_godownconsumptionvalues"
			lds_ds.settransobject(sqlca)
			lds_ds.retrieve()
			ll_rowcount = lds_ds.rowcount()
			ll_detailcount = this.id_detail.rowcount()
			if ll_rowcount > 0 then
				for ll_counter = 1 to ll_detailcount
					ll_icode = this.id_detail.object.icode[ll_counter]
					ll_found = lds_ds.find("icode = " + trim(string(ll_icode)), 1, ll_rowcount)
					if ll_found > 0 and ll_found <= ll_rowcount then
						ld_qty = lds_ds.object.qty[ll_found]
						this.id_detail.setitem(ll_counter, as_col, long(ld_qty))
					else
						this.id_detail.setitem(ll_counter, as_col, 0)
					end if
				next
			end if
		end if
	end if
	return 0

// w_godownitem_setting.wf_allowissuemodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM IssueDetail WHERE IssueInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_godownitem_setting.wf_populateitems() returns integer
	integer li_rtcode
	long ll_rtcode
	long ll_rowcount
	long ll_count
	long ll_icode
	long ll_currentrow
	long ll_found
	string as_errortext
	s_arguements lstr_selecteditems
	datastore lds_selecteditems
	openwithparm(w_arg_item_populate2, 3)
	lstr_selecteditems = message.powerobjectparm
	lds_selecteditems = create datastore
	if lstr_selecteditems.s_name2 = "OR" then
		lds_selecteditems.dataobject = "d_populateditems_active"
	else
		lds_selecteditems.dataobject = "d_populateditems_active_and"
	end if
	lds_selecteditems.settransobject(sqlca)
	ll_rtcode = lds_selecteditems.retrieve(lstr_selecteditems.ia_integerlist, lstr_selecteditems.ia_integerlist1, lstr_selecteditems.ia_integerlist2, lstr_selecteditems.la_longlist, lstr_selecteditems.l_code1, lstr_selecteditems.s_name1)
	ll_rowcount = lds_selecteditems.rowcount()
	wf_deleteemptydetailrow()
	if this.id_detail.rowcount() > 0 and isnull(this.id_detail.object.icode[this.id_detail.rowcount()]) then
		event ue_deleteitem()
	end if
	for ll_count = 1 to ll_rowcount
		ll_icode = lds_selecteditems.object.icode[ll_count]
		ll_found = this.id_detail.find("icode=" + string(ll_icode), 1, this.id_detail.rowcount())
		if not (ll_found > 0) then
			ll_currentrow = this.id_detail.insertrow(0)
			wf_inititeminfo(ll_icode, ll_currentrow, li_rtcode, as_errortext)
		end if
	next
	if this.id_detail.rowcount() > 0 then
		this.im_menu.m_file.m_save.enabled = true
	end if
	return 0

// w_godownitem_setting.wf_getsalesstockinfo(long al_saleinvcode, long al_gcode, long al_icode, double ad_saleqty) returns integer
	SQL Select IsNull ( Sum ( saledetail.looseqty ) , 0 ) INTO :ad_saleqty from saledetail where saledetail.saleinvcode =:al_saleinvcode and saledetail.gcode =:al_gcode and saledetail.icode =:al_icode USING this.it_transobject;
	if isnull(ad_saleqty) then
		ad_saleqty = 0
	end if
	return this.it_transobject.sqlcode

// w_godownitem_setting.create() returns 0
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_godownitem_setting" then
		this.menuid = create m_godownitem_setting
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	this.dw_saleinvdetail = create dw_saleinvdetail
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.dw_saleinvdetail

// w_godownitem_setting.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.dw_saleinvdetail

// w_godownitem_setting.ue_save() returns 0
	long ll_detailrows
	long ll_counter
	long ll_count
	long ll_salesmancode
	long ll_mastercurrrow
	boolean lb_commitflag
	boolean lb_continue
	integer li_counter
	string ls_errtext
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if isnull(this.id_master.getitemnumber(1, "code")) then
		messagebox("Godown Validation", "Kindly select some godown from the list window~r~nthan populate it with items.")
		return
	end if
	setpointer(hourglass!)
	ll_salesmancode = gl_usercode
	if ll_salesmancode > 0 then
		call super::ue_save
		if this.ib_commitok then
			this.ib_modify = false
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_godownitem_setting.ue_newform() returns 0
	integer rtncode
	long li_fetched_code
	long row
	long ll_manfcode
	setredraw(false)
	call super::ue_newform
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_post.enabled = false
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.ib_modify = false
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	wf_visible(true)
	setredraw(true)

// w_godownitem_setting.ue_detail() returns 0
	integer li_rtncode
	integer li_protect
	long ll_row
	long ll_code
	long ll_deptcode
	long ll_rowcount
	boolean lb_flag
	boolean lb_modify
	m_godownitem_setting lm_menu
	call super::ue_detail
	lm_menu = this.menuid
	setredraw(false)
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_print.enabled = true
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	li_protect = 0
	wf_initmodify(li_protect)
	wf_grandtotal()
	if this.id_detail.rowcount() > 0 then
		this.im_menu.m_file.m_save.enabled = true
	else
		this.im_menu.m_file.m_save.enabled = false
	end if
	setredraw(true)

// w_godownitem_setting.ue_newitem() returns 0
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.ib_validatefullcode = true
	this.ii_defaultgcode = this.ii_salegodown

// w_godownitem_setting.ue_deleteitem() returns 0
	long ll_row
	long ll_footerrow
	call super::ue_deleteitem
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() <= 0 then
		this.im_menu.m_file.m_print.enabled = false
		this.im_menu.m_file.m_save.enabled = false
	end if

// w_godownitem_setting.close() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	return ::message.returnvalue

// w_godownitem_setting.ue_list() returns 0
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_post.enabled = false
	this.im_menu.m_file.m_print.enabled = false
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	wf_retrievelist()

// w_godownitem_setting.ue_print() returns 0
	long ll_custcode
	long ll_row
	string ls_custname
	integer li_option
	call super::ue_print
	if this.im_menu.m_file.m_save.enabled = true then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	this.id_print.dataobject = "d_godownitem_setting_rep"
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(this.id_master.getitemnumber(1, "code"))
	if this.id_print.rowcount() <= 0 then
		messagebox("Printing", "no rows retrieve")
		return
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_godownitem_setting.ue_refreshddw() returns 0
	call super::ue_refreshddw
	if this.ii_saletype <> 3 then
		setpointer(hourglass!)
		this.idc_customers.setredraw(false)
		this.idc_customers.settransobject(this.it_transobject)
		this.idc_customers.retrieve()
		this.idc_customers.setredraw(true)
		setpointer(arrow!)
	end if

// w_godownitem_setting.ue_new() returns 0
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_godownitem_setting.ue_postopen() returns 0
	m_godownitem_setting lm_menu
	integer li_rtncode
	long ll_counter
	long ll_pos
	long ll_found
	call super::ue_postopen
	setredraw(false)
	this.id_print = this.dw_saleinvrep
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = true
	this.id_itemslist.object.sstock.visible = true
	this.id_itemslist.object.t_pstock.visible = false
	this.id_itemslist.object.pstock.visible = false
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.sstock.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_itemslist.object.transitstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	gd_itemsinfo.sharedata(this.id_itemslist)
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	setredraw(true)

// w_godownitem_setting.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	return ::message.returnvalue
