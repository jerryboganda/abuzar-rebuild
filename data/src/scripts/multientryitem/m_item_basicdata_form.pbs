	this.shortcut = 121

// m_setitemnotes.destroy() returns 0 [event]
	call super::destroy

// m_setitemauthors.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_select_itemauthor()

// m_setitemauthors.create() returns 0 [event]
	call super::create
