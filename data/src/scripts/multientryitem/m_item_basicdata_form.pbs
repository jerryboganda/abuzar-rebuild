// menu m_item_basicdata_form (multientryitem)  ancestor: m_multi_entry

// m_item_basicdata_form.create() returns 0 [event]
	m_item_basicdata_form = this
	call super::create
	this.text = "m_item_basicdata_form"

// m_item_basicdata_form.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_populateitem = create m_populateitem
	this.m_selectmodels = create m_selectmodels
	this.m_setitemassociations = create m_setitemassociations
	this.m_setitemnotes = create m_setitemnotes
	this.m_setitemauthors = create m_setitemauthors
	this.m_selectassociatedmasters = create m_selectassociatedmasters
	this.item[upperbound(this.item) + 1] = this.m_populateitem
	this.item[upperbound(this.item) + 1] = this.m_selectmodels
	this.item[upperbound(this.item) + 1] = this.m_setitemassociations
	this.item[upperbound(this.item) + 1] = this.m_setitemnotes
	this.item[upperbound(this.item) + 1] = this.m_setitemauthors
	this.item[upperbound(this.item) + 1] = this.m_selectassociatedmasters

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_populateitem
	destroy this.m_selectmodels
	destroy this.m_setitemassociations
	destroy this.m_setitemnotes
	destroy this.m_setitemauthors
	destroy this.m_selectassociatedmasters

// m_populateitem.create() returns 0 [event]
	call super::create
	this.text = "P&opulate Item~tCtrl+O"
	this.shortcut = 335

// m_populateitem.destroy() returns 0 [event]
	call super::destroy

// m_populateitem.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_populate_newitem()

// m_selectmodels.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_selectmodels()

// m_selectmodels.create() returns 0 [event]
	call super::create
	this.text = "Select Models~tF12"
	this.shortcut = 123

// m_selectmodels.destroy() returns 0 [event]
	call super::destroy

// m_setitemassociations.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_set_item_association()

// m_setitemassociations.create() returns 0 [event]
	call super::create
