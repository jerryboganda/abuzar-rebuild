// menu m_godownitem_setting (multientryitem)  ancestor: m_multi_entry

// m_godownitem_setting.create() returns 0 [event]
	m_godownitem_setting = this
	call super::create
	this.text = "m_godownitem_setting"

// m_godownitem_setting.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_open = create m_open
	this.m_setreorderqty = create m_setreorderqty
	this.m_setoptimumqty = create m_setoptimumqty
	this.item[upperbound(this.item) + 1] = this.m_open
	this.item[upperbound(this.item) + 1] = this.m_setreorderqty
	this.item[upperbound(this.item) + 1] = this.m_setoptimumqty

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_open
	destroy this.m_setreorderqty
	destroy this.m_setoptimumqty

// m_file.clicked() returns 0 [event]
	call super::clicked
	this.parentwindow.dynamic wf_dueitem()

// m_options.create() returns 0 [event]
	call super::create
	this.text = "Sa&ve and Print~tCtrl+F6"
	this.enabled = false

// m_options.clicked() returns 0 [event]
	call super::clicked
	this.parentwindow.triggerevent("ue_save")
	if this.parentwindow.dynamic wf_commitform() = true then
		this.parentwindow.triggerevent("ue_print")
		this.parentwindow.postevent("ue_new")
	end if

// m_options.destroy() returns 0 [event]
	call super::destroy

// m_open.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_populateitems()

// m_open.create() returns 0 [event]
	call super::create
	this.text = "Populate~tCtrl+G"
	this.shortcut = 327

// m_open.destroy() returns 0 [event]
	call super::destroy

// m_setreorderqty.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_setqty(1)

// m_setreorderqty.create() returns 0 [event]
	call super::create
	this.text = "Set ReOrder Qty"

// m_setreorderqty.destroy() returns 0 [event]
	call super::destroy

// m_setoptimumqty.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_setqty(2)

// m_setoptimumqty.create() returns 0 [event]
	call super::create
	this.text = "Set Optimum Qty"

// m_setoptimumqty.destroy() returns 0 [event]
	call super::destroy
