// tabpage_detail.create() returns 0 [event]
	integer icurrent
	this.rb_summary = create rb_summary
	this.rb_detail = create rb_detail
	this.dw_iteminmodel = create dw_iteminmodel
	call super::create
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.rb_summary
	this.control[icurrent + 2] = this.rb_detail
	this.control[icurrent + 3] = this.dw_iteminmodel

// tabpage_detail.destroy() returns 0 [event]
	call super::destroy
