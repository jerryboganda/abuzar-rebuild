// menu m_item_form (multientryitem)  ancestor: m_multi_entry

// m_item_form.create() returns 0 [event]
	m_item_form = this
	call super::create
	this.text = "m_item_form"

// m_item_form.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_populateitem = create m_populateitem
	this.m_selectmodels = create m_selectmodels
	this.m_setitemassociations = create m_setitemassociations
	this.m_setitemnotes = create m_setitemnotes
	this.m_setitemauthors = create m_setitemauthors
	this.m_garmentsbasicdatawizard = create m_garmentsbasicdatawizard
	this.m_setalternateitemaliasnames = create m_setalternateitemaliasnames
	this.m_setitemimages = create m_setitemimages
	this.m_showun-postedtransactionreport = create m_showun-postedtransactionreport
	this.m_setitempricepolicy = create m_setitempricepolicy
	this.m_populateitemregistrationrequest = create m_populateitemregistrationrequest
	this.m_updateitempricesinactivequotations = create m_updateitempricesinactivequotations
	this.item[upperbound(this.item) + 1] = this.m_populateitem
	this.item[upperbound(this.item) + 1] = this.m_selectmodels
	this.item[upperbound(this.item) + 1] = this.m_setitemassociations
	this.item[upperbound(this.item) + 1] = this.m_setitemnotes
	this.item[upperbound(this.item) + 1] = this.m_setitemauthors
	this.item[upperbound(this.item) + 1] = this.m_garmentsbasicdatawizard
	this.item[upperbound(this.item) + 1] = this.m_setalternateitemaliasnames
	this.item[upperbound(this.item) + 1] = this.m_setitemimages
	this.item[upperbound(this.item) + 1] = this.m_showun-postedtransactionreport
	this.item[upperbound(this.item) + 1] = this.m_setitempricepolicy
	this.item[upperbound(this.item) + 1] = this.m_populateitemregistrationrequest
	this.item[upperbound(this.item) + 1] = this.m_updateitempricesinactivequotations

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_populateitem
	destroy this.m_selectmodels
	destroy this.m_setitemassociations
	destroy this.m_setitemnotes
	destroy this.m_setitemauthors
	destroy this.m_garmentsbasicdatawizard
	destroy this.m_setalternateitemaliasnames
	destroy this.m_setitemimages
	destroy this.m_showun-postedtransactionreport
	destroy this.m_setitempricepolicy
	destroy this.m_populateitemregistrationrequest
	destroy this.m_updateitempricesinactivequotations

