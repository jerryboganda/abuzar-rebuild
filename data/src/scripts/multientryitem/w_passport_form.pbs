// window w_passport_form (multientryitem)  ancestor: w_multi_entry

// w_passport_form.wf_duplicateitemno(string as_itemno) returns boolean
	long ll_icode
	long ll_found
	boolean lb_duplicate
	as_itemno = trim(as_itemno)
	if this.id_detail.rowcount() > 0 then
		ll_icode = this.id_detail.object.code[this.id_detail.rowcount()]
	end if
	ll_found = this.id_alternateitemalias.find("customicode = '" + upper(as_itemno) + "' ", 1, this.id_alternateitemalias.rowcount())
	if ll_found = 0 or ll_found > this.id_alternateitemalias.rowcount() then
		lb_duplicate = false
	else
		lb_duplicate = true
	end if
	if lb_duplicate = false then
		if sqlca.checkuniquealiasname(ll_icode, as_itemno) = 0 then
			lb_duplicate = false
		else
			lb_duplicate = true
		end if
	end if
	return lb_duplicate

// w_passport_form.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_passport_form.wf_populate_ddlb(datawindow dwcontrol) returns 0
	integer li_column_count
	integer li_counter
	string ls_column_name
	string ls_columntype
	this.tab_retrieve.tabpage_list.ddlb_filter_column.reset()
	this.tab_retrieve.tabpage_list.ddlb_sort.reset()
	li_column_count = integer(dwcontrol.object.datawindow.column.count)
	for li_counter = li_column_count to li_counter step -1
		ls_column_name = dwcontrol.describe("#" + string(li_counter) + ".Name")
		this.tab_retrieve.tabpage_list.ddlb_sort.additem(ls_column_name)
		this.tab_retrieve.tabpage_list.ddlb_filter_column.additem(ls_column_name)
	next
	this.tab_retrieve.tabpage_list.ddlb_sort.text = ls_column_name
	ls_columntype = this.id_dwcontrol.describe("#1.ColType")
	if left(ls_columntype, 4) = "char" then
		this.ii_type = 1
	elseif left(ls_columntype, 4) = "date" then
		this.ii_type = 3
	else
		this.ii_type = 2
	end if
	this.ii_colindex = 1
	this.tab_retrieve.tabpage_list.rb_ascending.checked = true
	wf_sortdw(this.tab_retrieve.tabpage_list.ddlb_sort.text, this.is_sortsequence)
	this.id_master.setfocus()

// w_passport_form.wf_retrievelistall() returns long
	return this.id_list.retrieve(f_getgroupcode(gl_usercode))

// w_passport_form.wf_validateitem() returns integer
	long ll_icode
	integer li_errcode
	integer li_null
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "suppcode")
	if vf_dwdupcode1(this.id_detail, "suppcode", string(ll_icode), this.il_currrow) = true then
		messagebox("Duplication Error", "Current row is duplicate")
		li_errcode = -1
	else
		li_errcode = 0
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		setnull(li_null)
		this.id_detail.setcolumn("suppcode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.suppcode[this.il_currrow] = li_null
	end if
	return li_errcode

// w_passport_form.wf_selectmodels() returns 0

// w_passport_form.wf_retrievelist() returns long
	long ll_rtcode
	if this.ib_showiteminlist then
		ll_rtcode = this.id_list.retrieve(f_getgroupcode(gl_usercode))
	else
		ll_rtcode = -1
	end if
	return ll_rtcode

// w_passport_form.wf_set_item_association() returns 0

// w_passport_form.wf_get_itemnotes(long al_icode) returns long
	u_transaction lt_transobject
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server")
		destroy lt_transobject
		return -1
	end if
	SQL SelectBlob notes INTO :this.iblob_notes From ItemNotes Where Icode =:al_icode USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Notes ", "Unable to fetch passport notes.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	return 0

// w_passport_form.wf_insert_itemnotes(long al_icode, integer al_insert_update_mode) returns long
	u_transaction lt_transobject
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server for updating/inserting in Notes")
		destroy lt_transobject
		return -1
	end if
	if al_insert_update_mode = 0 then
		SQL Insert Into ItemNotes ( ICode ) Values ( :al_icode ) USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Insert Error", "Unable to Insert Into Notes.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
			SQL stop USING lt_transobject;
			destroy lt_transobject
			return -1
		end if
		return
	end if
	if not isnull(this.iblob_notes) then
		SQL UpdateBlob ItemNotes Set Notes =:this.iblob_notes Where Icode =:al_icode USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Notes ", "Unable to update notes.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		end if
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	return 0

// w_passport_form.wf_set_itemnotes() returns 0
	s_arguements lstr_arg
	lstr_arg.l_code1 = this.id_master.object.code[this.id_master.getrow()]
	lstr_arg.l_code2 = 1
	lstr_arg.s_name1 = string(this.iblob_notes)
	openwithparm(w_item_form_notes, lstr_arg)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		this.iblob_notes = blob(lstr_arg.s_name1)
	end if

// w_passport_form.wf_select_itemauthor() returns 0

// w_passport_form.wf_select_alternateitemalias() returns 0
	s_dw_header lstr_header
	lstr_header.dw_header = this.id_alternateitemalias
	lstr_header.l_code = this.id_master.object.code[this.id_master.getrow()]
	lstr_header.s_saletype = this.id_master.object.customicode[this.id_master.getrow()]
	openwithparm(w_alternate_item_aliasname_form, lstr_header)

// w_passport_form.wf_setimage() returns long
	long ll_counter
	long ll_code
	long ll_row
	s_itemimage lstr_itemimage
	for ll_counter = 1 to this.id_itemimage.rowcount()
		lstr_itemimage.ls_value[ll_counter, 1] = trim(string(this.id_itemimage.object.rowid[ll_counter]))
		lstr_itemimage.ls_value[ll_counter, 2] = this.id_itemimage.object.imagedescription[ll_counter]
		lstr_itemimage.ls_value[ll_counter, 3] = this.id_itemimage.object.imagetype[ll_counter]
		lstr_itemimage.blob[ll_counter] = this.istr_itemimage.blob[ll_counter]
	next
	openwithparm(w_itemimage, lstr_itemimage)
	lstr_itemimage = message.powerobjectparm
	if lstr_itemimage.i_closemode = 1 then
		this.istr_itemimage = lstr_itemimage
		this.id_itemimage.reset()
		ll_code = this.id_master.object.code[this.id_master.rowcount()]
		for ll_counter = 1 to 200
			if long(lstr_itemimage.ls_value[ll_counter, 1]) > 0 then
				ll_row = this.id_itemimage.insertrow(0)
				this.id_itemimage.object.code[ll_row] = ll_code
				this.id_itemimage.object.rowid[ll_row] = long(lstr_itemimage.ls_value[ll_counter, 1])
				this.id_itemimage.object.imagedescription[ll_row] = lstr_itemimage.ls_value[ll_counter, 2]
				this.id_itemimage.object.imagetype[ll_row] = lstr_itemimage.ls_value[ll_counter, 3]
			end if
		next
	end if
	return 0

// w_passport_form.wf_get_itemimage(long al_icode, long al_row) returns long
	blob lbl_image
	u_transaction lt_transobject
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server")
		destroy lt_transobject
		return -1
	end if
	SQL SelectBlob ItemImage INTO :lbl_image From ItemImage Where Icode =:al_icode AND RowID =:al_row USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Passport Image/Picture ", "Unable to fetch Passport Image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	this.istr_itemimage.blob[al_row] = lbl_image
	return 0

// w_passport_form.wf_populate_itemimage() returns long
	long ll_counter
	long ll_rowcount
	long ll_icode
	ll_rowcount = this.id_itemimage.rowcount()
	if ll_rowcount <= 0 then
		return 0
	end if
	ll_icode = this.id_itemimage.object.code[1]
	for ll_counter = 1 to ll_rowcount
		this.istr_itemimage.ls_value[ll_counter, 1] = trim(string(this.id_itemimage.object.rowid[ll_counter]))
		this.istr_itemimage.ls_value[ll_counter, 2] = this.id_itemimage.object.imagedescription[ll_counter]
		this.istr_itemimage.ls_value[ll_counter, 3] = this.id_itemimage.object.imagetype[ll_counter]
		wf_get_itemimage(ll_icode, ll_counter)
	next
	return 0

// w_passport_form.wf_update_itemimage(long al_code) returns long
	long ll_counter
	long ll_code
	long ll_rowid
	string ls_desc
	string ls_imgtype
	u_transaction lt_transobject
	ll_code = al_code
	if al_code > 0 and this.id_itemimage.rowcount() = 0 then
		return 0
	end if
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server for updating/inserting in Image Table")
		destroy lt_transobject
		return -1
	end if
	SQL DELETE ItemImage WHERE ICode =:ll_code USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to Delete Previous Image Record from database")
		destroy lt_transobject
		return -1
	end if
	for ll_counter = 1 to this.id_itemimage.rowcount()
		ll_rowid = this.id_itemimage.object.rowid[ll_counter]
		ls_desc = this.id_itemimage.object.imagedescription[ll_counter]
		ls_imgtype = this.id_itemimage.object.imagetype[ll_counter]
		SQL INSERT INTO ItemImage ( Icode , ImageDescription , RowID , ImageType ) VALUES ( :ll_code , :ls_desc , :ll_rowid , :ls_imgtype ) USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Insert Error", "Unable to Insert Images Into Image Table.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
			SQL stop USING lt_transobject;
			destroy lt_transobject
			return -1
		end if
		SQL UpdateBlob ItemImage Set ItemImage =:this.istr_itemimage.blob[ll_counter] Where Icode =:ll_code and ROWID =:ll_rowid USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Item Image ", "Unable to update image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		end if
	next
	SQL stop USING lt_transobject;
	destroy lt_transobject
	return 0

// w_passport_form.wf_check_stock_and_unposted_trans(long ai_icode) returns long
	double ld_stock
	long ll_count
	long ll_retcode
	string ls_errtext
	if isnull(ai_icode) then
		ll_retcode = 0
	else
		this.it_transobject.getitemstockall(ai_icode, ld_stock)
		if this.it_transobject.sqlcode = 0 then
			if ld_stock = 0.0 then
				this.it_transobject.checkunpostedtransactionofanitem(ai_icode, ll_count, ls_errtext)
				if this.it_transobject.sqlcode = 0 then
					if ll_count > 0 then
						messagebox("Item Data Validation", "Some Unposted Stock Transactions exists for this item. Please do the needfull and try again.", stopsign!)
						ll_retcode = 2
					else
						ll_retcode = 0
					end if
				end if
			else
				messagebox("Item Data Validation", "Item Stock exists for this item. Please do the needfull and try again.", stopsign!)
				ll_retcode = 1
			end if
		else
			messagebox("Item Data Validation", "Database Error: Item Stock information can not be retrieved", stopsign!)
			ll_retcode = 3
		end if
	end if
	return ll_retcode

// w_passport_form.wf_show_unpostedtransactionreport() returns long
	long ll_icode
	if this.id_master.getrow() > 0 then
		ll_icode = this.id_master.object.code[this.id_master.getrow()]
		if ll_icode > 0 then
			openwithparm(w_showunpostedtransactionreport, ll_icode)
		end if
	end if
	return 0

// w_passport_form.wf_duplicate_regno(string as_regno) returns long
	long ll_icode
	long ll_count
	long ll_retcode
	as_regno = trim(as_regno)
	if this.id_master.rowcount() > 0 then
		ll_icode = this.id_master.object.code[this.id_master.rowcount()]
	end if
	if ll_icode > 0 then
		SQL SELECT ISNULL ( count ( *) , 0 ) INTO :ll_count FROM item WHERE item.regdno =:as_regno and icode <> :ll_icode USING sqlca;
	else
		SQL SELECT ISNULL ( count ( *) , 0 ) INTO :ll_count FROM item WHERE item.regdno =:as_regno USING sqlca;
	end if
	if sqlca.sqlcode = 0 then
		if ll_count > 0 then
			ll_retcode = 1
		else
			ll_retcode = 0
		end if
	else
		ll_retcode = 2
	end if
	return ll_retcode

// w_passport_form.create() returns 0
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_passport_form" then
		this.menuid = create m_passport_form
	end if
	this.dw_alternatealias = create dw_alternatealias
	this.dw_itemimage = create dw_itemimage
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_alternatealias
	this.control[icurrent + 2] = this.dw_itemimage

// w_passport_form.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_alternatealias
	destroy this.dw_itemimage

// w_passport_form.ue_save() returns 0
	long ll_mastercurrrow
	long ll_invid
	long ll_detailrows
	long ll_found
	long ll_null
	long ll_pk
	long ll_code
	long ll_insrow
	integer li_counter
	integer ll_salesmancode
	boolean lb_commitflag
	boolean lb_newitem
	string ls_aliasname
	string ls_itemname
	string ls_errtext
	string ls_alternatealias
	datetime ldt_server_datetime
	string ls_date_errtext
	datastore lds_itemlist
	dwitemstatus lds_rowstatus
	lds_itemlist = create datastore
	lds_itemlist.dataobject = "d_itemlist"
	lds_itemlist.settransobject(this.it_transobject)
	ls_alternatealias = this.id_master.object.alternatealias[1]
	if len(ls_alternatealias) > 0 and ls_alternatealias = this.id_master.object.customicode[1] then
		messagebox("Passport ID Validation", "Passport ID and Alternate No. Can not be same~r~nPlease enter some valid Passport ID/No. and save again.", stopsign!)
		this.id_master.setfocus()
		this.id_master.setcolumn("customicode")
		return
	end if
	setnull(ll_null)
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if this.id_alternateitemalias.rowcount() > 0 and (this.id_alternateitemalias.object.customicode[1] = "" or isnull(this.id_alternateitemalias.object.customicode[1])) then
		this.id_alternateitemalias.deleterow(1)
	end if
	ls_aliasname = this.id_master.getitemstring(this.id_master.getrow(), "CustomICode")
	if isnull(ls_aliasname) then
		messagebox("Passport ID Validation", "Passport ID Not Given~r~nPlease enter some valid Passport ID/No. and save again.", stopsign!)
		this.id_master.setfocus()
		this.id_master.setcolumn("customicode")
		return
	end if
	if this.ib_modify = false then
		lds_itemlist.retrieve()
		ls_aliasname = this.id_master.getitemstring(this.id_master.getrow(), "CustomICode")
		ll_found = lds_itemlist.find("fullcode='" + ls_aliasname + "'", 1, lds_itemlist.rowcount())
		if ll_found > 0 then
			messagebox("Passport ID Validation", "Passport ID already exists.~r~n" + "Kindly change the Passport ID~r~nAlready existing Passport details are:~r~n" + "Name = " + lds_itemlist.getitemstring(ll_found, "itemname") + "~r~n" + "Passport ID = " + lds_itemlist.getitemstring(ll_found, "fullcode"))
			this.id_master.setfocus()
			this.id_master.setcolumn("customicode")
			return
		end if
	else
		lds_itemlist.retrieve()
		ls_aliasname = this.id_master.getitemstring(this.id_master.getrow(), "CustomICode")
		ll_code = this.id_master.getitemnumber(this.id_master.getrow(), "code")
		ll_found = lds_itemlist.find("icode <> " + string(ll_code) + " AND fullcode='" + ls_aliasname + "'", 1, lds_itemlist.rowcount())
		if ll_found > 0 then
			messagebox("Passport ID Validation", "Passport ID already exists.~r~n" + "Kindly change the Passport ID ~r~nAlready existing Passport details are:~r~n" + "Name = " + lds_itemlist.getitemstring(ll_found, "itemname") + "~r~n" + "Passport ID = " + lds_itemlist.getitemstring(ll_found, "fullcode"))
			this.id_master.setfocus()
			this.id_master.setcolumn("customicode")
			return
		end if
	end if
	if this.ib_modify = false then
		lds_itemlist.retrieve()
		if right(this.id_master.getitemstring(this.id_master.getrow(), "name"), 1) <> ")" then
			ls_itemname = this.id_master.getitemstring(this.id_master.getrow(), "name") + " (" + ls_aliasname + ")"
			this.id_master.setitem(this.id_master.getrow(), "name", ls_itemname)
		else
			ls_itemname = this.id_master.getitemstring(this.id_master.getrow(), "name")
		end if
		ll_found = lds_itemlist.find("itemname='" + ls_itemname + "'", 1, lds_itemlist.rowcount())
		if ll_found > 0 then
			messagebox("Passport Validation", "Passport with the same name already exists.~r~n" + "Kindly change the Passport name.~r~nAlready existing Passport details are:~r~n" + "Name = " + lds_itemlist.getitemstring(ll_found, "itemname") + "~r~n" + "Passport ID = " + lds_itemlist.getitemstring(ll_found, "fullcode"))
			return
		end if
	else
		lds_itemlist.retrieve()
		ls_itemname = this.id_master.getitemstring(this.id_master.getrow(), "name")
		ll_code = this.id_master.getitemnumber(this.id_master.getrow(), "code")
		ll_found = lds_itemlist.find("icode <> " + string(ll_code) + " AND itemname='" + ls_itemname + "'", 1, lds_itemlist.rowcount())
		if ll_found > 0 then
			messagebox("Passport Validation", "Passport with the same name already exists.~r~n" + "Kindly change the Passport name.~r~nAlready existing Passport details are:~r~n" + "Name = " + lds_itemlist.getitemstring(ll_found, "itemname") + "~r~n" + "Passport ID = " + lds_itemlist.getitemstring(ll_found, "fullcode"))
			return
		end if
	end if
	setpointer(hourglass!)
	if f_stringpreferences("AskUserPasswordInItem") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		ll_mastercurrrow = this.id_master.getrow()
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			if this.ib_addnewitem = false then
				messagebox("Add New Passport", "You do not have permission to add/define a new Passport", stopsign!)
				return
			end if
			lb_newitem = true
			wf_tabnewid("item", ll_invid)
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
		end if
		this.il_codevalue = ll_invid
		if isnull(this.id_master.getitemnumber(this.id_master.getrow(), "packsalestax")) then
			this.id_master.setitem(this.id_master.getrow(), "packsalestax", 0)
		end if
		if isnull(this.id_master.object.regdno[1]) or this.id_master.object.regdno[1] = "" then
			this.id_master.object.regdno[1] = this.id_master.object.customicode[1]
		end if
		if wf_duplicate_regno(this.id_master.object.regdno[1]) > 0 then
			messagebox("Regd. No.", "Regd. No. " + string(this.id_master.object.regdno[1]) + " already exists.~r~nPlease enter some other regd. no. and save again.", stopsign!)
			this.id_master.setfocus()
			this.id_master.setcolumn("regdno")
			if isnull(ll_pk) then
				this.id_master.object.code[1] = ll_null
			end if
			SQL rollback USING this.it_transobject;
			return
		end if
		ll_detailrows = this.id_detail.rowcount()
		li_counter = 1
		if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			setpointer(arrow!)
			if isnull(ll_pk) then
				this.id_master.object.code[1] = ll_null
			end if
			SQL rollback USING this.it_transobject;
			return
		end if
		if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			if isnull(ll_pk) then
				this.id_master.object.code[1] = ll_null
			end if
			SQL rollback USING this.it_transobject;
			return
		end if
		do while li_counter <= ll_detailrows and lb_commitflag = true
			lds_rowstatus = this.id_detail.getitemstatus(li_counter, 0, primary!)
			if lds_rowstatus = newmodified! then
				this.id_detail.setitem(li_counter, "code", ll_invid)
			end if
			li_counter = li_counter + 1
		loop
		ls_alternatealias = this.id_master.object.alternatealias[1]
		if len(ls_alternatealias) > 0 then
			if this.id_alternateitemalias.rowcount() > 0 then
				this.id_alternateitemalias.deleterow(1)
			end if
			ll_insrow = this.id_alternateitemalias.insertrow(0)
			this.id_alternateitemalias.object.icode[ll_insrow] = ll_invid
			this.id_alternateitemalias.object.customicode[ll_insrow] = ls_alternatealias
		end if
		for li_counter = 1 to li_counter
			if lb_commitflag = true then
				this.id_alternateitemalias.setitem(li_counter, "icode", ll_invid)
			end if
		next
		for li_counter = 1 to li_counter
			if lb_commitflag = true then
				this.id_itemimage.setitem(li_counter, "code", ll_invid)
			end if
		next
		this.id_master.setitem(li_counter, "usercode", ll_salesmancode)
		this.id_master.setitem(li_counter, "lastupdate", ldt_server_datetime)
		if this.id_master.update(true, false) < 0 then
			SQL rollback USING this.it_transobject;
			if lb_newitem = true then
				setnull(ll_null)
				this.id_master.object.code[1] = ll_null
			end if
			setpointer(arrow!)
			return
		end if
		if this.id_detail.update(true, false) > 0 then
			if this.id_alternateitemalias.update(true, false) > 0 then
				SQL commit USING this.it_transobject;
				messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
				if this.ib_modify = true then
					wf_insert_itemnotes(this.id_master.object.code[this.id_master.getrow()], 1)
				else
					wf_insert_itemnotes(this.id_master.object.code[this.id_master.getrow()], 0)
				end if
				if wf_update_itemimage(ll_invid) = 0 then
					this.id_itemimage.reset()
					this.istr_itemimage = this.istr_blank_itemimage
				end if
				this.ib_commitok = true
				this.id_master.resetupdate()
				this.id_detail.resetupdate()
				this.id_alternateitemalias.resetupdate()
				this.im_menu.m_file.m_new.enabled = true
				this.editflag = false
				if gd_recenttransdate < this.id_systemdate then
					gd_recenttransdate = this.id_systemdate
				end if
			else
				ls_errtext = this.it_transobject.sqlerrtext
				SQL rollback USING this.it_transobject;
				messagebox("Database Problem", "Some Database Problem Occured in saving Alternate Item Alias Name(s)!~r~nDetails are:-~r~n" + ls_errtext, stopsign!)
				setpointer(arrow!)
			end if
		else
			ls_errtext = this.it_transobject.sqlerrtext
			SQL rollback USING this.it_transobject;
			setpointer(arrow!)
		end if
	else
		setfocus()
	end if
	if wf_commitform() = false then
		if lb_newitem = true then
			setnull(ll_null)
			this.id_master.object.code[1] = ll_null
		end if
		return
	end if
	setpointer(arrow!)

// w_passport_form.ue_detail() returns 0
	long ll_counter
	long ll_pricepolicycode
	long ll_icode
	long ll_found
	call super::ue_detail
	this.im_menu.m_file.m_delete.enabled = true
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_previous.enabled = true
	this.id_master.setredraw(false)
	wf_protectdw(this.id_master, 1)
	wf_protectdw(this.id_detail, 1)
	this.ib_modify = true
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 510 then
			this.im_menu.m_file.m_save.enabled = true
			this.im_menu.m_item.m_newitem.enabled = true
			this.im_menu.m_item.m_deleteitem.enabled = true
			wf_protectdw(this.id_master, 0)
			wf_protectdw(this.id_detail, 0)
		end if
	next
	this.id_master.setcolumn("alternatealias")
	if this.id_master.rowcount() > 0 then
		ll_icode = this.id_master.object.code[this.id_master.rowcount()]
		this.id_alternateitemalias.retrieve(this.id_master.object.code[this.id_master.rowcount()])
		this.id_itemimage.retrieve(this.id_master.object.code[this.id_master.rowcount()])
		wf_populate_itemimage()
		wf_get_itemnotes(this.id_master.object.code[this.id_master.rowcount()])
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 524", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_master.object.customicode.protect = 0
	else
		this.id_master.object.customicode.protect = 1
	end if
	this.id_master.setredraw(true)

// w_passport_form.ue_newitem() returns 0
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	this.id_detail.setcolumn("suppcode")
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.ib_validatefullcode = true

// w_passport_form.ue_newform() returns 0
	long ll_counter
	call super::ue_newform
	this.id_master.object.customicode.protect = "0"
	this.ib_modify = false
	this.id_master.setfocus()
	this.id_detail.setitem(1, "suppcode", 18)
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	this.id_itemimage.reset()
	this.id_alternateitemalias.reset()
	setnull(this.iblob_notes)

// w_passport_form.ue_postopen() returns 0
	long ll_found
	long ll_itemcolumn_row
	long ll_counter
	boolean lb_customicode
	call super::ue_postopen
	this.is_sortsequence = "A"
	this.id_master.object.manfcode.initial = "1"
	this.id_master.object.icatcode.initial = "1"
	this.id_master.object.iccode.initial = "1"
	this.id_master.object.packcode.initial = "1"
	this.id_master.object.gcode.initial = "1"
	this.id_master.object.locksaleprice.initial = "N"
	this.id_master.object.lockdiscperc.initial = "N"
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 524 then
			lb_customicode = true
			if this.id_master.object.customicode.visible = "1" then
				this.id_master.object.customicode.visible = true
				this.id_master.object.customicode_t.visible = true
			end if
		end if
	next
	if lb_customicode = false then
		this.id_master.object.customicode.visible = false
		this.id_master.object.customicode_t.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 566", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_showiteminlist = true
	else
		this.ib_showiteminlist = false
	end if
	if f_rightexists(5101) then
		this.ib_addnewitem = true
	end if
	this.id_itemimage = this.dw_itemimage
	this.id_itemimage.settransobject(this.it_transobject)
	this.id_alternateitemalias = this.dw_alternatealias
	this.id_alternateitemalias.settransobject(this.it_transobject)
	this.id_master.object.code.protect = 1
	this.im_menu.m_window.m_refreshcatwise.visible = false
	this.im_menu.m_window.m_refreshcustomize.visible = false
	this.im_menu.m_window.m_refreshdrilldownfilter.visible = false
	this.im_menu.m_window.m_refreshfilterstockitemsonly.visible = false
	this.im_menu.m_window.m_refreshitemnamefilter.visible = false

// w_passport_form.open() returns long
	long ancestorreturnvalue
	m_entry lm_menu
	long ll_width
	long ll_height
	environment env
	ancestorreturnvalue = super::open()
	postevent("ue_postopen")
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	lm_menu.dynamic mf_initsecurityapp(lm_menu)
	if getenvironment(env) <> 1 then
		return ::message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.tab_retrieve.width = ll_width * 0.99
	this.tab_retrieve.height = ll_height * 0.83
	this.tab_retrieve.tabpage_detail.dw_detail.width = ll_width * 0.98
	this.tab_retrieve.tabpage_detail.dw_detail.height = ll_height - this.tab_retrieve.tabpage_detail.dw_itemsdetail.height - this.tab_retrieve.tabpage_detail.dw_footer.height
	this.tab_retrieve.tabpage_detail.dw_itemsdetail.width = ll_width * 0.98
	this.tab_retrieve.tabpage_detail.dw_footer.y = this.tab_retrieve.height * 0.90 - this.tab_retrieve.tabpage_detail.dw_footer.height
	this.tab_retrieve.tabpage_detail.dw_detail.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width
	this.tab_retrieve.tabpage_detail.dw_footer.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width
	this.tab_retrieve.tabpage_list.gb_fliter.width = ll_width * 0.97 - this.tab_retrieve.tabpage_list.gb_sort.width
	this.tab_retrieve.tabpage_list.r_1.width = ll_width * 0.99
	this.tab_retrieve.tabpage_list.r_1.height = ll_height * 0.765 - this.tab_retrieve.tabpage_list.gb_sort.height
	this.tab_retrieve.tabpage_list.dw_list.width = ll_width * 0.98
	this.tab_retrieve.tabpage_list.dw_list.height = ll_height * 0.75 - this.tab_retrieve.tabpage_list.dw_list.y
	this.tab_retrieve.tabpage_detail.dw_itemslist.height = ll_height * 0.6
	this.tab_retrieve.tabpage_detail.dw_itemslist.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width * 0.67
	this.tab_retrieve.tabpage_detail.dw_itemslist.x = 1150
	setredraw(true)
	return ::message.returnvalue
