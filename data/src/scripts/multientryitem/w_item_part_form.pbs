// window w_item_part_form (multientryitem)  ancestor: w_multi_entry

// w_item_part_form.wf_validatemodel() returns integer
	long ll_modelcode
	integer li_errcode
	integer li_cat
	ll_modelcode = this.id_detail.getitemnumber(this.il_currrow, "modelcode")
	if isnull(this.id_detail.getitemnumber(this.id_detail.rowcount(), "modelcode")) then
		messagebox("Model Name", "Please Enter a valid model")
		li_errcode = -1
	end if
	if vf_dwdupcode1(this.id_detail, "modelcode", string(ll_modelcode), this.il_currrow) = true then
		messagebox("Duplicate Model Name", "Model has already been selected")
		li_errcode = -1
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		setnull(li_cat)
		this.id_detail.setcolumn("modelcode")
		this.id_detail.setitem(this.il_currrow, "modelcode", li_cat)
		this.id_detail.scrolltorow(this.il_currrow)
	end if
	return li_errcode

// w_item_part_form.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM ItemPart WHERE ItemPart.name =:as_name USING this.it_transobject;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_item_part_form.wf_getmasterpartno(long al_partno) returns long
	long ll_masterpartno
	long ll_retcode
	setnull(ll_masterpartno)
	SQL SELECT MasterIPartCode INTO :ll_masterpartno FROM DBO.ItemPart WHERE IPartCode =:al_partno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ll_masterpartno) then
			ll_retcode = 0
		else
			ll_retcode = ll_masterpartno
		end if
	else
		ll_retcode = -1
	end if
	return ll_retcode

// w_item_part_form.wf_validate_masterpartno(long al_partno) returns long
	long ll_retcode
	long ll_masterpartno
	setnull(ll_masterpartno)
	if al_partno = 0 or isnull(al_partno) then
		ll_retcode = 0
	else
		SQL SELECT MasterIPartCode INTO :ll_masterpartno FROM ItemPart WHERE IPartCode =:al_partno USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			ll_retcode = 1
		elseif isnull(ll_masterpartno) then
			ll_retcode = 0
		else
			ll_retcode = 1
		end if
	end if
	return ll_retcode

// w_item_part_form.wf_open_item_form_popup() returns 0
	this.id_master.accepttext()
	this.istr_buffer.i_status = 1
	this.istr_buffer.s_name1 = this.id_master.object.masterpartname[this.id_master.rowcount()]
	openwithparm(w_master_item_part_form_popup, this, this)

// w_item_part_form.wf_setmasterpartinfo(long al_code) returns long
	string ls_name
	string ls_description
	string ls_application
	string ls_remarks
	string ls_manfname
	long ll_manfcode
	long ll_icatcode
	long ll_iccode
	long ll_gcode
	long ll_reorderlevel
	long ll_retcode
	long ll_counter
	long ll_modelcount
	long ll_detailrow
	long ll_ipartcode
	long ll_detailrowcount
	long ll_minlevel
	long ll_maxlevel
	long ll_code
	long ll_qtyused
	double ld_saleprice
	double ld_purprice
	datastore lds_modelinfo
	if this.id_master.getrow() > 0 then
		SQL SELECT ManfName =( SELECT M.Name FROM Manufacturer M WHERE M.ManfCode IN ( SELECT IP.ManfCode FROM ItemPart IP WHERE IP.IPartCode =:al_code ) ) , Name , Description , Application , ManfCode , ICatCode , ICCode , GCode , ReOrderLevel , SalePrice , PurPrice , Remarks , MinLevel , MaxLevel , QtyUsed INTO :ls_manfname, :ls_name, :ls_description, :ls_application, :ll_manfcode, :ll_icatcode, :ll_iccode, :ll_gcode, :ll_reorderlevel, :ld_saleprice, :ld_purprice, :ls_remarks, :ll_minlevel, :ll_maxlevel, :ll_qtyused FROM ItemPart WHERE IPartCode =:al_code AND MasterIPartCode IS NULL USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			ll_detailrowcount = this.id_detail.rowcount()
			for ll_counter = 1 to ll_detailrowcount
				this.id_detail.deleterow(0)
			next
			if ls_remarks = "" or isnull(ls_remarks) then
				ls_remarks = "."
			end if
			ll_code = this.id_master.object.code[this.id_master.getrow()]
			this.id_master.object.masteripartcode[this.id_master.getrow()] = al_code
			this.id_master.object.masterpartname[this.id_master.getrow()] = ls_name
			this.id_master.object.icatcode[this.id_master.getrow()] = ll_icatcode
			this.id_master.object.iccode[this.id_master.getrow()] = ll_iccode
			this.id_master.object.gcode[this.id_master.getrow()] = ll_gcode
			this.id_master.object.purprice[this.id_master.getrow()] = ld_purprice
			this.id_master.object.saleprice[this.id_master.getrow()] = ld_saleprice
			this.id_master.object.reorderlevel[this.id_master.getrow()] = ll_reorderlevel
			this.id_master.object.description[this.id_master.getrow()] = ls_description
			this.id_master.object.application[this.id_master.getrow()] = ls_application
			this.id_master.object.remarks[this.id_master.getrow()] = ls_remarks
			this.id_master.object.minlevel[this.id_master.getrow()] = ll_minlevel
			this.id_master.object.maxlevel[this.id_master.getrow()] = ll_maxlevel
			this.id_master.object.qtyused[this.id_master.getrow()] = ll_qtyused
			lds_modelinfo = create datastore
			lds_modelinfo.dataobject = "d_itempartinmodel"
			lds_modelinfo.settransobject(this.it_transobject)
			lds_modelinfo.retrieve(al_code)
			ll_modelcount = lds_modelinfo.rowcount()
			if ll_modelcount > 0 then
				for ll_counter = 1 to ll_modelcount
					ll_detailrow = this.id_detail.insertrow(0)
					this.id_detail.object.code[ll_detailrow] = ll_code
					this.id_detail.object.modelcode[ll_detailrow] = lds_modelinfo.object.modelcode[ll_counter]
				next
			end if
			ll_retcode = 0
		else
			messagebox("Master PartNo.", "Can not retrieve information~r~nPossible Reason: " + this.it_transobject.sqlerrtext, stopsign!)
			ll_retcode = 1
		end if
	else
		messagebox("Master PartNo.", "Please Select Some row from list tab.", stopsign!)
		ll_retcode = 1
	end if
	return ll_retcode

// w_item_part_form.wf_populate_ddlb(datawindow dwcontrol) returns 0
	integer li_column_count
	integer li_counter
	string ls_column_name
	string ls_columntype
	this.tab_retrieve.tabpage_list.ddlb_filter_column.reset()
	this.tab_retrieve.tabpage_list.ddlb_sort.reset()
	li_column_count = integer(dwcontrol.object.datawindow.column.count)
	for li_counter = li_column_count to li_counter step -1
		ls_column_name = dwcontrol.describe("#" + string(li_counter) + ".Name")
		this.tab_retrieve.tabpage_list.ddlb_sort.additem(ls_column_name)
		this.tab_retrieve.tabpage_list.ddlb_filter_column.additem(ls_column_name)
	next
	this.tab_retrieve.tabpage_list.ddlb_sort.text = ls_column_name
	ls_columntype = this.id_dwcontrol.describe("#1.ColType")
	if left(ls_columntype, 4) = "char" then
		this.ii_type = 1
	elseif left(ls_columntype, 4) = "date" then
		this.ii_type = 3
	else
		this.ii_type = 2
	end if
	this.ii_colindex = 1
	this.tab_retrieve.tabpage_list.rb_ascending.checked = true
	this.is_sortsequence = "A"
	wf_sortdw(this.tab_retrieve.tabpage_list.ddlb_sort.text, this.is_sortsequence)
	this.id_master.setfocus()

// w_item_part_form.wf_find_masteritempart_info(string as_data) returns long
	string ls_name
	string ls_description
	string ls_application
	string ls_mastername
	long ll_manfcode
	long ll_icatcode
	long ll_iccode
	long ll_gcode
	long ll_reorderlevel
	long ll_retcode
	long ll_counter
	long ll_modelcount
	long ll_detailrow
	long ll_ipartcode
	long ll_masteripartcode
	long ll_icode
	long ll_detailrowcount
	long ll_currrow
	double ld_saleprice
	double ld_purprice
	ll_currrow = this.id_master.getrow()
	if ll_currrow > 0 then
		SQL SELECT IPartCode , Name INTO :ll_ipartcode, :ls_name FROM DBO.ItemPart WHERE Name =:as_data AND masteripartcode IS NULL USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			ll_detailrowcount = this.id_detail.rowcount()
			for ll_counter = 1 to ll_detailrowcount
				this.id_detail.deleterow(0)
			next
			ll_icode = this.id_master.object.code[ll_currrow]
			this.id_master.object.masteripartcode[ll_currrow] = ll_ipartcode
			ll_retcode = 0
		else
			SQL SELECT IPartCode , Name INTO :ll_ipartcode, :ls_name FROM DBO.ItemPart WHERE IPartCode IN ( SELECT DISTINCT IP.MasterIPartCode FROM DBO.ItemPart IP WHERE Name =:as_data AND masteripartcode IS NOT NULL ) USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				ll_detailrowcount = this.id_detail.rowcount()
				for ll_counter = 1 to ll_detailrowcount
					this.id_detail.deleterow(0)
				next
				ll_icode = this.id_master.object.code[ll_currrow]
				this.id_master.object.masteripartcode[ll_currrow] = ll_ipartcode
				this.id_master.object.masterpartname[ll_currrow] = ls_name
				ll_retcode = 0
			else
				ll_retcode = 1
			end if
		end if
	else
		ll_retcode = 1
	end if
	return ll_retcode

// w_item_part_form.wf_get_masteritempart_name(long al_code, string as_name) returns long
	long ll_retcode
	SQL SELECT Name INTO :as_name FROM Dbo.ItemPart WHERE IPartCode =:al_code AND MasterIPartCode IS NULL USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if as_name = "" or isnull(as_name) then
			ll_retcode = 0
		end if
	else
		ll_retcode = 1
	end if
	return ll_retcode

// w_item_part_form.create() returns 0 [event]
	call super::create

// w_item_part_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_item_part_form.ue_save() returns 0 [event]
	long ll_counter
	long ll_code
	long ll_oldmasterpart
	long ll_newmasterpart
	long ll_partcount
	long ll_row
	long ll_detailrow
	boolean lb_cascade_update
	setpointer(hourglass!)
	ll_detailrow = this.id_detail.rowcount()
	if ll_detailrow > 0 and isnull(this.id_detail.object.modelcode[ll_detailrow]) then
		this.id_detail.deleterow(ll_detailrow)
	end if
	if this.ib_itemvalidated = false and wf_validatemodel() = -1 then
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	ll_code = this.id_master.getitemnumber(this.id_master.getrow(), "code")
	ll_row = this.id_master.getrow()
	ll_detailrow = this.id_detail.rowcount()
	if ll_detailrow > 0 and isnull(this.id_detail.object.modelcode[ll_detailrow]) then
		this.id_detail.deleterow(ll_detailrow)
	end if
	if ll_row > 0 then
		ll_oldmasterpart = this.id_master.object.oldmasteripartcode[ll_row]
		ll_newmasterpart = this.id_master.object.masteripartcode[ll_row]
	else
		return
	end if
	if isnull(ll_code) then
		if ll_oldmasterpart = ll_newmasterpart then
			if wf_validate_masterpartno(ll_newmasterpart) > 0 then
				messagebox("Master Part No. Validation!", "Please Select a valid Part No.")
				this.id_master.setcolumn("masterpartname")
				this.id_master.setfocus()
				return
			end if
		elseif isnull(ll_newmasterpart) then
			if wf_validate_masterpartno(ll_newmasterpart) > 0 then
				messagebox("Master Part No. Validation!", "Please Select a valid Part No.")
				this.id_master.setcolumn("masterpartname")
				this.id_master.setfocus()
				return
			end if
		elseif wf_validate_masterpartno(ll_newmasterpart) > 0 then
			messagebox("Master Part No. Validation!", "Please Select a valid Part No.")
			this.id_master.setcolumn("masterpartname")
			this.id_master.setfocus()
			return
		end if
	elseif ll_oldmasterpart = ll_newmasterpart then
		if wf_validate_masterpartno(ll_newmasterpart) > 0 then
			messagebox("Master Part No. Validation!", "Please Select a valid Part No.")
			this.id_master.setcolumn("masterpartname")
			this.id_master.setfocus()
			return
		end if
	elseif isnull(ll_newmasterpart) then
		if wf_validate_masterpartno(ll_newmasterpart) > 0 then
			messagebox("Master Part No. Validation!", "Please Select a valid Part No.")
			this.id_master.setcolumn("masterpartname")
			this.id_master.setfocus()
			return
		end if
	elseif wf_validate_masterpartno(ll_newmasterpart) > 0 then
		messagebox("Master Part No. Validation!", "Please Select a valid Part No.")
		this.id_master.setcolumn("masterpartname")
		this.id_master.setfocus()
		return
	else
		SQL SELECT COUNT ( IPartCode ) INTO :ll_partcount FROM DBO.ItemPart WHERE MasterIPartCode =:ll_code USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if ll_partcount <> 0 then
				messagebox("Master Part No. Validation!", "This Part No. is already master to " + trim(string(ll_partcount)) + " Item Part(s), Cascading Update Now")
				lb_cascade_update = true
			end if
		else
			messagebox("Master Part No. Validation!", "Problem in Fetching Part No. information~r~n" + this.it_transobject.sqlerrtext)
			return
		end if
	end if
	SQL rollback USING this.it_transobject;
	if isnull(ll_code) then
		ll_code = 0
		wf_tabnewid("itempart", ll_code)
		this.id_master.setitem(ll_row, "code", ll_code)
	end if
	for ll_counter = 1 to this.id_detail.rowcount()
		this.id_detail.setitem(ll_counter, "code", ll_code)
	next
	if lb_cascade_update = true then
		SQL update DBO.ItemPart SET MasterIPartCode =:ll_newmasterpart WHERE MasterIPartCode =:ll_code USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			SQL rollback USING this.it_transobject;
			setpointer(arrow!)
			messagebox("Save Changes", "Changes Rollback in database, ~n~rSome database problem occurs", exclamation!, ok!, 1)
			return
		end if
		return
	end if
	if this.id_master.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return
	end if
	if this.id_detail.update(true, false) > 0 then
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		this.ib_commitok = true
		this.il_codevalue = ll_code
		this.id_master.resetupdate()
		this.im_menu.m_file.m_new.enabled = true
		this.editflag = false
		if gd_recenttransdate < this.id_systemdate then
			gd_recenttransdate = this.id_systemdate
		end if
	else
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return
	end if
	setpointer(arrow!)

// w_item_part_form.ue_newform() returns 0 [event]
	call super::ue_newform
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true
	this.id_master.object.manfcode.initial = string(f_numberpreferences("ItemDefaultmanfcode"))
	this.id_master.object.icatcode.initial = string(f_numberpreferences("ItemDefaultcategory"))
	this.id_master.object.iccode.initial = string(f_numberpreferences("ItemDefaultclass"))
	this.id_master.object.gcode.initial = string(f_numberpreferences("ItemDefaultAssociatedGcode"))
	this.id_master.setfocus()

// w_item_part_form.ue_newitem() returns 0 [event]
	if this.ib_itemvalidated = false and wf_validatemodel() = -1 then
		return
	end if
	call super::ue_newitem

// w_item_part_form.ue_detail() returns 0 [event]
	long ll_code
	long ll_rowcount
	call super::ue_detail
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.im_menu.m_file.m_print.enabled = true
	this.i_editmode = 2
	this.i_retrievemode = 2
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	this.id_dwcontrol = this.id_master
	ll_rowcount = wf_retrieve(ll_code)
	this.id_dwcontrol = this.id_detail
	wf_retrieve(ll_code)
	this.id_detail.setrow(1)
	this.id_detail.scrolltorow(1)
	this.id_detail.setcolumn("modelcode")
	this.id_detail.setfocus()
	this.id_dwcontrol = this.id_list
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_new.visible = false
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true

// w_item_part_form.ue_deleteitem() returns 0 [event]
	long ll_currow
	long ll_detailrows
	this.ib_itemvalidated = true
	this.id_detail.deleterow(0)
	ll_detailrows = this.id_detail.rowcount()
	wf_grandtotal()

// w_item_part_form.ue_postopen() returns 0 [event]
	long ll_rtncode
	call super::ue_postopen
	ll_rtncode = this.id_detail.getchild("modelcode", this.idc_model)
	if ll_rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	this.idc_model.settransobject(this.it_transobject)
	this.idc_model.retrieve()
	ll_rtncode = this.id_master.getchild("masteripartcode", this.idc_masterpart)
	if ll_rtncode = -1 then
		messagebox("Error", "Not a DataWindowChild")
	end if
	ll_rtncode = this.idc_masterpart.settransobject(this.it_transobject)
	this.idc_masterpart.retrieve()

// w_item_part_form.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	return ::message.returnvalue

// w_item_part_form.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	this.idc_model.retrieve()
	this.idc_masterpart.retrieve()

// w_item_part_form.ue_callback_popupwindow(any ar_object) returns 0 [event]
	long ll_code
	long ll_row
	string as_errortext
	string ls_name
	string ls_null
	super::ue_callback_popupwindow(ar_object)
	setnull(ls_null)
	ll_code = long(ar_object)
	ll_row = this.id_master.getrow()
	if ll_row > 0 and ll_code > 0 then
		if wf_get_masteritempart_name(ll_code, ls_name) = 0 and this.id_master.rowcount() > 0 then
			this.id_master.setitem(this.id_master.rowcount(), "masterpartname", ls_name)
			wf_find_masteritempart_info(ls_name)
			wf_setmasterpartinfo(ll_code)
			this.id_master.setfocus()
			this.id_master.setcolumn("masterpartname")
		end if
		this.id_master.accepttext()
		return
	end if
	this.id_master.setitem(this.id_master.rowcount(), "masterpartname", ls_null)
	this.id_master.accepttext()
	this.id_master.setcolumn("masterpartname")
	this.id_master.setfocus()

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long li_option
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "name"
		if parent.parent.parent.wf_duplicatename(data) then
			messagebox("Part No. Validation", "Duplicate Part No. Error~n~rPlease Enter Some valid Part No.")
			return 1
		end if
	case "masterpartname"
		if not isnull(data) then
			if this.object.name[row] = data then
				messagebox("Master Part No. Validation", "Part No Can not be master to itself~n~rPlease Enter Some valid Part No. or Leave Empty for Master")
				return 1
			end if
			if parent.parent.parent.wf_find_masteritempart_info(data) > 0 then
				li_option = messagebox("Master Part No. Validation", "Master Part Number Does Not Exist~r~nDo you want to define a new one?", question!, yesno!, 1)
				if li_option = 1 then
					parent.parent.parent.wf_open_item_form_popup()
					if parent.parent.parent.il_codevalue = 0 or isnull(parent.parent.parent.il_codevalue) then
						return 1
					end if
				else
					return 1
				end if
			else
				parent.parent.parent.wf_setmasterpartinfo(this.object.masteripartcode[row])
				return 2
			end if
		end if
	case "masteripartcode"
		if not (isnull(data) or data = "") then
			if long(data) = getitemnumber(row, "code") then
				messagebox("Part No. Validation", "Part No Can not be master to itself~n~rPlease Enter Some valid Part No. or Leave Empty for Master")
				return 1
			elseif parent.parent.parent.wf_validate_masterpartno(long(data)) = 0 then
				return parent.parent.parent.wf_setmasterpartinfo(long(data))
			else
				return 1
			end if
		end if
		return
	end choose
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "code"
		if data = "" or isnull(data) then
			messagebox("Part Code Validation", "Value required for " + upper(dwo.name) + " in current row")
		end if
	case "masteripartcode"
	end choose
	return 1

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	return ::message.returnvalue

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if string(dwo.name) = "ipartcode" or string(dwo.name) = "masteripartcode" or string(dwo.name) = "manfcode" or string(dwo.name) = "iccode" or string(dwo.name) = "icatcode" or string(dwo.name) = "gcode" then
		parent.parent.parent.id_master.selecttext(1, 60)
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	string ls_managername
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "modelcode"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_itemvalidated = false
		li_errcode = 0
	case else
		parent.parent.parent.ib_itemvalidated = true
	end choose
	return li_errcode

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "modelcode"
		if data = "" or isnull(data) then
			messagebox("Model Validation", "Value required for Model in current row")
		end if
	end choose
	return 1

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validatemodel() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validatemodel() = -1 then
			return 0
		end if
		parent.parent.parent.event ue_newitem()
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1
