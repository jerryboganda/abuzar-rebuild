// dw_rx.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	long ancestorreturnvalue
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_rowm
	long ll_rowcount
	long ll_icode
	long ll_found
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if parent.parent.parent.il_protect = 0 then
		if keyflags = 2 then
			if key = keyi! then
				if parent.parent.parent.ib_rowvalidated = false and parent.parent.parent.wf_validateitem(getrow()) = -1 then
					return ::message.returnvalue
				end if
				if getrow() > 0 and isnull(this.object.icode[getrow()]) then
					return ::message.returnvalue
				end if
				if rowcount() > 0 and f_validatedw(this) < 0 then
					return ::message.returnvalue
				end if
				ll_rowcount = insertrow(0)
				if parent.parent.parent.id_vitals.rowcount() > 0 and ll_rowcount > 0 then
					parent.parent.parent.id_rx.object.bsa[ll_rowcount] = parent.parent.parent.id_vitals.object.bsa[1]
				end if
				if ll_rowcount > 1 then
					scrolltorow(ll_rowcount)
					setcolumn("itemname")
					setfocus()
					parent.parent.parent.id_selectionlist.show()
					parent.parent.parent.il_currrow = ll_rowcount
				end if
			elseif key = keyd! then
				parent.parent.parent.ib_rowvalidated = true
				if rowcount() > 0 then
					deleterow(0)
				end if
				ll_rowcount = rowcount()
				parent.parent.parent.il_currrow = ll_rowcount
				if ll_rowcount > 1 then
					scrolltorow(ll_rowcount)
					setcolumn("itemname")
					setfocus()
					parent.parent.parent.id_selectionlist.hide()
				end if
				parent.parent.parent.ib_rowvalidated = true
			end if
		end if
		if getcolumnname() = "itemname" then
			ll_rowm = getrow()
			setredraw(false)
			if key = keydownarrow! then
				parent.parent.parent.id_selectionlist.selectrow(0, false)
				parent.parent.parent.id_selectionlist.scrollnextrow()
				ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
				rt_code = 1
			elseif key = keyuparrow! then
				parent.parent.parent.id_selectionlist.selectrow(0, false)
				parent.parent.parent.id_selectionlist.scrollpriorrow()
				ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
				rt_code = 1
			elseif key = keypagedown! then
				parent.parent.parent.id_selectionlist.selectrow(0, false)
				parent.parent.parent.id_selectionlist.scrollnextpage()
				ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
				rt_code = 1
			elseif key = keypageup! then
				parent.parent.parent.id_selectionlist.selectrow(0, false)
				parent.parent.parent.id_selectionlist.scrollpriorpage()
				ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
				rt_code = 1
			elseif key = keyend! then
				parent.parent.parent.id_selectionlist.selectrow(0, false)
				parent.parent.parent.id_selectionlist.scrolltorow(parent.parent.parent.id_selectionlist.rowcount())
				ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
				rt_code = 1
			elseif key = keyhome! then
				parent.parent.parent.id_selectionlist.selectrow(0, false)
				parent.parent.parent.id_selectionlist.scrolltorow(1)
				ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
				rt_code = 1
			elseif key = keyback! then
				parent.parent.parent.ib_bkspace = true
				setredraw(true)
			elseif key = keyescape! then
				if parent.parent.parent.id_selectionlist.visible = false then
					return ::message.returnvalue
				end if
				parent.parent.parent.id_selectionlist.hide()
				setfocus()
				setredraw(true)
			elseif key = keyf4! then
				parent.parent.parent.id_selectionlist.show()
				parent.parent.parent.id_selectionlist.selectrow(0, false)
				parent.parent.parent.id_selectionlist.scrolltorow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_selectionlist.selectrow(parent.parent.parent.il_itemlistfoundrow, true)
				setredraw(true)
			elseif key = keyf5! then
				parent.parent.parent.id_selectionlist.hide()
				setredraw(true)
				ll_icode = f_drilldown_itemsearch("criteriasearch", 1)
				parent.parent.parent.id_selectionlist.setfilter("")
				parent.parent.parent.id_selectionlist.filter()
				if ll_icode > 0 then
					ll_found = parent.parent.parent.id_selectionlist.find("code = " + string(ll_icode), 1, parent.parent.parent.id_selectionlist.rowcount())
					if ll_found > 0 then
						ll_listcurrrow = ll_found
						parent.parent.parent.id_selectionlist.selectrow(0, false)
						parent.parent.parent.id_selectionlist.selectrow(ll_listcurrrow, true)
						rt_code = 1
					end if
				end if
				setfocus()
			elseif key = keyf6! then
				parent.parent.parent.id_selectionlist.hide()
				setredraw(true)
				ll_icode = f_drilldown_itemsearch("namesearch", 1)
				parent.parent.parent.id_selectionlist.setfilter("")
				parent.parent.parent.id_selectionlist.filter()
				if ll_icode > 0 then
					ll_found = parent.parent.parent.id_selectionlist.find("code = " + string(ll_icode), 1, parent.parent.parent.id_selectionlist.rowcount())
					if ll_found > 0 then
						ll_listcurrrow = ll_found
						parent.parent.parent.id_selectionlist.selectrow(0, false)
						rt_code = 1
					end if
				end if
				setfocus()
			elseif key = keyf7! then
				if not isnull(getitemnumber(ll_rowm, "icode")) then
					ll_icode = getitemnumber(ll_rowm, "icode")
					parent.parent.parent.id_selectionlist.hide()
					setredraw(true)
					ll_icode = f_prefered_itemsearch(ll_icode)
					parent.parent.parent.id_selectionlist.setfilter("")
					parent.parent.parent.id_selectionlist.filter()
					if ll_icode > 0 then
						ll_found = parent.parent.parent.id_selectionlist.find("code = " + string(ll_icode), 1, parent.parent.parent.id_selectionlist.rowcount())
						if ll_found > 0 then
							ll_listcurrrow = ll_found
							parent.parent.parent.id_selectionlist.selectrow(0, false)
							rt_code = 1
						end if
					end if
				end if
				setfocus()
			elseif isnull(getitemnumber(getrow(), "icode")) and key = keyenter! then
				parent.parent.parent.id_selectionlist.hide()
				parent.parent.parent.id_selectionlist.selectrow(0, false)
				parent.parent.parent.id_selectionlist.scrolltorow(parent.parent.parent.id_selectionlist.getrow())
				parent.parent.parent.id_selectionlist.selectrow(parent.parent.parent.id_selectionlist.getrow(), true)
				ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
				setitem(ll_rowm, "icode", parent.parent.parent.id_selectionlist.getitemnumber(ll_listcurrrow, "code"))
				setitem(ll_rowm, "itemname", parent.parent.parent.id_selectionlist.getitemstring(ll_listcurrrow, "name"))
				selecttext(1, len(gettext()))
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.ib_rowvalidated = false
				setredraw(true)
			else
				setredraw(true)
			end if
			if rt_code = 1 then
				parent.parent.parent.id_selectionlist.selectrow(0, false)
				parent.parent.parent.id_selectionlist.selectrow(ll_listcurrrow, true)
				parent.parent.parent.il_itemlistfoundrow = ll_listcurrrow
				setitem(ll_rowm, "icode", parent.parent.parent.id_selectionlist.getitemnumber(ll_listcurrrow, "code"))
				setitem(ll_rowm, "itemname", parent.parent.parent.id_selectionlist.getitemstring(ll_listcurrrow, "name"))
				selecttext(1, len(gettext()))
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.ib_rowvalidated = false
				setredraw(true)
			end if
		end if
	end if
	if key = keyf8! and parent.parent.parent.ib_viewimage then
		parent.parent.parent.wf_show_patient_gallery()
	end if
	if key = keyf11! then
		parent.parent.parent.wf_show_rx_value()
	end if
	if key = keyf12! then
		parent.parent.parent.wf_populate_diseasetemplate()
	end if
	if key = keyf9! then
		parent.parent.parent.wf_populate_diseasetreatment_template()
	end if
	setfocus()
	if keyflags = 2 and key = keys! then
		parent.parent.parent.cb_ok.triggerevent(clicked!)
	end if
	return rt_code

// dw_rx.getfocus() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	setfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_rx.itemfocuschanged(long row, dwobject dwo) returns long
	long ancestorreturnvalue
	string ls_itemname
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.wf_update_totalqty(row)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(row) = -1 then
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.ib_rowvalidated = false
		return ::message.returnvalue
	end if
	if row > 0 then
		choose case dwo.name
		case "itemname"
			ls_itemname = this.object.itemname[row]
			if isnull(ls_itemname) then
				ls_itemname = ""
			end if
			parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_selectionlist.find("name = '" + ls_itemname + "'", 1, parent.parent.parent.id_selectionlist.rowcount())
			if parent.parent.parent.il_itemlistfoundrow > parent.parent.parent.id_selectionlist.rowcount() then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_selectionlist.rowcount()
			elseif isnull(parent.parent.parent.il_itemlistfoundrow) or parent.parent.parent.il_itemlistfoundrow = 0 then
				parent.parent.parent.il_itemlistfoundrow = 1
			end if
			parent.parent.parent.id_selectionlist.show()
			parent.parent.parent.id_selectionlist.selectrow(0, false)
			parent.parent.parent.id_selectionlist.scrolltorow(parent.parent.parent.il_itemlistfoundrow)
			parent.parent.parent.id_selectionlist.selectrow(parent.parent.parent.il_itemlistfoundrow, true)
		case else
			parent.parent.parent.id_selectionlist.hide()
		end choose
	end if
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_rx.ue_enterkey() returns long
	long ancestorreturnvalue
	long ll_rowcount
	ancestorreturnvalue = super::ue_enterkey()
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		if parent.parent.parent.id_rx.rowcount() > 0 and f_validatedw(parent.parent.parent.id_rx) < 0 then
			return ::message.returnvalue
		end if
		if parent.parent.parent.ib_rowvalidated = false and parent.parent.parent.wf_validateitem(getrow()) = -1 then
			return 1
		end if
		ll_rowcount = parent.parent.parent.id_rx.insertrow(0)
		if parent.parent.parent.id_vitals.rowcount() > 0 and ll_rowcount > 0 then
			parent.parent.parent.id_rx.object.bsa[ll_rowcount] = parent.parent.parent.id_vitals.object.bsa[1]
		end if
		if ll_rowcount > 1 then
			parent.parent.parent.id_rx.scrolltorow(ll_rowcount)
			parent.parent.parent.id_rx.setcolumn("itemname")
			parent.parent.parent.id_rx.setfocus()
		end if
		return 1
	end if
	if getcolumnname() = "itemname" then
		parent.parent.parent.id_selectionlist.hide()
		if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(getrow()) = -1 then
			return 1
		end if
		return
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_rx.editchanged(long row, dwobject dwo, string data) returns long
	long ancestorreturnvalue
	long ll_currrow
	long ll_startrow
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	ll_startrow = 0
	choose case dwo.name
	case "itemname"
		if upper(left(data, 1)) >= "A" and upper(left(data, 1)) <= "Z" or left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
			ll_currrow = parent.parent.parent.id_selectionlist.getrow()
			if len(data) > 1 then
				ll_startrow = ll_currrow
			else
				if left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
					ll_startrow = 1
				else
					ll_startrow = parent.parent.parent.ia_llookuptable[asc(upper(data))]
				end if
				parent.parent.parent.ib_bkspace = false
			end if
			if parent.parent.parent.ib_bkspace then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_selectionlist.find("Lower(name) <= '" + lower(data) + "'", ll_startrow, 0)
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.il_itemlistfoundrow + 1
				parent.parent.parent.ib_bkspace = false
			else
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_selectionlist.find("Lower(name) >= '" + lower(data) + "'", ll_startrow, 99999)
			end if
			if parent.parent.parent.il_itemlistfoundrow = 0 then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_selectionlist.rowcount()
			end if
			if parent.parent.parent.il_itemlistfoundrow <> ll_currrow then
				parent.parent.parent.id_selectionlist.selectrow(0, false)
				parent.parent.parent.id_selectionlist.setrow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_selectionlist.scrolltorow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_selectionlist.selectrow(parent.parent.parent.il_itemlistfoundrow, true)
				setfocus()
			elseif parent.parent.parent.il_itemlistfoundrow = ll_currrow then
				parent.parent.parent.id_selectionlist.selectrow(0, false)
				parent.parent.parent.id_selectionlist.setrow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_selectionlist.scrolltorow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_selectionlist.selectrow(parent.parent.parent.il_itemlistfoundrow, true)
				setfocus()
			end if
		end if
	end choose
	return ::message.returnvalue

// dw_rx.itemchanged(long row, dwobject dwo, string data) returns long
	long ancestorreturnvalue
	integer li_retcode
	long ll_icode
	long ll_null
	long ll_gcode
	string ls_itemname
	string ls_null
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case "dosagecode"
		parent.parent.parent.wf_dosageinfo(long(data), row)
		this.object.manualchangeintotqty[row] = 0
	case "itemname"
		setitem(row, "icode", parent.parent.parent.id_selectionlist.getitemnumber(parent.parent.parent.id_selectionlist.getrow(), "code"))
		setitem(row, "itemname", parent.parent.parent.id_selectionlist.getitemstring(parent.parent.parent.id_selectionlist.getrow(), "name"))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.ib_rowvalidated = false
		parent.parent.parent.il_currrow = row
		li_retcode = 1
	case "qty"
		if double(data) <= 0.0 then
			messagebox("Qty Validation!", "Please enter valid Qty")
			return 1
		end if
		this.object.manualchangeintotqty[row] = 0
	case "totalqty"
		if double(data) <= 0.0 then
			messagebox("Total Qty Validation!", "Please enter valid Total Qty")
			return 1
		else
			this.object.manualchangeintotqty[row] = 1
		end if
	case "duration"
		if long(data) < 0 then
			messagebox("Duration Validation!", "Please enter a valid duration")
			return 1
		end if
		this.object.manualchangeintotqty[row] = 0
	case else
		parent.parent.parent.ib_rowvalidated = true
	end choose
	return li_retcode

// dw_rx.itemerror(long row, dwobject dwo, string data) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "itemname"
		messagebox("Item Validation", "Please enter valid Item Name")
	case "qty"
		messagebox("Qty Validation", "Please enter valid Qty")
	case "duration"
		messagebox("Duration Validation", "Please enter valid duration")
	end choose
	return 1

// dw_rx.losefocus() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.id_selectionlist.hide()
	return ::message.returnvalue

// dw_rx.rowfocuschanged(long currentrow) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	parent.parent.parent.wf_update_totalqty(currentrow)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(getrow()) = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_rx.rowfocuschanging(long currentrow, long newrow) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::rowfocuschanging(currentrow, newrow)
	parent.parent.parent.wf_update_totalqty(currentrow)
	return ::message.returnvalue

// dw_selectionlist.ue_setfocus() returns 0
	parent.parent.parent.id_tg.setcolumn("itemname")
	parent.parent.parent.id_tg.setfocus()

// dw_selectionlist.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::doubleclicked(xpos, ypos, row, dwo)
	post event ue_setfocus()
	return ::message.returnvalue

// dw_selectionlist.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long
	long ancestorreturnvalue
	long ll_rowmain
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	if row > 0 then
		ll_rowmain = parent.parent.parent.id_tg.getrow()
		parent.parent.parent.id_tg.setitem(ll_rowmain, "icode", parent.parent.parent.id_selectionlist.getitemnumber(row, "code"))
		parent.parent.parent.id_tg.setitem(ll_rowmain, "itemname", parent.parent.parent.id_selectionlist.getitemstring(row, "name"))
		parent.parent.parent.id_tg.selecttext(1, len(gettext()))
		parent.parent.parent.ib_itemvalidated = false
		selectrow(0, false)
		selectrow(row, true)
		post event ue_setfocus()
	end if
	return ::message.returnvalue

// tabpage_obs_us.create() returns 0
	this.dw_obs_us = create dw_obs_us
	this.control = {this.dw_obs_us}

