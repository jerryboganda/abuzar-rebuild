		elseif this.id_vitals.object.bsamethod[1] = 2 then
			this.id_vitals.object.bsa[1] = (ld_height * ld_weight / 3600.0) ^ 0.5
		elseif this.id_vitals.object.bsamethod[1] = 3 then
			this.id_vitals.object.bsa[1] = 0.024265 * ld_height ^ 0.3964 * ld_weight ^ 0.5378
		elseif this.id_vitals.object.bsamethod[1] = 4 then
			this.id_vitals.object.bsa[1] = 0.0235 * ld_height ^ 0.42246 * ld_weight ^ 0.51456
		elseif this.id_vitals.object.bsamethod[1] = 5 then
			ld_weight_gms = ld_weight * 1000.0
			ld_temp = 0.7285 - 0.0188 * logten(ld_weight_gms)
			this.id_vitals.object.bsa[1] = 0.0003207 * ld_height ^ 0.3 * ld_weight_gms ^ ld_temp
		end if
	case "weight1"
		ld_height1 = this.id_vitals.object.height1[1]
		ld_height2 = this.id_vitals.object.height2[1]
		ld_height = (ld_height1 * 12.0 + ld_height2) * 2.54
		ld_weight1 = ld_data
		ld_weight2 = this.id_vitals.object.weight2[1]
		ld_weight = ld_weight1 + ld_weight2 / 1000.0
		if ld_height > 0.0 then
			this.id_vitals.object.bmi[1] = ld_weight / (ld_height / 100.0) ^ 2.0
		else
			this.id_vitals.object.bmi[1] = ld_weight
		end if
		if this.id_vitals.object.bsamethod[1] = 1 then
			this.id_vitals.object.bsa[1] = 0.007184 * ld_height ^ 0.725 * ld_weight ^ 0.425
		elseif this.id_vitals.object.bsamethod[1] = 2 then
			this.id_vitals.object.bsa[1] = (ld_height * ld_weight / 3600.0) ^ 0.5
		elseif this.id_vitals.object.bsamethod[1] = 3 then
			this.id_vitals.object.bsa[1] = 0.024265 * ld_height ^ 0.3964 * ld_weight ^ 0.5378
		elseif this.id_vitals.object.bsamethod[1] = 4 then
			this.id_vitals.object.bsa[1] = 0.0235 * ld_height ^ 0.42246 * ld_weight ^ 0.51456
		elseif this.id_vitals.object.bsamethod[1] = 5 then
			ld_weight_gms = ld_weight * 1000.0
			ld_temp = 0.7285 - 0.0188 * logten(ld_weight_gms)
			this.id_vitals.object.bsa[1] = 0.0003207 * ld_height ^ 0.3 * ld_weight_gms ^ ld_temp
		end if
	case "weight2"
		ld_height1 = this.id_vitals.object.height1[1]
		ld_height2 = this.id_vitals.object.height2[1]
		ld_height = (ld_height1 * 12.0 + ld_height2) * 2.54
		ld_weight1 = this.id_vitals.object.weight1[1]
		ld_weight2 = ld_data
		ld_weight = ld_weight1 + ld_weight2 / 1000.0
		if ld_height > 0.0 then
			this.id_vitals.object.bmi[1] = ld_weight / (ld_height / 100.0) ^ 2.0
		else
			this.id_vitals.object.bmi[1] = ld_weight
		end if
		if this.id_vitals.object.bsamethod[1] = 1 then
