// w_patientvisit_form.wf_setimage(string as_caller) returns long
	long ll_counter
	long ll_code
	long ll_row
	s_itemimage lstr_image
	if this.il_protect = 1 then
		return 0
	end if
	lstr_image.s_caller = as_caller
	for ll_counter = 1 to this.id_image.rowcount()
		lstr_image.ls_value[ll_counter, 1] = trim(string(this.id_image.object.rowid[ll_counter]))
		lstr_image.ls_value[ll_counter, 2] = this.id_image.object.imagedescription[ll_counter]
		lstr_image.ls_value[ll_counter, 3] = this.id_image.object.imagetype[ll_counter]
		lstr_image.blob[ll_counter] = this.istr_image.blob[ll_counter]
	next
	openwithparm(w_patientimage, lstr_image)
	lstr_image = message.powerobjectparm
	if lstr_image.i_closemode = 1 then
		this.istr_image = lstr_image
		this.id_image.reset()
		ll_code = this.il_patientcode
		for ll_counter = 1 to 200
			if long(lstr_image.ls_value[ll_counter, 1]) > 0 then
				ll_row = this.id_image.insertrow(0)
				this.id_image.object.code[ll_row] = ll_code
				this.id_image.object.admissioncode[ll_row] = this.il_admission
				this.id_image.object.visitcode[ll_row] = this.il_code
				this.id_image.object.rowid[ll_row] = long(lstr_image.ls_value[ll_counter, 1])
				this.id_image.object.imagedescription[ll_row] = lstr_image.ls_value[ll_counter, 2]
				this.id_image.object.imagetype[ll_row] = lstr_image.ls_value[ll_counter, 3]
			end if
		next
	end if
	return 0

// w_patientvisit_form.wf_show_patient_gallery() returns long
	if this.il_code > 0 then
		openwithparm(w_patientgallary, this.il_patientcode)
	end if
	return 0

// w_patientvisit_form.wf_validateserverdatetime(datetime ar_server_datetime, string ar_errtext) returns boolean
	datetime ldt_last_transdate
	datetime ldt_current_serverdate
	long li_max_allow_days
	ar_errtext = "Invoice Date  Check violates"
	li_max_allow_days = f_numberpreferences("MaxAllowDate")
	if isnull(li_max_allow_days) then
		li_max_allow_days = 4
	end if
	SQL SELECT LastTransDate INTO :ldt_last_transdate FROM ServerDate USING sqlca;
	if sqlca.sqlcode = 0 then
		sqlca.getdatetime(ldt_current_serverdate)
		if sqlca.sqlcode = 0 then
			if ldt_current_serverdate >= ldt_last_transdate and daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) <= li_max_allow_days then
				ar_server_datetime = ldt_current_serverdate
				return true
			elseif ldt_current_serverdate < ldt_last_transdate then
				ar_errtext = "Back Date Invoice Check violates"
				return false
			elseif daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) > li_max_allow_days then
				ar_errtext = "Forward Date Invoice Check violates"
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_patientvisit_form.wf_set_bmi(string as_col, string as_data) returns long
	double ld_data
	double ld_height
	double ld_height1
	double ld_height2
	double ld_weight
	double ld_weight1
	double ld_weight2
	double ld_temp
	double ld_weight_gms
	double ll_log
	ld_data = double(as_data)
	if ld_data <= 0.0 or isnull(ld_data) then
		ld_data = 1
	end if
	choose case as_col
	case "height1"
		ld_height1 = ld_data
		ld_height2 = this.id_vitals.object.height2[1]
		ld_height = (ld_height1 * 12.0 + ld_height2) * 2.54
		ld_weight1 = this.id_vitals.object.weight1[1]
		ld_weight2 = this.id_vitals.object.weight2[1]
		ld_weight = ld_weight1 + ld_weight2 / 1000.0
		if ld_height > 0.0 then
			this.id_vitals.object.bmi[1] = ld_weight / (ld_height / 100.0) ^ 2.0
		else
			this.id_vitals.object.bmi[1] = ld_weight
		end if
		if this.id_vitals.object.bsamethod[1] = 1 then
			this.id_vitals.object.bsa[1] = 0.007184 * ld_height ^ 0.725 * ld_weight ^ 0.425
		elseif this.id_vitals.object.bsamethod[1] = 2 then
			this.id_vitals.object.bsa[1] = (ld_height * ld_weight / 3600.0) ^ 0.5
		elseif this.id_vitals.object.bsamethod[1] = 3 then
			this.id_vitals.object.bsa[1] = 0.024265 * ld_height ^ 0.3964 * ld_weight ^ 0.5378
		elseif this.id_vitals.object.bsamethod[1] = 4 then
			this.id_vitals.object.bsa[1] = 0.0235 * ld_height ^ 0.42246 * ld_weight ^ 0.51456
		elseif this.id_vitals.object.bsamethod[1] = 5 then
			ld_weight_gms = ld_weight * 1000.0
			ld_temp = 0.7285 - 0.0188 * logten(ld_weight_gms)
			this.id_vitals.object.bsa[1] = 0.0003207 * ld_height ^ 0.3 * ld_weight_gms ^ ld_temp
		end if
	case "height2"
		ld_height1 = this.id_vitals.object.height1[1]
		ld_height2 = ld_data
		ld_height = (ld_height1 * 12.0 + ld_height2) * 2.54
		ld_weight1 = this.id_vitals.object.weight1[1]
		ld_weight2 = this.id_vitals.object.weight2[1]
