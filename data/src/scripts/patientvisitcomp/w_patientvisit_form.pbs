// w_patientvisit_form.wf_retrieve_appointments(long al_doctcode) returns long
	long ll_rtncode
	long ll_maxestpatientcount
	if al_doctcode > 0 then
		ll_rtncode = this.idc_appointment.retrieve(al_doctcode)
		SQL SELECT ISNULL ( EstPatientCountPerDay , 0 ) INTO :ll_maxestpatientcount FROM DBO.Doctors WHERE DoctCode =:al_doctcode USING sqlca;
		if sqlca.sqlcode = 0 then
			this.id_vd.object.maxestpatientcount[1] = ll_maxestpatientcount
		else
			messagebox("Doctor Validation", "Problem in fetching Doctor Estimated Patient Count. Details are:-~r~n" + sqlca.sqlerrtext, stopsign!)
		end if
	end if
	return ll_rtncode

// w_patientvisit_form.wf_set_appointmentinfo(long al_appointmentcode) returns long
	long ll_found
	long ll_null
	long ll_visitcode
	integer li_protect
	boolean lb_modify
	string ls_null
	setnull(ll_null)
	setnull(ls_null)
	if isnull(al_appointmentcode) then
		this.id_vd.object.regno.protect = 0
		this.id_vd.object.patientcode.protect = 0
		this.id_vd.object.regno[1] = ls_null
		this.id_vd.object.patientcode[1] = ll_null
		this.id_vd.object.patientdetails[1] = ls_null
		this.id_vd.object.referredby[1] = ls_null
		this.id_vd.object.recommendations[1] = ls_null
		this.id_vd.object.previousdiagnosis[1] = ls_null
		this.id_vd.object.remarks[1] = ls_null
		this.id_vd.object.diagnosis[1] = ls_null
		this.id_vd.object.token[1] = ll_null
	else
		ll_found = 0
		ll_found = this.idc_appointment.find("code = " + string(al_appointmentcode) + "", 1, this.idc_appointment.rowcount())
		if ll_found > 0 then
			SQL SELECT MIN ( VisitCode ) INTO :ll_visitcode FROM Visit WHERE AppointmentCode =:al_appointmentcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				this.il_code = ll_visitcode
				if ll_visitcode <= 0 or isnull(ll_visitcode) then
					if this.id_vd.rowcount() > 0 then
						this.id_vd.object.appointmentcode[1] = al_appointmentcode
						this.id_vd.object.regno.protect = 1
						this.id_vd.object.patientcode.protect = 1
						this.id_vd.object.regno[1] = this.idc_appointment.getitemstring(ll_found, "regno")
						this.id_vd.object.patientcode[1] = this.idc_appointment.getitemnumber(ll_found, "patientcode")
						this.id_vd.object.patientdetails[1] = this.idc_appointment.getitemstring(ll_found, "patientname")
						this.id_vd.object.remarks[1] = this.idc_appointment.getitemstring(ll_found, "remarks")
						this.id_vd.object.referredby[1] = this.idc_appointment.getitemstring(ll_found, "referredby")
						this.id_vd.object.token[1] = this.idc_appointment.getitemnumber(ll_found, "tokenno")
					end if
				else
					this.id_vd.retrieve(ll_visitcode)
					wf_get_patient_info(this.il_code)
					wf_retrieve_tabs()
					if this.id_vd.getitemstring(this.id_vd.getrow(), "Posted") = "N" then
						lb_modify = true
					end if
					if lb_modify then
						li_protect = 0
					end if
					if this.id_vd.object.patientcode[1] > 0 then
						this.id_image.retrieve(this.id_vd.object.patientcode[1])
						wf_populate_image()
					end if
					wf_protectdw(this.id_vd, li_protect)
				end if
			end if
		end if
	end if
	return 0

// w_patientvisit_form.wf_find_patient_regno(long al_patientcode, string as_regno) returns long
	long ll_retflag
	char lc_active
	ll_retflag = 0
	SQL SELECT patient.regno , patient.active INTO :as_regno, :lc_active FROM patient WHERE patient.patientcode =:al_patientcode and patientcatcode in ( select distinct patientcatcode from patientcatallowedmodule where moduleid =:this.ii_module ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(as_regno) then
			ll_retflag = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
		else
			ll_retflag = -2
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_patientvisit_form.wf_findpatientcode(string as_regno, long al_patientcode) returns long
	long ll_patientcode
	long ll_retflag
	string ls_itemname
	char lc_active
	ll_retflag = 0
	SQL SELECT patient.patientcode , patient.active INTO :ll_patientcode, :lc_active FROM patient WHERE patient.regno =:as_regno and patientcatcode in ( select distinct patientcatcode from patientcatallowedmodule where moduleid =:this.ii_module ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_patientcode = ll_patientcode
		if isnull(al_patientcode) then
			ll_retflag = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
		else
			ll_retflag = -2
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_patientvisit_form.wf_patientsearch() returns string
	string ls_regno
	long ll_res
	long ll_null
	s_arguements ls_arguements
	setnull(ll_null)
	open(w_patientsearch)
	ls_arguements = message.powerobjectparm
	if ls_arguements.i_status = 1 then
		openwithparm(w_patientsearchresult, ls_arguements)
		ls_arguements = message.powerobjectparm
		if this.il_protect = 1 then
			return ""
		end if
		if ls_arguements.i_status = 1 and ls_arguements.l_code1 > 0 then
			ll_res = wf_find_patient_regno(ls_arguements.l_code1, ls_regno)
			wf_validate_patient(ls_regno)
			this.id_vd.object.appointmentcode[this.id_vd.rowcount()] = ll_null
			this.id_vd.object.patientcode[this.id_vd.rowcount()] = ls_arguements.l_code1
			this.id_vd.object.regno[this.id_vd.rowcount()] = ls_regno
			this.id_vd.object.patientdetails[1] = ""
			this.id_vd.object.referredby[1] = ""
			this.id_vd.object.previousdiagnosis[1] = ""
			this.id_vd.object.diagnosis[1] = ""
			this.id_vd.object.recommendations[1] = ""
			this.id_vd.object.remarks[1] = ""
			this.id_vd.object.precautions[1] = ""
			this.id_vd.object.token[1] = ll_null
		end if
	end if
	return ls_regno

// w_patientvisit_form.wf_registerpatient() returns string
	string ls_regno
	long ll_res
	long ll_patientcode
	s_datatype lstr_datatype
	lstr_datatype.al_long = this.id_vd.object.patientcode[this.id_vd.rowcount()]
	openwithparm(w_patientregistration, lstr_datatype)
	ls_regno = message.stringparm
	this.id_vd.object.regno[this.id_vd.rowcount()] = ls_regno
	setpointer(hourglass!)
	this.idc_patient.setredraw(false)
	this.idc_patient.settransobject(this.it_transobject)
	wf_patient_retrieve()
	wf_validate_patient(ls_regno)
	this.idc_patient.setredraw(true)
	setpointer(arrow!)
	if ls_regno <> "" and not isnull(ls_regno) then
		ll_res = wf_findpatientcode(ls_regno, ll_patientcode)
		if ll_res > 0 then
			this.id_vd.object.patientcode[this.id_vd.rowcount()] = ll_patientcode
		end if
	end if
	return ls_regno

// w_patientvisit_form.wf_visithistory() returns long
	long ll_res
	long ll_null
	long ll_patientcode
	long ll_counter
	long ll_insrow
	s_arguements ls_arguements
	u_ds_standard lds_visit
	u_ds_standard lds_rx
	setnull(ll_null)
	if this.id_vd.rowcount() > 0 then
		ll_patientcode = this.id_vd.object.patientcode[this.id_vd.rowcount()]
		if ll_patientcode > 0 then
			ls_arguements.l_code1 = ll_patientcode
			openwithparm(w_visithistory, ls_arguements)
			ls_arguements = message.powerobjectparm
			if ls_arguements.i_status = 1 then
				if this.il_protect = 1 then
					return 0
				end if
				if ls_arguements.l_code1 > 0 then
					lds_visit = create u_ds_standard
					lds_visit.dataobject = "d_visit_detail"
					lds_visit.settransobject(sqlca)
					lds_rx = create u_ds_standard
					lds_rx.dataobject = "d_visit_prescription"
					lds_rx.settransobject(sqlca)
					lds_visit.retrieve(ls_arguements.l_code1)
					if lds_visit.rowcount() > 0 then
						this.id_vd.object.patientdetails[this.id_vd.rowcount()] = lds_visit.object.patientdetails[lds_visit.rowcount()]
						this.id_vd.object.referredby[this.id_vd.rowcount()] = lds_visit.object.referredby[lds_visit.rowcount()]
						this.id_vd.object.previousdiagnosis[this.id_vd.rowcount()] = lds_visit.object.previousdiagnosis[lds_visit.rowcount()]
						this.id_vd.object.diagnosis[this.id_vd.rowcount()] = lds_visit.object.diagnosis[lds_visit.rowcount()]
						this.id_vd.object.recommendations[this.id_vd.rowcount()] = lds_visit.object.recommendations[lds_visit.rowcount()]
						this.id_vd.object.remarks[this.id_vd.rowcount()] = lds_visit.object.remarks[lds_visit.rowcount()]
						lds_rx.retrieve(ls_arguements.l_code1)
						if lds_rx.rowcount() > 0 then
							if this.id_rx.rowcount() > 0 and (isnull(this.id_rx.object.icode[this.id_rx.rowcount()]) or this.id_rx.object.icode[this.id_rx.rowcount()] = 0) then
								this.id_rx.setrow(this.id_rx.rowcount())
								this.id_rx.deleterow(0)
							end if
							for ll_counter = 1 to lds_rx.rowcount()
								ll_insrow = this.id_rx.insertrow(0)
								this.id_rx.object.icode[ll_insrow] = lds_rx.object.icode[ll_counter]
								this.id_rx.object.itemname[ll_insrow] = lds_rx.object.itemname[ll_counter]
								this.id_rx.object.date[ll_insrow] = lds_rx.object.date[ll_counter]
								this.id_rx.object.duration[ll_insrow] = lds_rx.object.duration[ll_counter]
								this.id_rx.object.diseasecode[ll_insrow] = lds_rx.object.diseasecode[ll_counter]
								this.id_rx.object.dosagecode[ll_insrow] = lds_rx.object.dosagecode[ll_counter]
								this.id_rx.object.dosagefactor[ll_insrow] = lds_rx.object.dosagefactor[ll_counter]
								this.id_rx.object.routecode[ll_insrow] = lds_rx.object.routecode[ll_counter]
								this.id_rx.object.inscode[ll_insrow] = lds_rx.object.inscode[ll_counter]
								this.id_rx.object.details[ll_insrow] = lds_rx.object.details[ll_counter]
								this.id_rx.object.qty[ll_insrow] = lds_rx.object.qty[ll_counter]
								this.id_rx.object.manualchangeintotqty[ll_insrow] = lds_rx.object.manualchangeintotqty[ll_counter]
								this.id_rx.object.dosageunitcode[ll_insrow] = lds_rx.object.dosageunitcode[ll_counter]
								this.id_rx.object.dosagestrength[ll_insrow] = lds_rx.object.dosagestrength[ll_counter]
								this.id_rx.object.totalqty[ll_insrow] = lds_rx.object.totalqty[ll_counter]
							next
						end if
					end if
				end if
			end if
		else
			messagebox("Patient Visit History", "Please select a patient first to view history")
		end if
	else
		messagebox("Patient Visit History...", "Please select a patient first to view history")
	end if
	return 0

// w_patientvisit_form.wf_presave() returns long
	long ll_counter
	long ll_rows
	long ll_row
	this.id_vd.object.code[1] = this.il_code
	this.id_vitals.object.code[1] = this.il_code
	this.ids_symptoms_hidden.dataobject = this.id_symptoms.dataobject
	this.ids_symptoms_hidden.settransobject(this.it_transobject)
	ll_counter = 0
	for ll_counter = 1 to this.id_symptoms.rowcount()
		if this.id_symptoms.object.selected[ll_counter] = "Y" then
			ll_row = this.ids_symptoms_hidden.insertrow(0)
			if ll_row > 0 then
				this.ids_symptoms_hidden.object.code[ll_row] = this.il_code
				this.ids_symptoms_hidden.object.symptomcode[ll_row] = this.id_symptoms.object.symptomcode[ll_counter]
				this.ids_symptoms_hidden.object.severitylevelcode[ll_row] = this.id_symptoms.object.severitylevelcode[ll_counter]
				this.ids_symptoms_hidden.object.duration[ll_row] = this.id_symptoms.object.duration[ll_counter]
				this.ids_symptoms_hidden.object.details[ll_row] = this.id_symptoms.object.details[ll_counter]
			end if
		end if
	next
	this.ids_pexam_hidden.dataobject = this.id_pexam.dataobject
	this.ids_pexam_hidden.settransobject(this.it_transobject)
	ll_counter = 0
	for ll_counter = 1 to this.id_pexam.rowcount()
		if this.id_pexam.object.selected[ll_counter] = "Y" then
			ll_row = this.ids_pexam_hidden.insertrow(0)
			if ll_row > 0 then
				this.ids_pexam_hidden.object.code[ll_row] = this.il_code
				this.ids_pexam_hidden.object.physicalexamcode[ll_row] = this.id_pexam.object.physicalexamcode[ll_counter]
				this.ids_pexam_hidden.object.details[ll_row] = this.id_pexam.object.details[ll_counter]
			end if
		end if
	next
	this.ids_precautions_hidden.dataobject = this.id_precautions.dataobject
	this.ids_precautions_hidden.settransobject(this.it_transobject)
	ll_counter = 0
	for ll_counter = 1 to this.id_precautions.rowcount()
		if this.id_precautions.object.selected[ll_counter] = "Y" then
			ll_row = this.ids_precautions_hidden.insertrow(0)
			if ll_row > 0 then
				this.ids_precautions_hidden.object.code[ll_row] = this.il_code
				this.ids_precautions_hidden.object.precautioncode[ll_row] = this.id_precautions.object.precautioncode[ll_counter]
			end if
		end if
	next
	this.ids_diagnostics_hidden.dataobject = this.id_diagnostics.dataobject
	this.ids_diagnostics_hidden.settransobject(this.it_transobject)
	ll_counter = 0
	for ll_counter = 1 to this.id_diagnostics.rowcount()
		if this.id_diagnostics.object.selected[ll_counter] = "Y" then
			ll_row = this.ids_diagnostics_hidden.insertrow(0)
			if ll_row > 0 then
				this.ids_diagnostics_hidden.object.code[ll_row] = this.il_code
				this.ids_diagnostics_hidden.object.diagnosticitemcode[ll_row] = this.id_diagnostics.object.diagnosticitemcode[ll_counter]
				this.ids_diagnostics_hidden.object.diagnosticvalue[ll_row] = this.id_diagnostics.object.diagnosticvalue[ll_counter]
				this.ids_diagnostics_hidden.object.details[ll_row] = this.id_diagnostics.object.details[ll_counter]
			end if
		end if
	next
	ll_counter = 0
	for ll_counter = 1 to this.id_rx.rowcount()
		this.id_rx.object.code[ll_counter] = this.il_code
	next
	if this.id_obs.rowcount() > 0 then
		this.id_obs.object.code[1] = this.il_code
		this.id_obs.object.patientcode[1] = this.il_patientcode
		this.id_obs.object.admissioncode[1] = this.il_admission
	end if
	if this.id_gyn.rowcount() > 0 then
		this.id_gyn.object.code[1] = this.il_code
		this.id_gyn.object.patientcode[1] = this.il_patientcode
		this.id_gyn.object.admissioncode[1] = this.il_admission
	end if
	if this.id_abd.rowcount() > 0 then
		this.id_abd.object.code[1] = this.il_code
		this.id_abd.object.patientcode[1] = this.il_patientcode
		this.id_abd.object.admissioncode[1] = this.il_admission
	end if
	SQL DELETE VisitSymptoms WHERE VisitCode =:this.il_code USING this.it_transobject;
	SQL DELETE VisitPhysicalExam WHERE VisitCode =:this.il_code USING this.it_transobject;
	SQL DELETE VisitPrecaution WHERE VisitCode =:this.il_code USING this.it_transobject;
	SQL DELETE VisitDiagnostics WHERE VisitCode =:this.il_code USING this.it_transobject;
	return 0

// w_patientvisit_form.wf_dosageinfo(long al_dosagecode, long al_row) returns long
	long ll_factor
	if al_dosagecode > 0 then
		SQL SELECT dosefactor INTO :ll_factor FROM Dosage WHERE DosageCode =:al_dosagecode USING sqlca;
	end if
	if sqlca.sqlcode = 0 and ll_factor > 0 then
		this.id_rx.object.dosagefactor[al_row] = ll_factor
	end if
	return 0

// w_patientvisit_form.wf_update_totalqty(long al_row) returns long
	double ld_qty
	double ld_totqty
	double ld_bsa
	long ll_dosageunitcode
	long ll_dosagecode
	long ll_dosagefactor
	long ll_duration
	if al_row > 0 and this.id_rx.object.manualchangeintotqty[al_row] = 0 then
		ld_qty = this.id_rx.object.qty[al_row]
		if isnull(ld_qty) then
			ld_qty = 0
		end if
		ld_bsa = this.id_rx.object.bsa[al_row]
		if isnull(ld_bsa) or ld_bsa <= 0.0 then
			ld_bsa = 1
		end if
		ll_dosagecode = this.id_rx.object.dosagecode[al_row]
		ll_dosagefactor = this.id_rx.object.dosagefactor[al_row]
		if isnull(ll_dosagefactor) then
			ll_dosagefactor = 1
		end if
		ll_duration = this.id_rx.object.duration[al_row]
		if isnull(ll_duration) then
			ll_duration = 0
		end if
		ld_totqty = ld_qty * ld_bsa * ll_dosagefactor * ll_duration
		this.id_rx.object.totalqty[al_row] = round(ld_totqty, 4)
	end if
	return 0

// w_patientvisit_form.wf_print() returns integer
	long i_rtcode
	long ll_retrieve
	s_datastore lstr
	if this.ib_print = true then
		wf_select_printout()
		this.dw_print.settransobject(sqlca)
		this.dw_print.retrieve(this.il_code)
		lstr.d_value = this.il_code
		lstr.dw = this.dw_print
		lstr.s_name1 = this.dw_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return 0
		else
			if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
				messagebox("Printer", "Printing Error")
				this.dw_print.printcancel()
			end if
			if this.dw_print.rowcount() > 0 then
				if this.dw_print.print() < 0 then
					messagebox("Printing", "Can not Print Invoice", information!)
				end if
			else
				messagebox("Printing Error", "Can not Print Data,~r~nNo rows are retrieved", information!)
			end if
		end if
	end if
	return 0

// w_patientvisit_form.wf_select_printout() returns long
	string ls_report
	if gs_company = "DRQUDRATULLAH" then
		ls_report = "d_visitprescription_print_drqudratullah"
	elseif gs_company = "HABIBPH2" then
		ls_report = "d_visitprescription_print_habibph2"
	elseif gs_company = "FAMILYCAREHSP" then
		ls_report = "d_familycarehsp_visitprescription_print"
	elseif gs_company = "DRMAHVISH" then
		ls_report = "d_visitprescription_drmahvish"
	elseif gs_company = "PHARMACYHABAD" then
		ls_report = "d_visitprescription_print_pharmacyhabad"
	elseif gs_company = "ALSHAFAY" then
		ls_report = "d_visitprescription_print_alshafay"
	elseif gs_company = "DRWAJIDALI" then
		ls_report = "d_visitprescription_print_drwajidali"
	elseif gs_company = "TEM" or gs_company = "ABUZAR" then
		ls_report = "d_visitprescription_print_alshafay"
	elseif gs_company = "BAJWAHOSPITAL2" then
		ls_report = "d_bajwahospital2_visitprescription_print"
	elseif gs_company = "DRIRFANSB" then
		ls_report = "d_visitprescription_print_drirfansb"
	elseif gs_company = "DRSHUMAIL" then
		ls_report = "d_visitprescription_print_drshumail"
	elseif gs_company = "REALDOCTORPVT" then
		ls_report = "d_visitprescription_print_realdoctorpvt"
	elseif gs_company = "RASHIDNURSING" then
		ls_report = "d_visitprescription_print_rashidnursing"
	elseif gs_company = "DRRABNAWAZ" then
		ls_report = "d_visitprescription_print_drrabnawazraja"
	elseif gs_company = "KHALISMEDICAL" then
		ls_report = "d_visitprescription_print_khalismedical"
	else
		ls_report = "d_visitprescription_print_comp"
	end if
	this.dw_print.dataobject = ls_report
	return 0

// w_patientvisit_form.wf_validate_rx() returns long
	long ll_currrow
	long ll_counter
	long ll_null
	ll_currrow = this.id_rx.getrow()
	setnull(ll_null)
	if this.id_rx.rowcount() > 0 then
		if isnull(this.id_rx.getitemnumber(ll_currrow, "icode")) then
			if isnull(this.id_rx.getitemstring(ll_currrow, "itemname")) then
				this.id_rx.deleterow(ll_currrow)
			elseif this.ib_itemvalidated = false then
				messagebox("Item Validation", "Please Select Some Valid Item")
				this.id_rx.setcolumn("itemname")
				this.id_rx.scrolltorow(ll_currrow)
				this.id_rx.setfocus()
				return 1
			end if
		elseif this.ib_itemvalidated = false then
			messagebox("Item Validation", "Please Select Some Valid Item")
			this.id_rx.setcolumn("itemname")
			this.id_rx.scrolltorow(ll_currrow)
			this.id_rx.setfocus()
			return 1
		end if
		if f_validatedw(this.id_rx) < 0 then
			return 1
		end if
		this.il_currrow = this.id_rx.rowcount()
		if this.ib_itemvalidated = false and wf_validateitem(ll_currrow) = -1 then
			return 1
		end if
		return
	end if
	for ll_counter = 1 to this.id_rx.rowcount()
		this.id_rx.object.code[ll_counter] = this.il_code
	next
	return 0

// w_patientvisit_form.wf_populate_diseasetreatment_template() returns long
	s_arguements lstr_arg
	long ll_diseasetypecode
	long ll_diseasecode
	long ll_templatecode
	long ll_row
	long ll_counter
	datastore lds_items
	open(w_arg_diseasetype)
	lstr_arg = message.powerobjectparm
	if lstr_arg.l_code1 > 0 then
		ll_diseasetypecode = lstr_arg.l_code1
		openwithparm(w_arg_disease_diseasetype, lstr_arg.l_code1)
		lstr_arg = message.powerobjectparm
		if lstr_arg.l_code1 > 0 then
			ll_diseasecode = lstr_arg.l_code1
			openwithparm(w_arg_diseasetreatmenttemplate_disease, lstr_arg.l_code1)
			lstr_arg = message.powerobjectparm
			if lstr_arg.l_code1 > 0 then
				ll_templatecode = lstr_arg.l_code1
				lds_items = create datastore
				lds_items.dataobject = "d_diseasetreatmenttemplate_detail"
				lds_items.settransobject(sqlca)
				lds_items.retrieve(ll_templatecode)
				if lds_items.rowcount() > 0 then
					if this.id_rx.rowcount() > 0 then
						if this.id_rx.object.icode[this.id_rx.rowcount()] <= 0 then
							this.id_rx.deleterow(0)
						end if
					end if
					for ll_counter = 1 to lds_items.rowcount()
						ll_row = this.id_rx.insertrow(0)
						if ll_row > 0 then
							if this.id_vitals.rowcount() > 0 then
								this.id_rx.object.bsa[ll_row] = this.id_vitals.object.bsa[1]
							end if
							this.id_rx.object.icode[ll_row] = lds_items.object.icode[ll_counter]
							this.id_rx.object.itemname[ll_row] = lds_items.object.itemname[ll_counter]
							this.id_rx.object.duration[ll_row] = lds_items.object.duration[ll_counter]
							this.id_rx.object.diseasecode[ll_row] = ll_diseasecode
							this.id_rx.object.dosagecode[ll_row] = lds_items.object.dosagecode[ll_counter]
							this.id_rx.object.dosagefactor[ll_row] = lds_items.object.dosagefactor[ll_counter]
							this.id_rx.object.routecode[ll_row] = lds_items.object.routecode[ll_counter]
							this.id_rx.object.inscode[ll_row] = lds_items.object.inscode[ll_counter]
							this.id_rx.object.details[ll_row] = lds_items.object.details[ll_counter]
							this.id_rx.object.qty[ll_row] = lds_items.object.qty[ll_counter]
							this.id_rx.object.dosageunitcode[ll_row] = lds_items.object.dosageunitcode[ll_counter]
							this.id_rx.object.dosagestrength[ll_row] = lds_items.object.dosagestrength[ll_counter]
							this.id_rx.object.totalqty[ll_row] = lds_items.object.totalqty[ll_counter]
							wf_update_totalqty(ll_row)
						end if
					next
				end if
			end if
		end if
	end if
	return 0

// w_patientvisit_form.wf_show_rx_history() returns long
	long ll_res
	long ll_null
	long ll_patientcode
	long ll_counter
	long ll_insrow
	s_arguements ls_arguements
	setnull(ll_null)
	if this.id_vd.rowcount() > 0 then
		ll_patientcode = this.id_vd.object.patientcode[this.id_vd.rowcount()]
		if ll_patientcode > 0 then
			ls_arguements.l_code1 = ll_patientcode
			openwithparm(w_visit_prescription_history, ls_arguements)
			ls_arguements = message.powerobjectparm
			if this.il_protect = 1 then
				return 0
			end if
		else
			messagebox("Patient Visit Prescription History", "Please select a patient first to view Visit Prescription History")
		end if
	else
		messagebox("Patient Visit Prescription History...", "Please select a patient first to view Visit Prescription History")
	end if
	return 0

// w_patientvisit_form.wf_show_rx_value() returns long
	long ll_count
	long ll_invcode
	long ll_masterrow
	long ll_insrow
	long ll_icode
	double ld_rate
	string ls_viewoption
	datastore lds_rx_value
	boolean lb_listtab
	boolean lb_editable
	s_datastore lstr
	lds_rx_value = create datastore
	lds_rx_value.dataobject = "d_visit_prescription_value"
	lds_rx_value.settransobject(sqlca)
	this.id_rx.accepttext()
	for ll_count = 1 to this.id_rx.rowcount()
		ll_insrow = lds_rx_value.insertrow(0)
		if ll_insrow > 0 then
			ll_icode = this.id_rx.object.icode[ll_count]
			lds_rx_value.object.code[ll_insrow] = this.id_rx.object.code[ll_count]
			lds_rx_value.object.icode[ll_insrow] = this.id_rx.object.icode[ll_count]
			lds_rx_value.object.itemname[ll_insrow] = this.id_rx.object.itemname[ll_count]
			lds_rx_value.object.date[ll_insrow] = this.id_rx.object.date[ll_count]
			lds_rx_value.object.duration[ll_insrow] = this.id_rx.object.duration[ll_count]
			lds_rx_value.object.diseasecode[ll_insrow] = this.id_rx.object.diseasecode[ll_count]
			lds_rx_value.object.dosagecode[ll_insrow] = this.id_rx.object.dosagecode[ll_count]
			lds_rx_value.object.dosagefactor[ll_insrow] = this.id_rx.object.dosagefactor[ll_count]
			lds_rx_value.object.routecode[ll_insrow] = this.id_rx.object.routecode[ll_count]
			lds_rx_value.object.inscode[ll_insrow] = this.id_rx.object.inscode[ll_count]
			lds_rx_value.object.rowid[ll_insrow] = this.id_rx.object.rowid[ll_count]
			lds_rx_value.object.details[ll_insrow] = this.id_rx.object.details[ll_count]
			lds_rx_value.object.qty[ll_insrow] = this.id_rx.object.qty[ll_count]
			lds_rx_value.object.bsa[ll_insrow] = this.id_rx.object.bsa[ll_count]
			lds_rx_value.object.manualchangeintotqty[ll_insrow] = this.id_rx.object.manualchangeintotqty[ll_count]
			lds_rx_value.object.dosageunitcode[ll_insrow] = this.id_rx.object.dosageunitcode[ll_count]
			lds_rx_value.object.dosagestrength[ll_insrow] = this.id_rx.object.dosagestrength[ll_count]
			lds_rx_value.object.totalqty[ll_insrow] = this.id_rx.object.totalqty[ll_count]
			SQL SELECT Rate =Round ( SalePrice / CASE WHEN PackUnits > 0 THEN PackUnits ELSE 1 END , 2 ) INTO :ld_rate FROM Item WHERE ICode =:ll_icode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				lds_rx_value.object.rate[ll_insrow] = ld_rate
			end if
		end if
	next
	lstr.ds = lds_rx_value
	lstr.s_name1 = "d_visit_prescription_value"
	openwithparm(w_preview_invoices, lstr)
	lstr = message.powerobjectparm
	destroy lds_rx_value
	return 0

// w_patientvisit_form.wf_populate_diseasetemplate() returns long
	s_arguements lstr_arg
	long ll_diseasetypecode
	long ll_diseasecode
	long ll_templatecode
	long ll_row
	long ll_counter
	datastore lds_items
	open(w_arg_diseasetreatmenttemplate)
	lstr_arg = message.powerobjectparm
	if lstr_arg.l_code1 > 0 then
		ll_templatecode = lstr_arg.l_code1
		SQL SELECT DISEASECODE INTO :ll_diseasecode FROM DiseaseTreatmentTemp WHERE DiseaseTreatmentTempCode =:ll_templatecode USING sqlca;
		if sqlca.sqlcode = 0 then
			if isnull(ll_diseasecode) or ll_diseasecode <= 0 then
				ll_diseasecode = 1
			end if
		else
			ll_diseasecode = 1
		end if
		lds_items = create datastore
		lds_items.dataobject = "d_diseasetreatmenttemplate_detail"
		lds_items.settransobject(sqlca)
		lds_items.retrieve(ll_templatecode)
		if lds_items.rowcount() > 0 then
			if this.id_rx.rowcount() > 0 then
				if this.id_rx.object.icode[this.id_rx.rowcount()] <= 0 then
					this.id_rx.deleterow(0)
				end if
			end if
			for ll_counter = 1 to lds_items.rowcount()
				ll_row = this.id_rx.insertrow(0)
				if ll_row > 0 then
					if this.id_vitals.rowcount() > 0 then
						this.id_rx.object.bsa[ll_row] = this.id_vitals.object.bsa[1]
					end if
					this.id_rx.object.icode[ll_row] = lds_items.object.icode[ll_counter]
					this.id_rx.object.itemname[ll_row] = lds_items.object.itemname[ll_counter]
					this.id_rx.object.duration[ll_row] = lds_items.object.duration[ll_counter]
					this.id_rx.object.diseasecode[ll_row] = ll_diseasecode
					this.id_rx.object.dosagecode[ll_row] = lds_items.object.dosagecode[ll_counter]
					this.id_rx.object.dosagefactor[ll_row] = lds_items.object.dosagefactor[ll_counter]
					this.id_rx.object.routecode[ll_row] = lds_items.object.routecode[ll_counter]
					this.id_rx.object.inscode[ll_row] = lds_items.object.inscode[ll_counter]
					this.id_rx.object.details[ll_row] = lds_items.object.details[ll_counter]
					this.id_rx.object.qty[ll_row] = lds_items.object.qty[ll_counter]
					this.id_rx.object.dosageunitcode[ll_row] = lds_items.object.dosageunitcode[ll_counter]
					this.id_rx.object.dosagestrength[ll_row] = lds_items.object.dosagestrength[ll_counter]
					this.id_rx.object.totalqty[ll_row] = lds_items.object.totalqty[ll_counter]
					wf_update_totalqty(ll_row)
				end if
			next
		end if
	end if
	return 0

// w_patientvisit_form.wf_getnestedreport(datawindowchild adc_nested, datawindow adw_parentdatawindow, string as_nesteddatawindow) returns long
	integer li_rtncode
	li_rtncode = adw_parentdatawindow.getchild(as_nesteddatawindow, adc_nested)
	if li_rtncode <> -1 then
		adc_nested.settransobject(sqlca)
	end if
	return li_rtncode

// w_patientvisit_form.wf_print(string dataobject) returns integer
	string ls_report
	s_datastore lstr
	ls_report = dataobject
	this.dw_print2.dataobject = ls_report
	this.dw_print2.settransobject(sqlca)
	this.dw_print2.retrieve(this.il_code)
	lstr.dw = this.dw_print2
	lstr.s_name1 = this.dw_print2.dataobject
	openwithparm(w_preview_invoices, lstr)
	lstr = message.powerobjectparm
	if lstr.i_closemode = -1 then
		return 0
	else
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.dw_print2.printcancel()
		end if
		if this.dw_print2.rowcount() > 0 then
			if this.dw_print2.print() < 0 then
				messagebox("Printing", "Can not Print Invoice", information!)
			end if
		else
			messagebox("Printing Error", "Can not Print Data,~r~nNo rows are retrieved", information!)
		end if
	end if
	return 0

