// w_patientvisit_form.wf_validateitem(long al_row) returns integer
	long ll_icode
	long ll_null
	integer li_errcode
	setnull(ll_null)
	if this.id_rx.rowcount() > 0 then
		ll_icode = this.id_rx.getitemnumber(al_row, "icode")
	end if
	if isnull(ll_icode) then
		this.ib_rowvalidated = false
		this.ib_itemvalidated = false
		messagebox("Validation Error!", "Please Enter Valid Item")
		li_errcode = -1
	else
		if ll_icode > 0 then
			wf_help_prescription_population(ll_icode)
		end if
		li_errcode = 0
		this.ib_rowvalidated = true
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		this.id_rx.setcolumn("icode")
		this.id_rx.scrolltorow(al_row)
		this.id_rx.object.icode[al_row] = ll_null
	end if
	return li_errcode

// w_patientvisit_form.wf_inititeminfo(long al_icode, long al_row) returns long
	long ll_retcode
	double ld_saleprice
	SQL SELECT saleprice =Round ( saleprice / CASE PackUnits WHEN 0 THEN 1 ELSE PackUnits END , 2 ) INTO :ld_saleprice FROM item WHERE ICode =:al_icode USING this.it_transobject;
	if sqlca.sqlcode = 0 then
		ll_retcode = 0
	else
		ll_retcode = -1
	end if
	return ll_retcode

// w_patientvisit_form.wf_get_dosefactor(long al_dosagecode) returns long
	long ll_dosefactor
	SQL Select dosefactor INTO :ll_dosefactor From Dosage Where dosagecode =:al_dosagecode USING this.it_transobject;
	if sqlca.sqlcode = 0 then
		return ll_dosefactor
	end if
	return -1

