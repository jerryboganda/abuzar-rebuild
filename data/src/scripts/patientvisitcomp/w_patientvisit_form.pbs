// w_patientvisit_form.wf_connect() returns long
	SQL start USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_patientvisit_form.wf_tabnewid(string as_tablename, long al_newid) returns long
	long ll_rtcode
	SQL SELECT TABMAXKEY INTO :al_newid FROM _TABMAXKEY WITH ( UPDLOCK HOLDLOCK ) WHERE _TABMAXKEY.TABName =:as_tablename USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_newid = al_newid + 1
		SQL update dbo._tabmaxkey SET TABMAXKEY =:al_newid WHERE _TABMAXKEY.TABName =:as_tablename USING this.it_transobject;
		if this.it_transobject.sqlcode < 0 then
			ll_rtcode = this.it_transobject.sqlcode
			al_newid = 0
		end if
	else
		ll_rtcode = this.it_transobject.sqlcode
		al_newid = 0
	end if
	return ll_rtcode

// w_patientvisit_form.wf_get_patient_info(long al_code) returns long
	long ll_patientcode
	long ll_admissioncode
	string ls_regno
	string ls_patientname
	string ls_fname
	string ls_age
	string ls_gender
	SQL SELECT PatientCode , RegNo , Name , FName , Age =LTRIM ( RTRIM ( STR ( AgeYears ) ) ) + ' yrs ' + LTRIM ( RTRIM ( STR ( AgeMonths ) ) ) + ' month ' + LTRIM ( RTRIM ( STR ( AgeDays ) ) ) + ' days' , Gender , AdmissionCode =NULL INTO :ll_patientcode, :ls_regno, :ls_patientname, :ls_fname, :ls_age, :ls_gender, :ll_admissioncode FROM Patient WHERE PatientCode IN ( SELECT V.PatientCode FROM Visit V WHERE V.VisitCode =:al_code ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.il_code = al_code
		this.il_patientcode = ll_patientcode
		this.is_regno = ls_regno
		this.il_admission = ll_admissioncode
		this.is_patientname = ls_patientname
		this.is_fhname = ls_fname
		this.is_age = ls_age
		this.is_gender = ls_gender
		return 0
	end if
	return -1

// w_patientvisit_form.wf_retrieve_tabs() returns long
	long ll_rtncode
	this.id_vd = this.tab_main.tabpage_vd.dw_vd
	this.id_vd.settransobject(this.it_transobject)
	ll_rtncode = this.id_vd.getchild("doctcode", this.idc_doctor)
	this.idc_doctor.settransobject(this.it_transobject)
	ll_rtncode = this.idc_doctor.retrieve(gl_usercode)
	if this.il_code > 0 then
		this.id_vd.retrieve(this.il_code)
	elseif this.id_vd.rowcount() = 0 then
		this.id_vd.insertrow(0)
	end if
	this.id_vitals = this.tab_main.tabpage_vitals.dw_vitals
	this.id_vitals.settransobject(this.it_transobject)
	if this.il_code > 0 then
		this.id_vitals.retrieve(this.il_code)
	end if
	this.id_symptoms = this.tab_main.tabpage_symptoms.dw_symptoms
	this.id_symptoms.settransobject(this.it_transobject)
	this.id_symptoms.retrieve(this.il_code)
	this.id_pexam = this.tab_main.tabpage_pexam.dw_pexam
	this.id_pexam.settransobject(this.it_transobject)
	this.id_pexam.retrieve(this.il_code)
	this.id_precautions = this.tab_main.tabpage_precautions.dw_precautions
	this.id_precautions.settransobject(this.it_transobject)
	this.id_precautions.retrieve(this.il_code)
	this.id_diagnostics = this.tab_main.tabpage_diagnostics.dw_diagnostics
	this.id_diagnostics.settransobject(this.it_transobject)
	this.id_diagnostics.retrieve(this.il_code)
	this.id_precautions = this.tab_main.tabpage_precautions.dw_precautions
	this.id_precautions.settransobject(this.it_transobject)
	this.id_precautions.retrieve(this.il_code)
	this.id_diagnostics = this.tab_main.tabpage_diagnostics.dw_diagnostics
	this.id_diagnostics.settransobject(this.it_transobject)
	this.id_diagnostics.retrieve(this.il_code)
	this.id_rx = this.tab_main.tabpage_rx.dw_rx
	this.id_rx.settransobject(this.it_transobject)
	this.id_selectionlist = this.tab_main.tabpage_rx.dw_selectionlist
	this.id_selectionlist.settransobject(this.it_transobject)
	gd_popup_itemsinfo.sharedata(this.id_selectionlist)
	wf_itemlist_initialization()
	if this.il_code > 0 then
		this.id_rx.retrieve(this.il_code)
	end if
	this.id_obs = this.tab_main.tabpage_obs_us.dw_obs_us
	this.id_obs.settransobject(this.it_transobject)
	if this.il_code > 0 then
		this.id_obs.retrieve(this.il_code)
	end if
	this.id_gyn = this.tab_main.tabpage_gyn_us.dw_gyn_us
	this.id_gyn.settransobject(this.it_transobject)
	if this.il_code > 0 then
		this.id_gyn.retrieve(this.il_code)
	end if
	this.id_abd = this.tab_main.tabpage_abd_us.dw_abd_us
	this.id_abd.settransobject(this.it_transobject)
	if this.il_code > 0 then
		this.id_abd.retrieve(this.il_code)
	end if
	this.id_image = this.dw_image
	this.id_image.settransobject(this.it_transobject)
	if this.il_code > 0 then
		this.id_image.retrieve(this.il_patientcode)
		wf_populate_image()
	end if
	return 0

// w_patientvisit_form.wf_insert_row(datawindow adw_dw, integer ai_askpermit) returns long
	long ll_row
	long ll_res
	if ai_askpermit = 1 then
		ll_res = messagebox("Insert New Record", "Do you want to Insert New Record?", question!, yesnocancel!, 2)
	else
		ll_res = 1
	end if
	if ll_res = 1 then
		ll_row = adw_dw.insertrow(0)
		if this.id_vitals.rowcount() > 1 and this.id_rx.rowcount() > 0 then
			this.id_rx.object.bsa[this.id_rx.rowcount()] = this.id_vitals.object.bsa[1]
		end if
		adw_dw.setrow(ll_row)
		adw_dw.scrolltorow(ll_row)
	end if
	return 0

// w_patientvisit_form.wf_delete_row(datawindow adw_dw, integer ai_askpermit) returns long
	long ll_row
	long ll_res
	if adw_dw.rowcount() > 0 and adw_dw.getrow() > 0 then
		if ai_askpermit = 1 then
			ll_res = messagebox("Delete Record", "Do you want to delete this record?", question!, yesnocancel!, 2)
		else
			ll_res = 1
		end if
		if ll_res = 1 then
			ll_row = adw_dw.getrow()
			if adw_dw.deleterow(ll_row) = 1 and adw_dw.rowcount() > 0 then
				adw_dw.setrow(1)
				adw_dw.scrolltorow(1)
			end if
		end if
	end if
	return 0

// w_patientvisit_form.wf_goto_record(datawindow adw_dw) returns long
	long ll_current
	long ll_counter
	long ll_row
	datastore lds_ds
	s_arguements lstr_arg
	ll_current = adw_dw.getrow()
	if adw_dw.rowcount() > 0 then
		lds_ds = create datastore
		lds_ds.dataobject = "d_mr_recordpointer"
		lds_ds.settransobject(sqlca)
		for ll_counter = 1 to adw_dw.rowcount()
			ll_row = lds_ds.insertrow(0)
			if ll_row = ll_current then
				lds_ds.object.currentrow[ll_row] = 1
			else
				lds_ds.object.currentrow[ll_row] = 0
			end if
			lds_ds.object.rowid[ll_row] = adw_dw.object.rowid[ll_counter]
			lds_ds.object.rowno[ll_row] = ll_counter
			lds_ds.object.date[ll_row] = adw_dw.object.date[ll_counter]
		next
		if lds_ds.rowcount() > 0 then
			openwithparm(w_arg_mr_record_pointer, lds_ds)
			lstr_arg = message.powerobjectparm
			if lstr_arg.i_status = 1 and lstr_arg.l_code1 > 0 then
				adw_dw.setrow(lstr_arg.l_code1)
				adw_dw.scrolltorow(lstr_arg.l_code1)
			end if
		end if
	end if
	return 0

// w_patientvisit_form.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns integer
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next
	return 0

// w_patientvisit_form.wf_apply_protect_setting() returns integer
	if this.il_protect = 1 then
		wf_protectdw(this.id_vd, this.il_protect)
		wf_protectdw(this.id_vitals, this.il_protect)
		wf_protectdw(this.id_symptoms, this.il_protect)
		wf_protectdw(this.id_pexam, this.il_protect)
		wf_protectdw(this.id_precautions, this.il_protect)
		wf_protectdw(this.id_diagnostics, this.il_protect)
		wf_protectdw(this.id_image, this.il_protect)
		wf_protectdw(this.id_rx, this.il_protect)
		wf_protectdw(this.id_image, this.il_protect)
		wf_protectdw(this.id_obs, this.il_protect)
		wf_protectdw(this.id_gyn, this.il_protect)
		wf_protectdw(this.id_abd, this.il_protect)
		this.cb_ok.enabled = false
		this.cb_patientsearch.enabled = true
		this.cb_print.enabled = true
		this.cb_print.visible = true
		this.cb_visithistory.visible = true
		this.cb_image.enabled = false
		this.cb_rx_history.enabled = true
	end if
	return 0

// w_patientvisit_form.wf_save() returns long
	if this.il_protect = 0 then
		this.cb_ok.triggerevent(clicked!)
	end if
	return 0

