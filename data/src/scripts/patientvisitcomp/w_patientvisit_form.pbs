// w_patientvisit_form.wf_help_prescription_population(long al_icode) returns long
	long ll_retcode
	long ll_ret_status
	long ll_row
	long ll_count
	s_arguements lstr_arg
	datastore lds_rx_value
	lds_rx_value = create datastore
	lds_rx_value.dataobject = "d_populate_visit_prescription"
	lds_rx_value.settransobject(this.it_transobject)
	ll_ret_status = lds_rx_value.retrieve(al_icode)
	if lds_rx_value.rowcount() <= 0 then
		return 0
	else
		ll_row = this.id_rx.getrow()
		if ll_row > 0 then
			ll_count = 1
			this.id_rx.object.icode[ll_row] = lds_rx_value.object.icode[ll_count]
			this.id_rx.object.itemname[ll_row] = lds_rx_value.object.itemname[ll_count]
			this.id_rx.object.duration[ll_row] = lds_rx_value.object.duration[ll_count]
			this.id_rx.object.diseasecode[ll_row] = lds_rx_value.object.diseasecode[ll_count]
			this.id_rx.object.dosagecode[ll_row] = lds_rx_value.object.dosagecode[ll_count]
			this.id_rx.object.dosagefactor[ll_row] = lds_rx_value.object.dosagefactor[ll_count]
			this.id_rx.object.routecode[ll_row] = lds_rx_value.object.routecode[ll_count]
			this.id_rx.object.inscode[ll_row] = lds_rx_value.object.inscode[ll_count]
			this.id_rx.object.details[ll_row] = lds_rx_value.object.details[ll_count]
			this.id_rx.object.qty[ll_row] = lds_rx_value.object.qty[ll_count]
			this.id_rx.object.manualchangeintotqty[ll_row] = lds_rx_value.object.manualchangeintotqty[ll_count]
			this.id_rx.object.dosageunitcode[ll_row] = lds_rx_value.object.dosageunitcode[ll_count]
			this.id_rx.object.dosagestrength[ll_row] = lds_rx_value.object.dosagestrength[ll_count]
			this.id_rx.object.totalqty[ll_row] = lds_rx_value.object.totalqty[ll_count]
		end if
		if lds_rx_value.rowcount() > 0 then
			lstr_arg.l_code1 = al_icode
			openwithparm(w_visit_prescription_assistant, lstr_arg)
			lstr_arg = message.powerobjectparm
			if lstr_arg.i_status = 1 then
				this.id_rx.object.icode[ll_row] = lstr_arg.l_code1
				this.id_rx.object.itemname[ll_row] = lstr_arg.s_name1
				this.id_rx.object.duration[ll_row] = lstr_arg.l_code2
				this.id_rx.object.diseasecode[ll_row] = lstr_arg.l_code3
				this.id_rx.object.dosagecode[ll_row] = lstr_arg.l_code4
				this.id_rx.object.dosagefactor[ll_row] = lstr_arg.l_code5
				this.id_rx.object.routecode[ll_row] = lstr_arg.l_code6
				this.id_rx.object.inscode[ll_row] = lstr_arg.l_code7
				this.id_rx.object.details[ll_row] = lstr_arg.s_name2
				this.id_rx.object.qty[ll_row] = lstr_arg.db_code1
				this.id_rx.object.manualchangeintotqty[ll_row] = lstr_arg.l_code9
				this.id_rx.object.dosageunitcode[ll_row] = lstr_arg.l_code10
				this.id_rx.object.dosagestrength[ll_row] = lstr_arg.s_name3
				this.id_rx.object.totalqty[ll_row] = lstr_arg.db_code2
			end if
		end if
	end if
	return 0

// w_patientvisit_form.wf_patient_retrieve() returns long
	long ll_prow
	long ll_pcode
	long ll_retcode
	long ll_rtncode
	this.ic_retrievepatientlist = f_stringpreferences("RetrievePatientListInPatientVisit")
	if this.ic_retrievepatientlist = "N" then
		ll_retcode = 0
	else
		ll_rtncode = this.idc_patient.retrieve(this.ii_module)
	end if
	if this.idc_patient.rowcount() <= 0 then
		ll_prow = this.idc_patient.insertrow(0)
		setnull(ll_pcode)
		this.idc_patient.setitem(ll_prow, "patientcode", ll_pcode)
		this.idc_patient.setitem(ll_prow, "regno", "<NONE>")
		this.idc_patient.setitem(ll_prow, "name", "<NONE>")
		this.idc_patient.setitem(ll_prow, "customer", "<NONE>")
		this.idc_patient.setitem(ll_prow, "city", "<NONE>")
		this.idc_patient.scrolltorow(ll_prow)
	end if
	if ll_rtncode < 0 then
		return -1
	end if
	return 0

// w_patientvisit_form.wf_validate_patient(string as_regno) returns long
	u_transaction it_mytrans
	string ls_name
	string ls_regno
	string ls_city
	string ls_nic
	string ls_customer
	string ls_patient
	string ls_ref
	long ll_patientcode
	long ll_relationcode
	long ll_doctcode
	long ll_wardcode
	long ll_recperiod
	long ll_prow
	long ll_found
	long ll_pcode
	it_mytrans = create u_transaction
	SQL start USING it_mytrans;
	if this.ic_retrievepatientlist = "N" then
		SQL SELECT Name =P.name , Regno =P.regno , patientcode =P.patientcode , City =P.city , NIC =P.NationalIDCard , relationcode =P.relationcode , doctcode =P.doctcode , wardcode =P.wardcode , customer =A.name , patient =LTRIM ( RTRIM ( P.Name ) ) + ' (' + LTRIM ( RTRIM ( P.RegNo ) ) + ')' , RecurringPeriod =ISNULL ( P.RecurringPeriod , 0 ) , Reference =P.Reference INTO :ls_name, :ls_regno, :ll_patientcode, :ls_city, :ls_nic, :ll_relationcode, :ll_doctcode, :ll_wardcode, :ls_customer, :ls_patient, :ll_recperiod, :ls_ref FROM Patient P , Accounts A WHERE P.RegNo =:as_regno AND P.CustCode =A.AccCode USING it_mytrans;
		if it_mytrans.sqlcode = 0 then
			ll_found = this.idc_patient.find("regno = '" + as_regno + "'", 1, this.idc_patient.rowcount())
			if ll_found > 0 and ll_found <= this.idc_patient.rowcount() then
				ll_prow = ll_found
			else
				ll_prow = this.idc_patient.insertrow(0)
			end if
			setnull(ll_pcode)
			this.idc_patient.setitem(ll_prow, "name", ls_name)
			this.idc_patient.setitem(ll_prow, "regno", ls_regno)
			this.idc_patient.setitem(ll_prow, "patientcode", ll_patientcode)
			this.idc_patient.setitem(ll_prow, "city", ls_city)
			this.idc_patient.setitem(ll_prow, "nic", ls_nic)
			this.idc_patient.setitem(ll_prow, "relationcode", ll_relationcode)
			this.idc_patient.setitem(ll_prow, "doctcode", ll_doctcode)
			this.idc_patient.setitem(ll_prow, "wardcode", ll_wardcode)
			this.idc_patient.setitem(ll_prow, "customer", ls_customer)
			this.idc_patient.setitem(ll_prow, "patient", ls_patient)
			this.idc_patient.setitem(ll_prow, "RecurringPeriod", ll_recperiod)
			this.idc_patient.setitem(ll_prow, "Reference", ls_ref)
			this.idc_patient.scrolltorow(ll_prow)
			this.id_vd.setredraw(false)
			this.id_vd.object.patientcode[1] = ll_patientcode
			this.id_vd.setredraw(true)
		end if
	else
		this.idc_patient.retrieve(this.ii_module)
	end if
	this.idc_patient.setredraw(true)
	destroy it_mytrans
	return 0

// w_patientvisit_form.create() returns 0
	this.cb_rx_history = create cb_rx_history
	this.cb_image = create cb_image
	this.cb_visithistory = create cb_visithistory
	this.cb_patientsearch = create cb_patientsearch
	this.cb_print = create cb_print
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.tab_main = create tab_main
	this.dw_print = create dw_print
	this.dw_image = create dw_image
	this.dw_print2 = create dw_print2
	this.control = {this.cb_rx_history, this.cb_image, this.cb_visithistory, this.cb_patientsearch, this.cb_print, this.cb_cancel, this.cb_ok, this.tab_main, this.dw_print, this.dw_image, this.dw_print2}

