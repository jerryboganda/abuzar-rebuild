	destroy this.cb_rx_history
	destroy this.cb_image
	destroy this.cb_visithistory
	destroy this.cb_patientsearch
	destroy this.cb_print
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.tab_main
	destroy this.dw_print
	destroy this.dw_image
	destroy this.dw_print2

// w_patientvisit_form.open() returns long
	integer li_xpos
	integer li_ypos
	integer li_xendpos
	integer li_counter
	integer li_taborder
	integer li_visiblecolumns
	integer li_zerotaborder
	long ll_counter
	long li_retcode
	long li_rtncode
	long ll_found
	long ll_rtncode
	boolean lb_active
	boolean lb_restricted
	boolean lb_customicode
	boolean lb_zerotabordercol
	date ld_date
	long ll_retcode
	setnull(this.il_code)
	setnull(this.il_patientcode)
	setnull(this.il_admission)
	ld_date = today()
	this.istr_datatype = message.powerobjectparm
	this.il_protect = this.istr_datatype.ai_int
	this.il_code = this.istr_datatype.al_long
	this.it_transobject = create u_transaction
	if wf_connect() <> 0 then
		messagebox("Connection Failure", "Unable to connect to the database", stopsign!)
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	this.id_vd = create u_dwstandard
	this.id_profile = create u_dwstandard
	this.id_vitals = create u_dwstandard
	this.id_symptoms = create u_dwstandard
	this.id_pexam = create u_dwstandard
	this.id_diagnostics = create u_dwstandard
	this.id_precautions = create u_dwstandard
	this.id_rx = create u_dwstandard
	this.id_image = create u_dwstandard
	this.id_tg = create u_dwstandard
	this.id_obs = create u_dwstandard
	this.id_gyn = create u_dwstandard
	this.id_abd = create u_dwstandard
	ll_found = gds_securitywindow.find("rightcode = 5012", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_modifydate = true
	end if
	if f_rightexists(5092) then
		this.ib_registerpatient = true
	else
		this.ib_registerpatient = false
	end if
	if f_rightexists(5100) then
		this.ib_uploadimage = true
	else
		this.ib_uploadimage = false
	end if
	if f_rightexists(5100) then
		this.ib_viewimage = true
	else
		this.ib_viewimage = false
	end if
	setredraw(false)
	this.il_attendingdoctcode = f_get_user_doctor(gl_usercode)
	wf_get_patient_info(this.il_code)
	wf_apply_protect_setting()
	wf_set_interface_adjustments()
	wf_set_tab_visibility()
	wf_retrieve_tabs()
	ll_found = gds_securitywindow.find("rightcode = 5012", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_modifydate = true
	end if
	ll_rtncode = this.id_vd.getchild("patientcode", this.idc_patient)
	if ll_rtncode = -1 then
		messagebox("Patient Visit", "Problem in Retrieving Patient List")
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	this.idc_patient.settransobject(this.it_transobject)
	if wf_patient_retrieve() < 0 then
		messagebox("Patient Visit", "Problem in Retrieving Patient List")
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	if this.il_code > 0 and this.ic_retrievepatientlist = "N" and this.id_vd.rowcount() > 0 and not isnull(this.id_vd.object.regno[1]) then
		wf_validate_patient(this.id_vd.object.regno[1])
	end if
	ll_rtncode = this.id_vd.getchild("doctcode", this.idc_doctor)
	if ll_rtncode = -1 then
		messagebox("Patient Visit", "Problem in Retrieving Doctors List")
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	this.idc_doctor.settransobject(this.it_transobject)
	ll_rtncode = this.idc_doctor.retrieve(gl_usercode)
	if ll_rtncode <= 0 then
		messagebox("Patient Visit", "Not Enough Doctor Allowed, Please contact your system administrator")
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	if isnull(this.il_code) and this.idc_doctor.rowcount() > 0 then
		this.id_vd.object.doctcode.initial = string(this.idc_doctor.getitemnumber(1, "doctcode"))
	end if
	ll_rtncode = this.id_vd.getchild("appointmentcode", this.idc_appointment)
	if ll_rtncode = -1 then
		messagebox("Patient Visit", "Problem in Retrieving Appointment List")
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	this.idc_appointment.settransobject(this.it_transobject)
	if isnull(this.il_code) then
		wf_retrieve_appointments(this.idc_doctor.getitemnumber(1, "doctcode"))
	end if
	this.ids_symptoms_hidden = create u_ds_standard
	this.ids_pexam_hidden = create u_ds_standard
	this.ids_precautions_hidden = create u_ds_standard
	this.ids_diagnostics_hidden = create u_ds_standard
	this.ids_symptoms_hidden.dataobject = this.id_symptoms.dataobject
	this.ids_symptoms_hidden.settransobject(this.it_transobject)
	this.ids_pexam_hidden.dataobject = this.id_pexam.dataobject
	this.ids_pexam_hidden.settransobject(this.it_transobject)
	this.ids_precautions_hidden.dataobject = this.id_precautions.dataobject
	this.ids_precautions_hidden.settransobject(this.it_transobject)
	this.ids_diagnostics_hidden.dataobject = this.id_diagnostics.dataobject
	this.ids_diagnostics_hidden.settransobject(this.it_transobject)
	if f_stringpreferences("PatientAppointmentCompulsion") = "N" then
		this.id_vd.object.appointmentcode.edit.required = "no"
	end if
	setredraw(true)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_patientvisit_form.key(keycode key, unsignedlong keyflags) returns long
	if key = keyf8! and this.ib_viewimage then
		wf_show_patient_gallery()
	end if
	if key = keyf9! and this.ib_uploadimage then
		wf_setimage("ECG")
	end if
	return ::message.returnvalue

// cb_rx_history.clicked() returns long
	parent.wf_show_rx_history()
	return ::message.returnvalue

// cb_image.clicked() returns long
	if parent.il_protect = 1 then
		return ::message.returnvalue
	end if
	parent.wf_setimage("PV")
	return ::message.returnvalue

// cb_visithistory.clicked() returns long
	parent.wf_visithistory()
	return ::message.returnvalue

// cb_patientsearch.clicked() returns long
	parent.wf_patientsearch()
	return ::message.returnvalue

// cb_print.clicked() returns long
	parent.ib_print = true
	if parent.il_protect = 0 then
		parent.wf_save()
	else
		parent.wf_print()
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.postevent("ue_close")
	return ::message.returnvalue

// cb_ok.ue_enterkry(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return 1

// cb_ok.clicked() returns long
	datetime ldt_server_datetime
	string ls_aliasname
	string ls_date_errtext
	long ll_newid
	long ll_row
	long ll_counter
	long ll_liccode
	long li_rc
	long ll_usercode
	long ll_retcode
	boolean lb_commitok
	if parent.il_protect = 1 then
		return ::message.returnvalue
	end if
	ll_row = 1
	if parent.id_vd.getrow() > 0 then
		if isnull(parent.id_vd.object.patientcode[1]) then
			messagebox("Patient Validation", "Please select a valid patient", stopsign!)
			return ::message.returnvalue
		end if
		parent.il_patientcode = parent.id_vd.object.patientcode[1]
	end if
	if f_validatedw(parent.id_vd) < 0 then
		parent.tab_main.selecttab(1)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_vitals) < 0 then
		parent.tab_main.selecttab(2)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_symptoms) < 0 then
		parent.tab_main.selecttab(3)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_pexam) < 0 then
		parent.tab_main.selecttab(4)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_precautions) < 0 then
		parent.tab_main.selecttab(5)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_diagnostics) < 0 then
		parent.tab_main.selecttab(6)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_rx) < 0 then
		parent.tab_main.selecttab(7)
		return ::message.returnvalue
	end if
	if parent.wf_validate_rx() = 1 then
		parent.tab_main.selecttab(7)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_obs) < 0 then
		parent.tab_main.selecttab(8)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_gyn) < 0 then
		parent.tab_main.selecttab(9)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_abd) < 0 then
		parent.tab_main.selecttab(10)
		return ::message.returnvalue
	end if
	if not parent.ib_modifydate then
		if not parent.wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			return ::message.returnvalue
		end if
		parent.id_vd.object.date[1] = ldt_server_datetime
	end if
	if isnull(parent.id_vd.object.followupdays[ll_row]) or parent.id_vd.object.followupdays[ll_row] < 0 then
		parent.id_vd.object.followupdays[ll_row] = 0
	end if
	ll_usercode = gl_usercode
	if ll_usercode > 0 then
		ll_newid = parent.id_vd.object.code[1]
		if isnull(parent.il_code) and isnull(ll_newid) then
			parent.wf_tabnewid("Visit", ll_newid)
			parent.il_code = ll_newid
		end if
		parent.id_vd.object.usercode[1] = ll_usercode
		parent.wf_presave()
		if parent.id_vd.update(true, false) < 1 then
			messagebox("Visit Detail Validation", "Unable to update Visit Detail  Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
			SQL rollback USING parent.it_transobject;
			ll_retcode = -1
		end if
		if parent.id_vitals.update(true, false) < 1 then
			messagebox("Vital Signs Validation", "Unable to update Vital Signs Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
			SQL rollback USING parent.it_transobject;
			ll_retcode = -1
		end if
		if parent.ids_symptoms_hidden.update(true, false) < 1 then
			messagebox("Symptoms Validation", "Unable to update Symptoms Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
			SQL rollback USING parent.it_transobject;
			ll_retcode = -1
		end if
		if parent.ids_pexam_hidden.update(true, false) < 1 then
			messagebox("Physical Examination Validation", "Unable to update Physical Examination  Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
			SQL rollback USING parent.it_transobject;
			ll_retcode = -1
		end if
		if parent.ids_precautions_hidden.update(true, false) < 1 then
			messagebox("Precautions validation", "Unable to update Precautions Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
			SQL rollback USING parent.it_transobject;
			ll_retcode = -1
		end if
		if parent.ids_diagnostics_hidden.update(true, false) < 1 then
			messagebox("Diagnostics validation", "Unable to update Diagnostics Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
			SQL rollback USING parent.it_transobject;
			ll_retcode = -1
		end if
		if parent.id_rx.update(true, false) < 1 then
			messagebox("Visit Prescription validation", "Unable to update Prescription Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
			SQL rollback USING parent.it_transobject;
			ll_retcode = -1
		end if
		if parent.id_obs.update(true, false) < 1 then
			messagebox("Obsteterical ultrasound validation", "Unable to update Obsteterical ultrasound Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
			SQL rollback USING parent.it_transobject;
			ll_retcode = -1
		end if
		if parent.id_gyn.update(true, false) < 1 then
			messagebox("Gynecological ultrasound validation", "Unable to update Gynecological ultrasound Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
			SQL rollback USING parent.it_transobject;
			ll_retcode = -1
		end if
		if parent.id_abd.update(true, false) < 1 then
			messagebox("Abdominal ultrasound validation", "Unable to update Abdominal ultrasound Record" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
			SQL rollback USING parent.it_transobject;
			ll_retcode = -1
		end if
		if ll_retcode = 0 then
			SQL commit USING parent.it_transobject;
			lb_commitok = true
			if parent.ib_print = true then
				parent.wf_print()
			end if
			if parent.wf_update_image() = 0 then
				parent.id_image.reset()
				parent.istr_image = parent.istr_blank_image
			end if
			parent.event ue_close()
		else
			return ::message.returnvalue
		end if
		return
	end if
	return ::message.returnvalue

