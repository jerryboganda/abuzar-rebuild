			this.id_vitals.object.bsa[1] = 0.024265 * ld_height ^ 0.3964 * ld_weight ^ 0.5378
		elseif this.id_vitals.object.bsamethod[1] = 4 then
			this.id_vitals.object.bsa[1] = 0.0235 * ld_height ^ 0.42246 * ld_weight ^ 0.51456
		elseif this.id_vitals.object.bsamethod[1] = 5 then
			ld_weight_gms = ld_weight * 1000.0
