// dw_vd.itemchanged(long row, dwobject dwo, string data) returns long
	long ancestorreturnvalue
	long ll_patientcode
	long ll_res
	long ll_found
	long ll_count
	integer li_null
	datetime ldt_date_null
	date ld_followupdate
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ldt_date_null)
	setnull(li_null)
	choose case dwo.name
	case "doctcode"
		parent.parent.parent.wf_retrieve_appointments(long(data))
	case "appointmentcode"
		parent.parent.parent.wf_set_appointmentinfo(long(data))
	case "regno"
		if not isnull(data) and data <> "" then
			ll_res = parent.parent.parent.wf_findpatientcode(data, ll_patientcode)
			if ll_res > 0 then
				setitem(row, "patientcode", ll_patientcode)
				parent.parent.parent.wf_validate_patient(data)
			else
				if ll_res = -2 then
					messagebox("Patient Validation", "Patient with  RegNo  " + data + " is Inactive")
				else
					messagebox("Patient Validation", "Patient with  RegNo  " + data + " does not exist")
				end if
				return 1
			end if
			return
		end if
	case "patientcode"
		ll_patientcode = long(data)
		ll_found = parent.parent.parent.idc_patient.find("patientcode=" + trim(string(ll_patientcode)), 1, parent.parent.parent.idc_patient.rowcount())
		if ll_found > 0 then
			setitem(1, "regno", parent.parent.parent.idc_patient.getitemstring(parent.parent.parent.idc_patient.getrow(), "regno"))
		else
			messagebox("Patient Validation", "Patient does not exist or Already Inactive.")
			return 1
		end if
	case "followupdays"
		if long(data) < 0 or isnull(data) then
			messagebox("Patient Follow-up Days Validation", "Please enter valid Patient Follow-up Days.", stopsign!)
			return 1
		else
			ld_followupdate = relativedate(date(this.object.date[1]), long(data))
			SQL SELECT ISNULL ( COUNT ( V.VisitCode ) , :ld_followupdate ) INTO :ll_count FROM Visit V WHERE CAST ( CONVERT ( VARCHAR ( 100 ) , DateAdd ( dd , V.FollowUpDAys , V.Date ) , 101 ) AS DATETIME ) ={d '2024-11-08' } USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = 0 then
				this.object.followupdate[1] = ld_followupdate
				this.object.estimatedpatientcount[1] = ll_count
				if ll_count > this.object.maxestpatientcount[1] then
					ll_res = messagebox("Patient Follow-up Days Validation", "Estimated Patient Count is exceeding Maximum Daily Patients Limit.~r~nAllow this to happen?", question!, yesno!, 2)
					if ll_res = 1 then
						return 0
					else
						return 1
					end if
				else
					this.object.estimatedpatientcount[1] = ll_count
				end if
			else
				return 0
			end if
		end if
		return
	end choose
	return ::message.returnvalue

// dw_vd.itemfocuschanged(long row, dwobject dwo) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if len(gettext()) > 0 then
		selecttext(1, len(gettext()))
	end if
	return ::message.returnvalue

// dw_vd.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if getcolumnname() = "patientcode" and parent.parent.parent.ib_registerpatient and key = keyf5! then
		parent.parent.parent.wf_registerpatient()
	end if
	if key = keyf8! and parent.parent.parent.ib_viewimage then
		parent.parent.parent.wf_show_patient_gallery()
	end if
	if keyflags = 2 and key = keys! then
		parent.parent.parent.cb_ok.triggerevent(clicked!)
	end if
	return ::message.returnvalue

// dw_vd.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	if getcolumnname() <> "diagnosis" then
		if getcolumnname() <> "previousdiagnosis" then
			if getcolumnname() <> "recommendations" then
				send(handle(this), 256, 9, long(90))
				return 1
			end if
		end if
	end if
	return ::message.returnvalue

