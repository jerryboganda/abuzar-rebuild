// w_patientvisit_form.wf_set_interface_adjustments() returns 0
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width * 0.95
		ll_height = ll_win_height * 0.95
		this.width = ll_width
		this.height = ll_height
		this.cb_ok.y = ll_height - this.cb_ok.height - 200
		this.cb_cancel.y = ll_height - this.cb_cancel.height - 200
		this.cb_print.y = ll_height - this.cb_print.height - 200
		this.cb_patientsearch.y = ll_height - this.cb_patientsearch.height - 200
		this.cb_visithistory.y = ll_height - this.cb_visithistory.height - 200
		this.cb_image.y = ll_height - this.cb_image.height - 200
		this.cb_rx_history.y = ll_height - this.cb_image.height - 200
		this.tab_main.width = ll_width * 0.98
		this.tab_main.height = this.cb_ok.y - 50
		this.tab_main.tabpage_vd.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_vd.height = this.tab_main.height - 500
		this.tab_main.tabpage_vd.dw_vd.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_vd.dw_vd.height = this.tab_main.height - 500
		this.tab_main.tabpage_vitals.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_vitals.height = this.tab_main.height - 500
		this.tab_main.tabpage_vitals.dw_vitals.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_vitals.dw_vitals.height = this.tab_main.height - 500
		this.tab_main.tabpage_symptoms.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_symptoms.height = this.tab_main.height - 500
		this.tab_main.tabpage_symptoms.dw_symptoms.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_symptoms.dw_symptoms.height = this.tab_main.height - 500
		this.tab_main.tabpage_pexam.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_pexam.height = this.tab_main.height - 500
		this.tab_main.tabpage_pexam.dw_pexam.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_pexam.dw_pexam.height = this.tab_main.height - 500
		this.tab_main.tabpage_precautions.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_precautions.height = this.tab_main.height - 500
		this.tab_main.tabpage_precautions.dw_precautions.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_precautions.dw_precautions.height = this.tab_main.height - 500
		this.tab_main.tabpage_diagnostics.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_diagnostics.height = this.tab_main.height - 500
		this.tab_main.tabpage_diagnostics.dw_diagnostics.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_diagnostics.dw_diagnostics.height = this.tab_main.height - 500
		this.tab_main.tabpage_rx.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_rx.height = this.tab_main.height - 500
		this.tab_main.tabpage_rx.dw_rx.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_rx.dw_rx.height = this.tab_main.height - 500
		this.tab_main.tabpage_obs_us.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_obs_us.height = this.tab_main.height - 500
		this.tab_main.tabpage_obs_us.dw_obs_us.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_obs_us.dw_obs_us.height = this.tab_main.height - 500
		this.tab_main.tabpage_gyn_us.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_gyn_us.height = this.tab_main.height - 500
		this.tab_main.tabpage_gyn_us.dw_gyn_us.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_gyn_us.dw_gyn_us.height = this.tab_main.height - 500
		this.tab_main.tabpage_abd_us.width = this.tab_main.width * 0.98
