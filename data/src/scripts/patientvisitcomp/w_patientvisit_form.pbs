// tab_main.selectionchanged(integer oldindex, integer newindex) returns long
	if parent.il_protect = 0 then
		parent.cb_print.visible = true
		parent.cb_patientsearch.visible = true
		if isnull(parent.il_code) then
			if newindex = 1 then
				parent.id_vd.setfocus()
				if parent.id_vd.rowcount() = 0 then
					if parent.idc_patient.rowcount() = 0 then
						parent.idc_patient.insertrow(0)
					end if
					parent.idc_doctor.insertrow(0)
					parent.idc_appointment.insertrow(0)
					parent.id_vd.insertrow(0)
				end if
			elseif newindex = 2 then
				parent.id_vitals.setfocus()
				if parent.id_vitals.rowcount() = 0 then
					parent.wf_insert_row(parent.id_vitals, 0)
				end if
			elseif newindex = 3 then
				parent.id_symptoms.setfocus()
				if parent.id_symptoms.rowcount() = 0 then
					parent.wf_insert_row(parent.id_symptoms, 0)
				end if
			elseif newindex = 4 then
				parent.id_pexam.setfocus()
				if parent.id_pexam.rowcount() = 0 then
					parent.wf_insert_row(parent.id_pexam, 0)
				end if
			elseif newindex = 5 then
				parent.id_precautions.setfocus()
				if parent.id_precautions.rowcount() = 0 then
					parent.wf_insert_row(parent.id_precautions, 0)
				end if
			elseif newindex = 6 then
				parent.id_diagnostics.setfocus()
				if parent.id_diagnostics.rowcount() = 0 then
					parent.wf_insert_row(parent.id_diagnostics, 0)
				end if
			elseif newindex = 7 then
				parent.id_rx.setfocus()
				if parent.id_rx.rowcount() = 0 then
					parent.wf_insert_row(parent.id_rx, 0)
					if parent.id_vitals.rowcount() > 0 then
						parent.id_rx.object.bsa[parent.id_rx.rowcount()] = parent.id_vitals.object.bsa[1]
					end if
				end if
			elseif newindex = 8 then
				parent.id_obs.setfocus()
				if parent.id_obs.rowcount() = 0 then
					parent.wf_insert_row(parent.id_obs, 0)
				end if
			elseif newindex = 9 then
				parent.id_gyn.setfocus()
				if parent.id_gyn.rowcount() = 0 then
					parent.wf_insert_row(parent.id_gyn, 0)
				end if
			elseif newindex = 10 then
				parent.id_abd.setfocus()
				if parent.id_abd.rowcount() = 0 then
					parent.wf_insert_row(parent.id_abd, 0)
				end if
			end if
		end if
	end if
	return ::message.returnvalue

