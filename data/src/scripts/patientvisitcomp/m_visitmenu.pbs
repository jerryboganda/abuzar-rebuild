// menu m_visitmenu (patientvisitcomp)  ancestor: m_multi_entry

// m_visitmenu.create() returns 0 [event]
	m_visitmenu = this
	call super::create

// m_visitmenu.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_patientinfo = create m_patientinfo
	this.m_patientvitalsigns = create m_patientvitalsigns
	this.m_patientdiagnosis = create m_patientdiagnosis
	this.m_patientphysicalexam = create m_patientphysicalexam
	this.m_patientdiagnostics = create m_patientdiagnostics
	this.m_patientprescription = create m_patientprescription
	this.m_visithistory = create m_visithistory
	this.m_patientsearch = create m_patientsearch
	this.m_managepatientimages = create m_managepatientimages
	this.m_visitprecautions = create m_visitprecautions
	this.item[upperbound(this.item) + 1] = this.m_patientinfo
	this.item[upperbound(this.item) + 1] = this.m_patientvitalsigns
	this.item[upperbound(this.item) + 1] = this.m_patientdiagnosis
	this.item[upperbound(this.item) + 1] = this.m_patientphysicalexam
	this.item[upperbound(this.item) + 1] = this.m_patientdiagnostics
	this.item[upperbound(this.item) + 1] = this.m_patientprescription
	this.item[upperbound(this.item) + 1] = this.m_visithistory
	this.item[upperbound(this.item) + 1] = this.m_patientsearch
	this.item[upperbound(this.item) + 1] = this.m_managepatientimages
	this.item[upperbound(this.item) + 1] = this.m_visitprecautions

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_patientinfo
	destroy this.m_patientvitalsigns
	destroy this.m_patientdiagnosis
	destroy this.m_patientphysicalexam
	destroy this.m_patientdiagnostics
	destroy this.m_patientprescription
	destroy this.m_visithistory
	destroy this.m_patientsearch
	destroy this.m_managepatientimages
	destroy this.m_visitprecautions

// m_patientinfo.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_registerpatient()

// m_patientinfo.create() returns 0 [event]
