// window w_visitprescription (patientvisitcomp)  ancestor: window

// w_visitprescription.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// w_visitprescription.ue_close(integer ai_closemode) returns integer [event]
	long ll_currrow
	long ll_counter
	long ll_null
	ll_currrow = this.id_detail.getrow()
	setnull(ll_null)
	this.istr_ds.i_closemode = ai_closemode
	if ai_closemode = 1 then
		if this.id_detail.rowcount() > 0 then
			if isnull(this.id_detail.getitemnumber(ll_currrow, "icode")) then
				if isnull(this.id_detail.getitemstring(ll_currrow, "itemname")) then
					this.id_detail.deleterow(ll_currrow)
				elseif this.ib_itemvalidated = false then
					messagebox("Item Validation", "Please Select Some Valid Item")
					this.id_detail.setcolumn("itemname")
					this.id_detail.scrolltorow(ll_currrow)
					this.id_detail.setfocus()
					return 1
				end if
			elseif this.ib_itemvalidated = false then
				messagebox("Item Validation", "Please Select Some Valid Item")
				this.id_detail.setcolumn("itemname")
				this.id_detail.scrolltorow(ll_currrow)
				this.id_detail.setfocus()
				return 1
			end if
			if f_validatedw(this.id_header) < 0 then
				return 1
			end if
			if f_validatedw(this.id_detail) < 0 then
				return 1
			end if
			this.il_currrow = this.id_detail.rowcount()
			if this.ib_itemvalidated = false and wf_validateitem(ll_currrow) = -1 then
				return 1
			end if
			return
		end if
		if this.istr_ds.i_protect = 0 then
			this.id_detail.sharedata(this.istr_ds.ds)
		end if
	end if
	closewithreturn(this, this.istr_ds)
	return 0

// w_visitprescription.ue_postopen() returns 0 [event]
	long li_counter
	long ll_startrow
	long ll_rowcount
	long ll_found
	char lc_char
	ll_rowcount = this.id_selectionlist.rowcount()
	if ll_rowcount <= 0 or isnull(ll_rowcount) then
		messagebox("Row Validation", "There are no rows to select in SelectionList.~r~nKindly try again.")
		close(this)
		return
	end if
	setredraw(false)
	this.id_selectionlist.setsort("name A")
	this.id_selectionlist.sort()
	for li_counter = 65 to 90
		lc_char = char(li_counter)
		this.ia_llookuptable[li_counter] = this.id_selectionlist.find("Lower(name) >= Lower('" + char(li_counter) + "')", ll_startrow, 99999)
		ll_startrow = this.ia_llookuptable[li_counter]
	next
	this.ia_llookuptable[92] = 99999
	setredraw(true)

// w_visitprescription.wf_validateitem(long al_row) returns integer
	long ll_icode
	long ll_null
	integer li_errcode
	setnull(ll_null)
	ll_icode = this.id_detail.getitemnumber(al_row, "icode")
	if isnull(ll_icode) then
		this.ib_rowvalidated = false
		this.ib_itemvalidated = false
		messagebox("Validation Error!", "Please Enter Valid Item")
		li_errcode = -1
	else
		li_errcode = 0
		this.ib_rowvalidated = true
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		this.id_detail.setcolumn("icode")
		this.id_detail.scrolltorow(al_row)
		this.id_detail.object.icode[al_row] = ll_null
	end if
	return li_errcode

// w_visitprescription.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_visitprescription.wf_set_header(long al_row) returns long
	this.id_detail.accepttext()
	if al_row > 0 then
		this.id_header.setitem(1, "details", this.id_detail.object.details[al_row])
	end if
	return 0

// w_visitprescription.wf_set_details() returns long
	long ll_row
	this.id_header.accepttext()
	ll_row = this.id_detail.getrow()
	if ll_row > 0 then
		this.id_detail.setitem(ll_row, "details", this.id_header.object.details[1])
	end if
	return 0

// w_visitprescription.wf_show_rx_detail(long al_row) returns long
	s_datastore lstr_ds
	if al_row > 0 then
		this.ids_rx_detail.object.code[1] = this.id_detail.object.code[al_row]
		this.ids_rx_detail.object.rowid[1] = this.id_detail.object.rowid[al_row]
		this.ids_rx_detail.object.icode[1] = this.id_detail.object.icode[al_row]
		this.ids_rx_detail.object.itemname[1] = this.id_detail.object.itemname[al_row]
		this.ids_rx_detail.object.qty[1] = this.id_detail.object.qty[al_row]
		this.ids_rx_detail.object.bsa[1] = this.id_detail.object.bsa[al_row]
		this.ids_rx_detail.object.date[1] = this.id_detail.object.date[al_row]
		this.ids_rx_detail.object.duration[1] = this.id_detail.object.duration[al_row]
		this.ids_rx_detail.object.dosagecode[1] = this.id_detail.object.dosagecode[al_row]
		this.ids_rx_detail.object.dosagefactor[1] = this.id_detail.object.dosagefactor[al_row]
		this.ids_rx_detail.object.routecode[1] = this.id_detail.object.routecode[al_row]
		this.ids_rx_detail.object.inscode[1] = this.id_detail.object.inscode[al_row]
		this.ids_rx_detail.object.details[1] = this.id_detail.object.details[al_row]
		this.ids_rx_detail.object.dosageunitcode[1] = this.id_detail.object.dosageunitcode[al_row]
		this.ids_rx_detail.object.dosagestrength[1] = this.id_detail.object.dosagestrength[al_row]
		this.ids_rx_detail.object.totalqty[1] = this.id_detail.object.totalqty[al_row]
		openwithparm(w_visitprescription_details, this.ids_rx_detail)
		lstr_ds = message.powerobjectparm
		if lstr_ds.i_protect = 0 and lstr_ds.i_closemode = 1 and this.ids_rx_detail.rowcount() > 0 then
			this.id_detail.object.code[al_row] = this.ids_rx_detail.object.code[1]
			this.id_detail.object.rowid[al_row] = this.ids_rx_detail.object.rowid[1]
			this.id_detail.object.icode[al_row] = this.ids_rx_detail.object.icode[1]
			this.id_detail.object.itemname[al_row] = this.ids_rx_detail.object.itemname[1]
			this.id_detail.object.qty[al_row] = this.ids_rx_detail.object.qty[1]
			this.id_detail.object.bsa[al_row] = this.ids_rx_detail.object.bsa[1]
			this.id_detail.object.date[al_row] = this.ids_rx_detail.object.date[1]
			this.id_detail.object.duration[al_row] = this.ids_rx_detail.object.duration[1]
			this.id_detail.object.dosagecode[al_row] = this.ids_rx_detail.object.dosagecode[1]
			this.id_detail.object.dosagefactor[al_row] = this.ids_rx_detail.object.dosagefactor[1]
			this.id_detail.object.routecode[al_row] = this.ids_rx_detail.object.routecode[1]
			this.id_detail.object.inscode[al_row] = this.ids_rx_detail.object.inscode[1]
			this.id_detail.object.details[al_row] = this.ids_rx_detail.object.details[1]
			this.id_detail.object.dosageunitcode[al_row] = this.ids_rx_detail.object.dosageunitcode[1]
			this.id_detail.object.dosagestrength[al_row] = this.ids_rx_detail.object.dosagestrength[1]
			this.id_detail.object.totalqty[al_row] = this.ids_rx_detail.object.totalqty[1]
		end if
	end if
	return 0

// w_visitprescription.wf_dosageinfo(long al_dosagecode, long al_row) returns long
	long ll_factor
	if al_dosagecode > 0 then
		SQL SELECT dosefactor INTO :ll_factor FROM Dosage WHERE DosageCode =:al_dosagecode USING sqlca;
	end if
	if sqlca.sqlcode = 0 and ll_factor > 0 then
		this.id_detail.object.dosagefactor[al_row] = ll_factor
	end if
	return 0

// w_visitprescription.wf_update_totalqty(long al_row) returns long
	double ld_qty
	double ld_totqty
	double ld_bsa
	long ll_dosageunitcode
	long ll_dosagecode
	long ll_dosagefactor
	long ll_duration
	if al_row > 0 and this.id_detail.object.manualchangeintotqty[al_row] = 0 then
		ld_qty = this.id_detail.object.qty[al_row]
		if isnull(ld_qty) then
			ld_qty = 0
		end if
		ld_bsa = this.id_detail.object.bsa[al_row]
		if isnull(ld_bsa) or ld_bsa <= 0.0 then
			ld_bsa = 1
		end if
		ll_dosagecode = this.id_detail.object.dosagecode[al_row]
		ll_dosagefactor = this.id_detail.object.dosagefactor[al_row]
		if isnull(ll_dosagefactor) then
			ll_dosagefactor = 1
		end if
		ll_duration = this.id_detail.object.duration[al_row]
		if isnull(ll_duration) then
			ll_duration = 0
		end if
		ld_totqty = ld_qty * ll_dosagefactor * ll_duration
		this.id_detail.object.totalqty[al_row] = round(ld_totqty, 0)
	end if
	return 0

// w_visitprescription.create() returns 0 [event]
	this.cb_getmodel = create cb_getmodel
	this.cb_back = create cb_back
	this.dw_header = create dw_header
	this.dw_detail = create dw_detail
	this.dw_selectionlist = create dw_selectionlist
	this.control = {this.cb_getmodel, this.cb_back, this.dw_header, this.dw_detail, this.dw_selectionlist}

// w_visitprescription.destroy() returns 0 [event]
	destroy this.cb_getmodel
	destroy this.cb_back
	destroy this.dw_header
	destroy this.dw_detail
	destroy this.dw_selectionlist

// w_visitprescription.open() returns long [event]
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_rtncode
	environment env
	setredraw(false)
	this.istr_ds = message.powerobjectparm
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		this.width = ll_win_width * 0.98
		this.height = ll_win_height * 0.98
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
		this.dw_selectionlist.width = this.width * 0.98 * 0.80
		this.dw_selectionlist.height = this.height * 0.87 * 0.95
		this.dw_selectionlist.bringtotop = true
		this.dw_detail.width = this.width * 0.98
		this.dw_detail.height = this.height * 0.87
		this.cb_getmodel.y = this.dw_detail.y + this.dw_detail.height + 10
		this.cb_back.y = this.dw_detail.y + this.dw_detail.height + 10
	end if
	this.id_detail = this.dw_detail
	this.id_header = this.dw_header
	this.id_selectionlist = this.dw_selectionlist
	this.id_header.settransobject(sqlca)
	this.id_header.retrieve()
	this.id_detail.settransobject(sqlca)
	this.id_selectionlist.settransobject(sqlca)
	this.ids_rx_detail = create u_ds_standard
	this.ids_rx_detail.dataobject = "d_visit_prescription_detail"
	this.ids_rx_detail.settransobject(sqlca)
	this.ids_rx_detail.insertrow(0)
	this.istr_ds.ds.sharedata(this.id_detail)
	if this.istr_ds.d_value <= 0.0 or isnull(this.istr_ds.d_value) then
		this.istr_ds.ds.name.bsa.initial = "1"
	else
		this.istr_ds.ds.name.bsa.initial = trim(string(this.istr_ds.d_value))
	end if
	if this.id_detail.rowcount() <= 0 then
		this.id_detail.insertrow(0)
	end if
	this.id_detail.setrow(1)
	this.id_detail.scrolltorow(1)
	this.il_currrow = this.id_detail.rowcount()
	gd_popup_itemsinfo.sharedata(this.id_selectionlist)
	post event ue_postopen()
	this.dw_detail.setcolumn("itemname")
	this.dw_detail.scrolltorow(this.il_currrow)
	this.dw_detail.setfocus()
	wf_protectdw(this.id_detail, this.istr_ds.i_protect)
	wf_protectdw(this.id_header, this.istr_ds.i_protect)
	if this.istr_ds.i_protect = 1 then
		this.id_selectionlist.hide()
	end if
	f_setcolumnstyle(this.id_detail, "Qty")
	setredraw(true)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_visitprescription.closequery() returns long [event]
	long ll_currrow
	long ll_counter
	long ll_null
	ll_currrow = this.id_detail.getrow()
	setnull(ll_null)
	if this.id_detail.rowcount() > 0 then
		if isnull(this.id_detail.getitemnumber(ll_currrow, "icode")) then
			if isnull(this.id_detail.getitemstring(ll_currrow, "itemname")) then
				this.id_detail.deleterow(ll_currrow)
			elseif this.ib_itemvalidated = false then
				messagebox("Item Validation", "Please Select Some Valid Item")
				this.id_detail.setcolumn("itemname")
				this.id_detail.scrolltorow(ll_currrow)
				this.id_detail.setfocus()
				return 1
			end if
		elseif this.ib_itemvalidated = false then
			messagebox("Item Validation", "Please Select Some Valid Item")
			this.id_detail.setcolumn("itemname")
			this.id_detail.scrolltorow(ll_currrow)
			this.id_detail.setfocus()
			return 1
		end if
		if f_validatedw(this.id_header) < 0 then
			return 1
		end if
		if f_validatedw(this.id_detail) < 0 then
			return 1
		end if
		this.il_currrow = this.id_detail.rowcount()
		if this.ib_itemvalidated = false and wf_validateitem(ll_currrow) = -1 then
			return 1
		end if
		return
	end if
	if this.istr_ds.i_protect = 0 then
		this.istr_ds.i_closemode = 1
		this.istr_ds.ds.sharedata(this.id_detail)
	end if
	return 0

// w_visitprescription.close() returns long [event]
	triggerevent("ue_close")
	return ::message.returnvalue

// cb_getmodel.clicked() returns long [event]
	s_arguements lstr_arg
	open(w_arg_modelvisit)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 and parent.dw_detail.rowcount() > 0 and parent.dw_detail.object.icodet[parent.dw_detail.rowcount()] > 0 then
		parent.dw_detail.insertrow(0)
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_back.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return ::message.returnvalue

// cb_back.clicked() returns long [event]
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_header.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_header.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return ::message.returnvalue

// dw_header.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	return ::message.returnvalue

// dw_header.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	return ::message.returnvalue

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_rowm
	long ll_rowcount
	long ll_icode
	long ll_found
	if keyflags = 2 and key = keyb! then
		parent.post event ue_close(1)
	end if
	if parent.istr_ds.i_protect = 0 then
		if keyflags = 2 then
			if key = keyi! then
				if parent.ib_rowvalidated = false and parent.wf_validateitem(getrow()) = -1 then
					return ::message.returnvalue
				end if
				if getrow() > 0 and isnull(this.object.icode[getrow()]) then
					return ::message.returnvalue
				end if
				if rowcount() > 0 and f_validatedw(parent.id_detail) < 0 then
					return ::message.returnvalue
				end if
				ll_rowcount = insertrow(0)
				if ll_rowcount > 1 then
					scrolltorow(ll_rowcount)
					setcolumn("itemname")
					setfocus()
					parent.id_selectionlist.hide()
					parent.il_currrow = ll_rowcount
					parent.wf_set_header(ll_rowcount)
				end if
			elseif key = keyd! then
				parent.ib_rowvalidated = true
				if rowcount() > 0 then
					deleterow(0)
				end if
				ll_rowcount = rowcount()
				parent.il_currrow = ll_rowcount
				if ll_rowcount > 1 then
					scrolltorow(ll_rowcount)
					setcolumn("itemname")
					setfocus()
					parent.id_selectionlist.hide()
					parent.wf_set_header(ll_rowcount)
				end if
				parent.ib_rowvalidated = true
			end if
		end if
		if getcolumnname() = "itemname" then
			ll_rowm = getrow()
			setredraw(false)
			if key = keydownarrow! then
				parent.id_selectionlist.selectrow(0, false)
				parent.id_selectionlist.scrollnextrow()
				ll_listcurrrow = parent.id_selectionlist.getrow()
				rt_code = 1
			elseif key = keyuparrow! then
				parent.id_selectionlist.selectrow(0, false)
				parent.id_selectionlist.scrollpriorrow()
				ll_listcurrrow = parent.id_selectionlist.getrow()
				rt_code = 1
			elseif key = keypagedown! then
				parent.id_selectionlist.selectrow(0, false)
				parent.id_selectionlist.scrollnextpage()
				ll_listcurrrow = parent.id_selectionlist.getrow()
				rt_code = 1
			elseif key = keypageup! then
				parent.id_selectionlist.selectrow(0, false)
				parent.id_selectionlist.scrollpriorpage()
				ll_listcurrrow = parent.id_selectionlist.getrow()
				rt_code = 1
			elseif key = keyend! then
				parent.id_selectionlist.selectrow(0, false)
				parent.id_selectionlist.scrolltorow(99999)
				ll_listcurrrow = parent.id_selectionlist.getrow()
				rt_code = 1
			elseif key = keyhome! then
				parent.id_selectionlist.selectrow(0, false)
				parent.id_selectionlist.scrolltorow(1)
				ll_listcurrrow = parent.id_selectionlist.getrow()
				rt_code = 1
			elseif key = keyback! then
				parent.ib_bkspace = true
				setredraw(true)
			elseif key = keyescape! then
				if parent.id_selectionlist.visible = false then
					return ::message.returnvalue
				end if
				parent.id_selectionlist.hide()
				setfocus()
				setredraw(true)
			elseif key = keyf4! then
				parent.id_selectionlist.show()
				parent.id_selectionlist.selectrow(0, false)
				parent.id_selectionlist.scrolltorow(parent.il_itemlistfoundrow)
				parent.id_selectionlist.selectrow(parent.il_itemlistfoundrow, true)
				setredraw(true)
			elseif key = keyf5! then
				parent.id_selectionlist.hide()
				setredraw(true)
				ll_icode = f_drilldown_itemsearch("criteriasearch", 1)
				parent.id_selectionlist.setfilter("")
				parent.id_selectionlist.filter()
				if ll_icode > 0 then
					ll_found = parent.id_selectionlist.find("code = " + string(ll_icode), 1, parent.id_selectionlist.rowcount())
					if ll_found > 0 then
						ll_listcurrrow = ll_found
						parent.id_selectionlist.selectrow(0, false)
						parent.id_selectionlist.selectrow(ll_listcurrrow, true)
						rt_code = 1
					end if
				end if
				setfocus()
			elseif key = keyf6! then
				parent.id_selectionlist.hide()
				setredraw(true)
				ll_icode = f_drilldown_itemsearch("namesearch", 1)
				parent.id_selectionlist.setfilter("")
				parent.id_selectionlist.filter()
				if ll_icode > 0 then
					ll_found = parent.id_selectionlist.find("code = " + string(ll_icode), 1, parent.id_selectionlist.rowcount())
					if ll_found > 0 then
						ll_listcurrrow = ll_found
						parent.id_selectionlist.selectrow(0, false)
						rt_code = 1
					end if
				end if
				setfocus()
			elseif key = keyf7! then
				if not isnull(getitemnumber(ll_rowm, "icode")) then
					ll_icode = getitemnumber(ll_rowm, "icode")
					parent.id_selectionlist.hide()
					setredraw(true)
					ll_icode = f_prefered_itemsearch(ll_icode)
					parent.id_selectionlist.setfilter("")
					parent.id_selectionlist.filter()
					if ll_icode > 0 then
						ll_found = parent.id_selectionlist.find("code = " + string(ll_icode), 1, parent.id_selectionlist.rowcount())
						if ll_found > 0 then
							ll_listcurrrow = ll_found
							parent.id_selectionlist.selectrow(0, false)
							rt_code = 1
						end if
					end if
				end if
				setfocus()
			elseif isnull(getitemnumber(parent.id_detail.getrow(), "icode")) and key = keyenter! then
				parent.id_selectionlist.hide()
				parent.id_selectionlist.selectrow(0, false)
				parent.id_selectionlist.scrolltorow(parent.id_selectionlist.getrow())
				parent.id_selectionlist.selectrow(parent.id_selectionlist.getrow(), true)
				ll_listcurrrow = parent.id_selectionlist.getrow()
				setitem(ll_rowm, "icode", parent.id_selectionlist.getitemnumber(ll_listcurrrow, "code"))
				setitem(ll_rowm, "itemname", parent.id_selectionlist.getitemstring(ll_listcurrrow, "name"))
				selecttext(1, len(gettext()))
				parent.ib_itemvalidated = false
				parent.ib_rowvalidated = false
				setredraw(true)
			else
				setredraw(true)
			end if
			if rt_code = 1 then
				parent.id_selectionlist.selectrow(0, false)
				parent.id_selectionlist.selectrow(ll_listcurrrow, true)
				parent.il_itemlistfoundrow = ll_listcurrrow
				setitem(ll_rowm, "icode", parent.id_selectionlist.getitemnumber(ll_listcurrrow, "code"))
				setitem(ll_rowm, "itemname", parent.id_selectionlist.getitemstring(ll_listcurrrow, "name"))
				selecttext(1, len(gettext()))
				parent.ib_itemvalidated = false
				parent.ib_rowvalidated = false
				setredraw(true)
			end if
		end if
	end if
	return rt_code

// dw_detail.ue_enterkey() returns long [event]
	long ll_rowcount
	if getcolumnname() <> "details" then
		if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
			if parent.id_detail.rowcount() > 0 and f_validatedw(parent.id_detail) < 0 then
				return ::message.returnvalue
			end if
			if parent.ib_rowvalidated = false and parent.wf_validateitem(getrow()) = -1 then
				return 1
			end if
			ll_rowcount = parent.id_detail.insertrow(0)
			if ll_rowcount > 1 then
				parent.id_detail.scrolltorow(ll_rowcount)
				parent.id_detail.setcolumn("itemname")
				parent.id_detail.setfocus()
			end if
			return 1
		end if
		if getcolumnname() = "itemname" then
			parent.id_selectionlist.hide()
			if parent.ib_itemvalidated = false and parent.wf_validateitem(getrow()) = -1 then
				return 1
			end if
			return
		end if
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	choose case dwo.name
	case "itemname"
		messagebox("Item Validation", "Please enter valid Item Name")
	case "qty"
		messagebox("Qty Validation", "Please enter valid Qty")
	case "duration"
		messagebox("Duration Validation", "Please enter valid duration")
	end choose
	return 1

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	parent.wf_update_totalqty(row)
	if parent.ib_itemvalidated = false and parent.wf_validateitem(row) = -1 then
		parent.ib_itemvalidated = false
		parent.ib_rowvalidated = false
		return ::message.returnvalue
	end if
	choose case dwo.name
	case "itemname"
		if isnull(getitemnumber(row, "icode")) then
			parent.id_selectionlist.show()
		end if
	case else
		parent.id_selectionlist.hide()
	end choose
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	integer li_retcode
	long ll_icode
	long ll_null
	long ll_gcode
	string ls_itemname
	string ls_null
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case "dosagecode"
		parent.wf_dosageinfo(long(data), row)
		this.object.manualchangeintotqty[row] = 0
	case "itemname"
		setitem(row, "icode", parent.id_selectionlist.getitemnumber(parent.id_selectionlist.getrow(), "code"))
		setitem(row, "itemname", parent.id_selectionlist.getitemstring(parent.id_selectionlist.getrow(), "name"))
		parent.ib_itemvalidated = false
		parent.ib_rowvalidated = false
		parent.il_currrow = row
		li_retcode = 1
	case "qty"
		if double(data) <= 0.0 then
			messagebox("Qty Validation!", "Please enter valid Qty")
			return 1
		end if
		this.object.manualchangeintotqty[row] = 0
	case "totalqty"
		if double(data) <= 0.0 then
			messagebox("Total Qty Validation!", "Please enter valid Total Qty")
			return 1
		else
			this.object.manualchangeintotqty[row] = 1
		end if
	case "duration"
		if long(data) < 0 then
			messagebox("Duration Validation!", "Please enter a valid duration")
			return 1
		end if
		this.object.manualchangeintotqty[row] = 0
	case else
		parent.ib_rowvalidated = true
	end choose
	return li_retcode

// dw_detail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ll_currrow
	long ll_startrow
	ll_startrow = 0
	choose case dwo.name
	case "itemname"
		if upper(left(data, 1)) >= "A" and upper(left(data, 1)) <= "Z" or left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
			ll_currrow = parent.id_selectionlist.getrow()
			if len(data) > 1 then
				ll_startrow = ll_currrow
			else
				if left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
					ll_startrow = 1
				else
					ll_startrow = parent.ia_llookuptable[asc(upper(data))]
				end if
				parent.ib_bkspace = false
			end if
			if parent.ib_bkspace then
				parent.il_itemlistfoundrow = parent.id_selectionlist.find("Lower(name) <= '" + lower(data) + "'", ll_startrow, 0)
				parent.il_itemlistfoundrow = parent.il_itemlistfoundrow + 1
				parent.ib_bkspace = false
			else
				parent.il_itemlistfoundrow = parent.id_selectionlist.find("Lower(name) >= '" + lower(data) + "'", ll_startrow, 99999)
			end if
			if parent.il_itemlistfoundrow = 0 then
				parent.il_itemlistfoundrow = parent.id_selectionlist.rowcount()
			end if
			if parent.il_itemlistfoundrow <> ll_currrow then
				parent.id_selectionlist.selectrow(0, false)
				parent.id_selectionlist.setrow(parent.il_itemlistfoundrow)
				parent.id_selectionlist.scrolltorow(parent.il_itemlistfoundrow)
				parent.id_selectionlist.selectrow(parent.il_itemlistfoundrow, true)
				setfocus()
			elseif parent.il_itemlistfoundrow = ll_currrow then
				parent.id_selectionlist.selectrow(0, false)
				parent.id_selectionlist.setrow(parent.il_itemlistfoundrow)
				parent.id_selectionlist.scrolltorow(parent.il_itemlistfoundrow)
				parent.id_selectionlist.selectrow(parent.il_itemlistfoundrow, true)
				setfocus()
			end if
		end if
	end choose
	return ::message.returnvalue

// dw_detail.losefocus() returns long [event]
	parent.id_selectionlist.hide()
	return ::message.returnvalue

// dw_detail.rowfocuschanged(long currentrow) returns long [event]
	parent.wf_update_totalqty(currentrow)
	if parent.ib_itemvalidated = false and parent.wf_validateitem(getrow()) = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_detail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	choose case dwo.name
	case "b_details"
		parent.wf_show_rx_detail(row)
	end choose
	return ::message.returnvalue

// dw_detail.rowfocuschanging(long currentrow, long newrow) returns long [event]
	parent.wf_update_totalqty(currentrow)
	return ::message.returnvalue

// dw_selectionlist.ue_setfocus() returns 0 [event]
	parent.id_detail.setcolumn("itemname")
	parent.id_detail.setfocus()

// dw_selectionlist.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ll_rowmain
	if row > 0 then
		ll_rowmain = parent.id_detail.getrow()
		parent.id_detail.setitem(ll_rowmain, "icode", parent.id_selectionlist.getitemnumber(row, "code"))
		parent.id_detail.setitem(ll_rowmain, "itemname", parent.id_selectionlist.getitemstring(row, "name"))
		parent.id_detail.selecttext(1, len(gettext()))
		parent.ib_itemvalidated = false
		selectrow(0, false)
		selectrow(row, true)
		post event ue_setfocus()
	end if
	return ::message.returnvalue

// dw_selectionlist.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	post event ue_setfocus()
	return ::message.returnvalue
