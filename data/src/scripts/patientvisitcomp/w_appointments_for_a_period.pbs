// window w_appointments_for_a_period (patientvisitcomp)  ancestor: window

// w_appointments_for_a_period.wf_select_unselect_row() returns long
	long ll_oldrow
	ll_oldrow = this.ii_currow
	if this.dw_control.getrow() > 0 then
		this.dw_control.selectrow(ll_oldrow, false)
		this.ii_currow = this.dw_control.getrow()
		this.dw_control.selectrow(this.ii_currow, true)
		this.dw_control.setrow(this.ii_currow)
		this.dw_control.scrolltorow(this.ii_currow)
	end if
	return this.ii_currow

// w_appointments_for_a_period.wf_show_patientgallery() returns integer
	long ll_code
	if this.dw_control.rowcount() > 0 and this.dw_control.getrow() > 0 then
		ll_code = this.dw_control.object.patientcode[this.dw_control.getrow()]
		if ll_code > 0 then
			f_show_patient_gallary(ll_code)
		end if
	end if
	return 0

// w_appointments_for_a_period.wf_select_printout() returns long
	string ls_report
	if gs_company = "DRWAJIDALI" then
		ls_report = "d_visitprescription_print_drwajidali"
	elseif gs_company = "DRIRFANSB" then
		ls_report = "d_visitprescription_print_drirfansb"
	elseif gs_company = "DRSHUMAIL" then
		ls_report = "d_visitprescription_print_drshumail"
	elseif gs_company = "RASHIDNURSING" then
		ls_report = "d_visitprescription_print_rashidnursing"
	else
		ls_report = "d_visitprescription_print"
	end if
	this.dw_print.dataobject = ls_report
	return 0

// w_appointments_for_a_period.create() returns 0 [event]
	this.cb_print = create cb_print
	this.dw_print = create dw_print
	this.cb_cancel = create cb_cancel
	this.dw_control = create dw_control
	this.control = {this.cb_print, this.dw_print, this.cb_cancel, this.dw_control}

// w_appointments_for_a_period.destroy() returns 0 [event]
	destroy this.cb_print
	destroy this.dw_print
	destroy this.cb_cancel
	destroy this.dw_control

// w_appointments_for_a_period.open() returns long [event]
	long ll_width
	long ll_height
	long ll_code
	long ll_masteripartcode
	environment env
	this.is_arguements = message.powerobjectparm
	if getenvironment(env) <> 1 then
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.width = ll_width * 0.98
	this.height = ll_height * 0.90
	this.y = int((ll_height - this.height) / 2.0)
	this.dw_control.width = this.width * 0.98
	this.dw_control.height = this.height * 0.85
	this.cb_cancel.y = this.dw_control.y + this.dw_control.height + 10
	this.cb_print.y = this.dw_control.y + this.dw_control.height + 10
	this.dw_control.settransobject(sqlca)
	this.dw_control.retrieve(this.is_arguements.l_code1, this.is_arguements.d_sdate, this.is_arguements.d_edate)
	if this.dw_control.rowcount() > 0 then
		this.ii_currow = 1
		wf_select_unselect_row()
	else
		this.ii_currow = 0
	end if
	this.dw_print.settransobject(sqlca)
	setredraw(true)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_appointments_for_a_period.close() returns long [event]
	closewithreturn(this, this.is_arguements)
	return ::message.returnvalue

// cb_print.clicked() returns long [event]
	if parent.dw_control.visible then
		parent.dw_print.settransobject(sqlca)
		parent.dw_control.sharedata(parent.dw_print)
		if printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			parent.dw_print.printcancel()
		end if
		parent.dw_print.print()
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.is_arguements.i_status = 0
	parent.postevent(close!)
	return ::message.returnvalue

// dw_control.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	long ll_row
	long ll_retcode
	ancestorreturnvalue = super::doubleclicked(xpos, ypos, row, dwo)
	ll_row = getrow()
	if getrow() > 0 then
		parent.is_arguements.i_status = 1
		parent.is_arguements.l_code1 = this.object.appointmentcode[getrow()]
		parent.is_arguements.l_code2 = this.object.patientcode[getrow()]
		parent.is_arguements.s_name1 = this.object.regno[getrow()]
		parent.is_arguements.s_name2 = this.object.patientname[getrow()]
		parent.postevent(close!)
	end if
	return ll_retcode

// dw_control.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_rowm
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	ll_rowm = getrow()
	if key = keydownarrow! then
		selectrow(0, false)
		scrollnextrow()
		ll_listcurrrow = getrow()
		rt_code = 1
	elseif key = keyuparrow! then
		selectrow(0, false)
		scrollpriorrow()
		ll_listcurrrow = getrow()
		rt_code = 1
	elseif key = keypagedown! then
		selectrow(0, false)
		scrollnextpage()
		ll_listcurrrow = getrow()
		rt_code = 1
	elseif key = keypageup! then
		selectrow(0, false)
		scrollpriorpage()
		ll_listcurrrow = getrow()
		rt_code = 1
	elseif key = keyend! then
		selectrow(0, false)
		scrolltorow(99999)
		ll_listcurrrow = getrow()
		rt_code = 1
	elseif key = keyenter! then
		if rowcount() > 0 and getrow() <= 0 then
			parent.ii_currow = 1
			setrow(1)
			scrolltorow(1)
		end if
		ll_listcurrrow = getrow()
		rt_code = 1
		if getrow() > 0 then
			parent.is_arguements.l_code1 = this.object.appointmentcode[getrow()]
		end if
	elseif key = keyhome! then
		selectrow(0, false)
		scrolltorow(1)
		ll_listcurrrow = getrow()
		rt_code = 1
	end if
	if rt_code = 1 then
		parent.wf_select_unselect_row()
	end if
	return rt_code

// dw_control.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	if row > 0 then
		selectrow(0, false)
		scrolltorow(row)
		setrow(row)
		parent.wf_select_unselect_row()
		parent.ii_currow = row
	end if
	return ::message.returnvalue
