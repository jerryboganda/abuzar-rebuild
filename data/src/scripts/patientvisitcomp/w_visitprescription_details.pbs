// window w_visitprescription_details (patientvisitcomp)  ancestor: window

// w_visitprescription_details.ue_close(integer ai_status) returns 0 [event]
	this.istr_ds.i_closemode = ai_status
	if this.istr_ds.i_protect = 0 and ai_status = 1 then
		this.istr_ds.ds.sharedata(this.dw_detail)
	end if
	closewithreturn(this, this.istr_ds)

// w_visitprescription_details.ue_postopen() returns 0 [event]
	this.dw_detail.settransobject(sqlca)
	this.istr_ds.ds.sharedata(this.dw_detail)
	if this.dw_detail.rowcount() <= 0 then
		this.dw_detail.insertrow(0)
	end if
	wf_protectdw(this.dw_detail, this.istr_ds.i_protect)
	f_setcolumnstyle(this.dw_detail, "Qty")

// w_visitprescription_details.wf_validateserverdatetime(datetime ar_server_datetime, string ar_errtext) returns boolean
	datetime ldt_last_transdate
	datetime ldt_current_serverdate
	long li_max_allow_days
	ar_errtext = "Invoice Date  Check violates"
	li_max_allow_days = f_numberpreferences("MaxAllowDate")
	if isnull(li_max_allow_days) then
		li_max_allow_days = 4
	end if
	SQL SELECT LastTransDate INTO :ldt_last_transdate FROM ServerDate USING sqlca;
	if sqlca.sqlcode = 0 then
		sqlca.getdatetime(ldt_current_serverdate)
		if sqlca.sqlcode = 0 then
			if ldt_current_serverdate >= ldt_last_transdate and daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) <= li_max_allow_days then
				ar_server_datetime = ldt_current_serverdate
				return true
			elseif ldt_current_serverdate < ldt_last_transdate then
				ar_errtext = "Back Date Invoice Check violates"
				return false
			elseif daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) > li_max_allow_days then
				ar_errtext = "Forward Date Invoice Check violates"
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_visitprescription_details.wf_getserverdatetime(datetime ar_server_datetime, string ar_errtext) returns boolean
	datetime ldt_last_transdate
	datetime ldt_current_serverdate
	integer li_max_allow_days
	string ls_hold_serverdate
	date ld_datepart
	time lt_timepart
	ar_errtext = "Please verify Server DateTime"
	li_max_allow_days = f_numberpreferences("MaxAllowDate")
	if isnull(li_max_allow_days) then
		li_max_allow_days = 4
	end if
	SQL rollback USING sqlca;
	SQL SELECT LastTransDate INTO :ldt_last_transdate FROM ServerDate USING sqlca;
	if sqlca.sqlcode = 0 then
		sqlca.getdatetime(ldt_current_serverdate)
		if sqlca.sqlcode = 0 then
			if ldt_current_serverdate >= ldt_last_transdate and daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) <= li_max_allow_days then
				ld_datepart = date(string(ldt_current_serverdate, "yyyy-mm-dd"))
				lt_timepart = time(string(ldt_current_serverdate, "hh:mm:ss"))
				ldt_current_serverdate = datetime(ld_datepart, lt_timepart)
				SQL update ServerDate SET LastTransDate =:ldt_current_serverdate USING sqlca;
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					ar_server_datetime = ldt_current_serverdate
					return true
				else
					SQL rollback USING sqlca;
					return false
				end if
			elseif ldt_current_serverdate < ldt_last_transdate then
				ar_errtext = "Back Date Invoice Check violates"
				return false
			elseif daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) > li_max_allow_days then
				ar_errtext = "Forward Date Invoice Check violates"
				return false
			end if
		else
			SQL rollback USING sqlca;
			return false
		end if
		return
	end if
	SQL rollback USING sqlca;
	return false

// w_visitprescription_details.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_visitprescription_details.wf_dosageinfo(long al_dosagecode) returns long
	long ll_factor
	if al_dosagecode > 0 then
		SQL SELECT dosefactor INTO :ll_factor FROM Dosage WHERE DosageCode =:al_dosagecode USING sqlca;
	end if
	if sqlca.sqlcode = 0 and ll_factor > 0 then
		this.dw_detail.object.dosagefactor[1] = ll_factor
	end if
	return 0

// w_visitprescription_details.create() returns 0 [event]
	this.cb_back = create cb_back
	this.dw_detail = create dw_detail
	this.control = {this.cb_back, this.dw_detail}

// w_visitprescription_details.destroy() returns 0 [event]
	destroy this.cb_back
	destroy this.dw_detail

// w_visitprescription_details.open() returns long [event]
	long ll_row
	long ll_width
	long ll_height
	long ll_argpassed
	environment env
	if getenvironment(env) <> 1 then
		return ::message.returnvalue
	end if
	this.istr_ds.ds = ::message.powerobjectparm
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.x = int((ll_width - this.width) / 2.0)
	this.y = int((ll_height - this.height) / 2.0)
	post event ue_postopen()
	return ::message.returnvalue

// w_visitprescription_details.close() returns long [event]
	triggerevent("ue_close")
	return ::message.returnvalue

// cb_back.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_back.clicked() returns long [event]
	if f_validatedw(parent.dw_detail) < 0 then
		return ::message.returnvalue
	end if
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long [event]
	if parent.dw_detail.getcolumnname() <> "details" then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	choose case dwo.name
	case "qty"
		if long(data) <= 0 then
			messagebox("Qty Validation!", "Please enter valid Qty")
			return 1
		end if
	case "duration"
		if long(data) < 0 then
			messagebox("Duration Validation!", "Please enter a valid duration")
			return 1
		end if
	case "dosagecode"
		parent.wf_dosageinfo(long(data))
	end choose
	return ::message.returnvalue

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	choose case dwo.name
	case "qty"
		if long(data) <= 0 then
			messagebox("Qty Validation", "Please enter valid Qty")
		end if
	case "duration"
		if long(data) <= 0 then
			messagebox("Duration Validation", "Please enter valid Duration")
		end if
	end choose
	return 1

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	selecttext(1, len(gettext()))
	return ::message.returnvalue
