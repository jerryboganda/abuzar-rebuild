// window w_diseasetreatmenttemplate (patientvisitcomp)  ancestor: w_multi_entry

// w_diseasetreatmenttemplate.ue_enableprint() returns 0 [event]
	this.im_menu.m_file.m_print.enabled = true

// w_diseasetreatmenttemplate.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM DiseaseTreatmentTemp WHERE name =:as_name USING this.it_transobject;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_diseasetreatmenttemplate.wf_inititeminfo(long al_icode, long al_row, ref integer ai_rtcode, ref string as_errortext) returns boolean
	boolean retflag = true
	double ld_godownstock
	double ld_totalstock
	long li_discstatus
	long ll_qtysale
	long ll_bonus
	long ll_itemdesc_status
	integer li_gcode
	integer li_defaultgcode
	integer li_defaultgst
	integer li_custcode
	integer li_flatdiscstatus
	integer li_itemdiscpercno
	string ls_fullcode
	string ls_name
	string ls_null
	string ls_antinorcotix
	string ls_itemtotalval
	string ls_locksaleprice
	string ls_lockdiscperc
	string ls_remarks
	long ll_holdlooseqty
	long ll_desiredbonus
	setnull(ls_null)
	SQL SELECT item.customicode , item.name INTO :ls_fullcode, :ls_name FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if retflag then
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "icode", al_icode)
		if al_icode <> this.id_detail.getitemnumber(al_row, "itemcode") then
		end if
	else
		retflag = false
		as_errortext = "Item can not be sold, its Stock is Zero"
	end if
	this.id_detail.setitem(al_row, "itemcode", al_icode)
	return retflag

// w_diseasetreatmenttemplate.wf_validateitem() returns integer
	long ll_icode
	long ll_count
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	boolean lb_dupitem
	boolean lb_invalidrow
	integer li_null
	string ls_null
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if isnull(this.il_currrow) or this.il_currrow <= 0 then
		lb_invalidrow = true
		setnull(ll_icode)
	else
		ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	end if
	if not isnull(ll_icode) then
		if not wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
			ls_titleerrtext = "Item Validation"
		end if
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		ls_titleerrtext = "Item Validation"
		if lb_dupitem = true then
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.icode[this.il_currrow] = li_null
			this.id_detail.object.fullcode[this.il_currrow] = ls_null
			this.id_detail.object.itemname[this.il_currrow] = ls_null
			post event ue_deleteitem_row(this.il_currrow)
			for ll_count = 1 to this.id_detail.rowcount()
				if this.id_detail.getitemnumber(ll_count, "icode") = ll_icode then
					post event ue_scrolltorow(ll_count, "qty")
					exit
				end if
			next
			messagebox(ls_titleerrtext, ls_errtext)
		elseif lb_invalidrow = true then
			li_errcode = -1
		else
			messagebox(ls_titleerrtext, ls_errtext)
			if f_stringpreferences("itemcode") = "N" then
				this.id_detail.setcolumn(this.is_columnitemname)
				this.ib_itemslistopen = true
				this.id_itemslist.show()
			else
				this.id_detail.setcolumn("fullcode")
				this.id_detail.object.fullcode[this.il_currrow] = ls_null
			end if
			this.id_detail.scrolltorow(this.il_currrow)
			this.id_detail.object.icode[this.il_currrow] = li_null
			this.id_detail.object.itemname[this.il_currrow] = ls_null
			this.id_detail.object.qty[this.il_currrow] = 1
		end if
	end if
	return li_errcode

// w_diseasetreatmenttemplate.wf_isinvoiceinuse(long al_invoiceno) returns boolean
	long ll_found
	ll_found = 0
	SQL Select count ( *) INTO :ll_found From DiseaseTreatmentTemp With ( ReadPast , RowLock , UpdLock ) Where DiseaseTreatmentTempCode =:al_invoiceno USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_found = 0 then
			return true
		else
			return false
		end if
		return
	end if
	return false

// w_diseasetreatmenttemplate.wf_findfullcode(string as_fullcode, ref long al_icode, ref string al_itemname) returns integer
	integer ll_retflag
	long ll_icode
	long ll_groupcode
	string ls_itemname
	ll_groupcode = f_getgroupcode(gl_usercode)
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND ( item.Restricted ='N' OR ( Item.Restricted ='Y' AND Exists ( select *from grouprights where rightcode =515 and groupcode =:ll_groupcode ) ) ) AND item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item WHERE item.customicode =:as_fullcode AND item.Active =1 AND ( item.Restricted ='N' OR ( Item.Restricted ='Y' AND Exists ( select *from grouprights where rightcode =515 and groupcode =:ll_groupcode ) ) ) USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		al_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_diseasetreatmenttemplate.wf_deleteemptydetailrows() returns long
	long ll_count
	long ll_deletecount
	ll_deletecount = 0
	for ll_count = 1 to this.id_detail.rowcount()
		if isnull(this.id_detail.getitemnumber(ll_count, "icode")) or this.id_detail.getitemnumber(ll_count, "icode") = 0.0 then
			ll_deletecount = ll_deletecount + 1
			this.id_detail.deleterow(ll_count)
		end if
	next
	return ll_deletecount

// w_diseasetreatmenttemplate.wf_populatefiltereditems() returns long
	integer li_rtcode
	integer li_rtncode
	long ll_rtcode
	long ll_rowcount
	long ll_count
	long ll_icode
	long ll_currentrow
	long ll_found
	string as_errortext
	s_arguements lstr_selecteditems
	datastore lds_selecteditems
	if this.id_master.accepttext() = -1 then
		return -1
	end if
	open(w_arg_item_populate2)
	lstr_selecteditems = message.powerobjectparm
	lds_selecteditems = create datastore
	if lstr_selecteditems.s_name2 = "OR" then
		lds_selecteditems.dataobject = "d_populateditems_active_stockitems"
	else
		lds_selecteditems.dataobject = "d_populateditems_and_active_stockitems"
	end if
	lds_selecteditems.settransobject(sqlca)
	ll_rtcode = lds_selecteditems.retrieve(lstr_selecteditems.ia_integerlist, lstr_selecteditems.ia_integerlist1, lstr_selecteditems.ia_integerlist2, lstr_selecteditems.la_longlist, lstr_selecteditems.s_name1)
	ll_rowcount = lds_selecteditems.rowcount()
	wf_deleteemptydetailrow()
	setpointer(hourglass!)
	setredraw(false)
	if this.id_detail.rowcount() > 0 and isnull(this.id_detail.object.icode[this.id_detail.rowcount()]) then
		event ue_deleteitem()
	end if
	for ll_count = 1 to ll_rowcount
		ll_icode = lds_selecteditems.object.icode[ll_count]
		ll_found = this.id_detail.find("icode=" + string(ll_icode), 1, this.id_detail.rowcount())
		if not (ll_found > 0) then
			ll_currentrow = this.id_detail.insertrow(0)
			if wf_inititeminfo(ll_icode, ll_currentrow, li_rtncode, as_errortext) then
				this.id_detail.object.qty[ll_count] = 1
			end if
		end if
	next
	if this.id_detail.rowcount() > 0 then
		this.im_menu.m_file.m_save.enabled = true
	end if
	setredraw(true)
	setpointer(arrow!)
	return 0

// w_diseasetreatmenttemplate.wf_grandtotal() returns double
	return 0

// w_diseasetreatmenttemplate.wf_update_totalqty(long al_row) returns long
	double ld_qty
	double ld_totqty
	double ld_bsa
	long ll_dosageunitcode
	long ll_dosagecode
	long ll_dosagefactor
	long ll_duration
	if al_row > 0 and this.id_detail.object.manualchangeintotqty[al_row] = 0 then
		ld_qty = this.id_detail.object.qty[al_row]
		if isnull(ld_qty) then
			ld_qty = 0
		end if
		ll_dosagecode = this.id_detail.object.dosagecode[al_row]
		ll_dosagefactor = this.id_detail.object.dosagefactor[al_row]
		if isnull(ll_dosagefactor) then
			ll_dosagefactor = 1
		end if
		ll_duration = this.id_detail.object.duration[al_row]
		if isnull(ll_duration) then
			ll_duration = 0
		end if
		ld_totqty = ld_qty * ll_dosagefactor * ll_duration
		this.id_detail.object.totalqty[al_row] = round(ld_totqty, 4)
	end if
	return 0

// w_diseasetreatmenttemplate.wf_dosageinfo(long al_dosagecode, long al_row) returns long
	long ll_factor
	if al_dosagecode > 0 then
		SQL SELECT dosefactor INTO :ll_factor FROM Dosage WHERE DosageCode =:al_dosagecode USING sqlca;
	end if
	if sqlca.sqlcode = 0 and ll_factor > 0 then
		this.id_detail.object.dosagefactor[al_row] = ll_factor
	end if
	return 0

// w_diseasetreatmenttemplate.create() returns 0 [event]
	integer icurrent
	call super::create
	this.dw_analyzerprint = create dw_analyzerprint
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_analyzerprint

// w_diseasetreatmenttemplate.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_analyzerprint

// w_diseasetreatmenttemplate.ue_save() returns 0 [event]
	long ll_mastercurrrow
	long ll_invid
	long ll_detailrows
	integer li_counter
	integer ll_salesmancode
	boolean lb_commitflag = true
	dwitemstatus lds_rowstatus
	wf_deleteemptydetailrows()
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	setpointer(hourglass!)
	ll_mastercurrrow = this.id_master.getrow()
	ll_invid = this.id_master.object.code[ll_mastercurrrow]
	if isnull(ll_invid) then
		f_newtableid("DiseaseTreatmentTemp", ll_invid)
		this.id_master.object.code[ll_mastercurrrow] = ll_invid
	end if
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	do while li_counter <= ll_detailrows and lb_commitflag = true
		lds_rowstatus = this.id_detail.getitemstatus(li_counter, 0, primary!)
		if lds_rowstatus = newmodified! then
			this.id_detail.setitem(li_counter, "code", ll_invid)
		end if
		li_counter = li_counter + 1
	loop
	call super::ue_save
	setpointer(arrow!)

// w_diseasetreatmenttemplate.ue_detail() returns 0 [event]
	long ll_code
	call super::ue_detail
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	if wf_isinvoiceinuse(ll_code) = true then
		messagebox("Template Validation", "Template already in use by some other user.~r~nKindly try again after sometime or open some other template.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_delete.enabled = true
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true
	wf_grandtotal()

// w_diseasetreatmenttemplate.ue_newitem() returns 0 [event]
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	if f_stringpreferences("itemcode") = "Y" then
		this.id_detail.setcolumn("fullcode")
	else
		this.id_detail.setcolumn("itemname")
	end if
	call super::ue_newitem

// w_diseasetreatmenttemplate.ue_postopen() returns 0 [event]
	boolean lb_found
	integer li_rtncode
	long ll_counter
	long ll_found
	long ll_groupcode
	m_multi_entry lm_menu
	datastore lds_headers
	datawindowchild ldc_headerno
	call super::ue_postopen
	lm_menu = this.menuid
	gd_itemsinfo.sharedata(this.id_itemslist)
	lds_headers = create datastore
	lds_headers.dataobject = "d_groupallowedmoduleheader"
	lds_headers.settransobject(sqlca)
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = true
	this.id_itemslist.object.sstock.visible = true
	this.id_itemslist.object.t_pstock.visible = false
	this.id_itemslist.object.pstock.visible = false
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.sstock.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
		return
	end if
	this.id_itemslist.object.purprice.visible = false

// w_diseasetreatmenttemplate.ue_print() returns 0 [event]
	integer li_option
	long ll_custcode
	long ll_row
	long ll_printretcode
	long ll_invcode
	string ls_custname
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	this.id_print = this.tab_retrieve.tabpage_detail.dw_print
	this.id_print.dataobject = "d_diseasetreatmenttempalte_printout"
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		ll_printretcode = this.id_print.print()
		if ll_printretcode < 0 then
			messagebox("Printing", "Can not Print", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error.", "Can not Print,~r~nNo rows are retrieved", information!)

// w_diseasetreatmenttemplate.ue_list() returns 0 [event]
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_print.enabled = false
	post event ue_enableprint()

// w_diseasetreatmenttemplate.ue_newform() returns 0 [event]
	integer rtncode
	integer li_defaultgcode
	integer li_ismodifysaleprice
	integer li_ismodifyitemdiscperc
	integer li_ismodifyitemflatdisc
	integer li_modifysalestax
	integer li_modifybonusqty
	integer li_viewstock
	integer li_viewtotalstock
	long li_fetched_code
	long row
	long ll_manfcode
	long ll_counter
	long ll_custcode
	double ld_invdiscperc
	datetime ldt_server_datetime
	string ls_date_errtext
	m_multi_entry lm_menu
	call super::ue_newform
	lm_menu = this.menuid
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.im_menu.m_file.m_print.enabled = true
	this.id_detail.setredraw(false)
	this.id_detail.setredraw(true)
	if not wf_validatedate() then
		close(this)
		return
	end if
	this.id_master.setfocus()

// tabpage_detail.create() returns 0 [event]
	integer icurrent
	this.dw_print = create dw_print
	call super::create
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print

// tabpage_detail.destroy() returns 0 [event]
	call super::destroy
	destroy this.dw_print

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "name"
		if parent.parent.parent.wf_duplicatename(data) then
			messagebox("Name Validation", "Duplication Name Error~n~rPlease Choose Some Other Name")
			return 1
		end if
	end choose
	return ::message.returnvalue

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "itemname"
		if data = "" or isnull(data) then
			messagebox("ItemName Validation", "Value required ItemName in current row")
		end if
	case "qty"
		messagebox("Quantity Validation", "Please enter valid qty in current row")
	case "totalqty"
		messagebox("Total Quantity Validation", "Please enter valid Total Qty in current row")
	end choose
	return 1

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	long ll_icode
	long ll_null
	string ls_null
	string ls_itemname
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.id_detail.setitem(row, "icode", parent.parent.parent.id_itemslist.getitemnumber(parent.parent.parent.id_itemslist.getrow(), "icode"))
		parent.parent.parent.id_detail.setitem(row, "fullcode", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "fullcode"))
		parent.parent.parent.id_detail.setitem(row, "itemname", parent.parent.parent.id_itemslist.getitemstring(parent.parent.parent.id_itemslist.getrow(), "itemname"))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
		li_errcode = 0
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname)
			if li_res > 0 then
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = row
				li_errcode = 0
			else
				messagebox("ItemNumber Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_errcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_errcode = 2
		end if
	case "qty"
		if double(data) <= 0.0 then
			messagebox("Qty Validation!", "Please enter valid Qty")
			return 1
		end if
		this.object.manualchangeintotqty[row] = 0
	case "dosagecode"
		parent.parent.parent.wf_dosageinfo(long(data), row)
		this.object.manualchangeintotqty[row] = 0
	case "totalqty"
		if double(data) <= 0.0 then
			messagebox("Total Qty Validation!", "Please enter valid Total Qty")
			return 1
		else
			this.object.manualchangeintotqty[row] = 1
		end if
	case "duration"
		if long(data) < 0 then
			messagebox("Duration Validation!", "Please enter a valid duration")
			return 1
		end if
		this.object.manualchangeintotqty[row] = 0
	end choose
	return li_errcode

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	parent.parent.parent.wf_grandtotal()
	parent.parent.parent.wf_update_totalqty(row)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	if dwo.name = "itemname" then
		parent.parent.parent.ib_focusdetail = true
	end if
	if dwo.name = "qty" and parent.parent.parent.ib_itemslistopen then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
	end if
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	return 0

// dw_itemsdetail.getfocus() returns long [event]
	long ancestorreturnvalue
	if f_stringpreferences("itemcode") = "N" then
		ancestorreturnvalue = super::getfocus()
	end if
	return ::message.returnvalue

// dw_itemsdetail.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	long ll_icode
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if currentrow > 0 then
	end if
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	lrs_status = getitemstatus(currentrow, 0, primary!)
	if getcolumnname() <> parent.parent.parent.is_columnitemname and (rowcount() > 0 and lrs_status <> new!) and currentrow > 0 then
		ll_icode = this.object.icode[currentrow]
	end if
	return ::message.returnvalue
