// menu m_patientvisitmenu (patientvisitcomp)  ancestor: m_single_entry

// m_patientvisitmenu.create() returns 0 [event]
	m_patientvisitmenu = this
	call super::create
	this.text = "m_patientvisitmenu"

// m_patientvisitmenu.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_post = create m_post
	this.item[upperbound(this.item) + 1] = this.m_post

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_post

// m_post.create() returns 0 [event]
	call super::create
	this.text = "Post~tCtrl+E"
	this.shortcut = 325
	this.microhelp = "Post Visit"
	this.toolbaritemname = "DBAdmin!"
	this.toolbaritemdownname = "DBAdmin!"
	this.toolbaritemtext = "Post Visit"

// m_post.destroy() returns 0 [event]
	call super::destroy

// m_post.clicked() returns 0 [event]
	this.parentwindow.dynamic wf_post()
