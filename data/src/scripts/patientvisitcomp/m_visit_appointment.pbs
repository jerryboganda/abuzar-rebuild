// menu m_visit_appointment (patientvisitcomp)  ancestor: m_single_entry

// m_visit_appointment.create() returns 0 [event]
	m_visit_appointment = this
	call super::create

// m_visit_appointment.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_newpatientprofile = create m_newpatientprofile
	this.m_post = create m_post
	this.m_showappointments = create m_showappointments
	this.item[upperbound(this.item) + 1] = this.m_newpatientprofile
	this.item[upperbound(this.item) + 1] = this.m_post
	this.item[upperbound(this.item) + 1] = this.m_showappointments

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_newpatientprofile
	destroy this.m_post
	destroy this.m_showappointments

// m_newpatientprofile.clicked() returns 0 [event]
