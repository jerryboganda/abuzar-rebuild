// w_visit_form.ue_save() returns 0 [event]
	long ll_primarykey
	long ll_row
	long ll_counter
	long ll_usercode
	long ll_null
	long ll_primarycode_old
	long ll_patientcode
	datetime ldt_server_datetime
	string ls_date_errtext
	boolean lb_commit
	setnull(ll_null)
	setpointer(hourglass!)
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	ll_row = this.id_master.getrow()
	ll_primarykey = this.id_master.object.code[this.id_master.getrow()]
	ll_primarycode_old = ll_primarykey
	if not this.ib_modifydate then
		if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			return
		end if
		this.id_master.object.date[ll_row] = ldt_server_datetime
	end if
	if isnull(this.id_master.object.followupdays[ll_row]) or this.id_master.object.followupdays[ll_row] < 0 then
		this.id_master.object.followupdays[ll_row] = 0
	end if
	ll_patientcode = this.id_master.object.patientcode[ll_row]
	ll_usercode = gl_usercode
	if ll_usercode > 0 then
		if isnull(ll_primarykey) then
			ll_primarykey = 0
			SQL rollback USING this.it_transobject;
			wf_tabnewid("Visit", ll_primarykey)
			if this.it_transobject.sqlcode = 0 then
				this.id_master.setitem(ll_row, "code", ll_primarykey)
			else
				SQL rollback USING this.it_transobject;
				lb_commit = false
				messagebox("Patient Visit Problem", "Problem in Auto Generation of Patient Vist Code~r~n Possibe Reason: " + this.it_transobject.sqlerrtext)
			end if
		end if
		for ll_counter = 1 to this.id_image.rowcount()
			this.id_image.setitem(ll_counter, "code", ll_patientcode)
		next
		if lb_commit then
			this.id_master.setitem(ll_row, "usercode", ll_usercode)
			if this.id_master.update(true, false) < 0 then
				SQL rollback USING this.it_transobject;
				lb_commit = false
				messagebox("Patient Visit Problem", "Problem in updating Patient Visit.")
			end if
		end if
		if lb_commit then
			this.ids_visitvitals.object.code[1] = ll_primarykey
			if this.ids_visitvitals.update(true) < 0 then
				SQL rollback USING this.it_transobject;
				lb_commit = false
				messagebox("Patient Visit Problem", "Problem in updating Patient Vital Signs.")
			end if
		end if
		if lb_commit then
			if this.ids_visitsymptoms.rowcount() > 0 then
				for ll_counter = 1 to this.ids_visitsymptoms.rowcount()
					this.ids_visitsymptoms.object.code[ll_counter] = ll_primarykey
				next
			end if
			if this.ids_visitsymptoms.update(true) < 0 then
				SQL rollback USING this.it_transobject;
				lb_commit = false
				messagebox("Patient Visit Problem", "Problem in updating Patient Symptoms.")
			end if
		end if
		if lb_commit then
			if this.ids_visitphysicalexam.rowcount() > 0 then
				for ll_counter = 1 to this.ids_visitphysicalexam.rowcount()
					this.ids_visitphysicalexam.object.code[ll_counter] = ll_primarykey
				next
			end if
			if this.ids_visitphysicalexam.update(true) < 0 then
				SQL rollback USING this.it_transobject;
				lb_commit = false
				messagebox("Patient Visit Problem", "Problem in updating Patient Physical Exam.")
			end if
		end if
		if lb_commit then
			if this.ids_visitdiagnostics.rowcount() > 0 then
				for ll_counter = 1 to this.ids_visitdiagnostics.rowcount()
					this.ids_visitdiagnostics.object.code[ll_counter] = ll_primarykey
				next
			end if
			if this.ids_visitdiagnostics.update(true) < 0 then
				SQL rollback USING this.it_transobject;
				lb_commit = false
				messagebox("Patient Visit Problem", "Problem in updating Patient Diagnostics")
			end if
		end if
		if lb_commit then
			if this.ids_visitprescription.rowcount() > 0 then
				for ll_counter = 1 to this.ids_visitprescription.rowcount()
					this.ids_visitprescription.object.code[ll_counter] = ll_primarykey
				next
			end if
			if this.ids_visitprescription.update(true) < 0 then
				SQL rollback USING this.it_transobject;
				lb_commit = false
				messagebox("Patient Visit Problem", "Problem in updating Rx (Patient Prescription)")
			end if
		end if
		if lb_commit then
			if this.ids_visitprecaution.rowcount() > 0 then
				for ll_counter = 1 to this.ids_visitprecaution.rowcount()
					this.ids_visitprecaution.object.code[ll_counter] = ll_primarykey
				next
			end if
			if this.ids_visitprecaution.update(true) < 0 then
				SQL rollback USING this.it_transobject;
				lb_commit = false
				messagebox("Patient Visit Precaution Problem", "Problem in updating Visit Precaution")
			end if
		end if
		if lb_commit then
			SQL commit USING this.it_transobject;
			messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
			this.ib_commitok = true
			this.il_codevalue = ll_primarykey
			this.id_master.resetupdate()
			this.im_menu.m_file.m_new.enabled = true
			this.editflag = false
			if gd_recenttransdate < this.id_systemdate then
				gd_recenttransdate = this.id_systemdate
			end if
			if wf_update_image(ll_patientcode) = 0 then
				this.id_image.reset()
				this.istr_image = this.istr_blank_image
			end if
		end if
	end if
	if isnull(ll_primarycode_old) then
		this.id_master.setitem(ll_row, "code", ll_null)
	end if
	setpointer(arrow!)

// w_visit_form.ue_newitem() returns 0 [event]

// w_visit_form.ue_newform() returns 0 [event]
	string ls_date_errtext
	datetime ldt_server_datetime
	setredraw(false)
	this.i_editmode = 1
	this.i_retrievemode = 2
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_new.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_file.m_first.enabled = false
	this.im_menu.m_file.m_next.enabled = false
	this.im_menu.m_file.m_previous.enabled = false
	this.im_menu.m_file.m_last.enabled = false
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_retrieve.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.tab_retrieve.tabpage_detail.enabled = true
	if this.id_master.rowcount() > 0 then
		this.id_master.reset()
	end if
	this.ib_focusdetail = false
	this.id_master.insertrow(0)
	this.id_footer.insertrow(0)
	this.ids_visitvitals.insertrow(0)
	this.ids_visitvitals.reset()
	this.ids_visitsymptoms.reset()
	this.ids_visitphysicalexam.reset()
	this.ids_visitdiagnostics.reset()
	this.ids_visitprescription.reset()
	this.ids_visitprecaution.reset()
	this.ids_visitvitals.insertrow(0)
	wf_protectdw(this.id_master, 0)
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	if this.ib_modifydate then
		this.id_master.object.date.protect = 0
	else
		this.id_master.object.date.background.color = this.backcolor
		this.id_master.object.date.protect = 1
		this.id_master.settaborder("date", 0)
	end if
	wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
	this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
	this.id_master.selecttext(1, len(this.id_master.gettext()))
	wf_retrieve_appointments(this.id_master.object.doctcode[1])
	this.id_image.reset()
	setredraw(true)

// w_visit_form.ue_detail() returns 0 [event]
	long ll_code
	integer li_protect
	boolean lb_modify
	call super::ue_detail
	if this.id_list.getrow() > 0 then
		ll_code = this.id_list.object.code[this.id_list.getrow()]
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_post.enabled = false
	if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
		lb_modify = true
	end if
	if not lb_modify then
		this.im_menu.m_file.m_save.enabled = false
		this.editflag = false
	else
		li_protect = 0
	end if
	if this.id_master.object.patientcode[1] > 0 then
		this.id_image.retrieve(this.id_master.object.patientcode[1])
		wf_populate_image()
	end if
	wf_initmodify(li_protect, 0)
	wf_protectdw(this.id_master, li_protect)
	setredraw(true)

// w_visit_form.ue_list() returns 0 [event]
	call super::ue_list
	SQL rollback USING this.it_transobject;
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_post.enabled = true

// w_visit_form.ue_print() returns 0 [event]
	long ll_code
	long ll_row
	long li_printretcode
	string ls_printsize
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_code = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_code) or ll_code <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_code = this.id_detail.getitemnumber(1, "code")
		if isnull(ll_code) then
			ll_code = this.il_codevalue
		end if
	end if
	if gs_company = "DRWAJIDALI" then
		this.id_print.dataobject = "d_visitprescription_print_drwajidali"
	elseif gs_company = "DRIRFANSB" then
		this.id_print.dataobject = "d_visitprescription_print_drirfansb"
	elseif gs_company = "DRSHUMAIL" then
		this.id_print.dataobject = "d_visitprescription_print_drshumail"
	elseif gs_company = "RASHIDNURSING" then
		this.id_print.dataobject = "d_visitprescription_print_rashidnursing"
	else
		this.id_print.dataobject = "d_visitprescription_print"
	end if
	this.id_print.settransobject(sqlca)
	this.id_print.retrieve(ll_code)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.id_print.rowcount() > 0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		li_printretcode = this.id_print.print()
		if li_printretcode < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print,~r~nNo rows are retrieved", information!)

// tabpage_detail.create() returns 0 [event]
	integer icurrent
	this.dw_print = create dw_print
	call super::create
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print

// tabpage_detail.destroy() returns 0 [event]
	call super::destroy
	destroy this.dw_print

// dw_footer.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	choose case dwo.name
	case "b_vitalsign"
		parent.parent.parent.wf_show_visitvitals()
	case "b_diagnosis"
		parent.parent.parent.wf_show_visitsymptoms()
	case "b_physicalexam"
		parent.parent.parent.wf_show_visitphysicalexam()
	case "b_diagnostics"
		parent.parent.parent.wf_show_visitdiagnostics()
	case "b_rx"
		parent.parent.parent.wf_show_visitprescription()
	case "b_patienthistory"
		parent.parent.parent.wf_visithistory()
	case "b_search"
		parent.parent.parent.wf_patientsearch()
	case "b_registerpatient"
		parent.parent.parent.wf_registerpatient()
	case "b_precaution"
		parent.parent.parent.wf_show_visitprecaution()
	case "b_patientimage"
		parent.parent.parent.wf_setimage()
	end choose
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long [event]
	if getcolumnname() <> "diagnosis" then
		if getcolumnname() <> "previousdiagnosis" then
			if getcolumnname() <> "recommendations" then
				send(handle(this), 256, 9, long(90))
				return 1
			end if
		end if
	end if
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_patientcode
	long ll_res
	long ll_found
	long ll_count
	integer li_null
	datetime ldt_date_null
	date ld_followupdate
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ldt_date_null)
	setnull(li_null)
	choose case dwo.name
	case "doctcode"
		parent.parent.parent.wf_retrieve_appointments(long(data))
	case "appointmentcode"
		parent.parent.parent.wf_set_appointmentinfo(long(data))
	case "regno"
		if not isnull(data) and data <> "" then
			ll_res = parent.parent.parent.wf_findpatientcode(data, ll_patientcode)
			if ll_res > 0 then
				setitem(row, "patientcode", ll_patientcode)
			else
				if ll_res = -2 then
					messagebox("Patient Validation", "Patient with  RegNo  " + data + " is Inactive")
				else
					messagebox("Patient Validation", "Patient with  RegNo  " + data + " does not exist")
				end if
				return 1
			end if
			return
		end if
	case "patientcode"
		ll_patientcode = long(data)
		ll_found = parent.parent.parent.idc_patient.find("patientcode=" + trim(string(ll_patientcode)), 1, parent.parent.parent.idc_patient.rowcount())
		if ll_found > 0 then
			setitem(1, "regno", parent.parent.parent.idc_patient.getitemstring(parent.parent.parent.idc_patient.getrow(), "regno"))
		else
			messagebox("Patient Validation", "Patient does not exist or Already Inactive.")
			return 1
		end if
	case "followupdays"
		if long(data) < 0 or isnull(data) then
			messagebox("Patient Follow-up Days Validation", "Please enter valid Patient Follow-up Days.", stopsign!)
			return 1
		else
			ld_followupdate = relativedate(date(this.object.date[1]), long(data))
			SQL SELECT ISNULL ( COUNT ( V.VisitCode ) , :ld_followupdate ) INTO :ll_count FROM Visit V WHERE CAST ( CONVERT ( VARCHAR ( 100 ) , DateAdd ( dd , V.FollowUpDAys , V.Date ) , 101 ) AS DATETIME ) ={d '2024-11-08' } USING parent.parent.parent.it_transobject;
			if parent.parent.parent.it_transobject.sqlcode = 0 then
				this.object.followupdate[1] = ld_followupdate
				this.object.estimatedpatientcount[1] = ll_count
				if ll_count > this.object.maxestpatientcount[1] then
					ll_res = messagebox("Patient Follow-up Days Validation", "Estimated Patient Count is exceeding Maximum Daily Patients Limit.~r~nAllow this to happen?", question!, yesno!, 2)
					if ll_res = 1 then
						return 0
					else
						return 1
					end if
				else
					this.object.estimatedpatientcount[1] = ll_count
				end if
			else
				return 0
			end if
		end if
		return
	end choose
	return ::message.returnvalue
