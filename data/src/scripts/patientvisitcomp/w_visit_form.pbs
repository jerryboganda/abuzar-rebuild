		lm_menu.m_file.m_managepatientimages.enabled = true
	else
		lm_menu.m_file.m_managepatientimages.visible = false
		lm_menu.m_file.m_managepatientimages.enabled = false
		this.id_footer.object.b_patientimage.visible = 0
	end if
	if f_rightexists(5141) then
		lm_menu.m_file.m_visitprecautions.visible = true
		lm_menu.m_file.m_visitprecautions.enabled = true
		return
	end if
	lm_menu.m_file.m_visitprecautions.visible = false
	lm_menu.m_file.m_visitprecautions.enabled = false
