// w_visit_form.wf_lockvisits(long al_sinvcode, long al_linvcode, long al_totalcount) returns long
	SQL Select count ( *) INTO :al_totalcount From Visit WITH ( UPDLOCK HOLDLOCK ) Where VisitCode Between :al_sinvcode AND :al_linvcode AND Posted ='N' USING sqlca;
	return sqlca.sqlcode

// w_visit_form.wf_post() returns long
	integer ll_errcode
	long ll_usercode
	long ll_postcount
	long ll_counter
	boolean lb_flag
	s_arguements lstr_arginfo
	if this.tab_retrieve.selectedtab = 1 then
		return 0
	end if
	open(w_salesmanpassword)
	ll_usercode = long(message.doubleparm)
	setfocus()
	if ll_usercode > 0 then
		open(w_arg_sinvcode_linvcode_onedoctor)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			ll_errcode = wf_lockvisits(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_postcount)
			if ll_errcode = 0 then
				sqlca.postvisit(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_usercode, lstr_arginfo.l_code3)
				if sqlca.sqlcode <> 0 then
					ll_errcode = -1
				end if
			end if
		end if
		if ll_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				ll_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_usercode > 0 then
		if ll_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again")
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_postcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return ll_errcode

// w_visit_form.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_visit_form.wf_lockvisit(long al_visitcode) returns long
	integer li_count
	this.it_transobject.dbparm = " Async =1, DBGetTime = 20"
	this.it_transobject.lockvisit(al_visitcode)
	this.it_transobject.dbparm = "Async =0, DBGetTime = 0"
	return this.it_transobject.sqlcode

// w_visit_form.wf_show_visitprescription() returns long
	s_datastore lstr_ds
	if this.tab_retrieve.selectedtab = 1 then
		lstr_ds.ds = this.ids_visitprescription
		if this.ids_visitvitals.rowcount() > 0 then
			if this.ids_visitvitals.object.bsa[1] <= 0 or isnull(this.ids_visitvitals.object.bsa[1]) then
				lstr_ds.d_value = 1
			else
				lstr_ds.d_value = this.ids_visitvitals.object.bsa[1]
			end if
		else
			lstr_ds.d_value = 1
		end if
		lstr_ds.i_protect = integer(this.id_master.object.code.protect)
		openwithparm(w_visitprescription, lstr_ds)
		lstr_ds = message.powerobjectparm
		if lstr_ds.i_closemode = 1 and lstr_ds.i_protect = 0 then
			lstr_ds.ds.sharedata(this.ids_visitprescription)
		end if
	end if
	return 0

// w_visit_form.wf_patientsearch() returns string
	string ls_regno
	long ll_res
	long ll_null
	s_arguements ls_arguements
	setnull(ll_null)
	open(w_patientsearch)
	ls_arguements = message.powerobjectparm
	if ls_arguements.i_status = 1 then
		openwithparm(w_patientsearchresult, ls_arguements)
		ls_arguements = message.powerobjectparm
		if ls_arguements.i_status = 1 and ls_arguements.l_code1 > 0 then
			ll_res = wf_find_patient_regno(ls_arguements.l_code1, ls_regno)
			this.id_master.object.appointmentcode[this.id_master.rowcount()] = ll_null
			this.id_master.object.patientcode[this.id_master.rowcount()] = ls_arguements.l_code1
			this.id_master.object.regno[this.id_master.rowcount()] = ls_regno
		end if
	end if
	return ls_regno

// w_visit_form.wf_visithistory() returns long
	long ll_res
	long ll_null
	long ll_patientcode
	long ll_counter
	long ll_insrow
	s_arguements ls_arguements
	u_ds_standard lds_visit
	u_ds_standard lds_rx
	setnull(ll_null)
	if this.id_master.rowcount() > 0 then
		ll_patientcode = this.id_master.object.patientcode[this.id_master.rowcount()]
		if ll_patientcode > 0 then
			ls_arguements.l_code1 = ll_patientcode
			openwithparm(w_visithistory, ls_arguements)
			ls_arguements = message.powerobjectparm
			if ls_arguements.i_status = 1 and ls_arguements.l_code1 > 0 then
				lds_visit = create u_ds_standard
				lds_visit.dataobject = "d_visit_detail"
				lds_visit.settransobject(sqlca)
				lds_rx = create u_ds_standard
				lds_rx.dataobject = "d_visit_prescription"
				lds_rx.settransobject(sqlca)
				lds_visit.retrieve(ls_arguements.l_code1)
				if lds_visit.rowcount() > 0 then
					this.id_master.object.patientdetails[this.id_master.rowcount()] = lds_visit.object.patientdetails[lds_visit.rowcount()]
					this.id_master.object.referredby[this.id_master.rowcount()] = lds_visit.object.referredby[lds_visit.rowcount()]
					this.id_master.object.previousdiagnosis[this.id_master.rowcount()] = lds_visit.object.previousdiagnosis[lds_visit.rowcount()]
					this.id_master.object.diagnosis[this.id_master.rowcount()] = lds_visit.object.diagnosis[lds_visit.rowcount()]
					this.id_master.object.recommendations[this.id_master.rowcount()] = lds_visit.object.recommendations[lds_visit.rowcount()]
					this.id_master.object.remarks[this.id_master.rowcount()] = lds_visit.object.remarks[lds_visit.rowcount()]
					lds_rx.retrieve(ls_arguements.l_code1)
					if lds_rx.rowcount() > 0 then
						if this.ids_visitprescription.rowcount() > 0 and (isnull(this.ids_visitprescription.object.icode[this.ids_visitprescription.rowcount()]) or this.ids_visitprescription.object.icode[this.ids_visitprescription.rowcount()] = 0) then
							this.ids_visitprescription.setrow(this.ids_visitprescription.rowcount())
							this.ids_visitprescription.deleterow(0)
						end if
						for ll_counter = 1 to lds_rx.rowcount()
							ll_insrow = this.ids_visitprescription.insertrow(0)
							this.ids_visitprescription.object.icode[ll_insrow] = lds_rx.object.icode[ll_counter]
							this.ids_visitprescription.object.itemname[ll_insrow] = lds_rx.object.itemname[ll_counter]
							this.ids_visitprescription.object.date[ll_insrow] = lds_rx.object.date[ll_counter]
							this.ids_visitprescription.object.duration[ll_insrow] = lds_rx.object.duration[ll_counter]
							this.ids_visitprescription.object.diseasecode[ll_insrow] = lds_rx.object.diseasecode[ll_counter]
							this.ids_visitprescription.object.dosagecode[ll_insrow] = lds_rx.object.dosagecode[ll_counter]
							this.ids_visitprescription.object.dosagefactor[ll_insrow] = lds_rx.object.dosagefactor[ll_counter]
							this.ids_visitprescription.object.routecode[ll_insrow] = lds_rx.object.routecode[ll_counter]
							this.ids_visitprescription.object.inscode[ll_insrow] = lds_rx.object.inscode[ll_counter]
							this.ids_visitprescription.object.details[ll_insrow] = lds_rx.object.details[ll_counter]
							this.ids_visitprescription.object.qty[ll_insrow] = lds_rx.object.qty[ll_counter]
							this.ids_visitprescription.object.manualchangeintotqty[ll_insrow] = lds_rx.object.manualchangeintotqty[ll_counter]
							this.ids_visitprescription.object.dosageunitcode[ll_insrow] = lds_rx.object.dosageunitcode[ll_counter]
							this.ids_visitprescription.object.dosagestrength[ll_insrow] = lds_rx.object.dosagestrength[ll_counter]
							this.ids_visitprescription.object.totalqty[ll_insrow] = lds_rx.object.totalqty[ll_counter]
						next
					end if
				end if
			end if
		else
			messagebox("Patient Visit History", "Please select a patient first to view history")
		end if
	else
		messagebox("Patient Visit History...", "Please select a patient first to view history")
	end if
	return 0

// w_visit_form.wf_setimage() returns long
	long ll_counter
	long ll_code
	long ll_row
	s_itemimage lstr_image
	for ll_counter = 1 to this.id_image.rowcount()
		lstr_image.ls_value[ll_counter, 1] = trim(string(this.id_image.object.rowid[ll_counter]))
		lstr_image.ls_value[ll_counter, 2] = this.id_image.object.imagedescription[ll_counter]
		lstr_image.ls_value[ll_counter, 3] = this.id_image.object.imagetype[ll_counter]
		lstr_image.blob[ll_counter] = this.istr_image.blob[ll_counter]
	next
	openwithparm(w_patientimage, lstr_image)
	lstr_image = message.powerobjectparm
	if lstr_image.i_closemode = 1 then
		this.istr_image = lstr_image
		this.id_image.reset()
		ll_code = this.id_master.object.patientcode[this.id_master.rowcount()]
		for ll_counter = 1 to 200
			if long(lstr_image.ls_value[ll_counter, 1]) > 0 then
				ll_row = this.id_image.insertrow(0)
				this.id_image.object.code[ll_row] = ll_code
				this.id_image.object.rowid[ll_row] = long(lstr_image.ls_value[ll_counter, 1])
				this.id_image.object.imagedescription[ll_row] = lstr_image.ls_value[ll_counter, 2]
				this.id_image.object.imagetype[ll_row] = lstr_image.ls_value[ll_counter, 3]
			end if
		next
	end if
	return 0

// w_visit_form.wf_get_image(long al_code, long al_row) returns long
	blob lbl_image
	u_transaction lt_transobject
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server")
		destroy lt_transobject
		return -1
	end if
	SQL SelectBlob PatientImage INTO :lbl_image From PatientImage Where Patientcode =:al_code AND RowID =:al_row USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Patient Image/Picture ", "Unable to fetch patient Image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	this.istr_image.blob[al_row] = lbl_image
	return 0

// w_visit_form.wf_populate_image() returns long
	long ll_counter
	long ll_rowcount
	long ll_code
	ll_rowcount = this.id_image.rowcount()
	if ll_rowcount <= 0 then
		return 0
	end if
	ll_code = this.id_image.object.code[1]
	for ll_counter = 1 to ll_rowcount
		this.istr_image.ls_value[ll_counter, 1] = trim(string(this.id_image.object.rowid[ll_counter]))
		this.istr_image.ls_value[ll_counter, 2] = this.id_image.object.imagedescription[ll_counter]
		this.istr_image.ls_value[ll_counter, 3] = this.id_image.object.imagetype[ll_counter]
		wf_get_image(ll_code, ll_counter)
	next
	return 0

// w_visit_form.wf_update_image(long al_code) returns long
	long ll_counter
	long ll_code
	long ll_rowid
	string ls_desc
	string ls_imgtype
	u_transaction lt_transobject
	ll_code = al_code
	if al_code > 0 and this.id_image.rowcount() = 0 then
		return 0
	end if
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server for updating/inserting in PatientImage Table")
		destroy lt_transobject
		return -1
	end if
	SQL DELETE PatientImage WHERE PatientCode =:ll_code USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to Delete Previous Patient Image Record from database")
		destroy lt_transobject
		return -1
	end if
	for ll_counter = 1 to this.id_image.rowcount()
		ll_rowid = this.id_image.object.rowid[ll_counter]
		ls_desc = this.id_image.object.imagedescription[ll_counter]
		ls_imgtype = this.id_image.object.imagetype[ll_counter]
		SQL INSERT INTO PatientImage ( Patientcode , ImageDescription , RowID , ImageType ) VALUES ( :ll_code , :ls_desc , :ll_rowid , :ls_imgtype ) USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Insert Error", "Unable to Insert Patient Images Into Patient Image Table.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
			SQL stop USING lt_transobject;
			destroy lt_transobject
			return -1
		end if
		SQL UpdateBlob PatientImage Set PatientImage =:this.istr_image.blob[ll_counter] Where Patientcode =:ll_code and ROWID =:ll_rowid USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Patient Image ", "Unable to update Patient image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		end if
	next
	SQL stop USING lt_transobject;
	destroy lt_transobject
	return 0

// w_visit_form.wf_show_visitprecaution() returns long
	s_arguements lstr_arg
	long ll_counter
	long ll_upperlimit
	long ll_code
	long ll_insrow
	long ll_row
	long ll_rowcount
	if this.tab_retrieve.selectedtab = 1 then
		if this.id_master.rowcount() > 0 then
			ll_code = this.id_master.object.code[1]
		end if
		if integer(this.id_master.object.code.protect) = 1 then
			lstr_arg.i_hide = true
		else
			lstr_arg.i_hide = false
		end if
		if this.ids_visitprecaution.rowcount() > 0 then
			ll_row = 1
			for ll_counter = 1 to this.ids_visitprecaution.rowcount()
				if this.ids_visitprecaution.object.precautioncode[ll_counter] > 0 then
					lstr_arg.ia_integerlist[ll_row] = this.ids_visitprecaution.object.precautioncode[ll_counter]
					ll_row = ll_row + 1
				end if
			next
			lstr_arg.i_status = 1
		end if
		openwithparm(w_choose_precaution, lstr_arg)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = 1 then
			ll_rowcount = this.ids_visitprecaution.rowcount()
			if ll_rowcount > 0 then
				for ll_counter = 1 to ll_rowcount
					this.ids_visitprecaution.deleterow(0)
				next
			end if
			ll_upperlimit = upperbound(lstr_arg.ia_integerlist)
			for ll_counter = 1 to ll_upperlimit
				if lstr_arg.ia_integerlist[ll_counter] > 0 then
					ll_insrow = this.ids_visitprecaution.insertrow(0)
					this.ids_visitprecaution.object.code[ll_insrow] = ll_code
					this.ids_visitprecaution.object.precautioncode[ll_insrow] = lstr_arg.ia_integerlist[ll_counter]
				end if
			next
		end if
	end if
	return 0

// w_visit_form.wf_retrieve() returns long
	long rtcode
	rtcode = this.id_list.retrieve(gl_usercode)
	return rtcode

// w_visit_form.wf_initmodify(integer ai_protect, integer ai_flag) returns 0
	long ll_visitcode
	long ll_counter
	long ll_count
	ll_visitcode = this.id_master.getitemnumber(1, "code")
	if this.id_master.getitemstring(1, "posted") = "N" then
		if wf_lockvisit(ll_visitcode) <> 0 then
			messagebox("Cannot Modify", "Patient Visit is already in use")
		end if
	end if
	this.id_master.retrieve(ll_visitcode)
	this.ids_visitvitals.retrieve(ll_visitcode)
	this.ids_visitsymptoms.retrieve(ll_visitcode)
	this.ids_visitphysicalexam.retrieve(ll_visitcode)
	this.ids_visitdiagnostics.retrieve(ll_visitcode)
	this.ids_visitprescription.retrieve(ll_visitcode)
	this.ids_visitprecaution.retrieve(ll_visitcode)
	if this.id_master.object.appointmentcode[this.id_master.getrow()] > 0 and ai_flag = 0 then
		wf_set_appointmentinfo(this.id_master.object.appointmentcode[this.id_master.getrow()])
	end if
	if ai_protect = 0 then
		this.ib_modify = true
		this.im_menu.m_file.m_save.enabled = true
		this.im_menu.m_file.m_new.enabled = false
		this.im_menu.m_file.m_delete.enabled = false
		this.im_menu.m_item.m_newitem.enabled = false
		this.im_menu.m_item.m_deleteitem.enabled = false
		this.im_menu.m_file.m_first.enabled = false
		this.im_menu.m_file.m_next.enabled = false
		this.im_menu.m_file.m_previous.enabled = false
		this.im_menu.m_file.m_last.enabled = false
		this.im_menu.m_file.m_retrieve.enabled = true
		this.im_menu.m_file.m_retrieve.text = "Lis&t"
		this.tab_retrieve.tabpage_detail.enabled = true
	end if

// w_visit_form.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_visitmenu" then
		this.menuid = create m_visitmenu
	end if
	this.dw_image = create dw_image
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_image

// w_visit_form.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_image

// w_visit_form.open() returns long [event]
	m_visitmenu lm_menu
	long ll_width
