	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.tab_retrieve.width = ll_width * 0.99
	this.tab_retrieve.height = ll_height * 0.83
	this.tab_retrieve.tabpage_detail.dw_detail.width = ll_width * 0.97
	this.tab_retrieve.tabpage_detail.dw_footer.width = ll_width * 0.97
	this.tab_retrieve.tabpage_detail.dw_footer.y = this.tab_retrieve.height * 0.90 - this.tab_retrieve.tabpage_detail.dw_footer.height
	this.tab_retrieve.tabpage_detail.dw_detail.height = this.tab_retrieve.tabpage_detail.dw_footer.y - this.tab_retrieve.tabpage_detail.dw_detail.y - 5
	this.tab_retrieve.tabpage_list.gb_fliter.width = ll_width * 0.97 - this.tab_retrieve.tabpage_list.gb_sort.width
	this.tab_retrieve.tabpage_list.r_1.width = ll_width * 0.99
	this.tab_retrieve.tabpage_list.r_1.height = ll_height * 0.765 - this.tab_retrieve.tabpage_list.gb_sort.height
	this.tab_retrieve.tabpage_list.dw_list.width = ll_width * 0.98
	this.tab_retrieve.tabpage_list.dw_list.height = ll_height * 0.75 - this.tab_retrieve.tabpage_list.dw_list.y
	this.tab_retrieve.tabpage_detail.dw_itemslist.height = ll_height * 0.6
	this.tab_retrieve.tabpage_detail.dw_itemslist.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width * 0.73
	setredraw(true)
	return ::message.returnvalue

// w_visit_form.ue_postopen() returns 0 [event]
	long ll_rtncode
	long ll_found
	m_visitmenu lm_menu
	setredraw(false)
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	wf_connect()
	this.id_master = this.tab_retrieve.tabpage_detail.dw_detail
	this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
	this.id_footer = this.tab_retrieve.tabpage_detail.dw_footer
	this.id_list = this.tab_retrieve.tabpage_list.dw_list
	this.id_itemslist = this.tab_retrieve.tabpage_detail.dw_itemslist
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_itemslist.settransobject(this.it_transobject)
	this.id_dwcontrol = this.id_list
	post wf_populate_ddlb(this.id_dwcontrol)
	this.tab_retrieve.tabpage_list.dw_find.settransobject(this.it_transobject)
	this.id_master.setfocus()
	setredraw(true)
	ll_found = gds_securitywindow.find("rightcode = 5012", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.ib_modifydate = true
	end if
	ll_rtncode = this.id_master.getchild("patientcode", this.idc_patient)
	if ll_rtncode = -1 then
		messagebox("Patient Visit", "Problem in Retrieving Patient List")
		close(this)
		return
	end if
	this.idc_patient.settransobject(this.it_transobject)
	ll_rtncode = this.idc_patient.retrieve(this.ii_module)
	if ll_rtncode < 0 then
		messagebox("Patient Visit", "Not Enough Patient Categories Allowed for patient visit module~r~nPlease contact your system administrator")
		close(this)
		return
	end if
	ll_rtncode = this.id_master.getchild("doctcode", this.idc_doctor)
	if ll_rtncode = -1 then
		messagebox("Patient Visit", "Problem in Retrieving Doctors List")
		close(this)
		return
	end if
	this.idc_doctor.settransobject(this.it_transobject)
	ll_rtncode = this.idc_doctor.retrieve(gl_usercode)
	if ll_rtncode <= 0 then
		messagebox("Patient Visit", "Not Enough Doctor Allowed, Please contact your system administrator")
		close(this)
		return
	else
		this.id_master.object.doctcode.initial = string(this.idc_doctor.getitemnumber(1, "doctcode"))
	end if
	ll_rtncode = this.id_master.getchild("appointmentcode", this.idc_appointment)
	if ll_rtncode = -1 then
		messagebox("Patient Visit", "Problem in Retrieving Appointment List")
		close(this)
		return
	end if
	this.idc_appointment.settransobject(this.it_transobject)
	wf_retrieve_appointments(this.idc_doctor.getitemnumber(1, "doctcode"))
	this.id_print = this.tab_retrieve.tabpage_detail.dw_print
	this.id_print.settransobject(sqlca)
	this.ids_visitvitals = create u_ds_standard
	this.ids_visitvitals.dataobject = "d_visitvitals"
	this.ids_visitvitals.settransobject(this.it_transobject)
	this.ids_visitsymptoms = create u_ds_standard
	this.ids_visitsymptoms.dataobject = "d_visitsymptoms"
	this.ids_visitsymptoms.settransobject(this.it_transobject)
	this.ids_visitphysicalexam = create u_ds_standard
	this.ids_visitphysicalexam.dataobject = "d_visitphysicalexam"
	this.ids_visitphysicalexam.settransobject(this.it_transobject)
	this.ids_visitdiagnostics = create u_ds_standard
	this.ids_visitdiagnostics.dataobject = "d_visitdiagnostics"
	this.ids_visitdiagnostics.settransobject(this.it_transobject)
	this.ids_visitprescription = create u_ds_standard
	this.ids_visitprescription.dataobject = "d_visit_prescription"
	this.ids_visitprescription.settransobject(this.it_transobject)
	this.ids_visitprecaution = create u_ds_standard
	this.ids_visitprecaution.dataobject = "d_visit_precaution"
	this.ids_visitprecaution.settransobject(this.it_transobject)
	this.id_image = this.dw_image
	this.id_image.settransobject(this.it_transobject)
	if f_rightexists(5092) then
		lm_menu.m_file.m_patientinfo.visible = true
		lm_menu.m_file.m_patientinfo.enabled = true
	else
		lm_menu.m_file.m_patientinfo.visible = false
		lm_menu.m_file.m_patientinfo.enabled = false
		this.id_footer.object.b_registerpatient.visible = 0
	end if
	if f_rightexists(5093) then
		lm_menu.m_file.m_patientvitalsigns.visible = true
		lm_menu.m_file.m_patientvitalsigns.enabled = true
	else
		lm_menu.m_file.m_patientvitalsigns.visible = false
		lm_menu.m_file.m_patientvitalsigns.enabled = false
		this.id_footer.object.b_vitalsign.visible = 0
	end if
	if f_rightexists(5094) then
		lm_menu.m_file.m_patientdiagnosis.visible = true
		lm_menu.m_file.m_patientdiagnosis.enabled = true
	else
		lm_menu.m_file.m_patientdiagnosis.visible = false
		lm_menu.m_file.m_patientdiagnosis.enabled = false
		this.id_footer.object.b_diagnosis.visible = 0
	end if
	if f_rightexists(5095) then
		lm_menu.m_file.m_patientphysicalexam.visible = true
		lm_menu.m_file.m_patientphysicalexam.enabled = true
	else
		lm_menu.m_file.m_patientphysicalexam.visible = false
		lm_menu.m_file.m_patientphysicalexam.enabled = false
		this.id_footer.object.b_physicalexam.visible = 0
	end if
	if f_rightexists(5096) then
		lm_menu.m_file.m_patientdiagnostics.visible = true
		lm_menu.m_file.m_patientdiagnostics.enabled = true
	else
		lm_menu.m_file.m_patientdiagnostics.visible = false
		lm_menu.m_file.m_patientdiagnostics.enabled = false
		this.id_footer.object.b_diagnostics.visible = 0
	end if
	if f_rightexists(5097) then
		lm_menu.m_file.m_patientprescription.visible = true
		lm_menu.m_file.m_patientprescription.enabled = true
	else
		lm_menu.m_file.m_patientprescription.visible = false
		lm_menu.m_file.m_patientprescription.enabled = false
		this.id_footer.object.b_rx.visible = 0
	end if
	if f_rightexists(5098) then
		lm_menu.m_file.m_visithistory.visible = true
		lm_menu.m_file.m_visithistory.enabled = true
	else
		lm_menu.m_file.m_visithistory.visible = false
		lm_menu.m_file.m_visithistory.enabled = false
		this.id_footer.object.b_patienthistory.visible = 0
	end if
	if f_rightexists(5099) then
		lm_menu.m_file.m_patientsearch.visible = true
		lm_menu.m_file.m_patientsearch.enabled = true
	else
		lm_menu.m_file.m_patientsearch.visible = false
		lm_menu.m_file.m_patientsearch.enabled = false
