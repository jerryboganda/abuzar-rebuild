// window w_visit_form (patientvisitcomp)  ancestor: w_multi_entry

// w_visit_form.wf_find_patient_regno(long al_patientcode, string as_regno) returns long
	long ll_retflag
	char lc_active
	ll_retflag = 0
	SQL SELECT patient.regno , patient.active INTO :as_regno, :lc_active FROM patient WHERE patient.patientcode =:al_patientcode and patientcatcode in ( select distinct patientcatcode from patientcatallowedmodule where moduleid =:this.ii_module ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(as_regno) then
			ll_retflag = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
		else
			ll_retflag = -2
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_visit_form.wf_findpatientcode(string as_regno, long al_patientcode) returns long
	long ll_patientcode
	long ll_retflag
	string ls_itemname
	char lc_active
	ll_retflag = 0
	SQL SELECT patient.patientcode , patient.active INTO :ll_patientcode, :lc_active FROM patient WHERE patient.regno =:as_regno and patientcatcode in ( select distinct patientcatcode from patientcatallowedmodule where moduleid =:this.ii_module ) USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_patientcode = ll_patientcode
		if isnull(al_patientcode) then
			ll_retflag = 0
		elseif lc_active = "Y" then
			ll_retflag = 1
		else
			ll_retflag = -2
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_visit_form.wf_registerpatient() returns string
	string ls_regno
	long ll_res
	long ll_patientcode
	s_datatype lstr_datatype
	lstr_datatype.al_long = this.id_master.object.patientcode[this.id_master.rowcount()]
	openwithparm(w_patientregistration, lstr_datatype)
	ls_regno = message.stringparm
	this.id_master.object.regno[this.id_master.rowcount()] = ls_regno
	setpointer(hourglass!)
	this.idc_patient.setredraw(false)
	this.idc_patient.settransobject(this.it_transobject)
	this.idc_patient.retrieve(this.ii_module)
	this.idc_patient.setredraw(true)
	setpointer(arrow!)
	if ls_regno <> "" and not isnull(ls_regno) then
		ll_res = wf_findpatientcode(ls_regno, ll_patientcode)
		if ll_res > 0 then
			this.id_master.object.patientcode[this.id_master.rowcount()] = ll_patientcode
		end if
	end if
	return ls_regno

// w_visit_form.wf_show_visitvitals() returns long
	s_datastore lstr_ds
	if this.tab_retrieve.selectedtab = 1 then
		lstr_ds.ds = this.ids_visitvitals
		lstr_ds.i_protect = integer(this.id_master.object.code.protect)
		openwithparm(w_visitvitals, lstr_ds)
		lstr_ds = message.powerobjectparm
		if lstr_ds.i_protect = 0 and lstr_ds.i_closemode = 1 then
			lstr_ds.ds.sharedata(this.ids_visitvitals)
		end if
	end if
	return 0

// w_visit_form.wf_retrievelist() returns long
	return this.id_list.retrieve(gl_usercode)

// w_visit_form.wf_retrievelistall() returns long
	return this.id_list.retrieve(gl_usercode)

// w_visit_form.wf_retrieve_appointments(long al_doctcode) returns long
	long ll_rtncode
	long ll_maxestpatientcount
	if al_doctcode > 0 then
		ll_rtncode = this.idc_appointment.retrieve(al_doctcode)
		SQL SELECT ISNULL ( EstPatientCountPerDay , 0 ) INTO :ll_maxestpatientcount FROM DBO.Doctors WHERE DoctCode =:al_doctcode USING sqlca;
		if sqlca.sqlcode = 0 then
			this.id_master.object.maxestpatientcount[1] = ll_maxestpatientcount
		else
			messagebox("Doctor Validation", "Problem in fetching Doctor Estimated Patient Count. Details are:-~r~n" + sqlca.sqlerrtext, stopsign!)
		end if
	end if
	return ll_rtncode

// w_visit_form.wf_set_appointmentinfo(long al_appointmentcode) returns long
	long ll_found
	long ll_null
	long ll_visitcode
	integer li_protect
	boolean lb_modify
	string ls_null
	setnull(ll_null)
	setnull(ls_null)
	if isnull(al_appointmentcode) then
		this.id_master.object.regno.protect = 0
		this.id_master.object.patientcode.protect = 0
		this.id_master.object.regno[1] = ls_null
		this.id_master.object.patientcode[1] = ll_null
		this.id_master.object.patientdetails[1] = ls_null
		this.id_master.object.remarks[1] = ls_null
		this.id_master.object.diagnosis[1] = ls_null
		this.id_master.object.token[1] = ll_null
	else
		ll_found = 0
		ll_found = this.idc_appointment.find("code = " + string(al_appointmentcode) + "", 1, this.idc_appointment.rowcount())
		if ll_found > 0 then
			SQL SELECT MIN ( VisitCode ) INTO :ll_visitcode FROM Visit WHERE AppointmentCode =:al_appointmentcode USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ll_visitcode <= 0 or isnull(ll_visitcode) then
					triggerevent("ue_newform")
					if this.id_master.rowcount() > 0 then
						this.id_master.object.appointmentcode[1] = al_appointmentcode
						this.id_master.object.regno.protect = 1
						this.id_master.object.patientcode.protect = 1
						this.id_master.object.regno[1] = this.idc_appointment.getitemstring(ll_found, "regno")
						this.id_master.object.patientcode[1] = this.idc_appointment.getitemnumber(ll_found, "patientcode")
						this.id_master.object.patientdetails[1] = this.idc_appointment.getitemstring(ll_found, "patientname")
						this.id_master.object.remarks[1] = this.idc_appointment.getitemstring(ll_found, "remarks")
						this.id_master.object.referredby[1] = this.idc_appointment.getitemstring(ll_found, "referredby")
						this.id_master.object.token[1] = this.idc_appointment.getitemnumber(ll_found, "tokenno")
					end if
				else
					this.id_master.retrieve(ll_visitcode)
					if this.id_master.getitemstring(this.id_master.getrow(), "Posted") = "N" then
						lb_modify = true
					end if
					if not lb_modify then
						this.im_menu.m_file.m_save.enabled = false
						this.editflag = false
					else
						li_protect = 0
					end if
					if this.id_master.object.patientcode[1] > 0 then
						this.id_image.retrieve(this.id_master.object.patientcode[1])
						wf_populate_image()
					end if
					wf_initmodify(li_protect, 1)
					wf_protectdw(this.id_master, li_protect)
				end if
			end if
		end if
	end if
	return 0

