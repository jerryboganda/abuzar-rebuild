// w_patientvisit_list.wf_new_patientregistration() returns string
	string ls_regno
	long ll_patientcode
	long ll_found
	long ll_row
	dwobject dwo
	if f_rightexists(5102) then
		open(w_patientregistration)
		ls_regno = message.stringparm
		if not (ls_regno = "" or isnull(ls_regno)) then
			this.id_list.setredraw(false)
			this.id_list.retrieve()
			this.id_list.setredraw(true)
		end if
	end if
	return ls_regno

// w_patientvisit_list.wf_upload_image() returns long
	long ll_patientcode
	long ll_admissioncode
	long ll_rowid
	long ll_null
	string ls_imagedesc
	s_item_blob lstr_blob
	u_transaction lt_transobject
	if this.id_list.getrow() > 0 then
		ls_imagedesc = "ECG-" + string(today(), "dd/mm/yyyy hh:mm:ss")
		setnull(ll_null)
		ll_patientcode = this.id_list.object.code[this.id_list.getrow()]
		ll_admissioncode = this.id_list.object.admissioncode[this.id_list.getrow()]
		if ll_patientcode > 0 then
			setnull(lstr_blob.lb_blob)
			lstr_blob.s_name = "jpg"
			openwithparm(w_patientimage_rowid, lstr_blob)
			lstr_blob = message.powerobjectparm
			if lstr_blob.i_closemode = 1 then
				lt_transobject = create u_transaction
				lt_transobject.autocommit = true
				SQL start USING lt_transobject;
				if lt_transobject.sqlcode <> 0 then
					messagebox("Connection Error", "Unable to connect to DataBase server for updating/inserting in PatientImage Table")
					SQL stop USING lt_transobject;
					destroy lt_transobject
					return -1
				end if
				SQL SELECT MAX ( RowID ) INTO :ll_rowid FROM PatientImage WHERE PatientCode =:ll_patientcode USING lt_transobject;
				if lt_transobject.sqlcode = 0 then
					if ll_rowid = 0 or isnull(ll_rowid) then
						ll_rowid = 0
					end if
					ll_rowid = ll_rowid + 1
					SQL INSERT INTO PatientImage ( PatientCode , ImageDescription , RowID , ImageType , AdmissionCode , VisitCode ) VALUES ( :ll_patientcode , :ls_imagedesc , :ll_rowid , :lstr_blob.s_name , :ll_admissioncode , :ll_null ) USING lt_transobject;
					if lt_transobject.sqlcode = 0 then
						SQL UpdateBlob PatientImage Set PatientImage =:lstr_blob.lb_blob Where Patientcode =:ll_patientcode and ROWID =:ll_rowid USING lt_transobject;
						if lt_transobject.sqlcode <> 0 then
							messagebox("Patient Image ", "Unable to update Patient image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
							SQL stop USING lt_transobject;
							destroy lt_transobject
							return -1
						end if
					else
						messagebox("Insert Error", "Unable to Insert Patient Images Into Patient Image Table.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
						SQL stop USING lt_transobject;
						destroy lt_transobject
						return -1
					end if
				else
					messagebox("error", lt_transobject.sqlerrtext)
				end if
			end if
		end if
	end if
	return 0

// w_patientvisit_list.wf_retrieve() returns long
	long rtcode
	long ll_dayslimit
	datetime ld_date
	ll_dayslimit = f_numberpreferences("patientvisitretrievaldayslimit") * -1
	ld_date = datetime(relativedate(today(), ll_dayslimit))
	rtcode = this.id_list.retrieve(gl_usercode, ld_date)
	return rtcode

// w_patientvisit_list.wf_post() returns long
	integer ll_errcode
	long ll_usercode
	long ll_postcount
	long ll_counter
	boolean lb_flag
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_usercode = long(message.doubleparm)
	setfocus()
	if ll_usercode > 0 then
		open(w_arg_sinvcode_linvcode_onedoctor)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			ll_errcode = wf_lockvisits(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_postcount)
			if ll_errcode = 0 then
				sqlca.postvisit(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_usercode, lstr_arginfo.l_code3)
				if sqlca.sqlcode <> 0 then
					ll_errcode = -1
				end if
			end if
		end if
		if ll_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				ll_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_usercode > 0 then
		if ll_errcode <> 0 then
			messagebox("Posting Fails", "Some database request fails, Please try again")
		else
			messagebox("Posting Successfull", "Total unposted rows were " + string(ll_postcount) + "~n~rAll rows have been posted successfully")
		end if
	end if
	return ll_errcode

// w_patientvisit_list.wf_lockvisits(long al_sinvcode, long al_linvcode, long al_totalcount) returns integer
	SQL Select count ( *) INTO :al_totalcount From Visit WITH ( UPDLOCK HOLDLOCK ) Where VisitCode Between :al_sinvcode AND :al_linvcode AND Posted ='N' USING sqlca;
	return sqlca.sqlcode

// w_patientvisit_list.wf_retrieve(long retrievalarg) returns long
	long rtcode
	long ll_dayslimit
	datetime ld_date
	ll_dayslimit = f_numberpreferences("patientvisitretrievaldayslimit") * -1
	ld_date = datetime(relativedate(today(), ll_dayslimit))
	rtcode = this.id_list.retrieve(gl_usercode, ld_date)
	return rtcode

// w_patientvisit_list.create() returns 0 [event]
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_patientvisitmenu" then
		this.menuid = create m_patientvisitmenu
	end if

// w_patientvisit_list.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_patientvisit_list.ue_new() returns 0 [event]
	long ll_code
	call super::ue_new
	setnull(ll_code)
	wf_openmywindow(ll_code)

// w_patientvisit_list.ue_list() returns 0 [event]
	long ll_rtcode = 1
	m_patientvisitmenu lm_menu
	call super::ue_list
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	if this.id_list.rowcount() <= 0 then
		ll_rtcode = wf_retrieve()
	end if
	wf_populate_ddlb(this.id_list)
	if ll_rtcode > 0 then
		lm_menu.m_file.m_new.enabled = true
		lm_menu.m_file.m_save.enabled = false
		lm_menu.m_file.m_delete.enabled = false
		lm_menu.m_file.m_first.enabled = true
		lm_menu.m_file.m_next.enabled = true
		lm_menu.m_file.m_last.enabled = true
		lm_menu.m_file.m_print.enabled = true
		lm_menu.m_file.m_previous.enabled = true
		lm_menu.m_file.m_retrieve.text = "De&tail"
		this.i_retrievemode = 2
		this.i_editmode = 2
		if this.il_selectedrow = 0 then
			wf_first()
			wf_selectunselectrow(1)
		end if
		this.tab_retrieve.tabpage_list.dw_find.setfocus()
		return
	end if

// w_patientvisit_list.open() returns long [event]
	m_patientvisitmenu lm_menu
	long ll_width
	long ll_height
	long rtcode
	long ll_dayslimit
	datetime ld_date
	environment env
	ll_dayslimit = f_numberpreferences("patientvisitretrievaldayslimit") * -1
	ld_date = datetime(relativedate(today(), ll_dayslimit))
	this.it_transobject = sqlca
	postevent("ue_postopen")
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	lm_menu.mf_initsecurityapp(lm_menu)
	this.im_menu.m_file.m_save.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_file.m_previous.enabled = false
	this.im_menu.m_file.m_retrieve.text = "De&tail"
	this.id_list = this.tab_retrieve.tabpage_list.dw_list
	this.id_list.settransobject(this.it_transobject)
	this.id_list.retrieve(gl_usercode, ld_date)
	this.dw_print.dataobject = this.tab_retrieve.tabpage_list.dw_list.dataobject
	this.id_print = this.dw_print
	this.id_printlist = this.dw_listprint
	this.id_print.settransobject(this.it_transobject)
	this.id_printlist.settransobject(this.it_transobject)
	this.id_dwcontrol = this.id_list
	wf_populate_ddlb(this.id_dwcontrol)
	this.tab_retrieve.tabpage_list.dw_find.settransobject(this.it_transobject)
	if getenvironment(env) <> 1 then
		return ::message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.tab_retrieve.width = ll_width * 0.99
	this.tab_retrieve.height = ll_height * 0.83
	this.tab_retrieve.tabpage_list.gb_fliter.width = ll_width * 0.97 - this.tab_retrieve.tabpage_list.gb_sort.width
	this.tab_retrieve.tabpage_list.r_1.width = ll_width * 0.99
	this.tab_retrieve.tabpage_list.r_1.height = ll_height * 0.765 - this.tab_retrieve.tabpage_list.gb_sort.height
	this.tab_retrieve.tabpage_list.dw_list.width = ll_width * 0.98
	this.tab_retrieve.tabpage_list.dw_list.height = ll_height * 0.75 - this.tab_retrieve.tabpage_list.dw_list.y
	setredraw(true)
	this.is_sortsequence = "D"
	this.tab_retrieve.tabpage_list.rb_ascending.checked = false
	this.tab_retrieve.tabpage_list.rb_descending.checked = true
	wf_sortdw(this.tab_retrieve.tabpage_list.ddlb_sort.text, this.is_sortsequence)
	return ::message.returnvalue

// dw_list.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	long ll_code
	ancestorreturnvalue = super::doubleclicked(xpos, ypos, row, dwo)
	if row > 0 then
		ll_code = this.object.code[row]
		if ll_code > 0 then
			parent.parent.parent.wf_openmywindow(ll_code)
		end if
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_find.keypressed(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	s_arguements lstr_arg
	long ll_code
	long ll_found
	string ls_regno
	ancestorreturnvalue = super::keypressed(key, keyflags)
	if key = keyenter! and parent.parent.parent.id_list.getselectedrow(0) > 0 then
		ll_code = parent.parent.parent.id_list.object.code[parent.parent.parent.id_list.getselectedrow(0)]
		parent.parent.parent.wf_openmywindow(ll_code)
		return ::message.returnvalue
	end if
	if key = keyf5! then
		ls_regno = parent.parent.parent.wf_new_patientregistration()
		if len(trim(ls_regno)) > 0 then
			this.object.find[1] = ls_regno
			ll_found = parent.parent.parent.id_list.find("regno = '" + ls_regno + "'", 1, parent.parent.parent.id_list.rowcount())
			if ll_found > 0 and ll_found <= parent.parent.parent.id_list.rowcount() then
				parent.parent.parent.id_list.setrow(0)
				parent.parent.parent.id_list.setrow(ll_found)
				parent.parent.parent.id_list.selectrow(0, false)
				parent.parent.parent.id_list.scrolltorow(ll_found)
				parent.parent.parent.id_list.selectrow(ll_found, true)
				parent.parent.parent.il_selectedrow = ll_found
			end if
		end if
	end if
	if key = keyf7! then
		open(w_arg_sdate_ldate)
		lstr_arg = ::message.powerobjectparm
		if lstr_arg.i_status = 1 then
			openwithparm(w_appointtments_for_a_period, lstr_arg)
		end if
	end if
	if key = keyf9! then
		open(w_arg_sdate_ldate)
		lstr_arg = ::message.powerobjectparm
		if lstr_arg.i_status = 1 then
			openwithparm(w_visits_for_a_period, lstr_arg)
		end if
	end if
	return ::message.returnvalue
