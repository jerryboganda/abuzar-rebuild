// window w_patientvisit_list (patientvisitcomp)  ancestor: w_listview_form

// w_patientvisit_list.wf_openmywindow(long al_code) returns 0
	s_datatype lstr_datatype
	string ls_posted
	long ll_code
	long ll_visitcode
	long ll_retcode = 1
	if this.id_list.rowcount() > 0 and this.id_list.getrow() > 0 and al_code > 0 then
		ll_code = al_code
		SQL SELECT Code =ISNULL ( VisitCode , - 1 ) , posted INTO :ll_visitcode, :ls_posted FROM Visit WHERE VisitCode =:ll_code USING sqlca;
		if sqlca.sqlcode = 0 then
			lstr_datatype.al_long = ll_code
			if ls_posted = "Y" then
				lstr_datatype.ai_int = 1
			else
				lstr_datatype.ai_int = 0
			end if
			openwithparm(w_patientvisit_form, lstr_datatype)
		else
			messagebox("Database Problem", "Problem Fetching Patient Visit Record.~r~nDetails are:- " + sqlca.sqlerrtext, stopsign!)
		end if
		return
	end if
	setnull(ll_code)
	lstr_datatype.al_long = ll_code
	lstr_datatype.ai_int = 0
	openwithparm(w_patientvisit_form, lstr_datatype)

