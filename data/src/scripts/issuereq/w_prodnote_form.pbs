// dw_receipt.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "itemname"
		messagebox("Name Validation", "Please enter value for item Name")
	case "saleprice"
		messagebox("Price Validation", "Please enter valid value for saleprice")
	end choose
	return 1

// dw_receipt.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	string ls_errortext
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidated_receipt = false and parent.parent.parent.wf_validateitem_receipt(row) = -1 then
		parent.parent.parent.ib_itemvalidated_receipt = false
		parent.parent.parent.ib_rowvalidated_receipt = false
		return ::message.returnvalue
	end if
	if row > 0 then
		choose case dwo.name
		case "itemname"
			if isnull(getitemnumber(row, "icode")) then
				parent.parent.parent.id_selectionlist_receipt.show()
			else
				parent.parent.parent.wf_inititeminfo_receipt(getitemnumber(row, "icode"), row, ls_errortext)
			end if
		case "gcode"
			parent.parent.parent.wf_inititeminfo_receipt(getitemnumber(row, "icode"), row, ls_errortext)
			parent.parent.parent.id_selectionlist_receipt.hide()
		case "qty"
			parent.parent.parent.id_selectionlist_receipt.hide()
			parent.parent.parent.wf_inititeminfo_receipt(getitemnumber(row, "icode"), row, ls_errortext)
			parent.parent.parent.id_selectionlist_receipt.hide()
		case "remarks"
			parent.parent.parent.wf_inititeminfo_receipt(getitemnumber(row, "icode"), row, ls_errortext)
			parent.parent.parent.id_selectionlist_receipt.hide()
		end choose
	end if
	if len(gettext()) > 0 then
		selecttext(1, len(gettext()))
	end if
	return ::message.returnvalue

// dw_receipt.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.id_selectionlist_receipt.hide()
	return ::message.returnvalue

// dw_receipt.rowfocuschanging(long currentrow, long newrow) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::rowfocuschanging(currentrow, newrow)
	if parent.parent.parent.ib_itemvalidated_receipt = false and parent.parent.parent.wf_validateitem_receipt(getrow()) = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_receipt.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_rowm
	long ll_rowcount
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if parent.parent.parent.il_protect = 0 then
		if key = keyinsert! or keyflags = 2 and key = keyi! then
			if parent.parent.parent.ib_rowvalidated_receipt = false and parent.parent.parent.wf_validateitem_receipt(getrow()) = -1 then
				return ::message.returnvalue
			end if
			if rowcount() > 0 and f_validatedw(parent.parent.parent.id_receipt) < 0 then
				return ::message.returnvalue
			end if
			ll_rowcount = insertrow(0)
			parent.parent.parent.il_currrow_receipt = ll_rowcount
			if ll_rowcount > 0 then
				scrolltorow(ll_rowcount)
				setcolumn("itemname")
				setfocus()
				parent.parent.parent.il_currrow_receipt = ll_rowcount
			end if
		end if
		if keyflags = 2 and key = keyd! then
			parent.parent.parent.ib_rowvalidated_receipt = true
			if rowcount() > 0 then
				deleterow(0)
			end if
			ll_rowcount = rowcount()
			parent.parent.parent.il_currrow_receipt = ll_rowcount
			if ll_rowcount > 1 then
				scrolltorow(ll_rowcount)
				setcolumn("itemname")
				setfocus()
				parent.parent.parent.id_selectionlist_receipt.hide()
			end if
			parent.parent.parent.ib_rowvalidated_receipt = true
		end if
	end if
	if getcolumnname() = "itemname" then
		ll_rowm = getrow()
		setredraw(false)
		if key = keydownarrow! then
			parent.parent.parent.id_selectionlist_receipt.selectrow(0, false)
			parent.parent.parent.id_selectionlist_receipt.scrollnextrow()
			ll_listcurrrow = parent.parent.parent.id_selectionlist_receipt.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.parent.parent.id_selectionlist_receipt.selectrow(0, false)
			parent.parent.parent.id_selectionlist_receipt.scrollpriorrow()
			ll_listcurrrow = parent.parent.parent.id_selectionlist_receipt.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.parent.parent.id_selectionlist_receipt.selectrow(0, false)
			parent.parent.parent.id_selectionlist_receipt.scrollnextpage()
			ll_listcurrrow = parent.parent.parent.id_selectionlist_receipt.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.parent.parent.id_selectionlist_receipt.selectrow(0, false)
			parent.parent.parent.id_selectionlist_receipt.scrollpriorpage()
			ll_listcurrrow = parent.parent.parent.id_selectionlist_receipt.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.parent.parent.id_selectionlist_receipt.selectrow(0, false)
			parent.parent.parent.id_selectionlist_receipt.scrolltorow(99999)
			ll_listcurrrow = parent.parent.parent.id_selectionlist_receipt.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.parent.parent.id_selectionlist_receipt.selectrow(0, false)
			parent.parent.parent.id_selectionlist_receipt.scrolltorow(1)
			ll_listcurrrow = parent.parent.parent.id_selectionlist_receipt.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.parent.parent.ib_bkspacepod = true
			setredraw(true)
		elseif key = keyescape! then
			if parent.parent.parent.id_selectionlist_receipt.visible = false then
				return ::message.returnvalue
			end if
			parent.parent.parent.id_selectionlist_receipt.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf4! then
			parent.parent.parent.id_selectionlist_receipt.show()
			parent.parent.parent.id_selectionlist_receipt.selectrow(0, false)
			parent.parent.parent.id_selectionlist_receipt.scrolltorow(parent.parent.parent.id_selectionlist_receipt.getrow())
			parent.parent.parent.id_selectionlist_receipt.selectrow(parent.parent.parent.id_selectionlist_receipt.getrow(), true)
			setredraw(true)
		elseif isnull(getitemnumber(parent.parent.parent.id_receipt.getrow(), "icode")) and key = keyenter! then
			parent.parent.parent.id_selectionlist_receipt.hide()
			parent.parent.parent.id_selectionlist_receipt.selectrow(0, false)
			parent.parent.parent.id_selectionlist_receipt.scrolltorow(parent.parent.parent.id_selectionlist_receipt.getrow())
			parent.parent.parent.id_selectionlist_receipt.selectrow(parent.parent.parent.id_selectionlist_receipt.getrow(), true)
			ll_listcurrrow = parent.parent.parent.id_selectionlist_receipt.getrow()
			setitem(ll_rowm, "icode", parent.parent.parent.id_selectionlist_receipt.getitemnumber(ll_listcurrrow, "code"))
			setitem(ll_rowm, "fullcode", parent.parent.parent.id_selectionlist_receipt.getitemstring(ll_listcurrrow, "aliasname"))
			setitem(ll_rowm, "itemname", parent.parent.parent.id_selectionlist_receipt.getitemstring(ll_listcurrrow, "name"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated_receipt = false
			parent.parent.parent.ib_rowvalidated_receipt = false
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_selectionlist_receipt.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, "icode", parent.parent.parent.id_selectionlist_receipt.getitemnumber(ll_listcurrrow, "code"))
			setitem(ll_rowm, "fullcode", parent.parent.parent.id_selectionlist_receipt.getitemstring(ll_listcurrrow, "aliasname"))
			setitem(ll_rowm, "itemname", parent.parent.parent.id_selectionlist_receipt.getitemstring(ll_listcurrrow, "name"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated_receipt = false
			parent.parent.parent.ib_rowvalidated_receipt = false
			setredraw(true)
		end if
	end if
	return rt_code

// dw_receipt.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	long ll_rowcount
	ancestorreturnvalue = super::ue_enterkey()
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		if rowcount() > 0 and f_validatedw(this) < 0 then
			return ::message.returnvalue
		end if
		if parent.parent.parent.ib_rowvalidated_receipt = false and parent.parent.parent.wf_validateitem_receipt(getrow()) = -1 then
			return 1
		end if
		ll_rowcount = insertrow(0)
		if ll_rowcount > 1 then
			setrow(ll_rowcount)
			scrolltorow(ll_rowcount)
			if f_stringpreferences("itemcode") = "N" then
				setcolumn("itemname")
				parent.parent.parent.id_selectionlist.show()
			else
				setcolumn("fullcode")
				parent.parent.parent.id_selectionlist.hide()
			end if
			setfocus()
			parent.parent.parent.il_currrow_receipt = ll_rowcount
		end if
		return 1
	end if
	if getcolumnname() = "itemname" then
		parent.parent.parent.id_selectionlist.show()
		if parent.parent.parent.ib_itemvalidated_receipt = false and parent.parent.parent.wf_validateitem_receipt(getrow()) = -1 then
			return 1
		end if
		return
	end if
	send(handle(this), 256, 9, long(90))
	return 1
