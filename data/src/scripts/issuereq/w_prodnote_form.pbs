		setitem(row, "fullcode", parent.parent.parent.id_selectionlist_receipt.getitemstring(parent.parent.parent.id_selectionlist_receipt.getrow(), "aliasname"))
		setitem(row, "itemname", parent.parent.parent.id_selectionlist_receipt.getitemstring(parent.parent.parent.id_selectionlist_receipt.getrow(), "name"))
		parent.parent.parent.ib_itemvalidated_receipt = false
		parent.parent.parent.ib_rowvalidated_receipt = false
