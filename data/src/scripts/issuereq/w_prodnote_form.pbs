// w_prodnote_form.wf_validate_issue() returns long
	long ll_currrow
	long ll_counter
	long ll_null
	ll_currrow = this.id_issue.getrow()
	setnull(ll_null)
	if this.id_issue.rowcount() > 0 then
		if isnull(this.id_issue.getitemnumber(ll_currrow, "icode")) then
			if isnull(this.id_issue.getitemstring(ll_currrow, "itemname")) then
				this.id_issue.deleterow(ll_currrow)
			elseif this.ib_itemvalidated = false then
				messagebox("Item Validation", "Please Select Some Valid Item")
				this.id_issue.setcolumn("itemname")
				this.id_issue.scrolltorow(ll_currrow)
				this.id_issue.setfocus()
				return 1
			end if
		elseif this.ib_itemvalidated = false then
			messagebox("Item Validation", "Please Select Some Valid Item")
			this.id_issue.setcolumn("itemname")
			this.id_issue.scrolltorow(ll_currrow)
			this.id_issue.setfocus()
			return 1
		end if
		if f_validatedw(this.id_issue) < 0 then
			return 1
		end if
		this.il_currrow = this.id_issue.rowcount()
		if this.ib_itemvalidated = false and wf_validateitem(ll_currrow) = -1 then
			return 1
		end if
		return
	end if
	for ll_counter = 1 to this.id_issue.rowcount()
		this.id_issue.object.code[ll_counter] = this.il_code
	next
	return 0

// w_prodnote_form.wf_findfullcode(string as_fullcode, long al_icode, string as_itemname, long al_itemcodetype, double ad_qty, double ad_purprice, double ad_saleprice) returns long
	long ll_retflag
	setnull(al_icode)
	as_itemname = "                                                            "
	this.it_transobject.getaliasname_withqtyprice(gl_usercode, as_fullcode, al_icode, as_itemname, al_itemcodetype, ad_qty, ad_purprice, ad_saleprice)
	if this.it_transobject.sqlcode = 0 then
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_prodnote_form.wf_getassociatedgodown(long al_icode) returns integer
	integer li_gcode
	SQL Select Gcode INTO :li_gcode From item Where icode =:al_icode USING this.it_transobject;
	return li_gcode

// w_prodnote_form.wf_validategodown() returns long
	long ll_icode
	long ll_gcode
	long ll_stock
	long ll_counter
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	string ls_null
	integer li_errcode
	integer li_null
	integer li_option
	integer li_duperr
	boolean ib_due
	this.id_issue.accepttext()
	if this.il_currrow > 0 then
		ll_icode = this.id_issue.getitemnumber(this.il_currrow, "icode")
		this.ii_defaultgcode = this.id_issue.getitemnumber(this.il_currrow, "gcode")
		if wf_inititeminfo(this.id_issue, ll_icode, this.il_currrow, ls_errtext) <> 0 then
			if li_errcode = -2 then
				ls_titleerrtext = "Godown Validation"
				ls_errtext = "Stock is zero, please select some other Godown"
				li_errcode = -1
			elseif f_stringpreferences("AllowDuplicateItemInIssue") = "N" then
				for ll_counter = 1 to this.id_issue.rowcount()
					if this.il_currrow <> ll_counter and (ll_icode = this.id_issue.getitemnumber(ll_counter, "icode") and this.ii_defaultgcode = this.id_issue.getitemnumber(ll_counter, "gcode")) then
						li_duperr = -2
					end if
				next
			end if
		end if
		this.ib_godownvalidated = true
		if li_errcode = -1 and not ib_due then
			messagebox(ls_titleerrtext, ls_errtext)
			setnull(li_null)
			this.id_issue.setfocus()
			this.id_issue.setcolumn("gcode")
			this.id_issue.scrolltorow(this.il_currrow)
			this.id_issue.object.gcode[this.il_currrow] = li_null
		end if
		if li_duperr = -2 and not ib_due then
			ls_titleerrtext = "Item Validation"
			ls_errtext = "Duplicate Item, please select some other item"
			messagebox(ls_titleerrtext, ls_errtext)
			setnull(li_null)
			setnull(ls_null)
			this.id_issue.setcolumn("itemname")
			this.id_issue.scrolltorow(this.il_currrow)
			this.id_issue.object.gcode[this.il_currrow] = li_null
			this.id_issue.object.icode[this.il_currrow] = li_null
			this.id_issue.object.itemname[this.il_currrow] = ls_null
			this.id_selectionlist.show()
			li_errcode = -1
		end if
	end if
	return li_errcode

// w_prodnote_form.wf_inititeminfo(datawindow adw_dw, long al_icode, long al_row, string as_errortext) returns long
	long ll_retcode
	long ll_packunits
	long ll_totalpieces
	long ll_piecesinhand
	long ll_pricetypecode
	long ll_result
	integer li_gcode
	double ld_saleprice
	double ld_totalstock
	double ld_godownstock
	string ls_fullcode
	string ls_itemname
	boolean retflag
	ll_pricetypecode = f_numberpreferences("issuepricetypecode")
	SQL SELECT CustomICode , Name , saleprice =Round ( saleprice / CASE PackUnits WHEN 0 THEN 1 ELSE PackUnits END , 2 ) , PackUnits , TotalPieces =ISNULL ( TotalPieces , 0 ) INTO :ls_fullcode, :ls_itemname, :ld_saleprice, :ll_packunits, :ll_piecesinhand FROM item WHERE ICode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if this.il_issuegodowncount = 1 and this.ii_issuestrategy = 1 then
			li_gcode = adw_dw.getitemnumber(al_row, "gcode")
		else
			if this.ii_issuestrategy = 2 then
				li_gcode = wf_getassociatedgodown(al_icode)
			end if
			if this.ii_issuestrategy = 1 then
				li_gcode = adw_dw.getitemnumber(al_row, "gcode")
			end if
		end if
		this.it_transobject.getitemstockinallowedgodown(al_icode, this.il_groupcode, this.ii_issuestrategy, this.ii_issuemodule, ld_totalstock)
		if this.it_transobject.sqlcode <> 0 then
			retflag = false
			as_errortext = "Database Error: Item information can not be retrieved"
			ll_retcode = -1
		end if
		this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
		if this.it_transobject.sqlcode <> 0 then
			retflag = false
			as_errortext = "Database Error: Item information can not be retrieved"
			ll_retcode = -1
		end if
		if retflag then
			ll_retcode = 0
			adw_dw.setitem(al_row, "icode", al_icode)
			adw_dw.setitem(al_row, "fullcode", ls_fullcode)
			adw_dw.setitem(al_row, "itemname", ls_itemname)
			if adw_dw.getitemstatus(al_row, "price", primary!) = notmodified! then
				wf_setitemprice(al_icode, al_row, ll_pricetypecode)
			end if
			adw_dw.setitem(al_row, "packunits", ll_packunits)
			if isnull(ld_totalstock) then
				ld_totalstock = 0
			end if
			if isnull(ld_godownstock) then
				ld_godownstock = 0
			end if
			adw_dw.setitem(al_row, "godownstock", ld_godownstock)
			adw_dw.setitem(al_row, "totalstock", ld_totalstock)
			adw_dw.setitem(al_row, "piecesinhand", ll_piecesinhand)
			if ll_piecesinhand = 0 or isnull(ll_piecesinhand) then
				adw_dw.setitem(al_row, "totalpieces", 0)
			end if
			if ld_totalstock = 0.0 or ld_godownstock = 0.0 then
				as_errortext = "Cannot issue item : Item Stock is zero, please select some other item"
				ll_retcode = -2
			end if
		end if
	else
		as_errortext = "Database Error: Item information can not be retrieved"
		ll_retcode = -1
	end if
	return ll_retcode

// w_prodnote_form.wf_inititeminfo_receipt(long al_icode, long al_row, string as_errortext) returns long
	long ll_retcode
	long ll_packunits
	long ll_piecesinhand
	long ll_pricetypecode
	integer li_gcode
	double ld_saleprice
	double ld_totalstock
	double ld_godownstock
	double ld_unitweight
	string ls_fullcode
	string ls_itemname
	boolean retflag
	ll_pricetypecode = f_numberpreferences("receiptpricetypecode")
	SQL SELECT CustomICode , Name , saleprice =Round ( saleprice / CASE PackUnits WHEN 0 THEN 1 ELSE PackUnits END , 2 ) , PackUnits , TotalPieces =ISNULL ( TotalPieces , 0 ) , item.unitweight INTO :ls_fullcode, :ls_itemname, :ld_saleprice, :ll_packunits, :ll_piecesinhand, :ld_unitweight FROM item WHERE ICode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if this.il_issuegodowncount = 1 and this.ii_issuestrategy = 1 then
			li_gcode = this.id_receipt.getitemnumber(al_row, "gcode")
		else
			if this.ii_receiptstrategy = 2 then
				li_gcode = wf_getassociatedgodown(al_icode)
			end if
			if this.ii_receiptstrategy = 1 then
				li_gcode = this.id_receipt.getitemnumber(al_row, "gcode")
			end if
		end if
		this.it_transobject.getitemstockinallowedgodown(al_icode, this.il_groupcode, this.ii_receiptstrategy, this.ii_receiptmodule, ld_totalstock)
		if this.it_transobject.sqlcode <> 0 then
			retflag = false
			as_errortext = "Database Error: Item information can not be retrieved"
			ll_retcode = -1
		end if
		this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
		if this.it_transobject.sqlcode <> 0 then
			retflag = false
			as_errortext = "Database Error: Item information can not be retrieved"
			ll_retcode = -1
		end if
		if retflag then
			ll_retcode = 0
			this.id_receipt.setitem(al_row, "icode", al_icode)
			this.id_receipt.setitem(al_row, "fullcode", ls_fullcode)
			this.id_receipt.setitem(al_row, "itemname", ls_itemname)
			if this.id_receipt.getitemstatus(al_row, "price", primary!) = notmodified! then
				wf_setreceiptprice(al_icode, al_row, ll_pricetypecode)
			end if
			if ll_piecesinhand <= 0 or isnull(ll_piecesinhand) then
				ll_piecesinhand = 0
			end if
			this.id_receipt.setitem(al_row, "PiecesInHand", ll_piecesinhand)
			this.id_receipt.setitem(al_row, "packunits", ll_packunits)
			if isnull(ld_totalstock) then
				ld_totalstock = 0
			end if
			if isnull(ld_godownstock) then
				ld_godownstock = 0
			end if
			this.id_receipt.setitem(al_row, "godownstock", ld_godownstock)
			this.id_receipt.setitem(al_row, "totalstock", ld_totalstock)
			this.id_receipt.setitem(al_row, "unitweight", ld_unitweight)
		end if
	else
		as_errortext = "Database Error: Item information can not be retrieved"
		ll_retcode = -1
	end if
	return ll_retcode

// w_prodnote_form.wf_print_note() returns integer
	s_datastore lstr
	if this.ib_print = true then
		if gs_company = "ALNASEEB" then
			this.dw_print.dataobject = "d_alnaseeb_prodnote_print_full"
		else
			this.dw_print.dataobject = "d_prodnote_print_full"
		end if
		this.dw_print.settransobject(sqlca)
		this.dw_print.retrieve(this.il_code)
		lstr.dw = this.dw_print
		lstr.s_name1 = this.dw_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return 0
		else
			if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
				messagebox("Printer", "Printing Error")
				this.dw_print.printcancel()
			end if
			if this.dw_print.rowcount() > 0 then
				if this.dw_print.print() < 0 then
					messagebox("Printing", "Can not Print Invoice", information!)
				end if
			else
				messagebox("Printing Error", "Can not Print Data,~r~nNo rows are retrieved", information!)
			end if
		end if
	end if
	return 0

// w_prodnote_form.wf_setitemprice(long al_icode, long al_row, long al_pricetypecode) returns long
	long ll_retcode
	long ll_packunits
	double ld_saleprice1
	double ld_saleprice2
	double ld_saleprice3
	double ld_saleprice4
	double ld_saleprice5
	double ld_avgprice
	double ld_rpp
	double ld_purprice
	string ls_alternatecustomicode
	string ls_null
	string ls_fullcode
	setnull(ls_null)
	SQL SELECT ROUND ( item.saleprice / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) , ROUND ( item.saleprice2 / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) , ROUND ( item.saleprice3 / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) , item.avgprice , item.packunits , ROUND ( item.purprice / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) , ROUND ( item.recentpurprice / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) , ROUND ( item.saleprice4 / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) , ROUND ( item.saleprice5 / CASE item.packunits WHEN 0 THEN 1 ELSE item.packunits END , 2 ) INTO :ld_saleprice1, :ld_saleprice2, :ld_saleprice3, :ld_avgprice, :ll_packunits, :ld_purprice, :ld_rpp, :ld_saleprice4, :ld_saleprice5 FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if this.it_transobject.sqlcode = -1 then
		ll_retcode = -1
		return ll_retcode
	end if
	if not (this.it_transobject.sqlcode = 100) then
		ls_fullcode = this.id_issue.object.fullcode[al_row]
		choose case al_pricetypecode
		case 1
			this.id_issue.setitem(al_row, "price", ld_saleprice1)
		case 2
			this.id_issue.setitem(al_row, "price", ld_saleprice2)
		case 3
			this.id_issue.setitem(al_row, "price", ld_saleprice3)
		case 7
			this.id_issue.setitem(al_row, "price", ld_saleprice4)
		case 8
			this.id_issue.setitem(al_row, "price", ld_saleprice5)
		case 4
			this.id_issue.setitem(al_row, "price", ld_purprice)
		case 5
			this.id_issue.setitem(al_row, "price", ld_rpp)
		case else
			this.id_issue.setitem(al_row, "price", ld_avgprice)
		end choose
		ll_retcode = 0
	else
		ll_retcode = -2
	end if
	return ll_retcode

