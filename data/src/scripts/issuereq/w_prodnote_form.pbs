// w_prodnote_form.wf_set_itemexpense_interface() returns long
	string ls_col
	long ll_len
	long ll_acccode
	long ll_cracccode
	datastore lds_exp
	if this.il_groupcode > 0 then
		lds_exp = create datastore
		lds_exp.dataobject = "d_groupitemreceiptexptemplate_detail"
		lds_exp.settransobject(this.it_transobject)
		lds_exp.retrieve(this.il_groupcode)
		if lds_exp.rowcount() = 0 then
			this.id_receipt.object.qe1.visible = false
			this.id_receipt.object.c_qe1.visible = false
			this.id_receipt.object.qe2.visible = false
			this.id_receipt.object.c_qe2.visible = false
			this.id_receipt.object.qe3.visible = false
			this.id_receipt.object.c_qe3.visible = false
			this.id_receipt.object.qe4.visible = false
			this.id_receipt.object.c_qe4.visible = false
			this.id_receipt.object.qe5.visible = false
			this.id_receipt.object.c_qe5.visible = false
			this.id_receipt.object.we1.visible = false
			this.id_receipt.object.c_we1.visible = false
			this.id_receipt.object.we2.visible = false
			this.id_receipt.object.c_we2.visible = false
			this.id_receipt.object.we3.visible = false
			this.id_receipt.object.c_we3.visible = false
			this.id_receipt.object.we4.visible = false
			this.id_receipt.object.c_we4.visible = false
			this.id_receipt.object.we5.visible = false
			this.id_receipt.object.c_we5.visible = false
			this.id_receipt.object.c_itemexpenses.visible = false
		else
			ls_col = lds_exp.object.qexp1_caption[1]
			ll_acccode = lds_exp.object.qexp1_acccode[1]
			ll_cracccode = lds_exp.object.qexp1_cracccode[1]
			ll_len = len(ls_col)
