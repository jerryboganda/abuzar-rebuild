			end if
			ls_col = lds_exp.object.wexp3_caption[1]
			ll_acccode = lds_exp.object.wexp3_acccode[1]
			ll_cracccode = lds_exp.object.wexp3_cracccode[1]
			ll_len = len(ls_col)
			if ll_len > 0 and ll_acccode > 0 then
				this.id_receipt.object.we3_t.text = ls_col
				this.id_receipt.object.c_we3_t.text = ls_col + " Total"
				this.id_header.object.we3_acccode.initial = trim(string(ll_acccode))
				this.id_header.object.wexp3_cracccode.initial = trim(string(ll_cracccode))
			else
				this.id_receipt.object.we3.visible = false
				this.id_receipt.object.c_we3.visible = false
			end if
			ls_col = lds_exp.object.wexp4_caption[1]
			ll_acccode = lds_exp.object.wexp4_acccode[1]
			ll_cracccode = lds_exp.object.wexp4_cracccode[1]
			ll_len = len(ls_col)
			if ll_len > 0 and ll_acccode > 0 then
				this.id_receipt.object.we4_t.text = ls_col
				this.id_receipt.object.c_we4_t.text = ls_col + " Total"
				this.id_header.object.we4_acccode.initial = trim(string(ll_acccode))
				this.id_header.object.wexp4_cracccode.initial = trim(string(ll_cracccode))
			else
				this.id_receipt.object.we4.visible = false
				this.id_receipt.object.c_we4.visible = false
			end if
			ls_col = lds_exp.object.wexp5_caption[1]
			ll_acccode = lds_exp.object.wexp5_acccode[1]
			ll_cracccode = lds_exp.object.wexp5_cracccode[1]
			ll_len = len(ls_col)
			if ll_len > 0 and ll_acccode > 0 then
				this.id_receipt.object.we5_t.text = ls_col
				this.id_receipt.object.c_we5_t.text = ls_col + " Total"
				this.id_header.object.we5_acccode.initial = trim(string(ll_acccode))
				this.id_header.object.wexp5_cracccode.initial = trim(string(ll_cracccode))
			else
				this.id_receipt.object.we5.visible = false
				this.id_receipt.object.c_we5.visible = false
			end if
		end if
	end if
	return 0

// w_prodnote_form.create() returns 0 [event]
	this.cb_print = create cb_print
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.tab_main = create tab_main
	this.dw_image = create dw_image
	this.dw_print = create dw_print
	this.dw_dischargeslip = create dw_dischargeslip
	this.control = {this.cb_print, this.cb_cancel, this.cb_ok, this.tab_main, this.dw_image, this.dw_print, this.dw_dischargeslip}

// w_prodnote_form.destroy() returns 0 [event]
	destroy this.cb_print
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.tab_main
	destroy this.dw_image
	destroy this.dw_print
	destroy this.dw_dischargeslip

// w_prodnote_form.open() returns long [event]
	integer li_xpos
	integer li_ypos
	integer li_xendpos
	integer li_counter
	integer li_taborder
	integer li_visiblecolumns
	integer li_zerotaborder
	long ll_counter
	long li_retcode
	long li_rtncode
	boolean lb_active
	boolean lb_restricted
	boolean lb_customicode
	boolean lb_zerotabordercol
	date ld_date
	long ll_retcode
	ld_date = today()
	this.istr_datatype = message.powerobjectparm
	this.il_protect = this.istr_datatype.ai_int
	this.il_code = this.istr_datatype.al_long
	this.it_transobject = create u_transaction
	if wf_connect() <> 0 then
		messagebox("Connection Failure", "Unable to connect to the database", stopsign!)
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	this.il_groupcode = f_getgroupcode(gl_usercode)
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	this.ii_issuestrategy = f_groupgodownstrategy(this.ii_issuemodule, this.il_groupcode)
	this.il_issuegodowncount = f_groupallowedgodowncount(this.ii_issuemodule, this.il_groupcode)
	if isnull(this.il_issuegodowncount) or this.il_issuegodowncount = 1 and this.il_issuegodowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit Issue of Stock")
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	this.ii_receiptstrategy = f_groupgodownstrategy(this.ii_receiptmodule, this.il_groupcode)
	this.il_receiptgodowncount = f_groupallowedgodowncount(this.ii_receiptmodule, this.il_groupcode)
	if isnull(this.il_receiptgodowncount) or this.il_receiptgodowncount = 1 and this.il_receiptgodowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit Receipt of Stock")
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	wf_retrieve_tabs()
	wf_apply_protect_setting()
	wf_set_interface_adjustments()
	wf_set_tab_visibility()
	wf_set_itemexpense_interface()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_print.clicked() returns long [event]
	parent.ib_print = true
	parent.wf_save()
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.postevent("ue_close")
	return ::message.returnvalue

// cb_ok.ue_enterkry(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return 1

// cb_ok.clicked() returns long [event]
	string ls_aliasname
	string ls_date_errtext
	long ll_newid
	long ll_row
	long ll_counter
	long li_rc
	long ll_pk
	long ll_usercode
	long ll_icode
	long ll_gcode
	long ll_totalpieces
	long ll_piecesinhand
	double ld_stock
	double ld_qty
	boolean lb_commitok
	datetime ldt_server_datetime
	if parent.il_protect = 1 then
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_header) < 0 then
		parent.tab_main.selecttab(1)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_issue) < 0 then
		parent.tab_main.selecttab(2)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_receipt) < 0 then
		parent.tab_main.selecttab(3)
		return ::message.returnvalue
	end if
	if not parent.wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return ::message.returnvalue
	end if
	ll_pk = parent.id_header.object.code[1]
	if parent.wf_validate_issue() = 1 then
		parent.tab_main.selecttab(2)
		return ::message.returnvalue
	end if
	if parent.wf_validate_receipt() = 1 then
		parent.tab_main.selecttab(3)
		return ::message.returnvalue
	end if
	for ll_counter = 1 to parent.id_issue.rowcount()
		ll_icode = parent.id_issue.object.icode[ll_counter]
		ll_gcode = parent.id_issue.object.gcode[ll_counter]
		ld_qty = parent.id_issue.object.qty[ll_counter]
		parent.it_transobject.getitemstocktotal(ll_gcode, ll_icode, ld_stock)
		if parent.it_transobject.sqlcode = 0 then
			if ld_qty > ld_stock then
				messagebox("Item Stock Validation", "item stock not sufficient to issue this item", stopsign!)
				parent.tab_main.selecttab(2)
				parent.id_issue.setfocus()
				parent.id_issue.setcolumn("qty")
				parent.id_issue.scrolltorow(ll_counter)
				parent.id_issue.setrow(ll_counter)
				return ::message.returnvalue
			end if
		else
			messagebox("Item Stock Validation", "Unable To Fetch item stock for this item", stopsign!)
			parent.id_issue.setfocus()
			parent.id_issue.setcolumn("qty")
			parent.id_issue.scrolltorow(ll_counter)
			parent.id_issue.setrow(ll_counter)
			return ::message.returnvalue
		end if
		parent.it_transobject.getitemtotalpiecesinhand(ll_icode, ll_piecesinhand)
		if parent.it_transobject.sqlcode <> 0 then
			messagebox("Total Pieces Validation", "Unable To Fetch Pieces in Hand for this item", stopsign!)
			parent.id_issue.setfocus()
			parent.id_issue.setcolumn("totalpieces")
			parent.id_issue.scrolltorow(ll_counter)
			parent.id_issue.setrow(ll_counter)
			return ::message.returnvalue
		else
			parent.id_issue.setitem(ll_counter, "piecesinhand", ll_piecesinhand)
			if ll_piecesinhand < ll_totalpieces then
				messagebox("Total Pieces Validation", "Total Pieces for thiis Item exceeds Pieces in Hand for this item", stopsign!)
				parent.id_issue.setfocus()
				parent.id_issue.setcolumn("totalpieces")
				parent.id_issue.scrolltorow(ll_counter)
				parent.id_issue.setrow(ll_counter)
				return ::message.returnvalue
			end if
		end if
	next
	open(w_salesmanpassword)
	ll_usercode = long(::message.doubleparm)
	setfocus()
	if ll_usercode > 0 then
		if isnull(ll_pk) then
			parent.wf_tabnewid("ProdNote", ll_newid)
			if ll_newid > 0 then
				parent.id_header.object.code[1] = ll_newid
			end if
		else
			ll_newid = parent.id_header.object.code[1]
		end if
		for ll_counter = 1 to parent.id_issue.rowcount()
			parent.id_issue.object.code[ll_counter] = ll_newid
		next
		for ll_counter = 1 to parent.id_receipt.rowcount()
			parent.id_receipt.object.code[ll_counter] = ll_newid
		next
		parent.id_header.object.usercode[1] = ll_usercode
		parent.id_header.object.date[1] = ldt_server_datetime
		if ll_pk <= 0 then
			parent.id_header.object.originaldate[1] = ldt_server_datetime
		end if
		if parent.id_header.update() = 1 then
			if parent.id_issue.update() = 1 then
				if parent.id_receipt.update() = 1 then
					SQL commit USING parent.it_transobject;
					lb_commitok = true
					if parent.ib_print then
						parent.wf_print_note()
					end if
					parent.event ue_close()
					return ::message.returnvalue
				else
					messagebox("Problem while Saving Production Note Items Receipt", "Unable to update " + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
					SQL rollback USING parent.it_transobject;
				end if
			else
				messagebox("Problem while Saving Production Note Items Issued", "Unable to update " + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
				SQL rollback USING parent.it_transobject;
			end if
		else
			messagebox("Problem while Saving Production Note", "Unable to update " + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
			SQL rollback USING parent.it_transobject;
		end if
	end if
	return ::message.returnvalue

// tab_main.create() returns 0 [event]
	this.tabpage_header = create tabpage_header
	this.tabpage_issue = create tabpage_issue
	this.tabpage_receipt = create tabpage_receipt
	this.control = {this.tabpage_header, this.tabpage_issue, this.tabpage_receipt}

// tab_main.destroy() returns 0 [event]
	destroy this.tabpage_header
	destroy this.tabpage_issue
	destroy this.tabpage_receipt

// tab_main.selectionchanged(integer oldindex, integer newindex) returns long [event]
	if parent.il_protect = 0 then
		if newindex = 1 then
			parent.id_header.setfocus()
			if parent.id_header.rowcount() = 0 then
				parent.wf_insert_row(parent.id_header, 0)
			end if
		elseif newindex = 2 then
			parent.id_issue.setfocus()
			if parent.id_issue.rowcount() = 0 then
				parent.wf_insert_row(parent.id_issue, 0)
			end if
		elseif newindex = 3 then
			parent.id_receipt.setfocus()
			if parent.id_receipt.rowcount() = 0 then
				parent.wf_insert_row(parent.id_receipt, 0)
			end if
		end if
	end if
	return ::message.returnvalue

// tabpage_header.create() returns 0 [event]
	this.dw_header = create dw_header
	this.control = {this.dw_header}

// tabpage_header.destroy() returns 0 [event]
	destroy this.dw_header

// dw_header.ue_enterkey() returns long [event]
	if not (getcolumnname() = "prescriptionadviced" or getcolumnname() = "treatmentgiven" or getcolumnname() = "labinvestigationsdone" or getcolumnname() = "othertests" or getcolumnname() = "vitalnotes" or getcolumnname() = "previousabnormallabs") then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// dw_header.getfocus() returns long [event]
	setfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_header.itemfocuschanged(long row, dwobject dwo) returns long [event]
	if len(gettext()) > 0 then
		selecttext(1, len(gettext()))
	end if
	return ::message.returnvalue

// tabpage_issue.create() returns 0 [event]
	this.dw_selectionlist = create dw_selectionlist
	this.dw_issue = create dw_issue
	this.control = {this.dw_selectionlist, this.dw_issue}

// tabpage_issue.destroy() returns 0 [event]
	destroy this.dw_selectionlist
	destroy this.dw_issue

// dw_selectionlist.ue_setfocus() returns 0 [event]
	parent.parent.parent.id_issue.setcolumn("itemname")
	parent.parent.parent.id_issue.setfocus()

// dw_selectionlist.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::doubleclicked(xpos, ypos, row, dwo)
	post event ue_setfocus()
	return ::message.returnvalue

// dw_selectionlist.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	long ll_rowmain
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	if row > 0 then
		ll_rowmain = parent.parent.parent.id_issue.getrow()
		parent.parent.parent.id_issue.setitem(ll_rowmain, "icode", parent.parent.parent.id_selectionlist.getitemnumber(row, "code"))
		parent.parent.parent.id_issue.setitem(ll_rowmain, "itemname", parent.parent.parent.id_selectionlist.getitemstring(row, "name"))
		parent.parent.parent.id_issue.selecttext(1, len(gettext()))
		parent.parent.parent.ib_itemvalidated = false
		selectrow(0, false)
		selectrow(row, true)
		post event ue_setfocus()
	end if
	return ::message.returnvalue

// dw_issue.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_rowm
	long ll_rowcount
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if parent.parent.parent.il_protect = 0 then
		if key = keyinsert! or keyflags = 2 and key = keyi! then
			if parent.parent.parent.ib_rowvalidated = false and parent.parent.parent.wf_validateitem(getrow()) = -1 then
				return ::message.returnvalue
			end if
			if rowcount() > 0 and f_validatedw(parent.parent.parent.id_issue) < 0 then
				return ::message.returnvalue
			end if
			ll_rowcount = insertrow(0)
			parent.parent.parent.il_currrow = ll_rowcount
			if ll_rowcount > 0 then
				scrolltorow(ll_rowcount)
				setcolumn("itemname")
				setfocus()
				parent.parent.parent.id_selectionlist.hide()
			end if
		end if
		if keyflags = 2 and key = keyd! then
			parent.parent.parent.ib_rowvalidated = true
			if rowcount() > 0 then
				deleterow(0)
			end if
			ll_rowcount = rowcount()
			parent.parent.parent.il_currrow = ll_rowcount
			if ll_rowcount > 1 then
				scrolltorow(ll_rowcount)
				setcolumn("itemname")
				setfocus()
				parent.parent.parent.id_selectionlist.hide()
			end if
			parent.parent.parent.ib_rowvalidated = true
		end if
	end if
	if getcolumnname() = "itemname" then
		ll_rowm = getrow()
		setredraw(false)
		if key = keydownarrow! then
			parent.parent.parent.id_selectionlist.selectrow(0, false)
			parent.parent.parent.id_selectionlist.scrollnextrow()
			ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.parent.parent.id_selectionlist.selectrow(0, false)
			parent.parent.parent.id_selectionlist.scrollpriorrow()
			ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.parent.parent.id_selectionlist.selectrow(0, false)
			parent.parent.parent.id_selectionlist.scrollnextpage()
			ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.parent.parent.id_selectionlist.selectrow(0, false)
			parent.parent.parent.id_selectionlist.scrollpriorpage()
			ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.parent.parent.id_selectionlist.selectrow(0, false)
			parent.parent.parent.id_selectionlist.scrolltorow(99999)
			ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.parent.parent.id_selectionlist.selectrow(0, false)
			parent.parent.parent.id_selectionlist.scrolltorow(1)
			ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			if parent.parent.parent.id_selectionlist.visible = false then
				return ::message.returnvalue
			end if
			parent.parent.parent.id_selectionlist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf4! then
			parent.parent.parent.id_selectionlist.show()
			parent.parent.parent.id_selectionlist.selectrow(0, false)
			parent.parent.parent.id_selectionlist.scrolltorow(parent.parent.parent.id_selectionlist.getrow())
			parent.parent.parent.id_selectionlist.selectrow(parent.parent.parent.id_selectionlist.getrow(), true)
			setredraw(true)
		elseif isnull(getitemnumber(parent.parent.parent.id_issue.getrow(), "icode")) and key = keyenter! then
			parent.parent.parent.id_selectionlist.hide()
			parent.parent.parent.id_selectionlist.selectrow(0, false)
			parent.parent.parent.id_selectionlist.scrolltorow(parent.parent.parent.id_selectionlist.getrow())
			parent.parent.parent.id_selectionlist.selectrow(parent.parent.parent.id_selectionlist.getrow(), true)
			ll_listcurrrow = parent.parent.parent.id_selectionlist.getrow()
			setitem(ll_rowm, "icode", parent.parent.parent.id_selectionlist.getitemnumber(ll_listcurrrow, "code"))
			setitem(ll_rowm, "fullcode", parent.parent.parent.id_selectionlist.getitemstring(ll_listcurrrow, "aliasname"))
			setitem(ll_rowm, "itemname", parent.parent.parent.id_selectionlist.getitemstring(ll_listcurrrow, "name"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.ib_rowvalidated = false
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_selectionlist.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, "icode", parent.parent.parent.id_selectionlist.getitemnumber(ll_listcurrrow, "code"))
			setitem(ll_rowm, "fullcode", parent.parent.parent.id_selectionlist.getitemstring(ll_listcurrrow, "aliasname"))
			setitem(ll_rowm, "itemname", parent.parent.parent.id_selectionlist.getitemstring(ll_listcurrrow, "name"))
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.ib_rowvalidated = false
			setredraw(true)
		end if
	end if
	return rt_code

// dw_issue.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	setfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_issue.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	string ls_errortext
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(row) = -1 then
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.ib_rowvalidated = false
		return ::message.returnvalue
	end if
	if parent.parent.parent.ib_godownvalidated = false and parent.parent.parent.wf_validategodown() = -1 then
		return ::message.returnvalue
	end if
	if row > 0 then
		choose case dwo.name
		case "itemname"
			if isnull(getitemnumber(row, "icode")) then
				parent.parent.parent.id_selectionlist.show()
			else
				parent.parent.parent.wf_inititeminfo(parent.parent.parent.id_issue, getitemnumber(row, "icode"), row, ls_errortext)
			end if
		case "gcode"
			parent.parent.parent.wf_inititeminfo(parent.parent.parent.id_issue, getitemnumber(row, "icode"), row, ls_errortext)
			parent.parent.parent.id_selectionlist.hide()
		case "qty"
			parent.parent.parent.wf_inititeminfo(parent.parent.parent.id_issue, getitemnumber(row, "icode"), row, ls_errortext)
			parent.parent.parent.id_selectionlist.hide()
		case "remarks"
			parent.parent.parent.wf_inititeminfo(parent.parent.parent.id_issue, getitemnumber(row, "icode"), row, ls_errortext)
			parent.parent.parent.id_selectionlist.hide()
		end choose
	end if
	if len(gettext()) > 0 then
		selecttext(1, len(gettext()))
	end if
	return ::message.returnvalue

// dw_issue.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	long ll_rowcount
	ancestorreturnvalue = super::ue_enterkey()
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		if rowcount() > 0 and f_validatedw(this) < 0 then
			return ::message.returnvalue
		end if
		if parent.parent.parent.ib_rowvalidated = false and parent.parent.parent.wf_validateitem(getrow()) = -1 then
			return 1
		end if
		ll_rowcount = insertrow(0)
		if ll_rowcount > 1 then
			setrow(ll_rowcount)
			scrolltorow(ll_rowcount)
			if f_stringpreferences("itemcode") = "N" then
				setcolumn("itemname")
				parent.parent.parent.id_selectionlist.show()
			else
				setcolumn("fullcode")
				parent.parent.parent.id_selectionlist.hide()
			end if
			setfocus()
			parent.parent.parent.il_currrow = ll_rowcount
		end if
		return 1
	end if
	if getcolumnname() = "itemname" then
		parent.parent.parent.id_selectionlist.show()
		if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(getrow()) = -1 then
			return 1
		end if
		return
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_issue.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_currrow
	long ll_startrow
	long ll_totalpieces
	long ll_piecesinhand
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	ll_startrow = 0
	choose case dwo.name
	case "itemname"
		if upper(left(data, 1)) >= "A" and upper(left(data, 1)) <= "Z" or left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
			ll_currrow = parent.parent.parent.id_selectionlist.getrow()
			if len(data) > 1 then
				ll_startrow = ll_currrow
			else
				if left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
					ll_startrow = 1
				else
					ll_startrow = parent.parent.parent.ia_llookuptable[asc(upper(data))]
				end if
				parent.parent.parent.ib_bkspace = false
			end if
			if parent.parent.parent.ib_bkspace then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_selectionlist.find("Lower(name) <= '" + lower(data) + "'", ll_startrow, 0)
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.il_itemlistfoundrow + 1
				parent.parent.parent.ib_bkspace = false
			else
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_selectionlist.find("Lower(name) >= '" + lower(data) + "'", ll_startrow, 99999)
			end if
			if parent.parent.parent.il_itemlistfoundrow = 0 then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_selectionlist.rowcount()
			end if
			if parent.parent.parent.il_itemlistfoundrow <> ll_currrow then
				parent.parent.parent.id_selectionlist.selectrow(0, false)
				parent.parent.parent.id_selectionlist.setrow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_selectionlist.scrolltorow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_selectionlist.selectrow(parent.parent.parent.il_itemlistfoundrow, true)
				setfocus()
			elseif parent.parent.parent.il_itemlistfoundrow = ll_currrow then
				parent.parent.parent.id_selectionlist.selectrow(0, false)
				parent.parent.parent.id_selectionlist.setrow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_selectionlist.scrolltorow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_selectionlist.selectrow(parent.parent.parent.il_itemlistfoundrow, true)
				setfocus()
			end if
		end if
	end choose
	return ::message.returnvalue

// dw_issue.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_retcode
	long ll_icode
	long ll_null
	long ll_gcode
	long ll_itemcodetype
	long ll_totalpieces
	long ll_piecesinhand
	double ld_qty
	double ld_purprice
	double ld_saleprice
	string ls_itemname
	string ls_null
	integer li_res
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case "gcode"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_godownvalidated = false
		li_retcode = 0
	case "fullcode"
		if not isnull(data) and data <> "" then
			li_res = parent.parent.parent.wf_findfullcode(data, ll_icode, ls_itemname, ll_itemcodetype, ld_qty, ld_purprice, ld_saleprice)
			if li_res > 0 then
				setitem(row, "icode", ll_icode)
				setitem(row, "itemname", ls_itemname)
				setitem(row, "qty", 1)
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.ib_rowvalidated = false
				parent.parent.parent.il_currrow = row
				li_retcode = 0
				if parent.parent.parent.wf_validateitem(row) = 0 then
					li_retcode = 0
				else
					li_retcode = 1
				end if
			else
				messagebox("Item Alias Name/Code/No. Validation", "Item does not exist")
				setitem(row, "icode", ll_null)
				setitem(row, "fullcode", ls_null)
				li_retcode = 1
			end if
		else
			setitem(row, "icode", ll_null)
			setitem(row, "fullcode", ls_null)
			li_retcode = 2
		end if
	case "totalpieces"
		ll_totalpieces = long(data)
		ll_piecesinhand = this.object.piecesinhand[row]
		if ll_totalpieces < 0 then
			messagebox("Total Pieces Validation", "Total Pieces can not be negative", stopsign!)
			return 1
		end if
		if ll_totalpieces > ll_piecesinhand then
			messagebox("Total Pieces Validation", "Total Pieces Exceed Total No. of pieces in hand/stock", stopsign!)
			return 1
		end if
	case "saleprice"
		if real(data) < 0.0 then
			return 1
		end if
	case "itemname"
		setitem(row, "icode", parent.parent.parent.id_selectionlist.getitemnumber(parent.parent.parent.id_selectionlist.getrow(), "code"))
		setitem(row, "fullcode", parent.parent.parent.id_selectionlist.getitemstring(parent.parent.parent.id_selectionlist.getrow(), "aliasname"))
		setitem(row, "itemname", parent.parent.parent.id_selectionlist.getitemstring(parent.parent.parent.id_selectionlist.getrow(), "name"))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.ib_rowvalidated = false
		parent.parent.parent.il_currrow = row
		li_retcode = 2
	case "qty"
		if double(data) <= 0.0 then
			messagebox("Qty Validation", "Please enter valid Qty", stopsign!)
			li_retcode = 1
		end if
	case else
		parent.parent.parent.ib_rowvalidated = true
	end choose
	return li_retcode

// dw_issue.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "itemname"
		messagebox("Name Validation", "Please enter value for item Name")
	case "saleprice"
		messagebox("Price Validation", "Please enter valid value for saleprice")
	end choose
	return 1

// dw_issue.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	parent.parent.parent.id_selectionlist.hide()
	return ::message.returnvalue

// dw_issue.rowfocuschanging(long currentrow, long newrow) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::rowfocuschanging(currentrow, newrow)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(getrow()) = -1 then
		return ::message.returnvalue
	end if
	if parent.parent.parent.ib_godownvalidated = false and parent.parent.parent.wf_validategodown() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_issue.rowfocuschanged(long currentrow) returns long [event]
	long ancestorreturnvalue
	dwitemstatus lrs_status
	ancestorreturnvalue = super::rowfocuschanged(currentrow)
	if currentrow > 0 then
		if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem(currentrow) = -1 then
			return ::message.returnvalue
		end if
		if parent.parent.parent.ib_godownvalidated = false and parent.parent.parent.wf_validategodown() = -1 then
			return ::message.returnvalue
		end if
		return
	end if
	return ::message.returnvalue

// tabpage_receipt.create() returns 0 [event]
	this.dw_selectionlistpod = create dw_selectionlistpod
	this.dw_receipt = create dw_receipt
	this.control = {this.dw_selectionlistpod, this.dw_receipt}

// tabpage_receipt.destroy() returns 0 [event]
	destroy this.dw_selectionlistpod
	destroy this.dw_receipt

// dw_selectionlistpod.ue_setfocus() returns 0 [event]
	parent.parent.parent.id_receipt.setcolumn("itemname")
	parent.parent.parent.id_receipt.setfocus()

// dw_selectionlistpod.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	long ll_rowmain
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	if row > 0 then
		ll_rowmain = parent.parent.parent.id_receipt.getrow()
		parent.parent.parent.id_receipt.setitem(ll_rowmain, "icode", parent.parent.parent.id_selectionlist_receipt.getitemnumber(row, "code"))
		parent.parent.parent.id_receipt.setitem(ll_rowmain, "itemname", parent.parent.parent.id_selectionlist_receipt.getitemstring(row, "name"))
		parent.parent.parent.id_receipt.selecttext(1, len(gettext()))
		parent.parent.parent.ib_itemvalidated_receipt = false
		selectrow(0, false)
		selectrow(row, true)
		post event ue_setfocus()
	end if
	return ::message.returnvalue

// dw_selectionlistpod.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::doubleclicked(xpos, ypos, row, dwo)
	post event ue_setfocus()
	return ::message.returnvalue

