// window w_prodnote_form (issuereq)  ancestor: window

// w_prodnote_form.ue_close() returns 0 [event]
	SQL stop USING this.it_transobject;
	close(this)

// w_prodnote_form.wf_set_interface_adjustments() returns 0
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width * 0.95
		ll_height = ll_win_height * 0.95
		this.width = ll_width
		this.height = ll_height
		this.cb_ok.y = ll_height - this.cb_ok.height - 200
		this.cb_cancel.y = ll_height - this.cb_cancel.height - 200
		this.cb_print.y = ll_height - this.cb_cancel.height - 200
		this.tab_main.width = ll_width * 0.98
		this.tab_main.height = this.cb_ok.y - 50
		this.tab_main.tabpage_header.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_header.height = this.tab_main.height - 500
		this.tab_main.tabpage_header.dw_header.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_header.dw_header.height = this.tab_main.height - 500
		this.tab_main.tabpage_issue.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_issue.height = this.tab_main.height - 500
		this.tab_main.tabpage_issue.dw_issue.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_issue.dw_issue.height = this.tab_main.tabpage_issue.height - 100
		this.tab_main.tabpage_receipt.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_receipt.height = this.tab_main.height - 500
		this.tab_main.tabpage_receipt.dw_receipt.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_receipt.dw_receipt.height = this.tab_main.tabpage_receipt.height - 100
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if

// w_prodnote_form.wf_set_tab_visibility() returns long
	if f_stringpreferences("ShowTotalPiecesInIssue") = "N" then
		this.id_issue.object.piecesinhand.visible = false
		this.id_issue.object.totalpieces.visible = false
		this.id_issue.object.totalpieces.initial = "0"
		this.id_issue.object.totalpieces.validation = "Real (GetText()) >= 0"
	end if
	if f_stringpreferences("ShowTotalPiecesInReceipt") = "N" then
		this.id_receipt.object.piecesinhand.visible = false
		this.id_receipt.object.totalpieces.visible = false
		this.id_receipt.object.totalpieces.initial = "0"
		this.id_receipt.object.totalpieces.validation = "Real (GetText()) >= 0"
	end if
	wf_select_first_tab()
	return 0

// w_prodnote_form.wf_connect() returns long
	SQL start USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_prodnote_form.wf_tabnewid(string as_tablename, long al_newid) returns long
	long ll_rtcode
	SQL SELECT TABMAXKEY INTO :al_newid FROM _TABMAXKEY WITH ( UPDLOCK HOLDLOCK ) WHERE _TABMAXKEY.TABName =:as_tablename USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_newid = al_newid + 1
		SQL update dbo._tabmaxkey SET TABMAXKEY =:al_newid WHERE _TABMAXKEY.TABName =:as_tablename USING this.it_transobject;
		if this.it_transobject.sqlcode < 0 then
			ll_rtcode = this.it_transobject.sqlcode
			al_newid = 0
		end if
	else
		ll_rtcode = this.it_transobject.sqlcode
		al_newid = 0
	end if
	return ll_rtcode

// w_prodnote_form.wf_retrieve_tabs() returns long
	long ll_retcode
	this.id_header = this.tab_main.tabpage_header.dw_header
	this.id_header.settransobject(this.it_transobject)
	if this.il_code > 0 then
		this.id_header.retrieve(this.il_code)
	end if
	this.id_issue = this.tab_main.tabpage_issue.dw_issue
	this.id_issue.settransobject(this.it_transobject)
	ll_retcode = this.id_issue.getchild("gcode", this.idc_issuegodown)
	if ll_retcode = -1 then
		messagebox("Error", "Cannot get datawindowchild", stopsign!)
		return -1
	end if
	this.idc_issuegodown.settransobject(this.it_transobject)
	ll_retcode = this.idc_issuegodown.retrieve(this.il_groupcode, this.ii_issuemodule, this.ii_issuestrategy)
	if ll_retcode = -1 then
		messagebox("Error", "Not Enough Godown Rights to Issue")
		return -1
	end if
	if this.il_code > 0 then
		this.id_issue.retrieve(this.il_code)
	end if
	if this.idc_issuegodown.rowcount() > 0 then
		this.id_issue.object.gcode.initial = trim(string(this.idc_issuegodown.getitemnumber(1, "gcode")))
	end if
	this.id_selectionlist = this.tab_main.tabpage_issue.dw_selectionlist
	this.id_selectionlist.settransobject(this.it_transobject)
	gd_popup_itemsinfo.sharedata(this.id_selectionlist)
	wf_itemlist_initialization()
	this.id_receipt = this.tab_main.tabpage_receipt.dw_receipt
	this.id_receipt.settransobject(this.it_transobject)
	ll_retcode = this.id_receipt.getchild("gcode", this.idc_receiptgodown)
	if ll_retcode = -1 then
		messagebox("Error", "Cannot get datawindowchild", stopsign!)
		return -1
	end if
	this.idc_receiptgodown.settransobject(this.it_transobject)
	ll_retcode = this.idc_receiptgodown.retrieve(this.il_groupcode, this.ii_receiptmodule, this.ii_receiptstrategy)
	if ll_retcode = -1 then
		messagebox("Error", "Not Enough Godown Rights to Receipt")
		return -1
	end if
	if this.il_code > 0 then
		this.id_receipt.retrieve(this.il_code)
	end if
	if this.idc_receiptgodown.rowcount() > 0 then
		this.id_receipt.object.gcode.initial = trim(string(this.idc_receiptgodown.getitemnumber(1, "gcode")))
	end if
	this.id_selectionlist_receipt = this.tab_main.tabpage_receipt.dw_selectionlistpod
	this.id_selectionlist_receipt.settransobject(this.it_transobject)
	gd_popup_itemsinfo.sharedata(this.id_selectionlist_receipt)
	wf_itemlist_initialization_receipt()
	f_setcolumnstyle(this.id_issue, "Qty")
	f_setcolumnstyle(this.id_receipt, "Qty")
	this.id_receipt.object.batch.initial = f_stringpreferences("defaultbatch")
	this.id_receipt.object.expiry.initial = string(f_datepreferences("defaultexpiry"))
	return 0

// w_prodnote_form.wf_insert_row(datawindow adw_dw, integer ai_askpermit) returns long
	long ll_row
	long ll_res
	if ai_askpermit = 1 then
		ll_res = messagebox("Insert New Record", "Do you want to Insert New Record?", question!, yesnocancel!, 2)
	else
		ll_res = 1
	end if
	if ll_res = 1 then
		ll_row = adw_dw.insertrow(0)
		adw_dw.object.code[ll_row] = this.il_code
		adw_dw.setrow(ll_row)
		adw_dw.scrolltorow(ll_row)
	end if
	return 0

// w_prodnote_form.wf_delete_row(datawindow adw_dw, integer ai_askpermit) returns long
	long ll_row
	long ll_res
	if adw_dw.rowcount() > 0 and adw_dw.getrow() > 0 then
		if ai_askpermit = 1 then
			ll_res = messagebox("Delete Record", "Do you want to delete this record?", question!, yesnocancel!, 2)
		else
			ll_res = 1
		end if
		if ll_res = 1 then
			ll_row = adw_dw.getrow()
			if adw_dw.deleterow(ll_row) = 1 and adw_dw.rowcount() > 0 then
				adw_dw.setrow(1)
				adw_dw.scrolltorow(1)
			end if
		end if
	end if
	return 0

// w_prodnote_form.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns integer
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next
	return 0

// w_prodnote_form.wf_apply_protect_setting() returns integer
	if this.il_protect = 1 then
		wf_protectdw(this.id_header, this.il_protect)
		wf_protectdw(this.id_issue, this.il_protect)
		wf_protectdw(this.id_receipt, this.il_protect)
		this.cb_ok.enabled = false
	end if
	return 0

// w_prodnote_form.wf_save() returns long
	if this.il_protect = 0 then
		this.cb_ok.triggerevent(clicked!)
	end if
	return 0

// w_prodnote_form.wf_print() returns long
	if this.il_protect = 0 then
		wf_save()
	end if
	return 0

// w_prodnote_form.wf_select_first_tab() returns long
	if this.tab_main.tabpage_header.visible then
		this.tab_main.selecttab(1)
		return 0
	end if
	if this.tab_main.tabpage_issue.visible = true then
		this.tab_main.selecttab(17)
		return 0
	end if
	if this.tab_main.tabpage_receipt.visible = true then
		this.tab_main.selecttab(18)
		return 0
	end if
	return 0

// w_prodnote_form.wf_itemlist_initialization() returns 0
	long li_counter
	long ll_startrow
	long ll_rowcount
	long ll_found
	char lc_char
	ll_rowcount = this.id_selectionlist.rowcount()
	setredraw(false)
	this.id_selectionlist.setsort("name A")
	this.id_selectionlist.sort()
	for li_counter = 65 to 90
		lc_char = char(li_counter)
		this.ia_llookuptable[li_counter] = this.id_selectionlist.find("Lower(name) >= Lower('" + char(li_counter) + "')", ll_startrow, 99999)
		ll_startrow = this.ia_llookuptable[li_counter]
	next
	this.ia_llookuptable[92] = 99999
	this.id_selectionlist.object.t_stock.visible = false
	this.id_selectionlist.object.stock.visible = false
	this.id_selectionlist.object.t_sstock.visible = true
	this.id_selectionlist.object.sstock.visible = true
	this.id_selectionlist.object.t_pstock.visible = false
	this.id_selectionlist.object.pstock.visible = false
	this.id_selectionlist.object.stock.visible = false
	this.id_selectionlist.object.sstock.visible = true
	this.id_selectionlist.object.pstock.visible = false
	if f_stringpreferences("aliasname") = "N" then
		this.id_selectionlist.object.aliasname.visible = false
	end if
	if f_stringpreferences("itempackingdesc") = "N" then
		this.id_selectionlist.object.packingdesc.visible = false
	end if
	if f_stringpreferences("itemlocation") = "N" then
		this.id_selectionlist.object.location.visible = false
	end if
	if f_stringpreferences("manufacturer") = "N" then
		this.id_selectionlist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_selectionlist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_selectionlist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_selectionlist.object.saleprice.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_selectionlist.object.sstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_selectionlist.object.itemalertcode.visible = false
	end if
	if f_stringpreferences("ShowTransitStockInItemList") = "N" then
		this.id_selectionlist.object.transitstock.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_selectionlist.object.purprice.visible = true
	else
		this.id_selectionlist.object.purprice.visible = false
	end if
	f_setcolumnstyle(this.id_issue, "Qty")
	setredraw(true)

// w_prodnote_form.wf_validateitem(long al_row) returns integer
	long ll_icode
	long ll_null
	integer li_errcode
	string ls_errtext
	string ls_titleerrtext
	string ls_null
	boolean lb_zerostock
	setnull(ls_null)
	setnull(ll_null)
	if al_row > 0 then
		ll_icode = this.id_issue.getitemnumber(al_row, "icode")
	end if
	if isnull(ll_icode) then
		this.ib_rowvalidated = false
		this.ib_itemvalidated = false
		messagebox("Validation Error!", "Please Enter Valid Item")
		li_errcode = -1
	else
		if vf_dwdupcode1(this.id_issue, "icode", string(ll_icode), al_row) = true then
			messagebox("Duplication Error", "Current row is duplicate")
			li_errcode = -1
			this.ib_rowvalidated = false
			this.ib_itemvalidated = false
		else
			li_errcode = wf_inititeminfo(this.id_issue, ll_icode, al_row, ls_errtext)
			if li_errcode <> 0 then
				if li_errcode = -2 then
					lb_zerostock = true
					li_errcode = -1
				end if
			else
				ls_titleerrtext = "Item Validation"
			end if
			li_errcode = 0
			this.ib_rowvalidated = true
			this.ib_itemvalidated = true
		end if
		li_errcode = 0
		this.ib_rowvalidated = true
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		this.id_issue.setcolumn("icode")
		this.id_issue.scrolltorow(al_row)
		this.id_issue.object.icode[al_row] = ll_null
		this.id_issue.object.itemname[al_row] = ls_null
	end if
	return li_errcode

// w_prodnote_form.wf_show_patient_gallery() returns long
	if this.il_code > 0 then
		openwithparm(w_patientgallary, this.il_code)
	end if
	return 0

// w_prodnote_form.wf_validateserverdatetime(datetime ar_server_datetime, string ar_errtext) returns boolean
	datetime ldt_last_transdate
	datetime ldt_current_serverdate
	long li_max_allow_days
	ar_errtext = "Invoice Date  Check violates"
	li_max_allow_days = f_numberpreferences("MaxAllowDate")
	if isnull(li_max_allow_days) then
		li_max_allow_days = 4
	end if
	SQL SELECT LastTransDate INTO :ldt_last_transdate FROM ServerDate USING sqlca;
	if sqlca.sqlcode = 0 then
		sqlca.getdatetime(ldt_current_serverdate)
		if sqlca.sqlcode = 0 then
			if ldt_current_serverdate >= ldt_last_transdate and daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) <= li_max_allow_days then
				ar_server_datetime = ldt_current_serverdate
				return true
			elseif ldt_current_serverdate < ldt_last_transdate then
				ar_errtext = "Back Date Invoice Check violates"
				return false
			elseif daysafter(date(ldt_last_transdate), date(ldt_current_serverdate)) > li_max_allow_days then
				ar_errtext = "Forward Date Invoice Check violates"
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_prodnote_form.wf_validate_receipt() returns long
	long ll_currrow
	long ll_counter
	long ll_null
	ll_currrow = this.id_receipt.getrow()
	setnull(ll_null)
	if this.id_receipt.rowcount() > 0 then
		if isnull(this.id_receipt.getitemnumber(ll_currrow, "icode")) then
			if isnull(this.id_receipt.getitemstring(ll_currrow, "itemname")) then
				this.id_receipt.deleterow(ll_currrow)
			elseif this.ib_itemvalidated_receipt = false then
				messagebox("Item Validation", "Please Select Some Valid Item")
				this.id_receipt.setcolumn("itemname")
				this.id_receipt.scrolltorow(ll_currrow)
				this.id_receipt.setfocus()
				return 1
			end if
		elseif this.ib_itemvalidated_receipt = false then
			messagebox("Item Validation", "Please Select Some Valid Item")
			this.id_receipt.setcolumn("itemname")
			this.id_receipt.scrolltorow(ll_currrow)
			this.id_receipt.setfocus()
			return 1
		end if
		if f_validatedw(this.id_receipt) < 0 then
			return 1
		end if
		this.il_currrow_receipt = this.id_receipt.rowcount()
		if this.ib_itemvalidated_receipt = false and wf_validateitem_receipt(ll_currrow) = -1 then
			return 1
		end if
		return
	end if
	for ll_counter = 1 to this.id_receipt.rowcount()
		this.id_receipt.object.code[ll_counter] = this.il_code
	next
	return 0

// w_prodnote_form.wf_validateitem_receipt(long al_row) returns integer
	long ll_icode
	long ll_null
	integer li_errcode
	string ls_null
	string ls_errtext
	string ls_titleerrtext
	setnull(ll_null)
	setnull(ls_null)
	ll_icode = this.id_receipt.getitemnumber(al_row, "icode")
	if isnull(ll_icode) then
		this.ib_rowvalidated_receipt = false
		this.ib_itemvalidated_receipt = false
		messagebox("Validation Error!", "Please Enter Valid Item")
		li_errcode = -1
	elseif vf_dwdupcodebatch(this.id_receipt, "gcode", this.id_receipt.getitemnumber(this.id_receipt.getrow(), "gcode"), "icode", this.id_receipt.getitemnumber(this.id_receipt.getrow(), "icode"), "batch", this.id_receipt.getitemstring(this.id_receipt.getrow(), "batch"), "expiry", this.id_receipt.getitemdatetime(this.id_receipt.getrow(), "expiry"), al_row) = true then
		messagebox("Item Validation", "Duplicate item, please select some other item")
		li_errcode = -1
		this.ib_rowvalidated = false
		this.ib_itemvalidated = false
	else
		li_errcode = wf_inititeminfo_receipt(ll_icode, al_row, ls_errtext)
		if li_errcode <> 0 then
			ls_titleerrtext = "Item Validation"
		else
			li_errcode = 0
			this.ib_rowvalidated_receipt = true
			this.ib_itemvalidated_receipt = true
		end if
	end if
	if li_errcode <> 0 then
		this.id_receipt.setcolumn("icode")
		this.id_receipt.scrolltorow(al_row)
		this.id_receipt.object.icode[al_row] = ll_null
		this.id_receipt.object.itemname[al_row] = ls_null
	end if
	return li_errcode

