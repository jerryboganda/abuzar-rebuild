// window w_prodbuffer (issuereq)  ancestor: window

// w_prodbuffer.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// w_prodbuffer.ue_close(integer ai_closemode) returns integer
	long ll_currrow
	long ll_counter
	long ll_null
	if ai_closemode = 0 then
		close(this)
		return 0
	end if
	if this.ic_posted = "Y" then
		if ai_closemode = 2 then
			wf_print()
		end if
		close(this)
		return 0
	end if
	ll_currrow = this.id_detail.getrow()
	setnull(ll_null)
	if this.id_detail.rowcount() > 0 then
		if isnull(this.id_detail.getitemnumber(ll_currrow, "icode")) then
			if isnull(this.id_detail.getitemstring(ll_currrow, "itemname")) then
				this.id_detail.deleterow(ll_currrow)
			elseif this.ib_itemvalidated = false then
				messagebox("Item Validation", "Please Select Some Valid Item")
				this.id_detail.setcolumn("itemname")
				this.id_detail.scrolltorow(ll_currrow)
				this.id_detail.setfocus()
				return 1
			end if
		elseif this.ib_itemvalidated = false then
			messagebox("Item Validation", "Please Select Some Valid Item")
			this.id_detail.setcolumn("itemname")
			this.id_detail.scrolltorow(ll_currrow)
			this.id_detail.setfocus()
			return 1
		end if
		if f_validatedw(this.id_detail) < 0 then
			return 1
		end if
		this.il_currrow = this.id_detail.rowcount()
		if this.ib_itemvalidated = false and wf_validateitem(ll_currrow) = -1 then
			return 1
		end if
		return
	end if
	for ll_counter = 1 to this.id_detail.rowcount()
		this.id_detail.object.prodcode[ll_counter] = this.il_prodcode
	next
	if this.id_detail.update() = 1 then
		SQL commit USING this.it_transobject;
		if this.it_transobject.sqlcode <> 0 then
			messagebox("Saving Problem", "Production Buffer Saving Problem Occurred", stopsign!)
			return 1
		else
			if ai_closemode = 2 then
				wf_print()
			end if
			close(this)
			return 0
		end if
	else
		messagebox("Saving Problem", "Production Buffer Saving Problem Occurred", stopsign!)
		return 1
	end if
	return 0

// w_prodbuffer.ue_postopen() returns 0
	long li_counter
	long ll_startrow
	long ll_rowcount
	long ll_found
	char lc_char
	string ls_report
	ll_rowcount = this.id_selectionlist.rowcount()
	if ll_rowcount <= 0 or isnull(ll_rowcount) then
		messagebox("Row Validation", "There are no rows to select in SelectionList.~r~nKindly try again.")
		close(this)
		return
	end if
	setredraw(false)
	this.id_selectionlist.setsort("name A")
	this.id_selectionlist.sort()
	for li_counter = 65 to 90
		lc_char = char(li_counter)
		this.ia_llookuptable[li_counter] = this.id_selectionlist.find("Lower(name) >= Lower('" + char(li_counter) + "')", ll_startrow, 99999)
		ll_startrow = this.ia_llookuptable[li_counter]
	next
	this.ia_llookuptable[92] = 99999
	this.id_selectionlist.object.t_stock.visible = false
	this.id_selectionlist.object.stock.visible = false
	this.id_selectionlist.object.t_sstock.visible = true
	this.id_selectionlist.object.sstock.visible = true
	this.id_selectionlist.object.t_pstock.visible = false
	this.id_selectionlist.object.pstock.visible = false
	if f_stringpreferences("aliasname") = "N" then
		this.id_selectionlist.object.aliasname.visible = false
	end if
	if f_stringpreferences("itempackingdesc") = "N" then
		this.id_selectionlist.object.packingdesc.visible = false
	end if
	if f_stringpreferences("itemlocation") = "N" then
		this.id_selectionlist.object.location.visible = false
	end if
	if f_stringpreferences("manufacturer") = "N" then
		this.id_selectionlist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_selectionlist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_selectionlist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_selectionlist.object.saleprice.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_selectionlist.object.sstock.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_selectionlist.object.itemalertcode.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_selectionlist.object.purprice.visible = true
	else
		this.id_selectionlist.object.purprice.visible = false
	end if
	if gs_company = "BESTCOLORKSA" then
		ls_report = "d_bestcolorksa_prodbuffer_print"
	elseif gs_company = "SCMPACKAGING" then
		ls_report = "d_scmpackaging_prodbuffer_print"
	else
		ls_report = "d_prodbuffer_print"
	end if
	this.dw_print.dataobject = ls_report
	this.dw_print.settransobject(sqlca)
	f_setcolumnstyle(this.dw_detail, "Qty")
	setredraw(true)

// w_prodbuffer.wf_validateitem(long al_row) returns integer
	long ll_icode
	long ll_null
	integer li_errcode
	setnull(ll_null)
	ll_icode = this.id_detail.getitemnumber(al_row, "icode")
	if isnull(ll_icode) then
		this.ib_rowvalidated = false
		this.ib_itemvalidated = false
		messagebox("Validation Error!", "Please Enter Valid Item")
		li_errcode = -1
	else
		li_errcode = wf_inititeminfo(ll_icode, al_row)
		if li_errcode = 0 then
			this.ib_rowvalidated = true
			this.ib_itemvalidated = true
		else
			li_errcode = -1
		end if
	end if
	if li_errcode = -1 then
		this.id_detail.setcolumn("icode")
		this.id_detail.scrolltorow(al_row)
		this.id_detail.object.icode[al_row] = ll_null
	end if
	return li_errcode

// w_prodbuffer.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_prodbuffer.wf_inititeminfo(long al_icode, long al_row) returns long
	long ll_retcode
	long ll_packunits
	double ld_saleprice
	double ld_packprice
	SQL SELECT packunits , packprice =saleprice , saleprice =Round ( saleprice / CASE PackUnits WHEN 0 THEN 1 ELSE PackUnits END , 2 ) INTO :ll_packunits, :ld_packprice, :ld_saleprice FROM item WHERE ICode =:al_icode AND ItemTypeCode <> 2 USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_retcode = 0
		if ll_packunits = 0 or isnull(ll_packunits) then
			ll_packunits = 1
		end if
		if isnull(this.id_detail.object.itemcode[al_row]) then
			this.id_detail.object.itemcode[al_row] = -1
		end if
		if isnull(this.id_detail.object.icode[al_row]) then
			this.id_detail.object.icode[al_row] = -1
		end if
		if this.id_detail.object.icode[al_row] <> this.id_detail.object.itemcode[al_row] then
			this.id_detail.setitem(al_row, "packprice", ld_packprice)
			this.id_detail.setitem(al_row, "price", ld_saleprice)
			this.id_detail.setitem(al_row, "packunits", ll_packunits)
		end if
	else
		ll_retcode = -1
	end if
	return ll_retcode

// w_prodbuffer.wf_set_preferences() returns long
	if f_stringpreferences("showitemflatdiscinrecipe") = "N" then
		this.dw_detail.object.itemflatdisc.visible = false
	end if
	if f_stringpreferences("showdiscpercinrecipe") = "N" then
		this.dw_detail.object.discperc.visible = false
	end if
	if f_stringpreferences("showitemflatdiscinrecipe") = "N" and f_stringpreferences("showdiscpercinrecipe") = "N" then
		this.dw_detail.object.c_discamt.visible = false
	end if
	if f_stringpreferences("showprocesschargesinrecipe") = "N" then
		this.dw_detail.object.processcharge.visible = false
	end if
	if f_stringpreferences("showprocesschargespercinrecipe") = "N" then
		this.dw_detail.object.processchargeperc.visible = false
	end if
	if f_stringpreferences("showprocesschargesinrecipe") = "N" and f_stringpreferences("showprocesschargespercinrecipe") = "N" then
		this.dw_detail.object.c_processchages.visible = false
	end if
	if f_stringpreferences("showremarksinrecipe") = "N" then
		this.dw_detail.object.remarks.visible = false
	end if
	return 0

// w_prodbuffer.wf_set_setcode(long al_prodrowid, long al_row) returns long
	long ll_setcode
	if al_prodrowid > 0 then
		SQL SELECT D.ICode INTO :ll_setcode FROM ProdDetail D WHERE D.RowID =:al_prodrowid USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.id_detail.object.setcode[al_row] = ll_setcode
			this.id_detail.groupcalc()
			return 0
		else
			return 1
		end if
		return
	end if
	return 0

// w_prodbuffer.wf_print() returns long
	s_datastore lstr
	this.dw_print.retrieve(this.il_prodcode)
	if this.dw_print.rowcount() > 0 then
		lstr.dw = this.dw_print
		lstr.s_name1 = this.dw_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode <> -1 then
			if this.dw_print.print() = -1 then
				messagebox("Printing Error", "Failed to Print the required document", stopsign!)
			end if
		end if
	end if
	return 0

// w_prodbuffer.create() returns 0
	this.dw_print = create dw_print
	this.cb_print = create cb_print
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.dw_selectionlist = create dw_selectionlist
	this.dw_header = create dw_header
	this.dw_detail = create dw_detail
	this.control = {this.dw_print, this.cb_print, this.cb_cancel, this.cb_ok, this.dw_selectionlist, this.dw_header, this.dw_detail}

// w_prodbuffer.destroy() returns 0
	destroy this.dw_print
	destroy this.cb_print
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.dw_selectionlist
	destroy this.dw_header
	destroy this.dw_detail

// w_prodbuffer.open() returns long
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_retcode
	environment env
	setredraw(false)
	this.il_prodcode = message.doubleparm
	this.it_transobject = create u_transaction
	SQL start USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Database Problem", "Some Database Problem has occurred. Details Are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_win_width = ll_win_width
		ll_win_height = ll_win_height
		this.width = ll_win_width * 0.98
		this.height = ll_win_height * 0.90
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		this.dw_header.width = this.width * 0.98
		this.dw_detail.width = this.width * 0.98
		this.cb_print.x = this.dw_detail.x
		this.cb_print.y = this.height - this.cb_print.height - 150
		this.cb_ok.x = this.dw_detail.x + this.cb_print.width + 50
		this.cb_ok.y = this.height - this.cb_ok.height - 150
		this.cb_cancel.x = this.dw_detail.x + this.cb_print.width + 50 + this.cb_ok.width + 50
		this.cb_cancel.y = this.height - this.cb_cancel.height - 150
		this.dw_detail.height = this.height - this.dw_header.height - this.cb_ok.height - 200
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	this.id_header = this.dw_header
	this.id_detail = this.dw_detail
	this.id_selectionlist = this.dw_selectionlist
	this.id_header.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_selectionlist.settransobject(this.it_transobject)
	this.id_header.retrieve(this.il_prodcode)
	this.id_detail.retrieve(this.il_prodcode)
	gd_popup_itemsinfo.sharedata(this.id_selectionlist)
	post event ue_postopen()
	this.dw_detail.setcolumn("itemname")
	this.dw_detail.scrolltorow(this.il_currrow)
	this.dw_detail.setfocus()
	SQL SELECT Posted INTO :this.ic_posted FROM ProdHeader WHERE ProdCode =:this.il_prodcode USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Database Problem", "Some Database Problem has occurred. Details Are:-~r~n" + sqlca.sqlerrtext, stopsign!)
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	if this.ic_posted = "Y" then
		wf_protectdw(this.id_header, 1)
		wf_protectdw(this.id_detail, 1)
	else
		wf_protectdw(this.id_header, 1)
		wf_protectdw(this.id_detail, 0)
	end if
	this.id_detail.setrow(1)
	this.id_detail.scrolltorow(1)
	this.il_currrow = 1
	wf_set_preferences()
	setredraw(true)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_prodbuffer.closequery() returns long
	long ll_currrow
	long ll_counter
	long ll_null
	ll_currrow = this.id_detail.getrow()
	setnull(ll_null)
	if this.id_detail.rowcount() > 0 then
		if isnull(this.id_detail.getitemnumber(ll_currrow, "icode")) then
			if isnull(this.id_detail.getitemstring(ll_currrow, "itemname")) then
				this.id_detail.deleterow(ll_currrow)
			elseif this.ib_itemvalidated = false then
				messagebox("Item Validation", "Please Select Some Valid Item")
				this.id_detail.setcolumn("itemname")
				this.id_detail.scrolltorow(ll_currrow)
				this.id_detail.setfocus()
				return 1
			end if
		elseif this.ib_itemvalidated = false then
			messagebox("Item Validation", "Please Select Some Valid Item")
			this.id_detail.setcolumn("itemname")
			this.id_detail.scrolltorow(ll_currrow)
			this.id_detail.setfocus()
			return 1
		end if
		if f_validatedw(this.id_detail) < 0 then
			return 1
		end if
		this.il_currrow = this.id_detail.rowcount()
		if this.ib_itemvalidated = false and wf_validateitem(ll_currrow) = -1 then
			return 1
		end if
		return
	end if
	return 0

// cb_print.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return ::message.returnvalue

// cb_print.clicked() returns long
	parent.post event ue_close(2)
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.post event ue_close(0)
	return ::message.returnvalue

// cb_ok.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	parent.post event ue_close(1)
	return ::message.returnvalue

// dw_selectionlist.ue_setfocus() returns 0
	parent.id_detail.setcolumn("itemname")
	parent.id_detail.setfocus()

// dw_selectionlist.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long
	long ll_rowmain
	if row > 0 then
		ll_rowmain = parent.id_detail.getrow()
		parent.id_detail.setitem(ll_rowmain, "icode", parent.id_selectionlist.getitemnumber(row, "code"))
		parent.id_detail.setitem(ll_rowmain, "itemname", parent.id_selectionlist.getitemstring(row, "name"))
		parent.id_detail.selecttext(1, len(gettext()))
		parent.ib_itemvalidated = false
		selectrow(0, false)
		selectrow(row, true)
		post event ue_setfocus()
	end if
	return ::message.returnvalue

// dw_selectionlist.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long
	post event ue_setfocus()
	return ::message.returnvalue

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_prodrowid
	long ll_rowm
	long ll_rowcount
	if parent.ic_posted = "Y" then
		return 0
	end if
	if keyflags = 2 then
		if key = keyi! then
			parent.ib_editflag = true
			if parent.ib_rowvalidated = false and parent.wf_validateitem(getrow()) = -1 then
				return ::message.returnvalue
			end if
			if rowcount() > 0 and f_validatedw(parent.id_detail) < 0 then
				return ::message.returnvalue
			end if
			if getrow() > 0 then
				ll_prodrowid = this.object.prodrowid[getrow()]
			end if
			if getrow() = rowcount() then
				ll_rowcount = insertrow(0)
			else
				ll_rowcount = insertrow(getrow())
			end if
			this.object.prodrowid[ll_rowcount] = ll_prodrowid
			parent.wf_set_setcode(ll_prodrowid, ll_rowcount)
			if ll_rowcount > 1 then
				scrolltorow(ll_rowcount)
				setcolumn("itemname")
				setfocus()
				parent.id_selectionlist.show()
				parent.il_currrow = ll_rowcount
			end if
		end if
		if key = keyd! then
			parent.ib_editflag = true
			parent.ib_rowvalidated = true
			ll_currrow = getrow()
			if rowcount() > 0 and getrow() > 0 then
				deleterow(0)
			end if
			ll_rowcount = rowcount()
			if ll_currrow > ll_rowcount then
				parent.il_currrow = ll_rowcount
			else
				parent.il_currrow = ll_currrow
			end if
			if parent.il_currrow > 1 then
				scrolltorow(parent.il_currrow)
				setcolumn("itemname")
				setfocus()
				parent.id_selectionlist.show()
			end if
			parent.ib_rowvalidated = true
		end if
		if key = keys! then
			parent.post event ue_close(1)
		end if
	end if
	if getcolumnname() = "itemname" then
		ll_rowm = getrow()
		setredraw(false)
		if key = keydownarrow! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrollnextrow()
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrollpriorrow()
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrollnextpage()
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrollpriorpage()
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrolltorow(99999)
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrolltorow(1)
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			if parent.id_selectionlist.visible = false then
				return ::message.returnvalue
			end if
			parent.id_selectionlist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf4! then
			parent.id_selectionlist.show()
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrolltorow(parent.id_selectionlist.getrow())
			parent.id_selectionlist.selectrow(parent.id_selectionlist.getrow(), true)
			setredraw(true)
		elseif isnull(getitemnumber(parent.id_detail.getrow(), "icode")) and key = keyenter! then
			parent.id_selectionlist.hide()
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrolltorow(parent.id_selectionlist.getrow())
			parent.id_selectionlist.selectrow(parent.id_selectionlist.getrow(), true)
			ll_listcurrrow = parent.id_selectionlist.getrow()
			setitem(ll_rowm, "icode", parent.id_selectionlist.getitemnumber(ll_listcurrrow, "code"))
			setitem(ll_rowm, "itemname", parent.id_selectionlist.getitemstring(ll_listcurrrow, "name"))
			selecttext(1, len(gettext()))
			parent.ib_itemvalidated = false
			parent.ib_rowvalidated = false
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.id_selectionlist.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, "icode", parent.id_selectionlist.getitemnumber(ll_listcurrrow, "code"))
			setitem(ll_rowm, "itemname", parent.id_selectionlist.getitemstring(ll_listcurrrow, "name"))
			selecttext(1, len(gettext()))
			parent.ib_itemvalidated = false
			parent.ib_rowvalidated = false
			setredraw(true)
		end if
	end if
	return rt_code

// dw_detail.ue_enterkey() returns long
	long ll_rowcount
	long ll_prodrowid
	if parent.ic_posted = "Y" then
		return 1
	end if
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		if parent.id_detail.rowcount() > 0 and f_validatedw(parent.id_detail) < 0 then
			return ::message.returnvalue
		end if
		if parent.ib_rowvalidated = false and parent.wf_validateitem(getrow()) = -1 then
			return 1
		end if
		ll_prodrowid = this.object.prodrowid[getrow()]
		ll_rowcount = parent.id_detail.insertrow(0)
		if ll_rowcount > 1 then
			this.object.prodrowid[ll_rowcount] = ll_prodrowid
			parent.wf_set_setcode(ll_prodrowid, ll_rowcount)
			parent.id_detail.scrolltorow(ll_rowcount)
			parent.id_detail.setcolumn("itemname")
			parent.id_detail.setfocus()
		end if
		return 1
	end if
	if getcolumnname() = "itemname" then
		parent.id_selectionlist.hide()
		if parent.ib_itemvalidated = false and parent.wf_validateitem(getrow()) = -1 then
			return 1
		end if
		return
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long
	choose case dwo.name
	case "itemname"
		messagebox("Name Validation", "Please enter value for Name")
	case "saleprice"
		messagebox("Price Validation", "Please enter valid value for saleprice")
	end choose
	return 1

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long
	if parent.ib_itemvalidated = false and parent.wf_validateitem(row) = -1 then
		parent.ib_itemvalidated = false
		parent.ib_rowvalidated = false
		return ::message.returnvalue
	end if
	choose case dwo.name
	case "itemname"
		if isnull(getitemnumber(row, "icode")) then
			parent.id_selectionlist.show()
		else
			parent.wf_inititeminfo(getitemnumber(row, "icode"), row)
		end if
	case else
		parent.id_selectionlist.hide()
	end choose
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long
	integer li_retcode
	long ll_icode
	long ll_null
	long ll_gcode
	string ls_itemname
	string ls_null
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case "fullcode"
		parent.ib_rowvalidated = false
		parent.il_currrow = row
		li_retcode = 0
		setitem(row, "icode", ll_null)
		setitem(row, "itemname", ls_null)
	case "saleprice"
		if real(data) < 0.0 then
			return 1
		end if
	case "itemname"
		setitem(row, "icode", parent.id_selectionlist.getitemnumber(parent.id_selectionlist.getrow(), "code"))
		setitem(row, "itemname", parent.id_selectionlist.getitemstring(parent.id_selectionlist.getrow(), "name"))
		parent.ib_itemvalidated = false
		parent.ib_rowvalidated = false
		parent.il_currrow = row
		li_retcode = 2
	case else
		parent.ib_rowvalidated = true
	end choose
	return li_retcode

// dw_detail.editchanged(long row, dwobject dwo, string data) returns long
	long ll_currrow
	long ll_startrow
	ll_startrow = 0
	parent.ib_editflag = true
	choose case dwo.name
	case "itemname"
		if upper(left(data, 1)) >= "A" and upper(left(data, 1)) <= "Z" or left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
			ll_currrow = parent.id_selectionlist.getrow()
			if len(data) > 1 then
				ll_startrow = ll_currrow
			else
				if left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
					ll_startrow = 1
				else
					ll_startrow = parent.ia_llookuptable[asc(upper(data))]
				end if
				parent.ib_bkspace = false
			end if
			if parent.ib_bkspace then
				parent.il_itemlistfoundrow = parent.id_selectionlist.find("Lower(name) <= '" + lower(data) + "'", ll_startrow, 0)
				parent.il_itemlistfoundrow = parent.il_itemlistfoundrow + 1
				parent.ib_bkspace = false
			else
				parent.il_itemlistfoundrow = parent.id_selectionlist.find("Lower(name) >= '" + lower(data) + "'", ll_startrow, 99999)
			end if
			if parent.il_itemlistfoundrow = 0 then
				parent.il_itemlistfoundrow = parent.id_selectionlist.rowcount()
			end if
			if parent.il_itemlistfoundrow <> ll_currrow then
				parent.id_selectionlist.selectrow(0, false)
				parent.id_selectionlist.setrow(parent.il_itemlistfoundrow)
				parent.id_selectionlist.scrolltorow(parent.il_itemlistfoundrow)
				parent.id_selectionlist.selectrow(parent.il_itemlistfoundrow, true)
				setfocus()
			elseif parent.il_itemlistfoundrow = ll_currrow then
				parent.id_selectionlist.selectrow(0, false)
				parent.id_selectionlist.setrow(parent.il_itemlistfoundrow)
				parent.id_selectionlist.scrolltorow(parent.il_itemlistfoundrow)
				parent.id_selectionlist.selectrow(parent.il_itemlistfoundrow, true)
				setfocus()
			end if
		end if
	end choose
	return ::message.returnvalue

// dw_detail.losefocus() returns long
	parent.id_selectionlist.hide()
	return ::message.returnvalue

// dw_detail.rowfocuschanged(long currentrow) returns long
	if parent.ib_itemvalidated = false and parent.wf_validateitem(getrow()) = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue
