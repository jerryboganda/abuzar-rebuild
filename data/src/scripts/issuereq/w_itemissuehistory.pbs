// window w_itemissuehistory (issuereq)  ancestor: window

// w_itemissuehistory.create() returns 0
	this.dw_header = create dw_header
	this.control = {this.dw_header}

// w_itemissuehistory.destroy() returns 0
	destroy this.dw_header

// w_itemissuehistory.open() returns long
	s_itemsalehistory ls_itemsalehistory
	long ll_width
	long ll_height
	environment env
	ls_itemsalehistory = message.powerobjectparm
	if getenvironment(env) <> 1 then
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.width = ll_width * 0.98
	this.height = ll_height * 0.65
	this.y = int((ll_height - this.height) / 2.0)
	this.dw_header.width = this.width - this.width * 0.02
	this.dw_header.height = this.height - this.width * 0.05
	this.dw_header.settransobject(sqlca)
	this.dw_header.retrieve(ls_itemsalehistory.ar_icode, ls_itemsalehistory.ar_date)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_itemissuehistory.close() returns long
	close(this)
	return ::message.returnvalue

// w_itemissuehistory.key(keycode key, unsignedlong keyflags) returns long
	if keydown(keyescape!) then
		close(this)
	end if
	return ::message.returnvalue
