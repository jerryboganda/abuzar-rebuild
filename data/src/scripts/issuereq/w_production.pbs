// w_production.wf_print() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	long ll_count
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			for ll_count = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
				this.id_print.retrieve(ll_count)
				if this.id_print.rowcount() > 0 then
					if this.id_print.print() < 0 then
						messagebox("Printing", "Can not Print Invoice", information!)
					end if
				else
					messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)
				end if
			next
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	return li_errcode

// w_production.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_production.wf_setiteminfo(long al_icode, long al_row, double ad_saleprice, double ad_discperc, long al_stock, double ad_avgprice, long al_totalstock, double ad_purdiscperc) returns 0
	this.id_detail.setitem(al_row, "saleprice", ad_saleprice)
	if this.ii_saletype = 2 then
		this.id_detail.setitem(al_row, "discperc", ad_discperc)
	else
		this.id_detail.setitem(al_row, "discperc", 0.0)
	end if
	this.id_detail.setitem(al_row, "rate", ad_saleprice)
	this.id_detail.setitem(al_row, "avgprice", ad_avgprice)
	this.id_footer.object.icode[this.id_footer.getrow()] = al_icode
	this.id_footer.object.stock[this.id_footer.getrow()] = al_stock

// w_production.wf_setsaletype(integer ai_saletype) returns 0
	this.ii_saletype = ai_saletype

// w_production.wf_setsuppinfo(long al_suppcode, datawindow ad_master) returns 0
