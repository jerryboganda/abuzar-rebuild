// w_production.wf_populatesaledetail(long al_invid, datawindow ad_saledetail, string as_errortext, long al_errorrow) returns boolean
	long ll_detailrows
	long ll_gcode
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode
	long li_counter
	long li_innercounter
	long ll_insertedrows
	long ll_itemsdetailrowcount
	long ll_row
	long ll_itemflatdisc
	long ll_sectcode
	double ld_stock
	double ld_newstock
	double ld_salelooseqty
	double ld_dueqty
	double ld_looseqty
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_mrpp
	double ld_purchaseprice
	boolean lb_commitflag
	string ls_batch
	string ls_updatesaleprice
	string ls_updsaleprice
	string ls_saleitemdescription
	datetime ld_expiry
	dwitemstatus ldws_column
	unsignedlong ul_rowcount
	unsignedlong ul_maxutn
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	ll_itemsdetailrowcount = 0
	ls_updatesaleprice = f_stringpreferences("updatesaleprice")
	as_errortext = "    Some database problem ocuurs         "
	do while li_counter <= ll_detailrows and lb_commitflag
		ll_gcode = this.id_detail.getitemnumber(li_counter, "gcode")
		ll_icode = this.id_detail.getitemnumber(li_counter, "icode")
		ld_salelooseqty = this.id_detail.getitemnumber(li_counter, "qty")
		ll_packunits = this.id_detail.getitemnumber(li_counter, "packunits")
		ld_saleprice = this.id_detail.getitemnumber(li_counter, "saleprice")
		ld_purchaseprice = this.id_detail.getitemnumber(li_counter, "purchaseprice")
		ld_avgprice = this.id_detail.getitemnumber(li_counter, "avgprice")
		ld_mrpp = this.id_detail.getitemnumber(li_counter, "mrpp")
		ll_sectcode = this.id_detail.getitemnumber(li_counter, "sectcode")
		ldws_column = this.id_detail.getitemstatus(li_counter, "saleprice", primary!)
		ls_updsaleprice = this.id_detail.getitemstring(li_counter, "updatesaleprice")
		ld_salelooseqty = ld_salelooseqty
		this.it_transobject.getitemavgprice(ll_icode, ld_avgprice)
		if this.it_transobject.sqlcode = 0 then
			if ld_salelooseqty > 0.0 and lb_commitflag then
				if wf_selectitembatches(ll_gcode, ll_icode, ld_salelooseqty, ad_saledetail, ll_insertedrows, as_errortext) = 0 then
					for li_innercounter = 1 to ll_insertedrows
						ll_row = ll_itemsdetailrowcount + li_innercounter
						ad_saledetail.setitem(ll_row, "code", al_invid)
						ad_saledetail.setitem(ll_row, "packunits", ll_packunits)
						ad_saledetail.setitem(ll_row, "saleprice", ld_saleprice)
						ad_saledetail.setitem(ll_row, "avgprice", ld_avgprice)
						ad_saledetail.setitem(ll_row, "mrpp", ld_mrpp)
						ad_saledetail.setitem(ll_row, "purchaseprice", ld_purchaseprice)
						ad_saledetail.setitem(ll_row, "avgprice", ld_avgprice)
						ad_saledetail.setitem(ll_row, "sectcode", ll_sectcode)
						ls_batch = ad_saledetail.getitemstring(ll_row, "batch")
						ld_expiry = ad_saledetail.getitemdatetime(ll_row, "expiry")
						ld_looseqty = ad_saledetail.getitemnumber(ll_row, "qty")
						ld_stock = ad_saledetail.getitemnumber(ll_row, "stock")
						ld_newstock = ld_stock - ld_looseqty
						if ld_newstock > 0.0 then
							this.it_transobject.saleupdateitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_newstock, ld_stock)
						else
							this.it_transobject.deleteitemstockbatch(ll_gcode, ll_icode, ls_batch, ld_expiry, ld_stock)
						end if
						if this.it_transobject.sqlcode <> 0 then
							lb_commitflag = false
							as_errortext = "Stock Updation Error:~r~n" + this.it_transobject.sqlerrtext
						end if
					next
					ll_itemsdetailrowcount = ll_itemsdetailrowcount + ll_insertedrows
				else
					this.id_detail.setitem(li_counter, "stock", ll_insertedrows)
					lb_commitflag = false
				end if
			end if
		else
			lb_commitflag = false
		end if
		li_counter = li_counter + 1
	loop
	if not lb_commitflag then
		al_errorrow = li_counter - 1
		messagebox("Database Error", as_errortext)
	end if
	SQL rollback USING sqlca;
	ul_rowcount = ad_saledetail.rowcount()
	sqlca.getmaxutn(ul_rowcount, ul_maxutn)
	if sqlca.sqlcode = 0 then
		SQL commit USING sqlca;
	else
		SQL rollback USING sqlca;
		messagebox("Saving", "Error in generating UTN ")
		return false
	end if
	for li_counter = 1 to ad_saledetail.rowcount()
		ad_saledetail.setitem(li_counter, "IssueUtn", ul_maxutn)
		ul_maxutn = ul_maxutn + 1
	next
	return lb_commitflag

// w_production.wf_setgodownoption() returns 0

// w_production.wf_initmodify(integer ai_protect) returns 0
	long ll_saleinvcode
	long ll_gcode
	long ll_icode
	long ll_counter
	long ll_count
	double ld_looseqty
	double ld_stock
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_saleinvcode = this.id_master.getitemnumber(1, "code")
		if wf_lock_production(ll_saleinvcode) = 0 then
			this.id_master.retrieve(ll_saleinvcode)
			this.id_detail.retrieve(ll_saleinvcode)
			if ai_protect = 0 then
				this.ib_modify = true
				this.id_footer.setitem(1, "stock", 0)
				this.im_menu.m_file.m_save.enabled = true
				this.im_menu.m_file.m_new.enabled = false
				this.im_menu.m_file.m_delete.enabled = false
				this.im_menu.m_item.m_newitem.enabled = true
				this.im_menu.m_item.m_deleteitem.enabled = true
				this.im_menu.m_file.m_first.enabled = false
				this.im_menu.m_file.m_next.enabled = false
				this.im_menu.m_file.m_previous.enabled = false
				this.im_menu.m_file.m_last.enabled = false
				this.im_menu.m_file.m_retrieve.enabled = true
				this.im_menu.m_file.m_retrieve.text = "Lis&t"
				this.tab_retrieve.tabpage_detail.enabled = true
			end if
			return
		end if
		messagebox("Cannot Modify", "Issue Request invoice is already in use")
	end if

// w_production.wf_validateitem(boolean ab_flag) returns integer
	long ll_icode
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean ib_due
	double ld_stock
	double ld_totalstock
	integer li_null
	string ls_null
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	if not isnull(ll_icode) then
		if wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
			if li_errcode = -2 then
				li_errcode = -1
			end if
		else
			ls_titleerrtext = "Item Validation"
		end if
	end if
	if ab_flag then
		this.ib_itemvalidated = true
	end if
	if li_errcode = -1 then
		setnull(li_null)
		setnull(ls_null)
		ls_titleerrtext = "Item Validation"
		messagebox(ls_titleerrtext, ls_errtext)
		if f_stringpreferences("itemcode") = "N" then
			this.id_detail.setcolumn(this.is_columnitemname)
			this.ib_itemslistopen = true
			this.id_itemslist.show()
		else
			this.id_detail.setcolumn("fullcode")
			this.id_detail.object.fullcode[this.il_currrow] = ls_null
		end if
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
	end if
	return li_errcode

// w_production.wf_updatesaleprice(long al_icode, double ad_saleprice) returns integer
	SQL update Item SET saleprice =:ad_saleprice WHERE Item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_production.wf_validatefullcode(string as_custicode, long al_currrow) returns boolean
	long ll_icode
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	integer li_errcode
	integer li_assgcode
	integer li_option
	boolean lb_rtflag
	boolean ib_due
	double ld_stock
	double ld_totalstock
	integer li_null
	string ls_null
	ls_titleerrtext = "Item Validation"
	if vf_dwdupcode1(this.id_detail, "icode", string(ll_icode), al_currrow) = true then
		ls_errtext = "Duplicate item, please select some other item"
		li_errcode = -1
	elseif wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode = -2 then
			li_option = messagebox("Item Validation", "Item stock does not exist~n~rDo You want to due this item", information!, yesno!, 2)
			if li_option = 1 then
				this.id_detail.setitem(this.il_currrow, "looseqty", 1)
				this.id_detail.setitem(this.il_currrow, "dueqty", 1)
				ib_due = true
			else
				li_errcode = -1
			end if
		end if
	else
		li_errcode = -1
		ls_titleerrtext = "Item Validation"
	end if
	if li_errcode = -1 and not ib_due then
		lb_rtflag = false
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setitem(al_currrow, this.is_columnitemname, ls_null)
		this.id_detail.setitem(al_currrow, "icode", li_null)
		this.id_detail.selecttext(1, len(this.id_detail.gettext()))
	end if
	return lb_rtflag

// w_production.wf_validategodown() returns integer
	long ll_icode
	long ll_gcode
	long ll_counter
	string ls_fullcode
	string ls_titleerrtext
	string ls_errtext
	string ls_null
	integer li_errcode
	integer li_null
	integer li_option
	integer li_duperr
	boolean ib_due
	double ld_stock
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "icode")
	this.ii_defaultgcode = this.id_detail.getitemnumber(this.il_currrow, "gcode")
	if wf_inititeminfo(ll_icode, this.il_currrow, li_errcode, ls_errtext) then
		if li_errcode <> -2 then
			for ll_counter = 1 to this.id_detail.rowcount()
				if this.il_currrow <> ll_counter and (ll_icode = this.id_detail.getitemnumber(ll_counter, "icode") and this.ii_defaultgcode = this.id_detail.getitemnumber(ll_counter, "gcode")) then
					li_duperr = -2
				end if
			next
		end if
	end if
	this.ib_godownvalidated = true
	if li_errcode = -1 and not ib_due then
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		this.id_detail.setfocus()
		this.id_detail.setcolumn("gcode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
	end if
	if li_duperr = -2 and not ib_due then
		ls_titleerrtext = "Item Validation"
		ls_errtext = "Duplicate Item, please select some other item"
		messagebox(ls_titleerrtext, ls_errtext)
		setnull(li_null)
		setnull(ls_null)
		this.id_detail.setcolumn(this.is_columnitemname)
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.gcode[this.il_currrow] = li_null
		this.id_detail.object.icode[this.il_currrow] = li_null
		this.id_detail.object.itemname[this.il_currrow] = ls_null
		this.ib_itemslistopen = true
		this.id_itemslist.show()
		li_errcode = -1
	end if
	return li_errcode

// w_production.wf_visible(boolean ab_flag) returns 0
	this.id_footer.object.stock.visible = ab_flag
	this.id_footer.object.t_stock.visible = ab_flag

// w_production.wf_selectprintreport() returns string
	string ls_report
	if gs_company = "ALNASEEB" then
		ls_report = "d_alnaseeb_production_invreport"
	elseif gs_company = "PM" then
		ls_report = "d_pm_issuereqinvreport"
	elseif gs_company = "DFOODSISB" then
		ls_report = "d_dfoodsisb_productioninvreport"
	elseif gs_company = "SCMPACKAGING" then
		ls_report = "d_scmpackaging_prodbuffer_print"
	else
		ls_report = "d_productioninvreport"
	end if
	this.id_print.dataobject = ls_report
	this.id_print.settransobject(this.it_transobject)
	return ls_report

// w_production.wf_post() returns integer
	integer li_errcode
	long ll_salesmancode
	long ll_saleinvcount
	boolean lb_flag
	s_arguements lstr_arginfo
	datetime ldt_server_datetime
	string ls_date_errtext
	long ll_counter
	long ll_headerno
	long ll_retcode
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return -1
			end if
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			ll_headerno = 1
			li_errcode = wf_lock_productions(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_saleinvcount)
			if li_errcode = 0 then
				for ll_counter = lstr_arginfo.l_code1 to lstr_arginfo.l_code2
					ll_retcode = sqlca.postproduction(ll_counter, ll_salesmancode, ll_headerno, ldt_server_datetime)
					if sqlca.sqlcode <> 0 or ll_retcode <> 0 then
						li_errcode = -1
						exit
					end if
				next
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			messagebox("Posting Fails For Production :" + string(ll_counter), "Reasons are:~r~n" + sqlca.sqlerrtext)
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if li_errcode = 0 then
		messagebox("Posting Successfull", "All rows have been posted successfully")
	end if
	return li_errcode

// w_production.wf_allowissuemodification(double ad_invoicecode, long al_groupcode, integer ai_strategy) returns long
	long ll_disallowedcount
	SQL SELECT DISTINCT GCode =ISNull ( Count ( GCode ) , 0 ) INTO :ll_disallowedcount FROM IssueReqDetail WHERE IssueReqInvCode =:ad_invoicecode AND GCode NOT IN ( SELECT Godown.GCode FROM Godown WHERE GCode IN ( CASE :ai_strategy WHEN 2 THEN ( SELECT G.GCode From Godown G WHERE G.GCode =Godown.GCode ) ELSE ( SELECT G.GCode From GroupAllowedGodown G WHERE G.GroupCode =:al_groupcode AND G.Module =:this.ii_module AND Godown.GCode =G.GCode ) END ) ) USING sqlca;
	return ll_disallowedcount

// w_production.wf_inititeminfo(long al_icode, long al_row, integer ai_rtcode, string as_errortext) returns boolean
	boolean retflag
	double ld_saleprice
	long ll_packunits
	long ll_saleinvcode
	double ld_saleprice2
	double ld_saleprice3
	double ld_avgprice
	double ld_mrpp
	double ld_purprice
	double ld_minrecipeqty
	integer li_gcode
	string ls_fullcode
	string ls_name
	string ls_null
	double ld_totalstock
	double ld_godownstock
	double ld_saleqty
	setnull(ls_null)
	SQL SELECT item.customicode , item.name , item.saleprice , item.packunits , item.purprice , item.saleprice2 , item.saleprice3 , item.avgprice , item.recentpurprice , Qty =ISNULL ( ( SELECT M =MAX ( R.Qty ) FROM Recipe R WHERE R.ResultedItem =:al_icode AND R.Priority =( Select Min ( Priority ) From Recipe Where ResultedItem =:al_icode ) ) , 1 ) INTO :ls_fullcode, :ls_name, :ld_saleprice, :ll_packunits, :ld_purprice, :ld_saleprice2, :ld_saleprice3, :ld_avgprice, :ld_mrpp, :ld_minrecipeqty FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	if ll_packunits < 1 or isnull(ll_packunits) then
		ll_packunits = 1
	end if
	if this.it_transobject.sqlcode = -1 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	if this.il_godowncount = 1 and this.il_strategy = 1 then
		li_gcode = this.id_master.getitemnumber(this.id_master.getrow(), "IssueGcode")
	else
		if this.il_strategy = 2 then
			li_gcode = wf_getitemassociategcode(al_icode)
		end if
		if this.il_strategy = 1 then
			li_gcode = this.id_master.getitemnumber(this.id_master.getrow(), "IssueGcode")
		end if
	end if
	this.it_transobject.getitemstockinallowedgodown(al_icode, this.il_groupcode, this.il_strategy, this.ii_module, ld_totalstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item information can not be retrieved"
	end if
	this.it_transobject.getitemstocktotal(li_gcode, al_icode, ld_godownstock)
	if this.it_transobject.sqlcode <> 0 then
		retflag = false
		as_errortext = "Database Error: Item Stock information can not be retrieved"
	end if
	if retflag then
		this.id_detail.setitem(al_row, this.is_columnitemname, ls_name)
		this.id_detail.setitem(al_row, "fullcode", ls_fullcode)
		this.id_detail.setitem(al_row, "icode", al_icode)
		this.id_detail.setitem(al_row, "stock", ld_godownstock)
		this.id_detail.setitem(al_row, "minrecipeqty", ld_minrecipeqty)
		if this.id_detail.object.icode[al_row] <> this.id_detail.object.itemcode[al_row] then
			this.id_detail.object.qty[al_row] = ld_minrecipeqty
		end if
	else
		retflag = false
		as_errortext = "Item can not be produced, its Stock is Zero"
	end if
	this.id_footer.setitem(1, "stock", ld_godownstock)
	this.id_footer.setitem(1, "totalstock", ld_totalstock)
	this.id_detail.setitem(al_row, "itemcode", al_icode)
	return retflag

// w_production.wf_retrieve_itemslist() returns integer
	integer li_count
	char lc_char
	long ll_startrow
	this.id_itemslist.retrieve(this.il_groupcode)
	for li_count = 65 to li_count
		lc_char = char(li_count)
		this.ia_llookuptable[li_count] = this.id_itemslist.find("Lower(itemname) >= Lower('" + char(li_count) + "')", ll_startrow, 99999)
		ll_startrow = this.ia_llookuptable[li_count]
	next
	this.ia_llookuptable[92] = 99999
	return 0

// w_production.wf_getsalesstockinfo(long al_saleinvcode, long al_gcode, long al_icode, double al_saleqty) returns integer
	SQL Select IsNull ( Sum ( saledetail.looseqty ) , 0 ) INTO :al_saleqty from saledetail where saledetail.saleinvcode =:al_saleinvcode and saledetail.gcode =:al_gcode and saledetail.icode =:al_icode USING this.it_transobject;
	if isnull(al_saleqty) then
		al_saleqty = 0
	end if
	return this.it_transobject.sqlcode

// w_production.wf_findfullcode(string as_fullcode, long al_icode, string as_itemname) returns integer
	long ll_icode
	long ll_retflag
	string ls_itemname
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item , Recipe R WHERE item.customicode =:as_fullcode AND R.ResultedItem =Item.icode And item.itemtypecode <> 2 And item.Active =1 AND Item.ICatCode IN ( SELECT ICatCode FROM ItemCategory WHERE ICatCode IN ( SELECT ItemsCategoryCode FROM ItemsGroupCategory WHERE GroupCode IN ( SELECT GroupCode FROM UserGroups WHERE UserCode =:gl_usercode ) ) ) USING this.it_transobject;
	else
		SQL SELECT item.icode , item.name INTO :ll_icode, :ls_itemname FROM item , Recipe R WHERE item.customicode =:as_fullcode AND R.ResultedItem =Item.icode And item.itemtypecode <> 2 And item.Active =1 USING this.it_transobject;
	end if
	if this.it_transobject.sqlcode = 0 then
		al_icode = ll_icode
		as_itemname = ls_itemname
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_production.wf_finalize() returns long
	integer li_errcode
	long ll_salesmancode
	long ll_counter
	long ll_count
	boolean lb_flag
	s_arguements lstr_arginfo
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	if ll_salesmancode > 0 then
		open(w_arg_sinvcode_linvcode)
		lstr_arginfo = message.powerobjectparm
		if lstr_arginfo.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			li_errcode = wf_lock_productions(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_count)
			if li_errcode = 0 then
				sqlca.finalize_production(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode)
				if sqlca.sqlcode <> 0 then
					li_errcode = -1
				end if
			end if
		end if
		if li_errcode = 0 then
			SQL commit USING sqlca;
			if sqlca.sqlcode <> 0 then
				li_errcode = -1
			end if
		else
			SQL rollback USING sqlca;
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)
	if ll_salesmancode > 0 then
		if li_errcode <> 0 then
			messagebox("Production Finalization Fails", "Some database request fails, Please try again")
		else
			messagebox("Production Finalization", "Finalization Successfull")
		end if
	end if
	return li_errcode

// w_production.wf_lock_production(long al_saleinvcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From ProdHeader WITH ( UPDLOCK HOLDLOCK ) Where ProdHeader.ProdCode =:al_saleinvcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_production.wf_lock_productions(long al_sinvcode, long al_linvcode, long al_totalinvoice) returns integer
	integer li_count
	SQL Select count ( *) INTO :al_totalinvoice From ProdHeader WITH ( UPDLOCK HOLDLOCK ) Where ProdHeader.ProdCode Between :al_sinvcode AND :al_linvcode AND ProdHeader.Posted ='N' AND Finalized ='N' USING sqlca;
	return sqlca.sqlcode

// w_production.wf_postissue() returns long
	boolean lb_listtab
	long ll_salesmancode
	long ll_row
	long ll_code
	long ll_issueinvcode
	long ll_receiptinvcode
	long ll_found
	char lc_issuestatus
	char lc_receiptstatus
	char lc_posted
	char lc_finalized
	string ls_errtext
	if wf_iseditable() = true then
		return 0
	end if
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	ll_row = this.id_list.getrow()
	if lb_listtab and ll_row > 0 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
		if ll_salesmancode > 0 then
			ll_code = this.id_list.object.code[ll_row]
			ll_issueinvcode = this.id_list.object.issueinvcode[ll_row]
			lc_posted = this.id_list.object.posted[ll_row]
			lc_finalized = this.id_list.object.finalized[ll_row]
			lc_issuestatus = this.id_list.object.issuestatus[ll_row]
			ll_receiptinvcode = this.id_list.object.receiptinvcode[ll_row]
			lc_receiptstatus = this.id_list.object.receiptstatus[ll_row]
			if ll_code > 0 and ll_issueinvcode > 0 and lc_finalized = "Y" and lc_posted = "Y" and lc_issuestatus <> "Y" and lc_receiptstatus <> "Y" then
				SQL rollback USING this.it_transobject;
				ll_found = 0
				SQL Select count ( *) INTO :ll_found From IssueHeader With ( ReadPast , RowLock , UpdLock ) Where IssueInvCode =:ll_issueinvcode USING this.it_transobject;
				if this.it_transobject.sqlcode = 0 then
					if ll_found = 0 then
						messagebox("Issue Posting", "Issue Document already in use by some other user. Please Try Later", stopsign!)
						return 0
					else
						this.it_transobject.postissue_from_production(ll_code, ll_salesmancode)
						if this.it_transobject.sqlcode = 0 then
							SQL commit USING this.it_transobject;
							messagebox("Issue Posting", "Issue Successfully Posted", information!)
						else
							ls_errtext = this.it_transobject.sqlerrtext
							SQL rollback USING this.it_transobject;
							messagebox("Issue Posting", "Problem in Issue Posting. Details are:-~r~n" + ls_errtext, stopsign!)
						end if
					end if
				else
					messagebox("Issue Posting", "Issue Document Lock attempt failed. Please Try Later.", stopsign!)
					return 0
				end if
				return
			end if
			return
		end if
		return
	end if
	return 0

// w_production.wf_postreceipt() returns long
	boolean lb_listtab
	long ll_salesmancode
	long ll_row
	long ll_code
	long ll_issueinvcode
	long ll_receiptinvcode
	long ll_found
	char lc_issuestatus
	char lc_receiptstatus
	char lc_posted
	char lc_finalized
	string ls_errtext
	if wf_iseditable() = true then
		return 0
	end if
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	ll_row = this.id_list.getrow()
	if lb_listtab and ll_row > 0 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
		if ll_salesmancode > 0 then
			ll_code = this.id_list.object.code[ll_row]
			ll_issueinvcode = this.id_list.object.issueinvcode[ll_row]
			lc_posted = this.id_list.object.posted[ll_row]
			lc_finalized = this.id_list.object.finalized[ll_row]
			lc_issuestatus = this.id_list.object.issuestatus[ll_row]
			ll_receiptinvcode = this.id_list.object.receiptinvcode[ll_row]
			lc_receiptstatus = this.id_list.object.receiptstatus[ll_row]
			if ll_code > 0 and ll_issueinvcode > 0 and ll_receiptinvcode > 0 and lc_finalized = "Y" and lc_posted = "Y" and lc_issuestatus = "Y" and lc_receiptstatus <> "Y" then
				SQL rollback USING this.it_transobject;
				ll_found = 0
				SQL Select count ( *) INTO :ll_found From ReceiptHeader With ( ReadPast , RowLock , UpdLock ) Where ReceiptInvCode =:ll_receiptinvcode USING this.it_transobject;
				if this.it_transobject.sqlcode = 0 then
					if ll_found = 0 then
						messagebox("Receipt Posting", "Receipt Document already in use by some other user. Please Try Later", stopsign!)
						return 0
					else
						this.it_transobject.postreceipt_from_production(ll_code, ll_salesmancode)
						if this.it_transobject.sqlcode = 0 then
							SQL commit USING this.it_transobject;
							messagebox("Receipt Posting", "Receipt Successfully Posted", information!)
						else
							ls_errtext = this.it_transobject.sqlerrtext
							SQL rollback USING this.it_transobject;
							messagebox("Receipt Posting", "Problem in Receipt Posting. Details are:-~r~n" + ls_errtext, stopsign!)
						end if
					end if
				else
					messagebox("Receipt Posting", "Receipt Document Lock attempt failed. Please Try Later.", stopsign!)
					return 0
				end if
				return
			end if
			return
		end if
		return
	end if
	return 0

// w_production.create() returns 0
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_productionmenu" then
		this.menuid = create m_productionmenu
	end if
	this.dw_saleinvrep = create dw_saleinvrep
	this.dw_saleinvdetail = create dw_saleinvdetail
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_saleinvrep
	this.control[icurrent + 2] = this.dw_saleinvdetail

// w_production.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_saleinvrep
	destroy this.dw_saleinvdetail

// w_production.ue_save() returns 0
	long ll_detailrows
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_icode
	long ll_packunits
	long ll_errrowid
	long ll_customeracc
	long ll_salesmancode
	long ll_gcode
	long ll_headerno
	long ll_headerinvno
	long ll_counter
	long ll_count
	long ll_retcode
	boolean lb_commitflag
	boolean lb_continue
	integer li_counter
	string ls_errtext
	double ld_rate
	double ld_avgprice
	double ld_saleprice
	double ld_discperc
	double ld_invdiscperc
	double ld_flatdisc
	double ld_salestax
	double ld_misccharges
	datetime ldt_server_datetime
	string ls_date_errtext
	datawindowchild ldc_headerno
	double ld_stock
	double ld_newstock
	double ld_salelooseqty
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	wf_deleteemptydetailrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	if f_stringpreferences("Salesalesmanwindow") = "Y" then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_invid = this.id_master.getitemnumber(ll_mastercurrrow, "code")
		if isnull(ll_invid) then
			wf_tabnewid("ProdHeader", ll_invid)
			if ll_invid > 0 then
				this.id_master.setitem(ll_mastercurrrow, "code", ll_invid)
			end if
		end if
		if this.ib_modify then
			this.id_master.setitem(ll_mastercurrrow, "modifiedby", ll_salesmancode)
			lb_continue = true
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
		else
			if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return
			end if
			this.id_master.setitem(ll_mastercurrrow, "Originaldate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "date", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "Postdate", ldt_server_datetime)
			this.id_master.setitem(ll_mastercurrrow, "CreatedBy", ll_salesmancode)
		end if
		for ll_counter = 1 to this.id_detail.rowcount()
			this.id_detail.setitem(ll_counter, "code", ll_invid)
		next
		if lb_continue then
			call super::ue_save
			if this.ib_commitok then
				if f_stringpreferences("AutoPostProduction") = "Y" then
					ll_retcode = this.it_transobject.postproduction(ll_invid, ll_salesmancode, 1, ldt_server_datetime)
					if this.it_transobject.sqlcode <> 0 or ll_retcode <> 0 then
						messagebox("Posting Fail For Production : " + string(ll_invid), "Reasons are:~r~n" + this.it_transobject.sqlerrtext)
						SQL rollback USING this.it_transobject;
					else
						SQL commit USING this.it_transobject;
						messagebox("Posting Status", "Posting Successful")
					end if
				end if
				this.ib_modify = false
			end if
			if f_stringpreferences("IncProdInActMonitor") = "Y" then
				this.it_transobject.updateactivitymonitor("PD", ll_invid)
				if this.it_transobject.sqlcode <> 0 then
					SQL rollback USING this.it_transobject;
					messagebox("Activity Monitor", "Problem in updating activity monitor.~r~nReasons are:- " + this.it_transobject.sqlerrtext)
				else
					SQL commit USING this.it_transobject;
				end if
			end if
		end if
		if not lb_continue then
			SQL rollback USING this.it_transobject;
			messagebox("Updation Error", ls_errtext + " in current row", stopsign!)
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_production.ue_newform() returns 0
	m_productionmenu lm_menu
	integer rtncode
	long li_fetched_code
	long row
	long ll_manfcode
	lm_menu = this.menuid
	lm_menu.m_file.m_finalize.enabled = false
	lm_menu.m_file.m_finalize.toolbaritemvisible = false
	lm_menu.m_file.m_postissue.enabled = false
	lm_menu.m_file.m_postissue.toolbaritemvisible = false
	lm_menu.m_file.m_postreceipt.enabled = false
	lm_menu.m_file.m_postreceipt.toolbaritemvisible = false
	setredraw(false)
	this.idc_section.reset()
	this.idc_section.insertrow(0)
	call super::ue_newform
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	this.im_menu.m_file.m_print.enabled = true
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	this.ib_modify = false
	wf_setgodownoption()
	this.id_footer.setitem(1, "invdiscperc", f_numberpreferences("invdiscperc"))
	if not wf_validatedate() then
		close(this)
		return
	end if
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	wf_visible(true)
	setredraw(true)

// w_production.ue_detail() returns 0
	integer li_rtncode
	integer li_protect
	long ll_row
	long ll_code
	long ll_deptcode
	long ll_rowcount
	boolean lb_flag
	boolean lb_modify
	m_productionmenu lm_menu
	lm_menu = this.menuid
	lm_menu.m_file.m_finalize.enabled = false
	lm_menu.m_file.m_finalize.toolbaritemvisible = false
	lm_menu.m_file.m_postissue.enabled = false
	lm_menu.m_file.m_postissue.toolbaritemvisible = false
	lm_menu.m_file.m_postreceipt.enabled = false
	lm_menu.m_file.m_postreceipt.toolbaritemvisible = false
	setredraw(false)
	ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
	this.id_master.retrieve(ll_code)
	call super::ue_detail
	this.im_menu.m_file.m_post.enabled = false
	ll_code = this.id_master.object.code[this.id_master.rowcount()]
	if this.id_master.object.posted[this.id_master.getrow()] = "N" and this.id_master.object.finalized[this.id_master.getrow()] = "N" then
		li_protect = 0
	end if
	wf_initmodify(li_protect)
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	if li_protect = 0 then
		lb_flag = true
	end if
	wf_visible(lb_flag)
	wf_grandtotal()
	setredraw(true)

// w_production.ue_newitem() returns 0
	long ll_rowcount
	if this.ib_itemvalidated = false and wf_validateitem(true) = -1 then
		this.id_detail.setfocus()
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.setcolumn(this.is_columnitemname)
	else
		this.id_detail.setcolumn("fullcode")
	end if
	this.id_detail.insertrow(0)
	ll_rowcount = this.id_detail.rowcount()
	if ll_rowcount > 1 then
		this.id_detail.scrolltorow(ll_rowcount)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.ib_validatefullcode = true
	this.ii_defaultgcode = this.ii_salegodown

// w_production.ue_deleteitem() returns 0
	long ll_row
	long ll_footerrow
	call super::ue_deleteitem
	ll_row = this.id_detail.getrow()
	ll_footerrow = this.id_footer.getrow()
	if this.id_detail.rowcount() > 0 then
		this.id_footer.setitem(ll_footerrow, "icode", this.id_detail.getitemnumber(ll_row, "icode"))
		this.id_footer.setitem(ll_footerrow, "stock", this.id_detail.getitemnumber(ll_row, "stock"))
		this.im_menu.m_file.m_print.enabled = true
		return
	end if
	this.id_footer.setitem(ll_footerrow, "icode", 0)
	this.id_footer.setitem(ll_footerrow, "stock", 0)
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_save.enabled = false

// w_production.close() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	this.id_itemslist.sharedataoff()
	return ::message.returnvalue

// w_production.ue_list() returns 0
	m_productionmenu lm_menu
	call super::ue_list
	lm_menu = this.menuid
	lm_menu.m_file.m_finalize.enabled = true
	lm_menu.m_file.m_finalize.toolbaritemvisible = true
	lm_menu.m_file.m_postissue.enabled = true
	lm_menu.m_file.m_postissue.toolbaritemvisible = true
	lm_menu.m_file.m_postreceipt.enabled = true
	lm_menu.m_file.m_postreceipt.toolbaritemvisible = true
	SQL rollback USING this.it_transobject;
	this.ib_modify = false
	this.id_itemslist.hide()
	if this.id_detail.rowcount() > 0 then
		postevent("ue_deleteitem")
	end if
	wf_retrievelist()
	this.im_menu.m_file.m_post.enabled = true
	postevent("ue_enableprint")

// w_production.ue_print() returns 0
	integer li_option
	long ll_row
	long ll_invcode
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		if this.ib_modify then
			li_option = messagebox("Save Changes", "Do you want to save invoice", information!, yesno!, 2)
			if li_option = 1 then
				triggerevent("ue_save")
				if wf_commitform() = false then
					return
				end if
				return
			end if
		else
			triggerevent("ue_save")
			if wf_commitform() = false then
				return
			end if
		end if
		return
	end if
	wf_selectprintreport()
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.id_print.rowcount() > 0 then
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print Invoice", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_production.ue_refreshddw() returns 0
	call super::ue_refreshddw
	if this.ii_saletype <> 3 then
		setpointer(hourglass!)
		setpointer(arrow!)
	end if

// w_production.ue_new() returns 0
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_production.ue_postopen() returns 0
	m_productionmenu lm_menu
	integer li_rtncode
	long ll_counter
	long ll_pos
	long ll_found
	call super::ue_postopen
	lm_menu = this.menuid
	lm_menu.dynamic mf_initsecurityapp(lm_menu)
	setredraw(false)
	this.id_print = this.dw_saleinvrep
	this.id_saleinvdetail = this.dw_saleinvdetail
	this.id_saleinvdetail.settransobject(this.it_transobject)
	this.il_groupcode = f_getgroupcode(gl_usercode)
	this.il_strategy = f_groupgodownstrategy(this.ii_module, this.il_groupcode)
	this.il_godowncount = f_groupallowedgodowncount(this.ii_module, this.il_groupcode)
	this.il_strategy2 = f_groupgodownstrategy(this.ii_module2, this.il_groupcode)
	this.il_godowncount2 = f_groupallowedgodowncount(this.ii_module2, this.il_groupcode)
	this.ii_salegodown = 1
	if isnull(this.il_groupcode) then
		messagebox("Problem identifying User Group", "Contact System Administrator for your group settings.")
		close(this)
		return
	end if
	if isnull(this.il_strategy) or this.il_strategy = 1 and this.il_godowncount = 0 then
		messagebox("Error", "Your Godown Settings do not permit Issue of Stock")
	end if
	if isnull(this.il_strategy2) or this.il_strategy2 = 1 and this.il_godowncount2 = 0 then
		messagebox("Error", "Your Godown Settings do not permit Receipt of Stock")
		close(this)
		return
	end if
	li_rtncode = this.id_master.getchild("Issuegcode", this.idc_issuegodown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild for Issue Godown")
		close(this)
		return
	end if
	this.idc_issuegodown.settransobject(this.it_transobject)
	li_rtncode = this.idc_issuegodown.retrieve(this.il_groupcode, this.ii_module, this.il_strategy)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to Issue")
		close(this)
		return
	end if
	li_rtncode = this.id_master.getchild("Receiptgcode", this.idc_receiptgodown)
	if li_rtncode = -1 then
		messagebox("Error", "Can not get a DataWindowChild for Receipt Godown")
		close(this)
		return
	end if
	this.idc_receiptgodown.settransobject(this.it_transobject)
	li_rtncode = this.idc_receiptgodown.retrieve(this.il_groupcode, this.ii_module2, this.il_strategy2)
	if li_rtncode = -1 then
		messagebox("Error", "Not Enough Godown Rights to Receipt")
		close(this)
		return
	end if
	wf_retrieve_itemslist()
	this.id_footer.object.t_totalstock.visible = false
	this.id_footer.object.totalstock.visible = false
	this.id_itemslist.object.t_stock.visible = false
	this.id_itemslist.object.stock.visible = false
	this.id_itemslist.object.t_sstock.visible = true
	this.id_itemslist.object.sstock.visible = true
	this.id_itemslist.object.t_pstock.visible = false
	this.id_itemslist.object.pstock.visible = false
	if f_stringpreferences("manufacturer") = "N" then
		this.id_itemslist.object.manufacturer.visible = false
	end if
	if f_stringpreferences("itemname") = "N" then
		this.id_itemslist.object.itemname.visible = false
	end if
	if f_stringpreferences("packing") = "N" then
		this.id_itemslist.object.packing.visible = false
	end if
	if f_stringpreferences("packunits") = "N" then
		this.id_itemslist.object.packunits.visible = false
	end if
	if f_stringpreferences("saleprice") = "N" then
		this.id_itemslist.object.saleprice.visible = false
	end if
	if f_stringpreferences("showitemalertinitemlist") = "N" then
		this.id_itemslist.object.itemalertcode.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 587", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.id_itemslist.object.purprice.visible = true
	else
		this.id_itemslist.object.purprice.visible = false
	end if
	if f_stringpreferences("stock") = "N" then
		this.id_itemslist.object.sstock.visible = false
	end if
	if f_stringpreferences("itemcode") = "N" then
		this.id_detail.object.fullcode.visible = false
	end if
	this.id_detail.object.batch.initial = f_stringpreferences("defaultbatch")
	this.id_detail.object.expiry.initial = string(f_datepreferences("defaultexpiry"))
	f_setcolumnstyle(this.id_detail, "Qty")
	this.id_footer.reset()
	this.id_footer.insertrow(0)
	this.id_footer.scrolltorow(0)
	setredraw(true)
