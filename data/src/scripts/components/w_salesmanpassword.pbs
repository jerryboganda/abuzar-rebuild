// window w_salesmanpassword (components)  ancestor: window

// w_salesmanpassword.ue_close() returns 0 [event]
	closewithreturn(this, this.ii_salesmancode)

// w_salesmanpassword.closequery() returns long [event]
	if this.ib_close = false then
		return 1
	end if
	return ::message.returnvalue

// w_salesmanpassword.create() returns 0 [event]
	this.cb_ok = create cb_ok
	this.cb_cancel = create cb_cancel
	this.dw_password = create dw_password
	this.control = {this.cb_ok, this.cb_cancel, this.dw_password}

// w_salesmanpassword.destroy() returns 0 [event]
	destroy this.cb_ok
	destroy this.cb_cancel
	destroy this.dw_password

// w_salesmanpassword.open() returns long [event]
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	this.id_password = this.dw_password
	this.dw_password.insertrow(0)
	return ::message.returnvalue

// w_salesmanpassword.close() returns long [event]
	hide()
	return ::message.returnvalue

// cb_ok.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	w_salesmanpassword w_parent
	long ll_found
	string ls_password
	integer li_usercode
	if f_validatedw(parent.id_password) < 0 then
		return ::message.returnvalue
	end if
	li_usercode = parent.id_password.getitemnumber(1, "salesmancode")
	ls_password = parent.id_password.getitemstring(1, "password")
	SQL Select count ( *) INTO :ll_found From users Where users.usercode =:li_usercode and password =:ls_password And Active ='Y' USING sqlca;
	if sqlca.sqlcode = 0 then
		if isnull(ll_found) or ll_found <= 0 then
			messagebox("User Validation", "Either username or password is invalid.")
			parent.id_password.setcolumn("salesmancode")
			parent.id_password.setfocus()
			return ::message.returnvalue
		end if
	else
		messagebox("User Validation", "Either username/password is invalid or User is marked InActive.~r~nKindly consult your Administrator.")
		parent.id_password.setcolumn("salesmancode")
		parent.id_password.setfocus()
		return ::message.returnvalue
	end if
	parent.ii_salesmancode = li_usercode
	parent.ib_close = true
	w_parent = getparent()
	w_parent.setfocus()
	closewithreturn(w_parent, parent.ii_salesmancode)
	return ::message.returnvalue

// cb_cancel.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	w_salesmanpassword w_parent
	parent.ib_close = true
	w_parent = getparent()
	w_parent.setfocus()
	closewithreturn(w_parent, -1)
	return ::message.returnvalue

// dw_password.ue_close() returns 0 [event]
	integer li_salesmancode
	w_salesmanpassword w_parent
	li_salesmancode = getitemnumber(1, "salesmancode")
	w_parent = getparent()
	closewithreturn(w_parent, li_salesmancode)

// dw_password.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_salesmancode
	integer li_null
	string ls_salesman
	string ls_password
	string ls_null
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "salesmancode"
		li_salesmancode = integer(data)
		SQL Select dbo.users.username , dbo.users.password INTO :ls_salesman, :ls_password From users Where users.usercode =:li_salesmancode And Active ='Y' USING sqlca;
		setnull(li_null)
		if sqlca.sqlcode = 0 then
			if isnull(ls_salesman) then
				this.object.name[row] = ""
				this.object.salesmancode[row] = li_null
				return 1
			else
				this.object.name[row] = ls_salesman
				parent.is_password = ls_password
			end if
		else
			this.object.salesmancode[row] = li_null
			return 1
		end if
	case "password"
		setnull(ls_null)
		if lower(data) <> lower(parent.is_password) then
			this.object.password[row] = ls_null
			return 1
		end if
	end choose
	return ::message.returnvalue

// dw_password.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_salesmancode
	string ls_salesman
	string ls_password
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "salesmancode"
		if isnull(data) then
			messagebox("Salesman Validation", "Salesman does not exist,~n~rPlease enter some valid Salesman code.")
		end if
	case "password"
		if isnull(data) then
			messagebox("Password Validation", "Kindly give valid Password.")
		end if
	end choose
	return 1

// dw_password.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	if getcolumn() = 3 then
		parent.cb_ok.postevent(clicked!)
	end if
	send(handle(this), 256, 9, long(90))
	return 1
