// userobject u_utilityservices (components)  ancestor: nonvisualobject

// u_utilityservices.of_getcomputername() returns string
	string ls_env_name
	string ls_env_val
	long ll_env_len
	ls_env_name = "COMPUTERNAME"
	ls_env_val = space(20)
	ll_env_len = 20
	ll_env_len = getenvironmentvariablea(ls_env_name, ls_env_val, ll_env_len)
	return ls_env_val

// u_utilityservices.create() returns 0 [event]
	call super::create
	triggerevent("constructor")

// u_utilityservices.destroy() returns 0 [event]
	triggerevent("destructor")
	call super::destroy
