// userobject u_transaction (components)  ancestor: transaction

// u_transaction.create() returns 0 [event]
	call super::create
	triggerevent("constructor")

// u_transaction.destroy() returns 0 [event]
	triggerevent("destructor")
	call super::destroy

// u_transaction.constructor() returns long [event]
	this.dbms = "OLE DB"
	this.logid = "sa"
	this.lock = "RC"
	this.logpass = gs_password
	this.autocommit = false
	this.dbparm = "PROVIDER='SQLOLEDB',DATASOURCE='" + gs_servername + "',CommitOnDisconnect='No',PROVIDERSTRING='DataBase=" + gs_dbname + ";APP=" + gs_app + ";WSID=" + gs_localcomputername + "',PBTrimCharColumns='Yes',StripParmNames='Yes',PBMaxBlobSize=999999999999"
	return ::message.returnvalue
