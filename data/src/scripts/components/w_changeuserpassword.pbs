// window w_changeuserpassword (components)  ancestor: window

// w_changeuserpassword.create() returns 0
	this.sle_salesman = create sle_salesman
	this.sle_newpassword2 = create sle_newpassword2
	this.sle_newpassword1 = create sle_newpassword1
	this.sle_oldpassword = create sle_oldpassword
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.st_newpassword2 = create st_newpassword2
	this.st_newpassword1 = create st_newpassword1
	this.st_oldpassword = create st_oldpassword
	this.st_salesman = create st_salesman
	this.control = {this.sle_salesman, this.sle_newpassword2, this.sle_newpassword1, this.sle_oldpassword, this.cb_cancel, this.cb_ok, this.st_newpassword2, this.st_newpassword1, this.st_oldpassword, this.st_salesman}

// w_changeuserpassword.destroy() returns 0
	destroy this.sle_salesman
	destroy this.sle_newpassword2
	destroy this.sle_newpassword1
	destroy this.sle_oldpassword
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.st_newpassword2
	destroy this.st_newpassword1
	destroy this.st_oldpassword
	destroy this.st_salesman

// w_changeuserpassword.open() returns long
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	return ::message.returnvalue

// sle_salesman.enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// sle_salesman.modified() returns long
	return ::message.returnvalue

// sle_newpassword2.modified() returns long
	return ::message.returnvalue

// sle_newpassword2.enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// sle_newpassword1.modified() returns long
	return ::message.returnvalue

// sle_newpassword1.enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// sle_oldpassword.enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
	end if
	return ::message.returnvalue

// sle_oldpassword.modified() returns long
	return ::message.returnvalue

// cb_cancel.enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	close(parent)
	return ::message.returnvalue

// cb_ok.enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	string ls_oldpassword
	string ls_password
	string ls_username
	string ls_newpassword1
	string ls_newpassword2
	ls_username = lower(parent.sle_salesman.text)
	ls_oldpassword = lower(parent.sle_oldpassword.text)
	ls_newpassword1 = lower(parent.sle_newpassword1.text)
	ls_newpassword2 = lower(parent.sle_newpassword2.text)
	SQL Select users.password INTO :ls_password From users Where lower ( users.username ) =:ls_username USING sqlca;
	if sqlca.sqlcode <> 0 then
		messagebox("Database Error", "Some database request has been fail~r~nNo changes made to your password")
	elseif isnull(ls_password) then
		messagebox("Name Validation", "Your name is incorrect, Enter again")
		parent.sle_salesman.setfocus()
	elseif lower(ls_password) <> ls_oldpassword then
		messagebox("Password Validation", "Your current password is incorrect, Enter again")
		parent.sle_oldpassword.setfocus()
	elseif ls_newpassword1 <> ls_newpassword2 then
		messagebox("New Password Validation", "Your new password does not match the confirmation password, Enter again")
		parent.sle_newpassword1.setfocus()
	else
		SQL update users set users.password =:ls_newpassword1 From users Where users.username =:ls_username USING sqlca;
		if sqlca.sqlcode <> 0 then
			messagebox("Database Error", "Some database problem has occur")
		else
			messagebox("Pasword Changes", "Your password now has been changed")
			close(parent)
		end if
	end if
	return ::message.returnvalue
