// m_saleorder.clicked() returns 0
	integer ll_count
	integer li_continue
	integer li_catcode
	string ls_catname
	s_arguements lstr_info
	w_salesorder lw_sheet
	SQL SELECT ISNULL ( COUNT ( *) , 0 ) INTO :ll_count FROM SaleOrderCategory WHERE Posted ='Y' USING sqlca;
	if sqlca.sqlcode = 0 then
		if ll_count = 0 then
			messagebox("Sale Order", "Unable to fetch any posted saleorder category~r~nPlease ensure that there exists atleast one valid posted sale order category", information!)
		elseif ll_count = 1 then
			SQL SELECT SOCatCode , Name INTO :li_catcode, :ls_catname FROM SaleOrderCategory USING sqlca;
			if sqlca.sqlcode = 0 then
				lstr_info.l_code1 = li_catcode
				lstr_info.s_name1 = ls_catname
				lstr_info.i_status = 1
				li_continue = 1
			else
				messagebox("Sale Order", "Unable to fetch any posted saleorder category~r~nPlease ensure that there exists atleast one valid posted sale order category", information!)
			end if
		else
			open(w_select_postedsaleordercategory)
			lstr_info = message.powerobjectparm
			li_continue = 1
		end if
	else
		messagebox("Sale Order", "Unable to fetch any posted saleorder category~r~nDetails are:-~r~n" + sqlca.sqlerrtext, stopsign!)
	end if
	if li_continue = 1 and (lstr_info.l_code1 > 0 and lstr_info.i_status = 1) then
		opensheetwithparm(lw_sheet, lstr_info, this.parentwindow, 0, layered!)
	end if

