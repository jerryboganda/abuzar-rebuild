	string ls_date
	w_purchase lw_sheet
	SQL Select stat , flag , convert ( datetime , fcatvalue ) INTO :ll_stat, :ll_flag, :ldt_fcatvalue From syscatelog Where fcatid =2 USING sqlca;
	ls_date = string(today(), "mm/dd/yy")
	if ll_stat = 1 then
		if ll_flag = 0 then
			if date(ls_date) >= date(ldt_fcatvalue) then
				SQL rollback USING sqlca;
				SQL update syscatelog Set flag =1 Where fcatid =2 USING sqlca;
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					messagebox("pbr7.exe", "An Internal Error has Occoured~r~n a null object is reference", stopsign!)
					return
				else
					SQL rollback USING sqlca;
				end if
			end if
		else
			messagebox("pbr7.exe", "An Internal Error has Occoured~r~n a null object is reference", stopsign!)
			return
		end if
		return
	end if
	SQL Select stat , flag , fcatvalue INTO :ll_stat, :ll_flag, :ll_fcatvalue From syscatelog Where fcatid =3 USING sqlca;
	if ll_stat = 1 then
		if ll_flag = 0 then
			SQL Select tabmaxkey INTO :ll_saleinvcode FROM _tabmaxkey Where Tabname ='PurLedger' USING sqlca;
			if ll_saleinvcode >= ll_fcatvalue then
				SQL rollback USING sqlca;
				SQL update syscatelog Set flag =1 Where fcatid =3 USING sqlca;
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					messagebox("pbr7.exe", "An Internal Error has Occoured~r~n a null object is reference", stopsign!)
					return
