// m_proformasaleinvoice.clicked() returns 0
	long ll_stat
	long ll_flag
	long ll_fcatvalue
	long ll_saleinvcode
	datetime ldt_fcatvalue
	string ls_date
	w_proforma_saleinvoice lw_sheet
	SQL Select stat , flag , convert ( datetime , fcatvalue ) INTO :ll_stat, :ll_flag, :ldt_fcatvalue From syscatelog Where fcatid =4 USING sqlca;
	ls_date = string(today(), "mm/dd/yy")
	if ll_stat = 1 then
		if ll_flag = 0 then
			if date(ls_date) >= date(ldt_fcatvalue) then
				SQL rollback USING sqlca;
				SQL update syscatelog Set flag =1 Where fcatid =4 USING sqlca;
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					messagebox("Error", "An Internal Error has Occoured~r~n Please Consult Abuzar Consultancy Support Team")
					return
				else
					SQL rollback USING sqlca;
				end if
			end if
		else
			messagebox("Error", "An Internal Error has Occoured~r~n Please Consult Abuzar Consultancy Support Team")
			return
		end if
		return
	end if
	SQL Select stat , flag , fcatvalue INTO :ll_stat, :ll_flag, :ll_fcatvalue From syscatelog Where fcatid =5 USING sqlca;
	if ll_stat = 1 then
		if ll_flag = 0 then
			SQL Select tabmaxkey INTO :ll_saleinvcode FROM _tabmaxkey Where Tabname ='SaleLedger' USING sqlca;
			if ll_saleinvcode >= ll_fcatvalue then
				SQL rollback USING sqlca;
				SQL update syscatelog Set flag =1 Where fcatid =5 USING sqlca;
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					messagebox("Error", "An Internal Error has Occoured~r~n Please Consult Abuzar Consultancy Support Team")
					return
				else
					SQL rollback USING sqlca;
				end if
			end if
		else
			messagebox("Error", "An Internal Error has Occoured~r~n Please Consult Abuzar Consultancy Support Team")
			return
		end if
		return
	end if
	opensheetwithparm(lw_sheet, 2, this.parentwindow, 0, layered!)

