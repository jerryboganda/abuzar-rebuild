	char lc_type
	s_arguements lstr_arg
	open(w_select_manf_cat_class_pack_saleorder)
	lc_type = message.stringparm
	if lc_type = "" or isnull(lc_type) then
		return
	end if
	if lc_type = "S" then
		open(w_arg_saleorder)
	else
		openwithparm(w_arg_manfs_cats_classes_packs, lc_type)
	end if
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
		lstr_arg.s_name1 = lc_type
		openwithparm(w_item_update, lstr_arg)
	end if

