// m_intergodowntransfer1.clicked() returns 0
	long ll_rows
	w_transfer lw_sheet
	SQL SELECT COUNT ( gcode ) INTO :ll_rows FROM godown USING sqlca;
	if ll_rows > 1 then
		opensheetwithparm(lw_sheet, 1, this.parentwindow, 0, layered!)
		return
	end if
	messagebox("Item Godown Transfer", "Atleast two godowns required to use this part of software")

