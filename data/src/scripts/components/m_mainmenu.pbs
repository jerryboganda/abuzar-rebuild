// m_changeitempsprice.clicked() returns 0
	string ls_reportname
	w_changeitem_price lw_sheet
	w_change_item_prices lw_sheet1
	w_change_item_prices2 lw_sheet2
	open(w_filter_changeitem_price)
	ls_reportname = message.stringparm
	if ls_reportname = "" then
		return
	end if
	if not isnull(ls_reportname) then
		if ls_reportname = "MANF_WISE" or ls_reportname = "CLASS_WISE" or ls_reportname = "CAT_WISE" or ls_reportname = "PACKING_WISE" or ls_reportname = "GENERICNAME_WISE" or ls_reportname = "PURINVBASED" or ls_reportname = "MARGINBASED" then
			opensheetwithparm(lw_sheet, ls_reportname, this.parentwindow, 0, layered!)
			return
		end if
		if ls_reportname = "CAT_PACK_MANF_WISE" then
			opensheetwithparm(lw_sheet1, 1, this.parentwindow, 0, layered!)
			return
		end if
		if ls_reportname = "CAT_PACK_MANF_CLASS_WISE" then
			opensheetwithparm(lw_sheet2, 1, this.parentwindow, 0, layered!)
		end if
	end if

