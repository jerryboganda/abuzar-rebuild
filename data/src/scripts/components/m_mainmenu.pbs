// m_mainmenu.mf_open_receipt(integer ai_mode) returns integer
	integer ll_count
	integer li_continue
	integer li_catcode
	string ls_catname
	char lc_accountfor
	s_arguements lstr_info
	w_receipt lw_sheet
	SQL SELECT ISNULL ( COUNT ( *) , 0 ) INTO :ll_count FROM ReceiptCategory WHERE Posted ='Y' AND Enabled ='Y' USING sqlca;
	if sqlca.sqlcode = 0 then
		if ll_count = 0 then
			messagebox("Receipt", "Unable to fetch any posted Receipt Category~r~nPlease ensure that there exists atleast one valid posted Receipt Category", information!)
		elseif ll_count = 1 then
			SQL SELECT ReceiptCategoryCode , Name , AccountFor INTO :li_catcode, :ls_catname, :lc_accountfor FROM ReceiptCategory WHERE Posted ='Y' AND Enabled ='Y' USING sqlca;
			if sqlca.sqlcode = 0 then
				lstr_info.l_code1 = li_catcode
				lstr_info.l_code2 = ai_mode
				lstr_info.s_name1 = ls_catname
				lstr_info.s_name2 = lc_accountfor
				lstr_info.i_status = 1
				li_continue = 1
			else
				messagebox("Receipt", "Unable to fetch any posted Receipt Category~r~nPlease ensure that there exists atleast one valid posted Receipt Category", information!)
			end if
		else
			open(w_select_postedreceiptcategory)
			lstr_info = message.powerobjectparm
			lstr_info.i_status = 1
			lstr_info.l_code2 = ai_mode
			li_continue = 1
		end if
	else
		messagebox("Receipt", "Unable to fetch any posted Receipt category~r~nDetails are:-~r~n" + sqlca.sqlerrtext, stopsign!)
	end if
	if li_continue = 1 and (lstr_info.l_code1 > 0 and lstr_info.i_status = 1) then
		opensheetwithparm(lw_sheet, lstr_info, this.parentwindow, 0, layered!)
	end if
	return 0

// m_mainmenu.mf_open_issue(integer ai_mode) returns long
	integer ll_count
	integer li_continue
	integer li_catcode
	string ls_catname
	char lc_accountfor
	s_arguements lstr_info
	w_issue lw_sheet
	SQL SELECT ISNULL ( COUNT ( *) , 0 ) INTO :ll_count FROM IssueCategory WHERE Posted ='Y' AND Enabled ='Y' USING sqlca;
	if sqlca.sqlcode = 0 then
		if ll_count = 0 then
			messagebox("Issue", "Unable to fetch any posted Issue Category~r~nPlease ensure that there exists atleast one valid posted Issue Category", information!)
		elseif ll_count = 1 then
			SQL SELECT IssueCategoryCode , Name , AccountFor INTO :li_catcode, :ls_catname, :lc_accountfor FROM IssueCategory WHERE Posted ='Y' AND Enabled ='Y' USING sqlca;
			if sqlca.sqlcode = 0 then
				lstr_info.l_code1 = li_catcode
				lstr_info.l_code2 = ai_mode
				lstr_info.s_name1 = ls_catname
				lstr_info.s_name2 = lc_accountfor
				lstr_info.i_status = 1
				li_continue = 1
			else
				messagebox("Issue", "Unable to fetch any posted Issue Category~r~nPlease ensure that there exists atleast one valid posted Issue Category", information!)
			end if
		else
			open(w_select_postedissuecategory)
			lstr_info = message.powerobjectparm
			lstr_info.i_status = 1
			lstr_info.l_code2 = ai_mode
			li_continue = 1
		end if
	else
		messagebox("Issue", "Unable to fetch any posted Issue category~r~nDetails are:-~r~n" + sqlca.sqlerrtext, stopsign!)
	end if
	if li_continue = 1 and (lstr_info.l_code1 > 0 and lstr_info.i_status = 1) then
		opensheetwithparm(lw_sheet, lstr_info, this.parentwindow, 0, layered!)
	end if
	return 0

