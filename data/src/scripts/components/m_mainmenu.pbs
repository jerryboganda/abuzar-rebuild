// m_logoffadministrator.clicked() returns 0
	integer li_option
	window wsheet
	string wname
	wsheet = this.parentwindow.getactivesheet()
	if isvalid(wsheet) then
		messagebox("Change User", "Kindly Close all the open windows/sheets then try again.", stopsign!)
		return
	end if
	li_option = messagebox("Change User", "Are you sure you want to change current user with another?", question!, yesno!, 2)
	if li_option = 1 then
		getapplication().triggerevent(close!)
		restart()
		return
	end if

