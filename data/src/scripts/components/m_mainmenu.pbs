// menu m_mainmenu (components)  ancestor: menu

// m_mainmenu.mf_openvoucher(integer ai_vochcatcode, string as_title, string as_headeracctype, string as_detailacctype) returns 0
	w_voucher lw_sheet
	s_arguements ls_voucherinfo
	ls_voucherinfo.l_code1 = ai_vochcatcode
	ls_voucherinfo.s_name1 = as_title
	ls_voucherinfo.s_name2 = as_headeracctype
	ls_voucherinfo.s_name3 = as_detailacctype
	opensheetwithparm(lw_sheet, ls_voucherinfo, this.parentwindow, 0, layered!)

// m_mainmenu.mf_getstatus(integer ai_status) returns boolean
	if ai_status = 1 then
		return true
	end if
	return false

// m_mainmenu.mf_findindex(integer ai_indexno, string as_indicesstring) returns integer
	integer li_countcommas
	integer li_counter
	integer li_index
	long ll_startingstrpos
	long ll_endingstrpos
	li_countcommas = ai_indexno - 1
	do while li_counter < li_countcommas
		ll_startingstrpos = pos(as_indicesstring, ",", ll_startingstrpos)
		ll_startingstrpos = ll_startingstrpos + 1
		li_counter = li_counter + 1
	loop
	ll_endingstrpos = pos(as_indicesstring, ",", ll_startingstrpos)
	li_index = integer(mid(as_indicesstring, ll_startingstrpos, ll_endingstrpos - ll_startingstrpos))
	return li_index

// m_mainmenu.mf_initsecurityapp(menu am_menu) returns integer
	integer li_retcode
	integer li_levelindex
	integer li_status
	long ll_counter
	string ls_indicesstring
	dwruntimeerror exdw
	nullobjecterror exnullobj
	runtimeerror ex
	dwruntimeerror exdw2
	nullobjecterror exnullobj2
	runtimeerror ex2
	dwruntimeerror exdw3
	nullobjecterror exnullobj3
	runtimeerror ex3
	dwruntimeerror exdw4
	nullobjecterror exnullobj4
	runtimeerror ex4
	dwruntimeerror exdw5
	nullobjecterror exnullobj5
	runtimeerror ex5
	dwruntimeerror exdw6
	nullobjecterror exnullobj6
	runtimeerror ex6
	for ll_counter = 1 to gl_securityrowcount
		li_levelindex = gds_security.object.levelindex[ll_counter]
		li_status = gds_security.object.status[ll_counter]
		ls_indicesstring = gds_security.object.indicesstring[ll_counter]
		if ll_counter > 98 then
			ll_counter = ll_counter
		end if
		choose case li_levelindex
		case 1
			try
				am_menu.item[mf_findindex(1, ls_indicesstring)].visible = mf_getstatus(li_status)
				am_menu.item[mf_findindex(1, ls_indicesstring)].enabled = mf_getstatus(li_status)
			catch (throwable exdw)
			catch (throwable exnullobj)
			catch (throwable ex)
			end try
		case 2
			try
				am_menu.item[mf_findindex(1, ls_indicesstring)].item[mf_findindex(2, ls_indicesstring)].visible = mf_getstatus(li_status)
				am_menu.item[mf_findindex(1, ls_indicesstring)].item[mf_findindex(2, ls_indicesstring)].enabled = mf_getstatus(li_status)
			catch (throwable exdw2)
			catch (throwable exnullobj2)
			catch (throwable ex2)
			end try
		case 3
			try
				am_menu.item[mf_findindex(1, ls_indicesstring)].item[mf_findindex(2, ls_indicesstring)].item[mf_findindex(3, ls_indicesstring)].visible = mf_getstatus(li_status)
				am_menu.item[mf_findindex(1, ls_indicesstring)].item[mf_findindex(2, ls_indicesstring)].item[mf_findindex(3, ls_indicesstring)].enabled = mf_getstatus(li_status)
			catch (throwable exdw3)
			catch (throwable exnullobj3)
			catch (throwable ex3)
			end try
		case 4
			try
				am_menu.item[mf_findindex(1, ls_indicesstring)].item[mf_findindex(2, ls_indicesstring)].item[mf_findindex(3, ls_indicesstring)].item[mf_findindex(4, ls_indicesstring)].visible = mf_getstatus(li_status)
				am_menu.item[mf_findindex(1, ls_indicesstring)].item[mf_findindex(2, ls_indicesstring)].item[mf_findindex(3, ls_indicesstring)].item[mf_findindex(4, ls_indicesstring)].enabled = mf_getstatus(li_status)
			catch (throwable exdw4)
			catch (throwable exnullobj4)
			catch (throwable ex4)
			end try
		case 5
			try
				am_menu.item[mf_findindex(1, ls_indicesstring)].item[mf_findindex(2, ls_indicesstring)].item[mf_findindex(3, ls_indicesstring)].item[mf_findindex(4, ls_indicesstring)].item[mf_findindex(5, ls_indicesstring)].visible = mf_getstatus(li_status)
				am_menu.item[mf_findindex(1, ls_indicesstring)].item[mf_findindex(2, ls_indicesstring)].item[mf_findindex(3, ls_indicesstring)].item[mf_findindex(4, ls_indicesstring)].item[mf_findindex(5, ls_indicesstring)].enabled = mf_getstatus(li_status)
			catch (throwable exdw5)
			catch (throwable exnullobj5)
			catch (throwable ex5)
			end try
		case 6
			try
				am_menu.item[mf_findindex(1, ls_indicesstring)].item[mf_findindex(2, ls_indicesstring)].item[mf_findindex(3, ls_indicesstring)].item[mf_findindex(4, ls_indicesstring)].item[mf_findindex(5, ls_indicesstring)].item[mf_findindex(6, ls_indicesstring)].visible = mf_getstatus(li_status)
				am_menu.item[mf_findindex(1, ls_indicesstring)].item[mf_findindex(2, ls_indicesstring)].item[mf_findindex(3, ls_indicesstring)].item[mf_findindex(4, ls_indicesstring)].item[mf_findindex(5, ls_indicesstring)].item[mf_findindex(6, ls_indicesstring)].enabled = mf_getstatus(li_status)
			catch (throwable exdw6)
			catch (throwable exnullobj6)
			catch (throwable ex6)
			end try
		end choose
	next
	return li_retcode

