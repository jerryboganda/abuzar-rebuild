// m_itemslist.clicked() returns 0
	string ls_reportobject
	string ls_reporttitle
	open(w_filter_for_itemlist_rep)
	ls_reportobject = message.stringparm
	if ls_reportobject = "" then
		return
	end if
	if not isnull(ls_reportobject) then
		choose case ls_reportobject
		case "d_itemlist_manfwise"
			ls_reporttitle = "Item List: Manufacturer Wise"
		case "d_itemlist_catmanfwise"
			ls_reporttitle = "Item List: Manufacturer And Category Wise"
		case "d_itemlist_catclassmanfwise"
			ls_reporttitle = "Item List: Manufacturer, Category And Class Wise"
		case "d_itemlist_rep"
			ls_reporttitle = "Item List: All Items"
		end choose
	end if
	parent.parent.parent.mf_displayreport(ls_reporttitle, ls_reportobject)

