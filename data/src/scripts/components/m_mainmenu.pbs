	open(w_arg_group)
	lstr_arg = message.powerobjectparm
	if not isnull(lstr_arg.l_code1) and lstr_arg.i_status = 1 then
		opensheetwithparm(lw_sheet, lstr_arg.l_code3, this.parentwindow, 0, layered!)
	end if

