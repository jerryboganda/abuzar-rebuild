// window w_calculator (components)  ancestor: window

// w_calculator.wf_operator(commandbutton cba) returns 0
	choose case this.s1
	case "*"
		this.sle_2.text = string(dec(this.sle_2.text) * this.add1)
	case "/"
		this.sle_2.text = string(this.add1 / dec(this.sle_2.text))
	case "+"
		this.sle_2.text = string(dec(this.sle_2.text) + this.add1)
	case "-"
		this.sle_2.text = string(this.add1 - dec(this.sle_2.text))
	end choose
	this.add1 = dec(this.sle_2.text)
	this.s1 = cba.text
	this.flag = 0
	this.sle_1.text = this.sle_1.text + cba.text

// w_calculator.wf_digit(commandbutton cba) returns 0
	if this.flag = 0 then
		this.sle_2.text = ""
		this.flag = 1
	end if
	if this.s1 = "=" then
		this.sle_1.text = " "
		this.s1 = ""
	end if
	this.sle_1.text = this.sle_1.text + cba.text
	this.sle_2.text = this.sle_2.text + cba.text

// w_calculator.create() returns 0 [event]
	this.sle_2 = create sle_2
	this.sle_1 = create sle_1
	this.cb_digitdot = create cb_digitdot
	this.cb_equal = create cb_equal
	this.cb_divide = create cb_divide
	this.cb_multiply = create cb_multiply
	this.cb_minus = create cb_minus
	this.cb_plus = create cb_plus
	this.cb_digit0 = create cb_digit0
	this.cb_digit9 = create cb_digit9
	this.cb_digit6 = create cb_digit6
	this.cb_digit5 = create cb_digit5
	this.cb_digit8 = create cb_digit8
	this.cb_digit7 = create cb_digit7
	this.cb_digit4 = create cb_digit4
	this.cb_digit3 = create cb_digit3
	this.cb_digit2 = create cb_digit2
	this.cb_digit1 = create cb_digit1
	this.cb_ce = create cb_ce
	this.control = {this.sle_2, this.sle_1, this.cb_digitdot, this.cb_equal, this.cb_divide, this.cb_multiply, this.cb_minus, this.cb_plus, this.cb_digit0, this.cb_digit9, this.cb_digit6, this.cb_digit5, this.cb_digit8, this.cb_digit7, this.cb_digit4, this.cb_digit3, this.cb_digit2, this.cb_digit1, this.cb_ce}

// w_calculator.destroy() returns 0 [event]
	destroy this.sle_2
	destroy this.sle_1
	destroy this.cb_digitdot
	destroy this.cb_equal
	destroy this.cb_divide
	destroy this.cb_multiply
	destroy this.cb_minus
	destroy this.cb_plus
	destroy this.cb_digit0
	destroy this.cb_digit9
	destroy this.cb_digit6
	destroy this.cb_digit5
	destroy this.cb_digit8
	destroy this.cb_digit7
	destroy this.cb_digit4
	destroy this.cb_digit3
	destroy this.cb_digit2
	destroy this.cb_digit1
	destroy this.cb_ce

// w_calculator.open() returns long [event]
	this.sle_2.setfocus()
	return ::message.returnvalue

// cb_digitdot.clicked() returns long [event]
	parent.wf_digit(this)
	return ::message.returnvalue

// cb_equal.clicked() returns long [event]
	parent.wf_operator(this)
	return ::message.returnvalue

// cb_divide.clicked() returns long [event]
	parent.wf_operator(this)
	return ::message.returnvalue

// cb_multiply.clicked() returns long [event]
	parent.wf_operator(this)
	return ::message.returnvalue

// cb_minus.clicked() returns long [event]
	parent.wf_operator(this)
	return ::message.returnvalue

// cb_plus.clicked() returns long [event]
	parent.wf_operator(this)
	return ::message.returnvalue

// cb_digit0.clicked() returns long [event]
	parent.wf_digit(this)
	return ::message.returnvalue

// cb_digit9.clicked() returns long [event]
	parent.wf_digit(this)
	return ::message.returnvalue

// cb_digit6.clicked() returns long [event]
	parent.wf_digit(this)
	return ::message.returnvalue

// cb_digit5.clicked() returns long [event]
	parent.wf_digit(this)
	return ::message.returnvalue

// cb_digit8.clicked() returns long [event]
	parent.wf_digit(this)
	return ::message.returnvalue

// cb_digit7.clicked() returns long [event]
	parent.wf_digit(this)
	return ::message.returnvalue

// cb_digit4.clicked() returns long [event]
	parent.wf_digit(this)
	return ::message.returnvalue

// cb_digit3.clicked() returns long [event]
	parent.wf_digit(this)
	return ::message.returnvalue

// cb_digit2.clicked() returns long [event]
	parent.wf_digit(this)
	return ::message.returnvalue

// cb_digit1.clicked() returns long [event]
	parent.wf_digit(this)
	return ::message.returnvalue

// cb_ce.clicked() returns long [event]
	parent.add1 = 0
	parent.s1 = ""
	parent.flag = 0
	parent.sle_1.text = ""
	parent.sle_2.text = ""
	return ::message.returnvalue
