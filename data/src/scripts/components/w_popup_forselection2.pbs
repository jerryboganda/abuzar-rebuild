// dw_selected.itemerror(long row, dwobject dwo, string data) returns long
	choose case dwo.name
	case "name"
		messagebox("Name Validation", "Please enter value for Name")
	end choose
	return 1

// dw_selected.losefocus() returns long
	parent.id_selectionlist.hide()
	return ::message.returnvalue

// cb_cancel.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.is_popup_selection.l_code = -1
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	if parent.id_selected.accepttext() = -1 then
		parent.id_selected.setfocus()
		return ::message.returnvalue
	elseif isnull(parent.id_selected.getitemstring(parent.id_selected.getrow(), "name")) then
		messagebox("Name Validation", "Please enter valid value for Name.")
		parent.id_selected.setcolumn(1)
		parent.id_selected.setfocus()
		return ::message.returnvalue
	end if
	if parent.id_selected2.accepttext() = -1 then
		parent.id_selected2.setfocus()
		return ::message.returnvalue
	elseif isnull(parent.id_selected2.getitemstring(parent.id_selected2.getrow(), "name")) then
		messagebox("Name Validation", "Please enter valid value for Name.")
		parent.id_selected2.setcolumn(1)
		parent.id_selected2.setfocus()
		return ::message.returnvalue
	end if
	parent.is_popup_selection.l_code = parent.id_selected.getitemnumber(parent.id_selected.getrow(), "code")
	parent.is_popup_selection.s_name = parent.id_selected.getitemstring(parent.id_selected.getrow(), "name")
	parent.is_popup_selection.l_code2 = parent.id_selected2.getitemnumber(parent.id_selected2.getrow(), "code")
	parent.is_popup_selection.s_name2 = parent.id_selected2.getitemstring(parent.id_selected2.getrow(), "name")
	parent.post event ue_close()
	return ::message.returnvalue

// dw_selectionlist.ue_setfocus() returns 0
	parent.id_selected.setcolumn("name")
	parent.id_selected.setfocus()

// dw_selectionlist.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long
	long ll_rowmain
	if row > 0 then
		ll_rowmain = parent.id_selected.getrow()
		parent.id_selected.setitem(ll_rowmain, "code", parent.id_selectionlist.getitemnumber(row, "code"))
		parent.id_selected.setitem(ll_rowmain, "name", parent.id_selectionlist.getitemstring(row, "name"))
		parent.id_selected.selecttext(1, len(gettext()))
		parent.ib_itemvalidated = false
		selectrow(0, false)
		selectrow(row, true)
		post event ue_setfocus()
	end if
	return ::message.returnvalue

// dw_selectionlist.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long
	post event ue_setfocus()
	return ::message.returnvalue
