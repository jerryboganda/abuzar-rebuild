// window w_calendar (components)  ancestor: window

// w_calendar.ue_close(integer ai_status) returns 0 [event]
	closewithreturn(this, this.is_date)

// w_calendar.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	this.is_date = message.stringparm
	this.is_date = mid(this.is_date, 7, 4) + "/" + mid(this.is_date, 4, 2) + "/" + left(this.is_date, 2)
	this.id_date = date(this.is_date)
	if isdate(this.is_date) then
		this.mc_calendar.setselecteddate(this.id_date)
	else
		this.mc_calendar.settoday(today())
	end if
	this.mc_calendar.show()
	this.mc_calendar.setfocus()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_calendar.create() returns 0 [event]
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.mc_calendar = create mc_calendar
	this.control = {this.cb_cancel, this.cb_ok, this.mc_calendar}

// w_calendar.destroy() returns 0 [event]
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.mc_calendar

// cb_cancel.clicked() returns long [event]
	parent.is_date = ""
	parent.post event ue_close(1)
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	parent.post event ue_close(1)
	return ::message.returnvalue

// mc_calendar.doubleclicked(unsignedlong flags, integer xpos, integer ypos) returns long [event]
	parent.cb_ok.triggerevent(clicked!)
	return ::message.returnvalue

// mc_calendar.datechanged() returns long [event]
	getselecteddate(parent.id_date)
	parent.is_date = string(parent.id_date)
	return ::message.returnvalue
