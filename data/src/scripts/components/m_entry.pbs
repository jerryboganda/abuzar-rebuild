// m_inplaceinitialization.clicked() returns 0 [event]
	open(w_select_initialization_type)
	if message.doubleparm = 2.0 then
		open(w_initialization_key)
		if message.doubleparm = -1.0 or message.doubleparm = 0.0 then
			return
		end if
		open(w_inplace_initialization)
		return
	end if
	if message.doubleparm = 1.0 then
		open(w_initialization_key)
		if message.doubleparm = -1.0 or message.doubleparm = 0.0 then
			return
		end if
		open(w_normal_initialization)
		return
	end if

