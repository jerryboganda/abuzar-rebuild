// window w_popup_itemsearch_selection (components)  ancestor: window

// w_popup_itemsearch_selection.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	return ::message.returnvalue

// w_popup_itemsearch_selection.ue_close() returns 0 [event]
	wf_disconnect()
	closewithreturn(this, this.is_popup_selection)

// w_popup_itemsearch_selection.ue_first() returns 0 [event]
	long ll_code
	long ll_icode
	ll_code = wf_first()
	wf_selectunselectrow(1)
	ll_icode = this.dw_master.object.icode[this.il_selectedrow]
	wf_retrieveall(ll_icode)
	this.il_detailrow = 1

// w_popup_itemsearch_selection.ue_next() returns 0 [event]
	long ll_code
	long ll_icode
	ll_code = wf_next()
	wf_selectunselectrow(this.dw_master.getrow())
	ll_icode = this.dw_master.object.icode[this.il_selectedrow]
	wf_retrieveall(ll_icode)
	this.il_detailrow = 1

// w_popup_itemsearch_selection.ue_previous() returns 0 [event]
	long ll_code
	long ll_icode
	ll_code = wf_previous()
	wf_selectunselectrow(this.dw_master.getrow())
	ll_icode = this.dw_master.object.icode[this.il_selectedrow]
	wf_retrieveall(ll_icode)
	this.il_detailrow = 1

// w_popup_itemsearch_selection.ue_last() returns 0 [event]
	long ll_code
	long ll_icode
	ll_code = wf_last()
	wf_selectunselectrow(this.dw_master.rowcount())
	ll_icode = this.dw_master.object.icode[this.il_selectedrow]
	wf_retrieveall(ll_icode)
	this.il_detailrow = 1

// w_popup_itemsearch_selection.wf_connect() returns integer
	this.it_transobject = create u_transaction
	SQL start USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_popup_itemsearch_selection.wf_disconnect() returns 0
	SQL stop USING this.it_transobject;
	destroy this.it_transobject

// w_popup_itemsearch_selection.wf_first() returns long
	long ret_val
	if this.dw_master.rowcount() > 0 then
		this.dw_master.scrolltorow(0)
		ret_val = this.dw_master.getrow()
	end if
	return ret_val

// w_popup_itemsearch_selection.wf_last() returns long
	long ret_val
	this.dw_master.scrolltorow(this.dw_master.rowcount())
	ret_val = this.dw_master.getrow()
	return ret_val

// w_popup_itemsearch_selection.wf_next() returns long
	long ret_val
	this.dw_master.scrollnextrow()
	ret_val = this.dw_master.getrow()
	return ret_val

// w_popup_itemsearch_selection.wf_previous() returns long
	long ret_val
	this.dw_master.scrollpriorrow()
	ret_val = this.dw_master.getrow()
	return ret_val

// w_popup_itemsearch_selection.wf_retrieveall(long al_code) returns 0
	this.dw_detail.retrieve(al_code)
	this.dw_footer.retrieve(al_code)

// w_popup_itemsearch_selection.wf_selectunselectrow(long row) returns 0
	if row > 0 then
		this.il_selectedrow = row
	end if
	if this.dw_master.rowcount() > 0 and this.il_selectedrow <> 0 then
		this.dw_master.selectrow(0, false)
		this.dw_master.selectrow(this.il_selectedrow, true)
	end if

// w_popup_itemsearch_selection.create() returns 0 [event]
	this.dw_footer = create dw_footer
	this.dw_master = create dw_master
	this.dw_detail = create dw_detail
	this.control = {this.dw_footer, this.dw_master, this.dw_detail}

// w_popup_itemsearch_selection.destroy() returns 0 [event]
	destroy this.dw_footer
	destroy this.dw_master
	destroy this.dw_detail

// w_popup_itemsearch_selection.open() returns long [event]
	long ll_module
	long ll_rtcode
	long k
	long ll_code
	long ll_found
	long[] ll_longlist
	integer li_groupcode
	string ls_searchcriteria
	string ls_searchon
	boolean lb_restricteditems
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	this.is_popup_selection = message.powerobjectparm
	li_groupcode = f_getgroupcode(gl_usercode)
	ll_code = this.is_popup_selection.l_code
	ls_searchcriteria = this.is_popup_selection.s_name2
	ls_searchon = this.is_popup_selection.s_name3
	setredraw(false)
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width
		ll_height = ll_win_height
		this.width = ll_width * 0.99
		this.height = ll_height * 0.90
		this.dw_master.width = ll_width * 0.98
		this.dw_detail.width = ll_width * 0.98 * 0.39
		this.dw_footer.width = ll_width * 0.98 * 0.61
		this.dw_master.height = this.height * 0.95 * 0.70
		this.dw_footer.height = this.height * 0.95 * 0.30
		this.dw_detail.height = this.height * 0.95 * 0.30
		this.dw_master.y = 10
		this.dw_detail.y = this.height * 0.95 - this.dw_detail.height + 5
		this.dw_footer.y = this.height * 0.95 - this.dw_detail.height + 5
		this.dw_detail.x = this.dw_footer.x + this.dw_footer.width + 5
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	wf_connect()
	this.dw_master.settransobject(this.it_transobject)
	this.dw_detail.settransobject(this.it_transobject)
	this.dw_footer.settransobject(this.it_transobject)
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		ll_rtcode = this.dw_master.retrieve(li_groupcode, gi_catlist2, ls_searchon, ls_searchcriteria)
	else
		ll_longlist[1] = 0
		ll_rtcode = this.dw_master.retrieve(li_groupcode, ll_longlist, ls_searchon, ls_searchcriteria)
	end if
	if ll_rtcode <> 0 then
		post event ue_first()
	end if
	setredraw(true)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// dw_footer.losefocus() returns long [event]
	long ancestorreturnvalue
	integer li_rtn
	ancestorreturnvalue = super::losefocus()
	SQL rollback USING parent.it_transobject;
	if update() > 0 then
		SQL commit USING parent.it_transobject;
	else
		SQL rollback USING parent.it_transobject;
	end if
	return ::message.returnvalue

// dw_footer.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_master.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	integer li_movement
	long ll_row
	long ll_temp
	string sl_columnname
	if key = keyuparrow! then
		if parent.il_selectedrow <= parent.dw_master.rowcount() then
			if parent.il_selectedrow > 1 then
				ll_row = parent.il_selectedrow - 1
				parent.dw_master.scrolltorow(ll_row)
			else
				ll_row = parent.il_selectedrow
			end if
		end if
	elseif key = keydownarrow! then
		if parent.il_selectedrow <= parent.dw_master.rowcount() then
			if parent.il_selectedrow < parent.dw_master.rowcount() then
				ll_row = parent.il_selectedrow + 1
				parent.dw_master.scrolltorow(ll_row)
			else
				ll_row = parent.il_selectedrow
			end if
		end if
	elseif key = keypagedown! then
		ll_row = parent.dw_master.scrollnextpage()
		scrolltorow(ll_row)
		ll_row = parent.dw_master.getrow()
	elseif key = keypageup! then
		ll_row = parent.dw_master.scrollpriorpage()
		scrolltorow(ll_row)
		ll_row = parent.dw_master.getrow()
	elseif key = keyhome! then
		scrolltorow(1)
		ll_row = 1
	elseif key = keyend! then
		ll_row = parent.dw_master.rowcount()
		parent.dw_master.scrolltorow(ll_row)
	elseif key = keyescape! then
		parent.is_popup_selection.l_code = 0
		parent.post event ue_close()
	elseif key = keyenter! then
		parent.is_popup_selection.l_code = this.object.icode[parent.il_selectedrow]
		parent.post event ue_close()
	end if
	if ll_row > 0 and ll_row <= rowcount() then
		selectrow(0, false)
		selectrow(ll_row, true)
		scrolltorow(ll_row)
		parent.il_selectedrow = ll_row
		if rowcount() > 0 then
			parent.wf_retrieveall(this.object.icode[parent.il_selectedrow])
		end if
	end if
	return ::message.returnvalue

// dw_master.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	parent.wf_selectunselectrow(row)
	if parent.dw_master.rowcount() > 0 then
		parent.wf_retrieveall(parent.dw_master.object.icode[parent.il_selectedrow])
	end if
	return ::message.returnvalue

// dw_master.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	parent.wf_selectunselectrow(row)
	if parent.dw_master.rowcount() > 0 then
		parent.wf_retrieveall(parent.dw_master.object.icode[parent.il_selectedrow])
	end if
	return ::message.returnvalue

// dw_master.losefocus() returns long [event]
	return ::message.returnvalue

// dw_master.getfocus() returns long [event]
	if parent.dw_master.rowcount() > 0 then
		parent.dw_master.selectrow(0, false)
		if parent.il_selectedrow <= parent.dw_master.rowcount() then
			parent.dw_master.selectrow(parent.il_selectedrow, true)
		else
			parent.il_selectedrow = 1
			parent.dw_master.selectrow(1, true)
		end if
	end if
	return ::message.returnvalue

// dw_detail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	parent.dw_detail.selectrow(0, false)
	parent.dw_detail.selectrow(row, true)
	parent.il_detailrow = row
	return ::message.returnvalue

// dw_detail.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::doubleclicked(xpos, ypos, row, dwo)
	parent.dw_detail.selectrow(0, false)
	parent.dw_detail.selectrow(row, true)
	parent.il_detailrow = row
	return ::message.returnvalue

// dw_detail.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	parent.dw_detail.selectrow(0, false)
	parent.dw_detail.selectrow(1, true)
	parent.il_detailrow = 1
	return ::message.returnvalue

// dw_detail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	if parent.dw_detail.rowcount() > 0 then
		parent.dw_detail.selectrow(0, false)
		parent.il_detailrow = 1
	end if
	return ::message.returnvalue

// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	long ll_row
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyuparrow! then
		if parent.il_detailrow <= parent.dw_detail.rowcount() then
			if parent.il_detailrow = 1 then
				ll_row = 1
			else
				ll_row = parent.il_detailrow - 1
				parent.dw_detail.setrow(ll_row)
				parent.dw_detail.scrolltorow(ll_row)
			end if
		end if
	elseif key = keydownarrow! then
		if parent.il_detailrow <= parent.dw_detail.rowcount() then
			if parent.il_detailrow = parent.dw_detail.rowcount() then
				ll_row = parent.il_detailrow
			else
				ll_row = parent.il_detailrow + 1
				parent.dw_detail.setrow(ll_row)
				parent.dw_detail.scrolltorow(ll_row)
			end if
		end if
	elseif key = keypagedown! then
		parent.dw_detail.scrollnextpage()
		ll_row = parent.dw_detail.getrow()
	elseif key = keypageup! then
		parent.dw_detail.scrollpriorpage()
		ll_row = parent.dw_detail.getrow()
	elseif key = keyhome! then
		scrolltorow(1)
		ll_row = 1
	elseif key = keyend! then
		ll_row = parent.dw_detail.rowcount()
		scrolltorow(ll_row)
	end if
	if ll_row > 0 and ll_row <= parent.dw_detail.rowcount() then
		parent.il_detailrow = ll_row
		parent.dw_detail.selectrow(0, false)
		parent.dw_detail.selectrow(parent.il_detailrow, true)
	end if
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1
