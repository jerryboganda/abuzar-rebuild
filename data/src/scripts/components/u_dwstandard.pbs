// userobject u_dwstandard (components)  ancestor: datawindow

// u_dwstandard.uevent_dberr_reqmissing(dwbuffer adwb_buffer, long al_row) returns 0

// u_dwstandard.uevent_dberr_initial() returns 0

// u_dwstandard.uevent_dberr_message(long al_errorcode, string as_errortext, long al_row, dwbuffer adwb_buffer) returns 0
	s_dberror ls_dberror
	choose case al_errorcode
	case -193
		beep(1)
		ls_dberror.s_apperrormessage = "One of the columns in Row No: " + string(al_row) + " have duplicate values and the same column values are used by an existing row.~r~n" + "Possible suggestions are try to give column values in Row No: " + string(al_row) + " that are  unique and does not match with any existing rows."
		ls_dberror.s_sqlerrormessage = "Error Code: " + string(al_errorcode) + "~r~n" + as_errortext + "~r~n~r~n" + "Please call the Abuzar Consultancy support team."
	case -194
		beep(1)
		ls_dberror.s_apperrormessage = "One of the columns in Row No: " + string(al_row) + " referes to some other table in the Database. Actually there is not a related row in the other table.~r~n" + "Possible suggestions are check you column values in Row No: " + string(al_row) + " for accuracy and make any needed corrections if necessary."
		ls_dberror.s_sqlerrormessage = "Error Code: " + string(al_errorcode) + "~r~n" + as_errortext + "~r~n~r~n" + "Please call the Abuzar Consultancy support team."
	case -195
		beep(1)
		ls_dberror.s_apperrormessage = "You may left one or more column values empty in Row No: " + string(al_row) + " .~r~nSo kindly fill in the required column values in Row No: " + string(al_row) + " and than try again."
		ls_dberror.s_sqlerrormessage = "Error Code: " + string(al_errorcode) + "~r~n" + as_errortext + "~r~n~r~n" + "Please call the Abuzar Consultancy support team."
		event uevent_dberr_reqmissing(adwb_buffer, al_row)
	case -198
		beep(1)
		ls_dberror.s_apperrormessage = "Row No: " + string(al_row) + " has association with other tables in the Database. This means you can't delete this row or change its value.~r~n" + "Possible suggestions are delete the related rows in those other tables first (or modify them so that they don't refer to your target Row No :" + string(al_row) + "."
		ls_dberror.s_sqlerrormessage = "Error Code: " + string(al_errorcode) + "~r~n" + as_errortext + "~r~n~r~n" + "Please call the Abuzar Consultancy support team."
	case -209
		beep(1)
		ls_dberror.s_apperrormessage = "One or more of your columns in Row No: " + string(al_row) + " have values that are not allowed.~r~nSo kindly check the column values in Row No: " + string(al_row) + " for accuracy and make any needed corrections if necessary."
		ls_dberror.s_sqlerrormessage = "Error Code: " + string(al_errorcode) + "~r~n" + as_errortext + "~r~n~r~n" + "Please call the Abuzar Consultancy support team."
	case -3
		beep(1)
		ls_dberror.s_apperrormessage = "Row No: " + string(al_row) + " values have changed since the last retrieval.~r~nMay be some other user has modified this row before your request.~r~nSo kindly retrieve these rows again."
		ls_dberror.s_sqlerrormessage = "Error Code: " + string(al_errorcode) + "~r~n" + as_errortext + "~r~n~r~n" + "Please call the Abuzar Consultancy support team."
	case else
		beep(1)
		ls_dberror.s_apperrormessage = "Some unidentifiable problem has occured in Row No: " + string(al_row) + " while your request was being processed.~r~nSo kindly close the current module and reopen it to try again.~r~n"
		ls_dberror.s_sqlerrormessage = "Error Code: " + string(al_errorcode) + "~r~n" + as_errortext + "~r~n~r~n" + "Please call the Abuzar Consultancy support team."
	end choose
	openwithparm(w_dberror, ls_dberror)

// u_dwstandard.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	string ls_column
	string ls_exp
	string ls_date
	string ls_temp
	string ls_time
	string ls_table
	string ls_selectedvalue
	string ls_ddw
	string ls_exp2
	long ll_temp
	long ll_row
	date ld_date
	time lt_time
	datetime ldt_date
	s_arguements lstr_arg
	ls_column = getcolumnname()
	if keyflags = 3 and key = keyf! then
		of_find()
	end if
	ls_exp = describe(ls_column + ".coltype")
	ls_ddw = describe(ls_column + ".dddw.Name")
	if ls_ddw = "?" then
		ls_ddw = ""
	end if
	if key = keyf4! and left(ls_exp, 4) = "date" and (rowcount() > 0 and getrow() > 0) then
		accepttext()
		if ls_exp = "date" then
			ls_temp = string(getitemdate(getrow(), ls_column), "yyyy-mm-dd")
		elseif ls_exp = "datetime" then
			ls_temp = string(getitemdatetime(getrow(), ls_column), "yyyy-mm-dd hh:mm:ss")
		end if
		ls_date = left(ls_temp, 10)
		openwithparm(w_calendar2, ls_date)
		ls_date = message.stringparm
		if not (ls_date = "" or isnull(ls_date)) then
			if ls_exp = "date" then
				ld_date = date(ls_date)
				setitem(getrow(), ls_column, ld_date)
			elseif ls_exp = "datetime" then
				ls_time = right(ls_temp, 8)
				lt_time = time(ls_time)
				ld_date = date(ls_date)
				ldt_date = datetime(ld_date, lt_time)
				setitem(getrow(), ls_column, ldt_date)
				accepttext()
			end if
		end if
	end if
	if key = keyf4! and left(ls_exp, 4) = "char" and len(ls_ddw) = 0 then
		ls_table = this.object.datawindow.table.updatetable
		lstr_arg.s_name1 = ls_column
		lstr_arg.s_name2 = ls_table
		openwithparm(w_select_text_service, lstr_arg)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = 1 and getrow() > 0 then
			ls_selectedvalue = lstr_arg.s_name7
			setitem(getrow(), ls_column, ls_selectedvalue)
		end if
	end if
	if key = keyf4! and (left(ls_exp, 7) = "decimal" or left(ls_exp, 6) = "double") then
		open(w_calculator)
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// u_dwstandard.of_find() returns long
	long ll_found
	string ls_find
	string ls_column_name
	string ls_columntype
	integer li_column_count
	integer li_counter
	s_arguements lstr_arg
	openwithparm(w_findwindow, this)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = 1 then
	end if
	return 0

// u_dwstandard.dberror(long sqldbcode, string sqlerrtext, string sqlsyntax, dwbuffer buffer, long row) returns long
	event uevent_dberr_initial()
	post event uevent_dberr_message(sqldbcode, sqlerrtext, row, buffer)
	SQL rollback USING sqlca;
	return 1

// u_dwstandard.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long
	string s_str
	string s_t
	integer i_len
	s_str = string(dwo.name)
	s_t = right(s_str, 2)
	if s_t = "_t" then
		i_len = len(s_str)
		s_str = left(s_str, i_len - 2)
		if this.s_previous <> s_str then
			this.b_flag = true
		end if
		if this.b_flag = true then
			setsort(s_str)
			sort()
			this.b_flag = false
		else
			setsort(s_str + " D")
			sort()
			this.b_flag = true
		end if
	end if
	this.s_previous = s_str
	return ::message.returnvalue

// u_dwstandard.create() returns 0

// u_dwstandard.destroy() returns 0

// u_dwstandard.getfocus() returns long
	selecttext(1, len(gettext()))
	return ::message.returnvalue
