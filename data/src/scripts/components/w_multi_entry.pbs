// window w_multi_entry (components)  ancestor: w_entry_primitives

// w_multi_entry.ue_getfocus() returns 0 [event]
	this.tab_retrieve.tabpage_list.dw_find.setfocus()

// w_multi_entry.ue_newitem() returns 0 [event]
	long ll_rowcount
	long ll_currentrow
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	ll_currentrow = this.id_detail.getrow()
	this.id_detail.setcolumn(1)
	if ll_currentrow = this.id_detail.rowcount() then
		this.id_detail.insertrow(0)
		ll_rowcount = this.id_detail.rowcount()
		if ll_rowcount > 1 then
			this.id_detail.scrolltorow(ll_rowcount)
			this.id_detail.setfocus()
		end if
	else
		this.id_detail.insertrow(ll_currentrow)
		this.id_detail.scrolltorow(ll_currentrow)
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.ib_validatefullcode = true

// w_multi_entry.ue_deleteitem() returns 0 [event]
	long ll_currow
	long ll_detailrows
	long ll_icode
	dwruntimeerror myexc
	this.ib_itemvalidated = true
	try
		ll_icode = this.id_detail.object.icode[this.id_detail.getrow()]
	catch (throwable myexc)
	end try
	if not isnull(ll_icode) then
		this.id_detail.rowscopy(this.id_detail.getrow(), this.id_detail.getrow(), primary!, this.ids_itemrecyclebin, this.ids_itemrecyclebin.rowcount() + 1, primary!)
	end if
	this.id_detail.deleterow(0)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows < 1 then
		this.im_menu.m_file.m_save.enabled = false
	end if
	wf_grandtotal()

// w_multi_entry.ue_refreshddw() returns 0 [event]
	setpointer(hourglass!)
	setredraw(false)
	wf_refreshitemslist()
	setredraw(true)
	setpointer(arrow!)

// w_multi_entry.ue_refreshddw_catwise() returns 0 [event]
	setpointer(hourglass!)
	setredraw(false)
	wf_refreshitemslist_catwise()
	setredraw(true)
	setpointer(arrow!)

// w_multi_entry.ue_deleteitem_row(long al_row) returns 0 [event]
	long ll_currow
	long ll_detailrows
	long ll_icode
	dwruntimeerror myexc
	this.ib_itemvalidated = true
	try
		ll_icode = this.id_detail.object.icode[al_row]
	catch (throwable myexc)
	end try
	this.id_detail.rowscopy(al_row, al_row, primary!, this.ids_itemrecyclebin, this.ids_itemrecyclebin.rowcount() + 1, primary!)
	this.id_detail.deleterow(al_row)
	ll_detailrows = this.id_detail.rowcount()
	if ll_detailrows < 1 then
		this.im_menu.m_file.m_save.enabled = false
	end if
	wf_grandtotal()

// w_multi_entry.ue_refreshddw_customize() returns 0 [event]
	setpointer(hourglass!)
	setredraw(false)
	wf_refreshitemslist_customize()
	setredraw(true)
	setpointer(arrow!)

// w_multi_entry.ue_scrolltorow(long al_row, string as_column) returns 0 [event]
	this.id_detail.scrolltorow(al_row)
	this.id_detail.setcolumn(as_column)
	this.id_detail.selecttext(1, len(this.id_detail.gettext()))

// w_multi_entry.ue_refreshddw_stockitemsonly() returns 0 [event]
	setpointer(hourglass!)
	setredraw(false)
	wf_refreshitemslist_stockitemsonly()
	setredraw(true)
	setpointer(arrow!)

// w_multi_entry.ue_refreshddw_itemname() returns 0 [event]
	setpointer(hourglass!)
	setredraw(false)
	wf_refreshitemslist_itemname()
	setredraw(true)
	setpointer(arrow!)

// w_multi_entry.ue_refreshddw_drilldown() returns 0 [event]
	setpointer(hourglass!)
	setredraw(false)
	wf_refreshitemslist_drilldown()
	setredraw(true)
	setpointer(arrow!)

// w_multi_entry.ue_restoreitem() returns 0 [event]
	long ll_currentrow
	long ll_row_to_restore
	s_datastore lds_ds
	if this.tab_retrieve.selectedtab = 2 then
		return
	end if
	if this.ids_itemrecyclebin.rowcount() <= 0 then
		messagebox("Restore Item", "You can not proceed with Restore Item.~r~nNo deleted items exist.", information!)
		return
	end if
	lds_ds.ds = this.ids_itemrecyclebin
	openwithparm(w_restoreitem, lds_ds)
	lds_ds = message.powerobjectparm
	if lds_ds.i_closemode = -1 then
		return
	end if
	ll_row_to_restore = lds_ds.i_closemode
	wf_deleteemptydetailrow()
	if this.id_detail.accepttext() = 1 and ll_row_to_restore > 0 then
		ll_currentrow = this.id_detail.getrow()
		if ll_currentrow = this.id_detail.rowcount() then
			ll_currentrow = ll_currentrow + 1
		end if
		this.ids_itemrecyclebin.rowscopy(ll_row_to_restore, ll_row_to_restore, primary!, this.id_detail, ll_currentrow, primary!)
		this.ids_itemrecyclebin.deleterow(ll_row_to_restore)
		this.id_detail.setrow(ll_currentrow)
		this.id_detail.scrolltorow(ll_currentrow)
	end if

// w_multi_entry.wf_sortdw(string a_column_name, char a_order) returns 0
	this.id_dwcontrol.setredraw(false)
	this.id_dwcontrol.selectrow(0, false)
	this.id_dwcontrol.setredraw(true)
	this.il_selectedrow = 0
	this.is_filter = ""
	this.id_dwcontrol.setsort(a_column_name + " " + a_order)
	this.id_dwcontrol.sort()
	this.tab_retrieve.tabpage_list.dw_find.object.find[1] = ""
	this.tab_retrieve.tabpage_list.dw_find.setfocus()

// w_multi_entry.wf_setmenu(menu a_menu) returns 0
	this.im_menu = a_menu

// w_multi_entry.wf_grandtotal() returns double
	return 0

// w_multi_entry.wf_confirm_changes() returns integer
	string as_titletext
	integer li_column_count
	string ls_cloumnname
	dwitemstatus ldwis_orddate
	dwitemstatus ldwis_ordstatus
	boolean lb_ordchange
	dwitemstatus ldwis_itemprod
	dwitemstatus ldwis_itemqty
	boolean lb_itemchange
	long li_counter
	long ll_detailrows
	long ll_deleted_items
	boolean lb_itemdel
	ldwis_orddate = this.id_master.getitemstatus(1, "order_header_order_entrydate", primary!)
	ldwis_ordstatus = this.id_master.getitemstatus(1, "order_header_order_status", primary!)
	if ldwis_orddate = datamodified! or ldwis_orddate = newmodified! or ldwis_ordstatus = datamodified! or ldwis_ordstatus = newmodified! then
		lb_ordchange = true
	else
		lb_ordchange = false
	end if
	ll_detailrows = this.id_detail.rowcount()
	for li_counter = 1 to ll_detailrows
		ldwis_itemprod = this.id_detail.getitemstatus(li_counter, "item_prod_id", primary!)
		ldwis_itemqty = this.id_detail.getitemstatus(li_counter, "item_qty", primary!)
		if ldwis_itemprod = datamodified! or ldwis_itemprod = newmodified! or ldwis_itemqty = datamodified! or ldwis_itemqty = newmodified! then
			lb_itemchange = true
			exit
		else
			lb_itemchange = false
		end if
	next
	ll_deleted_items = this.id_detail.deletedcount()
	if ll_deleted_items > 0 then
		lb_itemdel = true
	else
		lb_itemdel = false
	end if
	if lb_ordchange = true or lb_itemchange = true or lb_itemdel = true then
		beep(1)
		if messagebox("Confirm " + as_titletext + " Request", "OK to lose any unsaved changes you've made?", question!, yesno!) = 2 then
			return -1
		end if
		return
	end if
	return 1

// w_multi_entry.wf_getitemname(long al_icode, ref string as_itemname) returns integer
	SQL SELECT name INTO :as_itemname FROM item WHERE item.icode =:al_icode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_multi_entry.wf_disconnect() returns 0
	SQL stop USING this.it_transobject;
	destroy this.it_transobject

// w_multi_entry.wf_retrievelist() returns long
	return this.id_list.retrieve()

// w_multi_entry.wf_retrievelistall() returns long
	return this.id_list.retrieve()

// w_multi_entry.wf_filter() returns 0
	string ls_quote
	string ls_column_name
	string ls_match_data
	string ls_filter
	string ls_match_date
	string ls_columntype
	ls_columntype = this.id_dwcontrol.describe(this.tab_retrieve.tabpage_list.ddlb_filter_column.text + ".ColType")
	if left(ls_columntype, 4) = "char" then
		ls_quote = "'"
		ls_column_name = "upper(" + trim(this.tab_retrieve.tabpage_list.ddlb_filter_column.text) + ")"
		ls_match_data = upper(this.tab_retrieve.tabpage_list.ddlb_data.text)
		ls_filter = ls_column_name + this.tab_retrieve.tabpage_list.ddlb_op.text + ls_quote + ls_match_data + ls_quote
	elseif left(ls_columntype, 4) = "date" then
		ls_quote = "'"
		ls_column_name = trim(this.tab_retrieve.tabpage_list.ddlb_filter_column.text)
		ls_match_data = this.tab_retrieve.tabpage_list.ddlb_data.text
		ls_match_date = mid(ls_match_data, pos(ls_match_data, "/", 1) + 1, pos(ls_match_data, "/", pos(ls_match_data, "/", 1) + 1) - pos(ls_match_data, "/", 1) - 1) + "/" + mid(ls_match_data, 1, pos(ls_match_data, "/", 1) - 1) + "/" + mid(ls_match_data, pos(ls_match_data, "/", pos(ls_match_data, "/", 1) + 1) + 1, 2)
		ls_filter = "Date(" + ls_column_name + ") " + this.tab_retrieve.tabpage_list.ddlb_op.text + "Date(" + ls_quote + ls_match_date + ls_quote + ")"
	else
		ls_quote = ""
		ls_column_name = trim(this.tab_retrieve.tabpage_list.ddlb_filter_column.text)
		ls_match_data = this.tab_retrieve.tabpage_list.ddlb_data.text
		ls_filter = ls_column_name + this.tab_retrieve.tabpage_list.ddlb_op.text + ls_quote + ls_match_data + ls_quote
	end if
	this.tab_retrieve.tabpage_list.dw_list.setfilter(ls_filter)
	this.tab_retrieve.tabpage_list.dw_list.filter()
	if this.tab_retrieve.tabpage_list.dw_list.rowcount() > 0 then
		this.id_list.selectrow(1, true)
		if this.ii_type = 1 then
			this.tab_retrieve.tabpage_list.dw_find.object.find[1] = this.id_dwcontrol.getitemstring(1, this.ii_colindex)
			return
		end if
		if this.ii_type = 3 then
			this.tab_retrieve.tabpage_list.dw_find.object.find[1] = string(this.id_dwcontrol.getitemdatetime(1, this.ii_colindex), "dd/mm/yyyy hh/mm/ss")
			return
		end if
		this.tab_retrieve.tabpage_list.dw_find.object.find[1] = string(this.id_dwcontrol.getitemnumber(1, this.ii_colindex))
	end if

// w_multi_entry.wf_selectunselectrow(long row) returns 0
	if row > 0 then
		this.il_selectedrow = row
		this.tab_retrieve.tabpage_detail.enabled = true
		this.im_menu.m_file.m_retrieve.enabled = true
	end if
	if this.tab_retrieve.tabpage_list.dw_list.rowcount() > 0 then
		if this.il_selectedrow <> 0 then
			this.tab_retrieve.tabpage_list.dw_list.selectrow(0, false)
			this.id_dwcontrol.selectrow(this.il_selectedrow, true)
			this.id_dwcontrol.scrolltorow(this.il_selectedrow)
			if this.ii_type = 1 then
				this.tab_retrieve.tabpage_list.dw_find.object.find[1] = this.id_dwcontrol.getitemstring(this.il_selectedrow, this.ii_colindex)
			elseif this.ii_type = 3 then
				this.tab_retrieve.tabpage_list.dw_find.object.find[1] = string(this.id_dwcontrol.getitemdatetime(this.il_selectedrow, this.ii_colindex), "dd/mm/yyyy hh/mm/ss")
			else
				this.tab_retrieve.tabpage_list.dw_find.object.find[1] = string(this.id_dwcontrol.getitemnumber(this.il_selectedrow, this.ii_colindex))
			end if
		end if
		this.tab_retrieve.tabpage_list.dw_find.setfocus()
	end if

// w_multi_entry.wf_disabledetailtab(long row) returns 0
	if row < 1 then
		this.tab_retrieve.tabpage_detail.enabled = false
	end if

// w_multi_entry.wf_showlist(long al_listcurrrow) returns 0
	this.id_itemslist.show()
	this.id_itemslist.selectrow(0, false)
	this.id_itemslist.scrolltorow(al_listcurrrow)
	if al_listcurrrow <> 0 then
		this.id_itemslist.selectrow(al_listcurrrow, true)
	end if
	this.id_detail.setfocus()
	this.ib_itemslistopen = true

// w_multi_entry.wf_validatedate() returns boolean
	this.id_systemdate = this.id_master.getitemdatetime(1, "date")
	return this.editflag

// w_multi_entry.wf_populate_ddlb(datawindow dwcontrol) returns 0
	integer li_column_count
	integer li_counter
	string ls_column_name
	string ls_columntype
	this.tab_retrieve.tabpage_list.ddlb_filter_column.reset()
	this.tab_retrieve.tabpage_list.ddlb_sort.reset()
	li_column_count = integer(dwcontrol.object.datawindow.column.count)
	for li_counter = li_column_count to 1 step -1
		ls_column_name = dwcontrol.describe("#" + string(li_counter) + ".Name")
		this.tab_retrieve.tabpage_list.ddlb_sort.additem(ls_column_name)
		this.tab_retrieve.tabpage_list.ddlb_filter_column.additem(ls_column_name)
	next
	this.tab_retrieve.tabpage_list.ddlb_sort.text = ls_column_name
	ls_columntype = this.id_dwcontrol.describe("#1.ColType")
	if left(ls_columntype, 4) = "char" then
		this.ii_type = 1
	elseif left(ls_columntype, 4) = "date" then
		this.ii_type = 3
	else
		this.ii_type = 2
	end if
	this.ii_colindex = 1
	this.tab_retrieve.tabpage_list.rb_descending.checked = true
	wf_sortdw(this.tab_retrieve.tabpage_list.ddlb_sort.text, this.is_sortsequence)
	this.id_master.setfocus()

// w_multi_entry.wf_deleteemptydetailrow() returns integer
	long ll_rowcount
	long ll_counter
	long ll_icode
	integer li_rtcode
	dwruntimeerror myexc
	ll_rowcount = this.id_detail.rowcount()
	ll_counter = 1
	do while ll_counter <= this.id_detail.rowcount()
		try
			ll_icode = this.id_detail.object.icode[ll_counter]
		catch (throwable myexc)
		end try
		if isnull(ll_icode) then
			this.id_detail.deleterow(ll_counter)
			li_rtcode = 1
			this.ib_itemslistopen = false
			this.id_itemslist.hide()
			setfocus()
		else
			ll_counter = ll_counter + 1
		end if
	loop
	return li_rtcode

// w_multi_entry.wf_refreshitemslist() returns 0
	f_refreshitemlist()

// w_multi_entry.wf_refreshitemslist_catwise() returns 0
	long ll_counter
	boolean lb_enablerestricted
	string ls_itemcategories
	integer[] la_icatcode
	s_arguements lstr_arg
	long li_count
	long ll_startrow
	char lc_char
	open(w_choose_itemcategory)
	lstr_arg = message.powerobjectparm
	if lstr_arg.i_status = -1 then
		return
	end if
	la_icatcode = lstr_arg.ia_integerlist
	ls_itemcategories = ""
	for ll_counter = 1 to upperbound(la_icatcode)
		ls_itemcategories = ls_itemcategories + string(la_icatcode[ll_counter]) + " , "
	next
	ls_itemcategories = ls_itemcategories + " 0 "
	gd_itemsinfo.reset()
	gd_itemsinfo.setfilter("")
	gd_itemsinfo.filter()
	if f_stringpreferences("GroupCategoryRights") = "Y" then
		gd_itemsinfo.retrieve(gi_catlist, f_getgroupcode(gl_usercode))
	else
		gd_itemsinfo.retrieve(f_getgroupcode(gl_usercode))
	end if
	for ll_counter = 1 to gds_securitywindow.rowcount()
		if gds_securitywindow.object.rightcode[ll_counter] = 515 then
			lb_enablerestricted = true
		end if
	next
	if lb_enablerestricted = false then
		gd_itemsinfo.setfilter(" restricted = 'N' AND icatcode In (" + ls_itemcategories + ")")
		gd_itemsinfo.filter()
	else
		gd_itemsinfo.setfilter("icatcode In (" + ls_itemcategories + ")")
		gd_itemsinfo.filter()
	end if
	for li_count = 65 to 90
		lc_char = char(li_count)
		ga_llookuptable[li_count] = gd_itemsinfo.find("Lower(itemname) >= Lower('" + char(li_count) + "')", ll_startrow, 99999)
		ll_startrow = ga_llookuptable[li_count]
	next
	ga_llookuptable[92] = 99999

// w_multi_entry.wf_iseditable() returns boolean
	if this.tab_retrieve.selectedtab = 1 and this.editflag = true then
		return true
	end if
	return false

// w_multi_entry.wf_connect() returns integer
	this.it_transobject = create u_transaction
	SQL start USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_multi_entry.wf_group_itemcat_aliasname_range() returns 0
	long ll_groupcode
	ll_groupcode = f_getgroupcode(gl_usercode)
	openwithparm(w_group_itemcat_aliasname_range, ll_groupcode)

// w_multi_entry.wf_commitform() returns boolean
	return this.ib_commitok

// w_multi_entry.wf_refreshitemslist_customize() returns 0
	long ll_counter
	long ll_found
	long ll_refreshcriteria
	boolean lb_enablerestricted
	string ls_cond
	string ls_itemcategories
	string ls_itemmanfs
	string ls_itemclasses
	string ls_itempackings
	integer[] la_icatcode
	integer[] la_manfcode
	integer[] la_iccode
	integer[] la_packcode
	s_arguements lstr_arg
	long li_count
	long ll_startrow
	char lc_char
	open(w_selectformat_itemrefreshtype)
	ll_refreshcriteria = message.doubleparm
	if ll_refreshcriteria = 1 then
		open(w_arg_item_populate4)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = -1 then
			return
		end if
		ls_cond = lstr_arg.s_name2
		la_manfcode = lstr_arg.ia_integerlist
		la_icatcode = lstr_arg.ia_integerlist1
		la_iccode = lstr_arg.ia_integerlist2
		la_packcode = lstr_arg.la_longlist
		ls_itemcategories = ""
		for ll_counter = 1 to upperbound(la_icatcode)
			ls_itemcategories = ls_itemcategories + string(la_icatcode[ll_counter]) + " , "
		next
		ls_itemcategories = ls_itemcategories + " 0 "
		ls_itemmanfs = ""
		for ll_counter = 1 to upperbound(la_manfcode)
			ls_itemmanfs = ls_itemmanfs + string(la_manfcode[ll_counter]) + " , "
		next
		ls_itemmanfs = ls_itemmanfs + " 0 "
		ls_itemclasses = ""
		for ll_counter = 1 to upperbound(la_iccode)
			ls_itemclasses = ls_itemclasses + string(la_iccode[ll_counter]) + " , "
		next
		ls_itemclasses = ls_itemclasses + " 0 "
		ls_itempackings = ""
		for ll_counter = 1 to upperbound(la_packcode)
			ls_itempackings = ls_itempackings + string(la_packcode[ll_counter]) + " , "
		next
		ls_itempackings = ls_itempackings + " 0 "
		gd_itemsinfo.reset()
		gd_itemsinfo.setfilter("")
		gd_itemsinfo.filter()
		if f_stringpreferences("GroupCategoryRights") = "Y" then
			gd_itemsinfo.retrieve(gi_catlist, f_getgroupcode(gl_usercode))
		else
			gd_itemsinfo.retrieve(f_getgroupcode(gl_usercode))
		end if
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 515", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			lb_enablerestricted = true
		end if
		if lb_enablerestricted = false then
			gd_itemsinfo.setfilter(" restricted = 'N' AND ( icatcode In (" + ls_itemcategories + ") " + ls_cond + " manfcode In (" + ls_itemmanfs + ") " + ls_cond + " iccode In (" + ls_itemclasses + ") " + ls_cond + " packcode In (" + ls_itempackings + ")   )  ")
			gd_itemsinfo.filter()
		else
			gd_itemsinfo.setfilter("icatcode In (" + ls_itemcategories + ") " + ls_cond + " manfcode In (" + ls_itemmanfs + ") " + ls_cond + " iccode In (" + ls_itemclasses + ") " + ls_cond + " packcode In (" + ls_itempackings + ")")
			gd_itemsinfo.filter()
		end if
	elseif ll_refreshcriteria = 2 then
		open(w_arg_manf_category_class_pack_oneorall)
		lstr_arg = message.powerobjectparm
		if lstr_arg.i_status = -1 then
			return
		end if
		ls_cond = " AND "
		la_manfcode = lstr_arg.ia_integerlist
		la_icatcode = lstr_arg.ia_integerlist1
		la_iccode = lstr_arg.ia_integerlist2
		la_packcode = lstr_arg.la_longlist
		ls_itemcategories = ""
		for ll_counter = 1 to upperbound(la_icatcode)
			ls_itemcategories = ls_itemcategories + string(la_icatcode[ll_counter]) + " , "
		next
		ls_itemcategories = ls_itemcategories + " 0 "
		ls_itemmanfs = ""
		for ll_counter = 1 to upperbound(la_manfcode)
			ls_itemmanfs = ls_itemmanfs + string(la_manfcode[ll_counter]) + " , "
		next
		ls_itemmanfs = ls_itemmanfs + " 0 "
		ls_itemclasses = ""
		for ll_counter = 1 to upperbound(la_iccode)
			ls_itemclasses = ls_itemclasses + string(la_iccode[ll_counter]) + " , "
		next
		ls_itemclasses = ls_itemclasses + " 0 "
		ls_itempackings = ""
		for ll_counter = 1 to upperbound(la_packcode)
			ls_itempackings = ls_itempackings + string(la_packcode[ll_counter]) + " , "
		next
		ls_itempackings = ls_itempackings + " 0 "
		gd_itemsinfo.reset()
		gd_itemsinfo.setfilter("")
		gd_itemsinfo.filter()
		if f_stringpreferences("GroupCategoryRights") = "Y" then
			gd_itemsinfo.retrieve(gi_catlist, f_getgroupcode(gl_usercode))
		else
			gd_itemsinfo.retrieve(f_getgroupcode(gl_usercode))
		end if
		ll_found = 0
		ll_found = gds_securitywindow.find("rightcode = 515", 1, gds_securitywindow.rowcount())
		if ll_found > 0 then
			lb_enablerestricted = true
		end if
		if lb_enablerestricted = false then
			gd_itemsinfo.setfilter(" restricted = 'N' AND ( icatcode In (" + ls_itemcategories + ") " + ls_cond + " manfcode In (" + ls_itemmanfs + ") " + ls_cond + " iccode In (" + ls_itemclasses + ") " + ls_cond + " packcode In (" + ls_itempackings + ")   )  ")
			gd_itemsinfo.filter()
		else
			gd_itemsinfo.setfilter("icatcode In (" + ls_itemcategories + ") " + ls_cond + " manfcode In (" + ls_itemmanfs + ") " + ls_cond + " iccode In (" + ls_itemclasses + ") " + ls_cond + " packcode In (" + ls_itempackings + ")")
			gd_itemsinfo.filter()
		end if
	end if
	for li_count = 65 to 90
		lc_char = char(li_count)
		ga_llookuptable[li_count] = gd_itemsinfo.find("Lower(itemname) >= Lower('" + char(li_count) + "')", ll_startrow, 99999)
		ll_startrow = ga_llookuptable[li_count]
	next
	ga_llookuptable[92] = 99999

// w_multi_entry.wf_searchitem_quicksearch(string as_str) returns long
	return 0

