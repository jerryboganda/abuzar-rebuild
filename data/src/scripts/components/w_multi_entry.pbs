// w_multi_entry.wf_refreshitemslist_itemname() returns 0
	s_popup_selection lstr_selection
	long ll_counter
	boolean lb_enablerestricted
	string ls_selection
	integer[] la_icatcode
	long li_count
	long ll_startrow
	char lc_char
	open(w_popup_itemsearchcriteriaselection)
	lstr_selection = message.powerobjectparm
	if lstr_selection.l_code > 0 then
		ls_selection = lstr_selection.s_name2
		gd_itemsinfo.reset()
		gd_itemsinfo.setfilter("")
		gd_itemsinfo.filter()
		if f_stringpreferences("GroupCategoryRights") = "Y" then
			gd_itemsinfo.retrieve(gi_catlist, f_getgroupcode(gl_usercode))
		else
			gd_itemsinfo.retrieve(f_getgroupcode(gl_usercode))
		end if
		for ll_counter = 1 to gds_securitywindow.rowcount()
			if gds_securitywindow.object.rightcode[ll_counter] = 515 then
				lb_enablerestricted = true
			end if
		next
		if lb_enablerestricted = false then
			gd_itemsinfo.setfilter(" restricted = 'N' AND itemname LIKE '" + ls_selection + "'")
			gd_itemsinfo.filter()
		else
			gd_itemsinfo.setfilter("itemname LIKE '" + ls_selection + "'")
			gd_itemsinfo.filter()
		end if
		for li_count = 65 to 90
			lc_char = char(li_count)
			ga_llookuptable[li_count] = gd_itemsinfo.find("Lower(itemname) >= Lower('" + char(li_count) + "')", ll_startrow, 99999)
			ll_startrow = ga_llookuptable[li_count]
		next
		ga_llookuptable[92] = 99999
	end if

// w_multi_entry.wf_refreshitemslist_drilldown() returns 0
	s_popup_selection lstr_selection
	long ll_counter
	boolean lb_enablerestricted
	string ls_selection
	string as_icode
	integer[] la_icatcode
	datastore lds_itemlist
	long li_count
	long ll_startrow
	char lc_char
	open(w_popup_criteriaselection)
	lstr_selection = message.powerobjectparm
	if lstr_selection.l_code > 0 then
		ls_selection = lstr_selection.s_name2
		openwithparm(w_popup_criteriavaluesselection, lstr_selection)
		lstr_selection = message.powerobjectparm
		if lstr_selection.l_code > 0 then
			ls_selection = lstr_selection.s_name2
			lds_itemlist = create datastore
			lds_itemlist.dataobject = gd_popup_itemsinfo.dataobject
			lds_itemlist.settransobject(sqlca)
			gd_popup_itemsinfo.sharedata(lds_itemlist)
			lds_itemlist.setfilter(ls_selection + " = " + string(lstr_selection.l_code))
			lds_itemlist.filter()
			as_icode = ""
			for ll_counter = 1 to lds_itemlist.rowcount()
				as_icode = as_icode + trim(string(lds_itemlist.object.code[ll_counter])) + ","
			next
			if right(as_icode, 1) = "," then
				as_icode = left(as_icode, len(as_icode) - 1)
			end if
			gd_itemsinfo.reset()
			gd_itemsinfo.setfilter("")
			gd_itemsinfo.filter()
			if f_stringpreferences("GroupCategoryRights") = "Y" then
				gd_itemsinfo.retrieve(gi_catlist, f_getgroupcode(gl_usercode))
			else
				gd_itemsinfo.retrieve(f_getgroupcode(gl_usercode))
			end if
			for ll_counter = 1 to gds_securitywindow.rowcount()
				if gds_securitywindow.object.rightcode[ll_counter] = 515 then
					lb_enablerestricted = true
				end if
			next
			if lb_enablerestricted = false then
				gd_itemsinfo.setfilter(" restricted = 'N' AND ICode IN (" + as_icode + ")")
				gd_itemsinfo.filter()
			else
				gd_itemsinfo.setfilter("ICode IN (" + as_icode + ")")
				gd_itemsinfo.filter()
			end if
			for li_count = 65 to 90
				lc_char = char(li_count)
				ga_llookuptable[li_count] = gd_itemsinfo.find("Lower(itemname) >= Lower('" + char(li_count) + "')", ll_startrow, 99999)
				ll_startrow = ga_llookuptable[li_count]
			next
			ga_llookuptable[92] = 99999
		end if
	end if

