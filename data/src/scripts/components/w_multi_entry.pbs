// w_multi_entry.wf_findfullcode(string as_fullcode, ref long al_icode, ref string as_itemname, ref long al_itemcodetype) returns long
	long ll_retflag
	setnull(al_icode)
	as_itemname = "                                                            "
	this.it_transobject.getaliasname(gl_usercode, as_fullcode, al_icode, as_itemname, al_itemcodetype)
	if this.it_transobject.sqlcode = 0 then
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_multi_entry.wf_findfullcode(string as_fullcode, ref long al_icode, ref string as_itemname, ref long al_itemcodetype, ref double ad_qty) returns long
	long ll_retflag
	setnull(al_icode)
	as_itemname = "                                                            "
	this.it_transobject.getaliasname_withqty(gl_usercode, as_fullcode, al_icode, as_itemname, al_itemcodetype, ad_qty)
	if this.it_transobject.sqlcode = 0 then
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_multi_entry.wf_find_service_fullcode(string as_aliasname, ref long al_servicecode, ref string as_servicename) returns long
	long ll_retflag
	setnull(al_servicecode)
	as_servicename = "                                                                  "
	this.it_transobject.getservice_aliasname(gl_usercode, as_aliasname, al_servicecode, as_servicename)
	if this.it_transobject.sqlcode = 0 then
		if isnull(al_servicecode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_multi_entry.wf_findfullcode(string as_fullcode, ref long al_icode, ref string as_itemname, ref long al_itemcodetype, ref double ad_qty, ref double ad_purprice, ref double ad_saleprice) returns long
	long ll_retflag
	setnull(al_icode)
	as_itemname = "                                                            "
	this.it_transobject.getaliasname_withqtyprice(gl_usercode, as_fullcode, al_icode, as_itemname, al_itemcodetype, ad_qty, ad_purprice, ad_saleprice)
	if this.it_transobject.sqlcode = 0 then
		if isnull(al_icode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_multi_entry.wf_check_module_rights(long al_usercode, long al_rightcode) returns long
	boolean lb_rightexists
	long ll_groupcode
	long ll_rightcode
	ll_groupcode = f_getgroupcode(al_usercode)
	if ll_groupcode > 0 then
		SQL SELECT MAX ( RightCode ) INTO :ll_rightcode FROM GroupRights WHERE GroupCode =:ll_groupcode AND RightCode =:al_rightcode USING this.it_transobject;
		if isnull(ll_rightcode) or ll_rightcode = 0 then
			messagebox("User Group Rights Validation", "You do not have rights/permission for the concerned transaction~r~nPlease Contact administrator to the needfull", stopsign!)
			return -1
		else
			return 0
		end if
		return
	end if
	return -2

// w_multi_entry.create() returns 0 [event]
	integer icurrent
	call super::create
	if this.menuname = "m_multi_entry" then
		this.menuid = create m_multi_entry
	end if
	this.tab_retrieve = create tab_retrieve
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.tab_retrieve

// w_multi_entry.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.tab_retrieve

// w_multi_entry.open() returns long [event]
	long ancestorreturnvalue
	m_entry lm_menu
	long ll_width
	long ll_height
	environment env
	ancestorreturnvalue = super::open()
	postevent("ue_postopen")
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	lm_menu.dynamic mf_initsecurityapp(lm_menu)
	if getenvironment(env) <> 1 then
		return ::message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.tab_retrieve.width = ll_width * 0.99
	this.tab_retrieve.height = ll_height * 0.83
	this.tab_retrieve.tabpage_detail.dw_detail.width = ll_width * 0.98
	this.tab_retrieve.tabpage_detail.dw_itemsdetail.width = ll_width * 0.98
	this.tab_retrieve.tabpage_detail.dw_footer.y = this.tab_retrieve.height * 0.90 - this.tab_retrieve.tabpage_detail.dw_footer.height
	this.tab_retrieve.tabpage_detail.dw_detail.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width
	this.tab_retrieve.tabpage_detail.dw_footer.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width
	this.tab_retrieve.tabpage_detail.dw_itemsdetail.height = this.tab_retrieve.tabpage_detail.dw_footer.y - this.tab_retrieve.tabpage_detail.dw_itemsdetail.y
	this.tab_retrieve.tabpage_list.gb_fliter.width = ll_width * 0.97 - this.tab_retrieve.tabpage_list.gb_sort.width
	this.tab_retrieve.tabpage_list.r_1.width = ll_width * 0.99
	this.tab_retrieve.tabpage_list.r_1.height = ll_height * 0.765 - this.tab_retrieve.tabpage_list.gb_sort.height
	this.tab_retrieve.tabpage_list.dw_list.width = ll_width * 0.98
	this.tab_retrieve.tabpage_list.dw_list.height = ll_height * 0.75 - this.tab_retrieve.tabpage_list.dw_list.y
	if int(this.tab_retrieve.tabpage_list.ddlb_data.width / this.tab_retrieve.tabpage_list.width) < 26 then
		this.tab_retrieve.tabpage_list.ddlb_data.width = int(this.tab_retrieve.tabpage_list.width * 0.26)
	end if
	this.tab_retrieve.tabpage_detail.dw_itemslist.height = ll_height * 0.6
	this.tab_retrieve.tabpage_detail.dw_itemslist.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width * 0.67
	this.tab_retrieve.tabpage_detail.dw_itemslist.x = 1150
	setredraw(true)
	return ::message.returnvalue

// w_multi_entry.ue_detail() returns 0 [event]
	long ll_code
	long ll_rowcount
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.im_menu.m_file.m_print.enabled = true
	this.i_editmode = 2
	this.i_retrievemode = 2
	ll_code = this.id_dwcontrol.object.code[this.il_selectedrow]
	this.id_dwcontrol = this.id_master
	ll_rowcount = wf_retrieve(ll_code)
	this.id_master.setrow(1)
	this.id_master.scrolltorow(1)
	this.id_dwcontrol = this.id_footer
	wf_retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	this.id_dwcontrol = this.id_detail
	wf_retrieve(ll_code)
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	this.id_dwcontrol = this.id_list

// w_multi_entry.ue_list() returns 0 [event]
	long ll_rtcode = 1
	call super::ue_list
	if this.id_list.rowcount() <= 0 then
		ll_rtcode = wf_retrievelist()
		if ll_rtcode <= 0 then
			ll_rtcode = wf_retrievelistall()
		end if
	end if
	if ll_rtcode > 0 then
		this.im_menu.m_file.m_new.enabled = true
		this.im_menu.m_file.m_save.enabled = false
		this.im_menu.m_file.m_delete.enabled = false
		this.im_menu.m_item.m_newitem.enabled = false
		this.im_menu.m_item.m_deleteitem.enabled = false
		this.im_menu.m_item.m_insertnewitem.enabled = false
		this.im_menu.m_item.m_deletecurrentitem.enabled = false
		this.im_menu.m_file.m_first.enabled = true
		this.im_menu.m_file.m_next.enabled = true
		this.im_menu.m_file.m_last.enabled = true
		this.im_menu.m_file.m_print.enabled = true
		this.im_menu.m_file.m_previous.enabled = true
		this.im_menu.m_file.m_retrieve.text = "De&tail"
		this.i_retrievemode = 2
		this.i_editmode = 2
		if this.il_selectedrow = 0 then
			wf_first()
			wf_selectunselectrow(1)
		else
			this.il_selectedrow = 1
		end if
		this.tab_retrieve.tabpage_list.dw_find.setfocus()
		return
	end if
	messagebox("Result", "No rows or retrieved possible empty table~r~nInsert some rows first")
	postevent("ue_new")

// w_multi_entry.ue_new() returns 0 [event]
	call super::ue_new
	this.i_editmode = 1
	this.ib_commitok = false
	this.tab_retrieve.selectedtab = 1
	this.id_master.setfocus()

// w_multi_entry.ue_retrieve() returns 0 [event]
	call super::ue_retrieve
	if this.i_retrievemode = 1 then
		this.i_editmode = 2
		this.tab_retrieve.selectedtab = 1
		return
	end if
	this.tab_retrieve.selectedtab = 2

// w_multi_entry.ue_save() returns 0 [event]
	setpointer(hourglass!)
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if this.id_master.update(true, false) < 0 then
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return
	end if
	if this.id_detail.update() > 0 then
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		this.ib_commitok = true
		this.id_master.resetupdate()
		this.im_menu.m_file.m_new.enabled = true
		this.editflag = false
		if gd_recenttransdate < this.id_systemdate then
			gd_recenttransdate = this.id_systemdate
		end if
	else
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return
	end if
	setpointer(arrow!)

// w_multi_entry.ue_first() returns 0 [event]
	long ll_code
	call super::ue_first
	ll_code = wf_first()
	wf_selectunselectrow(1)
	if this.tab_retrieve.selectedtab = 1 then
		postevent("ue_detail")
	end if
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_previous.enabled = false

// w_multi_entry.ue_last() returns 0 [event]
	long ll_code
	call super::ue_last
	ll_code = wf_last()
	wf_selectunselectrow(this.id_list.rowcount())
	if this.tab_retrieve.selectedtab = 1 then
		postevent("ue_detail")
	end if
	this.im_menu.m_file.m_next.enabled = false
	this.im_menu.m_file.m_previous.enabled = true

// w_multi_entry.ue_next() returns 0 [event]
	long ll_code
	call super::ue_next
	ll_code = wf_next()
	wf_selectunselectrow(this.id_dwcontrol.getrow())
	if this.id_dwcontrol.getselectedrow(0) = this.id_dwcontrol.rowcount() then
		this.im_menu.m_file.m_next.enabled = false
	end if
	this.im_menu.m_file.m_previous.enabled = true
	if this.tab_retrieve.selectedtab = 1 then
		postevent("ue_detail")
	end if

// w_multi_entry.ue_previous() returns 0 [event]
	long ll_code
	call super::ue_previous
	ll_code = wf_previous()
	wf_selectunselectrow(this.id_dwcontrol.getrow())
	if this.id_dwcontrol.getselectedrow(0) = 1 then
		this.im_menu.m_file.m_previous.enabled = false
	end if
	this.im_menu.m_file.m_next.enabled = true
	if this.tab_retrieve.selectedtab = 1 then
		postevent("ue_detail")
	end if

// w_multi_entry.ue_newform() returns 0 [event]
	call super::ue_newform
	setredraw(false)
	this.i_editmode = 1
	this.i_retrievemode = 2
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_new.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true
	this.im_menu.m_item.m_insertnewitem.enabled = true
	this.im_menu.m_item.m_deletecurrentitem.enabled = true
	this.im_menu.m_file.m_first.enabled = false
	this.im_menu.m_file.m_next.enabled = false
	this.im_menu.m_file.m_previous.enabled = false
	this.im_menu.m_file.m_last.enabled = false
	this.im_menu.m_file.m_print.enabled = false
	this.im_menu.m_file.m_retrieve.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.tab_retrieve.tabpage_detail.enabled = true
	if this.id_master.rowcount() > 0 then
		this.id_master.reset()
	end if
	this.ib_focusdetail = false
	this.id_master.insertrow(0)
	this.id_detail.reset()
	this.id_detail.insertrow(0)
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	this.ids_itemrecyclebin.reset()
	setredraw(true)

// w_multi_entry.ue_exit() returns 0 [event]
	call super::ue_exit
	postevent("close")

// w_multi_entry.closequery() returns long [event]
	long ancestorreturnvalue
	integer li_yesno
	integer li_rtcode
	ancestorreturnvalue = super::closequery()
	if this.editflag = true then
		li_yesno = messagebox("Invoice", "Do You want to save changes", question!, yesnocancel!, 2)
		if li_yesno = 1 then
			triggerevent("ue_save")
			if wf_commitform() = false then
				li_rtcode = 1
			end if
		elseif li_yesno = 3 then
			li_rtcode = 1
		end if
	end if
	return li_rtcode

// w_multi_entry.close() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::close()
	wf_disconnect()
	return ::message.returnvalue

// w_multi_entry.ue_postopen() returns 0 [event]
	string ls_describe
	call super::ue_postopen
	setredraw(false)
	wf_connect()
	this.id_master = this.tab_retrieve.tabpage_detail.dw_detail
	this.id_detail = this.tab_retrieve.tabpage_detail.dw_itemsdetail
	this.id_footer = this.tab_retrieve.tabpage_detail.dw_footer
	this.id_list = this.tab_retrieve.tabpage_list.dw_list
	this.id_itemslist = this.tab_retrieve.tabpage_detail.dw_itemslist
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_itemslist.settransobject(this.it_transobject)
	this.id_dwcontrol = this.id_list
	post wf_populate_ddlb(this.id_dwcontrol)
	this.tab_retrieve.tabpage_list.dw_find.settransobject(this.it_transobject)
	this.id_master.setfocus()
	setredraw(true)
	if f_stringpreferences("aliasname") = "N" then
		this.id_itemslist.object.fullcode.visible = false
	end if
	if f_stringpreferences("localitemname") = "N" then
		ls_describe = trim(this.id_itemslist.describe("localitemname.visible"))
		if ls_describe = "1" then
			this.id_itemslist.object.localitemname.visible = false
		end if
	end if
	if f_stringpreferences("itempackingdesc") = "N" then
		this.id_itemslist.object.packingdesc.visible = false
	end if
	if f_stringpreferences("itemlocation") = "N" then
		this.id_itemslist.object.location.visible = false
	end if
	if f_stringpreferences("GenericItemName") = "N" and this.id_itemslist.describe("genericname.visible") <> "!" then
		this.id_itemslist.object.genericname.visible = false
	end if
	if this.id_itemslist.describe("c_pack_sstock.visible") <> "!" then
		if f_stringpreferences("PackStock") = "Y" and this.is_child = "w_sale" then
			this.id_itemslist.object.c_pack_sstock.visible = true
			this.id_itemslist.object.t_c_pack_sstock.visible = true
		else
			this.id_itemslist.object.c_pack_sstock.visible = false
			this.id_itemslist.object.t_c_pack_sstock.visible = false
		end if
	end if
	this.ids_itemrecyclebin = create datastore
	this.ids_itemrecyclebin.dataobject = this.id_detail.dataobject
	this.ids_itemrecyclebin.settransobject(this.it_transobject)

// w_multi_entry.activate() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::activate()
	this.windowstate = maximized!
	setredraw(true)
	return ::message.returnvalue

// tab_retrieve.ue_losefocus() returns 0 [event]
	this.tabpage_detail.dw_detail.setfocus()

// tab_retrieve.selectionchanging(integer oldindex, integer newindex) returns long [event]
	integer li_yesno
	integer li_rtcode
	if oldindex = 1 and newindex = 2 and parent.editflag = true and parent.id_detail.rowcount() > 0 then
		li_yesno = messagebox("Confirm Changes", "Yes to save changes that you've typed", question!, yesnocancel!, 2)
		if li_yesno = 1 then
			getparent().triggerevent("ue_save")
			if getparent().dynamic wf_commitform() = false then
				li_rtcode = 1
			end if
		elseif li_yesno = 3 then
			li_rtcode = 1
		else
			parent.editflag = false
			parent.i_editmode = 2
		end if
	end if
	return li_rtcode

// tab_retrieve.create() returns 0 [event]
	this.tabpage_detail = create tabpage_detail
	this.tabpage_list = create tabpage_list
	this.control = {this.tabpage_detail, this.tabpage_list}

// tab_retrieve.destroy() returns 0 [event]
	destroy this.tabpage_detail
	destroy this.tabpage_list

// tab_retrieve.selectionchanged(integer oldindex, integer newindex) returns long [event]
	if newindex = 1 and parent.i_editmode = 2 then
		parent.event ue_detail()
	elseif newindex = 1 and parent.i_editmode = 1 then
		parent.post event ue_newform()
	else
		parent.event ue_list()
	end if
	return ::message.returnvalue

// tab_retrieve.key(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		postevent("ue_losefocus")
	end if
	return ::message.returnvalue

// tabpage_detail.ue_focusfooter() returns 0 [event]
	this.dw_footer.setfocus()

// tabpage_detail.ue_focusheader() returns 0 [event]
	this.dw_detail.setfocus()

// tabpage_detail.ue_focusdetail() returns 0 [event]
	this.dw_itemsdetail.setfocus()

// tabpage_detail.create() returns 0 [event]
	this.dw_footer = create dw_footer
	this.dw_detail = create dw_detail
	this.dw_itemsdetail = create dw_itemsdetail
	this.dw_itemslist = create dw_itemslist
	this.control = {this.dw_footer, this.dw_detail, this.dw_itemsdetail, this.dw_itemslist}

// tabpage_detail.destroy() returns 0 [event]
	destroy this.dw_footer
	destroy this.dw_detail
	destroy this.dw_itemsdetail
	destroy this.dw_itemslist

// dw_footer.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	if parent.parent.parent.editflag = false then
		parent.parent.parent.editflag = true
		parent.parent.parent.im_menu.m_file.m_save.enabled = true
	end if
	return ::message.returnvalue

// dw_footer.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_footer.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	parent.parent.parent.editflag = true
	return ::message.returnvalue

// dw_footer.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	integer currentrow
	integer rt_code
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyuparrow! then
		currentrow = getrow()
		if currentrow = 1 then
			getparent().dynamic postevent("ue_FocusDetail")
			rt_code = 1
		end if
	end if
	return rt_code

// dw_footer.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_footer.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_detail.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_detail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	if parent.parent.parent.editflag = false then
		parent.parent.parent.editflag = true
		parent.parent.parent.im_menu.m_file.m_save.enabled = true
	end if
	return ::message.returnvalue

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	parent.parent.parent.editflag = true
	return ::message.returnvalue

// dw_detail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	string ls_colname
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	selecttext(1, len(gettext()))
	ls_colname = dwo.name
	w_main.setmicrohelp(describe(ls_colname + ".tag"))
	return ::message.returnvalue

// dw_itemsdetail.ue_restore(long al_currrow) returns integer [event]
	integer ancestorreturnvalue
	ancestorreturnvalue = super::ue_restore(al_currrow)
	parent.parent.parent.id_itemslist.selectrow(parent.parent.parent.id_itemslist.getrow(), true)
	setrow(al_currrow)
	scrolltorow(al_currrow)
	selecttext(1, len(gettext()))
	parent.parent.parent.ib_itemvalidated = true
	parent.parent.parent.il_currrow = al_currrow
	setredraw(true)
	return 1

// dw_itemsdetail.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	if parent.parent.parent.im_menu.m_file.m_save.enabled = true then
		if not parent.parent.parent.ib_focusdetail then
			parent.parent.parent.ib_focusdetail = true
			parent.parent.parent.post wf_showlist(0)
		end if
		if parent.parent.parent.ib_itemslistopen then
			parent.parent.parent.id_itemslist.show()
			setfocus()
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.losefocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::losefocus()
	if parent.parent.parent.ib_itemslistopen then
		parent.parent.parent.id_itemslist.hide()
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		parent.parent.parent.event ue_newitem()
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.parent.parent.editflag = true
	selecttext(1, len(gettext()) + 10)
	if dwo.name = parent.parent.parent.is_columnitemname then
		if isnull(getitemnumber(row, "icode")) and parent.parent.parent.ib_focusdetail then
			parent.parent.parent.wf_showlist(getitemnumber(row, "CurrListRow"))
		end if
	else
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
	end if
	return 0

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	integer rt_code
	integer ii_module
	long ll_currrow
	long ll_listcurrrow
	long ll_icode
	long ll_found
	long ll_rowm
	s_datastore lstr_ds
	s_popup_selection lstr_selection
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if getcolumnname() = parent.parent.parent.is_columnitemname then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollnextrow()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyuparrow! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollpriorrow()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keypagedown! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollnextpage()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keypageup! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrollpriorpage()
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyend! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrolltorow(parent.parent.parent.id_itemslist.rowcount())
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyhome! then
			if parent.parent.parent.id_itemslist.visible then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.scrolltorow(1)
				ll_listcurrrow = parent.parent.parent.id_itemslist.getrow()
				rt_code = 1
			else
				rt_code = 2
			end if
		elseif key = keyback! then
			parent.parent.parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf7! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			lstr_ds.s_name1 = gd_popup_itemsinfo.dataobject
			lstr_ds.s_name2 = "name"
			openwithparm(w_popup_responsivesearch_selection, lstr_ds)
			lstr_selection = message.powerobjectparm
			if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(lstr_selection.l_code2), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 and ll_found <= parent.parent.parent.id_itemslist.rowcount() then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf8! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("namesearch", 1)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf9! then
			parent.parent.parent.ib_itemslistopen = false
			parent.parent.parent.id_itemslist.hide()
			setredraw(true)
			ll_icode = f_drilldown_itemsearch("criteriasearch", 1)
			if ll_icode > 0 then
				ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_found > 0 then
					ll_listcurrrow = ll_found
					parent.parent.parent.id_itemslist.selectrow(0, false)
					rt_code = 1
				end if
			end if
			setfocus()
		elseif key = keyf4! then
			parent.parent.parent.wf_showlist(getitemnumber(getrow(), "currlistrow"))
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			if parent.parent.parent.id_itemslist.rowcount() > 0 then
				setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
			end if
			selecttext(1, len(gettext()))
			parent.parent.parent.ib_itemvalidated = false
			parent.parent.parent.il_currrow = ll_rowm
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		elseif rt_code = 2 then
			ll_rowm = getrow()
			parent.parent.parent.id_itemslist.selectrow(0, false)
			if getrow() > 0 then
				ll_listcurrrow = parent.parent.parent.id_itemslist.find("itemname = '" + this.object.itemname[ll_rowm] + "'", 1, parent.parent.parent.id_itemslist.rowcount())
				if ll_listcurrrow > 0 and ll_listcurrrow <= parent.parent.parent.id_itemslist.rowcount() then
					parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
					setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
					setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
					setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
					selecttext(1, len(gettext()))
					parent.parent.parent.ib_itemvalidated = true
					parent.parent.parent.il_currrow = ll_rowm
					setitem(ll_rowm, "CurrListRow", ll_listcurrrow)
					setredraw(true)
				end if
				rt_code = 0
			end if
		end if
	elseif key = keydownarrow! then
		ll_currrow = getrow()
		if ll_currrow = rowcount() then
			getparent().dynamic postevent("ue_focusfooter")
			rt_code = 1
		end if
	elseif key = keyuparrow! then
		ll_currrow = getrow()
		if ll_currrow = 1 then
			getparent().dynamic postevent("ue_FocusHeader")
			rt_code = 1
		end if
	end if
	if getcolumnname() = "fullcode" and key = keyf7! then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
		setredraw(true)
		lstr_ds.s_name1 = gd_popup_itemsinfo.dataobject
		lstr_ds.s_name2 = "aliasname"
		openwithparm(w_popup_responsivesearch_selection, lstr_ds)
		lstr_selection = message.powerobjectparm
		if lstr_selection.l_code > 0 and lstr_selection.l_code2 > 0 then
			ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(lstr_selection.l_code2), 1, parent.parent.parent.id_itemslist.rowcount())
			if ll_found > 0 and ll_found <= parent.parent.parent.id_itemslist.rowcount() then
				ll_listcurrrow = ll_found
				parent.parent.parent.id_itemslist.selectrow(0, false)
				rt_code = 1
			end if
		end if
		setfocus()
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			ll_rowm = getrow()
			if ll_rowm > 0 then
				setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
				setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				selecttext(1, len(gettext()))
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = ll_rowm
			end if
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	end if
	if getcolumnname() = "fullcode" and key = keyf8! then
		parent.parent.parent.ib_itemslistopen = false
		parent.parent.parent.id_itemslist.hide()
		setredraw(true)
		ll_icode = f_drilldown_itemsearch("aliasnamesearch", ii_module)
		if ll_icode > 0 then
			ll_found = parent.parent.parent.id_itemslist.find("icode = " + string(ll_icode), 1, parent.parent.parent.id_itemslist.rowcount())
			if ll_found > 0 then
				ll_listcurrrow = ll_found
				parent.parent.parent.id_itemslist.selectrow(0, false)
				rt_code = 1
			end if
		end if
		setfocus()
		if rt_code = 1 then
			parent.parent.parent.id_itemslist.selectrow(ll_listcurrrow, true)
			ll_rowm = getrow()
			if ll_rowm > 0 then
				setitem(ll_rowm, "fullcode", parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "fullcode"))
				setitem(ll_rowm, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(ll_listcurrrow, "itemname"))
				setitem(ll_rowm, "icode", parent.parent.parent.id_itemslist.getitemnumber(ll_listcurrrow, "icode"))
				selecttext(1, len(gettext()))
				parent.parent.parent.ib_itemvalidated = false
				parent.parent.parent.il_currrow = ll_rowm
			end if
			setitem(getrow(), "CurrListRow", ll_listcurrrow)
			setredraw(true)
		end if
	end if
	return rt_code

// dw_itemsdetail.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_currrow
	long ll_startrow
	long ll_endrow
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	if parent.parent.parent.editflag = false then
		parent.parent.parent.editflag = true
		parent.parent.parent.im_menu.m_file.m_save.enabled = true
	end if
	choose case dwo.name
	case parent.parent.parent.is_columnitemname
		parent.parent.parent.is_name_value = data
		if upper(left(data, 1)) >= "A" and upper(left(data, 1)) <= "Z" or left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
			ll_currrow = parent.parent.parent.id_itemslist.getrow()
			if len(data) > 1 then
				ll_startrow = ll_currrow
			else
				if left(data, 1) >= "0" and left(data, 1) <= "9" or left(data, 1) = "*" then
					ll_startrow = 1
				else
					ll_startrow = ga_llookuptable[asc(upper(data))]
				end if
				parent.parent.parent.ib_bkspace = false
			end if
			if parent.parent.parent.ib_bkspace then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.find("Lower(itemname) <= '" + lower(data) + "'", ll_startrow, 0)
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.il_itemlistfoundrow + 1
				parent.parent.parent.ib_bkspace = false
			else
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.find("Lower(itemname) >= '" + lower(data) + "'", ll_startrow, parent.parent.parent.id_itemslist.rowcount())
			end if
			if parent.parent.parent.il_itemlistfoundrow = 0 then
				parent.parent.parent.il_itemlistfoundrow = parent.parent.parent.id_itemslist.rowcount()
			end if
			if parent.parent.parent.il_itemlistfoundrow <> ll_currrow then
				parent.parent.parent.id_itemslist.selectrow(0, false)
				parent.parent.parent.id_itemslist.setrow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_itemslist.scrolltorow(parent.parent.parent.il_itemlistfoundrow)
				parent.parent.parent.id_itemslist.selectrow(parent.parent.parent.il_itemlistfoundrow, true)
				ll_endrow = setitem(row, "currlistrow", parent.parent.parent.il_itemlistfoundrow)
				ll_endrow = getitemnumber(row, "currlistrow")
				setfocus()
			end if
		end if
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = row
	end choose
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	parent.parent.parent.editflag = true
	return 0

// dw_itemsdetail.ue_focusqty() returns 0 [event]
	call super::ue_focusqty
	setcolumn("looseqty")
	setfocus()

// dw_itemsdetail.ue_findnext(long al_foundrow) returns 0 [event]
	super::ue_findnext(al_foundrow)
	parent.parent.parent.idc_itemdddw.setredraw(true)
	parent.parent.parent.idc_itemdddw.selectrow(al_foundrow, true)

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "fullcode"
		parent.parent.parent.ib_validatefullcode = false
	end choose
	return ::message.returnvalue

// dw_itemslist.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	long ll_rowmain
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	if row > 0 then
		ll_rowmain = parent.parent.parent.id_detail.getrow()
		parent.parent.parent.id_detail.setitem(ll_rowmain, parent.parent.parent.is_columnitemname, parent.parent.parent.id_itemslist.getitemstring(row, parent.parent.parent.is_columnitemname))
		parent.parent.parent.id_detail.setitem(ll_rowmain, "icode", parent.parent.parent.id_itemslist.getitemnumber(row, "icode"))
		parent.parent.parent.id_detail.setitem(ll_rowmain, "fullcode", parent.parent.parent.id_itemslist.getitemstring(row, "fullcode"))
		parent.parent.parent.id_detail.selecttext(1, len(gettext()))
		parent.parent.parent.ib_itemvalidated = false
		parent.parent.parent.il_currrow = ll_rowmain
		selectrow(0, false)
		selectrow(row, true)
	end if
	return ::message.returnvalue

// tabpage_list.create() returns 0 [event]
	this.r_1 = create r_1
	this.gb_sort = create gb_sort
	this.gb_fliter = create gb_fliter
	this.ddlb_sort = create ddlb_sort
	this.rb_ascending = create rb_ascending
	this.rb_descending = create rb_descending
	this.ddlb_filter_column = create ddlb_filter_column
	this.ddlb_op = create ddlb_op
	this.ddlb_data = create ddlb_data
	this.cb_filter = create cb_filter
	this.dw_list = create dw_list
	this.st_find = create st_find
	this.st_1 = create st_1
	this.st_2 = create st_2
	this.dw_find = create dw_find
	this.cb_retrieve = create cb_retrieve
	this.control = {this.r_1, this.gb_sort, this.gb_fliter, this.ddlb_sort, this.rb_ascending, this.rb_descending, this.ddlb_filter_column, this.ddlb_op, this.ddlb_data, this.cb_filter, this.dw_list, this.st_find, this.st_1, this.st_2, this.dw_find, this.cb_retrieve}

// tabpage_list.destroy() returns 0 [event]
	destroy this.r_1
	destroy this.gb_sort
	destroy this.gb_fliter
	destroy this.ddlb_sort
	destroy this.rb_ascending
	destroy this.rb_descending
	destroy this.ddlb_filter_column
	destroy this.ddlb_op
	destroy this.ddlb_data
	destroy this.cb_filter
	destroy this.dw_list
	destroy this.st_find
	destroy this.st_1
	destroy this.st_2
	destroy this.dw_find
	destroy this.cb_retrieve

// ddlb_sort.selectionchanged(integer index) returns long [event]
	string ls_columntype
	integer temp1
	integer temp2
	parent.parent.parent.ii_colindex = integer(parent.parent.parent.id_dwcontrol.describe(parent.ddlb_sort.text + ".ID"))
	ls_columntype = parent.parent.parent.id_dwcontrol.describe("#" + string(parent.parent.parent.ii_colindex) + ".ColType")
	if left(ls_columntype, 4) = "char" then
		parent.parent.parent.ii_type = 1
	elseif left(ls_columntype, 4) = "date" then
		parent.parent.parent.ii_type = 3
	else
		parent.parent.parent.ii_type = 2
	end if
	parent.parent.parent.im_menu.m_file.m_next.enabled = false
	parent.parent.parent.im_menu.m_file.m_previous.enabled = false
	parent.parent.parent.im_menu.m_file.m_retrieve.enabled = false
	parent.parent.parent.tab_retrieve.tabpage_detail.enabled = false
	parent.parent.parent.wf_sortdw(parent.ddlb_sort.text, parent.parent.parent.is_sortsequence)
	return ::message.returnvalue

// rb_ascending.clicked() returns long [event]
	parent.parent.parent.tab_retrieve.tabpage_detail.enabled = false
	parent.parent.parent.im_menu.m_file.m_retrieve.enabled = false
	parent.parent.parent.im_menu.m_file.m_next.enabled = false
	parent.parent.parent.im_menu.m_file.m_previous.enabled = false
	parent.parent.parent.is_sortsequence = "A"
	parent.parent.parent.tab_retrieve.tabpage_list.rb_descending.checked = false
	parent.parent.parent.wf_sortdw(parent.ddlb_sort.text, parent.parent.parent.is_sortsequence)
	return ::message.returnvalue

// rb_descending.clicked() returns long [event]
	parent.parent.parent.tab_retrieve.tabpage_detail.enabled = false
	parent.parent.parent.im_menu.m_file.m_retrieve.enabled = false
	parent.parent.parent.im_menu.m_file.m_next.enabled = false
	parent.parent.parent.im_menu.m_file.m_previous.enabled = false
	parent.parent.parent.is_sortsequence = "D"
	parent.parent.parent.tab_retrieve.tabpage_list.rb_ascending.checked = false
	parent.parent.parent.wf_sortdw(parent.ddlb_sort.text, parent.parent.parent.is_sortsequence)
	return ::message.returnvalue

// ddlb_filter_column.selectionchanged(integer index) returns long [event]
	dwbuffer le_buffertype
	integer li_buffers
	long ll_row_counter
	long ll_rows_buffer
	long li_items
	long li_index
	string ls_column_name
	string ls_col_type
	string ls_insert_item
	string ls_buffertype
	setpointer(hourglass!)
	if index > 0 then
		if parent.parent.parent.tab_retrieve.tabpage_list.cb_filter.text = "Un&filter" then
			parent.parent.parent.tab_retrieve.tabpage_list.cb_filter.triggerevent(clicked!)
		end if
		ls_column_name = parent.parent.parent.tab_retrieve.tabpage_list.ddlb_filter_column.text
		parent.ddlb_data.reset()
		ls_col_type = parent.parent.parent.id_dwcontrol.describe(ls_column_name + ".ColType")
		le_buffertype = primary!
		ll_rows_buffer = parent.parent.parent.id_dwcontrol.rowcount()
		for li_buffers = 1 to 2
			for ll_row_counter = 1 to ll_rows_buffer
				if left(ls_col_type, 4) = "char" then
					ls_insert_item = trim(parent.parent.parent.id_dwcontrol.getitemstring(ll_row_counter, ls_column_name, le_buffertype, false))
				elseif left(ls_col_type, 4) = "date" then
					ls_insert_item = string(parent.parent.parent.id_dwcontrol.getitemdatetime(ll_row_counter, ls_column_name, le_buffertype, false), "d/m/yy")
				else
					ls_insert_item = string(parent.parent.parent.id_dwcontrol.getitemnumber(ll_row_counter, ls_column_name, le_buffertype, false))
				end if
				li_index = parent.parent.parent.tab_retrieve.tabpage_list.ddlb_data.finditem(ls_insert_item, 0)
				if li_index <= 0 then
					parent.parent.parent.tab_retrieve.tabpage_list.ddlb_data.insertitem(ls_insert_item, 1)
				end if
			next
			le_buffertype = filter!
			ll_rows_buffer = parent.parent.parent.id_dwcontrol.filteredcount()
		next
		parent.ddlb_data.sorted = true
		parent.ddlb_data.visible = true
	end if
	return ::message.returnvalue

// ddlb_op.selectionchanged(integer index) returns long [event]
	if parent.parent.parent.tab_retrieve.tabpage_list.cb_filter.text = "Un&filter" then
		parent.cb_filter.triggerevent(clicked!)
	end if
	return ::message.returnvalue

// ddlb_data.selectionchanged(integer index) returns long [event]
	if parent.cb_filter.text = "Un&filter" then
		parent.parent.parent.wf_filter()
	end if
	return ::message.returnvalue

// cb_filter.clicked() returns long [event]
	string filt
	string quote
	string ls_column_name
	string ls_match_data
	parent.parent.parent.tab_retrieve.tabpage_detail.enabled = false
	parent.parent.parent.im_menu.m_file.m_retrieve.enabled = false
	parent.parent.parent.im_menu.m_file.m_next.enabled = false
	parent.parent.parent.im_menu.m_file.m_previous.enabled = false
	if parent.cb_filter.text = "Un&filter" then
		parent.cb_filter.text = "&Filter"
		filt = ""
		parent.parent.parent.tab_retrieve.tabpage_list.dw_list.setfilter(filt)
		parent.parent.parent.id_dwcontrol.filter()
	else
		parent.cb_filter.text = "Un&filter"
		parent.parent.parent.wf_filter()
		if parent.parent.parent.tab_retrieve.tabpage_list.dw_list.rowcount() = 0 then
			parent.parent.parent.tab_retrieve.tabpage_list.dw_find.object.find[1] = string("")
		end if
	end if
	return ::message.returnvalue

// dw_list.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	if row = 1 then
		parent.parent.parent.im_menu.m_file.m_previous.enabled = false
		parent.parent.parent.im_menu.m_file.m_next.enabled = true
	elseif row = parent.parent.parent.id_dwcontrol.rowcount() then
		parent.parent.parent.im_menu.m_file.m_next.enabled = false
		parent.parent.parent.im_menu.m_file.m_previous.enabled = true
	else
		parent.parent.parent.im_menu.m_file.m_next.enabled = true
		parent.parent.parent.im_menu.m_file.m_previous.enabled = true
	end if
	parent.parent.parent.wf_selectunselectrow(row)
	parent.getparent().dynamic postevent("ue_getfocus")
	return ::message.returnvalue

// dw_list.doubleclicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::doubleclicked(xpos, ypos, row, dwo)
	if row > 0 then
		parent.parent.parent.il_selectedrow = row
		parent.parent.parent.tab_retrieve.selectedtab = 1
	end if
	return ::message.returnvalue

// dw_list.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	parent.getparent().dynamic postevent("ue_getfocus")
	return ::message.returnvalue

// dw_list.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	parent.getparent().dynamic postevent("ue_getfocus")
	return ::message.returnvalue

// dw_find.keypressed(keycode key, unsignedlong keyflags) returns long [event]
	integer li_movement
	long ll_row
	long ll_temp
	string sl_columnname
	string ls_rightid
	s_popup_selection lstr_selection
	s_datastore lstr_ds
	if key = keyuparrow! then
		ll_row = parent.parent.parent.id_list.getrow() - 1
		parent.parent.parent.id_list.scrollpriorrow()
	elseif key = keydownarrow! then
		ll_row = parent.parent.parent.id_list.getrow() + 1
		parent.parent.parent.id_list.scrollnextrow()
	elseif key = keypagedown! then
		parent.parent.parent.id_list.scrollnextpage()
		ll_row = parent.parent.parent.id_dwcontrol.getrow()
	elseif key = keypageup! then
		parent.parent.parent.id_list.scrollpriorpage()
		ll_row = parent.parent.parent.id_dwcontrol.getrow()
	elseif key = keyhome! then
		scrolltorow(1)
		ll_row = 1
		parent.parent.parent.id_list.setrow(ll_row)
		parent.parent.parent.id_list.scrolltorow(ll_row)
	elseif key = keyend! then
		ll_row = parent.parent.parent.id_list.rowcount()
		scrolltorow(ll_row)
	elseif key = keyenter! then
		if parent.parent.parent.id_dwcontrol.getselectedrow(0) > 0 then
			parent.parent.parent.i_editmode = 2
			parent.parent.parent.tab_retrieve.selectedtab = 1
			return ::message.returnvalue
		end if
	elseif key = keyf5! then
		ll_row = parent.parent.parent.wf_retrievelist_datelimit()
		if ll_row > 0 then
			scrolltorow(1)
			ll_row = 1
		end if
	elseif key = keyf6! then
		lstr_ds.dw = parent.parent.parent.id_list
		lstr_ds.s_name1 = parent.parent.parent.id_list.dataobject
		openwithparm(w_popup_comprehensicesearch_selection2, lstr_ds)
		lstr_selection = ::message.powerobjectparm
		if lstr_selection.l_code > 0 then
			if lstr_selection.l_code2 > 0 then
				ll_temp = parent.parent.parent.id_list.find("code = " + string(lstr_selection.l_code2), 1, parent.parent.parent.id_list.rowcount())
				if ll_temp > 0 then
					ll_row = ll_temp
					parent.parent.parent.id_list.scrolltorow(ll_row)
				end if
			end if
		else
			ll_row = 0
		end if
	elseif key = keyf9! then
		ll_row = parent.parent.parent.id_dwcontrol.getrow()
		if ll_row > 0 then
			parent.parent.parent.wf_editpostedinvoice()
			setfocus()
		end if
	end if
	if ll_row > 0 and ll_row <= parent.parent.parent.id_dwcontrol.rowcount() then
		parent.parent.parent.id_list.setredraw(false)
		parent.parent.parent.tab_retrieve.tabpage_detail.enabled = true
		parent.parent.parent.im_menu.m_file.m_retrieve.enabled = true
		parent.parent.parent.id_list.selectrow(0, false)
		parent.parent.parent.id_list.selectrow(ll_row, true)
		if parent.parent.parent.ii_type = 1 then
			setitem(1, "find", parent.parent.parent.id_list.getitemstring(ll_row, parent.parent.parent.ii_colindex))
		elseif parent.parent.parent.ii_type = 3 then
			setitem(1, "find", trim(string(parent.parent.parent.id_list.getitemdatetime(ll_row, parent.parent.parent.ii_colindex))))
		else
			setitem(1, "find", trim(string(parent.parent.parent.id_list.getitemnumber(ll_row, parent.parent.parent.ii_colindex))))
		end if
		parent.parent.parent.il_selectedrow = ll_row
		selecttext(1, len(gettext()))
		parent.parent.parent.id_list.setredraw(true)
	end if
	return ::message.returnvalue

// dw_find.editchanged(long row, dwobject dwo, string data) returns long [event]
	integer li_movement
	long ll_row
	string sl_columnname
	string ls_character
	long ll_found_row
	integer li_num_chars
	string str
	if len(data) > 0 then
		sl_columnname = parent.parent.parent.id_dwcontrol.describe("#" + string(parent.parent.parent.ii_colindex) + ".name")
		parent.parent.parent.id_dwcontrol.setredraw(false)
		if parent.parent.parent.is_sortsequence = "A" then
			if parent.parent.parent.ii_type = 1 then
				ll_found_row = f_binarysearch(data, parent.parent.parent.id_dwcontrol, sl_columnname)
			elseif parent.parent.parent.ii_type = 3 then
				if isdate(data) then
					ll_found_row = f_binarysearch_date(data, parent.parent.parent.id_dwcontrol, sl_columnname)
				end if
			else
				ll_found_row = f_binarysearch_long(long(data), parent.parent.parent.id_dwcontrol, sl_columnname)
			end if
		elseif parent.parent.parent.ii_type = 1 then
			ll_found_row = f_binarysearch_string(data, parent.parent.parent.id_dwcontrol, sl_columnname)
		elseif parent.parent.parent.ii_type = 3 then
			ll_found_row = parent.parent.parent.id_dwcontrol.find(sl_columnname + " <=DateTime('" + data + "')", 1, 99999)
		else
			ll_found_row = f_binarysearchdesc_long(long(data), parent.parent.parent.id_dwcontrol, sl_columnname)
		end if
		if ll_found_row > 0 then
			parent.parent.parent.tab_retrieve.tabpage_detail.enabled = true
			parent.parent.parent.im_menu.m_file.m_retrieve.enabled = true
			parent.parent.parent.id_dwcontrol.setredraw(false)
			parent.parent.parent.id_dwcontrol.selectrow(0, false)
			parent.parent.parent.id_dwcontrol.scrolltorow(ll_found_row)
			parent.parent.parent.id_dwcontrol.selectrow(ll_found_row, true)
			parent.parent.parent.id_dwcontrol.setredraw(true)
		else
			parent.parent.parent.id_dwcontrol.scrolltorow(0)
			parent.parent.parent.id_dwcontrol.selectrow(0, false)
			parent.parent.parent.id_dwcontrol.setredraw(true)
			parent.parent.parent.tab_retrieve.tabpage_detail.enabled = false
			parent.parent.parent.im_menu.m_file.m_retrieve.enabled = false
			parent.parent.parent.im_menu.m_file.m_next.enabled = false
			parent.parent.parent.im_menu.m_file.m_previous.enabled = false
		end if
		parent.parent.parent.id_dwcontrol.setredraw(true)
	else
		parent.parent.parent.id_dwcontrol.scrolltorow(0)
		parent.parent.parent.id_dwcontrol.selectrow(0, false)
		parent.parent.parent.id_dwcontrol.setredraw(true)
		parent.parent.parent.tab_retrieve.tabpage_detail.enabled = false
		parent.parent.parent.im_menu.m_file.m_retrieve.enabled = false
		parent.parent.parent.im_menu.m_file.m_next.enabled = false
		parent.parent.parent.im_menu.m_file.m_previous.enabled = false
	end if
	parent.parent.parent.il_selectedrow = ll_found_row
	return ::message.returnvalue

// cb_retrieve.clicked() returns long [event]
	long ll_rtcode
	parent.parent.parent.id_list.reset()
	ll_rtcode = parent.parent.parent.wf_retrievelistall()
	parent.parent.parent.wf_first()
	parent.parent.parent.wf_selectunselectrow(1)
	parent.parent.parent.tab_retrieve.tabpage_list.dw_find.setfocus()
	return ::message.returnvalue
