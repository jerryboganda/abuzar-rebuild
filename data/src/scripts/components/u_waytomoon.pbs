// userobject u_waytomoon (components)  ancestor: nonvisualobject

// u_waytomoon.of_setdbname(string as_dbname) returns 0
	this.is_dbname = as_dbname

// u_waytomoon.of_setcompname(string as_compname) returns 0
	this.is_compname = as_compname

// u_waytomoon.of_settransobject(transaction as_transobject) returns 0
	this.it_transobject = as_transobject

// u_waytomoon.of_createtemptable() returns long
	long ll_count
	long ll_retcode
	string ls_query
	SQL Select Count ( *) INTO :ll_count From tempdb.dbo.syscolumn USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		this.it_transobject.autocommit = true
		ls_query = "Create Table tempdb.dbo.syscolumn (sys VarChar(300) Not Null, cn VarChar(200) Not Null, cc Int Not Null)"
		SQL EXECUTE IMMEDIATE :ls_query USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			ll_retcode = 1
		else
			SQL rollback USING this.it_transobject;
			ll_retcode = -1
		end if
	else
		ll_retcode = 2
	end if
	this.it_transobject.autocommit = false
	return ll_retcode

// u_waytomoon.of_getcurrentconns() returns long
	long ll_retvalue
	SQL Select Count ( Distinct cn ) INTO :ll_retvalue From tempdb.dbo.syscolumn Where sys =:gs_dbname USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		ll_retvalue = -1
	end if
	return ll_retvalue

// u_waytomoon.of_createsession() returns long
	string ls_query
	long ll_count
	SQL Select Count ( *) INTO :ll_count From tempdb.dbo.syscolumn Where sys =:gs_dbname And cn =:this.is_compname USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_count > 0 then
			ls_query = "Update tempdb.dbo.syscolumn Set  cc = cc +  1  Where sys = '" + this.is_dbname + "'  And cn = '" + this.is_compname + "'"
			SQL EXECUTE IMMEDIATE :ls_query USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				return -1
			end if
		else
			ls_query = "Insert Into tempdb.dbo.syscolumn values ('" + this.is_dbname + "' ,  '" + this.is_compname + "' , 1)"
			SQL EXECUTE IMMEDIATE :ls_query USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				return -1
			end if
		end if
	else
		return -1
	end if
	return 0

// u_waytomoon.of_endsession() returns long
	string ls_query
	long ll_count
	SQL Select cc INTO :ll_count From tempdb.dbo.syscolumn Where sys =:this.is_dbname And cn =:this.is_compname USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_count > 1 then
			ls_query = "Update tempdb.dbo.syscolumn Set  cc = cc -  1  Where sys = '" + this.is_dbname + "'  And cn = '" + this.is_compname + "'"
			SQL EXECUTE IMMEDIATE :ls_query USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				return -1
			end if
		else
			ls_query = "Delete From tempdb.dbo.syscolumn where sys='" + this.is_dbname + "'  And cn = '" + this.is_compname + "' "
			SQL EXECUTE IMMEDIATE :ls_query USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				return -1
			end if
		end if
	else
		return -1
	end if
	return 0

// u_waytomoon.of_createsession_setup() returns long
	long ll_noofclients
	long ll_retcode
	long ll_currentconnections
	of_connect()
	SQL Select fcatlength INTO :ll_noofclients From syscatelog Where fcatid =8 USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		ll_retcode = -1
	elseif of_createtemptable() <= 0 then
		ll_retcode = -1
	elseif ll_noofclients = 1 then
		if lower(this.is_servername) = lower(this.is_compname) then
			if of_createsession() = 0 then
				SQL commit USING this.it_transobject;
				ll_retcode = 0
			else
				SQL rollback USING this.it_transobject;
				ll_retcode = -1
			end if
		else
			ll_retcode = -1
		end if
	elseif ll_noofclients > 1 then
		ll_currentconnections = of_getcurrentconns()
		if ll_currentconnections + 1 <= ll_noofclients and ll_currentconnections >= 0 then
			if of_createsession() = 0 then
				SQL commit USING this.it_transobject;
				ll_retcode = 0
			else
				SQL rollback USING this.it_transobject;
				ll_retcode = -1
			end if
		else
			ll_retcode = -1
		end if
	end if
	of_disconnect()
	return ll_retcode

// u_waytomoon.of_connect() returns long
	SQL start USING this.it_transobject;
	return this.it_transobject.sqlcode

// u_waytomoon.of_disconnect() returns long
	SQL stop USING this.it_transobject;
	return this.it_transobject.sqlcode

// u_waytomoon.create() returns 0 [event]
	call super::create
	triggerevent("constructor")

// u_waytomoon.destroy() returns 0 [event]
	triggerevent("destructor")
	call super::destroy

// u_waytomoon.constructor() returns long [event]
	u_utilityservices lo_us
	lo_us = create u_utilityservices
	this.is_compname = lo_us.of_getcomputername()
	this.is_dbname = gs_dbname
	if pos(gs_servername, "\") > 0 then
		this.is_servername = left(gs_servername, pos(gs_servername, "\") - 1)
	else
		this.is_servername = gs_servername
	end if
	this.it_transobject = create u_transaction
	destroy u_utilityservices
	return ::message.returnvalue
