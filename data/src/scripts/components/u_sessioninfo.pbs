// userobject u_sessioninfo (components)  ancestor: nonvisualobject

// u_sessioninfo.of_setdbname(string as_dbname) returns 0
	this.is_dbname = as_dbname

// u_sessioninfo.of_setcompname(string as_compname) returns 0
	this.is_compname = as_compname

// u_sessioninfo.of_settransobject(transaction as_transobject) returns 0
	this.it_transobject = as_transobject

// u_sessioninfo.of_createtemptable() returns long
	long ll_count
	long ll_retcode
	string ls_query
	SQL Select Count ( *) INTO :ll_count From tempdb.dbo.sysisolaation USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		this.it_transobject.autocommit = true
		ls_query = "Create Table tempdb.dbo.sysisolaation (id int not null, sys VarChar(300) Not Null, cn VarChar(200) Not Null, cc int not null)"
		SQL EXECUTE IMMEDIATE :ls_query USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			ll_retcode = 1
		else
			SQL rollback USING this.it_transobject;
			ll_retcode = -1
		end if
	else
		ll_retcode = 2
	end if
	this.it_transobject.autocommit = false
	return ll_retcode

// u_sessioninfo.of_getcurrentconns() returns long
	long ll_retvalue
	SQL Select Count ( id ) INTO :ll_retvalue From tempdb.dbo.sysisolaation Where sys =:gs_dbname USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		ll_retvalue = -1
	end if
	return ll_retvalue

// u_sessioninfo.of_createsession() returns long
	string ls_query
	string ls_allow_userlogin_multiplerimes
	long ll_user_login_count
	SQL SELECT PrefValue INTO :ls_allow_userlogin_multiplerimes FROM SoftwarePreferences WHERE PrefID =65 USING this.it_transobject;
	if ls_allow_userlogin_multiplerimes = "" or isnull(ls_allow_userlogin_multiplerimes) then
		ls_allow_userlogin_multiplerimes = "Y"
	end if
	if ls_allow_userlogin_multiplerimes = "N" then
		SQL SELECT ISNULL ( Count ( cc ) , - 1 ) INTO :ll_user_login_count FROM tempdb.dbo.sysisolaation WHERE sys =:gs_dbname AND cc =:gl_usercode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			if not (ll_user_login_count = -1 or ll_user_login_count = 0) then
				return -5
			end if
		else
			return -3
		end if
		return
	end if
	ls_query = "Insert Into tempdb.dbo.sysisolaation (id, sys, cn, cc) values (" + trim(string(gl_sessionid)) + ", '" + this.is_dbname + "' ,  '" + this.is_compname + "', " + trim(string(gl_usercode)) + ")"
	SQL EXECUTE IMMEDIATE :ls_query USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		return -1
	end if
	return 0

// u_sessioninfo.of_endsession() returns long
	string ls_query
	long ll_id
	SQL Select id INTO :ll_id From tempdb.dbo.sysisolaation Where id =:gl_sessionid AND sys =:this.is_dbname And cn =:this.is_compname USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_id > 0 then
			ls_query = "Delete From tempdb.dbo.sysisolaation where id = " + string(gl_sessionid) + " and sys='" + this.is_dbname + "'  And cn = '" + this.is_compname + "' "
			SQL EXECUTE IMMEDIATE :ls_query USING this.it_transobject;
			if this.it_transobject.sqlcode <> 0 then
				return -1
			end if
			return
		end if
	else
		return -1
	end if
	return 0

// u_sessioninfo.of_createsession_setup() returns long
	long ll_noofclients
	long ll_retcode
	long ll_currentconnections
	of_connect()
	SQL Select fcatlength INTO :ll_noofclients From syscatelog Where fcatid =8 USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		ll_retcode = -1
	elseif of_createtemptable() <= 0 then
		ll_retcode = -1
	elseif ll_noofclients = 1 then
		if lower(this.is_servername) = lower(this.is_compname) then
			ll_currentconnections = of_getcurrentconns()
			if ll_currentconnections > 0 then
				ll_retcode = -1
			else
				ll_retcode = of_createsession()
				if ll_retcode = 0 then
					SQL commit USING this.it_transobject;
					ll_retcode = 0
				else
					SQL rollback USING this.it_transobject;
				end if
			end if
		else
			ll_retcode = -2
		end if
	elseif ll_noofclients > 1 then
		ll_currentconnections = of_getcurrentconns()
		if ll_currentconnections + 1 <= ll_noofclients and ll_currentconnections >= 0 then
			ll_retcode = of_createsession()
			if ll_retcode = 0 then
				SQL commit USING this.it_transobject;
				ll_retcode = 0
			else
				SQL rollback USING this.it_transobject;
			end if
		else
			ll_retcode = -1
		end if
	end if
	of_disconnect()
	return ll_retcode

// u_sessioninfo.of_connect() returns long
	SQL start USING this.it_transobject;
	return this.it_transobject.sqlcode

// u_sessioninfo.of_disconnect() returns long
	SQL stop USING this.it_transobject;
	return this.it_transobject.sqlcode

// u_sessioninfo.create() returns 0
	call super::create
	triggerevent("constructor")

// u_sessioninfo.destroy() returns 0
	triggerevent("destructor")
	call super::destroy

// u_sessioninfo.constructor() returns long
	u_utilityservices lo_us
	lo_us = create u_utilityservices
	this.is_compname = lo_us.of_getcomputername()
	this.is_dbname = gs_dbname
	if pos(gs_servername, "\") > 0 then
		this.is_servername = left(gs_servername, pos(gs_servername, "\") - 1)
	else
		this.is_servername = gs_servername
	end if
	this.it_transobject = create u_transaction
	destroy u_utilityservices
	return ::message.returnvalue
