// window w_password (components)  ancestor: window

// w_password.create() returns 0
	this.sle_password = create sle_password
	this.st_1 = create st_1
	this.control = {this.sle_password, this.st_1}

// w_password.destroy() returns 0
	destroy this.sle_password
	destroy this.st_1

// sle_password.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	string ls_actualpassword
	string ls_retpassword
	integer li_salesmancode
	if key = keyenter! then
		ls_actualpassword = lower(this.text)
		setnull(ls_retpassword)
		SQL SELECT dbo.salesman.password , salesmancode INTO :ls_retpassword, :li_salesmancode FROM dbo.salesman WHERE lower ( dbo.salesman.password ) =:ls_actualpassword USING sqlca;
		if sqlca.sqlcode <> 0 then
			messagebox("Database Error", "Password can not be validated")
		end if
		if isnull(ls_retpassword) then
			messagebox("Password", "Password is not correct")
			parent.sle_password.setfocus()
			parent.sle_password.selecttext(1, 20)
		else
			closewithreturn(parent, li_salesmancode)
		end if
	end if
	return ::message.returnvalue
