// userobject nv_qrcode (components)  ancestor: nonvisualobject

// nv_qrcode.get_qr_code_bitmap(string as_filename, string as_text, long al_errcorlvl, long al_bordersize, long al_scale) returns long
	return createbmpfile(as_filename, as_text, al_errcorlvl, al_bordersize, al_scale)

// nv_qrcode.get_qr_code_bitmap_simple(string as_filename, string as_text) returns long
	return get_qr_code_bitmap(as_filename, as_text, 1, 4, 4)

// nv_qrcode.create() returns 0
	call super::create
	triggerevent("constructor")

// nv_qrcode.destroy() returns 0
	triggerevent("destructor")
	call super::destroy
