// window w_restoreitem (components)  ancestor: window

// w_restoreitem.ue_keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		post event ue_close()
	end if
	return ::message.returnvalue

// w_restoreitem.ue_close() returns 0
	closewithreturn(this, this.ids_restoreitem)

// w_restoreitem.wf_assigndwobjects(string as_detaildw) returns 0
	this.dw_detail.dataobject = as_detaildw
	this.dw_detail.settransobject(sqlca)

// w_restoreitem.create() returns 0
	this.cb_cancel = create cb_cancel
	this.cb_restore = create cb_restore
	this.dw_detail = create dw_detail
	this.control = {this.cb_cancel, this.cb_restore, this.dw_detail}

// w_restoreitem.destroy() returns 0
	destroy this.cb_cancel
	destroy this.cb_restore
	destroy this.dw_detail

// w_restoreitem.open() returns long
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_custcode
	this.ids_restoreitem = message.powerobjectparm
	this.dw_detail.dataobject = this.ids_restoreitem.ds.recipienttype
	this.dw_detail.settransobject(sqlca)
	this.ids_restoreitem.ds.sharedata(this.dw_detail)
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// cb_cancel.clicked() returns long
	parent.ids_restoreitem.i_closemode = -1
	parent.post event ue_close()
	return ::message.returnvalue

// cb_restore.clicked() returns long
	long[] ll_invcode
	long ll_rowcount
	long ll_counter
	long ll_arrindex
	long ll_thiscode
	boolean lb_remarks
	string ls_date
	if parent.dw_detail.getrow() > 0 then
		parent.ids_restoreitem.i_closemode = parent.dw_detail.getrow()
	else
		parent.ids_restoreitem.i_closemode = -1
	end if
	parent.post event ue_close()
	return ::message.returnvalue
