// window w_popup_forselection_walias (components)  ancestor: w_popup_forselection

// w_popup_forselection_walias.wf_inititem(string as_aliasname) returns boolean
	long ll_counter
	long ll_detailrows
	long ll_found
	long ll_retflag
	long ll_icode
	long ll_itemcodetype
	double ld_qty
	double ld_purprice
	double ld_saleprice
	string ls_itemname
	ll_detailrows = this.id_selectionlist.rowcount()
	setnull(ll_icode)
	ls_itemname = "                                                            "
	if this.ib_itemsearch then
		sqlca.getaliasname_fromallitems(gl_usercode, as_aliasname, ll_icode, ls_itemname, ll_itemcodetype)
		if sqlca.sqlcode = 0 then
			if isnull(ll_icode) then
				ll_retflag = 0
			else
				ll_retflag = 1
			end if
		else
			ll_retflag = -1
		end if
	else
		ll_retflag = 1
	end if
	if ll_retflag = 1 then
		if this.ib_itemsearch then
			ll_found = this.id_selectionlist.find("code=" + trim(string(ll_icode)), 1, ll_detailrows)
		else
			ll_found = this.id_selectionlist.find("lower(aliasname)='" + lower(as_aliasname) + "'", 1, ll_detailrows)
		end if
		if ll_found > 0 then
			this.id_selected.setitem(this.id_selected.getrow(), "code", this.id_selectionlist.getitemnumber(ll_found, "code"))
			this.id_selected.setitem(this.id_selected.getrow(), "aliasname", this.id_selectionlist.getitemstring(ll_found, "aliasname"))
			this.id_selected.setitem(this.id_selected.getrow(), "name", this.id_selectionlist.getitemstring(ll_found, "name"))
			return true
		end if
		return
	end if
	return false

// w_popup_forselection_walias.create() returns 0 [event]
	call super::create

// w_popup_forselection_walias.destroy() returns 0 [event]
	call super::destroy

// w_popup_forselection_walias.open() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.id_selectionlist.retrieve()
	return ::message.returnvalue

// dw_selected.itemchanged(long row, dwobject dwo, string data) returns long [event]
	integer li_qty
	long ll_icode
	long ll_null
	long ll_gcode
	string ls_itemname
	string ls_null
	setnull(ll_null)
	setnull(ls_null)
	choose case dwo.name
	case "aliasname"
		if parent.wf_inititem(data) = false then
			messagebox("Validation", "AliasName does not exist.~r~nPlease try some other AliasName.")
			setitem(row, "code", ll_null)
			setitem(row, "aliasname", ls_null)
			setitem(row, "name", ls_null)
			return 1
		end if
		parent.ib_itemvalidated = false
	case "name"
		setitem(row, "code", parent.id_selectionlist.getitemnumber(parent.id_selectionlist.getrow(), "code"))
		setitem(row, "aliasname", parent.id_selectionlist.getitemstring(parent.id_selectionlist.getrow(), "aliasname"))
		setitem(row, "name", parent.id_selectionlist.getitemstring(parent.id_selectionlist.getrow(), "name"))
		parent.ib_itemvalidated = false
		return 2
	end choose
	return ::message.returnvalue

// dw_selected.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	integer rt_code
	long ll_currrow
	long ll_listcurrrow
	long ll_rowm
	if getcolumnname() = "name" then
		setredraw(false)
		ll_rowm = getrow()
		if key = keydownarrow! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrollnextrow()
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyuparrow! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrollpriorrow()
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keypagedown! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrollnextpage()
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keypageup! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrollpriorpage()
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyend! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrolltorow(parent.id_selectionlist.rowcount())
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyhome! then
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrolltorow(1)
			ll_listcurrrow = parent.id_selectionlist.getrow()
			rt_code = 1
		elseif key = keyback! then
			parent.ib_bkspace = true
			setredraw(true)
		elseif key = keyescape! then
			parent.id_selectionlist.hide()
			setfocus()
			setredraw(true)
		elseif key = keyf4! then
			parent.id_selectionlist.show()
			parent.id_selectionlist.selectrow(0, false)
			parent.id_selectionlist.scrolltorow(parent.id_selectionlist.getrow())
			parent.id_selectionlist.selectrow(parent.id_selectionlist.getrow(), true)
			setredraw(true)
		else
			setredraw(true)
		end if
		if rt_code = 1 then
			parent.id_selectionlist.selectrow(ll_listcurrrow, true)
			setitem(ll_rowm, "code", parent.id_selectionlist.getitemnumber(ll_listcurrrow, "code"))
			setitem(ll_rowm, "aliasname", parent.id_selectionlist.getitemstring(ll_listcurrrow, "aliasname"))
			setitem(ll_rowm, "name", parent.id_selectionlist.getitemstring(ll_listcurrrow, "name"))
			selecttext(1, len(gettext()))
			setredraw(true)
		end if
	end if
	return rt_code

// dw_selectionlist.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ll_rowmain
	if row > 0 then
		ll_rowmain = parent.id_selected.getrow()
		parent.id_selected.setitem(ll_rowmain, "code", parent.id_selectionlist.getitemnumber(row, "code"))
		parent.id_selected.setitem(ll_rowmain, "name", parent.id_selectionlist.getitemstring(row, "name"))
		parent.id_selected.setitem(ll_rowmain, "aliasname", parent.id_selectionlist.getitemstring(row, "aliasname"))
		parent.id_selected.selecttext(1, len(gettext()))
		parent.ib_itemvalidated = false
		selectrow(0, false)
		selectrow(row, true)
		post event ue_setfocus()
	end if
	return ::message.returnvalue
