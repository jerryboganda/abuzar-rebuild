// window w_popup_itemsearch_criteria (components)  ancestor: window

// w_popup_itemsearch_criteria.ue_close() returns 0
	closewithreturn(this, this.is_popup_selection)

// w_popup_itemsearch_criteria.ue_cancel() returns 0
	this.is_popup_selection.l_code = -1
	closewithreturn(this, this.is_popup_selection)

// w_popup_itemsearch_criteria.ue_keydown(keycode key, unsignedlong keyflags) returns long
	if key = keyescape! then
		post event ue_cancel()
	end if
	return ::message.returnvalue

// w_popup_itemsearch_criteria.create() returns 0
	this.rb_brand = create rb_brand
	this.rb_size = create rb_size
	this.rb_model = create rb_model
	this.rb_type = create rb_type
	this.rb_itemname = create rb_itemname
	this.rb_oldpartno = create rb_oldpartno
	this.rb_partno = create rb_partno
	this.rb_anywhere = create rb_anywhere
	this.rb_endswith = create rb_endswith
	this.rb_startswith = create rb_startswith
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.em_itemname = create em_itemname
	this.gb_searchposition = create gb_searchposition
	this.gb_searchon = create gb_searchon
	this.control = {this.rb_brand, this.rb_size, this.rb_model, this.rb_type, this.rb_itemname, this.rb_oldpartno, this.rb_partno, this.rb_anywhere, this.rb_endswith, this.rb_startswith, this.cb_cancel, this.cb_ok, this.em_itemname, this.gb_searchposition, this.gb_searchon}

// w_popup_itemsearch_criteria.destroy() returns 0
	destroy this.rb_brand
	destroy this.rb_size
	destroy this.rb_model
	destroy this.rb_type
	destroy this.rb_itemname
	destroy this.rb_oldpartno
	destroy this.rb_partno
	destroy this.rb_anywhere
	destroy this.rb_endswith
	destroy this.rb_startswith
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.em_itemname
	destroy this.gb_searchposition
	destroy this.gb_searchon

// w_popup_itemsearch_criteria.open() returns long
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	this.em_itemname.setfocus()
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	parent.is_popup_selection.l_code = -1
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long
	string ls_name
	parent.em_itemname.getdata(ls_name)
	if ls_name = "" or isnull(ls_name) then
		messagebox("Search Criteria Validation", "Please enter a valid string to search for")
		parent.em_itemname.setfocus()
		return ::message.returnvalue
	end if
	parent.is_popup_selection.l_code = 1
	if parent.rb_anywhere.checked then
		parent.is_popup_selection.s_name2 = "%" + ls_name + "%"
	elseif parent.rb_startswith.checked then
		parent.is_popup_selection.s_name2 = ls_name + "%"
	elseif parent.rb_endswith.checked then
		parent.is_popup_selection.s_name2 = "%" + ls_name
	end if
	if parent.rb_partno.checked then
		parent.is_popup_selection.s_name3 = "itempart"
	elseif parent.rb_oldpartno.checked then
		parent.is_popup_selection.s_name3 = "oldpartno"
	elseif parent.rb_itemname.checked then
		parent.is_popup_selection.s_name3 = "itemname"
	elseif parent.rb_type.checked then
		parent.is_popup_selection.s_name3 = "typedescription"
	elseif parent.rb_model.checked then
		parent.is_popup_selection.s_name3 = "modeldescription"
	elseif parent.rb_size.checked then
		parent.is_popup_selection.s_name3 = "sizedescription"
	elseif parent.rb_brand.checked then
		parent.is_popup_selection.s_name3 = "manufacturer"
	end if
	parent.post event ue_close()
	return ::message.returnvalue

// em_itemname.ue_enterkey(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
		return 1
	elseif key = keyescape! then
		parent.post event ue_cancel()
	end if
	return ::message.returnvalue
