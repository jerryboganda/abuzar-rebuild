// userobject u_internetresult_qrcode (components)  ancestor: internetresult

// u_internetresult_qrcode.internetdata(blob data) returns integer
	string ls_fname
	if fileexists(ls_fname) then
		filedelete(ls_fname)
	end if
	f_writeimgtofile(ls_fname, data)
	return this.il_retcode

// u_internetresult_qrcode.create() returns 0 [event]
	call super::create
	triggerevent("constructor")

// u_internetresult_qrcode.destroy() returns 0 [event]
	triggerevent("destructor")
	call super::destroy
