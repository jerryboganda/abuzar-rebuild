// window w_popup_textsearch_criteria (components)  ancestor: window

// w_popup_textsearch_criteria.ue_close() returns 0 [event]
	closewithreturn(this, this.is_popup_selection)

// w_popup_textsearch_criteria.ue_cancel() returns 0 [event]
	this.is_popup_selection.l_code = -1
	closewithreturn(this, this.is_popup_selection)

// w_popup_textsearch_criteria.ue_keydown(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyescape! then
		post event ue_cancel()
	end if
	return ::message.returnvalue

// w_popup_textsearch_criteria.create() returns 0 [event]
	this.rb_anywhere = create rb_anywhere
	this.rb_endswith = create rb_endswith
	this.rb_startswith = create rb_startswith
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.em_string = create em_string
	this.gb_searchposition = create gb_searchposition
	this.control = {this.rb_anywhere, this.rb_endswith, this.rb_startswith, this.cb_cancel, this.cb_ok, this.em_string, this.gb_searchposition}

// w_popup_textsearch_criteria.destroy() returns 0 [event]
	destroy this.rb_anywhere
	destroy this.rb_endswith
	destroy this.rb_startswith
	destroy this.cb_cancel
	destroy this.cb_ok
	destroy this.em_string
	destroy this.gb_searchposition

// w_popup_textsearch_criteria.open() returns long [event]
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	this.em_string.setfocus()
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.is_popup_selection.l_code = -1
	parent.post event ue_close()
	return ::message.returnvalue

// cb_ok.clicked() returns long [event]
	string ls_name
	parent.em_string.getdata(ls_name)
	if ls_name = "" or isnull(ls_name) then
		messagebox("Search Criteria Validation", "Please enter a valid string to search for")
		parent.em_string.setfocus()
		return ::message.returnvalue
	end if
	parent.is_popup_selection.l_code = 1
	if parent.rb_anywhere.checked then
		parent.is_popup_selection.s_name2 = trim(ls_name)
	elseif parent.rb_startswith.checked then
		parent.is_popup_selection.s_name2 = "^" + trim(ls_name)
	elseif parent.rb_endswith.checked then
		parent.is_popup_selection.s_name2 = trim(ls_name) + "$"
	end if
	parent.post event ue_close()
	return ::message.returnvalue

// em_string.ue_enterkey(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		send(handle(this), 256, 9, long(90))
		return 1
	elseif key = keyescape! then
		parent.post event ue_cancel()
	end if
	return ::message.returnvalue
