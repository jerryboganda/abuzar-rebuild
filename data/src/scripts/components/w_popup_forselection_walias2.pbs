		end if
		if ll_found > 0 then
			this.id_selected2.setitem(this.id_selected2.getrow(), "code", this.id_selectionlist2.getitemnumber(ll_found, "code"))
			this.id_selected2.setitem(this.id_selected2.getrow(), "aliasname", this.id_selectionlist2.getitemstring(ll_found, "aliasname"))
			this.id_selected2.setitem(this.id_selected2.getrow(), "name", this.id_selectionlist2.getitemstring(ll_found, "name"))
			return true
		end if
		return
	end if
	return false

// w_popup_forselection_walias2.create() returns 0
	call super::create

// w_popup_forselection_walias2.destroy() returns 0
	call super::destroy

// w_popup_forselection_walias2.open() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::open()
	this.id_selectionlist.retrieve()
	this.id_selectionlist2.retrieve()
	return ::message.returnvalue
