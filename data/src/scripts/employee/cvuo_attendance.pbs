// userobject cvuo_attendance (employee)  ancestor: userobject

// cvuo_attendance.create() returns 0 [event]
	this.st_1 = create st_1
	this.p_fp = create p_fp
	this.p_photo = create p_photo
	this.dw_control = create dw_control
	this.control = {this.st_1, this.p_fp, this.p_photo, this.dw_control}

// cvuo_attendance.destroy() returns 0 [event]
	destroy this.st_1
	destroy this.p_fp
	destroy this.p_photo
	destroy this.dw_control
