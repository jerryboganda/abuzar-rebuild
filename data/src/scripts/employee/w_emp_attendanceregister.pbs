// window w_emp_attendanceregister (employee)  ancestor: w_multi_entry

// w_emp_attendanceregister.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM EMP_Department WHERE name =:as_name USING this.it_transobject;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_emp_attendanceregister.wf_validateitem() returns integer
	long ll_empcode
	long ll_paytype = 1
	integer li_errcode
	string ls_managername
	integer li_null
	ll_empcode = this.id_detail.getitemnumber(this.il_currrow, "empcode")
	if ll_empcode > 0 then
		SQL SELECT ISNULL ( PayType , 1 ) INTO :ll_paytype FROM EMP_Pay WHERE EmpCode =:ll_empcode USING this.it_transobject;
		if this.it_transobject.sqlcode = 0 then
			this.id_detail.object.paytype[this.il_currrow] = ll_paytype
			li_errcode = 0
		end if
	else
		li_errcode = -1
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		setnull(li_null)
		this.id_detail.setcolumn("empcode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.empcode[this.il_currrow] = li_null
	end if
	return li_errcode

// w_emp_attendanceregister.create() returns 0 [event]
	call super::create

// w_emp_attendanceregister.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_emp_attendanceregister.ue_save() returns 0 [event]
	long ll_mastercurrrow
	long ll_invid
	long ll_detailrows
	integer li_counter
	integer ll_salesmancode
	boolean lb_commitflag = true
	datetime ldt_server_datetime
	string ls_date_errtext
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	setpointer(hourglass!)
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		setpointer(arrow!)
		return
	end if
	if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	ll_mastercurrrow = this.id_master.getrow()
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	do while li_counter <= ll_detailrows and lb_commitflag = true
		if this.id_detail.object.oldsupervised[li_counter] = "N" and this.id_detail.object.supervised[li_counter] = "Y" then
			this.id_detail.object.supervisedon[li_counter] = ldt_server_datetime
			this.id_detail.object.supervisedby[li_counter] = gl_usercode
		end if
		li_counter = li_counter + 1
	loop
	if this.id_detail.update(true, true) > 0 then
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		this.ib_commitok = true
		this.id_master.resetupdate()
		this.im_menu.m_file.m_new.enabled = true
		this.editflag = false
		if gd_recenttransdate < this.id_systemdate then
			gd_recenttransdate = this.id_systemdate
		end if
	else
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return
	end if
	setpointer(arrow!)

// w_emp_attendanceregister.ue_newform() returns 0 [event]
	call super::ue_newform
	this.id_master.setfocus()
	if this.id_master.rowcount() > 0 then
		this.id_master.object.startdate[1] = datetime(date(today()), time("00:00:00"))
		this.id_master.object.enddate[1] = datetime(date(today()), time("23:59:59"))
	end if

// w_emp_attendanceregister.ue_newitem() returns 0 [event]
	long ll_rowcount
	long ll_currentrow
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	if this.id_detail.rowcount() > 0 and f_validatedw(this.id_detail) < 0 then
		return
	end if
	ll_currentrow = this.id_detail.getrow()
	this.id_detail.setcolumn(1)
	if ll_currentrow = this.id_detail.rowcount() then
		if this.id_detail.object.empcode[ll_currentrow] > 0 then
			this.id_detail.insertrow(0)
			ll_rowcount = this.id_detail.rowcount()
			if ll_rowcount > 1 then
				this.id_detail.scrolltorow(ll_rowcount)
				this.id_detail.setfocus()
			end if
		end if
	else
		if this.id_detail.object.empcode[ll_currentrow] > 0 then
			this.id_detail.insertrow(ll_currentrow)
			this.id_detail.scrolltorow(ll_currentrow)
		end if
		this.id_detail.setfocus()
	end if
	this.im_menu.m_file.m_save.enabled = true
	this.ib_validatefullcode = true
	this.id_detail.setcolumn("empcode")

// w_emp_attendanceregister.ue_detail() returns 0 [event]
	call super::ue_detail
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_delete.enabled = true
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true

// w_emp_attendanceregister.ue_postopen() returns 0 [event]
	call super::ue_postopen
	this.id_detail.getchild("empcode", this.idc_salesman)
	this.idc_salesman.settransobject(this.it_transobject)

// dw_detail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "name"
		if data = "" or isnull(data) then
			messagebox("Deparment Name Validation", "Value required for Deparment " + upper(dwo.name) + " in current row")
		end if
	end choose
	return 1

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	return ::message.returnvalue

// dw_detail.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
	if dwo.name = "b_retrieve" then
		accepttext()
		if row > 0 then
			parent.parent.parent.id_detail.retrieve(this.object.startdate[row], this.object.enddate[row], this.object.empcode[row])
		end if
	end if
	return ::message.returnvalue

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "empcode"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_itemvalidated = false
		li_errcode = 0
	case else
		parent.parent.parent.ib_itemvalidated = true
	end choose
	return li_errcode

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "empcode"
		if data = "" or isnull(data) then
			messagebox("Employee Validation", "Value required Employee Name in current row")
		end if
	end choose
	return 1

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if parent.parent.parent.ib_itemvalidated = false and parent.parent.parent.wf_validateitem() = -1 then
		return ::message.returnvalue
	end if
	return ::message.returnvalue

// dw_itemsdetail.getfocus() returns long [event]
	setcolumn(1)
	if len(gettext()) > 0 then
		selecttext(1, len(gettext()))
	end if
	return ::message.returnvalue

// dw_itemsdetail.ue_enterkey() returns long [event]
	if getrow() = rowcount() and getcolumn() = integer(this.object.datawindow.column.count) then
		parent.parent.parent.event ue_newitem()
		setcolumn("EmpCode")
		setfocus()
		return 1
	end if
	send(handle(this), 256, 9, long(90))
	return 1

// dw_itemsdetail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	long ll_res
	long ll_counter
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf5! then
		ll_res = 2
		ll_counter = 1
		ll_res = messagebox("Supervise All", "Do you want to supervise each attendance record selected here.", question!, yesnocancel!, 2)
		if ll_res = 1 then
			for ll_counter = 1 to parent.parent.parent.id_detail.rowcount()
				if parent.parent.parent.id_detail.object.oldsupervised[ll_counter] = "N" then
					parent.parent.parent.id_detail.object.supervised[ll_counter] = "Y"
				end if
			next
		end if
	end if
	return ::message.returnvalue
