// w_payroll.create() returns 0 [event]
	integer icurrent
	call super::create
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	if this.menuname = "m_payroll_menu" then
		this.menuid = create m_payroll_menu
	end if
	this.dw_purinvrep = create dw_purinvrep
	this.dw_changeprice_foritemlog = create dw_changeprice_foritemlog
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_purinvrep
	this.control[icurrent + 2] = this.dw_changeprice_foritemlog

// w_payroll.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_purinvrep
	destroy this.dw_changeprice_foritemlog

// w_payroll.ue_save() returns 0 [event]
	integer li_counter = 1
	integer li_option
	long ll_salesmancode = 1
	long ll_mastercurrrow
	long ll_footercurrrow
	long ll_invid
	long ll_detailrows
	long ll_count
	long ll_found
	long ll_rightfound
	double ld_invtotal
	double ld_famt
	double ld_ftot
	boolean lb_commitflag = true
	datetime ldt_expiry
	datetime ldt_server_datetime
	string ls_date_errtext
	date ld_expiry
	string ls_expiry
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	if f_validatedw(this.id_footer) < 0 then
		return
	end if
	ll_detailrows = this.id_detail.rowcount()
	wf_grandtotal()
	ld_invtotal = this.id_footer2.getitemnumber(1, "netpayable")
	if ld_invtotal < 0.0 then
		messagebox("On Save Validation", "Can not save this payroll voucher.~r~nReason: Net Payable amount is negative.")
		return
	end if
	if this.id_master.getitemnumber(1, "netpayable") < 0.0 then
		messagebox("On Save Validation", "Can not save this payroll voucher.~r~nReason: Net Payable amount is negative.")
		return
	end if
	if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
		messagebox("Date Violation", ls_date_errtext, stopsign!)
		return
	end if
	open(w_salesmanpassword)
	ll_salesmancode = long(message.doubleparm)
	setfocus()
	setfocus()
	if ll_salesmancode > 0 then
		setpointer(hourglass!)
		ll_mastercurrrow = this.id_master.getrow()
		ll_footercurrrow = this.id_footer.getrow()
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			f_newtableid("Emp_Payroll", ll_invid)
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
			this.id_master.setitem(ll_mastercurrrow, "usercode", ll_salesmancode)
		end if
		if not wf_getserverdatetime(ldt_server_datetime, ls_date_errtext) then
			messagebox("Date Violation", ls_date_errtext, stopsign!)
			return
		end if
		this.id_master.setitem(ll_mastercurrrow, "lastsaved", ldt_server_datetime)
		this.id_footer.accepttext()
		this.id_master.accepttext()
		this.id_detail.accepttext()
		wf_grandtotal()
		do while li_counter <= ll_detailrows
			this.id_detail.object.code[li_counter] = ll_invid
			li_counter = li_counter + 1
		loop
		ll_count = 0
		for ll_count = 1 to this.id_footer.rowcount()
			this.id_footer.setitem(ll_count, "code", ll_invid)
		next
		if this.id_master.update(true, false) < 0 then
			SQL rollback USING this.it_transobject;
			setpointer(arrow!)
			return
		end if
		if this.id_footer.update(true, false) < 0 then
			SQL rollback USING this.it_transobject;
			setpointer(arrow!)
			return
		end if
		if this.id_detail.update() > 0 then
			SQL commit USING this.it_transobject;
			messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
			this.ib_commitok = true
			this.id_master.resetupdate()
			this.im_menu.m_file.m_new.enabled = true
			this.editflag = false
			if gd_recenttransdate < this.id_systemdate then
				gd_recenttransdate = this.id_systemdate
			end if
		else
			SQL rollback USING this.it_transobject;
			setpointer(arrow!)
			return
		end if
	else
		setfocus()
	end if
	setpointer(arrow!)

// w_payroll.ue_newform() returns 0 [event]
	integer rtncode
	integer ll_counter
	datetime ldt_server_datetime
	string ls_date_errtext
	m_payroll_menu lm_menu
	lm_menu = this.menuid
	setredraw(false)
	this.i_editmode = 1
	this.i_retrievemode = 2
	lm_menu.m_file.m_save.enabled = true
	lm_menu.m_file.m_new.enabled = false
	lm_menu.m_file.m_delete.enabled = false
	lm_menu.m_item.m_newitem.enabled = true
	lm_menu.m_item.m_deleteitem.enabled = true
	lm_menu.m_item.m_insertnewitem.enabled = true
	lm_menu.m_item.m_deletecurrentitem.enabled = true
	lm_menu.m_file.m_first.enabled = false
	lm_menu.m_file.m_next.enabled = false
	lm_menu.m_file.m_previous.enabled = false
	lm_menu.m_file.m_last.enabled = false
	lm_menu.m_file.m_print.enabled = false
	lm_menu.m_file.m_retrieve.enabled = true
	lm_menu.m_file.m_retrieve.text = "Lis&t"
	lm_menu.m_file.m_payrollpayment.enabled = false
	this.tab_retrieve.tabpage_detail.enabled = true
	if this.id_master.rowcount() > 0 then
		this.id_master.reset()
	end if
	this.ib_focusdetail = false
	this.id_master.insertrow(0)
	this.id_detail.reset()
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	this.ids_itemrecyclebin.reset()
	this.id_footer.reset()
	wf_protectdw(this.id_master, 0)
	wf_protectdw(this.id_detail, 0)
	wf_protectdw(this.id_footer, 0)
	wf_protectdw(this.id_footer2, 0)
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	wf_getserverdatetime(ldt_server_datetime, ls_date_errtext)
	this.id_master.setitem(this.id_master.getrow(), "date", ldt_server_datetime)
	this.id_master.object.p_itemimage.filename = ""
	setredraw(true)

// w_payroll.ue_detail() returns 0 [event]
	long ll_code
	long ll_counter
	long ll_found
	integer li_rtncode
	integer li_protect
	char lc_posted
	m_payroll_menu lm_menu
	call super::ue_detail
	lm_menu = this.menuid
	setredraw(false)
	lm_menu.m_file.m_post.enabled = false
	lm_menu.m_file.m_print.enabled = true
	lm_menu.m_file.m_payrollpayment.enabled = false
	if this.il_selectedrow > 0 then
		ll_code = this.id_dwcontrol.borderstyle.code[this.il_selectedrow]
		lc_posted = this.id_dwcontrol.borderstyle.posted[this.il_selectedrow]
	end if
	if wf_isinvoiceinuse(ll_code) = true then
		messagebox("Payroll Validation", "Payroll Voucher already in use by some other user.~r~nKindly try again after sometime.")
		this.tab_retrieve.selecttab(2)
		return
	end if
	this.id_footer.retrieve(ll_code)
	this.id_footer.setrow(1)
	this.id_footer.scrolltorow(1)
	this.id_footer2.retrieve(ll_code)
	this.id_footer2.setrow(1)
	this.id_footer2.scrolltorow(1)
	wf_initmodify(li_protect)
	wf_protectdw(this.id_master, li_protect)
	wf_protectdw(this.id_detail, li_protect)
	wf_protectdw(this.id_footer, li_protect)
	wf_protectdw(this.id_footer2, li_protect)
	lm_menu.m_file.m_save.enabled = false
	if li_protect = 1 then
		this.editflag = false
	end if
	wf_grandtotal()
	this.id_master.object.p_itemimage.filename = ""
	if ll_code > 0 and this.id_master.rowcount() > 0 then
		wf_set_employee_image(this.id_master.object.empcode[1])
	end if
	if lc_posted = "N" then
		lm_menu.m_file.m_save.enabled = true
	end if
	setredraw(true)

