// w_payroll.ue_new() returns 0 [event]
	call super::ue_new
	this.im_menu.m_file.m_post.enabled = false

// w_payroll.ue_list() returns 0 [event]
	m_payroll_menu lm_menu
	long ll_counter
	call super::ue_list
	lm_menu = this.menuid
	SQL rollback USING this.it_transobject;
	lm_menu.m_file.m_post.enabled = true
	lm_menu.m_file.m_print.enabled = true
	lm_menu.m_file.m_payrollpayment.enabled = true

// w_payroll.ue_refreshddw() returns 0 [event]
	call super::ue_refreshddw
	setpointer(hourglass!)
	this.idc_employee.setredraw(false)
	this.idc_employee.settransobject(this.it_transobject)
	this.idc_employee.reset()
	this.idc_employee.retrieve()
	this.idc_employee.setredraw(true)
