// w_payroll.ue_print() returns 0 [event]
	long ll_invcode
	long ll_suppcode
	long ll_row
	string ls_suppname
	string ls_printbalance
	string ls_invoicesize
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	wf_selectprintreport()
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if this.id_print.rowcount() > 0 then
		if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
			messagebox("Printer", "Printing Error")
			this.id_print.printcancel()
		end if
		if this.id_print.print() < 0 then
			messagebox("Printing", "Can not Print", information!)
		end if
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print~r~nNo rows are retrieved", information!)

// w_payroll.ue_postopen() returns 0 [event]
	m_payroll_menu lm_menu
	integer li_rtncode
	long ll_code
	long ll_counter
	long ll_found
	call super::ue_postopen
	lm_menu = this.menuid
	setredraw(false)
	this.id_footer2 = this.tab_retrieve.tabpage_detail.dw_footer2
	this.id_footer2.settransobject(this.it_transobject)
	this.id_print = this.dw_purinvrep
	this.id_print.settransobject(this.it_transobject)
	wf_assigndatawindowobjects("d_emp_payroll", "d_emp_payrollallowances", "d_emp_payrolllist", "d_emp_payrolldeduction", "d_emp_payrollfooter")
	this.id_footer2.insertrow(0)
	this.id_footer2.scrolltorow(0)
	this.it_imagetrans = create u_transaction
	SQL start USING this.it_imagetrans;
	wf_apply_preferences()
	if f_rightexists(5287) then
		lm_menu.m_file.m_generatepayrollslips.visible = true
		lm_menu.m_file.m_generatepayrollslips.enabled = true
	end if
	setredraw(true)

// w_payroll.open() returns long [event]
	m_payroll_menu lm_menu
	long ll_width
	long ll_height
	environment env
	postevent("ue_postopen")
	wf_setmenu(this.menuid)
	lm_menu = this.menuid
	lm_menu.dynamic mf_initsecurityapp(lm_menu)
	if getenvironment(env) <> 1 then
		return ::message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.tab_retrieve.width = ll_width * 0.99
	this.tab_retrieve.height = ll_height * 0.83
	this.tab_retrieve.tabpage_detail.dw_detail.width = ll_width * 0.98
	this.tab_retrieve.tabpage_detail.dw_itemsdetail.width = ll_width * 0.98
	this.tab_retrieve.tabpage_detail.dw_detail.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width
	this.tab_retrieve.tabpage_detail.dw_footer.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width
	this.tab_retrieve.tabpage_detail.dw_footer2.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width
	this.tab_retrieve.tabpage_detail.dw_footer.height = (this.tab_retrieve.height * 0.90 - this.tab_retrieve.tabpage_detail.dw_detail.height - this.tab_retrieve.tabpage_detail.dw_footer2.height) / 2
	this.tab_retrieve.tabpage_detail.dw_itemsdetail.height = (this.tab_retrieve.height * 0.90 - this.tab_retrieve.tabpage_detail.dw_detail.height - this.tab_retrieve.tabpage_detail.dw_footer2.height) / 2
	this.tab_retrieve.tabpage_detail.dw_footer.y = this.tab_retrieve.tabpage_detail.dw_itemsdetail.y + this.tab_retrieve.tabpage_detail.dw_itemsdetail.height + 10
	this.tab_retrieve.tabpage_detail.dw_footer2.y = this.tab_retrieve.tabpage_detail.dw_footer.y + this.tab_retrieve.tabpage_detail.dw_footer.height + 10
	this.tab_retrieve.tabpage_list.gb_fliter.width = ll_width * 0.97 - this.tab_retrieve.tabpage_list.gb_sort.width
	this.tab_retrieve.tabpage_list.r_1.width = ll_width * 0.99
	this.tab_retrieve.tabpage_list.r_1.height = ll_height * 0.765 - this.tab_retrieve.tabpage_list.gb_sort.height
	this.tab_retrieve.tabpage_list.dw_list.width = ll_width * 0.98
	this.tab_retrieve.tabpage_list.dw_list.height = ll_height * 0.75 - this.tab_retrieve.tabpage_list.dw_list.y
	this.tab_retrieve.tabpage_detail.dw_itemslist.height = ll_height * 0.6
	this.tab_retrieve.tabpage_detail.dw_itemslist.width = this.tab_retrieve.tabpage_detail.dw_itemsdetail.width * 0.73
	setredraw(true)
	show()
	return ::message.returnvalue

