// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_result
	long ll_code
	long ll_detailrows
	long ll_res
	long ll_empcode
	long ll_days
	double ld_price
	double ld_rate
	string ls_null
	date ld_null
	datetime ldt_date
	dwitemstatus lrs_status
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "date"
		this.object.paymentdate[row] = datetime(data)
		return 0
	case "empcode"
		ll_code = long(data)
		if parent.parent.parent.wf_set_employee_info(ll_code) = 0 then
			parent.parent.parent.wf_update_salary(dwo.name, data)
			return 0
		else
			return 1
		end if
	case "empid"
		if not isnull(data) and data <> "" then
			ll_res = parent.parent.parent.wf_find_empcode(data, ll_empcode)
			if ll_res > 0 then
				setitem(row, "empcode", ll_empcode)
				parent.parent.parent.wf_set_employee_info(ll_empcode)
				parent.parent.parent.wf_update_salary(dwo.name, data)
				return 0
			else
				messagebox("Employee Validation", "Employee with  Employee ID  " + data + " does not exist")
				return 1
			end if
			return
		end if
	case "todate"
		if not isnull(data) then
			ldt_date = datetime(date(left(data, 10)), time(mid(data, 12, len(data))))
			if ldt_date < this.object.fromdate[row] then
				messagebox("To Date Validation", "Please enter valid Date", stopsign!)
				return 1
			else
				ll_days = daysafter(date(this.object.fromdate[row]), date(ldt_date)) + 1
				this.object.workdays[row] = ll_days
				return 0
			end if
		else
			return 0
		end if
	case "fromdate"
		if not isnull(data) then
			ldt_date = datetime(date(left(data, 10)), time(mid(data, 12, len(data))))
			if ldt_date > this.object.todate[row] then
				messagebox("From Date Validation", "Please enter valid Date", stopsign!)
				return 1
			else
				ll_days = daysafter(date(this.object.fromdate[row]), date(data)) + 1
				this.object.workdays[row] = ll_days
				return 0
			end if
		else
			return 0
		end if
	case "workdays"
		if long(data) >= 0 then
			return 0
		else
			messagebox("Work Days Validation", "Please enter valid Work Days", stopsign!)
			return 1
		end if
	case "presents"
		if long(data) >= 0 then
			if long(data) > this.object.workdays[row] then
				messagebox("Presents Validation", "Please enter valid Presents", stopsign!)
				return 1
			else
				if this.object.paytype[row] = 1 then
					this.object.hoursworked[row] = (long(data) + this.object.leaves[row]) * this.object.workinghours[row]
				end if
				parent.parent.parent.wf_update_salary(dwo.name, data)
				return 0
			end if
		else
			messagebox("Presents Validation", "Please enter valid Presents", stopsign!)
			return 1
		end if
	case "absents"
		if long(data) >= 0 then
			if long(data) > this.object.workdays[row] then
				messagebox("Absents Validation", "Please enter valid Absents", stopsign!)
				return 1
			else
				parent.parent.parent.wf_update_salary(dwo.name, data)
				return 0
			end if
		else
			messagebox("Absents Validation", "Please enter valid Absents", stopsign!)
			return 1
		end if
	case "leaves"
		if long(data) >= 0 then
			if long(data) > this.object.workdays[row] then
				messagebox("leaves Validation", "Please enter valid leaves", stopsign!)
				return 1
			else
				if this.object.paytype[row] = 1 then
					this.object.hoursworked[row] = (this.object.presents[row] + long(data)) * this.object.workinghours[row]
				end if
				parent.parent.parent.wf_update_salary(dwo.name, data)
				return 0
			end if
		else
			messagebox("leaves Validation", "Please enter valid leaves", stopsign!)
			return 1
		end if
	case "sundays"
		if long(data) >= 0 then
			if long(data) > this.object.workdays[row] then
				messagebox("Sundays Validation", "Please enter valid Sundays", stopsign!)
				return 1
			else
				parent.parent.parent.wf_update_salary(dwo.name, data)
				return 0
			end if
		else
			messagebox("Sundays Validation", "Please enter valid sundays", stopsign!)
			return 1
		end if
	case "holidays"
		if long(data) >= 0 then
			if long(data) > this.object.workdays[row] then
				messagebox("Holidays Validation", "Please enter valid holidays", stopsign!)
				return 1
			else
				parent.parent.parent.wf_update_salary(dwo.name, data)
				return 0
			end if
		else
			messagebox("Holidays Validation", "Please enter valid holidays", stopsign!)
			return 1
		end if
	case else
		parent.parent.parent.wf_update_salary(dwo.name, data)
		return 0
	end choose
	return ::message.returnvalue

