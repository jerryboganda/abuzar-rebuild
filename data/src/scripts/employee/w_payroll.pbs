// window w_payroll (employee)  ancestor: w_multi_entry

// w_payroll.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to 1 step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_payroll.wf_fetchserverdate(boolean ab_checked) returns long
	if ab_checked then
		this.ib_fetchserverdate = true
	else
		this.ib_fetchserverdate = false
	end if
	return 0

// w_payroll.wf_initmodify(integer ai_protect) returns 0
	long ll_code
	if this.id_master.getitemstring(1, "posted") = "N" then
		ll_code = this.id_master.getitemnumber(1, "code")
		if wf_lock_payroll(ll_code) = 0 and ai_protect = 0 then
			this.im_menu.m_file.m_save.enabled = true
			this.im_menu.m_file.m_new.enabled = false
			this.im_menu.m_file.m_delete.enabled = false
			this.im_menu.m_item.m_newitem.enabled = false
			this.im_menu.m_item.m_deleteitem.enabled = false
			this.im_menu.m_file.m_first.enabled = false
			this.im_menu.m_file.m_next.enabled = false
			this.im_menu.m_file.m_previous.enabled = false
			this.im_menu.m_file.m_last.enabled = false
			this.im_menu.m_file.m_retrieve.enabled = true
			this.im_menu.m_file.m_retrieve.text = "Lis&t"
			this.tab_retrieve.tabpage_detail.enabled = true
		end if
		return
	end if
	ai_protect = 1

// w_payroll.wf_post() returns boolean
	integer li_postingmode = 1
	long ll_sinvcode
	long ll_linvcode
	setnull(ll_sinvcode)
	setnull(ll_linvcode)
	return wf_post_payroll(li_postingmode, ll_sinvcode, ll_linvcode)

// w_payroll.wf_grandtotal() returns double
	if this.id_master.rowcount() > 0 then
		wf_update_salary("basicpay", trim(string(this.id_master.object.basicpay[this.id_master.rowcount()])))
	end if
	return 0

// w_payroll.wf_selectprintreport() returns string
	string ls_report
	if gs_company = "MMTRUSTHSP" then
		ls_report = "d_mmtrusthsp_payslip_print"
	else
		ls_report = "d_payslip_print"
	end if
	this.id_print.dataobject = ls_report
	this.id_print.settransobject(this.it_transobject)
	return ls_report

// w_payroll.wf_assigndatawindowobjects(string as_masterdw, string as_detaildw, string as_listdw, string as_footerdw, string as_footer2dw) returns 0
	this.id_master.dataobject = as_masterdw
	this.id_detail.dataobject = as_detaildw
	this.id_list.dataobject = as_listdw
	this.id_footer.dataobject = as_footerdw
	this.id_footer2.dataobject = as_footer2dw
	this.id_master.settransobject(this.it_transobject)
	this.id_detail.settransobject(this.it_transobject)
	this.id_list.settransobject(this.it_transobject)
	this.id_footer.settransobject(this.it_transobject)
	this.id_footer2.settransobject(this.it_transobject)

// w_payroll.wf_apply_rights() returns 0
	long ll_found
	ll_found = 0

// w_payroll.wf_find_empcode(string as_empid, long al_empcode) returns integer
	long ll_empcode
	long ll_retflag
	string ls_empname
	SQL SELECT EMPCode INTO :ll_empcode FROM Emp_Employee WHERE EMPID =:as_empid USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_empcode = ll_empcode
		if isnull(al_empcode) then
			ll_retflag = 0
		else
			ll_retflag = 1
		end if
	else
		ll_retflag = -1
	end if
	return ll_retflag

// w_payroll.wf_set_employee_image(long al_code) returns long
	long ll_rowid
	string ls_filename
	blob lb_image
	this.id_master.object.p_itemimage.filename = ""
	if al_code <= 0 or isnull(al_code) then
		return 0
	end if
	SQL SelectBlob Picture INTO :lb_image From Emp_Employee Where EmpCode =:al_code USING this.it_imagetrans;
	if this.it_imagetrans.sqlcode <> 0 then
		messagebox("Employee Image/Picture ", "Unable to fetch Employee Picture.~r~nReasons are:~r~n" + this.it_imagetrans.sqlerrtext)
		return -1
	end if
	ls_filename = gs_temp_img_filename
	f_writeimgtofile(ls_filename, lb_image)
	this.id_master.object.p_itemimage.filename = ls_filename
	return 0

// w_payroll.wf_employee_image_setting() returns long
	return 0

// w_payroll.wf_set_employee_name(string as_data) returns 0
	long ll_rowno
	ll_rowno = this.idc_employee.find("employeename >='" + as_data + "'", 1, this.idc_employee.rowcount())
	if ll_rowno > 0 then
		this.idc_employee.selectrow(0, false)
		this.idc_employee.setrow(ll_rowno)
		this.idc_employee.scrolltorow(ll_rowno)
		this.idc_employee.selectrow(ll_rowno, true)
	end if

// w_payroll.wf_lock_payroll(long al_code) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From EMP_Payroll WITH ( UPDLOCK HOLDLOCK ) Where PayrollCode =:al_code USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_payroll.wf_lock_payrollbatch(long al_scode, long al_lcode) returns integer
	integer li_count
	SQL Select count ( *) INTO :li_count From EMP_Payroll WITH ( UPDLOCK HOLDLOCK ) Where PayrollCode BETWEEN :al_scode AND :al_lcode USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_payroll.wf_isinvoiceinuse(long al_code) returns boolean
	long ll_found
	SQL Select count ( *) INTO :ll_found From EMP_Payroll Where PayrollCode =:al_code and Posted ='Y' USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_found = 0 or isnull(ll_found) then
			SQL Select count ( *) INTO :ll_found From EMP_Payroll With ( ReadPast , RowLock , UpdLock ) Where PayrollCode =:al_code USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 then
				if ll_found = 0 then
					return true
				else
					return false
				end if
			else
				return false
			end if
		else
			return false
		end if
		return
	end if
	return false

// w_payroll.wf_set_employee_allowances(long al_code) returns integer
	long ll_counter
	long ll_temp_rows
	long ll_insrow
	long ll_detailrows
	datastore lds_allowance
	lds_allowance = create datastore
	lds_allowance.dataobject = "d_emp_payallowances"
	lds_allowance.settransobject(sqlca)
	lds_allowance.retrieve(al_code)
	ll_temp_rows = lds_allowance.rowcount()
	if ll_temp_rows > 0 then
		ll_detailrows = this.id_detail.rowcount()
		for ll_counter = 1 to ll_detailrows
			this.id_detail.deleterow(0)
		next
		ll_counter = 0
		for ll_counter = 1 to ll_temp_rows
			if lds_allowance.object.percentage[ll_counter] > 0 or lds_allowance.object.flatamount[ll_counter] > 0 then
				ll_insrow = this.id_detail.insertrow(0)
				this.id_detail.object.allowancecode[ll_insrow] = lds_allowance.object.allowancecode[ll_counter]
				this.id_detail.object.basicpay[ll_insrow] = this.id_master.object.basicpay[1]
				this.id_detail.object.attendancewise[ll_insrow] = lds_allowance.object.attendancewise[ll_counter]
				this.id_detail.object.percentage[ll_insrow] = lds_allowance.object.percentage[ll_counter]
				this.id_detail.object.flatamount[ll_insrow] = lds_allowance.object.flatamount[ll_counter]
			end if
		next
	end if
	return 0

// w_payroll.wf_set_employee_deductions(long al_code) returns long
	long ll_counter
	long ll_temp_rows
	long ll_insrow
	long ll_detailrows
	datastore lds_deduction
	lds_deduction = create datastore
	lds_deduction.dataobject = "d_emp_paydeduction"
	lds_deduction.settransobject(sqlca)
	lds_deduction.retrieve(al_code)
	ll_temp_rows = lds_deduction.rowcount()
	if ll_temp_rows > 0 then
		ll_detailrows = this.id_footer.rowcount()
		for ll_counter = 1 to ll_detailrows
			this.id_footer.deleterow(0)
		next
		ll_counter = 0
		for ll_counter = 1 to ll_temp_rows
			if lds_deduction.object.percentage[ll_counter] > 0 or lds_deduction.object.flatamount[ll_counter] > 0 then
				ll_insrow = this.id_footer.insertrow(0)
				this.id_footer.object.deductioncode[ll_insrow] = lds_deduction.object.deductioncode[ll_counter]
				this.id_footer.object.basicpay[ll_insrow] = this.id_master.object.basicpay[1]
				this.id_footer.object.percentage[ll_insrow] = lds_deduction.object.percentage[ll_counter]
				this.id_footer.object.flatamount[ll_insrow] = lds_deduction.object.flatamount[ll_counter]
			end if
		next
	end if
	return 0

// w_payroll.wf_post_payroll(integer ai_postingmode, long al_scode, long al_lcode) returns boolean
	long ll_code1
	long ll_code2
	long ll_errcode
	long ll_salesmancode
	unsignedlong ul_rowcount
	datetime ldt_server_datetime
	string ls_date_errtext
	string ls_errtext
	boolean lb_commitflag
	s_arguements lstr_arginfo
	if ai_postingmode = 1 then
		open(w_salesmanpassword)
		ll_salesmancode = long(message.doubleparm)
		setfocus()
	else
		ll_salesmancode = gl_usercode
	end if
	if ll_salesmancode > 0 then
		if ai_postingmode = 1 then
			open(w_arg_sinvcode_linvcode)
			lstr_arginfo = message.powerobjectparm
		else
			lstr_arginfo.l_code1 = al_scode
			lstr_arginfo.l_code2 = al_lcode
			lstr_arginfo.i_status = 1
		end if
		if lstr_arginfo.i_status = 1 then
			if not wf_validateserverdatetime(ldt_server_datetime, ls_date_errtext) then
				messagebox("Date Violation", ls_date_errtext, stopsign!)
				return false
			end if
			setpointer(hourglass!)
			SQL rollback USING this.it_transobject;
			SQL SELECT COUNT ( *) INTO :ul_rowcount From Emp_Payroll Where PayrollCode Between :lstr_arginfo.l_code1 AND :lstr_arginfo.l_code2 AND Posted ='N' USING this.it_transobject;
			if this.it_transobject.sqlcode = 0 and ul_rowcount > 0 then
				ll_errcode = wf_lock_payrollbatch(lstr_arginfo.l_code1, lstr_arginfo.l_code2)
				if ll_errcode = 0 then
					this.it_transobject.postpayroll(lstr_arginfo.l_code1, lstr_arginfo.l_code2, ll_salesmancode)
					if this.it_transobject.sqlcode = 0 then
						SQL commit USING this.it_transobject;
						messagebox("Payroll Posting", "Posting Successfully done.", information!)
					else
						ls_errtext = this.it_transobject.sqlerrtext
						SQL rollback USING this.it_transobject;
						messagebox("Payroll Posting", "Posting Failed. Reasons Are:-~r~n" + ls_errtext, stopsign!)
					end if
				else
					messagebox("Payroll Posting", "Posting Failed because some othe user is using some of the payroll voucher specified in the range.", stopsign!)
				end if
			else
				messagebox("Payroll Posting", "No unposted payroll vouchers exist in specified range. Posting cannot be done", stopsign!)
				return false
			end if
			return
		end if
		return
	end if
	setpointer(arrow!)
	return lb_commitflag

// w_payroll.wf_update_salary(string as_col, string data) returns long
	long ll_retcode
	long ll_counter
	long row
	long p
	long ll_paytype
	if this.id_master.rowcount() > 0 then
		row = 1
	else
		return 0
	end if
	if row > 0 then
		ll_paytype = this.id_master.object.paytype[row]
	end if
	choose case as_col
	case "presents"
		if double(data) >= 0.0 then
			if ll_paytype = 1 then
				this.id_master.object.basicpay[row] = this.id_master.object.hoursworked[row] * this.id_master.object.perhourrate[row]
			else
				this.id_master.object.basicpay[row] = (double(data) + this.id_master.object.leaves[row] + this.id_master.object.sundays[row] + this.id_master.object.holidays[row]) * this.id_master.object.perhourrate[row]
			end if
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_footer.rowcount()
				this.id_footer.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			this.id_master.object.netpayable[row] = round(this.id_master.object.basicpay[row] + this.id_master.object.overtime[row] + this.id_master.object.bonuspay[row] + this.id_master.object.specialpay[row] + this.id_master.object.additionalpay[row] + this.id_master.object.otherpay[row] - this.id_master.object.fine[row] - this.id_master.object.penalty[row] - this.id_master.object.othercharge[row] - this.id_master.object.advance[row], 2)
			ll_retcode = 0
		else
			ll_retcode = 1
		end if
	case "absents"
		if double(data) >= 0.0 then
			if ll_paytype = 1 then
				this.id_master.object.basicpay[row] = this.id_master.object.hoursworked[row] * this.id_master.object.perhourrate[row]
			else
				this.id_master.object.basicpay[row] = (this.id_master.object.presents[row] + this.id_master.object.leaves[row] + this.id_master.object.sundays[row] + this.id_master.object.holidays[row]) * this.id_master.object.perhourrate[row]
			end if
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_footer.rowcount()
				this.id_footer.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			this.id_master.object.netpayable[row] = round(this.id_master.object.basicpay[row] + this.id_master.object.overtime[row] + this.id_master.object.bonuspay[row] + this.id_master.object.specialpay[row] + this.id_master.object.additionalpay[row] + this.id_master.object.otherpay[row] - this.id_master.object.fine[row] - this.id_master.object.penalty[row] - this.id_master.object.othercharge[row] - this.id_master.object.advance[row], 2)
			ll_retcode = 0
		else
			ll_retcode = 1
		end if
	case "leaves"
		if double(data) >= 0.0 then
			if ll_paytype = 1 then
				this.id_master.object.basicpay[row] = this.id_master.object.hoursworked[row] * this.id_master.object.perhourrate[row]
			else
				this.id_master.object.basicpay[row] = (this.id_master.object.presents[row] + double(data) + this.id_master.object.sundays[row] + this.id_master.object.holidays[row]) * this.id_master.object.perhourrate[row]
			end if
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_footer.rowcount()
				this.id_footer.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			this.id_master.object.netpayable[row] = round(this.id_master.object.basicpay[row] + this.id_master.object.overtime[row] + this.id_master.object.bonuspay[row] + this.id_master.object.specialpay[row] + this.id_master.object.additionalpay[row] + this.id_master.object.otherpay[row] - this.id_master.object.fine[row] - this.id_master.object.penalty[row] - this.id_master.object.othercharge[row] - this.id_master.object.advance[row], 2)
			ll_retcode = 0
		else
			ll_retcode = 1
		end if
	case "sundays"
		if double(data) >= 0.0 then
			if ll_paytype = 1 then
				this.id_master.object.basicpay[row] = this.id_master.object.hoursworked[row] * this.id_master.object.perhourrate[row]
			else
				this.id_master.object.basicpay[row] = (this.id_master.object.presents[row] + this.id_master.object.leaves[row] + double(data) + this.id_master.object.holidays[row]) * this.id_master.object.perhourrate[row]
			end if
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_footer.rowcount()
				this.id_footer.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			this.id_master.object.netpayable[row] = round(this.id_master.object.basicpay[row] + this.id_master.object.overtime[row] + this.id_master.object.bonuspay[row] + this.id_master.object.specialpay[row] + this.id_master.object.additionalpay[row] + this.id_master.object.otherpay[row] - this.id_master.object.fine[row] - this.id_master.object.penalty[row] - this.id_master.object.othercharge[row] - this.id_master.object.advance[row], 2)
			ll_retcode = 0
		else
			ll_retcode = 1
		end if
	case "holidays"
		if double(data) >= 0.0 then
			if ll_paytype = 1 then
				this.id_master.object.basicpay[row] = this.id_master.object.hoursworked[row] * this.id_master.object.perhourrate[row]
			else
				this.id_master.object.basicpay[row] = (this.id_master.object.presents[row] + this.id_master.object.leaves[row] + this.id_master.object.sundays[row] + double(data)) * this.id_master.object.perhourrate[row]
			end if
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_footer.rowcount()
				this.id_footer.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			this.id_master.object.netpayable[row] = round(this.id_master.object.basicpay[row] + this.id_master.object.overtime[row] + this.id_master.object.bonuspay[row] + this.id_master.object.specialpay[row] + this.id_master.object.additionalpay[row] + this.id_master.object.otherpay[row] - this.id_master.object.fine[row] - this.id_master.object.penalty[row] - this.id_master.object.othercharge[row] - this.id_master.object.advance[row], 2)
			ll_retcode = 0
		else
			ll_retcode = 1
		end if
	case "overtimehours"
		if double(data) >= 0.0 then
			this.id_master.object.overtime[row] = double(data) * this.id_master.object.overtimerate[row]
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_footer.rowcount()
				this.id_footer.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			this.id_master.object.netpayable[row] = round(this.id_master.object.basicpay[row] + this.id_master.object.overtime[row] + this.id_master.object.bonuspay[row] + this.id_master.object.specialpay[row] + this.id_master.object.additionalpay[row] + this.id_master.object.otherpay[row] - this.id_master.object.fine[row] - this.id_master.object.penalty[row] - this.id_master.object.othercharge[row] - this.id_master.object.advance[row], 2)
			ll_retcode = 0
		else
			ll_retcode = 1
		end if
	case "overtime"
		if double(data) >= 0.0 then
			if this.id_master.object.overtimerate[row] <> 0 then
				this.id_master.object.overtimehours[row] = round(double(data) / this.id_master.object.overtimerate[row], 2)
			end if
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_footer.rowcount()
				this.id_footer.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			this.id_master.object.netpayable[row] = round(this.id_master.object.basicpay[row] + double(data) + this.id_master.object.bonuspay[row] + this.id_master.object.specialpay[row] + this.id_master.object.additionalpay[row] + this.id_master.object.otherpay[row] - this.id_master.object.fine[row] - this.id_master.object.penalty[row] - this.id_master.object.othercharge[row] - this.id_master.object.advance[row], 2)
			ll_retcode = 0
		else
			ll_retcode = 1
		end if
	case "basicpay"
		if double(data) >= 0.0 then
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.object.basicpay[ll_counter] = double(data)
			next
			for ll_counter = 1 to this.id_footer.rowcount()
				this.id_footer.object.basicpay[ll_counter] = double(data)
			next
			this.id_master.object.netpayable[row] = round(double(data) + this.id_master.object.overtime[row] + this.id_master.object.bonuspay[row] + this.id_master.object.specialpay[row] + this.id_master.object.additionalpay[row] + this.id_master.object.otherpay[row] - this.id_master.object.fine[row] - this.id_master.object.penalty[row] - this.id_master.object.othercharge[row] - this.id_master.object.advance[row], 2)
			ll_retcode = 0
		else
			ll_retcode = 1
		end if
	case "bonuspay"
		if double(data) >= 0.0 then
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_footer.rowcount()
				this.id_footer.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			this.id_master.object.netpayable[row] = round(this.id_master.object.basicpay[row] + this.id_master.object.overtime[row] + double(data) + this.id_master.object.specialpay[row] + this.id_master.object.additionalpay[row] + this.id_master.object.otherpay[row] - this.id_master.object.fine[row] - this.id_master.object.penalty[row] - this.id_master.object.othercharge[row] - this.id_master.object.advance[row], 2)
			ll_retcode = 0
		else
			ll_retcode = 1
		end if
	case "specialpay"
		if double(data) >= 0.0 then
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_footer.rowcount()
				this.id_footer.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			this.id_master.object.netpayable[row] = round(this.id_master.object.basicpay[row] + this.id_master.object.overtime[row] + this.id_master.object.bonuspay[row] + double(data) + this.id_master.object.additionalpay[row] + this.id_master.object.otherpay[row] - this.id_master.object.fine[row] - this.id_master.object.penalty[row] - this.id_master.object.othercharge[row] - this.id_master.object.advance[row], 2)
			ll_retcode = 0
		else
			ll_retcode = 1
		end if
	case "additionalpay"
		if double(data) >= 0.0 then
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_footer.rowcount()
				this.id_footer.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			this.id_master.object.netpayable[row] = round(this.id_master.object.basicpay[row] + this.id_master.object.overtime[row] + this.id_master.object.bonuspay[row] + this.id_master.object.specialpay[row] + double(data) + this.id_master.object.otherpay[row] - this.id_master.object.fine[row] - this.id_master.object.penalty[row] - this.id_master.object.othercharge[row] - this.id_master.object.advance[row], 2)
			ll_retcode = 0
		else
			ll_retcode = 1
		end if
	case "otherpay"
		if double(data) >= 0.0 then
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_footer.rowcount()
				this.id_footer.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			this.id_master.object.netpayable[row] = round(this.id_master.object.basicpay[row] + this.id_master.object.overtime[row] + this.id_master.object.bonuspay[row] + this.id_master.object.specialpay[row] + this.id_master.object.additionalpay[row] + double(data) - this.id_master.object.fine[row] - this.id_master.object.penalty[row] - this.id_master.object.othercharge[row] - this.id_master.object.advance[row], 2)
			ll_retcode = 0
		else
			ll_retcode = 1
		end if
	case "fine"
		if double(data) >= 0.0 then
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_footer.rowcount()
				this.id_footer.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			this.id_master.object.netpayable[row] = round(this.id_master.object.basicpay[row] + this.id_master.object.overtime[row] + this.id_master.object.bonuspay[row] + this.id_master.object.specialpay[row] + this.id_master.object.additionalpay[row] + this.id_master.object.otherpay[row] - double(data) - this.id_master.object.penalty[row] - this.id_master.object.othercharge[row] - this.id_master.object.advance[row], 2)
			ll_retcode = 0
		else
			ll_retcode = 1
		end if
	case "penalty"
		if double(data) >= 0.0 then
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_footer.rowcount()
				this.id_footer.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			this.id_master.object.netpayable[row] = round(this.id_master.object.basicpay[row] + this.id_master.object.overtime[row] + this.id_master.object.bonuspay[row] + this.id_master.object.specialpay[row] + this.id_master.object.additionalpay[row] + this.id_master.object.otherpay[row] - this.id_master.object.fine[row] - double(data) - this.id_master.object.othercharge[row] - this.id_master.object.advance[row], 2)
			ll_retcode = 0
		else
			ll_retcode = 1
		end if
	case "othercharge"
		if double(data) >= 0.0 then
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_footer.rowcount()
				this.id_footer.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			this.id_master.object.netpayable[row] = round(this.id_master.object.basicpay[row] + this.id_master.object.overtime[row] + this.id_master.object.bonuspay[row] + this.id_master.object.specialpay[row] + this.id_master.object.additionalpay[row] + this.id_master.object.otherpay[row] - this.id_master.object.fine[row] - this.id_master.object.penalty[row] - double(data) - this.id_master.object.advance[row], 2)
			ll_retcode = 0
		else
			ll_retcode = 1
		end if
	case "advance"
		if double(data) >= 0.0 then
			for ll_counter = 1 to this.id_detail.rowcount()
				this.id_detail.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_footer.rowcount()
				this.id_footer.object.basicpay[ll_counter] = this.id_master.object.basicpay[row]
			next
			this.id_master.object.netpayable[row] = round(this.id_master.object.basicpay[row] + this.id_master.object.overtime[row] + this.id_master.object.bonuspay[row] + this.id_master.object.specialpay[row] + this.id_master.object.additionalpay[row] + this.id_master.object.otherpay[row] - this.id_master.object.fine[row] - this.id_master.object.penalty[row] - this.id_master.object.othercharge[row] - double(data), 2)
			ll_retcode = 0
		else
			ll_retcode = 1
		end if
	case else
		this.id_master.accepttext()
		this.id_footer.accepttext()
		this.id_detail.accepttext()
	end choose
	if this.id_detail.rowcount() > 0 then
		this.id_master.object.netpayable[row] = this.id_master.object.netpayable[row] + this.id_detail.getitemnumber(1, "c_tot_allowances")
	end if
	if this.id_footer.rowcount() > 0 then
		this.id_master.object.netpayable[row] = this.id_master.object.netpayable[row] - this.id_footer.getitemnumber(1, "c_tot_deductions")
	end if
	this.id_master.object.netpayable[row] = round(this.id_master.object.netpayable[row], 0)
	this.id_footer2.object.netpayable[1] = this.id_master.object.netpayable[1]
	return ll_retcode

// w_payroll.wf_set_employee_advance(long al_code) returns long
	long ll_retcode
	double ld_amt
	double ld_returned
	double ld_balance
	double ld_installment
	double ld_adv_acc_balance
	SQL SELECT Amount =SUM ( Amount ) , ReturnedAmt =SUM ( ReturnedAmt ) , Balance =SUM ( Amount ) - SUM ( ReturnedAmt ) , Installment =SUM ( Installment ) , Adv_Acc_Balance =ISNULL ( ( SELECT Balance =SUM ( V.Debit - V.Credit ) FROM VirtualGL V WHERE AccCode =:al_code ) , 0 ) INTO :ld_amt, :ld_returned, :ld_balance, :ld_installment, :ld_adv_acc_balance FROM DBO.EMP_Advance WHERE EmpAdvAccCode =:al_code AND Amount - ReturnedAmt > 0 USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		ll_retcode = 0
		if ld_adv_acc_balance <> ld_balance then
			if ld_adv_acc_balance >= ld_installment then
				this.id_master.object.advance[1] = ld_installment
			else
				this.id_master.object.advance[1] = ld_adv_acc_balance
			end if
		elseif ld_balance >= ld_installment then
			this.id_master.object.advance[1] = ld_installment
		else
			this.id_master.object.advance[1] = ld_balance
		end if
	else
		ll_retcode = this.it_transobject.sqlcode
	end if
	return ll_retcode

// w_payroll.wf_set_employee_info(long al_code) returns long
	long ll_adv_acc
	long ll_empcode
	long ll_paytype
	string ls_empid
	string ls_empname
	char lc_overtime
	double ld_perhrrate
	double ld_bp
	double ld_otrate
	double ld_workinghours
	ld_perhrrate = 0
	SQL SELECT E.EmpCode , E.EMPID , EmployeeName =E.FullName + ' (' + E.EmpID + ')' , P.PerHourRate , P.BasicPay , P.OverTime , P.OverTimeRate , P.Workinghours , E.AdvAccCode , P.PayType INTO :ll_empcode, :ls_empid, :ls_empname, :ld_perhrrate, :ld_bp, :lc_overtime, :ld_otrate, :ld_workinghours, :ll_adv_acc, :ll_paytype FROM Emp_Employee E , Emp_Pay P WHERE E.EmpCode =:al_code AND E.EmpCode =P.EmpCode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.object.empid[1] = ls_empid
		this.id_master.object.paytype[1] = ll_paytype
		this.id_master.object.workinghours[1] = ld_workinghours
		this.id_master.object.perhourrate[1] = ld_perhrrate
		this.id_master.object.basicpay[1] = ld_bp
		this.id_master.object.overtimerate[1] = ld_otrate
		wf_set_employee_image(al_code)
		wf_set_employee_allowances(al_code)
		wf_set_employee_deductions(al_code)
		if ll_adv_acc > 0 then
			wf_set_employee_advance(ll_adv_acc)
			this.id_master.object.advance.protect = "0"
		else
			this.id_master.object.advance.protect = "1"
		end if
		wf_grandtotal()
		return 0
	end if
	return -1

// w_payroll.wf_payroll_payment() returns 0
	boolean lb_listtab
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab then
		open(w_emp_payroll_payment)
	end if

// w_payroll.wf_fetch_attendance() returns long
	boolean lb_listtab
	long ll_empcode
	long ll_sundays
	long ll_holidays
	datetime ldt_startdate
	datetime ldt_enddate
	datastore lds_emp_attendance
	lds_emp_attendance = create datastore
	lds_emp_attendance.dataobject = "d_emp_attendance_record"
	lds_emp_attendance.settransobject(sqlca)
	if wf_iseditable() = false then
		return 0
	end if
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab = false and this.id_master.rowcount() > 0 and this.id_master.object.posted[1] = "N" then
		this.id_master.accepttext()
		ll_empcode = this.id_master.object.empcode[1]
		ldt_startdate = this.id_master.object.fromdate[1]
		ldt_enddate = this.id_master.object.todate[1]
		lds_emp_attendance.retrieve(ll_empcode, ldt_startdate, ldt_enddate)
		if lds_emp_attendance.rowcount() > 0 then
			this.id_master.object.presents[1] = lds_emp_attendance.object.presents[1]
			this.id_master.object.absents[1] = lds_emp_attendance.object.absents[1]
			this.id_master.object.leaves[1] = lds_emp_attendance.object.leaves[1]
			this.id_master.object.sundays[1] = lds_emp_attendance.object.sundays[1]
			this.id_master.object.holidays[1] = lds_emp_attendance.object.holidays[1]
			this.id_master.object.hoursworked[1] = lds_emp_attendance.object.hoursworked[1]
			this.id_master.accepttext()
			wf_update_salary("presents", trim(string(this.id_master.object.presents[1])))
		end if
	end if
	return 0

// w_payroll.wf_generate_payroll() returns long
	long ll_counter
	long ll_type = 1
	long ll_payslipsgenerated
	string ls_category
	string ls_dept
	string ls_errtext = "                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        0"
	s_arguements lstr_arg
	boolean lb_listtab
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if lb_listtab then
		open(w_select_emp_payrolltype)
		ll_type = message.doubleparm
		if ll_type = 1 or ll_type = 2 then
			open(w_arg_emp_category_dept_period)
			lstr_arg = message.powerobjectparm
			if lstr_arg.i_status = 1 then
				SQL rollback USING this.it_transobject;
				this.it_transobject.generatepayroll(ll_type, lstr_arg.s_name1, lstr_arg.s_name2, lstr_arg.d_sdate, lstr_arg.d_edate, gl_usercode, ll_payslipsgenerated)
				if this.it_transobject.sqlcode = 0 then
					messagebox("Payroll Generation", trim(string(ll_payslipsgenerated)) + " Payroll Slips Generated Successfully", information!)
					SQL commit USING this.it_transobject;
				else
					ls_errtext = this.it_transobject.sqlerrtext
					SQL rollback USING this.it_transobject;
					messagebox("Payroll Generation", "Error Generating Payroll Slips.~r~nDetails are:-~r~n" + ls_errtext, stopsign!)
				end if
			end if
		end if
	end if
	return 0

