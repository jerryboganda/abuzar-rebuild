// dw_detail.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	integer li_movement
	long ll_row
	long ll_temp
	long ll_code
	long ll_foundcode
	string sl_columnname
	string ls_filterexp
	s_popup_selection lstr_selection
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf8! and getcolumnname() = "empcode" then
		parent.parent.parent.is_comprehensive_search_dataobject = "ddd_employees"
		ll_foundcode = parent.parent.parent.wf_comprehensive_search()
		if ll_foundcode >= 0 then
			this.object.empcode[1] = ll_foundcode
			if parent.parent.parent.wf_set_employee_info(ll_foundcode) = 0 then
				parent.parent.parent.wf_update_salary("empcode", string(ll_foundcode))
			end if
		end if
	end if
	return ::message.returnvalue

