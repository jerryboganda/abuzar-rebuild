// window w_emp_advance (employee)  ancestor: w_multi_entry

// w_emp_advance.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns 0
	integer li_colcount
	integer li_counter
	integer li_start
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next

// w_emp_advance.wf_create_vouchers() returns long
	long ll_empadvaccode
	long ll_retcode
	long ll_usercode
	long ll_null
	long ll_acccode
	long ll_glcode1
	long ll_vochcode1
	double ld_amt
	double ld_null
	double ld_installment
	datetime ldt_date
	datetime ldt_null
	string ls_msg
	string as_errortext
	string ls_null
	string ls_remarks
	string ls_refno
	ls_msg = "000                                                                                                                                 "
	setnull(ll_null)
	setnull(ld_null)
	setnull(ls_null)
	setnull(ldt_null)
	ll_empadvaccode = this.id_master.object.empadvacccode[1]
	ll_acccode = this.id_master.object.acccode[1]
	ld_amt = this.id_master.object.amount[1]
	ld_installment = this.id_master.object.installment[1]
	ldt_date = this.id_master.object.date[1]
	ll_usercode = this.id_master.object.usercode[1]
	ls_remarks = this.id_master.object.remarks[1]
	ls_refno = this.id_master.object.refno[1]
	if ll_empadvaccode > 0 and ld_amt > 0.0 and ll_acccode > 0 and ld_installment > 0.0 then
		this.it_transobject.createvoucher(5, 2, ldt_date, ll_usercode, "Y", ldt_date, ls_remarks, ldt_date, ll_null, ll_null, ls_refno, ll_empadvaccode, ll_acccode, ld_amt, ls_refno, ls_remarks, ll_null, ll_null, ll_null, ll_null, 0.00, 0.00, ll_glcode1, ll_vochcode1, ll_null)
		if this.it_transobject.sqlcode <> 0 then
			as_errortext = "Employee Advance Voucher Creation Error:~r~n" + this.it_transobject.sqlerrtext
			messagebox("1 Error", as_errortext, stopsign!)
			ll_retcode = -1
		else
			this.id_master.object.glvochcode[1] = ll_glcode1
		end if
	end if
	return ll_retcode

// w_emp_advance.wf_set_employee_info(long al_code) returns long
	long ll_empcode
	long ll_empcatcode
	long ll_deptcode
	long ll_desigcode
	string ls_empid
	string ls_empname
	SQL SELECT E.EmpCode , E.EMPID , EmployeeName =E.FullName + ' (' + E.EmpID + ')' , E.EmpCatCode , E.DeptCode , E.DesigCode INTO :ll_empcode, :ls_empid, :ls_empname, :ll_empcatcode, :ll_deptcode, :ll_desigcode FROM Emp_Employee E WHERE E.AdvAccCode =:al_code USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.id_master.object.empcode[1] = ll_empcode
		this.id_master.object.empid[1] = ls_empid
		this.id_master.object.empcatcode[1] = ll_empcatcode
		this.id_master.object.deptcode[1] = ll_deptcode
		this.id_master.object.desigcode[1] = ll_desigcode
		return 0
	end if
	return -1

// w_emp_advance.create() returns 0 [event]
	integer icurrent
	call super::create
	this.dw_print = create dw_print
	icurrent = upperbound(this.control)
	this.control[icurrent + 1] = this.dw_print

// w_emp_advance.destroy() returns 0 [event]
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_print

// w_emp_advance.ue_save() returns 0 [event]
	long ll_mastercurrrow
	long ll_invid
	long ll_null
	long ll_usercode
	long ll_unpostedtrans
	integer ll_salesmancode
	boolean lb_commitflag
	string ls_itemname
	string ls_msg
	setnull(ll_null)
	ll_mastercurrrow = this.id_master.getrow()
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	setpointer(hourglass!)
	open(w_salesmanpassword)
	ll_usercode = long(message.doubleparm)
	setfocus()
	setpointer(hourglass!)
	if ll_usercode > 0 and ll_mastercurrrow > 0 then
		ll_invid = this.id_master.object.code[ll_mastercurrrow]
		if isnull(ll_invid) then
			wf_tabnewid("EMP_Advance", ll_invid)
			this.id_master.object.code[ll_mastercurrrow] = ll_invid
		end if
		this.id_master.object.usercode[ll_mastercurrrow] = ll_usercode
		if wf_create_vouchers() = 0 then
			if this.id_master.update(true, false) = 1 then
				SQL commit USING this.it_transobject;
				messagebox("Employee Advances", "Changes Take Effect in database")
				this.id_master.resetupdate()
				this.ib_commitok = true
				this.editflag = false
			else
				SQL rollback USING this.it_transobject;
				messagebox("1-Employee Advances", "Changes do not Take Effect in database", stopsign!)
			end if
		else
			SQL rollback USING this.it_transobject;
			messagebox("2-Employee Advances", "Changes do not Take Effect in database", stopsign!)
		end if
		ll_invid = ll_null
		this.id_master.object.code[ll_mastercurrrow] = ll_null
	end if
	setpointer(arrow!)

// w_emp_advance.ue_newform() returns 0 [event]
	call super::ue_newform
	this.id_master.setfocus()
	this.idc_emp_advance_acc.reset()
	this.idc_emp_advance_acc.retrieve()
	this.idc_cashbankacc.retrieve()
	wf_protectdw(this.id_master, 0)

// w_emp_advance.ue_detail() returns 0 [event]
	long li_protect
	call super::ue_detail
	this.im_menu.m_file.m_save.enabled = false
	this.im_menu.m_file.m_delete.enabled = false
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_print.visible = true
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_item.m_newitem.enabled = false
	this.im_menu.m_item.m_deleteitem.enabled = false
	if this.id_list.getrow() > 0 then
		if this.id_list.object.code[this.id_list.getrow()] > 0 then
			li_protect = 1
		else
			li_protect = 0
		end if
	end if
	wf_protectdw(this.id_master, li_protect)

// w_emp_advance.ue_deleteitem() returns 0 [event]

// w_emp_advance.ue_newitem() returns 0 [event]

// w_emp_advance.ue_postopen() returns 0 [event]
	integer ll_rtcode
	call super::ue_postopen
	this.il_subcode[1] = 2
	this.il_subcode[2] = 4
	ll_rtcode = this.id_master.getchild("EmpAdvAccCode", this.idc_emp_advance_acc)
	this.idc_emp_advance_acc.settransobject(this.it_transobject)
	this.idc_emp_advance_acc.insertrow(0)
	ll_rtcode = this.id_master.getchild("AccCode", this.idc_cashbankacc)
	this.idc_cashbankacc.settransobject(this.it_transobject)
	this.idc_cashbankacc.insertrow(0)
	this.id_print = this.dw_print

// w_emp_advance.ue_print() returns 0 [event]
	long ll_row
	long ll_invcode
	long ll_option
	boolean lb_listtab
	s_datastore lstr
	call super::ue_print
	if this.tab_retrieve.selectedtab = 2 then
		lb_listtab = true
	end if
	if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
		triggerevent("ue_save")
		if wf_commitform() = false then
			return
		end if
		return
	end if
	if lb_listtab then
		if isnull(this.id_list.getrow()) or this.id_list.getrow() <= 0 then
			messagebox("Rows Validation", "Kindly select any row from the list view.")
			return
		end if
		ll_invcode = this.id_list.getitemnumber(this.id_list.getrow(), "code")
		if isnull(ll_invcode) or ll_invcode <= 0 then
			messagebox("Selection Validation", "Kindly select any row from the list view.")
			return
		end if
	else
		ll_invcode = this.id_master.getitemnumber(1, "code")
	end if
	this.id_print.dataobject = "d_emp_advance_print"
	this.id_print.settransobject(this.it_transobject)
	this.id_print.retrieve(ll_invcode)
	if lb_listtab then
		lstr.dw = this.id_print
		lstr.s_name1 = this.id_print.dataobject
		openwithparm(w_preview_invoices, lstr)
		lstr = message.powerobjectparm
		if lstr.i_closemode = -1 then
			return
		end if
		return
	end if
	if f_stringpreferences("saleaskforcopies") = "Y" then
		open(w_printer_copies)
		this.id_print.object.datawindow.print.copies = string(message.doubleparm)
	end if
	if f_stringpreferences("PromptBeforePrinting") = "Y" and printsetup() < 0 then
		messagebox("Printer", "Printing Error")
		this.id_print.printcancel()
	end if
	if this.id_print.rowcount() > 0 then
		this.id_print.print()
		if this.im_menu.m_file.m_save.enabled = true and lb_listtab = false then
			postevent("ue_new")
		end if
		return
	end if
	messagebox("Printing Error", "Can not Print Invoice,~r~nNo rows are retrieved", information!)

// w_emp_advance.ue_list() returns 0 [event]
	call super::ue_list
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_print.visible = true

// dw_detail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "empadvacccode"
		parent.parent.parent.wf_set_employee_info(long(data))
		return ll_retcode
	end choose
	return ll_retcode

// dw_itemsdetail.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	integer li_errcode
	string ls_managername
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "limit"
		parent.parent.parent.il_currrow = row
		parent.parent.parent.ib_itemvalidated = false
		if real(data) < 0.0 then
			li_errcode = 1
		else
			li_errcode = 0
		end if
	end choose
	return li_errcode

// dw_itemsdetail.itemerror(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemerror(row, dwo, data)
	choose case dwo.name
	case "limit"
		if data = "" or isnull(data) or real(data) < 0.0 then
			messagebox("Limit Validation", "Valid Value required for limit in current row")
		end if
	end choose
	return 1

// dw_itemsdetail.getfocus() returns long [event]
	return ::message.returnvalue

// dw_itemsdetail.itemfocuschanged(long row, dwobject dwo) returns long [event]
	return ::message.returnvalue
