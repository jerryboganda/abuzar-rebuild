					parent.p_lm.picturename = parent.is_lm
					if parent.li_iteration = parent.li_maxiteration then
						this.object.__invoke_method("gettemplate", 0, {}, true)
						parent.il_lm = 1
					end if
					parent.p_lm.setredraw(true)
				else
					parent.li_iteration = 0
					parent.p_lr.setfocus()
					parent.p_lr.triggerevent(clicked!)
				end if
			case "p_lr"
				parent.li_iteration = parent.li_iteration + 1
				if parent.li_iteration <= parent.li_maxiteration then
					if fileexists(parent.is_lr) then
						filedelete(parent.is_lr)
					end if
					parent.p_lr.setredraw(false)
					parent.iblb_lr = rawimage
					if filecopy(parent.is_tmp, parent.is_lr, true) = 1 then
						filedelete(parent.is_tmp)
					end if
					parent.p_lr.picturename = parent.is_lr
					if parent.li_iteration = parent.li_maxiteration then
						this.object.__invoke_method("gettemplate", 0, {}, true)
						parent.il_lr = 1
					end if
					parent.p_lr.setredraw(true)
				else
					parent.li_iteration = 0
					parent.p_lb.setfocus()
					parent.p_lb.triggerevent(clicked!)
				end if
			case "p_lb"
				parent.li_iteration = parent.li_iteration + 1
				if parent.li_iteration <= parent.li_maxiteration then
					if fileexists(parent.is_lb) then
						filedelete(parent.is_lb)
					end if
					parent.p_lb.setredraw(false)
					parent.iblb_lb = rawimage
					if filecopy(parent.is_tmp, parent.is_lb, true) = 1 then
						filedelete(parent.is_tmp)
					end if
					parent.p_lb.picturename = parent.is_lb
					if parent.li_iteration = parent.li_maxiteration then
						this.object.__invoke_method("gettemplate", 0, {}, true)
						parent.il_lb = 1
					end if
					parent.p_lb.setredraw(true)
				else
					parent.li_iteration = 0
					parent.cb_ok.setfocus()
				end if
			end choose
		else
			messagebox("Feature Template Error", "Not a good quality feature extraction is possible from this fingerprint~r~nKindly Scan this fingure again~r~nQuality = " + string(ll_quality) + "%~r~nMin. Desired Quality = 60%", stopsign!)
