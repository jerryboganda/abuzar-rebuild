// w_emp_employee_fingerprint_enrollment_old.open() returns long
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_err
	this.is_tmp = gs_temp_directory + "\temp.bmp"
	filedelete(this.is_tmp)
	this.is_rt = gs_temp_directory + "\rt.bmp"
	filedelete(this.is_rt)
	this.is_ri = gs_temp_directory + "\ri.bmp"
	filedelete(this.is_ri)
	this.is_rm = gs_temp_directory + "\rm.bmp"
	filedelete(this.is_rm)
	this.is_rr = gs_temp_directory + "\rr.bmp"
	filedelete(this.is_rr)
	this.is_rb = gs_temp_directory + "\rb.bmp"
	filedelete(this.is_rb)
	this.is_lt = gs_temp_directory + "\lt.bmp"
	filedelete(this.is_lt)
	this.is_li = gs_temp_directory + "\li.bmp"
	filedelete(this.is_li)
	this.is_lm = gs_temp_directory + "\lm.bmp"
	filedelete(this.is_lm)
	this.is_lr = gs_temp_directory + "\lr.bmp"
	filedelete(this.is_lr)
	this.is_lb = gs_temp_directory + "\lb.bmp"
	filedelete(this.is_lb)
	this.il_code = message.doubleparm
	this.it_transobject = create u_transaction
	this.it_transobject.autocommit = true
	SQL start USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Connection Problem", "Unable to connect to database.RNDetails are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	this.dw_control.settransobject(this.it_transobject)
	if this.il_code > 0 then
		this.dw_control.retrieve(this.il_code)
	end if
	this.p_rt.setfocus()
	this.p_rt.triggerevent(clicked!)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// ole_zktfp.onfeatureinfo(long aquality) returns 0
	long ll_ret
	long ll_quality
	blob lb_img
	string ls_ver
	runtimeerror ex
	try
		ls_ver = this.object.fpengineversion
		ll_quality = long(string(this.object.lastquality))
		if ll_quality >= 60 then
			lb_img = blob(string(this.object.__invoke_method("gettemplateex", 1, {ls_ver}, true)))
			choose case parent.is_curr_fingure
			case "p_rt"
				parent.iblb_ri_f = lb_img
			case "p_ri"
				parent.iblb_ri_f = lb_img
			case "p_rm"
				parent.iblb_rm_f = lb_img
			case "p_rr"
				parent.iblb_rr_f = lb_img
			case "p_rb"
				parent.iblb_rb_f = lb_img
			case "p_lt"
				parent.iblb_lt_f = lb_img
			case "p_li"
				parent.iblb_li_f = lb_img
			case "p_lm"
				parent.iblb_lm_f = lb_img
			case "p_lr"
				parent.iblb_lr_f = lb_img
			case "p_lb"
				parent.iblb_lb_f = lb_img
			end choose
		else
			messagebox("Feature Template Error", "Not a good quality feature extraction is possible from this fingerprint~r~nKindly Scan this fingure again~r~nQuality = " + string(ll_quality) + "%~r~nMin. Desired Quality = 60%", stopsign!)
		end if
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try

// ole_zktfp.onimagereceived(boolean aimagevalid) returns 0
	long ll_ret
	long ll_quality
	blob rawimage
	string ls_ver
	runtimeerror ex
	try
		filedelete(parent.is_tmp)
		ls_ver = this.object.fpengineversion
		ll_quality = long(string(this.object.lastquality))
		if ll_quality >= 60 then
			this.object.__invoke_method("savebitmap", 1, {parent.is_tmp}, true)
			this.object.__invoke_method("getfingerimage", 1, {rawimage}, true)
			choose case parent.is_curr_fingure
			case "p_rt"
				parent.li_iteration = parent.li_iteration + 1
				if parent.li_iteration <= parent.li_maxiteration then
					if fileexists(parent.is_rt) then
						filedelete(parent.is_rt)
					end if
					parent.p_rt.setredraw(false)
					parent.iblb_rt = rawimage
					if filecopy(parent.is_tmp, parent.is_rt, true) = 1 then
						filedelete(parent.is_tmp)
					end if
					parent.p_rt.picturename = parent.is_rt
					if parent.li_iteration = parent.li_maxiteration then
						this.object.__invoke_method("gettemplate", 0, {}, true)
						parent.il_rt = 1
					end if
					parent.p_rt.setredraw(true)
				else
					parent.li_iteration = 0
					parent.p_ri.setfocus()
					parent.p_ri.triggerevent(clicked!)
				end if
			case "p_ri"
				parent.li_iteration = parent.li_iteration + 1
				if parent.li_iteration <= parent.li_maxiteration then
					if fileexists(parent.is_ri) then
						filedelete(parent.is_ri)
					end if
					parent.p_ri.setredraw(false)
					parent.iblb_ri = rawimage
					if filecopy(parent.is_tmp, parent.is_ri, true) = 1 then
						filedelete(parent.is_tmp)
					end if
					parent.p_ri.picturename = parent.is_ri
					if parent.li_iteration = parent.li_maxiteration then
						this.object.__invoke_method("gettemplate", 0, {}, true)
						parent.il_ri = 1
					end if
					parent.p_ri.setredraw(true)
				else
					parent.li_iteration = 0
					parent.p_rm.setfocus()
					parent.p_rm.triggerevent(clicked!)
				end if
			case "p_rm"
				parent.li_iteration = parent.li_iteration + 1
				if parent.li_iteration <= parent.li_maxiteration then
					if fileexists(parent.is_rm) then
						filedelete(parent.is_rm)
					end if
					parent.p_rm.setredraw(false)
					parent.iblb_rm = rawimage
					if filecopy(parent.is_tmp, parent.is_rm, true) = 1 then
						filedelete(parent.is_tmp)
