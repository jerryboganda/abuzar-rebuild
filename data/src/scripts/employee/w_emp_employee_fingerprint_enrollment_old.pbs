// ole_grfinger.sensorplug(string idsensor) returns 0
	this.object.__invoke_method("capstartcapture", 1, {idsensor}, true)

// ole_grfinger.sensorunplug(string idsensor) returns 0
	this.object.__invoke_method("capstopcapture", 1, {idsensor}, true)

// ole_grfinger.imageacquired(string idsensor, long ocx_width, long ocx_height, any rawimage, long res) returns 0
	long ll_ret
	long ll_format
	long ll_quality
	long ll_matchcontext
	long ll_counter
	long ll_size
	blob lb_img
	lb_img = blob(space(10000))
	if fileexists(parent.is_tmp) then
		filedelete(parent.is_tmp)
	end if
	ll_ret = this.object.__invoke_method("capsaverawimagetofile", 5, {rawimage, ocx_width, ocx_height, parent.is_tmp, 501}, true)
	if ll_ret = 0 then
		ll_quality = this.object.__invoke_method("extract", 7, {rawimage, ocx_width, ocx_height, res, lb_img, ll_size, parent.il_grcontextid}, true)
		if ll_quality > 0 then
			if ll_size <= 0 or isnull(ll_size) then
				messagebox("Extraction Failed", "Extraction Failed")
			else
				choose case parent.is_curr_fingure
				case "p_rt"
					parent.iblb_rt = rawimage
					parent.iblb_rt_f = lb_img
					if fileexists(parent.is_rt) then
						filedelete(parent.is_rt)
					end if
					if filecopy(parent.is_tmp, parent.is_rt, true) = 1 then
						filedelete(parent.is_tmp)
					end if
					parent.p_rt.picturename = parent.is_rt
					parent.il_rt = 1
					parent.p_ri.setfocus()
					parent.p_ri.triggerevent(clicked!)
				case "p_ri"
					parent.iblb_ri = rawimage
					parent.iblb_ri_f = lb_img
					if fileexists(parent.is_ri) then
						filedelete(parent.is_ri)
					end if
					if filecopy(parent.is_tmp, parent.is_ri, true) = 1 then
						filedelete(parent.is_tmp)
					end if
					parent.p_ri.picturename = parent.is_ri
					parent.il_ri = 1
					parent.p_rm.setfocus()
					parent.p_rm.triggerevent(clicked!)
				case "p_rm"
					parent.iblb_rm = rawimage
					parent.iblb_rm_f = lb_img
					if fileexists(parent.is_rm) then
						filedelete(parent.is_rm)
					end if
					if filecopy(parent.is_tmp, parent.is_rm, true) = 1 then
						filedelete(parent.is_tmp)
					end if
					parent.p_rm.picturename = parent.is_rm
					parent.il_rm = 1
					parent.p_rr.setfocus()
					parent.p_rr.triggerevent(clicked!)
				case "p_rr"
					parent.iblb_rr = rawimage
					parent.iblb_rr_f = lb_img
					if fileexists(parent.is_rr) then
						filedelete(parent.is_rr)
					end if
					if filecopy(parent.is_tmp, parent.is_rr, true) = 1 then
						filedelete(parent.is_tmp)
					end if
					parent.p_rr.picturename = parent.is_rr
					parent.il_rr = 1
					parent.p_rb.setfocus()
					parent.p_rb.triggerevent(clicked!)
				case "p_rb"
					parent.iblb_rb = rawimage
					parent.iblb_rb_f = lb_img
					if fileexists(parent.is_rb) then
						filedelete(parent.is_rb)
					end if
					if filecopy(parent.is_tmp, parent.is_rb, true) = 1 then
						filedelete(parent.is_tmp)
					end if
					parent.p_rb.picturename = parent.is_rb
					parent.il_rb = 1
					parent.p_lt.setfocus()
					parent.p_lt.triggerevent(clicked!)
				case "p_lt"
					parent.iblb_lt = rawimage
					parent.iblb_lt_f = lb_img
					if fileexists(parent.is_lt) then
						filedelete(parent.is_lt)
					end if
					if filecopy(parent.is_tmp, parent.is_lt, true) = 1 then
						filedelete(parent.is_tmp)
					end if
					parent.p_lt.picturename = parent.is_lt
					parent.il_lt = 1
					parent.p_li.setfocus()
					parent.p_li.triggerevent(clicked!)
				case "p_li"
					parent.iblb_li = rawimage
					parent.iblb_li_f = lb_img
					if fileexists(parent.is_li) then
						filedelete(parent.is_li)
					end if
					if filecopy(parent.is_tmp, parent.is_li, true) = 1 then
						filedelete(parent.is_tmp)
					end if
					parent.p_li.picturename = parent.is_li
					parent.il_li = 1
					parent.p_lm.setfocus()
					parent.p_lm.triggerevent(clicked!)
				case "p_lm"
					parent.iblb_lm = rawimage
					parent.iblb_lm_f = lb_img
					if fileexists(parent.is_lm) then
						filedelete(parent.is_lm)
					end if
					if filecopy(parent.is_tmp, parent.is_lm, true) = 1 then
						filedelete(parent.is_tmp)
					end if
					parent.p_lm.picturename = parent.is_lm
					parent.il_lm = 1
					parent.p_lr.setfocus()
					parent.p_lr.triggerevent(clicked!)
				case "p_lr"
					parent.iblb_lr = rawimage
					parent.iblb_lr_f = lb_img
					if fileexists(parent.is_lr) then
						filedelete(parent.is_lr)
					end if
					if filecopy(parent.is_tmp, parent.is_lr, true) = 1 then
						filedelete(parent.is_tmp)
					end if
					parent.p_lr.picturename = parent.is_lr
					parent.il_lr = 1
					parent.p_lb.setfocus()
					parent.p_lb.triggerevent(clicked!)
				case "p_lb"
					parent.iblb_lb = rawimage
					parent.iblb_lb_f = lb_img
					if fileexists(parent.is_lb) then
						filedelete(parent.is_lb)
					end if
					if filecopy(parent.is_tmp, parent.is_lb, true) = 1 then
						filedelete(parent.is_tmp)
					end if
					parent.p_lb.picturename = parent.is_lb
					parent.il_lb = 1
					parent.cb_ok.setfocus()
				end choose
			end if
		else
			messagebox("Feature Template Error", "Not a good quality feature extractionis possoble from this fingerprint~r~nKindly Scan this fingure again~r~nError Code = " + string(ll_quality), stopsign!)
		end if
		return
	end if
	messagebox("Image Saving Error", "Error in saving raw image to disk~r~nError Code = " + string(ll_ret), stopsign!)

// ole_grfinger.constructor() returns long
	long ll_err
	ll_err = this.object.__invoke_method("createcontext", 1, {parent.il_grcontextid}, true)
	ll_err = this.object.__invoke_method("initialize", 0, {}, true)
	ll_err = this.object.__invoke_method("capinitialize", 0, {}, true)
	return ::message.returnvalue

