// cb_cancel.clicked() returns long
	parent.post event ue_close(0)
	return ::message.returnvalue

// dw_control.ue_enterkey() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_control.itemchanged(long row, dwobject dwo, string data) returns long
	long ancestorreturnvalue
	integer li_null
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	setnull(li_null)
	choose case dwo.name
	case "flatdisc"
		if double(data) > this.object.misccharges[row] then
			messagebox("Fine Waiver Amount", "Invalid Waiver Amount~r~nIt Must not exceed from the Amount Originally Fined", stopsign!)
			return 1
		else
			if this.object.invtotal[row] - double(data) > 0 then
				this.object.invtotal[row] = this.object.invtotal[row] - double(data)
			else
				this.object.invtotal[row] = 0.00
			end if
			if this.object.outstandingamt[row] - double(data) > 0 then
				this.object.outstandingamt[row] = this.object.outstandingamt[row] - double(data)
			else
				this.object.outstandingamt[row] = 0.00
			end if
			return 0
		end if
		return
	end choose
	return ::message.returnvalue

// dw_control.getfocus() returns long
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// cb_ok.ue_keypressed(keycode key, unsignedlong keyflags) returns long
	if key = keyenter! then
		postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_ok.clicked() returns long
	string ls_errtext
	SQL DELETE DBO.EMP_FingerPrint WHERE EmpCode =:parent.il_code USING parent.it_transobject;
	if parent.it_transobject.sqlcode = 0 then
		if parent.il_rt = 1 then
			parent.wf_insert_fingerprint(1, parent.iblb_rt, parent.iblb_rt_f)
		end if
		if parent.il_ri = 1 then
			parent.wf_insert_fingerprint(2, parent.iblb_ri, parent.iblb_ri_f)
		end if
		if parent.il_rm = 1 then
			parent.wf_insert_fingerprint(3, parent.iblb_rm, parent.iblb_rm_f)
		end if
		if parent.il_rr = 1 then
			parent.wf_insert_fingerprint(4, parent.iblb_rr, parent.iblb_rr_f)
		end if
		if parent.il_rb = 1 then
			parent.wf_insert_fingerprint(5, parent.iblb_rb, parent.iblb_rb_f)
		end if
		if parent.il_lt = 1 then
			parent.wf_insert_fingerprint(6, parent.iblb_lt, parent.iblb_lt_f)
		end if
		if parent.il_li = 1 then
			parent.wf_insert_fingerprint(7, parent.iblb_li, parent.iblb_li_f)
		end if
		if parent.il_lm = 1 then
			parent.wf_insert_fingerprint(8, parent.iblb_lm, parent.iblb_lm_f)
		end if
		if parent.il_lr = 1 then
			parent.wf_insert_fingerprint(9, parent.iblb_lr, parent.iblb_lr_f)
		end if
		if parent.il_lb = 1 then
			parent.wf_insert_fingerprint(10, parent.iblb_lb, parent.iblb_lb_f)
		end if
		parent.triggerevent("ue_close")
	end if
	return ::message.returnvalue
