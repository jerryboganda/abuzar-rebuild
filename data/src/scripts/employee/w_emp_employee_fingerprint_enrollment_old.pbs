						this.object.__invoke_method("gettemplate", 0, {}, true)
						parent.il_li = 1
					end if
					parent.p_li.setredraw(true)
				else
					parent.li_iteration = 0
					parent.p_lm.setfocus()
					parent.p_lm.triggerevent(clicked!)
				end if
			case "p_lm"
				parent.li_iteration = parent.li_iteration + 1
				if parent.li_iteration <= parent.li_maxiteration then
					if fileexists(parent.is_lm) then
						filedelete(parent.is_lm)
					end if
					parent.p_lm.setredraw(false)
					parent.iblb_lm = rawimage
					if filecopy(parent.is_tmp, parent.is_lm, true) = 1 then
