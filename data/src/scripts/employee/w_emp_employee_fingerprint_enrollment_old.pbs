					parent.p_rr.triggerevent(clicked!)
				end if
			case "p_rr"
				parent.li_iteration = parent.li_iteration + 1
				if parent.li_iteration <= parent.li_maxiteration then
					if fileexists(parent.is_rr) then
						filedelete(parent.is_rr)
