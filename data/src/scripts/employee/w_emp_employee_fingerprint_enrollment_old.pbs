	this.gb_left = create gb_left
	this.control = {this.ole_zktfp, this.p_lb, this.p_lr, this.p_lm, this.p_li, this.p_lt, this.ole_grfinger, this.st_10, this.st_9, this.st_8, this.st_7, this.st_6, this.st_5, this.st_4, this.st_3, this.st_2, this.st_1, this.p_rb, this.p_rr, this.p_rm, this.p_ri, this.p_rt, this.cb_cancel, this.dw_control, this.cb_ok, this.gb_right, this.gb_left}

