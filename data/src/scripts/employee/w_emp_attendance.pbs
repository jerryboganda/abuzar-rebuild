// window w_emp_attendance (employee)  ancestor: window

// w_emp_attendance.ue_close(integer ai_status) returns 0 [event]
	close(this)

// w_emp_attendance.wf_insert_fingerprint(integer ai_finger, blob img, blob features) returns long
	SQL INSERT INTO EMP_FingerPrint ( EmpCode , FingerCode ) VALUES ( :this.il_code , :ai_finger ) USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Insert Error", "Unable to Insert Employee Finger Images Into Database.~r~nReasons are:~r~n" + this.it_transobject.sqlerrtext)
		return -1
	end if
	SQL UPDATEBLOB EMP_FingerPrint SET FingerPrint =:img WHERE EMPCode =:this.il_code AND FingerCode =:ai_finger USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Employee Finger Image Problem", "Unable to update Employee Finger Image.~r~nReasons are:~r~n" + this.it_transobject.sqlerrtext)
	end if
	SQL UPDATEBLOB EMP_FingerPrint SET Features =:features WHERE EMPCode =:this.il_code AND FingerCode =:ai_finger USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Employee Finger Image Features Problem", "Unable to update Employee Finger Image Features.~r~nReasons are:~r~n" + this.it_transobject.sqlerrtext)
	end if
	return 0

// w_emp_attendance.wf_set_photo(long al_empcode) returns long
	SQL SELECTBLOB Picture INTO :this.iblb_photo FROM EMP_Employee WHERE EmpCode =:al_empcode USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.uo_attendance.p_photo.setredraw(false)
		if not isnull(this.iblb_photo) then
			this.uo_attendance.p_photo.setpicture(this.iblb_photo)
		end if
		this.uo_attendance.p_photo.setredraw(true)
		if f_stringpreferences("ShowPhotoInOnlineAtten") = "Y" then
			if not isnull(this.iblb_photo) then
				this.uo_attendance.p_photo.show()
			end if
		else
			this.uo_attendance.p_photo.hide()
		end if
	else
		setnull(this.iblb_photo)
		this.uo_attendance.p_photo.setredraw(false)
		this.uo_attendance.p_photo.setpicture(this.iblb_photo)
		this.uo_attendance.p_photo.setredraw(true)
		this.uo_attendance.p_photo.hide()
		return -1
	end if
	return 0

// w_emp_attendance.wf_playsound(integer ai_sound) returns integer
	unsignedinteger lui_numdevs
	lui_numdevs = waveoutgetnumdevs()
	if lui_numdevs > 0 then
		if ai_sound = 1 then
			sndplaysounda("Welcome.Wav", 0)
		else
			sndplaysounda("GoodBYE.WAV", 0)
		end if
	end if
	return 0

// w_emp_attendance.wf_validate_empid(string as_empid) returns long
	long ll_ret
	long ll_format
	long ll_quality
	long ll_matchcontext
	long ll_counter
	long ll_size
	long ll_score
	long ll_identify
	long ll_empcode
	long ll_fingercode
	long ll_attendancecode
	long ll_null
	char lc_allowattendanceviaid
	datetime ldt_attendancedate
	boolean lb_identified
	blob lb_curr_temp
	setnull(ll_null)
	setnull(this.iblb_fp)
	setnull(ldt_attendancedate)
	SQL SELECT EmpCode , AllowAttendanceViaID =UPPER ( AllowAttendanceViaID ) INTO :ll_empcode, :lc_allowattendanceviaid FROM DBO.EMP_Employee WHERE EMPID =:as_empid USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if ll_empcode > 0 then
			if lc_allowattendanceviaid = "Y" then
				setnull(this.iblb_fp)
				this.uo_attendance.dw_control.reset()
				this.uo_attendance.dw_control.insertrow(0)
				this.uo_attendance.p_photo.setredraw(false)
				this.uo_attendance.p_photo.setpicture(this.iblb_fp)
				this.uo_attendance.p_photo.setredraw(true)
				ll_fingercode = 1
				this.it_transobject.markattendance(ll_empcode, ll_fingercode, ll_attendancecode, ldt_attendancedate)
				if this.it_transobject.sqlcode = 0 then
					if ll_attendancecode > 0 then
						SQL commit USING this.it_transobject;
						this.uo_attendance.dw_control.retrieve(ll_attendancecode)
						wf_set_photo(ll_empcode)
						if ll_attendancecode > 0 then
							if isnull(this.uo_attendance.dw_control.object.timeout[1]) then
								wf_playsound(1)
							else
								wf_playsound(2)
							end if
						end if
					else
						messagebox("Attendance Marking Problem", "Problem in marking attendance for this employee~r~nDetails are:-~r~n" + this.it_transobject.sqlerrtext)
						ll_ret = 1
					end if
				else
					setnull(this.iblb_fp)
					setnull(this.iblb_photo)
					this.uo_attendance.dw_control.insertrow(0)
					this.uo_attendance.p_photo.setredraw(false)
					this.uo_attendance.p_photo.setpicture(this.iblb_photo)
					this.uo_attendance.p_photo.setredraw(true)
					this.uo_attendance.p_fp.setredraw(false)
					this.uo_attendance.p_fp.setpicture(this.iblb_fp)
					this.uo_attendance.p_fp.setredraw(true)
					messagebox("Attendance Marking Problem", "Problem in marking attendance for this employee~r~nDetails are:-~r~n" + this.it_transobject.sqlerrtext)
					ll_ret = 1
				end if
			else
				setnull(this.iblb_fp)
				setnull(this.iblb_photo)
				this.uo_attendance.dw_control.insertrow(0)
				this.uo_attendance.p_photo.setredraw(false)
				this.uo_attendance.p_photo.setpicture(this.iblb_photo)
				this.uo_attendance.p_photo.setredraw(true)
				this.uo_attendance.p_fp.setredraw(false)
				this.uo_attendance.p_fp.setpicture(this.iblb_fp)
				this.uo_attendance.p_fp.setredraw(true)
				messagebox("Attendance Marking Problem", "Problem in marking attendance for this employee~r~nAttendance for this employee is not allowed via Employee ID.~r~nPlease consult your system administrator to do the needfull.", information!)
				ll_ret = 1
			end if
		else
			setnull(this.iblb_fp)
			setnull(this.iblb_photo)
			this.uo_attendance.dw_control.insertrow(0)
			this.uo_attendance.p_photo.setredraw(false)
			this.uo_attendance.p_photo.setpicture(this.iblb_photo)
			this.uo_attendance.p_photo.setredraw(true)
			this.uo_attendance.p_fp.setredraw(false)
			this.uo_attendance.p_fp.setpicture(this.iblb_fp)
			this.uo_attendance.p_fp.setredraw(true)
			ll_ret = 1
			messagebox("Employee ID Validation", "Employee ID " + as_empid + " is not a valid.~r~nPlease enter some valid Employee ID", information!)
		end if
	else
		setnull(this.iblb_fp)
		setnull(this.iblb_photo)
		this.uo_attendance.dw_control.insertrow(0)
		this.uo_attendance.p_photo.setredraw(false)
		this.uo_attendance.p_photo.setpicture(this.iblb_photo)
		this.uo_attendance.p_photo.setredraw(true)
		this.uo_attendance.p_fp.setredraw(false)
		this.uo_attendance.p_fp.setpicture(this.iblb_fp)
		this.uo_attendance.p_fp.setredraw(true)
		ll_ret = 1
		messagebox("Employee ID Validation", "Some Database Problem encountered while validating employee id = " + as_empid + "~r~nReasons are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
	end if
	return ll_ret

// w_emp_attendance.wf_set_timer() returns long
	long ll_timer_sec
	ll_timer_sec = f_numberpreferences("LastEmpInfoClearance_InOnlineAtten")
	if ll_timer_sec < 0 or isnull(ll_timer_sec) then
		ll_timer_sec = 5
	end if
	this.il_clearancetime = ll_timer_sec
	timer(this.il_clearancetime, this)
	return 0

// w_emp_attendance.wf_clear_employee_info() returns integer
	setnull(this.iblb_fp)
	setnull(this.iblb_photo)
	this.uo_attendance.dw_control.reset()
	this.uo_attendance.dw_control.insertrow(0)
	this.uo_attendance.p_fp.setredraw(false)
	this.uo_attendance.p_fp.setpicture(this.iblb_fp)
	this.uo_attendance.p_fp.setredraw(true)
	this.uo_attendance.p_photo.setredraw(false)
	this.uo_attendance.p_photo.setpicture(this.iblb_photo)
	this.uo_attendance.p_photo.picturename = ""
	this.uo_attendance.p_photo.setredraw(true)
	this.uo_attendance.p_photo.visible = false
	this.dw_empid.reset()
	if f_stringpreferences("EmployeeIDInOnlineAtten") = "Y" then
		this.dw_empid.insertrow(0)
	end if
	return 0

// w_emp_attendance.create() returns 0 [event]
	this.ole_zkfinger = create ole_zkfinger
	this.ole_grfinger = create ole_grfinger
	this.uo_attendance = create uo_attendance
	this.dw_empid = create dw_empid
	this.control = {this.ole_zkfinger, this.ole_grfinger, this.uo_attendance, this.dw_empid}

// w_emp_attendance.destroy() returns 0 [event]
	destroy this.ole_zkfinger
	destroy this.ole_grfinger
	destroy this.uo_attendance
	destroy this.dw_empid

// w_emp_attendance.open() returns long [event]
	environment le_env
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_err
	this.is_tmp = gs_temp_directory + "\tempfp.bmp"
	filedelete(this.is_tmp)
	this.is_fp = gs_temp_directory + "\newfp.bmp"
	filedelete(this.is_fp)
	this.it_transobject = create u_transaction
	this.it_transobject.autocommit = false
	SQL start USING this.it_transobject;
	if this.it_transobject.sqlcode <> 0 then
		messagebox("Connection Problem", "Unable to connect to database.RNDetails are:-~r~n" + this.it_transobject.sqlerrtext, stopsign!)
		close(this)
		return ::message.returnvalue
	end if
	if getenvironment(le_env) = 1 then
		ll_win_width = pixelstounits(le_env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(le_env.screenheight, ypixelstounits!)
		ll_width = ll_win_width
		ll_height = ll_win_height
		this.width = ll_width
		this.height = ll_height
		if ll_width > 0 and ll_height > 0 then
			ll_width = ll_width / 2.0
			ll_height = ll_height / 2.0
			if ll_width > 0 and ll_height > 0 then
				this.x = ll_width
				this.y = ll_height
			end if
		end if
	end if
	this.uo_attendance.dw_control.settransobject(this.it_transobject)
	this.dw_empid.settransobject(this.it_transobject)
	hide()
	setpointer(hourglass!)
	this.uo_attendance.p_fp.hide()
	this.ids_emp_features = create datastore
	this.ids_emp_features.dataobject = "d_emp_fingerprint_features"
	this.ids_emp_features.settransobject(this.it_transobject)
	this.ids_emp_features.retrieve()
	setpointer(arrow!)
	this.uo_attendance.x = long((this.width - this.uo_attendance.width) / 2.0)
	this.uo_attendance.y = long((this.height - this.uo_attendance.height - this.dw_empid.height - 100) / 2.0)
	this.dw_empid.x = long((this.width - this.dw_empid.width) / 2.0)
	this.dw_empid.y = long(this.uo_attendance.y + this.uo_attendance.height + 28)
	if f_stringpreferences("EmployeeIDInOnlineAtten") = "Y" then
		this.dw_empid.insertrow(0)
	end if
	if f_stringpreferences("ShowPhotoInOnlineAtten") = "Y" then
		this.uo_attendance.p_photo.show()
	else
		this.uo_attendance.p_photo.hide()
	end if
	if f_stringpreferences("ShowFingerPrintInOnlineAtten") = "Y" then
		this.uo_attendance.p_fp.show()
		this.uo_attendance.p_fp.setfocus()
		this.uo_attendance.p_fp.triggerevent(clicked!)
	else
		this.uo_attendance.p_fp.hide()
		this.dw_empid.setfocus()
	end if
	if f_stringpreferences("ShowStatusInOnlineAtten") = "Y" then
		this.uo_attendance.dw_control.object.attendancestatuscode.visible = "1~tIf(attendancecode > 0,1,0)"
		this.uo_attendance.dw_control.object.attendancestatuscode_t.visible = "1~tIf(attendancecode > 0,1,0)"
	else
		this.uo_attendance.dw_control.object.attendancestatuscode.visible = false
		this.uo_attendance.dw_control.object.attendancestatuscode_t.visible = false
	end if
	if f_stringpreferences("ShowCategoryInOnlineAtten") = "Y" then
		this.uo_attendance.dw_control.object.empcatcode.visible = "1~tIf(attendancecode > 0,1,0)"
		this.uo_attendance.dw_control.object.empcatcode_t.visible = "1~tIf(attendancecode > 0,1,0)"
	else
		this.uo_attendance.dw_control.object.empcatcode.visible = false
		this.uo_attendance.dw_control.object.empcatcode_t.visible = false
	end if
	if f_stringpreferences("ShowDeptInOnlineAtten") = "Y" then
		this.uo_attendance.dw_control.object.deptcode.visible = "1~tIf(attendancecode > 0,1,0)"
		this.uo_attendance.dw_control.object.deptcode_t.visible = "1~tIf(attendancecode > 0,1,0)"
	else
		this.uo_attendance.dw_control.object.deptcode.visible = false
		this.uo_attendance.dw_control.object.deptcode_t.visible = false
	end if
	if f_stringpreferences("ShowDesigOnlineAtten") = "Y" then
		this.uo_attendance.dw_control.object.desigcode.visible = "1~tIf(attendancecode > 0,1,0)"
		this.uo_attendance.dw_control.object.desigcode_t.visible = "1~tIf(attendancecode > 0,1,0)"
	else
		this.uo_attendance.dw_control.object.desigcode.visible = false
		this.uo_attendance.dw_control.object.desigcode_t.visible = false
	end if
	show()
	wf_set_timer()
	return ::message.returnvalue

// w_emp_attendance.close() returns long [event]
	triggerevent("ue_close")
	return ::message.returnvalue

// w_emp_attendance.timer() returns long [event]
	wf_clear_employee_info()
	return ::message.returnvalue

// ole_zkfinger.oncapture(boolean actionresult, any atemplate) returns 0 [event]
	long ll_ret
	long ll_quality
	long ll_null
	long ll_counter
	long ll_identify
	long ll_score
	long ll_empcode
	long ll_fingercode
	long ll_attendancecode
	datetime ldt_attendancedate
	blob rawimage
	blob lb_img
	string ls_ver
	string ls_regtemplate
	string ls_vertemplate
	boolean lb_identified
	boolean lb_featurechanged
	runtimeerror ex
	try
		setnull(ldt_attendancedate)
		setnull(ll_null)
		setnull(parent.iblb_fp)
		parent.uo_attendance.dw_control.reset()
		parent.uo_attendance.dw_control.insertrow(0)
		parent.uo_attendance.p_photo.setredraw(false)
		parent.uo_attendance.p_photo.setpicture(parent.iblb_fp)
		parent.uo_attendance.p_photo.setredraw(true)
		if fileexists(parent.is_tmp) then
			filedelete(parent.is_tmp)
		end if
		if fileexists(parent.is_fp) then
			filedelete(parent.is_fp)
		end if
		ls_ver = this.object.fpengineversion
		ll_quality = long(string(this.object.lastquality))
		if ll_quality >= 60 then
			this.object.__invoke_method("savebitmap", 1, {parent.is_tmp}, true)
			this.object.__invoke_method("getfingerimage", 1, {rawimage}, true)
			ls_vertemplate = string(this.object.__invoke_method("gettemplateex", 1, {ls_ver}, true))
			if isnull(ls_vertemplate) then
				messagebox("Extraction Failed", "Extraction Failed")
			else
				parent.iblb_fp = rawimage
				if fileexists(parent.is_fp) then
					filedelete(parent.is_fp)
				end if
				filecopy(parent.is_tmp, parent.is_fp, true)
				parent.uo_attendance.p_fp.setredraw(false)
				parent.uo_attendance.p_fp.picturename = parent.is_fp
				parent.uo_attendance.p_fp.setredraw(true)
				for ll_counter = 1 to parent.ids_emp_features.rowcount()
					ls_regtemplate = string(parent.ids_emp_features.object.features[ll_counter])
					if this.object.__invoke_method("verfingerfromstr", 4, {ls_regtemplate, ls_vertemplate, true, lb_featurechanged}, true) = true then
						lb_identified = true
						ll_empcode = parent.ids_emp_features.object.empcode[ll_counter]
						ll_fingercode = parent.ids_emp_features.object.fingercode[ll_counter]
						parent.it_transobject.markattendance(ll_empcode, ll_fingercode, ll_attendancecode, ldt_attendancedate)
						if parent.it_transobject.sqlcode = 0 and ll_attendancecode > 0 then
							SQL commit USING parent.it_transobject;
							parent.uo_attendance.dw_control.retrieve(ll_attendancecode)
							parent.wf_set_photo(ll_empcode)
							if ll_attendancecode > 0 then
								if isnull(parent.uo_attendance.dw_control.object.timeout[1]) then
									parent.wf_playsound(1)
								else
									parent.wf_playsound(2)
								end if
							end if
						else
							setnull(parent.iblb_fp)
							parent.uo_attendance.dw_control.insertrow(0)
							parent.uo_attendance.p_photo.setredraw(false)
							parent.uo_attendance.p_photo.setpicture(parent.iblb_fp)
							parent.uo_attendance.p_photo.setredraw(true)
							messagebox("Attendance Marking Problem", "Problem in marking attendance for this employee~r~nDetails are:-~r~n" + parent.it_transobject.sqlerrtext)
						end if
						exit
					end if
				next
			end if
		else
			messagebox("Feature Template Error", "Not a good quality feature extraction is possible from this fingerprint~r~nKindly Scan this fingure again~r~nQuality = " + string(ll_quality) + "%~r~nMin. Desired Quality = 60%", stopsign!)
		end if
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try

// ole_zkfinger.constructor() returns long [event]
	long ll_retcode
	runtimeerror ex
	try
		ll_retcode = this.object.__invoke_method("initengine", 0, {}, true)
		if ll_retcode = 0 then
			this.object.__invoke_method("begincapture", 0, {}, true)
		elseif ll_retcode = 1 then
			messagebox("ZKT Fingerprint Device Error", "The loading of the fingerprint identification driver failed.", stopsign!)
		elseif ll_retcode = 2 then
			messagebox("ZKT Fingerprint Device Error", "Fingerprint Sensor has not been connected.", stopsign!)
		elseif ll_retcode = 3 then
			messagebox("ZKT Fingerprint Device Error", "The fingerprint Reader appointed by the property SensorIndex dose not exist.", stopsign!)
		end if
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try
	return ::message.returnvalue

// ole_zkfinger.destructor() returns long [event]
	runtimeerror ex
	try
		this.object.__invoke_method("cancelcapture", 0, {}, true)
		this.object.__invoke_method("cancelenroll", 0, {}, true)
		this.object.__invoke_method("endengine", 0, {}, true)
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try
	return ::message.returnvalue

// ole_grfinger.sensorplug(string idsensor) returns 0 [event]
	runtimeerror ex
	try
		this.object.__invoke_method("capstartcapture", 1, {idsensor}, true)
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try

// ole_grfinger.sensorunplug(string idsensor) returns 0 [event]
	runtimeerror ex
	try
		this.object.__invoke_method("capstopcapture", 1, {idsensor}, true)
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try

// ole_grfinger.imageacquired(string idsensor, long ocx_width, long ocx_height, any rawimage, long res) returns 0 [event]
	long ll_ret
	long ll_format
	long ll_quality
	long ll_matchcontext
	long ll_counter
	long ll_size
	long ll_score
	long ll_identify
	long ll_empcode
	long ll_fingercode
	long ll_attendancecode
	long ll_null
	datetime ldt_attendancedate
	boolean lb_identified
	blob lb_curr_temp
	runtimeerror ex
	try
		setnull(ldt_attendancedate)
		setnull(ll_null)
		setnull(parent.iblb_fp)
		parent.uo_attendance.dw_control.reset()
		parent.uo_attendance.dw_control.insertrow(0)
		parent.uo_attendance.p_photo.setredraw(false)
		parent.uo_attendance.p_photo.setpicture(parent.iblb_fp)
		parent.uo_attendance.p_photo.setredraw(true)
		if fileexists(parent.is_tmp) then
			filedelete(parent.is_tmp)
		end if
		if fileexists(parent.is_fp) then
			filedelete(parent.is_fp)
		end if
		ll_ret = this.object.__invoke_method("capsaverawimagetofile", 5, {rawimage, ocx_width, ocx_height, parent.is_tmp, 501}, true)
		if ll_ret = 0 then
			ll_quality = this.object.__invoke_method("extract", 7, {rawimage, ocx_width, ocx_height, res, parent.ib_template, ll_size, parent.il_grcontextid}, true)
			if ll_quality > 0 then
				if ll_size <= 0 or isnull(ll_size) then
					messagebox("Extraction Failed", "Extraction Failed")
				else
					parent.iblb_fp = rawimage
					if fileexists(parent.is_fp) then
						filedelete(parent.is_fp)
					end if
					filecopy(parent.is_tmp, parent.is_fp, true)
					parent.uo_attendance.p_fp.setredraw(false)
					parent.uo_attendance.p_fp.picturename = parent.is_fp
					parent.uo_attendance.p_fp.setredraw(true)
					ll_ret = this.object.__invoke_method("identifyprepare", 2, {parent.ib_template, parent.il_grcontextid}, true)
					if ll_ret >= 0 then
						for ll_counter = 1 to parent.ids_emp_features.rowcount()
							lb_curr_temp = parent.ids_emp_features.object.features[ll_counter]
							ll_identify = this.object.__invoke_method("identify", 3, {lb_curr_temp, ll_score, parent.il_grcontextid}, true)
							if ll_identify = 1 then
								lb_identified = true
								ll_empcode = parent.ids_emp_features.object.empcode[ll_counter]
								ll_fingercode = parent.ids_emp_features.object.fingercode[ll_counter]
								parent.it_transobject.markattendance(ll_empcode, ll_fingercode, ll_attendancecode, ldt_attendancedate)
								if parent.it_transobject.sqlcode = 0 and ll_attendancecode > 0 then
									SQL commit USING parent.it_transobject;
									parent.uo_attendance.dw_control.retrieve(ll_attendancecode)
									parent.wf_set_photo(ll_empcode)
									if ll_attendancecode > 0 then
										if isnull(parent.uo_attendance.dw_control.object.timeout[1]) then
											parent.wf_playsound(1)
										else
											parent.wf_playsound(2)
										end if
									end if
								else
									setnull(parent.iblb_fp)
									parent.uo_attendance.dw_control.insertrow(0)
									parent.uo_attendance.p_photo.setredraw(false)
									parent.uo_attendance.p_photo.setpicture(parent.iblb_fp)
									parent.uo_attendance.p_photo.setredraw(true)
									messagebox("Attendance Marking Problem", "Problem in marking attendance for this employee~r~nDetails are:-~r~n" + parent.it_transobject.sqlerrtext)
								end if
								exit
							end if
						next
					else
						messagebox("identify prepare", "identify prepare failure~r~ncode = " + string(ll_ret))
					end if
				end if
			else
				messagebox("Feature Template Error", "Not a good quality feature extractionis possoble from this fingerprint~r~nKindly Scan this fingure again~r~nError Code = " + string(ll_quality), stopsign!)
			end if
		else
			messagebox("Image Saving Error", "Error in saving raw image to disk~r~nError Code = " + string(ll_ret), stopsign!)
		end if
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try

// ole_grfinger.constructor() returns long [event]
	long ll_err
	runtimeerror ex
	try
		ll_err = this.object.__invoke_method("createcontext", 1, {parent.il_grcontextid}, true)
		ll_err = this.object.__invoke_method("initialize", 0, {}, true)
		ll_err = this.object.__invoke_method("capinitialize", 0, {}, true)
	catch (throwable ex)
		parent.uo_attendance.p_fp.visible = false
		parent.uo_attendance.p_fp.enabled = false
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try
	return ::message.returnvalue

// ole_grfinger.destructor() returns long [event]
	long ll_err
	runtimeerror ex
	try
		ll_err = this.object.__invoke_method("capfinalize", 0, {}, true)
		ll_err = this.object.__invoke_method("finalize", 0, {}, true)
	catch (throwable ex)
		messagebox("Exception Occur", "Details are:~r~n" + ex.getmessage())
	end try
	return ::message.returnvalue

// uo_attendance.destroy() returns 0 [event]
	call super::destroy

// dw_empid.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "empid"
		if data <> "" and len(trim(data)) > 0 then
			ll_retcode = parent.wf_validate_empid(data)
		else
			messagebox("Employee ID Validation", "Not a valid Employee ID.~r~nPlease enter some valid Employee ID", information!)
			ll_retcode = 1
		end if
		return ll_retcode
	end choose
	return ll_retcode
