// window w_emp_dept (employee)  ancestor: w_multi_entry

// w_emp_dept.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM EMP_Department WHERE name =:as_name USING this.it_transobject;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_emp_dept.wf_validateitem() returns integer
	long ll_icode
	integer li_errcode
	string ls_managername
	integer li_null
	ll_icode = this.id_detail.getitemnumber(this.il_currrow, "weekdaycode")
	if vf_dwdupcode1(this.id_detail, "weekdaycode", string(ll_icode), this.il_currrow) = true then
		ls_managername = ""
		messagebox("Duplication Error", "Current row is duplicate")
		li_errcode = -1
	else
		li_errcode = 0
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		setnull(li_null)
		this.id_detail.setcolumn("weekdaycode")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.weekdaycode[this.il_currrow] = li_null
	end if
	return li_errcode

// w_emp_dept.create() returns 0
	call super::create

// w_emp_dept.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_emp_dept.ue_save() returns 0
	long ll_mastercurrrow
	long ll_invid
	long ll_detailrows
	integer li_counter
	integer ll_salesmancode
	boolean lb_commitflag
	dwitemstatus lds_rowstatus
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	if f_validatedw(this.id_master) < 0 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	setpointer(hourglass!)
	ll_mastercurrrow = this.id_master.getrow()
	ll_invid = this.id_master.object.code[ll_mastercurrrow]
	if isnull(ll_invid) then
		f_newtableid("EMP_Department", ll_invid)
		this.id_master.object.code[ll_mastercurrrow] = ll_invid
	end if
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	do while li_counter <= ll_detailrows and lb_commitflag = true
		lds_rowstatus = this.id_detail.getitemstatus(li_counter, 0, primary!)
		if lds_rowstatus = newmodified! then
			this.id_detail.setitem(li_counter, "code", ll_invid)
		end if
		li_counter = li_counter + 1
	loop
	call super::ue_save
	setpointer(arrow!)

// w_emp_dept.ue_newform() returns 0
	call super::ue_newform
	this.id_master.setfocus()

// w_emp_dept.ue_newitem() returns 0
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	call super::ue_newitem
	this.id_detail.setcolumn("weekdaycode")

// w_emp_dept.ue_detail() returns 0
	call super::ue_detail
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_delete.enabled = true
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true

// w_emp_dept.ue_postopen() returns 0
	call super::ue_postopen
	this.id_detail.getchild("WeekDayCode", this.idc_salesman)
	this.idc_salesman.settransobject(this.it_transobject)

// w_emp_dept.ue_deleteitem() returns 0
	long ll_currow
	long ll_detailrows
	long ll_icode
	dwruntimeerror myexc
	this.ib_itemvalidated = true
	try
		ll_icode = this.id_detail.object.icode[this.id_detail.getrow()]
	catch (throwable myexc)
	end try
	if not isnull(ll_icode) then
		this.id_detail.rowscopy(this.id_detail.getrow(), this.id_detail.getrow(), primary!, this.ids_itemrecyclebin, this.ids_itemrecyclebin.rowcount() + 1, primary!)
	end if
	this.id_detail.deleterow(0)
	ll_detailrows = this.id_detail.rowcount()
	wf_grandtotal()
