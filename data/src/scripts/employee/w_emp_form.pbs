	return ::message.returnvalue

// dw_proj.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if len(gettext()) > 0 then
		selecttext(1, len(gettext()))
	end if
	return ::message.returnvalue

// dw_proj.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	setfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// tabpage_ref.create() returns 0 [event]
	this.dw_ref = create dw_ref
	this.control = {this.dw_ref}

// tabpage_ref.destroy() returns 0 [event]
	destroy this.dw_ref

// dw_ref.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyinsert! then
		parent.parent.parent.wf_insert_row(parent.parent.parent.id_ref, 1)
	elseif keyflags = 2 and key = keyd! then
		parent.parent.parent.wf_delete_row(parent.parent.parent.id_ref, 1)
	end if
	if key = keyf5! then
		parent.parent.parent.wf_goto_record(parent.parent.parent.id_ref)
	end if
	if key = keyf8! and parent.parent.parent.ib_viewimage then
		parent.parent.parent.wf_show_employee_gallery()
	end if
	if key = keyf9! and parent.parent.parent.ib_uploadimage then
		parent.parent.parent.wf_setimage("REF")
	end if
	return ::message.returnvalue

// dw_ref.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	if getcolumnname() <> "comments" then
		send(handle(this), 256, 9, long(90))
		return 1
	end if
	return ::message.returnvalue

// dw_ref.itemfocuschanged(long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemfocuschanged(row, dwo)
	if len(gettext()) > 0 then
		selecttext(1, len(gettext()))
	end if
	return ::message.returnvalue

// dw_ref.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	setfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// tabpage_pay.create() returns 0 [event]
	this.dw_pay = create dw_pay
	this.dw_deduction = create dw_deduction
	this.dw_allowance = create dw_allowance
	this.control = {this.dw_pay, this.dw_deduction, this.dw_allowance}

// tabpage_pay.destroy() returns 0 [event]
	destroy this.dw_pay
	destroy this.dw_deduction
	destroy this.dw_allowance

// dw_pay.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "paytype"
		return parent.parent.parent.wf_update_salary(dwo.name, data, row)
	case "payfrequency"
		if long(data) = 1 then
			this.object.payfrequencyfactor[row] = 30
		elseif long(data) = 2 then
			this.object.payfrequencyfactor[row] = 15
		elseif long(data) = 3 then
			this.object.payfrequencyfactor[row] = 7
		elseif long(data) = 4 then
			this.object.payfrequencyfactor[row] = 1
		end if
		return parent.parent.parent.wf_update_salary(dwo.name, data, row)
	case "payfrequencyfactor"
		return parent.parent.parent.wf_update_salary(dwo.name, data, row)
	case "workinghours"
		return parent.parent.parent.wf_update_salary(dwo.name, data, row)
	case "workingweekdays"
		return parent.parent.parent.wf_update_salary(dwo.name, data, row)
	case "perhourrate"
		return parent.parent.parent.wf_update_salary(dwo.name, data, row)
	case "basicpay"
		return parent.parent.parent.wf_update_salary(dwo.name, data, row)
	end choose
	return ::message.returnvalue

// dw_pay.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_pay.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_deduction.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_deduction.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	parent.parent.parent.wf_update_salary("deduction", "a", 1)
	return ::message.returnvalue

// dw_deduction.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// dw_allowance.getfocus() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::getfocus()
	selecttext(1, len(gettext()))
	return ::message.returnvalue

// dw_allowance.editchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::editchanged(row, dwo, data)
	parent.parent.parent.wf_update_salary("allowances", "a", 1)
	return ::message.returnvalue

// dw_allowance.ue_enterkey() returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_enterkey()
	send(handle(this), 256, 9, long(90))
	return 1

// cb_ok.ue_enterkry(keycode key, unsignedlong keyflags) returns long [event]
	if key = keyenter! then
		triggerevent(clicked!)
	end if
	return 1

// cb_ok.clicked() returns long [event]
	string ls_aliasname
	string ls_empname
	long ll_newid
	long ll_row
	long ll_counter
	long ll_liccode
	long li_rc
	boolean lb_commitok
	ls_empname = parent.id_emp.object.emp_employee_fullname[1]
	if ls_empname = "" or isnull(ls_empname) or len(ls_empname) <= 0 then
		messagebox("Employee Name Validation", "Please enter valid Full Name of employee", stopsign!)
		return ::message.returnvalue
	end if
	ls_empname = parent.id_emp.object.accounts_name[1]
	if ls_empname = "" or isnull(ls_empname) or len(ls_empname) <= 0 then
		messagebox("Employee A/c Name Validation", "Please enter valid A/c Name of employee", stopsign!)
		return ::message.returnvalue
	elseif parent.wf_duplicate_accname(ls_empname) then
		messagebox("Employee A/c Name Validation", "Duplicate Salary A/c Name. Please enter valid Salary A/c Name of employee", stopsign!)
		return ::message.returnvalue
	end if
	ls_empname = parent.id_emp.object.accounts_aliasname[1]
	if ls_empname = "" or isnull(ls_empname) or len(ls_empname) <= 0 then
		messagebox("Employee Salary A/c Alias Name Validation", "Please enter valid Salary A/c Alias Name of employee", stopsign!)
		return ::message.returnvalue
	elseif parent.wf_duplicate_aliasname(ls_empname) then
		messagebox("Employee Advance A/c Alias Name Validation", "Duplicate Advance  A/c Alias Name. Please enter valid Alias Name", stopsign!)
		return ::message.returnvalue
	end if
	if parent.id_emp.object.openadvaccount[1] = "Y" then
		ls_empname = parent.id_emp.object.adv_name[1]
		if ls_empname = "" or isnull(ls_empname) or len(ls_empname) <= 0 then
			messagebox("Employee Advance A/c Name Validation", "Please enter valid Advance A/c Name of employee", stopsign!)
			return ::message.returnvalue
		elseif parent.wf_duplicate_adv_acc(ls_empname) then
			messagebox("Employee Advance A/c Name Validation", "Duplicate Advance  A/c Name. Please enter valid A/c Name of employee", stopsign!)
			return ::message.returnvalue
		end if
		ls_empname = parent.id_emp.object.adv_aliasname[1]
		if ls_empname = "" or isnull(ls_empname) or len(ls_empname) <= 0 then
			messagebox("Employee Advance A/c Name Validation", "Please enter valid Advance A/c Name of employee", stopsign!)
			return ::message.returnvalue
		elseif parent.wf_duplicate_adv_acc_alias(ls_empname) then
			messagebox("Employee Advance A/c Alias Name Validation", "Duplicate Advance  A/c Alias Name. Please enter valid Alias Name", stopsign!)
			return ::message.returnvalue
		end if
		if parent.id_emp.object.adv_subcode[1] = 0 or isnull(parent.id_emp.object.adv_subcode[1]) then
			parent.id_emp.object.adv_subcode[1] = 23
		end if
		if isnull(parent.id_emp.object.adv_subcode[1]) then
			parent.id_emp.object.adv_openingdate[1] = today()
		end if
		if isnull(parent.id_emp.object.adv_active[1]) then
			parent.id_emp.object.adv_active[1] = "Y"
		end if
		if isnull(parent.id_emp.object.adv_restricted[1]) then
			parent.id_emp.object.adv_restricted[1] = "Y"
		end if
		if isnull(parent.id_emp.object.adv_alertcode[1]) then
			parent.id_emp.object.adv_alertcode[1] = 1
		end if
	end if
	if f_validatedw(parent.id_emp) < 0 then
		parent.tab_main.selecttab(1)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_edu) < 0 then
		parent.tab_main.selecttab(2)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_cert) < 0 then
		parent.tab_main.selecttab(3)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_skill) < 0 then
		parent.tab_main.selecttab(4)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_jobexp) < 0 then
		parent.tab_main.selecttab(5)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_proj) < 0 then
		parent.tab_main.selecttab(6)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_ref) < 0 then
		parent.tab_main.selecttab(7)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_pay) < 0 then
		parent.tab_main.selecttab(8)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_payallowance) < 0 then
		parent.tab_main.selecttab(8)
		return ::message.returnvalue
	end if
	if f_validatedw(parent.id_paydeduction) < 0 then
		parent.tab_main.selecttab(8)
		return ::message.returnvalue
	end if
	if parent.wf_prepare_for_update() < 0 then
		return ::message.returnvalue
	end if
	if parent.dw_account.update() = 1 then
		if parent.dw_advance.update() = 1 then
			if parent.id_emp.update() = 1 then
				if parent.id_edu.update() = 1 then
					if parent.id_cert.update() = 1 then
						if parent.id_skill.update() = 1 then
							if parent.id_jobexp.update() = 1 then
								if parent.id_proj.update() = 1 then
									if parent.id_ref.update() = 1 then
										if parent.id_pay.update() = 1 then
											if parent.id_payallowance.update() = 1 then
												if parent.id_paydeduction.update() = 1 then
													SQL commit USING parent.it_transobject;
													if parent.wf_update_employee_picture() = 0 then
														setnull(parent.istr_emp_pic.lb_blob)
													end if
													if parent.ib_uploadimage and parent.wf_update_image() = 0 then
														parent.id_image.reset()
														parent.istr_image = parent.istr_blank_image
													end if
													lb_commitok = true
													parent.event ue_close()
													return ::message.returnvalue
												else
													messagebox("Employee Deduction Update Problem", "Unable to update Employee Pay Deduction Information" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
													SQL rollback USING parent.it_transobject;
												end if
											else
												messagebox("Employee Pay Allowances Update Problem", "Unable to update Employee Pay Allowances Information" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
												SQL rollback USING parent.it_transobject;
											end if
										else
											messagebox("Employee Pay Update Problem", "Unable to update Employee Pay Information" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
											SQL rollback USING parent.it_transobject;
										end if
									else
										messagebox("Employee References Update Problem", "Unable to update Employee References Information" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
										SQL rollback USING parent.it_transobject;
									end if
								else
									messagebox("Employee Project Update Problem", "Unable to update Employee Project Experience Information" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
									SQL rollback USING parent.it_transobject;
								end if
							else
								messagebox("Employee Job Experience Update Problem", "Unable to update Employee Job Experience Information" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
								SQL rollback USING parent.it_transobject;
							end if
						else
							messagebox("Employee Skill Update Problem", "Unable to update Employee Skill Information" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
							SQL rollback USING parent.it_transobject;
						end if
					else
						messagebox("Employee Certification Update Problem", "Unable to update Employee Certification Information" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
						SQL rollback USING parent.it_transobject;
					end if
				else
					messagebox("Employee Education Update Problem", "Unable to update Employee Education Information" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
					SQL rollback USING parent.it_transobject;
				end if
			else
				messagebox("Employee Update Problem", "Unable to update Employee Information" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
				SQL rollback USING parent.it_transobject;
			end if
		else
			messagebox("Advance Account Update Problem", "Unable to update Employee Advance Account Information" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
			SQL rollback USING parent.it_transobject;
		end if
	else
		messagebox("Account Update Problem", "Unable to update Employee Account Information" + "~r~nDetails Are:- " + parent.it_transobject.sqlerrtext, stopsign!)
		SQL rollback USING parent.it_transobject;
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long [event]
	parent.postevent("ue_close")
	return ::message.returnvalue
