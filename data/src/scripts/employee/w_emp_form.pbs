// dw_emp.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	if key = keyf8! and parent.parent.parent.ib_viewimage then
		parent.parent.parent.wf_show_employee_gallery()
	end if
	if key = keyf9! and parent.parent.parent.ib_uploadimage then
		parent.parent.parent.wf_setimage("EMP")
	end if
	return ::message.returnvalue

// dw_emp.itemchanged(long row, dwobject dwo, string data) returns long [event]
	long ancestorreturnvalue
	long ll_retcode
	ancestorreturnvalue = super::itemchanged(row, dwo, data)
	choose case dwo.name
	case "emp_employee_fullname"
		if len(data) > 0 then
			if this.object.code[row] <= 0 then
				this.object.accounts_name[row] = left(data, 50) + " (SALARY)"
				this.object.adv_name[row] = left(data, 50) + " (ADVANCE)"
				this.object.adv_subcode[row] = 23
				this.object.adv_openingdate[row] = today()
				this.object.adv_active[row] = "Y"
				this.object.adv_restricted[row] = "Y"
				this.object.adv_alertcode[row] = 1
			end if
		end if
	case "emp_employee_empid"
		if parent.parent.parent.wf_duplicate_empid(data) then
			messagebox("Employee ID Validation", "Employee ID Duplication Error~r~nPlease enter some other Employee ID")
			return 1
		elseif this.object.code[row] <= 0 then
			this.object.accounts_aliasname[row] = left("SAL-" + data, 12)
			this.object.adv_aliasname[row] = left("ADV-" + data, 12)
		end if
	case "accounts_aliasname"
		if parent.parent.parent.wf_duplicate_aliasname(data) then
			messagebox("Alias Name Validation", "Account Alias Name Duplication Error~r~nPlease enter some other Alias Name")
			return 1
		end if
	case "accounts_name"
		if parent.parent.parent.wf_duplicate_accname(data) then
			messagebox("Name Validation", "Duplication Name Error~n~rPlease Choose Some Other Name")
			return 1
		end if
	case "openadvaccount"
		if upper(data) = "Y" then
			this.object.adv_name[row] = left(this.object.emp_employee_fullname[row], 50) + " (ADVANCE)"
			this.object.adv_aliasname[row] = left("ADV-" + this.object.emp_employee_empid[row], 12)
			this.object.adv_subcode[row] = 23
			this.object.adv_openingdate[row] = today()
			this.object.adv_active[row] = "Y"
			this.object.adv_restricted[row] = "Y"
			this.object.adv_alertcode[row] = 1
		end if
	case "adv_aliasname"
		if parent.parent.parent.wf_duplicate_aliasname(data) then
			messagebox("Alias Name Validation", "Account Alias Name Duplication Error~r~nPlease enter some other Alias Name")
			return 1
		end if
	case "adv_name"
		if parent.parent.parent.wf_duplicate_accname(data) then
			messagebox("Name Validation", "Duplication Name Error~n~rPlease Choose Some Other Name")
			return 1
		end if
	case "transportroutecode"
		if long(data) > 0 then
			ll_retcode = parent.parent.parent.wf_validate_transportroutecode(long(data))
			return ll_retcode
		end if
	end choose
	return ::message.returnvalue

// dw_emp.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ancestorreturnvalue
	ancestorreturnvalue = super::clicked(xpos, ypos, row, dwo)
