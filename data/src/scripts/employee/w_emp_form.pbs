// tab_main.selectionchanged(integer oldindex, integer newindex) returns long [event]
	if newindex = 1 then
		parent.id_emp.setfocus()
		if parent.id_emp.rowcount() = 0 then
			parent.wf_insert_row(parent.id_emp, 0)
		end if
	elseif newindex = 2 then
		parent.id_edu.setfocus()
		if parent.id_edu.rowcount() = 0 then
			parent.wf_insert_row(parent.id_edu, 0)
		end if
	elseif newindex = 3 then
		parent.id_cert.setfocus()
		if parent.id_cert.rowcount() = 0 then
			parent.wf_insert_row(parent.id_cert, 0)
		end if
	elseif newindex = 4 then
		parent.id_skill.setfocus()
		if parent.id_skill.rowcount() = 0 then
			parent.wf_insert_row(parent.id_skill, 0)
		end if
	elseif newindex = 5 then
		parent.id_jobexp.setfocus()
		if parent.id_jobexp.rowcount() = 0 then
			parent.wf_insert_row(parent.id_jobexp, 0)
		end if
	elseif newindex = 6 then
		parent.id_proj.setfocus()
		if parent.id_proj.rowcount() = 0 then
			parent.wf_insert_row(parent.id_proj, 0)
		end if
	elseif newindex = 7 then
		parent.id_ref.setfocus()
		if parent.id_ref.rowcount() = 0 then
			parent.wf_insert_row(parent.id_ref, 0)
		end if
	elseif newindex = 8 then
		parent.id_pay.setfocus()
		if parent.id_pay.rowcount() = 0 then
			parent.wf_insert_row(parent.id_pay, 0)
		end if
		if parent.id_payallowance.rowcount() = 0 then
			parent.wf_populate_allowances()
		end if
		if parent.id_paydeduction.rowcount() = 0 then
			parent.wf_populate_deductions()
		end if
		parent.wf_update_salary("abcdef", "a", 1)
	end if
	return ::message.returnvalue

