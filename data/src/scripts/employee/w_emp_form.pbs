// w_emp_form.wf_connect() returns long
	SQL start USING this.it_transobject;
	return this.it_transobject.sqlcode

// w_emp_form.wf_tabnewid(string as_tablename, long al_newid) returns long
	long ll_rtcode
	SQL SELECT TABMAXKEY INTO :al_newid FROM _TABMAXKEY WITH ( UPDLOCK HOLDLOCK ) WHERE _TABMAXKEY.TABName =:as_tablename USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		al_newid = al_newid + 1
		SQL update dbo._tabmaxkey SET TABMAXKEY =:al_newid WHERE _TABMAXKEY.TABName =:as_tablename USING this.it_transobject;
		if this.it_transobject.sqlcode < 0 then
			ll_rtcode = this.it_transobject.sqlcode
			al_newid = 0
		end if
	else
		ll_rtcode = this.it_transobject.sqlcode
		al_newid = 0
	end if
	return ll_rtcode

// w_emp_form.wf_retrieve_tabs() returns long
	long ll_retcode
	this.id_image = this.dw_image
	this.id_image.settransobject(this.it_transobject)
	if this.il_code > 0 and this.ib_uploadimage then
		this.id_image.retrieve(this.il_code)
		wf_populate_image()
	end if
	this.dw_account.settransobject(this.it_transobject)
	this.dw_advance.settransobject(this.it_transobject)
	this.id_emp = this.tab_main.tabpage_emp.dw_emp
	this.id_emp.settransobject(this.it_transobject)
	ll_retcode = this.id_emp.getchild("vehiclecode", this.idc_vehicle)
	if ll_retcode = -1 then
		messagebox("datawindow child error", "can not get data window child for vehicle list", stopsign!)
		close(this)
		return 0
	end if
	this.idc_vehicle.settransobject(this.it_transobject)
	this.idc_vehicle.retrieve(1)
	if this.il_code > 0 then
		this.id_emp.retrieve(this.il_code)
		if this.id_emp.rowcount() > 0 then
			if this.id_emp.object.transportroutecode[1] > 0 then
				this.idc_vehicle.retrieve(this.id_emp.object.transportroutecode[1])
			else
				this.idc_vehicle.retrieve(1)
			end if
		end if
		wf_get_employee_picture()
	end if
	this.id_edu = this.tab_main.tabpage_edu.dw_edu
	this.id_edu.settransobject(this.it_transobject)
	if this.il_code > 0 then
		this.id_edu.retrieve(this.il_code)
	end if
	this.id_cert = this.tab_main.tabpage_cert.dw_cert
	this.id_cert.settransobject(this.it_transobject)
	if this.il_code > 0 then
		this.id_cert.retrieve(this.il_code)
	end if
	this.id_skill = this.tab_main.tabpage_skill.dw_skill
	this.id_skill.settransobject(this.it_transobject)
	if this.il_code > 0 then
		this.id_skill.retrieve(this.il_code)
	end if
	this.id_jobexp = this.tab_main.tabpage_jobexp.dw_jobexp
	this.id_jobexp.settransobject(this.it_transobject)
	if this.il_code > 0 then
		this.id_jobexp.retrieve(this.il_code)
	end if
	this.id_proj = this.tab_main.tabpage_proj.dw_proj
	this.id_proj.settransobject(this.it_transobject)
	if this.il_code > 0 then
		this.id_proj.retrieve(this.il_code)
	end if
	this.id_ref = this.tab_main.tabpage_ref.dw_ref
	this.id_ref.settransobject(this.it_transobject)
	if this.il_code > 0 then
		this.id_ref.retrieve(this.il_code)
	end if
	this.id_pay = this.tab_main.tabpage_pay.dw_pay
	this.id_pay.settransobject(this.it_transobject)
	if this.il_code > 0 then
		this.id_pay.retrieve(this.il_code)
	end if
	this.id_payallowance = this.tab_main.tabpage_pay.dw_allowance
	this.id_payallowance.settransobject(this.it_transobject)
	if this.il_code > 0 then
		this.id_payallowance.retrieve(this.il_code)
		wf_adjust_allowances()
	end if
	this.id_paydeduction = this.tab_main.tabpage_pay.dw_deduction
	this.id_paydeduction.settransobject(this.it_transobject)
	if this.il_code > 0 then
		this.id_paydeduction.retrieve(this.il_code)
		wf_adjust_deductions()
	end if
	return 0

// w_emp_form.wf_insert_row(datawindow adw_dw, integer ai_askpermit) returns long
	long ll_row
	long ll_res = 2
	if ai_askpermit = 1 then
		ll_res = messagebox("Insert New Record", "Do you want to Insert New Record?", question!, yesnocancel!, 2)
	else
		ll_res = 1
	end if
	if ll_res = 1 then
		ll_row = adw_dw.insertrow(0)
		adw_dw.object.code[ll_row] = this.il_code
		adw_dw.setrow(ll_row)
		adw_dw.scrolltorow(ll_row)
	end if
	return 0

// w_emp_form.wf_delete_row(datawindow adw_dw, integer ai_askpermit) returns long
	long ll_row
	long ll_res = 2
	if adw_dw.rowcount() > 0 and adw_dw.getrow() > 0 then
		if ai_askpermit = 1 then
			ll_res = messagebox("Delete Record", "Do you want to delete this record?", question!, yesnocancel!, 2)
		else
			ll_res = 1
		end if
		if ll_res = 1 then
			ll_row = adw_dw.getrow()
			if adw_dw.deleterow(ll_row) = 1 and adw_dw.rowcount() > 0 then
				adw_dw.setrow(1)
				adw_dw.scrolltorow(1)
			end if
		end if
	end if
	return 0

// w_emp_form.wf_goto_record(datawindow adw_dw) returns long
	long ll_current
	long ll_counter
	long ll_row
	datastore lds_ds
	s_arguements lstr_arg
	ll_current = adw_dw.getrow()
	if adw_dw.rowcount() > 0 then
		lds_ds = create datastore
		lds_ds.dataobject = "d_emp_recordpointer"
		lds_ds.settransobject(sqlca)
		for ll_counter = 1 to adw_dw.rowcount()
			ll_row = lds_ds.insertrow(0)
			if ll_row = ll_current then
				lds_ds.object.currentrow[ll_row] = 1
			else
				lds_ds.object.currentrow[ll_row] = 0
			end if
			lds_ds.object.rowid[ll_row] = adw_dw.object.rowid[ll_counter]
			lds_ds.object.rowno[ll_row] = ll_counter
		next
		if lds_ds.rowcount() > 0 then
			openwithparm(w_arg_emp_record_pointer, lds_ds)
			lstr_arg = message.powerobjectparm
			if lstr_arg.i_status = 1 and lstr_arg.l_code1 > 0 then
				adw_dw.setrow(lstr_arg.l_code1)
				adw_dw.scrolltorow(lstr_arg.l_code1)
			end if
		end if
	end if
	return 0

// w_emp_form.wf_protectdw(datawindow ad_dwcontrol, integer ai_doundo) returns integer
	integer li_colcount
	integer li_counter
	integer li_start = 1
	integer li_temp
	string ls_colname
	string ls_rtnstring
	li_colcount = integer(ad_dwcontrol.object.datawindow.column.count)
	for li_counter = li_colcount to li_start step -1
		ls_colname = ad_dwcontrol.describe("#" + string(li_counter) + ".Name")
		if ai_doundo = 1 then
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=1")
		else
			ls_rtnstring = ad_dwcontrol.modify(ls_colname + ".Protect=0")
		end if
	next
	return 0

// w_emp_form.wf_apply_protect_setting() returns integer
	return 0

// w_emp_form.wf_save() returns long
	this.cb_ok.triggerevent(clicked!)
	return 0

// w_emp_form.wf_print() returns long
	wf_save()
	return 0

