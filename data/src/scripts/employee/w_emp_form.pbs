	if this.tab_main.tabpage_emp.visible = true then
		this.tab_main.selecttab(1)
		return 0
	end if
	if this.tab_main.tabpage_edu.visible = true then
		this.tab_main.selecttab(2)
		return 0
	end if
	if this.tab_main.tabpage_cert.visible = true then
		this.tab_main.selecttab(3)
		return 0
	end if
	if this.tab_main.tabpage_skill.visible = true then
		this.tab_main.selecttab(4)
		return 0
	end if
	if this.tab_main.tabpage_jobexp.visible = true then
		this.tab_main.selecttab(5)
		return 0
	end if
	if this.tab_main.tabpage_proj.visible = true then
		this.tab_main.selecttab(6)
		return 0
	end if
	if this.tab_main.tabpage_ref.visible = true then
		this.tab_main.selecttab(7)
		return 0
	end if
	if this.tab_main.tabpage_pay.visible = true then
		this.tab_main.selecttab(8)
		return 0
	end if
	return 0

// w_emp_form.wf_get_image(long al_row) returns long
	blob lbl_image
	u_transaction lt_transobject
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server")
		destroy lt_transobject
		return -1
	end if
	SQL SelectBlob Image INTO :lbl_image From EMP_Image Where empcode =:this.il_code AND RowID =:al_row USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Employee Image/Picture ", "Unable to fetch Employee Image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	this.istr_image.blob[al_row] = lbl_image
	return 0

// w_emp_form.wf_populate_image() returns long
	long ll_counter
	long ll_rowcount
	long ll_code
	ll_rowcount = this.id_image.rowcount()
	if ll_rowcount <= 0 then
		return 0
	end if
	ll_code = this.id_image.object.code[1]
	for ll_counter = 1 to ll_rowcount
		this.istr_image.ls_value[ll_counter, 1] = trim(string(this.id_image.object.rowid[ll_counter]))
		this.istr_image.ls_value[ll_counter, 2] = this.id_image.object.imagedescription[ll_counter]
		this.istr_image.ls_value[ll_counter, 3] = this.id_image.object.imagetype[ll_counter]
		wf_get_image(ll_counter)
	next
	return 0

// w_emp_form.wf_update_image() returns long
	long ll_counter
	long ll_code
	long ll_rowid
	string ls_desc
	string ls_imgtype
	u_transaction lt_transobject
	ll_code = this.il_code
	if ll_code > 0 and this.id_image.rowcount() = 0 then
		return 0
	end if
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server for updating/inserting in PatientImage Table")
		destroy lt_transobject
		return -1
	end if
	SQL DELETE EMP_Image WHERE EmpCode =:this.il_code USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to Delete Previous Employee Image Record from database")
		destroy lt_transobject
		return -1
	end if
	for ll_counter = 1 to this.id_image.rowcount()
		ll_rowid = this.id_image.object.rowid[ll_counter]
		ls_desc = this.id_image.object.imagedescription[ll_counter]
		ls_imgtype = this.id_image.object.imagetype[ll_counter]
		SQL INSERT INTO EMP_Image ( Empcode , ImageDescription , RowID , ImageType ) VALUES ( :ll_code , :ls_desc , :ll_rowid , :ls_imgtype ) USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Insert Error", "Unable to Insert Employee Images Into Patient Image Table.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
			SQL stop USING lt_transobject;
			destroy lt_transobject
			return -1
		end if
		SQL UpdateBlob EMP_Image Set Image =:this.istr_image.blob[ll_counter] Where EMPCode =:ll_code and ROWID =:ll_rowid USING lt_transobject;
		if lt_transobject.sqlcode <> 0 then
			messagebox("Employee Image ", "Unable to update Employee image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
		end if
	next
	SQL stop USING lt_transobject;
	destroy lt_transobject
	return 0

// w_emp_form.wf_setimage(string as_caller) returns long
	long ll_counter
	long ll_code
	long ll_row
	s_itemimage lstr_image
	lstr_image.s_caller = as_caller
	for ll_counter = 1 to this.id_image.rowcount()
		lstr_image.ls_value[ll_counter, 1] = trim(string(this.id_image.object.rowid[ll_counter]))
		lstr_image.ls_value[ll_counter, 2] = this.id_image.object.imagedescription[ll_counter]
		lstr_image.ls_value[ll_counter, 3] = this.id_image.object.imagetype[ll_counter]
		lstr_image.blob[ll_counter] = this.istr_image.blob[ll_counter]
	next
	openwithparm(w_employeeimage, lstr_image)
	lstr_image = message.powerobjectparm
	if lstr_image.i_closemode = 1 then
		this.istr_image = lstr_image
		this.id_image.reset()
		ll_code = this.il_code
		for ll_counter = 1 to 200
			if long(lstr_image.ls_value[ll_counter, 1]) > 0 then
				ll_row = this.id_image.insertrow(0)
				this.id_image.object.code[ll_row] = ll_code
				this.id_image.object.rowid[ll_row] = long(lstr_image.ls_value[ll_counter, 1])
				this.id_image.object.imagedescription[ll_row] = lstr_image.ls_value[ll_counter, 2]
				this.id_image.object.imagetype[ll_row] = lstr_image.ls_value[ll_counter, 3]
			end if
		next
	end if
	return 0

// w_emp_form.wf_get_emp_info(long al_code) returns long
	long ll_empcode
	string ls_empid
	string ls_empname
	string ls_fname
	string ls_gender
	SQL SELECT EmpCode , EMPID , FullName , Gender INTO :ll_empcode, :ls_empid, :ls_empname, :ls_gender FROM EMP_Employee WHERE EmpCode =:al_code USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		this.il_code = ll_empcode
		this.is_empid = ls_empid
		this.is_empname = ls_empname
		this.is_gender = ls_gender
		return 0
	end if
	return -1

// w_emp_form.wf_duplicate_accname(string as_accname) returns boolean
	long ll_count
	long ll_acccode
	boolean b_flag
	as_accname = trim(as_accname)
	if this.id_emp.rowcount() <= 0 then
		return b_flag
	end if
	ll_acccode = this.id_emp.object.emp_employee_acccode[1]
	if ll_acccode > 0 then
		SQL SELECT count ( *) INTO :ll_count FROM Accounts WHERE Accounts.name =:as_accname AND Accounts.AccCode <> :ll_acccode USING this.it_transobject;
	else
		SQL SELECT count ( *) INTO :ll_count FROM Accounts WHERE Accounts.name =:as_accname USING this.it_transobject;
	end if
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_emp_form.wf_duplicate_aliasname(string as_aliasname) returns boolean
	long ll_count
	long ll_acccode
	boolean b_flag
	as_aliasname = trim(as_aliasname)
	if this.id_emp.rowcount() <= 0 then
		return b_flag
	end if
	ll_acccode = this.id_emp.object.emp_employee_acccode[1]
	if ll_acccode > 0 then
		SQL SELECT count ( *) INTO :ll_count FROM Accounts WHERE Accounts.aliasname =:as_aliasname AND Accounts.AccCode <> :ll_acccode USING this.it_transobject;
	else
		SQL SELECT count ( *) INTO :ll_count FROM Accounts WHERE Accounts.aliasname =:as_aliasname USING this.it_transobject;
	end if
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_emp_form.wf_duplicate_empid(string as_empid) returns boolean
	long ll_count
	long ll_code
	boolean b_flag
	as_empid = trim(as_empid)
	if this.id_emp.rowcount() <= 0 then
		return b_flag
	end if
	ll_code = this.id_emp.object.code[1]
	if ll_code > 0 then
		SQL SELECT count ( *) INTO :ll_count FROM EMP_Employee WHERE EMPID =:as_empid AND EmpCode <> :ll_code USING this.it_transobject;
	else
		SQL SELECT count ( *) INTO :ll_count FROM EMP_Employee WHERE EMPID =:as_empid USING this.it_transobject;
	end if
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_emp_form.wf_prepare_for_update() returns long
	long ll_code
	long ll_acccode
	long ll_adv_acccode
	long ll_row
	long ll_counter
	this.dw_account.reset()
	this.dw_advance.reset()
	ll_acccode = this.id_emp.object.accounts_acccode[1]
	ll_adv_acccode = this.id_emp.object.emp_employee_advacccode[1]
	ll_code = this.id_emp.object.code[1]
	if ll_acccode > 0 then
		ll_row = this.dw_account.retrieve(ll_acccode)
		ll_row = this.dw_account.rowcount()
	else
		wf_tabnewid("accounts", ll_acccode)
		ll_row = this.dw_account.insertrow(0)
	end if
	this.id_emp.object.emp_employee_acccode[1] = ll_acccode
	this.dw_account.object.code[1] = ll_acccode
	this.dw_account.object.aliasname[ll_row] = this.id_emp.object.accounts_aliasname[1]
	this.dw_account.object.subcode[ll_row] = this.id_emp.object.accounts_subcode[1]
	this.dw_account.object.name[ll_row] = this.id_emp.object.accounts_name[1]
	this.dw_account.object.openingdate[ll_row] = this.id_emp.object.accounts_openingdate[1]
	this.dw_account.object.active[ll_row] = this.id_emp.object.accounts_active[1]
	this.dw_account.object.restricted[ll_row] = this.id_emp.object.accounts_restricted[1]
	this.dw_account.object.balancelimit[ll_row] = this.id_emp.object.accounts_balancelimit[1]
	this.dw_account.object.remarks[ll_row] = this.id_emp.object.accounts_remarks[1]
	this.dw_account.object.alertcode[ll_row] = this.id_emp.object.accounts_alertcode[1]
	if this.id_emp.object.openadvaccount[1] = "Y" then
		if ll_adv_acccode > 0 then
			ll_row = this.dw_advance.retrieve(ll_adv_acccode)
			ll_row = this.dw_advance.rowcount()
		else
			wf_tabnewid("accounts", ll_adv_acccode)
			ll_row = this.dw_advance.insertrow(0)
		end if
		this.id_emp.object.emp_employee_advacccode[1] = ll_adv_acccode
		this.dw_advance.object.code[1] = ll_adv_acccode
		this.dw_advance.object.aliasname[ll_row] = this.id_emp.object.adv_aliasname[1]
		this.dw_advance.object.subcode[ll_row] = this.id_emp.object.adv_subcode[1]
		this.dw_advance.object.name[ll_row] = this.id_emp.object.adv_name[1]
		this.dw_advance.object.openingdate[ll_row] = this.id_emp.object.adv_openingdate[1]
		this.dw_advance.object.active[ll_row] = this.id_emp.object.adv_active[1]
		this.dw_advance.object.restricted[ll_row] = this.id_emp.object.adv_restricted[1]
		this.dw_advance.object.balancelimit[ll_row] = this.id_emp.object.adv_balancelimit[1]
		this.dw_advance.object.remarks[ll_row] = this.id_emp.object.adv_remarks[1]
		this.dw_advance.object.alertcode[ll_row] = this.id_emp.object.adv_alertcode[1]
	end if
	if ll_code > 0 then
		ll_row = this.id_emp.rowcount()
	else
		wf_tabnewid("emp_employee", ll_code)
		this.id_emp.object.code[1] = ll_code
	end if
	for ll_counter = 1 to this.id_edu.rowcount()
		this.id_edu.object.code[ll_counter] = ll_code
	next
	for ll_counter = 1 to this.id_cert.rowcount()
		this.id_cert.object.code[ll_counter] = ll_code
	next
	for ll_counter = 1 to this.id_skill.rowcount()
		this.id_skill.object.code[ll_counter] = ll_code
	next
	for ll_counter = 1 to this.id_jobexp.rowcount()
		this.id_jobexp.object.code[ll_counter] = ll_code
	next
	for ll_counter = 1 to this.id_proj.rowcount()
		this.id_proj.object.code[ll_counter] = ll_code
	next
	for ll_counter = 1 to this.id_ref.rowcount()
		this.id_ref.object.code[ll_counter] = ll_code
	next
	for ll_counter = 1 to this.id_pay.rowcount()
		this.id_pay.object.code[ll_counter] = ll_code
	next
	for ll_counter = 1 to this.id_payallowance.rowcount()
		this.id_payallowance.object.code[ll_counter] = ll_code
	next
	for ll_counter = 1 to this.id_paydeduction.rowcount()
		this.id_paydeduction.object.code[ll_counter] = ll_code
	next
	return 0

// w_emp_form.wf_set_employee_picture() returns 0
	long fh
	long ret
	long ll_fbytes
	string ls_file
	string ls_filename
	string ls_defaultext = "JPEG"
	string ls_temp
	string ls_filefilter = "JPEG Files (*.jpg),*.jpg, Bitmap Files (*.bmp),*.bmp, GIF Files (*.gif),*.gif"
	ls_temp = gs_temp_directory
	ls_file = left(ls_temp, len(ls_temp) - pos(reverse(ls_temp), "\") + 1)
	ls_filename = mid(ls_temp, len(ls_temp) - pos(reverse(ls_temp), "\") + 2)
	ret = getfileopenname("Select File", ls_file, ls_filename, ls_defaultext, ls_filefilter, ls_temp)
	if ret = 1 then
		this.id_emp.object.p_photo.filename = ls_file
		fh = fileopen(ls_file, streammode!, read!, lockread!)
		if fh <> -1 then
			ll_fbytes = filereadex(fh, this.istr_emp_pic.lb_blob)
			fileclose(fh)
			this.istr_emp_pic.s_name = right(ls_file, 3)
		end if
	end if

// w_emp_form.wf_get_employee_picture() returns long
	blob lbl_image
	string ls_imagetype
	u_transaction lt_transobject
	ls_imagetype = "jpg"
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server")
		destroy lt_transobject
		return -1
	end if
	SQL SelectBlob Picture INTO :lbl_image From EMP_Employee Where EmpCode =:this.il_code USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		return 1
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	this.istr_emp_pic.lb_blob = lbl_image
	this.istr_emp_pic.s_name = ls_imagetype
	this.is_filename = gs_temp_img_filename
	this.is_filename = left(this.is_filename, len(this.is_filename) - 4)
	this.is_filename = this.is_filename + "." + ls_imagetype
	f_writeimgtofile(this.is_filename, lbl_image)
	this.id_emp.object.p_photo.filename = this.is_filename
	return 0

// w_emp_form.wf_update_employee_picture() returns integer
	long ll_counter
	long ll_code
	long ll_rowid
	string ls_desc
	string ls_imgtype
	u_transaction lt_transobject
	ll_code = this.id_emp.object.code[1]
	if ll_code <= 0 then
		return 0
	end if
	lt_transobject = create u_transaction
	lt_transobject.autocommit = true
	SQL start USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Connection Error", "Unable to connect to DataBase server for updating/inserting in Employee Image Table")
		destroy lt_transobject
		return -1
	end if
	SQL UpdateBlob EMP_Employee Set Picture =:this.istr_emp_pic.lb_blob Where EMPCode =:ll_code USING lt_transobject;
	if lt_transobject.sqlcode <> 0 then
		messagebox("Employee Image ", "Unable to update Employee image.~r~nReasons are:~r~n" + lt_transobject.sqlerrtext)
	end if
	SQL stop USING lt_transobject;
	destroy lt_transobject
	return 0

// w_emp_form.wf_show_employee_gallery() returns long
	if this.il_code > 0 then
		openwithparm(w_employeegallary, this.il_code)
	end if
	return 0

// w_emp_form.wf_populate_allowances() returns long
	long ll_counter
	long ll_row
	datastore lds_allowance
	lds_allowance = create datastore
	lds_allowance.dataobject = "d_emp_allowances_list"
	lds_allowance.settransobject(this.it_transobject)
	lds_allowance.retrieve()
	if lds_allowance.rowcount() > 0 then
		for ll_counter = 1 to lds_allowance.rowcount()
			ll_row = this.id_payallowance.insertrow(0)
			this.id_payallowance.object.code[ll_counter] = this.il_code
			this.id_payallowance.object.allowancecode[ll_row] = lds_allowance.object.code[ll_counter]
			this.id_payallowance.object.basicpay[ll_row] = this.id_pay.object.basicpay[1]
			this.id_payallowance.object.attendancewise[ll_row] = lds_allowance.object.attendancewise[ll_counter]
			this.id_payallowance.object.percentage[ll_row] = lds_allowance.object.percentage[ll_counter]
			this.id_payallowance.object.flatamount[ll_row] = lds_allowance.object.flatamount[ll_counter]
		next
		return 0
	end if
	return 0

// w_emp_form.wf_populate_deductions() returns long
	long ll_counter
	long ll_row
	datastore lds_deduction
	lds_deduction = create datastore
	lds_deduction.dataobject = "d_emp_deduction_list"
	lds_deduction.settransobject(this.it_transobject)
	lds_deduction.retrieve()
	if lds_deduction.rowcount() > 0 then
		for ll_counter = 1 to lds_deduction.rowcount()
			ll_row = this.id_paydeduction.insertrow(0)
			this.id_paydeduction.object.code[ll_counter] = this.il_code
			this.id_paydeduction.object.deductioncode[ll_row] = lds_deduction.object.code[ll_counter]
			this.id_paydeduction.object.basicpay[ll_row] = this.id_pay.object.basicpay[1]
			this.id_paydeduction.object.percentage[ll_row] = lds_deduction.object.emp_deduction_percentage[ll_counter]
			this.id_paydeduction.object.flatamount[ll_row] = lds_deduction.object.emp_deduction_flatamount[ll_counter]
		next
		return 0
	end if
	return 0

// w_emp_form.wf_update_salary(string as_col, string data, long row) returns long
	long ll_retcode
	long ll_counter
	double ld_allowances
	double ld_deductions
	choose case as_col
	case "paytype"
		if double(data) > 0.0 then
			if this.id_pay.object.payfrequency[row] = 1 then
				if long(data) = 1 then
					this.id_pay.object.basicpay[row] = this.id_pay.object.workinghours[row] * this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				else
					this.id_pay.object.basicpay[row] = this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				end if
			elseif this.id_pay.object.payfrequency[row] = 2 then
				if long(data) = 1 then
					this.id_pay.object.basicpay[row] = this.id_pay.object.workinghours[row] * this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				else
					this.id_pay.object.basicpay[row] = this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				end if
			elseif this.id_pay.object.payfrequency[row] = 3 then
				if long(data) = 1 then
					this.id_pay.object.basicpay[row] = this.id_pay.object.workinghours[row] * this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				else
					this.id_pay.object.basicpay[row] = this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				end if
			elseif this.id_pay.object.payfrequency[row] = 4 then
				if long(data) = 1 then
					this.id_pay.object.basicpay[row] = this.id_pay.object.workinghours[row] * this.id_pay.object.perhourrate[row]
				else
					this.id_pay.object.basicpay[row] = this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				end if
			end if
			ll_retcode = 0
			for ll_counter = 1 to this.id_payallowance.rowcount()
				this.id_payallowance.object.basicpay[ll_counter] = this.id_pay.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_paydeduction.rowcount()
				this.id_paydeduction.object.basicpay[ll_counter] = this.id_pay.object.basicpay[row]
			next
		else
			ll_retcode = 1
		end if
	case "payfrequency"
		if double(data) > 0.0 then
			if long(data) = 1 then
				if this.id_pay.object.paytype[row] = 1 then
					this.id_pay.object.basicpay[row] = this.id_pay.object.workinghours[row] * this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				else
					this.id_pay.object.basicpay[row] = this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				end if
			elseif long(data) = 2 then
				if this.id_pay.object.paytype[row] = 1 then
					this.id_pay.object.basicpay[row] = this.id_pay.object.workinghours[row] * this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				else
					this.id_pay.object.basicpay[row] = this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				end if
			elseif long(data) = 3 then
				if this.id_pay.object.paytype[row] = 1 then
					this.id_pay.object.basicpay[row] = this.id_pay.object.workinghours[row] * this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				else
					this.id_pay.object.basicpay[row] = this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				end if
			elseif long(data) = 4 then
				if this.id_pay.object.paytype[row] = 1 then
					this.id_pay.object.basicpay[row] = this.id_pay.object.workinghours[row] * this.id_pay.object.perhourrate[row]
				else
					this.id_pay.object.basicpay[row] = this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				end if
			end if
			ll_retcode = 0
			for ll_counter = 1 to this.id_payallowance.rowcount()
				this.id_payallowance.object.basicpay[ll_counter] = this.id_pay.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_paydeduction.rowcount()
				this.id_paydeduction.object.basicpay[ll_counter] = this.id_pay.object.basicpay[row]
			next
		else
			ll_retcode = 1
		end if
	case "payfrequencyfactor"
		if double(data) > 0.0 then
			if this.id_pay.object.paytype[row] = 1 then
				this.id_pay.object.basicpay[row] = this.id_pay.object.workinghours[row] * long(data) * this.id_pay.object.perhourrate[row]
			else
				this.id_pay.object.basicpay[row] = long(data) * this.id_pay.object.perhourrate[row]
			end if
			ll_retcode = 0
			for ll_counter = 1 to this.id_payallowance.rowcount()
				this.id_payallowance.object.basicpay[ll_counter] = this.id_pay.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_paydeduction.rowcount()
				this.id_paydeduction.object.basicpay[ll_counter] = this.id_pay.object.basicpay[row]
			next
		else
			ll_retcode = 1
		end if
	case "workinghours"
		if double(data) >= 0.0 then
			if this.id_pay.object.payfrequency[row] = 1 then
				if this.id_pay.object.paytype[row] = 1 then
					this.id_pay.object.basicpay[row] = long(data) * this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				else
					this.id_pay.object.basicpay[row] = this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				end if
			elseif this.id_pay.object.payfrequency[row] = 2 then
				if this.id_pay.object.paytype[row] = 1 then
					this.id_pay.object.basicpay[row] = long(data) * this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				else
					this.id_pay.object.basicpay[row] = this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				end if
			elseif this.id_pay.object.payfrequency[row] = 3 then
				if this.id_pay.object.paytype[row] = 1 then
					this.id_pay.object.basicpay[row] = long(data) * this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				else
					this.id_pay.object.basicpay[row] = this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				end if
			elseif this.id_pay.object.payfrequency[row] = 4 then
				if this.id_pay.object.paytype[row] = 1 then
					this.id_pay.object.basicpay[row] = long(data) * this.id_pay.object.perhourrate[row]
				else
					this.id_pay.object.basicpay[row] = this.id_pay.object.payfrequencyfactor[row] * this.id_pay.object.perhourrate[row]
				end if
			end if
			ll_retcode = 0
			for ll_counter = 1 to this.id_payallowance.rowcount()
				this.id_payallowance.object.basicpay[ll_counter] = this.id_pay.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_paydeduction.rowcount()
				this.id_paydeduction.object.basicpay[ll_counter] = this.id_pay.object.basicpay[row]
			next
		else
			ll_retcode = 1
		end if
	case "perhourrate"
		if double(data) >= 0.0 then
			if this.id_pay.object.payfrequency[row] = 1 then
				if this.id_pay.object.paytype[row] = 1 then
					this.id_pay.object.basicpay[row] = this.id_pay.object.workinghours[row] * this.id_pay.object.payfrequencyfactor[row] * double(data)
				else
					this.id_pay.object.basicpay[row] = this.id_pay.object.payfrequencyfactor[row] * double(data)
				end if
			elseif this.id_pay.object.payfrequency[row] = 2 then
				if this.id_pay.object.paytype[row] = 1 then
					this.id_pay.object.basicpay[row] = this.id_pay.object.workinghours[row] * this.id_pay.object.payfrequencyfactor[row] * double(data)
				else
					this.id_pay.object.basicpay[row] = this.id_pay.object.payfrequencyfactor[row] * double(data)
				end if
			elseif this.id_pay.object.payfrequency[row] = 3 then
				if this.id_pay.object.paytype[row] = 1 then
					this.id_pay.object.basicpay[row] = this.id_pay.object.workinghours[row] * this.id_pay.object.payfrequencyfactor[row] * double(data)
				else
					this.id_pay.object.basicpay[row] = this.id_pay.object.payfrequencyfactor[row] * double(data)
				end if
			elseif this.id_pay.object.payfrequency[row] = 4 then
				if this.id_pay.object.paytype[row] = 1 then
					this.id_pay.object.basicpay[row] = this.id_pay.object.workinghours[row] * double(data)
				else
					this.id_pay.object.basicpay[row] = this.id_pay.object.payfrequencyfactor[row] * double(data)
				end if
			end if
			ll_retcode = 0
			for ll_counter = 1 to this.id_payallowance.rowcount()
				this.id_payallowance.object.basicpay[ll_counter] = this.id_pay.object.basicpay[row]
			next
			for ll_counter = 1 to this.id_paydeduction.rowcount()
				this.id_paydeduction.object.basicpay[ll_counter] = this.id_pay.object.basicpay[row]
			next
		else
			ll_retcode = 1
		end if
	case "basicpay"
		if double(data) >= 0.0 then
			if this.id_pay.object.payfrequency[row] = 1 then
				if this.id_pay.object.paytype[row] = 1 then
					if this.id_pay.object.workinghours[row] * this.id_pay.object.payfrequencyfactor[row] > 0 then
						this.id_pay.object.perhourrate[row] = round(double(data) / (this.id_pay.object.workinghours[row] * this.id_pay.object.payfrequencyfactor[row]), 2)
					else
						this.id_pay.object.perhourrate[row] = round(double(data) / 1.0, 2)
					end if
				else
					this.id_pay.object.perhourrate[row] = round(double(data) / this.id_pay.object.payfrequencyfactor[row], 2)
				end if
			elseif this.id_pay.object.payfrequency[row] = 2 then
				if this.id_pay.object.paytype[row] = 1 then
					if this.id_pay.object.workinghours[row] * this.id_pay.object.payfrequencyfactor[row] > 0 then
						this.id_pay.object.perhourrate[row] = round(double(data) / (this.id_pay.object.workinghours[row] * this.id_pay.object.payfrequencyfactor[row]), 2)
					else
						this.id_pay.object.perhourrate[row] = round(double(data) / 1.0, 2)
					end if
				else
					this.id_pay.object.perhourrate[row] = round(double(data) / this.id_pay.object.payfrequencyfactor[row], 2)
				end if
			elseif this.id_pay.object.payfrequency[row] = 3 then
				if this.id_pay.object.paytype[row] = 1 then
					if this.id_pay.object.workinghours[row] * this.id_pay.object.payfrequencyfactor[row] > 0 then
						this.id_pay.object.perhourrate[row] = round(double(data) / (this.id_pay.object.workinghours[row] * this.id_pay.object.payfrequencyfactor[row]), 2)
					else
						this.id_pay.object.perhourrate[row] = round(double(data) / 1.0, 2)
					end if
				else
					this.id_pay.object.perhourrate[row] = round(double(data) / this.id_pay.object.payfrequencyfactor[row], 2)
				end if
			elseif this.id_pay.object.payfrequency[row] = 4 then
				if this.id_pay.object.paytype[row] = 1 then
					if this.id_pay.object.workinghours[row] > 0 then
						this.id_pay.object.perhourrate[row] = round(double(data) / this.id_pay.object.workinghours[row], 2)
					else
						this.id_pay.object.perhourrate[row] = round(double(data) / 1.0, 2)
					end if
				else
					this.id_pay.object.perhourrate[row] = round(double(data) / this.id_pay.object.payfrequencyfactor[row], 2)
				end if
			end if
			ll_retcode = 0
			for ll_counter = 1 to this.id_payallowance.rowcount()
				this.id_payallowance.object.basicpay[ll_counter] = double(data)
			next
			for ll_counter = 1 to this.id_paydeduction.rowcount()
				this.id_paydeduction.object.basicpay[ll_counter] = double(data)
			next
		else
			ll_retcode = 1
		end if
	case else
		this.id_pay.accepttext()
		this.id_payallowance.accepttext()
		this.id_paydeduction.accepttext()
	end choose
	if this.id_payallowance.rowcount() > 0 then
		ld_allowances = this.id_payallowance.getitemnumber(1, "c_tot_allowances")
	else
		ld_allowances = 0
	end if
	if this.id_paydeduction.rowcount() > 0 then
		ld_deductions = this.id_paydeduction.getitemnumber(1, "c_tot_deductions")
	else
		ld_deductions = 0
	end if
	if as_col = "basicpay" then
		this.id_pay.object.estnetpay[row] = double(data) + ld_allowances - ld_deductions
	else
		this.id_pay.object.estnetpay[row] = this.id_pay.object.basicpay[row] + ld_allowances - ld_deductions
	end if
	return ll_retcode

// w_emp_form.wf_duplicate_adv_acc(string as_accname) returns boolean
	long ll_count
	long ll_acccode
	boolean b_flag
	as_accname = trim(as_accname)
	if this.id_emp.rowcount() <= 0 then
		return b_flag
	end if
	ll_acccode = this.id_emp.object.emp_employee_advacccode[1]
	if ll_acccode > 0 then
		SQL SELECT count ( *) INTO :ll_count FROM Accounts WHERE Accounts.name =:as_accname AND Accounts.AccCode <> :ll_acccode USING this.it_transobject;
	else
		SQL SELECT count ( *) INTO :ll_count FROM Accounts WHERE Accounts.name =:as_accname USING this.it_transobject;
	end if
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_emp_form.wf_duplicate_adv_acc_alias(string as_aliasname) returns boolean
	long ll_count
	long ll_acccode
	boolean b_flag
	as_aliasname = trim(as_aliasname)
	if this.id_emp.rowcount() <= 0 then
		return b_flag
	end if
	ll_acccode = this.id_emp.object.emp_employee_advacccode[1]
	if ll_acccode > 0 then
		SQL SELECT count ( *) INTO :ll_count FROM Accounts WHERE Accounts.aliasname =:as_aliasname AND Accounts.AccCode <> :ll_acccode USING this.it_transobject;
	else
		SQL SELECT count ( *) INTO :ll_count FROM Accounts WHERE Accounts.aliasname =:as_aliasname USING this.it_transobject;
	end if
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_emp_form.wf_validate_transportroutecode(integer al_code) returns long
	double ld_charges
	SQL SELECT TransportCharges INTO :ld_charges FROM TransportRoute WHERE TransportRouteCode =:al_code USING this.it_transobject;
	if this.it_transobject.sqlcode = 0 then
		if isnull(ld_charges) or ld_charges <= 0.0 then
			ld_charges = 0
		end if
		this.idc_vehicle.retrieve(al_code)
		if this.idc_vehicle.rowcount() > 0 then
			this.id_emp.object.vehiclecode[1] = this.idc_vehicle.getitemnumber(1, "code")
		end if
		return 0
	end if
	return 1

// w_emp_form.wf_delete_empty_allowances_deductions() returns long
	long ll_rowcount
	long ll_row
	ll_rowcount = this.id_payallowance.rowcount()
	ll_row = 1
	do while ll_row <= ll_rowcount
		if this.id_payallowance.object.percentage[ll_row] = 0 and this.id_payallowance.object.flatamount[ll_row] = 0 then
			this.id_payallowance.deleterow(ll_row)
			ll_rowcount = ll_rowcount - 1
		else
			ll_row = ll_row + 1
		end if
	loop
	ll_rowcount = this.id_paydeduction.rowcount()
	ll_row = 1
	do while ll_row <= ll_rowcount
		if this.id_paydeduction.object.percentage[ll_row] = 0 and this.id_paydeduction.object.flatamount[ll_row] = 0 then
			this.id_paydeduction.deleterow(ll_row)
			ll_rowcount = ll_rowcount - 1
		else
			ll_row = ll_row + 1
		end if
	loop
	return 0

// w_emp_form.wf_adjust_allowances() returns long
	long ll_row
	long ll_rowcount
	long ll_insrow
	datastore lds_ds
	lds_ds = create datastore
	lds_ds.dataobject = "d_emp_payallowances_notused"
	lds_ds.settransobject(sqlca)
	lds_ds.retrieve(this.il_code)
	for ll_row = 1 to lds_ds.rowcount()
		ll_insrow = this.id_payallowance.insertrow(0)
		if ll_insrow > 0 then
			this.id_payallowance.object.code[ll_insrow] = lds_ds.object.code[ll_row]
			this.id_payallowance.object.allowancecode[ll_insrow] = lds_ds.object.allowancecode[ll_row]
			this.id_payallowance.object.basicpay[ll_insrow] = lds_ds.object.basicpay[ll_row]
			this.id_payallowance.object.name[ll_insrow] = lds_ds.object.name[ll_row]
			this.id_payallowance.object.attendancewise[ll_insrow] = lds_ds.object.attendancewise[ll_row]
			this.id_payallowance.object.percentage[ll_insrow] = lds_ds.object.percentage[ll_row]
			this.id_payallowance.object.flatamount[ll_insrow] = lds_ds.object.flatamount[ll_row]
		end if
	next
	return 0

// w_emp_form.wf_adjust_deductions() returns integer
	long ll_row
	long ll_rowcount
	long ll_insrow
	datastore lds_ds
	lds_ds = create datastore
	lds_ds.dataobject = "d_emp_paydeduction_notused"
	lds_ds.settransobject(sqlca)
	lds_ds.retrieve(this.il_code)
	for ll_row = 1 to lds_ds.rowcount()
		ll_insrow = this.id_paydeduction.insertrow(0)
		if ll_insrow > 0 then
			this.id_paydeduction.object.code[ll_insrow] = lds_ds.object.code[ll_row]
			this.id_paydeduction.object.deductioncode[ll_insrow] = lds_ds.object.deductioncode[ll_row]
			this.id_paydeduction.object.basicpay[ll_insrow] = lds_ds.object.basicpay[ll_row]
			this.id_paydeduction.object.name[ll_insrow] = lds_ds.object.name[ll_row]
			this.id_paydeduction.object.percentage[ll_insrow] = lds_ds.object.percentage[ll_row]
			this.id_paydeduction.object.flatamount[ll_insrow] = lds_ds.object.flatamount[ll_row]
		end if
	next
	return 0

