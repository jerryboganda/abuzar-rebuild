// window w_emp_form (employee)  ancestor: window

// w_emp_form.ue_close() returns 0 [event]
	SQL stop USING this.it_transobject;
	close(this)

// w_emp_form.wf_set_interface_adjustments() returns 0
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	environment env
	if getenvironment(env) = 1 then
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width * 0.95
		ll_height = ll_win_height * 0.95
		this.width = ll_width
		this.height = ll_height
		this.cb_ok.y = ll_height - this.cb_ok.height - 200
		this.cb_cancel.y = ll_height - this.cb_cancel.height - 200
		this.tab_main.width = ll_width * 0.98
		this.tab_main.height = this.cb_ok.y - 50
		this.tab_main.tabpage_emp.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_emp.height = this.tab_main.height - 500
		this.tab_main.tabpage_emp.dw_emp.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_emp.dw_emp.height = this.tab_main.height - 500
		this.tab_main.tabpage_edu.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_edu.height = this.tab_main.height - 500
		this.tab_main.tabpage_edu.dw_edu.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_edu.dw_edu.height = this.tab_main.height - 500
		this.tab_main.tabpage_cert.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_cert.height = this.tab_main.height - 500
		this.tab_main.tabpage_cert.dw_cert.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_cert.dw_cert.height = this.tab_main.height - 500
		this.tab_main.tabpage_skill.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_skill.height = this.tab_main.height - 500
		this.tab_main.tabpage_skill.dw_skill.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_skill.dw_skill.height = this.tab_main.height - 500
		this.tab_main.tabpage_jobexp.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_jobexp.height = this.tab_main.height - 500
		this.tab_main.tabpage_jobexp.dw_jobexp.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_jobexp.dw_jobexp.height = this.tab_main.height - 500
		this.tab_main.tabpage_proj.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_proj.height = this.tab_main.height - 500
		this.tab_main.tabpage_proj.dw_proj.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_proj.dw_proj.height = this.tab_main.height - 500
		this.tab_main.tabpage_ref.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_ref.height = this.tab_main.height - 500
		this.tab_main.tabpage_ref.dw_ref.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_ref.dw_ref.height = this.tab_main.height - 500
		this.tab_main.tabpage_pay.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_pay.height = this.tab_main.height - 500
		this.tab_main.tabpage_pay.dw_pay.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_pay.dw_allowance.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_pay.dw_deduction.width = this.tab_main.width * 0.98
		this.tab_main.tabpage_pay.dw_pay.height = this.tab_main.tabpage_pay.height * 0.40
		this.tab_main.tabpage_pay.dw_allowance.height = this.tab_main.tabpage_pay.height * 0.30
		this.tab_main.tabpage_pay.dw_deduction.height = this.tab_main.tabpage_pay.height * 0.30
		this.tab_main.tabpage_pay.dw_allowance.y = this.tab_main.tabpage_pay.dw_pay.y + this.tab_main.tabpage_pay.dw_pay.height + 5
		this.tab_main.tabpage_pay.dw_deduction.y = this.tab_main.tabpage_pay.dw_allowance.y + this.tab_main.tabpage_pay.dw_allowance.height + 5
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if

