// w_emp_form.open() returns long [event]
	integer li_xpos
	integer li_ypos
	integer li_xendpos
	integer li_counter
	integer li_taborder
	integer li_visiblecolumns
	integer li_zerotaborder
	long ll_counter
	long li_retcode
	long li_rtncode
	boolean lb_active
	boolean lb_restricted
	boolean lb_customicode
	boolean lb_zerotabordercol
	date ld_date
	long ll_retcode
	ld_date = today()
	this.il_code = message.doubleparm
	this.it_transobject = create u_transaction
	if wf_connect() <> 0 then
		messagebox("Connection Failure", "Unable to connect to the database", stopsign!)
		close(this)
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	if f_rightexists(5132) then
		this.ib_viewimage = true
	else
		this.ib_viewimage = false
	end if
	if f_rightexists(5133) then
		this.ib_uploadimage = true
	else
		this.ib_uploadimage = false
	end if
	wf_get_emp_info(this.il_code)
	wf_retrieve_tabs()
	wf_apply_protect_setting()
	wf_set_interface_adjustments()
	wf_set_tab_visibility()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

