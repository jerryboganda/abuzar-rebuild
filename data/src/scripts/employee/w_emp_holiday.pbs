// window w_emp_holiday (employee)  ancestor: w_multi_entry

// w_emp_holiday.wf_duplicatename(string as_name) returns boolean
	long ll_count
	boolean b_flag
	as_name = trim(as_name)
	SQL SELECT count ( *) INTO :ll_count FROM EMP_Department WHERE name =:as_name USING this.it_transobject;
	if ll_count > 0 then
		b_flag = true
	end if
	return b_flag

// w_emp_holiday.wf_validateitem() returns integer
	long ll_icode
	datetime ldt_date
	integer li_errcode
	string ls_managername
	datetime ld_null
	ldt_date = this.id_detail.getitemdatetime(this.il_currrow, "date")
	if vf_dwdupdate(this.id_detail, "date", ldt_date, this.il_currrow) = true then
		ls_managername = ""
		messagebox("Duplication Error", "Current row is duplicate")
		li_errcode = -1
	else
		li_errcode = 0
	end if
	this.ib_itemvalidated = true
	if li_errcode = -1 then
		setnull(ld_null)
		this.id_detail.setcolumn("date")
		this.id_detail.scrolltorow(this.il_currrow)
		this.id_detail.object.date[this.il_currrow] = ld_null
	end if
	return li_errcode

// w_emp_holiday.wf_first() returns long
	long ret_val
	datetime ld_date
	if this.id_dwcontrol.rowcount() > 0 then
		this.id_dwcontrol.scrolltorow(0)
		ret_val = this.id_dwcontrol.getrow()
		if ret_val > 0 then
			ld_date = this.id_dwcontrol.borderstyle.code[this.id_dwcontrol.getrow()]
		else
			ld_date = this.id_dwcontrol.borderstyle.code[1]
		end if
	end if
	return ret_val

// w_emp_holiday.wf_last() returns long
	long ret_val
	this.id_dwcontrol.scrolltorow(this.id_dwcontrol.rowcount())
	ret_val = this.id_dwcontrol.borderstyle.code[this.id_dwcontrol.getrow()]
	return ret_val

// w_emp_holiday.wf_retrieve(datetime ad_date) returns long
	long rtcode
	rtcode = this.id_dwcontrol.retrieve(ad_date)
	return rtcode

// w_emp_holiday.create() returns 0
	call super::create

// w_emp_holiday.destroy() returns 0
	call super::destroy
	if isvalid(this.menuid) then
		destroy this.menuid
	end if

// w_emp_holiday.ue_save() returns 0
	long ll_mastercurrrow
	long ll_invid
	long ll_detailrows
	integer li_counter
	integer ll_salesmancode
	boolean lb_commitflag
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	if f_validatedw(this.id_detail) < 0 then
		return
	end if
	setpointer(hourglass!)
	ll_mastercurrrow = this.id_master.getrow()
	ll_detailrows = this.id_detail.rowcount()
	li_counter = 1
	if this.id_detail.update() > 0 then
		SQL commit USING this.it_transobject;
		messagebox("Save Changes", "Changes take effect in database", exclamation!, ok!, 1)
		this.ib_commitok = true
		this.id_master.resetupdate()
		this.im_menu.m_file.m_new.enabled = true
		this.editflag = false
		if gd_recenttransdate < this.id_systemdate then
			gd_recenttransdate = this.id_systemdate
		end if
	else
		SQL rollback USING this.it_transobject;
		setpointer(arrow!)
		return
	end if
	setpointer(arrow!)

// w_emp_holiday.ue_newform() returns 0
	call super::ue_newform
	this.id_master.setfocus()

// w_emp_holiday.ue_newitem() returns 0
	if this.ib_itemvalidated = false and wf_validateitem() = -1 then
		return
	end if
	call super::ue_newitem
	this.id_detail.setcolumn("date")

// w_emp_holiday.ue_detail() returns 0
	long ll_code
	long ll_rowcount
	datetime ldt_date
	this.im_menu.m_file.m_save.enabled = true
	this.im_menu.m_file.m_delete.enabled = true
	this.im_menu.m_file.m_first.enabled = true
	this.im_menu.m_file.m_next.enabled = true
	this.im_menu.m_file.m_last.enabled = true
	this.im_menu.m_file.m_print.enabled = true
	this.im_menu.m_file.m_previous.enabled = true
	this.im_menu.m_item.m_newitem.enabled = true
	this.im_menu.m_item.m_deleteitem.enabled = true
	this.im_menu.m_file.m_retrieve.text = "Lis&t"
	this.im_menu.m_file.m_print.enabled = true
	this.i_editmode = 2
	this.i_retrievemode = 2
	ldt_date = this.id_list.object.date[this.il_selectedrow]
	this.id_dwcontrol = this.id_master
	ll_rowcount = wf_retrieve(ldt_date)
	this.id_master.setrow(1)
	this.id_master.scrolltorow(1)
	this.id_dwcontrol = this.id_detail
	wf_retrieve(ldt_date)
	this.id_master.setcolumn(1)
	this.id_master.setfocus()
	this.id_dwcontrol = this.id_list
