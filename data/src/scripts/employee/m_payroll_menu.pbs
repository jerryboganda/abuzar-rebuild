	this.m_payrollpayment = create m_payrollpayment
	this.m_fetchattendancerecord = create m_fetchattendancerecord
	this.m_generatepayrollslips = create m_generatepayrollslips
	this.item[upperbound(this.item) + 1] = this.m_payrollpayment
	this.item[upperbound(this.item) + 1] = this.m_fetchattendancerecord
	this.item[upperbound(this.item) + 1] = this.m_generatepayrollslips

// m_file.destroy() returns 0 [event]
