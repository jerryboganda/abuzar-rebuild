// function f_getnestedreport (reportviewer)  ancestor: function_object

// f_getnestedreport.f_getnestedreport(datawindowchild adc_nested, datawindow adw_parentdatawindow, string as_nesteddatawindow) returns integer
	integer li_rtncode
	li_rtncode = adw_parentdatawindow.getchild(as_nesteddatawindow, adc_nested)
	if li_rtncode <> -1 then
		adc_nested.settransobject(sqlca)
	end if
	return li_rtncode
