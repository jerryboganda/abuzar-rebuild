			SQL rollback USING sqlca;
			sqlca.purchase_rate_comparison(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.s_name1, as_reparg.s_name2, ls_stringarr1)
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
			i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.s_name1, as_reparg.s_name2)
