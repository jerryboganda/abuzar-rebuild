		end if
		if as_reparg.i_status = 1 then
			adw_report.setfilter("")
			adw_report.filter()
			i_rtcode = adw_report.retrieve(as_reparg.l_code1, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.l_code2)
			ll_rowcount = adw_report.rowcount()
			ll_count = as_reparg.l_code2
			ll_tempcode = -1
			ll_counter = 0
			ls_name = "icode"
			for ll_loopcounter = 1 to ll_rowcount
				if ll_tempcode <> adw_report.getitemnumber(ll_loopcounter, ls_name) then
					ll_tempcode = adw_report.getitemnumber(ll_loopcounter, ls_name)
					ll_counter = 0
				end if
				if ll_counter < ll_count then
					adw_report.setitem(ll_loopcounter, "show", "Y")
					ll_counter = ll_counter + 1
				end if
			next
			adw_report.setfilter("show='Y'")
			adw_report.filter()
		end if
