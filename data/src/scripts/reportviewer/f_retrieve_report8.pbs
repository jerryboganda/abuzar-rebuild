			else
				i_rtcode = adw_report.retrieve(as_reparg.l_code1, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.db_code1, as_reparg.s_name1, as_reparg.sa_stringlist[1], as_reparg.sa_stringlist[2], as_reparg.l_code4, as_reparg.s_name3)
			end if
		end if
	case "d_billsummaryreport"
		if ai_mode = 0 then
			open(w_select_user_areawise_billsummary)
			al_format = message.doubleparm
			if al_format = 1 then
				open(w_arg_billsummaryreport)
				as_reparg = message.powerobjectparm
				adw_report.dataobject = "d_billsummaryreport"
			else
				open(w_arg_areas)
				lstr_temp = message.powerobjectparm
				openwithparm(w_arg_subareas_saletype_areabased, lstr_temp)
				as_reparg = message.powerobjectparm
				adw_report.dataobject = "d_billsummary_unpaidbills"
			end if
			adw_report.settransobject(sqlca)
		end if
		if as_reparg.i_status = 1 then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
			if al_format = 1 then
				i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.s_name1, as_reparg.l_code1, as_reparg.l_code2, as_reparg.s_name2, as_reparg.s_name3)
			else
				i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.ia_integerlist1, as_reparg.s_name1)
			end if
		end if
	case else
		return 0
	end choose
	return 1
