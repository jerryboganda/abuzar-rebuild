	double ld_credit
	double ld_purprice
	double ld_openbalance2
	double ld_value
	datawindowchild ldc_nested
	s_arguements lstr_temp
	string[] categories
	string categoryname
	long ll_rank
	setnull(ll_null)
	choose case as_reportinfo.s_reportobject
	case "d_supportbillsummary"
		if ai_mode = 0 then
			open(w_selectformat_supportbillsum)
			if message.doubleparm = 1.0 then
				adw_report.dataobject = "d_supportbillsummary"
			else
				adw_report.dataobject = "d_supportbillsummary2"
			end if
			adw_report.settransobject(sqlca)
			open(w_arg_areas_zerobalance)
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				adw_report.setredraw(false)
				if as_reparg.i_supress then
					adw_report.setfilter("")
				else
					adw_report.setfilter("balance <> 0")
				end if
				adw_report.filter()
				i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist)
				adw_report.setredraw(true)
			else
				SQL rollback USING sqlca;
			end if
		end if
	case "d_accountpayableactivity"
		if ai_mode = 0 then
			open(w_arg_sdate_ldate)
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
			i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate)
		end if
	case "d_accountreceiveableactivity"
		if ai_mode = 0 then
			open(w_arg_sdate_ldate)
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
			i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate)
		end if
	case "d_stockregistermovingavg"
		if ai_mode = 0 then
			open(w_arg_item_sdate_ldate)
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			SQL rollback USING sqlca;
			sqlca.stockledger()
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
			i_rtcode = adw_report.retrieve(as_reparg.l_code1, as_reparg.d_sdate, as_reparg.d_edate)
		end if
