		sqlca.accountopeningbalance(as_reparg.l_code1, as_reparg.d_sdate, ld_openbalance)
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		SQL rollback USING sqlca;
		sqlca.accountopeningbalance(as_reparg.l_code2, as_reparg.d_sdate, ld_openbalance2)
