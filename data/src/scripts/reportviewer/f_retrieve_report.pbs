// function f_retrieve_report (reportviewer)  ancestor: function_object

// f_retrieve_report.f_retrieve_report(datawindow adw_report, s_reportinfo as_reportinfo, s_arguements as_reparg, long al_format, string as_type, integer ai_mode) returns long
	integer ii_normal
	integer ii_autorefresh
	string ls_name
	string ls_list
	string ls_qty
	string ls_itemname
	string ls_doctype
	string ls_cp
	string ls_address
