				open(w_arg_sdate_ldate)
			end if
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				if al_format = 2 or al_format = 6 or al_format = 8 or al_format = 10 or al_format = 11 then
					i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.ia_integerlist)
				else
					i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate)
				end if
			else
				SQL rollback USING sqlca;
			end if
		end if
	case "d_account_ledger"
		if ai_mode = 0 then
			open(w_arg_acc_sdate_ldate)
			as_reparg = message.powerobjectparm
		end if
		SQL rollback USING sqlca;
		sqlca.accountsledger1(as_reparg.l_code1, as_reparg.d_sdate, as_reparg.d_edate)
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
		if as_reparg.i_status = 1 then
			i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate)
			if adw_report.rowcount() > 0 then
				ld_openbalance = adw_report.getitemnumber(1, "Openingbal")
				for ll_count = 1 to adw_report.rowcount()
					ld_debit = adw_report.getitemnumber(ll_count, "debit")
					ld_credit = adw_report.getitemnumber(ll_count, "credit")
					ld_openbalance = ld_openbalance + ld_debit - ld_credit
					adw_report.setitem(ll_count, "currbalance", ld_openbalance)
				next
			end if
		end if
	case else
		return 0
	end choose
	return 1
