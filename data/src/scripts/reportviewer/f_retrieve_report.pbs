			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
			if as_reparg.s_name1 = "Activity" then
				adw_report.dataobject = "d_trialbalance_activity"
