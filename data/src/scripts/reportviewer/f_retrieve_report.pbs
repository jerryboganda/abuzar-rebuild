			elseif al_format = 3 then
				adw_report.dataobject = "d_stockmovement_manfwise_3"
			else
				adw_report.dataobject = "d_stockmovement_manfwise"
			end if
			adw_report.settransobject(sqlca)
		end if
		SQL rollback USING sqlca;
		if al_format = 3 then
			sqlca.salereturnpurwithdue(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.l_code1)
		else
			sqlca.salereturnpur(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.l_code1)
		end if
		if sqlca.sqlcode = 0 then
			SQL commit USING sqlca;
		else
			SQL rollback USING sqlca;
		end if
