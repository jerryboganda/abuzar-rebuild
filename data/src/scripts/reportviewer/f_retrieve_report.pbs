			elseif al_format = 8 then
				adw_report.dataobject = "d_cashflow_onecashacc_patient"
			elseif al_format = 9 then
				adw_report.dataobject = "d_cashflow_student"
			elseif al_format = 10 then
				adw_report.dataobject = "d_cashflow_student_cashacc"
			elseif al_format = 11 then
				adw_report.dataobject = "d_cashflow_student_cashacc2"
			end if
