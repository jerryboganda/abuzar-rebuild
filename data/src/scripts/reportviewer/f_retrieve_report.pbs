			if al_format = 1 then
				adw_report.dataobject = "d_cashflow"
			elseif al_format = 2 then
				adw_report.dataobject = "d_cashflow_onecashacc"
			elseif al_format = 3 then
				adw_report.dataobject = "d_cashflow_cashandbanks"
			elseif al_format = 4 then
