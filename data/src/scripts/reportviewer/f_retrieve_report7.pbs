				open(w_arg_academicclass)
			end if
			adw_report.settransobject(sqlca)
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			if al_format <= 2 then
				i_rtcode = adw_report.retrieve(as_reparg.l_code1, as_reparg.l_code2)
			elseif al_format = 4 then
				i_rtcode = adw_report.retrieve(as_reparg.d_sdate)
			else
				i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist)
			end if
		end if
	case else
		return 0
	end choose
	return 1
