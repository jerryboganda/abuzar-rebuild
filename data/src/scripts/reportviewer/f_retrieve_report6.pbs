	choose case as_reportinfo.s_reportobject
	case "d_batchwise_stockmovement"
		if ai_mode = 0 then
			open(w_select_batchwisestockmovement)
			al_format = message.doubleparm
			if al_format = 1 then
				adw_report.dataobject = "d_batchwise_stockmovement"
			elseif al_format = 2 then
				adw_report.dataobject = "d_batchwise_stockmovement2"
			else
				adw_report.dataobject = "d_batchwise_stockmovement3"
			end if
			adw_report.settransobject(sqlca)
			open(w_selection_manf_cat_class_packing)
			as_type = message.stringparm
			if not (as_type = "" or isnull(as_type)) then
				if al_format = 1 then
					openwithparm(w_arg_grouping_dates_pricetype_batch, as_type)
				else
					openwithparm(w_arg_grouping_dates_pricetype2, as_type)
				end if
				as_reparg = message.powerobjectparm
			end if
		end if
		if as_reparg.i_status = 1 then
			if al_format = 1 then
				i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_type, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.s_name1, as_reparg.l_code1)
