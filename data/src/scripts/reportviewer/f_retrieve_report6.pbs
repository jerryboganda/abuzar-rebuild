					for ll_counter = 1 to ll_count
						ls_name = ls_name + trim(string(lds_invoices.getitemnumber(ll_counter, "saleinvcode"))) + ", "
					next
					if right(ls_name, len(ls_name) - 1) = ", " then
						replace(ls_name, len(ls_name) - 2, 2, "  ")
					end if
				end if
			end if
			destroy lds_invoices
			as_reparg.s_name2 = ls_name
