				end if
				i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate)
			end if
		else
			for ll_loopcounter = 1 to 15
				as_reparg.ia_integerlist[ll_loopcounter] = 0
			next
			ll_loopcounter = 0
			open(w_arg_sdate_ldate_transaction)
			as_reparg = message.powerobjectparm
			if as_reparg.i_status = 1 then
				SQL rollback USING sqlca;
				sqlca.virtualgl("A")
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
				else
					SQL rollback USING sqlca;
				end if
				for ll_loopcounter = 1 to upperbound(as_reparg.ia_integerlist)
					if as_reparg.ia_integerlist[ll_loopcounter] <> 0 then
						i_rtcode = f_getnestedreport(ldc_nested, adw_report, "dw_" + trim(string(ll_loopcounter)))
						if i_rtcode = -1 then
							messagebox("Retrieve Error", "Problem in Retrieving Report")
						elseif ll_loopcounter >= 10 then
							i_rtcode = ldc_nested.retrieve(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.ia_integerlist[ll_loopcounter])
						else
							i_rtcode = ldc_nested.retrieve(as_reparg.d_sdate, as_reparg.d_edate)
