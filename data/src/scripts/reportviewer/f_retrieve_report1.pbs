// function f_retrieve_report1 (reportviewer)  ancestor: function_object

// f_retrieve_report1.f_retrieve_report1(ref datawindow adw_report, ref s_reportinfo as_reportinfo, ref s_arguements as_reparg, ref long al_format, ref string as_type, ref integer ai_mode) returns long
	integer ii_normal
	integer ii_autorefresh = 1
	long ll_insertrow
	long ll_rowcount
	long ll_count
	long ll_loopcounter = 1
	long ll_counter
	long ll_manfcode
	long ll_rightexists
	long[] ll_arr
	char lc_due
	string ls_itemname
	string ls_nestedreport
	string ls_stringparam
	string ls_name
	string ls_cp
	string ls_address
	string ls_address2
	string ls_city
	string ls_strn
	string ls_ntn
	string[] ls_posted
