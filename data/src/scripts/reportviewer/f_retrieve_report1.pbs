			end if
			adw_report.settransobject(sqlca)
		end if
		if as_reparg.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.d_sdate, as_reparg.d_edate)
			else
				SQL rollback USING sqlca;
			end if
			setpointer(arrow!)
		end if
	case "d_customerlist_area_custcat"
