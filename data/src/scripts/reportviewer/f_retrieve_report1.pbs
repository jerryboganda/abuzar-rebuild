			end if
			adw_report.settransobject(sqlca)
			if al_format = 1 then
				i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.db_code1, as_reparg.db_code2, ls_cp, ls_address, ls_address2, ls_city, as_reparg.s_name1, as_reparg.s_name2, as_reparg.s_name3, as_reparg.s_name4)
			elseif al_format = 2 or al_format = 7 then
				i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.db_code1, ls_cp, ls_address, ls_address2, ls_city, as_reparg.s_name1, as_reparg.s_name2, as_reparg.s_name6, as_reparg.s_name3, as_reparg.s_name4)
