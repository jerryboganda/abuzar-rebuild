	double ld_openingbalanceqty
	double ld_qtyin
	double ld_qtyout
	double ld_totalqtyout
	s_arguements lstr_temp
	datawindowchild ldc_nested
	datastore lds_returns
	datastore lds_invoices
	lds_returns = create datastore
	choose case as_reportinfo.s_reportobject
	case "d_netsaleinv"
		if ai_mode = 0 then
			open(w_arg_saleinvcode_page)
			as_reparg = message.powerobjectparm
			if as_reparg.s_name2 = "F" then
				adw_report.dataobject = "d_netsaleinv"
			elseif as_reparg.s_name2 = "H" then
				adw_report.dataobject = "d_netsaleinv_half"
			else
				adw_report.dataobject = "d_netsaleinv_quarter"
			end if
			adw_report.settransobject(sqlca)
		end if
		if as_reparg.i_status = 1 then
			lds_returns.dataobject = "d_salereturns_against_saleinv"
			lds_returns.settransobject(sqlca)
			lds_returns.retrieve(as_reparg.l_code1)
			as_reparg.s_name1 = ""
			if lds_returns.rowcount() > 0 then
				for ll_counter = 1 to lds_returns.rowcount()
					as_reparg.s_name1 = as_reparg.s_name1 + "-" + trim(string(lds_returns.getitemnumber(ll_counter, "srinvcode")))
				next
			end if
			adw_report.retrieve(as_reparg.l_code1, as_reparg.s_name1)
		end if
	case "d_group_accountledger"
		if ai_mode = 0 then
			open(w_arg_subsidiaryaccounts_all)
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.d_sdate, as_reparg.d_edate)
			else
				SQL rollback USING sqlca;
			end if
		end if
	case "d_customerwisesalebillssummery"
		if ai_mode = 0 then
			open(w_arg_customers_sdate_ldate_v5)
			as_reparg = message.powerobjectparm
			open(w_selectformat_dayssummary)
		end if
		if as_reparg.i_status = 1 then
			if message.doubleparm <= 2.0 then
				if lower(as_reparg.s_name3) = "originaldate" then
					if message.doubleparm = 1.0 then
						adw_report.dataobject = "d_customerwisesalebillssummery_origdate"
					else
						adw_report.dataobject = "d_customerwisesalebillssummery_origdate2"
					end if
					adw_report.settransobject(sqlca)
				else
					if message.doubleparm = 1.0 then
						adw_report.dataobject = "d_customerwisesalebillssummery"
					else
						adw_report.dataobject = "d_customerwisesalebillssummery2"
					end if
					adw_report.settransobject(sqlca)
				end if
				i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.db_code1)
			elseif message.doubleparm = 3.0 then
				adw_report.dataobject = "d_customerwisesalebillssummery3"
				adw_report.settransobject(sqlca)
				i_rtcode = adw_report.retrieve(as_reparg.s_name3, as_reparg.ia_integerlist, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.db_code1)
			elseif message.doubleparm = 4.0 then
