			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			if as_reparg.l_code3 = 1 then
				adw_report.dataobject = "d_transfer_detail_1tomany"
				adw_report.settransobject(sqlca)
				i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.l_code1, as_reparg.l_code2, as_reparg.la_longlist)
