			elseif gs_company = "GALAXYDIST2" or gs_company = "SNOORMEDICINE" or gs_company = "DRUGSERVICES" then
				adw_report.object.dw_1.dataobject = "d_glaxydist_saleinvreport_bulk"
			elseif gs_company = "AQADIRMEDICOS" or gs_company = "AQADIRMEDICOS2" then
