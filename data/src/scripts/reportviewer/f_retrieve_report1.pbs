				adw_report.settransobject(sqlca)
				i_rtcode = adw_report.retrieve(as_reparg.s_name3, as_reparg.ia_integerlist, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.db_code1)
			end if
		end if
	case "d_transfer_detail_1tomany"
		if ai_mode = 0 then
