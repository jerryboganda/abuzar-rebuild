// w_reviewreport.destroy() returns 0 [event]
	if isvalid(this.menuid) then
		destroy this.menuid
	end if
	destroy this.dw_hidden
	destroy this.st_placeholder
	destroy this.dw_report

// w_reviewreport.open() returns long [event]
	m_reviewreport lm_menu
	long ll_width
	long ll_height
	long ll_found
	environment env
	lm_menu = this.menuid
	this.menuid.dynamic mf_initsecurityapp(lm_menu)
	this.im_reportmenu = this.menuid
	this.is_reportinfo = message.powerobjectparm
	this.is_actual_reportinfo = this.is_reportinfo
	this.title = this.title + ": " + this.is_reportinfo.s_reporttitle
	if getenvironment(env) <> 1 then
		if not isvalid(message) then
			return 0
		end if
		return message.returnvalue
	end if
	ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
	ll_height = pixelstounits(env.screenheight, ypixelstounits!)
	setredraw(false)
	this.dw_report.width = ll_width * 0.985
	this.dw_report.height = ll_height * 0.80
	this.dw_hidden.width = this.dw_report.width
	this.dw_hidden.height = this.dw_report.height
	this.st_placeholder.x = int(this.dw_report.width / 2.0 - this.st_placeholder.width / 2.0)
	this.st_placeholder.y = int(this.dw_report.height / 2.0 - this.st_placeholder.height / 2.0)
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 637", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_saveas.visible = true
		lm_menu.m_file.m_saveas.enabled = true
		lm_menu.m_file.m_saveas.toolbaritemvisible = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 638", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_saveasexcel.visible = true
		lm_menu.m_file.m_saveasexcel.enabled = true
		lm_menu.m_file.m_saveasexcel.toolbaritemvisible = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 651", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_generategraph.visible = true
		lm_menu.m_file.m_generategraph.enabled = true
		lm_menu.m_file.m_generategraph.toolbaritemvisible = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 5217", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		lm_menu.m_file.m_print.visible = true
		lm_menu.m_file.m_print.enabled = true
		lm_menu.m_file.m_print.toolbaritemvisible = true
	else
		lm_menu.m_file.m_print.visible = false
		lm_menu.m_file.m_print.enabled = false
		lm_menu.m_file.m_print.toolbaritemvisible = false
	end if
	setredraw(true)
	this.dw_report.dataobject = this.is_reportinfo.s_reportobject
	this.dw_report.settransobject(sqlca)
	postevent("ue_startdisplay")
	this.dw_report.setfocus()
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_reviewreport.activate() returns long [event]
	this.windowstate = maximized!
	return ::message.returnvalue

// w_reviewreport.timer() returns long [event]
	wf_retrieve(this.ii_autorefresh)
	return ::message.returnvalue

// dw_report.ue_dwnkey(keycode key, unsignedlong keyflags) returns long [event]
	long ancestorreturnvalue
	long ll_row
	string ls_temp
	ancestorreturnvalue = super::ue_dwnkey(key, keyflags)
	ls_temp = upper(describe("DataWindow.Print.Preview"))
	if ls_temp = "NO" then
		if key = keyhome! then
			scrolltorow(0)
			if rowcount() > 0 then
				scrolltorow(1)
				setrow(1)
			end if
			parent.wf_selectrow(1)
		elseif key = keyend! then
			scrolltorow(rowcount())
			setrow(rowcount())
			parent.wf_selectrow(rowcount())
		elseif key = keyuparrow! then
			if getrow() <= 0 then
				scrolltorow(1)
				setrow(1)
			else
				scrolltorow(getrow())
				setrow(getrow())
			end if
			parent.wf_selectrow(getrow())
		elseif key = keydownarrow! then
			if getrow() > rowcount() then
				scrolltorow(rowcount())
				setrow(rowcount())
			else
				scrolltorow(getrow())
				setrow(getrow())
			end if
			parent.wf_selectrow(getrow())
		end if
	elseif key = keyhome! then
		scrolltorow(0)
		if rowcount() > 0 then
			scrolltorow(1)
			setrow(1)
		end if
	elseif key = keyend! then
		scrolltorow(rowcount())
		setrow(rowcount())
	end if
	return ::message.returnvalue

// dw_report.clicked(integer xpos, integer ypos, long row, dwobject dwo) returns long [event]
	long ll_col
	long ll_row
	integer li_clientinstanceid
	string ls_column
	string ls_desc
	string ls_exp
	string ls_value
	string ls_tag
	string ls_name
	string ls_type
	string ls_band
	string ls_dw
	string ls_describe
	boolean lb_crs
	ls_dw = this.dataobject
	ls_name = dwo.name
	ls_type = dwo.type
	ls_band = getbandatpointer()
	if upper(left(ls_band, 7)) = "DETAIL" then
		ll_row = row
	elseif pos(ls_band, "~t") > 0 then
		ll_row = long(mid(ls_band, pos(ls_band, "~t") + 1, len(ls_band)))
	end if
	if ll_row > 0 then
		parent.wf_selectrow(ll_row)
	end if
	ll_col = getclickedcolumn()
	if ll_col > 0 then
		setcolumn(ll_col)
		ls_desc = "#" + trim(string(ll_col)) + ".pointer"
	elseif upper(left(ls_type, 6)) = "COLUMN" and len(ls_name) > 0 then
		ls_column = ls_name
		setcolumn(ls_column)
		ls_desc = ls_column + ".pointer"
	end if
	ls_desc = describe(ls_desc)
	if ls_desc = "~"HyperLink!~"" then
		if match(ls_dw, "_crs_") then
			lb_crs = true
			ls_describe = describe("clientinstanceid.coltype")
			if ls_describe = "number" then
				li_clientinstanceid = getitemnumber(ll_row, "clientinstanceid")
			end if
		end if
		if ll_col > 0 then
			ls_exp = describe("#" + trim(string(ll_col)) + ".coltype")
			ls_tag = describe("#" + trim(string(ll_col)) + ".tag")
		else
			ls_exp = describe(ls_column + ".coltype")
			ls_tag = describe(ls_column + ".tag")
		end if
		if upper(left(ls_exp, 4)) = "CHAR" then
			if ll_col > 0 then
				ls_value = getitemstring(ll_row, ll_col)
			else
				ls_value = getitemstring(ll_row, ls_column)
			end if
			if pos(ls_value, "-") <= 0 then
				if ls_tag <> "" then
					ls_value = ls_tag + "-" + ls_value
				end if
			end if
			if lb_crs then
				f_crs_opentranaction(ls_value, li_clientinstanceid)
			else
				f_opentranaction(ls_value)
			end if
		elseif upper(left(ls_exp, 4)) = "LONG" or upper(left(ls_exp, 6)) = "NUMBER" then
			if ls_tag = "" or isnull(ls_tag) then
				ls_tag = ""
			end if
			if ls_tag = "" then
				ls_tag = ""
			else
				ls_tag = ls_tag + "-"
			end if
			if ll_col > 0 then
				ls_value = ls_tag + trim(string(getitemnumber(ll_row, ll_col)))
			else
				ls_value = ls_tag + trim(string(getitemnumber(ll_row, ls_column)))
			end if
			if lb_crs then
				f_crs_opentranaction(ls_value, li_clientinstanceid)
			else
				f_opentranaction(ls_value)
			end if
		end if
	end if
	return 0
