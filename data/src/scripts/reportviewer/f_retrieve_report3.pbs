// function f_retrieve_report3 (reportviewer)  ancestor: function_object

// f_retrieve_report3.f_retrieve_report3(datawindow adw_report, s_reportinfo as_reportinfo, s_arguements as_reparg, long al_format, string as_type, integer ai_mode) returns long
	integer ii_normal
	integer ii_autorefresh
	long ll_insertrow
	long ll_rowcount
	long ll_count
	long ll_loopcounter
	long ll_counter
	long[] ll_arr
	long ll_zeroqty
	long ll_tempcode
	string ls_itemname
	string ls_nestedreport
	string ls_stringparam
	string ls_name
	string ls_cp
	string ls_address
	string ls_address2
	string ls_city
	string ls_stringarr1
	string ls_stringarr2
	string ls_stringarr3
	integer i_rtcode
	integer li_packunits
	integer li_suppress
	integer li_format
	double ld_saleprice
	double ld_salediscperc
	double ld_cols
	double ld_ratediff
	s_arguements lstr_temp
	datawindowchild ldc_nested
	datastore lds_datastore
	lds_datastore = create datastore
	choose case as_reportinfo.s_reportobject
	case "d_salesman_collectionplan"
		if ai_mode = 0 then
			open(w_arg_sman_ldate_weekday_overdue)
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				sqlca.salesman_collectionplan(as_reparg.d_edate, as_reparg.l_code1, as_reparg.l_code2)
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					i_rtcode = adw_report.retrieve(as_reparg.d_edate, as_reparg.l_code1, as_reparg.l_code2, as_reparg.l_code3)
				else
					SQL rollback USING sqlca;
				end if
			else
				SQL rollback USING sqlca;
			end if
		end if
	case "d_userattendance_summary"
		if ai_mode = 0 then
			open(w_selectformat_userattendance)
			if message.doubleparm = 1.0 then
				adw_report.dataobject = "d_userattendance_summary"
			else
				adw_report.dataobject = "d_userattendance_detail"
			end if
			adw_report.settransobject(sqlca)
			open(w_arg_users_sdate_ldate_2)
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.d_sdate, as_reparg.d_edate)
		end if
	case "d_agingdetail"
		if ai_mode = 0 then
			open(w_selectformat_agingdetailcriteria)
			al_format = message.doubleparm
			if al_format = 1 then
				adw_report.dataobject = "d_agingdetail"
				open(w_arg_agingdetail)
			elseif al_format = 2 then
				adw_report.dataobject = "d_agingdetail_salespersonwise"
				open(w_arg_agingdetail_saleperson)
			end if
			adw_report.settransobject(sqlca)
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				if al_format = 1 then
					sqlca.agingdetail(as_reparg.s_name1, as_reparg.d_sdate, as_reparg.l_code1, as_reparg.l_code2, as_reparg.l_code3)
				elseif al_format = 2 then
					sqlca.agingdetail_salepersonwise(as_reparg.d_sdate, as_reparg.l_code1, as_reparg.l_code2, as_reparg.l_code3)
				end if
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					if al_format = 1 then
						i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.l_code1, as_reparg.l_code2, as_reparg.s_name1, as_reparg.l_code3)
					elseif al_format = 2 then
						i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.l_code1, as_reparg.l_code2, as_reparg.l_code3)
					end if
				else
					SQL rollback USING sqlca;
				end if
			else
				SQL rollback USING sqlca;
			end if
		end if
	case "d_saleinvsummary_full_versions"
		if ai_mode = 0 then
			open(w_selectformat_saleinvversion)
			al_format = message.doubleparm
			if al_format = 1 then
				adw_report.dataobject = "d_saleinvsummary_full_versions"
			elseif al_format = 2 then
				adw_report.dataobject = "d_saleinvsummary_quarter_versions"
			elseif al_format = 3 then
				adw_report.dataobject = "d_saleinvsummary_column_versions"
			elseif al_format = 4 then
				adw_report.dataobject = "d_saleinvsummary_versions"
			end if
			adw_report.settransobject(sqlca)
			if al_format = 3 or al_format = 4 then
				open(w_arg_sdate_ldate)
			else
				open(w_arg_saleinvcode_all)
			end if
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
			if al_format = 3 or al_format = 4 then
				i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate)
			else
				i_rtcode = adw_report.retrieve(as_reparg.l_code1)
			end if
		end if
	case "d_netsale_top_customers"
		if ai_mode = 0 then
			open(w_selection_manf_cat_class_packing)
			as_type = message.stringparm
			if not (as_type = "" or isnull(as_type)) then
				open(w_selectformat_topncustomers)
				al_format = message.doubleparm
				if al_format = 1 then
					adw_report.dataobject = "d_netsale_top_customers"
				elseif al_format = 2 then
					adw_report.dataobject = "d_netsale_top_customers2"
				elseif al_format = 3 then
					adw_report.dataobject = "d_netsale_top_customers3"
				elseif al_format = 4 then
					adw_report.dataobject = "d_netsale_top_customers4"
				elseif al_format = 5 then
					adw_report.dataobject = "d_netsale_top_customers5"
				end if
				adw_report.settransobject(sqlca)
				if al_format < 3 or al_format = 5 then
					openwithparm(w_arg_grouping_area_period_top, as_type)
					as_reparg = message.powerobjectparm
				else
					openwithparm(w_arg_grouping_sperson_period_top, as_type)
					as_reparg = message.powerobjectparm
				end if
			end if
		end if
		if as_reparg.i_status = 1 then
			adw_report.setfilter("")
			adw_report.filter()
			as_reparg.s_name1 = as_type
			i_rtcode = adw_report.retrieve(as_reparg.s_name1, as_reparg.ia_integerlist1, as_reparg.ia_integerlist, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.l_code1)
			ll_rowcount = adw_report.rowcount()
			ll_count = as_reparg.l_code1
			ll_tempcode = -1
			ll_counter = 0
			if al_format = 1 then
				ls_name = "AreaCode"
			elseif al_format = 2 then
				ls_name = "GroupCode"
			elseif al_format = 3 then
				ls_name = "SalesManCode"
			elseif al_format = 4 or al_format = 5 then
				ls_name = "GroupCode"
			end if
			for ll_loopcounter = 1 to ll_rowcount
				if ll_tempcode <> adw_report.getitemnumber(ll_loopcounter, ls_name) then
					ll_tempcode = adw_report.getitemnumber(ll_loopcounter, ls_name)
					ll_counter = 0
				end if
				if ll_counter < ll_count then
					adw_report.setitem(ll_loopcounter, "show", "Y")
					ll_counter = ll_counter + 1
				end if
			next
			adw_report.setfilter("show='Y'")
			adw_report.filter()
		end if
	case "d_dept_issuereceipt_summary", "d_dept_issue_receipt_summary"
		if ai_mode = 0 then
			open(w_selectformat_summary_issuereceipt)
			if message.doubleparm = 1.0 then
				adw_report.dataobject = "d_dept_issue_receipt_summary"
			else
				adw_report.dataobject = "d_dept_issuereceipt_summary"
			end if
			adw_report.settransobject(sqlca)
			open(w_arg_department_sdate_ldate)
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.ia_integerlist)
		end if
	case "d_itemnetsale_smanwise_breakup"
		if ai_mode = 0 then
			open(w_arg_sdate_ldate)
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			SQL commit USING sqlca;
			sqlca.itemnetsale_smanwise_breakup(as_reparg.d_sdate, as_reparg.d_edate)
			if sqlca.sqlcode = 0 then
				i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate)
			end if
		end if
	case "d_salesman_salescollection_summary"
		if ai_mode = 0 then
			open(w_arg_sdate_ldate)
			as_reparg = message.powerobjectparm
			open(w_selectformat_1_2)
			al_format = message.doubleparm
			if al_format = 1 then
				adw_report.dataobject = "d_salesman_salescollection_summary"
			else
				adw_report.dataobject = "d_salesman_salescollection_summary2"
			end if
			adw_report.settransobject(sqlca)
		end if
		if as_reparg.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate)
			else
				SQL rollback USING sqlca;
			end if
		end if
	case "d_regionwise_customerledger"
		if ai_mode = 0 then
			open(w_arg_region_sdate_ldate)
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				i_rtcode = adw_report.retrieve(as_reparg.l_code1, as_reparg.d_sdate, as_reparg.d_edate)
			else
				SQL rollback USING sqlca;
			end if
		end if
	case "d_custbalance_sman_areas"
		if ai_mode = 0 then
			open(w_select_custbalance_sman_area)
			al_format = message.doubleparm
			if al_format = 1 then
				adw_report.dataobject = "d_custbalance_sman_areas"
			else
				adw_report.dataobject = "d_custbalance_sman_areas2"
			end if
			adw_report.settransobject(sqlca)
			open(w_arg_smans_areas_ldate)
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				if f_rightexists(533) then
					i_rtcode = 1
				else
					i_rtcode = 0
				end if
				i_rtcode = adw_report.retrieve(i_rtcode, as_reparg.d_sdate, as_reparg.ia_integerlist, as_reparg.ia_integerlist1)
			else
				SQL rollback USING sqlca;
			end if
		end if
	case "d_dailyincomestatement_saleprofit_summ"
		if ai_mode = 0 then
			open(w_arg_catacc_period_functionalarea)
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			ll_arr = as_reparg.ia_integerlist
			f_tostring(ll_arr, ls_stringarr1, ",")
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				sqlca.dailyincomestatement_with_gp_summary(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.s_name1, ls_stringarr1)
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.s_name1)
				else
					SQL rollback USING sqlca;
				end if
			else
				SQL rollback USING sqlca;
			end if
		end if
	case "d_patient_ledger"
		if ai_mode = 0 then
			open(w_selectformat_patientledger)
			al_format = message.doubleparm
			if al_format = 1 then
				adw_report.dataobject = "d_patient_ledger"
				open(w_arg_patients_sdate_ldate2)
			elseif al_format = 2 then
				adw_report.dataobject = "d_patient_ledger_custwise"
				open(w_arg_customers_sdate_ldate)
			elseif al_format = 3 then
				adw_report.dataobject = "d_patient_ledger_custcatwise"
				open(w_arg_custcategories_sdate_ldate)
			elseif al_format = 4 then
				adw_report.dataobject = "d_patient_ledger_patientcatwise"
				open(w_arg_patientcategory_sdate_ldate)
			end if
			as_reparg = message.powerobjectparm
			adw_report.settransobject(sqlca)
		end if
		if as_reparg.i_status = 1 then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				if al_format = 1 then
					if as_reparg.l_code1 = 1 then
						as_reparg.ia_integerlist = ll_arr
						as_reparg.ia_integerlist[1] = -1
					end if
					i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.ia_integerlist, as_reparg.l_code1)
				else
					i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.ia_integerlist)
				end if
			else
				SQL rollback USING sqlca;
			end if
		end if
	case "d_patient_balance"
		if ai_mode = 0 then
			open(w_selectformat_patientbalance)
			al_format = message.doubleparm
			if al_format = 1 then
				adw_report.dataobject = "d_patient_balance"
				open(w_arg_patients_ldate)
			elseif al_format = 2 then
				adw_report.dataobject = "d_patient_balance_custwise"
				open(w_arg_customers_ldate)
			elseif al_format = 3 then
				adw_report.dataobject = "d_patient_balance_custcatwise"
				open(w_arg_custcategories_ldate)
			elseif al_format = 4 then
				adw_report.dataobject = "d_patient_balance_patientcatwise"
				open(w_arg_patientcategory_ldate)
			end if
			as_reparg = message.powerobjectparm
			adw_report.settransobject(sqlca)
		end if
		if as_reparg.i_status = 1 then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				i_rtcode = adw_report.retrieve(as_reparg.d_edate, as_reparg.ia_integerlist)
			else
				SQL rollback USING sqlca;
			end if
		end if
	case "d_patientwiseinv_reprint_quart_salmod", "d_patientwiseinv_reprint_half_salmod", "d_patientwiseinv_reprint_full_salmod"
		if ai_mode = 0 then
			open(w_arg_patient_v2)
			as_reparg = message.powerobjectparm
			if as_reparg.s_name1 = "F" then
				adw_report.dataobject = "d_patientwiseinv_reprint_full_salmod"
			elseif as_reparg.s_name1 = "H" then
				adw_report.dataobject = "d_patientwiseinv_reprint_half_salmod"
			else
				adw_report.dataobject = "d_patientwiseinv_reprint_quart_salmod"
			end if
			adw_report.settransobject(sqlca)
		end if
		if as_reparg.i_status = 1 then
			i_rtcode = adw_report.retrieve(as_reparg.l_code1)
		end if
	case "d_patientwiseinv_reprint_quart_salmod", "d_patientwiseinv_reprint_half_salmod", "d_patientwiseinv_reprint_full_salmod"
		if ai_mode = 0 then
			open(w_arg_patient_v2)
			as_reparg = message.powerobjectparm
			if as_reparg.s_name1 = "F" then
				adw_report.dataobject = "d_patientwiseinv_reprint_full_salmod"
			elseif as_reparg.s_name1 = "H" then
				adw_report.dataobject = "d_patientwiseinv_reprint_half_salmod"
			else
				adw_report.dataobject = "d_patientwiseinv_reprint_quart_salmod"
			end if
			adw_report.settransobject(sqlca)
		end if
		if as_reparg.i_status = 1 then
			i_rtcode = adw_report.retrieve(as_reparg.l_code1)
		end if
	case "d_inpatientbill"
		if ai_mode = 0 then
			open(w_arg_patient_admission)
			as_reparg = message.powerobjectparm
			if as_reparg.i_status = 1 then
				open(w_selectformat_inpatientbill)
				if message.doubleparm = 1.0 then
					adw_report.dataobject = "d_inpatientbill"
				elseif message.doubleparm = 2.0 then
					adw_report.dataobject = "d_inpatientbill_grouped"
				elseif message.doubleparm = 3.0 then
					adw_report.dataobject = "d_inpatientbill_category_summary"
				elseif message.doubleparm = 4.0 then
					adw_report.dataobject = "d_inpatientbill_category_summary2"
				elseif message.doubleparm = 5.0 then
					adw_report.dataobject = "d_inpatientbill_alihsan"
				elseif message.doubleparm = 6.0 then
					adw_report.dataobject = "d_comp_inpatientbill"
				elseif message.doubleparm = 7.0 then
					adw_report.dataobject = "d_inpatientbill_fatimapharmacy"
				elseif message.doubleparm = 8.0 then
					adw_report.dataobject = "d_inpatientbill_with_disc_tax"
				elseif message.doubleparm = 9.0 then
					adw_report.dataobject = "d_inpatientbill2"
				end if
				adw_report.settransobject(sqlca)
			end if
		end if
		if as_reparg.i_status = 1 then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				i_rtcode = adw_report.retrieve(as_reparg.l_code1)
			else
				SQL rollback USING sqlca;
			end if
		end if
	case "d_categorywisenetsale_wrt_commission"
		if ai_mode = 0 then
			open(w_arg_categories_sdate_ldate_salecat)
			as_reparg = message.powerobjectparm
			if as_reparg.i_status = 1 then
				if as_reparg.ia_integerlist1[1] = 1 or as_reparg.ia_integerlist1[2] = 2 then
					as_reparg.ia_integerlist1[4] = 6
					as_reparg.ia_integerlist1[5] = 7
				end if
				if as_reparg.ia_integerlist1[3] = 3 then
					as_reparg.ia_integerlist1[8] = 8
				end if
			end if
		end if
		if as_reparg.i_status = 1 then
			i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.ia_integerlist, as_reparg.ia_integerlist1, as_reparg.db_code1)
		end if
	case "d_monthlysalesreport"
		if ai_mode = 0 then
			open(w_arg_cust_or_allcust)
			lstr_temp = message.powerobjectparm
			if lstr_temp.i_status = 1 then
				open(w_selectformat_monthlysalesreport)
				if message.doubleparm = 1.0 then
					adw_report.dataobject = "d_monthlysalesreport"
				elseif message.doubleparm = 2.0 then
					adw_report.dataobject = "d_monthlysalesreport2"
				elseif message.doubleparm = 3.0 then
					adw_report.dataobject = "d_monthlysalesreport3"
				elseif message.doubleparm = 4.0 then
					adw_report.dataobject = "d_monthlysalesreport4"
				else
					adw_report.dataobject = "d_monthlysalesreport5"
				end if
				adw_report.settransobject(sqlca)
				open(w_arg_categories_period_price_bonus_ret)
				as_reparg = message.powerobjectparm
			end if
		end if
		if as_reparg.i_status = 1 and lstr_temp.i_status = 1 then
			as_reparg.l_code4 = lstr_temp.l_code1
			as_reparg.l_code5 = lstr_temp.l_code2
			as_reparg.s_name1 = lstr_temp.s_name1
			SQL rollback USING sqlca;
			sqlca.monthlysales(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.l_code1, as_reparg.l_code2, as_reparg.l_code3, as_reparg.l_code4, as_reparg.l_code5)
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
			end if
			i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.s_name1)
		end if
	case "d_stockinhand_godown_manfwise_crosstab"
		if ai_mode = 0 then
			open(w_selection_manf_cat_class_packing)
			as_type = message.stringparm
			if not (as_type = "" or isnull(as_type)) then
				openwithparm(w_arg_grouping_godowns_zeroqty_pricetype, as_type)
				as_reparg = message.powerobjectparm
				open(w_selectformat_crosstab_godownstock)
				al_format = message.doubleparm
				if al_format = 1 then
					adw_report.dataobject = "d_stockinhand_godown_manfwise_crosstab"
				elseif al_format = 2 then
