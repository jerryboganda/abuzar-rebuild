// m_preview.clicked() returns 0 [event]
	if parent.parent.m_file.m_preview.checked = false then
		parent.parent.m_file.m_preview.checked = true
		this.parentwindow.dynamic wf_preview(true)
		return
	end if
	parent.parent.m_file.m_preview.checked = false
	this.parentwindow.dynamic wf_preview(false)

