// menu m_reportsmenu (reportviewer)  ancestor: m_entry

// m_reportsmenu.create() returns 0 [event]
	m_reportsmenu = this
	call super::create

// m_reportsmenu.destroy() returns 0 [event]
	call super::destroy

// m_file.create() returns 0 [event]
	call super::create
	this.m_filter = create m_filter
	this.m_sort = create m_sort
	this.m_pageup = create m_pageup
	this.m_pagedown = create m_pagedown
	this.m_print = create m_print
	this.m_zoom = create m_zoom
	this.m_zoomout = create m_zoomout
	this.item[upperbound(this.item) + 1] = this.m_filter
	this.item[upperbound(this.item) + 1] = this.m_sort
	this.item[upperbound(this.item) + 1] = this.m_pageup
	this.item[upperbound(this.item) + 1] = this.m_pagedown
	this.item[upperbound(this.item) + 1] = this.m_print
	this.item[upperbound(this.item) + 1] = this.m_zoom
	this.item[upperbound(this.item) + 1] = this.m_zoomout

// m_file.destroy() returns 0 [event]
	call super::destroy
	destroy this.m_filter
	destroy this.m_sort
	destroy this.m_pageup
	destroy this.m_pagedown
	destroy this.m_print
	destroy this.m_zoom
	destroy this.m_zoomout

// m_filter.create() returns 0 [event]
	call super::create
	this.text = "&Filter"
	this.toolbaritemname = "Query!"

// m_filter.clicked() returns 0 [event]
	this.parentwindow.triggerevent("ue_filter")

// m_filter.destroy() returns 0 [event]
	call super::destroy

// m_sort.create() returns 0 [event]
