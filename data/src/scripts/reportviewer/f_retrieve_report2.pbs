// function f_retrieve_report2 (reportviewer)  ancestor: function_object

// f_retrieve_report2.f_retrieve_report2(datawindow adw_report, s_reportinfo as_reportinfo, s_arguements as_reparg, long al_format, string as_type, integer ai_mode) returns long
	integer ii_normal
	integer ii_autorefresh
	long ll_insertrow
	long ll_rowcount
	long ll_count
	long ll_loopcounter
	long ll_counter
	long[] ll_arr
	string ls_itemname
	string ls_nestedreport
	string ls_stringparam
	string ls_name
	string ls_cp
	string ls_address
	string ls_address2
	string ls_city
	string ls_stringarr1
	string ls_stringarr2
	string ls_stringarr3
	string ls_value
	integer i_rtcode
	integer li_packunits
	integer li_suppress
	double ld_saleprice
	double ld_salediscperc
	double ld_cols
	datawindowchild ldc_nested
	datastore lds_datastore
	string ls_custname
	string ls_email
	string ls_phone
	lds_datastore = create datastore
	choose case as_reportinfo.s_reportobject
	case "d_issue_receipt_area_salesmanwise"
		open(w_arg_smans_areas_sdate_ldate)
		as_reparg = message.powerobjectparm
		if as_reparg.i_status = 1 then
			i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.ia_integerlist, as_reparg.ia_integerlist1, as_reparg.l_code2, as_reparg.sa_stringlist)
		end if
	case "d_issue_receipt_area_region_zonewise"
		open(w_selection_area_region_zone)
		as_type = message.stringparm
		if not (as_type = "" or isnull(as_type)) then
			if as_type = "Z" then
				open(w_arg_singlezone)
				as_reparg = message.powerobjectparm
			elseif as_type = "R" then
				open(w_arg_singleregion)
				as_reparg = message.powerobjectparm
			elseif as_type = "A" then
				as_reparg.l_code1 = -1
				as_reparg.i_status = 1
			end if
			if as_reparg.i_status = 1 then
				as_reparg.s_name1 = as_type
				openwithparm(w_arg_areas_for_a_zone_region, as_reparg)
				as_reparg = message.powerobjectparm
				if as_reparg.i_status = 1 then
					i_rtcode = adw_report.retrieve(as_type, as_reparg.l_code1, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.ia_integerlist, as_reparg.l_code2, as_reparg.sa_stringlist)
				end if
			end if
		end if
	case "d_givedata_sales", "d_manfwise_salessummary"
		open(w_selectformat_customer_manf_sales)
		if message.doubleparm = 1.0 then
			adw_report.dataobject = "d_givedata_sales"
		else
			adw_report.dataobject = "d_manfwise_salessummary"
		end if
		open(w_arg_manf_sdate_ldate)
		as_reparg = message.powerobjectparm
		if as_reparg.i_status = 1 then
			adw_report.settransobject(sqlca)
			i_rtcode = adw_report.retrieve(as_reparg.l_code1, as_reparg.d_sdate, as_reparg.d_edate)
		end if
	case "d_patientsaleandreturnsummary"
		open(w_arg_customers_sdate_ldate)
		as_reparg = message.powerobjectparm
		open(w_selectformat_patientsaleretsum)
		al_format = message.doubleparm
		if al_format = 1 then
			adw_report.dataobject = "d_patientsaleandreturnsummary"
		elseif al_format = 2 then
			adw_report.dataobject = "d_patientsaleandreturnsummary_format2"
		else
			adw_report.dataobject = "d_patientsaleandreturnsummary_format3"
		end if
		adw_report.settransobject(sqlca)
		if as_reparg.i_status = 1 then
			i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.ia_integerlist)
		end if
	case "d_stockandsale_zone_and_others"
		open(w_selection_manf_cat_class_packing)
		as_type = message.stringparm
		if not (as_type = "" or isnull(as_type)) then
			openwithparm(w_arg_grouping_dates_zoneothers_price, as_type)
			as_reparg = message.powerobjectparm
			if as_reparg.i_status = 1 then
				ll_arr = as_reparg.ia_integerlist
				f_tostring(ll_arr, ls_stringarr1, ",")
				i_rtcode = adw_report.retrieve(as_type, as_reparg.ia_integerlist, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.l_code1, as_reparg.l_code2, as_reparg.l_code3, as_reparg.s_name1)
			end if
		end if
	case "d_stockandsale_weeklymonthly"
		open(w_selection_manf_cat_class_packing)
		as_type = message.stringparm
		if not (as_type = "" or isnull(as_type)) then
			openwithparm(w_arg_grouping_stockandsale, as_type)
			as_reparg = message.powerobjectparm
			if as_reparg.i_status = 1 then
				ll_arr = as_reparg.ia_integerlist
				f_tostring(ll_arr, ls_stringarr1, ",")
				i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.ia_integerlist, as_reparg.l_code1, as_type, as_reparg.l_code3)
			end if
		end if
	case "d_customerwise_medicinesummary_cmh", "d_custwise_medicinesummary_cmh_salmod"
		open(w_arg_date_cust_discinput_dateoption_v2)
		as_reparg = message.powerobjectparm
		if as_reparg.i_status = 1 then
			SQL rollback USING sqlca;
			SQL Select Accounts.name , cp , address1 , address2 , city , email , phone INTO :ls_custname, :ls_cp, :ls_address, :ls_address2, :ls_city, :ls_email, :ls_phone From Customer Inner Join Accounts On Customer.Custcode =Accounts.AccCode Where custcode =:as_reparg.ia_integerlist[1] USING sqlca;
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
			else
				SQL rollback USING sqlca;
				messagebox("Fetch Error", "Unable to fetch customer data.")
			end if
			i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.db_code1, ls_custname, ls_cp, ls_city, ls_phone, ls_email, as_reparg.s_name1, as_reparg.s_name2, as_reparg.s_name4)
		end if
	case "d_customerwise_salessummarydatewise_cmh"
		open(w_arg_date_customer_discinput_dateoption)
		as_reparg = message.powerobjectparm
		if as_reparg.i_status = 1 then
			i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.db_code1, as_reparg.s_name1, as_reparg.s_name2, as_reparg.s_name4)
		end if
	case "d_voucherdetails_date_range"
		open(w_arg_vochcat_sdate_ldate_scode_lcode)
		as_reparg = message.powerobjectparm
		if as_reparg.i_status = 1 then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.l_code1, as_reparg.l_code2, as_reparg.d_sdate, as_reparg.d_edate)
			else
				SQL rollback USING sqlca;
			end if
		end if
	case "d_itemstockregister_antinarcotix"
		open(w_selectformat_1_3)
		if message.doubleparm = 1.0 then
			adw_report.dataobject = "d_itemstockregister_antinarcotix"
		elseif message.doubleparm = 2.0 then
			adw_report.dataobject = "d_itemstockregister_antinarcotix2"
		elseif message.doubleparm = 3.0 then
			adw_report.dataobject = "d_itemstockregister_antinarcotix3"
		end if
		adw_report.settransobject(sqlca)
		open(w_arg_items_sdate_ldate_antinorcotix)
		as_reparg = message.powerobjectparm
		if as_reparg.i_status = 1 then
			i_rtcode = adw_report.retrieve(as_reparg.la_longlist, as_reparg.d_sdate, as_reparg.d_edate)
		end if
	case "d_itemstockregister_new"
		if ai_mode = 0 then
			open(w_arg_items_sdate_ldate_stockregisternew)
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			i_rtcode = adw_report.retrieve(as_reparg.la_longlist, as_reparg.d_sdate, as_reparg.d_edate)
		end if
	case "d_itemstockregister_byazhar"
		if ai_mode = 0 then
			open(w_arg_items_sdate_ldate_stockregister)
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.l_code2 = 1 then
			adw_report.dataobject = "d_itemstockregister_byazhar"
		elseif as_reparg.l_code2 = 2 then
			adw_report.dataobject = "d_itemstockregister_standard"
		elseif as_reparg.l_code2 = 3 then
			adw_report.dataobject = "d_itemstockregister_patient"
		elseif as_reparg.l_code2 = 4 then
			adw_report.dataobject = "d_itemstockregister_custarea"
		elseif as_reparg.l_code2 = 5 then
			adw_report.dataobject = "d_itemstockregister_byazhar2"
		elseif as_reparg.l_code2 = 6 then
			adw_report.dataobject = "d_itemstockregister_standard2"
		elseif as_reparg.l_code2 = 7 then
			adw_report.dataobject = "d_itemstockregister_packqty"
		elseif as_reparg.l_code2 = 8 then
			adw_report.dataobject = "d_itemstockregister_nopricedisc"
		elseif as_reparg.l_code2 = 9 then
			adw_report.dataobject = "d_itemstockregister_withpurnetrate"
		elseif as_reparg.l_code2 = 10 then
			adw_report.dataobject = "d_itemstockregister_withremarks"
		end if
		adw_report.settransobject(sqlca)
		if as_reparg.i_status = 1 then
			i_rtcode = adw_report.retrieve(as_reparg.la_longlist, as_reparg.d_sdate, as_reparg.d_edate)
		end if
	case "d_custcatsalesdetail_crosstab"
		open(w_selection_manf_cat_class_packing)
		as_type = message.stringparm
		if not (as_type = "" or isnull(as_type)) then
			openwithparm(w_arg_grouping_ccat_area, as_type)
			as_reparg = message.powerobjectparm
			if as_reparg.i_status = 1 then
				ll_arr = as_reparg.ia_integerlist
				f_tostring(ll_arr, ls_stringarr1, ",")
				ll_arr = as_reparg.ia_integerlist1
				f_tostring(ll_arr, ls_stringarr2, ",")
				ld_cols = 13.0
				if as_reparg.i_supress then
					li_suppress = 0
				else
					li_suppress = 1
				end if
				SQL rollback USING sqlca;
				sqlca.custcatwisesalesdetail_crosstab(as_reparg.d_sdate, as_reparg.d_edate, as_type, ls_stringarr1, as_reparg.l_code1, ls_stringarr2, ld_cols)
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate)
				else
					SQL rollback USING sqlca;
				end if
			end if
		end if
	case "d_zonalareasales_crosstab", "d_zonalareasales_landscape_crosstab"
		open(w_selection_manf_cat_class_packing)
		as_type = message.stringparm
		if not (as_type = "" or isnull(as_type)) then
			openwithparm(w_arg_zone_grouping_sdate_ldate_rate_v2, as_type)
			as_reparg = message.powerobjectparm
			if as_reparg.i_status = 1 then
				ll_arr = as_reparg.ia_integerlist
				f_tostring(ll_arr, ls_stringarr1, ",")
				if as_reportinfo.s_reportobject = "d_zonalareasales_crosstab" then
					ld_cols = 7.0
				else
					open(w_selectformat_1_2)
					al_format = message.doubleparm
					if al_format = 1 then
						adw_report.dataobject = "d_zonalareasales_landscape_crosstab"
					else
						adw_report.dataobject = "d_zonalareasales_landscape_crosstab2"
					end if
					adw_report.settransobject(sqlca)
					ld_cols = 12.0
				end if
				SQL rollback USING sqlca;
				sqlca.zonalareasales_crosstab(as_reparg.l_code1, as_reparg.d_sdate, as_reparg.d_edate, as_type, ls_stringarr1, as_reparg.l_code2, ld_cols, as_reparg.l_code3, as_reparg.l_code4)
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.l_code4)
				else
					SQL rollback USING sqlca;
				end if
			end if
		end if
	case "d_comp_zonalareasales"
		open(w_selection_manf_cat_class_packing)
		as_type = message.stringparm
		if not (as_type = "" or isnull(as_type)) then
			openwithparm(w_arg_manfs_cats_classes_packs_zones, as_type)
			as_reparg = message.powerobjectparm
			if as_reparg.i_status = 1 then
				ll_arr = as_reparg.ia_integerlist
				f_tostring(ll_arr, ls_stringarr1, ",")
				ll_count = upperbound(as_reparg.ia_integerlist1)
				for ll_loopcounter = 1 to ll_count
					SQL rollback USING sqlca;
					sqlca.zonalareasales(as_reparg.ia_integerlist1[ll_loopcounter], as_reparg.d_sdate, as_reparg.d_edate, as_type, ls_stringarr1, as_reparg.l_code2)
					if sqlca.sqlcode = 0 then
						SQL commit USING sqlca;
						if sqlca.sqlcode = 0 then
							as_reparg.s_name1 = "."
							i_rtcode = f_getnestedreport(ldc_nested, adw_report, "dw_" + trim(string(ll_loopcounter)))
							if i_rtcode = -1 then
								messagebox("Retrieve Error", "Problem in Retrieving Report")
							else
								i_rtcode = ldc_nested.retrieve(as_reparg.ia_integerlist1[ll_loopcounter], as_reparg.d_sdate, as_reparg.d_edate, as_reparg.s_name1)
							end if
						else
							SQL rollback USING sqlca;
						end if
					else
						SQL rollback USING sqlca;
					end if
				next
			end if
		end if
	case "d_customers_balance_list_colwise"
		if ai_mode = 0 then
			open(w_select_custbalance_format2)
			al_format = message.doubleparm
			open(w_arg_areas_sdate)
			as_reparg = message.powerobjectparm
			if al_format = 1 then
				adw_report.dataobject = "d_customers_balance_list_colwise"
			elseif al_format = 2 then
				adw_report.dataobject = "d_customers_balance_list_colwise2"
			elseif al_format = 3 then
				adw_report.dataobject = "d_customers_balance_list_colwise3"
			else
				adw_report.dataobject = "d_customers_balance_list_colwise4"
			end if
			adw_report.settransobject(sqlca)
		end if
		if as_reparg.i_status = 1 then
			setpointer(hourglass!)
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				if f_rightexists(533) then
					i_rtcode = 1
				else
					i_rtcode = 0
				end if
				i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.ia_integerlist, i_rtcode)
			else
				SQL rollback USING sqlca;
			end if
			setpointer(arrow!)
		end if
		setpointer(arrow!)
	case "d_customerwisesalessummery_patient_2"
		open(w_selectformat_cust_sale_summ_2)
		al_format = message.doubleparm
		if al_format = 1 then
			adw_report.dataobject = "d_customerwisesalessummery_patient_2"
		elseif al_format = 2 then
			adw_report.dataobject = "d_customerwisesalessummery_patient_2_2"
		elseif al_format = 3 then
			adw_report.dataobject = "d_customerwisesalessummery_patient_3"
		elseif al_format = 4 then
			adw_report.dataobject = "d_custwisesalessumm_patient_2_4"
		end if
		adw_report.settransobject(sqlca)
		open(w_arg_cust_sdate_ldate_v7)
		as_reparg = message.powerobjectparm
		if as_reparg.i_status = 1 then
			i_rtcode = adw_report.retrieve(as_reparg.l_code1, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.s_name3, as_reparg.s_name1)
		end if
	case "d_saleandreturn_itemsubset_remington"
		open(w_arg_items_sdate_ldate)
		as_reparg = message.powerobjectparm
		if as_reparg.i_status = 1 then
			i_rtcode = adw_report.retrieve(as_reparg.la_longlist, as_reparg.d_sdate, as_reparg.d_edate)
		end if
	case "d_saleandreturn_remington", "d_salereturn_remington"
		open(w_arg_manf_sdate_ldate)
		as_reparg = message.powerobjectparm
		if as_reparg.i_status = 1 then
			i_rtcode = adw_report.retrieve(as_reparg.l_code1, as_reparg.d_sdate, as_reparg.d_edate)
		end if
	case "d_areawisesales"
		open(w_selection_manf_cat_class_packing)
		as_type = message.stringparm
		if not (as_type = "" or isnull(as_type)) then
			open(w_selectformat_areawisesale)
			if message.doubleparm = 1.0 then
				adw_report.dataobject = "d_areawisesales"
			elseif message.doubleparm = 2.0 then
				adw_report.dataobject = "d_areawisesales2"
			else
				adw_report.dataobject = "d_areawisesales_summary"
			end if
			adw_report.settransobject(sqlca)
			openwithparm(w_arg_grouping_region_include_bns_ret, as_type)
			as_reparg = message.powerobjectparm
			if as_reparg.i_status = 1 then
				ll_arr = as_reparg.ia_integerlist
				f_tostring(ll_arr, ls_stringarr1, ",")
				SQL rollback USING sqlca;
				sqlca.areawisesales(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.l_code1, as_type, ls_stringarr1, 1, as_reparg.l_code2, as_reparg.l_code3, as_reparg.l_code4)
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					i_rtcode = adw_report.retrieve(as_reparg.l_code1, as_reparg.ia_integerlist, as_reparg.d_sdate, as_reparg.d_edate)
				else
					SQL rollback USING sqlca;
				end if
			end if
		end if
	case "d_monthlysalessummary", "d_yearlysalessummary"
		open(w_selection_manf_cat_class_packing)
		as_type = message.stringparm
		if not (as_type = "" or isnull(as_type)) then
			openwithparm(w_arg_manfs_cats_classes_packs_dates, as_type)
			as_reparg = message.powerobjectparm
			if as_reparg.i_status = 1 then
				ll_arr = as_reparg.ia_integerlist
				f_tostring(ll_arr, ls_stringarr1, ",")
				SQL rollback USING sqlca;
				if as_reportinfo.s_reportobject = "d_monthlysalessummary" then
					sqlca.monthlysalessummary(as_reparg.d_sdate, as_reparg.d_edate, as_type, ls_stringarr1)
				else
					sqlca.yearlysalessummary(as_reparg.d_sdate, as_reparg.d_edate, as_type, ls_stringarr1)
				end if
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					if sqlca.sqlcode = 0 then
						i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate)
					else
						SQL rollback USING sqlca;
					end if
				else
					SQL rollback USING sqlca;
				end if
			end if
		end if
	case "d_customerlist_smanwise"
		open(w_selectformat_salesmancustlist)
		al_format = message.doubleparm
		if al_format = 1 then
			open(w_arg_salesman_active_inactive)
			adw_report.dataobject = "d_customerlist_smanwise"
		else
			open(w_arg_salesman_manf_active_inactive)
			adw_report.dataobject = "d_customerlist_smanwise2"
		end if
		as_reparg = message.powerobjectparm
		adw_report.settransobject(sqlca)
		if as_reparg.i_status = 1 then
			if al_format = 1 then
				i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.s_name1)
			else
				i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.s_name1, as_reparg.l_code1)
			end if
		end if
	case "d_salesmanwisereceipts"
		open(w_arg_salesman_month_year)
		as_reparg = message.powerobjectparm
		if as_reparg.i_status = 1 then
			ll_arr = as_reparg.ia_integerlist
			f_tostring(ll_arr, ls_stringarr1, ",")
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				sqlca.salesmanwisereceipt(as_reparg.l_code1, as_reparg.l_code2, ls_stringarr1)
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					if sqlca.sqlcode = 0 then
						i_rtcode = adw_report.retrieve(as_reparg.l_code1, as_reparg.l_code2)
					else
						SQL rollback USING sqlca;
					end if
				else
					SQL rollback USING sqlca;
				end if
			else
				SQL rollback USING sqlca;
			end if
		end if
