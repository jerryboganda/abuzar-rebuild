		open(w_arg_patient_sdate_ldate_inactive)
		as_reparg = message.powerobjectparm
		if as_reparg.s_name2 = "N" then
			SQL rollback USING sqlca;
			SQL update patient SET active ='N' , inactivedate =GETDATE ( ) WHERE patient.patientcode =:as_reparg.l_code1 USING sqlca;
			if sqlca.sqlcode <> 0 then
				SQL rollback USING sqlca;
				messagebox("DataBase Error", "Unable to Set active=No for selected patient ~r~n" + sqlca.sqlerrtext)
			else
				SQL commit USING sqlca;
			end if
		end if
		if as_reparg.s_name1 = "F" then
			adw_report.dataobject = "d_patientwiseinvoice_reprint_full"
