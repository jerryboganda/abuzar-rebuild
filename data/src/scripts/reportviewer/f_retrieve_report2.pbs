				sqlca.zonalareasales(as_reparg.l_code1, as_reparg.d_sdate, as_reparg.d_edate, as_type, ls_stringarr1, as_reparg.l_code2)
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					if sqlca.sqlcode = 0 then
						if as_reportinfo.s_reportobject = "d_zonalareasales_portrait" then
							as_reparg.s_name1 = "."
							i_rtcode = adw_report.retrieve(as_reparg.l_code1, as_reparg.ia_integerlist, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.s_name1)
						else
							lds_datastore.dataobject = "d_itemincategorylist"
							lds_datastore.settransobject(sqlca)
							lds_datastore.retrieve(as_reparg.ia_integerlist)
							as_reparg.s_name1 = ""
							if lds_datastore.rowcount() > 0 then
								for ll_counter = 1 to lds_datastore.rowcount()
									as_reparg.s_name1 = as_reparg.s_name1 + " - " + trim(lds_datastore.getitemstring(ll_counter, "itemcode")) + "=" + trim(lds_datastore.getitemstring(ll_counter, "name"))
								next
							end if
							i_rtcode = adw_report.retrieve(as_reparg.l_code1, as_reparg.ia_integerlist, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.s_name1)
						end if
					else
						SQL rollback USING sqlca;
					end if
				else
					SQL rollback USING sqlca;
				end if
			end if
		end if
	case "d_godown_manufwise_item_netsales"
		open(w_arg_godown_manuf_sdate_ldate)
