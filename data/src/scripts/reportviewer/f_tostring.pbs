// function f_tostring (reportviewer)  ancestor: function_object

// f_tostring.f_tostring(long[] al_arr, string as_arr, char ac_sep) returns 0
	long ll_endelement
	long ll_counter
	as_arr = ""
	ll_endelement = upperbound(al_arr)
	for ll_counter = 1 to ll_endelement
		as_arr = as_arr + trim(string(al_arr[ll_counter]))
		if ll_counter <> ll_endelement then
			as_arr = as_arr + ac_sep
		end if
	next
