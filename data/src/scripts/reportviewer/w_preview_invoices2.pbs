// window w_preview_invoices2 (reportviewer)  ancestor: window

// w_preview_invoices2.wf_getmargininfo() returns long
	this.s_margininfo.i_code[1] = long(this.dw_preview.describe("DataWindow.Units"))
	this.s_margininfo.i_code[2] = long(this.dw_preview.object.datawindow.print.margin.top)
	this.s_margininfo.i_code[3] = long(this.dw_preview.object.datawindow.print.margin.left)
	this.s_margininfo.i_code[4] = long(this.dw_preview.object.datawindow.print.margin.right)
	this.s_margininfo.i_code[5] = long(this.dw_preview.object.datawindow.print.margin.bottom)
	return 0

// w_preview_invoices2.wf_setmargininfo() returns long
	string ls_mod
	ls_mod = "DataWindow.Print.Preview=No DataWindow.Units=" + trim(string(this.s_margininfo.i_code[1]))
	this.dw_preview.modify(ls_mod)
	this.dw_preview.object.datawindow.print.margin.top = this.s_margininfo.i_code[2]
	this.dw_preview.object.datawindow.print.margin.left = this.s_margininfo.i_code[3]
	this.dw_preview.object.datawindow.print.margin.right = this.s_margininfo.i_code[4]
	this.dw_preview.object.datawindow.print.margin.bottom = this.s_margininfo.i_code[5]
	this.dw_preview.modify("DataWindow.Print.Preview=yes DataWindow.Print.Preview.Rulers=yes")
	return 0

// w_preview_invoices2.wf_saveasexcel() returns long
	f_saveasexcel(this.dw_preview)
	return 0

// w_preview_invoices2.wf_changeorientation() returns 0
	string ls_currentorientation
	ls_currentorientation = this.dw_preview.describe("datawindow.print.orientation")
	if integer(ls_currentorientation) = 0 or integer(ls_currentorientation) = 2 then
		this.dw_preview.object.datawindow.print.orientation = 1
		return
	end if
	this.dw_preview.object.datawindow.print.orientation = 2

// w_preview_invoices2.wf_visible() returns 0
	s_dwinfo ls_dwinfo
	ls_dwinfo.dw_control = this.dw_preview
	openwithparm(w_select, ls_dwinfo)
	ls_dwinfo.dw_control = this.dw_preview

// w_preview_invoices2.wf_printinvrange_withsummary() returns 0
	long ll_count
	long[] ll_arr
	long[] ll_arr2
	long ll_counter
	long ll_format
	string ls_name
	string ls_stringarr1
	string ls_stringarr2
	string ls_stringarr3
	string ls_fiscalinvoiceno
	integer i_rtcode
	integer li_reprintingcounter
	datastore lds_invoices
	if this.is_reportobject = "d_comp_subarea_saletype_sale_storesumm" then
		open(w_arg_areas)
		this.istr_temp = message.powerobjectparm
		if this.istr_temp.i_status = 1 then
			openwithparm(w_arg_subareas_saletype_range_areabased, this.istr_temp)
			this.istr_arg = message.powerobjectparm
		end if
		if this.istr_arg.i_status = 1 then
			lds_invoices = create datastore
			lds_invoices.dataobject = "d_saleslist_subarea_saletype_posted"
			lds_invoices.settransobject(sqlca)
			i_rtcode = lds_invoices.retrieve(this.istr_arg.ia_integerlist, this.istr_arg.ia_integerlist1, this.istr_arg.l_code1, this.istr_arg.l_code2)
			if i_rtcode <> 0 then
				ll_count = lds_invoices.rowcount()
				if ll_count > 0 then
					ls_name = ""
					for ll_counter = 1 to ll_count
						ls_name = ls_name + trim(string(lds_invoices.getitemnumber(ll_counter, "saleinvcode"))) + ", "
					next
					if right(ls_name, len(ls_name) - 1) = ", " then
						replace(ls_name, len(ls_name) - 2, 2, "  ")
					end if
				end if
			end if
			destroy lds_invoices
			ll_arr = this.istr_arg.ia_integerlist
			ll_arr2 = this.istr_arg.ia_integerlist1
			f_tostring(ll_arr, ls_stringarr1, ",")
			f_tostring(ll_arr2, ls_stringarr2, ",")
			this.istr_arg.s_name3 = ls_name
			this.istr_arg.s_name4 = ls_stringarr1
			this.istr_arg.s_name5 = ls_stringarr2
			SQL update SaleLedger SET ReprintingCounter =ISNULL ( SaleLedger.ReprintingCounter , 0 ) + 1 FROM SaleLedger , Customer C , Area A , SubArea SA WHERE SaleLedger.SaleInvCode BETWEEN :this.istr_arg.l_code1 AND :this.istr_arg.l_code2 AND SaleLedger.Posted ='Y' AND SaleLedger.SaleTypeCode IN ( ( SELECT Code FROM DBO.udf_StringToTabl ( :ls_stringarr2 , ',' ) ) ) AND SaleLedger.CustCode =C.CustCode AND C.AreaCode =A.AreaCode AND C.SubAreaCode =SA.SubAreaCode AND A.AreaCode =SA.AreaCode AND SA.SubAreaCode IN ( ( SELECT Code FROM DBO.udf_StringToTabl ( :ls_stringarr1 , ',' ) ) ) USING sqlca;
			if sqlca.sqlcode <> 0 then
				messagebox("Database Error", "Some database problem has occur")
				SQL rollback USING sqlca;
				return
			else
				SQL commit USING sqlca;
			end if
			if this.istr_arg.l_code4 = 1 then
				if gs_company = "MEHRANENTP" or gs_company = "TALALENTP" or gs_company = "SHAKEELENTP" then
					this.dw_preview.object.dw_1.dataobject = "d_shakeelentp_subarea_saletype_storesumm"
				end if
				i_rtcode = f_getnestedreport(this.idc_nested, this.dw_preview, "dw_1")
				this.idc_nested.settransobject(sqlca)
				if i_rtcode = -1 then
					messagebox("Retrieve Error", "Problem in Retrieving Report")
				else
					i_rtcode = this.idc_nested.retrieve(ls_stringarr1, ls_stringarr2, this.istr_arg.l_code1, this.istr_arg.l_code2, this.istr_arg.s_name3, this.istr_arg.s_name2, this.istr_arg.s_name1, this.istr_arg.l_code3)
				end if
			end if
			if this.istr_arg.l_code5 = 1 then
				if gs_company = "MEHRANENTP" or gs_company = "TALALENTP" then
					this.dw_preview.object.dw_2.dataobject = "d_mehranentp_subarea_saletype_saleprint"
				end if
				i_rtcode = f_getnestedreport(this.idc_nested2, this.dw_preview, "dw_2")
				this.idc_nested2.settransobject(sqlca)
				if i_rtcode = -1 then
					messagebox("Retrieve Error", "Problem in Retrieving Report")
				else
					i_rtcode = this.idc_nested2.retrieve(ls_stringarr1, ls_stringarr2, this.istr_arg.l_code1, this.istr_arg.l_code2, this.istr_arg.l_code3)
				end if
			end if
		end if
	elseif this.is_reportobject = "d_comp_dc_txinv_invoice" then
		openwithparm(w_selectformat_dc_taxinv_invoice, this.istr_arg)
		this.istr_arg = message.powerobjectparm
		if this.istr_arg.i_status = 1 then
			if this.istr_arg.s_name1 = "Y" then
				if gs_company = "HUMAYUN" then
					this.dw_preview.object.dw_1.dataobject = "d_humayun_dc"
				elseif gs_company = "PHARMAFIRST" then
					this.dw_preview.object.dw_1.dataobject = "d_pharmafirst_dc"
				elseif gs_company = "UNITEDCORP" then
					this.dw_preview.object.dw_1.dataobject = "d_unitedcorp_dc"
				end if
			else
				this.dw_preview.object.dw_1.visible = false
			end if
			if this.istr_arg.s_name2 = "Y" then
				if gs_company = "HUMAYUN" then
					this.dw_preview.object.dw_2.dataobject = "d_humayun_staxinvoice"
				elseif gs_company = "GNSTORE" or gs_company = "GNSTORES" then
					this.dw_preview.object.dw_2.dataobject = "d_gnstores_staxinvoice"
				elseif gs_company = "UNITEDCORP" then
					this.dw_preview.object.dw_2.dataobject = "d_unitedcorp_staxinvoice"
				end if
			else
				this.dw_preview.object.dw_2.visible = false
			end if
			if this.istr_arg.s_name3 = "Y" then
				if gs_company = "HUMAYUN" then
					this.dw_preview.object.dw_3.dataobject = "d_humayun_invoiceprint"
				end if
			else
				this.dw_preview.object.dw_3.visible = false
			end if
		end if
		i_rtcode = this.dw_preview.retrieve(this.il_code)
		if gs_company = "UNITEDCORP" and this.dw_preview.rowcount() > 0 then
			ls_fiscalinvoiceno = wf_getfiscalinvoiceno_sales(this.il_code)
			if len(ls_fiscalinvoiceno) > 0 then
				f_gen_pb_qrcode(ls_fiscalinvoiceno)
			end if
		end if
	end if

// w_preview_invoices2.wf_getfiscalinvoiceno_sales(long al_code) returns string
	string ls_fiscalinvoiceno
	SQL SELECT FiscalInvoiceNo INTO :ls_fiscalinvoiceno FROM saleledger WHERE SaleInvcode =:al_code USING sqlca;
	if sqlca.sqlcode <> 0 then
		ls_fiscalinvoiceno = ""
	end if
	return ls_fiscalinvoiceno

// w_preview_invoices2.create() returns 0
	this.cb_printsetup = create cb_printsetup
	this.cb_hidevisible = create cb_hidevisible
	this.cb_orientation = create cb_orientation
	this.cb_saveexcel = create cb_saveexcel
	this.cb_filter = create cb_filter
	this.cb_sort = create cb_sort
	this.cb_saveas = create cb_saveas
	this.dw_preview = create dw_preview
	this.cb_cancel = create cb_cancel
	this.cb_ok = create cb_ok
	this.control = {this.cb_printsetup, this.cb_hidevisible, this.cb_orientation, this.cb_saveexcel, this.cb_filter, this.cb_sort, this.cb_saveas, this.dw_preview, this.cb_cancel, this.cb_ok}

// w_preview_invoices2.destroy() returns 0
	destroy this.cb_printsetup
	destroy this.cb_hidevisible
	destroy this.cb_orientation
	destroy this.cb_saveexcel
	destroy this.cb_filter
	destroy this.cb_sort
	destroy this.cb_saveas
	destroy this.dw_preview
	destroy this.cb_cancel
	destroy this.cb_ok

// w_preview_invoices2.open() returns long
	long cll_buttondiff
	long ll_win_width
	long ll_win_height
	long ll_width
	long ll_height
	long ll_found
	environment env
	datastore lds_ds
	s_dberror ls_dberror
	s_datastore lstr
	lds_ds = create datastore
	setredraw(false)
	if getenvironment(env) = 1 then
		ll_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_height = pixelstounits(env.screenheight, ypixelstounits!)
		this.width = ll_width * 0.98
		this.height = ll_height * 0.98
		this.dw_preview.width = ll_width * 0.95
		this.dw_preview.height = ll_height * 0.80
		this.cb_filter.x = ll_width * 0.10
		this.cb_filter.y = ll_height * 0.85
		this.cb_sort.x = this.cb_filter.x + this.cb_filter.width + 1
		this.cb_sort.y = this.cb_filter.y
		this.cb_hidevisible.x = this.cb_sort.x + this.cb_sort.width + 1
		this.cb_hidevisible.y = this.cb_sort.y
		this.cb_orientation.x = this.cb_hidevisible.x + this.cb_hidevisible.width + 1
		this.cb_orientation.y = this.cb_hidevisible.y
		this.cb_printsetup.x = this.cb_orientation.x + this.cb_orientation.width + 1
		this.cb_printsetup.y = this.cb_orientation.y
		this.cb_ok.x = this.cb_orientation.x + this.cb_orientation.width + 1
		this.cb_ok.y = this.cb_orientation.y
		this.cb_cancel.x = this.cb_ok.x + this.cb_ok.width + 1
		this.cb_cancel.y = this.cb_ok.y
		this.cb_saveas.x = this.cb_cancel.x + this.cb_cancel.width + 1
		this.cb_saveas.y = this.cb_cancel.y
		this.cb_saveexcel.x = this.cb_saveas.x + this.cb_saveas.width + 1
		this.cb_saveexcel.y = this.cb_saveas.y
		ll_win_width = pixelstounits(env.screenwidth, xpixelstounits!)
		ll_win_height = pixelstounits(env.screenheight, ypixelstounits!)
		ll_width = ll_win_width - this.width
		ll_height = ll_win_height - this.height
		if ll_width > 0 and ll_height > 0 then
			this.x = ll_width / 2.0
			this.y = ll_height / 2.0
		end if
	end if
	if f_stringpreferences("AllowPrintSetupButton") = "Y" then
		this.cb_printsetup.enabled = true
		this.cb_printsetup.visible = true
	else
		this.cb_printsetup.enabled = false
		this.cb_printsetup.visible = false
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 637", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.cb_saveas.visible = true
		this.cb_saveas.enabled = true
	end if
	ll_found = 0
	ll_found = gds_securitywindow.find("rightcode = 638", 1, gds_securitywindow.rowcount())
	if ll_found > 0 then
		this.cb_saveexcel.visible = true
		this.cb_saveexcel.enabled = true
	end if
	lstr = message.powerobjectparm
	this.is_reportobject = lstr.s_name1
	this.dw_preview.dataobject = lstr.s_name1
	this.dw_preview.settransobject(sqlca)
	this.il_code = lstr.d_value
	this.dw_preview.modify("DataWindow.Print.Preview=yes DataWindow.Print.Preview.Rulers=yes")
	if lstr.s_module = "rangeprint_withsummary" then
		wf_printinvrange_withsummary()
	elseif lstr.s_name1 = "d_purlabel_for_purinvoice" then
		lstr.ds.sharedata(this.dw_preview)
	elseif lstr.s_name1 = "d_discountpolicybasedprofitmargin" then
		this.dw_preview.retrieve(this.il_code)
	else
		lstr.ds.sharedata(this.dw_preview)
		f_set_sigon_invoice(this.dw_preview, 1)
	end if
	this.dw_preview.setfocus()
	setredraw(true)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue

// w_preview_invoices2.key(keycode key, unsignedlong keyflags) returns long
	if keydown(keyescape!) then
		this.cb_cancel.postevent(clicked!)
	end if
	return ::message.returnvalue

// cb_printsetup.clicked() returns long
	openwithparm(w_printer, parent.dw_preview)
	return ::message.returnvalue

// cb_hidevisible.clicked() returns long
	parent.wf_visible()
	return ::message.returnvalue

// cb_orientation.clicked() returns long
	parent.wf_changeorientation()
	return ::message.returnvalue

// cb_saveexcel.clicked() returns long
	parent.wf_saveasexcel()
	return ::message.returnvalue

// cb_filter.clicked() returns long
	string ls_null
	setnull(ls_null)
	parent.dw_preview.scrolltorow(0)
	parent.dw_preview.setfilter(ls_null)
	parent.dw_preview.filter()
	parent.dw_preview.groupcalc()
	return ::message.returnvalue

// cb_sort.clicked() returns long
	string ls_null
	setnull(ls_null)
	parent.dw_preview.setsort(ls_null)
	parent.dw_preview.sort()
	parent.dw_preview.groupcalc()
	return ::message.returnvalue

// cb_saveas.clicked() returns long
	parent.dw_preview.saveas()
	return ::message.returnvalue

// dw_preview.ue_dwnkey(keycode key, unsignedlong keyflags) returns long
	if key = keyhome! then
		scrolltorow(0)
	elseif key = keyend! then
		scrolltorow(rowcount())
	end if
	return ::message.returnvalue

// cb_cancel.clicked() returns long
	s_datastore lstr
	lstr.i_closemode = -1
	SQL update SaleLedger SET ReprintingCounter =ISNULL ( SaleLedger.ReprintingCounter , 0 ) - 1 FROM SaleLedger , Customer C , Area A , SubArea SA WHERE SaleLedger.SaleInvCode BETWEEN :parent.istr_arg.l_code1 AND :parent.istr_arg.l_code2 AND SaleLedger.Posted ='Y' AND SaleLedger.SaleTypeCode IN ( ( SELECT Code FROM DBO.udf_StringToTabl ( :parent.istr_arg.s_name5 , ',' ) ) ) AND SaleLedger.CustCode =C.CustCode AND C.AreaCode =A.AreaCode AND C.SubAreaCode =SA.SubAreaCode AND A.AreaCode =SA.AreaCode AND SA.SubAreaCode IN ( ( SELECT Code FROM DBO.udf_StringToTabl ( :parent.istr_arg.s_name4 , ',' ) ) ) USING sqlca;
	if sqlca.sqlcode <> 0 then
		messagebox("Database Error", "Some database problem has occur")
		SQL rollback USING sqlca;
		return ::message.returnvalue
	else
		SQL commit USING sqlca;
	end if
	closewithreturn(parent, lstr)
	return ::message.returnvalue

// cb_ok.clicked() returns long
	integer li_printretcode
	s_datastore lstr
	lstr.i_closemode = 1
	if f_stringpreferences("saleaskforcopies") = "Y" then
		open(w_printer_copies)
		parent.dw_preview.object.datawindow.print.copies = string(message.doubleparm)
	end if
	if parent.dw_preview.rowcount() > 0 then
		if parent.dw_preview.rowcount() > 0 then
			li_printretcode = parent.dw_preview.print()
			if li_printretcode < 0 then
				messagebox("Printing", "Problem Sendig Print", information!)
			end if
		end if
	else
		messagebox("Printing Error", "Can not Print~r~nNo rows are retrieved", information!)
	end if
	closewithreturn(parent, lstr)
	if not isvalid(message) then
		return 0
	end if
	return message.returnvalue
