// function f_retrieve_report4 (reportviewer)  ancestor: function_object

// f_retrieve_report4.f_retrieve_report4(ref datawindow adw_report, ref s_reportinfo as_reportinfo, ref s_arguements as_reparg, ref long al_format, ref string as_type, ref integer ai_mode) returns long
	integer ii_normal
	integer ii_autorefresh = 1
	long ll_insertrow
	long ll_rowcount
	long ll_count
	long ll_loopcounter = 1
	long ll_counter
	long[] ll_arr
	long ll_zeroqty
	long ll_tempcode = -1
	long ll_format
	string ls_itemname
	string ls_nestedreport
	string ls_stringparam
	string ls_name
	string ls_cp
	string ls_address
	string ls_address2
	string ls_city
	string ls_stringarr1
	string ls_stringarr2
	string ls_stringarr3
	integer i_rtcode
	integer li_packunits
	integer li_suppress
	double ld_saleprice
	double ld_salediscperc
	double ld_cols
	double ld_ratediff
	s_arguements lstr_temp
	choose case as_reportinfo.s_reportobject
	case "d_customer_itemclass_netsale_volume"
		if ai_mode = 0 then
			openwithparm(w_arg_manfs_cats_classes_packs_subarea, "L")
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.ia_integerlist1, as_reparg.d_sdate, as_reparg.d_edate)
		end if
	case "d_area_manf_custnetsale_volume"
		if ai_mode = 0 then
			openwithparm(w_arg_manfs_cats_classes_packs_area, "M")
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.ia_integerlist1, as_reparg.d_sdate, as_reparg.d_edate)
		end if
	case "d_pur_categorywise"
		if ai_mode = 0 then
			open(w_selectformat_cat_purchase)
			al_format = message.doubleparm
			if al_format = 1 then
				open(w_selection_manf_cat_class_packing)
				as_type = message.stringparm
				open(w_arg_users_withlist_sdate_ldate_purcat)
				as_reparg = message.powerobjectparm
			else
				adw_report.dataobject = "d_itemcat_class_size_netpur_volume"
				adw_report.settransobject(sqlca)
				open(w_arg_category_sdate_ldate)
				as_reparg = message.powerobjectparm
			end if
		end if
		if as_reparg.i_status = 1 then
			if al_format = 1 then
				i_rtcode = adw_report.retrieve(as_type, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.ia_integerlist, as_reparg.s_name1, as_reparg.ia_integerlist2, as_reparg.s_name2, as_reparg.sa_stringlist)
			else
				i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.d_sdate, as_reparg.d_edate)
			end if
		end if
	case "d_custwise_summarypatient_format3_salmod"
		if ai_mode = 0 then
			open(w_arg_cust_sdate_ldate_v5)
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			i_rtcode = adw_report.retrieve(as_reparg.l_code1, as_reparg.d_sdate, as_reparg.d_edate, as_reparg.db_code1, as_reparg.s_name1, as_reparg.s_name3, as_reparg.l_code4)
		end if
	case "d_aging"
		if ai_mode = 0 then
			open(w_selectformat_agingcriteria)
			al_format = message.doubleparm
			if al_format = 1 then
				open(w_selectformat_agingsummary)
				if message.doubleparm = 1.0 then
					adw_report.dataobject = "d_aging_old"
				elseif message.doubleparm = 2.0 then
					adw_report.dataobject = "d_aging"
				else
					adw_report.dataobject = "d_aging2"
				end if
				adw_report.settransobject(sqlca)
				open(w_arg_aging)
			elseif al_format = 2 then
				adw_report.dataobject = "d_aging_salesman"
				adw_report.settransobject(sqlca)
				open(w_arg_aging_salesman)
			else
				adw_report.dataobject = "d_aging_subarea"
				adw_report.settransobject(sqlca)
				open(w_arg_aging_subarea)
			end if
			as_reparg = message.powerobjectparm
		end if
		if as_reparg.i_status = 1 then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				if al_format = 1 then
					sqlca.aging(as_reparg.s_name1, as_reparg.d_sdate, as_reparg.l_code1, as_reparg.l_code2)
				elseif al_format = 2 then
					sqlca.aging_salesmanwise(as_reparg.d_sdate, as_reparg.l_code1, as_reparg.l_code2)
				elseif al_format = 3 then
					sqlca.aging_subareawise(as_reparg.d_sdate, as_reparg.l_code1, as_reparg.l_code2)
				end if
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					i_rtcode = adw_report.retrieve(as_reparg.d_sdate, as_reparg.l_code1, as_reparg.l_code2, as_reparg.s_name1, as_reparg.ia_integerlist)
				else
					SQL rollback USING sqlca;
				end if
			else
				SQL rollback USING sqlca;
			end if
		end if
	case "d_salesman_sale_and_collection"
		if ai_mode = 0 then
			open(w_selectformat_salesandcollection)
			al_format = message.doubleparm
			if al_format = 1 then
				adw_report.dataobject = "d_salesman_sale_and_collection"
				open(w_arg_salesman_overdue)
				as_type = "S"
			elseif al_format = 2 then
				adw_report.dataobject = "d_subarea_sale_and_collection"
				open(w_arg_subarea_overdue)
				as_type = "B"
			end if
			as_reparg = message.powerobjectparm
			adw_report.settransobject(sqlca)
		end if
		if as_reparg.i_status = 1 then
			SQL rollback USING sqlca;
			sqlca.virtualgl("A")
			if sqlca.sqlcode = 0 then
				SQL commit USING sqlca;
				ll_arr = as_reparg.ia_integerlist
				f_tostring(ll_arr, ls_stringarr1, ",")
				sqlca.getcustomeroverdueblancelist(as_type, ls_stringarr1, as_reparg.d_edate, as_reparg.l_code1)
				if sqlca.sqlcode = 0 then
					SQL commit USING sqlca;
					adw_report.retrieve(as_reparg.d_sdate, as_reparg.d_edate, as_reparg.l_code1, as_reparg.ia_integerlist)
				else
					SQL rollback USING sqlca;
				end if
			else
				SQL rollback USING sqlca;
			end if
		end if
