			end if
		end if
		if as_reparg.i_status = 1 and lstr_temp.i_status = 1 then
			lstr_temp.ia_integerlist2 = ll_arr
			if al_format <= 3 then
				i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.ia_integerlist1, lstr_temp.ia_integerlist, as_reparg.d_sdate, as_reparg.d_edate)
			else
				i_rtcode = adw_report.retrieve(as_reparg.ia_integerlist, as_reparg.ia_integerlist1, lstr_temp.ia_integerlist, lstr_temp.ia_integerlist2, as_reparg.d_sdate, as_reparg.d_edate)
