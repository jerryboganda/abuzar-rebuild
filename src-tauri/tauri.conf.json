{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trader",
  "version": "0.1.0",
  "identifier": "app.trader.desktop",
  "build": {
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WASEELA ABUZAR V2 01.01.2022",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "maximized": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}